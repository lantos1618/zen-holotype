// src/sema/sema_try.zen
// `.try()`, and the rules that go with it.
//
// "It unwraps Ok, or returns the Err — or the None — from the ENCLOSING
// function." All law 4: the enclosing function must return a compatible
// Res, a `Res<T>` may not try into a `Res<T, E>` function, and nothing
// is converted.
//
// Split out of `sema_type.zen` (subject: "what does this node mean" and
// the memo discipline for it); this one is the failure model — which Res
// forms propagate into which, what a set must contain. `try_type` is one
// arm of `expr_kind` and nothing else calls into this family, so the
// seam is exactly one import.

ExprId, Span = std.ast
AllocError = std.mem
TyId, TyRes, ResForm = sema.sema_ty
SemaFault, TypeFault = sema.sema_diag
Checker, Ctx = sema.sema_check
absence_into_failure, both_failures = sema.sema_check
type_of = sema.sema_type

// `at` is the `try` TOKEN, not the node — the node's span starts at the
// operand, so `checked(n).try()` reported on the node would point at a
// call that's perfectly well formed. TESTING.md asks for the first byte
// of the smallest offending node: the four characters the author has to
// change.
try_type* = (c :: Checker, at: Span, operand: ExprId, ctx: Ctx)
           Res<TyId, AllocError> {
    got = c.type_of(operand, ctx).try();
    c.types.at(got).match({
        Res(r) => c.try_res(at, r, got, ctx),
        _      => c.try_not_res(at, got, ctx),
    })
}

try_not_res* = (c :: Checker, at: Span, got: TyId, ctx: Ctx)
              Res<TyId, AllocError> {
    // poison: no second diagnostic
    c.is_unknown(got).match({
        false => c.try_needs_res(at, got),
        true  => Ok(got),
    })
}

try_needs_res* = (c :: Checker, at: Span, got: TyId)
                Res<TyId, AllocError> {
    want = c.types.unknown().try();
    c.report(at.file, at,
                SemaFault.TryNeedsRes(TypeFault(
                    name: "",
                    expected: want,
                    found: got))).try();
    c.types.unknown()
}

try_res* = (c :: Checker, at: Span, r: TyRes, got: TyId, ctx: Ctx)
          Res<TyId, AllocError> {
    ctx.has_ret.match({
        false => c.try_outside_res(at, got),
        true  => c.try_into(at, r, got, ctx),
    })
}

try_outside_res* = (c :: Checker, at: Span, got: TyId)
                  Res<TyId, AllocError> {
    want = c.types.unknown().try();
    c.report(at.file, at,
                SemaFault.TryOutsideRes(TypeFault(
                    name: "",
                    expected: want,
                    found: got))).try();
    Ok(got)
}

// The enclosing function returns a Res; which one decides whether this
// propagation is legal at all.
try_into* = (c :: Checker, at: Span, r: TyRes, got: TyId, ctx: Ctx)
           Res<TyId, AllocError> {
    c.types.at(ctx.ret).match({
        Res(want) => c.try_merge(at, r, want, got),
        _         => c.try_outside_res(at, got),
    })
}

try_merge* = (c :: Checker, at: Span, r: TyRes, want: TyRes, got: TyId)
            Res<TyId, AllocError> {
    // absence into failure is the shape law 4 names outright: "a None
    // never becomes an Err. You name the reason" — `.ok_or(..)` is
    // where that's written.
    absence_into_failure(r.form, want.form).match({
        true  => c.try_absence(at, got, r.value, want.error),
        false => c.try_set(at, r, want),
    })
}

// `expected` is the ENCLOSING FUNCTION's Res, built with the failing
// set. BUG this replaced: passing the OPERAND's type as the error made
// a `Res<i32>` tried into a `Res<i32, Error>` read "expected
// Res<i32, Res<i32>>" — a type nobody wrote or could write.
try_absence* = (c :: Checker, at: Span, got: TyId, value: TyId, err: TyId)
              Res<TyId, AllocError> {
    want = c.types.res_failure(value, err).try();
    c.report(at.file, at,
                SemaFault.TryAbsenceIntoFailure(TypeFault(
                    name: "",
                    expected: want,
                    found: got))).try();
    Ok(value)
}

// "propagation merges sets" — containment, not conversion; the callee's
// set must already be part of the caller's, no From bridges them.
//
// THE OTHER DIRECTION WAS THE MISSING HALF: a `Res<T>` declares NO
// error, so a callee raising a real set has nowhere to propagate to
// (`absence_into_failure` above is the mirror case). Letting this
// through meant law 4's "nothing is converted" was enforced only by the
// backend refusing to lower the widening.
try_set* = (c :: Checker, at: Span, r: TyRes, want: TyRes)
          Res<TyId, AllocError> {
    both_failures(r.form, want.form).match({
        true  => c.try_contained(at, r, want),
        false => c.try_into_absence(at, r, want),
    })
}

try_into_absence* = (c :: Checker, at: Span, r: TyRes, want: TyRes)
                   Res<TyId, AllocError> {
    failure_into_absence(r.form, want.form).match({
        true  => c.try_no_conversion(at, r, want),
        false => Ok(r.value),
    })
}

// Mirrors `sema_check.zen`'s `absence_into_failure`; kept here rather
// than beside it because that file is at STYLE.md's line cap and this
// rule has one caller.
failure_into_absence = (got: ResForm, want: ResForm) bool {
    got.match({
        Failure => want.match({ Absence => true, _ => false }),
        _       => false,
    })
}

// A caller whose own set is `_` hasn't declared one, so there's nothing
// to be contained IN — it raises what the callee raises, and
// `sema_raise.zen` settles the signature once the body is walked.
try_contained* = (c :: Checker, at: Span, r: TyRes, want: TyRes)
                Res<TyId, AllocError> {
    c.is_infer(want.error).match({
        true  => c.try_raises(r),
        false => c.try_declared(at, r, want),
    })
}

// The callee's SET and not its name: `WriteError` raised into an
// inferred set contributes `IoError` and `AllocError`, so the caller's
// declared set is asked to contain members, not a spelling. `union_ty`
// flattens the rest.
try_raises* = (c :: Checker, r: TyRes) Res<TyId, AllocError> {
    c.raise(c.set_of(r.error)).try();
    Ok(r.value);
}

try_declared* = (c :: Checker, at: Span, r: TyRes, want: TyRes)
               Res<TyId, AllocError> {
    c.types.set_within(c.set_of(r.error), c.set_of(want.error)).match({
        false => c.try_no_conversion(at, r, want),
        true  => Ok(r.value),
    })
}

try_no_conversion* = (c :: Checker, at: Span, r: TyRes, want: TyRes)
                    Res<TyId, AllocError> {
    c.report(at.file, at,
                SemaFault.NoErrorConversion(TypeFault(
                    name: "",
                    expected: want.error,
                    found: r.error))).try();
    Ok(r.value)
}
