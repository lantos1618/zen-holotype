// io_file_nul_bytes — the binary-safe file read regression. The harness seeds @@T@@/zo_nul.bin with the
// 7 bytes "abc\0def" (an embedded NUL at index 3), then builds+runs this. `contents_bytes_in` must yield
// the FULL 7 bytes with the NUL preserved, while the TEXT `contents_in` strlen-truncates to 3 — the
// documented split. Exit 0 iff both hold (`.to_exit()`).
halloc = std.mem.heap
{ contents_bytes_in, contents_in } = std.io.file
{ to_exit } = std.core.bool
{ len } = std.text.str
main = () i32 {
    heap := halloc.gpa()
    a := heap.addr()
    bytes_ok := a.contents_bytes_in("@@T@@/zo_nul.bin").match ({
        .Ok(b)  => b.len == 7 && b[3] == 0 && b[6] == 'f',    // full length, embedded NUL preserved
        .Err(e) => false,
    })
    view_trunc := a.contents_in("@@T@@/zo_nul.bin").match ({
        .Ok(s)  => s.len() == 3,    // text view stops at the first NUL (documented)
        .Err(e) => false,
    })
    (bytes_ok && view_trunc).to_exit()
}
