// A UNIT `.try()` DISCARDED in statement position.
//
// The tail-position twin (`a_unit_try_in_tail_position_builds_its_res`)
// pins the ORDER unwrap asks its two questions in: hoist first, THEN
// unit. Restoring that order once broke the other arm — a discarded
// unit `.try()` fell into `write_unwrap`, which reads
// `tmp.zg_data.Ok`, a member a unit-payload Res union does not have,
// and every such function stopped compiling under cc ('union
// <anonymous>' has no member named 'zu_m2Ok'). This file pins that arm:
// a discarded unit `.try()` names NO member anywhere — it runs the
// operand, writes nothing, and control moves on.
//
// RED when: the unit short-circuit is dropped from the non-hoist arm
// (emitted C reads a member the union lacks; cc rejects the program).
inner = () Res<(), AllocError> { Ok(()); }

step = () Res<(), AllocError> {
    inner().try();
    println("stepped");
    Ok(())
}

main = (env: Env) Res<i32, AllocError> {
    step().match({
        Ok(_)  => println("ok"),
        Err(_) => println("err"),
    });
    Ok(0);
}
