// main never names `inner_box`, the file that actually declares any of this
Box, Tick, Once, unwrap = deep.deep

main = (env: Env) Res<i32, IoError> {
    b = Box<i32>(value: 9);
    println("{}", b.value);
    println("{}", unwrap(b));
    t: Tick = Once;
    t.match({ Once => println("once") });
    Ok(0);
}
