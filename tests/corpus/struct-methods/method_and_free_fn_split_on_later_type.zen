// A method and free UFCS function may share a name and arity when a later
// parameter type keeps their accepted calls disjoint.

W = {
    v: i32,
    choose = (self: @Self, value: i32) i32 { self.v + value }
}

choose = (w: W, value: str) i32 { w.v * 10 + 2 }

main = (env: Env) Res<i32, AllocError> {
    println("disjoint declarations are legal");
    Ok(0);
}
