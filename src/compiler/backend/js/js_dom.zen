// compiler.backend.js.js_dom — std.web.dom lowering for the JavaScript backend: DOM stub CALLS → real browser
// JS. Extracted from compiler.backend.js.js. Entered from js_call_intr2 (compiler.backend.js.js_expr) after the intrinsic
// tiers, and falls through to an ordinary JS call for every non-DOM name, so emission is byte-identical
// for programs that never touch the DOM — the change is purely additive.
{ String } = std.text.string
{ CallData } = compiler.ast.ast_types
{ gstr_append } = compiler.genc
{ Allocator } = std.mem.alloc
{ jname } = compiler.backend.js.js_lit
{ js_arg_at, js_args } = compiler.backend.js.js_expr
js_call_raw = (s: String, a: Allocator, c: CallData) String {
    s
        .jname(a, c.fn)
        .gstr_append(a, "(")
        .js_args(a, c.args)
        .gstr_append(a, ")")
}
// std.sys.platform's bodyless host floor is generated by each backend, never supplied by zenrt.
js_call_default = (s: String, a: Allocator, c: CallData) String {
    (c.fn == "zen_platform_host_os").match ({
        true  => s.gstr_append(a, "((typeof process !== 'undefined' && process.platform === 'darwin') ? 1 : (typeof process !== 'undefined' && process.platform === 'linux') ? 2 : (typeof process !== 'undefined' && process.platform === 'win32') ? 3 : 0)"),
        false => (c.fn == "zen_platform_host_arch").match ({
            true  => s.gstr_append(a, "((typeof process !== 'undefined' && process.arch === 'arm64') ? 1 : (typeof process !== 'undefined' && process.arch === 'x64') ? 2 : 0)"),
            false => (c.fn == "zen_platform_host_abi").match ({
                true  => s.gstr_append(a, "((typeof process !== 'undefined' && process.platform === 'darwin') ? 1 : (typeof process !== 'undefined' && process.platform === 'linux') ? 2 : (typeof process !== 'undefined' && process.platform === 'win32') ? 4 : 0)"),
                false => s.js_call_raw(a, c),
            }),
        }),
    })
}
// ── std.web.dom lowering: DOM stub CALLS → real browser JS ────────────────────────────────────────
// dom.zen is the JS-target analog of std.c.libc: a header of BODYLESS typed stubs. genc lowers a
// bodyless decl to a C prototype that libc defines; js lowers the CALL to the live browser API —
// `create_element(doc, "div")` → `doc.createElement("div")`, `set_text_content(n, s)` → `n.textContent = s`.
// The map below is a NAME table (snake_case Zen stub → camelCase JS member). It runs AFTER the intrinsic
// tiers (so it only sees non-intrinsic calls) and FALLS THROUGH to an ordinary JS call for every non-DOM
// name (js_call_default), so emission is byte-identical for programs that never touch the DOM — the
// change is purely additive. Design: an interface handle (`{ handle }`) is a JS object ref, passed through
// as identity (like MutPtr<Struct>); upcast stubs (`as_node`, …) lower to that identity; a global singleton
// accessor (`document()`) lowers to the bare global; a Zen `str` argument is decoded to a real JS string
// via `__zr.jstr` (MEM offset → JS string) at the API boundary. Receiver is arg0; extra args follow.
js_dom_recv = (s: String, a: Allocator, c: CallData) String { s.js_arg_at(a, c, 0) }
js_dom_str = (s: String, a: Allocator, c: CallData, i: i32) String {
    s.gstr_append(a, "__zr.jstr(").js_arg_at(a, c, i).gstr_append(a, ")")
}
js_dmeth = (s: String, a: Allocator, c: CallData, m: StringView) String {
    s.js_dom_recv(a, c).gstr_append(a, ".").gstr_append(a, m)
}
// emit shapes: method with 0 args / one str arg / one passthrough arg / two str / str+passthrough / two passthrough.
js_dm0 = (s: String, a: Allocator, c: CallData, m: StringView) String {
    s.js_dmeth(a, c, m).gstr_append(a, "()")
}
js_dm_s = (s: String, a: Allocator, c: CallData, m: StringView) String {
    s
        .js_dmeth(a, c, m)
        .gstr_append(a, "(")
        .js_dom_str(a, c, 1)
        .gstr_append(a, ")")
}
js_dm_p = (s: String, a: Allocator, c: CallData, m: StringView) String {
    s
        .js_dmeth(a, c, m)
        .gstr_append(a, "(")
        .js_arg_at(a, c, 1)
        .gstr_append(a, ")")
}
js_dm_ss = (s: String, a: Allocator, c: CallData, m: StringView) String {
    s
        .js_dmeth(a, c, m)
        .gstr_append(a, "(")
        .js_dom_str(a, c, 1)
        .gstr_append(a, ", ")
        .js_dom_str(a, c, 2)
        .gstr_append(a, ")")
}
js_dm_sp = (s: String, a: Allocator, c: CallData, m: StringView) String {
    s
        .js_dmeth(a, c, m)
        .gstr_append(a, "(")
        .js_dom_str(a, c, 1)
        .gstr_append(a, ", ")
        .js_arg_at(a, c, 2)
        .gstr_append(a, ")")
}
js_dm_pp = (s: String, a: Allocator, c: CallData, m: StringView) String {
    s
        .js_dmeth(a, c, m)
        .gstr_append(a, "(")
        .js_arg_at(a, c, 1)
        .gstr_append(a, ", ")
        .js_arg_at(a, c, 2)
        .gstr_append(a, ")")
}
// emit shapes: property read / property write (str value) / property write (passthrough value).
js_dp = (s: String, a: Allocator, c: CallData, p: StringView) String { s.js_dmeth(a, c, p) }
js_dw_s = (s: String, a: Allocator, c: CallData, p: StringView) String {
    s.js_dmeth(a, c, p).gstr_append(a, " = ").js_dom_str(a, c, 1)
}
js_dw_p = (s: String, a: Allocator, c: CallData, p: StringView) String {
    s.js_dmeth(a, c, p).gstr_append(a, " = ").js_arg_at(a, c, 1)
}
// emit shapes: bare global singleton / identity upcast (arg0 passthrough) / receiver-less global `fetch(str)`.
js_dg = (s: String, a: Allocator, name: StringView) String { s.gstr_append(a, name) }
js_did = (s: String, a: Allocator, c: CallData) String { s.js_dom_recv(a, c) }
js_dfetch = (s: String, a: Allocator, c: CallData) String {
    s.gstr_append(a, "fetch(").js_dom_str(a, c, 0).gstr_append(a, ")")
}
// the DOM-name dispatch: one flat early-return table (was 9 nested tiers, split only because the
// old `.match` pyramids nested too deep — string `==` + early return need no tiers).
js_dom_dispatch* = (s: String, a: Allocator, c: CallData) String {
    // JS global singletons (`document()`→`document`), the receiver-less `fetch`, and the inheritance
    // upcasts (each an identity: in JS an Element already IS a Node/EventTarget).
    (c.fn == "document").then({
        return s.js_dg(a, "document")
    })
    (c.fn == "window").then({
        return s.js_dg(a, "window")
    })
    (c.fn == "console").then({
        return s.js_dg(a, "console")
    })
    (c.fn == "fetch").then({
        return s.js_dfetch(a, c)
    })
    (c.fn == "node_target"
        || c.fn == "as_node"
        || c.fn == "as_event_target"
        || c.fn == "as_element"
        || c.fn == "text_node"
        || c.fn == "document_node"
        || c.fn == "window_target"
        || c.fn == "as_html").then({
        return s.js_did(a, c)
    })
    // EventTarget + Event.
    (c.fn == "add_event_listener").then({
        return s.js_dm_sp(a, c, "addEventListener")
    })
    (c.fn == "remove_event_listener").then({
        return s.js_dm_sp(a, c, "removeEventListener")
    })
    (c.fn == "dispatch_event").then({
        return s.js_dm_p(a, c, "dispatchEvent")
    })
    (c.fn == "event_type").then({
        return s.js_dp(a, c, "type")
    })
    (c.fn == "event_target").then({
        return s.js_dp(a, c, "target")
    })
    (c.fn == "current_target").then({
        return s.js_dp(a, c, "currentTarget")
    })
    (c.fn == "prevent_default").then({
        return s.js_dm0(a, c, "preventDefault")
    })
    (c.fn == "stop_propagation").then({
        return s.js_dm0(a, c, "stopPropagation")
    })
    // Node.
    (c.fn == "append_child").then({
        return s.js_dm_p(a, c, "appendChild")
    })
    (c.fn == "remove_child").then({
        return s.js_dm_p(a, c, "removeChild")
    })
    (c.fn == "insert_before").then({
        return s.js_dm_pp(a, c, "insertBefore")
    })
    (c.fn == "replace_child").then({
        return s.js_dm_pp(a, c, "replaceChild")
    })
    (c.fn == "clone_node").then({
        return s.js_dm_p(a, c, "cloneNode")
    })
    (c.fn == "parent_node").then({
        return s.js_dp(a, c, "parentNode")
    })
    (c.fn == "first_child").then({
        return s.js_dp(a, c, "firstChild")
    })
    (c.fn == "next_sibling").then({
        return s.js_dp(a, c, "nextSibling")
    })
    (c.fn == "child_nodes").then({
        return s.js_dp(a, c, "childNodes")
    })
    (c.fn == "text_content").then({
        return s.js_dp(a, c, "textContent")
    })
    (c.fn == "set_text_content").then({
        return s.js_dw_s(a, c, "textContent")
    })
    // Element (part 1).
    (c.fn == "element_id").then({
        return s.js_dp(a, c, "id")
    })
    (c.fn == "set_id").then({
        return s.js_dw_s(a, c, "id")
    })
    (c.fn == "tag_name").then({
        return s.js_dp(a, c, "tagName")
    })
    (c.fn == "class_name").then({
        return s.js_dp(a, c, "className")
    })
    (c.fn == "set_class_name").then({
        return s.js_dw_s(a, c, "className")
    })
    (c.fn == "inner_html").then({
        return s.js_dp(a, c, "innerHTML")
    })
    (c.fn == "set_inner_html").then({
        return s.js_dw_s(a, c, "innerHTML")
    })
    (c.fn == "get_attribute").then({
        return s.js_dm_s(a, c, "getAttribute")
    })
    (c.fn == "set_attribute").then({
        return s.js_dm_ss(a, c, "setAttribute")
    })
    (c.fn == "remove_attribute").then({
        return s.js_dm_s(a, c, "removeAttribute")
    })
    // Element (part 2) + HTMLElement.
    (c.fn == "has_attribute").then({
        return s.js_dm_s(a, c, "hasAttribute")
    })
    (c.fn == "class_list").then({
        return s.js_dp(a, c, "classList")
    })
    (c.fn == "query_selector").then({
        return s.js_dm_s(a, c, "querySelector")
    })
    (c.fn == "query_selector_all").then({
        return s.js_dm_s(a, c, "querySelectorAll")
    })
    (c.fn == "remove").then({
        return s.js_dm0(a, c, "remove")
    })
    (c.fn == "style").then({
        return s.js_dp(a, c, "style")
    })
    (c.fn == "hidden").then({
        return s.js_dp(a, c, "hidden")
    })
    (c.fn == "set_hidden").then({
        return s.js_dw_p(a, c, "hidden")
    })
    (c.fn == "click").then({
        return s.js_dm0(a, c, "click")
    })
    (c.fn == "focus").then({
        return s.js_dm0(a, c, "focus")
    })
    (c.fn == "blur").then({
        return s.js_dm0(a, c, "blur")
    })
    // DOMTokenList + CSSStyleDeclaration + NodeList.
    (c.fn == "class_add").then({
        return s.js_dm_s(a, c, "add")
    })
    (c.fn == "class_remove").then({
        return s.js_dm_s(a, c, "remove")
    })
    (c.fn == "class_toggle").then({
        return s.js_dm_s(a, c, "toggle")
    })
    (c.fn == "class_contains").then({
        return s.js_dm_s(a, c, "contains")
    })
    (c.fn == "set_property").then({
        return s.js_dm_ss(a, c, "setProperty")
    })
    (c.fn == "get_property").then({
        return s.js_dm_s(a, c, "getPropertyValue")
    })
    (c.fn == "remove_property").then({
        return s.js_dm_s(a, c, "removeProperty")
    })
    (c.fn == "node_list_length").then({
        return s.js_dp(a, c, "length")
    })
    (c.fn == "node_list_item").then({
        return s.js_dm_p(a, c, "item")
    })
    // Document.
    (c.fn == "get_element_by_id").then({
        return s.js_dm_s(a, c, "getElementById")
    })
    (c.fn == "document_query_selector").then({
        return s.js_dm_s(a, c, "querySelector")
    })
    (c.fn == "document_query_selector_all").then({
        return s.js_dm_s(a, c, "querySelectorAll")
    })
    (c.fn == "create_element").then({
        return s.js_dm_s(a, c, "createElement")
    })
    (c.fn == "create_text_node").then({
        return s.js_dm_s(a, c, "createTextNode")
    })
    (c.fn == "body").then({
        return s.js_dp(a, c, "body")
    })
    (c.fn == "head").then({
        return s.js_dp(a, c, "head")
    })
    // Window.
    (c.fn == "alert").then({
        return s.js_dm_s(a, c, "alert")
    })
    (c.fn == "window_document").then({
        return s.js_dp(a, c, "document")
    })
    (c.fn == "location").then({
        return s.js_dp(a, c, "location")
    })
    (c.fn == "set_timeout").then({
        return s.js_dm_pp(a, c, "setTimeout")
    })
    (c.fn == "clear_timeout").then({
        return s.js_dm_p(a, c, "clearTimeout")
    })
    (c.fn == "request_animation_frame").then({
        return s.js_dm_p(a, c, "requestAnimationFrame")
    })
    // Location + Console. Final fall-through: an ordinary JS call (non-DOM name → unchanged emission).
    (c.fn == "href").then({
        return s.js_dp(a, c, "href")
    })
    (c.fn == "set_href").then({
        return s.js_dw_s(a, c, "href")
    })
    (c.fn == "reload").then({
        return s.js_dm0(a, c, "reload")
    })
    (c.fn == "log").then({
        return s.js_dm_s(a, c, "log")
    })
    (c.fn == "error").then({
        return s.js_dm_s(a, c, "error")
    })
    (c.fn == "warn").then({
        return s.js_dm_s(a, c, "warn")
    })
    (c.fn == "info").then({
        return s.js_dm_s(a, c, "info")
    })
    s.js_call_default(a, c)
}
