// a backslash before the line ending is not a line continuation. zen has
// none, so this is a string literal running off its line -- and the rule the
// author broke is the one the diagnostic has to name.
//
// the fix goes at the OPENING QUOTE, not at the backslash the scanner
// happened to notice. a scanner that stepped over the newline here would
// carry the literal onto the next line, which is the one thing a literal
// may not do, and would report an unknown escape for a rule nobody broke.
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    x = "abc\
    Ok(0);
}
