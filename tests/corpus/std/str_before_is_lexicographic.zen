// lexicographic BYTE order: the first differing byte decides, and a
// prefix comes before the whole. Not collation -- "Z" precedes "a"
// because 0x5A precedes 0x61, and a language question about text needs
// a codepoint, not a byte.
before = std.text

main = (env: Env) Res<i32, ArgError> {
    println("{}", "abc".before("abd"));    // c < d
    println("{}", "abd".before("abc"));
    println("{}", "ab".before("abc"));     // a prefix comes first
    println("{}", "abc".before("ab"));
    println("{}", "abc".before("abc"));    // equal is not before
    println("{}", "Z".before("a"));        // bytes, not collation
    println("{}", "".before("a"));         // empty comes first
    println("{}", "".before(""));
    Ok(0);
}
