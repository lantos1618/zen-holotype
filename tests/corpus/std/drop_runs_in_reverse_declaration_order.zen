// tests/corpus/std/drop_runs_in_reverse_declaration_order.zen
// reverse declaration order, so a value can rely on anything
// declared before it still being alive in its own drop. that is
// exactly what makes an arena declared first and dropped last safe

Noisy = {
    id: i32,
    env: Env,
}

Noisy.impl(Drop, {
    drop = (self :: @Self) () {
        env = self.env;
        println("drop {}", self.id);
    }
})

main = (env: Env) Res<i32, AllocError> {
    {
        first = Noisy(id: 1, env: env);
        second = Noisy(id: 2, env: env);
        third = Noisy(id: 3, env: env);
        println("all three made");
    }
    println("after the block");
    Ok(0);
}
