Permutation, permutation = std.build

show = (p: Permutation) () {
    println(
        "{} {} {} {}",
        p.index(4, 0),
        p.index(4, 1),
        p.index(4, 2),
        p.index(4, 3)
    );
}

main = (env: Env) Res<(), AllocError> {
    show(Permutation.Natural);
    show(Permutation.Reverse);
    show(Permutation.Rotate);
    show(Permutation.Interleave);
    println("{}", permutation("reverse").stable_name());
    Ok(())
}
