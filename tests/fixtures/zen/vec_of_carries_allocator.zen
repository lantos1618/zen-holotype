// TEETH: every fallible `Vec<T>` constructor must hand back a CARRYING value — one whose `carried`
// flag is set and whose `alloc` slot holds the allocator it was born under. `of`, `empty`, `map` and
// `filter` used to omit those fields, so C zero-filled `carried` to FALSE, `live()` never opened, and
// every later `add`/`add_one` was a SILENT no-op: they return `Vec<T>`, not `Result`, so nothing told
// the caller a thing had been dropped. `vec.of(a.allocator(), [1,2,3]).add_one(4).len()` answered 3.
//
// So each case asserts the LENGTH — the value the silent failure got wrong — not merely that the
// program survives. Every length is read BEFORE its buffer is freed (the ownership checker treats a
// container's release as consuming it), and every buffer is freed, so a leak sweep stays clean.
halloc = std.mem.heap
vecs = std.collections.vec
{ Result, IoError } = std.core.result
{ to_exit } = std.core.bool
{ formatln, arg_int } = std.text.fmt
main = () i32 {
    alloc ::= halloc.gpa()
    a ::= alloc.addr()
    // `of` — the constructor examples/tour.zen teaches.
    v ::= vecs.of(a.allocator(), [1, 2, 3]).expect("of")
    v = v.add_one(4)
    v = v.add([5, 6])
    of_len ::= v.len()
    of_ok ::= of_len == 6 && v.get(3) == 4 && v.get(5) == 6
    v.free(a)
    // `empty` — the same contract with nothing to seed from.
    er :: Result<vecs.Vec<i64>, IoError> = vecs.empty(a.allocator())
    e ::= er.expect("empty")
    e = e.add_one(9)
    empty_len ::= e.len()
    empty_ok ::= empty_len == 1 && e.get(0) == 9
    e.free(a)
    // `map` — the result is a FRESH buffer drawn from `a`, so it carries `a`, and an append to the
    // mapped Vec must land too: that is this bug one hop away from the constructor.
    src ::= vecs.of(a.allocator(), [1, 2, 3]).expect("of2")
    d ::= src.map(a.allocator(), (x: i64) i64 { x * 2 }).expect("map")
    d = d.add_one(99)
    map_len ::= d.len()
    map_ok ::= map_len == 4 && d.get(0) == 2 && d.get(3) == 99
    d.free(a)
    src.free(a)
    formatln("vec_of_carries of_len={} empty_len={} map_len={}", [arg_int(of_len), arg_int(empty_len), arg_int(map_len)])
    (of_ok && empty_ok && map_ok).to_exit()
}
