// rt M2 slice 1 (docs/rt-scoped-runtime.md §4): the flagship `rows.share(rt)`. `Vec.share` DEEP-COPIES
// the live elements into shared memory then freezes, so the frozen view is independent of the source:
// mutating `rows` to [99, 20, 88] after the share leaves the shared copy [10, 20, 30]. exit = 60.
vec = std.collections.vec
{ expect } = std.core.result
halloc = std.mem.heap
main = () i32 {
    heap := halloc.gpa()
    a := heap.addr()
    rows: vec.Vec<i32> := vec.of(a, [10, 20, 30]).expect("of")
    sh := rows.share(a)
    b := rows.buf()
    b[0] = 99
    b[2] = 88
    s: [i32] := sh.get()
    r := s[0] + s[1] + s[2]
    sh.drop_in(a)
    r
}
