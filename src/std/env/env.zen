// src/std/env/env.zen
//
// The capability root. `main` receives one Env and ALL authority
// flows from it — printing, pages, files, sockets, threads,
// spawning. That is law 2, and it is the reason there is no ambient
// io and no ambient allocator anywhere below this file: a function
// that prints or allocates was handed the authority to, and its
// signature says so.
//
// Every field here is STARRED. `env.mem`, `env.out` and `env.argv`
// are read from user code in every program in tests/corpus, and an
// unstarred field is invisible outside its module (law 6) — so an
// Env with bare fields is an Env nobody outside std can use. The
// star is the whole interface.
//
// Env is also the one place a law bends: `println(..)` is sugar for
// `<the Env in scope>.out.println(..)`, resolved BY TYPE rather
// than by the name of the binding, so no Env in scope is a compile
// error. DESIGN.md carries that in "Still open" and so does this
// file — printing exists exactly where the capability does.

// Mem is the page authority and it is std.mem's, not this file's:
// `env.mem.alloc()` makes an Arena, and the only thing Env adds is
// that the authority arrives here rather than out of thin air.
Alloc, Mem = std.mem
Vec, Map = std.collections
str = std.text

// From the prelude: u64, Res, None. IoError is the io failure every
// Console signature names and no module declares yet; see the
// report. Actor and Ref arrive with std.actor at stage 5.

// A required field was absent, or was present and did not parse as
// the field's type. Both name the field: a reason is never
// invented, and "bad arguments" is not a reason.
ArgError* = Missing(str)
          | Parse(str)

// stdout and stderr. This is what `println` resolves to.
//
// DESIGN.md names the capability "stdout / stderr" and specifies
// exactly one method on it. Only that one is written here — a
// second way to reach stderr would be invention, and it is in the
// report instead.
Console* = {
    println* = (self: @Self, fmt: str, args: ...) Res<(), IoError>
}

// The filesystem capability. DESIGN.md names the field on Env and
// specifies no method on the type, so this is declared and empty
// rather than guessed at: a wrong Fs is worse than an absent one,
// because code gets written against it.
Fs* = {
}

// The network capability. Same as Fs: named, unspecified, empty.
Net* = {
}

ThreadError* = SpawnFailed | Panicked

Thread* = {
    id: u64,

    // block until the body finishes, and yield its result
    join* = <T>(self: @Self) Res<T, ThreadError>
}

// The thread escape hatch, for ffi and batch work. A thread is the
// one kind of authority that can OUTLIVE its creator, which is
// exactly why it hangs off Env with the rest of them and why there
// is no ambient `thread.spawn`.
//
// spawn takes an Alloc because the body is an ESCAPING closure: it
// captures its scope and then runs somewhere its creator's frame
// cannot reach, so it needs memory, so it says so. The law does not
// stop at collections.
//
// Never block inside a behavior — it parks a scheduler thread and
// starves every actor queued on it. That is a rule the type system
// does not yet carry; see the report.
Threads* = {
    spawn* = <T>(self: @Self, a: Alloc, body: () Res<T, ThreadError>) Res<Thread, ThreadError>

    sleep* = (self: @Self, ms: u64) ()
}

Env* = {
    argv*: Vec<str>,       // raw argv; argv.get(0) is the program path
    vars*: Map<str, str>,  // raw environment variables
    out*: Console,         // stdout / stderr
    mem*: Mem,             // page authority: env.mem.alloc() makes an arena
    fs*: Fs,
    net*: Net,
    threads*: Threads,     // the escape hatch, no longer ambient

    // Typed args: declare a schema struct, and this fills it. Each
    // field maps to `--flag` and its SCREAMING env var, and the
    // flag wins. A Res<T> field may be absent (None), a field with
    // a default is optional, and everything else is required and
    // errors BY NAME. This is the whole cli story — there is no
    // string fishing anywhere in it.
    //
    // STAGE 5. Filling the schema is an @meta walk over T's fields,
    // and @meta is outside the seed subset (PLAN.md 0.5), so the
    // body arrives with src/meta/meta.zen. The signature is
    // DESIGN.md's and does not change when it does.
    args* = <T>(self: @Self) Res<T, ArgError>

    // Spawning is authority too: an actor outlives the block that
    // made it, and its arena is rooted in the runtime rather than
    // in main's.
    //
    // STAGE 5, and doubly so: Actor and Ref are declared by
    // std.actor, which arrives with the runtime. The signature is
    // DESIGN.md's, kept here so Env's surface is complete and the
    // dependency is visible rather than discovered.
    spawn* = <A: Actor>(self: @Self, actor: A) Ref<A>
}
