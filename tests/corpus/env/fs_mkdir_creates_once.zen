// `mkdir` is the answer to "make sure this directory exists", the shape
// `remove` already has for files: the bool says whether THIS call did the
// work, an existing directory is Ok(false), and Err is reserved for a
// name that cannot become a directory.

FsError = std.env

main = (env: Env) Res<i32, FsError> {
    env.fs.mkdir("made").match({
        Err(_)  => println("first mkdir failed"),
        Ok(yes) => println("first mkdir {}", yes),
    });
    println("is_dir {}", env.fs.is_dir("made"));

    // asking twice is answered by the type: already there is Ok(false)
    env.fs.mkdir("made").match({
        Err(_)  => println("second mkdir failed"),
        Ok(yes) => println("second mkdir {}", yes),
    });

    // a file at that name cannot become a directory
    env.fs.write("file.txt", "x\n").try();
    env.fs.mkdir("file.txt").match({
        Err(Exists) => println("a file in the way is Exists"),
        Err(_)      => println("a file in the way is some other error"),
        Ok(yes)     => println("a file in the way answered {}", yes),
    });

    // one level only, like mkdir(2): a missing parent is NotFound
    env.fs.mkdir("missing/child").match({
        Err(NotFound) => println("a missing parent is NotFound"),
        Err(_)        => println("a missing parent is some other error"),
        Ok(yes)       => println("a missing parent answered {}", yes),
    });
    Ok(0);
}
