// `rt.set_default` is a startup-only contract: the process
// default is read by pool WORKER threads with no lock, so it is only safe to write during single-threaded
// startup, BEFORE any spawn. Calling it AFTER a spawn is a silent data-race footgun, so the guard turns it
// into a teaching PANIC. Here a `pool_spawn` latches the guard (mark_spawned), then `set_default` is called
// too late — it must print `zen: panic: rt.set_default must be called before spawning any actor` and abort
// (exit 134). Asserted in harness_build.zen's "build shell" suite (exit 134 + the exact message).
{ pool_spawn } = std.concurrent.pool
{ set_default, heap_rt } = std.rt
{ malloc } = std.mem.alloc
noop = (user: RawPtr<u8>, msg: i64) void { }
main = () i32 {
    blk = malloc(8)
    pool_spawn(blk, 4, noop)    // first spawn -> latches the set_default guard
    set_default(heap_rt())
    0
}    // AFTER a spawn -> must PANIC (startup-only contract violated)
