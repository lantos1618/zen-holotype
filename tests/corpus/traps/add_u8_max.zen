// tests/corpus/traps/add_u8_max.zen
// u8.MAX + 1 traps. unsigned overflow is still overflow: it
// wraps only where +% says so

// main must name an error type. a trap never lifts into Res:
// it aborts the process
Error = Overflow | DivideByZero | OutOfBounds

main = (env: Env) Res<i32, Error> {
    x: u8 = u8.MAX;
    sum   = x + 1;
    println("{}", sum);
    Ok(0);
}
