// Checked conversion preserves fitting values and refuses both range edges.
to_i32, to_u16, to_usize, to_u8 = std.core.num

once = (count :: i32, value: i64) i64 {
    count = count + 1;
    value
}

main = (env: Env) () {
    low: i64  = -2147483648;
    high: i64 = 2147483647;
    println(
        "signed: {} {}",
        low.to_i32().value_or(1),
        high.to_i32().value_or(1)
    );
    println(
        "signed refused: {} {}",
        (low - 1).to_i32().match({ None => true, _ => false }),
        (high + 1).to_i32().match({ None => true, _ => false })
    );
    unsigned: u64 = 2147483647;
    println(
        "unsigned: {} {} {}",
        unsigned.to_i32().value_or(1),
        (unsigned + 1).to_i32().match({ None => true, _ => false }),
        u64.MAX.to_i32().match({ None => true, _ => false })
    );
    small: u64 = 65535;
    println(
        "u16: {} {}",
        small.to_u16().value_or(0),
        (small + 1).to_u16().match({ None => true, _ => false })
    );
    byte: u32 = 255;
    println(
        "u8: {} {}",
        byte.to_u8().value_or(0),
        (byte + 1).to_u8().match({ None => true, _ => false })
    );
    println(
        "index: {}",
        usize.MAX.to_u64().to_usize().value_or(0) == usize.MAX
    );
    calls: i32 ::= 0;
    first  = once(calls, 42).to_i32();
    second = to_i32(once(calls, 2147483648));
    println(
        "once: {} {} {}",
        calls,
        first.value_or(0),
        second.match({ None => true, _ => false })
    );
    println(
        "parsing: {} {} {}",
        "-2147483648".parse_i32().value_or(0),
        "2147483648".parse_i32().match({ None => true, _ => false }),
        "65536".parse_u16().match({ None => true, _ => false })
    );
}
