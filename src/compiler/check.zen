// compiler.check — resolve and infer over the shared genc AST.
// This pass fills enum names, constructor types, UFCS dispatch, generic instances, and the
// type facts the validator/backend need. Child nodes are rebuilt, not mutated in place.
{ Expr, Stmt, Decl, Func, Param, Ty, EnumDecl, StructDecl, Field, ArmData, MatchData, VariantDef,
  IndexData, MemberData, ArrowData, VarData, CallData, CondData, BinData, BlockData, LambdaData,
  GenericData, MakeEnumData, TagData, LoopData, GenEnumDecl, GenStructDecl } = compiler.ast.ast_types
{ cbuf, vref, cond, call_at, call_full, slett, sexpr, block, stmts_diverge, fnt_from_func_in,
  fntype, subst_ty_in, no_tys, expr_null, tgeneric, ti32, ti64, tu8, tf64, tbool, tstring_cstr,
  tstring_literal, tnamed, tptr, tptr_k, tslice, tvoid, k_ptr, k_mut_ptr, k_raw_ptr, gstr_string,
  gstr_push, gstr_append, gstr_finish } = compiler.genc
{ mangle_str_in, impl_cname_in } = compiler.mangle
{ Malloc } = std.mem.alloc
{ exports_get, alias_prefixes_get, module_sigs_get } = compiler.parse
{ expect } = std.core.result
{ view, is_empty, ends_with } = std.text.str
{ String } = std.text.string
{ at, is_alnum } = std.text.ascii
{ Map, of } = std.collections.map
{ xform_body } = compiler.passes.subst
// AST-node query traits (is_fnt on Ty, is_generic_fn on Func). Importing from compiler.astops pulls
// the WHOLE module (all its impls: Ty/Func/Decl/StructDecl) into check's import closure, so the impl
// index resolves these UFCS methods here and in every module that imports check (validate/*, passes/*).
{ gstr_int, map_slice, slice_any, wr_writes_name } = compiler.astops
// Cohesive families extracted into flat sibling files (pure moves). The check↔check_* cycles are
// resolved by the `*` exports on both sides — --build-self concatenates all sources into one flat TU.
{ impl_trait_targ, light_ty, ty_mentions, ty_mentions_any, unify_ty } = compiler.check_infer
{ is_empty_named } = compiler.check_inline
{ TyFits } = compiler.check_fits    // trait import: project-mode closure pull (dispatch itself needs no names)
{ FlatRegion, ModuleTable, fregion_find, is_import_line, lstrip, next_line, res_ident_end } = std.internal.resolve
{ arg_exp_v } = compiler.check_resolve
// ── DECLARATION INDEX ───────────────────────────────────────────────────────
// name → decl array index, an O(1) hash map (std.collections.map). Built once per
// resolve/check pass from the (immutable, within a pass) decls slice and threaded through Env,
// replacing the O(n) linear `the_func`/sibling scans that dominated compile time. `put` overwrites,
// so each name maps to its LAST occurrence — identical to the old last-match scans (top-level names
// are unique post-dedup anyway). -1 means absent.
// ── per-module UFCS visibility (#574) ────────────────────────────────────────────────────────────
// The flat namespace makes every closure module's top-level fns name-resolvable from every OTHER
// module, so `yn.len()` in a module that never imports `len` still binds whichever flat `len`
// survived dedup — silently computing through an unrelated function (or dying at the C linker when
// no definition made it into the emitted closure). UfcsVis carries what the call validator needs to
// close that hole: the flat source (a method-shaped call site is one whose callee name is preceded
// by `.`), the per-module flat regions, and the module table whose per-module ModuleSig answers
// "does the module owning this position define or import this name?". The driver builds it from its
// ResolvedProgram (ufcs_vis_of); every other caller gets the disabled default (ufcs_vis_off), so
// single-module and harness paths keep their existing behavior.
UfcsVis*: {
    on: bool,
    flat: string_view,
    regions: [FlatRegion],
    table: ModuleTable,
    imports: Map<i64>,
    // is the byte before `pos` a `.` — i.e. was this call written `recv.name(...)`, not `name(recv)`?
    vis_method_shaped = (vis: UfcsVis, pos: i32) bool {
        // direct byte load — the old flat.view() strlen'd the WHOLE flat per query (this runs for
        // every method-shaped call the kv validators inspect). pos is a real flat offset of a call
        // the user wrote (caller-guarded pos > 0), so pos-1 is in bounds.
        pos > 0 && load(offset(vis.flat, to_i64(pos) - 1)) == '.'
    }
    // an ALIAS-APPENDED module body is text-renamed (`abs` -> `m__abs`) including its own internal
    // references, so a self-call inside such a region carries the prefixed name while the module's
    // ORIGINAL source (what the visibility walk scanned) declares the bare tail — accept the tail.
    vis_alias_tail_has = (vis: UfcsVis, a: MutPtr<Malloc>, mi: i64, name: string_view) bool {
        sep := name.alias_sep()
        (sep > 0).match ({
            true  => vis.imports.get(a.vis_key(mi, name.alias_tail(sep)), 0) == mi + 1,
            false => false,
        })
    }
    // does the flat source at `pos` literally spell `name` (followed by a non-identifier byte)?
    // False for every DISPATCH-REWRITTEN call — impl/mono/alias rewrites (`gstr_append_Malloc`,
    // `impl_Verdict_i32_or`, …) keep the surface method's pos but carry a mangled fn, and a rewrite
    // means dispatch RESOLVED the call, so the visibility check must not judge it.
    vis_name_at = (vis: UfcsVis, pos: i32, name: string_view) bool {
        // Byte-compare `name` against flat[pos..] directly. The old body called flat.view() — a
        // strlen over the WHOLE flattened program — on every query. The && chain short-circuits at
        // the first mismatch, and name's bytes are never NUL, so the walk stops at (never crosses)
        // the flat's terminator; a flat shorter than pos+len mismatches on the NUL exactly where
        // the old length guard said false. The tail probe only runs when every name byte matched,
        // so its offset is at most the terminator.
        nb: [u8] := name.view()
        same := true
        nb.loop((h, i, b) {
            same = same && load(offset(vis.flat, to_i64(pos) + i)) == b
        })
        tail: u8 := same.then({ load(offset(vis.flat, to_i64(pos) + nb.len)) }, { 0 })
        same && (tail.is_alnum() || tail == '_') == false
    }
    // does the module owning flat offset `pos` define or import `name`? Both answered by the
    // dedicated per-module walk (vis_head_names): column-0 decl names + every import-head name.
    // (The resolver's shared symbol scan is NOT consulted: on raw disk sources it mis-cascades over
    // imports below a header comment / mid-file ns-alias lines, and fixing that scan would change
    // dedup/alias behavior for every resolver consumer.) A position outside every region (a
    // synthesized node) stays lenient — this check only ever REJECTS a call the user wrote.
    vis_name_visible = (vis: UfcsVis, a: MutPtr<Malloc>, pos: i32, name: string_view) bool {
        ri := vis.regions.fregion_find(to_i64(pos))
        (ri < 0).match ({
            true  => true,
            false => {
                mi := vis.regions[ri].midx
                (mi < 0 || mi >= vis.table.modules.len).match ({
                    true  => true,
                    false => vis.imports.get(a.vis_key(mi, name), 0) == mi + 1
                        || vis.vis_alias_tail_has(a, mi, name),
                })
            },
        })
    }
}
ufcs_vis_off* = (a: MutPtr<Malloc>) UfcsVis {
    seed: i64 := 0 - 1
    UfcsVis(
        on: false,
        flat: "",
        regions: slice(null_ptr(), 0),
        table: ModuleTable(modules: slice(null_ptr(), 0)),
        imports: of(a, "", seed).expect("check: ufcs-vis alloc"),
    )
}
// one module's import-HEAD names, by a dedicated line walk over its ORIGINAL source: an import line
// contributes every identifier between its `{` and `}` (multi-line lists included — the walk resumes
// from the line holding the `}`), any other line is skipped whole. Deliberately separate from the
// resolver's symbol scan so shared dedup/alias behavior is untouched.
vis_close_pos = (src: string_view, p: i32) i32 {
    out := p
    bs: [u8] := src.view()
    (to_i64(p) < bs.len).then({
        span: [u8] := slice(src.offset(p), bs.len - to_i64(p))
        span.loop((h, i, b) {
            out = p + to_i32(i)
            (b == '}' || b == 0).then({
                h.break
            })
        })
    })
    out
}
vis_copy_name = (a: MutPtr<Malloc>, src: string_view, p: i32, e: i32) string_view {
    s := a.gstr_string(to_i64(e - p) + 1)
    span: [u8] := slice(src.offset(p), to_i64(e - p))
    span.loop((h, i, b) {
        s = s.gstr_push(a, b)
    })
    s.gstr_finish(a)
}
// import-head entries are keyed `<midx>\t<name>` in ONE map (a slice of per-module maps would need
// sizeof over a generic instance); the stored value is midx+1 so the absent-sentinel 0 can never
// collide with a real module index.
// the module index renders through compiler.astops' one decimal writer (gstr_int; mi is a
// non-negative index, so the bit-reinterpreting u64 path prints its plain decimal digits).
vis_key = (a: MutPtr<Malloc>, mi: i64, name: string_view) string_view {
    s := a.gstr_string(name.view().len + 8).gstr_int(a, mi).gstr_push(a, '\t')
    nb: [u8] := name.view()
    nb.loop((h, i, b) {
        s = s.gstr_push(a, b)
    })
    s.gstr_finish(a)
}
vis_head_fill = (a: MutPtr<Malloc>, src: string_view, mi: i64, p: i32, m0: Map<i64>) Map<i64> {
    m := m0
    pos := p
    bs: [u8] := src.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos == false).then({
            (b == '}' || b == 0).match ({
                true  => {
                    h.break
                },
                false => (b.is_alnum() || b == '_').match ({
                    true  => {
                        ie := src.res_ident_end(pos)
                        m = m
                            .put(a, a.vis_key(mi, a.vis_copy_name(src, pos, ie)), mi + 1)
                            .expect("check: ufcs-vis alloc")
                        pos = ie
                    },
                    false => {
                        pos = pos + 1
                    },
                }),
            })
        })
    })
    m
}
vis_head_names = (a: MutPtr<Malloc>, src: string_view, mi: i64, m0: Map<i64>) Map<i64> {
    m := m0
    pos: i32 := 0
    bs: [u8] := src.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos == false).then({
            src.is_import_line(pos).match ({
                true  => {
                    hp := src.lstrip(pos) + 1
                    m = a.vis_head_fill(src, mi, hp, m)
                    pos = src.next_line(src.vis_close_pos(hp))
                },
                false => {
                    // a COLUMN-0 identifier is a top-level decl name (fmt guarantees the indent
                    // discipline); anything else on the line is body/continuation — skip the line.
                    b.is_alnum_head().then({
                        ie := src.res_ident_end(pos)
                        m = m
                            .put(a, a.vis_key(mi, a.vis_copy_name(src, pos, ie)), mi + 1)
                            .expect("check: ufcs-vis alloc")
                    })
                    pos = src.next_line(pos)
                },
            })
        })
    })
    m
}
// an identifier HEAD byte (letter or underscore) — digits can't open an identifier.
is_alnum_head = (b: u8) bool { b.is_alnum() && (b >= '0' && b <= '9') == false }
ufcs_vis_of* = (
    a: MutPtr<Malloc>,
    flat: string_view,
    regions: [FlatRegion],
    table: ModuleTable,
) UfcsVis {
    seed: i64 := 0 - 1
    m := of(a, "", seed).expect("check: ufcs-vis alloc")
    table.modules.loop((h, i, e) {
        m = a.vis_head_names(e.source, i, m)
    })
    UfcsVis(
        on: true,
        flat: flat,
        regions: regions,
        table: table,
        imports: m,
    )
}
DeclIndex*: {
    vis: UfcsVis,
    func_idx: Map<i64>,
    struct_idx: Map<i64>,
    enum_idx: Map<i64>,
    global_idx: Map<i64>,
    impl_idx: Map<i64>,
    tdef_idx: Map<i64>,
    alias_idx: Map<i64>,
    tmethod_idx: Map<i64>,
    import_idx: Map<i64>,
    genstruct_idx: Map<i64>,
    genenum_idx: Map<i64>,
    dispatch_idx: Map<i64>,
    idx_func = (idx: DeclIndex, decls: [Decl], name: string_view) Func {
        i := idx.func_idx.get(name, 0 - 1)
        (i >= 0 && i < decls.len).match ({
            true  => decls[i].match ({
                .DFunc(f)    => f,
                .DForeign(f) => f,
                _            => Func(
                    name: "",
                    params: empty_params(),
                    ret: tvoid(),
                    tparams: empty_params(),
                    body: no_stmts(),
                ),
            }),
            false => Func(
                name: "",
                params: empty_params(),
                ret: tvoid(),
                tparams: empty_params(),
                body: no_stmts(),
            ),
        })
    }
    idx_struct_field = (idx: DeclIndex, decls: [Decl], sname: string_view, fname: string_view) Ty {
        i := idx.struct_idx.get(sname, 0 - 1)
        (i >= 0 && i < decls.len).match ({
            true  => decls[i].match ({
                .DStruct(sd) => sd.field_ty(fname),
                _            => tvoid(),
            }),
            false => tvoid(),
        })
    }
    // the full field list of a concrete struct `sname` (empty slice if `sname` is not a struct). Used by
    // the field_eq inliner (compiler.passes.subst) to expand `x.field_eq(y)` into a per-field `==` fold.
    idx_struct_fields = (idx: DeclIndex, decls: [Decl], sname: string_view) [Field] {
        i := idx.struct_idx.get(sname, 0 - 1)
        (i >= 0 && i < decls.len).match ({
            true  => decls[i].match ({
                .DStruct(sd) => sd.fields,
                _            => slice(null_ptr(), 0),
            }),
            false => slice(null_ptr(), 0),
        })
    }
    idx_genstruct_field = (
        idx: DeclIndex,
        a: MutPtr<Malloc>,
        decls: [Decl],
        gname: string_view,
        fname: string_view,
        targs: [Ty],
    ) Ty {
        g := idx.idx_genstruct(decls, gname)
        is_empty(g.name).match ({
            true  => tvoid(),
            false => a.subst_ty_in(g.tparams, targs, g.fields.gen_field_at(fname)),
        })
    }
    // the full variant list of a concrete enum `ename` (empty slice if `ename` is not an enum) — the
    // enum mirror of idx_struct_fields. The variant_name inliner (compiler.passes.subst) expands
    // `e.variant_name()` into one match arm per variant.
    idx_enum_variants = (idx: DeclIndex, decls: [Decl], ename: string_view) [VariantDef] {
        i := idx.enum_idx.get(ename, 0 - 1)
        (i >= 0 && i < decls.len).match ({
            true  => decls[i].match ({
                .DEnum(ed) => ed.variants,
                _          => slice(null_ptr(), 0),
            }),
            false => slice(null_ptr(), 0),
        })
    }
    idx_variant_payload = (idx: DeclIndex, decls: [Decl], ename: string_view, vn: string_view) Ty {
        i := idx.enum_idx.get(ename, 0 - 1)
        (i >= 0 && i < decls.len).match ({
            true  => decls[i].match ({
                .DEnum(ed) => ed.variants.vdef_payload(vn),
                _          => tvoid(),
            }),
            false => tvoid(),
        })
    }
    idx_template_call = (idx: DeclIndex, decls: [Decl], name: string_view) bool {
        idx.idx_func(decls, name).is_generic_fn()
    }
    idx_genstruct = (idx: DeclIndex, decls: [Decl], name: string_view) GenStructDecl {
        i := idx.genstruct_idx.get(name, 0 - 1)
        (i >= 0 && i < decls.len).match ({
            true  => decls[i].match ({
                .DGenStruct(g) => g,
                _              => GenStructDecl(
                    name: "",
                    tparams: slice(null_ptr(), 0),
                    fields: slice(null_ptr(), 0),
                ),
            }),
            false => GenStructDecl(
                name: "",
                tparams: slice(null_ptr(), 0),
                fields: slice(null_ptr(), 0),
            ),
        })
    }
    idx_genenum = (idx: DeclIndex, decls: [Decl], name: string_view) GenEnumDecl {
        i := idx.genenum_idx.get(name, 0 - 1)
        (i >= 0 && i < decls.len).match ({
            true  => decls[i].match ({
                .DGenEnum(g) => g,
                _            => GenEnumDecl(
                    name: "",
                    tparams: slice(null_ptr(), 0),
                    variants: slice(null_ptr(), 0),
                ),
            }),
            false => GenEnumDecl(
                name: "",
                tparams: slice(null_ptr(), 0),
                variants: slice(null_ptr(), 0),
            ),
        })
    }
    idx_variant_default = (
        idx: DeclIndex,
        decls: [Decl],
        ename: string_view,
        vn: string_view,
    ) Ptr<Expr> {
        i := idx.enum_idx.get(ename, 0 - 1)
        (i >= 0 && i < decls.len).match ({
            true  => decls[i].match ({
                .DEnum(ed) => ed.variants.vdef_default_of(vn),
                _          => expr_null(),
            }),
            false => expr_null(),
        })
    }
}    // DFunc.name | DForeign.name → index
tdkey = (a: MutPtr<Malloc>, tr: string_view, m: string_view) string_view {
    a
        .gstr_string(64)
        .gstr_append(a, tr)
        .gstr_append(a, "\t")
        .gstr_append(a, m)
        .gstr_finish(a)
}    // DStruct.name → index
// ── alias-name index (UFCS through module aliases) ──────────────────────────────────────────────
// std.internal.resolve loads `m = std.collections.hmap` by prefixing hmap's top-level value decls
// with `m__`. alias_idx maps the BARE method tail (`put` for `m__put`) to a decl index, so the
// UFCS fallback in dispatch_name can O(1)-reject names that no alias provides (the common case for
// intrinsics like `store`/`offset` and deferred trait methods) before scanning for candidates.
// byte position of the LAST `__` separator in `name`, or -1 when it has none.
alias_sep_from = (name: string_view, p: i32, last: i32) i32 {
    (name.at(p) == 0).match ({
        true  => last,
        false => (name.at(p) == '_' && name.at(p + 1) == '_').match ({
            true  => name.alias_sep_from(p + 1, p),
            false => name.alias_sep_from(p + 1, last),
        }),
    })
}
alias_sep = (name: string_view) i32 { name.alias_sep_from(0, 0 - 1) }
// the method tail after the separator (`put` of `m__put`) — a NUL-terminated suffix, no copy.
alias_tail = (name: string_view, sep: i32) string_view { cstr(offset(name, to_i64(sep + 2))) }
// does `name` begin with `pre` immediately followed by the `__` separator (`m` matches `m__put`)?
alias_prefix_match_at = (name: string_view, pre: string_view, i: i32) bool {
    (pre.at(i) == 0).match ({
        true  => name.at(i) == '_' && name.at(i + 1) == '_',
        false => (name.at(i) == pre.at(i)).match ({
            true  => name.alias_prefix_match_at(pre, i + 1),
            false => false,
        }),
    })
}
// is `name`'s prefix an ACTUAL module-alias binding (from `m = std.x.y` / `m = sibling`)? Only then is
// `name` a genuine `alias__method` decl. Guards against phantom UFCS methods: a plain user fn that
// merely has `__` in its name (`foo__grow`) has no matching alias, so it is NOT alias-shaped.
alias_is_real_prefix = (name: string_view) bool {
    f := false
    alias_prefixes_get().loop((h, i, p) {
        f = name.alias_prefix_match_at(p.name, 0).then({ true }, { f })
    })
    f
}
// register `name` under its tail iff it is alias-shaped: a NON-EMPTY prefix that is a REAL module alias
// (skips compiler internals like `__str_eq`, whose separator is at position 0, and plain user fns like
// `foo__grow` whose prefix is not an alias binding).
alias_note = (m: Map<i64>, a: MutPtr<Malloc>, name: string_view, i: i64) Map<i64> {
    sep := name.alias_sep()
    (sep > 0 && name.alias_is_real_prefix()).match ({
        true  => m.put(a, name.alias_tail(sep), i).expect("check: decl-index alloc"),
        false => m,
    })
}
// fold a name-only [Param] list (DImpl.methods / DImport.names) into a presence map.
names_note = (m: Map<i64>, a: MutPtr<Malloc>, names: [Param], i: i64) Map<i64> {
    mm := m
    names.loop((h, j, p) {
        mm = mm.put(a, p.name, i).expect("check: decl-index alloc")
    })
    mm
}
build_decl_index* = (a: MutPtr<Malloc>, decls: [Decl]) DeclIndex {
    seed: i64 := 0 - 1    // DEnum.name → index
    // DGlobal.name → index
    // DImpl.ty → presence marker (a type with at least one impl)
    // (trait "\t" method) → presence: the trait provides a default for the method
    // the combined key for a trait-default lookup; trait/method are identifiers, so a TAB can't collide.
    fm := of(a, "", seed).expect("check: decl-index alloc")
    sm := of(a, "", seed).expect("check: decl-index alloc")
    em := of(a, "", seed).expect("check: decl-index alloc")
    gm := of(a, "", seed).expect("check: decl-index alloc")
    im2 := of(a, "", seed).expect("check: decl-index alloc")
    tm := of(a, "", seed).expect("check: decl-index alloc")
    am := of(a, "", seed).expect("check: decl-index alloc")
    mm := of(a, "", seed).expect("check: decl-index alloc")
    pm := of(a, "", seed).expect("check: decl-index alloc")
    gsm := of(a, "", seed).expect("check: decl-index alloc")
    gem := of(a, "", seed).expect("check: decl-index alloc")
    decls.loop((h, i, d) {
        d.match ({
            .DFunc(f)          => {
                fm = fm.put(a, f.name, i).expect("check: decl-index alloc")
                am = am.alias_note(a, f.name, i)
            },
            .DForeign(f)       => {
                fm = fm.put(a, f.name, i).expect("check: decl-index alloc")
                am = am.alias_note(a, f.name, i)
            },
            .DStruct(s)        => {
                sm = sm.put(a, s.name, i).expect("check: decl-index alloc")
            },
            .DEnum(e)          => {
                em = em.put(a, e.name, i).expect("check: decl-index alloc")
            },
            .DGlobal(g)        => {
                gm = gm.put(a, g.name, i).expect("check: decl-index alloc")
            },
            .DImpl(imd)        => {
                im2 = im2.put(a, imd.ty, i).expect("check: decl-index alloc")
                mm = mm.names_note(a, imd.methods, i)
            },
            .DTraitDefault(td) => {
                tm = tm.put(a, a.tdkey(td.trname, td.fn.name), i).expect("check: decl-index alloc")
                mm = mm.put(a, td.fn.name, i).expect("check: decl-index alloc")
            },
            .DImport(imp)      => {
                pm = pm.names_note(a, imp.names, i)
            },
            .DGenStruct(gs)    => {
                gsm = gsm.put(a, gs.name, i).expect("check: decl-index alloc")
            },
            .DGenEnum(ge)      => {
                gem = gem.put(a, ge.name, i).expect("check: decl-index alloc")
            },
            _                  => { },
        })
    })
    // ── dispatch index: (recv-ty "\t" method) → decl index of the LAST impl of that ty providing the
    // method, directly or via its trait's default — exactly the last-match verdict the old linear
    // dispatch_recv scan produced. Built as a second sweep (a trait default may be declared anywhere
    // relative to its impls); per impl the direct + defaulted method names are stamped together, so
    // decl order between impls decides, as before.
    tdn: i64 := 0
    decls.loop((h, i, d) {
        d.match ({
            .DTraitDefault(td) => {
                tdn = tdn + 1
            },
            _                  => { },
        })
    })
    tds := a.ibuf(tdn)
    tdk: i64 := 0
    decls.loop((h, i, d) {
        d.match ({
            .DTraitDefault(td) => {
                tds[tdk] = i
                tdk = tdk + 1
            },
            _                  => { },
        })
    })
    dm := of(a, "", seed).expect("check: decl-index alloc")
    decls.loop((h, i, d) {
        d.match ({
            .DImpl(imd) => {
                imd.methods.loop((h2, j, p) {
                    dm = dm.put(a, a.tdkey(imd.ty, p.name), i).expect("check: decl-index alloc")
                })
                tds.loop((h2, j, ti) {
                    decls[ti].match ({
                        .DTraitDefault(td) => {
                            (td.trname == imd.trname).then({
                                dm = dm
                                    .put(a, a.tdkey(imd.ty, td.fn.name), i)
                                    .expect("check: decl-index alloc")
                            })
                        },
                        _                  => { },
                    })
                })
            },
            _           => { },
        })
    })
    DeclIndex(
        vis: a.ufcs_vis_off(),
        func_idx: fm,
        struct_idx: sm,
        enum_idx: em,
        global_idx: gm,
        impl_idx: im2,
        tdef_idx: tm,
        alias_idx: am,
        tmethod_idx: mm,
        import_idx: pm,
        genstruct_idx: gsm,
        genenum_idx: gem,
        dispatch_idx: dm,
    )
}
// build_decl_index with a LIVE per-module visibility (driver check path); the plain builder keeps
// the disabled default so its 20+ existing call sites are untouched.
build_decl_index_vis* = (a: MutPtr<Malloc>, decls: [Decl], vis: UfcsVis) DeclIndex {
    idx := a.build_decl_index(decls)
    idx.vis = vis
    idx
}
ibuf = (a: MutPtr<Malloc>, n: i64) [i64] { slice(a.acquire((n + 1) * sizeof(i64)), n) }
// O(1) indexed generic-decl lookups (same last-match sentinels as the linear gstruct_of/find_genenum).
// Variable environment: params plus prior lets, as a cons-list.
VList*: VNil | VCons(VCell)
VCell: {
    name: string_view,
    ty: Ty,
    tail: Ptr<VList>,
}
// exp is the current expected type; tvoid() means no expectation.
Env*: {
    vars: Ptr<VList>,
    decls: [Decl],
    didx: DeclIndex,
    exp: Ty,
    a: MutPtr<Malloc>,
    infer_expr = (env: Env, e: Ptr<Expr>) Ty {
        load(e).match ({
            .Int(n)        => (n > 2147483647 || n < 0 - 2147483648).then({ ti64() }, { ti32() }),
            .Block(b)      => env.block_ty(b),
            .Byte(n)       => tu8(),
            .FloatLit(ft)  => tf64(),
            .Var(v)        => env.var_ty(v.name),
            .Bin(b)        => env.bin_ty_e(b),
            .Call(c)       => env.infer_call(c),
            .Cond(d)       => env.cond_ty(d),
            .Member(mm)    => env.infer_member(mm),
            .Arrow(ar)     => env.infer_arrow(ar),
            .MakeEnum(mk)  => env.mkenum_ty(mk),
            .Tag(t)        => env.tag_ty(t),
            .MakeStruct(s) => (s.targs.len > 0).match ({
                true  => tgeneric(s.ty, s.targs, s.mty),
                false => tnamed(s.ty),
            }),
            .StrLit(x)     => tstring_literal(),
            .Match(m)      => env.infer_match_ty(m),
            .Index(ix)     => env.index_elem(ix),
            .Loop(l)       => tvoid(),
            .SliceLit(sd)  => tslice(env.a.tnode(sd.elem.is_void_ty().match ({
                true  => env.sl_elem(sd.items),
                false => sd.elem,
            }))),
            _              => tvoid(),
        })
    }
    env_func = (env: Env, name: string_view) Func {
        i := env.didx.func_idx.get(name, 0 - 1)
        (i >= 0 && i < env.decls.len).match ({
            true  => env.decls[i].match ({
                .DFunc(f)    => f,
                .DForeign(f) => f,
                _            => Func(
                    name: "",
                    params: empty_params(),
                    ret: tvoid(),
                    tparams: empty_params(),
                    body: no_stmts(),
                ),
            }),
            false => Func(
                name: "",
                params: empty_params(),
                ret: tvoid(),
                tparams: empty_params(),
                body: no_stmts(),
            ),
        })
    }
    var_or_global = (env: Env, name: string_view) Ty {
        lv := env.vars.lookup_var(name)
        lv.is_void_ty().then({ env.global_or_fn(name) }, { lv })
    }
    subj_variant_payload = (env: Env, t: Ty, variant: string_view) Ty {
        t.match ({
            .Generic(g) => env.env_genenum(g.name).gen_variant_payload(variant).gsubst(env, g),
            _           => env.didx.idx_variant_payload(env.decls, t.enum_name(), variant),
        })
    }
    env_gstruct = (env: Env, name: string_view) GenStructDecl {
        env.didx.idx_genstruct(env.decls, name)
    }
    // ── lazy arg-type memo for generic-call inference ── each argument's type is inferred at most
    // ONCE per gen_call_ret and reused by dispatch AND every (tparam × typed/literal pass) scan.
    // Previously dispatch_name inferred the receiver, then each tparam ran targ_of twice, every scan
    // re-running infer_expr on each arg it visited — on nested UFCS call chains each level multiplied
    // the levels below it, so chain inference was exponential in chain depth. Seeding the receiver
    // type once (gen_call_ret) and memoizing the rest (done[i] flags, lazily — a scan still infers
    // only the args it visits) makes it linear. infer_expr is pure for a fixed Env, so the memoized
    // types are exactly what re-inference would produce: same targs, byte-identical emitted C.
    // atys+done live in ONE allocation (n Ty slots, then n done bytes).
    arg_ty_memo = (env: Env, args: [Expr], atys: [Ty], done: [u8], i: i64) Ty {
        (done[i] == 0).then({
            atys[i] = env.infer_expr(args[i].addr())
            done[i] = 1
        })
        atys[i]
    }
    call_targ = (env: Env, f: Func, args: [Expr], tp: string_view) Ty {
        raw := env.a.acquire(args.len * sizeof(Ty) + args.len)
        atys: [Ty] := slice(raw, args.len)
        done: [u8] := slice(raw.offset(args.len * sizeof(Ty)), args.len)
        args.loop((h, i, x) {
            done[i] = 0
        })
        env.call_targ_a(f, args, atys, done, tp)
    }
    call_targ_a = (env: Env, f: Func, args: [Expr], atys: [Ty], done: [u8], tp: string_view) Ty {
        arg := env.targ_of(f.params, args, atys, done, tp, false)
        arg = arg.is_void_ty().then({ env.ret_targ_of(f.ret, tp) }, { arg })
        arg.is_void_ty().then({ env.targ_of(f.params, args, atys, done, tp, true) }, { arg })
    }
    with_exp = (env: Env, t: Ty) Env {
        Env(
            vars: env.vars,
            decls: env.decls,
            didx: env.didx,
            exp: t,
            a: env.a,
        )
    }
    is_local = (env: Env, name: string_view) bool { env.vars.var_bound(name) }
    is_bound = (env: Env, name: string_view) bool {
        env.vars.var_bound(name) || env.didx.global_idx.get(name, 0 - 1) >= 0
    }
    alias_ufcs_candidates = (env: Env, c: CallData, rty: Ty) AliasCands {
        fn := c.fn
        (rty.alias_recv_dispatchable() == false
            || fn.is_intrinsic()
            || env.didx.alias_idx.get(fn, 0 - 1) < 0
            || env.didx.func_idx.get(fn, 0 - 1) >= 0
            || env.is_local(fn)
            || env.global_ty(fn).is_void_ty() == false).then({
            return alias_cands_none()
        })
        atys := env.alias_arg_tys(c.args)
        exact := env.alias_cands_scan(fn, rty, true, atys)
        (exact.count > 0).then({ exact }, { env.alias_cands_scan(fn, rty, false, atys) })
    }
    // the inferred types of a call's arguments (arg0 = receiver included), for arg-typed narrowing
    // among same-receiver alias candidates. Inferred ONCE here, not per candidate.
    alias_arg_tys = (env: Env, args: [Expr]) [Ty] {
        buf := cbuf<Ty>(env.a, args.len)
        args.loop((h, i, x) {
            buf[i] = env.infer_expr(args[i].addr())
        })
        buf
    }
    var_ty = (env: Env, name: string_view) Ty {
        (name == "true" || name == "false").then({ tbool() }, { env.var_or_global(name) })
    }
    targ_of = (
        env: Env,
        params: [Param],
        args: [Expr],
        atys: [Ty],
        done: [u8],
        tp: string_view,
        lits: bool,
    ) Ty {
        found := tvoid()
        params.loop((h, i, p) {
            found = found.is_void_ty().match ({
                true  => (i < args.len && env.weak_targ_env(p.ty, args, atys, done, i, tp) == lits).match ({
                    true  => env.unify_arg(p.ty, args, atys, done, i, tp),
                    false => found,
                }),
                false => found,
            })
        })
        found
    }
    sl_elem_exp = (env: Env, items: [Expr]) Ty {
        env.exp.elem_of().is_void_ty().then({ env.sl_elem(items) }, { env.exp.elem_of() })
    }
    let_exp = (env: Env, t: Ty) Env {
        t.is_void_ty().match ({
            true  => env.clr_exp(),
            false => Env(
                vars: env.vars,
                decls: env.decls,
                didx: env.didx,
                exp: t,
                a: env.a,
            ),
        })
    }
    infer_call = (env: Env, c: CallData) Ty {
        (c.fn == "each_field" || c.fn == "zip_fields").then({
            return tvoid()
        })
        (c.fn == "field_eq" || c.fn == "__str_eq" || c.fn == "__str_ne" || c.fn == "atomic_cas_i64").then({
            return tbool()
        })
        (c.fn == "variant_name").then({
            return tstring_literal()
        })
        // Conversion intrinsics erase to C casts (backend/c/c_expr.zen) and accept ANY numeric
        // receiver — including f64. `(3.9).to_i64()` yields the truncating `(int64_t)` cast, i.e.
        // truncation toward zero. Do not constrain the receiver to integers.
        (c.fn == "sizeof"
            || c.fn == "load_i64"
            || c.fn == "atomic_add_i64"
            || c.fn == "atomic_load_i64"
            || c.fn == "to_i64").then({
            return ti64()
        })
        (c.fn == "load").then({
            return env.arg0_ty(c).pointee_of()
        })
        (c.fn == "to_i32").then({
            return ti32()
        })
        (c.fn == "to_u8").then({
            return tu8()
        })
        (c.fn == "to_f64").then({
            return tf64()
        })
        (c.fn == "null_ptr").then({
            return tptr_k(env.a.tnode(tu8()), k_raw_ptr())
        })
        (c.fn == "cstr").then({
            return tstring_cstr()
        })
        (c.fn == "addr").then({
            return env.addr_ty(c)
        })
        (c.fn == "assert_nonnull").then({
            return env.arg0_ty(c).nonnull_ty()
        })
        env.gen_call_ret(c)
    }
    dispatch_name = (env: Env, c: CallData) string_view {
        (c.args.len > 0).match ({
            true  => env.dispatch_name_r(c, env.infer_expr(c.args[0].addr())),
            false => c.fn,
        })
    }
    // rty = the receiver's already-inferred type — gen_call_ret infers it ONCE and shares it with
    // the targ scans (see arg_ty_memo); the public dispatch_name wrapper infers it for other callers.
    dispatch_name_r = (env: Env, c: CallData, rty: Ty) string_view {
        (c.args.len > 0).match ({
            true  => {
                tyname := rty.dispatch_recv_name()
                // Fast path: a receiver type with NO impl can never redirect dispatch, so skip the O(n)
                // impl scan entirely (the common case for primitive/struct receivers).
                dn := (env.didx.impl_idx.get(tyname, 0 - 1) < 0).match ({
                    true  => c.fn,
                    false => env.a.dispatch_recv(env.decls, env.didx, c.fn, tyname),
                })
                (dn == c.fn).match ({
                    true  => {
                        cs := env.alias_ufcs_candidates(c, rty)
                        (cs.count == 1).then({ cs.first }, { c.fn })
                    },
                    false => dn,
                })
            },
            false => c.fn,
        })
    }
    disc_env = (env: Env, e: Ptr<Expr>) Env {
        e.carries_return_e().then({ env }, { env.clr_exp() })
    }
    clr_exp = (env: Env) Env { env.with_exp(tvoid()) }
    call_targs = (env: Env, f: Func, args: [Expr], etargs: [Ty]) [Ty] {
        env.call_targs_r(f, args, etargs, tvoid(), false)
    }
    // rty0/has0: the already-inferred receiver type from gen_call_ret (see arg_ty_memo above) —
    // seeds the memo so the dispatch infer and the targ scans share ONE arg0 inference.
    call_targs_r = (env: Env, f: Func, args: [Expr], etargs: [Ty], rty0: Ty, has0: bool) [Ty] {
        buf := cbuf<Ty>(env.a, f.tparams.len)
        // one lazy arg-type memo shared by every tparam's scans, in a single allocation.
        raw := env.a.acquire(args.len * sizeof(Ty) + args.len)
        atys: [Ty] := slice(raw, args.len)
        done: [u8] := slice(raw.offset(args.len * sizeof(Ty)), args.len)
        args.loop((h, i, x) {
            done[i] = 0
        })
        (has0 && args.len > 0).then({
            atys[0] = rty0
            done[0] = 1
        })
        f.tparams.loop((h, i, tp) {
            buf[i] = (i < etargs.len).match ({
                true  => etargs[i],
                false => env.call_targ_a(f, args, atys, done, tp.name),
            })
        })
        env.deep_targs_env(f.tparams, buf, f.params, args)
    }
    call_arg_exp = (env: Env, tmpl: bool, tparams: [Param], targs: [Ty], ps: [Param], i: i32) Ty {
        pty := ps.arg_exp_v(i)
        tmpl.match ({
            true  => pty.is_fnt().then({ tvoid() }, { env.a.subst_ty_in(tparams, targs, pty) }),
            false => pty,
        })
    }
    block_ty = (env: Env, b: BlockData) Ty {
        b.stmts.stmts_diverge().then({ tvoid() }, { env.block_ty_from(b.stmts, 0) })
    }
    env_genenum = (env: Env, name: string_view) GenEnumDecl {
        env.didx.idx_genenum(env.decls, name)
    }
}    // a = allocator (heap-alloc in infer); didx = name→decl index
// O(1) indexed lookups, replacing the O(n) decls scans. `the_func`/`fn_ret`/etc. linear forms below
// remain for the few decls-only callers (template inlining, trait conformance) that lack an Env.
// Heap-node helpers. c* names avoid flat-TU collisions with parser helpers.
cebuf*<A> = (a: MutPtr<A>, n: i64) [Expr] { slice(a.acquire(n * sizeof(Expr)), n) }
cenode*<A> = (a: MutPtr<A>, v: Expr) Ptr<Expr> {
    buf := a.cebuf(1)
    buf[0] = v
    buf[0].addr()
}
// Pos-preserving rebuilds. Bare call()/vref() are only for synthesized nodes.
recall* = (a: MutPtr<Malloc>, c: CallData, fn: string_view, args: [Expr]) Ptr<Expr> {
    a.cenode(call_full(fn, args, c.targs, c.pos, c.raw))
}
var_call = (a: MutPtr<Malloc>, v: VarData, args: [Expr]) Ptr<Expr> {
    a.cenode(call_at(v.name, args, v.pos))
}
// Heap-own a Ty so Ptr<Ty> fields do not dangle.
tnode* = (a: MutPtr<Malloc>, t: Ty) Ptr<Ty> {
    buf := cbuf<Ty>(a, 1)
    buf[0] = t
    buf[0].addr()
}
vlbuf = (a: MutPtr<Malloc>) [VList] { slice(a.acquire(sizeof(VList)), 1) }
vlnode = (a: MutPtr<Malloc>, v: VList) Ptr<VList> {
    buf := a.vlbuf()
    buf[0] = v
    buf[0].addr()
}
vnil_val = () VList { .VNil }
vcons_val = (nm: string_view, t: Ty, tail: Ptr<VList>) VList {
    .VCons(VCell(
        name: nm,
        ty: t,
        tail: tail,
    ))
}
vnil* = (a: MutPtr<Malloc>) Ptr<VList> { a.vlnode(vnil_val()) }
vcons* = (a: MutPtr<Malloc>, nm: string_view, t: Ty, tail: Ptr<VList>) Ptr<VList> {
    a.vlnode(vcons_val(nm, t, tail))
}
params_env* = (a: MutPtr<Malloc>, ps: [Param]) Ptr<VList> {
    e := a.vnil()
    ps.loop((h, i, p) {
        e = a.vcons(p.name, p.ty, e)
    })
    e
}
// First-byte prefilter before the full string compare: lookup_var walks the cons-list env once per
// variable reference (the single hottest checker fn), and almost every node on the chain fails the
// compare — one byte load rejects it without the strcmp call. Byte-identical answers: names are
// NUL-terminated, so equal strings always share their first byte (both possibly NUL).
lookup_var* = (v: Ptr<VList>, name: string_view) Ty { v.lookup_var_b(load(offset(name, 0)), name) }
lookup_var_b = (v: Ptr<VList>, b0: u8, name: string_view) Ty {
    v.match ({
        .VNil     => tvoid(),
        .VCons(c) => (load(offset(c.name, 0)) == b0 && c.name == name).match ({
            true  => c.ty,
            false => c.tail.lookup_var_b(b0, name),
        }),
    })
}
// The innermost enclosing function's DECLARED return type, threaded through the variable environment
// under an unlexable name (identifiers cannot start with a digit, so no user binding collides; the
// same trick as the inliner's in-progress-template marker). A `return <expr>` operand is typed against
// THIS — never the positional expected type, which is void everywhere but a body's tail statement
// (an `.or_return()` error branch sits inside a lowered If; a value-position arm's `return`
// sits in a block whose own value expectation is the ARM type). Lambda bodies bind their own (possibly
// void) entry so an enclosing function's return type never leaks into a lambda's `return`.
bind_fnret* = (a: MutPtr<Malloc>, vars: Ptr<VList>, ret: Ty) Ptr<VList> {
    a.vcons("0return", ret, vars)
}
fnret_of* = (v: Ptr<VList>) Ty { v.lookup_var("0return") }
// Generic tparam scoping. A function's type parameters are fn-local names, but in the flat namespace
// a user's GLOBAL type of the same name (`T: { … }`) is the same identifier as the tparam of a stdlib
// generic (`print*<T>`). Threading each tparam name into the body Env's var list under the reserved
// marker "0#tp" (unlexable — a user identifier cannot begin with a digit, so no user binding collides;
// the same trick as bind_fnret's "0return") lets env_named_declared treat that name as ABSTRACT
// (fn-local, undeclared) even when a concrete global type of that name exists. So a tparam SHADOWS a
// same-named global type inside its own function body — the correct language scoping — and a user type
// named `T` no longer poisons the stdlib generic that happens to name its tparam `T`. The cell carries
// the tparam name as tnamed(...) so the membership test needs no per-query string allocation.
bind_tparams* = (a: MutPtr<Malloc>, vars: Ptr<VList>, tparams: [Param]) Ptr<VList> {
    e := vars
    tparams.loop((h, i, tp) {
        e = a.vcons("0#tp", tnamed(tp.name), e)
    })
    e
}
tparam_declared* = (v: Ptr<VList>, name: string_view) bool {
    v.match ({
        .VNil     => false,
        .VCons(c) => (c.name == "0#tp" && c.ty.ty_name() == name).match ({
            true  => true,
            false => c.tail.tparam_declared(name),
        }),
    })
}
// Infer global init types; bind the global name while doing so to avoid self-recursive lookup.
infer_global_init = (env: Env, name: string_view, init: Ptr<Expr>) Ty {
    env2 := Env(
        vars: env.a.vcons(name, tnamed(""), env.vars),
        decls: env.decls,
        didx: env.didx,
        exp: env.exp,
        a: env.a,
    )
    env2.infer_expr(init)
}
global_ty = (env: Env, name: string_view) Ty {
    i := env.didx.global_idx.get(name, 0 - 1)
    (i >= 0 && i < env.decls.len).match ({
        true  => env.decls[i].match ({
            .DGlobal(g) => env.infer_global_init(g.name, g.init),
            _           => tvoid(),
        }),
        false => tvoid(),
    })
}
// a bare reference to a top-level function NAME is a first-class function value: its type is the
// function's FnT signature (its params + ret). This lets `f := some_fn` bind `f` to a fn value and
// `f()` call through it (an indirect call). Falls back after locals + globals so a same-named local wins.
fn_value_ty = (env: Env, name: string_view) Ty {
    f := env.env_func(name)
    (f.name == name).then({ env.a.fnt_from_func_in(f) }, { tvoid() })
}
global_or_fn = (env: Env, name: string_view) Ty {
    g := env.global_ty(name)
    g.is_void_ty().then({ env.fn_value_ty(name) }, { g })
}
// Membership check, distinct from type lookup; void-typed locals still count as bound.
var_bound* = (v: Ptr<VList>, name: string_view) bool {
    v.match ({
        .VNil     => false,
        .VCons(c) => (c.name == name).then({ true }, { c.tail.var_bound(name) }),
    })
}
// LOCAL-scope membership ONLY (params + lets + arm/loop binds), excluding globals and top-level
// fns: the SHADOWING test. A fn's own params and locals shadow same-named top-level decls in its
// body (the emitted C scopes them that way), so call validation must consult this before any
// top-level name lookup.
ty_name = (t: Ty) string_view {
    t.match ({
        .Named(n) => n,
        _         => "",
    })
}
recv_name* = (t: Ty) string_view {
    t.match ({
        .I32           => "i32",
        .I64           => "i64",
        .U8            => "u8",
        .F64           => "f64",
        .Bool          => "bool",
        // String-family traits describe read-only behavior. All provenance variants dispatch
        // through the canonical view impl; the checker still keeps their value conversions distinct.
        .StringView    => "string_view",
        .StringCstr    => "string_view",
        .StringLiteral => "string_view",
        .Named(n)      => n,
        .Generic(g)    => g.mangled,
        .Ptr(pd)       => load(pd.pointee).recv_name(),
        _              => "",
    })
}
enum_name* = (t: Ty) string_view {
    t.match ({
        .Named(n)   => n,
        .Generic(g) => g.mangled,
        .Ptr(pd)    => load(pd.pointee).ty_name(),
        _           => "",
    })
}
ty_is_ptr* = (t: Ty) bool {
    t.match ({
        .Ptr(pd) => true,
        _        => false,
    })
}
// is this generic the std `Vec<T>`? The flattened name is import-style dependent: a destructured
// `{ Vec } = ...` yields bare "Vec", a namespace alias `vec = ...` yields "vec__Vec" (deeper paths
// add more "__" segments). Match the bare name or any "…__Vec" suffix so both forms resolve.
ty_is_vec = (g: GenericData) bool { g.name == "Vec" || g.name.ends_with("__Vec") }
// element type of an iterable receiver: a slice `[T]` yields T, and a `Vec<T>` (Generic over [T], a
// {ptr,len,cap} struct with an UNTYPED RawPtr buffer) yields its first type arg — so `.loop`/index
// over a Vec binds T from the receiver's generic param, not void.
elem_of* = (t: Ty) Ty {
    t.match ({
        .Slice(e)   => load(e),
        .Generic(g) => (g.ty_is_vec() && g.args.len > 0).then({ g.args[0] }, { tvoid() }),
        _           => tvoid(),
    })
}
enum_has = (ed: EnumDecl, vn: string_view) bool { ed.variants.slice_any((v) { v.name == vn }) }
pick_enum = (ed: EnumDecl, vn: string_view, found: string_view) string_view {
    ed.enum_has(vn).then({ ed.name }, { found })
}
gen_enum_has = (g: GenEnumDecl, vn: string_view) bool { g.variants.slice_any((v) { v.name == vn }) }
// Find the enum, concrete or generic, that declares variant `vn`.
enum_of_variant = (decls: [Decl], vn: string_view) string_view {
    found := ""
    decls.loop((h, i, d) {
        found = d.match ({
            .DEnum(ed)   => ed.pick_enum(vn, found),
            .DGenEnum(g) => g.gen_enum_has(vn).then({ g.name }, { found }),
            _            => found,
        })
    })
    found
}
named_has = (decls: [Decl], ename: string_view, vn: string_view) bool {
    found := false
    decls.loop((h, i, d) {
        found = d.match ({
            .DEnum(ed) => (ed.name == ename).then({ ed.enum_has(vn) }, { found }),
            _          => found,
        })
    })
    found
}
// The base enum name an expected/annotated type names: a generic instance (`Opt2<i32>`) wants its
// base `Opt2` (the GenEnumDecl key), not the mangled `Opt2_i32`; a plain enum its own name.
exp_enum_base = (t: Ty) string_view {
    t.match ({
        .Generic(g) => g.name,
        _           => t.enum_name(),
    })
}
// Constructor enum for a bare `.Foo` literal: the expected/annotated type WINS — try its concrete
// enum, then its generic enum (so an annotated `Opt2<i32>` disambiguates `.Some` from a stdlib `Opt`
// that shares the name) — only then fall back to scanning the ambient scope by variant name.
ctor_enum_plain = (env: Env, vn: string_view) string_view {
    base := env.exp.exp_enum_base()
    env.decls.named_has(base, vn).match ({
        true  => base,
        false => env.env_genenum(base).gen_enum_has(vn).match ({
            true  => base,
            false => env.decls.enum_of_variant(vn),
        }),
    })
}
field_ty = (sd: StructDecl, fname: string_view) Ty {
    found := tvoid()
    sd.fields.loop((h, i, f) {
        found = (f.name == fname).then({ f.ty }, { found })
    })
    found
}
// O(1) indexed struct-field lookup for the light/inline path.
is_cmp_op = (op: string_view) bool {
    // Bool-result ops; bitwise ops keep the lhs type.
    b := op.at(0)
    b1 := op.at(1)
    b == '=' || b == '!' || (b == '<' || b == '>') && b1 != b || (b == '&' || b == '|') && b1 == b
}
bin_ty* = (op: string_view, lt: Ty) Ty { op.is_cmp_op().then({ tbool() }, { lt }) }
// A numeric binop's result is the WIDER operand (max integer rank), so `i32 + i64`
// is i64 regardless of operand order — kills silent truncation + order-dependence.
// A numeric LITERAL operand ADAPTS to the other side (it never forces widening), so
// idiomatic `c + 1` (u8 + int-lit) stays u8 and `'0' + n` keeps the non-literal's width.
// When a non-literal side lacks a rank (narrow Named widths, non-numeric) we keep lhs.
num_wider = (lt: Ty, rt: Ty) Ty {
    (lt.ty_rank() >= 0 && rt.ty_rank() >= 0).match ({
        true  => (rt.ty_rank() > lt.ty_rank()).then({ rt }, { lt }),
        false => lt,
    })
}
num_result = (llit: bool, lt: Ty, rlit: bool, rt: Ty) Ty {
    llit.match ({
        true  => rlit.then({ lt }, { rt }),
        false => rlit.then({ lt }, { num_wider(lt, rt) }),
    })
}
bin_ty_e = (env: Env, b: BinData) Ty {
    b.op.is_cmp_op().match ({
        true  => tbool(),
        false => num_result(b.lhs.is_lit_numeric(), env.infer_expr(b.lhs), b.rhs.is_lit_numeric(), env.infer_expr(b.rhs)),
    })
}
// Numeric literals are polymorphic until a context fixes their size.
is_lit_numeric* = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Int(n)  => true,
        .Byte(n) => true,
        .Bin(b)  => b.op.is_cmp_op().match ({
            true  => false,
            false => b.lhs.is_lit_numeric() && b.rhs.is_lit_numeric(),
        }),
        .Cond(c) => c.t.is_lit_numeric() && c.e.is_lit_numeric(),
        _        => false,
    })
}
// Numeric literals adapt to the other branch. All other branches use the same least-upper-bound
// calculation as enum matches, so result typing never depends on arm order.
cond_ty = (env: Env, d: CondData) Ty {
    d.t.is_lit_numeric().match ({
        true  => env.infer_expr(d.e),
        false => d.e.is_lit_numeric().match ({
            true  => env.infer_expr(d.t),
            false => env.infer_expr(d.t).common_ty(env.infer_expr(d.e)),
        }),
    })
}
// Generic enum constructors: compute base enum, type args, and mangled concrete name.
EnumInst*: {
    base: string_view,
    mty: string_view,
    targs: [Ty],
}
gen_variant_payload* = (g: GenEnumDecl, vname: string_view) Ty {
    found := tvoid()
    g.variants.loop((h, i, v) {
        found = (v.name == vname).then({ v.payload }, { found })
    })
    found
}
infer_enum_targs = (env: Env, g: GenEnumDecl, variant: string_view, pty: Ty) [Ty] {
    vpt := g.gen_variant_payload(variant)
    map_slice(env.a, g.tparams, (tp) { vpt.unify_ty(pty, tp.name) })
}
enum_inst_payload = (
    env: Env,
    g: GenEnumDecl,
    base: string_view,
    variant: string_view,
    pty: Ty,
) EnumInst {
    ta := env.infer_enum_targs(g, variant, pty)
    EnumInst(
        base: base,
        mty: env.a.mangle_str_in(base, ta),
        targs: ta,
    )
}
enum_inst_gen = (
    env: Env,
    g: GenEnumDecl,
    base: string_view,
    variant: string_view,
    pty: Ty,
) EnumInst {
    env.exp.match ({
        .Generic(ge) => (ge.name == base).match ({
            true  => EnumInst(
                base: base,
                mty: ge.mangled,
                targs: ge.args,
            ),
            false => env.enum_inst_payload(g, base, variant, pty),
        }),
        _            => env.enum_inst_payload(g, base, variant, pty),
    })
}
enum_inst_of = (env: Env, base: string_view, variant: string_view, pty: Ty) EnumInst {
    g := env.env_genenum(base)
    (g.name == "").match ({
        true  => EnumInst(
            base: base,
            mty: base,
            targs: no_tys(),
        ),
        false => env.enum_inst_gen(g, base, variant, pty),
    })
}    // a non-generic enum
enum_inst_mk* = (env: Env, variant: string_view, payload: Ptr<Expr>) EnumInst {
    env.enum_inst_of(env.ctor_enum_plain(variant), variant, env.infer_expr(payload))
}
enum_inst_tag* = (env: Env, variant: string_view) EnumInst {
    env.enum_inst_of(env.ctor_enum_plain(variant), variant, tvoid())
}
// Block expressions take their trailing expression/return type.
last_stmt_ty = (env: Env, stmts: [Stmt]) Ty {
    stmts[stmts.len - 1].match ({
        .ExprStmt(e) => env.infer_expr(e),
        .Return(r)   => env.infer_expr(r),
        _            => tvoid(),
    })
}
// A value-position Block whose LAST statement is an explicit `return` DIVERGES — it yields no value
// (control leaves the fn), so it contributes NO type constraint: a match/cond with such an arm takes
// its type from the OTHER arms. Only arm/loop blocks can look like this; fn/lambda BODIES (where the
// parser's implicit trailing return IS the value) are typed as [Stmt] via block_ty_from directly and
// keep last_stmt_ty's Return-as-value rule. See genc.blk_diverges.
block_ty_from = (env: Env, stmts: [Stmt], i: i32) Ty {
    (i >= stmts.len).match ({
        true  => tvoid(),
        false => (i == stmts.len - 1).match ({
            true  => env.last_stmt_ty(stmts),
            false => env.a.extend_env(env, stmts[i]).block_ty_from(stmts, i + 1),
        }),
    })
}
// Prefer a concrete stored index element type; generic inlining may make re-inference lose it.
index_elem = (env: Env, ix: IndexData) Ty {
    ix.elem.is_void_ty().then({ env.infer_expr(ix.seq).elem_of() }, { ix.elem })
}
pointee_of* = (t: Ty) Ty {
    t.match ({
        .Ptr(pd) => load(pd.pointee),
        _        => tvoid(),
    })
}
// Generic calls infer type args from arguments, then use the expected return type
// for params that only appear in the result.
// Binding strength: an untyped numeric or string LITERAL is the WEAKEST source — a typed arg
// (receiver, annotated local) or the expected return type must not be overridden by a literal's
// default width/provenance. `lits` selects which pass this scan is: false = typed args only,
// true = literals only (the last resort).
is_weak_targ_arg* = (e: Ptr<Expr>) bool {
    e.is_lit_numeric()
        || load(e).match ({
            .StrLit(s) => true,
            _          => false,
        })
}
is_direct_tparam* = (t: Ty, tp: string_view) bool {
    t.match ({
        .Named(n) => n == tp,
        _         => false,
    })
}
weak_targ_env = (
    env: Env,
    pty: Ty,
    args: [Expr],
    atys: [Ty],
    done: [u8],
    i: i64,
    tp: string_view,
) bool {
    args[i].addr().is_weak_targ_arg()
        || pty.is_direct_tparam(tp) && env.arg_ty_memo(args, atys, done, i).is_str_t()
}
// A lambda arg has no inferrable value type (infer_expr -> void — what the memo holds for one).
// When a tparam sits in the closure's RETURN position `(T) U`, bind it from the lambda's DECLARED
// return type so it never defaults to void.
unify_arg = (env: Env, pty: Ty, args: [Expr], atys: [Ty], done: [u8], i: i64, tp: string_view) Ty {
    load(args[i].addr()).match ({
        .Lambda(lm) => pty.lam_ret_unify(lm, tp),
        _           => pty.unify_ty(env.arg_ty_memo(args, atys, done, i), tp),
    })
}
lam_ret_unify = (pty: Ty, lm: LambdaData, tp: string_view) Ty {
    pty.match ({
        .FnT(ft) => lm.ret.is_void_ty().then({ tvoid() }, { load(ft.ret).unify_ty(lm.ret, tp) }),
        _        => tvoid(),
    })
}
ret_targ_of = (env: Env, ret: Ty, tp: string_view) Ty {
    env.exp.is_void_ty().then({ tvoid() }, { ret.unify_ty(env.exp, tp) })
}
// etargs = explicit turbofish type args (empty when none): a present one PINS the i-th tparam,
// overriding inference; an absent one (i past etargs) falls back to inferring from the value args.
// After the per-tparam pass, still-void targs get the two deep fallbacks (see deep_targs): a lambda
// arg's BODY type for a closure-return tparam, and a co-targ's generic-trait impl — the env-typed
// mirror of the inliner's post-pass, so resolve (let typing, mono_rec instances) agrees with it.
// env-typed twin of deep_targs (the resolver types lambda bodies with the full Env, not light types).
deep_targs_env = (env: Env, tparams: [Param], buf: [Ty], params: [Param], args: [Expr]) [Ty] {
    tparams.loop((h, i, tp) {
        buf[i] = buf[i].is_void_ty().match ({
            true  => env.lam_body_targ_env(tparams, buf, params, args, tp.name),
            false => buf[i],
        })
    })
    tparams.loop((h, i, tp) {
        buf[i] = buf[i].is_void_ty().match ({
            true  => env.a.impl_trait_targ(env.decls, env.didx, tparams, buf, tp.name),
            false => buf[i],
        })
    })
    buf
}
lam_body_targ_env = (
    env: Env,
    tparams: [Param],
    targs: [Ty],
    params: [Param],
    args: [Expr],
    tp: string_view,
) Ty {
    found := tvoid()
    params.loop((h, i, p) {
        found = found.is_void_ty().match ({
            true  => (i < args.len).match ({
                true  => env.lam_body_one_env(tparams, targs, p.ty, args[i].addr(), tp),
                false => found,
            }),
            false => found,
        })
    })
    found
}
lam_body_one_env = (
    env: Env,
    tparams: [Param],
    targs: [Ty],
    pty: Ty,
    arg: Ptr<Expr>,
    tp: string_view,
) Ty {
    pty.match ({
        .FnT(ft) => load(arg).match ({
            .Lambda(lm) => (lm.ret.is_void_ty() && load(ft.ret).ty_mentions(tp)).match ({
                true  => {
                    vars := env.vars
                    lm.params.loop((h, k, lp) {
                        vars = env.a.vcons(lp.name, (k < ft.params.len).match ({
                            true  => env.a.subst_ty_in(tparams, targs, ft.params[k]),
                            false => tvoid(),
                        }), vars)
                    })
                    env2 := Env(
                        vars: vars,
                        decls: env.decls,
                        didx: env.didx,
                        exp: tvoid(),
                        a: env.a,
                    )
                    bty := env2.block_ty_from(lm.body, 0)
                    (bty.is_void_ty() || bty.ty_mentions_any(tparams)).match ({
                        true  => tvoid(),
                        false => load(ft.ret).unify_ty(bty, tp),
                    })
                },
                false => tvoid(),
            }),
            _           => tvoid(),
        }),
        _        => tvoid(),
    })
}
dispatch_recv* = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    didx: DeclIndex,
    fn: string_view,
    tyname: string_view,
) string_view {
    // O(1): dispatch_idx holds the LAST impl of `tyname` providing `fn` (directly or via a trait
    // default) — the same verdict the old whole-decls scan accumulated.
    i := didx.dispatch_idx.get(a.tdkey(tyname, fn), 0 - 1)
    (i >= 0 && i < decls.len).match ({
        true  => decls[i].match ({
            .DImpl(im) => a.impl_cname_in(im.trname, im.ty, fn),
            _          => fn,
        }),
        false => fn,
    })
}
dispatch_recv_name* = (t: Ty) string_view {
    t.match ({
        .Generic(g) => g.name,
        .Ptr(pd)    => load(pd.pointee).dispatch_recv_name(),
        _           => t.recv_name(),
    })
}
// A slice receiver (`[u8]`, possibly behind a pointer) has no head name but IS dispatchable — the
// `fits`-based candidate scan keys on the element type instead.
is_slice_recv = (t: Ty) bool {
    t.match ({
        .Slice(e) => true,
        .Ptr(pd)  => load(pd.pointee).is_slice_recv(),
        _         => false,
    })
}
// Can this receiver drive UFCS-alias dispatch? Anything with a concrete head, plus slices (whose head
// is empty). Bails on void/unknown/pre-inline-tparam receivers, exactly as before for non-slices.
alias_recv_dispatchable = (t: Ty) bool {
    is_empty(t.dispatch_recv_name()).then({ t.is_slice_recv() }, { true })
}
// Compiler-level call intrinsics (typed in infer_call / lowered by genc). Lives here — not in
// check_validate, which now imports it — so the alias-UFCS fallback below can refuse to shadow them.
is_intrinsic* = (fn: string_view) bool {
    // grouped under a first-byte guard: this runs for every call site (dispatch + the alias-UFCS
    // fallback), and the 26-strcmp flat chain was a visible profile line. One byte load rejects
    // every non-intrinsic name whose first letter matches no intrinsic; same answers.
    b := load(offset(fn, 0))
    b == 'l' && (fn == "load" || fn == "load_i64")
        || b == 's' && (fn == "store" || fn == "slice" || fn == "sizeof" || fn == "store_i64")
        || b == 'a'
            && (fn == "addr"
                || fn == "assert_nonnull"
                || fn == "atomic_add_i64"
                || fn == "atomic_load_i64"
                || fn == "atomic_store_i64"
                || fn == "atomic_cas_i64"
                || fn == "atomic_fence")
        || b == 'o' && fn == "offset"
        || b == 'c' && fn == "cstr"
        || b == 'm' && fn == "malloc"
        || b == 'n' && fn == "null_ptr"
        || b == '_' && (fn == "__str_eq" || fn == "__str_ne")
        || b == 't' && (fn == "to_i32" || fn == "to_i64" || fn == "to_u8" || fn == "to_f64")
        || b == 'f' && fn == "field_eq"
        || b == 'e' && fn == "each_field"
        || b == 'z' && fn == "zip_fields"
        || b == 'v' && fn == "variant_name"
}
// ── UFCS THROUGH MODULE ALIASES ──────────────────────────────────────────────────────────────────
// `m = std.collections.hmap` binds hmap's top-level fns as `m__put`/`m__get`/… in the flat program,
// so `x.put(k, v)` (desugared to `put(x, k, v)`) used to resolve ONLY when `put` was flat-imported —
// forcing flat imports and their name-collision trap. When a called name is otherwise UNDEFINED,
// search the alias-prefixed decls whose tail is the method name and whose FIRST parameter's head
// type matches the receiver's inferred head type (deterministic: decl order):
//   exactly one → dispatch_name routes the call to it (resolve_call then rewrites, as for traits);
//   two or more → the call stays unresolved; the validator reports the positioned undefined-name
//   error and denrich_ambiguous_msg (check_validate) names the candidates.
// Guards keep this a pure FALLBACK — it never fires for intrinsics, known top-level fns, locally
// bound names (locals shadow, #370), value globals, receivers without a concrete head type
// (pre-inline tparam receivers), or candidates whose first-param head is their OWN tparam — so no
// program that resolves today changes meaning, and rejected programs can only gain a resolution.
AliasCands: {
    count: i32,
    first: string_view,
    second: string_view,
}
alias_cands_none = () AliasCands {
    AliasCands(
        count: 0,
        first: "",
        second: "",
    )
}
tparam_names_have = (tps: [Param], name: string_view) bool {
    tps.slice_any((tp) { tp.name == name })
}
// VISIBILITY: only `*`-exported names are UFCS-reachable through an alias. Alias-prefixed publics
// keep their star in the FLAT source (`g__scale* = …`), and parse_module records every starred
// top-level name (compiler.parse exports_get) — membership there means the aliased module exported
// it. Private alias decls (`g__hidden = …`) exist for the module's own internals but never match.
alias_name_is_pub = (name: string_view) bool { exports_get().slice_any((p) { p.name == name }) }
// is `f` an alias-prefixed candidate for method `fn` on receiver `rty`? Common gates: real alias
// prefix (never a phantom `foo__grow`), tail == the method, `*`-exported, and first-param head is not
// the fn's OWN tparam. `exact` selects param0-compat: exact head-string equality (pass 1) vs the same
// receiver→param0 coercion the normal call path uses (`fits` — i32→i64, slice→slice, …) in pass 2.
alias_cand_matches = (f: Func, fn: string_view, rty: Ty, exact: bool) bool {
    sep := f.name.alias_sep()
    (sep > 0
        && f.params.len > 0
        && f.name.alias_is_real_prefix()
        && f.name.alias_tail(sep) == fn
        && f.name.alias_name_is_pub()).match ({
        true  => {
            p0 := f.params[0].ty
            head := p0.dispatch_recv_name()
            (f.tparams.tparam_names_have(head) == false).match ({
                true  => exact.match ({
                    true  => is_empty(head).then({ false }, { head == rty.dispatch_recv_name() }),
                    false => rty.fits(p0),
                }),
                false => false,
            })
        },
        false => false,
    })
}
// Sig-driven enumeration (B4/R3): candidates come from the per-alias export sigs the resolver
// stamped into the compiler.parse registry, not from shape-scanning every flat decl. Only entries
// mirroring the names the resolver actually PREFIXED can produce a candidate — value decls of the
// aliased module (not imported pass-throughs, not foreign, not types: exactly the
// value_decl_names_in filter), reconstructed as `alias__name` and resolved to the real decl through
// func_idx (DFunc and DForeign alike). Every semantic gate (real-prefix, tail, `*`-export via the
// flat's star markers, param0 head/tparam/fits) stays in alias_cand_matches, applied to the SAME
// Func the old scan matched, so a candidate's verdict is unchanged — only the enumeration is new.
// Registry order is flat append order and a module's symbols are in decl order, so the deterministic
// decl-order tie-break (first/second in the ambiguity message) is preserved. The cheap prefilter is
// safe: the dispatcher's tail (after the LAST `__` of `alias__name`) is always a suffix of the
// module-side name, so a non-suffix entry can never match and is skipped without allocating.
// Intentional divergence from the shape scan: a USER-written `alias__method` decl that the aliased
// module does not export (main-body or brace-imported, merely SHAPED like an alias decl) is no
// longer a candidate — the alias's method namespace is closed to the module's real exports.
// all NON-receiver args fit the candidate's params (arity-exact; param0 is the already-matched
// receiver). The receiver+arg-typed tiebreak: among candidates sharing the receiver head, the one
// whose whole parameter row fits the actual arguments is the intended overload (i64-index str.at vs
// i32-index ascii.at). A candidate that fails arg-fit stays a receiver-match only — so a lone
// receiver-match still resolves (its arg-type error is then reported the normal way), but two
// receiver-matches disambiguate by args before falling back to the positioned ambiguity error.
alias_args_fit = (f: Func, atys: [Ty]) bool {
    (f.params.len == atys.len).match ({
        true  => {
            ok := true
            atys.loop((h, i, at) {
                (i > 0).then({
                    ok = ok && at.fits(f.params[i].ty)
                })
            })
            ok
        },
        false => false,
    })
}
alias_cands_scan = (env: Env, fn: string_view, rty: Ty, exact: bool, atys: [Ty]) AliasCands {
    rcnt := 0
    rfirst := ""
    rsecond := ""
    acnt := 0
    afirst := ""
    module_sigs_get().loop((h, i, e) {
        (e.sig_imported() == false
            && e.sig_foreign() == false
            && e.sig_type() == false
            && e.name.ends_with(fn)).then({
            fname := env.a
                .gstr_string(32)
                .gstr_append(env.a, e.alias)
                .gstr_append(env.a, "__")
                .gstr_append(env.a, e.name)
                .gstr_finish(env.a)
            f := env.env_func(fname)
            (is_empty(f.name) == false && f.alias_cand_matches(fn, rty, exact)).then({
                rsecond = (rcnt == 1).then({ f.name }, { rsecond })
                rfirst = (rcnt == 0).then({ f.name }, { rfirst })
                rcnt = rcnt + 1
                f.alias_args_fit(atys).then({
                    afirst = (acnt == 0).then({ f.name }, { afirst })
                    acnt = acnt + 1
                })
            })
        })
    })
    // exactly one candidate fits the arguments → that is the overload; otherwise keep the
    // receiver-only verdict (unique → resolves; 2+ → positioned ambiguity; 0 → undefined).
    (acnt == 1).match ({
        true  => AliasCands(
            count: 1,
            first: afirst,
            second: "",
        ),
        false => AliasCands(
            count: rcnt,
            first: rfirst,
            second: rsecond,
        ),
    })
}
// Two-pass for determinism: exact head-type matches first; only when ZERO exact matches exist do we
// fall back to coercible receivers (i32→i64, slice receivers). The count==1-else-ambiguity rule holds
// per pass, so an exact unique winner is never masked by a coercible one.
fnt_ret = (t: Ty) Ty {
    t.match ({
        .FnT(ft) => load(ft.ret),
        _        => tvoid(),
    })
}
gen_call_ret = (env: Env, c: CallData) Ty {
    // Infer the receiver ONCE, shared by dispatch and the targ scans (see arg_ty_memo): the two
    // separate arg0 inferences compounded per nesting level on UFCS chains.
    rty0 := (c.args.len > 0).then({ env.infer_expr(c.args[0].addr()) }, { tvoid() })
    dn := env.dispatch_name_r(c, rty0)
    f := env.env_func(dn)
    (f.name == "").match ({
        true  => env.var_or_global(c.fn).fnt_ret(),
        false => (f.tparams.len > 0).match ({
            true  => env.a.subst_ty_in(f.tparams, env.call_targs_r(f, c.args, c.targs, rty0, c.args.len > 0), f.ret),
            false => f.ret,
        }),
    })
}
// not a known function: an INDIRECT call through a function-VALUE (a fn-valued local or field
// bound to a local) — its result type is the value's FnT return type.
// Bounds-safe operand inference for 1-arg intrinsics.
arg0_ty = (env: Env, c: CallData) Ty {
    (c.args.len > 0).then({ env.infer_expr(c.args[0].addr()) }, { tvoid() })
}
addr_ty = (env: Env, c: CallData) Ty {
    base := env.arg0_ty(c)
    readonly := (c.args.len > 0).then({ env.lvalue_writes_readonly(c.args[0].addr()) }, { false })
    tptr_k(env.a.tnode(base), readonly.then({ k_ptr() }, { k_mut_ptr() }))
}
// `assert_nonnull` proves nullability, not writability: RawPtr<T> narrows to MutPtr<T>, while an
// already-non-null Ptr<T>/MutPtr<T> keeps its direction capability unchanged.
nonnull_ty = (t: Ty) Ty {
    t.match ({
        .Ptr(pd) => (pd.kind == k_raw_ptr()).then({ tptr_k(pd.pointee, k_mut_ptr()) }, { t }),
        _        => tvoid(),
    })
}
// Constructor types keep generic args so later match-arm binds recover concrete payload types.
einst_ty = (ei: EnumInst) Ty {
    (ei.targs.len > 0).then({ tgeneric(ei.base, ei.targs, ei.mty) }, { tnamed(ei.mty) })
}
mkenum_ty = (env: Env, mk: MakeEnumData) Ty {
    (mk.mty == "").match ({
        true  => env.enum_inst_mk(mk.variant, mk.payload).einst_ty(),
        false => (mk.targs.len > 0).then({ tgeneric(mk.ty, mk.targs, mk.mty) }, { tnamed(mk.mty) }),
    })
}
tag_ty = (env: Env, t: TagData) Ty {
    (t.mty == "").match ({
        true  => env.enum_inst_tag(t.variant).einst_ty(),
        false => (t.targs.len > 0).then({ tgeneric(t.ty, t.targs, t.mty) }, { tnamed(t.mty) }),
    })
}
// Generic struct field reads substitute the receiver's concrete type args.
gen_field_at = (fields: [Field], fname: string_view) Ty {
    found := tvoid()
    fields.loop((h, i, f) {
        found = (f.name == fname).then({ f.ty }, { found })
    })
    found
}
ty_under_ptr* = (t: Ty) Ty {
    t.match ({
        .Ptr(pd) => load(pd.pointee),
        _        => t,
    })
}
slice_member* = (a: MutPtr<Malloc>, field: string_view) Ty {
    (field == "len").match ({
        true  => ti64(),
        false => (field == "ptr").then({ tptr(a.tnode(tu8())) }, { tvoid() }),
    })
}
// Field-type inference, auto-deref'd. Shared by `obj.field` (Member) and `obj->field` (Arrow); the
// latter exists because resolve_member rewrites a pointer receiver to Arrow, and a later re-resolve
// (e.g. dispatch on a generic-struct field receiver in an inlined template body) must re-infer it.
infer_field = (env: Env, oty: Ty, field: string_view) Ty {
    oty.ty_under_ptr().match ({
        .Generic(g) => env.didx.idx_genstruct_field(env.a, env.decls, g.name, field, g.args),
        .Slice(e)   => env.a.slice_member(field),
        _           => env.didx.idx_struct_field(env.decls, oty.enum_name(), field),
    })
}
infer_member = (env: Env, m: MemberData) Ty { env.infer_field(env.infer_expr(m.obj), m.field) }
infer_arrow = (env: Env, ar: ArrowData) Ty { env.infer_field(env.infer_expr(ar.obj), ar.field) }
infer_arm_ty = (env: Env, subjty: Ty, ar: ArmData) Ty {
    env.a.arm_env(env, subjty, ar).infer_expr(ar.body)
}
// Least common result type. `ty_eq(got, want)` is directional: literal fits cstr/view and cstr fits
// view, never the reverse. Therefore when `a` fits `b`, the safe join is the broader `b`; choosing
// `a` would launder a borrowed arm into immortal `string_literal` provenance.
common_ty* = (a: Ty, b: Ty) Ty {
    a.is_void_ty().match ({
        true  => b,
        false => b.is_void_ty().match ({
            true  => a,
            false => (a.ty_rank() >= 0 && b.ty_rank() >= 0).match ({
                true  => (a.ty_rank() == 0).match ({
                    true  => b,
                    false => (a.ty_rank() == 1).match ({
                        true  => (b.ty_rank() > 1).then({ b }, { a }),
                        false => a,
                    }),
                }),
                false => a.ty_eq(b).match ({
                    true  => b,
                    false => b.ty_eq(a).then({ a }, { tvoid() }),
                }),
            }),
        }),
    })
}
infer_match_common_ty = (env: Env, subjty: Ty, arms: [ArmData]) Ty {
    out := tvoid()
    arms.loop((h, i, ar) {
        out = out.common_ty(env.infer_arm_ty(subjty, ar))
    })
    out
}
infer_match_ty = (env: Env, m: MatchData) Ty {
    subjty := env.infer_expr(m.subj)
    env.infer_match_common_ty(subjty, m.arms)
}
has_tparam* = (tparams: [Param], n: string_view) bool { tparams.slice_any((tp) { tp.name == n }) }
// Slice literal element type: an expected `[T]` (declared/annotated) WINS, so a bare-int literal
// `[1,2,3]` adopts the declared element width (`i64`/`u8`) instead of defaulting to i32 — the same
// expected-type propagation a scalar int slot already gets. Falls back to the first item's type.
sl_elem = (env: Env, items: [Expr]) Ty {
    (items.len == 0).then({ tvoid() }, { env.infer_expr(items[0].addr()) })
}
vdef_payload = (vs: [VariantDef], vn: string_view) Ty {
    found := tvoid()
    vs.loop((h, i, v) {
        found = (v.name == vn).then({ v.payload }, { found })
    })
    found
}
// O(1) indexed variant-payload lookup for an enum named `ename`.
// The default constant expr for a `Name = expr` variant, or a null Ptr<Expr> when the variant has none.
vdef_default_of = (vs: [VariantDef], vn: string_view) Ptr<Expr> {
    found := expr_null()
    vs.loop((h, i, v) {
        found = (v.name == vn).then({ v.dflt }, { found })
    })
    found
}
// Concrete payload type for a match arm bind, including generic enum substitution.
gsubst* = (pty: Ty, env: Env, g: GenericData) Ty {
    ged := env.env_genenum(g.name)
    sub := env.a.subst_ty_in(ged.tparams, g.args, pty)
    sub.match ({
        .Named(n) => {
            gsd := env.env_gstruct(n)
            is_empty(gsd.name).match ({
                true  => sub,
                false => {
                    tys := map_slice(env.a, gsd.tparams, (tp) {
                        env.a.subst_ty_in(ged.tparams, g.args, tnamed(tp.name))
                    })
                    tgeneric(n, tys, env.a.mangle_str_in(n, tys))
                },
            })
        },
        _         => sub,
    })
}
// String equality lowers to backend-specific content comparison intrinsics.
is_str_t* = (t: Ty) bool {
    t.match ({
        .StringView    => true,
        .StringCstr    => true,
        .StringLiteral => true,
        _              => false,
    })
}
// Arm payload binds get their concrete payload type.
arm_env* = (a: MutPtr<Malloc>, env: Env, t: Ty, ar: ArmData) Env {
    (ar.bind == "").match ({
        true  => env,
        false => Env(
            vars: a.vcons(ar.bind, env.subj_variant_payload(t, ar.variant), env.vars),
            decls: env.decls,
            didx: env.didx,
            exp: env.exp,
            a: env.a,
        ),
    })
}
// A DISCARDED (statement-position) match/cond keeps the enclosing function's expected (return) type, so
// an early `return .Err(x)` / `return .Ok(v)` inside a branch infers its enum from the DECLARED return
// type rather than from void context (which otherwise mis-mangled `.Err("x")` to `Result_void_text`).
// `(c).match({true=>…,false=>…})` parses to a Cond, so both Cond and Match must carry the expectation.
// Any OTHER discarded expression clears exp — a stray exp would mis-unify a generic call's bare tparam.
carries_return_e = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Cond(c)  => true,
        .Match(m) => true,
        _         => false,
    })
}
extend_env* = (a: MutPtr<Malloc>, env: Env, st: Stmt) Env {
    st.match ({
        .Let(l) => Env(
            vars: a.vcons(l.name, l.ty.is_void_ty().then({ env.infer_expr(l.value) }, { l.ty }), env.vars),
            decls: env.decls,
            didx: env.didx,
            exp: env.exp,
            a: env.a,
        ),
        _       => env,
    })
}
// The env a foreach/loop BODY is checked in: the element (`v`) and index (`i`) bindings the lowering
// introduces, plus the handler (`h`) whose `h.break`/`h.continue` controls the loop. `h` is bound to an
// unknown type so `h.break_zk` stays lenient (member_err defers on unknown receivers) — it exists only so
// the handler name resolves and the validator can walk INTO the body to catch undefined names / type errs.
loop_env* = (a: MutPtr<Malloc>, env: Env, l: LoopData) Env {
    Env(
        vars: a.vcons(l.h, tnamed(""), a.vcons(l.elem, l.elemTy, a.vcons(l.idx, ti32(), env.vars))),
        decls: env.decls,
        didx: env.didx,
        exp: env.exp,
        a: env.a,
    )
}
// Template/lambda inlining pass.
no_stmts* = () [Stmt] { slice(null_ptr(), 0) }
empty_args* = () [Expr] { slice(null_ptr(), 0) }
pidx = (params: [Param], name: string_view, found: i32, i: i32) i32 {
    (i == params.len).match ({
        true  => found,
        false => (params[i].name == name).then({ i }, { params.pidx(name, found, i + 1) }),
    })
}
param_index* = (params: [Param], name: string_view) i32 { params.pidx(name, 0 - 1, 0) }
hide_param = (a: MutPtr<Malloc>, params: [Param], name: string_view) [Param] {
    idx := params.param_index(name)
    (idx < 0).match ({
        true  => params,
        false => {
            buf := a.pbuf(params.len)
            params.loop((h, i, p) {
                buf[i] = (p.name == name).match ({
                    true  => Param(
                        name: "",
                        ty: p.ty,
                        variadic: p.variadic,
                    ),
                    false => p,
                })
            })
            buf
        },
    })
}
// inline-expansion scope marks: the chain of functions currently being inlined (env's empty-named
// markers, pushed by inline_template). Distinguishes locals from DIFFERENT inlined functions that
// share a param-count depth — e.g. cenode and cebuf both at depth 2 would otherwise rename their
// `buf` to the same C local and alias into a self-referential node. Same-function re-inlines stay
// distinct via C block scoping. This is what lets the compiler internals be generic (inlined) safely.
inline_marks = (a: MutPtr<Malloc>, s: String, env: Ptr<VList>) String {
    env.match ({
        .VNil     => s,
        .VCons(c) => c.ty.is_empty_named().match ({
            true  => a.inline_marks(s.gstr_append(a, "_").gstr_append(a, c.name), c.tail),
            false => a.inline_marks(s, c.tail),
        }),
    })
}
// COMPACT rename encoding: `_z<depth><markers>_<name>` (arg binds `_za<idx><markers>_<name>`).
// Exactly the same uniqueness inputs as the old `__zen_local…` accumulation — the inline-marker
// chain, a per-rename depth/index, and the original name — but ~5 bytes per rename level instead
// of 12+depth: the magic prefix is 2 bytes ("__zen_local" was 11), and the depth renders as
// decimal digits (omitted when 0; the old scheme spent one `_` per depth level). Re-renaming an
// already-compact name at the next inline level wraps it (`x` → `_z_x` → `_z__z_x`), exactly as
// the old scheme wrapped, so capture-avoidance across levels is unchanged. Accumulated renamed
// identifiers were 38% of the emitted seed's bytes (avg 31 chars, worst 83) before this encoding.
name_marks = (
    a: MutPtr<Malloc>,
    s: String,
    name: string_view,
    env: Ptr<VList>,
    depth: i64,
) string_view {
    out := (depth > 0).then({ s.gstr_int(a, depth) }, { s })
    out = a.inline_marks(out, env)
    out = out.gstr_append(a, "_")
    out = out.gstr_append(a, name)
    out.gstr_finish(a)
}
local_name_at* = (a: MutPtr<Malloc>, name: string_view, env: Ptr<VList>, depth: i64) string_view {
    a.name_marks(a.gstr_string(32).gstr_append(a, "_z"), name, env, depth)
}
add_subst_param* = (a: MutPtr<Malloc>, params: [Param], name: string_view) [Param] {
    base := a.hide_param(params, name)
    buf := a.pbuf(base.len + 1)
    base.loop((h, i, p) {
        buf[i] = p
    })
    buf[base.len] = Param(
        name: name,
        ty: tvoid(),
        variadic: false,
    )
    buf
}
add_subst_arg* = (a: MutPtr<Malloc>, args: [Expr], name: string_view) [Expr] {
    buf := a.cebuf(args.len + 1)
    args.loop((h, i, e) {
        buf[i] = e
    })
    buf[args.len] = vref(name)
    buf
}
// A lambda bound to a local (`g := (n){…}`) has no C closure value. Instead the inliner treats the
// local as a COMPILE-TIME ALIAS: shadow the name as an FnT "param" whose substituted "arg" is the
// (already-xformed) lambda, so every later use — a direct call `g(x)` or a HOF arg `apply(g,…)` —
// splices the lambda exactly like a directly-passed one. The `g := …` statement itself is dropped.
add_fnt_param* = (a: MutPtr<Malloc>, params: [Param], name: string_view) [Param] {
    base := a.hide_param(params, name)
    buf := a.pbuf(base.len + 1)
    base.loop((h, i, p) {
        buf[i] = p
    })
    buf[base.len] = Param(
        name: name,
        ty: fntype(no_tys(), a.tnode(tvoid())),
    )
    buf
}
add_lambda_arg* = (a: MutPtr<Malloc>, args: [Expr], lamx: Ptr<Expr>) [Expr] {
    buf := a.cebuf(args.len + 1)
    args.loop((h, i, e) {
        buf[i] = e
    })
    buf[args.len] = load(lamx)
    buf
}
// is this Let's value a lambda literal? (drives the alias lowering above)
let_value_lambda* = (st: Stmt) bool {
    st.match ({
        .Let(l) => load(l.value).match ({
            .Lambda(lm) => true,
            _           => false,
        }),
        _       => false,
    })
}
the_func* = (decls: [Decl], name: string_view) Func {
    found := Func(
        name: "",
        params: empty_params(),
        ret: tvoid(),
        tparams: empty_params(),
        body: no_stmts(),
    )
    decls.loop((h, i, d) {
        found = d.match ({
            .DFunc(f)    => (f.name == name).then({ f }, { found }),
            .DForeign(f) => (f.name == name).then({ f }, { found }),
            _            => found,
        })
    })
    found
}
// O(1) indexed Func lookup for the inline/template path (mirrors env_func; same last-match result).
ref_pos* = (e: Ptr<Expr>) i32 {
    load(e).match ({
        .Var(v) => v.pos,
        _       => 0,
    })
}
// THE keystone: `subst_var` splices the SAME arg AST node into every param use, so a param used N
// times re-evaluates the arg N times (double-effect / double-alloc / UAF) and a param used 0 times
// DROPS the arg entirely (a generic-instance literal then never monomorphizes). The fix binds each
// non-trivial arg to ONE generated local BEFORE splicing the body, then substitutes that local's Var
// for every param use — so the arg evaluates exactly once and always survives as a real statement.
// Pure leaves (Var/Int/literal) are left alone: a Var receiver MUST stay concrete for UFCS/trait
// dispatch (binding it erased the receiver type — a prior attempt regressed 37 cases), and leaves
// have no effect to duplicate. We bind effectful/instance-bearing args: calls and struct/enum makes,
// AND — the root of #69/#480 — the compound results of an ALREADY-INLINED nested call. A chained
// method (`m.put(k,v).put(k2,v2)`) reaches the outer inline with its receiver arg already expanded
// into a Block (multi-statement body), a Cond (`?:`, from an early-return/or_return lift in the
// inlined body), or a Match. Those carry the inner op's non-idempotent side effects; if the outer
// param uses them N>1 times they re-run N times (~3^depth over a chain → hang / slice-OOB / wrong
// result). Binding them to ONE temp collapses each to a single evaluation.
ArgBind*: {
    fargs: [Expr],
    binds: [Stmt],
    env: Ptr<VList>,
}
arg_needs_bind = (e: Expr) bool {
    e.match ({
        .Call(c)        => true,
        .MakeStruct(sd) => true,
        .MakeEnum(mk)   => true,
        .Block(b)       => true,
        .Cond(d)        => true,
        .Match(m)       => true,
        _               => false,
    })
}
// must param i be COPY-bound because the template body writes it? (value semantics for inlined
// params, #585). FnT params never bind — their lambda arg must splice literally.
wr_param_bind = (params: [Param], wbody: [Stmt], i: i64) bool {
    params[i].ty.is_fnt() == false && wbody.wr_writes_name(params[i].name)
}
// Fresh C name for an arg-binding local: distinct "_za" prefix (never a valid "_z<digits>_…" body
// local, since 'a' is neither a digit nor the marker separator), inline_marks keep it distinct
// across nested inline depths, the index keeps each arg distinct within one inline.
arg_local_name = (a: MutPtr<Malloc>, name: string_view, env: Ptr<VList>, idx: i64) string_view {
    a.name_marks(a.gstr_string(32).gstr_append(a, "_za"), name, env, idx)
}
// Bind every non-trivial arg to a generated local; return the rewritten fargs (the param-use
// substitution targets), the binding Let statements to prepend to the body, and the env extended with
// each temp's CONCRETE light type. The env type is the arg's own light_ty — NOT the param's declared
// type: a UFCS/trait receiver passed by value (`a.addr()`) carries the concrete impl type that
// in-body dispatch (`a.try_acquire(..)`) depends on; the param's declared type is the trait interface,
// which would mis-dispatch (a prior attempt regressed 37 cases this way). Using light_ty makes the
// binding type-TRANSPARENT — the body sees exactly the type splicing the arg would have produced. The
// temp Let carries a void type → genc emits `__auto_type`, the exact concrete C type.
// `pins[i]` (void = none) is the targ-substituted param type a LITERAL arg must ADOPT: splicing a
// raw literal into the body would let every INNER generic call re-infer its tparam from the
// literal's default width (i32) — the outer instantiation's binding (e.g. K=i64 from the HMap
// receiver) silently lost, wrong monos emitted (i64 keys hashed with impl_Hash_i32_hash). A pinned
// literal is bound to a TYPED temp local instead, so in-body uses carry the instantiated type.
// `wbody` (empty = skip) is the TEMPLATE body about to be spliced: a param the body WRITES
// (wr_writes_name — direct assignment, a place assignment rooted at it, or a reflection expansion
// over it whose lambda assigns its value param) is bound to a temp COPY even when the arg is a
// plain Var — inlined params are VALUES, so a callee's `v = v + 1` must mutate its own copy, never
// the caller's argument (#585; the mono path already behaves this way). FnT params are exempt
// (their lambda arg must stay a literal for inline_lambda to splice), as is the lambda-inline path
// (it passes no_stmts()): reflection lambda value params are PLACES of the subject by design.
bind_args* = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    params: [Param],
    cargs: [Expr],
    env: Ptr<VList>,
    pins: [Ty],
    wbody: [Stmt],
) ArgBind {
    nf := a.cebuf(cargs.len)
    nb := 0
    cargs.loop((h, i, ce) {
        (i < params.len
            && (ce.arg_needs_bind()
                || pins[i].is_void_ty() == false
                || params.wr_param_bind(wbody, i))).then({
            nb = nb + 1
        })
    })
    bb := cbuf<Stmt>(a, nb)
    e2 := env
    j := 0
    cargs.loop((h, i, ce) {
        (i < params.len
            && (ce.arg_needs_bind()
                || pins[i].is_void_ty() == false
                || params.wr_param_bind(wbody, i))).match ({
            true  => {
                nm := a.arg_local_name(params[i].name, env, i)
                bb[j] = slett(nm, pins[i], cargs[i].addr())
                e2 = a.vcons(nm, pins[i].is_void_ty().match ({
                    true  => cargs[i].addr().light_ty(a, env, decls, idx),
                    false => pins[i],
                }), e2)
                nf[i] = vref(nm)
                j = j + 1
            },
            false => {
                nf[i] = ce
            },
        })
    })
    ArgBind(
        fargs: nf,
        binds: bb,
        env: e2,
    )
}
// pins for a NON-generic inline (and lambda inlines): none.
no_pins* = (a: MutPtr<Malloc>, n: i64) [Ty] {
    buf := cbuf<Ty>(a, n)
    buf.loop((h, i, t) {
        buf[i] = tvoid()
    })
    buf
}
// The pin for each arg of a GENERIC inline: literal-typed args whose param type mentions a tparam
// adopt the (fully concrete) targ-substituted param type; everything else is unpinned.
lit_pins* = (
    a: MutPtr<Malloc>,
    tparams: [Param],
    targs: [Ty],
    params: [Param],
    cargs: [Expr],
) [Ty] {
    buf := cbuf<Ty>(a, params.len)
    params.loop((h, i, p) {
        buf[i] = tvoid()
        (i < cargs.len && cargs[i].addr().is_lit_numeric() && p.ty.ty_mentions_any(tparams)).then({
            t := a.subst_ty_in(tparams, targs, p.ty)
            (t.is_void_ty() || t.ty_mentions_any(tparams) == false).then({
                buf[i] = t
            })
        })
    })
    buf
}
// the C name a substituted arg carries: a Var holds the (renamed) local it stands for, so an
// indirect call `f()` through a renamed local let recovers `f`'s renamed C name. Falls back to the
// original callee name when the substituted arg isn't a plain Var.
callee_subst_name* = (e: Expr, fallback: string_view) string_view {
    e.match ({
        .Var(v) => v.name,
        _       => fallback,
    })
}
// Inline body as block expression: trailing return becomes the result expression.
ret_to_expr = (st: Stmt) Stmt {
    st.match ({
        .Return(e) => sexpr(e),
        _          => st,
    })
}
block_of = (a: MutPtr<Malloc>, stmts: [Stmt]) Ptr<Expr> {
    buf: [Stmt] := cbuf<Stmt>(a, stmts.len)
    stmts.loop((h, i, st) {
        buf[i] = (i == stmts.len - 1).then({ ret_to_expr(st) }, { st })
    })
    a.cenode(block(buf))
}
// Does a statement (sequence) contain a `return`? Recurses ONLY through If branches — a discarded
// match lowers to an If (lower_match_arms), so an arm `return` lives in an If body. (While/Loop bodies
// are NOT followed: a return inside a real loop can't be lifted to a ?: and is left to the old path.)
stmt_has_return = (st: Stmt) bool {
    st.match ({
        .Return(r) => true,
        .If(f)     => f.then.body_has_return() || f.els.body_has_return(),
        _          => false,
    })
}
body_has_return = (stmts: [Stmt]) bool { stmts.slice_any((st) { st.stmt_has_return() }) }
// A body needs the early-return lift when a `return` appears anywhere except as the clean TRAILING
// top-level statement: a non-final top-level `return`, or any If whose branch contains a `return`.
// When inlined, the body is spliced into a GCC statement-expression `({ … })`, so a real C `return`
// would exit the CALLER's function — a silent miscompile. The lift below rewrites such returns into
// `?:` so control never escapes the block.
needs_early_lift = (stmts: [Stmt]) bool {
    n := stmts.len
    found := false
    stmts.loop((h, i, st) {
        st.match ({
            .Return(r) => {
                (i != n - 1).then({
                    found = true
                })
            },
            .If(f)     => {
                (f.then.body_has_return() || f.els.body_has_return()).then({
                    found = true
                })
            },
            _          => { },
        })
    })
    found
}
// Concatenate two statement slices into a fresh buffer.
cat_stmts* = (a: MutPtr<Malloc>, xs: [Stmt], ys: [Stmt]) [Stmt] {
    buf := cbuf<Stmt>(a, xs.len + ys.len)
    xs.loop((h, i, s) {
        buf[i] = s
    })
    ys.loop((h, i, s) {
        buf[xs.len + i] = s
    })
    buf
}
// stmts[1..] in a fresh buffer.
stmt_tail = (a: MutPtr<Malloc>, xs: [Stmt]) [Stmt] {
    buf := cbuf<Stmt>(a, xs.len - 1)
    xs.loop((h, i, s) {
        (i > 0).then({
            buf[i - 1] = s
        })
    })
    buf
}
// `({ head; <value> })` — a head statement followed by the value expression.
block_cons = (a: MutPtr<Malloc>, head: Stmt, value: Ptr<Expr>) Ptr<Expr> {
    buf := cbuf<Stmt>(a, 2)
    buf[0] = head
    buf[1] = sexpr(value)
    a.cenode(block(buf))
}
// Lift early returns out of an inlined body: turn a statement sequence (in value position) into a
// SINGLE expression. An If whose branches return becomes `cond ? thenVal : elseVal`, where each
// branch's value is the branch body followed by the remaining statements (the continuation) — so a
// `return` simply stops the sequence (its tail is dead) and never lowers to a C `return`. Only ONE
// branch runs at a time, so duplicating the continuation into both arms is sound (no double effects).
cps_value = (a: MutPtr<Malloc>, stmts: [Stmt]) Ptr<Expr> {
    (stmts.len == 0).match ({
        true  => a.cenode(block(no_stmts())),
        false => {
            head := stmts[0]
            rest := a.stmt_tail(stmts)
            head.match ({
                .Return(r) => r,    // tail is dead
                .If(f)     => (f.then.body_has_return() || f.els.body_has_return()).match ({
                    true  => a.cenode(cond(f.c, a.cps_value(a.cat_stmts(f.then, rest)), a.cps_value(a.cat_stmts(f.els, rest)))),
                    false => (rest.len == 0).match ({
                        true  => a.cenode(block(stmts)),
                        false => a.block_cons(head, a.cps_value(rest)),
                    }),
                }),    // trailing for-effect If (void value)
                _          => (rest.len == 0).match ({
                    true  => head.match ({
                        .ExprStmt(e) => e,
                        _            => a.cenode(block(stmts)),
                    }),
                    false => a.block_cons(head, a.cps_value(rest)),
                }),
            })
        },
    })
}
// One value statement inlines directly; larger bodies become block expressions. A body with a
// non-tail return is lifted into `?:` first (early-return → exits only the inlined block, not the caller).
blockify* = (a: MutPtr<Malloc>, stmts: [Stmt]) Ptr<Expr> {
    stmts.needs_early_lift().match ({
        true  => a.cps_value(stmts),
        false => (stmts.len == 1).match ({
            true  => stmts[0].match ({
                .Return(e)   => e,
                .ExprStmt(e) => e,
                _            => a.block_of(stmts),
            }),
            false => a.block_of(stmts),
        }),
    })
}
inline_lambda* = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    lamx: Expr,
    cargs: [Expr],
    env: Ptr<VList>,
) Ptr<Expr> {
    lamx.match ({
        .Lambda(lm) => {
            // spliced lambda body: its `return`s are the LAMBDA's, so bind its own (possibly void)
            // return type over the caller's.
            ab := a.bind_args(decls, idx, lm.params, cargs, a.bind_fnret(env, lm.ret), a.no_pins(lm.params.len), no_stmts())
            a.blockify(a.cat_stmts(ab.binds, a.xform_body(decls, idx, lm.body, lm.params, ab.fargs, ab.env, tvoid())))
        },
        .Var(v)     => a.var_call(v, cargs),
        _           => a.cenode(lamx),
    })
}
// Trait default methods are materialized for impls that omit them.
pbuf* = (a: MutPtr<Malloc>, n: i64) [Param] {
    slice(a.acquire(n * sizeof(Param) + sizeof(Param)), n)
}
// Shared by resolve_module and check_validate.
empty_params* = () [Param] { slice(null_ptr(), 0) }
is_void_ty* = (t: Ty) bool {
    t.match ({
        .Void => true,
        _     => false,
    })
}
