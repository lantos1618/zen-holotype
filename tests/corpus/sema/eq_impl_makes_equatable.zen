// The other side of must-fail/sema/eq_needs_an_impl: `==` is `Eq.eq`, so a
// type that HAS an `Eq` compares with it, and the rejection is not a blanket
// ban on `==` over named types. Without this the check could pass by
// rejecting everything, which is a gate that cannot fail from the other end.

Point = { x*: usize, y*: usize }

Point.impl(Eq, {
    eq = (self: @Self, other: @Self) bool {
        (self.x == other.x) && (self.y == other.y)
    }
})

main = (env: Env) Res<i32, AllocError> {
    a = Point(x: 1, y: 2);
    b = Point(x: 1, y: 2);
    c = Point(x: 1, y: 9);
    println("{}", a == b);
    println("{}", a == c);
    println("{}", a != c);
    println("{}", "ab" == "ab");   // str.impl(Eq, ..) lives in std.text
    println("{}", 3 == 3);         // a primitive: C's own ==
    Ok(0);
}
