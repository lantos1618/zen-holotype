// THE PROVING CONSUMER, BY HAND (`docs/design_meta.md` §7, M4): the
// same program as `dump_via_meta` with the walk written out, once per
// field, and no `@meta` anywhere. The two share one byte-identical
// `.expected`, and the pair failing to agree is the differential signal
// `@meta` otherwise cannot get (§6.3).
//
// THIS IS WHAT THE EXPANDER PRODUCES for `Display.dump`'s body: the
// type name folded to a literal, `field.name` folded to a literal, and
// `self.at(field)` become `self.alpha` / `self.beta` / ... — four
// ordinary field reads of four different types.

Error = AllocError | WriteError

Rec = {
    alpha: i64,
    beta: str,
    gamma: bool,
    delta: u8,
}

Rec.impl(Display, {
    toString ::= (self: @Self, out :: Sink) Res<(), WriteError> {
        out.add("{} {", "Rec").try();
        {
            out.add(" {}: {},", "alpha", self.alpha).try();
        }
        {
            out.add(" {}: {},", "beta", self.beta).try();
        }
        {
            out.add(" {}: {},", "gamma", self.gamma).try();
        }
        {
            out.add(" {}: {},", "delta", self.delta).try();
        }
        out.add(" }").try();
        Ok(());
    }
})

main = (env: Env) Res<i32, Error> {
    alloc ::= env.mem.alloc();
    sb    ::= alloc.String("").try();
    r = Rec(alpha: 71, beta: "quince", gamma: true, delta: 199);
    r.toString(sb).try();
    println("{}", sb.view());
    println("len {}", sb.view().len);
    Ok(0);
}
