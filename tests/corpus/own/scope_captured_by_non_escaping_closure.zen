// the other side of must-fail/own/scope_captured_by_escaping_closure:
// a `@scope` binding captured by a closure that does NOT escape.
//
// `loop` takes no Alloc, so its body cannot be kept past the call and
// the block outlives it — which is the whole reason the restriction is
// one direction and not a ban. registering on `s` from inside the body
// is `@scope` passed INWARD, one frame down.
//
// this is the false-rejection the capture rule must not make: a rule
// that fired on any closure capture would redden every combinator in
// the language.

main = (env: Env) Res<i32, IoError> {
    s = @scope;
    [0, 1, 2].loop((h, i: i32) {
        s.defer(() { println("cleanup {}", i) });
    });
    println("body");
    Ok(0);
}
