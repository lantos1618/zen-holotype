// `!` binds tighter than `&&`: !a && b is (!a) && b, not !(a && b).
//
// ALL FOUR OPERAND COMBINATIONS, because one is not enough. With
// a=true,b=false the correct answer and two wrong readings coincide: a
// compiler that DROPPED the `!` prints false, and so does the right one. The
// table below separates all three -- drop-the-`!` differs at (true,true),
// and the looser binding `!(a && b)` differs at (true,false).

check = (a: bool, b: bool) str {
    (!a && b).match({
        true  => "true",
        false => "false",
    });
}

main = (env: Env) Res<i32, ArgError> {
    println("TT {}", check(true, true));
    println("TF {}", check(true, false));
    println("FT {}", check(false, true));
    println("FF {}", check(false, false));
    Ok(0);
}
