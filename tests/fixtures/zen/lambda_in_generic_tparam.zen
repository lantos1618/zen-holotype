// A lambda written inside a GENERIC body may name the enclosing type params. Two independent holes
// made that impossible, and this fixture pins both:
//   • the lift pass dropped the enclosing tparams (`tparams: empty_params()`), so the TEMPLATE's
//     lifted lambda was a top-level fn mentioning an undeclared `A`;
//   • generic substitution passed `.Lambda` through untouched, so the INSTANCE kept `MutPtr<A>` too.
// `dyn_from` is the payoff: `(a: Allocator)` desugars to `<A: Allocator>(a: MutPtr<A>)`, so erasing a
// THREADED allocator into a `DynAlloc` value needs exactly this.
{ Allocator, DynAlloc, Malloc, dyn_from } = std.mem.alloc
{ println } = std.text.fmt
// the same shape one level of nesting deeper: a lambda inside a lambda inside a generic body.
Pair*: {
    outer: (RawPtr<u8>, i64) i64,
}
Counter*: {
    n: i64,
}
Bump*: {
    hits: (MutPtr<Self>) i64,
}
Counter.impl(Bump, {
    hits = (c: MutPtr<Counter>) i64 { c.load().n }
})
nest<T: Bump> = (p: MutPtr<T>) Pair {
    Pair(outer: (s: RawPtr<u8>, k: i64) i64 {
        r: MutPtr<T> = s
        r.hits() + k
    })
}
main = () i32 {
    m = Malloc(_: 0)
    d = dyn_from(m.addr())
    p = d.acquire(64)
    q = d.resize(p, 128)
    d.release(q)
    c = Counter(n: 7)
    pr = nest(c.addr())
    (pr.outer(c.addr().offset(0), 5) == 12).match ({
        true  => println("lambda-in-generic ok"),
        false => println("lambda-in-generic BAD"),
    })
    0
}
