// src/sema/sema_layout.zen
// Whole-program rejection of by-value struct layout cycles.
//
// Pointer-like and non-nominal fields terminate a path. Generic structs
// abstain because cycles requiring substitution belong to instantiation.
// Each cycle is reported once at its earliest source edge.

Decl, Struct, Member, Field = std.ast
Ident, Pos, TypeId = std.ast
Alloc, AllocError = std.mem
Vec = std.collections
Range = std.core
DeclId = sema.sema_id
TyId = sema.sema_ty
Def, ModuleTable, decl_at = sema.sema_def
SemaFault, NameFault = sema.sema_diag
Checker, Ctx = sema.sema_check
type_from_ast = sema.sema_denote

// One struct on the walk, and the field that reached it. A blame is
// always an edge, so the root frame's `site` is never read, which is
// why it costs nothing to give the root the struct's own name.
Frame = {
    id: DeclId,
    site: Ident,
}

// State for one whole-program layout walk.
Layout = {
    path :: Vec<Frame>,
    done :: Vec<DeclId>,

    all = (self :: @Self, c :: Checker) Res<(), AllocError> {
        Range(0, c.world.count()).loop((h, mi) {
            self.module(c, mi).try();
        });
        Ok(())
    }

    module = (self :: @Self, c :: Checker, mi: usize) Res<(), AllocError> {
        c.world.table_at(mi).match({
            None  => Ok(()),
            Ok(t) => self.table(c, t),
        })
    }

    table = (self :: @Self, c :: Checker, t: ModuleTable)
            Res<(), AllocError> {
        t.defs.loop((h, d) { self.root(c, d).try() });
        Ok(())
    }

    root = (self :: @Self, c :: Checker, d: Def) Res<(), AllocError> {
        c.struct_of(d.id).match({
            None  => Ok(()),
            Ok(s) => self.enter(c, d.id, s, s.name),
        })
    }

    enter = (self :: @Self, c :: Checker, id: DeclId, s: Struct, site: Ident)
            Res<(), AllocError> {
        contains(self.done, id).match({
            true  => Ok(()),
            false => self.walk(c, id, s, site),
        })
    }

    walk = (self :: @Self, c :: Checker, id: DeclId, s: Struct, site: Ident)
           Res<(), AllocError> {
        self.path.add(Frame(id: id, site: site)).try();
        s.members.loop((h, m) { self.field(c, m).try() });
        self.path.take(self.path.len - 1);
        self.done.add(id).try();
        Ok(())
    }

    // Constants and methods occupy no per-instance storage.
    field = (self :: @Self, c :: Checker, m: Member) Res<(), AllocError> {
        m.kind.match({
            Field(f) => self.typed(c, f),
            _        => Ok(()),
        })
    }

    typed = (self :: @Self, c :: Checker, f: Field) Res<(), AllocError> {
        f.type.match({
            None  => Ok(()),
            Ok(t) => self.edge_from_top(c, t, f.name),
        })
    }

    // Field types resolve in the module of the struct atop the path.
    edge_from_top = (self :: @Self, c :: Checker, t: TypeId, site: Ident)
                    Res<(), AllocError> {
        self.path.get(self.path.len - 1).match({
            None   => Ok(()),
            Ok(fr) => self.edge_from(c, fr, t, site),
        })
    }

    // Resolving `Ptr<Node>` yields `Ptr`, so pointer fields stop the path.
    edge_from = (
        self :: @Self,
        c     :: Checker,
        fr    : Frame,
        t     : TypeId,
        site  : Ident
    ) Res<(), AllocError> {
        poison = c.types.unknown().try();
        ctx    = Ctx(fr.id.module.to_usize(), poison);
        ty     = c.type_from_ast(t, ctx).try();
        named_decl(c, ty).match({
            None     => Ok(()),
            Ok(next) => self.step(c, next, site),
        })
    }

    step = (self :: @Self, c :: Checker, next: DeclId, site: Ident)
           Res<(), AllocError> {
        index_on(self.path, next).match({
            Ok(k) => self.close(c, k, site),
            None  => self.descend(c, next, site),
        })
    }

    descend = (self :: @Self, c :: Checker, next: DeclId, site: Ident)
              Res<(), AllocError> {
        c.struct_of(next).match({
            None  => Ok(()),
            Ok(s) => self.enter(c, next, s, site),
        })
    }

    // Diagnose the earliest source edge in the cycle for a stable result.
    close = (self :: @Self, c :: Checker, k: usize, site: Ident)
            Res<(), AllocError> {
        blame ::= site;
        Range(k + 1, self.path.len).loop((h, i) {
            blame = earlier(blame, site_at(self.path, i, blame));
        });
        c.report(
            blame.span.file,
            blame.span,
            SemaFault.InfiniteSize(NameFault(name: blame.text))
        ).try();
        self.seal(k).try();
        Ok(())
    }

    // Mark all structs in the cycle to avoid rotated duplicate diagnostics.
    seal = (self :: @Self, k: usize) Res<(), AllocError> {
        Range(k, self.path.len).loop((h, i) {
            self.path.get(i).match({
                None   => Ok(()),
                Ok(fr) => self.done.add(fr.id),
            }).try();
        });
        Ok(())
    }
}

Layout = (a: Alloc) Layout {
    Layout(path: a.Vec<Frame>(), done: a.Vec<DeclId>())
}

// Reject every by-value struct cycle in the program.
check_layout* = (c :: Checker) Res<(), AllocError> {
    state ::= c.alloc.Layout();
    state.all(c)
}

named_decl = (c: Checker, ty: TyId) Res<DeclId> {
    c.types.at(ty).match({
        Named(n) => Ok(n.decl),
        _        => None,
    })
}

// ---------------------------------------------------------------------
// the small answers
// ---------------------------------------------------------------------

// The struct a declaration is, when this walk can answer about one. A
// generic struct abstains — see the header.
struct_of = (c: Checker, id: DeclId) Res<Struct> {
    decl_at(c.tree, id).match({
        None  => None,
        Ok(x) => monomorphic_struct(x),
    })
}

monomorphic_struct = (x: Decl) Res<Struct> {
    x.kind.match({
        Struct(s) => (s.tparams.len == 0).match({
            true  => Ok(s),
            false => None,
        }),
        _         => None,
    })
}

index_on = (path: Vec<Frame>, id: DeclId) Res<usize> {
    Range(0, path.len).find((i) { at_is(path, i, id) })
}

at_is = (path: Vec<Frame>, i: usize, id: DeclId) bool {
    path.get(i).match({
        None   => false,
        Ok(fr) => fr.id.eq(id),
    })
}

contains = (done: Vec<DeclId>, id: DeclId) bool {
    Range(0, done.len).find((i) {
        done.get(i).match({ None => false, Ok(x) => x.eq(id) })
    }).match({ Ok(_) => true, None => false })
}

site_at = (path: Vec<Frame>, i: usize, fallback: Ident) Ident {
    path.get(i).match({ Ok(fr) => fr.site, None => fallback })
}

// Nearer the top of a file. Two files cannot be ordered by position, so
// the one found first wins; the walk order is fixed, so every run
// agrees.
earlier = (a: Ident, b: Ident) Ident {
    earlier_pos(b.span.start, a.span.start).match({ true => b, false => a })
}

// Named for what it answers here -- "is x earlier" -- and not `before`:
// ast_find.zen exports the same three lines under that name, and Zen has
// no overloading to tell them apart.
earlier_pos = (x: Pos, y: Pos) bool {
    (x.line < y.line) || ((x.line == y.line) && (x.col < y.col))
}
