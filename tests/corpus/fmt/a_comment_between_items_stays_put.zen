// A COMMENT BETWEEN TWO ITEMS IS A TOKEN, and the width rule moves no
// token — so a list whose gap holds one is refused, whole. The packed
// line below is well past 80 columns, and it comes through byte for
// byte: breaking it would strand `// the first one` where the canonical
// form has no room for it, and eating or stranding a comment is the
// exact accident this folder exists to prevent (`fmt_decl.zen` refuses
// the same way when a comment sits in a `=>` gap).
//
// `faithful` is printed per case for the reason
// a_long_argument_list_breaks_one_per_line.zen gives.

Alloc, AllocError = std.mem
str, String = std.text
scan, Source = std.lex.lex
render = fmt.fmt

main = (env: Env) Res<i32, AllocError> {
    a ::= env.mem.alloc();

    shows(
        a,
        "a comment between two items refuses the break",
        "x = outer_call(first_argument,  // the first one\n               second_argument, third_argument, fourth_argument)\n").try();

    Ok(0);
}

shows = (a: Alloc, what: str, text: str) Res<(), AllocError> {
    first = formatted(a, text).try();
    second = formatted(a, first.view()).try();
    println("== {}", what);
    println(
        "faithful: {}, {}",
        faithful_of(a, text).try(),
        verdict(first.view().eq(second.view())));
    show(first.view());
    Ok(());
}

verdict = (settled: bool) str {
    settled.match({
        true  => "fixpoint",
        false => "MOVED",
    })
}

formatted = (a: Alloc, text: str) Res<String, AllocError> {
    lexed = scan(a, Source(file: "in.zen", text: text)).try();
    out = render(a, lexed).try();
    Ok(out.text);
}

faithful_of = (a: Alloc, text: str) Res<bool, AllocError> {
    lexed = scan(a, Source(file: "in.zen", text: text)).try();
    out = render(a, lexed).try();
    Ok(out.faithful);
}

show = (text: str) () {
    line ::= 0;
    from ::= 0;
    Range(0, text.len).loop((h, i) {
        (text.index(i) == '\n').then(() {
            line = line + 1;
            println("{} |{}|", line, text.slice(from, i));
            from = i + 1;
        });
    });
}
