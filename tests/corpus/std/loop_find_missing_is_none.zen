// tests/corpus/std/loop_find_missing_is_none.zen
// nothing matches: find is Res<T>, so the miss is None. it does
// not allocate and it does not trap
//
// AND THE SCAN ACTUALLY RAN. `none` alone is printed by a find stubbed to
// answer None without looking at a single element, and by a `.match`
// hardwired to its second arm -- so the predicate below shouts, and the ten
// lines it prints are the proof the miss was earned. The hit beside it kills
// the stub from the other side: a find that always answers None cannot
// print `found 7`, and one that answers the first element cannot either.

main = (env: Env) Res<i32, AllocError> {
    Range(0, 10).find((value) {
        println("saw {}", value);
        value > 99
    }).match({
        Ok(n) => println("found {}", n),
        None  => println("none"),
    });

    Range(0, 10).find((value) {
        value * 3 == 21
    }).match({
        Ok(n) => println("found {}", n),
        None  => println("none"),
    });

    Range(0, 10).find((value) {
        value > 99
    }).match({
        Ok(n) => println("found {}", n),
        None  => println("none"),
    });
    Ok(0);
}
