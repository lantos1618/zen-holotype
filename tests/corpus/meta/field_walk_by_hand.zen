// M4'S GATE, THE BY-HAND HALF (`docs/design_meta.md` §7, M4): the same
// program as `field_walk_via_meta` with the unrolled loop written out,
// once per field, by hand — no `@meta` anywhere. The two share one
// byte-identical `.expected`, and the pair failing to agree is the
// differential signal `@meta` otherwise cannot get (§6.3).
//
// THIS FILE IS WHAT THE EXPANDER PRODUCES. `field.name` became a string
// literal, `r.at(field)` became `r.alpha` / `r.beta` / ..., and the loop
// became five copies of the body — so if the two halves ever disagree,
// this is the shape to compare the emitted C against.
//
// run.py has no shared-expectation spelling — a single-file test is
// `<name>.zen` plus `<name>.expected` under the SAME basename — so the
// "one shared .expected" §6.3 asks for is two files with the same bytes.

Rec = {
    alpha*: i64,
    beta*: str,
    gamma*: bool,
    delta*: f64,
    epsilon*: u8,
}

main = (env: Env) Res<i32, AllocError> {
    r = Rec(
        alpha: 71,
        beta: "quince",
        gamma: true,
        delta: 3.25,
        epsilon: 199,
    );
    n ::= 0;
    {
        println("{} = {}", "alpha", r.alpha);
        n = n + 1;
    }
    {
        println("{} = {}", "beta", r.beta);
        n = n + 1;
    }
    {
        println("{} = {}", "gamma", r.gamma);
        n = n + 1;
    }
    {
        println("{} = {}", "delta", r.delta);
        n = n + 1;
    }
    {
        println("{} = {}", "epsilon", r.epsilon);
        n = n + 1;
    }
    println("fields {}", n);
    Ok(0);
}
