// compiler.backend.js.js_lit — integer rendering, JS identifier-safety mangling, and JS string-literal escaping
// leaf helpers for the JavaScript backend. Extracted from compiler.backend.js.js. Byte-only so this self-hosts.
// The JS escape (`jesc_byte`) is intentionally distinct from the C backend's (JS uses `\n`/`\"`, and
// strings are interned via `__zr.str`), so this family lives here beside js, not in c_lit.
{ String } = std.text.string
{ gstr_append, gstr_push } = compiler.genc
{ dec_digit, gstr_int } = compiler.astops
{ Malloc } = std.mem.alloc
{ escape_into } = std.text.ascii    // the shared scan-and-emit loop; the JS escape TABLE stays here
// ── small integer renderer ──────────────────────────────────────────────────────────────────────
// The non-negative recursion is the shared gstr_int (compiler.astops); only the JS-specific minus-sign
// wrapper stays here. `jint_neg` walks negatives directly so INT64_MIN doesn't overflow on `0 - n` —
// this is why JS can NOT go through gstr_int (which reinterprets negative bits as unsigned, no sign).
jint* = (s: String, a: MutPtr<Malloc>, n: i64) String {
    (n < 0).match ({ true => s.gstr_append(a, "-").jint_neg(a, n), false => s.gstr_int(a, n) })
}
// walk negatives directly so INT64_MIN doesn't overflow on `0 - n`
jint_neg = (s: String, a: MutPtr<Malloc>, n: i64) String {
    (n > 0 - 10).match ({
        true  => s.gstr_push(a, dec_digit(0 - n)),
        false => {
            hs := s.jint_neg(a, n / 10)
            hs.gstr_push(a, dec_digit(0 - n % 10))
        },
    })
}
// ── JS identifier safety: a Zen name that is a JS reserved word gets a `$` suffix (so a Zen fn named
//    `default`/`new`/`class`/… is a legal JS name). Field/property names are NOT mangled (any string is
//    a valid object key). Kept small — only the words that actually collide with Zen's identifier space.
js_is_reserved = (n: string_view) bool {
    n == "default"
        || n == "new"
        || n == "class"
        || n == "function"
        || n == "var"
        || n == "let"
        || n == "const"
        || n == "this"
        || n == "null"
        || n == "delete"
        || n == "in"
        || n == "instanceof"
        || n == "typeof"
        || n == "void"
        || n == "with"
        || n == "super"
        || n == "enum"
        || n == "export"
        || n == "import"
        || n == "extends"
        || n == "switch"
        || n == "case"
        || n == "yield"
        || n == "await"
        || n == "debugger"
        || n == "finally"
}
jname* = (s: String, a: MutPtr<Malloc>, n: string_view) String {
    js_is_reserved(n).match ({
        true  => s.gstr_append(a, n).gstr_append(a, "$"),
        false => s.gstr_append(a, n),
    })
}
// ── JS string-literal escaping (byte by byte to the NUL) ──────────────────────────────────────────
jesc_byte = (s: String, a: MutPtr<Malloc>, b: u8) String {
    (b == '"').match ({
        true  => s.gstr_append(a, "\\\""),
        false => (b == '\\').match ({
            true  => s.gstr_append(a, "\\\\"),
            false => (b == '\n').match ({
                true  => s.gstr_append(a, "\\n"),
                false => (b == '\r').match ({
                    true  => s.gstr_append(a, "\\r"),
                    false => (b == '\t').match ({
                        true  => s.gstr_append(a, "\\t"),
                        false => s.gstr_push(a, b),
                    }),
                }),
            }),
        }),
    })
}
jstrlit* = (s: String, a: MutPtr<Malloc>, v: string_view) String {
    s.gstr_append(a, "__zr.str(\"").escape_into(a, v, jesc_byte).gstr_append(a, "\")")
}
