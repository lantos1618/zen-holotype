// tests/corpus/std/loop_while_cond.zen
// the cond variant: a () bool closure tested BEFORE each pass, so
// a cond that is false to begin with runs the body zero times

main = (env: Env) Res<i32, AllocError> {
    n ::= 0;
    loop(() bool { n < 3 }, (h) {
        println("n {}", n);
        n = n + 1;
    });
    println("done {}", n);

    never ::= 0;
    loop(() bool { never > 0 }, (h) {
        never = never + 1;
        println("body ran");
    });
    println("never {}", never);
    Ok(0);
}
