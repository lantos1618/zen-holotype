// MUST FAIL: a leading `|` on match arms. DESIGN.md:152 — arms are "comma-separated,
// no leading `|`; `=>` already separates, so the bar is noise." `|` exists only in
// type position, building an anonymous error union (DESIGN.md:181).

label* = (b: bool) str {
    b.match({
        | true => "zero",
        | false => "nonzero",
    })
}
