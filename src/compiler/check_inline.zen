// compiler.check_inline — generic template inlining, trait-miss diagnostics, and recursive-generic
// monomorphization + closure lowering. Extracted from compiler.check (pure move).
{ cbuf, Expr, Stmt, Decl, Func, Param, Ty, EnumDecl, StructDecl, Field, ImplData, TraitDefData, ArmData, MatchData, VariantDef, LetData, AssignData, IndexSetData, IndexData, MemberData, ArrowData, VarData, CallData, MethodCallData, CondData, BinData, BlockData, LambdaData, GenericData, MakeStructData, MakeEnumData, TagData, vref, vref_at, ty_cname_in, bin, bin_at, cond, cond_oa, call, call_at, raw_call_at, call_full, member, member_at, arrow, arrow_at, ematch, ematchp, mkenum, mktag, arm, arm_at, eindex, eloop, LoopData, lam_r, slet, slett, slett_at, sassign, sassign_at, sret, sexpr, sif, swhile, sidxset_at, mkstruct, mkstruct_at, finit, FieldInit, slit, SliceData, block, stmts_diverge, fnt_from_func_in, fntype, subst_ty_in, dfunc, dforeign, dglobal, dglobal_tl, GlobalData, mkstructg, mkstructg_at, mkenumg, mktagg, no_tys, expr_null, is_expr_null, GenEnumDecl, GenStructDecl, find_genenum, tgeneric, FnTData, flit, ti32, ti64, tu8, tf64, tbool, tstring_view, tstring_cstr, tstring_literal, tnamed, tptr, tptr_k, tslice, tvoid, k_ptr, k_mut_ptr, k_raw_ptr, gstr_string, gstr_grow, gstr_reserve, gstr_push, gstr_append, gstr_finish } = compiler.genc
{ mangle_str_in, mangle_semantic_in, impl_cname_in } = compiler.mangle
{ Malloc } = std.mem.alloc
{ view, eq, is_empty, ends_with } = std.text.str
{ Map, of } = std.collections.map
{ subst_body, xform_body } = compiler.passes.subst
{ clos_lower_func, clos_lowerable } = compiler.passes.closures
{ rc_expand, rc_gbuf, rc_gen, rc_seed } = compiler.passes.refcount
{ TyQuery, FuncQuery, has_fnt_param } = compiler.astops
{ Env, VList, DeclIndex, bind_args, bind_fnret, blockify, build_decl_index, cat_stmts, cenode, cps_value, dispatch_recv, dispatch_recv_name, empty_args, empty_params, is_void_ty, lit_pins, no_pins, param_index, params_env, recall, resolve_call, resolve_decl, vcons, vnil } = compiler.check
{ infer_targs } = compiler.check_infer
// A generic template's body is inlined INTO its call site, but its AST nodes keep the LIBRARY byte
// offsets they were parsed at — so a type error uncovered while checking the instantiated body would
// point deep inside std (e.g. `fmt.zen:108`), a place the user never wrote. `cs` is the call-site
// byte offset threaded from the call being inlined; `cs_or` retargets every rebuilt template node to
// it so the diagnostic lands on the user's call (census #59b). cs = 0 (a synthesized call, or the
// recursive-generic mono path) means "keep the node's own position" — nothing is retargeted, so the
// emitted C and every non-inlined diagnostic are byte-for-byte unchanged. (`cs_or`, not the count
// layer's `pos_or`: those share a flat C name and must stay distinct.)
cs_or* = (cs: i32, orig: i32) i32 { (cs == 0).match ({ true => orig, false => cs }) }
// Substitute tparams in type-bearing expression/statement nodes.
is_empty_named* = (t: Ty) bool {
    t.match ({
        .Named(n) => eq(n, ""),
        _         => false,
    })
}
// Break recursive-generic inlining by noticing an in-progress template in the env.
is_inlining* = (v: Ptr<VList>, name: string_view) bool {
    v.match ({
        .VNil     => false,
        .VCons(c) => (eq(c.name, name) && c.ty.is_empty_named()).match ({
            true  => true,
            false => c.tail.is_inlining(name),
        }),
    })
}
inline_template* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, name: string_view, cargs: [Expr], env: Ptr<VList>, exp: Ty, etargs: [Ty], cs: i32) Ptr<Expr> {
    tf := idx.idx_func(decls, name)
    ienv := a.vcons(name, tnamed(""), env)
    // A function's body MUST produce its DECLARED return type, so that (targ-substituted) return is the
    // authoritative expected type for the body's tail — NOT the call-site `exp`. This matters when an
    // inlined fn is called WITHOUT expected context (e.g. `inner(..).match(..)`, the call as a match
    // subject): a generic constructor in inner's tail still binds T/E from inner's own `R<str,IoError>`
    // return. The call-site `exp` is used only to infer unconstrained tparams (infer_targs).
    // bind_fnret: the inlined body's OWN return type shadows the caller's for any `return` inside it
    // (a template's non-tail returns are lifted by blockify/cps_value, but their operands still infer
    // against the template's declared return, targ-substituted).
    (tf.tparams.len > 0).match ({
        true  => {
            targs := a.infer_targs(tf.tparams, tf.params, tf.ret, exp, cargs, env, decls, idx, etargs)
            rsub := a.subst_ty_in(tf.tparams, targs, tf.ret)
            ab := a.bind_args(decls, idx, tf.params, cargs, a.bind_fnret(ienv, rsub), a.lit_pins(tf.tparams, targs, tf.params, cargs))
            a.blockify(a.cat_stmts(ab.binds, a.xform_body(decls, idx, a.subst_body(cs, tf.tparams, targs, tf.body), tf.params, ab.fargs, ab.env, rsub)))
        },
        false => {
            ab := a.bind_args(decls, idx, tf.params, cargs, a.bind_fnret(ienv, tf.ret), a.no_pins(tf.params.len))
            a.blockify(a.cat_stmts(ab.binds, a.xform_body(decls, idx, a.subst_body(cs, empty_params(), no_tys(), tf.body), tf.params, ab.fargs, ab.env, tf.ret)))
        },
    })
}
// A residual no-inline generic call loses its splice context once the enclosing body is inlined
// (the template's declared return, the let's declared type). PIN the targs inferred HERE into the
// call as explicit turbofish targs, so the later resolve/discovery mangle the SAME instance — e.g.
// a tail `ok(x)` spliced out of a `Result<i32, IoError>`-returning template keeps E=IoError instead
// of re-inferring E=void once the context is gone. Pin only a FULLY-inferred list: a void slot
// (light inference bails on tparam receivers inside template bodies) must stay open for the
// instance-context inference, and a pinned void would win over it.
all_concrete_targs* = (ts: [Ty]) bool {
    con := true
    ts.loop((h, i, t) {
        con = t.is_void_ty().match ({ true => false, false => con })
    })
    con
}
// ── DIAGNOSTICS fallback: splice a template whose instantiation would MISS a trait impl ─────────
// A template body calling a TRAIT method on a directly tparam-typed param (`println<T>`'s
// `x.fmt_println()`) instantiated at a targ type with NO impl would surface the miss deep inside
// the template's own source (against abstract `T`). The OLD splice path put the trait-method call
// at the CALL SITE with the concrete receiver — exactly what the call-site trait-bound diagnostic
// (#409) keys on. So: detect the miss (conservatively — direct tparam param receivers, concrete
// struct targs only) and route that call back through inline_template.
tmiss_tp_of* = (ps: [Param], tparams: [Param], e: Ptr<Expr>) string_view {
    load(e).match ({
        .Var(v) => {
            i := ps.param_index(v.name)
            (i >= 0).match ({
                true  => ps[i].ty.match ({
                    .Named(n) => tparams.tmiss_has_tp(n).match ({ true => n, false => "" }),
                    _         => "",
                }),
                false => "",
            })
        },
        _       => "",
    })
}
tmiss_has_tp* = (tparams: [Param], n: string_view) bool {
    f := false
    tparams.loop((h, i, tp) {
        f = eq(tp.name, n).match ({ true => true, false => f })
    })
    f
}
tmiss_targ_for* = (tparams: [Param], targs: [Ty], n: string_view) Ty {
    t := tvoid()
    tparams.loop((h, i, tp) {
        t = (eq(tp.name, n) && i < targs.len).match ({ true => targs[i], false => t })
    })
    t
}
// is `fn` trait-flavored — provided by some impl, defaulted by a trait, or declared by a trait
// (a struct whose same-named field is an FnT signature)? One decl scan, run only on candidates.
tmiss_traitish* = (decls: [Decl], fn: string_view) bool {
    found := false
    decls.loop((h, i, d) {
        found = d.match ({
            .DImpl(im)         => im.methods.tmiss_has_tp(fn).match ({
                true  => true,
                false => found,
            }),
            .DTraitDefault(td) => eq(td.fn.name, fn).match ({ true => true, false => found }),
            .DStruct(sd)       => found.match ({
                true  => true,
                false => sd.fields.tmiss_declares(fn),
            }),
            _                  => found,
        })
    })
    found
}
tmiss_declares* = (fields: [Field], m: string_view) bool {
    found := false
    fields.loop((h, i, f) {
        found = (eq(f.name, m) && f.ty.is_fnt()).match ({ true => true, false => found })
    })
    found
}
tmiss_call* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, tf: Func, targs: [Ty], c: CallData) bool {
    (c.args.len > 0).match ({
        true  => {
            tpn := tf.params.tmiss_tp_of(tf.tparams, c.args[0].addr())
            is_empty(tpn).match ({
                true  => false,
                false => {
                    tyname := tf.tparams.tmiss_targ_for(targs, tpn).dispatch_recv_name()
                    (is_empty(tyname) || idx.struct_idx.get(tyname, 0 - 1) < 0).match ({
                        true  => false,
                        false => eq(a.dispatch_recv(decls, idx, c.fn, tyname), c.fn).match ({
                            true  => decls.tmiss_traitish(c.fn),
                            false => false,
                        }),
                    })
                },
            })
        },
        false => false,
    })
}
tmiss_es* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, tf: Func, targs: [Ty], xs: [Expr]) bool {
    f := false
    xs.loop((h, i, x) {
        f = f.match ({ true => true, false => a.tmiss_e(decls, idx, tf, targs, x.addr()) })
    })
    f
}
tmiss_arms* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, tf: Func, targs: [Ty], arms: [ArmData]) bool {
    f := false
    arms.loop((h, i, ar) {
        f = f.match ({ true => true, false => a.tmiss_e(decls, idx, tf, targs, ar.body) })
    })
    f
}
tmiss_inits* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, tf: Func, targs: [Ty], inits: [FieldInit]) bool {
    f := false
    inits.loop((h, i, fi) {
        f = f.match ({ true => true, false => a.tmiss_e(decls, idx, tf, targs, fi.value) })
    })
    f
}
tmiss_e* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, tf: Func, targs: [Ty], e: Ptr<Expr>) bool {
    load(e).match ({
        .Call(c)       => a.tmiss_call(decls, idx, tf, targs, c) || a.tmiss_es(decls, idx, tf, targs, c.args),
        .Bin(b)        => a.tmiss_e(decls, idx, tf, targs, b.lhs) || a.tmiss_e(decls, idx, tf, targs, b.rhs),
        .Cond(d)       => a.tmiss_e(decls, idx, tf, targs, d.c) || a.tmiss_e(decls, idx, tf, targs, d.t) || a.tmiss_e(decls, idx, tf, targs, d.e),
        .Member(m)     => a.tmiss_e(decls, idx, tf, targs, m.obj),
        .Arrow(ar)     => a.tmiss_e(decls, idx, tf, targs, ar.obj),
        .MakeEnum(mk)  => a.tmiss_e(decls, idx, tf, targs, mk.payload),
        .MakeStruct(s) => a.tmiss_inits(decls, idx, tf, targs, s.inits),
        .Match(m)      => a.tmiss_e(decls, idx, tf, targs, m.subj) || a.tmiss_arms(decls, idx, tf, targs, m.arms),
        .Index(ix)     => a.tmiss_e(decls, idx, tf, targs, ix.seq) || a.tmiss_e(decls, idx, tf, targs, ix.idx),
        .SliceLit(sd)  => a.tmiss_es(decls, idx, tf, targs, sd.items),
        .Loop(l)       => a.tmiss_e(decls, idx, tf, targs, l.seq) || a.tmiss_body(decls, idx, tf, targs, l.body),
        .Block(bl)     => a.tmiss_body(decls, idx, tf, targs, bl.stmts),
        .Lambda(la)    => a.tmiss_body(decls, idx, tf, targs, la.body),
        _              => false,
    })
}
tmiss_stmt* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, tf: Func, targs: [Ty], st: Stmt) bool {
    st.match ({
        .Let(l)      => a.tmiss_e(decls, idx, tf, targs, l.value),
        .Assign(x)   => a.tmiss_e(decls, idx, tf, targs, x.target) || a.tmiss_e(decls, idx, tf, targs, x.value),
        .Return(r)   => a.tmiss_e(decls, idx, tf, targs, r),
        .ExprStmt(e) => a.tmiss_e(decls, idx, tf, targs, e),
        .If(f)       => a.tmiss_e(decls, idx, tf, targs, f.c) || a.tmiss_body(decls, idx, tf, targs, f.then) || a.tmiss_body(decls, idx, tf, targs, f.els),
        .While(w)    => a.tmiss_e(decls, idx, tf, targs, w.c) || a.tmiss_body(decls, idx, tf, targs, w.body),
        .IndexSet(x) => a.tmiss_e(decls, idx, tf, targs, x.seq) || a.tmiss_e(decls, idx, tf, targs, x.idx) || a.tmiss_e(decls, idx, tf, targs, x.value),
    })
}
tmiss_body* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, tf: Func, targs: [Ty], body: [Stmt]) bool {
    f := false
    body.loop((h, i, st) {
        f = f.match ({ true => true, false => a.tmiss_stmt(decls, idx, tf, targs, st) })
    })
    f
}
pin_targs* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, c: CallData, cargs: [Expr], env: Ptr<VList>, exp: Ty, may_splice: bool) Ptr<Expr> {
    tf := idx.idx_func(decls, c.fn)
    (tf.tparams.len > 0 && tf.params.len == cargs.len).match ({
        true  => {
            pt := a.infer_targs(tf.tparams, tf.params, tf.ret, exp, cargs, env, decls, idx, c.targs)
            (may_splice && a.tmiss_body(decls, idx, tf, pt, tf.body)).match ({
                true  => a.inline_template(decls, idx, c.fn, cargs, env, exp, c.targs, c.pos),
                false => pt.all_concrete_targs().match ({
                    true  => a.cenode(call_full(c.fn, cargs, pt, c.pos, c.raw)),
                    false => a.recall(c, c.fn, cargs),
                }),
            })
        },
        false => a.recall(c, c.fn, cargs),
    })
}
maybe_template* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, c: CallData, cargs: [Expr], env: Ptr<VList>, exp: Ty) Ptr<Expr> {
    idx.idx_template_call(decls, c.fn).match ({
        true  => (env.is_inlining(c.fn) || idx.idx_func(decls, c.fn).no_inline_gen_f()).match ({
            true  => a.pin_targs(decls, idx, c, cargs, env, exp, env.is_inlining(c.fn) == false),
            false => (idx.idx_func(decls, c.fn).params.len == cargs.len).match ({
                true  => a.inline_template(decls, idx, c.fn, cargs, env, exp, c.targs, c.pos),
                false => a.recall(c, c.fn, cargs),
            }),
        }),
        false => a.recall(c, c.fn, cargs),
    })
}
// A recursive generic fn cannot be inlined (the splice never terminates); leave the call as a
// bare call to the template name. compiler.check's mono_rec emits one concrete C instance per
// (template, concrete-targs) and resolve_call rewrites the call to it. (is_inlining is the same
// recursion-break, but a recursive generic must NEVER splice even on its first reach.)
inline_decl* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, d: Decl) Decl {
    d.match ({
        .DFunc(f) => dfunc(Func(
            name: f.name,
            params: f.params,
            ret: f.ret,
            tparams: f.tparams,
            body: a.xform_body(decls, idx, f.body, empty_params(), empty_args(), a.bind_fnret(a.params_env(f.params), f.ret), f.ret),
            pos: f.pos,
        )),
        _         => d,
    })
}
// ── RECURSIVE GENERIC FUNCTION MONOMORPHIZATION ──────────────────────────────────────────────
// A generic FUNCTION that calls itself can't be inlined (the splice never terminates), so the inliner
// leaves the self-call as a bare call to the template name, which links to nothing. This pass mirrors
// compiler.mono's struct/enum monomorphization for FUNCTIONS: it discovers every distinct (template,
// concrete-targs) the program uses and emits one concrete C function per instance (tparam→arg
// substituted), with a deterministic mangled name (the SAME scheme as generic structs/enums, via
// mangle_str_in). resolve_call then rewrites each recursive-generic call to its mangled instance.
// Only DIRECT type-param recursion is handled; FnT-splice generics and mutual recursion still inline.
// detection: does `body` contain a DIRECT call to `nm`? (the self-call test)
no_inline_gen_f* = (f: Func) bool { f.is_generic_fn() && f.params.has_fnt_param() == false }
// instance buffer: deduped by mangled name, bounded against polymorphic-recursion blowup (like mono).
mono_rec* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, from: i64) [Decl] {
    base := Env(
        vars: a.vnil(),
        decls: decls,
        didx: idx,
        exp: tvoid(),
        a: a,
    )
    buf := a.rc_gbuf(4096)
    cnt := base.rc_expand(buf, base.rc_seed(buf, 0, from), 0)
    (cnt == 0).match ({
        true  => decls,
        false => {
            out := cbuf<Decl>(a, decls.len + cnt)
            decls.loop((h, i, d) {
                out[i] = d
            })
            k := decls.len
            buf.loop((h, i, g) {
                (i < cnt).then({
                    out[k] = base.rc_gen(g)
                    k = k + 1
                })
            })
            slice(out.ptr, k)
        },
    })
}
// KEYSTONE closure: one mono_rec round appends concrete instances whose (substituted) bodies are
// still un-spliced template bodies — they may call FnT-param generics (HOFs) that must inline, and
// those splices can expose FURTHER generic calls. So per round: resolve the appended tail (dispatch
// on its now-concrete types), inline it (splice HOFs/lambdas), rerun discovery. Terminates: rc
// discovery dedups against the decl index (an emitted instance is never re-added), so each round
// either strictly grows the decl list or stops; the rc depth bound caps polymorphic recursion, and
// `guard` hard-stops pathological growth (a legitimate program nests HOF splices far shallower).
mono_close* = (a: MutPtr<Malloc>, decls: [Decl], from: i64, guard: i32) [Decl] {
    idx := a.build_decl_index(decls)
    exp := a.mono_rec(decls, idx, from)
    (exp.len == decls.len || guard >= 16).match ({
        true  => exp,
        false => {
            eidx := a.build_decl_index(exp)
            buf := cbuf<Decl>(a, exp.len)
            exp.loop((h, i, d) {
                buf[i] = (i < decls.len).match ({
                    true  => d,
                    false => a.inline_decl(exp, eidx, a.resolve_decl(exp, eidx, d)),
                })
            })
            a.mono_close(buf, decls.len, guard + 1)
        },
    })
}
// ── M1b: lift a NON-CAPTURING lambda LITERAL in a value position to a top-level function ──────────
// A lambda stored in a struct field or returned can't be inline-spliced; lift its body to a generated
// top-level fn (params typed from the expected FnT) and replace the literal with the fn name (a fn
// value, M1). A CAPTURING lambda (one that references an enclosing local) is NOT lifted — it falls
// through to the clean error[lambda-value] (real captures need the M2 env/lifetime design).
// capture analysis: does this lambda body reference a FREE variable — a name that is neither one of the
// lambda's params, a binder introduced inside the body, a top-level fn/global, nor true/false? Such a
// name is a captured enclosing local. `bound` threads the in-scope binder names (scope-correct).
field_fnt* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, sty: string_view, targs: [Ty], fname: string_view) Ty {
    (targs.len > 0).match ({
        true  => idx.idx_genstruct_field(a, decls, sty, fname, targs),
        false => idx.idx_struct_field(decls, sty, fname),
    })
}
// generate the top-level fn for a lifted lambda: params typed from the expected FnT, body = lambda body.
lower_closures* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex) [Decl] {
    ccp: RawPtr<u8> := a.acquire(8)
    store_i64(ccp, 0)
    gen := cbuf<Decl>(a, 4096)
    out := cbuf<Decl>(a, decls.len + 4096)
    decls.loop((h, i, d) {
        out[i] = d.match ({
            .DFunc(f) => a.clos_lowerable(decls, idx, f).match ({
                true  => a.clos_lower_func(ccp, gen, f),
                false => d,
            }),
            _         => d,
        })
    })
    n := load_i64(ccp) * 2
    k := decls.len
    gen.loop((h, i, g) {
        (i < n.to_i32()).then({
            out[k] = g
            k = k + 1
        })
    })
    slice(out.ptr, k)
}
