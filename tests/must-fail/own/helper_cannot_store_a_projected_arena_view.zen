Input = { text: str }
Box = { text :: str }
put = (box :: Box, input: Input) () { box.text = input.text; }
bad = (env: Env, box :: Box) Res<(), AllocError> {
    a    = env.mem.alloc();
    text = a.String("dangling").try();
    put(box, Input(text: text.view()));
    Ok(())
}
main = (env: Env) Res<(), AllocError> {
    box ::= Box(text: "");
    bad(env, box).try();
    println(box.text);
    Ok(())
}
