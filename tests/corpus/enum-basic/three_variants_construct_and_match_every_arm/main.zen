// THREE VARIANTS, PAYLOADS AT BOTH ENDS, A BARE NULLARY BETWEEN THEM.
// `Mix` exercises the whole construction surface a nominal enum has:
// two qualified payload calls and one qualified nullary, each matched
// back out by name. Tags follow DECLARATION ORDER (DESIGN.md: a nominal
// enum "is numbered by declaration order"), so First is 0 and Last is 2
// -- building Last but stamping First's tag still compiles, and the
// match then hands back First's uninitialised union member: a plausible
// number from nowhere, which is why the printed payloads and not a
// diagnostic are the pin.
//
// write_variant_call finds the Case BY NAME (`find_case`,
// gen_c_member.zen) and write_case_value stamps `.zg_tag` plus
// `.zg_data.<that member>`; resolving the case by position instead
// makes every construction here a First, and `gap` goes quiet.

Mix = First(i64) | Gap | Last(i64)

main = (env: Env) Res<i32, AllocError> {
    a: Mix = Mix.First(111111111);
    g: Mix = Mix.Gap;
    l: Mix = Mix.Last(222222222);
    a.match({
        First(v) => println("first {} x3 {}", v, v * 3),
        Gap      => println("gap"),
        Last(v)  => println("last {}", v),
    });
    g.match({
        First(v) => println("first {} x3 {}", v, v * 3),
        Gap      => println("gap"),
        Last(v)  => println("last {}", v),
    });
    l.match({
        First(v) => println("first {} x3 {}", v, v * 3),
        Gap      => println("gap"),
        Last(v)  => println("last {}", v),
    });
    Ok(0);
}
