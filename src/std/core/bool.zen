// Ordinal of a bool: true → 0, false → 1 (the two-state index).
ord* = (b: bool) i32 { b.match ({ true => 0, false => 1 }) }
// Run a side effect only when the receiver is true. Value-producing decisions still use `.match`;
// `then` is deliberately void so a missing false branch cannot silently invent a value.
then* = (condition: bool, action: () void) void {
    condition.then({
        action()
    })
}
