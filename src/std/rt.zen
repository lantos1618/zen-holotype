// Ambient runtime: a process default plus a per-thread override.
{ Allocator, heap_allocator, allocator_dispatch_acquire, allocator_dispatch_resize,
  allocator_dispatch_release } = std.mem.alloc
{ panic } = std.core.result
// `ready == 0` marks an uninitialized worker-local slot.
Rt*: {
    mem: Allocator,
    ready: i64,
    allocator = (r: Rt) Allocator { r.mem }
}
// Heap-backed runtime with no backend state.
heap_rt* = () Rt {
    Rt(
        mem: heap_allocator(),
        ready: 1,
    )
}
// The allocator state and vtable must outlive the runtime.
mem_rt* = (mem: Allocator) Rt {
    Rt(
        mem: mem,
        ready: 1,
    )
}
// Unset worker-local slots inherit this process-wide default.
default_rt ::= heap_rt()
// Monotonic startup guard: set_default is rejected after the first spawn.
spawned ::= 0
default* = () Rt { default_rt }
set_default* = (custom: Rt) void {
    (spawned == 0).match ({
        true  => {
            default_rt = custom
            rt_slot = custom
        },
        false => panic("rt.set_default must be called before spawning any thread or actor"),
    })
}
// Called before thread or actor creation; idempotent.
mark_spawned* = () void { spawned = 1 }
rt_slot ::= thread_local(heap_rt())
current* = () Rt { (rt_slot.ready == 0).then({ default() }, { rt_slot }) }
// Rebind the current thread for the dynamic extent of body.
with*<R> = (custom: Rt, body: () R) R {
    saved = rt_slot
    rt_slot = custom
    out = body()
    rt_slot = saved
    out
}
// Closure-free save/set/restore hooks for actor dispatch.
enter* = (custom: Rt) Rt {
    saved = rt_slot
    rt_slot = custom
    saved
}
leave* = (saved: Rt) void { rt_slot = saved }
// Read the current runtime once per allocation operation.
alloc* = (n: i64) RawPtr<u8> {
    a = current().allocator()
    allocator_dispatch_acquire(a, n)
}
resize* = (p: RawPtr<u8>, n: i64) RawPtr<u8> {
    a = current().allocator()
    allocator_dispatch_resize(a, p, n)
}
release* = (p: RawPtr<u8>) void {
    a = current().allocator()
    allocator_dispatch_release(a, p)
}
