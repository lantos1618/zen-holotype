// collisions with the C standard library rather than with the C language.
//
// two halves, because they fail in two different places:
//
// FIELDS — the object-like MACROS. `NULL`, `EOF`, `errno`, `stdin`,
// `stdout`, `stderr`, `INT_MAX`, `SIZE_MAX` are macros, and the
// preprocessor does not care that the token sits after a dot. An unmangled
// member named `errno` emits `m.errno`, glibc rewrites it to
// `m.(*__errno_location ())`, and the resulting diagnostic points at a
// construct nobody wrote. Struct members live in their own C namespace, so
// a mangler that only guards top-level symbols passes every other test in
// this directory and fails this one. `FILE` and `size_t` are typedefs
// rather than macros and are here for the same reason one level down.
//
// BINDINGS — the FUNCTION names. These are legal C identifiers, so nothing
// rejects them; they collide at declaration (shadowing a libc prototype
// already pulled in by a header gen_c included) or at link time (two
// external definitions of `read`). `index`, `div`, `time`, `remove`,
// `link`, `stat` are the ones that read as ordinary variable names, and
// `y0`, `y1`, `j0`, `j1`, `gamma` from <math.h> are the famous ones — `y1`
// has broken more builds than `register` has.
//
// whether a Zen module-level function even HAS external linkage in the
// emitted C is unspecified; whole-program compilation makes `static` the
// obvious answer, which kills the link-time half and leaves the
// declaration-shadowing half. Either way the mangler decides, not luck.

Macros = {
    NULL: i32,
    EOF: i32,
    errno: i32,
    stdin: i32,
    stdout: i32,
    stderr: i32,
    assert: i32,
    offsetof: i32,
    INT_MAX: i32,
    SIZE_MAX: i32,
    FILE: i32,
    size_t: i32
}

main = (env: Env) Res<i32, AllocError> {
    m = Macros(
        NULL: 1,
        EOF: 2,
        errno: 3,
        stdin: 4,
        stdout: 5,
        stderr: 6,
        assert: 7,
        offsetof: 8,
        INT_MAX: 9,
        SIZE_MAX: 10,
        FILE: 11,
        size_t: 12
    );

    fields ::= 0;
    fields = fields + m.NULL;
    fields = fields + m.EOF;
    fields = fields + m.errno;
    fields = fields + m.stdin;
    fields = fields + m.stdout;
    fields = fields + m.stderr;
    fields = fields + m.assert;
    fields = fields + m.offsetof;
    fields = fields + m.INT_MAX;
    fields = fields + m.SIZE_MAX;
    fields = fields + m.FILE;
    fields = fields + m.size_t;

    malloc  = 1;
    free    = 2;
    calloc  = 3;
    realloc = 4;
    exit    = 5;
    abort   = 6;
    printf  = 7;
    puts    = 8;
    memcpy  = 9;
    memset  = 10;
    strlen  = 11;
    strcmp  = 12;
    open    = 13;
    close   = 14;
    read    = 15;
    write   = 16;
    remove  = 17;
    link    = 18;
    stat    = 19;
    time    = 20;
    clock   = 21;
    signal  = 22;
    div     = 23;
    index   = 24;
    y0      = 25;
    y1      = 26;
    j0      = 27;
    j1      = 28;
    gamma   = 29;

    fns ::= 0;
    fns = fns + malloc;
    fns = fns + free;
    fns = fns + calloc;
    fns = fns + realloc;
    fns = fns + exit;
    fns = fns + abort;
    fns = fns + printf;
    fns = fns + puts;
    fns = fns + memcpy;
    fns = fns + memset;
    fns = fns + strlen;
    fns = fns + strcmp;
    fns = fns + open;
    fns = fns + close;
    fns = fns + read;
    fns = fns + write;
    fns = fns + remove;
    fns = fns + link;
    fns = fns + stat;
    fns = fns + time;
    fns = fns + clock;
    fns = fns + signal;
    fns = fns + div;
    fns = fns + index;
    fns = fns + y0;
    fns = fns + y1;
    fns = fns + j0;
    fns = fns + j1;
    fns = fns + gamma;

    println("libc {} {}", fields, fns);
    Ok(0);
}
