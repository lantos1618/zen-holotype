// `[i32, 4](2, 3, 5, 7)` is a TYPE applied to arguments, not a
// two-element array literal followed by a call. `[0, 1, 2]` in the
// same file is an ordinary literal, inferred [i32, 3]. the reading is
// chosen by what the elements ARE, which is the ambiguity PLAN.md 0.1
// names.

main = (env: Env) Res<i32, ArgError> {
    primes = [i32, 4](2, 3, 5, 7);
    small = [0, 1, 2];
    println("{}", primes[3]);
    println("{}", small[0]);
    Ok(0);
}
