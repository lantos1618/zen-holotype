// M4 SLICE 2'S GATE, THE VIA-META HALF (`docs/design_meta.md` §7, M4
// slice 2): `@meta(name: T).fields().loop((h, field) { .. })` UNROLLS at
// sema time — the body is checked once per field of T — and lowers as
// one ordinary block per field. Inside the body `field.name` folds to
// the pass's field name as a comptime `str`, and the instance
// projection `recv.at(field)` stays RESIDUAL: rewritten to the ordinary
// `recv.<name>`, runtime code the backend always knew how to write.
// `h` answers `break()` and `next()` and nothing else.
//
// The by_hand twin writes the same program with every field spelled
// out; the two share one byte-identical oracle, which is the claim the
// slice makes: the walk IS the spelling, once per field.
//
// MUTATION RESISTANCE (§6.4): every line names its field out loud
// beside a distinct non-default value of a distinct type, so a skipped,
// transposed or repeated pass moves text, not just numbers; `count`
// asserts the fold beside the walk; `kept`/`seen` pin `h.next()` and
// `h.break()` (a walk whose handle verbs no-op prints `tag` twice
// more); and the two `box.v` lines pin the per-instantiation answer of
// one generic body — a memo that let `Box<i64>` answer for `Box<str>`
// prints `box.v=41` twice, with the second line's hole typed `i64`.

Row = {
    n: i64,
    flag: bool,
    tag: str,

    show* = (self: @Self) () {
        @meta(self: @Self).fields().loop((h, field) {
            println("{}={}", field.name, self.at(field));
        });
    },

    skip_tag* = (self: @Self) () {
        @meta(self: @Self).fields().loop((h, field) {
            field.name.eq("tag").then(() { h.next(); });
            println("kept {}", field.name);
        });
    },

    stop_at_flag* = (self: @Self) () {
        @meta(self: @Self).fields().loop((h, field) {
            field.name.eq("flag").then(() { h.break(); });
            println("seen {}", field.name);
        });
    },
}

Box<T> = {
    v: T,

    show* = (self: @Self) () {
        @meta(self: @Self).fields().loop((h, field) {
            println("box.{}={}", field.name, self.at(field));
        });
    },
}

describe* = (r: Row) () {
    @meta(row: Row).fields().loop((h, field) {
        println("[{}] {}", field.name, r.at(field));
    });
}

main = (env: Env) Res<i32, AllocError> {
    r = Row(n: 17, flag: true, tag: "qy");
    r.show();
    describe(r);
    r.skip_tag();
    r.stop_at_flag();
    println("count {}", @meta(row: Row).fields().len);
    Box<i64>(v: 41).show();
    Box<str>(v: "hi").show();
    Ok(0);
}
