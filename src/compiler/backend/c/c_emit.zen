// compiler.backend.c.c_emit — C emission driver over the genc AST: type-dependency ordering, module
// assembly, and the genC / genModule entry points. Pipeline: genc -> mono -> c_emit.
// Value/statement emission lives in compiler.backend.c.c_lit (integers/literals/escapes),
// compiler.backend.c.c_expr (expressions/match/statements), and compiler.backend.c.c_decl (types/sigs/decls).
{ String } = std.text.string
{ ends_with } = std.text.str
{ Decl, EnumDecl, Expr, StructDecl, Ty } = compiler.ast.ast_types
{ cbuf, ty_cname_in, gstr_string, gstr_append } = compiler.genc
{ monomorphize } = compiler.mono
{ Malloc } = std.mem.alloc
{ slice_any } = compiler.astops
{ emit_is_trait, gen_decl, gen_fnt_typedefs, gen_fwd, gen_proto, impld_set, main_is_sys } = compiler.backend.c.c_decl
{ Map } = std.collections.map
{ gen_expr } = compiler.backend.c.c_expr
{ slx_classify } = compiler.backend.c.c_escape
// Type dependency ordering: by-value contained types must emit before their users.
maxi = (a: i32, b: i32) i32 { (a >= b).then({ a }, { b }) }
slen = (decls: [Decl]) i32 {
    n := 0
    decls.loop((h, i, d) {
        n = n + 1
    })
    n
}
is_type_named = (d: Decl, name: StringView) bool {
    d.match ({
        .DStruct(sd) => sd.name == name,
        .DEnum(ed)   => ed.name == name,
        _            => false,
    })
}
// Depth memo: -1 unvisited, -2 on-stack, >=0 memoized depth.
DepthMemo: {
    d: i32,
}
ty_idx = (decls: [Decl], name: StringView) i32 {
    found := 0 - 1
    decls.loop((h, i, d) {
        found = is_type_named(d, name).then({ i }, { found })
    })
    found
}
slot_depth = (decls: [Decl], cache: [DepthMemo], t: Ty) i32 {
    t.match ({
        .Named(n)   => 1 + decls.idx_depth(cache, decls.ty_idx(n)),
        .Generic(g) => 1 + decls.idx_depth(cache, decls.ty_idx(g.mangled)),
        _           => 0,
    })
}
struct_depth = (decls: [Decl], cache: [DepthMemo], sd: StructDecl) i32 {
    d := 0
    sd.fields.loop((h, i, f) {
        d = maxi(d, decls.slot_depth(cache, f.ty))
    })
    d
}
enum_depth = (decls: [Decl], cache: [DepthMemo], ed: EnumDecl) i32 {
    d := 0
    ed.variants.loop((h, i, v) {
        d = maxi(d, decls.slot_depth(cache, v.payload))
    })
    d
}
decl_body_depth = (decls: [Decl], cache: [DepthMemo], d: Decl) i32 {
    d.match ({
        .DStruct(sd) => decls.struct_depth(cache, sd),
        .DEnum(ed)   => decls.enum_depth(cache, ed),
        _            => 0,
    })
}
compute_idx_depth = (decls: [Decl], cache: [DepthMemo], idx: i32) i32 {
    cache[idx] = DepthMemo(d: 0 - 2)
    r := decls.decl_body_depth(cache, decls[idx])
    cache[idx] = DepthMemo(d: r)
    r
}
idx_depth = (decls: [Decl], cache: [DepthMemo], idx: i32) i32 {
    (idx < 0).match ({
        true  => 0,
        false => (cache[idx].d >= 0).match ({
            true  => cache[idx].d,
            false => (cache[idx].d == 0 - 2).then({ 0 }, { decls.compute_idx_depth(cache, idx) }),
        }),
    })
}
depth_cache = (a: MutPtr<Malloc>, decls: [Decl]) [DepthMemo] {
    c := cbuf<DepthMemo>(a, decls.slen())
    c.loop((h, i, x) {
        c[i] = DepthMemo(d: 0 - 1)
    })
    c
}
gen_types_at = (
    s: String,
    alloc: MutPtr<Malloc>,
    decls: [Decl],
    impld: Map<i64>,
    cache: [DepthMemo],
    k: i32,
) String {
    out := s
    decls.loop((h, i, d) {
        d.match ({
            .DStruct(sd) => (impld.emit_is_trait(d) == false).then({
                (decls.idx_depth(cache, i) == k).then({
                    out = out.gen_decl(alloc, d).gstr_append(alloc, " ")
                })
            }),
            .DEnum(ed)   => (decls.idx_depth(cache, i) == k).then({
                out = out.gen_decl(alloc, d).gstr_append(alloc, " ")
            }),
            _            => { },
        })
    })
    out
}
gen_types_upto = (
    s: String,
    alloc: MutPtr<Malloc>,
    decls: [Decl],
    impld: Map<i64>,
    cache: [DepthMemo],
    k: i32,
    n: i32,
) String {
    out := s
    (k < n).then({
        out = out.gen_types_at(alloc, decls, impld, cache, k)
        out = out.gen_types_upto(alloc, decls, impld, cache, k + 1, n)
    })
    out
}
gen_funcs = (s: String, alloc: MutPtr<Malloc>, decls: [Decl]) String {
    out := s
    decls.loop((h, i, d) {
        (d.is_template() == false).then({
            d.match ({
                .DFunc(f) => {
                    out = out.gen_decl(alloc, d).gstr_append(alloc, " ")
                },
                .DRaw(c)  => {
                    out = out.gen_decl(alloc, d).gstr_append(alloc, " ")
                },
                _         => { },
            })
        })
    })
    out
}
// Constant globals can initialize statically; other globals are assigned in zen__init_globals.
is_const_init = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Int(n)       => true,
        .Byte(b)      => true,
        .FloatLit(ft) => true,
        .StrLit(t)    => true,
        // `/` and `%` lower to a statement-expression (the div/mod guard), which is NOT a constant
        // expression — a `static T g = ({…})` global init is invalid C. Force those to runtime init.
        .Bin(b)       => (b.op == "/" || b.op == "%").match ({
            true  => false,
            false => b.lhs.is_const_init() && b.rhs.is_const_init(),
        }),
        .Call(c)      => c.fn == "null_ptr",
        _             => false,
    })
}
gen_global = (s: String, alloc: MutPtr<Malloc>, d: Decl) String {
    out := s
    d.match ({
        .DGlobal(g) => {
            stor := g.tl.then({ "static _Thread_local " }, { "static " })
            g.init.is_const_init().match ({
                true  => {
                    out = out
                        .gstr_append(alloc, stor)
                        .gstr_append(alloc, alloc.ty_cname_in(g.ty))
                        .gstr_append(alloc, " ")
                        .gstr_append(alloc, g.name)
                        .gstr_append(alloc, " = ")
                        .gen_expr(alloc, g.init)
                        .gstr_append(alloc, "; ")
                },
                false => {
                    out = out
                        .gstr_append(alloc, stor)
                        .gstr_append(alloc, alloc.ty_cname_in(g.ty))
                        .gstr_append(alloc, " ")
                        .gstr_append(alloc, g.name)
                        .gstr_append(alloc, "; ")
                },
            })
        },
        _           => { },
    })
    out
}
gen_global_inits = (s: String, alloc: MutPtr<Malloc>, decls: [Decl]) String {
    out := s.gstr_append(alloc, "static void zen__init_globals(void) { ")
    decls.loop((h, i, d) {
        d.match ({
            .DGlobal(g) => (g.init.is_const_init() == false).then({
                out = out
                    .gstr_append(alloc, g.name)
                    .gstr_append(alloc, " = ")
                    .gen_expr(alloc, g.init)
                    .gstr_append(alloc, "; ")
            }),
            _           => { },
        })
    })
    out.gstr_append(alloc, "} ")
}
// The `main = (sys: Sys) i32` capability entry, if the program has one. Its body is emitted as
// `zen_user_main` (see gen_func); a niladic `zen_main` trampoline feeds it `root()`.
has_sys_main = (decls: [Decl]) bool {
    decls.slice_any((d) {
        d.match ({
            .DFunc(f) => f.main_is_sys(),
            _         => false,
        })
    })
}
// The C name of std.sys.root's `root()` capability builder. A brace-import (`{ Sys } = std.sys.root`) keeps it
// bare `root`; a namespace alias (`sys = std.sys.root`) renames every value decl of the module under an
// `<alias>__` prefix, so it becomes e.g. `sys__root`. Identify it STRUCTURALLY — a 0-param fn returning
// the record `Sys`, whose name is `root` or ends `__root` — so the trampoline calls the actual emitted
// name in both forms. Falls back to bare `root`.
sys_root_cname = (decls: [Decl]) StringView {
    nm := "root"
    decls.loop((h, i, d) {
        nm = d.match ({
            .DFunc(f) => (f.params.len == 0
                && f.ret.match ({
                    .Named(t) => t == "Sys",
                    _         => false,
                })
                && (f.name == "root" || f.name.ends_with("__root"))).match ({
                true  => f.name,
                false => nm,
            }),
            _         => nm,
        })
    })
    nm
}
// Host platform floor is generated with every C module. The source of truth stays in Zen's
// backend, not handwritten zenrt.c; public std.sys.platform wraps these stable integer values.
platform_prelude = () StringView {
    "/* generated host platform */\nstatic int32_t zen_platform_host_os(void){\n#if defined(__APPLE__)\nreturn 1;\n#elif defined(__linux__)\nreturn 2;\n#elif defined(_WIN32)\nreturn 3;\n#elif defined(__FreeBSD__)\nreturn 4;\n#else\nreturn 0;\n#endif\n}\nstatic int32_t zen_platform_host_arch(void){\n#if defined(__aarch64__) || defined(_M_ARM64)\nreturn 1;\n#elif defined(__x86_64__) || defined(_M_X64)\nreturn 2;\n#elif defined(__riscv) && __riscv_xlen == 64\nreturn 3;\n#elif defined(__wasm32__)\nreturn 4;\n#else\nreturn 0;\n#endif\n}\nstatic int32_t zen_platform_host_abi(void){\n#if defined(__APPLE__)\nreturn 1;\n#elif defined(__linux__) && defined(__GLIBC__)\nreturn 2;\n#elif defined(__linux__)\nreturn 3;\n#elif defined(_MSC_VER)\nreturn 4;\n#elif defined(__wasi__)\nreturn 5;\n#else\nreturn 0;\n#endif\n}\n"
}
// Whole translation unit emission.
genModuleIn* = (a: MutPtr<Malloc>, raw: [Decl]) String {
    decls := a.monomorphize(raw)
    a.slx_classify(decls)    // slice-literal escape verdicts, read by gen_call_args below
    // zslice is the EXACT leading HEAD; zfn (fn pointers, A2) and the malloc/memcpy prototypes follow so
    // heap-promoted slice literals (gen_slicelit) link in standalone programs that don't import std.mem
    // (types match std.mem/std.string foreign decls — compatible redecl).
    s := a
        .gstr_string(4096)
        .gstr_append(a, "typedef struct { void* ptr; int64_t len; } zslice; typedef void (*zfn)(void); uint8_t* malloc(int64_t); uint8_t* memcpy(uint8_t*, uint8_t*, int64_t); void abort(void); int64_t write(int32_t, uint8_t*, int64_t); __attribute__((weak)) void __zen_panic_unwind(void){ } static void zen__panic(const char* m){ int64_t n=0; while(m[n]){ n=n+1; } write(2,(uint8_t*)m,n); __zen_panic_unwind(); abort(); } static int64_t zen__divz(int64_t a, int64_t b){ if(b==0){ zen__panic(\"zen: panic: integer divide by zero\\n\"); } if(b==-1 && a==(-9223372036854775807LL-1)){ zen__panic(\"zen: panic: integer division overflow\\n\"); } return a/b; } static int32_t zen__divz32(int32_t a, int32_t b){ if(b==0){ zen__panic(\"zen: panic: integer divide by zero\\n\"); } if(b==-1 && a==(-2147483647-1)){ zen__panic(\"zen: panic: integer division overflow\\n\"); } return a/b; } static int64_t zen__modz(int64_t a, int64_t b){ if(b==0){ zen__panic(\"zen: panic: integer modulo by zero\\n\"); } if(b==-1){ return 0; } return a%b; } static uint64_t zen__udivz(uint64_t a, uint64_t b){ if(b==0){ zen__panic(\"zen: panic: integer divide by zero\\n\"); } return a/b; } static uint64_t zen__umodz(uint64_t a, uint64_t b){ if(b==0){ zen__panic(\"zen: panic: integer modulo by zero\\n\"); } return a%b; } static uint8_t* zen__idx(zslice z, int64_t i, int64_t esz){ if(i<0 || i>=z.len){ zen__panic(\"zen: panic: slice index out of bounds\\n\"); } return (uint8_t*)z.ptr + i*esz; } static uint8_t* zen__salloc(int64_t n){ uint8_t* p = malloc(n); if(!p){ zen__panic(\"zen: panic: out of memory\\n\"); } return p; }")
        .gstr_append(a, platform_prelude())
    impld := a.impld_set(decls)
    decls.loop((h, i, d) {
        s = s.gen_fwd(a, impld, d)
    })
    s = s.gen_fnt_typedefs(a, decls)
    decls.loop((h, i, d) {
        s = s.gen_proto(a, d)
    })
    s = s.gen_types_upto(a, decls, impld, a.depth_cache(decls), 0, slen(decls))
    decls.loop((h, i, d) {
        s = s.gen_global(a, d)
    })
    s = s.gen_global_inits(a, decls)
    out := s.gen_funcs(a, decls)
    // Append the niladic `zen_main` trampoline for the `main = (sys: Sys) i32` entry (its user body was
    // emitted as `zen_user_main`). Named here — not in gen_func — so `root` resolves to its real C name
    // even when std.sys.root was reached through a namespace alias (`sys__root`).
    has_sys_main(decls).match ({
        true  => out
            .gstr_append(a, " int32_t zen_main(void){ zen__init_globals(); return zen_user_main(")
            .gstr_append(a, sys_root_cname(decls))
            .gstr_append(a, "()); }"),
        false => out,
    })
}
