// an inner block is its own frame: p and q drop at the INNER closing
// brace, before the outer block runs another line. a backend that
// flattened blocks into one function-wide list would hold both to the
// end and print "mid ... drop 3 drop 2" at the bottom instead — a
// plausible-looking program that just releases late.
//
// the interleaved prints make the TIMING observable, not just the order:
// `mid` sits strictly between the inner drops and outer b's.

Noisy = {
    env: Env,
    id: i32,
}

Noisy.impl(Drop, {
    drop = (self :: @Self) () { self.env.out.println("drop {}", self.id) }
})

main = (env: Env) Res<i32, IoError> {
    a = Noisy(env: env, id: 1);
    {
        p = Noisy(env: env, id: 2);
        q = Noisy(env: env, id: 3);
        println("inner body");
    }
    println("mid");
    b = Noisy(env: env, id: 4);
    println("outer end");
    Ok(0);
}
