// probeAU: generic recursion returning T itself (identity-ish), two types,
// plus mutual generic pair over struct T -- the forward_types shape but
// with type parameters and a value that must survive each hop
Box2 = {
    v: i64,
}

pass_g = <T>(x: T, n: i64) i64 {
    (n == 0).match({
        true  => 0,
        false => 1 + take_g(x, n - 1),
    });
}

take_g = <T>(x: T, n: i64) i64 {
    (n == 0).match({
        true  => 0,
        false => 10 + pass_g(x, n - 1),
    });
}

main = (env: Env) Res<i32, AllocError> {
    println("g {}", pass_g(Box2(v: 5), 4));
    Ok(0);
}
