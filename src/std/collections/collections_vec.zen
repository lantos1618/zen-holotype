// src/std/collections/collections_vec.zen
// Vec<T>: the growable buffer everything else is built on. everything
// here is sealed (=) — collections are not extension points, and
// sealed methods compile to direct, inlinable calls

Alloc, AllocError, Ptr, null_ptr = std.mem
Range = std.core.range

Vec*<T> = {
    // an empty Vec owns no pages: null data + zero capacity ARE the
    // empty state, and realloc treats a null p as a fresh allocation,
    // so the first grow runs the same call every later one does
    data :: Ptr<T> = null_ptr<T>(),
    len* :: usize = 0,      // * is readable outside; mutation still only via methods
    capacity :: usize = 0,

    // `:` set once at construction: an Alloc is a handle (two words
    // into the arena), so grow can realloc THROUGH it while the field
    // itself stays immutable — `::` is shallow, hence this.
    alloc: Alloc,

    // grow lands in THIS frame, never inside a closure: the match is a
    // value, `.try()` on it belongs to add, so a failed grow returns
    // Err from add and cannot fall through to the write below
    add* = (self :: @Self, value: T) Res<(), AllocError> {
        (self.len == self.capacity).match({
            true  => self.grow(),
            false => Ok(()),
        }).try();
        self.data.write(self.len, value);
        self.len = self.len + 1;
        Ok(());
    }

    get* = (self: @Self, i: usize) Res<T> {
        (i < self.len).match({
            true  => Ok(self.data.read(i)),
            false => None,
        });
    }

    // THE DOOR ONTO THE RAW FLOOR, and the one export of the storage
    // other collections never make: `Ptr.read`/`write` are unchecked —
    // bounds are the caller's to hold, nothing traps (mem_ptr.zen) —
    // so this is raw-floor access spelled in plain sight at every call
    // site. Its two in-std callers both need it: String.view builds a
    // `str` over another module's storage, and Stdin.read's spare-
    // capacity fill hands the C floor the buffer itself.
    ptr* = (self: @Self) Ptr<T> { self.data }

    // dual of get, what a Map overwrites a row through. past len is
    // None exactly as get is.
    set* = (self :: @Self, i: usize, value: T) Res<()> {
        (i < self.len).match({
            true  => { self.data.write(i, value); Ok(()) },
            false => None,
        });
    }

    // moves an element OUT, leaving the vec one shorter — without this
    // a Vec<T> of Drop values can be filled and never emptied
    //
    // the return CONSUMES `value`: a plain `Ok(value)` would copy the
    // bytes into the payload and leave `value` registered for drop in
    // this frame, so a Drop T dies here before the caller ever sees it
    // — twice, once the caller's copy drops too. sema cannot catch it
    // (T is unknown here, and the rule fails open on generics), so the
    // move has to be spelled.
    take* = (self :: @Self, i: usize) Res<T> {
        value = self.get(i).try();
        Range(i + 1, self.len).loop((h, j) {
            self.data.write(j - 1, self.data.read(j));
        });
        self.len = self.len - 1;
        Ok(consume value);
    }

    // room for `n` MORE elements, before anything writes them. Exists
    // because a CAPABILITY'S FLOOR fills a run this module did not
    // allocate: `Stdin.read` (std.env) hands the C floor the buffer's
    // spare capacity and reads into it, so the room must exist BEFORE
    // the call. Every other filler goes through `add` and needs none
    // of this. Asks for DOUBLE requested so a chunked stream reader
    // reallocs a logarithmic, not linear, number of times.
    reserve* = (self :: @Self, n: usize) Res<(), AllocError> {
        want = self.len + n;
        (want <= self.capacity).match({
            true  => Ok(()),
            false => self.reallocate(want * 2),
        })
    }

    grow = (self :: @Self) Res<(), AllocError> {
        self.reallocate((self.capacity == 0).match({
            true  => 8,
            false => self.capacity * 2,
        }))
    }

    reallocate = (self :: @Self, cap: usize) Res<(), AllocError> {
        self.data     = self.alloc.realloc(self.data, cap).try();
        self.capacity = cap;
        Ok(());
    }
}

// a Vec IS a Range of its elements — `get` already answers exactly
// what `at` asks, None-past-end included, which is what stops a walk
// rather than reading past the buffer.
//
// start/end are SUPPLIED, not stored (DESIGN.md: satisfy requirements,
// never impl storage), so a Vec growing mid-loop reports its new end,
// not a stale one.
Vec.impl(Range<T>, {
    start: 0,
    end: self.len,

    at ::= (self: @Self, index: usize) Res<T> { self.get(index) }
})

// `alloc.Vec<i32>()`: ufcs constructor, lives beside Vec (not on
// Alloc) since only this module sees data/capacity. a bare value, not a
// Res: an empty Vec owns no pages so construction can't fail — the
// first add allocates, and THAT is what returns Res
Vec* = <T>(a: Alloc) Vec<T> {
    Vec(alloc: a)
}
