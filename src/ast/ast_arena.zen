// src/ast/ast_arena.zen
// Where nodes live.
//
// One `Ast` per compilation. It owns four arenas — expressions, types,
// patterns and blocks — plus the modules and every piece of trivia in
// source order, and it is the only thing that turns an id back into a
// node.
//
// Declarations, members, arms, arguments, parameters, variants and
// statements are NOT arenas: each is held by value inside its parent's
// `Vec`, because none of them closes a cycle. Only the four families
// below are mutually recursive, so only they need naming apart from
// holding.
//
// Everything here allocates through one `Alloc` and says so. The AST
// of a compilation is the longest-lived thing the compiler builds, so
// the arena it comes from is the arena that outlives every phase —
// dropping it frees the whole tree at once, which is the trade an
// arena exists to make.

Alloc, AllocError = std.mem
Trivia, TriviaRun, no_trivia = ast.ast_span
ExprId, TypeId, PatternId, BlockId = ast.ast_id
Expr, Type, Pattern, Block, Module = ast.ast_node

Ast* = {
    modules :: Vec<Module>,
    exprs :: Vec<Expr>,
    types :: Vec<Type>,
    patterns :: Vec<Pattern>,
    blocks :: Vec<Block>,

    // every comment and blank in the compilation, in source order. A
    // node names a contiguous run of it rather than owning a list, and
    // the formatter can walk this to prove it dropped nothing.
    trivia :: Vec<Trivia>,

    // The id space. An id is a u32 (ast_id.zen says why) and a Vec's
    // len is a usize, and std.core.num carries no narrowing conversion
    // between them — on purpose, since a narrowing conversion can
    // fail. So the count is kept as the id it will become. `add_expr`
    // is the one place that keeps a counter and its arena equal.
    expr_count :: u32 = 0,
    type_count :: u32 = 0,
    pattern_count :: u32 = 0,
    block_count :: u32 = 0,

    alloc: Alloc,

    // -----------------------------------------------------------------
    // adding
    //
    // A node is added once and never mutated: an id handed out stays
    // pointing at the same node forever, which is what makes it a
    // legal key for a memoized query. A transformation builds a new
    // node and gets a new id.
    // -----------------------------------------------------------------

    add_expr* = (self :: @Self, node: Expr) Res<ExprId, AllocError> {
        id = ExprId(index: self.expr_count);
        self.exprs.add(node).try();
        self.expr_count = self.expr_count + 1;
        Ok(id);
    }

    add_type* = (self :: @Self, node: Type) Res<TypeId, AllocError> {
        id = TypeId(index: self.type_count);
        self.types.add(node).try();
        self.type_count = self.type_count + 1;
        Ok(id);
    }

    add_pattern* = (self :: @Self, node: Pattern) Res<PatternId, AllocError> {
        id = PatternId(index: self.pattern_count);
        self.patterns.add(node).try();
        self.pattern_count = self.pattern_count + 1;
        Ok(id);
    }

    add_block* = (self :: @Self, node: Block) Res<BlockId, AllocError> {
        id = BlockId(index: self.block_count);
        self.blocks.add(node).try();
        self.block_count = self.block_count + 1;
        Ok(id);
    }

    add_module* = (self :: @Self, node: Module) Res<(), AllocError> {
        self.modules.add(node)
    }

    // -----------------------------------------------------------------
    // reading
    //
    // These TRAP rather than returning `Res`, and that is the failure
    // model rather than a shortcut: an id past the end of its arena is
    // a compiler bug, not input a caller can act on, and routing it
    // through `Res` would put `.try()` on every child access in the
    // tree and destroy the signal that makes `.try()` readable.
    //
    // The bounds check IS the subtraction: `len - i - 1` underflows for
    // every i >= len, and unsigned underflow traps. No branch, and
    // nothing to forget. std.text.text_str's `index` is the same
    // idiom, one layer down.
    // -----------------------------------------------------------------

    expr_at* = (self: @Self, id: ExprId) Expr {
        i = id.index.to_usize();
        self.exprs.len - i - 1;
        self.exprs.ptr().read(i);
    }

    type_at* = (self: @Self, id: TypeId) Type {
        i = id.index.to_usize();
        self.types.len - i - 1;
        self.types.ptr().read(i);
    }

    pattern_at* = (self: @Self, id: PatternId) Pattern {
        i = id.index.to_usize();
        self.patterns.len - i - 1;
        self.patterns.ptr().read(i);
    }

    block_at* = (self: @Self, id: BlockId) Block {
        i = id.index.to_usize();
        self.blocks.len - i - 1;
        self.blocks.ptr().read(i);
    }

    module_count* = (self: @Self) usize { self.modules.len }

    module_at* = (self: @Self, i: usize) Res<Module> { self.modules.get(i) }

    // -----------------------------------------------------------------
    // trivia
    //
    // The protocol is four calls, and it exists because a run has to be
    // contiguous: take a `mark`, add every piece the lexer produced,
    // then close the run. A node's leading run is what the lexer
    // gathered before its first token; its trailing run is what
    // followed its last token up to the newline.
    // -----------------------------------------------------------------

    trivia_mark* = (self: @Self) usize { self.trivia.len }

    add_trivia* = (self :: @Self, item: Trivia) Res<(), AllocError> {
        self.trivia.add(item)
    }

    trivia_run* = (self: @Self, mark: usize) TriviaRun {
        TriviaRun(at: mark, len: self.trivia.len - mark)
    }

    // `i` is an offset INSIDE the run, so a caller walks
    // `Range(0, run.len)` and never sees an absolute index. Out of
    // range traps, for the same reason the node readers do.
    trivia_at* = (self: @Self, run: TriviaRun, i: usize) Trivia {
        run.len - i - 1;
        self.trivia.ptr().read(run.at + i);
    }
}

// `alloc.Ast()` — a ufcs function whose first parameter is an Alloc,
// beside the type it builds, exactly as `Vec` and `Map` are. A bare
// value and not a `Res`: an empty arena owns no pages, so construction
// cannot fail, and the first `add_` is what returns one.
Ast* = (a: Alloc) Ast {
    Ast(
        modules: a.Vec<Module>(),
        exprs: a.Vec<Expr>(),
        types: a.Vec<Type>(),
        patterns: a.Vec<Pattern>(),
        blocks: a.Vec<Block>(),
        trivia: a.Vec<Trivia>(),
        alloc: a,
    )
}
