// src/sema/sema_own.zen
// Who owns a value.
//
// PLAN.md stage 3; DESIGN.md's Ownership section is the law. This file
// covers UNIQUENESS — `consume` is the only move, a moved place is dead,
// a partial move may not reach the drop. Siblings cover write access
// (`sema_recv.zen`), block lifetime (`sema_scope.zen`), and copyability
// (`sema_drop.zen`); all four are driven from here, the file with the
// walk.
//
// A flow walk, not a memoized query, since "was this binding already
// moved out of" is a fact about the PATH to the node. Runs once per
// body, after typing, and never computes a type: by then the
// block-local bindings typing put in `Checker.locals` are released, so
// `type_of` on a name node would report a false undefined name. Types
// come only from `Checker.expr_memo` or `OwnVar.ty`; missing either, the
// rule does not fire.
//
// Fails open: a false rejection makes a correct program uncompilable,
// so an unresolved lookup answers "no opinion".
//
// Tracks a place, not an expression — `consume p.left` is tracked,
// `consume bufs[0]` is refused, since an element index is a runtime
// value and "which element is dead" is not a fact the compiler holds.
//
// Join = "consumed if consumed anywhere": match arms are alternative
// paths from the pre-match state, so two arms consuming one binding is
// not a double move. A closure body joins the same way through a call,
// which is why `.then` is not opaque here.

Expr, ExprId, Block, BlockId, Stmt, Bind = std.ast
Decl, Member, Function, Param = std.ast
Call, Arg, Access, Match, Arm, Lambda, Index, Consume = std.ast
Span, Name, Paren, Try, Unary, Binary = std.ast
Record, FixedArray, Field, Const = std.ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId = sema.sema_ty
Checker, Ctx = sema.sema_check
SemaFault, NameFault = sema.sema_diag
check_receiver, check_write_place = sema.sema_recv
check_scope_returned, check_scope_stored = sema.sema_scope
check_scope_captured, is_scope_value, call_escapes = sema.sema_scope
check_arena_returned, is_arena_backed = sema.sema_scope
Pin, pin_captured, refuse_pinned, refuse_pinned_at = sema.sema_pin
check_drop_copy = sema.sema_drop

// One name this frame can see, and what the ownership rules know of it.
// `owned` ("this frame constructed the value") separates `consume
// p.left` from `consume env.argv` — local vs. borrowed. `ty` is
// recorded rather than asked for (see header). `scoped` marks a binding
// that names a block, so capturing it is a capture of the block.
// `arena` marks a binding whose value is, or is backed by, an arena
// this frame made — the provenance half of `sema_scope.zen`'s escape
// rule, recorded here because only the walk knows what a name meant
// where it was written.
OwnVar* = {
    name*: str,
    ty*: TyId,
    mutable*: bool,
    owned*: bool,
    scoped*: bool,
    arena*: bool,
    span*: Span,
}

// A place that has been moved out of: a binding, or one of its fields.
//
// `root` is an index into `Own.vars`, not a name, so shadowing costs
// nothing. `field` is empty for the whole binding. `span` is where the
// move was written — what a loop's back edge reports against.
Place* = {
    root*: usize,
    field*: str,
    span*: Span,
}

// The walk's state: a stack with marks, like `Checker.locals`. `escaped`
// is one more mark: how many bindings were visible outside the
// innermost escaping closure body, zero when in none. `pinned` holds
// what an escaping closure captured — the rule is `sema_pin.zen`'s;
// this file only carries its state. `method` names
// the method this body belongs to, or is empty — a refusal at `self`
// (whose `::` goes on the METHOD, not the binding) prints it instead.
Own* = {
    vars :: Vec<OwnVar>,
    dead :: Vec<Place>,
    pinned* :: Vec<Pin>,
    escaped* :: usize,
    method* :: str,
    body* :: BlockId,
    alloc*: Alloc,
}

Own* = (a: Alloc) Res<Own, AllocError> {
    Ok(Own(
        vars: a.Vec<OwnVar>(),
        dead: a.Vec<Place>(),
        pinned: a.Vec<Pin>(),
        escaped: 0,
        method: "",
        body: BlockId(index: 0),
        alloc: a
    ));
}

// ---------------------------------------------------------------------
// the entry points
// ---------------------------------------------------------------------

// One function body. Called from `sema_decl.zen` while parameters are
// still bound — the only moment a parameter's declared type and
// mutability can be read back without re-deriving them.
check_own* = (c :: Checker, f: Function, body: BlockId, ctx: Ctx)
             Res<(), AllocError> {
    o ::= c.alloc.Own().try();
    o.method = receiver_method(f, ctx);
    o.body   = body;
    c.own_params(o, f).try();
    c.own_block(o, body, ctx).try();
    c.check_scope_returned(body).try();
    Ok(());
}

// The method this body belongs to, when its first parameter is the
// receiver. Empty for a top-level function, where a parameter named
// `self` is an ordinary borrow — calling it is not a dot.
receiver_method = (f: Function, ctx: Ctx) str {
    (ctx.has_self && first_param_is_self(f)).match({
        true  => f.name.text,
        false => "",
    })
}

first_param_is_self = (f: Function) bool {
    f.params.get(0).match({
        None  => false,
        Ok(p) => p.name.text.eq("self"),
    })
}

// A parameter is a borrow: the caller still owns it, so nothing may be
// moved out through it, and `mutable` is the `::` the declaration wrote.
// `scoped: false` even for `s: Scope` — the one shape the capture rule
// does not see, see `sema_scope.zen`.
own_params = (c :: Checker, o :: Own, f: Function) Res<(), AllocError> {
    f.params.loop((h, p) { c.own_param(o, p).try() });
    Ok(());
}

own_param = (c :: Checker, o :: Own, p: Param) Res<(), AllocError> {
    text = p.name.text;
    ty   = c.lookup(text).match({ Ok(b) => b.ty, None => UNTYPED });
    o.vars.add(OwnVar(
        name: text,
        ty: ty,
        mutable: p.mutable,
        owned: false,
        scoped: false,
        arena: false,
        span: p.name.span
    ))
}

// ---------------------------------------------------------------------
// the walk
// ---------------------------------------------------------------------

own_block = (c :: Checker, o :: Own, id: BlockId, ctx: Ctx)
            Res<(), AllocError> {
    b    = c.tree.block_at(id);
    mark = o.vars.len;
    b.stmts.loop((h, s) { c.own_stmt(o, s, ctx).try() });
    b.value.match({
        Ok(v) => c.own_expr(o, v, ctx),
        None  => Ok(()),
    }).try();
    c.check_arena_returned(o, id, b).try();
    c.check_partial_moves(o, mark).try();
    own_release(o, mark).try();
    Ok(());
}

own_stmt = (c :: Checker, o :: Own, s: Stmt, ctx: Ctx) Res<(), AllocError> {
    s.kind.match({
        Bind(b)  => c.own_bind(o, b, ctx),
        Expr(e)  => c.own_expr(o, e.expr, ctx),
        Block(x) => c.own_block(o, x, ctx),
        Decl(_)  => Ok(()),
    })
}

// The value is read before the target is written: `f = consume f` reads
// a live `f` and leaves a dead one.
own_bind = (c :: Checker, o :: Own, b: Bind, ctx: Ctx) Res<(), AllocError> {
    c.own_expr(o, b.value, ctx).try();
    c.check_drop_copy(o, b, ctx).try();
    c.own_target(o, b, ctx).try();
    Ok(());
}

// A binding target is a name the frame now owns, or a place written
// back into. A write to a place moved out of REVIVES it, filling the
// hole. It is also checked against `sema_recv.zen`'s marker rule here,
// since this walk knows a target from a value; a bare name is not
// passed to it, since `n = 1` is a fresh binding or an assignment
// depending on scope — a question only this file can answer.
own_target = (c :: Checker, o :: Own, b: Bind, ctx: Ctx)
             Res<(), AllocError> {
    node = c.tree.expr_at(b.target);
    c.check_write_place(o, b.target).try();
    node.kind.match({
        Name(n)   => bind_name(c, o, b, n.text, node.span, ctx),
        Access(a) => c.revive_field(o, a, ctx),
        _         => c.own_expr(o, b.target, ctx),
    })
}

// A name already in scope is an assignment; one that isn't is a new
// binding. Zen spells both `x = e;`, so which one it is is a question
// about scope, not syntax.
bind_name = (
    c    :: Checker,
    o    :: Own,
    b    : Bind,
    text : str,
    span : Span,
    ctx  : Ctx
) Res<(), AllocError> {
    find_var(o, text).match({
        Ok(i) => revive(o, i, ""),
        None  => c.declare_var(o, b, text, span, ctx),
    })
}

declare_var = (
    c    :: Checker,
    o    :: Own,
    b    : Bind,
    text : str,
    span : Span,
    ctx  : Ctx
) Res<(), AllocError> {
    o.vars.add(OwnVar(
        name: text,
        ty: c.memo_type(b.value),
        mutable: b.mutable,
        owned: true,
        scoped: c.is_scope_value(b.value),
        arena: c.is_arena_backed(o, b.value),
        span: span
    ))
}

revive_field = (c :: Checker, o :: Own, a: Access, ctx: Ctx)
               Res<(), AllocError> {
    c.path_root(o, a.base).match({
        None  => Ok(()),
        Ok(i) => revive(o, i, a.name.text),
    }).try();
    c.own_expr(o, a.base, ctx).try();
    Ok(());
}

own_expr = (c :: Checker, o :: Own, id: ExprId, ctx: Ctx)
           Res<(), AllocError> {
    node = c.tree.expr_at(id);
    node.kind.match({
        Name(n)       => c.use_name(o, node, n.text),
        Access(a)     => c.use_access(o, node, a, ctx),
        Consume(x)    => c.own_consume(o, x, ctx),
        Call(k)       => c.own_call(o, id, k, ctx),
        Match(m)      => c.own_match(o, m, ctx),
        Lambda(l)     => c.own_lambda(o, l, ctx, false, false),
        Block(b)      => c.own_block(o, b, ctx),
        Paren(p)      => c.own_expr(o, p.inner, ctx),
        Try(t)        => c.own_expr(o, t.operand, ctx),
        Unary(u)      => c.own_expr(o, u.operand, ctx),
        Binary(bi)    => c.own_pair(o, bi.lhs, bi.rhs, ctx),
        Index(x)      => c.own_pair(o, x.base, x.index, ctx),
        Array(a)      => c.own_elems(o, a.elems, ctx),
        FixedArray(a) => c.own_elems(o, a.elems, ctx),
        Record(r)     => c.own_record(o, r.entries, ctx),
        _             => Ok(()),
    })
}

own_pair = (c :: Checker, o :: Own, a: ExprId, b: ExprId, ctx: Ctx)
           Res<(), AllocError> {
    c.own_expr(o, a, ctx).try();
    c.own_expr(o, b, ctx).try();
    Ok(());
}

own_elems = (c :: Checker, o :: Own, elems: Vec<ExprId>, ctx: Ctx)
            Res<(), AllocError> {
    elems.loop((h, e) { c.own_expr(o, e, ctx).try() });
    Ok(());
}

own_record = (c :: Checker, o :: Own, entries: Vec<Member>, ctx: Ctx)
             Res<(), AllocError> {
    entries.loop((h, m) { c.own_member_value(o, m, ctx).try() });
    Ok(());
}

own_member_value = (c :: Checker, o :: Own, m: Member, ctx: Ctx)
                   Res<(), AllocError> {
    m.kind.match({
        Field(f)    => c.opt_expr(o, f.value, ctx),
        Const(k)    => c.own_expr(o, k.value, ctx),
        Function(_) => Ok(()),
    })
}

opt_expr = (c :: Checker, o :: Own, e: Res<ExprId>, ctx: Ctx)
           Res<(), AllocError> {
    e.match({ Ok(x) => c.own_expr(o, x, ctx), None => Ok(()) })
}

// ---------------------------------------------------------------------
// RULE: a place that was moved out of is dead
// ---------------------------------------------------------------------

use_name = (c :: Checker, o :: Own, node: Expr, text: str)
           Res<(), AllocError> {
    c.check_scope_captured(o, node.span, text).try();
    c.pin_captured(o, node, text).try();
    find_var(o, text).match({
        None  => Ok(()),
        Ok(i) => c.report_if_dead(o, node.span, i, ""),
    })
}

// `p.left` is a place of its own; `p.right` beside it is untouched, so
// the field is checked before the base. Reaching the base too is what
// makes `f.id` report `f` after `consume f`.
use_access = (c :: Checker, o :: Own, node: Expr, a: Access, ctx: Ctx)
             Res<(), AllocError> {
    c.path_root(o, a.base).match({
        None  => Ok(()),
        Ok(i) => c.report_if_dead(o, node.span, i, a.name.text),
    }).try();
    c.own_expr(o, a.base, ctx).try();
    Ok(());
}

report_if_dead = (
    c     :: Checker,
    o     :: Own,
    span  : Span,
    root  : usize,
    field : str
) Res<(), AllocError> {
    is_dead(o, root, field).match({
        false => Ok(()),
        true  => c.report_consumed(o, span, root, field),
    })
}

report_consumed = (
    c     :: Checker,
    o     :: Own,
    span  : Span,
    root  : usize,
    field : str
) Res<(), AllocError> {
    name = c.place_name(o, root, field).try();
    c.report(span.file, span, SemaFault.ConsumedUse(NameFault(name: name)))
}

// ---------------------------------------------------------------------
// RULE: `consume` moves, and only a place this frame owns can move
// ---------------------------------------------------------------------

own_consume = (c :: Checker, o :: Own, x: Consume, ctx: Ctx)
              Res<(), AllocError> {
    node = c.tree.expr_at(x.operand);
    node.kind.match({
        Index(_)  => c.refuse(
            node.span,
            SemaFault.ConsumeNotAPlace(NameFault(name: ""))
        ),
        Name(n)   => c.consume_name(o, node, n.text),
        Access(a) => c.consume_field(o, node, a, ctx),
        _         => c.own_expr(o, x.operand, ctx),
    })
}

// The move is a USE first: a second `consume` of one binding is just
// another use of a dead name, and it reports where it is written. A
// capture by an escaping body is the one use source order cannot see,
// so it is asked here rather than left to `use_name`.
consume_name = (c :: Checker, o :: Own, node: Expr, text: str)
               Res<(), AllocError> {
    c.use_name(o, node, text).try();
    c.refuse_pinned(o, node.span, text).try();
    find_var(o, text).match({
        None  => Ok(()),
        Ok(i) => kill(o, i, "", node.span),
    }).try();
    Ok(());
}

consume_field = (c :: Checker, o :: Own, node: Expr, a: Access, ctx: Ctx)
                Res<(), AllocError> {
    c.path_root(o, a.base).match({
        None  => c.own_expr(o, a.base, ctx),
        Ok(i) => c.consume_field_of(o, node, a, i),
    })
}

// Only what this frame owns may move. A handle is two words a bitwise
// copy duplicates — moving out of one would leave every other copy
// holding a dead value, with no single binding to mark dead.
consume_field_of = (
    c    :: Checker,
    o    :: Own,
    node : Expr,
    a    : Access,
    root : usize
) Res<(), AllocError> {
    owned_at(o, root).match({
        false => c.refuse(
            node.span,
            SemaFault.ConsumeThroughHandle(NameFault(name: a.name.text))
        ),
        true  => c.kill_field(o, node, a, root),
    })
}

kill_field = (c :: Checker, o :: Own, node: Expr, a: Access, root: usize)
             Res<(), AllocError> {
    c.report_if_dead(o, node.span, root, a.name.text).try();
    c.refuse_pinned_at(o, node.span, root).try();
    kill(o, root, a.name.text, node.span).try();
    Ok(());
}

// ---------------------------------------------------------------------
// RULE: a partial move may not reach the drop
//
// Drop runs on the whole binding at scope exit, and a moved-out field
// isn't there to drop. The diagnostic points at the binding, not the
// move, because "move the whole value or none of it" is the fix.
// ---------------------------------------------------------------------

check_partial_moves = (c :: Checker, o :: Own, mark: usize)
                      Res<(), AllocError> {
    Range(mark, o.vars.len).loop((h, i) {
        c.check_partial_move(o, i).try();
    });
    Ok(());
}

check_partial_move = (c :: Checker, o :: Own, i: usize)
                     Res<(), AllocError> {
    (has_dead_field(o, i) && (is_dead(o, i, "") == false)).match({
        false => Ok(()),
        true  => c.report_partial(o, i),
    })
}

report_partial = (c :: Checker, o :: Own, i: usize) Res<(), AllocError> {
    o.vars.get(i).match({
        None  => Ok(()),
        Ok(v) => c.report(
            v.span.file,
            v.span,
            SemaFault.PartiallyMoved(NameFault(name: v.name))
        ),
    })
}

has_dead_field = (o: Own, root: usize) bool {
    Range(0, o.dead.len).find((i) {
        o.dead.get(i).match({
            Ok(p) => (p.root == root) && (p.field.len > 0),
            None  => false,
        })
    }).match({ Ok(_) => true, None => false })
}

// ---------------------------------------------------------------------
// calls: the receiver rule, `@scope` as an argument, and closure bodies
// ---------------------------------------------------------------------

own_call = (c :: Checker, o :: Own, id: ExprId, k: Call, ctx: Ctx)
           Res<(), AllocError> {
    c.check_receiver(o, k, ctx).try();
    c.check_scope_stored(id, k).try();
    c.own_expr(o, k.callee, ctx).try();
    c.own_args(o, k, ctx).try();
    Ok(());
}

// A lambda argument is a path, not an opaque value: its body may or may
// not run, so it joins like a match arm, and unless it is `.then` it may
// run again, so a move of anything declared outside it is a move the
// second iteration finds already made. It may also outlive the call,
// per `call_escapes`.
own_args = (c :: Checker, o :: Own, k: Call, ctx: Ctx)
           Res<(), AllocError> {
    repeats = c.repeating_body(k);
    escapes = c.call_escapes(o, k);
    k.args.loop((h, a) { c.own_arg(o, a, repeats, escapes, ctx).try() });
    Ok(());
}

own_arg = (
    c       :: Checker,
    o       :: Own,
    a       : Arg,
    repeats : bool,
    escapes : bool,
    ctx     : Ctx
) Res<(), AllocError> {
    node = c.tree.expr_at(a.value);
    node.kind.match({
        Lambda(l) => c.own_lambda(o, l, ctx, repeats, escapes),
        _         => c.own_expr(o, a.value, ctx),
    })
}

repeating_body = (c :: Checker, k: Call) bool {
    c.tree.expr_at(k.callee).kind.match({
        Access(a) => a.name.text.eq("then") == false,
        _         => true,
    })
}

// Walked once from the state at the call; what it moved is reported (a
// repeated body reaching its own back edge) or kept, dead on some path
// is dead. An escaping body also marks what was visible outside it,
// restoring the mark on exit; nested inside another escaping body it
// keeps the OUTER mark, since a name the outer body may not capture is
// closed to the inner one too.
own_lambda = (
    c       :: Checker,
    o       :: Own,
    l       : Lambda,
    ctx     : Ctx,
    repeats : bool,
    escapes : bool
) Res<(), AllocError> {
    dmark     = o.dead.len;
    vmark     = o.vars.len;
    outer     = o.escaped;
    o.escaped = (escapes && (outer == 0)).match({
        false => outer,
        true  => vmark,
    });
    l.params.loop((h, p) { c.own_param(o, p).try() });
    c.own_block(o, l.body, ctx).try();
    o.escaped = outer;
    own_release(o, vmark).try();
    repeats.then(() { c.report_back_edge(o, dmark).try() });
    Ok(());
}

// Everything moved inside the body that outlives it names a binding the
// body did not declare — `own_release` already dropped the ones it did.
report_back_edge = (c :: Checker, o :: Own, dmark: usize)
                   Res<(), AllocError> {
    Range(dmark, o.dead.len).loop((h, i) {
        c.report_moved_again(o, i).try();
    });
    Ok(());
}

report_moved_again = (c :: Checker, o :: Own, i: usize)
                     Res<(), AllocError> {
    o.dead.get(i).match({
        None  => Ok(()),
        Ok(p) => c.report_consumed(o, p.span, p.root, p.field),
    })
}

// ---------------------------------------------------------------------
// match: alternative paths, joined
// ---------------------------------------------------------------------

own_match = (c :: Checker, o :: Own, m: Match, ctx: Ctx)
            Res<(), AllocError> {
    c.own_expr(o, m.scrutinee, ctx).try();
    dmark = o.dead.len;
    joined ::= c.alloc.Vec<Place>();
    m.arms.loop((h, a) { c.own_arm(o, a, dmark, joined, ctx).try() });
    joined.loop((h, p) { o.dead.add(p).try() });
    Ok(());
}

// Each arm starts from the state before the match — a sequential walk
// would get this wrong, treating two arms that each consume one binding
// as two moves rather than one move on either path.
own_arm = (
    c      :: Checker,
    o      :: Own,
    a      : Arm,
    dmark  : usize,
    joined :: Vec<Place>,
    ctx    : Ctx
) Res<(), AllocError> {
    c.own_expr(o, a.body, ctx).try();
    take_dead(o, dmark, joined).try();
    Ok(());
}

take_dead = (o :: Own, mark: usize, out :: Vec<Place>)
            Res<(), AllocError> {
    extra = o.dead.len - mark;
    Range(0, extra).loop((h, i) {
        o.dead.take(o.dead.len - 1).match({
            Ok(p) => out.add(p).try(),
            None  => (),
        });
    });
    Ok(());
}

// ---------------------------------------------------------------------
// the state, and the two ways a type reaches this file
// ---------------------------------------------------------------------

// The innermost binding of a name, by index, walking from the top so an
// inner scope shadows an outer one.
find_var* = (o: Own, text: str) Res<usize> {
    n = o.vars.len;
    Range(0, n).find((k) {
        o.vars.get(n - k - 1).match({
            Ok(v) => v.name.eq(text),
            None  => false,
        })
    }).match({
        None  => None,
        Ok(k) => Ok(n - k - 1),
    })
}

// The binding a place path is rooted at, or nothing when the path is not
// one this frame names.
path_root* = (c :: Checker, o :: Own, id: ExprId) Res<usize> {
    node = c.tree.expr_at(id);
    node.kind.match({
        Name(n)   => find_var(o, n.text),
        Paren(p)  => c.path_root(o, p.inner),
        Access(a) => c.path_root(o, a.base),
        _         => None,
    })
}

// Whether a write through this name is permitted at all. Lives here,
// not beside the receiver rule that asks it, because it reads
// `Own.vars`. A name this frame does not bind is a global or a
// constant, and the rule has no opinion — the fail-open direction.
var_mutable* = (o: Own, text: str) bool {
    find_var(o, text).match({
        None  => true,
        Ok(i) => o.vars.get(i).match({ Ok(v) => v.mutable, None => true }),
    })
}

// Whether naming this here is an escaping body reaching out for a block
// — the state half of `sema_scope.zen`'s third rule. An index below the
// mark was declared outside the escaping body; zero ("in no escaping
// body") needs no special case, since no index is below zero.
captures_scope* = (o: Own, text: str) bool {
    find_var(o, text).match({
        None  => false,
        Ok(i) => (i < o.escaped) && scoped_at(o, i),
    })
}

// Whether this name is, or views into, an arena this frame made — read
// by `sema_scope.zen`'s escape rule, which owns the walk that sets it.
arena_var* = (o: Own, text: str) bool {
    find_var(o, text).match({
        None  => false,
        Ok(i) => o.vars.get(i).match({ Ok(v) => v.arena, None => false }),
    })
}

scoped_at = (o: Own, i: usize) bool {
    o.vars.get(i).match({ Ok(v) => v.scoped, None => false })
}

owned_at* = (o: Own, root: usize) bool {
    o.vars.get(root).match({ Ok(v) => v.owned, None => false })
}

is_dead = (o: Own, root: usize, field: str) bool {
    Range(0, o.dead.len).find((i) {
        o.dead.get(i).match({
            Ok(p) => (p.root == root) && p.field.eq(field),
            None  => false,
        })
    }).match({ Ok(_) => true, None => false })
}

kill = (o :: Own, root: usize, field: str, span: Span)
       Res<(), AllocError> {
    o.dead.add(Place(root: root, field: field, span: span))
}

// A write fills the hole. Implemented as a rebuild rather than a removal
// because `Vec` has no remove and order in this list means nothing.
revive = (o :: Own, root: usize, field: str) Res<(), AllocError> {
    kept ::= o.alloc.Vec<Place>();
    o.dead.loop((h, p) { keep_other(p, root, field, kept).try() });
    take_all(o).try();
    kept.loop((h, p) { o.dead.add(p).try() });
    Ok(());
}

keep_other = (p: Place, root: usize, field: str, kept :: Vec<Place>)
             Res<(), AllocError> {
    ((p.root == root) && p.field.eq(field)).match({
        true  => Ok(()),
        false => kept.add(p),
    })
}

take_all = (o :: Own) Res<(), AllocError> {
    n = o.dead.len;
    Range(0, n).loop((h, i) { o.dead.take(o.dead.len - 1); });
    Ok(());
}

// Leaving a scope drops its bindings and everything said about them: a
// place whose root is gone is not a place any more, and leaving the row
// behind would let a later binding inherit its index and its death.
// A pin of the same shape: the capture died with the body that made it.
own_release = (o :: Own, mark: usize) Res<(), AllocError> {
    kept ::= o.alloc.Vec<Place>();
    o.dead.loop((h, p) { keep_below(p, mark, kept).try() });
    take_all(o).try();
    kept.loop((h, p) { o.dead.add(p).try() });
    kept_pins ::= o.alloc.Vec<Pin>();
    o.pinned.loop((h, p) { keep_pin(p, mark, kept_pins).try() });
    take_all_pins(o).try();
    kept_pins.loop((h, p) { o.pinned.add(p).try() });
    extra = o.vars.len - mark;
    Range(0, extra).loop((h, i) { o.vars.take(o.vars.len - 1); });
    Ok(());
}

keep_below = (p: Place, mark: usize, kept :: Vec<Place>)
             Res<(), AllocError> {
    (p.root < mark).match({ false => Ok(()), true => kept.add(p) })
}

keep_pin = (p: Pin, mark: usize, kept :: Vec<Pin>) Res<(), AllocError> {
    (p.root < mark).match({ false => Ok(()), true => kept.add(p) })
}

take_all_pins = (o :: Own) Res<(), AllocError> {
    n = o.pinned.len;
    Range(0, n).loop((h, i) { o.pinned.take(o.pinned.len - 1); });
    Ok(());
}

// `p.left`, joined, because that is the place the author wrote and the
// only spelling that tells them which half of `p` is gone.
place_name* = (c :: Checker, o :: Own, root: usize, field: str)
             Res<str, AllocError> {
    base = o.vars.get(root).match({ Ok(v) => v.name, None => "" });
    (field.len == 0).match({
        true  => Ok(base),
        false => c.dotted_name(base, field),
    })
}

dotted_name = (c :: Checker, base: str, field: str) Res<str, AllocError> {
    out ::= c.alloc.String("{base}.{field}").try();
    Ok(out.view());
}

// What typing already decided, and nothing more. A miss is not a reason
// to compute one: see the header — a type computed here would resolve
// names against a scope this walk has already left.
memo_type = (c :: Checker, id: ExprId) TyId {
    c.expr_memo.get(id).match({ Ok(ty) => ty, None => UNTYPED })
}

// A place's type: recorded for a name, memoized for everything else.
place_type* = (c :: Checker, o :: Own, id: ExprId) TyId {
    node = c.tree.expr_at(id);
    node.kind.match({
        Name(n)  => var_type(o, n.text),
        Paren(p) => c.place_type(o, p.inner),
        _        => c.memo_type(id),
    })
}

var_type* = (o: Own, text: str) TyId {
    find_var(o, text).match({
        None  => UNTYPED,
        Ok(i) => o.vars.get(i).match({ Ok(v) => v.ty, None => UNTYPED }),
    })
}

// The `TyId` that stands for "this file was never told" — index 0, the
// first type the store's construction order interns; nothing reads it
// as a type, only as the answer that turns every rule above off.
UNTYPED* : TyId = TyId(index: 0)

refuse* = (c :: Checker, span: Span, fault: SemaFault) Res<(), AllocError> {
    c.report(span.file, span, fault)
}
