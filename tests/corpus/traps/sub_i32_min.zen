// tests/corpus/traps/sub_i32_min.zen
// i32.MIN - 1 traps. - is the checked operator, -% is the
// wrapping one

// main must name an error type. a trap never lifts into Res:
// it aborts the process
Error =
    Overflow,
    DivideByZero,
    OutOfBounds

main = (env: Env) Res<i32, Error> {
    x: i32 = i32.MIN;
    diff = x - 1;
    println("{}", diff);
    Ok(0);
}
