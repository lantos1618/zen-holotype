// The widening intrinsics double as BOUNDS (std.core.num): one behavior
// per target, so a generic function can name "widens to u32" instead of
// listing the types it accepts. Every call below must pick the ARGUMENT
// type's own conversion through the bound — a u8 and a u16 both reach
// the u32 conversion, but by their own impls. The fields are widen_*:
// a field named to_u32 would collide with the free function on every
// DIRECT call (num.zen says why). The f64 line compares rather than
// prints, because {}'s digit count is deliberately unspecified
// (lex/number_float_basics.zen).

as_u32 = <T: ToU32>(x: T) u32 { x.widen_u32() }
as_i64 = <T: ToI64>(x: T) i64 { x.widen_i64() }
as_usize = <T: ToUsize>(x: T) usize { x.widen_usize() }
as_f64 = <T: ToF64>(x: T) f64 { x.widen_f64() }

same = (a: f64, b: f64) str {
    (a == b).match({
        true  => "yes",
        false => "no",
    });
}

main = (env: Env) Res<i32, AllocError> {
    a: u8 = 7;
    b: u16 = 300;
    c: i8 = -4;
    big: u32 = 4000000000;   // past i32.MAX: lossless or wrong
    d: i32 = 2;
    e: f32 = 1.5;
    println("{}", as_u32(a));
    println("{}", as_u32(b));
    println("{}", as_i64(c));
    println("{}", as_i64(big));
    println("{}", as_usize(big));
    println("{}", same(as_f64(d) + as_f64(e), 3.5));
    Ok(0);
}
