// src/gen/gen_c/gen_c_member.zen
// What a call through a DOT is.
//
// `gen_c_call.zen` owns `f(a)`; this file owns `x.f(a)`, which DESIGN.md
// makes three readings of one rule — "a method is a UFCS function whose
// first parameter happens to be named `self`". `Shape.Circle(c)` is a
// VARIANT (a payload variant IS the function that builds one),
// `s.is_empty()` a MEMBER the receiver's type declares, `v.push(x)` a
// FREE FUNCTION whose first parameter is the receiver's type —
// "importing a type pulls its world along ... exported ufcs functions".
//
// SEMA ALREADY DECIDES BETWEEN THEM and this file asks — `base_of`,
// `members_of` — rather than re-deciding. The one answer it cannot read
// back is WHICH DECLARATION a call resolved to (`Cand` carries a
// signature and no `DeclId`), so `pick_member` re-derives it from the
// AST by calling `recv_sig_fits`, THE CHECKER'S OWN predicate: the seam
// is narrowed, not closed — the two can disagree about inputs, not
// about the rule. Closing it means `call_memo` keying a `MemberId`
// (`sema_id.zen` already names one) rather than a `DeclId`, which
// cannot name a member.
//
// A MEMBER FUNCTION IS AN ORDINARY FUNCTION with the receiver as its
// first parameter, and its symbol is `sym_fn`'s rule with the type's
// qualified name as one more segment — what makes two types' `get` two
// symbols without a counter. WHAT THIS FILE REFUSES it refuses BY NAME:
// a `GenFault` with a position, never C that compiles but means
// something else.

ExprId, Decl, Struct, Member = std.ast
Function, Param, Access, Call, Arg = std.ast
Lambda = std.ast
AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
DeclId = sema.sema_id
TyId, TyNamed, TyFn, Prim = sema.sema_ty
Def, decl_at = sema.sema_def
Ctx = sema.sema_check
Inst = sema.sema_inst
Found, base_of, members_of, member_named, self_ctx = sema.sema_member
Actual = sema.sema_call
recv_sig_fits, ty_at, tail_swallows = sema.sema_cand
Case, cases_of, find_case = sema.sema_case
is_case = sema.sema_match
module_of, sym_fn, sym_member, sym_variant = gen.gen_name
CBackend, MethodRef = gen.gen_c.gen_c_state
unsupported, unresolved = gen.gen_c.gen_c_report
sub_with, any_open, recv_inst, inst_open = gen.gen_c.gen_c_mono
enter_struct_tparams, leave_tparams = gen.gen_c.gen_c_mono
ctype, is_unit = gen.gen_c.gen_c_type
expr, ty_of, want_of = gen.gen_c.gen_c_expr
lower_plain_call, write_arg, write_call_args = gen.gen_c.gen_c_call
handle_depth, lower_handle_call = gen.gen_c.gen_c_handle
inlines, inline_method = gen.gen_c.gen_c_inline
is_ptr_member, lower_ptr_member = gen.gen_c.gen_c_ptr
lower_create = gen.gen_c.gen_c_alloc
is_capability, lower_capability = gen.gen_c.gen_c_cap
is_fat = gen.gen_c.gen_c_fat
lower_fat_call = gen.gen_c.gen_c_bound
lower_assoc_call = gen.gen_c.gen_c_assoc
sink_door_shape, lower_member_door = gen.gen_c.gen_c_sink
is_floor_door, lower_floor_door = gen.gen_c.gen_c_floor
by_arity, bodied_fn, impl_member, kept_or_arity = gen.gen_c.gen_c_impl
has_body = gen.gen_c.gen_c_impl
impl_member_at = gen.gen_c.gen_c_impl
alias_of = gen.gen_c.gen_c_impl

// -----------------------------------------------------------------
// the entry point
// -----------------------------------------------------------------

// THE CALL SITE, as one value: `id`, `c` and `a` are produced together
// by the parser, wanted by every lowering below and changed by none, so
// three parameters on twenty signatures said what one says.
Dot = {
    id: ExprId,
    c: Call,
    a: Access,
}

// A LOOP HANDLE IS ASKED ABOUT FIRST, for the reason `gen_c_handle.zen`
// gives: `h` is not a value, so `h.break(v)` is recognised at the NAME
// and never resolved through a receiver's type.
lower_dot_call* = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    depth = handle_depth(be, a.base);
    (depth > 0).match({
        true  => lower_handle_call(be, id, c, a, depth, ctx, out),
        false => lower_resolved_dot(be, Dot(id: id, c: c, a: a), ctx, out),
    })
}

lower_resolved_dot = (be :: CBackend, d: Dot, ctx: Ctx, out :: String)
                     Res<(), AllocError> {
    b = be.check.base_of(d.a.base, ctx).try();
    b.is_type.match({
        true  => lower_static_call(be, d, b.ty, ctx, out),
        false => lower_receiver_call(be, d, ctx, out),
    })
}

// -----------------------------------------------------------------
// `Shape.Circle(c)` — a variant that carries a payload
//
// "A nullary variant IS a value of the enum; one carrying a payload is
// the function that builds one" — `Slot.Left(cell)` is an ordinary
// call, not a second construction form, so this writes the compound
// literal `gen_c_expr.zen` writes for a bare variant plus the payload.
//
// A NAME THAT IS NOT A VARIANT IS `gen_c_assoc.zen`'S — a struct body
// may bind a function too (`Duration.seconds(2)`) — and it answers
// `false` when nothing of that name wants no receiver, so the refusal
// is reported here: one diagnostic for one mistake.
// -----------------------------------------------------------------

lower_static_call = (be :: CBackend, d: Dot, ty: TyId, ctx: Ctx, out :: String)
                    Res<(), AllocError> {
    be.check.is_case(ty, d.a.name.text).try().match({
        true  => write_variant_call(be, d, ty, ctx, out),
        false => static_member_call(be, d, ty, ctx, out),
    })
}

static_member_call = (be :: CBackend, d: Dot, ty: TyId, ctx: Ctx, out :: String)
                     Res<(), AllocError> {
    lower_assoc_call(be, d.id, d.c, d.a, ty, ctx, out).try().match({
        true  => Ok(()),
        false => unsupported(
            be,
            d.id,
            "a call on a type that is not a variant",
            out
        ),
    })
}

write_variant_call = (be :: CBackend, d: Dot, ty: TyId, ctx: Ctx, out :: String)
                     Res<(), AllocError> {
    cases ::= be.alloc.Vec<Case>();
    be.check.cases_of(ty, cases).try();
    find_case(cases, d.a.name.text).match({
        None   => unresolved(be, d.id, d.a.name.text, out),
        Ok(cs) => write_case_value(be, d.c, ty, cs, ctx, out),
    })
}

// A unit payload takes no member: a void member is illegal C, which is
// the same rule `Ok(())` obeys.
write_case_value = (
    be  :: CBackend,
    c   : Call,
    ty  : TyId,
    cs  : Case,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    qname ::= be.alloc.String().try();
    type_qname(be, ty, qname).try();
    cty ::= be.alloc.String().try();
    ctype(be, ty, cty).try();
    out.fmt("({}){ .zg_tag = ", cty.view()).try();
    out.sym_variant(qname.view(), cs.name).try();
    no_payload(be, c, cs).match({
        true  => Ok(()),
        false => write_payload_arg(be, c, cs, ctx, out),
    }).try();
    out.add_bytes(" }").try();
    Ok(());
}

no_payload = (be :: CBackend, c: Call, cs: Case) bool {
    (cs.has_payload == false) || is_unit(be, cs.payload) || (c.args.len == 0)
}

write_payload_arg = (be :: CBackend, c: Call, cs: Case, ctx: Ctx, out :: String)
                    Res<(), AllocError> {
    out.add_bytes(", .zg_data.").try();
    out.sym_member(cs.name).try();
    out.add_bytes(" = ").try();
    c.args.get(0).match({
        None  => out.add_bytes("0"),
        Ok(a) => expr(be, a.value, ctx, cs.payload, out),
    })
}

// -----------------------------------------------------------------
// `x.f(a)` — a value receiver
//
// The receiver's OWN declaration first, then what an impl supplies,
// then a free function reached through the dot. The first two are
// overload sets, resolved on types and not arity alone.
// -----------------------------------------------------------------

lower_receiver_call = (be :: CBackend, d: Dot, ctx: Ctx, out :: String)
                      Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    rty     = ty_of(be, d.a.base, ctx, unknown).try();
    site_of(be, rty).try().match({
        None  => lower_ufcs(be, d, rty, ctx, out),
        Ok(s) => with_site(be, d, s, ctx, out),
    })
}

with_site = (be :: CBackend, d: Dot, s: Site, ctx: Ctx, out :: String)
            Res<(), AllocError> {
    own ::= be.alloc.Vec<Member>();
    member_at(be, s, d.a.name.text, own).try();
    pick_member(be, d.c, s, own, ctx).try().match({
        Ok(m) => declared_member(be, d, s, m, ctx, out),
        None  => supplied_or_ufcs(be, d, s, ctx, out),
    })
}

supplied_or_ufcs = (be :: CBackend, d: Dot, s: Site, ctx: Ctx, out :: String)
                   Res<(), AllocError> {
    found ::= be.alloc.Vec<Member>();
    impl_member_at(be, s.decl, d.a.name.text, found).try();
    pick_member(be, d.c, s, found, ctx).try().match({
        Ok(m) => supplied_member(be, d, s, m, ctx, out),
        None  => lower_ufcs(be, d, s.ty, ctx, out),
    })
}

// A DECLARED MEMBER THAT IS NOT A FUNCTION IS A FIELD HOLDING ONE, what
// a fat value's slot is. Calling through it is the general form — lower
// the callee, then call it — and is not written yet.
declared_member = (
    be  :: CBackend,
    d   : Dot,
    s   : Site,
    m   : Member,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    m.kind.match({
        Function(f) => lower_method(be, d, s, f, ctx, out),
        _           => unsupported(
            be,
            d.id,
            "a call through a function-valued field",
            out
        ),
    })
}

// An impl cannot supply a field, so anything but a function here is a
// name the dot reaches some other way.
supplied_member = (
    be  :: CBackend,
    d   : Dot,
    s   : Site,
    m   : Member,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    m.kind.match({
        Function(f) => lower_method(be, d, s, f, ctx, out),
        _           => lower_ufcs(be, d, s.ty, ctx, out),
    })
}

// -----------------------------------------------------------------
// which of two members of one name
//
// "Resolution is on declared parameter types AND arity" (DESIGN.md,
// Overloading) — a backend reading only arity answers whichever the
// member table listed first. `Display` declares a `toString` taking a
// sink and a sealed one taking an allocator, both arity two;
// `p.toString(alloc)` once lowered to the sink symbol with the
// allocator passed as a `Sink` of NULL function pointers. `cc` caught
// it only because the two return types differ — two overloads agreeing
// on return type would have been silent.
//
// ONE CANDIDATE IS NOT A CHOICE, so the common call pays only the arity
// test; the header says why the predicate here is the checker's own.
// -----------------------------------------------------------------

pick_member = (be :: CBackend, c: Call, s: Site, found: Vec<Member>, ctx: Ctx)
              Res<Res<Member>, AllocError> {
    (found.len < 2).match({
        true  => Ok(by_arity(be, found, c.args.len + 1)),
        false => member_that_fits(be, c, s, found, ctx),
    })
}

// THE FIRST THAT FITS, and arity when none does — both halves the
// checker's. `pick_fitting` takes the first because "two members
// accepting the same call is an error AT THE DECLARATION"; `by_arity_ret`
// falls back where `fits` cannot answer, on an unsettled receiver or a
// variadic signature.
member_that_fits = (
    be    :: CBackend,
    c     : Call,
    s     : Site,
    found : Vec<Member>,
    ctx   : Ctx
)
                   Res<Res<Member>, AllocError> {
    actuals ::= be.alloc.Vec<Actual>();
    call_actuals(be, c, ctx, actuals).try();
    kept ::= be.alloc.Vec<Member>();
    found.loop((h, m) { keep_fits(be, m, s, actuals, kept).try() });
    Ok(kept_or_arity(be, kept, found, c.args.len + 1));
}

// A named helper rather than a `.then` inside the loop body: a loop
// binding read inside a nested closure does not resolve.
keep_fits = (
    be      :: CBackend,
    m       : Member,
    s       : Site,
    actuals : Vec<Actual>,
    kept    :: Vec<Member>
) Res<(), AllocError> {
    m.kind.match({
        Function(f) => keep_if_fits(be, m, f, s, actuals, kept),
        _           => Ok(()),
    })
}

// `method_sig` and not the member's written types — the signature this
// builds is the one `emit_method_call` mangles into the symbol.
keep_if_fits = (
    be      :: CBackend,
    m       : Member,
    f       : Function,
    s       : Site,
    actuals : Vec<Actual>,
    kept    :: Vec<Member>
) Res<(), AllocError> {
    inst = recv_inst(be, s.ty).try();
    sig ::= be.alloc.Vec<TyId>();
    method_sig(be, s.ty, s.decl, f, s.decl.module.to_usize(), inst, sig).try();
    be.check.recv_sig_fits(sig, actuals).try().match({
        true  => kept.add(m),
        false => Ok(()),
    })
}

call_actuals = (be :: CBackend, c: Call, ctx: Ctx, out :: Vec<Actual>)
               Res<(), AllocError> {
    c.args.loop((h, x) { out.add(arg_actual(be, x, ctx).try()).try() });
    Ok(());
}

// WHAT RESOLUTION READS OFF AN ARGUMENT, and no more. A lambda has no
// type until a signature settles it — "a closure's type is its full
// signature" — so a candidate is tested against its PARAMETER COUNT,
// the part a call site sees without inferring anything.
arg_actual = (be :: CBackend, x: Arg, ctx: Ctx) Res<Actual, AllocError> {
    unknown = be.check.types.unknown().try();
    be.tree.expr_at(x.value).kind.match({
        Lambda(l) => Ok(Actual(
            ty: unknown,
            is_lambda: true,
            arity: l.params.len,
            named: false,
            span: x.span
        )),
        _         => typed_actual(be, x, ctx, unknown),
    })
}

typed_actual = (be :: CBackend, x: Arg, ctx: Ctx, unknown: TyId)
               Res<Actual, AllocError> {
    ty = ty_of(be, x.value, ctx, unknown).try();
    Ok(Actual(ty: ty, is_lambda: false, arity: 0, named: false, span: x.span));
}

// -----------------------------------------------------------------
// the declaring site
//
// Which declaration owns a type's members, and under what qualified
// name a symbol built from it is written. A `Prim` has one too — "a
// prelude declaration of a primitive's name IS that primitive" — so
// `str`'s members are `std.text.text_str.str`'s and the receiver stays
// the primitive.
//
// THE RECEIVER'S TYPE IS A FIELD OF THE SITE, not a parameter beside it.
// `site_of` is handed that type to find the site at all, so a caller
// threading both carried one value twice — and a pair threaded apart is
// a pair that can be threaded wrong.
// -----------------------------------------------------------------

Site* = {
    ty*: TyId,
    decl*: DeclId,
    qname*: str,
    generic*: bool,
}

site_of* = (be :: CBackend, rty: TyId) Res<Res<Site>, AllocError> {
    be.check.types.at(rty).match({
        Named(n) => named_site(be, rty, n),
        Prim(p)  => prim_site(be, rty, p.name),
        _        => Ok(None),
    })
}

named_site = (
    be  :: CBackend,
    rty : TyId,
    n   : TyNamed
) Res<Res<Site>, AllocError> {
    qname ::= be.alloc.String().try();
    join(qname, module_of(be.check.world, n.decl), n.name).try();
    Ok(Ok(Site(
        ty: rty,
        decl: n.decl,
        qname: qname.view(),
        generic: n.args.len > 0
    )));
}

prim_site = (be :: CBackend, rty: TyId, name: str) Res<Res<Site>, AllocError> {
    defs ::= be.alloc.Vec<Def>();
    be.check.world.prelude_of(name, defs).try();
    defs.get(0).match({
        None  => Ok(None),
        Ok(d) => Ok(Ok(Site(
            ty: rty,
            decl: d.id,
            qname: d.qname,
            generic: false
        ))),
    })
}

join* = (out :: String, module: str, name: str) Res<(), AllocError> {
    (module.len > 0).then(() { out.add_bytes(module).try() });
    (module.len > 0).then(() { out.add_bytes(".").try() });
    out.add_bytes(name).try();
    Ok(());
}

// The qualified name of a type, for a variant symbol.
type_qname = (be :: CBackend, ty: TyId, out :: String) Res<(), AllocError> {
    be.check.types.at(ty).match({
        Named(n) => join(out, module_of(be.check.world, n.decl), n.name),
        _        => Ok(()),
    })
}

// The member of `s` called `name`, when its declaration has one.
member_at* = (be :: CBackend, s: Site, name: str, out :: Vec<Member>)
             Res<(), AllocError> {
    decl_at(be.tree, s.decl).match({
        None  => Ok(()),
        Ok(d) => struct_member(d, name, out),
    }).try();
    Ok(());
}

struct_member = (d: Decl, name: str, out :: Vec<Member>) Res<(), AllocError> {
    d.kind.match({
        Struct(st) => keep_named(st, name, out),
        _          => Ok(()),
    })
}

keep_named = (st: Struct, name: str, out :: Vec<Member>) Res<(), AllocError> {
    st.members.loop((h, m) {
        member_named(m, name).then(() { out.add(m).try() });
    });
    Ok(());
}

// -----------------------------------------------------------------
// a member the type declares
// -----------------------------------------------------------------

// WHICH OF SEVEN KINDS A METHOD CALL IS, decided once. A variant carries
// what deciding it computed, so that value is built in the branch that
// needs it and threaded nowhere else.
MethodKind = Inlined
    | PtrMember(TyId)
    | Capability(usize)
    | SinkDoor
    | FloorDoor
    | FatSlot
    | Ordinary

// THE PRECEDENCE, WHICH IS LOAD-BEARING: a kind is asked about only
// once every kind above it has said no. It was six lowerings deep and
// readable only by following the chain; here it is a list.
//
//   Inlined     A MEMBER HANDED A LAMBDA IS INLINED, exactly as a free
//               function is: a `(b: u8) bool` parameter has no C
//               spelling and nothing to pass.
//   PtrMember   `gen_c_ptr.zen` writes the run primitives.
//   Capability  a member whose floor is the target language's;
//               `gen_c_cap.zen` claims it before anything below can
//               refuse it as bodyless.
//   SinkDoor    ASKED BEFORE THE TWO BELOW, because both get it wrong.
//               `s.add("{}", x)` is bodyless BY DESIGN — so
//               `method_fault` would reject the one spelling DESIGN.md
//               writes, and on a receiver already typed `Sink` the fat
//               branch would hunt an `add` slot `text_fmt.zen`
//               deliberately never cut.
//   FloorDoor   the same door on the receiver's OWN byte writer,
//               `be.fmt("{};\n", name)`, answering what that writer
//               answers. `gen_c_floor.zen` holds the contract.
//   FatSlot     A MEMBER WITH NO BODY ON A VALUE WHOSE STATIC TYPE IS
//               THE BOUND is the one call not resolvable statically:
//               which function runs is decided by the impl behind the
//               receiver, a `void *` in a record. `gen_c_fat.zen`.
//   Ordinary    EVERYTHING ELSE STILL RESOLVES STATICALLY and builds no
//               record: a bodied member is the bound's own default
//               specialised here, a concrete receiver the impl's
//               function monomorphised.
method_kind = (be :: CBackend, d: Dot, s: Site, f: Function, ctx: Ctx)
              Res<MethodKind, AllocError> {
    name                   = d.a.name.text;
    found: Res<MethodKind> = loop<MethodKind>((h) {
        inlines(be, d.c, f).then(() { h.break(MethodKind.Inlined) });
        is_ptr_member(be, s.ty, name).then(() {
            h.break(MethodKind.PtrMember(want_of(be, d.id, ctx).try()))
        });
        is_capability(be, s.ty, name).then(() {
            h.break(MethodKind.Capability(s.decl.module.to_usize()))
        });
        be.is_member_door(d.a, f).then(() { h.break(MethodKind.SinkDoor) });
        be.is_floor_door(name, f).then(() { h.break(MethodKind.FloorDoor) });
        be.is_fat_slot(s.ty, f).then(() { h.break(MethodKind.FatSlot) });
        h.break(MethodKind.Ordinary);
    });
    Ok(found.match({
        Ok(k) => k,
        None  => MethodKind.Ordinary,
    }));
}

is_member_door = (be: CBackend, a: Access, f: Function) bool {
    a.name.text.eq("add") && sink_door_shape(be, f)
}

is_fat_slot = (be: CBackend, rty: TyId, f: Function) bool {
    is_fat(be, rty) && (has_body(f) == false)
}

lower_method = (
    be  :: CBackend,
    d   : Dot,
    s   : Site,
    f   : Function,
    ctx : Ctx,
    out :: String
)
               Res<(), AllocError> {
    be.method_kind(d, s, f, ctx).try().match({
        Inlined       => inline_method(
            be,
            d.id,
            d.c,
            d.a,
            s.ty,
            s.decl,
            f,
            ctx,
            out
        ),
        PtrMember(w)  => lower_ptr_member(
            be,
            d.id,
            d.c,
            d.a,
            s.ty,
            ctx,
            w,
            out
        ),
        Capability(m) => lower_capability(
            be,
            d.id,
            d.c,
            d.a,
            s.ty,
            m,
            f,
            ctx,
            out
        ),
        SinkDoor      => lower_member_door(be, d.id, d.c, d.a.base, ctx, out),
        FloorDoor     => be.lower_floor_door(
            d.id,
            d.c,
            d.a,
            s.ty,
            s,
            f,
            ctx,
            out
        ),
        FatSlot       => lower_fat_call(
            be,
            d.id,
            d.c,
            d.a,
            s.ty,
            s,
            f,
            ctx,
            out
        ),
        Ordinary      => lower_ordinary_method(be, d, s, f, ctx, out),
    })
}

lower_ordinary_method = (
    be  :: CBackend,
    d   : Dot,
    s   : Site,
    f   : Function,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    method_fault(f).match({
        Ok(why) => unsupported(be, d.id, why, out),
        None    => write_method_call(be, d, s, f, ctx, out),
    })
}

// A GENERIC RECEIVER IS NOT A REFUSAL: `Vec<GenDiag>.add` is `Vec.add`
// emitted at `GenDiag`, the receiver's own arguments say which. Refused:
// a member declaring type parameters OF ITS OWN (instantiating one needs
// the receiver's arguments plus the call's, and nothing in this tree
// declares one), and a member with no body that `gen_c_cap.zen` did not
// claim — a symbol nothing would define. ONE FUNCTION AND NOT TWO: as a
// predicate beside a wording they asked the same questions twice, and
// could answer them differently.
method_fault = (f: Function) Res<str> {
    (f.tparams.len > 0).match({
        true  => Ok("a generic method"),
        false => has_body(f).match({
            true  => None,
            false => Ok("a call to a member with no body"),
        }),
    })
}

// The call itself: the receiver as argument zero, then the written
// arguments. The symbol is the header's — over the full signature, the
// receiver included, because the receiver IS the first parameter.
write_method_call = (
    be  :: CBackend,
    d   : Dot,
    s   : Site,
    f   : Function,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    inst = recv_inst(be, s.ty).try();
    sig ::= be.alloc.Vec<TyId>();
    method_sig(be, s.ty, s.decl, f, s.decl.module.to_usize(), inst, sig).try();
    (inst_open(be, inst) || any_open(be, sig)).match({
        true  => unsupported(
            be,
            d.id,
            "a method on a receiver whose type arguments nothing settles",
            out
        ),
        false => emit_method_call(be, d, s, f, sig, inst, ctx, out),
    })
}

// THE RECEIVER IS ALREADY WRITTEN, so the rest is the free-function path
// at offset one — `write_call_args` and not a second loop, because a
// member may end in a `vararg<T>` and a pack built two ways is a pack
// built one way wrongly.
emit_method_call = (
    be   :: CBackend,
    d    : Dot,
    s    : Site,
    f    : Function,
    sig  : Vec<TyId>,
    inst : Inst,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    sym = member_symbol(be, s.ty, s, d.a.name.text, sig, inst).try();
    args ::= be.alloc.String().try();
    write_arg(be, d.a.base, 0, f, sig, ctx, args).try();
    write_call_args(be, d.c, 1, f, sig, ctx, args).try();
    out.fmt("{}({})", sym.view(), args.view())
}

// THE SYMBOL AND THE QUEUE ENTRY ARE WRITTEN TOGETHER. Seven lowerings
// reach a member by name, and an entry built differently from the symbol
// written beside it is a call to a function nothing defines.
member_symbol* = (
    be   :: CBackend,
    ty   : TyId,
    s    : Site,
    name : str,
    sig  : Vec<TyId>,
    inst : Inst
) Res<String, AllocError> {
    qname ::= be.alloc.String().try();
    join(qname, s.qname, name).try();
    sym ::= be.alloc.String().try();
    sym_fn(sym, be.check.types, be.check.world, qname.view(), sig, inst).try();
    be.need_method(
        MethodRef(
            self_ty: ty,
            decl: s.decl,
            name: name,
            sig: sig,
            qname: qname.view()
        ),
        inst,
        sym.view()
    ).try();
    Ok(sym);
}

// The declared parameter types of a member function, resolved in the
// module that declares it with `@Self` bound to the receiver, so
// `(self: @Self, i: usize)` reads as a function of the receiver rather
// than a name nothing binds. WITH THE TYPE'S PARAMETERS BOUND, then
// substituted: `Vec<T>.add` declares `(self :: @Self, v: T)` and `T`
// BECOMES the receiver's own argument in that position.
method_sig* = (
    be   :: CBackend,
    rty  : TyId,
    decl : DeclId,
    f    : Function,
    mi   : usize,
    inst : Inst,
    sig  :: Vec<TyId>
) Res<(), AllocError> {
    sctx = be.check.self_ctx(mi, rty).try();
    mark = enter_struct_tparams(be, decl).try();
    f.params.loop((h, p) { add_method_param(be, p, sctx, inst, sig).try() });
    leave_tparams(be, mark).try();
    Ok(());
}

add_method_param = (
    be   :: CBackend,
    p    : Param,
    sctx : Ctx,
    inst : Inst,
    sig  :: Vec<TyId>
) Res<(), AllocError> {
    declared = be.check.param_type(p, sctx).try();
    sig.add(sub_with(be, declared, inst).try())
}

// -----------------------------------------------------------------
// a member call the source did not write
//
// "`==` through `Eq` is the only operator that dispatches to an impl."
// `a == b` on a type C cannot compare is a call to that type's `eq`,
// taking THIS file's path rather than a second one: the symbol,
// instantiation and queue entry are the ones `a.eq(b)` would produce,
// so the two cannot disagree about which function they mean.
//
// STATICALLY RESOLVED, like every impl-supplied member here — operand
// types are known, so no function-pointer record takes part. A type
// impl'ing no `Eq` is the caller's refusal to report.
// -----------------------------------------------------------------

lower_eq_call* = (
    be  :: CBackend,
    lhs : ExprId,
    rhs : ExprId,
    rty : TyId,
    ctx : Ctx,
    out :: String
) Res<bool, AllocError> {
    site_of(be, rty).try().match({
        None  => Ok(false),
        Ok(s) => eq_through_site(be, lhs, rhs, s, ctx, out),
    })
}

eq_through_site = (
    be  :: CBackend,
    lhs : ExprId,
    rhs : ExprId,
    s   : Site,
    ctx : Ctx,
    out :: String
) Res<bool, AllocError> {
    eq_fn(be, s).try().match({
        None  => Ok(false),
        Ok(f) => write_eq(be, lhs, rhs, s, f, ctx, out),
    })
}

// The type's own `eq` first, then what an impl supplies — the order
// `sema_supply.zen` states, and for its reason.
eq_fn = (be :: CBackend, s: Site) Res<Res<Function>, AllocError> {
    found ::= be.alloc.Vec<Member>();
    member_at(be, s, "eq", found).try();
    bodied_fn(found).match({
        Ok(f) => Ok(Ok(f)),
        None  => impl_member(be, s.decl, "eq"),
    })
}

write_eq = (
    be  :: CBackend,
    lhs : ExprId,
    rhs : ExprId,
    s   : Site,
    f   : Function,
    ctx : Ctx,
    out :: String
) Res<bool, AllocError> {
    inst = recv_inst(be, s.ty).try();
    sig ::= be.alloc.Vec<TyId>();
    method_sig(be, s.ty, s.decl, f, s.decl.module.to_usize(), inst, sig).try();
    (inst_open(be, inst) || any_open(be, sig)).match({
        true  => Ok(false),
        false => emit_eq(be, lhs, rhs, s, f, sig, inst, ctx, out),
    })
}

emit_eq = (
    be   :: CBackend,
    lhs  : ExprId,
    rhs  : ExprId,
    s    : Site,
    f    : Function,
    sig  : Vec<TyId>,
    inst : Inst,
    ctx  : Ctx,
    out  :: String
) Res<bool, AllocError> {
    sym = member_symbol(be, s.ty, s, "eq", sig, inst).try();
    l ::= be.alloc.String().try();
    write_arg(be, lhs, 0, f, sig, ctx, l).try();
    r ::= be.alloc.String().try();
    write_arg(be, rhs, 1, f, sig, ctx, r).try();
    out.fmt("{}({}, {})", sym.view(), l.view(), r.view()).try();
    Ok(true);
}

// -----------------------------------------------------------------
// ufcs
//
// "A free function whose first param is the type is callable as a
// method." The receiver becomes argument zero and there is no second
// mechanism — which is why `lower_plain_call` takes a receiver at all.
// -----------------------------------------------------------------

// `alloc.create<T>()` IS ASKED ABOUT FIRST, and only here at the end:
// declared on `Alloc` with no body and supplied by no impl, so by the
// time this runs both the receiver's declaration and its impls have
// been searched and missed — which lets a type declaring a `create` of
// its own still win.
lower_ufcs = (be :: CBackend, d: Dot, rty: TyId, ctx: Ctx, out :: String)
             Res<(), AllocError> {
    lower_create(be, d.id, d.c, d.a, rty, ctx, out).try().match({
        true  => Ok(()),
        false => ufcs_or_impl(be, d, rty, ctx, out),
    })
}

ufcs_or_impl = (be :: CBackend, d: Dot, rty: TyId, ctx: Ctx, out :: String)
               Res<(), AllocError> {
    reaches(be, rty, d.a.name.text, d.c.args.len + 1).try().match({
        true  => impl_alias(be, d, rty, ctx, out),
        false => lower_plain_call(
            be,
            d.id,
            d.c,
            d.a.name.text,
            Ok(d.a.base),
            ctx,
            out
        ),
    })
}

// An impl member that IS another function — `widen_u32 = to_u32` in
// std.core.num — lowers as the very call the alias names, so the two
// spellings cannot disagree. Anything else meets the refusal.
impl_alias = (be :: CBackend, d: Dot, rty: TyId, ctx: Ctx, out :: String)
             Res<(), AllocError> {
    site_of(be, rty).try().match({
        None  => unsupported(
            be,
            d.id,
            "a call to an impl-supplied member",
            out
        ),
        Ok(s) => alias_target(be, d, s, ctx, out),
    });
}

alias_target = (be :: CBackend, d: Dot, s: Site, ctx: Ctx, out :: String)
               Res<(), AllocError> {
    alias_of(be, s.decl, d.a.name.text).try().match({
        Ok(t) => lower_plain_call(be, d.id, d.c, t, Ok(d.a.base), ctx, out),
        None  => unsupported(
            be,
            d.id,
            "a call to an impl-supplied member",
            out
        ),
    })
}

// AT THIS CALL'S ARITY, and not the name alone: `Box` declares
// `grow(self)` while a free `grow(b, by)` travels with the type, and
// matching on the name refused `b.grow(10)` as unimplemented.
reaches = (be :: CBackend, rty: TyId, name: str, arity: usize)
          Res<bool, AllocError> {
    found ::= be.alloc.Vec<Found>();
    be.check.members_of(rty, name, found).try();
    Ok(any_at_arity(be, found, arity));
}

any_at_arity = (be: CBackend, found: Vec<Found>, arity: usize) bool {
    Range(0, found.len).find((i) {
        found.get(i).match({
            Ok(f) => fn_takes_args(be, f.ty, arity),
            None  => false,
        })
    }).match({ Ok(_) => true, None => false })
}

// A `Found` carries a type and not a declaration, so the arity is the
// resolved signature's, and `...` is a minimum here for the reason
// `gen_c_impl.zen`'s `fn_takes` gives.
fn_takes_args = (be: CBackend, ty: TyId, arity: usize) bool {
    be.check.types.at(ty).match({
        Fn(f) => (f.params.len == arity) || variadic_takes(be, f, arity),
        _     => false,
    })
}

variadic_takes = (be: CBackend, f: TyFn, arity: usize) bool {
    (f.params.len > 0)
        && be.check.tail_swallows(ty_at(f.params, f.params.len - 1))
        && ((arity + 1) >= f.params.len)
}
