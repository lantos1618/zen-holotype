// tests/must-fail/traps/literal_operand_out_of_range.zen
// the SAME rule as literal_too_large_i32, in the last position that
// never asked: an OPERAND. `200` takes its type from its context and
// the context is the `i8` beside it, so the value has to fit one --
// unchecked, it reached `zg_div_i8`'s int8_t parameter as -56 and the
// division answered -1

// main must name an error type. a trap never lifts into Res:
// it aborts the process
Error = Overflow | DivideByZero | OutOfBounds

main = (env: Env) Res<i32, Error> {
    n: i8 = 100;
    println("{}", (n / 200).to_i64());
    Ok(0);
}
