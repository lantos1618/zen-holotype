// A default Range yields usize values. Passing one to Vec<i32>.add is not an
// implicit narrowing conversion; the range or the stored value must name i32.
//
// position: the call whose argument does not fit the element type.

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    values ::= alloc.Vec<i32>();
    Range(0, 2).loop((h, value) { values.add(value).try(); });
    Ok(0);
}
