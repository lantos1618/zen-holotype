// tests/corpus/std/vec_get_returns_ok.zen
// get is Res<T>: in range it is Ok, carrying the element that was
// stored at that index and not the one next to it

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    v     ::= alloc.Vec<str>();
    v.add("ada").try();
    v.add("grace").try();
    v.add("alan").try();

    v.get(0).match({
        Ok(s) => println("{}", s),
        None  => println("missing"),
    });
    v.get(2).match({
        Ok(s) => println("{}", s),
        None  => println("missing"),
    });
    Ok(0);
}
