// two impls supply a field named `width` and there is no bound in scope
// to select one. the error must name BOTH impls -- picking by file order
// is the failure this rule exists to prevent. DESIGN.md, Declarations.
//
// positions: the ambiguous field, then both impl declarations.

Boxy = {
    width: i32,
    height: i32,
}

Framed = {
    width: i32,
}

Tile = {
    side: i32,
}

Tile.impl(Boxy, {
    width: self.side,
    height: self.side,
})

Tile.impl(Framed, {
    width: self.side * 10,
})

main = (env: Env) Res<i32, AllocError> {
    t = Tile(side: 3);
    println("{}", t.width);
    Ok(0);
}
