// UNRESOLVED in DESIGN.md: enum variants are comma-separated with no
// braces, so a trailing comma has no closing token to stop at and the
// next declaration would be swallowed as a variant. the formatter puts
// a trailing comma on the last MATCH arm; nothing says it may here.
Shape = Circle | Square

main = (env: Env) Res<i32, ArgError> {
    Ok(0);
}
