== arms line up on the widest pattern
faithful: true, fixpoint
1 |w = (n: i32) i32 {|
2 |    n.match({|
3 |        0   => 1,|
4 |        123 => 2,|
5 |        _   => 3,|
6 |    })|
7 |}|
== a `=>` inside a string is not an arrow
faithful: true, fixpoint
1 |s = (n: i32) str {|
2 |    n.match({|
3 |        0   => "0 => zero",|
4 |        123 => "many",|
5 |        _   => "?",|
6 |    })|
7 |}|
== a commented-out arm is not in the list
faithful: true, fixpoint
1 |// c = (n: i32) i32 { n.match({ 0 => 1, _ => 2 }) }|
2 |d = (n: i32) i32 {|
3 |    n.match({|
4 |        0 => 1,|
5 |        // 12345 => 2,|
6 |        _ => 3,|
7 |    })|
8 |}|
== a comment in the gap is not overwritten
faithful: true, fixpoint
1 |g = (n: i32) i32 {|
2 |    n.match({|
3 |        0 /* not a gap */ => 1,|
4 |        123 => 2,|
5 |        _   => 3,|
6 |    })|
7 |}|
== arms packed onto one line keep their spacing
faithful: true, fixpoint
1 |p = (n: i32) i32 {|
2 |    n.match({ 0 => 1, 123 => 2,|
3 |        _ => 3,|
4 |    })|
5 |}|
== an arm that opens a packed line is packed too
faithful: true, fixpoint
1 |q = (n: i32) i32 {|
2 |    n.match({|
3 |        0 => 1, 123 => 2,|
4 |        45678 => 3,|
5 |        _     => 4,|
6 |    })|
7 |}|
