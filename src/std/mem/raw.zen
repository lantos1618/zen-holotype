// std.mem.raw — explicit heap memory over libc.
//
// Zen has no GC and no destructors, so ownership is explicit: you free what you
// alloc. These wrap the C symbols (declared bodyless, so they lower to bare calls
// and libc's headers declare them — nothing is re-prototyped).
//
//   p := alloc(64)          // RawPtr<u8>
//   store(p, 7)
//   release(p)
{ Result, IoError, ok_ptr, ok, err } = std.core.result
{ malloc, free } = std.mem.alloc
{ calloc, memcpy, memmove, memset, memcmp } = std.c.libc
// allocate `n` bytes (uninitialised)
alloc* = (n: i64) RawPtr<u8> { malloc(n) }
// A 0-byte request is an EMPTY SUCCESS, matching std.mem.alloc's `try_acquire`. C leaves `malloc(0)`
// implementation-defined — "either a null pointer or a unique pointer" — and `ok_ptr` maps null to
// `.Err`, so without this guard a libc that answers null reports OOM for a request that asked for
// nothing. glibc and musl return non-null, so this is latent here, not live.
try_alloc* = (n: i64) Result<RawPtr<u8>, IoError> {
    (n <= 0).then({ .Ok(null_ptr()) }, { ok_ptr(malloc(n)) })
}
// allocate `n` bytes, zero-filled
zeroed* = (n: i64) RawPtr<u8> { calloc(n, 1) }
try_zeroed* = (n: i64) Result<RawPtr<u8>, IoError> {
    (n <= 0).then({ .Ok(null_ptr()) }, { ok_ptr(calloc(n, 1)) })
}
// ── bulk byte ops ────────────────────────────────────────────────────────────
// Storage moves over memory the caller already owns: they allocate nothing, and they are
// indifferent to what the bytes MEAN (that is what makes them mem's, not text's). Written
// destination-first so UFCS reads as the write it is — `dst.copy(src, n)`. `n == 0` is a
// well-defined no-op for all four (`compare` reports equal).
// `n` bytes src -> dst. The two ranges MUST NOT OVERLAP: an overlapping memcpy is C undefined
// behaviour — it may copy in any order or word-at-a-time, not just produce surprising bytes.
// Use `move` whenever dst and src can be windows on the same buffer.
copy* = (dst: RawPtr<u8>, src: Ptr<u8>, n: i64) void { memcpy(dst, src, n) }
// `n` bytes src -> dst, DEFINED WHEN THE RANGES OVERLAP: the result is as if src were read
// through a scratch copy first. The shift-a-buffer-in-place op (insert/remove/compact).
move* = (dst: RawPtr<u8>, src: Ptr<u8>, n: i64) void { memmove(dst, src, n) }
// fill the `n` bytes at dst with the byte `b`
set* = (dst: RawPtr<u8>, b: u8, n: i64) void { memset(dst, to_i32(b), n) }
// order the first `n` bytes of a and b as UNSIGNED bytes: negative / 0 / positive when a sorts
// before / equal to / after b. Equality is `a.compare(b, n) == 0`.
compare* = (a: Ptr<u8>, b: Ptr<u8>, n: i64) i32 { memcmp(a, b, n) }
// hand the block back to the allocator
release* = (p: RawPtr<u8>) void { free(p) }
// Scoped FFI scratch cell: allocate `n` zero-filled bytes, run `f` over them, ALWAYS release the cell,
// and return `f`'s result. Collapses the leak-prone `c := zeroed(n); …; release(c); return r` shape
// that struct-shaped syscalls (timespec, sockaddr, struct stat) repeat — release now fires on every
// path through `f`, not once per manual return. `f` runs and completes within this scope (the cell is
// freed the instant it returns), so it may capture freely; it just must not stash the cell for later.
with_scratch*<T> = (n: i64, f: (RawPtr<u8>) T) T {
    c = zeroed(n)
    r = f(c)
    release(c)
    r
}
// a typed heap buffer of `n` T's, seeded at [0] — the TYPED replacement for the raw
// `slice(alloc(n * sizeof(T)), n)` incantation, whose element type is unknowable (census #9: reads
// through it emitted an invalid `(void*)` cast). The declared `[T]` return gives every later
// read/write its element type; T is inferred from the seed.
//   raw = std.mem.raw
//   ns := raw.of(Node(v: 5), 8)     // [Node] with room for 8, ns[0] = the seed
of*<T> = (seed: T, n: i64) [T] {
    b ::= slice(alloc(n * sizeof(T)), n)
    b[0] = seed
    b
}
try_of*<T> = (seed: T, n: i64) Result<[T], IoError> {
    (n <= 0).match ({
        true  => err(IoError.NotFound),
        false => try_alloc(n * sizeof(T)).match ({
            .Ok(p)  => {
                b ::= slice(p, n)
                b[0] = seed
                ok(b)
            },
            .Err(e) => err(e),
        }),
    })
}
