Alloc, AllocError = std.mem
str = std.text
Vec = std.collections
Range = std.core
Pos = std.ast.ast_span
Ast = std.ast.ast_arena
Module = std.ast.ast_node
scan, Source = std.lex.lex
Parser, module = std.parse.parse

// A source text with its line index. Positions are 1-based; every byte
// offset returned is clamped to the text.
Src* = {
    text*: str,

    // Byte offset of the first byte of each line: line `n` starts at
    // `starts.get(n - 1)`.
    starts: Vec<usize>,

    // A line past the index maps to the end of the text; the end-of-file
    // span points there.
    offset* = (self: @Self, p: Pos) usize {
        (p.line == 0 || p.line > self.starts.len).match({
            true  => self.text.len,
            false => self.bounded(self.line_at(p.line) + col_index(p.col)),
        })
    }

    lines* = (self: @Self) usize { self.starts.len }

    line_at* = (self: @Self, line: usize) usize {
        (line == 0).match({
            true  => 0,
            false => self.starts.get(line - 1).value_or(self.text.len),
        })
    }

    after_line* = (self: @Self, line: usize) usize {
        self.starts.get(line).value_or(self.text.len)
    }

    // `*_spaces` walks ASCII spaces only; `*_space` walks any whitespace
    // byte. Neither passes `to`.
    past_spaces* = (self: @Self, from: usize, to: usize) usize {
        at ::= from;
        loop(() { at < to && self.text.index(at) == ' ' }, (h) {
            at = at + 1;
        });
        at;
    }

    all_spaces* = (self: @Self, from: usize, to: usize) bool {
        self.past_spaces(from, to) == to
    }

    skip_space* = (self: @Self, from: usize, to: usize) usize {
        at ::= from;
        loop(() { at < to && self.text.index(at).is_space() }, (h) {
            at = at + 1;
        });
        at;
    }

    all_space* = (self: @Self, from: usize, to: usize) bool {
        self.skip_space(from, to) == to
    }

    bounded = (self: @Self, at: usize) usize {
        (at < self.text.len).match({
            true  => at,
            false => self.text.len,
        })
    }

    // The bytes in `[from, to)`, verbatim.
    slice_at* = (self: @Self, from: usize, to: usize) str {
        (from < to).match({
            true  => self.text.slice(self.bounded(from), self.bounded(to)),
            false => "",
        })
    }

    // `to` walked back over whitespace, stopping at `from`.
    trim_back* = (self: @Self, from: usize, to: usize) usize {
        end ::= self.bounded(to);
        loop(() { end > from && self.text.index(end - 1).is_space() }, (h) {
            end = end - 1;
        });
        end;
    }
}

col_index = (col: usize) usize {
    (col == 0).match({
        true  => 0,
        false => col - 1,
    })
}

// The line index is the only thing it allocates.
Src* = (a: Alloc, text: str) Res<Src, AllocError> {
    starts ::= a.Vec<usize>();
    starts.add(0).try();
    Range(0, text.len).loop((h, i) {
        (text.index(i) == '\n').then(() { starts.add(i + 1).try() });
    });
    Ok(Src(text: text, starts: starts));
}

// A text the lexer and the parser both accepted, with its byte index.
Parsed* = {
    src*: Src,
    tree*: Ast,
    m*: Module,
}

// None when either stage reports; a pass leaves such a text unchanged.
Parsed* = (a: Alloc, file: str, text: str) Res<Res<Parsed>, AllocError> {
    lexed = scan(a, Source(file: file, text: text)).try();
    lexed.is_clean().match({
        false => Ok(None),
        true  => {
            p ::= a.Parser(lexed);
            m = p.module(file).try();
            (p.diags.len == 0).match({
                false => Ok(None),
                true  => Ok(Ok(Parsed(
                    src: a.Src(text).try(),
                    tree: p.tree,
                    m: m
                ))),
            })
        },
    })
}
