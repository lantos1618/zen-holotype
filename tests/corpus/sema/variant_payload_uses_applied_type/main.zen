Opt<T> = Some(T) | None

value = (o: Opt<i64>) i64 { o.match({ Some(v) => v, None => 0 }) }

main = (env: Env) Res<i32, AllocError> {
    contextual: Opt<i64> = Opt.Some(5000000000);
    explicit             = Opt.Some<i64>(5000000000);
    println("{} {}", value(contextual), value(explicit));
    Ok(0);
}
