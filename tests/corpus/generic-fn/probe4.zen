// PROBE 4: is u8(200) the problem? Try u64(200), bare 200, u8 via binding.
Wrap<T> = { held: T }
wrap = <T>(t: T) Wrap<T> { Wrap(held: t) }

main = (env: Env) Res<i32, AllocError> {
    println("call-u8 {}", u8(200));
    b: u8 = 202;
    println("bind-u8 {}", b);
    println("wrap-bare {}", wrap(203).held);
    println("wrap-call-u8 {}", wrap(u8(204)).held);
    println("wrap-bind-u8 {}", wrap(b).held);
    wu = wrap(u64(205));
    println("wrap-u64 {}", wu.held);
    Ok(0);
}
