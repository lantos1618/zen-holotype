// `&&` AND `||` SHORT-CIRCUIT, and short-circuiting is deciding whether
// the RIGHT side runs off the left side's truth — which only a bool
// has. Nothing asked: `is_predicate` gives every comparison a `bool`
// RESULT, and `<`/`==` take whatever scalar they are given, so `&&`
// rode along with them and its own operands were checked by no one.
//
// BOTH SIDES, one question each, because a single question about the
// pair has to name one type as `found` — and would then report the
// LEFT one for a right-hand mistake.
//
// position: the operator, which is what demanded a bool.

main = (env: Env) Res<i32, AllocError> {
    n: i32 = 3;
    ok = true;
    (n && ok).then(() { println("left"); });
    (ok || n).then(() { println("right"); });
    Ok(0);
}
