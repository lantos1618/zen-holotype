// Constant arithmetic decides its own WIDTH from its VALUE, wherever it is bound.
//
// Regression for the silent wrong-answer where a `NAME := <const expr>` slot took the width of the
// expression's LEFTMOST literal instead of the width its value needs. A bare literal already picked
// i64 by value (`X := 4294967296` was fine), but `X := 1 << 32` inferred an i32 SLOT while the C
// backend — correctly — emitted a 64-bit constant, so the value truncated on the way in. No
// diagnostic: the program built and printed a wrong number. It bit two people, who each worked
// around it by writing the decimal out by hand (tools/fuzz-mutate.zen's `OUT_CAP` was one).
//
// TOP-LEVEL GLOBALS were the worst case (no fit check runs on one at all), but a function-local `:=`
// truncated identically, so both are pinned here. A global's type annotation is NOT a workaround and
// cannot be pinned here: it is parsed and discarded, and `zen fmt` deletes it outright — so
// `G: i64 := 1 << 32` is correct today only because the VALUE decides, never because of the `i64`.
//
// Every line's expected text is pinned by the harness (check_out), so a regression is a diff, not a
// silently different number.
{ formatln, arg_int } = std.text.fmt
G30 := 1 << 30    // 1073741824 — fits i32, must stay exactly as before
G31 := 1 << 31    // 2147483648 — one past i32 max
G32 := 1 << 32
GMUL := 100000 * 100000
GADD := 2147483647 + 1
GSUB := 0 - 4294967296    // negative constants widen too (their C spelling stays SIGNED)
GNEST := (1 << 20) * (1 << 20)
GSHR := 1 << 40 >> 8
GFLOAT := 1.5 * 2.0    // floats were never affected — pinned so the fold stays integer-only
main = () i32 {
    local := 1 << 32
    local_mul := 100000 * 100000
    formatln("{} {} {} {} {}", [arg_int(G30), arg_int(G31), arg_int(G32), arg_int(GMUL), arg_int(GADD)])
    formatln("{} {} {}", [arg_int(GSUB), arg_int(GNEST), arg_int(GSHR)])
    formatln("{} {}", [arg_int(local), arg_int(local_mul)])
    formatln("{}", [arg_int(GFLOAT.to_i64())])
    0
}
