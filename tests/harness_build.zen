        FixtureCase(
            path: "examples/actor_demo.zen",
            want_exit: "0",
            want_out: "",
            check_out: false,
        ),
        FixtureCase(
            path: "examples/pool_actor_demo.zen",
            want_exit: "0",
            want_out: "",
            check_out: false,
