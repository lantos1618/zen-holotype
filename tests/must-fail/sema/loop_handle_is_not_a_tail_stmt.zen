// THE `;`-TERMINATED TAIL IS THE SAME VALUE, so it meets the same
// refusal as `loop_handle_is_not_a_return`: a block falls out through
// its last statement when nothing is written as the tail, and gen_c
// lowers both spellings to the same `(void)(zu_l1h);`. One mistake
// stays one diagnostic either way.
//
// position: `h`, the statement the block falls out through.

main = (env: Env) Res<i32> {
    Range(0, 1).loop((h, x) {
        h;
    });
    Ok(0);
}
