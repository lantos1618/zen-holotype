// THE REBINDING RULE REACHES INSIDE A LAMBDA. `xs.loop((h, v) { .. })` is
// a block like any other, so `n = 42` then `n = 3.5` in it is refused by
// the same rule as the identical two statements at statement level
// (`rebound_in_one_block`). Before a lambda's body was walked, this
// compiled, ran, and printed 3 — a float stored into an int nobody wrote.
//
// positionS: the second binding inside the lambda, then BOTH of its sides.

Range = std.core.range

main = (env: Env) Res<i32, AllocError> {
    Range(0, 1).loop((h, i) {
        n = 42;
        n = 3.5;
        println("inside lambda n is {}", n);
    });
    Ok(0);
}
