// src/lsp/lsp_action.zen
// `textDocument/codeAction` — the auto-import quickfix, the only action.
// Undefined-name diagnostics are matched to modules exporting that name.
// Each action inserts an unstarred import after existing imports, using the
// shortest valid re-exporting module path. Unsupported or unavailable cases
// return an empty action list. Enum variants are not offered directly.

str, String = std.text
Vec = std.collections
Alloc, AllocError = std.mem
Range = std.core
Pos, Span = std.ast.ast_span
module_index_of = std.ast.ast_named
// Strict source-position ordering shared with the AST.
before = std.ast.ast_find
Checker = sema.sema_check
Diag = sema.sema_diag
Def, module_display = sema.sema_def
ModuleTable = sema.sema_def
to_pos, to_wire, write_wire, WirePos = lsp.lsp_pos
written, obj, arr, Nest = std.json

// A name and the module an auto-import would bind it from.
Action = { name: str, module: str }

// Write actions for undefined names intersecting the requested range.
write_actions* = (
    c    : Checker,
    t    : Alloc,
    file : str,
    text : str,
    uri  : str,
    sl   : usize,
    sc   : usize,
    el   : usize,
    ec   : usize,
    out  :: String
) Res<(), AllocError> {
    found ::= t.Vec<Action>();
    from = to_pos(text, sl, sc);
    upto = to_pos(text, el, ec);
    Range(0, c.diag_count()).loop((h, i) {
        c.diag_at(i).match({
            None  => written(),
            Ok(d) => offer(c, t, file, d, from, upto, found),
        }).try();
    });
    write_offerings(c, t, file, text, uri, found, out)
}

// Only undefined-name diagnostics in this file and range produce actions.
offer = (
    c     : Checker,
    t     : Alloc,
    file  : str,
    d     : Diag,
    from  : Pos,
    upto  : Pos,
    found :: Vec<Action>
) Res<(), AllocError> {
    (d.file.eq(file) && covers(d.span, from, upto)).match({
        false => written(),
        true  => d.fault.match({
            UndefinedName(nf) => offer_name(c, t, nf.name, found),
            _                 => written(),
        }),
    })
}

// Repeated diagnostics for one name share the same candidate search.
offer_name = (c: Checker, t: Alloc, name: str, found :: Vec<Action>)
             Res<(), AllocError> {
    found.find((a) { a.name.eq(name) }).match({
        Ok(_) => written(),
        None  => {
            defs  ::= t.Vec<Def>();
            lines ::= t.Vec<str>();
            c.world.exported_named(name, defs).try();
            defs.loop((h, d) {
                offer_def(c, t, name, d, found, lines).try();
            });
            Ok(())
        },
    })
}

// Prefer the folder root when it really re-exports the name; otherwise keep
// the declaring module's path. Identical import lines are deduplicated.
offer_def = (
    c     : Checker,
    t     : Alloc,
    name  : str,
    d     : Def,
    found :: Vec<Action>,
    seen  :: Vec<str>
)
            Res<(), AllocError> {
    mi = d.id.module.to_usize();
    c.world.table_at(mi).match({
        None      => written(),
        Ok(table) => offer_at(c, t, name, mi, table, found, seen),
    })
}

// The same, holding the declaring module's own table.
offer_at = (
    c     : Checker,
    t     : Alloc,
    name  : str,
    mi    : usize,
    table : ModuleTable,
    found :: Vec<Action>,
    seen  :: Vec<str>
) Res<(), AllocError> {
    spoken = module_display(table.name);
    // Use the short folder spelling only when its export table contains the
    // name. `written()` keeps all match arms at the same result type.
    at_root ::= t.Vec<Def>();
    visited ::= t.Vec<usize>();
    offered ::= table.name;
    (spoken.eq(table.name)).match({
        false => c.world.index_of(spoken).match({
            None  => written(),
            Ok(r) => (r == mi).match({
                true  => written(),
                false => {
                    c.world.exports_of(r, name, at_root, visited).try();
                    (at_root.len > 0).then(() { offered = spoken; });
                    written()
                },
            }).try(),
        }).try(),
        true  => written(),
    });
    line ::= t.String().try();
    line.add(name).try();
    line.add(" = ").try();
    line.add(offered).try();
    seen.find((s) { s.eq(line.view()) }).match({
        Ok(_) => written(),
        None  => {
            seen.add(line.view()).try();
            found.add(Action(name: name, module: offered))
        },
    });
    Ok(())
}

// Source spans and non-empty LSP ranges are half-open. A zero-width range
// selects the diagnostic containing the cursor.
covers = (span: Span, from: Pos, upto: Pos) bool {
    empty = from.line == upto.line && from.col == upto.col;
    (empty).match({
        true  => !after(span.start, from) && before(from, span.end),
        false => before(span.start, upto) && before(from, span.end),
    })
}

after = (a: Pos, b: Pos) bool {
    a.line > b.line || (a.line == b.line && a.col > b.col)
}

// Insert after the last parsed import, or at the start when none exists.
insert_at = (c: Checker, file: str, text: str) WirePos {
    line ::= 1;
    module_index_of(c.tree, file).match({
        None   => {},
        Ok(mi) => c.tree.module_at(mi).match({
            None  => {},
            Ok(m) => m.decls.loop((h, d) {
                d.kind.match({
                    Import(_) => { line = d.span.end.line + 1; },
                    _         => {},
                });
            }),
        }),
    });
    to_wire(text, Pos(line: line, col: 1))
}

// Serialize the action title, URI, and edit text through JSON escaping.
write_offerings = (
    c     : Checker,
    t     : Alloc,
    file  : str,
    text  : str,
    uri   : str,
    found : Vec<Action>,
    out   :: String
) Res<(), AllocError> {
    at = insert_at(c, file, text);
    list ::= arr(out).try();
    found.loop((h, a) { write_action(t, a, at, uri, list, out).try(); });
    list.close(out)
}

// Derive the title from the exact edit line so the two spellings stay equal.
write_action = (
    t    : Alloc,
    a    : Action,
    at   : WirePos,
    uri  : str,
    list :: Nest,
    out  :: String
) Res<(), AllocError> {
    line ::= t.String().try();
    line.add(a.name).try();
    line.add(" = ").try();
    line.add(a.module).try();
    line.add("\n").try();
    // The line is finished before its bytes are read, so the view cannot
    // outlive a growth of the buffer behind it.
    said = line.view();
    title ::= t.String().try();
    title.add("Import ").try();
    title.add(said.slice(0, said.len - 1)).try();

    list.next(out).try();
    fix ::= obj(out).try();
    fix.text("title", title.view(), out).try();
    fix.text("kind", "quickfix", out).try();
    fix.key("edit", out).try();
    edit ::= obj(out).try();
    edit.key("changes", out).try();
    changes ::= obj(out).try();
    changes.key(uri, out).try();
    edits ::= arr(out).try();
    edits.next(out).try();
    one ::= obj(out).try();
    one.key("range", out).try();
    range ::= obj(out).try();
    range.key("start", out).try();
    write_wire(at, out).try();
    range.key("end", out).try();
    write_wire(at, out).try();
    range.close(out).try();
    one.text("newText", said, out).try();
    one.close(out).try();
    edits.close(out).try();
    changes.close(out).try();
    edit.close(out).try();
    fix.close(out)
}
