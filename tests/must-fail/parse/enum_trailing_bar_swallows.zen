// the other half, and the one that documents a real cost of the
// design: a declaration does not terminate and nothing is
// newline-sensitive, so this file genuinely reads as
//
//     Shape = Circle | Square | main
//
// with a stray `=` after it. `main` is a variant here, not a
// function. that is the parser being right, not being wrong.
//
// what is asserted is only that the program is REJECTED and that one
// mistake stays one diagnostic -- the parser must not go on to report
// every later line as a consequence of a bar the author typed once.
Shape = Circle | Square |

main = (env: Env) Res<i32, ArgError> {
    Ok(0);
}
