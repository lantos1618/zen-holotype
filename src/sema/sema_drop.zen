// src/sema/sema_drop.zen
// A value the compiler drops may not be copied.
//
// Fourth of `sema_own.zen`'s rule siblings: one question asked off the
// walk that file owns. The compiler calls drop exactly once, so
// `g = f` on a Drop type cannot copy — both would drop.
//
// ONLY A PLACE IS A COPY: a call result is fresh and unnamed elsewhere,
// and passing a place to a parameter borrows rather than moves. So a
// bare name on the right of a binding is all this rule checks.
//
// An impl OF Drop, not a method named `drop` on the type itself (that
// one doesn't run at scope exit) — and only in the module that declares
// the type, since orphan impls are unwritable.
//
// Fail-open on an unknown type, for `sema_own.zen`'s reason.

Expr, Bind, Impl, Span = std.ast
Call, Record = std.ast.ast_node
ExprId = std.ast.ast_id
AllocError = std.mem
Vec = std.collections
str = std.text
ImplId = sema.sema_id
TyId, TyNamed = sema.sema_ty
Checker, Ctx = sema.sema_check
SemaFault, NameFault = sema.sema_diag
Own, find_var, var_type, refuse = sema.sema_own

check_drop_copy* = (c :: Checker, o :: Own, b: Bind, ctx: Ctx)
                   Res<(), AllocError> {
    node = c.tree.expr_at(b.value);
    node.kind.match({
        Name(n)   => c.drop_copy_of_name(o, node, n.text),
        // A construction or array literal copies each element's bytes, so
        // a Drop place smuggled inside one makes two live owners — the
        // same defect as `g = f`, one node deeper. `own_expr` has already
        // read every payload (a moved-out place is refused there); what
        // is left standing is live, and only `consume` may hand it over.
        Record(r) => c.drop_copy_of_record(o, r),
        Array(a)  => c.drop_copy_of_elems(o, a.elems),
        _         => Ok(()),
    })
}

// Every field value of a brace literal is copied into the new value.
drop_copy_of_record* = (c :: Checker, o :: Own, r: Record)
                        Res<(), AllocError> {
    ids ::= c.alloc.Vec<ExprId>();
    r.entries.loop((h, m) {
        m.kind.match({
            Field(f)    => f.value.match({
                Ok(v) => ids.add(v),
                None  => Ok(()),
            }),
            Const(_)    => Ok(()),
            Function(_) => Ok(()),
        }).try()
    });
    c.drop_copy_of_elems(o, ids)
}

// Every element of an array literal is copied into the new array.
drop_copy_of_elems* = (c :: Checker, o :: Own, elems: Vec<ExprId>)
                       Res<(), AllocError> {
    elems.loop((h, e) { c.drop_copy_of_elem(o, e).try() });
    Ok(())
}

drop_copy_of_elem = (c :: Checker, o :: Own, id: ExprId)
                     Res<(), AllocError> {
    node = c.tree.expr_at(id);
    node.kind.match({
        Name(n) => c.refuse_if_drop(node.span, var_type(o, n.text), n.text),
        _       => Ok(()),
    })
}

// A CONSTRUCTION CALL copies every argument's bytes into the new value,
// so a live Drop place in one of them is `g = f` one node deeper.
// ONLY a construction: `Keeper(n: v)`, `Ok(v)` / `Err(e)`, and a payload
// variant (`Slot.Big(cell)`). A plain call's parameters BORROW per
// DESIGN.md, so `sink(w)` on a Drop value stays legal — the receiver
// rides outside `k.args`, and the callee's frame never owns a borrow.
drop_copy_of_ctor* = (c :: Checker, o :: Own, id: ExprId, k: Call)
                      Res<(), AllocError> {
    c.tree.expr_at(k.callee).kind.match({
        Name(n)   => {
            is_res = n.text.eq("Ok") || n.text.eq("Err");
            ((is_res || c.is_construction(id)) == false).match({
                true  => Ok(()),
                false => c.drop_copy_of_args(o, k),
            })
        },
        Access(a) => {
            ty    = c.place_type(o, a.base);
            drops = c.is_drop_type(ty).try();
            drops.match({
                false => Ok(()),
                true  => c.drop_copy_of_args(o, k),
            })
        },
        _         => Ok(()),
    })
}

drop_copy_of_args = (c :: Checker, o :: Own, k: Call)
                     Res<(), AllocError> {
    ids ::= c.alloc.Vec<ExprId>();
    k.args.loop((h, a) { ids.add(a.value).try() });
    c.drop_copy_of_elems(o, ids)
}

// A name this frame does not bind is a global or a constant, and it is
// not a place this rule has an opinion about.
drop_copy_of_name = (c :: Checker, o :: Own, node: Expr, text: str)
                    Res<(), AllocError> {
    find_var(o, text).match({
        None  => Ok(()),
        Ok(_) => c.refuse_if_drop(node.span, var_type(o, text), text),
    })
}

refuse_if_drop = (c :: Checker, span: Span, ty: TyId, text: str)
                 Res<(), AllocError> {
    drops = c.is_drop_type(ty).try();
    drops.match({
        false => Ok(()),
        true  => c.refuse(
            span,
            SemaFault.CopyOfDropValue(NameFault(name: text))
        ),
    })
}

// Whether an impl OF Drop exists for this type.
is_drop_type* = (c :: Checker, ty: TyId) Res<bool, AllocError> {
    c.types.at(ty).match({
        Named(n) => c.named_is_drop(n),
        _        => Ok(false),
    })
}

named_is_drop = (c :: Checker, n: TyNamed) Res<bool, AllocError> {
    ids ::= c.alloc.Vec<ImplId>();
    c.world.impls_named(c.tree, n.name, ids).try();
    hits ::= c.alloc.Vec<bool>();
    ids.loop((h, id) { c.keep_drop_impl(n, id, hits).try() });
    Ok(hits.len > 0);
}

keep_drop_impl = (c :: Checker, n: TyNamed, id: ImplId, hits :: Vec<bool>)
                 Res<(), AllocError> {
    (n.decl.module == id.decl.module).match({
        false => Ok(()),
        true  => c.note_drop_impl(id, hits),
    })
}

note_drop_impl = (c :: Checker, id: ImplId, hits :: Vec<bool>)
                 Res<(), AllocError> {
    c.world.impl_at(c.tree, id).match({
        None   => Ok(()),
        Ok(im) => c.add_if_drop(im, hits),
    })
}

add_if_drop = (c :: Checker, im: Impl, hits :: Vec<bool>)
              Res<(), AllocError> {
    c.bound_named_drop(im).match({
        false => Ok(()),
        true  => hits.add(true),
    })
}

bound_named_drop = (c :: Checker, im: Impl) bool {
    c.tree.type_at(im.bound).kind.match({
        Named(n) => n.name.text.eq("Drop"),
        _        => false,
    })
}
