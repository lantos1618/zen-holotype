// Written callback types settle generic arguments before literals default.
apply = <T>(value: T, body: (value: T) T) T { body(value) }

main = (env: Env) Res<i32, AllocError> {
    by_param     = apply(5, (value: usize) { value + 2 });
    by_return    = apply(5, (value) usize { value + 3 });
    explicit     = apply<usize>(5, (value: usize) { value + 4 });
    typed: usize = 5;
    concrete     = apply(typed, (value: usize) { value + 5 });
    println("{} {} {} {}", by_param, by_return, explicit, concrete);
    Ok(0)
}
