// `Codepoints.next` must advance `at` by the width of the sequence it
// just decoded -- 2, 5, 9, 10 across this string -- not by a fixed step.
// A walk that always stepped 1 would decode continuation bytes as leads
// and print garbage; one that cached the LAST width (or reset to 1)
// lands every later offset short. The byte count 10 at the end is what
// `len` says independently; the three intermediate offsets are only
// correct if each step was exactly right.
Utf8Error = std.text.text_utf8

main = (env: Env) Res<i32, Utf8Error> {
    s = "é€😀x";
    walk ::= s.codepoints();
    first ::= walk.next().try();
    println("{} at {}", first, walk.at);
    second ::= walk.next().try();
    println("{} at {}", second, walk.at);
    third ::= walk.next().try();
    println("{} at {}", third, walk.at);
    fourth ::= walk.next().try();
    println("{} at {}", fourth, walk.at);
    println("done: {}", walk.is_done());
    Ok(0);
}
