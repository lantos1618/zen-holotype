// wordfreq.zen — the "real program" a newcomer wants: read all of stdin, split it
// into whitespace-separated words, count each word in an HMap<string_view, i64>, then print
// every distinct word with its count (in first-seen order) plus a distinct-word total.
//
//   $ printf 'the cat sat on the mat the cat\n' | zenc run examples/wordfreq.zen
//   the: 3
//   cat: 2
//   sat: 1
//   on: 1
//   mat: 1
//   5 distinct words
//
// Reads stdin -> std.text.str.words (splits on runs of whitespace, drops empties)
// -> HMap<string_view, i64> counting with get_or + put -> HMap.each to print.
halloc = std.mem.heap
hm = std.collections.hmap
{ HMap } = std.collections.hmap
{ read_all } = std.io.stdin
{ words } = std.text.str
{ Result, IoError } = std.core.result
{ formatln, arg_int, arg_str } = std.text.fmt
// Bump the count for one word: `get_or(w, 0)` reads the current count (0 if absent),
// `put` writes count+1 back. Threading the map through keeps it a pure value.
bump<A> = (a: MutPtr<A>, m: hm.HMap<string_view, i64>, w: string_view) hm.HMap<string_view, i64> { m.put(a, w, m.get_or(w, 0) + 1).expect("wordfreq: put failed") }
main = () i32 {
    heap := halloc.gpa()
    a := heap.addr()
    // slurp stdin into one owned str, then split it into words.
    text := a.read_all().expect("wordfreq: reading stdin failed")
    ws: [string_view] := a.words(text)
    // empty HMap: K/V live only in the return type, so pin them with the two-step
    // annotation (a one-line .expect chain can't reach them).
    r: Result<HMap<string_view, i64>, IoError> := hm.empty(a)
    m := r.expect("wordfreq: empty failed")
    ws.loop((h, i, w) {
        m = a.bump(m, w)
    })
    // print each distinct word and its count, in first-seen (insertion) order.
    // formatln gives explicit control over the word/count layout.
    m.each((k, v) { formatln("{}: {}", [arg_str(k), arg_int(v)]) })
    formatln("{} distinct words", [arg_int(m.len())])
    m.free(a)
    0
}
