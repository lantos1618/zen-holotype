// The `;` is the whole difference between a print and a return.
//
// DESIGN.md lets a `;`-terminated last statement close a function --
// "`0;` closes a `Res<i32, E>` function like `Ok(0);` does" -- so the
// AST hands the last statement over as the tail either way, and sema
// cannot read `println("noisy");` as the value `noisy` returns. A last
// statement that yields NOTHING is a statement.
//
// Written without the `;` it IS the return, and then it must fit:
// must-fail/sema/print_sugar_returns_nothing is the same two lines with
// one byte removed.

CfgError = Missing | Bad

noisy = () i32 {
    println("noisy");
}

main = (env: Env) Res<i32, CfgError> {
    noisy();
    println("done");
    Ok(0);
}
