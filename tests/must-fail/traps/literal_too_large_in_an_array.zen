// tests/must-fail/traps/literal_too_large_in_an_array.zen
// the same rule again, at the one position BOTH compilers truncated —
// so no differential run could see it, and only a test that asserts the
// rejection can. an element meets the element type with no assignment,
// no parameter and no field name anywhere in sight

// main must name an error type. a trap never lifts into Res:
// it aborts the process
Error = Overflow | DivideByZero | OutOfBounds

main = (env: Env) Res<i32, Error> {
    arr = [i32, 2](1, 2147483648);
    v = arr[1];
    println("{}", v);
    Ok(0);
}
