// tests/must-fail/sema/construction_inference_names_no_member.zen
//
// The inference face of the construction-name rule. A GENERIC
// construction written with no type arguments settles them through
// `unify_ctor_field`, whose member lookup answered None -- a name the
// type declares no member of -- with "nothing to see". It is alive only
// because `construct` runs `check_ctor_fields` between inference and
// `check_ctor_shape`, and the gate refuses the argument first; this file
// pins that ordering from the outside. With the gate lifted, `m: 100`
// compiles, stores nothing, and `held`'s construction proceeds as if the
// argument had landed.
//
// position: the argument's name.

Box<T> = {
    held: T,
}

main = (env: Env) Res<i32, AllocError> {
    b = Box(held: 1, m: 100);
    println("{}", b.held);
    Ok(0);
}
