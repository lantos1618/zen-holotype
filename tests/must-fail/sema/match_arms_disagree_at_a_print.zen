// MUST FAIL: two arms of a `.match` disagree, and the match is an
// argument to the PRINT SUGAR.
//
// `println(..)` resolves against no declaration — "no declaration of
// that name exists to resolve against", `sema_call.print_or_call` — so
// it has no parameter list, `param_literal` never walks its arguments,
// and this is the one call shape where an argument is owed nothing by
// anybody. The arms are then their own authority, as at an untyped
// binding.
//
// THE CHEAPEST WAY TO WRITE THE BUG, which is why it is worth its own
// file: every other `match_arms_disagree*` needs a function to carry the
// value somewhere. This one is a single line, and it printed 0.
f = (b: bool) i32 {
    println("{}", b.match({
        true  => 1,
        false => false,
    }));
    0;
}

main = (env: Env) Res<i32, ArgError> {
    println("{}", f(false));
    Ok(0);
}
