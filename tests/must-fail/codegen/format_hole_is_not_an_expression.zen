// `{p.x}` — REFUSED, and refusing it is the design decision.
//
// A format hole is `{}` or `{name}` and nothing else. A field read, a
// call, an operator: each would make the format string a second
// expression language with its own parser, its own precedence and its
// own diagnostics, and none of that is bought by the syntax it saves.
//
// SO THE REFUSAL IS THE FEATURE, not a gap. The rule that makes it
// statable is that a `{` FOLLOWED BY AN IDENTIFIER CHARACTER always
// meant a hole — so a near miss cannot fall back to printing itself,
// which is the wrong answer nobody reads twice: `{p.x}` appearing
// verbatim in the output looks like the author's own text. A lone `{` is
// untouched by that, because nothing an identifier could begin follows
// it, and `Display.dump` still writes `sb.add("{} {", ..)`.
//
// `{{p.x}` is the fix at such a site, and the escape is why the
// refusal costs the author nothing.
//
// position: the `{` that opened nothing, on each of the two lines.

Point = { x: i32, y: i32 }

main = (env: Env) Res<i32, IoError> {
    p = Point(x: 1, y: 2);
    println("at {p.x}");
    println("{width()}");
    println("{ p } is a brace, a space and a name");
    Ok(0);
}
