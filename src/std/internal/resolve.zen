// @self-hosted-only
// Public facade — explicit re-exports from std.internal.resolve.* submodules.
{ Malloc, Allocator } = std.mem.alloc
{ Result, IoError } = std.core.result
{ String } = std.text.string
{ Decl } = compiler.genc
{ Map } = std.collections.map
{ eq } = std.text.str
_scan = std.internal.resolve.scan
_core = std.internal.resolve.core
_lmap = std.internal.resolve.lmap
_prog = std.internal.resolve.program
_util = std.internal.resolve.util
SIG_PUB := 1
SIG_TYPE := 2
SIG_IMPORTED := 4
SIG_FOREIGN := 8
ImportEdge*: {
    module: string_view,
    alias: string_view,
    namespace: bool,
    start: i32,
    next: i32,
}
ProvidedSymbol*: {
    name: string_view,
    start: i32,
    next: i32,
    decl_start: i32,
    decl_next: i32,
    imported: bool,
    foreign: bool,
    is_type: bool,
    is_pub: bool,
}
ModuleSig*: {
    names: Map<i64>,
    has = (s: ModuleSig, name: string_view) bool { s.names.has(name) }
    flags = (s: ModuleSig, name: string_view) i64 { s.names.get(name, 0 - 1) }
    private = (s: ModuleSig, name: string_view) bool {
        f := s.names.get(name, 0 - 1)
        (f < 0).match ({
            true  => false,
            false => f / SIG_IMPORTED % 2 == 0 && f / SIG_PUB % 2 == 0,
        })
    }
    exports_value = (s: ModuleSig, name: string_view) bool {
        f := s.names.get(name, 0 - 1)
        (f < 0).match ({
            true  => false,
            false => f / SIG_PUB % 2 == 1 && f / SIG_IMPORTED % 2 == 0 && f / SIG_TYPE % 2 == 0,
        })
    }
}
ModuleGraph*: {
    imports: [ImportEdge],
    symbols: [ProvidedSymbol],
    sig: ModuleSig,
    import_count = (g: ModuleGraph) i64 { g.imports.len }
    symbol_count = (g: ModuleGraph) i64 { g.symbols.len }
    has = (g: ModuleGraph, name: string_view) bool { g.sig.has(name) }
}
ModuleEntry*: {
    id: string_view,
    path: string_view,
    source: string_view,
    graph: ModuleGraph,
}
ModuleTable*: {
    modules: [ModuleEntry],
    count = (t: ModuleTable) i64 { t.modules.len }
    has = (t: ModuleTable, id: string_view) bool {
        found := false
        t.modules.loop((h, i, m) {
            found = eq(m.id, id).match ({ true => true, false => found })
        })
        found
    }
    has_id = (t: ModuleTable, id: String) bool {
        found := false
        t.modules.loop((h, i, m) {
            found = id.string_eq_str(m.id).match ({ true => true, false => found })
        })
        found
    }
    module = (t: ModuleTable, id: string_view) ModuleEntry {
        found := t.modules[0]
        t.modules.loop((h, i, m) {
            found = eq(m.id, id).match ({ true => m, false => found })
        })
        found
    }
    module_id = (t: ModuleTable, id: String) ModuleEntry {
        found := t.modules[0]
        t.modules.loop((h, i, m) {
            found = id.string_eq_str(m.id).match ({ true => m, false => found })
        })
        found
    }
    index_of_id = (t: ModuleTable, id: String) i64 {
        found := 0 - 1
        t.modules.loop((h, i, m) {
            (found < 0 && id.string_eq_str(m.id)).then({
                found = i
            })
        })
        found
    }
}
FlatRegion*: {
    midx: i64,
    lo: i64,
    hi: i64,
    line_lo: i64,
    line_n: i64,
}
ResolvedProgram*: {
    table: ModuleTable,
    flat: string_view,
    body_start: i64,
    body_end: i64,
    regions: [FlatRegion],
    line_srcs: [i32],
}
ParsedModule*: {
    id: string_view,
    path: string_view,
    source: string_view,
    body: string_view,
    graph: ModuleGraph,
    decls: [Decl],
}
ParsedProgram*: {
    resolved: ResolvedProgram,
    modules: [ParsedModule],
    flat_decls: [Decl],
    count = (p: ParsedProgram) i64 { p.modules.len }
    module = (p: ParsedProgram, id: string_view) ParsedModule {
        found := p.modules[0]
        p.modules.loop((h, i, m) {
            found = eq(m.id, id).match ({ true => m, false => found })
        })
        found
    }
}
NsScan*: {
    quals: String,
    qnames: String,
    strip_qnames: String,
    strip_all_quals: String,
    c: _scan.Closure,
}
ShadowFlat*: {
    flat: string_view,
    bodyend: i64,
    renamed: bool,
}
is_import_line* = (s: string_view, p: i32) bool { _scan.is_import_line(s, p) }
is_ns_line* = (s: string_view, p: i32) bool { _scan.is_ns_line(s, p) }
strip_count* = (s: string_view, p: i32, n: i32) i32 { _scan.strip_count(s, p, n) }
strip_imports* = (out: String, a: MutPtr<Malloc>, s: string_view) String { _scan.strip_imports(out, a, s) }
concat_files* = (out: String, a: MutPtr<Malloc>, left: string_view, right: string_view) String { _scan.concat_files(out, a, left, right) }
seen_name* = (set: String, name: String) bool { _scan.seen_name(set, name) }
add_name* = (set: String, a: MutPtr<Malloc>, name: String) String { _scan.add_name(set, a, name) }
decl_names_in* = (g: ModuleGraph, a: MutPtr<Malloc>) String { _scan.decl_names_in(g, a) }
value_decl_names_in* = (g: ModuleGraph, a: MutPtr<Malloc>) String { _scan.value_decl_names_in(g, a) }
all_decl_names_in* = (g: ModuleGraph, a: MutPtr<Malloc>) String { _scan.all_decl_names_in(g, a) }
file_exists* = (path: string_view) bool { _scan.file_exists(path) }
import_module* = (out: String, a: MutPtr<Malloc>, s: string_view, p: i32) String { _scan.import_module(out, a, s, p) }
import_edge_count* = (src: string_view) i32 { _scan.import_edge_count(src) }
import_edges* = (a: MutPtr<A>, src: string_view) Result<[ImportEdge], IoError> { _scan.import_edges(a, src) }
module_path* = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, id: String) string_view { _scan.module_path(a, root, progdir, id) }
module_graph* = (a: MutPtr<Malloc>, src: string_view) ModuleGraph { _core.module_graph(a, src) }
module_graph_in* = (a: MutPtr<Malloc>, alloc: MutPtr<A>, src: string_view) ModuleGraph { _core.module_graph_in(a, alloc, src) }
first_user_import_in* = (a: MutPtr<Malloc>, src: string_view) string_view { _core.first_user_import_in(a, src) }
first_user_import* = (src: string_view) string_view { _core.first_user_import(src) }
dedup_decls* = (a: MutPtr<Malloc>, flat: string_view, bodystart: i64, bodyend: i64) string_view { _core.dedup_decls(a, flat, bodystart, bodyend) }
dedup_impls* = (a: MutPtr<Malloc>, table: ModuleTable, flat: string_view) string_view { _core.dedup_impls(a, table, flat) }
ns_qualifier* = (out: String, a: MutPtr<Malloc>, s: string_view, p: i32) String { _core.ns_qualifier(out, a, s, p) }
strip_ns_into* = (out: String, a: MutPtr<Malloc>, s: string_view, p: i32, quals: String, qnames: String, strip_qnames: String, strip_all_quals: String, first: bool) String { _core.strip_ns_into(out, a, s, p, quals, qnames, strip_qnames, strip_all_quals, first) }
parse_resolved_program* = (a: MutPtr<Malloc>, resolved: ResolvedProgram, inpath: string_view) ParsedProgram { _core.parse_resolved_program(a, resolved, inpath) }
module_link_count* = (a: MutPtr<Malloc>, p: ParsedProgram, m: ParsedModule) i64 { _core.module_link_count(a, p, m) }
module_link_decls* = (a: MutPtr<Malloc>, p: ParsedProgram, m: ParsedModule) [Decl] { _core.module_link_decls(a, p, m) }
root_link_count* = (a: MutPtr<Malloc>, p: ParsedProgram) i64 { _core.root_link_count(a, p) }
root_link_decls* = (a: MutPtr<Malloc>, p: ParsedProgram) [Decl] { _core.root_link_decls(a, p) }
check_parsed_program* = (a: MutPtr<Malloc>, p: ParsedProgram) i32 { _core.check_parsed_program(a, p) }
check_parsed_program_kind* = (a: MutPtr<Malloc>, p: ParsedProgram) i32 { _core.check_parsed_program_kind(a, p) }
check_all_parsed_modules* = (a: MutPtr<Malloc>, p: ParsedProgram) i32 { _core.check_all_parsed_modules(a, p) }
check_all_parsed_modules_kind* = (a: MutPtr<Malloc>, p: ParsedProgram) i32 { _core.check_all_parsed_modules_kind(a, p) }
enforce_visibility* = (a: MutPtr<Malloc>, table: ModuleTable, report: bool) i32 { _core.enforce_visibility(a, table, report) }
enforce_private_leaks* = (a: MutPtr<Malloc>, table: ModuleTable, report: bool) i32 { _core.enforce_private_leaks(a, table, report) }
enforce_ffi_grants* = (a: MutPtr<Malloc>, table: ModuleTable, mainsrc: string_view, report: bool) i32 { _core.enforce_ffi_grants(a, table, mainsrc, report) }
module_table_graph* = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, inpath: string_view, mainsrc: string_view, graph: ModuleGraph) ModuleTable { _core.module_table_graph(a, root, progdir, inpath, mainsrc, graph) }
module_table* = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, inpath: string_view, mainsrc: string_view) ModuleTable { _core.module_table(a, root, progdir, inpath, mainsrc) }
provided_symbol_count* = (a: MutPtr<Malloc>, src: string_view) i32 { _core.provided_symbol_count(a, src) }
provided_symbols_in* = (a: MutPtr<Malloc>, alloc: MutPtr<A>, src: string_view) Result<[ProvidedSymbol], IoError> { _core.provided_symbols_in(a, alloc, src) }
provided_symbols* = (a: MutPtr<Malloc>, src: string_view) Result<[ProvidedSymbol], IoError> { _core.provided_symbols(a, src) }
symbol_key_in* = (s: ProvidedSymbol, a: MutPtr<A>) Result<String, IoError> { _core.symbol_key_in(s, a) }
fregion_find* = (regions: [FlatRegion], off: i64) i64 { _lmap.fregion_find(regions, off) }
fregion_src_line* = (regions: [FlatRegion], line_srcs: [i32], flat: string_view, ri: i64, off: i64) i32 { _lmap.fregion_src_line(regions, line_srcs, flat, ri, off) }
undefined_name_hint* = (a: MutPtr<Malloc>, table: ModuleTable, flat: string_view, off: i32) string_view { _prog.undefined_name_hint(a, table, flat, off) }
resolve_program_data* = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, inpath: string_view, mainsrc: string_view) ResolvedProgram { _prog.resolve_program_data(a, root, progdir, inpath, mainsrc) }
resolve_program* = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, inpath: string_view, mainsrc: string_view) string_view { _prog.resolve_program(a, root, progdir, inpath, mainsrc) }
resolve_parsed_program* = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, inpath: string_view, mainsrc: string_view) ParsedProgram { _prog.resolve_parsed_program(a, root, progdir, inpath, mainsrc) }
ffi_grants_set* = (g: string_view) void { _util.ffi_grants_set(g) }
ffi_grants_get* = () string_view { _util.ffi_grants_get() }
genmods_set* = (g: string_view) void { _util.genmods_set(g) }
genmods_get* = () string_view { _util.genmods_get() }
