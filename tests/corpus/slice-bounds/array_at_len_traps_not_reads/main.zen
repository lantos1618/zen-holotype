// THE OFF-BY-ONE THE COMPARISON SIGN DECIDES. The runtime check is
// `i >= len` (zg_idx_u, gen_c_runtime.zen); a `>` written there instead
// lets an index EQUAL to the length through and reads one element past
// the end -- no diagnostic, and a plausible number, which is exactly the
// silent-zero failure mode this tree has been burned by before.
//
// traps/index_at_len_runtime.zen already hides the index from the
// literals-only prover behind env.vars; this one hides it behind a CALL
// PARAMETER -- the other boundary the literals-only discipline stops at,
// and the shape user code actually writes. 4 on a length of 4 must trap;
// a check grown one size too wide prints 0 here instead of failing.
//
// stdout carries only what ran before the trap: zg_trap flushes stdout
// before exiting, so the last IN-RANGE element is the expectation, and
// any run reaching the println below adds a line no correct build has.

// a trap never lifts into Res: it aborts the process
Error = Overflow | DivideByZero | OutOfBounds

at = (a: [i32, 4], i: usize) i32 { a[i] }

main = (env: Env) Res<i32, Error> {
    primes = [i32, 4](2, 3, 5, 7);
    println("{}", primes[3]);
    at(primes, 4);
    println("unreachable");
    Ok(0);
}
