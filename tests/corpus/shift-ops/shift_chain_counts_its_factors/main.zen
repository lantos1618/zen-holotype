// A CHAIN OF SHIFTS COUNTS ITS FACTORS — EVERY ONE, IN ORDER, PER TYPE.
//
// "shift by k" spelled Zen's way is k factors of the base folded left:
// `a *% a *% a ...` seven deep on a u8. The count is the whole test. The
// classic lowering bug is an off-by-one at either end of the chain —
// emitting one factor fewer (reading the count as exclusive) or one
// more (folding the base twice) — and both wrong answers are ordinary
// bytes: 139 where 161 belongs, 227 where 169 belongs. Nothing rejects,
// nothing traps; only the digits move.
//
// each width runs its chain to a DIFFERENT depth relative to its own
// BITS, so no single constant-table fix can satisfy all five lines at
// once: u8 goes one PAST its width (7, 8, 9), i32 stops exactly one
// before and exactly at (30, 31, 32), i64 crosses at (63, 64). The
// values are hand-computed residues of 3^n mod 2^BITS; the i64 pair is
// printed unsigned-large on purpose, since the interesting bit there is
// bit 63 surviving into a positive number.
//
// one-line break: make the fold walk `count - 1` steps instead of
// `count` (or reuse a scratch slot so the last factor multiplies the
// ORIGINAL operand) and every line below prints its neighbour's number.

main = (env: Env) Res<i32, AllocError> {
    e8:  u8  = 3;
    e16: u16 = 3;
    e32: u32 = 3;
    s32: i32 = 3;
    s64: i64 = 3;

    println("u8-7 {}", e8 *% e8 *% e8 *% e8 *% e8 *% e8 *% e8);
    println("u8-8 {}", e8 *% e8 *% e8 *% e8 *% e8 *% e8 *% e8 *% e8);
    println("u8-9 {}", e8 *% e8 *% e8 *% e8 *% e8 *% e8 *% e8 *% e8 *% e8);

    println("u16-10 {}", e16 *% e16 *% e16 *% e16 *% e16 *% e16 *% e16 *% e16 *% e16 *% e16);

    println("u32-30 {}", e32 *% e32 *% e32 *% e32 *% e32 *% e32 *% e32 *% e32 *% e32 *% e32 *%
                         e32 *% e32 *% e32 *% e32 *% e32 *% e32 *% e32 *% e32 *% e32 *% e32 *%
                         e32 *% e32 *% e32 *% e32 *% e32 *% e32 *% e32 *% e32 *% e32 *% e32);
    println("i32-31 {}", s32 *% s32 *% s32 *% s32 *% s32 *% s32 *% s32 *% s32 *% s32 *% s32 *%
                         s32 *% s32 *% s32 *% s32 *% s32 *% s32 *% s32 *% s32 *% s32 *% s32 *%
                         s32 *% s32 *% s32 *% s32 *% s32 *% s32 *% s32 *% s32 *% s32 *% s32 *%
                         s32);
    println("i32-32 {}", s32 *% s32 *% s32 *% s32 *% s32 *% s32 *% s32 *% s32 *% s32 *% s32 *%
                         s32 *% s32 *% s32 *% s32 *% s32 *% s32 *% s32 *% s32 *% s32 *% s32 *%
                         s32 *% s32 *% s32 *% s32 *% s32 *% s32 *% s32 *% s32 *% s32 *% s32 *%
                         s32 *% s32);
    println("i64-63 {}", s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *%
                         s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *%
                         s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *%
                         s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *%
                         s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *%
                         s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *%
                         s64 *% s64 *% s64);
    println("i64-64 {}", s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *%
                         s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *%
                         s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *%
                         s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *%
                         s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *%
                         s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *% s64 *%
                         s64 *% s64 *% s64 *% s64);

    Ok(0);
}
