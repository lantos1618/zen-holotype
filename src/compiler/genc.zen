// compiler.genc — AST constructors + shared base helpers (constructors-only since the
// type definitions moved to compiler.ast.ast_types).
//
// The AST TYPES (Expr/Stmt/Ty/Decl + their *Data payloads) live in compiler.ast.ast_types;
// this module keeps everything with logic: the value constructors (vref/bin_at/call_full/…),
// the canonical allocator-explicit String builder (gstr_*), the pointer-kind constants,
// C-type-name helpers, and the tparam→arg type substitution shared by check and mono.
{ Expr, VarData, BinData, CallData, MethodCallData, CondData, MemberData, ArrowData, MakeEnumData,
  MakeStructData, FieldInit, TagData, ArmData, MatchData, StrData, SliceData, IndexData, LoopData,
  LambdaData, BlockData, Stmt, LetData, AssignData, IfData, WhileData, IndexSetData, Ty, FnTData,
  GenericData, PtrData, Param, Func, Field, StructDecl, GenStructDecl, VariantDef, EnumDecl,
  GenEnumDecl, ImplData, ImportData, GlobalData, TraitDefData, Decl } = compiler.ast.ast_types
{ String } = std.text.string
{ view } = std.text.str
{ Malloc, malloc, realloc } = std.mem.alloc
// mangle_str_in lives in compiler.mangle (the Ty→C-name family split out of this file); subst_generic_in
// re-mangles a nested generic instance after substitution. compiler.mangle imports the shared AST
// types from compiler.ast.ast_types and this file's buffer helpers back — a cycle the flat
// translation unit tolerates.
{ mangle_str_in } = compiler.mangle
// ── shared low-level helpers ────────────────────────────────────────────────
// cbuf<T>: allocate a fresh `[T]` buffer of n elements. ONE generic replaces the ~20 per-type
// `Xbuf = (a, n) [X] { slice(a.acquire(n * sizeof(X)), n) }` copies that used to live across the
// compiler. T sits only in return position, so callers pass an explicit turbofish: `cbuf<Ty>(a, n)`.
cbuf*<T> = (a: MutPtr<Malloc>, n: i64) [T] { slice(a.acquire(n * sizeof(T)), n) }
// sbyte: the i-th byte of a string_view. ONE accessor replaces the sbyte/jbyte/dsbyte/ffbyte copies.
sbyte* = (v: string_view, i: i64) u8 { load(offset(v, i)) }
// pointer KIND tag (safety-goal-D). All three spellings still lower to `T*`; their semantic/mono
// names remain distinct so a generic wrapper cannot erase a nested capability. Direct pointer
// direction is checked by `fits`/`mode_fits`. 0=RawPtr (nullable FFI floor), 1=Ptr (read-only borrow),
// 2=MutPtr (writable borrow). Mirrors the `() i32` constant style used for the K* diag codes.
k_raw_ptr* = () i32 { 0 }
k_ptr* = () i32 { 1 }
k_mut_ptr* = () i32 { 2 }
// The canonical surface keyword for a pointer kind. Shared by the formatter and diagnostics so a
// rejected `Ptr<T>` -> `MutPtr<T>` conversion never prints two indistinguishable `Ptr<T>` types.
ptr_kw* = (kind: i32) string_view {
    (kind == k_raw_ptr()).match ({
        true  => "RawPtr",
        false => (kind == k_mut_ptr()).then({ "MutPtr" }, { "Ptr" }),
    })
}
// Compiler-owned allocations flow through these shims so stripped bootstrap drivers that do not
// flatten std.mem.alloc's trait impls still have concrete UFCS targets for Malloc.
acquire* = (a: MutPtr<Malloc>, n: i64) RawPtr<u8> { (n <= 0).then({ null_ptr() }, { malloc(n) }) }
resize = (a: MutPtr<Malloc>, p: RawPtr<u8>, n: i64) RawPtr<u8> { realloc(p, n) }
write_str* = (dst: RawPtr<u8>, at: i64, t: string_view) i64 { dst.write_str_at(at, t, 0) }
write_str_at = (dst: RawPtr<u8>, at: i64, t: string_view, i: i64) i64 {
    k := i
    @while (load(offset(t, k)) != 0) {
        dst.offset(at + k).store(load(offset(t, k)))
        k = k + 1
    }
    at + k
}    // ITERATIVE: copying a long string is O(n) iteration, not O(n) C-stack recursion
finish_buf* = (dst: RawPtr<u8>, n: i64) string_view {
    dst.offset(n).store(0)
    cstr(dst)
}
// ── THE canonical String builder: allocator-explicit + generic over the allocator type, so a caller
// passes whatever allocator it has (heap/arena/test). One implementation for the whole compiler — the
// per-module emit_*/check_*/m* builders are thin aliases onto these. Safe to inline now that the
// inliner namespaces inlined locals by their inline-marker chain (see check.inline_marks).
gstr_string*<A> = (a: MutPtr<A>, cap: i64) String {
    String(
        ptr: a.acquire(cap),
        len: 0,
        cap: cap,
    )
}
gstr_grow<A> = (a: MutPtr<A>, s: String, ncap: i64) String {
    String(
        ptr: a.resize(s.ptr, ncap),
        len: s.len,
        cap: ncap,
    )
}
gstr_reserve<A> = (a: MutPtr<A>, s: String, need: i64) String {
    out := s
    (s.len + need > s.cap).then({
        out = a.gstr_grow(s, (s.cap + need) * 2)
    })
    out
}
gstr_push*<A> = (s: String, a: MutPtr<A>, b: u8) String {
    r := a.gstr_reserve(s, 1)
    r.ptr.offset(r.len).store(b)
    String(
        ptr: r.ptr,
        len: r.len + 1,
        cap: r.cap,
    )
}
// One reserve for the WHOLE input, then a straight byte-store loop — not a gstr_push per byte,
// whose per-byte capacity check dominated self-compile profiles (gstr_append ~8.7% of samples).
// Same bytes appended, so emitted C is unchanged; only the capacity growth schedule differs.
// The [u8] form is the primitive: a caller that already knows the length (a String, a sub-slice)
// appends without re-measuring; the string_view form pays its one unavoidable strlen in view().
gstr_append_bytes*<A> = (s: String, a: MutPtr<A>, bs: [u8]) String {
    r := a.gstr_reserve(s, bs.len)
    bs.loop((h, i, b) {
        r.ptr.offset(r.len + i).store(b)
    })
    String(
        ptr: r.ptr,
        len: r.len + bs.len,
        cap: r.cap,
    )
}
gstr_append*<A> = (s: String, a: MutPtr<A>, t: string_view) String {
    s.gstr_append_bytes(a, t.view())
}
gstr_finish*<A> = (s: String, a: MutPtr<A>) string_cstr { cstr(s.gstr_push(a, 0).ptr) }
// constructors — return a value; the caller calls `.addr()` on an Expr to make a child, and
// builds the body as a slice of statements: `[slet("y", e.addr()), sret(r.addr())]`
lit* = (n: i64) Expr { .Int(n) }
byte_lit* = (n: i32) Expr { .Byte(n) }    // a char literal's byte value (typed u8 by the checker)
flit* = (t: string_view) Expr { .FloatLit(t) }    // a float literal — its lexeme text, emitted verbatim (typed f64)
vref* = (nm: string_view) Expr {
    .Var(VarData(
        name: nm,
        pos: 0,
    ))
}
vref_at* = (nm: string_view, p: i32) Expr {
    .Var(VarData(
        name: nm,
        pos: p,
    ))
}
bin_at* = (op: string_view, l: Ptr<Expr>, r: Ptr<Expr>, p: i32) Expr {
    .Bin(BinData(
        op: op,
        lhs: l,
        rhs: r,
        pos: p,
        rty: tvoid(),
    ))
}
// like bin_at but records a sub-width int RESULT type so genc re-truncates the promoted value.
bin_rty* = (op: string_view, l: Ptr<Expr>, r: Ptr<Expr>, p: i32, rt: Ty) Expr {
    .Bin(BinData(
        op: op,
        lhs: l,
        rhs: r,
        pos: p,
        rty: rt,
    ))
}
bin* = (op: string_view, l: Ptr<Expr>, r: Ptr<Expr>) Expr { bin_at(op, l, r, 0) }
// C integer promotion widens a sub-32-bit operand (u8/i8/i16/u16) to `int` for any operator, and Zen
// only narrows at a store — so a used operator RESULT leaks the un-truncated value. These name the
// types + width-preserving ops that must re-truncate; i32/u32/i64/u64 are native C widths, left alone.
subword_ty* = (t: Ty) bool {
    t.match ({
        .U8       => true,
        .Named(n) => n == "i8" || n == "i16" || n == "u16",
        _         => false,
    })
}
narrow_op* = (op: string_view) bool {
    op == "+" || op == "-" || op == "*" || op == "<<" || op == "&" || op == "|" || op == "^"
}
// result type to record on a Bin so genc re-truncates a sub-width arithmetic result; Void = no cast.
arith_rty* = (op: string_view, lty: Ty) Ty {
    (narrow_op(op) && subword_ty(lty)).then({ lty }, { tvoid() })
}
call_full* = (fn: string_view, args: [Expr], targs: [Ty], p: i32, raw: bool) Expr {
    .Call(CallData(
        fn: fn,
        args: args,
        targs: targs,
        pos: p,
        raw: raw,
    ))
}
call* = (fn: string_view, args: [Expr]) Expr { call_full(fn, args, no_tys(), 0, false) }
call_at* = (fn: string_view, args: [Expr], p: i32) Expr { call_full(fn, args, no_tys(), p, false) }
raw_call_at* = (fn: string_view, args: [Expr], p: i32) Expr {
    call_full(fn, args, no_tys(), p, true)
}
// explicit turbofish call `fn<T, …>(args)` — type args pinned at the call site.
call_targs_at* = (fn: string_view, args: [Expr], targs: [Ty], p: i32) Expr {
    call_full(fn, args, targs, p, false)
}
emcall* = (recv: Ptr<Expr>, method: string_view, args: [Expr], p: i32) Expr {
    .MethodCall(MethodCallData(
        recv: recv,
        method: method,
        args: args,
        pos: p,
    ))
}
cond* = (c: Ptr<Expr>, t: Ptr<Expr>, e: Ptr<Expr>) Expr { cond_at(c, t, e, 0, 0, 0) }
cond_oa* = (c: Ptr<Expr>, t: Ptr<Expr>, e: Ptr<Expr>, oa: i32) Expr { cond_at(c, t, e, oa, 0, 0) }
cond_at* = (c: Ptr<Expr>, t: Ptr<Expr>, e: Ptr<Expr>, oa: i32, tpos: i32, epos: i32) Expr {
    .Cond(CondData(
        c: c,
        t: t,
        e: e,
        oa: oa,
        tpos: tpos,
        epos: epos,
    ))
}
member* = (o: Ptr<Expr>, f: string_view) Expr {
    .Member(MemberData(
        obj: o,
        field: f,
        pos: 0,
    ))
}
member_at* = (o: Ptr<Expr>, f: string_view, p: i32) Expr {
    .Member(MemberData(
        obj: o,
        field: f,
        pos: p,
    ))
}
arrow* = (o: Ptr<Expr>, f: string_view) Expr {
    .Arrow(ArrowData(
        obj: o,
        field: f,
        pos: 0,
    ))
}
arrow_at* = (o: Ptr<Expr>, f: string_view, p: i32) Expr {
    .Arrow(ArrowData(
        obj: o,
        field: f,
        pos: p,
    ))
}
mkenum* = (ty: string_view, v: string_view, p: Ptr<Expr>) Expr {
    .MakeEnum(MakeEnumData(
        ty: ty,
        mty: ty,
        variant: v,
        targs: no_tys(),
        payload: p,
    ))
}
mkenumg* = (ty: string_view, mty: string_view, targs: [Ty], v: string_view, p: Ptr<Expr>) Expr {
    .MakeEnum(MakeEnumData(
        ty: ty,
        mty: mty,
        variant: v,
        targs: targs,
        payload: p,
    ))
}
finit* = (nm: string_view, v: Ptr<Expr>) FieldInit {
    FieldInit(
        name: nm,
        value: v,
    )
}
mkstruct* = (ty: string_view, inits: [FieldInit]) Expr {
    .MakeStruct(MakeStructData(
        ty: ty,
        mty: ty,
        targs: no_tys(),
        inits: inits,
        pos: 0,
    ))
}
mkstruct_at* = (ty: string_view, inits: [FieldInit], p: i32) Expr {
    .MakeStruct(MakeStructData(
        ty: ty,
        mty: ty,
        targs: no_tys(),
        inits: inits,
        pos: p,
    ))
}
mkstructg_at* = (ty: string_view, mty: string_view, targs: [Ty], inits: [FieldInit], p: i32) Expr {
    .MakeStruct(MakeStructData(
        ty: ty,
        mty: mty,
        targs: targs,
        inits: inits,
        pos: p,
    ))
}
no_tys* = () [Ty] { slice(null_ptr(), 0) }    // an empty [Ty] (non-generic literal's targs)
slit* = (elem: Ty, items: [Expr]) Expr {
    .SliceLit(SliceData(
        elem: elem,
        items: items,
    ))
}
eindex* = (seq: Ptr<Expr>, i: Ptr<Expr>, elem: Ty) Expr {
    .Index(IndexData(
        seq: seq,
        idx: i,
        elem: elem,
    ))
}
eloop* = (
    seq: Ptr<Expr>,
    idx: string_view,
    elem: string_view,
    elemTy: Ty,
    body: [Stmt],
    h: string_view,
) Expr {
    .Loop(LoopData(
        seq: seq,
        idx: idx,
        elem: elem,
        elemTy: elemTy,
        body: body,
        h: h,
    ))
}
lam_r* = (params: [Param], body: [Stmt], ret: Ty) Expr {
    .Lambda(LambdaData(
        params: params,
        body: body,
        ret: ret,
    ))
}
block* = (stmts: [Stmt]) Expr { .Block(BlockData(stmts: stmts)) }
// A braced value-position body (match/cond arm) whose LAST statement is an explicit `return`
// DIVERGES: it yields no value (control leaves the enclosing function), so it contributes nothing
// to the surrounding match/cond value type and must emit as real statements, never be flattened to
// an expression. Only arm/loop blocks (parse_block) can look like this: fn/lambda BODIES also end
// in .Return (the parser's implicit trailing return), but those never reach value positions intact —
// the inliner's blockify strips the trailing return (ret_to_expr / cps_value) before splicing.
stmts_diverge* = (stmts: [Stmt]) bool {
    (stmts.len > 0).match ({
        true  => stmts[stmts.len - 1].match ({
            .Return(r) => true,
            _          => false,
        }),
        false => false,
    })
}
blk_diverges* = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Block(b) => b.stmts.stmts_diverge(),
        _         => false,
    })
}
// is_fnt (Ty), is_generic_fn (Func), is_template/is_trait (Decl), struct_is_trait (StructDecl) and
// has_fnt_param ([Param]) moved to compiler.astops (grouped with the Ty::is_fnt trait impl they use),
// so this base module carries no reference to a method defined outside its own import closure.
fntype* = (params: [Ty], ret: Ptr<Ty>) Ty {
    .FnT(FnTData(
        params: params,
        ret: ret,
    ))
}
mktag* = (ty: string_view, v: string_view) Expr {
    .Tag(TagData(
        ty: ty,
        mty: ty,
        variant: v,
        targs: no_tys(),
    ))
}
mktagg* = (ty: string_view, mty: string_view, targs: [Ty], v: string_view) Expr {
    .Tag(TagData(
        ty: ty,
        mty: mty,
        variant: v,
        targs: targs,
    ))
}
arm* = (v: string_view, bind: string_view, body: Ptr<Expr>) ArmData {
    ArmData(
        variant: v,
        bind: bind,
        body: body,
        pos: 0,
    )
}
arm_at* = (v: string_view, bind: string_view, body: Ptr<Expr>, p: i32) ArmData {
    ArmData(
        variant: v,
        bind: bind,
        body: body,
        pos: p,
    )
}    // source-backed (formatter anchors arm comments)
ematch* = (subj: Ptr<Expr>, ename: string_view, arms: [ArmData]) Expr {
    .Match(MatchData(
        subj: subj,
        ename: ename,
        arms: arms,
        ptr: false,
    ))
}
ematchp* = (subj: Ptr<Expr>, ename: string_view, arms: [ArmData]) Expr {
    .Match(MatchData(
        subj: subj,
        ename: ename,
        arms: arms,
        ptr: true,
    ))
}
strlit_at* = (v: string_view, p: i32) Expr {
    .StrLit(StrData(
        value: v,
        pos: p,
    ))
}    // a source-backed string literal
tstring_view* = () Ty { .StringView }
tstring_cstr* = () Ty { .StringCstr }
tstring_literal* = () Ty { .StringLiteral }
tstr* = () Ty { .StringView }    // deprecated alias → string_view
slet* = (nm: string_view, v: Ptr<Expr>) Stmt {
    .Let(LetData(
        name: nm,
        ty: tvoid(),
        value: v,
        pos: 0,
    ))
}
slett* = (nm: string_view, t: Ty, v: Ptr<Expr>) Stmt {
    .Let(LetData(
        name: nm,
        ty: t,
        value: v,
        pos: 0,
    ))
}    // a TYPED let
slet_at* = (nm: string_view, v: Ptr<Expr>, p: i32) Stmt {
    .Let(LetData(
        name: nm,
        ty: tvoid(),
        value: v,
        pos: p,
    ))
}    // source-backed let (formatter needs the name position)
slett_at* = (nm: string_view, t: Ty, v: Ptr<Expr>, p: i32) Stmt {
    .Let(LetData(
        name: nm,
        ty: t,
        value: v,
        pos: p,
    ))
}
sret* = (v: Ptr<Expr>) Stmt { .Return(v) }
sexpr* = (v: Ptr<Expr>) Stmt { .ExprStmt(v) }    // a bare expression evaluated for effect
sassign* = (tgt: Ptr<Expr>, v: Ptr<Expr>) Stmt {
    .Assign(AssignData(
        target: tgt,
        value: v,
        pos: 0,
    ))
}
sassign_at* = (tgt: Ptr<Expr>, v: Ptr<Expr>, p: i32) Stmt {
    .Assign(AssignData(
        target: tgt,
        value: v,
        pos: p,
    ))
}
sidxset_at* = (seq: Ptr<Expr>, i: Ptr<Expr>, elem: Ty, v: Ptr<Expr>, p: i32) Stmt {
    .IndexSet(IndexSetData(
        seq: seq,
        idx: i,
        elem: elem,
        value: v,
        pos: p,
    ))
}
sif* = (c: Ptr<Expr>, t: [Stmt], e: [Stmt]) Stmt {
    .If(IfData(
        c: c,
        then: t,
        els: e,
    ))
}
swhile* = (c: Ptr<Expr>, b: [Stmt]) Stmt {
    .While(WhileData(
        c: c,
        body: b,
    ))
}
ti32* = () Ty { .I32 }
ti64* = () Ty { .I64 }
tu8* = () Ty { .U8 }
tf64* = () Ty { .F64 }
tbool* = () Ty { .Bool }
tnamed* = (n: string_view) Ty { .Named(n) }
tgeneric* = (nm: string_view, args: [Ty], mangled: string_view) Ty {
    .Generic(GenericData(
        name: nm,
        args: args,
        mangled: mangled,
    ))
}
tptr* = (t: Ptr<Ty>) Ty {
    .Ptr(PtrData(
        pointee: t,
        kind: k_mut_ptr(),
    ))
}
tptr_k* = (t: Ptr<Ty>, k: i32) Ty {
    .Ptr(PtrData(
        pointee: t,
        kind: k,
    ))
}
tslice* = (e: Ptr<Ty>) Ty { .Slice(e) }
param* = (nm: string_view, t: Ty) Param {
    Param(
        name: nm,
        ty: t,
        variadic: false,
    )
}
pvariadic* = (nm: string_view, t: Ty) Param {
    Param(
        name: nm,
        ty: t,
        variadic: true,
    )
}    // a `...T` param: ty = the collected `[T]`
field* = (nm: string_view, t: Ty) Field {
    Field(
        name: nm,
        ty: t,
    )
}
sdef* = (nm: string_view, fs: [Field]) StructDecl {
    StructDecl(
        name: nm,
        fields: fs,
        pos: 0,
    )
}
sdef_at* = (nm: string_view, fs: [Field], p: i32) StructDecl {
    StructDecl(
        name: nm,
        fields: fs,
        pos: p,
    )
}    // source-backed (formatter anchors a leading comment above the struct)
gsdef_at* = (nm: string_view, tps: [Param], fs: [Field], p: i32) GenStructDecl {
    GenStructDecl(
        name: nm,
        tparams: tps,
        fields: fs,
        pos: p,
    )
}
genumdef_at* = (nm: string_view, tps: [Param], vs: [VariantDef], p: i32) GenEnumDecl {
    GenEnumDecl(
        name: nm,
        tparams: tps,
        variants: vs,
        pos: p,
    )
}
tvoid* = () Ty { .Void }
vdef* = (nm: string_view, p: Ty) VariantDef {
    VariantDef(
        name: nm,
        payload: p,
        dflt: null_ptr(),
    )
}
vdef_default* = (nm: string_view, p: Ty, e: Ptr<Expr>) VariantDef {
    VariantDef(
        name: nm,
        payload: p,
        dflt: e,
    )
}
expr_null* = () Ptr<Expr> { vdef("", tvoid()).dflt }    // a null Ptr<Expr> carrying the right static type
is_expr_null* = (e: Ptr<Expr>) bool { e == null_ptr() }
edef_at* = (nm: string_view, vs: [VariantDef], p: i32) EnumDecl {
    EnumDecl(
        name: nm,
        variants: vs,
        pos: p,
    )
}    // source-backed (formatter leading-comment anchor)
dfunc* = (f: Func) Decl { .DFunc(f) }
dstruct* = (sd: StructDecl) Decl { .DStruct(sd) }
denum* = (ed: EnumDecl) Decl { .DEnum(ed) }
dforeign* = (f: Func) Decl { .DForeign(f) }
dimport_at* = (names: [Param], module: string_view, p: i32) Decl {
    .DImport(ImportData(
        names: names,
        module: module,
        pos: p,
    ))
}    // source-backed import (formatter anchors a file-header comment above it)
dgenstruct* = (gsd: GenStructDecl) Decl { .DGenStruct(gsd) }
dgenenum* = (ged: GenEnumDecl) Decl { .DGenEnum(ged) }
dimpl* = (ty: string_view, trname: string_view, methods: [Param]) Decl {
    .DImpl(ImplData(
        ty: ty,
        trname: trname,
        trty: tnamed(trname),
        methods: methods,
        pos: 0,
    ))
}
dimpl_at* = (ty: string_view, trname: string_view, trty: Ty, methods: [Param], pos: i32) Decl {
    .DImpl(ImplData(
        ty: ty,
        trname: trname,
        trty: trty,
        methods: methods,
        pos: pos,
    ))
}
dglobal* = (name: string_view, ty: Ty, init: Ptr<Expr>) Decl {
    .DGlobal(GlobalData(
        name: name,
        ty: ty,
        init: init,
        tl: false,
        alias: false,
        pos: 0,
    ))
}
dglobal_tl* = (name: string_view, ty: Ty, init: Ptr<Expr>) Decl {
    .DGlobal(GlobalData(
        name: name,
        ty: ty,
        init: init,
        tl: true,
        alias: false,
        pos: 0,
    ))
}
dglobal_at* = (name: string_view, ty: Ty, init: Ptr<Expr>, p: i32) Decl {
    .DGlobal(GlobalData(
        name: name,
        ty: ty,
        init: init,
        tl: false,
        alias: false,
        pos: p,
    ))
}
dglobal_tl_at* = (name: string_view, ty: Ty, init: Ptr<Expr>, p: i32) Decl {
    .DGlobal(GlobalData(
        name: name,
        ty: ty,
        init: init,
        tl: true,
        alias: false,
        pos: p,
    ))
}
dglobal_alias_at* = (name: string_view, ty: Ty, init: Ptr<Expr>, p: i32) Decl {
    .DGlobal(GlobalData(
        name: name,
        ty: ty,
        init: init,
        tl: false,
        alias: true,
        pos: p,
    ))
}    // source-backed module-alias
dtraitdef* = (trname: string_view, fn: Func) Decl {
    .DTraitDefault(TraitDefData(
        trname: trname,
        fn: fn,
    ))
}
mono_tynode_in = (a: MutPtr<Malloc>, t: Ty) Ptr<Ty> {
    buf := cbuf<Ty>(a, 1)
    buf[0] = t
    buf[0].addr()
}
// the FnT SIGNATURE of a function (its param types + ret) — used to give a default-bodied trait method
// a Field type so conformance sees a normal method signature. Allocates a [Ty] of the param types.
fnt_param_tys_in = (a: MutPtr<Malloc>, ps: [Param]) [Ty] {
    buf := cbuf<Ty>(a, ps.len)
    ps.loop((h, i, p) {
        buf[i] = p.ty
    })
    buf
}
ty_node_in* = (a: MutPtr<Malloc>, t: Ty) Ptr<Ty> { a.mono_tynode_in(t) }
fnt_from_func_in* = (a: MutPtr<Malloc>, f: Func) Ty {
    fntype(a.fnt_param_tys_in(f.params), a.ty_node_in(f.ret))
}
// pragma, intrinsic decl, anything
// map a narrow int/float type name to its C type; any other name passes through unchanged.
// the checker accepts i8/i16/u16/u32/u64/f32 but they reach genc as Named(name), so without
// this they'd leak the Zen name (`u32`, `f32`, …) straight to cc as an unknown C type.
width_cname = (n: string_view) string_view {
    (n == "i8").then({
        return "int8_t"
    })
    (n == "i16").then({
        return "int16_t"
    })
    (n == "u16").then({
        return "uint16_t"
    })
    (n == "u32").then({
        return "uint32_t"
    })
    (n == "u64").then({
        return "uint64_t"
    })
    (n == "f32").then({
        return "float"
    })
    n
}
// the C type name of a Ty as a plain string — used to substitute `sizeof(T)` in a generic body
// (the tparam Var `T` becomes the concrete type's C name, so `sizeof(T)` → `sizeof(Expr)`).
cname_len = (t: Ty) i64 {
    t.match ({
        .I32           => 7,
        .I64           => 7,
        .U8            => 7,
        .F64           => 6,
        .Bool          => 4,
        .Void          => 4,
        .StringView    => 11,
        .StringCstr    => 11,
        .StringLiteral => 11,
        .Named(n)      => width_cname(n).view().len,
        .Generic(g)    => g.mangled.view().len,
        .Ptr(pd)       => load(pd.pointee).cname_len() + 1,
        .Slice(e)      => 6,
        .FnT(ft)       => 3,
    })
}
cname_write = (dst: RawPtr<u8>, at: i64, t: Ty) i64 {
    t.match ({
        .I32           => dst.write_str(at, "int32_t"),
        .I64           => dst.write_str(at, "int64_t"),
        .U8            => dst.write_str(at, "uint8_t"),
        .F64           => dst.write_str(at, "double"),
        .Bool          => dst.write_str(at, "bool"),
        .Void          => dst.write_str(at, "void"),
        .StringView    => dst.write_str(at, "const char*"),
        .StringCstr    => dst.write_str(at, "const char*"),
        .StringLiteral => dst.write_str(at, "const char*"),
        .Named(n)      => dst.write_str(at, width_cname(n)),
        .Generic(g)    => dst.write_str(at, g.mangled),
        .Ptr(pd)       => dst.write_str(dst.cname_write(at, load(pd.pointee)), "*"),
        .Slice(e)      => dst.write_str(at, "zslice"),
        .FnT(ft)       => dst.write_str(at, "zfn"),
    })
}
ty_cname_in* = (a: MutPtr<Malloc>, t: Ty) string_view {
    n := t.cname_len()
    buf: RawPtr<u8> := a.acquire(n + 1)
    buf.finish_buf(buf.cname_write(0, t))
}
// ── type substitution (tparam→arg): shared by compiler.check (subst_ty_in/find_genenum) and the
//    monomorphize pass (compiler.mono). A tiny stack of [Ty] buffer helpers + the recursive
//    substitution + the generic-enum lookup; they're TYPE helpers, so they live in the base. ──
// substitute tparam→arg in a type (recursing Ptr/Slice); a Named that IS a tparam becomes its arg.
tparam_arg = (tparams: [Param], args: [Ty], n: string_view, dflt: Ty) Ty {
    found := dflt
    tparams.loop((h, i, tp) {
        // Guard `i < args.len`: a WRONG-ARITY explicit targ list (too few `<…>` args for the declared
        // tparams) would otherwise index past `args` and panic. Leave an un-pinned tparam lenient here;
        // the targ-arity diagnostic (kv_makestruct_targ_kind) owns the real error report.
        found = (tp.name == n && i < args.len).then({ args[i] }, { found })
    })
    found
}
subst_ty_in* = (a: MutPtr<Malloc>, tparams: [Param], args: [Ty], t: Ty) Ty {
    t.match ({
        .Named(n)   => tparams.tparam_arg(args, n, t),
        .Ptr(pd)    => tptr_k(a.mono_tynode_in(a.subst_ty_in(tparams, args, load(pd.pointee))), pd.kind),
        .Slice(e)   => tslice(a.mono_tynode_in(a.subst_ty_in(tparams, args, load(e)))),
        .Generic(g) => a.subst_generic_in(tparams, args, g),    // a nested generic field: substitute its args, re-mangle
        .FnT(ft)    => a.subst_fnt_in(tparams, args, ft),    // a function-VALUE field `(S, i32) S`: substitute inside the signature
        _           => t,
    })
}
// substitute tparam→arg inside a function type `(S, i32) S` -> `(AppState, i32) AppState`.
subst_fnt_in = (a: MutPtr<Malloc>, tparams: [Param], args: [Ty], ft: FnTData) Ty {
    ptys := cbuf<Ty>(a, ft.params.len)
    ft.params.loop((h, i, p) {
        ptys[i] = a.subst_ty_in(tparams, args, p)
    })
    fntype(ptys, a.mono_tynode_in(a.subst_ty_in(tparams, args, load(ft.ret))))
}
// substitute tparam→arg inside a nested generic instance `Inner<T>` -> `Inner<i32>` (new mangled name).
subst_generic_in = (a: MutPtr<Malloc>, tparams: [Param], args: [Ty], g: GenericData) Ty {
    // `tys` (not `buf`): mangle_str_in inlines a local `buf: RawPtr<u8>`, and the inliner
    // substitutes args by name — a caller arg also named `buf` would be captured by that local.
    tys := cbuf<Ty>(a, g.args.len)
    g.args.loop((h, i, gt) {
        tys[i] = a.subst_ty_in(tparams, args, gt)
    })
    tgeneric(g.name, tys, a.mangle_str_in(g.name, tys))
}
find_genenum* = (decls: [Decl], name: string_view) GenEnumDecl {
    found := GenEnumDecl(
        name: "",
        tparams: slice(null_ptr(), 0),
        variants: slice(null_ptr(), 0),
    )
    decls.loop((h, i, d) {
        found = d.match ({
            .DGenEnum(g) => (g.name == name).then({ g }, { found }),
            _            => found,
        })
    })
    found
}
