// UNRESOLVED in DESIGN.md, and the harder half of the same ambiguity:
// `Wrapped = Circle(Circle)` is either a one-variant enum with a
// payload, or a binding to a comptime call -- DESIGN.md writes exactly
// that call shape as `Circle1 = AddFoo(Circle)`.
Circle = { radius: f64 }

Wrapped = Circle(Circle)

main = (env: Env) Res<i32, ArgError> {
    Ok(0);
}
