// tools/memory_map.zen — how Zen actually uses memory, as a WORKING FILE you edit.
//
//   ./zen run tools/memory_map.zen           // print the map + a tally of what is still undecided
//   ./zen run tools/memory_map.zen open      // print only the entries with no verdict yet
//
// This replaces docs/memory-usage-map.md. It is Zen rather than markdown for the same reason
// bindings are values here: a review artifact you can COMPILE is one the compiler can check, and
// `verdict` is a field rather than a bullet you might forget to fill in — `main` counts the blanks
// for you.
//
// TO REVIEW: edit the `verdict:` field of each Entry. Anything left "" is reported as open.
// Suggested vocabulary — "keep" / "kill" / "merge into X" / "change: …" — but it is free text.
//
// Counts are historical snapshots from origin/main (6b60d5b). Several entries predate the allocator
// refactor; recount before relying on a number.
{ println, formatln, arg_str, arg_int } = std.text.fmt
{ is_empty } = std.text.str
// One memory surface. `status` is what the evidence says; `verdict` is what YOU say.
Entry*: {
    id: StringView,
    name: StringView,
    example: StringView,
    users: i64,
    status: StringView,
    issue: StringView,
    verdict: StringView,
}
// one real call site, verbatim
// real users, excluding the declaring module and its own tests
// load-bearing | niche | dead | invisible
// what is known to be wrong with it, or "" when nothing is
// ← YOU EDIT THIS. "" means undecided.
// ── PART 1 — GETTING memory ──────────────────────────────────────────────────────────────────────
getting = () MutSlice<Entry> {
    [
        Entry(
            id: "1.1",
            name: "threaded allocator param",
            example: "read_bytes_alloc<A> = (a: MutPtr<A>, …)",
            users: 184,
            status: "load-bearing",
            issue: "stale: allocator parameters now use explicit AllocatorBackend bounds; recount users",
            verdict: "",
        ),
        Entry(
            id: "1.2",
            name: "fallible acquire",
            example: "a.try_acquire(n * sizeof(T)).match ({ .Ok(p) => …, .Err(e) => … })",
            users: 92,
            status: "load-bearing",
            issue: "",
            verdict: "",
        ),
        Entry(
            id: "1.3",
            name: "infallible acquire (nullable)",
            example: "out: MutSlice<u8> = a.acquire(n).slice(n)",
            users: 120,
            status: "load-bearing",
            issue: "returns null on failure with no error; exactly ONE of ~32 std sites is null-checked",
            verdict: "",
        ),
        Entry(
            id: "1.4",
            name: "cbuf<T> typed buffer",
            example: "cbuf*<T> = (a, n) MutSlice<T> { slice(a.acquire(n * sizeof(T)), n) }",
            users: 78,
            status: "load-bearing",
            issue: "safest shape in the tree (size/type cannot disagree) — but has two twins: str.nbuf, raw.of",
            verdict: "",
        ),
        Entry(
            id: "1.5",
            name: "stored allocator (AVec/ASet/AHMap)",
            example: "AVec*<T>: { …, alloc: Allocator }   //  vec.new() then v.push(x)",
            users: 4,
            status: "load-bearing",
            issue: "custom backend state and vtables must outlive stored Allocator copies",
            verdict: "",
        ),
        Entry(
            id: "1.6",
            name: "arena / bump",
            example: "make_in*<A> = (backing: MutPtr<A>, cap: i64) Result<Arena, IoError>",
            users: 3,
            status: "niche",
            issue: "the ONLY allocator that checks size overflow; zero uses in the compiler or examples",
            verdict: "",
        ),
        Entry(
            id: "1.7",
            name: "direct libc",
            example: "p = malloc(n)",
            users: 49,
            status: "load-bearing",
            issue: "31 of the 49 are the concurrency layer; pool_actor.zen:104 hand-builds an Arena over raw malloc instead of make_in",
            verdict: "",
        ),
        Entry(
            id: "1.8",
            name: "scoped scratch (RAII by closure)",
            example: "with_scratch*<T> = (n, f) T { c = zeroed(n)  r = f(c)  release(c)  r }",
            users: 14,
            status: "niche",
            issue: "does NOT survive or_return — the emitted C returns past release(c). Same for Mutex.with (15) and with_pool, where the skipped cleanup is pthread teardown.",
            verdict: "",
        ),
        Entry(
            id: "1.9",
            name: "compiler-inserted (zen__salloc)",
            example: "emitted for every escaping slice literal — no allocator, no owner, no free",
            users: 0,
            status: "invisible",
            issue: "partly fixed: borrowed slice literals no longer allocate; returned and let-bound literals still heap-promote and leak",
            verdict: "",
        ),
        Entry(
            id: "1.10",
            name: "ambient rt",
            example: "rt.alloc(n) / rt.with(custom, body)",
            users: 0,
            status: "dead",
            issue: "zero production call sites; pool enter/leave writes thread-local state that nothing reads",
            verdict: "",
        ),
        Entry(
            id: "1.11",
            name: "LSP request arena (explicit owner)",
            example: "request = request_arena(heap_allocator())    // per-server chunk chain; reset after each frame",
            users: 2,
            status: "load-bearing",
            issue: "",
            verdict: "",
        ),
    ]
}
// ── PART 2 — REPRESENTING memory ─────────────────────────────────────────────────────────────────
representing = () MutSlice<Entry> {
    [
        Entry(
            id: "2.1",
            name: "slice(p, n) fat pointer",
            example: "s: MutSlice<i64> = slice(p, n)",
            users: 217,
            status: "load-bearing",
            issue: "NO validation; zen__idx bounds-checks against the number you typed. slice(p,1000) over 16 bytes writes 4 KB past. 100 of 217 sites are trust-me.",
            verdict: "",
        ),
        Entry(
            id: "2.2",
            name: "RawPtr<u8> universal floor",
            example: "raw_floor_fits — satisfies ANY pointer type",
            users: 485,
            status: "load-bearing",
            issue: "the escape hatch everything leaks through; also why the send-check cannot be tightened (32 __good cells rejected, 0 bugs caught)",
            verdict: "",
        ),
        Entry(
            id: "2.3",
            name: "Ptr<T> read-only",
            example: "p.store(99) → error[ptr-write]",
            users: 817,
            status: "load-bearing",
            issue: "genuinely enforced, incl. via slice() — but p.offset(0).store(99) writes anyway",
            verdict: "",
        ),
        Entry(
            id: "2.4",
            name: "offset() untyped cast",
            example: "p.offset(0).store(99)",
            users: 238,
            status: "load-bearing",
            issue: "erases pointer kind AND pointee; doubles as the int→pointer cast since Zen has no `as`",
            verdict: "",
        ),
        Entry(
            id: "2.5",
            name: "ownership wrappers",
            example: "Own<T> / Rc<T> / Arc<T>",
            users: 3,
            status: "load-bearing",
            issue: "Arc backs actors; Own has compiler-enforced affine binding rules; Rc is the single-threaded shared owner.",
            verdict: "",
        ),
        Entry(
            id: "2.6",
            name: "hand-rolled block headers",
            example: "count = (b) i64 { load_i64(b.offset(0)) }    // [count|value]",
            users: 51,
            status: "load-bearing",
            issue: "Literal header offsets remain spread across allocator and ownership implementations.",
            verdict: "",
        ),
    ]
}
// ── PART 3 — RELEASING memory ────────────────────────────────────────────────────────────────────
releasing = () MutSlice<Entry> {
    [
        Entry(
            id: "3.1",
            name: "explicit release",
            example: "a.release(p) / o.release_in(a)",
            users: 113,
            status: "load-bearing",
            issue: "release carries no size, limiting poisoning, leak accounting, and slice validation",
            verdict: "",
        ),
        Entry(
            id: "3.2",
            name: "arena reset",
            example: "request.reset() invalidates one request and retains chunk capacity",
            users: 167,
            status: "load-bearing",
            issue: "request allocations are reclaimed in bulk; durable state uses the heap",
            verdict: "",
        ),
        Entry(
            id: "3.3",
            name: "per-behavior scratch reset",
            example: "a.scratch_reset()    // pool.zen:393, on normal return AND caught panic",
            users: 2,
            status: "load-bearing",
            issue: "a real region discipline with a static escape check — the closest thing to a per-actor heap, but scoped to ONE behavior",
            verdict: "",
        ),
    ]
}
// ── PART 4 — PASSING memory across threads ───────────────────────────────────────────────────────
passing = () MutSlice<Entry> {
    [
        Entry(
            id: "4.1",
            name: "the send check",
            example: "mode_of(decls, t) — a pure function of the TYPE'S SHAPE, no program point",
            users: 3,
            status: "load-bearing",
            issue: "unsound 6 ways incl. the shape the compiler's own hint recommends; keyed on the method NAMES send/pool_send/ref_send_msg; runs pre-monomorphization",
            verdict: "",
        ),
        Entry(
            id: "4.2",
            name: "what messages actually carry",
            example: "ChatMsg*: Join(StringView) | Say(SayArgs) | GetStats(ReplyRef<ChatStats>)",
            users: 0,
            status: "load-bearing",
            issue: "NOT ONE message in the repo carries a Ptr/MutPtr/Own — every payload is a scalar, plain struct, StringView, or opaque cap. This is what makes copy-on-send viable without capabilities.",
            verdict: "",
        ),
    ]
}
all_entries = () MutSlice<MutSlice<Entry>> { [getting(), representing(), releasing(), passing()] }
show = (e: Entry) void {
    formatln("  {}  {}", [arg_str(e.id), arg_str(e.name)])
    formatln("      {}", [arg_str(e.example)])
    formatln("      users={}  status={}", [arg_int(e.users), arg_str(e.status)])
    (e.issue.is_empty() == false).then({
        formatln("      issue: {}", [arg_str(e.issue)])
    })
    formatln("      VERDICT: {}", [arg_str(verdict_or_open(e))])
    println("")
}
verdict_or_open = (e: Entry) StringView {
    e.verdict.is_empty().then({ "*** OPEN — needs your call ***" }, { e.verdict })
}
main = () i32 {
    total ::= 0
    open ::= 0
    println("How Zen uses memory — edit the `verdict:` fields in tools/memory_map.zen")
    println("")
    all_entries().loop((h, i, group) {
        group.loop((h2, j, e) {
            show(e)
            total = total + 1
            open = open + e.verdict.is_empty().then({ 1 }, { 0 })
        })
    })
    formatln("{} surfaces, {} still undecided", [arg_int(total), arg_int(open)])
    0
}
