Tick, ThreadError = std.env

Once = { env: Env }
Once.impl(Tick, {
    tick = (self: @Self) bool {
        self.env.out.println("tick");
        false
    }
})

main = (env: Env) Res<i32, ThreadError> {
    a ::= env.mem.alloc();
    task        = env.threads.every(a, 1, Once(env: env)).try();
    result: i32 = task.join<i32>().try();
    env.out.println("joined {}", result);
    Ok(0)
}
