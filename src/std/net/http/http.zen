// HTTP/1.1 client API.

Alloc = std.mem
str, String = std.text
Res = std.core
Sink = std.core.io
Vec = std.collections
ParsedUrl, parse_url = std.net.url
Stream, dial, write, close = std.net.tls

HttpError*, HttpResponseMeta*, HttpResponse*, http_error = std.net.http.http_types
parse_response_into*, parse_response*, read_response_into = std.net.http.http_decode

HttpClient* = {
    // Each body chunk is written to `out` before the next socket read.
    post_into* = (self: @Self, a: Alloc, url: str, headers: Vec<str>,
                  body: str, out :: Sink)
                  Res<HttpResponseMeta, HttpError> {
        parsed = url.parse_url().replace_err(HttpError.DecodeFailed).try();
        req    = parsed.build_request(a, headers, body).try();
        stream = dial(
            a,
            parsed.host,
            parsed.port,
            parsed.scheme.eq_ignore_case("https"),
            false
        ).try((e) { e.http_error() });
        stream.write(req.view()).try((e) { e.http_error() });
        meta = stream.read_response_into(a, out).try();
        // The move disarms the drop; every `.try()` above closes through it.
        (consume stream).close();
        Ok(meta)
    }

    // Buffered form of post_into. A non-2xx status is data, not an Err.
    post* = (self: @Self, a: Alloc, url: str, headers: Vec<str>, body: str)
            Res<HttpResponse, HttpError> {
        response_body ::= a.String().try(HttpError.RecvFailed);
        meta = self.post_into(a, url, headers, body, response_body).try();
        Ok(HttpResponse(status: meta.status, body: response_body));
    }
}

build_request = (
    parsed  : ParsedUrl,
    a       : Alloc,
    headers : Vec<str>,
    body    : str
) Res<String, HttpError> {
    sb ::= a.String().try(HttpError.SendFailed);

    sb.add("POST ").try(HttpError.SendFailed);
    sb.add(parsed.path).try(HttpError.SendFailed);
    sb.add(" HTTP/1.1\r\nHost: ").try(HttpError.SendFailed);
    sb.add(parsed.host).try(HttpError.SendFailed);
    sb.add("\r\n").try(HttpError.SendFailed);

    headers.loop((h, header) {
        sb.add(header).try(HttpError.SendFailed);
        sb.add("\r\n").try(HttpError.SendFailed);
    });

    sb.add("Content-Length: ").try(HttpError.SendFailed);
    sb.fmt("{}", body.len).try(HttpError.SendFailed);
    sb.add("\r\n\r\n").try(HttpError.SendFailed);
    sb.add(body).try(HttpError.SendFailed);

    Ok(sb);
}
