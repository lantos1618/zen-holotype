// http_actor_demo.zen — fetching over HTTP with the stdlib's ready-made client actor.
//
// std.net.http_actor ships the fetcher (message, reply, receiver, trampoline); the app brings
// only its OWN receiver for the reply. Here `main` also plays the SERVER — `serve_once` answers the
// one loopback connection while the fetch blocks on a pool worker — then quiesces and reads the
// result. Client and server are both std.net.http; the app never opens a socket.
//
//   $ zen run examples/http_actor_demo.zen
//   status=200 body=hello zen actors
//   ok
{ println, formatln, arg_int, arg_str } = std.text.fmt
{ expect } = std.core.result
{ Heap } = std.mem.alloc
{ gpa } = std.mem.heap
{ url_of, http_listen, serve_once, respond, no_headers, request_free, Request, Response } = std.net.http
{ view } = std.text.str
{ spawn_http_fetcher, http_fetch, HttpReplyMsg } = std.net.http_actor
{ pool_open } = std.concurrent.pool
{ Context, Receiver, dispatch } = std.concurrent.pool_actor
pa = std.concurrent.pool_actor
BODY := "hello zen actors"    // 16 bytes
// the app's receiver: whatever actor asked for the fetch — it just folds the reply into state.
// `got` is not bookkeeping for show: the reply body is THIS actor's to release, and without it a
// fetch that never answered would leave `body` as the literal placeholder and get freed as one.
App*: {
    got: bool,
    status: i64,
    body: StringView,
}
App.impl(Receiver, {
    receive = (s: MutPtr<App>, ctx: Context<HttpReplyMsg>) void {
        ctx.msg.match ({
            .Done(r) => {
                s.got = true
                s.status = r.status
                s.body = r.body
            },
        })
    }
})
app_tramp = (user: RawPtr<u8>, msg: i64) void { dispatch<App, HttpReplyMsg>(user, msg) }
// the whole server: every request gets the same 200. A handler is an ordinary function value, so it
// names a CONCRETE allocator (`Heap`) — it is spliced into `serve_once` at monomorphization.
hello = (a: MutPtr<Heap>, req: Request) Response { respond(200, a.no_headers(), BODY) }
main = () i32 {
    h := gpa()
    a := h.addr()
    l := http_listen("127.0.0.1", 0).expect("demo: listen failed")
    fetcher := spawn_http_fetcher(8)
    app := pa.spawn_actor_heap(8, App(
        got: false,
        status: 0,
        body: "",
    ), app_tramp)
    p := pool_open(2, 8)
    url := a.url_of("127.0.0.1", l.local_port(), "/")    // the sender's, until the reply is in
    p.send(fetcher, http_fetch(url, app.ref_of(p)))
    // main is the server while the fetcher blocks on its worker: one connection, answered and closed.
    req := a.serve_once(l, hello).expect("demo: serve failed")
    a.request_free(req)
    l.close_listener()
    p.pool_quiesce_stop()
    st := pa.actor_state(app)
    formatln("status={} body={}", [arg_int(st.status), arg_str(st.body)])
    ok := st.status == 200 && st.body == "hello zen actors"
    // quiescence is the proof the fetch is done with both: the url it read, and the body it sent us.
    a.release(url.view().ptr)
    st.got.then({
        a.release(st.body.view().ptr)
    })
    pa.close(fetcher)
    pa.close(app)
    p.pool_close()
    ok.then({ println("ok") }, { println("MISMATCH") })
    ok.then({ 0 }, { 1 })
}
