// Parse integer rows from Env.argv and an in-program Vec<str>. The harness
// supplies no extra arguments, so the stable total is 12. parse_i64 is used
// through the prelude without an explicit import.

main = (env: Env) Res<i32, AllocError> {
    a    ::= env.mem.alloc();
    rows ::= a.Vec<str>();
    rows.add("3").try();
    rows.add("4").try();
    rows.add("5").try();

    total: i64 = 0;

    // every row past row 0 — row 0 is the program path, never a number
    env.argv.loop((h, i, arg) {
        (i > 0).match({
            true  => {
                arg.parse_i64().match({
                    Ok(n) => { total = total + n; },
                    None  => {},
                });
            },
            false => {},
        });
    });

    // the same question over rows built in-program
    rows.loop((h, i, row) {
        row.parse_i64().match({
            Ok(n) => { total = total + n; },
            None  => {},
        });
    });

    println("{}", total);
    Ok(0);
}
