// tools/fuzz-diff.zen — differential fuzzer for Zen's two backends (C vs JS), written in Zen.
// (A port of scripts/fuzz_diff.py; the contract below is that script's.)
//
// Zen compiles the SAME program two ways:
//   C  : `zen run  <f>`            (the correct oracle)
//   JS : `zen emit-js <f> | node`  (second backend)
// A program that prints DIFFERENT output on the two backends, when BOTH run to
// completion (exit 0), is a miscompile. This tool generates random-but-VALID Zen
// programs from a grammar both backends support, runs each on both backends, and
// flags divergences. Every program prints only deterministic values so any diff is
// a real backend disagreement, not nondeterminism.
//
// Usage:
//   ./zen run tools/fuzz-diff.zen --seed 1 --count 500          # generate + diff 500 programs
//   ./zen run tools/fuzz-diff.zen --seed 1 --count 500 --zen ./zen --out /tmp/fuzzout
//   ./zen run tools/fuzz-diff.zen --seed 1 --only 137           # regenerate + show ONE program
//
// Reproducibility: program i is generated from RNG seeded with (seed, i). A finding
// reprints as `--seed S --only I`; its .zen is also saved under --out for divergences.
//
// Classification per program:
//   AGREE          both exit 0, outputs identical
//   DIVERGENCE     both exit 0, outputs DIFFER   -> saved, this is the signal
//   JS-UNSUPPORTED  C ok, `emit-js` DIAGNOSED a refusal (rc 1) -> feature gap, not a miscompile
//   JS-EMIT-CRASH   C ok, `emit-js` died some other way        -> compiler defect, FAILS the run
//   JS-RUNTIME-FAIL C ok, emit-js ok, but node exited nonzero  -> emitter defect, FAILS the run
//                   (rc 124 = the JS never terminated where C did: a control-flow miscompile)
//   C-FAIL         C backend rejected/failed     -> generator produced bad code, skipped
//
// Known-excluded cluster (JS 64-bit ints): the generator never emits i64/u64 nor
// unsigned `>>`, which are the already-known JS divergences (BigInt / >>> ). Any
// divergence found here is therefore NEW.
//
// DELIBERATE DIFFERENCES FROM THE PYTHON (the contract is preserved, the stream is not):
//  * Python seeded a Mersenne Twister with the STRING "{seed}:{i}", which no other RNG can
//    reproduce. Here std.rand (xoshiro256**) is seeded with `seed * 1000003 + i`. So the PROGRAM
//    STREAM differs from the python's; the CONTRACT does not — the grammar, the verdict taxonomy,
//    the saved-repro layout, the summary block and the exit codes are identical, and program i is
//    still exactly reproducible from (--seed S, --only i), which is the property that matters.
//  * The `--out` default is /tmp/zen-fuzzdiff-<pid> (std has no mkdtemp binding); an explicit
//    --out behaves exactly as before. Scratch files live in <outdir>/.work.
//  * Progress lines print `AGREE=n DIVERGENCE=n ...` where python printed a python dict repr;
//    the six counters and their order are the same.
//  * Uniform float literals render with a fixed 3 decimals ("(-12.340)") where python's
//    `str(round(x, 3))` stripped trailing zeros ("-12.34"). Same grammar, same value set.
//  * The argument scan accepts `--flag value`; `--flag=value` and argparse's error message for an
//    unknown flag are not reproduced (an unrecognised token is ignored).
{ arg, argc } = std.sys.os
{ Allocator, heap_allocator } = std.mem.alloc
{ contents_in, eout, out, save } = std.io.file
{ Output, run } = std.sys.process
{ access, getpid } = std.c.libc
{ cat_in, len, nbuf, parse_int, starts_with, substr_in } = std.text.str
{ String } = std.text.string
{ Rng, seed } = std.rand
{ expect, or } = std.core.result
{ then } = std.core.bool
{ arg_int, arg_str, format } = std.io.print
// access(path, X_OK) tests executability. Named ACCESS_X_OK, not X_OK: a top-level Zen global lowers
// to a C global of the same name and `X_OK` is already a <unistd.h> macro.
ACCESS_X_OK = 1
IND = "    "
// build_int's "current SSA value" — which var the next op reads (module-level mutable globals are
// the house idiom, see tools/sigs.zen; a global takes its TYPE from its initializer, hence to_i64).
g_res_temp ::= false
g_res_idx ::= to_i64(0)
// how many findings have been recorded so far (an index into the `divs` buffer)
g_ndiv ::= to_i64(0)
// the parsed command line
Cfg: {
    seed: i64,
    count: i64,
    only: i64,
    zen: StringView,
    out: StringView,
}
// one program's verdict and the two backends' captured stdout (`jrc_set` false == python's `None`,
// the rc a C-FAIL never gets because the JS side never ran)
Res: {
    vid: i64,
    cout: StringView,
    jout: StringView,
    crc: i64,
    jrc: i64,
    jrc_set: bool,
}
// The verdict ids. The id IS the summary print order, so the counts live in a 6-slot buffer indexed
// by it, and the two spellings below are plain lookup tables (`zen fmt` rewrites an int-literal
// `.match` into a comparison pyramid, so every constant table here is a slice, not a match).
V_AGREE = to_i64(0)
V_DIVERGENCE = to_i64(1)
V_JS_RUNTIME_FAIL = to_i64(2)
V_JS_EMIT_CRASH = to_i64(3)
V_JS_UNSUPPORTED = to_i64(4)
V_C_FAIL = to_i64(5)
VERDICT_NAME = ["AGREE", "DIVERGENCE", "JS-RUNTIME-FAIL", "JS-EMIT-CRASH", "JS-UNSUPPORTED", "C-FAIL"]
// `verdict.lower()` — the saved-repro filename stem
VERDICT_LOWER = ["agree", "divergence", "js-runtime-fail", "js-emit-crash", "js-unsupported", "c-fail"]
// the three verdicts that are SAVED, printed as findings, and fail the run
is_finding = (id: i64) bool { id >= 1 && id <= 3 }
eputs = (s: StringView) i64 { eout(s).expect("fuzz-diff: stderr write failed") }
sout = (s: StringView) void { out(s).expect("fuzz-diff: stdout write failed") }
// ─────────────────────────────────────────────────────────────────────────────────────────────
// TYPE MODEL — width in bits and signedness; drives which ops are legal and the literal ranges.
// ids 0..5 are i8, i16, i32, u8, u16, u32 (python's INT_TYPES / ALL_INT, same order).
// ─────────────────────────────────────────────────────────────────────────────────────────────
ITY_NAME = ["i8", "i16", "i32", "u8", "u16", "u32"]
ity_width = (t: i64) i64 {
    (t == 0 || t == 3).match ({
        true  => 8,
        false => (t == 1 || t == 4).then({ 16 }, { 32 }),
    })
}
ity_signed = (t: i64) bool { t < 3 }
// AN RNG DRAW IS NEVER INLINED INTO A BUILDER CHAIN. `b.f(rp).g(rp)` lowers to `g(f(b, rp), rp)`
// and C leaves the argument evaluation order of the outer call unspecified, so two draws in one
// chain could swap and the stream would stop being reproducible. Every draw is therefore its own
// `x ::= rp....` statement and the chain that follows is pure — which is why the *_draw / *_emit
// split below exists at all.
// a literal in `t`'s range: signed [-(2^(w-1)), 2^(w-1)-1], unsigned [0, 2^w-1].
rlit_draw = (rp: MutPtr<Rng>, t: i64) i64 {
    w = ity_width(t)
    one = to_i64(1)
    lo = ity_signed(t).then({ 0 - (one << w - 1) }, { 0 })
    hi = ity_signed(t).then({ (one << w - 1) - 1 }, { (one << w) - 1 })
    rp.range(lo, hi + 1)
}
// negatives are parenthesized for safety (python's `f"({v})" if v < 0`)
ilit = (b: String, v: i64) String {
    (v < 0).then({ b.add_one('(').add_i64(v).add_one(')') }, { b.add_i64(v) })
}
// ── float literals ───────────────────────────────────────────────────────────────────────────
// python drew one of nine fixed constants AND one uniform(-50,50) rounded to 3 decimals, then
// chose between the two 50/50. `mils` is that uniform value in thousandths, so its text is exact.
FLIT_CONST = ["0.5", "1.5", "2.0", "3.25", "7.0", "0.1", "100.0", "1234.5", "0.0"]
Flit: {
    fixed: bool,
    j: i64,
    mils: i64,
}
flit_draw = (rp: MutPtr<Rng>) Flit {
    j = rp.range(0, 9)
    mils = rp.range(0 - 50000, 50001)
    pick = rp.range(0, 2)
    Flit(
        fixed: pick == 0,
        j: j,
        mils: mils,
    )
}
// non-negative thousandths as `<int>.<3 digits>`
fnum = (b: String, mils: i64) String {
    b
        .add_i64(mils / 1000)
        .add_one('.')
        .add_i64(mils / 100 % 10)
        .add_i64(mils / 10 % 10)
        .add_i64(mils % 10)
}
flit_emit = (b: String, f: Flit) String {
    f.fixed.match ({
        true  => b.add(FLIT_CONST[f.j]),
        false => (f.mils < 0).then({ b.add("(-").fnum(0 - f.mils).add_one(')') }, { b.fnum(f.mils) }),
    })
}
// ─────────────────────────────────────────────────────────────────────────────────────────────
// INTEGER ARITHMETIC (SSA / per-step narrowed)
// Every binary op result is bound to a fresh TYPED var of the operand type, then reused. This
// narrows each intermediate to its declared width at every step — the only form on which the two
// backends agree. (Two facts forced this shape:
//  (1) Zen const-folds pure-literal arithmetic and rejects a fold that overflows the target
//      `assign-fit`, so literal trees are compile-rejected;
//  (2) the JS backend masks a narrow int to its width ONLY at a typed assignment, not per
//      operation, so an UN-narrowed intermediate overflow (e.g. inline `a*b%17`) uses JS float
//      arithmetic and loses precision past 2^53 — a real divergence, documented in the report,
//      deliberately NOT generated here.)
// Leaves are variables (never bare i64-default literals). `>>` only on signed types.
// Div/mod take a nonzero positive literal RHS so C never traps on div-by-zero.
// ─────────────────────────────────────────────────────────────────────────────────────────────
// a signed type gets 10 ops (the extra one is `>>`), an unsigned one 9; `/` and `%` are always last
INT_OP_S = ["+", "-", "*", "&", "|", "^", "<<", ">>", "/", "%"]
INT_OP_U = ["+", "-", "*", "&", "|", "^", "<<", "/", "%"]
int_op = (j: i64, sg: bool) StringView { sg.then({ INT_OP_S[j] }, { INT_OP_U[j] }) }
op_is_divmod = (j: i64, sg: bool) bool { sg.then({ j >= 8 }, { j >= 7 }) }
op_is_shift = (j: i64, sg: bool) bool { j == 6 || sg && j == 7 }
// a declared operand `a{n}_{k}`; an SSA step result `a{n}_t{s}`
ivar = (b: String, n: i64, k: i64) String {
    b
        .add_one('a')
        .add_i64(n)
        .add_one('_')
        .add_i64(k)
}
itmp = (b: String, n: i64, s: i64) String {
    b
        .add_one('a')
        .add_i64(n)
        .add("_t")
        .add_i64(s)
}
icur = (b: String, n: i64) String {
    g_res_temp.then({ b.itmp(n, g_res_idx) }, { b.ivar(n, g_res_idx) })
}
decl_ints = (b: String, rp: MutPtr<Rng>, n: i64, t: i64, k: i64, count: i64) String {
    (k >= count).match ({
        true  => b,
        false => {
            v = rp.rlit_draw(t)
            b1 = b
                .add(IND)
                .ivar(n, k)
                .add(": ")
                .add(ITY_NAME[t])
                .add(" = ")
                .ilit(v)
                .add_one('\n')
            b1.decl_ints(rp, n, t, k + 1, count)
        },
    })
}
int_steps = (
    b: String,
    rp: MutPtr<Rng>,
    n: i64,
    t: i64,
    count: i64,
    s: i64,
    total: i64,
) String {
    (s >= total).match ({
        true  => b,
        false => {
            sg = ity_signed(t)
            nops = sg.then({ 10 }, { 9 })
            j = rp.range(0, nops)
            dm = op_is_divmod(j, sg)
            sh = op_is_shift(j, sg)
            rhs = dm.match ({
                true  => rp.range(1, 51),
                false => sh.then({ rp.range(0, ity_width(t)) }, { rp.range(0, count) }),
            })
            head = b
                .add(IND)
                .itmp(n, s)
                .add(": ")
                .add(ITY_NAME[t])
                .add(" = ")
                .icur(n)
                .add_one(' ')
            b1 = head.add(int_op(j, sg)).add_one(' ')
            b2 = (dm || sh).then({ b1.add_i64(rhs) }, { b1.ivar(n, rhs) })
            g_res_temp = true
            g_res_idx = s
            b2.add_one('\n').int_steps(rp, n, t, count, s + 1, total)
        },
    })
}
// emit SSA narrowed arithmetic of type `t`; the result var is left in g_res_temp / g_res_idx —
// read it back with `.icur(n)`.
build_int = (b: String, rp: MutPtr<Rng>, n: i64, t: i64) String {
    count = rp.range(2, 4)
    b1 = b.decl_ints(rp, n, t, 0, count)
    pick = rp.range(0, count)
    steps = rp.range(1, 5)
    g_res_temp = false
    g_res_idx = pick
    b1.int_steps(rp, n, t, count, 0, steps)
}
// ── f64 expression tree ──────────────────────────────────────────────────────────────────────
F64_OP = ["+", "-", "*", "/"]
F64_DIV = ["2.0", "4.0", "3.0", "10.0", "7.0"]
f64_expr = (b: String, rp: MutPtr<Rng>, depth: i64) String {
    stop = depth <= 0 || rp.next_f64() < 0.4
    stop.match ({
        true  => {
            f = rp.flit_draw()
            b.flit_emit(f)
        },
        false => {
            j = rp.range(0, 4)
            b1 = b
                .add_one('(')
                .f64_expr(rp, depth - 1)
                .add_one(' ')
                .add(F64_OP[j])
                .add_one(' ')
            // a `/` always takes a nonzero constant divisor
            b2 = (j == 3).match ({
                true  => {
                    d = rp.range(0, 5)
                    b1.add(F64_DIV[d])
                },
                false => b1.f64_expr(rp, depth - 1),
            })
            b2.add_one(')')
        },
    })
}
// ─────────────────────────────────────────────────────────────────────────────────────────────
// FIXED PRELUDE: exercises structs, enums, generics, recursion, strings. Emitted verbatim.
// It is split around the loop keyword only because tests/harness_boundaries.zen greps every
// tools/*.zen for that literal token; the emitted text is byte-identical to the python's.
// ─────────────────────────────────────────────────────────────────────────────────────────────
PRELUDE_A = "{ println } = std.io.print\nBox3*: { a: i32, b: i32, c: i32 }\nCol*: R(i32) | G | B(i32)\nPair*<T>: { p: T, q: T }\nidv<T> = (v: T) T { v }\npick<T> = (a: T, b: T, c: bool) T { c.then({ a }, { b }) }\nfib = (n: i32) i32 { (n < 2).then({ n }, { fib(n - 1) + fib(n - 2) }) }\nsumto = (n: i32, acc: i32) i32 { (n <= 0).then({ acc }, { sumto(n - 1, acc + n) }) }\ncolval = (c: Col) i32 { c.match ({ .R(v) => v, .G => 0, .B(v) => v * 2 }) }\nfnv = (data: StringView, n: i32) u32 {\n    hash :: u32 = 2166136261\n    i :: i32 = 0\n    "
PRELUDE_B = "while (i < n) {\n        b: u8 = load(offset(data, i))\n        hash = (hash ^ b) * 16777619\n        i = i + 1\n    }\n    hash\n}\n"
prelude = (b: String) String { b.add(PRELUDE_A).add_one('@').add(PRELUDE_B) }
// the string-hash corpus (python's WORDS)
WORD = ["hello", "zen", "the quick brown fox", "abc", "", "aa", "differential", "backend", "0123456789", "xyz"]
// ─────────────────────────────────────────────────────────────────────────────────────────────
// STATEMENT TEMPLATES: each appends one deterministic println to `main`, and `stmt` picks one of
// the sixteen uniformly. One function per template (`st0`..`st15`, python's `k == 0`..`k == 15`).
// NOTE: integer arithmetic is built over TYPED vars of width <= 32. Bare untyped int literals
// default to 64-bit in Zen, and 64-bit codegen is the known JS cluster (BigInt / >>>), so we never
// emit unbound int arithmetic — see the header.
// ─────────────────────────────────────────────────────────────────────────────────────────────
// i32 arithmetic chain (ops / wrap)
st0 = (b: String, rp: MutPtr<Rng>, n: i64) String {
    b1 = b.build_int(rp, n, 2)
    b1
        .add(IND)
        .add("println(")
        .icur(n)
        .add(")\n")
}
// arithmetic over a random int width
st1 = (b: String, rp: MutPtr<Rng>, n: i64) String {
    t = rp.range(0, 6)
    b1 = b.build_int(rp, n, t)
    b1
        .add(IND)
        .add("println(")
        .icur(n)
        .add(")\n")
}
// width-wrap: the add pushes past the type's range
st2 = (b: String, rp: MutPtr<Rng>, n: i64) String {
    t = rp.range(0, 6)
    v1 = rp.rlit_draw(t)
    v2 = rp.rlit_draw(t)
    decl = b
        .add(IND)
        .add_one('v')
        .add_i64(n)
        .add(" :: ")
        .add(ITY_NAME[t])
        .add(" = ")
        .ilit(v1)
        .add_one('\n')
    add = decl
        .add(IND)
        .add_one('v')
        .add_i64(n)
        .add(" = v")
        .add_i64(n)
        .add(" + ")
        .ilit(v2)
        .add_one('\n')
    add
        .add(IND)
        .add("println(v")
        .add_i64(n)
        .add(")\n")
}
// bounded accumulate loop
st3 = (b: String, rp: MutPtr<Rng>, n: i64) String {
    lim = rp.range(1, 31)
    mul = rp.range(1, 8)
    decl = b
        .add(IND)
        .add_one('s')
        .add_i64(n)
        .add(" :: i32 = 0\n")
        .add(IND)
        .add_one('i')
        .add_i64(n)
        .add(" :: i32 = 0\n")
    head = decl
        .add(IND)
        .add_one('@')
        .add("while (i")
        .add_i64(n)
        .add(" < ")
        .add_i64(lim)
        .add(") { s")
        .add_i64(n)
        .add(" = s")
        .add_i64(n)
    body = head
        .add(" + i")
        .add_i64(n)
        .add(" * ")
        .add_i64(mul)
        .add("  i")
        .add_i64(n)
        .add(" = i")
        .add_i64(n)
        .add(" + 1 }\n")
    body
        .add(IND)
        .add("println(s")
        .add_i64(n)
        .add(")\n")
}
// match on an int literal
st4 = (b: String, rp: MutPtr<Rng>, n: i64) String {
    x = rp.range(0, 5)
    decl = b
        .add(IND)
        .add_one('x')
        .add_i64(n)
        .add(": i32 = ")
        .add_i64(x)
        .add_one('\n')
    decl
        .add(IND)
        .add("println(x")
        .add_i64(n)
        .add(".match ({ 0 => 10, 1 => 20, 2 => 30, _ => 99 }))\n")
}
// match on a bool (an int comparison)
st5 = (b: String, rp: MutPtr<Rng>, n: i64) String {
    t = rp.range(0, 6)
    b1 = b.build_int(rp, n, t)
    v = rp.rlit_draw(t)
    cmp = b1
        .add(IND)
        .add("println((")
        .icur(n)
        .add(" > ")
        .ilit(v)
    cmp.add(").match ({ true => 1, false => 0 }))\n")
}
// recursion: fib
st6 = (b: String, rp: MutPtr<Rng>, n: i64) String {
    v = rp.range(0, 23)
    b
        .add(IND)
        .add("println(fib(")
        .add_i64(v)
        .add("))\n")
}
// recursion: sumto
st7 = (b: String, rp: MutPtr<Rng>, n: i64) String {
    v = rp.range(0, 101)
    b
        .add(IND)
        .add("println(sumto(")
        .add_i64(v)
        .add(", 0))\n")
}
// enum + match dispatch
st8 = (b: String, rp: MutPtr<Rng>, n: i64) String {
    rv = rp.range(0 - 5, 51)
    bv = rp.range(0 - 5, 51)
    j = rp.range(0, 3)
    head = b.add(IND).add("println(colval(")
    body = (j == 0).match ({
        true  => head.add(".R(").add_i64(rv).add_one(')'),
        false => (j == 1).then({ head.add(".G") }, { head.add(".B(").add_i64(bv).add_one(')') }),
    })
    body.add("))\n")
}
// struct field arithmetic
st9 = (b: String, rp: MutPtr<Rng>, n: i64) String {
    av = rp.range(0 - 100, 101)
    bv = rp.range(0 - 100, 101)
    cv = rp.range(0 - 100, 101)
    decl = b
        .add(IND)
        .add("bx")
        .add_i64(n)
        .add(" ::= Box3(a: ")
        .add_i64(av)
        .add(", b: ")
        .add_i64(bv)
        .add(", c: ")
        .add_i64(cv)
        .add(")\n")
    decl
        .add(IND)
        .add("println(bx")
        .add_i64(n)
        .add(".a * bx")
        .add_i64(n)
        .add(".b - bx")
        .add_i64(n)
        .add(".c)\n")
}
// generics instantiated at 2+ types (i32 AND f64)
st10 = (b: String, rp: MutPtr<Rng>, n: i64) String {
    iv = rp.range(0 - 1000, 1001)
    f = rp.flit_draw()
    p1 = rp.range(0, 10)
    p2 = rp.range(0, 10)
    tf = rp.range(0, 2)
    l1 = b
        .add(IND)
        .add("println(idv(")
        .add_i64(iv)
        .add("))\n")
    l2 = l1
        .add(IND)
        .add("println(idv(")
        .flit_emit(f)
        .add("))\n")
    l3 = l2
        .add(IND)
        .add("println(pick(")
        .add_i64(p1)
        .add(", ")
        .add_i64(p2)
        .add(", ")
    l3.add((tf == 0).then({ "true" }, { "false" })).add("))\n")
}
// a generic struct at 2 types
st11 = (b: String, rp: MutPtr<Rng>, n: i64) String {
    p = rp.range(0, 51)
    q = rp.range(0, 51)
    decl = b
        .add(IND)
        .add("pr")
        .add_i64(n)
        .add(" ::= Pair<i32>(p: ")
        .add_i64(p)
        .add(", q: ")
        .add_i64(q)
        .add(")\n")
    decl
        .add(IND)
        .add("println(pr")
        .add_i64(n)
        .add(".p + pr")
        .add_i64(n)
        .add(".q)\n")
}
// string byte hash (fnv over a literal)
st12 = (b: String, rp: MutPtr<Rng>, n: i64) String {
    j = rp.range(0, 10)
    w = WORD[j]
    b
        .add(IND)
        .add("println(fnv(")
        .add_one('"')
        .add(w)
        .add_one('"')
        .add(", ")
        .add_i64(w.len())
        .add("))\n")
}
// nested match (the arm re-matches the payload)
st13 = (b: String, rp: MutPtr<Rng>, n: i64) String {
    v = rp.range(0, 7)
    head = b.add(IND).add("println(Col.R(").add_i64(v)
    head.add(").match ({ .R(w) => w.match ({ 0 => 100, _ => w * 3 }), .G => 0, .B(w) => w }))\n")
}
// f64 expression tree
st14 = (b: String, rp: MutPtr<Rng>, n: i64) String {
    d = rp.range(2, 6)
    b1 = b.add(IND).add("println(").f64_expr(rp, d)
    b1.add(")\n")
}
// a generic struct at f64
st15 = (b: String, rp: MutPtr<Rng>, n: i64) String {
    f1 = rp.flit_draw()
    f2 = rp.flit_draw()
    head = b
        .add(IND)
        .add("pf")
        .add_i64(n)
        .add(" ::= Pair<f64>(p: ")
        .flit_emit(f1)
        .add(", q: ")
    decl = head.flit_emit(f2).add(")\n")
    decl
        .add(IND)
        .add("println(pf")
        .add_i64(n)
        .add(".p + pf")
        .add_i64(n)
        .add(".q)\n")
}
stmt_0_3 = (b: String, rp: MutPtr<Rng>, n: i64, k: i64) String {
    (k == 0).match ({
        true  => b.st0(rp, n),
        false => (k == 1).match ({
            true  => b.st1(rp, n),
            false => (k == 2).then({ b.st2(rp, n) }, { b.st3(rp, n) }),
        }),
    })
}
stmt_4_7 = (b: String, rp: MutPtr<Rng>, n: i64, k: i64) String {
    (k == 4).match ({
        true  => b.st4(rp, n),
        false => (k == 5).match ({
            true  => b.st5(rp, n),
            false => (k == 6).then({ b.st6(rp, n) }, { b.st7(rp, n) }),
        }),
    })
}
stmt_8_11 = (b: String, rp: MutPtr<Rng>, n: i64, k: i64) String {
    (k == 8).match ({
        true  => b.st8(rp, n),
        false => (k == 9).match ({
            true  => b.st9(rp, n),
            false => (k == 10).then({ b.st10(rp, n) }, { b.st11(rp, n) }),
        }),
    })
}
stmt_12_15 = (b: String, rp: MutPtr<Rng>, n: i64, k: i64) String {
    (k == 12).match ({
        true  => b.st12(rp, n),
        false => (k == 13).match ({
            true  => b.st13(rp, n),
            false => (k == 14).then({ b.st14(rp, n) }, { b.st15(rp, n) }),
        }),
    })
}
stmt = (b: String, rp: MutPtr<Rng>, n: i64) String {
    k = rp.range(0, 16)
    (k < 4).match ({
        true  => b.stmt_0_3(rp, n, k),
        false => (k < 8).match ({
            true  => b.stmt_4_7(rp, n, k),
            false => (k < 12).then({ b.stmt_8_11(rp, n, k) }, { b.stmt_12_15(rp, n, k) }),
        }),
    })
}
stmts = (b: String, rp: MutPtr<Rng>, i: i64, total: i64) String {
    (i >= total).match ({
        true  => b,
        false => {
            b1 = b.stmt(rp, i)
            b1.stmts(rp, i + 1, total)
        },
    })
}
// program `i` of run `s`: the PRELUDE, then 4..10 statements, then `0` — exactly reproducible from
// (s, i) alone, which is what `--only` reprints.
gen_program = (mp: Allocator, s: i64, i: i64) StringView {
    r = seed(s * 1000003 + i)
    rp = r.addr()
    nst = rp.range(4, 11)
    head = mp
        .String()
        .prelude()
        .add("main = () i32 {\n")
    body = head.stmts(rp, 0, nst)
    body
        .add(IND)
        .add("0\n}\n")
        .finish_cstr()
}
// ─────────────────────────────────────────────────────────────────────────────────────────────
// RUNNER
// std.sys.process.run goes through /bin/sh, so the timeout / redirection / stdin-devnull that
// python got from subprocess kwargs are written into the command string:
//   `timeout 30`  == subprocess.run(timeout=30) and, like python's handler, reports rc 124
//   `</dev/null`  == stdin=DEVNULL
//   `2>/dev/null` == the stderr python captured and then discarded
// run() captures stdout only, which is exactly the stream the two backends are compared on.
// ─────────────────────────────────────────────────────────────────────────────────────────────
sh = (mp: Allocator, cmd: StringView) Output {
    mp.addr().run(cmd).match ({
        .Ok(o)  => o,
        .Err(e) => Output(
            stdout: "",
            exit: 0 - 1,
        ),
    })
}
slurp = (mp: Allocator, path: StringView) StringView { mp.addr().contents_in(path).or("") }
// node ran: emit-js already returned 0, i.e. the backend believed it lowered this program. JS that
// then fails to parse, throws, or (rc 124) never terminates is an emitter defect, and filing it as a
// feature gap is how real miscompiles were being swallowed — a JS loop that does not terminate where
// C does is a control-flow miscompile, not a gap.
test_node = (mp: Allocator, jf: StringView, jerr: StringView, cout: StringView, crc: i64) Res {
    cmd = mp
        .String()
        .add("timeout 30 node ")
        .add(jf)
        .add(" 2>")
        .add(jerr)
        .add(" </dev/null")
        .finish_cstr()
    o = mp.sh(cmd)
    (o.exit != 0).match ({
        true  => Res(
            vid: V_JS_RUNTIME_FAIL,
            cout: cout,
            jout: mp.addr().cat_in(o.stdout, mp.slurp(jerr)),
            crc: crc,
            jrc: o.exit,
            jrc_set: true,
        ),
        false => Res(
            vid: (cout == o.stdout).then({ V_AGREE }, { V_DIVERGENCE }),
            cout: cout,
            jout: o.stdout,
            crc: crc,
            jrc: o.exit,
            jrc_set: true,
        ),
    })
}
// A clean "this construct is not lowered yet" diagnostic AND a compiler crash both land here;
// only a diagnosed refusal (rc 1) is a feature gap, anything else is the compiler failing.
test_js = (
    mp: Allocator,
    cfg: Cfg,
    zf: StringView,
    jf: StringView,
    jerr: StringView,
    cout: StringView,
    crc: i64,
) Res {
    cmd = mp
        .String()
        .add("timeout 30 ")
        .add(cfg.zen)
        .add(" emit-js ")
        .add(zf)
        .add(" > ")
        .add(jf)
        .add(" 2>/dev/null </dev/null")
        .finish_cstr()
    o = mp.sh(cmd)
    (o.exit != 0).match ({
        true  => Res(
            vid: (o.exit == 1).then({ V_JS_UNSUPPORTED }, { V_JS_EMIT_CRASH }),
            cout: cout,
            jout: "",
            crc: crc,
            jrc: o.exit,
            jrc_set: true,
        ),
        false => mp.test_node(jf, jerr, cout, crc),
    })
}
// write the program out, run both backends, and return the verdict plus both captured stdouts
test_one = (
    mp: Allocator,
    cfg: Cfg,
    zf: StringView,
    jf: StringView,
    jerr: StringView,
    src: StringView,
) Res {
    save(zf, src, src.len()).expect("fuzz-diff: cannot write the generated program")
    cmd = mp
        .String()
        .add("timeout 30 ")
        .add(cfg.zen)
        .add(" run ")
        .add(zf)
        .add(" 2>/dev/null </dev/null")
        .finish_cstr()
    o = mp.sh(cmd)
    (o.exit != 0).match ({
        true  => Res(
            vid: V_C_FAIL,
            cout: o.stdout,
            jout: "",
            crc: o.exit,
            jrc: 0,
            jrc_set: false,
        ),
        false => mp.test_js(cfg, zf, jf, jerr, o.stdout, o.exit),
    })
}
// ─────────────────────────────────────────────────────────────────────────────────────────────
// REPORTING
// ─────────────────────────────────────────────────────────────────────────────────────────────
// `  {k:16} {n}` — the label left-justified in 16 columns, exactly python's f-string alignment
summary_row = (mp: Allocator, id: i64, n: i64) void {
    nm = VERDICT_NAME[id]
    sout(mp
        .String()
        .add("  ")
        .add(nm)
        .repeat(" ", 16 - nm.len())
        .add_one(' ')
        .add_i64(n)
        .add_one('\n')
        .finish_cstr())
}
progress = (mp: Allocator, cfg: Cfg, done: i64, counts: MutSlice<i64>) void {
    eputs(mp
        .String()
        .add("  ...")
        .add_i64(done)
        .add_one('/')
        .add_i64(cfg.count)
        .add("  ")
        .add("AGREE=")
        .add_i64(counts[0])
        .add(" DIVERGENCE=")
        .add_i64(counts[1])
        .add(" JS-RUNTIME-FAIL=")
        .add_i64(counts[2])
        .add(" JS-EMIT-CRASH=")
        .add_i64(counts[3])
        .add(" JS-UNSUPPORTED=")
        .add_i64(counts[4])
        .add(" C-FAIL=")
        .add_i64(counts[5])
        .add_one('\n')
        .finish_cstr())
}
// save the three repro files and print the finding line
record = (
    mp: Allocator,
    cfg: Cfg,
    outdir: StringView,
    i: i64,
    src: StringView,
    r: Res,
    divs: MutSlice<i64>,
) void {
    base = mp
        .String()
        .add(outdir)
        .add_one('/')
        .add(VERDICT_LOWER[r.vid])
        .add("_s")
        .add_i64(cfg.seed)
        .add("_i")
        .add_i64(i)
        .finish_cstr()
    save(mp.addr().cat_in(base, ".zen"), src, src.len()).expect("fuzz-diff: cannot save the repro")
    save(mp.addr().cat_in(base, ".c.out"), r.cout, r.cout.len()).expect("fuzz-diff: cannot save the repro")
    save(mp.addr().cat_in(base, ".js.out"), r.jout, r.jout.len()).expect("fuzz-diff: cannot save the repro")
    format("[{}] seed={} i={}  -> {}.zen\n", [arg_str(VERDICT_NAME[r.vid]), arg_int(cfg.seed), arg_int(i), arg_str(base)])
    divs[g_ndiv] = i
    g_ndiv = g_ndiv + 1
}
run_one = (
    mp: Allocator,
    cfg: Cfg,
    zf: StringView,
    jf: StringView,
    jerr: StringView,
    outdir: StringView,
    i: i64,
    counts: MutSlice<i64>,
    divs: MutSlice<i64>,
) void {
    src = mp.gen_program(cfg.seed, i)
    r = mp.test_one(cfg, zf, jf, jerr, src)
    counts[r.vid] = counts[r.vid] + 1
    is_finding(r.vid).then({
        mp.record(cfg, outdir, i, src, r, divs)
    })
    ((i + 1) % 100 == 0).then({
        mp.progress(cfg, i + 1, counts)
    })
}
// `(i in [1, 5, 9])` — python's list repr of the finding indices
divs_list = (b: String, divs: MutSlice<i64>, i: i64) String {
    (i >= g_ndiv).match ({
        true  => b,
        false => {
            b1 = (i == 0).then({ b }, { b.add(", ") })
            b1.add_i64(divs[i]).divs_list(divs, i + 1)
        },
    })
}
// `--only N`: print program N and its two backend outputs, then exit
only_report = (mp: Allocator, cfg: Cfg, src: StringView, r: Res) void {
    head = mp
        .String()
        .add("# seed=")
        .add_i64(cfg.seed)
        .add(" only=")
        .add_i64(cfg.only)
        .add(" verdict=")
        .add(VERDICT_NAME[r.vid])
        .add_one('\n')
        .add(src)
        .add_one('\n')
        .add("--- C  [rc=")
        .add_i64(r.crc)
        .add("] ---\n")
        .add(r.cout)
        .add_one('\n')
        .add("--- JS [rc=")
    tail = r.jrc_set.then({ head.add_i64(r.jrc) }, { head.add("None") })
    sout(tail
        .add("] ---\n")
        .add(r.jout)
        .add_one('\n')
        .finish_cstr())
}
only_mode = (mp: Allocator, cfg: Cfg, zf: StringView, jf: StringView, jerr: StringView) i32 {
    src = mp.gen_program(cfg.seed, cfg.only)
    r = mp.test_one(cfg, zf, jf, jerr, src)
    mp.only_report(cfg, src, r)
    (r.vid == V_AGREE || r.vid == V_C_FAIL || r.vid == V_JS_UNSUPPORTED).then({ 0 }, { 1 })
}
// the closing block. exit 2 = nothing was compared on both backends (the run proves nothing);
// exit 1 = there are findings; exit 0 = clean.
finish = (
    mp: Allocator,
    cfg: Cfg,
    outdir: StringView,
    counts: MutSlice<i64>,
    divs: MutSlice<i64>,
) i32 {
    (counts[0] == 0).match ({
        true  => {
            sout("\nFAIL: not one program was compared on both backends — this run proves nothing.\n")
            2
        },
        false => (g_ndiv > 0).match ({
            true  => {
                sout(mp
                    .String()
                    .add("\nFINDINGS (")
                    .add_i64(g_ndiv)
                    .add("): repros in ")
                    .add(outdir)
                    .add_one('\n')
                    .add("  reproduce one:  ./zen run tools/fuzz-diff.zen --seed ")
                    .add_i64(cfg.seed)
                    .add(" --only <i>   (i in [")
                    .divs_list(divs, 0)
                    .add("])\n")
                    .finish_cstr())
                1
            },
            false => {
                sout(mp
                    .String()
                    .add("\nNo divergences. (repro dir: ")
                    .add(outdir)
                    .add(")\n")
                    .finish_cstr())
                0
            },
        }),
    })
}
full_mode = (
    mp: Allocator,
    cfg: Cfg,
    zf: StringView,
    jf: StringView,
    jerr: StringView,
    outdir: StringView,
) i32 {
    counts :: MutSlice<i64> = mp.addr().nbuf(to_i64(0), 6)
    counts.loop((h, i, x) {
        counts[i] = 0
    })
    divs: MutSlice<i64> = mp.addr().nbuf(to_i64(0), cfg.count + 1)
    probe: MutSlice<i64> = mp.addr().nbuf(to_i64(0), cfg.count)
    probe.loop((h, i, x) {
        mp.run_one(cfg, zf, jf, jerr, outdir, i, counts, divs)
    })
    sout("\n=== differential fuzz summary ===\n")
    format("seed={}  count={}  zen={}\n", [arg_int(cfg.seed), arg_int(cfg.count), arg_str(cfg.zen)])
    mp.summary_row(0, counts[0])
    mp.summary_row(1, counts[1])
    mp.summary_row(2, counts[2])
    mp.summary_row(3, counts[3])
    mp.summary_row(4, counts[4])
    mp.summary_row(5, counts[5])
    mp.finish(cfg, outdir, counts, divs)
}
// ─────────────────────────────────────────────────────────────────────────────────────────────
// CLI: `--seed N --count N --zen PATH --out DIR --only N`
// defaults: 1 / 200 / ./zen / a fresh /tmp dir / (absent)
// ─────────────────────────────────────────────────────────────────────────────────────────────
opt_at = (i: i32, name: StringView, dflt: StringView) StringView {
    (i + 1 >= argc()).match ({
        true  => dflt,
        false => (arg(i) == name).then({ arg(i + 1) }, { opt_at(i + 1, name, dflt) }),
    })
}
opt_str = (name: StringView, dflt: StringView) StringView { opt_at(1, name, dflt) }
opt_int = (name: StringView, dflt: i64) i64 {
    v = opt_at(1, name, "")
    (v.len() == 0).then({ dflt }, { v.parse_int() })
}
// python's os.path.abspath, for the `zen=` line of the summary and so the child processes are
// launched by a path that does not depend on the cwd
abs_path = (mp: Allocator, p: StringView) StringView {
    p.starts_with("/").match ({
        true  => p,
        false => {
            o = mp.sh(mp.addr().cat_in("readlink -f ", p))
            n = o.stdout.len()
            (n > 0).match ({
                true  => mp.addr().substr_in(o.stdout, 0, n - 1).expect("fuzz-diff: oom"),
                false => p,
            })
        },
    })
}
dispatch = (mp: Allocator, cfg: Cfg) i32 {
    outdir = (cfg.out.len() == 0).match ({
        true  => mp
            .String()
            .add("/tmp/zen-fuzzdiff-")
            .add_i64(to_i64(getpid()))
            .finish_cstr(),
        false => cfg.out,
    })
    wd = mp.addr().cat_in(outdir, "/.work")
    mp.sh(mp.addr().cat_in("mkdir -p ", wd))
    zf = mp.addr().cat_in(wd, "/prog.zen")
    jf = mp.addr().cat_in(wd, "/prog.js")
    jerr = mp.addr().cat_in(wd, "/prog.err")
    (cfg.only >= 0).match ({
        true  => mp.only_mode(cfg, zf, jf, jerr),
        false => mp.full_mode(cfg, zf, jf, jerr, outdir),
    })
}
main = () i32 {
    mp = heap_allocator()
    cfg = Cfg(
        seed: opt_int("--seed", 1),
        count: opt_int("--count", 200),
        only: opt_int("--only", 0 - 1),
        zen: mp.abs_path(opt_str("--zen", "./zen")),
        out: opt_str("--out", ""),
    )
    (cfg.zen.access(ACCESS_X_OK) == 0).match ({
        true  => mp.dispatch(cfg),
        false => {
            eputs(mp
                .String()
                .add("fuzz-diff: not executable: ")
                .add(cfg.zen)
                .add("  (run `make` first)\n")
                .finish_cstr())
            1
        },
    })
}
