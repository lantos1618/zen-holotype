// A field read must not consult free functions. `f.body` can only ever mean
// the field, so an unexported free function named `body` in the field's own
// module is not a candidate -- yet it used to be the one that survived the
// plausibility narrowing (a free function carries no owner, so it always
// stays in, while the field is dropped when its type is not in scope by
// name). With only an unreachable candidate left, the access was rejected:
//
//     main.zen:14:21: body is not exported by module pm
//
// An exported function of the same name resolved fine, which is the tell.
// Law 6: `*` is what crosses a boundary, and `body` does not.
//
// `Fn` is deliberately NOT imported: `make`'s return type is what says what
// `f` is, and that is a type question, not a scope one.

make = pm.pm

main = (env: Env) Res<i32, AllocError> {
    f = make(3);
    println("{}", f.body);
    println("{}", f.name);
    Ok(0);
}
