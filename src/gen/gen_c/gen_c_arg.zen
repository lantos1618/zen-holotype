// Shared call-argument rendering. Native capability calls use `arg_text` and
// `str_arg`; ordinary calls use declared parameter types and mutability.

ExprId, Call, Function = std.ast
AllocError = std.mem
Vec = std.collections
String = std.text
TyId = sema.sema_ty
Ctx = sema.sema_check
CBackend = gen.gen_c.gen_c_state
expr, value_held = gen.gen_c.gen_c_expr
declare_temp = gen.gen_c.gen_c_flow
address_of = gen.gen_c.gen_c_fat

arg_text* = (
    be   :: CBackend,
    c    : Call,
    i    : usize,
    want : TyId,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    c.args.get(i).match({
        None  => out.add("0"),
        Ok(a) => expr(be, a.value, ctx, want, out),
    })
}

str_arg* = (be :: CBackend, c: Call, i: usize, ctx: Ctx, out :: String)
          Res<(), AllocError> {
    sty = be.check.types.prim("str").try();
    tmp ::= be.fresh_name("t").try();
    be.declare_temp(sty, tmp.view()).try();
    value ::= be.alloc.String().try();
    be.arg_text(c, i, sty, ctx, value).try();
    be.set_line(tmp.view(), value.view()).try();
    out.fmt(
        "(const unsigned char *){}.data, {}.len",
        tmp.view(),
        tmp.view()
    ).try();
    Ok(())
}

// Signature argument zero is either the dot receiver or written argument zero.
recv_arg* = (c: Call, recv: Res<ExprId>) Res<ExprId> {
    recv.match({
        Ok(r) => Ok(r),
        None  => arg_value(c, 0),
    })
}

arg_value* = (c: Call, i: usize) Res<ExprId> {
    c.args.get(i).match({ Ok(a) => Ok(a.value), None => None })
}

write_arg* = (
    be    :: CBackend,
    value : ExprId,
    i     : usize,
    f     : Function,
    sig   : Vec<TyId>,
    ctx   : Ctx,
    out   :: String
) Res<(), AllocError> {
    be.write_arg_at(value, i, false, f, sig, ctx, out)
}

// Mutable parameters receive the address of the caller's place. Other
// arguments may be held to preserve Zen's left-to-right evaluation order.
write_arg_at* = (
    be    :: CBackend,
    value : ExprId,
    i     : usize,
    hold  : bool,
    f     : Function,
    sig   : Vec<TyId>,
    ctx   : Ctx,
    out   :: String
) Res<(), AllocError> {
    want = sig.get(i).match({ Ok(t) => t, None => TyId(index: 0) });
    by_ref(f, i).match({
        false => be.value_held(value, ctx, want, hold, out),
        true  => be.write_address(value, ctx, want, out),
    })
}

by_ref* = (f: Function, i: usize) bool {
    f.params.get(i).match({ Ok(p) => p.mutable, None => false })
}

write_address* = (
    be    :: CBackend,
    value : ExprId,
    ctx   : Ctx,
    want  : TyId,
    out   :: String
) Res<(), AllocError> {
    code ::= be.alloc.String().try();
    be.expr(value, ctx, want, code).try();
    be.address_of(code.view(), want, out).try();
    Ok(())
}
