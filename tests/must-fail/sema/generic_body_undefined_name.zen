// A generic body is checked once at its declaration, not only per
// instantiation: a mistake that owes nothing to the type arguments is
// wrong whether or not anything calls the function. The bootstrapper
// checked generics lazily, at each instantiation, so a broken generic
// nobody called compiled clean -- the checker's authority ended where
// the call graph did.
//
// `nowhere` is undefined under EVERY `T`, which is what makes it a
// declaration-time error rather than a deferred one: anything genuinely
// dependent on the parameter still waits for the call site.
//
// position: the name that resolves to nothing.

id* = <T>(x: T) T { nowhere }

main* = () () {}
