// The other half: a module alias in value position rather than callee
// position. `zz` is a module, so there is nothing to print -- and saying
// so is the difference between a diagnostic and a puzzle, since the
// error this used to produce was "cannot print a value of this type".

zz = vec

main = (env: Env) Res<i32, IoError> {
    println("{}", zz);
    Ok(0);
}
