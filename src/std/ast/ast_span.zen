// src/std/ast/ast_span.zen
// Where a node is, and what surrounds it.
//
// DESIGN.md: every AST node carries a `file` plus a half-open
// `start..end` span, each end a `line:col` with a 1-based byte column.
// A point isn't enough — without an end, the formatter can't reprint a
// node and the LSP can't select one.
//
// tests/corpus/parse/POSITIONS.md is the authority for the rest:
//   - `end` is one past the last byte.
//   - a span includes the node's own delimiters and all children,
//     excludes the separator that follows it.
//   - a STATEMENT's span includes its `;`; the expression inside does
//     not: `Ok(0);` is 25:5..25:11, `Ok(0)` is 25:5..25:10.
//   - a node's span does NOT include leading trivia — trivia has its
//     own span, which is what lets `fmt` move a declaration without
//     dragging its comment along.

// A point in a file. `col` counts BYTES, not codepoints or UTF-16
// units — `str` is bytes everywhere else here; an LSP converts to
// UTF-16 at the wire, as its own testable step.
Pos* = {
    line*: usize,
    col*: usize,
}

// Half-open: [start, end). `file` is always relative to the
// compilation root — traps print it, gen_c emits it, and an absolute
// path would make two checkouts of one tree emit different bytes.
Span* = {
    file*: str,
    start*: Pos,
    end*: Pos,
}

// Whitespace is trivia too: a blank line between two declarations is a
// thing the author wrote and the formatter must not silently delete.
// One Blank stands for a run of blank lines, however long — collapsing
// them is a formatting rule, and a rule needs somewhere to apply.
TriviaKind* = LineComment | BlockComment | Blank

// `text` is the raw source slice, comment markers and all. The
// formatter reprints it byte for byte; nothing here parses it.
Trivia* = {
    kind*: TriviaKind,
    text*: str,
    span*: Span,
}

// Where a node's trivia lives: a run of `Ast.trivia`, which holds
// every comment and blank in the file in source order. `len` of 0 is
// no trivia, which is the overwhelming majority of nodes.
//
// Two words, and that is the reason for the indirection. A node
// carrying two `Vec<Trivia>` instead would carry sixteen — a Vec is
// eight words here, because the `Alloc` it grows through is a fat
// value — and it would pay that on every node in the tree to describe
// something almost no node has.
TriviaRun* = {
    at*: usize,
    len*: usize,
}

// The empty run. A function rather than a constant because every node
// constructor writes it, and `no_trivia()` says what it means where a
// bare `TriviaRun(at: 0, len: 0)` says only how it is spelled.
no_trivia* = () TriviaRun { TriviaRun(at: 0, len: 0) }

// NOWHERE: the span for a thing that has no place in any file — a
// member a trait supplies, a diagnostic about a whole module. Here for
// the same reason `no_trivia` is: it is a fact about `Span`, and it had
// been written out five times under three names (`nowhere` in
// `sema_member`, `sema_cycle` and `sema_match`, `no_span` in `lsp_def`
// and `lsp_compl`) before anyone put it where `Span` lives.
//
// `line: 0` is what makes it recognisable: source lines are 1-based, so
// no real position collides with it.
nowhere* = () Span {
    Span(file: "", start: Pos(line: 0, col: 0), end: Pos(line: 0, col: 0))
}

// One identifier, with the span of the identifier alone. Every name in
// a declaring or referring position is one of these rather than a bare
// `str`, because rename, go-to-definition and "no such field" all need
// to point at the name and not at the node that contains it.
Ident* = {
    text*: str,
    span*: Span,
}

// A dotted name: `std.core.result` in an import, `Shape.Unit` in a
// pattern. Segments are stored apart so a diagnostic can point at the
// segment that is wrong rather than at the whole name; `span` covers
// the whole name, dots included.
QualifiedName* = {
    segments*: Vec<Ident>,
    span*: Span,
}
