{ diagnostic_from_source } = compiler.validate.diag
{ to_exit } = std.core.bool
{ eq } = std.text.str
main = () i32 {
    diag := diagnostic_from_source("main = () i32 { missing_name() }\n", 1027, 1)    // 1027 = kind 3 (undefined-name) + offset 16 * 64 (6-bit kind packing, see kv_at)
    ok := eq(diag.kind, "undefined-name") && diag.span.start == 16 && diag.span.width == 12 && diag.count == 1 && eq(diag.message, "undefined name") && eq(diag.hint, "declare the name, import it, or qualify the intended module binding")
    ok.to_exit()
}
