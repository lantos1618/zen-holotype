// A function value carries executable environment state and remains unsafe
// when a struct wraps it.

CallbackBox = { callback: (value: i32) i32 }

Worker = {}

Worker.impl(Actor, {
    process = (self :: @Self, ctx: Context, payload: CallbackBox) {
        ctx.env.out.println("received")
    }
})

forward = (worker: Ref<Worker>, payload: CallbackBox) Res<(), ActorError> {
    worker.process(payload).try();
    Ok(())
}

main = (env: Env) Res<i32, AllocError> { Ok(0) }
