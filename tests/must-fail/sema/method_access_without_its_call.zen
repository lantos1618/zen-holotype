// tests/must-fail/sema/method_access_without_its_call.zen
// A BARE METHOD IS NOT THE VALUE ITS RETURN TYPE WOULD BE. `String.len`
// is a method and `Vec.len` is a field — same spelling, two of the most
// closely-related types in std — so `s.len` where `s.len()` was meant
// read as a member access that resolves. Sema typed it `(String) usize`
// and passed it to `Range`'s `end: usize` parameter, gen_c emitted C
// reading `.len` off a struct that has no such member, and only cc named
// it (`has no member named 'zu_m3len'`) — issue #772, one named face of
// CC_REJECTED #721.
//
// The annotated let was the one position that already refused it, which
// proved the type WAS computed as a function type; the argument slot
// simply never asked. `settled` (sema_member.zen) is now the one place
// that refuses, before any position can wave a method through.
//
// position: `.len`, the access whose missing call is the mistake.

main = (env: Env) Res<i32, AllocError> {
    a = env.mem.alloc();
    s ::= String(a, "hello").try();
    n ::= 0;
    Range(0, s.len).loop((h, i) { n = n + 1; });
    println("iterations={} (want 5)", n);
    Ok(0);
}
