// probe 2: deep recursion + mutual recursion cycles
deep = (n: i64) i64 {
    (n <= 0).match({
        true  => 0,
        false => 1 + deep(n - 1),
    });
}

is_even = (n: i32) bool {
    (n == 0).match({ true => true, false => is_odd(n - 1) });
}
is_odd = (n: i32) bool {
    (n == 0).match({ true => false, false => is_even(n - 1) });
}

a3 = (n: i32) i32 { (n == 0).match({ true => 100, false => b3(n - 1) + 1 }) }
b3 = (n: i32) i32 { (n == 0).match({ true => 200, false => c3(n - 1) + 3 }) }
c3 = (n: i32) i32 { (n == 0).match({ true => 300, false => a3(n - 1) + 5 }) }

main = (env: Env) Res<i32, AllocError> {
    println("{}", deep(100000));
    e10 = is_even(10).match({ true => 1, false => 0 });
    e7 = is_even(7).match({ true => 1, false => 0 });
    println("{}", e10 * 10 + e7);
    println("{}", a3(4));
    Ok(0);
}
