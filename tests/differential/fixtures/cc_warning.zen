// A C warning remains an observable compiler outcome instead of being hidden
// behind a program that happens to run successfully.
constant_zero = (value: i32) i32 { 0 }

main = (env: Env) Res<i32, AllocError> {
    (env.argv.len == 0).match({
        true  => Ok(constant_zero(41)),
        false => Ok(constant_zero(41)),
    })
}
