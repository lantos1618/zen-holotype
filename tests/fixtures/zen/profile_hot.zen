// profile fixture: a deliberately CPU-bound hot function (repeated string-byte folding) so
// `zen profile` has something to sample — the harness asserts `hot_hash` appears in the table.
// Self-recursive on purpose: the inliner never dissolves it, so the C symbol survives to perf/gprof.
{ view } = std.text.str
hot_hash = (s: StringView, rounds: i64, acc: i64) i64 {
    (rounds <= 0).then({
        return acc
    })
    v: [u8] := s.view()
    h := acc
    v.loop((hd, i, b) {
        h = (h * 131 + to_i64(b)) % 1000000007
    })
    hot_hash(s, rounds - 1, h)
}
main = () i32 {
    h := hot_hash("the quick brown fox jumps over the lazy zen compiler", 2000000, 7)
    (h > 0).then({ 0 }, { 1 })
}
