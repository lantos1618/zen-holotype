Ast, Module, Decl, Expr, Import, Pos, Span, ExprId, nowhere = std.ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
World, Def, DefKind, dotted, module_display = sema.sema_def

ConstSite = {
    module: usize,
    span:   Span,
}

Edge = {
    from: usize,
    to:   usize,
}

check_module_graph* = (a: Alloc, tree: Ast, w: World, out :: String)
                      Res<usize, AllocError> {
    n ::= self_imports(a, tree, w, out).try();
    n = n + const_cycles(a, tree, w, out).try();
    Ok(n);
}

// a module that imports itself
self_imports = (a: Alloc, tree: Ast, w: World, out :: String)
               Res<usize, AllocError> {
    n ::= 0;
    Range(0, tree.module_count()).loop((h, mi) {
        n = n + module_self_imports(a, tree, w, mi, out).try();
    });
    Ok(n);
}

module_self_imports = (
    a    : Alloc,
    tree : Ast,
    w    : World,
    mi   : usize,
    out  :: String
) Res<usize, AllocError> {
    tree.module_at(mi).match({
        None  => Ok(0),
        Ok(m) => decls_self_import(a, w, m, mi, out),
    })
}

decls_self_import = (a: Alloc, w: World, m: Module, mi: usize, out :: String)
                    Res<usize, AllocError> {
    n ::= 0;
    m.decls.loop((h, d) {
        n = n + decl_self_import(a, w, m, d, mi, out).try();
    });
    Ok(n);
}

decl_self_import = (
    a   : Alloc,
    w   : World,
    m   : Module,
    d   : Decl,
    mi  : usize,
    out :: String
) Res<usize, AllocError> {
    d.kind.match({
        Import(im) => import_self(a, w, m, im, mi, out),
        _          => Ok(0),
    })
}

import_self = (
    a   : Alloc,
    w   : World,
    m   : Module,
    im  : Import,
    mi  : usize,
    out :: String
) Res<usize, AllocError> {
    path = dotted(a, im.module).try();
    names_module(w, path, mi).match({
        false => Ok(0),
        true  => say_self_import(m, im.module.span, out),
    })
}

say_self_import = (m: Module, at: Span, out :: String)
                  Res<usize, AllocError> {
    write_where(out, at).try();
    out.fmt(
        "module {} imports itself: an import is the one declaration that reaches OUTSIDE the file, and this one names the file it is written in\n",
        module_display(m.name)
    ).try();
    Ok(1);
}

// a cycle in top-level constants
const_cycles = (a: Alloc, tree: Ast, w: World, out :: String)
               Res<usize, AllocError> {
    es = const_edges(a, tree, w).try();
    (es.len == 0).match({
        true  => Ok(0),
        false => cycles_in(a, tree, w, es, out),
    })
}

cycles_in = (a: Alloc, tree: Ast, w: World, es: Vec<Edge>, out :: String)
            Res<usize, AllocError> {
    n ::= 0;
    Range(0, w.count()).loop((h, mi) {
        n = n + cycle_at(a, tree, w, es, mi, out).try();
    });
    Ok(n);
}

cycle_at = (
    a    : Alloc,
    tree : Ast,
    w    : World,
    es   : Vec<Edge>,
    mi   : usize,
    out  :: String
) Res<usize, AllocError> {
    onward = reach_from(a, es, mi).try();
    mi.is_in(onward).match({
        false => Ok(0),
        true  => report_component(a, tree, w, es, mi, onward, out),
    })
}

report_component = (
    a      : Alloc,
    tree   : Ast,
    w      : World,
    es     : Vec<Edge>,
    mi     : usize,
    onward : Vec<usize>,
    out    :: String
)
                   Res<usize, AllocError> {
    comp = component_of(a, es, mi, onward).try();
    first_named(w, comp, mi).match({
        false => Ok(0),
        true  => say_cycle(a, tree, w, es, mi, comp, out),
    })
}

component_of = (a: Alloc, es: Vec<Edge>, mi: usize, onward: Vec<usize>)
               Res<Vec<usize>, AllocError> {
    comp ::= a.Vec<usize>();
    comp.add(mi).try();
    onward.loop((h, j) {
        keep_if_mutual(a, es, mi, j, comp).try();
    });
    Ok(comp);
}

keep_if_mutual = (
    a    : Alloc,
    es   : Vec<Edge>,
    mi   : usize,
    j    : usize,
    comp :: Vec<usize>
) Res<(), AllocError> {
    (j == mi).match({
        true  => Ok(()),
        false => add_if_reaches(a, es, mi, j, comp),
    })
}

add_if_reaches = (
    a    : Alloc,
    es   : Vec<Edge>,
    mi   : usize,
    j    : usize,
    comp :: Vec<usize>
) Res<(), AllocError> {
    back = reach_from(a, es, j).try();
    mi.is_in(back).match({
        false => Ok(()),
        true  => comp.add(j),
    })
}

first_named = (w: World, comp: Vec<usize>, mi: usize) bool {
    Range(0, comp.len).find((k) {
        module_name_of(w, comp.get(k).value_or(mi)).before(module_name_of(w, mi))
    }).match({
        Ok(_) => false,
        None  => true,
    })
}

module_name_of = (w: World, mi: usize) str {
    w.table_at(mi).match({
        Ok(t) => t.name,
        None  => "",
    })
}

say_cycle = (
    a    : Alloc,
    tree : Ast,
    w    : World,
    es   : Vec<Edge>,
    mi   : usize,
    comp : Vec<usize>,
    out  :: String
) Res<usize, AllocError> {
    path = shortest_cycle(a, es, mi, comp).try();
    at   = edge_span(a, tree, w, mi, path.get(1).value_or(mi)).try();
    write_where(out, at).try();
    out.add("import cycle: ").try();
    Range(0, path.len).loop((h, k) {
        write_hop(out, module_name_of(w, path.get(k).value_or(mi)), k).try();
    });
    out.add(
        ": a top-level constant needs a value from a module whose own needs it back, and no order computes both"
    ).try();
    out.add("\n").try();
    Ok(1);
}

write_hop = (out :: String, name: str, k: usize) Res<(), AllocError> {
    (k > 0).then(() { out.add(" -> ").try(); });
    out.add(module_display(name))
}

shortest_cycle = (a: Alloc, es: Vec<Edge>, start: usize, comp: Vec<usize>)
                 Res<Vec<usize>, AllocError> {
    order  ::= a.Vec<usize>();
    prev   ::= a.Vec<usize>();
    closed ::= a.Vec<usize>();
    order.add(start).try();
    prev.add(0).try();
    i ::= 0;
    loop(() { i < order.len && closed.len == 0 }, (h) {
        from = order.get(i).value_or(start);
        at   = i;
        es.loop((g, e) {
            visit_edge(e, from, at, start, comp, order, prev, closed).try();
        });
        i = i + 1;
    });
    unwind_cycle(a, order, prev, closed, start)
}

visit_edge = (
    e      : Edge,
    from   : usize,
    at     : usize,
    start  : usize,
    comp   : Vec<usize>,
    order  :: Vec<usize>,
    prev   :: Vec<usize>,
    closed :: Vec<usize>
)
             Res<(), AllocError> {
    (e.from == from).match({
        false => Ok(()),
        true  => take_edge(e.to, at, start, comp, order, prev, closed),
    })
}

take_edge = (
    to     : usize,
    at     : usize,
    start  : usize,
    comp   : Vec<usize>,
    order  :: Vec<usize>,
    prev   :: Vec<usize>,
    closed :: Vec<usize>
)
            Res<(), AllocError> {
    (to == start).match({
        true  => close_cycle(at, closed),
        false => open_edge(to, at, comp, order, prev),
    })
}

// Breadth-first search keeps the first edge that closes a shortest cycle.
close_cycle = (at: usize, closed :: Vec<usize>) Res<(), AllocError> {
    (closed.len == 0).match({
        false => Ok(()),
        true  => closed.add(at),
    })
}

// Inside the component only: an edge leaving it can never come back, so
// following one would search the whole graph to prove nothing.
open_edge = (
    to    : usize,
    at    : usize,
    comp  : Vec<usize>,
    order :: Vec<usize>,
    prev  :: Vec<usize>
) Res<(), AllocError> {
    (to.is_in(comp) && !to.is_in(order)).match({
        false => Ok(()),
        true  => { order.add(to).try(); prev.add(at) },
    })
}

unwind_cycle = (
    a      : Alloc,
    order  : Vec<usize>,
    prev   : Vec<usize>,
    closed : Vec<usize>,
    start  : usize
) Res<Vec<usize>, AllocError> {
    back ::= a.Vec<usize>();
    at   ::= closed.get(0).value_or(0);
    back.add(order.get(at).value_or(start)).try();
    loop(at > 0, (h) {
        at = prev.get(at).value_or(0);
        back.add(order.get(at).value_or(start)).try();
    });
    path ::= a.Vec<usize>();
    Range(0, back.len).loop((h, k) {
        path.add(back.get(back.len - 1 - k).value_or(start)).try();
    });
    path.add(start).try();
    Ok(path);
}

reach_from = (a: Alloc, es: Vec<Edge>, start: usize)
             Res<Vec<usize>, AllocError> {
    seen  ::= a.Vec<usize>();
    front ::= a.Vec<usize>();
    front.add(start).try();
    i ::= 0;
    loop(i < front.len, (h) {
        from = front.get(i).value_or(start);
        i    = i + 1;
        es.loop((g, e) { step_reach(e, from, seen, front).try(); });
    });
    Ok(seen);
}

step_reach = (e: Edge, from: usize, seen :: Vec<usize>, front :: Vec<usize>)
             Res<(), AllocError> {
    (e.from == from && !e.to.is_in(seen)).match({
        false => Ok(()),
        true  => { seen.add(e.to).try(); front.add(e.to) },
    })
}

// the constant graph
const_edges = (a: Alloc, tree: Ast, w: World) Res<Vec<Edge>, AllocError> {
    sites = const_sites(a, tree).try();
    es  ::= a.Vec<Edge>();
    eid ::= ExprId(index: 0);
    Range(0, tree.expr_ids()).loop((h, i) {
        name_edges(a, tree, w, sites, tree.expr_at(eid), es).try();
        eid = ExprId(index: eid.index + 1);
    });
    Ok(es);
}

const_sites = (a: Alloc, tree: Ast) Res<Vec<ConstSite>, AllocError> {
    sites ::= a.Vec<ConstSite>();
    Range(0, tree.module_count()).loop((h, mi) {
        module_const_sites(tree, mi, sites).try();
    });
    Ok(sites);
}

module_const_sites = (tree: Ast, mi: usize, sites :: Vec<ConstSite>)
                     Res<(), AllocError> {
    tree.module_at(mi).match({
        None  => Ok(()),
        Ok(m) => decl_const_sites(m, mi, sites),
    })
}

decl_const_sites = (m: Module, mi: usize, sites :: Vec<ConstSite>)
                   Res<(), AllocError> {
    m.decls.loop((h, d) {
        keep_const_site(d, mi, sites).try();
    });
    Ok(());
}

keep_const_site = (d: Decl, mi: usize, sites :: Vec<ConstSite>)
                  Res<(), AllocError> {
    d.kind.match({
        Const(_) => sites.add(ConstSite(module: mi, span: d.span)),
        _        => Ok(()),
    })
}

name_edges = (
    a     : Alloc,
    tree  : Ast,
    w     : World,
    sites : Vec<ConstSite>,
    e     : Expr,
    es    :: Vec<Edge>
) Res<(), AllocError> {
    e.kind.match({
        Name(n) => site_edges(a, w, sites, e.span, n.text, es),
        _       => Ok(()),
    })
}

site_edges = (
    a     : Alloc,
    w     : World,
    sites : Vec<ConstSite>,
    at    : Span,
    name  : str,
    es    :: Vec<Edge>
) Res<(), AllocError> {
    site_of(sites, at).match({
        None   => Ok(()),
        Ok(mi) => resolved_edges(a, w, mi, name, es),
    })
}

// Which module-level constant this expression is written inside.
site_of = (sites: Vec<ConstSite>, at: Span) Res<usize> {
    Range(0, sites.len).find((k) {
        sites.get(k).match({
            Ok(s) => encloses(s.span, at),
            None  => false,
        })
    }).match({
        Ok(k) => site_module(sites, k),
        None  => None,
    })
}

site_module = (sites: Vec<ConstSite>, k: usize) Res<usize> {
    sites.get(k).match({
        Ok(s) => Ok(s.module),
        None  => None,
    })
}

encloses = (outer: Span, at: Span) bool {
    at.start.at_or_after(outer.start)
        && outer.end.at_or_after(at.end)
        && outer.file.eq(at.file)
}

resolved_edges = (a: Alloc, w: World, mi: usize, name: str, es :: Vec<Edge>)
                 Res<(), AllocError> {
    found ::= a.Vec<Def>();
    w.defs_of(mi, name, found).try();
    found.loop((h, d) {
        keep_const_edge(d, mi, es).try();
    });
    Ok(());
}

keep_const_edge = (d: Def, mi: usize, es :: Vec<Edge>) Res<(), AllocError> {
    other = d.id.module.to_usize();
    (is_const(d.kind) && other != mi).match({
        false => Ok(()),
        true  => add_edge(mi, other, es),
    })
}

is_const = (k: DefKind) bool {
    k.match({
        ConstDef => true,
        _        => false,
    })
}

add_edge = (from: usize, to: usize, es :: Vec<Edge>) Res<(), AllocError> {
    has_edge(es, from, to).match({
        true  => Ok(()),
        false => es.add(Edge(from: from, to: to)),
    })
}

has_edge = (es: Vec<Edge>, from: usize, to: usize) bool {
    Range(0, es.len).find((k) {
        es.get(k).match({
            Ok(e) => e.from == from && e.to == to,
            None  => false,
        })
    }).match({
        Ok(_) => true,
        None  => false,
    })
}

edge_span = (a: Alloc, tree: Ast, w: World, from: usize, to: usize)
            Res<Span, AllocError> {
    tree.module_at(from).match({
        None  => Ok(nowhere()),
        Ok(m) => module_edge_span(a, w, m, to),
    })
}

module_edge_span = (a: Alloc, w: World, m: Module, to: usize)
                   Res<Span, AllocError> {
    spans ::= a.Vec<Span>();
    m.decls.loop((h, d) {
        keep_import_span(a, w, d, to, spans).try();
    });
    spans.get(0).match({
        Ok(s) => Ok(s),
        None  => Ok(m.span),
    })
}

keep_import_span = (
    a     : Alloc,
    w     : World,
    d     : Decl,
    to    : usize,
    spans :: Vec<Span>
) Res<(), AllocError> {
    d.kind.match({
        Import(im) => keep_if_names(a, w, im, to, spans),
        _          => Ok(()),
    })
}

keep_if_names = (
    a     : Alloc,
    w     : World,
    im    : Import,
    to    : usize,
    spans :: Vec<Span>
) Res<(), AllocError> {
    path = dotted(a, im.module).try();
    names_module(w, path, to).match({
        false => Ok(()),
        true  => spans.add(im.module.span),
    })
}

names_module = (w: World, path: str, mi: usize) bool {
    w.index_of(path).match({
        Ok(j) => j == mi,
        None  => false,
    })
}

write_where = (out :: String, at: Span) Res<(), AllocError> {
    out.fmt("{}:{}: ", at.file, at.start)
}
