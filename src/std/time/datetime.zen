// std.time.datetime — civil (proleptic Gregorian) date/time: Unix-epoch ↔ calendar conversion, an
// ISO-8601 subset parser/formatter, and the small calendar predicates (leap year, month length,
// weekday). Everything here is UTC and DST-free: a DateTime is a plain value with no zone attached,
// and the epoch bridge is pure integer arithmetic — no libc gmtime_r, so no struct-tm layout
// dependency and a fully deterministic result on every platform.
//
// THE CORE BRIDGE is Howard Hinnant's `days_from_civil` / `civil_from_days` pair. It shifts the epoch
// to an era anchored at 0000-03-01 so that leap years fall out of exact integer division with NO
// lookup tables — one era is 400 civil years = 146097 days, and March-based month numbering pushes the
// leap-day irregularity (Jan/Feb) to the tail of the year where the division absorbs it. The algorithm
// is exact across the whole i64 range, negative timestamps included (floored division, so pre-1970
// instants convert correctly too).
//
//   dt := datetime.from_unix(1000000000)      // 2001-09-09T01:46:40 UTC, weekday = Sunday(0)
//   secs := dt.to_unix()                       // 1000000000  (exact inverse)
//   now := datetime.now()                      // wall-clock UTC via std.time
//   datetime.parse_iso("2000-02-29").match ({  // ISO-8601 subset → Result
//       .Ok(d)  => ...,                         //   valid leap-day
//       .Err(e) => ...,                         //   .OutOfRange / .BadLength / .BadDigit / .BadSeparator
//   })
//   s := dt.format_iso(a.addr()).expect("oom") // "2001-09-09T01:46:40" (allocator-threaded)
//
// ALLOCATOR. Only `format_iso` allocates (a 20-byte rendered string); it takes `a: MutPtr<A>` for any
// `A: Allocator` and returns Result — allocation failure is a value, house style. Everything else
// (from_unix/to_unix/parse_iso/is_leap/days_in_month/weekday) is pure and allocation-free.
{ Result, IoError, ok, err } = std.core.result
{ len, view } = std.text.str
{ is_digit } = std.text.bytes    // canonical ASCII digit test (centralized in std.text.bytes)
{ try_acquire } = std.mem.alloc
{ wall_s } = std.time.clock
// seconds-of-day + era constants shared by the epoch bridge below.
SEC_PER_MIN := 60
SEC_PER_HOUR := 3600
SEC_PER_DAY := 86400
DAYS_PER_ERA := 146097    // one era = 400 civil years
EPOCH_SHIFT := 719468    // days from the 0000-03-01 era origin to 1970-01-01
// A UTC calendar instant, split into fields. `weekday` is 0=Sunday .. 6=Saturday. This is a plain
// value; from_unix/parse_iso fill it, to_unix reads it back. No zone, no DST — pure civil UTC.
DateTime*: {
    year: i64,
    month: i64,
    day: i64,
    hour: i64,
    min: i64,
    sec: i64,
    weekday: i64,
}
// Why a parse failed. `BadLength` = the string isn't a 10-char date or 19-char date-time; `BadDigit`
// carries the byte found where a digit was required; `BadSeparator` carries the byte found where a
// '-' / 'T' / ':' was required; `OutOfRange` = a field parsed but is out of its civil range (e.g.
// month 13, or 2001-02-29 which isn't a leap year).
DateError*: BadLength | BadDigit(u8) | BadSeparator(u8) | OutOfRange
// Human-readable variant name, for printing an error path.
error_name* = (e: DateError) string_view {
    e.match ({
        .BadLength       => "BadLength",
        .BadDigit(b)     => "BadDigit",
        .BadSeparator(b) => "BadSeparator",
        .OutOfRange      => "OutOfRange",
    })
}
// ── calendar predicates ───────────────────────────────────────────────────────
// A Gregorian leap year: divisible by 4, except centuries, except those divisible by 400.
is_leap* = (year: i64) bool { year % 4 == 0 && year % 100 != 0 || year % 400 == 0 }
// Days in `month` (1..12) of `year`, computed as the gap between the first of this month and the first
// of the next — so it inherits leap-year correctness from days_from_civil with no lookup table and no
// magic constants. December rolls the year over.
days_in_month* = (year: i64, month: i64) i64 {
    ny := (month == 12).match ({ true => year + 1, false => year })
    nm := (month == 12).match ({ true => 1, false => month + 1 })
    days_from_civil(ny, nm, 1) - days_from_civil(year, month, 1)
}
// ── the epoch bridge (Howard Hinnant) ─────────────────────────────────────────
// Days since 1970-01-01 for a civil (year, month, day). Shifts to the 0000-03-01 era so leap years
// fall out of integer division; the March-based month `mp` puts Jan/Feb at the tail of the prior year.
days_from_civil = (y: i64, m: i64, d: i64) i64 {
    y2 := (m <= 2).match ({ true => y - 1, false => y })    // Jan/Feb belong to the previous civil year
    era := (y2 >= 0).match ({ true => y2, false => y2 - 399 }) / 400    // floored, so negatives are exact
    yoe := y2 - era * 400    // year-of-era [0, 399]
    mp := (m > 2).match ({ true => m - 3, false => m + 9 })    // March-based month [0, 11]
    doy := (153 * mp + 2) / 5 + d - 1    // day-of-year, March-based [0, 365]
    doe := yoe * 365 + yoe / 4 - yoe / 100 + doy    // day-of-era [0, 146096]
    era * DAYS_PER_ERA + doe - EPOCH_SHIFT
}
// Weekday (0=Sunday .. 6=Saturday) for a day count since 1970-01-01. 1970-01-01 was a Thursday, so +4
// rebases the epoch to Sunday=0; the extra `+ 7 ) % 7` normalizes C's toward-zero remainder for
// negative day counts (pre-epoch dates).
weekday_of_days = (days: i64) i64 { ((days + 4) % 7 + 7) % 7 }
// Weekday (0=Sunday .. 6=Saturday) of a DateTime, recomputed from its date fields (so it is correct
// even for a DateTime built by hand or by parse_iso, not only those from from_unix).
weekday* = (dt: DateTime) i64 { weekday_of_days(days_from_civil(dt.year, dt.month, dt.day)) }
// Split a Unix timestamp (seconds since 1970-01-01T00:00:00Z, negative allowed) into UTC calendar
// fields. Time-of-day uses floored day arithmetic so a negative `secs` still yields a 0..86399
// remainder; the date uses civil_from_days (the inverse of days_from_civil above).
from_unix* = (secs: i64) DateTime {
    days := (secs >= 0).match ({
        true  => secs / SEC_PER_DAY,
        false => (secs - (SEC_PER_DAY - 1)) / SEC_PER_DAY,
    })
    rem := secs - days * SEC_PER_DAY    // 0 .. 86399 regardless of sign
    hh := rem / SEC_PER_HOUR
    mm := rem % SEC_PER_HOUR / SEC_PER_MIN
    ss := rem % SEC_PER_MIN
    z := days + EPOCH_SHIFT    // shift to the 0000-03-01 era origin
    era := (z >= 0).match ({ true => z, false => z - (DAYS_PER_ERA - 1) }) / DAYS_PER_ERA    // floored
    doe := z - era * DAYS_PER_ERA    // day-of-era [0, 146096]
    yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365    // year-of-era [0, 399]
    y := yoe + era * 400
    doy := doe - (365 * yoe + yoe / 4 - yoe / 100)    // day-of-year, March-based [0, 365]
    mp := (5 * doy + 2) / 153    // March-based month [0, 11]
    d := doy - (153 * mp + 2) / 5 + 1    // day-of-month [1, 31]
    m := (mp < 10).match ({ true => mp + 3, false => mp - 9 })    // civil month [1, 12]
    // roll March-based Jan/Feb into the next civil year
    yr := (m <= 2).match ({ true => y + 1, false => y })
    DateTime(
        year: yr,
        month: m,
        day: d,
        hour: hh,
        min: mm,
        sec: ss,
        weekday: weekday_of_days(days),
    )
}    // roll March-based Jan/Feb into the next civil year
// The exact inverse of from_unix: civil fields → Unix seconds (the sub-day time is added straight on).
to_unix* = (dt: DateTime) i64 {
    days_from_civil(dt.year, dt.month, dt.day) * SEC_PER_DAY + dt.hour * SEC_PER_HOUR + dt.min * SEC_PER_MIN + dt.sec
}
// ── now (wall-clock, via std.time) ────────────────────────────────────────────
// The current UTC calendar instant, read from CLOCK_REALTIME (std.time.wall_s) and split with
// from_unix. No allocator, no ambient runtime — a direct clock read folded through the pure bridge.
now* = () DateTime { from_unix(wall_s()) }
// ── ISO-8601 subset parsing ───────────────────────────────────────────────────
// The byte at index `i`, or 0 when out of range. Local (not std.text.str.at) because `at` collides on
// the flat namespace with std.text.bytes.at (an i32-index variant), so it can bind to the wrong one;
// going through `view` (a unique name) sidesteps that.
byte_at = (s: string_view, i: i64) u8 {
    sv := view(s)
    (i >= 0 && i < sv.len).match ({ true => sv[i], false => 0 })
}
// Scan s[i..end); return the first non-digit byte, or 0 when every byte in the range is a digit
// (a digit byte is never 0, so 0 is an unambiguous "all clear").
first_nondigit = (s: string_view, i: i64, end: i64) u8 {
    (i >= end).match ({
        true  => 0,
        false => is_digit(byte_at(s, i)).match ({
            true  => first_nondigit(s, i + 1, end),
            false => byte_at(s, i),
        }),
    })
}
// Decode the 2-digit decimal at s[i..i+2] (positions already validated to be digits).
num2 = (s: string_view, i: i64) i64 {
    (byte_at(s, i) - '0').to_i64() * 10 + (byte_at(s, i + 1) - '0').to_i64()
}
// Decode the 4-digit decimal at s[i..i+4].
num4 = (s: string_view, i: i64) i64 { num2(s, i) * 100 + num2(s, i + 2) }
// Is every field of `dt` within its civil range? (month 1..12, day 1..days_in_month, 24h clock)
in_range = (dt: DateTime) bool {
    dt.month >= 1
        && dt.month <= 12
        && dt.day >= 1
        && dt.day <= days_in_month(dt.year, dt.month)
        && dt.hour >= 0
        && dt.hour <= 23
        && dt.min >= 0
        && dt.min <= 59
        && dt.sec >= 0
        && dt.sec <= 59
}
// Parse the ISO-8601 subset `YYYY-MM-DD` (date only, time = 00:00:00) or `YYYY-MM-DDThh:mm:ss`. Returns
// the filled DateTime (weekday computed) or a DateError pinpointing the first fault. Strict: exact
// width, exact separators, all-digit fields, and every field range-checked (so 2001-02-29 → OutOfRange).
parse_iso* = (s: string_view) Result<DateTime, DateError> {
    n := len(s)
    has_time := n == 19
    ((n == 10 || n == 19) == false).then({
        return err(.BadLength)
    })
    // date field digits: [0,4) year, [5,7) month, [8,10) day
    yb := first_nondigit(s, 0, 4)
    (yb == 0 == false).then({
        return err(.BadDigit(yb))
    })
    mb := first_nondigit(s, 5, 7)
    (mb == 0 == false).then({
        return err(.BadDigit(mb))
    })
    db := first_nondigit(s, 8, 10)
    (db == 0 == false).then({
        return err(.BadDigit(db))
    })
    // date separators
    (byte_at(s, 4) == '-' == false).then({
        return err(.BadSeparator(byte_at(s, 4)))
    })
    (byte_at(s, 7) == '-' == false).then({
        return err(.BadSeparator(byte_at(s, 7)))
    })
    year := num4(s, 0)
    month := num2(s, 5)
    day := num2(s, 8)
    // optional time part (default midnight for the date-only form)
    hour: i64 := 0
    min: i64 := 0
    sec: i64 := 0
    has_time.then({
        (byte_at(s, 10) == 'T' == false).then({
            return err(.BadSeparator(byte_at(s, 10)))
        })
        hb := first_nondigit(s, 11, 13)
        (hb == 0 == false).then({
            return err(.BadDigit(hb))
        })
        mnb := first_nondigit(s, 14, 16)
        (mnb == 0 == false).then({
            return err(.BadDigit(mnb))
        })
        sb := first_nondigit(s, 17, 19)
        (sb == 0 == false).then({
            return err(.BadDigit(sb))
        })
        (byte_at(s, 13) == ':' == false).then({
            return err(.BadSeparator(byte_at(s, 13)))
        })
        (byte_at(s, 16) == ':' == false).then({
            return err(.BadSeparator(byte_at(s, 16)))
        })
        hour = num2(s, 11)
        min = num2(s, 14)
        sec = num2(s, 17)
    })
    dt := DateTime(
        year: year,
        month: month,
        day: day,
        hour: hour,
        min: min,
        sec: sec,
        weekday: 0,
    )
    in_range(dt).match ({
        true  => ok(DateTime(
            year: year,
            month: month,
            day: day,
            hour: hour,
            min: min,
            sec: sec,
            weekday: weekday(dt),
        )),
        false => err(.OutOfRange),
    })
}
// ── ISO-8601 formatting ───────────────────────────────────────────────────────
// Write a fixed-width 2-digit decimal (00..99) at p+at; return the next offset.
fmt_w2 = (p: RawPtr<u8>, at: i64, n: i64) i64 {
    p.offset(at).store('0' + n / 10 % 10)
    p.offset(at + 1).store('0' + n % 10)
    at + 2
}
// Write a fixed-width 4-digit decimal (0000..9999) at p+at; return the next offset.
fmt_w4 = (p: RawPtr<u8>, at: i64, n: i64) i64 {
    p.offset(at).store('0' + n / 1000 % 10)
    p.offset(at + 1).store('0' + n / 100 % 10)
    p.offset(at + 2).store('0' + n / 10 % 10)
    p.offset(at + 3).store('0' + n % 10)
    at + 4
}
// Render `dt` as the 19-byte `YYYY-MM-DDThh:mm:ss` (ISO-8601, the exact input parse_iso accepts) into a
// fresh allocator-owned NUL-terminated str. A 4-digit year is assumed (0..9999); deliberately not a
// full strftime. Allocation failure is a value (Result), house style.
format_iso*<A> = (a: MutPtr<A>, dt: DateTime) Result<string_view, IoError> {
    a.try_acquire(20).match ({
        .Ok(p)  => {
            k := fmt_w4(p, 0, dt.year)
            p.offset(k).store('-')
            k = fmt_w2(p, k + 1, dt.month)
            p.offset(k).store('-')
            k = fmt_w2(p, k + 1, dt.day)
            p.offset(k).store('T')
            k = fmt_w2(p, k + 1, dt.hour)
            p.offset(k).store(':')
            k = fmt_w2(p, k + 1, dt.min)
            p.offset(k).store(':')
            k = fmt_w2(p, k + 1, dt.sec)
            p.offset(k).store(0)
            ok(cstr(p))
        },
        .Err(e) => err(e),
    })
}
