// src/ast/ast_id.zen
// How a node is named.
//
// The four node families are mutually recursive (expr holds types,
// type holds expr, pattern holds patterns), so children are held by id
// into the matching `Ast` arena, never by value. Ids not `Ptr<Expr>`:
// (1) `Node = { next: Node }` has no size — recursion needs indirection
// regardless; (2) sema is memoized queries (DESIGN.md decision 3), and
// a memo table's key must be `Eq + Hash` with real identity, which a
// tree of values or a raw pointer doesn't have.
//
// Four distinct types, not one `NodeId`: passing a TypeId where an
// ExprId belongs is the mistake parallel agents will make, made
// unrepresentable for free.
//
// An id is an INDEX in parser-creation order — a pure function of the
// source, keeping gen_c deterministic (nothing here is an address).
//
// The index is `u32`, forced not chosen: std.core.num's conversions are
// lossless-only, and `u32` is the widest int with both `to_usize` (index
// the arena) and `to_u64` (hash). A usize id could do neither.

Eq, Hash, Hasher = std.core.core

ExprId* = { index*: u32 }

TypeId* = { index*: u32 }

PatternId* = { index*: u32 }

BlockId* = { index*: u32 }

// Eq and Hash on all four so a memoized query can key on a node
// (declared here, not in std.core.eq, since an impl lives with its type).
// The hash is the index itself: ids are dense and small, already an
// ideal distribution, so mixing would be wasted work.
ExprId.impl(Eq, {
    eq ::= (self: @Self, other: @Self) bool { self.index == other.index }
})

ExprId.impl(Hash, {
    hash = (self: @Self, hasher :: Hasher) u64 { self.index.to_u64() }
})

TypeId.impl(Eq, {
    eq ::= (self: @Self, other: @Self) bool { self.index == other.index }
})

TypeId.impl(Hash, {
    hash = (self: @Self, hasher :: Hasher) u64 { self.index.to_u64() }
})

PatternId.impl(Eq, {
    eq ::= (self: @Self, other: @Self) bool { self.index == other.index }
})

PatternId.impl(Hash, {
    hash = (self: @Self, hasher :: Hasher) u64 { self.index.to_u64() }
})

BlockId.impl(Eq, {
    eq ::= (self: @Self, other: @Self) bool { self.index == other.index }
})

BlockId.impl(Hash, {
    hash = (self: @Self, hasher :: Hasher) u64 { self.index.to_u64() }
})
