// tools/gates/lex_tiling.zen
// THE TOKENS TILE THE FILE, and every position in them is independently right.
//
// A lexer's spans are the one thing nothing else checks. `make fmt` proves
// the formatter reprints a file, but the formatter reads the TEXT a span
// slices, so a span that is one byte wide in the wrong place reprints
// perfectly and points the editor's squiggle at the wrong character. Nothing
// in this tree looked at line:col at all.
//
// Four properties, over every .zen file the build already owns:
//
//   TILING     the tokens are in order and never overlap, and every byte
//              between two of them is whitespace — so the token stream plus
//              the gaps IS the file, byte for byte, and nothing was dropped
//   COVERAGE   the first token starts at offset 0 (or 3, past a stripped
//              byte-order mark) and the last is Eof ending at the last byte
//   POSITION   line and col are recomputed from the offset by a second walk
//              that shares no code with the cursor, and must agree. LF ends a
//              line, CR does not, and the column is a 1-based BYTE column
//   CLEAN      a file in this repository lexes without a fault
//
// It is a PROPERTY over real input rather than a fixture, so it grows with the
// tree: a file added tomorrow is checked tomorrow. Proved non-vacuous by
// mutation — make `bump` skip the newline count and the position check goes
// red on the first file with two lines in it.

Alloc, AllocError = std.mem
str = std.text
Range = std.core
FsError = std.env

scan, Source, Token, TokenKind, kind_name = std.lex.lex

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    (env.argv.len < 2).match({
        true  => no_files(),
        false => run(env, alloc),
    })
}

no_files = () Res<i32, AllocError> {
    println("lextiling: no files given — this gate is checking nothing.");
    Ok(2);
}

run = (env: Env, alloc: Alloc) Res<i32, AllocError> {
    bad  ::= 0;
    seen ::= 0;
    oom  ::= false;
    Range(1, env.argv.len).loop((h, i) {
        path = env.argv.get(i).match({ Ok(s) => s, None => "" });
        seen = seen + 1;
        one_file(env, alloc, path).match({
            Ok(n)  => { bad = bad + n; },
            Err(e) => { oom = true; },
        });
    });
    oom.then(() { println("lextiling: ran out of memory"); bad = bad + 1; });
    (bad > 0).match({
        true  => Ok(1),
        false => {
            println(
                "lextiling: {} file(s) tile, and every position agrees",
                seen
            );
            Ok(0);
        },
    })
}

one_file = (env: Env, alloc: Alloc, path: str) Res<usize, AllocError> {
    env.fs.read(alloc, path).match({
        Err(e)   => {
            println("lextiling: {} could not be read ({})", path, fs_word(e));
            Ok(1);
        },
        Ok(text) => check(alloc, path, text.view()),
    })
}

fs_word = (e: FsError) str {
    e.match({
        NotFound    => "not found",
        Denied      => "denied",
        IsDir       => "is a directory",
        Exists      => "already locked",
        Failed      => "could not be read",
        OutOfMemory => "out of memory",
    })
}

// A second walk over the same bytes, sharing no line with lex_cursor.zen. It
// is the whole point: a position checked against the machine that produced it
// checks nothing.
Walk = {
    text: str,
    off :: usize,
    line :: usize,
    col :: usize,

    // forward to `target`, counting as DESIGN.md says to count: LF ends a
    // line, CR does not, and a multi-byte character costs its bytes
    to* = (self :: @Self, target: usize) () {
        loop(
            () { self.off < target },
            (h) {
                (self.text[self.off] == '\n').match({
                    true  => { self.line = self.line + 1; self.col = 1; },
                    false => { self.col = self.col + 1; },
                });
                self.off = self.off + 1;
            },
        );
    }
}

check = (alloc: Alloc, path: str, text: str) Res<usize, AllocError> {
    out = scan(alloc, Source(file: path, text: text)).try();
    bad ::= 0;

    (out.diags.len > 0).then(() {
        bad = bad + 1;
        println(
            "lextiling: {} does not lex cleanly ({} fault(s))",
            path,
            out.diags.len
        );
    });

    w        ::= Walk(text: text, off: 0, line: 1, col: 1);
    prev_end ::= 0;
    first    ::= true;

    out.tokens.loop((h, t) {
        // TILING: in order, no overlap, and only whitespace in between
        (t.span.start.offset < prev_end).then(() {
            bad = bad + 1;
            println(
                "lextiling: {}: {} starts at {} but the token before it ended at {}",
                path,
                kind_name(t.kind),
                t.span.start.offset,
                prev_end
            );
        });
        gap_is_space(text, prev_end, t.span.start.offset, first).match({
            true  => (),
            false => {
                bad = bad + 1;
                println(
                    "lextiling: {}: bytes {}..{} are between two tokens and are not whitespace — the token stream does not reconstruct the file",
                    path,
                    prev_end,
                    t.span.start.offset
                );
            },
        });

        (t.span.end.offset < t.span.start.offset).then(() {
            bad = bad + 1;
            println(
                "lextiling: {}: {} ends before it starts",
                path,
                kind_name(t.kind)
            );
        });

        // POSITION: both ends, against the independent walk
        w.to(t.span.start.offset);
        agree(
            path,
            t,
            "start",
            w.line,
            w.col,
            t.span.start.line,
            t.span.start.col
        )
            .then(() { bad = bad + 1; });
        w.to(t.span.end.offset);
        agree(path, t, "end", w.line, w.col, t.span.end.line, t.span.end.col)
            .then(() { bad = bad + 1; });

        prev_end = t.span.end.offset;
        first    = false;
    });

    // COVERAGE: the file ends where the last token does
    (prev_end == text.len).match({
        true  => (),
        false => {
            bad = bad + 1;
            println(
                "lextiling: {}: the last token ends at {} and the file is {} bytes",
                path,
                prev_end,
                text.len
            );
        },
    });
    Ok(bad);
}

// true when they DISAGREE, so the caller reads as "one more fault"
agree = (
    path      : str,
    t         : Token,
    which     : str,
    want_line : usize,
    want_col  : usize,
    got_line  : usize,
    got_col   : usize
) bool {
    ((want_line == got_line) && (want_col == got_col)).match({
        true  => false,
        false => {
            println(
                "lextiling: {}: {} {} says {}:{} and the bytes say {}:{}",
                path,
                kind_name(t.kind),
                which,
                got_line,
                got_col,
                want_line,
                want_col
            );
            true;
        },
    });
}

// Whitespace is not a token, so the gap between two spans must hold nothing
// else. The one exception is the head of the file: a byte-order mark is
// stripped at offset 0 and belongs to no token by design.
gap_is_space = (text: str, from: usize, to: usize, first: bool) bool {
    start = (first && (to >= 3)).match({ true => 3, false => from });
    Range(start, to).loop(true, (h, i, at, ok: bool) {
        ok && text[at].is_space()
    }).match({
        Ok(v) => v,
        None  => true,
    });
}
