// tests/harness_lsp.zen — LSP category: conformance tests for `zen lsp` (the diagnostics language
// server in driver.zen). Each case is one SCRIPTED STDIO SESSION: the framed JSON-RPC bytes are built
// here (Content-Length is computed from the exact body length, CRLF framing), piped through
// `timeout 20 ./zen lsp`, and the captured stdout + exit code are asserted with plain substring
// checks against the protocol shapes the server must produce. What this locks:
//
//   (1) initialize handshake — capabilities.textDocumentSync=1, the echoed id, framed output
//   (2) didOpen of a broken document — publishDiagnostics with the expected kind at the expected
//       0-based UTF-16 position (zenc spans are 1-based BYTE columns; the server must convert both)
//   (3) didChange (full sync) fixing the error — a publish with an EMPTY diagnostics array
//   (4) an unknown REQUEST (textDocument/hover) — a -32601 MethodNotFound reply with the echoed id,
//       id, and the server keeps serving (shutdown still answered, clean exit)
//   (5) garbage / absurdly oversized Content-Length — no hang (timeout-guarded), no crash: garbage
//       resynchronizes on the next frame; over-limit is skipped instead of null-deref-panicking
//   (6) didClose — a publish clearing the document's diagnostics
//   (7) non-ASCII source — LSP `character` counts UTF-16 code units, not bytes
//   (8) a document importing a $ZT sibling — diagnostics located in the OPEN file keep exact ranges;
//       an error living INSIDE the imported module is pinned to 0:0 with the real location named in
//       the message (never a lying range into the open document)
//   (9) exit without shutdown — exit code 1 per the LSP convention
//  (10) UNSAVED EDITS: semantic tokens for an OPEN document come from the client's buffer, never
//       from the file on disk (the disk copy is deliberately made to disagree), and a version bump
//       re-derives them instead of serving the version-keyed cache
//  (11) after didClose the document is no longer open, so disk is the source of truth again
//  (13) hover and completion answered from the UNSAVED buffer: the declaration under the cursor
//       (signature + doc comment) and the name list, both describing text that is not on disk
//  (12) a `"""` raw literal holding `"` then `//` — the token stream stays position-SORTED and the
//       array stays `]`-terminated (an out-of-order token encodes a negative delta and kills the
//       client's highlighting for the whole buffer)
//  (13) TYPING AN IMPORT: every prefix of `std.text.str` is an unknown module, and each one must get
//       its own diagnostic while the server keeps answering requests — resolution reports and returns
//       instead of killing the process
{ Malloc } = std.mem.alloc
{ save, contents_in, shell } = std.io.file
{ len, contains } = std.text.str
{ expect } = std.core.result
{ zo_cmd, zo_dir, zo_idpath, zo_join, zo_itoa, run_suite } = harness_lib
// ── session plumbing ──────────────────────────────────────────────────────────────────────────────
// one framed JSON-RPC message: `Content-Length: <bytes>\r\n\r\n<body>`.
lz_frame = (mp: MutPtr<Malloc>, body: string_view) string_view {
    z: string_view := ""    // str-typed lead so the mixed literal/variable array infers as [str]
    mp.zo_join([z, "Content-Length: ", mp.zo_itoa(len(body)), "\r\n\r\n", body])
}
// pipe `session` through the server (timeout-guarded so a hang can never wedge the harness); the
// server's stdout is returned and its exit code lands in the per-case .rc file.
lz_run = (mp: MutPtr<Malloc>, gid: i64, session: string_view) string_view {
    inp := mp.zo_idpath("lzs", gid, ".in")
    outp := mp.zo_idpath("lzs", gid, ".out")
    rcp := mp.zo_idpath("lzs", gid, ".rc")
    save(inp, session, len(session))
    z: string_view := ""
    shell(mp.zo_cmd(mp.zo_join([z, "timeout 20 ./zen lsp < ", inp, " > ", outp, " 2>/dev/null; printf %s $? > ", rcp]))).expect("harness: shell")
    mp.contents_in(outp).match ({
        .Ok(s)  => s,
        .Err(e) => "",
    })
}
lz_rc = (mp: MutPtr<Malloc>, gid: i64) string_view {
    mp.contents_in(mp.zo_idpath("lzs", gid, ".rc")).match ({
        .Ok(s)  => s,
        .Err(e) => "",
    })
}
// canonical messages (ids: initialize=1, shutdown=2, probes pick their own).
LZ_INIT = () string_view {
    "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}"
}
LZ_SHUT = () string_view { "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"shutdown\"}" }
LZ_EXIT = () string_view { "{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}" }
// a `file://` URI for a (virtual) document inside this run's private scratch dir — its dirname is
// where the server resolves sibling imports, so on-disk $ZT siblings are import targets.
lz_uri = (mp: MutPtr<Malloc>, name: string_view) string_view {
    z: string_view := ""
    mp.zo_join([z, "file://", mp.zo_dir(), "/", name])
}
lz_open = (mp: MutPtr<Malloc>, uri: string_view, text: string_view) string_view {
    z: string_view := ""
    mp.zo_join([z, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"", uri, "\",\"languageId\":\"zen\",\"version\":1,\"text\":\"", text, "\"}}}"])
}
lz_change_v = (mp: MutPtr<Malloc>, uri: string_view, text: string_view, ver: i64) string_view {
    z: string_view := ""
    mp.zo_join([z, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"", uri, "\",\"version\":", mp.zo_itoa(ver), "},\"contentChanges\":[{\"text\":\"", text, "\"}]}}"])
}
lz_change = (mp: MutPtr<Malloc>, uri: string_view, text: string_view) string_view {
    mp.lz_change_v(uri, text, 2)
}
// a request carrying a cursor POSITION — hover, definition and completion share this shape.
lz_posreq = (
    mp: MutPtr<Malloc>,
    uri: string_view,
    method: string_view,
    id: i64,
    line: i64,
    ch: i64,
) string_view {
    z: string_view := ""
    mp.zo_join([z, "{\"jsonrpc\":\"2.0\",\"id\":", mp.zo_itoa(id), ",\"method\":\"textDocument/", method, "\",\"params\":{\"textDocument\":{\"uri\":\"", uri, "\"},\"position\":{\"line\":", mp.zo_itoa(line), ",\"character\":", mp.zo_itoa(ch), "}}}"])
}
// a `textDocument/semanticTokens/full` request for `uri` with request id `id`.
lz_tokreq = (mp: MutPtr<Malloc>, uri: string_view, id: i64) string_view {
    z: string_view := ""
    mp.zo_join([z, "{\"jsonrpc\":\"2.0\",\"id\":", mp.zo_itoa(id), ",\"method\":\"textDocument/semanticTokens/full\",\"params\":{\"textDocument\":{\"uri\":\"", uri, "\"}}}"])
}
lz_close = (mp: MutPtr<Malloc>, uri: string_view) string_view {
    z: string_view := ""
    mp.zo_join([z, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\",\"params\":{\"textDocument\":{\"uri\":\"", uri, "\"}}}"])
}
// document texts as they sit INSIDE the JSON body (\n are JSON escapes the server decodes).
LZ_BAD = () string_view { "main = () i32 {\\n    x := undefined_name\\n    0\\n}\\n" }
LZ_GOOD = () string_view { "main = () i32 {\\n    7\\n}\\n" }
// ── the cases ─────────────────────────────────────────────────────────────────────────────────────
// (1) initialize: framed reply, echoed id, full-sync capability advertised, clean shutdown/exit.
lz_init_ok = (mp: MutPtr<Malloc>) bool {
    o := mp.lz_run(0, mp.zo_join([mp.lz_frame(LZ_INIT()), mp.lz_frame(LZ_SHUT()), mp.lz_frame(LZ_EXIT())]))
    o.contains("Content-Length: ")
        && o.contains("\"id\":1")
        && o.contains("\"textDocumentSync\":1")
        && o.contains("\"result\":null")
        && mp.lz_rc(0) == "0"
}
// (2) didOpen broken doc: undefined-name at 0-based line 1, character 9 (the byte→LSP conversion).
lz_open_bad = (mp: MutPtr<Malloc>) bool {
    u := mp.lz_uri("lzdoc.zen")
    o := mp.lz_run(1, mp.zo_join([mp.lz_frame(LZ_INIT()), mp.lz_frame(mp.lz_open(u, LZ_BAD())), mp.lz_frame(LZ_SHUT()), mp.lz_frame(LZ_EXIT())]))
    o.contains("textDocument/publishDiagnostics")
        && o.contains("\"code\":\"undefined-name\"")
        && o.contains("\"start\":{\"line\":1,\"character\":9}")
        && o.contains("\"diagnostics\":[]") == false
        && mp.lz_rc(1) == "0"
}
// (3) didChange fixes the error: the second publish must carry an EMPTY diagnostics array.
lz_change_clears = (mp: MutPtr<Malloc>) bool {
    u := mp.lz_uri("lzdoc.zen")
    o := mp.lz_run(2, mp.zo_join([mp.lz_frame(LZ_INIT()), mp.lz_frame(mp.lz_open(u, LZ_BAD())), mp.lz_frame(mp.lz_change(u, LZ_GOOD())), mp.lz_frame(LZ_SHUT()), mp.lz_frame(LZ_EXIT())]))
    o.contains("\"code\":\"undefined-name\"")
        && o.contains("\"diagnostics\":[]")
        && mp.lz_rc(2) == "0"
}
// (4) unknown REQUEST: -32601 with the echoed id; the server keeps serving afterwards.
lz_unknown_method = (mp: MutPtr<Malloc>) bool {
    probe := "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"textDocument/references\",\"params\":{\"position\":{\"line\":0,\"character\":0}}}"
    o := mp.lz_run(3, mp.zo_join([mp.lz_frame(LZ_INIT()), mp.lz_frame(probe), mp.lz_frame(LZ_SHUT()), mp.lz_frame(LZ_EXIT())]))
    o.contains("\"id\":7")
        && o.contains("-32601")
        && o.contains("\"result\":null")
        && mp.lz_rc(3) == "0"
}
// (5a) garbage Content-Length: the frame is skipped and the scan RESYNCHRONIZES on the next real
// frame — shutdown is still answered and the session still exits 0. `timeout` guards against a hang.
lz_garbage_cl = (mp: MutPtr<Malloc>) bool {
    z: string_view := ""
    o := mp.lz_run(4, mp.zo_join([z, "Content-Length: banana\r\n\r\n{}", mp.lz_frame(LZ_SHUT()), mp.lz_frame(LZ_EXIT())]))
    o.contains("\"result\":null") && mp.lz_rc(4) == "0"
}
// (5b) absurd Content-Length (100 TB): must NOT null-deref-panic (pre-fix: exit 134) and must NOT
// hang (timeout would exit 124) — the over-limit frame is skipped and EOF ends the session (code 1).
lz_huge_cl = (mp: MutPtr<Malloc>) bool {
    mp.lz_run(5, "Content-Length: 100000000000000\r\n\r\nx")
    mp.lz_rc(5) == "1"
}
// (6) didClose: stale squiggles are cleared with an explicit empty publish.
lz_didclose_clears = (mp: MutPtr<Malloc>) bool {
    u := mp.lz_uri("lzdoc.zen")
    o := mp.lz_run(6, mp.zo_join([mp.lz_frame(LZ_INIT()), mp.lz_frame(mp.lz_open(u, LZ_BAD())), mp.lz_frame(mp.lz_close(u)), mp.lz_frame(LZ_SHUT()), mp.lz_frame(LZ_EXIT())]))
    o.contains("\"code\":\"undefined-name\"")
        && o.contains("\"diagnostics\":[]")
        && mp.lz_rc(6) == "0"
}
// (7) UTF-16 positions: three é (2 UTF-8 bytes / 1 UTF-16 unit each) sit before the error, so the
// byte column is 21 but the LSP character MUST be 18. The é are written as JSON é escapes the
// server decodes into UTF-8 — this file stays pure ASCII.
lz_utf16_cols = (mp: MutPtr<Malloc>) bool {
    txt := "main = () i32 {\\n    x := \\\"\\u00e9\\u00e9\\u00e9\\\" == undefined_name\\n    0\\n}\\n"
    o := mp.lz_run(7, mp.zo_join([mp.lz_frame(LZ_INIT()), mp.lz_frame(mp.lz_open(mp.lz_uri("lzu.zen"), txt)), mp.lz_frame(LZ_SHUT()), mp.lz_frame(LZ_EXIT())]))
    o.contains("\"code\":\"undefined-name\"")
        && o.contains("\"start\":{\"line\":1,\"character\":18}")
}
// (8a) sibling import: the open document pulls a real $ZT module; an error in the OPEN file (wrong
// arity at the callsite) keeps its exact range there.
lz_multifile_sibling = (mp: MutPtr<Malloc>) bool {
    lib := "helper* = (x: i32) i32 { x }\n"
    save(mp.zo_join([mp.zo_dir(), "/lzlib.zen"]), lib, len(lib))
    txt := "{ helper } = lzlib\\nmain = () i32 {\\n    helper(1, 2)\\n}\\n"
    o := mp.lz_run(8, mp.zo_join([mp.lz_frame(LZ_INIT()), mp.lz_frame(mp.lz_open(mp.lz_uri("lzmain.zen"), txt)), mp.lz_frame(LZ_SHUT()), mp.lz_frame(LZ_EXIT())]))
    o.contains("\"code\":\"arity\"") && o.contains("\"start\":{\"line\":2,\"character\":4}")
}
// (8b) an error INSIDE the imported sibling: pinned to the file head with the real location in the
// message — never a lying range into the open document.
lz_foreign_module_error = (mp: MutPtr<Malloc>) bool {
    lib := "broken* = () i32 { undefined_in_lib }\n"
    save(mp.zo_join([mp.zo_dir(), "/lzbadlib.zen"]), lib, len(lib))
    txt := "{ broken } = lzbadlib\\nmain = () i32 {\\n    broken()\\n}\\n"
    o := mp.lz_run(9, mp.zo_join([mp.lz_frame(LZ_INIT()), mp.lz_frame(mp.lz_open(mp.lz_uri("lzmain2.zen"), txt)), mp.lz_frame(LZ_SHUT()), mp.lz_frame(LZ_EXIT())]))
    o.contains("in imported module")
        && o.contains("lzbadlib.zen")
        && o.contains("\"start\":{\"line\":0,\"character\":0}")
}
// (9) exit WITHOUT shutdown: the LSP convention demands a nonzero exit (the harness pins 1).
lz_exit_no_shutdown = (mp: MutPtr<Malloc>) bool {
    mp.lz_run(10, mp.zo_join([mp.lz_frame(LZ_INIT()), mp.lz_frame(LZ_EXIT())]))
    mp.lz_rc(10) == "1"
}
// (14) THE OPEN-BUFFER CONTRACT. `lztok2.zen` on disk starts with a COMMENT (first token `0,0,4,7,0`)
// while the client's buffer starts with a TYPE (`0,0,5,2,0`), and the buffer is NEVER written to disk.
// A server that reads disk answers with the comment token — that is the bug this locks out. The
// second didChange bumps the version to 3 and swaps in a 3-letter type (`0,0,3,2,0`): serving that
// proves the version-keyed token cache re-derives on a new version instead of replaying the old array.
lz_unsaved_buffer_tokens = (mp: MutPtr<Malloc>) bool {
    z: string_view := ""
    disk := "// c\nmain = () i32 { 0 }\n"
    save(mp.zo_join([mp.zo_dir(), z, "/lztok2.zen"]), disk, len(disk))
    uri := mp.lz_uri("lztok2.zen")
    bufa := "// c\\nmain = () i32 { 0 }\\n"    // the didOpen text: identical to the saved file
    bufb := "Point*: { x: i32 }\\nmain = () i32 { 42 }\\n"
    bufc := "Zed*: { y: i32 }\\nmain = () i32 { 1 }\\n"
    o := mp.lz_run(13, mp.zo_join([z, mp.lz_frame(LZ_INIT()), mp.lz_frame(mp.lz_open(uri, bufa)), mp.lz_frame(mp.lz_change_v(uri, bufb, 2)), mp.lz_frame(mp.lz_tokreq(uri, 3)), mp.lz_frame(mp.lz_change_v(uri, bufc, 3)), mp.lz_frame(mp.lz_tokreq(uri, 4)), mp.lz_frame(LZ_SHUT()), mp.lz_frame(LZ_EXIT())]))
    o.contains("\"result\":{\"data\":[0,0,5,2,0")
        && o.contains("\"result\":{\"data\":[0,0,3,2,0")
        && o.contains("\"result\":{\"data\":[0,0,4,7,0") == false
        && mp.lz_rc(13) == "0"
}
// (15) the other half of the lifecycle: didClose DROPS the entry, so the next request falls back to
// disk — the same file whose comment-first token the open-buffer case above must never see.
lz_close_reverts_to_disk = (mp: MutPtr<Malloc>) bool {
    z: string_view := ""
    disk := "// c\nmain = () i32 { 0 }\n"
    save(mp.zo_join([mp.zo_dir(), z, "/lztok3.zen"]), disk, len(disk))
    uri := mp.lz_uri("lztok3.zen")
    bufb := "Point*: { x: i32 }\\nmain = () i32 { 42 }\\n"
    o := mp.lz_run(14, mp.zo_join([z, mp.lz_frame(LZ_INIT()), mp.lz_frame(mp.lz_open(uri, bufb)), mp.lz_frame(mp.lz_close(uri)), mp.lz_frame(mp.lz_tokreq(uri, 3)), mp.lz_frame(LZ_SHUT()), mp.lz_frame(LZ_EXIT())]))
    o.contains("\"result\":{\"data\":[0,0,4,7,0")
        && o.contains("\"result\":{\"data\":[0,0,5,2,0") == false
        && mp.lz_rc(14) == "0"
}
// ── entry ─────────────────────────────────────────────────────────────────────────────────────────
// (12) go-to-definition: cursor on the `foo` call resolves to the top-level `foo*` decl at line 0.
lz_goto_def = (mp: MutPtr<Malloc>) bool {
    z: string_view := ""
    src := "foo* = (x: i32) i32 { x }\nmain = () i32 {\n    foo(0)\n}\n"
    save(mp.zo_join([mp.zo_dir(), z, "/lzdef.zen"]), src, len(src))
    uri := mp.lz_uri("lzdef.zen")
    req := mp.lz_posreq(uri, "definition", 2, 2, 4)
    o := mp.lz_run(11, mp.zo_join([z, mp.lz_frame(LZ_INIT()), mp.lz_frame(req), mp.lz_frame(LZ_SHUT()), mp.lz_frame(LZ_EXIT())]))
    o.contains("\"definitionProvider\":true")
        && o.contains("\"result\":{\"uri\":")
        && o.contains("\"line\":0,\"character\":0")
        && mp.lz_rc(11) == "0"
}
// (13) semantic tokens: the delta-encoded array classifies the file's tokens. `Point` is a type
// (uppercase), `main` is a function (a top-level `name = (` head), `42` is a number, and the leading
// comment is a comment — the four classification rules that carry the highlighting.
lz_semantic_tokens = (mp: MutPtr<Malloc>) bool {
    z: string_view := ""
    src := "// c\nPoint*: { x: i32 }\nmain = () i32 { 42 }\n"
    save(mp.zo_join([mp.zo_dir(), z, "/lztok.zen"]), src, len(src))
    uri := mp.lz_uri("lztok.zen")
    req := mp.zo_join([z, "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/semanticTokens/full\",\"params\":{\"textDocument\":{\"uri\":\"", uri, "\"}}}"])
    o := mp.lz_run(12, mp.zo_join([z, mp.lz_frame(LZ_INIT()), mp.lz_frame(req), mp.lz_frame(LZ_SHUT()), mp.lz_frame(LZ_EXIT())]))
    o.contains("\"semanticTokensProvider\"")
        && o.contains("\"result\":{\"data\":[")
        && o.contains("0,0,4,7,0")
        && o.contains("1,0,5,2,0")
        && o.contains("1,0,4,1,0")
        && mp.lz_rc(12) == "0"
}
// (16) THE ORDERING INVARIANT. A `"""` raw literal whose CONTENT holds an odd number of `"` before
// a `//`: quote-parity string tracking calls that `//` a comment, which lands INSIDE the string token
// the lexer reports. Emitted, it encodes a negative delta and the client discards the whole buffer's
// highlighting (nvim: "INVALID_SERVER_JSON") — the array was truncated mid-number. The `//` bytes are
// string content, so the reply must be one unbroken string token across both lines, `]`-terminated.
lz_rawstring_token_order = (mp: MutPtr<Malloc>) bool {
    z: string_view := ""
    src := "g = () void {\n    s := \"\"\"abc \"d // e\n    \"\"\"\n    y := 1\n}\n"
    save(mp.zo_join([mp.zo_dir(), z, "/lzraw.zen"]), src, len(src))
    o := mp.lz_run(15, mp.zo_join([z, mp.lz_frame(LZ_INIT()), mp.lz_frame(mp.lz_tokreq(mp.lz_uri("lzraw.zen"), 2)), mp.lz_frame(LZ_SHUT()), mp.lz_frame(LZ_EXIT())]))
    o.contains("\"result\":{\"data\":[0,0,1,1,0,")
        && o.contains("0,3,14,5,0,1,0,7,5,0,1,4,1,3,0,0,2,2,8,0,0,3,1,6,0,1,0,1,8,0]")
        && mp.lz_rc(15) == "0"
}
// (17) HOVER, and the open-buffer contract for it. `lzhov.zen` on disk declares `alpha` under a disk
// doc comment; the client then changes its buffer to declare `beta` under a different one, and that
// buffer is NEVER saved. Hovering the `beta` call must answer with the BUFFER's declaration, doc
// comment included — a server reading disk answers about `alpha`, or finds nothing at all. The
// second probe (id 6) sits on indentation, where there is no identifier: the protocol's "no hover
// here" is a null result, not an empty popup.
lz_hover_buffer = (mp: MutPtr<Malloc>) bool {
    z: string_view := ""
    disk := "// disk doc\nalpha* = (x: i32) i32 { x }\n"
    save(mp.zo_join([mp.zo_dir(), z, "/lzhov.zen"]), disk, len(disk))
    uri := mp.lz_uri("lzhov.zen")
    buf := "// buffer doc\\nbeta* = (s: i32) i32 {\\n    s\\n}\\nmain = () i32 {\\n    beta(1)\\n}\\n"
    o := mp.lz_run(16, mp.zo_join([z, mp.lz_frame(LZ_INIT()), mp.lz_frame(mp.lz_open(uri, "main = () i32 { 0 }\\n")), mp.lz_frame(mp.lz_change_v(uri, buf, 2)), mp.lz_frame(mp.lz_posreq(uri, "hover", 5, 5, 4)), mp.lz_frame(mp.lz_posreq(uri, "hover", 6, 5, 1)), mp.lz_frame(LZ_SHUT()), mp.lz_frame(LZ_EXIT())]))
    o.contains("\"hoverProvider\":true")
        && o.contains("\"kind\":\"markdown\"")
        && o.contains("beta* = (s: i32) i32")
        && o.contains("buffer doc")
        && o.contains("disk doc") == false
        && o.contains("\"id\":6,\"result\":null")
        && mp.lz_rc(16) == "0"
}
// (18) COMPLETION over an UNSAVED buffer: the buffer's own top-level declarations (signature as
// detail), the names its import record binds (origin module as detail), and the keyword list. The
// disk copy declares `gamma`, which the reply must not contain — the same stale-disk class again,
// this time on the name list.
lz_completion_items = (mp: MutPtr<Malloc>) bool {
    z: string_view := ""
    disk := "gamma* = () i32 { 0 }\n"
    save(mp.zo_join([mp.zo_dir(), z, "/lzcomp.zen"]), disk, len(disk))
    uri := mp.lz_uri("lzcomp.zen")
    buf := "{ view } = std.text.str\\nWidget*: { w: i32 }\\nmain = () i32 { 0 }\\n"
    o := mp.lz_run(17, mp.zo_join([z, mp.lz_frame(LZ_INIT()), mp.lz_frame(mp.lz_open(uri, buf)), mp.lz_frame(mp.lz_posreq(uri, "completion", 2, 2, 0)), mp.lz_frame(LZ_SHUT()), mp.lz_frame(LZ_EXIT())]))
    o.contains("\"completionProvider\":{\"resolveProvider\":false}")
        && o.contains("{\"label\":\"view\",\"kind\":3,\"detail\":\"std.text.str\"}")
        && o.contains("{\"label\":\"Widget\",\"kind\":22,\"detail\":\"Widget*: { w: i32 }\"}")
        && o.contains("{\"label\":\"main\",\"kind\":3,\"detail\":\"main = () i32 { 0 }\"}")
        && o.contains("\"label\":\"match\",\"kind\":14")
        && o.contains("gamma") == false
        && mp.lz_rc(17) == "0"
}
// (19) KEYSTROKE SURVIVAL. Typing an import line is a run of UNKNOWN MODULES: `std.te` is not a
// module, and neither is any other proper prefix of `std.text.str`. Module resolution used to
// `exit(1)` from inside the library on the first one, so the server DIED mid-session — the keystroke
// got no diagnostic and a request already in flight was never answered (the reported "highlighting
// just stops"). Every keystroke must now get its own diagnostic, a request issued MID-typing must
// still come back, and the session must reach a clean shutdown with the squiggles cleared once the
// import finally names a real module.
LZ_TYPED = () [string_view] {
    ["s", "st", "std", "std.", "std.t", "std.te", "std.tex", "std.text", "std.text.", "std.text.s", "std.text.st"]
}
lz_import_keystrokes = (mp: MutPtr<Malloc>) bool {
    z: string_view := ""
    uri := mp.lz_uri("lzkeys.zen")
    tail := "\\nmain = () i32 { 0 }\\n"
    sess := mp.zo_join([z, mp.lz_frame(LZ_INIT()), mp.lz_frame(mp.lz_open(uri, LZ_BAD()))])
    ver := 2
    LZ_TYPED().loop((h, i, p) {
        sess = mp.zo_join([z, sess, mp.lz_frame(mp.lz_change_v(uri, mp.zo_join([z, "{ len } = ", p, tail]), ver))])
        // mid-typing, on a buffer that names no real module: the old server was already dead here
        (p == "std.te").then({
            sess = mp.zo_join([z, sess, mp.lz_frame(mp.lz_tokreq(uri, 76))])
        })
        ver = ver + 1
    })
    o := mp.lz_run(18, mp.zo_join([z, sess, mp.lz_frame(mp.lz_change_v(uri, mp.zo_join([z, "{ len } = std.text.str", tail]), ver)), mp.lz_frame(mp.lz_tokreq(uri, 77)), mp.lz_frame(LZ_SHUT()), mp.lz_frame(LZ_EXIT())]))
    o.contains("\"code\":\"unresolved-import\"")
        && o.contains("unknown module 's'")
        && o.contains("unknown module 'std.te'")
        && o.contains("unknown module 'std.text.st'")
        && o.contains("\"id\":76")
        && o.contains("\"id\":77")
        && o.contains("\"diagnostics\":[]")
        && mp.lz_rc(18) == "0"
}
// ── EDITOR-MOTION SUITE ───────────────────────────────────────────────────────────────────────────
// The cases above lock the PROTOCOL. These lock the SURFACE an editor actually drives: one case per
// keystroke a Neovim user presses, asserted against one shared fixture whose every symbol kind is
// deliberately represented. Where a motion is NOT implemented the case asserts TODAY's answer and
// says so — the gap is then visible in the suite, cannot silently regress, and turns the case red the
// day someone closes it (at which point the assertion, not the feature, is what changes).
//
// THE FIXTURE (`lzmot.zen`, 0-based lines — every probe below cites one):
//    0  { lzfix_fn } = lzfix          sibling-module import record
//    1  { len } = std.text.str        std import record
//    2  ms = std.text.str             module ALIAS (the qualified `mod.name` form)
//    3  Shape*: { w: i32,             a type, and a struct FIELD
//    4      area = (s: Shape) i32 …   an INHERENT METHOD — declared INSIDE the type body
//    5  }
//    6  top* = (n: i32) i32 { n }     a same-file top-level fn
//    7  main = () i32 {
//    8      s := Shape(w: 1)
//    9      q := s.area()
//   10      r := top(q)
//   11      u := lzfix_fn(r)
//   12      v := len("x")
//   13      y := ms.len("x")
//   14      u + (v + y).to_i32()
//   15  }
LZ_MOTION_DOC = () string_view {
    "{ lzfix_fn } = lzfix\\n{ len } = std.text.str\\nms = std.text.str\\nShape*: { w: i32,\\n    area = (s: Shape) i32 { s.w }\\n}\\ntop* = (n: i32) i32 { n }\\nmain = () i32 {\\n    s := Shape(w: 1)\\n    q := s.area()\\n    r := top(q)\\n    u := lzfix_fn(r)\\n    v := len(\\\"x\\\")\\n    y := ms.len(\\\"x\\\")\\n    u + (v + y).to_i32()\\n}\\n"
}
// one `gd` against the fixture: write the sibling module, didOpen the buffer (UNSAVED — the fixture is
// never written to disk, so every answer below is also proof the buffer is what was consulted), ask
// `textDocument/definition` at (line, ch) as request id 3, return the server's stdout.
lz_def_probe = (mp: MutPtr<Malloc>, gid: i64, line: i64, ch: i64) string_view {
    z: string_view := ""
    lib := "lzfix_fn* = (x: i32) i32 { x }\n"
    save(mp.zo_join([mp.zo_dir(), z, "/lzfix.zen"]), lib, len(lib))
    uri := mp.lz_uri("lzmot.zen")
    mp.lz_run(gid, mp.zo_join([z, mp.lz_frame(LZ_INIT()), mp.lz_frame(mp.lz_open(uri, LZ_MOTION_DOC())), mp.lz_frame(mp.lz_posreq(uri, "definition", 3, line, ch)), mp.lz_frame(LZ_SHUT()), mp.lz_frame(LZ_EXIT())]))
}
// the definition reply resolved INTO `file` at 0-based `line`,`col` — matched as ONE contiguous
// substring so a request id can never be paired with a different probe's range.
lz_def_is = (mp: MutPtr<Malloc>, o: string_view, file: string_view, line: i64, col: i64) bool {
    z: string_view := ""
    o.contains("\"id\":3,\"result\":{\"uri\":")
        && o.contains(mp.zo_join([z, file, "\",\"range\":{\"start\":{\"line\":", mp.zo_itoa(line), ",\"character\":", mp.zo_itoa(col), "}"]))
}
lz_def_none = (o: string_view) bool { o.contains("\"id\":3,\"result\":null") }
// gd (a) SAME-FILE FN: `top(q)` on line 10 -> the `top*` head at line 6 column 0. WORKS.
lz_gd_same_file_fn = (mp: MutPtr<Malloc>) bool {
    mp.lz_def_is(mp.lz_def_probe(20, 10, 9), "lzmot.zen", 6, 0) && mp.lz_rc(20) == "0"
}
// gd (b) SAME-FILE TYPE: `Shape(w: 1)` on line 8 -> the `Shape*:` head at line 3 column 0. WORKS.
lz_gd_same_file_type = (mp: MutPtr<Malloc>) bool {
    mp.lz_def_is(mp.lz_def_probe(21, 8, 9), "lzmot.zen", 3, 0) && mp.lz_rc(21) == "0"
}
// gd (c) INHERENT METHOD: `s.area()` on line 9. NOT IMPLEMENTED — `area` is declared at column 4
// INSIDE the type body and the resolver is a column-0 textual scan, so it is invisible. Same walker
// gap `zen doc` has; reading the parser's hoisted impl methods would close both at once.
lz_gd_inherent_method = (mp: MutPtr<Malloc>) bool {
    lz_def_none(mp.lz_def_probe(22, 9, 11)) && mp.lz_rc(22) == "0"
}
// gd (d) STRUCT FIELD: `w` in `Shape(w: 1)` on line 8. NOT IMPLEMENTED — a field is not a column-0 head.
lz_gd_struct_field = (mp: MutPtr<Malloc>) bool {
    lz_def_none(mp.lz_def_probe(23, 8, 15)) && mp.lz_rc(23) == "0"
}
// gd (e) CROSS-MODULE FN: `lzfix_fn(r)` on line 11, declared in the sibling module `lzfix`. NOT
// IMPLEMENTED — and this is THE reported bug. Every Zen file opens with import records, so the great
// majority of names under a cursor are imported and `gd` answers null for nearly all of them.
lz_gd_cross_module = (mp: MutPtr<Malloc>) bool {
    lz_def_none(mp.lz_def_probe(24, 11, 9)) && mp.lz_rc(24) == "0"
}
// gd (f) IMPORTED STD NAME: `len("x")` on line 12, bound by `{ len } = std.text.str`. NOT IMPLEMENTED.
lz_gd_imported_std = (mp: MutPtr<Malloc>) bool {
    lz_def_none(mp.lz_def_probe(25, 12, 9)) && mp.lz_rc(25) == "0"
}
// gd (g) QUALIFIED `mod.name`: `ms.len("x")` on line 13. NOT IMPLEMENTED — and the qualifier is not
// even consulted: the scan takes the identifier under the cursor (`len`) and never sees `ms`, so a
// qualified name and a bare one are literally the same query today.
lz_gd_qualified = (mp: MutPtr<Malloc>) bool {
    lz_def_none(mp.lz_def_probe(26, 13, 12)) && mp.lz_rc(26) == "0"
}
// K (hover) over the same fixture: hovering the `top` call reports its declaration. Hover shares the
// definition scanner, so it covers the same same-file-only set and no more.
lz_hover_motion = (mp: MutPtr<Malloc>) bool {
    z: string_view := ""
    uri := mp.lz_uri("lzmot.zen")
    o := mp.lz_run(27, mp.zo_join([z, mp.lz_frame(LZ_INIT()), mp.lz_frame(mp.lz_open(uri, LZ_MOTION_DOC())), mp.lz_frame(mp.lz_posreq(uri, "hover", 3, 10, 9)), mp.lz_frame(LZ_SHUT()), mp.lz_frame(LZ_EXIT())]))
    o.contains("top* = (n: i32) i32") && mp.lz_rc(27) == "0"
}
// THE UNIMPLEMENTED REQUESTS, pinned. Each is a standard Neovim motion; each answers -32601
// MethodNotFound today, and neither the method nor its capability exists:
//   gD          textDocument/declaration     (in Zen a decl IS the definition — one handler could serve both)
//   gi          textDocument/implementation  (should list the `Type.impl(Trait, …)` sites of a trait)
//   gr          textDocument/references
//   gO          textDocument/documentSymbol  — also the Zen-native replacement for the `]f [f ]c [c`
//               motions, which are tree-sitter textobjects and have had no grammar to bind to since
//               the Python purge deleted it. Nothing binds them today.
//   <leader>rn  textDocument/rename
//               textDocument/typeDefinition, textDocument/signatureHelp
// Each probe carries its own request id, so one method becoming real reddens exactly one line here.
LZ_UNIMPL = () [string_view] {
    ["declaration", "implementation", "references", "documentSymbol", "rename", "typeDefinition", "signatureHelp"]
}
lz_unimplemented_motions = (mp: MutPtr<Malloc>) bool {
    z: string_view := ""
    uri := mp.lz_uri("lzmot.zen")
    sess := mp.zo_join([z, mp.lz_frame(LZ_INIT()), mp.lz_frame(mp.lz_open(uri, LZ_MOTION_DOC()))])
    id := 30
    LZ_UNIMPL().loop((h, i, m) {
        sess = mp.zo_join([z, sess, mp.lz_frame(mp.lz_posreq(uri, m, id, 10, 9))])
        id = id + 1
    })
    o := mp.lz_run(28, mp.zo_join([z, sess, mp.lz_frame(LZ_SHUT()), mp.lz_frame(LZ_EXIT())]))
    all := true
    n := 30
    LZ_UNIMPL().loop((h, i, m) {
        all = all
            && o.contains(mp.zo_join([z, "\"id\":", mp.zo_itoa(n), ",\"error\":{\"code\":-32601"]))
        n = n + 1
    })
    // and none of them is advertised — which is why a conforming client never even asks
    all
        && o.contains("declarationProvider") == false
        && o.contains("implementationProvider") == false
        && o.contains("referencesProvider") == false
        && o.contains("documentSymbolProvider") == false
        && o.contains("renameProvider") == false
        && mp.lz_rc(28) == "0"
}
// ── completion, as an editor drives it ────────────────────────────────────────────────────────────
// one completion probe on an UNSAVED buffer at (line, ch).
lz_comp_probe = (mp: MutPtr<Malloc>, gid: i64, buf: string_view, line: i64, ch: i64) string_view {
    z: string_view := ""
    uri := mp.lz_uri("lzcmp.zen")
    mp.lz_run(gid, mp.zo_join([z, mp.lz_frame(LZ_INIT()), mp.lz_frame(mp.lz_open(uri, buf)), mp.lz_frame(mp.lz_posreq(uri, "completion", 3, line, ch)), mp.lz_frame(LZ_SHUT()), mp.lz_frame(LZ_EXIT())]))
}
// (a) EMPTY buffer: the reply is the fixed keyword + builtin-type lists and nothing else. NOT
// IMPLEMENTED — a blank file is exactly where the DECL SHAPES are worth most (`name = (p: T) R { }`,
// `Name*: { f: T }`, `Name*: A | B(p)`, `Type.impl(Trait, { })`, `{ n } = std.module`), and Zen's
// forms are unusual enough that they cannot be guessed. None is offered, as a snippet or otherwise.
lz_comp_empty_buffer = (mp: MutPtr<Malloc>) bool {
    o := mp.lz_comp_probe(29, "", 0, 0)
    o.contains("\"label\":\"match\",\"kind\":14")
        && o.contains("\"label\":\"i32\"")
        && o.contains("insertTextFormat") == false
        && o.contains("std.text.fmt") == false
        && mp.lz_rc(29) == "0"
}
// (b) TOP LEVEL of a half-typed file: the buffer's own column-0 declarations DO come back, and from
// the buffer rather than disk. WORKS — and it is the part of completion that is genuinely right.
lz_comp_top_level = (mp: MutPtr<Malloc>) bool {
    o := mp.lz_comp_probe(30, "helper* = (x: i32) i32 { x }\\nmain = () i32 {\\n    0\\n}\\n", 2, 4)
    o.contains("\"label\":\"helper\"") && o.contains("\"label\":\"main\"") && mp.lz_rc(30) == "0"
}
// (c) AFTER `std.` in a half-typed import record. NOT IMPLEMENTED — the std module tree is on disk
// and `tools/sigs.zen` already walks it with the real parser, but nothing enumerates it here, so the
// keystroke that most needs help gets the same fixed keyword list as everywhere else.
lz_comp_after_std_dot = (mp: MutPtr<Malloc>) bool {
    o := mp.lz_comp_probe(31, "{ x } = std.\\nmain = () i32 { 0 }\\n", 0, 12)
    o.contains("\"label\":\"match\",\"kind\":14")
        && o.contains("\"label\":\"text.str\"") == false
        && o.contains("\"label\":\"mem.alloc\"") == false
        && mp.lz_rc(31) == "0"
}
// (d) AFTER A RECEIVER `a.`, where `a: AVec` and `push` is an INHERENT METHOD inside the type body.
// NOT IMPLEMENTED — neither the field `n` nor the method `push` is offered, and the reply does not
// depend on the receiver at all. Same root as gd (c): members live inside type bodies, where no
// column-0 textual scan can see them. `zen doc` and the (absent) symbol outline miss the same set.
lz_comp_receiver_members = (mp: MutPtr<Malloc>) bool {
    buf := "AVec*: { n: i32,\\n    push = (a: AVec, x: i32) i32 { x }\\n}\\nmain = () i32 {\\n    a := AVec(n: 0)\\n    a.\\n}\\n"
    o := mp.lz_comp_probe(32, buf, 5, 6)
    o.contains("\"label\":\"AVec\"")
        && o.contains("\"label\":\"push\"") == false
        && o.contains("\"label\":\"n\"") == false
        && mp.lz_rc(32) == "0"
}
// (e) AN UNIMPORTED NAME. NOT IMPLEMENTED — `println` is a real std symbol (std.text.fmt) this buffer
// has not imported, so it is not offered; and with nothing to offer there is no `additionalTextEdits`
// carrying the `{ println } = std.text.fmt` record an accepted item would have to insert. Both halves
// of auto-import are absent, and `resolveProvider:false` means there is no lazy hook to add one to.
lz_comp_auto_import = (mp: MutPtr<Malloc>) bool {
    o := mp.lz_comp_probe(33, "main = () i32 {\\n    prin\\n    0\\n}\\n", 1, 8)
    o.contains("\"label\":\"println\"") == false
        && o.contains("additionalTextEdits") == false
        && o.contains("\"completionProvider\":{\"resolveProvider\":false}")
        && mp.lz_rc(33) == "0"
}
harness_lsp_run* = () i32 {
    m := Malloc(_: 0)
    mp := m.addr()
    run_suite("lsp (JSON-RPC stdio conformance: handshake, diagnostics, robustness)", [mp.lz_init_ok(), mp.lz_open_bad(), mp.lz_change_clears(), mp.lz_unknown_method(), mp.lz_garbage_cl(), mp.lz_huge_cl(), mp.lz_didclose_clears(), mp.lz_utf16_cols(), mp.lz_multifile_sibling(), mp.lz_foreign_module_error(), mp.lz_goto_def(), mp.lz_semantic_tokens(), mp.lz_unsaved_buffer_tokens(), mp.lz_close_reverts_to_disk(), mp.lz_rawstring_token_order(), mp.lz_hover_buffer(), mp.lz_completion_items(), mp.lz_import_keystrokes(), mp.lz_exit_no_shutdown(), mp.lz_gd_same_file_fn(), mp.lz_gd_same_file_type(), mp.lz_gd_inherent_method(), mp.lz_gd_struct_field(), mp.lz_gd_cross_module(), mp.lz_gd_imported_std(), mp.lz_gd_qualified(), mp.lz_hover_motion(), mp.lz_unimplemented_motions(), mp.lz_comp_empty_buffer(), mp.lz_comp_top_level(), mp.lz_comp_after_std_dot(), mp.lz_comp_receiver_members(), mp.lz_comp_auto_import()])
}
