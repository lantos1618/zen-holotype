// src/zen/zen_path.zen
// What a module PATH means, said away from a build.
//
// A module lives at `<folder>/<folder>.zen`; a module NAME is that path
// with separators as dots. Both are facts about a string, not a phase
// of anything — written as free functions so a second driver reads the
// same rule.
//
// EVERY PATH THAT REACHES A SPAN IS RELATIVE TO THE COMPILATION ROOT
// (`relative_to`): an absolute path in a diagnostic puts the checkout's
// location into the emitted C, and two checkouts of one tree then emit
// different bytes — silently voiding the determinism oracle (TESTING.md).

Alloc, AllocError = std.mem
str, String = std.text
Range = std.core

QualifiedName = std.ast.ast_span

// The last path component of a root — `probe` of `tests/corpus/x/probe`
// — what a folder repeats to name its root file. `cut` starts at 0
// since a `/`-free path is already its own basename.
base_of* = (root: str) str {
    root.slice(root.after_last_slash(), root.len);
}

// One past the last `/`, or 0 when there is none, making a single
// component its own last component.
after_last_slash* = (path: str) usize {
    cut ::= 0;
    Range(0, path.len).loop((h, i) {
        (path.index(i) == '/').then(() { cut = i + 1; });
    });
    cut
}

// THE MODULE A PATH IS, and the name a `Unit` carries.
//
// The path relative to the root, separators as dots, extension off:
// `<root>/a/b/c.zen` is `a.b.c` — the file's IDENTITY, one name. A
// folder root has a second, shorter spelling (`std.core` for
// `std/core/core.zen`); naming the module after whichever spelling
// arrived first would make one file two modules.
//
// The short spelling isn't lost — it's a way of WRITING the identity,
// not a second one; `World.index_of` is where the two meet (same split
// `bootstrap/modules.py` draws between a file's `dotted` and its aliases).
module_name* = (a: Alloc, root: str, path: str) Res<str, AllocError> {
    inner = path.slice(root.len + 1, path.len - EXT_BYTES);
    out ::= a.String().try();
    Range(0, inner.len).loop((h, i) {
        out.add_byte(dot_for(inner.index(i))).try();
    });
    Ok(out.view());
}

// The path one level up, `""` when there's no level up. `slice(0, cut -
// 1)` with `cut` at 0 would underflow a `usize` and trap — the guard is
// the whole reason this is a function.
parent_of* = (path: str) str {
    cut = path.after_last_slash();
    (cut == 0).match({
        true  => "",
        false => path.slice(0, cut - 1),
    })
}

// WHICH ROOT A FILE WAS MEANT TO BE COMPILED AGAINST.
//
// An editor knows one directory (the workspace, from `initialize`'s
// `rootUri`), almost never the compilation root: this tree builds as
// `zen build src` while a workspace opens at the repository, so
// `lex.lex` resolved against the repository finds nothing and every
// imported name comes back undefined — indistinguishable from no build
// at all.
//
// THE RULE ALREADY STATED ABOVE, read upward: a module lives at
// `<folder>/<folder>.zen`, so a directory holding its own name is
// INSIDE a program, not its root — climb out. `src/lsp` holds
// `lsp.zen` so climb; `src` holds no `src.zen` so stop.
//
// `floor` IS A GUARD, NOT AN ANSWER: the climb stops at the workspace
// regardless of disk, so a home directory named after a file inside it
// can't walk a build out of the project.
//
// A directory holding a `build.zen` is ALSO root evidence, and the
// second rule climbs where the first one stopped short: `example/src`
// holds no `src.zen`, so a file opened there rooted at `example/src`
// while the tree carrying `std` sits at `example` — the prelude never
// seeds and every imported name comes back undefined. The editors
// already mark a project this way (`editors/nvim/zen.lua`'s
// `root_markers`), so the compiler reads the same marker or the two
// disagree about one fact. Toward the floor, never past it, and when no
// `build.zen` answers the first rule's answer stands.
root_for* = (env: Env, a: Alloc, floor: str, path: str) str {
    dir ::= parent_of(path);
    loop(() { dir.len > floor.len && holds_its_own_name(env, a, dir) }, (h) {
        dir = parent_of(dir);
    });
    settled = dir;
    marked ::= dir;
    loop(
        () { marked.len > floor.len && !holds_build_zen(env, a, marked) },
        (h) { marked = parent_of(marked); });
    (marked.len >= floor.len && !marked.is_empty()
     && holds_build_zen(env, a, marked)).match({
        true  => marked,
        false => settled,
    });
}

// `<dir>/<basename>.zen` — the folder-root spelling, asked of the disk.
// An allocation failure answers `false` rather than propagating: the
// caller is a loop condition, and the honest answer to "is this a
// module folder" when the question can't be asked is "stop climbing".
holds_its_own_name = (env: Env, a: Alloc, dir: str) bool {
    a.String("{}/{}.zen", dir, dir.base_of()).match({
        Err(_) => false,
        Ok(f)  => env.fs.exists(f.view()),
    })
}

// `<dir>/build.zen` — the project marker the editors already root by,
// asked of the disk. The same allocation-failure contract as
// `holds_its_own_name` above, and for the same reason.
holds_build_zen = (env: Env, a: Alloc, dir: str) bool {
    a.String("{}/build.zen", dir).match({
        Err(_) => false,
        Ok(f)  => env.fs.exists(f.view()),
    })
}

// The same file, relative to the compilation root: `module_name`
// without the dots or dropped extension. `+ 1` for the separator; a
// path not under the root comes back unchanged rather than sliced into
// nonsense.
//
// UNDER THE ROOT IS CHECKED, NOT ASSUMED: the CLI's walk only ever
// discovers under-root paths, but the LSP feeds this whatever path a
// client sent (`path_of`), and a length test alone slices any string
// long enough — `/usr/lib/x.zen` against root `/home/u/zenc/src`
// "qualifies". The separator test is what keeps `/a/bc/d.zen` from
// passing as under `/a/b`.
relative_to* = (root: str, path: str) str {
    under = path.len > root.len + 1
        && path.slice(0, root.len).eq(root)
        && path.index(root.len) == '/';
    under.match({
        true  => path.slice(root.len + 1, path.len),
        false => path,
    });
}

// `.zen`, written here since `module_name` is the one place that takes
// it back off.
EXT_BYTES : usize = 4

dot_for = (b: u8) u8 {
    (b == '/').match({ true  => '.', false => b })
}

// The inverse, for the one module named by a dotted CONSTANT rather
// than a path: `std.core` is the prelude's name, `<root>/std/core.zen`
// is where its bytes are.
slash_for* = (b: u8) u8 {
    (b == '.').match({ true  => '/', false => b })
}

// The last segment of a dotted name — `mem` of `std.mem` — what a
// folder repeats to name its root file.
last_of* = (q: QualifiedName) str {
    q.segments.get(q.segments.len - 1).match({
        Ok(s) => s.text,
        None  => "",
    })
}

// A module of the program: what it is called, and where its bytes are.
//
// THE PATH IS THE IDENTITY, THE NAME IS DERIVED FROM IT. Two spellings
// reach one file (`std/core/core.zen` is `std.core` to a module writing
// the folder, `std.core.core` to one writing the file); a `Unit` keyed
// on the import that found it would make one file two modules, and a
// program that never writes the short spelling would have no prelude
// at all. `docs/SEMA_BOOTSTRAP_FIXES.md` §13 is that bug with its
// reproducer.
Unit* = {
    name*: str,     // the dotted module name: `std.core.result`
    path*: str,     // where the bytes are, to open them: as given
    rel*:  str,     // the same file, relative to the compilation ROOT
}

// `rel` exists because `path` must not reach a Span: every diagnostic
// and trap position carries its file, so an absolute path would put the
// checkout's location into the OUTPUT, and two checkouts of one tree
// would emit different bytes — silently voiding the fixpoint oracle
// (TESTING.md).

// The `Unit` a FILE is. The name is a pure function of the path, never
// the spelling that found it, so `std.core` and `std.core.core` are one
// module read once.
//
// HERE, not on the driver: the two functions filling its fields live
// here — a `Build` method calling only `module_name`/`relative_to`
// would be a fact about a path wearing a build's `self`.
unit_at* = (a: Alloc, root: str, path: str) Res<Unit, AllocError> {
    name = module_name(a, root, path).try();
    Ok(Unit(name: name, path: path, rel: relative_to(root, path)));
}

// `<root>/<name>.zen`, or `<root>/<name>/<name>.zen` when the name is a
// folder — the top-of-file rule, asked of a real directory.
//
// A stat, not a string (hence the `Env`): both spellings are
// well-formed, only the disk can say which the author wrote — still
// what a module path MEANS, not a build phase, so it lives beside the
// rule, not the walk.
//
// A candidate is returned whether or not it exists: a root with no
// entry is reported by the READ (which names the file), so a probe
// reporting it too would be the same mistake twice — the flat form
// wins when NEITHER exists, since the shorter path is what a
// diagnostic should carry.
candidate* = (env: Env, a: Alloc, root: str, name: str) Res<Unit, AllocError> {
    flat ::= a.String("{}/{}.zen", root, name).try();
    nest ::= a.String("{}/{}/{}.zen", root, name, name).try();
    take_flat = env.fs.exists(flat.view()) || !env.fs.exists(nest.view());
    take_flat.match({
        true  => unit_at(a, root, flat.view()),
        false => unit_at(a, root, nest.view()),
    })
}

// WHERE A PROGRAM STARTS, spelled once — both the module name the entry
// probe looks for and the declaration the root must own, so a probe
// finding `main.zen` and a check demanding `start` can't drift apart.
ENTRY*: str = "main"

// WHERE THE PROGRAM STARTS. `--entry <file>` answers it outright;
// without one, the root is probed.
//
// The probe is what a listing-less directory can do — conventional
// names only, why `--entry` exists. `std.env.Fs` has no listing on
// purpose (enumerating a directory is strictly more authority than
// reading a handed path); the info is already at the call site, since
// whoever invokes the compiler knows the entry.
//
// A build is still a ROOT: the entry says where to start inside it,
// every other module is found by following imports.
//
// FREE FUNCTIONS, NOT METHODS ON `Build` (as `unit_at` above): these
// read `env`/`alloc`/`root` and nothing else a build holds — no tree,
// tally, or phase — so a `self` here would be a path wearing a build's
// receiver. Moving them also made room in `zen_build.zen`, which was
// at its cap.
entry_of* = (env: Env, a: Alloc, root: str, named: str)
            Res<Unit, AllocError> {
    named.is_empty().match({
        false => entry_named(env, a, root, named),
        true  => entry_probed(env, a, root),
    })
}

// `--entry` is relative to the root, since `Unit.rel` is what a Span
// carries and an absolute path there would void the determinism check.
//
// NOT PROBED: a named entry that isn't there is reported by the READ
// (naming the file asked for) — a probe reporting it too would say the
// same mistake twice, and the caller who chose the name is owed it back.
entry_named = (env: Env, a: Alloc, root: str, named: str)
              Res<Unit, AllocError> {
    path ::= a.String("{}/{}", root, named).try();
    unit_at(a, root, path.view())
}

// No `--entry`: the entry point is a MODULE NAME resolved by the same
// two probes every other module gets. Three names, most conventional
// first:
//
//   main        every program in tests/corpus, and DESIGN.md's own
//               `src: Path("src/main.zen")` build.zen example
//   <basename>  the folder-root rule `<folder>/<folder>.zen`, applied
//               to the root itself
//   zen         this tree, and only this tree
//
// The third is still a special case: `scripts/fixpoint.sh` runs `zen
// build src` with no entry, so this order is load-bearing.
entry_probed = (env: Env, a: Alloc, root: str) Res<Unit, AllocError> {
    first = candidate(env, a, root, ENTRY).try();
    env.fs.exists(first.path).match({
        true  => Ok(first),
        false => entry_after_main(env, a, root),
    })
}

entry_after_main = (env: Env, a: Alloc, root: str) Res<Unit, AllocError> {
    base = root.base_of();
    second = candidate(env, a, root, base).try();
    env.fs.exists(second.path).match({
        true  => Ok(second),
        false => candidate(env, a, root, "zen"),
    })
}

// Where the bytes an IMPORT names are: `<root>/a/b/c.zen`, or
// `<root>/a/b/c/c.zen` when the last segment names a folder. The plain
// form is probed first (the common case); a folder with a file beside
// it is a collision the module graph rejects anyway.
file_of* = (env: Env, a: Alloc, root: str, q: QualifiedName)
           Res<str, AllocError> {
    flat = joined(a, root, q, false).try();
    env.fs.exists(flat).match({
        true  => Ok(flat),
        false => joined(a, root, q, true),
    })
}

joined* = (a: Alloc, root: str, q: QualifiedName, folder: bool)
          Res<str, AllocError> {
    out ::= a.String("{}", root).try();
    q.segments.loop((h, s) {
        out.add_byte('/').try();
        out.add_bytes(s.text).try();
    });
    folder.then(() {
        out.add_byte('/').try();
        out.add_bytes(last_of(q)).try();
    });
    out.add_bytes(".zen").try();
    Ok(out.view());
}
