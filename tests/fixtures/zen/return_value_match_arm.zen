// Bug 2: `return` inside a VALUE-position match arm (manual unwrap-or-propagate)
{ Result, IoError, err } = std.core.result
g = (ok: i32) Result<i32, IoError> {
    (ok == 1).match ({ true => .Ok(5), false => .Err(.NotFound) })
}
f = (ok: i32) Result<i32, IoError> {
    v := g(ok).match ({
        .Ok(x)  => x,
        .Err(e) => {
            return err(e)
        },
    })
    .Ok(v + 1)
}
main = () i32 {
    a := f(1).match ({
        .Ok(v)  => v,
        .Err(e) => 0,
    })    // 6
    b := f(0).match ({
        .Ok(v)  => 0,
        .Err(e) => 1,
    })    // 1
    a * 10 + b
}    // 61
