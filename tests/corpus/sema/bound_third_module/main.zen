// a third module: the bound comes from `boxy`, the impl from `tile`,
// and neither is declared here. TESTING.md, Sema: "a bound satisfied by
// an impl in another module".

Boxy = boxy.boxy
Tile = tile.tile

scale = <T: Boxy>(shape: T, k: i32) i32 { shape.area() * k }

main = (env: Env) Res<i32, AllocError> {
    println("{}", scale(Tile(side: 2), 3));
    Ok(0);
}
