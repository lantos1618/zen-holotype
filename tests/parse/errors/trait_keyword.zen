// MUST FAIL: `trait`. DESIGN.md:99 — "One declaration form: there are no traits,
// only structs. A struct whose fields happen to be functions, used as a bound, is
// what other languages call a trait — nothing marks it special, because nothing
// needs to." `Display`, `Eq`, `Hash`, `Drop`, `Alloc`, `Actor` are all `Name* = {..}`.

trait Display* {
    toString = (self: @Self, sb :: String) Res<(), IoError>
}
