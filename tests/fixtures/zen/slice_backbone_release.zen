// TEETH for std.mem.alloc's `release_slice`. A `[T]` is (ptr, len) over ONE block — the block
// `nbuf`/`split` acquired — and this program hands all three of its backbones back, so valgrind
// reports `definitely lost: 0 bytes in 0 blocks`:
//   ./zen build tests/fixtures/zen/slice_backbone_release.zen -o /tmp/sbr
//   valgrind --leak-check=full /tmp/sbr
// Delete any one `release_slice` line below and that same command reports its backbone as
// definitely lost (32 / 128 / 24 bytes) — which is the leak this fixture exists to keep closed.
//
// It prints NOTHING on purpose: a `formatln("{}", [arg_int(x)])` heap-promotes its `[Arg]` slice
// literal and nothing frees it, which would drown the signal. The verdict is the exit code.
{ release_slice } = std.mem.alloc
{ nbuf, split, view } = std.text.str
{ to_exit } = std.core.bool
halloc = std.mem.heap
Row: {
    a: i64,
    b: i64,
    c: i64,
    d: i64,
}
main = () i32 {
    alloc := halloc.gpa()
    a := alloc.addr()
    // ALLOC: one block of 4 * sizeof(i64). Its freer is the release_slice below.
    ns: [i64] := a.nbuf(0, 4)
    ns[3] = 9
    // ALLOC: 4 * sizeof(Row) — a STRUCT element type, so the backbone is 128 bytes wide while the
    // slice's ptr is still that block's base. Same freer.
    rs: [Row] := a.nbuf(Row(
        a: 0,
        b: 0,
        c: 0,
        d: 0,
    ), 4)
    rs[3] = Row(
        a: 1,
        b: 2,
        c: 3,
        d: 4,
    )
    // ALLOC twice over: the [StringView] backbone AND one NUL-terminated copy per field.
    parts: [StringView] := a.split("x,yy,zzz", ',')
    total := 0
    parts.loop((h, i, p) {
        total = total + p.len()
    })
    // Read every slice while it is still alive: after the frees below, nothing may.
    ok := ns[3] == 9 && rs[3].d == 4 && total == 6 && parts.len == 3
    parts.loop((h, i, p) {
        // FREE: the per-field copies, through the backbone that still points at them.
        a.release(p.view().ptr)
    })
    // FREE: the three backbones themselves, last.
    a.release_slice(parts)
    a.release_slice(rs)
    a.release_slice(ns)
    ok.to_exit()
}
