maths = helpers

pair = (a: i32, b: i32) i32 { a * 10 + b }

unused = <T>(value: T) T { value }

main = (env: Env) i32 {
    x: i32 ::= 1;
    first    = x + true.match({ true => { x = 2; 1 }, false => 0 });
    second   = pair(x, true.match({ true => { x = 4; 3 }, false => 0 }));
    skipped  = false && true.match({ true => { x = 9; true }, false => false });
    taken    = true || true.match({ true => { x = 10; false }, false => false });
    selected = (first == 2).match({
        true  => (second == 23).match({ true => 8, false => 9 }),
        false => 10,
    });
    println(
        "{} {} {} {} {} {} {}",
        first,
        second,
        x,
        maths.fib(6),
        skipped,
        taken,
        selected
    );
    println("{{literal}} {x}\0");
    7
}
