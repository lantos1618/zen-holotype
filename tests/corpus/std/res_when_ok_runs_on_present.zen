// `when_ok` on a Res<T> is the one-sided match: the closure sees a present
// value and absence passes through, and it composes like `bool.then`.

main = (env: Env) Res<i32, AllocError> {
    present: Res<u64> = Ok(21);
    absent: Res<u64>  = None;
    seen ::= 0;
    present.when_ok((v) { seen = v; });
    absent.when_ok((v) { seen = 1000; });
    println("side effect ran once: {}", seen);
    doubled: u64 = present.when_ok((v) { v * 2 }).value_or(0);
    println("maps a value: {}", doubled);
    fallback: u64 = absent.when_ok((v) { v * 2 }).value_or(7);
    println("absence maps to fallback: {}", fallback);
    bool_answer: str = (seen == 21).then(() { "yes" }).value_or("no");
    println("bool.then still answers: {}", bool_answer);
    Ok(0);
}
