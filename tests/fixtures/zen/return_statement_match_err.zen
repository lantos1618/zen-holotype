// Regression: `return err(...)` inside a statement-position match arm
{ Result, IoError, err } = std.core.result
g = (ok: i32) Result<i32, IoError> { (ok == 1).then({ .Ok(5) }, { .Err(.NotFound) }) }
f = (ok: i32) Result<i32, IoError> {
    r = g(ok)
    r.match ({
        .Err(e) => {
            return err(e)
        },
        _       => { },
    })
    v = r.match ({
        .Ok(x) => x,
        _      => 0,
    })
    .Ok(v + 1)
}
main = () i32 {
    a = f(1).match ({
        .Ok(v)  => v,
        .Err(e) => 0,
    })    // 6
    b = f(0).match ({
        .Ok(v)  => 0,
        .Err(e) => 1,
    })    // 1
    a * 10 + b
}    // 61
