// compiler.passes.closures — closure conversion sub-pass extracted from compiler.check.
{ ArmData, CallData, Decl, Expr, Field, FieldInit, FnTData, Func, LambdaData, Param, Stmt,
  StructDecl, VarData } = compiler.ast.ast_types
{ cbuf, arm_at, arrow_at, bin_at, block, call_at, cond_oa, dfunc, eindex, eloop, ematch, ematchp,
  finit, gstr_append, gstr_finish, gstr_string, lam_r, member, member_at, mkenumg, mkstruct,
  mkstructg_at, no_tys, sassign_at, sexpr, sidxset_at, sif, slet, slett_at, slit, sret, swhile,
  tnamed, tvoid, vref, vref_at } = compiler.genc
{ DeclIndex, Env, VList, empty_params, no_stmts, param_index, pbuf, recall, tnode, vcons, vnil } = compiler.check
{ lift_extend, lift_is_captured, lift_lamparams, lift_liftable } = compiler.passes.lift
{ gstr_int, map_slice } = compiler.astops
{ Malloc } = std.mem.alloc
clos_local_call_name* = (env: Env, name: string_view) string_view {
    (env.env_func(name).name == "").match ({
        true  => env.var_ty(name).match ({
            .Named(sn) => {
                cn := env.a.clos_call_name(sn)
                env.didx.func_idx.get(cn, 0 - 1) >= 0 ? cn : ""
            },
            _          => "",
        }),
        false => "",
    })
}
clos_call_rewrite* = (a: MutPtr<Malloc>, c: CallData, cn: string_view, buf: [Expr]) Ptr<Expr> {
    args := a.cebuf(buf.len + 1)
    args[0] = vref(c.fn)
    buf.loop((h, i, e) {
        args[i + 1] = e
    })
    a.cenode(call_at(cn, args, c.pos))
}
clos_struct_name = (a: MutPtr<Malloc>, k: i64) string_view {
    a
        .gstr_string(24)
        .gstr_append(a, "__clos_")
        .gstr_int(a, k)
        .gstr_finish(a)
}
clos_call_name = (a: MutPtr<Malloc>, structn: string_view) string_view {
    a
        .gstr_string(32)
        .gstr_append(a, structn)
        .gstr_append(a, "_call")
        .gstr_finish(a)
}
clos_params_has = (ps: [Param], n: string_view) bool { ps.param_index(n) >= 0 }
// Does the lambda body capture a FREE name that is NOT one of the enclosing function's params (and not
// a lambda-bound name / top-level / true|false)? Such a closure is unsupported here → leave it be.
clos_bad_args = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    bound: Ptr<VList>,
    ps: [Param],
    xs: [Expr],
) bool {
    found := false
    xs.loop((h, i, x) {
        found = found ? true : a.clos_bad_expr(decls, idx, bound, ps, x.addr())
    })
    found
}
clos_bad_inits = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    bound: Ptr<VList>,
    ps: [Param],
    inits: [FieldInit],
) bool {
    found := false
    inits.loop((h, i, fi) {
        found = found ? true : a.clos_bad_expr(decls, idx, bound, ps, fi.value)
    })
    found
}
clos_bad_arms = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    bound: Ptr<VList>,
    ps: [Param],
    arms: [ArmData],
) bool {
    found := false
    arms.loop((h, i, ar) {
        found = found.match ({
            true  => true,
            false => a.clos_bad_expr(decls, idx, a.vcons(ar.bind, tvoid(), bound), ps, ar.body),
        })
    })
    found
}
clos_bad_body = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    bound: Ptr<VList>,
    ps: [Param],
    body: [Stmt],
) bool {
    found := false
    b := bound
    body.loop((h, i, st) {
        found = found ? true : a.clos_bad_stmt(decls, idx, b, ps, st)
        b = a.lift_extend(b, st)
    })
    found
}
clos_bad_stmt = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    bound: Ptr<VList>,
    ps: [Param],
    st: Stmt,
) bool {
    st.match ({
        .Let(l)      => a.clos_bad_expr(decls, idx, bound, ps, l.value),
        .Assign(x)   => a.clos_bad_expr(decls, idx, bound, ps, x.target)
            || a.clos_bad_expr(decls, idx, bound, ps, x.value),
        .Return(r)   => a.clos_bad_expr(decls, idx, bound, ps, r),
        .ExprStmt(e) => a.clos_bad_expr(decls, idx, bound, ps, e),
        .If(f)       => a.clos_bad_expr(decls, idx, bound, ps, f.c)
            || a.clos_bad_body(decls, idx, bound, ps, f.then)
            || a.clos_bad_body(decls, idx, bound, ps, f.els),
        .While(w)    => a.clos_bad_expr(decls, idx, bound, ps, w.c)
            || a.clos_bad_body(decls, idx, bound, ps, w.body),
        .IndexSet(x) => a.clos_bad_expr(decls, idx, bound, ps, x.seq)
            || a.clos_bad_expr(decls, idx, bound, ps, x.idx)
            || a.clos_bad_expr(decls, idx, bound, ps, x.value),
    })
}
clos_bad_expr = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    bound: Ptr<VList>,
    ps: [Param],
    e: Ptr<Expr>,
) bool {
    load(e).match ({
        .Var(v)        => lift_is_captured(decls, idx, bound, v.name)
            && ps.clos_params_has(v.name) == false,
        .Bin(b)        => a.clos_bad_expr(decls, idx, bound, ps, b.lhs)
            || a.clos_bad_expr(decls, idx, bound, ps, b.rhs),
        .Call(c)       => lift_is_captured(decls, idx, bound, c.fn)
            && ps.clos_params_has(c.fn) == false
            || a.clos_bad_args(decls, idx, bound, ps, c.args),
        .Cond(d)       => a.clos_bad_expr(decls, idx, bound, ps, d.c)
            || a.clos_bad_expr(decls, idx, bound, ps, d.t)
            || a.clos_bad_expr(decls, idx, bound, ps, d.e),
        .Member(m)     => a.clos_bad_expr(decls, idx, bound, ps, m.obj),
        .Arrow(ar)     => a.clos_bad_expr(decls, idx, bound, ps, ar.obj),
        .MakeEnum(mk)  => a.clos_bad_expr(decls, idx, bound, ps, mk.payload),
        .MakeStruct(s) => a.clos_bad_inits(decls, idx, bound, ps, s.inits),
        .Match(m)      => a.clos_bad_expr(decls, idx, bound, ps, m.subj)
            || a.clos_bad_arms(decls, idx, bound, ps, m.arms),
        .Index(ix)     => a.clos_bad_expr(decls, idx, bound, ps, ix.seq)
            || a.clos_bad_expr(decls, idx, bound, ps, ix.idx),
        .SliceLit(sd)  => a.clos_bad_args(decls, idx, bound, ps, sd.items),
        .Loop(l)       => a.clos_bad_expr(decls, idx, bound, ps, l.seq)
            || a.clos_bad_body(decls, idx, a.vcons(l.idx, tvoid(), a.vcons(l.elem, tvoid(), bound)), ps, l.body),
        .Block(bl)     => a.clos_bad_body(decls, idx, bound, ps, bl.stmts),
        .Lambda(la)    => a.clos_bad_body(decls, idx, a.lift_lamparams(bound, la.params), ps, la.body),
        _              => false,
    })
}
// substitute every reference to a captured param `p` with `__clenv.p` (a member access) in the lifted
// body. Captured-param names never collide with the lambda's own params (those are bound, not free), so
// a flat name-keyed substitution is correct for the supported shape.
clos_sub_var = (a: MutPtr<Malloc>, ps: [Param], v: VarData) Ptr<Expr> {
    ps.clos_params_has(v.name).match ({
        true  => a.cenode(member_at(a.cenode(vref("__clenv")), v.name, v.pos)),
        false => a.cenode(vref_at(v.name, v.pos)),
    })
}
// A call whose callee NAMES a captured param `f` (a function VALUE now living in `__clenv.f`) becomes an
// indirect call through that field: `f(args) -> ({ __zclos_recv := __clenv.f  __zclos_recv(args) })`.
// Same shape as check.rewrite_fn_field_call (the proven local-fn-value genc path — C `__auto_type` +
// native indirect call); the fixed temp name is block-scoped, so nested closure calls never collide.
clos_sub_fncall = (a: MutPtr<Malloc>, ps: [Param], c: CallData) Ptr<Expr> {
    rest := a.clos_sub_args(ps, c.args)
    letst := slet("__zclos_recv", a.cenode(member(a.cenode(vref("__clenv")), c.fn)))
    callx := a.cenode(call_at("__zclos_recv", rest, c.pos))
    sbuf2 := cbuf<Stmt>(a, 2)
    sbuf2[0] = letst
    sbuf2[1] = sexpr(callx)
    a.cenode(block(sbuf2))
}
clos_sub_args = (a: MutPtr<Malloc>, ps: [Param], xs: [Expr]) [Expr] {
    buf := a.cebuf(xs.len)
    xs.loop((h, i, x) {
        buf[i] = load(a.clos_sub_expr(ps, x.addr()))
    })
    buf
}
clos_sub_inits = (a: MutPtr<Malloc>, ps: [Param], inits: [FieldInit]) [FieldInit] {
    map_slice(a, inits, (fi) { finit(fi.name, a.clos_sub_expr(ps, fi.value)) })
}
clos_sub_arms = (a: MutPtr<Malloc>, ps: [Param], arms: [ArmData]) [ArmData] {
    map_slice(a, arms, (ar) { arm_at(ar.variant, ar.bind, a.clos_sub_expr(ps, ar.body), ar.pos) })
}
clos_sub_expr = (a: MutPtr<Malloc>, ps: [Param], e: Ptr<Expr>) Ptr<Expr> {
    load(e).match ({
        .Var(v)        => a.clos_sub_var(ps, v),
        .MakeStruct(s) => a.cenode(mkstructg_at(s.ty, s.mty, s.targs, a.clos_sub_inits(ps, s.inits), s.pos)),
        .Bin(b)        => a.cenode(bin_at(b.op, a.clos_sub_expr(ps, b.lhs), a.clos_sub_expr(ps, b.rhs), b.pos)),
        .Cond(d)       => a.cenode(cond_oa(a.clos_sub_expr(ps, d.c), a.clos_sub_expr(ps, d.t), a.clos_sub_expr(ps, d.e), d.oa)),
        .Member(m)     => a.cenode(member_at(a.clos_sub_expr(ps, m.obj), m.field, m.pos)),
        .Arrow(ar)     => a.cenode(arrow_at(a.clos_sub_expr(ps, ar.obj), ar.field, ar.pos)),
        .Call(c)       => ps.clos_params_has(c.fn).match ({
            true  => a.clos_sub_fncall(ps, c),
            false => a.recall(c, c.fn, a.clos_sub_args(ps, c.args)),
        }),
        .MakeEnum(mk)  => a.cenode(mkenumg(mk.ty, mk.mty, mk.targs, mk.variant, a.clos_sub_expr(ps, mk.payload))),
        .Match(m)      => m.ptr.match ({
            true  => a.cenode(ematchp(a.clos_sub_expr(ps, m.subj), m.ename, a.clos_sub_arms(ps, m.arms))),
            false => a.cenode(ematch(a.clos_sub_expr(ps, m.subj), m.ename, a.clos_sub_arms(ps, m.arms))),
        }),
        .Index(ix)     => a.cenode(eindex(a.clos_sub_expr(ps, ix.seq), a.clos_sub_expr(ps, ix.idx), ix.elem)),
        .SliceLit(sd)  => a.cenode(slit(sd.elem, a.clos_sub_args(ps, sd.items))),
        .Loop(l)       => a.cenode(eloop(a.clos_sub_expr(ps, l.seq), l.idx, l.elem, l.elemTy, a.clos_sub_body(ps, l.body), l.h)),
        .Block(bl)     => a.cenode(block(a.clos_sub_body(ps, bl.stmts))),
        .Lambda(lm)    => a.cenode(lam_r(lm.params, a.clos_sub_body(ps, lm.body), lm.ret)),
        _              => e,
    })
}
clos_sub_stmt = (a: MutPtr<Malloc>, ps: [Param], st: Stmt) Stmt {
    st.match ({
        .Let(l)      => slett_at(l.name, l.ty, a.clos_sub_expr(ps, l.value), l.pos),
        .Assign(x)   => sassign_at(a.clos_sub_expr(ps, x.target), a.clos_sub_expr(ps, x.value), x.pos),
        .Return(r)   => sret(a.clos_sub_expr(ps, r)),
        .ExprStmt(e) => sexpr(a.clos_sub_expr(ps, e)),
        .If(f)       => sif(a.clos_sub_expr(ps, f.c), a.clos_sub_body(ps, f.then), a.clos_sub_body(ps, f.els)),
        .While(w)    => swhile(a.clos_sub_expr(ps, w.c), a.clos_sub_body(ps, w.body)),
        .IndexSet(x) => sidxset_at(a.clos_sub_expr(ps, x.seq), a.clos_sub_expr(ps, x.idx), x.elem, a.clos_sub_expr(ps, x.value), x.pos),
    })
}
clos_sub_body = (a: MutPtr<Malloc>, ps: [Param], body: [Stmt]) [Stmt] {
    map_slice(a, body, (st) { a.clos_sub_stmt(ps, st) })
}
// the tail (implicit-return) lambda of a body, if any: the last statement is a bare expression that is
// itself a lambda literal. (a `return <lambda>` tail works too.)
clos_tail_lambda = (body: [Stmt]) bool {
    (body.len == 0).match ({
        true  => false,
        false => body[body.len - 1].match ({
            .ExprStmt(e) => load(e).match ({
                .Lambda(lm) => true,
                _           => false,
            }),
            .Return(r)   => load(r).match ({
                .Lambda(lm) => true,
                _           => false,
            }),
            _            => false,
        }),
    })
}
clos_tail_lam_of = (body: [Stmt]) LambdaData {
    none := LambdaData(
        params: empty_params(),
        body: no_stmts(),
        ret: tvoid(),
    )
    body[body.len - 1].match ({
        .ExprStmt(e) => load(e).match ({
            .Lambda(lm) => lm,
            _           => none,
        }),
        .Return(r)   => load(r).match ({
            .Lambda(lm) => lm,
            _           => none,
        }),
        _            => none,
    })
}
// build the lifted call fn's params: `__clenv: __clos_K` then each lambda param typed from the FnT sig.
clos_call_params = (a: MutPtr<Malloc>, structn: string_view, lm: LambdaData, ft: FnTData) [Param] {
    ps := a.pbuf(lm.params.len + 1)
    ps[0] = param("__clenv", tnamed(structn))
    lm.params.loop((h, i, p) {
        ps[i + 1] = param(p.name, i < ft.params.len ? ft.params[i] : tvoid())
    })
    ps
}
// the closure struct's fields = the enclosing function's params (captured by value).
clos_struct_fields = (a: MutPtr<Malloc>, fps: [Param]) [Field] {
    fs := a.acquire(fps.len * sizeof(Field))
    out: [Field] := slice(fs, fps.len)
    fps.loop((h, i, p) {
        out[i] = field(p.name, p.ty)
    })
    out
}
// the closure literal's field inits = each captured param bound to its own current value.
clos_struct_inits = (a: MutPtr<Malloc>, fps: [Param]) [FieldInit] {
    map_slice(a, fps, (p) { finit(p.name, a.cenode(vref(p.name))) })
}
// rebuild the enclosing body with its tail lambda replaced by the closure struct literal.
clos_replace_tail = (a: MutPtr<Malloc>, body: [Stmt], mk: Ptr<Expr>) [Stmt] {
    buf := cbuf<Stmt>(a, body.len)
    body.loop((h, i, st) {
        buf[i] = i == body.len - 1 ? sret(mk) : st
    })
    buf
}
// does `f` return a capturing-over-params closure we can lower? (FnT return + tail lambda + it captures
// at least one param + it captures NOTHING but params).
clos_lowerable* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, f: Func) bool {
    f.ret.match ({
        .FnT(ft) => f.body.clos_tail_lambda().match ({
            true  => {
                lm := f.body.clos_tail_lam_of()
                cap := a.lift_liftable(decls, idx, lm) == false    // captures something
                bad := a.clos_bad_body(decls, idx, a.lift_lamparams(a.vnil(), lm.params), f.params, lm.body)
                cap && bad == false && f.params.len > 0
            },
            false => false,
        }),
        _        => false,
    })
}
// lower one function (caller checked clos_lowerable): emit the struct + call fn into `gen` (2 decls at
// 2*id and 2*id+1), bump the closure counter, and return the rewritten enclosing function (returns the
// struct by value; ret type becomes the closure struct).
clos_lower_func* = (a: MutPtr<Malloc>, ccp: RawPtr<u8>, gen: [Decl], f: Func) Decl {
    ft := f.ret.match ({
        .FnT(g) => g,
        _       => FnTData(
            params: no_tys(),
            ret: a.tnode(tvoid()),
        ),
    })
    lm := f.body.clos_tail_lam_of()
    id := load_i64(ccp)
    structn := a.clos_struct_name(id)
    calln := a.clos_call_name(structn)
    gen[(id * 2).to_i32()] = dstruct(StructDecl(
        name: structn,
        fields: a.clos_struct_fields(f.params),
        pos: 0,
    ))
    gen[(id * 2 + 1).to_i32()] = dfunc(Func(
        name: calln,
        params: a.clos_call_params(structn, lm, ft),
        ret: load(ft.ret),
        tparams: empty_params(),
        body: a.clos_sub_body(f.params, lm.body),
    ))
    store_i64(ccp, id + 1)
    mk := a.cenode(mkstruct(structn, a.clos_struct_inits(f.params)))
    dfunc(Func(
        name: f.name,
        params: f.params,
        ret: tnamed(structn),
        tparams: f.tparams,
        body: a.clos_replace_tail(f.body, mk),
        pos: f.pos,
    ))
}
