// helper/helper.zen
// The declaring module's view, not the reader's. `get_total` combines
// the two constants BELOW -- 20 and 3 -- and must answer 23 for any
// caller in any module. gen_c reads a constant's value "in the module
// that wrote it" (`plain_ctx(d.id.module)`), and main.zen's own WIDTH
// is the collision that sentence protects against.

WIDTH*: i64 = 20

HEIGHT*: i64 = 3

get_total* = () i64 { WIDTH + HEIGHT }
