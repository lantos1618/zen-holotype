// A qualified ctor keeps its dot on the SAME line as the type: `Res.Okv(41)` still parses as one
// expression (the total newline-break rule only fires across a line break).
Res: Okv(i32) | Nov
main = () i32 {
    x = Res.Okv(41)
    x.match ({
        .Okv(v) => v + 1,
        .Nov    => 7,
    })
}
