// Operator and delimiter scanning. Multi-byte operators use maximal munch,
// such as `::=` before `::` and `+%` before `+`.

TokenKind = std.lex.lex_token
Cursor = std.lex.lex_cursor

// Bytes that begin a punctuation token.
is_punct* = (b: u8) bool {
    b.is_in([
        '!', '%', '&', '(', ')', '*', '+', ',', '-', '.', '/',
        ':', ';', '<', '=', '>', '[', ']', '{', '|', '}',
    ])
}

// Consume one punctuation token, preferring its multi-byte form. None means
// the byte begins no token, and nothing is consumed.
punct_kind* = (cur :: Cursor, b: u8) Res<TokenKind> {
    b.match({
        '!' => Ok(cur.pair('=', TokenKind.BangEq, TokenKind.Bang)),
        '%' => Ok(cur.solo(TokenKind.Percent)),
        '&' => Ok(cur.pair('&', TokenKind.AmpAmp, TokenKind.Amp)),
        '(' => Ok(cur.solo(TokenKind.ParenOpen)),
        ')' => Ok(cur.solo(TokenKind.ParenClose)),
        '*' => Ok(cur.pair('%', TokenKind.StarWrap, TokenKind.Star)),
        '+' => Ok(cur.pair('%', TokenKind.PlusWrap, TokenKind.Plus)),
        ',' => Ok(cur.solo(TokenKind.Comma)),
        '-' => Ok(cur.pair('%', TokenKind.MinusWrap, TokenKind.Minus)),
        '.' => Ok(cur.dot_kind()),
        '/' => Ok(cur.solo(TokenKind.Slash)),
        ':' => Ok(cur.colon_kind()),
        ';' => Ok(cur.solo(TokenKind.Semicolon)),
        '<' => Ok(cur.pair('=', TokenKind.LtEq, TokenKind.Lt)),
        '=' => Ok(cur.equals_kind()),
        '>' => Ok(cur.pair('=', TokenKind.GtEq, TokenKind.Gt)),
        '[' => Ok(cur.solo(TokenKind.BracketOpen)),
        ']' => Ok(cur.solo(TokenKind.BracketClose)),
        '{' => Ok(cur.solo(TokenKind.BraceOpen)),
        '|' => Ok(cur.pair('|', TokenKind.BarBar, TokenKind.Bar)),
        '}' => Ok(cur.solo(TokenKind.BraceClose)),
        _   => None,
    });
}

solo = (cur :: Cursor, kind: TokenKind) TokenKind {
    cur.bump();
    kind
}

pair = (
    cur    :: Cursor,
    second : u8,
    both   : TokenKind,
    single : TokenKind
) TokenKind {
    cur.bump();
    cur.at_byte(second).match({
        true  => { cur.bump(); both },
        false => single,
    });
}

// `...` is variadic syntax; `..` remains two dot tokens.
dot_kind = (cur :: Cursor) TokenKind {
    (cur.at_byte(1, '.') && cur.at_byte(2, '.')).match({
        true  => { cur.bump(); cur.bump(); cur.bump(); TokenKind.Ellipsis },
        false => cur.solo(TokenKind.Dot),
    });
}

colon_kind = (cur :: Cursor) TokenKind {
    cur.at_byte(1, ':').match({
        false => cur.solo(TokenKind.Colon),
        true  => cur.at_byte(2, '=').match({
            true  => { cur.bump(); cur.bump(); cur.bump(); TokenKind.ColonColonEq },
            false => { cur.bump(); cur.bump(); TokenKind.ColonColon },
        }),
    });
}

equals_kind = (cur :: Cursor) TokenKind {
    cur.at_byte(1, '=').match({
        true  => { cur.bump(); cur.bump(); TokenKind.EqEq },
        false => cur.pair('>', TokenKind.Arrow, TokenKind.Eq),
    });
}
