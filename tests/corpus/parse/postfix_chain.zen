// method chains associate LEFT to RIGHT: n.double().inc().double()
// is ((n.double()).inc()).double().
// written with a binding, not `3.double()`, because `3.` is where a
// float literal would start -- see the report.

double = (n: i32) i32 { n * 2 }
inc = (n: i32) i32 { n + 1 }

main = (env: Env) Res<i32, ArgError> {
    n = 3;
    v = n.double().inc().double();
    println("{}", v);
    Ok(0);
}
