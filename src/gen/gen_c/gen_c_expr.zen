// src/gen/gen_c/gen_c_expr.zen
// What an expression is in C.
//
// Every lowering here has one shape: statements go to the backend's
// buffer, and the C EXPRESSION that names the result goes into the
// caller's buffer. `gen_c_stmt.zen` owns the other half — where that
// result ends up — and `gen_c_flow.zen` owns the two forms that cannot
// be C expressions at all.
//
// A SPILLING FORM WHERE C WANTS A VALUE IS PUT IN A TEMPORARY, which is
// the one thing this file does that is not a shape-for-shape
// translation. `deliver` hands a spilling form straight to its
// destination because a destination is already a place; an argument is
// not, so `spill_temp` makes one.
//
// WHICH IS WHY `spills` HAS TWO FORMS. `spills` asks whether a node IS
// a spill — `deliver`'s question. `spills_anywhere` asks whether one is
// hiding inside it, which is what short-circuiting needs, because a
// hoisted `.try()` runs whether or not the left side held.
// `gen_c_op.zen` owns that rule; this file owns the two questions.
//
// OPERATORS ARE `gen_c_op.zen`'S SUBJECT. `a + b` is not a shape, it is
// a decision about what is being added — a trap helper, an `Eq` impl,
// or plain C — and it left when this file outgrew its cap.
//
// SEMA IS THE ONLY SOURCE OF A TYPE. Where `type_of` answers, its
// answer is used; where it does not yet — a call, a match, a record —
// the CONTEXT's expected type is used, and where there is no
// expectation either, an `Untyped` fault is raised rather than a guess.

Ast, Expr, ExprKind, ExprId, BlockId, Block, Stmt, StmtKind, Bind = ast
Decl, DeclKind, Struct, Member, MemberKind, Const = ast
Literal, LiteralKind, BinOp, UnOp, Binary, Unary, Match, Arm = ast
Pattern, PatternKind, Access, Call, Arg, Span, Ident = ast
Param, TypeId = ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId, Ty, Types, TyNamed, TyRes, ResForm = sema.sema_ty
World, Def, DefKind, decl_at = sema.sema_def
Checker, Ctx = sema.sema_check
type_of, type_from_ast, stmt_type = sema.sema_type
write_usize = sema.sema_diag
Emit = gen.gen_emit
sym_local, sym_member, sym_variant, sym_gen, sym_fn = gen.gen_name
RES_PATH, is_failure = gen.gen_name
GenFault = gen.gen_diag
CBackend, LocalSlot = gen.gen_c.gen_c_state
sub, constructed, open = gen.gen_c.gen_c_mono
loop_result_type = gen.gen_c.gen_c_shape
unsupported, unresolved, untyped, ambiguous = gen.gen_c.gen_c_state
lower_match, lower_try = gen.gen_c.gen_c_flow
ctype, declarator, spellable, is_unit, c_prim = gen.gen_c.gen_c_type
is_c_integer, is_signed, variant_type, decl_ctx = gen.gen_c.gen_c_type
write_qname = gen.gen_c.gen_c_layout
lower_access, base_decl, type_const, TypeConst = gen.gen_c.gen_c_read
field_type, request_type = gen.gen_c.gen_c_type
Dest, deliver, write_dest = gen.gen_c.gen_c_stmt
plain_ctx = gen.gen_c.gen_c_decl
lower_call, res_value, is_res_ctor = gen.gen_c.gen_c_call
call_ret_type = gen.gen_c.gen_c_infer
lower_unary, lower_binary = gen.gen_c.gen_c_op
lower_index, index_type = gen.gen_c.gen_c_index
is_ptr_member, ptr_member_type = gen.gen_c.gen_c_ptr
field_of = gen.gen_c.gen_c_cap
inline_result_type = gen.gen_c.gen_c_settle
needs_fat, write_fat_value = gen.gen_c.gen_c_fat

// -----------------------------------------------------------------
// expressions
// -----------------------------------------------------------------

// Does this form need statements of its own? A spilling form may not
// appear where C wants a pure expression, and the two places that
// matters — the right operand of `&&` / `||`, and an argument — ask
// this first.
spills* = (be: CBackend, id: ExprId) bool {
    be.tree.expr_at(id).kind.match({
        Match(_) => true,
        Try(_)   => true,
        Block(_) => true,
        Paren(p) => spills(be, p.inner),
        _        => false,
    })
}

// Does lowering this expression need statements of its own ANYWHERE
// inside it?
//
// `spills` asks about the form ITSELF, which is `deliver`'s question: a
// form that is a spill goes straight to its destination. Short-circuit
// has the other question, because a `.try()` three parens deep still
// lowers to an `if` and a `return` and `expr` will hoist it out to
// where the operand was written.
//
// AN UNRECOGNISED FORM ANSWERS YES. Being wrong in this direction is a
// refusal with a position; being wrong in the other is a program that
// computes the wrong thing, which is the one outcome a backend may not
// produce.
spills_anywhere* = (be: CBackend, id: ExprId) bool {
    be.tree.expr_at(id).kind.match({
        Literal(_) => false,
        Name(_)    => false,
        Unit       => false,
        Paren(p)   => spills_anywhere(be, p.inner),
        Unary(u)   => spills_anywhere(be, u.operand),
        Binary(b)  => spills_anywhere(be, b.lhs) || spills_anywhere(be, b.rhs),
        Access(a)  => spills_anywhere(be, a.base),
        Index(x)   => spills_anywhere(be, x.base) || spills_anywhere(be, x.index),
        Call(c)    => call_spills(be, c),
        _          => true,
    })
}

call_spills = (be: CBackend, c: Call) bool {
    got ::= spills_anywhere(be, c.callee);
    c.args.loop((h, a) { got = got || spills_anywhere(be, a.value); });
    got
}

// The type of an expression.
//
// SEMA FIRST, ALWAYS. Where `type_of` answers, its answer is used and
// this file has no opinion. Where it does not — sema does not type a
// call yet, so it does not type a `.try()` on one either — the
// declaration behind the callee is read instead, which is the same
// "degrade to your own resolution when a query is absent" the
// bootstrapper's backend documents. The moment sema types a call, the
// fallback stops firing and nothing else changes.
// THE INSTANTIATION IS APPLIED HERE, once, so that no lowering rule has
// to remember to. Sema typed a generic body exactly once, generically —
// `sema_inst.zen` says why — so every answer inside `Vec<T>.add` is
// about `T`, and this is where it becomes the `i32` this emission is at.
ty_of* = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId)
         Res<TyId, AllocError> {
    local_answer(be, id).try().match({
        Ok(t) => Ok(t),
        None  => derived_answer(be, id, ctx, want),
    })
}

derived_answer = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId)
                 Res<TyId, AllocError> {
    ptr_answer(be, id, ctx, want).try().match({
        Ok(t) => Ok(t),
        None  => sema_answer(be, id, ctx, want),
    })
}

// THE FRAME THAT DECLARED A BINDING IS THE AUTHORITY ON ITS TYPE, and
// sema's memo is not — the memo is keyed by node id and nothing else,
// so an answer computed while `Vec<Diag>.get` was being lowered is the
// answer `Vec<TyId>.get` reads back. It emitted a call to the first
// one's symbol with the second one's receiver, which `cc` caught and
// which two types of one width would have hidden.
//
// A HANDLE AND A CLOSURE ARE NOT VALUES and have no type to give: `h`
// is a pair of labels and a lambda is a body to inline, so both are
// left to the paths that know what they are.
//
// AND A FIELD READ FROM ONE IS THE SAME RULE ONE NODE UP. `e.key`
// inside `Map<K, V>.confirms` is derived from `e`'s type and the
// declaration, both of which the frame holds — so the memo has nothing
// to add and one poisoned entry to give. Every instantiation of
// `confirms` in this compiler called `str.eq`, including the ones whose
// key is an `ExprId`, and swapping which map was built first swapped
// which `eq` all of them called.
local_answer = (be :: CBackend, id: ExprId) Res<Res<TyId>, AllocError> {
    be.tree.expr_at(id).kind.match({
        Name(n)   => Ok(named_slot(be, n.text)),
        Access(a) => field_slot(be, a),
        _         => Ok(None),
    })
}

field_slot = (be :: CBackend, a: Access) Res<Res<TyId>, AllocError> {
    local_answer(be, a.base).try().match({
        None  => Ok(None),
        Ok(b) => known_field(be, b, a.name.text),
    })
}

// A member that is not STORAGE has no answer here — a nullary variant,
// a constant on a type and a method are three other readings of the
// same node, and `gen_c_read.zen` owns all three.
known_field = (be :: CBackend, base: TyId, name: str)
              Res<Res<TyId>, AllocError> {
    field_of(be, base, name).try().match({
        None  => Ok(None),
        Ok(t) => Ok(keep_known(be, t)),
    })
}

named_slot = (be :: CBackend, name: str) Res<TyId> {
    be.slot_of(name).match({
        None  => None,
        Ok(s) => value_slot(be, s),
    })
}

value_slot = (be :: CBackend, s: LocalSlot) Res<TyId> {
    ((s.handle == 0) && (s.closure == 0)).match({
        false => None,
        true  => keep_known(be, s.ty),
    })
}

keep_known = (be :: CBackend, ty: TyId) Res<TyId> {
    (be.check.is_unknown(ty) || open(be, ty)).match({
        true  => None,
        false => Ok(ty),
    })
}

sema_answer = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId)
              Res<TyId, AllocError> {
    got = sub(be, be.check.type_of(id, ctx).try()).try();
    be.check.is_unknown(got).match({
        false => settled_answer(be, id, ctx, got),
        true  => fallback_type(be, id, ctx, want),
    })
}

// `Ptr`'S MEMBERS ARE THE BACKEND, so sema has no body to check for one
// and answers `p.to<u8>()` with a `Ptr` whose element nothing settled —
// an answer that is not unknown and carries no `Var`, so nothing
// downstream questions it. A LOCAL DECLARED AT THAT TYPE IS A C POINTER
// AT THE WRONG STRIDE: `src.back(8)` moved back thirty-two bytes,
// `realloc` read a length nobody wrote, and every row before the last
// grow was silently dropped. It compiled, and the differential oracle
// is what caught it.
//
// So the backend answers first for exactly these members, which is the
// same authority it already has over lowering them.
ptr_answer = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId)
             Res<Res<TyId>, AllocError> {
    be.tree.expr_at(id).kind.match({
        Call(c) => ptr_call_answer(be, c, ctx, want),
        _       => Ok(None),
    })
}

ptr_call_answer = (be :: CBackend, c: Call, ctx: Ctx, want: TyId)
                  Res<Res<TyId>, AllocError> {
    be.tree.expr_at(c.callee).kind.match({
        Access(a) => ptr_dot_answer(be, c, a, ctx, want),
        _         => Ok(None),
    })
}

ptr_dot_answer = (be :: CBackend, c: Call, a: Access, ctx: Ctx, want: TyId)
                 Res<Res<TyId>, AllocError> {
    unknown = be.check.types.unknown().try();
    rty = ty_of(be, a.base, ctx, unknown).try();
    is_ptr_member(be, rty, a.name.text).match({
        false => Ok(None),
        true  => ptr_answer_of(be, c, a, rty, ctx, want),
    })
}

ptr_answer_of = (be :: CBackend, c: Call, a: Access, rty: TyId, ctx: Ctx,
                 want: TyId) Res<Res<TyId>, AllocError> {
    Ok(Ok(ptr_member_type(be, c, a, rty, ctx, want).try()));
}

// AN OPEN TYPE IS NOT AN ANSWER. Sema types `range.loop(body)` as
// `Res<T>` because the only thing that could settle `T` is the closure,
// and a closure infers FROM a signature rather than into one — so the
// answer comes back carrying a `Var`, and a binding declared at it would
// be the one C type every loop in the program shares. The one form this
// happens to is the loop family, and `gen_c_loop.zen` owns the rule for
// it; everything else is handed back untouched.
settled_answer = (be :: CBackend, id: ExprId, ctx: Ctx, got: TyId)
                 Res<TyId, AllocError> {
    open(be, got).match({
        false => Ok(got),
        true  => settle_open(be, id, ctx, got),
    })
}

// The loop family first, then a callee that is inlined. Both answer the
// same shape of question — "sema left this open because only the closure
// could settle it" — and both have to answer BEFORE anything is written,
// because a match scrutinee's temporary is declared at this answer and
// filled by the lowering's.
settle_open = (be :: CBackend, id: ExprId, ctx: Ctx, got: TyId)
              Res<TyId, AllocError> {
    walked = loop_result_type(be, id, ctx, got).try();
    open(be, walked).match({
        false => Ok(walked),
        true  => settle_inlined(be, id, ctx, walked),
    })
}

// AND THEN THE CALL ITSELF. Sema types a generic call as its DECLARED
// return, and inside a member body nothing recorded an instantiation to
// close it — so a `.try()` on one lands in a temporary declared at
// `Res<q, E>`, which is a C struct with an unresolved element. The
// arguments say which instantiation it is; `gen_c_call.zen` asks them.
settle_inlined = (be :: CBackend, id: ExprId, ctx: Ctx, got: TyId)
                 Res<TyId, AllocError> {
    inlined = inline_result_type(be, id, ctx, got).try();
    open(be, inlined).match({
        false => Ok(inlined),
        true  => settle_call(be, id, ctx, inlined),
    })
}

// A `.try()` ON ONE IS THE SAME QUESTION ONE NODE UP. Sema types
// `f().try()` as the callee's declared `Ok` payload, which is the
// parameter itself when the callee is generic — so the operand is
// re-asked and the payload read off the answer.
settle_call = (be :: CBackend, id: ExprId, ctx: Ctx, got: TyId)
              Res<TyId, AllocError> {
    be.tree.expr_at(id).kind.match({
        Call(c)  => call_ret_type(be, id, c, ctx, got),
        Try(t)   => try_value_type(be, t.operand, ctx, got),
        Paren(p) => ty_of(be, p.inner, ctx, got),
        _        => Ok(got),
    })
}

fallback_type = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId)
                Res<TyId, AllocError> {
    be.tree.expr_at(id).kind.match({
        Call(c)  => call_type(be, c, ctx, want),
        Paren(p) => ty_of(be, p.inner, ctx, want),
        Try(t)   => try_value_type(be, t.operand, ctx, want),
        Index(x) => index_type(be, x, ctx, want),
        _        => Ok(want),
    })
}

// What a call evaluates to: the callee's declared return type, or the
// type it constructs.
call_type = (be :: CBackend, c: Call, ctx: Ctx, want: TyId)
            Res<TyId, AllocError> {
    be.tree.expr_at(c.callee).kind.match({
        Name(n) => named_call_type(be, n.text, ctx, want),
        _       => Ok(want),
    })
}

named_call_type = (be :: CBackend, name: str, ctx: Ctx, want: TyId)
                  Res<TyId, AllocError> {
    is_res_ctor(name).match({
        true  => Ok(want),
        false => declared_call_type(be, name, ctx, want),
    })
}

declared_call_type = (be :: CBackend, name: str, ctx: Ctx, want: TyId)
                     Res<TyId, AllocError> {
    found ::= be.alloc.Vec<Def>();
    be.check.world.defs_of(ctx.module, name, found).try();
    found.len.match({
        1 => def_call_type(be, found, want),
        _ => Ok(want),
    })
}

def_call_type = (be :: CBackend, found: Vec<Def>, want: TyId)
                Res<TyId, AllocError> {
    found.get(0).match({
        None  => Ok(want),
        Ok(d) => def_result_type(be, d, want),
    })
}

def_result_type = (be :: CBackend, d: Def, want: TyId)
                  Res<TyId, AllocError> {
    d.kind.match({
        FunctionDef => function_ret(be, d, want),
        StructDef   => struct_type(be, d),
        _           => Ok(want),
    })
}

struct_type = (be :: CBackend, d: Def) Res<TyId, AllocError> {
    constructed(be, d)
}

function_ret = (be :: CBackend, d: Def, want: TyId) Res<TyId, AllocError> {
    decl_at(be.tree, d.id).match({
        None  => Ok(want),
        Ok(x) => decl_ret(be, d, x, want),
    })
}

decl_ret = (be :: CBackend, d: Def, x: Decl, want: TyId)
           Res<TyId, AllocError> {
    ctx = Ctx(module: d.id.module.to_usize(), ret: TyId(index: 0),
              has_ret: false, self_ty: TyId(index: 0), has_self: false);
    x.kind.match({
        Function(f) => written_ret(be, f.ret, ctx, want),
        _           => Ok(want),
    })
}

written_ret = (be :: CBackend, ret: Res<TypeId>, ctx: Ctx, want: TyId)
              Res<TyId, AllocError> {
    ret.match({
        None  => Ok(want),
        Ok(t) => sub(be, be.check.type_from_ast(t, ctx).try()),
    })
}

// `.try()` evaluates to its operand's Ok payload.
try_value_type = (be :: CBackend, operand: ExprId, ctx: Ctx, want: TyId)
                 Res<TyId, AllocError> {
    unknown = be.check.types.unknown().try();
    rt = ty_of(be, operand, ctx, unknown).try();
    be.check.types.at(rt).match({
        Res(r) => Ok(r.value),
        _      => Ok(want),
    })
}

// The `Res` an expression is, when it is one. `.try()` and a `match`
// on a `Res` both need this and neither has a `want` that says it.
res_type_of* = (be :: CBackend, id: ExprId, ctx: Ctx)
               Res<TyId, AllocError> {
    unknown = be.check.types.unknown().try();
    ty_of(be, id, ctx, unknown)
}

// A SPILLING FORM WHERE C WANTS AN EXPRESSION IS SPILLED INTO A
// TEMPORARY, and that is the whole of it.
//
// `decls.add(p.declaration(true).try())` is an ordinary thing to write
// and `.try()` is an `if` and a `return`: there is no C expression for
// it. `deliver` hands a spilling form STRAIGHT to its destination
// because a destination is already a place — but an argument is not a
// place, so one is made here. The temporary is declared and filled
// BEFORE the statement being built, which is where every other spill in
// this backend already lands: `deliver_simple` builds the expression
// text first and writes the line after, so anything written while it
// builds comes out ahead of it.
// A CONCRETE VALUE REACHING A SLOT WHOSE TYPE IS A BOUND becomes a fat
// value, and this is the one place it happens: an argument, a field and
// a return all arrive here with the destination's type, so passing an
// `Arena` where an `Alloc` is wanted builds the record at all three
// without a rule at any of them.
expr* = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId, out :: String)
        Res<(), AllocError> {
    needs_fat(be, id, ctx, want).try().match({
        true  => fat_expr(be, id, ctx, want, out),
        false => value_expr(be, id, ctx, want, out),
    })
}

// The value AT ITS OWN TYPE, then the record over its address: lowering
// it at the bound would ask for a record that does not exist yet.
fat_expr = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId,
            out :: String) Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    cty = ty_of(be, id, ctx, unknown).try();
    code ::= be.alloc.String().try();
    value_expr(be, id, ctx, cty, code).try();
    write_fat_value(be, code.view(), cty, want, out)
}

value_expr = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId,
              out :: String) Res<(), AllocError> {
    spills(be, id).match({
        true  => spill_temp(be, id, ctx, want, out),
        false => write_expr(be, id, ctx, want, out),
    })
}

spill_temp = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId,
              out :: String) Res<(), AllocError> {
    ty = spill_type(be, id, ctx, want).try();
    settled_place(be, ty).match({
        false => unsupported(be, id, "a spilling form whose type nothing settles", out),
        true  => spill_settled(be, id, ctx, ty, out),
    })
}

// The type of the place the value lands in. The written expectation
// when there is one — "the destination's type wins" — and the
// expression's own answer when there is not.
spill_type = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId)
             Res<TyId, AllocError> {
    be.check.is_unknown(want).match({
        false => Ok(want),
        true  => ty_of(be, id, ctx, want),
    })
}

settled_place = (be :: CBackend, ty: TyId) bool {
    (be.check.is_unknown(ty) == false) && (open(be, ty) == false)
}

// A spilling form whose value is `()` has nothing to hold — a void
// temporary is illegal C — and it still RUNS: dropping it would drop
// the `.try()` that was the reason for writing it. `0` goes where the
// expression went, which is what the four report helpers write.
spill_settled = (be :: CBackend, id: ExprId, ctx: Ctx, ty: TyId,
                 out :: String) Res<(), AllocError> {
    is_unit(be, ty).match({
        true  => spill_effect(be, id, ctx, ty, out),
        false => spill_valued(be, id, ctx, ty, out),
    })
}

spill_effect = (be :: CBackend, id: ExprId, ctx: Ctx, ty: TyId,
                out :: String) Res<(), AllocError> {
    deliver(be, id, ctx, ty, Dest.Discard).try();
    out.add_bytes("0")
}

spill_valued = (be :: CBackend, id: ExprId, ctx: Ctx, ty: TyId,
                out :: String) Res<(), AllocError> {
    request_type(be, ty).try();
    tmp ::= be.alloc.String().try();
    sym_gen(tmp, "s", be.next_tmp()).try();
    line ::= be.alloc.String().try();
    declarator(be, ty, tmp.view(), line).try();
    line.add_bytes(";").try();
    be.writeln(line.view()).try();
    deliver(be, id, ctx, ty, Dest.Into(tmp.view())).try();
    out.add_bytes(tmp.view())
}

write_expr = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId,
              out :: String) Res<(), AllocError> {
    node = be.tree.expr_at(id);
    node.kind.match({
        Literal(l)  => lower_literal(be, id, l, ctx, want, out),
        Name(n)     => lower_name(be, id, n.text, ctx, want, out),
        Paren(p)    => lower_paren(be, p.inner, ctx, want, out),
        Unary(u)    => lower_unary(be, node, u, ctx, want, out),
        Binary(b)   => lower_binary(be, node, b, ctx, want, out),
        Access(a)   => lower_access(be, id, a, ctx, want, out),
        Call(c)     => lower_call(be, id, c, ctx, want, out),
        Index(x)    => lower_index(be, id, x, ctx, out),
        Unit        => out.add_bytes("0"),
        _           => unsupported(be, id, "this expression form", out),
    }).try();
    Ok(());
}


lower_paren = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId,
               out :: String) Res<(), AllocError> {
    out.add_bytes("(").try();
    expr(be, id, ctx, want, out).try();
    out.add_bytes(")").try();
    Ok(());
}

// A literal is its RAW source slice, and that is deliberate: Zen's
// escape set is `\n \t \r \0 \\ \' \"` and every one of those is a C
// escape with the same meaning, so the bytes travel unchanged. A `str`
// is not a `char *` though — it is a pointer and a length — so a
// string literal is built as one.
lower_literal = (be :: CBackend, id: ExprId, l: Literal, ctx: Ctx,
                 want: TyId, out :: String) Res<(), AllocError> {
    l.kind.match({
        Str   => lower_str_literal(be, l, out),
        Int   => out.add_bytes(l.text),
        Float => out.add_bytes(l.text),
        Char  => out.add_bytes(l.text),
        Bool  => out.add_bytes(l.text),
    }).try();
    Ok(());
}

lower_str_literal = (be :: CBackend, l: Literal, out :: String)
                    Res<(), AllocError> {
    out.add_bytes("(zg_str){ (unsigned char *)").try();
    out.add_bytes(l.text).try();
    out.add_bytes(", ").try();
    write_usize(out, decoded_len(l.text)).try();
    out.add_bytes("u }").try();
    Ok(());
}

// The byte length a string literal denotes: its raw slice without the
// quotes, with each escape counting once.
//
// `esc` is "the previous byte opened an escape", so the byte that
// closes one is not counted and the backslash that opened it is.
decoded_len* = (raw: str) usize {
    n ::= 0;
    esc ::= false;
    Range(1, quoted_end(raw)).loop((h, i) {
        (esc == false).then(() { n = n + 1; });
        esc = (esc == false) && (raw.index(i) == '\\');
    });
    n
}

quoted_end = (raw: str) usize {
    (raw.len > 1).match({ true => raw.len - 1, false => 1 })
}

// A bare identifier: a local, or a name the module declares. `None` is
// neither — it is a `Res` constructor, and `Res` is structural in this
// compiler's type language, so its constructors are too.
lower_name = (be :: CBackend, id: ExprId, text: str, ctx: Ctx, want: TyId,
              out :: String) Res<(), AllocError> {
    be.slot_of(text).match({
        Ok(slot) => write_local(be, text, slot, out),
        None     => lower_global_name(be, id, text, ctx, want, out),
    })
}

// A `::` parameter holds the ADDRESS of its argument, so reading it is
// a dereference. Parenthesised, because every use of it is a use of the
// value: `(*p).x` and `*p.x` are different C.
write_local = (be :: CBackend, text: str, slot: LocalSlot, out :: String)
              Res<(), AllocError> {
    slot.by_ref.match({
        false => sym_local(out, text, slot.index),
        true  => write_deref(be, text, slot, out),
    })
}

write_deref = (be :: CBackend, text: str, slot: LocalSlot, out :: String)
              Res<(), AllocError> {
    out.add_bytes("(*").try();
    sym_local(out, text, slot.index).try();
    out.add_bytes(")").try();
    Ok(());
}

lower_global_name = (be :: CBackend, id: ExprId, text: str, ctx: Ctx,
                     want: TyId, out :: String) Res<(), AllocError> {
    text.eq("None").match({
        true  => res_value(be, id, want, "None", out),
        false => lower_global_value(be, id, text, ctx, want, out),
    })
}

// A module-level constant, WRITTEN OUT AT EACH USE rather than emitted
// as a C object. DESIGN.md's `name: T = value` is immutable and has no
// address a program can take, so a use IS its value — and a `str`
// constant emitted as a C object would need a static initialiser, which
// is a second spelling of the same literal for no gain.
//
// A CONSTANT IS INLINED AT EACH USE, and that is sound exactly as far
// as its value is PURE. `I64_MIN` is `-9223372036854775807 - 1` and
// `UNRESOLVED` is `TyId(index: 0)`: evaluating either of those twice
// cannot be observed, and what it costs is a compound literal or an
// arithmetic the C compiler folds before it emits anything.
//
// ANYTHING ELSE IS STILL REPORTED, and the reason is the one this file
// always had: a constant whose value CALLS something would run that
// call once per use, and would stop being a constant. The restriction
// did not go away — it moved from "is a literal" to "cannot be observed
// twice", which is what it was always trying to say.
lower_global_value = (be :: CBackend, id: ExprId, text: str, ctx: Ctx,
                      want: TyId, out :: String) Res<(), AllocError> {
    found ::= be.alloc.Vec<Def>();
    be.check.world.defs_of(ctx.module, text, found).try();
    found.get(0).match({
        None  => unresolved(be, id, text, out),
        Ok(d) => lower_def_value(be, id, d, text, want, out),
    })
}

lower_def_value = (be :: CBackend, id: ExprId, d: Def, text: str,
                   want: TyId, out :: String) Res<(), AllocError> {
    d.kind.match({
        ConstDef => lower_const(be, id, d, text, want, out),
        _        => unresolved(be, id, text, out),
    })
}

lower_const = (be :: CBackend, id: ExprId, d: Def, text: str, want: TyId,
               out :: String) Res<(), AllocError> {
    decl_at(be.tree, d.id).match({
        None  => unresolved(be, id, text, out),
        Ok(x) => lower_const_decl(be, id, x, d, text, want, out),
    })
}

lower_const_decl = (be :: CBackend, id: ExprId, x: Decl, d: Def, text: str,
                    want: TyId, out :: String) Res<(), AllocError> {
    x.kind.match({
        Const(k) => lower_const_value(be, id, k, d, want, out),
        _        => unresolved(be, id, text, out),
    })
}

// The constant's DECLARED type wins over the context's: `USAGE: str` is
// a `str` wherever it is read, and a literal takes its width from the
// declaration that named it.
lower_const_value* = (be :: CBackend, id: ExprId, k: Const, d: Def,
                     want: TyId, out :: String) Res<(), AllocError> {
    dctx = plain_ctx(be, d.id.module.to_usize());
    ty = k.type.match({
        Ok(t) => be.check.type_from_ast(t, dctx),
        None  => Ok(want),
    }).try();
    is_pure_value(be, k.value, dctx).match({
        false => unsupported(be, id, "a constant whose value is not a literal", out),
        true  => expr(be, k.value, dctx, ty, out),
    })
}

// Can this expression be written twice without anyone being able to
// tell? A literal can; so can an operator over things that can, and so
// can a CONSTRUCTION of them — a compound literal names no function and
// reads nothing. A call to anything else cannot, and neither can a name,
// because a name is a local whose frame the use site is not in.
is_pure_value* = (be :: CBackend, id: ExprId, ctx: Ctx) bool {
    be.tree.expr_at(id).kind.match({
        Literal(_) => true,
        Unit       => true,
        Unary(u)   => is_pure_value(be, u.operand, ctx),
        Binary(b)  => is_pure_pair(be, b, ctx),
        Call(c)    => is_pure_construction(be, c, ctx),
        Access(a)  => is_pure_access(be, a, ctx),
        _          => false,
    })
}

// A NULLARY VARIANT AND A CONSTANT ON A TYPE are both values of a
// DECLARATION: neither names a function and neither reads a frame, so
// both can be written wherever they are read. A field access cannot —
// it reads a receiver.
is_pure_access = (be :: CBackend, a: Access, ctx: Ctx) bool {
    base_decl(be, a.base, ctx).match({
        Ok(_) => true,
        None  => has_type_const(be, a, ctx),
    })
}

has_type_const = (be :: CBackend, a: Access, ctx: Ctx) bool {
    type_const(be, a, ctx).match({
        Err(_) => false,
        Ok(r)  => found_const(r),
    })
}

found_const = (r: Res<TypeConst>) bool {
    r.match({ Ok(_) => true, None => false })
}

is_pure_pair = (be :: CBackend, b: Binary, ctx: Ctx) bool {
    is_pure_value(be, b.lhs, ctx) && is_pure_value(be, b.rhs, ctx)
}

// A call is pure only when its callee NAMES A TYPE: `TyId(index: 0)` is
// a compound literal, `first_of(v)` is a function this use site would
// run. The question is asked of the declaration and not of the spelling,
// which is the same question `gen_c_call.zen` asks to decide between the
// two readings of one node.
is_pure_construction = (be :: CBackend, c: Call, ctx: Ctx) bool {
    names_a_struct(be, c.callee, ctx) && pure_args(be, c, ctx)
}

pure_args = (be :: CBackend, c: Call, ctx: Ctx) bool {
    every ::= true;
    c.args.loop((h, a) {
        impure = is_pure_value(be, a.value, ctx) == false;
        impure.then(() { every = false; });
    });
    every
}

names_a_struct = (be :: CBackend, callee: ExprId, ctx: Ctx) bool {
    be.tree.expr_at(callee).kind.match({
        Name(n) => struct_named(be, n.text, ctx),
        _       => false,
    })
}

struct_named = (be :: CBackend, text: str, ctx: Ctx) bool {
    found ::= be.alloc.Vec<Def>();
    be.check.world.defs_of(ctx.module, text, found).match({
        Err(_) => false,
        Ok(_)  => sole_struct(found),
    })
}

sole_struct = (found: Vec<Def>) bool {
    found.get(0).match({
        None  => false,
        Ok(d) => is_struct_def(d),
    })
}

is_struct_def = (d: Def) bool {
    d.kind.match({ StructDef => true, _ => false })
}
