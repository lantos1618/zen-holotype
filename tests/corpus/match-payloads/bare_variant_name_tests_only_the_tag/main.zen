// A BARE VARIANT NAME TESTS ONLY THE TAG, on an enum whose OTHER variant
// carries the payload. Read as a binder over the whole scrutinee (the
// reading where every name in a pattern binds), `Bare` matches EVERYTHING:
// it swallows `Carry(5000000000)`, and "carried" never prints. Sema's own
// comment says a bare name is a tag test; this pins that codegen agrees,
// because the two reach the same table separately and nothing ties them.
//
// The enum is written with the payload variant SECOND so declaration order
// cannot rescue a tag read off the wrong index, and the Err arm pins the
// same distinction on the structural type, whose variants are read off its
// FORM rather than any declaration.

Carry = Bare | Carry(i64)

main = (env: Env) Res<i32, AllocError> {
    c1: Carry = Carry.Bare;
    c2: Carry = Carry.Carry(5000000000);
    c1.match({
        Bare     => println("bare"),
        Carry(v) => println("carried {}", v),
    });
    c2.match({
        Bare     => println("bare"),
        Carry(v) => println("carried {}", v),
    });
    e: Res<u8, str> = Err("boom");
    e.match({
        Ok(_)  => println("was ok"),
        Err(s) => println("err {}", s),
    });
    Ok(0);
}
