// tests/corpus/std/vec_get_out_of_range_is_none.zen
// out of range is None, not a trap: a lookup that can legitimately
// miss is not a bug. len itself is out of range - the off-by-one
// that a `<=` in get would let through

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    v ::= alloc.Vec<i32>();
    v.add(7).try();

    v.get(0).match({
        Ok(n) => println("in range {}", n),
        None  => println("in range none"),
    })
    v.get(1).match({
        Ok(n) => println("at len {}", n),
        None  => println("at len none"),
    })
    v.get(99).match({
        Ok(n) => println("past len {}", n),
        None  => println("past len none"),
    })
    Ok(0);
}
