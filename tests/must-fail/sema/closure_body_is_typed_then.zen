// A CLOSURE BODY IS TYPED THROUGH EVERY CALL SHAPE, not only through a
// resolved candidate. `Bool.then` is std's if: its argument is a
// zero-argument lambda and the callee is a member the signature table
// answers with — the `sig_ret` path this fix added — so before the walk
// entered bodies here too, `y: i32 = true` inside it compiled, ran, and
// printed the same 1 nobody wrote that `.loop` printed.
//
// position: the value that does not fit the annotation.

main = (env: Env) Res<i32, AllocError> {
    total = 1;
    (total > 0).then(() {
        y: i32 = true;
        println("{}", y);
    });
    Ok(0);
}
