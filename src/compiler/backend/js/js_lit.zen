// The JS escape (`jesc_byte`) is intentionally distinct from the C backend's (JS uses `\n`/`\"`, and
// strings are interned via `__zr.str`), so this family lives here beside js, not in c_lit.
{ String } = std.text.string
{ dec_digit } = compiler.astops
{ Allocator } = std.mem.alloc
{ escape_into } = std.text.ascii    // the shared scan-and-emit loop; the JS escape TABLE stays here
// The non-negative recursion is the shared String.add_i64; only the JS-specific minus-sign
// wrapper stays here. `jint_neg` walks negatives directly so INT64_MIN doesn't overflow on `0 - n` —
// this is why the negative path cannot use add_i64 after negation.
jint* = (s: String, a: Allocator, n: i64) String {
    (n < 0).then({ s.add("-").jint_neg(a, n) }, { s.add_i64(n) })
}
// walk negatives directly so INT64_MIN doesn't overflow on `0 - n`
jint_neg = (s: String, a: Allocator, n: i64) String {
    (n > 0 - 10).match ({
        true  => s.add_one(dec_digit(0 - n)),
        false => {
            hs = s.jint_neg(a, n / 10)
            hs.add_one(dec_digit(0 - n % 10))
        },
    })
}
// Zen names that are JS reserved words get a `$` suffix. Field/property names are not mangled.
js_is_reserved = (n: StringView) bool {
    n == "default"
        || n == "new"
        || n == "class"
        || n == "function"
        || n == "var"
        || n == "let"
        || n == "const"
        || n == "this"
        || n == "null"
        || n == "delete"
        || n == "in"
        || n == "instanceof"
        || n == "typeof"
        || n == "void"
        || n == "with"
        || n == "super"
        || n == "enum"
        || n == "export"
        || n == "import"
        || n == "extends"
        || n == "switch"
        || n == "case"
        || n == "yield"
        || n == "await"
        || n == "debugger"
        || n == "finally"
}
jname* = (s: String, a: Allocator, n: StringView) String {
    js_is_reserved(n).then({ s.add(n).add("$") }, { s.add(n) })
}
// ── JS string-literal escaping (byte by byte to the NUL) ──────────────────────────────────────────
jesc_byte = (s: String, ap: MutPtr<Allocator>, b: u8) String {
    a = load(ap)
    (b == '"').then({
        return s.add("\\\"")
    })
    (b == '\\').then({
        return s.add("\\\\")
    })
    (b == '\n').then({
        return s.add("\\n")
    })
    (b == '\r').then({
        return s.add("\\r")
    })
    (b == '\t').then({
        return s.add("\\t")
    })
    s.add_one(b)
}
jstrlit* = (s: String, a: Allocator, v: StringView) String {
    s.add("__zr.str(\"").escape_into(a.addr(), v, jesc_byte).add("\")")
}
