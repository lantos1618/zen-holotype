// tests/corpus/std/loop_while_true_breaks.zen
// the bare loop is while-true: the body is a stack closure, and
// h.break is the only way out. break is the same non-local exit
// as .try(), so a non-escaping body may return through its caller

main = (env: Env) Res<i32, AllocError> {
    i ::= 0;
    loop((h) {
        i = i + 1;
        println("i {}", i);
        (i == 3).then(() { h.break() });
    });
    println("after {}", i);
    Ok(0);
}
