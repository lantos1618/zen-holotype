// AN ASSOCIATED FUNCTION AND A SAME-NAMED FREE FUNCTION LIVE IN DIFFERENT
// NAMESPACES: `make()` with no receiver answers the module's own free
// function; `W.make()` names the struct body's member, which constructs a
// W. One name, two spellings, no collision and no confusion.
//
// DESIGN.md puts associated functions in the type's namespace ("a struct
// body may bind a function, read as `Type.name(..)`"), which is why the
// constructor form exists at all -- `seconds(n: u64) Duration` must not
// land on every u64. The wrong implementation files both under one flat
// name table: then either the bare call grabs the associated function (a
// W where an i32 belongs -- a compile error at best), or `W.make()` finds
// the free function (an i32 where a W belongs -- here a truncated value
// that still prints). Each line pins one namespace.
//
// Breaks if: the two forms share a candidate pool -- one line answers the
// other's body (7/42 swap or a wrong-typed read).

W = {
    v: i32,
    make = () W { W(v: 42) }
}

make = () i32 { 7 }

main = (env: Env) Res<i32, AllocError> {
    println("free {}", make());
    w = W.make();
    println("assoc {}", w.v);
    Ok(0);
}
