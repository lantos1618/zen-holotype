// Inspect C emitted for the bodyless loop intrinsics. The fixture covers an
// inferred `Res<T>`, mutation from a while body, distinct range index/value,
// value-carrying break, and next. The harness runs this inspector rather than
// the program it emits, so assertions are properties of the generated C.

Alloc, AllocError = std.mem
str, String = std.text
Vec = std.collections
Source, scan = std.lex
Parser = std.parse.parser
module = std.parse.parse_decl
Ast = std.ast.ast_arena
Checker = sema.sema_check
Emit = gen.gen_emit
CBackend, emit_program = gen.gen_c

// Four traversal shapes, each written so a wrong lowering
// shows in the C: a non-zero-based range, a condition whose variable
// the body stores through, a `break` that carries a value, and a
// `next` that skips the rest of a pass.
PROGRAM : str = "LoopHandle = {}\nRange<T> = { start: usize, end: usize }\nloop = <R, T>(range: R, body: (h: LoopHandle, value: T) ()) Res<T>\nwhile_ = <T>(cond: () bool, body: (h: LoopHandle) ()) Res<T>\nmain = (env: i32) Res<i32> {\n    Range<usize>(start: 10, end: 13).loop((h, v) { });\n    i ::= 0;\n    while_(() { i < 3 }, (h) { i = i + 1; });\n    got = Range<usize>(start: 0, end: 10).loop((h, v) { (v == 3).match({ true => h.break(v), false => () }) });\n    Range<usize>(start: 0, end: 4).loop((h, v) { (v == 1).match({ true => h.next(), false => () }) });\n    Ok(0)\n}\n"

emit = (a: Alloc, text: str, faults :: String) Res<String, AllocError> {
    lexed = scan(a, Source(file: "main.zen", text: text)).try();
    p ::= a.Parser(lexed);
    m = p.module("main").try();
    p.tree.add_module(m).try();
    chk ::= a.Checker(p.tree).try();
    be  ::= a.CBackend(p.tree, chk).try();
    out ::= a.Emit().try();
    be.emit_program(0, out).try();
    be.render_diags(faults).try();
    kept ::= a.String().try();
    kept.add(out.view()).try();
    Ok(kept);
}

main = (env: Env) Res<i32, AllocError> {
    alloc  ::= env.mem.alloc();
    faults ::= alloc.String().try();
    c = emit(alloc, PROGRAM, faults).try();

    println("nothing was refused: {}", faults.is_empty());

    // Four loops produce four `while`/`for` heads.
    // A shape that fell through to the general call path would emit a
    // call to a symbol nothing defines instead.
    println(
        "loop heads: {}",
        c.view().count("while (") + c.view().count("for (;;) {")
    );
    // Only h.break(v) and the condition guard need completion labels.
    // Each contributes its jump and definition; natural ends need neither.
    println("break label mentions: {}", c.view().count("zg_brk"));

    // Handle control targets its own loop even through an inlined match
    // or nested loop, so these explicit exits use their generated labels.
    println("continue label used: {}", c.view().count("goto zg_cnt") == 1);
    println("no C break statement: {}", c.view().count(" break;") == 0);

    // the erased loop type never reaches a declaration
    println("no erased Res reached the C: {}", c.view().count("3ResI1_q") == 0);

    // `i` is declared ONCE. A store lowered as a declaration would give
    // the second one a shadow number, and the condition would read the
    // first one forever.
    println(
        "the stored local is declared once: {}",
        c.view().count("zu_l1i_2") == 0
    );

    // `value` is the element and not the pass count: over Range(10, 13)
    // the walk starts at 10, which only a `start`-seeded counter does.
    println(
        "the walk is seeded from start: {}",
        c.view().count("zu_m5start") > 0
    );
    Ok(0);
}
