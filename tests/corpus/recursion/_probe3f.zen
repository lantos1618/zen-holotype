Link = {
    value: i64,
    next: Ptr<Link>,
}

build = (alloc: Alloc, n: i64) Res<Link, AllocError> {
    (n <= 0).match({
        true  => Ok(Link(value: 1000, next: null_ptr<Link>())),
        false => {
            cell = alloc.create<Link>().try();
            inner = build(alloc, n - 1);
            cell.write(0, inner.match({
                Ok(h)  => h,
                Err(_) => Link(value: -1, next: null_ptr<Link>()),
            }));
            Ok(Link(value: n * 10, next: cell));
        },
    });
}

sum = (node: Link) i64 {
    node.next.is_null().match({
        true  => node.value,
        false => node.value + sum(node.next.read(0)),
    });
}

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    println("{}", sum(build(alloc, 5).try()));
    Ok(0);
}
