// `(x) < y` is a comparison, not a generic function type.
//
// `lambda_ahead` asked whether a TYPE could begin after the matching
// `)`, and `<` can: `<T>(a: T) T` is the one type that starts with a
// bar-less angle. So `(i + 1) < f.len` in src/std/text/text_fmt.zen was
// read as a lambda whose parameters are `(i + 1)` and whose return type
// is a generic function type, and the parser then wanted a parameter
// name at `f`.
//
// `(x + 1) == y` never broke, which is the tell: `==` cannot start a
// type and `<` can. A lambda whose RETURN TYPE is a generic function
// type does not occur in this language's own source or in DESIGN.md;
// a parenthesised comparison occurs constantly.

lt = (a: usize, b: usize) bool { (a) < b }

// the same shape one operator up, which never broke, kept beside it so
// the pair is one test
eq = (a: usize, b: usize) bool { (a + 1) == b }

main = (env: Env) Res<i32, ArgError> {
    lt(1, 2).match({
        true  => println("less"),
        false => println("not less"),
    });
    eq(1, 2).match({
        true  => println("equal"),
        false => println("not equal"),
    });
    Ok(0);
}
