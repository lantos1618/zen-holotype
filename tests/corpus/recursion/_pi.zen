// probeI: same shape, no recursion -- is it println-arg lowering or the recursion?
Noisy = {
    env: Env,
    tag: str,
}

Noisy.impl(Drop, {
    drop = (self :: @Self) () { self.env.out.println("drop {}", self.tag) }
})

three = (env: Env) i64 {
    f = Noisy(env: env, tag: "f");
    3
}

main = (env: Env) Res<i32, IoError> {
    println("chain {}", three(env));
    Ok(0);
}
