// src/sema/sema_union.zen
// The union reading of `A | B`, which sema did not have at all.
//
// DESIGN.md: "`A | B` is a union of existing types when EVERY variant
// names a type in scope, and a nominal enum otherwise." The C backend
// decided that (`union_reading` in `gen_c_type.zen`); sema decided
// nothing, so `WriteError = IoError | AllocError` was a nominal enum of
// two bare tags and an `AllocError` value wasn't a member of it — every
// "no implicit error conversion: expected WriteError, found
// AllocError" in the corpus was that hole, a SET the checker never
// built (the store already knew how: `union_ty` canonicalises,
// `set_within` answers containment — nothing built one for a NAME).
//
// THE SET IS RECORDED BESIDE THE NAMED TYPE, NOT IN PLACE OF IT.
// Answering `Ty.Union` for `WriteError` follows DESIGN.md's alias rule
// and was tried first: it type-checks but emits C that doesn't compile
// (`gen_c_type.zen:62` has no `Ty.Union` arm, falls to `_ => "int"`,
// hands a struct-typed `Res` error member an `int`). The backend
// represents a set as the DECLARED enum named by its carried types, so
// taking the name away takes the representation with it; recording the
// set against the name keeps both.
//
// THE QUESTION IS ABOUT THE DECLARATION, NOT ONE VARIANT: a sixty-
// variant `TokenKind` with one `Eq` would grow a payload nobody wrote,
// so one non-type-name variant settles the whole declaration.

Decl, Enum, Variant = std.ast
AllocError = std.mem
Vec = std.collections
str = std.text
Range = std.core
DeclId = sema.sema_id
TyId, TyNamed = sema.sema_ty
Def, decl_at = sema.sema_def
Checker = sema.sema_check

// What a written name denotes, plus the set it stands for when it
// stands for one. The type is still the same `Ty.Named` — only the
// answer to "is this set contained in that one" changed.
named_or_union* = (c :: Checker, d: Def, args: Vec<TyId>)
                  Res<TyId, AllocError> {
    id = c.types.named(d.id, d.qname, d.name, args).try();
    c.record_set(id, d.id).try();
    Ok(id);
}

// Nothing to do twice, nothing to do for a nominal enum. A hit is
// either the finished set or the seed of one being computed — either
// way this walk is already under way somewhere below.
record_set = (c :: Checker, id: TyId, decl: DeclId) Res<(), AllocError> {
    c.set_memo.get(id).match({
        Ok(_) => Ok(()),
        None  => c.record_if_union(id, decl),
    })
}

record_if_union = (c :: Checker, id: TyId, decl: DeclId)
                  Res<(), AllocError> {
    c.union_reading(decl).match({
        false => Ok(()),
        true  => c.compute_set(id, decl),
    })
}

// Seeded with the name's own id before the walk, like `compute_type`
// seeds poison and for the same reason: a member is resolved through
// `named_or_union` too, so `A = A | B` wouldn't otherwise stop. A set
// that contains itself falls back to nominal — no member rather than an
// infinite one.
compute_set = (c :: Checker, id: TyId, decl: DeclId) Res<(), AllocError> {
    c.set_memo.set(id, id).try();
    members ::= c.alloc.Vec<TyId>();
    collect_members(c, decl, members).try();
    set = c.types.union_ty(members).try();
    c.set_memo.set(id, set).try();
    Ok(());
}

collect_members = (c :: Checker, decl: DeclId, out :: Vec<TyId>)
                  Res<(), AllocError> {
    decl_at(c.tree, decl).match({
        None  => Ok(()),
        Ok(d) => c.decl_members(decl, d, out),
    })
}

decl_members = (c :: Checker, decl: DeclId, d: Decl, out :: Vec<TyId>)
               Res<(), AllocError> {
    d.kind.match({
        Enum(e) => c.enum_members(decl, e, out),
        _       => Ok(()),
    })
}

// A member that is ITSELF a set contributes its members, not its name:
// `set_of` hands back what `union_ty` flattened, so `Error = WriteError
// | FsError` is one set of however many, and containment is answered
// without knowing how it was spelled.
enum_members = (c :: Checker, decl: DeclId, e: Enum, out :: Vec<TyId>)
               Res<(), AllocError> {
    e.variants.loop((h, v) {
        out.add(member_type(c, decl, v.name.text).try()).try();
    });
    Ok(());
}

// The type a bare variant name denotes, resolved in the module that
// DECLARES the enum: `WriteError = IoError | AllocError` means those two
// as `std.core.io` sees them; law 6 says the name crossing a boundary is
// `WriteError`, never its members. A miss is unreachable (`union_reading`
// already found a type under every name), so this poisons, not reports.
//
// NAME vs FLATTENED SET are two different answers: building the set
// wants the flattening, MATCHING wants the name — `sema_case.zen` asks
// what a variant CARRIES and gen_c's `union_member_type` gives it the
// named type, so an arm's binder must be that same type or sema checks
// one and the backend emits another.
union_member* = (c :: Checker, decl: DeclId, name: str)
                Res<TyId, AllocError> {
    found ::= c.alloc.Vec<Def>();
    c.world.defs_of(decl.module.to_usize(), name, found).try();
    found.get(0).match({
        None  => c.types.unknown(),
        Ok(d) => c.member_named(d),
    })
}

member_named = (c :: Checker, d: Def) Res<TyId, AllocError> {
    empty ::= c.alloc.Vec<TyId>();
    c.named_or_union(d, empty)
}

// THE LOOKUP IS NAMED BEFORE IT IS ASKED ABOUT. Written as one expression
// -- `set_of(union_member(..))` -- the receiver is read before the call
// beside it records the member's set, so the flattening answered from a
// checker that had not seen it yet: `Error = AllocError | WriteError` froze
// with the bare name `WriteError` in it, while `WriteError` on its own
// expanded to `IoError | AllocError` as it should. Containment then asked
// whether `IoError` was a member of {WriteError, AllocError} and said no,
// on a program whose declared set names WriteError. Only declaration order
// decided it: any earlier function returning `Res<_, WriteError>` recorded
// the set first and the same program compiled.
member_type = (c :: Checker, decl: DeclId, name: str) Res<TyId, AllocError> {
    id = c.union_member(decl, name).try();
    Ok(c.set_of(id));
}

// The value `Type.NAME` leaves unwritten: what a union's member carries,
// or poison when `ty` isn't a union or `name` isn't one of its members.
// Poison and not a `bool`, since the diagnostic must NAME the missing
// type and the answer is already in hand.
//
// Settled by the DECLARATION, like `union_reading`: every variant of a
// union names a type, so every member carries one. A nominal enum
// answers poison here even for a payload variant — `Slot.Left` is the
// function that builds one, and a function is a value.
union_carrier* = (c :: Checker, ty: TyId, name: str) Res<TyId, AllocError> {
    c.types.at(ty).match({
        Named(n) => named_carrier(c, n, name),
        _        => c.types.unknown(),
    })
}

named_carrier = (c :: Checker, n: TyNamed, name: str) Res<TyId, AllocError> {
    (c.union_reading(n.decl) && c.variant_named(n.decl, name)).match({
        true  => c.union_member(n.decl, name),
        false => c.types.unknown(),
    })
}

// Against the DECLARED variants, not `defs_of` (which would answer for
// any type the declaring module can see): `Error.Vec` names no member of
// `Error = AllocError | IoError`, and a lookup that found `Vec` anyway
// would report the wrong mistake.
variant_named = (c :: Checker, decl: DeclId, name: str) bool {
    decl_at(c.tree, decl).match({
        None  => false,
        Ok(d) => decl_names_variant(d, name),
    })
}

decl_names_variant = (d: Decl, name: str) bool {
    d.kind.match({
        Enum(e) => enum_names_variant(e, name),
        _       => false,
    })
}

enum_names_variant = (e: Enum, name: str) bool {
    Range(0, e.variants.len).find((i) {
        e.variants.get(i).match({
            None  => false,
            Ok(v) => v.name.text.eq(name),
        })
    }).match({ Ok(_) => true, None => false })
}

// -----------------------------------------------------------------
// which reading applies
//
// Below here is `gen_c_type.zen`'s decision, asked of a `Checker`
// rather than a `CBackend`. THE TWO MUST AGREE, or sema checks one type
// and the backend emits another — this compiler's worst failure class —
// so this mirrors it rather than improving on it, down to answering
// "not a union" when a lookup runs out of memory (the reading that
// invents no member).
// -----------------------------------------------------------------

union_reading* = (c :: Checker, decl: DeclId) bool {
    decl_at(c.tree, decl).match({
        None  => false,
        Ok(d) => c.enum_union_reading(decl, d),
    })
}

enum_union_reading = (c :: Checker, decl: DeclId, d: Decl) bool {
    d.kind.match({
        Enum(e) => c.no_nominal_variant(decl, e),
        _       => false,
    })
}

// Fewer than two variants is nominal whatever the name means: a union of
// one existing type IS that type, and DESIGN.md spells that without a
// bar — `X = | Foo` was written with the bar on purpose.
no_nominal_variant = (c :: Checker, decl: DeclId, e: Enum) bool {
    (e.variants.len < 2).match({
        true  => false,
        false => c.every_variant_named(decl, e),
    })
}

// Looks for the counterexample and reports its absence: the scan stops
// at the first variant that isn't a bare type name — normally the first
// one, for a nominal enum.
every_variant_named = (c :: Checker, decl: DeclId, e: Enum) bool {
    Range(0, e.variants.len).find((i) {
        e.variants.get(i).match({
            None  => true,
            Ok(v) => !names_a_type(c, decl, v),
        })
    }).match({ Ok(_) => false, None => true })
}

// A written payload means the variant isn't a bare name, so the union
// reading is already out — `Shape = Circle(Circle) | Unit` is nominal
// however many of its names are also types.
names_a_type = (c :: Checker, decl: DeclId, v: Variant) bool {
    v.payload.match({
        Ok(_) => false,
        None  => c.defs_named(decl, v.name.text),
    })
}

defs_named = (c :: Checker, decl: DeclId, name: str) bool {
    found ::= c.alloc.Vec<Def>();
    c.world.defs_of(decl.module.to_usize(), name, found).match({
        Err(_) => false,
        Ok(_)  => found.len > 0,
    })
}
