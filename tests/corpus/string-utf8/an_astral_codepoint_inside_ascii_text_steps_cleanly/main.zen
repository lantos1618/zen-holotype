// One astral (4-byte) codepoint between two ASCII letters. The cursor
// must step over all four bytes and land exactly on the 'y': 120, then
// 128512, then 121 -- with `at` at 6 and is_done true after the third
// decode. A decoder that miscounted the trailing ASCII's offset would
// still print plausible numbers here; the explicit `at 6` and the
// done-flag are what catch it.
Utf8Error = std.text.text_utf8

main = (env: Env) Res<i32, Utf8Error> {
    s = "x😀y";
    println("len {}", s.len);
    walk ::= s.codepoints();
    first ::= walk.next().try();
    second ::= walk.next().try();
    third ::= walk.next().try();
    println("{} {} {}", first, second, third);
    println("at {} done {}", walk.at, walk.is_done());
    Ok(0);
}
