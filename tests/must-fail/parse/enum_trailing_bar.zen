// variants are `|`-separated, so the trailing-separator mistake is a
// trailing BAR, not a trailing comma. (the fixture this replaces was
// written against the old comma syntax and contained no trailing comma
// at all, so it asserted an error on a legal program.)
//
// the enum is LAST on purpose. a declaration does not terminate and
// nothing is newline-sensitive, so a trailing bar followed by another
// declaration swallows that declaration's name as a variant -- see
// enum_trailing_bar_swallows. at end of file there is nothing left to
// swallow, so the bar is the mistake and the diagnostic says so there.
main = (env: Env) Res<i32, ArgError> {
    Ok(0);
}

