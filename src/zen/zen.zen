// src/zen/zen.zen
// The CLI, and the folder's surface.
//
// `main` reads the command line, picks a command, and returns its exit code.
// Everything a
// command does is one call away in a sibling, since the compiler is a
// library from commit one — `zen build`/`fmt`/`lsp`/`test` are entry
// points into one artifact, never four programs.
//
// The folder also provides the public CLI surface imported by corpus tests.

Alloc, AllocError = std.mem
str, String = std.text
FsError = std.env
BuildArgs, ProjectArgs = std.build

Cli*, FmtJob*, cli*, USAGE* = zen.zen_cli
Build* = zen.zen_build
fs_message* = std.env
Unit* = zen.zen_path
std_root_for = zen.zen_path
build* = zen.zen_run
project = zen.zen_project
format* = zen.zen_fmt
Server, serve, serve_stdio = lsp

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    cli(env, env.argv).try().match({
        Build(job)    => build_cli(env, alloc, job),
        Project(job)  => project_cli(env, alloc, job, false),
        Run(job)      => project_cli(env, alloc, job, true),
        Fmt(job)      => format(env, alloc, job),
        Later(name)   => later(env, alloc, name),
        Usage(word)   => usage(word),
        Missing(flag) => missing(flag),
    })
}

// The CLI parser borrows most project arguments from Env, but an inferred
// stdlib root is assembled in its scratch arena. Copy it into main's arena
// before the build starts so the project never observes a dangling path.
project_cli = (env: Env, a: Alloc, job: ProjectArgs, execute: bool)
              Res<i32, AllocError> {
    std_root ::= a.String("{}", std_root_for(env, a)).try();
    configured = ProjectArgs(
        root: job.root,
        target: job.target,
        std_root: std_root.view(),
        argv: job.argv,
        args_at: job.args_at
    );
    project(env, a, configured, execute)
}

build_cli = (env: Env, a: Alloc, job: BuildArgs) Res<i32, AllocError> {
    job.std_root.is_empty().match({
        false => build(env, a, job),
        true  => {
            std_root ::= a.String("{}", std_root_for(env, a)).try();
            configured = BuildArgs(
                root: job.root,
                emission: job.emission,
                entry: job.entry,
                std_root: std_root.view(),
                symbol_map: job.symbol_map,
                ffi: job.ffi,
                repeat: job.repeat,
                permute: job.permute
            );
            build(env, a, configured)
        },
    })
}

// A command this compiler will have and does not yet — except `lsp`,
// which now has a server behind it, reached from here.
//
// DISPATCH ON THE NAME, NOT A NEW `Cli` VARIANT: `zen_cli.zen` decides
// what a command line MEANS, and `lsp` doesn't yet take a flag/root/
// `--entry` for it to decide about. Once `zen lsp` takes arguments,
// the variant belongs there and this branch goes.
later = (env: Env, alloc: Alloc, name: str) Res<i32, AllocError> {
    name.eq("lsp").match({
        true  => lsp(env, alloc),
        false => not_yet(name),
    })
}

not_yet = (name: str) Res<i32, AllocError> {
    println(
        "zen {}: not yet — see docs/PLAN.md for the stage it arrives at",
        name
    );
    Ok(2);
}

// `zen lsp` — the language server over stdin and stdout, what an editor
// launches and the only thing it can launch.
//
// `zen lsp <requests> <replies>` runs the same server over two files for
// deterministic transport tests. Both forms reach lsp_serve.
//
// NO FLAGS, NO `--entry` (design_lsp.md §4): a root is discovered from
// `initialize`'s `rootUri`, and the driver already probes when no
// entry is named.
//
// `--stdio` is accepted for editor clients that append an explicit transport
// flag even when the server supports only standard I/O.
lsp = (env: Env, a: Alloc) Res<i32, AllocError> {
    from = file_arg(env, 2);
    to   = file_arg(env, 3);
    from.is_empty().match({
        true  => serve_stdio(env, a),
        false => paired(env, a, from, to),
    })
}

// One path, not two, means the caller meant to name both: the file
// form answers INTO a file, so `zen lsp requests.txt` with nowhere to
// write would run a whole session and drop every reply.
paired = (env: Env, a: Alloc, from: str, to: str) Res<i32, AllocError> {
    to.is_empty().match({
        true  => lsp_usage(),
        false => answer(env, a, from, to),
    })
}

arg = (env: Env, i: usize) str {
    env.argv.get(i).match({ Ok(s) => s, None => "" })
}

// A transport word is not a filename. `""` already means "no file
// here" to the caller above, so a client's `--stdio` answers the same
// as an absent argument, reaching the stdio path via the same branch.
file_arg = (env: Env, i: usize) str {
    word = arg(env, i);
    word.eq("--stdio").match({ true => "", false => word })
}

lsp_usage = () Res<i32, AllocError> {
    println("zen lsp                       the language server, over stdin and stdout");
    println(
        "zen lsp <requests> <replies>  the same server over two files, which is"
    );
    println("                              what tests/corpus/lsp drives");
    Ok(2);
}

answer = (env: Env, a: Alloc, from: str, to: str) Res<i32, AllocError> {
    env.fs.read(a, from).match({
        Err(e)    => unreadable(from, e),
        Ok(input) => replies(env, a, input.view(), to),
    })
}

replies = (env: Env, a: Alloc, input: str, to: str) Res<i32, AllocError> {
    s   ::= a.Server(env);
    out ::= a.String().try();
    serve(s, input, out).try();
    env.fs.write(to, out.view()).match({
        Err(e) => unwritable(to, e),
        Ok(_)  => Ok(0),
    })
}

unreadable = (path: str, e: FsError) Res<i32, AllocError> {
    println("zen lsp: {}: {}", path, fs_message(e));
    Ok(1);
}

unwritable = (path: str, e: FsError) Res<i32, AllocError> {
    println("zen lsp: -o {}: {}", path, fs_message(e));
    Ok(1);
}

// Exit 2 not 1: "this build found problems" and "I couldn't tell what
// you asked for" are different answers.
usage = (word: str) Res<i32, AllocError> {
    word.is_empty().match({
        true  => println("{}", USAGE),
        false => println("zen: unknown argument `{}`\n{}", word, USAGE),
    });
    Ok(2);
}

// A flag needed and absent is not an unknown argument: the caller
// spelled everything right and left one thing out, and naming which
// is the difference between a typo hunt and a one-word fix.
missing = (flag: str) Res<i32, AllocError> {
    println(
        "zen build: `{}` is required — a build with no `{}` writes nothing\n{}",
        flag,
        flag,
        USAGE
    );
    Ok(2);
}
