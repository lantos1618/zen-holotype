Expr, ExprId, Call, Arg, Access, Lambda, Param, Span, Paren, nowhere = std.ast
Ast = std.ast.ast_arena
Alloc, AllocError = std.mem
Vec = std.collections
str = std.text
Range = std.core
DeclId = sema.sema_id
TyId, TyFn, TyNamed = sema.sema_ty
Def = sema.sema_def
SemaFault, NameFault, TypeFault, PairFault = sema.sema_diag
Checker, Ctx = sema.sema_check
refuse_handle_argument = sema.sema_handle
meta_refused = sema.sema_meta
meta_member_call, MetaCall = sema.sema_meta
discriminant_member_call, DiscriminantAnswer = sema.sema_discriminant
variant_name_member_call, VariantNameAnswer = sema.sema_variant_name
construct, instantiate, variant_call_type = sema.sema_apply
refuse_variant_surplus = sema.sema_apply
Inst, subst, subst_list, unify_list = sema.sema_inst
is_case = sema.sema_case
Found, Base, base_of, members_of, actor_spawn_ret, ref_of_actor = sema.sema_member
is_type_def, opaque, first_found, named_as = sema.sema_member
static_access = sema.sema_static
first_hidden, hidden_member = sema.sema_member
check_bounds = sema.sema_bound
check_literal = sema.sema_trap
check_arms, check_arms_agree = sema.sema_hoist
bound_declares = sema.sema_supply
type_of, block_type = sema.sema_type
push_tparams, module_name = sema.sema_inst
param_type, type_from_ast = sema.sema_denote
alias_module, module_not_a_value = sema.sema_module
Cand, TBound, Actual, cands_of, travelled_cands, matches = sema.sema_cand
ty_at, is_tvar, recv_sig_fits = sema.sema_cand

CallCheck = {
    id: ExprId,
    node: Expr,
    call: Call,
    ctx: Ctx,
    actuals :: Vec<Actual>,

    run = (self :: @Self, c :: Checker) Res<TyId, AllocError> {
        callee = c.tree.call_callee(self.call);
        callee.kind.match({
            Access(a) => self.member(c, a),
            Name(n)   => self.named(c, n.text),
            _         => self.indirect(c),
        })
    }

    load_actuals = (self :: @Self, c :: Checker) Res<(), AllocError> {
        c.actuals_of(self.call.args, self.ctx, self.actuals)
    }

    named = (self :: @Self, c :: Checker, name: str)
            Res<TyId, AllocError> {
        self.load_actuals(c).try();
        name.is_res_ctor().match({
            true  => {
                c.refuse_res_surplus(self.call, name).try();
                c.res_ctor_type(name, self.actuals)
            },
            false => self.print_or_call(c, name),
        })
    }

    print_or_call = (self :: @Self, c :: Checker, name: str)
                    Res<TyId, AllocError> {
        name.is_print_sugar().match({
            true  => c.print_type(self.call),
            false => self.local_or_decl(c, name),
        })
    }

    local_or_decl = (self :: @Self, c :: Checker, name: str)
                    Res<TyId, AllocError> {
        c.lookup(name).match({
            None  => self.decl(c, name, None, self.actuals),
            Ok(b) => self.local_signature(c, b.ty),
        })
    }

    local_signature = (self :: @Self, c :: Checker, ty: TyId)
                      Res<TyId, AllocError> {
        settled = c.instantiate_sig(self.id, ty, self.actuals).try();
        self.signature(c, settled, 0)
    }

    decl = (
        self    :: @Self,
        c       :: Checker,
        name    : str,
        recv    : Res<TyId>,
        actuals : Vec<Actual>
    ) Res<TyId, AllocError> {
        cands ::= c.alloc.Vec<Cand>();
        c.cands_of(self.ctx.module, name, cands).try();
        c.travelled_cands(name, recv, cands).try();
        // Free-form UFCS also considers argument zero as the receiver.
        recv.match({
            Ok(_) => Ok(()),
            None  => actuals.get(0).match({
                None  => Ok(()),
                Ok(a) => c.travelled_cands(name, Ok(a.ty), cands),
            }),
        }).try();
        c.first_matching(cands, actuals).try().match({
            Ok(k) => self.chosen(c, k, actuals),
            None  => self.construct_or_fail(c, name, recv, cands),
        })
    }

    construct_or_fail = (
        self  :: @Self,
        c     :: Checker,
        name  : str,
        recv  : Res<TyId>,
        cands : Vec<Cand>
    ) Res<TyId, AllocError> {
        defs ::= c.alloc.Vec<Def>();
        c.world.defs_of(self.ctx.module, name, defs).try();
        defs.find((d) { d.kind.is_type_def() }).match({
            None  => recv.match({
                Ok(ty) => c.no_such_method(self.call, name, ty),
                None   => c.no_overload(self.node, name, cands),
            }),
            Ok(d) => self.construct_def(c, d),
        })
    }

    construct_def = (self :: @Self, c :: Checker, d: Def)
                    Res<TyId, AllocError> {
        c.alias_module(d.id).match({
            None   => c.construct(self.id, self.call, d, self.ctx),
            Ok(mi) => c.module_not_a_value(self.node.span, d.name, mi),
        })
    }

    chosen = (self :: @Self, c :: Checker, k: Cand, actuals: Vec<Actual>)
             Res<TyId, AllocError> {
        c.resolve_call(self.id, k.id).try();
        c.check_bounds(k, actuals, self.node.span).try();
        off = self.call.recv_off(actuals);
        c.arg_literals(self.call.args, k.params, off).try();
        ret = c.instantiate(self.id, self.call, k, actuals, self.ctx).try();
        params ::= c.alloc.Vec<TyId>();
        c.settled_params(self.id, k, params).try();
        c.arg_lambdas(self.call.args, params, off, self.ctx).try();
        c.args_handle_check(self.call.args, params, off, self.ctx).try();
        Ok(ret)
    }

    member = (self :: @Self, c :: Checker, ac: Access)
             Res<TyId, AllocError> {
        c.callee_access.set(self.call.callee, true).try();
        c.meta_member_call(self.id, self.node, self.call, ac, self.ctx)
            .try().match({
                Answered(ty) => Ok(ty),
                Ordinary     => self.ordinary_member(c, ac),
            })
    }

    ordinary_member = (self :: @Self, c :: Checker, ac: Access)
                      Res<TyId, AllocError> {
        c.tree.expr_at(ac.base).kind.match({
            Meta(_) => c.meta_refused(c.tree.expr_at(ac.base)),
            _       => {
                b = c.base_of(ac.base, self.ctx).try();
                c.discriminant_member_call(
                    self.id,
                    self.node,
                    self.call,
                    ac,
                    b,
                    self.ctx
                ).try().match({
                    DiscriminantAnswered(ty) => Ok(ty),
                    NotDiscriminant          => c.variant_name_member_call(
                        self.id,
                        self.node,
                        self.call,
                        ac,
                        b
                    ).try().match({
                        VariantNameAnswered(ty) => Ok(ty),
                        NotVariantName          => b.is_type.match({
                            true  => self.static_member(c, ac, b.ty),
                            false => self.receiver(c, ac, b),
                        }),
                    }),
                })
            },
        })
    }

    static_member = (self :: @Self, c :: Checker, ac: Access, ty: TyId)
                    Res<TyId, AllocError> {
        got = c.static_access(
            self.call.callee,
            self.node,
            ac,
            ty,
            self.ctx
        ).try();
        c.sig_lambdas(self.call, got, 0, self.ctx).try();
        c.is_case(ty, ac.name.text).try().match({
            true  => {
                c.refuse_variant_surplus(self.call, ty, ac.name.text).try();
                c.variant_call_type(self.call, ty, ac.name.text, self.ctx)
            },
            false => c.fn_ret(self.node, got),
        })
    }

    receiver = (self :: @Self, c :: Checker, ac: Access, b: Base)
               Res<TyId, AllocError> {
        c.opaque(b.ty).match({
            true  => c.types.unknown(),
            false => self.known_receiver(c, ac, b),
        })
    }

    known_receiver = (self :: @Self, c :: Checker, ac: Access, b: Base)
                     Res<TyId, AllocError> {
        self.load_actuals(c).try();
        found ::= c.alloc.Vec<Found>();
        c.members_of(b.ty, ac.name.text, found).try();
        found.first_hidden(self.ctx.module).match({
            Ok(f) => c.hidden_member(ac, f),
            None  => self.reachable(c, ac, b, found),
        })
    }

    reachable = (
        self  :: @Self,
        c     :: Checker,
        ac    : Access,
        b     : Base,
        found : Vec<Found>
    ) Res<TyId, AllocError> {
        c.refuse_actor_payloads(b.ty, self.actuals).try();
        (found.len > 0).match({
            true  => {
                got = self.method(c, found).try();
                self.actuals.get(0).match({
                    None    => Ok(got),
                    Ok(arg) => c.actor_spawn_ret(
                        b.ty,
                        ac.name.text,
                        arg.ty,
                        got
                    ),
                })
            },
            false => self.ufcs(c, ac, b),
        })
    }

    method = (self :: @Self, c :: Checker, found: Vec<Found>)
             Res<TyId, AllocError> {
        c.pick_fitting(found, self.actuals).try().match({
            Ok(f) => self.signature(c, f.ty, 1),
            None  => self.by_arity(c, found),
        })
    }

    by_arity = (self :: @Self, c :: Checker, found: Vec<Found>)
               Res<TyId, AllocError> {
        c.pick_arity(found, self.actuals.len + 1).match({
            None  => self.first_found(c, found),
            Ok(f) => self.signature(c, f.ty, 1),
        })
    }

    first_found = (self :: @Self, c :: Checker, found: Vec<Found>)
                  Res<TyId, AllocError> {
        found.get(0).match({
            None  => c.types.unknown(),
            Ok(f) => self.signature(c, f.ty, 1),
        })
    }

    ufcs = (self :: @Self, c :: Checker, ac: Access, b: Base)
           Res<TyId, AllocError> {
        all ::= c.alloc.Vec<Actual>();
        all.add(Actual(
            ty: b.ty,
            is_lambda: false,
            arity: 0,
            named: false,
            span: self.node.span
        )).try();
        self.actuals.loop((h, a) { all.add(a).try() });
        self.decl(c, ac.name.text, Ok(b.ty), all)
    }

    indirect = (self :: @Self, c :: Checker) Res<TyId, AllocError> {
        ty = c.type_of(self.call.callee, self.ctx).try();
        self.signature(c, ty, 0)
    }

    signature = (self :: @Self, c :: Checker, ty: TyId, off: usize)
                Res<TyId, AllocError> {
        c.sig_lambdas(self.call, ty, off, self.ctx).try();
        c.sig_args_handle_check(self.node, self.call, ty, off, self.ctx).try();
        c.fn_ret(self.node, ty)
    }
}

CallCheck = (a: Alloc, id: ExprId, node: Expr, call: Call, ctx: Ctx)
            CallCheck {
    CallCheck(
        id: id,
        node: node,
        call: call,
        ctx: ctx,
        actuals: a.Vec<Actual>()
    )
}

// The callee with its parentheses stripped.
call_callee* = (tree: Ast, call: Call) Expr {
    tree.call_callee_at(call.callee)
}

call_callee_at = (tree: Ast, id: ExprId) Expr {
    node = tree.expr_at(id);
    node.kind.match({
        Paren(p) => tree.call_callee_at(p.inner),
        _        => node,
    })
}

// Check one call and record its chosen declaration and instantiation.
call_type* = (c :: Checker, id: ExprId, node: Expr, call: Call, ctx: Ctx)
             Res<TyId, AllocError> {
    check ::= c.alloc.CallCheck(id, node, call, ctx);
    check.run(c)
}

actuals_of = (c :: Checker, args: Vec<Arg>, ctx: Ctx, out :: Vec<Actual>)
             Res<(), AllocError> {
    args.loop((h, a) {
        out.add(c.actual_of(a, ctx).try()).try();
    });
    Ok(());
}

actual_of = (c :: Checker, a: Arg, ctx: Ctx) Res<Actual, AllocError> {
    c.spelled_lambda(a.value).match({
        Ok(l) => c.lambda_actual(l, a),
        None  => c.value_actual(a, ctx),
    })
}

spelled_lambda* = (c :: Checker, id: ExprId) Res<Lambda> {
    c.tree.expr_at(id).kind.match({
        Lambda(l) => Ok(l),
        Paren(p)  => c.spelled_lambda(p.inner),
        _         => None,
    })
}

is_named = (a: Arg) bool { a.name.match({ Ok(_) => true, None => false }) }

lambda_actual = (c :: Checker, l: Lambda, a: Arg) Res<Actual, AllocError> {
    poison = c.types.unknown().try();
    Ok(Actual(
        ty: poison,
        is_lambda: true,
        arity: l.params.len,
        named: a.is_named(),
        span: a.span
    ));
}

value_actual = (c :: Checker, a: Arg, ctx: Ctx) Res<Actual, AllocError> {
    ty = c.type_of(a.value, ctx).try();
    Ok(Actual(
        ty: ty,
        is_lambda: false,
        arity: 0,
        named: a.is_named(),
        span: a.span
    ));
}

print_type = (c :: Checker, call: Call) Res<TyId, AllocError> {
    call.args.loop((h, a) { c.check_arms_agree(a.value).try() });
    c.types.prim("()")
}

is_print_sugar = (name: str) bool { name.eq("println") || name.eq("print") }

is_res_ctor = (name: str) bool { name.eq("Ok") || name.eq("Err") }

// `Ok` and `Err` carry one value each, so a second argument is evaluated
// and then dropped on the floor: `Ok(41, "x")` is an `Ok(41)` that read
// the string for nothing. Only the first surplus is worth naming.
refuse_res_surplus = (c :: Checker, call: Call, name: str)
                     Res<(), AllocError> {
    call.args.get(1).match({
        None  => Ok(()),
        Ok(a) => c.report(
            a.span.file,
            a.span,
            SemaFault.ResSurplusArgument(NameFault(name: name))
        ),
    })
}

res_ctor_type = (c :: Checker, name: str, actuals: Vec<Actual>)
                Res<TyId, AllocError> {
    payload = c.first_ty(actuals).try();
    name.eq("Ok").match({
        true  => c.types.res_open(payload),
        false => c.err_res(payload),
    })
}

// Only success lifts, so `Err(e)` says nothing about the value type.
err_res = (c :: Checker, e: TyId) Res<TyId, AllocError> {
    hole = c.types.infer().try();
    c.types.res_failure(hole, e)
}

first_ty = (c :: Checker, actuals: Vec<Actual>) Res<TyId, AllocError> {
    actuals.get(0).match({
        None  => c.types.prim("()"),
        Ok(a) => Ok(a.ty),
    })
}

// Record how a call instantiates a generic closure parameter for lowering.
instantiate_sig = (c :: Checker, id: ExprId, ty: TyId, actuals: Vec<Actual>)
                  Res<TyId, AllocError> {
    c.types.at(ty).match({
        Fn(f) => c.instantiate_fn_sig(id, ty, f, actuals),
        _     => Ok(ty),
    })
}

instantiate_fn_sig = (
    c       :: Checker,
    id      : ExprId,
    ty      : TyId,
    f       : TyFn,
    actuals : Vec<Actual>
) Res<TyId, AllocError> {
    got ::= c.alloc.Vec<TyId>();
    actuals.loop((h, a) { got.add(a.ty).try() });
    inst ::= c.alloc.Inst();
    c.unify_list(f.params, got, inst).try();
    (inst.len() > 0).then(() { c.resolve_inst(id, inst).try(); });
    c.subst(ty, inst)
}

first_matching = (
    c       :: Checker,
    cands   : Vec<Cand>,
    actuals : Vec<Actual>
) Res<Res<Cand>, AllocError> {
    hit: Res<Cand> = None;
    cands.loop((h, k) {
        c.matches(k, actuals).try().then(() {
            hit.match({
                None  => { hit = Ok(k); },
                Ok(_) => {},
            });
        });
    });
    Ok(hit)
}

// Bound-declared intrinsic methods may be lowered without an ordinary member.
no_such_method = (c :: Checker, call: Call, name: str, ty: TyId)
                 Res<TyId, AllocError> {
    c.bound_declares(ty, name).try().match({
        true  => c.types.unknown(),
        false => c.report_no_method(call, name, ty),
    })
}

report_no_method = (c :: Checker, call: Call, name: str, ty: TyId)
                   Res<TyId, AllocError> {
    poison = c.types.unknown().try();
    at     = c.callee_name_span(call);
    c.report(
        at.file,
        at,
        SemaFault.NoSuchField(TypeFault(
            name: name,
            expected: poison,
            found: ty
        ))
    ).try();
    c.types.unknown()
}

callee_name_span = (c: Checker, call: Call) Span {
    c.tree.expr_at(call.callee).kind.match({
        Access(a) => a.name.span,
        _         => nowhere(),
    })
}

no_overload = (c :: Checker, node: Expr, name: str, cands: Vec<Cand>)
              Res<TyId, AllocError> {
    (cands.len > 0).then(() {
        c.report(
            node.span.file,
            node.span,
            SemaFault.NoOverload(NameFault(name: name))
        ).try();
    });
    c.types.unknown()
}

// Lambda arguments are the only legal inward path for a loop handle. Other
// arguments are checked against their settled formal types here.
args_handle_check = (
    c      :: Checker,
    args   : Vec<Arg>,
    params : Vec<TyId>,
    off    : usize,
    ctx    : Ctx
) Res<(), AllocError> {
    args.loop((h, i, a) {
        c.refuse_handle_argument(a, params.ty_at(i + off), ctx).try();
    });
    Ok(());
}

settled_params = (c :: Checker, id: ExprId, k: Cand, out :: Vec<TyId>)
                 Res<(), AllocError> {
    c.resolved_inst(id).match({
        None    => k.params.copy_tys(out),
        Ok(ins) => c.subst_list(k.params, ins, out),
    })
}

// Type each lambda body once, after resolution supplies its parameter types.
arg_lambdas = (
    c      :: Checker,
    args   : Vec<Arg>,
    params : Vec<TyId>,
    off    : usize,
    ctx    : Ctx
) Res<(), AllocError> {
    args.loop((h, i, a) {
        c.spelled_lambda(a.value).match({
            Ok(l) => c.lambda_body(a.value, l, params.ty_at(i + off), ctx),
            None  => Ok(()),
        }).try();
    });
    Ok(());
}

// The closure keeps the enclosing return context: `.try()` inside it
// returns from the enclosing function.
lambda_body = (c :: Checker, id: ExprId, l: Lambda, sig: TyId, ctx: Ctx)
              Res<(), AllocError> {
    ptys ::= c.alloc.Vec<TyId>();
    c.fn_params(sig, ptys).try();
    smark = c.mark();
    tmark = c.tvar_mark();
    c.push_tparams(l.tparams, c.module_name(ctx.module)).try();
    c.resolve_lambda_inst(id, l, sig, ptys, ctx).try();
    l.params.loop((h, i, p) {
        ty = c.lambda_param(p, ptys, i, ctx).try();
        c.bind(p.name.text, ty, p.mutable, true).try();
    });
    c.block_type(l.body, ctx).try();
    c.release_tvars(tmark).try();
    c.release(smark).try();
    Ok(());
}

resolve_lambda_inst = (
    c    :: Checker,
    id   : ExprId,
    l    : Lambda,
    sig  : TyId,
    ptys : Vec<TyId>,
    ctx  : Ctx
) Res<(), AllocError> {
    inst ::= c.alloc.Inst();
    l.params.loop((h, i, p) {
        p.type.match({
            Ok(_) => c.unify(c.param_type(p, ctx).try(), ptys.ty_at(i), inst),
            None  => Ok(()),
        }).try();
    });
    c.types.at(sig).match({
        Fn(f) => l.ret.match({
            Ok(r) => c.unify(c.type_from_ast(r, ctx).try(), f.ret, inst),
            None  => Ok(()),
        }),
        _     => Ok(()),
    }).try();
    (inst.len() > 0).then(() { c.resolve_inst(id, inst).try(); });
    Ok(())
}

lambda_param = (c :: Checker, p: Param, ptys: Vec<TyId>, i: usize, ctx: Ctx)
               Res<TyId, AllocError> {
    p.type.match({
        Ok(_) => c.param_type(p, ctx),
        None  => c.sig_param(ptys, i),
    })
}

// Lowering cannot emit an unsubstituted parameter type; a parameter the
// call signature has not settled is poison.
sig_param = (c :: Checker, ptys: Vec<TyId>, i: usize) Res<TyId, AllocError> {
    ptys.get(i).match({
        None   => c.types.unknown(),
        Ok(ty) => c.settled_param(ty).match({
            true  => Ok(ty),
            false => c.types.unknown(),
        }),
    })
}

// UFCS actuals include the receiver; written arguments do not.
recv_off = (call: Call, actuals: Vec<Actual>) usize {
    actuals.len - call.args.len
}

arg_literals = (c :: Checker, args: Vec<Arg>, params: Vec<TyId>, off: usize)
               Res<(), AllocError> {
    args.loop((h, i, a) {
        c.param_literal(a.value, params, i + off).try();
    });
    Ok(());
}

// Variadic arguments beyond the declared prefix have no expected type.
param_literal = (c :: Checker, id: ExprId, params: Vec<TyId>, i: usize)
                Res<(), AllocError> {
    (i < params.len).match({
        false => c.check_arms_agree(id),
        true  => c.param_wants(id, params.ty_at(i)),
    })
}

param_wants = (c :: Checker, id: ExprId, want: TyId) Res<(), AllocError> {
    c.check_literal(id, want).try();
    c.settled_param(want).match({
        true  => c.check_arms(id, want),
        false => c.check_arms_agree(id),
    })
}

settled_param = (c: Checker, want: TyId) bool {
    (c.is_var(want) || c.is_infer(want) || c.is_unknown(want)) == false
}

refuse_actor_payloads = (c :: Checker, recv: TyId, actuals: Vec<Actual>)
                         Res<(), AllocError> {
    c.ref_of_actor(recv).try().match({
        None  => Ok(()),
        Ok(_) => {
            actuals.loop((h, a) {
                c.actor_payload_unsafe(a.ty).then(() {
                    spelling = c.types.name_of(a.ty).try();
                    c.report(
                        a.span.file,
                        a.span,
                        SemaFault.ActorPayload(NameFault(name: spelling.view()))
                    ).try();
                });
            });
            Ok(())
        },
    })
}

actor_payload_unsafe = (c: Checker, ty: TyId) bool {
    c.types.at(ty).match({
        Named(n) => c.named_as(n, "String", "std.text.text_string")
            || c.named_as(n, "Vec", "std.collections.collections_vec")
            || c.named_as(n, "Ptr", "std.mem.mem_ptr"),
        Fn(_)    => true,
        Var(_)   => true,
        _        => false,
    })
}

// First member whose declared parameters accept these arguments. Duplicate
// matching signatures are diagnosed at their declarations.
pick_fitting = (c :: Checker, found: Vec<Found>, actuals: Vec<Actual>)
               Res<Res<Found>, AllocError> {
    hit: Res<Found> = None;
    found.loop((h, f) {
        c.found_fits(f, actuals).try().then(() {
            hit.match({
                None  => { hit = Ok(f); },
                Ok(_) => {},
            });
        });
    });
    Ok(hit)
}

found_fits = (
    c       :: Checker,
    f       : Found,
    actuals : Vec<Actual>
) Res<bool, AllocError> {
    params ::= c.alloc.Vec<TyId>();
    c.fn_params(f.ty, params).try();
    c.recv_sig_fits(params, actuals)
}

// A member that is not a function has no parameters and fits no call.
fn_params = (c :: Checker, ty: TyId, out :: Vec<TyId>)
            Res<(), AllocError> {
    c.types.at(ty).match({
        Fn(f) => f.params.copy_tys(out),
        _     => Ok(()),
    })
}

copy_tys = (xs: Vec<TyId>, out :: Vec<TyId>) Res<(), AllocError> {
    xs.loop((h, x) { out.add(x).try() });
    Ok(());
}

pick_arity = (c: Checker, found: Vec<Found>, want: usize) Res<Found> {
    found.find((f) {
        c.types.at(f.ty).match({ Fn(g) => g.params.len == want, _ => false })
    })
}

// Indirect calls use their settled signature for handle checks. Calls through
// local closures are inlined, so loop handles may travel through them.
sig_args_handle_check = (
    c    :: Checker,
    node : Expr,
    call : Call,
    ty   : TyId,
    off  : usize,
    ctx  : Ctx
) Res<(), AllocError> {
    spliced = c.tree.expr_at(call.callee).kind.match({
        Name(n) => c.lookup(n.text).match({
            Ok(_) => true,
            None  => false,
        }),
        _       => false,
    });
    spliced.match({
        true  => Ok(()),
        false => {
            params ::= c.alloc.Vec<TyId>();
            c.fn_params(ty, params).try();
            c.args_handle_check(call.args, params, off, ctx)
        },
    })
}

sig_lambdas = (c :: Checker, call: Call, ty: TyId, off: usize, ctx: Ctx)
              Res<(), AllocError> {
    params ::= c.alloc.Vec<TyId>();
    c.fn_params(ty, params).try();
    c.arg_lambdas(call.args, params, off, ctx)
}

fn_ret = (c :: Checker, node: Expr, ty: TyId) Res<TyId, AllocError> {
    c.types.at(ty).match({
        Fn(f)   => Ok(f.ret),
        Unknown => Ok(ty),
        Infer   => Ok(ty),
        _       => c.not_callable(node, ty),
    })
}

not_callable = (c :: Checker, node: Expr, ty: TyId) Res<TyId, AllocError> {
    poison = c.types.unknown().try();
    c.report(
        node.span.file,
        node.span,
        SemaFault.NotCallable(TypeFault(name: "", expected: poison, found: ty))
    ).try();
    c.types.unknown()
}

check_overloads* = (c :: Checker, mi: usize, name: str)
                   Res<(), AllocError> {
    cands ::= c.alloc.Vec<Cand>();
    c.cands_of(mi, name, cands).try();
    cands.loop((h, i, a) {
        Range(i + 1, cands.len).loop((h2, j) {
            cands.get(j).match({
                None  => Ok(()),
                Ok(b) => c.compare(name, a, b),
            }).try();
        });
    });
    Ok(());
}

compare = (c :: Checker, name: str, a: Cand, b: Cand) Res<(), AllocError> {
    (a.params.len == b.params.len).match({
        false => Ok(()),
        true  => c.same_signature(a, b).match({
            true  => c.duplicate(name, a, b),
            false => c.maybe_swallow(name, a, b),
        }),
    })
}

same_signature = (c: Checker, a: Cand, b: Cand) bool {
    c.same_params(a.params, b.params)
}

// Members do not become `Cand`s, but overload identity is still their
// parameter list; a return type cannot distinguish a call.
same_fn_signature* = (c: Checker, a: TyId, b: TyId) bool {
    c.types.at(a).match({
        Fn(x) => c.types.at(b).match({
            Fn(y) => c.same_params(x.params, y.params),
            _     => false,
        }),
        _     => false,
    })
}

same_params = (c: Checker, a: Vec<TyId>, b: Vec<TyId>) bool {
    (a.len == b.len) && Range(0, a.len).find((i) {
        c.same_param(a.ty_at(i), b.ty_at(i)) == false
    }).match({ Ok(_) => false, None => true })
}

same_param = (c: Checker, x: TyId, y: TyId) bool {
    x.eq(y) || (c.is_tvar(x) && c.is_tvar(y))
}

maybe_swallow = (c :: Checker, name: str, a: Cand, b: Cand)
                Res<(), AllocError> {
    ((a.generic || b.generic) && c.swallows(a, b)).match({
        true  => c.ambiguous(name, a, b),
        false => Ok(()),
    })
}

swallows = (c: Checker, a: Cand, b: Cand) bool {
    c.all_eat(a, b) || c.all_eat(b, a)
}

all_eat = (c: Checker, g: Cand, k: Cand) bool {
    g.generic && c.all_eats(g.params, k.params, g.owner)
}

eats = (c: Checker, x: TyId, y: TyId, owner: str) bool {
    c.var_of(x, owner) || x.eq(y) || c.structural_eats(x, y, owner)
}

var_of = (c: Checker, x: TyId, owner: str) bool {
    c.types.at(x).match({ Var(v) => v.owner.eq(owner), _ => false })
}

structural_eats = (c: Checker, x: TyId, y: TyId, owner: str) bool {
    c.types.at(x).match({
        Fn(f)    => c.fn_eats(f, y, owner),
        Named(n) => c.named_eats(n, y, owner),
        _        => false,
    })
}

fn_eats = (c: Checker, f: TyFn, y: TyId, owner: str) bool {
    c.types.at(y).match({
        Fn(g) => (f.params.len == g.params.len)
                     && c.all_eats(f.params, g.params, owner)
                     && c.eats(f.ret, g.ret, owner),
        _     => false,
    })
}

named_eats = (c: Checker, n: TyNamed, y: TyId, owner: str) bool {
    c.types.at(y).match({
        Named(m) => n.decl.eq(m.decl) && (n.args.len == m.args.len)
                        && c.all_eats(n.args, m.args, owner),
        _        => false,
    })
}

all_eats = (c: Checker, xs: Vec<TyId>, ys: Vec<TyId>, owner: str) bool {
    Range(0, xs.len).find((i) {
        c.eats(xs.ty_at(i), ys.ty_at(i), owner) == false
    }).match({ Ok(_) => false, None => true })
}

duplicate = (c :: Checker, name: str, a: Cand, b: Cand) Res<(), AllocError> {
    c.report(
        a.span.file,
        a.span,
        SemaFault.DuplicateSignature(PairFault(
            name: name,
            first: a.span,
            second: b.span
        ))
    )
}

ambiguous = (c :: Checker, name: str, a: Cand, b: Cand) Res<(), AllocError> {
    c.report(
        a.span.file,
        a.span,
        SemaFault.AmbiguousOverload(PairFault(
            name: name,
            first: a.span,
            second: b.span
        ))
    )
}
