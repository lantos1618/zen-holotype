// A source-written nominal type is a complete application. Constructors may
// infer omitted arguments from their fields, but an annotation has no such
// source of evidence: bare, short and surplus applications are all invalid.

Box<T, U> = { left: T, right: U }
Maybe<T, U> = First(T) | Second(U)

bare_box = (value: Box) () {}
short_box = (value: Box<i32>) () {}
wide_box = (value: Box<i32, str, bool>) () {}

bare_maybe = (value: Maybe) () {}
short_maybe = (value: Maybe<i32>) () {}
wide_maybe = (value: Maybe<i32, str, bool>) () {}

main = (env: Env) Res<i32, AllocError> { Ok(0) }
