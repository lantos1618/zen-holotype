// src/sema/sema_layout.zen
// Whole-program rejection of by-value struct layout cycles.
//
// Pointer-like and non-nominal fields terminate a path. Generic structs
// abstain because cycles requiring substitution belong to instantiation.
// Each cycle is reported once at its earliest source edge.

Decl, Struct, Member, Field = std.ast
Ident, Pos, TypeId = std.ast
AllocError = std.mem
Vec = std.collections
Range = std.core
DeclId = sema.sema_id
TyId = sema.sema_ty
Def, ModuleTable, decl_at = sema.sema_def
SemaFault, NameFault = sema.sema_diag
Checker, Ctx = sema.sema_check
type_from_ast = sema.sema_denote

// One struct on the walk, and the field that reached it. A blame is
// always an edge, so the root frame's `site` is never read, which is
// why it costs nothing to give the root the struct's own name.
Frame = {
    id: DeclId,
    site: Ident,
}

// Every struct in the program, each walked at most once.
check_layout* = (c :: Checker) Res<(), AllocError> {
    path ::= c.alloc.Vec<Frame>();
    done ::= c.alloc.Vec<DeclId>();
    Range(0, c.world.count()).loop((h, mi) {
        c.module_layout(mi, path, done).try();
    });
    Ok(());
}

module_layout = (
    c    :: Checker,
    mi   : usize,
    path :: Vec<Frame>,
    done :: Vec<DeclId>
) Res<(), AllocError> {
    c.world.table_at(mi).match({
        None  => Ok(()),
        Ok(t) => c.table_layout(t, path, done),
    })
}

table_layout = (
    c    :: Checker,
    t    : ModuleTable,
    path :: Vec<Frame>,
    done :: Vec<DeclId>
) Res<(), AllocError> {
    t.defs.loop((h, d) { c.root_layout(d, path, done).try() });
    Ok(());
}

// A struct already walked is skipped, which is what makes this linear
// rather than a walk per path: if a struct sits on a cycle, the walk
// that started at it found it, so arriving a second way adds nothing.
root_layout = (
    c    :: Checker,
    d    : Def,
    path :: Vec<Frame>,
    done :: Vec<DeclId>
) Res<(), AllocError> {
    c.struct_of(d.id).match({
        None  => Ok(()),
        Ok(s) => enter(c, d.id, s, s.name, path, done),
    })
}

enter = (
    c    :: Checker,
    id   : DeclId,
    s    : Struct,
    site : Ident,
    path :: Vec<Frame>,
    done :: Vec<DeclId>
) Res<(), AllocError> {
    contains(done, id).match({
        true  => Ok(()),
        false => c.walk(id, s, site, path, done),
    })
}

walk = (
    c    :: Checker,
    id   : DeclId,
    s    : Struct,
    site : Ident,
    path :: Vec<Frame>,
    done :: Vec<DeclId>
) Res<(), AllocError> {
    path.add(Frame(id: id, site: site)).try();
    s.members.loop((h, m) { field_edge(c, m, path, done).try() });
    path.take(path.len - 1);
    done.add(id).try();
    Ok(());
}

// Only a field: a struct-body constant is one value per type and a
// function member is code, neither storage the layout must account for.
field_edge = (
    c    :: Checker,
    m    : Member,
    path :: Vec<Frame>,
    done :: Vec<DeclId>
) Res<(), AllocError> {
    m.kind.match({
        Field(f) => c.typed_edge(f, path, done),
        _        => Ok(()),
    })
}

typed_edge = (
    c    :: Checker,
    f    : Field,
    path :: Vec<Frame>,
    done :: Vec<DeclId>
) Res<(), AllocError> {
    f.type.match({
        None  => Ok(()),
        Ok(t) => c.edge_from_top(t, f.name, path, done),
    })
}

// A written type means what it means where it was written, so the
// module used is the one the struct atop the path was declared in.
edge_from_top = (
    c    :: Checker,
    t    : TypeId,
    site : Ident,
    path :: Vec<Frame>,
    done :: Vec<DeclId>
) Res<(), AllocError> {
    path.get(path.len - 1).match({
        None   => Ok(()),
        Ok(fr) => c.edge_from(fr, t, site, path, done),
    })
}

// `type_from_ast` is the one reading of a written type, so a field
// written `Ptr<Node>` answers `Ptr` here, never `Node` — the indirection
// rule falls out of the type instead of being spelled a second time.
edge_from = (
    c    :: Checker,
    fr   : Frame,
    t    : TypeId,
    site : Ident,
    path :: Vec<Frame>,
    done :: Vec<DeclId>
) Res<(), AllocError> {
    poison = c.types.unknown().try();
    ctx    = Ctx(fr.id.module.to_usize(), poison);
    ty     = c.type_from_ast(t, ctx).try();
    named_decl(c, ty).match({
        None     => Ok(()),
        Ok(next) => step(c, next, site, path, done),
    })
}

named_decl = (c: Checker, ty: TyId) Res<DeclId> {
    c.types.at(ty).match({
        Named(n) => Ok(n.decl),
        _        => None,
    })
}

step = (
    c    :: Checker,
    next : DeclId,
    site : Ident,
    path :: Vec<Frame>,
    done :: Vec<DeclId>
) Res<(), AllocError> {
    index_on(path, next).match({
        Ok(k) => c.close(k, site, path, done),
        None  => c.descend(next, site, path, done),
    })
}

descend = (
    c    :: Checker,
    next : DeclId,
    site : Ident,
    path :: Vec<Frame>,
    done :: Vec<DeclId>
) Res<(), AllocError> {
    c.struct_of(next).match({
        None  => Ok(()),
        Ok(s) => enter(c, next, s, site, path, done),
    })
}

// The blame is the earliest field on the cycle, not whichever the walk
// happened to arrive by: `Room -> Door -> Room` is one mistake however
// reached, so the diagnostic must land the same place either way — the
// walk order is a pure function of the source, so two runs agree.
//
// The cycle's edges are the frames after `k`, plus the one that closes
// it. Frame `k` was entered by an edge from outside the cycle, so its
// site is not part of it.
close = (
    c    :: Checker,
    k    : usize,
    site : Ident,
    path :: Vec<Frame>,
    done :: Vec<DeclId>
) Res<(), AllocError> {
    blame ::= site;
    Range(k + 1, path.len).loop((h, i) {
        blame = earlier(blame, site_at(path, i, blame));
    });
    c.report(
        blame.span.file,
        blame.span,
        SemaFault.InfiniteSize(NameFault(name: blame.text))
    ).try();
    seal(k, path, done).try();
    Ok(());
}

// Every struct on the cycle, marked reported, so the walk from its
// other end skips it — "one mistake, one diagnostic."
seal = (k: usize, path: Vec<Frame>, done :: Vec<DeclId>)
       Res<(), AllocError> {
    Range(k, path.len).loop((h, i) {
        path.get(i).match({
            None   => Ok(()),
            Ok(fr) => done.add(fr.id),
        }).try();
    });
    Ok(());
}

// ---------------------------------------------------------------------
// the small answers
// ---------------------------------------------------------------------

// The struct a declaration is, when this walk can answer about one. A
// generic struct abstains — see the header.
struct_of = (c: Checker, id: DeclId) Res<Struct> {
    decl_at(c.tree, id).match({
        None  => None,
        Ok(x) => monomorphic_struct(x),
    })
}

monomorphic_struct = (x: Decl) Res<Struct> {
    x.kind.match({
        Struct(s) => (s.tparams.len == 0).match({
            true  => Ok(s),
            false => None,
        }),
        _         => None,
    })
}

index_on = (path: Vec<Frame>, id: DeclId) Res<usize> {
    Range(0, path.len).find((i) { at_is(path, i, id) })
}

at_is = (path: Vec<Frame>, i: usize, id: DeclId) bool {
    path.get(i).match({
        None   => false,
        Ok(fr) => fr.id.eq(id),
    })
}

contains = (done: Vec<DeclId>, id: DeclId) bool {
    Range(0, done.len).find((i) {
        done.get(i).match({ None => false, Ok(x) => x.eq(id) })
    }).match({ Ok(_) => true, None => false })
}

site_at = (path: Vec<Frame>, i: usize, fallback: Ident) Ident {
    path.get(i).match({ Ok(fr) => fr.site, None => fallback })
}

// Nearer the top of a file. Two files cannot be ordered by position, so
// the one found first wins; the walk order is fixed, so every run
// agrees.
earlier = (a: Ident, b: Ident) Ident {
    earlier_pos(b.span.start, a.span.start).match({ true => b, false => a })
}

// Named for what it answers here -- "is x earlier" -- and not `before`:
// ast_find.zen exports the same three lines under that name, and Zen has
// no overloading to tell them apart.
earlier_pos = (x: Pos, y: Pos) bool {
    (x.line < y.line) || ((x.line == y.line) && (x.col < y.col))
}
