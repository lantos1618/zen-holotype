// compiler.pretty_decl — declaration / type / struct / enum / impl / func / import formatting for the
// AST pretty-printer. Extracted from compiler.pretty (pure move): the top-level decl walk's node formatters
// (called from ff_top_decl / pretty_module_in and from nested-func statements). Mutually recursive with the
// expression / statement walks in compiler.pretty / compiler.pretty_expr (flat-TU cycle, `*` exports).
{ String } = std.text.string
{ starts_with, view } = std.text.str
{ Malloc } = std.mem.alloc
{ Decl, EnumDecl, Field, Func, GenEnumDecl, GenStructDecl, ImplData, ImportData, Param, StructDecl,
  Ty, VariantDef } = compiler.ast.ast_types
{ param_names_has } = compiler.astops
{ is_expr_null, tvoid, acquire_or_die, acquire_or_die } = compiler.genc
{ impl_cname_in, payload_fname } = compiler.mangle
{ ff_append, ff_block, ff_flush_leading, ff_indent, ff_str_has_nl, ff_string, ff_ty, ff_tys } = compiler.pretty
{ ff_current_col, ff_expr, ff_fits_width, ff_pad } = compiler.pretty_expr
// ── declarations ────────────────────────────────────────────────────────────────
// a trailing `...T` param stores its type as the collected `[T]`; recover the element T to re-print `...T`.
ff_slice_elem = (t: Ty) Ty {
    t.match ({
        .Slice(p) => load(p),
        _         => t,
    })
}
ff_param_one = (s: String, a: MutPtr<Malloc>, p: Param) String {
    p.variadic.match ({
        true  => s.ff_append(a, p.name).ff_append(a, ": ...").ff_ty(a, ff_slice_elem(p.ty)),
        false => s.ff_append(a, p.name).ff_append(a, ": ").ff_ty(a, p.ty),
    })
}
ff_params = (s: String, a: MutPtr<Malloc>, ps: [Param]) String {
    out := s
    ps.loop((h, i, p) {
        out = (i == 0).then({ out }, { out.ff_append(a, ", ") })
        out = out.ff_param_one(a, p)
    })
    out
}
// A fn signature's ` = (params) ret` head that would overflow 100 columns (counting the ` {` block
// opener still to come) breaks one param per line at ind+1, `) ret` on its own closing line at ind —
// trailing comma on every param EXCEPT a variadic `...T` last param (the parser rejects a comma
// there). Trial render measures the inline form at the caller's current column; params/types weave
// no comments, so no gf_idx save is needed (the trial is naturally side-effect-free).
ff_sig = (s: String, a: MutPtr<Malloc>, ps: [Param], ret: Ty, ind: i32) String {
    trial := a
        .ff_string(256)
        .ff_append(a, " = (")
        .ff_params(a, ps)
        .ff_append(a, ") ")
        .ff_ty(a, ret)
    (ps.len == 0 || trial.ff_fits_width(s.ff_current_col(), 98)).match ({
        true  => s
            .ff_append(a, " = (")
            .ff_params(a, ps)
            .ff_append(a, ") ")
            .ff_ty(a, ret),
        false => {
            out := s.ff_append(a, " = (\n")
            ps.loop((h, i, p) {
                sep := p.variadic.then({ "\n" }, { ",\n" })
                out = out.ff_indent(a, ind + 1).ff_param_one(a, p).ff_append(a, sep)
            })
            out.ff_indent(a, ind).ff_append(a, ") ").ff_ty(a, ret)
        },
    })
}
// lambda params: a param's ty is its declared `: Type` annotation (Void when the source wrote none —
// the FnT context supplies the real types when the lambda is spliced). Print the annotation back when
// present; an unannotated param prints as its bare NAME — `(x)`, never `(x: void)`.
ff_lparams* = (s: String, a: MutPtr<Malloc>, ps: [Param]) String {
    out := s
    ps.loop((h, i, p) {
        out = (i == 0).then({ out }, { out.ff_append(a, ", ") })
        out = p.ty.match ({
            .Void => out.ff_append(a, p.name),
            _     => out.ff_append(a, p.name).ff_append(a, ": ").ff_ty(a, p.ty),
        })
    })
    out
}
// generic type params `<A, B>` (with optional bound `<A: Bound>`)
ff_tparams = (s: String, a: MutPtr<Malloc>, ps: [Param]) String {
    (ps.len == 0).match ({
        true  => s,
        false => {
            open := s.ff_append(a, "<")
            body := open
            ps.loop((h, i, p) {
                body = (i == 0).then({ body }, { body.ff_append(a, ", ") })
                body = p.ty.match ({
                    .Void => body.ff_append(a, p.name),
                    _     => body.ff_append(a, p.name).ff_append(a, ": ").ff_ty(a, p.ty),
                })
            })
            body.ff_append(a, ">")
        },
    })
}
// the `*` export marker: appended right after a top-level decl name when it was starred in the
// source — a param_names_has membership test over the export list.
ff_name = (s: String, a: MutPtr<Malloc>, exp: [Param], name: string_view) String {
    exp.param_names_has(name).match ({
        true  => s.ff_append(a, name).ff_append(a, "*"),
        false => s.ff_append(a, name),
    })
}
// The return type is ALWAYS printed (incl. `void`): omitting it would let the body `{ … }` reparse as
// an anonymous-struct return type `{ field: T }`, changing the AST.
ff_func = (s: String, a: MutPtr<Malloc>, exp: [Param], f: Func) String {
    sig := s.ff_name(a, exp, f.name).ff_tparams(a, f.tparams).ff_sig(a, f.params, f.ret, 0)
    sig.ff_append(a, " ").ff_block(a, f.body, 0, true)
}
ff_foreign = (s: String, a: MutPtr<Malloc>, exp: [Param], f: Func) String {
    s.ff_name(a, exp, f.name).ff_sig(a, f.params, f.ret, 0)
}
// ── un-hoisting inherent + trait methods ────────────────────────────────────────
// The parser HOISTS a struct's inherent methods (and a trait impl's methods) into separate mangled
// DFuncs (`impl_<Tr>_<Ty>_<m>`) plus a DImpl marker carrying the ORIGINAL method names. To round-trip,
// the formatter REASSEMBLES them: inherent methods print inside the struct body, trait-impl methods
// inside `Ty.impl(Tr, { … })`, and the hoisted DFuncs / inherent DImpl markers are SKIPPED at top level.
ff_no_params* = () [Param] { slice(null_ptr(), 0) }
ff_find_func = (a: MutPtr<Malloc>, decls: [Decl], name: string_view) Func {
    res := Func(
        name: "",
        params: ff_no_params(),
        ret: tvoid(),
        tparams: ff_no_params(),
        body: slice(null_ptr(), 0),
    )
    decls.loop((h, i, d) {
        d.match ({
            .DFunc(f) => (f.name == name).then({
                res = f
            }),
            _         => { },
        })
    })
    res
}
// the type's own tparams (so a method's print drops them, keeping only the method's OWN tparams)
ff_type_tparams = (decls: [Decl], tyname: string_view) [Param] {
    res := ff_no_params()
    decls.loop((h, i, d) {
        d.match ({
            .DGenStruct(g) => (g.name == tyname).then({
                res = g.tparams
            }),
            .DGenEnum(g)   => (g.name == tyname).then({
                res = g.tparams
            }),
            _              => { },
        })
    })
    res
}
ff_minus_tparams = (a: MutPtr<Malloc>, full: [Param], drop: [Param]) [Param] {
    buf := slice(a.acquire_or_die((full.len + 1) * sizeof(Param)), full.len + 1)
    n := 0
    full.loop((h, i, p) {
        (drop.param_names_has(p.name) == false).then({
            buf[n] = p
            n = n + 1
        })
    })
    slice(buf.ptr, n)
}
// a trait default for (trait, method): the parser splits `m = (…) R { … }` inside a pure method
// record into a synthesized FnT requirement field PLUS a DTraitDefault sibling carrying the body.
// The formatter re-inlines that body at the field's own slot (and skips the sibling at top level) —
// printing it as a standalone fn would hoist the body out of the record, where `Self` is unbound.
ff_has_default = (decls: [Decl], trname: string_view, fname: string_view) bool {
    found := false
    decls.loop((h, i, d) {
        d.match ({
            .DTraitDefault(td) => (td.trname == trname && td.fn.name == fname).then({
                found = true
            }),
            _                  => { },
        })
    })
    found
}
ff_find_default = (a: MutPtr<Malloc>, decls: [Decl], trname: string_view, fname: string_view) Func {
    res := Func(
        name: "",
        params: ff_no_params(),
        ret: tvoid(),
        tparams: ff_no_params(),
        body: slice(null_ptr(), 0),
    )
    decls.loop((h, i, d) {
        d.match ({
            .DTraitDefault(td) => (td.trname == trname && td.fn.name == fname).then({
                res = td.fn
            }),
            _                  => { },
        })
    })
    res
}
// is `fname` a hoisted impl method (so it must NOT print as a standalone top-level fn)?
ff_is_hoisted* = (a: MutPtr<Malloc>, decls: [Decl], fname: string_view) bool {
    found := false
    decls.loop((h, i, d) {
        d.match ({
            .DImpl(im) => im.methods.loop((h2, k, mp) {
                (a.impl_cname_in(im.trname, im.ty, mp.name) == fname).then({
                    found = true
                })
            }),
            _          => { },
        })
    })
    found
}
// ── `=` alignment across a run of one-line methods ──────────────────────────────
// House style aligns a multi-arm match's `=>` (compiler.pretty_expr.ff_arms); a run of consecutive
// one-line methods gets the same treatment on its `=`. What each method contributes to that decision is
// measured by a DRY render of the method exactly as it would print UNPADDED:
//   w    — the column the ` = ` would start at (indent + name + tparams), i.e. what the pad extends
//   tail — the rest of the line, so the PADDED line width is exactly `tail + the run's widest w`
//   one  — the whole method rendered on one physical line
//   lead — own-line comments print above it, so it opens a new visual group
MethodFact: {
    w: i32,
    tail: i32,
    one: bool,
    lead: bool,
}
// The dry pass ADVANCES the comment cursor exactly as the real pass will, so every method's trial sees
// the comments it will really see; ff_methods snapshots gf_idx around it and rewinds.
ff_method_facts = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    im: ImplData,
    ctp: [Param],
    ind: i32,
) [MethodFact] {
    buf := slice(a.acquire_or_die((im.methods.len + 1) * sizeof(MethodFact)), im.methods.len + 1)
    im.methods.loop((h, k, mp) {
        f := a.ff_find_func(decls, a.impl_cname_in(im.trname, im.ty, mp.name))
        own := a.ff_minus_tparams(f.tparams, ctp)
        above := a.ff_string(64).ff_flush_leading(a, f.pos, ind)
        head := a
            .ff_string(256)
            .ff_indent(a, ind)
            .ff_append(a, mp.name)
            .ff_tparams(a, own)
        line := head
            .ff_sig(a, f.params, f.ret, ind)
            .ff_append(a, " ")
            .ff_block(a, f.body, ind, true)
        buf[k] = MethodFact(
            w: to_i32(head.len),
            tail: to_i32(line.len) - to_i32(head.len),
            one: line.ff_str_has_nl() == false,
            lead: above.len > 0,
        )
    })
    buf
}
// A method joins the run above it while the gutter stays readable — name widths within 20 columns of
// each other, five indent steps — and no member's padded line reaches past column 100. The width bound
// is not cosmetic: it is exactly the gate ff_sig / ff_block re-check when they render at the PADDED
// column (both keep a further 4 columns of `{ … }` in hand), so a run that fits it renders as the dry
// pass measured it, and the padding cannot cascade into a reflow.
ff_run_admits = (lo: i32, hi: i32, tail: i32) bool { hi - lo <= 20 && hi + tail <= 100 }
// extend the run at `e` while the next method still fits it; `lo`/`hi`/`tl` carry the run so far
ff_run_grow = (fs: [MethodFact], e: i64, lo: i32, hi: i32, tl: i32) i64 {
    (e >= fs.len || fs[e].one == false || fs[e].lead).then({
        return e
    })
    nlo := (fs[e].w < lo).then({ fs[e].w }, { lo })
    nhi := (fs[e].w > hi).then({ fs[e].w }, { hi })
    ntl := (fs[e].tail > tl).then({ fs[e].tail }, { tl })
    nlo.ff_run_admits(nhi, ntl).then({ fs.ff_run_grow(e + 1, nlo, nhi, ntl) }, { e })
}
// index one past the last method aligned with `start` — a method that is not one-line is its own run
ff_run_end = (fs: [MethodFact], start: i64) i64 {
    fs[start].one.match ({
        true  => fs.ff_run_grow(start + 1, fs[start].w, fs[start].w, fs[start].tail),
        false => start + 1,
    })
}
ff_run_maxw = (fs: [MethodFact], from: i64, end: i64) i32 {
    (from + 1 >= end).then({
        return fs[from].w
    })
    rest := fs.ff_run_maxw(from + 1, end)
    (fs[from].w > rest).then({ fs[from].w }, { rest })
}
ff_fill_pads = (fs: [MethodFact], pads: [i32], k: i64, end: i64, mx: i32) void {
    (k < end).then({
        pads[k] = mx - fs[k].w
        fs.ff_fill_pads(pads, k + 1, end, mx)
    })
}
ff_pad_runs = (fs: [MethodFact], pads: [i32], i: i64) void {
    (i < fs.len).then({
        e := fs.ff_run_end(i)
        fs.ff_fill_pads(pads, i, e, fs.ff_run_maxw(i, e))
        fs.ff_pad_runs(pads, e)
    })
}
// spaces to insert after each method's name so a run's `=` line up (0 for a run of one)
ff_method_pads = (a: MutPtr<Malloc>, fs: [MethodFact]) [i32] {
    pads := slice(a.acquire_or_die((fs.len + 1) * sizeof(i32)), fs.len + 1)
    fs.ff_pad_runs(pads, 0)
    pads
}
// print an impl's methods (each demangled to its original name; the type's tparams dropped from the
// method's own tparam list). Reused for inherent (inside the struct) and trait impls (inside `.impl`).
ff_methods = (
    s: String,
    a: MutPtr<Malloc>,
    decls: [Decl],
    im: ImplData,
    ctp: [Param],
    ind: i32,
) String {
    save := gf_idx
    facts := a.ff_method_facts(decls, im, ctp, ind)
    gf_idx = save
    pads := a.ff_method_pads(facts)
    out := s
    im.methods.loop((h, k, mp) {
        f := a.ff_find_func(decls, a.impl_cname_in(im.trname, im.ty, mp.name))
        own := a.ff_minus_tparams(f.tparams, ctp)
        // own-line comments written ABOVE this method flush at method indent (bounded by the method's
        // name pos) — NOT hoisted into its body, where ff_block would otherwise pick them up.
        lead := out.ff_flush_leading(a, f.pos, ind)
        sig := lead
            .ff_indent(a, ind)
            .ff_append(a, mp.name)
            .ff_tparams(a, own)
            .ff_pad(a, pads[k])
            .ff_sig(a, f.params, f.ret, ind)
        out = sig.ff_append(a, " ").ff_block(a, f.body, ind, true).ff_append(a, "\n")
    })
    out
}
// the inherent methods of `tyname` (the DImpl where ty == trname == tyname), printed at `ind`
ff_inherent_methods = (
    s: String,
    a: MutPtr<Malloc>,
    decls: [Decl],
    tyname: string_view,
    ctp: [Param],
    ind: i32,
) String {
    out := s
    decls.loop((h, i, d) {
        d.match ({
            .DImpl(im) => (im.ty == tyname && im.trname == tyname).then({
                out = out.ff_methods(a, decls, im, ctp, ind)
            }),
            _          => { },
        })
    })
    out
}
// one record entry: a field whose name carries a DTraitDefault prints the default IN PLACE —
// `name = (params) ret { … },` at one indent, body formatted like a fn body — every other field
// prints `name: ty,`. Both spellings keep the trailing comma (fields are record entries).
ff_record_field = (
    s: String,
    a: MutPtr<Malloc>,
    decls: [Decl],
    owner: string_view,
    ctp: [Param],
    fl: Field,
) String {
    decls.ff_has_default(owner, fl.name).match ({
        true  => {
            f := a.ff_find_default(decls, owner, fl.name)
            own := a.ff_minus_tparams(f.tparams, ctp)
            // own-line comments preceding the default (fields carry no pos, so the default's name pos
            // is the only in-record anchor) print above it at field indent — not inside its body.
            lead := s.ff_flush_leading(a, f.pos, 1)
            sig := lead
                .ff_indent(a, 1)
                .ff_append(a, fl.name)
                .ff_tparams(a, own)
                .ff_sig(a, f.params, f.ret, 1)
            sig.ff_append(a, " ").ff_block(a, f.body, 1, true).ff_append(a, ",\n")
        },
        false => s
            .ff_indent(a, 1)
            .ff_append(a, fl.name)
            .ff_append(a, ": ")
            .ff_ty(a, fl.ty)
            .ff_append(a, ",\n"),
    })
}
ff_struct = (s: String, a: MutPtr<Malloc>, exp: [Param], decls: [Decl], sd: StructDecl) String {
    open := s.ff_name(a, exp, sd.name).ff_append(a, ": {\n")
    body := open
    sd.fields.loop((h, i, fl) {
        body = body.ff_record_field(a, decls, sd.name, ff_no_params(), fl)
    })
    body.ff_inherent_methods(a, decls, sd.name, ff_no_params(), 1).ff_append(a, "}")
}
ff_genstruct = (
    s: String,
    a: MutPtr<Malloc>,
    exp: [Param],
    decls: [Decl],
    g: GenStructDecl,
) String {
    open := s.ff_name(a, exp, g.name).ff_tparams(a, g.tparams).ff_append(a, ": {\n")
    body := open
    g.fields.loop((h, i, fl) {
        body = body.ff_record_field(a, decls, g.name, g.tparams, fl)
    })
    body.ff_inherent_methods(a, decls, g.name, g.tparams, 1).ff_append(a, "}")
}
// the impl head prints im.trty — the trait reference AS WRITTEN (qualifier + type args, e.g.
// `actor.Receiver<Msg>`) — never the bare im.trname mangle key, which drops the `.Receiver<Msg>` part
// of a qualified reference and would silently change the code's meaning.
ff_trait_impl = (s: String, a: MutPtr<Malloc>, decls: [Decl], im: ImplData) String {
    ctp := decls.ff_type_tparams(im.ty)
    (im.methods.len == 0).match ({
        true  => s
            .ff_append(a, im.ty)
            .ff_append(a, ".impl(")
            .ff_ty(a, im.trty)
            .ff_append(a, ", { })"),
        false => {
            open := s
                .ff_append(a, im.ty)
                .ff_append(a, ".impl(")
                .ff_ty(a, im.trty)
                .ff_append(a, ", {\n")
            open.ff_methods(a, decls, im, ctp, 1).ff_append(a, "})")
        },
    })
}
ff_no_fields = () [Field] { slice(null_ptr(), 0) }
// A multi-field variant payload `Ask(t0, t1, …)` is DESUGARED at parse time into a synthesized anon
// struct `__anon__0__1…` with positional fields `_0, _1, …` (compiler.parse_type.parse_variant_payload
// + compiler.genc.payload_fname). The surface type list does not survive on the AST, so the formatter
// re-derives it here: a payload struct is recognised by its `__anon` name AND ordered positional field
// names, then re-rendered as the `(t0, t1, …)` tuple and the hoisted struct is suppressed at top level
// (pretty_module_in) — the surface form round-trips and no `__anon…` internal name ever leaks.
ff_is_positional_fields = (a: MutPtr<Malloc>, fields: [Field]) bool {
    (fields.len == 0).match ({
        true  => false,
        false => {
            ok := true
            fields.loop((h, i, fl) {
                ok = ok && fl.name == a.payload_fname(to_i32(i))
            })
            ok
        },
    })
}
ff_is_anon_payload_name* = (a: MutPtr<Malloc>, decls: [Decl], nm: string_view) bool {
    nm.starts_with("__anon").match ({
        true  => a.ff_is_positional_fields(a.ff_anon_payload_fields(decls, nm)),
        false => false,
    })
}
ff_anon_payload_fields = (a: MutPtr<Malloc>, decls: [Decl], nm: string_view) [Field] {
    res := ff_no_fields()
    decls.loop((h, i, d) {
        d.match ({
            .DStruct(sd) => (sd.name == nm).then({
                res = sd.fields
            }),
            _            => { },
        })
    })
    res
}
// the payload rendering for a variant: the surface `(t0, t1, …)` tuple when the payload is a
// synthesized anon struct, else the payload type verbatim.
ff_variant_payload = (s: String, a: MutPtr<Malloc>, decls: [Decl], t: Ty) String {
    t.match ({
        .Named(nm) => a.ff_is_anon_payload_name(decls, nm).match ({
            true  => s
                .ff_append(a, "(")
                .ff_tys(a, a.ff_anon_payload_tys(decls, nm))
                .ff_append(a, ")"),
            false => s.ff_append(a, "(").ff_ty(a, t).ff_append(a, ")"),
        }),
        _          => s.ff_append(a, "(").ff_ty(a, t).ff_append(a, ")"),
    })
}
ff_anon_payload_tys = (a: MutPtr<Malloc>, decls: [Decl], nm: string_view) [Ty] {
    fields := a.ff_anon_payload_fields(decls, nm)
    buf := slice(a.acquire_or_die((fields.len + 1) * sizeof(Ty)), fields.len + 1)
    n := 0
    fields.loop((h, i, fl) {
        buf[n] = fl.ty
        n = n + 1
    })
    slice(buf.ptr, n)
}
// one variant: `Name`, `Name(Payload)`, or — for a zero-arg ctor with a default constant — `Name = expr`.
ff_variant = (s: String, a: MutPtr<Malloc>, decls: [Decl], vd: VariantDef) String {
    base := vd.payload.match ({
        .Void => s.ff_append(a, vd.name),
        _     => s.ff_append(a, vd.name).ff_variant_payload(a, decls, vd.payload),
    })
    vd.dflt.is_expr_null().then({ base }, { base.ff_append(a, " = ").ff_expr(a, vd.dflt, 0) })
}
ff_variants = (s: String, a: MutPtr<Malloc>, decls: [Decl], vs: [VariantDef]) String {
    body := s
    vs.loop((h, i, vd) {
        body = (i == 0).then({ body }, { body.ff_append(a, " | ") })
        body = body.ff_variant(a, decls, vd)
    })
    body
}
ff_enum = (s: String, a: MutPtr<Malloc>, exp: [Param], decls: [Decl], ed: EnumDecl) String {
    s.ff_name(a, exp, ed.name).ff_append(a, ": ").ff_variants(a, decls, ed.variants)
}
ff_genenum = (s: String, a: MutPtr<Malloc>, exp: [Param], decls: [Decl], g: GenEnumDecl) String {
    s
        .ff_name(a, exp, g.name)
        .ff_tparams(a, g.tparams)
        .ff_append(a, ": ")
        .ff_variants(a, decls, g.variants)
}
ff_decl* = (s: String, a: MutPtr<Malloc>, exp: [Param], decls: [Decl], d: Decl) String {
    d.match ({
        .DFunc(f)          => s.ff_func(a, exp, f),
        .DStruct(sd)       => s.ff_struct(a, exp, decls, sd),
        .DEnum(ed)         => s.ff_enum(a, exp, decls, ed),
        .DGenStruct(g)     => s.ff_genstruct(a, exp, decls, g),
        .DGenEnum(g)       => s.ff_genenum(a, exp, decls, g),
        .DForeign(f)       => s.ff_foreign(a, exp, f),
        .DImpl(im)         => s.ff_trait_impl(a, decls, im),
        .DGlobal(g)        => g.tl.match ({
            true  => s
                .ff_name(a, exp, g.name)
                .ff_append(a, " := thread_local(")
                .ff_expr(a, g.init, 0)
                .ff_append(a, ")"),
            false => g.alias.match ({
                true  => s.ff_name(a, exp, g.name).ff_append(a, " = ").ff_expr(a, g.init, 0),
                false => s.ff_name(a, exp, g.name).ff_append(a, " := ").ff_expr(a, g.init, 0),
            }),
        }),    // module alias keeps `=`
        .DImport(im)       => s.ff_import(a, im),
        .DTraitDefault(td) => s.ff_func(a, exp, td.fn),
        .DRaw(c)           => s.ff_append(a, c),
    })
}
ff_import_inline = (s: String, a: MutPtr<Malloc>, im: ImportData) String {
    open := s.ff_append(a, "{ ")
    body := open
    im.names.loop((h, i, p) {
        body = (i == 0).then({ body }, { body.ff_append(a, ", ") })
        body = body.ff_append(a, p.name)
    })
    body.ff_append(a, " } = ").ff_append(a, im.module)
}
// An import list that would overflow 100 columns greedy-fills names per line, breaking BEFORE the
// name that would push the line (incl. its trailing comma) past 100; continuation lines indent 2
// spaces, aligning under the first name after `{ `, and the last line closes ` } = module.path`.
// The parser (and the textual import scanner in compiler.resolve_scan, which seeks the `} =`
// marker across newlines) both accept the wrapped form — verified end-to-end before shipping.
ff_import_wrapped = (s: String, a: MutPtr<Malloc>, im: ImportData) String {
    out := s.ff_append(a, "{ ")
    col := 2
    im.names.loop((h, i, p) {
        w := to_i32(view(p.name).len)
        out = (i == 0).match ({
            true  => out.ff_append(a, p.name),
            false => (col + 2 + w > 99).match ({
                true  => {
                    col = 2
                    out.ff_append(a, ",\n  ").ff_append(a, p.name)
                },
                false => {
                    col = col + 2
                    out.ff_append(a, ", ").ff_append(a, p.name)
                },
            }),
        })
        col = col + w
    })
    out.ff_append(a, " } = ").ff_append(a, im.module)
}
ff_import = (s: String, a: MutPtr<Malloc>, im: ImportData) String {
    trial := a.ff_string(256).ff_import_inline(a, im)
    trial.ff_fits_width(s.ff_current_col(), 100).match ({
        true  => s.ff_import_inline(a, im),
        false => s.ff_import_wrapped(a, im),
    })
}
