// src/gen/gen_c/gen_c_layout.zen
// What a Zen type's C DEFINITION is: the bytes behind the spelling.
//
// Three shapes, no more. A struct is its storage fields. An enum is a
// tag and a union of the payloads that have one — omitted entirely
// when no variant carries anything, so `Signal = Start | Stop` is one
// `int32_t`, not a struct wrapping an empty union. A `Res` is the same
// shape, built from two type ids rather than a declaration.
//
// EVERY DEFINITION IS EMITTED ONCE, IN DETERMINISTIC ORDER: sorted by
// mangled name (`tcode`, a pure function of the type). A definition is
// preceded by the definitions it contains BY VALUE, since C needs a
// complete type for a field and a forward `typedef` isn't one; a
// pointer needs no complete type, so the dependency walk looks at
// fields, not every mention.
//
// A TAG IS A FUNCTION OF THE DECLARATION, NEVER AN INSTANTIATION:
// `Res<i32, E>` and `Res<i32, F>` share `Ok`, so emitting the constant
// per instance is a C redefinition. Two enumerators may share a value —
// `Res<T>.None` and `Res<T, E>.Err` are both 1 — which is legal C.

Ast, Decl, DeclKind, Struct, Enum, Variant, Member, MemberKind, TypeId = std.ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId, Ty, Types, TyNamed, TyRes, TyUnion, TyArray, ResForm = sema.sema_ty
World, Def, decl_at = sema.sema_def
Checker, Ctx = sema.sema_check
type_from_ast = sema.sema_type
write_usize = sema.sema_diag
Emit, order = gen.gen_emit
sym_type, sym_variant, sym_member, tcode, GEN, USR = gen.gen_name
path_with, res_arity, is_failure, RES_PATH = gen.gen_name
sym_union_variant, sym_union_member = gen.gen_name
GenFault = gen.gen_diag
CBackend = gen.gen_c.gen_c_state
ctype, declarator, is_unit, request_type = gen.gen_c.gen_c_type
field_type, variant_type, decl_ctx, close_types = gen.gen_c.gen_c_type
decl_inst = gen.gen_c.gen_c_type
Inst = sema.sema_inst
any_open, enter_struct_tparams, leave_tparams = gen.gen_c.gen_c_mono
Slot, is_fat, slots_of, slot_field = gen.gen_c.gen_c_fat
write_array_def = gen.gen_c.gen_c_array

// -----------------------------------------------------------------
// emission
// -----------------------------------------------------------------

// Forward typedefs, then tag constants, then definitions — three
// passes because C wants that order: a tag is a plain `enum` constant,
// and a definition may mention any tag or typedef.
emit_types* = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    close_types(be).try();
    seq = order(be.alloc, be.type_names).try();
    seq.loop((h, i) { emit_typedef(be, out, i).try() });
    out.line().try();
    emit_tags(be, out, seq).try();
    seq.loop((h, i) { define_type(be, out, i).try() });
    Ok(());
}

emit_typedef = (be :: CBackend, out :: Emit, i: usize) Res<(), AllocError> {
    name = be.type_name_at(i);
    out.bytes("typedef struct ").try();
    out.bytes(name).try();
    out.bytes(" ").try();
    out.bytes(name).try();
    out.say(";").try();
    Ok(());
}

// -----------------------------------------------------------------
// tags — a function of the DECLARATION, never an instantiation (see
// file header)
// -----------------------------------------------------------------

emit_tags = (be :: CBackend, out :: Emit, seq: Vec<usize>)
            Res<(), AllocError> {
    seen ::= be.alloc.Vec<String>();
    seq.loop((h, i) { collect_tags(be, i, seen).try() });
    (seen.len > 0).then(() { emit_tag_block(be, out, seen).try() });
    Ok(());
}

emit_tag_block = (be :: CBackend, out :: Emit, seen: Vec<String>)
                 Res<(), AllocError> {
    tags = order(be.alloc, seen).try();
    out.say("enum {").try();
    out.indent();
    tags.loop((h, i) {
        seen.get(i).match({
            None  => Ok(()),
            Ok(s) => out.say(s.view()),
        }).try();
    });
    out.dedent();
    out.say("};").try();
    out.line().try();
    Ok(());
}

collect_tags = (be :: CBackend, i: usize, seen :: Vec<String>)
               Res<(), AllocError> {
    be.type_id_at(i).match({
        None   => Ok(()),
        Ok(id) => collect_tags_of(be, id, seen),
    }).try();
    Ok(());
}

collect_tags_of = (be :: CBackend, id: TyId, seen :: Vec<String>)
                  Res<(), AllocError> {
    be.types().at(id).match({
        Res(r)   => collect_res_tags(be, r, seen),
        Named(n) => collect_enum_tags(be, id, n, seen),
        Union(u) => collect_union_tags(be, id, u, seen),
        _        => Ok(()),
    })
}

// A structural set numbers its members by the CANONICAL order — the
// intern store's sort, a function of the set alone (`A | B` and `B | A`
// are one type, one numbering). Not declaration order: a structural set
// has none.
//
// A declared enum READ AS A UNION numbers the same way (`write_enum_tags`
// below), so `Error = AllocError | IoError` and the structural
// `AllocError | IoError` agree tag for tag.
collect_union_tags = (be :: CBackend, id: TyId, u: TyUnion,
                      seen :: Vec<String>) Res<(), AllocError> {
    u.members.loop((h, i, m) { add_union_tag(be, id, m, i, seen).try() });
    Ok(());
}

add_union_tag = (be :: CBackend, id: TyId, m: TyId, value: usize,
                 seen :: Vec<String>) Res<(), AllocError> {
    line ::= be.alloc.String().try();
    sym_union_variant(line, be.types(), be.world(), id, m).try();
    line.add_bytes(" = ").try();
    write_usize(line, value).try();
    line.add_bytes(",").try();
    has_line(seen, line.view()).match({
        false => seen.add(line),
        true  => Ok(()),
    })
}

collect_res_tags = (be :: CBackend, r: TyRes, seen :: Vec<String>)
                   Res<(), AllocError> {
    add_tag(be, seen, RES_PATH, "Ok", 0).try();
    is_failure(r.form).match({
        true  => add_tag(be, seen, RES_PATH, "Err", 1),
        false => add_tag(be, seen, RES_PATH, "None", 1),
    }).try();
    Ok(());
}

collect_enum_tags = (be :: CBackend, id: TyId, n: TyNamed,
                     seen :: Vec<String>) Res<(), AllocError> {
    decl_at(be.tree, n.decl).match({
        None  => Ok(()),
        Ok(d) => collect_decl_tags(be, id, n, d, seen),
    }).try();
    Ok(());
}

collect_decl_tags = (be :: CBackend, id: TyId, n: TyNamed, d: Decl,
                     seen :: Vec<String>) Res<(), AllocError> {
    qname ::= be.alloc.String().try();
    write_qname(be, qname, n).try();
    d.kind.match({
        Enum(e) => write_enum_tags(be, id, n, e, qname.view(), seen),
        _       => Ok(()),
    })
}

// A UNION'S TAGS ARE NUMBERED BY A CANONICAL ORDER OVER ITS MEMBERS,
// NEVER DECLARATION ORDER. DESIGN.md: "A union is its members. Order
// and spelling are not part of its identity" — `WriteError = IoError |
// AllocError` and `Error = AllocError | IoError` are ONE type, so
// numbering by declaration would give one type two numberings, making
// `.try()` between the two spellings a runtime re-tagging switch for a
// difference the type system says doesn't exist.
//
// The order isn't reinvented: `set_of` hands back the union interned
// and sorted, the same order `collect_union_tags` writes — asking sema
// keeps the two from drifting, and sema/gen_c drift is this compiler's
// worst failure class.
//
// A nominal enum is unaffected: `Signal = Start | Stop` names no types,
// `set_of` returns the given id, `variant_ranks` adds nothing, and
// declaration order stands.
write_enum_tags = (be :: CBackend, id: TyId, n: TyNamed, e: Enum,
                   qname: str, seen :: Vec<String>) Res<(), AllocError> {
    ranks ::= be.alloc.Vec<usize>();
    variant_ranks(be, id, n, e.variants, ranks).try();
    (ranks.len == e.variants.len).match({
        false => write_variant_tags(be, e.variants, qname, seen),
        true  => write_ranked_tags(be, e.variants, ranks, qname, seen),
    })
}

// All-or-nothing via the length check above: a rank is added only for
// a variant that HAS one, so one miss leaves the vec short and the
// whole declaration falls back to declaration order (a mix would give
// two variants one tag). The concrete miss: a variant whose own type is
// a set — `Error = WriteError | FsError`, where `union_ty` flattened
// `WriteError` away, leaving no member to rank against.
variant_ranks = (be :: CBackend, id: TyId, n: TyNamed,
                 variants: Vec<Variant>, ranks :: Vec<usize>)
                Res<(), AllocError> {
    canonical_members(be, id).match({
        None    => Ok(()),
        Ok(mem) => collect_ranks(be, n, variants, mem, ranks),
    })
}

// The members of the set this NAME stands for. Nothing when the name is
// not a union, which is the nominal reading and the common one.
canonical_members = (be :: CBackend, id: TyId) Res<Vec<TyId>> {
    be.types().at(be.check.set_of(id)).match({
        Union(u) => Ok(u.members),
        _        => None,
    })
}

collect_ranks = (be :: CBackend, n: TyNamed, variants: Vec<Variant>,
                 members: Vec<TyId>, ranks :: Vec<usize>)
                Res<(), AllocError> {
    ctx = decl_ctx(be, n);
    inst = decl_inst(be, n).try();
    mark = enter_struct_tparams(be, n.decl).try();
    variants.loop((h, v) {
        variant_rank(be, n, v, members, ctx, inst).match({
            None  => Ok(()),
            Ok(r) => ranks.add(r),
        }).try();
    });
    leave_tparams(be, mark).try();
    Ok(());
}

variant_rank = (be :: CBackend, n: TyNamed, v: Variant, members: Vec<TyId>,
                ctx: Ctx, inst: Inst) Res<usize> {
    variant_type(be, n, v, ctx, inst).match({
        None  => None,
        Ok(t) => rank_within(members, t),
    })
}

rank_within = (members: Vec<TyId>, t: TyId) Res<usize> {
    Range(0, members.len).find((i) {
        members.get(i).match({ Ok(m) => m.eq(t), None => false })
    })
}

write_ranked_tags = (be :: CBackend, variants: Vec<Variant>,
                     ranks: Vec<usize>, qname: str, seen :: Vec<String>)
                    Res<(), AllocError> {
    variants.loop((h, i, v) {
        ranks.get(i).match({
            None  => Ok(()),
            Ok(r) => add_tag(be, seen, qname, v.name.text, r),
        }).try();
    });
    Ok(());
}

write_variant_tags = (be :: CBackend, variants: Vec<Variant>, qname: str,
                      seen :: Vec<String>) Res<(), AllocError> {
    variants.loop((h, i, v) {
        add_tag(be, seen, qname, v.name.text, i).try();
    });
    Ok(());
}

// `zu_e<path> = <n>,` as one line, deduped by the whole line — two
// declarations that produce the same constant produce the same bytes,
// and a repeat is a repeat rather than a redefinition.
add_tag = (be :: CBackend, seen :: Vec<String>, qname: str, variant: str,
           value: usize) Res<(), AllocError> {
    line ::= be.alloc.String().try();
    sym_variant(line, qname, variant).try();
    line.add_bytes(" = ").try();
    write_usize(line, value).try();
    line.add_bytes(",").try();
    has_line(seen, line.view()).match({
        false => seen.add(line),
        true  => Ok(()),
    })
}

has_line = (seen: Vec<String>, text: str) bool {
    Range(0, seen.len).find((i) {
        seen.get(i).match({ Ok(s) => s.view().eq(text), None => false })
    }).match({ Ok(_) => true, None => false })
}

// The module-qualified name of a declared type, which is what a tag
// constant is a path of.
write_qname* = (be :: CBackend, out :: String, n: TyNamed)
               Res<(), AllocError> {
    be.world().table_at(n.decl.module.to_usize()).match({
        None  => Ok(()),
        Ok(t) => write_dotted(out, t.name),
    }).try();
    out.add_bytes(n.name).try();
    Ok(());
}

write_dotted = (out :: String, name: str) Res<(), AllocError> {
    (name.len > 0).then(() {
        out.add_bytes(name).try();
        out.add_bytes(".").try();
    });
    Ok(());
}

// -----------------------------------------------------------------
// definitions
//
// Dependency-first: a struct holding another BY VALUE needs a complete
// type, and a forward typedef is not one. The marker is set before the
// children are walked, so a by-value cycle terminates — it is a sema
// error and is reported there, and this only has to not hang.
// -----------------------------------------------------------------

define_type = (be :: CBackend, out :: Emit, i: usize) Res<(), AllocError> {
    be.is_done(i).match({
        false => define_fresh(be, out, i),
        true  => Ok(()),
    })
}

define_fresh = (be :: CBackend, out :: Emit, i: usize) Res<(), AllocError> {
    be.mark_done(i).try();
    define_deps(be, out, i).try();
    be.type_id_at(i).match({
        None   => Ok(()),
        Ok(id) => write_definition(be, out, be.type_name_at(i), id),
    }).try();
    Ok(());
}

define_deps = (be :: CBackend, out :: Emit, i: usize) Res<(), AllocError> {
    deps ::= be.alloc.Vec<TyId>();
    be.type_id_at(i).match({
        None   => Ok(()),
        Ok(id) => by_value_deps(be, id, deps),
    }).try();
    deps.loop((h, d) { define_dep(be, out, d).try() });
    Ok(());
}

define_dep = (be :: CBackend, out :: Emit, id: TyId) Res<(), AllocError> {
    name ::= be.alloc.String().try();
    sym_type(name, be.types(), be.world(), id).try();
    be.type_index(name.view()).match({
        None  => Ok(()),
        Ok(j) => define_type(be, out, j),
    }).try();
    Ok(());
}

by_value_deps = (be :: CBackend, id: TyId, deps :: Vec<TyId>)
                Res<(), AllocError> {
    be.types().at(id).match({
        Named(n) => decl_deps(be, n, deps),
        Res(r)   => res_deps(be, r, deps),
        Union(u) => union_deps(be, u.members, deps),
        Array(a) => keep_composite(be, a.elem, deps),
        _        => Ok(()),
    })
}

// Every member is held BY VALUE in the payload union, so every member
// needs a complete type above it.
union_deps = (be :: CBackend, members: Vec<TyId>, deps :: Vec<TyId>)
             Res<(), AllocError> {
    members.loop((h, m) { keep_composite(be, m, deps).try() });
    Ok(());
}

res_deps = (be :: CBackend, r: TyRes, deps :: Vec<TyId>)
           Res<(), AllocError> {
    keep_composite(be, r.value, deps).try();
    is_failure(r.form).then(() { keep_composite(be, r.error, deps).try() });
    Ok(());
}

keep_composite = (be :: CBackend, id: TyId, deps :: Vec<TyId>)
                 Res<(), AllocError> {
    be.types().at(id).match({
        Named(_) => deps.add(id),
        Res(_)   => deps.add(id),
        Union(_) => deps.add(id),
        Array(_) => deps.add(id),
        _        => Ok(()),
    })
}

decl_deps = (be :: CBackend, n: TyNamed, deps :: Vec<TyId>)
            Res<(), AllocError> {
    decl_at(be.tree, n.decl).match({
        None  => Ok(()),
        Ok(d) => decl_kind_deps(be, n, d, deps),
    }).try();
    Ok(());
}

decl_kind_deps = (be :: CBackend, n: TyNamed, d: Decl, deps :: Vec<TyId>)
                 Res<(), AllocError> {
    ctx = decl_ctx(be, n);
    inst = decl_inst(be, n).try();
    mark = enter_struct_tparams(be, n.decl).try();
    d.kind.match({
        Struct(s) => field_deps(be, s.members, ctx, inst, deps),
        Enum(e)   => variant_deps(be, n, e.variants, ctx, inst, deps),
        _         => Ok(()),
    }).try();
    leave_tparams(be, mark).try();
    Ok(());
}

field_deps = (be :: CBackend, members: Vec<Member>, ctx: Ctx, inst: Inst,
              deps :: Vec<TyId>) Res<(), AllocError> {
    members.loop((h, m) {
        field_type(be, m, ctx, inst).match({
            None  => Ok(()),
            Ok(t) => keep_composite(be, t, deps),
        }).try();
    });
    Ok(());
}

variant_deps = (be :: CBackend, n: TyNamed, variants: Vec<Variant>, ctx: Ctx,
                inst: Inst, deps :: Vec<TyId>) Res<(), AllocError> {
    variants.loop((h, v) {
        variant_type(be, n, v, ctx, inst).match({
            None  => Ok(()),
            Ok(t) => keep_composite(be, t, deps),
        }).try();
    });
    Ok(());
}

write_definition = (be :: CBackend, out :: Emit, name: str, id: TyId)
                   Res<(), AllocError> {
    be.types().at(id).match({
        Res(r)   => write_res_def(be, out, name, r),
        Named(n) => write_named_def(be, out, name, n, id),
        Union(u) => write_union_def(be, out, name, u),
        Array(a) => write_array_def(be, out, name, a),
        _        => Ok(()),
    })
}

// A STRUCTURAL SET GETS THE SHAPE A DECLARED ONE ALREADY HAS: a tag and
// a union of the member types. DESIGN.md calls `A | B` "a structural
// enum, not a new kind of type" — a second representation would invent
// the kind the design says it isn't, and need a runtime conversion
// between two spellings of one set where the language promises none.
//
// A member carries a value OF the type it names: `WriteError.IoError`
// records WHICH IoError, where tag-only would record only that there
// was one.
write_union_def = (be :: CBackend, out :: Emit, name: str, u: TyUnion)
                  Res<(), AllocError> {
    open_struct(out, name).try();
    payloads ::= be.alloc.Vec<TyId>();
    names ::= be.alloc.Vec<String>();
    u.members.loop((h, m) { add_union_payload(be, payloads, names, m).try() });
    write_union(be, out, payloads, names).try();
    close_struct(out).try();
    Ok(());
}

add_union_payload = (be :: CBackend, payloads :: Vec<TyId>,
                     names :: Vec<String>, m: TyId) Res<(), AllocError> {
    is_unit(be, m).match({
        true  => Ok(()),
        false => push_union_payload(be, payloads, names, m),
    })
}

push_union_payload = (be :: CBackend, payloads :: Vec<TyId>,
                      names :: Vec<String>, m: TyId) Res<(), AllocError> {
    field ::= be.alloc.String().try();
    sym_union_member(field, be.types(), be.world(), m).try();
    payloads.add(m).try();
    names.add(field).try();
    Ok(());
}

// `struct { int32_t zg_tag; union { T zu_m2Ok; E zu_m3Err; } zg_data; }`.
// A unit payload takes no member: `Ok(())` carries nothing, and a void
// member is illegal C.
write_res_def = (be :: CBackend, out :: Emit, name: str, r: TyRes)
                Res<(), AllocError> {
    open_struct(out, name).try();
    payloads ::= be.alloc.Vec<TyId>();
    names ::= be.alloc.Vec<String>();
    add_payload(be, payloads, names, r.value, "Ok").try();
    is_failure(r.form).match({
        true  => add_payload(be, payloads, names, r.error, "Err"),
        false => Ok(()),
    }).try();
    write_union(be, out, payloads, names).try();
    close_struct(out).try();
    Ok(());
}

add_payload = (be :: CBackend, payloads :: Vec<TyId>, names :: Vec<String>,
               id: TyId, variant: str) Res<(), AllocError> {
    is_unit(be, id).match({
        true  => Ok(()),
        false => push_payload(be, payloads, names, id, variant),
    })
}

push_payload = (be :: CBackend, payloads :: Vec<TyId>, names :: Vec<String>,
                id: TyId, variant: str) Res<(), AllocError> {
    m ::= be.alloc.String().try();
    sym_member(m, variant).try();
    payloads.add(id).try();
    names.add(m).try();
    Ok(());
}

write_named_def = (be :: CBackend, out :: Emit, name: str, n: TyNamed,
                   id: TyId) Res<(), AllocError> {
    decl_at(be.tree, n.decl).match({
        None  => write_opaque(out, name),
        Ok(d) => write_decl_def(be, out, name, n, d, id),
    })
}

write_decl_def = (be :: CBackend, out :: Emit, name: str, n: TyNamed,
                  d: Decl, id: TyId) Res<(), AllocError> {
    ctx = decl_ctx(be, n);
    inst = decl_inst(be, n).try();
    mark = enter_struct_tparams(be, n.decl).try();
    d.kind.match({
        Struct(s) => write_struct_or_fat(be, out, name, s, ctx, inst, id),
        Enum(e)   => write_enum_def(be, out, name, n, e, ctx, inst),
        _         => write_opaque(out, name),
    }).try();
    leave_tparams(be, mark).try();
    Ok(());
}

// A BOUND USED AS A VALUE IS A RECORD, and this is the fork DESIGN.md
// draws: "a trait value is a receiver pointer plus one function pointer
// per method, built on the stack, copied by value, no allocation". A
// struct that declares behaviour and no storage has no fields to lay
// out and is not empty either — it is the record.
write_struct_or_fat = (be :: CBackend, out :: Emit, name: str, s: Struct,
                       ctx: Ctx, inst: Inst, id: TyId)
                      Res<(), AllocError> {
    is_fat(be, id).match({
        true  => write_fat_def(be, out, name, id),
        false => write_struct_def(be, out, name, s, ctx, inst),
    })
}

// `struct { void *zg_self; <ret> (*<slot>)(void *, ..); .. }`, one slot
// per declared member in declaration order — a pure function of the
// declaration, which is what lets two programs compile one bound to one
// shape.
write_fat_def = (be :: CBackend, out :: Emit, name: str, id: TyId)
                Res<(), AllocError> {
    slots ::= be.alloc.Vec<Slot>();
    slots_of(be, id, slots).try();
    open_struct(out, name).try();
    out.say("void *zg_self;").try();
    slots.loop((h, s) { write_slot_line(be, out, s).try() });
    close_struct(out).try();
    Ok(());
}

write_slot_line = (be :: CBackend, out :: Emit, s: Slot)
                  Res<(), AllocError> {
    line ::= be.alloc.String().try();
    slot_field(be, s, line).try();
    out.say(line.view())
}

// A GENERIC STRUCT IS LAID OUT AT ITS ARGUMENTS: `Vec<u8>` holds a
// `Ptr<u8>` — one C definition per instantiation is what
// monomorphisation IS.
//
// Still opaque: a type whose arguments nothing settled — `Vec<T>`
// itself, which no program has a value of and whose fields would spell
// a `T` with no C type. An opaque body keeps the translation unit
// parsing around the diagnostic the call site already raised.
write_struct_def = (be :: CBackend, out :: Emit, name: str, s: Struct,
                    ctx: Ctx, inst: Inst) Res<(), AllocError> {
    fields ::= be.alloc.Vec<TyId>();
    storage_types(be, s, ctx, inst, fields).try();
    any_open(be, fields).match({
        true  => write_opaque(out, name),
        false => write_fields_def(be, out, name, s, ctx, inst, fields),
    })
}

// The declared type of every STORAGE member, in declaration order —
// collected once so the openness check and field lines share one list
// rather than risk disagreeing about which members are storage.
storage_types = (be :: CBackend, s: Struct, ctx: Ctx, inst: Inst,
                 out :: Vec<TyId>) Res<(), AllocError> {
    s.members.loop((h, m) {
        field_type(be, m, ctx, inst).match({
            None  => Ok(()),
            Ok(t) => out.add(t),
        }).try();
    });
    Ok(());
}

write_fields_def = (be :: CBackend, out :: Emit, name: str, s: Struct,
                    ctx: Ctx, inst: Inst, fields: Vec<TyId>)
                   Res<(), AllocError> {
    open_struct(out, name).try();
    s.members.loop((h, m) {
        field_type(be, m, ctx, inst).match({
            None  => Ok(()),
            Ok(t) => write_field(be, out, m, t),
        }).try();
    });
    // C11 6.7.2.1p1 wants a member; one byte, in one place, so a bare
    // empty struct and an empty struct used as a field agree.
    (fields.len == 0).then(() { out.say("char zg_pad;").try() });
    close_struct(out).try();
    Ok(());
}

write_field = (be :: CBackend, out :: Emit, m: Member, t: TyId)
              Res<(), AllocError> {
    name ::= be.alloc.String().try();
    member_name(be, m, name).try();
    decl ::= be.alloc.String().try();
    declarator(be, t, name.view(), decl).try();
    decl.add_bytes(";").try();
    out.say(decl.view())
}

member_name = (be :: CBackend, m: Member, out :: String)
              Res<(), AllocError> {
    m.kind.match({
        Field(fld)  => out.sym_member(fld.name.text),
        Const(c)    => out.sym_member(c.name.text),
        Function(f) => out.sym_member(f.name.text),
    })
}

write_enum_def = (be :: CBackend, out :: Emit, name: str, n: TyNamed,
                  e: Enum, ctx: Ctx, inst: Inst) Res<(), AllocError> {
    open_struct(out, name).try();
    payloads ::= be.alloc.Vec<TyId>();
    names ::= be.alloc.Vec<String>();
    e.variants.loop((h, v) {
        variant_type(be, n, v, ctx, inst).match({
            None  => Ok(()),
            Ok(t) => add_payload(be, payloads, names, t, v.name.text),
        }).try();
    });
    write_union(be, out, payloads, names).try();
    close_struct(out).try();
    Ok(());
}

// The tag, then the payload union when any variant carries one, omitted
// entirely for a tag-only enum (see header).
open_struct = (out :: Emit, name: str) Res<(), AllocError> {
    out.bytes("struct ").try();
    out.bytes(name).try();
    out.say(" {").try();
    out.indent();
    Ok(());
}

close_struct = (out :: Emit) Res<(), AllocError> {
    out.dedent();
    out.say("};").try();
    out.line().try();
    Ok(());
}

write_opaque = (out :: Emit, name: str) Res<(), AllocError> {
    open_struct(out, name).try();
    out.say("char zg_pad;").try();
    close_struct(out).try();
    Ok(());
}

write_union = (be :: CBackend, out :: Emit, payloads: Vec<TyId>,
               names: Vec<String>) Res<(), AllocError> {
    out.say("int32_t zg_tag;").try();
    (payloads.len > 0).then(() {
        write_union_body(be, out, payloads, names).try();
    });
    Ok(());
}

write_union_body = (be :: CBackend, out :: Emit, payloads: Vec<TyId>,
                    names: Vec<String>) Res<(), AllocError> {
    out.say("union {").try();
    out.indent();
    payloads.loop((h, i, t) {
        write_union_member(be, out, names, i, t).try();
    });
    out.dedent();
    out.say("} zg_data;").try();
    Ok(());
}

write_union_member = (be :: CBackend, out :: Emit, names: Vec<String>,
                      i: usize, t: TyId) Res<(), AllocError> {
    names.get(i).match({
        None  => Ok(()),
        Ok(m) => write_member_line(be, out, m.view(), t),
    })
}

write_member_line = (be :: CBackend, out :: Emit, name: str, t: TyId)
                    Res<(), AllocError> {
    decl ::= be.alloc.String().try();
    declarator(be, t, name, decl).try();
    decl.add_bytes(";").try();
    out.say(decl.view())
}
