// The blessed spawn idiom, fully unannotated: `actor.spawn_handle(…).expect(…)` — M is solved from the
// Receiver impl (trait-impl targ inference) — then send/run/verify the actor's state.
// Plus a discarded statement-position map_err with an unannotated lambda (was an ICE).
{ Result, IoError, map_err, expect } = std.core.result
{ Context, Receiver } = std.concurrent.actor
heap = std.mem.heap
actor = std.concurrent.actor
Msg*: Inc | Add(i32)
Counter*: {
    n: i32,
}
Counter.impl(Receiver, {
    receive = (c: MutPtr<Counter>, ctx: Context<Msg>) void {
        ctx.msg.match ({
            .Inc    => {
                c.n = c.n + 1
            },
            .Add(k) => {
                c.n = c.n + k
            },
        })
    }
})
main = () i32 {
    // statement-position discarded map_err with unannotated lambda (was an ICE)
    bad: Result<i32, IoError> := .Err(.Eof)
    bad.map_err((e) { "boom" })
    // (c) the blessed idiom, fully unannotated — then actually drive the actor and verify state
    h := heap.gpa()
    counter := actor.spawn_handle(h.addr(), 8, Counter(n: 0)).expect("spawn counter")
    counter.send(.Inc)
    counter.send(.Add(4))
    counter.run()
    got := counter.actor().n
    counter.free(h.addr())
    got == 5 ? 0 : 1
}
