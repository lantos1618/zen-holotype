// Bump allocator backed by one owned block. Individual releases are no-ops.
{ AllocatorBackend, Allocator, AllocatorVTable, allocator_of } = std.mem.alloc
{ Result, IoError, ok, err } = std.core.result
{ is_null } = std.core.ptr
{ memcpy } = std.c.libc
Arena*: {
    buf: RawPtr<u8>,
    off: i64,
    cap: i64,
    bump = (a: MutPtr<Arena>, n: i64) RawPtr<u8> {
        rounded = (n + 7) / 8 * 8
        // Compare against remaining capacity so `off + rounded` cannot overflow.
        (n <= 0 || rounded < 0 || a.off > a.cap - rounded).match ({
            true  => null_ptr(),
            false => {
                p = a.buf.offset(a.off)
                a.off = a.off + rounded
                p
            },
        })
    }
    reset = (a: MutPtr<Arena>) void { a.off = 0 }
    used  = (a: Ptr<Arena>) i64 { a.off }
    allocator = (a: MutPtr<Arena>) Allocator {
        allocator_of(a.offset(0), arena_vtable.addr().offset(0))
    }
    free_in<A: AllocatorBackend> = (a: MutPtr<Arena>, backing: MutPtr<A>) void {
        backing.release(a.buf)
        a.buf = null_ptr()
        a.off = 0
        a.cap = 0
    }
    free<A: AllocatorBackend> = (a: MutPtr<Arena>, backing: MutPtr<A>) void { a.free_in(backing) }
}
// The unique name avoids flat-namespace collisions with other allocator constructors.
make_in*<A: AllocatorBackend> = (backing: MutPtr<A>, cap: i64) Result<Arena, IoError> {
    backing.try_acquire(cap).match ({
        .Ok(p)  => ok(Arena(
            buf: p,
            off: 0,
            cap: cap,
        )),
        .Err(e) => err(e),
    })
}
arena_acquire = (state: RawPtr<u8>, n: i64) RawPtr<u8> {
    slot: [Arena] = state.slice(1)
    a = slot[0].addr()
    a.bump(n)
}
// Resize allocates a new block; the old block remains live until reset.
arena_resize_in = (a: MutPtr<Arena>, p: RawPtr<u8>, n: i64) RawPtr<u8> {
    old_off = a.off
    np = a.bump(n)
    (np.is_null() || p.is_null()).match ({
        true  => np,
        false => {
            avail = old_off - (to_i64(p) - to_i64(a.buf))
            copy_len = (avail < n).then({ avail }, { n })
            (copy_len > 0).then({
                memcpy(np, p, copy_len)
            })
            np
        },
    })
}
arena_resize = (state: RawPtr<u8>, p: RawPtr<u8>, n: i64) RawPtr<u8> {
    slot: [Arena] = state.slice(1)
    arena_resize_in(slot[0].addr(), p, n)
}
arena_release = (state: RawPtr<u8>, p: RawPtr<u8>) void { }
arena_vtable ::= AllocatorVTable(
    vt_alloc: arena_acquire,
    vt_remap: arena_resize,
    vt_free: arena_release,
)
Arena.impl(AllocatorBackend, {
    acquire = (a: MutPtr<Arena>, n: i64) RawPtr<u8> { a.bump(n) }
    resize  = (a: MutPtr<Arena>, p: RawPtr<u8>, n: i64) RawPtr<u8> { arena_resize_in(a, p, n) }
    release = (a: MutPtr<Arena>, p: RawPtr<u8>) void { }
})
