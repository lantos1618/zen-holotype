// src/gen/gen_c/gen_c_try.zen
// What `.try()` is in C.
//
// `gen_c_flow.zen` is the other half of control flow — `.match`, the
// one conditional. The two are separated because they are two subjects
// that share only a destination: a match decides WHICH value, and this
// decides whether there is one at all.
//
// `.try()` IS A RETURN, and that is DESIGN.md's own framing: "it
// unwraps Ok, or returns the Err — or the None — from the ENCLOSING
// function", which is "a jump out through a frame boundary, exactly
// what `h.break(v)` does". So it lowers to a guard and a `return`, and
// the thing returned is built from the enclosing function's OWN Res
// type — never converted, because "there is no From".
//
// WIDENING A SET ON THE WAY OUT IS A CONSTRUCTION, NOT A COPY. `.try()`
// is legal when the callee's set is CONTAINED in the caller's, and this
// used to demand the two be the same type — which made every merge
// DESIGN.md promises a report. The caller's error value is built:
// tagged with the member the callee's error IS, carrying it unchanged.
// Nothing converts, and there is still no From; the value moves one box
// out.
//
// A DECLARED SET AND A STRUCTURAL ONE ARE TWO CONSTRUCTIONS. A declared
// enum widens through a VARIANT, which has a path and a name. `A | B`
// written inline, or a set sema inferred, has neither — its members are
// types, and the member type is its own name. `Carry` below is the
// three answers, and they are three because a variant name and a member
// type are not the same thing.
//
// A SET AND ANOTHER SPELLING OF THE SAME SET ARE NOT TWO SETS, and
// `Carry.Copy` is the whole of what that costs. DESIGN.md settled the
// numbering — "a union's tags are numbered by a canonical order over
// its members, never by declaration order" — so `Error = AllocError |
// IoError` and `WriteError = IoError | AllocError` agree tag for tag,
// and the propagation between them is bytes. This used to report, and
// reporting was right while the numbering was open: a memcpy across two
// numberings is a miscompilation rather than a missing feature.
//
// WHAT IS STILL NOT LOWERED: a STRICT widening — a callee's set into a
// caller's larger one, where no single variant of the caller's names
// the callee's whole set. `Error = WriteError | FsError` is a set of
// four where the enum has two variants, and a `.try()` raising
// `IoError | AllocError` into a set of three has a different canonical
// rank in each. That one genuinely needs a per-member map, because the
// two sets are genuinely two types; canonical numbering does not make
// it a copy and was never claimed to. It reports.

Ast, Expr, ExprId, Decl, DeclKind, Enum, Variant, Span = ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId, Ty, Types, TyNamed, TyRes, ResForm = sema.sema_ty
World, Def, decl_at = sema.sema_def
Checker, Ctx = sema.sema_check
Inst = sema.sema_inst
Emit = gen.gen_emit
sym_member, sym_variant, sym_gen = gen.gen_name
RES_PATH, is_failure = gen.gen_name
sym_union_variant, sym_union_member = gen.gen_name
GenFault = gen.gen_diag
CBackend = gen.gen_c.gen_c_state
enter_struct_tparams, leave_tparams = gen.gen_c.gen_c_mono
ctype, is_unit, variant_type, decl_ctx, decl_inst = gen.gen_c.gen_c_type
write_qname = gen.gen_c.gen_c_layout
Dest, write_dest, deliver = gen.gen_c.gen_c_stmt
res_type_of, write_set_value = gen.gen_c.gen_c_expr
declare_temp = gen.gen_c.gen_c_flow
unwind_to = gen.gen_c.gen_c_own


lower_try* = (be :: CBackend, node: Expr, operand: ExprId, ctx: Ctx,
              dst: Dest) Res<(), AllocError> {
    rt = res_type_of(be, operand, ctx).try();
    be.check.types.at(rt).match({
        Res(r) => lower_try_res(be, node, operand, r, rt, ctx, dst),
        _      => be.report_expr(operand,
                                 GenFault.Untyped("the operand of .try()")),
    })
}

lower_try_res = (be :: CBackend, node: Expr, operand: ExprId, r: TyRes,
                 rt: TyId, ctx: Ctx, dst: Dest) Res<(), AllocError> {
    tmp ::= be.alloc.String().try();
    sym_gen(tmp, "t", be.next_tmp()).try();
    declare_temp(be, rt, tmp.view()).try();
    deliver(be, operand, ctx, rt, Dest.Into(tmp.view())).try();
    write_guard(be, node, r, tmp.view(), ctx).try();
    unwrap(be, r, tmp.view(), dst).try();
    Ok(());
}

write_guard = (be :: CBackend, node: Expr, r: TyRes, tmp: str, ctx: Ctx)
              Res<(), AllocError> {
    be.write("if (").try();
    be.write(tmp).try();
    be.write(".zg_tag != ").try();
    tag ::= be.alloc.String().try();
    sym_variant(tag, RES_PATH, "Ok").try();
    be.write(tag.view()).try();
    be.writeln(") {").try();
    be.indent();
    // EVERY EARLY EXIT IS A SCOPE EXIT, and `.try()` is the common one:
    // it is "a jump out through a frame boundary", so every block from
    // here out to the function's own runs its defers and its drops
    // first. Depth 0 is the whole frame. The error is carried in `tmp`,
    // which is a temporary and is never tracked, so there is nothing
    // here the returned value could be aliasing.
    unwind_to(be, 0, "").try();
    propagate(be, node, r, tmp, ctx).try();
    be.dedent();
    be.writeln("}").try();
    Ok(());
}

// The value the enclosing function returns. It is built from the
// CALLER's own Res type and nothing is converted: "propagation merges
// sets" is a containment rule, not a conversion, and there is no From.
propagate = (be :: CBackend, node: Expr, r: TyRes, tmp: str, ctx: Ctx)
            Res<(), AllocError> {
    be.check.types.at(ctx.ret).match({
        Res(want) => propagate_into(be, node, r, want, tmp, ctx),
        _         => be.report(node.span.file, node.span,
                               GenFault.Unsupported(".try() outside a Res function")),
    })
}

// The two forms must agree — an absence cannot become a failure and
// sema has already said so — and then the error is either the caller's
// own or one member of it.
propagate_into = (be :: CBackend, node: Expr, r: TyRes, want: TyRes,
                  tmp: str, ctx: Ctx) Res<(), AllocError> {
    forms_agree(r.form, want.form).match({
        false => report_widening(be, node),
        true  => propagate_failure(be, node, r, want, tmp, ctx),
    })
}

// The error types only matter when there is an error to carry. An
// absence propagates as a tag and nothing else, and a bare `Ok(..)`
// raises nothing — "its error set is an open `_` with nothing in it" —
// so comparing that set to the caller's asks about a value neither one
// will ever hold.
propagate_failure = (be :: CBackend, node: Expr, r: TyRes, want: TyRes,
                     tmp: str, ctx: Ctx) Res<(), AllocError> {
    is_failure(r.form).match({
        false => write_propagation(be, r, want, tmp, ctx, Carry.Same),
        true  => propagate_error(be, node, r, want, tmp, ctx),
    })
}

// The same set carries straight across: one C type, one payload member,
// nothing to build. A different one is a widening, and `into` says which
// of the caller's members it widens through.
propagate_error = (be :: CBackend, node: Expr, r: TyRes, want: TyRes,
                   tmp: str, ctx: Ctx) Res<(), AllocError> {
    r.error.eq(want.error).match({
        true  => write_propagation(be, r, want, tmp, ctx, Carry.Same),
        false => propagate_wider(be, node, r, want, tmp, ctx),
    })
}

// ONE SET IN TWO SPELLINGS IS NOT A WIDENING AT ALL.
//
// DESIGN.md: "A union is its members. Order and spelling are not part
// of its identity" — `WriteError = IoError | AllocError`, `Error =
// AllocError | IoError` and the structural `IoError | AllocError` an
// inferred set arrives at with no declaration behind it are ONE type,
// and `set_of` is the question that says so. Two ids reach here for one
// type, so the ids are the wrong thing to compare.
//
// Which leaves only C's own nominal typing: one layout under two struct
// tags. `Carry.Copy` is that, and it is a COPY rather than a re-tagging
// switch because the tags agree — `gen_c_layout.write_enum_tags`
// numbers a union's members canonically, which is the layout rule the
// same DESIGN.md paragraph states and the whole reason to state it.
propagate_wider = (be :: CBackend, node: Expr, r: TyRes, want: TyRes,
                   tmp: str, ctx: Ctx) Res<(), AllocError> {
    same_set(be, r.error, want.error).match({
        true  => write_propagation(be, r, want, tmp, ctx, Carry.Copy),
        false => widen_or_report(be, node, r, want, tmp, ctx),
    })
}

same_set = (be :: CBackend, got: TyId, want: TyId) bool {
    be.check.set_of(got).eq(be.check.set_of(want))
}

// A DECLARED SET AND A STRUCTURAL ONE ARE WIDENED INTO DIFFERENTLY, and
// the fork is here rather than inside `carrier` because the two answers
// are not the same kind of thing: a declared enum widens through a
// VARIANT, which has a name, and a structural set has no names at all —
// its members are types, and the member type is the answer.
widen_or_report = (be :: CBackend, node: Expr, r: TyRes, want: TyRes,
                   tmp: str, ctx: Ctx) Res<(), AllocError> {
    be.check.types.at(want.error).match({
        Union(_) => widen_into_set(be, node, r, want, tmp, ctx),
        _        => widen_into_enum(be, node, r, want, tmp, ctx),
    })
}

widen_into_enum = (be :: CBackend, node: Expr, r: TyRes, want: TyRes,
                   tmp: str, ctx: Ctx) Res<(), AllocError> {
    carrier(be, want.error, r.error).match({
        None  => report_widening(be, node),
        Ok(v) => write_propagation(be, r, want, tmp, ctx, Carry.Variant(v)),
    })
}

// MEMBERSHIP IS THE WHOLE QUESTION for a structural set, and `set_has`
// is sema's own containment test — the one that admitted this `.try()`
// in the first place, so asking it again here cannot disagree with the
// check that let the program through.
//
// A set that does NOT contain the callee's error still reports. That is
// not a widening this backend has not got to yet; it is a widening that
// does not exist, and the only way to reach it is for sema to have let
// something past.
widen_into_set = (be :: CBackend, node: Expr, r: TyRes, want: TyRes,
                  tmp: str, ctx: Ctx) Res<(), AllocError> {
    be.check.types.set_has(want.error, r.error).match({
        false => report_widening(be, node),
        true  => write_propagation(be, r, want, tmp, ctx,
                                   Carry.Member(r.error)),
    })
}

// Which variant of the caller's set carries `err`.
//
// Compared by TYPE and not by name: two modules may each declare an
// `AllocError` and they are two types, so a name match would tag the
// wrong variant and the payload would be read as the wrong struct.
carrier = (be :: CBackend, set: TyId, err: TyId) Res<str> {
    be.check.types.at(set).match({
        Named(n) => named_carrier(be, n, err),
        _        => None,
    })
}

named_carrier = (be :: CBackend, n: TyNamed, err: TyId) Res<str> {
    decl_at(be.tree, n.decl).match({
        None  => None,
        Ok(d) => decl_carrier(be, n, d, err),
    })
}

decl_carrier = (be :: CBackend, n: TyNamed, d: Decl, err: TyId) Res<str> {
    d.kind.match({
        Enum(e) => variant_carrying(be, n, e.variants, err),
        _       => None,
    })
}

// The walk allocates and the answer is an absence, so the two are kept
// apart the way `variant_payload` above keeps them apart: a lookup that
// ran out of memory has not found a carrier.
variant_carrying = (be :: CBackend, n: TyNamed, variants: Vec<Variant>,
                    err: TyId) Res<str> {
    found ::= be.alloc.Vec<str>();
    collect_carrier(be, n, variants, err, found).match({
        Err(_) => None,
        Ok(_)  => found.get(0),
    })
}

collect_carrier = (be :: CBackend, n: TyNamed, variants: Vec<Variant>,
                   err: TyId, found :: Vec<str>) Res<(), AllocError> {
    ctx = decl_ctx(be, n);
    inst = decl_inst(be, n).try();
    mark = enter_struct_tparams(be, n.decl).try();
    variants.loop((h, v) {
        keep_carrier(be, n, v, err, ctx, inst, found).try();
    });
    leave_tparams(be, mark).try();
    Ok(());
}

keep_carrier = (be :: CBackend, n: TyNamed, v: Variant, err: TyId,
                ctx: Ctx, inst: Inst, found :: Vec<str>)
               Res<(), AllocError> {
    carries(be, n, v, err, ctx, inst).match({
        false => Ok(()),
        true  => found.add(v.name.text),
    })
}

carries = (be :: CBackend, n: TyNamed, v: Variant, err: TyId, ctx: Ctx,
           inst: Inst) bool {
    variant_type(be, n, v, ctx, inst).match({
        None  => false,
        Ok(t) => t.eq(err),
    })
}

forms_agree = (got: ResForm, want: ResForm) bool {
    is_failure(got).match({
        true  => is_failure(want),
        false => is_failure(want) == false,
    })
}

report_widening = (be :: CBackend, node: Expr) Res<(), AllocError> {
    be.report(node.span.file, node.span,
              GenFault.Unsupported("widening an error set through .try()")).try();
    Ok(());
}

// How the callee's error becomes the caller's.
//
// `Same` is one C type and a copy. `Variant` widens into a DECLARED
// enum, through the variant that names the callee's error type.
// `Member` widens into a STRUCTURAL set, which has no variant names —
// the member type is its own name, so the type is what is carried.
//
// `Copy` is the caller's set and the callee's being ONE set spelled two
// ways, where nothing is built and nothing is tagged: the bytes already
// say which member they are.
//
// Four cases and not a `Res<str>` with a convention: a variant name and
// a member type are two different things, and the C written for each is
// different too.
Carry = Same | Variant(str) | Member(TyId) | Copy

// `into` says how the caller's error payload is built out of the
// callee's — except for `Copy`, where it is not built.
write_propagation = (be :: CBackend, r: TyRes, want: TyRes, tmp: str,
                     ctx: Ctx, into: Carry) Res<(), AllocError> {
    into.match({
        Copy => write_copy(be, r, tmp, ctx),
        _    => write_built(be, r, want, tmp, ctx, into),
    })
}

write_built = (be :: CBackend, r: TyRes, want: TyRes, tmp: str,
               ctx: Ctx, into: Carry) Res<(), AllocError> {
    line ::= be.alloc.String().try();
    line.add_bytes("return (").try();
    ctype(be, ctx.ret, line).try();
    line.add_bytes("){ .zg_tag = ").try();
    failure_tag(be, r, line).try();
    is_failure(r.form).then(() {
        carry_error(be, want, tmp, into, line).try()
    });
    line.add_bytes(" };").try();
    be.writeln(line.view())
}

// The same set, carried across the two struct tags C insists on.
//
// THE TWO LAYOUTS ARE IDENTICAL BY CONSTRUCTION and that is what makes
// this three lines rather than a per-member switch: same members, so
// the same payload union; canonical tags, so the same numbering; and
// `sym_union_member` gives a member its own name on both sides. Bytes
// are the whole of the meaning, which is DESIGN.md's "Canonical
// numbering makes the widening a copy."
//
// `memcpy` and not an assignment because C's struct types are nominal:
// there is no operator that spells "these two layouts are one". The
// size is the DESTINATION's, which is safe because the sets are equal —
// `same_set` is what admitted this — so both fields are one size.
write_copy = (be :: CBackend, r: TyRes, tmp: str, ctx: Ctx)
             Res<(), AllocError> {
    w ::= be.alloc.String().try();
    sym_gen(w, "w", be.next_tmp()).try();
    write_carrier_decl(be, r, w.view(), ctx).try();
    write_carrier_copy(be, w.view(), tmp).try();
    ret ::= be.alloc.String().try();
    ret.add_bytes("return ").try();
    ret.add_bytes(w.view()).try();
    ret.add_bytes(";").try();
    be.writeln(ret.view())
}

write_carrier_decl = (be :: CBackend, r: TyRes, w: str, ctx: Ctx)
                     Res<(), AllocError> {
    line ::= be.alloc.String().try();
    ctype(be, ctx.ret, line).try();
    line.add_bytes(" ").try();
    line.add_bytes(w).try();
    line.add_bytes(" = { .zg_tag = ").try();
    failure_tag(be, r, line).try();
    line.add_bytes(" };").try();
    be.writeln(line.view())
}

write_carrier_copy = (be :: CBackend, w: str, tmp: str)
                     Res<(), AllocError> {
    line ::= be.alloc.String().try();
    line.add_bytes("memcpy(&").try();
    read_error(w, line).try();
    line.add_bytes(", &").try();
    read_error(tmp, line).try();
    line.add_bytes(", sizeof(").try();
    read_error(w, line).try();
    line.add_bytes("));").try();
    be.writeln(line.view())
}

failure_tag = (be :: CBackend, r: TyRes, out :: String) Res<(), AllocError> {
    is_failure(r.form).match({
        true  => out.sym_variant(RES_PATH, "Err"),
        false => out.sym_variant(RES_PATH, "None"),
    })
}

carry_error = (be :: CBackend, want: TyRes, tmp: str, into: Carry,
               out :: String) Res<(), AllocError> {
    out.add_bytes(", .zg_data.").try();
    out.sym_member("Err").try();
    out.add_bytes(" = ").try();
    into.match({
        Variant(v) => wrap_error(be, want.error, v, tmp, out),
        Member(m)  => wrap_set_error(be, want.error, m, tmp, out),
        // `Same` carries the value across untouched. `Copy` would too,
        // and never arrives: `write_propagation` sends it to
        // `write_copy` before anything is built, because a copy across
        // two struct tags is statements and not an initializer.
        _          => read_error(tmp, out),
    }).try();
    Ok(());
}

read_error = (tmp: str, out :: String) Res<(), AllocError> {
    out.add_bytes(tmp).try();
    out.add_bytes(".zg_data.").try();
    out.sym_member("Err").try();
    Ok(());
}

// The caller's set, built around the callee's error: tagged with the
// variant that names the callee's error TYPE, carrying the value
// unchanged. The two `Res`es are two C structs with two different
// payload members, so there was never a copy that could have worked —
// which is what the old report was telling the truth about.
wrap_error = (be :: CBackend, set: TyId, variant: str, tmp: str,
              out :: String) Res<(), AllocError> {
    qname ::= be.alloc.String().try();
    set_qname(be, set, qname).try();
    out.add_bytes("(").try();
    ctype(be, set, out).try();
    out.add_bytes("){ .zg_tag = ").try();
    out.sym_variant(qname.view(), variant).try();
    out.add_bytes(", .zg_data.").try();
    out.sym_member(variant).try();
    out.add_bytes(" = ").try();
    read_error(tmp, out).try();
    out.add_bytes(" }").try();
    Ok(());
}

// A STRUCTURAL SET IS BUILT THE SAME WAY WHEREVER IT IS BUILT, so the
// value itself is `gen_c_expr.write_set_value` and only the piece of C
// it wraps is decided here: the callee's error read out of the
// temporary. `wrap_error` above is the declared-enum twin, and it is
// separate because a declaration has a path and a variant name where a
// set has neither.
wrap_set_error = (be :: CBackend, set: TyId, member: TyId, tmp: str,
                  out :: String) Res<(), AllocError> {
    code ::= be.alloc.String().try();
    read_error(tmp, code).try();
    write_set_value(be, code.view(), member, set, out)
}

set_qname = (be :: CBackend, set: TyId, out :: String) Res<(), AllocError> {
    be.check.types.at(set).match({
        Named(n) => write_qname(be, out, n),
        _        => Ok(()),
    })
}

// `.try()` evaluates to the Ok payload. A unit payload has no member
// to read, so the destination gets nothing — which is right: `()` is
// not a value C can hold.
unwrap = (be :: CBackend, r: TyRes, tmp: str, dst: Dest)
         Res<(), AllocError> {
    is_unit(be, r.value).match({
        true  => Ok(()),
        false => write_unwrap(be, tmp, dst),
    })
}

write_unwrap = (be :: CBackend, tmp: str, dst: Dest) Res<(), AllocError> {
    place ::= be.alloc.String().try();
    place.add_bytes(tmp).try();
    place.add_bytes(".zg_data.").try();
    sym_member(place, "Ok").try();
    write_dest(be, dst, place.view())
}
