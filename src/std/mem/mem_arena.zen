// std.mem.mem_arena
// The arena, and the page authority it draws from.
//
// An arena owns pages, hands out bumps of them, and releases every one
// at once on drop — the default allocator (`alloc ::= env.mem.alloc()`
// in main, one per test, one per actor). The trade: nothing is ever
// reused, so allocation is a compare-and-add, and everything is
// reclaimed in one shot at the end.
//
// THE SPLIT THIS FILE DRAWS: Arena owns the memory and is what Drop
// applies to. The Alloc handle onto it owns nothing — two words, copies
// freely, not Drop. `alloc.Vec<i32>()` copies those two words in;
// dropping the arena releases everything they ever handed out.
//
// WHY Arena IS ONE POINTER: every Alloc method takes `self: @Self`, so
// allocation can't write the receiver's own bytes, yet a bump
// allocator obviously changes state on every allocation. Both are true
// because what changes lives BEHIND the pointer — Arena is a fixed
// handle onto an ArenaState, so a bitwise copy sees every bump
// (DESIGN.md's test for `:`).

Alloc, AllocError = std.mem.mem_alloc
Ptr = std.mem.mem_ptr

// how much an arena asks the page authority for when it needs more.
// Large enough that chaining is rare, small enough that one arena per
// test doesn't reserve the machine
PAGE_BYTES: usize = 65536

// bookkeeping ahead of every run raw hands out: its length in bytes,
// one usize wide. realloc needs the OLD length and DESIGN.md's
// signature (`realloc(p, count)`) doesn't carry one, so the allocation
// carries it instead — the one place std pays a word per allocation.
HEADER_BYTES: usize = usize.BITS / 8

// the strictest alignment any Zen value needs. An arena aligns every
// run to this instead of tracking T's own alignment, so realloc never
// asks Ptr a second layout question
ALIGN_MAX: usize = 16

// round an offset up to the next multiple of `align`. Alignments are
// powers of two, never zero, so `%` can't trap
align_up = (offset: usize, align: usize) usize {
    raised = offset + align - 1;
    raised - (raised % align)
}

// one region from the page authority. Header lives in its own first
// bytes (no second allocation); `prev` is the chain drop walks back
Page* = {
    prev: Ptr<Page>,
    base: Ptr<u8>,    // first byte this page hands out
    size: usize,      // bytes available from base
}

// everything about an arena that CHANGES, behind one pointer. Not
// exported: what an arena is made of isn't part of what it is (same
// reason Entry has no star in std.collections).
ArenaState = {
    mem: Mem,           // page authority; an arena never has ambient access
    head :: Ptr<Page>,  // the page currently being handed out of
    next :: usize,      // bytes used in that page
}

Arena* = {
    state: Ptr<ArenaState>,

    // hand `size` bytes out of the current page, or chain a new one.
    // Private: bumping is how an arena works, not what it offers
    bump = (self: @Self, s: ArenaState, size: usize, align: usize) Res<Ptr<u8>, AllocError> {
        page = s.head.read(0);
        slot = align_up(s.next, HEADER_BYTES);
        start = align_up(slot + HEADER_BYTES, align);
        (start + size <= page.size).match({
            true  => {
                self.state.write(0, ArenaState(mem: s.mem, head: s.head, next: start + size));
                run = page.base.offset(start);
                run.back(HEADER_BYTES).to<usize>().write(0, size);
                Ok(run)
            },
            false => self.chain(size, align),
        });
    }

    // acquire a fresh page sized to satisfy this request outright
    // (header, alignment, all), so the retry below runs exactly once
    chain = (self: @Self, size: usize, align: usize) Res<Ptr<u8>, AllocError> {
        s = self.state.read(0);
        want = HEADER_BYTES + align + size;
        bytes = (want > PAGE_BYTES).match({
            true  => want,
            false => PAGE_BYTES,
        });
        page = s.mem.page(bytes, s.head).try();
        self.state.write(0, ArenaState(mem: s.mem, head: page, next: 0));
        self.raw(size, align)
    }
}

// `self: @Self` on every one of these, deliberately: allocating
// changes the pages behind the handle, never the handle's own bytes —
// what lets Vec hold `alloc: Alloc` immutably and still grow through it.
Arena.impl(Alloc, {
    raw = (self: @Self, size: usize, align: usize) Res<Ptr<u8>, AllocError> {
        s = self.state.read(0);
        s.head.is_null().match({
            true  => self.chain(size, align),
            false => self.bump(s, size, align),
        });
    }

    // an arena never shrinks or reuses: hands out a fresh run, copies
    // the old one in, old run stays until the whole arena drops. A
    // null p is a fresh allocation with nothing to copy — an empty Vec
    // grows through this same call
    realloc = <T>(self: @Self, p: Ptr<T>, count: usize) Res<Ptr<T>, AllocError> {
        src = p.to<u8>();
        want = p.bytes(count);
        old = src.is_null().match({
            true  => 0,
            false => src.back(HEADER_BYTES).to<usize>().read(0),
        });
        keep = (old > want).match({
            true  => want,
            false => old,
        });
        dst = self.raw(want, ALIGN_MAX).try();
        dst.copy_from(src, keep);
        Ok(dst.to<T>())
    }

    // an arena frees nothing per allocation — every page goes back at
    // once on drop; this is the design, not a stub
    free = <T>(self: @Self, p: Ptr<T>) () {}
})

// The one `::` receiver in std.mem: Drop destroys the receiver's own
// bytes, run exactly once — why `consume` exists, and why an Arena
// can't be copied while the Alloc handle onto it can.
Arena.impl(Drop, {
    drop = (self :: @Self) () {
        s = self.state.read(0);
        page ::= s.head;
        loop(() { !page.is_null() }, (h) {
            // read the link BEFORE releasing: the header lives in the
            // region about to go away
            prev = page.read(0).prev;
            s.mem.release(page);
            page = prev;
        });
    }
})

// The page authority: the only thing that can obtain memory from the
// OS, received on Env — law 2, no ambient authority even for pages.
//
// Like Alloc it's a handle, so its methods are `:` too: asking for a
// page changes the OS's idea of this process, not the two words naming
// the authority.
Mem* = {
    // a fresh arena, rooted here. Owns no pages yet (first raw()
    // chains one) so nothing here can fail — `alloc ::= env.mem.alloc()`
    // needs no `.try()`, and Arena is a bare value not a Res
    alloc* = (self: @Self) Arena

    // one region of at least `size` bytes, page-aligned, header
    // written into its own first bytes, linked onto `prev`. Arena is
    // the only caller — no second door
    page* = (self: @Self, size: usize, prev: Ptr<Page>) Res<Ptr<Page>, AllocError>

    // hand a region back. Arena.drop calls this once per page, nothing
    // else calls it
    release* = (self: @Self, page: Ptr<Page>) ()
}
