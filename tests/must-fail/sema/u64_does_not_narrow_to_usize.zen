// u64 -> usize is NOT in std.core.num's conversion table: it is
// lossless only on a 64-bit pointer, so under the rule "only lossless
// widening lives here" it stays a narrowing -- a Res-returning function
// written on purpose. Issue 756 named this half and left it to be
// decided; this pins the decision. If `big.to_usize()` ever compiles,
// a silent truncating cast has been added to std and every u64 stored
// into a length can wrap unnoticed.
//
// position: the method name, after the dot.

main = (env: Env) Res<i32, AllocError> {
    big: u64 = 18446744073709551615;
    println("{}", big.to_usize());
    Ok(0);
}
