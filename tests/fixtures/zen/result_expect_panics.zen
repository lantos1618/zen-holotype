// expect's PANIC path: an Err receiver must ABORT the process (SIGABRT => exit 134 under sh) after
// writing the mandatory message to stderr. Driven by the `result_expect_panics` ShellCase in
// oracle_build.zen, which asserts both the exit code and the stderr text. The Ok paths (and every
// other combinator) are covered by result_combinators.zen.
{ Result, IoError, expect } = std.core.result
main = () i32 {
    bad: Result<i32, IoError> := .Err(.Denied)
    bad.expect("zen: panic: config must load\n")
}
