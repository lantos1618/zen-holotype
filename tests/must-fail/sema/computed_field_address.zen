// an impl-supplied field is computed on read: there is no storage, so
// there is nothing to take the address of. DESIGN.md, Declarations.
//
// position: the address-of expression.

Boxy = {
    width: i32,
    height: i32,
}

Circle = {
    radius: i32,
}

Circle.impl(Boxy, {
    width: self.radius * 2,
    height: self.radius * 2,
})

main = (env: Env) Res<i32, AllocError> {
    c = Circle(radius: 1);
    p = &c.width;
    Ok(0);
}
