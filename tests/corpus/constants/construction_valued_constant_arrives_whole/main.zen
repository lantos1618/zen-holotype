// A CONSTRUCTION IS A LEGAL CONSTANT VALUE, AND IT ARRIVES WHOLE.
//
// `is_pure_value` admits "a CONSTRUCTION of them" beside literals and
// operators -- "a compound literal names no function and reads nothing"
// (`gen_c_const.zen`). This is not an exotic case: parser.zen's
// `prev_end :: Pos = Pos(line: 1, col: 1)` is exactly it. A backend
// whose gate kept only literals reports "a constant whose value is not
// a literal" here (the user-facing wrong-reason bug ISSUES.md already
// records), or worse, lays the value out field-wise and drops half.
//
// The constant's fields are NON-ZERO on purpose, and deliberately not
// all equal: 3 and 14 swap places quietly if the construction reaches C
// as a brace list in the wrong order.

Pos = {
    line*: i64,
    col*: i64,
}

HOME*: Pos = Pos(line: 3, col: 14)

ORIGIN*: Pos = Pos(line: 0, col: 0)

main = (env: Env) Res<i32, AllocError> {
    println("home {} {}", HOME.line, HOME.col);

    // the constant flows into a local of its own type unchanged --
    // the use is the value, storage never enters into it
    there ::= HOME;
    println("copy {} {}", there.line, there.col);

    // the zero-valued construction, because Origin must be Origin:
    // a fold that special-cased non-zero fields still has to get this right
    println("origin {} {}", ORIGIN.line, ORIGIN.col);
    Ok(0);
}
