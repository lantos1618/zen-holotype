{ Result, IoError, err } = std.core.result
g = (ok: i32) Result<i32, IoError> { (ok == 1).then({ .Ok(5) }, { .Err(.NotFound) }) }
addv<T> = (r: Result<T, IoError>, base: T) Result<T, IoError> {
    v = r.match ({
        .Ok(x)  => x,
        .Err(e) => {
            return err(e)
        },
    })
    .Ok(v + base)
}
main = () i32 {
    a = addv(g(1), 30).match ({
        .Ok(v)  => v,
        .Err(e) => 0,
    })    // 35
    b = addv(g(0), 30).match ({
        .Ok(v)  => 0,
        .Err(e) => 1,
    })    // 1
    a + b
}    // 36
