// src/sema/sema_ty.zen
// What sema computes, not what the source wrote: `ast.Type` is a
// WRITTEN type; this is what it means, keyed on an id (AST_CONTRACT.md).
//
// TYPES ARE INTERNED: two types are equal exactly when their ids are
// equal, so every comparison (overload resolution, error-set merging,
// assignability) is a `u32` compare, never a structural walk — the only
// way to make `A | B` and `B | A` the same type without hand-written
// set equality everywhere
// (`tests/corpus/std/res_try_error_set_keeps_the_variant.zen` sends one
// `IoError.Full` through four spellings and demands `Full`).
//
// THE KEY IS THE IDENTITY: a type interns under a string built from its
// children's keys (one `Map` lookup, never a recursion). Nominal types
// key on their DECLARATION, not their name, so same-named types in two
// modules stay distinct; the key is not the display name, though —
// `write_name` walks the structure to print `Vec<i32>` where the key
// says `std.collections.Vec<i32>`.

Alloc, AllocError = std.mem
Vec, Map = std.collections
str, String = std.text
Eq, Hash, Hasher = std.core
Range = std.core
DeclId = sema.sema_id
write_usize = sema.sema_diag

// An interned type: the index into `Types`, and nothing else — small
// enough to compare, hash and copy without thinking about it.
//
// u32 for the reason `ast_id.zen` gives: `std.core.num` carries only
// lossless conversions, and u32 is the widest integer with both
// `to_usize` (to index the store) and `to_u64` (to hash).
TyId* = { index*: u32 }

TyId.impl(Eq, {
    eq ::= (self: @Self, other: @Self) bool { self.index == other.index }
})

TyId.impl(Hash, {
    hash = (self: @Self, hasher :: Hasher) u64 { self.index.to_u64() }
})

// The scalars the language builds in: the integers, the floats, `bool`,
// `str`, `()`. A separate kind from `Named`, not a declaration with no
// body — a primitive has no `DeclId` to be nominal on, and inventing
// one would put a fictional row in `Ast.modules`.
Prim* = { name*: str }

// A list rather than a lookup: the set is closed by the language, and a
// name that is almost one of these is a name, not a near miss.
//
// HERE AND NOT IN `sema_check.zen`: `named` below has to ask it, and the
// store is the one place that can hold this fact without importing the
// layer above.
is_prim* = (name: str) bool {
    is_integer(name) || is_float(name) || name.is_in(["bool", "str", "()"])
}

is_integer* = (name: str) bool {
    name.is_in(["i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "usize"])
}

is_float* = (name: str) bool { name.eq("f32") || name.eq("f64") }

// What an unsettled literal becomes where nothing settles it. Asked
// only where a literal's type is about to be MINTED into another type —
// a type argument (`sema_apply.settled_arg_ty`) or an array's element
// (`sema_type.settled_array`) — never of a scalar standing alone, whose
// `int` every integer position converts.
literal_default* = (name: str) str {
    name.eq("int").match({ true => "i32", false => "f64" })
}

// A declared struct or enum applied to its type arguments — `Vec<i32>`,
// `Res<(), AllocError>`, `Circle`. `decl` is the identity; `name` is
// only carried so a diagnostic need not walk back to the AST to say it.
TyNamed* = {
    decl*: DeclId,
    name*: str,
    args*: Vec<TyId>,
}

// A function type. Parameter NAMES are absent by language rule, not a
// saving: "parameter names are documentation, not identity" — `(a: i32,
// b: i32) i32` and `(x: i32, y: i32) i32` are the same type.
TyFn* = {
    params*: Vec<TyId>,
    ret*: TyId,
}

// A structural error set, not a new kind of type: an anonymous enum of
// its variants. CANONICAL — FLAT (a member is never itself a union),
// SORTED (`A | B` and `B | A` intern to one id), DEDUPED (merging a set
// into itself is a no-op) — and a union of one collapses to its member,
// so `Res<T, E>` with a single error type is that type, not a set.
TyUnion* = {
    members*: Vec<TyId>,
}

// `[i32, 4]` — a fixed array, on the stack, no length stored beside the
// bytes. THE COUNT IS PART OF THE TYPE (DESIGN.md:301: `[u8, 64]` and
// `[u8, 65]` are different types), so a literal index past a known
// length is a compile error, not a runtime trap; it's a FIELD, not a
// backend re-derivation, since `sema_trap.zen` compares a literal index
// against it and this is the only place the length exists.
//
// Not a `Named` on an invented declaration: a fixed array has no
// `DeclId` (it's a type constructor, not a name), and a nominal type
// keyed on a fiction would have to parse the count back out of its own
// spelling.
TyArray* = {
    elem*: TyId,
    count*: usize,
}

// An unsubstituted type parameter: the `T` of `Vec<T>` inside `Vec`'s
// own body. Nominal on its OWNER as well as its name, so the `T` of
// `Vec` and the `T` of `Map` are two types substitution can't confuse.
TyVar* = {
    name*: str,
    owner*: str,
}

// `Infer` is the `_` of `Res<Cfg, _>` — a hole law 6 permits inside a
// module and forbids at a `*` boundary. `Unknown` is POISON: a type
// sema could not compute because it already reported why, so it never
// triggers a second "expected Unknown".
// Which `Res` a value is, when that is not yet decided: `Ok(0)` is
// written before anyone knows whether it closes `Res<i32>` or
// `Res<i32, E>`. DESIGN.md's hoisting fires only when exactly ONE
// variant carries the type, so the form is carried rather than guessed
// — `Open` is what a bare `Ok(..)` produces until an expectation settles.
ResForm* = Absence | Failure | Open

// `Res<T>` and `Res<T, E>` are one shape — "propagation merging error
// sets never changes the shape of Res". `error` is meaningful only when
// `form` is `Failure`; under `Absence` it is the unit type and under
// `Open` it is the `Infer` hole.
TyRes* = {
    value*: TyId,
    error*: TyId,
    form*: ResForm,
}

Ty* = Prim(Prim)
    | Res(TyRes)
    | Named(TyNamed)
    | Fn(TyFn)
    | Union(TyUnion)
    | Array(TyArray)
    | Var(TyVar)
    | Infer
    | Unknown

// The interning store: `kinds` and `keys` are parallel, indexed by a
// `TyId`; `by_key` is the inverse. `count` shadows `kinds.len` as a u32
// for the reason `Ast` keeps its own counters — no narrowing conversion
// goes back from a `usize`, as `TyId` says above.
Types* = {
    kinds :: Vec<Ty>,
    keys :: Vec<String>,
    by_key :: Map<str, TyId>,
    count :: u32,
    alloc: Alloc,

    // -----------------------------------------------------------------
    // reading
    // -----------------------------------------------------------------

    // What a type IS. Traps on an id this store never handed out — same
    // as `Ast.expr_at`: a compiler bug, not input a caller can act on.
    at* = (self: @Self, id: TyId) Ty {
        i = id.index.to_usize();
        self.kinds.len - i - 1;
        self.kinds.ptr().read(i);
    }

    // The i-th type interned, BY POSITION — for the one reader that walks
    // the whole store without ids, `sema_depth.zen`. `at` answers about
    // an id a caller already holds; this doesn't.
    //
    // A `usize`, not a `TyId`: no narrowing conversion goes from a loop
    // index back to the `u32` a `TyId` holds, so only a kind comes back.
    kind_at* = (self: @Self, i: usize) Ty {
        self.kinds.len - i - 1;
        self.kinds.ptr().read(i);
    }

    // The intern key. Internal identity, not a name to show anyone.
    key_at* = (self: @Self, id: TyId) str {
        i = id.index.to_usize();
        self.keys.len - i - 1;
        self.keys.ptr().read(i).view();
    }

    count_of* = (self: @Self) u32 { self.count }

    // -----------------------------------------------------------------
    // interning
    //
    // One entry point. Everything below builds a key and calls it, so
    // there is exactly one place that decides whether a type is new.
    // -----------------------------------------------------------------

    intern* = (self :: @Self, key: str, kind: Ty) Res<TyId, AllocError> {
        // the None arm leads because a match takes its type from its
        // first arm, and this is the arm whose type is written down.
        self.by_key.get(key).match({
            None   => self.fresh(key, kind),
            Ok(id) => Ok(id),
        })
    }

    // A key this store has not seen. Never called twice for one key —
    // `intern` is the only caller and it has already looked.
    fresh = (self :: @Self, key: str, kind: Ty) Res<TyId, AllocError> {
        id = TyId(index: self.count);
        owned ::= self.alloc.String().try();
        owned.add_bytes(key).try();
        // the map borrows the OWNED copy's bytes, never the caller's:
        // a key built in a scratch String dies with it, and a Map row
        // pointing at dead bytes is the bug that has no symptom
        stable = owned.view();
        self.keys.add(owned).try();
        self.kinds.add(kind).try();
        self.by_key.set(stable, id).try();
        self.count = self.count + 1;
        Ok(id);
    }

    // -----------------------------------------------------------------
    // the constructors
    // -----------------------------------------------------------------

    // `i32`, `bool`, `str`, `()`. The key is the name: a primitive is
    // nominal on nothing else, and no declaration can shadow one.
    prim* = (self :: @Self, name: str) Res<TyId, AllocError> {
        self.intern(name, Ty.Prim(Prim(name: name)))
    }

    unit* = (self :: @Self) Res<TyId, AllocError> { self.prim("()") }

    bool_ty* = (self :: @Self) Res<TyId, AllocError> { self.prim("bool") }

    str_ty* = (self :: @Self) Res<TyId, AllocError> { self.prim("str") }

    // The hole, and the poison. Neither carries anything, so both are
    // interned under a name no source can spell.
    infer* = (self :: @Self) Res<TyId, AllocError> { self.intern(
        "_",
        Ty.Infer
    ) }

    unknown* = (self :: @Self) Res<TyId, AllocError> { self.intern(
        "?",
        Ty.Unknown
    ) }

    // A declared type applied to its arguments. `qname` (module-
    // qualified, e.g. `std.collections.Vec`), not `name`, is the
    // identity — what keeps same-named types in different modules two
    // types.
    //
    // A PRELUDE DECLARATION OF A PRIMITIVE'S NAME IS THAT PRIMITIVE:
    // `std.text`'s `str` and `std.core.num`'s `i32` give the primitive
    // the members the compiler already knows, not a second nominal
    // type. Minting one here duplicated `str` (`str_at`'s own
    // `str(data:.., len:..)` wasn't assignable to the declared `str`,
    // and both printed as `str`) — the member table
    // (`sema_member.prim_members`) and backend already assumed this, so
    // saying it where the type is MINTED makes the two the same `TyId`.
    named* = (self :: @Self, decl: DeclId, qname: str, name: str, args: Vec<TyId>)
             Res<TyId, AllocError> {
        is_prim(name).match({
            true  => self.prim(name),
            false => self.declared(decl, qname, name, args),
        })
    }

    declared = (self :: @Self, decl: DeclId, qname: str, name: str,
                args: Vec<TyId>) Res<TyId, AllocError> {
        key ::= self.alloc.String().try();
        key.add_bytes(qname).try();
        self.write_args(key, args).try();
        self.intern(
            key.view(),
            Ty.Named(TyNamed(decl: decl, name: name, args: args))
        )
    }

    // `Res<T>` — absence, carrying no reason because there is none.
    res_absence* = (self :: @Self, value: TyId) Res<TyId, AllocError> {
        unit = self.prim("()").try();
        self.res_form(value, unit, ResForm.Absence)
    }

    // `Res<T, E>` — failure, with the set a caller can act on.
    res_failure* = (self :: @Self, value: TyId, error: TyId)
                   Res<TyId, AllocError> {
        self.res_form(value, error, ResForm.Failure)
    }

    // What a bare `Ok(x)` is before an expectation settles it.
    res_open* = (self :: @Self, value: TyId) Res<TyId, AllocError> {
        hole = self.infer().try();
        self.res_form(value, hole, ResForm.Open)
    }

    res_form = (self :: @Self, value: TyId, error: TyId, form: ResForm)
               Res<TyId, AllocError> {
        key ::= self.alloc.String().try();
        key.add_bytes("Res").try();
        key.add_bytes(form.match({
            Absence => "?",
            Failure => "!",
            Open    => "~",
        })).try();
        key.add_bytes(self.key_at(value)).try();
        key.add_bytes(",").try();
        key.add_bytes(self.key_at(error)).try();
        self.intern(
            key.view(),
            Ty.Res(TyRes(value: value, error: error, form: form))
        )
    }

    // `[i32, 4]`. THE COUNT IS IN THE KEY, so `[i32, 4]` and `[i32, 5]`
    // intern as two ids.
    array* = (self :: @Self, elem: TyId, count: usize)
             Res<TyId, AllocError> {
        key ::= self.alloc.String().try();
        key.add_bytes("[").try();
        key.add_bytes(self.key_at(elem)).try();
        key.add_bytes(";").try();
        key.write_usize(count).try();
        key.add_bytes("]").try();
        self.intern(key.view(), Ty.Array(TyArray(elem: elem, count: count)))
    }

    // A type variable, nominal on its owner as well as its name.
    var* = (self :: @Self, name: str, owner: str) Res<TyId, AllocError> {
        key ::= self.alloc.String().try();
        key.add_bytes("%").try();
        key.add_bytes(name).try();
        key.add_bytes("@").try();
        key.add_bytes(owner).try();
        self.intern(key.view(), Ty.Var(TyVar(name: name, owner: owner)))
    }

    // A function type. Parameter names are not in the key because they
    // are not in the type.
    fn_ty* = (self :: @Self, params: Vec<TyId>, ret: TyId) Res<TyId, AllocError> {
        key ::= self.alloc.String().try();
        key.add_bytes("(").try();
        params.loop((h, p) {
            key.add_bytes(self.key_at(p)).try();
            key.add_bytes(",").try();
        });
        key.add_bytes(")->").try();
        key.add_bytes(self.key_at(ret)).try();
        self.intern(key.view(), Ty.Fn(TyFn(params: params, ret: ret)))
    }

    // -----------------------------------------------------------------
    // error sets — `union_ty` is the only constructor that CANONICALISES,
    // where the four spellings of one set become one id.
    // -----------------------------------------------------------------

    // `A | B`, from members in any order, any nesting, with repetition:
    // flattens, sorts, dedupes, and collapses a set of one to its member.
    union_ty* = (self :: @Self, members: Vec<TyId>) Res<TyId, AllocError> {
        flat ::= self.alloc.Vec<TyId>();
        self.flatten_into(flat, members).try();
        canon ::= self.alloc.Vec<TyId>();
        self.sort_unique_into(canon, flat).try();
        // a set of one IS its member: `Res<T, E>` never changes shape,
        // and "a single error type is a set of one"
        canon.len.match({
            0 => self.prim("()"),
            1 => canon.get(0).match({ None => self.unknown(), Ok(m) => Ok(m) }),
            _ => self.build_union(canon),
        })
    }

    // The pair form, which is what `.try()` propagation actually asks
    // for: the callee's set merged into the caller's.
    merge* = (self :: @Self, a: TyId, b: TyId) Res<TyId, AllocError> {
        both ::= self.alloc.Vec<TyId>();
        both.add(a).try();
        both.add(b).try();
        self.union_ty(both)
    }

    // A set of one is its member, so a non-union answers by equality.
    //
    // AN UNSUBSTITUTED TYPE PARAMETER IS NOT A SET (nor an empty one):
    // `ok_or<T, E>` answers with `E` untouched, so `.try()` asks whether
    // an uncomputed set is contained in the caller's — false there would
    // spell "there is no From", a conversion never asked for. Whether
    // this arm is still needed depends on substitution, which this file
    // does not decide.
    set_has* = (self: @Self, set: TyId, member: TyId) bool {
        self.at(set).match({
            Union(u) => self.vec_has(u.members, member),
            Var(_)   => true,
            _        => set.eq(member),
        })
    }

    // Every member of `narrow` must also be a member of `wide`, which is
    // the whole of "no implicit error conversion": `.try()` is legal when
    // the callee's set is already contained in the caller's declared
    // one, and illegal otherwise. Nothing is converted either way.
    set_within* = (self: @Self, narrow: TyId, wide: TyId) bool {
        self.at(narrow).match({
            Union(u) => self.all_within(u.members, wide),
            Var(_)   => true,
            _        => self.set_has(wide, narrow),
        })
    }

    // The members of a set, as a list, whatever its shape — a caller
    // walking an error set shouldn't have to know union vs. set-of-one.
    members_of* = (self: @Self, set: TyId, out :: Vec<TyId>) Res<(), AllocError> {
        self.at(set).match({
            Union(u) => self.copy_members(out, u.members),
            _        => out.add(set),
        }).try();
        Ok(());
    }

    // The loop family returns `Res<T>` (an absence), so a bare `loop`
    // can't sit in a match arm beside an `add` returning
    // `Res<(), AllocError>`; naming the walk gives both arms one type.
    copy_members = (self: @Self, out :: Vec<TyId>, members: Vec<TyId>)
                   Res<(), AllocError> {
        members.loop((h, m) { out.add(m).try() });
        Ok(());
    }

    // -----------------------------------------------------------------
    // naming, for diagnostics: the key is not showable (module/decl
    // indices), so this walks the structure to print what was written.
    // -----------------------------------------------------------------

    write_name* = (self: @Self, id: TyId, out :: String) Res<(), AllocError> {
        self.at(id).match({
            Prim(p)  => out.add_bytes(p.name),
            Var(v)   => out.add_bytes(v.name),
            Infer    => out.add_bytes("_"),
            Unknown  => out.add_bytes("<unknown>"),
            Named(n) => self.write_named(n, out),
            Res(r)   => self.write_res(r, out),
            Fn(f)    => self.write_fn(f, out),
            Union(u) => self.write_union(u, out),
            Array(a) => self.write_array(a, out),
        }).try();
        Ok(());
    }

    // The name as a fresh String, for a caller that wants one value
    // rather than a sink. Allocates, and says so.
    name_of* = (self: @Self, id: TyId) Res<String, AllocError> {
        out ::= self.alloc.String().try();
        self.write_name(id, out).try();
        Ok(out);
    }

    // -----------------------------------------------------------------
    // the pieces the above stand on
    // -----------------------------------------------------------------

    write_res = (self: @Self, r: TyRes, out :: String) Res<(), AllocError> {
        out.add_bytes("Res<").try();
        self.write_name(r.value, out).try();
        r.form.match({
            Failure => self.write_res_error(r, out),
            Absence => Ok(()),
            Open    => Ok(()),
        }).try();
        out.add_bytes(">").try();
        Ok(());
    }

    write_res_error = (self: @Self, r: TyRes, out :: String) Res<(), AllocError> {
        out.add_bytes(", ").try();
        self.write_name(r.error, out).try();
        Ok(());
    }

    write_named = (self: @Self, n: TyNamed, out :: String) Res<(), AllocError> {
        out.add_bytes(n.name).try();
        (n.args.len > 0).then(() { self.write_arg_names(n.args, out).try() });
        Ok(());
    }

    write_arg_names = (self: @Self, args: Vec<TyId>, out :: String)
                      Res<(), AllocError> {
        out.add_bytes("<").try();
        args.loop((h, i, a) {
            (i > 0).then(() { out.add_bytes(", ").try() });
            self.write_name(a, out).try();
        });
        out.add_bytes(">").try();
        Ok(());
    }

    write_fn = (self: @Self, f: TyFn, out :: String) Res<(), AllocError> {
        out.add_bytes("(").try();
        f.params.loop((h, i, p) {
            (i > 0).then(() { out.add_bytes(", ").try() });
            self.write_name(p, out).try();
        });
        out.add_bytes(") ").try();
        self.write_name(f.ret, out).try();
        Ok(());
    }

    // `[i32, 4]` — the source spelling, count and all, because the count
    // is what a diagnostic about a fixed array is usually about.
    write_array = (self: @Self, a: TyArray, out :: String)
                  Res<(), AllocError> {
        out.add_bytes("[").try();
        self.write_name(a.elem, out).try();
        out.add_bytes(", ").try();
        out.write_usize(a.count).try();
        out.add_bytes("]").try();
        Ok(());
    }

    write_union = (self: @Self, u: TyUnion, out :: String) Res<(), AllocError> {
        u.members.loop((h, i, m) {
            (i > 0).then(() { out.add_bytes(" | ").try() });
            self.write_name(m, out).try();
        });
        Ok(());
    }

    write_args = (self: @Self, key :: String, args: Vec<TyId>)
                 Res<(), AllocError> {
        (args.len > 0).then(() { self.write_args_run(key, args).try() });
        Ok(());
    }

    write_args_run = (self: @Self, key :: String, args: Vec<TyId>)
                     Res<(), AllocError> {
        key.add_bytes("<").try();
        args.loop((h, a) {
            key.add_bytes(self.key_at(a)).try();
            key.add_bytes(",").try();
        });
        key.add_bytes(">").try();
        Ok(());
    }

    build_union = (self :: @Self, canon: Vec<TyId>) Res<TyId, AllocError> {
        key ::= self.alloc.String().try();
        canon.loop((h, m) {
            key.add_bytes(self.key_at(m)).try();
            key.add_bytes("|").try();
        });
        self.intern(key.view(), Ty.Union(TyUnion(members: canon)))
    }

    // A member that is itself a union contributes its members, not
    // itself: "`A | B | C` is one Union of three, never a Union of a Union".
    flatten_into = (self: @Self, out :: Vec<TyId>, members: Vec<TyId>)
                   Res<(), AllocError> {
        members.loop((h, m) {
            self.at(m).match({
                Union(u) => self.flatten_into(out, u.members),
                _        => out.add(m),
            }).try();
        });
        Ok(());
    }

    // Insertion sort, dropping a member equal to the one before it.
    // A set has a handful of members and never more, so the shape that
    // is obviously correct is the one to write.
    sort_unique_into = (self: @Self, out :: Vec<TyId>, src: Vec<TyId>)
                       Res<(), AllocError> {
        src.loop((h, id) {
            // the arm whose type is WRITTEN leads, as in `intern`: a
            // bare `Ok(())` first would type the match as `Res<()>` and
            // drop the other arm's error set. docs/SEMA_BOOTSTRAP_FIXES.md.
            self.vec_has(out, id).match({
                false => self.insert_ordered(out, id),
                true  => Ok(()),
            }).try();
        });
        Ok(());
    }

    // Append, then walk the new element down to its place. No break,
    // for the reason `sort_unique_into` gives.
    insert_ordered = (self: @Self, out :: Vec<TyId>, id: TyId)
                     Res<(), AllocError> {
        out.add(id).try();
        n = out.len;
        Range(1, n).loop((h, k) {
            j    = n - k;
            prev = out.get(j - 1).match({ Ok(v) => v, None => id });
            cur  = out.get(j).match({ Ok(v) => v, None => id });
            self.before(cur, prev).then(() {
                put(out, j - 1, cur).try();
                put(out, j, prev).try();
            });
        });
        Ok(());
    }

    // Lexicographic order on the intern keys. Ordering by id would be
    // canonical too, but would print a set in whatever order it happened
    // to be interned; ordering by key is stable across runs.
    before = (self: @Self, a: TyId, b: TyId) bool {
        key_before(self.key_at(a), self.key_at(b))
    }

    vec_has = (self: @Self, haystack: Vec<TyId>, needle: TyId) bool {
        Range(0, haystack.len).find((i) {
            haystack.get(i).match({ Ok(v) => v.eq(needle), None => false })
        }).match({ Ok(_) => true, None => false })
    }

    all_within = (self: @Self, members: Vec<TyId>, wide: TyId) bool {
        Range(0, members.len).find((i) {
            members.get(i).match({
                Ok(m) => self.set_has(wide, m) == false,
                None  => false,
            })
        }).match({ Ok(_) => false, None => true })
    }
}

// `alloc.Types()` — a ufcs function whose first parameter is an Alloc,
// beside the type it builds, exactly as `Vec`, `Map` and `Ast` are. A
// bare value and not a `Res`: an empty store owns no pages, so
// construction cannot fail.
Types* = (a: Alloc) Types {
    Types(
        kinds: a.Vec<Ty>(),
        keys: a.Vec<String>(),
        by_key: a.Map<str, TyId>(),
        count: 0,
        alloc: a,
    )
}

// `Vec.set` refuses an index past the end with a bare `Res<()>` — no
// reason carried, so `.try()` won't lift it into `Res<_, AllocError>`
// ("a None never becomes an Err"). Both indices here are in range by
// construction (`j` walks `n-1..1` over a Vec of length `n`), so this
// names the only possible refusal reason.
put* = (out :: Vec<TyId>, i: usize, v: TyId) Res<(), AllocError> {
    out.set(i, v).match({
        None  => Err(AllocError.OutOfMemory),
        Ok(_) => Ok(()),
    })
}

// Lexicographic byte order on two strings.
//
// A DUPLICATE OF A CLOSED GAP: `str.before` now exists in
// `std.text.text_str`, and its own comment names "sema's type-key
// ordering" as one of the three copies it consolidated. Delete this and
// the `sema.zen` re-export; import `str.before`.
// (`docs/SEMA_BOOTSTRAP_FIXES.md` §4 still records the gap as open and
// is itself stale.)
key_before* = (a: str, b: str) bool {
    shorter = (a.len < b.len).match({ true => a.len, false => b.len });
    Range(0, shorter).find((i) { a[i] != b[i] }).match({
        Ok(i) => a[i] < b[i],
        None  => a.len < b.len,
    })
}
