// AN ALIAS FOLDS TO WHAT THE USER WROTE (#768). `declared_or_alias`
// (`sema_type.zen`, "AN ALIAS IS THE TYPE") collapses `P2 = Point` so
// members and impls work through the alias — and that same collapse
// used to answer `@meta(x: P2).name` with "Point", silently, when the
// user asked for the name of P2. `sema_meta.zen` now resolves the
// written type through `written_type`, one step short of the collapse,
// so each spelling answers with its own declaration's name.
//
// MUTATION RESISTANCE (design_meta.md §6.4): every name is printed
// WITH ITS LENGTH. Under the old resolution this prints
// "Point 5 / Box 3 Box 3" too — plausible, and wrong only in the
// middle word — so the SECOND line pins the other half of #768: two
// instantiations of one generic, each folding its own access, read
// back through the written type each `Meta` node carries. A backend
// that reached for the wrong field lowers both as one literal and the
// line stops being `Box 3 Box 3`.
//
// The enum-target alias rides along: the DECL of `Colors = Color` is
// `Alias`, not `Enum`, and the written name must survive that too.

Point = {
    x: i64,
    y: i64,
}

Color = Red | Green

P2    = Point
Colors = Color

Box<T> = {
    v: T,
}

first = () str { @meta(x: Box<i64>).name }

second = () str { @meta(x: Box<bool>).name }

main = (env: Env) Res<i32, AllocError> {
    println("{} {}", @meta(x: P2).name, @meta(x: P2).name.len);
    println("{} {} {} {}", first(), first().len, second(), second().len);
    println("{} {}", @meta(x: Colors).name, @meta(x: Colors).name.len);
    Ok(0);
}
