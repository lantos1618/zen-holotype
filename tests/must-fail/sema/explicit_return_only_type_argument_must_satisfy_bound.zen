// A written type argument is still checked against its declaration's bound
// when the parameter appears only in the generic list. No value argument is
// available for the old direct-parameter bound check to inspect.

Boxy = {
    width: i32,
}

Dot = {}

measure = <T: Boxy>() i32 { 1 }

main = (env: Env) Res<i32, AllocError> {
    println("{}", measure<Dot>());
    Ok(0);
}
