// hoisting counts CARRIERS, and a slot nobody has substituted yet is not
// one. `wrap` promises `Res<i32, E>` for an `E` the call site picks, so
// at the point the body is checked the failure slot is the type
// parameter itself -- and a type parameter agrees with everything,
// deliberately, because "never invent a diagnostic out of missing
// information".
//
// Counting it would make this ambiguous: two carriers for one `i32`,
// reported against a function that is not ambiguous at any call site.
// So the count stands down on an unsettled slot and the bare value
// lifts, exactly as it does in `hoist_single_variant` where the set is
// written.
//
// The ambiguous case is must-fail/sema/hoist_ambiguous, where BOTH slots
// are settled and both are `i32`.

CalcError = | Negative

wrap = <E>(n: i32) Res<i32, E> {
    n * 2;
}

main = (env: Env) Res<i32, CalcError> {
    println("{}", wrap<CalcError>(21).try());
    Ok(0);
}
