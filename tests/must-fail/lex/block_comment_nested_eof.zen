// FORK 2 of 2 on NESTED BLOCK COMMENTS. DESIGN.md does not decide.
// This file assumes nesting IS supported: the inner /* opens a second
// level, the one */ closes only that level, and the comment then runs
// to EOF. The other reading is
// tests/corpus/lex/block_comment_single_close.zen, same source.
/* a /* b */
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    println("unreachable under the nesting reading");
    Ok(0);
}
