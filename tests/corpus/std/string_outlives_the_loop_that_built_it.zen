// tests/corpus/std/string_outlives_the_loop_that_built_it.zen
// the String is declared OUTSIDE the loop and written from inside
// it, then read after the loop and after the block have both gone.
// its bytes live in the arena, not in the frame that appended
// them: a String backed by loop-local storage prints garbage here

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    sb    ::= alloc.String("").try();

    {
        Range(0, 5).loop((h, value) {
            sb.fmt("{},", value).try();
        });
        println("inside {}", sb.view());
    }

    println("outside {}", sb.view());
    Ok(0);
}
