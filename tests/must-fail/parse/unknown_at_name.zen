// STYLE.md: the `@` namespace has exactly three entries -- @Self,
// @meta, @scope -- and adding a fourth is a design change. `@foo` is
// not a name a user may introduce.
//
// WHAT IS ASSERTED IS THE RULE AND NOT THE NAME. This file used to
// demand the offending `@foo` back in the sentence; src/lex/lex_diag.zen
// decides otherwise, and says so out loud -- "A FAULT CARRIES NO TEXT.
// `message` is a fixed sentence and the span names the bytes" -- which
// is what keeps a Diag comparable, printable and free of an allocation
// per mistake. The position below IS the `@foo`, so nothing is lost
// except a quotation the reader already has in front of them.
main = (env: Env) Res<i32, ArgError> {
    n = @foo(1);
    println("{}", n);
    Ok(0);
}
