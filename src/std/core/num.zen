// std.core.num
//
// The extremes and the width of every primitive numeric type.
//
// A struct body may bind a name to a VALUE, not a field — read as
// `Type.NAME` (as `Shape.Unit` does). A field declares storage per
// value; a constant declares one value per type, the only kind i32
// could have, having no instances. Every constant is starred (law 6:
// `*` means the name crosses a module boundary, so its type is
// written, not inferred — `i32.MAX` is read from outside std). BITS
// is a usize so it's usable wherever a comptime value is:
// `buf: [u8, i32.BITS]`. The arithmetic these bound TRAPS rather than
// wraps — `i32.MAX + 1` aborts (a trap the compiler can prove will
// fire is a compile error); `+% -% *%` are the wrapping forms. Holds
// for unsigned too: a u8 reaching 256 is the same bug an i8 reaching
// 128 is.

// `Eq` is imported and not inherited from the prelude: this file IS
// part of the prelude, and the impls at the foot of it need the name.
// std.core.eq imports nothing, so the graph still points down.
Eq = std.core.eq

// Negative extremes are plain literals: unary minus on a positive
// that doesn't fit the type alone (classic; pinned by
// tests/corpus/lex/number_i32_min_literal.zen). In C that token
// sequence is a hazard, so gen_c emits `(-2147483647 - 1)` — a
// backend concern, not a reason to split the value here.

i8* = {
    MIN*: i8 = -128,
    MAX*: i8 = 127,
    BITS*: usize = 8,
}

i16* = {
    MIN*: i16 = -32768,
    MAX*: i16 = 32767,
    BITS*: usize = 16,
}

i32* = {
    MIN*: i32 = -2147483648,
    MAX*: i32 = 2147483647,
    BITS*: usize = 32,
}

i64* = {
    MIN*: i64 = -9223372036854775808,
    MAX*: i64 = 9223372036854775807,
    BITS*: usize = 64,
}

u8* = {
    MIN*: u8 = 0,
    MAX*: u8 = 255,
    BITS*: usize = 8,
}

u16* = {
    MIN*: u16 = 0,
    MAX*: u16 = 65535,
    BITS*: usize = 16,
}

u32* = {
    MIN*: u32 = 0,
    MAX*: u32 = 4294967295,
    BITS*: usize = 32,
}

// u64.MAX fits no signed C type, so gen_c suffixes it — the subject
// of tests/corpus/codegen/literal_boundaries_unsigned.zen; constant
// path and literal path must agree.
u64* = {
    MIN*: u64 = 0,
    MAX*: u64 = 18446744073709551615,
    BITS*: usize = 64,
}

// usize is the target's pointer width — the one property here that
// isn't a language constant. Both DESIGN.md architectures
// (Builder.arch: X86_64/Arm64) are 64-bit; a 32-bit target changes
// only this declaration. No corpus test may print a usize extreme,
// same reason.
usize* = {
    MIN*: usize = 0,
    MAX*: usize = 18446744073709551615,
    BITS*: usize = 64,
}

// MIN on a float is the type's minimum — the most negative FINITE
// value, like i32's MIN — deliberately NOT C's FLT_MIN (smallest
// positive normal, a different quantity, a classic footgun).
//
// Digits are written out: Zen's numeric literals are decimal `d.d`
// only, no exponent form for 3.4028235e38. Both values are integers,
// so the expansion is exact, not rounded.

f32* = {
    MIN*: f32 = -340282346638528859811704183484516925440.0,
    MAX*: f32 = 340282346638528859811704183484516925440.0,
    BITS*: usize = 32,
}

f64* = {
    MIN*: f64 = -.0,
    MAX*: f64 = .0,
    BITS*: usize = 64,
}

// conversions are methods, never a cast keyword. Only LOSSLESS
// widening lives here — a narrowing conversion can fail, so it
// belongs in a Res-returning function written on purpose.
to_u16* = (self: u8) u16
to_u32* = (self: u8) u32
to_u64* = (self: u8) u64
to_u32* = (self: u16) u32
to_u64* = (self: u16) u64
to_u64* = (self: u32) u64
to_usize* = (self: u32) usize

to_i16* = (self: i8) i16
to_i32* = (self: i8) i32
to_i64* = (self: i8) i64
to_i32* = (self: i16) i32
to_i64* = (self: i16) i64
to_i64* = (self: i32) i64

to_i32* = (self: u8) i32
to_i64* = (self: u8) i64
to_i64* = (self: u16) i64
to_i64* = (self: u32) i64

to_f64* = (self: i32) f64
to_f64* = (self: f32) f64

// The same matrix as BOUNDS, so generic code can name "widens to u32":
// one behavior per target, each impl supplying the intrinsic declared
// above. Nothing here adds a conversion — the declarations above are
// still the whole list. A bound travels with the type's impls, so the
// prelude needs the behavior NAMES, not the impls.
// The fields are `widen_*`, never `to_*`: a field named `to_u32` would
// give `x.to_u32()` two answers — this member and the free function —
// and the two compilers resolve that collision differently (the law
// behind make ufcs, which does not read impl members)
ToU16* = { widen_u16* = (self: @Self) u16 }
ToU32* = { widen_u32* = (self: @Self) u32 }
ToU64* = { widen_u64* = (self: @Self) u64 }
ToUsize* = { widen_usize* = (self: @Self) usize }
ToI16* = { widen_i16* = (self: @Self) i16 }
ToI32* = { widen_i32* = (self: @Self) i32 }
ToI64* = { widen_i64* = (self: @Self) i64 }
ToF64* = { widen_f64* = (self: @Self) f64 }

u8.impl(ToU16, { widen_u16 = to_u16 })
u8.impl(ToU32, { widen_u32 = to_u32 })
u8.impl(ToU64, { widen_u64 = to_u64 })
u8.impl(ToI32, { widen_i32 = to_i32 })
u8.impl(ToI64, { widen_i64 = to_i64 })

u16.impl(ToU32, { widen_u32 = to_u32 })
u16.impl(ToU64, { widen_u64 = to_u64 })
u16.impl(ToI64, { widen_i64 = to_i64 })

u32.impl(ToU64, { widen_u64 = to_u64 })
u32.impl(ToUsize, { widen_usize = to_usize })
u32.impl(ToI64, { widen_i64 = to_i64 })

i8.impl(ToI16, { widen_i16 = to_i16 })
i8.impl(ToI32, { widen_i32 = to_i32 })
i8.impl(ToI64, { widen_i64 = to_i64 })

i16.impl(ToI32, { widen_i32 = to_i32 })
i16.impl(ToI64, { widen_i64 = to_i64 })

i32.impl(ToI64, { widen_i64 = to_i64 })
i32.impl(ToF64, { widen_f64 = to_f64 })

f32.impl(ToF64, { widen_f64 = to_f64 })

// EQUALITY, SO A PRIMITIVE CAN BE THE SUBJECT OF `<T: Eq>`. Every
// integer already compares — `a == b` is C's own operator and stays
// that way, because `scalar_eq` (sema_bound.zen) and the backend both
// answer "every primitive but `str` and `()`" before any impl is
// consulted. These impls add a `.eq` METHOD and change no `==` in the
// emitted C; what they buy is `b.is_in([' ', '\t'])` and every other
// `<T: Eq>` bound, which until now rejected `u8` outright.
//
// HERE AND NOT IN std.core.eq, and that is not a filing preference: an
// impl is only ever consulted through the module that DECLARES its
// target, so `u8.impl(Eq, ..)` is only real in the file that writes
// `u8* = {..}`. Written next to the trait it would compile clean and be
// invisible — the silence `SemaFault.OrphanImpl` now ends.
//
// NO FLOAT IMPL, deliberately. `NaN == NaN` is false, so an `f64` is
// not equal to itself and `xs.is_in([x])` would answer "no" about a
// value that IS in the list. That is the wrong-answer-that-compiles
// shape, and a float wanting membership should say what it means about
// NaN at the call site rather than inherit a silent law from here.
i8.impl(Eq, { eq ::= (self: @Self, other: @Self) bool { self == other } })
i16.impl(Eq, { eq ::= (self: @Self, other: @Self) bool { self == other } })
i32.impl(Eq, { eq ::= (self: @Self, other: @Self) bool { self == other } })
i64.impl(Eq, { eq ::= (self: @Self, other: @Self) bool { self == other } })

u8.impl(Eq, { eq ::= (self: @Self, other: @Self) bool { self == other } })
u16.impl(Eq, { eq ::= (self: @Self, other: @Self) bool { self == other } })
u32.impl(Eq, { eq ::= (self: @Self, other: @Self) bool { self == other } })
u64.impl(Eq, { eq ::= (self: @Self, other: @Self) bool { self == other } })
usize.impl(Eq, { eq ::= (self: @Self, other: @Self) bool { self == other } })
