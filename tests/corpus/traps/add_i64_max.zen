// tests/corpus/traps/add_i64_max.zen
// i64.MAX + 1 traps. + is the checked operator, +% is the
// wrapping one. nothing is printed: the trap fires first

// main must name an error type. a trap never lifts into Res:
// it aborts the process
Error = Overflow | DivideByZero | OutOfBounds

main = (env: Env) Res<i32, Error> {
    x: i64 = i64.MAX;
    sum = x + 1;
    println("{}", sum);
    Ok(0);
}
