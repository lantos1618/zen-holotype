// src/gen/gen_c/gen_c_main.zen
// `main`, and the one value the C runtime hands a Zen program.
//
// `main` is the one name the C standard fixes for us, and the one place
// a Zen function is called by something that is not Zen. That makes it
// the seam where two conventions meet: C's `int` exit status against
// Zen's `Res`, and C's `argc`/`argv` against `Env`.
//
// IT LIVES BESIDE `gen_c_decl.zen` RATHER THAN IN IT because the two
// answer different questions. That file's subject is "what is a
// declaration in C, and what is a translation unit" — a walk, a queue
// and an assembly order. This one's is a single function that no Zen
// declaration describes, written from the outside in.
//
// AND IT IS EMITTED LAST, after every type and every body, which is why
// `zg_argv_vec` can be written here at all: it names the mangled
// `Vec<str>`, and that is not a name until a program has asked for one.

Ast, Decl, DeclKind, Function, Param, Span, Ident, TypeId = ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId, Ty, Types, TyRes = sema.sema_ty
World, Def, decl_at = sema.sema_def
Checker, Ctx = sema.sema_check
Inst = sema.sema_inst
Emit = gen.gen_emit
sym_fn, sym_member, sym_variant, RES_PATH = gen.gen_name
CBackend = gen.gen_c.gen_c_state
ctype, is_c_integer = gen.gen_c.gen_c_type
field_of = gen.gen_c.gen_c_cap
plain_ctx, return_type = gen.gen_c.gen_c_decl

emit_main* = (be :: CBackend, mi: usize, out :: Emit) Res<(), AllocError> {
    found ::= be.alloc.Vec<Def>();
    be.check.world.own_defs(mi, "main", found).try();
    found.get(0).match({
        None  => Ok(()),
        Ok(d) => write_main(be, d, out),
    })
}

write_main = (be :: CBackend, d: Def, out :: Emit) Res<(), AllocError> {
    decl_at(be.tree, d.id).match({
        None  => Ok(()),
        Ok(x) => write_main_call(be, d, x, out),
    })
}

write_main_call = (be :: CBackend, d: Def, x: Decl, out :: Emit)
                  Res<(), AllocError> {
    x.kind.match({
        Function(f) => write_entry(be, d, f, out),
        _           => Ok(()),
    })
}

write_entry = (be :: CBackend, d: Def, f: Function, out :: Emit)
              Res<(), AllocError> {
    mi = d.id.module.to_usize();
    ret = return_type(be, f, plain_ctx(be, mi)).try();
    sig ::= be.alloc.Vec<TyId>();
    signature(be, f, mi, sig).try();
    rows ::= be.alloc.Vec<TyId>();
    argv_rows(be, sig, rows).try();
    call ::= be.alloc.String().try();
    empty ::= be.alloc.Inst();
    sym_fn(call, be.check.types, be.check.world, d.qname, sig, empty).try();
    call.add_bytes("(").try();
    write_entry_args(be, sig, call).try();
    call.add_bytes(")").try();
    rows.get(0).match({
        None  => Ok(()),
        Ok(v) => emit_argv_vec(be, v, out),
    }).try();
    out.say(main_head(rows.len > 0)).try();
    out.indent();
    write_exit(be, ret, call.view(), out).try();
    out.dedent();
    out.say("}").try();
    Ok(());
}

// `main` TAKES C'S OWN `argc`/`argv` WHEN SOMETHING READS THEM, and
// `void` when nothing does — a parameter no line mentions is a warning
// on a conforming compiler and a promise this backend does not need to
// make.
main_head = (wants_argv: bool) str {
    wants_argv.match({
        true  => "int main(int argc, char **argv) {",
        false => "int main(void) {",
    })
}

// The signature again, without binding anything: `emit_main` runs
// after every frame has been reset, and the symbol has to match the
// one the prototype printed.
signature = (be :: CBackend, f: Function, mi: usize, sig :: Vec<TyId>)
            Res<(), AllocError> {
    ctx = plain_ctx(be, mi);
    f.params.loop((h, p) {
        p.type.match({
            Ok(t) => add_sig(be, t, ctx, sig),
            None  => Ok(()),
        }).try();
    });
    Ok(());
}

add_sig = (be :: CBackend, t: TypeId, ctx: Ctx, sig :: Vec<TyId>)
          Res<(), AllocError> {
    sig.add(be.check.type_from_ast(t, ctx).try())
}

// THE `Env` IS BUILT AND NOT ZEROED. `(Env){0}` made `env.argv.len` 0
// in every program this backend ever compiled — so a compiler could
// not be told what to compile, and no stage-2 binary could reach a
// fixpoint. Every OTHER parameter is still a zero value: `Env` is the
// capability root and `argv` is the one field the C runtime hands us.
write_entry_args = (be :: CBackend, sig: Vec<TyId>, out :: String)
                   Res<(), AllocError> {
    sig.loop((h, i, t) {
        (i > 0).then(() { out.add_bytes(", ").try() });
        write_entry_arg(be, t, out).try();
    });
    Ok(());
}

write_entry_arg = (be :: CBackend, t: TyId, out :: String)
                  Res<(), AllocError> {
    argv_field(be, t).try().match({
        None    => write_zero(be, t, out),
        Ok(_)   => write_env_value(be, t, out),
    })
}

write_env_value = (be :: CBackend, t: TyId, out :: String)
                  Res<(), AllocError> {
    out.add_bytes("((").try();
    ctype(be, t, out).try();
    out.add_bytes("){ .").try();
    sym_member(out, "argv").try();
    out.add_bytes(" = zg_argv_vec(argc, argv) })").try();
    Ok(());
}

// The `Vec<str>` an `argv` field holds, when the parameter has one.
// Asked of the TYPE and not of its name: what makes a struct the
// capability root here is that it carries the rows, and a program with
// no `Env` at all simply has no such parameter.
argv_field = (be :: CBackend, t: TyId) Res<Res<TyId>, AllocError> {
    field_of(be, t, "argv")
}

argv_rows = (be :: CBackend, sig: Vec<TyId>, out :: Vec<TyId>)
            Res<(), AllocError> {
    sig.loop((h, t) {
        argv_field(be, t).try().match({
            None  => Ok(()),
            Ok(v) => out.add(v),
        }).try();
    });
    Ok(());
}

// -----------------------------------------------------------------
// `zg_argv_vec`
//
// Written here rather than in `gen_c_runtime.zen` because it names the
// mangled `Vec<str>`, which is not a name until a program asks for one.
//
// THE ROWS BORROW AND ARE NEVER FREED. `argv` is storage the C runtime
// already owns and it lasts exactly as long as the process, so a row is
// a pointer and a length into it rather than a copy. The one `malloc`
// is the row array itself, and it outlives every reader by
// construction.
//
// THE `Vec`'S ALLOCATOR STAYS ZERO, so growing `env.argv` would fault.
// Nobody grows argv — and the alternative is handing `main`'s arena to
// a value built before any arena exists.
// -----------------------------------------------------------------

emit_argv_vec = (be :: CBackend, v: TyId, out :: Emit)
                Res<(), AllocError> {
    head ::= be.alloc.String().try();
    head.add_bytes("static ").try();
    ctype(be, v, head).try();
    head.add_bytes(" zg_argv_vec(int argc, char **argv) {").try();
    out.say(head.view()).try();
    out.indent();
    write_empty_rows(be, v, out).try();
    out.say("zg_str *rows = (zg_str *)malloc((size_t)argc * sizeof *rows);").try();
    write_rows_guard(be, v, out).try();
    out.say("for (int i = 0; i < argc; i++) {").try();
    out.indent();
    out.say("rows[i].data = (unsigned char *)argv[i];").try();
    out.say("rows[i].len = strlen(argv[i]);").try();
    out.dedent();
    out.say("}").try();
    write_filled_rows(be, v, out).try();
    out.dedent();
    out.say("}").try();
    out.line().try();
    Ok(());
}

write_empty_rows = (be :: CBackend, v: TyId, out :: Emit)
                   Res<(), AllocError> {
    line ::= be.alloc.String().try();
    line.add_bytes("if (argc <= 0) return ").try();
    write_vec_literal(be, v, "0", "0", line).try();
    line.add_bytes(";").try();
    out.say(line.view())
}

write_rows_guard = (be :: CBackend, v: TyId, out :: Emit)
                   Res<(), AllocError> {
    line ::= be.alloc.String().try();
    line.add_bytes("if (!rows) return ").try();
    write_vec_literal(be, v, "0", "0", line).try();
    line.add_bytes(";").try();
    out.say(line.view())
}

write_filled_rows = (be :: CBackend, v: TyId, out :: Emit)
                    Res<(), AllocError> {
    line ::= be.alloc.String().try();
    line.add_bytes("return ").try();
    write_vec_literal(be, v, "rows", "(size_t)argc", line).try();
    line.add_bytes(";").try();
    out.say(line.view())
}

// `(Vec<str>){ .data = <d>, .len = <n>, .capacity = <n> }`. The
// allocator field is left out, so C zeroes it — which is the whole of
// "growing argv would fault", stated by omission rather than by a
// memset.
write_vec_literal = (be :: CBackend, v: TyId, data: str, n: str,
                     out :: String) Res<(), AllocError> {
    out.add_bytes("(").try();
    ctype(be, v, out).try();
    out.add_bytes("){ .").try();
    sym_member(out, "data").try();
    out.add_bytes(" = ").try();
    out.add_bytes(data).try();
    out.add_bytes(", .").try();
    sym_member(out, "len").try();
    out.add_bytes(" = ").try();
    out.add_bytes(n).try();
    out.add_bytes(", .").try();
    sym_member(out, "capacity").try();
    out.add_bytes(" = ").try();
    out.add_bytes(n).try();
    out.add_bytes(" }").try();
    Ok(());
}

write_zero = (be :: CBackend, t: TyId, out :: String) Res<(), AllocError> {
    be.check.types.at(t).match({
        Prim(_) => out.add_bytes("0"),
        _       => write_zero_struct(be, t, out),
    })
}

write_zero_struct = (be :: CBackend, t: TyId, out :: String)
                    Res<(), AllocError> {
    out.add_bytes("(").try();
    ctype(be, t, out).try();
    out.add_bytes("){0}").try();
    Ok(());
}

// `Ok(0)` from main exits 0 — the corpus rests on it. A `Res` whose Ok
// payload is an integer becomes the exit code; anything else that is
// not `Ok` exits 1.
write_exit = (be :: CBackend, ret: TyId, call: str, out :: Emit)
             Res<(), AllocError> {
    be.check.types.at(ret).match({
        Res(r) => write_res_exit(be, r, ret, call, out),
        _      => write_plain_exit(be, ret, call, out),
    })
}

write_res_exit = (be :: CBackend, r: TyRes, ret: TyId, call: str,
                  out :: Emit) Res<(), AllocError> {
    line ::= be.alloc.String().try();
    ctype(be, ret, line).try();
    line.add_bytes(" zg_r = ").try();
    line.add_bytes(call).try();
    line.add_bytes(";").try();
    out.say(line.view()).try();
    guard ::= be.alloc.String().try();
    guard.add_bytes("if (zg_r.zg_tag == ").try();
    sym_variant(guard, RES_PATH, "Ok").try();
    guard.add_bytes(") return ").try();
    write_ok_value(be, r, guard).try();
    guard.add_bytes(";").try();
    out.say(guard.view()).try();
    out.say("return 1;").try();
    Ok(());
}

write_ok_value = (be :: CBackend, r: TyRes, out :: String)
                 Res<(), AllocError> {
    is_c_integer(be.check.prim_name(r.value)).match({
        true  => write_ok_payload(out),
        false => out.add_bytes("0"),
    })
}

write_ok_payload = (out :: String) Res<(), AllocError> {
    out.add_bytes("(int)zg_r.zg_data.").try();
    sym_member(out, "Ok").try();
    Ok(());
}

write_plain_exit = (be :: CBackend, ret: TyId, call: str, out :: Emit)
                   Res<(), AllocError> {
    is_c_integer(be.check.prim_name(ret)).match({
        true  => write_int_exit(call, out),
        false => write_void_exit(be, ret, call, out),
    })
}

write_int_exit = (call: str, out :: Emit) Res<(), AllocError> {
    out.bytes("return (int)").try();
    out.bytes(call).try();
    out.say(";").try();
    Ok(());
}

write_void_exit = (be :: CBackend, ret: TyId, call: str, out :: Emit)
                  Res<(), AllocError> {
    out.bytes(call).try();
    out.say(";").try();
    out.say("return 0;").try();
    Ok(());
}
