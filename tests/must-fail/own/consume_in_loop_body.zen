// consumed inside a loop body: the first iteration moves it, the
// second one finds a dead binding. the loop's back edge is the whole
// test — a checker that walks the body once, straight-line, misses it.
//
// the dual is corpus/own/consume_fresh_value_each_iteration.zen, where
// the value is CONSTRUCTED in the body and dies in the same iteration.

Buf = {
    id: i32,
}

Buf.impl(Drop, {
    drop = (self :: @Self) () { /* nothing to release: id is bytes */ }
})

main = (env: Env) Res<i32, IoError> {
    f = Buf(id: 1);
    Range(0, 3).loop((h, v) {
        g = consume f;
        println("{}", g.id)
    })
    Ok(0);
}
