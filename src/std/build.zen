// std.build — a build program registers targets into a runner-owned graph.
// Target configuration remains plain borrowed data; the short-lived Build context owns only
// the registry storage and releases it after emitting the graph.
// Target.ffi_ (`.ffi("util, vendor.hooks")`) is the FFI grant list: the dotted module ids allowed
// to hold foreign (bodyless) declarations — see error[ffi-ungranted]; mirrors zen.toml's `ffi = "…"`.
{ print, println } = std.text.fmt
{ Platform, Os, Arch, Abi, host } = std.sys.platform
{ Malloc } = std.mem.alloc
{ panic, Result, IoError, expect, or } = std.core.result
{ String, init } = std.text.string
{ integer_in } = std.text.num
{ out_bytes } = std.io.file
{ view, at } = std.text.str
Build*: {
    alloc_: Malloc,
    host_: Platform,
    target_: Platform,
    targets_: [Target],
    count_: i64,
    host   = (b: Ptr<Build>) Platform { b.host_ }
    target = (b: Ptr<Build>) Platform { b.target_ }
    exe    = (b: Ptr<Build>, name: string_view) Target { exe(name).target(b.target_) }
    install = (b: MutPtr<Build>, target: Target) void {
        (b.count_ >= b.targets_.len).match ({
            true  => panic("std.build: target capacity exceeded"),
            false => {
                b.targets_[b.count_] = target
                b.count_ = b.count_ + 1
            },
        })
    }
    emit_spec = (b: Ptr<Build>) void {
        println(b.count_)
        installed: [Target] := slice(b.targets_.ptr, b.count_)
        installed.loop((h, i, target) {
            target.emit_target()
        })
        // trailing genmod section: count line, then the use()-records verbatim (their stored
        // format IS the plan framing — see the c_library block below).
        println(cuse_count(0, 0))
        print(cuse_records)
    }
    deinit = (b: MutPtr<Build>) void { b.alloc_.addr().release(b.targets_.ptr) }
}
build_context = () Build {
    a := Malloc(_: 0)
    p := host()
    slots: [Target] := slice(assert_nonnull(a.addr().acquire(256 * sizeof(Target))), 256)
    Build(
        alloc_: a,
        host_: p,
        target_: p,
        targets_: slots,
        count_: 0,
    )
}
Target*: {
    name: string_view,
    root_: string_view,
    main_: string_view,
    out_: string_view,
    links_: string_view,
    sources_: [string_view],
    frameworks_: [string_view],
    libraries_: [string_view],
    platform_: Platform,
    ffi_: string_view,
    cflags_: string_view,
    root = (t: Target, p: string_view) Target {
        Target(
            name: t.name,
            root_: p,
            main_: t.main_,
            out_: t.out_,
            links_: t.links_,
            sources_: t.sources_,
            frameworks_: t.frameworks_,
            libraries_: t.libraries_,
            platform_: t.platform_,
            ffi_: t.ffi_,
            cflags_: t.cflags_,
        )
    }
    main = (t: Target, p: string_view) Target {
        Target(
            name: t.name,
            root_: t.root_,
            main_: p,
            out_: t.out_,
            links_: t.links_,
            sources_: t.sources_,
            frameworks_: t.frameworks_,
            libraries_: t.libraries_,
            platform_: t.platform_,
            ffi_: t.ffi_,
            cflags_: t.cflags_,
        )
    }
    out = (t: Target, p: string_view) Target {
        Target(
            name: t.name,
            root_: t.root_,
            main_: t.main_,
            out_: p,
            links_: t.links_,
            sources_: t.sources_,
            frameworks_: t.frameworks_,
            libraries_: t.libraries_,
            platform_: t.platform_,
            ffi_: t.ffi_,
            cflags_: t.cflags_,
        )
    }
    target = (t: Target, p: Platform) Target {
        Target(
            name: t.name,
            root_: t.root_,
            main_: t.main_,
            out_: t.out_,
            links_: t.links_,
            sources_: t.sources_,
            frameworks_: t.frameworks_,
            libraries_: t.libraries_,
            platform_: p,
            ffi_: t.ffi_,
            cflags_: t.cflags_,
        )
    }
    links = (t: Target, l: string_view) Target {
        Target(
            name: t.name,
            root_: t.root_,
            main_: t.main_,
            out_: t.out_,
            links_: l,
            sources_: t.sources_,
            frameworks_: t.frameworks_,
            libraries_: t.libraries_,
            platform_: t.platform_,
            ffi_: t.ffi_,
            cflags_: t.cflags_,
        )
    }
    sources = (t: Target, xs: [string_view]) Target {
        Target(
            name: t.name,
            root_: t.root_,
            main_: t.main_,
            out_: t.out_,
            links_: t.links_,
            sources_: xs,
            frameworks_: t.frameworks_,
            libraries_: t.libraries_,
            platform_: t.platform_,
            ffi_: t.ffi_,
            cflags_: t.cflags_,
        )
    }
    frameworks = (t: Target, xs: [string_view]) Target {
        Target(
            name: t.name,
            root_: t.root_,
            main_: t.main_,
            out_: t.out_,
            links_: t.links_,
            sources_: t.sources_,
            frameworks_: xs,
            libraries_: t.libraries_,
            platform_: t.platform_,
            ffi_: t.ffi_,
            cflags_: t.cflags_,
        )
    }
    libraries = (t: Target, xs: [string_view]) Target {
        Target(
            name: t.name,
            root_: t.root_,
            main_: t.main_,
            out_: t.out_,
            links_: t.links_,
            sources_: t.sources_,
            frameworks_: t.frameworks_,
            libraries_: xs,
            platform_: t.platform_,
            ffi_: t.ffi_,
            cflags_: t.cflags_,
        )
    }
    ffi = (t: Target, g: string_view) Target {
        Target(
            name: t.name,
            root_: t.root_,
            main_: t.main_,
            out_: t.out_,
            links_: t.links_,
            sources_: t.sources_,
            frameworks_: t.frameworks_,
            libraries_: t.libraries_,
            platform_: t.platform_,
            ffi_: g,
            cflags_: t.cflags_,
        )
    }
    // cflags: extra cc flags for this target (space-separated, e.g. "-O2 -fno-strict-aliasing"
    // or "-g"). Emitted on the plan's compiler-inputs line; the driver appends them AFTER its
    // own defaults (-O1 -foptimize-sibling-calls …), so a target's -O0/-O2/-g wins.
    cflags = (t: Target, f: string_view) Target {
        Target(
            name: t.name,
            root_: t.root_,
            main_: t.main_,
            out_: t.out_,
            links_: t.links_,
            sources_: t.sources_,
            frameworks_: t.frameworks_,
            libraries_: t.libraries_,
            platform_: t.platform_,
            ffi_: t.ffi_,
            cflags_: f,
        )
    }
    use = (t: Target, c: CLibrary) void {
        // register a c_library on this target (a plain statement — `exe.use(m)`): appends `-l<lib>` to
        // the target's link line, the module id to its ffi-grant line (the generated module IS a
        // foreign surface, so use() is what grants it), and the generated source to the plan's genmod
        // section. Keyed by the target's NAME — the emit walk matches records back to their target.
        a := Malloc(_: 0)
        mp := a.addr()
        s := mp.init(256).expect(cb_oom())
        s = s.append_in(mp, cuse_records).expect(cb_oom())
        s = s.append_in(mp, t.name).expect(cb_oom())
        s = s.append_in(mp, " ").expect(cb_oom())
        s = s.append_in(mp, c.name_).expect(cb_oom())
        s = s.append_in(mp, " ").expect(cb_oom())
        s = s.append_in(mp, c.lib_).expect(cb_oom())
        s = s.append_in(mp, " ").expect(cb_oom())
        s = s
            .append_in(mp, mp
                .integer_in(to_i64(c.src_.cb_lines(0, 0)))
                .expect(cb_oom())
                .finish_in(mp)
                .cb_fin())
            .expect(cb_oom())
        s = s.append_in(mp, "\n").expect(cb_oom())
        s = s.append_in(mp, c.src_).expect(cb_oom())
        cuse_records = s.finish_in(mp).cb_fin()
    }
    sources_on = (t: Target, os: Os, xs: [string_view]) Target {
        (t.platform_.os == os).then({ t.sources(xs) }, { t })
    }
    frameworks_on = (t: Target, os: Os, xs: [string_view]) Target {
        (t.platform_.os == os).then({ t.frameworks(xs) }, { t })
    }
    libraries_on = (t: Target, os: Os, xs: [string_view]) Target {
        (t.platform_.os == os).then({ t.libraries(xs) }, { t })
    }
    emit_target = (t: Target) void {
        // Legacy single-library setter. Prefer `.libraries(["pthread", ...])`.
        // Ten fixed lines: name, root, main, out, linker flags, compiler inputs, os, arch, abi, ffi grants.
        // The compiler-inputs line carries the cc flags (cflags_, `-`-prefixed words the driver
        // passes through verbatim) followed by the extra .c sources (project-relative).
        println(t.name)
        println(t.root_)
        println(t.main_)
        println(t.out_)
        (t.links_ != "").then({
            print("-l")
            print(t.links_)
            print(" ")
        })
        t.libraries_.loop((h, i, lib) {
            print("-l")
            print(lib)
            print(" ")
        })
        cuse_emit(t.name, 0, 1)
        t.frameworks_.loop((h, i, framework) {
            print("-framework ")
            print(framework)
            print(" ")
        })
        println("")
        (t.cflags_ != "").then({
            print(t.cflags_)
            print(" ")
        })
        t.sources_.loop((h, i, source) {
            print(source)
            print(" ")
        })
        println("")
        println(build_os_code(t.platform_.os))
        println(build_arch_code(t.platform_.arch))
        println(build_abi_code(t.platform_.abi))
        print(t.ffi_)
        cuse_emit(t.name, 0, 2)
        println("")
    }
}
build_os_code = (os: Os) i32 {
    os.match ({
        .MacOS   => 1,
        .Linux   => 2,
        .Windows => 3,
        .FreeBSD => 4,
        _        => 0,
    })
}
build_arch_code = (arch: Arch) i32 {
    arch.match ({
        .Arm64   => 1,
        .X86_64  => 2,
        .RiscV64 => 3,
        .Wasm32  => 4,
        _        => 0,
    })
}
build_abi_code = (abi: Abi) i32 {
    abi.match ({
        .Darwin => 1,
        .Gnu    => 2,
        .Musl   => 3,
        .Msvc   => 4,
        .Wasi   => 5,
        _       => 0,
    })
}
exe* = (name: string_view) Target {
    empty: [string_view] := []
    Target(
        name: name,
        root_: "",
        main_: "",
        out_: "",
        links_: "pthread",
        sources_: empty,
        frameworks_: empty,
        libraries_: empty,
        platform_: host(),
        ffi_: "",
        cflags_: "",
    )
}
// ── C libraries as build VALUES ───────────────────────────────────────────────────────────────────
// A CLib declares a system C library as data: the `-l` name, the module id programs import, and the
// typed surface — each c_fn signature is literal Zen text after the name; c_opaque mirrors
// std.web.dom's opaque-handle pattern (`{ handle: RawPtr<u8> }`). `c_library(b, CLib(…))` renders
// the generated module source once; `exe.use(lib)` then registers the whole edge in one call:
// link flag + ffi grant + generated module. The plan transports each use as one record —
// a header line `<target> <id> <lib> <K>` followed by exactly K lines of generated source
// (line-count-prefixed framing, so the body is opaque to the line-based transport); the driver
// (genmods_extract) writes the body to <projdir>/.zen/gen/<id>.zen and registers id → path with
// the resolver. c_library requires build.zen mode — zen.toml projects have no value to `use()`.
CDecl*: {
    name: string_view,
    sig: string_view,
    opaque: bool,
}
c_fn* = (name: string_view, sig: string_view) CDecl {
    CDecl(
        name: name,
        sig: sig,
        opaque: false,
    )
}
c_opaque* = (name: string_view) CDecl {
    CDecl(
        name: name,
        sig: "",
        opaque: true,
    )
}
CLib*: {
    lib: string_view,
    name: string_view,
    decls: [CDecl],
}
CLibrary*: {
    lib_: string_view,
    name_: string_view,
    src_: string_view,
}
cb_oom = () string_view { "std.build: c_library allocation failed" }
cb_fin = (r: Result<string_cstr, IoError>) string_view { r.expect(cb_oom()) }
cb_lines = (s: string_view, p: i32, n: i32) i32 {
    (s.at(p) == 0).then({ n }, { s.cb_lines(p + 1, (s.at(p) == '\n').then({ n + 1 }, { n })) })
}
c_library* = (b: MutPtr<Build>, cl: CLib) CLibrary {
    a := Malloc(_: 0)
    mp := a.addr()
    s := mp.init(256).expect(cb_oom())
    s = s.append_in(mp, "// generated by zenc c_library — do not edit\n").expect(cb_oom())
    cl.decls.loop((h, i, d) {
        d.opaque.match ({
            true  => {
                s = s.append_in(mp, d.name).expect(cb_oom())
                s = s.append_in(mp, "*: {\n    handle: RawPtr<u8>,\n}\n").expect(cb_oom())
            },
            false => {
                s = s.append_in(mp, d.name).expect(cb_oom())
                s = s.append_in(mp, "* = ").expect(cb_oom())
                s = s.append_in(mp, d.sig).expect(cb_oom())
                s = s.append_in(mp, "\n").expect(cb_oom())
            },
        })
    })
    CLibrary(
        lib_: cl.lib,
        name_: cl.name,
        src_: s.finish_in(mp).cb_fin(),
    )
}
// ── use()-record store + emit walk ────────────────────────────────────────────────────────────────
// Records accumulate in ONE module-level string, already in the plan section's exact framing;
// emit_spec prints it verbatim after the target records, and the walks below re-read the headers
// to fold `-l<lib>` / grant ids into the right target's lines.
cuse_none = () string_view { "" }
cuse_records := cuse_none()
cw_word_end = (s: string_view, p: i32) i32 {
    (s.at(p) == 0 || s.at(p) == ' ' || s.at(p) == '\n').then({ p }, { s.cw_word_end(p + 1) })
}
cw_line_end = (s: string_view, p: i32) i32 {
    (s.at(p) == 0 || s.at(p) == '\n').then({ p }, { s.cw_line_end(p + 1) })
}
cw_nat = (s: string_view, p: i32, e: i32, n: i32) i32 {
    (p >= e || s.at(p) < '0' || s.at(p) > '9').match ({
        true  => n,
        false => s.cw_nat(p + 1, e, n * 10 + to_i32(s.at(p) - '0')),
    })
}
cw_skip_lines = (s: string_view, p: i32, k: i32) i32 {
    (k <= 0).match ({
        true  => p,
        false => {
            le := s.cw_line_end(p)
            (s.at(le) == 0).then({ le }, { s.cw_skip_lines(le + 1, k - 1) })
        },
    })
}
// s[p..e) == w, byte-exact (w is NUL-terminated).
cw_eq = (s: string_view, p: i32, e: i32, w: string_view, j: i32) bool {
    (p + j == e).match ({
        true  => w.at(j) == 0,
        false => (w.at(j) == 0).match ({
            true  => false,
            false => (s.at(p + j) == w.at(j)).then({ s.cw_eq(p, e, w, j + 1) }, { false }),
        }),
    })
}
cw_put = (s: string_view, p: i32, e: i32) void {
    v: [u8] := s.view()
    out_bytes(slice(v.ptr.offset(to_i64(p)), to_i64(e - p))).or(0)
}
// one parsed record header at byte p: token spans + where the record ends (past its K body lines).
CUseRec: {
    tend: i32,
    istart: i32,
    iend: i32,
    lstart: i32,
    lend: i32,
    rend: i32,
}
cuse_rec = (p: i32) CUseRec {
    r := cuse_records
    te := r.cw_word_end(p)
    ie := r.cw_word_end(te + 1)
    le := r.cw_word_end(ie + 1)
    ke := r.cw_line_end(le + 1)
    CUseRec(
        tend: te,
        istart: te + 1,
        iend: ie,
        lstart: ie + 1,
        lend: le,
        rend: r.cw_skip_lines(ke + 1, r.cw_nat(le + 1, ke, 0)),
    )
}
// mode 1: `-l<lib> ` link flags · mode 2: ` <id>` ffi grants — for records keyed to target `tname`.
cuse_emit = (tname: string_view, p: i32, mode: i32) void {
    r := cuse_records
    (r.at(p) == 0 == false).then({
        rec := cuse_rec(p)
        r.cw_eq(p, rec.tend, tname, 0).then({
            (mode == 1).then({
                print("-l")
                r.cw_put(rec.lstart, rec.lend)
                print(" ")
            })
            (mode == 2).then({
                print(" ")
                r.cw_put(rec.istart, rec.iend)
            })
        })
        cuse_emit(tname, rec.rend, mode)
    })
}
cuse_count = (p: i32, n: i32) i32 {
    (cuse_records.at(p) == 0).then({ n }, { cuse_count(cuse_rec(p).rend, n + 1) })
}
