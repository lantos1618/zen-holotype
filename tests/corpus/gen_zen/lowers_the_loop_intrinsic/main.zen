// The loop family, which has no Zen body anywhere.
//
// `src/std/core/loop/loop_iter.zen` declares six signatures and no
// definitions, and says why: "a loop is the one thing that cannot be
// written in a language whose only control flow is `.match`, `.loop` and
// recursion". So the backend IS the body, and this asserts that it is.
//
// THE ASSERTIONS ARE THE THREE BUGS THIS LOWERING ACTUALLY HAD, each
// found by running the emitted program rather than by counting faults:
//
//   - `Res<q>` REACHING A BINDING. `loop<R: Range<T>, T>` returns
//     `Res<T>` and nothing settles `T` — it is reachable only through
//     the closure, and a closure infers FROM a signature. Sema hands
//     back the erased `q`, and a binding declared at it makes every
//     loop in the program share one C type. `cc` caught it; nothing in
//     Zen did.
//   - A SECOND DECLARATION WHERE A STORE WAS MEANT. Zen writes a
//     declaration and an assignment the same way, so `i = i + 1` inside
//     a `loop(() { i < 3 }, ..)` emitted a FRESH `i` per pass and the
//     condition kept reading the original. The C compiled and the
//     program never terminated.
//   - `index` AND `value` CONFUSED. Over `Range(10, 13)` they are 0,1,2
//     and 10,11,12; a lowering that hands the counter to both is
//     invisible on a range that starts at zero, which is every range in
//     a test that was not written to catch this.
//
// The C is inspected rather than run because the harness runs THIS
// program, not the one it emits — so each assertion is written as a
// property that a wrong lowering could not satisfy.

Alloc, AllocError = std.mem
str, String = std.text
Vec = std.collections
Source, scan = lex
Parser = parse.parser
module = parse.parse_decl
Ast = ast.ast_arena
Checker = sema.sema_check
Emit = gen.gen_emit
CBackend, emit_program = gen.gen_c

// Four of the six shapes, and each one written so a wrong lowering
// shows in the C: a non-zero-based range, a condition whose variable
// the body stores through, a `break` that carries a value, and a
// `next` that skips the rest of a pass.
PROGRAM : str = "LoopHandle = {}\nRange<T> = { start: usize, end: usize }\nloop = <R, T>(range: R, body: (h: LoopHandle, value: T) ()) Res<T>\nwhile_ = <T>(cond: () bool, body: (h: LoopHandle) ()) Res<T>\nmain = (env: i32) Res<i32> {\n    Range<usize>(start: 10, end: 13).loop((h, v) { });\n    i ::= 0;\n    while_(() { i < 3 }, (h) { i = i + 1; });\n    got = Range<usize>(start: 0, end: 10).loop((h, v) { (v == 3).match({ true => h.break(v), false => () }) });\n    Range<usize>(start: 0, end: 4).loop((h, v) { (v == 1).match({ true => h.next(), false => () }) });\n    Ok(0)\n}\n"

emit = (a: Alloc, text: str, faults :: String) Res<String, AllocError> {
    lexed = scan(a, Source(file: "main.zen", text: text)).try();
    p ::= a.Parser(lexed);
    m = p.module("main").try();
    p.tree.add_module(m).try();
    chk ::= a.Checker(p.tree).try();
    be ::= a.CBackend(p.tree, chk).try();
    out ::= a.Emit().try();
    be.emit_program(0, out).try();
    be.render_diags(faults).try();
    kept ::= a.String().try();
    kept.add_bytes(out.view()).try();
    Ok(kept);
}

occurrences = (hay: str, needle: str) usize {
    n ::= 0;
    Range(0, hay.len).loop((h, i) {
        starts_at(hay, needle, i).then(() { n = n + 1; });
    });
    n
}

starts_at = (hay: str, needle: str, i: usize) bool {
    (i + needle.len <= hay.len)
        && (Range(0, needle.len).find((k) { hay[i + k] != needle[k] })
                .match({ Ok(_) => false, None => true }))
}

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    faults ::= alloc.String().try();
    c = emit(alloc, PROGRAM, faults).try();

    println("nothing was refused: {}", faults.is_empty());

    // four loops, so four `while`/`for` heads and four break labels.
    // A shape that fell through to the general call path would emit a
    // call to a symbol nothing defines instead.
    println("loop heads: {}", occurrences(c.view(), "while (") + occurrences(c.view(), "for (;;) {"));
    // four label definitions, plus the two jumps to one: `h.break(v)`
    // and the `while_` guard, which leaves through the same door.
    println("break label mentions: {}", occurrences(c.view(), "zg_brk"));

    // `h.break(v)` and `h.next()` are gotos and not C's break and
    // continue: an inlined body sits inside the `if` chain a `.match`
    // produced, where a C `break` leaves the chain and not the loop.
    println("continue label used: {}", occurrences(c.view(), "goto zg_cnt") == 1);
    println("no C break statement: {}", occurrences(c.view(), " break;") == 0);

    // the erased loop type never reaches a declaration
    println("no erased Res reached the C: {}", occurrences(c.view(), "3ResI1_q") == 0);

    // `i` is declared ONCE. A store lowered as a declaration would give
    // the second one a shadow number, and the condition would read the
    // first one forever.
    println("the stored local is declared once: {}", occurrences(c.view(), "zu_l1i_2") == 0);

    // `value` is the element and not the pass count: over Range(10, 13)
    // the walk starts at 10, which only a `start`-seeded counter does.
    println("the walk is seeded from start: {}", occurrences(c.view(), "zu_m5start") > 0);
    Ok(0);
}
