// compiler.check_fits — the type lattice as TRAITS: assignability (fits), ty_eq, and the
// mode/pointer-write checks. Extracted from compiler.check; methodified per the PtrKind/EnvKinds
// precedent — TyFits is impl'd on Ty and EnvFits on Env (both out-of-module impls), so every
// consumer dispatches `got.fits(want)` / `env.write_thru_readonly(obj)` by UFCS through the impl
// index and imports NOTHING from this module (compiler.check keeps one `{ TyFits }` trait import
// as the project-mode closure pull, mirroring the PtrKind import below).
{ Expr, Ty } = compiler.ast.ast_types
{ k_ptr, k_mut_ptr, k_raw_ptr } = compiler.genc
{ Env } = compiler.check
{ loop_at } = std.core.count
{ PtrKind } = compiler.passes.ptrkind    // trait import: enables UFCS `t.ptr_kind_of()` &c. via the impl index
// ── the Ty lattice, as a trait ───────────────────────────────────────────────
TyFits*: {
    ty_rank: (Self) i32,
    is_f64_ty: (Self) bool,
    ty_eq: (Self, Ty) bool,
    mode_fits: (Self, Ty) bool,
    slice_mode_fits: (Self, Ty) bool,
    fits: (Self, Ty) bool,
}
Ty.impl(TyFits, {
    ty_rank = (t: Ty) i32 {
        // Type lattice: integer widening u8 <= i32 <= i64; all else exact structural equality.
        // f64 is intentionally outside the integer rank chain.
        t.match ({
            .U8  => 0,
            .I32 => 1,
            .I64 => 2,
            _    => 0 - 1,
        })
    }
    is_f64_ty = (t: Ty) bool {
        t.match ({
            .F64 => true,
            _    => false,
        })
    }
    ty_eq = (g: Ty, w: Ty) bool {
        g.match ({
            .I32           => w.match ({
                .I32 => true,
                _    => false,
            }),
            .I64           => w.match ({
                .I64 => true,
                _    => false,
            }),
            .U8            => w.match ({
                .U8 => true,
                _   => false,
            }),
            .F64           => w.match ({
                .F64 => true,
                _    => false,
            }),
            .Bool          => w.match ({
                .Bool => true,
                _     => false,
            }),
            .Void          => w.match ({
                .Void => true,
                _     => false,
            }),
            .StringView    => w.match ({
                .StringView => true,
                _           => false,
            }),
            .StringCstr    => w.match ({
                .StringCstr => true,
                .StringView => true,
                _           => false,
            }),
            .StringLiteral => w.match ({
                .StringLiteral => true,
                .StringView    => true,
                .StringCstr    => true,
                _              => false,
            }),
            .Named(a)      => w.match ({
                .Named(b)    => a == b,
                .Generic(gb) => a == gb.mangled,
                _            => false,
            }),
            .Ptr(pa)       => w.match ({
                .Ptr(pb) => load(pa.pointee).invariant_ty_eq(load(pb.pointee)),
                _        => false,
            }),
            .Slice(pa)     => w.match ({
                .Slice(pb) => load(pa.pointee).invariant_ty_eq(load(pb.pointee)),
                _          => false,
            }),
            .FnT(fa)       => false,
            .Generic(ga)   => w.match ({
                .Generic(gb) => ga.name == gb.name && ga.args.invariant_tys_eq(gb.args),
                .Named(b)    => ga.mangled == b,
                _            => false,
            }),
        })
    }
    mode_fits = (g: Ty, w: Ty) bool {
        // Mode-lattice cell for `fits`: a readonly Ptr must not satisfy either writable spelling
        // (MutPtr or RawPtr), while MutPtr may safely lose capability into Ptr/RawPtr.
        (g.ptr_kind_of() == k_ptr()
            && (w.ptr_kind_of() == k_mut_ptr() || w.ptr_kind_of() == k_raw_ptr())).match ({
            true  => false,
            false => g.slice_mode_fits(w),
        })
    }
    slice_mode_fits = (g: Ty, w: Ty) bool {
        // The same direction one constructor out: a writable `[T]` fits a read-only `Slice<T>` slot
        // (capability may be dropped), a read-only slice never fits a writable one. This is the arm
        // that makes `v: [u8] = lit.view()` a type error instead of a segfault three lines later.
        (g.slice_kind_of() == k_ptr() && w.slice_kind_of() == k_mut_ptr()).then({ false }, { true })
    }
    fits = (g: Ty, w: Ty) bool {
        numeric = g.ty_rank() >= 0 && w.ty_rank() >= 0
        numeric.match ({
            true  => g.ty_rank() <= w.ty_rank(),
            false => g.raw_floor_fits(w).match ({
                true  => true,
                false => (g.is_nullable_ptr_ty() && w.is_nonnull_ptr_ty()).match ({
                    true  => false,
                    false => g.ty_eq(w) && g.mode_fits(w),
                }),
            }),
        })
    }
})
// Types stored under a mutable/aggregate constructor are invariant. In particular, the three string
// provenance variants are only coercible as outer values; treating them as equal inside MutPtr,
// slices, or generic storage lets a borrowed value overwrite an immortal-typed slot.
invariant_ty_eq = (g: Ty, w: Ty) bool {
    g.match ({
        .I32           => w.match ({
            .I32 => true,
            _    => false,
        }),
        .I64           => w.match ({
            .I64 => true,
            _    => false,
        }),
        .U8            => w.match ({
            .U8 => true,
            _   => false,
        }),
        .F64           => w.match ({
            .F64 => true,
            _    => false,
        }),
        .Bool          => w.match ({
            .Bool => true,
            _     => false,
        }),
        .Void          => w.match ({
            .Void => true,
            _     => false,
        }),
        .StringView    => w.match ({
            .StringView => true,
            _           => false,
        }),
        .StringCstr    => w.match ({
            .StringCstr => true,
            _           => false,
        }),
        .StringLiteral => w.match ({
            .StringLiteral => true,
            _              => false,
        }),
        .Named(a)      => w.match ({
            .Named(b)    => a == b,
            .Generic(gb) => a == gb.mangled,
            _            => false,
        }),
        .Ptr(pa)       => w.match ({
            .Ptr(pb) => pa.kind == pb.kind && load(pa.pointee).invariant_ty_eq(load(pb.pointee)),
            _        => false,
        }),
        .Slice(pa)     => w.match ({
            .Slice(pb) => pa.kind == pb.kind && load(pa.pointee).invariant_ty_eq(load(pb.pointee)),
            _          => false,
        }),
        .FnT(fa)       => w.match ({
            .FnT(fb) => fa.params.invariant_tys_eq(fb.params)
                && load(fa.ret).invariant_ty_eq(load(fb.ret)),
            _        => false,
        }),
        .Generic(ga)   => w.match ({
            .Generic(gb) => ga.name == gb.name && ga.args.invariant_tys_eq(gb.args),
            .Named(b)    => ga.mangled == b,
            _            => false,
        }),
    })
}
invariant_tys_eq = (gs: [Ty], ws: [Ty]) bool {
    (gs.len != ws.len).match ({
        true  => false,
        false => {
            same ::= true
            gs.loop_at((i, g) { same = same && g.invariant_ty_eq(ws[i]) })
            same
        },
    })
}
// ── Ty pointer-kind inspection, as a trait ───────────────────────────────────
is_any_ptr = (t: Ty) bool { t.ptr_kind_of() >= 0 }
// ── lvalue write-provenance, as Env methods ──────────────────────────────────
// The walk answers WHICH read-only thing a write passes through, not merely whether one exists, so
// the diagnostic can name it: `w_ok` = writable, `w_ptr` = a read-only `Ptr<T>`, `w_slice` = a
// read-only `Slice<T>` window. The two boolean wrappers keep every existing caller unchanged.
w_ok* = () i32 { 0 }
w_ptr* = () i32 { 1 }
w_slice* = () i32 { 2 }
EnvFits*: {
    write_thru_readonly: (Self, Ptr<Expr>) bool,
    lvalue_writes_readonly: (Self, Ptr<Expr>) bool,
    write_thru_code: (Self, Ptr<Expr>) i32,
    lvalue_write_code: (Self, Ptr<Expr>) i32,
}
Env.impl(EnvFits, {
    write_thru_readonly = (env: Env, obj: Ptr<Expr>) bool { env.write_thru_code(obj) != w_ok() }
    lvalue_writes_readonly = (env: Env, target: Ptr<Expr>) bool {
        env.lvalue_write_code(target) != w_ok()
    }
    write_thru_code = (env: Env, obj: Ptr<Expr>) i32 {
        // Preserve lvalue provenance across addr(): taking the address of storage reached through Ptr<T>
        // yields Ptr<U>, never MutPtr<U>. The walk stops at the first pointer indirection, matching writes.
        ot = env.infer_expr(obj)
        // A read-only slice STOPS the walk with a verdict of its own: `v[0] = …` where `v: Slice<u8>`
        // writes through the window's own pointer, so no enclosing base decides it. Everything else
        // keeps the pre-existing pointer walk verbatim.
        ot.is_readonly_slice_ty().then({
            return w_slice()
        })
        ot.is_any_ptr().then({
            return ot.is_readonly_ptr_ty().then({ w_ptr() }, { w_ok() })
        })
        env.lvalue_write_code(obj)
    }
    lvalue_write_code = (env: Env, target: Ptr<Expr>) i32 {
        load(target).match ({
            .Member(m) => env.write_thru_code(m.obj),
            .Arrow(ar) => env.infer_expr(ar.obj).is_readonly_ptr_ty().then({ w_ptr() }, { w_ok() }),
            .Index(ix) => env.write_thru_code(ix.seq),
            _          => w_ok(),
        })
    }
})
raw_floor_fits = (g: Ty, w: Ty) bool { g.is_raw_ptr_ty() && w.is_ptr_ty_g() }
