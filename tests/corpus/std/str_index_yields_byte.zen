// tests/corpus/std/str_index_yields_byte.zen
// indexing a str yields a u8, so it is compared against a char
// literal and never against a number. index 1 of "héllo" is the
// FIRST BYTE of a two-byte codepoint - it is not 'e', and it is
// not the codepoint either

main = (env: Env) Res<i32, AllocError> {
    s = "hi!";
    (s[0] == 'h').match({
        true  => println("first is h"),
        false => println("first is not h"),
    })
    (s[2] == '!').match({
        true  => println("last is bang"),
        false => println("last is not bang"),
    })

    accented = "héllo";
    (accented[0] == 'h').match({
        true  => println("accented first is h"),
        false => println("accented first is not h"),
    })
    (accented[1] == 'e').match({
        true  => println("accented second is e"),
        false => println("accented second is not e"),
    })
    Ok(0);
}
