// tests/bench/drivers/stored_field_read.zen
// driver for bench_field.zen's stored_field_read; see vec_add.zen's
// header for why the body is mirrored instead of the bench being run.
//
// The read must ESCAPE, or the C compiler deletes the loop and the
// bench measures nothing. The escape is the exit code, not a println:
// the self-hosted compiler cannot lower printing an f64 yet, and a
// driver that only the bootstrapper can run is half a gate. Budget:
// ns_op 2, allocs_op 0, bytes_op 0 (bench_budgets.zen).

Rect* = {
    width: f64,
    height: f64,
}

main = (env: Env) Res<i32, IoError> {
    r = Rect(width: 3.0, height: 4.0);
    total ::= 0.0;
    Range(0, 10000000).loop((h, i) {
        total = total + r.width;
    });
    (total > 0.0).match({
        true  => Ok(0),
        false => Ok(1),
    });
}
