// src/sema/sema_try.zen
// `.try()`, and the four rules that go with it.
//
// "It unwraps Ok, or returns the Err — or the None — from the ENCLOSING
// function." Three rules go with that and all three are law 4: the
// enclosing function must return a compatible Res, a `Res<T>` may not try
// into a `Res<T, E>` function, and nothing is converted.
//
// SPLIT OUT OF `sema_type.zen`, WHICH HAD ITS OWN BANNER FOR THIS ALREADY.
// The subject there is "what does this node mean" and the memo discipline
// that answers it; the subject here is the failure model — which Res forms
// propagate into which, and what a set has to contain. `try_type` is one
// arm of `expr_kind` and nothing else in the tree calls into this family,
// so the seam is exactly one import.

Expr, ExprId = ast
AllocError = std.mem
TyId, TyRes = sema.sema_ty
SemaFault, TypeFault = sema.sema_diag
Checker, Ctx = sema.sema_check
absence_into_failure, both_failures = sema.sema_check
type_of = sema.sema_type

try_type* = (c :: Checker, node: Expr, operand: ExprId, ctx: Ctx)
           Res<TyId, AllocError> {
    got = c.type_of(operand, ctx).try();
    c.types.at(got).match({
        Res(r) => c.try_res(node, r, got, ctx),
        _      => c.try_not_res(node, got, ctx),
    })
}

try_not_res* = (c :: Checker, node: Expr, got: TyId, ctx: Ctx)
              Res<TyId, AllocError> {
    // poison never produces a second diagnostic
    c.is_unknown(got).match({
        false => c.try_needs_res(node, got),
        true  => Ok(got),
    })
}

try_needs_res* = (c :: Checker, node: Expr, got: TyId)
                Res<TyId, AllocError> {
    want = c.types.unknown().try();
    c.report(node.span.file, node.span,
                SemaFault.TryNeedsRes(TypeFault(
                    name: "", expected: want, found: got))).try();
    c.types.unknown()
}

try_res* = (c :: Checker, node: Expr, r: TyRes, got: TyId, ctx: Ctx)
          Res<TyId, AllocError> {
    ctx.has_ret.match({
        false => c.try_outside_res(node, got),
        true  => c.try_into(node, r, got, ctx),
    })
}

try_outside_res* = (c :: Checker, node: Expr, got: TyId)
                  Res<TyId, AllocError> {
    want = c.types.unknown().try();
    c.report(node.span.file, node.span,
                SemaFault.TryOutsideRes(TypeFault(
                    name: "", expected: want, found: got))).try();
    Ok(got)
}

// The enclosing function returns a Res. Which one decides whether
// this propagation is legal at all.
try_into* = (c :: Checker, node: Expr, r: TyRes, got: TyId, ctx: Ctx)
           Res<TyId, AllocError> {
    c.types.at(ctx.ret).match({
        Res(want) => c.try_merge(node, r, want, got),
        _         => c.try_outside_res(node, got),
    })
}

try_merge* = (c :: Checker, node: Expr, r: TyRes, want: TyRes, got: TyId)
            Res<TyId, AllocError> {
    // an absence propagating into a failure is the one shape law 4
    // names outright: "a None never becomes an Err. You name the
    // reason" — and `.ok_or(..)` is where that is written.
    absence_into_failure(r.form, want.form).match({
        true  => c.try_absence(node, got, r.value),
        false => c.try_set(node, r, want),
    })
}

try_absence* = (c :: Checker, node: Expr, got: TyId, value: TyId)
              Res<TyId, AllocError> {
    want = c.types.res_failure(value, got).try();
    c.report(node.span.file, node.span,
                SemaFault.TryAbsenceIntoFailure(TypeFault(
                    name: "", expected: want, found: got))).try();
    Ok(value)
}

// "propagation merges sets" — and merging is containment, not
// conversion. The callee's set must already be part of the
// caller's; there is no From to bridge them.
try_set* = (c :: Checker, node: Expr, r: TyRes, want: TyRes)
          Res<TyId, AllocError> {
    both_failures(r.form, want.form).match({
        true  => c.try_contained(node, r, want),
        false => Ok(r.value),
    })
}

// A caller whose own set is `_` has not declared one, so there is
// nothing to be contained IN. It raises what the callee raises, and
// `sema_raise.zen` settles the signature once the body is walked.
try_contained* = (c :: Checker, node: Expr, r: TyRes, want: TyRes)
                Res<TyId, AllocError> {
    c.is_infer(want.error).match({
        true  => c.try_raises(r),
        false => c.try_declared(node, r, want),
    })
}

// The callee's SET and not its name: `WriteError` raised into an
// inferred set contributes `IoError` and `AllocError`, so that the
// caller's own declared set is asked to contain members and not a
// spelling. `union_ty` flattens the rest.
try_raises* = (c :: Checker, r: TyRes) Res<TyId, AllocError> {
    c.raise(c.set_of(r.error)).try();
    Ok(r.value);
}

try_declared* = (c :: Checker, node: Expr, r: TyRes, want: TyRes)
               Res<TyId, AllocError> {
    c.types.set_within(c.set_of(r.error), c.set_of(want.error)).match({
        false => c.try_no_conversion(node, r, want),
        true  => Ok(r.value),
    })
}

try_no_conversion* = (c :: Checker, node: Expr, r: TyRes, want: TyRes)
                    Res<TyId, AllocError> {
    c.report(node.span.file, node.span,
                SemaFault.NoErrorConversion(TypeFault(
                    name: "",
                    expected: want.error,
                    found: r.error))).try();
    Ok(r.value)
}
