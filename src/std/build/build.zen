// src/std/build/build.zen
//
// The api a build file is handed. A build file is an ordinary Zen
// program (`build = (b :: Builder) Res<(), BuildError>`) — no manifest
// format, no configuration language, no second place to learn.
// Packages are module-level declarations, targets are calls in the body.
//
// `b` is `::` because b.add/exe/test MUTATE the graph; b.module/os only
// read it.
//
// The phase order everything here follows from:
//
//     parse every module  ->  run build.zen  ->  compile
//
// So b.module can READ any module's declarations (how test discovery
// lives in a build file, not the compiler), but a build file may never
// CALL code from the tree it configures — that needs the tree compiled
// before the thing that says how.

Alloc = std.mem
Env = std.env
Vec = std.collections
str = std.text

// Named here so dependencies are a list, not a surprise: Path and
// Duration are unowned (see the report); Module and Function are
// std/ast's own nodes — the same ones gen_c consumes and @meta
// hands back, letting a build file inspect its own project.

// @meta is stage 5 (docs/PLAN.md), so the real nodes cannot flow
// yet, and nothing else can declare them — std may not import
// std/ast. These stand-ins are opaque ON PURPOSE: the api below
// compiles at stage 4 and a build file may hold a Vec<Function>;
// the day @meta hands the driver the real nodes, these two lines
// go away. What a stand-in refuses is the WALK — b.module(p).functions
// is stage-5 code and fails sema until then, by name, not at a
// linker.
Module* = {}
Function* = {}

BuildError* = NotFound | FetchFailed | VersionConflict | HashMismatch

// The target. A build file matches on these right here — no cfg
// annotations, no ifdef, no preprocessor.
Os* = Macos | Linux | Windows

Arch* = X86_64 | Arm64

// A dependency, hash-locked: url and version say what you asked for,
// hash pins what you actually got. Starred since a build file (another
// module) names them at construction.
//
// Fetched into a content-addressed cache, verified against the hash.
// `zen add json` / `zen remove json` edit these lines for you — the
// cli writes source, because source is the manifest.
Package* = {
    url*: str,
    version*: str,
    hash*: str,
}

// One resolved node in the graph: what b.add/lib/extern hand back, and
// what a target's `deps` list is made of. Wiring is per-target and
// Swift-style — a module may import from `pkg` only what the target
// that owns it declared.
Dep* = {
    name*: str,
}

// An executable target.
Exe* = {
    src*: Path,
    deps*: Vec<Dep>,

    // Defaults to build/{os}-{arch}/{name}. Res<Path> spells "absent":
    // None means "you didn't say", not an empty path. `::` since that's
    // the only member form carrying a default (a `:` member with a
    // value is a constant); see the report.
    out* :: Res<Path> = None,
}

// A system library linked into a target: `src` is the Zen-side
// binding, `libs` the link names, `paths` where to find them.
Lib* = {
    src*: Path,
    libs*: Vec<str>,
    paths*: Vec<str>,
}

// C sources compiled alongside the tree, not a system library. Same
// three questions, different answer to "where's the code from" —
// separate type, not an alias, so a flag added to Extern doesn't grow
// one on Lib too.
Extern* = {
    src*: Path,
    libs*: Vec<str>,
    paths*: Vec<str>,
}

// A test target: the functions the walk found, and what they may
// import. `zen test` runs this.
Test* = {
    tests*: Vec<Function>,
    deps*: Vec<Dep>,
}

// A bench target. Same walk, different filter, plus the budgets
// results are gated against — living in the build file, as code,
// reviewed like code.
//
// No `deps`: neither DESIGN.md's build file nor example/build.zen
// passes one, and a required field nobody fills is a build file that
// won't compile. Added the day a bench needs a package, not before.
Bench* = {
    benches*: Vec<Function>,
    budgets*: Vec<Budget>,
}

// A locked expectation for one bench, matched to it by name.
//
// allocs_op/bytes_op are DETERMINISTIC (every allocation goes through
// an Alloc, so counts match across machines) and exceeding them FAILS
// THE BUILD. ns_op is wall clock, varying 2-5x on shared ci, so it
// rides a rolling median and fails only on a sustained shift — a flaky
// gate gets switched off, and takes the honest gates down with it.
Budget* = {
    name*: str,
    ns_op*: u64,
    allocs_op*: u64,
    bytes_op*: u64,
}

// The build graph, as the build file sees it.
//
// Every method below is a bodiless signature: Builder is a struct used
// as a bound, so the build driver (src/build/build.zen, stage 1)
// supplies them, and a build file only holds the fat value. Nothing
// here is a trait — there are no traits.
Builder* = {
    os*: Os,
    arch*: Arch,
    env*: Env,
    alloc*: Alloc,   // the build-time arena

    // The parsed module graph, as std/ast's own nodes — the method
    // that makes test discovery ordinary code:
    //
    //     tests ::= b.alloc.Vec<Function>();
    //     b.module(Path("src")).functions.loop((h, f) {
    //         (f.params.len == 1 && f.params.get(0).try().type == Tester)
    //             .then(() { tests.add(f).try() });
    //     });
    //
    // Change the filter, change what a test is. `:` since reading the
    // graph doesn't write the builder's own bytes.
    module* = (self: @Self, path: Path) Module

    // Packages: declared in the build file, fetched into a
    // content-addressed cache, verified against the hash.
    add* ::= (self :: @Self, name: str, pkg: Package) Res<Dep, BuildError>
    remove* ::= (self :: @Self, name: str) Res<(), BuildError>

    // Targets. An exe is not something another target depends on, so
    // it hands back nothing; a lib and an extern are, so they return
    // the Dep that goes in a `deps` list.
    exe* = (self :: @Self, name: str, target: Exe) Res<(), BuildError>
    lib* = (self :: @Self, name: str, target: Lib) Res<Dep, BuildError>
    extern* = (self :: @Self, name: str, target: Extern) Res<Dep, BuildError>
    test* = (self :: @Self, name: str, target: Test) Res<(), BuildError>
    bench* = (self :: @Self, name: str, target: Bench) Res<(), BuildError>

    // The build budgets itself: total and per-target compile times
    // ride the same rolling median a bench's ns_op does. A 20 minute
    // build is a bug, and bugs fail ci.
    budget* = (self :: @Self, d: Duration) ()
}
