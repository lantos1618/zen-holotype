// LSP document store. An open document uses the client's latest full-sync text; otherwise callers
// fall back to disk. didOpen/didChange replace the stored state, and didClose frees and removes it.
// Token data is valid only when `tok_version == version`; every text write invalidates it.
// The store outlives request-arena resets, so URI, text, and tokens are copied to the process heap.
// Replacements and closes release those durable copies; one text and token buffer remain per open file.
{ heap_allocator } = std.mem.alloc
{ memcpy } = std.c.libc
{ view } = std.text.str
{ then } = std.core.bool
{ loop_at } = std.core.count
LspDoc: {
    uri: StringView,
    text: StringView,
    tokens: StringView,
    version: i64,
    tok_version: i64,
}    // -1 = no token array cached for `version`
lspd_none = () [LspDoc] { slice(null_ptr(), 0) }
lspd_acquire = (n: i64) RawPtr<u8> { allocator_dispatch_acquire(heap_allocator(), n) }
lspd_free = (p: RawPtr<u8>) void { allocator_dispatch_release(heap_allocator(), p) }
lspd_buf ::= lspd_none()
lspd_n ::= 0
lspd_alloc = (n: i64) [LspDoc] { slice(lspd_acquire(n * sizeof(LspDoc)), n) }
lspd_grow = () void {
    (lspd_n >= lspd_buf.len).then({
        grown ::= lspd_alloc((lspd_buf.len < 4).then({ 4 }, { lspd_buf.len * 2 }))
        old = lspd_buf.ptr
        lspd_buf.loop_at((i, d) { grown[i] = d })
        lspd_buf = grown
        lspd_free(old)
    })
}
// a DURABLE copy of a request-scoped view — NUL-terminated, so it reads back as a plain StringView.
// The empty view keeps the "" literal (nothing to own, nothing to release).
lspd_own = (s: StringView) StringView {
    v: Slice<u8> = s.view()
    (v.len == 0).match ({
        true  => "",
        false => {
            p = lspd_acquire(v.len + 1)
            (p == null_ptr()).match ({
                true  => "",
                false => {
                    memcpy(p, v.ptr, v.len)
                    p.offset(v.len).store(0)
                    cstr(p)
                },
            })
        },
    })
}
// release an OWNED copy. "" is the literal miss/absent marker and is never heap — see MEMORY above.
lspd_release = (s: StringView) void {
    v: Slice<u8> = s.view()
    (v.len > 0).then({
        lspd_free(s.offset(0))
    })
}    // `s.offset(0)` is std.text.str's `own_ptr` respelled: this file is in the bootstrap
// manifest, which does not carry std.text.str, so the name cannot be imported here. `v.ptr` is a
// BORROWED `Ptr<u8>` and will not free; `lspd_own` allocated this block, so the claim is honest.
lspd_free_entry = (i: i64) void {
    d = lspd_buf[i]
    lspd_release(d.uri)
    lspd_release(d.text)
    lspd_release(d.tokens)
}
lspd_scan = (i: i64, uri: StringView) i64 {
    (i >= lspd_n).match ({
        true  => 0 - 1,
        false => (lspd_buf[i].uri == uri).then({ i }, { lspd_scan(i + 1, uri) }),
    })
}
// index of the OPEN document `uri`, or -1 — the callers' "is the client's buffer authoritative?" test.
lspd_find* = (uri: StringView) i64 { lspd_scan(0, uri) }
lspd_text_at* = (i: i64) StringView { lspd_buf[i].text }
// the memoized token array for the document's CURRENT version, or "" when nothing is cached for it.
lspd_tokens_at* = (i: i64) StringView {
    d = lspd_buf[i]
    (d.tok_version == d.version).then({ d.tokens }, { "" })
}
// didOpen / didChange: keep a durable copy of `uri` + `text`, free what they replace, drop the token
// cache, and return the entry's index.
lspd_set* = (uri: StringView, text: StringView, version: i64) i64 {
    i = lspd_find(uri)
    fresh = LspDoc(
        uri: lspd_own(uri),
        text: lspd_own(text),
        tokens: "",
        version: version,
        tok_version: 0 - 1,
    )
    (i < 0).match ({
        true  => {
            lspd_grow()
            lspd_buf[lspd_n] = fresh
            lspd_n = lspd_n + 1
            lspd_n - 1
        },
        false => {
            lspd_free_entry(i)
            lspd_buf[i] = fresh
            i
        },
    })
}
// memoize `toks` against the document's current version, as a durable copy.
lspd_cache_tokens* = (i: i64, toks: StringView) void {
    d = lspd_buf[i]
    lspd_release(d.tokens)
    lspd_buf[i] = LspDoc(
        uri: d.uri,
        text: d.text,
        tokens: lspd_own(toks),
        version: d.version,
        tok_version: d.version,
    )
}
// didClose: free the entry's buffers and swap the last entry into its slot. After this the document
// is no longer open, so disk is once again the source of truth for it.
lspd_close* = (uri: StringView) void {
    i = lspd_find(uri)
    (i >= 0).then({
        lspd_free_entry(i)
        lspd_buf[i] = lspd_buf[lspd_n - 1]
        lspd_n = lspd_n - 1
    })
}
