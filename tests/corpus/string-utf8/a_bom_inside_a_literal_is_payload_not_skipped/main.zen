// The lexer skips a byte-order mark at the START of a file. Inside a
// string literal the same three bytes (EF BB BF) are ordinary data:
// they must decode to U+FEFF, count as one codepoint, and advance the
// cursor by 3. A lexer or decoder that "helpfully" strips BOMs it finds
// mid-stream would print 4 and 2 here -- and silently corrupt any
// document whose first character really is U+FEFF.
Utf8Error = std.text.text_utf8

main = (env: Env) Res<i32, Utf8Error> {
    s = "a﻿b";
    println("len {} cps {}", s.len, s.count_codepoints().try());
    walk ::= s.codepoints();
    first ::= walk.next().try();
    second ::= walk.next().try();
    third ::= walk.next().try();
    println("{} {} {}", first, second, third);
    Ok(0);
}
