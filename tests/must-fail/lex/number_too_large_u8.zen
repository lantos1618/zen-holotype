// the literal below does not fit u8; the boundary value does.
//
// `ok` and `.count 1` are the point. A checker that rejected every u8
// literal, or clamped the bound to something narrower than 255, would still
// report SOMETHING for 256 and satisfy a bare must-fail -- so 255 stands one
// line above and exactly one diagnostic is allowed. See also
// corpus/lex/number_type_boundaries.
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    ok: u8 = 255;
    bad: u8 = 256;
    println("{} {}", ok, bad);
    Ok(0);
}
