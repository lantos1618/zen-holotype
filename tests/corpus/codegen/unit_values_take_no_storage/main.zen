HasUnit = {
    u: (),
    n: i32,
}

pick = <T>(flag: bool, a: T, b: T) T {
    flag.match({
        true  => a,
        false => b,
    })
}

take = (u: ()) () { u }

make = () HasUnit {
    println("receiver ok");
    HasUnit(u: (), n: 5)
}

main = (env: Env) Res<i32, AllocError> {
    local = pick(true, (), ());
    println("local ok");
    take(local);
    println("param ok");
    read = make().u;
    println("field ok");
    Ok(0);
}
