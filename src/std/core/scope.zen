// std.core.scope
//
// `@scope` is the enclosing block as a value — what a LoopHandle is
// to a loop, one level down. Nests, each block gets its own:
//
//   {
//       outer = @scope;
//       {
//           inner = @scope;
//           inner.defer(() { println("inner cleanup") });
//       }                                    // inner's defers run
//       outer.defer(() { println("outer cleanup") });
//   }                                        // outer's defers run
//
// Each block owns its defer stack. Scope is non-escaping: helpers may receive
// it to register cleanup on their caller's block, but it cannot be stored,
// returned, or captured by an escaping closure.
Scope* = {
    // required (`= sig`, no body): the compiler supplies the block.
    //
    // Registers a closure on THIS block; they run LIFO at block exit,
    // BEFORE any drop — a stack, not a map, since order is the point.
    //
    // Capped at 32 per block: the 33rd registration on one block is a
    // runtime trap ("too many deferred closures on one block"). A
    // defer written inside a loop body lands on the body's own block,
    // fresh each iteration, and never hits it; registering on an
    // ENCLOSING block from inside a loop is where the cap bites.
    //
    // `:` because the closure stack lives in the block, not the handle bytes.
    defer* = (self: @Self, f: () ()) ()
}
