// src/gen/gen_c/gen_c_type.zen
// What a Zen type is in C: how it is SPELLED, and which types a
// program needs at all.
//
// `gen_c_layout.zen` is the other half — what the spelling refers to.
// The two are separated because a backend needs the spelling at every
// parameter and the definition exactly once per type, which is why the
// worklist between them exists.
//
// THE WORKLIST IS TWO PARALLEL `Vec`s KEYED BY MANGLED NAME, and the
// name IS the identity: `tcode` is injective, so two types share a name
// exactly when they are one type. It is closed to a fixpoint before
// anything is emitted, because resolving a struct's fields discovers
// more types.
//
// `Res` IS STRUCTURAL HERE, and that follows sema rather than
// diverging from it: `TyRes(value, error, form)` carries no
// declaration, because "`Res<T>` and `Res<T, E>` are two arities of one
// name and sema asks which form it has at every `.try()`". It still
// answers to the library's name — `std.core.result.Res` — so a
// structural `Res` and a declared one are one C type.
//
// A UNION IS STRUCTURAL FOR THE SAME REASON AND NEEDS THE SAME
// TREATMENT. `A | B` written inline, or a set sema inferred, has no
// declaration to carry a layout — where a NAMED error set is already
// covered, because gen_c's whole representation of a set is the
// declared enum. So a structural union is a queued type like any other
// and gets the enum's shape: a tag and a union of its members.

Ast, Decl, DeclKind, Struct, Enum, Variant, Member, MemberKind = std.ast
Function, TypeId = std.ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId, Ty, Types, TyNamed, TyRes, TyArray, ResForm = sema.sema_ty
DeclId = sema.sema_id
World, Def, decl_at = sema.sema_def
Checker, Ctx = sema.sema_check
type_from_ast = sema.sema_type
union_reading = sema.sema_union
write_usize = sema.sema_diag
Emit, order = gen.gen_emit
sym_type, sym_variant, sym_member, tcode, GEN, USR = gen.gen_name
path_with, res_arity, is_failure, RES_PATH = gen.gen_name
GenFault = gen.gen_diag
CBackend = gen.gen_c.gen_c_state
Inst = sema.sema_inst
sub_with, enter_struct_tparams, leave_tparams = gen.gen_c.gen_c_mono
intern_named = gen.gen_c.gen_c_mono
request_slots = gen.gen_c.gen_c_fat

// Closing the worklist is a fixpoint: defining a type discovers the
// types of its fields, which may discover more. Eight passes is what
// the bootstrapper allows and no real program has ever needed two —
// a bound rather than a loop, because a backend that does not
// terminate is worse than one that reports.
MAX_TYPE_PASSES* : usize = 8

// -----------------------------------------------------------------
// spelling
// -----------------------------------------------------------------

// The C spelling of a type, written into `out`. Requests the type as a
// side effect, because anything spelled is something that needs a
// definition.
//
// It never reports: a spelling is wanted at a dozen sites and each of
// them has a better position than this does. `spellable` is the
// question to ask first, and `int` is what an unspellable type becomes
// so the emitted C still parses around the diagnostic.
ctype* = (be :: CBackend, id: TyId, out :: String) Res<(), AllocError> {
    be.types().at(id).match({
        Prim(p)  => out.add_bytes(c_prim(p.name)),
        Named(n) => maybe_ptr(be, id, n, out),
        Res(_)   => named_ctype(be, id, out),
        Union(_) => named_ctype(be, id, out),
        Array(_) => named_ctype(be, id, out),
        _        => out.add_bytes("int"),
    }).try();
    Ok(());
}

// A `Ptr<T>` IS A `T *` AND NOT A STRUCT. `mem_ptr.zen` says the whole
// of it — "a Ptr<T> is one machine word, the address of a run of T" —
// and its `addr` field is unexported precisely because nothing outside
// std.mem may see the representation. Emitting the declaration's struct
// instead would make `str`'s own `data` field a struct where the runtime
// floor has a pointer, and the two spellings of `str` would disagree.
//
// This is where the asterisk goes, and it is the one place: `declarator`
// writes the spelling, a space and the name, which is `uint8_t *p` — a
// legal C declarator with the `*` bound to the name.
maybe_ptr = (be :: CBackend, id: TyId, n: TyNamed, out :: String)
            Res<(), AllocError> {
    is_ptr_named(n).match({
        true  => ptr_ctype(be, n, out),
        false => maybe_scope(be, id, n, out),
    })
}

// A `Scope` IS A `zg_scope *` AND NOT A STRUCT, for exactly the reason
// a `Ptr<T>` is a `T *`: `@scope` is the enclosing BLOCK, and a value
// naming a block is the address of that block's record. Emitting the
// declaration's struct instead would give `Scope` a `defer` FIELD —
// storage for a member that has no body and never will, since
// `gen_c_scope.zen` is its body.
maybe_scope = (be :: CBackend, id: TyId, n: TyNamed, out :: String)
              Res<(), AllocError> {
    is_scope_named(n).match({
        true  => out.add_bytes("zg_scope *"),
        false => named_ctype(be, id, out),
    })
}

is_ptr_named* = (n: TyNamed) bool { n.name.eq("Ptr") }

// Beside `is_ptr_named` because it is the same question: these are the
// two named types whose C spelling is the runtime floor's rather than
// their declaration's.
is_scope_named* = (n: TyNamed) bool { n.name.eq("Scope") }

ptr_ctype = (be :: CBackend, n: TyNamed, out :: String)
            Res<(), AllocError> {
    n.args.get(0).match({
        Ok(t) => elem_ctype(be, t, out),
        None  => out.add_bytes("void *"),
    })
}

elem_ctype = (be :: CBackend, t: TyId, out :: String) Res<(), AllocError> {
    request_type(be, t).try();
    ctype(be, t, out).try();
    out.add_bytes(" *").try();
    Ok(());
}

named_ctype = (be :: CBackend, id: TyId, out :: String) Res<(), AllocError> {
    request_type(be, id).try();
    sym_type(out, be.types(), be.world(), id)
}

// A declarator: the spelling, a space, the name. Nothing in this
// subset is a pointer type, so nothing binds to the name — the moment
// `Ptr<T>` is lowered this is where the asterisk goes, in one place.
declarator* = (be :: CBackend, id: TyId, name: str, out :: String)
              Res<(), AllocError> {
    ctype(be, id, out).try();
    out.add_bytes(" ").try();
    out.add_bytes(name).try();
    Ok(());
}

// Can this type be spelled at all? Asked wherever a diagnostic has a
// position to point at.
spellable* = (be: CBackend, id: TyId) bool {
    be.types().at(id).match({
        Prim(p)  => c_prim_known(p.name),
        Named(_) => true,
        Res(_)   => true,
        Union(_) => true,
        Array(_) => true,
        _        => false,
    })
}

// A type with no bytes. `()` is `void` in a return position and is
// illegal as a member, so `Ok(())` carries nothing and a unit field is
// not emitted at all.
is_unit* = (be: CBackend, id: TyId) bool {
    be.types().at(id).match({
        Prim(p) => p.name.eq("()"),
        _       => false,
    })
}

// The C scalar behind a Zen primitive.
//
// `int` and `float` are sema's LITERAL types — "an integer literal is
// its own type until a context settles it". Reaching here means nothing
// settled it, which is legal (`x = 5;` with no written type), so the
// widest of the family is the honest answer and the same one every
// time.
c_prim* = (name: str) str {
    name.match({
        "i8"    => "int8_t",
        "i16"   => "int16_t",
        "i32"   => "int32_t",
        "i64"   => "int64_t",
        "int"   => "int64_t",
        "u8"    => "uint8_t",
        "u16"   => "uint16_t",
        "u32"   => "uint32_t",
        "u64"   => "uint64_t",
        "usize" => "size_t",
        "f32"   => "float",
        "f64"   => "double",
        "float" => "double",
        "bool"  => "bool",
        "str"   => "zg_str",
        "()"    => "void",
        _       => "int",
    })
}

// `int` is the spelling an unspellable type falls back to, so it
// cannot double as the answer for a Zen type that really is `int`.
// The list is asked directly.
c_prim_known* = (name: str) bool {
    is_c_integer(name) || name.is_in(["f32", "f64", "float", "bool", "str", "()"])
}

// Is this an integer type a trapping operation can be emitted for?
is_c_integer* = (name: str) bool {
    name.is_in(["i8", "i16", "i32", "i64", "int",
                "u8", "u16", "u32", "u64", "usize"])
}

is_signed* = (name: str) bool {
    name.is_in(["i8", "i16", "i32", "i64", "int"])
}

// -----------------------------------------------------------------
// the worklist
// -----------------------------------------------------------------

// Register a type for definition. The mangled name is the identity,
// because `tcode` is injective: two types share a name exactly when
// they are one type.
request_type* = (be :: CBackend, id: TyId) Res<(), AllocError> {
    ptr_element(be, id).match({
        Ok(et) => request_type(be, et),
        None   => request_defined(be, id),
    })
}

// A `Scope` HAS NO DEFINITION TO QUEUE. It is spelled `zg_scope *`, and
// the record behind that pointer is the runtime's — queueing the
// declaration would emit a struct with a `defer` FIELD, storage for a
// member that has no body and never will, since `gen_c_scope.zen` is
// its body.
request_defined = (be :: CBackend, id: TyId) Res<(), AllocError> {
    is_scope_type(be, id).match({
        true  => Ok(()),
        false => queue_definition(be, id),
    })
}

is_scope_type* = (be :: CBackend, id: TyId) bool {
    be.types().at(id).match({
        Named(n) => is_scope_named(n),
        _        => false,
    })
}

// A `Ptr<T>` needs no definition of its own — it is spelled `T *`
// wherever it appears — but the run it points at does, and a `T *`
// member still needs `T`'s typedef above it. So a request for the
// pointer is a request for the element, and the worklist's fixpoint
// reaches through it the way it reaches through a field.
ptr_element = (be :: CBackend, id: TyId) Res<TyId> {
    be.types().at(id).match({
        Named(n) => named_element(n),
        _        => None,
    })
}

named_element = (n: TyNamed) Res<TyId> {
    is_ptr_named(n).match({
        false => None,
        true  => n.args.get(0),
    })
}

queue_definition = (be :: CBackend, id: TyId) Res<(), AllocError> {
    name ::= be.alloc.String().try();
    sym_type(name, be.types(), be.world(), id).try();
    be.type_index(name.view()).match({
        None  => be.queue_type(name, id),
        Ok(_) => Ok(()),
    })
}

// Walk every queued type's children until nothing new appears.
close_types* = (be :: CBackend) Res<(), AllocError> {
    Range(0, MAX_TYPE_PASSES).loop((h, pass) {
        n = be.type_names.len;
        Range(0, n).loop((hh, i) { request_children(be, i).try() });
    });
    Ok(());
}

request_children = (be :: CBackend, i: usize) Res<(), AllocError> {
    be.type_id_at(i).match({
        None   => Ok(()),
        Ok(id) => request_members(be, id),
    }).try();
    Ok(());
}

request_members = (be :: CBackend, id: TyId) Res<(), AllocError> {
    be.types().at(id).match({
        Named(n) => request_named_members(be, n, id),
        Res(r)   => request_res_members(be, r),
        Union(u) => request_union_members(be, u.members),
        Array(a) => request_if_composite(be, a.elem),
        _        => Ok(()),
    }).try();
    Ok(());
}

request_union_members = (be :: CBackend, members: Vec<TyId>)
                        Res<(), AllocError> {
    members.loop((h, m) { request_if_composite(be, m).try() });
    Ok(());
}

// A BOUND'S SLOTS NEED DEFINITIONS TOO, and they are requested here
// rather than ordered in `gen_c_layout.by_value_deps`: a slot is a
// function pointer, so nothing in a record is by-value containment.
// Feeding them to the dependency walk would record `Eq -> Eq` and
// report a cycle that is not there.
request_named_members = (be :: CBackend, n: TyNamed, id: TyId)
                        Res<(), AllocError> {
    request_decl_members(be, n).try();
    request_slots(be, id).try();
    Ok(());
}

request_res_members = (be :: CBackend, r: TyRes) Res<(), AllocError> {
    request_if_composite(be, r.value).try();
    is_failure(r.form).then(() { request_if_composite(be, r.error).try() });
    Ok(());
}

request_if_composite = (be :: CBackend, id: TyId) Res<(), AllocError> {
    is_unit(be, id).match({
        true  => Ok(()),
        false => request_if_named(be, id),
    })
}

request_if_named = (be :: CBackend, id: TyId) Res<(), AllocError> {
    be.types().at(id).match({
        Named(_) => request_type(be, id),
        Res(_)   => request_type(be, id),
        Union(_) => request_type(be, id),
        Array(_) => request_type(be, id),
        _        => Ok(()),
    })
}

request_decl_members = (be :: CBackend, n: TyNamed) Res<(), AllocError> {
    decl_at(be.tree, n.decl).match({
        None  => Ok(()),
        Ok(d) => request_from_decl(be, n, d),
    }).try();
    Ok(());
}

// A DECLARATION'S MEMBER TYPES ARE READ AT THE TYPE'S OWN ARGUMENTS.
// `Vec<u8>`'s `data` is a `Ptr<u8>` and not a `Ptr<T>`, so its parameters
// go back in scope for the read and its arguments are substituted into
// the answer — the same two steps every other reader of a generic
// declaration takes, and `decl_inst` is the second one.
request_from_decl = (be :: CBackend, n: TyNamed, d: Decl)
                    Res<(), AllocError> {
    ctx  = decl_ctx(be, n);
    inst = decl_inst(be, n).try();
    mark = enter_struct_tparams(be, n.decl).try();
    d.kind.match({
        Struct(s) => request_fields(be, s.members, ctx, inst),
        Enum(e)   => request_variants(be, n, e.variants, ctx, inst),
        _         => Ok(()),
    }).try();
    leave_tparams(be, mark).try();
    Ok(());
}

// What a type's own arguments bound its declaration's parameters to.
decl_inst* = (be :: CBackend, n: TyNamed) Res<Inst, AllocError> {
    be.check.inst_of_named(n)
}

request_fields = (
    be      :: CBackend,
    members : Vec<Member>,
    ctx     : Ctx,
    inst    : Inst
) Res<(), AllocError> {
    members.loop((h, m) {
        field_type(be, m, ctx, inst).match({
            None  => Ok(()),
            Ok(t) => request_if_composite(be, t),
        }).try();
    });
    Ok(());
}

request_variants = (
    be       :: CBackend,
    n        : TyNamed,
    variants : Vec<Variant>,
    ctx      : Ctx,
    inst     : Inst
) Res<(), AllocError> {
    variants.loop((h, v) {
        variant_type(be, n, v, ctx, inst).match({
            None  => Ok(()),
            Ok(t) => request_if_composite(be, t),
        }).try();
    });
    Ok(());
}

// The struct a declaration IS, when it is one — the DeclId→Decl→Struct
// unwrap every member search starts with.
struct_decl* = (be: CBackend, decl: DeclId) Res<Struct> {
    decl_at(be.tree, decl).match({
        None  => None,
        Ok(d) => d.kind.match({ Struct(s) => Ok(s), _ => None }),
    })
}

// The context a declaration's own member types are read in: its module,
// and no `@Self` — a member type naming `@Self` by value would be a
// type of infinite size, and one behind a `Ptr` is out of this subset.
decl_ctx* = (be :: CBackend, n: TyNamed) Ctx {
    Ctx(
        module: n.decl.module.to_usize(),
        ret: TyId(index: 0),
        has_ret: false,
        self_ty: TyId(index: 0),
        has_self: false
    )
}

// THE RETURN TYPE AS WRITTEN, and `()` when nothing was written — a
// function that declares no return type returns unit, it does not
// return "unknown". Eight lowerings each re-read `f.ret` this way and
// then substituted their own instantiation over the answer; the reading
// is one rule and the substituting is theirs.
declared_ret* = (be :: CBackend, f: Function, ctx: Ctx)
                Res<TyId, AllocError> {
    f.ret.match({
        Ok(t) => be.check.type_from_ast(t, ctx),
        None  => be.check.types.prim("()"),
    })
}

// A struct member's storage type, or nothing when the member is not
// storage. A method is a function and a struct-body constant is one
// value per type; neither takes a field.
field_type* = (be :: CBackend, m: Member, ctx: Ctx, inst: Inst)
              Res<TyId> {
    m.kind.match({
        Field(fld) => fld.type.match({
            None  => None,
            Ok(t) => resolved(be, t, ctx, inst),
        }),
        _          => None,
    })
}

// A variant's payload type.
//
// Two readings, and DESIGN.md decides between them by what the names
// MEAN: `Shape = Circle(Circle) | Unit` is nominal and a payload is
// written, while `Error = AllocError | IoError` is "a union of existing
// types" and each variant carries a value OF the type it names — so
// `WriteError.IoError` records WHICH IoError, where tag-only it would
// record only that there was one.
variant_type* = (
    be   :: CBackend,
    n    : TyNamed,
    v    : Variant,
    ctx  : Ctx,
    inst : Inst
) Res<TyId> {
    v.payload.match({
        Ok(t) => resolved(be, t, ctx, inst),
        None  => union_member_type(be, n, v),
    })
}

// The type a bare variant name denotes, when it denotes one. Nothing
// when the name is not a type in the declaring module, which is the
// nominal reading and the common one.
//
// THE QUESTION IS ABOUT THE DECLARATION AND NOT ABOUT ONE VARIANT.
// DESIGN.md: `A | B` is a union of existing types when EVERY variant
// names a type in scope, and a nominal enum otherwise. Asked one
// variant at a time it has a different answer, and the difference is
// not academic — it is how `TokenKind` came to carry a trait. Sixty
// variants, exactly one of which (`Eq`, the `=` token) collides with a
// prelude export, and that one silently took `std.core.eq.Eq` as its
// payload: three dead words in every token the compiler lexes, and a
// union member no code path ever reads or writes.
//
// DESIGN.md names this collision and says it "must be reported, not
// silently reinterpreted". Two modules had already worked around it by
// renaming — `ast_node.zen` writes `Equal`, `sema_def.zen` suffixes
// every variant with `Def` — which is the workaround DESIGN.md predicts
// and not the rule. Deciding per declaration is the rule, and it costs
// nothing: the scan stops at the first variant that is not a bare type
// name, which for a nominal enum is normally the first variant.
union_member_type = (be :: CBackend, n: TyNamed, v: Variant) Res<TyId> {
    union_reading(be.check, n.decl).match({
        false => None,
        true  => bare_variant_type(be, n, v),
    })
}

bare_variant_type = (be :: CBackend, n: TyNamed, v: Variant) Res<TyId> {
    found ::= be.alloc.Vec<Def>();
    be.world().defs_of(n.decl.module.to_usize(), v.name.text, found).match({
        Err(_) => None,
        Ok(_)  => named_of(be, found),
    })
}

named_of = (be :: CBackend, found: Vec<Def>) Res<TyId> {
    found.get(0).match({
        None  => None,
        Ok(d) => interned_named(be, d),
    })
}

interned_named = (be :: CBackend, d: Def) Res<TyId> {
    empty ::= be.alloc.Vec<TyId>();
    intern_named(be.check, d, empty).match({
        Err(_) => None,
        Ok(id) => Ok(id),
    })
}

resolved = (be :: CBackend, t: TypeId, ctx: Ctx, inst: Inst) Res<TyId> {
    be.check.type_from_ast(t, ctx).match({
        Err(_) => None,
        Ok(id) => substituted(be, id, inst),
    })
}

substituted = (be :: CBackend, id: TyId, inst: Inst) Res<TyId> {
    sub_with(be, id, inst).match({
        Err(_) => None,
        Ok(t)  => Ok(t),
    })
}
