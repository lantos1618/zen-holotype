// law 6: inferred inside the module, written at the boundary.
//
//   read_num    private, set inferred from its body
//   parse_pair  private, set inferred from a call whose set is ALSO
//               inferred -- the inference-order case TESTING.md names
//   read_cfg*   exported, so the set is written out

CfgError* = Missing | Bad

read_num = (s: str) Res<i32, _> {
    (s == "7").match({
        true  => Ok(7),
        false => Err(CfgError.Bad),
    });
}

parse_pair = (s: str) Res<i32, _> {
    a = read_num(s).try();
    Ok(a + a);
}

read_cfg* = (s: str) Res<i32, CfgError> {
    Ok(parse_pair(s).try());
}
