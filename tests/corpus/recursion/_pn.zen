// probeN: drop prints via println sugar, callee called NOT in println arg
Noisy = {
    env: Env,
    tag: str,
}

Noisy.impl(Drop, {
    drop = (self :: @Self) () { println("drop {}", self.tag) }
})

three = (env: Env) i64 {
    f = Noisy(env: env, tag: "f");
    3
}

main = (env: Env) Res<i32, IoError> {
    x = three(env);
    println("chain {}", x);
    Ok(0);
}
