// FORK 1 of 2 on LEADING ZEROS. DESIGN.md does not decide whether a
// leading zero is legal, and no octal literal appears anywhere in it.
// This file assumes leading zeros are legal and DECIMAL: 007 is 7, and
// 010 is 10, not 8. The other reading is
// tests/must-fail/lex/number_leading_zero.zen.
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    a: i32 = 007;
    b: i32 = 010;
    c: i32 = 00;
    println("{}", a);
    println("{}", b);
    println("{}", c);
    Ok(0);
}
