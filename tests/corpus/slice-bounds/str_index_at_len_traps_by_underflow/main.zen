// str CARRIES NO LENGTH OF ITS OWN FOR THE BACKEND TO CHECK, so its
// bounds check is text_str.index's: `self.len - i - 1`, an unsigned
// underflow that IS the check -- for every i >= len the subtraction
// overflows and traps on itself. That is why the trap's WHAT is
// `integer overflow` and its WHERE is text_str.zen, not the caller:
// encoding the fixed-array wording here would pin the wrong helper.
// hex_digit_out_of_range.zen documents the idiom as deliberate.
//
// the boundary passed is EXACTLY s.len: one less and the byte prints,
// one step of slack anywhere in the arithmetic and this reads past the
// literal's static bytes instead of trapping. get(4) sits right beside
// it answering None, the contrast that shows the trap belongs to `[]`,
// whose out-of-range is a BUG, and not to get, whose miss is a value.

// a trap never lifts into Res: it aborts the process
Error = Overflow | DivideByZero | OutOfBounds

at_len = (s: str, i: usize) u8 { s[i] }

main = (env: Env) Res<i32, Error> {
    s = "abcd";
    println("{}", s[3]);
    s.get(4).match({
        Ok(b) => println("ok {}", b),
        None  => println("at-len miss"),
    });
    at_len(s, s.len);
    println("unreachable");
    Ok(0);
}
