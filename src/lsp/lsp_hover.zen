// Renders types and signatures already settled by sema. Missing or poisoned
// semantic information produces a hover whose `found` field is false.

str, String = std.text
Vec = std.collections
Range = std.core
Alloc, AllocError = std.mem
Ast, Decl, ExprId, Member, TypeId, Span, Function, TriviaRun = std.ast
Variant = std.ast
Checker = sema.sema_check
TyId, TyNamed, Prim = sema.sema_ty
Def, decl_at = sema.sema_def
to_pos, to_wire, WirePos, WireRange = lsp.lsp_pos
Tell, told_at = std.ast.ast_named
check_standalone = lsp.lsp_query
check_build = zen.zen_build
to_json = std.json

Hover* = {
    found*: bool,
    shown*: str,
    start*: WirePos,
    end*: WirePos,

    // `null` when nothing was found, else a plaintext MarkupContent.
    write* = (self: @Self, a: Alloc, out :: String) Res<(), AllocError> {
        self.found.match({
            false => out.add("null"),
            true  => {
                encoded ::= HoverResult(contents: MarkupContent(kind: "plaintext", value: self.shown), range: WireRange(start: self.start, end: self.end)).to_json(a).try();
                out.add(encoded.view())
            },
        })
    }
}

MarkupContent = {
    kind: str,
    value: str,
}

HoverResult = {
    contents: MarkupContent,
    range: WireRange,
}

hover_at* = (a: Alloc, name: str, text: str, line: usize, character: usize)
            Res<Hover, AllocError> {
    c ::= check_standalone(a, name, text).try();
    pos = to_pos(text, line, character);
    c.said(a, text, told_at(c.tree, name, pos))
}

hover_in* = (
    env       : Env,
    a         : Alloc,
    workspace : str,
    path      : str,
    text      : str,
    line      : usize,
    character : usize
) Res<Hover, AllocError> {
    checked = check_build(env, a, workspace, path, text).try();
    pos     = to_pos(text, line, character);
    checked.c.said(a, text, told_at(checked.c.tree, checked.rel, pos))
}

hover_with* = (
    c         : Checker,
    a         : Alloc,
    rel       : str,
    text      : str,
    line      : usize,
    character : usize
) Res<Hover, AllocError> {
    pos = to_pos(text, line, character);
    c.said(a, text, told_at(c.tree, rel, pos))
}

no_type = () Hover {
    Hover(
        found: false,
        shown: "",
        start: WirePos(line: 0, character: 0),
        end: WirePos(line: 0, character: 0)
    )
}

said = (c: Checker, a: Alloc, text: str, t: Tell) Res<Hover, AllocError> {
    out ::= a.String().try();
    t.match({
        Nothing     => Ok(no_type()),
        Sig(f)      => wired(
            text,
            f.name.span,
            c.write_decl_sig(f, out).try(),
            out
        ),
        OfType(ta)  => wired(
            text,
            ta.span,
            c.write_written_ty(ta.id, out).try(),
            out
        ),
        OfValue(v)  => wired(text, v.span, c.write_val(v.id, out).try(), out),
        Imported(_) => Ok(no_type()),
    })
}

wired = (text: str, span: Span, known: bool, out :: String)
        Res<Hover, AllocError> {
    Ok(Hover(
        found: known,
        shown: out.view(),
        start: to_wire(text, span.start),
        end: to_wire(text, span.end)
    ));
}

// The bool each writer returns is whether every type it wrote was settled.
write_written_ty = (c: Checker, id: TypeId, out :: String)
                   Res<bool, AllocError> {
    c.type_memo.get(id).match({
        None     => Ok(false),
        Ok(memo) => c.write_ty_named(memo, out),
    })
}

write_ty = (c: Checker, id: TypeId, out :: String) Res<bool, AllocError> {
    c.type_memo.get(id).match({
        None     => Ok(false),
        Ok(memo) => c.write_ty_id(memo, out),
    })
}

// A written type shows its declaration; a primitive shows its prelude members.
write_ty_named = (c: Checker, id: TyId, out :: String) Res<bool, AllocError> {
    c.poison_free(id).match({
        false => Ok(false),
        true  => c.types.at(id).match({
            Prim(p)  => c.write_prim(id, p, out),
            Named(n) => c.write_named(id, n, out),
            _        => { c.types.write_name(id, out).try(); Ok(true) },
        }),
    })
}

// A value shows its declaration only for a named type.
write_ty_value = (c: Checker, id: TyId, out :: String) Res<bool, AllocError> {
    c.poison_free(id).match({
        false => Ok(false),
        true  => c.types.at(id).match({
            Named(n) => c.write_named(id, n, out),
            _        => { c.types.write_name(id, out).try(); Ok(true) },
        }),
    })
}

write_named = (c: Checker, id: TyId, n: TyNamed, out :: String)
              Res<bool, AllocError> {
    c.types.write_name(id, out).try();
    decl_at(c.tree, n.decl).match({
        None   => Ok(true),
        Ok(dd) => { c.write_decl_note(dd, WHOLE_SHAPE, out).try(); Ok(true) },
    })
}

write_prim = (c: Checker, id: TyId, p: Prim, out :: String)
             Res<bool, AllocError> {
    c.types.write_name(id, out).try();
    defs ::= c.alloc.Vec<Def>();
    c.world.prelude_of(p.name, defs).try();
    defs.get(0).match({
        None  => Ok(true),
        Ok(d) => {
            c.write_prelude_note(d, out).try();
            Ok(true)
        },
    })
}

write_prelude_note = (c: Checker, d: Def, out :: String) Res<(), AllocError> {
    decl_at(c.tree, d.id).match({
        None   => Ok(()),
        Ok(dd) => c.write_decl_note(dd, EXPORTED_ONLY, out),
    })
}

write_decl_note = (c: Checker, dd: Decl, all: bool, out :: String)
                  Res<(), AllocError> {
    doc = doc_block(c.alloc, c.tree, dd.leading).try();
    (doc.len > 0).then(() {
        out.add(" — ").try();
        out.add(doc).try();
    });
    c.write_members(dd, Shown(joined: joiner(doc), all: all), out)
}

EXPORTED_ONLY: bool = false

WHOLE_SHAPE: bool = true

Shown = {
    joined: str,
    all: bool,
}

joiner = (doc: str) str {
    (doc.len == 0).match({
        true  => " — ",
        false => doc.ended().match({ true => " ", false => "; " }),
    })
}

write_members = (c: Checker, dd: Decl, shown: Shown, out :: String)
                Res<(), AllocError> {
    body ::= c.alloc.String().try();
    dd.kind.match({
        Struct(s) => c.write_member_run(s.members, shown.all, body),
        Enum(e)   => c.write_variant_run(e.variants, body),
        _         => Ok(()),
    }).try();
    (body.len() > 0).then(() {
        out.add(shown.joined).try();
        out.add(body.view()).try();
    });
    Ok(());
}

write_member_run = (c: Checker, ms: Vec<Member>, all: bool, body :: String)
                   Res<(), AllocError> {
    list  ::= c.alloc.String().try();
    names ::= c.alloc.Vec<str>();
    ms.loop((h, m) { c.write_one_member(m, all, names, list).try(); });
    (list.len() > 0).then(() {
        body.add("members: ").try();
        body.add(list.view()).try();
    });
    Ok(());
}

write_one_member = (
    c     : Checker,
    m     : Member,
    all   : bool,
    names :: Vec<str>,
    body  :: String
) Res<(), AllocError> {
    m.kind.match({
        Field(f)    => c.write_typed(
            all || f.exported,
            f.name.text,
            f.type,
            body
        ),
        Const(k)    => c.write_typed(
            all || k.exported,
            k.name.text,
            k.type,
            body
        ),
        Function(f) => c.write_fn_member(f, all, names, body),
    })
}

write_typed = (
    c    : Checker,
    show : bool,
    name : str,
    ty   : Res<TypeId>,
    body :: String
) Res<(), AllocError> {
    show.match({
        false => Ok(()),
        true  => {
            body.separate().try();
            body.add(name).try();
            c.write_type_suffix(ty, body)
        },
    })
}

write_type_suffix = (c: Checker, ty: Res<TypeId>, body :: String)
                    Res<(), AllocError> {
    ty.match({
        None   => Ok(()),
        Ok(id) => {
            scratch ::= c.alloc.String().try();
            c.write_ty(id, scratch).try().then(() {
                body.add(": ").try();
                body.add(scratch.view()).try();
            });
            Ok(());
        },
    })
}

// Arity overloads share a name; the first declaration is the one shown.
write_fn_member = (
    c     : Checker,
    f     : Function,
    all   : bool,
    names :: Vec<str>,
    body  :: String
) Res<(), AllocError> {
    (all || f.exported).match({
        false => Ok(()),
        true  => names.find((name) { name.eq(f.name.text) }).match({
            Ok(_) => Ok(()),
            None  => {
                names.add(f.name.text).try();
                scratch ::= c.alloc.String().try();
                whole = c.write_decl_sig(f, scratch).try();
                body.separate().try();
                whole.match({
                    true  => body.add(scratch.view()),
                    false => body.add(f.name.text),
                })
            },
        }),
    })
}

write_variant_run = (c: Checker, vs: Vec<Variant>, body :: String)
                    Res<(), AllocError> {
    vs.loop((h, i, v) {
        (i > 0).then(() { body.add(" | ").try() });
        body.add(v.name.text).try();
        c.write_payload(v.payload, body).try();
    });
    Ok(());
}

write_payload = (c: Checker, payload: Res<TypeId>, body :: String)
                Res<(), AllocError> {
    payload.match({
        None   => Ok(()),
        Ok(id) => {
            scratch ::= c.alloc.String().try();
            c.write_ty(id, scratch).try().then(() {
                body.add("(").try();
                body.add(scratch.view()).try();
                body.add(")").try();
            });
            Ok(());
        },
    })
}

separate = (body :: String) Res<(), AllocError> {
    (body.len() > 0).match({ true => body.add(", "), false => Ok(()) })
}

// The doc is the line comments after the last blank line, joined by spaces,
// cut at the first sentence-ending line.
doc_block = (a: Alloc, tree: Ast, run: TriviaRun) Res<str, AllocError> {
    doc ::= a.String().try();
    Range(after_last_blank(tree, run), run.len).loop((h, i) {
        piece = tree.trivia_at(run, i);
        doc.view().ended().match({
            true  => (),
            false => piece.kind.match({
                LineComment => add_doc_line(
                    comment_text(piece.text),
                    doc
                ).try(),
                _           => (),
            }),
        });
    });
    Ok(doc.view());
}

ended = (doc: str) bool {
    (doc.len > 0) && doc.index(doc.len - 1).is_in(['.', '!', '?'])
}

after_last_blank = (tree: Ast, run: TriviaRun) usize {
    from ::= 0;
    Range(0, run.len).loop((h, i) {
        tree.trivia_at(run, i).kind.match({
            Blank => { from = i + 1; },
            _     => (),
        });
    });
    from;
}

add_doc_line = (line: str, doc :: String) Res<(), AllocError> {
    (line.len > 0).then(() {
        (doc.len() > 0).then(() { doc.add(" ").try() });
        doc.add(line).try();
    });
    Ok(());
}

comment_text = (text: str) str {
    from ::= 0;
    loop(
        () { from < text.len && text.index(from) == '/' },
        (h) { from = from + 1; }
    );
    loop(
        () { from < text.len && text.index(from) == ' ' },
        (h) { from = from + 1; }
    );
    text.slice(from, text.len);
}

write_val = (c: Checker, e: ExprId, out :: String) Res<bool, AllocError> {
    c.expr_memo.get(e).match({
        None     => Ok(false),
        Ok(memo) => c.write_ty_value(memo, out),
    })
}

write_ty_id = (c: Checker, id: TyId, out :: String) Res<bool, AllocError> {
    c.poison_free(id).match({
        false => Ok(false),
        true  => { c.types.write_name(id, out).try(); Ok(true) },
    })
}

poison_free = (c: Checker, id: TyId) bool {
    c.types.at(id).match({
        Unknown   => false,
        Res(r)    => c.poison_free(r.value) && c.poison_free(r.error),
        Named(n)  => c.all_poison_free(n.args),
        Fn(f)     => c.poison_free(f.ret) && c.all_poison_free(f.params),
        Union(u)  => c.all_poison_free(u.members),
        Array(ar) => c.poison_free(ar.elem),
        _         => true,
    })
}

all_poison_free = (c: Checker, ids: Vec<TyId>) bool {
    every ::= true;
    ids.loop((h, id) { every = every && c.poison_free(id); });
    every;
}

write_decl_sig = (c: Checker, f: Function, out :: String)
                 Res<bool, AllocError> {
    out.add(f.name.text).try();
    out.add(" = ").try();
    f.write_tparams(out).try();
    out.add("(").try();
    whole ::= true;
    f.params.loop((h, i, prm) {
        (i > 0).then(() { out.add(", ").try() });
        out.add(prm.name.text).try();
        out.add(prm.binder()).try();
        whole = c.write_opt_ty(prm.type, out).try() && whole;
    });
    out.add(") ").try();
    Ok(c.write_opt_ty(f.ret, out).try() && whole);
}

write_tparams = (f: Function, out :: String) Res<(), AllocError> {
    (f.tparams.len == 0).match({
        true  => Ok(()),
        false => {
            out.add("<").try();
            f.tparams.loop((h, i, tparam) {
                (i > 0).then(() { out.add(", ").try() });
                out.add(tparam.name.text).try();
            });
            out.add(">").try();
            Ok(())
        },
    })
}

write_opt_ty = (c: Checker, t: Res<TypeId>, out :: String)
               Res<bool, AllocError> {
    t.match({
        None   => Ok(false),
        Ok(id) => c.write_ty(id, out),
    })
}
