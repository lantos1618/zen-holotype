// two impls on one type both supply a field named `width`. the bound in
// scope selects which one is in view -- never file order. DESIGN.md,
// Declarations. the no-bound case is must-fail/sema/impl_collision_no_bound.

Boxy = {
    width: i32,
    height: i32,

    area* ::= (self: @Self) i32 { self.width * self.height }
}

Framed = {
    width: i32,

    border* ::= (self: @Self) i32 { self.width + 2 }
}

Tile = {
    side: i32,
}

Tile.impl(Boxy, {
    width: self.side,
    height: self.side,
})

Tile.impl(Framed, {
    width: self.side * 10,
})

// the bound is the disambiguator, and it is the only one
boxy_width = <T: Boxy>(t: T) i32 { t.width }
framed_width = <T: Framed>(t: T) i32 { t.width }

main = (env: Env) Res<i32, AllocError> {
    t = Tile(side: 3);
    println("{}", boxy_width(t));
    println("{}", framed_width(t));

    // area is declared by Boxy alone, so no bound is needed to reach it
    println("{}", t.area());
    println("{}", t.border());
    Ok(0);
}
