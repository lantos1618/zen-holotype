// a bracket inside a literal is not a bracket -- the sibling of
// `string_containing_comment_markers`, for the other thing an editor
// decides before it has read a single token. `line.add_bytes(");")`
// (`gen_c_fs.zen`) is the shape that shows it: the `)` closing the call
// is the FOURTH character after the one inside the string, and anything
// pairing them textually reports the wrong one.
//
// The two `true`s are the character literals, said as a comparison
// rather than printed: a byte prints as its number, and `40` on a line
// of expected output tells a reader nothing about what was lexed.
main = (env: Env) Res<i32, ArgError> {
    shut = ");";
    open = "(";
    brace = "{";
    close_brace = "}";
    square = "[]";
    println("{}", shut);
    println("{}", open);
    println("{}", brace);
    println("{}", close_brace);
    println("{}", square);
    println("{}", open.index(0) == '(');
    println("{}", shut.index(0) == ')');
    Ok(0);
}
