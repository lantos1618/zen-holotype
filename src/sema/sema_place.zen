// src/sema/sema_place.zen
// `target = value;` — the one statement Zen spells two ways.
//
// Zen writes a DECLARATION and a WRITE identically, and `ast.Bind` keeps
// them identical: one target expression, one value, no flag saying
// which. So every rule about an assignment starts by asking which of the
// two it is looking at, and that question is this file's subject.
//
// A BARE NAME DECLARES. There is nothing to disagree with — the binding
// takes whatever the value turned out to be — so the only work is
// putting the name in scope.
//
// ANYTHING ELSE IS A PLACE, and a place already has a type, an owner and
// a marker. `p.x = e` and `buf[i] = e` write into storage the program
// declared somewhere else, so the value has to FIT that storage, the
// field has to be one this module may write, and the field has to have
// storage at all. Three rules, all of them about the target, none of
// them asked of a declaration.
//
// It lives beside `sema_type.zen` rather than in it because that file is
// "what does this node mean" and this is "what does this statement do" —
// and because a place is where the type question stops being the only
// one. `sema_own.zen` and `sema_recv.zen` ask the remaining two, about
// who owns the place and who may write through it; the split between
// those two and this one is types here, permission there.

Expr, ExprId, Bind, Access, Span, Ast = ast
AllocError = std.mem
TyId, Types = sema.sema_ty
Checker, Ctx = sema.sema_check
SemaFault, NameFault = sema.sema_diag
computed_member, writable_member = sema.sema_member
check_literal = sema.sema_trap
type_of, type_from_ast = sema.sema_type

// `x = e;`, `x: T ::= e;`.
bind_stmt* = (c :: Checker, b: Bind, ctx: Ctx) Res<TyId, AllocError> {
    got = c.type_of(b.value, ctx).try();
    want = c.bind_want(b, got, ctx).try();
    c.check_assign(b, got, want, ctx).try();
    c.bind_target(b, want, ctx).try();
    c.types.prim("()")
}

// WHAT THE VALUE HAS TO FIT. A written type wins. With none, a bare name
// declares and takes the value's own type; a path writes into storage
// that already has one. This answered `got` for both, which asked
// whether the value fits itself — a check no value can fail, and the
// reason `self.n = "not an int"` on an `n :: i32` compiled clean.
//
// The value is typed BEFORE this is asked, the order the annotated form
// already used: nothing pushes an expectation down, so asking the place
// first would buy nothing and would type a target that may not exist.
bind_want* = (c :: Checker, b: Bind, got: TyId, ctx: Ctx)
             Res<TyId, AllocError> {
    b.type.match({
        Ok(t) => c.type_from_ast(t, ctx),
        None  => c.place_want(b.target, got, ctx),
    })
}

// A place's type is the ordinary type of the expression: `type_of`
// answers it for reads, and a write asks the identical question of the
// identical node. Whatever it cannot resolve comes back poisoned, which
// `assignable` accepts, so an unresolved place fails open.
place_want* = (c :: Checker, id: ExprId, got: TyId, ctx: Ctx)
              Res<TyId, AllocError> {
    c.tree.expr_at(id).kind.match({
        Name(_) => Ok(got),
        _       => c.type_of(id, ctx),
    })
}

check_assign* = (c :: Checker, b: Bind, got: TyId, want: TyId, ctx: Ctx)
               Res<(), AllocError> {
    node = c.tree.expr_at(b.value);
    c.coerce(node.span.file, node.span, got, want, "").try();
    // the family agreeing is not the value fitting: `n: i32 =
    // 2147483648` is an `int` literal, and `literal_fits` says every
    // one of those fits every integer type — so `coerce` said nothing
    c.check_literal(b.value, got, want).try();
    Ok(());
}

// Only a bare name introduces a binding. `c.len = ..` and
// `buf[i] = ..` are assignments to something that already exists,
// which is why `Bind.target` is an expression and not an `Ident`.
bind_target* = (c :: Checker, b: Bind, ty: TyId, ctx: Ctx)
              Res<(), AllocError> {
    target = c.tree.expr_at(b.target);
    target.kind.match({
        Name(n)   => c.bind(n.text, ty, b.mutable),
        Access(a) => c.assign_access(target, a, ctx),
        _         => Ok(()),
    }).try();
    Ok(());
}

// `c.width = 5` on an impl-supplied field: there is nothing to assign
// into. "Mutation goes through exported methods, as it always does."
assign_access* = (c :: Checker, target: Expr, a: Access, ctx: Ctx)
                Res<(), AllocError> {
    c.writable_member(a, ctx).try();
    c.computed_member(a, ctx).try().match({
        true  => c.no_storage(target, a),
        false => Ok(()),
    })
}

no_storage* = (c :: Checker, target: Expr, a: Access) Res<(), AllocError> {
    c.report(target.span.file, target.span,
                SemaFault.ComputedFieldAssign(NameFault(name: a.name.text)))
}
