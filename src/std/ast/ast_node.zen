// src/std/ast/ast_node.zen
// What a node is: every declaration, type, expression, pattern and
// statement form DESIGN.md admits, and nothing else.
//
// ONE MODULE, forced not chosen: decls hold exprs, exprs hold types, a
// type holds an expr (`[u8, i32.BITS]`), a block holds stmts, a stmt
// holds a decl — one strongly-connected component (bootstrap/modules.py
// allows import cycles, so splitting by category was never actually
// blocked; it's one file because the subjects are one subject).
// `ast_span.zen` (where a node is) and `ast_id.zen` (how one is named)
// sit below this file rather than beside it.
//
// THE SHAPE, repeated by every family below:
//
//     Expr = { kind: ExprKind, span, leading, trailing }
//     ExprKind = Call(Call) | Binary(Binary) | ..
//
// A wrapper struct carries what every node has; a kind enum carries
// what makes it that node — so `e.span` needs no match, and
// `e.kind.match({ Binary(b) => .. })` binds the typed node in the arm.
//
// A CHILD IS NEVER HELD BY VALUE, only as an id into `Ast` (see
// ast_id.zen for why).

Span, Ident, QualifiedName, TriviaRun = std.ast.ast_span
ExprId, TypeId, PatternId, BlockId = std.ast.ast_id
Alloc, AllocError = std.mem

// ---------------------------------------------------------------------
// vocabulary
//
// The closed alphabets the nodes are written in. Each one is closed by
// DESIGN.md, so a new entry in any of them is a language change.
// ---------------------------------------------------------------------

// `+ - *` trap on overflow; `+% -% *%` wrap. Separate operators, not a
// flag: trapping and wrapping generate different C, and a flag is one
// `!` from generating the wrong one. No bitwise operators. `Equal` not
// `Eq`, since `Eq` is a prelude type a shadowing variant would trap.
BinOp* = Add
    | Sub
    | Mul
    | Div
    | Rem
    | AddWrap
    | SubWrap
    | MulWrap
    | Equal
    | NotEqual
    | Less
    | LessEq
    | Greater
    | GreaterEq
    | And
    | Or

// `!`, `-`, and `&` — `&` only ever appears in a diagnostic's
// counter-example (`p = &c.width`), but it parses, so it has a node.
UnOp* = Not | Neg | Addr

// DESIGN.md's method table, verbatim. Export (`*`) is orthogonal, on
// the member not here.
//
//     Required   `= sig`        impl must provide it
//     Sealed     `= sig {..}`   provided, cannot be overridden
//     Default    `::= sig {..}` provided, impl may rebind it
//     Hook       `::= sig`      optional, impl may provide it
//
// A plain top-level function with a body is Sealed — no fifth row for
// "not a member".
Form* = Required | Sealed | Default | Hook

LiteralKind* = Int | Float | Str | Char | Bool

// `text` is the RAW source slice (quotes, escapes, exactly as written)
// — the formatter reprints byte for byte, so decoding here would make
// `"\n"` and a literal newline indistinguishable on the way out. The
// lexer has already rejected bad escapes/leading zero/multi-byte
// chars, so decoding is total by the time sema wants it.
Literal* = {
    kind*: LiteralKind,
    text*: str,
}

// ---------------------------------------------------------------------
// types
// ---------------------------------------------------------------------

Type* = {
    kind*: TypeKind,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,
}

// `Unit` is `()`. `SelfType` is `@Self` — a variant not a `Named`
// carrying "@Self", since DESIGN.md says it "is not a name you could
// have written yourself" and a name-shaped one risks shadowing.
// `Infer` is `_` (as in `Res<Cfg, _>`). `Variadic` is `...`.
TypeKind* = Named(Named)
    | Union(Union)
    | Fn(FnType)
    | Array(ArrayType)
    | Unit
    | SelfType
    | Infer
    | Variadic

// `i32`, `Vec<T>`, `Map<K, V>`, `Res<(), AllocError>`. No qualified
// type — imports bind locally, so a bare name always suffices; adding
// `std.core.Res` would be a design change.
Named* = {
    name*: Ident,
    args*: Vec<TypeId>,
}

// `A | B` — an anonymous structural enum. FLAT: `A | B | C` is one
// Union of three members, never a Union of a Union, so error-set
// merging is concatenation and set equality is not a tree walk.
Union* = {
    members*: Vec<TypeId>,
}

// A function TYPE — `(a: i32, b: i32) i32`. Parameters must name
// themselves here too: `(i32, i32) i32` says nothing about which `i32`
// is which. Names are documentation only — resolution never sees them,
// so two FnTypes differing only in parameter names are one type.
FnType* = {
    tparams*: Vec<TParam>,
    params*: Vec<Param>,
    params_span*: Span,
    ret*: TypeId,
}

// `[u8, 64]`, `[u8, i32.BITS]`. The count is an expression because it
// is comptime, not because it is a literal.
ArrayType* = {
    elem*: TypeId,
    count*: ExprId,
}

// ---------------------------------------------------------------------
// patterns
// ---------------------------------------------------------------------

Pattern* = {
    kind*: PatternKind,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,
}

// `Name` covers BOTH a nullary variant (`None`, `Macos`, `Shape.Unit`)
// and a binder (`n` in `Ok(n)`) — same tokens, and which one it is
// depends on what's in scope, so it's sema's question, not the
// parser's (the parser answering would be guessing).
PatternKind* = Name(PatName)
    | Destructure(Destructure)
    | Wild
    | Literal(Literal)

PatName* = {
    name*: QualifiedName,
}

// `Ok(n)`, `Circle(circle)`, `Ok(_)`, nested: `Left(Full(n))`. The
// binder is a full pattern, which is why `Unit` and `Unit(_)` must be
// different nodes — else the formatter invents or deletes parens.
Destructure* = {
    name*: QualifiedName,
    binder*: PatternId,
}

// ---------------------------------------------------------------------
// expressions
// ---------------------------------------------------------------------

Expr* = {
    kind*: ExprKind,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,
}

// `Access` is `p.x` (DESIGN.md's "member expression"). Not spelled
// `Member` because that name is taken by what a struct body is made
// of — one name for two concepts saves nothing.
ExprKind* = Name(Name)
    | Literal(Literal)
    | Unit
    | SelfType
    | Scope
    | Meta(Meta)
    | Paren(Paren)
    | Array(ArrayLit)
    | FixedArray(FixedArray)
    | Lambda(Lambda)
    | Call(Call)
    | Match(Match)
    | Try(Try)
    | Record(Record)
    | Access(Access)
    | Index(Index)
    | Unary(Unary)
    | Binary(Binary)
    | Consume(Consume)
    | Block(BlockId)

// A bare identifier. Carries text, not an `Ident` — the enclosing
// `Expr` already has the span, and two spans for one token is two
// things to keep in agreement.
Name* = {
    text*: str,
}

// `(n == 0)` is its own node — POSITIONS.md asserts a span for it.
// Without one the formatter must re-derive every paren pair from
// precedence, and `(a + b) * c` vs `a + b * c` are not the same program.
Paren* = {
    inner*: ExprId,
}

// `[0, 1, 2]`
ArrayLit* = {
    elems*: Vec<ExprId>,
}

// `[i32, 4](2, 3, 5, 7)` — a fixed-array type applied to its elements.
// Its own kind, not a Call: an array literal is never a callee, and
// the reading has to be decidable at the `(`.
FixedArray* = {
    type*: TypeId,
    elems*: Vec<ExprId>,
    args_span*: Span,
}

// `(a: i32, b: i32) i32 { a + b }`, `(h, v) { .. }`, `() { .. }`.
// Parameter types are optional here and only here: a closure passed to
// a function whose signature is known infers its param types from it.
// A declaration is not a lambda and must write them.
Lambda* = {
    tparams*: Vec<TParam>,
    params*: Vec<Param>,
    params_span*: Span,
    ret*: Res<TypeId>,
    body*: BlockId,
}

// `f(a, b)`, `alloc.Vec<i32>()`, `Point(x: 3, y: 4)`.
Call* = {
    callee*: ExprId,
    targs*: Vec<TypeId>,
    args*: Vec<Arg>,
    args_span*: Span,
}

// One argument. `name` is the `x` of `x: 3` — construction and an
// impl's supplied field share this form and this node.
Arg* = {
    name*: Res<Ident>,
    value*: ExprId,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,
}

// `(n == 0).match({ true => .., false => .. })`.
//
// A kind of its own, not a Call, even though DESIGN.md calls match "a
// method": its argument is an arm list, not an expression, and
// exhaustiveness is a load-bearing correctness property that shouldn't
// depend on the checker recognizing a callee by spelling.
//
// `name_span` is the `match` token — an "is not exhaustive" diagnostic
// points there, and the formatter needs it to locate `.match(`.
Match* = {
    scrutinee*: ExprId,
    name_span*: Span,
    arms*: Vec<Arm>,
    arms_span*: Span,
}

// `pattern => expr`. `arrow_span` is the `=>`: the formatter aligns
// arms on it, and it cannot align what it cannot locate.
Arm* = {
    pattern*: PatternId,
    arrow_span*: Span,
    body*: ExprId,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,
}

// `.try()` — the non-local-exit intrinsic, NOT a call. There's no
// `try` field on `Res` and no function of that name, so parsing it as
// a call would create a name to special-case everywhere it's shadowed.
//
// `name_span` is the `try` token, here for the same reason as
// `Match.name_span`: the node's own span starts at the OPERAND
// (`checked(n).try()` begins at `checked`), which would point a
// diagnostic at code that is perfectly well formed.
Try* = {
    operand*: ExprId,
    name_span*: Span,
}

// `{ src: Path("src/main.zen"), deps: [json] }` — the brace literal, as
// a call argument or an impl body. Entries are `Member`s not `Arg`s:
// an impl supplies methods as well as values, one rule and one node.
Record* = {
    entries*: Vec<Member>,
}

// `p.x`, `Shape.Unit`, `i32.MAX`, `alloc.Vec`. Field access, a type
// constant, a variant, and a ufcs method are all this one node — a new
// spelling of an existing access form, not a new concept.
Access* = {
    base*: ExprId,
    name*: Ident,
}

// `buf[i]`. Bounds-checked and trapping on a fixed array; `Vec.get`
// is a call and returns `Res`.
//
// `op_span` is the `[`: a trap prints `file:line:col`, DESIGN.md fixes
// that position at the operator token (same reason `Unary`/`Binary`
// carry theirs — re-deriving it from the operand gap would be a second
// source read in the backend).
Index* = {
    base*: ExprId,
    index*: ExprId,
    op_span*: Span,
}

// `op_span` is the operator token, load-bearing not cosmetic (see Index).
Unary* = {
    op*: UnOp,
    op_span*: Span,
    operand*: ExprId,
}

Binary* = {
    op*: BinOp,
    op_span*: Span,
    lhs*: ExprId,
    rhs*: ExprId,
}

// `consume f` — a move, stated at the use site. The only thing the
// capability system ever writes down.
Consume* = {
    operand*: ExprId,
}

// `@meta(n)` and `@meta(self: @Self)`. Stage 5. The second form is the
// only place an argument carries a type annotation, so it gets its own
// fields rather than being bent into an `Arg`. Exactly one of `value`
// and `name`+`type` is present.
Meta* = {
    value*: Res<ExprId>,
    name*: Res<Ident>,
    type*: Res<TypeId>,
}

// ---------------------------------------------------------------------
// statements and blocks
// ---------------------------------------------------------------------

// A statement ends with `;`; a declaration does not. A Stmt's span
// INCLUDES its `;` (else deleting a statement leaves it behind); the
// expression inside does not.
Stmt* = {
    kind*: StmtKind,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,
}

// `Decl` is here because a struct/enum/impl/function may be declared
// anywhere, not only at module level, and takes no `;` wherever it stands.
StmtKind* = Bind(Bind) | Expr(ExprStmt) | Decl(Decl) | Block(BlockId)

// `x = e;`, `x ::= e;`, `x: T = e;`, `self.len = self.len + 1;`. The
// target is an expression, not a name: a member and an index are
// binding targets too, and narrowing to `Ident` would make
// `self.len = ..` unrepresentable.
Bind* = {
    target*: ExprId,
    type*: Res<TypeId>,
    mutable*: bool,
    value*: ExprId,
}

ExprStmt* = {
    expr*: ExprId,
}

// A block is a value too. `value` is the trailing expression written
// WITHOUT a `;`. DESIGN.md also lets a `;`-terminated tail (`Ok(0);`)
// be the value, but that's a typing rule not a syntactic one — this
// records only what was written, and sema decides.
Block* = {
    stmts*: Vec<Stmt>,
    value*: Res<ExprId>,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,
}

// ---------------------------------------------------------------------
// declarations
// ---------------------------------------------------------------------

Decl* = {
    kind*: DeclKind,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,
}

// `Import` is a DeclKind, not a separate list on `Module`, so
// `Module.decls` is the file in source order — a formatter merging two
// lists back into one order will eventually get it wrong.
DeclKind* = Struct(Struct)
    | Enum(Enum)
    | Alias(Alias)
    | Function(Function)
    | Impl(Impl)
    | Import(Import)
    | Const(Const)

// `Vec*<T> = { .. }`. `body_span` is the `{ .. }`: a struct body is not
// a `Block` (it holds members not statements), but the formatter still
// needs to know where its braces are.
Struct* = {
    name*: Ident,
    exported*: bool,
    tparams*: Vec<TParam>,
    members*: Vec<Member>,
    body_span*: Span,
}

// `Shape = Circle(Circle) | Rect(Rect) | Unit`, `AllocError* = | OutOfMemory`.
//
// `leading_bar` is the bar of the one-variant form, stored rather than
// derived from `variants.len == 1` because the formatter reprints what
// was written. It's also why an enum needs no lookahead: without it,
// `AllocError = OutOfMemory` and `Alias = Shape` are the same tokens.
Enum* = {
    name*: Ident,
    exported*: bool,
    tparams*: Vec<TParam>,
    variants*: Vec<Variant>,
    leading_bar*: Res<Span>,
}

// One payload type, never a list. A payload is a TYPE: `Circle(Circle)`,
// `Failed(str)`, never `name: value` — which keeps `Package(url: "..")`
// a call, not a variant.
Variant* = {
    name*: Ident,
    payload*: Res<TypeId>,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,
}

// `Alias = Shape`. An alias IS the type, not a name forwarding to it —
// sema resolves it away, nothing downstream sees a second type.
Alias* = {
    name*: Ident,
    exported*: bool,
    tparams*: Vec<TParam>,
    target*: TypeId,
}

// `area* = (c: Circle) f64 { .. }`, `then* = <T>(b: bool, f: () T) Res<T>`.
//
// `form` and `body` are not redundant: `form` records `=` vs `::=`,
// `body` whether `{ .. }` followed. Required/Hook carry no body;
// Sealed/Default carry one.
//
// `ret` is `Res` because a lambda may omit it (meaning `()`); a
// declaration must write it — law 6 at the module boundary, D15a inside.
Function* = {
    name*: Ident,
    exported*: bool,
    form*: Form,
    tparams*: Vec<TParam>,
    params*: Vec<Param>,
    params_span*: Span,
    ret*: Res<TypeId>,
    body*: Res<BlockId>,
}

// `Circle.impl(Rect, { width: .., height: .. })`.
//
// `target` is `Circle`, `bound` is `Rect` (DESIGN.md's word: "which
// struct's shape do I need"). `target` is an `Ident` not a type — an
// impl lives in the module declaring its target, so there's no
// qualified form to write and no orphan impl to express.
Impl* = {
    target*: Ident,
    bound*: TypeId,
    members*: Vec<Member>,
    body_span*: Span,
}

// `Res*, Ok*, None* = std.core.result`. Re-export is just an import
// whose bindings are starred — the star is the whole mechanism.
Import* = {
    names*: Vec<ImportName>,
    module*: QualifiedName,
}

ImportName* = {
    name*: Ident,
    exported*: bool,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,
}

// A module-level value binding: `json_pkg = Package(url: "..", ..)`,
// `STR_HASH_SEED*: u64 = 14695981039346656037`. Also used as a
// struct-body constant (`MAX*: i32 = 2147483647`): one value per type,
// not storage per instance.
Const* = {
    name*: Ident,
    exported*: bool,
    mutable*: bool,
    type*: Res<TypeId>,
    value*: ExprId,
}

// ---------------------------------------------------------------------
// members
//
// What a struct body, an impl body and a record literal are all made
// of — one node for the three, since DESIGN.md gives them one rule: a
// struct whose fields happen to be functions, used as a bound, is what
// other languages call a trait; nothing marks it special.
// ---------------------------------------------------------------------

Member* = {
    kind*: MemberKind,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,
}

// The Field/Const split is SYNTACTIC (grammar's R4): in a struct body,
// `name: T = value` (immutable) is a constant, `name :: T = value`
// (mutable) is a field with a default. Const never appears in an impl
// body or record literal, where `name: value` supplies a field.
//
// Known hole, not a decision: an IMMUTABLE field with a default is
// unspellable.
MemberKind* = Field(Field) | Const(Const) | Function(Function)

// `width: f64`, `len* :: usize = 0`, and — in an impl or record —
// `width: self.radius * 2.0`, where type is absent because the field
// being satisfied already has one.
Field* = {
    name*: Ident,
    exported*: bool,
    mutable*: bool,
    type*: Res<TypeId>,
    value*: Res<ExprId>,
}

// ---------------------------------------------------------------------
// parameters
// ---------------------------------------------------------------------

// `self :: @Self` is not a receiver rule: `mutable` is the ordinary
// binding marker on the ordinary first parameter. `type` is absent
// only in a closure.
Param* = {
    name*: Ident,
    mutable*: bool,
    type*: Res<TypeId>,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,
}

// `<T>`, `<T: Rect>`, `<K: Eq + Hash, V>`. Bounds are a LIST because
// `+` joins them: `Eq + Hash` is two requirements on one type, where
// `A | B` is one type that is either.
TParam* = {
    name*: Ident,
    bounds*: Vec<TypeId>,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,
}

// ---------------------------------------------------------------------
// modules
// ---------------------------------------------------------------------

// `name` is the dotted module path (`std.core.result`), the module's
// identity; the source file is `span.file`, already carried by every
// node in it.
//
// `trailing` is where an end-of-file comment lives — it has nowhere
// else to go, and a formatter dropping it fails its own round trip.
Module* = {
    name*: str,
    decls*: Vec<Decl>,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,
}

// The module's function declarations, in source order. DESIGN.md's
// `build.zen` writes `b.module(Path("src")).functions` and filters it
// to find tests — change the filter, change what a test is. A
// function taking `Alloc`, not a field: gathering into a Vec
// allocates, and storing a second copy beside `decls` duplicates a fact.
functions* = (self: Module, a: Alloc) Res<Vec<Function>, AllocError> {
    found ::= a.Vec<Function>();
    self.decls.loop((h, d) {
        d.kind.match({
            Function(f) => found.add(f),
            _           => Ok(()),
        }).try();
    });
    Ok(found);
}
