// std.core.time
// a span, not a clock — reading the clock is authority (lives on Env);
// describing a duration is arithmetic (lives here).
//
// ONE REPRESENTATION: a Duration is a nanosecond count, nothing else.
// The unit is consumed at construction — `seconds(60)` IS
// `Duration(ns: 6e10)` — so nothing later can ask which spelling made it.
//
// Five constructors, not an enum, because the unit doesn't SURVIVE
// construction (unlike `IoError` or `Shape`, which a caller matches on
// later): `Seconds(1)` and `Millis(1000)` are the same span, so as
// variants `eq` would need to normalise first, `add` would need to
// pick a result unit, and every op would open a five-arm match just
// to convert. Rule, generalised: if the distinction is consumed at
// construction, it's a constructor, not a variant.

Res = std.core.result

Duration* = {
    ns*: u64,
}

// The unit conversions, in. Each is a ufcs fn over `u64` — `seconds(60)`
// and `n.seconds()` are the same call. NOT writable: `60.seconds()`
// (a literal carries no member) or `Duration.seconds(60)` (a comment
// here used to wrongly claim it was — `Duration.seconds` is a TYPE
// lookup, for constants/variants, and `seconds` is neither; UFCS puts
// it on `u64`, its first param, not on `Duration`).
NS_PER_MICRO*  : u64 = 1000
NS_PER_MILLI*  : u64 = 1000000
NS_PER_SECOND* : u64 = 1000000000
NS_PER_MINUTE* : u64 = 60000000000

nanos*   = (n: u64) Duration { Duration(ns: n) }
micros*  = (n: u64) Duration { Duration(ns: n * NS_PER_MICRO) }
millis*  = (n: u64) Duration { Duration(ns: n * NS_PER_MILLI) }
seconds* = (n: u64) Duration { Duration(ns: n * NS_PER_SECOND) }
minutes* = (n: u64) Duration { Duration(ns: n * NS_PER_MINUTE) }

// and out. One accessor per constructor — asymmetry is a trap (build
// from minutes, read only millis, and someone hand-divides and gets
// it wrong). These TRUNCATE: `millis_of` is whole milliseconds fit,
// not rounded — 1500us is 1ms + 500us, not 1.5ms.
nanos_of*   = (self: Duration) u64 { self.ns }
micros_of*  = (self: Duration) u64 { self.ns / NS_PER_MICRO }
millis_of*  = (self: Duration) u64 { self.ns / NS_PER_MILLI }
seconds_of* = (self: Duration) u64 { self.ns / NS_PER_SECOND }
minutes_of* = (self: Duration) u64 { self.ns / NS_PER_MINUTE }

// AND HERE AN ENUM IS RIGHT — printing survives construction: two
// callers can disagree about presentation without disagreeing about
// the span. Keeping it in the VALUE instead would make
// `Duration(Second, 1)` and `Duration(Milli, 1000)` two
// representations of one span — Map's Eq/Hash need those to agree,
// and normalising in one but not the other hashes an equal key
// differently.
Unit* = Nano | Micro | Milli | Second | Minute

// Largest unit this span fills at least once: 1500ms is Second, 999ms
// is Milli, 0 is Nano (nothing has no larger unit to claim). Guarded
// early answers over a match-of-matches: each rung names the one bound
// it clears, first truth wins, the trailing break the answer to
// everything smaller.
unit_of* = (self: Duration) Unit {
    found: Res<Unit> = loop<Unit>((h) {
        (self.ns >= NS_PER_MINUTE).then(() { h.break(Unit.Minute) });
        (self.ns >= NS_PER_SECOND).then(() { h.break(Unit.Second) });
        (self.ns >= NS_PER_MILLI).then(() { h.break(Unit.Milli) });
        (self.ns >= NS_PER_MICRO).then(() { h.break(Unit.Micro) });
        h.break(Unit.Nano);
    });
    found.match({
        Ok(one) => one,
        None    => Unit.Nano,
    });
}

// how many of that unit, truncating — paired with unit_of for Display,
// neither storing the other's answer.
count_in* = (self: Duration, u: Unit) u64 {
    u.match({
        Nano   => self.ns,
        Micro  => self.ns / NS_PER_MICRO,
        Milli  => self.ns / NS_PER_MILLI,
        Second => self.ns / NS_PER_SECOND,
        Minute => self.ns / NS_PER_MINUTE,
    });
}

suffix* = (u: Unit) str {
    u.match({
        Nano => "ns", Micro => "us", Milli => "ms",
        Second => "s", Minute => "m",
    });
}

add* = (self: Duration, other: Duration) Duration {
    Duration(ns: self.ns + other.ns)
}

// `sub` is a Res, `add` isn't: Duration is unsigned, so a shorter
// span minus a longer one has no answer (Res). Overflowing `add` is
// a caller bug and traps, like every other `+`.
sub* = (self: Duration, other: Duration) Res<Duration> {
    (self.ns >= other.ns).match({
        true  => Ok(Duration(ns: self.ns - other.ns)),
        false => None,
    });
}
