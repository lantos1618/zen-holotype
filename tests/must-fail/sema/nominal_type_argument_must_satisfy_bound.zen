// Bounds belong to generic nominal declarations as surely as to generic
// functions. Writing a concrete application proves each argument at the type
// use, before layout or construction can treat the application as legitimate.

Shape = { width: i32 }
Dot = {}

Box<T: Shape> = { value: T }
Maybe<T: Shape> = Some(T) | None

bad_box = (value: Box<Dot>) () {}
bad_maybe = (value: Maybe<Dot>) () {}

main = (env: Env) Res<i32, AllocError> { Ok(0) }
