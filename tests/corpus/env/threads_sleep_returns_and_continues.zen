// issue 781: sleep used to lower to a call through the NULL vtable slot
// of an Env field no lowering populates -- SIGSEGV before the print.
// It must actually sleep (POSIX nanosleep floor), RETURN, and let the
// next statement run.
main = (env: Env) Res<i32, IoError> {
    env.threads.sleep(10);
    println("returned from sleep");
    Ok(0);
}
