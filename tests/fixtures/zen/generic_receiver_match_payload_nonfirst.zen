{ to_exit } = std.core.bool
Box<T>: {
    value: T,
    get = (box: Box<T>) T { box.value }
}
Msg*: Empty | Hold(Box<StringView>)
main = () i32 {
    msg := Msg.Hold(Box<StringView>(value: "generic"))
    got := msg.match ({
        .Empty     => "empty",
        .Hold(box) => box.get(),
    })
    (got == "generic").to_exit()
}
