// MUST FAIL: two arms of a `.match` disagree, and NOTHING WROTE A TYPE
// DOWN for them. `x = <match>` takes its type from the value, so there
// is no position to blame and `sema_place.written_want` deliberately
// asked the arms nothing at all — the four `match_arms_disagree*` files
// beside this one all pin a position that HAS a word (a return, a
// declared type, a field, an argument, an element).
//
// THE ARMS STILL OWE EACH OTHER. `sema_join.zen`'s header states the
// rule this closes: "two arms of genuinely different types mean
// something the language cannot express — inventing a join for it would
// hide the mistake rather than report it." The join declined to invent
// one and answered the first arm's type, and with no position to check
// against, nothing else ever spoke.
//
// SO THE SENTENCE IS THE ARMS' AND NOT A POSITION'S. "expected int"
// would put the first arm's literal type in the voice of something that
// asked for it, and nothing here did; `SemaFault.ArmsDisagree` contrasts
// one arm with the rest instead.
//
// WHY THIS IS WORSE THAN A MISSING MESSAGE: cc accepts the emitted C —
// the match takes `int`, `false` lowers to 0 — so the program RUNS and
// prints a plausible wrong answer, the same way `match_arms_disagree`
// did before `check_arms` landed.
f = (b: bool) i32 {
    x = b.match({
        true  => 1,
        false => false,
    });
    x;
}

main = (env: Env) Res<i32, ArgError> {
    println("{}", f(false));
    Ok(0);
}
