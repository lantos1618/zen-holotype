// src/sema/sema_bound.zen
// What a bound promises, and who owes it: an IMPL, and a CALL SITE.
//
// Both halves ask one question — does this type keep that promise — and
// both answer it through `satisfies_bound`. The impl half arrived first;
// the call-site half moved here from `sema_call.zen` when that file
// crossed STYLE.md's hard cap, and it belongs here rather than there:
// `sema_call.zen`'s subject is WHICH DECLARATION a call means, and by
// the time bounds are checked that has already been decided. The two
// files depend on each other and that is fine — `sema_type` and
// `sema_call` already do, and a module cycle is a name-resolution fact
// with no cost in the output.
//
// Split from `sema_member.zen`, which answers "what does a dot reach".
// These are two subjects and STYLE.md's rule is to split by subject: the
// member table is asked at every `p.x` in the program and has to be
// fast; these two are asked once per impl and once per generic call, and
// they are the only place in this folder that says a program is WRONG
// about a bound rather than merely uninformative about one.
//
// The one thing they share is `bound_members` — the members a bound
// declares — and it stays with the table, because the table is what
// reads it on every access.
//
// A BOUND IS A PROMISE, and `satisfies_bound` is deliberately narrow: an
// impl of it, or the same type, and nothing else. A type that happens to
// have a field of the right name has not made the promise, and accepting
// it would make the bound a shape check rather than a declaration —
// which is the difference between "which struct's shape do I need" and
// "whatever has these names".

Ast, Decl, DeclKind, Struct, Impl, Member, MemberKind = ast
Field, Const, Function, Form, Span, TypeId = ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
DeclId, ImplId = sema.sema_id
TyId, Ty, Types, TyNamed = sema.sema_ty
World, Def, decl_at = sema.sema_def
Diag, SemaFault, NameFault, TypeFault = sema.sema_diag
Checker, Ctx = sema.sema_check
member_named, opaque = sema.sema_member
bound_members, has_member, impl_span, impl_bound_type = sema.sema_supply
type_from_ast = sema.sema_type
Cand, TBound, Actual = sema.sema_call
ty_at, is_tvar = sema.sema_cand

// "`A.impl(B, {..})` supplies a value for every field `B` declares."
// Every field, and every member the bound left to the impl — a sealed or
// default member has a body already, and an optional hook is optional by
// declaration.
check_impl* = (c :: Checker, id: ImplId, mi: usize) Res<(), AllocError> {
    c.world.impl_at(c.tree, id).match({
        Ok(im) => check_impl_body(c, im, id, mi),
        None   => Ok(()),
    }).try();
    Ok(());
}

check_impl_body = (c :: Checker, im: Impl, id: ImplId, mi: usize)
                  Res<(), AllocError> {
    bound = impl_bound_type(c, im, mi).try();
    members ::= c.alloc.Vec<Member>();
    bound_members(c, bound, members).try();
    span = impl_span(c, id);
    members.loop((h, m) { owed(c, im, m, span).try() });
    Ok(());
}

owed = (c :: Checker, im: Impl, m: Member, span: Span) Res<(), AllocError> {
    (required(m) && (has_member(im.members, member_name(m)) == false)).match({
        true  => missing(c, span, member_name(m)),
        false => Ok(()),
    })
}

// A field with no default, or a member the bound declared with no body
// and no `::=`. The four forms are DESIGN.md's method table verbatim:
// Required must be provided, Sealed and Default already are, and a Hook
// is optional by construction.
required* = (m: Member) bool {
    m.kind.match({
        Field(f)    => f.value.match({ Ok(_) => false, None => true }),
        Function(f) => f.form.match({ Required => true, _ => false }),
        Const(_)    => false,
    })
}

member_name* = (m: Member) str {
    m.kind.match({
        Field(f)    => f.name.text,
        Const(k)    => k.name.text,
        Function(f) => f.name.text,
    })
}

missing = (c :: Checker, span: Span, name: str) Res<(), AllocError> {
    c.report(span.file, span, SemaFault.ImplMissingField(NameFault(name: name)))
}

// Does `ty` keep the promise `bound` makes? An impl of it, or the same
// type — and nothing else. "The bound is the promise", so a type that
// happens to have a field of the right name has not made one.
//
// `same_type` and not `eq`, and that is forced by what this folder does
// not do yet: instantiation does not SUBSTITUTE. `Vec.impl(Range<T>,
// ..)` writes `Vec`'s own `T`, the call `v.loop(..)` wants `loop`'s `T`,
// and those are two `TyVar`s by construction — `TyVar` is nominal on its
// owner precisely so they cannot be confused. An id compare therefore
// says NO to every generic bound in the program, which is not a check,
// it is a blanket rejection. `sema_check.zen` states the rule once and
// both halves of this file read it.
satisfies_bound* = (c :: Checker, ty: TyId, bound: TyId)
                   Res<bool, AllocError> {
    c.same_type(ty, bound).match({
        true  => Ok(true),
        false => impls_bound(c, ty, bound),
    })
}

impls_bound = (c :: Checker, ty: TyId, bound: TyId) Res<bool, AllocError> {
    c.types.at(ty).match({
        Named(n) => named_impls_bound(c, n, bound),
        _        => Ok(false),
    })
}

named_impls_bound = (c :: Checker, n: TyNamed, bound: TyId)
                    Res<bool, AllocError> {
    ids ::= c.alloc.Vec<ImplId>();
    c.world.impls_named(c.tree, n.name, ids).try();
    hit ::= false;
    ids.loop((h, id) {
        got = local_bound_is(c, id, n, bound).try();
        hit = hit || got;
    });
    Ok(hit);
}

local_bound_is = (c :: Checker, id: ImplId, n: TyNamed, bound: TyId)
                 Res<bool, AllocError> {
    (n.decl.module == id.decl.module).match({
        true  => impl_bound_is(c, id, n, bound),
        false => Ok(false),
    })
}

impl_bound_is = (c :: Checker, id: ImplId, n: TyNamed, bound: TyId)
                Res<bool, AllocError> {
    mi = n.decl.module.to_usize();
    c.world.impl_at(c.tree, id).match({
        Ok(im) => bound_matches(c, im, mi, bound),
        None   => Ok(false),
    })
}

// Through `impl_bound_type` and not `type_from_ast` directly, so the
// target's own type parameters are in scope: `Vec.impl(Range<T>, ..)`
// writes `Vec`'s `T`, and there is no other declaration of that name to
// find.
bound_matches = (c :: Checker, im: Impl, mi: usize, bound: TyId)
                Res<bool, AllocError> {
    got = impl_bound_type(c, im, mi).try();
    Ok(c.same_type(got, bound));
}

// ---------------------------------------------------------------------
// bounds at a call site
//
// "The bound is the promise; this call does not keep it." The type
// argument is read off the parameter it appears in, which is the only
// place a call site says what it is.
// ---------------------------------------------------------------------

check_bounds* = (c :: Checker, cand: Cand, actuals: Vec<Actual>)
                Res<(), AllocError> {
    cand.tbounds.loop((h, tb) {
        check_one_bound(c, cand, tb, actuals).try();
    });
    Ok(());
}

check_one_bound = (c :: Checker, cand: Cand, tb: TBound,
                   actuals: Vec<Actual>) Res<(), AllocError> {
    param_of_var(c, cand, tb.name).match({
        None    => Ok(()),
        Ok(i)   => bound_at(c, tb, actuals, i),
    })
}

// The first parameter written as the bare type parameter. A nested one
// — `Vec<T>` — would need unification, and inferring a bound from a
// position the language has not settled is inventing a reason.
param_of_var = (c: Checker, cand: Cand, name: str) Res<usize> {
    Range(0, cand.params.len).find((i) {
        var_named(c, ty_at(cand.params, i), name, cand.owner)
    })
}

var_named = (c: Checker, id: TyId, name: str, owner: str) bool {
    c.types.at(id).match({
        Var(v) => v.name.eq(name) && v.owner.eq(owner),
        _      => false,
    })
}

bound_at = (c :: Checker, tb: TBound, actuals: Vec<Actual>, i: usize)
           Res<(), AllocError> {
    actuals.get(i).match({
        None    => Ok(()),
        Ok(a)   => check_actual_bound(c, tb, a),
    })
}

check_actual_bound = (c :: Checker, tb: TBound, a: Actual)
                     Res<(), AllocError> {
    unbounded(c, a.ty).match({
        true  => Ok(()),
        false => prove_bound(c, tb, a),
    })
}

// Poison, a hole and another type parameter carry no answer, and
// "never invent a diagnostic out of missing information".
unbounded = (c: Checker, ty: TyId) bool {
    opaque(c, ty) || is_tvar(c, ty)
}

prove_bound = (c :: Checker, tb: TBound, a: Actual) Res<(), AllocError> {
    satisfies_bound(c, a.ty, tb.bound).try().match({
        true  => Ok(()),
        false => bound_not_satisfied(c, tb, a),
    })
}

bound_not_satisfied = (c :: Checker, tb: TBound, a: Actual)
                      Res<(), AllocError> {
    c.report(a.span.file, a.span,
             SemaFault.BoundNotSatisfied(TypeFault(
                 name: tb.name, expected: tb.bound, found: a.ty)))
}
