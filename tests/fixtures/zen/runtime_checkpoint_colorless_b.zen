mem = std.mem.heap
rt = std.concurrent.runtime
{ Coro, spawn, destroy } = std.concurrent.coroutine
{ expect } = std.core.result
{ run } = std.concurrent.sched
{ println } = std.text.fmt
work = () void {
    heap = mem.gpa()
    hp = heap.addr()
    a = rt.coro(hp, 1024)
    println(1)
    a.addr().checkpoint()
    println(3)
    a.addr().free(hp)
}
main = () i32 {
    heap = mem.gpa()
    hp = heap.addr()
    arena = rt.sync(hp, 131072)
    co = arena.addr().spawn(work).expect("sync-arena coro spawn")
    co.resume()
    println(2)
    arena.addr().run([co]).expect("scheduler run")
    arena.addr().destroy(co)
    arena.addr().free(hp)
    0
}
