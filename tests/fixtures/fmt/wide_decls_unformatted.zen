{ len, is_empty, view, dup_bytes, find, contains, starts_with, ends_with, substr, trim_view, ltrim_view, rtrim_view, trim_prefix, split, words, to_lower, to_upper, repeat, join, replace, pad_left, pad_right, parse_int } = std.text.str
compute_all_the_things = (first_operand: i64, second_operand: i64, third_operand: i64, fourth_operand: i64, fifth_operand: i64) i64 { first_operand + second_operand + third_operand + fourth_operand + fifth_operand }
short_stays = (x: i64, y: i64) i64 { x + y }
sum_varargs_with_a_rather_long_name = (label_argument: string_view, another_label_here: string_view, rest: ...i64) i64 { rest.len }
Wide: {
    seed_value: i64,
    combine_with_everything = (self: Wide, first_multiplier: i64, second_multiplier: i64, third_multiplier: i64) i64 { self.seed_value * first_multiplier * second_multiplier * third_multiplier }
}
main = () i32 { 0 }
