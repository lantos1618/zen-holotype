// rt M2 (docs/rt-scoped-runtime.md §4): the COMMON case — a pointer-free message is a `value`,
// sendable with ZERO ceremony and NO wrapper. `Pk` is a plain struct of scalars; the send carries it
// by value; the receiver reads `m.s` as a plain `i64` (never a `.get()` / `Shared<i64>`). Exit = the
// value the actor received (41), proving the payload crossed the boundary as its normal type.
{ Result, IoError, expect } = std.core.result
actor = std.concurrent.actor
halloc = std.mem.heap
Pk*: {
    s: i64,
}
Msg*: Say(Pk)
Room*: {
    n: i32,
}
Room.impl(actor.Receiver, {
    receive = (room: MutPtr<Room>, ctx: actor.Context<Msg>) void {
        ctx.msg.match ({
            .Say(m) => {
                room.n = to_i32(m.s)
            },
        })
    }
})
main = () i32 {
    alloc := halloc.gpa()
    r: Result<actor.ActorHandle<Msg, Room>, IoError> := actor.spawn(alloc.addr(), 4, Room(n: 0))
    h := r.expect("spawn")
    h.send(.Say(Pk(s: 41)))
    h.run()
    got := h.actor().n
    h.free(alloc.addr())
    got
}
