Noisy = {
    env: Env,
    id: i64,
}

Noisy.impl(Drop, {
    drop = (self :: @Self) () { println("drop {}", self.id) }
})

main = (env: Env) Res<i32, AllocError> {
    a ::= env.mem.alloc();
    v ::= a.Vec<Noisy>();

    one   = Noisy(env: env, id: 1);
    two   = Noisy(env: env, id: 2);
    three = Noisy(env: env, id: 3);
    v.add(consume one).try();
    v.add(consume two).try();
    v.add(consume three).try();
    storage = v.ptr();
    v.clear();
    println("cleared {}", v.len);
    println("retained {}", storage.same(v.ptr()));

    four = Noisy(env: env, id: 4);
    v.add(consume four).try();
    println("refilled {}", v.len);
    v.clear();
    println("final {}", v.len);
    Ok(0)
}
