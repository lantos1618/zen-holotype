// C keyword collisions, part 3 of 3: C23, plus the standard-header MACROS
// that behave like keywords in every C version since C99.
//
// the macros are the worse half. a keyword collision is a syntax error the
// C compiler points at; a macro collision is a TEXTUAL SUBSTITUTION that
// happens before the compiler sees the token, so `bool` becomes `_Bool` and
// `noreturn` becomes `_Noreturn` wherever gen_c emitted the user's name —
// including as a struct member, where the resulting error names a line the
// user never wrote. which macros are live depends on which headers gen_c
// includes, so the safe rule is: mangle these whether or not you include
// <stdbool.h>, <stdalign.h>, <stdnoreturn.h>, <complex.h> and <threads.h>.
//
// NOT TESTED HERE, and deliberately: `true` and `false` are C23 keywords
// (and C99 <stdbool.h> macros) that must be mangled, but they cannot appear
// in this file because they are Zen's own bool literals — `true => ..` is a
// match pattern. They are unrepresentable as Zen identifiers, so the
// mangler's handling of them is unobservable from the corpus. Listed here
// so the gap is on the record rather than looking like an oversight.
//
// `bool` IS tested, as a local binding shadowing the prelude type. Whether
// a local may shadow a prelude type name is unspecified in DESIGN.md; if it
// may not, this file needs a note, not a deleted line — `bool` still has to
// be mangled wherever a user CAN write it.

main = (env: Env) Res<i32, AllocError> {
    alignas = 1;
    alignof = 2;
    bool = 3;
    complex = 4;
    constexpr = 5;
    imaginary = 6;
    noreturn = 7;
    nullptr = 8;
    static_assert = 9;
    thread_local = 10;
    typeof = 11;
    typeof_unqual = 12;
    _BitInt = 13;
    _Decimal32 = 14;
    _Decimal64 = 15;
    _Decimal128 = 16;

    sum ::= 0;
    sum = sum + alignas;
    sum = sum + alignof;
    sum = sum + bool;
    sum = sum + complex;
    sum = sum + constexpr;
    sum = sum + imaginary;
    sum = sum + noreturn;
    sum = sum + nullptr;
    sum = sum + static_assert;
    sum = sum + thread_local;
    sum = sum + typeof;
    sum = sum + typeof_unqual;
    sum = sum + _BitInt;
    sum = sum + _Decimal32;
    sum = sum + _Decimal64;
    sum = sum + _Decimal128;

    println("c23 {}", sum);
    Ok(0);
}
