{ Result, IoError, err } = std.core.result
g = (ok: i32) Result<i32, IoError> { (ok == 1).then({ .Ok(5) }, { .Err(.NotFound) }) }
f = (sel: i32, ok: i32) Result<i32, IoError> {
    v := (sel == 1).match ({
        true  => g(ok).match ({
            .Ok(x)  => x + 10,
            .Err(e) => {
                return err(e)
            },
        }),
        false => 100,
    })
    .Ok(v + 1)
}
main = () i32 {
    a := f(1, 1).match ({
        .Ok(v)  => v,
        .Err(e) => 0,
    })    // 16
    b := f(1, 0).match ({
        .Ok(v)  => 0,
        .Err(e) => 1,
    })    // 1
    c := f(0, 0).match ({
        .Ok(v)  => v,
        .Err(e) => 0,
    })    // 101
    a + b + c
}    // 118
