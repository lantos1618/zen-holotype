// A CORRECT exhaustive match over the same enum still compiles and still
// answers per-variant. The refusal of an undeclared variant arm must not
// be bought by breaking ordinary binders or by loosening exhaustiveness:
// every declared case covered, no `_`, three calls each naming a
// different variant.
//
// `Blue` is called LAST on purpose. A backend that fell into the first
// arm regardless of the tag would still print "red" twice and only this
// line would catch it.

Colour = Red | Green | Blue

name = (c: Colour) str {
    c.match({
        Red   => "red",
        Green => "green",
        Blue  => "blue",
    })
}

main = (env: Env) Res<i32, AllocError> {
    println("{}", name(Colour.Green));
    println("{}", name(Colour.Red));
    println("{}", name(Colour.Blue));
    Ok(0);
}
