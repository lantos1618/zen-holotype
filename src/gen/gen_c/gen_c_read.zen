// src/gen/gen_c/gen_c_read.zen
// WHAT A DOT READS.
// `gen_c_member.zen` owns `x.f(a)`; this owns `x.f`, and they are not
// the same question. One node, `Access`, and three readings of it that
// DESIGN.md separates by what the base NAMES:
//   Shape.Unit    a NULLARY VARIANT: the base names an enum, and the
//                 variant IS a value of it — the tag and no payload
//   usize.BITS    a CONSTANT ON A TYPE: the base names a declaration,
//                 and the member is a value OF that declaration, read
//                 out of nothing. "A prelude declaration of a
//                 primitive's name IS that primitive", so `usize`'s
//                 members are `std.core.num.usize`'s
//   p.x           a FIELD: the base is a value, and this is the only
//                 one of the three that reads a receiver
// The order is the order the questions can be answered in, and each one
// is asked of the DECLARATION rather than of the spelling.
// `str` IS THE ONE TYPE WHOSE C REPRESENTATION IS THE RUNTIME FLOOR'S,
// which is why the field rule is here rather than in the mangler.

ExprId, Decl, Struct, Member = std.ast
Const, Access, Impl = std.ast
AllocError = std.mem
Vec = std.collections
str, String = std.text
DeclId, ImplId = sema.sema_id
TyId, TyNamed = sema.sema_ty
Def, decl_at = sema.sema_def
Ctx = sema.sema_check
has_var* = sema.sema_inst
alias_enum = sema.sema_denote
impl_bound_type, bound_member_type = sema.sema_supply
sym_member, sym_variant = gen.gen_name
CBackend = gen.gen_c.gen_c_state
unsupported = gen.gen_c.gen_c_report
constructed, recv_inst = gen.gen_c.gen_c_mono
enter_struct_tparams, leave_tparams = gen.gen_c.gen_c_mono
ctype, struct_decl, has_storage = gen.gen_c.gen_c_type
write_qname = gen.gen_c.gen_c_layout
bind_text = gen.gen_c.gen_c_range
impl_field = gen.gen_c.gen_c_impl
expr, ty_of = gen.gen_c.gen_c_expr
field_of = gen.gen_c.gen_c_type
lower_const_value = gen.gen_c.gen_c_const

// access and calls

// `p.x` on a struct, and `Shape.Unit` on an enum: one node, and the
// difference is whether the base is a value or a declaration — "that
// access form already exists, so this adds a spelling, not a concept".
lower_access* = (
    be   :: CBackend,
    id   : ExprId,
    a    : Access,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    be.base_decl(a.base, ctx).match({
        Ok(ty) => be.write_variant_value(id, ty, want, a.name.text, out),
        None   => be.lower_type_or_field(id, a, ctx, want, out),
    })
}

// `usize.BITS` — A CONSTANT DECLARED ON A TYPE, the header's second
// reading: a value of the declaration and never of a receiver, since
// there is nothing to read it out of. Read exactly as a module-level
// constant is.
lower_type_or_field = (
    be   :: CBackend,
    id   : ExprId,
    a    : Access,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    be.type_const(a, ctx).try().match({
        None     => be.lower_recv_const_or_field(id, a, ctx, want, out),
        Ok(pair) => be.lower_const_value(id, pair.k, pair.d, want, out),
    })
}

// `j.WIDTH`, WHERE `WIDTH` IS A CONSTANT AND `j` IS A VALUE.
// A constant is one value per type and there is nothing in a receiver
// to read it out of — so which side of the dot the TYPE arrives on
// cannot change the answer. `Limits.WIDTH` folded and `j.WIDTH` fell
// through to the field path, which emitted `.zg_m5WIDTH` on a struct
// that declares no such member: the diagnostic came from `cc` and named
// a symbol the author never wrote. The bootstrapper already folded it,
// so this was also the two implementations disagreeing.
// ASKED AFTER `type_const` AND BEFORE THE FIELD PATH. A name that is
// both is not possible — grammar R4 makes `NAME: T = value` a constant
// and `name :: T = value` a field, one member each way — and a constant
// is the reading that has no storage to fall back on.
lower_recv_const_or_field = (
    be   :: CBackend,
    id   : ExprId,
    a    : Access,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    be.recv_const(a, ctx).try().match({
        None     => be.write_field_access(id, a, ctx, out),
        Ok(pair) => be.lower_const_value(id, pair.k, pair.d, want, out),
    })
}

// The constant a RECEIVER'S type declares under this name. The
// receiver's type is the frame's answer, and its declaration is read in
// the module that wrote it — a member's value names what that module
// can see and never what the reader can.
recv_const = (be :: CBackend, a: Access, ctx: Ctx)
             Res<Res<TypeConst>, AllocError> {
    unknown = be.check.types.unknown().try();
    rty     = be.ty_of(a.base, ctx, unknown).try();
    be.check.types.at(rty).match({
        Named(n) => be.named_recv_const(n, a.name.text),
        _        => Ok(None),
    })
}

named_recv_const = (be :: CBackend, n: TyNamed, name: str)
                   Res<Res<TypeConst>, AllocError> {
    found ::= be.alloc.Vec<Def>();
    be.check.world.own_defs(n.decl.module.to_usize(), n.name, found).try();
    hits ::= be.alloc.Vec<TypeConst>();
    found.loop((h, d) {
        same_decl(d, n).then(() {
            be.collect_type_const(d, name, hits).try();
        });
    });
    Ok(hits.get(0));
}

// The def this type WAS interned from, and not merely one of that name:
// a module may bind two declarations to one name and only one of them
// is the receiver's.
same_decl = (d: Def, n: TyNamed) bool {
    d.id.module == n.decl.module && d.id.decl == n.decl.decl
}

// A constant member, and the declaration it was found on — the second
// half is what says which module its value is read in.
TypeConst* = {
    k: Const,
    d: Def,
}

type_const* = (be :: CBackend, a: Access, ctx: Ctx)
             Res<Res<TypeConst>, AllocError> {
    be.tree.expr_at(a.base).kind.match({
        Name(n) => be.named_type_const(n.text, a.name.text, ctx),
        _       => Ok(None),
    })
}

named_type_const = (be :: CBackend, base: str, name: str, ctx: Ctx)
                   Res<Res<TypeConst>, AllocError> {
    be.slot_of(base).match({
        Ok(_) => Ok(None),
        None  => be.decl_const(base, name, ctx),
    })
}

decl_const = (be :: CBackend, base: str, name: str, ctx: Ctx)
             Res<Res<TypeConst>, AllocError> {
    found ::= be.alloc.Vec<Def>();
    be.check.world.defs_of(ctx.module, base, found).try();
    hits ::= be.alloc.Vec<TypeConst>();
    found.loop((h, d) { be.collect_type_const(d, name, hits).try() });
    Ok(hits.get(0));
}

collect_type_const = (
    be   :: CBackend,
    d    : Def,
    name : str,
    out  :: Vec<TypeConst>
) Res<(), AllocError> {
    decl_at(be.tree, d.id).match({
        None  => Ok(()),
        Ok(x) => be.collect_decl_const(x, d, name, out),
    })
}

collect_decl_const = (
    be   :: CBackend,
    x    : Decl,
    d    : Def,
    name : str,
    out  :: Vec<TypeConst>
) Res<(), AllocError> {
    x.kind.match({
        Struct(s) => collect_struct_const(s, d, name, out),
        _         => Ok(()),
    })
}

collect_struct_const = (
    s    : Struct,
    d    : Def,
    name : str,
    out  :: Vec<TypeConst>
) Res<(), AllocError> {
    s.members.loop((h, m) { keep_const(m, d, name, out).try() });
    Ok(());
}

keep_const = (m: Member, d: Def, name: str, out :: Vec<TypeConst>)
             Res<(), AllocError> {
    m.kind.match({
        Const(k) => keep_named_const(k, d, name, out),
        _        => Ok(()),
    })
}

keep_named_const = (k: Const, d: Def, name: str, out :: Vec<TypeConst>)
                   Res<(), AllocError> {
    k.name.text.eq(name).match({
        false => Ok(()),
        true  => out.add(TypeConst(k: k, d: d)),
    })
}

// The enum a base names, when the base is a bare name that resolves to
// an enum declaration rather than to a local.
base_decl* = (be :: CBackend, base: ExprId, ctx: Ctx) Res<TyId> {
    be.tree.expr_at(base).kind.match({
        Name(n) => be.enum_named(n.text, ctx),
        _       => None,
    })
}

enum_named = (be :: CBackend, text: str, ctx: Ctx) Res<TyId> {
    be.slot_of(text).match({
        Ok(_) => None,
        None  => be.enum_def_named(text, ctx),
    })
}

enum_def_named = (be :: CBackend, text: str, ctx: Ctx) Res<TyId> {
    found ::= be.alloc.Vec<Def>();
    be.check.world.defs_of(ctx.module, text, found).match({
        Err(_) => None,
        Ok(_)  => be.first_enum(found),
    })
}

first_enum = (be :: CBackend, found: Vec<Def>) Res<TyId> {
    found.get(0).match({
        None  => None,
        Ok(d) => be.enum_type_of(d),
    })
}

// AN ALIAS IS THE TYPE, so `Alias.Circle` is `Shape.Circle` and the base
// names Shape's enum. Which enum is sema's answer and not a second walk
// from here — `sema_denote.alias_enum`.
enum_type_of = (be :: CBackend, d: Def) Res<TyId> {
    d.kind.match({
        EnumDef  => intern_named(be, d),
        AliasDef => be.check.alias_enum(d),
        _        => None,
    })
}

intern_named* = (be :: CBackend, d: Def) Res<TyId> {
    be.constructed(d).match({
        Err(_) => None,
        Ok(id) => Ok(id),
    })
}

// A nullary variant is a value of its enum: the tag, and no payload.
// A variant WITH a payload written as a bare access is a value that
// has not been constructed, and sema is the one that says so.
// THE LITERAL IS SPELLED AT WHAT THE CONTEXT EXPECTED, falling back to
// what sema answered for the ACCESS node and then to the declaration's
// own reading. `none: Opt<i32> = Opt.None;` declares its local at the
// annotation — `gen_c_stmt.binding_type`, the destination's type wins —
// but this path spelled the tag literal from the DECLARATION alone
// (`constructed`: the enum at its own free parameters), so a generic
// enum minted `Opt<Var>` (`_q` in the mangled name) beside the
// `Opt<i32>` slot the assignment stores into: C that names two structs
// for one value, refused by cc. The three readings spell the same layout
// whenever they can differ only in name; the expected type is asked
// FIRST because it is what the value must land as.
write_variant_value* = (
    be      :: CBackend,
    id      : ExprId,
    ty      : TyId,
    want    : TyId,
    variant : str,
    out     :: String
) Res<(), AllocError> {
    lit = be.nullary_ty(ty, want);
    qname ::= be.alloc.String().try();
    be.enum_qname(lit, qname).try();
    cty ::= be.alloc.String().try();
    be.ctype(lit, cty).try();
    tag ::= be.alloc.String().try();
    tag.sym_variant(qname.view(), variant).try();
    out.fmt("({}){ .zg_tag = {} }", cty.view(), tag.view())
}

// WHICH ENUM THE NULLARY LITERAL NAMES: the context's expectation when
// it settled to an application of the same declaration (an annotation,
// or the position a return hands down), else what sema answered for this
// very node when that answer has a C spelling, else the declaration
// reading the caller resolved. The three spell the same layout whenever
// they can differ only in name; the expected type is asked FIRST because
// it is what the value must land as. An expectation naming a DIFFERENT
// declaration is not this access's type — the mismatch, if it is one,
// belongs to assignability.
// A BARE HEAD SETTLES AT THE POSITION THAT WROTE ITS ARGUMENTS: sema's
// `nullary_settles` accepted `none: Opt<i32> = Opt.None` by the same
// question, and the C has to answer with the struct the slot carries —
// `zu_t2_5..OptI1_b3i32`, not the bare `zu_t2_5..Opt` beside it (issue
// 738). Same declaration both sides is checked first; a different one
// stays assignability's business.
nullary_ty* = (be :: CBackend, ty: TyId, want: TyId) TyId {
    be.expected_enum(ty, want).match({
        None  => be.check.nullary_settles(ty, want).match({
            true  => want,
            false => ty,
        }),
        Ok(t) => t,
    })
}

expected_enum = (be :: CBackend, ty: TyId, want: TyId) Res<TyId> {
    same = be.check.same_type(ty, want);
    (same && be.check.has_var(want) == false).match({
        true  => Ok(want),
        false => None,
    })
}

enum_qname = (be :: CBackend, ty: TyId, out :: String) Res<(), AllocError> {
    be.check.types.at(ty).match({
        Named(n) => be.write_qname(out, n),
        _        => Ok(()),
    })
}

// a field the type declares, and a field an IMPL supplies
// "You satisfy requirements, you never impl storage." A field the
// DECLARATION writes is storage and is read out of the receiver's
// bytes. A field an IMPL supplies is COMPUTED: there is nothing in the
// receiver to read, so what is emitted is the impl's own expression
// with `self` bound to the receiver — re-evaluated on every read, which
// is the whole of "it can never go stale".
// THE TYPE'S OWN MEMBER WINS OUTRIGHT, the order `sema_supply.zen`
// states and for its reason: layout is fixed at declaration and cannot
// depend on which impls are linked.
// TWO IMPLS SUPPLYING ONE NAME IS SEMA'S ANSWER READ BACK, NOT GUESSED.
// "The bound in scope selects which is in view — never file order", and
// nothing pushes bounds during lowering: monomorphisation has already
// replaced `T` with the concrete type, so the bound that would select
// is gone by the time this runs. Picking the first would compile, and
// would read the other impl's field — valid C with the wrong value and
// no diagnostic, which is why a bound stack HERE would be a second,
// worse copy of a rule `sema_member.zen` already applies. It records
// what it chose under the access's `ExprId`; this asks.

// WHAT A FIELD READ EVALUATES TO, when the frame cannot say.
// `gen_c_expr.zen` walks a dot chain through the FRAME — the frame is
// the authority on a binding's type — and that walk stops at the first
// node that is not a name or a field. `p.read(0).value` has a CALL
// under the dot, so the walk gives up one node short, and sema has
// nothing either: `alloc.create<T>()` is a bodyless generic member, so
// the whole chain hanging off `p` is unknown to it.
// The answer is the same two facts `write_field_access` below already
// reads — the receiver's type, and the field on its declaration — asked
// as a question instead of written as C. Without it the chain types as
// the expectation, and an expectation is exactly what a `println`
// argument does not have: `p.read(0).next` came back unknown and the
// `read` on it had no receiver to resolve against.
access_field_type* = (be :: CBackend, a: Access, ctx: Ctx, want: TyId)
                     Res<TyId, AllocError> {
    unknown = be.check.types.unknown().try();
    rty     = be.ty_of(a.base, ctx, unknown).try();
    be.field_of(rty, a.name.text).try().match({
        Ok(t) => Ok(t),
        None  => Ok(want),
    })
}

write_field_access = (
    be  :: CBackend,
    id  : ExprId,
    a   : Access,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    rty     = be.ty_of(a.base, ctx, unknown).try();
    found ::= be.alloc.Vec<Computed>();
    be.supplied_fields(rty, a.name.text, found).try();
    found.len.match({
        0 => be.write_stored_field(a, rty, ctx, out),
        1 => be.write_computed_field(a, rty, found, ctx, out),
        _ => be.write_selected_field(id, a, rty, found, ctx, out),
    })
}

// WHICHEVER IMPL SEMA'S BOUND NAMED. A miss leaves `kept` empty and the
// refusal stands: an answer nothing recorded is not an answer, and the
// one thing this must never do is pick.
write_selected_field = (
    be    :: CBackend,
    id    : ExprId,
    a     : Access,
    rty   : TyId,
    found : Vec<Computed>,
    ctx   : Ctx,
    out   :: String
)
                       Res<(), AllocError> {
    kept ::= be.alloc.Vec<Computed>();
    be.check.supply_memo.get(id).match({
        None  => Ok(()),
        Ok(b) => keep_supplied_by(found, b, kept),
    }).try();
    kept.len.match({
        1 => be.write_computed_field(a, rty, kept, ctx, out),
        _ => be.unsupported(id, "a computed field two impls supply", out),
    })
}

keep_supplied_by = (found: Vec<Computed>, b: TyId, kept :: Vec<Computed>)
                   Res<(), AllocError> {
    found.loop((h, cf) { keep_if_bound(cf, b, kept).try() });
    Ok(());
}

// A named helper rather than a `.then` inside the loop body: a loop
// binding read inside a nested closure does not resolve.
keep_if_bound = (cf: Computed, b: TyId, kept :: Vec<Computed>)
                Res<(), AllocError> {
    cf.bound.eq(b).match({ true => kept.add(cf), false => Ok(()) })
}

write_stored_field = (
    be  :: CBackend,
    a   : Access,
    rty : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    fty     = be.field_of(rty, a.name.text).try().match({
        Ok(t) => t,
        None  => unknown,
    });
    be.has_storage(fty).match({
        false => {
            out.add_bytes("(").try();
            expr(be, a.base, ctx, unknown, out).try();
            out.add_bytes(", 0)")
        },
        true  => {
            expr(be, a.base, ctx, unknown, out).try();
            out.add_bytes(".").try();
            field_name(be, rty, a.name.text, out)
        },
    })
}

// What an impl wrote for a field, and the four things reading it back
// needs: the TARGET's declaration, whose type parameters the expression
// names; the module it was written in; the type the BOUND declared
// — "`width: self.radius * 2.0` is an f64 because `Rect` said f64" —
// and the bound itself, which is what sema's answer is matched against
// when two impls supply the name.
Computed = {
    value: ExprId,
    decl: DeclId,
    mi: usize,
    ty: TyId,
    bound: TyId,
}

supplied_fields = (
    be   :: CBackend,
    rty  : TyId,
    name : str,
    out  :: Vec<Computed>
) Res<(), AllocError> {
    be.check.types.at(rty).match({
        Named(n) => be.named_supplied(n, rty, name, out),
        _        => Ok(()),
    })
}

named_supplied = (
    be   :: CBackend,
    n    : TyNamed,
    rty  : TyId,
    name : str,
    out  :: Vec<Computed>
) Res<(), AllocError> {
    be.declares_own(n.decl, name).match({
        true  => Ok(()),
        false => be.impls_supplying(n, rty, name, out),
    })
}

declares_own = (be: CBackend, id: DeclId, name: str) bool {
    struct_decl(be, id).match({
        Ok(s) => struct_has_member(s, name),
        None  => false,
    })
}

struct_has_member = (s: Struct, name: str) bool {
    got ::= false;
    s.members.loop((h, m) { m.named(name).then(() { got = true; }) });
    got
}

// "An impl lives with the type, not with the trait", so the search is
// over the impls declared in the TARGET's own module.
impls_supplying = (
    be   :: CBackend,
    n    : TyNamed,
    rty  : TyId,
    name : str,
    out  :: Vec<Computed>
) Res<(), AllocError> {
    ids ::= be.alloc.Vec<ImplId>();
    be.check.world.impls_named(be.tree, n.name, ids).try();
    ids.loop((h, i) { be.local_supplied(n, rty, i, name, out).try() });
    Ok(());
}

local_supplied = (
    be   :: CBackend,
    n    : TyNamed,
    rty  : TyId,
    i    : ImplId,
    name : str,
    out  :: Vec<Computed>
) Res<(), AllocError> {
    (n.decl.module == i.decl.module).match({
        false => Ok(()),
        true  => be.supplied_in_impl(n, rty, i, name, out),
    })
}

supplied_in_impl = (
    be   :: CBackend,
    n    : TyNamed,
    rty  : TyId,
    i    : ImplId,
    name : str,
    out  :: Vec<Computed>
) Res<(), AllocError> {
    be.check.world.impl_at(be.tree, i).match({
        Ok(im) => be.impl_supplied_value(n, rty, im, name, out),
        None   => Ok(()),
    })
}

impl_supplied_value = (
    be   :: CBackend,
    n    : TyNamed,
    rty  : TyId,
    im   : Impl,
    name : str,
    out  :: Vec<Computed>
)
                      Res<(), AllocError> {
    be.impl_field(im, name).try().match({
        None  => Ok(()),
        Ok(v) => be.add_computed(n, rty, im, name, v, out),
    })
}

add_computed = (
    be   :: CBackend,
    n    : TyNamed,
    rty  : TyId,
    im   : Impl,
    name : str,
    v    : ExprId,
    out  :: Vec<Computed>
) Res<(), AllocError> {
    mi    = n.decl.module.to_usize();
    bound = be.check.impl_bound_type(im, mi).try();
    ty    = be.check.bound_member_type(bound, name, rty).try();
    out.add(Computed(value: v, decl: n.decl, mi: mi, ty: ty, bound: bound))
}

// The receiver is lowered FIRST and into a binding of its own: the
// impl's expression names it once per mention, and `self` inside it is
// the impl's `self` and not an enclosing method's. Bound around the
// impl's own expression and nothing wider, which is the rule
// `gen_c_range.zen` pays for in the other direction.
write_computed_field = (
    be    :: CBackend,
    a     : Access,
    rty   : TyId,
    found : Vec<Computed>,
    ctx   : Ctx,
    out   :: String
)
                       Res<(), AllocError> {
    found.get(0).match({
        None   => Ok(()),
        Ok(cf) => be.write_supplied_value(a, rty, cf, ctx, out),
    })
}

write_supplied_value = (
    be  :: CBackend,
    a   : Access,
    rty : TyId,
    cf  : Computed,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    recv ::= be.alloc.String().try();
    expr(be, a.base, ctx, unknown, recv).try();
    ictx = Ctx(
        module: cf.mi,
        ret: unknown,
        has_ret: false,
        self_ty: rty,
        has_self: true
    );
    inst = be.recv_inst(rty).try();
    held = be.inst;
    be.enter_inst(inst);
    mark  = be.enter_struct_tparams(cf.decl).try();
    cmark = be.check.mark();
    lmark = be.mark();
    be.bind_text("self", rty, recv.view()).try();
    expr(be, cf.value, ictx, cf.ty, out).try();
    be.release(lmark).try();
    be.check.release(cmark).try();
    be.leave_tparams(mark).try();
    be.enter_inst(held);
    Ok(());
}

// `str` IS THE ONE TYPE WHOSE C REPRESENTATION IS THE RUNTIME FLOOR'S
// rather than its declaration's. `gen_c_runtime.emit_floor` writes
// `struct zg_str { unsigned char *data; size_t len; }` and every string
// literal, every `zg_print_str` and every C caller already agrees on
// those two names — so a read of `text_str.zen`'s `data` or `len` is
// spelled the floor's way and not the mangler's. Everything else in the
// language is mangled, which is what keeps two modules' `len` two
// members.
field_name = (be :: CBackend, rty: TyId, name: str, out :: String)
             Res<(), AllocError> {
    be.is_str(rty).match({
        true  => out.add_bytes(name),
        false => out.sym_member(name),
    })
}

is_str* = (be :: CBackend, rty: TyId) bool {
    be.check.types.at(rty).match({
        Prim(p) => p.name.eq("str"),
        _       => false,
    })
}
