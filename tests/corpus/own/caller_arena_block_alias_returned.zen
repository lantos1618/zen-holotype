word = (alloc: Alloc, letters: str) Res<str, AllocError> {
    buf ::= alloc.String().try();
    buf.add(letters).try();
    output = (letters.len > 0).match({
        true  => { alias = buf.view(); alias },
        false => "safe",
    });
    Ok(output)
}
main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    text = word(alloc, "ab").try();
    println("{}", text);
    Ok(0)
}
