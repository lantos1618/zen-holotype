// CONSTRUCTION BINDS ARGUMENTS TO FIELDS BY NAME, NOT BY POSITION.
//
// Every field below is i64 and has a non-zero default, so nothing in the
// type system or the C compiler can catch a backend that emits the
// initialiser list straight from the ARGUMENT SEQUENCE: a positional
// emission links, runs, and prints the arguments permuted -- numbers that
// look exactly as plausible as the right ones. `Mut(flag: false,
// tag: "given")` in codegen/field_defaults.zen already argues out of
// declaration order, but its fields are differently typed; these are not,
// which is the only case a positional bug survives.
//
// The partial constructions are the sharper half: `Slots(c: 30, a: 10)`
// omits the field BETWEEN the two supplied ones, so an emitter that walks
// supplied arguments against declaration slots one-to-one fills a and b
// and drops 30 -- the failure field_defaults.zen's `Mixed` hunts, seen
// here with all-same types so it cannot hide behind a cast.

Slots = {
    a :: i64 = 1,
    b :: i64 = 2,
    c :: i64 = 3,
}

main = (env: Env) Res<i32, AllocError> {
    none = Slots();
    println("none {} {} {}", none.a, none.b, none.c);

    hole = Slots(c: 30, a: 10);
    println("hole {} {} {}", hole.a, hole.b, hole.c);

    mid = Slots(b: 200);
    println("mid {} {} {}", mid.a, mid.b, mid.c);

    rev = Slots(c: 300, b: 200, a: 100);
    println("rev {} {} {}", rev.a, rev.b, rev.c);

    Ok(0);
}
