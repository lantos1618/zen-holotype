// C libraries as build VALUES: c_library declares libm as a typed module; use() registers the
// whole edge — link flag, ffi grant, and the generated `cmath` module — in one call.
{ Build, CLib, c_library, c_fn, c_opaque } = std.build
build = (b: MutPtr<Build>) void {
    exe = b
        .exe("clib-demo")
        .root("src")
        .main("main.zen")
        .out("clib-bin")
    m = c_library(b, CLib(
        lib: "m",
        name: "cmath",
        decls: [c_fn("cbrt", "(x: f64) f64"), c_fn("hypot", "(x: f64, y: f64) f64"), c_opaque("FILE")],
    ))
    exe.use(m)
    b.install(exe)
}
