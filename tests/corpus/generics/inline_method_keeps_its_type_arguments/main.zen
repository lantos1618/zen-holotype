Apply = {
    run = <T>(self: @Self, value: T, body: (value: T) T) T {
        body(value)
    }
}

main = () {
    apply        = Apply();
    value: usize = 40;
    inferred     = apply.run(value, (number) { number + 2 });
    explicit     = apply.run<usize>(40, (number) { number + 3 });
    annotated    = apply.run(40, (number: usize) { number + 4 });
    println("{} {} {}", inferred, explicit, annotated);
}
