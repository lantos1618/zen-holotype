// every predicate in std.core.byte answers about the byte ALONE.
// str is bytes, so a multi-byte character's continuation byte is not
// a letter -- it is half of one, and is_alpha says so rather than
// pretending the question was about a character.
main = (env: Env) Res<i32, ArgError> {
    println("{}", '7'.is_digit());
    println("{}", 'q'.is_alpha());
    println("{}", ' '.is_space());
    println("{}", '_'.is_ident_start());
    '7'.digit_value().match({ Ok(v) => println("{}", v), None => println("none") });
    'f'.hex_value().match({ Ok(v) => println("{}", v), None => println("none") });
    'C'.hex_value().match({ Ok(v) => println("{}", v), None => println("none") });
    println("{}", 'Q'.to_lower());
    println("{}", 'q'.to_upper());
    println("{}", hex_digit(11));

    // "héllo" is 6 bytes, and byte 1 is the lead of a two-byte
    // sequence rather than 'e'
    s = "héllo";
    println("{}", s.len);
    println("{}", s.index(1).is_alpha());
    Ok(0);
}
