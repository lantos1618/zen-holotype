word = (env: Env, letters: str) Res<str, AllocError> {
    alloc ::= env.mem.alloc();
    buf   ::= alloc.String().try();
    buf.add(letters).try();
    output = [buf.view()];
    Ok(output[0])
}
main = (env: Env) Res<i32, AllocError> {
    text = word(env, "ab").try();
    println("{}", text);
    Ok(0)
}
