// tests/corpus/env/fs_read_missing_names_not_found.zen
// The file was not there. This is the single most common thing that
// happens to a compiler in the field, so it is a Res with a name on
// it and not a trap: the caller says WHICH path it could not open,
// and carries on to the next candidate.

FsError = std.env

main = (env: Env) Res<i32, FsError> {
    alloc ::= env.mem.alloc();

    env.fs.read(alloc, "no_such_file.zen").match({
        Ok(text)         => println("read {} bytes", text.len()),
        Err(NotFound)    => println("no_such_file.zen: not found"),
        Err(Denied)      => println("denied"),
        Err(IsDir)       => println("is a directory"),
        Err(Exists)      => println("already locked"),
        Err(Failed)      => println("failed"),
        Err(OutOfMemory) => println("out of memory"),
    });

    // and the probe agrees, without opening anything
    println("exists {}", env.fs.exists("no_such_file.zen"));
    Ok(0);
}
