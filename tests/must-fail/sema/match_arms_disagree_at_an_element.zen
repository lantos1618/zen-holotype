// MUST FAIL: two arms of a `.match` disagree, and the match stands as an
// ARRAY ELEMENT. The array's type is WRITTEN, so `i32` is the position's
// word and every element answers to it — `sema_type.fixed_array_type`
// already asks each element whether it fits, and an arm is an element.
//
// The third of the three positions `check_arms` was landed without.
//
// AN ELEMENT HAS NO NAME to blame it on. `fixed_array_type`'s own header
// says it: "an element is the one place a literal meets a type with no
// assignment, parameter, or field name in sight" — which is exactly why
// the wrong value here is the hardest to read back out of the program.
f = (b: bool) i32 {
    xs = [i32, 2](1, b.match({
        true  => 2,
        false => false,
    }));
    xs[1];
}

main = (env: Env) Res<i32, ArgError> {
    println("{}", f(false));
    Ok(0);
}
