// src/std/parse/parse_lookahead.zen
// Side-effect-free lookahead for ambiguous token sequences.
//
// Each query scans to a matching delimiter and inspects the next live
// token. None advances the parser or records diagnostics. Scans use
// `live_at` because formatter trivia remains in the token stream.

TokenKind, is_trivia = std.parse.parse_token
Parser = std.parse.parser
starts_type_kind = std.parse.parse_type

// What a declaration's value turned out to be. Not an AST node — it is
// the answer to one question asked in one place, and naming it is what
// keeps the seven readings of `Name = <thing>` a table rather than a
// nest.
ValueShape* = StructValue
    | EnumValue
    | FnValue
    | PathValue
    | AliasValue
    | ExprValue

// -------------------------------------------------------------------
// the bounded scans
//
// Each answers one question about a delimited run without consuming a
// token and without backtracking. They are the whole of this parser's
// lookahead.
// -------------------------------------------------------------------

// The first index at or after `from` holding a non-trivia token.
live_at* = (p :: Parser, from: usize) usize {
    out ::= p.tokens_len();
    Range(from, p.tokens_len()).loop((h, k) {
        p.token_kind_at(k).is_trivia().match({
            true  => (),
            false => { out = k; h.break(); },
        });
    });
    out;
}

// The kind of that token: the only way this file reads the stream.
live_kind* = (p :: Parser, from: usize) TokenKind {
    p.token_kind_at(p.live_at(from))
}

// A parenthesized group starts a lambda when a block or return type follows.
// Another `(` is treated as a call; declaration values handle unit returns
// separately in `fn_value_after`.
lambda_ahead* = (p :: Parser) bool {
    after = p.live_kind(p.group_end_at(p.at));
    after == TokenKind.BraceOpen || after.ret_start()
}

// `<` and `(` are excluded because comparison and call syntax take priority.
ret_start* = (kind: TokenKind) bool {
    kind.starts_type_kind() && !kind.is_in([TokenKind.Lt, TokenKind.ParenOpen])
}

// At declaration level, a following `(` may begin a written return type.
fn_value_after* = (kind: TokenKind) bool {
    kind.is_in([TokenKind.BraceOpen, TokenKind.ParenOpen]) || kind.ret_start()
}

// A `[` here opens a fixed array type applied to arguments if it holds
// exactly two items — an element type and a length — and a `(`
// follows. Anything else is an array literal.
fixed_array_ahead* = (p :: Parser) bool {
    j = p.group_end_at(p.at);
    p.live_kind(j) == TokenKind.ParenOpen && p.group_items_at(p.at, j) == 2
}

// A `<` here opens type arguments if its matching `>` is followed by
// `(`. Otherwise it is a comparison, which is the commoner reading and
// the one a wrong guess breaks silently.
targs_ahead* = (p :: Parser) bool {
    j = p.angles_end_at(p.at);
    (j > p.at) && p.live_kind(j) == TokenKind.ParenOpen
}

// The index one past the delimiter group the cursor is sitting on.
// The cursor's own token, which every caller has already established
// is an opener, closes the run at depth 0 — so an unclosed group
// returns the length of the stream and every question above answers
// "no" rather than guessing.
group_end_at = (p :: Parser, from: usize) usize {
    depth ::= 0;
    out   ::= p.tokens_len();
    Range(from, p.tokens_len()).loop((h, k) {
        depth = p.token_kind_at(k).delim_step(depth);
        (depth == 0).then(() { out = k + 1; h.break() });
    });
    out;
}

// The same, for `<` and `>`, which are delimiters only here and so
// cannot use the counter above. A `;`, a `{` or a `}` inside the run
// means it was never a type argument list, and the scan gives up by
// returning where it started.
angles_end_at = (p :: Parser, from: usize) usize {
    depth ::= 0;
    out   ::= from;
    Range(from, p.tokens_len()).loop((h, k) {
        kind = p.token_kind_at(k);
        kind.angle_stop().match({
            true  => { out = from; h.break(); },
            false => {
                depth = kind.angle_step(depth);
                (depth == 0).then(() { out = k + 1; h.break() });
            },
        });
    });
    out;
}

// How many top-level items the group ending at `to` holds: one more
// than the commas outside any nested group. An empty group holds none.
group_items_at = (p :: Parser, from: usize, to: usize) usize {
    depth  ::= 0;
    commas ::= 0;
    empty  ::= true;
    Range(from + 1, to - 1).loop((h, k) {
        kind = p.token_kind_at(k);
        (kind == TokenKind.Comma && depth == 0).then(
            () { commas = commas + 1; }
        );
        kind.is_trivia().match({
            true  => (),
            false => { empty = false; },
        });
        depth = kind.delim_step(depth);
    });
    empty.match({
        true  => 0,
        false => commas + 1,
    });
}

// Depth arithmetic, in usize, which cannot go below zero. A closer at
// depth 0 is malformed input and is clamped rather than trapped: these
// scans answer a question about a guess, and a guess must not abort
// the compilation.
delim_step* = (kind: TokenKind, depth: usize) usize {
    kind.match({
        ParenOpen    => depth + 1,
        BracketOpen  => depth + 1,
        BraceOpen    => depth + 1,
        ParenClose   => depth.down(),
        BracketClose => depth.down(),
        BraceClose   => depth.down(),
        _            => depth,
    });
}

angle_step = (kind: TokenKind, depth: usize) usize {
    kind.match({
        Lt => depth + 1,
        Gt => depth.down(),
        _  => depth,
    });
}

// What proves a `<` was a comparison after all. A type argument list
// never contains a statement terminator or a body.
angle_stop = (kind: TokenKind) bool {
    kind.match({
        Semicolon  => true,
        BraceOpen  => true,
        BraceClose => true,
        Eof        => true,
        _          => false,
    });
}

down = (d: usize) usize {
    (d == 0).match({
        true  => 0,
        false => d - 1,
    });
}

// -------------------------------------------------------------------
// the shape of a value
//
// Bounded lookahead, never backtracking: at most a name, one balanced
// group, and the token after it. That is the whole of what R1a needs,
// and it is why a declaration can be classified before it is parsed.
// -------------------------------------------------------------------

value_shape* = (p :: Parser, module_level: bool) ValueShape {
    p.peek().kind.match({
        BraceOpen => ValueShape.StructValue,
        Bar       => ValueShape.EnumValue,
        ParenOpen => p.paren_shape(),
        Lt        => p.angle_shape(),
        Ident     => p.ident_shape(module_level),
        _         => ValueShape.ExprValue,
    });
}

// `(a: i32) i32 { .. }` against `(a + b)`. A function is what has a
// block or a return type after its `)`; anything else is an ordinary
// parenthesized expression.
paren_shape = (p :: Parser) ValueShape {
    p.live_kind(p.group_end_at(p.at)).fn_value_after().match({
        true  => ValueShape.FnValue,
        false => ValueShape.ExprValue,
    });
}

// `<T>(x: T) T` — the only value that begins with `<`.
angle_shape = (p :: Parser) ValueShape {
    j = p.angles_end_at(p.at);
    (j > p.at && p.live_kind(j) == TokenKind.ParenOpen).match({
        true  => ValueShape.FnValue,
        false => ValueShape.ExprValue,
    });
}

// A name is the hard one, and the leading bar is why it is not
// impossible. `A(T) | B` is an enum; `a.b.c` is an import; a bare
// `Name` or `Name<T>` at module level is an alias; anything that keeps
// going is an expression.
ident_shape = (p :: Parser, module_level: bool) ValueShape {
    p.variant_ahead().match({
        true  => ValueShape.EnumValue,
        false => module_level.match({
            true  => p.path_or_alias(),
            false => ValueShape.ExprValue,
        }),
    });
}

// `Circle(Circle) |` or `Circle |` — a name, one optional balanced
// payload, and a bar. The bar closes the fork the moment it appears,
// which is R1's whole claim.
variant_ahead = (p :: Parser) bool {
    j ::= p.live_at(p.at + 1);
    (p.token_kind_at(j) == TokenKind.ParenOpen).match({
        true  => { j = p.live_at(p.group_end_at(j)); },
        false => (),
    });
    p.token_kind_at(j) == TokenKind.Bar;
}

path_or_alias = (p :: Parser) ValueShape {
    j       ::= p.live_at(p.at + 1);
    dotted  ::= false;
    running ::= p.token_kind_at(j) == TokenKind.Dot;
    running.loop((h) {
        dotted  = true;
        j       = p.live_at(p.live_at(j + 1) + 1);
        running = p.token_kind_at(j) == TokenKind.Dot;
    });
    (p.token_kind_at(j) == TokenKind.Lt).match({
        true  => { j = p.live_at(p.angles_end_at(j)); },
        false => (),
    });
    p.closes_value(j).match({
        false => ValueShape.ExprValue,
        true  => dotted.match({
            true  => ValueShape.PathValue,
            false => ValueShape.AliasValue,
        }),
    });
}

// Whether the token at `j` ends the value rather than continuing it. A
// declaration has no terminator, so this is the only thing standing
// between `Alias = Shape` and `Alias = Shape.member`.
closes_value = (p :: Parser, j: usize) bool {
    p.token_kind_at(j).continues_expr().match({
        true  => false,
        false => true,
    });
}

continues_expr = (kind: TokenKind) bool {
    kind.match({
        Dot         => true,
        ParenOpen   => true,
        BracketOpen => true,
        Lt          => true,
        Star        => true,
        Plus        => true,
        Minus       => true,
        Slash       => true,
        Percent     => true,
        PlusWrap    => true,
        MinusWrap   => true,
        StarWrap    => true,
        EqEq        => true,
        BangEq      => true,
        Gt          => true,
        LtEq        => true,
        GtEq        => true,
        AmpAmp      => true,
        BarBar      => true,
        _           => false,
    });
}

// Whether the statement at the cursor is a declaration rather than a
// binding. Only ever asked inside a body: at module level there are no
// statements, so everything is a declaration and nothing has to
// decide.
decl_head_ahead* = (p :: Parser, module_level: bool) bool {
    p.at_kind(TokenKind.Ident).match({
        false => false,
        true  => p.head_shape_ahead(),
    });
}

// A `*` here is the export marker ONLY if the rest of a head follows
// it. It is also multiplication, and treating it as the marker on
// SIGHT made `twice = (n: i32) i32 { n * 2 }` a declaration named `n`
// — the commonest shape in the language, rejected, while `n + 2` and
// `(n * 2)` were fine. The star settles nothing on its own: what
// settles it is the `=` a declaration has and a product does not, so
// the star is stepped over and the same question asked past it.
//
// This is `binder_after_head` below, one binder narrower — a `:` in a
// body is a typed BINDING, not a declaration — and the two are written
// alike because they are one shape: a name, an optional `*`, optional
// type parameters, a binder.
head_shape_ahead = (p :: Parser) bool {
    j ::= p.live_at(p.at + 1);
    (p.token_kind_at(j) == TokenKind.Star).match({
        true  => { j = p.live_at(j + 1); },
        false => (),
    });
    after = p.token_kind_at(j);
    (after == TokenKind.Lt).match({
        true  => p.generic_head_ahead(j),
        false => p.assign_head_ahead(after, j),
    });
}

generic_head_ahead = (p :: Parser, j: usize) bool {
    k = p.angles_end_at(j);
    (k > j) && p.assigns(p.live_kind(k))
}

assign_head_ahead = (p :: Parser, after: TokenKind, j: usize) bool {
    p.assigns(after).match({
        false => false,
        true  => p.declares_value(p.live_at(j + 1)),
    });
}

assigns = (p: Parser, kind: TokenKind) bool {
    kind.is_in([TokenKind.Eq, TokenKind.ColonColonEq])
}

// The same seven-way question as `value_shape`, asked one token
// earlier and answered only far enough to know whether a `;` will
// follow. A struct, an enum and a function are declarations; anything
// else in a body is a binding.
declares_value = (p :: Parser, j: usize) bool {
    kind = p.token_kind_at(j);
    kind.is_in([TokenKind.BraceOpen, TokenKind.Bar])
        || p.declares_fn(j, kind)
        || p.declares_enum(j, kind)
}

declares_fn = (p :: Parser, j: usize, kind: TokenKind) bool {
    (kind == TokenKind.ParenOpen).match({
        true  => p.live_kind(p.group_end_at(j)).fn_value_after(),
        false => kind == TokenKind.Lt && p.live_kind(p.angles_end_at(
            j
        )).fn_value_after(),
    });
}

declares_enum = (p :: Parser, j: usize, kind: TokenKind) bool {
    (kind == TokenKind.Ident).match({
        false => false,
        true  => p.bar_after(j),
    });
}

bar_after = (p :: Parser, j: usize) bool {
    k ::= p.live_at(j + 1);
    (p.token_kind_at(k) == TokenKind.ParenOpen).match({
        true  => { k = p.live_at(p.group_end_at(k)); },
        false => (),
    });
    p.token_kind_at(k) == TokenKind.Bar;
}

// -------------------------------------------------------------------
// a return type, or the next declaration
//
// The fifth question, and the one nobody wrote down: a signature's
// return type is followed by NOTHING — a declaration has no terminator
// — so the token after it is the next member's name, and a name can
// begin a type.
//
// It only bites where the return type is written `()`: a `Named` type
// stops at its own last token and never reaches for the one after.
// `next* = (self: @Self) ()` above `stop* = (self: @Self) ()` read the
// `()` as a nullary function type's parameter list and `stop` as its
// return type, wanting a member name at the `*`. That shape is all of
// loop_handle.zen, mem_ptr.zen and mem_alloc.zen — the parser couldn't
// read the standard library it's compiled against.
// -------------------------------------------------------------------

// Whether a return type really begins at the cursor. Everything a type
// may begin with, minus the one thing that only LOOKS like one.
ret_ahead* = (p :: Parser) bool {
    p.peek().kind.starts_type_kind() && !p.member_head_ahead()
}

// Whether the cursor is on the head of a member or a declaration:
// `name`, an optional `*`, optional type parameters, and the binder
// that makes it a declaration. Nothing else in the language puts a
// `:`, `::`, `=` or `::=` after a name, which is what makes one token
// of scanning enough to tell a return type from the next line.
member_head_ahead* = (p :: Parser) bool {
    p.at_kind(TokenKind.Ident).match({
        false => false,
        true  => p.binder_after_head(),
    });
}

binder_after_head = (p :: Parser) bool {
    j ::= p.live_at(p.at + 1);
    (p.token_kind_at(j) == TokenKind.Star).match({
        true  => { j = p.live_at(j + 1); },
        false => (),
    });
    (p.token_kind_at(j) == TokenKind.Lt).match({
        true  => { j = p.live_at(p.angles_end_at(j)); },
        false => (),
    });
    p.token_kind_at(j).binds();
}

binds = (kind: TokenKind) bool {
    kind.is_in([
        TokenKind.Colon,
        TokenKind.ColonColon,
        TokenKind.Eq,
        TokenKind.ColonColonEq,
    ])
}
