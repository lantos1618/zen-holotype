// std.encoding — pure base64 (standard RFC 4648 alphabet + `=` padding) and lowercase hex codecs.
//
// Pure byte manipulation, no hidden heap: every function takes the caller's allocator explicitly
// (`MutPtr<A>`, an `Allocator`) and threads its output buffer through it — the same contract as
// std.text.str's builders. `*_encode` returns a fresh NUL-terminated `str` owned by `a`; `*_decode`
// returns an allocator-owned `[u8]` or an `IoError` in the value channel — a malformed input is a
// value to `.match`, never a panic.
//
//   b := "Man".view()                       // [u8] over the bytes
//   s := a.base64_encode(b)                  // "TWFu"
//   a.base64_decode("TWFu").match ({ .Ok(bytes) => ..., .Err(e) => ... })
//   a.hex_encode(b)                          // "4d616e"  (always lowercase)
//   a.hex_decode("4d616e").match ({ .Ok(bytes) => ..., .Err(e) => ... })
//
// DECODE ERRORS ride IoError.Errno with these codes (match `.Errno(c)` to tell them apart), reusing
// the POSIX numbers whose meaning already fits: a length that can't be a whole codeword, or a byte
// outside the alphabet (an out-of-place `=` counts as a bad byte).
{ Allocator } = std.mem.alloc
{ Result, IoError, ok, err } = std.core.result
ENC_BAD_LEN* := 22    // EINVAL — input length is not a valid base64/hex codeword multiple
ENC_BAD_CHAR* := 84    // EILSEQ — a byte outside the alphabet (or a misplaced `=` pad)
// ── base64 ────────────────────────────────────────────────────────────────────
// sextet value (0..63) -> its RFC 4648 alphabet byte.
b64_char = (v: i64) u8 { (v < 26).match ({ true => ('A'.to_i64() + v).to_u8(), false => (v < 52).match ({ true => ('a'.to_i64() + v - 26).to_u8(), false => (v < 62).match ({ true => ('0'.to_i64() + v - 52).to_u8(), false => (v == 62).match ({ true => '+', false => '/' }) }) }) }) }
// alphabet byte -> its sextet value (0..63), or -1 for any non-alphabet byte (incl. `=`).
b64_val = (c: u8) i64 { (c >= 'A' && c <= 'Z').match ({ true => (c - 'A').to_i64(), false => (c >= 'a' && c <= 'z').match ({ true => (c - 'a').to_i64() + 26, false => (c >= '0' && c <= '9').match ({ true => (c - '0').to_i64() + 52, false => (c == '+').match ({ true => 62, false => (c == '/').match ({ true => 63, false => 0 - 1 }) }) }) }) }) }
// trailing `=` padding count (0..2). Caller guarantees sv.len is a positive multiple of 4.
b64_pad = (sv: [u8]) i64 {
    n := sv.len
    (sv[n - 1] == '=').match ({ true => (sv[n - 2] == '=').match ({ true => 2, false => 1 }), false => 0 })
}
// base64-encode `data`. Output length is 4*ceil(n/3) with `=` padding; empty input yields "".
base64_encode*<A> = (a: MutPtr<A>, data: [u8]) str {
    n := data.len
    ngroups := (n + 2) / 3
    olen := ngroups * 4
    out: [u8] := a.acquire(olen + 1).slice(olen + 1)
    oi: i64 := 0
    b0: i64 := 0
    b1: i64 := 0
    b2: i64 := 0
    // `k` = bytes buffered in the current 3-byte group (0..3); every 3 bytes flush 4 chars.
    k: i64 := 0
    data.loop((h, i, b) {
        (k == 0).match ({ true => {
            b0 = b.to_i64()
        }, false => (k == 1).match ({ true => {
            b1 = b.to_i64()
        }, false => {
            b2 = b.to_i64()
        } }) })
        k = k + 1
        (k == 3).match ({ true => {
            out[oi] = b64_char(b0 >> 2)
            out[oi + 1] = b64_char((b0 & 3) << 4 | b1 >> 4)
            out[oi + 2] = b64_char((b1 & 15) << 2 | b2 >> 6)
            out[oi + 3] = b64_char(b2 & 63)
            oi = oi + 4
            k = 0
        } })
    })
    (k == 1).match ({ true => {
        out[oi] = b64_char(b0 >> 2)
        out[oi + 1] = b64_char((b0 & 3) << 4)
        out[oi + 2] = '='
        out[oi + 3] = '='
    } })
    (k == 2).match ({ true => {
        out[oi] = b64_char(b0 >> 2)
        out[oi + 1] = b64_char((b0 & 3) << 4 | b1 >> 4)
        out[oi + 2] = b64_char((b1 & 15) << 2)
        out[oi + 3] = '='
    } })
    out[olen] = 0
    cstr(out.ptr)
}
base64_encode_in*<A> = (a: MutPtr<A>, data: [u8]) str { a.base64_encode(data) }
// base64-decode `s`. `.Err(.Errno(ENC_BAD_LEN))` when the length is not a multiple of 4;
// `.Err(.Errno(ENC_BAD_CHAR))` on any byte outside the alphabet (incl. a misplaced `=`).
base64_decode*<A> = (a: MutPtr<A>, s: str) Result<[u8], IoError> {
    sv := s.view()
    n := sv.len
    (n == 0).match ({ true => ok(slice(null_ptr(), 0)), false => (n % 4 != 0).match ({ true => err(IoError.Errno(ENC_BAD_LEN)), false => {
        pad := sv.b64_pad()
        ngroups := n / 4
        olen := ngroups * 3 - pad
        a.try_acquire(olen).match ({
            .Ok(p)  => {
                out: [u8] := p.slice(olen)
                oi: i64 := 0
                s0: i64 := 0
                s1: i64 := 0
                s2: i64 := 0
                bad := false
                sv.loop((h, i, c) {
                    bad.match ({ true => {
                        h.break
                    }, false => {
                        pos := i % 4
                        g := i / 4
                        last := g == ngroups - 1
                        padslot := last && (pos == 3 && pad >= 1 || pos == 2 && pad == 2)
                        val := (c == '=').match ({ true => padslot.match ({ true => 0, false => {
                            bad = true
                            0
                        } }), false => {
                            v := c.b64_val()
                            (v < 0).match ({ true => {
                                bad = true
                            } })
                            v
                        } })
                        (pos == 0).match ({ true => {
                            s0 = val
                        }, false => (pos == 1).match ({ true => {
                            s1 = val
                        }, false => (pos == 2).match ({ true => {
                            s2 = val
                        }, false => {
                            // pos == 3: whole codeword read — emit (3 - pad) bytes for the last group.
                            bad.match ({ false => {
                                nout := last.match ({ true => 3 - pad, false => 3 })
                                (nout >= 1).match ({ true => {
                                    out[oi] = (s0 << 2 | s1 >> 4).to_u8()
                                    oi = oi + 1
                                } })
                                (nout >= 2).match ({ true => {
                                    out[oi] = ((s1 & 15) << 4 | s2 >> 2).to_u8()
                                    oi = oi + 1
                                } })
                                (nout >= 3).match ({ true => {
                                    out[oi] = ((s2 & 3) << 6 | val).to_u8()
                                    oi = oi + 1
                                } })
                            } })
                        } }) }) })
                    } })
                })
                bad.match ({ true => {
                    a.release(out.ptr)
                    err(IoError.Errno(ENC_BAD_CHAR))
                }, false => ok(out) })
            },
            .Err(e) => err(e),
        })
    } }) })
}
base64_decode_in*<A> = (a: MutPtr<A>, s: str) Result<[u8], IoError> { a.base64_decode(s) }
// ── hex ───────────────────────────────────────────────────────────────────────
// nibble value (0..15) -> its LOWERCASE hex byte.
hex_char = (v: i64) u8 { (v < 10).match ({ true => ('0'.to_i64() + v).to_u8(), false => ('a'.to_i64() + v - 10).to_u8() }) }
// hex byte -> its nibble value (0..15), or -1 for a non-hex byte. Accepts both cases on input.
hex_val = (c: u8) i64 { (c >= '0' && c <= '9').match ({ true => (c - '0').to_i64(), false => (c >= 'a' && c <= 'f').match ({ true => (c - 'a').to_i64() + 10, false => (c >= 'A' && c <= 'F').match ({ true => (c - 'A').to_i64() + 10, false => 0 - 1 }) }) }) }
// lowercase-hex-encode `data`. Output length is 2*n; empty input yields "".
hex_encode*<A> = (a: MutPtr<A>, data: [u8]) str {
    n := data.len
    olen := n * 2
    out: [u8] := a.acquire(olen + 1).slice(olen + 1)
    data.loop((h, i, b) {
        v := b.to_i64()
        out[i * 2] = hex_char(v >> 4)
        out[i * 2 + 1] = hex_char(v & 15)
    })
    out[olen] = 0
    cstr(out.ptr)
}
hex_encode_in*<A> = (a: MutPtr<A>, data: [u8]) str { a.hex_encode(data) }
// hex-decode `s` (either case). `.Err(.Errno(ENC_BAD_LEN))` when the length is odd;
// `.Err(.Errno(ENC_BAD_CHAR))` on any non-hex byte.
hex_decode*<A> = (a: MutPtr<A>, s: str) Result<[u8], IoError> {
    sv := s.view()
    n := sv.len
    (n % 2 != 0).match ({ true => err(IoError.Errno(ENC_BAD_LEN)), false => {
        olen := n / 2
        (olen == 0).match ({ true => ok(slice(null_ptr(), 0)), false => a.try_acquire(olen).match ({
            .Ok(p)  => {
                out: [u8] := p.slice(olen)
                bad := false
                out.loop((h, i, b) {
                    hi := sv[i * 2].hex_val()
                    lo := sv[i * 2 + 1].hex_val()
                    (hi < 0 || lo < 0).match ({ true => {
                        bad = true
                        h.break
                    }, false => {
                        out[i] = (hi << 4 | lo).to_u8()
                    } })
                })
                bad.match ({ true => {
                    a.release(out.ptr)
                    err(IoError.Errno(ENC_BAD_CHAR))
                }, false => ok(out) })
            },
            .Err(e) => err(e),
        }) })
    } })
}
hex_decode_in*<A> = (a: MutPtr<A>, s: str) Result<[u8], IoError> { a.hex_decode(s) }
