// src/fmt/fmt.zen
// PLAN.md stage 2: `parse |> print`.
//
// THE SAME PARSER AND THE SAME TRIVIA. Nothing in this folder reads a
// byte of Zen — `lex` reads the bytes, `parse` builds the tree, and
// this file walks the tree the compiler itself is checked against.
// PLAN.md rule 2 is the whole reason: "never a second parser, never a
// second AST, never a 'just for the formatter' path. Two grammars is
// the failure this plan exists to avoid."
//
// WHAT THIS STAGE FORMATS, and it is deliberately narrow:
//
//   - the file's SHAPE. Declarations in source order, each starting on
//     its own line, with the comments that lead and trail them.
//   - BLANK LINES. A run of them collapses to one; one before the
//     first declaration or after the last is dropped; the file ends
//     with exactly one newline. `fmt_out.zen` is that rule and nothing
//     else.
//   - the SPACE AFTER A DECLARATION. Whatever ran to the end of the
//     line behind the last token is gone.
//
// WHAT IT PASSES THROUGH VERBATIM, said out loud because a formatter
// that guesses is worse than one that abstains: EVERY DECLARATION'S OWN
// TEXT. A struct body, a function signature, a match's arms, an enum's
// variants, the alignment of a trailing comment — all of it is the
// author's bytes, copied. The forms are modelled in the AST and could
// be rebuilt; rebuilding them is a set of layout decisions nobody has
// written down yet, and a printer inventing them would silently reflow
// a hundred and twenty files on its first run. `docs/PLAN.md` names the
// rules that are owed (align `=>` in match arms, short arms on one
// line, wrap long ones) and they arrive as a `fmt_decl.zen` beside
// this file, against a corpus, one form at a time.
//
// WHAT IT REFUSES: a file with lexical or syntactic faults. A tree with
// a hole in it is a tree whose spans no longer describe the source, and
// printing from one is how a formatter eats code.
//
// AND THE GUARD THAT MAKES THE WHOLE ARRANGEMENT SAFE — `faithful`
// below. Formatting moves whitespace and nothing else, so the token
// stream of the output must equal the token stream of the input, one
// for one, comments included. That is checkable in one extra `scan`,
// it holds for every rule this stage will ever grow, and it turns
// "silently reflowed something I did not model" from a bug that ships
// into an outcome that cannot leave this function.

Alloc, AllocError = std.mem
str, String = std.text
Vec = std.collections
Range = std.core
Pos, TriviaRun = ast.ast_span
Ast = ast.ast_arena
Module, Decl = ast.ast_node
scan, Source, Lexed, text_of = lex.lex
Diag, Parser, module = parse.parse
same = parse.parse_token

Src* = fmt.fmt_src
Out* = fmt.fmt_out

// What formatting one file came to.
//
// Three fields and not a three-way enum, because a caller acts on all
// three at once: it prints the diagnostics, it compares the text, and
// it refuses to write when the guard says the tree changed. An enum
// would make the driver match to learn things that are never in
// conflict.
Render* = {
    // The formatted file. Meaningful only when `diags` is empty and
    // `faithful` is true; empty otherwise, because there is nothing
    // honest to put in it.
    text*: String,

    // Syntax faults. Non-empty means the file was NOT formatted — the
    // caller reports these and leaves the bytes alone.
    diags*: Vec<Diag>,

    // The output lexes to the same tokens as the input. False is a bug
    // in this folder, and a caller that writes the file anyway has
    // turned a formatter into an editor.
    faithful*: bool,
}

// Format one already-lexed file.
//
// It takes a `Lexed` rather than bytes so that LEXICAL faults stay with
// the caller: `lex.zen`'s contract is that a file with them is reported
// and not parsed, and deciding that is the driver's job — the same
// split `zen_build.zen` makes.
render* = (a: Alloc, lexed: Lexed) Res<Render, AllocError> {
    src = a.Src(lexed.source.text).try();
    p ::= a.Parser(lexed);
    m = p.module(lexed.source.file).try();
    (p.diags.len == 0).match({
        false => rejected(a, p.diags),
        true  => printed(a, src, p.tree, m, lexed),
    })
}

rejected = (a: Alloc, diags: Vec<Diag>) Res<Render, AllocError> {
    Ok(Render(text: a.String().try(), diags: diags, faithful: false));
}

printed = (a: Alloc, src: Src, tree: Ast, m: Module, lexed: Lexed)
          Res<Render, AllocError> {
    out ::= a.Out().try();
    write_module(out, src, tree, m).try();
    ok = unchanged_tokens(a, lexed, out.view()).try();
    Ok(Render(text: out.text, diags: a.Vec<Diag>(), faithful: ok));
}

// -------------------------------------------------------------------
// printing
// -------------------------------------------------------------------

// The file: every declaration in source order, and the trivia that
// belongs to each.
//
// `Module.decls` IS the file, imports included — `ast_node.zen` says
// why: "a formatter that has to merge two lists back into one order is
// a formatter that will get it wrong once". So there is one loop here
// and no second pass.
write_module* = (out :: Out, src: Src, tree: Ast, m: Module)
                Res<(), AllocError> {
    m.decls.loop((h, i, d) {
        write_trivia(out, tree, d.leading).try();
        out.say(decl_text(src, tree, m, i, d)).try();
    });
    write_trivia(out, tree, m.trailing).try();
    Ok(());
}

// A run of comments and blanks, at the left margin.
//
// A comment's `text` is the raw source slice, markers and all, so a
// block comment spanning six lines is one `say` of six lines. Nothing
// here parses a comment and nothing rewraps one: `ast_span.zen` fixes
// that — "the formatter reprints it byte for byte; nothing here parses
// it".
write_trivia = (out :: Out, tree: Ast, run: TriviaRun) Res<(), AllocError> {
    Range(0, run.len).loop((h, i) {
        piece = tree.trivia_at(run, i);
        piece.kind.match({
            Blank => out.blank(),
            _     => out.say_at(piece.span.start.col, piece.text),
        }).try();
    });
    Ok(());
}

// One declaration, as its author wrote it: from its first token to the
// start of the next thing this file is going to print, with the
// whitespace at the end taken off.
//
// IT IS BOUNDED BY THE NEXT PRINTED ITEM AND NOT BY THE DECLARATION'S
// OWN SPAN, and that is the difference between a formatter and a
// formatter that eats comments. A trailing comment belongs to the
// OUTERMOST node whose span ends before it on that line, and for
//
//     Cli* = Build(Job)
//          | Missing(str)   // a flag the build needs and did not get
//
// that node is the last VARIANT, not the declaration — so `Decl.span`
// stops at `)`, `Decl.trailing` is empty, and a slice cut to either
// would drop the sentence. Everything between two printed items is the
// author's, whoever inside claimed it, and copying the gap also keeps
// the column that comment is aligned in.
//
// THE ONE THING DELETED IS TRAILING WHITESPACE, which the guard proves
// is not a token, and blank lines — which are `Blank` trivia in the
// NEXT item's leading run, and come back from there.
decl_text = (src: Src, tree: Ast, m: Module, i: usize, d: Decl) str {
    from = src.offset(d.span.start);
    to = src.offset(next_start(tree, m, i));
    src.slice_at(from, src.trim_back(from, to))
}

// Where the next thing this file prints begins: the following
// declaration's leading trivia, or the declaration itself, or — after
// the last one — whatever is left at end of file.
next_start = (tree: Ast, m: Module, i: usize) Pos {
    m.decls.get(i + 1).match({
        Ok(next) => run_start(tree, next.leading).match({
            Ok(p) => p,
            None  => next.span.start,
        }),
        None     => run_start(tree, m.trailing).match({
            Ok(p) => p,
            None  => m.span.end,
        }),
    })
}

run_start = (tree: Ast, run: TriviaRun) Res<Pos> {
    (run.len == 0).match({
        true  => None,
        false => Ok(tree.trivia_at(run, 0).span.start),
    })
}

// -------------------------------------------------------------------
// the guard
// -------------------------------------------------------------------

// The output says exactly what the input said.
//
// WHITESPACE IS NOT A TOKEN and a comment IS one, which is what makes
// this the right invariant rather than an approximation of one:
// everything this stage is allowed to change is invisible to the lexer,
// and everything it is not allowed to change is a token. So the streams
// must match one for one — same count, same kind, same bytes — and any
// rule added to the printer later is checked by the same three lines.
//
// It costs one extra scan of the file. That is the price of a formatter
// that models a subset of the language and can prove it did not touch
// the rest.
//
// It is not called `faithful`, which is what `Render` calls the ANSWER:
// a free function and a field of one name are one name to the resolver
// that has to decide what `x.faithful` means.
unchanged_tokens = (a: Alloc, before: Lexed, text: str) Res<bool, AllocError> {
    after = scan(a, Source(file: before.source.file, text: text)).try();
    Ok(after.is_clean() && same_stream(before, after));
}

same_stream = (before: Lexed, after: Lexed) bool {
    (before.tokens.len == after.tokens.len) && every_token_same(before, after)
}

every_token_same = (before: Lexed, after: Lexed) bool {
    ok ::= true;
    Range(0, before.tokens.len).loop((h, i) {
        token_same(before, after, i).match({
            true  => (),
            false => { ok = false; h.break(); },
        });
    });
    ok;
}

// Kind AND bytes. The kind alone would let one identifier become
// another; the bytes alone would already be enough, since this lexer is
// a pure function of its input and no token's reading depends on what
// is around it — so asking for both costs a comparison and removes the
// need to have been right about that.
token_same = (before: Lexed, after: Lexed, i: usize) bool {
    before.tokens.get(i).match({
        None  => false,
        Ok(x) => after.tokens.get(i).match({
            None  => false,
            Ok(y) => x.kind.same(y.kind)
                  && text_of(before.source, x).eq(text_of(after.source, y)),
        }),
    })
}
