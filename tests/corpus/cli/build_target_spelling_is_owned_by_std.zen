Os, Arch, Abi, Target = std.build

main = (env: Env) Res<i32, AllocError> {
    show(Target(os: Os.Linux, arch: Arch.X86_64, abi: Abi.Gnu));
    show(Target(os: Os.Macos, arch: Arch.Arm64, abi: Abi.Darwin));
    show(Target(os: Os.Windows, arch: Arch.Arm64, abi: Abi.Msvc));
    show(Target(os: Os.Macos, arch: Arch.X86_64, abi: Abi.Musl));
    Ok(0)
}

show = (target: Target) () {
    target.clang_triple().match({
        Ok(triple) => println(
            "{} {} {} -> {}",
            target.os.stable_name(),
            target.arch.stable_name(),
            target.abi.stable_name(),
            triple
        ),
        None       => println(
            "{} {} {} -> unsupported",
            target.os.stable_name(),
            target.arch.stable_name(),
            target.abi.stable_name()
        ),
    })
}
