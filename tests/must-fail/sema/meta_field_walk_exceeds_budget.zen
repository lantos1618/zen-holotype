// THE BUDGET REPORTS. `docs/design_meta.md` §6.1 asks for this test the
// same day the budget lands, and §8 records why it could not exist
// until now: the budget landed with M3's skeleton, where the one rule
// spent three steps and could not loop, so no program could red it.
// M4 is the first rule that can spend it down.
//
// THE SHAPE IS THE NESTED WALK, deliberately — §7's M4 risk names "a
// nested struct recurses and is where the step budget first earns its
// keep". Three walks, ten fields each, is a thousand copies of the
// innermost body: the expander's output is PROGRAM TEXT, and nesting is
// how the size of that text explodes. The tank is one per OUTERMOST
// evaluation and a nested walk does NOT refill it
// (`Checker.meta_enter`), which is the answer §8 left open to the first
// rule that could loop.
//
// AND IT REPORTS RATHER THAN TRUNCATING, which is the property the
// `.count` of 1 holds. `sema_trap.zen` draws the line: a prover may
// decline, an evaluator may not. A dry tank hands the ORIGINAL node id
// back, so a truncated copy still LOOKS like an expression — checking
// one produced thirty-three sentences about substitutions that never
// happened. `sema_meta.meta_intact` is what closes that, and this count
// is what would notice it reopening.
//
// position: the node the copy ran out on.

A = {
    a0*: i64,
    a1*: i64,
    a2*: i64,
    a3*: i64,
    a4*: i64,
    a5*: i64,
    a6*: i64,
    a7*: i64,
    a8*: i64,
    a9*: i64,
}

B = {
    b0*: i64,
    b1*: i64,
    b2*: i64,
    b3*: i64,
    b4*: i64,
    b5*: i64,
    b6*: i64,
    b7*: i64,
    b8*: i64,
    b9*: i64,
}

C = {
    c0*: i64,
    c1*: i64,
    c2*: i64,
    c3*: i64,
    c4*: i64,
    c5*: i64,
    c6*: i64,
    c7*: i64,
    c8*: i64,
    c9*: i64,
}

main = (env: Env) Res<i32, AllocError> {
    a = A(
        a0: 1,
        a1: 2,
        a2: 3,
        a3: 4,
        a4: 5,
        a5: 6,
        a6: 7,
        a7: 8,
        a8: 9,
        a9: 10
    );
    b = B(
        b0: 1,
        b1: 2,
        b2: 3,
        b3: 4,
        b4: 5,
        b5: 6,
        b6: 7,
        b7: 8,
        b8: 9,
        b9: 10
    );
    c = C(
        c0: 1,
        c1: 2,
        c2: 3,
        c3: 4,
        c4: 5,
        c5: 6,
        c6: 7,
        c7: 8,
        c8: 9,
        c9: 10
    );
    @meta(a: A).fields().loop((h1, f) {
        @meta(b: B).fields().loop((h2, g) {
            @meta(c: C).fields().loop((h3, k) {
                println("{}{}{} {}", f.name, g.name, k.name, c.at(k));
            });
        });
    });
    Ok(0);
}
