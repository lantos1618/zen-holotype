// compiler.check — resolve and infer over the shared genc AST.
// This pass fills enum names, constructor types, UFCS dispatch, generic instances, and the
// type facts the validator/backend need. Child nodes are rebuilt, not mutated in place.
{ cbuf, Expr, Stmt, Decl, Func, Param, Ty, EnumDecl, StructDecl, Field, ImplData, TraitDefData, ArmData, MatchData, VariantDef, LetData, AssignData, IndexSetData, IndexData, MemberData, ArrowData, VarData, CallData, MethodCallData, CondData, BinData, BlockData, LambdaData, GenericData, MakeStructData, MakeEnumData, TagData, vref, vref_at, ty_cname_in, bin, bin_at, cond, cond_oa, call, call_at, raw_call_at, call_full, member, member_at, arrow, arrow_at, ematch, ematchp, mkenum, mktag, arm, arm_at, eindex, eloop, LoopData, lam_r, slet, slett, slett_at, sassign, sassign_at, sret, sexpr, sif, swhile, sidxset_at, mkstruct, mkstruct_at, finit, FieldInit, slit, SliceData, block, stmts_diverge, fnt_from_func_in, fntype, subst_ty_in, dfunc, dforeign, dglobal, dglobal_tl, GlobalData, mkstructg, mkstructg_at, mkenumg, mktagg, no_tys, expr_null, is_expr_null, GenEnumDecl, GenStructDecl, find_genenum, tgeneric, FnTData, flit, ti32, ti64, tu8, tf64, tbool, tstring_view, tstring_cstr, tstring_literal, tnamed, tptr, tptr_k, tslice, tvoid, k_ptr, k_mut_ptr, k_raw_ptr, gstr_string, gstr_grow, gstr_reserve, gstr_push, gstr_append, gstr_finish } = compiler.genc
{ mangle_str_in, mangle_semantic_in, impl_cname_in } = compiler.mangle
{ Allocator, Malloc } = std.mem.alloc
{ exports_get, alias_prefixes_get, module_sigs_get, SigEntry } = compiler.parse
{ panic, expect } = std.core.result
{ view, eq, is_empty, ends_with } = std.text.str
{ String } = std.text.string
{ at } = std.text.bytes
{ Map, of } = std.collections.map
{ lift_lambdas } = compiler.passes.lift
{ OrxRw, orx_count, orx_rw, orx_rw_stmt, orx_stmt_count } = compiler.passes.orreturn
{ subst_body, xform_arm_env, xform_body } = compiler.passes.subst
{ clos_call_rewrite, clos_local_call_name, clos_lower_func, clos_lowerable } = compiler.passes.closures
{ rc_expand, rc_gbuf, rc_gen, rc_seed } = compiler.passes.refcount
{ PtrKind } = compiler.passes.ptrkind
// AST-node query traits (is_fnt on Ty, is_generic_fn on Func). Importing from compiler.astops pulls
// the WHOLE module (all its impls: Ty/Func/Decl/StructDecl) into check's import closure, so the impl
// index resolves these UFCS methods here and in every module that imports check (validate/*, passes/*).
{ TyQuery, FuncQuery, has_fnt_param } = compiler.astops
// Cohesive families extracted into flat sibling files (pure moves). The check↔check_* cycles are
// resolved by the `*` exports on both sides — --build-self concatenates all sources into one flat TU.
{ deep_targs, impl_trait_targ, light_ty, ty_mentions, ty_mentions_any, unify_ty } = compiler.check_infer
{ inline_decl, inline_template, is_empty_named, lower_closures, mono_close, mono_rec, no_inline_gen_f } = compiler.check_inline
{ desugar_method_calls, expand_defaults, fill_enum_defaults } = compiler.check_desugar
{ lower_match_arms, lower_stmt_expr, one_stmt, subj_payload, subj_tag, tag_const } = compiler.check_lower
{ fits, is_f64_ty, lvalue_writes_readonly, ty_eq, ty_rank } = compiler.check_fits
// ── DECLARATION INDEX ───────────────────────────────────────────────────────
// name → decl array index, an O(1) hash map (std.collections.map). Built once per
// resolve/check pass from the (immutable, within a pass) decls slice and threaded through Env,
// replacing the O(n) linear `the_func`/sibling scans that dominated compile time. `put` overwrites,
// so each name maps to its LAST occurrence — identical to the old last-match scans (top-level names
// are unique post-dedup anyway). -1 means absent.
DeclIndex*: {
    func_idx: Map<i64>,
    struct_idx: Map<i64>,
    enum_idx: Map<i64>,
    global_idx: Map<i64>,
    impl_idx: Map<i64>,
    tdef_idx: Map<i64>,
    alias_idx: Map<i64>,
    tmethod_idx: Map<i64>,
    import_idx: Map<i64>,
    genstruct_idx: Map<i64>,
    genenum_idx: Map<i64>,
    dispatch_idx: Map<i64>,
    idx_func = (idx: DeclIndex, decls: [Decl], name: string_view) Func {
        i := idx.func_idx.get(name, 0 - 1)
        (i >= 0 && i < decls.len).match ({
            true  => decls[i].match ({
                .DFunc(f)    => f,
                .DForeign(f) => f,
                _            => Func(
                    name: "",
                    params: empty_params(),
                    ret: tvoid(),
                    tparams: empty_params(),
                    body: no_stmts(),
                ),
            }),
            false => Func(
                name: "",
                params: empty_params(),
                ret: tvoid(),
                tparams: empty_params(),
                body: no_stmts(),
            ),
        })
    }
    idx_struct_field = (idx: DeclIndex, decls: [Decl], sname: string_view, fname: string_view) Ty {
        i := idx.struct_idx.get(sname, 0 - 1)
        (i >= 0 && i < decls.len).match ({
            true  => decls[i].match ({
                .DStruct(sd) => sd.field_ty(fname),
                _            => tvoid(),
            }),
            false => tvoid(),
        })
    }
    idx_genstruct_field = (idx: DeclIndex, a: MutPtr<Malloc>, decls: [Decl], gname: string_view, fname: string_view, targs: [Ty]) Ty {
        g := idx.idx_genstruct(decls, gname)
        is_empty(g.name).match ({
            true  => tvoid(),
            false => a.subst_ty_in(g.tparams, targs, g.fields.gen_field_at(fname)),
        })
    }
    idx_variant_payload = (idx: DeclIndex, decls: [Decl], ename: string_view, vn: string_view) Ty {
        i := idx.enum_idx.get(ename, 0 - 1)
        (i >= 0 && i < decls.len).match ({
            true  => decls[i].match ({
                .DEnum(ed) => ed.variants.vdef_payload(vn),
                _          => tvoid(),
            }),
            false => tvoid(),
        })
    }
    idx_template_call = (idx: DeclIndex, decls: [Decl], name: string_view) bool { idx.idx_func(decls, name).is_generic_fn() }
    idx_genstruct = (idx: DeclIndex, decls: [Decl], name: string_view) GenStructDecl {
        i := idx.genstruct_idx.get(name, 0 - 1)
        (i >= 0 && i < decls.len).match ({
            true  => decls[i].match ({
                .DGenStruct(g) => g,
                _              => GenStructDecl(
                    name: "",
                    tparams: slice(null_ptr(), 0),
                    fields: slice(null_ptr(), 0),
                ),
            }),
            false => GenStructDecl(
                name: "",
                tparams: slice(null_ptr(), 0),
                fields: slice(null_ptr(), 0),
            ),
        })
    }
    idx_genenum = (idx: DeclIndex, decls: [Decl], name: string_view) GenEnumDecl {
        i := idx.genenum_idx.get(name, 0 - 1)
        (i >= 0 && i < decls.len).match ({
            true  => decls[i].match ({
                .DGenEnum(g) => g,
                _            => GenEnumDecl(
                    name: "",
                    tparams: slice(null_ptr(), 0),
                    variants: slice(null_ptr(), 0),
                ),
            }),
            false => GenEnumDecl(
                name: "",
                tparams: slice(null_ptr(), 0),
                variants: slice(null_ptr(), 0),
            ),
        })
    }
    idx_variant_default = (idx: DeclIndex, decls: [Decl], ename: string_view, vn: string_view) Ptr<Expr> {
        i := idx.enum_idx.get(ename, 0 - 1)
        (i >= 0 && i < decls.len).match ({
            true  => decls[i].match ({
                .DEnum(ed) => ed.variants.vdef_default_of(vn),
                _          => expr_null(),
            }),
            false => expr_null(),
        })
    }
}    // DFunc.name | DForeign.name → index
tdkey = (a: MutPtr<Malloc>, tr: string_view, m: string_view) string_view { a.gstr_string(64).gstr_append(a, tr).gstr_append(a, "\t").gstr_append(a, m).gstr_finish(a) }    // DStruct.name → index
// ── alias-name index (UFCS through module aliases) ──────────────────────────────────────────────
// std.internal.resolve loads `m = std.collections.hmap` by prefixing hmap's top-level value decls
// with `m__`. alias_idx maps the BARE method tail (`put` for `m__put`) to a decl index, so the
// UFCS fallback in dispatch_name can O(1)-reject names that no alias provides (the common case for
// intrinsics like `store`/`offset` and deferred trait methods) before scanning for candidates.
// byte position of the LAST `__` separator in `name`, or -1 when it has none.
alias_sep_from = (name: string_view, p: i32, last: i32) i32 {
    (name.at(p) == 0).match ({
        true  => last,
        false => (name.at(p) == '_' && name.at(p + 1) == '_').match ({
            true  => name.alias_sep_from(p + 1, p),
            false => name.alias_sep_from(p + 1, last),
        }),
    })
}
alias_sep = (name: string_view) i32 { name.alias_sep_from(0, 0 - 1) }
// the method tail after the separator (`put` of `m__put`) — a NUL-terminated suffix, no copy.
alias_tail = (name: string_view, sep: i32) string_view { cstr(offset(name, to_i64(sep + 2))) }
// does `name` begin with `pre` immediately followed by the `__` separator (`m` matches `m__put`)?
alias_prefix_match_at = (name: string_view, pre: string_view, i: i32) bool {
    (pre.at(i) == 0).match ({
        true  => name.at(i) == '_' && name.at(i + 1) == '_',
        false => (name.at(i) == pre.at(i)).match ({
            true  => name.alias_prefix_match_at(pre, i + 1),
            false => false,
        }),
    })
}
// is `name`'s prefix an ACTUAL module-alias binding (from `m = std.x.y` / `m = sibling`)? Only then is
// `name` a genuine `alias__method` decl. Guards against phantom UFCS methods: a plain user fn that
// merely has `__` in its name (`foo__grow`) has no matching alias, so it is NOT alias-shaped.
alias_is_real_prefix = (name: string_view) bool {
    f := false
    alias_prefixes_get().loop((h, i, p) {
        f = name.alias_prefix_match_at(p.name, 0).match ({ true => true, false => f })
    })
    f
}
// register `name` under its tail iff it is alias-shaped: a NON-EMPTY prefix that is a REAL module alias
// (skips compiler internals like `__str_eq`, whose separator is at position 0, and plain user fns like
// `foo__grow` whose prefix is not an alias binding).
alias_note = (m: Map<i64>, a: MutPtr<Malloc>, name: string_view, i: i64) Map<i64> {
    sep := name.alias_sep()
    (sep > 0 && name.alias_is_real_prefix()).match ({
        true  => m.put(a, name.alias_tail(sep), i).expect("check: decl-index alloc"),
        false => m,
    })
}
// fold a name-only [Param] list (DImpl.methods / DImport.names) into a presence map.
names_note = (m: Map<i64>, a: MutPtr<Malloc>, names: [Param], i: i64) Map<i64> {
    mm := m
    names.loop((h, j, p) {
        mm = mm.put(a, p.name, i).expect("check: decl-index alloc")
    })
    mm
}
build_decl_index* = (a: MutPtr<Malloc>, decls: [Decl]) DeclIndex {
    seed: i64 := 0 - 1    // DEnum.name → index
    // DGlobal.name → index
    // DImpl.ty → presence marker (a type with at least one impl)
    // (trait "\t" method) → presence: the trait provides a default for the method
    // the combined key for a trait-default lookup; trait/method are identifiers, so a TAB can't collide.
    fm := of(a, "", seed).expect("check: decl-index alloc")
    sm := of(a, "", seed).expect("check: decl-index alloc")
    em := of(a, "", seed).expect("check: decl-index alloc")
    gm := of(a, "", seed).expect("check: decl-index alloc")
    im2 := of(a, "", seed).expect("check: decl-index alloc")
    tm := of(a, "", seed).expect("check: decl-index alloc")
    am := of(a, "", seed).expect("check: decl-index alloc")
    mm := of(a, "", seed).expect("check: decl-index alloc")
    pm := of(a, "", seed).expect("check: decl-index alloc")
    gsm := of(a, "", seed).expect("check: decl-index alloc")
    gem := of(a, "", seed).expect("check: decl-index alloc")
    decls.loop((h, i, d) {
        d.match ({
            .DFunc(f)          => {
                fm = fm.put(a, f.name, i).expect("check: decl-index alloc")
                am = am.alias_note(a, f.name, i)
            },
            .DForeign(f)       => {
                fm = fm.put(a, f.name, i).expect("check: decl-index alloc")
                am = am.alias_note(a, f.name, i)
            },
            .DStruct(s)        => {
                sm = sm.put(a, s.name, i).expect("check: decl-index alloc")
            },
            .DEnum(e)          => {
                em = em.put(a, e.name, i).expect("check: decl-index alloc")
            },
            .DGlobal(g)        => {
                gm = gm.put(a, g.name, i).expect("check: decl-index alloc")
            },
            .DImpl(imd)        => {
                im2 = im2.put(a, imd.ty, i).expect("check: decl-index alloc")
                mm = mm.names_note(a, imd.methods, i)
            },
            .DTraitDefault(td) => {
                tm = tm.put(a, a.tdkey(td.trname, td.fn.name), i).expect("check: decl-index alloc")
                mm = mm.put(a, td.fn.name, i).expect("check: decl-index alloc")
            },
            .DImport(imp)      => {
                pm = pm.names_note(a, imp.names, i)
            },
            .DGenStruct(gs)    => {
                gsm = gsm.put(a, gs.name, i).expect("check: decl-index alloc")
            },
            .DGenEnum(ge)      => {
                gem = gem.put(a, ge.name, i).expect("check: decl-index alloc")
            },
            _                  => { },
        })
    })
    // ── dispatch index: (recv-ty "\t" method) → decl index of the LAST impl of that ty providing the
    // method, directly or via its trait's default — exactly the last-match verdict the old linear
    // dispatch_recv scan produced. Built as a second sweep (a trait default may be declared anywhere
    // relative to its impls); per impl the direct + defaulted method names are stamped together, so
    // decl order between impls decides, as before.
    tdn: i64 := 0
    decls.loop((h, i, d) {
        d.match ({
            .DTraitDefault(td) => {
                tdn = tdn + 1
            },
            _                  => { },
        })
    })
    tds := a.ibuf(tdn)
    tdk: i64 := 0
    decls.loop((h, i, d) {
        d.match ({
            .DTraitDefault(td) => {
                tds[tdk] = i
                tdk = tdk + 1
            },
            _                  => { },
        })
    })
    dm := of(a, "", seed).expect("check: decl-index alloc")
    decls.loop((h, i, d) {
        d.match ({
            .DImpl(imd) => {
                imd.methods.loop((h2, j, p) {
                    dm = dm.put(a, a.tdkey(imd.ty, p.name), i).expect("check: decl-index alloc")
                })
                tds.loop((h2, j, ti) {
                    decls[ti].match ({
                        .DTraitDefault(td) => {
                            eq(td.trname, imd.trname).then({
                                dm = dm.put(a, a.tdkey(imd.ty, td.fn.name), i).expect("check: decl-index alloc")
                            })
                        },
                        _                  => { },
                    })
                })
            },
            _           => { },
        })
    })
    DeclIndex(
        func_idx: fm,
        struct_idx: sm,
        enum_idx: em,
        global_idx: gm,
        impl_idx: im2,
        tdef_idx: tm,
        alias_idx: am,
        tmethod_idx: mm,
        import_idx: pm,
        genstruct_idx: gsm,
        genenum_idx: gem,
        dispatch_idx: dm,
    )
}
ibuf = (a: MutPtr<Malloc>, n: i64) [i64] { slice(a.acquire((n + 1) * sizeof(i64)), n) }
// O(1) indexed generic-decl lookups (same last-match sentinels as the linear gstruct_of/find_genenum).
// Variable environment: params plus prior lets, as a cons-list.
VList*: VNil | VCons(VCell)
VCell*: {
    name: string_view,
    ty: Ty,
    tail: Ptr<VList>,
}
// exp is the current expected type; tvoid() means no expectation.
Env*: {
    vars: Ptr<VList>,
    decls: [Decl],
    didx: DeclIndex,
    exp: Ty,
    a: MutPtr<Malloc>,
    infer_expr = (env: Env, e: Ptr<Expr>) Ty {
        load(e).match ({
            .Int(n)        => (n > 2147483647 || n < 0 - 2147483648).match ({
                true  => ti64(),
                false => ti32(),
            }),
            .Block(b)      => env.block_ty(b),
            .Byte(n)       => tu8(),
            .FloatLit(ft)  => tf64(),
            .Var(v)        => env.var_ty(v.name),
            .Bin(b)        => env.bin_ty_e(b),
            .Call(c)       => env.infer_call(c),
            .Cond(d)       => env.cond_ty(d),
            .Member(mm)    => env.infer_member(mm),
            .Arrow(ar)     => env.infer_arrow(ar),
            .MakeEnum(mk)  => env.mkenum_ty(mk),
            .Tag(t)        => env.tag_ty(t),
            .MakeStruct(s) => (s.targs.len > 0).match ({
                true  => tgeneric(s.ty, s.targs, s.mty),
                false => tnamed(s.ty),
            }),
            .StrLit(x)     => tstring_literal(),
            .Match(m)      => env.infer_match_ty(m),
            .Index(ix)     => env.index_elem(ix),
            .Loop(l)       => tvoid(),
            .SliceLit(sd)  => tslice(env.a.tnode(sd.elem.is_void_ty().match ({
                true  => env.sl_elem(sd.items),
                false => sd.elem,
            }))),
            _              => tvoid(),
        })
    }
    env_func = (env: Env, name: string_view) Func {
        i := env.didx.func_idx.get(name, 0 - 1)
        (i >= 0 && i < env.decls.len).match ({
            true  => env.decls[i].match ({
                .DFunc(f)    => f,
                .DForeign(f) => f,
                _            => Func(
                    name: "",
                    params: empty_params(),
                    ret: tvoid(),
                    tparams: empty_params(),
                    body: no_stmts(),
                ),
            }),
            false => Func(
                name: "",
                params: empty_params(),
                ret: tvoid(),
                tparams: empty_params(),
                body: no_stmts(),
            ),
        })
    }
    var_or_global = (env: Env, name: string_view) Ty {
        lv := env.vars.lookup_var(name)
        lv.is_void_ty().match ({ true => env.global_or_fn(name), false => lv })
    }
    subj_variant_payload = (env: Env, t: Ty, variant: string_view) Ty {
        t.match ({
            .Generic(g) => env.env_genenum(g.name).gen_variant_payload(variant).gsubst(env, g),
            _           => env.didx.idx_variant_payload(env.decls, t.enum_name(), variant),
        })
    }
    env_gstruct = (env: Env, name: string_view) GenStructDecl { env.didx.idx_genstruct(env.decls, name) }
    call_targ = (env: Env, f: Func, args: [Expr], tp: string_view) Ty {
        arg := env.targ_of(f.params, args, tp, false)
        arg = arg.is_void_ty().match ({ true => env.ret_targ_of(f.ret, tp), false => arg })
        arg.is_void_ty().match ({ true => env.targ_of(f.params, args, tp, true), false => arg })
    }
    with_exp = (env: Env, t: Ty) Env {
        Env(
            vars: env.vars,
            decls: env.decls,
            didx: env.didx,
            exp: t,
            a: env.a,
        )
    }
    is_local = (env: Env, name: string_view) bool { env.vars.var_bound(name) }
    is_bound = (env: Env, name: string_view) bool { env.vars.var_bound(name) || env.didx.global_idx.get(name, 0 - 1) >= 0 }
    alias_ufcs_candidates = (env: Env, fn: string_view, rty: Ty) AliasCands {
        (rty.alias_recv_dispatchable() == false || fn.is_intrinsic() || env.didx.alias_idx.get(fn, 0 - 1) < 0 || env.didx.func_idx.get(fn, 0 - 1) >= 0 || env.is_local(fn) || env.global_ty(fn).is_void_ty() == false).then({
            return alias_cands_none()
        })
        exact := env.alias_cands_scan(fn, rty, true)
        (exact.count > 0).match ({ true => exact, false => env.alias_cands_scan(fn, rty, false) })
    }
    var_ty = (env: Env, name: string_view) Ty {
        (eq(name, "true") || eq(name, "false")).match ({
            true  => tbool(),
            false => env.var_or_global(name),
        })
    }
    targ_of = (env: Env, params: [Param], args: [Expr], tp: string_view, lits: bool) Ty {
        found := tvoid()
        params.loop((h, i, p) {
            found = found.is_void_ty().match ({
                true  => (i < args.len && env.weak_targ_env(p.ty, args[i].addr(), tp) == lits).match ({
                    true  => env.unify_arg(p.ty, args[i].addr(), tp),
                    false => found,
                }),
                false => found,
            })
        })
        found
    }
    sl_elem_exp = (env: Env, items: [Expr]) Ty { env.exp.elem_of().is_void_ty().match ({
        true  => env.sl_elem(items),
        false => env.exp.elem_of(),
    }) }
    let_exp = (env: Env, t: Ty) Env {
        t.is_void_ty().match ({
            true  => env.clr_exp(),
            false => Env(
                vars: env.vars,
                decls: env.decls,
                didx: env.didx,
                exp: t,
                a: env.a,
            ),
        })
    }
    infer_call = (env: Env, c: CallData) Ty {
        eq(c.fn, "sizeof").match ({
            true  => ti64(),
            false => eq(c.fn, "__str_eq").match ({
                true  => tbool(),
                false => eq(c.fn, "__str_ne").match ({
                    true  => tbool(),
                    false => eq(c.fn, "load").match ({
                        true  => env.arg0_ty(c).pointee_of(),
                        false => eq(c.fn, "load_i64").match ({
                            true  => ti64(),
                            false => eq(c.fn, "atomic_add_i64").match ({
                                true  => ti64(),
                                false => eq(c.fn, "atomic_load_i64").match ({
                                    true  => ti64(),
                                    false => eq(c.fn, "atomic_cas_i64").match ({
                                        true  => tbool(),
                                        false => eq(c.fn, "to_i32").match ({
                                            true  => ti32(),
                                            false => eq(c.fn, "to_i64").match ({
                                                true  => ti64(),
                                                false => eq(c.fn, "to_u8").match ({
                                                    true  => tu8(),
                                                    false => eq(c.fn, "to_f64").match ({
                                                        true  => tf64(),
                                                        false => eq(c.fn, "null_ptr").match ({
                                                            true  => tptr_k(env.a.tnode(tu8()), k_raw_ptr()),
                                                            false => eq(c.fn, "cstr").match ({
                                                                true  => tstring_cstr(),
                                                                false => eq(c.fn, "addr").match ({
                                                                    true  => env.addr_ty(c),
                                                                    false => eq(c.fn, "assert_nonnull").match ({
                                                                        true  => env.arg0_ty(c).nonnull_ty(),
                                                                        false => env.gen_call_ret(c),
                                                                    }),
                                                                }),
                                                            }),
                                                        }),
                                                    }),
                                                }),
                                            }),
                                        }),
                                    }),
                                }),
                            }),
                        }),
                    }),
                }),
            }),
        })
    }
    dispatch_name = (env: Env, c: CallData) string_view {
        (c.args.len > 0).match ({
            true  => {
                rty := env.infer_expr(c.args[0].addr())
                tyname := rty.dispatch_recv_name()
                // Fast path: a receiver type with NO impl can never redirect dispatch, so skip the O(n)
                // impl scan entirely (the common case for primitive/struct receivers).
                dn := (env.didx.impl_idx.get(tyname, 0 - 1) < 0).match ({
                    true  => c.fn,
                    false => env.a.dispatch_recv(env.decls, env.didx, c.fn, tyname),
                })
                eq(dn, c.fn).match ({
                    true  => {
                        cs := env.alias_ufcs_candidates(c.fn, rty)
                        (cs.count == 1).match ({ true => cs.first, false => c.fn })
                    },
                    false => dn,
                })
            },
            false => c.fn,
        })
    }
    disc_env = (env: Env, e: Ptr<Expr>) Env { e.carries_return_e().match ({
        true  => env,
        false => env.clr_exp(),
    }) }
    clr_exp = (env: Env) Env { env.with_exp(tvoid()) }
    call_targs = (env: Env, f: Func, args: [Expr], etargs: [Ty]) [Ty] {
        buf := cbuf<Ty>(env.a, f.tparams.len)
        f.tparams.loop((h, i, tp) {
            buf[i] = (i < etargs.len).match ({
                true  => etargs[i],
                false => env.call_targ(f, args, tp.name),
            })
        })
        env.deep_targs_env(f.tparams, buf, f.params, args)
    }
    call_arg_exp = (env: Env, tmpl: bool, tparams: [Param], targs: [Ty], ps: [Param], i: i32) Ty {
        pty := ps.arg_exp_v(i)
        tmpl.match ({
            true  => pty.is_fnt().match ({
                true  => tvoid(),
                false => env.a.subst_ty_in(tparams, targs, pty),
            }),
            false => pty,
        })
    }
    block_ty = (env: Env, b: BlockData) Ty { b.stmts.stmts_diverge().match ({
        true  => tvoid(),
        false => env.block_ty_from(b.stmts, 0),
    }) }
    env_genenum = (env: Env, name: string_view) GenEnumDecl { env.didx.idx_genenum(env.decls, name) }
}    // a = allocator (heap-alloc in infer); didx = name→decl index
// O(1) indexed lookups, replacing the O(n) decls scans. `the_func`/`fn_ret`/etc. linear forms below
// remain for the few decls-only callers (template inlining, trait conformance) that lack an Env.
// Heap-node helpers. c* names avoid flat-TU collisions with parser helpers.
cebuf*<A> = (a: MutPtr<A>, n: i64) [Expr] { slice(a.acquire(n * sizeof(Expr)), n) }
cenode*<A> = (a: MutPtr<A>, v: Expr) Ptr<Expr> {
    buf := a.cebuf(1)
    buf[0] = v
    buf[0].addr()
}
// Pos-preserving rebuilds. Bare call()/vref() are only for synthesized nodes.
recall* = (a: MutPtr<Malloc>, c: CallData, fn: string_view, args: [Expr]) Ptr<Expr> { a.cenode(call_full(fn, args, c.targs, c.pos, c.raw)) }
var_call = (a: MutPtr<Malloc>, v: VarData, args: [Expr]) Ptr<Expr> { a.cenode(call_at(v.name, args, v.pos)) }
// Heap-own a Ty so Ptr<Ty> fields do not dangle.
tnode* = (a: MutPtr<Malloc>, t: Ty) Ptr<Ty> {
    buf := cbuf<Ty>(a, 1)
    buf[0] = t
    buf[0].addr()
}
vlbuf = (a: MutPtr<Malloc>) [VList] { slice(a.acquire(sizeof(VList)), 1) }
vlnode = (a: MutPtr<Malloc>, v: VList) Ptr<VList> {
    buf := a.vlbuf()
    buf[0] = v
    buf[0].addr()
}
vnil_val = () VList { .VNil }
vcons_val = (nm: string_view, t: Ty, tail: Ptr<VList>) VList {
    .VCons(VCell(
        name: nm,
        ty: t,
        tail: tail,
    ))
}
vnil* = (a: MutPtr<Malloc>) Ptr<VList> { a.vlnode(vnil_val()) }
vcons* = (a: MutPtr<Malloc>, nm: string_view, t: Ty, tail: Ptr<VList>) Ptr<VList> { a.vlnode(vcons_val(nm, t, tail)) }
params_env* = (a: MutPtr<Malloc>, ps: [Param]) Ptr<VList> {
    e := a.vnil()
    ps.loop((h, i, p) {
        e = a.vcons(p.name, p.ty, e)
    })
    e
}
lookup_var* = (v: Ptr<VList>, name: string_view) Ty {
    v.match ({
        .VNil     => tvoid(),
        .VCons(c) => eq(c.name, name).match ({ true => c.ty, false => c.tail.lookup_var(name) }),
    })
}
// The innermost enclosing function's DECLARED return type, threaded through the variable environment
// under an unlexable name (identifiers cannot start with a digit, so no user binding collides; the
// same trick as the inliner's in-progress-template marker). A `return <expr>` operand is typed against
// THIS — never the positional expected type, which is void everywhere but a body's tail statement
// (an `.or_return()` error branch sits inside a lowered If; a value-position arm's `return`
// sits in a block whose own value expectation is the ARM type). Lambda bodies bind their own (possibly
// void) entry so an enclosing function's return type never leaks into a lambda's `return`.
bind_fnret* = (a: MutPtr<Malloc>, vars: Ptr<VList>, ret: Ty) Ptr<VList> { a.vcons("0return", ret, vars) }
fnret_of* = (v: Ptr<VList>) Ty { v.lookup_var("0return") }
// Generic tparam scoping. A function's type parameters are fn-local names, but in the flat namespace
// a user's GLOBAL type of the same name (`T: { … }`) is the same identifier as the tparam of a stdlib
// generic (`print*<T>`). Threading each tparam name into the body Env's var list under the reserved
// marker "0#tp" (unlexable — a user identifier cannot begin with a digit, so no user binding collides;
// the same trick as bind_fnret's "0return") lets env_named_declared treat that name as ABSTRACT
// (fn-local, undeclared) even when a concrete global type of that name exists. So a tparam SHADOWS a
// same-named global type inside its own function body — the correct language scoping — and a user type
// named `T` no longer poisons the stdlib generic that happens to name its tparam `T`. The cell carries
// the tparam name as tnamed(...) so the membership test needs no per-query string allocation.
bind_tparams* = (a: MutPtr<Malloc>, vars: Ptr<VList>, tparams: [Param]) Ptr<VList> {
    e := vars
    tparams.loop((h, i, tp) {
        e = a.vcons("0#tp", tnamed(tp.name), e)
    })
    e
}
tparam_declared* = (v: Ptr<VList>, name: string_view) bool {
    v.match ({
        .VNil     => false,
        .VCons(c) => (eq(c.name, "0#tp") && eq(c.ty.ty_name(), name)).match ({
            true  => true,
            false => c.tail.tparam_declared(name),
        }),
    })
}
// Infer global init types; bind the global name while doing so to avoid self-recursive lookup.
infer_global_init = (env: Env, name: string_view, init: Ptr<Expr>) Ty {
    env2 := Env(
        vars: env.a.vcons(name, tnamed(""), env.vars),
        decls: env.decls,
        didx: env.didx,
        exp: env.exp,
        a: env.a,
    )
    env2.infer_expr(init)
}
global_ty = (env: Env, name: string_view) Ty {
    i := env.didx.global_idx.get(name, 0 - 1)
    (i >= 0 && i < env.decls.len).match ({
        true  => env.decls[i].match ({
            .DGlobal(g) => env.infer_global_init(g.name, g.init),
            _           => tvoid(),
        }),
        false => tvoid(),
    })
}
// a bare reference to a top-level function NAME is a first-class function value: its type is the
// function's FnT signature (its params + ret). This lets `f := some_fn` bind `f` to a fn value and
// `f()` call through it (an indirect call). Falls back after locals + globals so a same-named local wins.
fn_value_ty = (env: Env, name: string_view) Ty {
    f := env.env_func(name)
    eq(f.name, name).match ({ true => env.a.fnt_from_func_in(f), false => tvoid() })
}
global_or_fn = (env: Env, name: string_view) Ty {
    g := env.global_ty(name)
    g.is_void_ty().match ({ true => env.fn_value_ty(name), false => g })
}
// Membership check, distinct from type lookup; void-typed locals still count as bound.
var_bound* = (v: Ptr<VList>, name: string_view) bool {
    v.match ({
        .VNil     => false,
        .VCons(c) => eq(c.name, name).match ({ true => true, false => c.tail.var_bound(name) }),
    })
}
// LOCAL-scope membership ONLY (params + lets + arm/loop binds), excluding globals and top-level
// fns: the SHADOWING test. A fn's own params and locals shadow same-named top-level decls in its
// body (the emitted C scopes them that way), so call validation must consult this before any
// top-level name lookup.
ty_name = (t: Ty) string_view {
    t.match ({
        .Named(n) => n,
        _         => "",
    })
}
recv_name* = (t: Ty) string_view {
    t.match ({
        .I32           => "i32",
        .I64           => "i64",
        .U8            => "u8",
        .F64           => "f64",
        .Bool          => "bool",
        // String-family traits describe read-only behavior. All provenance variants dispatch
        // through the canonical view impl; the checker still keeps their value conversions distinct.
        .StringView    => "string_view",
        .StringCstr    => "string_view",
        .StringLiteral => "string_view",
        .Named(n)      => n,
        .Generic(g)    => g.mangled,
        .Ptr(pd)       => load(pd.pointee).recv_name(),
        _              => "",
    })
}
enum_name* = (t: Ty) string_view {
    t.match ({
        .Named(n)   => n,
        .Generic(g) => g.mangled,
        .Ptr(pd)    => load(pd.pointee).ty_name(),
        _           => "",
    })
}
ty_is_ptr = (t: Ty) bool {
    t.match ({
        .Ptr(pd) => true,
        _        => false,
    })
}
// is this generic the std `Vec<T>`? The flattened name is import-style dependent: a destructured
// `{ Vec } = ...` yields bare "Vec", a namespace alias `vec = ...` yields "vec__Vec" (deeper paths
// add more "__" segments). Match the bare name or any "…__Vec" suffix so both forms resolve.
ty_is_vec = (g: GenericData) bool { eq(g.name, "Vec") || g.name.ends_with("__Vec") }
// element type of an iterable receiver: a slice `[T]` yields T, and a `Vec<T>` (Generic over [T], a
// {ptr,len,cap} struct with an UNTYPED RawPtr buffer) yields its first type arg — so `.loop`/index
// over a Vec binds T from the receiver's generic param, not void.
elem_of = (t: Ty) Ty {
    t.match ({
        .Slice(e)   => load(e),
        .Generic(g) => (g.ty_is_vec() && g.args.len > 0).match ({
            true  => g.args[0],
            false => tvoid(),
        }),
        _           => tvoid(),
    })
}
enum_has = (ed: EnumDecl, vn: string_view) bool {
    f := false
    ed.variants.loop((h, i, v) {
        f = eq(v.name, vn).match ({ true => true, false => f })
    })
    f
}
pick_enum = (ed: EnumDecl, vn: string_view, found: string_view) string_view { ed.enum_has(vn).match ({
    true  => ed.name,
    false => found,
}) }
gen_enum_has = (g: GenEnumDecl, vn: string_view) bool {
    f := false
    g.variants.loop((h, i, v) {
        f = eq(v.name, vn).match ({ true => true, false => f })
    })
    f
}
// Find the enum, concrete or generic, that declares variant `vn`.
enum_of_variant = (decls: [Decl], vn: string_view) string_view {
    found := ""
    decls.loop((h, i, d) {
        found = d.match ({
            .DEnum(ed)   => ed.pick_enum(vn, found),
            .DGenEnum(g) => g.gen_enum_has(vn).match ({ true => g.name, false => found }),
            _            => found,
        })
    })
    found
}
named_has = (decls: [Decl], ename: string_view, vn: string_view) bool {
    found := false
    decls.loop((h, i, d) {
        found = d.match ({
            .DEnum(ed) => eq(ed.name, ename).match ({ true => ed.enum_has(vn), false => found }),
            _          => found,
        })
    })
    found
}
// The base enum name an expected/annotated type names: a generic instance (`Opt2<i32>`) wants its
// base `Opt2` (the GenEnumDecl key), not the mangled `Opt2_i32`; a plain enum its own name.
exp_enum_base = (t: Ty) string_view {
    t.match ({
        .Generic(g) => g.name,
        _           => t.enum_name(),
    })
}
// Constructor enum for a bare `.Foo` literal: the expected/annotated type WINS — try its concrete
// enum, then its generic enum (so an annotated `Opt2<i32>` disambiguates `.Some` from a stdlib `Opt`
// that shares the name) — only then fall back to scanning the ambient scope by variant name.
ctor_enum_plain = (env: Env, vn: string_view) string_view {
    base := env.exp.exp_enum_base()
    env.decls.named_has(base, vn).match ({
        true  => base,
        false => env.env_genenum(base).gen_enum_has(vn).match ({
            true  => base,
            false => env.decls.enum_of_variant(vn),
        }),
    })
}
// Infer expression types needed by resolve and validate.
fn_ret = (decls: [Decl], name: string_view) Ty { decls.the_func(name).ret }    // the_func's sentinel.ret is tvoid()
field_ty = (sd: StructDecl, fname: string_view) Ty {
    found := tvoid()
    sd.fields.loop((h, i, f) {
        found = eq(f.name, fname).match ({ true => f.ty, false => found })
    })
    found
}
struct_field = (decls: [Decl], sname: string_view, fname: string_view) Ty {
    found := tvoid()
    decls.loop((h, i, d) {
        found = d.match ({
            .DStruct(sd) => eq(sd.name, sname).match ({
                true  => sd.field_ty(fname),
                false => found,
            }),
            _            => found,
        })
    })
    found
}
// O(1) indexed struct-field lookup for the light/inline path.
is_cmp_op = (op: string_view) bool {
    // Bool-result ops; bitwise ops keep the lhs type.
    b := op.at(0)
    b1 := op.at(1)
    b == '=' || b == '!' || (b == '<' || b == '>') && b1 != b || (b == '&' || b == '|') && b1 == b
}
bin_ty* = (op: string_view, lt: Ty) Ty { op.is_cmp_op().match ({ true => tbool(), false => lt }) }
// A numeric binop's result is the WIDER operand (max integer rank), so `i32 + i64`
// is i64 regardless of operand order — kills silent truncation + order-dependence.
// A numeric LITERAL operand ADAPTS to the other side (it never forces widening), so
// idiomatic `c + 1` (u8 + int-lit) stays u8 and `'0' + n` keeps the non-literal's width.
// When a non-literal side lacks a rank (narrow Named widths, non-numeric) we keep lhs.
num_wider = (lt: Ty, rt: Ty) Ty {
    (lt.ty_rank() >= 0 && rt.ty_rank() >= 0).match ({
        true  => (rt.ty_rank() > lt.ty_rank()).match ({ true => rt, false => lt }),
        false => lt,
    })
}
num_result = (llit: bool, lt: Ty, rlit: bool, rt: Ty) Ty {
    llit.match ({
        true  => rlit.match ({ true => lt, false => rt }),
        false => rlit.match ({ true => lt, false => num_wider(lt, rt) }),
    })
}
bin_ty_e = (env: Env, b: BinData) Ty {
    b.op.is_cmp_op().match ({
        true  => tbool(),
        false => num_result(b.lhs.is_lit_numeric(), env.infer_expr(b.lhs), b.rhs.is_lit_numeric(), env.infer_expr(b.rhs)),
    })
}
// Numeric literals are polymorphic until a context fixes their size.
is_lit_numeric* = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Int(n)  => true,
        .Byte(n) => true,
        .Bin(b)  => b.op.is_cmp_op().match ({
            true  => false,
            false => b.lhs.is_lit_numeric() && b.rhs.is_lit_numeric(),
        }),
        .Cond(c) => c.t.is_lit_numeric() && c.e.is_lit_numeric(),
        _        => false,
    })
}
// Numeric literals adapt to the other branch. All other branches use the same least-upper-bound
// calculation as enum matches, so result typing never depends on arm order.
cond_ty = (env: Env, d: CondData) Ty {
    d.t.is_lit_numeric().match ({
        true  => env.infer_expr(d.e),
        false => d.e.is_lit_numeric().match ({
            true  => env.infer_expr(d.t),
            false => env.infer_expr(d.t).common_ty(env.infer_expr(d.e)),
        }),
    })
}
// Generic enum constructors: compute base enum, type args, and mangled concrete name.
EnumInst*: {
    base: string_view,
    mty: string_view,
    targs: [Ty],
}
gen_variant_payload* = (g: GenEnumDecl, vname: string_view) Ty {
    found := tvoid()
    g.variants.loop((h, i, v) {
        found = eq(v.name, vname).match ({ true => v.payload, false => found })
    })
    found
}
infer_enum_targs = (env: Env, g: GenEnumDecl, variant: string_view, pty: Ty) [Ty] {
    vpt := g.gen_variant_payload(variant)
    buf := cbuf<Ty>(env.a, g.tparams.len)
    g.tparams.loop((h, i, tp) {
        buf[i] = vpt.unify_ty(pty, tp.name)
    })
    buf
}
enum_inst_payload = (env: Env, g: GenEnumDecl, base: string_view, variant: string_view, pty: Ty) EnumInst {
    ta := env.infer_enum_targs(g, variant, pty)
    EnumInst(
        base: base,
        mty: env.a.mangle_str_in(base, ta),
        targs: ta,
    )
}
enum_inst_gen = (env: Env, g: GenEnumDecl, base: string_view, variant: string_view, pty: Ty) EnumInst {
    env.exp.match ({
        .Generic(ge) => eq(ge.name, base).match ({
            true  => EnumInst(
                base: base,
                mty: ge.mangled,
                targs: ge.args,
            ),
            false => env.enum_inst_payload(g, base, variant, pty),
        }),
        _            => env.enum_inst_payload(g, base, variant, pty),
    })
}
enum_inst_of = (env: Env, base: string_view, variant: string_view, pty: Ty) EnumInst {
    g := env.env_genenum(base)
    eq(g.name, "").match ({
        true  => EnumInst(
            base: base,
            mty: base,
            targs: no_tys(),
        ),
        false => env.enum_inst_gen(g, base, variant, pty),
    })
}    // a non-generic enum
enum_inst_mk = (env: Env, variant: string_view, payload: Ptr<Expr>) EnumInst { env.enum_inst_of(env.ctor_enum_plain(variant), variant, env.infer_expr(payload)) }
enum_inst_tag = (env: Env, variant: string_view) EnumInst { env.enum_inst_of(env.ctor_enum_plain(variant), variant, tvoid()) }
// Block expressions take their trailing expression/return type.
last_stmt_ty = (env: Env, stmts: [Stmt]) Ty {
    stmts[stmts.len - 1].match ({
        .ExprStmt(e) => env.infer_expr(e),
        .Return(r)   => env.infer_expr(r),
        _            => tvoid(),
    })
}
// A value-position Block whose LAST statement is an explicit `return` DIVERGES — it yields no value
// (control leaves the fn), so it contributes NO type constraint: a match/cond with such an arm takes
// its type from the OTHER arms. Only arm/loop blocks can look like this; fn/lambda BODIES (where the
// parser's implicit trailing return IS the value) are typed as [Stmt] via block_ty_from directly and
// keep last_stmt_ty's Return-as-value rule. See genc.blk_diverges.
block_ty_from = (env: Env, stmts: [Stmt], i: i32) Ty {
    (i >= stmts.len).match ({
        true  => tvoid(),
        false => (i == stmts.len - 1).match ({
            true  => env.last_stmt_ty(stmts),
            false => env.a.extend_env(env, stmts[i]).block_ty_from(stmts, i + 1),
        }),
    })
}
// Prefer a concrete stored index element type; generic inlining may make re-inference lose it.
index_elem = (env: Env, ix: IndexData) Ty { ix.elem.is_void_ty().match ({
    true  => env.infer_expr(ix.seq).elem_of(),
    false => ix.elem,
}) }
pointee_of = (t: Ty) Ty {
    t.match ({
        .Ptr(pd) => load(pd.pointee),
        _        => tvoid(),
    })
}
// Generic calls infer type args from arguments, then use the expected return type
// for params that only appear in the result.
// Binding strength: an untyped numeric or string LITERAL is the WEAKEST source — a typed arg
// (receiver, annotated local) or the expected return type must not be overridden by a literal's
// default width/provenance. `lits` selects which pass this scan is: false = typed args only,
// true = literals only (the last resort).
is_weak_targ_arg* = (e: Ptr<Expr>) bool {
    e.is_lit_numeric() || load(e).match ({
        .StrLit(s) => true,
        _          => false,
    })
}
is_direct_tparam* = (t: Ty, tp: string_view) bool {
    t.match ({
        .Named(n) => eq(n, tp),
        _         => false,
    })
}
weak_targ_env = (env: Env, pty: Ty, arg: Ptr<Expr>, tp: string_view) bool { arg.is_weak_targ_arg() || pty.is_direct_tparam(tp) && env.infer_expr(arg).is_str_t() }
// A lambda arg has no inferrable value type (infer_expr -> void). When a tparam sits in the closure's
// RETURN position `(T) U`, bind it from the lambda's DECLARED return type so it never defaults to void.
unify_arg = (env: Env, pty: Ty, arg: Ptr<Expr>, tp: string_view) Ty {
    load(arg).match ({
        .Lambda(lm) => pty.lam_ret_unify(lm, tp),
        _           => pty.unify_ty(env.infer_expr(arg), tp),
    })
}
lam_ret_unify = (pty: Ty, lm: LambdaData, tp: string_view) Ty {
    pty.match ({
        .FnT(ft) => lm.ret.is_void_ty().match ({
            true  => tvoid(),
            false => load(ft.ret).unify_ty(lm.ret, tp),
        }),
        _        => tvoid(),
    })
}
ret_targ_of = (env: Env, ret: Ty, tp: string_view) Ty { env.exp.is_void_ty().match ({
    true  => tvoid(),
    false => ret.unify_ty(env.exp, tp),
}) }
// etargs = explicit turbofish type args (empty when none): a present one PINS the i-th tparam,
// overriding inference; an absent one (i past etargs) falls back to inferring from the value args.
// After the per-tparam pass, still-void targs get the two deep fallbacks (see deep_targs): a lambda
// arg's BODY type for a closure-return tparam, and a co-targ's generic-trait impl — the env-typed
// mirror of the inliner's post-pass, so resolve (let typing, mono_rec instances) agrees with it.
// env-typed twin of deep_targs (the resolver types lambda bodies with the full Env, not light types).
deep_targs_env = (env: Env, tparams: [Param], buf: [Ty], params: [Param], args: [Expr]) [Ty] {
    tparams.loop((h, i, tp) {
        buf[i] = buf[i].is_void_ty().match ({
            true  => env.lam_body_targ_env(tparams, buf, params, args, tp.name),
            false => buf[i],
        })
    })
    tparams.loop((h, i, tp) {
        buf[i] = buf[i].is_void_ty().match ({
            true  => env.a.impl_trait_targ(env.decls, env.didx, tparams, buf, tp.name),
            false => buf[i],
        })
    })
    buf
}
lam_body_targ_env = (env: Env, tparams: [Param], targs: [Ty], params: [Param], args: [Expr], tp: string_view) Ty {
    found := tvoid()
    params.loop((h, i, p) {
        found = found.is_void_ty().match ({
            true  => (i < args.len).match ({
                true  => env.lam_body_one_env(tparams, targs, p.ty, args[i].addr(), tp),
                false => found,
            }),
            false => found,
        })
    })
    found
}
lam_body_one_env = (env: Env, tparams: [Param], targs: [Ty], pty: Ty, arg: Ptr<Expr>, tp: string_view) Ty {
    pty.match ({
        .FnT(ft) => load(arg).match ({
            .Lambda(lm) => (lm.ret.is_void_ty() && load(ft.ret).ty_mentions(tp)).match ({
                true  => {
                    vars := env.vars
                    lm.params.loop((h, k, lp) {
                        vars = env.a.vcons(lp.name, (k < ft.params.len).match ({
                            true  => env.a.subst_ty_in(tparams, targs, ft.params[k]),
                            false => tvoid(),
                        }), vars)
                    })
                    env2 := Env(
                        vars: vars,
                        decls: env.decls,
                        didx: env.didx,
                        exp: tvoid(),
                        a: env.a,
                    )
                    bty := env2.block_ty_from(lm.body, 0)
                    (bty.is_void_ty() || bty.ty_mentions_any(tparams)).match ({
                        true  => tvoid(),
                        false => load(ft.ret).unify_ty(bty, tp),
                    })
                },
                false => tvoid(),
            }),
            _           => tvoid(),
        }),
        _        => tvoid(),
    })
}
// UFCS trait dispatch: route `x.m()` to the receiver type's impl when one exists.
method_in = (methods: [Param], fn: string_view) bool {
    f := false
    methods.loop((h, i, n) {
        f = eq(n.name, fn).match ({ true => true, false => f })
    })
    f
}
dispatch_recv* = (a: MutPtr<Malloc>, decls: [Decl], didx: DeclIndex, fn: string_view, tyname: string_view) string_view {
    // O(1): dispatch_idx holds the LAST impl of `tyname` providing `fn` (directly or via a trait
    // default) — the same verdict the old whole-decls scan accumulated.
    i := didx.dispatch_idx.get(a.tdkey(tyname, fn), 0 - 1)
    (i >= 0 && i < decls.len).match ({
        true  => decls[i].match ({
            .DImpl(im) => a.impl_cname_in(im.trname, im.ty, fn),
            _          => fn,
        }),
        false => fn,
    })
}
dispatch_recv_name* = (t: Ty) string_view {
    t.match ({
        .Generic(g) => g.name,
        .Ptr(pd)    => load(pd.pointee).dispatch_recv_name(),
        _           => t.recv_name(),
    })
}
// A slice receiver (`[u8]`, possibly behind a pointer) has no head name but IS dispatchable — the
// `fits`-based candidate scan keys on the element type instead.
is_slice_recv = (t: Ty) bool {
    t.match ({
        .Slice(e) => true,
        .Ptr(pd)  => load(pd.pointee).is_slice_recv(),
        _         => false,
    })
}
// Can this receiver drive UFCS-alias dispatch? Anything with a concrete head, plus slices (whose head
// is empty). Bails on void/unknown/pre-inline-tparam receivers, exactly as before for non-slices.
alias_recv_dispatchable = (t: Ty) bool { is_empty(t.dispatch_recv_name()).match ({
    true  => t.is_slice_recv(),
    false => true,
}) }
// Compiler-level call intrinsics (typed in infer_call / lowered by genc). Lives here — not in
// check_validate, which now imports it — so the alias-UFCS fallback below can refuse to shadow them.
is_intrinsic* = (fn: string_view) bool {
    eq(fn, "load").match ({
        true  => true,
        false => eq(fn, "store").match ({
            true  => true,
            false => eq(fn, "addr").match ({
                true  => true,
                false => eq(fn, "assert_nonnull").match ({
                    true  => true,
                    false => eq(fn, "offset").match ({
                        true  => true,
                        false => eq(fn, "cstr").match ({
                            true  => true,
                            false => eq(fn, "slice").match ({
                                true  => true,
                                false => eq(fn, "malloc").match ({
                                    true  => true,
                                    false => eq(fn, "sizeof").match ({
                                        true  => true,
                                        false => eq(fn, "load_i64").match ({
                                            true  => true,
                                            false => eq(fn, "store_i64").match ({
                                                true  => true,
                                                false => eq(fn, "atomic_add_i64").match ({
                                                    true  => true,
                                                    false => eq(fn, "atomic_load_i64").match ({
                                                        true  => true,
                                                        false => eq(fn, "atomic_store_i64").match ({
                                                            true  => true,
                                                            false => eq(fn, "atomic_cas_i64").match ({
                                                                true  => true,
                                                                false => eq(fn, "atomic_fence").match ({
                                                                    true  => true,
                                                                    false => eq(fn, "null_ptr").match ({
                                                                        true  => true,
                                                                        false => eq(fn, "__str_eq").match ({
                                                                            true  => true,
                                                                            false => eq(fn, "__str_ne").match ({
                                                                                true  => true,
                                                                                false => eq(fn, "to_i32").match ({
                                                                                    true  => true,
                                                                                    false => eq(fn, "to_i64").match ({
                                                                                        true  => true,
                                                                                        false => eq(fn, "to_u8").match ({
                                                                                            true  => true,
                                                                                            false => eq(fn, "to_f64").match ({
                                                                                                true  => true,
                                                                                                false => false,
                                                                                            }),
                                                                                        }),
                                                                                    }),
                                                                                }),
                                                                            }),
                                                                        }),
                                                                    }),
                                                                }),
                                                            }),
                                                        }),
                                                    }),
                                                }),
                                            }),
                                        }),
                                    }),
                                }),
                            }),
                        }),
                    }),
                }),
            }),
        }),
    })
}
// ── UFCS THROUGH MODULE ALIASES ──────────────────────────────────────────────────────────────────
// `m = std.collections.hmap` binds hmap's top-level fns as `m__put`/`m__get`/… in the flat program,
// so `x.put(k, v)` (desugared to `put(x, k, v)`) used to resolve ONLY when `put` was flat-imported —
// forcing flat imports and their name-collision trap. When a called name is otherwise UNDEFINED,
// search the alias-prefixed decls whose tail is the method name and whose FIRST parameter's head
// type matches the receiver's inferred head type (deterministic: decl order):
//   exactly one → dispatch_name routes the call to it (resolve_call then rewrites, as for traits);
//   two or more → the call stays unresolved; the validator reports the positioned undefined-name
//   error and denrich_ambiguous_msg (check_validate) names the candidates.
// Guards keep this a pure FALLBACK — it never fires for intrinsics, known top-level fns, locally
// bound names (locals shadow, #370), value globals, receivers without a concrete head type
// (pre-inline tparam receivers), or candidates whose first-param head is their OWN tparam — so no
// program that resolves today changes meaning, and rejected programs can only gain a resolution.
AliasCands*: {
    count: i32,
    first: string_view,
    second: string_view,
}
alias_cands_none = () AliasCands {
    AliasCands(
        count: 0,
        first: "",
        second: "",
    )
}
tparam_names_have = (tps: [Param], name: string_view) bool {
    f := false
    tps.loop((h, i, tp) {
        f = eq(tp.name, name).match ({ true => true, false => f })
    })
    f
}
// VISIBILITY: only `*`-exported names are UFCS-reachable through an alias. Alias-prefixed publics
// keep their star in the FLAT source (`g__scale* = …`), and parse_module records every starred
// top-level name (compiler.parse exports_get) — membership there means the aliased module exported
// it. Private alias decls (`g__hidden = …`) exist for the module's own internals but never match.
alias_name_is_pub = (name: string_view) bool {
    f := false
    exports_get().loop((h, i, p) {
        f = eq(p.name, name).match ({ true => true, false => f })
    })
    f
}
// is `f` an alias-prefixed candidate for method `fn` on receiver `rty`? Common gates: real alias
// prefix (never a phantom `foo__grow`), tail == the method, `*`-exported, and first-param head is not
// the fn's OWN tparam. `exact` selects param0-compat: exact head-string equality (pass 1) vs the same
// receiver→param0 coercion the normal call path uses (`fits` — i32→i64, slice→slice, …) in pass 2.
alias_cand_matches = (f: Func, fn: string_view, rty: Ty, exact: bool) bool {
    sep := f.name.alias_sep()
    (sep > 0 && f.params.len > 0 && f.name.alias_is_real_prefix() && eq(f.name.alias_tail(sep), fn) && f.name.alias_name_is_pub()).match ({
        true  => {
            p0 := f.params[0].ty
            head := p0.dispatch_recv_name()
            (f.tparams.tparam_names_have(head) == false).match ({
                true  => exact.match ({
                    true  => is_empty(head).match ({
                        true  => false,
                        false => eq(head, rty.dispatch_recv_name()),
                    }),
                    false => rty.fits(p0),
                }),
                false => false,
            })
        },
        false => false,
    })
}
// Sig-driven enumeration (B4/R3): candidates come from the per-alias export sigs the resolver
// stamped into the compiler.parse registry, not from shape-scanning every flat decl. Only entries
// mirroring the names the resolver actually PREFIXED can produce a candidate — value decls of the
// aliased module (not imported pass-throughs, not foreign, not types: exactly the
// value_decl_names_in filter), reconstructed as `alias__name` and resolved to the real decl through
// func_idx (DFunc and DForeign alike). Every semantic gate (real-prefix, tail, `*`-export via the
// flat's star markers, param0 head/tparam/fits) stays in alias_cand_matches, applied to the SAME
// Func the old scan matched, so a candidate's verdict is unchanged — only the enumeration is new.
// Registry order is flat append order and a module's symbols are in decl order, so the deterministic
// decl-order tie-break (first/second in the ambiguity message) is preserved. The cheap prefilter is
// safe: the dispatcher's tail (after the LAST `__` of `alias__name`) is always a suffix of the
// module-side name, so a non-suffix entry can never match and is skipped without allocating.
// Intentional divergence from the shape scan: a USER-written `alias__method` decl that the aliased
// module does not export (main-body or brace-imported, merely SHAPED like an alias decl) is no
// longer a candidate — the alias's method namespace is closed to the module's real exports.
alias_cands_scan = (env: Env, fn: string_view, rty: Ty, exact: bool) AliasCands {
    cnt := 0
    first := ""
    second := ""
    module_sigs_get().loop((h, i, e) {
        (e.sig_imported() == false && e.sig_foreign() == false && e.sig_type() == false && e.name.ends_with(fn)).then({
            fname := env.a.gstr_string(32).gstr_append(env.a, e.alias).gstr_append(env.a, "__").gstr_append(env.a, e.name).gstr_finish(env.a)
            f := env.env_func(fname)
            (is_empty(f.name) == false && f.alias_cand_matches(fn, rty, exact)).then({
                second = (cnt == 1).match ({ true => f.name, false => second })
                first = (cnt == 0).match ({ true => f.name, false => first })
                cnt = cnt + 1
            })
        })
    })
    AliasCands(
        count: cnt,
        first: first,
        second: second,
    )
}
// Two-pass for determinism: exact head-type matches first; only when ZERO exact matches exist do we
// fall back to coercible receivers (i32→i64, slice receivers). The count==1-else-ambiguity rule holds
// per pass, so an exact unique winner is never masked by a coercible one.
fnt_ret = (t: Ty) Ty {
    t.match ({
        .FnT(ft) => load(ft.ret),
        _        => tvoid(),
    })
}
gen_call_ret = (env: Env, c: CallData) Ty {
    dn := env.dispatch_name(c)
    f := env.env_func(dn)
    eq(f.name, "").match ({
        true  => env.var_or_global(c.fn).fnt_ret(),
        false => (f.tparams.len > 0).match ({
            true  => env.a.subst_ty_in(f.tparams, env.call_targs(f, c.args, c.targs), f.ret),
            false => f.ret,
        }),
    })
}
// not a known function: an INDIRECT call through a function-VALUE (a fn-valued local or field
// bound to a local) — its result type is the value's FnT return type.
// Bounds-safe operand inference for 1-arg intrinsics.
arg0_ty = (env: Env, c: CallData) Ty { (c.args.len > 0).match ({
    true  => env.infer_expr(c.args[0].addr()),
    false => tvoid(),
}) }
addr_ty = (env: Env, c: CallData) Ty {
    base := env.arg0_ty(c)
    readonly := (c.args.len > 0).match ({
        true  => env.lvalue_writes_readonly(c.args[0].addr()),
        false => false,
    })
    tptr_k(env.a.tnode(base), readonly.match ({ true => k_ptr(), false => k_mut_ptr() }))
}
// `assert_nonnull` proves nullability, not writability: RawPtr<T> narrows to MutPtr<T>, while an
// already-non-null Ptr<T>/MutPtr<T> keeps its direction capability unchanged.
nonnull_ty = (t: Ty) Ty {
    t.match ({
        .Ptr(pd) => (pd.kind == k_raw_ptr()).match ({
            true  => tptr_k(pd.pointee, k_mut_ptr()),
            false => t,
        }),
        _        => tvoid(),
    })
}
// Constructor types keep generic args so later match-arm binds recover concrete payload types.
einst_ty = (ei: EnumInst) Ty { (ei.targs.len > 0).match ({
    true  => tgeneric(ei.base, ei.targs, ei.mty),
    false => tnamed(ei.mty),
}) }
mkenum_ty = (env: Env, mk: MakeEnumData) Ty {
    eq(mk.mty, "").match ({
        true  => env.enum_inst_mk(mk.variant, mk.payload).einst_ty(),
        false => (mk.targs.len > 0).match ({
            true  => tgeneric(mk.ty, mk.targs, mk.mty),
            false => tnamed(mk.mty),
        }),
    })
}
tag_ty = (env: Env, t: TagData) Ty {
    eq(t.mty, "").match ({
        true  => env.enum_inst_tag(t.variant).einst_ty(),
        false => (t.targs.len > 0).match ({
            true  => tgeneric(t.ty, t.targs, t.mty),
            false => tnamed(t.mty),
        }),
    })
}
// Generic struct field reads substitute the receiver's concrete type args.
gen_field_at = (fields: [Field], fname: string_view) Ty {
    found := tvoid()
    fields.loop((h, i, f) {
        found = eq(f.name, fname).match ({ true => f.ty, false => found })
    })
    found
}
gen_struct_field = (a: MutPtr<Malloc>, decls: [Decl], gname: string_view, fname: string_view, targs: [Ty]) Ty {
    found := tvoid()
    decls.loop((h, i, d) {
        found = d.match ({
            .DGenStruct(gsd) => eq(gsd.name, gname).match ({
                true  => a.subst_ty_in(gsd.tparams, targs, gsd.fields.gen_field_at(fname)),
                false => found,
            }),
            _                => found,
        })
    })
    found
}
ty_under_ptr* = (t: Ty) Ty {
    t.match ({
        .Ptr(pd) => load(pd.pointee),
        _        => t,
    })
}
slice_member* = (a: MutPtr<Malloc>, field: string_view) Ty {
    eq(field, "len").match ({
        true  => ti64(),
        false => eq(field, "ptr").match ({ true => tptr(a.tnode(tu8())), false => tvoid() }),
    })
}
// Field-type inference, auto-deref'd. Shared by `obj.field` (Member) and `obj->field` (Arrow); the
// latter exists because resolve_member rewrites a pointer receiver to Arrow, and a later re-resolve
// (e.g. dispatch on a generic-struct field receiver in an inlined template body) must re-infer it.
infer_field = (env: Env, oty: Ty, field: string_view) Ty {
    oty.ty_under_ptr().match ({
        .Generic(g) => env.didx.idx_genstruct_field(env.a, env.decls, g.name, field, g.args),
        .Slice(e)   => env.a.slice_member(field),
        _           => env.didx.idx_struct_field(env.decls, oty.enum_name(), field),
    })
}
infer_member = (env: Env, m: MemberData) Ty { env.infer_field(env.infer_expr(m.obj), m.field) }
infer_arrow = (env: Env, ar: ArrowData) Ty { env.infer_field(env.infer_expr(ar.obj), ar.field) }
infer_arm_ty = (env: Env, subjty: Ty, ar: ArmData) Ty { env.a.arm_env(env, subjty, ar).infer_expr(ar.body) }
// Least common result type. `ty_eq(got, want)` is directional: literal fits cstr/view and cstr fits
// view, never the reverse. Therefore when `a` fits `b`, the safe join is the broader `b`; choosing
// `a` would launder a borrowed arm into immortal `string_literal` provenance.
common_ty* = (a: Ty, b: Ty) Ty {
    a.is_void_ty().match ({
        true  => b,
        false => b.is_void_ty().match ({
            true  => a,
            false => (a.ty_rank() >= 0 && b.ty_rank() >= 0).match ({
                true  => (a.ty_rank() == 0).match ({
                    true  => b,
                    false => (a.ty_rank() == 1).match ({
                        true  => (b.ty_rank() > 1).match ({ true => b, false => a }),
                        false => a,
                    }),
                }),
                false => a.ty_eq(b).match ({
                    true  => b,
                    false => b.ty_eq(a).match ({ true => a, false => tvoid() }),
                }),
            }),
        }),
    })
}
infer_match_common_ty = (env: Env, subjty: Ty, arms: [ArmData]) Ty {
    out := tvoid()
    arms.loop((h, i, ar) {
        out = out.common_ty(env.infer_arm_ty(subjty, ar))
    })
    out
}
infer_match_ty = (env: Env, m: MatchData) Ty {
    subjty := env.infer_expr(m.subj)
    env.infer_match_common_ty(subjty, m.arms)
}
// Stamp enum constructors with their concrete generic instance when needed.
resolve_mkenum = (a: MutPtr<Malloc>, env: Env, ety: string_view, emty: string_view, etargs: [Ty], variant: string_view, payload: Ptr<Expr>) Ptr<Expr> {
    p := a.resolve_expr(env.clr_exp(), payload)
    (etargs.len > 0).match ({
        true  => {
            p2 := a.restamp_enum_payload(env, ety, etargs, variant, p)
            a.cenode(mkenumg(ety, emty, etargs, variant, p2))
        },
        false => eq(ety, "").match ({
            true  => a.resolve_mkenum_fresh(env, variant, p),
            false => a.cenode(mkenumg(ety, emty, no_tys(), variant, p)),
        }),
    })
}
resolve_mkenum_fresh = (a: MutPtr<Malloc>, env: Env, variant: string_view, p: Ptr<Expr>) Ptr<Expr> {
    inst := env.enum_inst_mk(variant, p)
    p2 := a.restamp_enum_payload(env, inst.base, inst.targs, variant, p)
    a.cenode(mkenumg(inst.base, inst.mty, inst.targs, variant, p2))
}
// A multi-field variant payload lowers to a positional anon struct whose tparams mirror the enum's.
// resolve_genlit_bare infers the anon instance from the literal init types (integer literals → i32),
// which can disagree with the enum instance (Tree<i64>, Two<i32,i64>). Re-stamp the payload
// MakeStruct with the monomorphized payload type from the enum's tparam→arg map — same rebuild as
// compiler.mono.mono_payload, but on the constructor side so collect_ty discovers one instance.
restamp_enum_payload = (a: MutPtr<Malloc>, env: Env, ename: string_view, etargs: [Ty], variant: string_view, p: Ptr<Expr>) Ptr<Expr> {
    load(p).match ({
        .MakeStruct(sd) => env.enum_payload_mono_ty(ename, etargs, variant).match ({
            .Generic(cg) => eq(cg.name, sd.ty).match ({
                true  => a.cenode(mkstructg_at(sd.ty, cg.mangled, cg.args, sd.inits, sd.pos)),
                false => p,
            }),
            _            => p,
        }),
        _               => p,
    })
}
resolve_mktag = (a: MutPtr<Malloc>, env: Env, ety: string_view, emty: string_view, etargs: [Ty], variant: string_view) Ptr<Expr> {
    (etargs.len > 0).match ({
        true  => a.emit_tag_or_default(env, ety, emty, etargs, variant),
        false => eq(ety, "").match ({
            true  => a.resolve_mktag_fresh(env, variant),
            false => a.emit_tag_or_default(env, ety, emty, no_tys(), variant),
        }),
    })
}
resolve_mktag_fresh = (a: MutPtr<Malloc>, env: Env, variant: string_view) Ptr<Expr> {
    inst := env.enum_inst_tag(variant)
    a.emit_tag_or_default(env, inst.base, inst.mty, inst.targs, variant)
}
// A zero-arg `.Name` / `Type.Name`: if the variant declares a default (`Name = expr`), build the
// payload constructor with the baked-in constant; otherwise the bare tag.
emit_tag_or_default = (a: MutPtr<Malloc>, env: Env, base: string_view, mty: string_view, targs: [Ty], variant: string_view) Ptr<Expr> {
    def := env.didx.idx_variant_default(env.decls, base, variant)
    def.is_expr_null().match ({
        true  => a.cenode(mktagg(base, mty, targs, variant)),
        false => {
            p := a.resolve_expr(env.clr_exp(), def)
            p2 := a.restamp_enum_payload(env, base, targs, variant, p)
            a.cenode(mkenumg(base, mty, targs, variant, p2))
        },
    })
}
// Keep concrete slice element types across re-resolve.
keep_elem = (env: Env, existing: Ty, seq: Ptr<Expr>) Ty { existing.is_void_ty().match ({
    true  => env.infer_expr(seq).elem_of(),
    false => existing,
}) }
// For index assignment, fall back to the stored value's type when the sequence elem is unknown.
set_elem = (env: Env, existing: Ty, seq: Ptr<Expr>, value: Ptr<Expr>) Ty {
    e := env.keep_elem(existing, seq)
    e.is_void_ty().match ({ true => env.infer_expr(value), false => e })
}
// Generic struct constructor monomorphization. A literal `Scope<A>(alloc: x)` carries the type-param
// `A` verbatim as its targ; infer the concrete arg from the field-init types so the instance mangles
// to `Scope_SyncArena` and field reads/dispatch (`s.alloc.acquire`) resolve to the concrete impl.
gstruct_of = (decls: [Decl], name: string_view) GenStructDecl {
    found := GenStructDecl(
        name: "",
        tparams: slice(null_ptr(), 0),
        fields: slice(null_ptr(), 0),
    )
    decls.loop((h, i, d) {
        found = d.match ({
            .DGenStruct(g) => eq(g.name, name).match ({ true => g, false => found }),
            _              => found,
        })
    })
    found
}
has_tparam* = (tparams: [Param], n: string_view) bool {
    f := false
    tparams.loop((h, i, tp) {
        f = eq(tp.name, n).match ({ true => true, false => f })
    })
    f
}
// A written targ that is just the struct's own type-param name (e.g. literal `A`) needs inference.
is_placeholder_targ = (tparams: [Param], t: Ty) bool {
    t.match ({
        .Named(n) => tparams.has_tparam(n),
        _         => false,
    })
}
init_field_ty = (env: Env, inits: [FieldInit], fname: string_view) Ty {
    found := tvoid()
    inits.loop((h, i, fi) {
        found = eq(fi.name, fname).match ({ true => env.infer_expr(fi.value), false => found })
    })
    found
}
// Unify each declared field type against its init's inferred type to recover one tparam's concrete arg.
struct_targ_one = (env: Env, fields: [Field], inits: [FieldInit], tp: string_view) Ty {
    found := tvoid()
    fields.loop((h, i, f) {
        found = found.is_void_ty().match ({
            true  => f.ty.unify_ty(env.init_field_ty(inits, f.name), tp),
            false => found,
        })
    })
    found
}
pick_targ = (inf: Ty, fallback: Ty) Ty { inf.is_void_ty().match ({ true => fallback, false => inf }) }
infer_struct_targs = (a: MutPtr<Malloc>, env: Env, gsd: GenStructDecl, written: [Ty], inits: [FieldInit]) [Ty] {
    buf := cbuf<Ty>(a, written.len)
    written.loop((h, i, t) {
        buf[i] = (i < gsd.tparams.len && gsd.tparams.is_placeholder_targ(t)).match ({
            true  => env.struct_targ_one(gsd.fields, inits, gsd.tparams[i].name).pick_targ(t),
            false => t,
        })
    })
    buf
}
genlit_g = (a: MutPtr<Malloc>, env: Env, sd: MakeStructData, inits: [FieldInit]) Ptr<Expr> {
    nt := a.infer_struct_targs(env, env.env_gstruct(sd.ty), sd.targs, inits)
    a.cenode(mkstructg_at(sd.ty, a.mangle_str_in(sd.ty, nt), nt, inits, sd.pos))
}
// the expected type's args, when it names generic struct `base` — the authoritative source for a bare
// literal's type args under a `st: Store<AppState> := …` annotation (or any expected-type position).
exp_targs_for = (exp: Ty, base: string_view) [Ty] {
    exp.match ({
        .Generic(g) => eq(g.name, base).match ({ true => g.args, false => no_tys() }),
        _           => no_tys(),
    })
}
// Type args for a BARE generic-struct literal (no explicit `<…>`): the expected/annotation type wins,
// else infer each tparam by unifying its declared field types against the supplied field-value types.
bare_struct_targs = (a: MutPtr<Malloc>, env: Env, gsd: GenStructDecl, inits: [FieldInit]) [Ty] {
    exp_args := env.exp.exp_targs_for(gsd.name)
    (exp_args.len == gsd.tparams.len).match ({
        true  => exp_args,
        false => {
            buf := cbuf<Ty>(a, gsd.tparams.len)
            gsd.tparams.loop((h, i, tp) {
                buf[i] = env.struct_targ_one(gsd.fields, inits, tp.name)
            })
            buf
        },
    })
}
// A bare `Store(state: …)` literal of a GENERIC struct carries no type args; infer them so the instance
// is mangled (mty) and discovered/emitted by compiler.mono, exactly like the explicit `Store<…>(…)` form.
// A bare literal of a plain (non-generic) struct is unchanged.
resolve_genlit_bare = (a: MutPtr<Malloc>, env: Env, sd: MakeStructData, inits: [FieldInit]) Ptr<Expr> {
    gsd := env.env_gstruct(sd.ty)
    is_empty(gsd.name).match ({
        true  => a.cenode(mkstructg_at(sd.ty, sd.mty, sd.targs, inits, sd.pos)),
        false => {
            nt := a.bare_struct_targs(env, gsd, inits)
            a.cenode(mkstructg_at(sd.ty, a.mangle_str_in(sd.ty, nt), nt, inits, sd.pos))
        },
    })
}
resolve_genlit = (a: MutPtr<Malloc>, env: Env, sd: MakeStructData) Ptr<Expr> {
    inits := a.resolve_inits(env.clr_exp(), sd.inits)
    (sd.targs.len > 0).match ({
        true  => a.genlit_g(env, sd, inits),
        false => a.resolve_genlit_bare(env, sd, inits),
    })
}
// Rebuild expressions with resolved enum, constructor, member, and loop metadata.
// Entry hook: an expression that still holds unconditional-position `.or_return()` calls (only
// possible in CONDITIONALLY-evaluated positions — cond/match branch values, `&&`/`||` right
// operands — since fill_orx already hoisted every statement-level occurrence) is wrapped into a
// value block scoped to that branch. See the "or_return in EXPRESSION position" section below.
resolve_expr = (a: MutPtr<Malloc>, env: Env, e: Ptr<Expr>) Ptr<Expr> { (e.orx_count() > 0).match ({
    true  => a.resolve_orx(env, e),
    false => a.resolve_expr_plain(env, e),
}) }
resolve_expr_plain = (a: MutPtr<Malloc>, env: Env, e: Ptr<Expr>) Ptr<Expr> {
    load(e).match ({
        .Match(m)       => a.resolve_match(env, m),
        .MakeEnum(mk)   => a.resolve_mkenum(env, mk.ty, mk.mty, mk.targs, mk.variant, mk.payload),
        .Tag(t)         => a.resolve_mktag(env, t.ty, t.mty, t.targs, t.variant),
        .Bin(b)         => a.resolve_bin(env, b),
        .Cond(c)        => a.cenode(cond_oa(a.resolve_expr(env.clr_exp(), c.c), a.resolve_expr(env, c.t), a.resolve_expr(env, c.e), c.oa)),
        .Call(c)        => a.resolve_call(env, c),
        .Member(mm)     => a.resolve_member(env, mm),
        // An Arrow (a pass-1 Member→Arrow conversion) must keep resolving its OBJECT on later passes:
        // a generic call inside it is only rewritten to its mono instance by the FINAL resolve (the
        // instance decls don't exist earlier), and with no Arrow case that call stayed a bare
        // template name (`counter.actor().n` emitted an undefined C symbol).
        .Arrow(ar)      => a.cenode(arrow_at(a.resolve_expr(env.clr_exp(), ar.obj), ar.field, ar.pos)),
        .MakeStruct(sd) => a.resolve_genlit(env, sd),
        .Index(ix)      => a.cenode(eindex(a.resolve_expr(env.clr_exp(), ix.seq), a.resolve_expr(env.clr_exp(), ix.idx), env.keep_elem(ix.elem, ix.seq))),
        .Loop(l)        => a.resolve_loop(env, l),
        .SliceLit(sd)   => a.resolve_slicelit(env, sd),
        .Block(b)       => a.cenode(block(a.resolve_value_body(env, b.stmts))),
        _               => e,
    })
}
// Slice literal element type: an expected `[T]` (declared/annotated) WINS, so a bare-int literal
// `[1,2,3]` adopts the declared element width (`i64`/`u8`) instead of defaulting to i32 — the same
// expected-type propagation a scalar int slot already gets. Falls back to the first item's type.
sl_elem = (env: Env, items: [Expr]) Ty { (items.len == 0).match ({
    true  => tvoid(),
    false => env.infer_expr(items[0].addr()),
}) }
resolve_slicelit = (a: MutPtr<Malloc>, env: Env, sd: SliceData) Ptr<Expr> {
    et := env.sl_elem_exp(sd.items)
    a.cenode(slit(et, a.resolve_args(env.with_exp(et), sd.items)))
}
// Field access auto-derefs pointer receivers.
resolve_member = (a: MutPtr<Malloc>, env: Env, mm: MemberData) Ptr<Expr> {
    obj := a.resolve_expr(env.clr_exp(), mm.obj)
    env.infer_expr(mm.obj).ty_is_ptr().match ({
        true  => a.cenode(arrow_at(obj, mm.field, mm.pos)),
        false => a.cenode(member_at(obj, mm.field, mm.pos)),
    })
}
// Resolve foreach body with index and element bindings.
resolve_loop = (a: MutPtr<Malloc>, env: Env, l: LoopData) Ptr<Expr> {
    et := env.keep_elem(l.elemTy, l.seq)
    env2 := Env(
        vars: a.vcons(l.elem, et, a.vcons(l.idx, ti32(), env.vars)),
        decls: env.decls,
        didx: env.didx,
        exp: env.exp,
        a: env.a,
    )
    a.cenode(eloop(a.resolve_expr(env.clr_exp(), l.seq), l.idx, l.elem, et, a.resolve_body(env2, l.body), l.h))
}
resolve_inits = (a: MutPtr<Malloc>, env: Env, inits: [FieldInit]) [FieldInit] {
    buf := cbuf<FieldInit>(a, inits.len)
    inits.loop((h, i, fi) {
        buf[i] = finit(fi.name, a.resolve_expr(env, fi.value))
    })
    buf
}
vdef_payload = (vs: [VariantDef], vn: string_view) Ty {
    found := tvoid()
    vs.loop((h, i, v) {
        found = eq(v.name, vn).match ({ true => v.payload, false => found })
    })
    found
}
// O(1) indexed variant-payload lookup for an enum named `ename`.
// The default constant expr for a `Name = expr` variant, or a null Ptr<Expr> when the variant has none.
vdef_default_of = (vs: [VariantDef], vn: string_view) Ptr<Expr> {
    found := expr_null()
    vs.loop((h, i, v) {
        found = eq(v.name, vn).match ({ true => v.dflt, false => found })
    })
    found
}
// Concrete payload type for a match arm bind, including generic enum substitution.
gsubst = (pty: Ty, env: Env, g: GenericData) Ty {
    ged := env.env_genenum(g.name)
    sub := env.a.subst_ty_in(ged.tparams, g.args, pty)
    sub.match ({
        .Named(n) => {
            gsd := env.env_gstruct(n)
            is_empty(gsd.name).match ({
                true  => sub,
                false => {
                    tys := cbuf<Ty>(env.a, gsd.tparams.len)
                    gsd.tparams.loop((h, i, tp) {
                        tys[i] = env.a.subst_ty_in(ged.tparams, g.args, tnamed(tp.name))
                    })
                    tgeneric(n, tys, env.a.mangle_str_in(n, tys))
                },
            })
        },
        _         => sub,
    })
}
enum_payload_mono_ty = (env: Env, ename: string_view, etargs: [Ty], variant: string_view) Ty {
    env.env_genenum(ename).gen_variant_payload(variant).gsubst(env, GenericData(
        name: ename,
        args: etargs,
        mangled: env.a.mangle_str_in(ename, etargs),
    ))
}
// Fill match enum name and choose pointer/value tag access.
resolve_match = (a: MutPtr<Malloc>, env: Env, m: MatchData) Ptr<Expr> {
    subj2 := a.resolve_expr(env.clr_exp(), m.subj)
    t := env.infer_expr(subj2)
    en := t.enum_name()
    arms := a.resolve_arms(env, t, m.arms)
    t.ty_is_ptr().match ({
        true  => a.cenode(ematchp(subj2, en, arms)),
        false => a.cenode(ematch(subj2, en, arms)),
    })
}
resolve_args = (a: MutPtr<Malloc>, env: Env, args: [Expr]) [Expr] {
    buf := a.cebuf(args.len)
    args.loop((h, i, ar) {
        buf[i] = load(a.resolve_expr(env, ar.addr()))
    })
    buf
}
arg_exp = (ps: [Param], i: i32) Ty { (i < ps.len).match ({ true => ps[i].ty, false => tvoid() }) }
// String equality lowers to backend-specific content comparison intrinsics.
is_str_t* = (t: Ty) bool {
    t.match ({
        .StringView    => true,
        .StringCstr    => true,
        .StringLiteral => true,
        _              => false,
    })
}
str_eq_args = (a: MutPtr<Malloc>, lhs: Ptr<Expr>, rhs: Ptr<Expr>) [Expr] {
    buf := a.cebuf(2)
    buf[0] = load(lhs)
    buf[1] = load(rhs)
    buf
}
// An enum VALUE is a tagged union; raw C `==` on the struct is invalid. `==`/`!=` between two enum
// VALUES of the same type lower to a TAG comparison (concrete + generic-instance enums). A POINTER to
// an enum is NOT included: `p == null_ptr()` / `p1 == p2` are pointer-identity comparisons (valid C),
// not value equality — including Ptr here mis-lowered `e == null_ptr()` (e: Ptr<Expr>, Expr an enum)
// to `e->tag == …`. NOTE: tag-only compares the active VARIANT, not the payload — `Run(1) == Run(2)`
// is `true`; payloadless / state-style enums (the common case) compare exactly; full structural
// (payload) equality is a deliberate follow-up.
is_enum_ty = (env: Env, t: Ty) bool {
    t.match ({
        .Named(n)   => env.didx.enum_idx.get(n, 0 - 1) >= 0,
        .Generic(g) => is_empty(env.env_genenum(g.name).name) == false,
        _           => false,
    })
}
resolve_bin = (a: MutPtr<Malloc>, env: Env, b: BinData) Ptr<Expr> {
    lhs := a.resolve_expr(env.clr_exp(), b.lhs)
    rhs := a.resolve_expr(env.clr_exp(), b.rhs)
    cmp := eq(b.op, "==") || eq(b.op, "!=")
    lty := env.infer_expr(lhs)
    (cmp && lty.is_str_t() && env.infer_expr(rhs).is_str_t()).match ({
        true  => a.cenode(call(eq(b.op, "==").match ({ true => "__str_eq", false => "__str_ne" }), a.str_eq_args(lhs, rhs))),
        false => (cmp && env.is_enum_ty(lty)).match ({
            true  => a.cenode(bin_at(b.op, a.subj_tag(lhs, lty.ty_is_ptr()), a.subj_tag(rhs, lty.ty_is_ptr()), b.pos)),
            false => a.resolve_arith(env, b.op, lty, lhs, rhs, b.pos),
        }),
    })
}
// FLOAT DIVISION is retagged `/.` so a backend can tell it from integer `/`: C already dispatches at
// compile time via `_Generic` (IEEE for double, guarded for int), but the JS backend erases types, so
// without this marker it would route `0.0/0.0` through the integer div-by-zero guard and spuriously
// panic. `/.` says "IEEE division, no zero guard". Fires when either operand is f64 (a numeric literal
// on the other side adapts to f64). All other arithmetic falls through to the `-f64` negation fixup.
resolve_arith = (a: MutPtr<Malloc>, env: Env, op: string_view, lty: Ty, lhs: Ptr<Expr>, rhs: Ptr<Expr>, p: i32) Ptr<Expr> {
    (eq(op, "/") && (lty.is_f64_ty() || env.infer_expr(rhs).is_f64_ty())).match ({
        true  => a.cenode(bin_at("/.", lhs, rhs, p)),
        false => a.resolve_f64_neg(env, op, lhs, rhs, p),
    })
}
// Prefix `-f64` parses as `0 - x`; rewrite that zero to `0.0`.
is_int_zero = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Int(n) => n == 0,
        _       => false,
    })
}
resolve_f64_neg = (a: MutPtr<Malloc>, env: Env, op: string_view, lhs: Ptr<Expr>, rhs: Ptr<Expr>, p: i32) Ptr<Expr> {
    (eq(op, "-") && lhs.is_int_zero() && env.infer_expr(rhs).is_f64_ty()).match ({
        true  => a.cenode(bin_at(op, a.cenode(flit("0.0")), rhs, p)),
        false => a.cenode(bin_at(op, lhs, rhs, p)),
    })
}
// ── variadic params: a trailing `...T` param collects the surplus call args into a `[T]` ──
// Detect the marker (set by the parser), the element type T, and the per-arg expected type
// (T for a collected element). Lowering happens AFTER arg resolution, in resolve_call.
last_variadic = (ps: [Param]) bool { (ps.len > 0).match ({
    true  => ps[ps.len - 1].variadic,
    false => false,
}) }
vararg_elem = (t: Ty) Ty {
    t.match ({
        .Slice(e) => load(e),
        _         => t,
    })
}
// expected type for arg i: the element type T for any arg in a variadic param's collected tail.
arg_exp_v = (ps: [Param], i: i32) Ty {
    last_variadic(ps).match ({
        true  => {
            fixed := ps.len - 1
            (i < fixed).match ({ true => ps.arg_exp(i), false => ps[fixed].ty.vararg_elem() })
        },
        false => ps.arg_exp(i),
    })
}
// resolve_module re-runs resolve_decl several times (resolve/inline passes), so collection must be
// IDEMPOTENT: a call already lowered has exactly param-count args with a SliceLit in the variadic
// slot. Re-collecting it would nest `[[…]]`. Detect that shape and leave it untouched.
is_slicelit_expr = (e: Expr) bool {
    e.match ({
        .SliceLit(s) => true,
        _            => false,
    })
}
already_collected = (ps: [Param], args: [Expr]) bool {
    (args.len == ps.len).match ({
        true  => (args.len > 0).match ({
            true  => is_slicelit_expr(args[args.len - 1]),
            false => false,
        }),
        false => false,
    })
}
// rewrite `f(a, b, c)` with `f = (x: X, ys: ...Y)` into `f(a, [b, c])`: surplus args → one SliceLit.
collect_varargs = (a: MutPtr<Malloc>, ps: [Param], args: [Expr]) [Expr] {
    (last_variadic(ps) && ps.already_collected(args) == false).match ({
        true  => {
            fixed := ps.len - 1
            (args.len < fixed).match ({
                true  => args,
                false => {
                    elem := ps[fixed].ty.vararg_elem()    // too few args: let the validator report arity
                    vbuf := a.cebuf(args.len - fixed)
                    args.loop((h, j, e) {
                        (j >= fixed).then({
                            vbuf[j - fixed] = e
                        })
                    })
                    out := a.cebuf(fixed + 1)
                    args.loop((h, j, e) {
                        (j < fixed).then({
                            out[j] = e
                        })
                    })
                    out[fixed] = slit(elem, vbuf)
                    out
                },
            })
        },
        false => args,
    })
}
// The expected type for argument `i` of a (generic or plain) call. For a generic fn, the param type may
// name a tparam (`x: T`); substituting the inferred type args gives the CONCRETE expected type, which
// lets a bare variant ctor argument (`.Num(n)` for a `Vec<Tok>.push`) resolve against the right enum
// instead of guessing by variant name. FnT (lambda) params keep the void expected-type they had before
// (they are spliced/inlined later), so existing template-lambda resolution is unchanged. A variadic
// param's collected args take element type T (via arg_exp_v) before any tparam substitution.
// `b.op(args)` desugars to `op(b, args)`; when `op` names no function but IS a function-VALUE field of
// b's type (FnT), this is an INDIRECT call through that field (M1 closures). Detect it: the callee is
// not a known/dispatched function and arg0 has an FnT field of that name.
fnfield_ty = (env: Env, recv: Ptr<Expr>, field: string_view) Ty { env.infer_expr(env.a.cenode(member(recv, field))) }
is_fn_field_call = (env: Env, dn: string_view, args: [Expr]) bool {
    (eq(env.env_func(dn).name, "") && args.len > 0).match ({
        true  => env.fnfield_ty(args[0].addr(), dn).is_fnt(),
        false => false,
    })
}
// rewrite `op(b, x, y)` -> `({ __zclos_recv := b.op   __zclos_recv(x, y) })`: bind the field value to a
// local, then call the local. This reuses the existing local-fn-value call path (C `__auto_type` +
// native indirect call) — no new genc call node. Block scoping keeps the fixed temp name nesting-safe.
rewrite_fn_field_call = (a: MutPtr<Malloc>, env: Env, field: string_view, buf: [Expr]) Ptr<Expr> {
    rest := a.cebuf(buf.len - 1)
    buf.loop((h, i, e) {
        (i > 0).then({
            rest[i - 1] = e
        })
    })
    letst := slet("__zclos_recv", a.cenode(member(buf[0].addr(), field)))
    callx := a.cenode(call("__zclos_recv", rest))
    sbuf2 := cbuf<Stmt>(a, 2)
    sbuf2[0] = letst
    sbuf2[1] = sexpr(callx)
    a.cenode(block(sbuf2))
}
// `recv.len()` on a slice `[T]` is the slice's length FIELD (the element count). Resolving it
// receiver-type-aware here means it NEVER mis-dispatches to a same-named free fn (e.g. str.len, whose
// receiver is `str`, not `[T]`) — which otherwise yields a misleading arg-type error. Rewriting to the
// `.len` Member reuses the fully-supported field path (infer/validate/genc) and stays idempotent: a
// later resolve pass sees a Member, not a Call.
is_slice_len_call = (env: Env, fn: string_view, buf: [Expr]) bool {
    (eq(fn, "len") && buf.len == 1).match ({
        true  => env.infer_expr(buf[0].addr()).match ({
            .Slice(e) => true,
            _         => false,
        }),
        false => false,
    })
}
// UFCS auto-ref: a value `T` passed where param0 is `Ptr<T>` / `MutPtr<T>` (e.g. `r.next()` with
// `next = (r: MutPtr<Rng>) …`) is rewritten to `addr(r)` so the call type-checks and emits `&r`.
// Lvalue-only (Var/Member/Index/Arrow): a temp like `seed(1).next()` would otherwise mutate a
// discarded copy. Already-pointer args and unknown/void types are left alone (idempotent).
is_auto_ref_lvalue = (e: Expr) bool {
    e.match ({
        .Var(v)    => true,
        .Member(m) => true,
        .Index(ix) => true,
        .Arrow(ar) => true,
        _          => false,
    })
}
needs_ufcs_auto_ref = (env: Env, ps: [Param], arg0: Expr) bool {
    (ps.len > 0 && ps[0].ty.is_nonnull_ptr_ty()).match ({
        true  => {
            want := ps[0].ty.pointee_of()
            got := env.infer_expr(arg0.addr())
            (want.is_void_ty() || got.is_void_ty() || got.is_ptr_ty_g()).match ({
                true  => false,
                false => got.ty_eq(want) && arg0.is_auto_ref_lvalue(),
            })
        },
        false => false,
    })
}
ufcs_auto_ref_arg0 = (a: MutPtr<Malloc>, env: Env, ps: [Param], buf: [Expr], pos: i32) void {
    (buf.len > 0 && env.needs_ufcs_auto_ref(ps, buf[0])).then({
        ab := a.cebuf(1)
        ab[0] = buf[0]
        buf[0] = load(a.cenode(call_at("addr", ab, pos)))
    })
}
// `g(args)` where `g` is a LOCAL of by-value closure-struct type (lower_closures generated a struct
// `__clos_K` for it plus a call fn `__clos_K_call`) is an indirect closure call. Return the call-fn
// name if `g` is such a local (its type is a Named struct with a matching `_call` fn in the index),
// else "". The closure value is threaded as the call's first argument (its captured environment).
resolve_call* = (a: MutPtr<Malloc>, env: Env, c: CallData) Ptr<Expr> {
    dn := env.dispatch_name(c)
    fn := env.env_func(dn)
    ps := fn.params
    tmpl := fn.is_generic_fn()
    targs := tmpl.match ({ true => env.call_targs(fn, c.args, c.targs), false => no_tys() })
    buf := a.cebuf(c.args.len)
    c.args.loop((h, i, ar) {
        ex := env.call_arg_exp(tmpl, fn.tparams, targs, ps, i)
        buf[i] = load(a.resolve_expr(env.with_exp(ex), ar.addr()))
    })
    // After args resolve: value→Ptr/MutPtr auto-ref on arg0 (UFCS MutPtr receivers like r.next()).
    (ps.len == buf.len).then({
        a.ufcs_auto_ref_arg0(env, ps, buf, c.pos)
    })
    cclos := env.clos_local_call_name(c.fn)
    env.is_slice_len_call(c.fn, buf).match ({
        true  => a.cenode(member(buf[0].addr(), "len")),
        false => eq(cclos, "").match ({
            true  => env.is_fn_field_call(dn, buf).match ({
                true  => a.rewrite_fn_field_call(env, c.fn, buf),
                false => a.recall(c, env.rec_dispatch(dn, fn, c.args, c.targs), a.collect_varargs(ps, buf)),
            }),
            false => a.clos_call_rewrite(c, cclos, buf),
        }),
    })
}
// A call to a recursive generic fn routes to the mangled monomorphic instance once mono_rec has emitted
// it (the instance decl exists in the index). Until then — in resolve passes BEFORE mono_rec runs, and
// for the never-instantiated template itself — it stays the bare template name. This guard keeps
// resolve_call idempotent across passes and unchanged for every non-recursive call.
rec_dispatch = (env: Env, dn: string_view, fn: Func, args: [Expr], etargs: [Ty]) string_view {
    (eq(fn.name, dn) && fn.params.len == args.len && fn.no_inline_gen_f()).match ({
        true  => {
            m := env.a.mangle_semantic_in(dn, env.call_targs(fn, args, etargs))
            (env.didx.func_idx.get(m, 0 - 1) >= 0).match ({ true => m, false => dn })
        },
        false => dn,
    })
}
// Arm payload binds get their concrete payload type.
arm_env* = (a: MutPtr<Malloc>, env: Env, t: Ty, ar: ArmData) Env {
    eq(ar.bind, "").match ({
        true  => env,
        false => Env(
            vars: a.vcons(ar.bind, env.subj_variant_payload(t, ar.variant), env.vars),
            decls: env.decls,
            didx: env.didx,
            exp: env.exp,
            a: env.a,
        ),
    })
}
resolve_arms = (a: MutPtr<Malloc>, env: Env, t: Ty, arms: [ArmData]) [ArmData] {
    buf := cbuf<ArmData>(a, arms.len)
    arms.loop((h, i, ar) {
        aenv := a.arm_env(env, t, ar)
        buf[i] = arm_at(ar.variant, ar.bind, a.resolve_expr(aenv, ar.body), ar.pos)
    })
    buf
}
// Resolve statements, preserving expected type only for value-producing tail expressions.
store_local_ty = (t: Ty) Ty {
    t.match ({
        .Void    => tvoid(),
        .FnT(ft) => tvoid(),
        _        => t,
    })
}
resolve_let = (a: MutPtr<Malloc>, env: Env, l: LetData) Stmt {
    v := a.resolve_expr(env.let_exp(l.ty), l.value)
    ty := l.ty.is_void_ty().match ({
        true  => env.clr_exp().infer_expr(v).store_local_ty(),
        false => l.ty,
    })
    // Infer the stored type under the SAME cleared expected-type the value was resolved with: an
    // unannotated let has no target type, so the enclosing function's `exp` must not leak in. Else a
    // generic call whose return is a bare tparam (`with_sync … R`) unifies R against that stray exp
    // (e.g. main's i32) and the let is mistyped — value Result, type i32.
    slett_at(l.name, ty, v, l.pos)
}
// A DISCARDED (statement-position) match/cond keeps the enclosing function's expected (return) type, so
// an early `return .Err(x)` / `return .Ok(v)` inside a branch infers its enum from the DECLARED return
// type rather than from void context (which otherwise mis-mangled `.Err("x")` to `Result_void_text`).
// `(c).match({true=>…,false=>…})` parses to a Cond, so both Cond and Match must carry the expectation.
// Any OTHER discarded expression clears exp — a stray exp would mis-unify a generic call's bare tparam.
carries_return_e = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Cond(c)  => true,
        .Match(m) => true,
        _         => false,
    })
}
// `vtail` = this body is a VALUE block (reached via resolve_expr `.Block`), so its TAIL expression is
// the block's value and must NOT be discard-lowered even with no expected type. Without it, an inlined
// fn whose value is a bare match/cond — wrapped in a block once a binding Let is prepended — spliced as
// a match subject (resolved with cleared exp) would lower that tail match to a value-less `if`, leaving
// the `({ … })` void (GCC: `_subj declared void`). Statement bodies pass vtail=false (unchanged).
resolve_stmt = (a: MutPtr<Malloc>, env: Env, st: Stmt, last: bool, vtail: bool) Stmt {
    out := st
    st.match ({
        .Let(l)      => {
            out = a.resolve_let(env, l)
        },
        .Assign(x)   => {
            out = sassign_at(a.resolve_expr(env, x.target), a.resolve_expr(env.clr_exp(), x.value), x.pos)
        },
        .Return(r)   => {
            // A return's operand is expected to be the ENCLOSING FN's return type, wherever the
            // return sits (lowered conditional branch, value-position arm block, loop body). Falls back to the
            // positional exp when no fnret is bound (globals) or the fn returns void.
            rt := env.vars.fnret_of()
            out = sret(a.resolve_expr(rt.is_void_ty().match ({
                true  => env,
                false => env.with_exp(rt),
            }), r))
        },
        .ExprStmt(e) => {
            last.match ({
                true  => (env.exp.is_void_ty() == false).match ({
                    true  => {
                        out = sexpr(a.resolve_expr(env, e))
                    },
                    false => vtail.match ({
                        true  => {
                            out = sexpr(a.resolve_expr(env.clr_exp(), e))
                        },
                        false => {
                            out = a.lower_stmt_expr(env, a.resolve_expr(env.clr_exp(), e))
                        },
                    }),
                }),
                false => {
                    out = a.lower_stmt_expr(env, a.resolve_expr(env.disc_env(e), e))
                },
            })
        },
        .If(f)       => {
            out = sif(a.resolve_expr(env.clr_exp(), f.c), a.resolve_body(env, f.then), a.resolve_body(env, f.els))
        },
        .While(w)    => {
            out = swhile(a.resolve_expr(env.clr_exp(), w.c), a.resolve_body(env, w.body))
        },
        .IndexSet(x) => {
            out = sidxset_at(a.resolve_expr(env.clr_exp(), x.seq), a.resolve_expr(env.clr_exp(), x.idx), env.set_elem(x.elem, x.seq, x.value), a.resolve_expr(env.clr_exp(), x.value), x.pos)
        },
    })
    out
}
// `x := recv.or_return()` is keyword-free error propagation: the Ok payload becomes x, while an Err
// early-returns the receiver from the enclosing function. It lowers to a temp-bind + Err-guard +
// Ok-payload bind (three statements), so one source statement expands into three resolved ones.
is_or_return_call* = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Call(c) => eq(c.fn, "or_return") && c.args.len == 1,
        _        => false,
    })
}
let_is_or_return = (st: Stmt) bool {
    st.match ({
        .Let(l) => l.value.is_or_return_call(),
        _       => false,
    })
}
stmt_out_span = (st: Stmt) i32 { st.orx_stmt_count() * 3 + st.let_is_or_return().match ({
    true  => 3,
    false => 1,
}) }    // each hoisted expression-position or_return adds a 3-stmt let-lowering
body_out_len = (body: [Stmt]) i32 {
    n := 0
    body.loop((h, i, st) {
        n = n + st.stmt_out_span()
    })
    n
}
or_return_recv = (a: MutPtr<Malloc>, e: Ptr<Expr>) Ptr<Expr> {
    out := e
    load(e).match ({
        .Call(c) => {
            out = c.args[0].addr()
        },
        _        => { },
    })
    out
}
or_temp_name = (a: MutPtr<Malloc>, name: string_view) string_view {
    s := a.gstr_string(64)
    s = s.gstr_append(a, "_orret_")
    s = s.gstr_append(a, name)
    s.gstr_finish(a)
}
// ── the Err-guard's return value ──
// VERBATIM receiver when its whole Result type is the enclosing fn's, or when either side is not
// fully concrete here (tparam/unknown residue — the pre-#377 behavior). Otherwise REBUILT as the
// ENCLOSING fn's Result carrying the receiver's Err payload: `(Want){ .tag=Err, .u.Err=tmp.u.Err }`.
// The rebuild is what lets a fallible pipeline chain steps with DIFFERENT Ok types — a
// `Result<Cfg, E>` receiver inside a `Result<i32, E>` fn: the Ok payload is consumed locally by the
// binding this lowering feeds, so only E must line up (v1: exact same E, no From/Into).
// `env.exp` here IS the fn's return type wherever the statement-level hoisting lowering runs (fn
// bodies, if/while bodies); conditional-position wraps (resolve_orx) run under a local expected
// type, where the gate below fails closed to the verbatim return — matching the or-return
// validator, which keeps the strict full-Result requirement exactly there (ko_at's `cnd`).
// The concreteness gate mirrors the validator's unknown_ty deferrals (plus the prim widths), so
// every receiver/return pair the validator accepts with differing Ok payloads gets the rebuild.
orret_prim_named = (n: string_view) bool { eq(n, "i8") || eq(n, "i16") || eq(n, "u16") || eq(n, "u32") || eq(n, "u64") || eq(n, "f32") }
orret_gen_declared = (decls: [Decl], n: string_view) bool {
    found := false
    decls.loop((h, i, d) {
        found = d.match ({
            .DGenStruct(g) => eq(g.name, n).match ({ true => true, false => found }),
            .DGenEnum(g)   => eq(g.name, n).match ({ true => true, false => found }),
            _              => found,
        })
    })
    found
}
orret_named_known = (env: Env, n: string_view) bool { env.didx.struct_idx.get(n, 0 - 1) >= 0 || env.didx.enum_idx.get(n, 0 - 1) >= 0 || env.decls.orret_gen_declared(n) || n.orret_prim_named() }
orret_ty_known = (env: Env, t: Ty) bool {
    t.match ({
        .Void       => false,
        .Named(n)   => env.orret_named_known(n),
        .Generic(g) => env.orret_args_known(g.args),
        .Ptr(pd)    => env.orret_ty_known(load(pd.pointee)),
        .Slice(e)   => env.orret_ty_known(load(e)),
        _           => true,
    })
}
orret_args_known = (env: Env, args: [Ty]) bool {
    k := true
    args.loop((h, i, t) {
        k = env.orret_ty_known(t).match ({ true => k, false => false })
    })
    k
}
// Build `Want.Err(payload)` for a concrete want (Named enum or generic instance). The generic
// instance's mono name is the fn return type's own, so gen_types has already emitted it.
orret_mkerr = (a: MutPtr<Malloc>, want: Ty, payload: Ptr<Expr>, tmp: string_view) Ptr<Expr> {
    want.match ({
        .Named(n)   => a.cenode(mkenumg(n, n, no_tys(), "Err", payload)),
        .Generic(g) => a.cenode(mkenumg(g.name, eq(g.mangled, "").match ({
            true  => a.mangle_str_in(g.name, g.args),
            false => g.mangled,
        }), g.args, "Err", payload)),
        _           => a.cenode(vref(tmp)),
    })
}
orret_err_value = (a: MutPtr<Malloc>, env: Env, t: Ty, tmp: string_view, ptr: bool) Ptr<Expr> {
    want := env.exp
    (t.ty_eq(want) || want.ty_eq(t) || env.orret_ty_known(want) == false || env.orret_ty_known(t) == false).match ({
        true  => a.cenode(vref(tmp)),
        false => {
            wE := env.subj_variant_payload(want, "Err")
            rE := env.subj_variant_payload(t, "Err")
            (wE.is_void_ty() || rE.is_void_ty() || wE.ty_eq(rE) == false).match ({
                true  => a.cenode(vref(tmp)),
                false => a.orret_mkerr(want, a.subj_payload(a.cenode(vref(tmp)), "Err", ptr), tmp),
            })
        },
    })
}
// The Err-guard's tag constant, built as a re-manglable Tag node whose `.tag` genc folds to the bare
// `<mty>_<variant>` identifier — byte-identical to the old baked `tag_const` vref for a concrete
// receiver. Riding on a Tag (not a raw string) is what lets subst_expr rewrite T→concrete when this
// generic body is inlined at a concrete T, so or_return works in a generic Result-returning fn whose
// Ok type carries T (#54). A pointer/opaque receiver falls back to the verbatim baked constant.
or_err_tag = (a: MutPtr<Malloc>, t: Ty, variant: string_view) Ptr<Expr> {
    t.match ({
        .Named(n)   => a.subj_tag(a.cenode(mktag(n, variant)), false),
        .Generic(g) => a.subj_tag(a.cenode(mktagg(g.name, eq(g.mangled, "").match ({
            true  => a.mangle_str_in(g.name, g.args),
            false => g.mangled,
        }), g.args, variant)), false),
        _           => a.cenode(vref(a.tag_const(t.enum_name(), variant))),
    })
}
lower_or_return_let = (a: MutPtr<Malloc>, env: Env, l: LetData) [Stmt] {
    recv2 := a.resolve_expr(env.clr_exp(), a.or_return_recv(l.value))
    t := env.infer_expr(recv2)
    ptr := t.ty_is_ptr()
    tmp := a.or_temp_name(l.name)
    cnd := a.cenode(bin("==", a.subj_tag(a.cenode(vref(tmp)), ptr), a.or_err_tag(t, "Err")))
    buf := cbuf<Stmt>(a, 3)
    buf[0] = slett(tmp, t, recv2)
    buf[1] = sif(cnd, a.one_stmt(sret(a.orret_err_value(env, t, tmp, ptr))), no_stmts())
    buf[2] = slett(l.name, env.subj_variant_payload(t, "Ok"), a.subj_payload(a.cenode(vref(tmp)), "Ok", ptr))
    buf
}
lower_or_return = (a: MutPtr<Malloc>, env: Env, st: Stmt) [Stmt] {
    out := no_stmts()
    st.match ({
        .Let(l) => {
            out = a.lower_or_return_let(env, l)
        },
        _       => { },
    })
    out
}
// ── or_return in EXPRESSION position ─────────────────────────────────────────────────────────
// `recv.or_return()` is legal in ANY expression position, not just as a whole let value: mid-chain
// (`f().or_return().m()`), as a call argument, in return/trailing position, and in match arms. Each
// expression-position occurrence is HOISTED into a fresh direct let `_orx_K := recv.or_return()` —
// which reuses the 3-stmt let-lowering above — and the original site reads the temp. Hoists are
// emitted left-to-right in source order and innermost-first (a receiver's own or_returns hoist
// before the outer one), so the FIRST Err in evaluation order is the one propagated.
// UNCONDITIONALLY-evaluated positions hoist to statement level (fill_orx), where the Err-guard `if`
// is a real statement the inliner's early-return lift can see. CONDITIONALLY-evaluated positions —
// cond/match branch values and `&&`/`||` right operands — must NOT hoist past their guard: those
// are wrapped in place into a value block `({ _orx := recv.or_return()  _orx })` when resolve_expr
// reaches the branch (resolve_orx), so the receiver only evaluates if its branch is taken.
// orx_count counts the hoistable (unconditional-position) or_returns of ONE expression. Nested
// statement bodies (Block/Loop/Lambda/If/While) and conditional branches are NOT counted — each is
// resolved in its own scope, where this same machinery fires again. Resolution erases every
// or_return, so the count is 0 on already-resolved trees (the re-resolve passes stay idempotent).
is_shortcircuit* = (op: string_view) bool { eq(op, "&&") || eq(op, "||") }
is_orx_hoist* = (c: CallData) bool { eq(c.fn, "or_return") && c.args.len == 1 }
resolve_orx = (a: MutPtr<Malloc>, env: Env, e: Ptr<Expr>) Ptr<Expr> {
    k := e.orx_count()
    hbuf := cbuf<Stmt>(a, k)
    r := a.orx_rw(hbuf, 0, 0, e)
    stmts := cbuf<Stmt>(a, k + 1)
    hbuf.loop((h, i, hst) {
        stmts[i] = hst
    })
    stmts[k] = sexpr(r.e)
    a.cenode(block(a.resolve_value_body(env, stmts)))
}
// Resolve a statement sequence while threading let bindings.
noop2 = () void { }
resolve_body = (a: MutPtr<Malloc>, env: Env, body: [Stmt]) [Stmt] { a.resolve_body_ex(env, body, false) }
// resolve a VALUE-position block body: same as resolve_body but the trailing expression is kept as the
// block's value (see resolve_stmt's `vtail`).
resolve_value_body = (a: MutPtr<Malloc>, env: Env, body: [Stmt]) [Stmt] { a.resolve_body_ex(env, body, true) }
resolve_body_ex = (a: MutPtr<Malloc>, env: Env, body: [Stmt], vtail: bool) [Stmt] {
    buf := cbuf<Stmt>(a, body.body_out_len())
    a.fill_stmts(env, body, buf, 0, 0, vtail)
    buf
}
fill_stmts = (a: MutPtr<Malloc>, env: Env, body: [Stmt], buf: [Stmt], i: i32, o: i32, vtail: bool) void { (i < body.len).match ({
    true  => a.fill_stmt(env, body, buf, i, o, vtail),
    false => noop2(),
}) }
fill_stmt = (a: MutPtr<Malloc>, env: Env, body: [Stmt], buf: [Stmt], i: i32, o: i32, vtail: bool) void {
    st := body[i]
    k := st.orx_stmt_count()
    (k > 0).match ({
        true  => a.fill_orx(env, body, buf, i, o, vtail, k),
        false => st.let_is_or_return().match ({
            true  => a.fill_or_return(env, body, buf, i, o, vtail),
            false => {
                resolved := a.resolve_stmt(env, st, i == body.len - 1, vtail)
                buf[o] = resolved
                a.fill_stmts(a.extend_env(env, resolved), body, buf, i + 1, o + 1, vtail)
            },
        }),
    })
}
// A statement holding k expression-position or_returns: hoist each into a fresh direct temp let
// (orx_rw_stmt), run every hoisted let through the SAME 3-stmt let-lowering, then emit the rewritten
// statement itself (which may still be a direct or_return let — its own lowering unchanged). The
// output slot count is exactly stmt_out_span's 3*k + (3|1), keeping body_out_len's buffer sizing.
fill_orx = (a: MutPtr<Malloc>, env: Env, body: [Stmt], buf: [Stmt], i: i32, o: i32, vtail: bool, k: i32) void {
    hbuf := cbuf<Stmt>(a, k)
    st2 := a.orx_rw_stmt(hbuf, o, body[i])
    env2 := env
    oo := o
    hbuf.loop((h, j, hst) {
        ls := a.lower_or_return(env2, hst)
        buf[oo] = ls[0]
        buf[oo + 1] = ls[1]
        buf[oo + 2] = ls[2]
        env2 = a.extend_env(a.extend_env(a.extend_env(env2, ls[0]), ls[1]), ls[2])
        oo = oo + 3
    })
    st2.let_is_or_return().match ({
        true  => {
            ls := a.lower_or_return(env2, st2)
            buf[oo] = ls[0]
            buf[oo + 1] = ls[1]
            buf[oo + 2] = ls[2]
            env2 = a.extend_env(a.extend_env(a.extend_env(env2, ls[0]), ls[1]), ls[2])
            oo = oo + 3
        },
        false => {
            resolved := a.resolve_stmt(env2, st2, i == body.len - 1, vtail)
            buf[oo] = resolved
            env2 = a.extend_env(env2, resolved)
            oo = oo + 1
        },
    })
    a.fill_stmts(env2, body, buf, i + 1, oo, vtail)
}
fill_or_return = (a: MutPtr<Malloc>, env: Env, body: [Stmt], buf: [Stmt], i: i32, o: i32, vtail: bool) void {
    stmts := a.lower_or_return(env, body[i])
    buf[o] = stmts[0]
    buf[o + 1] = stmts[1]
    buf[o + 2] = stmts[2]
    env2 := a.extend_env(a.extend_env(a.extend_env(env, stmts[0]), stmts[1]), stmts[2])
    a.fill_stmts(env2, body, buf, i + 1, o + 3, vtail)
}
extend_env* = (a: MutPtr<Malloc>, env: Env, st: Stmt) Env {
    st.match ({
        .Let(l) => Env(
            vars: a.vcons(l.name, l.ty.is_void_ty().match ({
                true  => env.infer_expr(l.value),
                false => l.ty,
            }), env.vars),
            decls: env.decls,
            didx: env.didx,
            exp: env.exp,
            a: env.a,
        ),
        _       => env,
    })
}
// The env a foreach/loop BODY is checked in: the element (`v`) and index (`i`) bindings the lowering
// introduces, plus the handler (`h`) whose `h.break`/`h.continue` controls the loop. `h` is bound to an
// unknown type so `h.break_zk` stays lenient (member_err defers on unknown receivers) — it exists only so
// the handler name resolves and the validator can walk INTO the body to catch undefined names / type errs.
loop_env* = (a: MutPtr<Malloc>, env: Env, l: LoopData) Env {
    Env(
        vars: a.vcons(l.h, tnamed(""), a.vcons(l.elem, l.elemTy, a.vcons(l.idx, ti32(), env.vars))),
        decls: env.decls,
        didx: env.didx,
        exp: env.exp,
        a: env.a,
    )
}
// Rebuild decls with resolved bodies/inits.
resolve_func = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, f: Func) Func {
    env := Env(
        vars: a.bind_fnret(a.params_env(f.params), f.ret),
        decls: decls,
        didx: idx,
        exp: f.ret,
        a: a,
    )
    Func(
        name: f.name,
        params: f.params,
        ret: f.ret,
        tparams: f.tparams,
        body: a.resolve_body(env, f.body),
        pos: f.pos,
    )
}
resolve_global = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, g: GlobalData) Decl {
    env := Env(
        vars: a.params_env(empty_params()),
        decls: decls,
        didx: idx,
        exp: tvoid(),
        a: a,
    )
    g.tl.match ({
        true  => dglobal_tl(g.name, env.infer_expr(g.init), a.resolve_expr(env, g.init)),
        false => dglobal(g.name, env.infer_expr(g.init), a.resolve_expr(env, g.init)),
    })
}
resolve_decl* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, d: Decl) Decl {
    d.match ({
        .DFunc(f)   => dfunc(a.resolve_func(decls, idx, f)),
        .DGlobal(g) => a.resolve_global(decls, idx, g),
        _           => d,
    })
}
// Template/lambda inlining pass.
no_stmts* = () [Stmt] { slice(null_ptr(), 0) }
empty_args* = () [Expr] { slice(null_ptr(), 0) }
pidx = (params: [Param], name: string_view, found: i32, i: i32) i32 {
    (i == params.len).match ({
        true  => found,
        false => eq(params[i].name, name).match ({
            true  => i,
            false => params.pidx(name, found, i + 1),
        }),
    })
}
param_index* = (params: [Param], name: string_view) i32 { params.pidx(name, 0 - 1, 0) }
hide_param = (a: MutPtr<Malloc>, params: [Param], name: string_view) [Param] {
    idx := params.param_index(name)
    (idx < 0).match ({
        true  => params,
        false => {
            buf := a.pbuf(params.len)
            params.loop((h, i, p) {
                buf[i] = eq(p.name, name).match ({
                    true  => Param(
                        name: "",
                        ty: p.ty,
                        variadic: p.variadic,
                    ),
                    false => p,
                })
            })
            buf
        },
    })
}
local_marks = (a: MutPtr<Malloc>, s: String, n: i64) String { (n <= 0).match ({
    true  => s,
    false => a.local_marks(s.gstr_append(a, "_"), n - 1),
}) }
// inline-expansion scope marks: the chain of functions currently being inlined (env's empty-named
// markers, pushed by inline_template). Distinguishes locals from DIFFERENT inlined functions that
// share a param-count depth — e.g. cenode and cebuf both at depth 2 would otherwise rename their
// `buf` to the same C local and alias into a self-referential node. Same-function re-inlines stay
// distinct via C block scoping. This is what lets the compiler internals be generic (inlined) safely.
inline_marks = (a: MutPtr<Malloc>, s: String, env: Ptr<VList>) String {
    env.match ({
        .VNil     => s,
        .VCons(c) => c.ty.is_empty_named().match ({
            true  => a.inline_marks(s.gstr_append(a, "_").gstr_append(a, c.name), c.tail),
            false => a.inline_marks(s, c.tail),
        }),
    })
}
local_name_at* = (a: MutPtr<Malloc>, name: string_view, env: Ptr<VList>, depth: i64) string_view {
    s := a.gstr_string(128)
    s = s.gstr_append(a, "__zen_local")
    s = a.inline_marks(s, env)
    s = a.local_marks(s, depth)
    s = s.gstr_append(a, "_")
    s = s.gstr_append(a, name)
    s.gstr_finish(a)
}
add_subst_param* = (a: MutPtr<Malloc>, params: [Param], name: string_view) [Param] {
    base := a.hide_param(params, name)
    buf := a.pbuf(base.len + 1)
    base.loop((h, i, p) {
        buf[i] = p
    })
    buf[base.len] = Param(
        name: name,
        ty: tvoid(),
        variadic: false,
    )
    buf
}
add_subst_arg* = (a: MutPtr<Malloc>, args: [Expr], name: string_view) [Expr] {
    buf := a.cebuf(args.len + 1)
    args.loop((h, i, e) {
        buf[i] = e
    })
    buf[args.len] = vref(name)
    buf
}
// A lambda bound to a local (`g := (n){…}`) has no C closure value. Instead the inliner treats the
// local as a COMPILE-TIME ALIAS: shadow the name as an FnT "param" whose substituted "arg" is the
// (already-xformed) lambda, so every later use — a direct call `g(x)` or a HOF arg `apply(g,…)` —
// splices the lambda exactly like a directly-passed one. The `g := …` statement itself is dropped.
add_fnt_param* = (a: MutPtr<Malloc>, params: [Param], name: string_view) [Param] {
    base := a.hide_param(params, name)
    buf := a.pbuf(base.len + 1)
    base.loop((h, i, p) {
        buf[i] = p
    })
    buf[base.len] = Param(
        name: name,
        ty: fntype(no_tys(), a.tnode(tvoid())),
    )
    buf
}
add_lambda_arg* = (a: MutPtr<Malloc>, args: [Expr], lamx: Ptr<Expr>) [Expr] {
    buf := a.cebuf(args.len + 1)
    args.loop((h, i, e) {
        buf[i] = e
    })
    buf[args.len] = load(lamx)
    buf
}
// is this Let's value a lambda literal? (drives the alias lowering above)
let_value_lambda* = (st: Stmt) bool {
    st.match ({
        .Let(l) => load(l.value).match ({
            .Lambda(lm) => true,
            _           => false,
        }),
        _       => false,
    })
}
the_func* = (decls: [Decl], name: string_view) Func {
    found := Func(
        name: "",
        params: empty_params(),
        ret: tvoid(),
        tparams: empty_params(),
        body: no_stmts(),
    )
    decls.loop((h, i, d) {
        found = d.match ({
            .DFunc(f)    => eq(f.name, name).match ({ true => f, false => found }),
            .DForeign(f) => eq(f.name, name).match ({ true => f, false => found }),
            _            => found,
        })
    })
    found
}
// O(1) indexed Func lookup for the inline/template path (mirrors env_func; same last-match result).
ref_pos* = (e: Ptr<Expr>) i32 {
    load(e).match ({
        .Var(v) => v.pos,
        _       => 0,
    })
}
// THE keystone: `subst_var` splices the SAME arg AST node into every param use, so a param used N
// times re-evaluates the arg N times (double-effect / double-alloc / UAF) and a param used 0 times
// DROPS the arg entirely (a generic-instance literal then never monomorphizes). The fix binds each
// non-trivial arg to ONE generated local BEFORE splicing the body, then substitutes that local's Var
// for every param use — so the arg evaluates exactly once and always survives as a real statement.
// Pure leaves (Var/Int/literal) are left alone: a Var receiver MUST stay concrete for UFCS/trait
// dispatch (binding it erased the receiver type — a prior attempt regressed 37 cases), and leaves
// have no effect to duplicate. We bind effectful/instance-bearing args: calls and struct/enum makes,
// AND — the root of #69/#480 — the compound results of an ALREADY-INLINED nested call. A chained
// method (`m.put(k,v).put(k2,v2)`) reaches the outer inline with its receiver arg already expanded
// into a Block (multi-statement body), a Cond (`?:`, from an early-return/or_return lift in the
// inlined body), or a Match. Those carry the inner op's non-idempotent side effects; if the outer
// param uses them N>1 times they re-run N times (~3^depth over a chain → hang / slice-OOB / wrong
// result). Binding them to ONE temp collapses each to a single evaluation.
ArgBind*: {
    fargs: [Expr],
    binds: [Stmt],
    env: Ptr<VList>,
}
arg_needs_bind = (e: Expr) bool {
    e.match ({
        .Call(c)        => true,
        .MakeStruct(sd) => true,
        .MakeEnum(mk)   => true,
        .Block(b)       => true,
        .Cond(d)        => true,
        .Match(m)       => true,
        _               => false,
    })
}
// Fresh C name for an arg-binding local: distinct "__zen_arg" prefix (never collides with body
// "__zen_local"s), inline_marks keep it distinct across nested inline depths, the index keeps each
// arg distinct within one inline.
arg_local_name = (a: MutPtr<Malloc>, name: string_view, env: Ptr<VList>, idx: i64) string_view {
    s := a.gstr_string(128)
    s = s.gstr_append(a, "__zen_arg")
    s = a.inline_marks(s, env)
    s = a.local_marks(s, idx)
    s = s.gstr_append(a, "_")
    s = s.gstr_append(a, name)
    s.gstr_finish(a)
}
// Bind every non-trivial arg to a generated local; return the rewritten fargs (the param-use
// substitution targets), the binding Let statements to prepend to the body, and the env extended with
// each temp's CONCRETE light type. The env type is the arg's own light_ty — NOT the param's declared
// type: a UFCS/trait receiver passed by value (`a.addr()`) carries the concrete impl type that
// in-body dispatch (`a.try_acquire(..)`) depends on; the param's declared type is the trait interface,
// which would mis-dispatch (a prior attempt regressed 37 cases this way). Using light_ty makes the
// binding type-TRANSPARENT — the body sees exactly the type splicing the arg would have produced. The
// temp Let carries a void type → genc emits `__auto_type`, the exact concrete C type.
// `pins[i]` (void = none) is the targ-substituted param type a LITERAL arg must ADOPT: splicing a
// raw literal into the body would let every INNER generic call re-infer its tparam from the
// literal's default width (i32) — the outer instantiation's binding (e.g. K=i64 from the HMap
// receiver) silently lost, wrong monos emitted (i64 keys hashed with impl_Hash_i32_hash). A pinned
// literal is bound to a TYPED temp local instead, so in-body uses carry the instantiated type.
bind_args* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, params: [Param], cargs: [Expr], env: Ptr<VList>, pins: [Ty]) ArgBind {
    nf := a.cebuf(cargs.len)
    nb := 0
    cargs.loop((h, i, ce) {
        (i < params.len && (ce.arg_needs_bind() || pins[i].is_void_ty() == false)).then({
            nb = nb + 1
        })
    })
    bb := cbuf<Stmt>(a, nb)
    e2 := env
    j := 0
    cargs.loop((h, i, ce) {
        (i < params.len && (ce.arg_needs_bind() || pins[i].is_void_ty() == false)).match ({
            true  => {
                nm := a.arg_local_name(params[i].name, env, i)
                bb[j] = slett(nm, pins[i], cargs[i].addr())
                e2 = a.vcons(nm, pins[i].is_void_ty().match ({
                    true  => cargs[i].addr().light_ty(a, env, decls, idx),
                    false => pins[i],
                }), e2)
                nf[i] = vref(nm)
                j = j + 1
            },
            false => {
                nf[i] = ce
            },
        })
    })
    ArgBind(
        fargs: nf,
        binds: bb,
        env: e2,
    )
}
// pins for a NON-generic inline (and lambda inlines): none.
no_pins* = (a: MutPtr<Malloc>, n: i64) [Ty] {
    buf := cbuf<Ty>(a, n)
    buf.loop((h, i, t) {
        buf[i] = tvoid()
    })
    buf
}
// The pin for each arg of a GENERIC inline: literal-typed args whose param type mentions a tparam
// adopt the (fully concrete) targ-substituted param type; everything else is unpinned.
lit_pins* = (a: MutPtr<Malloc>, tparams: [Param], targs: [Ty], params: [Param], cargs: [Expr]) [Ty] {
    buf := cbuf<Ty>(a, params.len)
    params.loop((h, i, p) {
        buf[i] = tvoid()
        (i < cargs.len && cargs[i].addr().is_lit_numeric() && p.ty.ty_mentions_any(tparams)).then({
            t := a.subst_ty_in(tparams, targs, p.ty)
            (t.is_void_ty() || t.ty_mentions_any(tparams) == false).then({
                buf[i] = t
            })
        })
    })
    buf
}
// the C name a substituted arg carries: a Var holds the (renamed) local it stands for, so an
// indirect call `f()` through a renamed local let recovers `f`'s renamed C name. Falls back to the
// original callee name when the substituted arg isn't a plain Var.
callee_subst_name* = (e: Expr, fallback: string_view) string_view {
    e.match ({
        .Var(v) => v.name,
        _       => fallback,
    })
}
// Inline body as block expression: trailing return becomes the result expression.
ret_to_expr = (st: Stmt) Stmt {
    st.match ({
        .Return(e) => sexpr(e),
        _          => st,
    })
}
block_of = (a: MutPtr<Malloc>, stmts: [Stmt]) Ptr<Expr> {
    buf: [Stmt] := cbuf<Stmt>(a, stmts.len)
    stmts.loop((h, i, st) {
        buf[i] = (i == stmts.len - 1).match ({ true => ret_to_expr(st), false => st })
    })
    a.cenode(block(buf))
}
// Does a statement (sequence) contain a `return`? Recurses ONLY through If branches — a discarded
// match lowers to an If (lower_match_arms), so an arm `return` lives in an If body. (While/Loop bodies
// are NOT followed: a return inside a real loop can't be lifted to a ?: and is left to the old path.)
stmt_has_return = (st: Stmt) bool {
    st.match ({
        .Return(r) => true,
        .If(f)     => f.then.body_has_return() || f.els.body_has_return(),
        _          => false,
    })
}
body_has_return = (stmts: [Stmt]) bool {
    found := false
    stmts.loop((h, i, st) {
        found = st.stmt_has_return().match ({ true => true, false => found })
    })
    found
}
// A body needs the early-return lift when a `return` appears anywhere except as the clean TRAILING
// top-level statement: a non-final top-level `return`, or any If whose branch contains a `return`.
// When inlined, the body is spliced into a GCC statement-expression `({ … })`, so a real C `return`
// would exit the CALLER's function — a silent miscompile. The lift below rewrites such returns into
// `?:` so control never escapes the block.
needs_early_lift = (stmts: [Stmt]) bool {
    n := stmts.len
    found := false
    stmts.loop((h, i, st) {
        st.match ({
            .Return(r) => {
                (i != n - 1).then({
                    found = true
                })
            },
            .If(f)     => {
                (f.then.body_has_return() || f.els.body_has_return()).then({
                    found = true
                })
            },
            _          => { },
        })
    })
    found
}
// Concatenate two statement slices into a fresh buffer.
cat_stmts* = (a: MutPtr<Malloc>, xs: [Stmt], ys: [Stmt]) [Stmt] {
    buf := cbuf<Stmt>(a, xs.len + ys.len)
    xs.loop((h, i, s) {
        buf[i] = s
    })
    ys.loop((h, i, s) {
        buf[xs.len + i] = s
    })
    buf
}
// stmts[1..] in a fresh buffer.
stmt_tail = (a: MutPtr<Malloc>, xs: [Stmt]) [Stmt] {
    buf := cbuf<Stmt>(a, xs.len - 1)
    xs.loop((h, i, s) {
        (i > 0).then({
            buf[i - 1] = s
        })
    })
    buf
}
// `({ head; <value> })` — a head statement followed by the value expression.
block_cons = (a: MutPtr<Malloc>, head: Stmt, value: Ptr<Expr>) Ptr<Expr> {
    buf := cbuf<Stmt>(a, 2)
    buf[0] = head
    buf[1] = sexpr(value)
    a.cenode(block(buf))
}
// Lift early returns out of an inlined body: turn a statement sequence (in value position) into a
// SINGLE expression. An If whose branches return becomes `cond ? thenVal : elseVal`, where each
// branch's value is the branch body followed by the remaining statements (the continuation) — so a
// `return` simply stops the sequence (its tail is dead) and never lowers to a C `return`. Only ONE
// branch runs at a time, so duplicating the continuation into both arms is sound (no double effects).
cps_value* = (a: MutPtr<Malloc>, stmts: [Stmt]) Ptr<Expr> {
    (stmts.len == 0).match ({
        true  => a.cenode(block(no_stmts())),
        false => {
            head := stmts[0]
            rest := a.stmt_tail(stmts)
            head.match ({
                .Return(r) => r,    // tail is dead
                .If(f)     => (f.then.body_has_return() || f.els.body_has_return()).match ({
                    true  => a.cenode(cond(f.c, a.cps_value(a.cat_stmts(f.then, rest)), a.cps_value(a.cat_stmts(f.els, rest)))),
                    false => (rest.len == 0).match ({
                        true  => a.cenode(block(stmts)),
                        false => a.block_cons(head, a.cps_value(rest)),
                    }),
                }),    // trailing for-effect If (void value)
                _          => (rest.len == 0).match ({
                    true  => head.match ({
                        .ExprStmt(e) => e,
                        _            => a.cenode(block(stmts)),
                    }),
                    false => a.block_cons(head, a.cps_value(rest)),
                }),
            })
        },
    })
}
// One value statement inlines directly; larger bodies become block expressions. A body with a
// non-tail return is lifted into `?:` first (early-return → exits only the inlined block, not the caller).
blockify* = (a: MutPtr<Malloc>, stmts: [Stmt]) Ptr<Expr> {
    stmts.needs_early_lift().match ({
        true  => a.cps_value(stmts),
        false => (stmts.len == 1).match ({
            true  => stmts[0].match ({
                .Return(e)   => e,
                .ExprStmt(e) => e,
                _            => a.block_of(stmts),
            }),
            false => a.block_of(stmts),
        }),
    })
}
inline_lambda* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, lamx: Expr, cargs: [Expr], env: Ptr<VList>) Ptr<Expr> {
    lamx.match ({
        .Lambda(lm) => {
            // spliced lambda body: its `return`s are the LAMBDA's, so bind its own (possibly void)
            // return type over the caller's.
            ab := a.bind_args(decls, idx, lm.params, cargs, a.bind_fnret(env, lm.ret), a.no_pins(lm.params.len))
            a.blockify(a.cat_stmts(ab.binds, a.xform_body(decls, idx, lm.body, lm.params, ab.fargs, ab.env, tvoid())))
        },
        .Var(v)     => a.var_call(v, cargs),
        _           => a.cenode(lamx),
    })
}
// Trait default methods are materialized for impls that omit them.
pbuf* = (a: MutPtr<Malloc>, n: i64) [Param] { slice(a.acquire(n * sizeof(Param) + sizeof(Param)), n) }
resolve_module* = (a: MutPtr<Malloc>, raw: [Decl]) [Decl] {
    decls0 := a.expand_defaults(a.desugar_method_calls(raw))
    decls := a.fill_enum_defaults(decls0, a.build_decl_index(decls0))
    // Decl order/count are stable across resolve+inline passes (each rebuilds bodies in place), so a
    // name→index map is rebuilt once per pass over the current slice.
    didx := a.build_decl_index(decls)
    buf := cbuf<Decl>(a, decls.len)
    decls.loop((h, i, d) {
        buf[i] = a.resolve_decl(decls, didx, d)
    })
    bidx := a.build_decl_index(buf)
    inl := cbuf<Decl>(a, buf.len)
    buf.loop((h, i, d) {
        inl[i] = a.inline_decl(buf, bidx, d)
    })
    iidx := a.build_decl_index(inl)
    out := cbuf<Decl>(a, inl.len)
    inl.loop((h, i, d) {
        out[i] = a.resolve_decl(inl, iidx, d)
    })
    oidx := a.build_decl_index(out)
    inl2 := cbuf<Decl>(a, out.len)
    out.loop((h, i, d) {
        inl2[i] = a.inline_decl(out, oidx, d)
    })
    // emit one concrete fn per generic instance BEFORE the final resolve, so each instance body gets
    // resolved (dispatch on its concrete types) and resolve_call rewrites generic calls to it —
    // iterated to closure because instance bodies splice HOFs that can expose further instances.
    exp2 := a.mono_close(inl2, 0, 0)
    // lower ESCAPING capturing closures (a fn returning a lambda over its params) to a by-value closure
    // struct + a top-level call fn, BEFORE the non-capturing lift and the final resolve. The final
    // resolve then sees the rewritten return type (the closure struct) and rewrites indirect calls.
    clos := a.lower_closures(exp2, a.build_decl_index(exp2))
    // lift non-capturing lambda LITERALS in value positions (struct-field inits / returns) to top-level
    // fns BEFORE the final resolve, so the generated fns + the fn-value references they leave behind get
    // resolved. Remaining capturing lambdas are left for check_validate's error[lambda-value].
    lifted := a.lift_lambdas(clos, a.build_decl_index(clos))
    eidx := a.build_decl_index(lifted)
    out2 := cbuf<Decl>(a, lifted.len)
    lifted.loop((h, i, d) {
        out2[i] = a.resolve_decl(lifted, eidx, d)
    })
    out2
}
// Shared by resolve_module and check_validate.
empty_params* = () [Param] { slice(null_ptr(), 0) }
fn_params* = (decls: [Decl], fn: string_view) [Param] { decls.the_func(fn).params }
is_void_ty* = (t: Ty) bool {
    t.match ({
        .Void => true,
        _     => false,
    })
}
