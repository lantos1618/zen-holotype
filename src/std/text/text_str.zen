// src/std/text/text_str.zen
// str — a borrowed view of text: a pointer and a byte count. No alloc, no
// growth, no allocator, no ownership. String literals are str, living in
// static memory.
//
// str is BYTES, never pretends otherwise: `len` is a byte count, `s[i]`
// yields a u8, `==` is bytewise — "héllo".len is 6 not 5, "héllo"[1] is the
// first byte of a two-byte sequence, not 'e'. UTF-8 is a set of FUNCTIONS
// over these bytes (text_utf8.zen), paid for only where wanted.

Ptr = std.mem.mem
Eq, Hash, Hasher = std.core.core

str* = {
    data: Ptr<u8>,
    len*: usize,      // * so a byte count is readable outside this module

    is_empty* = (self: @Self) bool { self.len == 0 }

    // the lookup-can-legitimately-miss form (Vec.get's shape). text_utf8
    // reads through this: a sequence running off the end is bad input,
    // not a bug
    get* = (self: @Self, i: usize) Res<u8> {
        (i < self.len).match({
            true  => Ok(self.data.read(i)),
            false => None,
        });
    }

    // what `s[i]` means. Out of range is a BUG not a miss, so it TRAPS —
    // DESIGN.md's fixed-array failure rule, applied to bytes.
    // `self.len - i - 1` underflows for every i >= len; unsigned
    // underflow IS the trap, no branch needed.
    index* = (self: @Self, i: usize) u8 {
        self.len - i - 1;
        self.data.read(i);
    }

    // a view into a view: same bytes, no copy, no alloc. Out of range
    // traps the same way `index` does — the two subtractions ARE the
    // bounds check
    slice* = (self: @Self, from: usize, to: usize) str {
        tail = self.len - to;
        str(data: self.data.offset(from), len: self.len - from - tail);
    }
}

// the only way to build a str outside this module: `data` carries no star,
// so a raw pointer never reaches the surface. String.view borrows through it
str_at* = (data: Ptr<u8>, len: usize) str { str(data: data, len: len) }

// FNV's basis and prime. Zen has no bitwise operators, so this is FNV-1a's
// shape with a wrapping add where the xor would be
STR_HASH_SEED*: u64 = 14695981039346656037
STR_HASH_MULT*: u64 = 1099511628211

// lexicographic byte order: first differing byte decides, shorter wins a
// prefix tie. Bytes not collation — "Z" precedes "a" (0x5A < 0x61); a
// language-aware ordering needs std.text.text_utf8 and a codepoint.
//
// Lives here (no module name fits "orders two byte strings" better) since
// THREE components had each written their own — sema's type-key ordering,
// the backend's section sort, deterministic emit — and gen_c must be a pure
// function of its input, so all three need the SAME six lines.
before* = (self: str, other: str) bool {
    shorter = (self.len < other.len).match({
        true  => self.len,
        false => other.len,
    });
    Range(0, shorter).find((i) { self.index(i) != other.index(i) }).match({
        Ok(i) => self.index(i) < other.index(i),
        None  => self.len < other.len,
    });
}

str.impl(Eq, {
    // bytewise, and the LENGTH is part of it: a prefix isn't the whole.
    // Comparing over the shorter length is the classic bug, so lengths
    // decide first
    eq ::= (self: @Self, other: @Self) bool {
        (self.len == other.len).match({
            false => false,
            true  => Range(0, self.len)
                .find((i) { self.data.read(i) != other.data.read(i) })
                .match({
                    Ok(_) => false,
                    None  => true,
                }),
        });
    }
})

str.impl(Hash, {
    // over the BYTES, never the pointer — matches `==`. A field-wise
    // default would hash `data` (an address) and Map<str, V> would miss
    // every lookup. `*%`/`+%` wrap: overflowing past u64 is the intent.
    hash ::= (self: @Self, hasher :: Hasher) u64 {
        acc ::= STR_HASH_SEED;
        Range(0, self.len).loop((h, i) {
            acc = acc *% STR_HASH_MULT +% self.data.read(i).to_u64();
        });
        acc;
    }
})
