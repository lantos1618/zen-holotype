// A Zen struct is a VALUE: C copies it at every binding (`S b = a;` copies the bytes), so a write
// through `b` cannot be seen through `a`. A JS object is a reference, so aggregate sinks must copy.
//
// The copy is emitted at the sinks C copies at (js_expr/js_decl call in here): a `let`, an assignment,
// PARAMETER entry, a struct-literal field, an enum payload, a match-arm payload bind, a `return`, a
// slice-literal item, and an indexed element store.
//
// What is copied and what is deliberately shared, field by field, from the static type:
//   • a nested struct/enum field  -> copied (C copies the whole aggregate, so `b.inner.v = 9` is
//     invisible through `a`). A shallow `{...a}` would alias it; this walks the declared field types.
//   • a `[T]` slice field         -> its 16-byte {ptr,len} HEADER is copied and the BUFFER is shared,
//     exactly as C copies the `zslice` struct and leaves the pointee alone. So `b.s.len = 2` is
//     private to `b` (C: `b.s` is b's own header) while `b.s[0] = 9` is visible through `a` (C: both
//     headers hold the same `ptr`). Copying the buffer would be the wrong answer, not a safer one.
//   • a pointer / str / fn field  -> shared (C copies the POINTER; the pointee stays one object). This
//     is why the copy cannot be a runtime "deep-clone anything object-shaped": on this target a
//     `MutPtr<T>` IS the JS object, so cloning one would silently fork an allocator or a list node.
//     Only the static field type separates the two, which is why the walk lives at emit time.
// A type whose fields ALL share needs no walk: `__zr.cp` (one spread) is its whole copy. A type with
// at least one field to copy gets a generated `__zc_<Name>` that spreads and then overrides exactly
// those fields.
{ String } = std.text.string
{ Ty, StructDecl, EnumDecl, Field, VariantDef } = compiler.ast.ast_types
{ gstr_append, tvoid, tnamed } = compiler.genc
{ Allocator } = std.mem.alloc
{ js_size_decls } = compiler.backend.js.js_size
{ loop_at } = std.core.count
// copy MODES: 0 = share (scalar, pointer, unknown type — as C shares a copied pointer), 1 = one
// spread (`__zr.cp`: a slice header, or an aggregate whose every field shares), 2 = the generated
// per-type walk `__zc_<Name>`.
jsc_share = () i32 { 0 }
jsc_spread = () i32 { 1 }
jsc_walk = () i32 { 2 }
js_cp_mode = (t: Ty) i32 { jsc_mode(t, 0) }
// does a value of this type COPY at a sink? (false = C shares it too: a scalar, a pointer, a fn.)
js_cp_needed* = (t: Ty) bool { js_cp_mode(t) != jsc_share() }
jsc_mode = (t: Ty, depth: i32) i32 {
    (depth > 24).then({
        return jsc_share()
    })
    t.match ({
        .Slice(e)   => jsc_spread(),
        .Named(n)   => jsc_name_mode(n, depth),
        .Generic(g) => jsc_name_mode(g.mangled, depth),
        _           => jsc_share(),
    })
}
// a declared struct/enum copies; anything else named (a foreign or opaque type) shares.
jsc_name_mode = (n: StringView, depth: i32) i32 {
    r ::= jsc_share()
    js_size_decls().loop_at((i, d) {
        r = d.match ({
            .DStruct(sd) => (sd.name == n).then({ jsc_fields_mode(sd.fields, depth) }, { r }),
            .DEnum(ed)   => (ed.name == n).then({ jsc_variants_mode(ed.variants, depth) }, { r }),
            _            => r,
        })
    })
    r
}
jsc_fields_mode = (fs: MutSlice<Field>, depth: i32) i32 {
    m ::= jsc_spread()
    fs.loop_at((i, f) { m = (jsc_mode(f.ty, depth + 1) == jsc_share()).then({ m }, { jsc_walk() }) })
    m
}
jsc_variants_mode = (vs: MutSlice<VariantDef>, depth: i32) i32 {
    m ::= jsc_spread()
    vs.loop_at((i, v) {
        m = (jsc_mode(v.payload, depth + 1) == jsc_share()).then({ m }, { jsc_walk() })
    })
    m
}
jsc_helper = (s: String, a: Allocator, t: Ty) String {
    s.gstr_append(a, "__zc_").gstr_append(a, jsc_ty_name(t))
}
jsc_ty_name = (t: Ty) StringView {
    t.match ({
        .Named(n)   => n,
        .Generic(g) => g.mangled,
        _           => "",
    })
}
// wrap an emitted expression in its copy: `__zr.cp(e)` / `__zc_T(e)` / `e` unchanged.
js_cp_open* = (s: String, a: Allocator, t: Ty) String {
    m = js_cp_mode(t)
    (m == jsc_spread()).then({
        return s.gstr_append(a, "__zr.cp(")
    })
    (m == jsc_walk()).then({ s.jsc_helper(a, t).gstr_append(a, "(") }, { s })
}
js_cp_close* = (s: String, a: Allocator, t: Ty) String {
    (js_cp_mode(t) == jsc_share()).then({ s }, { s.gstr_append(a, ")") })
}
// ── the generated per-type walks ──────────────────────────────────────────────────────────────────
// One `function __zc_<Name>(x)` per declared type that has a field to copy. Emitted at the top of the
// module; JS hoists function declarations, so a global initializer may already call one.
js_copy_defs* = (s: String, a: Allocator) String {
    out ::= s
    js_size_decls().loop_at((i, d) {
        out = d.match ({
            .DStruct(sd) => (jsc_fields_mode(sd.fields, 0) == jsc_walk()).match ({
                true  => out.jsc_struct_def(a, sd),
                false => out,
            }),
            .DEnum(ed)   => (jsc_variants_mode(ed.variants, 0) == jsc_walk()).match ({
                true  => out.jsc_enum_def(a, ed),
                false => out,
            }),
            _            => out,
        })
    })
    out
}
jsc_struct_def = (s: String, a: Allocator, sd: StructDecl) String {
    out ::= s
        .gstr_append(a, "function __zc_")
        .gstr_append(a, sd.name)
        .gstr_append(a, "(x) { return ({ ...x")
    sd.fields.loop_at((i, f) {
        out = (js_cp_mode(f.ty) == jsc_share()).match ({
            true  => out,
            false => out
                .gstr_append(a, ", ")
                .gstr_append(a, f.name)
                .gstr_append(a, ": ")
                .jsc_field_copy(a, f),
        })
    })
    out.gstr_append(a, " }); }\n")
}
jsc_field_copy = (s: String, a: Allocator, f: Field) String {
    s
        .js_cp_open(a, f.ty)
        .gstr_append(a, "x.")
        .gstr_append(a, f.name)
        .js_cp_close(a, f.ty)
}
// an enum is `{ tag, <Variant>: payload }`: spread the tag, and override only the payload of the
// variants that carry something to copy — a `.None` must not grow a payload key it never had.
jsc_enum_def = (s: String, a: Allocator, ed: EnumDecl) String {
    out ::= s
        .gstr_append(a, "function __zc_")
        .gstr_append(a, ed.name)
        .gstr_append(a, "(x) { switch (x.tag) { ")
    ed.variants.loop_at((i, v) {
        out = (js_cp_mode(v.payload) == jsc_share()).then({ out }, { out.jsc_variant_case(a, v) })
    })
    out.gstr_append(a, "} return ({ ...x }); }\n")
}
jsc_variant_case = (s: String, a: Allocator, v: VariantDef) String {
    s
        .gstr_append(a, "case \"")
        .gstr_append(a, v.name)
        .gstr_append(a, "\": return ({ ...x, ")
        .gstr_append(a, v.name)
        .gstr_append(a, ": ")
        .js_cp_open(a, v.payload)
        .gstr_append(a, "x.")
        .gstr_append(a, v.name)
        .js_cp_close(a, v.payload)
        .gstr_append(a, " }); ")
}
// ── decl lookups the type reconstruction (js_expr.js_ty_of) needs ─────────────────────────────────
// `obj.field` where obj is a struct — or, after genc's `.u` union level, an enum PAYLOAD (`subj.u.Ok`).
jsc_member_ty* = (t: Ty, field: StringView) Ty {
    n = jsc_ty_name(t)
    r ::= tvoid()
    js_size_decls().loop_at((i, d) {
        r = d.match ({
            .DStruct(sd) => (sd.name == n).then({ jsc_field_ty(sd.fields, field) }, { r }),
            .DEnum(ed)   => (ed.name == n).then({ jsc_payload_ty(ed.variants, field) }, { r }),
            _            => r,
        })
    })
    r
}
jsc_field_ty = (fs: MutSlice<Field>, name: StringView) Ty {
    r ::= tvoid()
    fs.loop_at((i, f) { r = (f.name == name).then({ f.ty }, { r }) })
    r
}
jsc_payload_ty = (vs: MutSlice<VariantDef>, name: StringView) Ty {
    r ::= tvoid()
    vs.loop_at((i, v) { r = (v.name == name).then({ v.payload }, { r }) })
    r
}
// the payload a match arm BINDS (`.Ok(v) => …`), by enum name.
js_variant_ty* = (ename: StringView, variant: StringView) Ty {
    r ::= tvoid()
    js_size_decls().loop_at((i, d) {
        r = d.match ({
            .DEnum(ed) => (ed.name == ename).then({ jsc_payload_ty(ed.variants, variant) }, { r }),
            _          => r,
        })
    })
    r
}
// a field of a struct literal `S(f: v)`, by the literal's monomorphized type name.
js_init_ty* = (sname: StringView, field: StringView) Ty { jsc_member_ty(tnamed(sname), field) }
// the return type of a DEFINED function, and whether the name is one. A call to a defined function
// yields a FRESH value (its `return` copies), which is what lets a sink elide its own copy.
js_func_ret* = (name: StringView) Ty {
    r ::= tvoid()
    js_size_decls().loop_at((i, d) {
        r = d.match ({
            .DFunc(f) => (f.name == name).then({ f.ret }, { r }),
            _         => r,
        })
    })
    r
}
js_is_defined_fn* = (name: StringView) bool {
    found ::= false
    js_size_decls().loop_at((i, d) {
        found = found
            || d.match ({
                .DFunc(f) => f.name == name,
                _         => false,
            })
    })
    found
}
