// tests/harness.zen — the thin MAIN of the Zen-native correctness harness (the self-hosted replacement
// for the pytest value/verdict harness). It imports the harness library + each category file and sums
// their fail counts into one final pass/fail exit status. NO Python anywhere — the compiler tests itself, in
// itself, by driving the committed `zenc` binary via std.io.
//
//   make -f bootstrap/Makefile harness   # build this with zenc, run it; exit 0 only when all pass
//
// ── ADDING A CATEGORY ────────────────────────────────────────────────────────────────────────────
// A category agent writes tests/harness_<cat>.zen exporting `harness_<cat>_run*() i32` (see harness_lib.zen
// for the contract). Wire it in here with two edits: import its run fn, and add it to the sum below.
// The `harness_<cat>_run` names are unique, so the flat imports never collide.
{ fixpoint_ok, run_suite, zo_ensure, zo_cleanup } = harness_lib
{ harness_value_run } = harness_value
{ harness_verdict_run } = harness_verdict
{ harness_build_run } = harness_build
{ harness_modules_run } = harness_modules
{ harness_boundaries_run } = harness_boundaries
{ harness_misc_run } = harness_misc
{ harness_fuzz_run } = harness_fuzz
{ harness_argparse_run } = harness_argparse
{ harness_datetime_run } = harness_datetime
{ harness_fmt_roundtrip_run } = harness_fmt_roundtrip
{ harness_lsp_run } = harness_lsp
{ out } = std.io.file
{ getEnv } = std.sys.os
{ is_empty } = std.text.str
main* = () i32 {
    // FAST mode (env ZEN_HARNESS_FAST set non-empty, e.g. `make harness-fast`): run ONLY the quick
    // deterministic correctness suites (value + verdict) and skip the slow subprocess-heavy
    // ones (modules ~90s of multi-file builds, build/boundaries/misc/fuzz, + the full self-host
    // fixpoint). For inner-loop iteration; the full `make harness` stays the merge gate.
    fast := is_empty(getEnv("ZEN_HARNESS_FAST")) ? false : true
    // create this run's private scratch dir BEFORE any case writes into it (see harness_lib zo_*).
    zo_ensure()
    fails := 0
    // fast subset — always run (deterministic, a few seconds).
    fails = fails + harness_value_run()
    fails = fails + harness_verdict_run()
    // slow subprocess-heavy suites — only when NOT in fast mode. `match` is control flow, so in fast
    // mode the false arm (every slow suite call) is never evaluated.
    fails = fails + (fast.match ({
        true  => 0,
        false => harness_modules_run() + harness_build_run() + harness_boundaries_run() + harness_misc_run() + harness_fuzz_run() + harness_argparse_run() + harness_datetime_run() + harness_fmt_roundtrip_run() + harness_lsp_run() + run_suite("fixpoint", [fixpoint_ok()]),
    }))
    // remove this run's private scratch dir (unique per pid, so cleanup is best-effort housekeeping).
    zo_cleanup()
    (fails == 0).match ({
        true  => {
            out("\nzen harness: ALL PASS\n")
            0
        },
        false => {
            // POSIX exit status is only 8 bits: returning the raw count makes exactly 256/512/…
            // failures appear as success. The F marks above carry detail; process status is boolean.
            out("\nzen harness: FAILURES above (see F marks)\n")
            1
        },
    })
}
