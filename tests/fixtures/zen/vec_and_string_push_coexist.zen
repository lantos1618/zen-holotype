halloc = std.mem.heap
vec = std.collections.vec
{ String, init } = std.text.string
{ expect } = std.core.result
main = () i32 {
    alloc = halloc.gpa()
    a = alloc.addr()
    v = vec.of(a, [10, 20]).expect("of")
    v2 = v.push(a, 30).expect("push")
    s = a.init(4).expect("init")
    s2 = s.push_in(a, '!').expect("push_in")
    out = v2.get(2) + to_i32(s2.len)
    v2.free(a)
    s2.free_in(a)
    out
}
