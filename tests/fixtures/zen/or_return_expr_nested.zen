// NESTED .or_return(): `f(g(ok).or_return()).or_return()` hoists innermost-first, so the inner
// receiver's Err wins over the outer one. Exit 37 = h(1) yields Ok(31); h(0) propagates the INNER
// .NotFound (6), proving f() is never called on the Err path.
{ Result, IoError } = std.core.result
g = (ok: i32) Result<i32, IoError> { (ok >= 1).match ({ true => .Ok(3), false => .Err(.NotFound) }) }
f = (n: i32) Result<i32, IoError> { (n > 0).match ({ true => .Ok(n * 10), false => .Err(.Denied) }) }
h = (ok: i32) Result<i32, IoError> {
    x := f(g(ok).or_return()).or_return()
    .Ok(x + 1)
}
main = () i32 {
    a := h(1).match ({
        .Ok(v)  => v,
        .Err(e) => 0,
    })    // 31
    b := h(0).match ({
        .Ok(v)  => 0,
        .Err(e) => e.match ({
            .NotFound => 6,
            _         => 5,
        }),
    })    // 6 — the INNER Err, in evaluation order
    a + b
}
