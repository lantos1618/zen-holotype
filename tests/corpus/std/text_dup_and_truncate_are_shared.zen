dup, truncate_with = std.text

main = (env: Env) Res<(), AllocError> {
    a = env.mem.alloc();
    println("{}", "abcdef".truncate_with(a, 3, "...").try());
    println("{}", "abc".truncate_with(a, 3, "...").try());
    println("{}", "copied".dup(a).try());
    println("empty {}", "".dup(a).try().len);
    Ok(())
}
