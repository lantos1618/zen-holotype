// tests/must-fail/sema/construction_names_a_constant.zen
//
// `y: i32 = 20` in a struct body is a CONSTANT — one value per type,
// read as `A.y` (DESIGN.md: "the spelling is what decides"). A
// construction names fields, so `y` is not nameable: before this rule
// sema type-checked the supplied value against the constant's type and
// gen_c then wrote nothing for it, so the program ran and printed the
// declaration's value with the caller's discarded. The default that IS
// supplyable is spelled `::`.
//
// position: the argument's name.

A = {
    x: i32,
    y: i32 = 20,
}

main = (env: Env) Res<i32, AllocError> {
    b = A(x: 1, y: 2);
    println("{}", b.x);
    Ok(0);
}
