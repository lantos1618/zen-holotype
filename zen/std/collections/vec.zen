// std.collections.vec — generic growable Vec<T> with explicit allocator-threaded storage.
// Fallible ops (`of`, `push`, `grow`) return Result<Vec<T>, IoError> — allocation failure is a
// value: `.expect("…")` at fail-fast roots, `.or_return()` inside Result-returning fns.
// @self-hosted-only: generic struct literals are covered by self-hosted tests.
{ Allocator, try_acquire, try_resize } = std.mem.alloc
{ Result, IoError, Opt } = std.core.result
{ Rt, current } = std.rt    // ambient runtime capability — the AMBIENT-FORM surface below draws from it
Vec*<T>: {
    ptr: RawPtr<u8>,
    len: i64,
    cap: i64,
    buf = (v: Vec<T>) [T] { slice(v.ptr, v.cap) }
    view = (v: Vec<T>) [T] {
        // a slice over exactly the `len` live elements (NOT `cap` — excludes uninitialized storage).
        // Use this to iterate, just like any `[T]`: `v.view().loop((h, i, x) { ... })`.
        slice(v.ptr, v.len)
    }
    len = (v: Vec<T>) i64 { v.len }
    get = (v: Vec<T>, i: i64) T { v.buf()[i] }
    grow<A> = (v: Vec<T>, a: MutPtr<A>) Result<Vec<T>, IoError> {
        ncap := v.cap * 2 + 1
        a.try_resize(v.ptr, ncap * sizeof(T)).match ({
            .Ok(p)  => {
                vok: Result<Vec<T>, IoError> := .Ok(Vec<T>(
                    ptr: p,
                    len: v.len,
                    cap: ncap,
                ))
                vok
            },
            .Err(e) => {
                verr: Result<Vec<T>, IoError> := .Err(e)
                verr
            },
        })
    }
    push<A> = (v: Vec<T>, a: MutPtr<A>, x: T) Result<Vec<T>, IoError> {
        x := x
        out: Result<Vec<T>, IoError> := (v.len < v.cap).match ({ true => {
            b := v.buf()
            b[v.len] = x
            vok: Result<Vec<T>, IoError> := .Ok(Vec<T>(
                ptr: v.ptr,
                len: v.len + 1,
                cap: v.cap,
            ))
            vok
        }, false => {
            v.grow(a).match ({
                .Ok(r)  => {
                    b := r.buf()
                    b[r.len] = x
                    vok: Result<Vec<T>, IoError> := .Ok(Vec<T>(
                        ptr: r.ptr,
                        len: r.len + 1,
                        cap: r.cap,
                    ))
                    vok
                },
                .Err(e) => {
                    verr: Result<Vec<T>, IoError> := .Err(e)
                    verr
                },
            })
        } })
        out
    }
    free<A> = (v: Vec<T>, a: MutPtr<A>) void { a.release(v.ptr) }
    each = (v: Vec<T>, f: (T) void) void {
        // Higher-order helpers over the live elements (`view()`), backed by closures — inline lambdas and
        // stored closures both work. Spelled inline (over `view().loop`) rather than delegating to
        // std.collections.iter, so this module imports no free `fold`/`each`/`find` names — those
        // would re-export and clash with same-named helpers (e.g. `map.find`) in programs that co-import vec
        // and map. `each`/`fold`/`find` allocate nothing; `map`/`filter` thread the allocator and return a
        // fresh Vec (no hidden heap). The `vw: [T] :=` intermediate pins the element type for the loop.
        vw: [T] := v.view()
        vw.loop((h, i, x) {
            f(x)
        })
    }
    fold = (v: Vec<T>, init: T, f: (T, T) T) T {
        acc := init
        vw: [T] := v.view()
        vw.loop((h, i, x) {
            acc = f(acc, x)
        })
        acc
    }
    find = (v: Vec<T>, pred: (T) bool) Opt<T> {
        out: Opt<T> := .None
        vw: [T] := v.view()
        vw.loop((h, i, x) {
            pred(x).match ({ true => {
                out = .Some(x)
                h.break
            }, false => { } })
        })
        out
    }
    map<A, U> = (v: Vec<T>, a: MutPtr<A>, f: (T) U) Vec<U> {
        p := a.acquire(v.len * sizeof(U))
        out: [U] := slice(p, v.len)
        vw: [T] := v.view()
        vw.loop((h, i, x) {
            out[i] = f(x)
        })
        Vec<U>(
            ptr: p,
            len: v.len,
            cap: v.len,
        )
    }
    filter<A> = (v: Vec<T>, a: MutPtr<A>, keep: (T) bool) Vec<T> {
        p := a.acquire(v.len * sizeof(T))
        out: [T] := slice(p, v.len)
        vw: [T] := v.view()
        n := 0
        vw.loop((h, i, x) {
            out[n] = x
            n = n + keep(x).match ({ true => 1, false => 0 })
        })
        Vec<T>(
            ptr: p,
            len: n,
            cap: v.len,
        )
    }
}
// a zero-element `Vec<T>` with capacity for at least one element (so `push` has somewhere to write
// before the first grow). T can't be read off any argument, so it comes from the LHS annotation:
// `v: Vec<i32> := vecs.empty(a)`. A is inferred from `a`. Pair with `push`/`free` like `of`.
empty*<T, A> = (a: MutPtr<A>) Vec<T> {
    Vec<T>(
        ptr: a.acquire(sizeof(T)),
        len: 0,
        cap: 1,
    )
}
// a `Vec<T>` seeded from a slice (copies `xs`), its buffer acquired from `a`. T inferred from `xs`, A from `a`.
of*<T, A> = (a: MutPtr<A>, xs: [T]) Result<Vec<T>, IoError> {
    (xs.len <= 0).match ({ true => {
        vok: Result<Vec<T>, IoError> := .Ok(Vec<T>(
            ptr: null_ptr(),
            len: 0,
            cap: 0,
        ))
        vok
    }, false => {
        a.try_acquire(xs.len * sizeof(T)).match ({
            .Ok(p)  => {
                v := Vec<T>(
                    ptr: p,
                    len: xs.len,
                    cap: xs.len,
                )
                b := v.buf()
                xs.loop((h, i, x) {
                    b[i] = x
                })
                vok: Result<Vec<T>, IoError> := .Ok(v)
                vok
            },
            .Err(e) => {
                verr: Result<Vec<T>, IoError> := .Err(e)
                verr
            },
        })
    } })
}
// ── AMBIENT FORM (rt-drawn) ────────────────────────────────────────────────────────────────────────
// An ADDITIVE surface that removes allocator threading: `v := vec.new()` then `v.push(x)` — no `a`
// argument anywhere. Everything above (the explicit `Vec<T>` + `of(a, …)` / `v.push(a, x)` forms) is
// UNCHANGED and remains the precise-control API; this section only adds new names on new types.
//
//   v: AVec<i32> := vec.new()          // T comes from the annotation (nothing to infer it from)
//   v  = v.push(1)                     // no allocator — bytes come from the ambient rt
//   v  = v.push(2)
//   n  := v.len()                      // 2
//   x  := v.get(0)                     // 1
//   v.each((y){ ... })                 // iterate the live elements
//   v.free()                           // hand storage back to the SAME rt that made it
//
//   w := vec.from([10, 20, 30])        // seed from a slice; T inferred from the elements
//
// STORE-NOT-REREAD (why AVec carries the rt). The ambient rt is captured ONCE, at construction, and
// stored in the header — every later op (grow, free) allocates through that SAME rt. It is NOT re-read
// from `current()` per op. Re-reading would be a correctness bug: if the container is created under one
// rt (e.g. an actor's per-actor heap, or an arena scope via `rt.with`) and then an op runs after the
// ambient rt has changed, `grow` would allocate the new buffer from rt B while the old buffer came from
// rt A — and then free the old buffer through rt B: a cross-allocator free (corruption). Storing the rt
// makes an AVec self-contained and safe to outlive the scope it was born in (Pony per-actor semantics).
//
// The ambient ops are FAIL-FAST on allocation failure (`.expect`, which panics) — the trivial-program
// ergonomic path. Callers who need allocation failure as a value keep using the explicit `Vec<T>` API,
// whose ops return `Result<Vec<T>, IoError>`.
// RtAlloc bridges a stored `Rt` to the `Allocator` trait, so the ambient wrappers can REUSE every
// existing explicit `Vec<T>` op verbatim (pass `ra.addr()` where an `a: MutPtr<A>` is expected). The
// three methods dispatch straight through the stored rt's vtable — the same path `rt.alloc/resize/release`
// take, but bound to THIS captured rt rather than `current()`.
RtAlloc*: {
    r: Rt,
}
RtAlloc.impl(Allocator, {
    acquire = (s: MutPtr<RtAlloc>, n: i64) RawPtr<u8> {
        rr := s.load().r
        rr.mem_acquire(rr.state, n)
    }
    resize = (s: MutPtr<RtAlloc>, p: RawPtr<u8>, n: i64) RawPtr<u8> {
        rr := s.load().r
        rr.mem_resize(rr.state, p, n)
    }
    release = (s: MutPtr<RtAlloc>, p: RawPtr<u8>) void {
        rr := s.load().r
        rr.mem_release(rr.state, p)
    }
})
// AVec<T> = an explicit `Vec<T>` plus the rt it was born under. All ops delegate to the `Vec<T>` methods
// through an `RtAlloc` materialized from the stored rt, so there is ZERO duplicated container logic.
AVec*<T>: {
    inner: Vec<T>,
    rt: Rt,
    len = (w: AVec<T>) i64 { w.inner.len() }
    get = (w: AVec<T>, i: i64) T { w.inner.get(i) }
    view = (w: AVec<T>) [T] { w.inner.view() }
    each = (w: AVec<T>, f: (T) void) void { w.inner.each(f) }
    fold = (w: AVec<T>, init: T, f: (T, T) T) T { w.inner.fold(init, f) }
    find = (w: AVec<T>, pred: (T) bool) Opt<T> { w.inner.find(pred) }
    push = (w: AVec<T>, x: T) AVec<T> {
        ra := RtAlloc(r: w.rt)
        AVec<T>(
            inner: w.inner.push(ra.addr(), x).expect("vec.push: out of memory"),
            rt: w.rt,
        )
    }
    free = (w: AVec<T>) void {
        ra := RtAlloc(r: w.rt)
        w.inner.free(ra.addr())
    }
}
// a zero-element ambient `AVec<T>` (capacity for one, like `empty`). T can't be inferred from an
// argument, so it comes from the LHS annotation: `v: AVec<i32> := vec.new()`. The ambient rt is
// captured HERE and stored for the life of the vec.
new*<T> = () AVec<T> {
    r := current()
    ra := RtAlloc(r: r)
    // `empty`'s T lives only in its return type; pin it via the annotation (nested-return inference
    // can't reach it through the struct-literal field), exactly as `v: Vec<i32> := vecs.empty(a)` does.
    iv: Vec<T> := empty(ra.addr())
    AVec<T>(
        inner: iv,
        rt: r,
    )
}
// an ambient `AVec<T>` seeded from a slice (copies `xs`). T inferred from the elements. Fail-fast on OOM.
from*<T> = (xs: [T]) AVec<T> {
    r := current()
    ra := RtAlloc(r: r)
    iv: Vec<T> := of(ra.addr(), xs).expect("vec.from: out of memory")
    AVec<T>(
        inner: iv,
        rt: r,
    )
}
