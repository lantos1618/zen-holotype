// Associated calls use their declared parameter list. A str cannot fill an
// i32 slot merely because the call has no receiver.

Tool = {
    double = (value: i32) i32 { value * 2 }
}

main = (env: Env) Res<i32, AllocError> {
    text: str = "wrong";
    println("{}", Tool.double(text));
    Ok(0);
}
