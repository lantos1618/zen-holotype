// A WALK OVER A TYPE PARAMETER (`docs/design_meta.md` §7, M4 slice 2).
// `<T>` has no declaration payload to read — the fields are a fact
// about a STRUCT, and which struct `T` means is the call site's
// business, not the body's. Refused by name, like a primitive's.
//
// position: the `@meta` token — the form that has nothing to walk.

show* = <T>(v: T) () {
    @meta(x: T).fields().loop((h, field) {
        println("{}", field.name);
    });
}

main = (env: Env) Res<i32, AllocError> {
    show(1);
    Ok(0);
}
