// tests/corpus/std/map_missing_key_is_none.zen
// get is Res<V>: an absent key is None. a lookup that can miss is
// not a bug, so it never traps - and a None never becomes an Err
// on its own

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    ages ::= alloc.Map<str, i32>();

    ages.set("ada", 36).try();

    ages.get("alan").match({
        Ok(n) => println("alan {}", n),
        None  => println("alan none"),
    })

    // and an empty map misses everything
    empty ::= alloc.Map<str, i32>();
    empty.get("ada").match({
        Ok(n) => println("empty {}", n),
        None  => println("empty none"),
    })
    Ok(0);
}
