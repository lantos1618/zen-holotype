// A type, and two free functions that travel with it. Neither function
// is ever imported by the caller — reaching them is the whole test.
//
// `boxed` DECLARES an `Alloc` and the caller holds an `Arena`, which is
// the shape every program in the language opens with: DESIGN.md's own
// `Vec* = <T>(a: Alloc) Vec<T>` is called as `alloc.Vec<i32>()` on the
// `Arena` that `env.mem.alloc()` returns.
//
// `labelled` is the same name on a different first parameter, and it is
// here so the test can tell a working gate from an absent one: a pool
// that admitted everything would hold both for either receiver.

Alloc, AllocError = std.mem
str = std.text

Box* = {
    n*: i32,

    twice* = (self: @Self) i32 { self.n * 2 }
}

boxed* = (a: Alloc, n: i32) Box { Box(n: n) }

labelled* = (s: str, n: i32) Box { Box(n: n + 3) }
