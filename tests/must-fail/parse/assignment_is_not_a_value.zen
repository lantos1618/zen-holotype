// An assignment is a STATEMENT, so it cannot be a block's trailing value:
// "a statement ends with `;`. A declaration does not" (DESIGN.md, Control
// flow) is the whole rule, and there is no assignment expression in Zen to
// produce a value from -- C's assignment-as-an-expression is a hazard the
// language does not carry.
//
// So the correct spelling is `.then(() { x = 1; })`, and the design call
// this test records is that the LANGUAGE is right and the DIAGNOSTIC was
// wrong: "expected expression" named a thing the author did not want and
// did not name the `;` that fixes it.
//
// position: the missing `;`, which is where the fix goes.

main = (env: Env) Res<i32, AllocError> {
    x ::= 0;
    (x == 0).then(() { x = 1 });
    println("{}", x);
    Ok(0);
}
