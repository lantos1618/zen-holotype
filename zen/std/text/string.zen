// std.text.string — a growable, allocator-backed byte String, ASSEMBLED at runtime.
//
// `str` is a comptime C-string literal; a `String` is built while the program runs —
// the keystone for runtime code generation (a backend that emits source as a value).
// The API is functional: each op returns the updated String. The (ptr, len, cap)
// header is a small value passed by copy; the byte buffer is realloc'd underneath, so
// a builder reads `s := s.push_in(alloc, 'x').expect("oom")` — threading the header, sharing the buffer.
//
// Construction always takes an allocator, so programs can choose heap, arena, stack, or test allocators.
// Every op that allocates returns Result<_, IoError> — allocation failure is a value:
//
//   m := default()
//   m.addr().init(64).match({ .Ok(s) => ..., .Err(e) => ... })
//   s = s.append_in(m.addr(), "hello").expect("oom")    // or .or_return() in a Result fn
//   s.free_in(m.addr())
{ len, view } = std.text.str
{ Allocator, try_acquire, try_resize } = std.mem.alloc
{ Result, IoError, ok, err } = std.core.result
String*: {
    ptr: RawPtr<u8>,
    len: i64,
    cap: i64,
    bytes = (s: String) [u8] { s.ptr.slice(s.len) }
    grow_in<A> = (s: String, a: MutPtr<A>, ncap: i64) Result<String, IoError> { a.grow_in(s, ncap) }
    reserve_in<A> = (s: String, a: MutPtr<A>, need: i64) Result<String, IoError> { a.reserve_in(s, need) }
    push_in<A> = (s: String, a: MutPtr<A>, b: u8) Result<String, IoError> { a.push_in(s, b) }
    append_in<A> = (s: String, a: MutPtr<A>, t: str) Result<String, IoError> { a.append_in(s, t) }
    finish_in<A> = (s: String, a: MutPtr<A>) Result<str, IoError> { a.finish_in(s) }
    free_in<A> = (s: String, a: MutPtr<A>) void { a.free_in(s) }
}
copy_str_bytes = (dst: RawPtr<u8>, at: i64, t: str) void {
    src := t.view()
    src.loop((h, i, b) {
        dst.offset(at + i).store(b)
    })
}
// ── explicit allocator variants (all fallible ops return Result) ─────────────
init*<A> = (a: MutPtr<A>, cap: i64) Result<String, IoError> {
    a.try_acquire(cap).match ({
        .Ok(p)  => ok(String(
            ptr: p,
            len: 0,
            cap: cap,
        )),
        .Err(e) => err(e),
    })
}
new_in*<A> = (a: MutPtr<A>) Result<String, IoError> { a.init(16) }
grow_in<A> = (a: MutPtr<A>, s: String, ncap: i64) Result<String, IoError> {
    a.try_resize(s.ptr, ncap).match ({
        .Ok(p)  => ok(String(
            ptr: p,
            len: s.len,
            cap: ncap,
        )),
        .Err(e) => err(e),
    })
}
// Force `s` to a local FIRST: this function is inlined (generic over A), and `s` is read several
// times. If the caller passes a non-trivial expression — e.g. a long `.push_in(…)` builder chain —
// an unbound `s` splices that whole subtree in at every read, and nested builders compound it to
// EXPONENTIAL inlined size (and compile time). Binding once emits the subtree a single time; the
// reads reference the cheap local. Keeps allocator-threaded String builders linear to inline.
reserve_in<A> = (a: MutPtr<A>, s: String, need: i64) Result<String, IoError> {
    s := s
    (s.len + need > s.cap).match ({ true => a.grow_in(s, (s.cap + need) * 2), false => ok(s) })
}
// Force value args to locals first so callers may safely pass expressions that read `s`.
push_in*<A> = (a: MutPtr<A>, s: String, b: u8) Result<String, IoError> {
    b := b
    a.reserve_in(s, 1).match ({
        .Ok(r)  => {
            r.ptr.offset(r.len).store(b)
            ok(String(
                ptr: r.ptr,
                len: r.len + 1,
                cap: r.cap,
            ))
        },
        .Err(e) => err(e),
    })
}
append_in*<A> = (a: MutPtr<A>, s: String, t: str) Result<String, IoError> {
    t := t
    n := t.len()
    a.reserve_in(s, n).match ({
        .Ok(r)  => {
            r.ptr.copy_str_bytes(r.len, t)
            ok(String(
                ptr: r.ptr,
                len: r.len + n,
                cap: r.cap,
            ))
        },
        .Err(e) => err(e),
    })
}
finish_in*<A> = (a: MutPtr<A>, s: String) Result<str, IoError> {
    a.push_in(s, 0).match ({
        .Ok(done) => ok(cstr(done.ptr)),
        .Err(e)   => err(e),
    })
}
free_in*<A> = (a: MutPtr<A>, s: String) void { a.release(s.ptr) }
