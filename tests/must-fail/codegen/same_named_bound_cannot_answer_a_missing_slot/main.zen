// Bound identity is its declaration, not its spelling. The sibling module's
// same-spelled Optional impl cannot fill this Optional's slot.

Answered = optional.optional

Optional = {
    read* ::= (self: @Self) i32
}

through = (value: Optional) i32 { value.read() }

main = (env: Env) Res<i32, AllocError> {
    answered = Answered();
    println("{}", through(Optional()));
    Ok(0);
}
