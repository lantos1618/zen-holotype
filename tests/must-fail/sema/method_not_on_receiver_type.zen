// `size` is declared, but on Bag -- and a Bag is not what `b` is. a
// method is resolved on its receiver's type, so a name that belongs to
// an unrelated type is not a candidate and the diagnostic has to name
// the type that was actually asked.
//
// position: the method name, after the dot.

Box = {
    w: i32,
}

Bag = {
    n: i32,
    size = (self: @Self) i32 { self.n }
}

main = (env: Env) Res<i32, AllocError> {
    b = Box(w: 3);
    println("{}", b.size());
    Ok(0);
}
