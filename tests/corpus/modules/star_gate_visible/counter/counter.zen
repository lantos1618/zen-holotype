// the * gate, positive side: Counter crosses the boundary with total
// and add. step has no star, so nothing outside can name it

Counter* = {
    total* :: i32,

    add* = (self :: @Self, n: i32) () {
        self.total = self.total + self.step(n);
    }

    step = (self: @Self, n: i32) i32 { n * 2 }
}
