// `h.break("x")` OVER AN INTEGER WALK — REFUSED, at the break.
//
// The rule is `src/std/core/loop/loop_handle.zen`'s own: break's `T` is
// "the enclosing loop's own T, fixed by the loop this handle names,
// never by the call". Sema never sees either side of that question —
// `h` is a handle, bound by the backend with no type, and sema does not
// walk lambda bodies at all — so `gen_c_handle.break_value_fits` asks it
// where the two types actually meet: against the frame's settled payload,
// the same settlement `assign_ok` writes the value AT.
//
// Before that check existed this program reached cc: the loop's result
// temporary was declared `Res<int>` and its `Ok` slot initialised with
// a `str` compound literal. The wider danger is the one cc cannot see:
// an integer of another width converts silently and answers garbage
// (`tests/corpus/std/loop_break_type_is_the_loops_own.zen` pins that
// face).
//
// position: the break call.

main = (env: Env) Res<i32, AllocError> {
    [1].loop((h, v) {
        h.break("x");
    });
    Ok(0);
}
