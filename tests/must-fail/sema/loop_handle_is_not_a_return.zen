// A LOOP HANDLE IS NOT A VALUE, so no body EVALUATES to one. Its
// siblings pin the BINDING (`loop_handle_is_not_a_value`) and the
// ARGUMENT (`loop_handle_is_not_an_argument`); this pins the RETURN
// face #807 named. A loop body has no return-type slot, so
// `check_return` never saw it: sema stayed silent while gen_c emitted
// `(void)(zu_l1h);` reading the undeclared handle, refused by cc alone.
//
// `sema_type.block_type` now asks the question where every block's
// value is decided, so the refusal names the tail.
//
// position: `h`, the value the block was made to evaluate to.

main = (env: Env) Res<i32> {
    Range(0, 1).loop((h, x) {
        h
    });
    Ok(0);
}
