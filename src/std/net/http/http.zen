// HTTP/1.1 client API.

Alloc = std.mem
str, String = std.text
Res = std.core
Sink = std.core.io
Vec = std.collections

HttpError*, HttpResponseMeta*, HttpResponse* = std.net.http.http_types
parse_response_into*, parse_response* = std.net.http.http_decode

http_url, build_request = std.net.http.http_request
Stream, connect_stream, write, close = std.net.http.http_transport
read_response_into = std.net.http.http_decode

HttpClient* = {
    // A sink write completes before the next read, providing backpressure.
    post_into* = (self: @Self, a: Alloc, url: str, headers: Vec<str>,
                  body: str, out :: Sink)
                  Res<HttpResponseMeta, HttpError> {
        parsed = url.http_url().try();
        req    = parsed.build_request(a, headers, body).try();
        stream = parsed.connect_stream(a).try();
        stream.write(req.view()).try();
        meta = stream.read_response_into(a, out).try();
        // The move disarms the drop Stream carries, so this is the one close;
        // every `.try()` above exits through that drop instead.
        (consume stream).close();
        Ok(meta)
    }

    // Buffered compatibility API. HTTP status remains in the response so its
    // body is available to protocol clients; Err is reserved for transport.
    post* = (self: @Self, a: Alloc, url: str, headers: Vec<str>, body: str)
            Res<HttpResponse, HttpError> {
        response_body ::= a.String().try(HttpError.RecvFailed);
        meta = self.post_into(a, url, headers, body, response_body).try();
        Ok(HttpResponse(status: meta.status, body: response_body));
    }
}
