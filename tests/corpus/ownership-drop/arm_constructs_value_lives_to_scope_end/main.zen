// a value CONSTRUCTED in a match arm and handed OUT to a binding drops
// under that binding, at the binding's position in the frame — the arm
// is an expression, not an owner. only ONE Noisy ever exists (n == 1),
// so exactly one drop runs and it comes after both printlns; a backend
// that dropped the arm's temporary when the arm finished would print
// "drop 20" before "picked", or drop nothing at all if it also skipped
// temporaries. the false arm exists so neither arm is dead code.

Noisy = {
    env: Env,
    id: i32,
}

Noisy.impl(Drop, {
    drop = (self :: @Self) () { self.env.out.println("drop {}", self.id) }
})

main = (env: Env) Res<i32, IoError> {
    n = 1;
    picked = (n == 1).match({
        true  => Noisy(env: env, id: 20),
        false => Noisy(env: env, id: 30),
    });
    println("picked {}", picked.id);
    println("end");
    Ok(0);
}
