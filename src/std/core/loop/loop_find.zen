// Derived loop operations. find does not allocate; filter and map collect into
// caller-owned arena vectors.
Res, Ok, None = std.core.result
then          = std.core.bool
Alloc         = std.mem
Vec           = std.collections
Range         = std.core.range
LoopHandle    = std.core.loop.loop_handle
loop          = std.core.loop.loop_iter

// First element accepted by the predicate, or None.
find*<R: Range<T>, T> = (range: R, pred: (value: T) bool) Res<T> {
    range.loop((h, value) {
        pred(value).then(() { h.break(value) });
    })
}

// Every accepted element in order. No matches yields an empty Vec; None means
// allocation failed.
filter*<R: Range<T>, T> = (range: R, alloc: Alloc, pred: (
    value : T
) bool) Res<Vec<T>> {
    kept ::= alloc.Vec<T>();
    room ::= true;
    range.loop((h, value) {
        pred(value).then(() {
            kept.add(value).match({
                Ok(_)  => (),
                Err(_) => { room = false; h.break(); },
            });
        });
    });
    room.match({
        true  => Ok(kept),
        false => None,
    })
}

// Collect one value per element. The handle permits an early, successful stop.
map*<R: Range<T>, T, U> = (range: R, alloc: Alloc, body: (
    h     : LoopHandle,
    index : usize,
    value : T
) U) Res<Vec<U>> {
    made ::= alloc.Vec<U>();
    room ::= true;
    range.loop((h, index, value) {
        made.add(body(h, index, value)).match({
            Ok(_)  => (),
            Err(_) => { room = false; h.break(); },
        });
    });
    room.match({
        true  => Ok(made),
        false => None,
    })
}
