// a struct may reach itself through Ptr: a pointer is one word wide, so
// the layout terminates. TESTING.md, Sema: `Node = { next: Ptr<Node> }`
// is legal, and only a field of the struct's own type is not.

Node = {
    value: i32,
    next: Ptr<Node>,
}

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();

    // the node points at itself, so the cycle needs no terminator and
    // the test needs no null pointer
    p = alloc.create<Node>().try();
    p.write(0, Node(value: 7, next: p));

    println("{}", p.read(0).value);
    println("{}", p.read(0).next.read(0).next.read(0).value);
    Ok(0);
}
