// MUST FAIL: `;`-separated match arms. DESIGN.md:152 — arms are "`pattern => expr`,
// comma-separated". Every match in DESIGN.md uses commas with a trailing comma on
// the last arm (DESIGN.md:555-556, 1258-1259), which PLAN.md:278 makes a fmt rule.

label* = (b: bool) str {
    b.match({
        true => "zero";
        false => "nonzero";
    });
}
