// tests/oracle_verdict.zen — the FULL VERDICT + KIND corpus for the Zen-native correctness oracle
// (the self-hosted replacement for the pytest verdict harness). Ported verbatim from
// tests/_oracle_corpus.py: VERDICT_CASES (186, accept/reject) + VERDICT_KIND_CASES (83, a reject
// pinned by its first-error KIND). `zenc check src` must accept (should_pass=true) or reject
// (false); a non-empty `kind` (e.g. "arity") makes the harness require `error[<kind>]` in the
// rejection diagnostic (reject-for-the-right-reason). The harness wraps the bare kind label.
// NO Python anywhere — the compiler tests itself, in itself, by driving the committed `zenc`.
{ VerdictCase, run_verdicts } = oracle_lib
oracle_verdict_run* = () i32 {
    a := run_verdicts("verdict (223)", [VerdictCase(
        // #392 accepts (the value-consumed void-arm rule must NOT over-fire):
        // a DISCARDED match (void-fn tail) keeps mixed side-effect arms — no consumer, no error.
        src: "count := 0\nbump = () i32 {\n    count = count + 1\n    count\n}\nmaybe = (c: bool) void {\n    c.match ({ true => bump(), false => { } })\n}\nmain = () i32 {\n    maybe(true)\n    0\n}\n",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        // a DIVERGING arm (block ending in `return`) legitimately yields no value (#386 exemption).
        src: "f = (c: bool) i32 {\n    v := c.match ({ true => 7, false => {\n        return 0\n    } })\n    v\n}\nmain = () i32 { f(true) - 7 }\n",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        // the builder-style rewrite: a side-effect arm that still TRAILS the result type is legal.
        src: "R*: Ok(str) | Err(i32)\nmain = () i32 {\n    done := false\n    s := \"init\"\n    r: R = .Err(3)\n    s = r.match ({ .Ok(ns) => ns, .Err(e) => {\n        done = true\n        s\n    } })\n    0\n}\n",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { a: u8 := 300  to_i32(a) }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { x: i32 := 4294967296  to_i32(x) }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { a: i8 := 200  0 }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { a: i16 := 40000  0 }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { a: u16 := 70000  0 }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { a: u32 := 0 - 1  0 }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { a: u64 := 0 - 1  0 }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { a: i8 := 127  0 }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { a: i8 := 0 - 128  0 }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "P*: { x: u8 }\ntest* = () i32 { p := P( x: 300 )  0 }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "P*: { x: i32 }\ntest* = () i32 { a: P := P( x: 1 )  c := a == P( x: 2 )  0 }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { x := 5  y := x.foo  0 }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { n := 1  v := n.match ({ 1 => 5, _ => \"s\" })  0 }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "A*: { x: i32 }\nB*: { y: i32 }\ntest* = () i32 { n := 1  v := n.match ({ 1 => A( x: 1 ), _ => B( y: 2 ) })  0 }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { c := true  v := c.match ({ true => 5, false => \"s\" })  0 }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "E*: A(i32) | B\ntest* = () i32 { x := E.A(\"s\")  0 }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { n := 1  v := n.match ({ 1 => 5, _ => 7 })  0 }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "Box<T>: { n: i32 }\nempty<T> = (k: i32) Box<T> { Box<T>( n: k ) }\ntest* = () i32 { m := empty(7)  0 }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "Box<T>: { n: i32 }\nempty<T> = (k: i32) Box<T> { Box<T>( n: k ) }\ntest* = () i32 { m: Box<i32> := empty(7)  0 }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "Box<T>: { n: i32 }\nwrap<T> = (x: T) Box<T> { Box<T>( n: 0 ) }\ntest* = () i32 { b := wrap(5)  0 }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { a: i32 := 0 - 1  b: u32 := 1  (a < b).match ({ true => 1, false => 0 }) }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { a: i64 := 0 - 1  b: u64 := 1  (a == b).match ({ true => 1, false => 0 }) }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { n: u64 := 5  (n < 10).match ({ true => 1, false => 0 }) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { a: u8 := 97  (a == 'a').match ({ true => 1, false => 0 }) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { x := 50  (1 < x < 10).match ({ true => 1, false => 0 }) }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "pick<T> = (xs: [T], a: T) T { a }\ntest* = () i32 { pick([1, 2]) }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "bad = (xs: ...i32, y: i32) i32 { y }\ntest* = () i32 { bad(1, 2, 3) }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "bad = (xs: ...i32, ys: ...i32) i32 { 0 }\ntest* = () i32 { bad(1) }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 {  }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 {\n  x := 5\n}",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 {\n  x := 5\n  x = 6\n}",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { \"hi\" }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "f* = (flags: RawPtr<u8>, i: i32, n: i32) void { (i < n).match({ true => { store_i64(flags, 1)  store_i64(flags, 2) }, false => {} }) }\ntest* = () i32 { 0 }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "g* = (x: i32) i32 { x }\nf* = (flags: RawPtr<u8>, i: i32, n: i32) void { (i < n).match({ true => { g(1, 2, 3)  store_i64(flags, 1) }, false => {} }) }\ntest* = () i32 { 0 }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "f* = (flags: RawPtr<u8>, i: i32, n: i32) void { (i < n).match({ true => { store_i64(flags)  store_i64(flags, 1) }, false => {} }) }\ntest* = () i32 { 0 }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { x := 7\n p: RawPtr<i32> := x.addr()\n load(p) }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { x := 7\n p: RawPtr<i32> := x.addr()\n store(p, 3)\n 0 }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { x := 7\n p: RawPtr<i32> := x.addr()\n q := assert_nonnull(p)\n load(q) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { x: u8 := 9\n p: RawPtr<u8> := x.addr()\n to_i32(load(p)) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { x := 5\n p: Ptr<i32> := x.addr()\n load(p) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "foo* = () i32 { 1 }\nfoo* = () i32 { 2 }\ntest* = () i32 { foo() }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "a* = () i32 { 1 }\ndup* = () i32 { 2 }\ndup* = () i32 { 3 }\ntest* = () i32 { a() }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "R*: Ok(i32) | Err\nf* = (r: R) i32 {\n r.match({ .Err => { return 9 } })\n 7\n}\ntest* = () i32 { f(.Ok(0)) }",
        should_pass: false,
        kind: "",
    ), VerdictCase(
        src: "f* = (b: bool) i32 {\n b.match({ false => { return 9 } })\n 7\n}\ntest* = () i32 { f(false) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "f* = (b: bool) i32 {\n b.match({ false => 9 })\n}\ntest* = () i32 { f(false) }",
        should_pass: false,
        kind: "",
