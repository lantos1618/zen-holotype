// src/sema/sema_meta.zen
// The comptime evaluator's entry point — and, today, its whole
// instruction set.
//
// `docs/design_meta.md` is the decomposition and its §7 the milestones.
// M0 was the wall — every `@meta` refused by name, pinned by three
// must-fail tests — and the refusal is still the answer for everything
// but one shape. M2 is the skeleton below: an entry point and nothing
// else yet. Its step budget was REMOVED (issue #768): three spends on a
// straight line cannot reach zero, so the counter read as coverage
// while bounding nothing — not even the one callee that recurses,
// `type_from_ast`. It returns with the first rule that can loop (M2,
// or M4's nested-struct recursion), together with the must-fail test
// §6.1 owes it; until then nothing pretends to bound evaluation.
//
// M3 is the one rule the skeleton runs: `@meta(name: Type).name` folds
// at sema time to the WRITTEN type's declared name as a `str`,
// recorded in `Checker.meta_memo` keyed on the written TYPE EXPRESSION
// — the access node alone would make two instantiations of one generic
// collide (`Box<i64>` answering for `Box<bool>`); the written type is
// what distinguishes them, and it travels to the backend inside the
// `Meta` node itself. The backend reads the fold back through
// `Checker.meta_str` and lowers an ordinary string literal, having
// learned nothing new.
//
// EVERYTHING ELSE IS STILL THE WALL. The value form `@meta(v)`, a
// typed form asked for a member that is not `.name`, a type with no
// declaration payload to read, and a `@meta` standing anywhere an
// access target isn't all report `MetaNotImplemented` at the `@meta`
// token and poison, exactly as M0 did — the refusal tests pin the
// rest of it.
//
// THE ARGUMENT IS STILL NOT VISITED, with one exception that is the
// rule itself: the typed form's `type` resolves through the ordinary
// type path with the caller's `ctx`, so `@Self` inside an impl means
// the enclosing type. Nothing descends into the argument as an
// EXPRESSION — it is a comptime term, and `type_of` walking it would
// spend a second diagnostic on a program whose first sentence is
// already written.

Expr, Type, TypeId, Access, Meta, Alias, Call = std.ast
ExprId, Ident, nowhere = std.ast
AllocError = std.mem
str = std.text
Range = std.core
TyId = sema.sema_ty
Checker, Ctx = sema.sema_check
SemaFault, NameFault = sema.sema_diag
Def, decl_at = sema.sema_def
type_from_ast, alias_target_of = sema.sema_denote

// A `@meta` standing anywhere an access target isn't: one diagnostic
// at the `@meta` token, then poison, so nothing downstream invents a
// second answer about a form that has none. `ctx` travels in as it
// does to every arm of `expr_kind`; the refusal itself needs nothing
// but the node.
meta_type* = (c :: Checker, node: Expr, ctx: Ctx) Res<TyId, AllocError> {
    c.meta_refused(node)
}

// The intercept `sema_member.access_type` makes when the access target
// is a Meta node: the whole access is the evaluator's question. The
// backend hands back this same access when it lowers the expression,
// and reads the folded text through `meta_str(t)` on the access's own
// `Meta` node; the MEMO is keyed finer, on the written type, so two
// instantiations never share a row.
meta_access* = (c :: Checker, ac: Access, ctx: Ctx)
               Res<TyId, AllocError> {
    target = c.tree.expr_at(ac.base);
    target.kind.match({
        Meta(m) => c.meta_form(target, m, ac, ctx),
        _       => c.types.unknown(),
    })
}

// THE SECOND SHAPE THAT FOLDS: `@meta(name: Type).fields()` is a Call
// whose callee is the access above, and `.len` reads off it. The chain
// arrives here through `member_call`, which marks the callee and would
// otherwise resolve `.fields` by ordinary UFCS and hunt for a free
// function by that name; intercepted instead, and the whole question
// handed to one rule.
//
// THE ARGUMENT LIST MUST BE EMPTY. `fields()` takes nothing: an argument
// written beside it is a different sentence about a shape this rule does
// not mean, and is refused like any other wall rather than silently
// ignored.
//
// The backend lowers this same call through `lower_meta_call`
// (`gen_c_expr.zen`), reading the folded count back off the Meta node
// the callee carries.
meta_call* = (c :: Checker, call: Call, ctx: Ctx)
             Res<TyId, AllocError> {
    empty = call.args.len == 0;
    empty.match({
        true  => c.meta_fields_len(call.callee, ctx),
        false => {
            target = c.tree.expr_at(call.callee);
            c.meta_refused(target);
        },
    })
}

// One level down: the CALL's callee is the Access whose base is the
// Meta. What folds is `.fields().len` — the ACCESS's own name decides;
// anything else on the same base (`@meta(T).name()` as a call) stays
// the wall.
meta_fields_len = (c :: Checker, ac_id: ExprId, ctx: Ctx)
                  Res<TyId, AllocError> {
    node = c.tree.expr_at(ac_id);
    node.kind.match({
        Access(a) => c.meta_len_read(a, ctx),
        _         => c.meta_refused(node),
    })
}

// The access's own name decides what the chain reads. `.len` folds;
// anything else on the same base (`@meta(T).name()` as a call) stays
// the wall. The Meta under the access carries the written type, the
// memo key — handed over exactly as `.name`'s fold receives it.
meta_len_read = (c :: Checker, ac: Access, ctx: Ctx)
                Res<TyId, AllocError> {
    is_len = ac.name.text.eq("len");
    is_len.match({
        false => c.meta_refused(c.tree.expr_at(ac.base)),
        true  => {
            target = c.tree.expr_at(ac.base);
            target.kind.match({
                Meta(m) => m.type.match({
                    None  => c.meta_refused(target),
                    Ok(t) => c.meta_count_fold(target, t, ctx),
                }),
                _       => c.meta_refused(target),
            })
        },
    })
}

// THE ONE SHAPE THAT FOLDS: the typed form — `name: Type` written, no
// value — asked for its `name`. Every other shape is the wall.
meta_form = (
    c      :: Checker,
    target : Expr,
    m      : Meta,
    ac     : Access,
    ctx    : Ctx
) Res<TyId, AllocError> {
    m.value.match({
        Ok(_) => c.meta_refused(target),
        None  => ac.name.text.eq("name").match({
            false => c.meta_refused(target),
            true  => m.type.match({
                None  => c.meta_refused(target),
                Ok(t) => c.meta_fold(target, t, ctx),
            }),
        }),
    })
}

// The written type resolves WITH the caller's `ctx`, so `@Self` is the
// enclosing type (`sema_denote.self_type`) and a name means what it
// means at this site. The form's `name` binds nothing this rule reads
// — it is the receiver the field walk will project through (M4).
// Every helper below carries `t`, the written type expression's id:
// it is the memo key, and threading it beats a second copy of every
// signature or state on the checker.
meta_fold = (
    c      :: Checker,
    target : Expr,
    t      : TypeId,
    ctx    : Ctx
) Res<TyId, AllocError> {
    ty = c.type_from_ast(t, ctx).try();
    c.meta_decl(target, t, ty, ctx)
}

// THE COUNT'S FOLD: the written TYPE EXPRESSION the Meta carries is the
// memo key — the same discipline `.name` follows, for the same reason.
// The count is a function of the type, so `TypeId` is its honest key;
// the answer travels to the backend inside the same Meta node.
meta_count_fold = (c :: Checker, target: Expr, t: TypeId, ctx: Ctx)
                  Res<TyId, AllocError> {
    ty = c.type_from_ast(t, ctx).try();
    c.meta_count(target, t, ty, ctx)
}

// Which declaration owns the count. The written spelling answers first
// (`P2` counts Point's fields under P2's own row), everything else asks
// the resolved type — the same split `.name` draws, for the same reason.
meta_count = (
    c      :: Checker,
    target : Expr,
    t      : TypeId,
    ty     : TyId,
    ctx    : Ctx
) Res<TyId, AllocError> {
    c.is_unknown(ty).match({
        true  => c.types.unknown(),
        false => c.written_count(c.tree.type_at(t), target, t, ty, ctx),
    })
}

written_count = (
    c      :: Checker,
    node   : Type,
    target : Expr,
    t      : TypeId,
    ty     : TyId,
    ctx    : Ctx
) Res<TyId, AllocError> {
    node.kind.match({
        Named(n) => c.counted_decl(n.name.text, target, t, ty, ctx),
        _        => c.resolved_count(target, t, ty),
    })
}

counted_decl = (
    c      :: Checker,
    name   : str,
    target : Expr,
    t      : TypeId,
    ty     : TyId,
    ctx    : Ctx
) Res<TyId, AllocError> {
    found ::= c.alloc.Vec<Def>();
    c.world.defs_of(ctx.module, name, found).try();
    found.get(0).match({
        None  => c.resolved_count(target, t, ty),
        Ok(d) => decl_at(c.tree, d.id).match({
            None  => c.resolved_count(target, t, ty),
            Ok(x) => x.kind.match({
                Struct(s) => c.meta_record(t, s.name.text),
                Enum(_)   => c.meta_refused(target),
                Alias(a)  => c.counted_alias(a, d, target, t),
                _         => c.meta_refused(target),
            }),
        }),
    })
}

// An alias folds to the count of WHAT THE USER WROTE — `@meta(x: P2)`
// counts through P2's own row — reached one step short of the collapse,
// with the target's payload as validation only: an alias naming no
// struct (`Count = i64`) has no fields to count and refuses rather than
// guess.
counted_alias = (c :: Checker, al: Alias, owner: Def, target: Expr, t: TypeId)
                Res<TyId, AllocError> {
    ty = c.alias_target_of(al, owner).try();
    c.types.at(ty).match({
        Named(n) => decl_at(c.tree, n.decl).match({
            None  => c.meta_refused(target),
            Ok(d) => d.kind.match({
                Struct(_) => c.meta_record(t, al.name.text),
                _         => c.meta_refused(target),
            }),
        }),
        _        => c.meta_refused(target),
    })
}

resolved_count = (c :: Checker, target: Expr, t: TypeId, ty: TyId)
                 Res<TyId, AllocError> {
    c.types.at(ty).match({
        Named(n) => decl_at(c.tree, n.decl).match({
            None  => c.meta_refused(target),
            Ok(d) => d.kind.match({
                Struct(s) => c.meta_record(t, s.name.text),
                _         => c.meta_refused(target),
            }),
        }),
        _        => c.meta_refused(target),
    })
}

// The name lives on a declaration's payload node — the one the USER
// WROTE (`P2 = Point` answers `P2`), reached through the written type
// expression so two spellings of one type ask their own questions. A
// poisoned or unknown resolution was reported on the way in and says
// nothing twice.
meta_decl = (
    c      :: Checker,
    target : Expr,
    t      : TypeId,
    ty     : TyId,
    ctx    : Ctx
) Res<TyId, AllocError> {
    c.is_unknown(ty).match({
        true  => c.types.unknown(),
        false => c.written_kind(c.tree.type_at(t), target, t, ty, ctx),
    })
}

// The written type expression decides which declaration is asked. A
// written name resolves one step short of the alias collapse; any
// other spelling — `@Self`, a primitive — has no written declaration,
// so the RESOLVED type answers, which is where `@Self` finds its
// struct.
written_kind = (
    c      :: Checker,
    node   : Type,
    target : Expr,
    t      : TypeId,
    ty     : TyId,
    ctx    : Ctx
) Res<TyId, AllocError> {
    node.kind.match({
        Named(n) => c.written_decl(n.name.text, target, t, ty, ctx),
        _        => c.resolved_decl(target, t, ty),
    })
}

// The written name's own declaration decides. An alias is its own
// answer — `P2`, never `Point` (#768) — and keeps the `Def` that owns
// it, which the walk to the target's payload needs; anything else
// records its payload's name under `t`.
written_decl = (
    c      :: Checker,
    name   : str,
    target : Expr,
    t      : TypeId,
    ty     : TyId,
    ctx    : Ctx
) Res<TyId, AllocError> {
    found ::= c.alloc.Vec<Def>();
    c.world.defs_of(ctx.module, name, found).try();
    found.get(0).match({
        None  => c.resolved_decl(target, t, ty),
        Ok(d) => decl_at(c.tree, d.id).match({
            None  => c.resolved_decl(target, t, ty),
            Ok(x) => x.kind.match({
                Struct(s) => c.meta_record(t, s.name.text),
                Enum(e)   => c.meta_record(t, e.name.text),
                Alias(a)  => c.written_alias(a, d, target, t),
                _         => c.meta_refused(target),
            }),
        }),
    })
}

// The alias answers the NAME THE USER WROTE — `P2 = Point` folds to
// `P2` (#768) — reached one step short of where the ordinary path
// collapses the alias away. The walk to the target's payload stays only
// as VALIDATION: a target that lands on no struct or enum declaration
// (`Count = i64`) has nothing behind the name and is refused rather
// than guessed, but when the target does land, the recorded text is the
// written alias's own `name.text`, never the target's — reading the
// payload's name here is what made `P2` answer `Point` while its own
// corpus test said `P2`.
written_alias = (c :: Checker, al: Alias, owner: Def, target: Expr, t: TypeId)
                Res<TyId, AllocError> {
    ty = c.alias_target_of(al, owner).try();
    c.types.at(ty).match({
        Named(n) => decl_at(c.tree, n.decl).match({
            None  => c.meta_refused(target),
            Ok(d) => d.kind.match({
                Struct(_) => c.meta_record(t, al.name.text),
                Enum(_)   => c.meta_record(t, al.name.text),
                _         => c.meta_refused(target),
            }),
        }),
        _        => c.meta_refused(target),
    })
}

// The fold lands. One memo, two row shapes, told apart by the second
// component: `.name` records the text under the written type (`t`),
// `.fields().len` records a leading `#` and the decimal count — a
// string cannot start with `#`, so neither reader can mistake one row
// for the other.
//
// THE FIELD COUNT IS THE MEMBERS FILTERED TO FIELDS (R2's view,
// evaluated here rather than allocated): `k: i64 = 5` is a Const and
// `go* = ..` a Function — only `MemberKind.Field` counts, which is
// what keeps Muddle at 2 against four members.
meta_record = (c :: Checker, key: TypeId, name: str) Res<TyId, AllocError> {
    is_count ::= name.len > 0;
    is_count = is_count && (name.index(0) == '#');
    is_count.match({
        false => c.meta_memo.set(key, name),
        true  => c.meta_record_count(key, name),
    }).try();
    c.types.str_ty()
}

// A count row: `#` plus decimal digits, decoded into the count memo.
// The digits are the compiler's own writing — the arms of `count_text`
// above — so the decode cannot meet anything but them.
meta_record_count = (c :: Checker, key: TypeId, name: str) Res<(), AllocError> {
    n ::= 0;
    Range(1, name.len).loop((h, i) {
        n = (n * 10) + (name.index(i) - '0');
    });
    c.meta_count_memo.set(key, n)
}

// A written spelling that names no declaration of its own falls back
// to the resolved type, whose own declaration carries the name. There
// is no WRITTEN name on this path — `@Self` and friends have none — so
// an alias here has nothing to answer and refuses rather than guess.
resolved_decl = (c :: Checker, target: Expr, t: TypeId, ty: TyId)
                Res<TyId, AllocError> {
    c.types.at(ty).match({
        Named(n) => decl_at(c.tree, n.decl).match({
            None  => c.meta_refused(target),
            Ok(d) => d.kind.match({
                Struct(s) => c.meta_record(t, s.name.text),
                Enum(e)   => c.meta_record(t, e.name.text),
                _         => c.meta_refused(target),
            }),
        }),
        _        => c.meta_refused(target),
    })
}

meta_refused = (c :: Checker, node: Expr) Res<TyId, AllocError> {
    c.report(
        node.span.file,
        node.span,
        SemaFault.MetaNotImplemented(NameFault(name: ""))
    ).try();
    c.types.unknown()
}
