// example/src/main_test.zen
// tests live next to code. no annotations: build.zen's walk finds
// these because their single parameter is a Tester

Bencher, TestError, Tester = std.test
Circle, Rect, Shape = main

shape_prints* = (t: Tester) Res<(), TestError> {
    s   = Shape.Unit;
    out = t.alloc.String("{}", s).try();
    t.expect_eq(out.view(), "unit").try();
    Ok(());
}

circle_prints_its_radius* = (t: Tester) Res<(), TestError> {
    s   = Shape.Circle(Circle(radius: 2.0));
    out = t.alloc.String("{}", s).try();
    t.expect_eq(out.view(), "circle: 2").try();
    Ok(());
}

area_is_ufcs* = (t: Tester) Res<(), TestError> {
    c = Circle(radius: 1.0);
    t.expect(c.area() > 3.14).try();
    Ok(());
}

vec_grows* = (t: Tester) Res<(), TestError> {
    v ::= t.alloc.Vec<i32>();
    Range(0, 20).loop((h, i) {
        v.add(i).try();
    });
    t.expect_eq(v.len, 20).try();
    Ok(());
}

// a bench: found by the Bencher filter in build.zen. because all
// allocation goes through Alloc, allocs_op is counted for free
shape_format* = (bn: Bencher) Res<(), TestError> {
    s = Shape.Rect(Rect(width: 2.0, height: 3.0));
    bn.iter(() {
        bn.alloc.String("{}", s);
    });
    Ok(());
}
