// A bound member's receiver occupies parameter zero; every remaining required
// parameter must have one written argument.
//
// position: the call with a missing argument.

Shower = {
    show* ::= (self: @Self, a: i32, b: i32) i32
}

Thing = {}

Thing.impl(Shower, {
    show = (self: @Self, a: i32, b: i32) i32 { a + b }
})

use = <T: Shower>(value: T) i32 { value.show(1) }

main = (env: Env) Res<i32, AllocError> {
    println("{}", use(Thing()));
    Ok(0);
}
