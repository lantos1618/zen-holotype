halloc = std.mem.heap
vec = std.collections.vec
{ expect, Result, IoError } = std.core.result
{ println } = std.text.fmt
main = () i32 {
    alloc = halloc.gpa()
    a = alloc.addr()
    // empty's T is return-only; pin it via the two-step annotation (the .expect chain can't reach it).
    vr: Result<vec.Vec<i32>, IoError> = vec.empty(a)
    v ::= vr.expect("empty")
    v = v.push(a, 3).expect("push")
    v = v.push(a, 5).expect("push")
    v = v.push(a, 7).expect("push")
    sum ::= 0
    v.view().loop((h, i, x) {
        sum = sum + x
    })
    println(sum)
    n = v.view().len
    println(n)
    v.free(a)
    0
}
