// A non-empty slice literal heap-promotes its backing so `.ptr` can outlive the frame. The malloc
// MUST route through zen__salloc, which NULL-checks and panics cleanly on OOM instead of memcpy-ing
// into a NULL pointer (which segfaulted under an exhausted heap).
sum3* = (xs: [i32]) i32 { xs[0] + xs[1] + xs[2] }
demo* = () i32 { sum3([10, 20, 30]) }
