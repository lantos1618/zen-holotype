// src/gen/gen_c/gen_c_sink.zen
// `out.add("{}:{}", self.x, self.y)` — the format door on ANY Sink, and
// the door every idiomatic `toString` is written through.
//
// `text_fmt.zen` declares it and writes no body, and says why: "the
// arguments are type-directed, so the call is expanded where it is
// WRITTEN". A variadic parameter has no C spelling and `{}` is resolved
// BY THE ARGUMENT'S TYPE, so there is nothing one body could have been —
// the compiler IS the body, the same bargain `alloc.String("{}", x)`
// strikes next door in `gen_c_fmt.zen`.
//
// EMITTING THE CALL INSTEAD IS NOT A DIAGNOSTIC, IT IS A LINKER ERROR,
// and that is how this was found: a bodyless declaration defines no
// symbol, so every `toString` written the way DESIGN.md writes them
// emitted a call to `..text_fmt3add..` that nothing defines. `cc`
// reported it as an implicit declaration returning `int` — a wrong
// answer with no position on it — rather than as the missing lowering
// it was.
//
// WHY THIS DOOR AND THE ALLOCATING ONE ARE SEPARATE FILES. They walk
// the same format, and they share that walk — `lower_pieces_into`
// below is the allocating door writing THESE pieces into the buffer it
// just made, so the two hole sets are one hole set. What they do NOT
// share is the error: every write reachable from a `{}` — `Sink.write`,
// `text_fmt.add_i64`, a Display's own `toString` — answers with exactly
// `Res<(), WriteError>`, which IS this door's declared return, so a
// failing write is carried out by COPYING it and nothing is converted.
// The allocating door returns `Res<String, AllocError>` and has no such
// luck; `gen_c_fmt.zen` holds that half, and the buffer it makes.
//
// THE WRITERS ARE FOUND, NOT WRITTEN. `add_i64`, `add_u64` and
// `add_bool` are ordinary Zen functions in the door's own module with
// ordinary bodies, and this file only picks which one a hole reaches.
// A second, C-side integer printer would be a second set of rules about
// what a number looks like, and the corpus pins exactly one.

Expr, ExprId, Decl, DeclKind, Function, Param, Call, Arg = ast
Literal, LiteralKind, TypeId = ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId = sema.sema_ty
World, Def, decl_at = sema.sema_def
Checker, Ctx = sema.sema_check
Inst = sema.sema_inst
write_usize = sema.sema_diag
param_type = sema.sema_type
sym_fn, sym_gen, sym_variant, RES_PATH = gen.gen_name
GenFault = gen.gen_diag
CBackend = gen.gen_c.gen_c_state
unsupported = gen.gen_c.gen_c_report
ctype = gen.gen_c.gen_c_type
is_c_integer, is_signed = gen.gen_c.gen_c_type
expr, ty_of = gen.gen_c.gen_c_expr
declare_temp = gen.gen_c.gen_c_flow
signature_of = gen.gen_c.gen_c_call
body_end, is_hole, advance, decoded_bytes, cast_of = gen.gen_c.gen_c_print
slot_call = gen.gen_c.gen_c_bound
set_line, fat_value = gen.gen_c.gen_c_fat
sink_display = gen.gen_c.gen_c_display

// -----------------------------------------------------------------
// recognising the door
// -----------------------------------------------------------------

// The bodyless `add(out :: Sink, fmt: str, args: ...)` and nothing
// else. Asked of the DECLARATION rather than of the name: a module's
// own three-parameter `add` with a body is an ordinary function and is
// called like one, and so is a two-parameter `add_i64`.
//
// THE RECEIVER MUST BE `::`. That is what tells this door apart from
// any other variadic three-parameter `add` — a sink is written into, so
// it is taken by address, and a declaration that takes its first
// argument by value is not this.
is_sink_door* = (be: CBackend, d: Def, f: Function) bool {
    d.name.eq("add") && sink_door_shape(be, f)
}

// The door's shape with the name held out, because the MEMBER form has
// no `Def` to read a name off — `s.add(..)` carries its name in the
// access. Stated once so the two forms cannot drift into recognising
// different declarations.
sink_door_shape* = (be: CBackend, f: Function) bool {
    bodyless(f) && (f.params.len == 3) && by_ref(f, 0)
        && last_is_variadic(be, f)
}

bodyless* = (f: Function) bool {
    f.body.match({ Ok(_) => false, None => true })
}

by_ref = (f: Function, i: usize) bool {
    f.params.get(i).match({ Ok(p) => p.mutable, None => false })
}

// A FUNCTION WITH NO PARAMETERS HAS NO LAST ONE, and `len - 1` on a
// `usize` does not answer that question — it traps. `Vec.get` would have
// returned `None` for the huge index, which is why this read as safe;
// the subtraction never got that far. Its first caller was shielded by a
// `params.len == 3` test in front of it, so the underflow waited for a
// second caller to arrive, and one did (`associated_functions`, exit
// 134). A guard belongs where the arithmetic is, not in whoever calls it.
last_is_variadic* = (be: CBackend, f: Function) bool {
    (f.params.len == 0).match({
        true  => false,
        false => tail_is_variadic(be, f, f.params.len - 1),
    })
}

tail_is_variadic = (be: CBackend, f: Function, i: usize) bool {
    f.params.get(i).match({
        None  => false,
        Ok(p) => variadic_param(be, p),
    })
}

variadic_param = (be: CBackend, p: Param) bool {
    p.type.match({
        None  => false,
        Ok(t) => variadic_type(be, t),
    })
}

variadic_type = (be: CBackend, t: TypeId) bool {
    be.tree.type_at(t).kind.match({ Variadic => true, _ => false })
}

// -----------------------------------------------------------------
// the same door, reached through a receiver
//
// `String.add(self :: @Self, fmt: str, args: ...)` is NOT a second
// door. It is the door's exact shape declared a second time, bodyless
// for the same reason, because a String IS a Sink and `s.add("{}", x)`
// has to mean what `add(s, "{}", x)` means. Declaring it on the type is
// what makes the idiomatic spelling reachable at all; lowering it is
// finding the one declaration and expanding it with the receiver as the
// sink.
//
// THE FREE DECLARATION IS WHAT IS LOWERED, NOT THE MEMBER'S OWN, and
// that is load-bearing rather than a shortcut. Everything the expansion
// reads comes out of the DOOR'S module: `Sink`, the type the record is
// built at and whose `write` slot every literal run travels through,
// and `add_i64`/`add_u64`/`add_bool`, the writers a scalar hole
// reaches. `text_string.zen` imports `Sink` but declares no writer, and
// its own first parameter is `@Self` — a String, which is where the
// bytes END UP and not the thing a write goes through. Reading the
// member's declaration would resolve the sink to the wrong type and
// find no writers at all.
// -----------------------------------------------------------------

lower_member_door* = (be :: CBackend, id: ExprId, c: Call, recv: ExprId,
                      ctx: Ctx, out :: String) Res<(), AllocError> {
    door_decl(be).try().match({
        None  => unsupported(be, id, "a format door with no declaration", out),
        Ok(d) => lower_at_decl(be, id, c, d, recv, ctx, out),
    })
}

lower_at_decl = (be :: CBackend, id: ExprId, c: Call, d: Def, recv: ExprId,
                 ctx: Ctx, out :: String) Res<(), AllocError> {
    door_fn(be, d).match({
        None  => unsupported(be, id, "a format door with no declaration", out),
        Ok(g) => lower_sink_door(be, id, c, d, g, Ok(recv), ctx, out),
    })
}

// The free door, found BY SHAPE across the program rather than by module
// path. Nothing at the call site names `text_fmt`: `text_string.zen`
// does not import it, it is not the prelude, and the caller wrote a dot
// on a String. What identifies the door is that it is the one exported
// `add` carrying the door's shape — `::` sink, three parameters, a
// variadic tail, no body — and this tree's only other top-level `add`
// takes two Durations by value.
door_decl = (be :: CBackend) Res<Res<Def>, AllocError> {
    found ::= be.alloc.Vec<Def>();
    be.check.world.exported_named("add", found).try();
    kept ::= be.alloc.Vec<Def>();
    found.loop((h, x) { keep_door(be, x, kept).try() });
    Ok(kept.get(0));
}

keep_door = (be :: CBackend, x: Def, out :: Vec<Def>) Res<(), AllocError> {
    door_fn(be, x).match({
        None  => Ok(()),
        Ok(g) => keep_shaped(be, g, x, out),
    })
}

keep_shaped = (be :: CBackend, g: Function, x: Def, out :: Vec<Def>)
              Res<(), AllocError> {
    sink_door_shape(be, g).match({
        true  => out.add(x),
        false => Ok(()),
    })
}

// The `Function` a `Def` declares, and `None` when it declares anything
// else.
door_fn = (be :: CBackend, d: Def) Res<Function> {
    decl_at(be.tree, d.id).match({
        None    => None,
        Ok(dec) => decl_fn(dec),
    })
}

decl_fn = (dec: Decl) Res<Function> {
    dec.kind.match({ Function(g) => Ok(g), _ => None })
}

// -----------------------------------------------------------------
// the same door, into a buffer the caller already made
//
// `gen_c_fmt.zen`'s allocating door is `alloc.String()` followed by
// EXACTLY these pieces, so it reaches them here instead of keeping a
// second walk. It used to keep one, and the two drifted the way two
// copies do: this one grew integers, bools and Displays and that one
// stayed at `str`, so `alloc.String("point {}", p)` was a diagnostic
// while `out.add("point {}", p)` wrote the point.
//
// A STRING IS A SINK, which is the whole reason this works: the buffer
// becomes the door's own record through `fat_value` — ONE call, not a
// second copy of the rule — and every writer reachable from a `{}` is
// then reached the one way this file reaches it.
//
// A FAILING WRITE JUMPS TO A LABEL THE CALLER OWNS rather than leaving
// an answer to inspect. The two doors declare different errors, so the
// caller has to build its own; giving it a place to do that is one
// `usize` and no test emitted on the succeeding path.
// -----------------------------------------------------------------

lower_pieces_into* = (be :: CBackend, id: ExprId, c: Call, addr: str,
                      cty: TyId, fail: usize, recv: Res<ExprId>, ctx: Ctx)
                     Res<bool, AllocError> {
    door_decl(be).try().match({
        None  => Ok(false),
        Ok(d) => pieces_at_decl(be, id, c, addr, cty, fail, d, recv, ctx),
    })
}

pieces_at_decl = (be :: CBackend, id: ExprId, c: Call, addr: str, cty: TyId,
                  fail: usize, d: Def, recv: Res<ExprId>, ctx: Ctx)
                 Res<bool, AllocError> {
    door_fn(be, d).match({
        None  => Ok(false),
        Ok(f) => pieces_into_buffer(be, id, c, addr, cty, fail, d, f, recv, ctx),
    })
}

pieces_into_buffer = (be :: CBackend, id: ExprId, c: Call, addr: str,
                      cty: TyId, fail: usize, d: Def, f: Function,
                      recv: Res<ExprId>, ctx: Ctx) Res<bool, AllocError> {
    ret = declared_type(be, d, f.ret).try();
    sty = sink_type(be, d, f).try();
    sink ::= be.alloc.String().try();
    buffer_sink(be, addr, cty, sty, sink).try();
    tmp ::= be.alloc.String().try();
    sym_gen(tmp, "t", be.next_tmp()).try();
    declare_temp(be, ret, tmp.view()).try();
    write_ok(be, ret, tmp.view()).try();
    p = Piece(sink: sink.view(), sty: sty, tmp: tmp.view(), done: fail,
              id: id, module: d.id.module.to_usize());
    fmt_arg(c, recv).match({
        None      => Ok(()),
        Ok(first) => write_pieces(be, c, first, fmt_index(recv) + 1, p, ctx),
    }).try();
    Ok(true);
}

// The record over the caller's buffer, in a temporary of its own so
// that every write names a place and `&` on it is an address — the
// same shape `spill_sink` gives a sink that arrived as an argument.
buffer_sink = (be :: CBackend, addr: str, cty: TyId, sty: TyId,
               out :: String) Res<(), AllocError> {
    value ::= be.alloc.String().try();
    fat_value(be, addr, cty, sty, value).try();
    sym_gen(out, "t", be.next_tmp()).try();
    declare_temp(be, sty, out.view()).try();
    set_line(be, out.view(), value.view())
}

// -----------------------------------------------------------------
// what one piece needs
//
// Six values travel together through every write, and threading them
// one by one made a signature per helper that was mostly punctuation.
// They are one thing — WHERE THE BYTES GO AND WHERE A FAILURE GOES —
// so they are one record.
// -----------------------------------------------------------------

Piece = {
    sink: str,        // the C name of the Sink record, a place
    sty: TyId,        // Sink itself, for its slots
    tmp: str,         // the temporary the door answers with
    done: usize,      // the label a failing write jumps to
    id: ExprId,       // the door call, for a diagnostic with a position
    module: usize,    // the door's own module: where the writers live
}

// -----------------------------------------------------------------
// the expansion
// -----------------------------------------------------------------

// A temporary at the door's return type, `Ok` until a write says
// otherwise, and a label every failing write jumps to. The temporary IS
// the answer, and the last write leaves its own `Ok` in it.
lower_sink_door* = (be :: CBackend, id: ExprId, c: Call, d: Def,
                    f: Function, recv: Res<ExprId>, ctx: Ctx,
                    out :: String) Res<(), AllocError> {
    ret = declared_type(be, d, f.ret).try();
    sty = sink_type(be, d, f).try();
    sink ::= be.alloc.String().try();
    write_sink_temp(be, c, recv, sty, ctx, sink).try().match({
        false => unsupported(be, id, "a format door with no sink", out),
        true  => write_door(be, id, c, d, recv, ret, sty, sink.view(), ctx, out),
    })
}

// The door's declared return and its declared sink, read in the door's
// OWN module. Neither names a type parameter, so there is nothing to
// substitute.
declared_type = (be :: CBackend, d: Def, t: Res<TypeId>)
                Res<TyId, AllocError> {
    t.match({
        Ok(x) => be.check.type_from_ast(x, door_ctx(d)),
        None  => be.check.types.unknown(),
    })
}

sink_type = (be :: CBackend, d: Def, f: Function) Res<TyId, AllocError> {
    f.params.get(0).match({
        None  => be.check.types.unknown(),
        Ok(p) => be.check.param_type(p, door_ctx(d)),
    })
}

door_ctx = (d: Def) Ctx {
    Ctx(module: d.id.module.to_usize(), ret: TyId(index: 0), has_ret: false,
        self_ty: TyId(index: 0), has_self: false)
}

// The sink lands in a temporary of its own and every write names it.
// A `String` argument becomes the record here, ONCE — `expr` at the
// bound's type is what builds one — and a caller that already holds a
// `Sink` copies two words. Either way what the writes see is a plain C
// name, which is a place, so `&` on it is an address and not a spill.
write_sink_temp = (be :: CBackend, c: Call, recv: Res<ExprId>, sty: TyId,
                   ctx: Ctx, out :: String) Res<bool, AllocError> {
    sink_arg(c, recv).match({
        None  => Ok(false),
        Ok(a) => spill_sink(be, a, sty, ctx, out),
    })
}

spill_sink = (be :: CBackend, a: ExprId, sty: TyId, ctx: Ctx,
              out :: String) Res<bool, AllocError> {
    code ::= be.alloc.String().try();
    expr(be, a, ctx, sty, code).try();
    sym_gen(out, "t", be.next_tmp()).try();
    declare_temp(be, sty, out.view()).try();
    set_line(be, out.view(), code.view()).try();
    Ok(true);
}

write_door = (be :: CBackend, id: ExprId, c: Call, d: Def,
              recv: Res<ExprId>, ret: TyId, sty: TyId, sink: str,
              ctx: Ctx, out :: String) Res<(), AllocError> {
    tmp ::= be.alloc.String().try();
    sym_gen(tmp, "t", be.next_tmp()).try();
    declare_temp(be, ret, tmp.view()).try();
    write_ok(be, ret, tmp.view()).try();
    p = Piece(sink: sink, sty: sty, tmp: tmp.view(), done: be.next_tmp(),
              id: id, module: d.id.module.to_usize());
    // `out.add("")` is one write of nothing and `out.add(s)` is one
    // write of `s`, so a door with no format argument is not an error —
    // it is the same expansion with no pieces in it.
    fmt_arg(c, recv).match({
        None      => Ok(()),
        Ok(first) => write_pieces(be, c, first, fmt_index(recv) + 1, p, ctx),
    }).try();
    write_label(be, p.done).try();
    out.add_bytes(p.tmp)
}

// `zg_tN = (Res){ .zg_tag = Ok };` — the answer a door with no failing
// write gives, written first so that falling off the end is `Ok` and
// only a failure has to say anything.
write_ok = (be :: CBackend, ret: TyId, tmp: str) Res<(), AllocError> {
    value ::= be.alloc.String().try();
    value.add_bytes("(").try();
    ctype(be, ret, value).try();
    value.add_bytes("){ .zg_tag = ").try();
    sym_variant(value, RES_PATH, "Ok").try();
    value.add_bytes(" }").try();
    set_line(be, tmp, value.view())
}

// Argument zero of the SIGNATURE: the receiver when the call was
// written `out.add(..)`, and the first written argument when it was
// written `add(out, ..)`. The same shift `write_call` makes.
sink_arg = (c: Call, recv: Res<ExprId>) Res<ExprId> {
    recv.match({
        Ok(x) => Ok(x),
        None  => arg_at(c, 0),
    })
}

fmt_arg = (c: Call, recv: Res<ExprId>) Res<ExprId> {
    arg_at(c, fmt_index(recv))
}

fmt_index = (recv: Res<ExprId>) usize {
    recv.match({ Ok(_) => 0, None => 1 })
}

arg_at = (c: Call, i: usize) Res<ExprId> {
    c.args.get(i).match({ Ok(a) => Ok(a.value), None => None })
}

// -----------------------------------------------------------------
// the pieces
//
// `gen_c_print.zen`'s walk over the raw literal, with the writes going
// to a sink instead of straight to the console. One implementation of
// "where are the holes", because `println("{}", x)` and
// `out.add("{}", x)` differ only in where the bytes end up.
// -----------------------------------------------------------------

write_pieces = (be :: CBackend, c: Call, first: ExprId, used0: usize,
                p: Piece, ctx: Ctx) Res<(), AllocError> {
    raw = format_of(be, first);
    (raw.len == 0).match({
        true  => write_values(be, c, first, used0, p, ctx),
        false => walk_format(be, c, raw, used0, p, ctx),
    })
}

// No format at all: every argument is a value and they are written in
// order, which is what `println(s)` does with the same shape.
write_values = (be :: CBackend, c: Call, first: ExprId, used0: usize,
                p: Piece, ctx: Ctx) Res<(), AllocError> {
    write_value(be, first, p, ctx).try();
    write_rest(be, c, used0, p, ctx)
}

// The raw source slice of a string literal, quotes included, and the
// empty string when the argument is not one. A FORMAT IS READ AT
// COMPILE TIME, so a computed one is not a format at all — it is the
// first value, and `out.add(s)` writes `s`.
format_of = (be: CBackend, id: ExprId) str {
    be.tree.expr_at(id).kind.match({
        Literal(l) => literal_format(l),
        _          => "",
    })
}

literal_format = (l: Literal) str {
    l.kind.match({ Str => l.text, _ => "" })
}

walk_format = (be :: CBackend, c: Call, raw: str, used0: usize, p: Piece,
               ctx: Ctx) Res<(), AllocError> {
    end = body_end(raw);
    start ::= 1;
    used ::= used0;
    i ::= 1;
    loop(() { i < end }, (h) {
        hole = is_hole(raw, i, end);
        hole.then(() {
            write_chunk(be, raw, start, i, p).try();
            write_hole(be, c, used, p, ctx).try();
            used = used + 1;
            start = i + 2;
        });
        i = i + advance(raw, i, hole);
    });
    write_chunk(be, raw, start, end, p).try();
    write_rest(be, c, used, p, ctx).try();
    Ok(());
}

// A hole with no argument left writes itself, which is what `println`
// does and what makes a stray `{}` visible rather than swallowed.
write_hole = (be :: CBackend, c: Call, used: usize, p: Piece, ctx: Ctx)
             Res<(), AllocError> {
    arg_at(c, used).match({
        None  => write_literal(be, "{}", p),
        Ok(a) => write_value(be, a, p, ctx),
    })
}

write_rest = (be :: CBackend, c: Call, used: usize, p: Piece, ctx: Ctx)
             Res<(), AllocError> {
    Range(used, c.args.len).loop((h, i) {
        arg_at(c, i).match({
            None  => Ok(()),
            Ok(a) => write_value(be, a, p, ctx),
        }).try();
    });
    Ok(());
}

// One literal chunk, and nothing at all when the chunk is empty.
write_chunk = (be :: CBackend, raw: str, start: usize, stop: usize,
               p: Piece) Res<(), AllocError> {
    (stop > start).match({
        false => Ok(()),
        true  => write_literal(be, raw.slice(start, stop), p),
    })
}

// A run of bytes, verbatim, through the sink's own `write`. The RAW
// slice travels into the emitted C unchanged and only its LENGTH is
// counted — `gen_c_print.zen` says why that is sound.
write_literal = (be :: CBackend, piece: str, p: Piece)
                Res<(), AllocError> {
    text ::= be.alloc.String().try();
    text.add_bytes("(zg_str){ (unsigned char *)\"").try();
    text.add_bytes(piece).try();
    text.add_bytes("\", ").try();
    write_usize(text, decoded_bytes(piece)).try();
    text.add_bytes("u }").try();
    call ::= be.alloc.String().try();
    sink_write(be, p, text.view(), call).try().match({
        false => unsupported_piece(be, p.id, "a sink with no write"),
        true  => write_guarded(be, call.view(), p),
    })
}

// -----------------------------------------------------------------
// one value
//
// The write a `{}` becomes is chosen by the ARGUMENT'S TYPE and by
// nothing else: `{}` carries no format spec, so there is nothing else
// to read.
// -----------------------------------------------------------------

write_value = (be :: CBackend, a: ExprId, p: Piece, ctx: Ctx)
              Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    ty = ty_of(be, a, ctx, unknown).try();
    text ::= be.alloc.String().try();
    expr(be, a, ctx, ty, text).try();
    call ::= be.alloc.String().try();
    value_call(be, p, ty, text.view(), call).try().match({
        false => unsupported_piece(be, a, "formatting a value of this type"),
        true  => write_guarded(be, call.view(), p),
    })
}

// A `str` is the sink's own `write` — bytes, verbatim, no format
// meaning read into them. Everything else is a WRITER, and the writers
// are `text_fmt.zen`'s own functions rather than C written here.
value_call = (be :: CBackend, p: Piece, ty: TyId, text: str, out :: String)
             Res<bool, AllocError> {
    prim = be.check.prim_name(ty);
    prim.eq("str").match({
        true  => sink_write(be, p, text, out),
        false => scalar_call(be, p, ty, prim, text, out),
    })
}

scalar_call = (be :: CBackend, p: Piece, ty: TyId, prim: str, text: str,
               out :: String) Res<bool, AllocError> {
    writer_of(prim).is_empty().match({
        true  => sink_display(be, ty, text, p.sink, out),
        false => writer_call(be, p, writer_of(prim), cast_of(prim), text, out),
    })
}

// Which of `text_fmt.zen`'s writers a primitive reaches. Empty means
// none does, and the value goes through its own `toString` instead —
// a float lands there and is reported, because no writer for one is
// declared and this file will not invent a second number format.
writer_of = (prim: str) str {
    prim.eq("bool").match({
        true  => "add_bool",
        false => integer_writer(prim),
    })
}

integer_writer = (prim: str) str {
    is_c_integer(prim).match({
        false => "",
        true  => signed_writer(prim),
    })
}

signed_writer = (prim: str) str {
    is_signed(prim).match({ true => "add_i64", false => "add_u64" })
}

// `<sink>.write(<sink>.zg_self, <bytes>)` — the one member of `Sink`
// that takes bytes, reached through the record because a sink's whole
// point is that the writer does not know which one it holds.
sink_write = (be :: CBackend, p: Piece, text: str, out :: String)
             Res<bool, AllocError> {
    args ::= be.alloc.String().try();
    args.add_bytes(", ").try();
    args.add_bytes(text).try();
    slot_call(be, p.sink, p.sty, "write", args.view(), 1, out).try().match({
        None  => Ok(false),
        Ok(_) => Ok(true),
    })
}

// `zu_..add_i64(&<sink>, (int64_t)(<value>))`. The writer is looked up
// in the DOOR'S module and not through the caller's imports, because
// the expansion is the backend's: a caller that wrote `out.add("{}", n)`
// never named `add_i64`.
writer_call = (be :: CBackend, p: Piece, name: str, cast: str, text: str,
               out :: String) Res<bool, AllocError> {
    module_fn(be, p.module, name).try().match({
        None  => Ok(false),
        Ok(w) => write_writer_call(be, w, p, cast, text, out),
    })
}

write_writer_call = (be :: CBackend, w: Def, p: Piece, cast: str, text: str,
                     out :: String) Res<bool, AllocError> {
    call_symbol(be, w, out).try();
    out.add_bytes("(&").try();
    out.add_bytes(p.sink).try();
    out.add_bytes(", ").try();
    out.add_bytes(cast).try();
    out.add_bytes("(").try();
    out.add_bytes(text).try();
    out.add_bytes("))").try();
    Ok(true);
}

// A bodied function a module declares under `name`.
module_fn = (be :: CBackend, mi: usize, name: str)
            Res<Res<Def>, AllocError> {
    found ::= be.alloc.Vec<Def>();
    be.check.world.defs_of(mi, name, found).try();
    kept ::= be.alloc.Vec<Def>();
    found.loop((h, x) { keep_bodied(be, x, kept).try() });
    Ok(kept.get(0));
}

keep_bodied = (be :: CBackend, x: Def, out :: Vec<Def>)
              Res<(), AllocError> {
    decl_at(be.tree, x.id).match({
        None    => Ok(()),
        Ok(dec) => keep_bodied_decl(dec, x, out),
    })
}

keep_bodied_decl = (dec: Decl, x: Def, out :: Vec<Def>)
                   Res<(), AllocError> {
    dec.kind.match({
        Function(fn) => keep_bodied_fn(fn, x, out),
        _            => Ok(()),
    })
}

keep_bodied_fn = (fn: Function, x: Def, out :: Vec<Def>)
                 Res<(), AllocError> {
    bodyless(fn).match({
        true  => Ok(()),
        false => out.add(x),
    })
}

// -----------------------------------------------------------------
// the symbol, and the short circuit that keeps a failure visible
// -----------------------------------------------------------------

// The symbol of a plain, non-generic function, queued so the walk
// reaches its body: "was this already emitted" and "what do I call"
// have to be the same question.
call_symbol* = (be :: CBackend, d: Def, out :: String)
               Res<(), AllocError> {
    sig ::= be.alloc.Vec<TyId>();
    inst ::= be.alloc.Inst();
    signature_of(be, d, inst, sig).try();
    sym ::= be.alloc.String().try();
    sym_fn(sym, be.check.types, be.check.world, d.qname, sig, inst).try();
    be.need_function(d, inst, sym.view()).try();
    out.add_bytes(sym.view())
}

// `zg_tN = <the write>; if (zg_tN.zg_tag != Ok) { goto done; }`
//
// THE ANSWER AND THE GUARD ARE ONE TEMPORARY because every write
// reachable from a `{}` answers with exactly the door's return type. A
// failing write therefore leaves its own `Err` where the door's answer
// goes, and carrying it is the jump and nothing else — no rebuild, no
// re-tag, and no error set to widen.
write_guarded = (be :: CBackend, call: str, p: Piece) Res<(), AllocError> {
    set_line(be, p.tmp, call).try();
    write_jump_unless_ok(be, p.tmp, p.done)
}

// A piece this backend cannot write. Reported at the node rather than
// swallowed, and the door still answers with its temporary so the C
// around it stays well formed.
unsupported_piece = (be :: CBackend, id: ExprId, what: str)
                    Res<(), AllocError> {
    be.report_expr(id, GenFault.Unsupported(what))
}

// `if (zg_tN.zg_tag != Ok) { goto done; }`
write_jump_unless_ok* = (be :: CBackend, tmp: str, done: usize)
                        Res<(), AllocError> {
    be.write("if (").try();
    be.write(tmp).try();
    be.write(".zg_tag != ").try();
    tag ::= be.alloc.String().try();
    sym_variant(tag, RES_PATH, "Ok").try();
    be.write(tag.view()).try();
    be.writeln(") {").try();
    be.indent();
    write_goto(be, done).try();
    be.dedent();
    be.writeln("}").try();
    Ok(());
}

write_goto* = (be :: CBackend, done: usize) Res<(), AllocError> {
    line ::= be.alloc.String().try();
    line.add_bytes("goto ").try();
    sym_gen(line, "f", done).try();
    line.add_bytes(";").try();
    be.writeln(line.view())
}

write_label* = (be :: CBackend, done: usize) Res<(), AllocError> {
    line ::= be.alloc.String().try();
    sym_gen(line, "f", done).try();
    line.add_bytes(": ;").try();
    be.writeln(line.view())
}
