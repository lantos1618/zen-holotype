Box = { text :: str }
Input = { text: str, scratch: str }
Envelope = { input: Input, other: str }
first = (input: Input, stop: bool) str {
    stop.match({ true => input.text, false => second(input) })
}
second = (input: Input) str { first(input, true) }
put = (box :: Box, input: Input) () { box.text = first(input, false); }
bad = (env: Env, box :: Box) Res<(), AllocError> {
    a    = env.mem.alloc();
    text = a.String("temporary").try();
    put(box, Input(text: text.view(), scratch: "static"));
    Ok(())
}
main = (env: Env) Res<(), AllocError> {
    box ::= Box(text: "");
    bad(env, box).try();
    println(box.text);
    Ok(())
}
