// this file starts with a utf-8 BOM (EF BB BF) before anything else, so the
// BOM is followed by a COMMENT rather than by code. What is printed is
// derived from the declaration that follows, so the test cannot pass on
// compile-survival alone.
Error = AllocError | IoError

width: i32 = 137

main = (env: Env) Res<i32, Error> {
    println("{}", width - 37);
    Ok(0);
}
