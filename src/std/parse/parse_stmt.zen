// src/std/parse/parse_stmt.zen
// Blocks and statements. A semicolon distinguishes a statement; an optional
// final expression is the block's value. Recovery is contained to statement
// boundaries so one malformed statement does not consume the rest of a block.

AllocError = std.mem
no_trivia = std.ast.ast_span
ExprId, TypeId, BlockId = std.ast.ast_id
Block, Stmt, StmtKind, Bind, ExprStmt, Decl, Expr, ExprKind = std.ast.ast_node
TokenKind = std.parse.parse_token
Parser, Mark = std.parse.parser
expr, add_expr = std.parse.parse_expr
type = std.parse.parse_type
declaration, impl_ahead = std.parse.parse_decl
decl_head_ahead = std.parse.parse_lookahead

// `{ statement* expression? }`
block* = (p :: Parser) Res<BlockId, AllocError> {
    p.enter().try();
    id = p.block_guarded().try();
    p.leave();
    Ok(id);
}

block_guarded = (p :: Parser) Res<BlockId, AllocError> {
    p.too_deep.match({
        true  => p.poison_block(),
        false => p.block_here(),
    });
}

block_here = (p :: Parser) Res<BlockId, AllocError> {
    m    = p.open();
    open = p.here_span();
    // A synthesized opener does not establish a statement boundary.
    opened = p.expect(
        TokenKind.BraceOpen,
        "expected `{` to open a block"
    ).try();
    stmts   ::= p.alloc.Vec<Stmt>();
    value   ::= p.no_value();
    running ::= !p.at_kind(TokenKind.BraceClose) && !p.at_eof();
    running.loop((h) {
        before = p.at;
        opened.then(() { p.resume(); });
        p.one_item(stmts).try().match({
            Ok(v) => { value = Ok(v); running = false; },
            None  => (),
        });
        (p.at == before).match({
            true  => { p.skip_one().try(); p.nothing() },
            false => p.nothing(),
        }).try();
        (p.at_kind(TokenKind.BraceClose) || p.at_eof()).match({
            true  => { running = false; },
            false => (),
        });
    });
    // Claim closing trivia before consuming the brace; bump drains the next run.
    close = p.claim_close();
    p.expect_close(
        TokenKind.BraceClose,
        "unclosed `{`: this block is never closed",
        open
    ).try();
    p.tree.add_block(Block(
        stmts: stmts,
        value: value,
        span: p.span_from(m.start),
        leading: m.leading,
        trailing: close,
    ));
}

// The body of a function, a member or a lambda — the one block that is
// not a level inside anything. A too-deep run is anchored at its
// outermost bracket, and `main = () { {{{{ .. }}}} }` nests at the
// first `{` on the statement and not at `main`'s own brace, which
// names the declaration rather than the mistake.
body_block* = (p :: Parser) Res<BlockId, AllocError> {
    was = p.run_from();
    id  = p.block().try();
    p.run_until(was);
    Ok(id);
}

// A block in value position — a match arm's body, a nested block used
// as an expression.
block_expr* = (p :: Parser) Res<ExprId, AllocError> {
    m  = p.open();
    id = p.block().try();
    p.add_expr(ExprKind.Block(id), m);
}

// One statement, or the block's trailing value.
//
// `Ok(v)` means "that was the value, the block is over"; `None` means
// a statement was appended. The two cannot both happen, which is why
// this is one function and not a flag.
one_item = (p :: Parser, stmts :: Vec<Stmt>) Res<Res<ExprId>, AllocError> {
    m = p.open();
    p.peek().kind.match({
        BraceOpen => { p.nested_block(stmts, m).try(); Ok(None) },
        Ident     => p.ident_item(stmts, m),
        _         => p.expr_item(stmts, m),
    });
}

nested_block = (p :: Parser, stmts :: Vec<Stmt>, m: Mark) Res<(), AllocError> {
    id = p.block().try();
    p.push(stmts, StmtKind.Block(id), m);
}

// A statement beginning with a name is the one place a declaration and
// a binding are the same two tokens. `parse_decl.zen` answers which,
// because the answer is a fact about the value's SHAPE (grammar R1a)
// and that knowledge belongs in one place.
ident_item = (
    p     :: Parser,
    stmts :: Vec<Stmt>,
    m     : Mark
) Res<Res<ExprId>, AllocError> {
    p.impl_ahead().match({
        true  => { p.impl_item(stmts, m).try(); Ok(None) },
        false => p.binding_item(stmts, m),
    });
}

binding_item = (
    p     :: Parser,
    stmts :: Vec<Stmt>,
    m     : Mark
) Res<Res<ExprId>, AllocError> {
    p.decl_head_ahead().match({
        true  => { p.decl_item(stmts, m).try(); Ok(None) },
        false => p.expr_item(stmts, m),
    });
}

// Impl declarations are parsed for recovery but diagnosed inside bodies;
// their scope is module-only.
impl_item = (p :: Parser, stmts :: Vec<Stmt>, m: Mark) Res<(), AllocError> {
    p.error(
        "`.impl` declares an impl, so it is legal only at module level, never inside a body"
    ).try();
    p.decl_item(stmts, m)
}

decl_item = (p :: Parser, stmts :: Vec<Stmt>, m: Mark) Res<(), AllocError> {
    d = p.declaration(false).try();
    p.push(stmts, StmtKind.Decl(d), m);
}

// `x = e;`, `x: T ::= e;`, `self.len = self.len + 1;`, `println(..);`
// — and the trailing expression, which is all of the above without the
// `;` and with a `}` behind it.
expr_item = (
    p     :: Parser,
    stmts :: Vec<Stmt>,
    m     : Mark
) Res<Res<ExprId>, AllocError> {
    target = p.expr().try();
    p.peek().kind.match({
        Colon        => { p.bind_typed(stmts, m, target).try(); Ok(None) },
        Eq           => { p.bind(stmts, m, target, false).try(); Ok(None) },
        ColonColonEq => { p.bind(stmts, m, target, true).try(); Ok(None) },
        Semicolon    => { p.expr_stmt(stmts, m, target).try(); Ok(None) },
        _            => p.tail_value(target),
    });
}

// The block's value: an expression with no `;`. Anything other than a
// `}` after it is a missing semicolon, and saying so here is what
// keeps the diagnostic on the statement rather than on whatever the
// next line turned out to be.
tail_value = (p :: Parser, value: ExprId) Res<Res<ExprId>, AllocError> {
    p.at_kind(TokenKind.BraceClose).match({
        true  => Ok(Ok(value)),
        false => {
            p.error_at(
                "expected `;` — a statement ends with one, a declaration does not",
                p.gap_span()
            ).try();
            Ok(Ok(value));
        },
    });
}

bind_typed = (
    p      :: Parser,
    stmts  :: Vec<Stmt>,
    m      : Mark,
    target : ExprId
) Res<(), AllocError> {
    p.bump().try();
    t       = p.type().try();
    mutable = p.at_kind(TokenKind.ColonColonEq);
    p.bind_rest(stmts, m, target, Ok(t), mutable);
}

bind = (
    p       :: Parser,
    stmts   :: Vec<Stmt>,
    m       : Mark,
    target  : ExprId,
    mutable : bool
) Res<(), AllocError> {
    p.bind_rest(stmts, m, target, None, mutable)
}

bind_rest = (
    p       :: Parser,
    stmts   :: Vec<Stmt>,
    m       : Mark,
    target  : ExprId,
    t       : Res<TypeId>,
    mutable : bool
) Res<(), AllocError> {
    p.eat(TokenKind.Eq).try() || p.eat(TokenKind.ColonColonEq).try();
    value = p.expr().try();
    p.expect_after(
        TokenKind.Semicolon,
        "expected `;`: an assignment is a statement, not a value — a statement ends with `;`, a declaration does not"
    ).try();
    p.push(stmts, StmtKind.Bind(Bind(
        target: target,
        type: t,
        mutable: mutable,
        value: value,
    )), m);
}

expr_stmt = (
    p     :: Parser,
    stmts :: Vec<Stmt>,
    m     : Mark,
    e     : ExprId
) Res<(), AllocError> {
    p.bump().try();
    p.push(stmts, StmtKind.Expr(ExprStmt(expr: e)), m);
}

// A statement's span INCLUDES its `;` — otherwise deleting a statement
// leaves the semicolon behind — and the expression inside it does not.
// That is POSITIONS.md rows 54 and 55, and this is the line they test.
push* = (
    p     :: Parser,
    stmts :: Vec<Stmt>,
    kind  : StmtKind,
    m     : Mark
) Res<(), AllocError> {
    end = p.prev_end;
    stmts.add(Stmt(
        kind: kind,
        span: p.span_from(m.start),
        leading: m.leading,
        trailing: p.claim_trailing(end),
    ));
}

// Recovery: one token, so that a statement the parser could not read
// at all still advances the cursor. Without it a malformed token at
// the head of a block is an infinite loop, which is the one failure
// worse than a bad diagnostic.
skip_one = (p :: Parser) Res<(), AllocError> {
    p.at_eof().match({
        true  => p.nothing(),
        false => { p.bump().try(); p.nothing() },
    });
}

no_value = (p: Parser) Res<ExprId> { None }

// An empty block, for when the nesting limit was reached. It has the
// cursor's position and no contents, so a walk over the tree
// terminates and the diagnostic already said why it is empty.
//
// `trailing` stays `no_trivia()` here — deliberately. This block
// consumes no closing brace of its own (`expect_close` was never
// reached), so there is nothing standing before ITS brace to claim:
// claiming here would take the pending run standing before whatever
// token comes next, stealing another node's trivia. Only a block that
// actually closes itself claims its close.
//
// A block has no `add_` half — statements land in a caller's `Vec` via
// `push` above and only the finished block enters the arena — so this
// is half of the fourth poison_/add_ pair; parse_expr.zen's, above
// `poison_expr`, says why the four are not one shared helper.
poison_block* = (p :: Parser) Res<BlockId, AllocError> {
    p.tree.add_block(Block(
        stmts: p.alloc.Vec<Stmt>(),
        value: None,
        span: p.empty_span(),
        leading: no_trivia(),
        trailing: no_trivia(),
    ))
}
