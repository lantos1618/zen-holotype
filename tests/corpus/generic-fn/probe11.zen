// PROBE 147: TEST-final — nested Vec<Vec<T>> read; the None arm returns
// the FALLBACK element (T) not a Vec. Fix the type error from 146.
vv_first = <T>(v: Vec<Vec<T>>, fallback: T) T {
    outer = v.get(0).match({
        Ok(x) => x,
        None  => v.get(1).match({ Ok(y) => y, None => fallback }),
    });
    outer.get(0).match({
        Ok(x) => x,
        None  => fallback,
    });
}

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    inner1 ::= alloc.Vec<i64>();
    inner1.add(4000000081).try();
    outer ::= alloc.Vec<Vec<i64>>();
    outer.add(inner1).try();
    fb: i64 = 1;
    println("nested-first {}", vv_first(outer, fb));
    Ok(0);
}
