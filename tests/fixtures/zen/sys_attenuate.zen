// ATTENUATION beyond Writer (#47): `main = (sys: Sys)` derives TWO *different* narrow caps and hands
// each helper only the authority it needs — never the whole `Sys`. `banner` gets a `Writer` (can emit
// bytes, cannot allocate); `scratch` gets an `Allocator` (`MutPtr<Heap>` — can allocate, has no Writer
// in scope so it structurally cannot print). This generalizes main_sys.zen's single-Writer case: the
// least-authority thesis holds across the cap set, and `sys.stdout()` / `sys.heap().addr()` are the
// attenuating accessors that mint the smaller capability at the call site.
{ Sys, Writer } = std.sys
{ Heap } = std.mem.alloc
// narrowest OUTPUT cap — a Writer, nothing else.
banner = (w: Writer, msg: str) void { w.write_or_panic(msg) }
// narrowest MEMORY cap — an Allocator, nothing else. Acquires `n` bytes, releases them, reports `n`.
// No Writer is in scope here, so this helper cannot emit a single byte.
scratch = (a: MutPtr<Heap>, n: i64) i64 {
    p := a.acquire(n)
    a.release(p)
    n
}
main = (sys: Sys) i32 {
    w := sys.stdout()
    banner(w, "attenuated: ")
    h := sys.heap()
    used := scratch(h.addr(), 64)
    (used == 64).match ({ true => banner(w, "ok\n"), false => banner(w, "bad\n") })
    0
}
