// ── match: value position -> an IIFE returning an arm value; statement position -> a real `switch` (so
//    an arm's early `return` leaves the enclosing function, not just the IIFE). Enum tag is the variant
//    NAME string; a payload binds `_subj.<Variant>`. The last arm (or a `_`) is `default`. ────────────
js_arm_body_expr = (s: String, a: MutPtr<Malloc>, ar: ArmData) String {
    is_empty(ar.bind).match ({
        true  => s.js_expr(a, ar.body),
        false => s.gstr_append(a, "(() => { const ").jname(a, ar.bind).gstr_append(a, " = _subj.").gstr_append(a, ar.variant).gstr_append(a, "; return ").js_expr(a, ar.body).gstr_append(a, "; })()"),
    })
}
js_switch_case = (s: String, a: MutPtr<Malloc>, ar: ArmData, last: bool) String {
    eq(ar.variant, "_").match ({
        true  => s.gstr_append(a, "default: return ").js_arm_body_expr(a, ar).gstr_append(a, "; "),
        false => {
            out := s.gstr_append(a, "case \"").gstr_append(a, ar.variant).gstr_append(a, "\": return ").js_arm_body_expr(a, ar).gstr_append(a, "; ")
            last.match ({
                true  => out.gstr_append(a, "default: return ").js_arm_body_expr(a, ar).gstr_append(a, "; "),
                false => out,
            })
        },
    })
}
js_switch_cases = (s: String, a: MutPtr<Malloc>, arms: [ArmData], i: i64) String {
    (i >= arms.len).match ({
        true  => s,
        false => {
            out := s.js_switch_case(a, arms[i], i == arms.len - 1)
            eq(arms[i].variant, "_").match ({
                true  => out,
                false => out.js_switch_cases(a, arms, i + 1),
            })
        },
    })
}
js_match_expr = (s: String, a: MutPtr<Malloc>, m: MatchData) String { s.gstr_append(a, "(() => { const _subj = ").js_expr(a, m.subj).gstr_append(a, "; switch (_subj.tag) { ").js_switch_cases(a, m.arms, 0).gstr_append(a, "} })()") }
// statement-position match: arms run as statements so a diverging arm's `return` propagates.
js_arm_stmt = (s: String, a: MutPtr<Malloc>, ar: ArmData) String {
    is_empty(ar.bind).match ({
        true  => s.js_arm_stmt_body(a, ar.body),
        false => s.gstr_append(a, "{ const ").jname(a, ar.bind).gstr_append(a, " = _subj.").gstr_append(a, ar.variant).gstr_append(a, "; ").js_arm_stmt_body(a, ar.body).gstr_append(a, " }"),
    })
}
// a braced value-position body is a Block: splice its statements; otherwise it's a bare expr statement.
js_arm_stmt_body = (s: String, a: MutPtr<Malloc>, body: Ptr<Expr>) String {
    load(body).match ({
        .Block(b) => s.js_block_stmts(a, b),
        _         => s.js_expr(a, body).gstr_append(a, ";"),
    })
}
js_switch_stmt_case = (s: String, a: MutPtr<Malloc>, ar: ArmData, last: bool) String {
    eq(ar.variant, "_").match ({
        true  => s.gstr_append(a, "default: ").js_arm_stmt(a, ar).gstr_append(a, " break; "),
        false => {
            out := s.gstr_append(a, "case \"").gstr_append(a, ar.variant).gstr_append(a, "\": ").js_arm_stmt(a, ar).gstr_append(a, " break; ")
            last.match ({
                true  => out.gstr_append(a, "default: ").js_arm_stmt(a, ar).gstr_append(a, " break; "),
                false => out,
            })
        },
    })
}
js_switch_stmt_cases = (s: String, a: MutPtr<Malloc>, arms: [ArmData], i: i64) String {
    (i >= arms.len).match ({
        true  => s,
        false => {
            out := s.js_switch_stmt_case(a, arms[i], i == arms.len - 1)
            eq(arms[i].variant, "_").match ({
                true  => out,
                false => out.js_switch_stmt_cases(a, arms, i + 1),
            })
        },
    })
}
js_match_stmt = (s: String, a: MutPtr<Malloc>, m: MatchData) String { s.gstr_append(a, "{ const _subj = ").js_expr(a, m.subj).gstr_append(a, "; switch (_subj.tag) { ").js_switch_stmt_cases(a, m.arms, 0).gstr_append(a, "} }") }
// a foreach loop -> an IIFE with a JS for-loop over the fat pointer's array/offset backing.
js_loop = (s: String, a: MutPtr<Malloc>, l: LoopData) String {
    out := s.gstr_append(a, "(() => { const _seq = ").js_expr(a, l.seq).gstr_append(a, "; for (let ").jname(a, l.idx).gstr_append(a, " = 0; ").jname(a, l.idx).gstr_append(a, " < _seq.len; ").jname(a, l.idx).gstr_append(a, "++) { const ").jname(a, l.elem).gstr_append(a, " = __zr.idx(_seq, ").jname(a, l.idx).gstr_append(a, "); ")
    out = out.js_stmts(a, l.body)
    out.gstr_append(a, " } return 0; })()")
}
js_block_expr = (s: String, a: MutPtr<Malloc>, b: BlockData) String {
    out := s.gstr_append(a, "(() => { ")
    b.stmts.loop((h, i, st) {
        one := (i == b.stmts.len - 1).match ({
            true  => out.js_block_last(a, st),
            false => out.js_stmt(a, st),
        })
        out = one.gstr_append(a, " ")
    })
    out.gstr_append(a, "})()")
}
// the LAST statement of a block-expr yields the block's value: a bare expr becomes `return expr;`.
js_block_last = (s: String, a: MutPtr<Malloc>, st: Stmt) String {
    st.match ({
        .ExprStmt(e) => s.gstr_append(a, "return ").js_expr(a, e).gstr_append(a, ";"),
        _            => s.js_stmt(a, st),
    })
}
js_block_stmts = (s: String, a: MutPtr<Malloc>, b: BlockData) String {
    out := s
    b.stmts.loop((h, i, st) {
        out = out.js_stmt(a, st).gstr_append(a, " ")
    })
    out
}
// ── statements ────────────────────────────────────────────────────────────────────────────────────
// a `let`: record the binding's declared width in the per-function table, then emit the initializer
// coerced to that width (`x: u32 := a*b` → `let x = ((a*b) >>> 0);`; an unannotated let is width 0 → bare).
js_let = (s: String, a: MutPtr<Malloc>, l: LetData) String {
    vw_note(l.name, l.ty)
    s.gstr_append(a, "let ").jname(a, l.name).gstr_append(a, " = ").js_expr_w(a, l.value, int_width(l.ty)).gstr_append(a, ";")
}
// an assign: coerce the value to the TARGET variable's declared width (looked up in the per-function
// table) so a mutating narrow accumulator wraps like C. A non-Var target (field/index) is width 0.
js_assign = (s: String, a: MutPtr<Malloc>, x: AssignData) String { s.js_expr(a, x.target).gstr_append(a, " = ").js_expr_w(a, x.value, js_assign_width(load(x.target))).gstr_append(a, ";") }
js_assign_width = (e: Expr) i32 {
    e.match ({
        .Var(v) => int_width(vw_lookup(v.name)),
        _       => 0,
    })
}
js_stmt = (s: String, a: MutPtr<Malloc>, st: Stmt) String {
    st.match ({
        .Let(l)      => s.js_let(a, l),
        .Assign(x)   => s.js_assign(a, x),
        .Return(e)   => s.gstr_append(a, "return ").js_expr(a, e).gstr_append(a, ";"),
        .ExprStmt(e) => s.js_expr_stmt(a, e),
        .If(f)       => s.gstr_append(a, "if (").js_expr(a, f.c).gstr_append(a, ") { ").js_stmts(a, f.then).gstr_append(a, "} else { ").js_stmts(a, f.els).gstr_append(a, "}"),
        .While(w)    => s.gstr_append(a, "while (").js_expr(a, w.c).gstr_append(a, ") { ").js_stmts(a, w.body).gstr_append(a, "}"),
        .IndexSet(x) => s.gstr_append(a, "__zr.setidx(").js_expr(a, x.seq).gstr_append(a, ", ").js_expr(a, x.idx).gstr_append(a, ", ").js_expr(a, x.value).gstr_append(a, ");"),
    })
}
// a bare expression statement; a match here becomes a real `switch` (so arm returns fire).
js_expr_stmt = (s: String, a: MutPtr<Malloc>, e: Ptr<Expr>) String {
    load(e).match ({
        .Match(m) => s.js_match_stmt(a, m),
        _         => s.js_expr(a, e).gstr_append(a, ";"),
    })
}
js_stmts = (s: String, a: MutPtr<Malloc>, body: [Stmt]) String {
    out := s
    body.loop((h, i, st) {
        out = out.js_stmt(a, st).gstr_append(a, " ")
    })
    out
}
// ── declarations ──────────────────────────────────────────────────────────────────────────────────
// a function; every param is a bare JS name (types erased). `main` becomes `zen_main`.
js_func_name = (s: String, a: MutPtr<Malloc>, name: string_view) String { eq(name, "main").match ({
    true  => s.gstr_append(a, "zen_main"),
    false => s.jname(a, name),
}) }
js_params = (s: String, a: MutPtr<Malloc>, ps: [Param]) String {
    out := s
    ps.loop((h, i, p) {
        out = (i == 0).match ({ true => out, false => out.gstr_append(a, ", ") })
        out = out.jname(a, p.name)
    })
    out
}
// ── FIXED-WIDTH INTEGER WRAPPING (census #64) ──────────────────────────────────────────────────────
// A JS `number` never wraps, so ordinary integer arithmetic on a fixed-width Zen type disagrees with C
// (which truncates at the type's width via -fwrapv): `100000*100000` is 10000000000 in JS but 1410065408
// in a C `uint32_t`, an FNV-1a hash returns garbage, etc. We reproduce C's truncation-at-the-boundary by
// COERCING a value to its declared width at the three points C's type system does it: a function PARAMETER
// (entry), a typed LET's initializer, and an ASSIGN to a typed variable. `int_width` maps a Ty to a width
// code (0 = not a fixed-width int → no coercion; i64/int stay a native `number`, precise to 2^53); the
// open/close pair wraps an emitted expression with the matching JS idiom:
//   u8 `& 255`   u16 `& 0xffff`   u32 `>>> 0`   i32 `| 0`   i16 `<<16>>16`   i8 `<<24>>24`   u64 `__zr.u64`
// (`<<n>>n` sign-extends the low n bits; `>>>0`/`__zr.u64` reinterpret unsigned; `|0` wraps to signed i32.)
int_width = (t: Ty) i32 {
    t.match ({
        .U8       => 1,
        .I32      => 4,
        .Named(n) => iw_named(n),
        _         => 0,
    })
}
iw_named = (n: string_view) i32 {
    eq(n, "u16").match ({
        true  => 2,
        false => eq(n, "u32").match ({
            true  => 3,
            false => eq(n, "u64").match ({
                true  => 7,
                false => eq(n, "i16").match ({
                    true  => 5,
                    false => eq(n, "i8").match ({ true => 6, false => 0 }),
                }),
            }),
        }),
    })
}
js_w_open = (s: String, a: MutPtr<Malloc>, w: i32) String {
    (w == 7).match ({
        true  => s.gstr_append(a, "__zr.u64(("),
        false => (w == 0).match ({ true => s, false => s.gstr_append(a, "((") }),
    })
}
js_w_close = (s: String, a: MutPtr<Malloc>, w: i32) String {
    (w == 1).match ({
        true  => s.gstr_append(a, ") & 255)"),
        false => (w == 2).match ({
            true  => s.gstr_append(a, ") & 0xffff)"),
            false => (w == 3).match ({
                true  => s.gstr_append(a, ") >>> 0)"),
                false => (w == 4).match ({
                    true  => s.gstr_append(a, ") | 0)"),
                    false => (w == 5).match ({
                        true  => s.gstr_append(a, ") << 16 >> 16)"),
                        false => (w == 6).match ({
                            true  => s.gstr_append(a, ") << 24 >> 24)"),
                            false => (w == 7).match ({ true => s.gstr_append(a, "))"), false => s }),
                        }),
                    }),
                }),
            }),
        }),
    })
}
// emit an expression coerced to width `w` (w == 0 emits the bare expression, byte-identical to before).
// SPECIAL CASE — a 32-bit multiply: `a * b` at u32/i32 must use `Math.imul`, NOT `(a*b) & mask`. A JS
// `number` is an f64, so a full-width 32×32 product (up to ~2^64) loses its low bits above 2^53 BEFORE
// any mask can truncate — an FNV-1a step `hash * 16777619` (hash ~2^32, prime ~2^24 → ~2^56) came out
// wrong. `Math.imul` is a true mod-2^32 multiply (both operands taken as int32, low 32 bits returned),
// so it reproduces C's wrapping exactly. Only the OUTERMOST operator is rewritten; a multiply nested
// under another operator whose own product exceeds 2^53 is a rarer edge (documented in bootstrap/zenrt.js
// design notes). Narrower widths (≤16-bit) need no imul: their product never exceeds 2^32 < 2^53.
js_expr_w = (s: String, a: MutPtr<Malloc>, e: Ptr<Expr>, w: i32) String {
    js_is_mul32(load(e), w).match ({
        true  => s.js_mul32(a, load(e), w),
        false => s.js_w_open(a, w).js_expr(a, e).js_w_close(a, w),
    })
}
js_is_mul32 = (e: Expr, w: i32) bool {
    (w == 3 || w == 4).match ({
        true  => e.match ({
            .Bin(b) => eq(b.op, "*"),
            _       => false,
        }),
        false => false,
    })
}
js_mul32 = (s: String, a: MutPtr<Malloc>, e: Expr, w: i32) String {
    e.match ({
        .Bin(b) => (w == 3).match ({
            true  => s.gstr_append(a, "((Math.imul(").js_expr(a, b.lhs).gstr_append(a, ", ").js_expr(a, b.rhs).gstr_append(a, ")) >>> 0)"),
            false => s.gstr_append(a, "Math.imul(").js_expr(a, b.lhs).gstr_append(a, ", ").js_expr(a, b.rhs).gstr_append(a, ")"),
        }),
        _       => s,
    })
}
// ── per-function typed-variable table (name → declared Ty) ─────────────────────────────────────────
// Populated as emission walks a function in lexical order: params at entry, then each typed LET. An
// ASSIGN to a bare variable looks its target up here to coerce the assigned value to the variable's
// width (the FNV-hash case: `hash = (hash ^ b) * 16777619` where `hash: u32` mutates in a loop). Mirrors
// parse.zen's exports_buf pattern; reset at every function entry (Zen has no nested fns — lambdas are
// inlined before genjs — so one flat table per function is exact).
vw_buf := vw_none()
vw_n := 0
vw_none = () [Param] { slice(null_ptr(), 0) }
vw_reset = (a: MutPtr<Malloc>) void {
    vw_buf = slice(a.acquire(8192 * sizeof(Param)), 8192)
    vw_n = 0
}
vw_get = () [Param] { slice(vw_buf.ptr, vw_n) }
vw_note = (name: string_view, ty: Ty) void {
    (vw_n < vw_buf.len).then({
        vw_buf[vw_n] = param(name, ty)
        vw_n = vw_n + 1
    })
}
// last matching entry wins (an inner-scope shadow declared later overrides an earlier sibling).
vw_lookup = (name: string_view) Ty {
    r := tvoid()
    vw_get().loop((h, i, p) {
        r = eq(p.name, name).match ({ true => p.ty, false => r })
    })
    r
}
js_param_norms = (s: String, a: MutPtr<Malloc>, ps: [Param]) String {
    out := s
    ps.loop((h, i, p) {
        vw_note(p.name, p.ty)
        w := int_width(p.ty)
        out = (w == 0).match ({
            true  => out,
            false => out.jname(a, p.name).gstr_append(a, " = ").js_w_open(a, w).jname(a, p.name).js_w_close(a, w).gstr_append(a, "; "),
        })
    })
    out
}
js_func = (s: String, a: MutPtr<Malloc>, f: Func) String {
    vw_reset(a)
    s.gstr_append(a, "function ").js_func_name(a, f.name).gstr_append(a, "(").js_params(a, f.params).gstr_append(a, ") { ").js_param_norms(a, f.params).js_stmts(a, f.body).gstr_append(a, "}\n")
}
// a module-level global `name := init` -> `let name = init;` (mutable; some are scheduler/runtime state).
js_global = (s: String, a: MutPtr<Malloc>, g: GlobalData) String { s.gstr_append(a, "let ").jname(a, g.name).gstr_append(a, " = ").js_expr(a, g.init).gstr_append(a, ";\n") }
// does the module define a `main`? then the emitted JS invokes it.
js_has_main = (decls: [Decl]) bool {
    found := false
    decls.loop((h, i, d) {
        found = d.match ({
            .DFunc(f) => eq(f.name, "main").match ({ true => true, false => found }),
            _         => found,
        })
    })
    found
}
// whole translation unit -> JS. Globals first (const-init, mirrors genc), then functions (hoisted in
// JS, so order is free), then the `zen_main()` invocation. The `__zr` floor is prepended by the driver.
genJsModuleIn* = (a: MutPtr<Malloc>, raw: [Decl]) String {
    decls := a.monomorphize(raw)
    s := a.gstr_string(4096).gstr_append(a, "\"use strict\";\n")
    decls.loop((h, i, d) {
        s = d.match ({
            .DGlobal(g) => s.js_global(a, g),
            _           => s,
        })
    })
    decls.loop((h, i, d) {
        s = s.js_decl_fn(a, d)
    })
    decls.js_has_main().match ({ true => s.gstr_append(a, "\nzen_main();\n"), false => s })
}
// functions only (globals already emitted first, so a global's init never forward-refs a fn body at TDZ).
js_decl_fn = (s: String, a: MutPtr<Malloc>, d: Decl) String {
    d.is_template().match ({
        true  => s,
        false => d.is_trait().match ({
            true  => s,
            false => d.match ({
                .DFunc(f) => s.js_func(a, f),
                _         => s,
            }),
        }),
    })
}
