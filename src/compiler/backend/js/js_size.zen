// compiler.backend.js.js_size — the C-ABI byte size of a named type, computed at EMIT time.
//
// `sizeof(T)` is how Zen sizes allocations and slice strides, and the js floor's linear memory is the
// SAME byte-addressed space C's is (bootstrap/zenrt.js MEM), so the only correct answer on the js
// target is C's answer. The C backend defers to the C compiler (`sizeof(int32_t)`); JavaScript has no
// such operator, so the size is computed here from the post-monomorphization decl list, reproducing
// the LP64 layout genc emits:
//   • scalars by width, `bool`/`void` 1, every pointer 8, `[T]` the 16-byte `zslice`, `zfn` 8;
//   • a struct = its fields at natural alignment with tail padding (c_decl.gen_struct);
//   • an enum  = `struct { int32_t tag; union { payloads } u; }` (c_decl.gen_enum), void payloads
//     contributing no union member.
// A name this cannot resolve returns js_size_unknown() and js_expr REFUSES to emit — the runtime stub
// it replaces answered 8 for EVERY type, which is a silent miscompile of every `n * sizeof(T)`.
//
// The name reaching `sizeof` is a Zen spelling (`i32`) at a direct call and a C spelling (`int32_t`)
// where the inliner substituted a tparam through genc.ty_cname_in, so both spellings are accepted.
{ Decl, Ty, StructDecl, EnumDecl } = compiler.ast.ast_types
{ ends_with } = std.text.str
js_size_unknown* = () i64 { 0 - 1 }
jsz_no_decls = () [Decl] { slice(null_ptr(), 0) }
// the module being emitted; parked by js.genJsModuleIn straight after monomorphize.
jsz_decls := jsz_no_decls()
js_size_set* = (decls: [Decl]) void { jsz_decls = decls }
jsz_round = (n: i64, al: i64) i64 { (n + al - 1) / al * al }
jsz_max = (x: i64, y: i64) i64 { (x >= y).then({ x }, { y }) }
// a scalar spelled either way (Zen name, or the C name genc's tparam substitution leaves behind).
jsz_prim_size = (n: StringView) i64 {
    (n == "i8" || n == "u8" || n == "int8_t" || n == "uint8_t" || n == "bool" || n == "void").then({
        return 1
    })
    (n == "i16" || n == "u16" || n == "int16_t" || n == "uint16_t").then({
        return 2
    })
    (n == "i32" || n == "u32" || n == "f32" || n == "int32_t" || n == "uint32_t" || n == "float").then({
        return 4
    })
    (n == "i64" || n == "u64" || n == "f64" || n == "int64_t" || n == "uint64_t" || n == "double").then({
        return 8
    })
    js_size_unknown()
}
// every scalar's alignment IS its size on LP64; only the aggregates below differ.
jsz_named_size = (n: StringView, depth: i32) i64 {
    p := jsz_prim_size(n)
    (p >= 0).then({
        return p
    })
    (n == "zslice").then({
        return 16
    })
    jsz_is_ptr_name(n).then({
        return 8
    })
    jsz_decl_size(n, depth)
}
jsz_named_align = (n: StringView, depth: i32) i64 {
    p := jsz_prim_size(n)
    (p >= 0).then({
        return p
    })
    (n == "zslice").then({
        return 8
    })
    jsz_is_ptr_name(n).then({
        return 8
    })
    jsz_decl_align(n, depth)
}
// a C pointer spelling (`int32_t*`, `const char*`), the string_* family (all `const char*`), or `zfn`.
jsz_is_ptr_name = (n: StringView) bool {
    n.ends_with("*") || n == "zfn" || n == "StringView" || n == "StringCstr" || n == "StringLiteral"
}
jsz_ty_size = (t: Ty, depth: i32) i64 {
    t.match ({
        .I32           => 4,
        .I64           => 8,
        .U8            => 1,
        .F64           => 8,
        .Bool          => 1,
        .Void          => 1,
        .StringView    => 8,
        .StringCstr    => 8,
        .StringLiteral => 8,
        .Ptr(pd)       => 8,
        .Slice(e)      => 16,
        .FnT(ft)       => 8,
        .Named(n)      => jsz_named_size(n, depth),
        .Generic(g)    => jsz_named_size(g.mangled, depth),
    })
}
jsz_ty_align = (t: Ty, depth: i32) i64 {
    t.match ({
        .Slice(e)   => 8,
        .Named(n)   => jsz_named_align(n, depth),
        .Generic(g) => jsz_named_align(g.mangled, depth),
        _           => jsz_ty_size(t, depth),
    })
}
// A struct/enum name resolves against the emitted decl list. `depth` bounds the field recursion so a
// malformed self-referential decl answers "unknown" instead of spinning (C forbids one by value, but
// the emitter must not depend on the checker having rejected it).
jsz_decl_size = (n: StringView, depth: i32) i64 {
    (depth > 24).then({
        return js_size_unknown()
    })
    r := js_size_unknown()
    jsz_decls.loop((h, i, d) {
        r = d.match ({
            .DStruct(sd) => (sd.name == n).then({ jsz_struct_size(sd, depth + 1) }, { r }),
            .DEnum(ed)   => (ed.name == n).then({ jsz_enum_size(ed, depth + 1) }, { r }),
            _            => r,
        })
    })
    r
}
jsz_decl_align = (n: StringView, depth: i32) i64 {
    (depth > 24).then({
        return js_size_unknown()
    })
    r := js_size_unknown()
    jsz_decls.loop((h, i, d) {
        r = d.match ({
            .DStruct(sd) => (sd.name == n).then({ jsz_struct_align(sd, depth + 1) }, { r }),
            .DEnum(ed)   => (ed.name == n).then({ jsz_enum_align(ed, depth + 1) }, { r }),
            _            => r,
        })
    })
    r
}
jsz_struct_size = (sd: StructDecl, depth: i32) i64 {
    off: i64 := 0
    al: i64 := 1
    bad := false
    sd.fields.loop((h, i, f) {
        fs := jsz_ty_size(f.ty, depth)
        fa := jsz_ty_align(f.ty, depth)
        bad = bad || fs < 0 || fa < 0
        off = (fs < 0 || fa < 0).then({ off }, { jsz_round(off, fa) + fs })
        al = (fa < 0).then({ al }, { jsz_max(al, fa) })
    })
    bad.then({ js_size_unknown() }, { jsz_round(off, al) })
}
jsz_struct_align = (sd: StructDecl, depth: i32) i64 {
    al: i64 := 1
    bad := false
    sd.fields.loop((h, i, f) {
        fa := jsz_ty_align(f.ty, depth)
        bad = bad || fa < 0
        al = (fa < 0).then({ al }, { jsz_max(al, fa) })
    })
    bad.then({ js_size_unknown() }, { al })
}
// the union of the payload-carrying variants: size = max payload rounded to the union's alignment.
jsz_union_size = (ed: EnumDecl, depth: i32) i64 {
    usz: i64 := 0
    bad := false
    ed.variants.loop((h, i, v) {
        v.payload.match ({
            .Void => { },
            _     => {
                ps := jsz_ty_size(v.payload, depth)
                bad = bad || ps < 0
                usz = (ps < 0).then({ usz }, { jsz_max(usz, ps) })
            },
        })
    })
    bad.then({ js_size_unknown() }, { usz })
}
jsz_union_align = (ed: EnumDecl, depth: i32) i64 {
    ual: i64 := 1
    bad := false
    ed.variants.loop((h, i, v) {
        v.payload.match ({
            .Void => { },
            _     => {
                pa := jsz_ty_align(v.payload, depth)
                bad = bad || pa < 0
                ual = (pa < 0).then({ ual }, { jsz_max(ual, pa) })
            },
        })
    })
    bad.then({ js_size_unknown() }, { ual })
}
jsz_enum_size = (ed: EnumDecl, depth: i32) i64 {
    usz := jsz_union_size(ed, depth)
    ual := jsz_union_align(ed, depth)
    (usz < 0 || ual < 0).then({
        return js_size_unknown()
    })
    al := jsz_max(4, ual)
    jsz_round(jsz_round(4, ual) + jsz_round(usz, ual), al)
}
jsz_enum_align = (ed: EnumDecl, depth: i32) i64 {
    ual := jsz_union_align(ed, depth)
    (ual < 0).then({
        return js_size_unknown()
    })
    jsz_max(4, ual)
}
// THE entry point: the byte size of the type named at a `sizeof(<name>)`, or js_size_unknown().
js_size_of_name* = (n: StringView) i64 { jsz_named_size(n, 0) }
