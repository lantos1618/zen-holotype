// THE FILE ON DISK, byte for byte the buffer the test opens. The buffer
// is the build's entry; this copy is what a build with no overlay would
// read, and keeping the two identical is what makes the expected file
// answerable by eye.
Point, sum = app.shape

near = (q: Point, n: i32) i32 {
    s = sum(q) + q.x;
    s
}
