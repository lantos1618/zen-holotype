// Borrowed bytes with no allocation, growth, or ownership. len, indexing, and
// equality are byte-based; Unicode decoding is explicit through text_utf8.

Ptr = std.mem.mem
Eq, Hash, Hasher = std.core.core
Range, loop, to_lower = std.core.core
is_ident_start, is_ident_cont = std.core.core

str* = {
    data: Ptr<u8>,
    len*: usize,

    is_empty* = (self: @Self) bool { self.len == 0 }

    // Accepts `[A-Za-z_][A-Za-z0-9_]*`; keywords are not rejected.
    is_identifier* = (self: @Self) bool {
        (self.len > 0) && self.index(0).is_ident_start()
            && Range(1, self.len).find((i) {
                self.index(i).is_ident_cont() == false
            }).match({ Ok(_) => false, None => true })
    }

    // Borrow the first byte for raw external calls. The same lifetime rule as
    // String.view applies: the owner must not move or grow the backing run
    // while the foreign call is using it.
    ptr* = (self: @Self) Ptr<u8> { self.data }

    get* = (self: @Self, i: usize) Res<u8> {
        (i < self.len).match({
            true  => Ok(self.data.read(i)),
            false => None,
        });
    }

    // Indexing traps out of range. The subtraction underflows for i >= len.
    index* = (self: @Self, i: usize) u8 {
        self.len - i - 1;
        self.data.read(i);
    }

    // Borrows without copying or allocating; invalid bounds trap.
    slice* = (self: @Self, from: usize, to: usize) str {
        tail = self.len - to;
        str(data: self.data.offset(from), len: self.len - from - tail);
    }

    // `dst` must have room for `self.len` bytes.
    copy_into* = (self: @Self, dst: Ptr<u8>) () {
        (self.len > 0).match({
            true  => dst.copy_from(self.data, self.len),
            false => (),
        });
    }

    // Returns the first matching byte index, or None.
    find* = (self: @Self, needle: u8) Res<usize> {
        hit: Res<usize> = None;
        Range(0, self.len).loop((h, i) {
            (self.data.read(i) == needle).then(() {
                hit = Ok(i);
                h.break(0);
            });
        });
        hit;
    }

    // An empty needle matches at zero.
    find* = (self: @Self, needle: str) Res<usize> {
        needle.len.match({
            0 => Ok(0),
            _ => (self.len < needle.len).match({
                true  => None,
                false => Range(0, self.len - needle.len + 1)
                    .find((i) { self.matches_at(i, needle) }),
            }),
        })
    }

    // Returns the last matching byte index, or None.
    rfind* = (self: @Self, needle: u8) Res<usize> {
        hit: Res<usize> = None;
        at ::= self.len;
        loop(at > 0, (h) {
            at = at - 1;
            (self.data.read(at) == needle).then(() {
                hit = Ok(at);
                h.break(0);
            });
        });
        hit;
    }

    // A missing delimiter returns the whole string; a trailing delimiter
    // returns an empty suffix.
    after_last* = (self: @Self, delimiter: u8) str {
        self.rfind(delimiter).match({
            Ok(i) => self.slice(i + 1, self.len),
            None  => self.slice(0, self.len),
        })
    }
}

// Borrows `len` bytes from `data`; the owner must keep them alive and stable.
str_at* = (data: Ptr<u8>, len: usize) str { str(data: data, len: len) }

contains* = (self: str, needle: u8) bool {
    self.find(needle).match({
        Ok(_) => true,
        None  => false,
    });
}

contains* = (self: str, needle: str) bool {
    self.find(needle).match({ Ok(_) => true, None => false })
}

// Number of non-overlapping occurrences. An empty needle names no concrete
// byte run, so it has zero occurrences rather than one at every boundary.
count* = (self: str, needle: str) usize {
    n ::= 0;
    (needle.len > 0).then(() {
        at ::= 0;
        loop(at <= self.len, (h) {
            self.slice(at, self.len).find(needle).match({
                Ok(i) => { n = n + 1; at = at + i + needle.len; },
                None  => h.break(),
            });
        });
    });
    n
}

matches_at = (self: str, from: usize, other: str) bool {
    hit ::= true;
    Range(0, other.len).loop((h, i) {
        (self.data.read(from + i) != other.data.read(i)).then(() {
            hit = false;
            h.break();
        });
    });
    hit;
}

// An empty string is both a prefix and suffix of every string.
starts_with* = (self: str, head: str) bool {
    (self.len >= head.len).match({
        false => false,
        true  => self.matches_at(0, head),
    });
}

ends_with* = (self: str, tail: str) bool {
    (self.len >= tail.len).match({
        false => false,
        true  => self.matches_at(self.len - tail.len, tail),
    });
}

// Returns None when no non-whitespace byte remains. Whitespace is the ASCII
// set recognized by byte.is_space.
trim* = (self: str) Res<str> {
    self.trim_start().match({
        Ok(head) => head.trim_end(),
        None     => None,
    });
}

trim_start* = (self: str) Res<str> {
    hit: Res<str> = None;
    Range(0, self.len).loop((h, i) {
        (!self.data.read(i).is_space()).then(() {
            hit = Ok(self.slice(i, self.len));
            h.break(0);
        });
    });
    hit;
}

trim_end* = (self: str) Res<str> {
    hit: Res<str> = None;
    keep ::= self.len;
    loop(keep > 0, (h) {
        keep = keep - 1;
        (!self.data.read(keep).is_space()).then(() {
            hit = Ok(self.slice(0, keep + 1));
            h.break(0);
        });
    });
    hit;
}

// ASCII-only case-insensitive equality.
eq_ignore_case* = (self: str, other: str) bool {
    (self.len == other.len).match({
        false => false,
        true  => self.same_folded(other),
    });
}

same_folded = (self: str, other: str) bool {
    hit ::= true;
    Range(0, other.len).loop((h, i) {
        (self.data.read(i).to_lower() != other.data.read(i).to_lower())
            .then(() { hit = false; h.break(); });
    });
    hit;
}

// Iterates borrowed byte slices without allocating. A trailing separator
// yields a final empty piece; adjacent separators preserve empty pieces.

Split* = {
    bytes*: str,
    sep*: u8,

    from :: usize = 0,
    done :: bool = false,

    // Sequential iteration is O(total bytes); `at(k)` rescans for random access.
    next* = (self :: @Self) Res<str> {
        self.done.match({
            true  => None,
            false => self.bytes.slice(self.from, self.bytes.len)
                .find(self.sep)
                .match({
                    Ok(i) => {
                        piece     = self.bytes.slice(self.from, self.from + i);
                        self.from = self.from + i + 1;
                        Ok(piece);
                    },
                    None  => {
                        self.done = true;
                        Ok(self.bytes.slice(self.from, self.bytes.len));
                    },
                }),
        });
    }
}

piece_at = (s: str, sep: u8, k: usize) Res<str> {
    from ::= 0;
    n    ::= 0;
    answer: Res<str> = None;
    Range(0, s.len + 1).loop((h, i) {
        edge ::= false;
        s.get(i).match({
            None  => { edge = true; },
            Ok(b) => { (b == sep).then(() { edge = true; }); },
        });
        edge.then(() {
            (n == k).match({
                true  => { answer = Ok(s.slice(from, i)); h.break(0); },
                false => { from = i + 1; n = n + 1; },
            });
        });
    });
    answer;
}

Split.impl(Range<str>, {
    start: 0,
    end: self.bytes.len + 1,

    at ::= (self: @Self, index: usize) Res<str> {
        piece_at(self.bytes, self.sep, index)
    }
})

split* = (self: str, sep: u8) Split { Split(bytes: self, sep: sep) }

// FNV basis and prime, with wrapping addition in place of xor.
STR_HASH_SEED*: u64 = 14695981039346656037
STR_HASH_MULT*: u64 = 1099511628211

// Lexicographic byte order; the shorter string wins a prefix tie. This is not
// language-aware collation.
before* = (self: str, other: str) bool {
    shorter = (self.len < other.len).match({
        true  => self.len,
        false => other.len,
    });
    ordered ::= self.len < other.len;
    Range(0, shorter).loop((h, i) {
        left  = self.data.read(i);
        right = other.data.read(i);
        (left != right).match({
            true  => { ordered = left < right; h.break(); },
            false => (),
        });
    });
    ordered;
}

str.impl(Eq, {
    eq ::= (self: @Self, other: @Self) bool {
        (self.len == other.len).match({
            false => false,
            true  => Range(0, self.len)
                .find((i) { self.data.read(i) != other.data.read(i) })
                .match({
                    Ok(_) => false,
                    None  => true,
                }),
        });
    }
})

str.impl(Hash, {
    // Hashes bytes, matching bytewise equality; arithmetic wraps intentionally.
    hash ::= (self: @Self, hasher :: Hasher) u64 {
        acc ::= STR_HASH_SEED;
        Range(0, self.len).loop((h, i) {
            acc = acc *% STR_HASH_MULT +% self.data.read(i).to_u64();
        });
        acc;
    }
})

str.impl(Range<u8>, {
    start: 0,
    end: self.len,

    at ::= (self: @Self, index: usize) Res<u8> { self.get(index) }
})
