// compiler.backend.js.js_expr — expression, match, statement JS-emission over the genc AST, plus the fixed-width
// integer-wrapping helpers and the per-function typed-variable table. Extracted from compiler.backend.js.js.
// Leaf int/name/escape helpers live in compiler.backend.js.js_lit; DOM lowering in compiler.backend.js.js_dom; decl and
// module assembly in compiler.backend.js.js.
{ String } = std.text.string
{ is_empty } = std.text.str
{ Expr, Stmt, Ty, Param, ArmData, BinData, CallData, CondData, MatchData, MemberData,
  MakeStructData, MakeEnumData, LoopData, BlockData, LetData, AssignData } = compiler.ast.ast_types
{ param, tvoid, tnamed, gstr_append, acquire_or_die, acquire_or_die } = compiler.genc
{ Malloc } = std.mem.alloc
{ slice_count } = compiler.astops
{ jint, jname, jstrlit } = compiler.backend.js.js_lit
{ js_dom_dispatch } = compiler.backend.js.js_dom
{ js_box_taken } = compiler.backend.js.js_box
{ js_size_of_name } = compiler.backend.js.js_size
{ js_cp_needed, js_cp_open, js_cp_close, jsc_member_ty, js_variant_ty, js_init_ty, js_func_ret,
  js_is_defined_fn } = compiler.backend.js.js_copy
{ loop_at } = std.core.count
{ is_intrinsic } = compiler.check    // the ONE intrinsic roster; the parity gate below reads it, never a copy
// ── expressions ───────────────────────────────────────────────────────────────────────────────────
js_expr* = (s: String, a: MutPtr<Malloc>, e: Ptr<Expr>) String {
    e.match ({
        .Int(n)         => s.js_int_lit(a, n),
        .Byte(n)        => s.jint(a, n),
        .FloatLit(ft)   => s.gstr_append(a, ft),
        .Var(v)         => s.js_var_ref(a, v.name),
        .Bin(b)         => s.js_bin(a, b),
        .Call(c)        => s.js_call(a, c),
        .MethodCall(mc) => s.gstr_append(a, "__zr.undesugared_method_call"),
        .Cond(d)        => s
            .gstr_append(a, "(")
            .js_expr(a, d.c)
            .gstr_append(a, " ? ")
            .js_expr(a, d.t)
            .gstr_append(a, " : ")
            .js_expr(a, d.e)
            .gstr_append(a, ")"),
        .Member(m)      => s.js_member(a, m),
        .Arrow(ar)      => s.js_expr(a, ar.obj).gstr_append(a, ".").gstr_append(a, ar.field),
        .MakeEnum(m)    => s.js_mkenum(a, m),
        .MakeStruct(m)  => s.js_mkstruct(a, m),
        .Tag(t)         => s
            .gstr_append(a, "({ tag: \"")
            .gstr_append(a, t.variant)
            .gstr_append(a, "\" })"),
        .Match(m)       => s.js_match_expr(a, m),
        .StrLit(sl)     => s.jstrlit(a, sl.value),
        // A [u8] literal is a BYTE BUFFER: back it with linear memory (__zr.u8lit copies the items
        // into MEM and returns the offset), so `.ptr` supports the full RawPtr surface — offset/
        // store/load/slice/write — exactly as C's stack compound literal does (std.text.fmt's digit
        // scratch depends on this). Non-byte element types keep the JS-array fat pointer; __zr.idx/
        // setidx dispatch on the backing, taking the element width (js_elem_w) for the MEM case.
        .SliceLit(sd)   => sd.elem.match ({
            .U8 => s
                .gstr_append(a, "({ ptr: __zr.u8lit([")
                .js_args(a, sd.items)
                .gstr_append(a, "]), len: ")
                .jint(a, slice_count(sd.items))
                .gstr_append(a, " })"),
            _   => s
                .gstr_append(a, "({ ptr: [")
                .js_cp_items(a, sd.items, sd.elem)
                .gstr_append(a, "], len: ")
                .jint(a, slice_count(sd.items))
                .gstr_append(a, " })"),
        }),
        .Index(ix)      => s
            .gstr_append(a, "__zr.idx(")
            .js_expr(a, ix.seq)
            .gstr_append(a, ", ")
            .js_expr(a, ix.idx)
            .gstr_append(a, ", ")
            .jint(a, js_elem_w(ix.elem))
            .gstr_append(a, ")"),
        .Loop(l)        => s.js_loop(a, l),
        .Lambda(lm)     => s.gstr_append(a, "__zr.unlowered_lambda"),
        .Block(b)       => s.js_block_expr(a, b),
    })
}
// ── BOXED (address-taken) SCALAR LOCALS ───────────────────────────────────────────────────────────
// `addr` on a struct is the identity (a JS object IS a reference), but a scalar is a JS number, so an
// identity `addr` handed `store` a COPY and the write vanished. A scalar local whose address is taken
// anywhere in the function (compiler.backend.js.js_box's pre-pass) is therefore given real storage: one
// cell in the shared linear memory. The variable then HOLDS the MEM offset, so `addr(x)` is `x` itself
// and every load/store/offset over it behaves as in C; reads become `__zr.ld(x, w)` and writes
// `__zr.st(x, v, w)`, with `w` the same width code int_width already assigns (plus 9 = f64, 10 = bool),
// so the cell is exactly as wide as the C variable and a BYTE store lands in its low byte.
// Width 0 (a struct, pointer, slice, string, or unannotated binding) is NOT boxed — the identity
// lowering is right for those, and boxing an object would break it.
js_cell_w* = (t: Ty) i32 {
    w = int_width(t)
    (w != 0).then({
        return w
    })
    t.match ({
        .F64  => 9,
        .Bool => 10,
        _     => 0,
    })
}
// ── typed slice ELEMENTS ──────────────────────────────────────────────────────────────────────────
// A slice's `.ptr` is either a JS array (a non-byte slice literal) or a MEM offset (everything that came
// through an allocator). In the MEM case an element read must know the element's WIDTH, exactly as C's
// `zen__idx(z, i, sizeof(T))` does: the floor used to read one BYTE at `ptr + i` whatever T was, so
// every `[i64]`/`[StringView]`/`[i32]` slice backed by linear memory decoded to garbage — silently,
// since a byte is a perfectly good number. `js_elem_w` extends the cell-width codes with 11 = an
// 8-byte POINTER (a str/RawPtr/fn element, read back as a MEM offset). Code 0 means "no linear-memory
// representation" (a struct, enum, or nested slice element): the floor PANICS on such a read rather
// than inventing one, since MEM holds bytes and a struct on this target is a JS object.
js_elem_w* = (t: Ty) i32 {
    w = js_cell_w(t)
    (w != 0).then({
        return w
    })
    t.match ({
        .Ptr(pd)       => 11,
        .StringView    => 11,
        .StringCstr    => 11,
        .StringLiteral => 11,
        .FnT(ft)       => 11,
        _              => 0,
    })
}
// the boxing width of a NAME: nonzero only when its address is taken AND its declared type is scalar.
js_boxed_w* = (name: StringView) i32 {
    js_box_taken(name).then({ js_cell_w(vw_lookup(name)) }, { 0 })
}
js_var_ref = (s: String, a: MutPtr<Malloc>, name: StringView) String {
    w = js_boxed_w(name)
    (w == 0).match ({
        true  => s.jname(a, name),
        false => s
            .gstr_append(a, "__zr.ld(")
            .jname(a, name)
            .gstr_append(a, ", ")
            .jint(a, w)
            .gstr_append(a, ")"),
    })
}
// Loop control may cross match IIFEs and nested loop IIFEs, so bare JS break/continue cannot represent
// it. Each loop owns two identity tokens; handler access throws the selected token from an expression-
// safe IIFE, and the target loop catches only its own tokens (rethrowing outer-loop control/exceptions).
// `.u` is genc's union-payload access baked by the checker's or_return / match-payload lowering
// (`subj.u.Variant`). The JS enum has NO `u` level — it's a flat `{ tag, Variant }` — so `.u` erases
// to identity: `subj.u.Ok` emits as `subj.Ok`. (`break_zk`/`continue_zk` are the loop-handler verbs.)
js_loop_token = (s: String, a: MutPtr<Malloc>, obj: Ptr<Expr>, suffix: StringView) String {
    load(obj).match ({
        .Var(v) => s.jname(a, v.name).gstr_append(a, suffix),
        _       => s.gstr_append(a, "__zen_invalid_loop_handler"),
    })
}
js_loop_throw = (s: String, a: MutPtr<Malloc>, obj: Ptr<Expr>, suffix: StringView) String {
    s.gstr_append(a, "(() => { throw ").js_loop_token(a, obj, suffix).gstr_append(a, "; })()")
}
js_member = (s: String, a: MutPtr<Malloc>, m: MemberData) String {
    (m.field == "break_zk").match ({
        true  => s.js_loop_throw(a, m.obj, "__b"),
        false => (m.field == "continue_zk").match ({
            true  => s.js_loop_throw(a, m.obj, "__c"),
            false => (m.field == "u").match ({
                true  => s.js_expr(a, m.obj),
                false => s.js_expr(a, m.obj).gstr_append(a, ".").gstr_append(a, m.field),
            }),
        }),
    })
}
// `==`/`!=` -> strict; INTEGER `/` and `%` route through the guarded floor (div-by-zero panics); the
// checker's float-division marker `/.` emits NATIVE `/` so f64 follows IEEE (`0.0/0.0` -> NaN, never a
// panic); all else `(lhs op rhs)`.
//
// WIDTH-CORRECTNESS: a JS `number` is a 32-bit-op / 2^53-mantissa view, so a 64-bit (i64/u64) operator
// must run in BigInt — exact and arbitrary-precision. When EITHER operand is statically 64-bit (`iw_of`),
// both operands are coerced to BigInt (`js_bexpr(.., big)`) so nothing mixes BigInt with number, and the
// boundary (let/param/assign/return) wraps back to the type's width. A 32-bit-or-narrower UNSIGNED `>>`
// becomes the logical `>>>` (a signed `>>` sign-fills a high-bit-set u32). See bootstrap/zenrt.js.
js_bin = (s: String, a: MutPtr<Malloc>, b: BinData) String {
    big = is_w64(iw_of(load(b.lhs))) || is_w64(iw_of(load(b.rhs)))
    (b.op == "/.").then({
        return s
            .gstr_append(a, "(")
            .js_expr(a, b.lhs)
            .gstr_append(a, " / ")
            .js_expr(a, b.rhs)
            .gstr_append(a, ")")
    })
    // PER-OP WIDTH TRUNCATION: a JS `number` never wraps, so a narrow-int (i8/i16/i32, u8/u16/u32)
    // `+ - * / %` RESULT is truncated to its declared width right here — else an overflowing
    // intermediate leaks an un-wrapped double into a following `%`/`/`/chained op and diverges from
    // C, which wraps at every step (-fwrapv). 64-bit stays exact in BigInt (w=0, boundary wraps);
    // bitwise `& | ^ << >>` self-coerce to int32 in JS, so only arithmetic needs this. A 32-bit
    // multiply routes through Math.imul (its product exceeds 2^53 before any mask could catch it).
    w = big.then({ 0 }, { js_trunc_w(b) })
    js_is_mul32(.Bin(b), w).then({
        return s.js_mul32(a, .Bin(b), w)
    })
    s.js_w_open(a, w).js_bin_core(a, b, big).js_w_close(a, w)
}
// the untruncated core: integer `/`/`%` route through the guarded floor (div-by-zero panics); all
// else is `(lhs op rhs)`. `big` promotes each operand to BigInt for the 64-bit path.
js_bin_core = (s: String, a: MutPtr<Malloc>, b: BinData, big: bool) String {
    (b.op == "/").then({
        return s
            .gstr_append(a, "__zr.div(")
            .js_bexpr(a, b.lhs, big)
            .gstr_append(a, ", ")
            .js_bexpr(a, b.rhs, big)
            .gstr_append(a, ")")
    })
    (b.op == "%").then({
        return s
            .gstr_append(a, "__zr.mod(")
            .js_bexpr(a, b.lhs, big)
            .gstr_append(a, ", ")
            .js_bexpr(a, b.rhs, big)
            .gstr_append(a, ")")
    })
    s
        .gstr_append(a, "(")
        .js_bexpr(a, b.lhs, big)
        .gstr_append(a, " ")
        .gstr_append(a, js_bin_op(b, big))
        .gstr_append(a, " ")
        .js_bexpr(a, b.rhs, big)
        .gstr_append(a, ")")
}
// the width to truncate a bin RESULT to: only the arithmetic ops overflow a JS number (bitwise ops
// self-coerce); `iw_bin` gives 0 for a comparison or unknown-width operand → no wrap.
js_trunc_w = (b: BinData) i32 { js_leak_op(b.op).then({ iw_bin(b) }, { 0 }) }
js_leak_op = (op: StringView) bool { op == "+" || op == "-" || op == "*" || op == "/" || op == "%" }
// one operand of a binary op. In a 64-bit op, force BigInt: an integer literal renders as a BigInt literal
// `Nn`; everything else is normalized by `__zr.big` (number -> BigInt; a BigInt passes through). Wrapping
// unconditionally is what makes it robust — a boundary norms a small 64-bit value back to a `number`, so
// even a detected i64 var must be re-promoted here. Non-64-bit ops emit the bare expression (unchanged).
js_bexpr = (s: String, a: MutPtr<Malloc>, e: Ptr<Expr>, big: bool) String {
    big.match ({
        true  => load(e).match ({
            .Int(n)  => s.jint(a, n).gstr_append(a, "n"),
            .Byte(n) => s.jint(a, n).gstr_append(a, "n"),
            _        => s.gstr_append(a, "__zr.big(").js_expr(a, e).gstr_append(a, ")"),
        }),
        false => s.js_expr(a, e),
    })
}
// the emitted operator: a 64-bit op keeps its BigInt spelling (`>>` on a BigInt is width-exact — logical
// for a non-negative u64, arithmetic for i64); a ≤32-bit UNSIGNED `>>` becomes logical `>>>`; else as-is.
js_bin_op = (b: BinData, big: bool) StringView {
    big.then({
        return js_op(b.op)
    })
    (b.op == ">>" && is_uns_narrow(iw_of(load(b.lhs)))).then({
        return ">>>"
    })
    js_op(b.op)
}
js_op = (op: StringView) StringView {
    (op == "==").match ({
        true  => "===",
        false => (op == "!=").then({ "!==" }, { op }),
    })
}
// an integer literal: values outside +/- 2^53 can NOT be an exact JS `number`, so render them as a BigInt
// literal `Nn` (they only ever occur in an i64/u64 context, whose boundary keeps them BigInt).
js_int_lit = (s: String, a: MutPtr<Malloc>, n: i64) String {
    (n > 9007199254740992 || n < 0 - 9007199254740992).then({
        return s.jint(a, n).gstr_append(a, "n")
    })
    s.jint(a, n)
}
// ── static width reconstruction (the type C carries on each value, rebuilt for the erased JS one) ────
// The js value model keeps i32-and-narrower as a JS `number`, i64/u64 as a (norm) BigInt. An operator
// needs its operands' static width to pick the BigInt vs number path; widths come from the per-function
// typed-var table (vars), the cast intrinsics, and structurally through bin/cond. A struct field or slice
// element is width 0 (unknown) — a rare inline i64-field-mixed-with-i32 is a documented gap (bind it to a
// typed local first); it is still recovered whenever the sibling operand is a detected 64-bit value.
iw_of = (e: Expr) i32 {
    e.match ({
        .Var(v)  => int_width(vw_lookup(v.name)),
        .Bin(b)  => iw_bin(b),
        .Cond(d) => iw_join(iw_of(load(d.t)), iw_of(load(d.e))),
        .Call(c) => iw_call(c),
        _        => 0,
    })
}
// the cast intrinsics are the only width-changing calls the js backend cares about; a user call's width
// is unknown here (0) — an unbound i64 call result mixed inline with a literal is the documented gap.
iw_call = (c: CallData) i32 {
    (c.fn == "to_i64" || c.fn == "load_i64").then({
        return 8
    })
    (c.fn == "to_i32").then({
        return 4
    })
    (c.fn == "to_u8").then({
        return 1
    })
    0
}
// a bin's result width: a comparison/logical op is a bool (0); a shift keeps the LHS width; else the wider.
iw_bin = (b: BinData) i32 {
    js_is_cmp(b.op).then({
        return 0
    })
    (b.op == "<<" || b.op == ">>").then({
        return iw_of(load(b.lhs))
    })
    iw_join(iw_of(load(b.lhs)), iw_of(load(b.rhs)))
}
iw_join = (l: i32, r: i32) i32 {
    (is_w64(l) || is_w64(r)).then({
        return is_w64(l).then({ l }, { r })
    })
    (l >= r).then({ l }, { r })
}
is_w64 = (w: i32) bool { w == 7 || w == 8 }
is_uns_narrow = (w: i32) bool { w == 1 || w == 2 || w == 3 }
js_is_cmp = (op: StringView) bool {
    op == "=="
        || op == "!="
        || op == "<"
        || op == ">"
        || op == "<="
        || op == ">="
        || op == "&&"
        || op == "||"
}
// ── static TYPE reconstruction (the AGGREGATE analog of iw_of above) ──────────────────────────────
// A struct is a VALUE in Zen and a REFERENCE in JS, so every sink C copies at has to copy here too
// (compiler.backend.js.js_copy says what a copy IS). Which sinks copy is a question about the STATIC type, and
// the js AST has erased it — so rebuild exactly what the decision needs: the typed-var table, the
// declared field/payload types, and the element type indexing already carries. Anything unresolved
// answers Void, which copies nothing and leaves the pre-existing lowering byte-identical.
js_ty_of = (e: Expr) Ty {
    e.match ({
        .Var(v)        => vw_lookup(v.name),
        .Member(m)     => js_member_ty(m.field, load(m.obj)),
        .Arrow(ar)     => js_member_ty(ar.field, load(ar.obj)),
        .Index(ix)     => ix.elem,
        .Call(c)       => js_call_ty(c),
        .MakeStruct(m) => tnamed(m.mty),
        .MakeEnum(m)   => tnamed(m.mty),
        .Tag(t)        => tnamed(t.mty),
        .Cond(d)       => js_ty_of(load(d.t)),
        .Block(b)      => js_block_ty(b),
        _              => tvoid(),
    })
}
// genc's union level `subj.u.Ok` has no js analog — `.u` IS the enum (js_member erases it), and the
// next field names the variant, so the payload lookup answers both.
js_member_ty = (field: StringView, obj: Expr) Ty {
    t = js_deref(js_ty_of(obj))
    (field == "u").then({ t }, { jsc_member_ty(t, field) })
}
js_deref = (t: Ty) Ty {
    t.match ({
        .Ptr(pd) => load(pd.pointee),
        _        => t,
    })
}
// `load(p)` is the deref; a DEFINED function answers its declared return type. Every other intrinsic
// answers Void — which is what keeps `p = s.addr()` the pointer ALIAS it has to be.
js_call_ty = (c: CallData) Ty {
    (c.fn == "load" && c.args.len > 0).then({
        return js_deref(js_ty_of(c.args[0]))
    })
    js_func_ret(c.fn)
}
js_block_ty = (b: BlockData) Ty {
    r ::= tvoid()
    b.stmts.loop_at((i, st) { r = (i == b.stmts.len - 1).then({ js_stmt_ty(st) }, { r }) })
    r
}
js_stmt_ty = (st: Stmt) Ty {
    st.match ({
        .ExprStmt(e) => js_ty_of(load(e)),
        .Return(e)   => js_ty_of(load(e)),
        _            => tvoid(),
    })
}
// the type of a value only where it is a copyable AGGREGATE; Void otherwise. Scalar inference stays
// out of the typed-var table on purpose — int_width reads that table, and widening its answers would
// change every emitted coercion rather than only the copies.
js_agg_ty = (e: Expr) Ty {
    t = js_ty_of(e)
    js_cp_needed(t).then({ t }, { tvoid() })
}
// ── the value SINKS ───────────────────────────────────────────────────────────────────────────────
// an expression bound at a sink: width-coerced as before, then COPIED when the sink's type is a value
// aggregate. A freshly built value is elided — a literal has no other referent, and a call to a
// defined function returns a value its own `return` already copied.
js_sink = (s: String, a: MutPtr<Malloc>, e: Ptr<Expr>, t: Ty, w: i32) String {
    js_cp_at(load(e), t).match ({
        true  => s.js_cp_open(a, t).js_expr_w(a, e, w).js_cp_close(a, t),
        false => s.js_expr_w(a, e, w),
    })
}
js_cp_at = (e: Expr, t: Ty) bool { js_expr_fresh(e).then({ false }, { js_cp_needed(t) }) }
js_expr_fresh = (e: Expr) bool {
    e.match ({
        .MakeStruct(m) => true,
        .MakeEnum(m)   => true,
        .Tag(t)        => true,
        .SliceLit(sd)  => true,
        .Call(c)       => js_is_defined_fn(c.fn),
        _              => false,
    })
}
// a struct literal's field takes a COPY of its initializer, exactly as C's `(S){ .f = v }` does.
js_mkstruct = (s: String, a: MutPtr<Malloc>, m: MakeStructData) String {
    out ::= s.gstr_append(a, "({ ")
    m.inits.loop_at((i, fi) {
        out = (i == 0).then({ out }, { out.gstr_append(a, ", ") })
        out = out
            .gstr_append(a, fi.name)
            .gstr_append(a, ": ")
            .js_sink(a, fi.value, js_init_ty(m.mty, fi.name), 0)
    })
    out.gstr_append(a, " })")
}
// …and so does an enum PAYLOAD (C writes it into the union).
js_mkenum = (s: String, a: MutPtr<Malloc>, m: MakeEnumData) String {
    s
        .gstr_append(a, "({ tag: \"")
        .gstr_append(a, m.variant)
        .gstr_append(a, "\", ")
        .gstr_append(a, m.variant)
        .gstr_append(a, ": ")
        .js_sink(a, m.payload, js_variant_ty(m.mty, m.variant), 0)
        .gstr_append(a, " })")
}
// a call's comma-separated args (each Expr value -> a Ptr<Expr> child).
js_args* = (s: String, a: MutPtr<Malloc>, args: [Expr]) String {
    out ::= s
    args.loop_at((i, arg) {
        out = (i == 0).then({ out }, { out.gstr_append(a, ", ") })
        out = out.js_expr(a, arg.addr())
    })
    out
}
// a slice literal's items: C copies each ELEMENT into the array, so a struct item copies here too.
js_cp_items = (s: String, a: MutPtr<Malloc>, items: [Expr], elem: Ty) String {
    out ::= s
    items.loop_at((i, arg) {
        out = (i == 0).then({ out }, { out.gstr_append(a, ", ") })
        out = out.js_sink(a, arg.addr(), elem, 0)
    })
    out
}
js_arg_at* = (s: String, a: MutPtr<Malloc>, c: CallData, i: i32) String {
    (i < c.args.len).then({ s.js_expr(a, c.args[i].addr()) }, { s.gstr_append(a, "0") })
}
// intrinsics erase to floor calls; everything else is an ordinary JS call `name(args)` — one flat
// early-return table (was two nested tiers, split only because the old pyramid nested too deep).
js_call = (s: String, a: MutPtr<Malloc>, c: CallData) String {
    (c.fn == "__str_eq").then({
        return s
            .gstr_append(a, "__zr.eq(")
            .js_arg_at(a, c, 0)
            .gstr_append(a, ", ")
            .js_arg_at(a, c, 1)
            .gstr_append(a, ")")
    })
    (c.fn == "__str_ne").then({
        return s
            .gstr_append(a, "(!__zr.eq(")
            .js_arg_at(a, c, 0)
            .gstr_append(a, ", ")
            .js_arg_at(a, c, 1)
            .gstr_append(a, "))")
    })
    (c.fn == "load").then({
        return s.gstr_append(a, "__zr.load(").js_arg_at(a, c, 0).gstr_append(a, ")")
    })
    (c.fn == "store").then({
        return s
            .gstr_append(a, "__zr.store(")
            .js_arg_at(a, c, 0)
            .gstr_append(a, ", ")
            .js_arg_at(a, c, 1)
            .gstr_append(a, ")")
    })
    (c.fn == "offset").then({
        return s
            .gstr_append(a, "__zr.offset(")
            .js_arg_at(a, c, 0)
            .gstr_append(a, ", ")
            .js_arg_at(a, c, 1)
            .gstr_append(a, ")")
    })
    (c.fn == "slice").then({
        return s
            .gstr_append(a, "__zr.slice(")
            .js_arg_at(a, c, 0)
            .gstr_append(a, ", ")
            .js_arg_at(a, c, 1)
            .gstr_append(a, ")")
    })
    (c.fn == "cstr").then({
        return s.gstr_append(a, "(").js_arg_at(a, c, 0).gstr_append(a, ")")
    })
    (c.fn == "null_ptr").then({
        return s.gstr_append(a, "0")
    })
    (c.fn == "addr").then({
        return s.js_addr(a, c)
    })
    (c.fn == "assert_nonnull").then({
        return s.gstr_append(a, "__zr.nn(").js_arg_at(a, c, 0).gstr_append(a, ")")
    })
    (c.fn == "to_i32").then({
        return s.gstr_append(a, "__zr.i32(").js_arg_at(a, c, 0).gstr_append(a, ")")
    })
    (c.fn == "to_i64").then({
        return s.gstr_append(a, "__zr.i64(").js_arg_at(a, c, 0).gstr_append(a, ")")
    })
    (c.fn == "to_u8").then({
        return s.gstr_append(a, "__zr.u8(").js_arg_at(a, c, 0).gstr_append(a, ")")
    })
    (c.fn == "to_f64").then({
        return s.gstr_append(a, "Number(").js_arg_at(a, c, 0).gstr_append(a, ")")
    })
    (c.fn == "load_i64").then({
        return s.gstr_append(a, "__zr.load_i64(").js_arg_at(a, c, 0).gstr_append(a, ")")
    })
    (c.fn == "store_i64").then({
        return s
            .gstr_append(a, "__zr.store_i64(")
            .js_arg_at(a, c, 0)
            .gstr_append(a, ", ")
            .js_arg_at(a, c, 1)
            .gstr_append(a, ")")
    })
    (c.fn == "sizeof").then({
        return s.js_sizeof(a, c)
    })
    // seq-cst atomics over an i64 cell. Emitted JS has ONE thread (run-to-completion), so the floor
    // discharges the seq-cst contract exactly with plain cell ops — see the atomic_* block in
    // bootstrap/zenrt.js for why that is an implementation, not a stub.
    (c.fn == "atomic_load_i64").then({
        return s.gstr_append(a, "__zr.atomic_load(").js_arg_at(a, c, 0).gstr_append(a, ")")
    })
    (c.fn == "atomic_store_i64").then({
        return s
            .gstr_append(a, "__zr.atomic_store(")
            .js_arg_at(a, c, 0)
            .gstr_append(a, ", ")
            .js_arg_at(a, c, 1)
            .gstr_append(a, ")")
    })
    (c.fn == "atomic_add_i64").then({
        return s
            .gstr_append(a, "__zr.atomic_add(")
            .js_arg_at(a, c, 0)
            .gstr_append(a, ", ")
            .js_arg_at(a, c, 1)
            .gstr_append(a, ")")
    })
    (c.fn == "atomic_cas_i64").then({
        return s
            .gstr_append(a, "__zr.atomic_cas(")
            .js_arg_at(a, c, 0)
            .gstr_append(a, ", ")
            .js_arg_at(a, c, 1)
            .gstr_append(a, ", ")
            .js_arg_at(a, c, 2)
            .gstr_append(a, ")")
    })
    (c.fn == "atomic_fence").then({
        return s.gstr_append(a, "__zr.atomic_fence()")
    })
    c.fn.js_unlowered_intrinsic().then({
        js_unsupported_note(c.fn, c.pos)
    })
    s.js_dom_dispatch(a, c)
}
// ── C/JS intrinsic PARITY GATE ────────────────────────────────────────────────────────────────────
// Everything above this point is a compiler intrinsic the js backend LOWERS. Anything reaching the
// fall-through is emitted as a verbatim `name(args)` call, so an intrinsic that gets here names a
// function no JS floor defines: `node prog.js` dies with `ReferenceError: <name> is not defined`,
// after `zen build --target js` exited 0. That silent-wrong-output shape is what this gate closes —
// the escape becomes `error[js-target]` at build time, positioned on the call.
//
// `malloc` and the reflection trio are intrinsics NEITHER backend lowers, so they are not escapes:
//   • malloc is a runtime LEAF — genc's call_kind has no case for it either; both backends emit the
//     raw call and both floors define it (libc / zenrt.js).
//   • field_eq / each_field / zip_fields are expanded during INLINING (compiler.passes.subst), so
//     they never reach any backend; one that DID reach here would be equally broken in C, and the
//     gate correctly rejects it.
// The remaining membership is exactly genc call_kind's, so this predicate states the invariant
// "the js backend lowers every intrinsic the C backend lowers" — checked on every emitted call
// rather than by two hand-synced lists. is_intrinsic keeps its first-byte guard; this adds nothing
// to the C path and only runs on names that already failed every js lowering above.
js_unlowered_intrinsic = (fn: StringView) bool {
    fn.is_intrinsic()
        && fn != "malloc"
        && fn != "field_eq"
        && fn != "each_field"
        && fn != "zip_fields"
}
// STICKY first-escape record: genJsModule returns a String with no diagnostic channel, so the
// emitter parks the offending name + call position here and the driver reports it (drvdiag
// report_js_unsupported) BEFORE writing any .js. First escape wins — one root diagnostic, not one
// per call site of the same unlowered intrinsic.
js_no_unsupported = () StringView { "" }
js_unsupported_name ::= js_no_unsupported()
js_unsupported_pos ::= 0
js_unsupported_note = (fn: StringView, pos: i32) void {
    is_empty(js_unsupported_name).then({
        js_unsupported_name = fn
        js_unsupported_pos = pos
    })
}
js_unsupported_get* = () StringView { js_unsupported_name }
js_unsupported_pos_get* = () i32 { js_unsupported_pos }
js_unsupported_reset* = () void {
    js_unsupported_name = js_no_unsupported()
    js_unsupported_pos = 0
}
// `addr(x)` on a BOXED scalar local is the variable itself — it already holds the cell's MEM offset.
// Every other shape keeps the identity lowering (`__zr.addr`), which is exactly right for a struct.
js_addr = (s: String, a: MutPtr<Malloc>, c: CallData) String {
    (c.args.len == 0).then({
        return s.gstr_append(a, "__zr.addr(0)")
    })
    c.args[0].addr().match ({
        .Var(v) => (js_boxed_w(v.name) == 0).match ({
            true  => s.gstr_append(a, "__zr.addr(").jname(a, v.name).gstr_append(a, ")"),
            false => s.jname(a, v.name),
        }),
        _       => s.gstr_append(a, "__zr.addr(").js_arg_at(a, c, 0).gstr_append(a, ")"),
    })
}
// `sizeof(T)` is resolved to a LITERAL byte count at emit time (compiler.backend.js.js_size), because the
// js floor's memory is the same byte-addressed space C's is and there is no JS `sizeof` to defer to.
// The floor stub this replaced answered 8 for every type, silently corrupting every `n * sizeof(T)`
// stride and allocation. A type the layout walk cannot resolve REFUSES the build (error[js-target])
// rather than guessing — a plausible-but-wrong size is the defect this fix exists to remove.
js_sizeof = (s: String, a: MutPtr<Malloc>, c: CallData) String {
    (c.args.len > 0).match ({
        true  => c.args[0].addr().match ({
            .Var(v) => s.js_size_lit(a, v.name, c.pos),
            _       => s.js_size_refuse(a, c.pos),
        }),
        false => s.js_size_refuse(a, c.pos),
    })
}
js_size_lit = (s: String, a: MutPtr<Malloc>, name: StringView, pos: i32) String {
    n = js_size_of_name(name)
    (n < 0).then({ s.js_size_refuse(a, pos) }, { s.jint(a, n) })
}
js_size_refuse = (s: String, a: MutPtr<Malloc>, pos: i32) String {
    js_unsupported_note("sizeof", pos)
    s.gstr_append(a, "__zen_js_unsized_type")
}
// ── match: value position -> an IIFE returning an arm value; statement position -> a real `switch` (so
//    an arm's early `return` leaves the enclosing function, not just the IIFE). Enum tag is the variant
//    NAME string; a payload binds `_subj.<Variant>`. An explicit `_` arm is `default`; without one the
//    checker proved coverage, so every arm is its own `case` and `default` traps (mirrors genc). ───────
// The BIND is a value sink: C's `T v = _subj.u.V;` copies the payload out of the union, so a struct
// payload is copied here and the arm body cannot write through to the matched value.
js_arm_bind = (s: String, a: MutPtr<Malloc>, ar: ArmData, ename: StringView) String {
    pty = js_variant_ty(ename, ar.variant)
    vw_note(ar.bind, js_agg_ty_or(pty))
    s
        .gstr_append(a, "const ")
        .jname(a, ar.bind)
        .gstr_append(a, " = ")
        .js_cp_open(a, pty)
        .gstr_append(a, "_subj.")
        .gstr_append(a, ar.variant)
        .js_cp_close(a, pty)
        .gstr_append(a, "; ")
}
// the bind's type enters the typed-var table only when it is an aggregate — same rule as a let's.
js_agg_ty_or = (t: Ty) Ty { js_cp_needed(t).then({ t }, { tvoid() }) }
js_arm_body_expr = (s: String, a: MutPtr<Malloc>, ar: ArmData, ename: StringView) String {
    is_empty(ar.bind).match ({
        true  => s.js_expr(a, ar.body),
        false => s
            .gstr_append(a, "(() => { ")
            .js_arm_bind(a, ar, ename)
            .gstr_append(a, "return ")
            .js_expr(a, ar.body)
            .gstr_append(a, "; })()"),
    })
}
js_switch_panic_default = (s: String, a: MutPtr<Malloc>) String {
    s.gstr_append(a, "default: __zr.panic(\"zen: panic: non-exhaustive match — checker/emitter disagreement\\n\"); ")
}
js_switch_case = (s: String, a: MutPtr<Malloc>, ar: ArmData, last: bool, ename: StringView) String {
    (ar.variant == "_").match ({
        true  => s
            .gstr_append(a, "default: return ")
            .js_arm_body_expr(a, ar, ename)
            .gstr_append(a, "; "),
        false => {
            out = s
                .gstr_append(a, "case \"")
                .gstr_append(a, ar.variant)
                .gstr_append(a, "\": return ")
                .js_arm_body_expr(a, ar, ename)
                .gstr_append(a, "; ")
            last.then({ out.js_switch_panic_default(a) }, { out })
        },
    })
}
js_switch_cases = (
    s: String,
    a: MutPtr<Malloc>,
    arms: [ArmData],
    i: i64,
    ename: StringView,
) String {
    (i >= arms.len).match ({
        true  => s,
        false => {
            out = s.js_switch_case(a, arms[i], i == arms.len - 1, ename)
            (arms[i].variant == "_").then({ out }, { out.js_switch_cases(a, arms, i + 1, ename) })
        },
    })
}
js_match_expr = (s: String, a: MutPtr<Malloc>, m: MatchData) String {
    s
        .gstr_append(a, "(() => { const _subj = ")
        .js_expr(a, m.subj)
        .gstr_append(a, "; switch (_subj.tag) { ")
        .js_switch_cases(a, m.arms, 0, m.ename)
        .gstr_append(a, "} })()")
}
// statement-position match: arms run as statements so a diverging arm's `return` propagates.
js_arm_stmt = (s: String, a: MutPtr<Malloc>, ar: ArmData, ename: StringView) String {
    is_empty(ar.bind).match ({
        true  => s.js_arm_stmt_body(a, ar.body),
        false => s
            .gstr_append(a, "{ ")
            .js_arm_bind(a, ar, ename)
            .js_arm_stmt_body(a, ar.body)
            .gstr_append(a, " }"),
    })
}
// a braced value-position body is a Block: splice its statements; otherwise it's a bare expr statement.
js_arm_stmt_body = (s: String, a: MutPtr<Malloc>, body: Ptr<Expr>) String {
    load(body).match ({
        .Block(b) => s.js_block_stmts(a, b),
        _         => s.js_expr_stmt(a, body),
    })
}
js_switch_stmt_case = (
    s: String,
    a: MutPtr<Malloc>,
    ar: ArmData,
    last: bool,
    ename: StringView,
) String {
    (ar.variant == "_").match ({
        true  => s.gstr_append(a, "default: ").js_arm_stmt(a, ar, ename).gstr_append(a, " break; "),
        false => {
            out = s
                .gstr_append(a, "case \"")
                .gstr_append(a, ar.variant)
                .gstr_append(a, "\": ")
                .js_arm_stmt(a, ar, ename)
                .gstr_append(a, " break; ")
            last.then({ out.js_switch_panic_default(a) }, { out })
        },
    })
}
js_switch_stmt_cases = (
    s: String,
    a: MutPtr<Malloc>,
    arms: [ArmData],
    i: i64,
    ename: StringView,
) String {
    (i >= arms.len).match ({
        true  => s,
        false => {
            out = s.js_switch_stmt_case(a, arms[i], i == arms.len - 1, ename)
            (arms[i].variant == "_").match ({
                true  => out,
                false => out.js_switch_stmt_cases(a, arms, i + 1, ename),
            })
        },
    })
}
js_match_stmt = (s: String, a: MutPtr<Malloc>, m: MatchData) String {
    s
        .gstr_append(a, "{ const _subj = ")
        .js_expr(a, m.subj)
        .gstr_append(a, "; switch (_subj.tag) { ")
        .js_switch_stmt_cases(a, m.arms, 0, m.ename)
        .gstr_append(a, "} }")
}
// A foreach loop is still an expression-valued IIFE. Handler-specific identity tokens make control
// expression-safe and let it cross nested match/loop IIFEs; the iteration catch consumes only THIS
// loop's continue/break and rethrows every outer-loop token or ordinary exception unchanged.
js_loop = (s: String, a: MutPtr<Malloc>, l: LoopData) String {
    out ::= s
        .gstr_append(a, "(() => { const _seq = ")
        .js_expr(a, l.seq)
        .gstr_append(a, "; const ")
        .jname(a, l.h)
        .gstr_append(a, "__b = {}; const ")
        .jname(a, l.h)
        .gstr_append(a, "__c = {}; for (let ")
        .jname(a, l.idx)
        .gstr_append(a, " = 0; ")
        .jname(a, l.idx)
        .gstr_append(a, " < _seq.len; ")
        .jname(a, l.idx)
        .gstr_append(a, "++) { const ")
        .jname(a, l.elem)
        .gstr_append(a, " = __zr.idx(_seq, ")
        .jname(a, l.idx)
        .gstr_append(a, ", ")
        .jint(a, js_elem_w(l.elemTy))
        .gstr_append(a, "); try { ")
    out = out.js_stmts(a, l.body)
    out = out
        .gstr_append(a, " } catch (__zen_loop_ctl) { if (__zen_loop_ctl === ")
        .jname(a, l.h)
        .gstr_append(a, "__c) { continue; } if (__zen_loop_ctl === ")
        .jname(a, l.h)
        .gstr_append(a, "__b) { break; } throw __zen_loop_ctl; } }")
    out.gstr_append(a, " return 0; })()")
}
js_block_expr = (s: String, a: MutPtr<Malloc>, b: BlockData) String {
    out ::= s.gstr_append(a, "(() => { ")
    b.stmts.loop_at((i, st) {
        one = (i == b.stmts.len - 1).then({ out.js_block_last(a, st) }, { out.js_stmt(a, st) })
        out = one.gstr_append(a, " ")
    })
    out.gstr_append(a, "})()")
}
// the LAST statement of a block-expr yields the block's value: a bare expr becomes `return expr;`.
js_block_last = (s: String, a: MutPtr<Malloc>, st: Stmt) String {
    st.match ({
        .ExprStmt(e) => s.gstr_append(a, "return ").js_expr(a, e).gstr_append(a, ";"),
        _            => s.js_stmt(a, st),
    })
}
js_block_stmts = (s: String, a: MutPtr<Malloc>, b: BlockData) String {
    out ::= s
    b.stmts.loop_at((i, st) { out = out.js_stmt(a, st).gstr_append(a, " ") })
    out
}
// ── statements ────────────────────────────────────────────────────────────────────────────────────
// a `let`: record the binding's declared width in the per-function table, then emit the initializer
// coerced to that width (`x :: u32 = a*b` → `let x = ((a*b) >>> 0);`; an unannotated let is width 0 → bare).
// An address-taken scalar binds its CELL instead of its value: `__zr.box(init, w)` allocates the cell,
// writes the initializer into it, and yields the MEM offset the variable then carries.
js_let = (s: String, a: MutPtr<Malloc>, l: LetData) String {
    lty = js_let_ty(l)
    vw_note(l.name, lty)
    bw = js_boxed_w(l.name)
    open = s.gstr_append(a, "let ").jname(a, l.name).gstr_append(a, " = ")
    boxed = (bw == 0).match ({
        true  => open.js_sink(a, l.value, lty, int_width(l.ty)),
        false => open
            .gstr_append(a, "__zr.box(")
            .js_expr_w(a, l.value, int_width(l.ty))
            .gstr_append(a, ", ")
            .jint(a, bw)
            .gstr_append(a, ")"),
    })
    boxed.gstr_append(a, ";")
}
// the binding's type: its annotation, or — unannotated (`b = a`, where C writes `__auto_type`) — the
// initializer's reconstructed aggregate type. That is the case the struct-aliasing bug lived in.
js_let_ty = (l: LetData) Ty {
    l.ty.match ({
        .Void => js_agg_ty(load(l.value)),
        _     => l.ty,
    })
}
// an assign: coerce the value to the TARGET variable's declared width (looked up in the per-function
// table) so a mutating narrow accumulator wraps like C. A non-Var target (field/index) is width 0.
// An assignment to a BOXED local writes through its cell (`__zr.st`), never rebinding the offset.
js_assign = (s: String, a: MutPtr<Malloc>, x: AssignData) String {
    load(x.target).match ({
        .Index(ix) => {
            return s.js_setidx(a, ix.seq, ix.idx, x.value, ix.elem)
        },
        _          => { },
    })
    bw = js_assign_boxed_w(load(x.target))
    (bw == 0).then({
        return s
            .js_expr(a, x.target)
            .gstr_append(a, " = ")
            .js_sink(a, x.value, js_ty_of(load(x.target)), js_assign_width(load(x.target)))
            .gstr_append(a, ";")
    })
    s
        .gstr_append(a, "__zr.st(")
        .js_assign_target_name(a, load(x.target))
        .gstr_append(a, ", ")
        .js_expr_w(a, x.value, js_assign_width(load(x.target)))
        .gstr_append(a, ", ")
        .jint(a, bw)
        .gstr_append(a, ");")
}
js_assign_boxed_w = (e: Expr) i32 {
    e.match ({
        .Var(v) => js_boxed_w(v.name),
        _       => 0,
    })
}
js_assign_target_name = (s: String, a: MutPtr<Malloc>, e: Expr) String {
    e.match ({
        .Var(v) => s.jname(a, v.name),
        _       => s.gstr_append(a, "__zen_invalid_boxed_target"),
    })
}
js_assign_width = (e: Expr) i32 {
    e.match ({
        .Var(v) => int_width(vw_lookup(v.name)),
        _       => 0,
    })
}
js_stmt = (s: String, a: MutPtr<Malloc>, st: Stmt) String {
    st.match ({
        .Let(l)      => s.js_let(a, l),
        .Assign(x)   => s.js_assign(a, x),
        .Return(e)   => s
            .gstr_append(a, "return ")
            .js_sink(a, e, js_agg_ty(load(e)), ret_coerce_w())
            .gstr_append(a, ";"),
        .ExprStmt(e) => s.js_expr_stmt(a, e),
        .If(f)       => s
            .gstr_append(a, "if (")
            .js_expr(a, f.c)
            .gstr_append(a, ") { ")
            .js_stmts(a, f.then)
            .gstr_append(a, "} else { ")
            .js_stmts(a, f.els)
            .gstr_append(a, "}"),
        .While(w)    => s
            .gstr_append(a, "while (")
            .js_expr(a, w.c)
            .gstr_append(a, ") { ")
            .js_stmts(a, w.body)
            .gstr_append(a, "}"),
        .IndexSet(x) => s.js_setidx(a, x.seq, x.idx, x.value, x.elem),
    })
}
// an element store. C's `*(T*)zen__idx(z, i, sizeof(T)) = v` is an LVALUE, so the same store reaches
// the js backend two ways: as an IndexSet statement, and — when the sequence is itself a field, like
// `h.s[0] = v` — as an ordinary Assign whose TARGET is an Index. The second used to emit
// `__zr.idx(…) = v`, which is not a JS assignment target at all: `node` died with a SyntaxError on a
// program `zen build --target js` had just accepted. Both route through the floor's setidx, and the
// stored value takes the element type's copy.
js_setidx = (
    s: String,
    a: MutPtr<Malloc>,
    seq: Ptr<Expr>,
    idx: Ptr<Expr>,
    value: Ptr<Expr>,
    elem: Ty,
) String {
    s
        .gstr_append(a, "__zr.setidx(")
        .js_expr(a, seq)
        .gstr_append(a, ", ")
        .js_expr(a, idx)
        .gstr_append(a, ", ")
        .js_sink(a, value, elem, 0)
        .gstr_append(a, ", ")
        .jint(a, js_elem_w(elem))
        .gstr_append(a, ");")
}
// a bare expression statement; a match here becomes a real `switch` (so arm returns fire).
js_expr_stmt = (s: String, a: MutPtr<Malloc>, e: Ptr<Expr>) String {
    load(e).match ({
        .Match(m) => s.js_match_stmt(a, m),
        .Cond(d)  => s.js_cond_stmt(a, d),
        .Block(b) => s.gstr_append(a, "{ ").js_stmts(a, b.stmts).gstr_append(a, "}"),
        _         => s.js_expr(a, e).gstr_append(a, ";"),
    })
}
js_cond_stmt = (s: String, a: MutPtr<Malloc>, d: CondData) String {
    s
        .gstr_append(a, "if (")
        .js_expr(a, d.c)
        .gstr_append(a, ") { ")
        .js_expr_stmt(a, d.t)
        .gstr_append(a, " } else { ")
        .js_expr_stmt(a, d.e)
        .gstr_append(a, " }")
}
js_stmts* = (s: String, a: MutPtr<Malloc>, body: [Stmt]) String {
    out ::= s
    body.loop_at((i, st) { out = out.js_stmt(a, st).gstr_append(a, " ") })
    out
}
// ── FIXED-WIDTH INTEGER WRAPPING (census #64) ──────────────────────────────────────────────────────
// A JS `number` never wraps, so ordinary integer arithmetic on a fixed-width Zen type disagrees with C
// (which truncates at the type's width via -fwrapv): `100000*100000` is 10000000000 in JS but 1410065408
// in a C `uint32_t`, an FNV-1a hash returns garbage, etc. We reproduce C's truncation-at-the-boundary by
// COERCING a value to its declared width at the three points C's type system does it: a function PARAMETER
// (entry), a typed LET's initializer, and an ASSIGN to a typed variable. `int_width` maps a Ty to a width
// code (0 = not a fixed-width int → no coercion); the open/close pair wraps an emitted expression with
// the matching JS idiom:
//   u8 `& 255`   u16 `& 0xffff`   u32 `>>> 0`   i32 `| 0`   i16 `<<16>>16`   i8 `<<24>>24`
//   i64 `__zr.wi64`   u64 `__zr.wu64`   (the 64-bit pair asIntN/asUintN-wrap a BigInt, then norm to a
// number when it fits exactly). `<<n>>n` sign-extends the low n bits; `>>>0` reinterprets unsigned; `|0`
// wraps to signed i32.
int_width* = (t: Ty) i32 {
    t.match ({
        .U8       => 1,
        .I32      => 4,
        .I64      => 8,
        .Named(n) => iw_named(n),
        _         => 0,
    })
}
iw_named = (n: StringView) i32 {
    (n == "u16").then({
        return 2
    })
    (n == "u32").then({
        return 3
    })
    (n == "u64").then({
        return 7
    })
    (n == "i16").then({
        return 5
    })
    (n == "i8").then({
        return 6
    })
    0
}
js_w_open* = (s: String, a: MutPtr<Malloc>, w: i32) String {
    (w == 7).then({
        return s.gstr_append(a, "__zr.wu64((")
    })
    (w == 8).then({
        return s.gstr_append(a, "__zr.wi64((")
    })
    (w == 0).then({ s }, { s.gstr_append(a, "((") })
}
js_w_close* = (s: String, a: MutPtr<Malloc>, w: i32) String {
    (w == 1).then({
        return s.gstr_append(a, ") & 255)")
    })
    (w == 2).then({
        return s.gstr_append(a, ") & 0xffff)")
    })
    (w == 3).then({
        return s.gstr_append(a, ") >>> 0)")
    })
    (w == 4).then({
        return s.gstr_append(a, ") | 0)")
    })
    (w == 5).then({
        return s.gstr_append(a, ") << 16 >> 16)")
    })
    (w == 6).then({
        return s.gstr_append(a, ") << 24 >> 24)")
    })
    (w == 7 || w == 8).then({
        return s.gstr_append(a, "))")
    })
    s
}
// emit an expression coerced to width `w` (w == 0 emits the bare expression, byte-identical to before).
// SPECIAL CASE — a 32-bit multiply: `a * b` at u32/i32 must use `Math.imul`, NOT `(a*b) & mask`. A JS
// `number` is an f64, so a full-width 32×32 product (up to ~2^64) loses its low bits above 2^53 BEFORE
// any mask can truncate — an FNV-1a step `hash * 16777619` (hash ~2^32, prime ~2^24 → ~2^56) came out
// wrong. `Math.imul` is a true mod-2^32 multiply (both operands taken as int32, low 32 bits returned),
// so it reproduces C's wrapping exactly. Only the OUTERMOST operator is rewritten; a multiply nested
// under another operator whose own product exceeds 2^53 is a rarer edge (documented in bootstrap/zenrt.js
// design notes). Narrower widths (≤16-bit) need no imul: their product never exceeds 2^32 < 2^53.
js_expr_w = (s: String, a: MutPtr<Malloc>, e: Ptr<Expr>, w: i32) String {
    js_is_mul32(load(e), w).match ({
        true  => s.js_mul32(a, load(e), w),
        false => s.js_w_open(a, w).js_expr(a, e).js_w_close(a, w),
    })
}
js_is_mul32 = (e: Expr, w: i32) bool {
    (w == 3 || w == 4).match ({
        true  => e.match ({
            .Bin(b) => b.op == "*",
            _       => false,
        }),
        false => false,
    })
}
js_mul32 = (s: String, a: MutPtr<Malloc>, e: Expr, w: i32) String {
    e.match ({
        .Bin(b) => (w == 3).match ({
            true  => s
                .gstr_append(a, "((Math.imul(")
                .js_expr(a, b.lhs)
                .gstr_append(a, ", ")
                .js_expr(a, b.rhs)
                .gstr_append(a, ")) >>> 0)"),
            false => s
                .gstr_append(a, "Math.imul(")
                .js_expr(a, b.lhs)
                .gstr_append(a, ", ")
                .js_expr(a, b.rhs)
                .gstr_append(a, ")"),
        }),
        _       => s,
    })
}
// ── per-function typed-variable table (name → declared Ty) ─────────────────────────────────────────
// Populated as emission walks a function in lexical order: params at entry, then each typed LET. An
// ASSIGN to a bare variable looks its target up here to coerce the assigned value to the variable's
// width (the FNV-hash case: `hash = (hash ^ b) * 16777619` where `hash: u32` mutates in a loop). Mirrors
// parse.zen's exports_buf pattern; reset at every function entry (Zen has no nested fns — lambdas are
// inlined before js — so one flat table per function is exact).
vw_buf ::= vw_none()
vw_n ::= 0
vw_none = () [Param] { slice(null_ptr(), 0) }
vw_reset* = (a: MutPtr<Malloc>) void {
    vw_buf = slice(a.acquire_or_die(8192 * sizeof(Param)), 8192)
    vw_n = 0
}
vw_get = () [Param] { slice(vw_buf.ptr, vw_n) }
vw_note* = (name: StringView, ty: Ty) void {
    (vw_n < vw_buf.len).then({
        vw_buf[vw_n] = param(name, ty)
        vw_n = vw_n + 1
    })
}
// last matching entry wins (an inner-scope shadow declared later overrides an earlier sibling).
vw_lookup = (name: StringView) Ty {
    r ::= tvoid()
    vw_get().loop_at((i, p) { r = (p.name == name).then({ p.ty }, { r }) })
    r
}
// current function's return width — set at function entry (js_decl.js_func). A `return` COERCES its value
// to this width ONLY for the 64-bit types (an i64/u64 return must be a BigInt, else an inline `return a*b`
// would lose precision or mix); narrower returns are already truncated at the CALLER's binding boundary.
cur_ret_w ::= 0
set_ret_w* = (w: i32) void { cur_ret_w = w }
ret_coerce_w = () i32 { is_w64(cur_ret_w).then({ cur_ret_w }, { 0 }) }
