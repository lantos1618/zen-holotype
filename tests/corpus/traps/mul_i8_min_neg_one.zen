// tests/corpus/traps/mul_i8_min_neg_one.zen
// i8.MIN * -1 traps: the product is i8.MAX + 1, which does not
// exist. i8.MIN is the one value whose negation is unrepresentable

// main must name an error type. a trap never lifts into Res:
// it aborts the process
Error =
    Overflow,
    DivideByZero,
    OutOfBounds

main = (env: Env) Res<i32, Error> {
    x: i8 = i8.MIN;
    neg_one: i8 = -1;
    product = x * neg_one;
    println("{}", product);
    Ok(0);
}
