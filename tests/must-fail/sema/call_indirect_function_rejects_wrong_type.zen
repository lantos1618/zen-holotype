// An indirect call is checked against the function value's parameter types.
// Parentheses around the callee do not weaken that contract.
//
// position: the call whose argument has the wrong type.

use = (pick: (value: i32) i32) i32 { (pick)("wrong") }

main = (env: Env) Res<i32, AllocError> {
    println("{}", use((value: i32) i32 { value }));
    Ok(0);
}
