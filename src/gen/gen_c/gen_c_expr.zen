// src/gen/gen_c/gen_c_expr.zen
// What an expression is in C.
// Every lowering here has one shape: statements go to the backend's
// buffer, and the C EXPRESSION naming the result goes to the caller's
// buffer. `gen_c_stmt.zen` owns where that result ends up; `gen_c_flow.zen`
// owns the two forms that cannot be C expressions at all.
// A spilling form where C wants a value is put in a temporary — the one
// non-shape-for-shape thing this file does: `deliver` hands a spill
// straight to its destination (already a place), but an argument is
// not one, so `spill_temp` makes one. `spills` asks whether a node IS a
// spill (`deliver`'s question); `spills_anywhere` asks whether one hides
// inside it, which short-circuiting needs since a hoisted `.try()` runs
// regardless of the left side — `gen_c_op.zen` owns that rule.
// This file also answers WHICH ARGUMENTS RUN WHEN: Zen orders a call's
// arguments left to right and C does not, so `holds` names the positions
// that have to be put in a temporary to keep that promise, and
// `value_held` puts them there. The `argument order` block below is the
// whole rule.
// Operators are `gen_c_op.zen`'s subject.
// Sema is the only source of a type: where `type_of` answers, its
// answer is used; where it does not (call, match, record), the
// context's expected type is used; with neither, an `Untyped` fault is
// raised rather than a guess.

ExprId, Block, Span = std.ast
Decl, Consume = std.ast
Literal, Binary, Unary, Match = std.ast
Access, Call = std.ast
TypeId = std.ast
AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId = sema.sema_ty
Def, decl_at = sema.sema_def
Ctx = sema.sema_check
type_of = sema.sema_type
type_from_ast = sema.sema_denote
sym_local = gen.gen_name
CBackend = gen.gen_c.gen_c_state
LocalSlot = gen.gen_c.gen_c_frame
sub, constructed, unsettled = gen.gen_c.gen_c_mono
has_var = sema.sema_inst
loop_result_type = gen.gen_c.gen_c_shape
unsupported, closure_storage = gen.gen_c.gen_c_report
declarator, is_unit, has_storage = gen.gen_c.gen_c_type
lower_access = gen.gen_c.gen_c_read
access_field_type = gen.gen_c.gen_c_read
lower_array_lit, lower_fixed_array = gen.gen_c.gen_c_array
request_type = gen.gen_c.gen_c_type
Dest, deliver, destination_type = gen.gen_c.gen_c_stmt
lower_call, res_value, is_res_ctor = gen.gen_c.gen_c_call
call_callee = sema.sema_call
needs_hoist, hoist_expr = gen.gen_c.gen_c_hoist
needs_widen, widen_expr, needs_set, set_expr = gen.gen_c.gen_c_widen
is_print, body_end = gen.gen_c.gen_c_print
call_ret_type = gen.gen_c.gen_c_infer
lower_unary, lower_binary, binary_type = gen.gen_c.gen_c_op
lower_index, index_type = gen.gen_c.gen_c_index
is_ptr_member, ptr_member_type = gen.gen_c.gen_c_ptr
create_type = gen.gen_c.gen_c_alloc
field_of = gen.gen_c.gen_c_type
inline_result_type = gen.gen_c.gen_c_settle
needs_fat, write_fat_value = gen.gen_c.gen_c_fat
release_binding = gen.gen_c.gen_c_own
lower_scope_ref, is_scope_ref, scope_type = gen.gen_c.gen_c_scope
lower_global_value = gen.gen_c.gen_c_const

// expressions

// A spilling form may not appear where C wants a pure expression — the
// right operand of `&&`/`||` and an argument ask this first.
spills* = (be: CBackend, id: ExprId) bool {
    be.tree.expr_at(id).kind.match({
        Match(_) => true,
        Try(_)   => true,
        Block(_) => true,
        Paren(p) => be.spills(p.inner),
        _        => false,
    })
}

// Whether a spill hides ANYWHERE inside, which is the half of the
// header's distinction short-circuiting needs: a `.try()` three parens
// deep still lowers to an `if`/`return` that `expr` hoists out to where
// the operand was written.
// An unrecognised form answers YES: wrong in this direction is a
// refusal with a position, wrong the other way is a program computing
// the wrong thing — the one outcome a backend may not produce.
spills_anywhere* = (be: CBackend, id: ExprId) bool {
    be.tree.expr_at(id).kind.match({
        Literal(_) => false,
        Name(_)    => false,
        Unit       => false,
        Scope      => false,
        Consume(x) => be.spills_anywhere(x.operand),
        Paren(p)   => be.spills_anywhere(p.inner),
        Unary(u)   => be.spills_anywhere(u.operand),
        Binary(b)  => be.spills_anywhere(b.lhs) || be.spills_anywhere(b.rhs),
        Access(a)  => be.spills_anywhere(a.base),
        Index(x)   => be.spills_anywhere(x.base) || be.spills_anywhere(x.index),
        Call(c)    => be.call_spills(c),
        _          => true,
    })
}

// A call whose arguments will be HELD spills too, and this is where
// short-circuiting learns it: `gen_c_op.zen` refuses to lower a `&&`
// whose right operand spills as C's own `&&`, and a held argument is a
// statement written in front of the operand exactly as a hoisted
// `.try()` is. `may_reorder`, below, asks the same question the emitter
// will, one receiver more conservatively, and says why.
call_spills = (be: CBackend, c: Call) bool {
    got ::= be.may_reorder(c) || be.spills_anywhere(c.callee);
    c.args.loop((h, a) { got = got || be.spills_anywhere(a.value); });
    got
}

// argument order
// ZEN EVALUATES ARGUMENTS LEFT TO RIGHT. C LEAVES THE ORDER OF A CALL'S
// ARGUMENTS UNSPECIFIED, so every argument written straight into one C
// call expression hands the decision to the C compiler — and gcc takes
// it right to left. `three(d.tick(), d.tick(), d.tick())` answered 210.
// THE FIX IS A TEMPORARY, NOT A REWRITE. A HELD argument is written as a
// declaration and an assignment ahead of the call and appears in the call
// as its own name — the transform `spill_temp` already performs for a
// `.try()` in argument position, through the same door.
// IT IS NOT DONE EVERYWHERE. Spilling every argument of every call costs
// a sixth of the emitted C and `make build` pays for that twice. Three
// questions narrow it to the shapes where the difference can be seen:
//   - the call must have TWO OR MORE argument positions, a receiver
//     counting as one: with a single position there is nothing to
//     reorder against;
//   - some position must CONTAIN A CALL, because nothing else in an
//     argument runs — and a receiver is a position too, so the question
//     is asked of it as well;
//   - a position is held while a call is still to its RIGHT, and a
//     position that RUNS is held while anything at all is: an inline
//     call's effects and an inline read after it are C's to order, and
//     gcc ran `two(bump(d, 100), d.n)`'s read first — 1000 against the
//     left-to-right 1100. Only the rightmost POSITION may stay inline:
//     by the time it runs everything else already has, and nothing
//     follows it.
// On this tree that is a few hundred of 8,389 call sites.
// THE OPERANDS OF `+` AND OF EVERY OTHER INFIX OPERATOR were left out
// deliberately — denser population, cost to be measured first — and are
// now held under their own gate, `infix_operand_held` below: #737.

// Whether the position at signature index `pos` must be held. `first` is
// how many positions the receiver took, so an argument at argument-index
// `i` asks with `i + first`, and a receiver asks with `0` and `1`.
// The split is `gen_c_array.zen`'s `elem_held` asked of a call's
// positions: held while a call is still to the RIGHT (`pos` before the
// last calling position), and held when the position ITSELF runs while
// anything at all follows it — the half #717's fix missed, and the one
// `two(bump(d, 100), d.n)` shows: the rightmost CALLING argument stayed
// inline beside the read, and gcc took the read first. The rightmost
// POSITION alone may stay inline with a call inside: nothing follows it.
holds* = (be: CBackend, c: Call, pos: usize, first: usize) bool {
    be.reorderable(c, first) && (
        (pos < (be.last_call_arg(c) + first)) || (
            (pos < ((c.args.len + first) - 1)) && be.position_calls(
                c,
                pos,
                first
            )
        )
    )
}

// The arity question and the something-runs question together: the only
// shape where C's freedom over the order is observable. A receiver is a
// position too, so something running in IT — `make(d.tick()).show(d.n,
// d.n)` — answers the second question as surely as an argument does.
reorderable* = (be: CBackend, c: Call, first: usize) bool {
    ((c.args.len + first) > 1) && (
        be.any_arg_calls(c) || ((first > 0) && be.recv_calls(c))
    )
}

// `first` is not known until a call has been lowered, so the question a
// `&&` asks about its right operand is asked at the arity the CALLEE'S
// SPELLING implies: a call written through a `.` may put a receiver in
// front of its arguments. Wrong this way costs a lowering shape; wrong
// the other way is a `&&` that stopped short-circuiting.
may_reorder* = (be: CBackend, c: Call) bool {
    be.reorderable(c, be.recv_slots(c))
}

recv_slots = (be: CBackend, c: Call) usize {
    call_callee(be.tree, c).kind.match({ Access(_) => 1, _ => 0 })
}

// Whether something runs in the RECEIVER — the base a `.`-callee stands
// on. A callee that is not an `Access` has no receiver, which is the
// answer `recv_slots` already gives.
recv_calls = (be: CBackend, c: Call) bool {
    call_callee(be.tree, c).kind.match({
        Access(a) => be.has_call(a.base),
        _         => false,
    })
}

// Whether something runs at ONE position: the receiver's base for the
// positions `first` took, the argument's own value past them. A miss
// answers YES, for `has_call`'s reason: wrong in this direction costs a
// temporary, wrong the other way lets C order effects.
position_calls = (be: CBackend, c: Call, pos: usize, first: usize) bool {
    (pos < first).match({
        true  => be.recv_calls(c),
        false => c.args.get(pos - first).match({
            Ok(a) => be.has_call(a.value),
            None  => true,
        }),
    })
}

any_arg_calls = (be: CBackend, c: Call) bool {
    got ::= false;
    c.args.loop((h, a) { got = got || be.has_call(a.value); });
    got
}

// The index of the LAST argument containing a call — the position after
// which nothing is left to run.
// `later` is a named helper and not a `.then` in the loop body: a loop
// binding read inside a nested closure does not resolve,
// docs/SEMA_BOOTSTRAP_FIXES.md §10.
last_call_arg = (be: CBackend, c: Call) usize {
    at ::= 0;
    c.args.loop((h, i, a) { at = later(at, i, be.has_call(a.value)); });
    at
}

later = (at: usize, i: usize, yes: bool) usize {
    yes.match({ true => i, false => at })
}

// The same rule for an OPERATOR'S LEFT OPERAND: it is held when EITHER
// operand contains a call, and only then — the `any_arg_calls` question
// asked of two positions instead of N. The right may always stay inline,
// since nothing follows it.
// BOTH HALVES, because order is readable in both directions. A call on
// the right of a read (`b.n + d.tick()`) is #737's own shape. A call on
// the LEFT of a read (`d.tick() + b.n`) is the same coin flipped: Zen
// runs the tick first and reads `b.n` after it, and an unheld pair lets
// gcc load `b.n` before ever calling — `infix_order.zen`'s `mixed` line
// answered 0 that way. Only when NOTHING runs on either side (`1 + 2`,
// `b.n * 100`) is the freedom unobservable and both operands stay
// inline, which keeps the gate off the common arithmetic.
infix_operand_held* = (be: CBackend, b: Binary) bool {
    be.has_call(b.lhs) || be.has_call(b.rhs)
}

// Whether a CALL hides anywhere inside. Not the spilling question and
// not a weaker form of it: `d.tick()` spills nothing, and it is the
// whole reason argument order is observable at all.
// An unrecognised form answers YES, for `spills_anywhere`'s reason read
// one step on: wrong in this direction costs a temporary, wrong the
// other way is a program running its effects in whatever order the C
// compiler felt like.
// ITERATIVE, ON A WORKLIST, AND THE WORKLIST IS THE POINT. The first
// #737 patch walked this recursively, and `corpus/lex/long_single_line`
// -- one `+` chain ten thousand terms long -- overflowed the C stack
// and took the compiler to SIGSEGV (exit 139), with three `corpus/lsp/*`
// aborting beside it: the recursion is linear in OPERAND DEPTH, and
// neither flat syntax nor the parser bounds that. The parity gate
// caught it where `make build` could not. An EXPLICIT Vec costs one
// page from the arena per question and cannot overflow.
// An `add` that cannot allocate also answers YES. It cannot honestly
// answer NO -- "no" is the answer that lets gcc order effects -- so it
// degrades toward holding, the direction this predicate already degrades
// in.
has_call* = (be: CBackend, id: ExprId) bool {
    be.has_call_walk(id).match({
        Ok(found) => found,
        Err(_)    => true,
    })
}

// THE WALK, which can fail only through the arena: `add` cannot find a
// page and every step propagates. `has_call` turns that failure into
// YES -- it cannot honestly answer NO, since "no" is the answer that
// lets gcc order effects, so it degrades toward holding, the direction
// this predicate already degrades in.
has_call_walk = (be: CBackend, id: ExprId) Res<bool, AllocError> {
    work ::= be.alloc.Vec<ExprId>();
    work.add(id).try();
    found ::= false;
    loop(() { found == false && work.len > 0 }, (h) {
        // not `.take(..).try()`: this Res's miss is `None`, and no rule
        // widens that into `AllocError`. The miss is unreachable while
        // the guard holds -- nothing else pops -- so it answers YES and
        // stops, which also keeps the walk terminating under any input.
        popped = work.take(work.len - 1);
        popped.match({
            Ok(at) => be.tree.expr_at(at).kind.match({
                Literal(_) => Ok(()),
                Name(_)    => Ok(()),
                Unit       => Ok(()),
                Scope      => Ok(()),
                SelfType   => Ok(()),
                Paren(p)   => work.add(p.inner),
                Unary(u)   => work.add(u.operand),
                Binary(b)  => has_call_push2(work, b.lhs, b.rhs),
                Access(a)  => work.add(a.base),
                Index(x)   => has_call_push2(work, x.base, x.index),
                Consume(x) => work.add(x.operand),
                _          => { found = true; Ok(()) },
            }).try(),
            None   => { found = true; },
        });
    });
    Ok(found)
}

// Two children onto the worklist, one `Res` for the caller's match.
// Order is irrelevant to the answer, so whichever pops first is fine.
has_call_push2 = (
    work :: Vec<ExprId>,
    a    : ExprId,
    b    : ExprId
) Res<(), AllocError> {
    work.add(a).try();
    work.add(b).try();
    Ok(())
}

// WHAT A TEMPORARY CAN HOLD WITHOUT CHANGING WHAT IT MEANS. A `Consume`
// moves and a `Lambda` is inlined into the call it was written for, so
// neither survives being copied into one; an array literal's storage is
// the frame's. A `Literal` runs nothing, so its value cannot move under
// it. A `Name` also runs nothing, but its VALUE is observable: a call to
// its right can change it through a `::` parameter, so it is held
// whenever one is still to run — the caller of `holdable` asks that.
holdable* = (be: CBackend, id: ExprId) bool {
    be.tree.expr_at(id).kind.match({
        Call(_)   => true,
        Access(_) => true,
        Index(_)  => true,
        Unary(_)  => true,
        Binary(_) => true,
        Name(_)   => true,
        Paren(p)  => be.holdable(p.inner),
        _         => false,
    })
}

// The type of an expression.
// Sema first, always: where `type_of` answers, that answer is used.
// Where its answer is `Unknown`, the callee's own declaration is read
// instead — the same "degrade to your own resolution when absent" the
// bootstrapper's backend documents.
// The instantiation is applied HERE, once, so no lowering rule has to
// remember to: sema types a generic body once, generically, so every
// answer inside `Vec<T>.add` is about `T` until this substitutes the
// real `i32`.
// `@scope` is answered here, not by sema, for the same reason a local's
// type is: the FRAME is the authority. A block is not a value sema
// mints, but a `Scope` can be written as a parameter of the ordinary
// named type `std/core/scope.zen` declares — matched here. Without
// this, `inner = @scope;` binds a local of unknown type and every later
// use of `inner` is a name with no receiver.
ty_of* = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId)
         Res<TyId, AllocError> {
    be.ty_source(id, ctx, want).try().match({
        ScopeRef   => be.scope_type(ctx),
        Frame(t)   => Ok(t),
        Backend(t) => Ok(t),
        Sema(got)  => be.settled_answer(id, ctx, got, want),
        Unanswered => be.fallback_type(id, ctx, want),
    })
}

// WHICH AUTHORITY ANSWERED, and the order they are asked in. The order
// is the whole rule, and this list is the only statement of it: the
// frame before the backend, the backend before sema, sema before the
// context's expectation. Each variant carries the type its own source
// computed, so nothing below asks a second time.
TySource = ScopeRef | Frame(TyId) | Backend(TyId) | Sema(TyId) | Unanswered

ty_source = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId)
            Res<TySource, AllocError> {
    be.is_scope_ref(id).match({
        true  => Ok(TySource.ScopeRef),
        false => be.local_answer(id).try().match({
            Ok(t) => Ok(TySource.Frame(t)),
            None  => be.ptr_answer(id, ctx, want).try().match({
                Ok(t) => Ok(TySource.Backend(t)),
                None  => be.sema_source(id, ctx),
            }),
        }),
    })
}

sema_source = (be :: CBackend, id: ExprId, ctx: Ctx)
              Res<TySource, AllocError> {
    got = sub(be, be.check.type_of(id, ctx).try()).try();
    be.check.is_unknown(got).match({
        false => Ok(TySource.Sema(got)),
        true  => Ok(TySource.Unanswered),
    })
}

// The frame that declared a binding is the authority on its type, not
// sema's memo — the memo is keyed by node id alone, so an answer cached
// while lowering `Vec<Diag>.get` was read back for `Vec<TyId>.get`,
// emitting a call to the first symbol with the second's receiver. `cc`
// caught it; two types of one width would have hidden it.
// A handle and a closure are not values and have no type to give: `h`
// is a pair of labels, a lambda is a body to inline — both left to the
// paths that know what they are.
// A field read from one is the same rule one node up: `e.key` inside
// `Map<K, V>.confirms` derives from `e`'s type and the declaration, both
// held by the frame, so the memo has only a poisoned entry to give.
// Every instantiation of `confirms` called `str.eq`, including keys
// typed `ExprId` — swapping which map was built first swapped which
// `eq` every one of them called.
local_answer = (be :: CBackend, id: ExprId) Res<Res<TyId>, AllocError> {
    be.tree.expr_at(id).kind.match({
        Name(n)   => Ok(be.named_slot(n.text)),
        Access(a) => be.field_slot(a),
        _         => Ok(None),
    })
}

field_slot = (be :: CBackend, a: Access) Res<Res<TyId>, AllocError> {
    be.local_answer(a.base).try().match({
        None  => Ok(None),
        Ok(b) => be.known_field(b, a.name.text),
    })
}

// A member that is not STORAGE has no answer here — a nullary variant,
// a constant on a type and a method are three other readings of the
// same node, and `gen_c_read.zen` owns all three.
known_field = (be :: CBackend, base: TyId, name: str)
              Res<Res<TyId>, AllocError> {
    be.field_of(base, name).try().match({
        None  => Ok(None),
        Ok(t) => Ok(be.keep_known(t)),
    })
}

named_slot = (be :: CBackend, name: str) Res<TyId> {
    be.slot_of(name).match({
        None  => None,
        Ok(s) => be.value_slot(s),
    })
}

value_slot = (be :: CBackend, s: LocalSlot) Res<TyId> {
    s.is_value().match({
        false => None,
        true  => be.keep_known(s.ty),
    })
}

keep_known = (be :: CBackend, ty: TyId) Res<TyId> {
    (be.check.is_unknown(ty) || has_var(be.check, ty)).match({
        true  => None,
        false => Ok(ty),
    })
}

// `Ptr`'s members ARE the backend, so sema has no body to check and
// answers `p.to<u8>()` with a `Ptr` whose element nothing settled — not
// unknown, carries no `Var`, so nothing downstream questions it. A
// local declared at that type is a C pointer at the wrong stride:
// `src.back(8)` moved back thirty-two bytes, `realloc` read a length
// nobody wrote, and every row before the last grow was silently
// dropped. It compiled; the differential oracle caught it.
// So the backend answers first for exactly these members, the same
// authority it already has over lowering them.
ptr_answer = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId)
             Res<Res<TyId>, AllocError> {
    be.tree.expr_at(id).kind.match({
        Call(c) => be.ptr_call_answer(c, ctx, want),
        _       => Ok(None),
    })
}

ptr_call_answer = (be :: CBackend, c: Call, ctx: Ctx, want: TyId)
                  Res<Res<TyId>, AllocError> {
    be.tree.expr_at(c.callee).kind.match({
        Access(a) => be.ptr_dot_answer(c, a, ctx, want),
        _         => Ok(None),
    })
}

ptr_dot_answer = (be :: CBackend, c: Call, a: Access, ctx: Ctx, want: TyId)
                 Res<Res<TyId>, AllocError> {
    unknown = be.check.types.unknown().try();
    rty     = be.ty_of(a.base, ctx, unknown).try();
    be.is_ptr_member(rty, a.name.text).match({
        false => be.create_type(c, a, rty, ctx),
        true  => Ok(Ok(be.ptr_member_type(c, a, rty, ctx, want).try())),
    })
}

// An open type is not an answer. Sema types `range.loop(body)` as
// `Res<T>` because only the closure could settle `T`, and a closure
// infers FROM a signature rather than into one — so the answer carries
// a `Var`, and a binding declared at it would be the one C type every
// loop shares. Only the loop family hits this; `gen_c_loop.zen` owns
// the rule. Everything else is handed back untouched.
settled_answer = (be :: CBackend, id: ExprId, ctx: Ctx, got: TyId, want: TyId)
                 Res<TyId, AllocError> {
    has_var(be.check, got).match({
        false => be.opaque_answer(id, ctx, got),
        true  => be.settle_open(id, ctx, got, want),
    })
}

// A type spelled with a hole in it is not an answer either. `open`
// asks about a free PARAMETER, but a BOUND's member leaves something
// else: `Alloc.realloc<T>` has no body to check, so
// `self.alloc.realloc(self.data, cap)` comes back `Res<Ptr<?>,
// AllocError>` with the element neither substituted nor a `Var` — a
// type `open` calls settled and `gen_name.tcode` writes `q` for. A
// `.try()` on it declared its temporary at that spelling instead of the
// real `Res<Ptr<u8>, AllocError>`.
// Straight to the call, not through the loop/inline steps above: those
// settle a `Var` the closure or callee's instantiation was going to
// bind, and there's no parameter here for either. What's missing is
// what the ARGUMENTS say — `settle_call`'s question.
opaque_answer = (be :: CBackend, id: ExprId, ctx: Ctx, got: TyId)
                Res<TyId, AllocError> {
    unsettled(be, got).match({
        false => Ok(got),
        true  => settle_call(be, id, ctx, got),
    })
}

// The loop family first, then a callee that is inlined. Both answer the
// same shape of question — "sema left this open because only the closure
// could settle it" — and both have to answer BEFORE anything is written,
// because a match scrutinee's temporary is declared at this answer and
// filled by the lowering's.
settle_open = (be :: CBackend, id: ExprId, ctx: Ctx, got: TyId, want: TyId)
              Res<TyId, AllocError> {
    walked = be.loop_result_type(id, ctx, got, want).try();
    has_var(be.check, walked).match({
        false => Ok(walked),
        true  => be.settle_inlined(id, ctx, walked),
    })
}

// AND THEN THE CALL ITSELF. Sema types a generic call as its DECLARED
// return, and inside a member body nothing recorded an instantiation to
// close it — so a `.try()` on one lands in a temporary declared at
// `Res<q, E>`, which is a C struct with an unresolved element. The
// arguments say which instantiation it is; `gen_c_call.zen` asks them.
settle_inlined = (be :: CBackend, id: ExprId, ctx: Ctx, got: TyId)
                 Res<TyId, AllocError> {
    inlined = be.inline_result_type(id, ctx, got).try();
    has_var(be.check, inlined).match({
        false => Ok(inlined),
        true  => settle_call(be, id, ctx, inlined),
    })
}

// A `.try()` ON ONE IS THE SAME QUESTION ONE NODE UP. Sema types
// `f().try()` as the callee's declared `Ok` payload, which is the
// parameter itself when the callee is generic — so the operand is
// re-asked and the payload read off the answer.
settle_call = (be :: CBackend, id: ExprId, ctx: Ctx, got: TyId)
              Res<TyId, AllocError> {
    be.tree.expr_at(id).kind.match({
        Call(c)  => be.call_ret_type(id, c, ctx, got),
        Try(t)   => be.try_value_type(t.operand, ctx, got),
        Paren(p) => be.ty_of(p.inner, ctx, got),
        _        => Ok(got),
    })
}

fallback_type = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId)
                Res<TyId, AllocError> {
    be.tree.expr_at(id).kind.match({
        Call(c)   => call_type(be, c, ctx, want),
        Paren(p)  => be.ty_of(p.inner, ctx, want),
        Try(t)    => be.try_value_type(t.operand, ctx, want),
        Index(x)  => be.index_type(x, ctx, want),
        Access(a) => be.access_field_type(a, ctx, want),
        Binary(b) => binary_type(be, b, ctx, want),
        _         => Ok(want),
    })
}

// What a call evaluates to: the callee's declared return type, or the
// type it constructs.
call_type = (be :: CBackend, c: Call, ctx: Ctx, want: TyId)
            Res<TyId, AllocError> {
    be.tree.expr_at(c.callee).kind.match({
        Name(n) => be.named_call_type(n.text, ctx, want),
        _       => Ok(want),
    })
}

named_call_type = (be :: CBackend, name: str, ctx: Ctx, want: TyId)
                  Res<TyId, AllocError> {
    is_res_ctor(name).match({
        true  => Ok(want),
        false => be.declared_call_type(name, ctx, want),
    })
}

declared_call_type = (be :: CBackend, name: str, ctx: Ctx, want: TyId)
                     Res<TyId, AllocError> {
    found ::= be.alloc.Vec<Def>();
    be.check.world.defs_of(ctx.module, name, found).try();
    found.len.match({
        1 => be.def_call_type(found, want),
        0 => be.sugar_call_type(name, want),
        _ => Ok(want),
    })
}

// The print sugar names no function, so the walk above finds nothing
// and falls back to `want` (`Unknown` at every question worth asking).
// Its value IS unit: `gen_c_print.lower_print` writes the console calls
// as statements and hands back `0` as a placeholder, correct only where
// the value is discarded.
// Answering `()` makes that placeholder unreachable. `Unknown` agrees
// with everything, so `gen_c_hoist.needs_hoist` used to read a
// `println` reaching `Res<(), E>` as "already fits" and emit `return
// 0;` from a function returning a struct — exactly what that file
// exists to stop. With unit as the answer the lift fires instead, and
// `write_res_payload` runs the print for effect before building `Ok`.
// Under the zero-def arm rather than in front of the walk, because a
// module declaring its own `println` means its own (`gen_c_call.is_sugar`).
sugar_call_type = (be :: CBackend, name: str, want: TyId)
                  Res<TyId, AllocError> {
    is_print(name).match({
        false => Ok(want),
        true  => be.check.types.prim("()"),
    })
}

def_call_type = (be :: CBackend, found: Vec<Def>, want: TyId)
                Res<TyId, AllocError> {
    found.get(0).match({
        None  => Ok(want),
        Ok(d) => be.def_result_type(d, want),
    })
}

def_result_type = (be :: CBackend, d: Def, want: TyId)
                  Res<TyId, AllocError> {
    d.kind.match({
        FunctionDef => be.function_ret(d, want),
        StructDef   => be.constructed(d),
        _           => Ok(want),
    })
}

function_ret = (be :: CBackend, d: Def, want: TyId) Res<TyId, AllocError> {
    decl_at(be.tree, d.id).match({
        None  => Ok(want),
        Ok(x) => be.decl_ret(d, x, want),
    })
}

decl_ret = (be :: CBackend, d: Def, x: Decl, want: TyId)
           Res<TyId, AllocError> {
    ctx = Ctx(
        module: d.id.module.to_usize(),
        ret: TyId(index: 0),
        has_ret: false,
        self_ty: TyId(index: 0),
        has_self: false
    );
    x.kind.match({
        Function(f) => be.written_ret(f.ret, ctx, want),
        _           => Ok(want),
    })
}

written_ret = (be :: CBackend, ret: Res<TypeId>, ctx: Ctx, want: TyId)
              Res<TyId, AllocError> {
    ret.match({
        None  => Ok(want),
        Ok(t) => sub(be, be.check.type_from_ast(t, ctx).try()),
    })
}

// `.try()` evaluates to its operand's Ok payload.
try_value_type = (be :: CBackend, operand: ExprId, ctx: Ctx, want: TyId)
                 Res<TyId, AllocError> {
    unknown = be.check.types.unknown().try();
    rt      = be.ty_of(operand, ctx, unknown).try();
    be.check.types.at(rt).match({
        Res(r) => Ok(r.value),
        _      => Ok(want),
    })
}

// The `Res` an expression is, when it is one. `.try()` and a `match`
// on a `Res` both need this and neither has a `want` that says it.
res_type_of* = (be :: CBackend, id: ExprId, ctx: Ctx)
               Res<TyId, AllocError> {
    unknown = be.check.types.unknown().try();
    be.ty_of(id, ctx, unknown)
}

// The header's spill rule, applied: `spill_temp` makes the temporary
// here, declared and filled BEFORE the statement being built — the same
// place every other spill lands, since `deliver_simple` builds the
// expression text first and writes the line after.
// Four conversions funnel through this same three-door path (argument,
// field, return), each owned by whichever file builds it:
//   - a concrete value reaching a BOUND-typed slot becomes a fat value
//     (e.g. an `Arena` passed where `Alloc` is wanted), built here once
//     rather than at each of the three sites;
//   - a member reaching a structural-set slot, and a `Res` reaching a
//     wider-error `Res`, are the same shape — "the destination admits
//     more than the source has" — owned by `gen_c_widen.zen`;
//   - a bare success reaching a `Res` slot is the fourth: `7;` closing
//     `Res<i32, E>` is `Ok(7)` written shorter, built by
//     `gen_c_hoist.zen`.
expr* = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId, out :: String)
        Res<(), AllocError> {
    be.door_of(id, ctx, want).try().match({
        Set   => be.set_expr(id, ctx, want, out),
        Hoist => be.hoist_expr(id, ctx, want, out),
        Widen => be.widen_expr(id, ctx, want, out),
        Fat   => be.fat_expr(id, ctx, want, out),
        Plain => be.value_expr(id, ctx, want, out),
    })
}

// WHICH DOOR A VALUE GOES THROUGH on its way to `want`, and the order
// they are asked in. The order is load-bearing and this list is the
// only statement of it.
// A `Res` reaching a `Res` with a wider error set arrives through the
// same three doors as the other conversions. It is asked AFTER hoist
// (the two are disjoint by construction — a lifted value is not already
// a `Res`) and BEFORE the fat reading (a `Res` is never a bound).
// `gen_c_widen.zen` says what is claimed.
Door = Set | Hoist | Widen | Fat | Plain

// Early return over a pyramid: the one-shot loop is a breakable block,
// each `.then` a guard naming the one door it opens, the last break the
// answer when every guard says no — `request_of` in `lsp_reply` and
// `method_kind` in `gen_c_member` are the same idiom, and the typed
// binding is load-bearing for the reason its own comment states.
// The guards are still asked in the order the comment above states,
// first yes wins, and a guard's `.try()` returns from THIS function
// exactly as it did inside the old nesting.
door_of = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId)
          Res<Door, AllocError> {
    found: Res<Door> = loop<Door>((h) {
        be.needs_set(id, ctx, want).try().then(() { h.break(Door.Set) });
        be.needs_hoist(id, ctx, want).try().then(() { h.break(Door.Hoist) });
        be.needs_widen(id, ctx, want).try().then(() { h.break(Door.Widen) });
        be.needs_fat(id, ctx, want).try().then(() { h.break(Door.Fat) });
        h.break(Door.Plain);
    });
    Ok(found.match({
        Ok(door) => door,
        None     => Door.Plain,
    }))
}

// The value AT ITS OWN TYPE, then the record over its address: lowering
// it at the bound would ask for a record that does not exist yet.
fat_expr = (
    be   :: CBackend,
    id   : ExprId,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    cty     = be.ty_of(id, ctx, unknown).try();
    code ::= be.alloc.String().try();
    be.value_expr(id, ctx, cty, code).try();
    be.write_fat_value(code.view(), cty, want, out)
}

value_expr* = (
    be   :: CBackend,
    id   : ExprId,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    be.spills(id).match({
        true  => be.spill_temp(id, ctx, want, out),
        false => be.write_expr(id, ctx, want, out),
    })
}

spill_temp = (
    be   :: CBackend,
    id   : ExprId,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    ty = be.destination_type(id, ctx, want).try();
    be.spill_of(ty).match({
        Unsettled => be.unsupported(
            id,
            "a spilling form whose type nothing settles",
            out
        ),
        Effect    => be.spill_effect(id, ctx, ty, out),
        Valued    => be.spill_valued(id, ctx, ty, out),
    })
}

// WHAT A SPILLED VALUE CAN BE HELD IN, in the order asked: a type
// nothing settled has no C declaration to make, and a `()` has no
// storage to make one in.
Spill = Unsettled | Effect | Valued

spill_of = (be :: CBackend, ty: TyId) Spill {
    be.settled_place(ty).match({
        false => Spill.Unsettled,
        true  => be.is_unit(ty).match({
            true  => Spill.Effect,
            false => Spill.Valued,
        }),
    })
}

// NOTHING WROTE AN EXPECTATION, so the node answers for itself. A
// lowering that reaches for a `want` it was never handed — `to<U>` on a
// member call, a null pointer, a loop's value — asks here rather than
// each inventing the unknown to ask `ty_of` with. The answer may still
// be the unknown, and that is information: a discarded loop still HAS a
// value, and `open_result` reads this to decide whether to give it
// storage.
want_of* = (be :: CBackend, id: ExprId, ctx: Ctx) Res<TyId, AllocError> {
    unknown = be.check.types.unknown().try();
    be.ty_of(id, ctx, unknown)
}

settled_place = (be :: CBackend, ty: TyId) bool {
    (be.check.is_unknown(ty) == false) && (has_var(be.check, ty) == false)
}

// A spilling form whose value is `()` has nothing to hold — a void
// temporary is illegal C — and it still RUNS: dropping it would drop
// the `.try()` that was the reason for writing it. `0` goes where the
// expression went, which is what the four report helpers write.
spill_effect = (
    be  :: CBackend,
    id  : ExprId,
    ctx : Ctx,
    ty  : TyId,
    out :: String
) Res<(), AllocError> {
    be.deliver(id, ctx, ty, Dest.Discard).try();
    out.add("0")
}

spill_valued = (
    be  :: CBackend,
    id  : ExprId,
    ctx : Ctx,
    ty  : TyId,
    out :: String
) Res<(), AllocError> {
    be.request_type(ty).try();
    tmp  ::= be.fresh_name("s").try();
    line ::= be.alloc.String().try();
    be.declarator(ty, tmp.view(), line).try();
    be.fmt("{};\n", line.view()).try();
    be.deliver(id, ctx, ty, Dest.Into(tmp.view())).try();
    out.add(tmp.view())
}

// A value put in a temporary WHERE IT WAS WRITTEN, so that what it does
// happens there rather than wherever the C compiler decides to evaluate
// the argument it was written into. The `argument order` block above owns
// which arguments ask for this; the temporary itself is `spill_valued`'s,
// the same one a `.try()` in argument position already gets.
// A type nothing settles, and a `()` with no storage to hold it, stay
// inline: a refusal here would turn a working program into an error over
// an order nothing could observe. That is the one direction this degrades
// in and it is the safe one.
value_held* = (
    be   :: CBackend,
    id   : ExprId,
    ctx  : Ctx,
    want : TyId,
    hold : bool,
    out  :: String
) Res<(), AllocError> {
    (hold && be.holdable(id)).match({
        true  => be.hold_value(id, ctx, want, out),
        false => be.expr(id, ctx, want, out),
    })
}

hold_value = (
    be   :: CBackend,
    id   : ExprId,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    ty = be.destination_type(id, ctx, want).try();
    be.spill_of(ty).match({
        Valued    => be.spill_valued(id, ctx, ty, out),
        Effect    => be.expr(id, ctx, want, out),
        Unsettled => be.expr(id, ctx, want, out),
    })
}

write_expr = (
    be   :: CBackend,
    id   : ExprId,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    node = be.tree.expr_at(id);
    node.kind.match({
        Literal(l)    => be.lower_literal(id, l, ctx, want, out),
        Name(n)       => be.lower_name(id, n.text, ctx, want, out),
        Paren(p)      => be.lower_paren(p.inner, ctx, want, out),
        Unary(u)      => be.lower_unary(node, u, ctx, want, out),
        Binary(b)     => be.lower_binary(node, b, ctx, want, out),
        Access(a)     => be.lower_meta_or_access(id, a, ctx, want, out),
        Call(c)       => be.lower_call(id, c, ctx, want, out),
        Index(x)      => be.lower_index(id, x, ctx, out),
        Array(a)      => be.lower_array_lit(id, a, ctx, want, out),
        FixedArray(f) => be.lower_fixed_array(id, f, ctx, want, out),
        Unit          => out.add("0"),
        Scope         => be.lower_scope_ref(id, out),
        Consume(x)    => be.lower_consume(x, ctx, want, out),
        _             => be.unsupported(id, "this expression form", out),
    }).try();
    Ok(());
}

// `consume x` MOVES, and in C the bytes are simply copied — so the
// value here is the operand's own spelling and nothing more. What the
// move costs is the RECORD of it: this frame handed the value away, so
// it must not also destroy it, and the binding's live flag is cleared
// on the way past. Without that both the source and the destination
// drop, which is the double free `consume` exists to prevent.
lower_consume = (
    be   :: CBackend,
    x    : Consume,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    be.release_moved(x.operand).try();
    expr(be, x.operand, ctx, want, out)
}

release_moved = (be :: CBackend, id: ExprId) Res<(), AllocError> {
    be.tree.expr_at(id).kind.match({
        Name(n)  => be.release_binding(n.text),
        Paren(p) => be.release_moved(p.inner),
        _        => Ok(()),
    })
}

lower_paren = (
    be   :: CBackend,
    id   : ExprId,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    out.add("(").try();
    expr(be, id, ctx, want, out).try();
    out.add(")").try();
    Ok(());
}

// A literal is its RAW source slice, and that is deliberate: Zen's
// escape set is `\n \t \r \0 \\ \' \"` and every one of those is a C
// escape with the same meaning, so the bytes travel unchanged. A `str`
// is not a `char *` though — it is a pointer and a length — so a
// string literal is built as one.
lower_literal = (
    be   :: CBackend,
    id   : ExprId,
    l    : Literal,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    l.kind.match({
        Str   => be.lower_str_literal(l, out),
        Int   => lower_int_literal(l.text, out),
        Float => out.add(l.text),
        Char  => out.add(l.text),
        Bool  => out.add(l.text),
    }).try();
    Ok(());
}

// A DECIMAL CONSTANT WITH NO SUFFIX HAS NO UNSIGNED TYPE IN C99, so one
// too large for `long long` is a constraint violation — `cc` picks
// `unsigned long long` anyway and warns, on every build, about `u64.MAX`
// and about FNV's basis. The suffix is read off the DIGITS and not off
// the settled type: a value `i64` can hold needs nothing, and one it
// cannot hold cannot be signed.
lower_int_literal = (text: str, out :: String) Res<(), AllocError> {
    out.add(text).try();
    over_i64(text).match({
        true  => out.add("ULL"),
        false => Ok(()),
    })
}

I64_MAX_DIGITS: str = "9223372036854775807"

// `lex_literal.number` reads decimal only — no separators, no leading
// zero, no suffix — so more digits is a larger number and equal digits
// order the same way bytes do.
over_i64 = (text: str) bool {
    (text.len == I64_MAX_DIGITS.len).match({
        true  => I64_MAX_DIGITS.before(text),
        false => text.len > I64_MAX_DIGITS.len,
    })
}

lower_str_literal = (be :: CBackend, l: Literal, out :: String)
                    Res<(), AllocError> {
    out.fmt("(zg_str){ (unsigned char *){}, ", l.text).try();
    out.write_usize(decoded_len(l.text)).try();
    out.add("u }").try();
    Ok(());
}

// The byte length a string literal denotes: its raw slice without the
// quotes, with each escape counting once.
// `esc` is "the previous byte opened an escape", so the byte that
// closes one is not counted and the backslash that opened it is.
decoded_len* = (raw: str) usize {
    n   ::= 0;
    esc ::= false;
    Range(1, body_end(raw)).loop((h, i) {
        (esc == false).then(() { n = n + 1; });
        esc = (esc == false) && (raw.index(i) == '\\');
    });
    n
}

// `@meta(self: @Self).name` FOLDED AT SEMA: `meta_str` remembers the
// comptime string the access stands for, and the residue is an
// ordinary literal — the backend lowers it having learned nothing new
// (docs/design_meta.md, M3). The memo is keyed on the WRITTEN TYPE
// (`sema_check.zen`), which this access's own `Meta` node carries, so
// the read-back needs no state of its own; a miss is every other dot,
// which takes the field path.
// THE COUNT'S CHAIN IS THE SIBLING, ONE SHAPE UP: `.len` over
// `fields()` over a Meta. It is recognised BY THE SHAPE — the same
// strict predicate sema answered with (`is_count_chain`, read through
// the checker; no second definition of the chain) — and only then is
// the count read off the memo. The shape test comes FIRST because both
// memos key on the same written type: a bare `.name` on a type whose
// count was folded elsewhere in the program must stay a string, which
// a memo-ordering rule would get wrong.
lower_meta_or_access* = (
    be   :: CBackend,
    id   : ExprId,
    a    : Access,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    base = be.check.tree.expr_at(a.base);
    base.kind.match({
        Meta(m) => m.type.match({
            Ok(t) => be.check.meta_str(t).match({
                Ok(text) => lower_meta_name(text, out),
                None     => be.lower_access(id, a, ctx, want, out),
            }),
            None  => be.lower_access(id, a, ctx, want, out),
        }),
        _       => be.check.meta_name_read(id).match({
            // A WALK'S `field.name` (`gen_c_meta.zen`): sema marked the
            // access, and the text it folds to is the CURRENT pass's
            // field — `walk_now`'s top — lowered as the ordinary string
            // literal `lower_meta_name` already writes. A marker with no
            // walk being lowered is a bug in the dispatch, said so.
            true  => be.check.walk_field_now().match({
                Ok(text) => lower_meta_name(text, out),
                None     => be.unsupported(
                    id,
                    "a field-name fold with no walk on the lowering stack",
                    out
                ),
            }),
            false => be.check.is_count_chain(a).match({
                true  => be.chain_count(a.base, out),
                false => be.lower_access(id, a, ctx, want, out),
            }),
        }),
    })
}

// The chain's root, from its top access: the Call's callee carries the
// Meta with the WRITTEN TYPE EXPRESSION — the memo key. `is_count_chain`
// has vouched for every level between; this reads the one row.
chain_count = (be :: CBackend, call_id: ExprId, out :: String)
              Res<(), AllocError> {
    be.check.tree.expr_at(call_id).kind.match({
        Call(k) => be.check.tree.expr_at(k.callee).kind.match({
            Access(f) => be.check.tree.expr_at(f.base).kind.match({
                Meta(m) => m.type.match({
                    Ok(t) => be.lower_meta_count(t, out),
                    None  => Ok(()),
                }),
                _       => Ok(()),
            }),
            _         => Ok(()),
        }),
        _       => Ok(()),
    })
}

// The folded text is a type's DECLARED NAME — identifier bytes, which
// no escaping can be needed for: Zen's escapes are introduced by `\`
// and a literal is closed by `"`, and neither byte can appear in an
// identifier the lexer accepted. So the quotes are added around the
// text and the length is `text.len` — no `decoded_len`, there is
// nothing to decode.
lower_meta_name = (text: str, out :: String) Res<(), AllocError> {
    out.fmt("(zg_str){ (unsigned char *)\"{}\", ", text).try();
    out.write_usize(text.len).try();
    out.add("u }").try();
    Ok(());
}

// THE COUNT'S SIBLING (`sema_check.meta_count_of`): `.fields().len`
// folded to the type's field count at sema time, and this lowers it as
// an ordinary integer literal — the backend learned nothing new about
// fields, it writes a number.
lower_meta_count* = (
    be  :: CBackend,
    t   : TypeId,
    out :: String
) Res<(), AllocError> {
    got = be.check.meta_count_of(t);
    got.match({
        Ok(n) => {
            out.write_usize(n).try();
            Ok(())
        },
        None  => Ok(()),
    })
}

// A bare identifier: a local, or a name the module declares. `None` is
// neither — it is a `Res` constructor, and `Res` is structural in this
// compiler's type language, so its constructors are too.
lower_name = (
    be   :: CBackend,
    id   : ExprId,
    text : str,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    be.slot_of(text).match({
        Ok(slot) => be.write_name_slot(
            text,
            be.tree.expr_at(id).span,
            slot,
            out
        ),
        None     => be.lower_global_name(id, text, ctx, want, out),
    })
}

write_name_slot* = (
    be   :: CBackend,
    name : str,
    span : Span,
    slot : LocalSlot,
    out  :: String
) Res<(), AllocError> {
    be.closure_storage(span, slot, "a lambda read as a value").try().match({
        true  => be.has_storage(slot.ty).match({
            true  => be.write_local(name, slot, out),
            false => out.add("0"),
        }),
        false => sym_local(out, name, 1),
    })
}

// `{name}` in a format string: the C text of the binding that name has
// WHERE THE HOLE IS WRITTEN, and its type.
// ONE ANSWER FOR BOTH FORMAT WALKS. `println("{n}")` and `out.add("{n}")`
// must resolve `n` to the same binding, and the reason it is here rather
// than in either walk is that resolving a bare identifier is already
// this file's job — `lower_name` below is the same lookup, reached from a
// node instead of from a name.
// THIS IS WHAT MAKES `{name}` A COMPILE-TIME FEATURE: the frame being
// lowered is asked, the type comes off the slot, and the write emitted is
// the one a positional hole would emit. No runtime format state and no
// allocation, which is the property `make bench-allocs` gates.
// `None` is every way a name can fail to be a value here — no binding, a
// loop handle, a closure, a type not yet known — because a hole has one
// thing to say about all four and `value_slot` already draws the line.
named_hole* = (be :: CBackend, name: str, out :: String)
              Res<Res<TyId>, AllocError> {
    be.slot_of(name).match({
        None  => Ok(None),
        Ok(s) => be.hole_text(name, s, out),
    })
}

hole_text = (be :: CBackend, name: str, s: LocalSlot, out :: String)
            Res<Res<TyId>, AllocError> {
    be.value_slot(s).match({
        None  => Ok(None),
        Ok(t) => { be.write_local(name, s, out).try(); Ok(Ok(t)) },
    })
}

// A `::` parameter holds the ADDRESS of its argument, so reading it is
// a dereference. Parenthesised, because every use of it is a use of the
// value: `(*p).x` and `*p.x` are different C.
write_local = (be :: CBackend, text: str, slot: LocalSlot, out :: String)
              Res<(), AllocError> {
    slot.by_ref.match({
        false => sym_local(out, text, slot.index),
        true  => be.write_deref(text, slot, out),
    })
}

write_deref = (be :: CBackend, text: str, slot: LocalSlot, out :: String)
              Res<(), AllocError> {
    out.add("(*").try();
    sym_local(out, text, slot.index).try();
    out.add(")").try();
    Ok(());
}

lower_global_name = (
    be   :: CBackend,
    id   : ExprId,
    text : str,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    text.eq("None").match({
        true  => be.res_value(id, want, "None", out),
        false => be.lower_global_value(id, text, ctx, want, out),
    })
}
