// std.core.bool
//
// The one-sided conditional. `.match` is always exhaustive, in
// every position, so there is no partial form for a dropped case to
// hide in. When you genuinely want nothing on the false side you
// write `then`, and because it is a different word it can never be
// read as a forgotten arm.
//
// It lands in Res, so it composes with `.try()`, with `ok_or` and
// with `.match` like anything else: Ok(v) when true, None when
// false.
//
//   (n > 0).then(() { n * 2 }).ok_or(Error.NotPositive).try();
//
// A plain UFCS function whose first parameter is a bool, not an
// impl on bool: `b.then(..)` and `then(b, ..)` are the same call
// written two ways, and nothing here needs dispatch.
//
// A `.then` inside a loop is usually a missing loop word — find or
// filter — rather than a conditional at all.
then* = <T>(b: bool, f: () T) Res<T> {
    b.match({
        true  => Ok(f()),
        false => None,
    });
}
