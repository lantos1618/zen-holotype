// A method combines its receiver instantiation with type arguments inferred
// from each call. Required impl members use the same path as ordinary bodies.

Box = {
    n :: i32,

    tag = <U>(self: @Self, value: U) i32 { self.n; }

    bump ::= <U>(self :: @Self, value: U) i32 {
        self.n = self.n + 1;
        self.n;
    }
}

main = (env: Env) Res<i32, AllocError> {
    box ::= Box(n: 4);
    println("{}", box.n);
    println("{}", box.tag(9));
    println("{}", box.tag<u8>(9));
    println("{}", box.bump(9));
    Ok(0);
}
