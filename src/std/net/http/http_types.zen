// Shared HTTP/1 public data types. Keeping these independent of transport and
// decoding lets the implementation modules depend in one direction.

String = std.text
WriteError = std.core.io

HttpError* = ConnectFailed
    | TlsFailed
    | SendFailed
    | RecvFailed
    | DecodeFailed
    | BodyWriteFailed(WriteError)
    | Status(i32)

HttpResponseMeta* = {
    status*:             i32,
    content_length*:     usize,
    has_content_length*: bool,
    chunked*:            bool,
}

HttpResponse* = {
    status*: i32,
    body*:   String,
}
