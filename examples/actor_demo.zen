// actor_demo.zen - cooperative typed chat-room actor (inline drain, NOT the pool).
//
//   $ zenc run examples/actor_demo.zen
//   after alice joined:   online=1 posted=0
//   after bob + a message: online=2 posted=1
//   ok
//
// Spawn an actor holding ChatRoom state, `send` it Join/Say messages, and `request`
// its stats back over a one-shot ReplyRef — drained on the caller thread.
// For parallel typed actors on N cores, see `examples/pool_actor_demo.zen`.
{ to_exit } = std.core.bool
{ Result, IoError, expect } = std.core.result
{ formatln, arg_int, println } = std.text.fmt
alloc = std.mem.heap
actor = std.concurrent.actor
SayArgs*: {
    from: StringView,
    text: StringView,
}
ChatStats*: {
    online: i32,
    posted: i32,
}
ChatMsg*: Join(StringView) | Say(SayArgs) | GetStats(actor.ReplyRef<ChatStats>)
ChatRoom*: {
    online: i32,
    posted: i32,
}
ChatRoom.impl(actor, {
    receive = (room: MutPtr<ChatRoom>, ctx: actor.Context<ChatMsg>) void {
        ctx.msg.match ({
            .Join(name)         => {
                room.online = room.online + 1
            },
            .Say(args)          => {
                room.posted = room.posted + 1
            },
            .GetStats(reply_to) => {
                reply_to.send(ChatStats(
                    online: room.online,
                    posted: room.posted,
                ))
            },
        })
    }
})
ROOM_CAP = 16
ChatRoomHandle*<A>: {
    alloc: MutPtr<A>,
    actor: actor.ActorHandle<ChatMsg, ChatRoom>,
    join = (room: ChatRoomHandle<A>, name: StringView) bool { room.actor.send(.Join(name)) }
    say = (room: ChatRoomHandle<A>, from: StringView, text: StringView) bool {
        room.actor.send(.Say(SayArgs(
            from: from,
            text: text,
        )))
    }
    stats = (room: ChatRoomHandle<A>) ChatStats {
        r: Result<ChatStats, IoError> = room.actor.request(room.alloc, (reply) { .GetStats(reply) })
        r.expect("actor_demo: stats reply allocation failed")
    }
    free = (room: ChatRoomHandle<A>) void { room.actor.free(room.alloc) }
}
chat_room<A> = (heap: MutPtr<A>) ChatRoomHandle<A> {
    room_r: Result<actor.ActorHandle<ChatMsg, ChatRoom>, IoError> = actor.spawn_handle(heap, ROOM_CAP, ChatRoom(
        online: 0,
        posted: 0,
    ))
    room = room_r.expect("actor_demo: chat room allocation failed")
    ChatRoomHandle<A>(
        alloc: heap,
        actor: room,
    )
}
simulate_chat<A> = (room: ChatRoomHandle<A>) void {
    room.join("bob")
    room.say("alice", "hey")
}
main = () i32 {
    heap = alloc.gpa()
    a = heap.addr()
    room = a.chat_room()
    room.join("alice")
    first = room.stats()
    // formatln gives explicit control over the label/value layout.
    formatln("after alice joined:   online={} posted={}", [arg_int(to_i64(first.online)), arg_int(to_i64(first.posted))])
    room.simulate_chat()
    second = room.stats()
    formatln("after bob + a message: online={} posted={}", [arg_int(to_i64(second.online)), arg_int(to_i64(second.posted))])
    room.free()
    ok = first.online == 1 && first.posted == 0 && second.online == 2 && second.posted == 1
    ok.then({ println("ok") }, { println("MISMATCH") })
    ok.to_exit()
}
