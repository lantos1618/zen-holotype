// `h.break(v)` IN A FIELD WALK (`docs/design_meta.md` §7, M4 slice 2).
// The walk has no value — it unrolls to one block per field, typed
// `()` — so there is nothing for a broken value to become. Refused by
// name; carrying a value out of the walk is M4-later's sentence, not
// this slice's.
//
// position: the break call, which is the refused sentence.

One = { only: i64 }

main = (env: Env) Res<i32, AllocError> {
    o = One(only: 1);
    @meta(x: One).fields().loop((h, field) {
        h.break(1);
    });
    Ok(0);
}
