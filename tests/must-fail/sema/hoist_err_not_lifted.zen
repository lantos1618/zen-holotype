// only success lifts. failure stays visible: Err is always written, and
// a bare error value at a Res return is not an Err. law 4.
//
// position: the value in return position.

CfgError =
    Missing,
    Bad

load = (n: i32) Res<i32, CfgError> {
    CfgError.Bad;
}

main = (env: Env) Res<i32, CfgError> {
    println("{}", load(1).try());
    Ok(0);
}
