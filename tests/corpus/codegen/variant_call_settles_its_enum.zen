// A VARIANT CALL IS A GENERIC-FUNCTION APPLICATION, and its return has
// to be instantiated like one. `variant_ctor` hands back
// `Fn([T], Opt<T>)` at the DECLARATION's own parameters, and pulling
// `.ret` off it raw typed `x` as the bare `Opt` — while `pick` was
// monomorphised at `Opt<i32>`. The C named two different structs for
// one value and `cc` refused to compile it:
//
//     expected `zu_t2_5repro3OptI1_b3i32` but argument is of type
//     `zu_t2_5repro3Opt`
//
// Zen accepted the program; only the C compiler ever objected, which is
// why nothing in the corpus saw it.
//
// THE SECOND HALF IS THE PART THAT STAYS: a variant with no payload
// settles nothing, and `none` must still be the enum the annotation
// asks for rather than an inference from an argument that isn't there.

Opt<T> = Some(T) | None

pick = (o: Opt<i32>) i32 {
    o.match({ Some(v) => v, None => 0 })
}

main = (env: Env) Res<i32, AllocError> {
    x = Opt.Some(41);
    println("{}", pick(x));
    none: Opt<i32> = Opt.None;
    println("{}", pick(none));
    Ok(0);
}
