Left = | Number(i32)
Right = | Text(str)

left = () Res<i32, Left | Right> { Err(Left.Number(7)) }
right = () Res<i32, Left | Right> { Err(Right.Text("hello")) }

show = (result: Res<i32, Left | Right>) () {
    result.match({
        Ok(value)  => println("ok {}", value),
        Err(error) => error.match({
            Left(value)  => value.match({ Number(n) => println(
                "number {}",
                n
            ) }),
            Right(value) => value.match({ Text(s) => println("text {}", s) }),
        }),
    });
}

main = (env: Env) Res<i32, AllocError> {
    show(left());
    show(right());
    show(Ok(9));
    Ok(0)
}
