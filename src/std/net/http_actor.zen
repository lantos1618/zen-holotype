// std.net.http_actor — the HTTP client packaged as a ready-made POOL ACTOR.
//
// std.net.http is a blocking client; this module is how an application actually uses it
// concurrently: a fetcher actor runs the blocking `http_get` on its pool worker (parking the
// worker, not the app) and replies to the requester with an ordinary message. The message type,
// the reply type, the receiver, AND the concrete trampoline all live here — an app spawns a
// fetcher and sends it a URL, nothing more:
//
//   fetcher := spawn_http_fetcher(8)
//   p.send(fetcher, http_fetch("http://127.0.0.1:8080/", me.ref_of(p)))
//   // ... the reply arrives at `me` as HttpReplyMsg.Done(HttpReply(status, body))
//
// The reply body is heap-owned (gpa) and lives for the program — a per-actor arena is the
// tracked upgrade. Streaming is not offered yet: `http_get` buffers the whole response; a
// chunk-per-message stream would hand the fetcher the TcpConn and ride recv_into (future slice).
{ ActorRef } = std.concurrent.pool
{ Context, Receiver, dispatch, ref_send_msg } = std.concurrent.pool_actor
pa = std.concurrent.pool_actor
{ http_get, http_error_name } = std.net.http
{ gpa } = std.mem.heap
// an order: fetch this URL, reply to this address (both fields are sendable).
HttpFetch*: {
    url: string_view,
    reply_to: ActorRef,
}
HttpFetchMsg*: Fetch(HttpFetch)
// the outcome: status + body text. A request that failed outright is status 0 with the
// HttpError's name as the body.
HttpReply*: {
    status: i64,
    body: string_view,
}
HttpReplyMsg*: Done(HttpReply)
// message constructor — callers never write a module-qualified enum-variant literal.
http_fetch* = (url: string_view, reply_to: ActorRef) HttpFetchMsg {
    .Fetch(HttpFetch(
        url: url,
        reply_to: reply_to,
    ))
}
// The fetcher: `receive` runs on a pool worker, so the blocking dial/send/recv inside `http_get`
// blocks that worker only. The reply is an ordinary send to the ActorRef carried by the request
// (inside `receive` there is no Pool pointer — the ref is the whole reply capability).
// `dropped` is this actor's own dead-letter counter: replies it could not deliver (see `reply_or_drop`).
HttpFetcher*: {
    fetches: i64,
    dropped: i64,
}
// Deliver one reply, or TALLY the loss. A reply send is a real send: it returns `.Err(.MailboxFull)`
// when the requester's mailbox is full, and dropping that Result silently leaves the requester waiting
// for a reply that will never come. A behaviour has no caller to propagate to (`receive` returns void)
// and panicking inside a behaviour kills the fetcher for every OTHER requester — so the failure is
// recorded as state instead: `f.dropped` mirrors the pool's own `pool_dropped` dead-letter counter, one
// scope down, and is readable through `pa.actor_state(h).dropped`. The pool tallies the same drop, so
// the loss is observable per-fetcher AND per-pool, never invisible.
reply_or_drop = (f: MutPtr<HttpFetcher>, req: HttpFetch, rep: HttpReply) void {
    req.reply_to.ref_send_msg(HttpReplyMsg.Done(rep)).match ({
        .Ok(_)  => { },
        .Err(_) => {
            f.dropped = f.dropped + 1
        },
    })
}
HttpFetcher.impl(Receiver, {
    receive = (f: MutPtr<HttpFetcher>, ctx: Context<HttpFetchMsg>) void {
        ctx.msg.match ({
            .Fetch(req) => {
                f.fetches = f.fetches + 1
                h := gpa()
                a := h.addr()
                a.http_get(req.url).match ({
                    .Ok(r)  => f.reply_or_drop(req, HttpReply(
                        status: to_i64(r.status),
                        body: r.body,
                    )),
                    .Err(e) => f.reply_or_drop(req, HttpReply(
                        status: 0,
                        body: http_error_name(e),
                    )),
                })
            },
        })
    }
})
// the concrete trampoline lives HERE (both its types are this module's), so apps never write one.
http_fetch_tramp* = (user: RawPtr<u8>, msg: i64) void {
    dispatch<HttpFetcher, HttpFetchMsg>(user, msg)
}
// spawn a ready-to-use fetcher on the pool (process-default rt; not yet runnable — the first
// send schedules it). Read `pa.actor_state(h).dropped` after quiescence for undeliverable replies.
spawn_http_fetcher* = (cap: i64) pa.PooledHandle<HttpFetcher> {
    pa.spawn_actor_heap(cap, HttpFetcher(
        fetches: 0,
        dropped: 0,
    ), http_fetch_tramp)
}
