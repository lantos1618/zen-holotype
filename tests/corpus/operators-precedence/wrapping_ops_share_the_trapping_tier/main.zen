// THE WRAPPING FORMS BIND AT EXACTLY THEIR TRAPPING COUSINS' TIER —
// `+%` sits on the additive row, `*%` on the multiplicative row, because
// they are the same operations with a different overflow rule (D1), not
// a third family with its own strength.
//
// This is the tier assignment an implementer gets wrong by OVER-thinking:
// the wrap spellings look special enough to earn their own precedence
// row, and every such re-rowing silently regroups arithmetic that still
// compiles and still prints small ordinary numbers. Give them a tier
// ABOVE multiplicative and `12 +% 3 * 2` becomes (12+%3)*2 = 30 instead
// of 12+(3*2) = 18, while `1 + 2 +% 3` stays 6 — half the file goes red,
// half agrees with the bug, which is why there are five lines and not
// two. Loosen them below additive instead and `10 -% 2 + 3` drops from
// 11 to 5.
//
// `9 - 1 -% 2` doubles as associativity evidence: 6 is the LEFT fold
// ((9-1)-%2); the right-nested reading through the wrap op gives 10.
//
// THE ONE-LINE BREAK: in the binary table, lift `+% -% *%` out of
// PREC.additive/PREC.multiplicative into their own row (either direction).
// `w2` flips 18 -> 30 lifted, `w1` flips 11 -> 5 lowered; nothing errors.

main = (env: Env) Res<i32, AllocError> {
    println("w1 {}", 10 -% 2 + 3);
    println("w2 {}", 12 +% 3 * 2);
    println("w3 {}", 9 - 1 -% 2);
    println("w4 {}", 1 + 2 +% 3);
    println("w5 {}", 2 + 3 *% 4);

    // the explicit-paren twin of w2: what the correct tree must equal.
    println("paren {}", 12 +% (3 * 2));
    Ok(0);
}
