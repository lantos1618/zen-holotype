// src/gen/gen_c/gen_c_op.zen
// Type-directed operator lowering. Integer arithmetic uses checked
// helpers because signed C overflow is UB; wrapping operators stay
// plain C. Equality may statically dispatch through `Eq`. Short-circuit
// operands keep spills inside their branch so evaluation stays lazy.

Expr, ExprId, Span = std.ast
Literal, BinOp, Binary, Unary = std.ast
AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId = sema.sema_ty
Ctx, is_logical = sema.sema_check
type_of = sema.sema_type
CBackend = gen.gen_c.gen_c_state
unsupported = gen.gen_c.gen_c_report
sub = gen.gen_c.gen_c_mono
is_c_integer = gen.gen_c.gen_c_type
lower_eq_call = gen.gen_c.gen_c_member
init_temp = gen.gen_c.gen_c_flow
expr, ty_of, spills_anywhere = gen.gen_c.gen_c_expr
infix_operand_held, value_held = gen.gen_c.gen_c_expr
needs_set = gen.gen_c.gen_c_widen
needs_hoist = gen.gen_c.gen_c_hoist
needs_fat = gen.gen_c.gen_c_fat

// operators

lower_unary* = (
    be   :: CBackend,
    node : Expr,
    u    : Unary,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    u.op.match({
        Not  => be.wrap_unary("!", u.operand, ctx, want, out),
        Neg  => be.lower_negate(node, u, ctx, want, out),
        Addr => be.unsupported(u.operand, "the address-of operator", out),
    })
}

wrap_unary = (
    be      :: CBackend,
    op      : str,
    operand : ExprId,
    ctx     : Ctx,
    want    : TyId,
    out     :: String
) Res<(), AllocError> {
    out.fmt("({op}").try();
    expr(be, operand, ctx, want, out).try();
    out.add(")").try();
    Ok(());
}

// WHAT A `-` WRITES, in the order `negate_kind` asks for them.
NegKind = Float | Folded(str) | Checked

// Negation on an integer is `0 - x`, and it TRAPS: `-i32.MIN` is an
// overflow like any other. On a float it is the C operator, which
// cannot overflow.
lower_negate = (
    be   :: CBackend,
    node : Expr,
    u    : Unary,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    ty   = be.ty_of(u.operand, ctx, want).try();
    prim = be.check.prim_name(ty);
    be.negate_kind(u, prim).match({
        Float     => be.wrap_unary("-", u.operand, ctx, want, out),
        Folded(d) => write_negative_literal(d, out),
        Checked   => be.negate_checked(node, u, prim, ctx, ty, out),
    })
}

// A MINUS SIGN ON A LITERAL IS PART OF THE CONSTANT, not a subtraction
// from zero — folding it here is a correctness fix, not an
// optimisation. `0 - x` evaluates the positive first, and `iN.MIN`'s
// magnitude is one past `iN.MAX`, so the checked subtract traps on the
// way to a value the type holds exactly.
// Concretely: `std/core/num.zen:54:17: trap: integer overflow` —
// `i64.MIN - 1` never reached the subtraction the author wrote, because
// the CONSTANT's own initialiser aborted first, carrying num.zen's
// position. A trap must name where the program went wrong, so a
// declaration merely read may not be where it points.
negate_kind = (be: CBackend, u: Unary, prim: str) NegKind {
    is_c_integer(prim).match({
        false => NegKind.Float,
        true  => be.int_digits(u.operand).match({
            Ok(digits) => NegKind.Folded(digits),
            None       => NegKind.Checked,
        }),
    })
}

// The digits of an integer literal, when the operand IS one. Written
// without unwrapping parens: `-(1)` is a negation of a parenthesised
// expression and stays one, which keeps the fold to the form the
// grammar makes a constant.
int_digits = (be: CBackend, id: ExprId) Res<str> {
    be.tree.expr_at(id).kind.match({
        Literal(l) => literal_digits(l),
        _          => None,
    })
}

literal_digits = (l: Literal) Res<str> {
    l.kind.match({ Int => Ok(l.text), _ => None })
}

// THERE IS NO NEGATIVE LITERAL IN C. `-<digits>` is unary minus over a
// POSITIVE constant, and `i64.MIN`'s magnitude is `i64.MAX + 1` — no
// signed C type holds it, so the negation would happen unsigned and
// reach `int64_t` by conversion. <stdint.h> spells INT64_MIN as a
// difference for the same reason, and so does this. Every narrower
// `MIN` has a magnitude a signed constant already holds.
I64_MIN_DIGITS: str = "9223372036854775808"
I64_MIN_C: str = "(-9223372036854775807LL - 1LL)"

write_negative_literal = (digits: str, out :: String) Res<(), AllocError> {
    digits.eq(I64_MIN_DIGITS).match({
        true  => out.add(I64_MIN_C),
        false => write_neg(digits, out),
    })
}

write_neg = (digits: str, out :: String) Res<(), AllocError> {
    out.fmt("(-{digits})")
}

negate_checked = (
    be   :: CBackend,
    node : Expr,
    u    : Unary,
    prim : str,
    ctx  : Ctx,
    ty   : TyId,
    out  :: String
) Res<(), AllocError> {
    pos ::= be.alloc.String().try();
    be.write_position(node.span.file, u.op_span, pos).try();
    be.need_helpers(prim).try();
    out.fmt("zg_sub_{prim}(0, ").try();
    expr(be, u.operand, ctx, ty, out).try();
    out.fmt(", {})", pos.view()).try();
    Ok(());
}

lower_binary* = (
    be   :: CBackend,
    node : Expr,
    b    : Binary,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    operand = be.level_type(b, ctx, want).try();
    be.op_kind(b, operand).match({
        ShortCircuit => be.write_short_circuit(b, operand, ctx, out),
        Infix        => be.write_infix(b, c_op(b.op), ctx, operand, out),
        Helper(prim) => be.call_helper(node, b, prim, ctx, operand, out),
        Dispatched   => be.lower_eq_op(b, ctx, operand, out),
        Refused      => be.unsupported(
            b.lhs,
            "comparing values that are not scalars",
            out
        ),
    })
}

// WHAT AN OPERATOR EVALUATES TO, when sema could not say.
// `&&`, `||`, and every comparison are `bool` whatever they were given;
// everything else is the operands' own type (`operand_type` below).
// What reaches here is an operand sema could NOT type — e.g. a field
// hanging off `alloc.create<T>()`, whose chain is the backend's answer,
// not the memo's. `println("{}", a.n + b.n)` is where it shows: no
// expectation to fall back on, so an unanswered `+` is a refusal by
// type.
binary_type* = (be :: CBackend, b: Binary, ctx: Ctx, want: TyId)
               Res<TyId, AllocError> {
    (is_logical(b.op) || is_comparison(b.op)).match({
        true  => be.check.types.bool_ty(),
        false => be.operand_answer(b, ctx, want),
    })
}

// The left operand, then the right: an arithmetic operator's operands
// are one type, so either may be the one this backend can answer.
operand_answer = (be :: CBackend, b: Binary, ctx: Ctx, want: TyId)
                 Res<TyId, AllocError> {
    lhs = be.ty_of(b.lhs, ctx, want).try();
    be.usable(lhs).match({
        true  => Ok(lhs),
        false => be.ty_of(b.rhs, ctx, want),
    })
}

is_comparison* = (op: BinOp) bool {
    op.match({
        Equal => true, NotEqual => true, Less => true, LessEq => true,
        Greater => true, GreaterEq => true,
        _ => false,
    })
}

// EVERY WAY A BINARY OPERATOR IS WRITTEN. The order `op_kind` asks
// these in is the language's rule and not an implementation detail, so
// it is one list here rather than the shape of a five-link call chain.
OpKind = ShortCircuit | Infix | Helper(str) | Dispatched | Refused

// `&&` and `||` short-circuit, so a right operand needing statements of
// its own cannot be lowered as an infix operand: the statements would
// run whether or not the left side held.
// THE SECOND CONDITION IS #737's GATE MEETING THIS ONE, and it took a
// parity run to see why it must. Holding an operand HOISTS STATEMENTS
// (`value_held` -> `spill_valued`); an `&&`/`||` written as plain C
// infix runs its RIGHT side under C's own guard -- so a hoisted LEFT
// lands BESIDE the guard, executing what Zen only promised conditionally.
// `matched = matched && self.text.index(from + i) == ..` in a loop
// trapped on out-of-range once the left `index` was hoisted above the
// `&&` (three `corpus/lsp/*` red). When EITHER side holds, the pair is
// written through the if-form instead: the left fills its temporary
// ahead of the branch, the right's statements stay INSIDE it.
// THE QUESTION IS `spills_anywhere`, NOT `spills` — a wrong answer, not
// just a refusal, hinges on it. `spills` asks whether the operand IS a
// spilling form; `expr` now spills a nested one into a temporary, so
// `a && (half(n).try() > 1)` (rhs is a comparison, not a `.try()`)
// would have its `.try()` hoisted beside the left and fire when `a` was
// false. The bootstrapper and this backend once disagreed by exactly
// that — caught by a differential run.
// SO IT IS WRITTEN OUT: a temporary the left fills, and the right
// fills AGAIN under an `if` — C's own `&&`, with statements where they
// belong. The right operand's statements land inside the branch, so a
// `.try()` there returns only on the pass that reached it — the
// guarantee the hoist broke.
// The infix form stays for the common case: `a && b` on two pure
// operands is `a && b`, not three statements and a temporary in front
// of the C compiler on every comparison in the tree.
// Comparison is C's on a scalar, an IMPL'S otherwise — the header's
// second rule. `s == "impl"` on a `str` is `str`'s `Eq`, impl'd by
// `std.text`.
// ORDERING IS NOT COVERED, refused by name: "there is no `Ord`.
// `std.core` has `Eq` and `Hash` and nothing that orders" — inventing
// one here would be this backend deciding a language question.
// A type that impls no `Eq`, and every ORDERING, are refused for the
// same reason: there is nothing to dispatch to.
// `corpus/gen_zen/reports_what_it_cannot_lower` gates it on a struct
// with no impl.
// EARLY RETURN OVER A CHAIN — `lsp_reply.zen:request_of`'s idiom: the
// one-shot loop is a breakable block, each rung one guard answering the
// one kind it names, the last break the answer to everything else. A
// rung is asked only after every rung above it said no, which is what
// holds the boundaries where the nested matches had them — and `&&`
// asks the right-hand question only when the left held, so
// `spills_anywhere`, `scalar`, and `prim_name` are asked exactly when
// they were before.
op_kind = (be: CBackend, b: Binary, operand: TyId) OpKind {
    found: Res<OpKind> = loop<OpKind>((h) {
        (is_logical(b.op)
            && (be.spills_anywhere(b.rhs) || be.infix_operand_held(b)))
            .then(() { h.break(OpKind.ShortCircuit) });
        is_logical(b.op).then(() { h.break(OpKind.Infix) });
        (is_comparison(b.op) && be.scalar(operand))
            .then(() { h.break(OpKind.Infix) });
        (is_comparison(b.op) && is_equality(b.op))
            .then(() { h.break(OpKind.Dispatched) });
        is_comparison(b.op).then(() { h.break(OpKind.Refused) });
        h.break(arith_kind(be.check.prim_name(operand)));
    });
    found.match({
        Ok(one) => one,
        None    => arith_kind(be.check.prim_name(operand)),
    });
}

// The header's first rule, at the site: an after-the-fact test is one
// the optimizer is entitled to delete. Only integer arithmetic goes
// through a trap helper, which the spine reads off a level rather than
// reaching through `lower_binary` — so this answers a kind and writes
// nothing.
arith_kind = (prim: str) OpKind {
    is_c_integer(prim).match({
        true  => OpKind.Helper(prim),
        false => OpKind.Infix,
    })
}

// `a && b` becomes
//     bool zg_tN;
//     zg_tN = <a>;
//     if (zg_tN) { <b's statements> zg_tN = <b>; }
// and `a || b` the same with the test negated. The left is lowered
// FIRST and into a temporary of its own, because `<a>` may itself have
// statements and they must land ahead of the branch rather than inside
// it.
write_short_circuit = (
    be      :: CBackend,
    b       : Binary,
    bool_ty : TyId,
    ctx     : Ctx,
    out     :: String
) Res<(), AllocError> {
    lhs ::= be.alloc.String().try();
    expr(be, b.lhs, ctx, bool_ty, lhs).try();
    tmp ::= be.init_temp(bool_ty, "b", lhs.view()).try();
    be.open_guard(b.op, tmp.view()).try();
    rhs ::= be.alloc.String().try();
    expr(be, b.rhs, ctx, bool_ty, rhs).try();
    be.set_line(tmp.view(), rhs.view()).try();
    be.dedent();
    be.writeln("}").try();
    out.add(tmp.view())
}

// `&&` runs its right operand when the left HELD; `||` when it did not.
open_guard = (be :: CBackend, op: BinOp, tmp: str) Res<(), AllocError> {
    be.fmt("if ({}{tmp}) {\n", negation(op)).try();
    be.indent();
    Ok(());
}

negation = (op: BinOp) str {
    op.match({ Or => "!", _ => "" })
}

// The operands' type, which is not the expression's when the operator
// is a comparison: `a == b` is `bool` whatever it compares.
operand_type = (be :: CBackend, b: Binary, ctx: Ctx, want: TyId)
               Res<TyId, AllocError> {
    lhs = sub(be, be.check.type_of(b.lhs, ctx).try()).try();
    be.usable(lhs).match({
        true  => Ok(lhs),
        false => be.rhs_type(b, ctx, want),
    })
}

rhs_type = (be :: CBackend, b: Binary, ctx: Ctx, want: TyId)
           Res<TyId, AllocError> {
    rhs = sub(be, be.check.type_of(b.rhs, ctx).try()).try();
    be.usable(rhs).match({
        true  => Ok(rhs),
        false => Ok(want),
    })
}

usable = (be :: CBackend, id: TyId) bool {
    be.check.is_unknown(id).match({
        true  => false,
        false => be.check.is_literal_ty(id) == false,
    })
}

// `!=` is the same call negated. There is no `ne` to write — DESIGN.md
// names `Eq` and one method — so the negation is the operator's and
// never the impl's.
lower_eq_op = (
    be      :: CBackend,
    b       : Binary,
    ctx     : Ctx,
    operand : TyId,
    out     :: String
) Res<(), AllocError> {
    text ::= be.alloc.String().try();
    wrote = be.lower_eq_call(b.lhs, b.rhs, operand, ctx, text).try();
    wrote.match({
        false => be.unsupported(
            b.lhs,
            "comparing values that are not scalars",
            out
        ),
        true  => be.write_equality(b.op, text.view(), out),
    })
}

write_equality = (be :: CBackend, op: BinOp, text: str, out :: String)
                 Res<(), AllocError> {
    is_negated(op).then(() { out.add("!").try() });
    out.fmt("({text})").try();
    Ok(());
}

is_equality = (op: BinOp) bool {
    op.match({ Equal => true, NotEqual => true, _ => false })
}

is_negated = (op: BinOp) bool {
    op.match({ NotEqual => true, _ => false })
}

scalar = (be: CBackend, id: TyId) bool {
    be.check.types.at(id).match({
        Prim(p) => p.name.eq("str") == false && p.name.eq("()") == false,
        _       => false,
    })
}

write_infix = (
    be      :: CBackend,
    b       : Binary,
    op      : str,
    ctx     : Ctx,
    operand : TyId,
    out     :: String
) Res<(), AllocError> {
    out.add("(").try();
    be.lower_lhs(b.lhs, be.infix_operand_held(b), ctx, operand, out).try();
    be.close_infix(b, op, ctx, operand, out)
}

// The left operand, walked as a spine only when there IS one.
// THE TEST IS HERE, NOT INSIDE `spine_lhs` — not a micro-optimisation:
// the walk holds a `Vec` and a cursor, a far fatter frame than the one
// recursive call it replaces. Under every `+` and `==` in the tree that
// costs depth other constructs need — measured, nested `.match` lost a
// third of its headroom to exactly that. A non-operator operand takes
// the path it always took.
// `held` IS THE OPERAND-ORDER GATE (#737): true lowers the left operand
// into a temporary ahead of the operator's text — the transform an
// argument takes through `value_held` — so it RUNS before the right one,
// where C's own order for two operands of one expression is the C
// compiler's to pick and gcc picks right to left. The right operand may
// stay inline: nothing follows it.
lower_lhs = (
    be   :: CBackend,
    id   : ExprId,
    held : bool,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    spine_ahead(be, id, held).match({
        false => be.value_held(id, ctx, want, held, out),
        true  => be.spine_lhs(id, ctx, want, out),
    })
}

// A level folds only when its own left operand stays inline: the spine
// writes the operator text first (`open_rung`) and the base last, which
// would put a temporary AFTER the operator it must precede. Such a left
// is handed back to `expr`, which spills it in place, and the levels
// above still fold — recursion is bounded by the held operands, not the
// chain's length.
spine_ahead = (be: CBackend, id: ExprId, held: bool) bool {
    held.match({
        true  => false,
        false => be.binary_ahead(id),
    })
}

binary_ahead = (be: CBackend, id: ExprId) bool {
    be.tree.expr_at(id).kind.match({
        Binary(_) => true,
        _         => false,
    })
}

// Everything after the left operand. Split out because the spine walk
// below writes the two halves of a level at opposite ends of its two
// passes, and the bytes may only be written down once.
close_infix = (
    be      :: CBackend,
    b       : Binary,
    op      : str,
    ctx     : Ctx,
    operand : TyId,
    out     :: String
) Res<(), AllocError> {
    out.fmt(" {op} ").try();
    expr(be, b.rhs, ctx, operand, out).try();
    out.add(")").try();
    Ok(());
}

c_op* = (op: BinOp) str {
    op.match({
        Add => "+", Sub => "-", Mul => "*", Div => "/", Rem => "%",
        AddWrap => "+", SubWrap => "-", MulWrap => "*",
        Equal => "==", NotEqual => "!=",
        Less => "<", LessEq => "<=", Greater => ">", GreaterEq => ">=",
        And => "&&", Or => "||",
    })
}

// The helper an operator goes through. `+ - *` trap, `/ %` trap on a
// zero divisor and on `MIN / -1`, and the wrapping forms do neither.
helper_stem* = (op: BinOp) str {
    op.match({
        Add => "add", Sub => "sub", Mul => "mul",
        Div => "div", Rem => "mod",
        AddWrap => "wadd", SubWrap => "wsub", MulWrap => "wmul",
        _ => "",
    })
}

traps* = (op: BinOp) bool {
    op.match({
        AddWrap => false, SubWrap => false, MulWrap => false,
        _ => true,
    })
}

call_helper = (
    be      :: CBackend,
    node    : Expr,
    b       : Binary,
    prim    : str,
    ctx     : Ctx,
    operand : TyId,
    out     :: String
) Res<(), AllocError> {
    open_helper(be, b, prim, out).try();
    be.lower_lhs(b.lhs, be.infix_operand_held(b), ctx, operand, out).try();
    close_helper(be, node, b, ctx, operand, out)
}

open_helper = (be :: CBackend, b: Binary, prim: str, out :: String)
              Res<(), AllocError> {
    be.need_helpers(prim).try();
    out.fmt("zg_{}_{prim}(", helper_stem(b.op))
}

close_helper = (
    be      :: CBackend,
    node    : Expr,
    b       : Binary,
    ctx     : Ctx,
    operand : TyId,
    out     :: String
) Res<(), AllocError> {
    out.add(", ").try();
    expr(be, b.rhs, ctx, operand, out).try();
    // `.match` and not `.then`: a `.then` closure capturing more than
    // one of its enclosing parameters is inlined with the receiver
    // substituted into the wrong argument slot, which `cc` catches and
    // docs/GEN_BOOTSTRAP_FIXES.md records.
    traps(b.op).match({
        true  => be.write_trap_args(node, b, out),
        false => Ok(()),
    }).try();
    out.add(")").try();
    Ok(());
}

write_trap_args = (be :: CBackend, node: Expr, b: Binary, out :: String)
                  Res<(), AllocError> {
    out.add(", ").try();
    be.write_position(node.span.file, b.op_span, out).try();
    Ok(());
}

// the spine
// `a + b + c + ..` is `((a + b) + c) ..`, and `parse_expr.zen` builds
// it with a LOOP (`binary_from` folds each operator onto the left in
// place), so nothing bounds a chain's length. Recursing into `b.lhs`
// is three C frames per term; `tests/corpus/lex/long_single_line.zen`
// is ten thousand terms — eight megabytes of stack, then a
// segmentation fault with no diagnostic. "A crash is not a diagnostic"
// (docs/TESTING.md); `bootstrap/gen_c.py`'s `ex_Binary` handles this
// the same way, in a loop.
// THE BYTES OF A LEFT SPINE ARE ALREADY IN TWO HALVES:
//     zg_add_i32(zg_add_i32(0, 1, "f", 1, 9), 1, "f", 1, 13)
//     ^^^^^^^^^^^^^^^^^^^^^^ ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//       opens, outermost in    base   closes, innermost out
// so levels are collected with a cursor and written in two passes
// instead of n nested calls. Operand type still travels DOWN the
// spine, operands are still written left to right, and each one's
// spilled statements land in the same order — so this emits the same
// bytes the recursion did, which `make determinism` proves. One
// addition since: a level whose left operand is HELD (#737) does not
// fold (`spine_ahead`), so the temporary lands ahead of the operator's
// text rather than after it.
// A LEVEL THAT DOES NOT FOLD ENDS THE WALK and is handed back to
// `expr`: every door out of `expr` that isn't a plain value (a union
// tag, a hoist, a fat record), plus the two operators not written as
// open-operand-operand-close (a dispatching `==`, a `&&` whose right
// side spills), plus now a held left operand. Those nest only as deep
// as the parser let them or the gate holds, so recursion is bounded
// there.

// One level of the spine. `id` is the operator node and `operand` the
// type its operands lower at; the node is re-read rather than stored
// because a rung is kept for every term of a ten-thousand-term line.
Rung = {
    id: ExprId,
    lhs: ExprId,
    operand: TyId,
    folds: bool,
}

// The left operand of an operator, written without recursing down the
// spine below it.
spine_lhs = (
    be   :: CBackend,
    id   : ExprId,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    rungs ::= be.alloc.Vec<Rung>();
    down  ::= id;
    hint  ::= want;
    going ::= true;
    // The rung that does NOT fold is pushed too, and is what leaves
    // `down` and `hint` naming the base and the type it is wanted at.
    going.loop((h) {
        rung = be.rung_at(down, ctx, hint).try();
        rungs.add(rung).try();
        going = rung.folds;
        down  = rung.lhs;
        hint  = rung.operand;
    });
    folded = rungs.len - 1;
    Range(0, folded).loop((h, i) { be.open_rung(rungs, i, out).try(); });
    expr(be, down, ctx, hint, out).try();
    Range(0, folded).loop((h, i) {
        be.close_rung(rungs, folded - 1 - i, ctx, out).try();
    });
    Ok(());
}

// A node folds when `expr` would have reached `lower_binary` for it
// and `lower_binary` would have written it as open-operand-operand-
// close. Anything else answers a rung that stops the walk, naming
// itself as the base.
rung_at = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId)
          Res<Rung, AllocError> {
    be.tree.expr_at(id).kind.match({
        Binary(b) => be.binary_rung(id, b, ctx, want),
        _         => Ok(base_rung(id, want)),
    })
}

base_rung = (id: ExprId, want: TyId) Rung {
    Rung(id: id, lhs: id, operand: want, folds: false)
}

// `expr`'s doors, asked in its own order: a value whose type is a
// member of a wanted set, a form that hoists, a value reaching a
// bound. `spills` is not asked because no `Binary` is a spill.
binary_rung = (be :: CBackend, id: ExprId, b: Binary, ctx: Ctx, want: TyId)
              Res<Rung, AllocError> {
    plain = (be.needs_set(id, ctx, want).try() == false)
        && (be.needs_hoist(id, ctx, want).try() == false)
        && (be.needs_fat(id, ctx, want).try() == false);
    plain.match({
        false => Ok(base_rung(id, want)),
        true  => be.operand_rung(id, b, ctx, want),
    })
}

operand_rung = (be :: CBackend, id: ExprId, b: Binary, ctx: Ctx, want: TyId)
               Res<Rung, AllocError> {
    operand = be.level_type(b, ctx, want).try();
    be.infix_shaped(b, operand).match({
        false => Ok(base_rung(id, want)),
        true  => Ok(Rung(id: id, lhs: b.lhs, operand: operand, folds: true)),
    })
}

// What `lower_binary` will lower this level's OPERANDS at: `bool` for
// the two short-circuiting operators, which take their type from the
// operator and not from what they were given; a comparison's operands'
// own reading (`comparison_level` below); everything else the operands'
// joined type with `want` as the last resort.
level_type = (be :: CBackend, b: Binary, ctx: Ctx, want: TyId)
             Res<TyId, AllocError> {
    is_logical(b.op).match({
        true  => be.check.types.bool_ty(),
        false => be.plain_level(b, ctx, want),
    })
}

plain_level = (be :: CBackend, b: Binary, ctx: Ctx, want: TyId)
              Res<TyId, AllocError> {
    is_comparison(b.op).match({
        true  => be.comparison_level(b, ctx, want),
        false => be.operand_type(b, ctx, want),
    })
}

// A COMPARISON'S OPERANDS LOWER AT THEIR OWN TYPES, never at `want`.
// Up here a comparison's `want` is the bool the comparison PRODUCES --
// the print sugar's argument type, a binding's slot type -- and an
// operand handed it declared its spill temporary at `bool`. So
// `true.match({ true => 300, false => 102 }) > 299` stored both arms
// into one byte, read 1 back, and answered 1 > 299 (issue #724): exit
// 0, a plausible false, every branch such a comparison picks chosen
// wrongly. Arithmetic never met this because its result type IS its
// operand type; a comparison's is not.
// Sema has already agreed the whole program by the time gen_c runs, so
// an operand's own reading wins -- taken verbatim, literal spelling
// included: two unsuffixed literals are `int` (`c_prim` spells it
// int64_t), the same answer `sema_join.arith_type` gives the pair when
// nothing settles it, and C's usual conversions settle the rest at the
// operator itself. Only when SEMA ANSWERED NOTHING (`Unknown`, a call
// result through std) is `want` still the hint -- and a spilling form
// standing there is refused as unsettled rather than lowered at it, so
// this fallback cannot pick a wrong width silently.
comparison_level = (be :: CBackend, b: Binary, ctx: Ctx, want: TyId)
                   Res<TyId, AllocError> {
    lhs = sub(be, be.check.type_of(b.lhs, ctx).try()).try();
    be.usable(lhs).match({
        true  => Ok(lhs),
        false => be.comparison_rhs(b, ctx, want),
    })
}

comparison_rhs = (be :: CBackend, b: Binary, ctx: Ctx, want: TyId)
                 Res<TyId, AllocError> {
    rhs = sub(be, be.check.type_of(b.rhs, ctx).try()).try();
    be.check.is_unknown(rhs).match({
        true  => Ok(want),
        false => Ok(rhs),
    })
}

// The two that are not written as open-operand-operand-close, named in
// the spine banner above.
infix_shaped = (be: CBackend, b: Binary, operand: TyId) bool {
    be.op_kind(b, operand).match({
        Infix     => true,
        Helper(_) => true,
        _         => false,
    })
}

// The two halves of one level, re-derived from the node. The `_` arms
// cannot be reached — a rung that folds was built from a `Binary` —
// and write nothing rather than inventing a diagnostic for a case that
// does not arise.
open_rung = (be :: CBackend, rungs: Vec<Rung>, at: usize, out :: String)
            Res<(), AllocError> {
    rungs.get(at).match({
        None     => Ok(()),
        Ok(rung) => be.tree.expr_at(rung.id).kind.match({
            Binary(b) => be.open_op(b, rung.operand, out),
            _         => Ok(()),
        }),
    })
}

close_rung = (
    be    :: CBackend,
    rungs : Vec<Rung>,
    at    : usize,
    ctx   : Ctx,
    out   :: String
) Res<(), AllocError> {
    rungs.get(at).match({
        None     => Ok(()),
        Ok(rung) => be.close_node(be.tree.expr_at(rung.id), rung, ctx, out),
    })
}

close_node = (
    be   :: CBackend,
    node : Expr,
    rung : Rung,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    node.kind.match({
        Binary(b) => be.close_op(node, b, rung.operand, ctx, out),
        _         => Ok(()),
    })
}

open_op = (be :: CBackend, b: Binary, operand: TyId, out :: String)
          Res<(), AllocError> {
    be.op_kind(b, operand).match({
        Helper(prim) => open_helper(be, b, prim, out),
        _            => out.add("("),
    })
}

close_op = (
    be      :: CBackend,
    node    : Expr,
    b       : Binary,
    operand : TyId,
    ctx     : Ctx,
    out     :: String
) Res<(), AllocError> {
    be.op_kind(b, operand).match({
        Helper(_) => close_helper(be, node, b, ctx, operand, out),
        _         => be.close_infix(b, c_op(b.op), ctx, operand, out),
    })
}

// `"file", line, col` — the three arguments every trap takes. The
// position is the OPERATOR token, and the file is relative to the
// compilation root, which is what makes two checkouts of one tree emit
// the same bytes.
write_position* = (be :: CBackend, file: str, span: Span, out :: String)
                  Res<(), AllocError> {
    out.fmt("\"{file}\", ").try();
    out.write_usize(span.start.line).try();
    out.add(", ").try();
    out.write_usize(span.start.col).try();
    Ok(());
}
