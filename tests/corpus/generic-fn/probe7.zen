// PROBE 7b: does the zero reproduce WITHOUT println? Write the value into a
// struct field and read it back.
Box = { v: u8 }
Big = { v: u64 }

main = (env: Env) Res<i32, AllocError> {
    x = Box(v: u8(200));
    y = Box(v: 201);
    println("field-from-call {}", x.v);
    println("field-literal {}", y.v);

    z = Big(v: 4000000002);
    println("big-field {}", z.v);
    Ok(0);
}
