// tests/corpus/std/loop_filter_allocates.zen
// filter also allocates, and says so. its predicate takes only the
// value: there is no handle, because a filter that could break is
// a find

LoopError = | NoResult

main = (env: Env) Res<i32, LoopError> {
    alloc ::= env.mem.alloc();

    evens = Range(0, 6).filter(alloc, (value) {
        value % 2 == 0
    }).ok_or(LoopError.NoResult).try();

    evens.loop((h, n) {
        println("{}", n);
    })

    // nothing matches: an empty Vec, not a None
    nothing = Range(0, 6).filter(alloc, (value) {
        value > 99
    }).ok_or(LoopError.NoResult).try();

    println("len {}", nothing.len);
    Ok(0);
}
