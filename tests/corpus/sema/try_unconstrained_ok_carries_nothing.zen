// A bare `Ok(..)` raises nothing, so its error set is an open `_` with
// nothing in it. Propagating THAT into a `Res<T>` whose failure is an
// absence is not a conversion -- it is the absence of one.
//
// Rejecting it made the natural spelling of a fallible walk illegal in
// every function that fails by absence rather than by reason, which is
// most of the ones a compiler writes.
pick = (n: usize) Res<usize> {
    v = Ok(n + 1).try();
    Ok(v * 2);
}

main = (env: Env) Res<i32, ArgError> {
    pick(3).match({ Ok(v) => println("{}", v), None => println("none") });
    Ok(0);
}
