Decl, Enum, Variant = std.ast
AllocError = std.mem
Vec = std.collections
str = std.text
DeclId = sema.sema_id
TyId, TyNamed, TyUnion = sema.sema_ty
Def, decl_at, has_variant = sema.sema_def
Checker = sema.sema_check
enum_has_discriminants = sema.sema_discriminant

named_or_union* = (c :: Checker, d: Def, args: Vec<TyId>)
                  Res<TyId, AllocError> {
    id = c.types.named(d.id, d.qname, d.name, args).try();
    c.record_set(id, d.id).try();
    Ok(id);
}

record_set = (c :: Checker, id: TyId, decl: DeclId) Res<(), AllocError> {
    c.set_memo.get(id).match({
        Ok(_) => Ok(()),
        None  => c.record_if_union(id, decl),
    })
}

record_if_union = (c :: Checker, id: TyId, decl: DeclId)
                  Res<(), AllocError> {
    c.union_reading(decl).match({
        false => Ok(()),
        true  => c.compute_set(id, decl),
    })
}

compute_set = (c :: Checker, id: TyId, decl: DeclId) Res<(), AllocError> {
    c.set_memo.set(id, id).try();
    members ::= c.alloc.Vec<TyId>();
    c.collect_members(decl, members).try();
    set = c.types.union_ty(members).try();
    c.set_memo.set(id, set).try();
    Ok(());
}

collect_members = (c :: Checker, decl: DeclId, out :: Vec<TyId>)
                  Res<(), AllocError> {
    decl_at(c.tree, decl).match({
        None  => Ok(()),
        Ok(d) => c.decl_members(decl, d, out),
    })
}

decl_members = (c :: Checker, decl: DeclId, d: Decl, out :: Vec<TyId>)
               Res<(), AllocError> {
    d.kind.match({
        Enum(e) => c.enum_members(decl, e, out),
        _       => Ok(()),
    })
}

enum_members = (c :: Checker, decl: DeclId, e: Enum, out :: Vec<TyId>)
               Res<(), AllocError> {
    e.variants.loop((h, v) {
        out.add(c.variant_member_type(decl, v.name.text).try()).try();
    });
    Ok(());
}

union_member* = (c :: Checker, decl: DeclId, name: str)
                Res<TyId, AllocError> {
    found ::= c.alloc.Vec<Def>();
    c.world.defs_of(decl.module.to_usize(), name, found).try();
    found.get(0).match({
        None  => c.types.unknown(),
        Ok(d) => c.member_named(d),
    })
}

member_named = (c :: Checker, d: Def) Res<TyId, AllocError> {
    empty ::= c.alloc.Vec<TyId>();
    c.named_or_union(d, empty)
}

// Resolve a member before reading its flattened set so containment is
// independent of declaration order.
variant_member_type = (c :: Checker, decl: DeclId, name: str)
                      Res<TyId, AllocError> {
    id = c.union_member(decl, name).try();
    Ok(c.set_of(id));
}

union_carrier* = (c :: Checker, ty: TyId, name: str) Res<TyId, AllocError> {
    c.types.at(ty).match({
        Named(n) => c.named_carrier(n, name),
        _        => c.types.unknown(),
    })
}

named_carrier = (c :: Checker, n: TyNamed, name: str) Res<TyId, AllocError> {
    (c.union_reading(n.decl) && c.decl_has_variant(n.decl, name)).match({
        true  => c.union_member(n.decl, name),
        false => c.types.unknown(),
    })
}

member_of* = (c :: Checker, ty: TyId, name: str) Res<TyId> {
    c.types.at(ty).match({
        Union(u) => c.union_member_named(u, name),
        Named(n) => c.named_member_of(ty, n, name),
        _        => None,
    })
}

union_member_named = (c :: Checker, u: TyUnion, name: str) Res<TyId> {
    u.members.loop((h, i, m) {
        (c.member_declares(m, name) || c.member_is(m, name)).then(() { h.break(c.set_of(m)) });
    })
}

named_member_of = (c :: Checker, ty: TyId, n: TyNamed, name: str)
                  Res<TyId> {
    wide = c.set_of(ty);
    c.types.at(wide).match({
        Union(u) => c.union_member_named(u, name),
        _        => None,
    })
}

member_declares = (c :: Checker, m: TyId, variant: str) bool {
    c.types.at(m).match({
        Named(n) => c.decl_has_variant(n.decl, variant),
        _        => false,
    })
}

member_is = (c :: Checker, m: TyId, name: str) bool {
    c.types.at(m).match({
        Named(n) => c.decl_is_named(n.decl, name),
        _        => false,
    })
}

decl_is_named = (c :: Checker, decl: DeclId, name: str) bool {
    decl_at(c.tree, decl).match({
        None  => false,
        Ok(d) => decl_kind_names(d, name),
    })
}

decl_kind_names = (d: Decl, name: str) bool {
    d.kind.match({
        Enum(e)  => e.name.text.eq(name),
        Alias(x) => x.name.text.eq(name),
        _        => false,
    })
}

decl_has_variant = (c :: Checker, decl: DeclId, name: str) bool {
    decl_at(c.tree, decl).match({
        None  => false,
        Ok(d) => decl_names_variant(d, name),
    })
}

decl_names_variant = (d: Decl, name: str) bool {
    d.kind.match({
        Enum(e) => e.has_variant(name),
        _       => false,
    })
}

union_reading* = (c :: Checker, decl: DeclId) bool {
    decl_at(c.tree, decl).match({
        None  => false,
        Ok(d) => c.enum_union_reading(decl, d),
    })
}

enum_union_reading = (c :: Checker, decl: DeclId, d: Decl) bool {
    d.kind.match({
        Enum(e) => e.enum_has_discriminants().match({
            true  => false,
            false => c.no_nominal_variant(decl, e),
        }),
        _       => false,
    })
}

// Fewer than two variants is nominal; a one-member union is just that type.
no_nominal_variant = (c :: Checker, decl: DeclId, e: Enum) bool {
    (e.variants.len < 2).match({
        true  => false,
        false => c.every_variant_named(decl, e),
    })
}

every_variant_named = (c :: Checker, decl: DeclId, e: Enum) bool {
    e.variants.find((v) { !c.names_a_type(decl, v) })
        .match({ Ok(_) => false, None => true })
}

names_a_type = (c :: Checker, decl: DeclId, v: Variant) bool {
    v.payload.match({
        Ok(_) => false,
        None  => c.world.defines(decl.module.to_usize(), v.name.text),
    })
}
