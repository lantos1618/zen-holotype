// DESIGN.md writes generic functions BOTH ways:
//   scale* = <T: Rect>(shape: T, k: f64) f64 { .. }
//   DumpAst<T> = (sb :: String, n: T) Res<(), IoError> { .. }
// both are attested, so both must parse. see the report: DESIGN.md
// never says they are the same thing.

identity = <T>(v: T) T { v }
pair_first<T> = (a: T, b: T) T { a }

main = (env: Env) Res<i32, ArgError> {
    println("{}", identity<i32>(7));
    println("{}", pair_first(8, 9));
    Ok(0);
}
