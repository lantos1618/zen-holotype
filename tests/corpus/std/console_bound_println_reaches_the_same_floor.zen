// DESIGN.md makes `println(..)` sugar for `<the Env in scope>.out.println(..)`
// resolved BY TYPE, so the two spellings name ONE call and must print the
// same bytes. The written form is not a corner: `drop` cannot use the sugar,
// because the sugar resolves the Env by type and inside `drop` the only
// binding is `self` -- so a type that prints as it dies carries an Env in a
// field and reaches the console exactly this way.
//
// Its value is the declared Res and not unit, which is what `.try()` here
// asserts: a console write has no failure to report, and the answer is Ok.

Holder = {
    env: Env,

    say* = (self: @Self, n: i32) Res<(), IoError> {
        self.env.out.println("held {}", n)
    }
}

main = (env: Env) Res<i32, IoError> {
    println("sugar {}", 1);
    env.out.println("bound {}", 2).try();
    Holder(env: env).say(3).try();
    Ok(0);
}
