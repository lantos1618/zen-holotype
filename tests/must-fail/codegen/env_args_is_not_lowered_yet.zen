// `env.args<T>()` IS A SIGNATURE WITH NO BODY, AND SAYS SO AT THE CALL.
//
// `std/env/env.zen` declares the typed argument parser and states its
// own stage in the comment above it: "filling the schema is an @meta
// walk over T's fields, outside the seed subset — body arrives with
// src/meta/meta.zen". The signature is DESIGN.md's and will not
// change; what does not exist is anything to run.
//
// THIS FILE EXISTS SO THAT ABSENCE IS LOUD. A capability whose body is
// missing has two failure modes and only one of them is survivable: a
// refusal at the call, or a program that builds and then answers with
// whatever a zeroed struct holds. `env.threads.sleep` is the second
// kind — it compiles clean and SIGSEGVs, pinned by
// `corpus/env/threads_sleep_crashes_issue_781`. `args` is the first,
// and this is the file that keeps it that way.
//
// IT GOES RED THE DAY THE PARSER LANDS, which is the point: delete it
// then and write the corpus test whose match shape
// `corpus/env/arg_error_names_the_field` already pins.
//
// position: the call to `args`.

ArgError = std.env

Cfg = {
    name: str,
    count: i64,
}

main = (env: Env) Res<i32, ArgError> {
    c = env.args<Cfg>().try();
    println("parsed");
    Ok(0)
}
