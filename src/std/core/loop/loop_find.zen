// src/std/core/loop/loop_find.zen
// Derived loop operations. find returns the first match without allocating;
// filter and map take an Alloc and return Vecs. Their distinct names avoid an
// overload collision with fold's generic accumulator parameter.
Res, Ok, None = std.core.result
then          = std.core.bool
Alloc         = std.mem
Vec           = std.collections
Range         = std.core.range
LoopHandle    = std.core.loop.loop_handle
loop          = std.core.loop.loop_iter

// first element the predicate accepts, or None. Predicate takes only
// the value — no handle, because a predicate that could break is a
// find, and this is it.
find*<R: Range<T>, T> = (range: R, pred: (value: T) bool) Res<T> {
    range.loop((h, value) {
        pred(value).then(() { h.break(value) });
    })
}

// Every accepted element in order. No matches yields an empty Vec; None means
// allocation failed.
filter*<R: Range<T>, T> = (range: R, alloc: Alloc, pred: (
    value : T
) bool) Res<Vec<T>> {
    kept ::= alloc.Vec<T>();
    room ::= true;
    range.loop((h, value) {
        pred(value).then(() {
            kept.add(value).match({
                Ok(_)  => (),
                Err(_) => { room = false; h.break(); },
            });
        });
    });
    room.match({
        true  => Ok(kept),
        false => None,
    })
}

// a value per element, collected into a Vec. The body takes the
// handle too, so a map may stop early — it keeps what it made, since
// reporting nothing would throw away work already done.
map*<R: Range<T>, T, U> = (range: R, alloc: Alloc, body: (
    h     : LoopHandle,
    index : usize,
    value : T
) U) Res<Vec<U>> {
    made ::= alloc.Vec<U>();
    room ::= true;
    range.loop((h, index, value) {
        made.add(body(h, index, value)).match({
            Ok(_)  => (),
            Err(_) => { room = false; h.break(); },
        });
    });
    room.match({
        true  => Ok(made),
        false => None,
    })
}
