// the baseline. `consume` moves, and the old binding is dead from
// the move onwards: drop runs exactly once, so two live names for
// one value would drop it twice.

Buf = {
    id: i32,
}

Buf.impl(Drop, {
    drop = (self :: @Self) () { /* nothing to release: id is bytes */ }
})

main = (env: Env) Res<i32, IoError> {
    f = Buf(id: 1);
    g = consume f;
    println("{}", f.id);
    println("{}", g.id);
    Ok(0);
}
