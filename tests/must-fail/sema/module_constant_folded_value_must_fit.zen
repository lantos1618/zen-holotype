// A CONSTANT'S FOLDED VALUE OWES THE WRITTEN TYPE THE SAME ANSWER A
// BARE LITERAL PAYS. `check_literal`'s fold walked only literal, paren
// and unary-minus forms, so a value behind one operator took `_ =>
// None` and `folded_within` read absence as acceptance: `SUM: i32 =
// 3000000000 + 234` compiled clean and printed -1294967062 -- two's
// complement through the i32 slot, the same printed lie
// `module_constant_value_must_fit` records for `UMINUS: u32 = -1`.
//
// The operator-level overflow rule cannot say this sentence: it fires
// against the OPERAND type, which at module scope is the unconstrained
// `int`, and 3000000234 fits an int. The written type beside the name
// is the only position that knows the value is wrong.
//
// The fold now reaches arithmetic over literal operands. It stops at
// exactly the same forms `const_int` folds -- no binding is read
// through, so the trap corpus's `i32.MAX`-through-a-variable stays a
// runtime test.
//
// position: the whole expression, matching where
// `module_constant_value_must_fit` puts the caret for the bare form.

SUM: i32 = 3000000000 + 234

main = (env: Env) Res<i32> {
    println("{}", SUM);
    Ok(0);
}
