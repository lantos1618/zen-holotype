// The same two spellings, and a different type: "two modules may define
// the same top-level name without colliding". This is the `Ring` alpha's
// alias would reach if its target were read anywhere but in alpha.
//
// `label` is NOT imported by main, and that is the point of it: a free
// function travels with its first parameter's type, so a `Marked` that
// wrongly WERE this `Ring` would find this `label` and print through it
// with nothing to report.
Ring* = Small | Large

label* = (r: Ring) str {
    r.match({
        Small => "beta small",
        Large => "beta large",
    });
}

// TAG READS ITS ARGUMENT. It used to answer one constant string, which
// made it a probe that could not answer wrong: a `Ring` whose variants
// had all collapsed to the first one, or whose tag never arrived at all,
// printed the same bytes. Now the variant it was handed is in the answer.
tag* = (r: Ring) str {
    r.match({
        Small => "beta tag small",
        Large => "beta tag large",
    });
}
