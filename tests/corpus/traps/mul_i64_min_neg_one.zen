// tests/corpus/traps/mul_i64_min_neg_one.zen
// i64.MIN * -1 traps: the product is i64.MAX + 1, which does not
// exist. i64.MIN is the one value whose negation is unrepresentable

// main must name an error type. a trap never lifts into Res:
// it aborts the process
Error = Overflow | DivideByZero | OutOfBounds

main = (env: Env) Res<i32, Error> {
    x: i64       = i64.MIN;
    neg_one: i64 = -1;
    product      = x * neg_one;
    println("{}", product);
    Ok(0);
}
