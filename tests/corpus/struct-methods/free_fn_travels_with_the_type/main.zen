// A FREE FUNCTION ON THE TYPE TRAVELS WITH THE TYPE ACROSS MODULES: main
// imports only `box`, declares nothing callable of its own, and still
// reaches Box's world through the dot -- the free function declared beside
// the type in box.zen, never imported, never re-declared here.
//
// DESIGN.md: "importing a type pulls its world along." The pull is what
// makes UFCS more than local syntax sugar. A resolver that gathers dot
// candidates from the CALLING module's scope only finds nothing -- and the
// failure mode is not a missing-import error on a bare name but "no
// `perimeter` on `Box`", which reads like a typo in the test rather than a
// dropped rule.
//
// The method half of the same rule lives on the type in the sibling lane's
// territory; this file pins the free-function half alone so a resolver that
// keeps one table for members and another for top-level exports fails here.
//
// Breaks if: travelled candidates stop at exported top-level names being
// imported explicitly -- `b.perimeter()` rejects with "no `perimeter` on
// `Box`" while everything else in the file compiles.

Box = box.box

main = (env: Env) Res<i32, AllocError> {
    b = Box(w: 3, h: 4);
    println("perimeter {}", b.perimeter());
    Ok(0);
}
