// A GENERIC type crosses the boundary and is instantiated at two
// widths in the importing file: `Box<i32>` and `Box<u64>`. box.zen
// never names either instantiation -- it only declares Box<T> -- so
// both monomorphisations are minted by the import alone, and `unwrap`
// is a generic free function imported beside the type.
//
// The u64 line prints u64.MAX on purpose: a mangled-name collision
// between the two instantiations (or an un-substituted T reaching the
// emitted C) makes one of these lines wrong in a way that STILL
// PRINTS. 9 + 9 pins that Box<i32>'s storage and unwrap's substitution
// agree; 18446744073709551615 pins that no truncation to i32 happened
// on the way through the boundary.
//
// One-line breaker: key monomorphisation on the file that USES the
// type instead of the file that DECLARES it -> two distinct C structs
// for one Box<i32>, and cc rejects the program.

Box = box.box
unwrap = box.box

main = (env: Env) Res<i32, IoError> {
    a = Box<i32>(value: 9);
    b = Box<u64>(value: 18446744073709551615);
    println("{} {}", a.value, unwrap(a));
    println("{}", b.value);
    Ok(0);
}
