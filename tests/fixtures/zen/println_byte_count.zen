// `print`/`println` are documented to return the number of BYTES written. Every one of the 13
// Display impls used to spell the body as two statements — the payload write, then `newline()` —
// so the payload's count was discarded and EVERY println returned 1.
//
// Exits 0 when each return value is the real byte count, 1 otherwise. The values printed above the
// verdict are deliberate: they are what makes the counts non-trivial to fake.
{ println, print } = std.text.fmt
{ then } = std.core.bool
main = () i32 {
    n := println(12345)    // "12345\n"
    s := println("abcde")    // "abcde\n"
    f := println(3.5)    // "3.5\n"
    e := println("")    // just "\n"
    p := print("ab")    // no newline
    ok := n == 6 && s == 6 && f == 4 && e == 1 && p == 2
    println("")
    ok.then({ 0 }, { 1 })
}
