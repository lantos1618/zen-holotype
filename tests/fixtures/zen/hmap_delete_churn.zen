// Adversarial delete churn for the swap-remove chain surgery: insert 200 keys, delete every even
// key (exercising head/mid/tail chain unlinks and last-entry moves), verify every survivor and
// every deleted key, reinsert the deleted half into the reused slots, verify again. Any chain
// mis-link shows up as a wrong count. All keys typed i64.
hm = std.collections.hmap
{ println } = std.text.fmt
halloc = std.mem.heap
main = () i32 {
    alloc := halloc.gpa()
    a := alloc.addr()
    seed: i64 := 0
    m := hm.of(a, seed, seed * 3).expect("of")
    i: i64 := 1
    @while (i < 200) {
        m = m.put(a, i, i * 3).expect("put")
        i = i + 1
    }
    println(m.len())    // 200
    i = 0
    @while (i < 200) {
        m = m.delete(i)
        i = i + 2
    }
    println(m.len())    // 100 — odds remain
    odd_ok: i64 := 0
    even_gone: i64 := 0
    i = 0
    @while (i < 200) {
        (i % 2 == 1).match ({ true => {
            (m.get_or(i, 0 - 1) == i * 3).match ({ true => {
                odd_ok = odd_ok + 1
            }, false => { } })
        }, false => {
            m.get(i).match ({
                .Some(v) => { },
                .None    => {
                    even_gone = even_gone + 1
                },
            })
        } })
        i = i + 1
    }
    println(odd_ok)    // 100
    println(even_gone)    // 100
    // reinsert the evens with new values into the freed slots
    i = 0
    @while (i < 200) {
        m = m.put(a, i, i * 7).expect("re-put")
        i = i + 2
    }
    println(m.len())    // 200 again
    all_ok: i64 := 0
    i = 0
    @while (i < 200) {
        want := (i % 2 == 1).match ({ true => i * 3, false => i * 7 })
        (m.get_or(i, 0 - 1) == want).match ({ true => {
            all_ok = all_ok + 1
        }, false => { } })
        i = i + 1
    }
    println(all_ok)    // 200
    m.free(a)
    0
}
