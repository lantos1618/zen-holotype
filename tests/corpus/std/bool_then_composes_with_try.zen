// tests/corpus/std/bool_then_composes_with_try.zen
// then lands in Res, so it composes: ok_or names the reason and
// .try() carries it out of the frame. this is the guard clause,
// written without a conditional

GuardError = | NotPositive

checked_double = (n: i32) Res<i32, GuardError> {
    v = (n > 0).then(() { n * 2 }).ok_or(GuardError.NotPositive).try();
    Ok(v);
}

main = (env: Env) Res<i32, GuardError> {
    println("{}", checked_double(3).try());

    checked_double(-3).match({
        Ok(n)  => println("{}", n),
        Err(_) => println("not positive"),
    });
    Ok(0);
}
