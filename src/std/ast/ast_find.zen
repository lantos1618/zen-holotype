// Resolve a byte position to the smallest covering AST node. Nodes are scanned
// from the arena's flat family lists; these queries do not allocate.
str = std.text
Pos, Span, nowhere = std.ast.ast_span
ExprId, TypeId, PatternId, BlockId = std.ast.ast_id
Ast = std.ast.ast_arena

// Typed reference to the arena family containing a result.
NodeRef* = ExprNode(ExprId)
    | TypeNode(TypeId)
    | PatternNode(PatternId)
    | BlockNode(BlockId)

// The smallest span seen so far that covers the cursor. A later candidate
// replaces it only when nested strictly inside it.
Nearest = {
    file: str,
    p: Pos,
    found :: Res<NodeRef> = None,
    span :: Span,

    offer = (self :: @Self, cand: Span, node: NodeRef) () {
        closer = cand.covers(self.file, self.p) && self.found.match({
            None  => true,
            Ok(_) => cand.inside(self.span),
        });
        closer.then(() {
            self.found = Ok(node);
            self.span  = cand;
        });
        ();
    }
}

// Smallest node of any family covering `p`; None for trivia or positions
// outside all nodes.
node_at* = (tree: Ast, file: str, p: Pos) Res<NodeRef> {
    best ::= Nearest(file: file, p: p, span: nowhere());
    tree.exprs_each((id, ex) { best.offer(ex.span, NodeRef.ExprNode(id)); });
    tree.types_each((id, ty) { best.offer(ty.span, NodeRef.TypeNode(id)); });
    tree.patterns_each((id, pat) {
        best.offer(pat.span, NodeRef.PatternNode(id));
    });
    tree.blocks_each(
        (id, blk) { best.offer(blk.span, NodeRef.BlockNode(id)); }
    );
    best.found
}

// Smallest expression covering `p`, independent of smaller type nodes.
expr_node_at* = (tree: Ast, file: str, p: Pos) Res<ExprId> {
    best ::= Nearest(file: file, p: p, span: nowhere());
    tree.exprs_each((id, ex) { best.offer(ex.span, NodeRef.ExprNode(id)); });
    best.found.match({
        Ok(ExprNode(id)) => Ok(id),
        _                => None,
    })
}
