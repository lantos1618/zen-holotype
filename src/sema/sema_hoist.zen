// src/sema/sema_hoist.zen
// What lifts into a `Res`, and what does not.
//
// DESIGN.md: "hoisting: a bare T lifts into Res<T> wherever a Res is
// expected — `0;` closes a `Res<i32, E>` function like `Ok(0);` does.
// hoisting only fires when exactly ONE variant carries the type."
//
// TWO RULES, BOTH REFUSALS. The lift itself needs no code: the backend
// builds an `Ok` for a value that fits the success payload. Sema only
// owes the two cases where a reader would be guessing:
//   - `Res<i32, i32>` has TWO variants carrying `i32`, so a bare 32 is
//     ambiguous and the explicit form is required.
//   - only SUCCESS lifts. A bare error value at a `Res` return is not
//     an `Err` — a failure that lifted silently would be unwritten.
//
// NEVER COUNT AN UNSETTLED SLOT: `assignable` is lenient about a type
// nobody has computed (`Var`, `Infer`, poison), so counting those would
// make `<T, E>() Res<T, E>` ambiguous at every tail. Standing rule:
// never invent a diagnostic out of missing information.
//
// THE TWO CALL SITES: a function's tail (`sema_decl.zen`, after the
// body is typed) and a constructor's field (`sema_apply.zen`, after
// the construction's type is known). A binding with a written type
// goes through `coerce` instead, which reports the ordinary mismatch.
//
// AND ONE RULE THAT IS NOT ABOUT HOISTING AT ALL, at the bottom of the
// file: `check_arms`, which puts a match's ARMS where the match itself
// stands. It lives here because every answer it has for a `Res` slot
// is one of the answers above — an arm is a tail, and a tail that
// lifts must go on lifting.

Ast, Expr, ExprId, Block, BlockId, Stmt, StmtKind, Call, Arg, Span = std.ast
Match, Arm = std.ast
Alloc, AllocError = std.mem
Vec = std.collections
str = std.text
Range = std.core
TyId, Ty, Types, TyRes, ResForm = sema.sema_ty
SemaFault, NameFault, TypeFault = sema.sema_diag
Checker, Ctx = sema.sema_check
Found, members_of = sema.sema_member
check_literal = sema.sema_trap
type_of = sema.sema_type

// A value of type `got` arriving where `want` is expected, when nothing
// else has already checked the pair. Silent unless the two hoisting
// refusals apply: a value that simply does not fit is somebody else's
// diagnostic, and a value that fits needs nothing at all.
hoist_check* = (c :: Checker, file: str, span: Span, got: TyId, want: TyId)
               Res<(), AllocError> {
    c.assignable(got, want).match({
        true  => Ok(()),
        false => hoist_into(c, file, span, got, want),
    })
}

hoist_into = (c :: Checker, file: str, span: Span, got: TyId, want: TyId)
             Res<(), AllocError> {
    c.types.at(want).match({
        Res(r) => hoist_into_res(c, file, span, got, want, r),
        _      => Ok(()),
    })
}

// The candidate count, and the only three answers it has. Two carriers
// is ambiguous; one that is the failure is a failure nobody wrote; the
// success alone lifts and there is nothing to say.
hoist_into_res = (
    c    :: Checker,
    file : str,
    span : Span,
    got  : TyId,
    want : TyId,
    r    : TyRes
) Res<(), AllocError> {
    countable(c, r).match({
        false => Ok(()),
        true  => count_carriers(c, file, span, got, want, r),
    })
}

count_carriers = (
    c    :: Checker,
    file : str,
    span : Span,
    got  : TyId,
    want : TyId,
    r    : TyRes
) Res<(), AllocError> {
    ok  = c.assignable(got, r.value);
    err = carries_failure(c, got, r);
    (ok && err).match({
        true  => two_readings(c, file, span, got, want),
        false => lone_failure(c, file, span, err),
    })
}

// Reached only when the two carriers were not both present, so a
// failure here is the ONLY reading — and it is the one that does not
// lift.
lone_failure = (c :: Checker, file: str, span: Span, err: bool)
               Res<(), AllocError> {
    err.match({
        true  => failure_never_lifts(c, file, span),
        false => Ok(()),
    })
}

// A slot nobody has computed carries nothing YET, so a `Res` with an
// unsettled success payload cannot be counted at all.
countable = (c: Checker, r: TyRes) bool { settled(c, r.value) }

// `error` is meaningful only under `Failure`: `Absence` puts the unit
// type there and `Open` puts the `Infer` hole, and neither is a variant
// carrying anything a value could be mistaken for.
carries_failure = (c: Checker, got: TyId, r: TyRes) bool {
    r.form.match({
        Failure => settled(c, r.error) && c.assignable(got, r.error),
        Absence => false,
        Open    => false,
    })
}

settled = (c: Checker, t: TyId) bool {
    (c.is_var(t) || c.is_infer(t) || c.is_unknown(t)) == false
}

two_readings = (c :: Checker, file: str, span: Span, got: TyId, want: TyId)
               Res<(), AllocError> {
    c.report(
        file,
        span,
        SemaFault.HoistAmbiguous(TypeFault(
            name: "",
            expected: want,
            found: got
        ))
    )
}

// The variant that WOULD have carried it, named: the fix is to write
// `Err(..)` out, and a diagnostic that says "only success lifts" without
// naming what did not is half of one.
failure_never_lifts = (c :: Checker, file: str, span: Span)
                      Res<(), AllocError> {
    c.report(file, span, SemaFault.HoistNotSuccess(NameFault(name: "Err")))
}

// -----------------------------------------------------------------
// the two positions
// -----------------------------------------------------------------

// A body's value against the type the signature promised: the one
// place a function's tail meets its return type, so the one place a
// bare success can lift into a `Res` — or fail to. The tail's ARMS are
// checked beside it, under the same exemption: see `check_arms`.
//
// Also the one place a body ending in nothing is caught: hoisting used
// to be the only question asked here, so a `()` tail closing an `i32`
// was waved through, which is what let the print sugar close any
// function at all.
//
// Span is the TAIL EXPRESSION'S, not the block's — that's the value
// the author has to change.
check_return* = (c :: Checker, body: BlockId, ctx: Ctx, got: TyId)
                Res<(), AllocError> {
    blk = c.tree.block_at(body);
    tail_expr(c, blk).match({
        None  => Ok(()),
        Ok(e) => tail_fits(c, blk, e, got, ctx.ret),
    })
}

// The tail as ONE value, then the tail's arms as the several values it
// actually is. `value_was_asked_for` gates both, so the `;`-terminated
// unit tail that closes any function keeps closing it — arms and all.
tail_fits = (c :: Checker, blk: Block, id: ExprId, got: TyId, want: TyId)
            Res<(), AllocError> {
    return_fits(c, blk, id, got, want).try();
    value_was_asked_for(c, blk, got, want).match({
        false => Ok(()),
        true  => check_arms(c, id, want),
    })
}

// Fitting the family isn't fitting the type: `f = () i32 { 3000000000 }`
// is an `int` literal, and `assignable` says every one of those fits
// every integer type — hence `check_literal` on the agreeing side too.
return_fits = (c :: Checker, blk: Block, id: ExprId, got: TyId, want: TyId)
              Res<(), AllocError> {
    node = c.tree.expr_at(id);
    c.assignable(got, want).match({
        true  => c.check_literal(id, want),
        false => refuse_return(c, blk, node, got, want),
    })
}

// Decided by `want` and nowhere else, so the two rules can't both fire
// on one tail: a `Res` return is the hoisting question and
// `hoist_into_res` owns every answer to it (including silence); any
// other return type is the ordinary mismatch.
refuse_return = (
    c    :: Checker,
    blk  : Block,
    node : Expr,
    got  : TyId,
    want : TyId
) Res<(), AllocError> {
    c.types.at(want).match({
        Res(r) => res_return(c, blk, node, got, want, r),
        _      => wrong_return(c, blk, node, got, want),
    })
}

// A tail that is already a `Res` isn't a hoisting question — nothing to
// lift, and `assignable` already answered whether it fits. Catches
// `Err("not an error at all")` in a function declared `Res<i32, Error>`,
// where a `str` isn't that error set.
res_return = (
    c    :: Checker,
    blk  : Block,
    node : Expr,
    got  : TyId,
    want : TyId,
    r    : TyRes
) Res<(), AllocError> {
    c.types.at(got).match({
        Res(_) => wrong_return(c, blk, node, got, want),
        _      => hoist_into_res(c, node.span.file, node.span, got, want, r),
    })
}

// The tail fits the return type — the whole rule, and general: a print's
// value is unit (`sema_call.print_or_call`), so `f = () i32 {
// println("x") }` returns nothing where an `i32` was promised, and
// `Err("not an error at all")` no longer closes a `Res<i32, Error>`.
//
// BUG FOUND THE HARD WAY: `str` was once both a prim in the type store
// and a struct `std.text` declares, so `str_at`'s own `str(...)` wasn't
// `assignable` to its declared `str` and the general rule reddened
// every program that stands on std with "expected str, found str".
// Fixed in `sema_ty.named`, which now answers with the primitive for a
// declaration of a primitive's name — one `str`, rule costs nothing.
//
// TWO EXEMPTIONS (one rule, either side: a value nobody asked for need
// not fit):
//   - a function declared `()` discards whatever its body ends with —
//     that IS what `()` means at a return type.
//   - a `;`-terminated last statement that yields NOTHING (see
//     `corpus/sema/statement_tail_is_not_a_value`). The `;` alone isn't
//     the exemption: DESIGN.md's "`0;` closes a `Res<i32, E>` function
//     like `Ok(0);` does" makes a `;`-terminated tail the return, and
//     `block_type` carries its type out for that reason. So
//     `println("noisy");` closes an `i32` function (no value to return)
//     but `Err(Error.IoError);` does not (a value that doesn't fit).
wrong_return = (c :: Checker, blk: Block, node: Expr, got: TyId, want: TyId)
               Res<(), AllocError> {
    value_was_asked_for(c, blk, got, want).match({
        false => Ok(()),
        true  => c.coerce(node.span.file, node.span, got, want, ""),
    })
}

value_was_asked_for = (c: Checker, blk: Block, got: TyId, want: TyId) bool {
    (unit_ty(c, want) == false)
        && (written_value(blk) || (unit_ty(c, got) == false))
}

written_value = (blk: Block) bool {
    blk.value.match({ Ok(_) => true, None => false })
}

unit_ty = (c: Checker, t: TyId) bool { c.prim_name(t).eq("()") }

hoist_at = (c :: Checker, id: ExprId, got: TyId, want: TyId)
           Res<(), AllocError> {
    node = c.tree.expr_at(id);
    hoist_check(c, node.span.file, node.span, got, want)
}

// The block's value, written with or without the closing `;` — the AST
// records only which was written, and both are the block's value.
tail_expr = (c: Checker, blk: Block) Res<ExprId> {
    blk.value.match({
        Ok(e) => Ok(e),
        None  => last_stmt_expr(blk),
    })
}

// Empty block asked first, and must be: `len - 1` on a `usize` zero
// underflows, which this compiler traps on — `f = () () { }` used to
// crash the compiler with `trap: integer overflow` here instead of
// compiling to nothing.
last_stmt_expr = (blk: Block) Res<ExprId> {
    (blk.stmts.len > 0).match({
        false => None,
        true  => last_stmt_of(blk.stmts),
    })
}

last_stmt_of = (stmts: Vec<Stmt>) Res<ExprId> {
    stmts.get(stmts.len - 1).match({
        None  => None,
        Ok(s) => s.kind.match({ Expr(e) => Ok(e.expr), _ => None }),
    })
}

// -----------------------------------------------------------------
// the third position: an arm
// -----------------------------------------------------------------

// EVERY ARM PRODUCES THE MATCH'S VALUE, so every arm stands where the
// match stands and owes what the match owes.
//
// Nothing asked them. `sema_join.zen` says what a match is WORTH and
// deliberately declines to invent a supertype for arms that disagree —
// "two arms of genuinely different types mean something the language
// cannot express" — but declining answered the FIRST arm's type and
// said nothing about the rest. `f = (b: bool) i32 { b.match({ true =>
// 1, false => false }) }` typed as `i32`, compiled, ran, and printed
// 0: a wrong answer, not a missing message.
//
// ASKED HERE AND NOT IN THE JOIN, because the join has no expectation
// to name. "expected i32" is the POSITION's word; the first arm is not
// entitled to speak for the position, and a diagnostic that said
// "expected int" — the first arm's literal type — would blame the
// wrong line. Same walk `check_literal` already makes for a literal's
// range, for the reason given there: "a match arm is walked here since
// it has no caller of its own — the match settles its context".
check_arms* = (c :: Checker, id: ExprId, want: TyId) Res<(), AllocError> {
    node = c.tree.expr_at(id);
    node.kind.match({
        Match(m) => arms_within(c, m, want),
        _        => Ok(()),
    })
}

// A nested match's arms are the values; the inner match is only how
// they were chosen — same recursion, same reason as `literal_within`.
arms_within = (c :: Checker, m: Match, want: TyId) Res<(), AllocError> {
    m.arms.loop((h, a) { arm_within(c, a.body, want).try() });
    Ok(());
}

arm_within = (c :: Checker, id: ExprId, want: TyId) Res<(), AllocError> {
    node = c.tree.expr_at(id);
    node.kind.match({
        Match(m) => arms_within(c, m, want),
        _        => arm_fits(c, id, node, want),
    })
}

// THE TYPE THE MATCH ALREADY COMPUTED, never a fresh one: the arm's
// pattern binders left scope when the arm did, so re-typing `Ok(n) =>
// n` here would report `n` undefined. A miss is silence — an arm the
// match never typed is not an arm this rule knows anything about.
arm_fits = (c :: Checker, id: ExprId, node: Expr, want: TyId)
           Res<(), AllocError> {
    c.expr_memo.get(id).match({
        None    => Ok(()),
        Ok(got) => arm_agrees(c, node, got, want),
    })
}

// Refused exactly the way a return is, and it must be: an arm is a
// tail. So a `Res` want is hoisting's question and hoisting's alone
// (`true => 1` still closes a `Res<i32, E>` match), and anything else
// is the ordinary mismatch.
arm_agrees = (c :: Checker, node: Expr, got: TyId, want: TyId)
             Res<(), AllocError> {
    c.assignable(got, want).match({
        true  => Ok(()),
        false => refuse_arm(c, node, got, want),
    })
}

refuse_arm = (c :: Checker, node: Expr, got: TyId, want: TyId)
             Res<(), AllocError> {
    c.types.at(want).match({
        Res(r) => arm_into_res(c, node, got, want, r),
        _      => c.coerce(node.span.file, node.span, got, want, ""),
    })
}

arm_into_res = (c :: Checker, node: Expr, got: TyId, want: TyId, r: TyRes)
               Res<(), AllocError> {
    c.types.at(got).match({
        Res(_) => c.coerce(node.span.file, node.span, got, want, ""),
        _      => hoist_into_res(c, node.span.file, node.span, got, want, r),
    })
}

// `Row(n: 32)` on a field declared `Res<i32>`: construction is the
// other place a value lands somewhere it didn't name, into the field's
// declared type.
//
// Named arguments only — a positional argument to a constructor is a
// different resolution, not this rule's to interpret.
check_ctor_fields* = (c :: Checker, call: Call, ty: TyId, ctx: Ctx)
                     Res<(), AllocError> {
    call.args.loop((h, a) { check_ctor_field(c, a, ty, ctx).try() });
    Ok(());
}

check_ctor_field = (c :: Checker, a: Arg, ty: TyId, ctx: Ctx)
                   Res<(), AllocError> {
    a.name.match({
        None   => Ok(()),
        Ok(nm) => check_named_field(c, a, nm.text, ty, ctx),
    })
}

check_named_field = (c :: Checker, a: Arg, name: str, ty: TyId, ctx: Ctx)
                    Res<(), AllocError> {
    found ::= c.alloc.Vec<Found>();
    members_of(c, ty, name, found).try();
    found.get(0).match({
        None  => Ok(()),
        Ok(f) => field_fits(c, a, f.ty, ctx),
    })
}

// A field is a typed slot: all of its questions get asked — what lifts
// into it, whether the given value fits the declared type, and whether
// every ARM of a match written there fits it. `Holder(n: 3000000000)` on
// `n: i32` used to pass the first while nobody asked the second;
// `Holder(n: b.match({ true => 1, false => false }))` passed the first
// two while nobody asked the third, and a field is where a wrong value
// stops being one expression's mistake and gets STORED.
field_fits = (c :: Checker, a: Arg, want: TyId, ctx: Ctx)
             Res<(), AllocError> {
    hoist_at(c, a.value, c.type_of(a.value, ctx).try(), want).try();
    c.check_literal(a.value, want).try();
    check_arms(c, a.value, want)
}
