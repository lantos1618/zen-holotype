// src/sema/sema_union.zen
// The union reading of `A | B`, which sema did not have at all.
//
// DESIGN.md: "`A | B` is a union of existing types when EVERY variant
// names a type in scope, and a nominal enum otherwise." The C backend
// decides exactly that — `union_reading` in `gen_c_type.zen` — and sema
// decided nothing, so `WriteError = IoError | AllocError` was a nominal
// enum of two bare tags here, and an `AllocError` value was therefore
// not a member of it. Every "no implicit error conversion: expected
// WriteError, found AllocError" in the corpus was that one hole: not a
// conversion the program asked for, a SET the checker had never built.
// The store already knew how to hold one — `union_ty` canonicalises,
// `set_within` answers containment — nothing ever built one for a NAME.
//
// THE SET IS RECORDED BESIDE THE NAMED TYPE, NOT IN PLACE OF IT, and
// that is the one design decision here worth arguing about. Answering
// `Ty.Union` for `WriteError` is what DESIGN.md's alias rule implies —
// "an alias is the type, not a name that forwards to it" — and it was
// tried first. It type-checks and it emits C that does not compile:
// `gen_c_type.zen:62` has no `Ty.Union` arm, falls to `_ => "int"`, and
// a `Res` whose error member is an `int` is handed a struct. The
// backend's whole representation of a set is the DECLARED enum, whose
// variants are named by the types they carry, so taking the name away
// takes the representation away with it. Recording the set against the
// name keeps both: sema answers containment, gen_c keeps the layout it
// already emits correctly. When gen_c grows a `Ty.Union` arm this table
// is what `named_or_union` stops needing.
//
// THE QUESTION IS ABOUT THE DECLARATION AND NOT ABOUT ONE VARIANT.
// Asked one variant at a time it has a different answer, and the
// difference is not academic: a sixty-variant `TokenKind` with one `Eq`
// would grow a payload nobody wrote. One variant that is not a bare
// type name settles the whole declaration.

Decl, Enum, Variant = ast
AllocError = std.mem
Vec = std.collections
str = std.text
Range = std.core
DeclId = sema.sema_id
TyId, TyNamed = sema.sema_ty
Def, decl_at = sema.sema_def
Checker = sema.sema_check

// What a written name denotes, plus the set it stands for when it
// stands for one. The type is the same `Ty.Named` it has always been —
// the answer to "is this set contained in that one" is what changed.
named_or_union* = (c :: Checker, d: Def, args: Vec<TyId>)
                  Res<TyId, AllocError> {
    id = c.types.named(d.id, d.qname, d.name, args).try();
    record_set(c, id, d.id).try();
    Ok(id);
}

// Nothing to do twice, and nothing to do for a nominal enum. A hit is
// either the finished set or the seed of one being computed, and both
// mean this walk is already under way somewhere below.
record_set = (c :: Checker, id: TyId, decl: DeclId) Res<(), AllocError> {
    c.set_memo.get(id).match({
        Ok(_) => Ok(()),
        None  => record_if_union(c, id, decl),
    })
}

record_if_union = (c :: Checker, id: TyId, decl: DeclId)
                  Res<(), AllocError> {
    union_reading(c, decl).match({
        false => Ok(()),
        true  => compute_set(c, id, decl),
    })
}

// Seeded with the name's own id before the walk, the way `compute_type`
// seeds poison and for the same reason: a member is resolved through
// `named_or_union` too, so `A = A | B` would not otherwise stop. A set
// that contains itself falls back to being nominal, which is the
// reading that adds no member rather than an infinite one.
compute_set = (c :: Checker, id: TyId, decl: DeclId) Res<(), AllocError> {
    c.set_memo.set(id, id).try();
    members ::= c.alloc.Vec<TyId>();
    collect_members(c, decl, members).try();
    set = c.types.union_ty(members).try();
    c.set_memo.set(id, set).try();
    Ok(());
}

collect_members = (c :: Checker, decl: DeclId, out :: Vec<TyId>)
                  Res<(), AllocError> {
    decl_at(c.tree, decl).match({
        None  => Ok(()),
        Ok(d) => decl_members(c, decl, d, out),
    })
}

decl_members = (c :: Checker, decl: DeclId, d: Decl, out :: Vec<TyId>)
               Res<(), AllocError> {
    d.kind.match({
        Enum(e) => enum_members(c, decl, e, out),
        _       => Ok(()),
    })
}

// A member that is ITSELF a set contributes its members and not its
// name, because `set_of` hands back what `union_ty` flattened: `Error =
// WriteError | FsError` is one set of however many, and containment is
// answered about it without knowing how it was spelled.
enum_members = (c :: Checker, decl: DeclId, e: Enum, out :: Vec<TyId>)
               Res<(), AllocError> {
    e.variants.loop((h, v) {
        out.add(member_type(c, decl, v.name.text).try()).try();
    });
    Ok(());
}

// The type a bare variant name denotes, resolved in the module that
// DECLARES the enum. `WriteError = IoError | AllocError` means those two
// as `std.core.io` sees them; law 6 says the name crossing a boundary is
// `WriteError`, never its members.
//
// A miss is unreachable — `union_reading` already found a type under
// every one of these names — so it poisons rather than reports.
//
// THE NAME AND THE SET IT FLATTENS TO ARE TWO ANSWERS, and which one is
// wanted depends on the question. Building the set wants the flattening:
// `Error = WriteError | FsError` is one set of however many. MATCHING
// wants the name — `sema_case.zen` asks what a variant CARRIES, and
// gen_c's `union_member_type` gives it the named type, so an arm's
// binder has to be that same type or sema checks one and the backend
// emits another.
union_member* = (c :: Checker, decl: DeclId, name: str)
                Res<TyId, AllocError> {
    found ::= c.alloc.Vec<Def>();
    c.world.defs_of(decl.module.to_usize(), name, found).try();
    found.get(0).match({
        None  => c.types.unknown(),
        Ok(d) => member_named(c, d),
    })
}

member_named = (c :: Checker, d: Def) Res<TyId, AllocError> {
    empty ::= c.alloc.Vec<TyId>();
    named_or_union(c, d, empty)
}

member_type = (c :: Checker, decl: DeclId, name: str) Res<TyId, AllocError> {
    Ok(c.set_of(union_member(c, decl, name).try()));
}

// The value `Type.NAME` leaves unwritten: what a union's member carries,
// or poison when `ty` is not a union or `name` is not one of its
// members. Poison and not a `bool`, because the diagnostic has to NAME
// the type that is missing and the answer is already in hand.
//
// THE QUESTION IS SETTLED BY THE DECLARATION, exactly as `union_reading`
// is: every variant of a union names a type, so every member carries
// one, and there is no variant of one to exempt. A nominal enum answers
// poison here even for a payload variant — `Slot.Left` is the function
// that builds one, and a function is a value.
union_carrier* = (c :: Checker, ty: TyId, name: str) Res<TyId, AllocError> {
    c.types.at(ty).match({
        Named(n) => named_carrier(c, n, name),
        _        => c.types.unknown(),
    })
}

named_carrier = (c :: Checker, n: TyNamed, name: str) Res<TyId, AllocError> {
    (union_reading(c, n.decl) && variant_named(c, n.decl, name)).match({
        true  => union_member(c, n.decl, name),
        false => c.types.unknown(),
    })
}

// Against the DECLARED variants and not `defs_of`, which would answer
// for any type the declaring module can see: `Error.Vec` names no member
// of `Error = AllocError | IoError`, and a lookup that found `Vec`
// anyway would report the wrong mistake about it.
variant_named = (c :: Checker, decl: DeclId, name: str) bool {
    decl_at(c.tree, decl).match({
        None  => false,
        Ok(d) => decl_names_variant(d, name),
    })
}

decl_names_variant = (d: Decl, name: str) bool {
    d.kind.match({
        Enum(e) => enum_names_variant(e, name),
        _       => false,
    })
}

enum_names_variant = (e: Enum, name: str) bool {
    Range(0, e.variants.len).find((i) {
        e.variants.get(i).match({
            None  => false,
            Ok(v) => v.name.text.eq(name),
        })
    }).match({ Ok(_) => true, None => false })
}

// -----------------------------------------------------------------
// which reading applies
//
// Below here is `gen_c_type.zen`'s decision, asked of a `Checker`
// rather than a `CBackend`. THE TWO MUST AGREE, or sema checks one type
// and the backend emits another, which is this compiler's worst failure
// class — so this mirrors it rather than improving on it, down to
// answering "not a union" when a lookup runs out of memory. That is the
// reading that invents no member.
// -----------------------------------------------------------------

union_reading* = (c :: Checker, decl: DeclId) bool {
    decl_at(c.tree, decl).match({
        None  => false,
        Ok(d) => enum_union_reading(c, decl, d),
    })
}

enum_union_reading = (c :: Checker, decl: DeclId, d: Decl) bool {
    d.kind.match({
        Enum(e) => no_nominal_variant(c, decl, e),
        _       => false,
    })
}

// Fewer than two variants is nominal whatever the name means. A union of
// one existing type IS that type, and DESIGN.md spells that without a
// bar — so `X = | Foo` was written with the bar on purpose.
no_nominal_variant = (c :: Checker, decl: DeclId, e: Enum) bool {
    (e.variants.len < 2).match({
        true  => false,
        false => every_variant_named(c, decl, e),
    })
}

// Looks for the counterexample and reports its absence, so the scan
// stops at the first variant that is not a bare type name — which for a
// nominal enum is normally the first one.
every_variant_named = (c :: Checker, decl: DeclId, e: Enum) bool {
    Range(0, e.variants.len).find((i) {
        e.variants.get(i).match({
            None  => true,
            Ok(v) => !names_a_type(c, decl, v),
        })
    }).match({ Ok(_) => false, None => true })
}

// A written payload means the variant is not a bare name, so the union
// reading is already out — `Shape = Circle(Circle) | Unit` is nominal
// however many of its names are also types.
names_a_type = (c :: Checker, decl: DeclId, v: Variant) bool {
    v.payload.match({
        Ok(_) => false,
        None  => defs_named(c, decl, v.name.text),
    })
}

defs_named = (c :: Checker, decl: DeclId, name: str) bool {
    found ::= c.alloc.Vec<Def>();
    c.world.defs_of(decl.module.to_usize(), name, found).match({
        Err(_) => false,
        Ok(_)  => found.len > 0,
    })
}
