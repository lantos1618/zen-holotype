Noisy = { env: Env, id: i32 }

Noisy.impl(Drop, {
    drop = (self :: @Self) () { self.env.out.println("drop {}", self.id) }
})

main = (env: Env) i32 {
    outer = Noisy(env: env, id: 99);
    [0, 1, 2, 3].loop((h, i: i32) {
        body = Noisy(env: env, id: i * 10);
        {
            inner = Noisy(env: env, id: i * 10 + 1);
            @scope.defer(() { println("defer {}", i) });
            (i == 1).then(() { h.next() });
            (i == 2).then(() { h.break() });
            println("inner {}", i);
        }
        println("body {}", i);
    });
    println("after");
    0
}
