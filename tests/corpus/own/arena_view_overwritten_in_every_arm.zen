word = (env: Env, letters: str) Res<str, AllocError> {
    alloc ::= env.mem.alloc();
    buf   ::= alloc.String().try();
    buf.add(letters).try();
    output: str ::= "";
    output = buf.view();
    (letters.len > 0).match({
        true  => { output = "safe"; },
        false => { output = "also safe"; },
    });
    Ok(output)
}
main = (env: Env) Res<i32, AllocError> {
    a = word(env, "ab").try();
    println("{}", a);
    Ok(0)
}
