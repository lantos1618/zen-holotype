// What the lexer says when the bytes are wrong.
// Diagnostics are collected values; lex returns Err only for AllocError. The
// scanner resynchronizes after each fault so one source can report several.
// Spans identify the bytes to fix; messages remain fixed and allocation-free.

Span = std.lex.lex_token
str = std.text

LexFault* =
      UnterminatedString       // end of file inside "..."
    | StringSpansLine          // a newline inside "..."
    | UnterminatedChar         // end of file inside '...'
    | CharSpansLine            // a newline inside '...'
    | EmptyChar                // ''
    | CharTooLong              // 'ab', 'é'
    | UnknownEscape            // \q
    | UnterminatedEscape       // end of file after a backslash
    | UnterminatedComment      // end of file inside /* ...
    | LeadingZero              // 010
    | HexNeedsDigit            // 0x
    | FloatNeedsDigit          // 12.
    | SuffixOnNumber           // 1abc, 0xffg
    | IntegerOutOfRange        // wider than u64, so no type can hold it
    | UnknownAtName            // @foo
    | MisplacedBom             // a byte-order mark past offset 0
    | StrayByte                // begins no token at all

Diag* = {
    file*: str,
    fault*: LexFault,
    span*: Span,
}

message* = (fault: LexFault) str {
    fault.match({
        UnterminatedString  => "unterminated string literal: end of file before the closing quote",
        StringSpansLine     => "unterminated string literal: a string literal does not span lines",
        UnterminatedChar    => "unterminated character literal: end of file before the closing quote",
        CharSpansLine       => "unterminated character literal: a character literal does not span lines",
        EmptyChar           => "empty character literal: a character literal holds exactly one byte",
        CharTooLong         => "a character literal holds exactly one byte; this one holds more",
        UnknownEscape       => "unknown escape sequence: the escapes are \\n \\t \\r \\v \\f \\0 \\\\ \\' \\\"",
        UnterminatedEscape  => "unterminated escape sequence: end of file after the backslash",
        UnterminatedComment => "unterminated block comment: end of file before `*/`",
        LeadingZero         => "a decimal literal has no leading zero, and Zen has no octal",
        HexNeedsDigit       => "a hexadecimal integer needs a digit after `0x`",
        FloatNeedsDigit     => "a float literal needs a digit after the `.`",
        SuffixOnNumber      => "an identifier may not start with a digit, and a number carries no suffix",
        IntegerOutOfRange   => "integer literal out of range: the widest integer type is u64",
        UnknownAtName       => "the `@` namespace is exactly `@Self`, `@meta`, `@scope`",
        MisplacedBom        => "a byte-order mark is stripped only at the start of a file",
        StrayByte           => "unexpected character: it begins no Zen token",
    });
}
