// A primitive satisfies a bound through an impl — `u8.impl(ToU32, ..)`
// makes `<T: ToU32>` accept a u8 — but an i8 has no ToU32 impl, because
// i8 -> u32 loses the sign and only LOSSLESS widening is declared. The
// prim branch of satisfies_bound must keep refusing, not turn the bound
// into a shape check.
//
// position: the call whose argument fails the bound.

as_u32 = <T: ToU32>(x: T) u32 { x.widen_u32() }

main = (env: Env) Res<i32, AllocError> {
    n: i8 = -1;
    println("{}", as_u32(n));
    Ok(0);
}
