// @self-hosted-only
// Checked-mode resolver: flatten imports, load dependencies, and dedup provided names.
{ at, is_alpha, is_alnum } = std.text.bytes
{ Decl, gstr_string, gstr_grow, gstr_reserve, gstr_push, gstr_append, gstr_finish } = compiler.genc
{ decl_span, parse_module, decl_is_impl, note_alias_prefix, alias_prefixes_reset } = compiler.parse
{ check_linked, check_linked_kind } = compiler.check_validate
// Parser APIs still take MutPtr<Malloc>; scanner-only APIs can use any Allocator.
{ Allocator, Malloc, try_acquire } = std.mem.alloc
{ Result, IoError, ok, err } = std.core.result
{ String } = std.text.string
{ Map, of } = std.collections.map    // O(1) presence sets for the shadow-rename pass (.has/.put are UFCS methods)
{ contents_in, O_RDONLY } = std.io.file
{ open, close, write } = std.c.libc
{ view, eq, is_empty } = std.text.str
{ render_diagnostic } = compiler.diagnostic
{ getEnv } = std.os
is_ws = (b: u8) bool { b == ' ' || b == '\t' }
lstrip = (s: string_view, p: i32) i32 { at(s, p).is_ws().match ({ true => s.lstrip(p + 1), false => p }) }
// A top-level line opening an import: `{` then a space OR a binding name directly (`{println}`).
// `has_import_marker` then confirms a real `} = std./compiler./user` follows, so relaxing the
// space requirement here can't mis-classify a plain `{` block.
opens_import = (s: string_view, p: i32) bool { s.at(p) == '{' && (s.at(p + 1) == ' ' || s.at(p + 1).is_alpha() || s.at(p + 1) == '_') }
import_marker_from = (s: string_view, p: i32) i32 {
    b := s.at(p)
    (b == 0).match ({ true => 0 - 1, false => (b == '}').match ({ true => s.marker_after_close(p + 1), false => s.import_marker_from(p + 1) }) })
}
marker_after_close = (s: string_view, p: i32) i32 { (s.at(p) == ' ').match ({ true => s.marker_after_close(p + 1), false => s.is_any_marker_at(p).match ({ true => p, false => 0 - 1 }) }) }
has_import_marker = (s: string_view, p: i32) bool { s.import_marker_from(p) >= 0 }
resolve_span_eq = (s: string_view, p: i32, lit: string_view, i: i32) bool { (lit.at(i) == 0).match ({ true => true, false => s.at(p + i) == lit.at(i) && s.resolve_span_eq(p, lit, i + 1) }) }
is_std_marker_at = (s: string_view, p: i32) bool { s.resolve_span_eq(p, "= std.", 0) }
is_compiler_marker_at = (s: string_view, p: i32) bool { s.resolve_span_eq(p, "= compiler.", 0) }
is_marker_at = (s: string_view, p: i32) bool { s.is_std_marker_at(p) || s.is_compiler_marker_at(p) }
// A user-module alias `name = sibling` — `= <ident>` whose RHS is a bare module name. The RHS must NOT be
// a qualified path (`= pkg.mod`, caught by `!= '.'`) NOR a call (`= compute()`); without the `!= '('` guard
// a value-global `pi = compute()` is mis-read as importing a module `compute` (spurious "unknown module").
is_user_marker_at = (s: string_view, p: i32) bool { s.at(p) == '=' && s.at(p + 1) == ' ' && s.at(p + 2).is_alpha() && s.at(s.res_ident_end(p + 2)) != '.' && s.at(s.res_ident_end(p + 2)) != '(' }
is_any_marker_at = (s: string_view, p: i32) bool { s.is_marker_at(p) || s.is_user_marker_at(p) }
is_import_line* = (s: string_view, p: i32) bool {
    ls := s.lstrip(p)
    s.opens_import(ls).match ({ true => s.has_import_marker(ls), false => false })
}
import_end = (s: string_view, p: i32) i32 { s.next_line(s.import_marker_from(s.lstrip(p))) }
// Position just past the next '\n' at or after `p` (end-of-string if none). Iterates a sub-slice that
// starts at `p` — NOT a scan from 0, and NOT recursive — so walking a file line-by-line is O(n) total
// with constant stack.
next_line = (s: string_view, p: i32) i32 {
    bs: [u8] := s.view()
    pos := p
    (p < to_i32(bs.len)).match ({ true => {
        span: [u8] := slice(s.offset(p), bs.len - to_i64(p))
        span.loop((h, i, b) {
            pos = p + to_i32(i) + 1
            (b == '\n').match ({ true => {
                h.break
            }, false => { } })
        })
    }, false => { } })
    pos
}
strip_count* = (s: string_view, p: i32, n: i32) i32 { (s.at(p) == 0).match ({ true => n, false => s.is_import_line(p).match ({ true => s.strip_count(s.import_end(p), n), false => s.strip_count(s.next_line(p), n + 1) }) }) }
// Position of the next '\n' at or after `p` (end-of-string if none). Iterates a sub-slice that starts
// at `p` — NOT a scan from 0, and NOT recursive — so walking a file line-by-line is O(n) total with
// constant stack.
line_end = (s: string_view, p: i32) i32 {
    bs: [u8] := s.view()
    pos := p
    (p < to_i32(bs.len)).match ({ true => {
        span: [u8] := slice(s.offset(p), bs.len - to_i64(p))
        span.loop((h, i, b) {
            (b == '\n').match ({ true => {
                pos = p + to_i32(i)
                h.break
            }, false => {
                pos = p + to_i32(i) + 1
            } })
        })
    }, false => { } })
    pos
}
append_span = (out: String, a: MutPtr<Malloc>, s: string_view, p: i32, e: i32) String {
    cur := out
    bs: [u8] := s.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < p).match ({ true => { }, false => (ii >= e || b == 0).match ({ true => {
            h.break
        }, false => {
            cur = cur.rpush(a, b)
        } }) })
    })
    cur
}
str_bytes = (s: string_view) [u8] { s.view() }
RewriteSkip: {
    out: String,
    next: i32,
}
line_comment_at = (s: string_view, p: i32) bool { s.at(p) == '/' && s.at(p + 1) == '/' }
block_comment_at = (s: string_view, p: i32) bool { s.at(p) == '/' && s.at(p + 1) == '*' }
quoted_at = (s: string_view, p: i32) bool { s.at(p) == '"' || s.at(p) == '\'' }
copy_line_comment = (out: String, a: MutPtr<Malloc>, s: string_view, p: i32) RewriteSkip {
    cur := out
    pos := p
    bs: [u8] := s.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos).match ({ true => { }, false => (b == 0 || b == '\n').match ({ true => {
            h.break
        }, false => {
            cur = cur.rpush(a, b)
            pos = pos + 1
        } }) })
    })
    RewriteSkip(
        out: cur,
        next: pos,
    )
}
copy_block_comment = (out: String, a: MutPtr<Malloc>, s: string_view, p: i32) RewriteSkip {
    cur := out
    pos := p
    bs: [u8] := s.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos).match ({ true => { }, false => (b == 0).match ({ true => {
            h.break
        }, false => (b == '*' && s.at(ii + 1) == '/').match ({ true => {
            cur = cur.rpush(a, '*').rpush(a, '/')
            pos = ii + 2
            h.break
        }, false => {
            cur = cur.rpush(a, b)
            pos = pos + 1
        } }) }) })
    })
    RewriteSkip(
        out: cur,
        next: pos,
    )
}
copy_literal = (out: String, a: MutPtr<Malloc>, s: string_view, p: i32) RewriteSkip {
    q := s.at(p)
    cur := out
    pos := p
    esc := false
    bs: [u8] := s.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos).match ({ true => { }, false => (b == 0).match ({ true => {
            h.break
        }, false => {
            cur = cur.rpush(a, b)
            pos = pos + 1
            esc.match ({ true => {
                esc = false
            }, false => (b == '\\').match ({ true => {
                esc = true
            }, false => (ii > p && b == q).match ({ true => {
                h.break
            }, false => { } }) }) })
        } }) })
    })
    RewriteSkip(
        out: cur,
        next: pos,
    )
}
strip_into = (out: String, a: MutPtr<Malloc>, s: string_view, p: i32, first: bool) String {
    cur := out
    pos := p
    is_first := first
    bs: [u8] := s.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos).match ({ true => { }, false => s.is_import_line(pos).match ({ true => {
            pos = s.import_end(pos)
        }, false => {
            e := s.line_end(pos)
            cur = is_first.match ({ true => cur.rappend_span(a, s, pos, e), false => cur.rpush(a, 10).rappend_span(a, s, pos, e) })
            is_first = false
            pos = s.next_line(pos)
        } }) })
    })
    cur
}
strip_imports* = (out: String, a: MutPtr<Malloc>, s: string_view) String { out.strip_into(a, s, 0, true) }
concat_files* = (out: String, a: MutPtr<Malloc>, left: string_view, right: string_view) String { out.rappend(a, left).rpush(a, 10).rappend(a, right) }
STD_MARKER_LEN := 6
COMPILER_MARKER_LEN := 11
USER_MARKER_LEN := 2
module_name_pos = (s: string_view, p: i32) i32 { s.is_std_marker_at(p).match ({ true => p + STD_MARKER_LEN, false => s.is_compiler_marker_at(p).match ({ true => p + COMPILER_MARKER_LEN, false => s.is_user_marker_at(p).match ({ true => p + USER_MARKER_LEN, false => s.module_name_pos(p + 1) }) }) }) }
take_name = (out: String, a: MutPtr<Malloc>, s: string_view, p: i32) String {
    cur := out
    pos := p
    bs: [u8] := s.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos).match ({ true => { }, false => s.at(pos).is_alnum().match ({ true => {
            cur = cur.rpush(a, s.at(pos))
            pos = pos + 1
        }, false => {
            h.break
        } }) })
    })
    cur
}
import_module* = (out: String, a: MutPtr<Malloc>, s: string_view, p: i32) String { out.take_module_path(a, s, s.module_name_pos(p)) }
take_module_path = (out: String, a: MutPtr<Malloc>, s: string_view, p: i32) String {
    cur := out
    pos := p
    bs: [u8] := s.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos).match ({ true => { }, false => s.at(pos).is_alnum().match ({ true => {
            cur = cur.rpush(a, s.at(pos))
            pos = pos + 1
        }, false => (s.at(pos) == '.').match ({ true => {
            cur = cur.rpush(a, '/')
            pos = pos + 1
        }, false => {
            h.break
        } }) }) })
    })
    cur
}
import_id = (out: String, a: MutPtr<Malloc>, s: string_view, p: i32) String {
    cur := out
    s.is_std_marker_at(p).match ({ true => {
        base := cur.rappend(a, "std/")
        cur = base.take_module_path(a, s, p + STD_MARKER_LEN)
    }, false => s.is_compiler_marker_at(p).match ({ true => {
        base := cur.rappend(a, "compiler/")
        cur = base.take_module_path(a, s, p + COMPILER_MARKER_LEN)
    }, false => s.is_user_marker_at(p).match ({ true => {
        base := cur.rappend(a, "u/")
        cur = base.take_name(a, s, p + USER_MARKER_LEN)
    }, false => {
        cur = cur.import_id(a, s, p + 1)
    } }) }) })
    cur
}
id_is_user = (id: String) bool { id.len >= 2 && id.res_sbyte(0) == 'u' && id.res_sbyte(1) == '/' }
id_is_std_io_c = (id: String) bool { id.len == 8 && id.res_sbyte(0) == 's' && id.res_sbyte(1) == 't' && id.res_sbyte(2) == 'd' && id.res_sbyte(3) == '/' && id.res_sbyte(4) == 'i' && id.res_sbyte(5) == 'o' && id.res_sbyte(6) == '/' && id.res_sbyte(7) == 'c' }
// String-backed line set: `name\n` entries, scanned without per-name allocation.
res_sbyte = (s: String, i: i64) u8 { load(offset(s.ptr, i)) }
line_eq = (set: String, i: i64, name: String, j: i64, m: i64) bool { (j == m).match ({ true => set.res_sbyte(i) == '\n', false => (set.res_sbyte(i) == name.res_sbyte(j)).match ({ true => set.line_eq(i + 1, name, j + 1, m), false => false }) }) }
seen_scan = (set: String, name: String, i: i64) bool { (i >= set.len).match ({ true => false, false => set.line_eq(i, name, 0, name.len).match ({ true => true, false => set.seen_scan(name, set.snext_line(i)) }) }) }
snext_line = (set: String, i: i64) i64 { (i >= set.len).match ({ true => set.len, false => (set.res_sbyte(i) == '\n').match ({ true => i + 1, false => set.snext_line(i + 1) }) }) }
seen_name* = (set: String, name: String) bool { set.seen_scan(name, 0) }
add_name* = (set: String, a: MutPtr<Malloc>, name: String) String { set.rappend_string(a, name).rpush(a, 10) }
// O(1)-average presence set over the shadow-rename pass's symbol keys, replacing the newline-delimited
// String + linear `seen_name` scan (which made shadow_rename_set O(n²) in decl count — 50k trivial fns
// never finished). Keys are the clean, NUL-terminated identifiers `symbol_key_in`/`symbol_name_alloc`
// mint, so a content-hashed Map matches the old explicit-length String comparison byte-for-byte. The
// "" seed is a sentinel: identifiers are never empty, so it is never a real query. Val is a presence
// marker (0); membership is by key.
rset_new = (a: MutPtr<Malloc>) Map<i64> {
    seed: i64 := 0 - 1
    of(a, "", seed).expect("std.internal.resolve: rset alloc")
}
rset_add = (m: Map<i64>, a: MutPtr<Malloc>, key: String) Map<i64> { m.put(a, cstr(key.ptr), 0).expect("std.internal.resolve: rset alloc") }
rset_add_str = (m: Map<i64>, a: MutPtr<Malloc>, name: string_view) Map<i64> { m.put(a, name, 0).expect("std.internal.resolve: rset alloc") }
rset_has = (m: Map<i64>, key: String) bool { m.has(cstr(key.ptr)) }
copy_from = (out: String, a: MutPtr<Malloc>, src: String, i: i64) String {
    cur := out
    (i >= src.len).match ({ true => { }, false => {
        next := cur.rpush(a, src.res_sbyte(i))
        cur = next.rcopy_from(a, src, i + 1)
    } })
    cur
}
// resolve's allocator-first String helpers now delegate to compiler.genc's canonical generic
// gstr_* builder (one implementation for the whole compiler). The only difference is the arg
// convention: m* take the allocator first (s.gstr_push(a, b)); gstr_* take the String first.
mappend_string = (a: MutPtr<Malloc>, out: String, src: String) String {
    cur := out
    bs: [u8] := src.bytes()
    bs.loop((h, i, b) {
        cur = cur.gstr_push(a, b)
    })
    cur
}
mcopy_from = (a: MutPtr<Malloc>, out: String, src: String, i: i64) String {
    cur := out
    bs: [u8] := src.bytes()
    bs.loop((h, idx, b) {
        (idx < i).match ({ true => { }, false => {
            cur = cur.gstr_push(a, b)
        } })
    })
    cur
}
// Append s[p..e) (stopping early at NUL) to `out`. Iterates a sub-slice that starts at `p` — NOT a
// scan from 0, and NOT recursive — so copying a span out of a large flattened source is O(e-p) and
// uses constant stack regardless of span length.
mappend_span = (a: MutPtr<Malloc>, out: String, s: string_view, p: i32, e: i32) String {
    cur := out
    (p < e).match ({ true => {
        span: [u8] := slice(s.offset(p), to_i64(e - p))
        span.loop((h, i, b) {
            (b == 0).match ({ true => {
                h.break
            }, false => {
                cur = cur.gstr_push(a, b)
            } })
        })
    }, false => { } })
    cur
}
rpush = (s: String, a: MutPtr<Malloc>, b: u8) String { s.gstr_push(a, b) }
rappend = (s: String, a: MutPtr<Malloc>, t: string_view) String { s.gstr_append(a, t) }
rappend_string = (s: String, a: MutPtr<Malloc>, src: String) String { a.mappend_string(s, src) }
rcopy_from = (s: String, a: MutPtr<Malloc>, src: String, i: i64) String { a.mcopy_from(s, src, i) }
rappend_span = (s: String, a: MutPtr<Malloc>, src: string_view, p: i32, e: i32) String { a.mappend_span(s, src, p, e) }
mcopy_id_dotted = (a: MutPtr<Malloc>, out: String, id: String, i: i64) String {
    cur := out
    bs: [u8] := id.bytes()
    bs.loop((h, idx, b) {
        (idx < i).match ({ true => { }, false => (b == '/').match ({ true => {
            cur = cur.gstr_push(a, '.')
        }, false => {
            cur = cur.gstr_push(a, b)
        } }) })
    })
    cur
}
mappend_id_name = (a: MutPtr<Malloc>, out: String, id: String) String {
    cur := out
    id.id_is_user().match ({ true => {
        cur = a.mcopy_from(cur, id, 2)
    }, false => {
        cur = a.mcopy_id_dotted(cur, id, 0)
    } })
    cur
}
madd_name = (a: MutPtr<Malloc>, set: String, name: String) String {
    hs := a.mappend_string(set, name)
    hs.gstr_push(a, 10)
}
madd_str_name = (a: MutPtr<Malloc>, set: String, name: string_view) String {
    hs := set.gstr_append(a, name)
    hs.gstr_push(a, 10)
}
Closure*: {
    seen: String,
    out: String,
    useen: String,
}
empty_closure = (a: MutPtr<Malloc>) Closure {
    Closure(
        seen: a.gstr_string(256),
        out: a.gstr_string(4096),
        useen: a.gstr_string(64),
    )
}
ImportEdge*: {
    module: string_view,
    alias: string_view,
    namespace: bool,
    start: i32,
    next: i32,
}
ProvidedSymbol*: {
    name: string_view,
    start: i32,
    next: i32,
    decl_start: i32,
    decl_next: i32,
    imported: bool,
    foreign: bool,
    is_type: bool,
    is_pub: bool,
}    // is_pub: the decl name carries the `*` export marker (imported symbols: false)
ModuleGraph*: {
    imports: [ImportEdge],
    symbols: [ProvidedSymbol],
    import_count = (g: ModuleGraph) i64 { g.imports.len }
    symbol_count = (g: ModuleGraph) i64 { g.symbols.len }
    has = (g: ModuleGraph, name: string_view) bool { g.symbols.has_symbol(name) }
}
decl_names_in* = (g: ModuleGraph, a: MutPtr<Malloc>) String { a.symbol_names_into_in(a.gstr_string(256), g.symbols, 0, false, false) }
// Like decl_names_in, but ALSO excludes TYPE (struct/enum) decls. A namespace alias prefixes only the
// names this returns with `alias__`; TYPE names are deliberately left bare so the same type reached two
// ways (`x = mod` vs `{ T } = mod`) keeps ONE canonical C identity (dedup_decls then collapses the copies).
value_decl_names_in* = (g: ModuleGraph, a: MutPtr<Malloc>) String { a.value_symbol_names_into_in(a.gstr_string(256), g.symbols, 0) }
all_decl_names_in* = (g: ModuleGraph, a: MutPtr<Malloc>) String { a.symbol_names_into_in(a.gstr_string(256), g.symbols, 0, false, true) }
ModuleEntry*: {
    id: string_view,
    path: string_view,
    source: string_view,
    graph: ModuleGraph,
}
string_eq_str = (name: String, s: string_view) bool {
    ok := true
    bs: [u8] := name.bytes()
    bs.loop((h, i, b) {
        ok.match ({ true => (s.at(to_i32(i)) == b).match ({ true => { }, false => {
            ok = false
            h.break
        } }), false => {
            h.break
        } })
    })
    ok && s.at(to_i32(name.len)) == 0
}
ModuleTable*: {
    modules: [ModuleEntry],
    count = (t: ModuleTable) i64 { t.modules.len }
    has = (t: ModuleTable, id: string_view) bool {
        found := false
        t.modules.loop((h, i, m) {
            found = eq(m.id, id).match ({ true => true, false => found })
        })
        found
    }
    has_id = (t: ModuleTable, id: String) bool {
        found := false
        t.modules.loop((h, i, m) {
            found = id.string_eq_str(m.id).match ({ true => true, false => found })
        })
        found
    }
    module = (t: ModuleTable, id: string_view) ModuleEntry {
        found := t.modules[0]
        t.modules.loop((h, i, m) {
            found = eq(m.id, id).match ({ true => m, false => found })
        })
        found
    }
    module_id = (t: ModuleTable, id: String) ModuleEntry {
        found := t.modules[0]
        t.modules.loop((h, i, m) {
            found = id.string_eq_str(m.id).match ({ true => m, false => found })
        })
        found
    }
}
ResolvedProgram*: {
    table: ModuleTable,
    flat: string_view,
    body_start: i64,
    body_end: i64,
}
ParsedModule*: {
    id: string_view,
    path: string_view,
    source: string_view,
    body: string_view,
    graph: ModuleGraph,
    decls: [Decl],
}
ParsedProgram*: {
    resolved: ResolvedProgram,
    modules: [ParsedModule],
    flat_decls: [Decl],
    count = (p: ParsedProgram) i64 { p.modules.len }
    module = (p: ParsedProgram, id: string_view) ParsedModule {
        found := p.modules[0]
        p.modules.loop((h, i, m) {
            found = eq(m.id, id).match ({ true => m, false => found })
        })
        found
    }
}
ModuleCount: {
    seen: String,
    count: i32,
}
ModuleFill: {
    seen: String,
    next: i32,
}
exit = (code: i32) i32
eprint = (s: string_view) i64 {
    v := view(s)
    write(2, v.ptr, v.len)
}
// ── NAMESPACE-IMPORT CYCLE GUARD ───────────────────────────────────────────────────────────────
// The namespace-closure loader (load_ns_closure_graph[_table] ↔ collect_ns_*) follows `m = pkg.mod`
// alias edges with no seen-set, so a self-referential or cyclic alias (`a = a`, or a→b→a) recurses
// forever and overflows the C stack (SIGSEGV). A nesting counter bounds it: real dependency chains
// are a handful deep (the whole compiler is well under the cap), so this never fires on acyclic input
// and leaves the flattened output byte-identical; a genuine cycle trips the cap and exits cleanly.
ns_depth := 0
NS_DEPTH_CAP := 256
fail_import_cycle = (a: MutPtr<Malloc>, inpath: string_view, id: String) i32 {
    msg0 := a.gstr_string(160).gstr_append(a, "zenc: ").gstr_append(a, inpath).gstr_append(a, ": error: import cycle through namespace alias '")
    msg1 := a.mappend_id_name(msg0, id)
    tail := msg1.gstr_append(a, "' (a module cannot namespace-import itself, directly or transitively)")
    line := tail.gstr_push(a, 10)
    eprint(line.gstr_finish(a))
    exit(1)
    0
}
// Probe first so missing modules get a distinct error from unreadable modules.
file_exists* = (path: string_view) bool {
    fd := open(path, O_RDONLY, 0)
    (fd >= 0).match ({ true => {
        close(fd)
        true
    }, false => false })
}
append_id_name = (out: String, a: MutPtr<Malloc>, id: String) String {
    cur := out
    id.id_is_user().match ({ true => {
        cur = cur.rcopy_from(a, id, 2)
    }, false => {
        cur = cur.copy_id_dotted(a, id, 0)
    } })
    cur
}
copy_id_dotted = (out: String, a: MutPtr<Malloc>, id: String, i: i64) String {
    cur := out
    bs: [u8] := id.bytes()
    bs.loop((h, idx, b) {
        (idx < i).match ({ true => { }, false => (b == '/').match ({ true => {
            cur = cur.rpush(a, '.')
        }, false => {
            cur = cur.rpush(a, b)
        } }) })
    })
    cur
}
fail_unknown_module = (a: MutPtr<Malloc>, inpath: string_view, id: String, path: string_view) i32 {
    msg := a.mappend_id_name(a.gstr_string(160).gstr_append(a, "zenc: ").gstr_append(a, inpath).gstr_append(a, ": error: unknown module '"), id)
    m2 := msg
    id.id_is_user().match ({ true => {
        u0 := msg.gstr_append(a, "' (no ")
        u1 := a.mcopy_from(u0, id, 2)
        m2 = u1.gstr_append(a, ".zen next to ").gstr_append(a, inpath)
    }, false => {
        m2 = msg.gstr_append(a, "' (no ").gstr_append(a, path)
    } })
    close_msg := m2.gstr_append(a, ")")
    line := close_msg.gstr_push(a, 10)
    eprint(line.gstr_finish(a))
    exit(1)
    0
}
// ── DOTTED LOCAL IMPORT GUARD ──────────────────────────────────────────────────────────────────
// `{ help } = util.helpers` matches NO marker: it isn't `= std.`/`= compiler.`, and the sibling
// marker requires a bare name (no dot). The line was silently skipped by the loader, the checker
// trusted the imported names, and the build died at link ("undefined reference to `help`") behind
// the compiler-bug banner. Catch the shape up front and tell the real story instead.
// end of a dotted module path (`util.helpers`) whose first identifier starts at `p`.
dotted_path_end = (s: string_view, p: i32) i32 {
    e := s.res_ident_end(p)
    (s.at(e) == '.' && s.at(e + 1).is_alpha()).match ({ true => s.dotted_path_end(e + 1), false => e })
}
// `= <ident>.<ident>…` where the head segment is neither `std` nor `compiler`.
is_dotted_user_marker_at = (s: string_view, p: i32) bool { (s.at(p) == '=' && s.at(p + 1) == ' ' && s.at(p + 2).is_alpha() && s.at(s.res_ident_end(p + 2)) == '.' && s.at(s.res_ident_end(p + 2) + 1).is_alpha()).match ({ true => s.is_marker_at(p).match ({ true => false, false => true }), false => false }) }
dotted_marker_after = (s: string_view, p: i32) i32 { (s.at(p) == ' ').match ({ true => s.dotted_marker_after(p + 1), false => s.is_dotted_user_marker_at(p).match ({ true => p, false => 0 - 1 }) }) }
// within ONE line: position of a `= a.b` marker after the import's closing `}`, else -1.
dotted_marker_from = (s: string_view, p: i32) i32 {
    b := s.at(p)
    (b == 0 || b == '\n').match ({ true => 0 - 1, false => (b == '}').match ({ true => s.dotted_marker_after(p + 1), false => s.dotted_marker_from(p + 1) }) })
}
fail_dotted_import = (a: MutPtr<Malloc>, inpath: string_view, src: string_view, p: i32) i32 {
    e := src.dotted_path_end(p)
    msg := a.gstr_string(256).gstr_append(a, "zenc: ").gstr_append(a, inpath).gstr_append(a, ": error: no module '")
    m2 := msg.rappend_span(a, src, p, e).gstr_append(a, "' (local imports name a single sibling file: `{ f } = helper` loads helper.zen next to ").gstr_append(a, inpath).gstr_append(a, "; only std/compiler modules use dotted paths, e.g. `std.text.fmt`)")
    line := m2.gstr_push(a, 10)
    eprint(line.gstr_finish(a))
    exit(1)
    0
}
scan_dotted_imports = (a: MutPtr<Malloc>, inpath: string_view, src: string_view) i32 {
    pos := 0
    bs: [u8] := src.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos).match ({ true => { }, false => {
            ls := src.lstrip(pos)
            mk := src.opens_import(ls).match ({ true => src.dotted_marker_from(ls), false => 0 - 1 })
            (mk >= 0).match ({ true => {
                a.fail_dotted_import(inpath, src, mk + 2)
            }, false => { } })
            pos = src.next_line(pos)
        } })
    })
    0
}
fail_unreadable = (a: MutPtr<Malloc>, inpath: string_view, path: string_view) string_view {
    msg := a.gstr_string(160).gstr_append(a, "zenc: ").gstr_append(a, inpath).gstr_append(a, ": error: cannot read module file ")
    with_path := msg.gstr_append(a, path)
    line := with_path.gstr_push(a, 10)
    eprint(line.gstr_finish(a))
    exit(1)
    ""
}
read_module_file = (a: MutPtr<Malloc>, path: string_view) Result<string_view, IoError> { a.contents_in(path) }
read_module = (a: MutPtr<Malloc>, inpath: string_view, path: string_view) string_view {
    a.read_module_file(path).match ({
        .Ok(s)  => {
            a.scan_dotted_imports(path, s)
            s
        },
        .Err(e) => a.fail_unreadable(inpath, path),
    })
}
import_edge_count_from = (src: string_view, p: i32, n: i32) i32 {
    pos := p
    count := n
    bs: [u8] := src.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos).match ({ true => { }, false => (src.is_import_line(pos) || src.is_ns_line(pos)).match ({ true => {
            count = count + 1
            pos = src.edge_next(pos)
        }, false => {
            pos = src.next_line(pos)
        } }) })
    })
    count
}
import_edge_count* = (src: string_view) i32 { src.import_edge_count_from(0, 0) }
edge_next = (src: string_view, p: i32) i32 { src.is_import_line(p).match ({ true => src.import_end(p), false => src.next_line(p) }) }
edge_buf<A> = (a: MutPtr<A>, n: i64) Result<[ImportEdge], IoError> {
    a.try_acquire(n * sizeof(ImportEdge)).match ({
        .Ok(p)  => ok(slice(p, n)),
        .Err(e) => err(e),
    })
}
EDGE_MODULE_CAP := 128
EDGE_ALIAS_CAP := 64
copy_lit_to = (buf: RawPtr<u8>, start: i64, lit: string_view, cap: i64) i64 {
    cur := start
    bs: [u8] := lit.view()
    bs.loop((h, i, b) {
        (cur >= cap - 1).match ({ true => {
            h.break
        }, false => {
            buf.offset(cur).store(b)
            cur = cur + 1
        } })
    })
    cur
}
copy_name_to = (buf: RawPtr<u8>, start: i64, s: string_view, p: i32, cap: i64) i64 {
    cur := start
    pos := p
    bs: [u8] := s.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos).match ({ true => { }, false => (cur >= cap - 1 || s.at(pos).is_alnum().match ({ true => false, false => true })).match ({ true => {
            h.break
        }, false => {
            buf.offset(cur).store(s.at(pos))
            cur = cur + 1
            pos = pos + 1
        } }) })
    })
    cur
}
copy_module_path_to = (buf: RawPtr<u8>, start: i64, s: string_view, p: i32, cap: i64) i64 {
    cur := start
    pos := p
    bs: [u8] := s.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos).match ({ true => { }, false => (cur >= cap - 1).match ({ true => {
            h.break
        }, false => s.at(pos).is_alnum().match ({ true => {
            buf.offset(cur).store(s.at(pos))
            cur = cur + 1
            pos = pos + 1
        }, false => (s.at(pos) == '.').match ({ true => {
            buf.offset(cur).store('/')
            cur = cur + 1
            pos = pos + 1
        }, false => {
            h.break
        } }) }) }) })
    })
    cur
}
write_import_id_at = (buf: RawPtr<u8>, s: string_view, p: i32, cap: i64) i64 { s.is_std_marker_at(p).match ({ true => buf.copy_module_path_to(buf.copy_lit_to(0, "std/", cap), s, p + STD_MARKER_LEN, cap), false => s.is_compiler_marker_at(p).match ({ true => buf.copy_module_path_to(buf.copy_lit_to(0, "compiler/", cap), s, p + COMPILER_MARKER_LEN, cap), false => s.is_user_marker_at(p).match ({ true => buf.copy_name_to(buf.copy_lit_to(0, "u/", cap), s, p + USER_MARKER_LEN, cap), false => 0 }) }) }) }
import_id_alloc<A> = (a: MutPtr<A>, s: string_view, p: i32) Result<string_view, IoError> {
    a.try_acquire(EDGE_MODULE_CAP).match ({
        .Ok(buf) => {
            pos := p
            out: i64 := 0
            bs: [u8] := s.view()
            bs.loop((h, i, b) {
                ii := to_i32(i)
                (ii < pos).match ({ true => { }, false => {
                    out = buf.write_import_id_at(s, pos, EDGE_MODULE_CAP)
                    (out > 0).match ({ true => {
                        h.break
                    }, false => {
                        pos = pos + 1
                    } })
                } })
            })
            buf.offset(out).store(0)
            ok(cstr(buf))
        },
        .Err(e)  => err(e),
    })
}
ns_qualifier_alloc<A> = (a: MutPtr<A>, s: string_view, p: i32) Result<string_view, IoError> {
    a.try_acquire(EDGE_ALIAS_CAP).match ({
        .Ok(buf) => {
            ls := s.lstrip(p)
            out := buf.copy_name_to(0, s, ls, EDGE_ALIAS_CAP)
            buf.offset(out).store(0)
            ok(cstr(buf))
        },
        .Err(e)  => err(e),
    })
}
edge_from_line<A> = (a: MutPtr<A>, src: string_view, p: i32) Result<ImportEdge, IoError> {
    ns := src.is_ns_line(p)
    a.import_id_alloc(src, p).match ({
        .Ok(mod) => ns.match ({ true => a.ns_qualifier_alloc(src, p).match ({
            .Ok(alias) => ok(ImportEdge(
                module: mod,
                alias: alias,
                namespace: ns,
                start: p,
                next: src.edge_next(p),
            )),
            .Err(e)    => err(e),
        }), false => ok(ImportEdge(
            module: mod,
            alias: "",
            namespace: ns,
            start: p,
            next: src.edge_next(p),
        )) }),
        .Err(e)  => err(e),
    })
}
fill_import_edges<A> = (a: MutPtr<A>, src: string_view, p: i32, out: [ImportEdge], i: i32) Result<[ImportEdge], IoError> {
    pos := p
    idx := i
    failed := false
    last_err: IoError := .NotFound
    bs: [u8] := src.view()
    bs.loop((h, n, b) {
        failed.match ({ true => {
            h.break
        }, false => {
            ii := to_i32(n)
            (ii < pos).match ({ true => { }, false => (src.is_import_line(pos) || src.is_ns_line(pos)).match ({ true => {
                a.edge_from_line(src, pos).match ({
                    .Ok(edge) => {
                        out[idx] = edge
                        idx = idx + 1
                        pos = src.edge_next(pos)
                    },
                    .Err(e)   => {
                        failed = true
                        last_err = e
                        h.break
                    },
                })
            }, false => {
                pos = src.next_line(pos)
            } }) })
        } })
    })
    failed.match ({ true => err(last_err), false => ok(out) })
}
import_edges*<A> = (a: MutPtr<A>, src: string_view) Result<[ImportEdge], IoError> {
    a.edge_buf(src.import_edge_count()).match ({
        .Ok(buf) => a.fill_import_edges(src, 0, buf, 0),
        .Err(e)  => err(e),
    })
}
edge_id_in = (e: ImportEdge, a: MutPtr<Malloc>) String { a.gstr_string(24).gstr_append(a, e.module) }
edge_alias_in = (e: ImportEdge, a: MutPtr<Malloc>) String { a.gstr_string(16).gstr_append(a, e.alias) }
edge_id = (e: ImportEdge, a: MutPtr<Malloc>) String { e.edge_id_in(a) }
fail_unknown_name = (a: MutPtr<Malloc>, inpath: string_view, nm: String, id: String) i32 {
    msg0 := a.gstr_string(160).gstr_append(a, "zenc: ").gstr_append(a, inpath).gstr_append(a, ": error: unknown name '")
    msg1 := a.mappend_string(msg0, nm)
    in_mod := msg1.gstr_append(a, "' in module '")
    msg2 := a.mappend_id_name(in_mod, id)
    tail := msg2.gstr_append(a, "' (no such top-level definition)")
    line := tail.gstr_push(a, 10)
    eprint(line.gstr_finish(a))
    exit(1)
    0
}
fail_dup_user = (a: MutPtr<Malloc>, inpath: string_view, id: String, nm: String, origin: String) i32 {
    msg0 := a.gstr_string(256).gstr_append(a, "zenc: ").gstr_append(a, inpath).gstr_append(a, ": error: duplicate top-level definition '")
    msg1 := a.mappend_string(msg0, nm)
    in_mod := msg1.gstr_append(a, "' (module '")
    msg2 := a.mappend_id_name(in_mod, id)
    redef := msg2.gstr_append(a, "' redefines '")
    rnm := a.mappend_string(redef, nm)
    from := rnm.gstr_append(a, "', already provided by '")
    msg3 := a.mappend_id_name(from, origin)
    tail := msg3.gstr_append(a, "')")
    l1 := tail.gstr_push(a, 10)
    // actionable hint: rename, or reach the original through a namespace alias instead of a bare import
    h0 := l1.gstr_append(a, "hint: rename '")
    h1 := a.mappend_string(h0, nm)
    h2 := h1.gstr_append(a, "', or import '")
    h3 := a.mappend_id_name(h2, origin)
    h4 := h3.gstr_append(a, "' qualified — e.g. `m = ")
    h5 := a.mappend_id_name(h4, origin)
    h6 := h5.gstr_append(a, "` then `m.")
    h7 := a.mappend_string(h6, nm)
    h8 := h7.gstr_append(a, "(...)`")
    line := h8.gstr_push(a, 10)
    eprint(line.gstr_finish(a))
    exit(1)
    0
}
fail_no_progdir = (a: MutPtr<Malloc>, inpath: string_view, id: String) i32 {
    msg0 := a.gstr_string(160).gstr_append(a, "zenc: ").gstr_append(a, inpath).gstr_append(a, ": error: sibling import '")
    msg1 := a.mappend_id_name(msg0, id)
    tail := msg1.gstr_append(a, "' needs a source file on disk (stdin has no directory to load it from)")
    line := tail.gstr_push(a, 10)
    eprint(line.gstr_finish(a))
    exit(1)
    0
}
module_path = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, id: String) string_view {
    out := a.gstr_string(64)
    id.id_is_user().match ({ true => {
        p0 := out.gstr_append(a, progdir)
        p1 := p0.gstr_append(a, "/")
        p2 := a.mcopy_from(p1, id, 2)
        out = p2.gstr_append(a, ".zen")
    }, false => {
        p0 := out.gstr_append(a, root)
        p1 := p0.gstr_append(a, "/zen/")
        p2 := a.mappend_string(p1, id)
        out = p2.gstr_append(a, ".zen")
    } })
    out.gstr_finish(a)
}
guard_module = (a: MutPtr<Malloc>, progdir: string_view, inpath: string_view, id: String, path: string_view) i32 {
    (id.id_is_user() && progdir.at(0) == 0).match ({ true => a.fail_no_progdir(inpath, id), false => 0 })
    file_exists(path).match ({ true => 0, false => a.fail_unknown_module(inpath, id, path) })
}
module_count_one = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, inpath: string_view, id: String, st: ModuleCount) ModuleCount {
    st.seen.seen_name(id).match ({ true => st, false => {
        path := a.module_path(root, progdir, id)
        a.guard_module(progdir, inpath, id, path)
        src := a.read_module(inpath, path)
        graph := a.module_graph(src)
        next := ModuleCount(
            seen: st.seen.add_name(a, id),
            count: st.count + 1,
        )
        a.module_count_edges(root, progdir, inpath, graph.imports, next)
    } })
}
module_count_edges = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, inpath: string_view, edges: [ImportEdge], st: ModuleCount) ModuleCount {
    cur := st
    edges.loop((h, i, edge) {
        cur = a.module_count_one(root, progdir, inpath, edge.edge_id_in(a), cur)
    })
    cur
}
module_table_count_graph = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, inpath: string_view, graph: ModuleGraph) i32 {
    a.module_count_edges(root, progdir, inpath, graph.imports, ModuleCount(
        seen: a.gstr_string(256),
        count: 1,
    )).count
}
module_entry_buf = (a: MutPtr<Malloc>, n: i64) [ModuleEntry] { slice(a.acquire(n * sizeof(ModuleEntry)), n) }
fill_module_one = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, inpath: string_view, id: String, out: [ModuleEntry], st: ModuleFill) ModuleFill {
    st.seen.seen_name(id).match ({ true => st, false => {
        path := a.module_path(root, progdir, id)
        a.guard_module(progdir, inpath, id, path)
        src := a.read_module(inpath, path)
        graph := a.module_graph(src)
        next_seen := st.seen.add_name(a, id)
        out[st.next] = ModuleEntry(
            id: id.gstr_finish(a),
            path: path,
            source: src,
            graph: graph,
        )
        next := ModuleFill(
            seen: next_seen,
            next: st.next + 1,
        )
        a.fill_module_edges(root, progdir, inpath, graph.imports, out, next)
    } })
}
fill_module_edges = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, inpath: string_view, edges: [ImportEdge], out: [ModuleEntry], st: ModuleFill) ModuleFill {
    cur := st
    edges.loop((h, i, edge) {
        cur = a.fill_module_one(root, progdir, inpath, edge.edge_id_in(a), out, cur)
    })
    cur
}
module_table_graph* = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, inpath: string_view, mainsrc: string_view, graph: ModuleGraph) ModuleTable {
    entries := a.module_entry_buf(a.module_table_count_graph(root, progdir, inpath, graph))
    entries[0] = ModuleEntry(
        id: "",
        path: inpath,
        source: mainsrc,
        graph: graph,
    )
    a.fill_module_edges(root, progdir, inpath, graph.imports, entries, ModuleFill(
        seen: a.gstr_string(256),
        next: 1,
    ))
    ModuleTable(modules: entries)
}
module_table* = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, inpath: string_view, mainsrc: string_view) ModuleTable {
    graph := a.module_graph(mainsrc)
    a.module_table_graph(root, progdir, inpath, mainsrc, graph)
}
// Legacy transitive loader; table-based resolve_program below is the checked path.
load_closure* = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, inpath: string_view, id: String, c: Closure) Closure {
    c.seen.seen_name(id).match ({ true => c, false => {
        path := a.module_path(root, progdir, id)
        a.guard_module(progdir, inpath, id, path)
        src := a.read_module(inpath, path)
        graph := a.module_graph(src)
        u2 := id.id_is_user().match ({ true => a.user_decls_from_symbols(c.useen, graph.symbols, 0, id, inpath), false => c.useen })
        c2 := Closure(
            seen: a.madd_name(c.seen, id),
            out: c.out,
            useen: u2,
        )
        c3 := a.load_import_graph(root, progdir, inpath, src, graph, id.id_is_user(), c2)
        ns := a.collect_ns_graph(root, progdir, inpath, src, graph, a.ns_scan(c3))
        body := ns.c.out.strip_ns_into(a, src, 0, ns.quals, ns.qnames, ns.strip_qnames, ns.strip_all_quals, false)
        Closure(
            seen: ns.c.seen,
            out: body,
            useen: ns.c.useen,
        )
    } })
}
load_import_edges = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, inpath: string_view, src: string_view, edges: [ImportEdge], i: i64, validate: bool, c: Closure) Closure {
    cur := c
    edges.loop((h, idx, edge) {
        (idx < i).match ({ true => { }, false => edge.namespace.match ({ true => { }, false => {
            id := edge.edge_id_in(a)
            cur = a.load_closure(root, progdir, inpath, id, cur)
            validate.match ({ true => a.check_import_names(root, progdir, inpath, src, edge.start, id), false => 0 })
        } }) })
    })
    cur
}
load_import_graph = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, inpath: string_view, src: string_view, graph: ModuleGraph, validate: bool, c: Closure) Closure { a.load_import_edges(root, progdir, inpath, src, graph.imports, 0, validate, c) }
load_ns_edge = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, inpath: string_view, src: string_view, edge: ImportEdge, st: NsScan) NsScan {
    modid := edge.edge_id_in(a)
    alias := edge.edge_alias_in(a)
    path := a.module_path(root, progdir, modid)
    a.guard_module(progdir, inpath, modid, path)
    msrc := a.read_module(inpath, path)
    graph := a.module_graph(msrc)
    names := graph.value_decl_names_in(a)
    all := graph.all_decl_names_in(a)
    c2 := a.load_ns_closure_graph(root, progdir, inpath, modid, alias, msrc, graph, st.c)
    q2 := a.madd_name(st.quals, alias)
    qn2 := st.qnames.add_qual_names(a, alias, names, 0)
    sqn2 := st.strip_qnames.add_qual_names(a, alias, all, 0)
    saq2 := modid.id_is_std_io_c().match ({ true => a.madd_name(st.strip_all_quals, alias), false => st.strip_all_quals })
    NsScan(
        quals: q2,
        qnames: qn2,
        strip_qnames: sqn2,
        strip_all_quals: saq2,
        c: c2,
    )
}
collect_ns_graph = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, inpath: string_view, src: string_view, graph: ModuleGraph, st: NsScan) NsScan { a.collect_ns_edges(root, progdir, inpath, src, graph.imports, 0, st) }
collect_ns_edges = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, inpath: string_view, src: string_view, edges: [ImportEdge], i: i64, st: NsScan) NsScan {
    cur := st
    edges.loop((h, idx, edge) {
        (idx < i).match ({ true => { }, false => edge.namespace.match ({ true => {
            cur = a.load_ns_edge(root, progdir, inpath, src, edge, cur)
        }, false => { } }) })
    })
    cur
}
load_closure_table = (a: MutPtr<Malloc>, table: ModuleTable, inpath: string_view, id: String, c: Closure) Closure {
    c.seen.seen_name(id).match ({ true => c, false => {
        entry := table.module_id(id)
        graph := entry.graph
        u2 := id.id_is_user().match ({ true => a.user_decls_from_symbols(c.useen, graph.symbols, 0, id, inpath), false => c.useen })
        c2 := Closure(
            seen: a.madd_name(c.seen, id),
            out: c.out,
            useen: u2,
        )
        c3 := a.load_import_graph_table(table, inpath, entry.source, graph, id.id_is_user(), c2)
        ns := a.collect_ns_graph_table(table, inpath, entry.source, graph, a.ns_scan(c3))
        body := ns.c.out.strip_ns_into(a, entry.source, 0, ns.quals, ns.qnames, ns.strip_qnames, ns.strip_all_quals, false)
        Closure(
            seen: ns.c.seen,
            out: body,
            useen: ns.c.useen,
        )
    } })
}
load_import_edges_table = (a: MutPtr<Malloc>, table: ModuleTable, inpath: string_view, src: string_view, edges: [ImportEdge], i: i64, validate: bool, c: Closure) Closure {
    cur := c
    edges.loop((h, idx, edge) {
        (idx < i).match ({ true => { }, false => edge.namespace.match ({ true => { }, false => {
            id := edge.edge_id_in(a)
            cur = a.load_closure_table(table, inpath, id, cur)
            validate.match ({ true => table.check_import_names_table(a, src, edge.start, id, inpath), false => 0 })
        } }) })
    })
    cur
}
load_import_graph_table = (a: MutPtr<Malloc>, table: ModuleTable, inpath: string_view, src: string_view, graph: ModuleGraph, validate: bool, c: Closure) Closure { a.load_import_edges_table(table, inpath, src, graph.imports, 0, validate, c) }
load_ns_edge_table = (a: MutPtr<Malloc>, table: ModuleTable, inpath: string_view, src: string_view, edge: ImportEdge, st: NsScan) NsScan {
    modid := edge.edge_id_in(a)
    alias := edge.edge_alias_in(a)
    entry := table.module_id(modid)
    graph := entry.graph
    names := graph.value_decl_names_in(a)
    all := graph.all_decl_names_in(a)
    c2 := a.load_ns_closure_graph_table(table, inpath, modid, alias, entry.source, graph, st.c)
    q2 := a.madd_name(st.quals, alias)
    qn2 := st.qnames.add_qual_names(a, alias, names, 0)
    sqn2 := st.strip_qnames.add_qual_names(a, alias, all, 0)
    saq2 := modid.id_is_std_io_c().match ({ true => a.madd_name(st.strip_all_quals, alias), false => st.strip_all_quals })
    NsScan(
        quals: q2,
        qnames: qn2,
        strip_qnames: sqn2,
        strip_all_quals: saq2,
        c: c2,
    )
}
collect_ns_edges_table = (a: MutPtr<Malloc>, table: ModuleTable, inpath: string_view, src: string_view, edges: [ImportEdge], i: i64, st: NsScan) NsScan {
    cur := st
    edges.loop((h, idx, edge) {
        (idx < i).match ({ true => { }, false => edge.namespace.match ({ true => {
            cur = a.load_ns_edge_table(table, inpath, src, edge, cur)
        }, false => { } }) })
    })
    cur
}
collect_ns_graph_table = (a: MutPtr<Malloc>, table: ModuleTable, inpath: string_view, src: string_view, graph: ModuleGraph, st: NsScan) NsScan { a.collect_ns_edges_table(table, inpath, src, graph.imports, 0, st) }
// Import-head validation: `{ f, g } = m` must be provided by `m`.
provided_head_count = (src: string_view, p: i32, n: i32) i32 {
    pos := p
    count := n
    bs: [u8] := src.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos).match ({ true => { }, false => (b == '}' || b == 0).match ({ true => {
            h.break
        }, false => b.is_alpha().match ({ true => {
            count = count + 1
            pos = src.res_ident_end(pos)
        }, false => {
            pos = pos + 1
        } }) }) })
    })
    count
}
provided_symbol_count_from = (a: MutPtr<Malloc>, src: string_view, p: i32, n: i32) i32 {
    pos := p
    count := n
    bs: [u8] := src.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos).match ({ true => { }, false => src.is_import_line(pos).match ({ true => {
            count = src.provided_head_count(src.lstrip(pos) + 1, count)
            pos = src.import_end(pos)
        }, false => src.is_ns_line(pos).match ({ true => {
            pos = src.next_line(pos)
        }, false => {
            sp := a.decl_span(src, pos)
            (sp.eof || sp.next <= pos).match ({ true => {
                h.break
            }, false => {
                count = sp.named.match ({ true => count + 1, false => count })
                pos = sp.next
            } })
        } }) }) })
    })
    count
}
provided_symbol_count* = (a: MutPtr<Malloc>, src: string_view) i32 { a.provided_symbol_count_from(src, 0, 0) }
symbol_buf<A> = (a: MutPtr<A>, n: i64) Result<[ProvidedSymbol], IoError> {
    a.try_acquire(n * sizeof(ProvidedSymbol)).match ({
        .Ok(p)  => ok(slice(p, n)),
        .Err(e) => err(e),
    })
}
symbol_name_len = (src: string_view, p: i32, e: i32, escape: bool) i64 {
    base := to_i64(e - p)
    (escape && src.is_c_kw_name_span(p, e)).match ({ true => base + 3, false => base })
}
// Copy src[p..e) into buf[0..), returning the count written. Iterates a sub-slice that starts at `p`
// — NOT a scan from 0, and NOT recursive — so it is O(e-p) with constant stack.
copy_symbol_span_to = (buf: RawPtr<u8>, src: string_view, p: i32, e: i32) i64 {
    cur: i64 := 0
    (p < e).match ({ true => {
        span: [u8] := slice(src.offset(p), to_i64(e - p))
        span.loop((h, i, b) {
            buf.offset(cur).store(b)
            cur = cur + 1
        })
    }, false => { } })
    cur
}
finish_symbol_name = (buf: RawPtr<u8>, src: string_view, p: i32, e: i32, escape: bool) string_view {
    cur := buf.copy_symbol_span_to(src, p, e)
    (escape && src.is_c_kw_name_span(p, e)).match ({ true => {
        buf.offset(cur).store('_')
        buf.offset(cur + 1).store('z')
        buf.offset(cur + 2).store('k')
        cur = cur + 3
    }, false => { } })
    buf.offset(cur).store(0)
    cstr(buf)
}
symbol_name_alloc<A> = (a: MutPtr<A>, src: string_view, p: i32, e: i32, escape: bool) Result<string_view, IoError> {
    a.try_acquire(src.symbol_name_len(p, e, escape) + 1).match ({
        .Ok(buf) => ok(buf.finish_symbol_name(src, p, e, escape)),
        .Err(e)  => err(e),
    })
}
fill_head_symbols_in<A> = (alloc: MutPtr<A>, src: string_view, p: i32, out: [ProvidedSymbol], i: i32) Result<i32, IoError> {
    pos := p
    idx := i
    failed := false
    last_err: IoError := .NotFound
    bs: [u8] := src.view()
    bs.loop((h, n, b) {
        failed.match ({ true => {
            h.break
        }, false => {
            ii := to_i32(n)
            (ii < pos).match ({ true => { }, false => (b == '}' || b == 0).match ({ true => {
                h.break
            }, false => b.is_alpha().match ({ true => {
                ie := src.res_ident_end(pos)
                alloc.symbol_name_alloc(src, pos, ie, true).match ({
                    .Ok(name) => {
                        out[idx] = ProvidedSymbol(
                            name: name,
                            start: pos,
                            next: ie,
                            decl_start: pos,
                            decl_next: ie,
                            imported: true,
                            foreign: false,
                            is_type: false,
                            is_pub: false,
                        )
                        idx = idx + 1
                        pos = ie
                    },
                    .Err(e)   => {
                        failed = true
                        last_err = e
                        h.break
                    },
                })
            }, false => {
                pos = pos + 1
            } }) }) })
        } })
    })
    failed.match ({ true => err(last_err), false => ok(idx) })
}
fill_provided_symbols_in<A> = (a: MutPtr<Malloc>, alloc: MutPtr<A>, src: string_view, p: i32, out: [ProvidedSymbol], i: i32) Result<[ProvidedSymbol], IoError> {
    pos := p
    idx := i
    failed := false
    last_err: IoError := .NotFound
    bs: [u8] := src.view()
    bs.loop((h, n, b) {
        failed.match ({ true => {
            h.break
        }, false => {
            ii := to_i32(n)
            (ii < pos).match ({ true => { }, false => src.is_import_line(pos).match ({ true => {
                alloc.fill_head_symbols_in(src, src.lstrip(pos) + 1, out, idx).match ({
                    .Ok(next) => {
                        idx = next
                        pos = src.import_end(pos)
                    },
                    .Err(e)   => {
                        failed = true
                        last_err = e
                        h.break
                    },
                })
            }, false => src.is_ns_line(pos).match ({ true => {
                pos = src.next_line(pos)
            }, false => {
                sp := a.decl_span(src, pos)
                (sp.eof || sp.next <= pos).match ({ true => {
                    h.break
                }, false => {
                    sp.named.match ({ true => {
                        ie := src.res_ident_end(sp.start)
                        alloc.symbol_name_alloc(src, sp.start, ie, false).match ({
                            .Ok(name) => {
                                out[idx] = ProvidedSymbol(
                                    name: name,
                                    start: sp.start,
                                    next: ie,
                                    decl_start: sp.start,
                                    decl_next: sp.next,
                                    imported: false,
                                    foreign: src.is_foreign_span(sp.start, sp.next),
                                    is_type: sp.is_type,
                                    is_pub: src.at(ie) == '*',
                                )
                                idx = idx + 1
                            },
                            .Err(e)   => {
                                failed = true
                                last_err = e
                                h.break
                            },
                        })
                    }, false => { } })
                    pos = sp.next
                } })
            } }) }) })
        } })
    })
    failed.match ({ true => err(last_err), false => ok(out) })
}
provided_symbols_in*<A> = (a: MutPtr<Malloc>, alloc: MutPtr<A>, src: string_view) Result<[ProvidedSymbol], IoError> {
    alloc.symbol_buf(a.provided_symbol_count(src)).match ({
        .Ok(buf) => a.fill_provided_symbols_in(alloc, src, 0, buf, 0),
        .Err(e)  => err(e),
    })
}
provided_symbols* = (a: MutPtr<Malloc>, src: string_view) Result<[ProvidedSymbol], IoError> { a.provided_symbols_in(a, src) }
module_graph* = (a: MutPtr<Malloc>, src: string_view) ModuleGraph { a.module_graph_in(a, src) }
module_graph_in*<A> = (a: MutPtr<Malloc>, alloc: MutPtr<A>, src: string_view) ModuleGraph {
    ModuleGraph(
        imports: alloc.import_edges(src).expect("std.internal.resolve: allocation failed"),
        symbols: a.provided_symbols_in(alloc, src).expect("std.internal.resolve: allocation failed"),
    )
}
name_prefix_eq = (raw: string_view, wanted: string_view, i: i32, e: i32) bool { (i == e).match ({ true => true, false => raw.at(i) == wanted.at(i) && raw.name_prefix_eq(wanted, i + 1, e) }) }
escaped_name_eq = (raw: string_view, wanted: string_view) bool {
    e := raw.res_ident_end(0)
    raw.is_c_kw_name_span(0, e) && raw.name_prefix_eq(wanted, 0, e) && wanted.at(e) == '_' && wanted.at(e + 1) == 'z' && wanted.at(e + 2) == 'k' && wanted.at(e + 3) == 0
}
symbol_matches = (s: ProvidedSymbol, name: string_view) bool { eq(s.name, name) || s.name.escaped_name_eq(name) }
symbol_key_in*<A> = (s: ProvidedSymbol, a: MutPtr<A>) Result<String, IoError> {
    e := s.name.res_ident_end(0)
    n := s.name.symbol_name_len(0, e, true)
    a.try_acquire(n + 1).match ({
        .Ok(buf) => {
            buf.finish_symbol_name(s.name, 0, e, true)
            ok(String(
                ptr: buf,
                len: n,
                cap: n + 1,
            ))
        },
        .Err(e2) => err(e2),
    })
}
has_symbol = (symbols: [ProvidedSymbol], name: string_view) bool {
    found := false
    symbols.loop((h, i, s) {
        found = s.symbol_matches(name).match ({ true => true, false => found })
    })
    found
}
span_has_byte = (s: string_view, p: i32, e: i32, b: u8) bool { (p >= e).match ({ true => false, false => (s.at(p) == b).match ({ true => true, false => s.span_has_byte(p + 1, e, b) }) }) }
is_foreign_span = (s: string_view, p: i32, e: i32) bool { s.span_has_byte(p, e, '=') && s.span_has_byte(p, e, '{').match ({ true => false, false => true }) }
symbol_name_in = (s: ProvidedSymbol, a: MutPtr<Malloc>) String { a.gstr_string(s.name.view().len + 1).gstr_append(a, s.name) }
symbol_allowed = (s: ProvidedSymbol, include_imported: bool, include_foreign: bool) bool { (include_imported || s.imported.match ({ true => false, false => true })) && (include_foreign || s.foreign.match ({ true => false, false => true })) }
symbol_names_into = (set: String, a: MutPtr<Malloc>, symbols: [ProvidedSymbol], i: i64, include_imported: bool, include_foreign: bool) String {
    cur := set
    symbols.loop((h, idx, sym) {
        (idx < i).match ({ true => { }, false => sym.symbol_allowed(include_imported, include_foreign).match ({ true => {
            cur = cur.rappend(a, sym.name).rpush(a, 10)
        }, false => { } }) })
    })
    cur
}
symbol_names_into_in = (a: MutPtr<Malloc>, set: String, symbols: [ProvidedSymbol], i: i64, include_imported: bool, include_foreign: bool) String {
    cur := set
    symbols.loop((h, idx, sym) {
        (idx < i).match ({ true => { }, false => sym.symbol_allowed(include_imported, include_foreign).match ({ true => {
            cur = a.madd_str_name(cur, sym.name)
        }, false => { } }) })
    })
    cur
}
// Module-DEFINED value/fn decl names only: non-imported, non-foreign, and NOT a type (struct/enum).
value_symbol_names_into_in = (a: MutPtr<Malloc>, set: String, symbols: [ProvidedSymbol], i: i64) String {
    cur := set
    symbols.loop((h, idx, sym) {
        (idx < i).match ({ true => { }, false => (sym.symbol_allowed(false, false) && sym.is_type.match ({ true => false, false => true })).match ({ true => {
            cur = a.madd_str_name(cur, sym.name)
        }, false => { } }) })
    })
    cur
}
// Map-set forms of imported_value_names / value_symbol_names_into_in — same filters, O(1)-membership
// presence sets for shadow_rename_set (see rset_*). value_symbol_name_set keys on `sym.name` (the raw
// clean identifier), matching the original allnames String that shadow_mangled(key) is looked up against.
imported_value_name_set = (a: MutPtr<Malloc>, m: Map<i64>, symbols: [ProvidedSymbol]) Map<i64> {
    cur := m
    symbols.loop((h, idx, sym) {
        (sym.imported && sym.is_type.match ({ true => false, false => true })).match ({ true => {
            cur = cur.rset_add(a, sym.symbol_key_in(a).expect("std.internal.resolve: allocation failed"))
        }, false => { } })
    })
    cur
}
value_symbol_name_set = (a: MutPtr<Malloc>, m: Map<i64>, symbols: [ProvidedSymbol]) Map<i64> {
    cur := m
    symbols.loop((h, idx, sym) {
        (sym.symbol_allowed(false, false) && sym.is_type.match ({ true => false, false => true })).match ({ true => {
            cur = cur.rset_add_str(a, sym.name)
        }, false => { } })
    })
    cur
}
alias_decl_names = (a: MutPtr<Malloc>, src: string_view) String { a.module_graph(src).decl_names_in(a) }
span_eq_lit = (s: string_view, p: i32, e: i32, lit: string_view, i: i32) bool { (p + i == e).match ({ true => lit.at(i) == 0, false => (lit.at(i) == 0).match ({ true => false, false => s.at(p + i) == lit.at(i) && s.span_eq_lit(p, e, lit, i + 1) }) }) }
span_eq_name = (s: string_view, p: i32, e: i32, lit: string_view) bool { s.span_eq_lit(p, e, lit, 0) }
is_c_kw_name_span = (s: string_view, p: i32, e: i32) bool { s.span_eq_name(p, e, "double") || s.span_eq_name(p, e, "short") || s.span_eq_name(p, e, "long") || s.span_eq_name(p, e, "int") || s.span_eq_name(p, e, "char") || s.span_eq_name(p, e, "float") || s.span_eq_name(p, e, "unsigned") || s.span_eq_name(p, e, "signed") || s.span_eq_name(p, e, "union") || s.span_eq_name(p, e, "struct") || s.span_eq_name(p, e, "enum") || s.span_eq_name(p, e, "typedef") || s.span_eq_name(p, e, "static") || s.span_eq_name(p, e, "extern") || s.span_eq_name(p, e, "const") || s.span_eq_name(p, e, "volatile") || s.span_eq_name(p, e, "register") || s.span_eq_name(p, e, "auto") || s.span_eq_name(p, e, "inline") || s.span_eq_name(p, e, "restrict") || s.span_eq_name(p, e, "if") || s.span_eq_name(p, e, "else") || s.span_eq_name(p, e, "for") || s.span_eq_name(p, e, "while") || s.span_eq_name(p, e, "do") || s.span_eq_name(p, e, "switch") || s.span_eq_name(p, e, "case") || s.span_eq_name(p, e, "default") || s.span_eq_name(p, e, "goto") || s.span_eq_name(p, e, "void") || s.span_eq_name(p, e, "continue") || s.span_eq_name(p, e, "break") }
mimport_name_span = (a: MutPtr<Malloc>, flat: string_view, p: i32, e: i32) String { a.mappend_span(a.gstr_string(16), flat, p, e) }
mimport_head_name = (a: MutPtr<Malloc>, src: string_view, p: i32, e: i32) String {
    raw := a.mimport_name_span(src, p, e)
    out := raw
    src.is_c_kw_name_span(p, e).match ({ true => {
        out = raw.gstr_append(a, "_zk")
    }, false => { } })
    out
}
check_import_names = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, inpath: string_view, src: string_view, p: i32, id: String) i32 {
    graph := a.module_graph(a.read_module(inpath, a.module_path(root, progdir, id)))
    src.check_head(a, src.lstrip(p) + 1, graph.symbols, id, inpath)
}
check_import_names_table = (table: ModuleTable, a: MutPtr<Malloc>, src: string_view, p: i32, id: String, inpath: string_view) i32 {
    entry := table.module_id(id)
    src.check_head(a, src.lstrip(p) + 1, entry.graph.symbols, id, inpath)
}
check_head = (src: string_view, a: MutPtr<Malloc>, p: i32, provided: [ProvidedSymbol], id: String, inpath: string_view) i32 {
    pos := p
    bs: [u8] := src.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos).match ({ true => { }, false => (b == '}' || b == 0).match ({ true => {
            h.break
        }, false => b.is_alpha().match ({ true => {
            ie := src.res_ident_end(pos)
            raw := a.mimport_name_span(src, pos, ie)
            hd := a.mimport_head_name(src, pos, ie)
            nm := hd.gstr_finish(a)
            provided.has_symbol(nm).match ({ true => 0, false => a.fail_unknown_name(inpath, raw, id) })
            pos = ie
        }, false => {
            pos = pos + 1
        } }) }) })
    })
    0
}
// `useen` entries are `key\tORIGIN_ID\n`: the dedup key plus the id of the module that FIRST
// provided that name, so a later redefinition can name BOTH modules in the diagnostic. Only
// user_symbol_seen reads/writes useen, so this richer format stays internal to these helpers.
useen_key_eq = (set: String, i: i64, name: String, j: i64, m: i64) bool { (j == m).match ({ true => set.res_sbyte(i) == '\t', false => (set.res_sbyte(i) == name.res_sbyte(j)).match ({ true => set.useen_key_eq(i + 1, name, j + 1, m), false => false }) }) }
useen_tab = (set: String, i: i64) i64 { (i >= set.len || set.res_sbyte(i) == '\n').match ({ true => i, false => (set.res_sbyte(i) == '\t').match ({ true => i + 1, false => set.useen_tab(i + 1) }) }) }
useen_line_origin = (out: String, a: MutPtr<Malloc>, set: String, i: i64) String { (i >= set.len || set.res_sbyte(i) == '\n').match ({ true => out, false => out.rpush(a, set.res_sbyte(i)).useen_line_origin(a, set, i + 1) }) }
// Origin id of `key` in `useen`, or an empty String if `key` has not been registered yet.
useen_origin = (a: MutPtr<Malloc>, useen: String, key: String, i: i64) String { (i >= useen.len).match ({ true => a.gstr_string(1), false => useen.useen_key_eq(i, key, 0, key.len).match ({ true => useen_line_origin(a.gstr_string(24), a, useen, useen.useen_tab(i)), false => a.useen_origin(useen, key, useen.snext_line(i)) }) }) }
useen_add = (a: MutPtr<Malloc>, useen: String, key: String, id: String) String { useen.rappend_string(a, key).rpush(a, '\t').rappend_string(a, id).rpush(a, 10) }
user_symbol_seen = (a: MutPtr<Malloc>, useen: String, s: ProvidedSymbol, id: String, inpath: string_view) String {
    key := s.symbol_key_in(a).expect("std.internal.resolve: allocation failed")
    origin := a.useen_origin(useen, key, 0)
    (origin.len > 0).match ({ true => a.fail_dup_user(inpath, id, s.symbol_name_in(a), origin), false => 0 })
    a.useen_add(useen, key, id)
}
user_decls_from_symbols = (a: MutPtr<Malloc>, useen: String, symbols: [ProvidedSymbol], i: i64, id: String, inpath: string_view) String {
    cur := useen
    symbols.loop((h, idx, sym) {
        (idx < i).match ({ true => { }, false => sym.imported.match ({ true => { }, false => {
            cur = a.user_symbol_seen(cur, sym, id, inpath)
        } }) })
    })
    cur
}
user_decls_into = (a: MutPtr<Malloc>, useen: String, src: string_view, p: i32, id: String, inpath: string_view) String { a.user_decls_from_symbols(useen, a.module_graph(src).symbols, 0, id, inpath) }
first_user_import_in* = (a: MutPtr<Malloc>, src: string_view) string_view {
    hs := fui_scan(a.gstr_string(16), a, src, 0)
    hs.gstr_finish(a)
}
// Bootstrap main.c links this C ABI before it can pass allocator state.
first_user_import* = (src: string_view) string_view {
    a := Malloc(_: 0)
    first_user_import_in(a.addr(), src)
}
fui_scan = (out: String, a: MutPtr<Malloc>, src: string_view, p: i32) String {
    cur := out
    pos := p
    done := false
    bs: [u8] := src.view()
    bs.loop((h, i, b) {
        done.match ({ true => {
            h.break
        }, false => (src.at(pos) == 0).match ({ true => {
            h.break
        }, false => src.is_import_line(pos).match ({ true => {
            mk := src.import_marker_from(src.lstrip(pos))
            src.is_user_marker_at(mk).match ({ true => {
                cur = cur.take_name(a, src, mk + USER_MARKER_LEN)
                done = true
                h.break
            }, false => {
                pos = src.import_end(pos)
            } })
        }, false => {
            pos = src.next_line(pos)
        } }) }) })
    })
    cur
}
// Per-name dedup keeps user shadowing visible for validation. Repo-internal
// std/compiler entry modules may own a natural export name over dependency
// closures, because their dependencies are implementation details.
res_ident_end = (flat: string_view, p: i32) i32 { flat.at(p).is_alnum().match ({ true => flat.res_ident_end(p + 1), false => p }) }
import_name_span = (out: String, a: MutPtr<Malloc>, flat: string_view, p: i32, e: i32) String { (p == e).match ({ true => out, false => out.rpush(a, flat.at(p)).import_name_span(a, flat, p + 1, e) }) }
append_to_nul = (out: String, a: MutPtr<Malloc>, s: string_view, p: i32) String {
    cur := out
    bs: [u8] := s.view()
    bs.loop((h, i, b) {
        (i < p).match ({ true => { }, false => {
            cur = cur.rpush(a, b)
        } })
    })
    cur
}
path_has_at = (s: string_view, p: i32, lit: string_view, i: i32) bool { (lit.at(i) == 0).match ({ true => true, false => (s.at(p + i) == 0).match ({ true => false, false => s.at(p + i) == lit.at(i) && s.path_has_at(p, lit, i + 1) }) }) }
path_contains_from = (s: string_view, p: i32, lit: string_view) bool { (s.at(p) == 0).match ({ true => lit.at(0) == 0, false => s.path_has_at(p, lit, 0).match ({ true => true, false => s.path_contains_from(p + 1, lit) }) }) }
path_contains = (s: string_view, lit: string_view) bool { s.path_contains_from(0, lit) }
internal_source_path = (path: string_view) bool { path.path_contains("/zen/std/") || path.path_contains("zen/std/") || path.path_contains("/zen/compiler/") || path.path_contains("zen/compiler/") }
main_symbol_names = (a: MutPtr<Malloc>, set: String, symbols: [ProvidedSymbol], i: i64, bodystart: i64, bodyend: i64) String {
    cur := set
    symbols.loop((h, idx, sym) {
        (idx < i).match ({ true => { }, false => sym.imported.match ({ true => { }, false => {
            key := sym.symbol_key_in(a).expect("std.internal.resolve: allocation failed")
            inmain := sym.start >= bodystart && sym.start < bodyend
            cur = (inmain && cur.seen_name(key).match ({ true => false, false => true })).match ({ true => a.madd_name(cur, key), false => cur })
        } }) })
    })
    cur
}
dedup_decls* = (a: MutPtr<Malloc>, flat: string_view, bodystart: i64, bodyend: i64) string_view { a.dedup_decls_mode(flat, bodystart, bodyend, false) }
dedup_decls_mode = (a: MutPtr<Malloc>, flat: string_view, bodystart: i64, bodyend: i64, allow_main_shadow: bool) string_view {
    symbols := a.module_graph(flat).symbols
    main_names := allow_main_shadow.match ({ true => a.main_symbol_names(a.gstr_string(256), symbols, 0, bodystart, bodyend), false => a.gstr_string(64) })
    hs := a.dedup_symbols(a.gstr_string(4096), flat, symbols, 0, 0, a.gstr_string(256), a.gstr_string(64), main_names, bodystart, bodyend, allow_main_shadow)
    hs.gstr_finish(a)
}
dedup_symbols = (a: MutPtr<Malloc>, out: String, flat: string_view, symbols: [ProvidedSymbol], i: i64, p: i32, set: String, mainset: String, main_names: String, bodystart: i64, bodyend: i64, allow_main_shadow: bool) String {
    cur := out
    pos := p
    seen := set
    main_seen := mainset
    symbols.loop((h, idx, sym) {
        (idx < i).match ({ true => { }, false => sym.imported.match ({ true => { }, false => {
            nm := sym.symbol_key_in(a).expect("std.internal.resolve: allocation failed")
            inmain := sym.start >= bodystart && sym.start < bodyend
            shadow := allow_main_shadow && inmain.match ({ true => false, false => true }) && main_names.seen_name(nm)
            keep := shadow.match ({ true => false, false => inmain.match ({ true => true, false => seen.seen_name(nm).match ({ true => main_seen.seen_name(nm), false => true }) }) })
            cur = cur.rappend_span(a, flat, pos, sym.decl_start)
            keep.match ({ true => {
                cur = cur.rappend_span(a, flat, sym.decl_start, sym.decl_next)
            }, false => { } })
            seen = shadow.match ({ true => seen, false => seen.seen_name(nm).match ({ true => seen, false => a.madd_name(seen, nm) }) })
            main_seen = inmain.match ({ true => a.madd_name(main_seen, nm), false => main_seen })
            pos = sym.decl_next
        } }) })
    })
    cur.append_to_nul(a, flat, pos)
}
// ── impl-block dedup ─────────────────────────────────────────────────────────────────────────
// A `T.impl(Trait, {…})` block carries no ProvidedSymbol (decl_span marks it unnamed), so the
// per-name dedup above never touches it. Once TYPE names are canonicalized (value_decl_names_in keeps
// them bare across import paths), the SAME module reached two ways — a namespace alias `x = M` plus a
// by-name/other-alias load of M — emits its impls twice with the SAME canonical receiver, e.g. two
// `Heap.impl(Allocator)` → duplicate `impl_Allocator_Heap_*` functions. A trait has at most one impl per
// (canonical) type, so two blocks with the same `<receiver>.<trait>` key are redundant copies: keep the
// first, drop the rest. Distinct impls (different receiver OR trait) get distinct keys and all survive.
impl_lparen = (s: string_view, p: i32) i32 { (s.at(p) == 0).match ({ true => p, false => (s.at(p) == '(').match ({ true => p + 1, false => s.impl_lparen(p + 1) }) }) }
impl_key_in = (a: MutPtr<Malloc>, s: string_view, p: i32) String {
    re := s.res_ident_end(p)    // receiver ident `Heap`
    ts := s.lstrip(s.impl_lparen(re))    // first arg of `.impl(` — the trait
    te := s.res_ident_end(ts)
    a.gstr_string(40).rappend_span(a, s, p, re).gstr_append(a, ".").rappend_span(a, s, ts, te)
}
dedup_impls* = (a: MutPtr<Malloc>, flat: string_view) string_view { a.dedup_impls_into(a.gstr_string(4096), flat, 0, a.gstr_string(128)).gstr_finish(a) }
dedup_impls_into = (a: MutPtr<Malloc>, out: String, flat: string_view, p: i32, seen: String) String {
    cur := out
    pos := p
    seen2 := seen
    bs: [u8] := flat.view()
    bs.loop((h, n, b) {
        ii := to_i32(n)
        (ii < pos).match ({ true => { }, false => {
            sp := a.decl_span(flat, pos)
            (sp.eof || sp.next <= pos).match ({ true => {
                h.break
            }, false => {
                cur = cur.rappend_span(a, flat, pos, sp.start)
                drop := flat.decl_is_impl(sp.start).match ({ true => {
                    key := a.impl_key_in(flat, sp.start)
                    seen2.seen_name(key).match ({ true => true, false => {
                        seen2 = a.madd_name(seen2, key)
                        false
                    } })
                }, false => false })
                drop.match ({ true => { }, false => {
                    cur = cur.rappend_span(a, flat, sp.start, sp.next)
                } })
                pos = sp.next
            } })
        } })
    })
    cur.append_to_nul(a, flat, pos)
}
// Namespace binds load `c = std.io.c` / `m = sibling` under an alias prefix.
// `c.libc()` rewrites to `c__libc()`, and the bound module's own declarations
// are prefixed the same way, so two modules can export the same short name.
is_ns_line* = (s: string_view, p: i32) bool {
    ls := s.lstrip(p)
    (p == ls).match ({ true => s.at(ls).is_alnum().match ({ true => s.is_any_marker_at(s.lstrip(s.res_ident_end(ls))), false => false }), false => false })
}
ns_qualifier* = (out: String, a: MutPtr<Malloc>, s: string_view, p: i32) String {
    ls := s.lstrip(p)
    out.import_name_span(a, s, ls, s.res_ident_end(ls))
}
NsScan*: {
    quals: String,
    qnames: String,
    strip_qnames: String,
    strip_all_quals: String,
    c: Closure,
}
ns_scan = (a: MutPtr<Malloc>, c: Closure) NsScan {
    NsScan(
        quals: a.gstr_string(64),
        qnames: a.gstr_string(128),
        strip_qnames: a.gstr_string(128),
        strip_all_quals: a.gstr_string(64),
        c: c,
    )
}
alias_name = (out: String, a: MutPtr<Malloc>, alias: String, name: String) String { out.rappend_string(a, alias).rappend(a, "__").rappend_string(a, name) }
alias_hit = (s: string_view, p: i32, ie: i32, names: String, nm: String) bool {
    after_dot := p > 0 && s.at(p - 1) == '.'
    rewrite_member := after_dot.match ({ true => s.at(s.lstrip(ie)) == '(', false => true })
    names.seen_name(nm) && rewrite_member
}
rewrite_alias_copy = (out: String, a: MutPtr<Malloc>, s: string_view, p: i32, names: String, alias: String) String {
    s.line_comment_at(p).match ({ true => {
        sk := out.copy_line_comment(a, s, p)
        sk.out.rewrite_alias_names(a, s, sk.next, names, alias)
    }, false => s.block_comment_at(p).match ({ true => {
        sk := out.copy_block_comment(a, s, p)
        sk.out.rewrite_alias_names(a, s, sk.next, names, alias)
    }, false => s.quoted_at(p).match ({ true => {
        sk := out.copy_literal(a, s, p)
        sk.out.rewrite_alias_names(a, s, sk.next, names, alias)
    }, false => out.rpush(a, s.at(p)).rewrite_alias_names(a, s, p + 1, names, alias) }) }) })
}
rewrite_alias_names = (out: String, a: MutPtr<Malloc>, s: string_view, p: i32, names: String, alias: String) String {
    cur := out
    pos := p
    bs: [u8] := s.str_bytes()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos).match ({ true => { }, false => (b == 0).match ({ true => {
            h.break
        }, false => s.line_comment_at(pos).match ({ true => {
            sk := cur.copy_line_comment(a, s, pos)
            cur = sk.out
            pos = sk.next
        }, false => s.block_comment_at(pos).match ({ true => {
            sk := cur.copy_block_comment(a, s, pos)
            cur = sk.out
            pos = sk.next
        }, false => s.quoted_at(pos).match ({ true => {
            sk := cur.copy_literal(a, s, pos)
            cur = sk.out
            pos = sk.next
        }, false => (b.is_alpha() && (pos == 0 || s.at(pos - 1).is_alnum().match ({ true => false, false => true }))).match ({ true => {
            ie := s.res_ident_end(pos)
            nm := a.mimport_name_span(s, pos, ie)
            cur = s.alias_hit(pos, ie, names, nm).match ({ true => cur.alias_name(a, alias, nm), false => cur.rappend_span(a, s, pos, ie) })
            pos = ie
        }, false => {
            cur = cur.rpush(a, b)
            pos = pos + 1
        } }) }) }) }) }) })
    })
    cur
}
alias_module_body = (a: MutPtr<Malloc>, src: string_view, graph: ModuleGraph, alias: String, quals: String, qnames: String, strip_qnames: String, strip_all_quals: String) String {
    names := graph.value_decl_names_in(a)
    hs := a.gstr_string(4096).strip_ns_into(a, src, 0, quals, qnames, strip_qnames, strip_all_quals, true)
    body := hs.gstr_finish(a)
    // Record this alias prefix so the checker's UFCS-alias fallback treats only `alias__` decls as
    // alias-shaped (never a plain user fn that merely has `__` in its name). Fresh NUL-terminated copy.
    note_alias_prefix(a.gstr_string(16).rappend_string(a, alias).gstr_finish(a))
    a.gstr_string(4096).rewrite_alias_names(a, body, 0, names, alias)
}
line_name = (out: String, a: MutPtr<Malloc>, names: String, i: i64) String { (i >= names.len || names.res_sbyte(i) == '\n').match ({ true => out, false => out.rpush(a, names.res_sbyte(i)).line_name(a, names, i + 1) }) }
add_qual_name = (set: String, a: MutPtr<Malloc>, alias: String, name: String) String { set.rappend_string(a, alias).rpush(a, '.').rappend_string(a, name).rpush(a, 10) }
add_qual_names = (set: String, a: MutPtr<Malloc>, alias: String, names: String, i: i64) String {
    (i >= names.len).match ({ true => set, false => {
        nm := line_name(a.gstr_string(16), a, names, i)
        set.add_qual_name(a, alias, nm).add_qual_names(a, alias, names, names.snext_line(i))
    } })
}
load_ns_closure_graph = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, inpath: string_view, id: String, alias: String, src: string_view, graph: ModuleGraph, c: Closure) Closure {
    (ns_depth > NS_DEPTH_CAP).match ({ true => {
        a.fail_import_cycle(inpath, id)
    } })    // cyclic alias — exit cleanly, never recurse to overflow
    ns_depth = ns_depth + 1
    c2 := a.load_import_graph(root, progdir, inpath, src, graph, id.id_is_user(), c)
    ns := a.collect_ns_graph(root, progdir, inpath, src, graph, a.ns_scan(c2))
    body := a.alias_module_body(src, graph, alias, ns.quals, ns.qnames, ns.strip_qnames, ns.strip_all_quals)
    ns_depth = ns_depth - 1
    Closure(
        seen: ns.c.seen,
        out: ns.c.out.rpush(a, 10).rappend_string(a, body),
        useen: ns.c.useen,
    )
}
load_ns_closure_graph_table = (a: MutPtr<Malloc>, table: ModuleTable, inpath: string_view, id: String, alias: String, src: string_view, graph: ModuleGraph, c: Closure) Closure {
    (ns_depth > NS_DEPTH_CAP).match ({ true => {
        a.fail_import_cycle(inpath, id)
    } })    // cyclic alias — exit cleanly, never recurse to overflow
    ns_depth = ns_depth + 1
    c2 := a.load_import_graph_table(table, inpath, src, graph, id.id_is_user(), c)
    ns := a.collect_ns_graph_table(table, inpath, src, graph, a.ns_scan(c2))
    body := a.alias_module_body(src, graph, alias, ns.quals, ns.qnames, ns.strip_qnames, ns.strip_all_quals)
    ns_depth = ns_depth - 1
    Closure(
        seen: ns.c.seen,
        out: ns.c.out.rpush(a, 10).rappend_string(a, body),
        useen: ns.c.useen,
    )
}
load_ns_closure = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, inpath: string_view, id: String, alias: String, src: string_view, c: Closure) Closure {
    graph := a.module_graph(src)
    a.load_ns_closure_graph(root, progdir, inpath, id, alias, src, graph, c)
}
collect_ns* = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, inpath: string_view, src: string_view, p: i32, st: NsScan) NsScan {
    graph := a.module_graph(src)
    a.collect_ns_graph(root, progdir, inpath, src, graph, st)
}
is_qual_access = (s: string_view, a: MutPtr<Malloc>, p: i32, ie: i32, quals: String) bool { (s.at(ie) == '.' && s.at(ie + 1).is_alpha()).match ({ true => quals.seen_name(a.mimport_name_span(s, p, ie)), false => false }) }
qualified_name = (out: String, a: MutPtr<Malloc>, s: string_view, p: i32, ie: i32) String { out.rappend_span(a, s, p, ie).rpush(a, '.').rappend_span(a, s, ie + 1, s.res_ident_end(ie + 1)) }
rewrite_quals = (out: String, a: MutPtr<Malloc>, s: string_view, p: i32, quals: String, qnames: String, strip_qnames: String, strip_all_quals: String) String {
    cur := out
    pos := p
    bs: [u8] := s.str_bytes()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos).match ({ true => { }, false => (b == 0).match ({ true => {
            h.break
        }, false => s.line_comment_at(pos).match ({ true => {
            sk := cur.copy_line_comment(a, s, pos)
            cur = sk.out
            pos = sk.next
        }, false => s.block_comment_at(pos).match ({ true => {
            sk := cur.copy_block_comment(a, s, pos)
            cur = sk.out
            pos = sk.next
        }, false => s.quoted_at(pos).match ({ true => {
            sk := cur.copy_literal(a, s, pos)
            cur = sk.out
            pos = sk.next
        }, false => (b.is_alpha() && (pos == 0 || s.at(pos - 1).is_alnum().match ({ true => false, false => true }))).match ({ true => {
            ie := s.res_ident_end(pos)
            s.is_qual_access(a, pos, ie, quals).match ({ true => {
                alias := a.mimport_name_span(s, pos, ie)
                qn := qualified_name(a.gstr_string(32), a, s, pos, ie)
                me := s.res_ident_end(ie + 1)
                qnames.seen_name(qn).match ({ true => {
                    cur = cur.rappend_span(a, s, pos, ie).rappend(a, "__")
                    pos = ie + 1
                }, false => (strip_qnames.seen_name(qn) || strip_all_quals.seen_name(alias)).match ({ true => {
                    pos = ie + 1
                }, false => {
                    cur = cur.rappend_span(a, s, pos, me)
                    pos = me
                } }) })
            }, false => {
                cur = cur.rappend_span(a, s, pos, ie)
                pos = ie
            } })
        }, false => {
            cur = cur.rpush(a, b)
            pos = pos + 1
        } }) }) }) }) }) })
    })
    cur
}
strip_ns_lines_into = (out: String, a: MutPtr<Malloc>, s: string_view, p: i32, first: bool) String {
    cur := out
    pos := p
    is_first := first
    bs: [u8] := s.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos).match ({ true => { }, false => s.is_import_line(pos).match ({ true => {
            pos = s.import_end(pos)
        }, false => s.is_ns_line(pos).match ({ true => {
            pos = s.next_line(pos)
        }, false => {
            e := s.line_end(pos)
            cur = is_first.match ({ true => cur.rappend_span(a, s, pos, e), false => cur.rpush(a, 10).rappend_span(a, s, pos, e) })
            is_first = false
            pos = s.next_line(pos)
        } }) }) })
    })
    cur
}
strip_ns_into* = (out: String, a: MutPtr<Malloc>, s: string_view, p: i32, quals: String, qnames: String, strip_qnames: String, strip_all_quals: String, first: bool) String {
    hs := a.gstr_string(4096).strip_ns_lines_into(a, s, p, true)
    raw := hs.gstr_finish(a)
    (raw.at(0) == 0).match ({ true => out, false => {
        base := first.match ({ true => out, false => out.rpush(a, 10) })
        (quals.len == 0).match ({ true => base.rappend(a, raw), false => base.rewrite_quals(a, raw, 0, quals, qnames, strip_qnames, strip_all_quals) })
    } })
}
module_body = (a: MutPtr<Malloc>, table: ModuleTable, inpath: string_view, entry: ModuleEntry) string_view {
    ns := a.collect_ns_graph_table(table, inpath, entry.source, entry.graph, a.ns_scan(a.empty_closure()))
    hs := a.gstr_string(4096).strip_ns_into(a, entry.source, 0, ns.quals, ns.qnames, ns.strip_qnames, ns.strip_all_quals, true)
    hs.gstr_finish(a)
}
parsed_module_buf = (a: MutPtr<Malloc>, n: i64) [ParsedModule] { slice(a.acquire(n * sizeof(ParsedModule)), n) }
parse_module_entry = (a: MutPtr<Malloc>, table: ModuleTable, inpath: string_view, entry: ModuleEntry) ParsedModule {
    body := a.module_body(table, inpath, entry)
    ParsedModule(
        id: entry.id,
        path: entry.path,
        source: entry.source,
        body: body,
        graph: entry.graph,
        decls: a.parse_module(body),
    )
}
parse_resolved_program* = (a: MutPtr<Malloc>, resolved: ResolvedProgram, inpath: string_view) ParsedProgram {
    mods := a.parsed_module_buf(resolved.table.count())
    resolved.table.modules.loop((h, i, entry) {
        mods[i] = a.parse_module_entry(resolved.table, inpath, entry)
    })
    ParsedProgram(
        resolved: resolved,
        modules: mods,
        flat_decls: a.parse_module(resolved.flat),
    )
}
resolve_parsed_program* = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, inpath: string_view, mainsrc: string_view) ParsedProgram { a.parse_resolved_program(a.resolve_program_data(root, progdir, inpath, mainsrc), inpath) }
parsed_decl_buf = (a: MutPtr<Malloc>, n: i64) [Decl] { slice(a.acquire(n * sizeof(Decl)), n) }
append_decls_to = (dst: [Decl], at: i64, src: [Decl]) i64 {
    j := at
    src.loop((h, i, d) {
        dst[j] = d
        j = j + 1
    })
    j
}
alias_edge_decls = (a: MutPtr<Malloc>, p: ParsedProgram, edge: ImportEdge) [Decl] {
    entry := p.resolved.table.module(edge.module)
    ns := a.collect_ns_graph_table(p.resolved.table, p.module("").path, entry.source, entry.graph, a.ns_scan(a.empty_closure()))
    hs := a.alias_module_body(entry.source, entry.graph, edge.edge_alias_in(a), ns.quals, ns.qnames, ns.strip_qnames, ns.strip_all_quals)
    body := hs.gstr_finish(a)
    a.parse_module(body)
}
root_link_edge_decls = (a: MutPtr<Malloc>, p: ParsedProgram, edge: ImportEdge) [Decl] { edge.namespace.match ({ true => a.alias_edge_decls(p, edge), false => p.module(edge.module).decls }) }
module_link_count* = (a: MutPtr<Malloc>, p: ParsedProgram, m: ParsedModule) i64 {
    n := 0
    m.graph.imports.loop((h, i, edge) {
        n = n + a.root_link_edge_decls(p, edge).len
    })
    n
}
module_link_decls* = (a: MutPtr<Malloc>, p: ParsedProgram, m: ParsedModule) [Decl] {
    buf := a.parsed_decl_buf(a.module_link_count(p, m))
    j := 0
    m.graph.imports.loop((h, i, edge) {
        j = buf.append_decls_to(j, a.root_link_edge_decls(p, edge))
    })
    slice(buf.ptr, j)
}
root_link_count* = (a: MutPtr<Malloc>, p: ParsedProgram) i64 { a.module_link_count(p, p.module("")) }
root_link_decls* = (a: MutPtr<Malloc>, p: ParsedProgram) [Decl] { a.module_link_decls(p, p.module("")) }
check_parsed_program* = (a: MutPtr<Malloc>, p: ParsedProgram) i32 {
    root := p.module("")
    a.check_linked(root.decls, a.root_link_decls(p))
}
check_parsed_program_kind* = (a: MutPtr<Malloc>, p: ParsedProgram) i32 {
    root := p.module("")
    a.check_linked_kind(root.decls, a.root_link_decls(p))
}
// Graph-linked validation for EVERY module body: each ParsedModule is checked against the import
// library built from its own ModuleGraph edges (not only the root). Positions stay in the module's
// stripped body — the incremental step toward a full symbol-table/module-world resolver (GOALS #5).
check_all_parsed_modules* = (a: MutPtr<Malloc>, p: ParsedProgram) i32 {
    acc := 0
    p.modules.loop((h, i, m) {
        acc = acc + a.check_linked(m.decls, a.module_link_decls(p, m))
    })
    acc
}
check_all_parsed_modules_kind* = (a: MutPtr<Malloc>, p: ParsedProgram) i32 {
    acc := 0
    p.modules.loop((h, i, m) {
        acc = acc + a.check_linked_kind(m.decls, a.module_link_decls(p, m))
    })
    acc
}
// ── VISIBILITY: `*` exports are ENFORCED across modules (error[private-name]) ─────────────────────
// A top-level name is cross-module visible only when its declaration carries the `*` export marker
// (`name* = …`, `Type*: …`, `GLOBAL* := …`). Both consumption forms are checked per module, over the
// ORIGINAL module sources, so the diagnostic points at the exact user line:col:
//   • flat import heads:    `{ hidden } = mod`                    → error[private-name] at `hidden`
//   • alias-qualified uses: `m = mod` + `m.hidden(…)`/`m.Hidden`  → error[private-name] at `hidden`
// A name the target module itself only IMPORTS stays importable (transitive re-export is the one
// sanctioned pass-through; visibility is decided at the DEFINING module's head). `c = std.io.c`-style
// aliases skip the qualified scan: their qualifiers are stripped wholesale (strip_all_quals), the
// module is a raw libc surface. ZEN_VIS_REPORT=1 downgrades the error to a report-only sweep (print
// every violation, never exit) — the migration mode used to prove the tree clean before enforcing.
vis_report_mode = () bool { is_empty(getEnv("ZEN_VIS_REPORT")).match ({ true => false, false => true }) }
// 1-based line number of byte `p` (loop over the source slice, not recursion: sources are large).
vis_line_of = (s: string_view, p: i32) i32 {
    n := 1
    bs: [u8] := s.view()
    bs.loop((h, i, b) {
        (to_i32(i) >= p).match ({ true => {
            h.break
        }, false => (b == '\n').match ({ true => {
            n = n + 1
        }, false => { } }) })
    })
    n
}
// start of the line containing `p` (backward scan; lines are short, recursion is bounded).
vis_bol = (s: string_view, p: i32) i32 { (p <= 0).match ({ true => 0, false => (s.at(p - 1) == '\n').match ({ true => p, false => s.vis_bol(p - 1) }) }) }
vis_fail = (a: MutPtr<Malloc>, path: string_view, src: string_view, pos: i32, width: i32, name: String, id: String, report: bool) i32 {
    line := src.vis_line_of(pos)
    col := pos - src.vis_bol(pos) + 1
    m0 := a.gstr_string(192).gstr_append(a, "`")
    m1 := a.mappend_string(m0, name)
    m2 := m1.gstr_append(a, "` is private in module '")
    m3 := a.mappend_id_name(m2, id)
    msg := m3.gstr_append(a, "' (its declaration has no `*` export)").gstr_finish(a)
    h0 := a.gstr_string(128).gstr_append(a, "export it with `")
    h1 := a.mappend_string(h0, name)
    hint := h1.gstr_append(a, "*` in the defining module, or use the module's public surface").gstr_finish(a)
    eprint(a.render_diagnostic(path, src, line, col, col + width - 1, "private-name", msg, hint, 1))
    report.match ({ true => 0, false => exit(1) })
}
// does `name` match a symbol the target module DEFINES but does not export? (imported symbols
// pass through — re-export; unknown names are left to the existing unknown-name validation.)
vis_symbol_private = (symbols: [ProvidedSymbol], name: string_view) bool {
    priv := false
    found := false
    symbols.loop((h, i, s) {
        found.match ({ true => { }, false => s.symbol_matches(name).match ({ true => {
            found = true
            priv = s.imported.match ({ true => false, false => s.is_pub.match ({ true => false, false => true }) })
        }, false => { } }) })
    })
    priv
}
// flat import head `{ a, b } = mod` at line start `p`: every name must be exported by `mod`.
vis_check_head = (a: MutPtr<Malloc>, path: string_view, src: string_view, p: i32, target: ModuleGraph, id: String, report: bool) i32 {
    pos := src.lstrip(p) + 1
    bs: [u8] := src.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos).match ({ true => { }, false => (b == '}' || b == 0).match ({ true => {
            h.break
        }, false => b.is_alpha().match ({ true => {
            ie := src.res_ident_end(pos)
            hd := a.mimport_head_name(src, pos, ie)
            target.symbols.vis_symbol_private(hd.gstr_finish(a)).match ({ true => {
                a.vis_fail(path, src, pos, ie - pos, a.mimport_name_span(src, pos, ie), id, report)
            }, false => { } })
            pos = ie
        }, false => {
            pos = pos + 1
        } }) }) })
    })
    0
}
// skip past a (possibly unterminated) `/* … */` block comment without copying.
vis_skip_block = (s: string_view, p: i32) i32 {
    pos := p + 2
    bs: [u8] := s.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos).match ({ true => { }, false => (b == 0).match ({ true => {
            h.break
        }, false => (b == '*' && s.at(ii + 1) == '/').match ({ true => {
            pos = ii + 2
            h.break
        }, false => {
            pos = ii + 1
        } }) }) })
    })
    pos
}
// skip past a quoted literal (string or char) without copying, honoring escapes.
vis_skip_lit = (s: string_view, p: i32) i32 {
    q := s.at(p)
    pos := p
    esc := false
    bs: [u8] := s.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos).match ({ true => { }, false => (b == 0).match ({ true => {
            h.break
        }, false => {
            pos = pos + 1
            esc.match ({ true => {
                esc = false
            }, false => (b == '\\').match ({ true => {
                esc = true
            }, false => (ii > p && b == q).match ({ true => {
                h.break
            }, false => { } }) }) })
        } }) })
    })
    pos
}
// s[p..e) == w, byte-exact (idents are short; recursion is bounded).
vis_span_eq_at = (s: string_view, p: i32, e: i32, w: String, j: i64) bool { (p + to_i32(j) == e).match ({ true => j == w.len, false => (j < w.len && s.at(p + to_i32(j)) == w.res_sbyte(j)).match ({ true => s.vis_span_eq_at(p, e, w, j + 1), false => false }) }) }
// alias-qualified uses `alias.name` in `src`: `name` must be exported by the aliased module.
// Comment/string spans are skipped; the ident-boundary + dot shape mirrors rewrite_quals exactly,
// so anything the rewriter WOULD have resolved is what gets visibility-checked.
vis_scan_quals = (a: MutPtr<Malloc>, path: string_view, src: string_view, alias: String, target: ModuleGraph, id: String, report: bool) i32 {
    pos := 0
    bs: [u8] := src.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos).match ({ true => { }, false => (b == 0).match ({ true => {
            h.break
        }, false => src.line_comment_at(pos).match ({ true => {
            pos = src.next_line(pos)
        }, false => src.block_comment_at(pos).match ({ true => {
            pos = src.vis_skip_block(pos)
        }, false => src.quoted_at(pos).match ({ true => {
            pos = src.vis_skip_lit(pos)
        }, false => (b.is_alpha() && (pos == 0 || src.at(pos - 1).is_alnum().match ({ true => false, false => true }))).match ({ true => {
            ie := src.res_ident_end(pos)
            (src.vis_span_eq_at(pos, ie, alias, 0) && src.at(ie) == '.' && src.at(ie + 1).is_alpha()).match ({ true => {
                me := src.res_ident_end(ie + 1)
                nm := a.mimport_name_span(src, ie + 1, me)
                target.symbols.vis_symbol_private(nm.gstr_finish(a)).match ({ true => {
                    a.vis_fail(path, src, ie + 1, me - ie - 1, a.mimport_name_span(src, ie + 1, me), id, report)
                }, false => { } })
                pos = me
            }, false => {
                pos = ie
            } })
        }, false => {
            pos = pos + 1
        } }) }) }) }) }) })
    })
    0
}
vis_enforce_edge = (a: MutPtr<Malloc>, table: ModuleTable, path: string_view, src: string_view, edge: ImportEdge, report: bool) i32 {
    id := edge.edge_id_in(a)
    table.has_id(id).match ({ true => {
        entry := table.module_id(id)
        edge.namespace.match ({ true => id.id_is_std_io_c().match ({ true => 0, false => a.vis_scan_quals(path, src, edge.edge_alias_in(a), entry.graph, id, report) }), false => a.vis_check_head(path, src, edge.start, entry.graph, id, report) })
    }, false => 0 })
}
enforce_visibility* = (a: MutPtr<Malloc>, table: ModuleTable, report: bool) i32 {
    table.modules.loop((h, i, entry) {
        entry.graph.imports.loop((h2, j, edge) {
            a.vis_enforce_edge(table, entry.path, entry.source, edge, report)
        })
    })
    0
}
// ── user-name shadow rename ────────────────────────────────────────────────────────────────────
// THE #1 newcomer bounce: a user's top-level helper (`len`/`split`/`map`/…) collides with a
// same-named PUBLIC decl pulled in TRANSITIVELY by an import the user never named (e.g. `std.io.file`
// drags in `std.text.str`, which exports `len*`). In the flat single-symbol namespace both decls
// survive → dup-fn (and a real C redefinition). Dropping the std decl is UNSAFE — std internals call
// it (`str.trim_prefix` itself calls `prefix.len()`), so the user's `len` would hijack std's. Instead
// we give the USER's colliding decl a distinct identity: rename it (and its in-body refs, bare + UFCS)
// to `zshadow__name`, exactly like a namespace-qualified decl — the whole std closure stays byte-for-byte
// untouched, the user's module simply shadows the unimported export. The `zshadow__`-prefix form is what
// diagnostic.zen's alias-`__`-removal inverse already un-mangles, so errors still render the user's name.
// Only fires for USER programs (never internal sources → seed unchanged) and only when it is provably
// safe (see shadow_rename_set). check_module never sees two same-named decls, so no dup-fn fires.
shadow_alias_of = (a: MutPtr<Malloc>) String { a.gstr_string(16).gstr_append(a, "zshadow") }
shadow_mangled = (a: MutPtr<Malloc>, name: String) String { a.gstr_string(name.len + 10).gstr_append(a, "zshadow__").rappend_string(a, name) }
// The set of user-body value-decl names to rename. A name qualifies iff it is a value decl (not a type,
// not an import binding) defined EXACTLY ONCE in the user body [lo,hi) (a name defined twice is a real
// user-vs-user dup → keep the error), whose name ALSO exists as a non-imported value decl OUTSIDE the
// body (the transitive/std export), that the user did NOT import by name, and whose mangled form is not
// already taken (else fall back to the dup-fn error rather than silently rebind).
shadow_rename_set = (a: MutPtr<Malloc>, flat: string_view, mainsrc: string_view, lo: i64, hi: i64) String {
    syms := a.module_graph(flat).symbols
    imported := a.imported_value_name_set(a.rset_new(), a.module_graph(mainsrc).symbols)
    allnames := a.value_symbol_name_set(a.rset_new(), syms)
    mainseen := a.rset_new()
    maindup := a.rset_new()
    nonmain := a.rset_new()
    syms.loop((h, i, s) {
        (s.imported || s.foreign || s.is_type).match ({ true => { }, false => {
            key := s.symbol_key_in(a).expect("std.internal.resolve: allocation failed")
            (s.decl_start >= lo && s.decl_start < hi).match ({ true => mainseen.rset_has(key).match ({ true => {
                maindup = maindup.rset_add(a, key)
            }, false => {
                mainseen = mainseen.rset_add(a, key)
            } }), false => nonmain.rset_has(key).match ({ true => { }, false => {
                nonmain = nonmain.rset_add(a, key)
            } }) })
        } })
    })
    // `out` stays the newline-delimited String the rewrite consumes; `outset` is its O(1) `fresh` mirror.
    out := a.gstr_string(64)
    outset := a.rset_new()
    syms.loop((h, i, s) {
        (s.imported || s.foreign || s.is_type).match ({ true => { }, false => {
            key := s.symbol_key_in(a).expect("std.internal.resolve: allocation failed")
            inmain := s.decl_start >= lo && s.decl_start < hi
            once := mainseen.rset_has(key) && maindup.rset_has(key).match ({ true => false, false => true })
            unimported := imported.rset_has(key).match ({ true => false, false => true })
            free := allnames.rset_has(a.shadow_mangled(key)).match ({ true => false, false => true })
            fresh := outset.rset_has(key).match ({ true => false, false => true })
            (inmain && once && nonmain.rset_has(key) && unimported && free && fresh).match ({ true => {
                out = a.madd_name(out, key)
                outset = outset.rset_add(a, key)
            }, false => { } })
        } })
    })
    out
}
ShadowFlat*: {
    flat: string_view,
    bodyend: i64,
}
// Given the pre-dedup flat, rename the user's colliding decls in the body region [lo,hi) and return the
// rewritten flat plus the shifted body end. `enable` is false for internal sources (byte-identical no-op).
shadow_flat = (a: MutPtr<Malloc>, pre: string_view, mainsrc: string_view, lo: i64, hi: i64, enable: bool) ShadowFlat {
    enable.match ({ true => {
        names := a.shadow_rename_set(pre, mainsrc, lo, hi)
        (names.len == 0).match ({ true => ShadowFlat(
            flat: pre,
            bodyend: hi,
        ), false => {
            main := a.gstr_string(hi - lo + 1).rappend_span(a, pre, to_i32(lo), to_i32(hi)).gstr_finish(a)
            rewS := a.gstr_string(4096).rewrite_alias_names(a, main, 0, names, a.shadow_alias_of())
            nf := a.gstr_string(4096).rappend_span(a, pre, 0, to_i32(lo)).rappend_string(a, rewS).append_to_nul(a, pre, to_i32(hi)).gstr_finish(a)
            ShadowFlat(
                flat: nf,
                bodyend: lo + rewS.len,
            )
        } })
    }, false => ShadowFlat(
        flat: pre,
        bodyend: hi,
    ) })
}
// ── MODULE-ALIAS NAME-COLLISION ATTRIBUTION (#66a) ───────────────────────────────────────────────
// A module alias `alias = std.x.y` flattens y's value decls under an `alias__` prefix, INCLUDING the
// method bodies of any type y defines whose method names also exist as top-level fns in y (e.g.
// std.text.string's `String.free_in` alongside the top-level allocator-side `free_in`). When ANOTHER
// module in the closure imports y UNQUALIFIED (`{ String } = std.text.string`), a second, un-prefixed
// copy of y's top-level fns is spliced in — but that copy carries NO struct-method definitions, so a
// bare `x.free_in(...)` call there misresolves to the swapped-arg top-level fn. The type error then
// surfaces deep inside the stdlib module with zero attribution to the user's alias line. This detects
// exactly that shape at resolve time and reports it AT THE USER'S IMPORT LINE with the fix. It is
// deliberately narrow: it fires only when (1) the user aliases a module that (2) has a name defined
// both top-level AND as a type method (the "split-name" shape), and (3) that module is ALSO imported
// unqualified somewhere in the closure — the exact conjunction that produces the divergent copies.
// Programs that alias non-split modules, or split modules that are never also imported bare, are
// unaffected (no false rejections).
res_line_of = (src: string_view, off: i32) i32 {
    no := 1
    bs: [u8] := src.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii >= off).match ({ true => {
            h.break
        }, false => (b == '\n').match ({ true => {
            no = no + 1
        }, false => { } }) })
    })
    no
}
res_col_of = (src: string_view, off: i32) i32 {
    ls := 0
    bs: [u8] := src.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii >= off).match ({ true => {
            h.break
        }, false => (b == '\n').match ({ true => {
            ls = ii + 1
        }, false => { } }) })
    })
    off - ls + 1
}
res_udec = (out: String, a: MutPtr<Malloc>, n: i32) String { (n < 10).match ({ true => out.gstr_push(a, ('0'.to_i64() + to_i64(n)).to_u8()), false => out.res_udec(a, n / 10).gstr_push(a, ('0'.to_i64() + to_i64(n % 10)).to_u8()) }) }
// index just past the matching `>` of a `<...>` generic list starting at `p` (the `<`). Method decl
// headers carry only flat lists (`<A>`, `<A, B>`), so a scan to the first `>` is exact.
skip_to_gt = (s: string_view, p: i32) i32 { (s.at(p) == 0 || s.at(p) == '>').match ({ true => p + 1, false => s.skip_to_gt(p + 1) }) }
after_generics = (s: string_view, j: i32) i32 { (s.at(j) == '<').match ({ true => s.skip_to_gt(j + 1), false => j }) }
// is the text at name-end `ie` the head of a fn decl — `<...>? *? = (` ?
is_fn_decl_after = (s: string_view, ie: i32) bool {
    j0 := s.after_generics(ie)
    j := (s.at(j0) == '*').match ({ true => j0 + 1, false => j0 })
    (s.at(j) == ' ').match ({ true => s.at(j + 1) == '=' && s.at(j + 2) == ' ' && s.at(j + 3) == '(', false => s.at(j) == '=' && s.at(j + 1) == ' ' && s.at(j + 2) == '(' })
}
// Newline-separated set of INDENTED fn-decl names in `src` that also appear in `topnames` (the
// module's top-level value decls) — i.e. every type method whose name shadows a top-level fn. Empty
// String if the module has no such split name (the common case; then no collision is possible).
split_names = (a: MutPtr<Malloc>, src: string_view, topnames: String) String {
    out := a.gstr_string(64)
    pos := 0
    bs: [u8] := src.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos).match ({ true => { }, false => (b == 0).match ({ true => {
            h.break
        }, false => {
            ls := src.lstrip(pos)
            (ls > pos && src.at(ls).is_alpha()).match ({ true => {
                ie := src.res_ident_end(ls)
                src.is_fn_decl_after(ie).match ({ true => {
                    nm := a.mimport_name_span(src, ls, ie)
                    topnames.seen_name(nm).match ({ true => {
                        out = a.madd_name(out, nm)
                    }, false => { } })
                }, false => { } })
            }, false => { } })
            pos = src.next_line(pos)
        } }) })
    })
    out
}
// The first `.<name>(` method-call in `src` whose `name` is one of `names` — i.e. a call that WOULD
// misresolve once the aliased module's matching method has been prefixed away. Empty String if none.
has_method_call_of = (a: MutPtr<Malloc>, src: string_view, names: String) String {
    out := a.gstr_string(16)
    pos := 0
    bs: [u8] := src.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos).match ({ true => { }, false => (b == 0).match ({ true => {
            h.break
        }, false => {
            (b == '.' && src.at(ii + 1).is_alpha()).match ({ true => {
                ie := src.res_ident_end(ii + 1)
                (src.at(ie) == '(').match ({ true => {
                    nm := a.mimport_name_span(src, ii + 1, ie)
                    names.seen_name(nm).match ({ true => {
                        out = nm
                        h.break
                    }, false => { } })
                }, false => { } })
            }, false => { } })
            pos = ii + 1
        } }) })
    })
    out
}
AliasCollision: {
    name: String,
    importer: string_view,
    found: bool,
}
// Scan every module in the closure EXCEPT the aliased module itself for a `.<split>(` call: that is
// the site that will misresolve to the swapped-arg top-level fn once the alias prefixes the method.
find_split_call_site = (a: MutPtr<Malloc>, table: ModuleTable, modid: string_view, splits: String) AliasCollision {
    res := AliasCollision(
        name: a.gstr_string(1),
        importer: "",
        found: false,
    )
    table.modules.loop((h, i, m) {
        skip := res.found.match ({ true => true, false => eq(m.id, modid) })
        skip.match ({ true => { }, false => {
            called := a.has_method_call_of(m.source, splits)
            (called.len > 0).match ({ true => {
                res = AliasCollision(
                    name: called,
                    importer: m.id,
                    found: true,
                )
            }, false => { } })
        } })
    })
    res
}
mappend_id_str_dotted = (a: MutPtr<Malloc>, out: String, id: string_view) String {
    cur := out
    bs: [u8] := id.view()
    bs.loop((h, i, b) {
        cur = (b == '/').match ({ true => cur.gstr_push(a, '.'), false => cur.gstr_push(a, b) })
    })
    cur
}
fail_alias_collision = (a: MutPtr<Malloc>, inpath: string_view, mainsrc: string_view, edge: ImportEdge, split: String, importer: string_view) i32 {
    line := mainsrc.res_line_of(edge.start)
    col := mainsrc.res_col_of(edge.start)
    m0 := a.gstr_string(320).gstr_append(a, "zenc: ").gstr_append(a, inpath).gstr_push(a, ':').res_udec(a, line).gstr_push(a, ':').res_udec(a, col).gstr_append(a, ": error[import-collision]: module alias `")
    m1 := m0.gstr_append(a, edge.alias).gstr_append(a, " = ")
    m2 := a.mappend_id_str_dotted(m1, edge.module).gstr_append(a, "` collides in the flat namespace")
    l1 := m2.gstr_push(a, 10)
    // detail: which other module pulls the same names in unqualified, and the shared name that breaks
    d0 := l1.gstr_append(a, "  `")
    d1 := a.mappend_id_str_dotted(d0, edge.module).gstr_append(a, "` is also imported unqualified by `")
    d2 := eq(importer, "").match ({ true => d1.gstr_append(a, "your program"), false => a.mappend_id_str_dotted(d1, importer) })
    d3 := d2.gstr_append(a, "`, and its method `")
    d4 := a.mappend_string(d3, split).gstr_append(a, "` shares a name with a top-level function; the alias renames the method (to `")
    d5 := d4.gstr_append(a, edge.alias).gstr_append(a, "__")
    d6 := a.mappend_string(d5, split).gstr_append(a, "`), so `.")
    d7 := a.mappend_string(d6, split).gstr_append(a, "(...)` calls elsewhere no longer resolve")
    l2 := d7.gstr_push(a, 10)
    // actionable fix
    h0 := l2.gstr_append(a, "hint: replace the module alias with a selective import — e.g. `{ ... } = ")
    h1 := a.mappend_id_str_dotted(h0, edge.module).gstr_append(a, "` — or qualify the conflicting usage")
    eprint(h1.gstr_push(a, 10).gstr_finish(a))
    exit(1)
    0
}
check_alias_collisions = (a: MutPtr<Malloc>, table: ModuleTable, graph: ModuleGraph, mainsrc: string_view, inpath: string_view) i32 {
    graph.imports.loop((h, i, edge) {
        edge.namespace.match ({ true => {
            entry := table.module(edge.module)
            splits := a.split_names(entry.source, entry.graph.value_decl_names_in(a))
            (splits.len > 0).match ({ true => {
                col := a.find_split_call_site(table, edge.module, splits)
                col.found.match ({ true => {
                    a.fail_alias_collision(inpath, mainsrc, edge, col.name, col.importer)
                }, false => { } })
            }, false => { } })
        }, false => { } })
    })
    0
}
// Public loader entry: collect namespace binds, strip imports/binds from the main
// source, load transitive imports, then dedup names across the flat program.
resolve_program_data* = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, inpath: string_view, mainsrc: string_view) ResolvedProgram {
    a.alias_prefixes_reset()    // fresh per program: the checker's UFCS-alias set is exactly the aliases stamped below
    a.scan_dotted_imports(inpath, mainsrc)
    graph := a.module_graph(mainsrc)
    table := a.module_table_graph(root, progdir, inpath, mainsrc, graph)
    a.enforce_visibility(table, vis_report_mode())
    inpath.internal_source_path().match ({ true => 0, false => a.check_alias_collisions(table, graph, mainsrc, inpath) })
    ns := a.collect_ns_graph_table(table, inpath, mainsrc, graph, a.ns_scan(a.empty_closure()))
    nsl := ns.c.out.len
    body := ns.c.out.strip_ns_into(a, mainsrc, 0, ns.quals, ns.qnames, ns.strip_qnames, ns.strip_all_quals, ns.c.out.len == 0)
    cN := a.load_import_graph_table(table, inpath, mainsrc, graph, true, Closure(
        seen: ns.c.seen,
        out: body,
        useen: ns.c.useen,
    ))
    internal := inpath.internal_source_path()
    sf := a.shadow_flat(cN.out.gstr_finish(a), mainsrc, nsl, body.len, internal.match ({ true => false, false => true }))
    flat := a.dedup_impls(a.dedup_decls_mode(sf.flat, nsl, sf.bodyend, internal))
    ResolvedProgram(
        table: table,
        flat: flat,
        body_start: nsl,
        body_end: sf.bodyend,
    )
}
resolve_program* = (a: MutPtr<Malloc>, root: string_view, progdir: string_view, inpath: string_view, mainsrc: string_view) string_view { a.resolve_program_data(root, progdir, inpath, mainsrc).flat }
