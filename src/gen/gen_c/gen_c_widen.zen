// Rebuild values that reach a wider structural set or Res error set. This file
// decides when conversion is valid; gen_c_bound.convert owns representation.
// Set-to-larger-set retagging remains statement lowering in gen_c_try because
// the two sets may assign different tag numbers.

ExprId = std.ast
AllocError = std.mem
str, String = std.text
TyId, TyRes, is_failure = sema.sema_ty
Ctx = sema.sema_check
CBackend = gen.gen_c.gen_c_state

expr, ty_of, value_expr = gen.gen_c.gen_c_expr
convert = gen.gen_c.gen_c_bound
carrier, wrap_error = gen.gen_c.gen_c_try
ctype = gen.gen_c.gen_c_type
sym_union_variant, sym_union_member = gen.gen_name
has_var = sema.sema_inst

// Whether the value has to be REBUILT to reach the `Res` that is wanted.
needs_widen* = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId)
               Res<bool, AllocError> {
    be.check.types.at(want).match({
        Res(w) => be.widens_into(id, ctx, want, w),
        _      => Ok(false),
    })
}

// A TYPE NOBODY HAS COMPUTED IS NOT WIDENED (same reason as
// `gen_c_hoist.zen`): an `Unknown` or still-open answer says nothing
// about the value, so rebuilding on it would invent a conversion.
widens_into = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId, w: TyRes)
              Res<bool, AllocError> {
    unknown = be.check.types.unknown().try();
    cty     = be.ty_of(id, ctx, unknown).try();
    settled(be, cty).match({
        false => Ok(false),
        true  => Ok(be.res_widens(cty, want, w)),
    })
}

settled = (be :: CBackend, cty: TyId) bool {
    (be.check.is_unknown(cty) || has_var(be.check, cty)) == false
}

res_widens = (be :: CBackend, cty: TyId, want: TyId, w: TyRes) bool {
    cty.eq(want).match({
        true  => false,
        false => be.res_parts_widen(cty, w),
    })
}

res_parts_widen = (be :: CBackend, cty: TyId, w: TyRes) bool {
    be.check.types.at(cty).match({
        Res(g) => be.parts_widen(g, w),
        _      => false,
    })
}

// THE SUCCESS PAYLOAD MUST ALREADY AGREE — this file widens the ERROR
// set only. `Res<u8, E>` reaching `Res<T, E>` is erasure's question
// (`gen_c_bound.zen`, with the instantiation in hand); here there is
// none, so the two success payloads must already be one type.
parts_widen = (be :: CBackend, g: TyRes, w: TyRes) bool {
    (is_failure(g.form) == is_failure(w.form)) && g.value.eq(w.value)
        && be.error_widens(g, w)
}

// An absence carries no error, so its `error` slot is the unit type and
// comparing it says nothing — the two `Res`es differ in their success
// payload or not at all, and `parts_widen` has already answered that.
error_widens = (be :: CBackend, g: TyRes, w: TyRes) bool {
    is_failure(g.form).match({
        false => false,
        true  => member_reaches_set(be, g.error, w.error),
    })
}

// ONE MEMBER REACHING A SET, never a set reaching a wider one (see
// header). `set_has` is sema's own containment test — the one that
// admitted the program — so asking it again cannot disagree.
member_reaches_set = (be :: CBackend, got: TyId, want: TyId) bool {
    (got.eq(want) == false) && (be.is_set(got) == false)
        && be.is_set(want) && be.check.types.set_has(want, got)
}

is_set = (be :: CBackend, ty: TyId) bool {
    be.check.types.at(ty).match({ Union(_) => true, _ => false })
}

// THE VALUE AT ITS OWN TYPE, THEN REBUILT AT THE WANTED ONE. Lowering
// at `want` directly would ask the value to be something it is not;
// `convert` spills it into a temporary and reads the tag and payload
// off that, so the value is read three times without being evaluated
// three times.
widen_expr* = (
    be   :: CBackend,
    id   : ExprId,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    cty     = be.ty_of(id, ctx, unknown).try();
    code ::= be.alloc.String().try();
    expr(be, id, ctx, cty, code).try();
    be.convert(code.view(), cty, want, out)
}

// a member reaching a SET
// `Err(AllocError.OutOfMemory)` inside a `Res<(), AllocError | Fault>`
// is a member written where the set is wanted; sema admits it because
// "a union target accepts any of its members". Without this it emitted
// as a bare member assignment into the set's struct — no tag, wrong
// type, `cc` rejecting an unreported program.

// A value whose own type is a MEMBER of the wanted set, not the set
// itself — a value already at the set's type is a copy and needs
// nothing. THE SET IS ASKED FOR AT ITS RESOLVED SPELLING (`set_of`) —
// the slot usually carries the declaration's NAME, `Trouble` and not
// `AllocError | ParseError`, and the raw name is no union, so asking
// the question of the name alone answered false for every DECLARED set
// and leave the member as an invalid bare assignment. The structural reading
// is already resolved; declared sets need this explicit step.
needs_set* = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId)
            Res<bool, AllocError> {
    wide = be.check.set_of(want);
    be.check.types.at(wide).match({
        Union(_) => member_reaches_set(be, id, ctx, want, wide),
        _        => Ok(false),
    })
}

member_reaches_set = (
    be   :: CBackend,
    id   : ExprId,
    ctx  : Ctx,
    want : TyId,
    wide : TyId
) Res<bool, AllocError> {
    unknown = be.check.types.unknown().try();
    cty     = be.ty_of(id, ctx, unknown).try();
    Ok(be.settled_member(cty, want, wide));
}

// `set_has` answers TRUE for an unsubstituted type parameter (`sema_ty`:
// a set nobody has computed cannot be said to be absent) — right for a
// containment CHECK, wrong here since there is no C value to tag, so
// it's asked past. Membership is asked of the RESOLVED set, for the
// reason `needs_set` resolves; and where the wanted spelling is a
// DECLARATION, some variant of it must carry the member or there is no
// tag constant to build with — `Error = WriteError | FsError` contains
// every member of `IoError` once the sets are flattened while naming
// none of them, and claiming that here would emit a tag nothing
// defines. A structural set composes its tag instead of declaring one,
// so there the answer is always yes.
settled_member = (be: CBackend, cty: TyId, want: TyId, wide: TyId) bool {
    (be.check.is_unknown(cty) == false) && (cty.eq(wide) == false)
        && be.is_named_or_res(cty) && be.check.types.set_has(wide, cty)
        && be.variant_carries(want, cty)
}

variant_carries = (be: CBackend, want: TyId, member: TyId) bool {
    be.check.types.at(want).match({
        Named(_) => be.carrier(want, member).match({
            None  => false,
            Ok(_) => true,
        }),
        _        => true,
    })
}

is_named_or_res = (be: CBackend, cty: TyId) bool {
    be.check.types.at(cty).match({
        Named(_) => true,
        Res(_)   => true,
        _        => false,
    })
}

// The value at ITS OWN type, then the set built around it — lowering it
// at the set would ask for the member to already be one. The two
// spellings of one set take two tag namings and so two builders: a
// STRUCTURAL set composes its constant out of type codes, a DECLARED
// one names it through the variant carrying the member, and each has
// its own definition emitted. The declared path reuses `.try()`'s
// carrier lookup and `wrap_error` rather than spelling either again —
// one layout decision, not two.
set_expr* = (
    be   :: CBackend,
    id   : ExprId,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    cty     = be.ty_of(id, ctx, unknown).try();
    code ::= be.alloc.String().try();
    be.value_expr(id, ctx, cty, code).try();
    be.check.types.at(want).match({
        Named(_) => be.carrier(want, cty).match({
            None  => be.write_set_value(code.view(), cty, want, out),
            Ok(v) => be.wrap_error(want, v, code.view(), out),
        }),
        _        => be.write_set_value(code.view(), cty, want, out),
    })
}

// The set, tagged with the member the value IS and carrying it
// unchanged. Exported because `.try()` widening builds the same value
// out of a different piece of C — the two are one layout decision and
// must not be written twice.
write_set_value* = (
    be     :: CBackend,
    code   : str,
    member : TyId,
    set    : TyId,
    out    :: String
) Res<(), AllocError> {
    out.add("(").try();
    be.ctype(set, out).try();
    out.add("){ .zg_tag = ").try();
    sym_union_variant(out, be.types(), be.world(), set, member).try();
    out.add(", .zg_data.").try();
    sym_union_member(out, be.types(), be.world(), member).try();
    out.fmt(" = {code} }")
}
