// MUST FAIL: `if` / `else`. DESIGN.md:152 — "Control flow is one thing: `.match`, a
// method ... No `if`, no ternary, no `?` operator." Neither word is a keyword, and
// `else` cannot be read as anything else — not a call, not a binding, not a block.

check* = (n: i32) str {
    if (n == 0) {
        "zero"
    } else {
        "nonzero"
    }
}
