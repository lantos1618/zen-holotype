// std.core.path
// a filesystem path — bytes, like str. The shell handed them to us
// as bytes, the kernel wants them back as bytes; validating in
// between could only lose information.

Path* = {
    text*: str,
}

// build a path, optionally formatted. THE FORMATTED FORM TAKES THE
// ALLOCATOR AND FAILS: it builds a string, and this language has no
// hidden heap, so the two forms differ by more than an argument list.
//     Path("src/main.zen")
//     Path(a, "build/{}-{}/{}", os, arch, name).try()
Path* = (text: str) Path
Path* = (a: Alloc, fmt: str, args: ...) Res<Path, AllocError>

// Join two path fragments with exactly the separator the boundary needs.
// This is the string form for callers that pass paths directly to Fs;
// Path.join below is the typed form used by build descriptions.
join_path* = (a: Alloc, dir: str, file: str) Res<String, AllocError> {
    out ::= a.String("{}", dir).try();
    (out.len() > 0 && out.view().index(out.len() - 1) != '/')
        .then(() { out.add_byte('/').try(); });
    out.add_bytes(file).try();
    Ok(out)
}

join* = (a: Alloc, base: Path, rest: str) Res<Path, AllocError>
parent* = (self: Path) Res<Path>
name* = (self: Path) str
ext* = (self: Path) Res<str>
