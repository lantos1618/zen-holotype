// expect's PANIC path: an Err receiver must ABORT the process (SIGABRT => exit 134 under sh) after
// writing the mandatory message to stderr, framed by panic itself as `zen: panic: <msg>` + newline
// (matching the compiler's runtime div-zero/OOB panics). Driven by the `result_expect_panics`
// ShellCase in harness_build.zen, which asserts the exit code and the exact framed stderr line.
// The Ok paths (and every other combinator) are covered by result_combinators.zen.
{ Result, IoError, expect } = std.core.result
main = () i32 {
    bad: Result<i32, IoError> := .Err(.Denied)
    bad.expect("config must load")
}
