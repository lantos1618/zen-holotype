// std.text.str — borrowed `str` helpers plus allocator-owned byte copies.
// Allocating helpers take the caller allocator explicitly and return Result so allocation
// failure stays in the value flow (`.expect("…")` at fail-fast roots).
{ try_acquire } = std.mem.alloc
{ Result, IoError, expect, ok, err } = std.core.result
{ strlen, strcmp } = std.c.libc
{ is_space } = std.text.ascii
len* = (s: string_view) i64 { s.strlen() }
is_empty* = (s: string_view) bool { (s.strlen() == 0).match ({ true => true, false => false }) }
eq* = (a: string_view, b: string_view) bool {
    (a.strcmp(b) == 0).match ({ true => true, false => false })
}
ne* = (a: string_view, b: string_view) bool { a.eq(b).match ({ true => false, false => true }) }
// ── bytes: borrow or own ────────────────────────────────────────────────────
view* = (s: string_view) [u8] { s.slice(s.strlen()) }
alloc_size = (n: i64) i64 { (n == 0).match ({ true => 1, false => n }) }
copy_bytes = (src: [u8], out: [u8]) void {
    src.loop((h, i, b) {
        out[i] = b
    })
}
dup_bytes_in*<A> = (a: MutPtr<A>, s: string_view) Result<[u8], IoError> {
    src := s.view()
    a.try_acquire(src.len.alloc_size()).match ({
        .Ok(p)  => {
            out: [u8] := p.slice(src.len)
            src.copy_bytes(out)
            ok(out)
        },
        .Err(e) => err(e),
    })
}
dup_bytes*<A> = (a: MutPtr<A>, s: string_view) Result<[u8], IoError> { a.dup_bytes_in(s) }
// ── search ──────────────────────────────────────────────────────────────────
// do needle's bytes (pv) appear at sv[at..]? (caller guards at + pv.len <= sv.len)
has_at = (sv: [u8], pv: [u8], at: i64) bool {
    ok := true
    pv.loop((h, i, b) {
        ok.match ({
            true  => (sv[at + i] == b == false).then({
                ok = false
                h.break
            }),
            false => {
                h.break
            },
        })
    })
    ok
}
// byte index of the first occurrence of `needle` in `s`, -1 if absent.
// the empty needle matches at 0 (the strstr convention).
find* = (s: string_view, needle: string_view) i64 {
    sv := s.view()
    pv := needle.view()
    (pv.len == 0).match ({
        true  => 0,
        false => {
            found: i64 := 0 - 1
            sv.loop((h, i, b) {
                (i + pv.len > sv.len).match ({
                    true  => {
                        h.break
                    },
                    false => sv.has_at(pv, i).then({
                        found = i
                        h.break
                    }),
                })
            })
            found
        },
    })
}
// does `s` contain `needle`? (the empty needle is contained in everything)
contains* = (s: string_view, needle: string_view) bool { s.find(needle) >= 0 }
// NOTE: `find` IS the index-of operation (first byte index, -1 if absent) — there is no separate
// `index_of` here on purpose: it would duplicate `find` AND collide on the flattened namespace with
// std.core.slice's `index_of<T>`. Reach for `find` (raw -1 sentinel).
// does `s` begin with `prefix`? (every str starts with the empty prefix)
starts_with* = (s: string_view, prefix: string_view) bool {
    sv := s.view()
    pv := prefix.view()
    pv.len <= sv.len && sv.has_at(pv, 0)
}
// does `s` end with `suffix`? (every str ends with the empty suffix)
ends_with* = (s: string_view, suffix: string_view) bool {
    sv := s.view()
    fv := suffix.view()
    fv.len <= sv.len && sv.has_at(fv, sv.len - fv.len)
}
// ── slicing & indexing ──────────────────────────────────────────────────────
// pin `x` into [lo, hi] — the substr clamp
pin = (x: i64, lo: i64, hi: i64) i64 {
    (x < lo).match ({
        true  => lo,
        false => (x > hi).match ({ true => hi, false => x }),
    })
}
copy_substr = (sv: [u8], out: [u8], lo: i64, m: i64) void {
    out.loop((h, i, b) {
        (i < m).match ({
            true  => {
                out[i] = sv[lo + i]
            },
            false => {
                h.break
            },
        })
    })
    out[m] = 0
}
// Out-of-range is clamped: a.substr("hi", 1, 99) == "i"; a.substr("hi", 5, 2) == "".
substr_in*<A> = (a: MutPtr<A>, s: string_view, start: i64, n: i64) Result<string_view, IoError> {
    sv := s.view()
    lo := start.pin(0, sv.len)
    m := n.pin(0, sv.len - lo)
    a.try_acquire(m + 1).match ({
        .Ok(p)  => {
            out: [u8] := p.slice(m + 1)
            sv.copy_substr(out, lo, m)
            ok(cstr(out.ptr))
        },
        .Err(e) => err(e),
    })
}
substr*<A> = (a: MutPtr<A>, s: string_view, start: i64, n: i64) Result<string_view, IoError> {
    a.substr_in(s, start, n)
}
// the byte at index `i`, or 0 when `i` is out of range (negative or past the end)
at* = (s: string_view, i: i64) u8 {
    sv := s.view()
    (i >= 0 && i < sv.len).match ({ true => sv[i], false => 0 })
}
// ── trimming: leading/trailing ASCII whitespace (' ', '\t', '\n', '\r') ───────
//
// `str` is NUL-terminated, so a *both-ends* trimmed `str` can't be a zero-copy view — the trailing
// boundary has no NUL in the original buffer. Two honest shapes are offered:
//   • `*_view` → a `[u8]` sub-slice — ZERO-COPY (length-carrying, points into `s`), NO allocation.
//   • `trim_in` → an allocator-owned NUL-terminated `str` copy (reuses `substr_in`).
// first non-whitespace index, or `v.len` when `v` is empty / all whitespace.
ws_start = (v: [u8]) i64 {
    lo: i64 := v.len
    v.loop((h, i, b) {
        (b.is_space() == false).then({
            lo = i
            h.break
        })
    })
    lo
}
// one past the last non-whitespace index, or 0 when `v` is empty / all whitespace.
ws_end = (v: [u8]) i64 {
    hi: i64 := 0
    v.loop((h, i, b) {
        (b.is_space() == false).then({
            hi = i + 1
        })
    })
    hi
}
// zero-copy `[u8]` sub-views (no allocation) — both ends / leading / trailing.
trim_view* = (s: string_view) [u8] {
    v: [u8] := s.view()
    lo := v.ws_start()
    hi := v.ws_end()
    (hi > lo).match ({ true => slice(v.ptr.offset(lo), hi - lo), false => slice(v.ptr, 0) })
}
ltrim_view* = (s: string_view) [u8] {
    v: [u8] := s.view()
    lo := v.ws_start()
    slice(v.ptr.offset(lo), v.len - lo)
}
rtrim_view* = (s: string_view) [u8] {
    v: [u8] := s.view()
    slice(v.ptr, v.ws_end())
}
// allocator-owned NUL-terminated trimmed copy (both ends).
trim_in*<A> = (a: MutPtr<A>, s: string_view) string_view {
    v: [u8] := s.view()
    lo := v.ws_start()
    hi := v.ws_end()
    a
        .substr_in(s, lo, (hi > lo).match ({ true => hi - lo, false => 0 }))
        .expect("std.text.str: allocation failed")
}
trim*<A> = (a: MutPtr<A>, s: string_view) string_view { a.trim_in(s) }
// strip a leading `prefix` AS A STR — zero-copy (no allocation): dropping a prefix only advances
// the start pointer and the original NUL still terminates the tail. Returns `s` unchanged when
// it doesn't start with `prefix`. trim_prefix("--verbose", "--") == "verbose".
trim_prefix* = (s: string_view, prefix: string_view) string_view {
    s.starts_with(prefix).match ({ true => cstr(s.view().ptr.offset(prefix.len())), false => s })
}
// strip a trailing `suffix` — allocator-owned NUL-terminated copy (a fresh trailing boundary needs its
// own NUL, so this can't be zero-copy). Returns a COPY of `s` when it doesn't end with `suffix`.
// trim_suffix("file.zen", ".zen") == "file".
trim_suffix_in*<A> = (a: MutPtr<A>, s: string_view, suffix: string_view) string_view {
    n := s.len()
    s.ends_with(suffix).match ({
        true  => a.substr_in(s, 0, n - suffix.len()).expect("std.text.str: allocation failed"),
        false => a.substr_in(s, 0, n).expect("std.text.str: allocation failed"),
    })
}
trim_suffix*<A> = (a: MutPtr<A>, s: string_view, suffix: string_view) string_view {
    a.trim_suffix_in(s, suffix)
}
// ── splitting: fields and words ───────────────────────────────────────────────
//
// A returned `[str]` holds NUL-terminated COPIES of each field, not zero-copy sub-views: `str` is
// NUL-terminated, so a field can't both share `s`'s buffer AND end at a separator. The slice backbone
// and every field are acquired from the caller's allocator (reusing `substr_in` for each copy).
// an allocator-owned `[T]` of `n` slots, uninitialised. `seed` is unread — it only pins T (sizeof(T)
// is rewritten per concrete element type at monomorphization). `n == 0` yields an empty slice.
nbuf*<T, A> = (a: MutPtr<A>, seed: T, n: i64) [T] { slice(a.acquire(n * sizeof(T)), n) }
// split `s` into the `sep`-delimited fields. The field count is (separators + 1), so empty fields are
// kept: "a,b,c" -> ["a","b","c"]; "a,,b" -> ["a","","b"]; "abc" -> ["abc"]; "" -> [""].
split_in*<A> = (a: MutPtr<A>, s: string_view, sep: u8) [string_view] {
    sv := s.view()
    nf: i64 := 1
    sv.loop((h, i, b) {
        (b == sep).then({
            nf = nf + 1
        })
    })
    out: [string_view] := a.nbuf("", nf)
    fi: i64 := 0    // next field slot
    start: i64 := 0
    sv.loop((h, i, b) {
        (b == sep).then({
            out[fi] = a.substr_in(s, start, i - start).expect("std.text.str: allocation failed")    // current field's start offset
            fi = fi + 1
            start = i + 1
        })
    })
    out[fi] = a.substr_in(s, start, sv.len - start).expect("std.text.str: allocation failed")
    out
}
split*<A> = (a: MutPtr<A>, s: string_view, sep: u8) [string_view] { a.split_in(s, sep) }
// split `s` on RUNS of ASCII whitespace, dropping empty fields: "  the  cat sat " -> ["the","cat","sat"];
// "" / all-whitespace -> [] (an empty slice).
words_in*<A> = (a: MutPtr<A>, s: string_view) [string_view] {
    sv := s.view()
    nw: i64 := 0    // word count = whitespace(or start)->non-whitespace transitions
    inw := false
    sv.loop((h, i, b) {
        b.is_space().match ({
            true  => {
                inw = false
            },
            false => (inw == false).then({
                inw = true    // currently inside a word?
                nw = nw + 1
            }),
        })
    })
    out: [string_view] := a.nbuf("", nw)
    wi: i64 := 0    // next word slot
    start: i64 := 0 - 1
    sv.loop((h, i, b) {
        b.is_space().match ({
            true  => (start >= 0).then({
                out[wi] = a.substr_in(s, start, i - start).expect("std.text.str: allocation failed")    // current word's start offset, -1 when between words
                wi = wi + 1
                start = 0 - 1
            }),
            false => (start < 0).then({
                start = i
            }),
        })
    })
    (start >= 0).then({
        out[wi] = a.substr_in(s, start, sv.len - start).expect("std.text.str: allocation failed")
        wi = wi + 1
    })
    out
}
words*<A> = (a: MutPtr<A>, s: string_view) [string_view] { a.words_in(s) }
// ── building new strings: join / replace / case / repeat / pad ─────────────────
//
// Each op below ALLOCATES a fresh NUL-terminated `str` from the caller's allocator (a `MutPtr<A>`),
// the same explicit-allocator contract as `substr_in`. They size the result first, `acquire` once, then
// fill — no String-builder dependency (str.zen stays free of a std.text.string import cycle).
//
// FLAT-NAMESPACE NOTE: `join`, `replace`, `repeat`, `to_lower`, `to_upper`, `pad_left`, `pad_right` are
// common names. They are unique across std today (grepped) — the only near-miss is std.core.slice's
// `index_of<T>`, which is why no `index_of` is defined here (use `find`). Keep new globals distinct.
// copy `t`'s bytes into `out` starting at `at`; return the offset just past them.
copy_at = (out: [u8], at: i64, t: string_view) i64 {
    tv := t.view()
    tv.loop((h, i, b) {
        out[at + i] = b
    })
    at + tv.len
}
// the 'A'..'Z' / 'a'..'z' case shift; non-letters pass through. ASCII-ONLY (bytes 0x80+ untouched).
to_ascii_lower = (b: u8) u8 {
    (b >= 'A' && b <= 'Z').match ({ true => b + ('a' - 'A'), false => b })
}
to_ascii_upper = (b: u8) u8 {
    (b >= 'a' && b <= 'z').match ({ true => b - ('a' - 'A'), false => b })
}
// ASCII lower/upper-cased COPY of `s`. Only A–Z / a–z are folded; every other byte (digits, punctuation,
// UTF-8 continuation bytes) is copied verbatim. to_upper("hi!") == "HI!".
to_lower_in*<A> = (a: MutPtr<A>, s: string_view) string_view {
    sv := s.view()
    out: [u8] := a.acquire(sv.len + 1).slice(sv.len + 1)
    sv.loop((h, i, b) {
        out[i] = b.to_ascii_lower()
    })
    out[sv.len] = 0
    cstr(out.ptr)
}
to_lower*<A> = (a: MutPtr<A>, s: string_view) string_view { a.to_lower_in(s) }
to_upper_in*<A> = (a: MutPtr<A>, s: string_view) string_view {
    sv := s.view()
    out: [u8] := a.acquire(sv.len + 1).slice(sv.len + 1)
    sv.loop((h, i, b) {
        out[i] = b.to_ascii_upper()
    })
    out[sv.len] = 0
    cstr(out.ptr)
}
to_upper*<A> = (a: MutPtr<A>, s: string_view) string_view { a.to_upper_in(s) }
// `s` concatenated `n` times. `n <= 0` yields ""; an empty `s` also yields "". repeat("ab", 3) == "ababab".
repeat_in*<A> = (a: MutPtr<A>, s: string_view, n: i64) string_view {
    sv := s.view()
    cnt := (n < 0).match ({ true => 0, false => n })
    total := sv.len * cnt
    out: [u8] := a.acquire(total + 1).slice(total + 1)
    out.loop((h, i, b) {
        (i < total).match ({
            true  => {
                out[i] = sv[i % sv.len]
            },
            false => {
                out[i] = 0    // sv.len > 0 whenever total > 0, so `%` is safe
                h.break
            },
        })
    })
    cstr(out.ptr)
}
repeat*<A> = (a: MutPtr<A>, s: string_view, n: i64) string_view { a.repeat_in(s, n) }
// join a slice of `str`s with `sep` between each: join(["a","b","c"], ",") == "a,b,c".
// An empty slice yields "", a one-element slice yields that element (no separator).
join_in*<A> = (a: MutPtr<A>, parts: [string_view], sep: string_view) string_view {
    np := parts.len
    total: i64 := 0
    parts.loop((h, i, p) {
        total = total + p.len()
    })
    seps := (np > 0).match ({ true => np - 1, false => 0 })
    total = total + sep.len() * seps
    out: [u8] := a.acquire(total + 1).slice(total + 1)
    pos: i64 := 0
    parts.loop((h, i, p) {
        (i > 0).then({
            pos = out.copy_at(pos, sep)
        })
        pos = out.copy_at(pos, p)
    })
    out[total] = 0
    cstr(out.ptr)
}
join*<A> = (a: MutPtr<A>, parts: [string_view], sep: string_view) string_view {
    a.join_in(parts, sep)
}
// ── concatenation: explicit allocator, NO hidden heap ─────────────────────────
//
// Zen has no `str + str` operator on purpose: `+` would hide a malloc. Concatenation is
// EXPLICIT through the caller's allocator — the same contract as substr_in / join_in. The
// result is a fresh NUL-terminated `str` owned by `a`.
//
//   a.cat("foo", "bar") == "foobar"
//
// Named `cat` (not `concat`) because std.core.slice already exports `concat`/`concat_in`
// for `[T]`; a second `concat` here would collide on the flattened import namespace. For
// the n-ary `"a" + "b" + "c"` shape, either chain `cat` or reach for `join(parts, "")`:
//
//   a.cat(a.cat("a", "b"), "c")  ==  a.join(["a", "b", "c"], "")  ==  "abc"
//   a.join(["name=", name, "\n"], "")  builds  "name=<name>\n"
cat_in*<A> = (a: MutPtr<A>, x: string_view, y: string_view) string_view {
    xv := x.view()
    yv := y.view()
    total := xv.len + yv.len
    out: [u8] := a.acquire(total + 1).slice(total + 1)
    p := out.copy_at(0, x)
    out.copy_at(p, y)
    out[total] = 0
    cstr(out.ptr)
}
cat*<A> = (a: MutPtr<A>, x: string_view, y: string_view) string_view { a.cat_in(x, y) }
// count NON-overlapping occurrences of `fv` (len >= 1) in `sv`. `nextpos` skips past a match's bytes so
// "aaaa" has 2 occurrences of "aa", not 3.
count_occ = (sv: [u8], fv: [u8]) i64 {
    cnt: i64 := 0
    nextpos: i64 := 0
    sv.loop((h, i, b) {
        (i >= nextpos && i + fv.len <= sv.len && sv.has_at(fv, i)).then({
            cnt = cnt + 1
            nextpos = i + fv.len
        })
    })
    cnt
}
// replace ALL non-overlapping occurrences of `from` with `to` (not just the first). An empty `from`
// matches nothing and returns a copy of `s` unchanged (the strstr convention would loop forever).
// replace("hello", "l", "L") == "heLLo"; replace("a.b.c", ".", "/") == "a/b/c".
replace_in*<A> = (a: MutPtr<A>, s: string_view, from: string_view, to: string_view) string_view {
    sv := s.view()
    fv := from.view()
    (fv.len == 0).match ({
        true  => a.substr_in(s, 0, sv.len).expect("std.text.str: allocation failed"),
        false => {
            cnt := sv.count_occ(fv)    // empty pattern: unchanged copy (no infinite loop)
            total := sv.len + cnt * (to.len() - fv.len)
            out: [u8] := a.acquire(total + 1).slice(total + 1)
            pos: i64 := 0
            skip: i64 := 0
            sv.loop((h, i, b) {
                (i < skip == false).then({
                    (i + fv.len <= sv.len && sv.has_at(fv, i)).match ({
                        true  => {
                            pos = out.copy_at(pos, to)    // bytes of an in-progress match to NOT copy verbatim
                            skip = i + fv.len
                        },
                        false => {
                            out[pos] = b
                            pos = pos + 1
                        },
                    })
                })
            })
            out[total] = 0
            cstr(out.ptr)
        },
    })
}
replace*<A> = (a: MutPtr<A>, s: string_view, from: string_view, to: string_view) string_view {
    a.replace_in(s, from, to)
}
// pad `s` to at least `width` bytes by prepending / appending `fill`; a longer `s` is copied unchanged.
// pad_left("7", 3, '0') == "007"; pad_right("hi", 4, ' ') == "hi  ".
pad_left_in*<A> = (a: MutPtr<A>, s: string_view, width: i64, fill: u8) string_view {
    sv := s.view()
    pad := (width > sv.len).match ({ true => width - sv.len, false => 0 })
    total := pad + sv.len
    out: [u8] := a.acquire(total + 1).slice(total + 1)
    out.loop((h, i, b) {
        (i < total).match ({
            true  => {
                out[i] = (i < pad).match ({ true => fill, false => sv[i - pad] })
            },
            false => {
                out[i] = 0
                h.break
            },
        })
    })
    cstr(out.ptr)
}
pad_left*<A> = (a: MutPtr<A>, s: string_view, width: i64, fill: u8) string_view {
    a.pad_left_in(s, width, fill)
}
pad_right_in*<A> = (a: MutPtr<A>, s: string_view, width: i64, fill: u8) string_view {
    sv := s.view()
    pad := (width > sv.len).match ({ true => width - sv.len, false => 0 })
    total := sv.len + pad
    out: [u8] := a.acquire(total + 1).slice(total + 1)
    out.loop((h, i, b) {
        (i < total).match ({
            true  => {
                out[i] = (i < sv.len).match ({ true => sv[i], false => fill })
            },
            false => {
                out[i] = 0
                h.break
            },
        })
    })
    cstr(out.ptr)
}
pad_right*<A> = (a: MutPtr<A>, s: string_view, width: i64, fill: u8) string_view {
    a.pad_right_in(s, width, fill)
}
// ── numbers ─────────────────────────────────────────────────────────────────
// the i64 value of the decimal text in `s`: an optional leading '-', then a run of
// digits. Parsing stops at the first non-digit and never errors: no leading digits
// (empty str, garbage, a bare '-') parse as 0 — parse_int("42") == 42,
// parse_int("-7") == -7, parse_int("12ab") == 12, parse_int("zen") == 0.
parse_int* = (s: string_view) i64 {
    sv := s.view()
    neg := sv.len > 0 && sv[0] == '-'
    start: i64 := neg.match ({ true => 1, false => 0 })
    acc: i64 := 0
    sv.loop((h, i, b) {
        (i < start == false).then({
            (b >= '0' && b <= '9').match ({
                true  => {
                    acc = acc * 10 + (b - '0')
                },
                false => {
                    h.break
                },
            })
        })
    })
    neg.match ({ true => 0 - acc, false => acc })
}
// what made try_parse_int refuse: nothing to parse, a non-digit in the tail (the byte carried),
// or a magnitude past i64. parse_int (above) keeps its documented never-errors behavior.
ParseError*: NoDigits | Trailing(u8) | Overflow
I64_MAX_DIV10 := 922337203685477580    // i64 max / 10: the pre-multiply overflow bound
// Human-readable variant name, mirroring IoError's `name` (std.core.result) so parse failures
// print too: `println(e.parse_error_name())`. Flat namespace has no overloading, so the type
// rides in the fn name. `.Trailing`'s offending byte is not rendered — match for it.
parse_error_name* = (e: ParseError) string_view {
    e.match ({
        .NoDigits    => "NoDigits",
        .Trailing(b) => "Trailing",
        .Overflow    => "Overflow",
    })
}
e_nodigits = () ParseError { .NoDigits }
e_trailing = (b: u8) ParseError { .Trailing(b) }
e_overflow = () ParseError { .Overflow }
// parse_int, honestly: "zen" and "12ab" are errors, not 0 and 12. An optional leading '-', then
// digits to the very end; the magnitude must fit i64 (|INT64_MIN| itself counts as overflow).
try_parse_int* = (s: string_view) Result<i64, ParseError> {
    sv := s.view()
    neg := sv.len > 0 && sv[0] == '-'
    start: i64 := neg.match ({ true => 1, false => 0 })
    acc: i64 := 0
    nd: i64 := 0    // digits consumed
    bad: u8 := 0    // the first non-digit byte hit (0 = none)
    over := false
    sv.loop((h, i, b) {
        (i < start == false).then({
            (b >= '0' && b <= '9').match ({
                true  => {
                    d := b - '0'
                    (acc > I64_MAX_DIV10 || acc == I64_MAX_DIV10 && d > 7).match ({
                        true  => {
                            over = true
                            h.break
                        },
                        false => {
                            acc = acc * 10 + d
                            nd = nd + 1
                        },
                    })
                },
                false => {
                    bad = b
                    h.break
                },
            })
        })
    })
    out: Result<i64, ParseError> := over.match ({
        true  => err(e_overflow()),
        false => (nd == 0).match ({
            true  => err(e_nodigits()),
            false => (bad != 0).match ({
                true  => err(e_trailing(bad)),
                false => {
                    v: i64 := neg.match ({ true => 0 - acc, false => acc })
                    ok(v)
                },
            }),
        }),
    })
    out
}
