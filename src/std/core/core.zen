// src/std/core/core.zen
//
// The prelude root, and nothing but starred re-exports.
//
// Re-export is an import whose bindings are starred: no `export`,
// no `from` — `*` doing the same job it does on a type, a field and
// a method, and `=` being the binding it already is. That is what
// makes a folder work, and it is why the prelude can span several
// small files instead of being one enormous one.
//
// Importing a name pulls its world along: a type travels with its
// methods, its impls, and the exported UFCS functions whose first
// parameter is that type. So `Res` arrives with `ok_or`, and `bool`
// arrives with `then`, without either being listed twice.

Res*, Ok*, Err*, None*, ok_or* = std.core.result

then* = std.core.bool

Drop* = std.core.drop

Scope* = std.core.scope

i8*, i16*, i32*, i64* = std.core.num
u8*, u16*, u32*, u64*, usize* = std.core.num
f32*, f64* = std.core.num

// The rest of core/, owned by the files named. These lines are the
// prelude's contract with them: the module path is PLAN.md's tree,
// and the names are the ones DESIGN.md's prelude block writes.
loop*, find*, filter*, map*, pairs*, LoopHandle* = std.core.loop
Range* = std.core.range

Eq* = std.core.eq

Hash*, Hasher* = std.core.hash

Display* = std.core.display

// IoError is here rather than in std.text or std.env because every
// Display signature names it, and core sits below both
IoError*, WriteError*, Sink* = std.core.io
Path* = std.core.path
Duration* = std.core.time
