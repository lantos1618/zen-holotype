// "a method is a UFCS function whose first parameter happens to be
// named self" -- DESIGN.md, Ownership. so a free function whose first
// parameter is Box and a method Box declares are not two mechanisms
// competing for a name: they are one overload set, picked apart on
// declared parameter types and arity like any other.

Box = {
    w: i32,
    grow = (self: @Self) i32 { self.w + 1 }
}

grow = (b: Box, by: i32) i32 { b.w + by }

main = (env: Env) Res<i32, AllocError> {
    b = Box(w: 3);
    println("{}", b.grow());
    println("{}", b.grow(10));
    println("{}", grow(b, 100));
    Ok(0);
}
