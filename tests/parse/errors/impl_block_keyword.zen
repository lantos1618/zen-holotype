// MUST FAIL: an `impl Trait for Type { .. }` block. The only impl form is
// `A.impl(B, {..})` (DESIGN.md:99, 132, 520, 1032, 1100, 1123) — an ordinary call
// in statement position, which PLAN.md:142 lists among the known ambiguities the
// grammar must handle. `impl` is a method name, not a keyword.

impl Display for Circle {
    toString = (self: @Self, sb :: String) Res<(), IoError> {
        Ok(());
    }
}
