// A BODILESS FREE FUNCTION IS REFUSED AT THE CALL — it names a symbol
// nothing defines.
//
// `system = (cmd: str) i32` is a signature with no body: legal to
// declare (std.core.path declares four such, awaiting floors), and a
// foreign-function surface may one day give bodies to. But until
// something answers the call, emitting the C symbol is a link error —
// `zen build` exited 0 here and `cc` was the checker, reporting
// `undefined reference to zu_f2_..systemO1_b3str`. The backend now
// refuses where the symbol would have been written.
//
// The four bodiless shapes WITH floors still lower: the loop intrinsic,
// `null_ptr<T>()`, the two format doors, and `to_<prim>` conversions —
// every corpus test that uses them is the proof this did not overclose.
//
// position: the call to `system`.

AllocError = std.mem

// the shape a caller wants: hand C's system(3) a command line
system = (cmd: str) i32

main = (env: Env) Res<i32, AllocError> {
    rc = system("echo hello from a child");
    println("child returned {}", rc);
    Ok(0)
}
