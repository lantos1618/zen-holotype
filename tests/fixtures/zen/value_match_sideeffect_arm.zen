// #392: builder-style value match — a side-effect arm that still TRAILS the result type is legal
// (the natural first-write, where the arm trails `done = true` instead, is now error[arm-value]).
R*: Ok(string_view) | Err(i32)
main = () i32 {
    done := false
    s: string_view := "init"
    r: R := .Err(3)
    s = r.match ({
        .Ok(ns) => ns,
        .Err(e) => {
            done = true
            s
        },
    })
    r2: R := .Ok("ok")
    s = r2.match ({
        .Ok(ns) => ns,
        .Err(e) => {
            done = true
            s
        },
    })
    done && s == "ok" ? 7 : 1
}    // 7
