// The process-wide default rt, set once via `rt.set_default` at the
// top of main, reaches a POOL WORKER thread — something `rt.with`/`enter` (current-thread-only) cannot
// do. The actor is spawned via `spawn_actor_heap` (the DEFAULT path, NO explicit rt), yet its `receive`
// — running on a worker — allocates through the COUNTING rt that `set_default` installed. Each of the N
// messages drives the counter by exactly one: after quiescence, counter == N proves the process default
// propagated to the worker (spawn_actor_heap read `default()`, the worker `enter`ed it, `rt.current()`
// inside `receive` resolved to it). If spawn_actor_heap baked `heap_rt()`, the counting `acquire` would
// never fire and the counter would stay 0. Unlike the explicit-runtime fixture, this rt is implicit,
// carried by the process default. Exit N (== 40) means the propagation contract holds.
{ pool_open, Pool } = std.concurrent.pool
{ malloc, free, realloc } = std.mem.alloc
{ mem_rt, set_default, alloc, release } = std.rt
pa = std.concurrent.pool_actor
{ Context, Receiver } = std.concurrent.pool_actor
N := 40
allocs := malloc(8)    // the counting rt's counter: # of ambient allocs observed inside behaviors
Msg*: Ping
Probe*: {
    hits: i64,
}
// counting allocator vtable (state = the `allocs` counter). `acquire` bumps the counter, so an ambient
// rt.alloc executed under this rt is OBSERVABLE.
count_acquire = (state: RawPtr<u8>, n: i64) RawPtr<u8> {
    atomic_add_i64(state, 1)
    malloc(n)
}
count_resize = (state: RawPtr<u8>, p: RawPtr<u8>, n: i64) RawPtr<u8> { realloc(p, n) }
count_release = (state: RawPtr<u8>, p: RawPtr<u8>) void { free(p) }
Probe.impl(Receiver, {
    receive = (pr: MutPtr<Probe>, ctx: Context<Msg>) void {
        ctx.msg.match ({
            .Ping => {
                q := alloc(16)    // AMBIENT alloc — resolves to the PROCESS-DEFAULT counting rt (the proof)
                release(q)
                pr.hits = pr.hits + 1
            },
        })
    }
})
tramp = (user: RawPtr<u8>, msg: i64) void {
    a: [Probe] := user.slice(1)
    b: [Msg] := msg.offset(0).slice(1)
    a[0].addr().receive(Context(msg: b[0]))
    pa.free_msg(msg)
}
send_pings = (p: MutPtr<Pool>, h: pa.PooledHandle<Probe>, k: i64) void {
    (k < N).then({
        p.send(h, Msg.Ping)
        send_pings(p, h, k + 1)
    })
}
main = () i32 {
    store_i64(allocs, 0)
    crt := mem_rt(count_acquire, count_resize, count_release, allocs)
    set_default(crt)    // configure the WHOLE program's runtime ONCE, before any spawn
    h := pa.spawn_actor_heap(64, Probe(hits: 0), tramp)    // DEFAULT path — no explicit rt threaded
    p := pool_open(2, 8)
    send_pings(p, h, 0)
    p.pool_quiesce_stop()
    observed := load_i64(allocs)
    hits := pa.actor_state(h).hits
    pa.close(h)
    p.pool_close()
    free(allocs)
    // proof: the process-default counting rt fired once per message ON THE WORKER, AND the actor saw all N.
    (observed == N).match ({
        true  => (hits == N).then({ to_i32(observed) }, { 1 }),
        false => 2,
    })
}
