// tests/corpus/std/res_hoists_bare_value_in_return.zen
// a bare T lifts into Ok(T) in return position: `n * 2;` closes a
// Res<i32, E> function exactly as `Ok(n * 2);` does. only success
// lifts - the Err below is written out, and always will be

CalcError = | Negative

// closes with a bare i32 on one path and an explicit Err on the
// other. if hoisting fired for failure too, the reason would be
// invented rather than named
double = (n: i32) Res<i32, CalcError> {
    (n < 0).match({
        true  => Err(CalcError.Negative),
        false => Ok(n * 2),
    });
}

// the hoisted form: no Ok anywhere in the body
triple = (n: i32) Res<i32, CalcError> {
    n * 3;
}

main = (env: Env) Res<i32, CalcError> {
    println("{}", double(21).try());
    println("{}", triple(10).try());

    double(-1).match({
        Ok(n)  => println("{}", n),
        Err(_) => println("negative"),
    });
    Ok(0);
}
