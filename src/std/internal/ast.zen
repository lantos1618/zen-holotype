// std.internal.ast — heap-stable builders over compiler.genc's AST values.
// Pointer and slice children are copied so returned ASTs do not dangle.
//
// This module and std.io.c are the ONLY src/std modules allowed to import compiler.* (enforced by
// harness_boundaries SUITE 10). They are the metaprogramming surface — build an AST here, emit it
// with compiler.genc's genModule — and handing out AST values requires naming the AST's types, so
// the edge is intrinsic rather than accidental. Zen pulls whole modules, so it is not free: importing
// this drags ast_types + genc + astops + mangle (~3k LOC). That closure stops at the AST/emitter
// subsystem and never reaches the checker, parser, or driver; keep it that way.
//
// NOT a facade over compiler.ast.ast_types, and not a duplicate of it: ast_types owns the type
// DEFINITIONS, genc owns the stack-returning constructors, and this module owns the allocator-explicit
// heap-stable wrappers. Under Zen's flat namespace a re-export facade is impossible anyway — a
// same-named wrapper is a C redefinition of the symbol it wraps.
{ Allocator } = std.mem.alloc
{ node_in, dupx_in, buf_in } = std.core.slice
{ expect } = std.core.result
{ Expr, Stmt, Param, Field, Decl, Func, Ty, StructDecl, FieldInit } = compiler.ast.ast_types
{ vref, lit, bin, call, member, mkstruct, finit, slet, sassign, sret, sexpr, param, field, dfunc,
  dstruct, tnamed, tptr, ti32, ti64, tu8, tbool, tstr, tvoid } = compiler.genc
// Expressions
var_in = (a: Allocator, name: string_view) Ptr<Expr> {
    a.node_in(vref(name)).expect("std.internal.ast: AST allocation failed")
}
int_in = (a: Allocator, n: i32) Ptr<Expr> {
    a.node_in(lit(n)).expect("std.internal.ast: AST allocation failed")
}
dot_in = (a: Allocator, o: Ptr<Expr>, f: string_view) Ptr<Expr> {
    a.node_in(member(o, f)).expect("std.internal.ast: AST allocation failed")
}
binop_in = (a: Allocator, l: Ptr<Expr>, op: string_view, r: Ptr<Expr>) Ptr<Expr> {
    a.node_in(bin(op, l, r)).expect("std.internal.ast: AST allocation failed")
}
add_in = (a: Allocator, l: Ptr<Expr>, r: Ptr<Expr>) Ptr<Expr> { a.binop_in(l, "+", r) }
eqx_in = (a: Allocator, l: Ptr<Expr>, r: Ptr<Expr>) Ptr<Expr> { a.binop_in(l, "==", r) }
and_in = (a: Allocator, l: Ptr<Expr>, r: Ptr<Expr>) Ptr<Expr> { a.binop_in(l, "&&", r) }
callx_in = (a: Allocator, fn: string_view, args: [Expr]) Ptr<Expr> {
    a
        .node_in(call(fn, a.dupx_in(args).expect("std.internal.ast: AST allocation failed")))
        .expect("std.internal.ast: AST allocation failed")
}
estruct_in = (a: Allocator, ty: string_view, fi: [FieldInit]) Ptr<Expr> {
    a
        .node_in(mkstruct(ty, a.dupx_in(fi).expect("std.internal.ast: AST allocation failed")))
        .expect("std.internal.ast: AST allocation failed")
}
var* = (a: Allocator, name: string_view) Ptr<Expr> { a.var_in(name) }
int = (a: Allocator, n: i32) Ptr<Expr> { a.int_in(n) }
dot* = (a: Allocator, o: Ptr<Expr>, f: string_view) Ptr<Expr> { a.dot_in(o, f) }
binop = (a: Allocator, l: Ptr<Expr>, op: string_view, r: Ptr<Expr>) Ptr<Expr> {
    a.binop_in(l, op, r)
}
add* = (a: Allocator, l: Ptr<Expr>, r: Ptr<Expr>) Ptr<Expr> { a.add_in(l, r) }
eqx* = (a: Allocator, l: Ptr<Expr>, r: Ptr<Expr>) Ptr<Expr> { a.eqx_in(l, r) }
and = (a: Allocator, l: Ptr<Expr>, r: Ptr<Expr>) Ptr<Expr> { a.and_in(l, r) }
callx = (a: Allocator, fn: string_view, args: [Expr]) Ptr<Expr> { a.callx_in(fn, args) }
estruct = (a: Allocator, ty: string_view, fi: [FieldInit]) Ptr<Expr> { a.estruct_in(ty, fi) }
// Types
named = (name: string_view) Ty { tnamed(name) }
ptrto_in = (a: Allocator, inner: Ty) Ty {
    tptr(a.node_in(inner).expect("std.internal.ast: AST allocation failed"))
}
ptrto = (a: Allocator, inner: Ty) Ty { a.ptrto_in(inner) }
i32t = () Ty { ti32() }
// Statements
ret = (e: Ptr<Expr>) Stmt { sret(e) }
asstmt = (e: Ptr<Expr>) Stmt { sexpr(e) }
letb = (name: string_view, v: Ptr<Expr>) Stmt { slet(name, v) }
set_in = (a: Allocator, name: string_view, v: Ptr<Expr>) Stmt { sassign(a.var_in(name), v) }
set* = (a: Allocator, name: string_view, v: Ptr<Expr>) Stmt { a.set_in(name, v) }
// Declarations
func_in = (a: Allocator, name: string_view, ps: [Param], ret: Ty, body: [Stmt]) Decl {
    dfunc(Func(
        name: name,
        params: a.dupx_in(ps).expect("std.internal.ast: AST allocation failed"),
        ret: ret,
        body: a.dupx_in(body).expect("std.internal.ast: AST allocation failed"),
    ))
}
func = (a: Allocator, name: string_view, ps: [Param], ret: Ty, body: [Stmt]) Decl {
    a.func_in(name, ps, ret, body)
}
struct_in = (a: Allocator, name: string_view, fs: [Field]) Decl {
    dstruct(StructDecl(
        name: name,
        fields: a.dupx_in(fs).expect("std.internal.ast: AST allocation failed"),
    ))
}
struct = (a: Allocator, name: string_view, fs: [Field]) Decl { a.struct_in(name, fs) }
accessor_in = (a: Allocator, sname: string_view, f: Field) Decl {
    recv := a.ptrto_in(named(sname))
    body := a.dot_in(a.var_in("s"), f.name)
    a.func_in(f.name, [param("s", recv)], f.ty, [body.ret()])
}
empty_fields = () [Field] { slice(null_ptr(), 0) }
decl_seed = () [Decl] {
    [
        dstruct(StructDecl(
            name: "",
            fields: empty_fields(),
        )),
    ]
}
dbuf_in* = (a: Allocator, n: i64) [Decl] {
    a.buf_in(n, decl_seed()).expect("std.internal.ast: AST allocation failed")
}
fill_accessors_in = (a: Allocator, buf: [Decl], sd: StructDecl) [Decl] {
    sd.fields.loop((h, i, f) {
        buf[i] = a.accessor_in(sd.name, f)
    })
    buf
}
derive_accessors_in* = (a: Allocator, sd: StructDecl) [Decl] {
    a.fill_accessors_in(a.dbuf_in(sd.fields.len), sd)
}
derive_accessors = (a: Allocator, sd: StructDecl) [Decl] { a.derive_accessors_in(sd) }
field_eq_in = (a: Allocator, fname: string_view) Ptr<Expr> {
    a.eqx_in(a.dot_in(a.var_in("x"), fname), a.dot_in(a.var_in("y"), fname))
}
derive_eq_in = (a: Allocator, name: string_view, sd: StructDecl) Decl {
    pty := a.ptrto_in(named(sd.name))
    body := a.var_in("true")
    sd.fields.loop((h, i, f) {
        body = a.and_in(body, a.field_eq_in(f.name))
    })
    a.func_in(name, [param("x", pty), param("y", pty)], tbool(), [body.ret()])
}
derive_eq = (a: Allocator, name: string_view, sd: StructDecl) Decl { a.derive_eq_in(name, sd) }
