// an ESCAPING closure — the thread body, which is why it takes an
// Alloc — capturing a binding that was already consumed.
//
// the capture is what makes this different from the other use-after-
// consume files: the use is not on any path main will walk, it is in
// a body that runs later, on another thread. the checker sees the
// capture list, so the capture IS the use.
//
// ONLY ONE OF THE TWO ORDERS IS GATED HERE, and it is the weaker one. This
// file consumes and THEN captures, which ordinary source-order dead-binding
// reporting already catches -- delete `check_scope_captured` whole and this
// stays green. The order that needs the capture rule is capture and THEN
// consume: the closure still runs later, on another thread, and reads a
// binding that died after it was written down. That program is accepted in
// silence today -- issue #741 -- so it cannot be a must-fail test yet. When
// it closes, the sibling file goes here.
//
// The unrelated `no implicit error conversion` diagnostic this file also
// draws, for `ThreadError` failing to widen into a set that literally names
// it, is the `.try()` face of issue #736. must-fail allows extra
// diagnostics, which is how it sat here unnoticed.

Buf = {
    id: i32,
}

Buf.impl(Drop, {
    drop = (self :: @Self) () { /* nothing to release: id is bytes */ }
})

Error = AllocError | IoError | ThreadError

main = (env: Env) Res<i32, Error> {
    alloc ::= env.mem.alloc();
    f = Buf(id: 1);
    g = consume f;
    t = env.threads.spawn(alloc, () Res<i32, ThreadError> {
        Ok(f.id);
    }).try();
    t.join().match({
        Ok(v)  => println("{}", v),
        Err(e) => println("thread failed: {}", e),
    });
    println("{}", g.id);
    Ok(0);
}
