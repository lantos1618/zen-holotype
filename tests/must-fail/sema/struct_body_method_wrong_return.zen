// A method declared in a struct body promises a return type like any
// other declaration, and its body has to fit it. The struct-body walk
// ran the QUERIES and stopped there — it was the ordinary body walk
// minus `check_return` and minus `check_own` — so this compiled clean
// even though `area` is called.
//
// position: the tail expression, which is the value that has to change.

Boxy = {
    width: i32,

    area* = (self: @Self) i32 { "not an int" }
}

main = (env: Env) Res<i32, AllocError> {
    println("{}", Boxy(width: 2).area());
    Ok(0);
}
