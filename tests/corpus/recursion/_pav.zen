// probeAV: generic mutual recursion where the STRUCT payload is rebuilt
// through each hop (value must survive the generic crossing)
Box2 = {
    v: i64,
}

bump = <T>(b: T, n: i64) i64 {
    (n == 0).match({
        true  => 0,
        false => b.v + take_g(b, n - 1),
    });
}

take_g = <T>(x: T, n: i64) i64 {
    (n == 0).match({
        true  => 0,
        false => 10 + bump(x, n - 1),
    });
}

main = (env: Env) Res<i32, AllocError> {
    println("g {}", bump(Box2(v: 5), 3));
    Ok(0);
}
