// A call through a type parameter uses the member signature promised by its
// bound. The implementation chosen later cannot change the parameter types.
//
// position: the call whose arguments match no declared signature.

Shower = {
    show* ::= (self: @Self, a: i32, b: i32) i32
}

Thing = {}

Thing.impl(Shower, {
    show = (self: @Self, a: i32, b: i32) i32 { a + b }
})

use = <T: Shower>(value: T) i32 { value.show("a", "b") }

main = (env: Env) Res<i32, AllocError> {
    println("{}", use(Thing()));
    Ok(0);
}
