        src: "test* = () i64 { x := 5  q := assert_nonnull(x)  load(q) }",
        should_pass: false,
        kind: "arg-type",
    ), VerdictCase(
        src: "test* = () i64 { p: RawPtr<i64> := malloc(8)  q := assert_nonnull(p)  store(q, 7)  load(q) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "id<T> = (x: T) T { x }\ntest* = () i32 { to_i32(id<i32>(5)) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "sz<T> = () i64 { sizeof(T) }\ntest* = () i64 { sz<i64>() + sz<i32>() }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "ap<T> = (x: T, f: (T, T) T) T { f(x, x) }\ntest* = () i32 { ap(5, (a, b){ a + b }) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "Res: Okv(i32) | Nov\ntest* = () Res { x := Res\n.Okv(1) }",
        should_pass: false,
        kind: "undefined-name",
    ), VerdictCase(
        src: "Res: Okv(i32) | Nov\ntest* = () Res { Res.Okv(1) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "f* = (a: i32, b: i32) i32 { a + b }\napply<T> = (x: T, f: (T) T) T { f(x) }\ntest* = () i32 { apply(5, (v: i32) i32 { v * 2 }) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "f* = (a: i64, b: i64) i64 { a + b }\napply<T> = (x: T, f: (T) T) T { f(x) }\ntest* = () i64 { f(1, 2) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "f* = (a: i64, b: i64) i64 { a + b }\napply* = (x: i64, f: (i64) i64) i64 { f(x) }\ntest* = () i64 { apply(5, (v: i64) i64 { v * 3 }) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "f* = (a: i64, b: i64) i64 { a + b }\ndouble* = (v: i64) i64 { v * 2 }\ntest* = () i64 { f := double\nf(4) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "dbl* = (v: i64) i64 { v * 2 }\ng* = (store_i64: (i64) i64) i64 { store_i64(21) }\ntest* = () i32 { to_i32(g(dbl)) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "Res: Okv(i32) | Nov\ntest* = () Res { Res /* two\nlines */ .Okv(1) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "Res: Okv(i32) | Nov\npick = (c: bool) Res { c.match ({ true => Res\n.Okv(1), false => Res.Nov, }) }\ntest* = () Res { pick(true) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "Res: Okv(i32) | Nov\nS := Res.Okv(1)\nG := S\n.Okv(2)\ntest* = () i32 { 0 }",
        should_pass: false,
        kind: "parse",
    ), VerdictCase(
        src: "gen<T> = (n: i32, x: T) i32 { n }\ntest* = () i32 { gen(5, \"anything\")  0 }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "gen<T> = (n: i32, s: str) i32 { n }\ntest* = () i32 { gen(5, \"ok\")  0 }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "Box: Val(i32) | Empty\nsz = (o: Box) i32 { o.match ({ .Val(v) if v > 10 => 1, .Val(v) => 2, .Empty => 3 }) }\ntest* = () i32 { sz(Box.Val(9)) }",
        should_pass: false,
        kind: "no-if",
    ), VerdictCase(
        src: "{ println } = std.text.fmt\nT: { x: i32 }\nmain = () i32 { v := T(x: 5)  println(\"hi\")  v.x }\n",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "{ println } = std.text.fmt\nT: { x: i32 }\nmain = () i32 { v := T(x: 5)  println(v)  0 }\n",
        should_pass: false,
        kind: "trait-bound",
    )])
    // the SAME violated bound, but the call sits inside a SLICE LITERAL / a LAMBDA body. Both
    // used to pass: kvb_expr_kind's hand-written arm list had no `.SliceLit` and no `.Lambda`
    // arm, so its `_ => 0` default swallowed the whole subtree. It now delegates its default to
    // compiler.ast.expr_children, which lists every variant exactly once.
    // field-alias revival: a field freed through its source local is REBOUND to a fresh allocation
    // before being read — the reassignment revives the field alias, so this is NOT a use-after-free.
    // the two-arm `.then({ a }, { b })` is the boolean two-arm match: bool condition accepted …
    // … a non-bool condition is a positioned operand-type error (same Cond checker as the match form)
    // `.then` takes at most two block arguments — a THIRD argument is a positioned parse error
    // … and each argument must be a BLOCK — a non-block second argument is a positioned parse error
    // the ternary `c ? t : e` is NOT Zen (error[no-ternary], permanent law beside no-if) …
    // … and ANY stray `?` — even a partial `c ? t` — trips the same positioned guard
    // struct `==` is now STRUCTURAL (derived per-field fold) — this pinned the old rejection.
    // `if` is forbidden everywhere, including the former match-arm guard position.
    // C2 (task #35): a CONCRETE param of a GENERIC callee is now arg-checked (was off since the
    // right-arity call inlines away before the post-inline check). Accept: a correctly-typed
    // concrete arg + a tparam-typed slot that still DEFERS to monomorphization.
    // C2 accept: an all-concrete generic callee with correctly-typed args (no over-rejection).
    // #392 accepts (the value-consumed void-arm rule must NOT over-fire):
    // a DISCARDED match (void-fn tail) keeps mixed side-effect arms — no consumer, no error.
    // a DIVERGING arm (block ending in `return`) legitimately yields no value (#386 exemption).
    // the builder-style rewrite: a side-effect arm that still TRAILS the result type is legal.
    // hole 4, post-literal-strength: the annotation PINS T=u8 and the literal COERCES
    // (255 fits u8, like `u: u8 := 255`), so acceptance moved to the fit boundary: an
    // OUT-OF-RANGE literal (256) is what must reject now.
    // return position likewise: T=u8 from the declared return, 7 coerces; a literal that
    // CANNOT fit u8 (300) still rejects (the fit fires at the pinned arg binding).
    // a bounded generic `draw<A: Show>` called with a type that has NO Show impl: rejected at
    // the CALL SITE as trait-bound (the kvb raw-decls pass), never as undefined-name/arity.
    // the SAME bounded call with the satisfying type stays green.
    // a trait method with ZERO impls in the module: the call is a trait-bound gap on the
    // receiver type, NOT an undefined name (the trait declaration alone makes it a method).
    // a bound naming a NONEXISTENT trait can never be satisfied: trait-bound at the call site.
    // SHADOWING accept: an FnT param NAMED AFTER AN INTRINSIC (`store_i64: (i64) i64`) is a
    // genuine function-valued shadow — checked via the indirect-call path, never intrinsic arity.
    // glue-fix reject: `x := Res` ⏎ `.Okv(1)` is TWO statements (no silent glue into
    // `Res.Okv(1)`), so the bare type name `Res` used as a value is surfaced as an error.
    // glue-fix still-accept: the qualified ctor with its dot on the SAME line as the type.
    // SHADOWING accept: a closure param named `f` shadows the same-named top-level fn inside a
    // generic body — the call resolves to the LOCAL, never to top-level `f`'s (2-arg) signature.
    // SHADOWING accept, UNINSTANTIATED: the generic body is never monomorphized, but its raw
    // decl is still validated — the shadowed `f(x)` call must not be judged against top-level `f`.
    // SHADOWING accept, non-generic: an FnT param named `f` in a plain fn shadows top-level `f`.
    // SHADOWING accept: a LET-bound fn value named after a top-level fn — the local wins.
    // variant-break COMMENT-AWARE accept: a newline inside a /* */ block comment is not a line
    // break, so `Res /* two\nlines */ .Okv(1)` is ONE qualified ctor (comment content is inert).
    // variant-break DEPTH accept: in a match-arm VALUE no statement can begin, so `true => Res` ⏎
    // `.Okv(1),` continues the arm expression instead of manufacturing a parse error at the `,`.
    // variant-break TOP-LEVEL reject: `G := S` ⏎ `.Okv(2)` splits at statement level; the leftover
    // `.Okv(2)` cannot start a decl — reported as the rule-naming KVBREAK `parse` diagnostic.
    // soundness hole 4 (updated by literal binding-strength): the annotation pins T, the literal
    // coerces when it FITS; a literal that cannot fit the pinned T (256 in u8) still rejects.
    // hole 4 still-accept: the inferred instance IS correct (Box<i32>), so it type-checks.
    // hole 4 return position: the declared return pins T=u8; an unfittable literal (300) rejects.
    // soundness hole 5: i32 + i64 is i64 (the WIDER operand), so it cannot fit an i32 slot —
    // no silent truncation, and no order-dependence (`a + b` and `b + a` both reject).
    // hole 5 still-accept: legitimate i64 math and same-width i32 math are unchanged.
    // hole 5 still-accept: a numeric LITERAL operand adapts, so `c + 1` (u8 + int-lit) stays u8.
    // soundness hole 6: a UFCS trait method on a receiver that does NOT impl the trait (Box has
    // no Area impl) is a trait-bound error, not a bare `area` symbol leaked to the linker.
    // hole 6 still-accept: valid UFCS trait dispatch (Circle DOES impl Area) resolves and runs.
    // R1: a read-only `Ptr<T>` value must NOT satisfy a writable `MutPtr<T>` parameter (silent
    // write-laundering). do_bump would mutate through a pointer the caller declared read-only.
    // R1 still-accept: a writable `MutPtr<T>` DOES satisfy a read-only `Ptr<T>` parameter.
    // R8: assert_nonnull on a genuinely non-pointer arg (a scalar) is rejected (would emit a void
    // value into a non-void slot at cc time).
    // R8 still-accept: assert_nonnull on a real nullable `RawPtr<T>` narrows it to `MutPtr<T>`.
    // M5 turbofish still-accept: explicit type arg that AGREES with the value arg.
    // M5 turbofish still-accept: a sizeof-style nullary generic pinned by turbofish.
    // M5 closure still-accept: a correctly-arity'd, correctly-typed `(T,T)T` closure to a HOF.
    // Stage 3 nullability: deref of a nullable `RawPtr<T>` (T != u8) without a null-check is REJECTED.
    // store / offset through a nullable `RawPtr<T>` are likewise rejected.
    // `assert_nonnull` proves non-null (yields `MutPtr<T>`), so the subsequent load is accepted.
    // the `RawPtr<u8>` byte-buffer floor is EXEMPT — it derefs freely.
    // a non-null `Ptr<T>` / `MutPtr<T>` deref is unaffected by the nullability rule.
    // A one-armed bool `.match` is non-exhaustive in every position. Intentional one-way effects use
    // `.then({ ... })`; ordinary matches must spell `true` and `false` (or `_`) explicitly.
    // TPARAM-SCOPE accept (#68 slice 3): a user GLOBAL type named `T` — the tparam name of the stdlib
    // generic `print*<T>` — no longer poisons that generic. The tparam is fn-local (bind_tparams) and
    // shadows the global type inside its own body, so the generic body stays abstract/deferred and the
    // program type-checks (was: error pointing into fmt.zen with no attribution to the user file).
    // TPARAM-SCOPE reject-for-the-right-reason: passing that `T` VALUE where Display IS required is a
    // genuine trait-bound gap, reported at the USER call site (not leaked into stdlib) — soundness kept.
    // UNREACHABLE-ARM: an arm after a wildcard `_` can never fire (the emitter's switch stops at
    // default, silently DROPPING it) — rejected in value position AND in statement position (where
    // lower_match_arms would drop it pre-check); a well-ordered `_`-last match stays green.
    // TARG-ARITY: an explicit `<…>` list whose count ≠ the declared tparam count — too many on a call,
    // too few on a call, and a generic-struct ctor — each "expected N type argument(s), got M";
    // correct counts and fully-inferred calls stay green.
    // TRAIT-BOUND widening: a bounded tparam bound to a concrete PRIMITIVE (i32) or ENUM with no
    // impl now rejects at the call site (was a silent pass — only structs were checked); a generic
    // PASSTHROUGH (`wrap<T: Show>` forwarding to `draw<A: Show>`) still defers and stays green.
    // LIT-FOLD OVERFLOW: a literal `+`/`-`/`*` whose i64 fold would WRAP no longer yields a wrong
    // range verdict — the fold defers (u64 := MAX+MAX accepted); in-range folds still verdict
    // (i32 := 2G+2G still assign-fit).
    b := run_verdicts("verdict-kind", [VerdictCase(
        src: "R*: Ok(str) | Err(i32)\nmain = () i32 {\n    done := false\n    r: R = .Err(3)\n    s := r.match ({\n        .Ok(ns) => ns,\n        .Err(e) => { done = true },\n    })\n    0\n}\n",
        should_pass: false,
        kind: "arm-value",
    ), VerdictCase(
        src: "P: { x: i64 }\nW: { a: i64 }\nmain = () i32 {\n    p := P(x: 1)\n    w := W(a: 1)\n    (p == w).then({\n        return 1\n    })\n    0\n}\n",
        should_pass: false,
        kind: "operand-type",
    ), VerdictCase(
        src: "{ view } = std.text.str\nH: { bs: [u8], n: i64 }\nmain = () i32 {\n    h1 := H(bs: \"ab\".view(), n: 1)\n    h2 := H(bs: \"ab\".view(), n: 1)\n    (h1 == h2).then({\n        return 1\n    })\n    0\n}\n",
        should_pass: false,
        kind: "operand-type",
    ), VerdictCase(
        src: "main = () i32 {\n    n := 5\n    n.each_field((name, fv) { })\n    0\n}\n",
        should_pass: false,
        kind: "arg-type",
    ), VerdictCase(
        src: "P: { x: i64 }\nW: { a: i64 }\nmain = () i32 {\n    p := P(x: 1)\n    w := W(a: 2)\n    p.field_eq(w).then({\n        return 1\n    })\n    0\n}\n",
        should_pass: false,
        kind: "arg-type",
    ), VerdictCase(
        src: "P: { x: i64 }\nmain = () i32 {\n    p := P(x: 1)\n    p.each_field(42)\n    0\n}\n",
        should_pass: false,
        kind: "arg-type",
    ), VerdictCase(
        src: "P: { x: i64 }\nmain = () i32 {\n    p := P(x: 1)\n    p.each_field((only) { })\n    0\n}\n",
        should_pass: false,
        kind: "arg-type",
    ), VerdictCase(
        src: "P: { x: i64, y: i64 }\nmain = () i32 {\n    p := P(x: 1, y: 2)\n    p.zip_fields(p)\n    0\n}\n",
        should_pass: false,
        kind: "arity",
    ), VerdictCase(
        src: "P: { x: i64 }\nbad<T> = (v: T) i64 {\n    v.each_field((name, fv) { })\n    [1, 2, 3].loop((h, i, e) {\n        (e == 2).then({\n            return 9\n        })\n    })\n    0\n}\nmain = () i32 {\n    p := P(x: 1)\n    to_i32(bad(p))\n}\n",
        should_pass: false,
        kind: "reflect-return",
    ), VerdictCase(
        src: "P: { x: i64 }\nmain = () i32 {\n    p := P(x: 1)\n    p.variant_name()\n    0\n}\n",
        should_pass: false,
        kind: "arg-type",
    ), VerdictCase(
        src: "main = () i32 {\n    n := 5\n    n.variant_name()\n    0\n}\n",
        should_pass: false,
        kind: "arg-type",
    ), VerdictCase(
        src: "E: A | B\nvariant_name = (e: E) string_view { \"no\" }\nmain = () i32 { 0 }\n",
        should_pass: false,
        kind: "reserved-name",
    ), VerdictCase(
        src: "E: A | B(i64)\nmain = () i32 {\n    ok := E.A.variant_name() == \"A\" && E.B(1).variant_name() == \"B\"\n    ok.match ({ true => 0, false => 1 })\n}\n",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "P: { x: i64 }\nrec<T> = (v: T, n: i64) i64 {\n    v.each_field((name, fv) { })\n    (n > 0).match ({\n        true  => rec(v, n - 1),\n        false => 0,\n    })\n}\nmain = () i32 {\n    p := P(x: 1)\n    to_i32(rec(p, 5))\n}\n",
        should_pass: false,
        kind: "recursive-hof",
    ), VerdictCase(
        src: "Point: { x: i64, y: i64 }\nRect: { a: Point, b: Point }\nbump2<T> = (v: T) T {\n    w := v\n    w.each_field((n, fv) {\n        fv.each_field((n2, fv2) { fv2 = fv2 + 1 })\n    })\n    w\n}\nmain = () i32 {\n    r := Rect(a: Point(x: 1, y: 1), b: Point(x: 1, y: 1))\n    r2 := bump2(r)\n    out: i32 := (r2.a.x == 2).match ({ true => 0, false => 3 })\n    out\n}\n",
        should_pass: false,
        kind: "reflect-write",
    ), VerdictCase(
        src: "Point: { x: i64, y: i64 }\nRect: { a: Point, b: Point }\nbump2<T> = (v: T) T {\n    w := v\n    w.each_field((n, fv) {\n        leaf := fv\n        leaf.each_field((n2, fv2) { fv2 = fv2 + 1 })\n        fv = leaf\n    })\n    w\n}\nmain = () i32 {\n    r := Rect(a: Point(x: 1, y: 1), b: Point(x: 1, y: 1))\n    r2 := bump2(r)\n    out: i32 := (r2.a.x == 2).match ({ true => 0, false => 3 })\n    out\n}\n",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "Point: { x: i64, y: i64 }\nRect: { a: Point, b: Point }\nsum2<T> = (v: T) i64 {\n    acc: i64 := 0\n    v.each_field((n, fv) {\n        fv.each_field((n2, fv2) { acc = acc + fv2 })\n    })\n    acc\n}\nmain = () i32 {\n    r := Rect(a: Point(x: 1, y: 1), b: Point(x: 1, y: 1))\n    to_i32(sum2(r))\n}\n",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "side = () void { }\nR*: Ok(str) | Err(i32)\nmain = () i32 {\n    r: R = .Err(3)\n    s := r.match ({ .Ok(ns) => ns, .Err(e) => side() })\n    0\n}\n",
        should_pass: false,
        kind: "arm-value",
    ), VerdictCase(
        src: "main = () i32 {\n    done := false\n    c := true\n    s := c.match ({ true => \"x\", false => { done = true } })\n    0\n}\n",
        should_pass: false,
        kind: "arm-value",
    ), VerdictCase(
        src: "use_s = (s: str) i32 { 0 }\nR*: Ok(str) | Err(i32)\nmain = () i32 {\n    done := false\n    r: R = .Err(3)\n    use_s(r.match ({ .Ok(ns) => ns, .Err(e) => { done = true } }))\n}\n",
        should_pass: false,
        kind: "arm-value",
    ), VerdictCase(
        src: "g* = (x: i32) i32 { x }\nf* = (flags: RawPtr<u8>, i: i32, n: i32) void { (i < n).match({ true => { g(1, 2, 3)  store_i64(flags, 1) }, false => {} }) }\ntest* = () i32 { 0 }",
        should_pass: false,
        kind: "arity",
    ), VerdictCase(
        src: "f* = (flags: RawPtr<u8>, i: i32, n: i32) void { (i < n).match({ true => { store_i64(flags)  store_i64(flags, 1) }, false => {} }) }\ntest* = () i32 { 0 }",
        should_pass: false,
        kind: "arity",
    ), VerdictCase(
        src: "add* = (a: i32, b: i32) i32 { a + b }\ntest* = () i32 { add(1) }",
        should_pass: false,
        kind: "arity",
    ), VerdictCase(
        src: "add* = (a: i32, b: i32) i32 { a + b }\ntest* = () i32 { add(1, 2, 3) }",
        should_pass: false,
        kind: "arity",
    ), VerdictCase(
        src: "zero* = () i32 { 0 }\ntest* = () i32 { zero(1) }",
        should_pass: false,
        kind: "arity",
    ), VerdictCase(
        src: "one* = (a: i32) i32 { a }\ntest* = () i32 { one() }",
        should_pass: false,
        kind: "arity",
    ), VerdictCase(
        src: "test* = () i64 { p := malloc(8)  store_i64(p)  0 }",
        should_pass: false,
        kind: "arity",
    ), VerdictCase(
        src: "test* = () i64 { p := malloc(8)  store_i64(p, 1, 2)  0 }",
        should_pass: false,
        kind: "arity",
    ), VerdictCase(
        src: "test* = () i64 { p := malloc(8)  q := offset(p)  0 }",
        should_pass: false,
        kind: "arity",
    ), VerdictCase(
        src: "test* = () i64 { p := null_ptr(7)  0 }",
        should_pass: false,
        kind: "arity",
    ), VerdictCase(
        src: "g* = (a: i32) i32 { a }\nf* = (b: bool) i32 { b.match({ true => { g(1, 2)  1 }, false => 0 }) }\ntest* = () i32 { f(1 < 2) }",
        should_pass: false,
        kind: "arity",
    ), VerdictCase(
        src: "takes_u8* = (b: u8) i32 { 0 }\nbig* = () i64 { 9999999999 }\ntest* = () i32 { takes_u8(big()) }",
        should_pass: false,
        kind: "arg-type",
    ), VerdictCase(
        src: "P*: { x: i32 }\nneeds_p* = (p: P) i32 { p.x }\nmk* = () i64 { 5 }\ntest* = () i32 { needs_p(mk()) }",
        should_pass: false,
        kind: "arg-type",
    ), VerdictCase(
        src: "A*: { v: i32 }\nB*: { v: i32 }\nneeds_a* = (a: A) i32 { a.v }\ntest* = () i32 { needs_a(B(v: 5)) }",
        should_pass: false,
        kind: "arg-type",
    ), VerdictCase(
        src: "scalar* = (n: i32) i32 { n }\ntest* = () i32 { s := [1, 2]\n scalar(s) }",
        should_pass: false,
        kind: "arg-type",
    ), VerdictCase(
        src: "find* = (s: str, n: str) i64 { 0 }\nSeeker*: { find: (Ptr<Self>, i32) i32 }\nColl*: { n: i32 }\nColl.impl(Seeker, { find = (c: Ptr<Coll>, k: i32) i32 { c.n } })\ntest* = () i32 { xs: [i32] := [1, 2]  to_i32(xs.find(3)) }",
        should_pass: false,
        kind: "method-not-found",
    ), VerdictCase(
        src: "find* = (s: str, n: str) i64 { 0 }\nSeeker*: { find: (Ptr<Self>, i32) i32 }\nColl*: { n: i32 }\nColl.impl(Seeker, { find = (c: Ptr<Coll>, k: i32) i32 { c.n } })\ntest* = () i32 { c := Coll(n: 7)  c.addr().find(3) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { nope() }",
        should_pass: false,
        kind: "undefined-name",
    ), VerdictCase(
        src: "{ contains } = std.text.str\ntest* = (yn: string_view) i64 { yn.len() }",
        should_pass: false,
        kind: "undefined-name",
    ), VerdictCase(
        src: "{ contains } = std.text.str\nP*: { x: i32 }\ntest* = (p: P) i64 { p.len() }",
        should_pass: false,
        kind: "method-not-found",
    ), VerdictCase(
        src: "{ len } = std.text.str\ntest* = (yn: string_view) i64 { yn.len() }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { foo(1) + bar(2) }",
        should_pass: false,
