// src/lex/lex_state.zen
// The scan in progress: where we are, what we have read, and what we owe.
//
// It is one type because the three move together — a token is emitted from
// a remembered start to wherever the cursor now is, and a diagnostic is
// emitted exactly the same way. `emit` and `report` are that one shape,
// written once, so a token's span and a fault's span can never be computed
// by two rules that drift apart.
//
// It lives in its own file so that lex_scan.zen and lex_literal.zen can
// both build on it without importing each other. The bootstrapper accepts a
// mutual import, but a lexer that needs one is a lexer whose layers are not
// layers.
//
// LAW 1 IS VISIBLE IN THE SIGNATURE. A Lexer holds two Vecs, so building one
// takes an Alloc, and `lex` says so in `src/lex/lex_scan.zen`. Nothing here
// allocates behind a caller's back.

Pos, Span, Token, TokenKind, Source = lex.lex_token
Diag, LexFault = lex.lex_diag
Cursor, cursor_at = lex.lex_cursor
Alloc, AllocError = std.mem
Vec = std.collections

Lexer* = {
    source: Source,
    cur* :: Cursor,
    tokens* :: Vec<Token>,
    diags* :: Vec<Diag>,

    // a token from `from` to here. Half-open, so the end is the first byte
    // that is not part of it
    emit* = (self :: @Self, kind: TokenKind, from: Pos) Res<(), AllocError> {
        self.tokens.add(Token(kind: kind, span: self.span_from(from)));
    }

    // a fault from `from` to here. `from` is the byte the fix goes at, which
    // is not always the byte the scanner noticed: an unterminated string is
    // reported at its OPENING QUOTE, because end-of-file names no useful
    // location and the quote is what the author has to change
    report* = (self :: @Self, fault: LexFault, from: Pos) Res<(), AllocError> {
        self.diags.add(Diag(file: self.source.file, fault: fault, span: self.span_from(from)));
    }

    span_from* = (self: @Self, from: Pos) Span {
        Span(start: from, end: self.cur.pos());
    }

    // the bytes between `from` and the cursor. What a name, a number and an
    // `@name` all need in order to decide which token they are
    since* = (self: @Self, from: Pos) str {
        self.source.text.slice(from.offset, self.cur.pos().offset);
    }
}

// `alloc.Lexer(source)`: a ufcs function whose first parameter is an Alloc,
// so it calls as a method on one — the surface `alloc.Vec<T>()` already
// uses, and the reason law 1 reads as ordinary code rather than ceremony
Lexer* = (alloc: Alloc, source: Source) Lexer {
    Lexer(
        source: source,
        cur: cursor_at(source.text),
        tokens: alloc.Vec<Token>(),
        diags: alloc.Vec<Diag>(),
    );
}

// what one lex run produced. The tokens it could read AND the diagnostics
// it owes — never one or the other, because a file with a bad escape in it
// still has three hundred perfectly good tokens, and a driver reporting
// twelve faults at once needs them all
Lexed* = {
    source*: Source,
    tokens*: Vec<Token>,
    diags*: Vec<Diag>,

    is_clean* = (self: @Self) bool { self.diags.len == 0 }
}
