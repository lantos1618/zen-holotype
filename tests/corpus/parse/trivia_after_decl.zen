Point = {
    x: i32,   // trailing comment on a field
    y: i32,
}   // trailing comment on a declaration's closing brace

// a comment between two declarations: leading trivia of `main`,
// never trailing trivia of `Point`.
main = (env: Env) Res<i32, ArgError> {
    p = Point(x: 1, y: 2);   // trailing comment on a statement
    println("{}", p.x);
    Ok(0);
}
