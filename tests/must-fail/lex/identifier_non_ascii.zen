// a non-ascii identifier. DESIGN.md never writes one and never states
// the identifier charset, so this file assumes ascii-only -- the
// conservative reading, since widening a charset later is compatible
// and narrowing it is not.
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    café: i32 = 1;
    println("{}", café);
    Ok(0);
}
