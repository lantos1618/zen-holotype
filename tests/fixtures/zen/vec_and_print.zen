halloc = std.mem.heap
vec = std.collections.vec
{ expect } = std.core.result
{ println } = std.io.print
main = () i32 {
    alloc = halloc.gpa()
    a = alloc.addr()
    v = vec.of(a.allocator(), [10, 20]).expect("of")
    v2 = v.push(a, 30).expect("push")
    println(v2.get(0))
    println(v2.get(2))
    0
}
