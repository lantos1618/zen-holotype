// `rt.set_default` must freeze before the first RAW OS thread as well as before pool actors. The
// public thread.spawn boundary latches the guard synchronously before pthread_create, so this late
// write cannot race a fresh thread reading the process default. Asserted by harness_build's shell
// suite: exit 134 and the exact teaching-panic line.
{ spawn } = std.concurrent.thread
{ set_default, heap_rt } = std.rt
worker = (arg: RawPtr<u8>) RawPtr<u8> { null_ptr() }
main = () i32 {
    spawn(worker, null_ptr())
    set_default(heap_rt())
    0
}
