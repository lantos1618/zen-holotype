// A NEGATED LITERAL NAMES ITSELF IN THE OUT-OF-RANGE SENTENCE (#803).
// `literal does not fit i8` sent the author hunting for a number the
// message refused to say; the positive spelling has named its subject
// all along (`literal 300 does not fit u8`), because `written_literal`
// answered "" for anything that was not a Literal or a Paren while
// `literal_int`, two functions away, already walked the same Unary arm
// to range-check the value. The range half saw the minus; the message
// half did not.
//
// position: the `-`, not the digits — it is the negation that makes
// the literal one an i8 cannot hold, matching what
// sema_trap.out_of_range points its caret at.

AllocError = std.mem

main = (env: Env) Res<i32, AllocError> {
    q: i8 = -200;
    println("{}", q);
    Ok(0);
}
