// A private overload is not a candidate outside this module. The two pairs use
// opposite declaration orders and differ by type and arity respectively.
Box* = {
    v*: i32,

    by_type = (self: @Self, text: str) i32 { self.v }
    by_type* = (self: @Self, n: i32) i32 { self.v + n }

    by_arity* = (self: @Self, n: i32) i32 { self.v + n + 1 }
    by_arity = (self: @Self, a: i32, b: i32) i32 { self.v + a + b }
}
