// src/sema/sema_own.zen
// Who owns a value.
//
// PLAN.md stage 3. DESIGN.md's Ownership section is the law, and this
// file takes the half of it that is about UNIQUENESS: `consume` is the
// only move, a moved place is dead, a `Drop` value cannot be copied, and
// a partial move may not reach the drop. Its two siblings take the other
// halves — `sema_recv.zen` who may WRITE through a name, `sema_scope.zen`
// how long a block LASTS — and all three are driven from here, because
// this is the file with the walk.
//
// A SECOND WALK, NOT A SECOND TYPE CHECKER. Everything in this folder is
// a memoized query over a node; this is the one rule family that is not
// a question about a node at all, because "was this binding already
// moved out of" is a fact about the PATH taken to reach the node. So it
// is a flow walk, run once per body, after typing — which is exactly the
// shape `sema_decl.zen` already has for the rules nobody would ask.
//
// IT NEVER COMPUTES A TYPE, AND THAT IS A SAFETY PROPERTY RATHER THAN AN
// OPTIMISATION. By the time this runs, the block-local bindings that
// typing put in `Checker.locals` have been released, so asking
// `type_of` about a name node would resolve it against an empty scope
// and report an undefined name that the program does not contain. Every
// type this file reads therefore comes from one of two places that
// cannot report: `Checker.expr_memo`, which only ever answers what
// typing already decided, and `OwnVar.ty`, which this walk recorded on
// the way past. A type neither can supply means the rule does not fire.
//
// FAIL OPEN, ALWAYS. A false rejection makes a correct program
// uncompilable, and `src/` is a hundred and twenty modules of correct
// program. So every lookup here answers "no opinion" when it cannot
// answer, and each rule below states what it does when it does not know.
//
// A PLACE, NOT AN EXPRESSION. `consume p.left` is tracked and
// `consume bufs[0]` is refused, and the difference is the whole of what
// a place is: a fixed name, or one fixed field of one. An element index
// is a runtime value, so "which element is dead" is not a fact the
// compiler holds; tracking whole bindings only would be too coarse to
// see the field, and tracking arbitrary expressions would be a checker
// with no bottom.
//
// THE JOIN IS "CONSUMED IF CONSUMED ANYWHERE". Match arms are
// alternative paths and each starts from the state before the match, so
// two arms that both consume one binding are not a double move; after
// the match the binding is dead because it is dead on some path. A
// closure body is the same join reached through a call rather than
// through an arm — which is why `.then` is not opaque here.

Ast, Expr, ExprId, Block, BlockId, Stmt, StmtKind, Bind, ExprStmt = ast
Decl, DeclKind, Struct, Impl, Member, MemberKind, Function, Param = ast
Call, Arg, Access, Match, Arm, Lambda, Index, Consume, Module = ast
Span, Ident, Name, Paren, Try, Unary, Binary = ast
ArrayLit, Record, FixedArray, Field, Const = ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
DeclId, ImplId = sema.sema_id
TyId, Ty, Types, TyNamed = sema.sema_ty
World, decl_at = sema.sema_def
Checker, Ctx = sema.sema_check
Diag, SemaFault, NameFault = sema.sema_diag
check_receiver = sema.sema_recv
check_scope_returned, check_scope_stored = sema.sema_scope

// One name this frame can see, and what the ownership rules know of it.
//
// `owned` is "this frame constructed the value", which is what separates
// `consume p.left` from `consume env.argv`: a local is storage this
// block will drop, and a parameter is a borrow whose owner is somewhere
// up the stack. `ty` is recorded rather than asked for, for the reason
// the header gives.
OwnVar* = {
    name*: str,
    ty*: TyId,
    mutable*: bool,
    owned*: bool,
    span*: Span,
}

// A place that has been moved out of: a binding, or one of its fields.
//
// `root` is an index into `Own.vars` and not a name, so shadowing costs
// nothing and releasing a scope is a comparison on the index. `field` is
// empty for the whole binding. `span` is where the move was WRITTEN,
// which is the position a loop's back edge reports against — the second
// iteration's use of the dead binding is the `consume` itself.
Place* = {
    root*: usize,
    field*: str,
    span*: Span,
}

// The walk's state. A stack with marks, exactly as `Checker.locals` is
// and for the reason stated there: a chain of frames needs indirection
// and every frame is an allocation.
Own* = {
    vars :: Vec<OwnVar>,
    dead :: Vec<Place>,
    alloc*: Alloc,
}

Own* = (a: Alloc) Res<Own, AllocError> {
    Ok(Own(vars: a.Vec<OwnVar>(), dead: a.Vec<Place>(), alloc: a));
}

// ---------------------------------------------------------------------
// the entry points
// ---------------------------------------------------------------------

// One function body. Called from `sema_decl.zen` with the body's own
// context and with the parameters still bound, which is the only moment
// at which a parameter's declared type and mutability can be read back
// without re-deriving them.
check_own* = (c :: Checker, f: Function, body: BlockId, ctx: Ctx)
             Res<(), AllocError> {
    o ::= c.alloc.Own().try();
    own_params(c, o, f).try();
    own_block(c, o, body, ctx).try();
    check_scope_returned(c, body).try();
    Ok(());
}

// A parameter is a borrow: the caller still owns it, so nothing may be
// moved out through it, and `mutable` is the `::` the declaration wrote.
own_params = (c :: Checker, o :: Own, f: Function) Res<(), AllocError> {
    f.params.loop((h, p) { own_param(c, o, p).try() });
    Ok(());
}

own_param = (c :: Checker, o :: Own, p: Param) Res<(), AllocError> {
    text = p.name.text;
    ty = c.lookup(text).match({ Ok(b) => b.ty, None => UNTYPED });
    o.vars.add(OwnVar(name: text, ty: ty, mutable: p.mutable,
                      owned: false, span: p.name.span))
}

// ---------------------------------------------------------------------
// the walk
// ---------------------------------------------------------------------

own_block = (c :: Checker, o :: Own, id: BlockId, ctx: Ctx)
            Res<(), AllocError> {
    b = c.tree.block_at(id);
    mark = o.vars.len;
    b.stmts.loop((h, s) { own_stmt(c, o, s, ctx).try() });
    b.value.match({
        Ok(v)  => own_expr(c, o, v, ctx),
        None   => Ok(()),
    }).try();
    check_partial_moves(c, o, mark).try();
    own_release(o, mark).try();
    Ok(());
}

own_stmt = (c :: Checker, o :: Own, s: Stmt, ctx: Ctx) Res<(), AllocError> {
    s.kind.match({
        Bind(b)  => own_bind(c, o, b, ctx),
        Expr(e)  => own_expr(c, o, e.expr, ctx),
        Block(x) => own_block(c, o, x, ctx),
        Decl(_)  => Ok(()),
    })
}

// The value is read BEFORE the target is written, which is the order the
// program runs in and the order the rules need: `f = consume f` reads a
// live `f` and leaves a dead one.
own_bind = (c :: Checker, o :: Own, b: Bind, ctx: Ctx) Res<(), AllocError> {
    own_expr(c, o, b.value, ctx).try();
    check_drop_copy(c, o, b, ctx).try();
    own_target(c, o, b, ctx).try();
    Ok(());
}

// A binding target is a NAME the frame now owns, or a place written back
// into. A write to a place that was moved out of REVIVES it — the hole
// is filled, and a checker that never forgets would refuse the one fix
// the author has.
own_target = (c :: Checker, o :: Own, b: Bind, ctx: Ctx)
             Res<(), AllocError> {
    node = c.tree.expr_at(b.target);
    node.kind.match({
        Name(n)   => bind_name(c, o, b, n.text, node.span, ctx),
        Access(a) => revive_field(c, o, a, ctx),
        _         => own_expr(c, o, b.target, ctx),
    })
}

// A name already in scope is an assignment; a name that is not is a new
// binding this frame owns. Zen spells both `x = e;`, so which one it is
// is a question about the scope and not about the syntax.
bind_name = (c :: Checker, o :: Own, b: Bind, text: str, span: Span,
             ctx: Ctx) Res<(), AllocError> {
    find_var(o, text).match({
        Ok(i) => revive(o, i, ""),
        None  => declare_var(c, o, b, text, span, ctx),
    })
}

declare_var = (c :: Checker, o :: Own, b: Bind, text: str, span: Span,
               ctx: Ctx) Res<(), AllocError> {
    o.vars.add(OwnVar(name: text, ty: memo_type(c, b.value),
                      mutable: b.mutable, owned: true, span: span))
}

revive_field = (c :: Checker, o :: Own, a: Access, ctx: Ctx)
               Res<(), AllocError> {
    path_root(c, o, a.base).match({
        None  => Ok(()),
        Ok(i) => revive(o, i, a.name.text),
    }).try();
    own_expr(c, o, a.base, ctx).try();
    Ok(());
}

own_expr = (c :: Checker, o :: Own, id: ExprId, ctx: Ctx)
           Res<(), AllocError> {
    node = c.tree.expr_at(id);
    node.kind.match({
        Name(n)       => use_name(c, o, node, n.text),
        Access(a)     => use_access(c, o, node, a, ctx),
        Consume(x)    => own_consume(c, o, x, ctx),
        Call(k)       => own_call(c, o, id, k, ctx),
        Match(m)      => own_match(c, o, m, ctx),
        Lambda(l)     => own_lambda(c, o, l, ctx, false),
        Block(b)      => own_block(c, o, b, ctx),
        Paren(p)      => own_expr(c, o, p.inner, ctx),
        Try(t)        => own_expr(c, o, t.operand, ctx),
        Unary(u)      => own_expr(c, o, u.operand, ctx),
        Binary(bi)    => own_pair(c, o, bi.lhs, bi.rhs, ctx),
        Index(x)      => own_pair(c, o, x.base, x.index, ctx),
        Array(a)      => own_elems(c, o, a.elems, ctx),
        FixedArray(a) => own_elems(c, o, a.elems, ctx),
        Record(r)     => own_record(c, o, r.entries, ctx),
        _             => Ok(()),
    })
}

own_pair = (c :: Checker, o :: Own, a: ExprId, b: ExprId, ctx: Ctx)
           Res<(), AllocError> {
    own_expr(c, o, a, ctx).try();
    own_expr(c, o, b, ctx).try();
    Ok(());
}

own_elems = (c :: Checker, o :: Own, elems: Vec<ExprId>, ctx: Ctx)
            Res<(), AllocError> {
    elems.loop((h, e) { own_expr(c, o, e, ctx).try() });
    Ok(());
}

own_record = (c :: Checker, o :: Own, entries: Vec<Member>, ctx: Ctx)
             Res<(), AllocError> {
    entries.loop((h, m) { own_member_value(c, o, m, ctx).try() });
    Ok(());
}

own_member_value = (c :: Checker, o :: Own, m: Member, ctx: Ctx)
                   Res<(), AllocError> {
    m.kind.match({
        Field(f)    => opt_expr(c, o, f.value, ctx),
        Const(k)    => own_expr(c, o, k.value, ctx),
        Function(_) => Ok(()),
    })
}

opt_expr = (c :: Checker, o :: Own, e: Res<ExprId>, ctx: Ctx)
           Res<(), AllocError> {
    e.match({ Ok(x) => own_expr(c, o, x, ctx), None => Ok(()) })
}

// ---------------------------------------------------------------------
// RULE: a place that was moved out of is dead
// ---------------------------------------------------------------------

use_name = (c :: Checker, o :: Own, node: Expr, text: str)
           Res<(), AllocError> {
    find_var(o, text).match({
        None  => Ok(()),
        Ok(i) => report_if_dead(c, o, node.span, i, ""),
    })
}

// `p.left` is a place of its own and `p.right` beside it is untouched,
// so the field is checked before the base is. Reaching the base too is
// what makes `f.id` report `f` after `consume f`.
use_access = (c :: Checker, o :: Own, node: Expr, a: Access, ctx: Ctx)
             Res<(), AllocError> {
    path_root(c, o, a.base).match({
        None  => Ok(()),
        Ok(i) => report_if_dead(c, o, node.span, i, a.name.text),
    }).try();
    own_expr(c, o, a.base, ctx).try();
    Ok(());
}

report_if_dead = (c :: Checker, o :: Own, span: Span, root: usize,
                  field: str) Res<(), AllocError> {
    is_dead(o, root, field).match({
        false => Ok(()),
        true  => report_consumed(c, o, span, root, field),
    })
}

report_consumed = (c :: Checker, o :: Own, span: Span, root: usize,
                   field: str) Res<(), AllocError> {
    name = place_name(c, o, root, field).try();
    c.report(span.file, span, SemaFault.ConsumedUse(NameFault(name: name)))
}

// ---------------------------------------------------------------------
// RULE: `consume` moves, and only a place this frame owns can move
// ---------------------------------------------------------------------

own_consume = (c :: Checker, o :: Own, x: Consume, ctx: Ctx)
              Res<(), AllocError> {
    node = c.tree.expr_at(x.operand);
    node.kind.match({
        Index(_)  => refuse(c, node.span, SemaFault.ConsumeNotAPlace(
                         NameFault(name: ""))),
        Name(n)   => consume_name(c, o, node, n.text),
        Access(a) => consume_field(c, o, node, a, ctx),
        _         => own_expr(c, o, x.operand, ctx),
    })
}

// The move is a USE first: a second `consume` of one binding is just
// another use of a dead name, and it reports where it is written.
consume_name = (c :: Checker, o :: Own, node: Expr, text: str)
               Res<(), AllocError> {
    use_name(c, o, node, text).try();
    find_var(o, text).match({
        None  => Ok(()),
        Ok(i) => kill(o, i, "", node.span),
    }).try();
    Ok(());
}

consume_field = (c :: Checker, o :: Own, node: Expr, a: Access, ctx: Ctx)
                Res<(), AllocError> {
    path_root(c, o, a.base).match({
        None  => own_expr(c, o, a.base, ctx),
        Ok(i) => consume_field_of(c, o, node, a, i),
    })
}

// YOU MAY ONLY MOVE WHAT THIS FRAME OWNS. A parameter is a borrow, and a
// handle is two words that a bitwise copy duplicates — moving out of one
// would leave every other copy holding a dead value, and there is no
// single binding the checker could mark dead to prevent that.
consume_field_of = (c :: Checker, o :: Own, node: Expr, a: Access,
                    root: usize) Res<(), AllocError> {
    owned_at(o, root).match({
        false => refuse(c, node.span, SemaFault.ConsumeThroughHandle(
                     NameFault(name: a.name.text))),
        true  => kill_field(c, o, node, a, root),
    })
}

kill_field = (c :: Checker, o :: Own, node: Expr, a: Access, root: usize)
             Res<(), AllocError> {
    report_if_dead(c, o, node.span, root, a.name.text).try();
    kill(o, root, a.name.text, node.span).try();
    Ok(());
}

// ---------------------------------------------------------------------
// RULE: a `Drop` value cannot be copied
//
// "The compiler calls drop exactly once, so `g = f` on a Drop type
// cannot copy — both would drop." Only a PLACE is a copy: a call result
// is a fresh value that nobody else names, and passing a place to a
// parameter is a borrow and not a move. Nothing fires when the type is
// unknown, which is the ordinary fail-open.
// ---------------------------------------------------------------------

check_drop_copy = (c :: Checker, o :: Own, b: Bind, ctx: Ctx)
                  Res<(), AllocError> {
    node = c.tree.expr_at(b.value);
    node.kind.match({
        Name(n) => drop_copy_of_name(c, o, node, n.text),
        _       => Ok(()),
    })
}

drop_copy_of_name = (c :: Checker, o :: Own, node: Expr, text: str)
                    Res<(), AllocError> {
    find_var(o, text).match({
        None  => Ok(()),
        Ok(i) => drop_copy_of_var(c, o, node, text, i),
    })
}

drop_copy_of_var = (c :: Checker, o :: Own, node: Expr, text: str,
                    root: usize) Res<(), AllocError> {
    o.vars.get(root).match({
        None  => Ok(()),
        Ok(v) => refuse_if_drop(c, node.span, v.ty, text),
    })
}

refuse_if_drop = (c :: Checker, span: Span, ty: TyId, text: str)
                 Res<(), AllocError> {
    drops = is_drop_type(c, ty).try();
    drops.match({
        false => Ok(()),
        true  => refuse(c, span, SemaFault.CopyOfDropValue(
                     NameFault(name: text))),
    })
}

// Does an impl OF Drop exist for this type? The trait is part of the
// question and not decoration: a type may declare a method of its own
// named `drop`, and that one is not what runs at scope exit.
is_drop_type* = (c :: Checker, ty: TyId) Res<bool, AllocError> {
    c.types.at(ty).match({
        Named(n) => named_is_drop(c, n),
        _        => Ok(false),
    })
}

named_is_drop = (c :: Checker, n: TyNamed) Res<bool, AllocError> {
    ids ::= c.alloc.Vec<ImplId>();
    c.world.impls_named(c.tree, n.name, ids).try();
    hits ::= c.alloc.Vec<bool>();
    ids.loop((h, id) { keep_drop_impl(c, n, id, hits).try() });
    Ok(hits.len > 0);
}

keep_drop_impl = (c :: Checker, n: TyNamed, id: ImplId, hits :: Vec<bool>)
                 Res<(), AllocError> {
    (n.decl.module == id.decl.module).match({
        false => Ok(()),
        true  => note_drop_impl(c, id, hits),
    })
}

note_drop_impl = (c :: Checker, id: ImplId, hits :: Vec<bool>)
                 Res<(), AllocError> {
    c.world.impl_at(c.tree, id).match({
        None   => Ok(()),
        Ok(im) => add_if_drop(c, im, hits),
    })
}

add_if_drop = (c :: Checker, im: Impl, hits :: Vec<bool>)
              Res<(), AllocError> {
    bound_named_drop(c, im).match({
        false => Ok(()),
        true  => hits.add(true),
    })
}

bound_named_drop = (c :: Checker, im: Impl) bool {
    c.tree.type_at(im.bound).kind.match({
        Named(n) => n.name.text.eq("Drop"),
        _        => false,
    })
}

// ---------------------------------------------------------------------
// RULE: a partial move may not reach the drop
//
// Drop runs on the whole binding at scope exit, and a field that was
// moved out is not there to drop. The diagnostic points at the binding
// rather than at the move, because the binding is the thing about to be
// dropped and "move the whole value or none of it" is the fix.
// ---------------------------------------------------------------------

check_partial_moves = (c :: Checker, o :: Own, mark: usize)
                      Res<(), AllocError> {
    Range(mark, o.vars.len).loop((h, i) {
        check_partial_move(c, o, i).try();
    });
    Ok(());
}

check_partial_move = (c :: Checker, o :: Own, i: usize)
                     Res<(), AllocError> {
    (has_dead_field(o, i) && (is_dead(o, i, "") == false)).match({
        false => Ok(()),
        true  => report_partial(c, o, i),
    })
}

report_partial = (c :: Checker, o :: Own, i: usize) Res<(), AllocError> {
    o.vars.get(i).match({
        None  => Ok(()),
        Ok(v) => c.report(v.span.file, v.span, SemaFault.PartiallyMoved(
                     NameFault(name: v.name))),
    })
}

has_dead_field = (o: Own, root: usize) bool {
    Range(0, o.dead.len).find((i) {
        o.dead.get(i).match({
            Ok(p) => (p.root == root) && (p.field.len > 0),
            None  => false,
        })
    }).match({ Ok(_) => true, None => false })
}

// ---------------------------------------------------------------------
// calls: the receiver rule, `@scope` as an argument, and closure bodies
// ---------------------------------------------------------------------

own_call = (c :: Checker, o :: Own, id: ExprId, k: Call, ctx: Ctx)
           Res<(), AllocError> {
    check_receiver(c, o, k, ctx).try();
    check_scope_stored(c, id, k).try();
    own_expr(c, o, k.callee, ctx).try();
    own_args(c, o, k, ctx).try();
    Ok(());
}

// A LAMBDA ARGUMENT IS A PATH, NOT AN OPAQUE VALUE. Its body may or may
// not run, so it joins like a match arm; and unless it is `.then` — the
// one closure form in the language that runs at most once — it may run
// AGAIN, so a move of anything declared outside it is a move the second
// iteration finds already made.
own_args = (c :: Checker, o :: Own, k: Call, ctx: Ctx)
           Res<(), AllocError> {
    repeats = repeating_body(c, k);
    k.args.loop((h, a) { own_arg(c, o, a, repeats, ctx).try() });
    Ok(());
}

own_arg = (c :: Checker, o :: Own, a: Arg, repeats: bool, ctx: Ctx)
          Res<(), AllocError> {
    node = c.tree.expr_at(a.value);
    node.kind.match({
        Lambda(l) => own_lambda(c, o, l, ctx, repeats),
        _         => own_expr(c, o, a.value, ctx),
    })
}

repeating_body = (c :: Checker, k: Call) bool {
    c.tree.expr_at(k.callee).kind.match({
        Access(a) => a.name.text.eq("then") == false,
        _         => true,
    })
}

// The body is walked once from the state at the call. What it moved is
// then either reported — a repeated body reaches its own back edge — or
// simply kept, which is the join: dead on some path is dead.
own_lambda = (c :: Checker, o :: Own, l: Lambda, ctx: Ctx, repeats: bool)
             Res<(), AllocError> {
    dmark = o.dead.len;
    vmark = o.vars.len;
    l.params.loop((h, p) { own_param(c, o, p).try() });
    own_block(c, o, l.body, ctx).try();
    own_release(o, vmark).try();
    repeats.then(() { report_back_edge(c, o, dmark).try() });
    Ok(());
}

// Everything moved inside the body that outlives it names a binding the
// body did not declare, because `own_release` has already dropped the
// ones it did.
report_back_edge = (c :: Checker, o :: Own, dmark: usize)
                   Res<(), AllocError> {
    Range(dmark, o.dead.len).loop((h, i) {
        report_moved_again(c, o, i).try();
    });
    Ok(());
}

report_moved_again = (c :: Checker, o :: Own, i: usize)
                     Res<(), AllocError> {
    o.dead.get(i).match({
        None  => Ok(()),
        Ok(p) => report_consumed(c, o, p.span, p.root, p.field),
    })
}

// ---------------------------------------------------------------------
// match: alternative paths, joined
// ---------------------------------------------------------------------

own_match = (c :: Checker, o :: Own, m: Match, ctx: Ctx)
            Res<(), AllocError> {
    own_expr(c, o, m.scrutinee, ctx).try();
    dmark = o.dead.len;
    joined ::= c.alloc.Vec<Place>();
    m.arms.loop((h, a) { own_arm(c, o, a, dmark, joined, ctx).try() });
    joined.loop((h, p) { o.dead.add(p).try() });
    Ok(());
}

// Each arm starts from the state before the match, which is what a
// sequential walk gets wrong: two arms that both consume one binding are
// one move on either path, not two on one.
own_arm = (c :: Checker, o :: Own, a: Arm, dmark: usize,
           joined :: Vec<Place>, ctx: Ctx) Res<(), AllocError> {
    own_expr(c, o, a.body, ctx).try();
    take_dead(o, dmark, joined).try();
    Ok(());
}

take_dead = (o :: Own, mark: usize, out :: Vec<Place>)
            Res<(), AllocError> {
    extra = o.dead.len - mark;
    Range(0, extra).loop((h, i) {
        o.dead.take(o.dead.len - 1).match({
            Ok(p) => out.add(p).try(),
            None  => (),
        });
    });
    Ok(());
}

// ---------------------------------------------------------------------
// the state, and the two ways a type reaches this file
// ---------------------------------------------------------------------

// The innermost binding of a name, by index, walking from the top so an
// inner scope shadows an outer one.
find_var* = (o: Own, text: str) Res<usize> {
    n = o.vars.len;
    Range(0, n).find((k) {
        o.vars.get(n - k - 1).match({
            Ok(v) => v.name.eq(text),
            None  => false,
        })
    }).match({
        None    => None,
        Ok(k)   => Ok(n - k - 1),
    })
}

// The binding a place path is rooted at, or nothing when the path is not
// one this frame names.
path_root* = (c :: Checker, o :: Own, id: ExprId) Res<usize> {
    node = c.tree.expr_at(id);
    node.kind.match({
        Name(n)   => find_var(o, n.text),
        Paren(p)  => path_root(c, o, p.inner),
        Access(a) => path_root(c, o, a.base),
        _         => None,
    })
}

// Whether a write through this name is permitted at all. It reads
// `Own.vars`, which is why it lives here and not beside the receiver
// rule that asks it: the state is this file's, and a field reached from
// another module is a field that had to be starred to be reached.
//
// A name this frame does not bind is a global or a constant, and the
// rule has no opinion about one — the fail-open direction.
var_mutable* = (o: Own, text: str) bool {
    find_var(o, text).match({
        None  => true,
        Ok(i) => o.vars.get(i).match({ Ok(v) => v.mutable, None => true }),
    })
}

owned_at = (o: Own, root: usize) bool {
    o.vars.get(root).match({ Ok(v) => v.owned, None => false })
}

is_dead = (o: Own, root: usize, field: str) bool {
    Range(0, o.dead.len).find((i) {
        o.dead.get(i).match({
            Ok(p) => (p.root == root) && p.field.eq(field),
            None  => false,
        })
    }).match({ Ok(_) => true, None => false })
}

kill = (o :: Own, root: usize, field: str, span: Span)
       Res<(), AllocError> {
    o.dead.add(Place(root: root, field: field, span: span))
}

// A write fills the hole. Implemented as a rebuild rather than a removal
// because `Vec` has no remove and order in this list means nothing.
revive = (o :: Own, root: usize, field: str) Res<(), AllocError> {
    kept ::= o.alloc.Vec<Place>();
    o.dead.loop((h, p) { keep_other(p, root, field, kept).try() });
    take_all(o).try();
    kept.loop((h, p) { o.dead.add(p).try() });
    Ok(());
}

keep_other = (p: Place, root: usize, field: str, kept :: Vec<Place>)
             Res<(), AllocError> {
    ((p.root == root) && p.field.eq(field)).match({
        true  => Ok(()),
        false => kept.add(p),
    })
}

take_all = (o :: Own) Res<(), AllocError> {
    n = o.dead.len;
    Range(0, n).loop((h, i) { o.dead.take(o.dead.len - 1); });
    Ok(());
}

// Leaving a scope drops its bindings AND everything said about them: a
// place whose root is gone is not a place any more, and leaving the row
// behind would let a later binding inherit its index and its death.
own_release = (o :: Own, mark: usize) Res<(), AllocError> {
    kept ::= o.alloc.Vec<Place>();
    o.dead.loop((h, p) { keep_below(p, mark, kept).try() });
    take_all(o).try();
    kept.loop((h, p) { o.dead.add(p).try() });
    extra = o.vars.len - mark;
    Range(0, extra).loop((h, i) { o.vars.take(o.vars.len - 1); });
    Ok(());
}

keep_below = (p: Place, mark: usize, kept :: Vec<Place>)
             Res<(), AllocError> {
    (p.root < mark).match({ false => Ok(()), true => kept.add(p) })
}

// `p.left`, joined, because that is the place the author wrote and the
// only spelling that tells them which half of `p` is gone.
place_name = (c :: Checker, o :: Own, root: usize, field: str)
             Res<str, AllocError> {
    base = o.vars.get(root).match({ Ok(v) => v.name, None => "" });
    (field.len == 0).match({
        true  => Ok(base),
        false => dotted_name(c, base, field),
    })
}

dotted_name = (c :: Checker, base: str, field: str) Res<str, AllocError> {
    out ::= c.alloc.String().try();
    out.add_bytes(base).try();
    out.add_bytes(".").try();
    out.add_bytes(field).try();
    Ok(out.view());
}

// WHAT TYPING ALREADY DECIDED, AND NOTHING MORE. A miss is not a reason
// to compute one: see the header — computing a type here resolves names
// against a scope this walk has already left.
memo_type = (c :: Checker, id: ExprId) TyId {
    c.expr_memo.get(id).match({ Ok(ty) => ty, None => UNTYPED })
}

// A place's type: recorded for a name, memoized for everything else.
place_type* = (c :: Checker, o :: Own, id: ExprId) TyId {
    node = c.tree.expr_at(id);
    node.kind.match({
        Name(n)  => var_type(o, n.text),
        Paren(p) => place_type(c, o, p.inner),
        _        => memo_type(c, id),
    })
}

var_type = (o: Own, text: str) TyId {
    find_var(o, text).match({
        None  => UNTYPED,
        Ok(i) => o.vars.get(i).match({ Ok(v) => v.ty, None => UNTYPED }),
    })
}

// The `TyId` that stands for "this file was never told". It is index 0,
// which the store's construction order makes the first type interned;
// nothing reads it as a type, only as the answer that turns every rule
// above off.
UNTYPED* : TyId = TyId(index: 0)

refuse* = (c :: Checker, span: Span, fault: SemaFault) Res<(), AllocError> {
    c.report(span.file, span, fault)
}
