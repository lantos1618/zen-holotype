// tests/must-fail/sema/comparison_operands_disagree.zen
// TWO SETTLED INTEGER TYPES MUST BE THE SAME ONE. `n < big` compiled,
// and the C conversion the backend reached for made the i16 -1 into a
// u64 no 3 could ever be below -- so `-1 < 3` answered false. A
// comparison binds nothing, which is why the binding's "expected u64,
// found i16" never stood in the way here.
//
// There is no cast keyword: the author widens by writing the
// conversion, `n.widen_i64() < big.to_i64()`.

main = (env: Env) Res<i32, AllocError> {
    n: i16   = -1;
    big: u64 = 3;
    println("{}", n < big);
    Ok(0);
}
