// std.io.stdin — line-oriented standard input, the missing half of a unix filter/REPL.
//
// Three surfaces, all allocator-explicit (no hidden heap):
//
//   { read_line, read_all, lines } = std.io.stdin
//   a.read_line()          // Result<Opt<str>, IoError> — Some(line) per line, None at EOF
//   a.read_all()           // Result<str, IoError>      — everything until EOF, one owned str
//   a.lines((line) { … })  // Result<i64, IoError>      — run a closure per line, count returned
//
// Lines are returned WITHOUT the trailing '\n'. A final unterminated line ("abc" then EOF)
// still comes back as Some("abc"); the next call reports None. Every returned str is an
// allocator-owned NUL-terminated buffer (same contract as std.io.file.contents_in), so a
// stdin byte stream containing NULs truncates at the first NUL — the str floor, not a bug.
{ read } = std.c.libc
{ Result, IoError, Opt, ok, err } = std.core.result
{ Allocator, try_acquire } = std.mem.alloc
{ String, init, push_in, finish_in, free_in } = std.text.string
{ view } = std.text.str
STDIN := 0
READ_CHUNK := 4096
// read(2) failed outright: no errno plumbing at this floor, so carry the -1 sentinel
// (exactly what std.io.file.read_file_open does for a bad lseek).
read_failed = () IoError { IoError.Errno(0 - 1) }
// Reads one line from stdin: Ok(.Some(line)) without the '\n', Ok(.None) at EOF,
// Err on read/allocation failure. The line is an allocator-owned str — release it
// via `a.release(line.view().ptr)` (or let an arena reclaim it) when done.
read_line*<A> = (a: MutPtr<A>) Result<Opt<str>, IoError> {
    a.init(64).match ({
        .Err(e) => err(e),
        .Ok(s0) => {
            s := s0
            cell: [u8] := [0]    // 1-byte read target on the stack
            consumed := 0    // bytes taken off the stream, INCLUDING a '\n'
            failed := false
            ev := IoError.Eof
            done := false
            @while (done == false) {
                r := STDIN.read(cell.ptr, 1)
                failed = r < 0
                ev = failed.match ({ true => read_failed(), false => ev })
                consumed = consumed + (r > 0).match ({ true => 1, false => 0 })
                done = r <= 0 || cell[0] == '\n'
                // builder-threaded push: every arm yields the String, so failure stays a value
                s = (r > 0 && cell[0] != '\n').match ({ true => a.push_in(s, cell[0]).match ({
                    .Ok(ns)  => ns,
                    .Err(pe) => {
                        failed = true
                        ev = pe
                        done = true
                        s
                    },
                }), false => s })
            }
            out: Result<Opt<str>, IoError> := failed.match ({ true => {
                s.free_in(a)
                err(ev)
            }, false => (consumed == 0).match ({ true => {
                s.free_in(a)
                none: Opt<str> := .None
                ok(none)
            }, false => s.finish_in(a).match ({
                .Ok(line) => {
                    some: Opt<str> := .Some(line)
                    ok(some)
                },
                .Err(fe)  => err(fe),
            }) }) })
            out
        },
    })
}
// Append `n` bytes of `chunk` onto `s`; Err carries the allocation failure.
append_chunk<A> = (a: MutPtr<A>, s: String, chunk: RawPtr<u8>, n: i64) Result<String, IoError> {
    cur := s
    failed := false
    ev := IoError.Eof
    bs: [u8] := chunk.slice(n)
    bs.loop((h, i, b) {
        cur = a.push_in(cur, b).match ({
            .Ok(ns)  => ns,
            .Err(pe) => {
                failed = true
                ev = pe
                cur
            },
        })
        failed.match ({ true => {
            h.break
        }, false => { } })
    })
    out: Result<String, IoError> := failed.match ({ true => err(ev), false => ok(cur) })
    out
}
// Reads stdin to EOF into one allocator-owned NUL-terminated str (the stdin twin of
// std.io.file.contents_in — `a.contents_in("/dev/stdin")` needs a seekable fd; this doesn't).
read_all*<A> = (a: MutPtr<A>) Result<str, IoError> {
    a.try_acquire(READ_CHUNK).match ({
        .Err(e)    => err(e),
        .Ok(chunk) => a.init(READ_CHUNK).match ({
            .Err(e) => {
                a.release(chunk)
                err(e)
            },
            .Ok(s0) => {
                s := s0
                failed := false
                ev := IoError.Eof
                done := false
                @while (done == false) {
                    r := STDIN.read(chunk, READ_CHUNK)
                    failed = r < 0
                    ev = failed.match ({ true => read_failed(), false => ev })
                    done = r <= 0
                    s = (r > 0).match ({ true => a.append_chunk(s, chunk, r).match ({
                        .Ok(ns)  => ns,
                        .Err(ae) => {
                            failed = true
                            ev = ae
                            done = true
                            s
                        },
                    }), false => s })
                }
                a.release(chunk)
                out: Result<str, IoError> := failed.match ({ true => {
                    s.free_in(a)
                    err(ev)
                }, false => s.finish_in(a) })
                out
            },
        }),
    })
}
// Runs `on_line` once per stdin line (line passed WITHOUT its '\n') until EOF; returns how
// many lines were seen. Each line's buffer is RELEASED after `on_line` returns — copy what
// must outlive the call. `on_line` is a first-class closure arg, same shape as
// std.collections.iter's helpers, so an inline lambda splices straight in:
// `a.lines((line) { out(line) })`.
lines*<A> = (a: MutPtr<A>, on_line: (str) void) Result<i64, IoError> {
    n: i64 := 0
    failed := false
    ev := IoError.Eof
    done := false
    @while (done == false) {
        // uniform i32 arms: side effects thread through the outer locals, the match stays a value
        step := a.read_line().match ({
            .Err(e) => {
                failed = true
                ev = e
                done = true
                0
            },
            .Ok(o)  => o.match ({
                .None       => {
                    done = true
                    0
                },
                .Some(line) => {
                    on_line(line)
                    n = n + 1
                    a.release(line.view().ptr)
                    0
                },
            }),
        })
    }
    out: Result<i64, IoError> := failed.match ({ true => err(ev), false => ok(n) })
    out
}
