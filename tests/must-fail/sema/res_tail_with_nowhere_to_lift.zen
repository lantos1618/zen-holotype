// A `Res` RETURN IS THE ONE TYPED POSITION THAT ACCEPTED ANYTHING.
// `sema_hoist.hoist_into_res` answers three questions about a bare tail
// — is it ambiguous, is it the failure, does it lift — and its fourth
// answer, "none of those", was SILENCE. That silence is correct where a
// constructor field asks it, because `check_ctor_shape` reports the
// mismatch there; at a function's tail nobody did, so `cc` was the type
// checker (#764).
//
// The C this used to emit was `return 3;` from a function returning a
// struct — a hard `cc` error in this spelling, and a `-Wreturn-type`
// warning that nothing greps for in the `.try()` spelling the issue
// found. Both mean the same thing: the frontend accepted a program with
// no meaning.
//
// position: the tail expression, which is the value that does not fit —
// not the signature that says what would.

AllocError = std.mem

hand = () Res<(), AllocError> { 3 }

main = (env: Env) Res<i32, AllocError> {
    hand().match({
        Ok(_)  => println("ok"),
        Err(_) => println("err"),
    });
    Ok(0);
}
