// compiler.generics — leaf helpers shared by the two generic-instance collectors.
//
// Monomorphization (compiler.mono, collect_*/add_inst) and recursive-generic-function
// analysis (compiler.passes.refcount, rc_col_*/rc_add) each independently walk the AST,
// dedup GenericData instances by mangled name, and bound type-arg NESTING depth. These
// three leaves were byte-identical across the two families (modulo local names), so they
// live here once to kill the drift hazard. The walkers themselves stay in each file — the
// rc_* ones thread an Env for type inference; mono's don't — and are NOT merged.
//
// Leaf module: imports ONLY the AST types (compiler.ast.ast_types) + std. It must NEVER import
// compiler.mono or compiler.check, so it stays under the dependency floor (no cycle).
{ Ty, GenericData } = compiler.ast.ast_types
// dedup: is an instance whose mangled name is `m` already recorded in buf[0..cnt)?
gd_has_mangled* = (buf: [GenericData], cnt: i32, m: StringView) bool {
    found ::= false
    buf.loop((h, i, e) {
        found = (i < cnt).match ({
            true  => (e.mangled == m).then({ true }, { found }),
            false => found,
        })
    })
    found
}
// type-arg NESTING depth of a Ty: `Box<Vec<i32>>` is 2, `i32`/`Box` (no args) is ≤1. A
// well-formed instance is shallow; a polymorphic-recursive one grows this by 1 each step,
// which the two add-inst helpers use (against a fixed bound) to drop the runaway instance.
gd_ty_depth = (t: Ty) i32 {
    t.match ({
        .Generic(g) => 1 + g.args.gd_tys_max_depth(),
        .Ptr(pd)    => load(pd.pointee).gd_ty_depth(),
        .Slice(e)   => load(e.pointee).gd_ty_depth(),
        _           => 0,
    })
}
gd_tys_max_depth* = (ts: [Ty]) i32 {
    d ::= 0
    ts.loop((h, i, t) {
        nd = t.gd_ty_depth()
        d = (nd > d).then({ nd }, { d })
    })
    d
}
