// usize division traps on a zero divisor. usize is the pointer-width
// type: a lowering that emits its trap check as `int` (or reuses the
// i32 check because "it's all the same machine divide") never sees a
// zero stored in 8 bytes, and the process dies with a raw SIGFPE
// instead of Zen's trap line. num.zen forbids printing a usize
// extreme in corpus tests, so the pinned values stay small -- what is
// under test is the WIDTH of the zero-test, not magnitude.
//
// the divisor comes from the environment, so no constant folder can
// turn this into the compile-time error a visible zero would be
// (DESIGN.md: a provable trap is a compile error, not a runtime one).

Error = Overflow | DivideByZero | OutOfBounds

main = (env: Env) Res<i32, Error> {
    a: usize = 1234567891011;
    println("{} {}", a / 1000, a % 1000);

    // a zero the compiler cannot see: it comes from the environment
    zero: usize = env.var("ZEN_TRAP_NEVER_SET").match({
        Ok(_) => 1,
        None  => 0,
    });
    q           = a / zero;
    println("{}", q);
    Ok(0);
}
