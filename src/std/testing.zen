// Assertions return values because Zen panics cannot be caught by user code.
{ formatln, arg_str, arg_int } = std.io.print
strm = std.text.str    // qualified so the str byte-eq below never shadows our own `eq` trait method
TestResult*: Pass | Fail(StringView)
Eq*: {
    eq: (left: Self, right: Self) bool,
}
i64.impl(Eq, {
    eq = (a: i64, b: i64) bool { a == b }
})
i32.impl(Eq, {
    eq = (a: i32, b: i32) bool { a == b }
})
u8.impl(Eq, {
    eq = (a: u8, b: u8) bool { a == b }
})
bool.impl(Eq, {
    eq = (a: bool, b: bool) bool {
        a.match ({
            true  => b,
            false => b.then({ false }, { true }),
        })
    }
})
// StringView `==` compares pointers; assertions compare bytes.
StringView.impl(Eq, {
    eq = (a: StringView, b: StringView) bool { strm.eq(a, b) }
})
assert = (cond: bool, msg: StringView) TestResult { cond.then({ .Pass }, { .Fail(msg) }) }
assert_true* = (cond: bool, msg: StringView) TestResult { assert(cond, msg) }
assert_false = (cond: bool, msg: StringView) TestResult {
    assert(cond.then({ false }, { true }), msg)
}
assert_eq*<T: Eq> = (got: T, want: T, msg: StringView) TestResult { assert(got.eq(want), msg) }
Suite*: {
    passed: i64,
    failed: i64,
    run = (s: Suite, name: StringView, r: TestResult) Suite {
        r.match ({
            .Pass      => {
                formatln("PASS {}", [arg_str(name)])
                Suite(
                    passed: s.passed + 1,
                    failed: s.failed,
                )
            },
            .Fail(msg) => {
                formatln("FAIL {}: {}", [arg_str(name), arg_str(msg)])
                Suite(
                    passed: s.passed,
                    failed: s.failed + 1,
                )
            },
        })
    }
    done = (s: Suite) i64 {
        formatln("ok: {} passed, {} failed", [arg_int(s.passed), arg_int(s.failed)])
    }
    exit_code = (s: Suite) i32 { to_i32(s.failed) }
}
suite* = () Suite {
    Suite(
        passed: 0,
        failed: 0,
    )
}
