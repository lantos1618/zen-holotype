// A struct body declares members, and a member writes the type it holds.
// `x* = 7` writes a value with no type, which is the grammar for a
// module-level constant and not for a field, so the layout it asks for
// has no seat: the construction compiled, and only cc found that the
// emitted struct had no such member. Refused here instead, at the
// spelling, where the two forms it could have meant can still be named.
// position: the member with no type.

D = { x* = 7 }

main = (env: Env) Res<i32, AllocError> {
    d ::= D();
    e: i32 = d.x;
    println("{}", e);
    Ok(0);
}
