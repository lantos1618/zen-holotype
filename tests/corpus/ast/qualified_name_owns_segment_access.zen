// QualifiedName's stored segments are the authority for structured names.
// The first and last answers below are deliberately different: selecting
// after the first dot would produce `middle.leaf`, while the structured leaf
// is exactly `leaf`. Missing and empty names are recovery shapes, not traps.

Ident, Pos, QualifiedName, Span = std.ast.ast_span
Alloc, AllocError = std.mem

at = () Span {
    Span(
        file: "qualified.zen",
        start: Pos(line: 1, col: 1),
        end: Pos(line: 1, col: 2)
    )
}

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    parts ::= alloc.Vec<Ident>();
    parts.add(Ident(text: "top", span: at())).try();
    parts.add(Ident(text: "middle", span: at())).try();
    parts.add(Ident(text: "leaf", span: at())).try();

    name = QualifiedName(segments: parts, span: at());
    println(
        "segments: {} {} {} {}",
        name.segment_at(0),
        name.segment_at(1),
        name.last_segment(),
        name.segment_at(8).len
    );

    empty = QualifiedName(segments: alloc.Vec<Ident>(), span: at());
    println("empty leaf: {}", empty.last_segment().len);
    Ok(0);
}
