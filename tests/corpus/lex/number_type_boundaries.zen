// the largest literal of each unsigned type, written exactly at the
// boundary. u64.MAX does not fit a C long, which is a codegen trap.
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    a: u8 = 255;
    b: u16 = 65535;
    c: u32 = 4294967295;
    d: u64 = 18446744073709551615;
    println("{}", a);
    println("{}", b);
    println("{}", c);
    println("{}", d);
    e: i64 = -9223372036854775808;
    println("{}", e);
    Ok(0);
}
