// .or_return() as a CALL ARGUMENT: `add1(g(ok).or_return())` propagates before the outer call.
// Exit 61 = f(1) yields Ok(6); f(0) early-returns Err before add1 ever runs.
{ Result, IoError } = std.core.result
g = (ok: i32) Result<i32, IoError> { (ok == 1).match ({ true => .Ok(5), false => .Err(.NotFound) }) }
add1 = (n: i32) i32 { n + 1 }
f = (ok: i32) Result<i32, IoError> {
    x := add1(g(ok).or_return())
    .Ok(x)
}
main = () i32 {
    a := f(1).match ({
        .Ok(v)  => v,
        .Err(e) => 0,
    })    // 6
    b := f(0).match ({
        .Ok(v)  => 0,
        .Err(e) => 1,
    })    // 1
    a * 10 + b
}
