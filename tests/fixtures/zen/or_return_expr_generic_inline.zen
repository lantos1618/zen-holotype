// .or_return() in EXPRESSION position inside a GENERIC fn that gets INLINED. The hoisted Err-guard
// stays a real statement, so the inliner's early-return lift turns it into the inlined call's VALUE
// — the caller can still RECOVER from the callee's Err (the early return must NOT escape into the
// caller). Exit 89 = caller(1)=(5+1)*2=12; caller(0) recovers the Err to 77.
{ Result, IoError } = std.core.result
g = (ok: i32) Result<i32, IoError> { (ok == 1).match ({ true => .Ok(5), false => .Err(.NotFound) }) }
add = (n: i32) i32 { n + 1 }
gen_step<T> = (ok: i32, extra: T) Result<i32, IoError> {
    x := add(g(ok).or_return())
    .Ok(x + 0)
}
caller = (ok: i32) Result<i32, IoError> {
    r := gen_step(ok, 9)
    r.match ({
        .Ok(v)  => .Ok(v * 2),
        .Err(e) => .Ok(77),
    })
}    // recovery proves the callee's early return did not escape into caller
main = () i32 {
    a := caller(1).match ({
        .Ok(v)  => v,
        .Err(e) => 0,
    })    // 12
    b := caller(0).match ({
        .Ok(v)  => v,
        .Err(e) => 1,
    })    // 77
    a + b
}
