Box = { value :: str }
word = (env: Env, letters: str) Res<str, AllocError> {
    alloc ::= env.mem.alloc();
    buf   ::= alloc.String().try();
    buf.add(letters).try();
    output ::= Box(value: "safe");
    output.value = buf.view();
    output.value = "safe";
    Ok(output.value)
}
main = (env: Env) Res<i32, AllocError> {
    text = word(env, "ab").try();
    println("{}", text);
    Ok(0)
}
