// Compile-time enum variant-name reflection. A successful call is recorded for
// lowering; no runtime method or standard-library declaration is involved.

Enum, Expr, ExprId, Call, Access = std.ast
AllocError = std.mem
TyId = sema.sema_ty
decl_at = sema.sema_def
Checker = sema.sema_check
Base = sema.sema_member
SemaFault, NameFault = sema.sema_diag

VariantNameCall* = { ty*: TyId }

VariantNameAnswer* = VariantNameAnswered(TyId) | NotVariantName

EnumValue* = {
    ty*: TyId,
    value*: Enum,
}

// The nominal enum behind a settled value type. Generic arguments remain on
// `ty`; names come from the shared declaration because variants do not depend
// on those arguments.
enum_value* = (c: Checker, ty: TyId) Res<EnumValue> {
    c.types.at(ty).match({
        Named(n) => decl_at(c.tree, n.decl).match({
            None    => None,
            Ok(row) => row.kind.match({
                Enum(e) => Ok(EnumValue(ty: ty, value: e)),
                _       => None,
            }),
        }),
        _        => None,
    })
}

variant_name_member_call* = (
    c    :: Checker,
    id   : ExprId,
    node : Expr,
    call : Call,
    ac   : Access,
    base : Base
) Res<VariantNameAnswer, AllocError> {
    ac.name.text.eq("variant_name").match({
        false => Ok(VariantNameAnswer.NotVariantName),
        true  => c.enum_value(base.ty).match({
            None    => Ok(VariantNameAnswer.NotVariantName),
            Ok(row) => (!base.is_type && call.args.len == 0).match({
                true  => {
                    c.mark_variant_name_call(
                        id,
                        VariantNameCall(ty: row.ty)
                    ).try();
                    Ok(VariantNameAnswer.VariantNameAnswered(
                        c.types.str_ty().try()
                    ))
                },
                false => c.invalid_variant_name_call(node),
            }),
        }),
    })
}

invalid_variant_name_call = (c :: Checker, node: Expr)
                            Res<VariantNameAnswer, AllocError> {
    c.report(
        node.span.file,
        node.span,
        SemaFault.NoOverload(NameFault(name: "variant_name"))
    ).try();
    Ok(VariantNameAnswer.VariantNameAnswered(c.types.unknown().try()))
}
