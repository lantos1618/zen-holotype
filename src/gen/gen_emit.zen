// Output buffering and stable ordering for backends. `Emit` owns its
// `String`: read it through `view`, or take it with `into_string`.

Alloc, AllocError = std.mem
str, String = std.text
Vec = std.collections
Range = std.core

INDENT: str = "    "

Emit* = {
    text :: String,
    depth :: usize,

    // The last byte written was `\n`: the next non-empty write indents
    // first, and a blank line gets no indent.
    fresh :: bool,

    // writing

    // Every `\n` in `s` ends a line, so a multi-line run indents each line.
    bytes* = (self :: @Self, s: str) Res<(), AllocError> {
        lines ::= s.split('\n');
        self.run(lines.next().value_or("")).try();
        loop((h) {
            lines.next().match({
                None     => h.break(),
                Ok(rest) => { self.line().try(); self.run(rest).try(); },
            });
        });
        Ok(())
    }

    // `s` holds no `\n`. Empty writes nothing, so a blank line stays blank.
    run = (self :: @Self, s: str) Res<(), AllocError> {
        (!s.is_empty()).then(() {
            self.open_line().try();
            self.text.add(s).try();
        });
        Ok(())
    }

    byte* = (self :: @Self, b: u8) Res<(), AllocError> {
        (b == '\n').match({
            true  => self.line(),
            false => {
                self.open_line().try();
                self.text.add(b)
            },
        })
    }

    number* = (self :: @Self, v: usize) Res<(), AllocError> {
        self.open_line().try();
        self.text.write_usize(v)
    }

    // End the line. A blank line is `line` twice and gets no indent.
    line* = (self :: @Self) Res<(), AllocError> {
        self.text.add('\n').try();
        self.fresh = true;
        Ok(());
    }

    say* = (self :: @Self, s: str) Res<(), AllocError> {
        self.bytes(s).try();
        self.line()
    }

    open_line = (self :: @Self) Res<(), AllocError> {
        self.fresh.then(() {
            Range(0, self.depth).loop((h, i) {
                self.text.add(INDENT).try();
            });
            self.fresh = false;
        });
        Ok(());
    }

    // depth

    indent* = (self :: @Self) () { self.depth = self.depth + 1; }

    // Saturates at zero: an unbalanced backend gets misindented C, not an
    // aborted compilation.
    dedent* = (self :: @Self) () {
        (self.depth > 0).then(() { self.depth = self.depth - 1; });
    }

    // reading back

    view* = (self: @Self) str { self.text.view() }

    len* = (self: @Self) usize { self.text.len() }

    // Takes the buffer; the Emit is not written again after this.
    into_string* = (self: @Self) String { self.text }
}

Emit* = (a: Alloc) Res<Emit, AllocError> {
    Ok(Emit(text: a.String().try(), depth: 0, fresh: true));
}

// Stable lexicographic permutation: values stay in their original vectors.
order* = (a: Alloc, keys: Vec<String>) Res<Vec<usize>, AllocError> {
    sorting ::= KeyOrder(keys: keys, out: a.Vec<usize>(), tmp: a.Vec<usize>());
    sorting.sorted()
}

KeyOrder = {
    keys: Vec<String>,
    out :: Vec<usize>,
    tmp :: Vec<usize>,

    sorted = (self :: @Self) Res<Vec<usize>, AllocError> {
        Range(0, self.keys.len).loop((h, i) { self.out.add(i).try() });
        width: usize ::= 1;
        from_out     ::= true;
        loop(() { width < self.keys.len }, (h) {
            from_out.match({
                true  => self.merge_into(self.out, self.tmp, width),
                false => self.merge_into(self.tmp, self.out, width),
            }).try();
            from_out = !from_out;
            width    = width * 2;
        });
        Ok(from_out.match({ true => self.out, false => self.tmp }))
    }

    // Merge adjacent width-long runs. Strict comparison preserves equal keys.
    merge_into = (self: @Self, src: Vec<usize>, dst :: Vec<usize>, width: usize)
                 Res<(), AllocError> {
        dst.clear();
        start: usize ::= 0;
        loop(() { start < src.len }, (h) {
            mid = smaller(start + width, src.len);
            end = smaller(mid + width, src.len);
            left  ::= start;
            right ::= mid;
            Range(start, end).loop((h, i) {
                from_right = (left == mid) || ((right < end)
                    && self.key(src, right).before(self.key(src, left)));
                from       = from_right.match({ true => right, false => left });
                dst.add(src.get(from).value_or(0)).try();
                from_right.match({
                    true  => { right = right + 1; },
                    false => { left = left + 1; },
                });
            });
            start = end;
        });
        Ok(())
    }

    key = (self: @Self, src: Vec<usize>, i: usize) str {
        self.keys.get(src.get(i).value_or(0)).match({
            Ok(s) => s.view(),
            None  => "",
        })
    }
}

smaller = (a: usize, b: usize) usize {
    (a < b).match({ true => a, false => b })
}
