// Writes flat document symbols from declarations in the open buffer.

str, String = std.text
Vec = std.collections
Alloc, AllocError = std.mem
Decl, Span, Ident = std.ast
WireRange, wire_range = lsp.lsp_pos
parse_standalone = lsp.lsp_query
written, arr, Nest, to_json = std.json

Sym* = {
    name*: str,
    kind*: usize,
    span*: Span,
    name_span*: Span,

    write = (self: @Self, a: Alloc, uri: str, text: str, list :: Nest,
             out :: String) Res<(), AllocError> {
        list.next(out).try();
        encoded ::= SymbolInformation(name: self.name, kind: self.kind, location: SymbolLocation(uri: uri, range: wire_range(text, self.span)), selectionRange: wire_range(text, self.name_span)).to_json(a).try();
        out.add(encoded.view())
    }
}

SymbolLocation = {
    uri: str,
    range: WireRange,
}

SymbolInformation = {
    name: str,
    kind: usize,
    location: SymbolLocation,
    selectionRange: WireRange,
}

CLASS: usize = 5        // LSP has no type-alias symbol kind.
ENUM: usize = 10
FUNCTION: usize = 12
CONSTANT: usize = 14
STRUCT: usize = 23

symbols_at* = (a: Alloc, text: str, out :: Vec<Sym>) Res<(), AllocError> {
    p ::= parse_standalone(a, "doc", text).try();
    m = p.module("doc").try();
    m.decls.loop((h, d) { d.sym_into(out).try(); });
    Ok(());
}

sym_into = (d: Decl, out :: Vec<Sym>) Res<(), AllocError> {
    d.kind.match({
        Function(f) => out.add_sym(f.name, FUNCTION, d.span),
        Struct(s)   => out.add_sym(s.name, STRUCT, d.span),
        Enum(e)     => out.add_sym(e.name, ENUM, d.span),
        Alias(x)    => out.add_sym(x.name, CLASS, d.span),
        Const(k)    => out.add_sym(k.name, CONSTANT, d.span),
        _           => written(),
    })
}

// A declaration whose name the parser has not settled yet has no symbol.
add_sym = (out :: Vec<Sym>, id: Ident, kind: usize, span: Span)
        Res<(), AllocError> {
    (id.text.len > 0).then(() {
        out.add(Sym(
            name: id.text,
            kind: kind,
            span: span,
            name_span: id.span
        )).try();
    });
    Ok(())
}

write_symbols* = (a: Alloc, uri: str, text: str, syms: Vec<Sym>, out :: String)
                 Res<(), AllocError> {
    list ::= arr(out).try();
    syms.loop((h, s) { s.write(a, uri, text, list, out).try(); });
    list.close(out)
}
