// tests/corpus/parse/parser_ambiguities.zen
// The three readings a token sequence has, and which one wins.
//
// TESTING.md names all three, and DESIGN.md resolves all three. This
// asserts the resolution rather than restating it:
//
//   `Alias = Shape` VERSUS A ONE-VARIANT ENUM. The leading bar
//   decides, and it is why the parser needs no lookahead: without it
//   `AllocError = OutOfMemory` and `Alias = Shape` are the same three
//   tokens. `Alias` arrives as an Alias, `| Circle` as an Enum whose
//   `leading_bar` is present, and `Circle | Square` as an Enum whose
//   `leading_bar` is not.
//
//   `A.impl(B, {..})` IN STATEMENT POSITION. A call-shaped thing that
//   declares. It is `DeclKind.Impl` and never a `Call`.
//
//   `[i32, 4](2, 3, 5, 7)` AS A TYPE APPLIED TO ARGUMENTS. Two items
//   in the brackets and a `(` behind them; `[0, 1, 2]` has three items
//   and is an ordinary literal.
//
// And two more the same fork produces: a function with a body against
// a signature without one (DESIGN.md's `= sig` / `= sig {..}` table),
// and a dotted path, which is an import rather than a member access.
//
// The source these tokens stand for:
//
//   Shape = Circle | Square
//   Alias = Shape
//   Only = | Circle
//   Circle.impl(Rect, { width: 2.0 })
//   primes = [i32, 4](2, 3, 5, 7)
//   small = [0, 1, 2]
//   add = (a: i32, b: i32) i32 { a }
//   sig = (a: i32) i32
//   Res, Ok = std.core.result
//   json = pkg.json

Token, TokenKind = parse.parse_token
Parser = parse.parser
module = parse.parse_decl
Ast = ast.ast_arena
Span, Pos = ast.ast_span
Decl, Form = ast.ast_node
ExprId = ast.ast_id

tk = (k: TokenKind, t: str) Token {
    Token(
        kind: k,
        text: t,
        span: Span(file: "t.zen", start: Pos(line: 1, col: 1), end: Pos(line: 1, col: 2)),
    )
}

push = (ts :: Vec<Token>, k: TokenKind, t: str) Res<(), AllocError> {
    ts.add(tk(k, t))
}

form_name = (f: Form) str {
    f.match({
        Required => "required",
        Sealed   => "sealed",
        Default  => "default",
        Hook     => "hook",
    });
}

value_kind = (env: Env, tree: Ast, id: ExprId) str {
    tree.expr_at(id).kind.match({
        FixedArray(_) => "fixed-array",
        Array(_)      => "array-literal",
        Call(_)       => "call",
        Literal(_)    => "literal",
        Name(_)       => "name",
        Access(_)     => "access",
        _             => "other",
    });
}

show = (env: Env, tree: Ast, d: Decl) () {
    d.kind.match({
        Alias(a)    => println("alias {}", a.name.text),
        Enum(e)     => e.leading_bar.match({
            Ok(_) => println("enum {} bar variants {}", e.name.text, e.variants.len),
            None  => println("enum {} nobar variants {}", e.name.text, e.variants.len),
        }),
        Struct(s)   => println("struct {}", s.name.text),
        Impl(i)     => println("impl {} members {}", i.target.text, i.members.len),
        Function(f) => println("function {} {}", f.name.text, form_name(f.form)),
        Import(i)   => println("import names {} segments {}", i.names.len, i.module.segments.len),
        Const(c)    => println("const {} = {}", c.name.text, value_kind(env, tree, c.value)),
    });
}

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    ts ::= alloc.Vec<Token>();

    // Shape = Circle | Square
    ts.push(TokenKind.Ident, "Shape").try();
    ts.push(TokenKind.Eq, "=").try();
    ts.push(TokenKind.Ident, "Circle").try();
    ts.push(TokenKind.Bar, "|").try();
    ts.push(TokenKind.Ident, "Square").try();

    // Alias = Shape
    ts.push(TokenKind.Ident, "Alias").try();
    ts.push(TokenKind.Eq, "=").try();
    ts.push(TokenKind.Ident, "Shape").try();

    // Only = | Circle
    ts.push(TokenKind.Ident, "Only").try();
    ts.push(TokenKind.Eq, "=").try();
    ts.push(TokenKind.Bar, "|").try();
    ts.push(TokenKind.Ident, "Circle").try();

    // Circle.impl(Rect, { width: 2.0 })
    ts.push(TokenKind.Ident, "Circle").try();
    ts.push(TokenKind.Dot, ".").try();
    ts.push(TokenKind.Ident, "impl").try();
    ts.push(TokenKind.LParen, "(").try();
    ts.push(TokenKind.Ident, "Rect").try();
    ts.push(TokenKind.Comma, ",").try();
    ts.push(TokenKind.LBrace, "{").try();
    ts.push(TokenKind.Ident, "width").try();
    ts.push(TokenKind.Colon, ":").try();
    ts.push(TokenKind.Float, "2.0").try();
    ts.push(TokenKind.RBrace, "}").try();
    ts.push(TokenKind.RParen, ")").try();

    // primes = [i32, 4](2, 3, 5, 7)
    ts.push(TokenKind.Ident, "primes").try();
    ts.push(TokenKind.Eq, "=").try();
    ts.push(TokenKind.LBracket, "[").try();
    ts.push(TokenKind.Ident, "i32").try();
    ts.push(TokenKind.Comma, ",").try();
    ts.push(TokenKind.Int, "4").try();
    ts.push(TokenKind.RBracket, "]").try();
    ts.push(TokenKind.LParen, "(").try();
    ts.push(TokenKind.Int, "2").try();
    ts.push(TokenKind.Comma, ",").try();
    ts.push(TokenKind.Int, "3").try();
    ts.push(TokenKind.Comma, ",").try();
    ts.push(TokenKind.Int, "5").try();
    ts.push(TokenKind.Comma, ",").try();
    ts.push(TokenKind.Int, "7").try();
    ts.push(TokenKind.RParen, ")").try();

    // small = [0, 1, 2]
    ts.push(TokenKind.Ident, "small").try();
    ts.push(TokenKind.Eq, "=").try();
    ts.push(TokenKind.LBracket, "[").try();
    ts.push(TokenKind.Int, "0").try();
    ts.push(TokenKind.Comma, ",").try();
    ts.push(TokenKind.Int, "1").try();
    ts.push(TokenKind.Comma, ",").try();
    ts.push(TokenKind.Int, "2").try();
    ts.push(TokenKind.RBracket, "]").try();

    // add = (a: i32, b: i32) i32 { a }
    ts.push(TokenKind.Ident, "add").try();
    ts.push(TokenKind.Eq, "=").try();
    ts.push(TokenKind.LParen, "(").try();
    ts.push(TokenKind.Ident, "a").try();
    ts.push(TokenKind.Colon, ":").try();
    ts.push(TokenKind.Ident, "i32").try();
    ts.push(TokenKind.Comma, ",").try();
    ts.push(TokenKind.Ident, "b").try();
    ts.push(TokenKind.Colon, ":").try();
    ts.push(TokenKind.Ident, "i32").try();
    ts.push(TokenKind.RParen, ")").try();
    ts.push(TokenKind.Ident, "i32").try();
    ts.push(TokenKind.LBrace, "{").try();
    ts.push(TokenKind.Ident, "a").try();
    ts.push(TokenKind.RBrace, "}").try();

    // sig = (a: i32) i32
    ts.push(TokenKind.Ident, "sig").try();
    ts.push(TokenKind.Eq, "=").try();
    ts.push(TokenKind.LParen, "(").try();
    ts.push(TokenKind.Ident, "a").try();
    ts.push(TokenKind.Colon, ":").try();
    ts.push(TokenKind.Ident, "i32").try();
    ts.push(TokenKind.RParen, ")").try();
    ts.push(TokenKind.Ident, "i32").try();

    // Res, Ok = std.core.result
    ts.push(TokenKind.Ident, "Res").try();
    ts.push(TokenKind.Comma, ",").try();
    ts.push(TokenKind.Ident, "Ok").try();
    ts.push(TokenKind.Eq, "=").try();
    ts.push(TokenKind.Ident, "std").try();
    ts.push(TokenKind.Dot, ".").try();
    ts.push(TokenKind.Ident, "core").try();
    ts.push(TokenKind.Dot, ".").try();
    ts.push(TokenKind.Ident, "result").try();

    // json = pkg.json
    ts.push(TokenKind.Ident, "json").try();
    ts.push(TokenKind.Eq, "=").try();
    ts.push(TokenKind.Ident, "pkg").try();
    ts.push(TokenKind.Dot, ".").try();
    ts.push(TokenKind.Ident, "json").try();

    ts.push(TokenKind.Eof, "").try();

    p ::= alloc.Parser(ts, "t.zen");
    m = p.module("t").try();
    println("diags {}", p.diags.len);
    println("decls {}", m.decls.len);
    m.decls.loop((h, d) { show(env, p.tree, d) });
    Ok(0);
}
