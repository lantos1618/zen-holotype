// Module path and name rules shared by build and editor drivers.
//
// A module may live at `<name>.zen` or `<name>/<name>.zen`; its qualified name
// is the root-relative path without the extension and with dot separators.
//
// Paths stored in source spans are relative to the compilation root so builds
// remain independent of the checkout location.

Alloc, AllocError = std.mem
str, String = std.text
Range, Path = std.core
join_path = std.core.path

QualifiedName = std.ast.ast_span
ZEN_STD_ENV = std.build

// Derive a module's canonical dotted name from its root-relative path.
module_name* = (a: Alloc, root: str, path: str) Res<str, AllocError> {
    inner = path.slice(root.len + 1, path.len - EXT_BYTES);
    out ::= a.String().try();
    Range(0, inner.len).loop((h, i) {
        out.add(dot_for(inner.index(i))).try();
    });
    Ok(out.view());
}

// Resolve the standard-library root for an embedded driver. `ZEN_STD` wins;
// otherwise an absolute program path may locate a sibling `src/std` tree.
std_root_for* = (env: Env, a: Alloc) str {
    env.var(ZEN_STD_ENV).match({
        Ok(path) => path.is_empty().match({
            true  => std_root_beside_program(env, a),
            false => path,
        }),
        None     => std_root_beside_program(env, a),
    })
}

std_root_beside_program = (env: Env, a: Alloc) str {
    found: Res<str> = loop<str>((h) {
        program = env.argv.get(0).match({
            None     => { h.break(""); "" },
            Ok(path) => path,
        });
        dir     = Path(program).parent().value_or(Path("")).text;
        dir.is_empty().then(() { h.break(""); });

        root   = join_path(a, dir, "src").match({
            Err(_)    => { h.break(""); "" },
            Ok(value) => value.view(),
        });
        marker = join_path(a, root, "std/std.zen").match({
            Err(_)    => { h.break(""); "" },
            Ok(value) => value.view(),
        });
        (!env.fs.exists(marker)).then(() { h.break(""); });
        h.break(root);
    });
    found.match({ Ok(root) => root, None => "" })
}

// Infer an editor compilation root without climbing above `floor`. Folder
// modules (`<name>/<name>.zen`) are climbed through. A project `build.zen`
// selects its `src` child when the open file is beneath that child.
root_for* = (env: Env, a: Alloc, floor: str, path: str) str {
    dir ::= Path(path).parent().value_or(Path("")).text;
    loop(() { dir.len > floor.len && holds_its_own_name(env, a, dir) }, (h) {
        dir = Path(dir).parent().value_or(Path("")).text;
    });
    settled = dir;
    marked ::= dir;
    loop(
        () { marked.len > floor.len && !holds_build_zen(env, a, marked) },
        (h) {
            marked = Path(marked).parent().value_or(Path("")).text;
        }
    );
    (marked.len >= floor.len && !marked.is_empty()
     && holds_build_zen(env, a, marked)).match({
        true  => source_root(a, marked, path),
        false => settled,
    });
}

// A project marker does not necessarily mark the module namespace root.
source_root = (a: Alloc, project: str, path: str) str {
    join_path(a, project, "src").match({
        Err(_)  => project,
        Ok(src) => under(src.view(), path).match({
            true  => src.view(),
            false => project,
        }),
    })
}

// Test the `<dir>/<basename>.zen` folder-module convention. Allocation
// failure stops the climb.
holds_its_own_name = (env: Env, a: Alloc, dir: str) bool {
    a.String("{}/{}.zen", dir, Path(dir).name()).match({
        Err(_) => false,
        Ok(f)  => env.fs.exists(f.view()),
    })
}

// Test for a project marker. Allocation failure stops the climb.
holds_build_zen = (env: Env, a: Alloc, dir: str) bool {
    join_path(a, dir, "build.zen").match({
        Err(_) => false,
        Ok(f)  => env.fs.exists(f.view()),
    })
}

// Return a root-relative path, or the original path when it is outside root.
relative_to* = (root: str, path: str) str {
    under(root, path).match({
        true  => path.slice(root.len + 1, path.len),
        false => path,
    });
}

under = (root: str, path: str) bool {
    path.len > root.len + 1
        && path.slice(0, root.len).eq(root)
        && path.index(root.len) == '/'
}

EXT_BYTES : usize = 4

dot_for = (b: u8) u8 {
    (b == '/').match({ true  => '.', false => b })
}

// Convert a dotted module name to path separators.
slash_for* = (b: u8) u8 {
    (b == '.').match({ true  => '/', false => b })
}

// A module's canonical name, source path, and root-relative source path.
Unit* = {
    name*: str,     // the dotted module name: `std.core.result`
    path*: str,     // where the bytes are, to open them: as given
    rel*:  str,     // the same file, relative to the compilation ROOT
}

// Build a Unit from a path rather than the import spelling that found it.
unit_at* = (a: Alloc, root: str, path: str) Res<Unit, AllocError> {
    name = module_name(a, root, path).try();
    Ok(Unit(name: name, path: path, rel: relative_to(root, path)));
}

// Resolve `<root>/<name>.zen` or the folder-module form
// `<root>/<name>/<last>.zen`. When neither exists, return the flat candidate
// so the eventual read reports the requested path.
candidate* = (env: Env, a: Alloc, root: str, name: str) Res<Unit, AllocError> {
    flat ::= a.String("{}/{}.zen", root, name).try();
    last = Path(name).name();
    nest ::= a.String("{}/{}/{}.zen", root, name, last).try();
    take_flat = env.fs.exists(flat.view()) || !env.fs.exists(nest.view());
    take_flat.match({
        true  => unit_at(a, root, flat.view()),
        false => unit_at(a, root, nest.view()),
    })
}

// Conventional program entry module and declaration name.
ENTRY*: str = "main"

// Resolve an explicit entry path or probe conventional module names.
entry_of* = (env: Env, a: Alloc, root: str, named: str)
            Res<Unit, AllocError> {
    named.is_empty().match({
        false => entry_named(env, a, root, named),
        true  => entry_probed(env, a, root),
    })
}

// An explicit entry is root-relative and is not probed for alternatives.
entry_named = (env: Env, a: Alloc, root: str, named: str)
              Res<Unit, AllocError> {
    path ::= a.String("{}/{}", root, named).try();
    unit_at(a, root, path.view())
}

// Probe `main`, the root basename, then the compiler's `zen` entry.
entry_probed = (env: Env, a: Alloc, root: str) Res<Unit, AllocError> {
    first = candidate(env, a, root, ENTRY).try();
    env.fs.exists(first.path).match({
        true  => Ok(first),
        false => entry_after_main(env, a, root),
    })
}

entry_after_main = (env: Env, a: Alloc, root: str) Res<Unit, AllocError> {
    base   = Path(root).name();
    second = candidate(env, a, root, base).try();
    env.fs.exists(second.path).match({
        true  => Ok(second),
        false => candidate(env, a, root, "zen"),
    })
}

// Resolve a qualified import to its flat or folder-module source path.
file_of* = (env: Env, a: Alloc, root: str, q: QualifiedName)
           Res<str, AllocError> {
    flat = joined(a, root, q, false).try();
    env.fs.exists(flat).match({
        true  => Ok(flat),
        false => joined(a, root, q, true),
    })
}

joined* = (a: Alloc, root: str, q: QualifiedName, folder: bool)
          Res<str, AllocError> {
    out ::= a.String("{}", root).try();
    q.segments.loop((h, s) { out.fmt("/{}", s.text).try() });
    folder.then(() { out.fmt("/{}", q.last_segment()).try() });
    out.add(".zen").try();
    Ok(out.view());
}
