// src/lsp/lsp_action.zen
// `textDocument/codeAction` — the auto-import quickfix, the only action.
//
// ONE KIND, and it is sema's answer wearing the protocol's clothes: an
// undefined name squiggles, and the fix is the import line that would
// have bound it. The QUESTION — which modules export this name — is
// `World.exported_named`, asked of the same shared `Checker` the
// diagnostics came from. `context.diagnostics` IS NOT READ: what the
// client was told and what the checker says cannot disagree when there
// is one source, so the handler re-walks the checker's own diags and
// offers one action per (undefined name, exporting module).
//
// `[]` IS THE ANSWER TO EVERY REFUSAL — no workspace, no build in the
// slot, a module the tree cannot place — for `lsp_fmt.zen`'s reason: a
// client asks on every cursor pause, and an error is a modal.
//
// THE EDIT IS TEXT, NOT AST: one line, `Name = dotted.module\n`, spelled
// UNSTARRED — a star on an import is re-export (`sema_def.zen`), and
// this fix imports to use. It lands after the file's last import decl,
// or at the top of a file that has none. Insertion is a zero-length
// range; the client moves nothing it was not told to.
//
// NOT OFFERED, and named so nobody thinks it lost: an enum VARIANT
// (`Ok`, `None`) is not a `Def` — it rides its enum's star — so an
// undefined variant name offers nothing yet. That is the `variant_defs`
// walk, a follow-up, and `docs/design_lsp.md`'s table says so.
//
// THE LINE IS THE SPELLING THIS TREE WRITES. A folder root that
// re-exports the name under its short spelling is offered as that short
// form — `Name = std.text`, the line `scripts/style.py`'s `rule_layer`
// lets a plain consumer write — and never the declaring file's long
// path, which builds and then fails the style gate on the next run.
// Identical lines are one offer, however many modules hold the name.
// The span test below is HALF-OPEN at both edges with one allowance,
// the empty cursor range — `ast_span.zen` owns the reason.

str, String = std.text
Vec = std.collections
Alloc, AllocError = std.mem
Range = std.core
Pos, Span = std.ast.ast_span
module_index_of = std.ast.ast_named
Checker = sema.sema_check
Diag = sema.sema_diag
Def, module_display = sema.sema_def
ModuleTable = sema.sema_def
to_pos, to_wire, write_wire, WirePos = lsp.lsp_pos
written, obj, arr, Nest = std.json

// One offer: the name to bind and the module to bind it from. Kept as
// DATA until the writer pass, because the comma rule wants an index and
// the diag walk does not have one.
Action = { name: str, module: str }

// The `CodeAction[]` for one range: an action per (undefined name under
// the range, module exporting it). `text` IS THE EDITOR'S BUFFER — the
// insertion point is read off the built tree, but the wire position is
// measured against these bytes, as everywhere in this folder.
write_actions* = (
    c    : Checker,
    t    : Alloc,
    file : str,
    text : str,
    uri  : str,
    sl   : usize,
    sc   : usize,
    el   : usize,
    ec   : usize,
    out  :: String
) Res<(), AllocError> {
    found ::= t.Vec<Action>();
    from = to_pos(text, sl, sc);
    upto = to_pos(text, el, ec);
    Range(0, c.diag_count()).loop((h, i) {
        c.diag_at(i).match({
            None  => written(),
            Ok(d) => offer(c, t, file, d, from, upto, found),
        }).try();
    });
    write_offerings(c, t, file, text, uri, found, out)
}

// A diag earns offers when it is THIS FILE's, it covers the asked range,
// and it is the one fault an import line answers. Every other fault is
// not this server's action to offer — there is no "add the missing
// field" here, and a kitchen-sink menu is how a quickfix stops being
// quick.
offer = (
    c     : Checker,
    t     : Alloc,
    file  : str,
    d     : Diag,
    from  : Pos,
    upto  : Pos,
    found :: Vec<Action>
) Res<(), AllocError> {
    (d.file.eq(file) && covers(d.span, from, upto)).match({
        false => written(),
        true  => d.fault.match({
            UndefinedName(nf) => offer_name(c, t, nf.name, found),
            _                 => written(),
        }),
    })
}

// ONE OFFER PER NAME PER REQUEST: a file that writes `Vec` twice has two
// diags and one missing import, so the second diag for a name already
// collected adds nothing. THE WHOLE ACTION IS THE DEDUP KEY, not the
// name: `exported_named` walks every module table, so one name can come
// back from N modules (`Diag` is declared in `lex`, `parse` and `sema`;
// `zen_build.zen` documents the collision) and two of them spelling the
// same line are one menu row.
offer_name = (c: Checker, t: Alloc, name: str, found :: Vec<Action>)
             Res<(), AllocError> {
    found.find((a) { a.name.eq(name) }).match({
        Ok(_) => written(),
        None  => {
            defs ::= t.Vec<Def>();
            lines ::= t.Vec<str>();
            c.world.exported_named(name, defs).try();
            defs.loop((h, d) {
                offer_def(c, t, name, d, found, lines).try();
            });
            Ok(())
        },
    })
}

// The import line an offer writes, and the dedup against it.
//
// NAMED AS A PERSON WRITES IT, in this tree's own voice: `module_display`
// collapses only a REPEATED last segment (`std.core.core` -> `std.core`),
// which is the folder rule applied to the declaring file itself. A root
// that EXPORTS the name under its short spelling is written by every
// plain consumer as that short form — `str = std.text`, never
// `str = std.text.text_str`, which `scripts/style.py`'s `rule_layer`
// reads as a compiler-sublayer path and refuses. So when the def is
// visible from the folder's root table under the same dotted tail, the
// offer spells the root; when it is not (or the module IS its own root,
// where the two spellings are one table), it keeps the long form.
offer_def = (c: Checker, t: Alloc, name: str, d: Def, found :: Vec<Action>,
             seen :: Vec<str>)
            Res<(), AllocError> {
    mi = d.id.module.to_usize();
    c.world.table_at(mi).match({
        None   => written(),
        Ok(table) => offer_at(c, t, name, mi, table, found, seen),
    })
}

// The same, holding the declaring module's own table.
offer_at = (c: Checker, t: Alloc, name: str, mi: usize, table: ModuleTable,
            found :: Vec<Action>, seen :: Vec<str>) Res<(), AllocError> {
    spoken = module_display(table.name);
    // THE FOLDER ROOT, ASKED NOT ASSUMED: the short spelling is offered
    // only when the root really hands out this name — its own table has
    // it and every copy there is starred, so the unstarred line the fix
    // writes actually binds. A def that travels only under the long
    // path keeps it. `spoken != table.name` is the test for a collapse
    // having happened at all; when the module IS its own root the two
    // spellings are one table and there is nothing to ask.
    //
    // The refusals are `written()` and the arms end in `.try()` because
    // a `{}` arm beside an `Ok(())` arm is two different types to this
    // checker — every arm of an expression match must agree, which is
    // why `offer` above spells its refusals the same way.
    at_root ::= t.Vec<Def>();
    offered ::= spoken;
    (spoken.eq(table.name)).match({
        false => c.world.index_of(spoken).match({
            None => written(),
            Ok(r) => (r == mi).match({
                true  => written(),
                false => c.world.table_at(r).match({
                    None  => written(),
                    Ok(_) => {
                        c.world.own_defs(r, name, at_root).try();
                        ((at_root.len > 0)
                            && all_exported(at_root)).then(() {
                                offered = spoken;
                            });
                        written()
                    },
                }).try(),
            }).try(),
        }).try(),
        true  => written(),
    });
    line  ::= t.String().try();
    line.add_bytes(name).try();
    line.add_bytes(" = ").try();
    line.add_bytes(offered).try();
    seen.find((s) { s.eq(line.view()) }).match({
        Ok(_)  => written(),
        None   => {
            seen.add(line.view()).try();
            found.add(Action(name: name, module: offered))
        },
    });
    Ok(())
}

// Whether every def in `defs` crosses a boundary — the star that makes
// an unstarred IMPORT of it work. A root re-exports what it imports;
// one unstarred binding among them and the short line binds nothing,
// so the offer stays on the long path.
all_exported = (defs :: Vec<Def>) bool {
    (defs.len == 0).match({
        true  => false,
        false => defs.find((d) { d.exported == false })
                      .match({ Ok(_) => false, None => true }),
    })
}

// A diag's span against the request's range, BOTH HALF-OPEN: `Span` is
// `[start, end)` (`std/ast/ast_span.zen`) and an LSP `Range.end` is
// exclusive too, so the test is strict at each edge — a caret sitting ON
// a boundary selects nothing by itself. THE EMPTY RANGE is the one
// allowance, and it is spelled: a zero-width cursor range has
// from == upto, and it selects what the cursor is INSIDE. Inclusive ends
// here would reach one column out on each side — `x := Foo(Bar)` with
// both names undefined would offer `Import Foo` for a caret on the `(`,
// and selecting exactly `Foo(` would offer `Import Bar`.
covers = (span: Span, from: Pos, upto: Pos) bool {
    empty = from.line == upto.line && from.col == upto.col;
    (empty).match({
        true  => !after(span.start, from) && before(from, span.end),
        false => before(span.start, upto) && before(from, span.end),
    })
}

after = (a: Pos, b: Pos) bool {
    a.line > b.line || (a.line == b.line && a.col > b.col)
}

// The other edge, named for the same reason `after` is: `a < b`, strictly.
before = (a: Pos, b: Pos) bool {
    a.line < b.line || (a.line == b.line && a.col < b.col)
}

// WHERE THE LINE GOES: after the file's last import decl, read off the
// BUILT tree — the buffer mid-keystroke may not parse, and the decls
// that describe it are the settle's. No imports yet: the top of the
// file. `Pos` is 1-based, so the line AFTER the import's last is
// `end.line + 1`, which `to_wire` shifts onto the wire's 0-based axis.
insert_at = (c: Checker, file: str, text: str) WirePos {
    line ::= 1;
    module_index_of(c.tree, file).match({
        None   => {},
        Ok(mi) => c.tree.module_at(mi).match({
            None  => {},
            Ok(m) => m.decls.loop((h, d) {
                d.kind.match({
                    Import(_) => { line = d.span.end.line + 1; },
                    _         => {},
                });
            }),
        }),
    });
    to_wire(text, Pos(line: line, col: 1))
}

// The wire shape. The title is plain text a person reads; the URI and the
// new line go through `write_text` — a module path is dots and letters
// today, and the day one is not, the escaping is already right.
write_offerings = (
    c     : Checker,
    t     : Alloc,
    file  : str,
    text  : str,
    uri   : str,
    found : Vec<Action>,
    out   :: String
) Res<(), AllocError> {
    at = insert_at(c, file, text);
    list ::= arr(out).try();
    found.loop((h, a) { write_action(t, a, at, uri, list, out).try(); });
    list.close(out)
}

// THE TITLE IS THE LINE, SAID OUT LOUD, and it is built from the line
// rather than beside it — two spellings of `Name = dotted.module` is two
// places for the offer and the edit to disagree.
//
// AND IT GOES THROUGH `write_text` LIKE EVERY OTHER STRING HERE. It used
// to be concatenated between hand-written quotes, the one place in this
// folder where caller data reached the wire unescaped. A Zen identifier
// holds no quote today, so nothing was wrong on any input the lexer can
// produce — which is exactly why it would have stayed wrong.
write_action = (
    t    : Alloc,
    a    : Action,
    at   : WirePos,
    uri  : str,
    list :: Nest,
    out  :: String
) Res<(), AllocError> {
    line ::= t.String().try();
    line.add_bytes(a.name).try();
    line.add_bytes(" = ").try();
    line.add_bytes(a.module).try();
    line.add_bytes("\n").try();
    // The line is finished before its bytes are read, so the view cannot
    // outlive a growth of the buffer behind it.
    said = line.view();
    title ::= t.String().try();
    title.add_bytes("Import ").try();
    title.add_bytes(said.slice(0, said.len - 1)).try();

    list.next(out).try();
    fix ::= obj(out).try();
    fix.text("title", title.view(), out).try();
    fix.text("kind", "quickfix", out).try();
    fix.key("edit", out).try();
    edit ::= obj(out).try();
    edit.key("changes", out).try();
    changes ::= obj(out).try();
    changes.key(uri, out).try();
    edits ::= arr(out).try();
    edits.next(out).try();
    one ::= obj(out).try();
    one.key("range", out).try();
    range ::= obj(out).try();
    range.key("start", out).try();
    write_wire(at, out).try();
    range.key("end", out).try();
    write_wire(at, out).try();
    range.close(out).try();
    one.text("newText", said, out).try();
    one.close(out).try();
    edits.close(out).try();
    changes.close(out).try();
    edit.close(out).try();
    fix.close(out)
}
