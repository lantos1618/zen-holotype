// one arm of the diamond: re-exports Token, and DECLARES a function of
// its own on it. Without that, this arm contributed nothing main could
// tell apart from the other arm's contribution -- both would have been
// answered by whichever Token happened to be reached.
Token*, token_id* = token.token

token_tagged* = (t: Token) i32 { t.id + t.tag * 100 }
