// a third module, the METHOD case: the bound comes from `meter`, the
// impl (a method, not a field) from `wheel`, and neither is declared
// here. sema/bound_third_module pins the same triangle for a computed
// FIELD; this one pins it for a method call, which resolves in a second
// file entirely -- sema_call rather than sema_member -- and could agree
// with the field path or disagree with it.
//
// 12*2+6 = 30 and 0*2+6 = 6: line 2 is the zero-receiver that proves
// the +3 came from Wheel's impl and not from anywhere else.

Meter = meter.meter
Wheel = wheel.wheel

pressure = <T: Meter>(m: T) i32 { m.read() * 2 }

main = (env: Env) Res<i32, AllocError> {
    println("{}", pressure(Wheel(psi: 12)));
    println("{}", pressure(Wheel(psi: 0)));
    Ok(0);
}
