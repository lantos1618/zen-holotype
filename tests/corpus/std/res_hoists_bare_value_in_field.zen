// tests/corpus/std/res_hoists_bare_value_in_field.zen
// the same hoist at construction: a field declared Res<i32> takes
// a bare 32. the two forms are the same value, so they match the
// same way

Row = {
    n: Res<i32>,
    label: str,
}

main = (env: Env) Res<i32, AllocError> {
    lifted   = Row(n: 32, label: "lifted");
    explicit = Row(n: Ok(32), label: "explicit");
    absent   = Row(n: None, label: "absent");

    lifted.n.match({
        Ok(v) => println("{} {}", lifted.label, v),
        None  => println("{} none", lifted.label),
    });
    explicit.n.match({
        Ok(v) => println("{} {}", explicit.label, v),
        None  => println("{} none", explicit.label),
    });
    absent.n.match({
        Ok(v) => println("{} {}", absent.label, v),
        None  => println("{} none", absent.label),
    });
    Ok(0);
}
