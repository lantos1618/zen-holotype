// src/sema/sema_spine.zen
// An operator chain is a SPINE, not a tree.
//
// `a + b + c + ..` parses as `((a + b) + c) ..`, and `parse_expr.zen`
// builds it with a loop (`binary_from` folds each operator onto the
// left in place) — so a `+` chain's length is bounded by nothing: one
// line of `tests/corpus/lex/long_single_line.zen` is ten thousand of
// them.
//
// `type_of` on the root recurses once per term (compute_expr,
// expr_kind, binary_type, type_of); at four frames a term, an
// eight-megabyte stack runs out past a thousand — a segfault, and "a
// crash is not a diagnostic" (docs/TESTING.md). The bootstrapper's
// `gen_c.py:ex_Binary` walks the spine with a loop for the same reason.
//
// So the spine is walked with a cursor and typed BOTTOM-UP: every left
// operand is in `expr_memo` before the level above asks for it, so the
// recursion left is one level deep however long the line — the same
// order `binary_type` already types its left operand in.
//
// Only the LEFT spine, only through `Binary`. Every other nesting —
// parens, unary, call args — is recursive descent in the parser too, so
// `MAX_DEPTH` already bounds it; the binary spine is the one construct
// that escapes that bound, since it's the one the parser builds
// iteratively.

Expr, ExprId, Binary = std.ast
Alloc, AllocError = std.mem
Vec = std.collections
TyId = sema.sema_ty
Checker, Ctx = sema.sema_check
// the query this file exists to keep shallow; the cycle back to
// `sema_type` is the shape of expression typing and not a smell, for
// the reason that file's header gives
type_of = sema.sema_type

// Is there a spine below this operand at all? Asked at the call site,
// not as a micro-optimisation: the walk below holds a `Vec` and a
// cursor, a frame far fatter than the recursion it replaces, and almost
// every operand has no spine under it. Left unguarded it would sit
// under every `+`/`==` in the tree and lower the depth at which OTHER
// constructs run the stack out — measured: nested `.match` lost a third
// of its headroom to exactly that.
spine_ahead* = (c: Checker, id: ExprId) bool {
    below(c, id).match({ None => false, Ok(_) => true })
}

// Type every level of the left spine below `id`, deepest first, so the
// caller's own recursion finds each one already answered. Stops at a
// node already in the memo, keeping the whole spine linear rather than
// quadratic: the next walk is one step long.
seed_left_spine* = (c :: Checker, id: ExprId, ctx: Ctx)
                  Res<(), AllocError> {
    spine ::= c.alloc.Vec<ExprId>();
    down ::= id;
    going ::= true;
    loop(() { going }, (h) {
        going = below(c, down).match({
            None     => false,
            Ok(next) => { spine.add(down).try(); down = next; true },
        });
    });
    // `take` from the end is a pop, and the spine was collected top
    // down, so this hands the levels back innermost first.
    loop(() { spine.len > 0 }, (h) {
        spine.take(spine.len - 1).match({
            None   => c.types.unknown(),
            Ok(at) => c.type_of(at, ctx),
        }).try();
    });
    Ok(());
}

// One step down: the left operand of a binary node nothing has typed
// yet, and `None` at anything else.
below = (c: Checker, id: ExprId) Res<ExprId> {
    c.expr_memo.get(id).match({
        Ok(_) => None,
        None  => left_of(c.tree.expr_at(id)),
    })
}

left_of = (node: Expr) Res<ExprId> {
    node.kind.match({
        Binary(b) => Ok(b.lhs),
        _         => None,
    })
}
