// src/sema/sema_type.zen
// The two questions a node is asked, and the answers cached against it.
//
// `type_from_ast(id)` is what a WRITTEN type denotes; `type_of(id)` is
// what an EXPRESSION is. Both memoize on the node's id — which is what
// `ast_id.zen` made ids `Eq + Hash` for, and what `sema_check.zen` holds
// the two `Map`s for.
//
// EVERY FUNCTION HERE IS A FREE FUNCTION ON `Checker`, and that is what
// makes this a file rather than four hundred more lines of the engine.
// DESIGN.md settles that the two are the same thing: "`@Self` is spelled
// `Vec<T>` when you write the same function outside the body — the two
// forms are the same function, and the second is what the first means."
// So `c.type_of(id, ctx)` still reads as a method, resolution is ufcs,
// and nothing at a call site changed.
//
// OVER 500 LINES, AND THE JUSTIFICATION STYLE.md ASKS FOR: the subject
// is "what does this node mean", and the two queries share the memo
// discipline and the poison rule. The forms that grew their own subject
// have already left — `Match` to `sema_match`, `Access` to `sema_member`,
// `Call` to `sema_call`, the trap rule to `sema_trap`, and the failure
// model with `.try()` to `sema_try` — and what is left is the dispatch
// plus the forms with no subject of their own.
//
// THE ENGINE HOLDS STATE AND THIS HOLDS BEHAVIOUR, which is what made
// the split possible: `sema_check.zen` imports nothing from here.
//
// The claim this header used to make — that module cycles are a compile
// error — is FALSE, and `AST_CONTRACT.md` says so in as many words:
// "an import cycle is not a problem a whole-program compiler has". It
// was tested rather than assumed, with two sibling modules calling each
// other's functions, and it runs. That matters here because expression
// typing IS mutually recursive across this folder: `Call` needs
// `type_of` and `type_of` needs `Call`, so the cycle is the shape of the
// problem and not a smell.

Ast, Expr, ExprId, Type, TypeId, Span, Ident, Literal, LiteralKind = ast
Decl, DeclKind, Const, Alias, Enum = ast
BinOp, UnOp, Block, BlockId, Stmt, StmtKind = ast
Param, Binary, Unary, Bind, ExprStmt, Match, Access, Call = ast
ArrayType, ArrayLit, FixedArray, Index = ast
Alloc, AllocError = std.mem
Vec, Map = std.collections
str, String = std.text
Range = std.core
DeclId = sema.sema_id
TyId, Ty, Types, TyArray, TyNamed, is_prim = sema.sema_ty
World, Def, DefKind, decl_at = sema.sema_def
named_or_union = sema.sema_union
Diag, SemaFault, NameFault = sema.sema_diag
Checker, Ctx = sema.sema_check
UNRESOLVED, is_predicate = sema.sema_check
try_type = sema.sema_try
alias_module, module_not_a_value = sema.sema_module
match_type = sema.sema_match
access_type = sema.sema_member
variant_type = sema.sema_static
call_type = sema.sema_call
computed_member = sema.sema_member
bind_stmt = sema.sema_place
check_binary, const_count, check_index, check_literal = sema.sema_trap
check_eq = sema.sema_bound
seed_left_spine, spine_ahead = sema.sema_spine

// -----------------------------------------------------------------
// QUERY: the type a written type node denotes
//
// `ast.Type` is what the author wrote; this is what it means. The
// memo makes the two-way trip once per node, which matters because
// a signature's parameter types are read at every call site.
// -----------------------------------------------------------------

// `@Self` IS THE ONE WRITTEN TYPE WHOSE MEANING IS NOT IN ITS NODE, so a
// signature that names it may not be memoized.
//
// `Vec<T>.get` is written `(self: @Self, i: usize) Res<T>` ONCE, and the
// answer differs per receiver: asked about `Vec<i32>` first and `Vec<u8>`
// second, a memo keyed on the node hands the second asker the first
// one's receiver. Nothing said so — the two agree on everything except
// the parameter nobody compares — until monomorphisation made the
// receiver part of a SYMBOL, and `Vec<u8>.get` was emitted taking a
// `Vec<i32>`. That is the failure class this compiler has paid for
// twice: C that compiles and means something else.
//
// A type parameter is NOT in this class and stays memoized: `T` denotes
// a `Ty.Var` nominal on its owner, which is the same type wherever the
// node is read from. Only the receiver travels in `ctx`.
type_from_ast* = (c :: Checker, id: TypeId, ctx: Ctx)
                 Res<TyId, AllocError> {
    ctx.has_self.match({
        true  => c.type_kind(c.tree.type_at(id), ctx),
        false => c.memoized_type(id, ctx),
    })
}

memoized_type* = (c :: Checker, id: TypeId, ctx: Ctx)
                 Res<TyId, AllocError> {
    c.type_memo.get(id).match({
        None    => c.compute_type(id, ctx),
        Ok(hit) => Ok(hit),
    })
}

compute_type* = (c :: Checker, id: TypeId, ctx: Ctx)
               Res<TyId, AllocError> {
    // seed the memo with poison before recursing, so a type that
    // mentions itself bottoms out instead of looping. A recursive
    // type is a real thing — `Node = { next: Ptr<Node> }` — and the
    // layout question is answered elsewhere.
    poison = c.types.unknown().try();
    c.type_memo.set(id, poison).try();
    node = c.tree.type_at(id);
    got = c.type_kind(node, ctx).try();
    c.type_memo.set(id, got).try();
    Ok(got);
}

type_kind* = (c :: Checker, node: Type, ctx: Ctx) Res<TyId, AllocError> {
    node.kind.match({
        Unit     => c.types.prim("()"),
        SelfType => c.self_type(ctx),
        Infer    => c.types.infer(),
        Variadic => c.types.prim("..."),
        Named(n) => c.named_type(node, n.name, n.args, ctx),
        Union(u) => c.union_type(u.members, ctx),
        Fn(f)    => c.fn_type(f.params, f.ret, ctx),
        Array(t) => c.array_type(t, ctx),
    })
}

self_type* = (c :: Checker, ctx: Ctx) Res<TyId, AllocError> {
    ctx.has_self.match({
        false => c.types.unknown(),
        true  => Ok(ctx.self_ty),
    })
}

union_type* = (c :: Checker, members: Vec<TypeId>, ctx: Ctx)
             Res<TyId, AllocError> {
    parts ::= c.alloc.Vec<TyId>();
    members.loop((h, m) {
        parts.add(c.type_from_ast(m, ctx).try()).try();
    });
    c.types.union_ty(parts)
}

fn_type* = (c :: Checker, params: Vec<Param>, ret: TypeId, ctx: Ctx)
          Res<TyId, AllocError> {
    ptys ::= c.alloc.Vec<TyId>();
    params.loop((h, p) {
        ptys.add(c.param_type(p, ctx).try()).try();
    });
    rty = c.type_from_ast(ret, ctx).try();
    c.types.fn_ty(ptys, rty)
}

param_type* = (c :: Checker, p: Param, ctx: Ctx) Res<TyId, AllocError> {
    p.type.match({
        None  => c.types.infer(),
        Ok(t) => c.type_from_ast(t, ctx),
    })
}

// `[u8, 64]`. BOTH HALVES ARE THE TYPE: the element is what an
// assignment has to agree about, and the count is what makes `[u8, 64]`
// and `[u8, 65]` two types — DESIGN.md:301, and the reason a bounds
// check needs no length stored beside the bytes.
//
// The count is an EXPRESSION because it is comptime, not because it is a
// literal, so `[u8, i32.BITS]` folds the same way `i32.MAX + 1` does.
// One that folds to nothing is a count this compiler cannot carry; it
// takes 0, which makes every index into it out of range and reported
// rather than silently admitted.
array_type* = (c :: Checker, t: ArrayType, ctx: Ctx)
             Res<TyId, AllocError> {
    e = c.type_from_ast(t.elem, ctx).try();
    c.types.array(e, const_count(c, t.count))
}

// A written name, applied to its arguments.
//
// `Res` is recognised structurally rather than resolved, and that is
// not a special case for a favourite type: `Res<T>` and `Res<T, E>`
// are two arities of one name, sema asks "which form is this" at
// every `.try()`, and a nominal answer would make every one of those
// questions a field read through a declaration.
named_type* = (c :: Checker, node: Type, name: Ident, args: Vec<TypeId>,
              ctx: Ctx) Res<TyId, AllocError> {
    tys ::= c.alloc.Vec<TyId>();
    args.loop((h, a) {
        tys.add(c.type_from_ast(a, ctx).try()).try();
    });
    name.text.eq("Res").match({
        true  => c.res_type(tys),
        false => c.declared_type(node, name, tys, ctx),
    })
}

res_type* = (c :: Checker, args: Vec<TyId>) Res<TyId, AllocError> {
    value = args.get(0).match({ Ok(v) => v, None => UNRESOLVED });
    args.len.match({
        1 => c.types.res_absence(value),
        2 => c.res_failure_of(args, value),
        _ => c.types.unknown(),
    })
}

res_failure_of* = (c :: Checker, args: Vec<TyId>, value: TyId)
                 Res<TyId, AllocError> {
    args.get(1).match({
        None  => c.types.unknown(),
        Ok(e) => c.types.res_failure(value, e),
    })
}

// A primitive, or a declaration the module can see.
//
// The primitive check comes first because no module declares `i32`
// in a way this layer can reach, and a name that is both would be a
// language change rather than a lookup order.
declared_type* = (c :: Checker, node: Type, name: Ident, args: Vec<TyId>,
                 ctx: Ctx) Res<TyId, AllocError> {
    is_prim(name.text).match({
        true  => c.types.prim(name.text),
        false => c.tvar_or_declared(node, name, args, ctx),
    })
}

// The `T` of an enclosing `<T>` shadows a declaration of the same name,
// exactly as a local binding does. Without this, resolving a generic's
// own signature reports its own type parameter as an undefined name.
tvar_or_declared* = (c :: Checker, node: Type, name: Ident, args: Vec<TyId>,
                    ctx: Ctx) Res<TyId, AllocError> {
    c.lookup_tvar(name.text).match({
        None  => c.lookup_named(node, name, args, ctx),
        Ok(b) => Ok(b.ty),
    })
}

lookup_named* = (c :: Checker, node: Type, name: Ident, args: Vec<TyId>,
                ctx: Ctx) Res<TyId, AllocError> {
    found ::= c.alloc.Vec<Def>();
    c.world.defs_of(ctx.module, name.text, found).try();
    found.get(0).match({
        None  => c.unresolved_type(node, name),
        Ok(d) => c.declared_or_alias(d, args),
    })
}

// "AN ALIAS IS THE TYPE, NOT A NAME THAT FORWARDS TO IT." `Alias = Shape`
// binds `Alias` to `Shape` ITSELF, so `Alias.Circle` is `Shape.Circle` and
// a value of one is a value of the other, because there are not two types.
// So an alias RESOLVES THROUGH here, and nothing downstream sees a second
// type — `ast_node.zen` says as much where `Alias` is declared, and no
// backend has an arm for one.
//
// Answering with a nominal of the alias's OWN name is what it did instead,
// and that type has no members, no variants and no impls: `a: Alias =
// Alias.Circle` became "no such field or method on this type `Circle`",
// which names neither the alias nor anything the author wrote.
declared_or_alias* = (c :: Checker, d: Def, args: Vec<TyId>)
                    Res<TyId, AllocError> {
    d.kind.match({
        AliasDef => c.alias_type(d, args),
        _        => named_or_union(c, d, args),
    })
}

// TWO ALIASES DO NOT RESOLVE THROUGH, and both keep the nominal the rest
// of the compiler already recognises them by.
//
// A MODULE ALIAS has no type to resolve TO: `zz = vec` is grammar R1a's
// other reading of the same three tokens, and `module_named_by` finds the
// module back through this nominal's decl — which is what makes
// `sh.reseat(3)` work. Using the bare name is a diagnostic raised where
// the name is USED, not here.
//
// A PARAMETERISED ALIAS is a type constructor, and resolving its target
// without substituting would answer with a type full of free parameters.
// It stays nominal until substitution exists to do it properly.
alias_type* = (c :: Checker, d: Def, args: Vec<TyId>)
             Res<TyId, AllocError> {
    c.alias_module(d.id).match({
        Ok(_) => named_or_union(c, d, args),
        None  => c.alias_decl_type(d, args),
    })
}

alias_decl_type* = (c :: Checker, d: Def, args: Vec<TyId>)
                  Res<TyId, AllocError> {
    decl_at(c.tree, d.id).match({
        None  => named_or_union(c, d, args),
        Ok(x) => x.kind.match({
            Alias(al) => c.alias_written_type(al, d, args),
            _         => named_or_union(c, d, args),
        }),
    })
}

// The target, read in the module that DECLARED the alias: a written type
// is a name, and a name means what it means where it was written.
alias_written_type* = (c :: Checker, al: Alias, d: Def, args: Vec<TyId>)
                     Res<TyId, AllocError> {
    (al.tparams.len == 0).match({
        false => named_or_union(c, d, args),
        true  => c.alias_target_of(al, d),
    })
}

alias_target_of* = (c :: Checker, al: Alias, d: Def) Res<TyId, AllocError> {
    poison = c.types.unknown().try();
    ctx = Ctx(d.id.module.to_usize(), poison);
    c.type_from_ast(al.target, ctx)
}

// THE ENUM AN ALIAS NAMES, asked by the backend lowering `Alias.Circle`.
//
// The backend finds the enum a base names by looking the name up itself,
// and an alias answered `AliasDef` there — so the variant had no enum to
// belong to and `Alias` was reported as an unresolved value. It asks SEMA
// rather than walking to the target a second time, because two walks that
// disagreed would write a tag from one enum into a value of another, which
// is C that compiles and means something else.
//
// `None` when the target is not an enum, which is the answer any other
// declaration gives — a struct alias has no variants to reach.
alias_enum* = (c :: Checker, d: Def) Res<TyId> {
    c.def_type(d).match({
        Err(_) => None,
        Ok(ty) => c.enum_named_by(ty),
    })
}

enum_named_by* = (c :: Checker, ty: TyId) Res<TyId> {
    c.types.at(ty).match({
        Named(n) => c.enum_decl_of(n, ty),
        _        => None,
    })
}

enum_decl_of* = (c :: Checker, n: TyNamed, ty: TyId) Res<TyId> {
    decl_at(c.tree, n.decl).match({
        None  => None,
        Ok(x) => x.kind.match({
            Enum(_) => Ok(ty),
            _       => None,
        }),
    })
}

unresolved_type* = (c :: Checker, node: Type, name: Ident)
                  Res<TyId, AllocError> {
    c.report(node.span.file, name.span,
                SemaFault.UndefinedName(NameFault(name: name.text))).try();
    c.types.unknown()
}

// -----------------------------------------------------------------
// QUERY: the type of an expression
//
// The one DESIGN.md names first. Memoized on the node id, so a
// second ask is a lookup and an LSP hover is not a recompile.
// -----------------------------------------------------------------

type_of* = (c :: Checker, id: ExprId, ctx: Ctx) Res<TyId, AllocError> {
    c.expr_memo.get(id).match({
        None    => c.compute_expr(id, ctx),
        Ok(hit) => Ok(hit),
    })
}

compute_expr* = (c :: Checker, id: ExprId, ctx: Ctx)
               Res<TyId, AllocError> {
    poison = c.types.unknown().try();
    c.expr_memo.set(id, poison).try();
    node = c.tree.expr_at(id);
    got = c.expr_kind(id, node, ctx).try();
    c.expr_memo.set(id, got).try();
    Ok(got);
}

// `id` is threaded beside `node` for the two kinds that record an answer
// under it: a call names a declaration, and a field access names the
// type that supplied it. An `Expr` is a value and carries no id, so a
// query that writes into a memo keyed on the node has to be told which
// node it is.
expr_kind* = (c :: Checker, id: ExprId, node: Expr, ctx: Ctx)
             Res<TyId, AllocError> {
    node.kind.match({
        Literal(l)    => c.literal_type(l),
        Unit          => c.types.prim("()"),
        SelfType      => c.self_type(ctx),
        Name(n)       => c.name_type(node, n.text, ctx),
        Paren(p)      => c.type_of(p.inner, ctx),
        Binary(b)     => c.binary_type(node, b, ctx),
        Unary(u)      => c.unary_type(node, u, ctx),
        Try(t)        => c.try_type(t.name_span, t.operand, ctx),
        Consume(x)    => c.type_of(x.operand, ctx),
        Block(b)      => c.block_type(b, ctx),
        Match(m)      => c.match_type(node, m, ctx),
        Access(a)     => c.access_type(id, node, a, ctx),
        Call(k)       => c.call_type(id, node, k, ctx),
        Array(a)      => c.array_lit_type(a, ctx),
        FixedArray(f) => c.fixed_array_type(f, ctx),
        Index(x)      => c.index_element_type(node, x, ctx),
        _             => c.types.unknown(),
    })
}

// `[0, 1, 2]` — a fixed array whose count is how many were written and
// whose element is the first one's type. "the reading is chosen by what
// the elements ARE": nothing here is a type, so this is a literal.
//
// The FIRST element decides, and the rest are typed for their own sake:
// a diagnostic inside an element nobody read is still a diagnostic. An
// empty literal has no element to ask, and `_` is the honest answer —
// the same hole `Res<Cfg, _>` writes.
array_lit_type* = (c :: Checker, a: ArrayLit, ctx: Ctx)
                 Res<TyId, AllocError> {
    elem ::= c.types.infer().try();
    a.elems.loop((h, i, e) {
        got = c.type_of(e, ctx).try();
        (i == 0).then(() { elem = got; });
    });
    c.types.array(elem, a.elems.len)
}

// `[i32, 4](2, 3, 5, 7)` — the type is WRITTEN, so it is what the array
// is, and the arguments are checked against its element rather than
// asked what they are. A count that disagrees with how many were written
// is not caught here: `check_assign` sees one type and the arguments are
// not an assignment to it.
//
// "CHECKED AGAINST ITS ELEMENT" WAS THE COMMENT AND NOT THE CODE: every
// element was typed and then dropped, so `[i32, 2](1, 3000000000)`
// wrapped to -1294967296 with nothing said. BOTH compilers did, which is
// why no differential run could see it — an element is the one position
// where a literal meets a type without an assignment, a parameter or a
// field name anywhere in sight.
fixed_array_type* = (c :: Checker, f: FixedArray, ctx: Ctx)
                   Res<TyId, AllocError> {
    ty = c.type_from_ast(f.type, ctx).try();
    elem = element_of(c, ty);
    f.elems.loop((h, e) {
        c.type_of(e, ctx).try();
        c.check_literal(e, elem).try();
    });
    Ok(ty);
}

// A written array type that resolved to something else is a type
// somebody has already reported on, and it expects nothing of its
// elements.
element_of = (c: Checker, ty: TyId) TyId {
    c.types.at(ty).match({ Array(a) => a.elem, _ => ty })
}

// `buf[i]`. The element, when the receiver is a fixed array — and the
// one place a literal index can be compared against a count, because
// this is where both are known at once. Everything else indexes through
// the `index` its type declares, which is the backend's question and
// stays poison here.
index_element_type* = (c :: Checker, node: Expr, x: Index, ctx: Ctx)
                     Res<TyId, AllocError> {
    base = c.type_of(x.base, ctx).try();
    c.type_of(x.index, ctx).try();
    c.types.at(base).match({
        Array(a) => c.array_element(node, x, a),
        _        => c.types.unknown(),
    })
}

array_element = (c :: Checker, node: Expr, x: Index, a: TyArray)
               Res<TyId, AllocError> {
    c.check_index(node, x, a).try();
    Ok(a.elem);
}

// An integer literal is its own type until a context settles it —
// "a literal's type comes from its context". `int` and `float` are
// assignable to every width, and to nothing else.
literal_type* = (c :: Checker, l: Literal) Res<TyId, AllocError> {
    l.kind.match({
        Int   => c.types.prim("int"),
        Float => c.types.prim("float"),
        Str   => c.types.prim("str"),
        Char  => c.types.prim("u8"),
        Bool  => c.types.prim("bool"),
    })
}

// A bare identifier. A local shadows everything, then the module's
// own declarations, then what it imported — and the `*` gate is
// inside `defs_of`, not repeated here.
name_type* = (c :: Checker, node: Expr, text: str, ctx: Ctx)
            Res<TyId, AllocError> {
    c.lookup(text).match({
        None  => c.unbound_name_type(node, text, ctx),
        Ok(b) => Ok(b.ty),
    })
}

// `None` is the prelude's own variant and there is nothing to resolve:
// `Res<T>` is recognised structurally, exactly as the written type is,
// so the value form is too. It carries no reason because there is none
// to carry — that is what makes it an absence and not an error.
unbound_name_type* = (c :: Checker, node: Expr, text: str, ctx: Ctx)
                    Res<TyId, AllocError> {
    text.eq("None").match({
        true  => c.none_type(),
        false => c.global_name_type(node, text, ctx),
    })
}

none_type* = (c :: Checker) Res<TyId, AllocError> {
    hole = c.types.infer().try();
    c.types.res_absence(hole)
}

global_name_type* = (c :: Checker, node: Expr, text: str, ctx: Ctx)
                   Res<TyId, AllocError> {
    found ::= c.alloc.Vec<Def>();
    c.world.defs_of(ctx.module, text, found).try();
    found.get(0).match({
        None  => c.variant_name_type(node, text, ctx),
        Ok(d) => c.value_def_type(node, d),
    })
}

// A MODULE IS A NAMESPACE, NOT A VALUE — and the mistake is the USE, not
// the binding. `sh = shape` then `sh.reseat(3)` is a real pattern the
// corpus gates; `println("{}", sh)` is not, and the two are the same
// declaration. So the diagnostic lands here, where the bare name stands
// where a value belongs, and says which module it names: the error this
// used to produce was "cannot print a value of this type".
value_def_type* = (c :: Checker, node: Expr, d: Def) Res<TyId, AllocError> {
    c.alias_module(d.id).match({
        None   => c.def_type(d),
        Ok(mi) => c.module_not_a_value(node.span, d.name, mi),
    })
}

// A BARE VARIANT: `Two` where a visible enum declares it, and no
// declaration of that name does.
//
// A declaration wins, and it has to: `Res*, Ok*, None* = std.core.result`
// puts variant names in scope everywhere, so a program that also
// declares one of them means the declaration. The variant is what is
// left when nothing else answered — the same order patterns already
// use, where a name is a case only when the type declares one.
variant_name_type* = (c :: Checker, node: Expr, text: str, ctx: Ctx)
                    Res<TyId, AllocError> {
    found ::= c.alloc.Vec<Def>();
    c.world.variant_defs(c.tree, ctx.module, text, found).try();
    found.get(0).match({
        None  => c.unresolved_name(node, text),
        Ok(d) => c.bare_variant_type(d, text),
    })
}

bare_variant_type = (c :: Checker, d: Def, text: str)
                   Res<TyId, AllocError> {
    ty = c.decl_as_type(d).try();
    c.variant_type(ty, text)
}

unresolved_name* = (c :: Checker, node: Expr, text: str)
                  Res<TyId, AllocError> {
    c.report(node.span.file, node.span,
                SemaFault.UndefinedName(NameFault(name: text))).try();
    c.types.unknown()
}

// A name that denotes a DECLARATION rather than a value. A type used
// as a value is the type itself — `Shape.Unit` reads through it —
// and a function's own type is what overload resolution narrows.
//
// A CONSTANT IS NOT ITS OWN TYPE, and it is the one form here that
// isn't. `RES_PATH* : str = "std.core.result.Res"` binds a `str`, and
// reading the name as a nominal type called `RES_PATH` makes every
// argument built from a constant fail to match the `str` parameter it
// was written for — "no overload matches" on a call whose only
// irregularity is that one argument was named.
// AN ALIAS IS NOT ITS OWN TYPE EITHER, for the same reason a constant is
// not: `Alias.Circle` is `Shape.Circle`, so the base a dot reaches through
// has to be `Shape`. `declared_or_alias` is the same resolution the
// written-type path takes, asked with no arguments.
def_type* = (c :: Checker, d: Def) Res<TyId, AllocError> {
    d.kind.match({
        ConstDef => const_type(c, d),
        AliasDef => c.def_alias_type(d),
        _        => decl_as_type(c, d),
    })
}

def_alias_type* = (c :: Checker, d: Def) Res<TyId, AllocError> {
    empty ::= c.alloc.Vec<TyId>();
    c.declared_or_alias(d, empty)
}

decl_as_type* = (c :: Checker, d: Def) Res<TyId, AllocError> {
    empty ::= c.alloc.Vec<TyId>();
    c.types.named(d.id, d.qname, d.name, empty)
}

// What a constant's name denotes: the type it was declared with, or —
// with none written — the type of the value it was bound to. Resolved
// in the module that DECLARES it, because a written type is a name and
// a name means what it means where it was written.
const_type* = (c :: Checker, d: Def) Res<TyId, AllocError> {
    decl_at(c.tree, d.id).match({
        Ok(x) => const_decl_type(c, x, d),
        None  => c.types.unknown(),
    })
}

const_decl_type = (c :: Checker, x: Decl, d: Def) Res<TyId, AllocError> {
    poison = c.types.unknown().try();
    ctx = Ctx(d.id.module.to_usize(), poison);
    x.kind.match({
        Const(k) => written_or_value(c, k, ctx),
        _        => c.types.unknown(),
    })
}

written_or_value = (c :: Checker, k: Const, ctx: Ctx) Res<TyId, AllocError> {
    k.type.match({
        Ok(t) => c.type_from_ast(t, ctx),
        None  => c.type_of(k.value, ctx),
    })
}

// `a == b` is `bool` whatever the operands are; `a + b` is the
// operands' type. Both sides are typed either way, because a
// diagnostic inside an unused operand is still a diagnostic.
//
// THE LEFT OPERAND IS SEEDED FIRST WHEN IT IS ITSELF AN OPERATOR, and
// `sema_spine.zen` says why: an operator chain is left-nested and the
// parser builds it with a loop, so `b.lhs` may be ten thousand levels
// deep and recursing into it is a segmentation fault. The seed types
// those levels bottom up, which is the order this function would have
// reached them in anyway, so the `type_of` below is a memo hit and
// every answer is unchanged. The guard keeps the walk's frame off the
// stack for an ordinary operand, which is what most operands are.
binary_type* = (c :: Checker, node: Expr, b: Binary, ctx: Ctx)
              Res<TyId, AllocError> {
    c.spine_ahead(b.lhs).match({
        false => Ok(()),
        true  => c.seed_left_spine(b.lhs, ctx),
    }).try();
    lhs = c.type_of(b.lhs, ctx).try();
    rhs = c.type_of(b.rhs, ctx).try();
    operand = c.arith_type(lhs, rhs).try();
    got = is_predicate(b.op).match({
        true  => c.types.bool_ty(),
        false => Ok(operand),
    }).try();
    // a trap the compiler can prove will fire is a compile error, and
    // the operand types are what decides what fits
    c.check_binary(b, got).try();
    // `==` dispatches to `Eq`, and a type with no impl has nothing to
    // call — the operand type is what says so, never the result's
    c.check_eq(b, operand).try();
    Ok(got);
}

// The wider of the two: a literal takes the other side's type, which
// is "a literal's type comes from its context" one level in.
arith_type* = (c :: Checker, lhs: TyId, rhs: TyId) Res<TyId, AllocError> {
    // the match yields a bare TyId and the `Ok` is outside it: two
    // arms that are both `Ok(..)` give the match no written type to
    // take from its first arm.
    Ok(c.is_literal_ty(lhs).match({
        true  => rhs,
        false => lhs,
    }));
}

unary_type* = (c :: Checker, node: Expr, u: Unary, ctx: Ctx)
             Res<TyId, AllocError> {
    inner = c.type_of(u.operand, ctx).try();
    u.op.match({
        Not  => c.types.bool_ty(),
        Neg  => Ok(inner),
        Addr => c.addr_type(node, u, inner, ctx),
    })
}

// `&c.width` on an impl-supplied field: there is no storage, so there is
// no address. The diagnostic lands on the address-of expression, which
// is where the `&` the author has to delete is.
addr_type* = (c :: Checker, node: Expr, u: Unary, inner: TyId, ctx: Ctx)
            Res<TyId, AllocError> {
    operand = c.tree.expr_at(u.operand);
    operand.kind.match({
        Access(a) => c.addr_of_access(node, a, inner, ctx),
        _         => Ok(inner),
    })
}

addr_of_access* = (c :: Checker, node: Expr, a: Access, inner: TyId,
                  ctx: Ctx) Res<TyId, AllocError> {
    c.computed_member(a, ctx).try().match({
        true  => c.no_address(node, a, inner),
        false => Ok(inner),
    })
}

no_address* = (c :: Checker, node: Expr, a: Access, inner: TyId)
             Res<TyId, AllocError> {
    c.report(node.span.file, node.span,
                SemaFault.ComputedFieldAddress(
                    NameFault(name: a.name.text))).try();
    Ok(inner);
}

// -----------------------------------------------------------------
// blocks
//
// "A block is a value too." Its value is the trailing expression
// written without a `;`; DESIGN.md also lets a `;`-terminated tail
// be the value, and the AST records only what was written, so this
// is where that is decided.
// -----------------------------------------------------------------

block_type* = (c :: Checker, id: BlockId, ctx: Ctx)
              Res<TyId, AllocError> {
    mark = c.mark();
    blk = c.tree.block_at(id);
    tail = c.walk_stmts(blk, ctx).try();
    got = blk.value.match({
        Ok(e) => c.type_of(e, ctx),
        None  => Ok(tail),
    }).try();
    c.release(mark).try();
    Ok(got);
}

// Every statement, in order, so a binding is in scope for the ones
// after it. The last statement's type is carried out because a
// `;`-terminated tail closes a function: "`0;` closes a Res<i32, E>
// function like `Ok(0);` does".
walk_stmts* = (c :: Checker, blk: Block, ctx: Ctx)
             Res<TyId, AllocError> {
    last ::= c.types.prim("()").try();
    blk.stmts.loop((h, s) {
        last = c.stmt_type(s, ctx).try();
    });
    Ok(last);
}

stmt_type* = (c :: Checker, s: Stmt, ctx: Ctx) Res<TyId, AllocError> {
    s.kind.match({
        Expr(e)  => c.type_of(e.expr, ctx),
        Bind(b)  => c.bind_stmt(b, ctx),
        Block(b) => c.block_type(b, ctx),
        Decl(_)  => c.types.prim("()"),
    })
}

// `target = value;` is its own subject and lives in `sema_place.zen`:
// a declaration and a write are one statement here, and telling them
// apart is a question about the TARGET rather than about any node.
