// src/gen/gen_c/gen_c.zen
// The C backend's whole surface, in one file of starred re-exports.
//
// A folder root is its folder's public surface and nothing else. This
// is module `gen.gen_c` — a folder carries its root beside its
// children, so it is the same module path a single `src/gen/gen_c.zen`
// would have had, and PLAN.md's line still reads correctly.
//
// IT IS A FOLDER BECAUSE THE C BACKEND HAS EIGHT SUBJECTS, and
// STYLE.md says a prefix family with two or more files has earned one:
//
//   gen_c_state    what the backend holds while it works
//   gen_c_mono     what a type parameter becomes
//   gen_c_runtime  the C every emitted program stands on
//   gen_c_type     how a Zen type is SPELLED, and which types are needed
//   gen_c_layout   what that spelling refers to: the definitions
//   gen_c_stmt     what a statement is, and where a value goes
//   gen_c_expr     what an expression is
//   gen_c_call     what a call is, and what a constructor is
//   gen_c_member   what a call through a DOT is
//   gen_c_print    `println`, the one name no module declares
//   gen_c_flow     what control flow is: `.match` and `.try()`
//   gen_c_loop     the one construct with no Zen body anywhere
//   gen_c_range    what is being walked, and what a pass hands out
//   gen_c_build    a callee that names a TYPE: the compound literal
//   gen_c_op       what an operator is: a trap, an Eq impl, or plain C
//   gen_c_inline   a callee handed a lambda, and the lambda when called
//   gen_c_settle   what such a call evaluates to
//   gen_c_ptr      the raw floor: what a Ptr member is in C
//   gen_c_handle   leaving a loop, and leaving a pass
//   gen_c_decl     what a declaration is, and what a translation unit is
//
// WHAT A CONSUMER NEEDS IS THREE NAMES. Build a backend over a parsed
// tree and a checker, emit the program rooted at a module, read the C
// and the diagnostics back off it:
//
//     be ::= alloc.CBackend(tree, alloc.Checker(tree).try()).try();
//     out ::= alloc.Emit().try();
//     be.emit_program(0, out).try();
//     be.diag_count().match({ .. });      // what it could not lower
//     out.view()                          // the translation unit
//
// The C is read back off the caller's `Emit` and the checker is HANDED
// IN rather than borrowed: both own `Vec`s, and a copy of one diverges
// from the original the first time either grows.

// the backend, and what it holds
CBackend*, LocalSlot*, Closure* = gen.gen_c.gen_c_state
unsupported*, unresolved*, untyped*, ambiguous* = gen.gen_c.gen_c_state

// what a type parameter becomes, once C has to be written for it
sub*, open*, any_open*, inst_at* = gen.gen_c.gen_c_mono
recv_inst*, settled_inst*, inst_open* = gen.gen_c.gen_c_mono
enter_tparams*, leave_tparams*, enter_struct_tparams* = gen.gen_c.gen_c_mono

// THE ENTRY POINT
emit_program*, plain_ctx*, body_ctx*, is_res* = gen.gen_c.gen_c_decl

// what a type becomes, for a caller that wants one spelling
ctype*, declarator*, spellable*, is_unit* = gen.gen_c.gen_c_type
c_prim*, is_c_integer*, is_signed*, request_type* = gen.gen_c.gen_c_type
emit_types* = gen.gen_c.gen_c_layout

// what a statement and an expression become, exported because the
// lowering files are peers and because a test that lowers one
// expression should not have to build a whole program to do it
Dest*, block*, deliver*, stmt* = gen.gen_c.gen_c_stmt
expr*, ty_of*, spills*, spills_anywhere* = gen.gen_c.gen_c_expr
lower_unary*, lower_binary*, c_op* = gen.gen_c.gen_c_op
lower_call*, signature_of* = gen.gen_c.gen_c_call
lower_match*, lower_try* = gen.gen_c.gen_c_flow
is_loop_shape*, lower_loop*, loop_result_type* = gen.gen_c.gen_c_loop
supplies_bounds*, range_impl*, range_element_type* = gen.gen_c.gen_c_range
handle_depth*, lower_handle_call* = gen.gen_c.gen_c_handle
inlines*, inline_call*, inline_method* = gen.gen_c.gen_c_inline
closure_slot*, lower_closure_call*, takes_lambda* = gen.gen_c.gen_c_inline
inline_result_type*, inline_ret* = gen.gen_c.gen_c_settle
is_ptr_member*, lower_ptr_member*, lower_null_ptr* = gen.gen_c.gen_c_ptr

// the C floor
C_STANDARD*, comment* = gen.gen_c.gen_c_runtime
