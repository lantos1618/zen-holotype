// SUPERVISION money-shot (S5, std.concurrent.pool + pool_actor). A worker AGENT runs under a supervisor
// with a Permanent restart policy. We feed it work, then a POISON message that makes it divide by zero
// (panic → the actor is marked DEAD, the worker survives). The supervisor DETECTS the death and RESTARTS
// the agent with FRESH state; subsequent work is handled by the restarted instance. This is the capstone of
// the actor/agent-OS north star: agents that crash get restarted and keep working.
//
// The shared accumulator `acc` lives OUTSIDE the actor (a malloc'd counter block reached through a pointer in
// the agent's state), so it SURVIVES the restart — the discipline "state that must outlive a crash lives
// outside the actor" (the restarted actor itself is born with fresh, zeroed instance state, proven by `seen`).
//
// TIMELINE (single agent, FIFO mailbox):
//   Phase 1: Work(10), Work(10), Poison(0), Work(10), Work(10)
//     → the two pre-poison Works run (acc == 20); Poison panics (actor DEAD); the two post-poison Works are
//       still QUEUED behind the dead actor → drained-and-FREED (backlog leak fix) and counted as DEAD LETTERS
//       (dropped == 2). at-most-once: they are DROPPED, never replayed.
//   Supervise: pool_actor_dead == true → Permanent → free the dead instance + re-run the retained spec →
//       a brand-new actor with fresh state (seen back to 0).
//   Phase 2: Work(5), Work(5) → handled by the RESTARTED instance (acc == 30, its own seen == 2).
//
// PROOF (exit 42 iff ALL hold):
//   crashed              — the poison made the agent observably DEAD (panic isolation: the pool never died).
//   acc_after_crash == 20 — only the two pre-poison Works ran.
//   dropped == 2         — the two post-poison Works were dead-lettered (backlog freed + counted, no leak).
//   restarted            — the supervisor restarted the Permanent child (restart count went up).
//   acc_after_restart==30 — the RESTARTED instance processed the phase-2 work (20 + 5 + 5).
//   fresh_seen == 2      — the restarted instance has FRESH state (it saw only its own 2 messages, not 4).
//   still_alive          — after recovery the child is alive again.
// Run under `cc -fsanitize=address` it also reports NO leak across the crash+restart: every boxed message is
// freed (delivered by the trampoline, in-flight by zenrt on panic, or as backlog by the dead-branch drain).
{ pool_open, pool_quiesce, pool_quiesce_stop, pool_close, pool_dropped, pool_actor_dead, Pool } = std.concurrent.pool
{ malloc, free } = std.mem.alloc
{ dispatch } = std.concurrent.pool_actor    // destructured: the faithful formatter accepts an unqualified generic call
pa = std.concurrent.pool_actor
{ Context, Receiver } = std.concurrent.pool_actor
WORKERS := 2
CAP := 64
Msg*: Work(i64) | Poison(i64)
Agent*: {
    acc: RawPtr<u8>,
    seen: i64,
}
Agent.impl(Receiver, {
    receive = (a: MutPtr<Agent>, ctx: Context<Msg>) void {
        ctx.msg.match ({
            .Work(n)   => {
                atomic_add_i64(a.acc, n)
                a.seen = a.seen + 1
            },
            .Poison(d) => {
                boom := 100 / d    // d == 0 → integer divide by zero → PANIC; the worker catches it, marks the actor dead
                atomic_add_i64(a.acc, boom)
            },
        })
    }
})    // Poison's body is unreached past the divide
tramp = (user: RawPtr<u8>, msg: i64) void { dispatch<Agent, Msg>(user, msg) }
main = () i32 {
    acc := malloc(8)
    store_i64(acc, 0)
    spec := pa.child_spec(CAP, Agent(
        acc: acc,
        seen: 0,
    ), tramp, pa.permanent())
    child0 := pa.start_child(spec)
    p := pool_open(WORKERS, 16)
    // Phase 1: work, crash, then work that queues behind the dead actor.
    p.send(child0.handle, Msg.Work(10))
    p.send(child0.handle, Msg.Work(10))
    p.send(child0.handle, Msg.Poison(0))
    p.send(child0.handle, Msg.Work(10))
    p.send(child0.handle, Msg.Work(10))
    p.pool_quiesce()    // let the batch settle WITHOUT stopping the pool
    crashed := pool_actor_dead(child0.handle.raw)
    acc_after_crash := load_i64(acc)
    dropped := p.pool_dropped()
    // Supervisor detects the dead child and RESTARTS it (Permanent) with fresh state.
    child1 := child0.supervise()
    restarted := child1.restarts > child0.restarts
    // Phase 2: the restarted instance handles subsequent work.
    p.send(child1.handle, Msg.Work(5))
    p.send(child1.handle, Msg.Work(5))
    p.pool_quiesce()
    acc_after_restart := load_i64(acc)
    fresh_seen := pa.actor_state(child1.handle).seen
    still_alive := pool_actor_dead(child1.handle.raw) == false
    p.pool_quiesce_stop()
    pa.close(child1.handle)
    p.pool_close()
    free(acc)
    ok := crashed
        && acc_after_crash == 20
        && dropped == 2
        && restarted
        && acc_after_restart == 30
        && fresh_seen == 2
        && still_alive
    ok ? 42 : 1
}
