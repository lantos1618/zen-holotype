// Storage kernel shared by growable containers.
// Prefixed functions avoid adding generic names to the flat dispatch surface.
{ AllocatorBackend, Allocator } = std.mem.alloc
{ Result, IoError, ok, err } = std.core.result
{ loop_at } = std.core.count
Buffer*<T>: {
    ptr: RawPtr<u8>,
    len: i64,
    cap: i64,
    carried: bool,
    oom: bool,
    alloc: Allocator,
}
BufferFixed*<T>: {
    ptr: RawPtr<u8>,
    len: i64,
    alloc: Allocator,
}
BufferConst*<T>: {
    ptr: RawPtr<u8>,
    len: i64,
    alloc: Allocator,
}
buffer_live*<T> = (b: Buffer<T>) bool { b.carried && b.oom == false }
// Preserve the birth allocator; failure makes OOM sticky for one final release.
buffer_settle*<T> = (b: Buffer<T>, r: Result<Buffer<T>, IoError>) Buffer<T> {
    r.match ({
        .Ok(g)  => Buffer<T>(
            ptr: g.ptr,
            len: g.len,
            cap: g.cap,
            carried: true,
            oom: false,
            alloc: b.alloc,
        ),
        .Err(e) => Buffer<T>(
            ptr: b.ptr,
            len: b.len,
            cap: b.cap,
            carried: b.carried,
            oom: true,
            alloc: b.alloc,
        ),
    })
}
buffer_drop*<T> = (b: Buffer<T>) void {
    d = b.alloc
    b.carried.then({
        d.addr().release(b.ptr)
    })
}
// Empty frozen buffers retain one byte to avoid allocator-specific zero-size resize behavior.
buffer_freeze*<T> = (b: Buffer<T>) Result<BufferConst<T>, IoError> {
    d = b.alloc
    b.buffer_live().match ({
        true  => d.addr().try_resize(b.ptr, (b.len < 1).then({ 1 }, { b.len * sizeof(T) })).match ({
            .Ok(p)  => ok(BufferConst<T>(
                ptr: p,
                len: b.len,
                alloc: b.alloc,
            )),
            .Err(e) => {
                b.buffer_drop()
                err(e)
            },
        }),
        false => {
            b.buffer_drop()
            err(.NotFound)
        },
    })
}
// Capacity is in elements; allocator requests are in bytes.
buffer_reserve*<T> = (a: AllocatorBackend, b: Buffer<T>, need: i64) Result<Buffer<T>, IoError> {
    b = b
    (b.len + need <= b.cap).match ({
        true  => {
            out: Result<Buffer<T>, IoError> = .Ok(b)
            out
        },
        false => {
            ncap = (b.cap + need) * 2
            a.try_resize(b.ptr, ncap * sizeof(T)).match ({
                .Ok(p)  => {
                    out: Result<Buffer<T>, IoError> = .Ok(Buffer<T>(
                        ptr: p,
                        len: b.len,
                        cap: ncap,
                        carried: b.carried,
                        oom: b.oom,
                        alloc: b.alloc,
                    ))
                    out
                },
                .Err(e) => {
                    out: Result<Buffer<T>, IoError> = .Err(e)
                    out
                },
            })
        },
    })
}
// If xs aliases b, preserve its offset and rebase it after a moving resize.
// A valid self-view ends before the append destination, so forward copy is safe.
buffer_extend*<T> = (
    a: AllocatorBackend,
    b: Buffer<T>,
    xs: Slice<T>,
    spare: i64,
) Result<Buffer<T>, IoError> {
    xs = xs
    base = to_i64(b.ptr)
    src = to_i64(xs.ptr)
    bytes = b.cap * sizeof(T)
    internal = src >= base && src < base + bytes
    source_off = src - base
    a.buffer_reserve(b, xs.len + spare).match ({
        .Ok(r)  => {
            source: Slice<T> = internal.then({ slice(r.ptr.offset(source_off), xs.len) }, { xs })
            dst :: MutSlice<T> = slice(r.ptr, r.cap)
            source.loop_at((i, x) { dst[r.len + i] = x })
            out: Result<Buffer<T>, IoError> = .Ok(Buffer<T>(
                ptr: r.ptr,
                len: r.len + source.len,
                cap: r.cap,
                carried: r.carried,
                oom: r.oom,
                alloc: r.alloc,
            ))
            out
        },
        .Err(e) => {
            out: Result<Buffer<T>, IoError> = .Err(e)
            out
        },
    })
}
// Carrying constructor: allocation failure is recorded in the header and settles at freeze.
buffer_new*<T> = (a: Allocator, cap: i64) Buffer<T> {
    d = a
    d.addr().try_acquire(cap * sizeof(T)).match ({
        .Ok(p)  => Buffer<T>(
            ptr: p,
            len: 0,
            cap: cap,
            carried: true,
            oom: false,
            alloc: a,
        ),
        .Err(e) => Buffer<T>(
            ptr: null_ptr(),
            len: 0,
            cap: 0,
            carried: true,
            oom: true,
            alloc: a,
        ),
    })
}
buffer_fixed*<T> = (a: Allocator, n: i64) Result<BufferFixed<T>, IoError> {
    d = a
    d.addr().try_acquire(n * sizeof(T)).match ({
        .Ok(p)  => {
            out: Result<BufferFixed<T>, IoError> = .Ok(BufferFixed<T>(
                ptr: p,
                len: n,
                alloc: a,
            ))
            out
        },
        .Err(e) => {
            out: Result<BufferFixed<T>, IoError> = .Err(e)
            out
        },
    })
}
buffer_fixed_drop*<T> = (b: BufferFixed<T>) void {
    d = b.alloc
    d.addr().release(b.ptr)
}
buffer_const_drop*<T> = (b: BufferConst<T>) void {
    d = b.alloc
    d.addr().release(b.ptr)
}
