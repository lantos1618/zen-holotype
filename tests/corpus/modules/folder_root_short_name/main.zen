// DESIGN.md: `src/gen/gen.zen` is module `gen`. So a folder root is
// named by a single identifier, and importing several names from one
// is a bare RHS binding a comma list.
//
// cst.py dispatched a declaration on the SHAPE of its right-hand side:
// a dotted RHS was an import, a bare identifier was an alias. So this
// line became `Alias Kind = leaf` and Pos and origin were dropped on
// the floor with no diagnostic. The multi-name guard already accepted
// the shape; only the dispatch disagreed.
Kind, Pos, origin = leaf

main = (env: Env) Res<i32, ArgError> {
    p = origin();
    println("{}", p.line);
    Kind.One.match({ One => println("one"), Two => println("two") });
    Ok(0);
}
