// `Ok` and `Err` carry one value each. A second argument had no seat and
// no reader: gen evaluated the string and emitted `{ tag, value: 41 }`,
// so `Ok(41, "x")` was an `Ok(41)` that read "x" for nothing.
// position: the second argument.

main = (env: Env) Res<i32, AllocError> {
    r: Res<i32, AllocError> = Ok(41, "x");
    r.match({
        Ok(n)  => println("{}", n),
        Err(_) => println("e"),
    });
    Ok(0);
}
