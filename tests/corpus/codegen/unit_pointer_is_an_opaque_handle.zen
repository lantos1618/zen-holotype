// Ptr<()> remains useful as a null, pass-through, and reinterpreted handle.

free = (p: Ptr<()>) ()
hold = (p: Ptr<()>) Ptr<()> { p }

count = () usize {
    println("count");
    3
}

main = (env: Env) Res<i32, AllocError> {
    p = hold(null_ptr<()>());
    q = p.to<u8>().to<()>();
    println("bytes {}", p.bytes(count()));
    q.copy_from(p, count());
    free(q);
    println("{} {}", p.is_null(), q.is_null());
    Ok(0)
}
