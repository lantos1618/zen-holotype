//! link: c
// @self-hosted-only: stackful coroutines over glibc x86-64 ucontext.
// Public code should checkpoint through Runtime.checkpoint; this module is substrate.
{ AllocatorBackend } = std.mem.alloc
{ Result, IoError, ok, err } = std.core.result
{ is_null } = std.core.ptr
getcontext = (ctx: RawPtr<u8>) i32
makecontext = (ctx: RawPtr<u8>, fn: () void, argc: i32) void
swapcontext = (out: RawPtr<u8>, inc: RawPtr<u8>) i32
// ucontext_t is opaque to Zen for now, so these are named glibc x86-64 ABI offsets.
UC_LINK_OFF = 8
UC_SS_SP_OFF = 16
UC_SS_SIZE_OFF = 32
UC_CTX_SIZE = 1024
CORO_STACK = 65536
// Per-OS-thread swap state: each worker thread has its OWN current/back/flag so concurrent
// resume()/checkpoint on different threads can't stomp each other (multi-threaded scheduler).
// PREFIXED names: Zen's namespace is flat and const-by-default makes a bare `x = v` an ASSIGNMENT
// whenever `x` names a module global, so short global names like `cur`/`back`/`flag` would silently
// claim those words tree-wide — `cur = state[0]` in std.concurrent.actor stopped being a binding.
coro_cur ::= thread_local(null_ptr())
coro_back ::= thread_local(null_ptr())
coro_flag ::= thread_local(0)
CoroState: {
    ctx: RawPtr<u8>,
    link: RawPtr<u8>,
    stack: RawPtr<u8>,
}
Coro*: {
    state: RawPtr<u8>,
    coro_state = (c: Coro) MutSlice<CoroState> { c.state.slice(1) }
    resume = (c: Coro) i32 {
        cur_state = c.coro_state()[0]
        coro_cur = cur_state.ctx
        coro_back = cur_state.link
        coro_flag = 0
        swapcontext(cur_state.link, cur_state.ctx)
        coro_cur = null_ptr()
        coro_flag
    }
}
init_context = (ctx: RawPtr<u8>, stack: RawPtr<u8>, link: RawPtr<u8>) void {
    ctx.offset(UC_SS_SP_OFF).store_i64(stack)
    ctx.offset(UC_SS_SIZE_OFF).store_i64(CORO_STACK)
    ctx.offset(UC_LINK_OFF).store_i64(link)
}
spawn_cleanup = (
    alloc: AllocatorBackend,
    stack: RawPtr<u8>,
    ctx: RawPtr<u8>,
    lnk: RawPtr<u8>,
    e: IoError,
) Result<Coro, IoError> {
    (stack.is_null() == false).then({
        alloc.release(stack)
    })
    (ctx.is_null() == false).then({
        alloc.release(ctx)
    })
    (lnk.is_null() == false).then({
        alloc.release(lnk)
    })
    err(e)
}
finish_spawn = (
    ctx: RawPtr<u8>,
    stack: RawPtr<u8>,
    lnk: RawPtr<u8>,
    state: RawPtr<u8>,
    work: () void,
) Result<Coro, IoError> {
    getcontext(ctx)
    ctx.init_context(stack, lnk)
    makecontext(ctx, work, 0)
    slot :: MutSlice<CoroState> = state.slice(1)
    slot[0] = CoroState(
        ctx: ctx,
        link: lnk,
        stack: stack,
    )
    ok(Coro(state: state))
}
spawn_with_link = (
    alloc: AllocatorBackend,
    work: () void,
    stack: RawPtr<u8>,
    ctx: RawPtr<u8>,
    lnk: RawPtr<u8>,
) Result<Coro, IoError> {
    alloc.try_acquire(sizeof(CoroState)).match ({
        .Ok(state) => finish_spawn(ctx, stack, lnk, state, work),
        .Err(e)    => alloc.spawn_cleanup(stack, ctx, lnk, e),
    })
}
spawn_with_ctx = (
    alloc: AllocatorBackend,
    work: () void,
    stack: RawPtr<u8>,
    ctx: RawPtr<u8>,
) Result<Coro, IoError> {
    alloc.try_acquire(UC_CTX_SIZE).match ({
        .Ok(lnk) => alloc.spawn_with_link(work, stack, ctx, lnk),
        .Err(e)  => alloc.spawn_cleanup(stack, ctx, null_ptr(), e),
    })
}
spawn_with_stack = (
    alloc: AllocatorBackend,
    work: () void,
    stack: RawPtr<u8>,
) Result<Coro, IoError> {
    alloc.try_acquire(UC_CTX_SIZE).match ({
        .Ok(ctx) => alloc.spawn_with_ctx(work, stack, ctx),
        .Err(e)  => alloc.spawn_cleanup(stack, null_ptr(), null_ptr(), e),
    })
}
spawn_in* = (alloc: AllocatorBackend, work: () void) Result<Coro, IoError> {
    alloc.try_acquire(CORO_STACK).match ({
        .Ok(stack) => alloc.spawn_with_stack(work, stack),
        .Err(e)    => err(e),
    })
}
spawn* = (alloc: AllocatorBackend, work: () void) Result<Coro, IoError> { alloc.spawn_in(work) }
destroy_in = (alloc: AllocatorBackend, c: Coro) void {
    state = c.coro_state()
    cur_state = state[0]
    alloc.release(cur_state.stack)
    alloc.release(cur_state.ctx)
    alloc.release(cur_state.link)
    alloc.release(c.state)
}
destroy* = (alloc: AllocatorBackend, c: Coro) void { alloc.destroy_in(c) }
checkpoint_current* = () void {
    (is_null(coro_cur) == false).then({
        coro_flag = 1
        swapcontext(coro_cur, coro_back)
    })
}
