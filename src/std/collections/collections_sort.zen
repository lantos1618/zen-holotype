// src/std/collections/collections_sort.zen
// insertion sort, in place, over a Vec<T> — std's one sort. "std has no
// sort" was true until two modules hand-copied the same 58 tokens
// (`lsp_compl.zen`'s `sort_items`, `lsp_colour.zen`'s `sort_classes`):
// the second copy is what moved it here, per STYLE.md's second-caller
// rule.
//
// The order is a trait and not a function parameter: Map takes `K: Eq +
// Hash` the same way, and the backend cannot yet carry a function value
// through a generic's helpers (the defect `std.core.eq`'s `is_in`
// records) — so the comparator rides the bound, where dispatch is
// proven.
//
// ONE BODY, NO HELPERS is not an option either: the same backend limit
// breaks a generic that reaches another generic through a lambda, which
// is why the bubble keeps its own named pass below.

Vec        = std.collections.collections_vec
Range      = std.core.range
AllocError = std.mem

// An element a sort can sequence. Strictly-before, so equal elements
// never compare true — that is what makes the insertion sort below
// STABLE, and a caller's ties keep their input order.
Ordered* = {
    before* = (self: @Self, other: @Self) bool
}

// Sorts `xs` ascending by `before`, in place.
sort*<T: Ordered> = (xs :: Vec<T>) Res<(), AllocError> {
    Range(1, xs.len).loop((h, i) { xs.sink(i).try(); });
    Ok(());
}

// Swap `xs[at]` left past every predecessor that sorts after it.
sink<T> = (xs :: Vec<T>, at: usize) Res<(), AllocError> {
    j ::= at;
    loop(() { j > 0 && xs.out_of_order(j) }, (h) {
        xs.swap_at(j).try();
        j = j - 1;
    });
    Ok(());
}

out_of_order<T> = (xs: Vec<T>, j: usize) bool {
    xs.get(j - 1).match({
        None    => false,
        Ok(lft) => xs.get(j).match({
            None    => false,
            Ok(rgt) => rgt.before(lft),
        }),
    })
}

swap_at<T> = (xs :: Vec<T>, j: usize) Res<(), AllocError> {
    xs.get(j).match({
        None    => Ok(()),
        Ok(rgt) => xs.get(j - 1).match({
            None    => Ok(()),
            Ok(lft) => xs.swap_pair(j, lft, rgt),
        }),
    })
}

swap_pair<T> = (xs :: Vec<T>, j: usize, lft: T, rgt: T) Res<(), AllocError> {
    xs.set(j - 1, rgt).match({ Ok(_) => (), None => () });
    xs.set(j, lft).match({ Ok(_) => (), None => () });
    Ok(());
}
