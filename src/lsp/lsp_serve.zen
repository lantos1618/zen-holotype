// Owns LSP session state and routes one decoded JSON-RPC message at a time.
// Full-sync document contents are retained as an in-memory build overlay.

str, String = std.text
Vec, Map = std.collections
Range = std.core
Alloc, AllocError, Arena = std.mem
Checker = sema.sema_check
Jsons, JsonId, written, read = std.json
FrameFault, frame_at, write_frame = lsp.lsp_frame
Hover, hover_at, hover_in, hover_with = lsp.lsp_hover
definition_at, definition_in, definition_with = lsp.lsp_def
Sym, symbols_at, write_symbols = lsp.lsp_symbol
write_edits = lsp.lsp_fmt
Item, MemberCache, complete_at, complete_shared = lsp.lsp_compl
sort_items, write_items = lsp.lsp_compl
write_tokens = lsp.lsp_colour
Diagnostics, Shared = lsp.lsp_diag
write_actions = lsp.lsp_action
relative_to = zen.zen_path
method_of, param, string_at = lsp.lsp_reply
DecodedRequest, RequestTurn = lsp.lsp_reply
write_hover, write_target = lsp.lsp_reply
write_capabilities = lsp.lsp_reply
RpcFault, own_str = lsp.lsp_reply
request_of = lsp.lsp_reply
path_of = lsp.lsp_uri

Server* = {
    a: Alloc,

    env: Env,

    docs_arena :: Arena,

    workspace :: str = "",

    docs :: Map<str, str>,

    open :: Vec<str>,

    notes :: Diagnostics,

    members :: MemberCache,

    ready :: bool,
    stopping :: bool,

    stopped* = (self: @Self) bool { self.stopping }

    completion_builds* = (self: @Self) usize { self.members.builds }

    one* = (self :: @Self, t: Alloc, body: str, out :: String)
           Res<(), AllocError> {
        tree ::= t.Jsons();
        turn ::= t.RequestTurn().try();
        read(t, tree, body).match({
            Err(f)  => turn.parse_error(f),
            Ok(req) => self.route(tree, req, turn),
        }).try();
        turn.is_empty().match({
            true  => written(),
            false => write_frame(turn.view(), out),
        })
    }

    route = (self :: @Self, tree: Jsons, req: JsonId, turn :: RequestTurn)
            Res<(), AllocError> {
        method = method_of(tree, req);
        tree.field(req, "id").match({
            None    => self.notified(tree, req, method),
            Ok(rid) => self.requested(DecodedRequest(tree, req, rid), turn),
        })
    }

    requested = (self :: @Self, request: DecodedRequest, turn :: RequestTurn)
                Res<(), AllocError> {
        method = request.method();
        (self.ready || method.eq("initialize")).match({
            false => turn.failed(
                request,
                RpcFault.NotInitialized,
                "the server has not been initialized"
            ),
            true  => self.answered(request, turn),
        })
    }

    answered = (self :: @Self, request: DecodedRequest, turn :: RequestTurn)
               Res<(), AllocError> {
        method = request.method();
        request_of(method).match({
            Initialize => self.initialized(request, turn),
            Shutdown   => {
                self.stopping = true;
                turn.result(request, "null")
            },
            Hover      => self.hovered(request, turn),
            Definition => self.defined(request, turn),
            Outline    => self.outlined(request, turn),
            Completion => self.completed(request, turn),
            Colour     => self.coloured(request, turn),
            Format     => self.formatted(request, turn),
            Action     => self.acted(request, turn),
            Unknown    => self.unknown(request, turn),
        })
    }

    initialized = (self :: @Self, request: DecodedRequest,
                   turn :: RequestTurn) Res<(), AllocError> {
        self.members.invalidate();
        self.ready     = true;
        self.workspace = own_str(
            self.a,
            path_of(request.string_at(request.params(), "rootUri"))
        ).try();
        caps ::= turn.alloc().String().try();
        write_capabilities(caps).try();
        turn.result(request, caps.view())
    }

    unknown = (self :: @Self, request: DecodedRequest,
               turn :: RequestTurn) Res<(), AllocError> {
        why ::= turn.alloc().String().try();
        why.add("method not found: ").try();
        why.add(request.method()).try();
        turn.failed(request, RpcFault.MethodNotFound, why.view())
    }

    notified = (self :: @Self, tree: Jsons, req: JsonId, method: str)
               Res<(), AllocError> {
        handled: Res<Res<(), AllocError>> = loop<Res<(), AllocError>>((h) {
            method.eq("textDocument/didOpen").then(() {
                h.break(self.opened(tree, req))
            });
            method.eq("textDocument/didChange").then(() {
                h.break(self.changed(tree, req))
            });
            method.eq("textDocument/didClose").then(() {
                h.break(self.closed(tree, req))
            });
            method.eq("workspace/didChangeWatchedFiles").then(() {
                h.break(self.watched(tree, req))
            });
            h.break(written());
        });
        handled.match({ Ok(done) => done, None => written() })
    }

    watched = (self :: @Self, tree: Jsons, req: JsonId)
              Res<(), AllocError> {
        changes = param(tree, req, "changes");
        i     ::= 0;
        stale ::= false;
        more  ::= true;
        loop(more, (h) {
            tree.item(changes, i).match({
                None       => { more = false; },
                Ok(change) => {
                    uri = string_at(tree, change, "uri");
                    self.docs.get(uri).match({
                        None  => { stale = true; },
                        Ok(_) => (),
                    });
                    i = i + 1;
                },
            });
        });
        (stale && self.open.len > 0).match({
            false => written(),
            true  => self.open.get(self.open.len - 1).match({
                None      => written(),
                Ok(entry) => {
                    self.members.invalidate();
                    self.notes.stales(entry);
                    Ok(())
                },
            }),
        })
    }

    opened = (self :: @Self, tree: Jsons, req: JsonId) Res<(), AllocError> {
        doc = param(tree, req, "textDocument");
        self.remember(string_at(tree, doc, "uri"), string_at(tree, doc, "text"))
    }

    changed = (self :: @Self, tree: Jsons, req: JsonId) Res<(), AllocError> {
        uri   = string_at(tree, param(tree, req, "textDocument"), "uri");
        edits = param(tree, req, "contentChanges");
        text  = tree.item(edits, 0).match({
            None    => "",
            Ok(one) => string_at(tree, one, "text"),
        });
        self.remember(uri, text)
    }

    closed = (self :: @Self, tree: Jsons, req: JsonId)
             Res<(), AllocError> {
        doc = param(tree, req, "textDocument");
        uri = string_at(tree, doc, "uri");
        self.docs.get(uri).match({
            None  => written(),
            Ok(_) => self.forget(uri),
        })
    }

    forget = (self :: @Self, uri: str) Res<(), AllocError> {
        stable = own_str(self.a, uri).try();
        self.members.invalidate();
        self.replace_docs(uri, None).try();
        Range(0, self.open.len).find((i) {
            self.open.get(i).match({ None => false, Ok(u) => u.eq(uri) })
        }).match({
            None   => (),
            Ok(at) => { self.open.take(at); },
        });
        next = (self.open.len == 0).match({
            true  => "",
            false => self.open.get(self.open.len - 1).match({
                None => "", Ok(u) => u
            }),
        });
        self.notes.closed(stable, next)
    }

    remember = (self :: @Self, uri: str, text: str) Res<(), AllocError> {
        uri.is_empty().match({
            true  => written(),
            false => self.stored(uri, text),
        })
    }

    stored = (self :: @Self, uri: str, text: str) Res<(), AllocError> {
        self.docs.get(uri).match({
            None     => self.changed_to(uri, text),
            Ok(held) => held.eq(text).match({
                true  => written(),
                false => self.changed_to(uri, text),
            }),
        })
    }

    changed_to = (self :: @Self, uri: str, text: str) Res<(), AllocError> {
        stable = self.listed(uri).try();
        self.replace_docs(uri, Ok(text)).try();
        self.notes.owes(stable);
        Ok(());
    }

    listed = (self :: @Self, uri: str) Res<str, AllocError> {
        self.open.find((u) { u.eq(uri) }).match({
            Ok(found) => Ok(found),
            None      => {
                kept = own_str(self.a, uri).try();
                self.open.add(kept).try();
                Ok(kept)
            },
        })
    }

    replace_docs = (self :: @Self, uri: str, text: Res<str>)
                   Res<(), AllocError> {
        fresh_arena ::= self.env.mem.alloc();
        fresh       ::= fresh_arena.Map<str, str>();
        self.docs.pairs((h, key, value) {
            key.eq(uri).match({
                true  => written(),
                false => fresh.set(
                    own_str(fresh_arena, key).try(),
                    own_str(fresh_arena, value).try()
                ),
            }).try();
        });
        text.match({
            None        => written(),
            Ok(replace) => fresh.set(
                own_str(fresh_arena, uri).try(),
                own_str(fresh_arena, replace).try()
            ),
        }).try();
        self.docs_arena.drop();
        self.docs_arena = consume fresh_arena;
        self.docs       = fresh;
        Ok(())
    }

    settled* = (self :: @Self, t: Alloc, out :: String) Res<(), AllocError> {
        self.stopping.match({
            true  => written(),
            false => self.notes.settled(
                self.env,
                self.workspace,
                self.open,
                self.docs,
                t,
                out
            ),
        })
    }

    unopened = (self :: @Self, request: DecodedRequest,
                turn :: RequestTurn)
               Res<(), AllocError> {
        turn.failed(
            request,
            RpcFault.InvalidParams,
            "no open document for that uri"
        )
    }

    hovered = (self :: @Self, request: DecodedRequest, turn :: RequestTurn)
              Res<(), AllocError> {
        t         = turn.alloc();
        uri       = request.string_at(request.param("textDocument"), "uri");
        where     = request.param("position");
        line      = request.number_at(where, "line");
        character = request.number_at(where, "character");
        self.docs.get(uri).match({
            None     => self.unopened(request, turn),
            Ok(text) => {
                body ::= t.String().try();
                self.workspace.is_empty().match({
                    true  => {
                        qa ::= self.env.mem.alloc();
                        self.write_hovered(
                            qa,
                            hover_at(qa, uri, text, line, character).try(),
                            body
                        )
                    },
                    false => self.shared_hover(
                        t,
                        uri,
                        text,
                        line,
                        character,
                        body
                    ),
                }).try();
                turn.result(request, body.view())
            },
        })
    }

    coloured = (self :: @Self, request: DecodedRequest,
                turn :: RequestTurn) Res<(), AllocError> {
        t   = turn.alloc();
        uri = request.string_at(request.param("textDocument"), "uri");
        self.docs.get(uri).match({
            None     => self.unopened(request, turn),
            Ok(text) => {
                body ::= t.String().try();
                names = self.notes.classes_for(t, uri).try();
                write_tokens(t, uri, text, names, body).try();
                turn.result(request, body.view())
            },
        })
    }

    build_for = (self :: @Self, path: str, t: Alloc) Res<Shared, AllocError> {
        self.notes.shared(
            self.env,
            self.workspace,
            self.open,
            self.docs,
            path,
            t
        )
    }

    shared_hover = (self :: @Self, t: Alloc, uri: str, text: str,
                    line: usize, character: usize, body :: String)
                   Res<(), AllocError> {
        path = path_of(uri);
        sh   = self.build_for(path, t).try();
        sh.c.match({
            None  => {
                qa ::= self.env.mem.alloc();
                self.write_hovered(
                    qa,
                    hover_in(
                        self.env,
                        qa,
                        self.workspace,
                        path,
                        text,
                        line,
                        character
                    ).try(),
                    body
                )
            },
            Ok(c) => self.write_hovered(
                t,
                hover_with(
                    c,
                    t,
                    relative_to(sh.root, path),
                    text,
                    line,
                    character
                ).try(),
                body
            ),
        })
    }

    write_hovered = (self :: @Self, a: Alloc, h: Hover, body :: String)
                    Res<(), AllocError> {
        h.found.match({
            false => body.add("null"),
            true  => write_hover(a, h, body),
        })
    }

    defined = (self :: @Self, request: DecodedRequest, turn :: RequestTurn)
              Res<(), AllocError> {
        t         = turn.alloc();
        uri       = request.string_at(request.param("textDocument"), "uri");
        where     = request.param("position");
        line      = request.number_at(where, "line");
        character = request.number_at(where, "character");
        self.docs.get(uri).match({
            None     => self.unopened(request, turn),
            Ok(text) => {
                body ::= t.String().try();
                self.workspace.is_empty().match({
                    true  => {
                        qa ::= self.env.mem.alloc();
                        write_target(
                            qa,
                            definition_at(qa, uri, text, line, character).try(),
                            body
                        )
                    },
                    false => self.write_definition(
                        t,
                        uri,
                        text,
                        line,
                        character,
                        body
                    ),
                }).try();
                turn.result(request, body.view())
            },
        })
    }

    write_definition = (self :: @Self, t: Alloc, uri: str, text: str,
                        line: usize, character: usize, body :: String)
                       Res<(), AllocError> {
        path = path_of(uri);
        sh   = self.build_for(path, t).try();
        sh.c.match({
            None  => {
                qa ::= self.env.mem.alloc();
                write_target(
                    qa,
                    definition_in(
                        self.env,
                        qa,
                        self.workspace,
                        path,
                        uri,
                        text,
                        line,
                        character
                    ).try(),
                    body
                )
            },
            Ok(c) => write_target(
                t,
                definition_with(
                    self.env,
                    c,
                    t,
                    sh.root,
                    self.docs,
                    uri,
                    text,
                    relative_to(sh.root, path),
                    line,
                    character
                ).try(),
                body
            ),
        })
    }

    outlined = (self :: @Self, request: DecodedRequest,
                turn :: RequestTurn) Res<(), AllocError> {
        t   = turn.alloc();
        uri = request.string_at(request.param("textDocument"), "uri");
        self.docs.get(uri).match({
            None     => self.unopened(request, turn),
            Ok(text) => {
                syms ::= t.Vec<Sym>();
                symbols_at(t, text, syms).try();
                body ::= t.String().try();
                write_symbols(t, uri, text, syms, body).try();
                turn.result(request, body.view())
            },
        })
    }

    formatted = (self :: @Self, request: DecodedRequest,
                 turn :: RequestTurn) Res<(), AllocError> {
        t   = turn.alloc();
        uri = request.string_at(request.param("textDocument"), "uri");
        self.docs.get(uri).match({
            None     => self.unopened(request, turn),
            Ok(text) => {
                body ::= t.String().try();
                write_edits(t, text, body).try();
                turn.result(request, body.view())
            },
        })
    }

    acted = (self :: @Self, request: DecodedRequest, turn :: RequestTurn)
            Res<(), AllocError> {
        t     = turn.alloc();
        uri   = request.string_at(request.param("textDocument"), "uri");
        range = request.param("range");
        first = request.field_at(range, "start");
        last  = request.field_at(range, "end");
        self.docs.get(uri).match({
            None     => self.unopened(request, turn),
            Ok(text) => {
                body ::= t.String().try();
                self.workspace.is_empty().match({
                    true  => body.add("[]"),
                    false => self.shared_actions(
                        t,
                        uri,
                        text,
                        request.number_at(first, "line"),
                        request.number_at(first, "character"),
                        request.number_at(last, "line"),
                        request.number_at(last, "character"),
                        body
                    ),
                }).try();
                turn.result(request, body.view())
            },
        })
    }

    shared_actions = (self :: @Self, t: Alloc, uri: str, text: str,
                      sl: usize, sc: usize, el: usize, ec: usize,
                      body :: String) Res<(), AllocError> {
        path = path_of(uri);
        sh   = self.build_for(path, t).try();
        sh.c.match({
            None  => body.add("[]"),
            Ok(c) => write_actions(
                c,
                t,
                relative_to(sh.root, path),
                text,
                uri,
                sl,
                sc,
                el,
                ec,
                body
            ),
        })
    }

    completed = (self :: @Self, request: DecodedRequest,
                 turn :: RequestTurn) Res<(), AllocError> {
        t         = turn.alloc();
        uri       = request.string_at(request.param("textDocument"), "uri");
        where     = request.param("position");
        line      = request.number_at(where, "line");
        character = request.number_at(where, "character");
        self.docs.get(uri).match({
            None     => self.unopened(request, turn),
            Ok(text) => {
                body ::= t.String().try();
                self.workspace.is_empty().match({
                    true  => {
                        qa    ::= self.env.mem.alloc();
                        items ::= qa.Vec<Item>();
                        cached = self.members.complete(
                            self.env,
                            qa,
                            self.workspace,
                            path_of(uri),
                            text,
                            line,
                            character,
                            items
                        ).try();
                        (!cached).then(() {
                            complete_at(qa, text, line, character, items).try();
                        });
                        sort_items(items);
                        write_items(qa, items, body)
                    },
                    false => self.write_completion(
                        t,
                        uri,
                        text,
                        line,
                        character,
                        body
                    ),
                }).try();
                turn.result(request, body.view())
            },
        })
    }

    write_completion = (self :: @Self, t: Alloc, uri: str, text: str,
                        line: usize, character: usize, body :: String)
                       Res<(), AllocError> {
        path = path_of(uri);
        sh   = self.build_for(path, t).try();
        done = sh.c.match({
            None  => false,
            Ok(c) => self.shared_completion(
                c,
                t,
                sh.root,
                path,
                text,
                line,
                character,
                body
            ).try(),
        });
        done.match({
            true  => written(),
            false => self.patched_completion(
                t,
                path,
                text,
                line,
                character,
                body
            ),
        })
    }

    shared_completion = (self :: @Self, c: Checker, t: Alloc, root: str,
                         path: str, text: str, line: usize, character: usize,
                         body :: String) Res<bool, AllocError> {
        items ::= t.Vec<Item>();
        done = complete_shared(
            c,
            t,
            relative_to(root, path),
            text,
            line,
            character,
            items
        ).try();
        done.match({
            false => written(),
            true  => {
                sort_items(items);
                write_items(t, items, body)
            },
        }).try();
        Ok(done);
    }

    patched_completion = (self :: @Self, t: Alloc, path: str, text: str,
                          line: usize, character: usize, body :: String)
                         Res<(), AllocError> {
        items ::= t.Vec<Item>();
        self.members.complete(
            self.env,
            t,
            self.workspace,
            path,
            text,
            line,
            character,
            items
        ).try();
        sort_items(items);
        write_items(t, items, body)
    }
}

Server.impl(Drop, {
    drop = (self :: @Self) () {
        self.members.drop();
        self.notes.drop();
        self.docs_arena.drop();
    }
})

Server* = (a: Alloc, env: Env) Server {
    docs_arena ::= env.mem.alloc();
    server_with_docs(a, env, consume docs_arena)
}

server_with_docs = (a: Alloc, env: Env, docs_arena :: Arena) Server {
    docs = docs_arena.Map<str, str>();
    Server(
        a: a,
        env: env,
        docs_arena: consume docs_arena,
        docs: docs,
        open: a.Vec<str>(),
        notes: a.Diagnostics(env),
        members: env.MemberCache(),
        ready: false,
        stopping: false
    )
}

serve* = (s :: Server, input: str, out :: String) Res<(), AllocError> {
    at    ::= 0;
    going ::= true;
    loop(() { going && at < input.len }, (h) {
        frame_at(input, at).match({
            Err(f) => { going = false; frame_fault(f, out).try(); },
            Ok(fr) => { at = fr.next; s.one(s.a, fr.body, out).try(); },
        });
    });
    s.settled(s.a, out)
}

frame_fault = (f: FrameFault, out :: String) Res<(), AllocError> {
    out.add("lsp: bad frame at byte ").try();
    out.write_usize(f.byte()).try();
    out.add(" (").try();
    out.add(f.why()).try();
    out.add(")\n")
}
