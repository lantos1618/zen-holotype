{ String } = std.text.string
{ is_empty } = std.text.str
{ Expr, Stmt, ArmData, BinData, CallData, CondData, MatchData, MemberData, MakeStructData,
  MakeEnumData, SliceData, IndexData, LoopData, BlockData, IfData } = compiler.ast.ast_types
{ ty_cname_in, blk_diverges, field, subword_ty } = compiler.genc
{ Allocator } = std.mem.alloc
{ gen_strlit } = compiler.backend.c.c_lit
{ slx_arg_is_borrowed } = compiler.backend.c.c_escape
{ lit_chain_is, lit_chain_subj, lit_subj_key, slice_count } = compiler.astops
{ loop_at } = std.core.count
// Active literal-match subject during recursive emission (address identity, 0 when inactive).
c_lit_active ::= false
c_lit_subj ::= to_i64(0)
// Suffix `LL` so an UNTYPED integer literal is a 64-bit C constant: bare literals are C `int`
// (32-bit), so `100000 * 100000` (or `1 << 40`) would overflow at int width BEFORE any i64
// assignment. With `LL` the arithmetic happens at >=64-bit, then the final assign/cast truncates
// (the C-correct widen-then-narrow). Small i32 math is unchanged: int32_t op long long promotes,
// computes, and the i32 store/cast narrows back.
//
// A NEGATIVE `n` must stay SIGNED. The String numeric methods print the supplied domain (i64-MIN has no decimal
// spelling, and a written u64 magnitude above i64-max arrives here as a negative `n`), so the plain
// pattern + `ULL` is an UNSIGNED constant — and C's usual conversions then drag any signed operand
// beside it up to unsigned, turning `n < -9007199254740992` into an always-true unsigned compare.
// Emitting the negated MAGNITUDE is correct in both worlds: signed neighbours compare as written, and
// an unsigned slot converts it back to the same bit pattern. i64-MIN, whose magnitude has no i64
// spelling, takes C's standard `MIN+1 - 1` form.
gen_int_lit = (s: String, n: i64) String {
    (n >= 0).then({
        return s.add_i64(n).add("LL")
    })
    (n == 0 - 9223372036854775807 - 1).then({
        return s.add("(-9223372036854775807LL - 1LL)")
    })
    s.add("(-").add_i64(0 - n).add("LL)")
}
gen_expr* = (s: String, alloc: Allocator, e: Ptr<Expr>) String {
    (c_lit_active && e.lit_subj_key() == c_lit_subj).then({
        return s.add("__zen_lit_subj")
    })
    e.match ({
        .Int(n)         => s.gen_int_lit(n),
        .Byte(n)        => s.add_i64(n),
        .FloatLit(ft)   => s.add(ft),
        .Var(v)         => s.add(v.name),
        .Bin(b)         => s.gen_bin(alloc, b),
        .Call(c)        => s.gen_call(alloc, c),
        .MethodCall(mc) => s.add("zen__undesugared_method_call"),    // desugared to Call before codegen — marker if the invariant ever breaks
        .Cond(d)        => s.gen_cond(alloc, d),
        .Member(m)      => s.gen_member(alloc, m),
        .MakeEnum(m)    => s.gen_mkenum(alloc, m),
        .MakeStruct(m)  => s.gen_mkstruct(alloc, m),
        .Tag(t)         => s
            .add("(")
            .add(t.mty)
            .add("){ .tag = ")
            .add(t.mty)
            .add("_")
            .add(t.variant)
            .add(" }"),
        .Match(m)       => s.gen_match(alloc, m),
        .StrLit(sl)     => s.gen_strlit(alloc, sl.value),
        .SliceLit(sd)   => s.gen_slicelit(alloc, sd),
        .Index(ix)      => s.gen_index(alloc, ix),
        .Loop(l)        => s.gen_loop(alloc, l),
        .Lambda(lm)     => s.add("zen__unlowered_lambda"),
        .Block(b)       => s.gen_blockexpr(alloc, b),
    })
}
// GCC statement-expression; the trailing ExprStmt is the result expression. A trailing `return` is a
// USER return (arm/loop blocks never get an implicit trailing return; the inliner strips its own tail
// returns before splicing — see blk_diverges) and emits as a REAL `return`, leaving the enclosing C
// function. Such a block diverges: its emitters (gen_switch_body / gen_cond) never use its value.
gen_blockexpr = (s: String, alloc: Allocator, b: BlockData) String {
    out ::= s.add("({ ")
    b.stmts.loop_at((i, st) {
        out = out.gen_block_one(alloc, st, i == b.stmts.len - 1).add(" ")
    })
    out.add("})")
}
gen_block_one = (s: String, alloc: Allocator, st: Stmt, last: bool) String {
    last.match ({
        true  => st.match ({
            .ExprStmt(e) => s.gen_expr(alloc, e).add(";"),
            _            => s.gen_stmt(alloc, st),
        }),
        false => s.gen_stmt(alloc, st),
    })
}
// `.tag` on a bare Tag node is the compile-time enum tag CONSTANT `<mty>_<variant>`; fold it to that
// bare identifier instead of materializing the tag struct just to read its `.tag`. or_return's Err-guard
// builds its condition this way (`tmp.tag == Tag(Result<T,E>, Err).tag`) so the enum name rides on a
// re-manglable Tag node — subst_expr rewrites T→concrete when a generic body is inlined (#54) — while
// the fold keeps the emitted spelling byte-identical to the old baked constant.
member_is_tag_const = (m: MemberData) bool {
    (m.field == "tag").match ({
        true  => load(m.obj).match ({
            .Tag(t) => true,
            _       => false,
        }),
        false => false,
    })
}
gen_tag_const = (s: String, alloc: Allocator, obj: Ptr<Expr>) String {
    load(obj).match ({
        .Tag(t) => s.add(t.mty).add("_").add(t.variant),
        _       => s,
    })
}
// Loop control is an EXPRESSION in the AST (it can sit inside a value-match arm), so a bare C
// `break`/`continue` is both mistargeted by an intervening match switch and unusable in expression
// position. The resolved handler is a unique local Var: jump to that loop's labels from a typed GNU
// statement-expression. The dead `0` gives __typeof__/conditional arm typing an ordinary value.
gen_loop_label = (s: String, alloc: Allocator, obj: Ptr<Expr>, suffix: StringView) String {
    load(obj).match ({
        .Var(v) => s.add(v.name).add(suffix),
        _       => s.add("zen__invalid_loop_handler"),
    })
}
gen_loop_jump = (s: String, alloc: Allocator, obj: Ptr<Expr>, suffix: StringView) String {
    s
        .add("({ goto ")
        .gen_loop_label(alloc, obj, suffix)
        .add("; 0; })")
}
gen_member = (s: String, alloc: Allocator, m: MemberData) String {
    m.ptr.then({
        return s.gen_expr(alloc, m.obj).add("->").add(m.field)
    })
    (m.field == "break_zk").match ({
        true  => s.gen_loop_jump(alloc, m.obj, "__b"),
        false => (m.field == "continue_zk").match ({
            true  => s.gen_loop_jump(alloc, m.obj, "__c"),
            false => m.member_is_tag_const().match ({
                true  => s.gen_tag_const(alloc, m.obj),
                false => s
                    .gen_expr(alloc, m.obj)
                    .add(".")
                    .add(m.field),
            }),
        }),
    })
}
gen_loop = (s: String, alloc: Allocator, l: LoopData) String {
    out ::= s
    // GNU local labels are scoped to this statement-expression. Generic inlining may clone a loop
    // (and therefore its handler spelling) multiple times in one C function; ordinary labels would
    // collide function-wide and could bind a jump to the wrong clone.
    out = out
        .add("({ __label__ ")
        .add(l.h)
        .add("__b, ")
        .add(l.h)
        .add("__c; __auto_type _seq = ")
    out = out.gen_expr(alloc, l.seq)
    out = out.add("; for (int64_t ")
    out = out.add(l.idx)
    out = out.add(" = 0; ")
    out = out.add(l.idx)
    out = out.add(" < _seq.len; ")
    out = out.add(l.idx)
    out = out.add(" = ")
    out = out.add(l.idx)
    out = out.add(" + 1) { __auto_type ")
    out = out.add(l.elem)
    out = out.add(" = ((")
    out = out.add(alloc.ty_cname_in(l.elemTy))
    out = out.add("*)_seq.ptr)[")
    out = out.add(l.idx)
    out = out.add("]; ")
    out = out.gen_loop_body(alloc, l.body)
    out = out.add(" ").add(l.h).add("__c: ; } ")
    out.add(l.h).add("__b: ; 0; })")
}
gen_loop_body = (s: String, alloc: Allocator, body: MutSlice<Stmt>) String {
    out ::= s
    body.loop_at((i, st) { out = out.gen_stmt(alloc, st).add(" ") })
    out
}
// Slice literal -> heap-promoted zslice. A bare C compound literal `(T[]){…}` has AUTOMATIC storage,
// so a slice literal that ESCAPES its frame (returned, or stored into a longer-lived aggregate) leaves
// `.ptr` dangling into the dead frame. Copy the backing into a malloc'd block inside a statement-
// expression so `.ptr` outlives the frame. `zen__salloc` NULL-checks the malloc and panics cleanly on
// OOM (mirrors the div/idx preamble guards) so an exhausted heap can never `memcpy` into NULL. Empty
// `[]` needs no backing.
//
// KNOWN LEAK (partly closed): this heap block is never freed, so every literal that reaches HERE is a
// leak of its backing bytes. One literal shape no longer reaches here — a literal written DIRECTLY as a
// call argument whose callee only BORROWS that parameter now emits gen_slicelit_stack instead (see
// compiler.backend.c.c_escape for the classification and its heap-by-default law). That covers the
// `[arg_int(n)]` argument slice every `formatln`/`format` call site builds — measured at 32 bytes per
// call before, 0 after. Still leaking, deliberately: a literal that is RETURNED or bound to a local
// (`xs = [1, 2, 3]`), stored into a struct/slice/enum, passed to a foreign or unknown callee, or passed
// to a callee this analysis cannot clear within its hop bound. Those keep the malloc because pure stack
// storage reintroduces a verified use-after-return for `f() MutSlice<i32> { [1, 2, 3] }` — heap-by-default means
// a misclassification is a leak, never a use-after-free.
gen_slicelit = (s: String, alloc: Allocator, sd: SliceData) String {
    n = slice_count(sd.items)
    (n == 0).match ({
        true  => s.add("(zslice){ .ptr = (void*)0, .len = 0 }"),
        false => {
            tn = alloc.ty_cname_in(sd.elem)
            out = s
                .add("({ ")
                .add(tn)
                .add(" _zsa[] = { ")
                .gen_args(alloc, sd.items)
                .add(" }; uint8_t* _zsp = zen__salloc(sizeof(_zsa)); memcpy(_zsp, (uint8_t*)_zsa, sizeof(_zsa)); (zslice){ .ptr = (void*)_zsp, .len = ")
            out.add_i64(n).add(" }; })")
        },
    })
}
// The NON-escaping lowering: the backing array is a plain C compound literal, whose storage lasts to the
// end of the ENCLOSING BLOCK — strictly longer than the call it is an argument to. No malloc, so nothing
// to free. Only emitted where compiler.backend.c.c_escape proved the callee borrows the parameter.
gen_slicelit_stack = (s: String, alloc: Allocator, sd: SliceData) String {
    n = slice_count(sd.items)
    (n == 0).match ({
        true  => s.add("(zslice){ .ptr = (void*)0, .len = 0 }"),
        false => {
            out = s
                .add("(zslice){ .ptr = (void*)(")
                .add(alloc.ty_cname_in(sd.elem))
                .add("[]){ ")
                .gen_args(alloc, sd.items)
                .add(" }, .len = ")
            out.add_i64(n).add(" }")
        },
    })
}
// Bounds-checked slice read: `zen__idx` (preamble) panics on a negative or >= len index and returns
// the element byte-pointer, which `*(ELEM*)…` derefs back to an lvalue (so `seq[i]` keeps working as a
// member base / address-of target). A plain function call — not a macro — so comma-bearing operands
// (compound literals etc.) parse as real C, and seq/idx each evaluate exactly once.
gen_index = (s: String, alloc: Allocator, ix: IndexData) String {
    tn = alloc.ty_cname_in(ix.elem)
    s
        .add("(*(")
        .add(tn)
        .add("*)zen__idx(")
        .gen_expr(alloc, ix.seq)
        .add(", ")
        .gen_expr(alloc, ix.idx)
        .add(", sizeof(")
        .add(tn)
        .add(")))")
}
// `/` and `%` emit a statement-expression that binds both operands once, then dispatches on operand
// type with `_Generic`: integer operands hit a checked helper that panics on divide-by-zero and on the
// INT_MIN/-1 overflow; float operands keep native C semantics (x/0.0 == inf, never a SIGFPE). A
// statement-expression (not a function-like macro) is used so operands that emit unparenthesized commas
// — e.g. compound literals `(zslice){.ptr=…, .len=…}` — parse as real C instead of splitting macro args.
// All other operators emit `(lhs op rhs)` unchanged.
gen_bin = (s: String, alloc: Allocator, b: BinData) String {
    (b.op == "/.").match ({
        true  => s
            .add("(")
            .gen_expr(alloc, b.lhs)
            .add(" / ")
            .gen_expr(alloc, b.rhs)
            .add(")"),
        false => (b.op == "/").match ({
            true  => s
                .add("({ __auto_type _zdl = (")
                .gen_expr(alloc, b.lhs)
                .add("); __auto_type _zdr = (")
                .gen_expr(alloc, b.rhs)
                .add("); _Generic(_zdl + _zdr, double:(double)(_zdl/_zdr), float:(float)(_zdl/_zdr), unsigned int: zen__udivz((uint64_t)_zdl, (uint64_t)_zdr), unsigned long: zen__udivz((uint64_t)_zdl, (uint64_t)_zdr), unsigned long long: zen__udivz((uint64_t)_zdl, (uint64_t)_zdr), int: zen__divz32((int32_t)_zdl, (int32_t)_zdr), default: zen__divz((int64_t)_zdl, (int64_t)_zdr)); })"),
            false => (b.op == "%").match ({
                true  => s
                    .add("({ __auto_type _zml = (")
                    .gen_expr(alloc, b.lhs)
                    .add("); __auto_type _zmr = (")
                    .gen_expr(alloc, b.rhs)
                    .add("); _Generic(_zml + _zmr, double:(int64_t)0, float:(int64_t)0, unsigned int: zen__umodz((uint64_t)_zml, (uint64_t)_zmr), unsigned long: zen__umodz((uint64_t)_zml, (uint64_t)_zmr), unsigned long long: zen__umodz((uint64_t)_zml, (uint64_t)_zmr), default: zen__modz((int64_t)_zml, (int64_t)_zmr)); })"),
                false => {
                    cast = b.rty.subword_ty()
                    lead = cast.match ({
                        true  => s
                            .add("((")
                            .add(alloc.ty_cname_in(b.rty))
                            .add(")("),
                        false => s.add("("),
                    })
                    mid = lead
                        .gen_expr(alloc, b.lhs)
                        .add(" ")
                        .add(b.op)
                        .add(" ")
                        .gen_expr(alloc, b.rhs)
                        .add(")")
                    cast.then({ mid.add(")") }, { mid })
                },
            }),
        }),
    })
}
// Intrinsics erase to C pointer/cast ops; missing intrinsic args degrade to literal 0.
gen_arg_at = (s: String, alloc: Allocator, c: CallData, i: i32) String {
    (i < c.args.len).then({ s.gen_expr(alloc, c.args[i].addr()) }, { s.add("0") })
}
EmitCallKind: Normal | StrEq | StrNe | Load | Offset | Store | LoadI64 | StoreI64 | AtomicAddI64 | AtomicLoadI64 | AtomicStoreI64 | AtomicCasI64 | AtomicFence | Addr | AssertNonnull | CStr | Slice | NullPtr | ToI32 | ToI64 | ToU8 | ToF64 | Sizeof
// map a sizeof type-arg name to its C type name. Primitives (i64→int64_t, bool→…) must NOT leak the
// Zen keyword into C; struct names and already-substituted tparams (sizeof(T)→sizeof(Expr)) pass through.
// The whole string_* family shares the Phase-1 `const char*` layout, so one size answers for all three.
sizeof_is_canonical_string = (n: StringView) bool {
    n == "StringView" || n == "StringCstr" || n == "StringLiteral"
}
sizeof_base_cname = (n: StringView) StringView {
    (n == "i32").then({
        return "int32_t"
    })
    (n == "i64").then({
        return "int64_t"
    })
    (n == "u8").then({
        return "uint8_t"
    })
    (n == "f64").then({
        return "double"
    })
    (n == "bool").then({
        return "bool"
    })
    (n == "void").then({
        return "void"
    })
    n
}
sizeof_cname = (n: StringView) StringView {
    n.sizeof_is_canonical_string().then({ "const char*" }, { n.sizeof_base_cname() })
}
// `sizeof(<type>)`: route a bare type-name Var through sizeof_cname; any other arg form emits as-is.
gen_sizeof = (s: String, alloc: Allocator, c: CallData) String {
    out = s.add("sizeof(")
    body = (c.args.len > 0).match ({
        true  => c.args[0].addr().match ({
            .Var(v) => out.add(sizeof_cname(v.name)),
            _       => out.gen_arg_at(alloc, c, 0),
        }),
        false => out.add("0"),
    })
    body.add(")")
}
// `offset` is a byte cast, but a plain `load(offset(typed_ptr, n))` promises to load the
// original pointee. Reapply that pointer type around the byte address; adding zero inside `__typeof__`
// also applies normal array-to-pointer decay for string literals. The expression remains unevaluated,
// so the base still executes only inside the offset itself.
gen_load = (s: String, alloc: Allocator, c: CallData) String {
    (c.args.len > 0).match ({
        true  => c.args[0].match ({
            .Call(off) => (off.fn == "offset" && off.args.len > 0).match ({
                true  => s
                    .add("(*(__typeof__((")
                    .gen_arg_at(alloc, off, 0)
                    .add(") + 0))(")
                    .gen_arg_at(alloc, c, 0)
                    .add("))"),
                false => s.gen_intr1(alloc, c, "(*(", "))"),
            }),
            _          => s.gen_intr1(alloc, c, "(*(", "))"),
        }),
        false => s.gen_intr1(alloc, c, "(*(", "))"),
    })
}
call_kind = (name: StringView) EmitCallKind {
    kind ::= EmitCallKind.Normal
    (name == "__str_eq").then({
        kind = EmitCallKind.StrEq
    })
    (name == "__str_ne").then({
        kind = EmitCallKind.StrNe
    })
    (name == "load").then({
        kind = EmitCallKind.Load
    })
    (name == "offset").then({
        kind = EmitCallKind.Offset
    })
    (name == "store").then({
        kind = EmitCallKind.Store
    })
    (name == "load_i64").then({
        kind = EmitCallKind.LoadI64
    })
    (name == "store_i64").then({
        kind = EmitCallKind.StoreI64
    })
    (name == "atomic_add_i64").then({
        kind = EmitCallKind.AtomicAddI64
    })
    (name == "atomic_load_i64").then({
        kind = EmitCallKind.AtomicLoadI64
    })
    (name == "atomic_store_i64").then({
        kind = EmitCallKind.AtomicStoreI64
    })
    (name == "atomic_cas_i64").then({
        kind = EmitCallKind.AtomicCasI64
    })
    (name == "atomic_fence").then({
        kind = EmitCallKind.AtomicFence
    })
    (name == "addr").then({
        kind = EmitCallKind.Addr
    })
    (name == "assert_nonnull").then({
        kind = EmitCallKind.AssertNonnull
    })
    (name == "cstr").then({
        kind = EmitCallKind.CStr
    })
    (name == "slice").then({
        kind = EmitCallKind.Slice
    })
    (name == "null_ptr").then({
        kind = EmitCallKind.NullPtr
    })
    (name == "to_i32").then({
        kind = EmitCallKind.ToI32
    })
    (name == "to_i64").then({
        kind = EmitCallKind.ToI64
    })
    (name == "to_u8").then({
        kind = EmitCallKind.ToU8
    })
    (name == "to_f64").then({
        kind = EmitCallKind.ToF64
    })
    (name == "sizeof").then({
        kind = EmitCallKind.Sizeof
    })
    kind
}
// is this expression a C lvalue (so `&expr` is legal as-is)? Var/field/arrow/index and a `load`
// deref always are; everything else (a call result, literal, struct/enum value, …) is a temporary.
is_lvalue = (e: Ptr<Expr>) bool {
    e.match ({
        .Var(v)    => true,
        .Member(m) => m.ptr || is_lvalue(m.obj),
        .Index(ix) => true,
        .Call(c)   => c.fn == "load",
        _          => false,
    })
}
// `expr.addr()` → `&expr`. Taking the address of a TEMPORARY (e.g. `default().addr()`) is a cc
// "lvalue required" error, so for non-lvalues spill into a 1-element-array compound literal:
// `(__typeof__(e)[1]){ e }` copy-inits the whole value (works for scalars AND structs — a plain
// `(T){e}` would mis-init T's first FIELD with e), has the enclosing block's lifetime, and decays
// to a `T*` pointing at element 0 — exactly the wanted address. typeof's operand is unevaluated,
// so the inner expression runs exactly once (in the initializer).
gen_addr = (s: String, alloc: Allocator, c: CallData) String {
    (c.args.len > 0 && is_lvalue(c.args[0].addr())).match ({
        true  => s.add("(&(").gen_arg_at(alloc, c, 0).add("))"),
        false => s
            .add("((__typeof__(")
            .gen_arg_at(alloc, c, 0)
            .add(")[1]){ ")
            .gen_arg_at(alloc, c, 0)
            .add(" })"),
    })
}
gen_call_default = (s: String, alloc: Allocator, c: CallData) String {
    s
        .add(c.fn)
        .add("(")
        .gen_call_args(alloc, c.fn, c.args)
        .add(")")
}
// Argument emission for an ORDINARY call — the one position where a slice literal can be proven not to
// escape (c_escape). Identical to gen_args except for that one classification; every other argument, and
// every intrinsic's arguments (they never reach here), go through gen_expr and stay heap-promoted.
gen_call_args = (s: String, alloc: Allocator, fn: StringView, args: MutSlice<Expr>) String {
    out ::= s
    args.loop_at((i, arg) {
        out = (i == 0).then({ out }, { out.add(", ") })    // comma between, not before
        out = arg.match ({
            .SliceLit(sd) => fn.slx_arg_is_borrowed(i).match ({
                true  => out.gen_slicelit_stack(alloc, sd),
                false => out.gen_slicelit(alloc, sd),
            }),
            _             => out.gen_expr(alloc, arg.addr()),
        })
    })
    out
}
// Every intrinsic expansion below is the SAME shape — fixed C text with the call's arguments spliced
// between it — so one helper per argument count spells that shape once and each arm keeps only the
// delimiters that actually distinguish it. The `add`/`gen_arg_at` chains these replace were
// byte-for-byte identical apart from those string constants.
gen_intr1 = (s: String, alloc: Allocator, c: CallData, pre: StringView, post: StringView) String {
    s.add(pre).gen_arg_at(alloc, c, 0).add(post)
}
gen_intr2 = (
    s: String,
    alloc: Allocator,
    c: CallData,
    pre: StringView,
    mid: StringView,
    post: StringView,
) String { s.gen_intr1(alloc, c, pre, mid).gen_arg_at(alloc, c, 1).add(post) }
gen_intr3 = (
    s: String,
    alloc: Allocator,
    c: CallData,
    pre: StringView,
    mid1: StringView,
    mid2: StringView,
    post: StringView,
) String { s.gen_intr2(alloc, c, pre, mid1, mid2).gen_arg_at(alloc, c, 2).add(post) }
gen_call = (s: String, alloc: Allocator, c: CallData) String {
    c.fn.call_kind().match ({
        .StrEq          => s.gen_intr2(alloc, c, "eq(", ", ", ")"),
        .StrNe          => s.gen_intr2(alloc, c, "(!eq(", ", ", "))"),
        .Load           => s.gen_load(alloc, c),
        .Offset         => s.gen_intr2(alloc, c, "((uint8_t*)(", ") + (", "))"),
        .Store          => s.gen_intr2(alloc, c, "(*(", ") = ", ")"),
        .LoadI64        => s.gen_intr1(alloc, c, "(*(int64_t*)(", "))"),
        .StoreI64       => s.gen_intr2(alloc, c, "(*(int64_t*)(", ") = ", ")"),
        .AtomicAddI64   => s.gen_intr2(alloc, c, "__atomic_add_fetch((int64_t*)(", "), (", "), 5)"),
        .AtomicLoadI64  => s.gen_intr1(alloc, c, "__atomic_load_n((int64_t*)(", "), 5)"),
        .AtomicStoreI64 => s.gen_intr2(alloc, c, "__atomic_store_n((int64_t*)(", "), (", "), 5)"),
        .AtomicCasI64   => s.gen_intr3(alloc, c, "__atomic_compare_exchange_n((int64_t*)(", "), &(int64_t){ ", " }, (", "), 0, 5, 5)"),
        .AtomicFence    => s.add("__atomic_thread_fence(5)"),
        .Addr           => s.gen_addr(alloc, c),
        // Stage 3 null guard: panics if the RawPtr is null, else yields it unchanged (preserving its
        // T*). The one arm that repeats arg0, so it spells its own chain.
        .AssertNonnull  => s
            .add("({ __typeof__(")
            .gen_arg_at(alloc, c, 0)
            .add(") _znn = (")
            .gen_arg_at(alloc, c, 0)
            .add("); if(!_znn){ zen__panic(\"zen: panic: null pointer deref\\n\"); } _znn; })"),
        .CStr           => s.gen_intr1(alloc, c, "((const char*)(", "))"),
        .Slice          => s.gen_intr2(alloc, c, "(zslice){ .ptr = (void*)(", "), .len = (", ") }"),
        .NullPtr        => s.add("0"),
        .ToI32          => s.gen_intr1(alloc, c, "((int32_t)(", "))"),
        .ToI64          => s.gen_intr1(alloc, c, "((int64_t)(", "))"),
        .ToU8           => s.gen_intr1(alloc, c, "((uint8_t)(", "))"),
        .ToF64          => s.gen_intr1(alloc, c, "((double)(", "))"),
        .Sizeof         => s.gen_sizeof(alloc, c),
        .Normal         => s.gen_call_default(alloc, c),
    })
}
// a call's argument list, comma-separated: `a, b, c` (each arg is an Expr value -> addr it)
gen_args = (s: String, alloc: Allocator, args: MutSlice<Expr>) String {
    out ::= s
    args.loop_at((i, arg) {
        out = (i == 0).then({ out }, { out.add(", ") })    // comma between, not before
        out = out.gen_expr(alloc, arg.addr())
    })
    out
}
gen_cond_plain = (s: String, alloc: Allocator, d: CondData) String {
    (blk_diverges(d.t) || blk_diverges(d.e)).match ({
        true  => s.gen_cond_div(alloc, d),
        false => s
            .add("(")
            .gen_expr(alloc, d.c)
            .add(" ? ")
            .gen_expr(alloc, d.t)
            .add(" : ")
            .gen_expr(alloc, d.e)
            .add(")"),
    })
}
gen_cond = (s: String, alloc: Allocator, d: CondData) String {
    subj = d.lit_chain_subj()
    cache = d.lit_chain_is() && (c_lit_active == false || subj.lit_subj_key() != c_lit_subj)
    cache.match ({
        false => s.gen_cond_plain(alloc, d),
        true  => {
            out = s.add("({ __auto_type __zen_lit_subj = ").gen_expr(alloc, subj).add("; ")
            prev_active = c_lit_active
            prev_subj = c_lit_subj
            c_lit_active = true
            c_lit_subj = subj.lit_subj_key()
            body = out.gen_cond_plain(alloc, d)
            c_lit_active = prev_active
            c_lit_subj = prev_subj
            body.add("; })")
        },
    })
}
// A value cond with a DIVERGING branch (its block ends in `return`) cannot be a `?:` — a void arm in
// a conditional expression is invalid C, and the return must actually fire. Emit a statement-expr:
// the non-diverging branch assigns `_out` (typed from it, unevaluated via __typeof__); the diverging
// branch runs as statements and leaves the function. Both diverging → `_out` is a dead int.
gen_cond_branch_div = (s: String, alloc: Allocator, e: Ptr<Expr>) String {
    blk_diverges(e).match ({
        true  => s.add("{ ").gen_expr(alloc, e).add("; }"),
        false => s.add("{ _out = ").gen_expr(alloc, e).add("; }"),
    })
}
gen_cond_div_ty = (s: String, alloc: Allocator, d: CondData) String {
    blk_diverges(d.t).match ({
        true  => blk_diverges(d.e).then({ s.add("0") }, { s.gen_expr(alloc, d.e) }),
        false => s.gen_expr(alloc, d.t),
    })
}
gen_cond_div = (s: String, alloc: Allocator, d: CondData) String {
    s
        .add("({ __typeof__(")
        .gen_cond_div_ty(alloc, d)
        .add(") _out; if (")
        .gen_expr(alloc, d.c)
        .add(") ")
        .gen_cond_branch_div(alloc, d.t)
        .add(" else ")
        .gen_cond_branch_div(alloc, d.e)
        .add(" _out; })")
}
gen_mkenum = (s: String, alloc: Allocator, m: MakeEnumData) String {
    head = s
        .add("(")
        .add(m.mty)
        .add("){ .tag = ")
        .add(m.mty)
        .add("_")
        .add(m.variant)
    head
        .add(", .u.")
        .add(m.variant)
        .add(" = ")
        .gen_expr(alloc, m.payload)
        .add(" }")
}
// a struct literal: `(T){ .a = …, .b = … }` (a C compound literal, designated initializers)
gen_mkstruct = (s: String, alloc: Allocator, m: MakeStructData) String {
    out ::= s.add("(").add(m.mty).add("){ ")
    m.inits.loop_at((i, fi) {
        out = (i == 0).then({ out }, { out.add(", ") })    // mty = the monomorphized name for a generic literal
        // comma between, not before
        out = out
            .add(".")
            .add(fi.name)
            .add(" = ")
            .gen_expr(alloc, fi.value)
    })
    out.add(" }")
}
// an arm's body: bind the payload (GCC __auto_type, so no payload type needed here), then the body
gen_armbind = (s: String, alloc: Allocator, subj: StringView, sep: StringView, a: ArmData) String {
    s
        .add("({ __auto_type ")
        .add(a.bind)
        .add(" = ")
        .add(subj)
        .add(sep)
        .add("u.")
        .add(a.variant)
        .add("; ")
        .gen_expr(alloc, a.body)
        .add("; })")
}
gen_armbody = (s: String, alloc: Allocator, subj: StringView, sep: StringView, a: ArmData) String {
    is_empty(a.bind).match ({
        true  => s.add("(").gen_expr(alloc, a.body).add(")"),
        false => s.gen_armbind(alloc, subj, sep, a),
    })
}
// Statement matches must keep recursively-discarded arm bodies in statement context. Otherwise a
// nested void match is lowered by gen_match as a value and attempts to declare an impossible `void _out`.
gen_armbind_stmt = (
    s: String,
    alloc: Allocator,
    subj: StringView,
    sep: StringView,
    a: ArmData,
) String {
    s
        .add("{ __auto_type ")
        .add(a.bind)
        .add(" = ")
        .add(subj)
        .add(sep)
        .add("u.")
        .add(a.variant)
        .add("; ")
        .gen_expr_stmt(alloc, a.body)
        .add(" }")
}
gen_armbody_stmt = (
    s: String,
    alloc: Allocator,
    subj: StringView,
    sep: StringView,
    a: ArmData,
) String {
    is_empty(a.bind).match ({
        true  => s.gen_expr_stmt(alloc, a.body),
        false => s.gen_armbind_stmt(alloc, subj, sep, a),
    })
}
// Type every arm through C's conditional operator so array arms decay, numeric arms widen, and exact
// struct/scalar arms keep their type. __typeof__ evaluates none of these arm expressions. DIVERGING
// arms (body ends in `return`) yield no value: they are skipped here (their block would type void and
// poison the chain) and emitted as statements in gen_switch_body. All arms diverging → dead int _out.
next_live_arm = (arms: MutSlice<ArmData>, i: i64) i64 {
    (i >= arms.len).match ({
        true  => arms.len,
        false => arms[i].body.blk_diverges().then({ arms.next_live_arm(i + 1) }, { i }),
    })
}
gen_match_type_expr = (
    s: String,
    alloc: Allocator,
    subj: StringView,
    sep: StringView,
    arms: MutSlice<ArmData>,
    i: i64,
) String {
    j = arms.next_live_arm(i)
    (j >= arms.len).match ({
        true  => s.add("0"),
        false => (arms.next_live_arm(j + 1) >= arms.len).match ({
            true  => s
                .add("(1 ? ")
                .gen_armbody(alloc, subj, sep, arms[j])
                .add(" : ")
                .gen_armbody(alloc, subj, sep, arms[j])
                .add(")"),
            false => s
                .add("(1 ? ")
                .gen_armbody(alloc, subj, sep, arms[j])
                .add(" : ")
                .gen_match_type_expr(alloc, subj, sep, arms, j + 1)
                .add(")"),
        }),
    })
}
gen_match_out_decl = (
    s: String,
    alloc: Allocator,
    subj: StringView,
    sep: StringView,
    arms: MutSlice<ArmData>,
) String {
    s
        .add("__typeof__(")
        .gen_match_type_expr(alloc, subj, sep, arms, 0)
        .add(") _out; ")
}
// a diverging arm's body runs for CONTROL FLOW only (its trailing `return` leaves the function) —
// no `_out` assignment (its statement-expr would be void).
gen_switch_body = (
    s: String,
    alloc: Allocator,
    subj: StringView,
    sep: StringView,
    a: ArmData,
) String {
    a.body.blk_diverges().match ({
        true  => s.gen_switch_stmt_body(alloc, subj, sep, a),
        false => s
            .add("{ _out = ")
            .gen_armbody(alloc, subj, sep, a)
            .add("; break; } "),
    })
}
gen_switch_stmt_body = (
    s: String,
    alloc: Allocator,
    subj: StringView,
    sep: StringView,
    a: ArmData,
) String {
    s
        .add("{ ")
        .gen_armbody_stmt(alloc, subj, sep, a)
        .add(" break; } ")
}
gen_switch_case = (
    s: String,
    alloc: Allocator,
    subj: StringView,
    sep: StringView,
    ename: StringView,
    a: ArmData,
) String {
    s
        .add("case ")
        .add(ename)
        .add("_")
        .add(a.variant)
        .add(": ")
        .gen_switch_body(alloc, subj, sep, a)
}
gen_switch_default = (
    s: String,
    alloc: Allocator,
    subj: StringView,
    sep: StringView,
    a: ArmData,
) String { s.add("default: ").gen_switch_body(alloc, subj, sep, a) }
gen_switch_stmt_case = (
    s: String,
    alloc: Allocator,
    subj: StringView,
    sep: StringView,
    ename: StringView,
    a: ArmData,
) String {
    s
        .add("case ")
        .add(ename)
        .add("_")
        .add(a.variant)
        .add(": ")
        .gen_switch_stmt_body(alloc, subj, sep, a)
}
gen_switch_stmt_default = (
    s: String,
    alloc: Allocator,
    subj: StringView,
    sep: StringView,
    a: ArmData,
) String { s.add("default: ").gen_switch_stmt_body(alloc, subj, sep, a) }
// A match with no explicit `_` arm was proved exhaustive by the CHECKER; the emitter must not silently
// re-route stray tags into the last arm's body (the old last-arm-as-`default:` trick — the #377 class
// of silent miscompiles). Every arm gets its own `case`, and `default:` traps: a tag outside the listed
// variants at runtime means the checker and emitter disagree. zen__panic diverges (write + abort), so
// value-position `_out` is never read on this path.
gen_switch_panic_default = (s: String, alloc: Allocator) String {
    s.add("default: zen__panic(\"zen: panic: non-exhaustive match — checker/emitter disagreement\\n\"); ")
}
gen_switch_arm = (
    s: String,
    alloc: Allocator,
    subj: StringView,
    sep: StringView,
    ename: StringView,
    a: ArmData,
    last: bool,
) String {
    (a.variant == "_").match ({
        true  => s.gen_switch_default(alloc, subj, sep, a),
        false => {
            out = s.gen_switch_case(alloc, subj, sep, ename, a)
            last.then({ out.gen_switch_panic_default(alloc) }, { out })
        },
    })
}
gen_switch_stmt_arm = (
    s: String,
    alloc: Allocator,
    subj: StringView,
    sep: StringView,
    ename: StringView,
    a: ArmData,
    last: bool,
) String {
    (a.variant == "_").match ({
        true  => s.gen_switch_stmt_default(alloc, subj, sep, a),
        false => {
            out = s.gen_switch_stmt_case(alloc, subj, sep, ename, a)
            last.then({ out.gen_switch_panic_default(alloc) }, { out })
        },
    })
}
gen_switch_arms = (
    s: String,
    alloc: Allocator,
    subj: StringView,
    sep: StringView,
    ename: StringView,
    arms: MutSlice<ArmData>,
    i: i64,
) String {
    (i >= arms.len).match ({
        true  => s,
        false => {
            out = s.gen_switch_arm(alloc, subj, sep, ename, arms[i], i == arms.len - 1)
            (arms[i].variant == "_").match ({
                true  => out,
                false => out.gen_switch_arms(alloc, subj, sep, ename, arms, i + 1),
            })
        },
    })
}
gen_switch_stmt_arms = (
    s: String,
    alloc: Allocator,
    subj: StringView,
    sep: StringView,
    ename: StringView,
    arms: MutSlice<ArmData>,
    i: i64,
) String {
    (i >= arms.len).match ({
        true  => s,
        false => {
            out = s.gen_switch_stmt_arm(alloc, subj, sep, ename, arms[i], i == arms.len - 1)
            (arms[i].variant == "_").match ({
                true  => out,
                false => out.gen_switch_stmt_arms(alloc, subj, sep, ename, arms, i + 1),
            })
        },
    })
}
// the subject can be any expression, so bind it once to a temp. Enum matches emit as a switch inside a
// GCC statement-expression; `__typeof__(first_arm)` gives us the result type without evaluating an arm.
gen_match = (s: String, alloc: Allocator, m: MatchData) String {
    sep = m.ptr.then({ "->" }, { "." })
    s
        .add("({ __auto_type _subj = ")
        .gen_expr(alloc, m.subj)
        .add("; ")
        .gen_match_out_decl(alloc, "_subj", sep, m.arms)
        .add("switch (_subj")
        .add(sep)
        .add("tag) { ")
        .gen_switch_arms(alloc, "_subj", sep, m.ename, m.arms, 0)
        .add("} _out; })")
}
gen_match_stmt = (s: String, alloc: Allocator, m: MatchData) String {
    sep = m.ptr.then({ "->" }, { "." })
    s
        .add("{ __auto_type _subj = ")
        .gen_expr(alloc, m.subj)
        .add("; switch (_subj")
        .add(sep)
        .add("tag) { ")
        .gen_switch_stmt_arms(alloc, "_subj", sep, m.ename, m.arms, 0)
        .add("} }")
}
// ── emit a statement, a block, a parameter list, a function, a struct, a decl ─
gen_expr_stmt = (s: String, alloc: Allocator, e: Ptr<Expr>) String {
    e.match ({
        .Match(m) => s.gen_match_stmt(alloc, m),
        .Cond(d)  => s.gen_cond_stmt(alloc, d),
        .Block(b) => s.gen_block(alloc, b.stmts),
        _         => s.gen_expr(alloc, e).add(";"),
    })
}
// A discarded boolean match has no common result type requirement. Emit it as control flow and keep
// both branches in statement context; this matters when one branch is a loop jump and the other is an
// assignment (their expression values deliberately have unrelated C types).
gen_cond_stmt = (s: String, alloc: Allocator, d: CondData) String {
    s
        .add("if (")
        .gen_expr(alloc, d.c)
        .add(") { ")
        .gen_expr_stmt(alloc, d.t)
        .add(" } else { ")
        .gen_expr_stmt(alloc, d.e)
        .add(" }")
}
gen_void_return = (s: String, alloc: Allocator, e: Ptr<Expr>) String {
    s.gen_expr_stmt(alloc, e).add(" return;")
}
gen_stmt = (s: String, alloc: Allocator, st: Stmt) String {
    st.match ({
        .Let(l)      => l.ty.match ({
            .Void => s
                .add("__auto_type ")
                .add(l.name)
                .add(" = ")
                .gen_expr(alloc, l.value)
                .add(";"),
            _     => s
                .add(alloc.ty_cname_in(l.ty))
                .add(" ")
                .add(l.name)
                .add(" = ")
                .gen_expr(alloc, l.value)
                .add(";"),
        }),    // an annotation emits the REAL C type (an `a: i64 = 0` accumulator IS int64_t); .Void = unannotated (no cross-layer is_void_ty here)
        .Assign(a)   => s
            .gen_expr(alloc, a.target)
            .add(" = ")
            .gen_expr(alloc, a.value)
            .add(";"),    // <lvalue> = value;
        .Return(e)   => s.add("return ").gen_expr(alloc, e).add(";"),
        .ExprStmt(e) => s.gen_expr_stmt(alloc, e),
        .If(f)       => s.gen_if(alloc, f),
        .While(w)    => s
            .add("while (")
            .gen_expr(alloc, w.c)
            .add(") ")
            .gen_block(alloc, w.body),
        .IndexSet(x) => s
            .add("(*(")
            .add(alloc.ty_cname_in(x.elem))
            .add("*)zen__idx(")
            .gen_expr(alloc, x.seq)
            .add(", ")
            .gen_expr(alloc, x.idx)
            .add(", sizeof(")
            .add(alloc.ty_cname_in(x.elem))
            .add("))) = ")
            .gen_expr(alloc, x.value)
            .add(";"),
    })
}
gen_stmt_effect = (s: String, alloc: Allocator, st: Stmt) String {
    st.match ({
        .ExprStmt(e) => s.gen_expr_stmt(alloc, e),
        _            => s.gen_stmt(alloc, st),
    })
}
gen_stmt_void = (s: String, alloc: Allocator, st: Stmt) String {
    st.match ({
        .Return(e) => s.gen_void_return(alloc, e),
        _          => s.gen_stmt_effect(alloc, st),
    })
}
// emit a brace-wrapped block: `{ s1; s2; … }`
gen_block* = (s: String, alloc: Allocator, body: MutSlice<Stmt>) String {
    open ::= s.add("{ ")
    body.loop_at((i, st) { open = open.gen_stmt_effect(alloc, st).add(" ") })
    open.add("}")
}
gen_block_void* = (s: String, alloc: Allocator, body: MutSlice<Stmt>) String {
    open ::= s.add("{ ")
    body.loop_at((i, st) { open = open.gen_stmt_void(alloc, st).add(" ") })
    open.add("}")
}
gen_if = (s: String, alloc: Allocator, f: IfData) String {
    s
        .add("if (")
        .gen_expr(alloc, f.c)
        .add(") ")
        .gen_block(alloc, f.then)
        .add(" else ")
        .gen_block(alloc, f.els)
}
