// FORK 1 of 2 on NESTED BLOCK COMMENTS. DESIGN.md does not decide.
// This file assumes nesting IS supported: the inner /* opens a second
// level, so the first */ closes only the inner one and the ~~ never
// reaches the lexer. The other reading is
// tests/must-fail/lex/block_comment_nested_unsupported.zen, which has
// this exact source. Exactly one of the two can pass.
/* outer /* inner */ ~~ */
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    println("nested block comments are supported");
    Ok(0);
}
