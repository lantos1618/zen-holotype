//! link: zenrt
// std.concurrent.pool_actor — typed actors that run on the multi-threaded pool. The pool currently
// has one global mutex-guarded run queue, not per-worker work-stealing deques. This heals the
// typed-vs-parallel split: std.concurrent.actor's typed
// handles drain INLINE on the caller thread (h.send + h.run, no scheduling), while std.concurrent.pool
// runs only UNTYPED `(RawPtr<u8>, i64) void` behaviors in parallel. pool_actor adapts typed→untyped at
// the boundary so a typed actor's `receive` runs on a pool worker, in parallel, exactly-once.
//
// It is the KEEP path: built on pool.zen + rt.zen, with no inline-drain baggage (std.concurrent.actor's
// cooperative machinery is on the retire list). `Context<M>` / `Receiver<M>` are the CANONICAL types
// imported from std.concurrent.actor — ONE definition serves both actor surfaces (a second same-name
// copy here would survive only via fragile first-occurrence-wins dedup in the flat namespace).
//
// ── THE TRAMPOLINE (why the user writes a tiny concrete stub) ────────────────────────────────────
// The pool stores a type-ERASED `behavior: (RawPtr<u8>, i64) void` fn-ptr. Bridging to a typed
// `receive` needs a shim that reconstitutes the typed message + calls the typed receiver. That shim
// MUST be a CONCRETE (non-generic) function: Zen INLINES generic fns (compiler.mono) — a generic fn
// has no standalone C symbol, so its ADDRESS cannot be taken (a generic trampoline type-checks but
// emits an undeclared-symbol C error). So per (M, ActorT) the user writes one short concrete stub —
// the same shape they already write a concrete `behave` for the raw pool. Import this module under an
// ALIAS (`pa = std.concurrent.pool_actor`) — that avoids flattening common names like `send`/`close`
// into collisions — plus a DESTRUCTURED `{ Context, Receiver } = std.concurrent.pool_actor` for the two
// canonical types (they are imported here from std.concurrent.actor, and alias-qualified lookup only
// resolves names DEFINED in the module, so `pa.Context` does not resolve). Build the Context with
// INFERRED type args (`Context(msg: b[0])`, M inferred from the field).
//
//   room_tramp = (user: RawPtr<u8>, msg: i64) void {
//       a: [Room] = user.slice(1)                 // actor state = the pool user block
//       b: [Msg] = msg.offset(0).slice(1)        // msg (i64) is a POINTER to a heap-boxed M
//       a[0].addr().receive(Context(msg: b[0]))    // typed trait dispatch (M inferred)
//       pa.free_msg(msg)                           // reclaim the message box
//   }
//
// Everything else — actor-state allocation, message boxing, pool registration, the rt wiring — is
// generic stdlib (below). `spawn_actor` is named so (not `spawn`) so it never clashes with the flattened
// `std.thread.spawn` that pool.zen pulls in. FUTURE ergonomic sugar (tracked, not v1): a compiler pass
// emitting a standalone symbol for an address-taken generic instantiation would let the compiler
// auto-generate this stub, removing the one-stub-per-actor-type cost.
//
// ── AMBIENT rt ──────────────────────────────────────────────────────────────────────────────────
// `spawn` takes the actor's rt and hands it to pool_spawn_rt; the pool worker sets it as the current-rt
// thread-local around each behavior run (pool.zen: rt.enter/leave), so `rt.current()` inside `receive`
// resolves to THIS actor's own rt — Pony-style per-actor heap. For this slice actors typically pass
// heap_rt(); a per-actor arena is a later slice.
{ heap_acquire, heap_release } = std.mem.alloc
{ Pool, pool_try_spawn_scratch_rt, pool_actor_free, ActorError, ActorRef, pool_actor_dead,
  pool_actor_set_boxed } = std.concurrent.pool
{ Result, expect } = std.core.result
{ is_null } = std.core.ptr
{ Rt, default } = std.rt
{ Arena } = std.mem.arena
{ Context, Receiver } = std.concurrent.actor
{ loop_at } = std.core.count
// Record the message box the trampoline is about to process, so that if `receive` PANICS (the worker
// catches it via zenrt.c's __zen_actor_call), the catch path frees the box instead of leaking it — the
// trampoline's own free_msg is skipped by the longjmp. Cleared (arg 0) after a normal free_msg so the
// catch never double-frees. Bodyless FFI decl; the symbol lives in bootstrap/zenrt.c (like __zen_actor_call).
__zen_actor_set_inflight = (box: i64) void
// A typed pool-actor handle: `raw` is the pool actor (Arc base) opaque handle; `state` is the process-heap
// actor-state block (`[ActorT]`). Parameterised by the actor's state type `ActorT` so `actor_state`
// / `close` / `send` recover it by inference from the handle (a non-generic handle would lose ActorT
// and force annotation at every call). The message type M is transient — inferred from each `send` arg
// and pinned in the user's concrete trampoline — so it is NOT a handle type param.
PooledHandle*<ActorT>: {
    raw: RawPtr<u8>,
    state: RawPtr<u8>,
}
// spawn a typed actor onto the pool under ambient rt `art`. Allocates the actor-state block, copies the
// actor in, registers it with the pool via `tramp` (the concrete per-(M,ActorT) trampoline — passed in
// because Zen can't take the address of a generic fn). NOT yet runnable — the first `send` schedules it.
spawn_actor*<ActorT> = (
    cap: i64,
    actor: ActorT,
    tramp: (RawPtr<u8>, i64) void,
    art: Rt,
) PooledHandle<ActorT> {
    try_spawn_actor(cap, actor, tramp, art).expect("pool_actor: actor spawn allocation failed")
}
// spawn_actor with allocation failure as a VALUE. `spawn_actor` KEEPS its `PooledHandle<ActorT>` return
// (17 call sites across 13 files, incl. std.net.http_actor, which RETURNS the handle and would have to grow
// a Result of its own) and becomes a thin `.expect` over this — so an OOM at spawn is a checked, diagnosable
// abort for every existing caller, and a `.Err(.Oom)` value for anyone who asks for it.
// The caller that genuinely benefits is `supervise`, and it is wired through: `try_start_child` /
// `try_supervise` (below) carry the failure as a value, `start_child` / `supervise` stay `.expect` wrappers.
// That is ADDITIVE — `Child<ActorT>` is unchanged and not one of the 17 call sites moved — because the thing
// a supervisor needs is a failed RESTART as a value, which is a widening of the RETURN, not of the handle.
try_spawn_actor*<ActorT> = (
    cap: i64,
    actor: ActorT,
    tramp: (RawPtr<u8>, i64) void,
    art: Rt,
) Result<PooledHandle<ActorT>, ActorError> {
    try_spawn_actor_scratch(cap, actor, tramp, art, null_ptr())
}    // no scratch — identical to the pre-scratch spawn path
// spawn a typed actor with the process DEFAULT ambient rt (heap unless the program called
// `rt.set_default`) — the trivial-setup path. Inherits the whole program's chosen runtime.
// A top-level `spawn` alias is intentionally NOT provided — it would flatten-collide with
// std.thread.spawn from pool.zen. Future: Sys Spawner capability.
spawn_actor_heap*<ActorT> = (
    cap: i64,
    actor: ActorT,
    tramp: (RawPtr<u8>, i64) void,
) PooledHandle<ActorT> { spawn_actor(cap, actor, tramp, default()) }
// ── PER-ACTOR SCRATCH (the two-memory model, S4-lite) ─────────────────────────────────────────────
// `new_scratch(cap)` allocates a bump arena the actor uses for its OWN per-behavior temporaries: the
// worker RESETS it wholesale at every behavior boundary (pool.zen drain_batch), on the NORMAL stack,
// whether the behavior returned or PANICKED — so nothing bump-allocated in `receive` can leak, ever. The
// arena struct + its backing live in ONE heap block (buf points just past the struct), so `free_scratch`
// is one release. The actor reaches it as `self.scratch` (a MutPtr<Arena> field on its OWN state), and
// the SAME pointer is handed to the pool via `spawn_actor_scratch` so the pool can reset it — one arena,
// two borrows. Scratch is NEVER for anything that crosses a send: a sent message outlives the sender's
// behavior (the receiver reads it off-thread after the reset), so messages stay heap-boxed by `send`/
// `ref_send_msg`. The scratch-escape checker rejects routing a scratch pointer out through any send.
new_scratch* = (cap: i64) MutPtr<Arena> {
    try_new_scratch(cap).expect("pool_actor: scratch arena allocation failed")
}
// new_scratch with allocation failure as a VALUE. `MutPtr<Arena>` cannot BE the value channel here even
// though a null pointer is spellable: `null` scratch already MEANS "this actor opted out of scratch"
// (pool.zen's scratch_reset is null-guarded), so returning null on OOM would silently downgrade an actor
// into one whose `self.scratch.bump(...)` writes through null on its first behavior — a worse crash,
// further from the cause. Hence a real Result, with `new_scratch` kept as an `.expect` wrapper so the
// 4 existing call sites are untouched.
try_new_scratch* = (cap: i64) Result<MutPtr<Arena>, ActorError> {
    blk = heap_acquire(null_ptr(), sizeof(Arena) + cap)
    is_null(blk).match ({
        true  => .Err(ActorError.Oom),
        false => {
            ar :: [Arena] = blk.slice(1)
            ar[0] = Arena(
                buf: blk.offset(sizeof(Arena)),
                off: 0,
                cap: cap,
            )
            .Ok(ar[0].addr())
        },
    })
}
// free a scratch arena (call after the actor is closed and the pool has quiesced — no worker will reset
// it again). One block backs the struct + the bump region: `sc.buf` sits sizeof(Arena) past the block
// base, so `sc.buf - sizeof(Arena)` recovers the acquired block. Releasing a RawPtr<u8> (not `sc`
// itself) also disambiguates from Arena's own `free` method.
free_scratch* = (sc: MutPtr<Arena>) void {
    heap_release(null_ptr(), sc.buf.offset(0 - sizeof(Arena)))
}
// spawn a typed actor WITH a per-behavior scratch arena `sc` (from `new_scratch`). The actor stores the
// same `sc` in its state as `scratch: MutPtr<Arena>` (so `receive` bump-allocates via `self.scratch`), and
// the pool holds it too (so it resets it at each behavior boundary). Everything else is `spawn_actor`.
spawn_actor_scratch<ActorT> = (
    cap: i64,
    actor: ActorT,
    tramp: (RawPtr<u8>, i64) void,
    art: Rt,
    sc: MutPtr<Arena>,
) PooledHandle<ActorT> {
    try_spawn_actor_scratch(cap, actor, tramp, art, sc).expect("pool_actor: actor spawn allocation failed")
}
// THE spawn: the whole typed-actor spawn path with allocation failure as a VALUE. Two allocations can
// fail — the actor-state block here, and the pool's actor block / mailbox ring inside
// `pool_try_spawn_scratch_rt` — and each unwinds the other, so `.Err(.Oom)` leaks nothing and leaves no
// half-registered actor for a worker to find. `sc` is a BORROW the caller owns either way (a failed
// spawn does not release it). Typed messages are process-heap box pointers, hence `pool_actor_set_boxed` — a
// dead actor's backlog is freed, not leaked.
try_spawn_actor_scratch*<ActorT> = (
    cap: i64,
    actor: ActorT,
    tramp: (RawPtr<u8>, i64) void,
    art: Rt,
    sc: MutPtr<Arena>,
) Result<PooledHandle<ActorT>, ActorError> {
    state = heap_acquire(null_ptr(), sizeof(ActorT))
    is_null(state).match ({
        true  => .Err(ActorError.Oom),
        false => {
            slot :: [ActorT] = state.slice(1)
            slot[0] = actor
            raw = pool_try_spawn_scratch_rt(state, cap, tramp, art, sc)
            is_null(raw).match ({
                true  => {
                    heap_release(null_ptr(), state)
                    .Err(ActorError.Oom)
                },    // the pool block failed AFTER the state block landed — unwind it
                false => {
                    pool_actor_set_boxed(raw)
                    .Ok(PooledHandle<ActorT>(
                        raw: raw,
                        state: state,
                    ))
                },
            })
        },
    })
}
// scratch-spawn under the process DEFAULT ambient rt (the trivial-setup path, mirrors spawn_actor_heap).
spawn_actor_scratch_heap*<ActorT> = (
    cap: i64,
    actor: ActorT,
    tramp: (RawPtr<u8>, i64) void,
    sc: MutPtr<Arena>,
) PooledHandle<ActorT> { spawn_actor_scratch(cap, actor, tramp, default(), sc) }
// send a typed message to a pooled actor. The message must OUTLIVE the send (a worker consumes it
// later, off-thread), so it is heap-BOXED (`[M]` block) and the box POINTER rides as the pool's i64
// payload (to_i64 → the trampoline recovers it with `msg.offset(0).slice(1)` and frees it via free_msg).
// Returns `.Err(.MailboxFull)` + reclaims the box if the mailbox is full (back-pressure as a value; the
// pool tallies the drop in its dead-letter counter), or `.Err(.Oom)` if the BOX ITSELF could not be
// allocated — the message was never boxed, so there is nothing to reclaim and nothing to dead-letter.
// The null check is what makes OOM a value here: `slot[0] = msg` would otherwise write M through a NULL
// box (the mailbox-full case was already a value in this very function, the exhausted-heap case was a
// segfault). The caller MAY discard the Result.
send*<M, ActorT> = (p: MutPtr<Pool>, h: PooledHandle<ActorT>, msg: M) Result<i64, ActorError> {
    box = heap_acquire(null_ptr(), sizeof(M))
    is_null(box).match ({
        true  => .Err(ActorError.Oom),
        false => {
            slot :: [M] = box.slice(1)
            slot[0] = msg
            p.pool_send(h.raw, to_i64(box)).match ({
                .Ok(n)  => .Ok(n),
                .Err(e) => {
                    heap_release(null_ptr(), box)
                    .Err(e)
                },
            })
        },
    })
}
// an ActorRef addressing this handle on pool `p` — the SENDABLE reply-address a requester embeds in a
// request message so the handler can reply from inside `receive` (where it has no `p`/`h`). Construct it
// at spawn/setup, put it in the message: `p.send(server, .Req(n, client.ref_of(p)))`.
ref_of*<ActorT> = (h: PooledHandle<ActorT>, p: MutPtr<Pool>) ActorRef { p.actor_ref(h.raw) }
// TYPED send to an ActorRef (the reply primitive): box the message like `send`, ride the box pointer as
// the i64 payload, hand it to the raw `ref_send`. Reclaims the box + returns `.Err(.MailboxFull)` on a
// full mailbox, `.Err(.Oom)` when the box itself could not be allocated (same widening as `send`).
// This is a recognized send surface in the sendability checker (check_validate.zen), so a MutPtr-carrying
// reply is rejected exactly like `send`/`pool_send`. Distinct name (no fn overloading) → UFCS reads
// `reply_to.ref_send_msg(Response(...))`.
ref_send_msg*<M> = (r: ActorRef, msg: M) Result<i64, ActorError> {
    box = heap_acquire(null_ptr(), sizeof(M))
    is_null(box).match ({
        true  => .Err(ActorError.Oom),
        false => {
            slot :: [M] = box.slice(1)
            slot[0] = msg
            r.ref_send(to_i64(box)).match ({
                .Ok(n)  => .Ok(n),
                .Err(e) => {
                    heap_release(null_ptr(), box)
                    .Err(e)
                },
            })
        },
    })
}
// typed accessor for the actor's final state (read after quiescence, e.g. in tests/assertions).
actor_state*<ActorT> = (h: PooledHandle<ActorT>) MutPtr<ActorT> {
    slot: [ActorT] = h.state.slice(1)
    slot[0].addr()
}
// close a typed handle: drop the pool actor's Arc reference (frees the pool block when it was the last)
// then free the actor-state block. Call after pool_quiesce_stop, like the raw pool's pool_actor_free.
// (Named `close`, not `free`, so it does not shadow the imported alloc `free` — Zen has no overloading.)
close*<ActorT> = (h: PooledHandle<ActorT>) void {
    pool_actor_free(h.raw)
    heap_release(null_ptr(), h.state)
}
// ── SUPERVISION (S5): declarative child specs + restart-on-crash ─────────────────────────────────────
// The capstone of the actor/agent-OS north star: an agent that CRASHES gets RESTARTED by a supervisor and
// keeps working. Built entirely on the observability + backlog-free primitives in pool.zen (pool_actor_dead,
// the dead-letter counter) plus the retained spec below — no new runtime, no ABI change.
//
// Restart POLICY (OTP-style): `Permanent` always restarts a dead child; `Temporary` never does (it stays
// dead, observably). Transient (restart only on ABNORMAL exit) is omitted — a pool actor has no "normal
// exit" signal (it idles, it does not return), so Transient would be indistinguishable from Permanent here.
Policy*: Permanent | Temporary
// policy constructors — spelled as fns so a caller in ANOTHER module never has to write a module-qualified
// enum-variant literal (`pa.Policy.Permanent`), which the faithful formatter does not round-trip.
permanent* = () Policy { Policy.Permanent }
temporary* = () Policy { Policy.Temporary }
// A CHILD SPEC is the RETAINED, declarative recipe to (re)run an actor: a COPY of its initial state VALUE,
// its mailbox cap, its trampoline, its ambient rt, and its restart policy. It is pure DATA — a restart is
// just "spawn_actor(this spec) again", so a crashed child is reborn as a NEW actor with FRESH state (its
// dead instance's in-flight/queued messages are DROPPED — at-most-once, no replay; state that must survive a
// crash lives OUTSIDE the actor, reached through a shared pointer in the initial value, e.g. a counter block).
// SOUNDNESS: `initial` is a sendable ActorT value copied at spec-build time; it must NOT capture a scratch
// pointer (scratch is per-behavior, reset every turn — a retained scratch ptr would dangle across a restart).
// A supervised actor therefore uses shared/heap state, never scratch, in its retained initial value.
ChildSpec*<ActorT>: {
    cap: i64,
    initial: ActorT,
    tramp: (RawPtr<u8>, i64) void,
    art: Rt,
    policy: Policy,
}
// build a child spec under the process DEFAULT ambient rt (the common case; mirrors spawn_actor_heap).
child_spec*<ActorT> = (
    cap: i64,
    initial: ActorT,
    tramp: (RawPtr<u8>, i64) void,
    policy: Policy,
) ChildSpec<ActorT> {
    ChildSpec<ActorT>(
        cap: cap,
        initial: initial,
        tramp: tramp,
        art: default(),
        policy: policy,
    )
}
// A supervised child: its CURRENT live handle, how many times it has been restarted, and the retained spec
// used to (re)spawn it. `supervise` returns a fresh Child on restart (Zen values are immutable rebinds) —
// the caller keeps the returned Child and sends to `child.handle`.
Child*<ActorT>: {
    handle: PooledHandle<ActorT>,
    restarts: i64,
    spec: ChildSpec<ActorT>,
}
// (re)spawn an actor from its retained spec — a fresh actor with a fresh COPY of the initial state.
try_spawn_from_spec<ActorT> = (spec: ChildSpec<ActorT>) Result<PooledHandle<ActorT>, ActorError> {
    try_spawn_actor(spec.cap, spec.initial, spec.tramp, spec.art)
}
// START a supervised child: spawn it from its spec (not yet runnable — the first `send` schedules it).
start_child*<ActorT> = (spec: ChildSpec<ActorT>) Child<ActorT> {
    try_start_child(spec).expect("pool_actor: actor spawn allocation failed")
}
// start_child with the spawn failure as a VALUE — the entry half of restart-as-a-value (see try_supervise).
try_start_child*<ActorT> = (spec: ChildSpec<ActorT>) Result<Child<ActorT>, ActorError> {
    try_spawn_from_spec(spec).match ({
        .Ok(h)  => .Ok(Child<ActorT>(
            handle: h,
            restarts: 0,
            spec: spec,
        )),
        .Err(e) => .Err(e),
    })
}
// SUPERVISE one child: if its actor is alive, return it unchanged; if it is DEAD, apply the policy —
// Temporary leaves it dead (observable), Permanent frees the dead instance (Arc-decrement + state free via
// `close`) and re-runs the retained spec into a FRESH actor, returning the new Child (restart count bumped).
// Call after the pool has quiesced (pool_quiesce) so the dead instance has finished draining its backlog —
// then `close` races no worker. The returned Child's `handle` addresses the live (restarted or original) actor.
// A restart that cannot ALLOCATE still aborts here (the `.expect`); `try_supervise` is the value form.
supervise*<ActorT> = (c: Child<ActorT>) Child<ActorT> {
    try_supervise(c).expect("pool_actor: child restart allocation failed")
}
// RESTART AS A VALUE. This is the caller that actually needs it: a restart happens MID-RUN, under exactly
// the memory pressure that killed the child, so "the supervisor could not revive the agent" is a condition
// a supervisor must be able to act on (shed load, restart later, escalate to its own supervisor) rather
// than a process-wide abort. `Child<ActorT>` itself does NOT widen — only the RETURN does.
//
// ORDER MATTERS, and it is deliberately spawn-BEFORE-free: the dead instance's pool block + state block are
// released only once the replacement exists. So on `.Err` the caller's OWN `c` — a value it still holds,
// since Zen rebinds rather than mutates — is untouched and still valid: it can retry `try_supervise(c)`
// after shedding load, or `close` the child and give up. Freeing first would hand back an `.Err` alongside a
// Child whose handle is already freed, i.e. an un-retryable, un-closable value — actionable in name only.
// The cost is one actor's worth of peak memory during the swap, which is the price of a retryable failure.
try_supervise*<ActorT> = (c: Child<ActorT>) Result<Child<ActorT>, ActorError> {
    pool_actor_dead(c.handle.raw).match ({
        true  => c.spec.policy.match ({
            .Temporary => .Ok(c),
            .Permanent => try_spawn_from_spec(c.spec).match ({
                .Ok(h)  => {
                    pool_actor_free(c.handle.raw)    // drop the dead instance's Arc ref (frees its pool block)
                    heap_release(null_ptr(), c.handle.state)
                    .Ok(Child<ActorT>(
                        handle: h,
                        restarts: c.restarts + 1,
                        spec: c.spec,
                    ))
                },    // free the dead instance's state block (same as `close`, inlined —
                .Err(e) => .Err(e),
            }),
        }),    // `close` unqualified would flatten-collide with libc's `close`)
        false => .Ok(c),
    })
}
// is this supervised child's actor currently dead? (thin typed wrapper over pool_actor_dead for the handle.)
child_dead<ActorT> = (c: Child<ActorT>) bool { pool_actor_dead(c.handle.raw) }
// reclaim a delivered message box — call from the trampoline AFTER `receive` returns. (The box was
// acquired by `send`; release happens on the worker through the same process-heap floor, so the
// actor's ambient rt is irrelevant to the transport box — it governs allocations inside `receive`.)
free_msg* = (msg: i64) void { heap_release(null_ptr(), msg.offset(0)) }
// the whole trampoline body, generic: reconstitute actor state + boxed message, run the typed
// `receive` (trait dispatch, deferred to mono like actor.zen's drain), reclaim the box. The user's
// concrete stub shrinks to one line — `tramp = (user: RawPtr<u8>, msg: i64) void
// { dispatch<Counter, Msg>(user, msg) }` (destructure `dispatch`; explicit tparams are required,
// nothing in the args pins ActorT/M) — keeping all raw-pointer surgery here in the stdlib. The stub
// itself must STAY concrete (generic fns are inlined, so their address cannot be taken).
dispatch*<ActorT, M> = (user: RawPtr<u8>, msg: i64) void {
    a: [ActorT] = user.slice(1)
    b: [M] = msg.offset(0).slice(1)
    __zen_actor_set_inflight(msg)
    b.loop_at((i, m) { a[0].addr().receive(Context<M>(msg: m)) })    // record the box: a panic in `receive` below is caught in zenrt.c, which frees it
    free_msg(msg)
    __zen_actor_set_inflight(0)
}    // box freed normally; clear so the panic catch never double-frees
