// Strings, characters, escapes and numbers. Invalid spellings are rejected
// rather than reinterpreted (`010` is not octal and `"\q"` is not `"q"`).
// Recoverable faults may still emit a token; unterminated or unrepresentable
// literals do not.

Lexer = std.lex.lex_state
Pos, TokenKind = std.lex.lex_token
LexFault = std.lex.lex_diag
is_escape = std.lex.lex_byte
AllocError = std.mem
str = std.text

// String line/end faults are anchored at the opening quote.
string* = (lx :: Lexer) Res<(), AllocError> {
    from = lx.cur.pos();
    lx.cur.bump();
    loop((h) {
        lx.cur.peek().match({
            None     => { lx.report(
                LexFault.UnterminatedString,
                from
            ).try(); h.break(); },
            Ok('\n') => { lx.report(
                LexFault.StringSpansLine,
                from
            ).try(); h.break(); },
            // Avoid reporting the same end-of-file escape twice.
            Ok('\\') => {
                reported = lx.escape().try();
                (lx.cur.is_done() && reported).then(() { h.break(); });
            },
            Ok('"')  => { lx.cur.bump(); lx.emit(
                TokenKind.Str,
                from
            ).try(); h.break(); },
            Ok(_)    => { lx.cur.bump(); },
        });
    });
    Ok(());
}

// Character literals contain exactly one byte, not one Unicode code point.
character* = (lx :: Lexer) Res<(), AllocError> {
    from = lx.cur.pos();
    lx.cur.bump();
    lx.cur.peek().match({
        None     => lx.report(LexFault.UnterminatedChar, from),
        Ok('\n') => lx.report(LexFault.CharSpansLine, from),
        Ok('\'') => { lx.cur.bump(); lx.report(LexFault.EmptyChar, from) },
        // Avoid duplicating an end-of-file escape diagnostic.
        Ok('\\') => {
            reported = lx.escape().try();
            (lx.cur.is_done() && reported).match({
                true  => Ok(()),
                false => lx.close_char(from),
            })
        },
        Ok(_)    => { lx.cur.bump(); lx.close_char(from) },
    });
}

close_char = (lx :: Lexer, from: Pos) Res<(), AllocError> {
    lx.cur.at_byte('\'').match({
        true  => { lx.cur.bump(); lx.emit(TokenKind.Char, from) },
        false => lx.overlong_char(from),
    });
}

// Consume through the literal boundary after an overlong character.
overlong_char = (lx :: Lexer, from: Pos) Res<(), AllocError> {
    lx.cur.bump_while((b) { (b != '\'') && (b != '\n') });
    lx.cur.peek().match({
        Ok('\'') => { lx.cur.bump(); lx.report(LexFault.CharTooLong, from) },
        Ok(_)    => lx.report(LexFault.CharSpansLine, from),
        None     => lx.report(LexFault.UnterminatedChar, from),
    });
}

// Validate one escape and report whether this operation emitted a diagnostic.
// Newlines are left for the enclosing literal to diagnose.
escape* = (lx :: Lexer) Res<bool, AllocError> {
    from = lx.cur.pos();
    lx.cur.bump();
    lx.cur.peek().match({
        None     => { lx.report(LexFault.UnterminatedEscape, from); Ok(true) },
        // Newlines are not escapable and Zen has no line continuation. Keep
        // LF, or the CR of CRLF, for the caller to report as a literal that
        // spans a line. A lone CR remains an ordinary unknown escape.
        Ok('\n') => Ok(false),
        Ok('\r') => lx.cur.at_byte(1, '\n').match({
            true  => Ok(false),
            false => { lx.cur.bump(); lx.report(LexFault.UnknownEscape, from); Ok(true) },
        }),
        Ok(b)    => {
            lx.cur.bump();
            is_escape(b).match({
                false => { lx.report(LexFault.UnknownEscape, from); Ok(true) },
                true  => Ok(false),
            })
        },
    });
}

// Numbers are decimal, with no exponent, separators, or type suffix.
number* = (lx :: Lexer) Res<(), AllocError> {
    from = lx.cur.pos();
    lx.cur.bump_while((b) { b.is_digit() });
    whole = lx.since(from);

    // Zen has no octal, so a leading zero is rejected rather than re-read.
    has_leading_zero(whole).match({
        true  => lx.report(LexFault.LeadingZero, from),
        false => Ok(()),
    }).try();

    is_float = lx.fraction().try();

    lx.suffix().try();

    is_float.match({
        true  => lx.emit(TokenKind.Float, from),
        false => lx.emit_int(whole, from),
    });
}

// A decimal point must be followed by a digit.
fraction = (lx :: Lexer) Res<bool, AllocError> {
    lx.cur.at_byte('.').match({
        true  => lx.after_dot(),
        false => Ok(false),
    });
}

after_dot = (lx :: Lexer) Res<bool, AllocError> {
    dot           = lx.cur.pos();
    digit_follows = lx.cur.peek(
        1
    ).match({ Ok(b) => b.is_digit(), None => false });
    lx.cur.bump();
    digit_follows.match({
        false => lx.report(LexFault.FloatNeedsDigit, dot),
        true  => Ok(()),
    }).try();
    lx.cur.bump_while((b) { b.is_digit() });
    Ok(digit_follows);
}

// Reject identifier suffixes, including unsupported hexadecimal notation.
suffix = (lx :: Lexer) Res<(), AllocError> {
    at = lx.cur.pos();
    lx.cur.bump_while((b) { b.is_ident_cont() });
    (lx.cur.pos().offset > at.offset).match({
        true  => lx.report(LexFault.SuffixOnNumber, at),
        false => Ok(()),
    });
}

// Values beyond u64 produce a fault and no token.
emit_int = (lx :: Lexer, whole: str, from: Pos) Res<(), AllocError> {
    digits = digits_of(whole);
    digits.overflow.match({
        true  => lx.report(LexFault.IntegerOutOfRange, from),
        false => lx.emit(TokenKind.Int(digits.value), from),
    });
}

has_leading_zero = (whole: str) bool { (whole.len > 1) && (whole[0] == '0') }

Digits* = {
    value*: u64,
    overflow*: bool,
}

// Detect source overflow before arithmetic can trap.
digits_of* = (s: str) Digits {
    Range(0, s.len).loop(Digits(value: 0, overflow: false), (h, i, at, acc: Digits) {
        add_digit(acc, s[at])
    }).match({
        Ok(digits) => digits,
        None       => Digits(value: 0, overflow: false),
    });
}

// `acc * 10 + d` overflows when `acc > (u64.MAX - d) / 10`.
add_digit = (acc: Digits, b: u8) Digits {
    d = (b - '0').to_u64();
    (acc.overflow || (acc.value > (u64.MAX - d) / 10)).match({
        true  => Digits(value: 0, overflow: true),
        false => Digits(value: acc.value * 10 + d, overflow: false),
    });
}
