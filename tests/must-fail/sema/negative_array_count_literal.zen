// A fixed-array length is a count, so its compile-time value is never
// negative. The diagnostic belongs to the count expression itself; the
// unknown recovery type prevents the initializer and index from cascading.

main = (env: Env) Res<i32, AllocError> {
    values: [u8, -1] = [1, 2];
    println("{}", values[0]);
    Ok(0);
}
