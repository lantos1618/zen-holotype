// std.atomic wrapper correctness (single-thread): load/store round-trip, fetch-add, a CAS spin to
// 1000, the CAS failure path (returns false, value untouched), fetch_add_cas returning the PRIOR
// value, a fence, and an AtomicBool round-trip. Exit 42 on success; exit N (1-4) identifies the
// first failing check group — real assertions, no eyeballing. Replaces the retired
// tests/atomic_test.zen, which printed values and exited 0 unconditionally.
atomic = std.concurrent.atomic
raw = std.mem.raw
// spin a CAS loop to increment the cell `n` times; returns final value.
spin = (a: atomic.AtomicI64, n: i64) i64 {
    (n <= 0).match ({
        true  => a.load(),
        false => {
            cur := a.load()
            a.cas(cur, cur + 1) ? spin(a, n - 1) : spin(a, n)
        },
    })
}    // contention retry (no contention single-thread)
main = () i32 {
    cell := raw.alloc(8)
    a := atomic.at(cell)
    // 1) load/store round-trip + fetch-add (add returns the NEW value)
    a.store(42)
    r1 := a.load()
    a.store(0)
    nv := a.add(5)
    nv2 := a.add(0 - 2)
    // 2) CAS spin counter: 0 -> 1000
    a.store(0)
    fin := spin(a, 1000)
    // 3) CAS failure path: expected mismatch returns false, value unchanged; matching CAS swaps
    a.store(7)
    bad := a.cas(999, 123)
    after_bad := a.load()
    good := a.cas(7, 8)
    after_good := a.load()
    // 4) fetch_add_cas helper (returns PRIOR value) + fence + AtomicBool round-trip
    a.store(100)
    prior := a.fetch_add_cas(11)
    after_fa := a.load()
    atomic.afence()
    bcell := raw.alloc(8)
    b := atomic.bool_at(bcell)
    b.store(true)
    b1 := b.load()
    bswap := b.cas(true, false)
    b2 := b.load()
    raw.release(cell)
    raw.release(bcell)
    (r1 == 42 && nv == 5 && nv2 == 3).match ({
        true  => (fin == 1000).match ({
            true  => (bad == false && after_bad == 7 && good && after_good == 8).match ({
                true  => prior == 100 && after_fa == 111 && b1 && bswap && b2 == false ? 42 : 4,
                false => 3,
            }),
            false => 2,
        }),
        false => 1,
    })
}
