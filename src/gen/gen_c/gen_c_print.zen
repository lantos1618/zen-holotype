// Lower `print`/`println` and Console writes to the C output floors. Format
// holes are type-directed; non-primitive values write through `Display`.
// Output helpers do not allocate in the generated program.

ExprId, Literal = std.ast
Call, Arg, Span, Pos = std.ast
AllocError = std.mem
str, String = std.text
Range = std.core
is_ident_start, is_ident_cont = std.core
TyId, is_float = sema.sema_ty
Ctx = sema.sema_check
GenFault = gen.gen_diag
sym_variant, RES_PATH = gen.gen_name
CBackend = gen.gen_c.gen_c_state
is_c_integer, is_signed, ctype = gen.gen_c.gen_c_type
expr, ty_of, named_hole = gen.gen_c.gen_c_expr
console_display, stderr_console = gen.gen_c.gen_c_display

// `print` omits the trailing newline.
is_print* = (name: str) bool { name.eq("println") || name.eq("print") }

// Console exposes one newline-writing member per stream.
is_console_print* = (name: str) bool {
    name.eq("println") || name.eq("errorln")
}

// Keep stdout and stderr independently redirectable.
stream_of = (name: str) str {
    name.eq("println").match({
        true  => "stdout",
        false => "stderr",
    })
}

// Select matching helpers from the stdout/stderr runtime families.
pair = (stream: str, stdout: str, stderr: str) str {
    stream.eq("stderr").match({
        true  => stderr,
        false => stdout,
    })
}

// Writes are statements; the expression result is unit.
lower_print* = (be :: CBackend, c: Call, name: str, ctx: Ctx, out :: String)
               Res<(), AllocError> {
    write_pieces(be, c, name, "stdout", ctx).try();
    out.add("0")
}

// Console calls share the same variadic expansion, but return their declared
// `Res<(), IoError>` as `Ok`. The authority-only receiver has no C value.
lower_console_print* = (
    be   :: CBackend,
    c    : Call,
    name : str,
    ret  : TyId,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    stream = stream_of(name);
    write_pieces(be, c, name, stream, ctx).try();
    cty ::= be.alloc.String().try();
    be.ctype(ret, cty).try();
    out.fmt("(({}){ .zg_tag = ", cty.view()).try();
    sym_variant(out, RES_PATH, "Ok").try();
    out.add(" })")
}

lower_console_flush* = (
    be  :: CBackend,
    ret : TyId,
    out :: String
) Res<(), AllocError> {
    be.need_print();
    cty ::= be.alloc.String().try();
    be.ctype(ret, cty).try();
    out.fmt("(fflush(stdout), (({}){{ .zg_tag = ", cty.view()).try();
    sym_variant(out, RES_PATH, "Ok").try();
    out.add(" }))")
}

write_pieces = (
    be     :: CBackend,
    c      : Call,
    name   : str,
    stream : str,
    ctx    : Ctx
) Res<(), AllocError> {
    stream.eq("stdout").then(() { be.need_print(); });
    stream.eq("stderr").then(() { be.need_stderr(); });
    write_args(be, c, stream, ctx).try();
    is_console_print(name).then(() {
        be.writeln(pair(stream, "zg_print_nl();", "zg_eprint_nl();")).try()
    });
    Ok(());
}

write_args = (
    be     :: CBackend,
    c      : Call,
    stream : str,
    ctx    : Ctx
) Res<(), AllocError> {
    c.args.get(0).match({
        None  => Ok(()),
        Ok(a) => write_from(be, c, a, stream, ctx),
    })
}

// Only a leading string literal is interpreted as a format.
write_from = (
    be     :: CBackend,
    c      : Call,
    first  : Arg,
    stream : str,
    ctx    : Ctx
) Res<(), AllocError> {
    format_of(be, first.value).match({
        Ok(raw) => write_format(be, c, first.value, raw, stream, ctx),
        None    => write_values(be, c, 0, stream, ctx),
    })
}

// Return the raw, quoted source slice of a string literal.
format_of = (be :: CBackend, id: ExprId) Res<str> {
    be.tree.expr_at(id).kind.match({
        Literal(l) => literal_format(l),
        _          => None,
    })
}

literal_format = (l: Literal) Res<str> {
    l.kind.match({
        Str => Ok(l.text),
        _   => None,
    })
}

// Write every value argument from `from` onward.
write_values = (
    be     :: CBackend,
    c      : Call,
    from   : usize,
    stream : str,
    ctx    : Ctx
) Res<(), AllocError> {
    Range(from, c.args.len).loop((h, i) {
        write_value_at(be, c, i, stream, ctx).try();
    });
    Ok(());
}

write_value_at = (
    be     :: CBackend,
    c      : Call,
    i      : usize,
    stream : str,
    ctx    : Ctx
) Res<(), AllocError> {
    c.args.get(i).match({
        None  => Ok(()),
        Ok(a) => write_value(be, a.value, stream, ctx),
    })
}

// Walk the raw literal so Zen escapes can pass unchanged to equivalent C
// escapes. Doubled braces end a chunk inside the pair and emit one brace.

write_format = (
    be     :: CBackend,
    c      : Call,
    id     : ExprId,
    raw    : str,
    stream : str,
    ctx    : Ctx
) Res<(), AllocError> {
    end = body_end(raw);
    start ::= 1;
    used  ::= 1;
    i     ::= 1;
    loop(i < end, (h) {
        at = fmt_at(raw, i, end);
        at.ends_run().then(() {
            write_piece(be, raw, start, at.keep, stream).try();
            write_what(be, c, id, at, used, stream, ctx).try();
            used  = used + at.what.arguments_taken();
            start = at.next;
        });
        i = at.next;
    });
    write_piece(be, raw, start, end, stream).try();
    write_surplus(be, c, used, stream, ctx).try();
    Ok(());
}

// Report arguments left after the final hole.
write_surplus = (
    be     :: CBackend,
    c      : Call,
    used   : usize,
    stream : str,
    ctx    : Ctx
) Res<(), AllocError> {
    (used < c.args.len).match({
        false => Ok(()),
        true  => c.args.get(used).match({
            None  => Ok(()),
            Ok(a) => be.report_expr(
                a.value,
                GenFault.Unsupported(ARGUMENT_WITHOUT_HOLE)
            ),
        }),
    })
}

// Write the action classified at one format position.
write_what = (
    be     :: CBackend,
    c      : Call,
    id     : ExprId,
    at     : FmtAt,
    used   : usize,
    stream : str,
    ctx    : Ctx
) Res<(), AllocError> {
    at.what.match({
        Hole     => write_hole(be, c, id, at, used, stream, ctx),
        Named(n) => write_named(be, id, at, n, stream),
        NoName   => report_in_format(
            be,
            id,
            at,
            GenFault.Unsupported(NOT_A_HOLE)
        ),
        _        => Ok(()),
    })
}

// Named and positional holes share type-directed value writing.
write_named = (
    be     :: CBackend,
    id     : ExprId,
    at     : FmtAt,
    name   : str,
    stream : str
) Res<(), AllocError> {
    text ::= be.alloc.String().try();
    be.named_hole(name, text).try().match({
        None  => report_in_format(be, id, at, GenFault.Unresolved(name)),
        Ok(t) => write_typed(
            be,
            id,
            t,
            be.check.prim_name(t),
            text.view(),
            stream
        ),
    })
}

// Classification shared with sink formatting. `keep` ends the preceding
// chunk and `next` resumes the scan.

FmtWhat* = Byte           // an ordinary byte: the literal run goes on
         | Hole           // `{}`, filled by the next argument
         | Pair           // `{{` or `}}`: the run keeps ONE of the two
         | Named(str)     // `{name}`, filled by that name's binding
         | NoName         // a `{` that meant a hole and closed on nothing

FmtAt* = {
    what*: FmtWhat,
    keep*: usize,     // one past the last byte the run before this keeps
    next*: usize,     // where the walk resumes
}

// Only `Byte` continues the current literal chunk.
ends_run* = (at: FmtAt) bool {
    at.what.match({ Byte => false, _ => true })
}

// Named holes carry their own value; only positional holes consume arguments.
arguments_taken* = (what: FmtWhat) usize {
    what.match({ Hole => 1, _ => 0 })
}

fmt_at* = (raw: str, i: usize, end: usize) FmtAt {
    is_hole(raw, i, end).match({
        true  => FmtAt(what: FmtWhat.Hole, keep: i, next: i + 2),
        false => at_no_hole(raw, i, end),
    })
}

// Doubled braces are literal escapes.
at_no_hole = (raw: str, i: usize, end: usize) FmtAt {
    is_doubled_brace(raw, i, end).match({
        true  => FmtAt(what: FmtWhat.Pair, keep: i + 1, next: i + 2),
        false => at_no_pair(raw, i, end),
    })
}

// A named hole accepts an identifier, not an arbitrary expression.
at_no_pair = (raw: str, i: usize, end: usize) FmtAt {
    opens_name(raw, i, end).match({
        false => FmtAt(what: FmtWhat.Byte, keep: i, next: i + step_of(raw, i)),
        true  => at_ident(raw, i, end, ident_end(raw, i + 1, end)),
    })
}

at_ident = (raw: str, i: usize, end: usize, j: usize) FmtAt {
    ((j < end) && raw.index(j) == '}').match({
        true  => FmtAt(
            what: FmtWhat.Named(raw.slice(i + 1, j)),
            keep: i,
            next: j + 1
        ),
        false => FmtAt(what: FmtWhat.NoName, keep: i, next: i + 1),
    })
}

// Index after the literal body, before the closing quote.
body_end* = (raw: str) usize {
    (raw.len > 1).match({ true => raw.len - 1, false => 1 })
}

is_hole = (raw: str, i: usize, end: usize) bool {
    (i + 1 < end) && raw.index(i) == '{' && raw.index(i + 1) == '}'
}

is_doubled_brace = (raw: str, i: usize, end: usize) bool {
    (i + 1 < end) && raw.index(i) == raw.index(i + 1)
        && (raw.index(i) == '{' || raw.index(i) == '}')
}

opens_name = (raw: str, i: usize, end: usize) bool {
    (i + 1 < end) && raw.index(i) == '{'
        && raw.index(i + 1).is_ident_start()
}

// Use the language's identifier predicates for named holes.
ident_end = (raw: str, from: usize, end: usize) usize {
    j ::= from;
    loop(() { (j < end) && raw.index(j).is_ident_cont() }, (h) {
        j = j + 1;
    });
    j
}

// Stable diagnostics shared by console and sink formatting.
NOT_A_HOLE* : str = "a format hole is {} or {name}, and this is neither"

HOLE_WITHOUT_ARGUMENT* : str = "a format hole with no argument left"

ARGUMENT_WITHOUT_HOLE* : str = "an argument with no format hole left"

// Format faults point at the offending byte. String literals cannot span
// source lines, so a raw byte offset is also a column offset.

report_in_format* = (
    be    :: CBackend,
    id    : ExprId,
    at    : FmtAt,
    fault : GenFault
) Res<(), AllocError> {
    lit = be.tree.expr_at(id).span;
    be.report(lit.file, at_span(lit, at.keep, at.next), fault)
}

at_span = (lit: Span, from: usize, to: usize) Span {
    Span(
        file: lit.file,
        start: Pos(line: lit.start.line, col: lit.start.col + from),
        end:   Pos(line: lit.start.line, col: lit.start.col + to)
    )
}

step_of = (raw: str, i: usize) usize {
    (raw.index(i) == '\\').match({ true => 2, false => 1 })
}

// A hole without a value is a compile error at the hole.
write_hole = (
    be     :: CBackend,
    c      : Call,
    id     : ExprId,
    at     : FmtAt,
    used   : usize,
    stream : str,
    ctx    : Ctx
) Res<(), AllocError> {
    c.args.get(used).match({
        None  => report_in_format(
            be,
            id,
            at,
            GenFault.Unsupported(HOLE_WITHOUT_ARGUMENT)
        ),
        Ok(a) => write_value(be, a.value, stream, ctx),
    })
}

// Empty literal chunks emit no call.
write_piece = (
    be     :: CBackend,
    raw    : str,
    start  : usize,
    stop   : usize,
    stream : str
) Res<(), AllocError> {
    (stop > start).match({
        false => Ok(()),
        true  => write_chunk(be, raw.slice(start, stop), stream),
    })
}

write_chunk = (be :: CBackend, piece: str, stream: str) Res<(), AllocError> {
    n ::= be.alloc.String().try();
    n.write_usize(decoded_bytes(piece)).try();
    be.fmt(
        "{}(\"{piece}\", {}u);\n",
        pair(stream, "zg_print_bytes", "zg_eprint_bytes"),
        n.view()
    )
}

// Each raw escape denotes one output byte.
decoded_bytes* = (piece: str) usize {
    n ::= 0;
    i ::= 0;
    loop(i < piece.len, (h) {
        n = n + 1;
        i = i + step_of(piece, i);
    });
    n
}

// A hole's writer is selected solely by the argument type.

write_value = (
    be     :: CBackend,
    arg    : ExprId,
    stream : str,
    ctx    : Ctx
) Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    ty      = be.ty_of(arg, ctx, unknown).try();
    prim    = be.check.prim_name(ty);
    text ::= be.alloc.String().try();
    expr(be, arg, ctx, ty, text).try();
    write_typed(be, arg, ty, prim, text.view(), stream)
}

write_typed = (
    be     :: CBackend,
    arg    : ExprId,
    ty     : TyId,
    prim   : str,
    text   : str,
    stream : str
) Res<(), AllocError> {
    prim.eq("()").match({
        true  => write_chunk(be, "()", stream),
        false => {
            fn = printer(prim, stream);
            fn.is_empty().match({
                true  => write_display(be, arg, ty, text, stream),
                false => write_write(be, fn, cast_of(prim), text),
            })
        },
    })
}

// Empty means the value must use Display rather than a primitive helper.
printer* = (prim: str, stream: str) str {
    prim.eq("str").match({
        true  => pair(stream, "zg_print_str", "zg_eprint_str"),
        false => scalar_printer(prim, stream),
    })
}

scalar_printer = (prim: str, stream: str) str {
    prim.eq("bool").match({
        true  => pair(stream, "zg_print_bool", "zg_eprint_bool"),
        false => number_printer(prim, stream),
    })
}

number_printer = (prim: str, stream: str) str {
    is_float(prim).match({
        true  => pair(stream, "zg_print_f64", "zg_eprint_f64"),
        false => integer_printer(prim, stream),
    })
}

integer_printer = (prim: str, stream: str) str {
    is_c_integer(prim).match({
        false => "",
        true  => signed_printer(prim, stream),
    })
}

signed_printer = (prim: str, stream: str) str {
    is_signed(prim).match({
        true  => pair(stream, "zg_print_i64", "zg_eprint_i64"),
        false => pair(stream, "zg_print_u64", "zg_eprint_u64"),
    })
}

// `str` and `bool` already match their helper parameter types.
cast_of* = (prim: str) str {
    prim.eq("str").match({
        true  => "",
        false => scalar_cast(prim),
    })
}

scalar_cast = (prim: str) str {
    prim.eq("bool").match({
        true  => "",
        false => number_cast(prim),
    })
}

number_cast = (prim: str) str {
    is_float(prim).match({
        true  => "(double)",
        false => integer_cast(prim),
    })
}

integer_cast = (prim: str) str {
    is_signed(prim).match({ true => "(int64_t)", false => "(uint64_t)" })
}

write_write = (be :: CBackend, fn: str, cast: str, text: str)
              Res<(), AllocError> {
    be.fmt("{fn}({cast}({text}));\n")
}

// Non-primitive values write through Display.
write_display = (
    be     :: CBackend,
    arg    : ExprId,
    ty     : TyId,
    text   : str,
    stream : str
) Res<(), AllocError> {
    stream.eq("stderr").match({
        true  => be.stderr_console(ty, text),
        false => be.console_display(ty, text),
    }).try().match({
        true  => Ok(()),
        false => print_fault(be, arg),
    })
}

// Report an unwritable value at its argument.
print_fault = (be :: CBackend, arg: ExprId) Res<(), AllocError> {
    be.report_expr(arg, GenFault.Unsupported("printing a value of this type"))
}
