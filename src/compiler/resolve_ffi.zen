// @self-hosted-only
{ at } = std.text.ascii
{ Allocator } = std.mem.alloc
{ String } = std.text.string
{ view } = std.text.str
{ render_diagnostic } = compiler.diagnostic
{ ModuleTable, ProvidedSymbol, eprint, id_is_user, mappend_id_name, mappend_mid_display,
  res_reject_text, mid_is_user, rappend_span, res_col_of, res_line_of, res_ident_end } = compiler.resolve
{ loop_at } = std.core.count
// A bodyless (foreign) declaration binds a raw C symbol — any module holding one can reach ANY
// linked C function (`system`, `unlink`, …). The supply-chain hole: a TRANSITIVE dependency could
// declare an extern and shell out without the build ever saying so. So foreign declarations are
// gated per MODULE by an explicit build.zen target grant:
//   b.exe(…).cimport("vendor.hooks")
// Implicitly trusted, no grant needed: repo-tree modules (non-`u/` ids — std./compiler., the audited
// stdlib IS the sanctioned FFI surface) and the ENTRY module itself (an extern in the program's own
// file is visible to its author; the threat model is dependencies, not the program). Only fn-shaped
// decls (`name = (…) Ret`, no body) count as foreign here — a bare module global (`X = 5`) also
// scans as "has `=`, no `{`" but is not an FFI surface. The driver stamps the build-plan/registry
// grants into the module-level cell below before resolving (see uregions_reset for the pattern).
// ZEN_VIS_REPORT=1 downgrades to a report-only sweep, exactly like error[private-name].
ffi_no_grants = () StringView { "" }
ffi_grants ::= ffi_no_grants()
ffi_grants_set* = (g: StringView) void { ffi_grants = g }
ffi_grants_get* = () StringView { ffi_grants }
// build.zen's `exe.use(c_library(b, CLib(…)))` materializes a generated FFI module under the
// project's .zen/gen/ dir; the driver stamps the mapping here (exactly like ffi_grants above)
// BEFORE probe and resolve. module_path consults this map FIRST for user ids, so the lookup order
// is unambiguous: registered genmod path, then the ordinary <progdir>/<segs>.zen mapping. Format:
// one `<dotted-id> <path>` pair per line, newline-terminated.
genmods ::= ffi_no_grants()
genmods_set* = (g: StringView) void { genmods = g }
genmods_get* = () StringView { genmods }
gm_word_end = (s: StringView, p: i32) i32 {
    (s.at(p) == 0 || s.at(p) == ' ' || s.at(p) == '\n').then({ p }, { s.gm_word_end(p + 1) })
}
// first `<dotted> <path>` registry line whose id matches → the path (own copy); "" when unregistered.
gm_find = (a: Allocator, g: StringView, p: i32, dotted: StringView) StringView {
    (g.at(p) == 0).match ({
        true  => "",
        false => {
            we = g.gm_word_end(p)
            le = g.ffi_line_end(we)
            g.ffi_span_eq(p, we, dotted, 0).match ({
                true  => a.String(64).rappend_span(a, g, we + 1, le).finish_cstr(),
                false => (g.at(le) == 0).then({ "" }, { a.gm_find(g, le + 1, dotted) }),
            })
        },
    })
}
// the registered-genmod path for a USER module id, or "" (std/compiler ids never match the map).
genmod_lookup* = (a: Allocator, id: String) StringView {
    id.id_is_user().match ({
        true  => {
            dotted = a.mappend_id_name(a.String(24), id).finish_cstr()
            a.gm_find(genmods, 0, dotted)
        },
        false => "",
    })
}
ffi_delim = (b: u8) bool { b == ',' || b == ' ' || b == '\t' || b == '\r' }
// s[p..e) == w, byte-exact (w is NUL-terminated; ids are short, recursion is bounded).
ffi_span_eq = (s: StringView, p: i32, e: i32, w: StringView, j: i32) bool {
    (p + j == e).match ({
        true  => w.at(j) == 0,
        false => (w.at(j) == 0).match ({
            true  => false,
            false => (s.at(p + j) == w.at(j)).then({ s.ffi_span_eq(p, e, w, j + 1) }, { false }),
        }),
    })
}
ffi_token_end = (s: StringView, p: i32, e: i32) i32 {
    (p >= e || ffi_delim(s.at(p))).then({ p }, { s.ffi_token_end(p + 1, e) })
}
// does the grant list s[p..e) contain the token `name`? (delimiters: comma / whitespace)
ffi_list_has = (s: StringView, p: i32, e: i32, name: StringView) bool {
    (p >= e).match ({
        true  => false,
        false => ffi_delim(s.at(p)).match ({
            true  => s.ffi_list_has(p + 1, e, name),
            false => {
                te = s.ffi_token_end(p, e)
                s.ffi_span_eq(p, te, name, 0).then({ true }, { s.ffi_list_has(te, e, name) })
            },
        }),
    })
}
ffi_line_end = (s: StringView, p: i32) i32 {
    (s.at(p) == 0 || s.at(p) == '\n').then({ p }, { s.ffi_line_end(p + 1) })
}
ffi_skip_sp = (s: StringView, p: i32) i32 {
    (s.at(p) == ' ' || s.at(p) == '\t' || s.at(p) == '\n' || s.at(p) == '\r').match ({
        true  => s.ffi_skip_sp(p + 1),
        false => p,
    })
}
// a foreign FUNCTION decl reads `name[*] = (…` — the textual `foreign` scan flag alone also catches
// module globals (`X = 5` has `=` and no `{`), which are NOT an FFI surface. `= (` alone is still not
// enough: a parenthesised constant expression (`GNEST = (1 << 20) * (1 << 20)`) opens the same way, so
// the paren must hold a PARAMETER LIST — empty, or `ident:` — which no expression can imitate.
ffi_param_list_at = (src: StringView, lp: i32) bool {
    q = src.ffi_skip_sp(lp + 1)
    (src.at(q) == ')').then({
        return true
    })
    e = src.res_ident_end(q)
    (e == q).then({
        return false
    })
    src.at(src.ffi_skip_sp(e)) == ':'
}
ffi_foreign_fn = (src: StringView, sym: ProvidedSymbol) bool {
    sym.foreign.match ({
        true  => {
            p = (src.at(sym.next) == '*').then({ sym.next + 1 }, { sym.next })
            q = src.ffi_skip_sp(p)
            (src.at(q) == '=').match ({
                true  => {
                    lp = src.ffi_skip_sp(q + 1)
                    (src.at(lp) == '(').then({ src.ffi_param_list_at(lp) }, { false })
                },
                false => false,
            })
        },
        false => false,
    })
}
ffi_dotted_id = (a: Allocator, id: StringView) StringView {
    a.mappend_mid_display(a.String(24), id).finish_cstr()
}
ffi_module_granted = (dotted: StringView) bool {
    g = ffi_grants
    g.ffi_list_has(0, to_i32(g.view().len), dotted)
}
ffi_fail = (
    a: Allocator,
    path: StringView,
    src: StringView,
    sym: ProvidedSymbol,
    dotted: StringView,
    report: bool,
) i32 {
    line = src.res_line_of(sym.start)
    col = src.res_col_of(sym.start)
    msg = a.String(192)
        .add("module '")
        .add(dotted)
        .add("' declares foreign function `")
        .add(sym.name)
        .add("` without a build grant")
        .finish_cstr()
    hint = a.String(192)
        .add("grant it in build.zen: `.cimport(\"")
        .add(dotted)
        .add("\")`")
        .finish_cstr()
    d = a.render_diagnostic(path, src, line, col, col + sym.next - sym.start - 1, "ffi-ungranted", msg, hint, 1)
    report.match ({
        true  => {
            eprint(d)
            0
        },
        false => res_reject_text(d),
    })
}
enforce_ffi_grants* = (a: Allocator, table: ModuleTable, report: bool) i32 {
    table.modules.loop_at((i, entry) {
        (i > 0 && entry.id.mid_is_user()).then({
            dotted = a.ffi_dotted_id(entry.id)
            (ffi_module_granted(dotted) == false).then({
                entry.graph.symbols.loop_at((j, sym) {
                    entry.source.ffi_foreign_fn(sym).then({
                        a.ffi_fail(entry.path, entry.source, sym, dotted, report)
                    })
                })
            })
        })
    })
    0
}
// ── built-in module link flags ────────────────────────────────────────────────────────────────────
// User and native libraries belong to build.zen. The compiler derives only its own
// audited standard-library dependencies from resolved module identities, never from source comments.
// The driver reads this set after resolution when it builds the C linker command.
link_libs ::= ffi_no_grants()
link_libs_get* = () StringView { link_libs }
link_libs_reset* = () void { link_libs = ffi_no_grants() }
link_add = (a: Allocator, name: StringView) void {
    flag = a.String(24)
        .add("-l")
        .add(name)
        .finish_cstr()
    cur = link_libs
    (cur.ffi_list_has(0, to_i32(cur.view().len), flag) == false).then({
        link_libs = a.String(64)
            .add(cur)
            .add(flag)
            .add(" ")
            .finish_cstr()
    })
}
collect_builtin_links* = (a: Allocator, table: ModuleTable) i32 {
    link_libs_reset()
    table.modules.loop_at((i, entry) {
        dotted = a.ffi_dotted_id(entry.id)
        (dotted == "std.math").then({
            a.link_add("m")
        })
        (dotted == "std.c.libc").then({
            a.link_add("pthread")
        })
    })
    0
}
