// probeAT: generic recursion where T is a STRUCT and the value is rebuilt per frame
Pt = {
    x: i64,
    y: i64,
}

drift = <T>(v: T, n: i64) Pt {
    (n == 0).match({
        true  => Pt(x: 7, y: 9),
        false => {
            prev = drift(v, n - 1);
            Pt(x: prev.x + 1, y: prev.y + 2);
        },
    });
}

main = (env: Env) Res<i32, AllocError> {
    p = drift(Pt(x: 0, y: 0), 4);
    println("p {} {}", p.x, p.y);
    Ok(0);
}
