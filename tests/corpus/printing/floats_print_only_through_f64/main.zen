// tests/corpus/printing/floats_print_only_through_f64/main.zen
// Both float widths reach the console through ONE runtime writer
// (`zg_print_f64`, the `%g` floor), so an f32 arrives by promotion and
// an f64 directly — and the interesting rows are where those two roads
// must NOT change the answer:
//
//   - f32 3.5 is exact in binary, promoted or not: it prints 3.5. A
//     backend that routed f32 through a double rounding (or through the
//     integer printer) still prints a plausible number.
//   - f64 100.0 prints `100` under %g — no trailing `.0`. A printer
//     that always wrote a decimal point prints `100.0` here, which is
//     why this row exists beside the fractional ones.
//
// Only ANNOTATED values appear: an unannotated literal settles to f32
// and printing one is refused (`printing a value of this type`), so
// every hole below has its width written down.
//
// The digit-count of %g beyond six significant digits is C's answer,
// not Zen's — `widening_conversions_are_bounds.zen` compares rather
// than prints for the same reason — so no value below needs seven.

Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    q: f32 = 3.5;
    h: f32 = 0.25;
    a: f64 = 0.5;
    b: f64 = 100.0;
    d: f64 = -0.75;
    println("{} {}", q, h);
    println("{} {} {}", a, b, d);
    Ok(0);
}
