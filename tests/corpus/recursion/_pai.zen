// probeAI: minimal -- Alloc param, only .create, no recursion at all,
// helper returns the ptr; isolates "Alloc as fn parameter" + ".create"
mk = (a: Alloc) Res<Ptr<i64>, AllocError> {
    p = a.create<i64>().try();
    Ok(p)
}

main = (env: Env) Res<i32, AllocError> {
    a ::= env.mem.alloc();
    p = mk(a).try();
    p.write(0, 42);
    println("v {}", p.read(0));
    Ok(0);
}
