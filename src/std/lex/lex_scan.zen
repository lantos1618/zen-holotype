// src/std/lex/lex_scan.zen
// The driver: one byte decides which scanner runs, and the scanners that
// need no value of their own live here — comments, names, `@` names, the
// punctuation call, and the bytes that begin nothing.
//
// `step` consumes one token or one fault. No scanner backs up or leaves the
// cursor unchanged, so each iteration makes progress.
//
// Scanning continues after a fault at the next safe token boundary so one run
// can report independent lexical mistakes.
//
// Bracket matching belongs to the parser, which has the grammatical context
// needed to name the expected closer.

Lexer, Lexed = std.lex.lex_state
TokenKind, Source = std.lex.lex_token
LexFault = std.lex.lex_diag
class_of = std.lex.lex_byte
punct_of, punct_kind = std.lex.lex_punct
string, character, number = std.lex.lex_literal
Alloc, AllocError = std.mem
str = std.text

// The entry point takes an Alloc because it builds token and fault Vecs. It
// no exemption; takes a Source because a lexer is handed bytes and never
// opens a file — opening one is authority, and authority comes from Env.
//
// Lexical faults are returned inside Lexed; Err is reserved for allocation
// failure so scanning can continue after malformed input.
scan* = (alloc: Alloc, source: Source) Res<Lexed, AllocError> {
    lx ::= alloc.Lexer(source);
    lx.strip_bom();
    loop(!lx.cur.is_done(), (h) { lx.step().try(); });
    lx.emit(TokenKind.Eof, lx.cur.pos()).try();
    Ok(Lexed(source: source, tokens: lx.tokens, diags: lx.diags));
}

// A BOM is stripped only at offset 0. Anywhere
// else it falls through to `stray` and is reported — a file that parses
// differently depending on where an editor left a marker is worse than one
// that says so.
//
// The three bytes are stepped over, not skipped, so the first real
// character lands at column 4 — DESIGN.md specifies a 1-based BYTE column,
// which must keep counting bytes to agree with `offset`.
strip_bom = (lx :: Lexer) () {
    lx.cur.at_bom().then(() { lx.cur.bump(); lx.cur.bump(); lx.cur.bump(); });
}

// one token, or one mistake. The None arm is end of file, which the loop
// has already excluded — but match is exhaustive in every position, and
// answering it honestly costs one line
step = (lx :: Lexer) Res<(), AllocError> {
    lx.cur.peek().match({
        Ok(b) => lx.dispatch(b),
        None  => Ok(()),
    });
}

dispatch = (lx :: Lexer, b: u8) Res<(), AllocError> {
    class_of(b).match({
        Space  => lx.skip(),
        Slash  => lx.slash(),
        Quote  => lx.string(),
        Apos   => lx.character(),
        Digit  => lx.number(),
        Letter => lx.name(),
        At     => lx.at_name(),
        Other  => lx.punctuation(b),
    });
}

// whitespace is not a token: the gap between two spans says everything
// about it, and "was there a blank line here" is `next.start.line >
// prev.end.line + 1` rather than a stored fact that can go stale
skip = (lx :: Lexer) Res<(), AllocError> {
    lx.cur.bump();
    Ok(());
}

// ---------------------------------------------------------------------------
// comments — trivia tokens
// ---------------------------------------------------------------------------

// `/` is the one byte that needs lookahead: two comment shapes and a
// division operator all start with it
slash = (lx :: Lexer) Res<(), AllocError> {
    lx.cur.at_byte(1, '/').match({
        true  => lx.line_comment(),
        false => lx.cur.at_byte(1, '*').match({
            true  => lx.block_comment(),
            false => lx.punctuation('/'),
        }),
    });
}

// to the end of the line, not including the newline: the newline is
// whitespace and belongs to the gap, not to the comment
line_comment = (lx :: Lexer) Res<(), AllocError> {
    from = lx.cur.pos();
    lx.cur.bump_while((b) { b != '\n' });
    lx.emit(TokenKind.LineComment, from);
}

// Block comments do not nest: `/* a /* b */` is closed. The scan is for
// the first `*/` and there is no depth counter to get wrong
block_comment = (lx :: Lexer) Res<(), AllocError> {
    from = lx.cur.pos();
    lx.cur.bump();
    lx.cur.bump();
    closed ::= false;
    loop((h) {
        lx.cur.peek().match({
            None    => { h.break(); },
            Ok('*') => lx.cur.at_byte(1, '/').match({
                true  => { lx.cur.bump(); lx.cur.bump(); closed = true; h.break(); },
                false => { lx.cur.bump(); },
            }),
            Ok(_)   => { lx.cur.bump(); },
        });
    });

    // unterminated: no token. There is no comment, only an opening — and the
    // fault is reported at the `/*`, which is the thing that needs closing
    closed.match({
        true  => lx.emit(TokenKind.BlockComment, from),
        false => lx.report(LexFault.UnterminatedComment, from),
    });
}

// ---------------------------------------------------------------------------
// names
// ---------------------------------------------------------------------------

// `[A-Za-z_][A-Za-z0-9_]*`, ASCII. `_` is an ordinary identifier here; that
// it is the wildcard pattern is the parser's knowledge, not the lexer's
name = (lx :: Lexer) Res<(), AllocError> {
    from = lx.cur.pos();
    lx.cur.bump_while((b) { b.is_ident_cont() });
    lx.emit(word_kind(lx.since(from)), from);
}

// The grammar's complete reserved-word table. Completion and generated-name
// validation read this same table, so accepting a new identifier spelling is
// one language decision rather than three lists that can drift.
KEYWORD_COUNT*: usize = 3

Keyword* = { text*: str, kind*: TokenKind }

keyword_at* = (i: usize) Res<Keyword> {
    i.match({
        0 => Ok(Keyword(text: "consume", kind: TokenKind.Consume)),
        1 => Ok(Keyword(text: "false", kind: TokenKind.False)),
        2 => Ok(Keyword(text: "true", kind: TokenKind.True)),
        _ => None,
    })
}

keyword_of = (word: str) Res<Keyword> {
    found ::= Keyword(text: "", kind: TokenKind.Ident);
    have  ::= false;
    Range(0, KEYWORD_COUNT).loop((h, i) {
        keyword_at(i).match({
            Ok(keyword) => keyword.text.eq(word).then(() {
                found = keyword;
                have  = true;
                h.break();
            }),
            None        => (),
        });
    });
    have.match({ true => Ok(found), false => None })
}

word_kind = (word: str) TokenKind {
    keyword_of(
        word
    ).match({ Ok(keyword) => keyword.kind, None => TokenKind.Ident })
}

is_keyword* = (word: str) bool {
    keyword_of(word).match({ Ok(_) => true, None => false })
}

// A spelling that generated Zen may safely use as a declaration or parameter.
is_zen_name* = (word: str) bool { word.is_identifier() && !is_keyword(word) }

// The @ namespace contains Self, meta, and scope. Any other @ name is a
// lexical fault anchored at the @.
at_name = (lx :: Lexer) Res<(), AllocError> {
    from = lx.cur.pos();
    lx.cur.bump();
    lx.cur.bump_while((b) { b.is_ident_cont() });
    at_kind(lx.since(from)).match({
        Ok(kind) => lx.emit(kind, from),
        None     => lx.report(LexFault.UnknownAtName, from),
    });
}

// the whole namespace, matched with the `@` still attached so the table
// reads as the three things a user writes
at_kind = (word: str) Res<TokenKind> {
    word.match({
        "@Self"  => Ok(TokenKind.AtSelf),
        "@meta"  => Ok(TokenKind.AtMeta),
        "@scope" => Ok(TokenKind.AtScope),
        _        => None,
    });
}

// ---------------------------------------------------------------------------
// punctuation, and the bytes that are nothing
// ---------------------------------------------------------------------------

// `punct_of` is the table and its domain is the answer to "is this
// punctuation". None cannot happen for a byte `class_of` called `Other`
// unless the two ever disagree — and if they do, the fallthrough is a stray
// byte, which is a safe answer rather than an invented token
punctuation = (lx :: Lexer, b: u8) Res<(), AllocError> {
    from = lx.cur.pos();
    punct_of(b).match({
        Ok(single) => lx.emit(punct_kind(lx.cur, b, single), from),
        None       => lx.stray(),
    });
}

// A maximal run of stray bytes, such as `~~~`, is reported once. A
// byte-order mark past offset 0 is called what it is, because "unexpected
// character" for a marker an editor inserted invisibly is a diagnostic
// nobody can act on
stray = (lx :: Lexer) Res<(), AllocError> {
    from          = lx.cur.pos();
    misplaced_bom = lx.cur.at_bom();
    lx.cur.bump_while((b) { begins_no_token(b) });
    misplaced_bom.match({
        true  => lx.report(LexFault.MisplacedBom, from),
        false => lx.report(LexFault.StrayByte, from),
    });
}

// `?`, `#`, `~`, `$`, `^`, a backslash outside a literal, and every
// non-ASCII byte: none of them begins a Zen token
begins_no_token = (b: u8) bool {
    class_of(b).match({
        Other => punct_of(b).match({ Ok(_) => false, None => true }),
        _     => false,
    });
}
