// A WALK INSIDE A WALK'S BODY (`docs/design_meta.md` §7, M4 slice 2).
// Refused by name: a nested walk would recur into the comptime
// evaluator, and that recursion is the one shape §8's missing step
// budget exists for — so this slice declines the shape instead. The
// outer walk is legal and stays legal; the INNER `@meta` is the wall.
//
// position: the inner walk's `@meta` — the sentence that is refused,
// not the body that happens to contain it.

One = { only: i64 }

main = (env: Env) Res<i32, AllocError> {
    o = One(only: 1);
    @meta(x: One).fields().loop((h, field) {
        @meta(y: One).fields().loop((h2, f2) {
            println("{}", f2.name);
        });
    });
    Ok(0);
}
