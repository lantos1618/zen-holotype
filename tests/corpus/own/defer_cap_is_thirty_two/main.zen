// the defer cap is part of the language: 32 registrations on one block
// are accepted, the 33rd is a runtime trap. DESIGN.md (Scope.defer) and
// src/std/core/scope.zen document the number; ZG_DEFER_MAX in
// src/gen/gen_c/gen_c_runtime.zen implements it. This test exists so the
// three cannot drift apart silently: raise or lower the constant and
// this test reddens -- on the .stderr position if lowered (an earlier
// defer's line traps instead), on stdout/.exit if raised.
//
// shape: 32 straight-line defers on main's block, then a marker print,
// then the 33rd. the marker proves all 32 were ACCEPTED (execution got
// past them); the trap's position names the 33rd's own line, which is
// what separates cap=32 from any other number. the 32 cleanups never
// run -- the trap fires at registration, before block exit -- so their
// println texts are labels, not expectations.
//
// straight-line spelling, not a loop: the loop shape is documented
// separately as the case that does NOT bite (each iteration's body
// block owns its own fresh stack); the enclosing-block accumulation
// this test pins is the one a reader can hit without a loop at all.

main = (env: Env) Res<i32, IoError> {
    s = @scope;
    s.defer(() { println("d00") });
    s.defer(() { println("d01") });
    s.defer(() { println("d02") });
    s.defer(() { println("d03") });
    s.defer(() { println("d04") });
    s.defer(() { println("d05") });
    s.defer(() { println("d06") });
    s.defer(() { println("d07") });
    s.defer(() { println("d08") });
    s.defer(() { println("d09") });
    s.defer(() { println("d10") });
    s.defer(() { println("d11") });
    s.defer(() { println("d12") });
    s.defer(() { println("d13") });
    s.defer(() { println("d14") });
    s.defer(() { println("d15") });
    s.defer(() { println("d16") });
    s.defer(() { println("d17") });
    s.defer(() { println("d18") });
    s.defer(() { println("d19") });
    s.defer(() { println("d20") });
    s.defer(() { println("d21") });
    s.defer(() { println("d22") });
    s.defer(() { println("d23") });
    s.defer(() { println("d24") });
    s.defer(() { println("d25") });
    s.defer(() { println("d26") });
    s.defer(() { println("d27") });
    s.defer(() { println("d28") });
    s.defer(() { println("d29") });
    s.defer(() { println("d30") });
    s.defer(() { println("d31") });
    println("32 accepted");
    s.defer(() { println("never runs") });   // the 33rd: traps here
    println("unreachable");
    Ok(0);
}
