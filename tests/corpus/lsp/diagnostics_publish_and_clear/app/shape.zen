// THE OTHER MODULE, AND IT IS WRONG ON PURPOSE.
//
// `missing` is not a name in scope, so sema reports this file while the
// document the editor has open is `app.zen` beside it. That is the
// whole point: a build reports across the program, and a server that
// published this sentence against the open document would be naming the
// wrong file — which the test one directory up asserts it does not.
//
// It is a SEMA fault and the buffer's is a PARSE fault, so the two
// halves of the diagnostics story travel in one notification round.
Point* = {
    x*: i32,
    y*: i32,
}

area* = (p: Point) i32 {
    p.x * missing
}
