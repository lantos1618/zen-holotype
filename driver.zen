// driver.zen — the zenc CLI, in Zen. Dispatches on the command line and drives the compiler
// (resolve -> parse -> check -> genModule) and the C backend (cc). This replaces bootstrap/driver.c:
// once it roots --build-self, the seed carries `main` (emitted as zen_main) and driver.c is deleted.
{ arg, argc, getEnv } = std.sys.os
{ Os, Arch, Abi, host } = std.sys.platform
{ Malloc } = std.mem.alloc
{ view, is_empty, starts_with, ends_with } = std.text.str
{ Map, of } = std.collections.map    // zen audit: name -> decl-index / seen-set maps
{ impl_cname_in } = compiler.mangle    // zen audit: recompute hoisted impl-method names
{ fnv1a64_fold } = std.hash    // shared FNV-1a-64 rolling byte fold (centralized in std.hash)
{ gstr_string, gstr_append, gstr_finish, gstr_push, is_expr_null, cbuf } = compiler.genc    // the seed's String API (string.zen isn't in the manifest)
{ contents_in, out, out_bytes, save, O_RDONLY, O_WRONLY, O_CREAT, O_EXCL, O_WRTRUNC, MODE_644,
  MODE_755 } = std.io.file
{ or, expect } = std.core.result    // discard `out`/`out_bytes` write Results — the driver's stdout is best-effort
{ then } = std.core.bool
{ open, read, write, close, system, unlink, mkdir, rmdir, opendir, readdir, closedir, getpid,
  isatty, clock_gettime } = std.c.libc
{ parse_module, exports_get } = compiler.parse
{ set_faithful_lexeme } = compiler.parse_atom
{ perr_get, perr_off_get } = compiler.parse_type
{ lerr_get, lerr_off_get, collect_comments } = compiler.lex
{ resolve_module } = compiler.check_resolve
{ ufcs_vis_of } = compiler.check
{ CheckDiagnostic, desc_or } = compiler.validate.diag
{ check_module_ownership_diagnostic_from_source, check_module_parse_diagnostic_from_source,
  check_module_no_if_diagnostic_from_source, check_module_no_ternary_diagnostic_from_source,
  check_module_reserved_diagnostic_from_source, check_module_escape_diagnostic_from_source,
  check_module_leak_diagnostic_from_source, check_module_addr_escape_diagnostic_from_source,
  check_module_send_rc_diagnostic_from_source, check_module_scratch_diagnostic_from_source,
  check_module_send_mut_diagnostic_from_source, check_module_bound_diagnostic_from_source,
  check_module_arg_diagnostic_from_source, check_module_or_return_diagnostic_from_source,
  check_module_unknown_type_diagnostic_from_source, check_module_ffi_diagnostic_from_source,
  check_module_mustuse_diagnostic_from_source, check_module_infinite_type_diagnostic_from_source,
  check_module_main_diagnostic_from_source, check_module_batch_vis } = compiler.validate.core
{ denrich_check } = compiler.validate.enrich
{ genModuleIn } = compiler.backend.c.c_emit
{ genJsModuleIn } = compiler.backend.js.js
{ pretty_module_in, pretty_set_comments } = compiler.pretty
{ diag_user_span, diag_line_span, DiagSpan, render_diagnostic, manifest_value_span } = compiler.diagnostic
{ resolve_program_data, first_user_import_in, ResolvedProgram, ModuleEntry, file_exists, ImportEdge,
  seen_name, add_name, module_path, fregion_find, fregion_src_line, undefined_name_hint } = std.internal.resolve
{ import_edges } = std.internal.resolve_scan
{ ffi_grants_set, ffi_grants_get, genmods_set, genmods_get } = std.internal.resolve_ffi
say = (s: string_view) i64 {
    out(s).or(0)
    out("\n").or(0)
}
derr = (s: string_view) i64 {
    v := s.view()
    write(2, v.ptr, v.len)
}    // diagnostics go to stderr
// the first FAILING diagnostic, else clean. `cd_or(a, b)` = a if a failed, else b — so this is a flat
// precedence chain of the checks in order, not a brace pyramid. Checks are independent and side-effect
// free, so running them all is harmless; the reported diagnostic is still the first failure in order.
cd_or = (a: CheckDiagnostic, b: CheckDiagnostic) CheckDiagnostic {
    (a.code == 0).then({ b }, { a })
}
// the SPECIALIZED channels only (parse / ownership / escape / sendability / bound / … — every check
// EXCEPT the main type channel). If one fires it is the ROOT of the rejection: reported alone, so a
// downstream cascade of type errors from the same cause is suppressed. The main channel (names /
// types / arity / fit / exhaustiveness / …) is batched separately — check_module_batch — so its
// INDEPENDENT errors are all reported at once. A parse error, being here, always short-circuits the
// batch (the flat sentinels would otherwise spray bogus type errors).
check_diag_no_main = (
    mp: MutPtr<Malloc>,
    raw: [Decl],
    decls: [Decl],
    flat: string_view,
) CheckDiagnostic {
    check_module_no_if_diagnostic_from_source(flat)
        .cd_or(check_module_no_ternary_diagnostic_from_source(flat))
        .cd_or(mp.check_module_parse_diagnostic_from_source(decls, flat))
        .cd_or(mp.check_module_reserved_diagnostic_from_source(raw, flat))
        .cd_or(mp.check_module_ownership_diagnostic_from_source(raw, flat))
        .cd_or(mp.check_module_escape_diagnostic_from_source(raw, flat))
        .cd_or(mp.check_module_leak_diagnostic_from_source(raw, flat))
        .cd_or(mp.check_module_addr_escape_diagnostic_from_source(raw, flat))
        .cd_or(mp.check_module_send_rc_diagnostic_from_source(raw, flat))
        .cd_or(mp.check_module_scratch_diagnostic_from_source(raw, flat))
        .cd_or(mp.check_module_send_mut_diagnostic_from_source(raw, flat))
        .cd_or(mp.check_module_bound_diagnostic_from_source(raw, flat))
        .cd_or(mp.check_module_arg_diagnostic_from_source(raw, flat))
        .cd_or(mp.check_module_or_return_diagnostic_from_source(raw, flat))
        .cd_or(mp.check_module_unknown_type_diagnostic_from_source(decls, flat))
        .cd_or(mp.check_module_ffi_diagnostic_from_source(decls, flat))
        .cd_or(check_module_infinite_type_diagnostic_from_source(decls, flat))
        .cd_or(check_module_main_diagnostic_from_source(raw, flat))
        .cd_or(mp.check_module_mustuse_diagnostic_from_source(raw, flat))
}
RenderTarget*: {
    path: string_view,
    src: string_view,
}
pick_module = (
    flat: string_view,
    mods: [ModuleEntry],
    i: i64,
    off: i32,
    w: i32,
    rpath: string_view,
    rsrc: string_view,
) RenderTarget {
    (i >= mods.len).match ({
        true  => RenderTarget(
            path: rpath,
            src: rsrc,
        ),
        false => {
            m := mods[i]
            sp := diag_user_span(flat, m.source, off, w)
            (sp.line > 0).match ({
                true  => RenderTarget(
                    path: m.path,
                    src: m.source,
                ),
                false => flat.pick_module(mods, i + 1, off, w, rpath, rsrc),
            })
        },
    })
}
pick_render = (
    rp: ResolvedProgram,
    off: i32,
    w: i32,
    rpath: string_view,
    rsrc: string_view,
) RenderTarget {
    (diag_user_span(rp.flat, rsrc, off, w).line == 0).match ({
        true  => rp.flat.pick_module(rp.table.modules, 0, off, w, rpath, rsrc),
        false => RenderTarget(
            path: rpath,
            src: rsrc,
        ),
    })
}
// a fully located diagnostic: the module file it lives in plus its line:col span there.
DiagLoc: {
    path: string_view,
    src: string_view,
    sp: DiagSpan,
}
// IDENTITY-FIRST location: binary-search the resolver's region map (flat offset → module + original
// line — exact even when two modules share identical line text), then recover the column against that
// single known line. The whole-table fuzzy scan survives ONLY as the last resort for offsets no
// region contains (synthesized positions, separator bytes).
locate_diag = (
    rp: ResolvedProgram,
    off: i32,
    w: i32,
    rpath: string_view,
    rsrc: string_view,
) DiagLoc {
    ri := rp.regions.fregion_find(to_i64(off))
    (off >= 0 && ri >= 0).then({
        srcline := rp.regions.fregion_src_line(rp.line_srcs, rp.flat, ri, to_i64(off))
        (srcline > 0).then({
            m := rp.table.modules[rp.regions[ri].midx]
            return DiagLoc(
                path: m.path,
                src: m.source,
                sp: diag_line_span(rp.flat, m.source, off, w, srcline),
            )
        })
    })
    rt := pick_render(rp, off, w, rpath, rsrc)
    DiagLoc(
        path: rt.path,
        src: rt.src,
        sp: diag_user_span(rp.flat, rt.src, off, w),
    )
}
// render ONE diagnostic (file:line:col + caret + hint) to stderr, mapping its flat offset to the
// module its error actually lives in. cd.count>1 appends the legacy inline "(+K more)" suffix — used
// only on the specialized-channel path, where a single root error stands in for a whole cascade.
emit_one = (
    mp: MutPtr<Malloc>,
    raw: [Decl],
    decls: [Decl],
    rp: ResolvedProgram,
    path: string_view,
    user: string_view,
    cd: CheckDiagnostic,
) i64 {
    dl := locate_diag(rp, cd.source_offset, cd.span_width, path, user)
    msg := desc_or(mp.denrich_check(raw, decls, cd.source_offset, cd.code, cd.kind), cd.message)
    // World teaching hint: an undefined name that some closure module EXPORTS names that module
    // (with the import to write) instead of the generic advice — see undefined_name_hint.
    hint := cd.hint
    (cd.kind == "undefined-name").then({
        wh := mp.undefined_name_hint(rp.table, rp.flat, cd.source_offset)
        (is_empty(wh) == false).then({
            hint = wh
        })
    })
    derr(mp.render_diagnostic(dl.path, dl.src, dl.sp.line, dl.sp.col, dl.sp.end_col, cd.kind, msg, hint, cd.count))
}
// Source-only commands (`fmt` and the deliberately-untyped raw emitter) do not own a ResolvedProgram,
// but the no-if and no-ternary language laws still apply. Render the same structured diagnostic
// directly against their input so every user-facing command teaches the canonical postfix forms.
report_no_if_plain = (mp: MutPtr<Malloc>, path: string_view, src: string_view) i32 {
    cd := check_module_no_if_diagnostic_from_source(src).cd_or(check_module_no_ternary_diagnostic_from_source(src))
    (cd.code == 0).match ({
        true  => 0,
        false => {
            sp := diag_user_span(src, src, cd.source_offset, cd.span_width)
            derr(mp.render_diagnostic(path, src, sp.line, sp.col, sp.end_col, cd.kind, cd.message, cd.hint, cd.count))
            1
        },
    })
}
// Checked commands preflight the resolved flat source before parsing or semantic lowering. This keeps
// the obsolete guard parser/lowerer out of the execution path and still maps an `if` (or a ternary
// `?`) in an imported module back to that module's real file.
report_no_if_resolved = (
    mp: MutPtr<Malloc>,
    rp: ResolvedProgram,
    path: string_view,
    user: string_view,
) i32 {
    cd := check_module_no_if_diagnostic_from_source(rp.flat).cd_or(check_module_no_ternary_diagnostic_from_source(rp.flat))
    (cd.code == 0).match ({
        true  => 0,
        false => {
            dl := locate_diag(rp, cd.source_offset, cd.span_width, path, user)
            derr(mp.render_diagnostic(dl.path, dl.src, dl.sp.line, dl.sp.col, dl.sp.end_col, cd.kind, cd.message, cd.hint, cd.count))
            1
        },
    })
}
// how many main-channel diagnostics we print before collapsing the rest into a single trailer line.
DIAG_CAP = () i32 { 20 }
// after the cap, one line naming the K un-rendered errors (so the tail is never silently dropped).
emit_more_trailer = (mp: MutPtr<Malloc>, k: i32) i64 {
    s := mp
        .gstr_string(48)
        .gstr_append(mp, "zenc: (+")
        .push_int(mp, to_i64(k))
        .gstr_append(mp, " more error")
    s2 := (k == 1).then({ s.gstr_push(mp, ')') }, { s.gstr_push(mp, 's').gstr_push(mp, ')') })
    derr(s2.gstr_push(mp, '\n').gstr_finish(mp))
}
// 0 if clean; else render EVERY main-channel diagnostic (capped, with a trailer) and return the count.
report_check = (
    mp: MutPtr<Malloc>,
    raw: [Decl],
    decls: [Decl],
    rp: ResolvedProgram,
    path: string_view,
    user: string_view,
) i32 {
    // a specialized channel (parse / ownership / escape / bound / …) is the ROOT — report it alone.
    spec := mp.check_diag_no_main(raw, decls, rp.flat)
    (spec.code != 0).match ({
        true  => {
            mp.emit_one(raw, decls, rp, path, user, spec)
            spec.count
        },
        false => {
            ds := mp.check_module_batch_vis(decls, rp.flat, mp.ufcs_vis_of(rp.flat, rp.regions, rp.table))
            n := to_i32(ds.len)
            ds.loop((h, i, cd) {
                (to_i32(i) < DIAG_CAP()).then({
                    mp.emit_one(raw, decls, rp, path, user, cd)
                })
            })
            (n > DIAG_CAP()).then({
                mp.emit_more_trailer(n - DIAG_CAP())
            })
            n
        },
    })
}
// run/build temp.c swaps the emitted HEAD typedef for the zenrt.h include; the PROG variant also
// suppresses zenrt's String (the program emits its own). --build-self uses the plain seed variant.
// module-level str CONSTS don't emit as C globals in the seed, so these are zero-arg fns.
HEAD = () string_view { "typedef struct { void* ptr; int64_t len; } zslice; " }
HEAD_REPL = () string_view {
    "#define ZEN_NO_STRING 1\n#define ZEN_NO_MALLOC 1\n#include \"zenrt.h\"\n"
}
// Intermediate /tmp files are namespaced by pid so two concurrent `zenc` invocations never clobber
// each other's temp.c / temp.bin (a fixed path made one process compile/run the OTHER's program).
// getpid() is constant for the life of a run, so each builder yields the SAME path on every call —
// the write + the cc command (TMPC), and the build output + the run (TMPBIN), stay consistent.
pid_digit = (d: i64) u8 { load(offset("0123456789", d)) }
push_int = (s: String, mp: MutPtr<Malloc>, n: i64) String {
    (n < 10).match ({
        true  => s.gstr_push(mp, pid_digit(n)),
        false => {
            hs := s.push_int(mp, n / 10)
            hs.gstr_push(mp, pid_digit(n % 10))
        },
    })
}    // hoist (gstr_reserve re-evals the receiver)
pid_path = (mp: MutPtr<Malloc>, pre: string_view, suf: string_view) string_view {
    mp
        .gstr_string(64)
        .gstr_append(mp, pre)
        .push_int(mp, getpid())
        .gstr_append(mp, suf)
        .gstr_finish(mp)
}
TMPC = (mp: MutPtr<Malloc>) string_view { mp.pid_path("/tmp/zenc_zd_", ".c") }
TMPBIN = (mp: MutPtr<Malloc>) string_view { mp.pid_path("/tmp/zenc_zd_", ".bin") }
// ── path helpers ────────────────────────────────────────────────────────────────────────────────
dirname = (mp: MutPtr<Malloc>, p: string_view) string_view {
    v := p.view()
    cut := last_slash(v, 0, 0 - 1)
    (cut < 0).then({ "." }, { mp.cstr_prefix(p, cut) })
}
last_slash = (v: [u8], i: i64, best: i64) i64 {
    (i >= v.len).then({ best }, { v.last_slash(i + 1, (v[i] == '/').then({ i }, { best })) })
}
// the first `n` bytes of `p` as an owned str — built through the allocator (no raw malloc).
cstr_prefix = (mp: MutPtr<Malloc>, p: string_view, n: i64) string_view {
    push_prefix(mp.gstr_string(n + 1), mp, p.view(), 0, n).gstr_finish(mp)
}
push_prefix = (s: String, mp: MutPtr<Malloc>, v: [u8], i: i64, n: i64) String {
    (i >= n).then({ s }, { push_prefix(s.gstr_push(mp, v[i]), mp, v, i + 1, n) })
}
// ── the compile pipeline (resolve imports -> parse -> resolve_module) ─────────────────────────────
// the full resolved program (flat + per-module table) — check/build keep it so a diagnostic can
// render against the imported module its error actually lives in.
resolve_prog = (
    mp: MutPtr<Malloc>,
    root: string_view,
    path: string_view,
    src: string_view,
) ResolvedProgram { mp.resolve_program_data(root, mp.dirname(path), path, src) }
// write the runnable temp.c: zenrt.h-include head, then the emitted body (after HEAD).
write_runnable_c = (tmpc: string_view, gen: String) bool {
    hl := HEAD().view().len
    fd := tmpc.open(O_WRTRUNC, MODE_644)
    (fd < 0).match ({
        true  => false,
        false => {
            hv := HEAD_REPL().view()
            fd.write(hv.ptr, hv.len)
            fd.write(gen.ptr.offset(hl), gen.len - hl)
            fd.close()
            true
        },
    })
}
// cc -std=gnu11 -O1 -foptimize-sibling-calls -fwrapv -w -fno-diagnostics-show-caret -I<root>/bootstrap TMPC <root>/bootstrap/zenrt.c <profile> <ccflags> <links> -o <out>
// ── build profiles (cargo-style) ── `zen build` = dev, `zen build -r|--release` = release. The
// profile's flags land after the base defaults and BEFORE ccflags, so cc's last-flag-wins rule
// keeps the precedence: base defaults < profile < Target.cflags/zen.toml ccflags.
//   dev (default):     base -O1 plus -g       — fast compile, debuggable. NOT -O0: Zen's ONLY loop
//     is recursion (control flow is `.match` + recursion), so self-tail-recursive fns — emitted by
//     genc as a bare `return f(...)` (proper C tail position) — MUST get sibling-call elimination
//     or a deep idiomatic loop blows the C stack (raw SIGSEGV ~250k frames at -O0). The opt fires
//     only at >= -O1; -O1 also keeps -fstrict-aliasing OFF, which this void*-punning emitted C
//     relies on.
//   release (-r):      -O2 -fno-strict-aliasing — the optimized profile. -fno-strict-aliasing is
//     MANDATORY alongside -O2 (the emitted C puns pointers; -O2 alone would turn strict aliasing
//     back on and miscompile).
// `zen run` and single-file builds share this path and stay on the dev profile (only `zen build`
// parses -r): a run's temp binary wants the fastest cc turnaround. Profiles affect BUILT/RUN user
// programs only — the bootstrap seed compiles via bootstrap/Makefile CFLAGS (pinned -O2: built
// once, used heavily), so the byte-exact fixpoint is unaffected. Non-tail recursion whose result
// feeds a branch still overflows — caught by zenrt.c's stack-overflow panic.
// ccflags/links come from a project's zen.toml or build.zen (extra .c files, `-l` libs, and
// `-`-prefixed cc flags); empty for single files.
PROFILE_DEV = () string_view { "-g" }    // on top of the base -O1: effective `-O1 -g`
PROFILE_RELEASE = () string_view { "-O2 -fno-strict-aliasing" }    // overrides the base -O1
// `zen profile` compiles dev-profile PLUS frame pointers (perf's `--call-graph fp` walks them; -O1
// stays — profiling unoptimized code lies about where time goes). The gprof fallback adds -pg
// instrumentation. Both fold into the compile-cache key via profile_get, so a profiling binary
// never replays as (or from) a plain dev build.
PROFILE_PERF = () string_view { "-g -fno-omit-frame-pointer" }
PROFILE_GPROF = () string_view { "-g -pg -fno-omit-frame-pointer" }
profile_flags := PROFILE_DEV()
profile_release_set = () void { profile_flags = PROFILE_RELEASE() }
profile_perf_set = () void { profile_flags = PROFILE_PERF() }
profile_gprof_set = () void { profile_flags = PROFILE_GPROF() }
profile_get = () string_view { profile_flags }
cc_command = (
    mp: MutPtr<Malloc>,
    root: string_view,
    tmpc: string_view,
    out: string_view,
    ccflags: string_view,
    links: string_view,
    ccname: string_view,
) string_view {
    line := mp
        .gstr_string(256)
        .gstr_append(mp, ccname)
        .gstr_append(mp, " -std=gnu11 -Wno-error=implicit-function-declaration -O1 -foptimize-sibling-calls -fwrapv -w -I")
        .gstr_append(mp, root)
        .gstr_append(mp, "/bootstrap ")
        .gstr_append(mp, tmpc)
        .gstr_append(mp, " ")
        .gstr_append(mp, root)
        .gstr_append(mp, "/bootstrap/zenrt.c ")
        .gstr_append(mp, profile_get())
        .gstr_append(mp, " ")
        .gstr_append(mp, ccflags)
        .gstr_append(mp, " ")
        .gstr_append(mp, links)
        .gstr_append(mp, " -lm")
        .gstr_append(mp, " -o ")
        .gstr_append(mp, out)
        .gstr_finish(mp)
    // ZENC_SHOW_CC (any non-empty value): echo the full cc line to stderr — the observable record
    // of which profile/flags a compile actually used (the harness's profile cases assert on it).
    // A cache HIT never reaches cc, so pair it with ZENC_NO_CACHE=1/a fresh ZENC_CACHE_DIR.
    (getEnv("ZENC_SHOW_CC") == "" == false).then({
        derr(line)
        derr("\n")
    })
    line
}    // libm: always link (sin/cos/log/exp/pow); free if unused
// ── cross-toolchain selection (`Target.target(platform)` in build.zen) ────────────────────────────
// A native Spec (target "") compiles with host `cc` — the command line above, byte-identical to
// before. A cross triple resolves a C compiler in this order:
//   1. $ZENC_TARGET_CC — the verbatim compiler command (the documented escape hatch);
//   2. the conventional cross gcc `<triple>-gcc` on PATH (aarch64-linux-gnu-gcc, …), which brings
//      its own sysroot libc, so -lm/-lpthread and a project's `link =` just work;
//   3. `zig cc -target <triple>` when zig is on PATH.
// Nothing found -> a LOUD error and no build. There is NEVER a silent host-cc fallback: a wrong-
// architecture binary that "builds fine" is strictly worse than an error.
which_ok = (mp: MutPtr<Malloc>, name: string_view) bool {
    mp
        .gstr_string(64)
        .gstr_append(mp, "command -v ")
        .gstr_append(mp, name)
        .gstr_append(mp, " >/dev/null 2>&1")
        .gstr_finish(mp)
        .system() == 0
}
cross_cc = (mp: MutPtr<Malloc>, target: string_view) string_view {
    (target == "").then({
        return "cc"
    })
    envcc := getEnv("ZENC_TARGET_CC")
    (envcc == "" == false).then({
        return envcc
    })
    gcc := mp
        .gstr_string(32)
        .gstr_append(mp, target)
        .gstr_append(mp, "-gcc")
        .gstr_finish(mp)
    mp.which_ok(gcc).then({
        return gcc
    })
    mp.which_ok("zig").then({
        return mp
            .gstr_string(48)
            .gstr_append(mp, "zig cc -target ")
            .gstr_append(mp, target)
            .gstr_finish(mp)
    })
    derr("zenc: error: cross target ")
    derr(target)
    derr(" needs a toolchain — set ZENC_TARGET_CC, or install ")
    derr(gcc)
    derr(" or zig\n")
    ""
}
// ── content-hash compile cache ────────────────────────────────────────────────────────────────────
// check/run/build re-frontend the WHOLE flattened import closure on every invocation (~27s for a
// program importing the compiler). The cache keys a fully-SUCCESSFUL result by CONTENT: FNV-1a 64-bit
// over the running zenc binary's own bytes (a rebuilt compiler invalidates everything it ever cached),
// the version string, the command kind, ccflags/links (a token naming a readable file — a project's
// extra native .c — folds in its bytes, so editing it misses), and the SOURCE of every module in the
// import closure (the probe loads the transitive module table only — the flattened text it would
// produce is a deterministic function of those sources plus the stamped compiler, so hashing the
// inputs covers it while skipping the expensive namespace-strip/dedup flatten on a hit). No mtimes,
// no filesystem paths: an identical program is an identical key. A `check` hit replays the ok line
// from a marker file; a `run`/`build` hit copies the cached binary into place. Failures are NEVER
// cached (the entry is written only after the full pipeline succeeded). ZENC_NO_CACHE=1 (any
// non-empty value) bypasses both reads and writes; ZENC_CACHE_DIR overrides /tmp/zenc-cache (the
// harness's cache cases point it at scratch). i64 wraps like the spec's u64: every build has -fwrapv.
FNV_BASIS = () i64 { 0 - 3750763034362895579 }    // 0xcbf29ce484222325, the FNV-1a-64 offset basis, as an i64
fnv_str = (h: i64, s: string_view) i64 { h.fnv1a64_fold(s.view()) }
flag_token_end = (v: [u8], i: i64) i64 {
    (i >= v.len || v[i] == ' ').then({ i }, { v.flag_token_end(i + 1) })
}
// fold a flag string: its text (order + non-file tokens like -lm), plus the CONTENT of every
// whitespace token that names a readable file (a project's extra .c sources compiled into the binary).
fnv_flag_files = (mp: MutPtr<Malloc>, h: i64, v: [u8], i: i64) i64 {
    (i >= v.len).match ({
        true  => h,
        false => (v[i] == ' ').match ({
            true  => mp.fnv_flag_files(h, v, i + 1),
            false => {
                e := flag_token_end(v, i)
                tok := push_prefix(mp.gstr_string(e - i + 1), mp, v, i, e).gstr_finish(mp)
                h2 := contents_in(mp, tok).match ({
                    .Ok(c)  => h.fnv_str(c),
                    .Err(x) => h,
                })
                mp.fnv_flag_files(h2, v, e)
            },
        }),
    })
}
fnv_flags = (h: i64, mp: MutPtr<Malloc>, s: string_view) i64 {
    v: [u8] := s.view()
    mp.fnv_flag_files(h.fnv_str(s), v, 0)
}
// the compiler's own identity: the hash of the running zenc binary. A rebuilt zenc — new checker, new
// codegen, new zenrt.c, all compiled in — yields a new stamp, so an old binary's entries can never be
// replayed by a new one. The identity SOURCE is `/proc/self/exe` (Linux): the kernel resolves it to the
// real binary regardless of how the process was launched, so a PATH-installed `zenc` (whose argv[0] is a
// bare, unreadable `zenc`) still stamps and thus still caches. Falls back to argv[0] when /proc is absent
// (non-Linux), then to 0 — an unavailable stamp DISABLES the cache for the run (empty key). Read in
// explicit-length chunks and fold as [u8]: an ELF binary has a NUL at byte 5, so any strlen-based view
// (contents_in -> .view()) would hash only the first ~4 bytes and stamp EVERY build identically.
self_exe_fd = () i32 {
    fd := "/proc/self/exe".open(O_RDONLY, 0)
    (fd < 0).then({ arg(0).open(O_RDONLY, 0) }, { fd })
}
cache_self = (mp: MutPtr<Malloc>) i64 {
    fd := self_exe_fd()
    (fd < 0).match ({
        true  => 0,
        false => {
            h := fd.cache_self_fold(mp.gstr_string(65536), FNV_BASIS())
            fd.close()
            h
        },
    })
}
cache_self_fold = (fd: i32, buf: String, h: i64) i64 {
    n := fd.read(buf.ptr, 65536)
    (n <= 0).then({ h }, { fd.cache_self_fold(buf, h.fnv1a64_fold(buf.ptr.slice(n))) })
}
cache_hex_digit = (d: i64) u8 { load(offset("0123456789abcdef", d)) }
push_hex = (s: String, mp: MutPtr<Malloc>, h: i64, i: i64) String {
    (i < 0).match ({
        true  => s,
        false => {
            hs := s.gstr_push(mp, cache_hex_digit(h >> i * 4 & 15))
            hs.push_hex(mp, h, i - 1)
        },
    })
}    // nibble i*4..0, most significant first (hoist: gstr_reserve re-evals the receiver)
cache_dir = () string_view {
    e := getEnv("ZENC_CACHE_DIR")
    (e == "").then({ "/tmp/zenc-cache" }, { e })
}
cache_on = () bool { getEnv("ZENC_NO_CACHE") == "" }
// ── the probe's light closure walk ── the resolver's own module walk (module_table) builds a full
// per-module symbol graph twice over; the probe only needs BYTES, so it walks the same import edges
// (the resolver's exported edge scanner — the one source of truth for what an import line is) and
// folds each module's logical id + entire source into the key. Any edit to any imported file, however
// deep, changes the key. An unreadable/unknown module folds its id only — the miss path then reports
// it with the resolver's real diagnostic (and a failed pipeline never populates the cache).
CacheWalk: {
    seen: String,
    h: i64,
}
edges_of = (mp: MutPtr<Malloc>, src: string_view) [ImportEdge] {
    mp.import_edges(src).expect("zenc: cache probe: allocation failed")
}
// id → file through the resolver's ONE exported module_path (the canonical ModuleId → path fn),
// so the probe can never drift from the loader's mapping.
cache_module_path = (
    mp: MutPtr<Malloc>,
    root: string_view,
    progdir: string_view,
    id: string_view,
) string_view { mp.module_path(root, progdir, mp.gstr_string(24).gstr_append(mp, id)) }
cache_walk_one = (
    mp: MutPtr<Malloc>,
    root: string_view,
    progdir: string_view,
    id: string_view,
    st: CacheWalk,
) CacheWalk {
    idn := mp.gstr_string(24).gstr_append(mp, id)
    st.seen.seen_name(idn).match ({
        true  => st,
        false => {
            next := CacheWalk(
                seen: st.seen.add_name(mp, idn),
                h: st.h.fnv_str(id),
            )
            contents_in(mp, mp.cache_module_path(root, progdir, id)).match ({
                .Ok(msrc) => mp.cache_walk_edges(root, progdir, mp.edges_of(msrc), CacheWalk(
                    seen: next.seen,
                    h: next.h.fnv_str(msrc),
                )),
                .Err(e)   => next,
            })
        },
    })
}
cache_walk_edges = (
    mp: MutPtr<Malloc>,
    root: string_view,
    progdir: string_view,
    edges: [ImportEdge],
    st: CacheWalk,
) CacheWalk {
    cur := st
    edges.loop((lh, i, e) {
        cur = mp.cache_walk_one(root, progdir, e.module, cur)
    })
    cur
}
// the on-disk entry for one (kind, program) pair: <dir>/<kind>_<16 hex digits>.
cache_probe = (
    mp: MutPtr<Malloc>,
    kind: string_view,
    root: string_view,
    path: string_view,
    src: string_view,
    ccflags: string_view,
    links: string_view,
    target: string_view,
) string_view {
    // An unreadable binary (neither /proc/self/exe nor argv[0] opens) means the compiler-identity stamp
    // is unavailable; a shared degenerate stamp would let a REBUILT compiler replay a stale entry. Empty
    // key = cache disabled for this run.
    self := mp.cache_self()
    (self == 0).then({
        return ""
    })
    // ZEN_VIS_REPORT is part of the key: a report-only sweep (visibility/private-leak violations
    // print but never fail) must not stamp a check-ok an ENFORCED run would replay as clean.
    // The manifest/registry FFI grants are part of the key (stamped by the spec commands before any
    // probe): a program cached as clean under `ffi = "dep"` must MISS once the grant is revoked. The
    // entry-file pragma needs no folding — it lives in `src`, already keyed.
    // The registered c_library genmod map folds in the same way (the generated files' CONTENT is
    // hashed by the walk below through module_path; the map itself covers id/path re-registration).
    // The cross-target triple is part of the key: flipping `Target.target(...)` MUST miss — a
    // cached aarch64 binary must never replay as the x86_64 build (or vice versa).
    // The build profile (dev vs release, see cc_command) is part of the key the same way: a dev
    // `-O1 -g` binary must never replay as the `-r` release build (or vice versa).
    h0 := self
        .fnv_str(VERSION())
        .fnv_str(kind)
        .fnv_str(getEnv("ZEN_VIS_REPORT"))
        .fnv_str(ffi_grants_get())
        .fnv_str(genmods_get())
        .fnv_str(profile_get())
        .fnv_flags(mp, ccflags)
        .fnv_flags(mp, links)
        .fnv_str(target)
        .fnv_str(src)
    st := mp.cache_walk_edges(root, mp.dirname(path), mp.edges_of(src), CacheWalk(
        seen: mp.gstr_string(256),
        h: h0,
    ))
    mp
        .gstr_string(96)
        .gstr_append(mp, cache_dir())
        .gstr_push(mp, '/')
        .gstr_append(mp, kind)
        .gstr_push(mp, '_')
        .push_hex(mp, st.h, 15)
        .gstr_finish(mp)
}
// mark a fully-successful `check`: the marker's EXISTENCE is the cached verdict (content is cosmetic).
cache_put_ok = (path: string_view) i64 {
    mkdir(cache_dir(), MODE_755)
    save(path, "ok\n", 3).or(0)
}
// copy the cached binary into place; chmod so the exec bit survives any pre-existing destination.
cache_bin_cmd = (mp: MutPtr<Malloc>, cb: string_view, out: string_view) string_view {
    mp
        .gstr_string(160)
        .gstr_append(mp, "cp ")
        .quote_arg(mp, cb)
        .gstr_push(mp, ' ')
        .quote_arg(mp, out)
        .gstr_append(mp, " && chmod 755 ")
        .quote_arg(mp, out)
        .gstr_finish(mp)
}
// publish a built binary: copy to a pid-suffixed temp inside the cache dir, then atomic `mv -f` — a
// concurrent zenc never observes a half-written entry (and an exec'ing reader never sees ETXTBSY).
cache_store_bin = (mp: MutPtr<Malloc>, cb: string_view, out: string_view) i32 {
    mkdir(cache_dir(), MODE_755)
    tmp := mp
        .gstr_string(96)
        .gstr_append(mp, cb)
        .gstr_push(mp, '.')
        .push_int(mp, getpid())
        .gstr_finish(mp)
    mp
        .gstr_string(256)
        .gstr_append(mp, "cp ")
        .quote_arg(mp, out)
        .gstr_push(mp, ' ')
        .quote_arg(mp, tmp)
        .gstr_append(mp, " && mv -f ")
        .quote_arg(mp, tmp)
        .gstr_push(mp, ' ')
        .quote_arg(mp, cb)
        .gstr_finish(mp)
        .system()
}
// ── `--time` stage clocks (`zen run --time` / `zen build --time`) ─────────────────────────────────
// Wall-clock per driver-visible pipeline stage, printed as a compact table on stderr after the verb
// finishes. Off by default: tm_mark/tm_lap return 0 without reading the clock, so the stamps woven
// through compile_flat cost nothing when the flag is absent. Finer in-compiler splits (desugar/
// inline/mono inside check+emit) are a follow-up — these are the honest driver-level boundaries.
time_on := false
time_enable = () void { time_on = true }
tm_flatten := to_i64(0)
tm_parse := to_i64(0)
tm_resolve := to_i64(0)
tm_check := to_i64(0)
tm_emit := to_i64(0)
tm_cc := to_i64(0)
tm_cache_hit := false
// CLOCK_MONOTONIC via the libc clock_gettime FFI (std.time.clock is not in the seed manifest, so
// the driver reads the two timespec i64 fields itself — same layout contract as std.time.clock).
TM_CLOCK_MONOTONIC = () i32 { 1 }
TM_NS_PER_S = () i64 { 1000000000 }
tm_now = (mp: MutPtr<Malloc>) i64 {
    cell := mp.acquire(16)
    clock_gettime(TM_CLOCK_MONOTONIC(), cell)
    load_i64(cell) * TM_NS_PER_S() + load_i64(cell.offset(8))
}
tm_mark = (mp: MutPtr<Malloc>) i64 { time_on.then({ mp.tm_now() }, { 0 }) }
tm_lap = (mp: MutPtr<Malloc>, t0: i64) i64 { time_on.then({ mp.tm_now() - t0 }, { 0 }) }
pad_sp = (s: String, mp: MutPtr<Malloc>, n: i64) String {
    (n <= 0).then({ s }, { s.gstr_push(mp, ' ').pad_sp(mp, n - 1) })
}
// nanoseconds -> "12.3" (milliseconds, one decimal).
push_ms = (s: String, mp: MutPtr<Malloc>, ns: i64) String {
    t := ns / 100000
    s.push_int(mp, t / 10).gstr_push(mp, '.').push_int(mp, t % 10)
}
tm_row = (mp: MutPtr<Malloc>, name: string_view, ns: i64) void {
    derr(mp
        .gstr_string(64)
        .gstr_append(mp, "  ")
        .gstr_append(mp, name)
        .pad_sp(mp, 22 - name.view().len)
        .push_ms(mp, ns)
        .gstr_append(mp, " ms\n")
        .gstr_finish(mp))
    { }
}
tm_report = (mp: MutPtr<Malloc>, wall: i64, other_label: string_view) void {
    time_on.then({
        sum := tm_flatten + tm_parse + tm_resolve + tm_check + tm_emit + tm_cc
        derr("zenc --time: pipeline stages\n")
        tm_cache_hit.then({
            derr("  (binary cache hit — compile stages skipped; ZENC_NO_CACHE=1 forces a full compile)\n")
            { }
        })
        mp.tm_row("flatten", tm_flatten)
        mp.tm_row("parse", tm_parse)
        mp.tm_row("resolve", tm_resolve)
        mp.tm_row("check", tm_check)
        mp.tm_row("mono+emit", tm_emit)
        mp.tm_row("cc", tm_cc)
        mp.tm_row(other_label, wall - sum)
        mp.tm_row("total", wall)
    })
}
// type-check, then (if clean) emit + cc to `out`. returns 0 on success, 1 on a check error or cc
// failure. The cache wraps this whole pipeline: a hit copies the previously-built binary and skips
// resolve-onward re-verification (the key proves the identical closure already compiled cleanly).
compile_to = (
    mp: MutPtr<Malloc>,
    root: string_view,
    path: string_view,
    src: string_view,
    out: string_view,
    ccflags: string_view,
    links: string_view,
    target: string_view,
) i32 {
    ccname := mp.cross_cc(target)
    (ccname == "").then({
        return 1
    })    // unresolvable cross toolchain: already reported loudly; NEVER fall back to host cc
    cb := mp.cache_probe("bin", root, path, src, ccflags, links, target)
    (cache_on() && cb == "" == false && file_exists(cb) && mp.cache_bin_cmd(cb, out).system() == 0).match ({
        true  => {
            tm_cache_hit = true
            0
        },
        false => {
            rc := mp.compile_flat(root, path, src, out, ccflags, links, ccname)
            (rc == 0 && cache_on() && cb == "" == false).then({
                mp.cache_store_bin(cb, out)
            })
            rc
        },
    })
}
compile_flat = (
    mp: MutPtr<Malloc>,
    root: string_view,
    path: string_view,
    src: string_view,
    out: string_view,
    ccflags: string_view,
    links: string_view,
    ccname: string_view,
) i32 {
    t0 := mp.tm_mark()
    rp := mp.resolve_prog(root, path, src)
    tm_flatten = mp.tm_lap(t0)
    (mp.report_no_if_resolved(rp, path, src) == 0).match ({
        true  => {
            t1 := mp.tm_mark()
            raw := mp.parse_module(rp.flat)
            tm_parse = mp.tm_lap(t1)
            t2 := mp.tm_mark()
            decls := mp.resolve_module(raw)
            tm_resolve = mp.tm_lap(t2)
            t3 := mp.tm_mark()
            crc := mp.report_check(raw, decls, rp, path, src)
            tm_check = mp.tm_lap(t3)
            (crc == 0).match ({
                true  => {
                    t4 := mp.tm_mark()
                    gen := mp.genModuleIn(decls)
                    tm_emit = mp.tm_lap(t4)
                    tmpc := mp.TMPC()
                    write_runnable_c(tmpc, gen).match ({
                        true  => {
                            t5 := mp.tm_mark()
                            ccrc := mp.cc_command(root, tmpc, out, ccflags, links, ccname).system()
                            tm_cc = mp.tm_lap(t5)
                            (ccrc == 0).match ({
                                true  => 0,
                                false => {
                                    derr("zenc: internal: generated C failed to compile (this is a compiler bug — please report)\n")
                                    1
                                },
                            })
                        },
                        false => 1,
                    })
                },
                false => 1,
            })
        },
        false => 1,
    })
}
// ── subcommands ───────────────────────────────────────────────────────────────────────────────────
// `emit <file>` type-checks FIRST (like check/build) and STOPS on any error, so a type-broken program
// never produces C that references undefined names. `--force` / `--no-check` are CLI aliases of the
// checked path (they do NOT bypass the validator); flag may sit before OR after the path.
emit_file = (mp: MutPtr<Malloc>, root: string_view, a2: string_view, a3: string_view) i32 {
    flag2 := a2 == "--force" || a2 == "--no-check"
    path := flag2.then({ a3 }, { a2 })
    force := flag2 || a3 == "--force" || a3 == "--no-check"
    force.then({ mp.emit_raw(root, path) }, { mp.emit_checked(root, path) })
}
// emit_raw is an alias of emit_checked — kept so older call sites still resolve.
emit_raw = (mp: MutPtr<Malloc>, root: string_view, path: string_view) i32 {
    mp.emit_checked(root, path)
}
// checked: run the full report_check pipeline; emit only when clean, else exit 1 with the diagnostic.
emit_checked = (mp: MutPtr<Malloc>, root: string_view, path: string_view) i32 {
    contents_in(mp, path).match ({
        .Ok(src) => {
            rp := mp.resolve_prog(root, path, src)
            (mp.report_no_if_resolved(rp, path, src) == 0).match ({
                true  => {
                    raw := mp.parse_module(rp.flat)
                    decls := mp.resolve_module(raw)
                    (mp.report_check(raw, decls, rp, path, src) == 0).match ({
                        true  => {
                            out_bytes(mp.genModuleIn(decls).bytes())
                            0
                        },
                        false => 1,
                    })
                },
                false => 1,
            })
        },
        .Err(e)  => {
            derr("zenc: cannot read input\n")
            1
        },
    })
}
// ── js backend (task #46): Zen AST -> JavaScript. `emit-js` checks then emits the floor
// (bootstrap/zenrt.js) + the module JS; `build --target js` writes the same to a .js file. Additive:
// it reuses the exact resolve/parse/check pipeline, only swapping genModuleIn for genJsModuleIn. ──
js_floor = (mp: MutPtr<Malloc>, root: string_view) string_view {
    contents_in(mp, mp.bs_join(root, "bootstrap/zenrt.js")).match ({
        .Ok(src) => src,
        .Err(e)  => {
            derr("zenc: emit-js: cannot open bootstrap/zenrt.js floor\n")
            ""
        },
    })
}
// emit floor + module JS to stdout (checked): a type-broken program never produces JS.
emit_js = (mp: MutPtr<Malloc>, root: string_view, path: string_view) i32 {
    contents_in(mp, path).match ({
        .Ok(src) => {
            rp := mp.resolve_prog(root, path, src)
            (mp.report_no_if_resolved(rp, path, src) == 0).match ({
                true  => {
                    raw := mp.parse_module(rp.flat)
                    decls := mp.resolve_module(raw)
                    (mp.report_check(raw, decls, rp, path, src) == 0).match ({
                        true  => {
                            out(mp.js_floor(root))
                            out("\n")
                            out_bytes(mp.genJsModuleIn(decls).bytes())
                            0
                        },
                        false => 1,
                    })
                },
                false => 1,
            })
        },
        .Err(e)  => {
            derr("zenc: emit-js: cannot read input\n")
            1
        },
    })
}
// `zenc build --target js <file> [-o out.js]` -> write floor + module JS to `out` (default a.js).
build_js = (mp: MutPtr<Malloc>, root: string_view, path: string_view, out_path: string_view) i32 {
    contents_in(mp, path).match ({
        .Ok(src) => {
            rp := mp.resolve_prog(root, path, src)
            (mp.report_no_if_resolved(rp, path, src) == 0).match ({
                true  => {
                    raw := mp.parse_module(rp.flat)
                    decls := mp.resolve_module(raw)
                    (mp.report_check(raw, decls, rp, path, src) == 0).match ({
                        true  => {
                            js := mp
                                .gstr_string(8192)
                                .gstr_append(mp, mp.js_floor(root))
                                .gstr_append(mp, "\n")
                            mod := mp.genJsModuleIn(decls)
                            full := js.gstr_append(mp, mod.finish_cstr(mp))
                            save(out_path, full.finish_cstr(mp), full.len).match ({
                                .Ok(n)  => {
                                    derr("zenc: wrote ")
                                    derr(out_path)
                                    derr("\n")
                                    0
                                },
                                .Err(e) => 1,
                            })
                        },
                        false => 1,
                    })
                },
                false => 1,
            })
        },
        .Err(e)  => {
            derr("zenc: build --target js: cannot read input\n")
            1
        },
    })
}
finish_cstr = (s: String, mp: MutPtr<Malloc>) string_view { cstr(s.ptr) }
// `zenc build`/`zenc targets` with no project argument default to the current directory when it
// holds a build.zen — so `./zen build` at the repo root builds the compiler's own registered
// targets. An explicit argument (file or dir) is never rewritten.
proj_dir = (a: string_view) string_view {
    (a == "" && file_exists("build.zen")).then({ "." }, { a })
}
// `zenc build [-r|--release] [--time] [--target <name>] [project]` — leading flags directly after
// `build` are consumed by build_flags (in any order): `-r`/`--release` selects the RELEASE profile
// (see the profile block above cc_command), `--time` turns on the stage table; every later
// positional shifts by their count (`s`). `zenc build --target js <file> [-o out]` -> the js
// backend; otherwise the ordinary C `build`. Unshifted args: arg(2)=--target arg(3)=js
// arg(4)=<file> arg(5)=-o arg(6)=<out>.
build_flags = (s: i32) i32 {
    a := arg(2 + s)
    (a == "--time").then({
        time_enable()
        return build_flags(s + 1)
    })
    (a == "-r" || a == "--release").then({
        profile_release_set()
        return build_flags(s + 1)
    })
    s
}
build_target = (mp: MutPtr<Malloc>, root: string_view, s: i32) i32 {
    (arg(2 + s) == "--target" && arg(3 + s) == "js").match ({
        true  => {
            out := (arg(5 + s) == "-o").then({ arg(6 + s) }, { "a.js" })
            mp.build_js(root, arg(4 + s), out)
        },
        false => (arg(2 + s) == "--target").match ({
            true  => mp.build_named_plan(root, proj_dir(arg(4 + s)), arg(3 + s)),
            false => {
                dir := proj_dir(arg(2 + s))
                file_exists(mp.join2(dir, "build.zen")).match ({
                    true  => mp.build_all_plan(root, dir),
                    false => mp.build_spec(root, mp.resolve_spec(root, dir), arg(3 + s), arg(4 + s)),
                })
            },
        }),
    })
}
// check/build/run operate on a Spec (a single file, or a zen.toml project). spec.source is the
// entry; spec.ccflags/links/out come from a project's manifest (empty for a single file).
check_spec = (mp: MutPtr<Malloc>, root: string_view, spec: Spec) i32 {
    spec.ok.then({ mp.check_spec_ok(root, spec) }, { 1 })
}    // resolve_spec already reported why
check_spec_ok = (mp: MutPtr<Malloc>, root: string_view, spec: Spec) i32 {
    ffi_grants_set(spec.ffi)    // manifest/registry FFI grants: stamped before probe AND resolve
    genmods_set(spec.genmods)    // registered c_library genmods: same stamp discipline
    contents_in(mp, spec.source).match ({
        .Ok(src) => {
            // a probe hit means this exact closure content already checked clean: replay the ok line.
            ck := mp.cache_probe("check", root, spec.source, src, spec.ccflags, spec.links, spec.target)
            (cache_on() && ck == "" == false && file_exists(ck)).match ({
                true  => check_ok_line(spec.source),
                false => {
                    rp := mp.resolve_prog(root, spec.source, src)
                    (mp.report_no_if_resolved(rp, spec.source, src) == 0).match ({
                        true  => {
                            raw := mp.parse_module(rp.flat)
                            decls := mp.resolve_module(raw)
                            (mp.report_check(raw, decls, rp, spec.source, src) == 0).match ({
                                true  => {
                                    (cache_on() && ck == "" == false).then({
                                        cache_put_ok(ck)
                                    })
                                    check_ok_line(spec.source)
                                },
                                false => 1,
                            })
                        },
                        false => 1,
                    })
                },
            })
        },
        .Err(e)  => {
            derr("zenc: cannot open input\n")
            1
        },
    })
}
check_ok_line = (path: string_view) i32 {
    derr("zenc: ")
    derr(path)
    derr(": ok\n")
    0
}    // <path>: ok -> stderr
build_spec = (
    mp: MutPtr<Malloc>,
    root: string_view,
    spec: Spec,
    flag: string_view,
    outarg: string_view,
) i32 {
    spec.ok.match ({
        true  => {
            spec.library.then({
                derr("zenc: cannot build a library project yet; use `zenc check <project>`\n")
                return 1
            })
            ffi_grants_set(spec.ffi)    // manifest/registry FFI grants: stamped before probe AND resolve
            genmods_set(spec.genmods)    // registered c_library genmods: same stamp discipline
            out := (spec.out == "").then({ build_out(flag, outarg) }, { spec.out })
            contents_in(mp, spec.source).match ({
                .Ok(src) => (mp.compile_to(root, spec.source, src, out, spec.ccflags, spec.links, spec.target) == 0).match ({
                    true  => file_exists(out).match ({
                        true  => {
                            derr("zenc: wrote ")
                            derr(out)
                            derr("\n")
                            0
                        },
                        false => {
                            derr("zenc: build produced no binary: ")
                            derr(out)
                            derr(" (compiler reported success but the file is missing)\n")
                            1
                        },
                    }),
                    false => {
                        derr("zenc: build failed: ")
                        derr(spec.source)
                        derr("\n")
                        1
                    },
                }),
                .Err(e)  => {
                    derr("zenc: cannot open input: ")
                    derr(spec.source)
                    derr("\n")
                    1
                },
            })
        },
        false => 1,
    })
}
// shell-quote one forwarded arg for the `system()` sh -c line: wrap in single quotes,
// an embedded `'` becomes `'\''` (close, escaped quote, reopen).
quote_arg = (s: String, mp: MutPtr<Malloc>, t: string_view) String {
    cur := s.gstr_push(mp, '\'')
    v: [u8] := t.view()
    v.loop((h, i, b) {
        cur = (b == '\'').then({ cur.gstr_append(mp, "'\\''") }, { cur.gstr_push(mp, b) })
    })
    cur.gstr_push(mp, '\'')
}
append_run_args = (s: String, mp: MutPtr<Malloc>, i: i32, n: i32) String {
    (i >= n).match ({
        true  => s,
        false => s.gstr_push(mp, ' ').quote_arg(mp, arg(i)).append_run_args(mp, i + 1, n),
    })
}
// `zenc run <file> a b c` — everything after the source path is forwarded to the program's argv
// (arg(3).., or arg(4).. when `--time` shifted the path; the program reads it back via
// std.sys.os.arg(i)/argc(), argv[0] being the temp binary).
run_fwd_from := 3
run_command = (mp: MutPtr<Malloc>, bin: string_view) string_view {
    mp
        .gstr_string(128)
        .gstr_append(mp, bin)
        .append_run_args(mp, to_i32(run_fwd_from), argc())
        .gstr_finish(mp)
}
run_spec = (mp: MutPtr<Malloc>, root: string_view, spec: Spec) i32 {
    spec.ok.match ({
        true  => {
            spec.library.then({
                derr("zenc: cannot run a library project; use `zenc check <project>`\n")
                return 1
            })
            ffi_grants_set(spec.ffi)    // manifest/registry FFI grants: stamped before probe AND resolve
            genmods_set(spec.genmods)    // registered c_library genmods: same stamp discipline
            contents_in(mp, spec.source).match ({
                .Ok(src) => {
                    bin := mp.TMPBIN()
                    (mp.compile_to(root, spec.source, src, bin, spec.ccflags, spec.links, spec.target) == 0).match ({
                        true  => mp.run_command(bin).system() / 256,
                        false => 1,
                    })
                },
                .Err(e)  => {
                    derr("zenc: cannot open input: ")
                    derr(spec.source)
                    derr("\n")
                    1
                },
            })
        },
        false => 1,
    })
}
// ── `zenc run`/`zenc build` verb wrappers: peel `--time`, run, then print the stage table ─────────
run_cmd = (mp: MutPtr<Malloc>, root: string_view) i32 {
    tt := arg(2) == "--time"
    tt.then({
        time_enable()
        run_fwd_from = 4
    })
    t0 := mp.tm_mark()
    rc := mp.run_spec(root, mp.resolve_spec(root, tt.then({ arg(3) }, { arg(2) })))
    mp.tm_report(mp.tm_lap(t0), "other (io/cache/run)")
    rc
}
build_cmd = (mp: MutPtr<Malloc>, root: string_view) i32 {
    s := build_flags(0)
    t0 := mp.tm_mark()
    rc := mp.build_target(root, s)
    mp.tm_report(mp.tm_lap(t0), "other (io/cache)")
    rc
}
// ── `zenc profile` — sampling profiler with zen-native names ──────────────────────────────────────
// Compiles the program dev-profile plus frame pointers (PROFILE_PERF above), records with
// `perf record -g --call-graph fp`, and renders `perf report --no-children` as a top-20
// `SELF% CUM% FUNCTION` table — hoisted impl methods (`impl_<Trait>_<Ty>_<m>` in the emitted C)
// are demangled back to `Ty.m` via the same parse-level DImpl walk the audit/sigs tools use.
// No perf on PATH (or perf denied by perf_event_paranoid, observable as zero samples) falls back
// to gprof `-pg` instrumentation; neither present is an honest error naming both. `--raw` dumps
// the untouched perf/gprof report instead of the table.
PROF_TOP = () i64 { 20 }
PROF_USAGE = () string_view { "usage: zenc profile [--raw] <file.zen|project> [-- prog args]\n" }
ProfArgs: {
    path: string_view,
    raw: bool,
    fwd: i32,
}
// one parsed report row: pct in hundredths of a percent (-1 = not a data row), the raw C symbol,
// and the DSO it lives in ("" for gprof, whose flat profile is single-binary by construction).
ProfRow: {
    pct: i64,
    sym: string_view,
    dso: string_view,
}
ProfPct: {
    val: i64,
    end: i64,
}
ProfParse: {
    n: i64,
    samples: string_view,
}
ProfNames: {
    idx: Map<i64>,
    disp: [string_view],
}
prof_args = (i: i32, n: i32, acc: ProfArgs) ProfArgs {
    (i >= n).then({
        return acc
    })
    a := arg(i)
    (a == "--").then({
        return ProfArgs(
            path: acc.path,
            raw: acc.raw,
            fwd: i + 1,
        )
    })
    (a == "--raw").then({
        return prof_args(i + 1, n, ProfArgs(
            path: acc.path,
            raw: true,
            fwd: acc.fwd,
        ))
    })
    (acc.path == "").match ({
        true  => prof_args(i + 1, n, ProfArgs(
            path: a,
            raw: acc.raw,
            fwd: acc.fwd,
        )),
        false => prof_args(i + 1, n, acc),
    })
}
// ── report parsing: byte-level line scan (bounds are the line's [ls, le), never the whole file) ──
prof_skip_sp = (v: [u8], i: i64, e: i64) i64 {
    (i < e && (v[i] == ' ' || v[i] == '\t')).then({ v.prof_skip_sp(i + 1, e) }, { i })
}
prof_skip_tok = (v: [u8], i: i64, e: i64) i64 {
    (i < e && v[i] == ' ' == false && v[i] == '\t' == false).match ({
        true  => v.prof_skip_tok(i + 1, e),
        false => i,
    })
}
prof_rtrim = (v: [u8], ls: i64, e: i64) i64 {
    (e > ls && (v[e - 1] == ' ' || v[e - 1] == '\t' || v[e - 1] == '\r')).match ({
        true  => v.prof_rtrim(ls, e - 1),
        false => e,
    })
}
prof_digits = (v: [u8], i: i64, e: i64, acc: i64) ProfPct {
    (i < e && v[i] >= '0' && v[i] <= '9').match ({
        true  => v.prof_digits(i + 1, e, acc * 10 + to_i64(v[i]) - to_i64('0')),
        false => ProfPct(
            val: acc,
            end: i,
        ),
    })
}
// "12.34" at i -> 1234 hundredths (perf and gprof both print percentages as %.2f; anything else,
// including a bare integer or a "7208/7208" calls token, is rejected with val -1).
prof_pct = (v: [u8], i: i64, e: i64) ProfPct {
    d1 := v.prof_digits(i, e, 0)
    (d1.end == i).then({
        return ProfPct(
            val: 0 - 1,
            end: i,
        )
    })
    (d1.end < e && v[d1.end] == '.').match ({
        true  => {
            d2 := v.prof_digits(d1.end + 1, e, 0)
            (d2.end == d1.end + 3).match ({
                true  => ProfPct(
                    val: d1.val * 100 + d2.val,
                    end: d2.end,
                ),
                false => ProfPct(
                    val: 0 - 1,
                    end: d2.end,
                ),
            })
        },
        false => ProfPct(
            val: 0 - 1,
            end: d1.end,
        ),
    })
}
// bytes [a, b) as an owned str (through the allocator, like cstr_prefix).
push_span = (s: String, mp: MutPtr<Malloc>, v: [u8], i: i64, n: i64) String {
    (i >= n).then({ s }, { push_span(s.gstr_push(mp, v[i]), mp, v, i + 1, n) })
}
prof_span = (mp: MutPtr<Malloc>, v: [u8], a: i64, b: i64) string_view {
    push_span(mp.gstr_string(b - a + 1), mp, v, a, b).gstr_finish(mp)
}
prof_starts = (v: [u8], ls: i64, le: i64, lit: string_view) bool {
    w: [u8] := lit.view()
    (le - ls < w.len).then({
        return false
    })
    ok := true
    w.loop((h, i, b) {
        ok = ok && v[ls + i] == b
    })
    ok
}
prof_token = (mp: MutPtr<Malloc>, v: [u8], i: i64, e: i64) string_view {
    a := v.prof_skip_sp(i, e)
    mp.prof_span(v, a, v.prof_skip_tok(a, e))
}
// a perf data row: `   12.34%  cmd  dso  [.] symbol` (the `#` header/comment lines, callchain
// residue, and anything not opening with a %.2f percent are all rejected).
prof_perf_row = (mp: MutPtr<Malloc>, v: [u8], ls: i64, le: i64) ProfRow {
    none := ProfRow(
        pct: 0 - 1,
        sym: "",
        dso: "",
    )
    e := v.prof_rtrim(ls, le)
    i := v.prof_skip_sp(ls, e)
    (i >= e || v[i] < '0' || v[i] > '9').then({
        return none
    })
    p := v.prof_pct(i, e)
    (p.val < 0 || p.end >= e || v[p.end] == '%' == false).then({
        return none
    })
    j := v.prof_skip_sp(p.end + 1, e)
    j = v.prof_skip_tok(j, e)    // command (the process name)
    j = v.prof_skip_sp(j, e)
    d0 := j
    j = v.prof_skip_tok(j, e)    // shared object
    dso := mp.prof_span(v, d0, j)
    j = v.prof_skip_sp(j, e)
    (j < e && v[j] == '[').then({
        j = v.prof_skip_tok(j, e)    // the "[.]"/"[k]" privilege marker
        j = v.prof_skip_sp(j, e)
    })
    (j >= e).then({
        return none
    })
    // an unresolved plain address (restricted kallsyms / stripped dso) tells the user nothing —
    // drop the row so the top-20 stays meaningful zen/libc names.
    (j + 1 < e && v[j] == '0' && v[j + 1] == 'x').then({
        return none
    })
    ProfRow(
        pct: p.val,
        sym: mp.prof_span(v, j, e),
        dso: dso,
    )
}
prof_parse_perf = (mp: MutPtr<Malloc>, body: string_view, rows: [ProfRow]) ProfParse {
    v: [u8] := body.view()
    n := 0
    samples := ""
    ls := 0
    v.loop((h, i, b) {
        (b == '\n').then({
            (n < rows.len).then({
                v.prof_starts(ls, i, "# Samples: ").then({
                    samples = mp.prof_token(v, ls + 11, i)
                })
                r := mp.prof_perf_row(v, ls, i)
                (r.pct >= 0).then({
                    rows[n] = r
                    n = n + 1
                })
            })
            ls = i + 1
        })
    })
    ProfParse(
        n: n,
        samples: samples,
    )
}
// first char of the last space-separated token in [lo, e); lo if the span is one token.
prof_tok_back = (v: [u8], lo: i64, i: i64) i64 {
    (i <= lo).then({
        return lo
    })
    (v[i - 1] == ' ' || v[i - 1] == '\t').then({ i }, { v.prof_tok_back(lo, i - 1) })
}
// a gprof flat-profile data row: ` 33.34   0.02   0.02   7208  0.00  0.00  name` (numeric middle
// columns vary — uncounted rows leave calls/ms blank — so the NAME is the last token, guarded to
// not itself start with a digit).
prof_gprof_row = (mp: MutPtr<Malloc>, v: [u8], ls: i64, le: i64) ProfRow {
    none := ProfRow(
        pct: 0 - 1,
        sym: "",
        dso: "",
    )
    e := v.prof_rtrim(ls, le)
    i := v.prof_skip_sp(ls, e)
    (i >= e || v[i] < '0' || v[i] > '9').then({
        return none
    })
    p := v.prof_pct(i, e)
    (p.val < 0 || p.end >= e || v[p.end] == ' ' == false).then({
        return none
    })
    t := v.prof_tok_back(p.end + 1, e)
    (t <= p.end + 1 || v[t] >= '0' && v[t] <= '9').then({
        return none
    })
    ProfRow(
        pct: p.val,
        sym: mp.prof_span(v, t, e),
        dso: "",
    )
}
prof_parse_gprof = (mp: MutPtr<Malloc>, body: string_view, rows: [ProfRow]) i64 {
    v: [u8] := body.view()
    n := 0
    ls := 0
    v.loop((h, i, b) {
        (b == '\n').then({
            (n < rows.len).then({
                r := mp.prof_gprof_row(v, ls, i)
                (r.pct >= 0).then({
                    rows[n] = r
                    n = n + 1
                })
            })
            ls = i + 1
        })
    })
    n
}
// ── demangling: hoisted impl-method C names back to `Ty.m` (mirrors tools/sigs.zen + audit) ──────
prof_disp = (mp: MutPtr<Malloc>, ty: string_view, mname: string_view) string_view {
    mp
        .gstr_string(48)
        .gstr_append(mp, ty)
        .gstr_push(mp, '.')
        .gstr_append(mp, mname)
        .gstr_finish(mp)
}
prof_names = (mp: MutPtr<Malloc>, decls: [Decl]) ProfNames {
    tds := mp.aud_td_idxs(decls)
    n := 0
    decls.loop((h, i, d) {
        d.match ({
            .DImpl(im) => {
                n = n + im.methods.len + decls.aud_impl_dflts(tds, im.trname)
            },
            _          => { },
        })
    })
    disp := cbuf<string_view>(mp, n + 1)
    seedv: i64 := 0 - 1
    m := of(mp, "", seedv).expect("profile: oom")
    k := 0
    decls.loop((h, i, d) {
        d.match ({
            .DImpl(im) => {
                im.methods.loop((h2, j, p) {
                    m = m
                        .put(mp, mp.impl_cname_in(im.trname, im.ty, p.name), k)
                        .expect("profile: oom")
                    disp[k] = mp.prof_disp(im.ty, p.name)
                    k = k + 1
                })
                tds.loop((h2, j, ti) {
                    decls[ti].match ({
                        .DTraitDefault(td) => {
                            (td.trname == im.trname).then({
                                m = m
                                    .put(mp, mp.impl_cname_in(im.trname, im.ty, td.fn.name), k)
                                    .expect("profile: oom")
                                disp[k] = mp.prof_disp(im.ty, td.fn.name)
                                k = k + 1
                            })
                        },
                        _                  => { },
                    })
                })
            },
            _          => { },
        })
    })
    ProfNames(
        idx: m,
        disp: disp,
    )
}
// the compiled program's parse-level decls carry every DImpl — a light frontend pass (resolve
// imports + parse, no check) is enough to rebuild the impl-method name table for display.
prof_names_of = (mp: MutPtr<Malloc>, root: string_view, spec: Spec, src: string_view) ProfNames {
    rp := mp.resolve_prog(root, spec.source, src)
    mp.prof_names(mp.parse_module(rp.flat))
}
prof_binname = (mp: MutPtr<Malloc>, p: string_view) string_view {
    v: [u8] := p.view()
    cut := last_slash(v, 0, 0 - 1)
    (cut < 0).then({ p }, { cstr(offset(p, cut + 1)) })
}
// %.2f right-aligned to 6 columns (from hundredths).
push_pct = (s: String, mp: MutPtr<Malloc>, h: i64) String {
    ip := h / 100
    pad := (ip < 10).match ({
        true  => 3,
        false => (ip < 100).match ({
            true  => 2,
            false => (ip < 1000).then({ 1 }, { 0 }),
        }),
    })
    s2 := s.pad_sp(mp, pad).push_int(mp, ip).gstr_push(mp, '.')
    f := h % 100
    (f < 10).then({ s2.gstr_push(mp, '0').push_int(mp, f) }, { s2.push_int(mp, f) })
}
prof_table = (
    mp: MutPtr<Malloc>,
    source: string_view,
    engine: string_view,
    samples: string_view,
    rows: [ProfRow],
    n: i64,
    names: ProfNames,
    binname: string_view,
) void {
    hdr := mp
        .gstr_string(128)
        .gstr_append(mp, "zen profile: ")
        .gstr_append(mp, source)
        .gstr_append(mp, " — ")
        .gstr_append(mp, engine)
    hdr = (samples == "").match ({
        true  => hdr,
        false => hdr.gstr_append(mp, ", ").gstr_append(mp, samples).gstr_append(mp, " samples"),
    })
    say(hdr.gstr_finish(mp))
    say("  SELF%     CUM%  FUNCTION")
    cum := to_i64(0)
    rows.loop((h, i, r) {
        (i < n).then({
            cum = cum + r.pct
            di := names.idx.get(r.sym, 0 - 1)
            disp := (di < 0).then({ r.sym }, { names.disp[di] })
            line := mp
                .gstr_string(96)
                .push_pct(mp, r.pct)
                .gstr_append(mp, "  ")
                .push_pct(mp, cum)
                .gstr_append(mp, "  ")
                .gstr_append(mp, disp)
            line = (r.dso == binname || r.dso == "" || r.dso.starts_with("[")).match ({
                true  => line,
                false => line.gstr_append(mp, "  [").gstr_append(mp, r.dso).gstr_append(mp, "]"),
            })
            say(line.gstr_finish(mp))
        })
    })
}
// perf lane. Returns the program's exit code on success, or -1 meaning "perf yielded no samples —
// try gprof" (perf on PATH but perf_event_paranoid too strict is exactly this shape).
prof_perf = (
    mp: MutPtr<Malloc>,
    root: string_view,
    spec: Spec,
    src: string_view,
    pa: ProfArgs,
) i32 {
    profile_perf_set()
    bin := mp.pid_path("/tmp/zenprof_", ".bin")
    (mp.compile_to(root, spec.source, src, bin, spec.ccflags, spec.links, spec.target) == 0 == false).then({
        return 1
    })
    data := mp.pid_path("/tmp/zenprof_", ".data")
    prc := mp
        .gstr_string(256)
        .gstr_append(mp, "perf record -q -g --call-graph fp -o ")
        .gstr_append(mp, data)
        .gstr_append(mp, " -- ")
        .gstr_append(mp, bin)
        .append_run_args(mp, pa.fwd, argc())
        .gstr_finish(mp)
        .system()
    txt := mp.pid_path("/tmp/zenprof_", ".txt")
    mp
        .gstr_string(256)
        .gstr_append(mp, "perf report --stdio --no-children ")
        .gstr_append(mp, pa.raw.then({ "" }, { "-g none " }))
        .gstr_append(mp, "-i ")
        .gstr_append(mp, data)
        .gstr_append(mp, " > ")
        .gstr_append(mp, txt)
        .gstr_append(mp, " 2>/dev/null")
        .gstr_finish(mp)
        .system()
    body := contents_in(mp, txt).or("")
    pa.raw.then({
        (body == "").then({
            return 0 - 1
        })
        out(body).or(0)
        return 0
    })
    rows := cbuf<ProfRow>(mp, PROF_TOP())
    pp := mp.prof_parse_perf(body, rows)
    (pp.n == 0).then({
        return 0 - 1
    })
    mp.prof_table(spec.source, "perf", pp.samples, rows, pp.n, mp.prof_names_of(root, spec, src), mp.prof_binname(bin))
    prc / 256
}
// gprof lane: recompile with -pg, run inside a scratch dir (gmon.out lands in the program's cwd),
// then `gprof -b -p` for the flat profile (-b alone, with the call graph, for --raw).
prof_gprof = (
    mp: MutPtr<Malloc>,
    root: string_view,
    spec: Spec,
    src: string_view,
    pa: ProfArgs,
) i32 {
    profile_gprof_set()
    bin := mp.pid_path("/tmp/zenprof_", ".bin")
    (mp.compile_to(root, spec.source, src, bin, spec.ccflags, spec.links, spec.target) == 0 == false).then({
        return 1
    })
    dir := mp.pid_path("/tmp/zenprof_gm_", "")
    rrc := mp
        .gstr_string(256)
        .gstr_append(mp, "mkdir -p ")
        .gstr_append(mp, dir)
        .gstr_append(mp, " && cd ")
        .gstr_append(mp, dir)
        .gstr_append(mp, " && ")
        .gstr_append(mp, bin)
        .append_run_args(mp, pa.fwd, argc())
        .gstr_finish(mp)
        .system()
    txt := mp.pid_path("/tmp/zenprof_", ".txt")
    mp
        .gstr_string(256)
        .gstr_append(mp, "gprof -b ")
        .gstr_append(mp, pa.raw.then({ "" }, { "-p " }))
        .gstr_append(mp, bin)
        .gstr_push(mp, ' ')
        .gstr_append(mp, dir)
        .gstr_append(mp, "/gmon.out > ")
        .gstr_append(mp, txt)
        .gstr_append(mp, " 2>/dev/null")
        .gstr_finish(mp)
        .system()
    body := contents_in(mp, txt).or("")
    (body == "").then({
        derr("zenc: profile: gprof produced no output (did the program run? did it exit through panic?)\n")
        return 1
    })
    pa.raw.then({
        out(body).or(0)
        return 0
    })
    rows := cbuf<ProfRow>(mp, PROF_TOP())
    n := mp.prof_parse_gprof(body, rows)
    (n == 0).then({
        derr("zenc: profile: no samples — the program finished too fast to profile; give it more work\n")
        return 1
    })
    mp.prof_table(spec.source, "gprof", "", rows, n, mp.prof_names_of(root, spec, src), "")
    rrc / 256
}
prof_run = (
    mp: MutPtr<Malloc>,
    root: string_view,
    spec: Spec,
    src: string_view,
    pa: ProfArgs,
    have_perf: bool,
) i32 {
    have_perf.match ({
        true  => {
            rc := mp.prof_perf(root, spec, src, pa)
            (rc >= 0).then({
                return rc
            })
            mp.which_ok("gprof").match ({
                true  => {
                    derr("zenc: perf recorded no samples (perf_event_paranoid too strict?); falling back to gprof\n")
                    mp.prof_gprof(root, spec, src, pa)
                },
                false => {
                    derr("zenc: perf recorded no samples (check /proc/sys/kernel/perf_event_paranoid) and gprof is not installed\n")
                    1
                },
            })
        },
        false => mp.prof_gprof(root, spec, src, pa),
    })
}
profile_cmd = (mp: MutPtr<Malloc>, root: string_view) i32 {
    pa := prof_args(2, argc(), ProfArgs(
        path: "",
        raw: false,
        fwd: argc(),
    ))
    (pa.path == "").then({
        derr(PROF_USAGE())
        return 2
    })
    have_perf := mp.which_ok("perf")
    (have_perf == false && mp.which_ok("gprof") == false).then({
        derr("zenc: profile needs a profiler on PATH: install `perf` (linux-tools) or `gprof` (binutils)\n")
        return 1
    })
    spec := mp.resolve_spec(root, pa.path)
    spec.ok.match ({
        true  => {
            spec.library.then({
                derr("zenc: cannot profile a library project; profile a program with a main\n")
                return 1
            })
            ffi_grants_set(spec.ffi)    // manifest/registry FFI grants: stamped before probe AND resolve
            genmods_set(spec.genmods)    // registered c_library genmods: same stamp discipline
            contents_in(mp, spec.source).match ({
                .Ok(src) => mp.prof_run(root, spec, src, pa, have_perf),
                .Err(e)  => {
                    derr("zenc: cannot open input: ")
                    derr(spec.source)
                    derr("\n")
                    1
                },
            })
        },
        false => 1,
    })
}
// the project ROOT (holds src/std + src/compiler + bootstrap): $ZEN_ROOT if set (a relocated binary
// points it at a checkout), else the directory of the binary (argv[0]).
root_of = (mp: MutPtr<Malloc>) string_view {
    e := getEnv("ZEN_ROOT")
    (e == "").then({ mp.dirname(arg(0)) }, { e })
}
HELP = () string_view {
    "usage: zenc <run|build|profile|check|audit|emit|doc|fmt|init|lsp|targets|--build-self|--version|--help> <file>\n  zenc init [path] [--bin|--lib]\n  zenc build [-r|--release] [--time] [--target <name>] [project]\n                                       build registered targets — dev profile (-O1 -g) by default,\n                                       -r/--release = optimized (-O2 -fno-strict-aliasing)\n  zenc run [--time] <file|project> [args]  compile + run; --time prints per-stage compile timings\n  zenc profile [--raw] <file.zen|project> [-- args]\n                                       sampling profile (perf; gprof fallback) with zen-native names\n  zenc targets <project>               list registered targets\n  zenc doc <std.mod|file.zen>\n  zenc audit <file.zen> [--strict]     dead-code + unused-import report (advisory; --strict exits 1)\n  zenc audit --workspace <dir> [--strict]  union dead-code across every main-bearing entry under <dir>\n  zenc lsp                             diagnostics-only Language Server (JSON-RPC over stdio)\n  zenc --build-self <out.c> <root>     regenerate the seed, tree-shaken (only decls reachable from main)\n  zenc --build-self-full <out.c> <root>  regenerate the full seed (no tree-shake; every manifest decl)\n  cat file.zen | zenc   (source -> C filter)\n"
}
VERSION = () string_view { "zenc 0.2.0-dev (self-hosted; zen driver)" }    // also folded into every cache key
main = () i32 {
    m := Malloc(_: 0)
    mp := m.addr()
    root := mp.root_of()
    cmd := arg(1)
    (cmd == "--help").match ({
        true  => {
            say(HELP())
            0
        },
        false => (cmd == "--version").match ({
            true  => {
                say(VERSION())
                0
            },
            false => (cmd == "--build-self" || cmd == "--build-self-full").match ({
                true  => (arg(2) == "").match ({
                    true  => {
                        derr("usage: zenc --build-self[-full] <out.c> <srcroot>\n")
                        2
                    },
                    false => mp.build_self(arg(3), arg(2), cmd == "--build-self"),
                }),
                false => (cmd == "emit").match ({
                    true  => mp.emit_file(root, arg(2), arg(3)),
                    false => (cmd == "emit-js").match ({
                        true  => mp.emit_js(root, arg(2)),
                        false => (cmd == "check").match ({
                            true  => mp.check_spec(root, mp.resolve_spec(root, arg(2))),
                            false => (cmd == "run").match ({
                                true  => mp.run_cmd(root),
                                false => (cmd == "profile").match ({
                                    true  => mp.profile_cmd(root),
                                    false => (cmd == "build").match ({
                                        true  => mp.build_cmd(root),
                                        false => (cmd == "targets").match ({
                                            true  => mp.list_plan_targets(root, proj_dir(arg(2))),
                                            false => (cmd == "fmt").match ({
                                                true  => mp.fmt_cmd(arg(2), arg(3)),
                                                false => (cmd == "doc").match ({
                                                    true  => mp.doc_cmd(root, arg(2)),
                                                    false => (cmd == "init").match ({
                                                        true  => mp.zi_cmd(),
                                                        false => (cmd == "lsp").match ({
                                                            true  => mp.lsp_cmd(root),
                                                            false => (cmd == "audit").match ({
                                                                true  => mp.audit_cmd(root, arg(2), arg(3), arg(4)),
                                                                false => mp.default_emit(cmd),
                                                            }),
                                                        }),
                                                    }),
                                                }),
                                            }),
                                        }),
                                    }),
                                }),
                            }),
                        }),
                    }),
                }),
            }),
        }),
    })
}    // --build-self <out.c> <srcroot>
build_out = (flag: string_view, out: string_view) string_view {
    (flag == "-o").then({ out }, { "a.out" })
}    // `zenc <file>` (or stdin) -> raw C on stdout, the harness filter
// build output path: `build <file> -o <out>` -> <out>, else "a.out".
// the DEFAULT mode (no subcommand): `zenc <file>` or `cat … | zenc` -> emit C to stdout, RAW
// (resolve_module only, NO import flatten — std imports stay as-is; the harness depends on this).
// No subcommand and no file: bare `zenc`. An interactive terminal (isatty(0)) gets the help text
// rather than silently blocking on a stdin read; a pipe (`cat file.zen | zenc`) still filters to C.
default_emit = (mp: MutPtr<Malloc>, path: string_view) i32 {
    (path == "").match ({
        true  => (isatty(0) != 0).match ({
            true  => {
                say(HELP())
                0
            },
            false => mp.stdin_emit(mp.read_stdin()),
        }),
        false => mp.raw_emit_file(path),
    })
}
// piped stdin has no directory, so a sibling import `{ f } = b` can't resolve — error cleanly instead
// of emitting C that references undefined names (std imports stay raw, which the harness relies on).
stdin_emit = (mp: MutPtr<Malloc>, src: string_view) i32 {
    sib := mp.first_user_import_in(src)
    (sib == "").match ({
        true  => mp.raw_emit_src("<stdin>", src),
        false => {
            derr(mp
                .gstr_string(256)
                .gstr_append(mp, "zenc: <stdin>: error: sibling import '")
                .gstr_append(mp, sib)
                .gstr_append(mp, "' needs a source file on disk (stdin has no directory); use `zenc build <file.zen>`\n")
                .gstr_finish(mp))
            1
        },
    })
}
raw_emit_file = (mp: MutPtr<Malloc>, path: string_view) i32 {
    contents_in(mp, path).match ({
        .Ok(src) => mp.raw_emit_src(path, src),
        .Err(e)  => {
            derr("zenc: cannot open input\n")
            1
        },
    })
}
raw_emit_src = (mp: MutPtr<Malloc>, path: string_view, src: string_view) i32 {
    (mp.report_no_if_plain(path, src) == 0).match ({
        true  => {
            out_bytes(mp.genModuleIn(mp.resolve_module(mp.parse_module(src))).bytes())
            0
        },
        false => 1,
    })
}
// read all of fd 0 (stdin/pipe — no seekable size) into one buffer.
STDIN_CAP := 8388608
read_stdin = (mp: MutPtr<Malloc>) string_view {
    buf := mp.acquire(STDIN_CAP)
    n := read_fd_all(0, buf, 0, STDIN_CAP)
    buf.offset(n).store(0)
    cstr(buf)
}
read_fd_all = (fd: i32, buf: RawPtr<u8>, off: i64, cap: i64) i64 {
    r := fd.read(buf.offset(off), cap - off)
    (r <= 0).match ({
        true  => off,
        false => (off + r >= cap).then({ cap }, { read_fd_all(fd, buf, off + r, cap) }),
    })
}
// ── --build-self: regenerate the seed (ported from bootstrap/driver.c build_self) ─────────────────
BS_HEAD = () string_view { "typedef struct { void* ptr; int64_t len; } zslice; " }
BS_HEAD_REPL = () string_view { "#define ZEN_NO_MALLOC 1\n#include \"zenrt.h\"\n" }
bs_is_space = (b: u8) bool {
    (b == ' ').match ({
        true  => true,
        false => (b == '\t').match ({
            true  => true,
            false => (b == '\n').match ({
                true  => true,
                false => (b == '\r').match ({
                    true  => true,
                    false => (b == 11).then({ true }, { b == 12 }),
                }),
            }),
        }),
    })
}
bs_skip_space = (v: [u8], i: i64, e: i64) i64 {
    (i >= e).match ({
        true  => e,
        false => bs_is_space(v[i]).then({ v.bs_skip_space(i + 1, e) }, { i }),
    })
}
bs_trim_end = (v: [u8], s: i64, e: i64) i64 {
    (e <= s).match ({
        true  => s,
        false => bs_is_space(v[e - 1]).then({ v.bs_trim_end(s, e - 1) }, { e }),
    })
}
bs_line_end = (v: [u8], p0: i64, n: i64) i64 {
    p := p0
    @while (p < n && v[p] != '\n') {
        p = p + 1
    }    // iterative: a long line must not recurse per char
    p
}
bs_eq_run = (v: [u8], at: i64, nv: [u8], i: i64) bool {
    (i >= nv.len).match ({
        true  => true,
        false => (v[at + i] == nv[i]).then({ v.bs_eq_run(at, nv, i + 1) }, { false }),
    })
}
bs_match_at = (v: [u8], at: i64, e: i64, needle: string_view) bool {
    nv := needle.view()
    (at + nv.len > e).then({ false }, { v.bs_eq_run(at, nv, 0) })
}
bs_has_needle = (v: [u8], p: i64, e: i64) bool {
    (p >= e).match ({
        true  => false,
        false => v.bs_match_at(p, e, "= std.").match ({
            true  => true,
            false => v.bs_match_at(p, e, "= compiler.").match ({
                true  => true,
                false => v.bs_has_needle(p + 1, e),
            }),
        }),
    })
}
// `{` opening an import, tolerating a binding name directly after it (`{println}`) as well as `{ p`.
bs_brace_open = (b: u8) bool {
    b == ' ' || b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z' || b == '_'
}
bs_is_import = (v: [u8], p: i64, e: i64) bool {
    s := v.bs_skip_space(p, e)
    (s + 1 < e).match ({
        true  => (v[s] == '{').match ({
            true  => v[s + 1].bs_brace_open().then({ v.bs_has_needle(p, e) }, { false }),
            false => false,
        }),
        false => false,
    })
}
bs_push_range = (mp: MutPtr<Malloc>, out: String, v: [u8], p: i64, e: i64) String {
    (p >= e).then({ out }, { mp.bs_push_range(out.gstr_push(mp, v[p]), v, p + 1, e) })
}
bs_strip_file = (mp: MutPtr<Malloc>, out: String, v: [u8], p: i64, n: i64, first: bool) String {
    (p >= n).match ({
        true  => out,
        false => {
            e := v.bs_line_end(p, n)
            drop := v.bs_is_import(p, e)
            o2 := drop.match ({
                true  => out,
                false => {
                    sep := first.then({ out }, { out.gstr_push(mp, '\n') })
                    mp.bs_push_range(sep, v, p, e)
                },
            })
            nf := drop.then({ first }, { false })
            (e >= n).then({ o2 }, { mp.bs_strip_file(o2, v, e + 1, n, nf) })
        },
    })
}
bs_join = (mp: MutPtr<Malloc>, root: string_view, rel: string_view) string_view {
    mp
        .gstr_string(256)
        .gstr_append(mp, root)
        .gstr_append(mp, "/")
        .gstr_append(mp, rel)
        .gstr_finish(mp)
}
bs_rel = (mp: MutPtr<Malloc>, mv: [u8], s: i64, t: i64) string_view {
    mp.bs_push_range(mp.gstr_string(256), mv, s, t).gstr_finish(mp)
}
bs_add_source = (mp: MutPtr<Malloc>, out: String, root: string_view, rel: string_view) String {
    path := mp.bs_join(root, rel)
    contents_in(mp, path).match ({
        .Ok(src) => {
            sv := src.view()
            mp.bs_strip_file(out, sv, 0, sv.len, true)
        },
        .Err(e)  => {
            derr("zenc: --build-self: cannot open a source file\n")
            out
        },
    })
}
bs_walk_manifest = (
    mp: MutPtr<Malloc>,
    out: String,
    root: string_view,
    mv: [u8],
    p: i64,
    n: i64,
    count: i64,
) String {
    (p >= n).match ({
        true  => out,
        false => {
            e := mv.bs_line_end(p, n)
            s := mv.bs_skip_space(p, e)
            t := mv.bs_trim_end(s, e)
            keep := (s < t).then({ mv[s] != '#' }, { false })
            o2 := keep.match ({
                true  => {
                    sep := (count > 0).then({ out.gstr_push(mp, '\n') }, { out })
                    rel := mp.bs_rel(mv, s, t)
                    mp.bs_add_source(sep, root, rel)
                },
                false => out,
            })
            nc := keep.then({ count + 1 }, { count })
            (e >= n).then({ o2 }, { mp.bs_walk_manifest(o2, root, mv, e + 1, n, nc) })
        },
    })
}
bs_gen_end = (gv: [u8], n: i64) i64 {
    (n <= 0).match ({
        true  => 0,
        false => bs_is_space(gv[n - 1]).then({ gv.bs_gen_end(n - 1) }, { n }),
    })
}
bs_write = (out_path: string_view, gen: String) bool {
    hl := BS_HEAD().view().len
    end := gen.bytes().bs_gen_end(gen.len)
    fd := out_path.open(O_WRTRUNC, MODE_644)
    (fd < 0).match ({
        true  => false,
        false => {
            hv := BS_HEAD_REPL().view()
            fd.write(hv.ptr, hv.len)
            fd.write(gen.ptr.offset(hl), end - hl)
            fd.close()
            true
        },
    })
}
// emit the seed from the manifest concatenation `flat` (kept byte-exact), but ONLY after the compiler's
// own source has passed its strict validator. The manifest flat itself is NOT directly checkable — it
// deliberately omits the std modules whose symbols zenrt.c provides at the C level (`view`, `String`, …),
// so as a raw concatenation it references hundreds of "undefined" runtime names. So validation runs on
// the IMPORT-RESOLVED `driver.zen` entry (the same path `zenc check driver.zen` uses): that pulls in
// those std modules so the names ARE declared, dedups, and runs the full checker over the real program.
bs_emit_checked = (
    mp: MutPtr<Malloc>,
    root: string_view,
    out_path: string_view,
    flat: string_view,
    entry: string_view,
    esrc: string_view,
    shake: bool,
) i32 {
    rp := mp.resolve_prog(root, entry, esrc)
    (mp.report_no_if_resolved(rp, entry, esrc) == 0).match ({
        true  => {
            raw := mp.parse_module(rp.flat)
            decls := mp.resolve_module(raw)
            (mp.report_check(raw, decls, rp, entry, esrc) == 0).match ({
                true  => {
                    rawf := mp.parse_module(flat)
                    kept := shake.then({ mp.bs_shake(rawf) }, { rawf })
                    gen := mp.genModuleIn(mp.resolve_module(kept))    // type error in compiler source — fail, don't regenerate a miscompiled seed
                    gen.bytes().bs_eq_run(0, BS_HEAD().view(), 0).match ({
                        true  => bs_write(out_path, gen).then({ 0 }, { 1 }),
                        false => {
                            derr("zenc: --build-self: emitted C did not start with the expected head\n")
                            1
                        },
                    })
                },
                false => 1,
            })
        },
        false => 1,
    })
}
// ── --build-self tree-shake: emit only decls reachable from `main` ────────────────────────────────
// Reuses the `zen audit` reachability fixpoint (AudCtx + the aud_* walkers) over the manifest flat:
// the dual raw+resolved walk, the bare-method-name fanout (aud_mref) and the live-type -> impl-method
// fanout (aud_implms). Kept regardless of reachability (the audit's documented exemption classes, all
// in the keep direction): DRaw escapes, DImport records, DForeign prototypes, module-alias binds,
// `__`-prefixed decls, DImpl conformance records whose type is live (or a builtin receiver with no
// type decl to anchor), trait defaults of live traits, and the bare/alias twin of any live name (both
// copies come from the same source line). bs_close then re-walks every KEPT decl until the seen set
// stops growing, so the kept set is reference-closed: no emitted decl can reference a dropped one.
// `--build-self-full` bypasses the shake (the fat seed, every manifest decl).
bs_trait_live = (ac: MutPtr<AudCtx>, trname: string_view) bool {
    neg1: i64 := 0 - 1
    ac.ridx.get(trname, neg1) < 0 || ac.seen.has(trname)
}
// mark a kept-for-a-reason name live when the fixpoint alone did not reach it: `__`-synthesized
// decls, and the bare/alias twin of a live name (same source line, so it is emitted either way).
bs_root_twin = (ac: MutPtr<AudCtx>, tails: Map<i64>, nm: string_view) void {
    nta := nm.aud_tail_at()
    twin := tails.has(nm) || nta > 0 && ac.seen.has(cstr(offset(nm, nta)))
    (is_empty(nm) == false && (nm.starts_with("__") || twin)).then({
        ac.aud_ref(nm)
    })
}
// one closure sweep: walk every decl the emission filter keeps unconditionally, so their references
// join the live set (DForeign signature types, live-trait default bodies, alias binds, twins).
bs_root_kept = (ac: MutPtr<AudCtx>, tails: Map<i64>, d: Decl) void {
    d.match ({
        .DForeign(f)       => ac.aud_walk_sig(f),
        .DTraitDefault(td) => ac.bs_trait_live(td.trname).then({
            ac.aud_walk_fn(td.fn)
        }),
        .DImpl(im)         => { },
        .DGlobal(g)        => {
            g.alias.then({
                ac.aud_ref(g.name)
            })
            ac.bs_root_twin(tails, g.name)
        },
        _                  => ac.bs_root_twin(tails, d.aud_decl_name()),
    })
}
// `__`-tail set of the live names, rebuilt per sweep (aud_run's twin-suppression set, keep direction).
bs_tails = (ac: MutPtr<AudCtx>) Map<i64> {
    seedv: i64 := 0 - 1
    tails := of(ac.mp, "", seedv).expect("build-self: oom")
    ac.seen.keys().loop((h, i, k) {
        ta := k.aud_tail_at()
        (ta > 0).then({
            one: i64 := 1
            tails = tails.put(ac.mp, cstr(offset(k, ta)), one).expect("build-self: oom")
        })
    })
    tails
}
// iterate bs_root_kept sweeps to a fixpoint: newly-live names can make more types live, which keeps
// more impl blocks, whose methods reference more names — stop when the seen set stops growing.
bs_close = (ac: MutPtr<AudCtx>, raw: [Decl]) void {
    prev: i64 := 0 - 1
    @while (ac.seen.keys().len != prev) {
        prev = ac.seen.keys().len
        tails := ac.bs_tails()
        raw.loop((h, i, d) {
            ac.bs_root_kept(tails, d)
        })
    }
}
// the emission filter over the closed live set: which raw manifest decls reach the seed.
bs_keep = (ac: MutPtr<AudCtx>, d: Decl) bool {
    neg1: i64 := 0 - 1
    d.match ({
        .DImpl(im)         => ac.ridx.get(im.ty, neg1) < 0 || ac.seen.has(im.ty),
        .DTraitDefault(td) => ac.bs_trait_live(td.trname),
        .DForeign(f)       => true,
        _                  => {
            nm := d.aud_decl_name()
            is_empty(nm) || ac.seen.has(nm)
        },
    })
}
// reachability-filter the parsed manifest flat: root `main` (plus the `main(sys)` trampoline's `root`
// and every impl on a builtin receiver, exactly as `zen audit` roots), run the aud_* fixpoint over
// the raw AND resolved decls, close over the always-kept classes, then keep only what bs_keep passes.
// The kept subset is re-resolved by the caller, so mono instances, lowered closures and materialized
// trait defaults are re-synthesized for the surviving decls only.
bs_shake = (mp: MutPtr<Malloc>, raw: [Decl]) [Decl] {
    rdecls := mp.resolve_module(raw)
    t := mp.aud_tables(raw)
    seedv: i64 := 0 - 1
    c := AudCtx(
        mp: mp,
        decls: raw,
        rdecls: rdecls,
        ridx: mp.aud_index(raw),
        xidx: mp.aud_index(rdecls),
        seen: of(mp, "", seedv).expect("build-self: oom"),
        mseen: of(mp, "", seedv).expect("build-self: oom"),
        pairs: t.pairs,
        implms: t.implms,
    )
    ac := c.addr()
    ac.aud_ref("main")
    mi := c.ridx.get("main", 0 - 1)
    (mi >= 0).then({
        raw[mi].match ({
            .DFunc(f) => {
                (f.params.len > 0).then({
                    ac.aud_mref("root")
                })
            },
            _         => { },
        })
    })
    raw.loop((h, i, d) {
        d.match ({
            .DImpl(im) => {
                (c.ridx.get(im.ty, 0 - 1) < 0).then({
                    ac.aud_ref(im.trname)
                    im.methods.loop((h2, j, p) {
                        ac.aud_ref(mp.impl_cname_in(im.trname, im.ty, p.name))
                    })
                })
            },
            _          => { },
        })
    })
    ac.bs_close(raw)
    n := 0
    raw.loop((h, i, d) {
        ac.bs_keep(d).then({
            n = n + 1
        })
    })
    kept := cbuf<Decl>(mp, n)
    k := 0
    raw.loop((h, i, d) {
        ac.bs_keep(d).then({
            kept[k] = d
            k = k + 1
        })
    })
    kept
}
build_self = (mp: MutPtr<Malloc>, root: string_view, out_path: string_view, shake: bool) i32 {
    mpath := mp.bs_join(root, "bootstrap/sources.txt")
    contents_in(mp, mpath).match ({
        .Ok(man) => {
            mv := man.view()
            flat := mp.bs_walk_manifest(mp.gstr_string(256), root, mv, 0, mv.len, 0).gstr_finish(mp)
            entry := mp.bs_join(root, "driver.zen")
            contents_in(mp, entry).match ({
                .Ok(esrc) => mp.bs_emit_checked(root, out_path, flat, entry, esrc, shake),
                .Err(e)   => {
                    derr("zenc: --build-self: cannot open driver.zen for validation\n")
                    1
                },
            })
        },
        .Err(e)  => {
            derr("zenc: --build-self: cannot open bootstrap/sources.txt\n")
            1
        },
    })
}
// ── doc: a module's public decls + their leading doc comments (ported from driver.c doc_source) ───
ends_zen = (s: string_view) bool {
    v: [u8] := s.view()
    v.len >= 4
        && v[v.len - 4] == '.'
        && v[v.len - 3] == 'z'
        && v[v.len - 2] == 'e'
        && v[v.len - 1] == 'n'
}
is_name_start = (b: u8) bool { b >= 'A' && b <= 'Z' || b >= 'a' && b <= 'z' || b == '_' }
push_mod = (mp: MutPtr<Malloc>, s: String, v: [u8], i: i64) String {
    (i >= v.len).match ({
        true  => s,
        false => mp.push_mod(s.gstr_push(mp, (v[i] == '.').then({ '/' }, { v[i] })), v, i + 1),
    })
}
mod_path = (mp: MutPtr<Malloc>, root: string_view, mod: string_view) string_view {
    ends_zen(mod).match ({
        true  => mod,
        false => {
            rel := mp
                .push_mod(mp.gstr_string(128).gstr_append(mp, "src/"), mod.view(), 0)
                .gstr_append(mp, ".zen")
                .gstr_finish(mp)
            mp
                .gstr_string(256)
                .gstr_append(mp, root)
                .gstr_append(mp, "/")
                .gstr_append(mp, rel)
                .gstr_finish(mp)
        },
    })
}
doc_has_star = (v: [u8], i: i64, t: i64) bool {
    (i >= t).match ({
        true  => false,
        false => (v[i] == '*').match ({
            true  => true,
            false => (v[i] == '=' || v[i] == ':').then({ false }, { v.doc_has_star(i + 1, t) }),
        }),
    })
}
doc_is_pub = (v: [u8], p: i64, t: i64) bool {
    (p >= t).then({ false }, { is_name_start(v[p]) && v.doc_has_star(p, t) })
}
out_range = (v: [u8], p: i64, t: i64) i64 { out_bytes(slice(v.ptr.offset(p), t - p)).or(0) }
doc_line = (mp: MutPtr<Malloc>, v: [u8], p: i64, t: i64, docs: String) String {
    (t - p >= 2 && v[p] == '/' && v[p + 1] == '/').match ({
        true  => {
            s := (p + 2 < t && v[p + 2] == ' ').then({ p + 3 }, { p + 2 })
            dl := mp.bs_push_range(docs, v, s, t)
            dl.gstr_push(mp, '\n')
        },
        false => (p >= t).match ({
            true  => mp.gstr_string(256),
            false => doc_is_pub(v, p, t).match ({
                true  => {
                    out_bytes(docs.bytes())
                    v.out_range(p, t)
                    out("\n")
                    mp.gstr_string(256)
                },
                false => mp.gstr_string(256),
            }),
        }),
    })
}
doc_lines = (mp: MutPtr<Malloc>, v: [u8], p: i64, docs: String) i64 {
    (p >= v.len).match ({
        true  => 0,
        false => {
            e := v.bs_line_end(p, v.len)
            t := v.bs_trim_end(p, e)
            d2 := mp.doc_line(v, p, t, docs)
            mp.doc_lines(v, (e >= v.len).then({ v.len }, { e + 1 }), d2)
        },
    })
}
doc_cmd = (mp: MutPtr<Malloc>, root: string_view, modarg: string_view) i32 {
    (modarg == "").match ({
        true  => {
            derr("usage: zenc doc <std.mod|file.zen>\n")
            2
        },
        false => contents_in(mp, mp.mod_path(root, modarg)).match ({
            .Ok(src) => {
                out("# ")
                out(modarg)
                out("\n")
                mp.doc_lines(src.view(), 0, mp.gstr_string(256))
                0
            },
            .Err(e)  => {
                derr("zenc: doc: cannot open module\n")
                1
            },
        }),
    })
}
// ── THE formatter: the AST pretty-printer (compiler.pretty) with source comments woven back in. ──────
// (The old line-reindenter — fmt_source/fmt_lines/fmt_scan/fmt_indent — has been RETIRED: it only
//  reindented + trimmed, never reflowed multi-arm matches, and overflowed the stack on big files. The
//  AST pretty-printer below is now the single formatter behind `zenc fmt`.)
// Parse the file FAITHFULLY (parse_module keeps MethodCall — UFCS preserved `s.len()`, not flat `len(s)`),
// collect its comments into a positioned sidecar table, then pretty-print: 4-space indent, multi-arm
// `.match` split one arm per line with `=>` aligned + trailing comma, multi-field struct literals one
// field per line, short single-arm/single-expr bodies inline, and every comment kept in place. Comments
// stay OUT of the AST, so the formatted source resolves to byte-identical C (formatting is a no-op on the
// lowered tree). This is the engine behind BOTH `zenc fmt` (in-place / --check) and `fmt --stdout`.
//
// fmt parses the RAW (pre-flatten) source — module-alias lines and qualified types the post-flatten
// pipeline never feeds parse_module. Qualified types `ns.Type` now parse; a residual construct the
// faithful parser still can't represent plants a parse error, and a faithful printer must REFUSE a file
// it cannot round-trip rather than silently rewrite it — so on any parse/lex error we fail cleanly.
FmtResult*: {
    text: string_view,
    len: i64,
    ok: bool,
}    // ok=false => parse/lex error, text/len unused
fmt_render = (mp: MutPtr<Malloc>, src: string_view) FmtResult {
    set_faithful_lexeme(true)    // keep C-keyword identifiers RAW (float, if, …) for round-trip
    decls := mp.parse_module(src)    // faithful AST (keeps MethodCall)
    set_faithful_lexeme(false)
    (perr_get() || lerr_get()).match ({
        true  => FmtResult(
            text: "",
            len: 0,
            ok: false,
        ),
        false => {
            exps := exports_get()
            pretty_set_comments(src, mp.collect_comments(src))
            o := mp.pretty_module_in(decls, exps)
            FmtResult(
                text: o.gstr_finish(mp),
                len: o.len,
                ok: true,
            )
        },
    })
}
// Positioned refusal: render the parse/lex failure as a standard `zenc: <path>:<line>:<col>:
// error[parse]` diagnostic against the RAW source (fmt owns no ResolvedProgram — the raw source IS
// the user source, so diag_user_span maps the offset directly). A negative offset is the vbreak
// encoding (parse.fill_decls) — clamp to its absolute position for the caret.
fmt_parse_err = (mp: MutPtr<Malloc>, path: string_view, src: string_view) i32 {
    off := (perr_off_get() == 0).then({ lerr_off_get() }, { perr_off_get() })
    o := (off < 0).then({ 0 - off }, { off })
    sp := diag_user_span(src, src, o, 1)
    derr(mp.render_diagnostic(path, src, sp.line, sp.col, sp.end_col, "parse", "cannot format (syntax error — a faithful formatter refuses a file it cannot represent)", "fix the parse error first (`zenc check` reports the full diagnostic), then re-run fmt", 1))
    1
}
// THE single source of truth for "would apply rewrite this file?" — a file is dirty iff the formatted
// text differs from the source byte-for-byte. BOTH the `--check` and apply branches of `fmt_file` gate
// on this, so `fmt --check X` reports dirty iff `fmt X` would rewrite X — the two can never drift apart.
// The two length gates kill the strcmp/NUL blind spot: `src` is the file bytes (NUL-free) and `r.len` is
// the formatter's true byte count, so `strlen(src) != r.len` OR `strlen(r.text) != r.len` (an embedded
// NUL shortening the C string) both flag dirty; once all three lengths agree the content is NUL-free and
// equal-length, so `eq` (strcmp) then compares every one of the r.len bytes — a full byte-for-byte match.
fmt_dirty = (src: string_view, r: FmtResult) bool {
    sv := src.view()
    rv := r.text.view()
    (sv.len != r.len).match ({
        true  => true,
        false => (rv.len != r.len).match ({
            true  => true,
            false => (src == r.text).then({ false }, { true }),
        }),
    })
}
// `zenc fmt [--check] <file>`: format IN PLACE (or, with --check, exit 1 when the file is not already
// formatted, writing nothing). Idempotent — formatting an already-formatted file is a no-op.
fmt_file = (mp: MutPtr<Malloc>, path: string_view, check: bool) i32 {
    contents_in(mp, path).match ({
        .Ok(src) => {
            (mp.report_no_if_plain(path, src) == 0).match ({
                true  => {
                    r := mp.fmt_render(src)
                    r.ok.match ({
                        true  => fmt_dirty(src, r).match ({
                            true  => check.match ({
                                true  => {
                                    derr("zenc: ")
                                    derr(path)
                                    derr(": needs formatting\n")
                                    1
                                },
                                false => save(path, r.text, r.len).match ({
                                    .Ok(n)  => 0,
                                    .Err(e) => 1,
                                }),
                            }),
                            false => 0,
                        }),
                        false => mp.fmt_parse_err(path, src),
                    })
                },
                false => 1,
            })
        },
        .Err(e)  => {
            derr("zenc: fmt: cannot open input\n")
            1
        },
    })
}
// `zenc fmt --stdout <file>` (alias: --ast, kept for back-compat): write the formatted text to stdout.
fmt_stdout = (mp: MutPtr<Malloc>, path: string_view) i32 {
    contents_in(mp, path).match ({
        .Ok(src) => {
            (mp.report_no_if_plain(path, src) == 0).match ({
                true  => {
                    r := mp.fmt_render(src)
                    r.ok.match ({
                        true  => {
                            out(r.text)
                            0
                        },
                        false => mp.fmt_parse_err(path, src),
                    })
                },
                false => 1,
            })
        },
        .Err(e)  => {
            derr("zenc: fmt: cannot open input\n")
            1
        },
    })
}
// `zenc fmt [--check] <a.zen> <b.zen> …` processes EVERY file argument (argv[i]..argv[n-1]) — a
// trailing argument is never silently skipped (the old handler formatted only the first file and
// exited 0, so `fmt --check a.zen b.zen` could bless an unformatted b.zen). Each file goes through
// fmt_file, which names its own offender on stderr; the fold keeps the last nonzero per-file status,
// so the exit code is 0 iff EVERY file is clean (--check) / formatted successfully (apply).
fmt_files = (mp: MutPtr<Malloc>, i: i32, n: i32, check: bool, rc: i32) i32 {
    (i >= n).match ({
        true  => rc,
        false => {
            r := mp.fmt_file(arg(i), check)
            mp.fmt_files(i + 1, n, check, (r == 0).then({ rc }, { r }))
        },
    })
}
fmt_cmd = (mp: MutPtr<Malloc>, a2: string_view, a3: string_view) i32 {
    (a2 == "--ast" || a2 == "--stdout").match ({
        true  => (a3 == "").match ({
            true  => {
                derr("usage: zenc fmt --stdout <in.zen>\n")
                2
            },
            false => mp.fmt_stdout(a3),
        }),
        false => (a2 == "--check").match ({
            true  => (a3 == "").match ({
                true  => {
                    derr("usage: zenc fmt [--check] <in.zen>...\n")
                    2
                },
                false => mp.fmt_files(3, argc(), true, 0),
            }),
            false => (a2 == "").match ({
                true  => {
                    derr("usage: zenc fmt [--check] <in.zen>...\n")
                    2
                },
                false => mp.fmt_files(2, argc(), false, 0),
            }),
        }),
    })
}
// ── project bootstrap: `zenc init [path] [--bin|--lib]` ──────────────────────────────────
// The templates live in this driver, so a relocated standalone zenc does not need a templates
// directory beside it. Fully flagged invocations never touch stdin; missing values are prompted.
ZI_USAGE = () string_view { "usage: zenc init [path] [--bin|--lib]\n       zenc init --help\n" }
ZiInitArgs: {
    path: string_view,
    kind: i32,
    ok: bool,
    help: bool,
}
ZI_KIND_PROMPT := 0
ZI_KIND_EXECUTABLE := 1
ZI_KIND_LIBRARY := 2
zi_pick_kind = (have: i32, want: i32) i32 {
    (have == ZI_KIND_PROMPT || have == want).then({ want }, { 0 - 1 })
}
zi_init_args = (path: string_view, kind: i32, ok: bool, help: bool) ZiInitArgs {
    ZiInitArgs(
        path: path,
        kind: kind,
        ok: ok,
        help: help,
    )
}
zi_scan_args = (i: i32, n: i32, path: string_view, kind: i32, valid: bool) ZiInitArgs {
    (i >= n).then({
        return zi_init_args(path, kind, valid, false)
    })
    a := arg(i)
    (a == "--help").then({
        return zi_init_args(path, kind, true, true)
    })
    (a == "--bin" || a == "--exe").then({
        next := zi_pick_kind(kind, ZI_KIND_EXECUTABLE)
        return zi_scan_args(i + 1, n, path, next, valid && next > 0)
    })
    (a == "--lib").then({
        next := zi_pick_kind(kind, ZI_KIND_LIBRARY)
        return zi_scan_args(i + 1, n, path, next, valid && next > 0)
    })
    v: [u8] := a.view()
    (v.len > 0 && v[0] == '-').match ({
        true  => zi_init_args(path, kind, false, false),
        false => (path == "").match ({
            true  => zi_scan_args(i + 1, n, a, kind, valid),
            false => zi_init_args(path, kind, false, false),
        }),
    })
}
// One prompt line, without consuming the next prompt's input (read_stdin intentionally reads to EOF).
zi_read_line = (mp: MutPtr<Malloc>, prompt: string_view) string_view {
    derr(prompt)
    s := mp.gstr_string(64)
    cell: [u8] := [0]
    done := false
    @while (done == false) {
        n := read(0, cell.ptr, 1)
        done = n <= 0 || cell[0] == '\n'
        s = (n > 0 && cell[0] != '\n' && cell[0] != '\r').then({ s.gstr_push(mp, cell[0]) }, { s })
    }
    s.gstr_finish(mp)
}
zi_kind_choice = (s: string_view) i32 {
    (s == "" || s == "1" || s == "bin" || s == "exe" || s == "executable").match ({
        true  => ZI_KIND_EXECUTABLE,
        false => (s == "2" || s == "lib" || s == "library").then({ ZI_KIND_LIBRARY }, { 0 - 1 }),
    })
}
zi_prompt_kind = (mp: MutPtr<Malloc>) i32 {
    derr("Project type:\n  1) Executable\n  2) Library\n")
    zi_kind_choice(mp.zi_read_line("Select [1]: "))
}
// Names are embedded in TOML, a string literal, and the executable output path. Keep them portable
// and injection-free until the compiler's own cc command quotes arbitrary project paths.
zi_ascii_alnum = (b: u8) bool {
    b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z' || b >= '0' && b <= '9'
}
zi_name_tail = (v: [u8], i: i64) bool {
    (i >= v.len).match ({
        true  => true,
        false => (zi_ascii_alnum(v[i]) || v[i] == '_' || v[i] == '-').match ({
            true  => v.zi_name_tail(i + 1),
            false => false,
        }),
    })
}
zi_name_valid = (s: string_view) bool {
    v: [u8] := s.view()
    v.len > 0 && zi_ascii_alnum(v[0]) && v.zi_name_tail(1)
}
zi_path_char = (b: u8) bool { zi_ascii_alnum(b) || b == '_' || b == '-' || b == '.' || b == '/' }
zi_dot_segment = (v: [u8], start: i64, end: i64) bool {
    n := end - start
    n == 1 && v[start] == '.' || n == 2 && v[start] == '.' && v[start + 1] == '.'
}
zi_path_valid_at = (v: [u8], i: i64, start: i64) bool {
    (i >= v.len).match ({
        true  => v.zi_dot_segment(start, i) == false,
        false => (zi_path_char(v[i]) && (v[i] != '/' || i == 0 || v[i - 1] != '/')).match ({
            true  => (v[i] == '/').match ({
                true  => (v.zi_dot_segment(start, i) == false).match ({
                    true  => v.zi_path_valid_at(i + 1, i + 1),
                    false => false,
                }),
                false => v.zi_path_valid_at(i + 1, start),
            }),
            false => false,
        }),
    })
}
zi_path_valid = (s: string_view) bool { s.view().zi_path_valid_at(0, 0) }
zi_trim_end = (v: [u8], n: i64) i64 {
    (n > 0 && v[n - 1] == '/').then({ v.zi_trim_end(n - 1) }, { n })
}
zi_normal_path = (mp: MutPtr<Malloc>, raw: string_view) string_view {
    v: [u8] := raw.view()
    n := v.zi_trim_end(v.len)
    (n == v.len).then({ raw }, { mp.cstr_substr(raw, 0, to_i32(n)) })
}
zi_project_name = (mp: MutPtr<Malloc>, path: string_view) string_view {
    v: [u8] := path.view()
    slash := last_slash(v, 0, 0 - 1)
    start := slash + 1
    mp.cstr_substr(path, to_i32(start), to_i32(v.len - start))
}
zi_is_dir = (path: string_view) bool {
    d := opendir(path)
    (d == null_ptr()).match ({
        true  => false,
        false => {
            closedir(d)
            true
        },
    })
}
ZI_OPEN_NEW := O_WRONLY | O_CREAT | O_EXCL
ZiDirCreate: {
    ok: bool,
    created: bool,
}
// mkdir may lose a race after the existence probe. A directory now present is usable, but `created`
// stays false so rollback never removes something another process owns.
zi_ensure_dir = (path: string_view) ZiDirCreate {
    file_exists(path).match ({
        true  => ZiDirCreate(
            ok: zi_is_dir(path),
            created: false,
        ),
        false => (mkdir(path, MODE_755) == 0).match ({
            true  => ZiDirCreate(
                ok: true,
                created: true,
            ),
            false => ZiDirCreate(
                ok: zi_is_dir(path),
                created: false,
            ),
        }),
    })
}
zi_make_tree = (mp: MutPtr<Malloc>, path: string_view) ZiDirCreate {
    v: [u8] := path.view()
    i: i64 := 1
    ok := true
    @while (i < v.len && ok) {
        (v[i] == '/').then({
            prefix := mp.cstr_substr(path, 0, to_i32(i))
            ok = zi_ensure_dir(prefix).ok
        })
        i = i + 1
    }
    ok.match ({
        true  => zi_ensure_dir(path),
        false => ZiDirCreate(
            ok: false,
            created: false,
        ),
    })
}
zi_write_all = (fd: i32, p: RawPtr<u8>, n: i64) bool {
    (n <= 0).match ({
        true  => true,
        false => {
            wrote := write(fd, p, n)
            (wrote <= 0).then({ false }, { zi_write_all(fd, p.offset(wrote), n - wrote) })
        },
    })
}
// Exclusive creation is the no-clobber guarantee even if another process races the preflight.
zi_save_new = (path: string_view, data: string_view) bool {
    fd := open(path, ZI_OPEN_NEW, MODE_644)
    (fd < 0).match ({
        true  => false,
        false => {
            v: [u8] := data.view()
            wrote := zi_write_all(fd, v.ptr, v.len)
            shut := close(fd) == 0
            (wrote && shut).match ({
                true  => true,
                false => {
                    unlink(path)
                    false
                },
            })
        },
    })
}
zi_manifest = (mp: MutPtr<Malloc>, name: string_view, kind: i32) string_view {
    s := mp.gstr_string(160).gstr_append(mp, "package = \"").gstr_append(mp, name)
    (kind == ZI_KIND_LIBRARY).match ({
        true  => s
            .gstr_append(mp, "\"\nkind = \"library\"\nroot = \"src\"\nmain = \"lib.zen\"\n")
            .gstr_finish(mp),
        false => s
            .gstr_append(mp, "\"\nkind = \"executable\"\nroot = \"src\"\nmain = \"main.zen\"\nout = \"")
            .gstr_append(mp, name)
            .gstr_append(mp, "\"\n")
            .gstr_finish(mp),
    })
}
zi_source = (mp: MutPtr<Malloc>, name: string_view, kind: i32) string_view {
    (kind == ZI_KIND_LIBRARY).match ({
        true  => "answer* = () i32 { 42 }\n",
        false => mp
            .gstr_string(128)
            .gstr_append(mp, "{ println } = std.text.fmt\nmain = () i32 {\n    println(\"Hello from ")
            .gstr_append(mp, name)
            .gstr_append(mp, "!\")\n    0\n}\n")
            .gstr_finish(mp),
    })
}
zi_collision = (path: string_view) i32 {
    derr("zenc init: ")
    derr(path)
    derr(" already exists; nothing was changed\n")
    1
}
zi_remove_dir = (path: string_view) void { removed := rmdir(path) }
zi_cleanup_dirs = (
    srcdir: string_view,
    target: string_view,
    made_src: bool,
    made_target: bool,
) void {
    made_src.then(() { zi_remove_dir(srcdir) })
    made_target.then(() { zi_remove_dir(target) })
}
zi_create = (mp: MutPtr<Malloc>, target: string_view, name: string_view, kind: i32) i32 {
    manifest := mp.join2(target, "zen.toml")
    buildfile := mp.join2(target, "build.zen")
    srcdir := mp.join2(target, "src")
    entry := (kind == ZI_KIND_LIBRARY).then({ "lib.zen" }, { "main.zen" })
    source := mp.join2(srcdir, entry)
    target_exists := file_exists(target)
    (target_exists && zi_is_dir(target) == false).then({
        derr("zenc init: target exists and is not a directory: ")
        derr(target)
        derr("\n")
        return 1
    })
    file_exists(buildfile).then({
        return zi_collision(buildfile)
    })
    file_exists(manifest).then({
        return zi_collision(manifest)
    })
    (file_exists(srcdir) && zi_is_dir(srcdir) == false).then({
        return zi_collision(srcdir)
    })
    file_exists(source).then({
        return zi_collision(source)
    })
    target_dir := mp.zi_make_tree(target)
    (target_dir.ok == false).then({
        derr("zenc init: could not create project directory: ")
        derr(target)
        derr("\n")
        return 1
    })
    src_dir := zi_ensure_dir(srcdir)
    (src_dir.ok == false).then({
        derr("zenc init: could not create source directory: ")
        derr(srcdir)
        derr("\n")
        zi_cleanup_dirs(srcdir, target, false, target_dir.created)
        return 1
    })
    (zi_save_new(source, mp.zi_source(name, kind)) == false).then({
        derr("zenc init: could not create source file: ")
        derr(source)
        derr("\n")
        zi_cleanup_dirs(srcdir, target, src_dir.created, target_dir.created)
        return 1
    })
    (zi_save_new(manifest, mp.zi_manifest(name, kind)) == false).then({
        unlink(source)
        derr("zenc init: could not create manifest: ")
        derr(manifest)
        derr("\n")
        zi_cleanup_dirs(srcdir, target, src_dir.created, target_dir.created)
        return 1
    })
    derr("Created ")
    derr((kind == ZI_KIND_LIBRARY).then({ "library" }, { "executable" }))
    derr(" project `")
    derr(name)
    derr("` at ")
    derr(target)
    derr("\n")
    derr((kind == ZI_KIND_LIBRARY).match ({
        true  => "Check it with: zenc check ",
        false => "Run it with: zenc run ",
    }))
    derr(target)
    derr("\n")
    0
}
zi_cmd = (mp: MutPtr<Malloc>) i32 {
    parsed := zi_scan_args(2, argc(), "", ZI_KIND_PROMPT, true)
    parsed.help.then({
        say(ZI_USAGE())
        return 0
    })
    (parsed.ok == false).then({
        derr(ZI_USAGE())
        return 2
    })
    rawpath := (parsed.path == "").match ({
        true  => mp.zi_read_line("Project name or path: "),
        false => parsed.path,
    })
    path := mp.zi_normal_path(rawpath)
    (path == "" || zi_path_valid(path) == false).then({
        derr("zenc init: project path uses unsafe characters or a '.'/'..' component\n")
        return 2
    })
    name := mp.zi_project_name(path)
    (zi_name_valid(name) == false).then({
        derr("zenc init: project name must match [A-Za-z0-9][A-Za-z0-9_-]*\n")
        return 2
    })
    kind := (parsed.kind == ZI_KIND_PROMPT).then({ mp.zi_prompt_kind() }, { parsed.kind })
    (kind != ZI_KIND_EXECUTABLE && kind != ZI_KIND_LIBRARY).then({
        derr("zenc init: choose 1/executable or 2/library\n")
        return 2
    })
    mp.zi_create(path, name, kind)
}
// ── project mode: `zenc build|run|check <dir>` driven by <dir>/zen.toml ───────────────────────────
Spec*: {
    source: string_view,
    out: string_view,
    ccflags: string_view,
    links: string_view,
    ffi: string_view,
    genmods: string_view,
    target: string_view,
    library: bool,
    ok: bool,
}    // target: "" = native (host cc), else a cross triple like "aarch64-linux-gnu"
join2 = (mp: MutPtr<Malloc>, a: string_view, b: string_view) string_view {
    mp
        .gstr_string(256)
        .gstr_append(mp, a)
        .gstr_append(mp, "/")
        .gstr_append(mp, b)
        .gstr_finish(mp)
}
link_flag = (mp: MutPtr<Malloc>, lk: string_view) string_view {
    mp
        .gstr_string(8)
        .gstr_append(mp, "-l")
        .gstr_append(mp, lk)
        .gstr_finish(mp)
}
// src[start .. start+n) as an owned str. (named cstr_* to avoid colliding with std.text.str's
// generic `substr` once the modules are flattened together — a plain `substr` would emit a second
// C `substr` definition.)
cstr_substr = (mp: MutPtr<Malloc>, s: string_view, start: i32, n: i32) string_view {
    v: [u8] := s.view()
    mp.bs_push_range(mp.gstr_string(n + 1), v, start, start + n).gstr_finish(mp)
}
// a zen.toml `key = "value"` -> the value (or "" if absent), via the Zen manifest parser.
manifest_value = (mp: MutPtr<Malloc>, src: string_view, key: string_view) string_view {
    sp := manifest_value_span(src, to_i32(src.view().len), key, 0)
    (sp.start < 0).then({ "" }, { mp.cstr_substr(src, sp.start, sp.len) })
}
// read <dir>/zen.toml -> a project Spec (ok=false if absent or missing root/main).
proj_spec = (mp: MutPtr<Malloc>, dir: string_view) Spec {
    contents_in(mp, mp.join2(dir, "zen.toml")).match ({
        .Ok(src) => {
            root := mp.manifest_value(src, "root")
            main := mp.manifest_value(src, "main")
            kind := mp.manifest_value(src, "kind")
            kind_ok := kind == "" || kind == "executable" || kind == "library"
            (root == "" || main == "" || kind_ok == false).match ({
                true  => Spec(
                    source: "",
                    out: "",
                    ccflags: "",
                    links: "",
                    ffi: "",
                    genmods: "",
                    target: "",
                    library: false,
                    ok: false,
                ),
                false => {
                    out := mp.manifest_value(src, "out")
                    cc := mp.manifest_value(src, "ccflags")
                    lk := mp.manifest_value(src, "link")
                    fg := mp.manifest_value(src, "ffi")
                    Spec(
                        source: mp.join2(mp.join2(dir, root), main),
                        out: (out == "").then({ "" }, { mp.join2(dir, out) }),
                        ccflags: cc,
                        links: (lk == "").then({ "" }, { mp.link_flag(lk) }),
                        ffi: fg,
                        genmods: "",
                        target: "",
                        library: kind == "library",
                        ok: true,
                    )
                },
            })
        },
        .Err(e)  => Spec(
            source: "",
            out: "",
            ccflags: "",
            links: "",
            ffi: "",
            genmods: "",
            target: "",
            library: false,
            ok: false,
        ),
    })
}
// arg -> Spec: a directory with build.zen/zen.toml is a project; otherwise a single file (empty
// cc/links/out). A manifest that EXISTS but is malformed (missing root/main, won't compile) is a loud
// error (ok=false) — NOT a silent fall-through to treating the directory itself as a source file.
resolve_spec = (mp: MutPtr<Malloc>, root: string_view, arg: string_view) Spec {
    file_exists(mp.join2(arg, "build.zen")).match ({
        true  => mp.build_zen_spec(root, arg),
        false => file_exists(mp.join2(arg, "zen.toml")).match ({
            true  => {
                s := mp.proj_spec(arg)
                s.ok.match ({
                    true  => s,
                    false => {
                        derr("zenc: ")
                        derr(mp.join2(arg, "zen.toml"))
                        derr(": invalid manifest (need `root`/`main`; optional `kind` is executable or library)\n")
                        s
                    },
                })
            },
            false => Spec(
                source: arg,
                out: "",
                ccflags: "",
                links: "",
                ffi: "",
                genmods: "",
                target: "",
                library: false,
                ok: true,
            ),
        }),
    })
}    // a single .zen file
// ── build.zen mode: the build IS a Zen program. Append a main that prints its Target's spec, compile
// + run it (capturing stdout to a file), parse the 10-line records back (name/root/main/out/links/
// sources/os/arch/abi/ffi — see std.build's emit_target). Wins over zen.toml. ─────────────────────
BUILDBIN = (mp: MutPtr<Malloc>) string_view { mp.pid_path("/tmp/zenbuild_spec_", ".bin") }
SPECFILE = (mp: MutPtr<Malloc>) string_view { mp.pid_path("/tmp/zenbuild_spec_", ".txt") }
BUILD_TAIL = () string_view {
    "\nmain = () i32 { b := build_context()  build(b.addr())  b.emit_spec()  b.deinit()  0 }\n"
}
// the [start,end) of line `idx` (0-based) in v; field idx of the emitted spec.
line_start = (v: [u8], idx: i32, p: i64) i64 {
    (idx <= 0).match ({
        true  => p,
        false => (p >= v.len).then({ p }, { v.line_start(idx - 1, v.bs_line_end(p, v.len) + 1) }),
    })
}
spec_field = (mp: MutPtr<Malloc>, v: [u8], idx: i32) string_view {
    s := v.line_start(idx, 0)
    e := v.bs_line_end(s, v.len)
    mp.bs_push_range(mp.gstr_string(e - s + 1), v, s, e).gstr_finish(mp)
}
source_word_end = (v: [u8], i: i64) i64 {
    (i >= v.len || v[i] == ' ').then({ i }, { v.source_word_end(i + 1) })
}
source_words = (mp: MutPtr<Malloc>, dir: string_view, v: [u8], i: i64, out: String) String {
    (i >= v.len).match ({
        true  => out,
        false => (v[i] == ' ').match ({
            true  => mp.source_words(dir, v, i + 1, out),
            false => {
                e := v.source_word_end(i)
                // a `-`-prefixed word is a cc flag (Target.cflags / `-l` link input), passed
                // through verbatim; anything else names a project-relative extra .c source
                // (absolute paths also pass through).
                prefixed := (v[i] == '/' || v[i] == '-').match ({
                    true  => out,
                    false => out.gstr_append(mp, dir).gstr_append(mp, "/"),
                })
                next := mp.bs_push_range(prefixed, v, i, e).gstr_append(mp, " ")
                mp.source_words(dir, v, e, next)
            },
        }),
    })
}
source_flags = (mp: MutPtr<Malloc>, dir: string_view, src: string_view) string_view {
    mp.source_words(dir, src.view(), 0, mp.gstr_string(128)).gstr_finish(mp)
}
// ── the plan's platform fields (lines 7-9 of each 10-line record: os/arch/abi as the integer
// codes std.build's build_os_code/build_arch_code/build_abi_code print). A record whose codes
// match the HOST (std.build defaults every Target to host()) — or a legacy short plan with the
// lines absent — is a NATIVE build: Spec.target stays "" and the cc path is untouched. Anything
// else is a cross target, canonicalized to the `<arch>-<os>-<abi>` GNU config triple
// (aarch64-linux-gnu, riscv64-linux-musl, …) that names the conventional cross gcc. ─────────────
spec_code = (s: string_view) i32 {
    v: [u8] := s.view()
    (v.len <= 0).then({ 0 - 1 }, { to_i32(v[0] - '0') })
}    // one plan code line -> its integer (codes are single digits); absent line -> -1
cross_os_code = (o: Os) i32 {
    o.match ({
        .MacOS   => 1,
        .Linux   => 2,
        .Windows => 3,
        .FreeBSD => 4,
        _        => 0,
    })
}    // mirrors std.build's build_os_code
cross_arch_code = (a: Arch) i32 {
    a.match ({
        .Arm64   => 1,
        .X86_64  => 2,
        .RiscV64 => 3,
        .Wasm32  => 4,
        _        => 0,
    })
}    // mirrors std.build's build_arch_code
cross_abi_code = (b: Abi) i32 {
    b.match ({
        .Darwin => 1,
        .Gnu    => 2,
        .Musl   => 3,
        .Msvc   => 4,
        .Wasi   => 5,
        _       => 0,
    })
}    // mirrors std.build's build_abi_code
cross_os_name = (n: i32) string_view {
    (n == 1).match ({
        true  => "macos",
        false => (n == 2).match ({
            true  => "linux",
            false => (n == 3).match ({
                true  => "windows",
                false => (n == 4).then({ "freebsd" }, { "unknown" }),
            }),
        }),
    })
}
cross_arch_name = (n: i32) string_view {
    (n == 1).match ({
        true  => "aarch64",
        false => (n == 2).match ({
            true  => "x86_64",
            false => (n == 3).match ({
                true  => "riscv64",
                false => (n == 4).then({ "wasm32" }, { "unknown" }),
            }),
        }),
    })
}
cross_abi_name = (n: i32) string_view {
    (n == 1).match ({
        true  => "darwin",
        false => (n == 2).match ({
            true  => "gnu",
            false => (n == 3).match ({
                true  => "musl",
                false => (n == 4).match ({
                    true  => "msvc",
                    false => (n == 5).then({ "wasi" }, { "unknown" }),
                }),
            }),
        }),
    })
}
cross_triple = (mp: MutPtr<Malloc>, osc: i32, arc: i32, abc: i32) string_view {
    hp := host()
    absent := osc < 0 || arc < 0 || abc < 0
    is_host := osc == cross_os_code(hp.os)
        && arc == cross_arch_code(hp.arch)
        && abc == cross_abi_code(hp.abi)
    (absent || is_host).match ({
        true  => "",
        false => mp
            .gstr_string(32)
            .gstr_append(mp, cross_arch_name(arc))
            .gstr_append(mp, "-")
            .gstr_append(mp, cross_os_name(osc))
            .gstr_append(mp, "-")
            .gstr_append(mp, cross_abi_name(abc))
            .gstr_finish(mp),
    })
}
// v1 cross scope is LINUX cross-ARCH only: aarch64/x86_64/riscv64, gnu or musl. Cross-OS (macOS/
// Windows/FreeBSD) and wasm error loudly instead of producing garbage — bootstrap/zenrt.c is
// POSIX/glibc-shaped (sigaltstack, ucontext SP reads, pthread), and no conventional Linux-hosted
// cross toolchain exists for those targets.
cross_supported = (osc: i32, arc: i32, abc: i32) bool {
    osc == 2 && (arc == 1 || arc == 2 || arc == 3) && (abc == 2 || abc == 3)
}
parse_spec_at = (mp: MutPtr<Malloc>, dir: string_view, specsrc: string_view, index: i32) Spec {
    v: [u8] := specsrc.view()
    base := 1 + index * 10
    name := mp.spec_field(v, base)
    root := mp.spec_field(v, base + 1)
    main := mp.spec_field(v, base + 2)
    out := mp.spec_field(v, base + 3)
    link := mp.spec_field(v, base + 4)
    cc := mp.spec_field(v, base + 5)
    osc := spec_code(mp.spec_field(v, base + 6))
    arc := spec_code(mp.spec_field(v, base + 7))
    abc := spec_code(mp.spec_field(v, base + 8))
    fg := mp.spec_field(v, base + 9)
    tgt := mp.cross_triple(osc, arc, abc)
    (root == "" || main == "").match ({
        true  => {
            derr("zenc: build.zen: target is missing root/main\n")
            Spec(
                source: "",
                out: "",
                ccflags: "",
                links: "",
                ffi: "",
                genmods: "",
                target: "",
                library: false,
                ok: false,
            )
        },
        false => (tgt == "" == false && cross_supported(osc, arc, abc) == false).match ({
            true  => {
                derr("zenc: build.zen: cross target ")
                derr(tgt)
                derr(" is unsupported in v1 (Linux aarch64|x86_64|riscv64, gnu|musl only)\n")
                empty_spec()
            },
            false => Spec(
                source: mp.join2(mp.join2(dir, root), main),
                out: (out == "").match ({
                    true  => (name == "").then({ "" }, { mp.join2(dir, name) }),
                    false => mp.join2(dir, out),
                }),
                ccflags: mp.source_flags(dir, cc),
                links: link,
                ffi: fg,
                genmods: mp.genmods_extract(dir, specsrc, index),
                target: tgt,
                library: false,
                ok: true,
            ),
        }),
    })
}
empty_spec = () Spec {
    Spec(
        source: "",
        out: "",
        ccflags: "",
        links: "",
        ffi: "",
        genmods: "",
        target: "",
        library: false,
        ok: false,
    )
}
// ── c_library genmods: the plan's trailing section (see std.build's c_library block) ─────────────
// After the N×10 target lines the plan carries the use()-records: one count line `G`, then per
// record a header line `<target> <id> <lib> <K>` followed by exactly K lines of generated module
// source (line-count-prefixed framing — the body is opaque to the line-based transport). For the
// SELECTED target the driver writes each body to <projdir>/.zen/gen/<id>.zen (gitignored) and
// returns the resolver registry text (`<id> <path>` lines) for genmods_set — stamped beside the
// ffi grants, before probe AND resolve, so the cache walk and the module loader both see the
// generated file through the one canonical module_path.
GENSUB = () string_view { ".zen/gen" }
gmx_tok_end = (v: [u8], i: i64) i64 {
    (i >= v.len || v[i] == ' ' || v[i] == '\n').then({ i }, { v.gmx_tok_end(i + 1) })
}
gmx_skip_lines = (v: [u8], p: i64, k: i32) i64 {
    (k <= 0 || p >= v.len).then({ p }, { v.gmx_skip_lines(v.bs_line_end(p, v.len) + 1, k - 1) })
}
gmx_write = (
    mp: MutPtr<Malloc>,
    dir: string_view,
    id: string_view,
    body: string_view,
    blen: i64,
) string_view {
    mkdir(mp.join2(dir, ".zen"), MODE_755)
    gdir := mp.join2(dir, GENSUB())
    mkdir(gdir, MODE_755)
    gpath := mp
        .gstr_string(96)
        .gstr_append(mp, gdir)
        .gstr_append(mp, "/")
        .gstr_append(mp, id)
        .gstr_append(mp, ".zen")
        .gstr_finish(mp)
    save(gpath, body, blen).match ({
        .Ok(n)  => { },
        .Err(e) => derr("zenc: build.zen: cannot write generated module\n"),
    })
    gpath
}
genmods_from = (
    mp: MutPtr<Malloc>,
    dir: string_view,
    specsrc: string_view,
    tname: string_view,
    p: i64,
    left: i32,
    acc: String,
) string_view {
    v: [u8] := specsrc.view()
    (left <= 0 || p >= v.len).match ({
        true  => acc.gstr_finish(mp),
        false => {
            te := v.gmx_tok_end(p)
            ie := v.gmx_tok_end(te + 1)
            le := v.gmx_tok_end(ie + 1)
            ke := v.bs_line_end(le + 1, v.len)
            be := v.gmx_skip_lines(ke + 1, v.plan_nat(le + 1, ke, 0))
            nxt := (mp.cstr_substr(specsrc, to_i32(p), to_i32(te - p)) == tname).match ({
                true  => {
                    id := mp.cstr_substr(specsrc, to_i32(te + 1), to_i32(ie - te - 1))
                    body := mp.cstr_substr(specsrc, to_i32(ke + 1), to_i32(be - ke - 1))
                    acc
                        .gstr_append(mp, id)
                        .gstr_append(mp, " ")
                        .gstr_append(mp, mp.gmx_write(dir, id, body, be - ke - 1))
                        .gstr_push(mp, '\n')
                },
                false => acc,
            })
            mp.genmods_from(dir, specsrc, tname, be, left - 1, nxt)
        },
    })
}
genmods_extract = (
    mp: MutPtr<Malloc>,
    dir: string_view,
    specsrc: string_view,
    index: i32,
) string_view {
    v: [u8] := specsrc.view()
    gs := v.line_start(1 + specsrc.plan_count() * 10, 0)
    g := v.plan_nat(gs, v.bs_line_end(gs, v.len), 0)
    mp.genmods_from(dir, specsrc, mp.spec_field(v, 1 + index * 10), v.bs_line_end(gs, v.len) + 1, g, mp.gstr_string(64))
}
plan_nat = (v: [u8], i: i64, e: i64, n: i32) i32 {
    (i >= e).match ({
        true  => n,
        false => (v[i] >= '0' && v[i] <= '9').match ({
            true  => v.plan_nat(i + 1, e, n * 10 + to_i32(v[i] - '0')),
            false => n,
        }),
    })
}
plan_count = (specsrc: string_view) i32 {
    v := specsrc.view()
    v.plan_nat(0, v.bs_line_end(0, v.len), 0)
}
PlanSource*: {
    src: string_view,
    ok: bool,
}
build_zen_plan = (mp: MutPtr<Malloc>, root: string_view, dir: string_view) PlanSource {
    contents_in(mp, mp.join2(dir, "build.zen")).match ({
        .Ok(bsrc) => {
            es := mp.gstr_string(1024).gstr_append(mp, bsrc).gstr_append(mp, BUILD_TAIL())
            entry := es.gstr_finish(mp)
            epath := mp.join2(dir, ".zenbuild_entry.zen")
            save(epath, entry, es.len).match ({
                .Ok(n)  => { },
                .Err(e) => { },
            })
            bbin := mp.BUILDBIN()
            rc := mp.compile_to(root, epath, entry, bbin, "", "", "")    // the build program always runs on the HOST
            unlink(epath)    // don't leave the entry in the project dir
            (rc == 0).match ({
                true  => {
                    spf := mp.SPECFILE()
                    mp
                        .gstr_string(256)
                        .gstr_append(mp, bbin)
                        .gstr_append(mp, " > ")
                        .gstr_append(mp, spf)
                        .gstr_finish(mp)
                        .system()
                    sp := contents_in(mp, spf).match ({
                        .Ok(spec) => PlanSource(
                            src: spec,
                            ok: true,
                        ),
                        .Err(e)   => PlanSource(
                            src: "",
                            ok: false,
                        ),
                    })
                    unlink(bbin)
                    unlink(spf)
                    sp
                },
                false => {
                    derr("zenc: build.zen: the build program did not compile\n")
                    PlanSource(
                        src: "",
                        ok: false,
                    )
                },
            })
        },
        .Err(e)   => PlanSource(
            src: "",
            ok: false,
        ),
    })
}
plan_find_name = (mp: MutPtr<Malloc>, src: string_view, wanted: string_view, i: i32, n: i32) i32 {
    (i >= n).match ({
        true  => 0 - 1,
        false => (mp.spec_field(src.view(), 1 + i * 10) == wanted).match ({
            true  => i,
            false => mp.plan_find_name(src, wanted, i + 1, n),
        }),
    })
}
build_zen_spec = (mp: MutPtr<Malloc>, root: string_view, dir: string_view) Spec {
    p := mp.build_zen_plan(root, dir)
    (p.ok && p.src.plan_count() > 0).then({ mp.parse_spec_at(dir, p.src, 0) }, { empty_spec() })
}    // no build.zen -> try zen.toml
build_named_plan = (
    mp: MutPtr<Malloc>,
    root: string_view,
    dir: string_view,
    wanted: string_view,
) i32 {
    p := mp.build_zen_plan(root, dir)
    n := p.src.plan_count()
    i := mp.plan_find_name(p.src, wanted, 0, n)
    (p.ok && i >= 0).match ({
        true  => mp.build_spec(root, mp.parse_spec_at(dir, p.src, i), "", ""),
        false => {
            derr("zenc: build.zen: no target named `")
            derr(wanted)
            derr("`\n")
            1
        },
    })
}
build_plan_from = (
    mp: MutPtr<Malloc>,
    root: string_view,
    dir: string_view,
    src: string_view,
    i: i32,
    n: i32,
    failures: i32,
) i32 {
    (i >= n).match ({
        true  => failures,
        false => mp.build_plan_from(root, dir, src, i + 1, n, failures + mp.build_spec(root, mp.parse_spec_at(dir, src, i), "", "")),
    })
}
build_all_plan = (mp: MutPtr<Malloc>, root: string_view, dir: string_view) i32 {
    p := mp.build_zen_plan(root, dir)
    p.ok.then({ mp.build_plan_from(root, dir, p.src, 0, p.src.plan_count(), 0) }, { 1 })
}
list_plan_from = (mp: MutPtr<Malloc>, src: string_view, i: i32, n: i32) i32 {
    (i >= n).match ({
        true  => 0,
        false => {
            say(mp.spec_field(src.view(), 1 + i * 10))
            mp.list_plan_from(src, i + 1, n)
        },
    })
}
list_plan_targets = (mp: MutPtr<Malloc>, root: string_view, dir: string_view) i32 {
    p := mp.build_zen_plan(root, dir)
    p.ok.then({ mp.list_plan_from(p.src, 0, p.src.plan_count()) }, { 1 })
}
// ── `zenc lsp` — diagnostics-only Language Server over stdio (LSP Stage 1) ─────────────────────────
// A JSON-RPC 2.0 loop: read `Content-Length: N\r\n\r\n<N-byte JSON body>` frames from stdin, run the
// EXISTING check pipeline (resolve -> parse -> the diagnostic channels) on each opened/changed
// document, and PUSH `textDocument/publishDiagnostics`. This only ADDS a subcommand — no compiler
// internals change; it rides check_module_batch + the specialized channels the driver already uses.
// Full-sync per document: the text is checked standalone; its directory is derived from the
// `file://` URI so sibling/std imports resolve (an error INSIDE an imported module is pinned to the
// open file's head with the real location in the message). Stage 1 adds: didClose (clears
// diagnostics), MethodNotFound replies for unimplemented requests, byte->UTF-16 position conversion,
// and a Content-Length sanity ceiling. Conformance suite: tests/harness_lsp.zen. Hover needs plumbing
// the checker doesn't expose yet (an offset->node query + an exported type-render such as ty_name);
// until that exists the server deliberately declines it with -32601.
// PROTOCOL WRITES GO TO STDOUT (fd 1); every diagnostic/log the pipeline emits stays on stderr, so the
// JSON-RPC stream is never corrupted.
lout = (s: string_view) i64 {
    v := s.view()
    write(1, v.ptr, v.len)
}
// frame + write one JSON-RPC message: `Content-Length: <bytes>\r\n\r\n<body>`.
lsp_send = (mp: MutPtr<Malloc>, body: string_view) i64 {
    lout(mp
        .gstr_string(48)
        .gstr_append(mp, "Content-Length: ")
        .push_int(mp, body.view().len)
        .gstr_append(mp, "\r\n\r\n")
        .gstr_finish(mp))
    lout(body)
}
// ── JSON string EMISSION (own escaper; the task sanctions building output as strings) ─────────────
lsp_hexd = (n: i64) u8 {
    (n < 10).then({ ('0'.to_i64() + n).to_u8() }, { ('a'.to_i64() + n - 10).to_u8() })
}
push_uesc = (sb: String, mp: MutPtr<Malloc>, b: u8) String {
    bi := b.to_i64()
    sb
        .gstr_append(mp, "\\u00")
        .gstr_push(mp, lsp_hexd(bi >> 4 & 15))
        .gstr_push(mp, lsp_hexd(bi & 15))
}
// append `s` as a JSON string LITERAL (surrounding quotes + escaped) to the builder.
push_jstr = (sb: String, mp: MutPtr<Malloc>, s: string_view) String {
    cur := sb.gstr_push(mp, '"')
    v: [u8] := s.view()
    v.loop((h, i, b) {
        cur = (b == '"').match ({
            true  => cur.gstr_append(mp, "\\\""),
            false => (b == '\\').match ({
                true  => cur.gstr_append(mp, "\\\\"),
                false => (b == '\n').match ({
                    true  => cur.gstr_append(mp, "\\n"),
                    false => (b == '\r').match ({
                        true  => cur.gstr_append(mp, "\\r"),
                        false => (b == '\t').match ({
                            true  => cur.gstr_append(mp, "\\t"),
                            false => (b < 32).match ({
                                true  => cur.push_uesc(mp, b),
                                false => cur.gstr_push(mp, b),
                            }),
                        }),
                    }),
                }),
            }),
        })
    })
    cur.gstr_push(mp, '"')
}
// ── incoming JSON extraction (hand-rolled; std.json's `parse`/`get` collide with the compiler's own
// flat `parse`/`get` names once this closure imports compiler.parse, so a targeted scanner is used).
// The scanner walks left-to-right skipping over complete JSON strings, so a `"key":` byte-pattern that
// happens to sit INSIDE a string value (e.g. the document source text) is never mistaken for a key.
// String scanning/decoding is ITERATIVE (`@while`) so a megabyte document never recurses the C stack.
// index just past the closing quote of the string opening at v[i]=='"' (respecting `\` escapes).
json_str_end = (v: [u8], i: i64) i64 {
    j := i + 1
    done: i64 := 0 - 1
    @while (done < 0 && j < v.len) {
        b := v[j]
        (b == '\\').match ({
            true  => {
                j = j + 2
            },
            false => (b == '"').match ({
                true  => {
                    done = j + 1
                },
                false => {
                    j = j + 1
                },
            }),
        })
    }
    (done < 0).then({ v.len }, { done })
}
json_skip_ws = (v: [u8], p: i64) i64 {
    q := p
    @while (q < v.len && (v[q] == ' ' || v[q] == '\t' || v[q] == '\n' || v[q] == '\r')) {
        q = q + 1
    }
    q
}
json_range_eq = (v: [u8], start: i64, kv: [u8], k: i64) bool {
    (k >= kv.len).match ({
        true  => true,
        false => (v[start + k] == kv[k]).then({ v.json_range_eq(start, kv, k + 1) }, { false }),
    })
}
json_str_eq_range = (v: [u8], start: i64, end: i64, kv: [u8]) bool {
    (end - start != kv.len).then({ false }, { v.json_range_eq(start, kv, 0) })
}
// the byte offset of the VALUE for the first object key named `key`, or -1. Strings are consumed whole,
// so key matches inside a value never fire and nesting is transparent.
json_find_key = (v: [u8], key: string_view) i64 {
    kv: [u8] := key.view()
    i: i64 := 0
    result: i64 := 0 - 1
    stop := false
    @while (stop == false && i < v.len) {
        (v[i] == '"').match ({
            true  => {
                se := v.json_str_end(i)
                cs := v.json_skip_ws(se)
                (cs < v.len && v[cs] == ':').match ({
                    true  => v.json_str_eq_range(i + 1, se - 1, kv).match ({
                        true  => {
                            result = v.json_skip_ws(cs + 1)
                            stop = true
                        },
                        false => {
                            i = se
                        },
                    }),
                    false => {
                        i = se
                    },
                })
            },
            false => {
                i = i + 1
            },
        })
    }
    result
}
json_hexq = (v: [u8], at: i64) i64 {
    (at + 3 >= v.len).match ({
        true  => 0 - 1,
        false => {
            h0 := hexval(v[at])
            h1 := hexval(v[at + 1])
            h2 := hexval(v[at + 2])
            h3 := hexval(v[at + 3])
            (h0 < 0 || h1 < 0 || h2 < 0 || h3 < 0).match ({
                true  => 0 - 1,
                false => h0 * 4096 + h1 * 256 + h2 * 16 + h3,
            })
        },
    })
}
hexval = (b: u8) i64 {
    (b >= '0' && b <= '9').match ({
        true  => to_i64(b - '0'),
        false => (b >= 'a' && b <= 'f').match ({
            true  => to_i64(b - 'a') + 10,
            false => (b >= 'A' && b <= 'F').then({ to_i64(b - 'A') + 10 }, { 0 - 1 }),
        }),
    })
}
// UTF-8 encode a BMP code point into the builder (1–3 bytes).
push_utf8 = (sb: String, mp: MutPtr<Malloc>, cp: i64) String {
    (cp < 128).match ({
        true  => sb.gstr_push(mp, cp.to_u8()),
        false => (cp < 2048).match ({
            true  => sb
                .gstr_push(mp, (192 | cp >> 6).to_u8())
                .gstr_push(mp, (128 | cp & 63).to_u8()),
            false => sb
                .gstr_push(mp, (224 | cp >> 12).to_u8())
                .gstr_push(mp, (128 | cp >> 6 & 63).to_u8())
                .gstr_push(mp, (128 | cp & 63).to_u8()),
        }),
    })
}
// decode the JSON string opening at v[i]=='"' into an allocator-owned view (escapes resolved).
json_decode_str = (mp: MutPtr<Malloc>, v: [u8], i: i64) string_view {
    sb := mp.gstr_string(v.len - i + 1)
    j := i + 1
    stop := false
    @while (stop == false && j < v.len) {
        b := v[j]
        (b == '"').match ({
            true  => {
                stop = true
            },
            false => (b == '\\' && j + 1 < v.len).match ({
                true  => {
                    e := v[j + 1]
                    (e == 'n').match ({
                        true  => {
                            sb = sb.gstr_push(mp, '\n')
                            j = j + 2
                        },
                        false => (e == 't').match ({
                            true  => {
                                sb = sb.gstr_push(mp, '\t')
                                j = j + 2
                            },
                            false => (e == 'r').match ({
                                true  => {
                                    sb = sb.gstr_push(mp, '\r')
                                    j = j + 2
                                },
                                false => (e == 'b').match ({
                                    true  => {
                                        sb = sb.gstr_push(mp, 8.to_u8())
                                        j = j + 2
                                    },
                                    false => (e == 'f').match ({
                                        true  => {
                                            sb = sb.gstr_push(mp, 12.to_u8())
                                            j = j + 2
                                        },
                                        false => (e == 'u').match ({
                                            true  => {
                                                cp := v.json_hexq(j + 2)
                                                (cp < 0).match ({
                                                    true  => {
                                                        sb = sb.gstr_push(mp, e)
                                                        j = j + 2
                                                    },
                                                    false => {
                                                        sb = sb.push_utf8(mp, cp)
                                                        j = j + 6
                                                    },
                                                })
                                            },
                                            false => {
                                                sb = sb.gstr_push(mp, e)
                                                j = j + 2
                                            },
                                        }),
                                    }),
                                }),
                            }),
                        }),
                    })
                },
                false => {
                    sb = sb.gstr_push(mp, b)
                    j = j + 1
                },
            }),
        })
    }
    sb.gstr_finish(mp)
}
// raw bytes of the value at v[i]: a quoted string (incl. quotes) or a bare token up to `,`/`}`/`]`/ws.
json_raw_at = (mp: MutPtr<Malloc>, v: [u8], i: i64) string_view {
    (i >= v.len).match ({
        true  => "null",
        false => (v[i] == '"').match ({
            true  => mp.json_slice(v, i, v.json_str_end(i)),
            false => {
                e := i
                stop := false
                @while (stop == false && e < v.len) {
                    b := v[e]
                    (b == ','
                        || b == '}'
                        || b == ']'
                        || b == ' '
                        || b == '\t'
                        || b == '\n'
                        || b == '\r').match ({
                        true  => {
                            stop = true
                        },
                        false => {
                            e = e + 1
                        },
                    })
                }
                mp.json_slice(v, i, e)
            },
        }),
    })
}
json_slice = (mp: MutPtr<Malloc>, v: [u8], start: i64, end: i64) string_view {
    sb := mp.gstr_string(end - start + 1)
    j := start
    @while (j < end) {
        sb = sb.gstr_push(mp, v[j])
        j = j + 1
    }
    sb.gstr_finish(mp)
}
// the decoded string value of the first key `key`, or "" if absent / non-string.
json_str_field = (mp: MutPtr<Malloc>, body: string_view, key: string_view) string_view {
    v: [u8] := body.view()
    p := v.json_find_key(key)
    (p < 0 || p >= v.len).match ({
        true  => "",
        false => (v[p] == '"').then({ mp.json_decode_str(v, p) }, { "" }),
    })
}
// the request id as a raw JSON fragment (number or quoted string), echoed verbatim into the reply.
lsp_id = (mp: MutPtr<Malloc>, body: string_view) string_view {
    v: [u8] := body.view()
    p := v.json_find_key("id")
    (p < 0).then({ "null" }, { mp.json_raw_at(v, p) })
}
// ── URI -> filesystem path (strip a leading `file://`; percent-decoding is a later refinement) ─────
lsp_has_prefix = (s: string_view, pre: string_view) bool {
    sv: [u8] := s.view()
    pv: [u8] := pre.view()
    (sv.len < pv.len).then({ false }, { lsp_prefix_bytes(sv, pv, 0) })
}
lsp_prefix_bytes = (sv: [u8], pv: [u8], i: i64) bool {
    (i >= pv.len).match ({
        true  => true,
        false => (sv[i] == pv[i]).then({ sv.lsp_prefix_bytes(pv, i + 1) }, { false }),
    })
}
lsp_uri_path = (mp: MutPtr<Malloc>, uri: string_view) string_view {
    uri.lsp_has_prefix("file://").match ({
        true  => mp.cstr_substr(uri, 7, to_i32(uri.view().len - 7)),
        false => uri,
    })
}
// ── DiagSpan (1-based line/col, 1-based-inclusive end_col) -> LSP 0-based range ────────────────────
// LSP is 0-based: line -> line-1, start.character -> col-1. end_col is the 1-based inclusive last
// column, numerically the 0-based EXCLUSIVE end — so end.character = end_col (never a further -1). An
// unlocated span (line 0) is pinned to the file start with a 1-char range so the squiggle is visible.
ZSpan: {
    l: i64,
    c: i64,
    e: i64,
}
lsp_end_char = (sp: DiagSpan) i64 {
    ec := to_i64(sp.end_col)
    cc := to_i64(sp.col - 1)
    (ec > cc).then({ ec }, { cc + 1 })
}
lsp_zero_span = (sp: DiagSpan) ZSpan {
    (sp.line > 0).match ({
        true  => ZSpan(
            l: to_i64(sp.line - 1),
            c: (sp.col > 0).then({ to_i64(sp.col - 1) }, { 0 }),
            e: sp.lsp_end_char(),
        ),
        false => ZSpan(
            l: 0,
            c: 0,
            e: 1,
        ),
    })
}
// ── byte columns -> UTF-16 columns (LSP `character` counts UTF-16 CODE UNITS, not bytes) ──────────
// zenc spans are byte columns into the source line; a client fed byte columns misplaces squiggles on
// any line with non-ASCII bytes before the error. Conversion walks the located line once: every
// non-continuation byte counts 1 unit, and a 4-byte UTF-8 lead (>= 0xF0, a supplementary-plane char)
// counts 2 (its UTF-16 surrogate pair).
lsp_line_start = (v: [u8], ln: i64) i64 {
    i: i64 := 0
    k: i64 := 0
    @while (k < ln && i < v.len) {
        (v[i] == '\n').then({
            k = k + 1
        })
        i = i + 1
    }
    i
}
lsp_utf16_col = (v: [u8], ls: i64, bytecol: i64) i64 {
    u: i64 := 0
    i := ls
    end := ls + bytecol
    @while (i < v.len && i < end && v[i] != '\n') {
        bi := v[i].to_i64()
        (bi & 192 != 128).then({
            u = u + (bi >= 240).then({ 2 }, { 1 })
        })
        i = i + 1
    }
    u
}
// ── one diagnostic -> one LSP Diagnostic object, accumulated (comma-separated) into the array ──────
DiagAcc: {
    sb: String,
    n: i32,
}
lsp_push_diag = (
    mp: MutPtr<Malloc>,
    acc: DiagAcc,
    rp: ResolvedProgram,
    raw: [Decl],
    decls: [Decl],
    path: string_view,
    user: string_view,
    cd: CheckDiagnostic,
) DiagAcc {
    (cd.code == 0).match ({
        true  => acc,
        false => {
            dl := rp.locate_diag(cd.source_offset, cd.span_width, path, user)
            z := lsp_zero_span(dl.sp)
            // byte -> UTF-16 columns against the line the span actually points into (dl.src is the
            // owning module's source; for the open document it IS the client's text).
            sv: [u8] := dl.src.view()
            ls := sv.lsp_line_start(z.l)
            zc := sv.lsp_utf16_col(ls, z.c)
            ze := sv.lsp_utf16_col(ls, z.e)
            ze = (ze > zc).then({ ze }, { zc + 1 })
            // enrich exactly like the CLI (emit_one): denriched message + world-teaching undefined-name hint.
            msg := desc_or(mp.denrich_check(raw, decls, cd.source_offset, cd.code, cd.kind), cd.message)
            hint := cd.hint
            (cd.kind == "undefined-name").then({
                wh := mp.undefined_name_hint(rp.table, rp.flat, cd.source_offset)
                (is_empty(wh) == false).then({
                    hint = wh
                })
            })
            full := is_empty(hint).match ({
                true  => msg,
                false => mp
                    .gstr_string(128)
                    .gstr_append(mp, msg)
                    .gstr_append(mp, " — ")
                    .gstr_append(mp, hint)
                    .gstr_finish(mp),
            })
            // an error living in an IMPORTED module (dl.path != the open document) must not squiggle
            // an unrelated range of the open file: pin it to the file head and name the real location
            // in the message, so the information survives without a lying range.
            line: i64 := z.l
            (dl.path == path).match ({
                true  => 0,
                false => {
                    line = 0
                    zc = 0
                    ze = 1
                    full = mp
                        .gstr_string(128)
                        .gstr_append(mp, "in imported module ")
                        .gstr_append(mp, dl.path)
                        .gstr_append(mp, ":")
                        .push_int(mp, to_i64(dl.sp.line))
                        .gstr_append(mp, ": ")
                        .gstr_append(mp, full)
                        .gstr_finish(mp)
                    0
                },
            })
            sep := (acc.n > 0).then({ "," }, { "" })
            sb2 := acc.sb
                .gstr_append(mp, sep)
                .gstr_append(mp, "{\"range\":{\"start\":{\"line\":")
                .push_int(mp, line)
                .gstr_append(mp, ",\"character\":")
                .push_int(mp, zc)
                .gstr_append(mp, "},\"end\":{\"line\":")
                .push_int(mp, line)
                .gstr_append(mp, ",\"character\":")
                .push_int(mp, ze)
                .gstr_append(mp, "}},\"severity\":1,\"code\":")
                .push_jstr(mp, cd.kind)
                .gstr_append(mp, ",\"source\":\"zen\",\"message\":")
                .push_jstr(mp, full)
                .gstr_append(mp, "}")
            DiagAcc(
                sb: sb2,
                n: acc.n + 1,
            )
        },
    })
}
// run the pipeline on `text` and PUBLISH. Structural blockers (no-if, parse) are reported ALONE —
// their flat sentinels would otherwise spray bogus type errors. Otherwise every specialized semantic
// channel (reserved/ownership/escape/leak/…/mustuse) contributes its diagnostic AND the whole main
// batch (names/types/arity/exhaustiveness/…) is collected, so an ownership error shows alongside type
// errors rather than one channel hiding the rest. Empty array => clears old squiggles.
lsp_diags_array = (
    mp: MutPtr<Malloc>,
    root: string_view,
    path: string_view,
    text: string_view,
) string_view {
    rp := mp.resolve_prog(root, path, text)
    raw := mp.parse_module(rp.flat)
    decls := mp.resolve_module(raw)
    nif := check_module_no_if_diagnostic_from_source(rp.flat).cd_or(check_module_no_ternary_diagnostic_from_source(rp.flat))
    pars := mp.check_module_parse_diagnostic_from_source(decls, rp.flat)
    acc := DiagAcc(
        sb: mp.gstr_string(256),
        n: 0,
    )
    done := (nif.code != 0).match ({
        true  => mp.lsp_push_diag(acc, rp, raw, decls, path, text, nif),
        false => (pars.code != 0).match ({
            true  => mp.lsp_push_diag(acc, rp, raw, decls, path, text, pars),
            false => {
                a := acc
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_reserved_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_ownership_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_escape_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_leak_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_addr_escape_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_send_rc_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_scratch_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_send_mut_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_bound_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_arg_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_or_return_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_unknown_type_diagnostic_from_source(decls, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_ffi_diagnostic_from_source(decls, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, check_module_infinite_type_diagnostic_from_source(decls, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, check_module_main_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_mustuse_diagnostic_from_source(raw, rp.flat))
                ds := mp.check_module_batch_vis(decls, rp.flat, mp.ufcs_vis_of(rp.flat, rp.regions, rp.table))
                ds.loop((h, i, cd) {
                    a = mp.lsp_push_diag(a, rp, raw, decls, path, text, cd)
                })
                a
            },
        }),
    })
    done.sb.gstr_finish(mp)
}
lsp_publish = (mp: MutPtr<Malloc>, root: string_view, uri: string_view, text: string_view) i64 {
    arr := mp.lsp_diags_array(root, mp.lsp_uri_path(uri), text)
    mp.lsp_send(mp
        .gstr_string(512)
        .gstr_append(mp, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":")
        .push_jstr(mp, uri)
        .gstr_append(mp, ",\"diagnostics\":[")
        .gstr_append(mp, arr)
        .gstr_append(mp, "]}}")
        .gstr_finish(mp))
}
// ── request/notification handlers ─────────────────────────────────────────────────────────────────
lsp_reply_initialize = (mp: MutPtr<Malloc>, body: string_view) i64 {
    mp.lsp_send(mp
        .gstr_string(256)
        .gstr_append(mp, "{\"jsonrpc\":\"2.0\",\"id\":")
        .gstr_append(mp, mp.lsp_id(body))
        .gstr_append(mp, ",\"result\":{\"capabilities\":{\"textDocumentSync\":1},\"serverInfo\":{\"name\":\"zenc-lsp\",\"version\":\"0.2.0-dev\"}}}")
        .gstr_finish(mp))
}
lsp_reply_null = (mp: MutPtr<Malloc>, body: string_view) i64 {
    mp.lsp_send(mp
        .gstr_string(96)
        .gstr_append(mp, "{\"jsonrpc\":\"2.0\",\"id\":")
        .gstr_append(mp, mp.lsp_id(body))
        .gstr_append(mp, ",\"result\":null}")
        .gstr_finish(mp))
}
// JSON-RPC MethodNotFound for a REQUEST we don't implement. A request left unanswered stalls the
// client (nvim blocks a hover round-trip until its timeout); the error reply fails it instantly.
lsp_reply_method_not_found = (mp: MutPtr<Malloc>, body: string_view) i64 {
    mp.lsp_send(mp
        .gstr_string(128)
        .gstr_append(mp, "{\"jsonrpc\":\"2.0\",\"id\":")
        .gstr_append(mp, mp.lsp_id(body))
        .gstr_append(mp, ",\"error\":{\"code\":-32601,\"message\":\"method not found\"}}")
        .gstr_finish(mp))
}
// notification families we deliberately swallow WITHOUT a reply (replying to a notification is a
// protocol violation). `id` presence alone is not the test: e.g. workspace/didChangeConfiguration
// params may contain an unrelated "id" key that the flat key scanner would find.
lsp_is_notification = (method: string_view) bool {
    method.lsp_has_prefix("$/")
        || method.lsp_has_prefix("textDocument/did")
        || method.lsp_has_prefix("workspace/did")
        || method == "initialized"
        || method == "exit"
}
// publish an EMPTY diagnostics array for `uri` (didClose: the client keeps stale squiggles otherwise).
lsp_publish_clear = (mp: MutPtr<Malloc>, uri: string_view) i64 {
    mp.lsp_send(mp
        .gstr_string(160)
        .gstr_append(mp, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":")
        .push_jstr(mp, uri)
        .gstr_append(mp, ",\"diagnostics\":[]}}")
        .gstr_finish(mp))
}
// didOpen/didChange (full-sync) both carry the whole document text; the first `text` key is the
// document content (the URI's `text` in didOpen, the single contentChange's `text` in didChange).
lsp_did_change = (mp: MutPtr<Malloc>, root: string_view, body: string_view) i64 {
    mp.lsp_publish(root, mp.json_str_field(body, "uri"), mp.json_str_field(body, "text"))
}
// dispatch one message. Returns 0 = keep serving, 1 = shutdown received, 2 = exit. Unknown
// NOTIFICATIONS are no-ops; an unknown REQUEST (an "id" key outside the notification families) gets
// a MethodNotFound error so the client never waits on a reply that will not come.
lsp_handle = (mp: MutPtr<Malloc>, root: string_view, body: string_view) i32 {
    method := mp.json_str_field(body, "method")
    (method == "initialize").match ({
        true  => {
            mp.lsp_reply_initialize(body)
            0
        },
        false => (method == "shutdown").match ({
            true  => {
                mp.lsp_reply_null(body)
                1
            },
            false => (method == "exit").match ({
                true  => 2,
                false => (method == "textDocument/didOpen" || method == "textDocument/didChange").match ({
                    true  => {
                        mp.lsp_did_change(root, body)
                        0
                    },
                    false => (method == "textDocument/didClose").match ({
                        true  => {
                            mp.lsp_publish_clear(mp.json_str_field(body, "uri"))
                            0
                        },
                        false => {
                            v: [u8] := body.view()
                            (v.json_find_key("id") >= 0 && lsp_is_notification(method) == false).then({
                                mp.lsp_reply_method_not_found(body)
                            })
                            0
                        },
                    }),
                }),
            }),
        }),
    })
}
// ── stdio framing: read `Content-Length: N\r\n\r\n` headers, then exactly N body bytes ─────────────
LSP_HDR_CAP = () i64 { 1024 }
// sanity ceiling on a claimed body size (64 MiB). A hostile/corrupt `Content-Length: 100000000000000`
// would otherwise reach acquire(), fail, and null-deref-panic the server; over-limit frames are
// skipped like unparseable ones and the header scan resynchronizes on the next frame.
LSP_BODY_MAX = () i64 { 67108864 }
// read stdin one byte at a time into `buf` until the CRLFCRLF terminator (so we never over-read into
// the body). Returns the header length incl. terminator; 0 on clean EOF before any byte; -1 on error.
lsp_read_headers = (mp: MutPtr<Malloc>, buf: RawPtr<u8>, off: i64) i64 {
    r := read(0, buf.offset(off), 1)
    (r <= 0).match ({
        true  => (off == 0).then({ 0 }, { 0 - 1 }),
        false => (off >= 3
            && load(buf.offset(off - 3)) == '\r'
            && load(buf.offset(off - 2)) == '\n'
            && load(buf.offset(off - 1)) == '\r'
            && load(buf.offset(off)) == '\n').match ({
            true  => off + 1,
            false => (off + 1 >= LSP_HDR_CAP()).match ({
                true  => 0 - 1,
                false => mp.lsp_read_headers(buf, off + 1),
            }),
        }),
    })
}
lsp_match_bytes = (buf: RawPtr<u8>, i: i64, wv: [u8], k: i64) bool {
    (k >= wv.len).match ({
        true  => true,
        false => (load(buf.offset(i + k)) == wv[k]).match ({
            true  => buf.lsp_match_bytes(i, wv, k + 1),
            false => false,
        }),
    })
}
lsp_match_at = (buf: RawPtr<u8>, i: i64, len: i64, word: string_view) bool {
    wv: [u8] := word.view()
    (i + wv.len > len).then({ false }, { buf.lsp_match_bytes(i, wv, 0) })
}
// read a decimal starting at `i` (skipping leading spaces); -1 if no digit before end/non-space.
lsp_read_dec = (buf: RawPtr<u8>, i: i64, len: i64, acc: i64, started: bool) i64 {
    (i >= len).match ({
        true  => started.then({ acc }, { 0 - 1 }),
        false => {
            b := load(buf.offset(i))
            (b >= '0' && b <= '9').match ({
                true  => buf.lsp_read_dec(i + 1, len, acc * 10 + (b - '0').to_i64(), true),
                false => (b == ' ' && started == false).match ({
                    true  => buf.lsp_read_dec(i + 1, len, acc, false),
                    false => started.then({ acc }, { 0 - 1 }),
                }),
            })
        },
    })
}
lsp_content_length = (buf: RawPtr<u8>, i: i64, len: i64) i64 {
    (i >= len).match ({
        true  => 0 - 1,
        false => buf.lsp_match_at(i, len, "Content-Length:").match ({
            true  => buf.lsp_read_dec(i + 15, len, 0, false),
            false => buf.lsp_content_length(i + 1, len),
        }),
    })
}
// read exactly `n` body bytes into `buf` (read() may return short; loop until filled or EOF).
lsp_read_body = (buf: RawPtr<u8>, off: i64, n: i64) i64 {
    (off >= n).match ({
        true  => off,
        false => {
            r := read(0, buf.offset(off), n - off)
            (r <= 0).then({ off }, { buf.lsp_read_body(off + r, n) })
        },
    })
}
// the JSON-RPC stdio loop: frame -> dispatch, until `exit`. Exit code follows the LSP convention:
// 0 if `exit` arrived after `shutdown`, else 1 (also 1 if the stream closes without a clean shutdown).
lsp_cmd = (mp: MutPtr<Malloc>, root: string_view) i32 {
    hbuf := mp.acquire(LSP_HDR_CAP())
    running := true
    shut := false
    code := 1
    @while (running) {
        hlen := mp.lsp_read_headers(hbuf, 0)
        (hlen <= 0).match ({
            true  => {
                running = false
                code = shut.then({ 0 }, { 1 })
            },
            false => {
                n := hbuf.lsp_content_length(0, hlen)
                (n < 0 || n > LSP_BODY_MAX()).match ({
                    true  => 0,
                    false => {
                        body := mp.acquire(n + 1)
                        got := body.lsp_read_body(0, n)
                        body.offset(got).store(0)
                        act := mp.lsp_handle(root, cstr(body))
                        (act == 1).then({
                            shut = true
                        })
                        (act == 2).then({
                            running = false
                            code = shut.then({ 0 }, { 1 })
                        })
                        0
                    },
                })
            },
        })
    }
    code
}
// ── zen audit — dead-code + unused-import reporter (advisory; `--strict` exits 1 on findings) ─────
// Dead-decl analysis runs over the SAME whole-program pipeline `check` uses (resolve imports ->
// parse -> resolve_module), so alias qualification, UFCS dispatch and trait-default materialization
// are all visible. It builds a conservative reachability fixpoint over top-level decl NAMES:
//   * every name a live decl's body/types mention is live (calls, Var refs, type names, ctors/tags);
//   * a method call `x.m(...)` marks every free fn `m`, every impl method hoisted for bare name `m`
//     (`impl_<Trait>_<Ty>_m`, incl. trait defaults), and every alias-qualified `*__m` — receiver
//     types are NOT tracked, so this can never miss a dispatch target (false-negative direction);
//   * a live TYPE keeps every method of every impl block on it (trait dispatch may reach any), plus
//     the traits those impls conform to;
//   * impl blocks on BUILTIN receivers (string_view, u8, slices — no type decl to anchor) are roots;
//   * BOTH the raw and the resolved forms of each decl are walked: raw carries the surface names
//     (calls to inline templates disappear after inlining), resolved carries synthesized dispatch
//     (materialized trait defaults, mono instances, lowered closures, `eq`->impl rewrites).
// Reported: top-level fn/struct/enum/global decls never reached from the entry's `main`. Exempt
// (documented, all in the false-negative direction): DForeign prototypes (FFI headers), `impl_*`
// hoisted methods (their TYPE carries the verdict), `__`-prefixed synthesized decls, namespace-alias
// binds (covered by unused-import), pos-less synthesized decls. When the entry has no `main` (a
// library), every entry-module decl is a root instead.
// Unused-import analysis is per ORIGINAL module file: an imported name (`{ a, b } = mod`) or a
// namespace alias (`m = mod`) that never occurs in the module's own source outside the import
// statement itself. The scan is tokenizer-disciplined — identifiers inside strings, char literals
// and comments do NOT count as uses (so a name mentioned only in an embedded test-program string is
// correctly unused), and matches are whole-identifier (no `or`-inside-`for` hits). An imported
// TRAIT name is also credited when any METHOD of that trait occurs in the module: `{ PtrKind } =
// compiler.passes.ptrkind` exists to pull the trait's impl module into the closure, and the module
// then spells only `t.ptr_kind_of()`, never `PtrKind` itself (see AudTM below).
AudPair: {
    bare: string_view,
    full: string_view,
}    // method-name fanout: bare method/tail name -> hoisted/aliased decl name
AudImplM: {
    ty: string_view,
    full: string_view,
}    // type-liveness fanout: impl'd type -> hoisted method (or trait) name
AudCtx: {
    mp: MutPtr<Malloc>,
    decls: [Decl],
    rdecls: [Decl],
    ridx: Map<i64>,
    xidx: Map<i64>,
    seen: Map<i64>,
    mseen: Map<i64>,
    pairs: [AudPair],
    implms: [AudImplM],
}
aud_decl_name = (d: Decl) string_view {
    d.match ({
        .DFunc(f)      => f.name,
        .DForeign(f)   => f.name,
        .DStruct(sd)   => sd.name,
        .DEnum(ed)     => ed.name,
        .DGenStruct(g) => g.name,
        .DGenEnum(g)   => g.name,
        .DGlobal(g)    => g.name,
        _              => "",
    })
}
aud_decl_pos = (d: Decl) i32 {
    d.match ({
        .DFunc(f)      => f.pos,
        .DStruct(sd)   => sd.pos,
        .DEnum(ed)     => ed.pos,
        .DGenStruct(g) => g.pos,
        .DGenEnum(g)   => g.pos,
        .DGlobal(g)    => g.pos,
        _              => 0,
    })
}
aud_decl_is_type = (d: Decl) bool {
    d.match ({
        .DStruct(sd)   => true,
        .DEnum(ed)     => true,
        .DGenStruct(g) => true,
        .DGenEnum(g)   => true,
        _              => false,
    })
}
// the reporting kind word; "" = this decl kind is never reported (see the exemption list above).
aud_decl_kind = (d: Decl) string_view {
    d.match ({
        .DFunc(f)      => "fn",
        .DStruct(sd)   => "struct",
        .DEnum(ed)     => "enum",
        .DGenStruct(g) => "struct",
        .DGenEnum(g)   => "enum",
        .DGlobal(g)    => g.alias.then({ "" }, { "global" }),
        _              => "",
    })
}
aud_index = (mp: MutPtr<Malloc>, ds: [Decl]) Map<i64> {
    seedv: i64 := 0 - 1
    m := of(mp, "", seedv).expect("audit: oom")
    ds.loop((h, i, d) {
        nm := d.aud_decl_name()
        (is_empty(nm) == false).then({
            m = m.put(mp, nm, i).expect("audit: oom")
        })
    })
    m
}
// byte position AFTER the last `__` separator in `name`; -1 when it has none (or it leads).
aud_tail_at = (name: string_view) i64 {
    v: [u8] := name.view()
    best := 0 - 1
    i := 1
    @while (i + 1 < v.len) {
        (v[i] == '_' && v[i + 1] == '_').then({
            best = i + 2
        })
        i = i + 1
    }
    best
}
// mark `name` live and (once) walk both its raw and resolved decls; a live TYPE also keeps every
// impl-block method on it (aud_implms).
aud_ref = (ac: MutPtr<AudCtx>, name: string_view) void {
    ((is_empty(name) || ac.seen.has(name)) == false).then({
        one: i64 := 1
        ac.seen = ac.seen.put(ac.mp, name, one).expect("audit: oom")
        ri := ac.ridx.get(name, 0 - 1)
        (ri >= 0).then({
            d := ac.decls[ri]
            ac.aud_walk_decl(d)
            d.aud_decl_is_type().then({
                ac.aud_implms(name)
            })
        })
        xi := ac.xidx.get(name, 0 - 1)
        (xi >= 0).then({
            ac.aud_walk_decl(ac.rdecls[xi])
        })
    })
}
// a METHOD-position name: the free fn `m`, plus every hoisted impl method / alias tail for `m`.
aud_mref = (ac: MutPtr<AudCtx>, m: string_view) void {
    ((is_empty(m) || ac.mseen.has(m)) == false).then({
        one: i64 := 1
        ac.mseen = ac.mseen.put(ac.mp, m, one).expect("audit: oom")
        ac.aud_ref(m)
        ac.pairs.loop((h, i, p) {
            (p.bare == m).then({
                ac.aud_ref(p.full)
            })
        })
    })
}
// type-liveness fanout: every impl-block method (and trait) recorded against `tyname`.
aud_implms = (ac: MutPtr<AudCtx>, tyname: string_view) void {
    ac.implms.loop((h, i, im) {
        (im.ty == tyname).then({
            ac.aud_ref(im.full)
        })
    })
}
aud_walk_decl = (ac: MutPtr<AudCtx>, d: Decl) void {
    d.match ({
        .DFunc(f)          => ac.aud_walk_fn(f),
        .DForeign(f)       => ac.aud_walk_sig(f),
        .DStruct(sd)       => ac.aud_walk_fields(sd.fields),
        .DGenStruct(g)     => ac.aud_walk_fields(g.fields),
        .DEnum(ed)         => ac.aud_walk_variants(ed.variants),
        .DGenEnum(g)       => ac.aud_walk_variants(g.variants),
        .DGlobal(g)        => {
            ac.aud_walk_ty(g.ty)
            (g.init.is_expr_null() == false).then({
                ac.aud_walk_expr(g.init)
            })
        },
        .DTraitDefault(td) => ac.aud_walk_fn(td.fn),
        .DImpl(im)         => ac.aud_walk_ty(im.trty),
        _                  => { },
    })
}
aud_walk_fn = (ac: MutPtr<AudCtx>, f: Func) void {
    ac.aud_walk_sig(f)
    ac.aud_walk_stmts(f.body)
}
aud_walk_sig = (ac: MutPtr<AudCtx>, f: Func) void {
    f.params.loop((h, i, p) {
        ac.aud_walk_ty(p.ty)
    })
    f.tparams.loop((h, i, p) {
        ac.aud_walk_ty(p.ty)
    })    // generic BOUNDS (`f<A: Allocator>`) reference the trait
    ac.aud_walk_ty(f.ret)
}
aud_walk_fields = (ac: MutPtr<AudCtx>, fs: [Field]) void {
    fs.loop((h, i, f) {
        ac.aud_walk_ty(f.ty)
    })
}
aud_walk_variants = (ac: MutPtr<AudCtx>, vs: [VariantDef]) void {
    vs.loop((h, i, v) {
        ac.aud_walk_ty(v.payload)
        (v.dflt.is_expr_null() == false).then({
            ac.aud_walk_expr(v.dflt)
        })
    })
}
aud_walk_ty = (ac: MutPtr<AudCtx>, t: Ty) void {
    t.match ({
        .Named(n)   => ac.aud_ref(n),
        .Generic(g) => {
            ac.aud_ref(g.name)
            g.args.loop((h, i, x) {
                ac.aud_walk_ty(x)
            })
        },
        .Ptr(pd)    => ac.aud_walk_ty(load(pd.pointee)),
        .Slice(e)   => ac.aud_walk_ty(load(e)),
        .FnT(ft)    => {
            ft.params.loop((h, i, x) {
                ac.aud_walk_ty(x)
            })
            ac.aud_walk_ty(load(ft.ret))
        },
        _           => { },
    })
}
aud_walk_stmts = (ac: MutPtr<AudCtx>, body: [Stmt]) void {
    body.loop((h, i, st) {
        ac.aud_walk_stmt(st)
    })
}
aud_walk_stmt = (ac: MutPtr<AudCtx>, st: Stmt) void {
    st.match ({
        .Let(l)      => {
            ac.aud_walk_ty(l.ty)
            ac.aud_walk_expr(l.value)
        },
        .Assign(x)   => {
            ac.aud_walk_expr(x.target)
            ac.aud_walk_expr(x.value)
        },
        .Return(r)   => (r.is_expr_null() == false).then({
            ac.aud_walk_expr(r)
        }),
        .If(f)       => {
            ac.aud_walk_expr(f.c)
            ac.aud_walk_stmts(f.then)
            ac.aud_walk_stmts(f.els)
        },
        .While(w)    => {
            ac.aud_walk_expr(w.c)
            ac.aud_walk_stmts(w.body)
        },
        .IndexSet(x) => {
            ac.aud_walk_expr(x.seq)
            ac.aud_walk_expr(x.idx)
            ac.aud_walk_ty(x.elem)
            ac.aud_walk_expr(x.value)
        },
        .ExprStmt(e) => ac.aud_walk_expr(e),
    })
}
aud_walk_expr = (ac: MutPtr<AudCtx>, e: Ptr<Expr>) void {
    load(e).match ({
        .Var(v)         => ac.aud_ref(v.name),
        .Bin(b)         => {
            ac.aud_walk_expr(b.lhs)
            ac.aud_walk_expr(b.rhs)
        },
        .Call(c)        => {
            ac.aud_mref(c.fn)
            c.targs.loop((h, i, t) {
                ac.aud_walk_ty(t)
            })
            c.args.loop((h, i, x) {
                ac.aud_walk_expr(x.addr())
            })
        },
        .MethodCall(mc) => {
            ac.aud_mref(mc.method)
            ac.aud_walk_expr(mc.recv)
            mc.args.loop((h, i, x) {
                ac.aud_walk_expr(x.addr())
            })
        },
        .Cond(cd)       => {
            ac.aud_walk_expr(cd.c)
            ac.aud_walk_expr(cd.t)
            ac.aud_walk_expr(cd.e)
        },
        .Member(m)      => {
            // `alias.NAME` reads the flat decl `alias__NAME` — credit that spelling too.
            load(m.obj).match ({
                .Var(v) => ac.aud_ref(ac.mp.aud_join2(v.name, m.field)),
                _       => { },
            })
            ac.aud_walk_expr(m.obj)
        },
        .Arrow(ar)      => ac.aud_walk_expr(ar.obj),
        .MakeEnum(mk)   => {
            ac.aud_ref(mk.ty)
            mk.targs.loop((h, i, t) {
                ac.aud_walk_ty(t)
            })
            (mk.payload.is_expr_null() == false).then({
                ac.aud_walk_expr(mk.payload)
            })
        },
        .MakeStruct(ms) => {
            ac.aud_ref(ms.ty)
            ms.targs.loop((h, i, t) {
                ac.aud_walk_ty(t)
            })
            ms.inits.loop((h, i, fi) {
                ac.aud_walk_expr(fi.value)
            })
        },
        .Tag(tg)        => {
            ac.aud_ref(tg.ty)
            tg.targs.loop((h, i, t) {
                ac.aud_walk_ty(t)
            })
        },
        .Match(md)      => {
            ac.aud_ref(md.ename)
            ac.aud_walk_expr(md.subj)
            md.arms.loop((h, i, ar2) {
                ac.aud_walk_expr(ar2.body)
            })
        },
        .SliceLit(sd)   => {
            ac.aud_walk_ty(sd.elem)
            sd.items.loop((h, i, x) {
                ac.aud_walk_expr(x.addr())
            })
        },
        .Index(ix)      => {
            ac.aud_walk_expr(ix.seq)
            ac.aud_walk_expr(ix.idx)
            ac.aud_walk_ty(ix.elem)
        },
        .Loop(lp)       => {
            ac.aud_walk_expr(lp.seq)
            ac.aud_walk_ty(lp.elemTy)
            ac.aud_walk_stmts(lp.body)
        },
        .Lambda(la)     => {
            la.params.loop((h, i, p) {
                ac.aud_walk_ty(p.ty)
            })
            ac.aud_walk_ty(la.ret)
            ac.aud_walk_stmts(la.body)
        },
        .Block(bl)      => ac.aud_walk_stmts(bl.stmts),
        _               => { },
    })
}
aud_join2 = (mp: MutPtr<Malloc>, a: string_view, b: string_view) string_view {
    mp
        .gstr_string(32)
        .gstr_append(mp, a)
        .gstr_append(mp, "__")
        .gstr_append(mp, b)
        .gstr_finish(mp)
}
// ── audit fanout tables ───────────────────────────────────────────────────────────────────────────
// One prepass over the raw decls builds:
//   pairs  — (bare method/tail name -> hoisted decl name): every DImpl method, every trait-default
//            materialization target per conforming impl, every `alias__name`-shaped decl tail.
//   implms — (impl'd type -> hoisted method name / trait name): the type-liveness fanout.
aud_td_idxs = (mp: MutPtr<Malloc>, decls: [Decl]) [i64] {
    n := 0
    decls.loop((h, i, d) {
        d.match ({
            .DTraitDefault(td) => {
                n = n + 1
            },
            _                  => { },
        })
    })
    buf := cbuf<i64>(mp, n)
    k := 0
    decls.loop((h, i, d) {
        d.match ({
            .DTraitDefault(td) => {
                buf[k] = i
                k = k + 1
            },
            _                  => { },
        })
    })
    buf
}
// defaults of impl `im`'s trait: how many DTraitDefault decls share its trait name.
aud_impl_dflts = (decls: [Decl], tds: [i64], trname: string_view) i64 {
    n := 0
    tds.loop((h, j, ti) {
        decls[ti].match ({
            .DTraitDefault(td) => {
                (td.trname == trname).then({
                    n = n + 1
                })
            },
            _                  => { },
        })
    })
    n
}
aud_pair_count = (decls: [Decl], tds: [i64]) i64 {
    n := 0
    decls.loop((h, i, d) {
        d.match ({
            .DImpl(im) => {
                n = n + im.methods.len + decls.aud_impl_dflts(tds, im.trname)
            },
            _          => {
                (d.aud_decl_name().aud_tail_at() > 0).then({
                    n = n + 1
                })
            },
        })
    })
    n
}
aud_implm_count = (decls: [Decl], tds: [i64]) i64 {
    n := 0
    decls.loop((h, i, d) {
        d.match ({
            .DImpl(im) => {
                n = n + im.methods.len + decls.aud_impl_dflts(tds, im.trname) + 1
            },
            _          => { },
        })
    })
    n
}
AudTables: {
    pairs: [AudPair],
    implms: [AudImplM],
}
aud_tables = (mp: MutPtr<Malloc>, decls: [Decl]) AudTables {
    tds := mp.aud_td_idxs(decls)
    pairs := cbuf<AudPair>(mp, decls.aud_pair_count(tds))
    implms := cbuf<AudImplM>(mp, decls.aud_implm_count(tds))
    pk := 0
    mk2 := 0
    decls.loop((h, i, d) {
        d.match ({
            .DImpl(im) => {
                im.methods.loop((h2, j, p) {
                    full := mp.impl_cname_in(im.trname, im.ty, p.name)
                    pairs[pk] = AudPair(
                        bare: p.name,
                        full: full,
                    )
                    pk = pk + 1
                    implms[mk2] = AudImplM(
                        ty: im.ty,
                        full: full,
                    )
                    mk2 = mk2 + 1
                })
                tds.loop((h2, j, ti) {
                    // trait-default materializations this impl can dispatch to (methods it OMITS are
                    // still reachable through its trait's defaults).
                    decls[ti].match ({
                        .DTraitDefault(td) => {
                            (td.trname == im.trname).then({
                                full := mp.impl_cname_in(im.trname, im.ty, td.fn.name)
                                pairs[pk] = AudPair(
                                    bare: td.fn.name,
                                    full: full,
                                )
                                pk = pk + 1
                                implms[mk2] = AudImplM(
                                    ty: im.ty,
                                    full: full,
                                )
                                mk2 = mk2 + 1
                            })
                        },
                        _                  => { },
                    })
                })
                // conformance names the trait struct — a live type keeps its traits.
                implms[mk2] = AudImplM(
                    ty: im.ty,
                    full: im.trname,
                )
                mk2 = mk2 + 1
            },
            _          => {
                nm := d.aud_decl_name()
                ta := nm.aud_tail_at()
                (ta > 0).then({
                    pairs[pk] = AudPair(
                        bare: cstr(offset(nm, ta)),
                        full: nm,
                    )
                    pk = pk + 1
                })
            },
        })
    })
    AudTables(
        pairs: pairs,
        implms: implms,
    )
}
// ── trait-method table (unused-import crediting) ──────────────────────────────────────────────────
// A `{ Trait } = mod` import often exists ONLY to pull the trait's impl module into the program
// closure: the importing module never spells the trait's NAME again, it dispatches the trait's
// METHODS (`t.ptr_kind_of()`). The unused-import scan therefore credits a trait-name import as used
// when any method of that trait occurs as an identifier in the module. Receiver types are not
// tracked — false-negative direction: a genuinely unused trait import whose method name happens to
// occur stays unreported, but a closure-pulling import is never flagged. The method surface of
// trait `tr` is: every DImpl method under `tr`, every DTraitDefault of `tr`, and `tr`'s own
// fn-typed struct fields.
AudTM: {
    tr: string_view,
    mv: [u8],
}
aud_fnt_fields = (fs: [Field]) i64 {
    n := 0
    fs.loop((h, i, f) {
        f.ty.match ({
            .FnT(ft) => {
                n = n + 1
            },
            _        => { },
        })
    })
    n
}
aud_tm_count = (decls: [Decl]) i64 {
    n := 0
    decls.loop((h, i, d) {
        d.match ({
            .DImpl(im)         => {
                n = n + im.methods.len
            },
            .DTraitDefault(td) => {
                n = n + 1
            },
            .DStruct(sd)       => {
                n = n + sd.fields.aud_fnt_fields()
            },
            .DGenStruct(g)     => {
                n = n + g.fields.aud_fnt_fields()
            },
            _                  => { },
        })
    })
    n
}
aud_tm_push_fields = (tms: [AudTM], k: i64, tr: string_view, fs: [Field]) i64 {
    j := k
    fs.loop((h, i, f) {
        f.ty.match ({
            .FnT(ft) => {
                tms[j] = AudTM(
                    tr: tr,
                    mv: f.name.view(),
                )
                j = j + 1
            },
            _        => { },
        })
    })
    j
}
aud_tms = (mp: MutPtr<Malloc>, decls: [Decl]) [AudTM] {
    tms := cbuf<AudTM>(mp, decls.aud_tm_count())
    k := 0
    decls.loop((h, i, d) {
        d.match ({
            .DImpl(im)         => {
                im.methods.loop((h2, j, p) {
                    tms[k] = AudTM(
                        tr: im.trname,
                        mv: p.name.view(),
                    )
                    k = k + 1
                })
            },
            .DTraitDefault(td) => {
                tms[k] = AudTM(
                    tr: td.trname,
                    mv: td.fn.name.view(),
                )
                k = k + 1
            },
            .DStruct(sd)       => {
                k = tms.aud_tm_push_fields(k, sd.name, sd.fields)
            },
            .DGenStruct(g)     => {
                k = tms.aud_tm_push_fields(k, g.name, g.fields)
            },
            _                  => { },
        })
    })
    tms
}
// the trait-method subset credited to imported name `name` (empty when `name` is not a trait).
aud_tm_for = (mp: MutPtr<Malloc>, tms: [AudTM], name: string_view) [AudTM] {
    n := 0
    tms.loop((h, i, t) {
        (t.tr == name).then({
            n = n + 1
        })
    })
    sub := cbuf<AudTM>(mp, n)
    k := 0
    tms.loop((h, i, t) {
        (t.tr == name).then({
            sub[k] = t
            k = k + 1
        })
    })
    sub
}
// ── audit findings ────────────────────────────────────────────────────────────────────────────────
AudFinding: {
    path: string_view,
    line: i64,
    msg: string_view,
    dead: bool,
}
aud_strcmp = (a: string_view, b: string_view) i64 {
    av: [u8] := a.view()
    bv: [u8] := b.view()
    i := 0
    r := 0
    @while (r == 0 && i < av.len && i < bv.len) {
        (av[i] < bv[i]).then({
            r = 0 - 1
        })
        (av[i] > bv[i]).then({
            r = 1
        })
        i = i + 1
    }
    (r == 0 && av.len < bv.len).then({
        r = 0 - 1
    })
    (r == 0 && av.len > bv.len).then({
        r = 1
    })
    r
}
// order findings by (path, line, msg) — the msg tiebreak makes duplicates ADJACENT (msg carries
// kind + name), so the emit loop can drop repeats with a previous-line compare.
aud_lt = (a: AudFinding, b: AudFinding) bool {
    c := a.path.aud_strcmp(b.path)
    c < 0 || c == 0 && (a.line < b.line || a.line == b.line && a.msg.aud_strcmp(b.msg) < 0)
}
aud_sort = (fb: [AudFinding], n: i64) void {
    i := 1
    @while (i < n) {
        x := fb[i]
        j := i - 1
        @while (j >= 0 && x.aud_lt(fb[j])) {
            fb[j + 1] = fb[j]
            j = j - 1
        }
        fb[j + 1] = x
        i = i + 1
    }
}
// is this raw decl one the report should name? (kinds/prefixes exempted per the header comment)
aud_reportable = (d: Decl) bool {
    nm := d.aud_decl_name()
    is_empty(nm) == false
        && d.aud_decl_pos() > 0
        && is_empty(d.aud_decl_kind()) == false
        && nm.starts_with("impl_") == false
        && nm.starts_with("__") == false
}
aud_dead_msg = (mp: MutPtr<Malloc>, kind: string_view, nm: string_view) string_view {
    mp
        .gstr_string(64)
        .gstr_append(mp, "warning[dead-code]: ")
        .gstr_append(mp, kind)
        .gstr_append(mp, " '")
        .gstr_append(mp, nm)
        .gstr_append(mp, "' is never reachable from main")
        .gstr_finish(mp)
}
// ── unused-import scan (per original module source; tokenizer-disciplined) ────────────────────────
AudImp: {
    name: string_view,
    nv: [u8],
    ms: [AudTM],
    mod: string_view,
    pos: i32,
    alias: bool,
    used: bool,
    lo: i64,
    hi: i64,
}
aud_is_ident_start = (b: u8) bool { b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z' || b == '_' }
aud_is_ident_char = (b: u8) bool { b.aud_is_ident_start() || b >= '0' && b <= '9' }
// 1-based line of byte `pos` (iterative — module sources are hundreds of KB).
aud_line_of = (v: [u8], pos: i64) i64 {
    ln := 1
    i := 0
    @while (i < pos && i < v.len) {
        (v[i] == '\n').then({
            ln = ln + 1
        })
        i = i + 1
    }
    ln
}
// end of an import statement's span: from `{` past the matching `}`, the `=`, and the dotted path.
aud_imp_span_hi = (v: [u8], pos: i64) i64 {
    i := pos
    @while (i < v.len && v[i] != '}') {
        i = i + 1
    }
    i = i + 1
    @while (i < v.len && (v[i] == ' ' || v[i] == '\t' || v[i] == '\n' || v[i] == '=')) {
        i = i + 1
    }
    @while (i < v.len && (v[i].aud_is_ident_char() || v[i] == '.')) {
        i = i + 1
    }
    i
}
// end of a one-line namespace-alias bind's span (`m = std.x.y`): the end of its line.
aud_line_end = (v: [u8], pos: i64) i64 {
    i := pos
    @while (i < v.len && v[i] != '\n') {
        i = i + 1
    }
    i
}
// identifier token [s,e) equals `nv`?
aud_tok_eq = (v: [u8], s: i64, e: i64, nv: [u8]) bool {
    ok := nv.len == e - s
    k := 0
    @while (ok && k < nv.len) {
        (v[s + k] == nv[k]).match ({
            true  => {
                k = k + 1
            },
            false => {
                ok = false
            },
        })
    }
    ok
}
// does token [s,e) equal any credited trait-method name?
aud_ms_eq = (v: [u8], s: i64, e: i64, ms: [AudTM]) bool {
    hit := false
    ms.loop((h, i, t) {
        v.aud_tok_eq(s, e, t.mv).then({
            hit = true
            h.break
        })
    })
    hit
}
aud_mark_used = (ents: [AudImp], nents: i64, v: [u8], s: i64, e: i64) void {
    k := 0
    @while (k < nents) {
        en := ents[k]
        (en.used == false
            && (s < en.lo || s >= en.hi)
            && (v.aud_tok_eq(s, e, en.nv) || v.aud_ms_eq(s, e, en.ms))).then({
            en.used = true
            ents[k] = en
        })
        k = k + 1
    }
}
// one scanner step at byte i: skip a comment/string/char literal whole, consume an identifier and
// match it against the imported names, else advance one byte. Returns the next position.
aud_step = (ents: [AudImp], nents: i64, v: [u8], i0: i64) i64 {
    n := v.len
    b := v[i0]
    (b == '/' && i0 + 1 < n && v[i0 + 1] == '/').then({
        i := i0 + 2
        @while (i < n && v[i] != '\n') {
            i = i + 1
        }
        return i + 1
    })
    (b == '/' && i0 + 1 < n && v[i0 + 1] == '*').then({
        i := i0 + 2
        @while (i + 1 < n && (v[i] == '*' && v[i + 1] == '/') == false) {
            i = i + 1
        }
        return i + 2
    })
    (b == '"').then({
        i := i0 + 1
        @while (i < n && v[i] != '"') {
            i = (v[i] == '\\').then({ i + 2 }, { i + 1 })
        }
        return i + 1
    })
    (b == '\'').then({
        i := i0 + 1
        @while (i < n && v[i] != '\'') {
            i = (v[i] == '\\').then({ i + 2 }, { i + 1 })
        }
        return i + 1
    })
    b.aud_is_ident_start().then({
        i := i0 + 1
        @while (i < n && v[i].aud_is_ident_char()) {
            i = i + 1
        }
        ents.aud_mark_used(nents, v, i0, i)
        return i
    })
    i0 + 1
}
aud_imp_msg = (mp: MutPtr<Malloc>, en: AudImp) string_view {
    en.alias.match ({
        true  => mp
            .gstr_string(64)
            .gstr_append(mp, "warning[unused-import]: namespace alias '")
            .gstr_append(mp, en.name)
            .gstr_append(mp, "' is never used")
            .gstr_finish(mp),
        false => mp
            .gstr_string(64)
            .gstr_append(mp, "warning[unused-import]: '")
            .gstr_append(mp, en.name)
            .gstr_append(mp, "' imported from '")
            .gstr_append(mp, en.mod)
            .gstr_append(mp, "' but never used")
            .gstr_finish(mp),
    })
}
// scan ONE module file: every `{ a, b } = mod` name and every `m = mod` alias that never occurs in
// the module's own source outside the import statement itself (a trait name's methods count — see
// AudTM). Appends findings; returns the count.
aud_mod_imports = (
    mp: MutPtr<Malloc>,
    m: ModuleEntry,
    tms: [AudTM],
    fb: [AudFinding],
    n0: i64,
) i64 {
    ds := mp.parse_module(m.source)
    v: [u8] := m.source.view()
    cnt := 0
    ds.loop((h, i, d) {
        d.match ({
            .DImport(imp) => {
                cnt = cnt + imp.names.len
            },
            .DGlobal(g)   => {
                g.alias.then({
                    cnt = cnt + 1
                })
            },
            _             => { },
        })
    })
    (cnt == 0).then({
        return n0
    })
    ents := cbuf<AudImp>(mp, cnt)
    k := 0
    ds.loop((h, i, d) {
        d.match ({
            .DImport(imp) => {
                hi := v.aud_imp_span_hi(to_i64(imp.pos))
                imp.names.loop((h2, j, p) {
                    ents[k] = AudImp(
                        name: p.name,
                        nv: p.name.view(),
                        ms: mp.aud_tm_for(tms, p.name),
                        mod: imp.module,
                        pos: imp.pos,
                        alias: false,
                        used: false,
                        lo: to_i64(imp.pos),
                        hi: hi,
                    )
                    k = k + 1
                })
            },
            .DGlobal(g)   => {
                g.alias.then({
                    ents[k] = AudImp(
                        name: g.name,
                        nv: g.name.view(),
                        ms: cbuf<AudTM>(mp, 0),
                        mod: "",
                        pos: g.pos,
                        alias: true,
                        used: false,
                        lo: to_i64(g.pos),
                        hi: v.aud_line_end(to_i64(g.pos)),
                    )
                    k = k + 1
                })
            },
            _             => { },
        })
    })
    i: i64 := 0
    @while (i < v.len) {
        i = ents.aud_step(k, v, i)
    }
    n := n0
    j := 0
    @while (j < k) {
        en := ents[j]
        (en.used == false && n < fb.len).then({
            fb[n] = AudFinding(
                path: m.path,
                line: v.aud_line_of(to_i64(en.pos)),
                msg: mp.aud_imp_msg(en),
                dead: false,
            )
            n = n + 1
        })
        j = j + 1
    }
    n
}
// ── the audit driver ──────────────────────────────────────────────────────────────────────────────
// build the ctx and run the reachability fixpoint. Roots: the entry `main` (a `main = (sys: Sys)`
// entry also reaches std.sys.root — genc emits the trampoline call); impl blocks on builtin
// receivers (no type decl to anchor liveness on); when the entry has no `main` (a library), every
// entry-module decl is a root instead.
aud_analyze = (mp: MutPtr<Malloc>, rp: ResolvedProgram, raw: [Decl], rdecls: [Decl]) AudCtx {
    seedv: i64 := 0 - 1
    t := mp.aud_tables(raw)
    c := AudCtx(
        mp: mp,
        decls: raw,
        rdecls: rdecls,
        ridx: mp.aud_index(raw),
        xidx: mp.aud_index(rdecls),
        seen: of(mp, "", seedv).expect("audit: oom"),
        mseen: of(mp, "", seedv).expect("audit: oom"),
        pairs: t.pairs,
        implms: t.implms,
    )
    ac := c.addr()
    ac.aud_ref("main")
    mi := c.ridx.get("main", 0 - 1)
    (mi >= 0).then({
        raw[mi].match ({
            .DFunc(f) => {
                (f.params.len > 0).then({
                    ac.aud_mref("root")
                })
            },
            _         => { },
        })
    })
    raw.loop((h, i, d) {
        d.match ({
            .DImpl(im) => {
                (c.ridx.get(im.ty, 0 - 1) < 0).then({
                    ac.aud_ref(im.trname)
                    im.methods.loop((h2, j, p) {
                        ac.aud_ref(mp.impl_cname_in(im.trname, im.ty, p.name))
                    })
                })
            },
            _          => { },
        })
    })
    (mi < 0).then({
        raw.loop((h, i, d) {
            // no entry `main` (a library): every decl of the ENTRY module region is a root.
            p := d.aud_decl_pos()
            ri := rp.regions.fregion_find(to_i64(p))
            (p > 0 && ri >= 0 && rp.regions[ri].midx == 0).then({
                ac.aud_ref(d.aud_decl_name())
            })
        })
    })
    c
}
// A module bound BOTH bare and under a namespace alias is appended twice (once as `f`, once as
// `alias__f`) — both copies come from the SAME source line, so if EITHER copy is live the line
// is live and neither may be reported. The suppression set: bare `__`-tails of the live names.
aud_live_tails = (mp: MutPtr<Malloc>, c: AudCtx) Map<i64> {
    seedv: i64 := 0 - 1
    tails := of(mp, "", seedv).expect("audit: oom")
    c.seen.keys().loop((h, i, k) {
        ta := k.aud_tail_at()
        (ta > 0).then({
            one: i64 := 1
            tails = tails.put(mp, cstr(offset(k, ta)), one).expect("audit: oom")
        })
    })
    tails
}
// is decl name `nm` unreached? — not live, with no live `__`-twin in either direction (suppress a
// dead `f` when some live `*__f` twin exists, and a dead `alias__f` when its bare tail `f` is live;
// false-negative direction).
aud_unreached = (c: AudCtx, tails: Map<i64>, nm: string_view) bool {
    nta := nm.aud_tail_at()
    twin := tails.has(nm) || nta > 0 && c.seen.has(cstr(offset(nm, nta)))
    c.seen.has(nm) == false && twin == false
}
aud_run = (
    mp: MutPtr<Malloc>,
    rp: ResolvedProgram,
    raw: [Decl],
    rdecls: [Decl],
    path: string_view,
    src: string_view,
    strict: bool,
) i32 {
    c := mp.aud_analyze(rp, raw, rdecls)
    tails := mp.aud_live_tails(c)
    // collect findings: dead decls (flat order), then unused imports (per module file).
    fb := cbuf<AudFinding>(mp, raw.len + 8192)
    n := 0
    raw.loop((h, i, d) {
        (d.aud_reportable() && c.aud_unreached(tails, d.aud_decl_name()) && n < fb.len).then({
            dl := locate_diag(rp, d.aud_decl_pos(), 1, path, src)
            fb[n] = AudFinding(
                path: dl.path,
                line: to_i64(dl.sp.line),
                msg: mp.aud_dead_msg(d.aud_decl_kind(), d.aud_decl_name()),
                dead: true,
            )
            n = n + 1
        })
    })
    tms := mp.aud_tms(raw)
    rp.table.modules.loop((h, i, m) {
        n = mp.aud_mod_imports(m, tms, fb, n)
    })
    mp.aud_emit(fb, n, strict)
}
// sort, dedupe on (path, line, msg), print, summarize; returns the `--strict` exit code. The same
// finding can be collected more than once (a module reached under several ids/regions), so equal
// (path, line, msg) rows — adjacent after aud_sort — are emitted ONCE and counted once.
aud_emit = (mp: MutPtr<Malloc>, fb: [AudFinding], n: i64, strict: bool) i32 {
    fb.aud_sort(n)
    dead := 0
    shown := 0
    i := 0
    @while (i < n) {
        f := fb[i]
        dup := i > 0
            && f.path == fb[i - 1].path
            && f.line == fb[i - 1].line
            && f.msg == fb[i - 1].msg
        (dup == false).then({
            f.dead.then({
                dead = dead + 1
            })
            shown = shown + 1
            say(mp
                .gstr_string(96)
                .gstr_append(mp, f.path)
                .gstr_push(mp, ':')
                .push_int(mp, f.line)
                .gstr_append(mp, ": ")
                .gstr_append(mp, f.msg)
                .gstr_finish(mp))
        })
        i = i + 1
    }
    say(mp
        .gstr_string(64)
        .gstr_append(mp, "zen audit: ")
        .push_int(mp, dead)
        .gstr_append(mp, " dead decls, ")
        .push_int(mp, shown - dead)
        .gstr_append(mp, " unused imports")
        .gstr_finish(mp))
    (strict && shown > 0).then({ 1 }, { 0 })
}
// ── zen audit --workspace ─────────────────────────────────────────────────────────────────────────
// `zenc audit --workspace <dir> [--strict]` — union dead-code reachability across EVERY entry point
// (file with a top-level `main`) found under <dir>. A decl is reported dead only when NO analyzed
// entry reaches it, i.e. it is dead from every entry whose closure contains it (#595: per-entry
// kill-lists were misread as "safe to delete" — helpers live only from tests/examples were
// invisible). String literals count too: import-shaped lines inside them (embedded test programs)
// root the named decls/modules — coarse, keep-direction. Unused-import findings are per FILE
// (entry-independent), so each module file is scanned once. Entries that fail resolve/check are
// skipped (their diagnostics print) and counted in the header. Dot-directories and `fixtures/`
// trees are excluded from the sweep — fixture corpora are test INPUTS (often deliberately broken),
// not workspace programs.
AudWsFiles: {
    mp: MutPtr<Malloc>,
    fs: [string_view],
    n: i64,
}
aud_ws_addf = (wf: MutPtr<AudWsFiles>, p: string_view) void {
    (wf.n >= wf.fs.len).then({
        grown := cbuf<string_view>(wf.mp, wf.fs.len * 2)
        wf.fs.loop((h, i, x) {
            grown[i] = x
        })
        wf.fs = grown
    })
    wf.fs[wf.n] = p
    wf.n = wf.n + 1
}
aud_join_path = (mp: MutPtr<Malloc>, dir: string_view, nm: string_view) string_view {
    mp
        .gstr_string(64)
        .gstr_append(mp, dir)
        .gstr_push(mp, '/')
        .gstr_append(mp, nm)
        .gstr_finish(mp)
}
// deterministic entry order regardless of readdir order.
aud_sortp = (fs: [string_view], n: i64) void {
    i := 1
    @while (i < n) {
        x := fs[i]
        j := i - 1
        @while (j >= 0 && x.aud_strcmp(fs[j]) < 0) {
            fs[j + 1] = fs[j]
            j = j - 1
        }
        fs[j + 1] = x
        i = i + 1
    }
}
// `struct dirent`: the NUL-terminated entry name (d_name) at +19 on this ABI (matches std.sys.fs).
AUD_DNAME := 19
// recursively collect the `*.zen` files under `dir` (skipping dot-entries and `fixtures/` corpora).
aud_walk_tree = (mp: MutPtr<Malloc>, dir: string_view, wf: MutPtr<AudWsFiles>) void {
    d := opendir(dir)
    (d == null_ptr() == false).then({
        e := readdir(d)
        @while (e != null_ptr()) {
            nm := cstr(e.offset(AUD_DNAME))
            ((nm.starts_with(".") || nm == "fixtures") == false).then({
                full := mp.aud_join_path(dir, nm)
                zi_is_dir(full).match ({
                    true  => mp.aud_walk_tree(full, wf),
                    false => full.ends_with(".zen").then({
                        wf.aud_ws_addf(full)
                    }),
                })
            })
            e = readdir(d)
        }
        closedir(d)
    })
}
// cheap textual entry test: some line starts `main` then (spaces) `=` — no parse, so a broken
// candidate costs nothing here (resolve/check vet the survivors).
aud_has_main = (src: string_view) bool {
    v: [u8] := src.view()
    found := false
    bol := true
    i := 0
    @while (found == false && i < v.len) {
        (bol
            && i + 4 < v.len
            && v[i] == 'm'
            && v[i + 1] == 'a'
            && v[i + 2] == 'i'
            && v[i + 3] == 'n'
            && v[i + 4].aud_is_ident_char() == false).then({
            j := i + 4
            (j < v.len && v[j] == '*').then({
                j = j + 1
            })
            @while (j < v.len && (v[j] == ' ' || v[j] == '\t')) {
                j = j + 1
            }    // exported entry: `main* = (...)`
            (j + 1 < v.len && v[j] == '=' && v[j + 1] != '=').then({
                found = true
            })
        })
        bol = v[i] == '\n'
        i = i + 1
    }
    found
}
// the bytes [s,e) of `v` as a fresh cstr (embedded names are substrings of a literal, never
// NUL-terminated in place).
aud_bytes = (mp: MutPtr<Malloc>, v: [u8], s: i64, e: i64) string_view {
    o := mp.gstr_string(e - s + 1)
    i := s
    @while (i < e) {
        o = o.gstr_push(mp, v[i])
        i = i + 1
    }
    o.gstr_finish(mp)
}
// one string-literal body [a,b): find import-shaped fragments. `{ x, y } = mod` aud_refs each name
// as a root; `alias = dotted.mod` (a dot is required — plain `x = y` assignments are everywhere in
// embedded programs) folds the module id into `mods` so the caller can root that module's decls.
aud_embed_lit = (
    ac: MutPtr<AudCtx>,
    mp: MutPtr<Malloc>,
    mods: Map<i64>,
    v: [u8],
    a: i64,
    b: i64,
) Map<i64> {
    m := mods
    j := a
    @while (j < b) {
        hit := v[j] == '='
            && (j + 1 >= b || v[j + 1] != '=')
            && j > a
            && v[j - 1] != ':'
            && v[j - 1] != '='
            && v[j - 1] != '!'
            && v[j - 1] != '<'
            && v[j - 1] != '>'
        hit.then({
            k := j - 1
            @while (k > a && (v[k] == ' ' || v[k] == '\t')) {
                k = k - 1
            }
            q := j + 1
            @while (q < b && (v[q] == ' ' || v[q] == '\t')) {
                q = q + 1
            }
            s0 := q
            @while (q < b && (v[q].aud_is_ident_char() || v[q] == '.')) {
                q = q + 1
            }
            @while (q > s0 && v[q - 1] == '.') {
                q = q - 1
            }
            rhs_ok := q > s0 && v[s0].aud_is_ident_start()
            (rhs_ok && v[k] == '}').then({
                // `{ names } = mod` — each imported name becomes a root.
                p := k - 1
                @while (p > a && v[p] != '{') {
                    p = p - 1
                }
                (v[p] == '{').then({
                    x := p + 1
                    @while (x < k) {
                        v[x].aud_is_ident_start().match ({
                            true  => {
                                x0 := x
                                @while (x < k && v[x].aud_is_ident_char()) {
                                    x = x + 1
                                }
                                ac.aud_ref(mp.aud_bytes(v, x0, x))
                            },
                            false => {
                                x = x + 1
                            },
                        })
                    }
                })
            })
            (rhs_ok && v[k].aud_is_ident_char()).then({
                // `alias = dotted.mod` — require a dotted RHS at (embedded) line start.
                is := k
                @while (is > a && v[is - 1].aud_is_ident_char()) {
                    is = is - 1
                }
                w := is - 1
                @while (w > a && (v[w] == ' ' || v[w] == '\t')) {
                    w = w - 1
                }
                atbol := w < a || v[w] == '\n' || v[w] == 'n' && w > a && v[w - 1] == '\\'
                dotted := false
                y := s0
                @while (y < q) {
                    (v[y] == '.').then({
                        dotted = true
                    })
                    y = y + 1
                }
                (atbol && dotted && v[is].aud_is_ident_start()).then({
                    one: i64 := 1
                    m = m.put(mp, mp.aud_bytes(v, s0, q), one).expect("audit: oom")
                })
            })
        })
        j = j + 1
    }
    m
}
// scan one module source for string literals, folding their import-shaped fragments into roots.
aud_embed_src = (
    ac: MutPtr<AudCtx>,
    mp: MutPtr<Malloc>,
    mods: Map<i64>,
    src: string_view,
) Map<i64> {
    v: [u8] := src.view()
    m := mods
    n := v.len
    i := 0
    @while (i < n) {
        b := v[i]
        nx := i + 1
        (b == '/' && i + 1 < n && v[i + 1] == '/').then({
            j := i + 2
            @while (j < n && v[j] != '\n') {
                j = j + 1
            }
            nx = j + 1
        })
        (b == '/' && i + 1 < n && v[i + 1] == '*').then({
            j := i + 2
            @while (j + 1 < n && (v[j] == '*' && v[j + 1] == '/') == false) {
                j = j + 1
            }
            nx = j + 2
        })
        (b == '\'').then({
            j := i + 1
            @while (j < n && v[j] != '\'') {
                j = (v[j] == '\\').then({ j + 2 }, { j + 1 })
            }
            nx = j + 1
        })
        (b == '"').then({
            j := i + 1
            @while (j < n && v[j] != '"') {
                j = (v[j] == '\\').then({ j + 2 }, { j + 1 })
            }
            m = ac.aud_embed_lit(mp, m, v, i + 1, j)
            nx = j + 1
        })
        i = nx
    }
    m
}
// does table module id `id` (loader-normalized: `u/sub/mod2`, `std/io/file`) spell the embedded
// dotted id (`sub.mod2`, `std.io.file`)?
aud_id_matches = (id: string_view, dotted: string_view) bool {
    iv: [u8] := id.view()
    dv: [u8] := dotted.view()
    off := id.starts_with("u/").then({ 2 }, { 0 })
    ok := iv.len - off == dv.len
    k := 0
    @while (ok && k < dv.len) {
        x := iv[off + k]
        y := dv[k]
        (x == y || x == '/' && y == '.').match ({
            true  => {
                k = k + 1
            },
            false => {
                ok = false
            },
        })
    }
    ok
}
// the --workspace embedded-source heuristic (#595): harness files BUILD test programs as string
// literals whose import lines the plain fixpoint cannot see. Root them: brace-form names aud_ref
// directly; alias-form module ids root every decl the module owns (per its flat regions).
aud_embed_roots = (ac: MutPtr<AudCtx>, mp: MutPtr<Malloc>, rp: ResolvedProgram, raw: [Decl]) void {
    seedv: i64 := 0 - 1
    mods := of(mp, "", seedv).expect("audit: oom")
    rp.table.modules.loop((h, i, m) {
        mods = ac.aud_embed_src(mp, mods, m.source)
    })
    // per-module rooted flags: some embedded dotted id names this module.
    rooted := cbuf<i64>(mp, rp.table.modules.len)
    rp.table.modules.loop((h, i, m) {
        r: i64 := 0
        mods.keys().loop((h2, j, k) {
            m.id.aud_id_matches(k).then({
                r = 1
            })
        })
        rooted[i] = r
    })
    raw.loop((h, i, d) {
        p := to_i64(d.aud_decl_pos())
        ri := rp.regions.fregion_find(p)
        (p > 0 && ri >= 0 && rooted[rp.regions[ri].midx] > 0).then({
            ac.aud_ref(d.aud_decl_name())
        })
    })
}
// the cross-entry union state. A finding is keyed `path:line:msg` (msg carries kind + name):
// `live` holds keys some entry reached, `idx` the keys already recorded as dead candidates, `mods`
// the module paths whose import scan already ran.
AudWsF: {
    key: string_view,
    f: AudFinding,
}
AudWs: {
    mp: MutPtr<Malloc>,
    live: Map<i64>,
    idx: Map<i64>,
    mods: Map<i64>,
    dfs: [AudWsF],
    nd: i64,
    ifs: [AudFinding],
    ni: i64,
    entries: i64,
    skipped: i64,
}
aud_ws_key = (mp: MutPtr<Malloc>, path: string_view, line: i64, msg: string_view) string_view {
    mp
        .gstr_string(96)
        .gstr_append(mp, path)
        .gstr_push(mp, ':')
        .push_int(mp, line)
        .gstr_push(mp, ':')
        .gstr_append(mp, msg)
        .gstr_finish(mp)
}
aud_ws_push = (ws: MutPtr<AudWs>, key: string_view, f: AudFinding) void {
    (ws.nd >= ws.dfs.len).then({
        grown := cbuf<AudWsF>(ws.mp, ws.dfs.len * 2)
        ws.dfs.loop((h, i, x) {
            grown[i] = x
        })
        ws.dfs = grown
    })
    ws.dfs[ws.nd] = AudWsF(
        key: key,
        f: f,
    )
    ws.nd = ws.nd + 1
}
aud_ws_pushi = (ws: MutPtr<AudWs>, f: AudFinding) void {
    (ws.ni >= ws.ifs.len).then({
        grown := cbuf<AudFinding>(ws.mp, ws.ifs.len * 2)
        ws.ifs.loop((h, i, x) {
            grown[i] = x
        })
        ws.ifs = grown
    })
    ws.ifs[ws.ni] = f
    ws.ni = ws.ni + 1
}
// pre-flight an entry candidate: the real loader exit(1)s on an unknown module, and ONE broken
// candidate must not kill the whole workspace sweep — probe the import closure with the same
// module_path mapping (mirrors cache_walk_one) and skip the entry when any module file is missing.
AudPre: {
    seen: String,
    ok: bool,
}
aud_pre_one = (
    mp: MutPtr<Malloc>,
    root: string_view,
    progdir: string_view,
    id: string_view,
    st: AudPre,
) AudPre {
    idn := mp.gstr_string(24).gstr_append(mp, id)
    st.seen.seen_name(idn).match ({
        true  => st,
        false => {
            next := AudPre(
                seen: st.seen.add_name(mp, idn),
                ok: st.ok,
            )
            contents_in(mp, mp.cache_module_path(root, progdir, id)).match ({
                .Ok(msrc) => mp.aud_pre_edges(root, progdir, mp.edges_of(msrc), next),
                .Err(e)   => AudPre(
                    seen: next.seen,
                    ok: false,
                ),
            })
        },
    })
}
aud_pre_edges = (
    mp: MutPtr<Malloc>,
    root: string_view,
    progdir: string_view,
    edges: [ImportEdge],
    st: AudPre,
) AudPre {
    cur := st
    edges.loop((lh, i, e) {
        cur = mp.aud_pre_one(root, progdir, e.module, cur)
    })
    cur
}
aud_pre_ok = (mp: MutPtr<Malloc>, root: string_view, path: string_view, src: string_view) bool {
    st := mp.aud_pre_edges(root, mp.dirname(path), mp.edges_of(src), AudPre(
        seen: mp.gstr_string(64),
        ok: true,
    ))
    st.ok
}
// analyze ONE workspace entry: fixpoint + embedded roots, then fold every reportable decl into the
// cross-entry union (live-anywhere wins) and scan each not-yet-seen module file's imports.
aud_ws_entry = (
    mp: MutPtr<Malloc>,
    root: string_view,
    path: string_view,
    src: string_view,
    ws: MutPtr<AudWs>,
) void {
    one: i64 := 1
    rp := mp.resolve_prog(root, path, src)
    (mp.report_no_if_resolved(rp, path, src) == 0).match ({
        true  => {
            raw := mp.parse_module(rp.flat)
            decls := mp.resolve_module(raw)
            (mp.report_check(raw, decls, rp, path, src) == 0).match ({
                true  => {
                    ws.entries = ws.entries + 1
                    c := mp.aud_analyze(rp, raw, decls)
                    ac := c.addr()
                    ac.aud_embed_roots(mp, rp, raw)
                    tails := mp.aud_live_tails(c)
                    raw.loop((h, i, d) {
                        d.aud_reportable().then({
                            nm := d.aud_decl_name()
                            dl := locate_diag(rp, d.aud_decl_pos(), 1, path, src)
                            msg := mp.aud_dead_msg(d.aud_decl_kind(), nm)
                            key := mp.aud_ws_key(dl.path, to_i64(dl.sp.line), msg)
                            c.aud_unreached(tails, nm).match ({
                                true  => (ws.idx.has(key) == false).then({
                                    ws.idx = ws.idx.put(mp, key, one).expect("audit: oom")
                                    ws.aud_ws_push(key, AudFinding(
                                        path: dl.path,
                                        line: to_i64(dl.sp.line),
                                        msg: msg,
                                        dead: true,
                                    ))
                                }),
                                false => {
                                    ws.live = ws.live.put(mp, key, one).expect("audit: oom")
                                },
                            })
                        })
                    })
                    tms := mp.aud_tms(raw)
                    rp.table.modules.loop((h, i, m) {
                        (ws.mods.has(m.path) == false).then({
                            ws.mods = ws.mods.put(mp, m.path, one).expect("audit: oom")
                            scratch := cbuf<AudFinding>(mp, 4096)
                            k := mp.aud_mod_imports(m, tms, scratch, 0)
                            j := 0
                            @while (j < k) {
                                ws.aud_ws_pushi(scratch[j])
                                j = j + 1
                            }
                        })
                    })
                },
                false => {
                    ws.skipped = ws.skipped + 1
                },
            })
        },
        false => {
            ws.skipped = ws.skipped + 1
        },
    })
}
audit_ws_cmd = (mp: MutPtr<Malloc>, root: string_view, dir: string_view, strict: bool) i32 {
    seedv: i64 := 0 - 1
    wfc := AudWsFiles(
        mp: mp,
        fs: cbuf<string_view>(mp, 64),
        n: 0,
    )
    wf := wfc.addr()
    mp.aud_walk_tree(dir, wf)
    wfc.fs.aud_sortp(wfc.n)
    wsc := AudWs(
        mp: mp,
        live: of(mp, "", seedv).expect("audit: oom"),
        idx: of(mp, "", seedv).expect("audit: oom"),
        mods: of(mp, "", seedv).expect("audit: oom"),
        dfs: cbuf<AudWsF>(mp, 256),
        nd: 0,
        ifs: cbuf<AudFinding>(mp, 64),
        ni: 0,
        entries: 0,
        skipped: 0,
    )
    ws := wsc.addr()
    k := 0
    @while (k < wfc.n) {
        p := wfc.fs[k]
        contents_in(mp, p).match ({
            .Ok(s)  => s.aud_has_main().then({
                mp.aud_pre_ok(root, p, s).match ({
                    true  => mp.aud_ws_entry(root, p, s, ws),
                    false => {
                        ws.skipped = ws.skipped + 1
                    },
                })
            }),
            .Err(e) => { },
        })
        k = k + 1
    }
    say(mp
        .gstr_string(64)
        .gstr_append(mp, "zen audit --workspace: ")
        .push_int(mp, wsc.entries)
        .gstr_append(mp, " entries analyzed, ")
        .push_int(mp, wsc.skipped)
        .gstr_append(mp, " skipped")
        .gstr_finish(mp))
    // survivors: dead candidates no entry proved live, then the per-file import findings.
    fb := cbuf<AudFinding>(mp, wsc.nd + wsc.ni)
    n := 0
    i := 0
    @while (i < wsc.nd) {
        x := wsc.dfs[i]
        (wsc.live.has(x.key) == false).then({
            fb[n] = x.f
            n = n + 1
        })
        i = i + 1
    }
    i = 0
    @while (i < wsc.ni) {
        fb[n] = wsc.ifs[i]
        n = n + 1
        i = i + 1
    }
    mp.aud_emit(fb, n, strict)
}
// `zenc audit <file.zen> [--strict]` — check first (a broken program cannot be audited), then run
// the dead-code + unused-import analysis. Exit 0 always (advisory); `--strict` exits 1 on findings.
// `zenc audit --workspace <dir> [--strict]` unions dead-code across every entry under <dir>.
audit_cmd = (
    mp: MutPtr<Malloc>,
    root: string_view,
    a2: string_view,
    a3: string_view,
    a4: string_view,
) i32 {
    (a2 == "--workspace").then({
        (a3 == "").then({
            derr("usage: zenc audit --workspace <dir> [--strict]\n")
            return 2
        })
        return mp.audit_ws_cmd(root, a3, a4 == "--strict")
    })
    strict := a2 == "--strict" || a3 == "--strict"
    path := (a2 == "--strict").then({ a3 }, { a2 })
    (path == "").then({
        derr("usage: zenc audit <file.zen> [--strict]\n")
        return 2
    })
    contents_in(mp, path).match ({
        .Ok(src) => {
            rp := mp.resolve_prog(root, path, src)
            (mp.report_no_if_resolved(rp, path, src) == 0).match ({
                true  => {
                    raw := mp.parse_module(rp.flat)
                    decls := mp.resolve_module(raw)
                    (mp.report_check(raw, decls, rp, path, src) == 0).match ({
                        true  => mp.aud_run(rp, raw, decls, path, src, strict),
                        false => 1,
                    })
                },
                false => 1,
            })
        },
        .Err(e)  => {
            derr("zenc: cannot open input: ")
            derr(path)
            derr("\n")
            1
        },
    })
}
