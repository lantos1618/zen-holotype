// Capability root supplied to `main`; there is no ambient I/O or allocation.

Alloc, Mem = std.mem
Vec = std.collections
str, String = std.text
HttpClient = std.net.http

Actor, Ref, ActorStartError = std.actor.actor_core
ProcError, ProcOutput, Process = std.proc

ArgError* = Missing(str) | Parse(str)

Console* = {
    println* = (self: @Self, fmt: str, args: ...) Res<(), IoError>
    flush* = (self: @Self) Res<(), IoError>
    errorln* = (self: @Self, fmt: str, args: ...) Res<(), IoError>
}

// Byte-oriented standard input. `read` fills caller-reserved Vec capacity and
// blocks until `n` bytes are read or end-of-input is reached. Zero indicates
// end-of-input.
Stdin* = {
    read* = (self: @Self, buf :: Vec<u8>, n: usize) Res<usize, IoError>
}

FsError* = NotFound       // nothing is at that path
         | Denied         // something is, and this process may not read it
         | IsDir          // the path names a directory, and a directory is not bytes
         | Exists         // something is already locked at that path
         | Failed         // the read started and did not finish
         | OutOfMemory    // the buffer could not be obtained

fs_message* = (error: FsError) str {
    error.match({
        NotFound    => "nothing is at that path",
        Denied      => "this process may not read it",
        IsDir       => "the path names a directory, and a directory is not bytes",
        Exists      => "something is already locked at that path",
        Failed      => "the read started and did not finish",
        OutOfMemory => "the buffer could not be obtained",
    })
}

Fs* = {
    // Read the complete file into memory owned by `a`. UTF-8 is not checked.
    read* = (self: @Self, a: Alloc, path: str) Res<String, FsError>

    // An inaccessible or unstatable path answers false.
    exists* = (self: @Self, path: str) bool
    is_dir* = (self: @Self, path: str) bool

    // Write one complete file. The bytes remain owned by the caller.
    write* = (self: @Self, path: str, bytes: str) Res<(), FsError>

    // Remove a file. True means a file was removed; false means none existed.
    remove* = (self: @Self, path: str) Res<bool, FsError>

    // Acquire an exclusive process lock until the returned Lock is released.
    lock* = (self: @Self, path: str) Res<Lock, FsError>
}

// Exclusive filesystem lock. It is non-copyable and releases on drop.
Lock* = {
    fd: i32,

    // Release before scope exit and consume the Lock.
    unlock* = (self :: @Self) ()
}

Lock.impl(Drop, {
    drop = (self :: @Self) () { self.unlock() }
})

Net* = {
    http* = (self: @Self, a: Alloc) HttpClient {
        HttpClient()
    }
}

ThreadError* = SpawnFailed | Panicked

Thread* = {
    id: u64,
    join* = <T>(self: @Self) Res<T, ThreadError>
}

// Thread capability for FFI and batch work. Spawned closures escape their
// creator and therefore require their own allocator. Blocking inside an actor
// behavior also blocks its scheduler thread.
Threads* = {
    spawn* = <T>(self: @Self, a: Alloc, body: () Res<T, ThreadError>) Res<Thread, ThreadError>

    sleep* = (self: @Self, ms: u64) ()
}

// `since_start` is monotonic and suitable for measuring intervals; `unix` is
// wall-clock time since the Unix epoch.
Clock* = {
    since_start* = (self: @Self) Duration
    unix*        = (self: @Self) Duration
}

Env* = {
    argv*: Vec<str>,
    out*: Console,
    in*: Stdin,
    mem*: Mem,
    fs*: Fs,
    net*: Net,
    proc*: Process,
    threads*: Threads,
    clock*: Clock,

    // Borrow an environment variable. An unset variable returns None.
    var* = (self: @Self, name: str) Res<str>

    // Decode CLI arguments into a schema struct. Flags override environment
    // variables; Res fields and fields with defaults are optional.
    args* = <T>(self: @Self) Res<T, ArgError>

    // Spawn an actor whose mailbox and memory are owned by the runtime.
    spawn* = <A: Actor>(self: @Self, actor: A) Res<Ref<A>, ActorStartError>
}
