// Errors are values: fallible code returns Result<T, E>, optional code returns Opt<T>.
// panic is reserved for invariant breaks.
Result*<T, E>: Ok(T) | Err(E)
Opt*<T>: Some(T) | None
// Common error carrier for libc/POSIX wrappers.
IoError*: NotFound | Denied | Eof | Errno(i32)
// Generic Result constructors. The type params bind from the EXPECTED type at the call site (function
// return position, a `let x: Result<…> :=` annotation, or a match arm whose match has an expected type),
// so `ok(x)`/`err(e)` replace the per-type `_ok`/`_err` shims. `T` may also bind from `x`'s own type.
ok*<T, E> = (x: T) Result<T, E> { .Ok(x) }
err*<T, E> = (e: E) Result<T, E> { .Err(e) }
// panic's minimal libc surface.
{ abort, write, strlen } = std.c.libc
PANIC_STDERR_FD = 2
// Bodyless FFI decl for the runtime's panic unwinder — the symbol lives in bootstrap/zenrt.c (like
// std.concurrent.pool's `__zen_actor_call`), and every generated C module also carries a WEAK empty
// definition in the genc preamble, so a standalone program that never links zenrt.c still resolves it
// (to a no-op that returns). It siglongjmps into the pool worker's per-behavior catch when one is
// installed, and RETURNS when none is — which is exactly what makes the `abort()` below unconditional.
__zen_panic_unwind = () void
// Converts a libc integer sentinel into Result.
ok_if* = (rc: i32) Result<i32, IoError> { (rc >= 0).then({ .Ok(rc) }, { .Err(.Errno(rc)) }) }
// Like ok_if, but yields a DIFFERENT ok-value `v` (already computed) instead of the sentinel itself:
// a non-negative `rc` -> `.Ok(v)`, a negative one -> `.Err(.Errno(rc))`. Collapses the hand-rolled
// `(rc < 0).match({ true => .Err(.Errno(rc)), false => .Ok(v) })` that syscall wrappers repeat. `v` is
// evaluated eagerly, so only use it where the ok-value is ready before the check (no side effects between).
errno_or*<T> = (rc: i32, v: T) Result<T, IoError> {
    (rc >= 0).then({ .Ok(v) }, { .Err(.Errno(rc)) })
}
// Converts a nullable libc pointer into Result.
ok_ptr* = (p: RawPtr<u8>) Result<RawPtr<u8>, IoError> {
    (p == null_ptr()).then({ .Err(.NotFound) }, { .Ok(p) })
}
// Explicit abort for impossible states. panic owns the framing so every give-up site prints
// exactly like the compiler's runtime panics (div-zero/OOB guards in the genc preamble):
// `zen: panic: <msg>` + newline on stderr, then unwind-or-abort.
//
// SUPERVISABILITY: the unwind call is what makes an `.expect` failure behave like a compiler panic. The
// genc preamble's `zen__panic` (div-zero, OOB index, salloc OOM) prints, calls `__zen_panic_unwind()`,
// then aborts; this one used to abort DIRECTLY. Inside an actor that difference was the whole ballgame —
// a divide by zero was caught by the worker (actor dead, pool alive, supervisor restarts), while an
// allocation failure killed the PROCESS. Since nearly every `.expect` in std is an allocation failure,
// out-of-memory was the one failure a supervisor could not survive. Now both paths unwind identically.
// OUTSIDE an actor `__zen_panic_unwind` finds no jump buffer and simply returns, so `abort()` still runs
// and the non-actor path is byte-identical (pinned by the result_expect_panics fixture, exit 134).
panic* = (msg: StringView) void {
    prefix = "zen: panic: "
    pn = prefix.strlen()
    PANIC_STDERR_FD.write(prefix.slice(pn).ptr, pn)
    n = msg.strlen()
    PANIC_STDERR_FD.write(msg.slice(n).ptr, n)
    newline = "\n"
    nn = newline.strlen()
    PANIC_STDERR_FD.write(newline.slice(nn).ptr, nn)
    __zen_panic_unwind()
    abort()
}
// Human-readable variant name of a just-caught IoError, so error paths can PRINT what
// happened instead of swallowing it: `println(e.name())`, or interpolated —
// `formatln("read failed: {}", [arg_str(e.name())])`. The payload of `.Errno` is not
// rendered (a str is comptime bytes; no allocator flows here) — match on `.Errno(code)`
// when the number matters.
name* = (e: IoError) StringView { e.variant_name() }
// ── Result combinators (UFCS: `r.expect("…")`, `r.or(fallback)`) ─────────────────────────────────
// Ok payload, or PANIC with `msg` (framed as `zen: panic: <msg>` + newline, then abort). The message is
// MANDATORY — there is deliberately NO bare `unwrap`: every give-up site names its invariant.
expect*<T, E> = (r: Result<T, E>, msg: StringView) T {
    r.match ({
        .Ok(v)  => v,
        .Err(e) => {
            panic(msg)
            // unreachable — panic aborts; the recursion only satisfies the arm's type.
            r.expect(msg)
        },
    })
}
// Ok payload, or `default`.
or*<T, E> = (r: Result<T, E>, default: T) T {
    r.match ({
        .Ok(v)  => v,
        .Err(e) => default,
    })
}
// Ok payload, or `on_err(err)` — lazy fallback that can inspect the error.
or_else*<T, E> = (r: Result<T, E>, on_err: (E) T) T {
    r.match ({
        .Ok(v)  => v,
        .Err(e) => on_err(e),
    })
}
// Map the error channel, leaving Ok untouched: Result<T, E> → Result<T, F>.
map_err*<T, E, F> = (r: Result<T, E>, on_err: (E) F) Result<T, F> {
    r.match ({
        .Ok(v)  => .Ok(v),
        .Err(e) => .Err(on_err(e)),
    })
}
// Map the Ok channel, leaving Err untouched: Result<T, E> → Result<U, E>.
map*<T, E, U> = (r: Result<T, E>, f: (T) U) Result<U, E> {
    r.match ({
        .Ok(v)  => .Ok(f(v)),
        .Err(e) => .Err(e),
    })
}
// Monadic bind: chain a fallible step on the Ok channel. Ok(v) → f(v) (itself a Result),
// Err passes through. E is shared across the chain, so the steps agree on their error type.
and_then*<T, E, U> = (r: Result<T, E>, f: (T) Result<U, E>) Result<U, E> {
    r.match ({
        .Ok(v)  => f(v),
        .Err(e) => .Err(e),
    })
}
// Map the Ok payload to U, or fall back to `default` on Err. Collapses to a plain U
// (no Result wrapper) — the eager cousin of `map` then `or`.
map_or*<T, E, U> = (r: Result<T, E>, default: U, f: (T) U) U {
    r.match ({
        .Ok(v)  => f(v),
        .Err(e) => default,
    })
}
// ── Opt mirrors (flat namespace has no overloading, so the names carry the type) ─────────────────
// Some payload, or PANIC with `msg` (same contract as expect; no bare unwrap here either).
expect_some*<T> = (o: Opt<T>, msg: StringView) T {
    o.match ({
        .Some(v) => v,
        .None    => {
            panic(msg)
            // unreachable — panic aborts; the recursion only satisfies the arm's type.
            o.expect_some(msg)
        },
    })
}
// Some payload, or `default`.
some_or*<T> = (o: Opt<T>, default: T) T {
    o.match ({
        .Some(v) => v,
        .None    => default,
    })
}
// Some payload, or `fallback()` — lazy fallback (no error payload to pass, unlike or_else).
some_or_else*<T> = (o: Opt<T>, fallback: () T) T {
    o.match ({
        .Some(v) => v,
        .None    => fallback(),
    })
}
// map_err has no Opt mirror: Opt carries no error channel to map. The bridge is ok_or:
// Opt<T> → Result<T, E>, tagging None with the caller's error value.
ok_or*<T, E> = (o: Opt<T>, e: E) Result<T, E> {
    o.match ({
        .Some(v) => .Ok(v),
        .None    => .Err(e),
    })
}
// Map the Some channel, leaving None untouched: Opt<T> → Opt<U>.
map_some*<T, U> = (o: Opt<T>, f: (T) U) Opt<U> {
    o.match ({
        .Some(v) => .Some(f(v)),
        .None    => .None,
    })
}
// Monadic bind for Opt: Some(v) → f(v) (itself an Opt), None passes through.
and_then_some*<T, U> = (o: Opt<T>, f: (T) Opt<U>) Opt<U> {
    o.match ({
        .Some(v) => f(v),
        .None    => .None,
    })
}
// Map the Some payload to U, or fall back to `default` on None (eager `map_some` then `some_or`).
map_or_some*<T, U> = (o: Opt<T>, default: U, f: (T) U) U {
    o.match ({
        .Some(v) => f(v),
        .None    => default,
    })
}
