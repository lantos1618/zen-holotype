// `@scope` is non-escaping. storing it in a struct is the first of
// the three ways out, and the struct could outlive the block whose
// defer stack it points at.
//
// passing it INWARD stays legal — corpus/own/scope_passed_inward.zen.

Holder = {
    s: Scope,
}

main = (env: Env) Res<i32, IoError> {
    h = Holder(s: @scope);
    h.s.defer(() { println("goodbye") });
    Ok(0);
}
