// The other half of impl_body_method_wrong_return: nothing in sema
// walked an impl body, so LOWERING was the first pass to reach one and
// a plain undefined name came back as `codegen cannot resolve` — a
// diagnostic in the wrong voice, from the wrong pass, and only for the
// impls that were reachable enough to lower.
//
// position: the name that resolves to nothing.

Boxy = {
    width: i32,
    height: i32,

    area* ::= (self: @Self) i32 { self.width * self.height }
}

Tile = {
    side: i32,
}

Tile.impl(Boxy, {
    width: self.side,
    height: self.side,

    area = (self: @Self) i32 { nowhere }
})

main = (env: Env) Res<i32, AllocError> {
    println("{}", Tile(side: 2).area());
    Ok(0);
}
