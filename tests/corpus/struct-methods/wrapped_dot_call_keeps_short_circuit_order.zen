// A wrapped method callee still contributes its receiver slot. If it did
// not, the held tick would escape the short-circuit and increment `b`.

Counter = {
    n :: i32,

    tick = (self :: @Self) i32 {
        was    = self.n;
        self.n = self.n + 1;
        was;
    }

    accepts = (self :: @Self, value: i32) bool { value >= self.n; }
}

main = (env: Env) Res<i32, AllocError> {
    a ::= Counter(n: 0);
    println("direct  {} {}", false && a.accepts(a.tick()), a.n);

    b ::= Counter(n: 0);
    println("wrapped {} {}", false && (b.accepts)(b.tick()), b.n);
    Ok(0);
}
