// std.mem.raw's bulk byte ops: copy / move / set / compare, each including its zero-length edge.
// The load-bearing case is move_overlap_ok — the one thing `copy` may NOT do.
raw = std.mem.raw
{ copy, move, set, compare } = std.mem.raw
{ view } = std.text.str
{ to_exit } = std.core.bool
scratch = (seed: StringView) MutSlice<u8> {
    b: MutSlice<u8> = raw.alloc(6).slice(6)
    b.ptr.copy(seed.view().ptr, 6)
    b
}
same = (b: MutSlice<u8>, want: StringView) bool { b.ptr.compare(want.view().ptr, 6) == 0 }
copy_ok = () bool {
    d = scratch("zzzzzz")
    d.ptr.copy("abcdef".view().ptr, 6)
    hit = d.same("abcdef")
    d.ptr.set('z', 6)
    d.ptr.copy("abcdef".view().ptr, 0)    // zero length writes nothing
    zero_len = d.same("zzzzzz")
    raw.release(d.ptr)
    hit && zero_len
}
move_overlap_ok = () bool {
    up = scratch("abcdef")
    up.ptr.offset(1).move(up.ptr, 5)    // slide right one slot — dst and src overlap
    right = up.same("aabcde")
    down = scratch("abcdef")
    down.ptr.move(down.ptr.offset(1), 5)    // slide left one slot
    left = down.same("bcdeff")
    down.ptr.move(down.ptr.offset(1), 0)
    zero_len = down.same("bcdeff")
    raw.release(up.ptr)
    raw.release(down.ptr)
    right && left && zero_len
}
set_ok = () bool {
    b = scratch("abcdef")
    b.ptr.set('q', 3)
    hit = b.same("qqqdef")
    b.ptr.set('w', 0)
    zero_len = b.same("qqqdef")
    raw.release(b.ptr)
    hit && zero_len
}
compare_ok = () bool {
    a = scratch("abcdef")
    b ::= scratch("abcdef")
    eq = a.ptr.compare(b.ptr, 6) == 0
    b[5] = 'g'
    lt = a.ptr.compare(b.ptr, 6) < 0
    gt = b.ptr.compare(a.ptr, 6) > 0
    zero_len = a.ptr.compare(b.ptr, 0) == 0    // zero length compares equal
    raw.release(a.ptr)
    raw.release(b.ptr)
    eq && lt && gt && zero_len
}
main = () i32 { (copy_ok() && move_overlap_ok() && set_ok() && compare_ok()).to_exit() }
