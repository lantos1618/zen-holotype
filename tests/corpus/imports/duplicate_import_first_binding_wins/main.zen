// The same name imported TWICE from two modules that both declare it.
// This is not the overload case: nothing distinguishes the two `cap`s
// but which import line they came from, and both are plain u64
// constants, so no receiver can deal them out. What actually happens
// is observable and worth pinning: the FIRST binding survives, and the
// second import line is dead.
//
// The two values differ in every digit (111... vs 999...) so a change
// from first-wins to last-wins, or to a collision error, is loud. If
// the rule ever changes deliberately, this test is the one that says
// so in the diff -- and until then it guards against a resolver whose
// answer depends on module WALK order rather than source order.
//
// One-line breaker: resolve duplicate bare imports by walk order
// instead of declaration order -> 999999999999999.

cap = alpha.alpha
cap = beta.beta

main = (env: Env) Res<i32, IoError> {
    println("{}", cap);
    Ok(0);
}
