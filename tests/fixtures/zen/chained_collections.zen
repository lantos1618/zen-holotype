// Regression: the ambient collection wrappers must survive CHAINED struct-returning ops
// (`m.put(...).put(...)`, `s.add(...).add(...)`, `v.push(...).push(...)`). A chained receiver
// is a side-effecting temporary; the wrapper must evaluate it EXACTLY ONCE (it binds `ww = w`
// first). Before the fix, referencing the receiver 3× made the inliner re-execute the chained
// receiver exponentially — AHMap.put/ASet.add re-ran the non-idempotent hash-chain `link`
// (self-cycle → hang / slice-OOB), and AVec.push hung on long chains. Chains here are long
// enough to force several grows.
{ println } = std.io.print
{ upto } = std.core.count
vec = std.collections.vec
set = std.collections.set
hmap = std.collections.hmap
{ AVec } = std.collections.vec
{ ASet } = std.collections.set
{ AHMap } = std.collections.hmap
main = () i32 {
    // ── AVec: chained push through multiple grows ──
    v ::= vec.from([0])
    v = v
        .push(1)
        .push(2)
        .push(3)
        .push(4)
        .push(5)
        .push(6)
        .push(7)
        .push(8)
        .push(9)
    vok ::= 1
    0.upto(10, (i) {
        (v.get(i) == i == false).then({
            vok = 0
        })
    })
    println(vok)    // 1  (all indices correct)
    println(v.len())    // 10
    // ── ASet: chained add through grows, contains-all ──
    s ::= set.from([100])
    s = s
        .add(101)
        .add(102)
        .add(103)
        .add(104)
        .add(105)
        .add(106)
        .add(107)
        .add(108)
    sok ::= 1
    100.upto(109, (j) {
        (s.has(j) == false).then({
            sok = 0
        })
    })
    println(sok)    // 1  (contains all)
    println(s.len())    // 9
    // ── AHMap: chained put through grows, get-all ──
    m ::= hmap.from(0, 0)
    m = m
        .put(1, 10)
        .put(2, 20)
        .put(3, 30)
        .put(4, 40)
        .put(5, 50)
        .put(6, 60)
        .put(7, 70)
    mok ::= 1
    0.upto(8, (k) {
        (m.get_or(k, 0 - 1) == k * 10 == false).then({
            mok = 0
        })
    })
    println(mok)    // 1  (all values correct)
    println(m.len())    // 8
    // ── short chains from the bug report (grow-boundary) ──
    m2 :: AHMap<StringView, i64> = hmap.new()
    m2 = m2.put("k1", 11).put("k2", 22)
    println(m2.get_or("k1", 0))    // 11
    println(m2.get_or("k2", 0))    // 22
    s2 :: ASet<i64> = set.new()
    s2 = s2.add(7).add(8).add(9)
    println(s2.len())    // 3
    v.free()
    s.free()
    m.free()
    m2.free()
    s2.free()
    0
}
