// compiler.astops — AST-node query traits, extracted from compiler.genc.
// These predicates were free functions on Ty/Func/Decl/StructDecl (the AST node types defined
// in compiler.genc). Grouping each into a trait IMPL'd on its receiver type (an out-of-module
// impl: the types live in compiler.ast.ast_types) lets cross-module callers dispatch `t.is_fnt()`,
// `f.is_generic_fn()`, `d.is_template()`, `d.is_trait()` &c. by UFCS through the GLOBAL IMPL
// INDEX — so callers need NEITHER the method names NOR the trait imported, and the long
// `= compiler.genc` import lists simply shrink. Each method is emitted as a distinct mangled C
// function (`impl_<Trait>_<Ty>_<m>`), so unlike same-named free functions they never collide in
// the flat C namespace. Sibling methods call each other by UFCS (`f.is_generic_fn()`), routed the
// same way. The impl blocks live here, never in compiler.genc (which is imported by nearly
// everything). This file imports ONLY compiler.ast.ast_types, compiler.genc, std.text.string and
// std.mem.alloc, and none of those reach back here — so it can never sit inside an import cycle no
// matter how many modules import it, which is what keeps it clear of the dup-impl-in-cycle trap.
// That also makes it the natural OWNER for the small AST predicates/builders individual passes
// would otherwise each define for themselves (field_in, param_names_has, is_logic_op, one_stmt, …).
//
// Only plain-named-value receivers are method-ified: the language does not support `.impl` on
// pointer/slice receiver types, so genc's Ptr<Expr>/[Stmt] predicates (is_expr_null, blk_diverges,
// stmts_diverge) necessarily stay free functions in compiler.genc.
{ Ty, Func, Decl, Field, StructDecl, Param, BinData, CallData, MethodCallData, Expr, Stmt } = compiler.ast.ast_types
{ sbyte, gstr_push, cbuf, dglobal_full, slett_atm, tvoid } = compiler.genc
{ String } = std.text.string
{ Malloc } = std.mem.alloc
{ expr_fold_children } = compiler.ast.expr_children
// a function type marks a TEMPLATE parameter: a function with one is inlined at each call site
// (compiler.check splices it), never emitted as a C function — so genModule skips it.
TyQuery*: {
    is_fnt: (Self) bool,
}
Ty.impl(TyQuery, {
    is_fnt = (t: Ty) bool {
        t.match ({
            .FnT(f) => true,
            _       => false,
        })
    }
})
// has_fnt_param lives here (not in compiler.genc) because it calls the Ty::is_fnt trait method; keeping
// it beside the impl means compiler.genc — imported by user programs (via std.internal.ast, std.io.c) —
// carries NO reference to a method defined outside its own closure. It stays a free function (its
// receiver `[Param]` is a slice type, which the language cannot carry a trait impl on).
// the declared type of field `fname`, or Void when the struct has no such field — the shared
// struct-field lookup behind generic field reads, ownership's struct-literal gate and arg fitting.
field_in* = (fields: [Field], fname: StringView) Ty {
    found ::= tvoid()
    fields.loop((h, i, fl) {
        found = (fl.name == fname).then({ fl.ty }, { found })
    })
    found
}
// the number of elements in an AST slice — the C and JS backends both size a slice literal with it.
slice_count* = (items: [Expr]) i32 {
    n ::= 0
    items.loop((h, i, it) {
        n = n + 1
    })
    n
}
// is `name` one of `ps`? the shared param/field-name membership test — every "does this fn/impl
// declare X?" question in the pipeline is this one predicate: tparam membership (check, check_infer,
// check_inline, validate.util), impl-method presence (check_desugar, validate.kinds/enrich), the
// parser's implicit-tparam pass, and the formatter's export/tparam markers.
param_names_has* = (ps: [Param], name: StringView) bool {
    found ::= false
    ps.loop((h, i, p) {
        found = found || p.name == name
    })
    found
}
// the narrow int/float widths arrive as Named("u32") etc. (no Ty variant), but they ARE valid
// primitives that genc lowers to C types — so every "is this type name known?" gate must treat them
// as KNOWN: the unknown-type validator and check_resolve's or-return concreteness gate alike.
is_prim_width* = (n: StringView) bool {
    n == "i8" || n == "i16" || n == "u16" || n == "u32" || n == "u64" || n == "f32"
}
// `&&`/`||` — the operators whose RIGHT operand is CONDITIONALLY evaluated. The or-return hoist
// (check_resolve, passes.orreturn) and the kind checker both branch on exactly this set.
is_logic_op* = (op: StringView) bool { op == "&&" || op == "||" }
// the FREE-FUNCTION `or_return(x)` form (the method form is `x.or_return()`, a MethodCall): the
// hoist counter/rewriter and the kind checker each ask whether a Call node is one.
is_or_return_fn* = (c: CallData) bool { c.fn == "or_return" && c.args.len == 1 }
// a one-statement body — `[Stmt]` of length 1. Statement lowering (check_lower), the or-return
// rebuild (check_resolve) and reflection dispatch (passes.subst) all wrap a single Stmt this way.
one_stmt* = (a: MutPtr<Malloc>, st: Stmt) [Stmt] {
    buf ::= cbuf<Stmt>(a, 1)
    buf[0] = st
    buf
}
// a lambda body's statements MINUS the parser's implicit trailing `return`. Every fn/lambda body ends
// in a `.Return` the parser synthesized from the trailing expression; for a LAMBDA that return is the
// lambda's VALUE — handed to the call site, which decides what becomes of it — not a return from the
// enclosing function. A walker that descends into a lambda body while asking "does this function
// return X" must therefore skip it; every EARLIER return does hoist into the caller (the lambda is
// inlined there) and stays checked.
lam_stmt_body* = (body: [Stmt]) [Stmt] {
    n = body.len
    (n == 0).match ({
        true  => body,
        false => body[n - 1].match ({
            .Return(r) => slice(body.ptr, n - 1),
            _          => body,
        }),
    })
}
has_fnt_param* = (ps: [Param]) bool {
    found ::= false
    ps.loop((h, i, p) {
        found = p.ty.is_fnt().then({ true }, { found })
    })
    found
}
// a TEMPLATE: a fn inlined/monomorphized per call site — has an FnT param (a lambda to splice) or
// type params (to substitute). It must have a BODY to inline; a BODYLESS fn (an extern like
// makecontext, with an FnT param for a real C function-pointer arg) is a normal callable, NOT a
// template to inline away.
FuncQuery*: {
    is_generic_fn: (Self) bool,
}
Func.impl(FuncQuery, {
    is_generic_fn = (f: Func) bool {
        (f.params.has_fnt_param() || f.tparams.len > 0) && f.body.len > 0
    }
})
// a TRAIT is written as a struct whose fields are method signatures (FnT types). It has no runtime
// representation in the monomorphic/inline model — the impl methods are plain functions — so
// genModule skips it, exactly like a template function. NOTE: a data struct holding a function-
// VALUE field (a closure) is ALSO all-/some-FnT-shaped and indistinguishable here by shape alone;
// the emit pipeline (c_emit) disambiguates by USAGE — a constructed struct is real, a trait is
// only impl'd, never constructed — via `struct_is_trait_emit`.
StructDeclQuery*: {
    struct_is_trait: (Self) bool,
}
StructDecl.impl(StructDeclQuery, {
    struct_is_trait = (sd: StructDecl) bool {
        found ::= false
        sd.fields.loop((h, i, f) {
            found = f.ty.is_fnt().then({ true }, { found })
        })
        found
    }
})
// is_template / is_trait classify a top-level Decl by its kind (template function or trait struct).
DeclQuery*: {
    is_template: (Self) bool,
    is_trait: (Self) bool,
}
Decl.impl(DeclQuery, {
    is_template = (d: Decl) bool {
        d.match ({
            .DFunc(f) => f.is_generic_fn(),
            _         => false,
        })
    }
    is_trait = (d: Decl) bool {
        d.match ({
            .DStruct(sd) => sd.struct_is_trait(),
            _            => false,
        })
    }
})
// ── decimal-integer emission (consolidated from ~16 re-rolled copies across the backends) ──────────
// One digit-char lookup and one "emit a non-negative integer's decimal digits into a String" recursion,
// formerly copy-pasted under many names — ddigit/di_digit/ffdigit/digit/jdigit/pf_digit/lift_digit for
// the char; dnum/gstr_i64/gen_uint_nat/ff_uint_nat/jint_nat/orx_digits/lift_digits for the String sink.
// Byte-identical output is load-bearing: these render diagnostic line/col numbers, emitted C/JS integer
// literals, pretty-printed numbers, or_return/lifted-lambda indices, and mangled C symbol fragments — a
// single changed digit breaks output or the ABI. Lives here (a low, widely-imported shared module) so
// every backend routes through the same code; no import cycle (genc/std string+alloc never import this).
//
// This trio is the COMPILER-side digit loop — one of exactly TWO tree-wide. The other lives in
// std.text.num (RawPtr buffer writers backing std.text.fmt's streaming output). Two, not one, is the
// SEED-CLOSURE boundary: compiler passes rendering line/col digits (check, compiler.resolve,
// diagnostics) must not pull std.text.num's module closure (Result/IoError/alloc/parse) into the
// self-hosting seed, and user-facing std must not import compiler internals. Everything else
// (check's vis_key, resolve's res_udec, fmt's write_int family) delegates to one of the two.
dec_digit* = (d: i64) u8 { sbyte("0123456789", d) }
// The unsigned recursion. `n` is u64 so a `.Int` literal above i64-max (real negatives are `0 - x` Bin
// nodes, never a negative `.Int`) renders in its full unsigned range; non-negative i64 callers pass
// value-preservingly (u64 treated leniently by the checker; C widens int64→uint64 for a non-negative n).
gstr_uint* = (out: String, a: MutPtr<Malloc>, n: u64) String {
    (n < 10).match ({
        true  => out.gstr_push(a, dec_digit(to_i64(n))),
        false => {
            // hoist the recursive call: a <call>.gstr_push receiver is re-evaluated by gstr_reserve (UAF)
            hs = out.gstr_uint(a, n / 10)
            hs.gstr_push(a, dec_digit(to_i64(n % 10)))
        },
    })
}
// The signed wrapper: reinterpret the i64 bit pattern as u64 and render unsigned — so a negative `.Int`
// (a u64 literal above i64-max) prints its exact bits as unsigned decimal, with NO minus sign. This is
// the genc/pretty semantics; the js backend's minus-sign form (jint/jint_neg) is deliberately kept
// separate (its INT64_MIN-safe negative walk cannot go through `-n`).
gstr_int* = (out: String, a: MutPtr<Malloc>, n: i64) String {
    u: u64 = n
    out.gstr_uint(a, u)
}
// map_slice: the pervasive cbuf-map idiom — allocate a fresh same-length `[U]` and fill slot i with
// f(xs[i]). One generic replaces ~100 hand-rolled `buf := cbuf<U>(a, xs.len)  xs.loop(...)  buf`
// blocks across the frontend. The alloc param is the concrete `MutPtr<Malloc>` cbuf itself takes.
map_slice*<T, U> = (a: MutPtr<Malloc>, xs: [T], f: (T) U) [U] {
    buf ::= cbuf<U>(a, xs.len)
    xs.loop((h, i, x) {
        buf[i] = f(x)
    })
    buf
}
// slice_any: the pervasive OR-fold — true iff some element satisfies p. One generic replaces ~50
// hand-rolled `f := false  xs.loop(...)  f` blocks. Walks the whole slice (no early break), so the
// visit order and count match the inlined form exactly.
slice_any*<T> = (xs: [T], p: (T) bool) bool {
    f ::= false
    xs.loop((h, i, y) {
        f = p(y).then({ true }, { f })
    })
    f
}
// ── leftmost source position of an Expr / Stmt (leftmost known byte offset; 0 = unknown) ─────────
// THE formatter's position concept, moved here from compiler.pretty (a pure AST query belongs at
// this low floor, not in the printer). It anchors comment interleaving, so it wants the LEFTMOST
// byte of the construct: a Bin reports its lhs (falling back to the op position), a MethodCall its
// receiver — and arms the printer deliberately treats as position-less (MakeStruct/SliceLit/Block/
// bare literals …) return 0, which means "defer" to the comment-flush logic (see the residual
// documented at compiler.pretty's gf_cond_open_cmt: a 0 keeps already-clean one-liners untouched).
// DISTINCT from compiler.validate.util's expr_pos/stmt_pos, the diagnostic CARET anchor — that one
// is op-position-first on Bin and has no MethodCall arm; the two families differ deliberately, so
// do NOT "unify" them into one function: a caret wants the operator, a comment wants the left edge.
expr_left_pos* = (e: Expr) i32 {
    e.match ({
        .Var(v)         => v.pos,
        .Bin(b)         => bin_left_pos(b),
        .Call(c)        => c.pos,
        .MethodCall(mc) => recv_left_pos(mc.recv, mc.pos),
        .StrLit(sl)     => sl.pos,
        .Member(m)      => left_pos_of(m.obj),
        .Arrow(ar)      => left_pos_of(ar.obj),
        .Match(m)       => left_pos_of(m.subj),
        .Cond(d)        => left_pos_of(d.c),    // a bool `.match` lowers to Cond — its subject is `c`
        .Index(ix)      => left_pos_of(ix.seq),
        _               => 0,
    })
}
bin_left_pos = (b: BinData) i32 {
    lp = left_pos_of(b.lhs)
    (lp > 0).then({ lp }, { b.pos })
}
recv_left_pos = (recv: Ptr<Expr>, fallback: i32) i32 {
    rp = left_pos_of(recv)
    (rp > 0).then({ rp }, { fallback })
}
left_pos_of* = (e: Ptr<Expr>) i32 { expr_left_pos(load(e)) }
stmt_left_pos* = (st: Stmt) i32 {
    st.match ({
        .Let(l)      => (l.pos > 0).then({ l.pos }, { left_pos_of(l.value) }),
        .Assign(asn) => asn.pos,
        .Return(e)   => left_pos_of(e),
        .ExprStmt(e) => left_pos_of(e),
        .IndexSet(x) => x.pos,
        _            => 0,
    })
}
// ── wr_*: "does this body WRITE variable `nm`?" (the rc_calls_body walker family shape) ──────────
// Used by the inliner's argument binding (compiler.check.bind_args): a template param the body
// assigns to must be bound to a TEMP COPY before splicing — otherwise the callee's writes land on
// the caller's argument (value-semantics violation, #585). Write forms counted: a direct/place
// assignment rooted at `nm` (`nm = …`, `nm.f = …`, `nm[i] = …`), an IndexSet rooted at `nm`, and a
// reflection expansion whose SUBJECT roots at `nm` with a lambda that assigns its value param
// (each_field/zip_fields substitute the subject's fields as the lambda's assignable places). A
// `let` re-binding of `nm` is NOT tracked (shadowed writes still count) — over-binding only costs
// a temp; under-binding is the unsound direction. Lives here (not passes.refcount, the family's
// home) because refcount imports compiler.check — the walker must sit BELOW check in the import
// order.
// root variable name of a place expression (`a.b.c[i]` → "a"); "" when not rooted at a plain Var.
wr_root_name* = (e: Ptr<Expr>) StringView {
    load(e).match ({
        .Var(v)    => v.name,
        .Member(m) => m.obj.wr_root_name(),
        .Arrow(ar) => ar.obj.wr_root_name(),
        .Index(ix) => ix.seq.wr_root_name(),
        _          => "",
    })
}
// does a reflection lambda literal assign one of its VALUE params (index >= 1; index 0 is the
// field-name string)? Those params substitute to member PLACES of the subject — an assignment
// through one is a write to the subject's field.
wr_lam_writes_value* = (e: Expr) bool {
    e.match ({
        .Lambda(la) => {
            f ::= false
            la.params.loop((h, i, p) {
                f = (i >= 1 && la.body.wr_writes_name(p.name)).then({ true }, { f })
            })
            f
        },
        _           => false,
    })
}
// an each_field/zip_fields call whose SUBJECT roots at `nm` and whose lambda assigns its value
// param: the expansion writes `nm`'s fields.
wr_refl_writes = (c: CallData, nm: StringView) bool {
    subj = (c.fn == "each_field" && c.args.len == 2).match ({
        true  => c.args[0].addr().wr_root_name() == nm,
        false => (c.fn == "zip_fields" && c.args.len == 3).match ({
            true  => c.args[0].addr().wr_root_name() == nm || c.args[1].addr().wr_root_name() == nm,
            false => false,
        }),
    })
    subj && c.args[c.args.len - 1].wr_lam_writes_value()
}
// the same shape written as a METHOD call — `w.each_field((n, f) { f = … })`. The FAITHFUL tree
// (what the formatter and `fmt --migrate` see) keeps MethodCall nodes; only after
// desugar_method_calls does it become the flat `.Call` above. Missing this arm made the migration
// call a reflection-written binding a CONSTANT, which the resolved-tree assign-const check then
// rejected — the two views of the same program have to agree about what a write is.
wr_refl_mc = (mc: MethodCallData, nm: StringView) bool {
    each = mc.method == "each_field" && mc.args.len == 1
    zip = mc.method == "zip_fields" && mc.args.len == 2
    subj = (each || zip)
        && (mc.recv.wr_root_name() == nm || zip && mc.args[0].addr().wr_root_name() == nm)
    subj && mc.args[mc.args.len - 1].wr_lam_writes_value()
}
wr_writes_e = (e: Ptr<Expr>, nm: StringView) bool {
    load(e).match ({
        // only `.Call`/`.MethodCall` are special (a reflection intrinsic writes through its lambda
        // arg); every other shape is a plain structural descent, so it delegates to the one
        // exhaustive child listing.
        .Call(c)        => c.wr_refl_writes(nm)
            || c.args.slice_any((x) { x.addr().wr_writes_e(nm) }),
        .MethodCall(mc) => mc.wr_refl_mc(nm)
            || mc.recv.wr_writes_e(nm)
            || mc.args.slice_any((x) { x.addr().wr_writes_e(nm) }),
        _               => false.expr_fold_children(e, (acc, ch) { acc || ch.wr_writes_e(nm) }, (acc, body) {
            acc || body.wr_writes_name(nm)
        }),
    })
}
wr_writes_stmt = (st: Stmt, nm: StringView) bool {
    st.match ({
        .Let(l)      => l.value.wr_writes_e(nm),
        .Assign(x)   => x.target.wr_root_name() == nm
            || x.target.wr_writes_e(nm)
            || x.value.wr_writes_e(nm),
        .Return(r)   => r.wr_writes_e(nm),
        .ExprStmt(e) => e.wr_writes_e(nm),
        .If(f)       => f.c.wr_writes_e(nm) || f.then.wr_writes_name(nm) || f.els.wr_writes_name(nm),
        .While(w)    => w.c.wr_writes_e(nm) || w.body.wr_writes_name(nm),
        .IndexSet(x) => x.seq.wr_root_name() == nm
            || x.seq.wr_writes_e(nm)
            || x.idx.wr_writes_e(nm)
            || x.value.wr_writes_e(nm),
    })
}
wr_writes_name* = (body: [Stmt], nm: StringView) bool {
    body.slice_any((st) { st.wr_writes_stmt(nm) })
}
// ── const-by-default MIGRATION: infer every binding's mutability from the tree ──────────────────
// Powers `zen fmt --migrate`, the one-shot rewrite from the retired `x := v` spelling to the four
// const-by-default forms. The compiler ALREADY knows which bindings are reassigned — it has to, for
// the ownership and mutation checks — so the migration reads that answer (wr_writes_name) instead of
// guessing from source text. A regex pass over ~10k sites would have to guess, and the last one in
// this repo corrupted comments and was reverted whole.
//
// A binding is MUTABLE iff its name is written anywhere in the statement LIST it is declared in —
// that list plus everything nested inside it (loop/if bodies, lambda bodies, reflection writes) is
// exactly the region the name is visible in, and it is the SAME scope rule the assign-const check
// applies, so a migrated tree type-checks by construction. Rewrites in place: a Stmt slice element
// is assignable, and a nested `[Stmt]` reached through an Expr is a fat pointer into the same
// storage, so mutating it there mutates the tree.
//
// Globals are inferred module-wide: written by any function body ⇒ mutable. Name-based, so a LOCAL
// that shadows a global's name keeps the global mutable — an over-approximation that can only leave
// a `::=` in place, never turn a mutated global into a constant.
mi_expr = (e: Ptr<Expr>) i32 {
    0.expr_fold_children(e, (acc, ch) { ch.mi_expr() }, (acc, body) { body.mi_body() })
}
mi_or = (a: i32, b: i32) i32 { a + b }    // the walk runs for EFFECT; the i32 only makes it foldable
mi_stmt = (st: Stmt, scope: [Stmt]) i32 {
    st.match ({
        .Let(l)      => l.value.mi_expr(),
        .Assign(x)   => x.target.mi_expr().mi_or(x.value.mi_expr()),
        .Return(r)   => r.mi_expr(),
        .ExprStmt(e) => e.mi_expr(),
        .If(f)       => f.c.mi_expr().mi_or(f.then.mi_body()).mi_or(f.els.mi_body()),
        .While(w)    => w.c.mi_expr().mi_or(w.body.mi_body()),
        .IndexSet(x) => x.seq.mi_expr().mi_or(x.idx.mi_expr()).mi_or(x.value.mi_expr()),
    })
}
mi_body* = (body: [Stmt]) i32 {
    body.loop((h, i, st) {
        st.match ({
            .Let(l) => {
                body[i] = slett_atm(l.name, l.ty, l.value, l.pos, body.wr_writes_name(l.name))
            },
            _       => { },
        })
        st.mi_stmt(body)
    })
    0
}
mi_global_written = (decls: [Decl], nm: StringView) bool {
    hit ::= false
    decls.loop((h, i, d) {
        d.match ({
            .DFunc(f) => f.body.wr_writes_name(nm).then({
                hit = true
            }),
            _         => { },
        })
    })
    hit
}
mut_infer_decls* = (decls: [Decl]) void {
    decls.loop((h, i, d) {
        d.match ({
            .DFunc(f) => f.body.mi_body(),
            _         => 0,
        })
    })
    decls.loop((h, i, d) {
        d.match ({
            .DGlobal(g) => (g.alias == false).then({
                decls[i] = dglobal_full(g.name, g.ty, g.init, g.pos, g.tl, false, decls.mi_global_written(g.name))
            }),
            _           => { },
        })
    })
}
// ── const-by-default: which bare `x = v` statement DECLARES a constant ─────────────────────────
// THE RULE, exactly. A statement `x = v` whose target is a BARE NAME declares a new CONSTANT `x`
// when nothing named `x` is in scope at that point — no parameter, no binding from an ENCLOSING
// scope (a let earlier in this statement list, a loop's index/element/handler, a lambda parameter, a
// match-arm bind), and no module global. Otherwise it ASSIGNS to the `x` that IS in scope, and if
// that `x` was declared without the `::` mutability mark the assignment is error[assign-const].
//
// Scope is LEXICAL and threaded (dbn_*), not a flat per-function name set: two sibling match arms
// that each bind `b` are independent, and a flat set would read the second arm's `b = …` as an
// assignment to the first arm's — an undefined name at best.
//
// Three things this rule is deliberately NOT:
//   • not a PARSER rule — `lex_failed = 1` in compiler.lex assigns a module global, and a module's
//     globals are not all parsed yet when a body that assigns one is parsed. So it runs here, over
//     the finished decl list, where every top-level name is known.
//   • not blocked by a top-level FUNCTION or TYPE of the same name — those cannot be assigned to, so
//     `bin = mp.pid_path(…)` beside driver.zen's own `bin` function declares a local that shadows
//     it, exactly as `bin := …` did. Shadowing a helper's name is far too common to outlaw.
//   • not sensitive to a GLOBAL's own mutability. A module's globals are only reliably visible after
//     flatten, and a rule that had to read a global's `::` mark across a module boundary would
//     silently turn `depth = depth + 1` into a fresh local — a miscompile, not a diagnostic. The
//     price is that a CONSTANT local cannot shadow a global by name; write `x ::= v` for that.
//
// A place target (`p.f = v`, `xs[i] = v`) is never a declaration: there is nothing to name.
DbNames*: DbNil | DbCons(DbCell)
DbCell: {
    name: StringView,
    tail: Ptr<DbNames>,
}
dbn_nil_val = () DbNames { .DbNil }
dbn_cons_val = (nm: StringView, t: Ptr<DbNames>) DbNames {
    .DbCons(DbCell(
        name: nm,
        tail: t,
    ))
}
dbn_node = (a: MutPtr<Malloc>, v: DbNames) Ptr<DbNames> {
    buf ::= cbuf<DbNames>(a, 1)
    buf[0] = v
    buf[0].addr()
}
dbn_nil = (a: MutPtr<Malloc>) Ptr<DbNames> { a.dbn_node(dbn_nil_val()) }
dbn = (a: MutPtr<Malloc>, nm: StringView, t: Ptr<DbNames>) Ptr<DbNames> {
    (nm == "").then({
        return t
    })
    a.dbn_node(dbn_cons_val(nm, t))
}
dbn_params = (a: MutPtr<Malloc>, ps: [Param], t: Ptr<DbNames>) Ptr<DbNames> {
    out ::= t
    ps.loop((h, i, p) {
        out = a.dbn(p.name, out)
    })
    out
}
dbn_has = (sc: Ptr<DbNames>, nm: StringView) bool {
    load(sc).match ({
        .DbNil     => false,
        .DbCons(c) => c.name == nm || c.tail.dbn_has(nm),
    })
}
db_target_name = (e: Expr) StringView {
    e.match ({
        .Var(v) => v.name,
        _       => "",
    })
}
db_expr = (a: MutPtr<Malloc>, e: Ptr<Expr>, sc: Ptr<DbNames>, gs: [StringView]) i32 {
    load(e).match ({
        .Loop(l)    => a
            .db_expr(l.seq, sc, gs)
            .db_or(a.db_body(l.body, a.dbn(l.idx, a.dbn(l.elem, a.dbn(l.h, sc))), gs)),
        .Lambda(lm) => a.db_body(lm.body, a.dbn_params(lm.params, sc), gs),
        .Match(m)   => {
            acc ::= a.db_expr(m.subj, sc, gs)
            m.arms.loop((h, i, ar) {
                acc = acc.db_or(a.db_expr(ar.body, a.dbn(ar.bind, sc), gs))
            })
            acc
        },
        _           => 0.expr_fold_children(e, (acc, ch) { a.db_expr(ch, sc, gs) }, (acc, b) {
            a.db_body(b, sc, gs)
        }),
    })
}
db_or = (x: i32, y: i32) i32 { x + y }    // the walk runs for EFFECT; the i32 only makes it foldable
db_stmt = (a: MutPtr<Malloc>, st: Stmt, sc: Ptr<DbNames>, gs: [StringView]) i32 {
    st.match ({
        .Let(l)      => a.db_expr(l.value, sc, gs),
        .Assign(x)   => a.db_expr(x.value, sc, gs),
        .Return(r)   => a.db_expr(r, sc, gs),
        .ExprStmt(e) => a.db_expr(e, sc, gs),
        .If(f)       => a
            .db_expr(f.c, sc, gs)
            .db_or(a.db_body(f.then, sc, gs))
            .db_or(a.db_body(f.els, sc, gs)),
        .While(w)    => a.db_expr(w.c, sc, gs).db_or(a.db_body(w.body, sc, gs)),
        .IndexSet(x) => a
            .db_expr(x.seq, sc, gs)
            .db_or(a.db_expr(x.idx, sc, gs))
            .db_or(a.db_expr(x.value, sc, gs)),
    })
}
db_stmt_name = (st: Stmt) StringView {
    st.match ({
        .Let(l) => l.name,
        _       => "",
    })
}
db_body* = (a: MutPtr<Malloc>, body: [Stmt], sc0: Ptr<DbNames>, gs: [StringView]) i32 {
    sc ::= sc0
    body.loop((h, i, st) {
        st.match ({
            .Assign(x) => {
                nm = load(x.target).db_target_name()
                (nm != "" && sc.dbn_has(nm) == false && gs.slice_any((g) { g == nm }) == false).then({
                    body[i] = slett_atm(nm, tvoid(), x.value, x.pos, false)
                })
            },
            _          => { },
        })
        a.db_stmt(body[i], sc, gs)
        sc = a.dbn(body[i].db_stmt_name(), sc)
    })
    0
}
db_assignable_global = (d: Decl) bool {
    d.match ({
        .DGlobal(g) => g.mut && g.alias == false,
        _           => false,
    })
}
db_global_name = (d: Decl) StringView {
    d.match ({
        .DGlobal(g) => g.name,
        _           => "",
    })
}
db_global_names = (a: MutPtr<Malloc>, decls: [Decl]) [StringView] {
    n ::= 0
    decls.loop((h, i, d) {
        d.db_assignable_global().then({
            n = n + 1
        })
    })
    buf ::= cbuf<StringView>(a, to_i64(n))
    k ::= 0
    decls.loop((h, i, d) {
        d.db_assignable_global().then({
            buf[k] = d.db_global_name()
            k = k + 1
        })
    })
    buf
}
declare_bare_assigns* = (a: MutPtr<Malloc>, decls: [Decl]) void {
    gs = a.db_global_names(decls)
    decls.loop((h, i, d) {
        d.match ({
            .DFunc(f) => a.db_body(f.body, a.dbn_params(f.params, a.dbn_nil()), gs),
            _         => 0,
        })
    })
}
