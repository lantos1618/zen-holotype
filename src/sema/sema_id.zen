// src/sema/sema_id.zen
// How sema names the things the AST holds by value.
//
// `ast_id.zen` names the four arena'd families (expr, type, pattern,
// block); a decl, member, arm or variant is held BY VALUE inside its
// parent's Vec instead, since none closes a cycle.
//
// But holding is not KEYING: sema's memoized queries (DESIGN.md
// decision 3) need `Map<K, V>` keys that are `Eq + Hash`, and a `Decl`
// value has no identity — two structurally equal decls in different
// modules are still two decls. So a declaration gets a coordinate
// instead: module index, decl index, and (for a member) member index —
// same shape as `ExprId`, one level out. Every index is a pure function
// of source position, never an address, so nothing here can make gen_c
// non-deterministic.

Eq, Hash, Hasher = std.core

// FNV's odd prime, used to mix two indices into one hash. Declared here
// rather than imported: `std.text` keeps its own seed private, and a
// hash mixer is not a text function.
//
// `*%` not `*`: `*` traps on overflow, and this constant overflows u64
// by design — wrapping is the intent.
MIX* : u64 = 1099511628211

// A top-level declaration: `Ast.modules[module].decls[decl]`.
DeclId* = {
    module*: u32,
    decl*: u32,
}

// A member of a struct body or an impl body:
// `..decls[decl].members[member]`. A separate type from `DeclId`
// because passing one where the other belongs is the mistake this
// whole file exists to make unrepresentable.
MemberId* = {
    module*: u32,
    decl*: u32,
    member*: u32,
}

// An `A.impl(B, {..})` declaration. It is a `DeclKind` like any other,
// so this is a `DeclId` wearing a name that says which kind it points
// at — `impls_of` returning a `Vec<DeclId>` would make every caller
// remember what those ids were of.
ImplId* = {
    decl*: DeclId,
}

DeclId.impl(Eq, {
    eq ::= (self: @Self, other: @Self) bool {
        (self.module == other.module) && (self.decl == other.decl)
    }
})

DeclId.impl(Hash, {
    hash = (self: @Self, hasher :: Hasher) u64 {
        (self.module.to_u64() *% MIX) +% self.decl.to_u64()
    }
})

MemberId.impl(Eq, {
    eq ::= (self: @Self, other: @Self) bool {
        (self.module == other.module)
            && (self.decl == other.decl)
            && (self.member == other.member)
    }
})

MemberId.impl(Hash, {
    hash = (self: @Self, hasher :: Hasher) u64 {
        (((self.module.to_u64() *% MIX) +% self.decl.to_u64()) *% MIX)
            +% self.member.to_u64()
    }
})

ImplId.impl(Eq, {
    eq ::= (self: @Self, other: @Self) bool { self.decl.eq(other.decl) }
})

ImplId.impl(Hash, {
    hash = (self: @Self, hasher :: Hasher) u64 { self.decl.hash(hasher) }
})

// The declaration a member belongs to. A member id is a decl id plus an
// index, so this is a projection and not a lookup.
owner* = (self: MemberId) DeclId {
    DeclId(module: self.module, decl: self.decl)
}

// The member at `i` of `owner`. The one place the two coordinates are
// joined, so nothing else has to remember the field order.
member_at* = (self: DeclId, i: u32) MemberId {
    MemberId(module: self.module, decl: self.decl, member: i)
}
