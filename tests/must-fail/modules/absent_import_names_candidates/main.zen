// a missing import must say what the walk looked for.
//
// `Thing = nope.deep` sends the walk after two shapes — the file
// `nope/deep.zen`, then the folder module `nope/deep/deep.zen` — and
// af2f9af7 made the refusal of both read as a bare "nothing is at that
// path": a sentence about a path that named no path. moving the anchor
// to the import was right (a diagnostic under a URI that exists nowhere
// is unopenable); losing the subject with it was not, and nothing
// caught it because every must-fail test asserts a message SUBSTRING,
// and the shorter sentence is a substring of the right one.
//
// so the assertion here is the tail both candidates live in, in the
// order probed, root-relative like every path a diagnostic prints.
// the .count bounds the refusal at one diagnostic — an absent import
// is one mistake, and the suite's tolerance for extra output (#746)
// must not blur that.

Thing = nope.deep

main = (env: Env) Res<i32, AllocError> {
    Ok(0);
}
