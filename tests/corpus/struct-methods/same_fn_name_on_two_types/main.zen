// TWO MODULES EACH EXPORT A FUNCTION OF THE SAME NAME ON THEIR OWN TYPE,
// and both are dot-called in one file. The receiver's type picks; neither
// import order nor declaration order may.
//
// DESIGN.md: "`x.f(..)` never names `f`, so it cannot collide with
// anything and needs no import ... Two modules may both declare `size` as
// long as they take different first parameters." This is the sentence the
// flat namespace rests on, and its failure is silent: a resolver that keys
// candidates by name across modules answers one receiver with the other
// module's body. Both bodies here return i32, so C accepts either answer --
// only the numbers disagree.
//
// The two types are deliberately shaped alike (small i32 fields) so a body
// compiled against the wrong type still links and prints a plausible
// number, not garbage.
//
// Breaks if: UFCS candidates are gathered by name without binding each to
// its parameter type -- `b.span()` answers 34 (P's body) instead of 13.

Box = box.box

P = {
    w: i32,
}

span = (p: P) i32 { p.w + 4 }

main = (env: Env) Res<i32, AllocError> {
    b = Box(w: 3, h: 4);
    println("box {}", b.span());
    println("p   {}", span(P(w: 30)));
    println("p-dot {}", P(w: 30).span());
    Ok(0);
}
