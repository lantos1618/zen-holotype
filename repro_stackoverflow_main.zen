// Deep NON-tail recursion in main (non-actor) → clean stack-overflow panic, exit 134.
depth = (n: i64) i64 {
    (n == 0).match ({ true => 0, false => {
        r := depth(n - 1)
        (r < n).match ({ true => r + 1, false => n })
    } })
}
main = () i32 {
    x := depth(100000000)
    (x < 0).match ({ true => 1, false => 0 })
}
