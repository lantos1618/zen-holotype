// tests/corpus/printing/str_prints_its_bytes_verbatim/main.zen
// A `str` hole writes its BYTES and nothing else: no quotes, no
// escaping, no length prefix — and a str that CONTAINS format syntax is
// still just bytes at the point it reaches the writer. The walk that
// reads `{}` runs over the FORMAT LITERAL at compile time; the bytes an
// argument contributes were never format and must not become it.
//
// The plausible wrong answer is the second one: a printer that re-reads
// argument bytes for holes prints `a {b} c` as `a <value-of-b> c` or
// crashes on the unclosed brace — while the correct program cannot tell
// the two lines apart from any other text.
//
// `println(x)` with NO format literal at all is the same floor by
// another spelling (`write_from`: anything not a string literal is "just
// a value"), so it is pinned beside the mixed form.

Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    plain = "plain";
    braces = "a {{b}} and {}";
    println("{} {}", plain, braces);
    println(braces);
    println(plain);

    // a slice is a str too: same bytes, no copy
    s = "abcdef";
    println("{}", s.slice(1, 3));
    Ok(0);
}
