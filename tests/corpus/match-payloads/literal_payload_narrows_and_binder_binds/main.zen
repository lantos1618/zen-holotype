// A LITERAL PAYLOAD NARROWS THE ARM; THE BINDER ARM BESIDE IT BINDS THE
// SAME PAYLOAD. `Ok(3)` is a tag test AND a value test -- gen_c_flow.zen
// says testing only the tag would be "the worst kind of wrong", because
// `Ok('\n')` and `Ok('\\')` compile to the same valid condition. The
// failure this pins: the payload test emitted against the WRONG member,
// or dropped once a binder arm exists -- Ok(4) takes the `Ok(3)` arm, or
// both merge, all valid C with plausible output.
//
// The char arm pins it at a width literals coerce through: 97 IS 'a', so
// an integer-compared-as-byte (or byte-as-int) lowering passes here by
// luck everywhere else. And the scrutinee built INLINE (`Ok(3).match`)
// must behave as the bound one does: same lowering, no special path.

main = (env: Env) Res<i32, AllocError> {
    r: Res<i64> = Ok(4);
    r.match({
        Ok(3) => println("three"),
        Ok(n) => println("other {}", n),
        None  => println("none"),
    });
    Ok(3).match({
        Ok(3) => println("lit hit"),
        Ok(_) => println("lit other"),
        None  => println("lit none"),
    });
    c: Res<u8> = Ok(97);
    c.match({
        Ok('a') => println("char a"),
        Ok(n)   => println("char {}", n),
        None    => println("char none"),
    });
    Ok(0);
}
