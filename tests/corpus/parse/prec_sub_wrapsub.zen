// `-` and `-%` are the same precedence and associate LEFT:
// max - one -% max is (max - one) -% max = -1.
// the other reading, max - (one -% max), TRAPS on overflow.

main = (env: Env) Res<i32, ArgError> {
    max: i32 = 2147483647;
    one: i32 = 1;
    v = max - one -% max;
    println("{}", v);
    Ok(0);
}
