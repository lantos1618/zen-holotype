        kind: "",
    ), VerdictCase(
        src: "P*: { x: i32 }\ntest* = () i32 { p := P(x: 0, y: 1)  p.x }",
        should_pass: false,
        kind: "struct-field",
    ), VerdictCase(
        src: "P*: { x: i32 }\ntest* = () i32 { p := P(z: 0)  0 }",
        should_pass: false,
        kind: "struct-field",
    ), VerdictCase(
        src: "P*: { x: i32, flag: bool }\nmk* = () i64 { 5 }\ntest* = () i32 { p := P(x: mk())  p.x }",
        should_pass: false,
        kind: "struct-field",
    ), VerdictCase(
        src: "P*: { x: i32, flag: bool }\ntest* = () i32 { p := P(x: 0, flag: true)  p.x }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "P*: { x: i32 }\ntest* = () i32 { p := P(x: 0)  p.x }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "S*: { op: (i32) i32 }\ng* = (a: i64) i32 { 0 }\ntest* = () i32 { s := S(op: g)  s.op(3) }",
        should_pass: false,
        kind: "struct-field",
    ), VerdictCase(
        src: "S*: { op: (i32) i32 }\ng* = (a: i32, b: i32) i32 { 0 }\ntest* = () i32 { s := S(op: g)  0 }",
        should_pass: false,
        kind: "struct-field",
    ), VerdictCase(
        src: "S*: { op: (i32) i64 }\ng* = (a: i32) i32 { 0 }\ntest* = () i32 { s := S(op: g)  0 }",
        should_pass: false,
        kind: "struct-field",
    ), VerdictCase(
        src: "S*: { op: (i32) i32 }\ntest* = () i32 { s := S(op: 5)  0 }",
