// src/sema/sema_scope.zen
// A block, as a value, that may not leave its block.
//
// `@scope` "stands for the enclosing block, exactly as `h: LoopHandle`
// stands for the enclosing loop" — a value with a lifetime, which
// nothing else in the language has (every other rule here is about a
// TYPE or a UNIQUENESS), so it isn't folded into `sema_own.zen` beside
// the moves.
//
// NON-ESCAPING IS A FEATURE, NOT A LIMITATION: a closure registered on
// a scope keeps its captures in that scope's own storage, which works
// because the block outlives the closure by construction. Take the
// restriction away and `defer` needs a heap record, which law 1 forbids
// without an `Alloc` — the three ways out below are barred to buy the
// one guarantee that makes `defer` free. Inward is fine: a helper
// registering cleanup on its caller's block is the whole point.
//
// All three ways out are checked here — stored in a struct, returned,
// captured by an escaping closure. The third needs "which closures
// escape" and gets a narrow answer; what it doesn't cover is written
// above `call_escapes` rather than left to be discovered.

Ast, Expr, ExprId, BlockId, Call, Arg, Decl, DeclKind, Struct = std.ast
Paren, Access, Member, Function, Param, Span, TypeId = std.ast
Alloc, AllocError = std.mem
str = std.text
Range = std.core
DeclId = sema.sema_id
decl_at = sema.sema_def
Checker = sema.sema_check
SemaFault, NameFault = sema.sema_diag
refuse, Own, place_type, captures_scope = sema.sema_own
own_member = sema.sema_recv

// RETURNED. The block is gone by the time the caller has the value, so
// every defer on it would run against a dead frame. Only the FUNCTION
// BODY's value is asked — a nested block's `@scope` value hands it to
// an enclosing block that's still open.
check_scope_returned* = (c :: Checker, body: BlockId) Res<(), AllocError> {
    c.tree.block_at(body).value.match({
        None  => Ok(()),
        Ok(v) => refuse_if_scope(c, v),
    })
}

refuse_if_scope* = (c :: Checker, id: ExprId) Res<(), AllocError> {
    node = c.tree.expr_at(id);
    node.kind.match({
        Scope    => refuse(
            c,
            node.span,
            SemaFault.ScopeEscapes(NameFault(name: ""))
        ),
        Paren(p) => refuse_if_scope(c, p.inner),
        _        => Ok(()),
    })
}

// STORED. `register(@scope, env)` passes it inward, legal; `Holder(s:
// @scope)` puts it in a value that can outlive the block. Read the same
// at the call site; only the resolved declaration tells them apart —
// what `call_memo` exists for.
check_scope_stored* = (c :: Checker, id: ExprId, k: Call)
                      Res<(), AllocError> {
    is_construction(c, id).match({
        false => Ok(()),
        true  => refuse_scope_args(c, k),
    })
}

is_construction = (c :: Checker, id: ExprId) bool {
    c.resolved_call(id).match({
        None  => false,
        Ok(d) => decl_is_struct(c, d),
    })
}

decl_is_struct = (c :: Checker, d: DeclId) bool {
    decl_at(c.tree, d).match({
        None   => false,
        Ok(dc) => dc.kind.match({ Struct(_) => true, _ => false }),
    })
}

refuse_scope_args = (c :: Checker, k: Call) Res<(), AllocError> {
    k.args.loop((h, a) { refuse_if_scope(c, a.value).try() });
    Ok(());
}

// CAPTURED. The block outlives every frame registered on it (what
// non-escaping buys, and what makes `Scope` a bare pointer into
// automatic storage), so a closure outliving the block holds a pointer
// to a dead frame — use-after-free, not a style rule. Reported at the
// use inside the body: no separate capture list to point at.
check_scope_captured* = (c :: Checker, o :: Own, span: Span, text: str)
                        Res<(), AllocError> {
    captures_scope(o, text).match({
        false => Ok(()),
        true  => refuse(c, span, SemaFault.ScopeEscapes(NameFault(name: text))),
    })
}

// A binding of `@scope` names the block exactly as the keyword does, so
// `sema_own.zen` records the answer on it when declared. Chased no
// further than what's WRITTEN — `t = s` where `s` holds one is not
// seen, the same syntactic limit the two rules above have.
is_scope_value* = (c :: Checker, id: ExprId) bool {
    c.tree.expr_at(id).kind.match({
        Scope    => true,
        Paren(p) => is_scope_value(c, p.inner),
        _        => false,
    })
}

// ---------------------------------------------------------------------
// WHICH CLOSURES ESCAPE
//
// Read off the CALLEE'S SIGNATURE — law 7's job: "does it allocate,
// mutate, fail, escape — read the signature". `spawn` is declared
// `(self, a: Alloc, body: () Res<T, ThreadError>)`; the `Alloc` beside
// the body says "an escaping closure needs memory" — no allocator, no
// place to keep a closure past return.
//
// So `loop`/`fold`/`then` are untouched (no Alloc param), and
// `map`/`filter`, which do, are read as escaping at no cost: a body
// must NAME a `@scope` binding to be refused at all.
//
// WHAT IT DOES NOT COVER, named rather than hidden: a free function
// taking `Alloc` is not asked, only a method. A callee whose type isn't
// memoized, or whose member comes from an impl rather than the type's
// own body, reads as NON-escaping — fail-open, since a false rejection
// makes a correct program uncompilable and a missing check only misses.
// ---------------------------------------------------------------------

call_escapes* = (c :: Checker, o :: Own, k: Call) bool {
    c.tree.expr_at(k.callee).kind.match({
        Access(a) => member_escapes(c, o, a),
        _         => false,
    })
}

member_escapes = (c :: Checker, o :: Own, a: Access) bool {
    own_member(c, place_type(c, o, a.base), a.name.text).match({
        None  => false,
        Ok(m) => member_takes_alloc(c, m),
    })
}

member_takes_alloc = (c :: Checker, m: Member) bool {
    m.kind.match({
        Function(f) => takes_alloc(c, f),
        _           => false,
    })
}

takes_alloc = (c :: Checker, f: Function) bool {
    Range(0, f.params.len).find((i) {
        f.params.get(i).match({
            None  => false,
            Ok(p) => param_is_alloc(c, p),
        })
    }).match({ Ok(_) => true, None => false })
}

// `Alloc` by NAME, on the parameter as written — the argument's own
// type is the wrong thing to ask (`env.mem.alloc()` hands out an
// `Arena`); the callee declares what it's entitled to keep.
param_is_alloc = (c :: Checker, p: Param) bool {
    p.type.match({
        None    => false,
        Ok(tid) => type_is_alloc(c, tid),
    })
}

type_is_alloc = (c :: Checker, tid: TypeId) bool {
    c.tree.type_at(tid).kind.match({
        Named(n) => n.name.text.eq("Alloc"),
        _        => false,
    })
}
