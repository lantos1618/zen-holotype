Ast = std.ast.ast_arena
Pos, Span = std.ast.ast_span
AllocError = std.mem
String = std.text
Checker = sema.sema_check
TyId = sema.sema_ty
CBackend, LocalSlot = gen.gen_c
write_param_slot = gen.gen_c.gen_c_decl

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    tree  ::= alloc.Ast();
    check ::= alloc.Checker(tree).try();
    be    ::= alloc.CBackend(tree, check).try();
    name  ::= alloc.String().try();
    span = Span(
        file: "in.zen",
        start: Pos(line: 4, col: 7),
        end: Pos(line: 4, col: 8)
    );
    be.write_param_slot(
        "f",
        span,
        LocalSlot(
            name: "f",
            index: 0,
            ty: TyId(index: 0),
            by_ref: false,
            handle: 0,
            closure: 1
        ),
        name
    ).try();
    faults ::= alloc.String().try();
    be.render_diags(faults).try();
    println("name: {}", name.view());
    println("fault:\n{}", faults.view());
    Ok(0)
}
