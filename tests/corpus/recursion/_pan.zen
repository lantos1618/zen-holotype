// probeAN: Arena param, generic realloc, explicit targ on realloc AND try
mk = (ar: Arena) i64 {
    p0 = ar.raw(8, 16).try();
    pr = ar.realloc<i64>(p0.to<i64>(), 1);
    p = match_ok = pr.try();
    p.write(0, 42);
    p.read(0)
}

main = (env: Env) Res<i32, AllocError> {
    a ::= env.mem.alloc();
    println("v {}", mk(a));
    Ok(0);
}
