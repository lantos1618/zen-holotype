// tests/corpus/std/drop_runs_exactly_once.zen
// the compiler calls drop when a binding leaves scope, EXACTLY
// once. one line of output, and both a missing drop and a double
// drop change the count. drop is where an arena would release
// pages, so twice is a real double free

Noisy = {
    id: i32,
    env: Env,   // drop prints, and printing needs an Env in scope
}

Noisy.impl(Drop, {
    drop = (self :: @Self) () {
        env = self.env;
        println("drop {}", self.id);
    }
})

main = (env: Env) Res<i32, AllocError> {
    n = Noisy(id: 1, env: env);
    println("made {}", n.id);
    Ok(0);
    // main's scope ends here: n drops, once
}
