Holder<T> = {
    value: T,

    agrees = <U: Eq>(self: @Self, left: U, right: U) bool {
        left.eq(right)
    }

    keep = <U>(self: @Self, item: U) U { item }

    get = (self: @Self) T { self.value }
}

main = () () {
    holder = Holder<str>(value: "receiver");
    println("{} {}", holder.agrees(3, 3), holder.agrees(3, 4));
    println("{}", holder.keep(7).to_i64());
    println("{} {}", holder.get(), holder.agrees("x", "x"));
}
