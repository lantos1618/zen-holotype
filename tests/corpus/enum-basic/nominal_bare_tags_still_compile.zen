// A nominal enum of bare tags must still compile (#780): `Color = Red |
// Green | Blue` has no bare name that denotes a type, so there is no union
// reading to fail and the one-miss rule stays silent on purpose. The rule
// fires only when exactly one bare member binds nothing while every other
// bare member denotes a type -- tag soup, two-or-more misses, and any
// value-bearing sibling keep compiling exactly as before.
//
// position: the declaration compiles, runs, and prints.

Color = Red | Green | Blue

pick = (c: Color) str {
    c.match({
        Red   => "red",
        Green => "green",
        Blue  => "blue",
    })
}

main = (env: Env) Res<i32, AllocError> {
    println("{}", pick(Green));
    Ok(0)
}
