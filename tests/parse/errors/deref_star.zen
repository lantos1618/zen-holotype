// MUST FAIL: prefix `*` dereference. Same law as the pointer type, DESIGN.md:340 —
// `*` is reserved for exports. Reads through a pointer are method calls on `Ptr<T>`:
// `self.data.read(i)` (DESIGN.md:555), `self.data.write(self.len, value)`
// (DESIGN.md:548). The only unary operators in the document are `!` (486),
// `&` (107), and `consume` (254).

read_first* = (p: Ptr<u8>) u8 {
    *p
}
