// The build IS a Zen program: `zenc build .` runs this and links the Target it returns.
{ Build, Plan, plan } = std.build
build = (b: Build) Plan {
    target := b.exe("build-zen-demo").root("src").main("main.zen").out("fixture-bin")
    alternate := b.exe("build-zen-alt").root("src").main("main.zen").out("fixture-bin-alt")
    plan([b.target().os.match ({
        .Linux => target,
        _      => target,
    }), alternate])
}
