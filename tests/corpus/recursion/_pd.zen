// probeD: generic recursion + generic mutual recursion
depth = <T>(x: T, n: i64) i64 {
    (n == 0).match({
        true  => 0,
        false => depth(x, n - 1) + 1,
    });
}

even_g = <T>(x: T, n: i64) bool {
    (n == 0).match({ true => true, false => odd_g(x, n - 1) })
}
odd_g = <T>(x: T, n: i64) bool {
    (n == 0).match({ true => false, false => even_g(x, n - 1) })
}

main = (env: Env) Res<i32, AllocError> {
    println("d {} {}", depth(7, 5), depth("x", 3));
    e4 = even_g(9, 4).match({ true => 1, false => 0 });
    e5 = odd_g(9, 5).match({ true => 1, false => 0 });
    println("g {} {}", e4, e5);
    Ok(0);
}
