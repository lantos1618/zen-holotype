// fmt fixture INPUT: a table of multi-line struct literals, in the shape the formatter used to
// produce — the opening `[` swallowing the first row and `), Op(` running the rows together.
// Formatting it must yield slice_of_structs_formatted.zen: one element per line, `]` on its own.
// The single-line literals below pin the other half of the contract: they must NOT grow.
Op*: {
    nm: StringView,
    n: i64,
}
OPS = [
    Op(
        nm: "add",
        n: 1,
    ),
    Op(
        nm: "sub",
        n: 2,
    ),
]
SMALL = [1, 2, 3]
NESTED = [[1, 2], [3, 4]]
main = () i64 {
    ones = [OPS[0].n]
    inner: [Op] = [
        Op(
            nm: "mul",
            n: 3,
        ),
    ]
    OPS.len + SMALL[0] + NESTED[0][1] + ones[0] + inner[0].n
}
