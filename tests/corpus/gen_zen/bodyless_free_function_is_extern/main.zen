// A bodyless free function is lowered as an extern C symbol. The linker
// resolves it; the compiler no longer needs `--ffi` to emit the call.
//
// `isdigit` is a C99 library function with the exact shape we declare:
// one `int` argument and an `int` return. Calling it proves the prototype
// is emitted above the bodies and that the program links.

AllocError = std.mem

isdigit = (c: i32) i32

main = (env: Env) Res<i32, AllocError> {
    yes = isdigit('0'.to_i32());
    no  = isdigit('x'.to_i32());
    println("yes={} no={}", yes, no);
    Ok(0)
}
