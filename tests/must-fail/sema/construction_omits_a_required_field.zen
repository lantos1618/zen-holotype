// A CONSTRUCTION SUPPLIES EVERY REQUIRED FIELD. `y` has no default, so
// there is no value for it to take and nothing for the omission to
// mean -- a struct with a hole in it is not a value of that struct.
//
// A field is required when it declares no default and its type is not
// a `Res`: a `Res` field is legitimately absent (that is what `None`
// spells), and a default already says what an omission means. `x` and
// `y` are both plain i32, so both are owed and only one is written.
//
// One diagnostic and not two: the construction is one mistake even
// where several fields are missing, and only `y` is missing here.
//
// position: the construction, which is where the missing name goes.

Point = {
    x: i32,
    y: i32,
}

main = (env: Env) Res<i32, AllocError> {
    p = Point(x: 1);
    println("{}", p.x);
    Ok(0);
}
