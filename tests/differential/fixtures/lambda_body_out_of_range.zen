// Sema must walk a lambda body and reject a literal outside its declared
// contextual type before code generation can wrap it.
main = (env: Env) Res<i32, AllocError> {
    xs = [1, 2, 3];
    xs.loop((h, value) {
        narrowed: i32 = 3000000000;
        println("{} {}", value, narrowed);
    });
    Ok(0)
}
