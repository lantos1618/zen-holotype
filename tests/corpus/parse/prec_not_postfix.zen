// a postfix call binds tighter than prefix `!`: !n.is_zero() is
// !(n.is_zero()), which DESIGN.md writes as `!self.eq(other)`.
// the other reading, (!n).is_zero(), does not type-check.

is_zero = (n: i32) bool { n == 0 }

main = (env: Env) Res<i32, ArgError> {
    n = 5;
    (!n.is_zero()).match({
        true => println("nonzero"),
        false => println("zero"),
    });
    Ok(0);
}
