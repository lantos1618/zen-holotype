// EOF arrives after a COMPLETE escape, with no closing quote and no newline:
// the file ends `'\n`. The escape itself succeeded, so `escape` has said
// nothing -- the unterminated literal is still this file's only lexical
// fault, and it must be named, at the opening quote. The truncated-escape
// sibling (`eof_in_char_escape`) covers the case where the ESCAPE ran off
// the end and reports for itself.
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    c: u8 = '\n