// src/sema/sema_raise.zen
// What a body raises, and the signature inferred from it.
//
// `Res<T, _>` says the error set is a fact about the body, not
// something the author repeats. Before this file computed it, every
// `.try()` of such a function got "no implicit error conversion:
// expected CfgError, found _" — a diagnostic naming the hole as if it
// were a type.
//
// Law 6 is the whole rule: "inferred inside the module, written at the
// boundary". A private function's set is derivable from its body
// (writing it out is a second place to be wrong); an exported one
// crosses a module boundary, so the compiler won't invent its type
// (`InferredSetExported`, in `sema_diag.zen`).
//
// TWO SOURCES, BOTH NEEDED: a `.try()` propagates its callee's set into
// the accumulator; a body ending in `Err(..)` never propagates and
// shows its set only in the block's own type. `parse_pair` has the
// first, `read_num` the second — the pair TESTING.md names.
//
// Written back into the MEMO for the return type's own node, which is
// what a caller's `type_from_ast` and gen_c both read after sema is
// done — making inference ORDER-DEPENDENT (a caller checked before its
// callee sees `_`), saved only by declaration order. A query the
// callee's signature pulls on demand would be the honest fix, bigger
// than this hole warrants.

Function, Ident, Type, TypeId, Span = std.ast
AllocError = std.mem
Vec = std.collections
Range = std.core
TyId, TyRes = sema.sema_ty
Checker, Ctx = sema.sema_check
SemaFault, NameFault = sema.sema_diag

// Called once per body, with the mark taken before it was walked.
// Everything raised since then belongs to this function.
settle_raised* = (
    c :: Checker,
    f: Function,
    ctx: Ctx,
    got: TyId,
    mark: usize
) Res<(), AllocError> {
    raised ::= c.alloc.Vec<TyId>();
    c.take_raised(mark, raised).try();
    inferred_error(c, ctx.ret).match({
        None  => Ok(()),
        Ok(_) => settle_signature(c, f, ctx, got, raised),
    })
}

// The declared error, when the author wrote `_` for it — `None` for a
// function that named its set or returns no `Res` at all; the raised
// list is dropped there since the ordinary containment rule already
// reported anything wrong.
inferred_error = (c :: Checker, ret: TyId) Res<TyId> {
    c.types.at(ret).match({
        Res(r) => infer_hole(c, r),
        _      => None,
    })
}

infer_hole = (c :: Checker, r: TyRes) Res<TyId> {
    c.is_infer(r.error).match({
        false => None,
        true  => Ok(r.error),
    })
}

settle_signature = (
    c :: Checker,
    f: Function,
    ctx: Ctx,
    got: TyId,
    raised :: Vec<TyId>
) Res<(), AllocError> {
    report_if_exported(c, f).try();
    body_error(c, got, raised).try();
    set = c.types.union_ty(raised).try();
    write_ret(c, f, ctx, set)
}

// `*` means this name crosses a module boundary, and a crossing type is
// written. The set is still settled after the report, so one unwritten
// signature is one diagnostic, not one per call site.
report_if_exported = (c :: Checker, f: Function) Res<(), AllocError> {
    f.exported.match({
        false => Ok(()),
        true  => report_hole(c, f),
    })
}

// Lands on the `_`, since that's what the author has to replace —
// naming the function instead would point at the one token already
// correct.
report_hole = (c :: Checker, f: Function) Res<(), AllocError> {
    span = hole_span(c, f).match({ None => f.name.span, Ok(s) => s });
    c.report(
        span.file,
        span,
        SemaFault.InferredSetExported(NameFault(name: f.name.text))
    )
}

hole_span = (c :: Checker, f: Function) Res<Span> {
    f.ret.match({
        None   => None,
        Ok(id) => res_hole_span(c, id),
    })
}

res_hole_span = (c :: Checker, id: TypeId) Res<Span> {
    c.tree.type_at(id).kind.match({
        Named(n) => arg_span(c, n.args, 1),
        _        => None,
    })
}

arg_span = (c :: Checker, args: Vec<TypeId>, i: usize) Res<Span> {
    args.get(i).match({
        None  => None,
        Ok(a) => Ok(c.tree.type_at(a).span),
    })
}

// The block's own type carries what a body raises by ENDING in it:
// `Err(CfgError.Bad)` is the block's value, never a propagation, so
// nothing put it in the accumulator.
body_error = (c :: Checker, got: TyId, raised :: Vec<TyId>)
             Res<(), AllocError> {
    c.types.at(got).match({
        Res(r) => keep_error(c, r, raised),
        _      => Ok(()),
    })
}

keep_error = (c :: Checker, r: TyRes, raised :: Vec<TyId>)
             Res<(), AllocError> {
    carries_error(c, r).match({
        false => Ok(()),
        true  => raised.add(r.error),
    })
}

// An absence carries `()` as its error, an unresolved one poison —
// neither is a member of anybody's set; adding either would make
// `Res<i32, _>` settle as a set containing `()`.
carries_error = (c :: Checker, r: TyRes) bool {
    c.is_infer(r.error).match({
        true  => false,
        false => real_error(c, r),
    })
}

real_error = (c :: Checker, r: TyRes) bool {
    c.is_unknown(r.error).match({
        true  => false,
        false => r.form.match({ Failure => true, _ => false }),
    })
}

// The memo for the return type's own node, rewritten in place — everyone
// who asks what this signature means asks that node.
write_ret = (c :: Checker, f: Function, ctx: Ctx, set: TyId)
            Res<(), AllocError> {
    f.ret.match({
        None   => Ok(()),
        Ok(id) => write_ret_memo(c, id, ctx, set),
    })
}

write_ret_memo = (c :: Checker, id: TypeId, ctx: Ctx, set: TyId)
                 Res<(), AllocError> {
    c.types.at(ctx.ret).match({
        Res(r) => write_settled(c, id, r, set),
        _      => Ok(()),
    })
}

write_settled = (c :: Checker, id: TypeId, r: TyRes, set: TyId)
                Res<(), AllocError> {
    settled = c.types.res_failure(r.value, set).try();
    c.type_memo.set(id, settled)
}
