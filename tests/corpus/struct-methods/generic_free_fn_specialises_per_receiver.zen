// A GENERIC-DECLARED FREE FUNCTION ON THE TYPE IS REACHED THROUGH EVERY
// INSTANTIATION, with the type argument inferred per receiver: one
// `first_is* = <T>(p: Pair<T>, x: T) i32`, dot-called on a `Pair<i32>`
// and on a `Pair<str>`. Each call must specialise the callee against ITS
// OWN T -- and the argument must type-check against the SAME T the
// receiver chose, not against the first instantiation found.
//
// The plausible failure is cross-instantiation leakage: the second call
// reuses the first call's T (answering 0 for a match that should be 1,
// or rejecting "z" as an i32), which reads as an ordinary wrong answer.
// The two instantiations use different element kinds and opposite answers
// so no shared-T shortcut reproduces both lines.
//
// Breaks if: the free function is instantiated once (first call wins,
// second line flips to 1/0 wrongly) or its <T> is not unified with the
// receiver's.

Pair*<T> = {
    a*: T,
    b*: T,
}

first_is* = <T>(
    p : Pair<T>,
    x : T
) i32 { (p.a == x).match({ true => 1, false => 0 }) }

main = (env: Env) Res<i32, AllocError> {
    p = Pair<i32>(a: 5, b: 7);
    q = Pair<str>(a: "x", b: "y");
    println("i32 {}", p.first_is(5));
    println("str {}", q.first_is("y"));
    Ok(0);
}
