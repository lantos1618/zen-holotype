// 32 nested `.match` expressions.
//
// `.match` is Zen's ONLY conditional (DESIGN.md § Control flow), so nesting
// that a language with `if` would spread across statements arrives here as
// one expression. This is the construct most likely to produce deep C in
// practice, and it is the one where the two plausible lowerings diverge
// hardest:
//
//   - to a nested ternary: one expression, 32 levels deep, and every arm
//     must be an expression — which stops working the moment an arm
//     contains a binding or a defer
//   - to statements with a result temporary: flat, always works, and
//     needs a name per level
//
// the second is the one that scales, and this file is the pressure to pick
// it early rather than after the first arm that cannot be an expression.
//
// each level is written on one line on purpose: 32 levels of source
// indentation would be a formatter test, and this is not one.

main = (env: Env) Res<i32, AllocError> {
    yes = (1 == 1);
    deep = yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (yes.match({ true => (0) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 })) + 1, false => 0 });
    println("match {}", deep);
    Ok(0);
}
