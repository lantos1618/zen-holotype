// let-RHS match, Err arm is a BLOCK trailing with an assignment stmt (void-ish)
R*: Ok(str) | Err(i32)
main = () i32 {
    done := false
    s := "init"
    r: R = .Err(3)
    s2 := r.match ({
        .Ok(ns) => ns,
        .Err(e) => { done = true },
    })
    done.match ({ true => 0, false => 1 })
}
