// `@scope` may be passed INWARD: a helper registers cleanup on its
// caller's block. non-escaping does not mean unshareable, it means
// one direction only — down the stack, never out of it.
//
// the three ways out are the three must-fail files:
// scope_stored_in_struct, scope_returned,
// scope_captured_by_escaping_closure.

register = (s: Scope, env: Env) () {
    s.defer(() { env.out.println("cleanup") });
}

main = (env: Env) Res<i32, IoError> {
    register(@scope, env);
    println("body");
    Ok(0);
}
