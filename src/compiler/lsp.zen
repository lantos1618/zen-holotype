{ Allocator, RequestArena, request_arena } = std.mem.alloc
{ view, is_empty } = std.text.str
{ then } = std.core.bool
{ contents_in } = std.io.file
{ memcpy, read, write, strlen } = std.c.libc
{ hex_char, hex_nibble } = std.text.ascii    // shared hex nibble encode/decode
{ advance_while, repeat_while, step_while, loop_at } = std.core.count
{ CheckDiagnostic, desc_or } = compiler.validate.diag
{ denrich_check } = compiler.validate.enrich
{ parse_module } = compiler.parse
{ resolve_module } = compiler.check_resolve
{ ufcs_vis_of, is_intrinsic } = compiler.check
{ check_module_ownership_diagnostic_from_source, check_module_parse_diagnostic_from_source,
  check_module_no_if_diagnostic_from_source, check_module_no_ternary_diagnostic_from_source,
  check_module_no_coroutine_diagnostic_from_source, check_module_reserved_diagnostic_from_source,
  check_module_leak_diagnostic_from_source, check_module_addr_escape_diagnostic_from_source,
  check_module_send_rc_diagnostic_from_source, check_module_scratch_diagnostic_from_source,
  check_module_send_mut_diagnostic_from_source, check_module_bound_diagnostic_from_source,
  check_module_arg_diagnostic_from_source, check_module_or_return_diagnostic_from_source,
  check_module_unknown_type_diagnostic_from_source, check_module_ffi_diagnostic_from_source,
  check_module_mustuse_diagnostic_from_source, check_module_infinite_type_diagnostic_from_source,
  check_module_main_diagnostic_from_source, check_module_batch_vis } = compiler.validate.core
{ DiagSpan } = compiler.diagnostic
{ resolve_failed, resolve_message, resolve_program_data, undefined_name_hint, ResolvedProgram,
  SourceOverlay } = compiler.resolve
{ impl_cname_in } = compiler.mangle
{ acquire_or_die, cbuf } = compiler.genc
{ push_int, dirname, cstr_range, cstr_substr } = compiler.drvutil
{ lspt_legend, lspt_tokens } = compiler.lsp_tokens
{ LspDocs, lspd_init, lspd_cache_tokens, lspd_close, lspd_count, lspd_find, lspd_set, lspd_text_at,
  lspd_tokens_at, lspd_uri_at, lspd_version_at } = compiler.lsp_docs
{ cd_or, locate_diag } = compiler.drvdiag
{ SymbolIndex, SymbolKey, SymbolKind, SymbolSourceSpan, SymbolOccurrence, SymbolDecl,
  resolve_symbol_index, symbol_key_eq } = compiler.symbols
{ ff_is_hoisted } = compiler.pretty_decl
{ lsp_byte_of_pos, lsp_find_def, lsp_ident_end, lsp_ident_start, lspq_hover, lspq_items,
  lspq_reserved_name } = compiler.lsp_query
LspInit*: {
    workspace_uri: StringView,
    rename_prepare: bool,
    document_changes: bool,
}
LspPosition*: {
    ok: bool,
    uri: StringView,
    line: i64,
    character: i64,
}
LspSession: {
    durable: Allocator,
    requests: RequestArena,
    docs: LspDocs,
    workspace_uri: StringView,
    rename_prepare: bool,
    document_changes: bool,
    deinit = (s: MutPtr<LspSession>) void {
        s.docs.addr().deinit()
        (is_empty(s.workspace_uri) == false).then({
            s.durable.release(s.workspace_uri.offset(0))
        })
        s.requests.addr().deinit()
    }
}
lsp_session = (durable: Allocator) LspSession {
    LspSession(
        durable: durable,
        requests: request_arena(durable),
        docs: lspd_init(durable),
        workspace_uri: "",
        rename_prepare: false,
        document_changes: false,
    )
}
// ── `zenc lsp` — diagnostics-only Language Server over stdio (LSP Stage 1) ─────────────────────────
// A JSON-RPC 2.0 loop: read `Content-Length: N\r\n\r\n<N-byte JSON body>` frames from stdin, run the
// EXISTING check pipeline (resolve -> parse -> the diagnostic channels) on each opened/changed
// document, and PUSH `textDocument/publishDiagnostics`. This only ADDS a subcommand — no compiler
// internals change; it rides check_module_batch + the specialized channels the driver already uses.
// Full-sync per document: the text is checked standalone; its directory is derived from the
// `file://` URI so sibling/std imports resolve (an error INSIDE an imported module is pinned to the
// open file's head with the real location in the message). Stage 1 adds: didClose (clears
// diagnostics), MethodNotFound replies for unimplemented requests, byte->UTF-16 position conversion,
// and a Content-Length sanity ceiling. Every feature reads the OPEN document out of the document
// store (compiler.lsp_docs) that didOpen/didChange fill, never off disk — while the client holds a
// buffer open, that buffer IS the document. Conformance suite: tests/harness_lsp.zen. Stage 2b adds
// hover and completion, both answered TEXTUALLY by compiler.lsp_query (which states exactly what
// they cover) so they survive the unparseable buffer an editor holds between keystrokes; and
// documentSymbol, the outline `gO` and the `]m`/`[m` method motions are driven by.
// PROTOCOL WRITES GO TO STDOUT (fd 1); every diagnostic/log the pipeline emits stays on stderr, so the
// JSON-RPC stream is never corrupted.
lout = (s: StringView) i64 {
    v = s.view()
    write(1, v.ptr, v.len)
}
// frame + write one JSON-RPC message: `Content-Length: <bytes>\r\n\r\n<body>`.
lsp_send = (mp: Allocator, body: StringView) i64 {
    lout(mp.String(48).add("Content-Length: ").push_int(mp, body.view().len).add("\r\n\r\n").finish_cstr())
    lout(body)
}
// ── JSON string EMISSION (own escaper; the task sanctions building output as strings) ─────────────
push_uesc = (sb: String, mp: Allocator, b: u8) String {
    bi = b.to_i64()
    sb.add("\\u00").add_one(hex_char(bi >> 4 & 15)).add_one(hex_char(bi & 15))
}
// append `s` as a JSON string LITERAL (surrounding quotes + escaped) to the builder.
push_jstr = (sb: String, mp: Allocator, s: StringView) String {
    cur ::= sb.add_one('"')
    v: Slice<u8> = s.view()
    v.loop_at((i, b) {
        cur = (b == '"').match ({
            true  => cur.add("\\\""),
            false => (b == '\\').match ({
                true  => cur.add("\\\\"),
                false => (b == '\n').match ({
                    true  => cur.add("\\n"),
                    false => (b == '\r').match ({
                        true  => cur.add("\\r"),
                        false => (b == '\t').match ({
                            true  => cur.add("\\t"),
                            false => (b < 32).match ({
                                true  => cur.push_uesc(mp, b),
                                false => cur.add_one(b),
                            }),
                        }),
                    }),
                }),
            }),
        })
    })
    cur.add_one('"')
}
// ── incoming JSON extraction (hand-rolled; std.json's `parse`/`get` collide with the compiler's own
// flat `parse`/`get` names once this closure imports compiler.parse, so a targeted scanner is used).
// The scanner walks left-to-right skipping over complete JSON strings, so a `"key":` byte-pattern that
// happens to sit INSIDE a string value (e.g. the document source text) is never mistaken for a key.
// String scanning/decoding ITERATES (step_while) so a megabyte document never recurses the C stack.
// index just past the closing quote of the string opening at v[i]=='"' (respecting `\` escapes).
json_str_end = (v: Slice<u8>, i: i64) i64 {
    e = (i + 1).step_while((j) { j < v.len && v[j] != '"' }, (j) {
        (v[j] == '\\').then({ j + 2 }, { j + 1 })
    })
    (e < v.len).then({ e + 1 }, { v.len })
}
json_skip_ws = (v: Slice<u8>, p: i64) i64 {
    p.advance_while((q) {
        q < v.len && (v[q] == ' ' || v[q] == '\t' || v[q] == '\n' || v[q] == '\r')
    })
}
json_range_eq = (v: Slice<u8>, start: i64, kv: Slice<u8>, k: i64) bool {
    (k >= kv.len).match ({
        true  => true,
        false => (v[start + k] == kv[k]).then({ v.json_range_eq(start, kv, k + 1) }, { false }),
    })
}
json_str_eq_range = (v: Slice<u8>, start: i64, end: i64, kv: Slice<u8>) bool {
    (end - start != kv.len).then({ false }, { v.json_range_eq(start, kv, 0) })
}
// the byte offset of the VALUE for the first object key named `key`, or -1. Strings are consumed whole,
// so key matches inside a value never fire and nesting is transparent.
json_find_key = (v: Slice<u8>, key: StringView) i64 {
    kv: Slice<u8> = key.view()
    result :: i64 = 0 - 1
    zero: i64 = 0
    zero.step_while((i) { result < 0 && i < v.len }, (i) {
        (v[i] == '"').match ({
            true  => {
                se = v.json_str_end(i)
                cs = v.json_skip_ws(se)
                (cs < v.len && v[cs] == ':' && v.json_str_eq_range(i + 1, se - 1, kv)).then({
                    result = v.json_skip_ws(cs + 1)
                })
                se
            },
            false => i + 1,
        })
    })
    result
}
// end of one JSON value. Composite values are skipped as a unit so direct-field lookup never
// mistakes a nested key for a sibling.
json_nested_end = (v: Slice<u8>, p: i64) i64 {
    depth ::= 0
    stop :: i64 = 0 - 1
    p.step_while((i) { stop < 0 && i < v.len }, (i) {
        b = v[i]
        (b == '"').match ({
            true  => v.json_str_end(i),
            false => {
                (b == '{' || b == '[').then({
                    depth = depth + 1
                })
                (b == '}' || b == ']').then({
                    depth = depth - 1
                    (depth == 0).then({
                        stop = i + 1
                    })
                })
                i + 1
            },
        })
    })
    (stop < 0).then({ v.len }, { stop })
}
json_value_end = (v: Slice<u8>, p: i64) i64 {
    q = v.json_skip_ws(p)
    (q >= v.len).match ({
        true  => v.len,
        false => (v[q] == '"').match ({
            true  => v.json_str_end(q),
            false => (v[q] == '{' || v[q] == '[').match ({
                true  => v.json_nested_end(q),
                false => q.advance_while((i) {
                    i < v.len
                        && v[i] != ','
                        && v[i] != '}'
                        && v[i] != ']'
                        && v[i] != ' '
                        && v[i] != '\t'
                        && v[i] != '\n'
                        && v[i] != '\r'
                }),
            }),
        }),
    })
}
// value position for a DIRECT field of the object opening at obj, or -1.
json_field_in* = (v: Slice<u8>, obj: i64, key: StringView) i64 {
    (obj < 0 || obj >= v.len || v[obj] != '{').then({
        return 0 - 1
    })
    kv: Slice<u8> = key.view()
    found :: i64 = 0 - 1
    (obj + 1).step_while((i) { found < 0 && i < v.len }, (i) {
        q = v.json_skip_ws(i)
        (q >= v.len || v[q] == '}' || v[q] != '"').match ({
            true  => v.len,
            false => {
                se = v.json_str_end(q)
                cs = v.json_skip_ws(se)
                (cs >= v.len || v[cs] != ':').match ({
                    true  => v.len,
                    false => {
                        val = v.json_skip_ws(cs + 1)
                        v.json_str_eq_range(q + 1, se - 1, kv).then({
                            found = val
                        })
                        after = v.json_skip_ws(v.json_value_end(val))
                        (after < v.len && v[after] == ',').then({ after + 1 }, { v.len })
                    },
                })
            },
        })
    })
    found
}
json_top_field* = (body: StringView, key: StringView) i64 {
    v: Slice<u8> = body.view()
    q = v.json_skip_ws(0)
    v.json_field_in(q, key)
}
json_uint_at* = (v: Slice<u8>, p: i64) i64 {
    (p < 0 || p >= v.len || v[p] < '0' || v[p] > '9').then({
        return 0 - 1
    })
    e = p.advance_while((i) { i < v.len && v[i] >= '0' && v[i] <= '9' })
    q = v.json_skip_ws(e)
    (q < v.len && v[q] != ',' && v[q] != '}' && v[q] != ']').then({
        return 0 - 1
    })
    v.lsp_parse_dec(p, 0)
}
json_bool_at* = (v: Slice<u8>, p: i64) i32 {
    (p < 0 || p >= v.len).then({
        return 0 - 1
    })
    v.lsp_match_word(p, "true").then({
        return 1
    })
    v.lsp_match_word(p, "false").then({ 0 }, { 0 - 1 })
}
lsp_match_word = (v: Slice<u8>, p: i64, word: StringView) bool {
    w: Slice<u8> = word.view()
    (p + w.len > v.len).then({
        return false
    })
    v.json_range_eq(p, w, 0)
        && (p + w.len >= v.len
            || v[p + w.len] == ','
            || v[p + w.len] == '}'
            || v[p + w.len] == ']'
            || v[p + w.len] == ' '
            || v[p + w.len] == '\t'
            || v[p + w.len] == '\n'
            || v[p + w.len] == '\r')
}
json_first_array_value = (v: Slice<u8>, p: i64) i64 {
    (p < 0 || p >= v.len || v[p] != '[').then({
        return 0 - 1
    })
    q = v.json_skip_ws(p + 1)
    (q >= v.len || v[q] == ']').then({ 0 - 1 }, { q })
}
json_hexq = (v: Slice<u8>, at: i64) i64 {
    (at + 3 >= v.len).match ({
        true  => 0 - 1,
        false => {
            h0 = hex_nibble(v[at])
            h1 = hex_nibble(v[at + 1])
            h2 = hex_nibble(v[at + 2])
            h3 = hex_nibble(v[at + 3])
            (h0 < 0 || h1 < 0 || h2 < 0 || h3 < 0).match ({
                true  => 0 - 1,
                false => h0 * 4096 + h1 * 256 + h2 * 16 + h3,
            })
        },
    })
}
// UTF-8 encode one Unicode scalar into the builder.
push_utf8 = (sb: String, mp: Allocator, cp: i64) String {
    (cp < 128).match ({
        true  => sb.add_one(cp.to_u8()),
        false => (cp < 2048).match ({
            true  => sb
                .add_one((192 | cp >> 6).to_u8())
                .add_one((128 | cp & 63).to_u8()),
            false => (cp < 65536).match ({
                true  => sb
                    .add_one((224 | cp >> 12).to_u8())
                    .add_one((128 | cp >> 6 & 63).to_u8())
                    .add_one((128 | cp & 63).to_u8()),
                false => sb
                    .add_one((240 | cp >> 18).to_u8())
                    .add_one((128 | cp >> 12 & 63).to_u8())
                    .add_one((128 | cp >> 6 & 63).to_u8())
                    .add_one((128 | cp & 63).to_u8()),
            }),
        }),
    })
}
// decode the JSON string opening at v[i]=='"' into an allocator-owned view (escapes resolved).
json_decode_str = (mp: Allocator, v: Slice<u8>, i: i64) StringView {
    sb ::= mp.String(v.len - i + 1)
    (i + 1).step_while((j) { j < v.len && v[j] != '"' }, (j) {
        b = v[j]
        (b == '\\' && j + 1 < v.len).match ({
            true  => {
                e = v[j + 1]
                (e == 'n').match ({
                    true  => {
                        sb = sb.add_one('\n')
                        j + 2
                    },
                    false => (e == 't').match ({
                        true  => {
                            sb = sb.add_one('\t')
                            j + 2
                        },
                        false => (e == 'r').match ({
                            true  => {
                                sb = sb.add_one('\r')
                                j + 2
                            },
                            false => (e == 'b').match ({
                                true  => {
                                    sb = sb.add_one('\x08')
                                    j + 2
                                },
                                false => (e == 'f').match ({
                                    true  => {
                                        sb = sb.add_one('\x0c')
                                        j + 2
                                    },
                                    false => (e == 'u').match ({
                                        true  => {
                                            cp = v.json_hexq(j + 2)
                                            (cp < 0).match ({
                                                true  => {
                                                    sb = sb.add_one(e)
                                                    j + 2
                                                },
                                                false => {
                                                    low = (cp >= 55296
                                                        && cp <= 56319
                                                        && j + 11 < v.len
                                                        && v[j + 6] == '\\'
                                                        && v[j + 7] == 'u').match ({
                                                        true  => v.json_hexq(j + 8),
                                                        false => 0 - 1,
                                                    })
                                                    (low >= 56320 && low <= 57343).match ({
                                                        true  => {
                                                            sb = sb.push_utf8(mp, 65536 + (cp - 55296) * 1024 + low - 56320)
                                                            j + 12
                                                        },
                                                        false => {
                                                            sb = sb.push_utf8(mp, cp)
                                                            j + 6
                                                        },
                                                    })
                                                },
                                            })
                                        },
                                        false => {
                                            sb = sb.add_one(e)
                                            j + 2
                                        },
                                    }),
                                }),
                            }),
                        }),
                    }),
                })
            },
            false => {
                sb = sb.add_one(b)
                j + 1
            },
        })
    })
    sb.finish_cstr()
}
// raw bytes of the value at v[i]: a quoted string (incl. quotes) or a bare token up to `,`/`}`/`]`/ws.
json_raw_at = (mp: Allocator, v: Slice<u8>, i: i64) StringView {
    (i >= v.len).match ({
        true  => "null",
        false => (v[i] == '"').match ({
            true  => mp.cstr_range(v, i, v.json_str_end(i)),
            false => {
                e = i.advance_while((p) {
                    p < v.len
                        && v[p] != ','
                        && v[p] != '}'
                        && v[p] != ']'
                        && v[p] != ' '
                        && v[p] != '\t'
                        && v[p] != '\n'
                        && v[p] != '\r'
                })
                mp.cstr_range(v, i, e)
            },
        }),
    })
}
// the decoded string value of the first key `key`, or "" if absent / non-string.
json_str_field = (mp: Allocator, body: StringView, key: StringView) StringView {
    v: Slice<u8> = body.view()
    p = v.json_find_key(key)
    (p < 0 || p >= v.len).match ({
        true  => "",
        false => (v[p] == '"').then({ mp.json_decode_str(v, p) }, { "" }),
    })
}
json_string_at* = (mp: Allocator, v: Slice<u8>, p: i64) StringView {
    (p < 0 || p >= v.len || v[p] != '"').then({ "" }, { mp.json_decode_str(v, p) })
}
json_top_string = (mp: Allocator, body: StringView, key: StringView) StringView {
    v: Slice<u8> = body.view()
    mp.json_string_at(v, body.json_top_field(key))
}
lsp_init_params* = (mp: Allocator, body: StringView) LspInit {
    v: Slice<u8> = body.view()
    params = body.json_top_field("params")
    folders = v.json_field_in(params, "workspaceFolders")
    first = v.json_first_array_value(folders)
    furi = v.json_field_in(first, "uri")
    workspace ::= mp.json_string_at(v, furi)
    is_empty(workspace).then({
        workspace = mp.json_string_at(v, v.json_field_in(params, "rootUri"))
    })
    caps = v.json_field_in(params, "capabilities")
    textdoc = v.json_field_in(caps, "textDocument")
    rename = v.json_field_in(textdoc, "rename")
    prep = v.json_bool_at(v.json_field_in(rename, "prepareSupport"))
    wcap = v.json_field_in(caps, "workspace")
    we = v.json_field_in(wcap, "workspaceEdit")
    docs = v.json_bool_at(v.json_field_in(we, "documentChanges"))
    LspInit(
        workspace_uri: workspace,
        rename_prepare: prep == 1,
        document_changes: docs == 1,
    )
}
lsp_position_params* = (mp: Allocator, body: StringView) LspPosition {
    v: Slice<u8> = body.view()
    params = body.json_top_field("params")
    textdoc = v.json_field_in(params, "textDocument")
    uri = mp.json_string_at(v, v.json_field_in(textdoc, "uri"))
    pos = v.json_field_in(params, "position")
    line = v.json_uint_at(v.json_field_in(pos, "line"))
    ch = v.json_uint_at(v.json_field_in(pos, "character"))
    LspPosition(
        ok: is_empty(uri) == false && line >= 0 && ch >= 0,
        uri: uri,
        line: line,
        character: ch,
    )
}
lsp_document_uri = (mp: Allocator, body: StringView) StringView {
    v: Slice<u8> = body.view()
    params = body.json_top_field("params")
    textdoc = v.json_field_in(params, "textDocument")
    mp.json_string_at(v, v.json_field_in(textdoc, "uri"))
}
// the top-level request id as a raw JSON fragment, echoed verbatim into the reply.
lsp_id = (mp: Allocator, body: StringView) StringView {
    v: Slice<u8> = body.view()
    p = body.json_top_field("id")
    (p < 0).then({ "null" }, { mp.json_raw_at(v, p) })
}
// ── URI -> filesystem path (strip a leading `file://`; percent-decoding is a later refinement) ─────
lsp_has_prefix = (s: StringView, pre: StringView) bool {
    sv: Slice<u8> = s.view()
    pv: Slice<u8> = pre.view()
    (sv.len < pv.len).then({ false }, { lsp_prefix_bytes(sv, pv, 0) })
}
lsp_prefix_bytes = (sv: Slice<u8>, pv: Slice<u8>, i: i64) bool {
    (i >= pv.len).match ({
        true  => true,
        false => (sv[i] == pv[i]).then({ sv.lsp_prefix_bytes(pv, i + 1) }, { false }),
    })
}
lsp_uri_path = (mp: Allocator, uri: StringView) StringView {
    uri.lsp_has_prefix("file://").match ({
        true  => mp.cstr_substr(uri, 7, to_i32(uri.view().len - 7)),
        false => uri,
    })
}
// ── DiagSpan (1-based line/col, 1-based-inclusive end_col) -> LSP 0-based range ────────────────────
// LSP is 0-based: line -> line-1, start.character -> col-1. end_col is the 1-based inclusive last
// column, numerically the 0-based EXCLUSIVE end — so end.character = end_col (never a further -1). An
// unlocated span (line 0) is pinned to the file start with a 1-char range so the squiggle is visible.
ZSpan: {
    l: i64,
    c: i64,
    e: i64,
}
lsp_end_char = (sp: DiagSpan) i64 {
    ec = to_i64(sp.end_col)
    cc = to_i64(sp.col - 1)
    (ec > cc).then({ ec }, { cc + 1 })
}
lsp_zero_span = (sp: DiagSpan) ZSpan {
    (sp.line > 0).match ({
        true  => ZSpan(
            l: to_i64(sp.line - 1),
            c: (sp.col > 0).then({ to_i64(sp.col - 1) }, { 0 }),
            e: sp.lsp_end_char(),
        ),
        false => ZSpan(
            l: 0,
            c: 0,
            e: 1,
        ),
    })
}
// ── byte columns -> UTF-16 columns (LSP `character` counts UTF-16 CODE UNITS, not bytes) ──────────
// zenc spans are byte columns into the source line; a client fed byte columns misplaces squiggles on
// any line with non-ASCII bytes before the error. Conversion walks the located line once: every
// non-continuation byte counts 1 unit, and a 4-byte UTF-8 lead (>= 0xF0, a supplementary-plane char)
// counts 2 (its UTF-16 surrogate pair).
lsp_line_start = (v: Slice<u8>, ln: i64) i64 {
    k :: i64 = 0
    zero: i64 = 0
    zero.step_while((i) { k < ln && i < v.len }, (i) {
        (v[i] == '\n').then({
            k = k + 1
        })
        i + 1
    })
}
lsp_utf16_col = (v: Slice<u8>, ls: i64, bytecol: i64) i64 {
    u :: i64 = 0
    end = ls + bytecol
    ls.step_while((i) { i < v.len && i < end && v[i] != '\n' }, (i) {
        bi = v[i].to_i64()
        (bi & 192 != 128).then({
            u = u + (bi >= 240).then({ 2 }, { 1 })
        })
        i + 1
    })
    u
}
// ── one diagnostic -> one LSP Diagnostic object, accumulated (comma-separated) into the array ──────
DiagAcc: {
    sb: String,
    n: i32,
}
lsp_push_diag = (
    mp: Allocator,
    acc: DiagAcc,
    rp: ResolvedProgram,
    raw: MutSlice<Decl>,
    decls: MutSlice<Decl>,
    path: StringView,
    user: StringView,
    cd: CheckDiagnostic,
) DiagAcc {
    (cd.code == 0).match ({
        true  => acc,
        false => {
            dl = rp.locate_diag(cd.source_offset, cd.span_width, path, user)
            z = lsp_zero_span(dl.sp)
            // byte -> UTF-16 columns against the line the span actually points into (dl.src is the
            // owning module's source; for the open document it IS the client's text).
            sv: Slice<u8> = dl.src.view()
            ls = sv.lsp_line_start(z.l)
            zc ::= sv.lsp_utf16_col(ls, z.c)
            ze ::= sv.lsp_utf16_col(ls, z.e)
            ze = (ze > zc).then({ ze }, { zc + 1 })
            // enrich exactly like the CLI (emit_one): denriched message + world-teaching undefined-name hint.
            msg = desc_or(mp.denrich_check(raw, decls, cd.source_offset, cd.code, cd.kind), cd.message)
            hint ::= cd.hint
            (cd.kind == "undefined-name").then({
                wh = mp.undefined_name_hint(rp.table, rp.flat, cd.source_offset)
                (is_empty(wh) == false).then({
                    hint = wh
                })
            })
            full ::= is_empty(hint).match ({
                true  => msg,
                false => mp.String(128).add(msg, " — ", hint).finish_cstr(),
            })
            // an error living in an IMPORTED module (dl.path != the open document) must not squiggle
            // an unrelated range of the open file: pin it to the file head and name the real location
            // in the message, so the information survives without a lying range.
            line :: i64 = z.l
            (dl.path == path).match ({
                true  => 0,
                false => {
                    line = 0
                    zc = 0
                    ze = 1
                    full = mp.String(128)
                        .add("in imported module ")
                        .add(dl.path)
                        .add(":")
                        .push_int(mp, to_i64(dl.sp.line))
                        .add(": ")
                        .add(full)
                        .finish_cstr()
                    0
                },
            })
            sep = (acc.n > 0).then({ "," }, { "" })
            sb2 = acc.sb
                .add(sep)
                .add("{\"range\":{\"start\":{\"line\":")
                .push_int(mp, line)
                .add(",\"character\":")
                .push_int(mp, zc)
                .add("},\"end\":{\"line\":")
                .push_int(mp, line)
                .add(",\"character\":")
                .push_int(mp, ze)
                .add("}},\"severity\":1,\"code\":")
                .push_jstr(mp, cd.kind)
                .add(",\"source\":\"zen\",\"message\":")
                .push_jstr(mp, full)
                .add("}")
            DiagAcc(
                sb: sb2,
                n: acc.n + 1,
            )
        },
    })
}
// run the pipeline on `text` and PUBLISH. Structural blockers (no-if, parse) are reported ALONE —
// their flat sentinels would otherwise spray bogus type errors. Otherwise every specialized semantic
// channel (reserved/ownership/escape/leak/…/mustuse) contributes its diagnostic AND the whole main
// batch (names/types/arity/exhaustiveness/…) is collected, so an ownership error shows alongside type
// errors rather than one channel hiding the rest. Empty array => clears old squiggles.
// one whole-file diagnostic carrying `msg` verbatim — the shape a REJECTED resolve reports through.
lsp_head_diag = (mp: Allocator, msg: StringView) StringView {
    mp.String(256)
        .add("{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":1}},\"severity\":1,\"code\":\"unresolved-import\",\"source\":\"zen\",\"message\":")
        .push_jstr(mp, mp.lsp_trim_nl(msg))
        .add("}")
        .finish_cstr()
}
// the latched rejection text is newline-terminated (it was written straight to stderr); an LSP
// message keeps its internal newlines (hint lines) but never a trailing one.
lsp_trim_nl = (mp: Allocator, s: StringView) StringView {
    v: Slice<u8> = s.view()
    (v.len > 0 && v[v.len - 1] == '\n').then({ mp.cstr_substr(s, 0, to_i32(v.len - 1)) }, { s })
}
lsp_diags_array = (mp: Allocator, root: StringView, path: StringView, text: StringView) StringView {
    rp = mp.resolve_program_data(root, mp.dirname(path), path, text)
    // A REJECTED resolve (unknown module / unknown name / dup-fn …) is reported ALONE and the server
    // stays up: half of every import line a user types names a module that does not exist yet, and the
    // flat built from a missing module would otherwise spray bogus undefined-name errors over the file.
    resolve_failed().then({
        return mp.lsp_head_diag(resolve_message())
    })
    raw = mp.parse_module(rp.flat)
    decls = mp.resolve_module(raw)
    nif = check_module_no_if_diagnostic_from_source(rp.flat)
        .cd_or(check_module_no_ternary_diagnostic_from_source(rp.flat))
        .cd_or(check_module_no_coroutine_diagnostic_from_source(rp.flat))
    pars = mp.check_module_parse_diagnostic_from_source(decls, rp.flat)
    acc = DiagAcc(
        sb: mp.String(256),
        n: 0,
    )
    done = (nif.code != 0).match ({
        true  => mp.lsp_push_diag(acc, rp, raw, decls, path, text, nif),
        false => (pars.code != 0).match ({
            true  => mp.lsp_push_diag(acc, rp, raw, decls, path, text, pars),
            false => {
                a ::= acc
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_reserved_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_ownership_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_leak_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_addr_escape_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_send_rc_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_scratch_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_send_mut_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_bound_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_arg_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_or_return_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_unknown_type_diagnostic_from_source(decls, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_ffi_diagnostic_from_source(decls, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, check_module_infinite_type_diagnostic_from_source(decls, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, check_module_main_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_mustuse_diagnostic_from_source(raw, rp.flat))
                ds = mp.check_module_batch_vis(decls, rp.flat, mp.ufcs_vis_of(rp.flat, rp.regions, rp.table))
                ds.loop_at((i, cd) { a = mp.lsp_push_diag(a, rp, raw, decls, path, text, cd) })
                a
            },
        }),
    })
    done.sb.finish_cstr()
}
lsp_publish = (mp: Allocator, root: StringView, uri: StringView, text: StringView) i64 {
    arr = mp.lsp_diags_array(root, mp.lsp_uri_path(uri), text)
    mp.lsp_send(mp.String(512).add("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":").push_jstr(mp, uri).add(",\"diagnostics\":[").add(arr).add("]}}").finish_cstr())
}
// ── request/notification handlers ─────────────────────────────────────────────────────────────────
lsp_session_own = (s: MutPtr<LspSession>, text: StringView) StringView {
    v: Slice<u8> = text.view()
    (v.len == 0).then({
        return ""
    })
    p = s.durable.acquire(v.len + 1)
    (p == null_ptr()).then({
        return ""
    })
    memcpy(p, v.ptr, v.len)
    p.offset(v.len).store(0)
    cstr(p)
}
lsp_apply_init = (s: MutPtr<LspSession>, init: LspInit) void {
    (is_empty(s.workspace_uri) == false).then({
        s.durable.release(s.workspace_uri.offset(0))
    })
    s.workspace_uri = s.lsp_session_own(init.workspace_uri)
    s.rename_prepare = init.rename_prepare
    s.document_changes = init.document_changes
}
lsp_reply_initialize = (session: MutPtr<LspSession>, mp: Allocator, body: StringView) i64 {
    session.lsp_apply_init(mp.lsp_init_params(body))
    mp.lsp_send(mp.String(288).add("{\"jsonrpc\":\"2.0\",\"id\":").add(mp.lsp_id(body)).add(",\"result\":{\"capabilities\":{\"positionEncoding\":\"utf-16\",\"textDocumentSync\":1,\"definitionProvider\":true,\"declarationProvider\":true,\"referencesProvider\":true,\"documentHighlightProvider\":true,\"workspaceSymbolProvider\":true,\"renameProvider\":").add(session.rename_prepare.match ({
        true  => "{\"prepareProvider\":true}",
        false => "true",
    })).add(",\"hoverProvider\":true,\"documentSymbolProvider\":true,\"completionProvider\":{\"resolveProvider\":false},\"semanticTokensProvider\":{\"legend\":{\"tokenTypes\":").add(lspt_legend()).add(",\"tokenModifiers\":[]},\"full\":true}},\"serverInfo\":{\"name\":\"zenc-lsp\",\"version\":\"0.2.0-dev\"}}}").finish_cstr())
}
// ── go-to-definition / hover / completion (the textual query features) ──────────────────────────
// The scanning these share — cursor position → the identifier under it → the FILE's top-level
// declaration of that name — lives in compiler.lsp_query, so all three ask one scanner. Textual
// (ctags-style) rather than resolver-backed: it resolves same-file top-level decls (fn/type/const),
// which is the common jump, and it keeps working on the half-typed buffer an editor actually holds.
// Cross-file targets, locals and overload-precise resolution are the documented next slices.
// reply with one exact source byte span converted to a UTF-16 Location range.
lsp_reply_location_span = (
    mp: Allocator,
    body: StringView,
    uri: StringView,
    source: StringView,
    start: i64,
    end: i64,
) i64 {
    sb = mp.String(256)
        .add("{\"jsonrpc\":\"2.0\",\"id\":")
        .add(mp.lsp_id(body))
        .add(",\"result\":{\"uri\":")
        .push_jstr(mp, uri)
        .add(",\"range\":")
    sv: Slice<u8> = source.view()
    out = lsp_push_range(sb, mp, sv, start, end).add("}}").finish_cstr()
    mp.lsp_send(out)
}
lsp_push_location = (
    sb: String,
    mp: Allocator,
    docs: MutPtr<LspDocs>,
    span: SymbolSourceSpan,
) String {
    source = mp.lsp_source_for_path(docs, span.path)
    sv: Slice<u8> = source.view()
    sb
        .add("{\"uri\":")
        .push_jstr(mp, mp.lsp_path_uri(span.path))
        .add(",\"range\":")
        .lsp_push_range(mp, sv, span.start.to_i64(), span.end.to_i64())
        .add("}")
}
lsp_push_text_edit = (
    sb: String,
    mp: Allocator,
    docs: MutPtr<LspDocs>,
    span: SymbolSourceSpan,
    name: StringView,
) String {
    source = mp.lsp_source_for_path(docs, span.path)
    sv: Slice<u8> = source.view()
    sb
        .add("{\"range\":")
        .lsp_push_range(mp, sv, span.start.to_i64(), span.end.to_i64())
        .add(",\"newText\":")
        .push_jstr(mp, name)
        .add("}")
}
LspTarget: {
    ok: bool,
    semantic: LspSemantic,
    key: SymbolKey,
}
lsp_empty_key = () SymbolKey {
    SymbolKey(
        module: "",
        owner: "",
        name: "",
        kind: .Unknown,
        pos: 0,
    )
}
lsp_target_at = (
    mp: Allocator,
    docs: MutPtr<LspDocs>,
    root: StringView,
    workspace_uri: StringView,
    pos: LspPosition,
) LspTarget {
    sem = mp.lsp_semantic_index(docs, root, workspace_uri, pos.uri)
    out ::= LspTarget(
        ok: false,
        semantic: sem,
        key: lsp_empty_key(),
    )
    sem.ok.then({
        sv: Slice<u8> = sem.source.view()
        off = sv.lsp_byte_of_pos(pos.line, pos.character, 0, 0)
        sem.index.symbol_at(sem.path, off.to_i32()).match ({
            .Some(key) => {
                out.ok = true
                out.key = key
            },
            .None      => { },
        })
    })
    out
}
lsp_context_bool = (body: StringView, key: StringView) bool {
    v: Slice<u8> = body.view()
    params = body.json_top_field("params")
    context = v.json_field_in(params, "context")
    v.json_bool_at(v.json_field_in(context, key)) == 1
}
lsp_references = (
    mp: Allocator,
    session: MutPtr<LspSession>,
    root: StringView,
    body: StringView,
) i64 {
    pos = mp.lsp_position_params(body)
    (pos.ok == false).then({
        return mp.lsp_reply_invalid_params(body)
    })
    target = mp.lsp_target_at(session.docs.addr(), root, session.workspace_uri, pos)
    (target.ok == false).then({
        return mp.lsp_reply_null(body)
    })
    include_decl = body.lsp_context_bool("includeDeclaration")
    occs = target.semantic.index.occurrences_of(mp, target.key)
    sb ::= mp.String(512).add("{\"jsonrpc\":\"2.0\",\"id\":").add(mp.lsp_id(body)).add(",\"result\":[")
    first ::= true
    occs.loop_at((i, o) {
        (include_decl || o.declaration == false).then({
            sb = sb
                .add(first.then({ "" }, { "," }))
                .lsp_push_location(mp, session.docs.addr(), o.span)
            first = false
        })
    })
    mp.lsp_send(sb.add("]}").finish_cstr())
}
lsp_document_highlight = (
    mp: Allocator,
    session: MutPtr<LspSession>,
    root: StringView,
    body: StringView,
) i64 {
    pos = mp.lsp_position_params(body)
    (pos.ok == false).then({
        return mp.lsp_reply_invalid_params(body)
    })
    target = mp.lsp_target_at(session.docs.addr(), root, session.workspace_uri, pos)
    (target.ok == false).then({
        return mp.lsp_reply_null(body)
    })
    occs = target.semantic.index.occurrences_of(mp, target.key)
    sb ::= mp.String(512).add("{\"jsonrpc\":\"2.0\",\"id\":").add(mp.lsp_id(body)).add(",\"result\":[")
    first ::= true
    occs.loop_at((i, o) {
        (o.span.path == target.semantic.path).then({
            source = mp.lsp_source_for_path(session.docs.addr(), o.span.path)
            sv: Slice<u8> = source.view()
            sb = sb
                .add(first.then({ "" }, { "," }))
                .add("{\"range\":")
                .lsp_push_range(mp, sv, o.span.start.to_i64(), o.span.end.to_i64())
                .add(",\"kind\":1}")
            first = false
        })
    })
    mp.lsp_send(sb.add("]}").finish_cstr())
}
lsp_prepare_rename = (
    mp: Allocator,
    session: MutPtr<LspSession>,
    root: StringView,
    body: StringView,
) i64 {
    pos = mp.lsp_position_params(body)
    (pos.ok == false).then({
        return mp.lsp_reply_invalid_params(body)
    })
    target = mp.lsp_target_at(session.docs.addr(), root, session.workspace_uri, pos)
    (target.ok == false || target.key.lsp_renamable() == false).then({
        return mp.lsp_reply_null(body)
    })
    target.semantic.index.declaration(target.key).match ({
        .Some(d) => {
            source = mp.lsp_source_for_path(session.docs.addr(), d.span.path)
            sv: Slice<u8> = source.view()
            mp.lsp_send(mp.String(192).add("{\"jsonrpc\":\"2.0\",\"id\":").add(mp.lsp_id(body)).add(",\"result\":{\"range\":").lsp_push_range(mp, sv, d.span.start.to_i64(), d.span.end.to_i64()).add(",\"placeholder\":").push_jstr(mp, d.name).add("}}").finish_cstr())
        },
        .None    => mp.lsp_reply_null(body),
    })
}
lsp_occ_first_path = (occs: MutSlice<SymbolOccurrence>, upto: i64, path: StringView) bool {
    first ::= true
    zero: i64 = 0
    zero.step_while((i) { i < upto }, (i) {
        (occs[i].span.path == path).then({
            first = false
        })
        i + 1
    })
    first
}
lsp_push_path_edits = (
    sb: String,
    mp: Allocator,
    docs: MutPtr<LspDocs>,
    occs: MutSlice<SymbolOccurrence>,
    path: StringView,
    name: StringView,
) String {
    out ::= sb
    first ::= true
    occs.loop_at((i, o) {
        (o.span.path == path).then({
            out = out.add(first.then({ "" }, { "," })).lsp_push_text_edit(mp, docs, o.span, name)
            first = false
        })
    })
    out
}
lsp_reply_rename = (
    mp: Allocator,
    session: MutPtr<LspSession>,
    body: StringView,
    occs: MutSlice<SymbolOccurrence>,
    name: StringView,
) i64 {
    sb ::= mp.String(1024).add("{\"jsonrpc\":\"2.0\",\"id\":").add(mp.lsp_id(body)).add(",\"result\":{")
    session.document_changes.match ({
        true  => {
            sb = sb.add("\"documentChanges\":[")
            first ::= true
            occs.loop_at((i, o) {
                occs.lsp_occ_first_path(i, o.span.path).then({
                    version = mp.lsp_version_for_path(session.docs.addr(), o.span.path)
                    sb = sb
                        .add(first.then({ "" }, { "," }))
                        .add("{\"textDocument\":{\"uri\":")
                        .push_jstr(mp, mp.lsp_path_uri(o.span.path))
                        .add(",\"version\":")
                    sb = (version < 0).then({ sb.add("null") }, { sb.push_int(mp, version) })
                    sb = sb
                        .add("},\"edits\":[")
                        .lsp_push_path_edits(mp, session.docs.addr(), occs, o.span.path, name)
                        .add("]}")
                    first = false
                })
            })
            sb = sb.add("]")
        },
        false => {
            sb = sb.add("\"changes\":{")
            first ::= true
            occs.loop_at((i, o) {
                occs.lsp_occ_first_path(i, o.span.path).then({
                    sb = sb
                        .add(first.then({ "" }, { "," }))
                        .push_jstr(mp, mp.lsp_path_uri(o.span.path))
                        .add(":[")
                        .lsp_push_path_edits(mp, session.docs.addr(), occs, o.span.path, name)
                        .add("]")
                    first = false
                })
            })
            sb = sb.add("}")
        },
    })
    mp.lsp_send(sb.add("}}").finish_cstr())
}
lsp_rename = (mp: Allocator, session: MutPtr<LspSession>, root: StringView, body: StringView) i64 {
    pos = mp.lsp_position_params(body)
    (pos.ok == false).then({
        return mp.lsp_reply_invalid_params(body)
    })
    v: Slice<u8> = body.view()
    params = body.json_top_field("params")
    name = mp.json_string_at(v, v.json_field_in(params, "newName"))
    (name.lsp_ident_name() == false).then({
        return mp.lsp_reply_invalid_params(body)
    })
    target = mp.lsp_target_at(session.docs.addr(), root, session.workspace_uri, pos)
    (target.ok == false
        || target.key.lsp_renamable() == false
        || target.semantic.index.lsp_rename_collision(target.key, name)).then({
        return mp.lsp_reply_invalid_params(body)
    })
    mp.lsp_reply_rename(session, body, target.semantic.index.occurrences_of(mp, target.key), name)
}
// read a non-negative integer JSON field by key (e.g. position.line / .character).
lsp_json_int = (body: StringView, key: StringView) i64 {
    v: Slice<u8> = body.view()
    p = v.json_find_key(key)
    (p < 0).then({ 0 }, { v.lsp_parse_dec(p, 0) })
}
lsp_parse_dec = (v: Slice<u8>, i: i64, acc: i64) i64 {
    (i < v.len && v[i] >= '0' && v[i] <= '9').match ({
        true  => v.lsp_parse_dec(i + 1, acc * 10 + (v[i] - '0').to_i64()),
        false => acc,
    })
}
// the text of `uri` AS THE CLIENT SEES IT: the open buffer when the document is in the store, the
// file on disk otherwise (a jump target the editor never opened). "" = neither, i.e. unreadable.
lsp_doc_text = (mp: Allocator, docs: MutPtr<LspDocs>, uri: StringView) StringView {
    i = docs.lspd_find(uri)
    (i >= 0).match ({
        true  => docs.lspd_text_at(i),
        false => contents_in(mp.addr(), mp.lsp_uri_path(uri)).match ({
            .Ok(txt) => txt,
            .Err(er) => "",
        }),
    })
}
// `file://` URI for a filesystem path — the inverse of lsp_uri_path, needed for a jump target the
// client never named (the file of an imported module).
lsp_path_uri = (mp: Allocator, path: StringView) StringView {
    mp.String(128).add("file://").add(path).finish_cstr()
}
LspSemantic: {
    ok: bool,
    path: StringView,
    source: StringView,
    index: SymbolIndex,
}
lsp_empty_index = () SymbolIndex {
    SymbolIndex(
        decls: slice(null_ptr(), 0),
        occurrences: slice(null_ptr(), 0),
    )
}
lsp_doc_overlays = (mp: Allocator, docs: MutPtr<LspDocs>) MutSlice<SourceOverlay> {
    n = docs.lspd_count()
    (n <= 0).then({
        return slice(null_ptr(), 0)
    })
    out ::= cbuf<SourceOverlay>(mp, n)
    out.loop_at((i, o) {
        out[i] = SourceOverlay(
            path: mp.lsp_uri_path(docs.lspd_uri_at(i)),
            source: docs.lspd_text_at(i),
        )
    })
    out
}
lsp_progdir = (mp: Allocator, workspace_uri: StringView, path: StringView) StringView {
    is_empty(workspace_uri).then({ mp.dirname(path) }, { mp.lsp_uri_path(workspace_uri) })
}
lsp_semantic_index = (
    mp: Allocator,
    docs: MutPtr<LspDocs>,
    root: StringView,
    workspace_uri: StringView,
    uri: StringView,
) LspSemantic {
    path = mp.lsp_uri_path(uri)
    source = mp.lsp_doc_text(docs, uri)
    is_empty(source).then({
        return LspSemantic(
            ok: false,
            path: path,
            source: source,
            index: lsp_empty_index(),
        )
    })
    idx = mp.resolve_symbol_index(root, mp.lsp_progdir(workspace_uri, path), path, source, mp.lsp_doc_overlays(docs))
    LspSemantic(
        ok: resolve_failed() == false,
        path: path,
        source: source,
        index: idx,
    )
}
lsp_source_for_path = (mp: Allocator, docs: MutPtr<LspDocs>, path: StringView) StringView {
    found ::= ""
    zero: i64 = 0
    zero.step_while((i) { i < docs.lspd_count() }, (i) {
        (is_empty(found) && mp.lsp_uri_path(docs.lspd_uri_at(i)) == path).then({
            found = docs.lspd_text_at(i)
        })
        i + 1
    })
    is_empty(found).match ({
        true  => contents_in(mp.addr(), path).match ({
            .Ok(src) => src,
            .Err(e)  => "",
        }),
        false => found,
    })
}
lsp_version_for_path = (mp: Allocator, docs: MutPtr<LspDocs>, path: StringView) i64 {
    version ::= 0 - 1
    zero: i64 = 0
    zero.step_while((i) { i < docs.lspd_count() }, (i) {
        (version < 0 && mp.lsp_uri_path(docs.lspd_uri_at(i)) == path).then({
            version = docs.lspd_version_at(i)
        })
        i + 1
    })
    version
}
lsp_renamable = (key: SymbolKey) bool {
    key.kind == .Function
        || key.kind == .Global
        || key.kind == .Method
        || key.kind == .Let
        || key.kind == .Param
}
lsp_ident_name = (name: StringView) bool {
    v: Slice<u8> = name.view()
    (v.len == 0).then({
        return false
    })
    first = v[0]
    (first != 95 && (first < 97 || first > 122) && (first < 65 || first > 90)).then({
        return false
    })
    valid ::= true
    v.loop_at((i, b) {
        (b.lsp_is_ident_byte() == false).then({
            valid = false
        })
    })
    valid && name.lspq_reserved_name() == false && name.is_intrinsic() == false
}
lsp_rename_collision = (idx: SymbolIndex, key: SymbolKey, name: StringView) bool {
    collision ::= false
    idx.decls.loop_at((i, d) {
        same_key = d.key.symbol_key_eq(key)
        same_scope = (key.kind == .Method).match ({
            true  => d.key.kind == .Method && d.key.module == key.module && d.key.owner == key.owner,
            false => (key.kind == .Let).match ({
                true  => (d.key.kind == .Let || d.key.kind == .Param)
                    && d.key.module == key.module
                    && d.key.owner == key.owner,
                false => (key.kind == .Param).match ({
                    true  => (d.key.kind == .Let || d.key.kind == .Param)
                        && d.key.module == key.module
                        && d.key.owner == key.owner,
                    false => d.key.module == key.module && is_empty(d.key.owner),
                }),
            }),
        })
        (same_key == false && same_scope && d.name == name).then({
            collision = true
        })
    })
    (key.kind == .Function || key.kind == .Global).then({
        idx.occurrences.loop_at((i, target) {
            target.key.symbol_key_eq(key).then({
                idx.occurrences.loop_at((j, other) {
                    (other.key.symbol_key_eq(key) == false
                        && other.span.module == target.span.module
                        && other.key.name == name).then({
                        collision = true
                    })
                })
            })
        })
    })
    collision
}
lsp_decl_pos = (decls: MutSlice<Decl>, name: StringView) i32 {
    found :: i32 = 0
    decls.loop_at((i, d) {
        p = d.match ({
            .DFunc(f)      => (f.name == name).then({ f.pos }, { 0 }),
            .DForeign(f)   => (f.name == name).then({ f.pos }, { 0 }),
            .DStruct(sd)   => (sd.name == name).then({ sd.pos }, { 0 }),
            .DGenStruct(g) => (g.name == name).then({ g.pos }, { 0 }),
            .DEnum(ed)     => (ed.name == name).then({ ed.pos }, { 0 }),
            .DGenEnum(g)   => (g.name == name).then({ g.pos }, { 0 }),
            .DGlobal(g)    => (g.name == name).then({ g.pos }, { 0 }),
            _              => 0,
        })
        (found == 0).then({
            found = p
        })
    })
    found
}
// Semantic definition/declaration covers every positioned symbol the index understands. The textual
// top-level scan is retained only for unsupported syntax or a temporarily broken buffer.
lsp_definition = (
    mp: Allocator,
    session: MutPtr<LspSession>,
    root: StringView,
    body: StringView,
) i64 {
    pos = mp.lsp_position_params(body)
    (pos.ok == false).then({
        return mp.lsp_reply_invalid_params(body)
    })
    target = mp.lsp_target_at(session.docs.addr(), root, session.workspace_uri, pos)
    target.ok.then({
        target.semantic.index.declaration(target.key).match ({
            .Some(d) => {
                source = mp.lsp_source_for_path(session.docs.addr(), d.span.path)
                return mp.lsp_reply_location_span(body, mp.lsp_path_uri(d.span.path), source, d.span.start, d.span.end)
            },
            .None    => { },
        })
    })
    txt = mp.lsp_doc_text(session.docs.addr(), pos.uri)
    v: Slice<u8> = txt.view()
    off = v.lsp_byte_of_pos(pos.line, pos.character, 0, 0)
    start = v.lsp_ident_start(off)
    end = v.lsp_ident_end(off)
    (end <= start).then({
        return mp.lsp_reply_null(body)
    })
    name: Slice<u8> = v.ptr.offset(start).slice(end - start)
    decl = v.lsp_find_def(name, 0, true)
    (decl < 0).match ({
        true  => mp.lsp_reply_null(body),
        false => mp.lsp_reply_location_span(body, pos.uri, txt, decl, decl + end - start),
    })
}
lsp_workspace_symbol_kind = (kind: SymbolKind) i64 {
    kind.match ({
        .Function => 12,
        .Global   => 13,
        .Type     => 23,
        .Method   => 6,
        .Unknown  => 0,
        .Let      => 0,
        .Param    => 0,
    })
}
lsp_workspace_seen = (indexes: MutSlice<SymbolIndex>, upto: i64, decl: SymbolDecl) bool {
    seen ::= false
    zero: i64 = 0
    zero.step_while((i) { i < upto }, (i) {
        indexes[i].decls.loop_at((j, d) {
            (d.span.path == decl.span.path
                && d.span.start == decl.span.start
                && d.span.end == decl.span.end).then({
                seen = true
            })
        })
        i + 1
    })
    seen
}
lsp_sv_contains = (haystack: StringView, needle: StringView) bool {
    hn = strlen(haystack)
    nn = strlen(needle)
    (nn == 0).then({
        return true
    })
    (nn > hn).then({
        return false
    })
    hs: Slice<u8> = haystack.slice(hn)
    ns: Slice<u8> = needle.slice(nn)
    found ::= false
    zero: i64 = 0
    zero.step_while((i) { found == false && i + nn <= hn }, (i) {
        same ::= true
        ns.loop_at((j, b) {
            (same && hs[i + j] != b).then({
                same = false
            })
        })
        same.then({
            found = true
        })
        i + 1
    })
    found
}
lsp_workspace_symbol = (
    mp: Allocator,
    session: MutPtr<LspSession>,
    root: StringView,
    body: StringView,
) i64 {
    v: Slice<u8> = body.view()
    params = body.json_top_field("params")
    query_at = v.json_field_in(params, "query")
    (query_at < 0 || query_at >= v.len || v[query_at] != 34).then({
        return mp.lsp_reply_invalid_params(body)
    })
    query = mp.json_string_at(v, query_at)
    sb ::= mp.String(1024).add("{\"jsonrpc\":\"2.0\",\"id\":").add(mp.lsp_id(body)).add(",\"result\":[")
    first ::= true
    n = session.docs.lspd_count()
    (n > 0).then({
        indexes ::= cbuf<SymbolIndex>(mp, n)
        zero: i64 = 0
        zero.step_while((i) { i < n }, (i) {
            uri = session.docs.addr().lspd_uri_at(i)
            sem = mp.lsp_semantic_index(session.docs.addr(), root, session.workspace_uri, uri)
            indexes[i] = sem.ok.then({ sem.index }, { lsp_empty_index() })
            i + 1
        })
        indexes.loop_at((ri, idx) {
            idx.decls.loop_at((di, d) {
                kind = d.key.kind.lsp_workspace_symbol_kind()
                (kind > 0
                    && lsp_sv_contains(d.name, query)
                    && indexes.lsp_workspace_seen(ri, d) == false).then({
                    sb = sb
                        .add(first.then({ "" }, { "," }))
                        .add("{\"name\":")
                        .push_jstr(mp, d.name)
                        .add(",\"kind\":")
                        .push_int(mp, kind)
                        .add(",\"location\":")
                        .lsp_push_location(mp, session.docs.addr(), d.span)
                    (is_empty(d.key.owner) == false).then({
                        sb = sb.add(",\"containerName\":").push_jstr(mp, d.key.owner)
                    })
                    sb = sb.add("}")
                    first = false
                })
            })
        })
    })
    mp.lsp_send(sb.add("]}").finish_cstr())
}
// HOVER: the declaration under the cursor as markdown — a fenced signature plus the doc comment
// above it. compiler.lsp_query decides what that covers; "nothing to say" comes back as "" and is
// answered with a null result, the protocol's own spelling of "no hover here" (never an empty popup).
lsp_hover = (mp: Allocator, docs: MutPtr<LspDocs>, body: StringView) i64 {
    pos = mp.lsp_position_params(body)
    (pos.ok == false).then({
        return mp.lsp_reply_invalid_params(body)
    })
    txt = mp.lsp_doc_text(docs, pos.uri)
    md = mp.lspq_hover(txt, pos.line, pos.character)
    is_empty(md).then({
        return mp.lsp_reply_null(body)
    })
    mp.lsp_send(mp.String(512).add("{\"jsonrpc\":\"2.0\",\"id\":").add(mp.lsp_id(body)).add(",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":").push_jstr(mp, md).add("}}}").finish_cstr())
}
// COMPLETION: the names compiler.lsp_query can see from the buffer alone. `isIncomplete:false` is a
// promise that this IS the whole list for the position, so the client may filter it locally instead
// of asking again on the next keystroke — true here precisely because the list does not depend on
// the prefix being typed.
lsp_completion = (mp: Allocator, docs: MutPtr<LspDocs>, body: StringView) i64 {
    pos = mp.lsp_position_params(body)
    (pos.ok == false).then({
        return mp.lsp_reply_invalid_params(body)
    })
    items = mp.lspq_items(mp.lsp_doc_text(docs, pos.uri))
    sb ::= mp.String(2048)
        .add("{\"jsonrpc\":\"2.0\",\"id\":")
        .add(mp.lsp_id(body))
        .add(",\"result\":{\"isIncomplete\":false,\"items\":[")
    items.loop_at((i, it) {
        sb = sb
            .add((i > 0).then({ "," }, { "" }))
            .add("{\"label\":")
            .push_jstr(mp, it.label)
            .add(",\"kind\":")
            .push_int(mp, it.kind)
            .add(",\"detail\":")
            .push_jstr(mp, it.detail)
            .add("}")
    })
    mp.lsp_send(sb.add("]}}").finish_cstr())
}
// ── documentSymbol: the OUTLINE of the open buffer ────────────────────────────────────────────────
// LSP SymbolKind numbers (protocol §DocumentSymbol), spelled once so no call site carries a bare
// integer. Field=8 and EnumMember=22 are absent on purpose: neither a Field nor a VariantDef carries
// a source position in compiler.ast.ast_types, so there is nothing honest to point a range at.
LSP_SK_METHOD = () i64 { 6 }
LSP_SK_ENUM = () i64 { 10 }
LSP_SK_FUNCTION = () i64 { 12 }
LSP_SK_VARIABLE = () i64 { 13 }
LSP_SK_STRUCT = () i64 { 23 }
// 0-based line of byte `off`, walked ITERATIVELY — lsp_line_of recurses once per byte, which a
// definition can afford (one conversion per request) and an outline cannot (four per symbol).
lsp_line_at = (v: Slice<u8>, off: i64) i64 {
    ln :: i64 = 0
    zero: i64 = 0
    zero.step_while((i) { i < off && i < v.len }, (i) {
        (v[i] == '\n').then({
            ln = ln + 1
        })
        i + 1
    })
    ln
}
// byte offset of the start of the line `off` sits on.
lsp_bol_at = (v: Slice<u8>, off: i64) i64 {
    off.step_while((i) { i > 0 && v[i - 1] != '\n' }, (i) { i - 1 })
}
// one LSP Position for a byte offset. `character` is a UTF-16 code-unit column, not a byte column.
lsp_push_pos = (sb: String, mp: Allocator, v: Slice<u8>, off: i64) String {
    o = (off < v.len).then({ off }, { v.len })
    ls = v.lsp_bol_at(o)
    sb
        .add("{\"line\":")
        .push_int(mp, v.lsp_line_at(o))
        .add(",\"character\":")
        .push_int(mp, v.lsp_utf16_col(ls, o - ls))
        .add("}")
}
lsp_push_range = (sb: String, mp: Allocator, v: Slice<u8>, s: i64, e: i64) String {
    sb
        .add("{\"start\":")
        .lsp_push_pos(mp, v, s)
        .add(",\"end\":")
        .lsp_push_pos(mp, v, e)
        .add("}")
}
// one DocumentSymbol, up to but NOT including its `children` key — the caller closes the object.
// `selectionRange` is exactly the name (what the editor jumps to); `range` runs to `last`, which the
// caller widens to cover nested children. It is NOT the declaration's full source extent: no Decl in
// compiler.ast.ast_types carries an end offset, and inventing one by brace-matching would be a guess.
lsp_push_sym = (
    sb: String,
    mp: Allocator,
    v: MutSlice<u8>,
    name: StringView,
    kind: i64,
    off: i64,
    last: i64,
) String {
    sb
        .add("{\"name\":")
        .push_jstr(mp, name)
        .add(",\"kind\":")
        .push_int(mp, kind)
        .add(",\"range\":")
        .lsp_push_range(mp, v, off, last)
        .add(",\"selectionRange\":")
        .lsp_push_range(mp, v, off, off + name.view().len)
}
// a childless DocumentSymbol.
lsp_leaf_sym = (mp: Allocator, v: MutSlice<u8>, name: StringView, kind: i64, off: i64) StringView {
    mp.String(192)
        .lsp_push_sym(mp, v, name, kind, off, off + name.view().len)
        .add("}")
        .finish_cstr()
}
// the methods of ONE impl record, comma-joined ("" when it declares none that is positioned). The
// name emitted is the one the SOURCE writes: the parser HOISTS both a trait impl's methods and a type
// body's INHERENT methods into mangled `impl_<Tr>_<Ty>_<m>` top-level functions, and that mangled name
// must never reach the client — it supplies the position, the DImpl record supplies the name.
lsp_impl_syms = (mp: Allocator, decls: MutSlice<Decl>, v: MutSlice<u8>, im: ImplData) StringView {
    sb ::= mp.String(256)
    n ::= 0
    im.methods.loop_at((k, m) {
        off = to_i64(decls.lsp_decl_pos(mp.impl_cname_in(im.trname, im.ty, m.name)))
        (off > 0).then({
            sb = sb
                .add((n > 0).then({ "," }, { "" }))
                .add(mp.lsp_leaf_sym(v, m.name, LSP_SK_METHOD(), off))
            n = n + 1
        })
    })
    sb.finish_cstr()
}
// every method the file declares FOR type `ty`. A `Type.impl(Trait, { … })` block and a type body's
// inherent methods are both recorded as a DImpl (the inherent one names the type as its own trait),
// so one walk over the impls covers both spellings.
lsp_method_syms = (
    mp: Allocator,
    decls: MutSlice<Decl>,
    v: MutSlice<u8>,
    ty: StringView,
) StringView {
    sb ::= mp.String(384)
    n ::= 0
    decls.loop_at((i, d) {
        d.match ({
            .DImpl(im) => (im.ty == ty).then({
                one = mp.lsp_impl_syms(decls, v, im)
                (is_empty(one) == false).then({
                    sb = sb.add((n > 0).then({ "," }, { "" })).add(one)
                    n = n + 1
                })
            }),
            _          => { },
        })
    })
    sb.finish_cstr()
}
// the byte the method run of `ty` ends at, or `from` when it has none. A parent's `range` must ENCLOSE
// its children's, so the type symbol's range is stretched to its last method's name.
lsp_methods_end = (mp: Allocator, decls: MutSlice<Decl>, ty: StringView, from: i64) i64 {
    last ::= from
    decls.loop_at((i, d) {
        d.match ({
            .DImpl(im) => (im.ty == ty).then({
                im.methods.loop_at((k, m) {
                    off = to_i64(decls.lsp_decl_pos(mp.impl_cname_in(im.trname, im.ty, m.name)))
                    e = off + m.name.view().len
                    (off > 0 && e > last).then({
                        last = e
                    })
                })
            }),
            _          => { },
        })
    })
    last
}
// a TYPE symbol with its methods NESTED as `children` — what makes an outline an outline instead of a
// name list. Its FIELDS are not listed: a Field carries no position (the same AST gap that keeps
// go-to-definition off a field).
lsp_type_sym = (
    mp: Allocator,
    decls: MutSlice<Decl>,
    v: MutSlice<u8>,
    name: StringView,
    kind: i64,
    off: i64,
) StringView {
    mp.String(384)
        .lsp_push_sym(mp, v, name, kind, off, mp.lsp_methods_end(decls, name, off + name.view().len))
        .add(",\"children\":[")
        .add(mp.lsp_method_syms(decls, v, name))
        .add("]}")
        .finish_cstr()
}
// does THIS file declare the type `name`? An impl whose type lives in another file has no parent
// symbol here, so its methods are emitted at top level rather than dropped.
lsp_has_type = (decls: MutSlice<Decl>, name: StringView) bool {
    found ::= false
    decls.loop_at((i, d) {
        d.match ({
            .DStruct(sd)   => (sd.name == name).then({
                found = true
            }),
            .DGenStruct(g) => (g.name == name).then({
                found = true
            }),
            .DEnum(ed)     => (ed.name == name).then({
                found = true
            }),
            .DGenEnum(g)   => (g.name == name).then({
                found = true
            }),
            _              => { },
        })
    })
    found
}
// the DocumentSymbol JSON for one top-level declaration, "" when it is not one. Skipped: import
// records and module aliases (they name another file), trait defaults, raw C escapes, every
// SYNTHESIZED decl (pos 0 — the parser.s indexed payload records and its syntax-error sentinel), and
// every hoisted method function, which is re-emitted under its type instead.
lsp_decl_sym = (mp: Allocator, decls: MutSlice<Decl>, v: MutSlice<u8>, d: Decl) StringView {
    d.match ({
        .DFunc(f)      => (f.pos == 0 || mp.ff_is_hoisted(decls, f.name)).match ({
            true  => "",
            false => mp.lsp_leaf_sym(v, f.name, LSP_SK_FUNCTION(), to_i64(f.pos)),
        }),
        .DForeign(f)   => (f.pos == 0).match ({
            true  => "",
            false => mp.lsp_leaf_sym(v, f.name, LSP_SK_FUNCTION(), to_i64(f.pos)),
        }),
        .DStruct(sd)   => (sd.pos == 0).match ({
            true  => "",
            false => mp.lsp_type_sym(decls, v, sd.name, LSP_SK_STRUCT(), to_i64(sd.pos)),
        }),
        .DGenStruct(g) => (g.pos == 0).match ({
            true  => "",
            false => mp.lsp_type_sym(decls, v, g.name, LSP_SK_STRUCT(), to_i64(g.pos)),
        }),
        .DEnum(ed)     => (ed.pos == 0).match ({
            true  => "",
            false => mp.lsp_type_sym(decls, v, ed.name, LSP_SK_ENUM(), to_i64(ed.pos)),
        }),
        .DGenEnum(g)   => (g.pos == 0).match ({
            true  => "",
            false => mp.lsp_type_sym(decls, v, g.name, LSP_SK_ENUM(), to_i64(g.pos)),
        }),
        .DGlobal(g)    => (g.pos == 0 || g.alias).match ({
            true  => "",
            false => mp.lsp_leaf_sym(v, g.name, LSP_SK_VARIABLE(), to_i64(g.pos)),
        }),
        .DImpl(im)     => decls.lsp_has_type(im.ty).then({ "" }, { mp.lsp_impl_syms(decls, v, im) }),
        _              => "",
    })
}
// the whole `DocumentSymbol[]` body for `text` — the PARSE of the open buffer, and nothing else. Not
// the resolved program go-to-definition walks: that one flattens every imported module into a single
// decl list, and an outline that listed std's declarations as this document's would be a lie. Parsing
// alone also keeps the outline answering while an import line is half-typed.
lsp_symbols_json = (mp: Allocator, text: StringView) StringView {
    decls = mp.parse_module(text)
    v: Slice<u8> = text.view()
    sb ::= mp.String(1024)
    n ::= 0
    decls.loop_at((i, d) {
        one = mp.lsp_decl_sym(decls, v, d)
        (is_empty(one) == false).then({
            sb = sb.add((n > 0).then({ "," }, { "" })).add(one)
            n = n + 1
        })
    })
    sb.finish_cstr()
}
// DOCUMENT SYMBOL (`gO`, and the `]m`/`[m` method motions built on it). Answered from the OPEN
// BUFFER via lsp_doc_text, so an unsaved edit is in the outline the moment it is typed.
lsp_document_symbol = (mp: Allocator, docs: MutPtr<LspDocs>, body: StringView) i64 {
    syms = mp.lsp_symbols_json(mp.lsp_doc_text(docs, mp.json_str_field(body, "uri")))
    mp.lsp_send(mp.String(1024).add("{\"jsonrpc\":\"2.0\",\"id\":").add(mp.lsp_id(body)).add(",\"result\":[").add(syms).add("]}").finish_cstr())
}
lsp_send_tokens = (mp: Allocator, body: StringView, data: StringView) i64 {
    mp.lsp_send(mp.String(8192).add("{\"jsonrpc\":\"2.0\",\"id\":").add(mp.lsp_id(body)).add(",\"result\":{\"data\":").add(data).add("}}").finish_cstr())
}
// Semantic tokens for an OPEN document come from the client's buffer and are memoized against its
// LSP version, so the keystroke that does not change the version (a repeat request, a client that
// re-asks after a scroll) costs a lookup instead of a full lex of the file. A document the client
// has NOT opened is still read from disk — and not cached, since nothing then tells us when it
// changed. `lspd_set` drops the cache on every text write, so a hit can only ever be this text.
lsp_semantic_tokens = (mp: Allocator, docs: MutPtr<LspDocs>, body: StringView) i64 {
    uri = mp.json_str_field(body, "uri")
    i = docs.lspd_find(uri)
    (i >= 0).match ({
        true  => {
            cached = docs.lspd_tokens_at(i)
            data = is_empty(cached).match ({
                true  => {
                    fresh = mp.lspt_tokens(docs.lspd_text_at(i))
                    docs.lspd_cache_tokens(i, fresh)
                    fresh
                },
                false => cached,
            })
            mp.lsp_send_tokens(body, data)
        },
        false => contents_in(mp.addr(), mp.lsp_uri_path(uri)).match ({
            .Ok(txt) => mp.lsp_send_tokens(body, mp.lspt_tokens(txt)),
            .Err(er) => mp.lsp_reply_null(body),
        }),
    })
}
lsp_reply_invalid_params = (mp: Allocator, body: StringView) i64 {
    mp.lsp_send(mp.String(144).add("{\"jsonrpc\":\"2.0\",\"id\":").add(mp.lsp_id(body)).add(",\"error\":{\"code\":-32602,\"message\":\"invalid params\"}}").finish_cstr())
}
lsp_reply_null = (mp: Allocator, body: StringView) i64 {
    mp.lsp_send(mp.String(96).add("{\"jsonrpc\":\"2.0\",\"id\":").add(mp.lsp_id(body)).add(",\"result\":null}").finish_cstr())
}
// JSON-RPC MethodNotFound for a REQUEST we don't implement. A request left unanswered stalls the
// client (nvim blocks a hover round-trip until its timeout); the error reply fails it instantly.
lsp_reply_method_not_found = (mp: Allocator, body: StringView) i64 {
    mp.lsp_send(mp.String(128).add("{\"jsonrpc\":\"2.0\",\"id\":").add(mp.lsp_id(body)).add(",\"error\":{\"code\":-32601,\"message\":\"method not found\"}}").finish_cstr())
}
// notification families we deliberately swallow WITHOUT a reply (replying to a notification is a
// protocol violation). `id` presence alone is not the test: e.g. workspace/didChangeConfiguration
// params may contain an unrelated "id" key that the flat key scanner would find.
lsp_is_notification = (method: StringView) bool {
    method.lsp_has_prefix("$/")
        || method.lsp_has_prefix("textDocument/did")
        || method.lsp_has_prefix("workspace/did")
        || method == "initialized"
        || method == "exit"
}
// publish an EMPTY diagnostics array for `uri` (didClose: the client keeps stale squiggles otherwise).
lsp_publish_clear = (mp: Allocator, uri: StringView) i64 {
    mp.lsp_send(mp.String(160).add("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":").push_jstr(mp, uri).add(",\"diagnostics\":[]}}").finish_cstr())
}
// didOpen/didChange (full-sync) both carry the whole document text; the first `text` key is the
// document content (the URI's `text` in didOpen, the single contentChange's `text` in didChange) and
// `version` is the client's monotonic edit counter. Both land in the store — which takes ownership of
// the decoded uri/text and frees the pair they replace — and the publish then reads the text back
// OUT of the store, so diagnostics and highlighting are provably answering about the same bytes.
lsp_did_change = (mp: Allocator, docs: MutPtr<LspDocs>, root: StringView, body: StringView) i64 {
    uri = mp.json_str_field(body, "uri")
    i = docs.lspd_set(uri, mp.json_str_field(body, "text"), body.lsp_json_int("version"))
    mp.lsp_publish(root, uri, docs.lspd_text_at(i))
}
// dispatch one message. Returns 0 = keep serving, 1 = shutdown received, 2 = exit. Unknown
// NOTIFICATIONS are no-ops; an unknown REQUEST (an "id" key outside the notification families) gets
// a MethodNotFound error so the client never waits on a reply that will not come.
lsp_handle = (session: MutPtr<LspSession>, root: StringView, body: StringView) i32 {
    mp = session.requests.addr().allocator()
    docs = session.docs.addr()
    method = mp.json_top_string(body, "method")
    (method == "initialize").then({
        session.lsp_reply_initialize(mp, body)
        return 0
    })
    (method == "shutdown").then({
        mp.lsp_reply_null(body)
        return 1
    })
    (method == "exit").then({
        return 2
    })
    (method == "textDocument/didOpen" || method == "textDocument/didChange").then({
        mp.lsp_did_change(docs, root, body)
        return 0
    })
    (method == "textDocument/didClose").then({
        closed = mp.json_str_field(body, "uri")
        docs.lspd_close(closed)
        mp.lsp_publish_clear(closed)
        return 0
    })
    (method == "textDocument/definition" || method == "textDocument/declaration").then({
        mp.lsp_definition(session, root, body)
        return 0
    })
    (method == "textDocument/references").then({
        mp.lsp_references(session, root, body)
        return 0
    })
    (method == "textDocument/documentHighlight").then({
        mp.lsp_document_highlight(session, root, body)
        return 0
    })
    (method == "textDocument/prepareRename").then({
        mp.lsp_prepare_rename(session, root, body)
        return 0
    })
    (method == "textDocument/rename").then({
        mp.lsp_rename(session, root, body)
        return 0
    })
    (method == "workspace/symbol").then({
        mp.lsp_workspace_symbol(session, root, body)
        return 0
    })
    (method == "textDocument/hover").then({
        mp.lsp_hover(docs, body)
        return 0
    })
    (method == "textDocument/completion").then({
        mp.lsp_completion(docs, body)
        return 0
    })
    (method == "textDocument/documentSymbol").then({
        mp.lsp_document_symbol(docs, body)
        return 0
    })
    (method == "textDocument/semanticTokens/full").then({
        mp.lsp_semantic_tokens(docs, body)
        return 0
    })
    v: Slice<u8> = body.view()
    (body.json_top_field("id") >= 0 && lsp_is_notification(method) == false).then({
        mp.lsp_reply_method_not_found(body)
    })
    0
}
// ── stdio framing: read `Content-Length: N\r\n\r\n` headers, then exactly N body bytes ─────────────
LSP_HDR_CAP = () i64 { 1024 }
// sanity ceiling on a claimed body size (64 MiB). A hostile/corrupt `Content-Length: 100000000000000`
// would otherwise reach acquire(), fail, and null-deref-panic the server; over-limit frames are
// skipped like unparseable ones and the header scan resynchronizes on the next frame.
LSP_BODY_MAX = () i64 { 67108864 }
// read stdin one byte at a time into `buf` until the CRLFCRLF terminator (so we never over-read into
// the body). Returns the header length incl. terminator; 0 on clean EOF before any byte; -1 on error.
lsp_read_headers = (mp: Allocator, buf: RawPtr<u8>, off: i64) i64 {
    r = read(0, buf.offset(off), 1)
    (r <= 0).match ({
        true  => (off == 0).then({ 0 }, { 0 - 1 }),
        false => (off >= 3
            && load(buf.offset(off - 3)) == '\r'
            && load(buf.offset(off - 2)) == '\n'
            && load(buf.offset(off - 1)) == '\r'
            && load(buf.offset(off)) == '\n').match ({
            true  => off + 1,
            false => (off + 1 >= LSP_HDR_CAP()).match ({
                true  => 0 - 1,
                false => mp.lsp_read_headers(buf, off + 1),
            }),
        }),
    })
}
lsp_match_bytes = (buf: RawPtr<u8>, i: i64, wv: Slice<u8>, k: i64) bool {
    (k >= wv.len).match ({
        true  => true,
        false => (load(buf.offset(i + k)) == wv[k]).match ({
            true  => buf.lsp_match_bytes(i, wv, k + 1),
            false => false,
        }),
    })
}
lsp_match_at = (buf: RawPtr<u8>, i: i64, len: i64, word: StringView) bool {
    wv: Slice<u8> = word.view()
    (i + wv.len > len).then({ false }, { buf.lsp_match_bytes(i, wv, 0) })
}
// read a decimal starting at `i` (skipping leading spaces); -1 if no digit before end/non-space.
lsp_read_dec = (buf: RawPtr<u8>, i: i64, len: i64, acc: i64, started: bool) i64 {
    (i >= len).match ({
        true  => started.then({ acc }, { 0 - 1 }),
        false => {
            b = load(buf.offset(i))
            (b >= '0' && b <= '9').match ({
                true  => buf.lsp_read_dec(i + 1, len, acc * 10 + (b - '0').to_i64(), true),
                false => (b == ' ' && started == false).match ({
                    true  => buf.lsp_read_dec(i + 1, len, acc, false),
                    false => started.then({ acc }, { 0 - 1 }),
                }),
            })
        },
    })
}
lsp_content_length = (buf: RawPtr<u8>, i: i64, len: i64) i64 {
    (i >= len).match ({
        true  => 0 - 1,
        false => buf.lsp_match_at(i, len, "Content-Length:").match ({
            true  => buf.lsp_read_dec(i + 15, len, 0, false),
            false => buf.lsp_content_length(i + 1, len),
        }),
    })
}
// read exactly `n` body bytes into `buf` (read() may return short; loop until filled or EOF).
lsp_read_body = (buf: RawPtr<u8>, off: i64, n: i64) i64 {
    (off >= n).match ({
        true  => off,
        false => {
            r = read(0, buf.offset(off), n - off)
            (r <= 0).then({ off }, { buf.lsp_read_body(off + r, n) })
        },
    })
}
// the JSON-RPC stdio loop: frame -> dispatch, until `exit`. Exit code follows the LSP convention:
// 0 if `exit` arrived after `shutdown`, else 1 (also 1 if the stream closes without a clean shutdown).
lsp_cmd* = (mp: Allocator, root: StringView) i32 {
    session ::= lsp_session(mp)
    sp = session.addr()
    hbuf = sp.durable.acquire_or_die(LSP_HDR_CAP())
    request_mem = sp.requests.addr().allocator()
    shut ::= false
    code ::= 1
    repeat_while((frame) {
        hlen = mp.lsp_read_headers(hbuf, 0)
        (hlen <= 0).match ({
            true  => {
                code = shut.then({ 0 }, { 1 })
                false
            },
            false => {
                n = hbuf.lsp_content_length(0, hlen)
                (n < 0 || n > LSP_BODY_MAX()).match ({
                    true  => true,
                    false => {
                        body = request_mem.acquire_or_die(n + 1)
                        got = body.lsp_read_body(0, n)
                        body.offset(got).store(0)
                        act = sp.lsp_handle(root, cstr(body))
                        sp.requests.addr().reset()
                        (act == 1).then({
                            shut = true
                        })
                        (act == 2).match ({
                            true  => {
                                code = shut.then({ 0 }, { 1 })
                                false
                            },
                            false => true,
                        })
                    },
                })
            },
        })
    })
    sp.deinit()
    sp.durable.release(hbuf)
    code
}
