// tests/bench/drivers/computed_field_read.zen
// driver for bench_field.zen's computed_field_read; see vec_add.zen's
// header for why a driver exists at all.
//
// THE BODY, THE TYPE AND THE IMPL ALL COME FROM THE BENCH FILE.
// This driver used to redeclare `Rect`, `Circle` and the
// `Circle.impl(Rect, ..)` that supplies the computed dot -- three
// hand-mirrored copies of the thing under measurement, compared to
// the originals by nothing. `fields.computed_field_read_body(c)` is
// bench_field.zen's own function over bench_field.zen's own impl.
//
// The same dot as stored_field_read, supplied by an impl and
// re-evaluated on read -- if these two ever diverge, uniform access
// is not free. Budget: ns_op 2, allocs_op 0, bytes_op 0
// (bench_budgets.zen).

fields = bench_field

main = (env: Env) Res<i32, IoError> {
    c = fields.Circle(radius: 1.5);
    total ::= 0.0;
    Range(0, 10000000).loop((h, i) {
        total = total + fields.computed_field_read_body(c);
    });
    (total > 0.0).match({
        true  => Ok(0),
        false => Ok(1),
    });
}
