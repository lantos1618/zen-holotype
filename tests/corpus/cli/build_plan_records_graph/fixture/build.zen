Builder, BuildError = std.build

build = (b :: Builder) Res<(), BuildError> {
    native  = b.c_import("sys.demo", {
        headers: ["demo.h"],
        include_paths: [],
        defines: ["DEMO=1"],
        libraries: ["demo"],
        target: b.target(),
    }).try();
    support = b.lib("support", {
        src: Path("src/support.zen"),
        libs: [],
        paths: [],
    }).try();
    b.exe("app", {
        src: Path("src/main.zen"),
        deps: [native, support],
    }).try();
    Ok(())
}
