// tests/harness_boundaries.zen — BOUNDARY category for the Zen harness: Zen linting its OWN source for
// the no-hidden-heap / no-raw-primitive rules. This is the self-hosted port of ALL 8 source-grep
// tests in tests/test_primitive_boundaries.py — the compiler audits its own tree, in itself, with
// NO Python. Each sub-suite below mirrors one python test's regex + file-set + allowlist EXACTLY.
//
// PORTED (python fn → sub-suite):
//   1. test_examples_stay_above_raw_primitives          → "examples stay above raw primitives"
//   2. test_raw_checkpoint_stays_behind_…               → "raw checkpoint behind coroutine/runtime"
//   3. test_atwhile_stays_in_compiler_or_…              → "@while behind compiler/substrate"
//   4. test_raw_allocation_calls_stay_behind_…          → "raw-alloc behind allocator floor"
//   5. test_trace_gather_does_not_fall_back_…           → "trace gather uses owned scratch"
//   6. test_io_contents_allocator_path_uses_try_acquire → "io contents_in uses try_acquire"
//   7. test_map_try_paths_use_result_allocator_helpers  → "map try paths use result helpers"
//   8. test_fmt_try_numeric_writes_use_fallible_…       → "fmt try writes use fallible num helpers"
//
// NOT ported (added here):
//   9. scan set covers every non-test .zen                → "scan set covers every non-test .zen"
//  10. src/std imports no compiler module                 → "std imports no compiler module"
//  11. retired snake_case string spellings stay dead      → "retired snake_case string spellings…"
//
// HOW: enumerate the file set via `find ... > $ZT/ob_files.txt`, then read+scan each file in Zen.
// The set is NO LONGER the python rglob: it also names the repo-root driver.zen and build.zen, which
// the prefix-only glob never matched (see SUITE 9 — that omission hid the whole CLI). The scanner
// mirrors python's regexes over `//`-comment-stripped text; the single-file region tests mirror python's
// `_code(...).split(marker,1)[…]` substring slicing on comment-stripped source.
{ Malloc } = std.mem.alloc
{ out, contents_in, shell } = std.io.file
{ ne, view, is_empty, split_in, nbuf, find, contains, starts_with, substr } = std.text.str
{ new_in, push_in, finish_in } = std.text.string
{ expect } = std.core.result
{ run_suite, zo_path, zo_cmd } = harness_lib
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// SHARED byte-scan machinery: faithful port of python's `re` over `_code`-stripped source.
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// regex `\w` class member: [A-Za-z0-9_].
is_word_char = (b: u8) bool {
    b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z' || b >= '0' && b <= '9' || b == '_'
}
not_word = (b: u8) bool { b.is_word_char().then({ false }, { true }) }
// `(?<!\.)\b` boundary before sv[i]: prev byte is NOT a word char AND NOT `.` (keeps UFCS `.free(`
// method calls from matching). Written as a pure boolean for the `||`/`&&` chains below.
is_boundary_before = (b: u8) bool {
    (b < 'a' || b > 'z') && (b < 'A' || b > 'Z') && (b < '0' || b > '9') && b != '_' && b != '.'
}
// `\b` boundary before index i (plain word boundary; `.` is allowed, matching a bare `\bNAME`).
bb_plain = (sv: [u8], i: i64) bool { i == 0 || sv[i - 1].not_word() }
// `(?<!\.)\b` boundary before index i (word boundary that ALSO excludes a preceding `.`).
bb_dot = (sv: [u8], i: i64) bool { i == 0 || sv[i - 1].is_boundary_before() }
// `\s` skip: advance past spaces/tabs/newlines/CRs, returning the next index (or len at EOF).
skip_ws = (sv: Slice<u8>, j: i64) i64 {
    (j >= sv.len).match ({
        true  => j,
        false => {
            b = sv[j]
            (b == ' ' || b == '\t' || b == '\n' || b == '\r').then({ sv.skip_ws(j + 1) }, { j })
        },
    })
}
// do `nv`'s bytes appear at sv[at..]? (caller guards at + nv.len <= sv.len). `nv` is a `Slice<u8>`:
// a read-only window, so a needle taken from a literal (`"@while".view()`) is accepted here.
tok_at = (sv: [u8], nv: Slice<u8>, at: i64) bool {
    ok ::= true
    nv.loop((h, i, b) {
        (sv[at + i] == b == false).then({
            ok = false
            h.break
        })
    })
    ok
}
// the `\bNAME\s*\(` tail: keyword `name` starts at sv[i] AND is followed by `\s*(`. The trailing `(`
// is what rejects e.g. `mallocate` and distinguishes `load(` from `load_i64(`.
name_matches = (sv: [u8], i: i64, name: StringView) bool {
    nv = name.view()
    (i + nv.len > sv.len).match ({
        true  => false,
        false => sv.tok_at(nv, i).match ({
            true  => {
                j = sv.skip_ws(i + nv.len)
                j < sv.len && sv[j] == '('
            },
            false => false,
        }),
    })
}
// the `\bNAME\b` tail: keyword `name` starts at sv[i] AND the byte after it is a word boundary (a
// non-word char or EOF). Written for the bare `break` / `continue` keywords; SUITE 11 is what
// actually uses it (a retired type spelling is a bare word, not a call).
word_matches = (sv: [u8], i: i64, name: StringView) bool {
    nv = name.view()
    (i + nv.len > sv.len).match ({
        true  => false,
        false => sv.tok_at(nv, i).match ({
            true  => {
                p = i + nv.len
                p >= sv.len || sv[p].not_word()
            },
            false => false,
        }),
    })
}
// the `@while\b` match anchored at i: literal `@while` followed by a word boundary (no before-anchor
// — the `@` is a literal char in the pattern, not a `\b`).
atwhile_at = (sv: [u8], i: i64) bool {
    nv = "@while".view()
    (i + nv.len > sv.len).match ({
        true  => false,
        false => sv.tok_at(nv, i).match ({
            true  => {
                p = i + nv.len
                p >= sv.len || sv[p].not_word()
            },
            false => false,
        }),
    })
}
// a pattern match anchored at index i. kind selects the regex shape:
//   0 = `\bNAME\s*\(`        (call, plain word boundary — `.NAME(` still matches, as in python)
//   1 = `(?<!\.)\bNAME\s*\(` (call, boundary EXCLUDING a leading `.` — e.g. "raw addr")
//   2 = `\bNAME\b`           (bare keyword — NO RULE USES THIS TODAY; it existed for break/continue,
//                             which are not Zen keywords at all, so the check could never fire)
//   3 = `@while\b`           (the literal @while token; `name` is ignored)
//   _ = a byte-`push` call whose last argument is a bare decimal literal (`name` is ignored)
matches_kind_at = (sv: [u8], i: i64, name: StringView, kind: i64) bool {
    (kind == 0).match ({
        true  => sv.bb_plain(i) && sv.name_matches(i, name),
        false => (kind == 1).match ({
            true  => sv.bb_dot(i) && sv.name_matches(i, name),
            false => (kind == 2).match ({
                true  => sv.bb_plain(i) && sv.word_matches(i, name),
                false => (kind == 3).then({ sv.atwhile_at(i) }, { sv.push_literal_at(i) }),
            }),
        }),
    })
}
// ── the byte-`push` decimal-literal needle (kind 4) ───────────────────────────────────────────────
// `gstr_push`/`rpush`/`push_in` all take a `b: u8` — a BYTE. Zen has char literals (`'a'` is that
// byte's value), and a raw decimal in that slot hides what the byte IS: `.rpush(a, 10)` and
// `.rpush(a, '.')` sat two lines apart in compiler.resolve, one of them unreadable. Nothing else
// about the call is checkable — a byte-typed parameter can legitimately take a computed number — so
// the rule is exactly this shape and no wider: a BARE DECIMAL LITERAL as the LAST argument.
//
// It DOES see through one conversion, `.to_u8()`, because that was the whole escape hatch: the JSON
// `\b`/`\f` decoders wrote `gstr_push(mp, 8.to_u8())` only because `zen fmt` used to print the char
// literal `'\x08'` back as the bare number `8`. The formatter round-trips `'\xNN'` now, so the cast
// no longer buys anything and `to_u8_tail` below judges what it wraps.
// the index of the `)` closing the `(` at `i`, or sv.len if the file ends first.
close_paren = (sv: [u8], i: i64, depth: i64) i64 {
    (i >= sv.len).match ({
        true  => sv.len,
        false => (sv[i] == '(').match ({
            true  => sv.close_paren(i + 1, depth + 1),
            false => (sv[i] == ')' && depth == 1).match ({
                true  => i,
                false => sv.close_paren(i + 1, (sv[i] == ')').then({ depth - 1 }, { depth })),
            }),
        }),
    })
}
back_space = (sv: [u8], j: i64) i64 {
    (j >= 0 && sv[j] == ' ').then({ sv.back_space(j - 1) }, { j })
}
back_digits = (sv: [u8], j: i64) i64 {
    (j >= 0 && sv[j] >= '0' && sv[j] <= '9').then({ sv.back_digits(j - 1) }, { j })
}
// `push(mp, 8.to_u8())` — a decimal wearing a conversion. `zen fmt` now round-trips `'\xNN'` (see
// `ff_char` in compiler.pretty), so `'\x08'` is writable and the cast buys nothing the char literal
// cannot say. Step back over the `.to_u8()` suffix and judge what it wraps: a bare decimal is a
// violation, while `cp.to_u8()` / `(192 | cp >> 6).to_u8()` walk back onto a non-digit and pass.
to_u8_tail = (sv: [u8], end: i64) i64 {
    (end >= 8 && end <= sv.len && sv.tok_at(".to_u8()".view(), end - 8)).then({ end - 8 }, { end })
}
// walking back from the closing `)`: spaces, then a digit run, then the `,`/`(` that opens the slot.
last_arg_is_decimal = (sv: [u8], end0: i64) bool {
    end = sv.to_u8_tail(end0)
    j = sv.back_space(end - 1)
    d = sv.back_digits(j)
    (d == j).match ({
        true  => false,
        false => {
            k = sv.back_space(d)
            k >= 0 && (sv[k] == ',' || sv[k] == '(')
        },
    })
}
// `push(` / `push_in(` anchored at i — a SUFFIX match, so `gstr_push(`, `rpush(` and `list_push(` all
// land here, while `pushed(` and `push_uesc(` do not (the `(` must follow immediately).
push_literal_at = (sv: [u8], i: i64) bool {
    lp = sv.tok_at("push(".view(), i).match ({
        true  => i + 4,
        false => sv.tok_at("push_in(".view(), i).then({ i + 7 }, { 0 - 1 }),
    })
    (lp < 0).then({ false }, { sv.last_arg_is_decimal(sv.close_paren(lp, 0)) })
}
// does this file (a `[u8]` view of raw source) contain `pattern` of `kind` OUTSIDE a `//` line
// comment? We track an in-comment flag (set at `//`, cleared at newline) — the same comment-stripping
// python's `_code` does. Block comments and string literals are NOT special-cased (matching python).
// STRING LITERALS ARE SKIPPED, like comments. A file that QUOTES a primitive is not USING one:
// tools/memory_map.zen documents the raw floor with `example: "p = malloc(n)"`, and scanning the
// quoted bytes reported it as a raw-alloc violation. Quote parity also handles `"""` raw strings —
// three toggles is one net toggle — so `"""…"""` opens and closes correctly. A raw string whose
// CONTENT holds an odd number of `"` would desync; none of the scanned files does that today.
//
// CHAR LITERALS ARE TRACKED TOO, and that is not cosmetic — it is why this scanner had teeth at all
// on the JSON decoders. `'"'` is one quote byte inside a char literal; json.zen writes it 12 times
// and lsp.zen 10, and each one flipped `in_string`, so alternating half of both files was silently
// treated as string content and never scanned. `push_in(a, 8)` sat inside one of those blind windows.
// `in_char` closes it, and a newline force-clears it so a stray apostrophe in prose (a block comment,
// which this scanner does not model) can desync at most one line instead of the rest of the file.
file_has = (sv: Slice<u8>, name: StringView, kind: i64) bool {
    found ::= false
    in_comment ::= false
    in_string ::= false
    in_char ::= false
    escaped ::= false
    sv.loop((h, i, b) {
        (b == '\n').then({
            in_comment = false
            in_char = false
        })
        (in_comment == false).then({
            escaped.match ({
                true  => {
                    escaped = false
                },
                false => (b == '\\' && (in_string || in_char)).match ({
                    true  => {
                        escaped = true
                    },
                    false => (b == '"' && in_char == false).match ({
                        true  => {
                            in_string = in_string == false
                        },
                        false => (b == '\'' && in_string == false).match ({
                            true  => {
                                in_char = in_char == false
                            },
                            false => (in_string == false && in_char == false).then({
                                (b == '/' && i + 1 < sv.len && sv[i + 1] == '/').match ({
                                    true  => {
                                        in_comment = true
                                    },
                                    false => sv.matches_kind_at(i, name, kind).then({
                                        found = true
                                        h.break
                                    }),
                                })
                            }),
                        }),
                    }),
                }),
            })
        })
    })
    found
}
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// comment-stripping (python `_code`) + region slicing (python `src.split(marker,1)[…]`).
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// strip `//` line comments, keeping the part before `//` on each line plus the newline — byte-exact
// port of `_code`'s `"\n".join(line.split("//",1)[0] for line in …)`. (No block-comment/string
// handling, matching python.) Returns an allocator-owned NUL-terminated copy.
strip_comments_in = (mp: MutPtr<Malloc>, src: StringView) StringView {
    sv = src.view()
    s ::= mp.new_in().expect("harness: oom")
    in_comment ::= false
    sv.loop((h, i, b) {
        (b == '\n').match ({
            true  => {
                s = s.push_in(mp, b).expect("harness: oom")
                in_comment = false
            },
            false => (in_comment == false).then({
                (b == '/' && i + 1 < sv.len && sv[i + 1] == '/').match ({
                    true  => {
                        in_comment = true
                    },
                    false => {
                        s = s.push_in(mp, b).expect("harness: oom")
                    },
                })
            }),
        })
    })
    mp.finish_in(s).expect("harness: oom")
}
// everything strictly AFTER the first occurrence of `m` (python `src.split(m,1)[1]`); "" if absent.
after_marker = (mp: MutPtr<Malloc>, src: StringView, m: StringView) StringView {
    i = src.find(m)
    (i < 0).match ({
        true  => "",
        false => {
            sv = src.view()
            start = i + m.view().len
            mp.substr(src, start, sv.len - start).expect("harness: oom")
        },
    })
}
// everything strictly BEFORE the first occurrence of `m` (python `s.split(m,1)[0]`); all of `s` if
// `m` is absent (python returns the whole string as the sole split field).
before_marker = (mp: MutPtr<Malloc>, s: StringView, m: StringView) StringView {
    j = s.find(m)
    (j < 0).then({ s }, { mp.substr(s, 0, j).expect("harness: oom") })
}
// the region between the first `m1` and the first following `m2` — python `split(m1,1)[1].split(m2,1)[0]`.
region = (mp: MutPtr<Malloc>, src: StringView, m1: StringView, m2: StringView) StringView {
    mp.before_marker(mp.after_marker(src, m1), m2)
}
not_contains = (s: StringView, needle: StringView) bool {
    s.contains(needle).then({ false }, { true })
}
// A region whose START marker no longer occurs is the EMPTY string, and every `not_contains` over the
// empty string is trivially true — so a rename in the file under audit silently retires the rule
// instead of failing it. Proven: renaming `write_int` to `write_i64` in src/std/text/fmt.zen while
// ALSO introducing the forbidden `.integer_in(` call left the fmt sub-suite green (7 dots, exit 0).
// Every sliced region therefore carries this presence assertion beside its content assertions.
found = (region: StringView) bool { region.is_empty().then({ false }, { true }) }
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// SUITE 4: raw malloc/calloc/realloc/free stay behind the allocator floor (the original port).
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// RAW_ALLOC_ALLOWED's complement, originally mirrored from test_primitive_boundaries.py. In non-test
// source, raw process-heap calls now live only in the explicit memory escape hatch and the canonical
// allocator floor. Thread/pool code and the compiler's bootstrap shim call the named heap floor
// instead of importing libc-shaped allocation names. c_emit's only `malloc` is inside the generated
// C-prelude string literal, which file_has correctly skips; escaping slice-literal ownership is
// tracked separately.
alloc_not_whitelisted = (path: StringView) bool {
    ne(path, "src/std/mem/alloc.zen") && ne(path, "src/std/mem/raw.zen")
}
// `(?<!\.)\b(?:malloc|calloc|realloc|free)\s*\(` anchored at i (kind 1 = dot-excluded boundary).
file_has_raw_alloc = (sv: Slice<u8>) bool {
    sv.file_has("malloc", 1)
        || sv.file_has("calloc", 1)
        || sv.file_has("realloc", 1)
        || sv.file_has("free", 1)
}
alloc_passes = (mp: MutPtr<Malloc>, path: StringView) bool {
    path.is_empty().match ({
        true  => true,
        false => mp.contents_in(path).match ({
            .Ok(raw) => (raw.view().file_has_raw_alloc() && path.alloc_not_whitelisted()).match ({
                true  => false,
                false => true,
            }),
            .Err(e)  => false,
        }),
    })
}    // unreadable = FAIL, never a silent pass
alloc_suite = (mp: MutPtr<Malloc>) i32 {
    mp.contents_in(mp.zo_path("ob_files.txt")).match ({
        .Ok(listing) => {
            files = mp.split_in(listing, '\n')
            results :: [bool] = mp.nbuf(true, files.len)
            files.loop((h, i, path) {
                results[i] = mp.alloc_passes(path)
            })
            run_suite("boundaries: raw-alloc behind allocator floor", results)
        },
        .Err(e)      => run_suite("boundaries: raw-alloc (cannot enumerate files)", [false]),
    })
}
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// SUITE 1: examples stay above raw primitives (EXAMPLE_PRIMITIVES, examples/*.zen, no allowlist).
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// kind per python pattern: "raw addr" = 1 (dot-excluded); break/continue = 2 (bare word); @while = 3
// (literal token); everything else = 0 (plain `\bNAME\s*\(`). `offset`'s `(?:\boffset|\.\s*offset)`
// alternation is equivalent to `\boffset\s*\(` for matching (both fire iff offset starts at a boundary).
example_violation = (sv: Slice<u8>) bool {
    sv.file_has("addr", 1)
        || sv.file_has("checkpoint_current", 0)
        || sv.file_has("@while", 3)
        || sv.file_has("malloc", 0)
        || sv.file_has("load", 0)
        || sv.file_has("store", 0)
        || sv.file_has("load_i64", 0)
        || sv.file_has("store_i64", 0)
        || sv.file_has("atomic_add_i64", 0)
        || sv.file_has("offset", 0)
        || sv.file_has("null_ptr", 0)
        || sv.file_has("slice", 0)
        || sv.file_has("cstr", 0)
        || sv.file_has("sizeof", 0)
}
// `break`/`continue` USED to be banned here as imperative control flow. They are gone because
// the rule could not fire: a bare `break` or `continue` is `error[undefined-name]` in Zen — it
// does not parse — so the only spellings that exist are `h.break`/`h.continue`, methods on the
// functional loop handle. The check therefore caught zero real violations while banning the one
// legal form, and examples/zvm.zen had its early exits removed to satisfy it. `@while` above is
// the imperative loop this family actually targets, and it stays banned.
example_passes = (mp: MutPtr<Malloc>, path: StringView) bool {
    path.is_empty().match ({
        true  => true,
        false => mp.contents_in(path).match ({
            .Ok(raw) => raw.view().example_violation().then({ false }, { true }),
            .Err(e)  => false,
        }),
    })
}    // unreadable = FAIL, never a silent pass
example_suite = (mp: MutPtr<Malloc>) i32 {
    shell(mp.zo_cmd("find examples -name '*.zen' 2>/dev/null | LC_ALL=C sort > $ZT/ob_examples.txt"))
    mp.contents_in(mp.zo_path("ob_examples.txt")).match ({
        .Ok(listing) => {
            files = mp.split_in(listing, '\n')
            results :: [bool] = mp.nbuf(true, files.len)
            files.loop((h, i, path) {
                results[i] = mp.example_passes(path)
            })
            run_suite("boundaries: examples stay above raw primitives", results)
        },
        .Err(e)      => run_suite("boundaries: examples (cannot enumerate files)", [false]),
    })
}
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// SUITE 2: raw checkpoint_current stays behind std.concurrent.coroutine/runtime.
// ─────────────────────────────────────────────────────────────────────────────────────────────────
checkpoint_allowed = (path: StringView) bool {
    path == "src/std/concurrent/coroutine.zen" || path == "src/std/concurrent/runtime.zen"
}
// the import regex `\{[^}\n]*\bcheckpoint_current\b[^}\n]*\}\s*=\s*std\.concurrent\.coroutine`, per
// (comment-stripped) line: a destructure that brings `checkpoint_current` in from the coroutine module
// — `{ … checkpoint_current … } = std.concurrent.coroutine` with the import target after the name.
line_checkpoint_import = (line: StringView) bool {
    ci = line.find("checkpoint_current")
    (ci < 0).match ({
        true  => false,
        false => {
            si = line.find("std.concurrent.coroutine")
            si > ci && line.contains("{") && line.contains("}")
        },
    })
}
has_checkpoint_import = (mp: MutPtr<Malloc>, clean: StringView) bool {
    lines = mp.split_in(clean, '\n')
    found ::= false
    lines.loop((h, i, line) {
        line.line_checkpoint_import().then({
            found = true
            h.break
        })
    })
    found
}
checkpoint_passes = (mp: MutPtr<Malloc>, path: StringView) bool {
    path.is_empty().match ({
        true  => true,
        false => path.checkpoint_allowed().match ({
            true  => true,
            false => mp.contents_in(path).match ({
                .Ok(raw) => {
                    has_call = raw.view().file_has("checkpoint_current", 0)
                    has_imp = raw.contains("checkpoint_current").match ({
                        true  => mp.has_checkpoint_import(mp.strip_comments_in(raw)),
                        false => false,
                    })
                    (has_call || has_imp).then({ false }, { true })
                },
                .Err(e)  => false,
            }),
        }),
    })
}    // unreadable = FAIL, never a silent pass
checkpoint_suite = (mp: MutPtr<Malloc>) i32 {
    mp.contents_in(mp.zo_path("ob_files.txt")).match ({
        .Ok(listing) => {
            files = mp.split_in(listing, '\n')
            results :: [bool] = mp.nbuf(true, files.len)
            files.loop((h, i, path) {
                results[i] = mp.checkpoint_passes(path)
            })
            run_suite("boundaries: raw checkpoint behind coroutine/runtime", results)
        },
        .Err(e)      => run_suite("boundaries: checkpoint (cannot enumerate files)", [false]),
    })
}
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// SUITE 3: @while stays in the compiler / named low-level substrate.
// ─────────────────────────────────────────────────────────────────────────────────────────────────
atwhile_allowed = (path: StringView) bool {
    path == "src/compiler/parse.zen"
        || path == "src/compiler/parse_atom.zen"
        || path == "src/compiler/parse_stmt.zen"
        || path == "src/std/core/count.zen"
}
// std.core.count is the ONE place `@while` is supposed to live, and the ENDGAME for this list is that
// it is the only entry left: `step_while` (carry a cursor, advance it with `next`, while `keep` holds)
// covers every shape, `advance_while`/`repeat_while` are the two shorthands over it, and `upto`/`times`
// are calls, not loops. ALL OF src/std, compiler.lex and — as of this lane — every other compiler file
// but the three below are off this list: 84 loops in compiler.audit (33), lsp (10), pretty (7),
// lsp_query (8), diagnostic (6), driver (4), lsp_tokens (4), validate.util (3), validate.diag (2),
// resolve (2), resolve_scan, pretty_expr, genc and parse_type went through the vocabulary and the
// emitted C reached the same byte-exact fixpoint.
// The scanners' original exemption was never about the keyword; it was about NOT RECURSING — a ~50KB
// string literal, a megabyte `didChange` body, a whole-file identifier scan or a long source line must
// iterate, not recurse the C stack per byte. `step_while` keeps exactly that property (it IS the loop)
// while the keyword goes, so nothing was traded away. Two shapes pin `step_while` over `repeat_while`
// specifically: std.net.http's `serve_n(0)` must answer ZERO connections, and any guarded scan over an
// empty range must run its body zero times — `repeat_while` is do-while and would run once.
// The three remaining entries are compiler.parse / parse_atom / parse_stmt, which hold 6 loops between
// them. They are NOT a design exemption: a parallel lane is rewriting the declaration grammar in those
// files, and converting them at the same time would collide. They come off next.
// The five STALE entries flagged by an earlier lane — c_emit, drvutil, parse_expr,
// std.collections.iter and std.hash, none of which holds a `@while` at all — are gone too. An
// allowlist entry with nothing behind it is an exemption waiting to be spent by accident.
atwhile_passes = (mp: MutPtr<Malloc>, path: StringView) bool {
    path.is_empty().match ({
        true  => true,
        false => path.atwhile_allowed().match ({
            true  => true,
            false => mp.contents_in(path).match ({
                .Ok(raw) => raw.view().file_has("@while", 3).then({ false }, { true }),
                .Err(e)  => false,
            }),
        }),
    })
}    // unreadable = FAIL, never a silent pass
atwhile_suite = (mp: MutPtr<Malloc>) i32 {
    mp.contents_in(mp.zo_path("ob_files.txt")).match ({
        .Ok(listing) => {
            files = mp.split_in(listing, '\n')
            results :: [bool] = mp.nbuf(true, files.len)
            files.loop((h, i, path) {
                results[i] = mp.atwhile_passes(path)
            })
            run_suite("boundaries: @while behind compiler/substrate", results)
        },
        .Err(e)      => run_suite("boundaries: @while (cannot enumerate files)", [false]),
    })
}
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// SUITE 5: std.io.file contents_in allocator path keeps failure in Result flow (try_acquire).
// ─────────────────────────────────────────────────────────────────────────────────────────────────
io_suite = (mp: MutPtr<Malloc>) i32 {
    mp.contents_in("src/std/io/file.zen").match ({
        .Ok(raw) => {
            src = mp.strip_comments_in(raw)
            body = mp.region(src, "read_bytes_alloc", "read_bytes_open")
            run_suite("boundaries: io contents_in uses try_acquire", [body.found(), body.contains(".try_acquire("), body.not_contains(".acquire("), src.not_contains("default()")])
        },
        .Err(e)  => run_suite("boundaries: io file (unreadable)", [false]),
    })
}
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// SUITE 7: std.collections.map fallible paths (the unified Result API) use the Result allocator
// helpers — grow/of go through the all-or-nothing try_acquire3 combinator (which rolls back partially
// acquired buffers on OOM), append grows through grow; never a bare panicking acquire.
// ─────────────────────────────────────────────────────────────────────────────────────────────────
map_suite = (mp: MutPtr<Malloc>) i32 {
    mp.contents_in("src/std/collections/map.zen").match ({
        .Ok(raw) => {
            src = mp.strip_comments_in(raw)
            grow = mp.region(src, "grow = (m: Map<T>", "reindex = ")
            appnd = mp.region(src, "append = (m: Map<T>", "put = (m: Map<T>")
            // `of` is the last fn in map.zen, so its region runs to EOF (no following marker).
            of = mp.after_marker(src, "of*<T> = (a: Allocator")
            run_suite("boundaries: map fallible paths use result helpers", [grow.found(), appnd.found(), of.found(), grow.contains(".try_acquire3("), grow.not_contains(".acquire("), appnd.contains(".grow("), appnd.not_contains(".acquire("), of.contains(".try_acquire3("), of.not_contains(".acquire(")])
        },
        .Err(e)  => run_suite("boundaries: map (unreadable)", [false]),
    })
}
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// SUITE 8: std.text.fmt allocator-backed numeric writes (Result-always) go through the unified
// Result num helpers (never a bare acquire); the plain streaming writes never touch an allocator.
// ─────────────────────────────────────────────────────────────────────────────────────────────────
fmt_suite = (mp: MutPtr<Malloc>) i32 {
    mp.contents_in("src/std/text/fmt.zen").match ({
        .Ok(raw) => {
            src = mp.strip_comments_in(raw)
            ti = mp.region(src, "write_int_in", "write_float_in")
            tf = mp.region(src, "write_float_in", "write_int = ")
            wi = mp.region(src, "write_int = ", "write_fpad")
            // "// Display" is a comment marker — stripped by `_code`, so (faithfully) absent here, which
            // makes `wf` run from `write_float = ` to EOF (python's split returns the whole remainder).
            wf = mp.region(src, "write_float = ", "// Display")
            run_suite("boundaries: fmt allocator writes use fallible num helpers", [ti.found(), tf.found(), wi.found(), wf.found(), ti.contains(".integer_in("), ti.not_contains(".acquire("), tf.contains(".float_in("), tf.not_contains(".acquire("), wi.not_contains(".integer_in(")
                && wi.not_contains(".write_int_in("), wf.not_contains(".float_in(")
                && wf.not_contains(".write_float_in("), src.not_contains("default()")])
        },
        .Err(e)  => run_suite("boundaries: fmt (unreadable)", [false]),
    })
}
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// SUITE 8: a large string literal lexes + runs — the #66c cliff. A ~200KB string literal used to
// overflow the C stack (str_end / unescape / gen_escape_from recursed per byte). Generate a program
// with a 200000-char string, compile + run it, and assert the runtime string's length is exact. At the
// default stack this crashed (SIGSEGV) with the old per-char recursion; iterative lexing/codegen fixes it.
bigstr_suite = (mp: MutPtr<Malloc>) i32 {
    rc = shell(mp.zo_cmd("head -c 200000 /dev/zero | tr '\\0' A > $ZT/bb.txt; { printf '{ len } = std.text.str\\n{ to_exit } = std.core.bool\\nmain = () i32 {\\n    s ::= \"'; cat $ZT/bb.txt; printf '\"\\n    (s.len() == 200000).to_exit()\\n}\\n'; } > $ZT/bigstr.zen; ./zen run $ZT/bigstr.zen")).expect("harness: shell")
    run_suite("boundaries: 200KB string literal lexes + runs (no stack overflow, #66c)", [rc == 0])
}
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// SUITE 9: the scan's own file set cannot drift.
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// Every suite above is only as good as ob_files.txt. That list was a direct port of the python
// rglob, and it went stale silently: self-hosting moved the CLI into a 6000-line driver.zen at the
// repo ROOT, which no directory prefix in the list matched, so the whole CLI stopped being linted
// and nothing said a word. The fmt gate names driver.zen and build.zen explicitly, so the two file
// sets had been disagreeing — with no test comparing them.
//
// So: derive the set the OTHER way (everything in the tree minus an EXPLICIT exclusion list) and
// require the two to be identical. A new .zen file in a new directory now fails here instead of
// quietly opting itself out of every boundary rule.
//
// Related fail-open fix in the same spirit: every per-file scanner used to treat an UNREADABLE file
// as a pass (`.Err(e) => true`). A file that `find` just enumerated and that then cannot be read is
// itself a problem; silently passing it means a rule can be evaded by a file the harness cannot
// open. The blank trailing line from `find` is still handled separately by the `is_empty` guard.
//
// Exclusions are deliberate, not incidental: tests/ and scripts/ are test tooling (harness code
// legitimately calls raw malloc), .claude/ MUST be pruned because sibling worktrees are full
// copies of the tree — the same trap that made the docs-inventory gate false-fail locally — and
// fuzz-out/ holds the crash fuzzer's MUTATED inputs, which are malformed .zen BY CONSTRUCTION, so
// leaving it in made `make harness` fail for anyone who had run scripts/fuzz-run.sh.
scanset_suite = (mp: MutPtr<Malloc>) i32 {
    shell(mp.zo_cmd("find . -name '*.zen' -not -path './.git/*' -not -path './.claude/*' -not -path './fuzz-out/*' -not -path './tests/*' -not -path './scripts/*' 2>/dev/null | sed 's|^./||' | LC_ALL=C sort > $ZT/ob_expect.txt"))
    mp.contents_in(mp.zo_path("ob_files.txt")).match ({
        .Ok(scanned) => mp.contents_in(mp.zo_path("ob_expect.txt")).match ({
            .Ok(expect) => run_suite("boundaries: scan set covers every non-test .zen", [scanned == expect]),
            .Err(e)     => run_suite("boundaries: scan set (cannot enumerate tree)", [false]),
        }),
        .Err(e)      => run_suite("boundaries: scan set (cannot read file list)", [false]),
    })
}
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// SUITE 10: src/std stays BELOW src/compiler — no std module imports the compiler, bar two.
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// Zen pulls WHOLE modules (no tree-shaking), so one `= compiler.x` line in a std module puts x's
// entire transitive closure into every user program that touches that module. Nothing stopped it:
// the resolver treats `std.` and `compiler.` as the same kind of trusted repo-tree id, so the layer
// split is documentary — which is exactly why it needs a gate. It drifted once already. The module
// resolver was born as a 40-line import-line classifier that genuinely belonged in std, grew into
// the compiler's real resolver, and ended up a src/std module whose transitive closure was the
// ENTIRE compiler (58 modules, ~32k LOC — identical to compiler.check's). It now lives in
// src/compiler/resolve*.zen; the flat namespace means that move renamed no emitted symbol.
//
// The two exemptions are the metaprogramming surface (docs/metaprogramming-vision.md): build an AST
// with std.internal.ast, emit it with compiler.genc's genModule. A std module that hands out AST
// values MUST name the AST's types, so that edge is intrinsic, not accidental — and it is bounded:
// those two reach ast_types + genc + astops + mangle (~3k LOC), the AST/emitter subsystem and
// nothing of the checker, parser or driver. Widening the set, or adding a third exemption, is a
// design decision — make it here, in the open, rather than by adding an import line.
layering_allowed = (path: StringView) bool {
    path == "src/std/internal/ast.zen" || path == "src/std/io/c.zen"
}
layering_passes = (mp: MutPtr<Malloc>, path: StringView) bool {
    path.starts_with("src/std/").match ({
        true  => path.layering_allowed().match ({
            true  => true,
            false => mp.contents_in(path).match ({
                .Ok(raw) => mp.strip_comments_in(raw).not_contains("= compiler."),
                .Err(e)  => false,
            }),
        }),
        false => true,
    })
}    // unreadable = FAIL, never a silent pass
layering_suite = (mp: MutPtr<Malloc>) i32 {
    mp.contents_in(mp.zo_path("ob_files.txt")).match ({
        .Ok(listing) => {
            files = mp.split_in(listing, '\n')
            results :: [bool] = mp.nbuf(true, files.len)
            files.loop((h, i, path) {
                results[i] = mp.layering_passes(path)
            })
            run_suite("boundaries: std imports no compiler module (bar the metaprogramming pair)", results)
        },
        .Err(e)      => run_suite("boundaries: layering (cannot enumerate files)", [false]),
    })
}
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// SUITE 11: the retired snake_case string spellings never come back.
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// The three string types were spelled `string_view` / `string_literal` / `string_cstr` and are now
// `StringView` / `StringLiteral` / `StringCstr`. There is deliberately NO alias: the family had six
// spellings for three types once (`str`, `text`, `Cstr` on top of these), and every one of them was
// tolerated as "just a synonym" until three distinct guarantees read like six choices.
//
// This rule scans the RAW bytes — comments and string literals INCLUDED — which is the opposite of
// what `file_has` does, and the difference is the whole point:
//   * a string literal is how the spelling would ACTUALLY come back. `parse_type.ty_of` recognises a
//     type keyword by `src.tok_eq(t, "StringView")`; one more `tok_eq(t, "string_view")` branch
//     revives the old name, and nothing else in the tree would fail, because nothing else in the
//     tree uses it. A rule that skipped string literals would be blind to the only realistic
//     regression — a gate that cannot fail.
//   * comments are rewritten too, because they DISCUSS the type. `// a view of a string_literal`
//     is now wrong, not stylistically dated.
// `\b…\b` word boundaries mean the AST-constructor family `tstring_view()` / `tstring_cstr()` /
// `tstring_literal()` in compiler.genc does NOT match: those are function names, and Zen function
// names are snake_case regardless of what type they build.
//
// Two files are exempt, both because they must NAME the dead spelling to do their job:
//   * src/compiler/validate/util.zen — `retired_string_alias` turns `unknown type name
//     `string_view`` into "that spelling was retired; write `StringView`". Redirecting a name
//     requires writing it. It produces diagnostic TEXT only, so no parse/check path can be revived
//     from here.
//   * this file — it holds the needles.
// Both are named individually, not by directory: a new file cannot inherit the exemption.
spelling_allowed = (path: StringView) bool {
    path == "src/compiler/validate/util.zen" || path == "tests/harness_boundaries.zen"
}
// `\bNAME\b` over the raw file — no comment stripping, no string skipping.
file_has_raw_word = (sv: Slice<u8>, name: StringView) bool {
    found ::= false
    sv.loop((h, i, b) {
        (sv.bb_plain(i) && sv.word_matches(i, name)).then({
            found = true
            h.break
        })
    })
    found
}
file_has_retired_spelling = (sv: Slice<u8>) bool {
    sv.file_has_raw_word("string_view")
        || sv.file_has_raw_word("string_literal")
        || sv.file_has_raw_word("string_cstr")
}
spelling_passes = (mp: MutPtr<Malloc>, path: StringView) bool {
    path.is_empty().match ({
        true  => true,
        false => path.spelling_allowed().match ({
            true  => true,
            false => mp.contents_in(path).match ({
                .Ok(raw) => raw.view().file_has_retired_spelling().match ({
                    true  => {
                        out("\n  retired string spelling in ")
                        out(path)
                        out(" — write StringView/StringLiteral/StringCstr\n")
                        false
                    },
                    false => true,
                }),
                .Err(e)  => false,
            }),
        }),
    })
}    // unreadable = FAIL, never a silent pass
// Its own file list, not ob_files.txt: this rule covers tests/ and scripts/ too, because a retired
// spelling in a test fixture is a retired spelling. Same tree-wide `find` + same `.git`/`.claude`
// pruning as SUITE 9 (sibling worktrees under .claude are full copies of the tree).
spelling_suite = (mp: MutPtr<Malloc>) i32 {
    shell(mp.zo_cmd("find . -name '*.zen' -not -path './.git/*' -not -path './.claude/*' 2>/dev/null | sed 's|^./||' | LC_ALL=C sort > $ZT/ob_all.txt"))
    mp.contents_in(mp.zo_path("ob_all.txt")).match ({
        .Ok(listing) => {
            files = mp.split_in(listing, '\n')
            results :: [bool] = mp.nbuf(true, files.len)
            files.loop((h, i, path) {
                results[i] = mp.spelling_passes(path)
            })
            run_suite("boundaries: retired snake_case string spellings stay dead", results)
        },
        .Err(e)      => run_suite("boundaries: string spellings (cannot enumerate tree)", [false]),
    })
}
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// SUITE 12: the retired walrus binding spelling never comes back.
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// Const-by-default replaced ONE always-mutable binding spelling with four that say what they mean:
//   x = v      constant, inferred        x ::= v     mutable, inferred
//   x: T = v   constant, annotated       x :: T = v  mutable, annotated
// The parser no longer accepts the old one: every shape that used to (parse_binding, both marks;
// decl_is_retired_global; decl_is_typed_global) now reports `error[parse]: `:=` is retired` and
// names the four replacements. That diagnostic has its own teeth in tests/harness_build.zen.
//
// This rule is the OTHER half, and it scans RAW BYTES — comments and string literals INCLUDED,
// exactly like SUITE 11. The reasoning is not the same, though, and saying so matters:
//   * for the string spellings, a string literal was the REVIVAL path (one more `tok_eq` branch).
//     The walrus is recognized by BYTE (parse_atom.is_walrus reads ':' then '='), so no string
//     literal can revive it, and deleting the PE_WALRUS report is what the harness_build cases pin.
//   * here the raw scan earns its keep because a walrus inside a comment or a string is not inert.
//     tools/fuzz-diff.zen and tools/sigs.zen EMIT Zen source from string literals — a walrus there
//     generates a program that no longer compiles. Every `//   m := Malloc(…)` doc-comment in
//     src/std teaches a spelling the compiler now rejects. Both were live in this tree, and a
//     comment/string-stripped scan would have reported neither.
// The needle is the two bytes `:` `=` NOT preceded by another `:`, so `x ::= v` (the mutable form)
// and `x :: T = v` never match.
//
// Four files are exempt, each because it must NAME the dead spelling to do its job:
//   * src/compiler/validate/diag.zen — the diagnostic that redirects it. Naming a retired spelling
//     is the whole content of redirecting it (the same exemption SUITE 11 gives validate/util.zen).
//   * tests/harness_build.zen — the diagnostic's own test inputs. A case that pins `:= is retired`
//     has to feed the parser a walrus.
//   * docs/SPEC.md — the language reference. A spec that cannot print the token it retired has to
//     describe it in circumlocution, which is worse documentation than the risk this rule guards.
//   * this file — it holds the needle.
// Named individually, not by directory: a new file cannot inherit the exemption.
walrus_allowed = (path: StringView) bool {
    path == "src/compiler/validate/diag.zen"
        || path == "tests/harness_build.zen"
        || path == "tests/harness_boundaries.zen"
        || path == "docs/SPEC.md"
}
// `:=` at index i, with a leading `:` EXCLUDING the match — `::=` is the live mutable form.
walrus_at = (sv: [u8], i: i64) bool {
    (i + 1 >= sv.len).match ({
        true  => false,
        false => sv[i] == ':' && sv[i + 1] == '=' && (i == 0 || sv[i - 1] != ':'),
    })
}
file_has_walrus = (sv: Slice<u8>) bool {
    found ::= false
    sv.loop((h, i, b) {
        sv.walrus_at(i).then({
            found = true
            h.break
        })
    })
    found
}
walrus_passes = (mp: MutPtr<Malloc>, path: StringView) bool {
    path.is_empty().match ({
        true  => true,
        false => path.walrus_allowed().match ({
            true  => true,
            false => mp.contents_in(path).match ({
                .Ok(raw) => raw.view().file_has_walrus().match ({
                    true  => {
                        out("\n  retired walrus binding in ")
                        out(path)
                        out(" — write `x = v` / `x: T = v` (constant) or `x ::= v` / `x :: T = v` (mutable)\n")
                        false
                    },
                    false => true,
                }),
                .Err(e)  => false,
            }),
        }),
    })
}    // unreadable = FAIL, never a silent pass
// Same tree-wide `find` as SUITE 11, for the same reason: tests/ and scripts/ hold real Zen that the
// compiler compiles (scripts/alloc-fuzz/alloc-stress.zen was the last file in the tree still using
// the retired spelling, and it sits outside BOTH ob_files.txt and the fmt gate's file set).
//
// …AND `*.md`, which is the other half and was the bigger hole. `make docs-check` verifies the
// documentation INVENTORY and its link targets; nothing looked at what the prose TEACHES. So the
// retirement landed in the parser while docs/SPEC.md still documented the dead spelling as THE
// binding form — 24 sites across four documents, every one of them source a reader would type. A
// doc that teaches a spelling the compiler rejects is not a smaller failure than a comment that
// does; it is a larger one, because the comment has no audience outside this repo. Markdown is a
// RAW-BYTE scan like the Zen half, with no code-fence special case: a walrus in prose is teaching
// it just as surely as a walrus in a fence.
walrus_suite = (mp: MutPtr<Malloc>) i32 {
    shell(mp.zo_cmd("find . '(' -name '*.zen' -o -name '*.md' ')' -not -path './.git/*' -not -path './.claude/*' 2>/dev/null | sed 's|^./||' | LC_ALL=C sort > $ZT/ob_all.txt"))
    mp.contents_in(mp.zo_path("ob_all.txt")).match ({
        .Ok(listing) => {
            files = mp.split_in(listing, '\n')
            results :: [bool] = mp.nbuf(true, files.len)
            files.loop((h, i, path) {
                results[i] = mp.walrus_passes(path)
            })
            run_suite("boundaries: the retired walrus binding spelling stays dead", results)
        },
        .Err(e)      => run_suite("boundaries: walrus binding (cannot enumerate tree)", [false]),
    })
}
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// SUITE 13: a byte pushed into a builder is written as a CHAR LITERAL, never as its ASCII code.
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// `'a'` is that byte's value in Zen, so `b == ':'` and `b == 58` compile identically — and only one
// of them says what the byte is. compiler.resolve had `.rpush(a, '.')` and `.rpush(a, 10)` inside one
// chain, and the comment above `res_body_start` spelled the separator `'\n'` while the code beside it
// said `10`.
//
// The rule is DELIBERATELY narrow. "No magic numbers" is not mechanically checkable: most 2-3 digit
// literals in this tree are genuinely numbers (diagnostic codes 1..66, errnos, buffer capacities,
// SHA-256 rotations, UTF-8 masks, HTTP statuses, calendar ranges) and a wider scan would be a wall of
// false positives nobody would keep green. What IS checkable is a slot whose TYPE is a byte: the
// `push` family (`gstr_push`, `rpush`, `push_in` — all `(…, b: u8)`) takes one, so a bare decimal
// literal there is always an ASCII code wearing a number's clothes. Comments and string literals are
// skipped (file_has), because prose about byte 10 is prose.
//
// Not covered, and it must not be: a byte behind a conversion (`gstr_push(mp, 8.to_u8())`, the JSON
// `\b`/`\f` escapes in lsp.zen and json.zen). `'\x08'` IS a legal char literal, but `zen fmt` prints
// it back as `8`, so the fmt gate and this rule would contradict each other. The formatter has to
// round-trip `'\xNN'` before those sites can be asked to change.
alloc_push_file = (mp: MutPtr<Malloc>, path: StringView) bool {
    path.is_empty().match ({
        true  => true,
        false => mp.contents_in(path).match ({
            .Ok(raw) => raw.view().file_has("", 4).match ({
                true  => {
                    out("\n  ASCII code in a byte-push slot in ")
                    out(path)
                    out(" — write the char literal (`'\\n'`, `':'`), not its number\n")
                    false
                },
                false => true,
            }),
            .Err(e)  => false,
        }),
    })
}    // unreadable = FAIL, never a silent pass
push_suite = (mp: MutPtr<Malloc>) i32 {
    mp.contents_in(mp.zo_path("ob_files.txt")).match ({
        .Ok(listing) => {
            files = mp.split_in(listing, '\n')
            results :: [bool] = mp.nbuf(true, files.len)
            files.loop((h, i, path) {
                results[i] = mp.alloc_push_file(path)
            })
            run_suite("boundaries: a pushed byte is a char literal, not an ASCII code", results)
        },
        .Err(e)      => run_suite("boundaries: byte-push literals (cannot read file list)", [false]),
    })
}
// ─────────────────────────────────────────────────────────────────────────────────────────────────
harness_boundaries_run* = () i32 {
    m = Malloc(_: 0)
    mp = m.addr()
    // Every .zen file that ships as part of the compiler or the library. The repo-ROOT entries are
    // named explicitly because they have no directory prefix for `find` to match — and they are the
    // reason this list drifted: the python original globbed examples/tools/src/std/src/compiler back
    // when the driver was bootstrap/driver.c, so when self-hosting turned it into a 6000-line
    // driver.zen at the root, the whole CLI silently left the scan. The set is asserted against the
    // fmt gate's set below, so the two can never disagree again.
    shell(mp.zo_cmd("find examples tools src/std src/compiler driver.zen build.zen -name '*.zen' 2>/dev/null | LC_ALL=C sort > $ZT/ob_files.txt"))
    fails ::= 0
    fails = fails + mp.scanset_suite()
    fails = fails + mp.example_suite()
    fails = fails + mp.checkpoint_suite()
    fails = fails + mp.atwhile_suite()
    fails = fails + mp.alloc_suite()
    fails = fails + mp.io_suite()
    fails = fails + mp.map_suite()
    fails = fails + mp.fmt_suite()
    fails = fails + mp.layering_suite()
    fails = fails + mp.spelling_suite()
    fails = fails + mp.walrus_suite()
    fails = fails + mp.push_suite()
    fails = fails + mp.bigstr_suite()
    fails
}
