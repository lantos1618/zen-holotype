// src/lsp/lsp_colour.zen
// `textDocument/semanticTokens/full` — the colours, from the compiler's
// own lexer, and from its checker when a clean build is in hand.
//
// NAMED FOR WHAT IT PRODUCES AND NOT FOR THE REQUEST: the lexical half
// of every answer comes from `scan` and a `TokenKind`, with no
// `Checker`, no build and no import resolved (`editors/README.md`'s
// header argues the other half). The semantic half reclassifies
// `Ident` tokens only, and only the ones `lsp_names.zen` marked from
// sema's own memos — the two halves can never disagree about what a
// token IS, because the tokens are the lexer's either way.
//
// WHY THIS AND NOT A TEXTMATE GRAMMAR. `docs/PLAN.md:137` names a second
// grammar as the failure the plan exists to prevent. `docs/design_lsp.md`
// §2: colours come from the lexer the compiler itself runs, which CANNOT
// disagree with it about what a token is.
//
// WHAT THE LEXICAL HALF COSTS: one `scan`. No `Parser`, `Checker`,
// `Build`, or disk read — unlike hover and diagnostics it answers on an
// unsaved buffer with no workspace, even a file that does not parse. A
// file with lexical faults still has tokens (`src/std/lex/lex.zen`'s
// contract), all still coloured. The semantic half arrives already paid
// for: it rides the one build diagnostics ran (`lsp_diag.zen`), and
// where that build says nothing — no workspace, a change not yet
// settled, a program with faults — the answer is the lexical one, so a
// file that does not compile never goes grey.
//
// ---------------------------------------------------------------------
// THE FIVE THINGS A SEMANTIC-TOKENS SERVER GETS WRONG, and what this
// file does about each.
//
// 1. THE ENCODING IS DELTAS, FROM THE PREVIOUS TOKEN. Five integers per
//    token — `deltaLine, deltaStartChar, length, tokenType,
//    tokenModifier` — where `deltaStartChar` is relative to the previous
//    token's start ONLY when the two share a line, absolute otherwise.
//    `Painter` below is exactly those two numbers. Getting it wrong
//    tints a file that drifts further off the further down you read.
//
// 2. THE NUMBERS ARE UTF-16, ON BOTH AXES THAT HAVE ONE. `character` and
//    `length` are UTF-16 code units into the line, not bytes and not
//    codepoints; `lsp_pos.zen` is the only file that converts. A 4-byte
//    emoji is 2 units/4 bytes, an `é` is 1 unit/2 bytes, so
//    `end.offset - start.offset` is right only for ASCII.
//
// 3. A MULTI-LINE TOKEN IS SPLIT, ONE RUN PER LINE. The standard
//    encoding cannot express a token crossing a newline unless the
//    client advertised `multilineTokenSupport`, which most do not.
//    SPLITTING IS CHOSEN OVER OMITTING: a block comment is the one token
//    here that spans lines and the one a reader most wants greyed out.
//    A zero-length run (a blank line inside a block comment) is not
//    emitted — colours nothing, only confuses a client.
//
// 4. THE LEGEND IS DECLARED IN `initialize` AND INDEXED HERE. `tokenType`
//    is an INDEX into the advertised `tokenTypes` array, so `index_of`
//    and `write_legend` are one fact said twice and must agree — both
//    below, same order, and the corpus test prints both halves.
//
// 5. `Ident` IS ONE KIND AND COLOUR WANTS SEVERAL — AND THIS FILE DOES
//    NOT GUESS. A lexer cannot tell a type from a function from a
//    variable, sharper in Zen since a type is a bare identifier
//    (`DESIGN.md`) with no keyword in front. Colouring by capitalisation
//    would be a SECOND, WRONG specification of what a name means. So the
//    lexer's answer is `variable`, and the sharper one is sema's or it
//    is nothing: `lsp_names.zen` reads what a clean build's memos
//    settled each name to be (`design_lsp.md` §2, L4), which is a
//    recorded fact and not a guess. Hover refuses sema's poison for the
//    same reason: a wrong answer is worse than none.
//
// DELIMITERS ARE NOT COLOURED — the same refusal one step down: `(`,
// `)`, `[`, `]`, `{`, `}`, `,`, `;`, `.`, `:` are structure, not meaning.
// Operators proper (arithmetic, comparison, logical, binding) are
// `operator`.
//
// EVERY VARIANT OF `TokenKind` IS LISTED IN `colour_of`, with no `_`
// arm, so a token shape added to `src/std/lex/` fails this file to compile
// rather than arriving quietly uncoloured.

str, String = std.text
Vec = std.collections
Alloc, AllocError = std.mem
Range = std.core
scan, Source, Token, TokenKind = std.lex
write_decimal = lsp.lsp_frame
// `written()` is `Ok(())` with the writer's error type already on it, so
// a match arm that writes nothing sits beside one that writes something.
written = lsp.lsp_json
wire_at, units_of = lsp.lsp_pos

// The legend, in order. A `tokenType` on the wire is a position in this
// list, so the ORDER BELOW IS THE WIRE FORMAT. `Text` is the legend's
// `string`, spelled differently only because `TokenKind.Str` is matched
// in the same file.
//
// NINE AND NOT MORE: every standard LSP type name this server cannot
// honestly produce (`property`, `method`, `typeParameter`) is left out,
// so a theme is never told to prepare a colour it will never see. The
// last three are sema's answers (`lsp_names.zen`), appended so the six
// lexical indices did not move.
Colour* = Keyword
    | Text
    | Number
    | Comment
    | Operator
    | Variable
    | Type
    | Function
    | Parameter

// A colour's index in the legend. THE NUMBERS THE WIRE CARRIES.
index_of* = (colour: Colour) usize {
    colour.match({
        Keyword   => 0,
        Text      => 1,
        Number    => 2,
        Comment   => 3,
        Operator  => 4,
        Variable  => 5,
        Type      => 6,
        Function  => 7,
        Parameter => 8,
    })
}

// A colour's name in the legend. STANDARD LSP TOKEN TYPE NAMES, all
// nine — inventing `zenKeyword` would leave output grey until the user
// wrote a `semanticTokenColorCustomizations` block.
name_of* = (colour: Colour) str {
    colour.match({
        Keyword   => "keyword",
        Text      => "string",
        Number    => "number",
        Comment   => "comment",
        Operator  => "operator",
        Variable  => "variable",
        Type      => "type",
        Function  => "function",
        Parameter => "parameter",
    })
}

// The legend as `initialize` advertises it, written by walking the
// variants IN INDEX ORDER, checkable against `index_of`.
//
// NO MODIFIERS: `declaration`, `readonly`, `static` and the rest are
// facts about what a name MEANS beyond its kind, which neither the
// lexer nor the memos `lsp_names.zen` reads record.
write_legend* = (out :: String) Res<(), AllocError> {
    out.add_bytes("{\"tokenTypes\":[\"").try();
    out.add_bytes(name_of(Colour.Keyword)).try();
    next_name(Colour.Text, out).try();
    next_name(Colour.Number, out).try();
    next_name(Colour.Comment, out).try();
    next_name(Colour.Operator, out).try();
    next_name(Colour.Variable, out).try();
    next_name(Colour.Type, out).try();
    next_name(Colour.Function, out).try();
    next_name(Colour.Parameter, out).try();
    out.add_bytes("\"],\"tokenModifiers\":[]}")
}

next_name = (colour: Colour, out :: String) Res<(), AllocError> {
    out.add_bytes("\",\"").try();
    out.add_bytes(name_of(colour))
}

// WHAT EACH TOKEN SHAPE IS COLOURED, and `None` for shapes this file
// will not colour, in the order `src/std/lex/lex_token.zen` declares them.
//
// `Ident` IS `variable` AND THAT IS THE LEXICAL ANSWER (item 5) — the
// one the semantic half overrides name by name, never wholesale. `Char`
// is `string` since the legend has no character type; `number` would be
// a guess about what one byte meant. `Eof` SPANS NOTHING, by
// construction.
colour_of* = (kind: TokenKind) Res<Colour> {
    kind.match({
        Ident        => Ok(Colour.Variable),
        Int(_)       => Ok(Colour.Number),
        Float        => Ok(Colour.Number),
        Str          => Ok(Colour.Text),
        Char         => Ok(Colour.Text),
        True         => Ok(Colour.Keyword),
        False        => Ok(Colour.Keyword),
        Consume      => Ok(Colour.Keyword),
        AtSelf       => Ok(Colour.Keyword),
        AtMeta       => Ok(Colour.Keyword),
        AtScope      => Ok(Colour.Keyword),
        LineComment  => Ok(Colour.Comment),
        BlockComment => Ok(Colour.Comment),
        ParenOpen    => None,
        ParenClose   => None,
        BracketOpen  => None,
        BracketClose => None,
        BraceOpen    => None,
        BraceClose   => None,
        Comma        => None,
        Semicolon    => None,
        Dot          => None,
        Ellipsis     => Ok(Colour.Operator),
        Colon        => None,
        ColonColon   => Ok(Colour.Operator),
        ColonColonEq => Ok(Colour.Operator),
        Eq           => Ok(Colour.Operator),
        EqEq         => Ok(Colour.Operator),
        Arrow        => Ok(Colour.Operator),
        Bang         => Ok(Colour.Operator),
        BangEq       => Ok(Colour.Operator),
        Lt           => Ok(Colour.Operator),
        LtEq         => Ok(Colour.Operator),
        Gt           => Ok(Colour.Operator),
        GtEq         => Ok(Colour.Operator),
        Amp          => Ok(Colour.Operator),
        AmpAmp       => Ok(Colour.Operator),
        Bar          => Ok(Colour.Operator),
        BarBar       => Ok(Colour.Operator),
        Plus         => Ok(Colour.Operator),
        PlusWrap     => Ok(Colour.Operator),
        Minus        => Ok(Colour.Operator),
        MinusWrap    => Ok(Colour.Operator),
        Star         => Ok(Colour.Operator),
        StarWrap     => Ok(Colour.Operator),
        Slash        => Ok(Colour.Operator),
        Percent      => Ok(Colour.Operator),
        Eof          => None,
    })
}

// --- the encoding ------------------------------------------------------

// WHERE THE PREVIOUS TOKEN STARTED — the entire state the encoding
// needs — plus whether a comma is owed. Begins at line 0, character 0
// rather than "nothing yet": the protocol measures the first token's
// deltas from the origin, so the same subtraction handles the first
// token with no special case.
Painter = {
    line :: usize,
    character :: usize,
    said :: bool,

    // One run, as five integers. `length` is already in UTF-16 units and
    // `colour` is already an index — both conversions happen before this
    // method, so nothing here converts twice.
    put = (self :: @Self, line: usize, character: usize, length: usize,
           colour: Colour, out :: String) Res<(), AllocError> {
        self.said.match({ true => out.add_bytes(
            ","
        ), false => written() }).try();
        delta_line = line - self.line;
        // THE ONE BRANCH IN THE WHOLE ENCODING: a token on the same line
        // as its predecessor measures from that predecessor's start; one
        // on a later line measures from the start of its own line.
        delta_character = (delta_line == 0).match({
            true  => character - self.character,
            false => character,
        });
        write_decimal(delta_line, out).try();
        out.add_bytes(",").try();
        write_decimal(delta_character, out).try();
        out.add_bytes(",").try();
        write_decimal(length, out).try();
        out.add_bytes(",").try();
        write_decimal(index_of(colour), out).try();
        // The modifier set, always empty — see `write_legend`.
        out.add_bytes(",0").try();
        self.line      = line;
        self.character = character;
        self.said      = true;
        Ok(());
    }

    // A token, as one run per line it covers. THE FIRST RUN'S CHARACTER
    // IS CONVERTED AND EVERY LATER ONE IS ZERO: a run beginning because
    // a newline ended the last one starts at the first byte of its line
    // — paid once per token, not once per line.
    paint = (self :: @Self, text: str, token: Token, colour: Colour,
             out :: String) Res<(), AllocError> {
        stop = token.span.end.offset;
        from      ::= token.span.start.offset;
        line      ::= zero_based(token.span.start.line);
        character ::= wire_at(
            text,
            token.span.start.line,
            token.span.start.col
        ).character;
        loop(() { from < stop }, (h) {
            upto = break_in(text, from, stop);
            self.run(text, line, character, from, upto, colour, out).try();
            // Past the `\n`, which belongs to neither run: it is inside
            // the token's bytes and colours nothing.
            from      = upto + 1;
            line      = line + 1;
            character = 0;
        });
        Ok(());
    }

    // One line's worth, unless empty — a blank line inside a block
    // comment is a real run of zero units, not worth the client's
    // trouble.
    run = (self :: @Self, text: str, line: usize, character: usize,
           from: usize, upto: usize, colour: Colour, out :: String)
          Res<(), AllocError> {
        (upto > from).match({
            true  => self.put(
                line,
                character,
                units_of(text, from, upto),
                colour,
                out
            ),
            false => written(),
        })
    }
}

// The first `\n` in `from..stop`, or `stop`. What splits a multi-line
// token, and the only place this file looks at a byte.
break_in = (text: str, from: usize, stop: usize) usize {
    Range(from, stop).find((i) { text.index(i) == '\n' }).match({
        Ok(i) => i,
        None  => stop,
    })
}

// --- the semantic half -------------------------------------------------

// ONE NAME SEMA SETTLED, and the colour it settled to. `uri` is resolved
// where the row is gathered (`lsp_names.zen`), since a build knows its
// compilation root and a painter does not. `line`/`col` are the name's
// own start, 1-based with a BYTE column — the coordinates both the AST
// and the lexer speak, so the wire conversion happens once, in the
// painter, as item 2 demands.
Classed* = {
    uri*: str,
    line*: usize,
    col*: usize,
    colour*: Colour,
}

// What sema said about the name starting at `line:col`, or nothing.
// `names` MUST BE SORTED on that pair — `sort_classes` below is the
// sort, and `lsp_diag.zen`'s `classes_for` is the one caller of both,
// so the order the search requires is written beside it.
classed_at = (names: Vec<Classed>, line: usize, col: usize) Res<Classed> {
    lo ::= 0;
    hi ::= names.len;
    loop(() { lo < hi }, (h) {
        mid = (lo + hi) / 2;
        names.get(mid).match({
            None   => (),
            Ok(cl) => before_start(cl, line, col).match({
                true  => { lo = mid + 1; },
                false => { hi = mid; },
            }),
        });
    });
    names.get(lo).match({
        None   => None,
        Ok(cl) => is_start(cl, line, col).match({
            true  => Ok(cl),
            false => None,
        }),
    })
}

before_start = (cl: Classed, line: usize, col: usize) bool {
    cl.line < line || (cl.line == line && cl.col < col)
}

is_start = (cl: Classed, line: usize, col: usize) bool {
    cl.line == line && cl.col == col
}

// Insertion, in place, and not a library call: std has no sort, and a
// file carries hundreds of classified names, not millions.
sort_classes* = (names :: Vec<Classed>) Res<(), AllocError> {
    Range(1, names.len).loop((h, i) { bubble(names, i).try(); });
    Ok(());
}

// Swap `names[at]` left past every predecessor that sorts after it.
bubble = (names :: Vec<Classed>, at: usize) Res<(), AllocError> {
    j ::= at;
    loop(() { j > 0 && out_of_order(names, j) }, (h) {
        swap_at(names, j).try();
        j = j - 1;
    });
    Ok(());
}

out_of_order = (names: Vec<Classed>, j: usize) bool {
    names.get(j - 1).match({
        None    => false,
        Ok(lft) => names.get(j).match({
            None    => false,
            Ok(rgt) => before_start(rgt, lft.line, lft.col),
        }),
    })
}

swap_at = (names :: Vec<Classed>, j: usize) Res<(), AllocError> {
    names.get(j).match({
        None    => written(),
        Ok(rgt) => names.get(j - 1).match({
            None    => written(),
            Ok(lft) => swap_pair(names, j, lft, rgt),
        }),
    })
}

swap_pair = (names :: Vec<Classed>, j: usize, lft: Classed, rgt: Classed)
            Res<(), AllocError> {
    names.set(j - 1, rgt).match({ Ok(_) => (), None => () });
    names.set(j, lft).match({ Ok(_) => (), None => () });
    Ok(());
}

// --- the answer --------------------------------------------------------

// `text` coloured, as the protocol's reply body: `{"data":[..]}`. `name`
// is the CLIENT'S URI verbatim, as `hover_at` uses it.
//
// `names` IS THE SEMANTIC HALF, and an empty one is the lexical answer:
// every `Ident` starts from `colour_of` and only a row naming its exact
// start overrides it, so "no build", "a change not yet built" and "the
// build had faults" — the three states `lsp_diag.zen`'s `classes_for`
// answers empty for — all degrade to the same honest colours.
//
// A LEX FAULT IS NOT REPORTED HERE AND NOT ALLOWED TO STOP ANYTHING:
// `scan` hands back every token it could read plus every fault found;
// `lsp_diag.zen` says the faults out loud. A server that went grey the
// moment a quote was opened would be worse than one with no colour at
// all.
write_tokens* = (
    a: Alloc,
    name: str,
    text: str,
    names: Vec<Classed>,
    out :: String
) Res<(), AllocError> {
    lexed = scan(a, Source(file: name, text: text)).try();
    painter ::= Painter(line: 0, character: 0, said: false);
    out.add_bytes("{\"data\":[").try();
    lexed.tokens.loop((h, token) {
        colour_of(token.kind).match({
            None    => written(),
            Ok(one) => painter.paint(
                text,
                token,
                settled(token, one, names),
                out
            ),
        }).try();
    });
    out.add_bytes("]}")
}

// The lexer's answer, with sema's where sema spoke. ONLY AN `Ident` IS
// EVER OVERRIDDEN — a keyword sema knows nothing about keeps its colour,
// and an identifier sema said nothing about stays `variable`.
settled = (token: Token, lexical: Colour, names: Vec<Classed>) Colour {
    token.kind.match({
        Ident => classed_at(
            names,
            token.span.start.line,
            token.span.start.col
        ).match({
            None    => lexical,
            Ok(one) => one.colour,
        }),
        _     => lexical,
    })
}

// A 1-based line as the wire's 0-based one. Line 0 cannot come out of
// the lexer, but clamps anyway — same reason `lsp_pos.zen` clamps.
zero_based = (line: usize) usize {
    (line == 0).match({ true => 0, false => line - 1 })
}
