// PROBE 6: is this a pre-existing std-level bug (primitive constructor
// functions) unrelated to generics? Compare with a typed binding, and with
// the same shape over my OWN generic fn returning u8.
main = (env: Env) Res<i32, AllocError> {
    a: u8 = 200;            // typed binding
    b ::= 3000000000;       // inferred binding
    println("binds {} {}", a, b);

    println("u8(200) {}", u8(200));
    println("u8.to_u64 {}", u8(200).to_u64());
    c: u64 = 4000000001;
    println("u64 bind {}", c);
    Ok(0);
}
