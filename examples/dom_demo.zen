// dom_demo.zen — a Zen program that manipulates the browser DOM. Under the js backend
// (`zenc emit-js`) the std.web.dom stub calls lower to REAL JavaScript DOM API calls, so this
// program builds a DOM node and wires a click handler exactly as hand-written JS would.
//   $ zenc emit-js examples/dom_demo.zen        # print the emitted JavaScript
{ document, create_element, as_element, as_node, set_text_content, body, append_child,
  as_event_target, add_event_listener, set_id, Event } = std.web.dom
on_click = (ev: Event) void { }
main = () i32 {
    // create a <div>, give it an id + text, append it to <body>, and wire a click handler.
    el = document().create_element("div")
    el.as_element().set_id("greeting")
    el.as_element().as_node().set_text_content("Hello from Zen")
    document()
        .body()
        .as_element()
        .as_node()
        .append_child(el.as_element().as_node())
    el.as_element().as_event_target().add_event_listener("click", on_click)
    0
}
