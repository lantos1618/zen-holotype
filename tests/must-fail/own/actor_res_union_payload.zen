// Both halves of Res and every member of its error union participate in the
// actor-transfer classification.

HeapFault = { bytes: Vec<u8> }
PlainFault = { code: i32 }
Reply = Res<i32, HeapFault | PlainFault>

Worker = {}

Worker.impl(Actor, {
    process = (self :: @Self, ctx: Context, payload: Reply) {
        ctx.env.out.println("received")
    }
})

forward = (worker: Ref<Worker>, payload: Reply) Res<(), ActorError> {
    worker.process(payload).try();
    Ok(())
}

main = (env: Env) Res<i32, AllocError> { Ok(0) }
