// AN ASSIGNMENT'S VALUE MUST FIT THE SLOT IT IS WRITTEN INTO. `::=` is
// the permission to write a binding again; it is not permission to
// change what the binding is. This emitted `int64_t zu_l1n; zu_l1n = 42;
// zu_l1n = 3.5;` — C truncated, no Zen diagnostic, no cc warning, exit 0
// — because `sema_place.bind_want` took a bare name's type from the
// VALUE at every statement, while `gen_c_stmt.binding_type` took a
// store's from the SLOT. The two now ask one question.
//
// `place_want` had this rule for `p.x = e` and `buf[i] = e` all along.
// The bare name was the case it did not reach.
//
// AN UNSETTLED SLOT IS STILL LENIENT ABOUT WIDTH: `fields ::= 0` freezes
// the family and not the width, so `fields = <an i32>` is exact
// (`corpus/codegen/c_libc_names` depends on it). A float has no integer
// to be, which is what this file asserts.
//
// position: the value, because the value is what does not fit.

main = (env: Env) Res<i32, IoError> {
    n ::= 42;
    println("n starts as {}", n);
    n = 3.5;
    println("n is now {}", n);
    Ok(0);
}
