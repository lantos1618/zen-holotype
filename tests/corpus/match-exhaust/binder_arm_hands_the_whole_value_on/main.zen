// A BINDER arm -- not `_` -- catches the remaining cases, and the bound
// value is forwarded WHOLE to a second match that can tell its cases apart.
//
// A wildcard row survives specialisation expanded into wildcards
// (sema_match.zen spec_wild); the runtime half of that promise is that what
// reaches the arm is the scrutinee itself, tag and payload together, so the
// second match reads the real tag. Forward the payload slot instead of the
// pair -- or the tag word alone -- and `Blue` arrives at `sort` wearing
// `Red`'s words: every answer below changes while every println still runs.
//
// The binder is the LAST arm over the cases it covers, as it must be:
// anything reachable-after-a-wildcard is unreachable, and the compiler
// rightly refuses that.
//
// Breaks if: the binder forwards a stale or wrong-width slot instead of the
// scrutinee -- sort's answers become "lost"/garbage while the Red arm still
// prints "red".

Pill = Red(i64) | Blue | Green

sort = (p: Pill) str {
    p.match({
        Blue => "cool",
        _    => "lost",
    });
}

kind = (p: Pill) str {
    p.match({
        Red(n)          => "red",
        everything_else => sort(everything_else),
    });
}

main = (env: Env) Res<i32, AllocError> {
    println("{}", kind(Pill.Red(5)));
    println("{}", kind(Pill.Blue));
    println("{}", kind(Pill.Green));
    Ok(0);
}
