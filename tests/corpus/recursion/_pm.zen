// probeM: Drop printing via println SUGAR inside drop (env captured in struct)
Noisy = {
    env: Env,
    tag: str,
}

Noisy.impl(Drop, {
    drop = (self :: @Self) () { println("drop {}", self.tag) }
})

three = (env: Env) i64 {
    f = Noisy(env: env, tag: "f");
    3
}

main = (env: Env) Res<i32, IoError> {
    println("chain {}", three(env));
    Ok(0);
}
