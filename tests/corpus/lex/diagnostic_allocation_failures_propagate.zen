scan, Source = std.lex

FailAt = {
    base: Alloc,
    calls: Ptr<usize>,
    fail: usize,

    accepts = (self: @Self) bool {
        index = self.calls.read(0);
        self.calls.write(0, index + 1);
        index != self.fail
    }
}

FailAt.impl(Alloc, {
    raw = (self: @Self, size: usize, align: usize) Res<Ptr<u8>, AllocError> {
        self.accepts().ensure(AllocError.OutOfMemory).try();
        self.base.raw(size, align)
    }
    realloc = <T>(self: @Self, ptr: Ptr<T>, count: usize) Res<Ptr<T>, AllocError> {
        self.accepts().ensure(AllocError.OutOfMemory).try();
        self.base.realloc(ptr, count)
    }
})

check = (a: Alloc, name: str, text: str, clean: bool) Res<(), AllocError> {
    calls ::= a.Vec<usize>();
    calls.add(0).try();
    baseline = scan(
        FailAt(base: a, calls: calls.ptr(), fail: usize.MAX),
        Source(file: name, text: text)
    ).try();
    total    = calls.ptr().read(0);
    refused ::= total > 0;
    Range(0, total).loop((index) {
        calls.ptr().write(0, 0);
        result  = scan(
            FailAt(base: a, calls: calls.ptr(), fail: index),
            Source(file: name, text: text)
        );
        refused = refused && result.match({ Err(_) => true, Ok(_) => false });
    });
    println(
        "{} baseline {} failures {}",
        name,
        baseline.is_clean() == clean,
        refused
    );
    Ok(())
}

main = (env: Env) Res<(), AllocError> {
    a = env.mem.alloc();
    check(a, "valid", "\"hello\\n\"", true).try();
    check(a, "unknown", "\"\\q\"", false).try();
    check(a, "truncated", "\"\\", false).try();
    check(a, "carriage", "\"\\\r\"", false).try();
    check(a, "character", "'\\q'", false).try();
    check(a, "multiple", "\"\\q\\z\" '\\x'", false).try();
    Ok(())
}
