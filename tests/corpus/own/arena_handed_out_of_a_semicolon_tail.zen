// THE SPELLING `make asan-corpus` COULD NOT SEE. Issue #793's second
// reproducer, kept as a program the sweep now compiles: a match arm
// allocates an arena, fills a Vec out of it, and hands the ARENA out as
// a `;`-terminated tail. `gen_c_stmt.keep_name` read `Block.value` —
// only ever the tail written WITHOUT a `;` — so nothing was exempted
// from the arm's drops, the arena was freed at the arm's brace, and the
// next `Vec.add` bumped through freed pages. SIGSEGV at run time,
// `heap-use-after-free` under ASan, exit 0 out of the compiler.
//
// The sweep was green over 698 programs with this defect live, because
// every one of them wrote the tail the other way. A sanitizer gate only
// covers spellings somebody wrote down, so this is written down.
//
// `w` must grow PAST the 100 elements the arm already put in `v`: the
// bug needs a reallocation to read the arena's freed header, and a Vec
// that never grows would run clean over a dangling arena.

Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    ar ::= true.match({
        true  => {
            a ::= env.mem.alloc();
            v ::= a.Vec<i32>();
            Range(0, 100).loop((h, n) { v.add(n).try(); });
            a;
        },
        false => env.mem.alloc(),
    });
    w  ::= ar.Vec<i32>();
    Range(0, 200).loop((h, n) { w.add(n * 2).try(); });
    println("len {}", w.len);
    Ok(0);
}
