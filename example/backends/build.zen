Builder, BuildError, Codegen = std.build

build = (b :: Builder) Res<(), BuildError> {
    b.exe("c", { src: Path("main.zen"), deps: [], backend: Codegen.C }).try();
    b.exe("js", { src: Path("main.zen"), deps: [], backend: Codegen.Js }).try();
    b.exe(
        "asm",
        { src: Path("main.zen"), deps: [], backend: Codegen.Asm }
    ).try();
    Ok(())
}
