// lsp_tokens.zen — `textDocument/semanticTokens/full`: syntax highlighting served by the compiler
// rather than guessed by a regex grammar in each editor.
//
// The token stream comes from compiler.lex.scan, the SAME lexer the compiler parses with, so
// highlighting can never disagree with the language about where a token starts and ends. Comments
// are lexed away by `skip`, so they are merged back in from collect_comments — the two streams are
// each position-sorted, so one merge walk covers both.
//
// Classification is deliberately lexical, not semantic: it uses the token kind plus one byte of
// context either side (a leading `.`, a following `(`). A resolver-backed pass would know that
// `foo` is a parameter rather than a local, but it would also need a *parse* — and the editor asks
// for tokens on every keystroke, when the buffer is usually mid-edit and unparseable. Lexical
// classification degrades gracefully on broken input, which is exactly when highlighting matters.
{ Malloc } = std.mem.alloc
{ then } = std.core.bool
{ view } = std.text.str
{ at, is_alpha, is_alnum } = std.text.ascii
{ String } = std.text.string
{ gstr_string, gstr_append, gstr_finish } = compiler.genc
{ Comment, Token, collect_comments, scan, tok_in } = compiler.lex
{ push_int } = compiler.drvutil
// The legend, in the order the client receives it. A token's `tokenType` is an INDEX into this
// array, so the order here and the order advertised in `initialize` must stay in lockstep.
LSPT_KEYWORD = () i64 { 0 }
LSPT_FUNCTION = () i64 { 1 }
LSPT_TYPE = () i64 { 2 }
LSPT_VARIABLE = () i64 { 3 }
LSPT_PROPERTY = () i64 { 4 }
LSPT_STRING = () i64 { 5 }
LSPT_NUMBER = () i64 { 6 }
LSPT_COMMENT = () i64 { 7 }
LSPT_OPERATOR = () i64 { 8 }
LSPT_ENUM_MEMBER = () i64 { 9 }
lspt_legend* = () string_view {
    "[\"keyword\",\"function\",\"type\",\"variable\",\"property\",\"string\",\"number\",\"comment\",\"operator\",\"enumMember\"]"
}
// ── classification ───────────────────────────────────────────────────────────────────────────────
lspt_is_keyword = (src: string_view, t: Token) bool {
    src.tok_in(t, "return|match|loop|impl|then|true|false").then({
        return true
    })
    src.tok_in(t, "break|continue|or_return|Self").then({
        return true
    })
    false
}
// A builtin scalar/pointer name highlights as a type even though it is an ordinary identifier to the
// lexer. User types are caught by the uppercase-initial rule below.
lspt_is_builtin_ty = (src: string_view, t: Token) bool {
    src.tok_in(t, "i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|void").then({
        return true
    })
    src.tok_in(t, "string_literal|string_view|string_cstr|str|text").then({
        return true
    })
    false
}
lspt_upper = (b: u8) bool { b >= 'A' && b <= 'Z' }
// The byte before `start`, skipping nothing — a leading `.` is what distinguishes `.Variant` (enum
// member) and `x.field` (property) from a bare name.
lspt_after_dot = (src: string_view, start: i32) bool { start > 0 && at(src, start - 1) == '.' }
lspt_skip_sp = (src: string_view, e: i32) i32 {
    p := e
    @while (at(src, p) == ' ') {
        p = p + 1
    }
    p
}
lspt_call_next = (src: string_view, e: i32) bool {
    p := src.lspt_skip_sp(e)
    at(src, p) == '(' || at(src, p) == '<'
}
// A top-level declaration head: an identifier in column 0, optionally exported with `*`, followed by
// `=` or `:`. `main = () i32 { … }` is a function even though no `(` follows the NAME — the `(` is
// past the `=`. Without this every top-level fn highlights as a plain variable.
lspt_decl_fn = (src: string_view, t: Token) bool {
    (t.start != 0 && at(src, t.start - 1) != '\n').then({
        return false
    })
    p := t.start + t.len
    (at(src, p) == '*').then({
        p = p + 1
    })
    @while (at(src, p) == ' ') {
        p = p + 1
    }
    (at(src, p) != '=').then({
        return false
    })
    src.lspt_call_next(p + 1)
}
lspt_ident_type = (src: string_view, t: Token) i64 {
    src.lspt_is_keyword(t).then({
        return LSPT_KEYWORD()
    })
    src.lspt_after_dot(t.start).then({
        return lspt_upper(at(src, t.start)).then({ LSPT_ENUM_MEMBER() }, { LSPT_PROPERTY() })
    })
    src.lspt_is_builtin_ty(t).then({
        return LSPT_TYPE()
    })
    lspt_upper(at(src, t.start)).then({
        return LSPT_TYPE()
    })
    src.lspt_decl_fn(t).then({
        return LSPT_FUNCTION()
    })
    src.lspt_call_next(t.start + t.len).then({
        return LSPT_FUNCTION()
    })
    LSPT_VARIABLE()
}
lspt_tok_type = (src: string_view, t: Token) i64 {
    t.kind.match ({
        .Ident => src.lspt_ident_type(t),
        .Int   => LSPT_NUMBER(),
        .Float => LSPT_NUMBER(),
        .Str   => LSPT_STRING(),
        .Char  => LSPT_STRING(),
        _      => LSPT_OPERATOR(),
    })
}
// ── emitting the delta-encoded array ─────────────────────────────────────────────────────────────
// LSP encodes each token as five integers relative to the PREVIOUS token: deltaLine, deltaStartChar
// (relative to the previous token's start when on the same line, absolute otherwise), length, type,
// modifiers. Character offsets are UTF-16 code units, not bytes.
LsptCur: {
    out: String,
    line: i64,
    col: i64,
    first: bool,
}
// UTF-16 length of src[a, b) — a byte >= 0xF0 opens a 4-byte sequence, which is a surrogate PAIR
// (two units); every other sequence start is one unit; continuation bytes count for nothing.
lspt_u16_len = (src: string_view, a: i32, b: i32) i64 {
    n: i64 := 0
    p := a
    @while (p < b) {
        c := at(src, p)
        (c & 192 == 128 == false).then({
            n = n + (c >= 240).then({ 2 }, { 1 })
        })
        p = p + 1
    }
    n
}
lspt_push_num = (s: String, mp: MutPtr<Malloc>, n: i64, first: bool) String {
    first.then({
        return s.push_int(mp, n)
    })
    s.gstr_append(mp, ",").push_int(mp, n)
}
// One token, already known to sit on a single line. `ls` is the byte offset of its line's start.
lspt_emit = (
    cur: LsptCur,
    mp: MutPtr<Malloc>,
    src: string_view,
    ls: i32,
    line: i64,
    start: i32,
    end: i32,
    ty: i64,
) LsptCur {
    col := src.lspt_u16_len(ls, start)
    dline := line - cur.line
    dcol := (dline == 0 && cur.first == false).then({ col - cur.col }, { col })
    s := cur.out
        .lspt_push_num(mp, dline, cur.first)
        .lspt_push_num(mp, dcol, false)
        .lspt_push_num(mp, src.lspt_u16_len(start, end), false)
        .lspt_push_num(mp, ty, false)
        .lspt_push_num(mp, 0, false)
    LsptCur(
        out: s,
        line: line,
        col: col,
        first: false,
    )
}
// A string or block comment can span lines; LSP tokens cannot. Split the span at each newline and
// emit one token per line, so a multi-line `"""…"""` literal or `/* … */` highlights on every line.
lspt_emit_span = (
    cur: LsptCur,
    mp: MutPtr<Malloc>,
    src: string_view,
    st: LsptScanLine,
    start: i32,
    end: i32,
    ty: i64,
) LsptCur {
    c := cur
    seg := start
    p := start
    ls := st.ls
    line := st.line
    @while (p < end) {
        (at(src, p) == '\n').then({
            c = c.lspt_emit(mp, src, ls, line, seg, p, ty)
            line = line + 1
            ls = p + 1
            seg = p + 1
        })
        p = p + 1
    }
    (seg < end).then({
        c = c.lspt_emit(mp, src, ls, line, seg, end, ty)
    })
    c
}
// Line/line-start tracking is threaded rather than recomputed: counting newlines from 0 for every
// token is quadratic, and a 5000-line file has tens of thousands of tokens.
LsptScanLine: {
    line: i64,
    ls: i32,
}
lspt_advance = (src: string_view, st: LsptScanLine, to: i32) LsptScanLine {
    line := st.line
    ls := st.ls
    p := ls
    @while (p < to) {
        (at(src, p) == '\n').then({
            line = line + 1
            ls = p + 1
        })
        p = p + 1
    }
    LsptScanLine(
        line: line,
        ls: ls,
    )
}
// ── the merge walk ───────────────────────────────────────────────────────────────────────────────
// Two position-sorted streams (lexer tokens, comments) merged into one ordered emission. The lexer
// skips comments entirely, so without this pass every `//` line would be left unhighlighted.
//
// `emitted` enforces the protocol's one hard invariant: tokens arrive sorted, each encoded as a DELTA
// from the previous one, so a span that starts before the last one ended encodes a negative delta and
// silently corrupts every token after it — the client stops highlighting the buffer entirely. The two
// streams come from two different scanners, so their agreement is an assumption, not a guarantee;
// anything that would move the cursor backwards is dropped instead of trusted.
lspt_tokens* = (mp: MutPtr<Malloc>, src: string_view) string_view {
    cmts := mp.collect_comments(src)
    cur := LsptCur(
        out: mp.gstr_string(4096).gstr_append(mp, "["),
        line: 0,
        col: 0,
        first: true,
    )
    st := LsptScanLine(
        line: 0,
        ls: 0,
    )
    ci: i64 := 0
    pos := 0
    emitted := 0
    running := true
    @while (running) {
        sc := src.scan(pos)
        tstart := sc.tok.kind.match ({
            .Eof => 0 - 1,
            _    => sc.tok.start,
        })
        @while (ci < cmts.len && (tstart < 0 || cmts[ci].start < tstart)) {
            // drain every comment that opens before the next token (or all of them at Eof)
            c := cmts[ci]
            (c.start >= emitted).then({
                st = src.lspt_advance(st, c.start)
                cur = cur.lspt_emit_span(mp, src, st, c.start, c.start + c.len, LSPT_COMMENT())
                emitted = c.start + c.len
            })
            ci = ci + 1
        }
        (tstart < 0).match ({
            true  => {
                running = false
            },
            false => {
                (tstart >= emitted).then({
                    st = src.lspt_advance(st, tstart)
                    cur = cur.lspt_emit_span(mp, src, st, tstart, tstart + sc.tok.len, src.lspt_tok_type(sc.tok))
                    emitted = tstart + sc.tok.len
                })
                pos = sc.next
            },
        })
    }
    cur.out.gstr_append(mp, "]").gstr_finish(mp)
}
