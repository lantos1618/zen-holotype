// Build files are ordinary Zen programs handed a `Builder`.
// Phase order is parse modules -> run build.zen -> compile: a build may
// inspect parsed declarations, but cannot call code from its project.

Alloc = std.mem
Env = std.env
Vec = std.collections
str = std.text

// Temporary @meta boundary: std cannot import the compiler's std/ast
// layer. The driver supplies this bodiless query; @meta will replace both
// stand-ins with the real AST nodes. Function remains opaque until then.
Module* = {
    functions* = (self: @Self, a: Alloc) Res<Vec<Function>, AllocError>
}

Function* = {}

// Allocation is part of the public error set because graph construction,
// discovery, and output-path formatting allocate.
BuildFault* = NotFound | FetchFailed | VersionConflict | HashMismatch

BuildError* = BuildFault | AllocError

// Build files select targets with ordinary matches, not cfg directives.
Os* = Macos | Linux | Windows

Arch* = X86_64 | Arm64

// ABI belongs to target identity because it controls foreign layouts.
Abi* = Gnu | Musl | Msvc | Darwin

Target* = {
    os*: Os,
    arch*: Arch,
    abi*: Abi,
}

// Packages are fetched into a content-addressed cache and hash-verified.
// Source remains the manifest; `zen add` and `zen remove` edit it.
Package* = {
    url*: str,
    version*: str,
    hash*: str,
}

// A resolved graph node. Dependencies are wired per target.
Dep* = {
    name*: str,
}

Exe* = {
    src*: Path,
    deps*: Vec<Dep>,

    // None selects build/{os}-{arch}/{name}.
    out* :: Res<Path> = None,
}

// A Zen binding for system libraries.
Lib* = {
    src*: Path,
    libs*: Vec<str>,
    paths*: Vec<str>,
}

// C sources compiled alongside the Zen tree.
Extern* = {
    src*: Path,
    libs*: Vec<str>,
    paths*: Vec<str>,
}

// A target-specific C translation; defines use NAME or NAME=value.
CImport* = {
    headers*: Vec<str>,
    include_paths*: Vec<str>,
    defines*: Vec<str>,
    libraries*: Vec<str>,
    target*: Target,
}

// Parsed functions selected for `zen test` and their dependencies.
Test* = {
    tests*: Vec<Function>,
    deps*: Vec<Dep>,
}

// Parsed benchmark functions and their regression budgets.
Bench* = {
    benches*: Vec<Function>,
    budgets*: Vec<Budget>,
}

// Allocation budgets are exact; timing uses a rolling median.
Budget* = {
    name*: str,
    ns_op*: u64,
    allocs_op*: u64,
    bytes_op*: u64,
}

// The driver supplies these bodiless methods. `::` receivers mutate the
// graph; `:` receivers only inspect parsed state or target identity.
Builder* = {
    os*: Os,
    arch*: Arch,
    env*: Env,
    alloc*: Alloc,   // build-time arena

    // Inspect parsed declarations without executing project code.
    module* = (self: @Self, path: Path) Module

    // Includes ABI so foreign header layouts are unambiguous.
    target* = (self: @Self) Target

    add* ::= (self :: @Self, name: str, pkg: Package) Res<Dep, BuildError>
    remove* ::= (self :: @Self, name: str) Res<(), BuildError>

    // Reusable targets return a Dep; executable/test runners do not.
    exe* = (self :: @Self, name: str, target: Exe) Res<(), BuildError>
    lib* = (self :: @Self, name: str, target: Lib) Res<Dep, BuildError>
    extern* = (self :: @Self, name: str, target: Extern) Res<Dep, BuildError>
    c_import* = (self :: @Self, name: str, import: CImport)
        Res<Dep, BuildError>
    test* = (self :: @Self, name: str, target: Test) Res<(), BuildError>
    bench* = (self :: @Self, name: str, target: Bench) Res<(), BuildError>

    // Gate total and per-target compile time by rolling median.
    budget* = (self :: @Self, d: Duration) ()
}
