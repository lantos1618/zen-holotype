// src/sema/sema_recv.zen
// Who is allowed to write through a name.
//
// `sema_own.zen` answers who OWNS a value; this answers the other half
// of DESIGN.md's ownership section. A move is a fact about the PATH to a
// node (a flow walk); a receiver requirement is a fact about a
// DECLARATION checked against the path at one call site, so nothing
// here accumulates — every function below is a question with an answer.
//
// `::` on a receiver is not a special rule: it's the ordinary binding
// marker on the ordinary first parameter (`self :: @Self` and `v ::
// Vec<T>` read the same `Param.mutable`), and it is SHALLOW — it means
// the method writes the receiver's own bytes and nothing more, so a
// handle's methods stay `:` even when they change the world (`Alloc.raw`
// allocates, `Env.spawn` starts an actor, neither writes the two words
// it was reached through). The test: whether a bitwise copy of the
// receiver would see the change.
//
// The requirement composes down the path: every link from the binding
// to the receiver must permit the write. A `:` field holding a `Vec`
// refuses a `::` method, since a copy of the struct would not see the
// write; a `:` field holding an `Alloc` accepts every method on it,
// since none of them asks for the write — same marker, opposite
// answers, decided by the bitwise-copy test.
//
// One site, one walk — it used to be two, and the second was untyped.
// `sema_decl.zen` now walks every member body, so both reported the same
// write twice. Measured, not assumed: the deleted walk's case is covered
// by the typed walk through strictly more expression forms, and its own
// `::`-receiver rule even missed an impl-body write, reading fields off
// the impl rather than the target. Removing it cost the suite one
// sentence and no position; that sentence survives in `refuse_link`
// below, naming the METHOD rather than the binding, since that is where
// the `::` permitting the write has to go.
//
// A call is not the only write: `p.x = 1` asks the same composed
// question, answered by the third rule below. Writes go through
// `check_write_place`, walked from `sema_own.zen` where targets are
// already told from values.

Ast, Expr, ExprId, Span = std.ast
Decl, DeclKind, Struct, Member, MemberKind, Function = std.ast
Call, Access, Index, Name, Paren, Field, Const = std.ast
Alloc, AllocError = std.mem
Vec = std.collections
str = std.text
Range = std.core
TyId, Ty, Types, TyNamed = sema.sema_ty
World, decl_at = sema.sema_def
Checker, Ctx = sema.sema_check
SemaFault, NameFault = sema.sema_diag
member_named = sema.sema_member
Own, find_var, var_mutable, path_root = sema.sema_own
place_type, refuse = sema.sema_own

// ---------------------------------------------------------------------
// RULE: a `::` method needs a mutable receiver
//
// Only a path rooted at a local is checked — a safety rule, not a
// shortcut. A call-result receiver is a temporary this frame owns
// outright and can always be written; a receiver rooted at a module or
// type name is not a value at all, and asking its type would report a
// mistake the program does not contain.
// ---------------------------------------------------------------------

check_receiver* = (c :: Checker, o :: Own, k: Call, ctx: Ctx)
                  Res<(), AllocError> {
    c.tree.expr_at(k.callee).kind.match({
        Access(a) => check_method_call(c, o, a, ctx),
        _         => Ok(()),
    })
}

check_method_call = (c :: Checker, o :: Own, a: Access, ctx: Ctx)
                    Res<(), AllocError> {
    path_root(c, o, a.base).match({
        None  => Ok(()),
        Ok(_) => check_receiver_path(c, o, a, ctx),
    })
}

check_receiver_path = (c :: Checker, o :: Own, a: Access, ctx: Ctx)
                      Res<(), AllocError> {
    ty = place_type(c, o, a.base);
    wants_mutable(c, ty, a.name.text).match({
        false => Ok(()),
        true  => require_mutable(c, o, a),
    })
}

// The receiver is what is wrong, so the diagnostic points at the base
// of the dot, never at the correctly-declared method name.
require_mutable = (c :: Checker, o :: Own, a: Access) Res<(), AllocError> {
    place_mutable(c, o, a.base).match({
        true  => Ok(()),
        false => refuse(
            c,
            c.tree.expr_at(a.base).span,
            SemaFault.NeedsMutableReceiver(NameFault(name: a.name.text))
        ),
    })
}

// Every link, from the binding out to the receiver. A link the lookup
// cannot resolve permits the write — the fail-open this pair of files
// applies everywhere.
place_mutable = (c :: Checker, o :: Own, id: ExprId) bool {
    node = c.tree.expr_at(id);
    node.kind.match({
        Name(n)   => var_mutable(o, n.text),
        Paren(p)  => place_mutable(c, o, p.inner),
        Access(a) => link_mutable(c, o, a),
        _         => true,
    })
}

link_mutable = (c :: Checker, o :: Own, a: Access) bool {
    place_mutable(c, o, a.base)
        && field_mutable(c, place_type(c, o, a.base), a.name.text)
}

// ---------------------------------------------------------------------
// RULE: a write needs a mutable place
//
// The same composed question as the receiver rule, asked of a write:
// `p.x = 1` needs `p` to permit the write and `x` to be `::`, since a
// bitwise copy of `p` would not see it. `sema_own.zen` owns the walk
// that finds the targets and calls in here; a bare name never arrives,
// since Zen spells assignment and declaration the same, and whether
// `n = 1` is a write is `sema_own.zen`'s question about its own scope.
// ---------------------------------------------------------------------

check_write_place* = (c :: Checker, o :: Own, id: ExprId)
                     Res<(), AllocError> {
    node = c.tree.expr_at(id);
    node.kind.match({
        Access(_) => refuse_immutable_link(c, o, node, id),
        Index(_)  => refuse_immutable_link(c, o, node, id),
        _         => Ok(()),
    })
}

// The position is the target, where the write is written. The name is
// the link that refuses, which is not the same thing: `q.y = 2` with a
// `::` binding and a `:` field is wrong at `y`, and naming `q` would
// send the reader to the marker that is already right.
refuse_immutable_link = (c :: Checker, o :: Own, node: Expr, id: ExprId)
                        Res<(), AllocError> {
    immutable_link(c, o, id).match({
        None   => Ok(()),
        Ok(nm) => refuse_link(c, o, node, nm),
    })
}

// Which sentence, decided by whether the refusing link is the receiver.
// Every other link names a binding or field the author can re-mark;
// `self` names neither — the `::` that would permit the write goes on
// the METHOD, so the method is what the diagnostic names ("self is
// declared `:`" gives the reader nothing to act on).
refuse_link = (c :: Checker, o :: Own, node: Expr, nm: str)
              Res<(), AllocError> {
    (nm.eq("self") && (o.method.len > 0)).match({
        true  => refuse(
            c,
            node.span,
            SemaFault.NeedsMutableReceiver(NameFault(name: o.method))
        ),
        false => refuse(
            c,
            node.span,
            SemaFault.ImmutableWrite(NameFault(name: nm))
        ),
    })
}

// From the binding outwards, the first link that does not permit a
// write — so a `:` binding is reported before the fields reached
// through it, since fixing the binding makes the rest legal.
immutable_link = (c :: Checker, o :: Own, id: ExprId) Res<str> {
    node = c.tree.expr_at(id);
    node.kind.match({
        Name(n)   => name_link(o, n.text),
        Paren(p)  => immutable_link(c, o, p.inner),
        Index(x)  => immutable_link(c, o, x.base),
        Access(a) => access_link(c, o, a),
        _         => None,
    })
}

name_link = (o: Own, text: str) Res<str> {
    var_mutable(o, text).match({ true => None, false => Ok(text) })
}

access_link = (c :: Checker, o :: Own, a: Access) Res<str> {
    immutable_link(c, o, a.base).match({
        Ok(nm) => Ok(nm),
        None   => field_link(c, place_type(c, o, a.base), a.name.text),
    })
}

field_link = (c: Checker, ty: TyId, name: str) Res<str> {
    field_mutable(c, ty, name).match({ true => None, false => Ok(name) })
}

// ---------------------------------------------------------------------
// what a dot reaches, asked without reporting
//
// `sema_member.zen` answers this properly, with impl selection, bounds,
// and substitution. This asks a smaller question off the declaration
// directly — is there a member of this name, what marker did it carry —
// because the full query is entitled to raise diagnostics and these
// walks are not: an ownership pass reporting an ambiguity would be
// reporting it a second time.
// ---------------------------------------------------------------------

wants_mutable = (c: Checker, ty: TyId, name: str) bool {
    own_member(c, ty, name).match({
        None  => false,
        Ok(m) => receiver_is_mutable(m),
    })
}

// A receiver is the first parameter and nothing more, so this asks what
// the first parameter is. `self` by name: a free function whose first
// parameter happens to be `::` is a function taking a mutable parameter,
// not a method — calling it is not a dot.
receiver_is_mutable* = (m: Member) bool {
    m.kind.match({
        Function(f) => first_param_mutable(f),
        _           => false,
    })
}

first_param_mutable = (f: Function) bool {
    f.params.get(0).match({
        None  => false,
        Ok(p) => p.name.text.eq("self") && p.mutable,
    })
}

field_mutable = (c: Checker, ty: TyId, name: str) bool {
    own_member(c, ty, name).match({
        None  => true,
        Ok(m) => member_is_mutable(m),
    })
}

member_is_mutable = (m: Member) bool {
    m.kind.match({
        Field(f)    => f.mutable,
        Const(k)    => k.mutable,
        Function(_) => true,
    })
}

// The type's own body, and only it. An impl-supplied member is not
// searched — a deliberate narrowing: selecting between impls is
// `sema_member.zen`'s rule, needs bounds in scope, and may report an
// ambiguity, all of which this walk has given up. A `::` method
// supplied by an impl is a check this file does not make (fail-open,
// not unsound), and it costs nothing: no impls to scan means no
// allocator, so every caller above stays a plain `bool`.
own_member* = (c: Checker, ty: TyId, name: str) Res<Member> {
    c.types.at(ty).match({
        Named(n) => named_member(c, n, name),
        _        => None,
    })
}

named_member = (c: Checker, n: TyNamed, name: str) Res<Member> {
    decl_at(c.tree, n.decl).match({
        None  => None,
        Ok(d) => decl_member(d, name),
    })
}

decl_member = (d: Decl, name: str) Res<Member> {
    d.kind.match({
        Struct(st) => find_member(st.members, name),
        _          => None,
    })
}

find_member = (members: Vec<Member>, name: str) Res<Member> {
    Range(0, members.len).find((i) {
        members.get(i).match({
            Ok(m) => member_named(m, name),
            None  => false,
        })
    }).match({
        None  => None,
        Ok(i) => members.get(i),
    })
}
