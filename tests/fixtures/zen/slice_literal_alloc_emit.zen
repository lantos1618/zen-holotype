// The two lowerings of a slice literal, in one file — the TEETH for compiler.backend.c.c_escape.
//
// A literal that can OUTLIVE its frame heap-promotes its backing so `.ptr` stays valid, and that malloc
// MUST route through zen__salloc, which NULL-checks and panics cleanly on OOM instead of memcpy-ing into
// a NULL pointer (which segfaulted under an exhausted heap). Both shapes here are that kind: `keep3`
// hands its parameter straight back out, and `returned` yields the literal itself.
//
// A literal the callee only BORROWS needs no heap at all: `sum3` merely indexes its parameter, so the
// literal lowers to a plain C compound literal whose automatic storage outlives the call it is written
// in. Heap-by-default means the classification only ever moves a literal off the heap when it is PROVEN
// not to escape — so `escaping`/`returned` keeping their zen__salloc is the guard that it has not
// started guessing.
sum3* = (xs: [i32]) i32 { xs[0] + xs[1] + xs[2] }
keep3* = (xs: [i32]) [i32] { xs }
borrowed* = () i32 { sum3([10, 20, 30]) }
escaping* = () i32 {
    r = keep3([1, 2, 3])
    r[0] + r[1] + r[2]
}
returned* = () [i32] { [4, 5, 6] }
// `xs[1]` READS an element (a borrow), but `.addr()` of one hands out a pointer INTO the backing store,
// which is the literal escaping under an element access. Stack storage here would dangle the moment
// `interior`'s call returns, so this literal must keep its heap block too.
pick* = (xs: [i32]) MutPtr<i32> { xs[1].addr() }
interior* = () i32 { load(pick([7, 8, 9])) }
