// ONE NAME ON ONE TYPE AT TWO ARITIES: arity 2 is the method, arity 3 is a
// free function taking the type first. Each call picks its own body, from
// one overload set.
//
// This is exactly the shape DESIGN.md's UFCS rule makes legal and
// ufcs_collisions.py declines to report: arities differ, so no ambiguity
// exists. The wrong implementation merges candidates into one entry keyed
// by name alone -- the natural table shape -- and then either rejects the
// second declaration or answers every call with whichever body landed
// last. Both bodies answer i32, so the C compiles either way; the two
// numbers are chosen so neither body can produce the other line.
//
// Breaks if: the candidate table is keyed by NAME without arity -- the
// second `mix` overwrites the first and one line reads the other body.

W = {
    v: i32,
    mix = (self: @Self, k: i32) i32 { self.v * 1000 + k }
}

mix = (w: W, k: i32, j: i32) i32 { w.v * 100 + k * 10 + j }

main = (env: Env) Res<i32, AllocError> {
    w = W(v: 5);
    println("arity-2 {}", w.mix(3));
    println("arity-3 {}", w.mix(1, 2));
    Ok(0);
}
