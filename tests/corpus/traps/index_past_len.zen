// tests/corpus/traps/index_past_len.zen
// primes[5] on a [i32, 4] traps: one further out than index_at_len,
// so an off-by-one in the check cannot pass both

// main must name an error type. a trap never lifts into Res:
// it aborts the process
Error =
    Overflow,
    DivideByZero,
    OutOfBounds

main = (env: Env) Res<i32, Error> {
    primes = [i32, 4](2, 3, 5, 7);
    v = primes[5];
    println("{}", v);
    Ok(0);
}
