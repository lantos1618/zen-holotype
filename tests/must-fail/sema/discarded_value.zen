// A statement that is a pure READ computes a value and nothing else,
// so when nothing reads the value the statement was either meant to be
// a binding or meant to be deleted. `p.x;` is the shape a dropped
// helper result takes once the helper is a field or a parameterless
// read: no call, no trap, no propagation — just a computed `i32`,
// gone.
//
// Calls are exempt (they are run for their effects), and so is
// arithmetic (it can trap — `self.len - i - 1;` is this tree's range
// guard); the corpus half is corpus/sema/statement_effects.
//
// position: the statement, semicolon included.

Point* = { x :: i32 }

main = (env: Env) Res<i32, AllocError> {
    p = Point(x: 1);
    p.x;
    Ok(0);
}
