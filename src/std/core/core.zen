// src/std/core/core.zen
//
// The prelude root: nothing but starred re-exports.
//
// Re-export is an import whose bindings are starred — same `*` a
// type/field/method uses, `=` the binding it already is; no `export`,
// no `from`. That's what lets the prelude span several small files.
// Importing a name pulls its world along: a type travels with its
// methods, impls, and UFCS functions whose first param is that type —
// `Res` arrives with `ok_or`, `bool` with `then`, neither listed twice.

Res*, Ok*, Err*, None*, ok_or*, map_err*, replace_err* = std.core.result

then*, ensure*, bool* = std.core.bool

Drop* = std.core.drop

Scope* = std.core.scope

i8*, i16*, i32*, i64* = std.core.num
u8*, u16*, u32*, u64*, usize* = std.core.num
f32*, f64* = std.core.num
pow2* = std.core.num

// the widening conversions as bounds — the conversions themselves
// travel with their types, these names are for writing <T: ToU32>
ToU16*, ToU32*, ToU64*, ToUsize*,
    ToI16*, ToI32*, ToI64*, ToF64* = std.core.num

// a byte's own questions, all ASCII — UFCS puts them on u8, so
// `b.is_digit()` needs no import beyond the prelude
is_ascii*, is_digit*, is_lower*, is_upper*, is_alpha*, is_alnum*,
    is_space*, is_ident_start*, is_ident_cont*, is_hex_digit*,
    digit_value*, hex_value*, hex_usize*,
    to_lower*, to_upper*, hex_digit* = std.core.byte

// The rest of core/, owned by the files named — module paths match
// PLAN.md's tree, names match DESIGN.md's prelude block.
loop*, find*, filter*, map*, LoopHandle* = std.core.loop
Range* = std.core.range

Eq*, is_in* = std.core.eq

Hash*, Hasher* = std.core.hash

Display* = std.core.display

// IoError is here rather than in std.text or std.env because every
// Display signature names it, and core sits below both
IoError*, WriteError*, Sink* = std.core.io
Path*, join_path* = std.core.path
Duration* = std.core.time

// reading a number back out of text — UFCS puts parse_i64 on str, so
// `arg.parse_i64()` needs no import beyond the prelude
parse_i64* = std.text

// The containers and text types are prelude names too — DESIGN.md's
// main.zen writes `alloc.Vec<str>()`, `str`, `String` with no imports;
// each name is both the type and its ufcs constructor. This is core
// naming a layer above it, which the direction test would normally
// forbid — but a re-export isn't a dependency: nothing in std.core
// calls these, the line only makes the name reachable.
str*, String* = std.text
// Ordered travels with sort: `v.sort()` resolves through the prelude,
// so the bound that makes it legal is nameable the same way
Vec*, Map*, Ordered*, vararg* = std.collections
Alloc*, AllocError*, Arena*, Mem*, Ptr*, null_ptr* = std.mem

// `Env` is a prelude name — DESIGN.md: "`Res`, `Ok`, `Vec`, `Map`,
// `str`, `Env` and the rest are in scope everywhere without a line".
// Law 2 makes `main = (env: Env) ..` every program's opening signature.
// ArgError travels with Env: `main = (env: Env) Res<i32, ArgError>` is
// that same signature — a prelude carrying only half breaks hello-world.
// The types of Env's fields travel too: a function that touches a
// capability says so in its signature (law 2), and `Console`, `Stdin`,
// `Fs` are how it is written. FsError is the error `env.fs.read`
// answers, so a main that reads files can name what it propagates.
Env*, ArgError*,
    Console*, Stdin*, Fs*, FsError*,
    Net*, Threads*, Thread*, ThreadError* = std.env
