alloc = std.mem.heap
{ Result, IoError, expect } = std.core.result
{ Context, Receiver, ReplyRef, ActorCell } = std.concurrent.actor
Msg*: Ping(ReplyRef<i32>)
Room*: {
    n: i32,
}
Room.impl(Receiver, {
    receive = (room: MutPtr<Room>, ctx: Context<Msg>) void {
        ctx.msg.match ({
            .Ping(reply_to) => reply_to.send(7),
        })
    }
})
main = () i32 {
    heap := alloc.gpa()
    cell_r: Result<ActorCell<Msg>, IoError> := heap.addr().cell(4)
    cell := cell_r.expect("gpa cell allocation")
    reply_r: Result<ReplyRef<i32>, IoError> := cell.reply(heap.addr())
    reply_to := reply_r.expect("gpa reply allocation")
    ref: CellRef<Msg> := cell.ref()
    ref.send(.Ping(reply_to))
    room := Room(n: 0)
    cell.drain(room.addr())
    out := reply_to.claim(heap.addr())
    cell.free(heap.addr())
    out
}
