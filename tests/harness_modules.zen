            needle: "error[ownership]",
        ),
        ModVerdictCase(
            files: [
                ModFile(
                    name: "reslib.zen",
                    src: "{ Rc } = std.mem.rc\ndrop* = (r: Rc<i32>, a: MutPtr<Heap>) void { r.drop_in(a) }\n",
                ),
                ModFile(
                    name: "p.zen",
                    src: "{ drop } = reslib\nrc = std.mem.rc\n{ expect } = std.core.result\nhalloc = std.mem.heap\nmain = () i32 {\n  alloc := halloc.gpa()\n  a := alloc.addr()\n  r := rc.new_in(a, 5).expect(\"rc\")\n  drop(r, a)\n  to_i32(r.get())\n}\n",
                ),
            ],
            entry: "p.zen",
            should_pass: false,
            needle: "error[ownership]",
        ),
        ModVerdictCase(
            files: [
                ModFile(
                    name: "mathlib.zen",
                    src: "release* = (x: i64, y: i64) i64 { x + y }\n",
                ),
                ModFile(
                    name: "p.zen",
                    src: "mathlib = mathlib\nmain = () i32 {\n  s := mathlib.release(20, 22)\n  to_i32(s) - 42\n}\n",
                ),
            ],
            entry: "p.zen",
            should_pass: true,
            needle: "",
        ),
        ModVerdictCase(
            files: [
                ModFile(
                    name: "hooks.zen",
                    src: "run_shell* = (cmd: string_view) i32\n",
                ),
                ModFile(
                    name: "p.zen",
                    src: "{ run_shell } = hooks\nmain = () i32 { run_shell(\"true\") }\n",
                ),
            ],
            entry: "p.zen",
            should_pass: false,
            needle: "error[ffi-ungranted]: module 'hooks' declares foreign function `run_shell` without a build grant",
        ),
        ModVerdictCase(
            files: [
                ModFile(
                    name: "hooks.zen",
                    src: "run_shell* = (cmd: string_view) i32\n",
                ),
                ModFile(
                    name: "p.zen",
                    src: "//! ffi: hooks\n{ run_shell } = hooks\nmain = () i32 { run_shell(\"true\") }\n",
                ),
            ],
            entry: "p.zen",
            should_pass: true,
            needle: "",
        ),
        ModVerdictCase(
            files: [
                ModFile(
                    name: "p.zen",
                    src: "c_getpid = () i32\nmain = () i32 { c_getpid() }\n",
                ),
            ],
            entry: "p.zen",
            should_pass: true,
            needle: "",
        ),
        ModVerdictCase(
            files: [
                ModFile(
                    name: "hooks.zen",
                    src: "run_shell* = (cmd: string_view) i32\n",
                ),
                ModFile(
                    name: "mid.zen",
                    src: "{ run_shell } = hooks\nwrap* = (c: string_view) i32 { run_shell(c) }\n",
                ),
                ModFile(
                    name: "p.zen",
                    src: "//! ffi: mid\n{ wrap } = mid\nmain = () i32 { wrap(\"x\") }\n",
                ),
            ],
            entry: "p.zen",
            should_pass: false,
            needle: "module 'hooks' declares foreign function `run_shell`",
        ),
        ModVerdictCase(
            files: [
                ModFile(
                    name: "vendor/hooks.zen",
                    src: "sneak* = () i32\n",
                ),
                ModFile(
                    name: "p.zen",
                    src: "//! ffi: vendor.hooks\nvh = vendor.hooks\nmain = () i32 { vh.sneak() }\n",
                ),
            ],
            entry: "p.zen",
            should_pass: true,
            needle: "",
        ),
    ])
    // TWO different impl bodies for one (receiver, trait) across two modules: "first wins" would
    // silently drop the second body — must be a loud error[dup-impl] naming both modules.
    // the same conflict INSIDE one module (the entry program itself) — also error[dup-impl].
    // World teaching hint (Stage B3): a bare call of a name that exists ONLY behind a module
    // alias names the exporting module in the undefined-name hint …
    // … and spells out the exact import line to add.
    // Stage B3/R2: cross-module duplicate attribution comes from the sig import-map — the
    // diagnostic names BOTH the redefining module and the FIRST provider.
    // Stage B3/R1: sig-based privacy through the C-keyword escape — the import head queries the
    // `_zk`-escaped key, the sig stores raw + escaped forms for the same private decl.
    // entry defines a name a DEP defines PRIVATELY (never imported by the entry): the entry's decl is
    // shadow-renamed at flatten so both survive — compiles clean (was error[dup-fn]; the #1 newcomer bounce).
    // same hygiene for a PUBLIC dep export the entry redefines without importing it by name: the entry's
    // `helper` shadows; `pubf` still calls the dep's own `helper`. Compiles clean.
    // THE #1 bounce: a user helper (`eq`) collides with a same-named export pulled in TRANSITIVELY by
    // `std.text.fmt` (never imported by name). The user's `eq` is shadow-renamed → compiles clean.
    // the checker-path dup-fn diagnostic NAMES the colliding symbol (the resolver's rich
    // fail_dup_user only covers imported-user-module vs imported-user-module) and anchors
    // file:line:col at the LATER definition in flat order.
    // NON-MAIN user modules get the SAME shadow protection (per-module `zshadowN__name` regions):
    // a library module whose own `len` collides with an unimported transitive std export keeps its
    // decl — see the `libm`/`run2` VALUE case above (7, not std strlen's 2). Two edges stay LOUD,
    // never silent: another module importing the shadowed name BY NAME from the library rejects
    // with error[dup-fn] (the rename would misbind the importer), and import-then-redefine in ONE
    // module rejects with error[dup-fn] anchored at the USER's definition line (p.zen:2:1), naming
    // the import — not at the library decl the flat order happens to put later.
    // ENTRY-vs-DEP name collisions no longer reject: an entry decl whose name is ALSO defined by a
    // dependency the entry never imported BY NAME is shadow-renamed at flatten (`zshadow__name`), so the
    // entry keeps its own decl and the dep keeps its own — see the two should_pass:true cases above and the
    // runtime value case (each module keeps its own `privh`). A GENUINE conflict — a same-module dup, or a
    // name the entry imports by name (`{ len } = std.text.str`) then redefines — still rejects with dup-fn.
    // ── UFCS through module aliases: AMBIGUITY rejects positioned, naming both candidates ─────
    // two aliases provide `bump(Pt, i32)` → `p.bump(2)` rejects; the qualified `x.bump(p, 2)` accepts.
    // ── visibility: `*` is ENFORCED — error[private-name] ────────────────────────────────────
    // flat `{ hidden } = vv`, qualified `m.hidden(…)`, and a qualified private TYPE all reject;
    // exported names accept via both forms; a name the module itself imports stays importable
    // (transitive re-export — visibility is decided at the defining module).
    // ── exported sigs must not EXPOSE private types — error[private-leak] ────────────────────
    // an exported fn returning (or taking) a type its own module defines but does not export
    // rejects naming BOTH the fn and the type; exporting the type accepts; a type imported from
    // another module (transitive re-export) stays sanctioned.
    // ── FFI is a BUILD-GRANTED capability — error[ffi-ungranted] ─────────────────────────────
    // a DEP module declaring a foreign (bodyless) fn without a grant rejects, naming the module
    // and the symbol; an entry-file `//! ffi: hooks` pragma grants it; the ENTRY module's own
    // externs stay implicitly granted (the threat is transitive deps, not the program's own file);
    // grants name the DECLARING module — granting `mid` does NOT grant its dep `hooks`; dotted
    // subdir ids (`vendor.hooks`) grant the same way. zen.toml `ffi = "…"` and build.zen
    // `.ffi("…")` grants are covered in harness_build's project cases.
    // ── the net is NOT hollow: cross-module calls are arity/arg-type checked (test_modules_oracle) ──
    // ── transitive / clash rejections (test_resolver_oracle) ─────────────────────────────────
    // ── namespace-bound diagnostics keep the USER source span (test_user_imports) ────────────
    // ── loader-error QUALITY: clean messages, not raw linker spew (test_user_imports) ────────
    // ── sibling name COLLISIONS reject with origin + hint (test_user_imports) ────────────────
    // the collision diagnostic NAMES the origin module + the redefining module.
    // C-keyword symbol-key collision (struct vs struct_zk) is still caught.
    // ── test_resolver_fixes.py — driver-level check cases ────────────────────────────────────
    // bug 1: co-imports whose closures share generic decls (new<T>, release<T>*, dup<T>) check clean.
    // generic-heavy modules check clean on their own.
    // bug 3: multi-line impl bodies (runtime) + multi-line imports (ast) resolve clean.
    // std.concurrent.actor standalone-checks: indented `sent = true` is code, not an import of sibling `true`;
    // and actor exports spawn despite the coroutine substrate owning the same name.
    // a user decl that collides with an UNIMPORTED name in its std closure is shadow-renamed (compiles),
    // NOT rejected; a name the user imports BY NAME then redefines still rejects (dup-fn).
    // two imported modules sharing a name still dedup silently (dependency-first, no false dup).
    // unknown type names in annotations / returns / lets are rejected (driver unknown-type pass).
    // defined / primitive / generic / imported types must NOT be flagged (no false positive).
    // must-use: a discarded value-mold (Self,…) Self self-mutation result is rejected; rebind/tail OK;
    // the Result-always mold (Self,…) Result<Self, E> (Map.put) rejects the same discard, rebind+expect OK.
    // lambdas: a bound local lambda used as a HOF arg compiles; a non-capturing field/returned lambda
    // is lifted (accepts); a CAPTURING field lambda rejects with error[lambda-value].
    // ── a large namespace-bound compiler module resolves without overflowing the resolver ────
    e := run_mod_emits("modules emit (resolution-before-cgen / literal preservation)", [
        ModEmitCase(
            files: [
                ModFile(
                    name: "right.zen",
                    src: "default* = (n: i32) i32 { n + 5 }\n",
                ),
                ModFile(
                    name: "p.zen",
                    src: "heap = std.mem.heap\nright = right\nmain = () i32 {\n    h := heap.gpa()\n    to_i32(30) + right.default(7)\n}\n",
                ),
            ],
            entry: "p.zen",
            present: ["heap__gpa()", "right__default(7LL)"],
            absent: ["default_zk(heap)", "default_zk(right"],
        ),
        ModEmitCase(
            files: [
                ModFile(
                    name: "right.zen",
                    src: "thing* = () i32 { 5 }\ntext* = () str { \"thing\" } // thing in a comment should stay inert\n",
                ),
                ModFile(
                    name: "p.zen",
                    src: "right = right\n{ eq } = std.text.str\n{ to_exit } = std.core.bool\nmain = () i32 {\n    literal := \"right.thing\"\n    ok := eq(literal, \"right.thing\") && eq(right.text(), \"thing\")\n    ok.to_exit()\n}\n",
                ),
            ],
            entry: "p.zen",
            present: ["\"right.thing\""],
            absent: ["\"right__thing\""],
        ),
        ModEmitCase(
            files: [
                ModFile(
                    name: "p.zen",
                    src: "cv = compiler.validate.diag\nmain = () i32 { 0 }\n",
                ),
            ],
            entry: "p.zen",
            present: ["cv__diagnostic_from_source"],
            absent: [],
        ),
        ModEmitCase(
            files: [
                ModFile(
                    name: "helper.zen",
                    src: "addh* = (a: i32, b: i32) i32 { a + b }\n",
                ),
                ModFile(
                    name: "main.zen",
                    src: "{addh} = helper\ntest* = () i32 { addh(3, 4) }\nmain = () i32 { test() }\n",
                ),
            ],
            entry: "main.zen",
            present: ["return addh(3LL, 4LL)", "int32_t addh("],
            absent: [],
        ),
        ModEmitCase(
            files: [
                ModFile(
                    name: "helper.zen",
                    src: "addh* = (a: i32, b: i32) i32 { a + b }\n",
                ),
                ModFile(
                    name: "main.zen",
                    src: "{ addh } = helper\ntest* = () i32 { addh(3, 4) }\nmain = () i32 { test() }\n",
                ),
            ],
            entry: "main.zen",
            present: ["return addh(3LL, 4LL)", "int32_t addh("],
            absent: [],
        ),
        ModEmitCase(
            files: [
                ModFile(
                    name: "helper.zen",
                    src: "addh* = (a: i32, b: i32) i32 { a + b }\n",
                ),
                ModFile(
                    name: "main.zen",
                    src: "{addh } = helper\ntest* = () i32 { addh(3, 4) }\nmain = () i32 { test() }\n",
                ),
            ],
            entry: "main.zen",
            present: ["return addh(3LL, 4LL)", "int32_t addh("],
            absent: [],
        ),
        ModEmitCase(
            files: [
                ModFile(
                    name: "helper.zen",
                    src: "addh* = (a: i32, b: i32) i32 { a + b }\n",
                ),
                ModFile(
                    name: "main.zen",
                    src: "{ addh} = helper\ntest* = () i32 { addh(3, 4) }\nmain = () i32 { test() }\n",
                ),
            ],
            entry: "main.zen",
            present: ["return addh(3LL, 4LL)", "int32_t addh("],
            absent: [],
        ),
    ])
    // namespace-bound calls are rewritten to module-qualified C symbols before cgen.
    // the namespace rewriter preserves string literals + comments (only real calls rewritten).
    // a large namespace-bound compiler module emits the qualified symbol without overflow.
    // import-head spacing variants all emit the resolved sibling call (test_modules_oracle).
    dc := run_mod_docs("modules doc (exported signatures)", [
        ModDocCase(
            module: "std.concurrent.actor",
            present: ["spawn_handle*<M, ActorT>", "cell*<M> = (alloc: Allocator"],
        ),
    ])
    // std.concurrent.actor exports the generic Result-returning spawn/cell signatures.
    sd := run_mod_stdins("modules stdin (no program dir)", [
        ModStdinCase(
            src: "{ helper } = b\nmain = () i32 { helper(21) }\n",
            should_succeed: false,
            present: ["sibling import 'b'", "stdin"],
        ),
        ModStdinCase(
            src: "main = () i32 { 6 * 7 }\n",
            should_succeed: true,
            present: ["int32_t zen_main("],
        ),
    ])
    // a sibling import from STDIN has no directory to resolve from → clean error, no half-emitted C.
    // import-free source stays the classic source→C filter (Zen main emitted as zen_main).
    // ── deep-loader PUBLIC API: resolve_program_data / resolve_parsed_program / check_parsed_program ──
    // These drive the loader's INTERNAL structures (the module_table, per-module ParsedProgram AST
    // boundary, and graph-linked cross-module check) directly, as `zenc run` driver programs. The
    // progdir is this run's private mod_dir (baked into the generated driver at runtime); root is "."
    // because the harness runs `./zen` from the repo root, so std resolves relative to the cwd.
    dl := run_mod_deep("modules value (deep loader API: resolve_program_data / parsed_program / check)", [
        DeepCase(
            base_files: [
                ModFile(
                    name: "helper.zen",
                    src: "value* = () i32 { 7 }\n",
                ),
                ModFile(
                    name: "left.zen",
                    src: "helper = helper\nthing* = () i32 { helper.value() }\n",
                ),
                ModFile(
                    name: "right.zen",
                    src: "thing* = () i32 { 20 }\n",
                ),
                ModFile(
                    name: "plain.zen",
                    src: "plain* = () i32 { 5 }\n",
                ),
            ],
            kind: 0,
        ),
        DeepCase(
            base_files: [
                ModFile(
                    name: "helper.zen",
                    src: "value* = () i32 { 7 }\n",
                ),
                ModFile(
                    name: "left.zen",
                    src: "helper = helper\nthing* = () i32 { helper.value() }\n",
                ),
                ModFile(
                    name: "right.zen",
                    src: "thing* = () i32 { 20 }\n",
                ),
                ModFile(
                    name: "plain.zen",
                    src: "plain* = () i32 { 5 }\n",
                ),
            ],
            kind: 1,
        ),
        DeepCase(
            base_files: [
                ModFile(
                    name: "left.zen",
                    src: "thing* = (a: i32, b: i32) i32 { a + b }\n",
                ),
                ModFile(
                    name: "plain.zen",
                    src: "plain* = (a: i32) i32 { a }\n",
                ),
            ],
            kind: 2,
        ),
        DeepCase(
            base_files: [
                ModFile(
                    name: "helper.zen",
                    src: "value* = () i32 { 7 }\n",
                ),
                ModFile(
                    name: "left.zen",
                    src: "helper = helper\nthing* = () i32 { helper.value(1) }\n",
                ),
            ],
            kind: 3,
        ),
    ])
    // resolve_program_data: the ResolvedProgram.table holds every transitively-loaded namespace module
    //   (u/left,u/right,u/plain,u/helper) with per-module graphs, and the flat body is namespace-stripped.
    // resolve_parsed_program: the ParsedProgram keeps a per-module decls/body AST boundary (root + deps).
    // check_parsed_program + root_link_decls: the graph-linked cross-module check accepts a well-typed
    //   program (0) and rejects both a namespace-qualified and a plain wrong-arity call (> 0); the root
    //   link set is exactly the 2 direct imports.
    // check_all_parsed_modules + module_link_decls: validates EVERY module body against its import graph.
    //   Root-only check passes (main calls left.thing()), but left's internal helper.value(1) arity
    //   error is caught by the all-modules pass (> 0).
    // ── dotted USER module ids (module-system Stage B1) ──────────────────────────────────────────
    // User ids form ONE flat progdir-rooted logical namespace: `app.utils` → <progdir>/app/utils.zen,
    // and a dotted module names its own dependencies by FULL id from that same root (`app.core`),
    // never relative to its own subdirectory. Namespace binds accept dotted ids too. Edge id/alias
    // buffers are sized exactly, so ids/aliases longer than the old fixed 128/64-byte caps resolve
    // without silent truncation. A missing nested file keeps the unknown-module error naming the
    // attempted path, and `*` privacy is enforced unchanged for dotted modules.
    dv := run_mod_values("modules value (dotted user module ids)", [
        ModValCase(
            files: [
                ModFile(
                    name: "app/utils.zen",
                    src: "seven* = () i32 { 7 }\n",
                ),
                ModFile(
                    name: "p.zen",
                    src: "{ seven } = app.utils\nmain = () i32 { seven() * 6 }\n",
                ),
            ],
            entry: "p.zen",
            want: 42,
        ),
        ModValCase(
            files: [
                ModFile(
                    name: "app/core.zen",
                    src: "base* = () i32 { 40 }\n",
                ),
                ModFile(
                    name: "app/utils.zen",
                    src: "{ base } = app.core\nseven* = () i32 { base() - 33 }\n",
                ),
                ModFile(
                    name: "p.zen",
                    src: "{ seven } = app.utils\nmain = () i32 { seven() * 6 }\n",
                ),
            ],
            entry: "p.zen",
            want: 42,
        ),
        ModValCase(
            files: [
                ModFile(
                    name: "app/utils.zen",
                    src: "seven* = () i32 { 7 }\n",
                ),
                ModFile(
                    name: "p.zen",
                    src: "u = app.utils\nmain = () i32 { u.seven() * 6 }\n",
                ),
            ],
            entry: "p.zen",
            want: 42,
        ),
        ModValCase(
            files: [
                ModFile(
                    name: "verylongmodulename_abcdefghijklmnopqrstuvwxyz0123456789_abcdefghijklmnopqrstuvwxyz0123456789_abcdefghijklmnopqrstuvwxyz0123456789_end.zen",
                    src: "val* = () i32 { 21 }\n",
                ),
                ModFile(
                    name: "p.zen",
                    src: "{ val } = verylongmodulename_abcdefghijklmnopqrstuvwxyz0123456789_abcdefghijklmnopqrstuvwxyz0123456789_abcdefghijklmnopqrstuvwxyz0123456789_end\nmain = () i32 { val() * 2 }\n",
                ),
            ],
            entry: "p.zen",
            want: 42,
        ),
        ModValCase(
            files: [
                ModFile(
                    name: "app/utils.zen",
                    src: "seven* = () i32 { 7 }\n",
                ),
                ModFile(
                    name: "p.zen",
                    src: "averyveryveryveryveryveryveryveryveryveryverylongaliasname_0123456789_tail = app.utils\nmain = () i32 { averyveryveryveryveryveryveryveryveryveryverylongaliasname_0123456789_tail.seven() * 6 }\n",
                ),
            ],
            entry: "p.zen",
            want: 42,
        ),
    ])
    // ── identity-based diagnostic map (flat offset → module + original line, no text matching) ────
    // Each case pins the full `path:line:col` needle (the temp project dir always contains
    // `zo_mods/`), so a wrong file, line, OR column fails the case.
    im := run_mod_verdicts("modules verdict (identity diagnostics map)", [
        ModVerdictCase(
            files: [
                ModFile(
                    name: "m1.zen",
                    src: "one* = () i32 { 1 }\n",
                ),
                ModFile(
                    name: "m2.zen",
                    src: "{ one } = m1\ntwo* = () i32 {\n    bad()\n}\n",
                ),
                ModFile(
                    name: "p.zen",
                    src: "{ two } = m2\nmain = () i32 { two() }\n",
                ),
            ],
            entry: "p.zen",
            should_pass: false,
            needle: "/m2.zen:3:5: error[undefined-name]",
        ),
        ModVerdictCase(
            files: [
                ModFile(
                    name: "helpers.zen",
                    src: "foo* = (n: i32) i32 { n }\nbar* = (n: i32) i32 { n }\n",
                ),
                ModFile(
                    name: "p.zen",
                    src: "{ foo, bar } = helpers\nmain = () i32 {\n    x := foo(bar(\"s\"))\n    x\n}\n",
                ),
            ],
            entry: "p.zen",
            should_pass: false,
            needle: "/p.zen:3:18: error[arg-type]",
        ),
        ModVerdictCase(
            files: [
                ModFile(
                    name: "app/utils.zen",
                    src: "seven* = () i32 {\n    nope()\n}\n",
                ),
                ModFile(
                    name: "p.zen",
                    src: "{ seven } = app.utils\nmain = () i32 { seven() }\n",
                ),
            ],
            entry: "p.zen",
            should_pass: false,
            needle: "/app/utils.zen:2:5: error[undefined-name]",
        ),
        ModVerdictCase(
            files: [
                ModFile(
                    name: "helper.zen",
                    src: "value* = () i32 { 3 }\n",
                ),
                ModFile(
                    name: "lib.zen",
                    src: "h = helper\ntwo__fer* = () i32 { 2 }\nnine* = () i32 {\n    h.value() + two__fer() + boom()\n}\n",
                ),
                ModFile(
                    name: "p.zen",
                    src: "{ nine } = lib\nmain = () i32 { nine() }\n",
                ),
            ],
            entry: "p.zen",
            should_pass: false,
            needle: "/lib.zen:4:1: error[undefined-name]",
        ),
        ModVerdictCase(
            files: [
                ModFile(
                    name: "a.zen",
                    src: "inc* = (x: i32) i32 {\n    x + 1\n}\n",
                ),
                ModFile(
                    name: "b.zen",
                    src: "flip* = (x: bool) i32 {\n    x + 1\n}\n",
                ),
                ModFile(
                    name: "p.zen",
                    src: "{ inc } = a\n{ flip } = b\nmain = () i32 { inc(1) + flip(true) }\n",
                ),
            ],
            entry: "p.zen",
            should_pass: false,
            needle: "/b.zen:2:7: error[operand-type]",
        ),
    ])
    // (a) the error lives in the SECOND module of a 3-module chain → exact file:line:col there
    // (b) dense line: bare brace-imported calls mid-expression — position recovered exactly
    // (c) the error lives inside a DOTTED (B1) module → dotted file path in the message
    // (d) ns-bound module body: the erroring line mixes an `h.value`→`h__value` alias rewrite
    // with a GENUINE `__` name, so every whole-line textual inverse fails — the region map still
    // pins the module and line (column falls back to 1 rather than losing the location).
    // (e) two modules contain an IDENTICAL source line ("    x + 1"); the error is in b.zen —
    // the map's module IDENTITY must win (text matching used to attribute this to a.zen).
    dd := run_mod_verdicts("modules verdict (dotted user module ids)", [
        ModVerdictCase(
            files: [
                ModFile(
                    name: "app/utils.zen",
                    src: "seven* = () i32 { 7 }\nhidden = () i32 { 9 }\n",
                ),
                ModFile(
                    name: "p.zen",
                    src: "{ hidden } = app.utils\nmain = () i32 { hidden() }\n",
                ),
            ],
            entry: "p.zen",
            should_pass: false,
            needle: "error[private-name]",
        ),
        ModVerdictCase(
            files: [
                ModFile(
                    name: "p.zen",
                    src: "{ x } = app.nothere\nmain = () i32 { x() }\n",
                ),
            ],
            entry: "p.zen",
            should_pass: false,
            needle: "unknown module 'app.nothere' (no app/nothere.zen next to",
        ),
    ])
    v + d + e + dc + sd + dl + dv + im + dd
}
// ── deep-loader driver builders (paths injected at runtime) ──────────────────────────────────────
// Each returns a full `zenc run` driver program with THIS run's mod_dir baked in as the progdir and
// the entry inpath (mod_dir already ends in `/`, so `<dir>subject.zen` is a well-formed sibling path);
// root is "." (the harness's cwd is the repo root). want = 0 via `.to_exit()` on the whole assertion.
deep_src_table = (mp: MutPtr<Malloc>, dir: string_view) string_view {
    z: string_view := ""
    mp.zo_join([z, "{ Malloc } = std.mem.alloc\n{ resolve_program_data } = compiler.resolve\n{ to_exit } = std.core.bool\n{ contains } = std.text.str\nmain = () i32 {\n    a := Malloc(_: 0)\n    subject := \"left = left\\nright = right\\n{ plain } = plain\\nmain = () i32 { left.thing() + right.thing() + plain() }\\n\"\n    resolved := a.addr().resolve_program_data(\".\", \"", dir, "\", \"", dir, "subject.zen\", subject)\n    table := resolved.table\n    left := table.module(\"u/left\")\n    helper := table.module(\"u/helper\")\n    ok := (table.count() == 5)\n        && table.has(\"u/left\") && table.has(\"u/right\") && table.has(\"u/plain\") && table.has(\"u/helper\")\n        && left.graph.has(\"thing\") && helper.graph.has(\"value\")\n        && resolved.flat.contains(\"left__thing\") && resolved.flat.contains(\"plain\")\n        && (!resolved.flat.contains(\"left = left\")) && (resolved.body_start <= resolved.body_end)\n    ok.to_exit()\n}\n"])
}
deep_src_parsed = (mp: MutPtr<Malloc>, dir: string_view) string_view {
    z: string_view := ""
    mp.zo_join([z, "{ Malloc } = std.mem.alloc\n{ resolve_parsed_program } = compiler.resolve\n{ to_exit } = std.core.bool\n{ contains } = std.text.str\nmain = () i32 {\n    a := Malloc(_: 0)\n    subject := \"left = left\\nright = right\\n{ plain } = plain\\nmain = () i32 { left.thing() + right.thing() + plain() }\\n\"\n    program := a.addr().resolve_parsed_program(\".\", \"", dir, "\", \"", dir, "subject.zen\", subject)\n    root := program.module(\"\")\n    left := program.module(\"u/left\")\n    helper := program.module(\"u/helper\")\n    ok := (program.count() == 5)\n        && (program.flat_decls.len == 5)\n        && (root.decls.len == 1) && root.body.contains(\"left__thing\") && (!root.body.contains(\"left = left\"))\n        && (left.decls.len == 1) && left.body.contains(\"helper__value\") && (!left.body.contains(\"helper = helper\"))\n        && (helper.decls.len == 1) && helper.body.contains(\"value\")\n    ok.to_exit()\n}\n"])
}
deep_src_check = (mp: MutPtr<Malloc>, dir: string_view) string_view {
    z: string_view := ""
    mp.zo_join([z, "{ Malloc } = std.mem.alloc\n{ resolve_parsed_program, root_link_decls, check_parsed_program } = compiler.resolve\n{ to_exit } = std.core.bool\nmain = () i32 {\n    a := Malloc(_: 0)\n    good := \"left = left\\n{ plain } = plain\\nmain = () i32 { left.thing(1, 2) + plain(3) }\\n\"\n    bad_ns := \"left = left\\n{ plain } = plain\\nmain = () i32 { left.thing(1) + plain(3) }\\n\"\n    bad_plain := \"left = left\\n{ plain } = plain\\nmain = () i32 { left.thing(1, 2) + plain() }\\n\"\n    gp := a.addr().resolve_parsed_program(\".\", \"", dir, "\", \"", dir, "good.zen\", good)\n    nsp := a.addr().resolve_parsed_program(\".\", \"", dir, "\", \"", dir, "bad_ns.zen\", bad_ns)\n    pp := a.addr().resolve_parsed_program(\".\", \"", dir, "\", \"", dir, "bad_plain.zen\", bad_plain)\n    lib := a.addr().root_link_decls(gp)\n    ok := (lib.len == 2)\n        && (a.addr().check_parsed_program(gp) == 0)\n        && (a.addr().check_parsed_program(nsp) > 0)\n        && (a.addr().check_parsed_program(pp) > 0)\n    ok.to_exit()\n}\n"])
}
deep_src_check_all = (mp: MutPtr<Malloc>, dir: string_view) string_view {
    z: string_view := ""
    mp.zo_join([z, "{ Malloc } = std.mem.alloc\n{ resolve_parsed_program, module_link_decls, check_parsed_program, check_all_parsed_modules } = compiler.resolve\n{ to_exit } = std.core.bool\nmain = () i32 {\n    a := Malloc(_: 0)\n    good := \"left = left\\nmain = () i32 { left.thing() }\\n\"\n    gp := a.addr().resolve_parsed_program(\".\", \"", dir, "\", \"", dir, "good.zen\", good)\n    left := gp.module(\"u/left\")\n    lib := a.addr().module_link_decls(gp, left)\n    ok := (lib.len == 1)\n        && (a.addr().check_parsed_program(gp) == 0)\n        && (a.addr().check_all_parsed_modules(gp) > 0)\n    ok.to_exit()\n}\n"])
}
// escape "\n" (newline) → the literal backslash-n in a generated source so it can be embedded inside a
// Zen string literal in the GENERATED program text. The byte we look for is ASCII 10.
esc_nl = (mp: MutPtr<Malloc>, s: string_view) string_view {
    out := mp.new_in().expect("harness: oom")
    v: [u8] := s.view()
    i: i64 := 0
    n: i64 := len(s)
    @while (i < n) {
        (v[i] == 10).match ({
            true  => {
                out = out.append_in(mp, "\\n").expect("harness: oom")
            },
            false => {
                out = out.push_in(mp, v[i]).expect("harness: oom")
            },
        })
        i = i + 1
    }
    mp.finish_in(out).expect("harness: oom")
}
edges700_esc = (mp: MutPtr<Malloc>, s: string_view) string_view { mp.esc_nl(s) }
// ════════════════════════════════════════════════════════════════════════════════════════════════
// PARITY MAP — what the deleted/kept pytest cross-module suites map to here.
//
// tests/test_resolver_fixes.py  → FULLY PORTED → DELETED. Every test fn is a black-box `zenc
//   check`/`run`/`doc` over a small program, so each became a ModVerdictCase / ModValCase / ModDocCase:
//     generic_decl_co_imports(fmt+rc,vec+rc,fmt+arc,fmt+drop), generic_heavy_module_alone(io.c,cown),
//     ns_bind_qualified_call_runs(c=std.io.c→37), std_runtime/std_ast imports_clean, std_actor standalone
//     + spawn/cell doc, user_shadow_of_imported_std_name(dup), import_vs_import_collision(first-wins),
//     std_ast_builders_usable, std_ast_decl_buffer_uses_explicit_allocator, undefined-type
//     (annotation/return/local-let/nested-let), value-mold must-use (discard reject / rebind / tail),
//     defined+imported types not flagged, lambda (hof-arg / field-lift / capturing-reject / returned-lift).
//
// tests/test_modules_oracle.py  → user-facing PORTED → DELETED. The "net is not hollow" verdicts
//   (wrong-arity/arg-type reject, correct accept, slice.len no-misdispatch) + the 4 import-head spacing
//   variants (now ModEmitCase asserting the resolved sibling C) cover its CLI behavior. The two
//   parametrized invariants — test_module_typechecks_against_its_imports / test_bootstrap_sources_typecheck
//   — drive _oracle.check_linked, a PYTHON harness that layers synthetic module headers; that invariant is
//   not a CLI behavior but is enforced every build (the committed zenc is compiled from the whole stdlib,
//   so any cross-module type error breaks the bootstrap) — dropped as Python-harness impl-detail.
//   test_modules_oracle_has_no_python_frontend_dependency is moot in a zero-Python repo.
//
// tests/test_user_imports.py    → FULLY PORTED → DELETED. Everything is ported here:
//   sibling/two-module/namespace-bind/same-name/same-type/cycle loads; the std-export collision suite
//   (slice.alloc_buf/dup, bytes.at, str.at, alloc.default, num.integer/float+Result, collections.of, vec.Vec<T>,
//   runtime.sync/async, actor.cell, string+actor coexist, slice+str dup coexist, cown.buf/file, ownership
//   ctors); loader-error quality + collision origin/hint; emit resolution-before-cgen + literal/comment
//   preservation; the compiler.resolve PUBLIC API as `zenc run` programs (import_edges,
//   provided_symbols_in, symbol_key_in, module_graph_in, strip_ns_into — all Result-always) INCLUDING the stack-growth
//   stress (240/120/260 decls, 700 edges, 220 symbols, 3500-call rewrite — sources generated in-Zen); and
//   stdin no-program-dir mode. The THREE deep-loader tests — resolve_program_data /
//   resolve_parsed_program / check_parsed_program (module_table, parsed-program AST boundary, graph-linked
//   check) — ARE NOW PORTED as the `dl` batch above (driver programs with this run's mod_dir baked in as
//   progdir and root "." = the harness's repo-root cwd). The heap-layout-sensitive resolve_program_data bug
//   the prior port cited ("unknown module 'left'" with more downstream string constants) no longer
//   reproduces on the committed compiler — all three drivers pass reliably via `zenc run`.
//   (Also covered-by-equivalent, not separately ported: the 81-file edge fan-out ≡ the 700-edge in-string
//   stress; the long-line / many-line / large-literal strip_ns variants ≡ the 3500-call rewrite stress.)
//
// tests/test_resolver_oracle.py → user-facing PORTED → DELETED. Its user-observable cases (name-clash
//   resolves to the imported module + wrong-call rejected, transitive re-export + arity) ARE ported
//   (sm.thing, base→mid→app Pt). The bulk — module_graph / topo_order / reachable / split_decls /
//   bootstrap-manifest-scc / the per-module namespaced-resolver check / the naive-flat-concat
//   false-positive control — asserted on tests/_resolver.py, a PYTHON reimplementation of the resolver's
//   graph/topo/splitter, NOT on the compiler: there is no CLI surface for "the Python harness's internal
//   data structure", so they are not black-box-portable. The one real invariant among them —
//   every std module type-checks through its transitive imports (0 cross-module errors) — is enforced
//   every build: the committed zenc is compiled from the whole stdlib, so any cross-module type error
//   breaks the bootstrap (CI's `make harness` gate). Nothing user-observable is lost by deleting the
//   Python reimplementation and the tests that assert on it.
// ════════════════════════════════════════════════════════════════════════════════════════════════
