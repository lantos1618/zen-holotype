// The public parser API must reject the removed `pattern if condition => body` grammar even though
// the CLI's earlier no-if preflight normally stops this source before parsing.
{ Malloc } = std.mem.alloc
{ parse_module } = compiler.parse
{ check_module_parse_diagnostic_from_source } = compiler.validate.core
main = () i32 {
    a := Malloc(_: 0)
    src := "Box: Val(i32) | Empty\nmain = () i32 { Box.Val(1).match ({ .Val(v) if v > 0 => 1, .Val(v) => 2, .Empty => 0 }) }\n"
    d := a.addr().check_module_parse_diagnostic_from_source(a.addr().parse_module(src), src)
    (d.code != 0 && d.kind == "parse").then({ 0 }, { 1 })
}
