            want: 3,
        ),
        ModValCase(
            files: [
                ModFile(
                    name: "p.zen",
                    src: "rt = std.rt\n{ malloc, free } = std.mem.alloc\ncnt_acq = (s: RawPtr<u8>, n: i64) RawPtr<u8> {\n  s.store_i64(s.load_i64() + 1)\n  malloc(n)\n}\ncnt_rel = (s: RawPtr<u8>, p: RawPtr<u8>) void { free(p) }\ncnt_rsz = (s: RawPtr<u8>, p: RawPtr<u8>, n: i64) RawPtr<u8> { p }\nthree = () i32 {\n  a := rt.alloc(8)\n  b := rt.alloc(8)\n  c := rt.alloc(8)\n  rt.release(a)\n  rt.release(b)\n  rt.release(c)\n  0\n}\nmain = () i32 {\n  counter := malloc(8)\n  counter.store_i64(0)\n  crt := rt.mem_rt(cnt_acq, cnt_rsz, cnt_rel, counter)\n  rt.with(crt, three)\n  v := counter.load_i64()\n  free(counter)\n  to_i32(v)\n}\n",
                ),
            ],
            entry: "p.zen",
            want: 3,
        ),
        ModValCase(
            files: [
                ModFile(
                    name: "p.zen",
                    src: "rt = std.rt\nfail_acq = (s: RawPtr<u8>, n: i64) RawPtr<u8> { null_ptr() }\nfail_rel = (s: RawPtr<u8>, p: RawPtr<u8>) void { }\nfail_rsz = (s: RawPtr<u8>, p: RawPtr<u8>, n: i64) RawPtr<u8> { null_ptr() }\nprobe = () i32 {\n  p := rt.alloc(8)\n  (p == null_ptr()).match ({ true => 1, false => 0 })\n}\nmain = () i32 {\n  frt := rt.mem_rt(fail_acq, fail_rsz, fail_rel, null_ptr())\n  41 + rt.with(frt, probe)\n}\n",
                ),
            ],
            entry: "p.zen",
            want: 42,
        ),
        ModValCase(
            files: [
                ModFile(
                    name: "p.zen",
                    src: "rt = std.rt\nfail_acq = (s: RawPtr<u8>, n: i64) RawPtr<u8> { null_ptr() }\nfail_rel = (s: RawPtr<u8>, p: RawPtr<u8>) void { }\nfail_rsz = (s: RawPtr<u8>, p: RawPtr<u8>, n: i64) RawPtr<u8> { null_ptr() }\nearly = () i32 {\n  x := rt.alloc(8)\n  (x == null_ptr()).match ({ true => return 7, false => { } })\n  999\n}\nmain = () i32 {\n  frt := rt.mem_rt(fail_acq, fail_rsz, fail_rel, null_ptr())\n  r := rt.with(frt, early)\n  p := rt.alloc(8)\n  ok := (p == null_ptr()).match ({ true => 0, false => 1 })\n  rt.release(p)\n  (r == 7).match ({ true => (ok == 1).match ({ true => 5, false => 2 }), false => 3 })\n}\n",
                ),
            ],
            entry: "p.zen",
            want: 5,
        ),
        ModValCase(
            files: [
                ModFile(
                    name: "point.zen",
                    src: "Point*: { x: i32 }\n",
                ),
                ModFile(
                    name: "wide.zen",
                    src: "{ Point } = point\nshift* = (p: Point, dx: i64) i32 { p.x + dx.to_i32() }\n",
                ),
                ModFile(
                    name: "narrow.zen",
                    src: "{ Point } = point\nshift* = (p: Point, dx: i32, dy: i32) i32 { p.x + dx + dy }\n",
                ),
                ModFile(
                    name: "p.zen",
                    src: "{ Point } = point\nw = wide\nn = narrow\nmain = () i32 {\n  p := Point(x: 40)\n  d: i64 := 2\n  p.shift(d)\n}\n",
                ),
            ],
            entry: "p.zen",
            want: 42,
        ),
        ModValCase(
            files: [
                ModFile(
                    name: "point.zen",
                    src: "Point*: { x: i32 }\n",
                ),
                ModFile(
                    name: "wide.zen",
                    src: "{ Point } = point\nshift* = (p: Point, dx: i64) i32 { p.x + dx.to_i32() }\n",
                ),
                ModFile(
                    name: "narrow.zen",
                    src: "{ Point } = point\nshift* = (p: Point, dx: i32, dy: i32) i32 { p.x + dx + dy }\n",
                ),
                ModFile(
                    name: "p.zen",
                    src: "{ Point } = point\nw = wide\nn = narrow\nmain = () i32 {\n  p := Point(x: 40)\n  a: i32 := 1\n  b: i32 := 1\n  p.shift(a, b)\n}\n",
                ),
            ],
            entry: "p.zen",
            want: 42,
        ),
        ModValCase(
            files: [
                ModFile(
                    name: "p.zen",
                    src: "{ at } = std.text.str\nmain = () i32 {\n  s := \"ABCDE\"\n  i: i64 := 2\n  s.at(i).to_i32()\n}\n",
