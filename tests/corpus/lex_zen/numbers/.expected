-- rejected
[010 007 00]
  an integer literal [010]
  an integer literal [007]
  an integer literal [00]
  end of file []
  ! 1:1 a decimal literal has no leading zero, and Zen has no octal
  ! 1:5 a decimal literal has no leading zero, and Zen has no octal
  ! 1:9 a decimal literal has no leading zero, and Zen has no octal
[12.]
  an integer literal [12.]
  end of file []
  ! 1:3 a float literal needs a digit after the `.`
[1abc]
  an integer literal [1abc]
  end of file []
  ! 1:2 an identifier may not start with a digit, and a number carries no suffix
[0xFF]
  an integer literal [0xFF]
  end of file []
[18446744073709551616]
  end of file []
  ! 1:1 integer literal out of range: the widest integer type is u64
[99999999999999999999999999999999]
  end of file []
  ! 1:1 integer literal out of range: the widest integer type is u64
-- the accumulator std.text shares with the lexer
  0 -> 0
  2147483648 -> 2147483648
  18446744073709551615 -> 18446744073709551615
  one past u64 overflows -> true
