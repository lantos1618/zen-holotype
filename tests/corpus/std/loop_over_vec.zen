// tests/corpus/std/loop_over_vec.zen
// a Vec is iterated by the same word - this is the form Map.get
// itself is written in. elements come out in insertion order

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    names ::= alloc.Vec<str>();
    names.add("ada").try();
    names.add("grace").try();
    names.add("alan").try();

    names.loop((h, name) {
        println("{}", name);
    })
    names.loop((h, index, name) {
        println("{} {}", index, name);
    })
    Ok(0);
}
