// AN ALIAS RESOLVING TO THE WRONG TARGET IS INVISIBLE unless two targets
// answer differently, and that is what this program arranges.
//
// "An alias is the type, not a name that forwards to it" — so `Marked`
// IS alpha's `Ring` — and a written type is a name, which means what it
// means WHERE IT WAS WRITTEN. Both modules declare `Ring` and both
// declare `label`, and a free function travels with its first parameter's
// type: read alpha's alias in any other module and `m.label()` finds
// beta's `label` instead, prints "beta small", and reports nothing. This
// program is the only thing in the corpus that tells those two apart —
// mutating the alias's module to 0 left all 296 other tests byte-identical.
//
// BOTH VARIANTS GO THROUGH BOTH SPELLINGS. One variant of one of them
// left the other half of each type unobserved, and the wrong answers
// that arrive as a tag — every variant collapsing to the first, a payload-
// free enum never carrying its tag across the alias — print the one line
// the test already expected. Four lines, four distinct answers, and no
// two of them are the same bytes.
Marked, label = alpha.alpha
Ring, tag = beta.beta

main = (env: Env) Res<i32, IoError> {
    m: Marked = Marked.Small;
    n: Marked = Marked.Large;
    println(m.label());
    println(n.label());
    println(Ring.Small.tag());
    println(Ring.Large.tag());
    Ok(0);
}
