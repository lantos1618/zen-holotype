// DESIGN.md, Overloading: "Function types must name their parameters."
// the offending type is the one on `f`, and the diagnostic points at
// the first unnamed parameter, not at the whole type.
apply = (f: (i32, i32) i32, a: i32, b: i32) i32 { f(a, b) }

main = (env: Env) Res<i32, ArgError> {
    add = (a: i32, b: i32) i32 { a + b }
    println("{}", apply(add, 4, 5));
    Ok(0);
}
