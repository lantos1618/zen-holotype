// http_actor_demo.zen — fetching over HTTP with the stdlib's ready-made client actor.
//
// std.net.http_actor ships the fetcher (message, reply, receiver, trampoline); the app brings
// only its OWN receiver for the reply. Here `main` also plays a one-shot HTTP server on the
// loopback listener while the fetch blocks on a pool worker, then quiesces and reads the result.
//
//   $ zen run examples/http_actor_demo.zen
//   status=200 body=hello zen actors
//   ok
{ println, formatln, arg_int, arg_str } = std.text.fmt
{ expect } = std.core.result
{ view } = std.text.str
{ String, init, push_in, finish_in } = std.text.string
{ gpa } = std.mem.heap
{ serve, recv } = std.net.socket
{ url_of } = std.net.http
{ spawn_http_fetcher, http_fetch, HttpReplyMsg } = std.net.http_actor
{ pool_open } = std.concurrent.pool
{ Context, Receiver, dispatch } = std.concurrent.pool_actor
pa = std.concurrent.pool_actor
BODY := "hello zen actors"    // 16 bytes
// the app's receiver: whatever actor asked for the fetch — it just folds the reply into state.
App*: {
    status: i64,
    body: string_view,
}
App.impl(Receiver, {
    receive = (s: MutPtr<App>, ctx: Context<HttpReplyMsg>) void {
        ctx.msg.match ({
            .Done(r) => {
                s.status = r.status
                s.body = r.body
            },
        })
    }
})
app_tramp = (user: RawPtr<u8>, msg: i64) void { dispatch<App, HttpReplyMsg>(user, msg) }
// the canned server response, CRLF'd at runtime ('\r' never appears in a source string literal).
response<A> = (a: MutPtr<A>) string_view {
    sb := a.init(16).expect("demo: oom")
    "HTTP/1.1 200 OK\nContent-Length: 16\n\n".view().loop((h, i, b) {
        (b == '\n').match ({
            true  => {
                sb = a.push_in(sb, '\r').expect("demo: oom")
                sb = a.push_in(sb, '\n').expect("demo: oom")
            },
            false => {
                sb = a.push_in(sb, b).expect("demo: oom")
            },
        })
    })
    BODY.view().loop((h, i, b) {
        sb = a.push_in(sb, b).expect("demo: oom")
    })
    a.finish_in(sb).expect("demo: oom")
}
main = () i32 {
    h := gpa()
    a := h.addr()
    l := serve("127.0.0.1", 0).expect("demo: listen failed")
    fetcher := spawn_http_fetcher(8)
    app := pa.spawn_actor_heap(8, App(
        status: 0,
        body: "",
    ), app_tramp)
    p := pool_open(2, 8)
    p.send(fetcher, http_fetch(a.url_of("127.0.0.1", l.local_port(), "/"), app.ref_of(p)))
    // main is the server while the fetcher blocks on its worker: accept the one connection,
    // read the request, send the canned response, close (EOF ends the client's read).
    conn := l.accept_conn().expect("demo: accept failed")
    a.recv(conn, 512).expect("demo: recv failed")
    conn.send_str(a.response()).expect("demo: send failed")
    conn.close_conn()
    l.close_listener()
    p.pool_quiesce_stop()
    st := pa.actor_state(app)
    formatln("status={} body={}", [arg_int(st.status), arg_str(st.body)])
    ok := st.status == 200 && st.body == "hello zen actors"
    pa.close(fetcher)
    pa.close(app)
    p.pool_close()
    ok.then({ println("ok") }, { println("MISMATCH") })
    ok.then({ 0 }, { 1 })
}
