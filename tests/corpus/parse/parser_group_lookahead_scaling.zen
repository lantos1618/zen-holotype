// Repeated balanced-group lookahead returns the same boundary and remains
// side-effect-free. The parser cache makes these repeated suffix scans cheap.

scan, Source = std.lex.lex
Parser = std.parse.parser

SOURCE: str = "value = (one + (two * three));\n"

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    lexed = scan(alloc, Source(file: "t.zen", text: SOURCE)).try();
    p ::= alloc.Parser(lexed);
    first  = p.group_end_at(2);
    second = p.group_end_at(2);
    third  = p.group_end_at(2);
    println("{} {} {} {}", first, second, third, p.at);
    p.group_ends.clear();
    println("uncached {}", p.group_end_at(2));
    Ok(0);
}
