Input, view = helpers.helpers
Box = { text :: str }
put = (box :: Box, input: Input) () { box.text = view(input); }
bad = (env: Env, box :: Box) Res<(), AllocError> {
    a    = env.mem.alloc();
    text = a.String("temporary").try();
    put(box, Input(text: text.view(), scratch: "static"));
    Ok(())
}
main = (env: Env) Res<(), AllocError> {
    box ::= Box(text: "");
    bad(env, box).try();
    println(box.text);
    Ok(())
}
