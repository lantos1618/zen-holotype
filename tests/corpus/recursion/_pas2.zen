// probeAS2: does the create-through-Alloc-param failure depend on the
// generic argument being written? try a.create() with inference from context
mk = (a: Alloc) Res<Ptr<i64>, AllocError> {
    p: Ptr<i64> = a.create().try();
    Ok(p)
}

main = (env: Env) Res<i32, AllocError> {
    a ::= env.mem.alloc();
    p = mk(a).try();
    p.write(0, 42);
    println("v {}", p.read(0));
    Ok(0);
}
