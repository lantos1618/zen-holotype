// A TRAP INSIDE A CALLED FUNCTION NAMES THE CALLEE'S OPERATOR, NOT THE
// CALL SITE. The trap line must carry the file and position of the `/`
// inside `div_twice` -- a lowering that stamps the caller's position on
// every checked helper (or that inlines before recording spans) points
// at `main` instead, and the message still looks right until someone
// debugs the wrong function.
//
// The call sits mid-expression (`div_twice(..) + 7`) so the value also
// has to travel back out of the frame: a helper wired to return 0 on
// overflow keeps running, prints a plausible sum, and exits 0 -- which
// is exactly the silent failure this file makes impossible.
//
// nothing after `println("start")` runs: the trap is an abort, not a
// value any caller can match.

Error = Overflow | DivideByZero | OutOfBounds

div_twice = (a: i32, b: i32) i32 {
    (a / b) / b
}

main = (env: Env) Res<i32, Error> {
    println("start");
    v = div_twice(100, 0) + 7;
    println("v {}", v);
    Ok(0);
}
