// AN ARGUMENT WITH NO HOLE LEFT — REFUSED, at the argument.
//
// The surplus direction of the same arity law. Every argument past the
// last positional hole used to be appended to the output with no
// separator — `println("surplus {}", 1, 2)` printed `surplus 12`, which
// reads as the single number twelve. The walk counts what the holes took;
// an argument still queued when the format is spent is refused AT THAT
// ARGUMENT, the same place print_fault reports a value with no writer:
// the call is fine and one of its arguments is not.
//
// position: the `1` of `1, 2`, the first argument no hole asked for.

main = (env: Env) Res<i32> {
    println("surplus {}", 1, 2);
    Ok(0);
}
