// A REJECT fixture: `slice(p, n)` states BOTH a length and an element WIDTH, and only the length was
// ever guarded (`zen__idx` bounds-checks the index). The width came from the annotation at the point of
// use with nothing to compare it against, so `ys: [i64] = slice(xs.ptr, 4)` over an `[i32]` read 32
// bytes out of a 16-byte allocation — an ASan heap-buffer-overflow that `zen check` called ok.
// The rule keys on the PROVENANCE of the pointer: the element width of the storage it came from. `u8` is
// the byte floor and is not an element claim in either direction, which is what keeps raw allocator
// memory (`slice(a.acquire(n * sizeof(T)), n)`) legal without naming a single privileged file.
// Gated by the `slice_elem_width_matches_storage` shell case in tests/harness_build.zen, which pins the
// exact diagnostics and the accepted counterparts. This file NEVER compiles.
// the shape that overflowed: an i32 window re-widened to i64 elements
widen_i32_to_i64 = (xs: [i32]) i64 {
    ys :: [i64] = slice(xs.ptr, 4)
    ys[0]
}
// the same claim made in RETURN position rather than at an annotation
widen_in_return = (xs: [i32]) [f64] { slice(xs.ptr, 2) }
// a struct window re-typed as a different struct
Small: {
    a: i32,
}
Big: {
    a: i64,
    b: i64,
}
retype_struct = (xs: [Small]) i64 {
    ys :: [Big] = slice(xs.ptr, 2)
    ys[0].a
}
// the address of a single local widened into a slice of a different element type
widen_local_addr = () i64 {
    x ::= 7
    ys :: [i64] = slice(x.addr(), 1)
    ys[0]
}
main = () i32 { to_i32(widen_local_addr()) }
