// std.core.path
// a filesystem path. bytes, like str — the shell handed them to
// us as bytes and the kernel wants them back as bytes, so
// validating in between would only be able to lose information

Path* = {
    text*: str,
}

// build a path, optionally formatted:
//     Path("src/main.zen")
//     Path("build/{}-{}/{}", os, arch, name)
Path* = (text: str) Path
Path* = (a: Alloc, fmt: str, args: ...) Res<Path, AllocError>

join* = (a: Alloc, base: Path, rest: str) Res<Path, AllocError>
parent* = (self: Path) Res<Path>
name* = (self: Path) str
ext* = (self: Path) Res<str>
