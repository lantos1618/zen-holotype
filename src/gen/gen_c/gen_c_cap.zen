// src/gen/gen_c/gen_c_cap.zen
// The members whose BODY IS THE BACKEND.
//
// `Mem.alloc`, `Mem.page`, `Mem.release` and the four `Fs` declares are
// written in std with a signature and no body — env.zen says why: they
// are the authority itself. "A capability's floor is the target
// language's", and for C that floor is `malloc`, `free`, `stat`,
// `fopen`. `gen_c_print.zen` says the same about `Console.println`;
// this file writes the memory three, `gen_c_fs.zen` the other four.
//
// NOT A SPECIAL CASE BOLTED ONTO MEMBER DISPATCH — the SAME rule
// `println` obeys, one level lower: a bodiless member is either a
// capability whose floor this file writes, or a refusal
// `gen_c_member.zen` reports by name. Nothing else can be true of it —
// a symbol for a bodiless declaration is a symbol nothing defines.
//
// WHY THE BACKEND MAY WRITE AN ArenaState'S FIELDS. `mem_arena.zen`
// keeps `ArenaState` unexported ("what an arena is made of is not part
// of what an arena is"), yet this file writes three of its fields
// anyway — licensed by one thing: the memory ENTERS THE PROGRAM here.
// `Mem.alloc` is the only door; the alternative is a second, hidden,
// hand-written C arena std would have to agree with.

ExprId, Decl, Struct, Member = std.ast
Function, Access, Call = std.ast
AllocError = std.mem
Vec = std.collections
str, String = std.text
TyId, TyNamed = sema.sema_ty
decl_at = sema.sema_def
Ctx = sema.sema_check
Inst = sema.sema_inst
member_named = sema.sema_member
sym_member, sym_variant, sym_gen, RES_PATH = gen.gen_name
CBackend = gen.gen_c.gen_c_state
unsupported = gen.gen_c.gen_c_report
sub = gen.gen_c.gen_c_mono
enter_struct_tparams, leave_tparams = gen.gen_c.gen_c_mono
ctype, field_type, request_type, declared_ret = gen.gen_c.gen_c_type
decl_ctx, decl_inst = gen.gen_c.gen_c_type
expr = gen.gen_c.gen_c_expr
declare_temp, enum_path, payload_type, is_variant = gen.gen_c.gen_c_flow
lower_probe, lower_write, lower_read = gen.gen_c.gen_c_fs
close_else, close_brace, open_null_test = gen.gen_c.gen_c_fs
lower_stdin_read = gen.gen_c.gen_c_stdin
lower_console_print = gen.gen_c.gen_c_print
is_defer, lower_defer = gen.gen_c.gen_c_scope

// -----------------------------------------------------------------
// which members these are
// -----------------------------------------------------------------

// A capability is recognised by the RECEIVER'S TYPE and the member's
// name together, not by "has no body" alone — that's `gen_c_member.zen`'s
// question, and answering it again here would make any bodiless member
// anywhere silently become one of these.
is_capability* = (be :: CBackend, rty: TyId, name: str) bool {
    owner_of(be, rty).eq("Mem").match({
        true  => mem_verb(name),
        false => is_fs_capability(be, rty, name),
    })
}

is_fs_capability = (be :: CBackend, rty: TyId, name: str) bool {
    owner_of(be, rty).eq("Fs").match({
        true  => fs_verb(name),
        false => is_console_capability(be, rty, name),
    })
}

// `Console.println` IS ONE OF THESE: floor is `fwrite`, bodiless for
// the same reason `Fs.read` is, and `gen_c_print.zen` writes it. Reaches
// this file only when the receiver was WRITTEN (`env.out.println(..)`)
// — the sugar names no function and is recognised one level up.
// Without this it fell through to `lower_fat_call`: `args: ...` has no
// C spelling, so the slot's parameter came out as `ctype`'s `int`
// fallback and `cc` rejected every argument handed to it.
//
// `Scope.defer` IS THE LAST LINK, NOT A PEER of the ones above — a
// capability by the same test, but its receiver is a value the program
// made rather than one `Env` handed it, so owner alone can't recognise
// it and `is_defer` asks its own question.
is_console_capability = (be :: CBackend, rty: TyId, name: str) bool {
    (owner_of(be, rty).eq("Console") && name.eq("println"))
        || is_stdin_read(be, rty, name)
        || is_defer(be, rty, name)
}

// `Stdin.read`, and the owner is the whole of the test: `Fs` declares a
// `read` too, and the two are different lowerings over different floors.
// Asking the name alone would send `env.in.read(..)` into the one that
// wants a path.
is_stdin_read = (be :: CBackend, rty: TyId, name: str) bool {
    owner_of(be, rty).eq("Stdin") && name.eq("read")
}

owner_of = (be :: CBackend, rty: TyId) str {
    be.check.types.at(rty).match({
        Named(n) => n.name,
        _        => "",
    })
}

mem_verb = (name: str) bool {
    name.is_in(["alloc", "page", "release"])
}

// `read` is in the set so that it reaches `gen_c_fs.lower_read`, which
// allocates its buffer through the `Alloc` it was handed, rather than
// `gen_c_member.zen`'s refusal for a member with no body.
fs_verb = (name: str) bool {
    name.is_in(["exists", "is_dir", "write", "read"])
}

// -----------------------------------------------------------------
// the entry point
// -----------------------------------------------------------------

// `Scope.defer` takes the short path because its whole lowering is
// about the CLOSURE it was handed — the declared types the four below
// need say nothing about that. `scope.zen` declares it `= sig` with no
// body: "the compiler supplies the block".
lower_capability* = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    mi  : usize,
    f   : Function,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    is_defer(be, rty, a.name.text).match({
        true  => lower_defer(be, id, c, a, ctx, out),
        false => lower_env_capability(be, id, c, a, rty, mi, f, ctx, out),
    })
}

lower_env_capability = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    mi  : usize,
    f   : Function,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    ret = cap_ret(be, rty, mi, f).try();
    request_type(be, ret).try();
    // `Fs.read`'s FIRST written parameter is an `Alloc` per its
    // DECLARED type — the argument arrives as an Arena, and lowering it
    // at its own type would hand the buffer's owner an arena where the
    // two-word handle belongs. Law 7: the declaration decides.
    aty = cap_param(be, rty, mi, f).try();
    verb(be, id, c, a, rty, ret, aty, ctx, out)
}

cap_param = (be :: CBackend, rty: TyId, mi: usize, f: Function)
            Res<TyId, AllocError> {
    sctx = be.check.self_ctx(mi, rty).try();
    f.params.get(1).match({
        None  => be.check.types.unknown(),
        Ok(p) => be.check.param_type(p, sctx),
    })
}

// `Stdin.read` IS TESTED BEFORE THE NAME CHAIN and not inside it: the
// chain below asks names only, and `read` is a name two capabilities
// answer to.
verb = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    ret : TyId,
    aty : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    is_stdin_read(be, rty, a.name.text).match({
        true  => lower_stdin_read(be, id, c, ret, aty, ctx, out),
        false => console_verb(be, id, c, a, rty, ret, aty, ctx, out),
    })
}

console_verb = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    ret : TyId,
    aty : TyId,
    ctx : Ctx,
    out :: String
)
               Res<(), AllocError> {
    a.name.text.eq("println").match({
        true  => lower_console_print(be, c, a.name.text, ret, ctx, out),
        false => verb_1(be, id, c, a, rty, ret, aty, ctx, out),
    })
}

verb_1 = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    ret : TyId,
    aty : TyId,
    ctx : Ctx,
    out :: String
)
         Res<(), AllocError> {
    a.name.text.eq("alloc").match({
        true  => lower_alloc(be, id, a, rty, ret, ctx, out),
        false => verb_2(be, id, c, a, rty, ret, aty, ctx, out),
    })
}

verb_2 = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    ret : TyId,
    aty : TyId,
    ctx : Ctx,
    out :: String
)
         Res<(), AllocError> {
    a.name.text.eq("page").match({
        true  => lower_page(be, id, c, ret, ctx, out),
        false => verb_3(be, id, c, a, rty, ret, aty, ctx, out),
    })
}

verb_3 = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    ret : TyId,
    aty : TyId,
    ctx : Ctx,
    out :: String
)
         Res<(), AllocError> {
    a.name.text.eq("release").match({
        true  => lower_release(be, c, ctx, out),
        false => verb_4(be, id, c, a, rty, ret, aty, ctx, out),
    })
}

verb_4 = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    ret : TyId,
    aty : TyId,
    ctx : Ctx,
    out :: String
)
         Res<(), AllocError> {
    a.name.text.eq("write").match({
        true  => lower_write(be, id, c, ret, ctx, out),
        false => verb_5(be, id, c, a, ret, aty, ctx, out),
    })
}

verb_5 = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    ret : TyId,
    aty : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    a.name.text.eq("read").match({
        true  => lower_read(be, id, c, ret, aty, ctx, out),
        false => lower_probe(be, c, a.name.text, ctx, out),
    })
}

// The declared return type, read in the module that declares the
// member with `@Self` bound to the receiver — the same two steps
// `gen_c_member.method_sig` takes for a parameter, and for the same
// reason: `@Self` is a written type only that query answers.
cap_ret = (be :: CBackend, rty: TyId, mi: usize, f: Function)
          Res<TyId, AllocError> {
    sctx     = be.check.self_ctx(mi, rty).try();
    declared = declared_ret(be, f, sctx).try();
    sub(be, declared)
}

// -----------------------------------------------------------------
// `env.mem.alloc()` — where an arena comes from
//
// An `ArenaState` on the C heap, an `Arena` holding its address. State
// is one `malloc`, never freed: `Arena.drop` releases the PAGES, and
// the state is the handle every copy of the arena shares — freeing it
// would invalidate a value that copies freely by design.
// -----------------------------------------------------------------

lower_alloc = (
    be  :: CBackend,
    id  : ExprId,
    a   : Access,
    rty : TyId,
    ret : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    field_of(be, ret, "state").try().match({
        None    => unsupported(be, id, "an Arena with no state field", out),
        Ok(pty) => with_state(be, id, a, rty, ret, pty, ctx, out),
    })
}

with_state = (
    be  :: CBackend,
    id  : ExprId,
    a   : Access,
    rty : TyId,
    ret : TyId,
    pty : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    pointee(be, pty).match({
        None     => unsupported(
            be,
            id,
            "an Arena whose state is not a pointer",
            out
        ),
        Ok(cell) => write_arena(be, a, rty, ret, pty, cell, ctx, out),
    })
}

write_arena = (
    be   :: CBackend,
    a    : Access,
    rty  : TyId,
    ret  : TyId,
    pty  : TyId,
    cell : TyId,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    recv ::= be.alloc.String().try();
    expr(be, a.base, ctx, rty, recv).try();
    tmp ::= be.alloc.String().try();
    sym_gen(tmp, "t", be.next_tmp()).try();
    declare_temp(be, pty, tmp.view()).try();
    write_malloc(be, tmp.view(), cell, "").try();
    set_field(be, tmp.view(), cell, "mem", recv.view()).try();
    set_field(be, tmp.view(), cell, "head", "NULL").try();
    set_field(be, tmp.view(), cell, "next", "0").try();
    cty ::= be.alloc.String().try();
    ctype(be, ret, cty).try();
    state ::= be.alloc.String().try();
    state.sym_member("state").try();
    out.fmt("(({}){ .{} = {} })", cty.view(), state.view(), tmp.view())
}

write_malloc = (be :: CBackend, tmp: str, cell: TyId, extra: str)
               Res<(), AllocError> {
    cty ::= be.alloc.String().try();
    ctype(be, cell, cty).try();
    be.fmt("{tmp} = ({} *)malloc(sizeof({}){extra});\n", cty.view(), cty.view())
}

// One field of the freshly-made state, and nothing at all when the
// declaration has no such field: std owns the shape, so a field it
// drops is a line this file stops writing rather than a diagnostic.
set_field = (be :: CBackend, tmp: str, cell: TyId, name: str, value: str)
            Res<(), AllocError> {
    field_of(be, cell, name).try().match({
        None  => Ok(()),
        Ok(_) => write_arrow_set(be, tmp, name, value),
    })
}

write_arrow_set = (be :: CBackend, tmp: str, name: str, value: str)
                  Res<(), AllocError> {
    sym ::= be.alloc.String().try();
    sym_member(sym, name).try();
    be.fmt("{tmp}->{} = {value};\n", sym.view())
}

// -----------------------------------------------------------------
// `mem.page(size, prev)` — where a page comes from
//
// One run of `sizeof(Page) + size` bytes, with the `Page` header
// written into its own first bytes. The header costs no second
// allocation, which is what lets an arena describe a page without
// owning memory it has not been given yet.
// -----------------------------------------------------------------

lower_page = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    ret : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    payload_type(be, ret, "Ok").match({
        None    => unsupported(
            be,
            id,
            "Mem.page must return a Res<Ptr<Page>, E>",
            out
        ),
        Ok(pty) => page_cell(be, id, c, ret, pty, ctx, out),
    })
}

page_cell = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    ret : TyId,
    pty : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    pointee(be, pty).match({
        None     => unsupported(
            be,
            id,
            "Mem.page must return a Res<Ptr<Page>, E>",
            out
        ),
        Ok(cell) => write_page(be, c, ret, cell, ctx, out),
    })
}

write_page = (
    be   :: CBackend,
    c    : Call,
    ret  : TyId,
    cell : TyId,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    usize_ty = be.check.types.prim("usize").try();
    size ::= be.alloc.String().try();
    arg_text(be, c, 0, usize_ty, ctx, size).try();
    prev ::= be.alloc.String().try();
    prev_text(be, c, ctx, prev).try();
    szt ::= be.alloc.String().try();
    sym_gen(szt, "t", be.next_tmp()).try();
    raw ::= be.alloc.String().try();
    sym_gen(raw, "t", be.next_tmp()).try();
    dst ::= be.alloc.String().try();
    sym_gen(dst, "t", be.next_tmp()).try();
    declare_temp(be, usize_ty, szt.view()).try();
    be.fmt("unsigned char *{};\n", raw.view()).try();
    declare_temp(be, ret, dst.view()).try();
    be.set_line(szt.view(), size.view()).try();
    write_page_malloc(be, raw.view(), cell, szt.view()).try();
    open_null_test(be, raw.view()).try();
    write_assign_err(be, ret, "OutOfMemory", dst.view()).try();
    close_else(be).try();
    write_page_header(be, raw.view(), cell, szt.view(), prev.view()).try();
    write_page_ok(be, ret, cell, raw.view(), dst.view()).try();
    close_brace(be).try();
    out.add_bytes(dst.view())
}

write_page_malloc = (be :: CBackend, raw: str, cell: TyId, szt: str)
                    Res<(), AllocError> {
    cty ::= be.alloc.String().try();
    ctype(be, cell, cty).try();
    be.fmt("{raw} = (unsigned char *)malloc(sizeof({}) + {szt});\n", cty.view())
}

// The three fields of the header, written THROUGH the raw pointer:
// `base` is the first byte past the header, which is what makes the
// page describe itself.
write_page_header = (
    be   :: CBackend,
    raw  : str,
    cell : TyId,
    szt  : str,
    prev : str
) Res<(), AllocError> {
    cty ::= be.alloc.String().try();
    ctype(be, cell, cty).try();
    cast ::= be.alloc.String().try();
    cast.fmt("(({} *){raw})", cty.view()).try();
    base ::= be.alloc.String().try();
    base.fmt("({raw} + sizeof({}))", cty.view()).try();
    set_field(be, cast.view(), cell, "prev", prev).try();
    set_field(be, cast.view(), cell, "base", base.view()).try();
    set_field(be, cast.view(), cell, "size", szt).try();
    Ok(());
}

write_page_ok = (be :: CBackend, ret: TyId, cell: TyId, raw: str, dst: str)
                Res<(), AllocError> {
    value ::= be.alloc.String().try();
    value.add_bytes("(").try();
    ctype(be, cell, value).try();
    value.fmt(" *){raw}").try();
    write_assign_ok(be, ret, value.view(), dst).try();
    Ok(());
}

// `mem.release(page)` — one `free`, and the unit value every other
// void-returning lowering writes.
lower_release = (be :: CBackend, c: Call, ctx: Ctx, out :: String)
                Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    page ::= be.alloc.String().try();
    arg_text(be, c, 0, unknown, ctx, page).try();
    be.fmt("free((void *)({}));\n", page.view()).try();
    out.add_bytes("0")
}

// The `prev` argument, or a null pointer when the call left it out.
prev_text = (be :: CBackend, c: Call, ctx: Ctx, out :: String)
            Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    c.args.get(1).match({
        None  => out.add_bytes("NULL"),
        Ok(a) => expr(be, a.value, ctx, unknown, out),
    })
}

// -----------------------------------------------------------------
// the values these lowerings assign
// -----------------------------------------------------------------

write_assign_ok_unit* = (be :: CBackend, ret: TyId, dst: str)
                       Res<(), AllocError> {
    value ::= be.alloc.String().try();
    write_res_head(be, ret, "Ok", value).try();
    value.add_bytes(" })").try();
    be.set_line(dst, value.view())
}

write_assign_ok* = (be :: CBackend, ret: TyId, payload: str, dst: str)
                  Res<(), AllocError> {
    value ::= be.alloc.String().try();
    write_res_head(be, ret, "Ok", value).try();
    value.add_bytes(", .zg_data.").try();
    sym_member(value, "Ok").try();
    value.fmt(" = {payload} })").try();
    be.set_line(dst, value.view())
}

// `Err(<the variant this ordinal names>)`, read out of the RETURN
// type's own error enum. A set with no such variant gets a bare `Err`,
// which is wrong only for a std that has already changed underneath
// this file.
write_assign_err* = (be :: CBackend, ret: TyId, name: str, dst: str)
                   Res<(), AllocError> {
    value ::= be.alloc.String().try();
    write_res_head(be, ret, "Err", value).try();
    payload_type(be, ret, "Err").match({
        None    => Ok(()),
        Ok(ety) => write_err_payload(be, ety, name, value),
    }).try();
    value.add_bytes(" })").try();
    be.set_line(dst, value.view())
}

write_err_payload = (be :: CBackend, ety: TyId, name: str, out :: String)
                    Res<(), AllocError> {
    is_variant(be, ety, name).match({
        false => Ok(()),
        true  => write_err_variant(be, ety, name, out),
    })
}

write_err_variant = (be :: CBackend, ety: TyId, name: str, out :: String)
                    Res<(), AllocError> {
    path ::= be.alloc.String().try();
    enum_path(be, ety, path).try();
    out.add_bytes(", .zg_data.").try();
    out.sym_member("Err").try();
    out.add_bytes(" = ((").try();
    ctype(be, ety, out).try();
    out.add_bytes("){ .zg_tag = ").try();
    out.sym_variant(path.view(), name).try();
    out.add_bytes(" })").try();
    Ok(());
}

write_res_head = (be :: CBackend, ret: TyId, variant: str, out :: String)
                 Res<(), AllocError> {
    cty ::= be.alloc.String().try();
    ctype(be, ret, cty).try();
    out.fmt("(({}){ .zg_tag = ", cty.view()).try();
    out.sym_variant(RES_PATH, variant)
}

// -----------------------------------------------------------------
// reading the shapes these lowerings write
// -----------------------------------------------------------------

// The declared type of a STORAGE field, read at the type's own
// arguments — `Vec<u8>`'s `data` is a `Ptr<u8>` and not a `Ptr<T>` —
// and nothing when the type declares no such field.
field_of* = (be :: CBackend, ty: TyId, name: str)
            Res<Res<TyId>, AllocError> {
    be.check.types.at(ty).match({
        Named(n) => named_field_of(be, n, name),
        _        => Ok(None),
    })
}

named_field_of = (be :: CBackend, n: TyNamed, name: str)
                 Res<Res<TyId>, AllocError> {
    inst = decl_inst(be, n).try();
    ctx  = decl_ctx(be, n);
    mark = enter_struct_tparams(be, n.decl).try();
    found ::= be.alloc.Vec<TyId>();
    decl_at(be.tree, n.decl).match({
        None  => Ok(()),
        Ok(d) => collect_field(be, d, name, ctx, inst, found),
    }).try();
    leave_tparams(be, mark).try();
    Ok(found.get(0));
}

collect_field = (
    be   :: CBackend,
    d    : Decl,
    name : str,
    ctx  : Ctx,
    inst : Inst,
    out  :: Vec<TyId>
) Res<(), AllocError> {
    d.kind.match({
        Struct(s) => keep_fields(be, s, name, ctx, inst, out),
        _         => Ok(()),
    })
}

keep_fields = (
    be   :: CBackend,
    s    : Struct,
    name : str,
    ctx  : Ctx,
    inst : Inst,
    out  :: Vec<TyId>
) Res<(), AllocError> {
    s.members.loop((h, m) {
        keep_named_field(be, m, name, ctx, inst, out).try();
    });
    Ok(());
}

keep_named_field = (
    be   :: CBackend,
    m    : Member,
    name : str,
    ctx  : Ctx,
    inst : Inst,
    out  :: Vec<TyId>
) Res<(), AllocError> {
    member_named(m, name).match({
        false => Ok(()),
        true  => add_field_type(be, m, ctx, inst, out),
    })
}

add_field_type = (
    be   :: CBackend,
    m    : Member,
    ctx  : Ctx,
    inst : Inst,
    out  :: Vec<TyId>
) Res<(), AllocError> {
    field_type(be, m, ctx, inst).match({
        None  => Ok(()),
        Ok(t) => out.add(t),
    })
}

// What a `Ptr<T>` points AT. Sema has no pointer kind — a `Ptr<T>`
// arrives as an ordinary `Named` — so this is its first type argument
// and nothing more.
pointee = (be :: CBackend, ty: TyId) Res<TyId> {
    be.check.types.at(ty).match({
        Named(n) => n.args.get(0),
        _        => None,
    })
}

// One written argument, at the type the signature declares for it.
arg_text* = (
    be   :: CBackend,
    c    : Call,
    i    : usize,
    want : TyId,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    c.args.get(i).match({
        None  => out.add_bytes("0"),
        Ok(a) => expr(be, a.value, ctx, want, out),
    })
}
