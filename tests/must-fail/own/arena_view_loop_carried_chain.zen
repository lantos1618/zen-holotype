word = (env: Env, letters: str) Res<str, AllocError> {
    alloc ::= env.mem.alloc();
    buf   ::= alloc.String().try();
    buf.add(letters).try();
    first: str  ::= "safe";
    second: str ::= "safe";
    third: str  ::= "safe";
    Range(0, 3).loop((_) { first = second; second = third; third = buf.view(); });
    Ok(first)
}
main = (env: Env) Res<i32, AllocError> {
    text = word(env, "ab").try();
    println("{}", text);
    Ok(0)
}
