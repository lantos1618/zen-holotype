// src/sema/sema_decl.zen
// Eager declaration checks that must run even for unreachable code:
// overload uniqueness, impl completeness, and declared bodies/signatures.
// This walk drives memoized queries and owns no parallel type state.

Module, Decl, Function, TParam, BlockId, Ident = std.ast
Struct, Impl, Member, Enum = std.ast
ExprId, TypeId, Const, Field = std.ast
AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId = sema.sema_ty
Def, DefKind, ModuleTable, decl_at = sema.sema_def
Checker, Ctx = sema.sema_check
SemaFault, NameFault, PairFault = sema.sema_diag
check_impl = sema.sema_bound
check_overloads, same_fn_signature = sema.sema_call
check_depth = sema.sema_depth
check_varargs = sema.sema_vararg
check_layout = sema.sema_layout
type_of, block_type = sema.sema_type
bound_member_type = sema.sema
type_from_ast, param_type = sema.sema_denote
decl_as_type = sema.sema_type
enter_struct_tvars, member_type = sema.sema_member
variant_payload = sema.sema_case
owner_of, push_tparams = sema.sema_inst
settle_raised = sema.sema_raise
check_return = sema.sema_hoist
check_literal = sema.sema_trap
check_arms = sema.sema_hoist
check_own = sema.sema_own

// Every declaration rule, for one module.
check_module* = (c :: Checker, mi: usize) Res<(), AllocError> {
    c.world.table_at(mi).match({
        Ok(t) => c.check_table(t, mi),
        None  => Ok(()),
    })
}

// Every module in the compilation.
//
// The termination check runs LAST and over the whole program, because
// that is the only point at which it can run at all: it follows chains
// of instantiations across declarations and across modules, and a chain
// is not knowable until every body that contributes an edge to it has
// been walked.
check_all* = (c :: Checker) Res<(), AllocError> {
    Range(0, c.world.count()).loop((h, mi) {
        c.check_module(mi).try();
    });
    // Layout and depth require the complete cross-module declaration graph.
    c.check_layout().try();
    c.check_depth().try();
    // Vararg legality is positional, while type nodes do not store parents.
    check_varargs(c).try();
    Ok(());
}

check_table = (c :: Checker, t: ModuleTable, mi: usize)
              Res<(), AllocError> {
    c.check_overload_sets(t, mi).try();
    t.impls.loop((h, id) { c.check_impl(id, mi).try() });
    c.check_bodies(mi).try();
    Ok(());
}

// One overload set per NAME, and checked once. The rule is about a set,
// a set has no order, and visiting it once per member would report the
// same pair as many times as the set is large.
check_overload_sets = (c :: Checker, t: ModuleTable, mi: usize)
                      Res<(), AllocError> {
    seen ::= c.alloc.Vec<str>();
    t.defs.loop((h, d) { c.one_set(d, mi, seen).try() });
    Ok(());
}

one_set = (c :: Checker, d: Def, mi: usize, seen :: Vec<str>)
          Res<(), AllocError> {
    (is_fn_def(d.kind) && (has_name(seen, d.name) == false)).match({
        true  => c.new_set(d.name, mi, seen),
        false => Ok(()),
    })
}

new_set = (c :: Checker, name: str, mi: usize, seen :: Vec<str>)
          Res<(), AllocError> {
    seen.add(name).try();
    c.check_overloads(mi, name).try();
    Ok(());
}

is_fn_def = (k: DefKind) bool {
    k.match({ FunctionDef => true, _ => false })
}

has_name = (seen: Vec<str>, name: str) bool {
    Range(0, seen.len).find((i) {
        seen.get(i).match({ Ok(s) => s.eq(name), None => false })
    }).match({ Ok(_) => true, None => false })
}

// ---------------------------------------------------------------------
// bodies
// ---------------------------------------------------------------------

check_bodies = (c :: Checker, mi: usize) Res<(), AllocError> {
    c.tree.module_at(mi).match({
        Ok(m) => c.check_decls(m, mi),
        None  => Ok(()),
    })
}

check_decls = (c :: Checker, m: Module, mi: usize) Res<(), AllocError> {
    m.decls.loop((h, d) { c.check_decl(d, m, mi).try() });
    Ok(());
}

check_decl = (c :: Checker, d: Decl, m: Module, mi: usize)
             Res<(), AllocError> {
    d.kind.match({
        Function(f) => c.check_function(f, m, mi),
        Struct(s)   => c.struct_bodies(s, m, mi),
        Enum(e)     => {
            c.enum_payloads(e, mi).try();
            c.check_members(e, mi)
        },
        Impl(im)    => c.impl_bodies(im, m, mi),
        Const(k)    => c.const_body(k, mi),
        _           => Ok(()),
    })
}

// A constant's written type is a typed position. Apply the same family and
// literal-fit checks as a local written binding.
const_body = (c :: Checker, k: Const, mi: usize) Res<(), AllocError> {
    ctx = Ctx(mi, c.types.unknown().try());
    got = c.type_of(k.value, ctx).try();
    k.type.match({
        Ok(t) => c.const_fits(k.value, t, got, ctx),
        None  => Ok(()),
    })
}

// Without a written type, the value itself determines the constant's type.
const_fits = (c :: Checker, id: ExprId, t: TypeId, got: TyId, ctx: Ctx)
             Res<(), AllocError> {
    want = c.type_from_ast(t, ctx).try();
    node = c.tree.expr_at(id);
    c.coerce(node.span.file, node.span, got, want, "").try();
    c.check_literal(id, want).try();
    Ok(());
}

// Resolve every variant payload eagerly in the enum's type-parameter scope.
enum_payloads = (c :: Checker, e: Enum, mi: usize) Res<(), AllocError> {
    tmark = c.tvar_mark();
    owner = c.owner_of(mi, e.name.text).try();
    c.push_tparams(e.tparams, owner).try();
    ctx = Ctx(mi, c.types.unknown().try());
    e.variants.loop((h, v) { c.variant_payload(v, ctx).try() });
    c.release_tvars(tmark)
}

// For a declaration otherwise shaped as a union, report the single bare
// member that fails to name a type. Multiple misses remain a nominal enum;
// payload variants and value-bound names also make it nominal.
check_members = (c :: Checker, e: Enum, mi: usize)
                Res<(), AllocError> {
    miss_at    ::= e.variants.len;   // sentinel: no bare member missed
    miss_count ::= 0;
    types      ::= 0;
    values     ::= 0;
    Range(0, e.variants.len).loop((h, i) {
        v = e.variants.get(i).ok_or(AllocError.OutOfMemory).try();
        v.payload.match({
            // a written payload is a variant, never a member name
            Ok(_) => (),
            None  => c.binds_nothing(mi, v.name.text).try().match({
                true  => {
                    miss_count = miss_count + 1;
                    (miss_count == 1).match({
                        true  => { miss_at = i; },
                        false => (),
                    });
                },
                false => c.binds_a_type(mi, v.name.text).try().match({
                    true  => { types = types + 1; },
                    false => { values = values + 1; },
                }),
            }),
        });
    });
    ((miss_count == 1) && (types > 0) && (values == 0)).match({
        false => Ok(()),
        true  => c.report_member_miss(e, miss_at),
    })
}

// The one name standing between the declaration and its union reading,
// told so at its own position -- the same fault, words and span a
// signature position emits for the same text.
report_member_miss = (c :: Checker, e: Enum, at: usize)
                     Res<(), AllocError> {
    name = e.variants.get(at).ok_or(AllocError.OutOfMemory).try().name;
    c.report(
        name.span.file,
        name.span,
        SemaFault.UndefinedName(NameFault(name: name.text))
    )
}

// Whether the name binds nothing at all in the declaring module --
// the exact miss `sema_denote.lookup_named` reports in a signature.
binds_nothing = (c :: Checker, mi: usize, name: str) Res<bool, AllocError> {
    Ok(c.world.first_def_of(mi, name).try().match({
        None  => true,
        Ok(_) => false,
    }))
}

// Whether the name denotes a TYPE: a struct, an enum, or an alias that
// is not a module alias. A parameterised alias is a type constructor,
// and `Vec` in member position reads as one, so it counts.
binds_a_type = (c :: Checker, mi: usize, name: str) Res<bool, AllocError> {
    Ok(c.world.first_def_of(mi, name).try().match({
        None  => false,
        Ok(d) => d.kind.match({
            StructDef => true,
            EnumDef   => true,
            AliasDef  => c.alias_module(
                d.id
            ).match({ Ok(_) => false, None => true }),
            _         => false,
        }),
    }))
}

// Member bodies receive the same typing, return, and ownership checks as
// top-level function bodies. Lowering consumes their memoized answers.
struct_bodies = (c :: Checker, s: Struct, m: Module, mi: usize)
                Res<(), AllocError> {
    c.check_fields(s).try();
    self_ty = c.named_self(s.name.text, mi).try();
    tmark   = c.tvar_mark();
    c.enter_struct_tvars(s, mi).try();
    c.check_member_overloads(s, self_ty, mi).try();
    s.members.loop((h, mem) { c.member_body(mem, self_ty, m, mi).try() });
    c.release_tvars(tmark).try();
    Ok(());
}

check_member_overloads = (c :: Checker, s: Struct, self_ty: TyId, mi: usize)
                         Res<(), AllocError> {
    seen ::= c.alloc.Vec<Member>();
    s.members.loop((h, m) {
        m.kind.match({
            Function(_) => {
                seen.loop((h2, first) {
                    c.compare_member_signatures(first, m, self_ty, mi).try();
                });
                seen.add(m)
            },
            _           => Ok(()),
        }).try();
    });
    Ok(())
}

compare_member_signatures = (
    c       :: Checker,
    a       : Member,
    b       : Member,
    self_ty : TyId,
    mi      : usize
) Res<(), AllocError> {
    a.name().text.eq(b.name().text).match({
        false => Ok(()),
        true  => {
            aty = member_type(c, a, mi, self_ty).try();
            bty = member_type(c, b, mi, self_ty).try();
            c.same_fn_signature(aty, bty).match({
                false => Ok(()),
                true  => c.report(
                    a.span.file,
                    a.span,
                    SemaFault.DuplicateSignature(PairFault(
                        name: a.name().text,
                        first: a.span,
                        second: b.span,
                    ))
                ),
            })
        },
    })
}

check_fields = (c :: Checker, s: Struct) Res<(), AllocError> {
    seen ::= c.alloc.Vec<Ident>();
    s.members.loop((h, mem) {
        mem.kind.match({
            Field(f) => c.unique_field(f.name, seen),
            _        => Ok(()),
        }).try();
    });
    Ok(())
}

unique_field = (c :: Checker, name: Ident, seen :: Vec<Ident>)
               Res<(), AllocError> {
    Range(0, seen.len).find((i) {
        seen.get(i).match({
            Ok(first) => first.text.eq(name.text),
            None      => false,
        })
    }).match({
        None    => seen.add(name),
        Ok(pos) => {
            first = seen.get(pos).ok_or(AllocError.OutOfMemory).try();
            c.report(
                name.span.file,
                name.span,
                SemaFault.DuplicateField(PairFault(
                    name: name.text,
                    first: first.span,
                    second: name.span,
                ))
            )
        },
    })
}

// Impl bodies are checked in the target type's parameter scope.
impl_bodies = (c :: Checker, im: Impl, m: Module, mi: usize)
              Res<(), AllocError> {
    name    = im.target.text;
    self_ty = c.named_self(name, mi).try();
    tmark   = c.tvar_mark();
    c.enter_target_tvars(name, mi).try();
    im.members.loop((h, mem) { c.member_body(mem, self_ty, m, mi).try() });
    im.members.loop((h, mem) { c.field_value(mem, im, self_ty, mi).try() });
    c.release_tvars(tmark).try();
    Ok(());
}

// An impl-supplied field is checked against the corresponding bound member
// type after its value has been typed and memoized.
field_value = (
    c       :: Checker,
    mem     : Member,
    im      : Impl,
    self_ty : TyId,
    mi      : usize
) Res<(), AllocError> {
    bound = c.impl_bound_type(im, mi).try();
    mem.kind.match({
        Field(f) => f.value.match({
            Ok(v) => {
                ctx  = c.self_ctx(mi, self_ty).try();
                mark = c.mark();
                c.bind("self", self_ty, false, true).try();
                got = c.type_of(v, ctx).try();
                c.release(mark).try();
                want = c.bound_member_type(
                    bound,
                    mem.name().text,
                    self_ty
                ).try();
                node = c.tree.expr_at(v);
                // A BARE FUNCTION NAME SUPPLIES A METHOD: `widen_u64 =
                // to_u64` hands over the function itself, and the call
                // machinery instantiates it at each use — the value's
                // type here is the name standing for the declaration,
                // not the signature a data position would owe. Only a
                // DATA position owes the coercion.
                data = (c.supplies_fn(got).try() == false);
                data.then(() {
                    c.coerce(node.span.file, node.span, got, want, "").try();
                    c.check_literal(v, want).try();
                    c.check_arms(v, want).try();
                });
                Ok(())
            },
            None  => Ok(()),
        }),
        _        => Ok(()),
    })
}

// Whether a value's type is the bare NAME of a function declaration —
// `decl_as_type`'s answer for `to_i64` reached by bare name — rather
// than a data type. The one case a supplied field's value is not
// obliged to fit the field it supplies.
supplies_fn = (c :: Checker, ty: TyId) Res<bool, AllocError> {
    c.types.at(ty).match({
        Named(n) => decl_at(c.tree, n.decl).match({
            Ok(d) => d.kind.match({
                Function(_) => Ok(true),
                _           => Ok(false),
            }),
            None  => Ok(false),
        }),
        _        => Ok(false),
    })
}

// The named declaration's own type, with no arguments: `@Self` inside a
// member of `Vec<T>` is the `Vec` the declaration writes, and the
// receiver a call site reaches is a different question asked at the call
// site.
named_self = (c :: Checker, name: str, mi: usize) Res<TyId, AllocError> {
    c.target_decl(name, mi).try().match({
        Ok(d) => c.decl_as_type(d),
        None  => c.types.unknown(),
    })
}

// The tvars of a NAMED TARGET TYPE -- an impl's name read as a type,
// not an impl body being checked (`sema_supply.zen`'s twin). Same three
// lines, different question; Zen has no overloading to share a name.
enter_target_tvars = (c :: Checker, name: str, mi: usize)
                     Res<(), AllocError> {
    c.target_decl(name, mi).try().match({
        Ok(d) => c.target_tvars(d, mi),
        None  => Ok(()),
    })
}

target_decl = (c :: Checker, name: str, mi: usize)
              Res<Res<Def>, AllocError> {
    c.world.first_def_of(mi, name)
}

target_tvars = (c :: Checker, d: Def, mi: usize) Res<(), AllocError> {
    decl_at(c.tree, d.id).match({
        Ok(x) => c.target_decl_tvars(x, mi),
        None  => Ok(()),
    })
}

target_decl_tvars = (c :: Checker, d: Decl, mi: usize)
                    Res<(), AllocError> {
    d.kind.match({
        Struct(s) => c.enter_struct_tvars(s, mi),
        _         => Ok(()),
    })
}

member_body = (
    c       :: Checker,
    mem     : Member,
    self_ty : TyId,
    m       : Module,
    mi      : usize
) Res<(), AllocError> {
    mem.kind.match({
        Function(f) => c.member_fn_body(f, self_ty, m, mi),
        _           => Ok(()),
    })
}

member_fn_body = (
    c       :: Checker,
    f       : Function,
    self_ty : TyId,
    m       : Module,
    mi      : usize
) Res<(), AllocError> {
    f.body.match({
        Ok(b) => c.check_body(f, b, Ok(self_ty), m, mi),
        None  => c.check_signature(f, Ok(self_ty), m, mi),
    })
}

// A `Required` or `Hook` declaration has no body and nothing to check;
// the other two forms do. A top-level function has no `@Self`.
check_function* = (c :: Checker, f: Function, m: Module, mi: usize)
                  Res<(), AllocError> {
    f.body.match({
        Ok(b) => c.check_body(f, b, None, m, mi),
        None  => c.check_signature(f, None, m, mi),
    })
}

// Bodiless signatures still resolve generic bounds, parameters, and return
// types in declaration scope. Body-only return, ownership, and raised-error
// checks do not apply.
check_signature = (
    c       :: Checker,
    f       : Function,
    self_ty : Res<TyId>,
    m       : Module,
    mi      : usize
) Res<(), AllocError> {
    smark = c.mark();
    tmark = c.tvar_mark();
    bmark = c.bound_mark();
    owner = c.qualified(m, f).try();
    c.enter_generics(f, owner, mi).try();
    bind_params(c, f, body_ctx(c, f, mi, self_ty).try()).try();
    c.release_bounds(bmark).try();
    c.release_tvars(tmark).try();
    c.release(smark).try();
    Ok(());
}

// The scope, the type parameters and the bounds all enter here and all
// leave here, in one place, so a body that reports cannot leak a binding
// into the next declaration. The raised list drains here for the reason
// `settle_raised` states: a `.try()` in one body would otherwise be
// attributed to the next declaration walked.
check_body = (
    c       :: Checker,
    f       : Function,
    body    : BlockId,
    self_ty : Res<TyId>,
    m       : Module,
    mi      : usize
) Res<(), AllocError> {
    smark = c.mark();
    tmark = c.tvar_mark();
    bmark = c.bound_mark();
    owner = c.qualified(m, f).try();
    c.enter_generics(f, owner, mi).try();
    ctx = body_ctx(c, f, mi, self_ty).try();
    bind_params(c, f, ctx).try();
    rmark = c.raised_mark();
    c.enter_owner(owner);
    got = c.block_type(body, ctx).try();
    c.enter_owner("");
    c.check_return(body, ctx, got).try();
    c.settle_raised(f, ctx, got, rmark).try();
    // AFTER typing and BEFORE the scope is released. Ownership is a fact
    // about the path to a node rather than about the node, so it is a
    // walk and not a query; and it reads the types typing decided rather
    // than computing any, so the parameters have to still be bound when
    // it runs.
    c.check_own(f, body, ctx).try();
    c.release_bounds(bmark).try();
    c.release_tvars(tmark).try();
    c.release(smark).try();
    Ok(());
}

// `ret` and `has_ret` are what `.try()` answers to. A function that does
// not return a `Res` has nowhere to return a failure TO, which is the
// whole of the `TryOutsideRes` rule.
//
// `self_ty` present is what a member's body names `@Self` as freely as
// its signature does; absent is a top-level function, where the poison
// type stands in and `has_self` says so.
body_ctx = (c :: Checker, f: Function, mi: usize, self_ty: Res<TyId>)
           Res<Ctx, AllocError> {
    poison = c.types.unknown().try();
    base   = Ctx(mi, poison);
    ret    = f.ret.match({
        Ok(r) => c.type_from_ast(r, base),
        None  => c.types.prim("()"),
    }).try();
    Ok(Ctx(
        module: mi,
        ret: ret,
        has_ret: is_res(c, ret),
        self_ty: self_or_poison(self_ty, poison),
        has_self: self_ty_given(self_ty)
    ));
}

self_or_poison = (self_ty: Res<TyId>, poison: TyId) TyId {
    self_ty.match({ Ok(t) => t, None => poison })
}

self_ty_given = (self_ty: Res<TyId>) bool {
    self_ty.match({ Ok(_) => true, None => false })
}

is_res = (c: Checker, ty: TyId) bool {
    c.types.at(ty).match({ Res(_) => true, _ => false })
}

// The bounds are resolved with the type parameters already in scope, so
// `<T: Boxy, U: Vec<T>>` reads `T` as the parameter and not as a
// declaration of that name somewhere else.
enter_generics = (c :: Checker, f: Function, owner: str, mi: usize)
                 Res<(), AllocError> {
    f.tparams.loop((h, tp) {
        text = tp.name.text;
        c.push_tvar(text, c.types.var(text, owner).try()).try();
    });
    poison = c.types.unknown().try();
    ctx    = Ctx(mi, poison);
    f.tparams.loop((h, tp) { c.push_bounds(tp, ctx).try() });
    Ok(());
}

push_bounds = (c :: Checker, tp: TParam, ctx: Ctx) Res<(), AllocError> {
    text = tp.name.text;
    tp.bounds.loop((h, b) {
        c.push_bound(text, c.type_from_ast(b, ctx).try()).try();
    });
    Ok(());
}

bind_params = (c :: Checker, f: Function, ctx: Ctx) Res<(), AllocError> {
    f.params.loop((h, p) {
        text    = p.name.text;
        mutable = p.mutable;
        c.bind(text, c.param_type(p, ctx).try(), mutable, true).try();
    });
    Ok(());
}

// The declaration's module-qualified name, which is what a `Ty.Var` is
// nominal on. Built the same way `sema_def.zen` builds a `Def.qname`,
// because the two have to agree: a type parameter resolved here and the
// same one resolved from a candidate must intern to one type.
qualified = (c :: Checker, m: Module, f: Function) Res<str, AllocError> {
    out ::= c.alloc.String("{}.{}", m.name, f.name.text).try();
    Ok(out.view());
}
