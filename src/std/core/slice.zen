// Allocator-backed slice helpers for values that must outlive stack literals.
// Every allocating helper returns allocation failure as Result<_, IoError>.
// Public constructors take an allocator first; `_in` aliases support UFCS on the allocator.
// The allocating constructor is `alloc_buf`, NOT `buf`: this module is imported wholesale, and a
// top-level `buf` OUTRANKS a local `buf := …` at every call site in the importing module (std.net.http
// duplicated `head_bytes`/`tail_bytes` rather than take that import). Keep new globals here specific.
{ Allocator, try_acquire } = std.mem.alloc
{ Result, IoError, ok, err } = std.core.result
buf_in*<T> = (a: Allocator, n: i64, like: [T]) Result<[T], IoError> {
    (n <= 0).match ({
        true  => ok(slice(null_ptr(), 0)),
        false => a.try_acquire(n * sizeof(T)).match ({
            .Ok(p)  => ok(p.slice(n)),
            .Err(e) => err(e),
        }),
    })
}
dup_in*<T> = (a: Allocator, xs: [T]) Result<[T], IoError> {
    a.buf_in(xs.len, xs).match ({
        .Ok(buf) => {
            xs.loop((h, i, x) {
                buf[i] = x
            })
            ok(buf)
        },
        .Err(e)  => err(e),
    })
}
dupx_in*<T> = (a: Allocator, xs: [T]) Result<[T], IoError> { a.dup_in(xs) }
node_in*<T> = (a: Allocator, v: T) Result<Ptr<T>, IoError> {
    a.dup_in([v]).match ({
        .Ok(buf) => {
            vals: [T] = buf
            p: Ptr<T> = vals[0].addr()
            ok(p)
        },
        .Err(e)  => err(e),
    })
}
concat_in*<T> = (a: Allocator, xs: [T], ys: [T]) Result<[T], IoError> {
    a.buf_in(xs.len + ys.len, xs).match ({
        .Ok(buf) => {
            xs.loop((h, i, x) {
                buf[i] = x
            })
            ys.loop((h, i, y) {
                buf[xs.len + i] = y
            })
            ok(buf)
        },
        .Err(e)  => err(e),
    })
}
alloc_buf*<T> = (a: Allocator, n: i64, like: [T]) Result<[T], IoError> { a.buf_in(n, like) }
dup*<T> = (a: Allocator, xs: [T]) Result<[T], IoError> { a.dup_in(xs) }
dupx*<T> = (a: Allocator, xs: [T]) Result<[T], IoError> { a.dupx_in(xs) }
node*<T> = (a: Allocator, v: T) Result<Ptr<T>, IoError> { a.node_in(v) }
concat*<T> = (a: Allocator, xs: [T], ys: [T]) Result<[T], IoError> { a.concat_in(xs, ys) }
// --- views (zero-copy) --------------------------------------------------------------------------
// `offset` is BYTE arithmetic, so a sub-view advances the ptr by `lo * sizeof(T)`.
sl_clamp = (v: i64, lo: i64, hi: i64) i64 {
    (v < lo).match ({
        true  => lo,
        false => (v > hi).then({ hi }, { v }),
    })
}
// sub(xs, lo, hi) — a zero-copy view of xs[lo..hi). lo/hi are clamped to [0, xs.len] (and hi >= lo),
// so out-of-range bounds yield a shorter/empty view rather than reading past the buffer.
sub*<T> = (xs: [T], lo: i64, hi: i64) [T] {
    l = sl_clamp(lo, 0, xs.len)
    h = sl_clamp(hi, l, xs.len)
    slice(xs.ptr.offset(l * sizeof(T)), h - l)
}
// take(xs, n) — the first n elements; drop(xs, n) — all but the first n. Both are views.
take*<T> = (xs: [T], n: i64) [T] { xs.sub(0, n) }
drop*<T> = (xs: [T], n: i64) [T] { xs.sub(n, xs.len) }
// --- reverse (allocates a NEW slice) ------------------------------------------------------------
reverse_in*<T> = (a: Allocator, xs: [T]) Result<[T], IoError> {
    a.buf_in(xs.len, xs).match ({
        .Ok(out) => {
            xs.loop((h, i, x) {
                out[xs.len - 1 - i] = x
            })
            ok(out)
        },
        .Err(e)  => err(e),
    })
}
reverse<T> = (a: Allocator, xs: [T]) Result<[T], IoError> { a.reverse_in(xs) }
// --- search -------------------------------------------------------------------------------------
// index_of/contains rely on `==`, which lowers to C `==`: valid for scalar element types
// (i8..i64, u8..u64, bool, ptr/enum-tag). For struct/aggregate elements use find_by with an
// explicit predicate instead.
index_of*<T> = (xs: [T], x: T) i64 {
    r ::= 0 - 1
    xs.loop((h, i, e) {
        (e == x).then({
            (r < 0).then({
                r = i
            })
        })
    })
    r
}
contains*<T> = (xs: [T], x: T) bool { xs.index_of(x) >= 0 }
// find_by(xs, pred) — index of the first element satisfying pred, or -1. Works for ANY element
// type (no equality needed).
find_by*<T> = (xs: [T], pred: (T) bool) i64 {
    r ::= 0 - 1
    xs.loop((h, i, e) {
        pred(e).then({
            (r < 0).then({
                r = i
            })
        })
    })
    r
}
