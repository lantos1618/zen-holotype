// EXACTLY ONE syntax error, on line 7: `2 +` has no right operand.
// every line after it is valid, and the parser must resynchronise at
// the statement boundary rather than report the rest of the block.
// the sidecar file one_error_no_cascade.count says how many
// diagnostics the whole file may produce: 1.
main = (env: Env) Res<i32, ArgError> {
    a = 1;
    b = 2 +;
    c = 3;
    println("{}", a);
    println("{}", b);
    println("{}", c);
    Ok(0);
}
