// src/zen/zen_cli.zen
// The command line, and nothing else.
//
// THE INVOCATION IS FIXED BY AN ORACLE, not by taste:
// `scripts/fixpoint.sh` builds `zen-1` out of `stage1.c` and runs it as
//
//     zen build <root> --emit-c -o <file.c>
//
// so this argument shape is the compiler's interface to the project's
// strongest test — getting it wrong is the gate failing to run at all.
// `--entry` is added BESIDE that line, never into it: the fixpoint
// passes no entry and must keep finding one.
//
// THIS FILE TOUCHES NO CAPABILITY: it takes a `Vec<str>` and returns
// what was asked for, the one part of the CLI a corpus test can drive
// (`tests/corpus/cli/` hands it argv it will never see for real).
//
// `--repeat N` / `--permute <mode>` EXIST FOR A GATE, NOT A USER —
// deliberately absent from `USAGE` (tests/determinism/README.md
// specifies both). Neither changes what a build with neither emits.
//
// `build` AND `fmt` ARE WRITTEN; `test` is stage 1's `build.zen`. `lsp`
// has a server, dispatched by name in `zen.zen` since it takes no
// arguments this file would decide about. Both are still NAMED here and
// answered "not yet" — a silent no-op is worse than saying a command is
// not written.

Alloc, AllocError = std.mem
str = std.text
Vec = std.collections
Range = std.core

// What the command line asked for.
//
// Four cases, not one: collapsing any pair sends the caller to fix the
// wrong thing. `zen fmt` unwritten isn't the same as a meaningless
// command; a missing required flag isn't the same as a misspelled one
// (nothing the caller wrote is wrong).
Cli* = Build(Job)
     | Fmt(FmtJob)
     | Later(str)     // test / lsp — named, and not yet written
     | Usage(str)     // the word that made no sense; empty means nothing was said
     | Missing(str)   // a flag the build needs and did not get

// Everything `build` needs. `emit_c` is a flag not a mode enum: there's
// exactly one mode (PLAN.md: C is the backend).
Job* = {
    root*: str,      // the compilation root: a DIRECTORY, always
    out*: str,       // where the C goes; empty when `-o` was not given
    // where to START inside the root, relative to it. THE DEFAULT IS
    // WRITTEN DOWN NOW: "empty means the driver probes" was true and
    // rode on C zero-init, which is a value nobody wrote and which the
    // checker refuses since it started asking for required fields.
    entry* :: str = "",
    emit_c*: bool,
    debug*: Debug,
}

// THE TWO GATE FLAGS, kept in their own struct so `Job`'s four fields
// stay "what is this build" and these stay "how is it measured".
// Neither changes what a clean build emits.
//
// tests/determinism/README.md calls both a CONTRACT: `check.sh` cannot
// write its first check without `--repeat`, and without `--permute` its
// third check has nothing to vary. A gate that cannot vary its input
// cannot go red.
Debug* = {
    repeat*: usize,  // run the whole pipeline this many times, in one
                     // process; 1 is one build and no extra files
    permute*: str,   // reverse | rotate | interleave; empty is the
                     // order the imports are written in
}

// `zen fmt` takes FILES, never a directory; `zen_fmt.zen`'s header says
// why, and is where one is refused.
FmtJob* = {
    // The whole command line. Paths (words after `fmt`) are read back
    // out, not copied at parse time — `cli` takes no `Alloc`, and law 1
    // says the allocating signature says so.
    argv*: Vec<str>,

    // `--check`: report, change nothing. Without it the files are
    // rewritten in place.
    check*: bool,

    // Every path the caller named.
    paths* = (self: @Self, a: Alloc) Res<Vec<str>, AllocError> {
        out ::= a.Vec<str>();
        Range(ARGS, self.argv.len).loop((h, i) {
            word = arg_at(self.argv, i);
            is_word(word).match({
                true  => out.add(word),
                false => Ok(()),
            }).try();
        });
        Ok(out);
    }
}

// `argv.get(0)` is the program path, `argv.get(1)` the command, so a
// command's own arguments start here. Spelled once: a stray `2` in one
// of the two scans that read it would silently start on the command.
ARGS*: usize = 2

USAGE*: str = "usage: zen build <root> [--entry <file>] --emit-c -o <file.c>\n       zen fmt [--check] <file.zen>..."

// What one argument is. A classifier, not a chain of matches at the
// scan site — the scan stays readable while it carries the cursor.
Arg = EmitC | Out | Entry | Repeat | Permute | Flag | Word

cli* = (argv: Vec<str>) Cli {
    argv.get(1).match({
        None     => Cli.Usage(""),
        Ok(name) => command(argv, name),
    })
}

command = (argv: Vec<str>, name: str) Cli {
    name.eq("build").match({
        true  => job_of(argv),
        false => not_build(argv, name),
    })
}

not_build = (argv: Vec<str>, name: str) Cli {
    name.eq("fmt").match({
        true  => fmt_of(argv),
        false => not_written(name),
    })
}

not_written = (name: str) Cli {
    is_later(name).match({
        true  => Cli.Later(name),
        false => Cli.Usage(name),
    })
}

is_later = (name: str) bool {
    name.eq("test") || name.eq("lsp")
}

// `zen fmt [--check] <file.zen>...`. One flag, a list of paths — the
// build's scan with four cases collapsed to two: a word is a path, and
// every path is kept.
//
// A FORMAT WITH NO PATHS IS NOT A SMALLER FORMAT, it is nothing — the
// same reading `built` gives a build with no `--emit-c`.
fmt_of = (argv: Vec<str>) Cli {
    check ::= false;
    bad   ::= "";
    words ::= 0;
    Range(ARGS, argv.len).loop((h, i) {
        word = arg_at(argv, i);
        word.eq("--check").match({
            true  => { check = true; },
            false => is_flag(word).match({
                true  => { bad = word; h.break(); },
                false => { words = words + word_count(word); },
            }),
        });
    });
    fmt_verdict(argv, check, bad, words);
}

word_count = (word: str) usize {
    is_word(word).match({
        true  => 1,
        false => 0,
    })
}

fmt_verdict = (argv: Vec<str>, check: bool, bad: str, words: usize) Cli {
    bad.is_empty().match({
        false => Cli.Usage(bad),
        true  => (words == 0).match({
            true  => Cli.Usage(""),
            false => Cli.Fmt(FmtJob(argv: argv, check: check)),
        }),
    })
}

// A path, as opposed to a flag or a gap in a test's argument vector.
// `paths` and `fmt_of` must agree on this, so they read one function.
is_word = (word: str) bool { !word.is_empty() && !is_flag(word) }

// The scan. One pass, one cursor, a `bad` that stops it: the first
// argument that makes no sense is worth naming; a fifth would bury it.
job_of = (argv: Vec<str>) Cli {
    root  ::= "";
    out   ::= "";
    entry ::= "";
    runs  ::= 1;
    perm  ::= "";
    emit  ::= false;
    bad   ::= "";
    i     ::= ARGS;
    loop(() { i < argv.len && bad.is_empty() }, (h) {
        arg = arg_at(argv, i);
        i   = i + 1;
        classify(arg).match({
            EmitC   => { emit = true; },
            Out     => { out = arg_at(argv, i); i = i + 1; },
            Entry   => { entry = arg_at(argv, i); i = i + 1; },
            Repeat  => { runs = arg_at(argv, i).runs_of(); i = i + 1; },
            Permute => { perm = arg_at(argv, i); i = i + 1; },
            Flag    => { bad = arg; },
            Word    => root.is_empty().match({
                true  => { root = arg; },
                false => { bad = arg; },
            }),
        });
    });
    verdict(root, out, entry, emit, bad, Debug(repeat: runs, permute: perm));
}

verdict = (root: str, out: str, entry: str, emit: bool, bad: str, dbg: Debug)
          Cli {
    bad.is_empty().match({
        false => Cli.Usage(bad),
        true  => root.is_empty().match({
            true  => Cli.Usage(""),
            false => built(root, out, entry, emit, dbg),
        }),
    })
}

// `--emit-c` IS THE BUILD; without it a build is not smaller, it's
// nothing. Emission is the only thing this compiler does with the tree
// it checked; drop the flag and it type-checks the world, throws the
// answer away, exits 0 having written no file. That silent bug once
// held long enough that `make build` produced no binary — taking
// `test`, `fmt` and `determinism` down with it, since a target that
// can't run can't go red either.
built = (root: str, out: str, entry: str, emit: bool, dbg: Debug) Cli {
    emit.match({
        false => Cli.Missing("--emit-c"),
        true  => Cli.Build(Job(
            root: root,
            out: out,
            entry: entry,
            emit_c: emit,
            debug: dbg
        )),
    })
}

// `--entry <file>` is a FILE INSIDE THE ROOT, not a second root — a
// flag with an argument, like `-o`. The root stays positional (a build
// is a root); the entry says where to start in it, knowledge the
// caller has and the compiler can't recover (`std.env.Fs` has no
// listing, on purpose).
classify = (a: str) Arg {
    a.eq("--emit-c").match({
        true  => Arg.EmitC,
        false => a.eq("-o").match({
            true  => Arg.Out,
            false => a.eq("--entry").match({
                true  => Arg.Entry,
                false => debug_arg(a),
            }),
        }),
    })
}

// The two debug flags, split off so `classify` stops at four levels.
// They take an argument like `-o`/`--entry`, so a missing one leaves
// the default rather than swallowing the next word.
debug_arg = (a: str) Arg {
    a.eq("--repeat").match({
        true  => Arg.Repeat,
        false => a.eq("--permute").match({
            true  => Arg.Permute,
            false => is_flag(a).match({
                true  => Arg.Flag,
                false => Arg.Word,
            }),
        }),
    })
}

// A leading `-` is a flag whatever follows it, so an unknown one is
// named rather than silently read as the root — otherwise a typo in
// `--emit-c` compiles the wrong tree, quietly.
is_flag = (a: str) bool {
    a.is_empty().match({
        true  => false,
        false => a.index(0) == '-',
    })
}

// An argument past the end is the empty string, which every caller
// already handles: `-o` with nothing after leaves `out` empty, reported
// where `out` is used, not here.
arg_at = (argv: Vec<str>, i: usize) str {
    argv.get(i).match({
        Ok(s) => s,
        None  => "",
    })
}

// How many runs `--repeat <n>` asks for. Digits only, ANYTHING ELSE IS
// ONE, never zero — a debug flag quietly running the pipeline zero
// times would make its own check pass by emitting nothing: a gate that
// succeeds when it can't run.
runs_of = (text: str) usize {
    n      ::= 0;
    digits ::= text.is_empty() == false;
    Range(0, text.len).loop((h, i) {
        b = text.index(i);
        b.is_digit().match({
            true  => { n = n * 10 + place_of(b); },
            false => { digits = false; },
        });
    });
    (digits && n > 0).match({
        true  => n,
        false => 1,
    })
}

// The value of one digit byte, widened. Guarded by `is_digit` at its
// one call site, so the subtraction can't underflow.
place_of = (b: u8) usize {
    (b - '0').to_u32().to_usize()
}
