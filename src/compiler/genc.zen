dtraitdef* = (trname: string_view, fn: Func) Decl {
    .DTraitDefault(TraitDefData(
        trname: trname,
        fn: fn,
    ))
}
mono_tynode_in = (a: MutPtr<Malloc>, t: Ty) Ptr<Ty> {
    buf := cbuf<Ty>(a, 1)
    buf[0] = t
    buf[0].addr()
}
// the FnT SIGNATURE of a function (its param types + ret) — used to give a default-bodied trait method
// a Field type so conformance sees a normal method signature. Allocates a [Ty] of the param types.
fnt_param_tys_in = (a: MutPtr<Malloc>, ps: [Param]) [Ty] {
    buf := cbuf<Ty>(a, ps.len)
    ps.loop((h, i, p) {
        buf[i] = p.ty
    })
    buf
}
ty_node_in* = (a: MutPtr<Malloc>, t: Ty) Ptr<Ty> { a.mono_tynode_in(t) }
fnt_from_func_in* = (a: MutPtr<Malloc>, f: Func) Ty {
    fntype(a.fnt_param_tys_in(f.params), a.ty_node_in(f.ret))
}
draw* = (c: string_view) Decl { .DRaw(c) }    // emit verbatim C: an attribute,
// pragma, intrinsic decl, anything
// map a narrow int/float type name to its C type; any other name passes through unchanged.
// the checker accepts i8/i16/u16/u32/u64/f32 but they reach genc as Named(name), so without
// this they'd leak the Zen name (`u32`, `f32`, …) straight to cc as an unknown C type.
width_cname* = (n: string_view) string_view {
    (n == "i8").match ({
        true  => "int8_t",
        false => (n == "i16").match ({
            true  => "int16_t",
            false => (n == "u16").match ({
                true  => "uint16_t",
                false => (n == "u32").match ({
                    true  => "uint32_t",
                    false => (n == "u64").match ({
                        true  => "uint64_t",
                        false => (n == "f32").match ({ true => "float", false => n }),
                    }),
                }),
            }),
        }),
    })
}
// append a C type — recurses for pointers (`T*`), so it can't be a plain str-returning fn
gen_ty* = (s: String, a: MutPtr<Malloc>, t: Ptr<Ty>) String {
    out := s
    t.match ({
        .I32           => {
            out = out.gstr_append(a, "int32_t")
        },
        .I64           => {
            out = out.gstr_append(a, "int64_t")
        },
        .U8            => {
            out = out.gstr_append(a, "uint8_t")
        },
        .F64           => {
            out = out.gstr_append(a, "double")
        },
        .Bool          => {
            out = out.gstr_append(a, "bool")
        },
        .Void          => {
            out = out.gstr_append(a, "void")
        },
        .StringView    => {
            out = out.gstr_append(a, "const char*")
        },
        .StringCstr    => {
            out = out.gstr_append(a, "const char*")
        },
        .StringLiteral => {
            out = out.gstr_append(a, "const char*")
        },
        .Named(n)      => {
            out = out.gstr_append(a, width_cname(n))
        },
        .Ptr(pd)       => {
            inner := out.gen_ty(a, pd.pointee)
            out = inner.gstr_append(a, "*")
        },
        .Slice(e)      => {
            out = out.gstr_append(a, "zslice")
        },    // [T] is the fat-pointer struct (T recovered at use)
        .FnT(ft)       => {
            out = out.gstr_append(a, "zfn")
        },    // a first-class function value: the generic fn-pointer typedef
        .Generic(g)    => {
            out = out.gstr_append(a, g.mangled)
        },
    })    // a generic instance → its monomorphized C name
    out
}
// the C type name of a Ty as a plain string — used to substitute `sizeof(T)` in a generic body
// (the tparam Var `T` becomes the concrete type's C name, so `sizeof(T)` → `sizeof(Expr)`).
cname_len = (t: Ty) i64 {
    t.match ({
        .I32           => 7,
        .I64           => 7,
        .U8            => 7,
        .F64           => 6,
        .Bool          => 4,
        .Void          => 4,
        .StringView    => 11,
        .StringCstr    => 11,
        .StringLiteral => 11,
        .Named(n)      => width_cname(n).view().len,
        .Generic(g)    => g.mangled.view().len,
        .Ptr(pd)       => load(pd.pointee).cname_len() + 1,
        .Slice(e)      => 6,
        .FnT(ft)       => 3,
    })
}
cname_write = (dst: RawPtr<u8>, at: i64, t: Ty) i64 {
    t.match ({
        .I32           => dst.write_str(at, "int32_t"),
        .I64           => dst.write_str(at, "int64_t"),
        .U8            => dst.write_str(at, "uint8_t"),
        .F64           => dst.write_str(at, "double"),
        .Bool          => dst.write_str(at, "bool"),
        .Void          => dst.write_str(at, "void"),
        .StringView    => dst.write_str(at, "const char*"),
        .StringCstr    => dst.write_str(at, "const char*"),
        .StringLiteral => dst.write_str(at, "const char*"),
        .Named(n)      => dst.write_str(at, width_cname(n)),
        .Generic(g)    => dst.write_str(at, g.mangled),
        .Ptr(pd)       => dst.write_str(dst.cname_write(at, load(pd.pointee)), "*"),
        .Slice(e)      => dst.write_str(at, "zslice"),
        .FnT(ft)       => dst.write_str(at, "zfn"),
    })
}
ty_cname_in* = (a: MutPtr<Malloc>, t: Ty) string_view {
    n := t.cname_len()
    buf: RawPtr<u8> := a.acquire(n + 1)
    buf.finish_buf(buf.cname_write(0, t))
}
// ── type substitution (tparam→arg): shared by compiler.check (subst_ty_in/find_genenum) and the
//    monomorphize pass (compiler.mono). A tiny stack of [Ty] buffer helpers + the recursive
//    substitution + the generic-enum lookup; they're TYPE helpers, so they live in the base. ──
// substitute tparam→arg in a type (recursing Ptr/Slice); a Named that IS a tparam becomes its arg.
tparam_arg = (tparams: [Param], args: [Ty], n: string_view, dflt: Ty) Ty {
    found := dflt
    tparams.loop((h, i, tp) {
        // Guard `i < args.len`: a WRONG-ARITY explicit targ list (too few `<…>` args for the declared
        // tparams) would otherwise index past `args` and panic. Leave an un-pinned tparam lenient here;
        // the targ-arity diagnostic (kv_makestruct_targ_kind) owns the real error report.
        found = (tp.name == n && i < args.len).match ({ true => args[i], false => found })
    })
    found
}
subst_ty_in* = (a: MutPtr<Malloc>, tparams: [Param], args: [Ty], t: Ty) Ty {
    t.match ({
        .Named(n)   => tparams.tparam_arg(args, n, t),
        .Ptr(pd)    => tptr_k(a.mono_tynode_in(a.subst_ty_in(tparams, args, load(pd.pointee))), pd.kind),
        .Slice(e)   => tslice(a.mono_tynode_in(a.subst_ty_in(tparams, args, load(e)))),
        .Generic(g) => a.subst_generic_in(tparams, args, g),    // a nested generic field: substitute its args, re-mangle
        .FnT(ft)    => a.subst_fnt_in(tparams, args, ft),    // a function-VALUE field `(S, i32) S`: substitute inside the signature
        _           => t,
    })
}
// substitute tparam→arg inside a function type `(S, i32) S` -> `(AppState, i32) AppState`.
subst_fnt_in = (a: MutPtr<Malloc>, tparams: [Param], args: [Ty], ft: FnTData) Ty {
    ptys := cbuf<Ty>(a, ft.params.len)
    ft.params.loop((h, i, p) {
        ptys[i] = a.subst_ty_in(tparams, args, p)
    })
    fntype(ptys, a.mono_tynode_in(a.subst_ty_in(tparams, args, load(ft.ret))))
}
// substitute tparam→arg inside a nested generic instance `Inner<T>` -> `Inner<i32>` (new mangled name).
subst_generic_in = (a: MutPtr<Malloc>, tparams: [Param], args: [Ty], g: GenericData) Ty {
    // `tys` (not `buf`): mangle_str_in inlines a local `buf: RawPtr<u8>`, and the inliner
    // substitutes args by name — a caller arg also named `buf` would be captured by that local.
    tys := cbuf<Ty>(a, g.args.len)
    g.args.loop((h, i, gt) {
        tys[i] = a.subst_ty_in(tparams, args, gt)
    })
    tgeneric(g.name, tys, a.mangle_str_in(g.name, tys))
}
find_genenum* = (decls: [Decl], name: string_view) GenEnumDecl {
    found := GenEnumDecl(
        name: "",
        tparams: slice(null_ptr(), 0),
        variants: slice(null_ptr(), 0),
    )
    decls.loop((h, i, d) {
        found = d.match ({
            .DGenEnum(g) => (g.name == name).match ({ true => g, false => found }),
            _            => found,
        })
    })
    found
}
