// tests/corpus/printing/print_without_newline_and_value_only/main.zen
// The prelude has exactly TWO console spellings (`is_print`): `println`
// appends one `\n`, `print` appends none — and a call whose first
// argument is NOT a string literal has no format at all, so every
// argument is "just a value" written back to back with no separators.
//
// Three silent ways to get this wrong, each printing plausible text:
//
//   - `print` gaining println's newline (or losing its own place in the
//     dispatch): every line below re-flows.
//   - the value-only form inserting separators or dropping values:
//     `println(1, 2, 3)` is `123` BY DESIGN, not an accident to fix.
//   - a format-matched hole count enforced on the value-only form,
//     which would reject it outright.
//
// The mixed middle rows show the two doors interleaving: `print` ends a
// line mid-sentence and the next call's literal continues it.

Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    print("no");
    print("newline");
    println("here");
    println(1, 2, 3);
    s = "just-a-value";
    println(s);
    print("a=");
    println(4);
    Ok(0);
}
