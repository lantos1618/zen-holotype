    // ── (j) procedural tests (project mode, fmt idempotency, help/version, bad-file, sibling, emit-eq) ─
    sh := run_shells("build shell", [
        ShellCase(
            name: "decl_cap_2000_generated",
            cmd: "f=$ZT/decl_cap_2000.zen && : >$f && i=0 && while test $i -lt 2000; do printf 'f%s = () i32 { %s }\\n' \"$i\" \"$((i % 100))\" >>$f; i=$((i + 1)); done && printf 'main = () i32 { f1999() }\\n' >>$f && ./zen build $f -o $ZT/decl_cap_2000 >/dev/null 2>&1 && { $ZT/decl_cap_2000; test \"$?\" = 99; }",
        ),
        ShellCase(
            name: "run_forwards_args",
            cmd: "./zen run tests/fixtures/zen/echo_args.zen alpha beta 'g z' > $ZT/zargs.txt 2>/dev/null && printf '3\\nalpha\\nbeta\\ng z\\n' | cmp -s - $ZT/zargs.txt",
        ),
        ShellCase(
            name: "run_no_args_still_works",
            cmd: "./zen run tests/fixtures/zen/echo_args.zen > $ZT/zargs0.txt 2>/dev/null && printf '0\\n' | cmp -s - $ZT/zargs0.txt",
        ),
        ShellCase(
            name: "example_http_tool_url_errors",
            cmd: "{ timeout 30 ./zen run examples/http_tool.zen https://example.com/ > $ZT/zhtu.txt 2>/dev/null; test \"$?\" = 2; } && grep -Fq 'https is not supported' $ZT/zhtu.txt && { timeout 30 ./zen run examples/http_tool.zen http://127.0.0.1:1/ > $ZT/zhtc.txt 2>/dev/null; test \"$?\" = 1; } && grep -Fq Connect $ZT/zhtc.txt",
        ),
        ShellCase(
            name: "example_jq_query_pretty_and_errors",
            cmd: "printf '{\"a\":{\"b\":[\"x\",\"deep\"]}}' > $ZT/zjq.json && ./zen run examples/jq.zen '.a.b[1]' $ZT/zjq.json > $ZT/zjq1.txt 2>/dev/null && printf '\"deep\"\\n' | cmp -s - $ZT/zjq1.txt && ./zen run examples/jq.zen '.a' < $ZT/zjq.json > $ZT/zjq2.txt 2>/dev/null && printf '{\\n  \"b\": [\\n    \"x\",\\n    \"deep\"\\n  ]\\n}\\n' | cmp -s - $ZT/zjq2.txt && { ./zen run examples/jq.zen '.nope' $ZT/zjq.json > $ZT/zjq3.txt 2>/dev/null; test \"$?\" = 1; } && grep -Fqx 'jq: no such field: nope' $ZT/zjq3.txt && { printf '{' | ./zen run examples/jq.zen . > $ZT/zjq4.txt 2>/dev/null; test \"$?\" = 1; } && grep -Fq 'invalid JSON' $ZT/zjq4.txt",
        ),
        ShellCase(
            name: "example_textproc_wc_grep_re",
            cmd: "printf 'the cat sat\\non the mat\\nthe cat ran\\n' > $ZT/ztp.txt && ./zen run examples/textproc.zen $ZT/ztp.txt > $ZT/ztp1.txt 2>/dev/null && printf '3 9 35\\n' | cmp -s - $ZT/ztp1.txt && printf 'a\\000b\\nc\\n' > $ZT/ztp.bin && ./zen run examples/textproc.zen $ZT/ztp.bin > $ZT/ztp2.txt 2>/dev/null && printf '2 2 6\\n' | cmp -s - $ZT/ztp2.txt && ./zen run examples/textproc.zen grep cat $ZT/ztp.txt > $ZT/ztp3.txt 2>/dev/null && printf 'the cat sat\\nthe cat ran\\n' | cmp -s - $ZT/ztp3.txt && ./zen run examples/textproc.zen re '^the .*t$' < $ZT/ztp.txt > $ZT/ztp4.txt 2>/dev/null && printf 'the cat sat\\n' | cmp -s - $ZT/ztp4.txt && { ./zen run examples/textproc.zen grep zzz $ZT/ztp.txt > /dev/null 2>&1; test \"$?\" = 1; } && { ./zen run examples/textproc.zen re '(' $ZT/ztp.txt > $ZT/ztp5.txt 2>/dev/null; test \"$?\" = 2; } && grep -Fq 'bad regex' $ZT/ztp5.txt",
        ),
        ShellCase(
            name: "tools_sigs_signature_map",
            cmd: "./zen run tools/sigs.zen tests/fixtures/sigs > $ZT/sigs.txt 2>/dev/null && cmp -s tests/fixtures/sigs/expected.txt $ZT/sigs.txt",
        ),
        ShellCase(
            name: "os_args_env_helpers",
            cmd: "./zen run tests/fixtures/zen/os_args_env.zen --verbose > $ZT/zoae.txt 2>/dev/null && printf '2\\nverbose-on\\nout-empty\\nhi\\nunset-ok\\n' | cmp -s - $ZT/zoae.txt",
        ),
        ShellCase(
            name: "os_args_oom_result",
            cmd: "./zen build tests/fixtures/zen/os_args_oom.zen -o $ZT/zoao 2>/dev/null && { $ZT/zoao > $ZT/zoao.txt 2>&1; test \"$?\" = 0; } && printf 'oom-err\\n' | cmp -s - $ZT/zoao.txt",
        ),
        ShellCase(
            name: "result_expect_panics",
            cmd: "./zen build tests/fixtures/zen/result_expect_panics.zen -o $ZT/zrep 2>/dev/null && { $ZT/zrep >/dev/null 2>$ZT/zrep_e.txt; test \"$?\" = 134; } && grep -Fqx \"zen: panic: config must load\" $ZT/zrep_e.txt && test \"$(grep -c 'zen: panic:' $ZT/zrep_e.txt)\" = 1",
        ),
        ShellCase(
            name: "inline_actor_oom_panic_aborts",
            cmd: "./zen build tests/fixtures/zen/inline_actor_oom_panic_aborts.zen -o $ZT/ziop 2>/dev/null && { $ZT/ziop >/dev/null 2>$ZT/ziop_e.txt; test \"$?\" = 134; } && grep -Fqx \"zen: panic: vec.new: out of memory\" $ZT/ziop_e.txt && test \"$(grep -c 'zen: panic:' $ZT/ziop_e.txt)\" = 1",
        ),
