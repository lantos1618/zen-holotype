// `*%` binds tighter than `+`: one + max *% two is one + (max *% 2),
// and max *% 2 wraps to -2, so the answer is -1.
// the other reading, (one + max) *% two, TRAPS on the `+`.

main = (env: Env) Res<i32, ArgError> {
    max: i32 = 2147483647;
    one: i32 = 1;
    two: i32 = 2;
    v        = one + max *% two;
    println("{}", v);
    Ok(0);
}
