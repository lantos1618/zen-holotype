// Owns the workspace check used to publish diagnostics. A settle publishes
// changed results and empty lists for files whose previous errors disappeared.

str, String = std.text
Vec, Map = std.collections
Alloc, AllocError, Arena = std.mem
Note = std.parse.parse_diag
Checker = sema.sema_check
root_for, relative_to = zen.zen_path
WireRange, wire_range, write_range = lsp.lsp_pos
obj, arr, Nest, written, to_json = std.json
write_frame = lsp.lsp_frame
path_of = lsp.lsp_uri
own_str = lsp.lsp_reply
Built, Spot* = lsp.lsp_built
Classed = lsp.lsp_colour

Diagnostic = {
    range: WireRange,
    severity: usize,
    source: str,
    message: str,
}

Shared* = {
    c*: Res<Checker>,
    root*: str,
}

// Inputs borrowed from the server for one workspace check or publication.
// Session state stays in `Diagnostics`; temporary output stays in `temp`.
WorkspaceTurn = {
    env: Env,
    workspace: str,
    uris: Vec<str>,
    docs: Map<str, str>,
    temp: Alloc,

    root = (self: @Self, path: str) str {
        root_for(self.env, self.temp, self.workspace, path)
    }

    text = (self: @Self, uri: str) str {
        text_of(self.env, self.temp, uri, self.docs)
    }
}

Diagnostics* = {
    a: Alloc,

    owed :: str = "",

    showing :: Vec<str>,

    closing :: Vec<str>,

    built :: Built,

    fresh :: bool = false,

    said_arena :: Arena,

    said :: Map<str, str>,

    owes* = (self :: @Self, uri: str) () {
        self.built.invalidate();
        self.owed  = uri;
        self.fresh = false;
    }

    stales* = (self :: @Self, uri: str) () {
        self.built.invalidate();
        self.fresh = false;
        self.owed.is_empty().then(() { self.owed = uri; });
    }

    closed* = (self :: @Self, uri: str, next: str)
              Res<(), AllocError> {
        self.built.invalidate();
        self.fresh = false;
        self.owed  = next;
        self.closing.find((u) { u.eq(uri) }).match({
            Ok(_) => written(),
            None  => self.closing.add(uri),
        })
    }

    classes_for* = (self :: @Self, t: Alloc, uri: str)
                   Res<Vec<Classed>, AllocError> {
        self.fresh.match({
            false => Ok(t.Vec<Classed>()),
            true  => self.built.classed_for(t, uri),
        })
    }

    shared* = (self :: @Self, env: Env, workspace: str, uris: Vec<str>,
               docs: Map<str, str>, path: str, t: Alloc)
              Res<Shared, AllocError> {
        turn = WorkspaceTurn(
            env: env,
            workspace: workspace,
            uris: uris,
            docs: docs,
            temp: t
        );
        root = turn.root(path);
        self.built.ensure(
            turn.env,
            root,
            relative_to(root, path),
            turn.uris,
            turn.docs
        ).try();
        Ok(Shared(c: self.built.checker(), root: self.built.root()));
    }

    settled* = (self :: @Self, env: Env, workspace: str, uris: Vec<str>,
                docs: Map<str, str>, t: Alloc, out :: String)
               Res<(), AllocError> {
        turn = WorkspaceTurn(
            env: env,
            workspace: workspace,
            uris: uris,
            docs: docs,
            temp: t
        );
        self.clear_closed(turn, out).try();
        self.owed.is_empty().match({
            true  => written(),
            false => self.build_owed(turn, out),
        })
    }

    clear_closed = (self :: @Self, turn: WorkspaceTurn, out :: String)
                   Res<(), AllocError> {
        empty ::= turn.temp.Vec<Spot>();
        self.closing.loop((h, uri) {
            self.say_one(turn, uri, empty, out).try();
        });
        kept ::= self.a.Vec<str>();
        self.showing.loop((h, uri) {
            self.closing.find((u) { u.eq(uri) }).match({
                Ok(_) => written(),
                None  => kept.add(uri),
            }).try();
        });
        self.showing = kept;
        self.closing = self.a.Vec<str>();
        Ok(())
    }

    build_owed = (self :: @Self, turn: WorkspaceTurn, out :: String)
                 Res<(), AllocError> {
        uri       = self.owed;
        self.owed = "";
        path      = path_of(uri);
        root      = turn.root(path);
        (turn.workspace.is_empty() || root.is_empty()).match({
            true  => written(),
            false => self.told(turn, root, relative_to(root, path), uri, out),
        })
    }

    told = (self :: @Self, turn: WorkspaceTurn, root: str, entry: str,
            uri: str, out :: String)
           Res<(), AllocError> {
        self.built.ensure(turn.env, root, entry, turn.uris, turn.docs).try();
        self.fresh = true;
        self.built.spots().match({
            None      => written(),
            Ok(spots) => self.say_all(turn, uri, spots, out),
        })
    }

    say_all = (self :: @Self, turn: WorkspaceTurn, uri: str,
               spots: Vec<Spot>, out :: String)
              Res<(), AllocError> {
        now ::= turn.temp.Vec<str>();
        uris_of(spots, now).try();
        self.say_one(turn, uri, spots, out).try();
        now.loop((h, u) {
            u.eq(uri).match({
                true  => written(),
                false => self.say_one(turn, u, spots, out),
            }).try();
        });
        self.take_back(turn, uri, now, spots, out).try();
        self.remember_showing(now).try();
        Ok(());
    }

    remember_showing = (self :: @Self, now: Vec<str>) Res<(), AllocError> {
        self.showing = self.a.Vec<str>();
        now.loop((h, u) {
            kept = own_str(self.a, u).try();
            self.showing.add(kept).try();
        });
        Ok(());
    }

    say_one = (self :: @Self, turn: WorkspaceTurn, uri: str,
               spots: Vec<Spot>, out :: String)
              Res<(), AllocError> {
        body ::= turn.temp.String().try();
        write_notification(turn.temp, uri, turn.text(uri), spots, body).try();
        self.said.get(uri).match({
            None     => self.send(turn.env, uri, body, out),
            Ok(prev) => prev.eq(body.view()).match({
                true  => written(),
                false => self.send(turn.env, uri, body, out),
            }),
        })
    }

    send = (self :: @Self, env: Env, uri: str, body: String, out :: String)
           Res<(), AllocError> {
        fresh_arena ::= env.mem.alloc();
        fresh       ::= fresh_arena.Map<str, str>();
        self.said.pairs((h, key, value) {
            (!key.eq(uri)).then(() {
                fresh.set(
                    own_str(fresh_arena, key).try(),
                    own_str(fresh_arena, value).try()
                ).try();
            });
        });
        fresh.set(
            own_str(fresh_arena, uri).try(),
            own_str(fresh_arena, body.view()).try()
        ).try();
        write_frame(body.view(), out).try();
        self.said_arena.drop();
        self.said_arena = consume fresh_arena;
        self.said       = fresh;
        Ok(())
    }

    take_back = (self :: @Self, turn: WorkspaceTurn, uri: str,
                 now: Vec<str>, spots: Vec<Spot>, out :: String)
                Res<(), AllocError> {
        self.showing.loop((h, u) {
            gone(u, uri, now).match({
                false => written(),
                true  => self.say_one(turn, u, spots, out),
            }).try();
        });
        Ok(());
    }
}

Diagnostics.impl(Drop, {
    drop = (self :: @Self) () {
        self.built.drop();
        self.said_arena.drop();
    }
})

Diagnostics* = (a: Alloc, env: Env) Diagnostics {
    said_arena ::= env.mem.alloc();
    diagnostics_with_said(a, env, consume said_arena)
}

diagnostics_with_said = (a: Alloc, env: Env, said_arena :: Arena)
                        Diagnostics {
    said = said_arena.Map<str, str>();
    Diagnostics(
        a: a,
        showing: a.Vec<str>(),
        closing: a.Vec<str>(),
        built: env.Built(),
        said_arena: consume said_arena,
        said: said
    )
}

gone = (u: str, uri: str, now: Vec<str>) bool {
    u.eq(uri).match({
        true  => false,
        false => now.find(
            (n) { n.eq(u) }
        ).match({ Ok(_) => false, None => true }),
    })
}

uris_of = (spots: Vec<Spot>, into :: Vec<str>) Res<(), AllocError> {
    spots.loop((h, s) {
        into.find((u) { u.eq(s.uri) }).match({
            Ok(_) => written(),
            None  => into.add(s.uri),
        }).try();
    });
    Ok(());
}

text_of = (env: Env, t: Alloc, uri: str, docs: Map<str, str>) str {
    docs.get(uri).match({
        Ok(text) => text,
        None     => on_disk(env, t, path_of(uri)),
    })
}

on_disk = (env: Env, t: Alloc, path: str) str {
    env.fs.read(t, path).match({
        Ok(text) => text.view(),
        Err(_)   => "",
    })
}

publish* = (a: Alloc, uri: str, text: str, spots: Vec<Spot>, out :: String)
           Res<(), AllocError> {
    body ::= a.String().try();
    write_notification(a, uri, text, spots, body).try();
    write_frame(body.view(), out)
}

write_notification = (
    a     : Alloc,
    uri   : str,
    text  : str,
    spots : Vec<Spot>,
    body  :: String
) Res<(), AllocError> {
    top ::= obj(body).try();
    top.text("jsonrpc", "2.0", body).try();
    top.text("method", "textDocument/publishDiagnostics", body).try();
    top.key("params", body).try();
    params ::= obj(body).try();
    params.text("uri", uri, body).try();
    params.key("diagnostics", body).try();
    items ::= arr(body).try();
    spots.loop((h, s) { one_of(a, s, uri, text, items, body).try(); });
    items.close(body).try();
    params.close(body).try();
    top.close(body)
}

one_of = (a: Alloc, s: Spot, uri: str, text: str, items :: Nest, out :: String)
         Res<(), AllocError> {
    s.uri.eq(uri).then(() { written_at(a, s, text, items, out).try(); });
    Ok(())
}

written_at = (a: Alloc, s: Spot, text: str, items :: Nest, out :: String)
             Res<(), AllocError> {
    items.next(out).try();
    write_spot(a, s, text, out)
}

write_spot = (a: Alloc, s: Spot, text: str, out :: String)
             Res<(), AllocError> {
    s.note.match({
        None  => write_plain_spot(a, s, text, out),
        Ok(_) => write_noted_spot(a, s, text, out),
    })
}

write_plain_spot = (a: Alloc, s: Spot, text: str, out :: String)
                   Res<(), AllocError> {
    encoded ::= Diagnostic(range: wire_range(text, s.span), severity: ERROR, source: "zen", message: s.message).to_json(a).try();
    out.add(encoded.view())
}

// relatedInformation is conditionally omitted, so the noted shape remains a
// streaming object until typed JSON gains an explicit omission policy.
write_noted_spot = (a: Alloc, s: Spot, text: str, out :: String)
                   Res<(), AllocError> {
    spot ::= obj(out).try();
    spot.key("range", out).try();
    write_range(a, text, s.span, out).try();
    spot.key("severity", out).try();
    out.write_usize(ERROR).try();
    spot.text("source", "zen", out).try();
    spot.text("message", s.message, out).try();
    write_note(a, s, text, spot, out).try();
    spot.close(out)
}

write_note = (
    a    : Alloc,
    s    : Spot,
    text : str,
    spot :: Nest,
    out  :: String
) Res<(), AllocError> {
    s.note.match({
        None  => written(),
        Ok(n) => write_related(a, s.uri, n, text, spot, out),
    })
}

write_related = (
    a    : Alloc,
    uri  : str,
    n    : Note,
    text : str,
    spot :: Nest,
    out  :: String
)
                Res<(), AllocError> {
    spot.key("relatedInformation", out).try();
    notes ::= arr(out).try();
    notes.next(out).try();
    note ::= obj(out).try();
    note.key("location", out).try();
    at ::= obj(out).try();
    at.text("uri", uri, out).try();
    at.key("range", out).try();
    write_range(a, text, n.span, out).try();
    at.close(out).try();
    note.text("message", n.message, out).try();
    note.close(out).try();
    notes.close(out)
}

// Parser and sema diagnostics are rejections; neither model has warning or
// informational variants to map onto another LSP severity.
ERROR*: usize = 1
