// std.sys.platform — host/target identity shared by builds and runtime code.
// The integer-valued foreign floor is stable; public code works with enums.
Os*: MacOS | Linux | Windows | FreeBSD | Other
Arch*: Arm64 | X86_64 | RiscV64 | Wasm32 | Other
Abi*: Darwin | Gnu | Musl | Msvc | Wasi | Other
Platform*: {
    os: Os,
    arch: Arch,
    abi: Abi,
}
platform = (os: Os, arch: Arch, abi: Abi) Platform {
    Platform(
        os: os,
        arch: arch,
        abi: abi,
    )
}
platform_macos* = (arch: Arch) Platform { platform(.MacOS, arch, .Darwin) }
platform_linux* = (arch: Arch, abi: Abi) Platform { platform(.Linux, arch, abi) }
zen_platform_host_os = () i32
zen_platform_host_arch = () i32
zen_platform_host_abi = () i32
platform_os = (n: i32) Os {
    (n == 1).match ({
        true  => .MacOS,
        false => (n == 2).match ({
            true  => .Linux,
            false => (n == 3).match ({
                true  => .Windows,
                false => (n == 4).match ({ true => .FreeBSD, false => .Other }),
            }),
        }),
    })
}
platform_arch = (n: i32) Arch {
    (n == 1).match ({
        true  => .Arm64,
        false => (n == 2).match ({
            true  => .X86_64,
            false => (n == 3).match ({
                true  => .RiscV64,
                false => (n == 4).match ({ true => .Wasm32, false => .Other }),
            }),
        }),
    })
}
platform_abi = (n: i32) Abi {
    (n == 1).match ({
        true  => .Darwin,
        false => (n == 2).match ({
            true  => .Gnu,
            false => (n == 3).match ({
                true  => .Musl,
                false => (n == 4).match ({
                    true  => .Msvc,
                    false => (n == 5).match ({ true => .Wasi, false => .Other }),
                }),
            }),
        }),
    })
}
host* = () Platform {
    Platform(
        os: platform_os(zen_platform_host_os()),
        arch: platform_arch(zen_platform_host_arch()),
        abi: platform_abi(zen_platform_host_abi()),
    )
}
