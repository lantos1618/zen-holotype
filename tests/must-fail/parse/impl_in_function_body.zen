// UNRESOLVED in DESIGN.md: `A.impl(B, {..})` is shown only at module
// level. in statement position it is a call expression that declares,
// and a declaration inside a body would have to say what its scope is.
Rect = {
    width: f64,
    height: f64,
}

Circle = { radius: f64 }

main = (env: Env) Res<i32, ArgError> {
    Circle.impl(Rect, {
        width: 2.0,
        height: 2.0,
    });
    Ok(0);
}
