// THE DEFAULT IS EMITTED IN DECLARATION ORDER, NOT APPENDED AT THE END.
//
// codegen/field_defaults.zen pins that a default is applied at all; this
// pins WHERE it lands when the omitted field is the LAST one and the
// supplied one comes first. `Tail(first: 7)` on `{ first :: i64 = 1,
// second :: i64 = 2 }` must read 7 then 2 -- a backend that builds the
// initialiser from the arguments alone writes {7} and lets C's rest-value
// zeroing answer for second, printing `7 0`: plausible output, wrong
// default. Same-type fields throughout, so no type error can flag the
// short list.
//
// The two-construction pair is the differential: `full` supplies both
// fields, `part` supplies only the first, and the ONLY thing distinguishing
// them is whether the default was written into the tail of part's
// initialiser.

Tail = {
    first :: i64 = 11,
    second :: i64 = 22,
}

main = (env: Env) Res<i32, AllocError> {
    full = Tail(first: 7, second: 8);
    println("full {} {}", full.first, full.second);

    part = Tail(first: 7);
    println("part {} {}", part.first, part.second);

    bare = Tail();
    println("bare {} {}", bare.first, bare.second);

    Ok(0);
}
