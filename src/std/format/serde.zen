// std.format.serde — jsony-style JSON serde as PURE LIBRARY CODE over struct reflection.
//
// `to_json(a, v)` serializes a struct — field names become JSON keys via `x.each_field(f)`
// (the lambda is spliced once per field, statically typed) — with NO per-type code: per-field
// serialization dispatches through `JsonWrite` impls on the scalar types (i32/i64/u8/f64/
// bool/StringView). `from_json(a, s, seed)` parses JSON back into a struct value by reusing
// std.format.json's parser and filling a COPY of `seed` field-by-field: an each_field lambda
// param substitutes to a real member PLACE, so `fv = fv.jr_scalar(x)` assigns the field.
//
// ── SHAPE: why flat/nested are SEPARATE entry points (found by bisection) ────────────────
// The one lambda body is type-checked once per field, so a single body cannot both dispatch
// a scalar field and recurse into a struct field:
//   * Scalar dispatch inside a splice is safe ONLY through a name owned purely by impls.
//     Adding a same-named free generic as a struct fallback poisons compilation: the two-pass
//     resolve→inline pipeline first inlines reflect bodies into every template that calls one
//     (flipping it into the always-splice class), then splices it at SCALAR fields too,
//     leaving a dead `each_field(<scalar>)` that fails validation (error[arg-type]) — or, on
//     the same-name-ladder variant, leaves bare un-emitted template calls (C link error).
//   * Struct recursion therefore rides LITERAL nesting: `to_json_nested` writes two object
//     levels with a nested `fv.each_field(...)` in the lambda — valid only when every root
//     field is itself a struct and every leaf field is a scalar (homogeneous levels).
// So: `to_json` = any FLAT struct (mixed scalar fields, generic instances included);
// `to_json_nested` = two homogeneous levels (root fields all structs of scalars). A struct
// mixing scalar and struct fields at one level is not expressible as library code today.
// One more rule: at most ONE plain generic may wrap a reflection generic (to_json wraps
// jw_obj1) — a second wrapper layer absorbs the intrinsic one pipeline pass too late and its
// calls die at link time.
//
// STRINGS are escaped minimally: backslash, quote, newline, tab. Numbers ride std.text.num's
// integer_in/float_in. OOM is a VALUE: every builder failure latches into the threaded `JwSt`
// state and surfaces as `to_json`'s `.Err`.
//
// Serde takes a concrete passable Allocator because reflected trait methods cannot be generic.
//
// from_json is LENIENT: a missing key or mismatched JSON kind keeps the seed's field value
// (the seed doubles as defaults); malformed JSON is the parser's `.Err(JsonError)`.
//
//   { to_json, from_json } = std.format.serde
//   da = heap_allocator()
//   to_json(da.addr(), Point(x: 3, y: 4))          // .Ok("{\"x\":3,\"y\":4}")
//   from_json(da.addr(), s, Point(x: 0, y: 0))     // .Ok(Point(x: 3, y: 4))
{ Result, Opt, IoError, ok, err } = std.core.result
{ String, new_in, push_in, append_slice_in, finish_in, free_in } = std.text.string
{ view } = std.text.str
{ integer_in, float_in } = std.text.num
{ Allocator } = std.mem.alloc
{ Value, JsonError, parse, get } = std.format.json
{ loop_at } = std.core.count
// ── writer state: a String builder + a latched first failure ─────────────────────────────
JwSt: {
    sb: String,
    failed: bool,
    eno: IoError,
}
jw_st = (sb: String) JwSt {
    JwSt(
        sb: sb,
        failed: false,
        eno: .Eof,
    )
}
jw_fail = (st: JwSt, e: IoError) JwSt {
    JwSt(
        sb: st.sb,
        failed: true,
        eno: e,
    )
}
jw_grew = (st: JwSt, sb: String) JwSt {
    JwSt(
        sb: sb,
        failed: false,
        eno: st.eno,
    )
}
jw_byte = (a: MutPtr<Allocator>, st: JwSt, b: u8) JwSt {
    st.failed.match ({
        true  => st,
        false => st.sb.push_in(a, b).match ({
            .Ok(s2) => st.jw_grew(s2),
            .Err(e) => st.jw_fail(e),
        }),
    })
}
jw_txt = (a: MutPtr<Allocator>, st: JwSt, t: StringView) JwSt {
    st.failed.match ({
        true  => st,
        false => a.append_slice_in(st.sb, t.view()).match ({
            .Ok(s2) => st.jw_grew(s2),
            .Err(e) => st.jw_fail(e),
        }),
    })
}
// append an OWNED formatted temp (integer_in/float_in result), then release it.
jw_owned = (a: MutPtr<Allocator>, st: JwSt, r: Result<String, IoError>) JwSt {
    st.failed.match ({
        true  => st,
        false => r.match ({
            .Ok(t)  => {
                out = a.append_slice_in(st.sb, t.bytes()).match ({
                    .Ok(s2) => st.jw_grew(s2),
                    .Err(e) => st.jw_fail(e),
                })
                t.free_in(a)
                out
            },
            .Err(e) => st.jw_fail(e),
        }),
    })
}
jw_int = (a: MutPtr<Allocator>, st: JwSt, n: i64) JwSt { a.jw_owned(st, a.integer_in(n)) }
jw_f64 = (a: MutPtr<Allocator>, st: JwSt, x: f64) JwSt { a.jw_owned(st, a.float_in(x)) }
jw_bool = (a: MutPtr<Allocator>, st: JwSt, b: bool) JwSt {
    b.then({ a.jw_txt(st, "true") }, { a.jw_txt(st, "false") })
}
// ── minimal string escaping: backslash, quote, newline, tab ──────────────────────────────
// Deliberately NOT std.text.ascii.escape_into (the per-byte scan the backends/formatter share):
// this loop folds the error-carrying JwSt state (sticky-Err builder), not a bare string builder.
jw_esc_needed = (b: u8) bool { b == '"' || b == '\\' || b == '\n' || b == '\t' }
jw_esc = (a: MutPtr<Allocator>, st: JwSt, b: u8) JwSt {
    out = a.jw_byte(st, '\\')
    (b == '"').match ({
        true  => a.jw_byte(out, '"'),
        false => (b == '\\').match ({
            true  => a.jw_byte(out, '\\'),
            false => (b == '\n').then({ a.jw_byte(out, 'n') }, { a.jw_byte(out, 't') }),
        }),
    })
}
jw_str = (a: MutPtr<Allocator>, st: JwSt, s: StringView) JwSt {
    out ::= a.jw_byte(st, '"')
    sv = s.view()
    sv.loop_at((i, b) {
        b.jw_esc_needed().match ({
            true  => {
                out = a.jw_esc(out, b)
            },
            false => {
                out = a.jw_byte(out, b)
            },
        })
    })
    a.jw_byte(out, '"')
}
// one "key": prefix (comma-separated), shared by both writers.
jw_key = (a: MutPtr<Allocator>, st: JwSt, name: StringView, first: bool) JwSt {
    out = first.then({ st }, { a.jw_byte(st, ',') })
    a.jw_byte(a.jw_str(out, name), ':')
}
// ── scalar dispatch: `JsonWrite` impls ONLY — no free fallback generic may share this
// name (see header). A struct field reaching `jw_scalar` is a compile error by design.
JsonWrite: {
    jw_scalar: (value: Self, allocator: MutPtr<Allocator>, state: JwSt) JwSt,
}
i64.impl(JsonWrite, {
    jw_scalar = (v: i64, a: MutPtr<Allocator>, st: JwSt) JwSt { a.jw_int(st, v) }
})
i32.impl(JsonWrite, {
    jw_scalar = (v: i32, a: MutPtr<Allocator>, st: JwSt) JwSt { a.jw_int(st, to_i64(v)) }
})
u8.impl(JsonWrite, {
    jw_scalar = (v: u8, a: MutPtr<Allocator>, st: JwSt) JwSt { a.jw_int(st, to_i64(v)) }
})
f64.impl(JsonWrite, {
    jw_scalar = (v: f64, a: MutPtr<Allocator>, st: JwSt) JwSt { a.jw_f64(st, v) }
})
bool.impl(JsonWrite, {
    jw_scalar = (v: bool, a: MutPtr<Allocator>, st: JwSt) JwSt { a.jw_bool(st, v) }
})
StringView.impl(JsonWrite, {
    jw_scalar = (v: StringView, a: MutPtr<Allocator>, st: JwSt) JwSt { a.jw_str(st, v) }
})
// ── object writers (reflection generics; always inlined at call sites) ───────────────────
// flat: every field is a scalar.
jw_obj1<T> = (v: T, a: MutPtr<Allocator>, st: JwSt) JwSt {
    out ::= a.jw_byte(st, '{')
    first :: bool = true
    v.each_field((name, fv) {
        out = a.jw_key(out, name, first)
        first = false
        out = fv.jw_scalar(a, out)
    })
    a.jw_byte(out, '}')
}
// nested: every root field is a struct whose fields are all scalars (literal 2-level
// unroll — a CALL to jw_obj1 here would leave an unlowered lambda in the generated C;
// nested reflection must be written as literal nested each_field).
jw_obj2<T> = (v: T, a: MutPtr<Allocator>, st: JwSt) JwSt {
    out ::= a.jw_byte(st, '{')
    first :: bool = true
    v.each_field((name, fv) {
        out = a.jw_key(out, name, first)
        first = false
        out = a.jw_byte(out, '{')
        first2 :: bool = true
        fv.each_field((n2, fv2) {
            out = a.jw_key(out, n2, first2)
            first2 = false
            out = fv2.jw_scalar(a, out)
        })
        out = a.jw_byte(out, '}')
    })
    a.jw_byte(out, '}')
}
// ── public serialize ─────────────────────────────────────────────────────────────────────
// finish: unwrap the writer state into the public Result.
jw_done = (a: MutPtr<Allocator>, st: JwSt) Result<StringView, IoError> {
    st.failed.match ({
        true  => err(st.eno),
        false => st.sb.finish_in(a).match ({
            .Ok(cs) => ok(cs),
            .Err(e) => err(e),
        }),
    })
}
// Serialize a FLAT struct (scalar fields only) to compact JSON text.
to_json*<T> = (a: MutPtr<Allocator>, v: T) Result<StringView, IoError> {
    out: Result<StringView, IoError> = a.new_in().match ({
        .Err(e) => .Err(e),
        .Ok(sb) => a.jw_done(v.jw_obj1(a, jw_st(sb))),
    })
    out
}
// Serialize a 2-level struct (every root field a struct of scalars) to compact JSON text.
to_json_nested*<T> = (a: MutPtr<Allocator>, v: T) Result<StringView, IoError> {
    out: Result<StringView, IoError> = a.new_in().match ({
        .Err(e) => .Err(e),
        .Ok(sb) => a.jw_done(v.jw_obj2(a, jw_st(sb))),
    })
    out
}
// ── scalar readers: `JsonRead` impls ONLY (same no-free-fallback rule as JsonWrite) ──────
JsonRead: {
    jr_scalar: (seed: Self, value: Value) Self,
}
// `.Int` is the exact integer json.parse produces for a fraction-less token; `.Num` is still accepted
// (a field written `2.0` or `2e1`) and truncates, as it always did.
jv_i64 = (v: i64, jv: Value) i64 {
    jv.match ({
        .Int(i) => i,
        .Num(n) => to_i64(n),
        _       => v,
    })
}
i64.impl(JsonRead, {
    jr_scalar = (v: i64, jv: Value) i64 { v.jv_i64(jv) }
})
i32.impl(JsonRead, {
    jr_scalar = (v: i32, jv: Value) i32 { to_i32(jv_i64(to_i64(v), jv)) }
})
u8.impl(JsonRead, {
    jr_scalar = (v: u8, jv: Value) u8 { to_u8(jv_i64(to_i64(v), jv)) }
})
f64.impl(JsonRead, {
    jr_scalar = (v: f64, jv: Value) f64 {
        jv.match ({
            .Int(i) => to_f64(i),    // hand-written JSON may spell a float field `3`; to_json writes `3.0`
            .Num(n) => n,
            _       => v,
        })
    }
})
bool.impl(JsonRead, {
    jr_scalar = (v: bool, jv: Value) bool {
        jv.match ({
            .Bool(b) => b,
            _        => v,
        })
    }
})
StringView.impl(JsonRead, {
    jr_scalar = (v: StringView, jv: Value) StringView {
        jv.match ({
            .Str(s) => s,
            _       => v,
        })
    }
})
// a member lookup collapsed to a Value: missing key → .Null (the lenient scalar readers
// keep the seed's value on .Null). Keeps `.match` OUT of the reflect lambdas below — a
// reflect call inside a match ARM is silently left unexpanded (unlowered-lambda C error).
jv_or_null = (o: Opt<Value>) Value {
    out: Value = o.match ({
        .Some(x) => x,
        .None    => .Null,
    })
    out
}
// ── object readers: fill a copy of the seed from a parsed Value tree ─────────────────────
// `w = v` copies the seed; the each_field lambda param `fv` substitutes to a member PLACE
// of `w`, so `fv = fv.jr_scalar(x)` assigns the copy's field.
jr_obj1<T> = (v: T, jv: Value) T {
    w ::= v
    w.each_field((name, fv) { fv = fv.jr_scalar(jv.get(name).jv_or_null()) })
    w
}
// NOTE: a nested `fv.each_field(...)` cannot WRITE leaf fields directly — a non-Var
// reflection subject (the member expr `w.<field>`) is temp-bound once, so inner
// assignments land in the discarded temp. And delegating to jr_obj1 here leaves an
// unlowered lambda in the generated C. The shape that works: copy the field to a LOCAL
// (a Var subject is spliced unbound), fill the local's fields, assign the struct back
// whole (a level-1 member place assignment, which does stick).
jr_obj2<T> = (v: T, jv: Value) T {
    w ::= v
    w.each_field((name, fv) {
        x = jv.get(name).jv_or_null()
        leaf ::= fv
        leaf.each_field((n2, fv2) { fv2 = fv2.jr_scalar(x.get(n2).jv_or_null()) })
        fv = leaf
    })
    w
}
// ── public deserialize ───────────────────────────────────────────────────────────────────
// Parse `s` and fill a copy of `seed` (flat struct). Parsed strings are allocator-owned
// copies (std.format.json's memory policy).
from_json*<T> = (a: MutPtr<Allocator>, s: StringView, seed: T) Result<T, JsonError> {
    out: Result<T, JsonError> = a.parse(s).match ({
        .Err(e) => .Err(e),
        .Ok(jv) => .Ok(seed.jr_obj1(jv)),
    })
    out
}
// Parse `s` and fill a copy of `seed` (2-level struct, same shape rule as to_json_nested).
// The jr_obj2 logic is REPEATED inline here rather than delegated: a nested each_field on
// a local only expands when its enclosing generic contains the intrinsic DIRECTLY (one
// splice layer). Wrapped in a second generic, the inner receiver's let is renamed across
// two inline passes and the expansion is silently dropped (unlowered-lambda C error).
from_json_nested*<T> = (a: MutPtr<Allocator>, s: StringView, seed: T) Result<T, JsonError> {
    perr :: JsonError = .UnexpectedEof
    got :: bool = false
    jv :: Value = .Null
    a.parse(s).match ({
        .Ok(v0) => {
            jv = v0
            got = true
        },
        .Err(e) => {
            perr = e
        },
    })
    // on parse failure jv is .Null: the fill below is a harmless no-op (seed survives).
    w ::= seed
    w.each_field((name, fv) {
        x = jv.get(name).jv_or_null()
        leaf ::= fv
        leaf.each_field((n2, fv2) { fv2 = fv2.jr_scalar(x.get(n2).jv_or_null()) })
        fv = leaf
    })
    out: Result<T, JsonError> = got.then({ .Ok(w) }, { .Err(perr) })
    out
}
