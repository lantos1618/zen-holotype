// SHIFT BY width-1 ON AN UNSIGNED OPERAND KEEPS EXACTLY THE TOP BIT.
//
// `3 *% 128` on a u8 moves the 1 into bit 7 and stops there: the answer
// is 128, not 0 and not 384-folded. This is the widest shift an unsigned
// type can take without losing its operand, and it sits exactly where
// three classic bugs land:
//
//   - "the shift count is the WIDTH, not width-1" — an off-by-one in the
//     constant table — answers 0 (3<<8 vanishes) while this line stays
//     green only if the table is right;
//   - promoting the operand to int and shifting THERE, then storing back,
//     answers 384 % 256 = 128 here but breaks every wider twin below;
//   - a signed read of the result prints -128 for u8 and -32768 for u16:
//     the top-bit line is where signed and unsigned readings disagree,
//     so both readings are printed side by side on purpose.
//
// each row pairs the narrow answer with the SAME shift on the next width
// up (u16 by 15, u32 by 31, u64 by 63). A backend that shifts everything
// at 32 bits truncates the u64 row; one that shifts at the OPERAND'S
// width gets every number below.
//
// one-line break: index the per-width shift constant by BITS instead of
// BITS-1 (or widen the store slot past the operand's own width) and the
// narrow columns flip sign while the wide ones go to zero.

main = (env: Env) Res<i32, AllocError> {
    b8:  u8  = 3;
    b16: u16 = 3;
    b32: u32 = 3;
    b64: u64 = 3;

    n8:  u8  = 128;
    n16: u16 = 32768;
    n32: u32 = 2147483648;
    n64: u64 = 9223372036854775808;

    println("u8 {}", b8 *% n8);
    println("u16 {}", b16 *% n16);
    println("u32 {}", b32 *% n32);
    println("u64 {}", b64 *% n64);

    // base 4 puts a second bit at the boundary: 4*128 folds to 0, and a
    // backend that keeps the fold in a wider slot prints 512 -- the
    // truncation this file exists to catch, printed as a number.
    println("fold {}", b8.to_u16() *% 128);

    Ok(0);
}
