{ to_exit } = std.core.bool
{ String, new_in } = std.text.string
{ expect } = std.core.result
alloc = std.mem.heap
push_byte<A> = (s: String, a: MutPtr<A>, v: u8) String { s.push_in(a, v).expect("push").push_in(a, v).expect("push") }
build<A> = (a: MutPtr<A>) string_view { a.new_in().expect("new_in").push_byte(a, 'x').push_byte(a, 'x').push_byte(a, 'x').push_byte(a, 'x').push_byte(a, 'x').push_byte(a, 'x').push_byte(a, 'x').push_byte(a, 'x').finish_in(a).expect("finish") }
main = () i32 {
    heap := alloc.gpa()
    s := build(heap.addr())
    (s.len() == 16).to_exit()
}
