// tests/corpus/traps/vec_get_out_of_range.zen
// Vec.get out of range returns None and does NOT trap. a lookup that
// can legitimately miss is not a bug, so it is a Res - this is the
// contrast that makes the fixed-array trap legible

// main must name an error type. a trap never lifts into Res:
// it aborts the process
Error =
    Overflow,
    DivideByZero,
    OutOfBounds

main = (env: Env) Res<i32, Error> {
    alloc ::= env.mem.alloc();
    v ::= alloc.Vec<i32>();
    v.add(7).match({
        Ok(_)  => println("added"),
        Err(_) => println("add failed"),
    })
    v.get(3).match({
        Ok(n) => println("{}", n),
        None  => println("none"),
    })
    Ok(0);
}
