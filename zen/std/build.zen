// std.build — project builds expressed as allocator-free Zen values.
// Lists are borrowed slices supplied by the build program, so multiple native
// sources/frameworks/libraries need no hidden builder heap.
{ print, println } = std.text.fmt

BuildOs*: MacOS | Linux | Other

// Implemented by zenrt.c: 1 macOS, 2 Linux, 0 other.
zen_build_host_os = () i32

build_host_os* = () BuildOs {
    zen_build_host_os().match ({ 1 => .MacOS, 2 => .Linux, _ => .Other })
}

Build*: {
    os_: BuildOs,
    os = (b: Build) BuildOs { b.os_ }
}

Target*: {
    name: string_view,
    root_: string_view,
    main_: string_view,
    out_: string_view,
    links_: string_view,
    sources_: [string_view],
    frameworks_: [string_view],
    libraries_: [string_view],

    root = (t: Target, p: string_view) Target { Target(name: t.name, root_: p, main_: t.main_, out_: t.out_, links_: t.links_, sources_: t.sources_, frameworks_: t.frameworks_, libraries_: t.libraries_) }
    main = (t: Target, p: string_view) Target { Target(name: t.name, root_: t.root_, main_: p, out_: t.out_, links_: t.links_, sources_: t.sources_, frameworks_: t.frameworks_, libraries_: t.libraries_) }
    out = (t: Target, p: string_view) Target { Target(name: t.name, root_: t.root_, main_: t.main_, out_: p, links_: t.links_, sources_: t.sources_, frameworks_: t.frameworks_, libraries_: t.libraries_) }

    // Legacy single-library setter. Prefer `.libraries(["pthread", ...])`.
    links = (t: Target, l: string_view) Target { Target(name: t.name, root_: t.root_, main_: t.main_, out_: t.out_, links_: l, sources_: t.sources_, frameworks_: t.frameworks_, libraries_: t.libraries_) }
    sources = (t: Target, xs: [string_view]) Target { Target(name: t.name, root_: t.root_, main_: t.main_, out_: t.out_, links_: t.links_, sources_: xs, frameworks_: t.frameworks_, libraries_: t.libraries_) }
    frameworks = (t: Target, xs: [string_view]) Target { Target(name: t.name, root_: t.root_, main_: t.main_, out_: t.out_, links_: t.links_, sources_: t.sources_, frameworks_: xs, libraries_: t.libraries_) }
    libraries = (t: Target, xs: [string_view]) Target { Target(name: t.name, root_: t.root_, main_: t.main_, out_: t.out_, links_: t.links_, sources_: t.sources_, frameworks_: t.frameworks_, libraries_: xs) }

    emit_spec = (t: Target) void {
        // Six fixed lines: name, root, main, out, linker flags, compiler inputs.
        println(t.name)
        println(t.root_)
        println(t.main_)
        println(t.out_)
        (t.links_ != "").match ({ true => { print("-l") print(t.links_) print(" ") }, false => { } })
        t.libraries_.loop((h, i, lib) { print("-l") print(lib) print(" ") })
        t.frameworks_.loop((h, i, framework) { print("-framework ") print(framework) print(" ") })
        println("")
        t.sources_.loop((h, i, source) { print(source) print(" ") })
        println("")
    }
}

exe* = (name: string_view) Target {
    empty: [string_view] := []
    Target(name: name, root_: "", main_: "", out_: "", links_: "pthread", sources_: empty, frameworks_: empty, libraries_: empty)
}
