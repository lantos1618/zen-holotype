// a comment as the ONLY content of a block, twice: a bare block and a
// closure body. both evaluate to ().

main = (env: Env) Res<i32, ArgError> {
    {
        // the only content of this block
    }

    n = 1;
    (n == 0).then(() {
        // the only content of this closure
    });

    println("{}", (n + 6) * 7 - 4);
    Ok(0);
}
