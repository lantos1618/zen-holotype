// src/gen/gen_c/gen_c_display.zen
// A value that prints itself, and the console it prints into.
//
// `toString` writes into a SINK, not a `String`: a `String` needs an
// `Alloc` to grow and `println` has no `Alloc`, so a buffer-returning
// `toString` would either allocate behind the caller's back (law 1) or
// make hello-world take an arena. A console is a sink already, so
// printing never allocates.
//
// The console is the one fat value the print path constructs — see
// `gen_c_fat.zen` for the record layout; this file only fills the slots
// with `gen_c_runtime.zen`'s writes. `zg_self` is NULL: stdout is not a
// value the program owns.
//
// The call is resolved statically, like `==` through `Eq`: the
// argument's type is known, so the impl's function is called directly
// and no record takes part. A fat value is built only where the
// DESTINATION's static type is the bound — here, the sink.

ExprId, Member, MemberKind, Function = std.ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
TyId = sema.sema_ty
Def = sema.sema_def
Checker = sema.sema_check
sym_variant, RES_PATH = gen.gen_name
CBackend = gen.gen_c.gen_c_state
ctype, request_type = gen.gen_c.gen_c_type
recv_inst = gen.gen_c.gen_c_mono
Site, site_of, member_at = gen.gen_c.gen_c_member
impl_member_of, by_arity = gen.gen_c.gen_c_impl
by_ref = gen.gen_c.gen_c_call
method_sig, member_symbol = gen.gen_c.gen_c_member
Slot, slots_of, thunk_param = gen.gen_c.gen_c_fat

// -----------------------------------------------------------------
// the call
// -----------------------------------------------------------------

// `<the value>.toString(<the console>);` — `true` when written, `false`
// when the type has no `toString`, which the caller diagnoses.
console_display* = (be :: CBackend, ty: TyId, text: str)
                   Res<bool, AllocError> {
    site_of(be, ty).try().match({
        None  => Ok(false),
        Ok(s) => display_at_site(be, ty, s, text),
    })
}

display_at_site = (be :: CBackend, ty: TyId, s: Site, text: str)
                  Res<bool, AllocError> {
    display_fn(be, s).try().match({
        None  => Ok(false),
        Ok(f) => write_display_call(be, ty, s, f, text),
    })
}

// The type's own `toString` first, then what an impl supplies — the
// order `sema_supply.zen` states. Arity two: `Display` declares two
// `toString`s, and only the sink-taking one can write into a console.
display_fn = (be :: CBackend, s: Site) Res<Res<Function>, AllocError> {
    found ::= be.alloc.Vec<Member>();
    member_at(be, s, "toString", found).try();
    sink_form(be, found).match({
        Ok(f) => Ok(Ok(f)),
        None  => impl_member_of(be, s.decl, "toString", 2),
    })
}

sink_form = (be: CBackend, found: Vec<Member>) Res<Function> {
    (found.len > 0).match({
        false => None,
        true  => member_function(by_arity(be, found, 2)),
    })
}

member_function = (m: Res<Member>) Res<Function> {
    m.match({
        None    => None,
        Ok(one) => one.kind.match({ Function(f) => Ok(f), _ => None }),
    })
}

// `self: @Self` takes the receiver by value, matching `display.zen`:
// `toString` writes a value out, it does not change it. A `::` receiver
// needs an address this path lacks, so it is refused, not guessed at.
write_display_call = (
    be   :: CBackend,
    ty   : TyId,
    s    : Site,
    f    : Function,
    text : str
) Res<bool, AllocError> {
    by_ref(f, 0).match({
        true  => Ok(false),
        false => with_console(be, ty, s, f, text),
    })
}

with_console = (be :: CBackend, ty: TyId, s: Site, f: Function, text: str)
               Res<bool, AllocError> {
    sink ::= be.alloc.String().try();
    console_sink(be, sink).try().match({
        false => Ok(false),
        true  => emit_display(be, ty, s, f, text, sink.view()),
    })
}

// The result is discarded here: `zg_print_bytes` cannot fail and a
// console cannot fail to grow, so `println`'s value is unit. A BUFFER
// sink needs the answer instead — see `sink_display` below.
emit_display = (
    be   :: CBackend,
    ty   : TyId,
    s    : Site,
    f    : Function,
    text : str,
    sink : str
) Res<bool, AllocError> {
    line ::= be.alloc.String().try();
    line.add_bytes("(void)").try();
    display_call(be, ty, s, f, text, sink, line).try();
    line.add_bytes(";").try();
    be.writeln(line.view()).try();
    Ok(true);
}

// `<value>.toString(<sink>)` as an EXPRESSION: `gen_c_sink.zen`'s `{}`
// on a Display is this call with the door's buffer standing in for the
// console. `false` when the type has no `toString`.
sink_display* = (
    be   :: CBackend,
    ty   : TyId,
    text : str,
    sink : str,
    out  :: String
) Res<bool, AllocError> {
    site_of(be, ty).try().match({
        None  => Ok(false),
        Ok(s) => sink_display_at(be, ty, s, text, sink, out),
    })
}

sink_display_at = (
    be   :: CBackend,
    ty   : TyId,
    s    : Site,
    text : str,
    sink : str,
    out  :: String
) Res<bool, AllocError> {
    display_fn(be, s).try().match({
        None  => Ok(false),
        Ok(f) => sink_display_fn(be, ty, s, f, text, sink, out),
    })
}

sink_display_fn = (
    be   :: CBackend,
    ty   : TyId,
    s    : Site,
    f    : Function,
    text : str,
    sink : str,
    out  :: String
)
                  Res<bool, AllocError> {
    by_ref(f, 0).match({
        true  => Ok(false),
        false => wrote_display(be, ty, s, f, text, sink, out),
    })
}

wrote_display = (
    be   :: CBackend,
    ty   : TyId,
    s    : Site,
    f    : Function,
    text : str,
    sink : str,
    out  :: String
) Res<bool, AllocError> {
    display_call(be, ty, s, f, text, sink, out).try();
    Ok(true);
}

// The symbol, instantiation and queue entry `p.toString(sb)` would
// produce, so the console and buffer paths agree on which function is meant.
display_call = (
    be   :: CBackend,
    ty   : TyId,
    s    : Site,
    f    : Function,
    text : str,
    sink : str,
    out  :: String
) Res<(), AllocError> {
    inst = recv_inst(be, ty).try();
    sig ::= be.alloc.Vec<TyId>();
    method_sig(be, ty, s.decl, f, s.decl.module.to_usize(), inst, sig).try();
    sym = member_symbol(be, ty, s, "toString", sig, inst).try();
    out.add_bytes(sym.view()).try();
    out.add_bytes("(").try();
    out.add_bytes(text).try();
    out.add_bytes(", ").try();
    write_sink_arg(f, sink, out).try();
    out.add_bytes(")").try();
    Ok(());
}

// `out :: Sink` takes the record BY ADDRESS, and a C compound literal is
// an lvalue holding the enclosing block's storage — so the console
// outlives the call it is written into and nothing is copied.
write_sink_arg = (f: Function, sink: str, out :: String)
                 Res<(), AllocError> {
    by_ref(f, 1).then(() { out.add_bytes("&").try() });
    out.add_bytes(sink).try();
    Ok(());
}

// -----------------------------------------------------------------
// the console, as a Sink
//
// The slots are written HERE, not found: `Console.println` has no body
// because the runtime IS the implementation. A capability's floor is
// the target language's; for C, that's `fwrite`.
// -----------------------------------------------------------------

console_sink* = (be :: CBackend, out :: String) Res<bool, AllocError> {
    sink_ty(be).try().match({
        None   => Ok(false),
        Ok(ty) => write_console(be, ty, out),
    })
}

// `Sink` as the prelude exports it. Reached by declaration and not
// through the caller's imports, because the record is the backend's: a
// caller that wrote `println("{}", p)` never named it.
sink_ty = (be :: CBackend) Res<Res<TyId>, AllocError> {
    defs ::= be.alloc.Vec<Def>();
    be.check.world.prelude_of("Sink", defs).try();
    defs.get(0).match({
        None  => Ok(None),
        Ok(d) => sink_named(be, d),
    })
}

sink_named = (be :: CBackend, d: Def) Res<Res<TyId>, AllocError> {
    args ::= be.alloc.Vec<TyId>();
    Ok(Ok(be.check.types.named(d.id, d.qname, d.name, args).try()));
}

// A slot with no runtime write leaves the whole record unavailable.
// `gen_c_fat.zen` NULLs an unanswered slot, fine for an unused hook like
// `Alloc.create` — but a console slot is called on the first `{}`, so a
// NULL there would link and crash, worse than a diagnostic.
write_console = (be :: CBackend, ty: TyId, out :: String)
                Res<bool, AllocError> {
    be.need_print();
    request_type(be, ty).try();
    slots ::= be.alloc.Vec<Slot>();
    slots_of(be, ty, slots).try();
    body  ::= be.alloc.String().try();
    known ::= slots.len > 0;
    slots.loop((h, s) {
        console_slot(be, s, body).try().then(() { known = false; });
    });
    known.match({
        false => Ok(false),
        true  => finish_console(be, ty, body.view(), out),
    })
}

finish_console = (be :: CBackend, ty: TyId, inits: str, out :: String)
                 Res<bool, AllocError> {
    out.add_bytes("((").try();
    ctype(be, ty, out).try();
    out.add_bytes("){ .zg_self = NULL").try();
    out.add_bytes(inits).try();
    out.add_bytes(" })").try();
    Ok(true);
}

// `true` when this backend has no write for the slot.
console_slot = (be :: CBackend, s: Slot, out :: String)
               Res<bool, AllocError> {
    console_body(s.name).is_empty().match({
        true  => Ok(true),
        false => write_slot_init(be, s, out),
    })
}

write_slot_init = (be :: CBackend, s: Slot, out :: String)
                  Res<bool, AllocError> {
    name ::= be.alloc.String().try();
    console_name(name, s.name).try();
    need_console_fn(be, s, name.view()).try();
    out.add_bytes(", .").try();
    out.add_bytes(s.sym.view()).try();
    out.add_bytes(" = ").try();
    out.add_bytes(name.view()).try();
    Ok(false);
}

// Named after the member it answers, so two requests for one slot share
// one function — the same rule `gen_c_fat.zen`'s thunks follow.
console_name = (out :: String, member: str) Res<(), AllocError> {
    out.add_bytes("zg_console_").try();
    out.add_bytes(member).try();
    Ok(());
}

// The one statement a console slot is. Empty means this backend has no
// write for that member of `Sink`.
console_body = (member: str) str {
    member.eq("write").match({
        true  => "zg_print_str(zg_a0);",
        false => byte_body(member),
    })
}

// A BYTE HAS NO `str` TO POINT AT — `io.zen` says why the floor is two
// calls wide — so it is written from the parameter's own storage. One
// byte, no copy and no buffer.
byte_body = (member: str) str {
    member.eq("write_byte").match({
        true  => "zg_print_bytes((const char *)&zg_a0, 1);",
        false => "",
    })
}

need_console_fn = (be :: CBackend, s: Slot, name: str)
                  Res<(), AllocError> {
    be.need_thunk(name).try().match({
        false => Ok(()),
        true  => emit_console_fn(be, s, name),
    })
}

// A console cannot fail to grow and `zg_print_bytes` cannot fail, so the
// honest answer is `Ok` — a tag, no `()` payload storage.
//
// A lowered function is held as a head with no punctuation and a body
// that is only statements; `gen_c_decl.zen` writes the `;`/braces, so
// one that carried either would get a second.
emit_console_fn = (be :: CBackend, s: Slot, name: str)
                  Res<(), AllocError> {
    head ::= be.alloc.String().try();
    console_head(be, s, name, head).try();
    body ::= be.alloc.String().try();
    body.add_bytes("    (void)zg_self;\n    ").try();
    body.add_bytes(console_body(s.name)).try();
    body.add_bytes("\n    return (").try();
    ctype(be, s.ret, body).try();
    body.add_bytes("){ .zg_tag = ").try();
    sym_variant(body, RES_PATH, "Ok").try();
    body.add_bytes(" };\n").try();
    owned ::= be.alloc.String().try();
    owned.add_bytes(name).try();
    be.add_function(owned, head, body)
}

console_head = (be :: CBackend, s: Slot, name: str, out :: String)
               Res<(), AllocError> {
    out.add_bytes("static ").try();
    ctype(be, s.ret, out).try();
    out.add_bytes(" ").try();
    out.add_bytes(name).try();
    out.add_bytes("(void *zg_self").try();
    s.params.loop((h, i, p) { thunk_param(be, p, "a", i, out).try() });
    out.add_bytes(")").try();
    Ok(());
}
