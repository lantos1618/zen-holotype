// THE THIRD FACE OF ISSUE 738: the bare head written DIRECTLY as a call
// argument, with no local and no annotation anywhere. `Opt.None` answers
// the bare enum (`variant_value`, sema_static.zen) and `args_agree`
// (sema_check.zen) answered true to every arity mismatch, so overload
// resolution married the bare head to `pick`'s `Opt<i32>` on a guess --
// the guess happened to be right here, but it is the same lie that sent
// `x = Opt.None; pick(x)` to cc as two different structs. Nobody wrote
// `Opt.None`'s arguments, so nobody can claim them at the boundary:
// the call falls out of `assignable` and the existing resolution
// diagnostic names it. Write the annotation first
// (`none: Opt<i32> = Opt.None`) and the call is accepted again.
//
// position: the argument carrying no answer.
//
// MUST FAIL: accepted on clean main -- it compiled there and printed 0,
// right by luck -- refused once the arity rule stopped guessing.

Opt<T> = Some(T) | None

pick = (o: Opt<i32>) i32 { o.match({ Some(v) => v, None => 0 }) }

main = (env: Env) Res<i32, AllocError> {
    println("{}", pick(Opt.None));
    Ok(0);
}
