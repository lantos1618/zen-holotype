// std.web.dom — the WEB-platform binding surface: the browser DOM as typed Zen declarations.
//
// This file is to a future `genjs` backend exactly what std.c.libc is to `genc`: a header of
// BODYLESS declarations (a `[Decl]` surface) that the code generator lowers to native platform
// calls. genc turns a bodyless `name = (params) Ret` into a bare C prototype and libc defines the
// symbol; genjs will turn these same bodyless decls into JavaScript member access / method calls on
// the live browser objects (`document`, `Element`, `Event`, …) that the runtime already provides.
// Nothing here is re-implemented in Zen — the browser IS the implementation. So every fn below is a
// STUB: a typed name with no body. It PARSES and `zenc check`s as ordinary Zen today (verified), even
// though genjs does not exist yet; for now it is purely the type surface the web target will consume.
//
// ── DESIGN: opaque handles + upcast stubs (because Zen has no inheritance and no overloading) ──────
// The DOM is a single-inheritance tree — EventTarget ← Node ← Element ← HTMLElement, etc. Zen has
// neither subtyping NOR function overloading (the flat UFCS namespace holds each method name exactly
// ONCE). So we cannot declare `add_event_listener` on both `EventTarget` and `Element`, nor make an
// `Element` transparently usable where a `Node` is expected. The model instead is:
//   • each DOM interface = a distinct OPAQUE HANDLE struct `{ handle: RawPtr<u8> }` (the JS object ref).
//   • each method is declared EXACTLY ONCE, on the interface that MDN says introduces it.
//   • the inheritance edges are expressed as `as_*` UPCAST stubs (`el.as_node()`, `el.as_event_target()`).
//     In JavaScript an Element already *is* a Node, so genjs lowers every upcast to the IDENTITY (a
//     no-op cast) — it exists only to satisfy Zen's type checker and to route UFCS to the base method.
// So the idiomatic call for an inherited method is `el.as_event_target().add_event_listener(...)`.
//
// ── DESIGN: JS globals as zero-arg accessor stubs ─────────────────────────────────────────────────
// `document`, `window`, and `console` are ambient JS singletons, not values you thread around. We model
// each as a bodyless zero-arg accessor returning its handle — `document()`, `window()`, `console()` —
// which genjs lowers to the bare global identifier (`document()` → `document`). This keeps them out of
// every signature while staying UFCS-friendly: `document().get_element_by_id("app")`,
// `console().log("hi")`. (An alternative — module-level handle constants — cannot express "read the
// live global at use site", so accessor stubs are the honest choice.)
//
// This module imports ONLY `Opt` (for lookups that can miss); RawPtr / str / bool / i32 / f64 / void
// are builtins. It declares no runtime state, so importing it pulls in nothing and affects nothing
// until genjs consumes it.
{ Opt } = std.core.result
// ── Interface handles (the DOM inheritance tree, flattened to opaque JS object refs) ───────────────
// EventTarget ← Node ← Element ← HTMLElement ;  Node ← Text ;  Node ← Document ;  EventTarget ← Window.
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/EventTarget
EventTarget*: {
    handle: RawPtr<u8>,
}
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Node
Node*: {
    handle: RawPtr<u8>,
}
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Element
Element*: {
    handle: RawPtr<u8>,
}
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/HTMLElement
HTMLElement*: {
    handle: RawPtr<u8>,
}
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Text
Text*: {
    handle: RawPtr<u8>,
}
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Document
Document*: {
    handle: RawPtr<u8>,
}
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Window
Window*: {
    handle: RawPtr<u8>,
}
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Event
Event*: {
    handle: RawPtr<u8>,
}
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/NodeList — the (static) result of querySelectorAll.
NodeList*: {
    handle: RawPtr<u8>,
}
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/DOMTokenList — element.classList.
DOMTokenList*: {
    handle: RawPtr<u8>,
}
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/CSSStyleDeclaration — element.style.
CSSStyleDeclaration*: {
    handle: RawPtr<u8>,
}
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Console — the console global.
Console*: {
    handle: RawPtr<u8>,
}
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Location — window.location.
Location*: {
    handle: RawPtr<u8>,
}
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Promise — returned by fetch (async is future genjs work).
Promise*: {
    handle: RawPtr<u8>,
}
// ── Upcast stubs: the inheritance edges. genjs lowers each to the identity (an Element IS a Node). ─
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Node — Node is an EventTarget.
node_target* = (n: Node) EventTarget
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Element — Element is a Node.
as_node* = (e: Element) Node
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Element — Element is an EventTarget.
as_event_target* = (e: Element) EventTarget
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/HTMLElement — HTMLElement is an Element.
as_element* = (h: HTMLElement) Element
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Text — a Text node is a Node.
text_node* = (t: Text) Node
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Document — Document is a Node.
document_node* = (d: Document) Node
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Window — Window is an EventTarget.
window_target* = (w: Window) EventTarget
// Narrowing helper: treat a generic Element as an HTMLElement (JS: it already is one for HTML docs).
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/HTMLElement
as_html* = (e: Element) HTMLElement
// ── JS global singletons (accessor stubs; genjs lowers `document()` → `document`) ──────────────────
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Window/document
document* = () Document
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Window
window* = () Window
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/console
console* = () Console
// ── EventTarget ────────────────────────────────────────────────────────────────────────────────
// The callback is a non-capturing fn `(Event) void`; genjs binds it as the JS listener.
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/EventTarget/addEventListener
add_event_listener* = (t: EventTarget, type: str, cb: (Event) void) void
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/EventTarget/removeEventListener
remove_event_listener* = (t: EventTarget, type: str, cb: (Event) void) void
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/EventTarget/dispatchEvent
dispatch_event* = (t: EventTarget, ev: Event) bool
// ── Event ────────────────────────────────────────────────────────────────────────────────────────
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Event/type
event_type* = (ev: Event) str
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Event/target — the EventTarget the event fired on.
event_target* = (ev: Event) EventTarget
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Event/currentTarget
current_target* = (ev: Event) EventTarget
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Event/preventDefault
prevent_default* = (ev: Event) void
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Event/stopPropagation
stop_propagation* = (ev: Event) void
// Common event-type names (JS event strings). Real Zen constants — pass to add_event_listener.
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Element/click_event
CLICK* := "click"
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/HTMLElement/input_event
INPUT* := "input"
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/HTMLElement/change_event
CHANGE* := "change"
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Element/submit_event
SUBMIT* := "submit"
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Element/keydown_event
KEYDOWN* := "keydown"
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Element/keyup_event
KEYUP* := "keyup"
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Element/mouseover_event
MOUSEOVER* := "mouseover"
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Element/mouseout_event
MOUSEOUT* := "mouseout"
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Window/load_event
LOAD* := "load"
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Document/DOMContentLoaded_event
DOM_CONTENT_LOADED* := "DOMContentLoaded"
// ── Node ─────────────────────────────────────────────────────────────────────────────────────────
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Node/appendChild — returns the appended child.
append_child* = (n: Node, child: Node) Node
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Node/removeChild — returns the removed child.
remove_child* = (n: Node, child: Node) Node
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Node/insertBefore
insert_before* = (n: Node, new_node: Node, reference: Node) Node
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Node/replaceChild
replace_child* = (n: Node, new_child: Node, old_child: Node) Node
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Node/cloneNode
clone_node* = (n: Node, deep: bool) Node
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Node/parentNode — None at the tree root.
parent_node* = (n: Node) Opt<Node>
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Node/firstChild
first_child* = (n: Node) Opt<Node>
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Node/nextSibling
next_sibling* = (n: Node) Opt<Node>
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Node/childNodes
child_nodes* = (n: Node) NodeList
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Node/textContent — read.
text_content* = (n: Node) str
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Node/textContent — write.
set_text_content* = (n: Node, text: str) void
// ── Element ────────────────────────────────────────────────────────────────────────────────────
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Element/id — read.
element_id* = (e: Element) str
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Element/id — write.
set_id* = (e: Element, id: str) void
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Element/tagName — uppercase tag, e.g. "DIV".
tag_name* = (e: Element) str
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Element/className — read (space-joined classes).
class_name* = (e: Element) str
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Element/className — write.
set_class_name* = (e: Element, name: str) void
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Element/innerHTML — read.
inner_html* = (e: Element) str
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Element/innerHTML — write (parses HTML).
set_inner_html* = (e: Element, html: str) void
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Element/getAttribute — None if the attr is absent.
get_attribute* = (e: Element, name: str) Opt<str>
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Element/setAttribute
set_attribute* = (e: Element, name: str, value: str) void
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Element/removeAttribute
remove_attribute* = (e: Element, name: str) void
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Element/hasAttribute
has_attribute* = (e: Element, name: str) bool
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Element/classList
class_list* = (e: Element) DOMTokenList
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Element/querySelector — first match, or None.
query_selector* = (e: Element, selectors: str) Opt<Element>
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Element/querySelectorAll — all matches (static).
query_selector_all* = (e: Element, selectors: str) NodeList
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Element/remove — detach from the tree.
remove* = (e: Element) void
// ── HTMLElement (rendering / interaction surface layered on Element) ───────────────────────────────
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/HTMLElement/style — the inline style object.
style* = (h: HTMLElement) CSSStyleDeclaration
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/HTMLElement/hidden — read.
hidden* = (h: HTMLElement) bool
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/HTMLElement/hidden — write.
set_hidden* = (h: HTMLElement, hidden: bool) void
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/HTMLElement/click
click* = (h: HTMLElement) void
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/HTMLElement/focus
focus* = (h: HTMLElement) void
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/HTMLElement/blur
blur* = (h: HTMLElement) void
// ── DOMTokenList (element.classList) ───────────────────────────────────────────────────────────────
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/DOMTokenList/add
class_add* = (l: DOMTokenList, token: str) void
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/DOMTokenList/remove
class_remove* = (l: DOMTokenList, token: str) void
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/DOMTokenList/toggle — returns the resulting state.
class_toggle* = (l: DOMTokenList, token: str) bool
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/DOMTokenList/contains
class_contains* = (l: DOMTokenList, token: str) bool
// ── CSSStyleDeclaration (element.style) ────────────────────────────────────────────────────────────
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/CSSStyleDeclaration/setProperty
set_property* = (s: CSSStyleDeclaration, name: str, value: str) void
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/CSSStyleDeclaration/getPropertyValue — "" if unset.
get_property* = (s: CSSStyleDeclaration, name: str) str
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/CSSStyleDeclaration/removeProperty
remove_property* = (s: CSSStyleDeclaration, name: str) void
// ── NodeList (querySelectorAll / childNodes result) ────────────────────────────────────────────────
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/NodeList/length
node_list_length* = (l: NodeList) i32
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/NodeList/item — None when index is out of range.
node_list_item* = (l: NodeList, index: i32) Opt<Node>
// ── Document ────────────────────────────────────────────────────────────────────────────────────
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Document/getElementById — None when no match.
get_element_by_id* = (d: Document, id: str) Opt<Element>
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Document/querySelector — first match, or None.
document_query_selector* = (d: Document, selectors: str) Opt<Element>
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Document/querySelectorAll
document_query_selector_all* = (d: Document, selectors: str) NodeList
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Document/createElement — e.g. create_element("div").
create_element* = (d: Document, tag: str) HTMLElement
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Document/createTextNode
create_text_node* = (d: Document, data: str) Text
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Document/body
body* = (d: Document) HTMLElement
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Document/head
head* = (d: Document) HTMLElement
// ── Window ─────────────────────────────────────────────────────────────────────────────────────
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Window/alert
alert* = (w: Window, message: str) void
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Window/document — the window's Document.
window_document* = (w: Window) Document
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Window/location
location* = (w: Window) Location
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Window/setTimeout — delay in ms; returns a timer id.
set_timeout* = (w: Window, cb: () void, delay_ms: i32) i32
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Window/clearTimeout
clear_timeout* = (w: Window, id: i32) void
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Window/requestAnimationFrame
request_animation_frame* = (w: Window, cb: (f64) void) i32
// ── Location (window.location) ─────────────────────────────────────────────────────────────────────
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Location/href — read.
href* = (l: Location) str
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Location/href — write (navigates).
set_href* = (l: Location, url: str) void
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Location/reload
reload* = (l: Location) void
// ── Console ────────────────────────────────────────────────────────────────────────────────────
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/console/log_static
log* = (c: Console, message: str) void
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/console/error_static
error* = (c: Console, message: str) void
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/console/warn_static
warn* = (c: Console, message: str) void
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/console/info_static
info* = (c: Console, message: str) void
// ── fetch (the Fetch API entry point) ──────────────────────────────────────────────────────────────
// A stub returning an opaque Promise. Promise combinators (then/await) are deferred: they need genjs's
// async lowering, which is future work — this pins only the entry-point type so callers can name it.
// MDN: https://developer.mozilla.org/en-US/docs/Web/API/Window/fetch
fetch* = (url: str) Promise
