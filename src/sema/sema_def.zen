// src/sema/sema_def.zen
// What a name means, and who is allowed to ask.
//
// `defs_of(name)` is the second query DESIGN.md names, and it returns a
// LIST rather than a definition. That is not a hedge — it is what
// overloading is: "resolution is on declared parameter types and arity",
// so a name in scope denotes a candidate SET and choosing between them
// is the call site's job, not resolution's.
//
// THE `*` GATE, in one sentence: a name crosses a module boundary
// exactly when it is starred, and re-export is an import whose bindings
// are starred. So there is no second mechanism to implement — following
// an import to the module that declares the name, and filtering by
// `exported` at every hop, is the whole of it. A folder root is a file
// of starred bindings, so the chain is routinely two or three hops deep
// and `std.core` reaches `std.core.result` through exactly this walk.
//
// A MODULE TABLE IS A `Vec`, NOT A `Map`, and that is measured rather
// than lazy: `Map.get` in this stdlib is `index_of`, a `find` over every
// entry — a linear scan already. A `Map<str, Vec<Def>>` would buy the
// same complexity for a nested generic and a second allocation per name.
// The memo tables that DO key on an id use `Map`, because there the key
// is a `u32` and the point is identity, not lookup speed.
//
// OVER 500 LINES, AND THE JUSTIFICATION STYLE.md ASKS FOR: the subject
// is "what a name means", and every query below is that one question
// asked of a different scope — a module's own table, the imports it
// follows, the prelude it never wrote, which module a dotted path
// denotes, which bindings the `*` gate refused. They all read `tables`;
// a split would put the store in one file and its readers in another.

Ast, Module, Decl, DeclKind, Ident, Span, QualifiedName = std.ast
Import, Impl, Enum = std.ast
Alloc, AllocError = std.mem
Vec, Map = std.collections
str, String = std.text
Range = std.core
DeclId, ImplId = sema.sema_id

// Which declaration form a name denotes. Not the declaration itself:
// "if you have a `Decl`, you have the whole declaration", and this
// layer only has to answer what KIND of thing was found so a caller
// knows whether to expect a type or a value.
//
// Every variant carries the `Def` suffix, and that is the same rule
// `ast_node.zen` follows when it writes `Equal` rather than `Eq`: a bare
// `Struct` here is not a new name, it is `ast.Struct`, and
// `A = B | C` where B and C are types in scope is DESIGN.md's OTHER
// reading of that syntax — "a union of existing types". The bar form is
// genuinely ambiguous between an enum and a union, and the language
// resolves it by what the names mean, so a variant that shadows a type
// silently becomes a union of it.
DefKind* = StructDef | EnumDef | AliasDef | FunctionDef | ConstDef

// One declaration, as a name resolves to it.
//
// `qname` is the module-qualified name and it is the identity — two
// modules may declare `Circle` and they are two types. `name` is the
// bare one, for a diagnostic to print.
Def* = {
    name*: str,
    qname*: str,
    kind*: DefKind,
    id*: DeclId,
    exported*: bool,
    span*: Span,
}

// `Res*, Ok* = std.core.result` binds two names, each of which may or
// may not be starred. Zen has no renaming import, so the local name and
// the declared name are the same string — which is what makes following
// the chain a lookup of the SAME name one module along.
ImportBinding* = {
    name*: str,
    module*: str,
    exported*: bool,
    span*: Span,
}

// One module's own surface: what it declares, what it imports, and what
// it impls. Built once per module by `build`.
ModuleTable* = {
    name*: str,
    index*: u32,
    defs* :: Vec<Def>,
    imports* :: Vec<ImportBinding>,
    impls* :: Vec<ImplId>,
}

// The one module every other module imports without saying so.
// `bootstrap/modules.py` names the same string, and it has to be the
// same string: the two compilers must agree about which module is
// ambient or a program means different things to each.
PRELUDE*: str = "std.core"

// The same file, spelled the long way (`index_of` gives the rule).
// Which spelling a module table ends up under is decided by whichever
// import reached it first, and that must not decide whether a program
// has a prelude — so both are tried and the short one wins.
PRELUDE_FILE*: str = "std.core.core"

// The module graph, and every query over names.
//
// It carries the `Alloc` for the reason `Vec` and `Ast` do: the tables
// are built once and live as long as the compilation, so the allocator
// is threaded in at construction and every query that grows a list says
// `Res<_, AllocError>`.
World* = {
    tables :: Vec<ModuleTable>,
    alloc: Alloc,

    count* = (self: @Self) usize { self.tables.len }

    table_at* = (self: @Self, i: usize) Res<ModuleTable> { self.tables.get(i) }

    // The module spelled `std.core.result`. A module's identity is
    // its full dotted path — "names are qualified by path", and
    // accepting a suffix would make two modules answer to one spelling.
    //
    // A FOLDER ROOT HAS A SECOND SPELLING, and only one. `std/core/
    // core.zen` is `std.core.core` by the path rule and `std.core` by
    // the folder rule, and both are written in this tree. They are one
    // FILE, so they are one module, so the shorthand is a way of
    // WRITING the identity rather than a second identity — which is
    // exactly the line `bootstrap/modules.py` draws between a file's
    // `dotted` and its `_module_index` aliases. Tried second, so an
    // `a.b` that is a module of its own always wins over `a.b.b`.
    index_of* = (self: @Self, name: str) Res<usize> {
        self.exact_index(name).match({
            Ok(i) => Ok(i),
            None  => self.folder_index(name),
        })
    }

    exact_index = (self: @Self, name: str) Res<usize> {
        Range(0, self.tables.len).find((i) {
            self.tables.get(i).match({
                Ok(t) => t.name.eq(name),
                None  => false,
            })
        })
    }

    // `std.core` -> `std.core.core`: the folder's name with its own
    // last segment repeated, which is the file a folder keeps its root
    // in and the one path `<folder>/<folder>.zen` builds.
    folder_index = (self: @Self, name: str) Res<usize> {
        self.alloc.String("{}.{}", name, last_segment(name)).match({
            Err(_) => None,
            Ok(s)  => self.exact_index(s.view()),
        })
    }

    // -----------------------------------------------------------------
    // the queries
    // -----------------------------------------------------------------

    // Every declaration of `name` visible in module `mi`.
    //
    // Own declarations first and they are the whole answer when there
    // are any: a module's own name is never shadowed by something it
    // imported, because the import would have been a redeclaration.
    // Otherwise the imports are followed, and `*` gates every hop, and
    // last of all the prelude — the only name a module gets without
    // writing an import, and so the only one that loses every tie.
    //
    // AN IMPORT BINDING IS AUTHORITATIVE, which is why the last line
    // asks a question the first two do not. The prelude is the exception
    // for a name NOBODY imported; a module that wrote an import already
    // said what the name means here, so a binding the `*` gate rejected
    // resolves to NOTHING. Falling through was worse than a missing
    // diagnostic: `hex_digit`, blocked at its own boundary, came back
    // out of `std.core.byte` and ran instead.
    defs_of* = (self: @Self, mi: usize, name: str, out :: Vec<Def>)
               Res<(), AllocError> {
        self.own_defs(mi, name, out).try();
        (out.len == 0).then(() { self.imported_defs(mi, name, out).try() });
        (out.len == 0 && (self.binds_name(mi, name) == false))
            .then(() { self.prelude_defs(mi, name, out).try() });
        Ok(());
    }

    // Whether `mi` wrote an import binding this name, starred or not: a
    // star says whether the binding leaves again, not whether it exists.
    binds_name* = (self: @Self, mi: usize, name: str) bool {
        self.tables.get(mi).match({
            None  => false,
            Ok(t) => imports_name(t, name),
        })
    }

    // "A name that is not imported is not visible, and the prelude is
    // the only exception. That exception is what auto-imported means:
    // `std.core` is imported into every module, so `Res`, `Ok`, `Vec`,
    // `Map`, `str`, `Env` and the rest are in scope everywhere without a
    // line."
    //
    // It is one more hop of the SAME walk — `exports_of`, `*` gating
    // every step — and not a whole-program name table, which is the
    // thing DESIGN.md rules out in the same paragraph. A module that IS
    // the prelude asks nothing: its own defs and its own imports have
    // already been consulted, and asking again would only re-walk them.
    prelude_defs = (self: @Self, mi: usize, name: str, out :: Vec<Def>)
                   Res<(), AllocError> {
        self.prelude_index().match({
            Ok(p) => self.prelude_exports(p, mi, name, out),
            None  => Ok(()),
        }).try();
        Ok(());
    }

    // Where the prelude is, under either of its two spellings. A
    // program with no prelude module at all is a program with no
    // prelude, which is a `None` and not a mistake — a test that
    // compiles three files has one.
    prelude_index* = (self: @Self) Res<usize> {
        self.index_of(PRELUDE).match({
            Ok(p) => Ok(p),
            None  => self.index_of(PRELUDE_FILE),
        })
    }

    prelude_exports = (self: @Self, p: usize, mi: usize, name: str,
                       out :: Vec<Def>) Res<(), AllocError> {
        (p == mi).match({
            true  => Ok(()),
            false => self.exported_defs(p, name, out),
        }).try();
        Ok(());
    }

    // Everything module `p` lets out under `name`, starting a fresh
    // cycle guard. The entry point for asking a module that nobody
    // imported.
    exported_defs* = (self: @Self, p: usize, name: str, out :: Vec<Def>)
                     Res<(), AllocError> {
        seen ::= self.alloc.Vec<usize>();
        self.exports_of(p, name, out, seen)
    }

    // What the prelude exports under `name`, asked from nowhere in
    // particular. `defs_of` reaches the same answer as the last hop of
    // an ordinary walk; this is the direct question, for the caller that
    // holds a PRIMITIVE and so has no module to ask from.
    prelude_of* = (self: @Self, name: str, out :: Vec<Def>)
                  Res<(), AllocError> {
        self.prelude_index().match({
            Ok(p) => self.exported_defs(p, name, out),
            None  => Ok(()),
        }).try();
        Ok(());
    }

    // EVERY EXPORTED DECLARATION OF `name` IN THE PROGRAM, in module
    // order.
    //
    // This is not a hole in the `*` gate, it is the other half of the
    // sentence the gate is written in: "importing a type pulls its
    // world along: its methods, its trait impls, and exported ufcs
    // functions (a free function whose first param is the type is
    // callable as a method)". A free function whose first parameter is
    // `u32` TRAVELLED WITH `u32`, so naming the type is what reached
    // it, and the module it happens to live in was never imported by
    // anybody. `to_usize` is on no prelude line and is called all over
    // this tree.
    //
    // THE RECEIVER'S TYPE IS THE GATE and it is not applied here: this
    // is only the pool, and a `World` knows names rather than types.
    // The caller filters on the first parameter, which is what makes a
    // free function a method at all — sharing the name never was. So
    // this is a query only a DOT may ask; `f(x)` still goes through
    // `defs_of` and still cannot see a module it did not import.
    exported_named* = (self: @Self, name: str, out :: Vec<Def>)
                      Res<(), AllocError> {
        Range(0, self.tables.len).loop((h, mi) {
            self.tables.get(mi).match({
                Ok(t) => collect_exported(t.defs, name, out),
                None  => Ok(()),
            }).try();
        });
        Ok(());
    }

    // What `mi` declares under `name`, starred or not. Visibility is a
    // question about crossing a boundary, and this has not crossed one.
    own_defs* = (self: @Self, mi: usize, name: str, out :: Vec<Def>)
                Res<(), AllocError> {
        self.tables.get(mi).match({
            Ok(t) => collect_named(t.defs, name, out),
            None  => Ok(()),
        }).try();
        Ok(());
    }

    // What `mi` can see under `name` because it imported it.
    //
    // The `*` on the IMPORT is what re-exports; the `*` on the
    // DECLARATION is what let it out of its own module. Both are
    // checked, at their own hop, which is why a two-hop chain through a
    // folder root works and a chain through an unstarred binding does
    // not.
    imported_defs* = (self: @Self, mi: usize, name: str, out :: Vec<Def>)
                     Res<(), AllocError> {
        seen ::= self.alloc.Vec<usize>();
        self.follow(mi, name, out, seen, false)
    }

    // Every EXPORTED declaration of `name` in module `mi`, following
    // that module's own re-exports. This is what one hop of the chain
    // asks of the next.
    exports_of* = (self: @Self, mi: usize, name: str, out :: Vec<Def>,
                   seen :: Vec<usize>) Res<(), AllocError> {
        starred ::= self.alloc.Vec<Def>();
        self.own_defs(mi, name, starred).try();
        keep_exported(starred, out).try();
        // a folder root declares nothing and re-exports everything, so
        // an empty answer here is the normal case and not a miss
        (out.len == 0).then(
            () { self.follow(mi, name, out, seen, true).try() }
        );
        Ok(());
    }

    // Walk `mi`'s import list for `name` and ask the module it names.
    //
    // `reexport` IS THE STAR ON THE BINDING, a parameter because the
    // same list answers two questions. Asked by `mi` itself, every
    // binding counts — an import binds locally whatever its star says.
    // Asked by somebody ELSE, only starred ones do: a star on an import
    // is the whole re-export mechanism, and the walk without this flag
    // re-exported every unstarred import.
    //
    // `seen` is the cycle guard, and it is needed rather than defensive:
    // `std.core.display` and `std.text` import from each other, and a
    // module graph is not required to be a tree.
    follow = (self: @Self, mi: usize, name: str, out :: Vec<Def>,
              seen :: Vec<usize>, reexport: bool) Res<(), AllocError> {
        visited(seen, mi).match({
            false => self.follow_fresh(mi, name, out, seen, reexport),
            true  => Ok(()),
        })
    }

    follow_fresh = (self: @Self, mi: usize, name: str, out :: Vec<Def>,
                    seen :: Vec<usize>, reexport: bool) Res<(), AllocError> {
        seen.add(mi).try();
        self.tables.get(mi).match({
            Ok(t) => self.follow_imports(t, name, out, seen, reexport),
            None  => Ok(()),
        }).try();
        Ok(());
    }

    follow_imports = (self: @Self, t: ModuleTable, name: str, out :: Vec<Def>,
                      seen :: Vec<usize>, reexport: bool) Res<(), AllocError> {
        t.imports.loop((h, binding) {
            crosses = binding.exported || (reexport == false);
            (crosses && binding.name.eq(name)).then(() {
                self.follow_one(binding, name, out, seen).try();
            });
        });
        Ok(());
    }

    follow_one = (self: @Self, binding: ImportBinding, name: str,
                  out :: Vec<Def>, seen :: Vec<usize>) Res<(), AllocError> {
        self.index_of(binding.module).match({
            Ok(other) => self.exports_of(other, name, out, seen),
            None      => Ok(()),
        }).try();
        Ok(());
    }

    // Every impl in the program whose target is this type name.
    //
    // Whole-program, and it has to be: "an impl lives with the type, not
    // with the trait", so `str.impl(Eq, ..)` is in `std.text` and a
    // caller in another module still has to find it. There are no orphan
    // impls, so the search is over declaring modules and not over
    // importers.
    impls_named* = (self: @Self, tree: Ast, target: str, out :: Vec<ImplId>)
                   Res<(), AllocError> {
        Range(0, self.tables.len).loop((h, mi) {
            self.tables.get(mi).match({
                Ok(t) => self.impls_in(tree, t, target, out),
                None  => Ok(()),
            }).try();
        });
        Ok(());
    }

    impls_in = (self: @Self, tree: Ast, t: ModuleTable, target: str,
                out :: Vec<ImplId>) Res<(), AllocError> {
        t.impls.loop((h, id) {
            self.impl_at(tree, id).match({
                Ok(im) => keep_if_target(im, target, id, out),
                None   => Ok(()),
            }).try();
        });
        Ok(());
    }

    // THE GATE, ASKED OF THE IMPORT RATHER THAN OF A USE.
    //
    // Every import binding in `mi` that the `*` gate rejects. BINDINGS
    // and not a count, because the diagnostic names the binding's own
    // span: `view, hex_digit = text.text` is one declaration and two
    // bindings, and only one of them is wrong. TWO THINGS IT DOES NOT
    // CLAIM: a module the program does not contain has nothing to have
    // exported FROM, and a module importing ITSELF is the cycle rule.
    blocked_imports* = (self: @Self, tree: Ast, mi: usize,
                        out :: Vec<ImportBinding>) Res<(), AllocError> {
        self.tables.get(mi).match({
            Ok(t) => self.blocked_in(tree, t, mi, out),
            None  => Ok(()),
        })
    }

    blocked_in = (self: @Self, tree: Ast, t: ModuleTable, mi: usize,
                  out :: Vec<ImportBinding>) Res<(), AllocError> {
        t.imports.loop((h, b) { self.blocked_one(tree, b, mi, out).try() });
        Ok(());
    }

    blocked_one = (self: @Self, tree: Ast, b: ImportBinding, mi: usize,
                   out :: Vec<ImportBinding>) Res<(), AllocError> {
        self.index_of(b.module).match({
            None      => Ok(()),
            Ok(other) => self.blocked_from(tree, b, other, mi, out),
        })
    }

    blocked_from = (self: @Self, tree: Ast, b: ImportBinding, other: usize,
                    mi: usize, out :: Vec<ImportBinding>)
                   Res<(), AllocError> {
        seen ::= self.alloc.Vec<usize>();
        crosses = self.exports_name(tree, other, b.name, seen).try();
        (crosses || (other == mi)).match({
            true  => Ok(()),
            false => out.add(b),
        })
    }

    // Whether module `mi` lets `name` out at all. `exported_defs` answers
    // with DEFS; this answers yes or no and knows one thing more, because
    // a VARIANT IS NOT A DECLARATION: `Res*<T> = Ok(T) | None` files one
    // `Def` and `Res*, Ok*, Err*, None* = std.core.result` names four off
    // it. So the enum's own star answers for its variants; filing them as
    // `Def`s would put `Ok` in the table every bare name resolves through.
    exports_name* = (self: @Self, tree: Ast, mi: usize, name: str,
                     seen :: Vec<usize>) Res<bool, AllocError> {
        defs ::= self.alloc.Vec<Def>();
        self.exported_defs(mi, name, defs).try();
        hits ::= self.alloc.Vec<Def>();
        (defs.len == 0).then(() {
            self.exports_variant(tree, mi, name, hits, seen, true).try();
        });
        Ok(defs.len > 0 || hits.len > 0);
    }

    // THE ENUMS A BARE VARIANT NAME REACHES FROM `mi`, for the same
    // reason: `Two` is a name a program may write and `defs_of` cannot
    // answer for it. It is the SAME walk deliberately — the answer says
    // which enum `Two` belongs to, and two walks that disagreed would
    // pick two types. The enum is the answer and not the module holding
    // it, because a nullary variant IS a value of its enum.
    variant_defs* = (self: @Self, tree: Ast, mi: usize, name: str,
                     out :: Vec<Def>) Res<(), AllocError> {
        seen ::= self.alloc.Vec<usize>();
        self.exports_variant(tree, mi, name, out, seen, false)
    }

    // The variant half of the same walk, cycle guard and all. `hits`
    // accumulates rather than setting a flag; a scalar assigned from two
    // nested closures is not something this resolves.
    //
    // `reexport` IS THE STAR, a parameter for the reason `follow`'s is:
    // asked by `mi` ABOUT ITSELF nothing has crossed a boundary, so an
    // unstarred enum and an unstarred import both still bind. Asked by
    // somebody ELSE, both stars are required.
    exports_variant = (self: @Self, tree: Ast, mi: usize, name: str,
                       hits :: Vec<Def>, seen :: Vec<usize>, reexport: bool)
                      Res<(), AllocError> {
        visited(seen, mi).match({
            true  => Ok(()),
            false => self.variant_walk(tree, mi, name, hits, seen, reexport),
        })
    }

    variant_walk = (self: @Self, tree: Ast, mi: usize, name: str,
                    hits :: Vec<Def>, seen :: Vec<usize>, reexport: bool)
                   Res<(), AllocError> {
        seen.add(mi).try();
        self.tables.get(mi).match({
            Ok(t) => self.variant_table(tree, t, name, hits, seen, reexport),
            None  => Ok(()),
        })
    }

    variant_table = (self: @Self, tree: Ast, t: ModuleTable, name: str,
                     hits :: Vec<Def>, seen :: Vec<usize>, reexport: bool)
                    Res<(), AllocError> {
        collect_variant(tree, t, name, reexport, hits).try();
        (hits.len == 0).then(() {
            self.variant_each(tree, t, name, hits, seen, reexport).try();
        });
        Ok(());
    }

    // The star and the name are asked INSIDE the helper, not in a `.then`
    // around the call: SEMA_BOOTSTRAP_FIXES.md §10's workaround, and §10
    // now records that gap CLOSED, to be re-tested before removal.
    variant_each = (self: @Self, tree: Ast, t: ModuleTable, name: str,
                    hits :: Vec<Def>, seen :: Vec<usize>, reexport: bool)
                   Res<(), AllocError> {
        t.imports.loop((h, b) {
            self.variant_hop(tree, b, name, hits, seen, reexport).try();
        });
        Ok(());
    }

    variant_hop = (self: @Self, tree: Ast, b: ImportBinding, name: str,
                   hits :: Vec<Def>, seen :: Vec<usize>, reexport: bool)
                  Res<(), AllocError> {
        crosses = b.exported || (reexport == false);
        (crosses && b.name.eq(name)).match({
            false => Ok(()),
            true  => self.variant_hop_to(tree, b.module, name, hits, seen),
        })
    }

    // EVERY HOP PAST THE FIRST CROSSES A BOUNDARY, so the star is asked
    // from here on whatever the first hop was asked as.
    variant_hop_to = (self: @Self, tree: Ast, module: str, name: str,
                      hits :: Vec<Def>, seen :: Vec<usize>)
                     Res<(), AllocError> {
        self.index_of(module).match({
            None  => Ok(()),
            Ok(o) => self.exports_variant(tree, o, name, hits, seen, true),
        })
    }

    // The `Impl` node an `ImplId` points at. A projection through the
    // AST, kept here so no caller has to know an impl is a `DeclKind`.
    impl_at* = (self: @Self, tree: Ast, id: ImplId) Res<Impl> {
        decl_at(tree, id.decl).match({
            None  => None,
            Ok(d) => d.kind.match({
                Impl(i) => Ok(i),
                _       => None,
            }),
        })
    }
}

// Build the whole graph from a parsed `Ast`. One pass over every module
// and every declaration in it, in source order, so the indices this
// hands out are a pure function of the input.
World* = (a: Alloc, tree: Ast) Res<World, AllocError> {
    w ::= World(tables: a.Vec<ModuleTable>(), alloc: a);
    Range(0, tree.module_count()).loop((h, i) {
        tree.module_at(i).match({
            Ok(m) => add_module(w, a, m, i),
            None  => Ok(()),
        }).try();
    });
    Ok(w);
}

add_module = (w :: World, a: Alloc, m: Module, i: usize) Res<(), AllocError> {
    t ::= ModuleTable(
        name: m.name,
        index: 0,
        defs: a.Vec<Def>(),
        imports: a.Vec<ImportBinding>(),
        impls: a.Vec<ImplId>(),
    );
    Range(0, m.decls.len).loop((h, di) {
        m.decls.get(di).match({
            Ok(d) => index_decl(t, a, m, d, i, di),
            None  => Ok(()),
        }).try();
    });
    w.tables.add(t).try();
    Ok(());
}

// One declaration, filed under the name it binds.
//
// An `Import` binds names without declaring them and an `Impl` binds no
// name at all, so those two go to their own lists; everything else is a
// `Def`. The order of this match is the order of `DeclKind`, so a new
// declaration form is a compile error here rather than a silent miss.
index_decl = (
    t  :: ModuleTable,
    a  : Alloc,
    m  : Module,
    d  : Decl,
    mi : usize,
    di : usize
) Res<(), AllocError> {
    id = decl_id(mi, di);
    d.kind.match({
        Struct(s)   => add_def(
            t,
            a,
            m,
            s.name,
            DefKind.StructDef,
            s.exported,
            id,
            d.span
        ),
        Enum(e)     => add_def(
            t,
            a,
            m,
            e.name,
            DefKind.EnumDef,
            e.exported,
            id,
            d.span
        ),
        Alias(x)    => add_def(
            t,
            a,
            m,
            x.name,
            DefKind.AliasDef,
            x.exported,
            id,
            d.span
        ),
        Function(f) => add_def(
            t,
            a,
            m,
            f.name,
            DefKind.FunctionDef,
            f.exported,
            id,
            d.span
        ),
        Const(c)    => add_def(
            t,
            a,
            m,
            c.name,
            DefKind.ConstDef,
            c.exported,
            id,
            d.span
        ),
        Import(im)  => add_imports(t, a, im),
        Impl(_)     => t.impls.add(ImplId(decl: id)),
    }).try();
    Ok(());
}

add_def = (
    t        :: ModuleTable,
    a        : Alloc,
    m        : Module,
    name     : Ident,
    kind     : DefKind,
    exported : bool,
    id       : DeclId,
    span     : Span
) Res<(), AllocError> {
    q ::= a.String().try();
    q.add_bytes(m.name).try();
    q.add_bytes(".").try();
    q.add_bytes(name.text).try();
    t.defs.add(Def(
        name: name.text,
        qname: q.view(),
        kind: kind,
        id: id,
        exported: exported,
        span: span,
    ))
}

// `Res*, Ok*, None* = std.core.result` is three bindings of one module,
// each starred independently. The module path is flattened to its dotted
// spelling once, here, so nothing downstream walks segments.
//
// EACH BINDING KEEPS ITS OWN SPAN: one line binds three names and the
// `*` gate rejects them one at a time.
add_imports = (t :: ModuleTable, a: Alloc, im: Import) Res<(), AllocError> {
    path = dotted(a, im.module).try();
    im.names.loop((h, n) {
        t.imports.add(ImportBinding(
            name: n.name.text,
            module: path,
            exported: n.exported,
            span: n.name.span,
        )).try();
    });
    Ok(());
}

// A `QualifiedName`'s dotted spelling — `std.core.result`.
//
// The segments are stored apart so a diagnostic can point at the one
// that is wrong; this is the other direction, and it allocates, so it
// takes an `Alloc` and says so. Rejoining rather than reading the span's
// source text is deliberate: a `Span` names a position, and going back
// to the bytes to recover something the AST already holds is how two
// sources of one fact start disagreeing.
dotted* = (a: Alloc, q: QualifiedName) Res<str, AllocError> {
    out ::= a.String().try();
    q.segments.loop((h, i, seg) {
        (i > 0).then(() { out.add_bytes(".").try() });
        out.add_bytes(seg.text).try();
    });
    Ok(out.view());
}

// The last segment of a dotted name — `core` of `std.core`, and `main`
// of a name with no dot at all, which is why the cut starts at 0.
last_segment* = (name: str) str {
    cut ::= 0;
    Range(0, name.len).loop((h, i) {
        (name.index(i) == '.').then(() { cut = i + 1; });
    });
    name.slice(cut, name.len)
}

// The coordinate of a declaration. Both indices are positions in a
// `Vec`, so they are `usize`, and `DeclId` holds `u32` for the reason
// `ast_id.zen` gives. This is the one narrowing in the file and it is
// done by counting rather than converting.
decl_id* = (mi: usize, di: usize) DeclId {
    DeclId(module: index_u32(mi), decl: index_u32(di))
}

// `usize` to `u32` by counting up, because `std.core.num` carries only
// LOSSLESS conversions — a narrowing one can fail, so it is not there to
// call. Counting is honest about that: a tree with four billion modules
// saturates rather than wrapping, and four billion is not a number this
// compiler reaches.
//
// This belongs in `std.core.num` as a `Res`-returning `to_u32`, and
// `docs/SEMA_BOOTSTRAP_FIXES.md` records it as a std gap.
index_u32* = (v: usize) u32 {
    n ::= 0;
    Range(0, v).loop((h, i) { n = n + 1; });
    n
}

decl_at* = (tree: Ast, id: DeclId) Res<Decl> {
    tree.module_at(id.module.to_usize()).match({
        None  => None,
        Ok(m) => m.decls.get(id.decl.to_usize()),
    })
}

keep_if_target = (im: Impl, target: str, id: ImplId, out :: Vec<ImplId>)
                 Res<(), AllocError> {
    im.target.text.eq(target).then(() { out.add(id).try() });
    Ok(());
}

collect_named = (defs: Vec<Def>, name: str, out :: Vec<Def>)
                Res<(), AllocError> {
    defs.loop((h, d) {
        d.name.eq(name).then(() { out.add(d).try() });
    });
    Ok(());
}

collect_exported = (defs: Vec<Def>, name: str, out :: Vec<Def>)
                   Res<(), AllocError> {
    defs.loop((h, d) {
        (d.exported && d.name.eq(name)).then(() { out.add(d).try() });
    });
    Ok(());
}

keep_exported = (defs: Vec<Def>, out :: Vec<Def>) Res<(), AllocError> {
    defs.loop((h, d) {
        d.exported.then(() { out.add(d).try() });
    });
    Ok(());
}

imports_name = (t: ModuleTable, name: str) bool {
    Range(0, t.imports.len).find((i) {
        t.imports.get(i).match({ Ok(b) => b.name.eq(name), None => false })
    }).match({ Ok(_) => true, None => false })
}

// The enums this module declares with a variant of this name.
//
// A VARIANT CARRIES NO STAR OF ITS OWN, as `exports_name` says. The gate
// is asked only when `gated`, because a module reading its own file has
// crossed no boundary and an unstarred enum there is still visible.
collect_variant = (
    tree  : Ast,
    t     : ModuleTable,
    name  : str,
    gated : bool,
    out   :: Vec<Def>
) Res<(), AllocError> {
    t.defs.loop((h, d) {
        lets_out = d.exported || (gated == false);
        (lets_out && enum_has_variant(tree, d, name)).then(() {
            out.add(d).try();
        });
    });
    Ok(());
}

enum_has_variant = (tree: Ast, d: Def, name: str) bool {
    decl_at(tree, d.id).match({
        None  => false,
        Ok(x) => x.kind.match({
            Enum(e) => named_variant(e, name),
            _       => false,
        }),
    })
}

named_variant = (e: Enum, name: str) bool {
    Range(0, e.variants.len).find((i) {
        e.variants.get(i).match({
            Ok(v) => v.name.text.eq(name),
            None  => false,
        })
    }).match({ Ok(_) => true, None => false })
}

// How a module is NAMED to a reader. `text/text.zen` answers to
// `text.text` by the path rule and to `text` by the folder rule, and a
// person wrote the folder form — so a repeated last segment collapses.
module_display* = (name: str) str {
    head = name.slice(0, cut_before(name));
    last_segment(head).eq(last_segment(name)).match({
        true  => head,
        false => name,
    })
}

// Where the last segment starts, minus its dot.
cut_before = (name: str) usize {
    cut ::= name.len;
    Range(0, name.len).loop((h, i) {
        (name.index(i) == '.').then(() { cut = i; });
    });
    cut
}

visited = (seen: Vec<usize>, mi: usize) bool {
    Range(0, seen.len).find((i) {
        seen.get(i).match({ Ok(v) => v == mi, None => false })
    }).match({ Ok(_) => true, None => false })
}
