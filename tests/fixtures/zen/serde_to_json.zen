// std.format.serde acceptance: jsony-style JSON serde as PURE LIBRARY CODE over the
// each_field reflection intrinsic — NO per-type serialization code anywhere in this file.
// Covers: flat struct, nested struct (to_json_nested, 2 homogeneous levels), string
// escaping (backslash/quote/\n/\t), a generic-struct instance, the full scalar set
// (i32/i64/u8/f64/bool/StringView), and from_json round-trips (parse → fill a seed
// copy → struct `==` against the original). Exit 0 = every case matched expectation.
{ to_json, to_json_nested, from_json, from_json_nested } = std.format.serde
{ dyn_heap, DynAlloc } = std.mem.alloc
{ Result } = std.core.result
Point: {
    x: i64,
    y: i64,
}
Rect: {
    a: Point,
    b: Point,
}
Msg: {
    text: StringView,
    n: i64,
}
Box<T>: {
    v: T,
    w: T,
}
Mix: {
    i: i32,
    b: u8,
    f: f64,
    t: bool,
    s: StringView,
}
main = () i32 {
    da = dyn_heap()
    a = da.addr()
    // (1) flat struct: field names become keys, declaration order preserved.
    p = Point(
        x: 3,
        y: 0 - 4,
    )
    ok1 = to_json(a, p).match ({
        .Ok(s)  => s == "{\"x\":3,\"y\":-4}",
        .Err(e) => false,
    })
    (ok1 == false).then({
        return 1
    })
    // (2) nested struct: struct-typed fields recurse into their own object.
    r = Rect(
        a: p,
        b: Point(
            x: 10,
            y: 20,
        ),
    )
    ok2 = to_json_nested(a, r).match ({
        .Ok(s)  => s == "{\"a\":{\"x\":3,\"y\":-4},\"b\":{\"x\":10,\"y\":20}}",
        .Err(e) => false,
    })
    (ok2 == false).then({
        return 2
    })
    // (3) string escaping: backslash, quote, newline, tab.
    m = Msg(
        text: "he said \"hi\\\n\tbye\"",
        n: 1,
    )
    ok3 = to_json(a, m).match ({
        .Ok(s)  => s == "{\"text\":\"he said \\\"hi\\\\\\n\\tbye\\\"\",\"n\":1}",
        .Err(e) => false,
    })
    (ok3 == false).then({
        return 3
    })
    // (4) generic struct instance: reflection substitutes the instance's targs.
    ok4 = to_json(a, Box<i64>(
        v: 5,
        w: 6,
    )).match ({
        .Ok(s)  => s == "{\"v\":5,\"w\":6}",
        .Err(e) => false,
    })
    (ok4 == false).then({
        return 4
    })
    // (5) the full scalar set in one struct.
    mx = Mix(
        i: 7,
        b: 255,
        f: 1.5,
        t: true,
        s: "hi",
    )
    ok5 = to_json(a, mx).match ({
        .Ok(s)  => s == "{\"i\":7,\"b\":255,\"f\":1.5,\"t\":true,\"s\":\"hi\"}",
        .Err(e) => false,
    })
    (ok5 == false).then({
        return 5
    })
    // (6) from_json round-trip, flat: parse serialized output back into a seed copy.
    ok6 = from_json(a, "{\"x\":3,\"y\":-4}", Point(
        x: 0,
        y: 0,
    )).match ({
        .Ok(q)  => q == p,
        .Err(e) => false,
    })
    (ok6 == false).then({
        return 6
    })
    // (7) from_json nested + missing key (the seed's field value survives).
    seed = Rect(
        a: Point(
            x: 0,
            y: 0,
        ),
        b: Point(
            x: 0,
            y: 99,
        ),
    )
    ok7 = from_json_nested(a, "{\"a\":{\"x\":3,\"y\":-4},\"b\":{\"x\":10}}", seed).match ({
        .Ok(q)  => q == Rect(
            a: p,
            b: Point(
                x: 10,
                y: 99,
            ),
        ),
        .Err(e) => false,
    })
    (ok7 == false).then({
        return 7
    })
    // (8) from_json string field: JSON escapes decode back to the original bytes.
    ok8 = from_json(a, "{\"text\":\"a\\\"b\\\\c\\n\",\"n\":2}", Msg(
        text: "",
        n: 0,
    )).match ({
        .Ok(q)  => q == Msg(
            text: "a\"b\\c\n",
            n: 2,
        ),
        .Err(e) => false,
    })
    (ok8 == false).then({
        return 8
    })
    // (9) malformed JSON is an .Err, not a panic.
    ok9 = from_json(a, "{\"x\":", Point(
        x: 0,
        y: 0,
    )).match ({
        .Ok(q)  => false,
        .Err(e) => true,
    })
    (ok9 == false).then({
        return 9
    })
    0
}
