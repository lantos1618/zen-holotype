// src/gen/gen_c/gen_c_impl.zen
// Which function an IMPL supplies for a name, and at what arity.
//
// Split out of `gen_c_member.zen`, which reached 796 lines against an
// 800-line hard cap after its comments had already been trimmed twice
// — a file that pays for a line by deleting an explanation has
// outgrown its subject.
//
// And the subject really is a second one: `gen_c_member.zen` answers
// "what does a dot reach on this receiver", needing a `Site` (the
// declaration that owns a type's members and its qualified-name
// symbols). Nothing here needs one — an impl is found by the
// DECLARATION it targets, so every entry point below takes a `DeclId`.
// This file imports nothing from `gen_c_member.zen`, so the dependency
// runs one way with no cycle to arrange around.
//
// `by_arity` lives here for the same reason it's used here: an impl is
// where two members of one name actually turn up, since a bound and a
// type may each supply one.

Decl, Struct, Member, MemberKind, Function, Impl, Field, ExprId = ast
Alloc, AllocError = std.mem
Vec = std.collections
str = std.text
Range = std.core
DeclId, ImplId = sema.sema_id
decl_at = sema.sema_def
member_named = sema.sema_member
CBackend = gen.gen_c.gen_c_state
last_is_variadic = gen.gen_c.gen_c_sink

// A type may declare two members of one name. "Resolution is on
// declared parameter types and arity", and `Cursor.peek()` and
// `Cursor.peek(n)` are two functions — taking the first one emitted a
// call to the wrong symbol with the right arguments, a bug `cc` caught
// but two same-arity overloads would have hidden.
//
// Arity is the half a backend can answer without redoing sema's rule.
// The other half is `gen_c_member.zen`'s `pick_member`, which asks the
// ARGUMENTS where arity cannot separate the candidates — `Display`
// declares two `toString`s and both take two parameters.
//
// A member of the wrong arity is the wrong member, and this once
// answered with one: `found.get(0)` was the fallback for every miss, so
// `Box`'s own `grow(self)` answered `b.grow(10)`, emitting a call to a
// one-parameter symbol with two arguments ("too many arguments to
// function ... Box4grow") — hiding the free `grow(b, by)` that
// DESIGN.md says is in the same overload set.
by_arity* = (be: CBackend, found: Vec<Member>, arity: usize) Res<Member> {
    Range(0, found.len).find((i) {
        found.get(i).match({
            Ok(m) => member_takes(be, m, arity),
            None  => false,
        })
    }).match({
        None  => without_arity(found),
        Ok(i) => found.get(i),
    })
}

// THE FIRST THAT SURVIVED THE FILTER, and arity when none did. Two
// filters narrow an overload set — a written signature (`by_sig`) and a
// call's actual arguments (`member_that_fits`) — and both end the same
// way, because arity is what a backend can still answer when the
// narrower question has no answer at all.
kept_or_arity* = (be: CBackend, kept: Vec<Member>, found: Vec<Member>,
                  arity: usize) Res<Member> {
    (kept.len > 0).match({
        true  => kept.get(0),
        false => by_arity(be, found, arity),
    })
}

member_takes = (be: CBackend, m: Member, arity: usize) bool {
    m.kind.match({
        Function(f) => fn_takes(be, f, arity),
        _           => false,
    })
}

// `...` is not a parameter, it's the statement that the list does not
// end — `sema_cand.zen`'s `variadic_matches` reads it the same way —
// so a variadic member's arity is a MINIMUM. `String.add(self :: @Self,
// fmt: str, args: ...)` is the one member both `sb.add(" and ")` and
// `sb.add("{} is {}", x, y)` reach; counting `...` as a parameter made
// it unreachable from either.
//
// An associated function declares no parameters at all, and asking
// whether its last one is variadic used to trap on `0 - 1` (a `usize`
// underflow inside `last_is_variadic`). That guard now lives where the
// arithmetic is.
fn_takes = (be: CBackend, f: Function, arity: usize) bool {
    last_is_variadic(be, f).match({
        true  => (arity + 1) >= f.params.len,
        false => f.params.len == arity,
    })
}

// A member that is not a function has no parameter list, so arity says
// nothing and the first is still the whole answer — the function-valued
// FIELD `gen_c_member.zen` calls through, with nothing on it to count.
// Where every candidate IS a function, arity is an answer and a miss
// is a miss.
without_arity = (found: Vec<Member>) Res<Member> {
    any_function(found).match({
        true  => None,
        false => found.get(0),
    })
}

any_function = (found: Vec<Member>) bool {
    Range(0, found.len).find((i) {
        found.get(i).match({ Ok(m) => is_function(m), None => false })
    }).match({ Ok(_) => true, None => false })
}

is_function = (m: Member) bool {
    m.kind.match({ Function(_) => true, _ => false })
}

// -----------------------------------------------------------------
// a member an IMPL supplies
//
// `str` does not declare `eq`; `std.text` impls `Eq` on it. DESIGN.md's
// rule — "you satisfy requirements, you never impl storage" — means the
// member is an ordinary function of the receiver, living beside the
// type, reached under the TARGET's qualified name.
//
// And it is called statically: "can this struct be a bound" and "can
// it be a fat value" are two questions, and only the second needs a
// record of function pointers. Every call here has a receiver whose
// CONCRETE type is known, so the impl's function is called directly
// and monomorphised — a fat value is wanted only where a value's
// STATIC type is the bound, which nothing in this tree writes.
// -----------------------------------------------------------------

// The function an impl on this type supplies under `name`, when one
// does.
impl_member* = (be :: CBackend, decl: DeclId, name: str)
               Res<Res<Function>, AllocError> {
    found ::= be.alloc.Vec<Member>();
    impl_member_at(be, decl, name, found).try();
    Ok(bodied_fn(found));
}

// The same question asked of an impl, at a known arity.
impl_member_of* = (be :: CBackend, decl: DeclId, name: str, arity: usize)
                  Res<Res<Function>, AllocError> {
    found ::= be.alloc.Vec<Member>();
    impl_member_at(be, decl, name, found).try();
    Ok(member_fn_of(by_arity(be, found, arity)));
}

member_fn_of = (m: Res<Member>) Res<Function> {
    m.match({ Ok(x) => member_fn(x), None => None })
}

bodied_fn* = (found: Vec<Member>) Res<Function> {
    found.get(0).match({
        Ok(m) => member_fn(m),
        None  => None,
    })
}

member_fn = (m: Member) Res<Function> {
    m.kind.match({
        Function(f) => Ok(f),
        _           => None,
    })
}

// The expression an impl supplies for a computed field. A range's
// `start`/`end` and a bound's computed member are the same question
// asked of the same member list.
impl_field* = (be :: CBackend, im: Impl, name: str)
              Res<Res<ExprId>, AllocError> {
    found ::= be.alloc.Vec<ExprId>();
    im.members.loop((h, m) { keep_field_value(m, name, found).try() });
    Ok(found.get(0));
}

keep_field_value = (m: Member, name: str, out :: Vec<ExprId>)
                   Res<(), AllocError> {
    member_named(m, name).match({
        false => Ok(()),
        true  => add_field_value(m, out),
    })
}

add_field_value = (m: Member, out :: Vec<ExprId>) Res<(), AllocError> {
    m.kind.match({
        Field(fl) => add_written_value(fl, out),
        _         => Ok(()),
    })
}

add_written_value = (fl: Field, out :: Vec<ExprId>) Res<(), AllocError> {
    fl.value.match({ Ok(e) => out.add(e), None => Ok(()) })
}

// Every member an impl on `decl` supplies under `name`, with a BODY.
//
// "An impl lives with the type, not with the trait", so the search is
// over impls declared in the TARGET's own module — a same-named type
// elsewhere is never confused for this one. A required member — `at
// ::= (..) Res<T>` with no body — is what the impl OWES, not supplies;
// calling it would name a symbol nothing defines.
impl_member_at* = (be :: CBackend, decl: DeclId, name: str,
                   out :: Vec<Member>) Res<(), AllocError> {
    ids ::= be.alloc.Vec<ImplId>();
    be.check.world.impls_named(be.tree, decl_name(be, decl), ids).try();
    ids.loop((h, i) { collect_impl_fn(be, decl, i, name, out).try() });
    Ok(());
}

// The name a declaration's struct goes by — the key `impls_named` is
// asked with. Exported because finding a type's impls starts here
// whatever the caller wants them for.
decl_name* = (be :: CBackend, decl: DeclId) str {
    decl_at(be.tree, decl).match({
        Ok(d) => struct_name(d),
        None  => "",
    })
}

struct_name = (d: Decl) str {
    d.kind.match({
        Struct(st) => st.name.text,
        _          => "",
    })
}

collect_impl_fn = (be :: CBackend, decl: DeclId, i: ImplId, name: str,
                   out :: Vec<Member>) Res<(), AllocError> {
    (decl.module == i.decl.module).match({
        false => Ok(()),
        true  => impl_fn_at(be, i, name, out),
    })
}

impl_fn_at = (be :: CBackend, i: ImplId, name: str, out :: Vec<Member>)
             Res<(), AllocError> {
    be.check.world.impl_at(be.tree, i).match({
        Ok(im) => keep_impl_fn(be, i, im, name, out),
        None   => Ok(()),
    })
}

// The impl's own members, then the bound's defaults. "A struct whose
// fields happen to be functions, used as a bound, is what other
// languages call a trait", and `A.impl(B, {..})` supplies a value for
// every field `B` declares — so a bodied member on `B` is a field the
// bound ALREADY has a value for. `area` comes along free because it
// "only ever needed a width and a height".
//
// Both, not either/or. This once ran the bound only when the impl
// block supplied nothing of that name — reading a NAME as the unit
// when `sema_supply.zen` says the unit is an overload SET: `Display`
// declares a `toString` taking a sink and a sealed one taking an
// allocator; once an impl supplies the first, the second stops being a
// candidate. So `p.toString(alloc)` lowered to the sink symbol with an
// `Alloc` passed as a `Sink` — a record of NULL function pointers —
// for a call sema had resolved correctly.
//
// The order is the answer to an override: an impl entry restating a
// default comes first and wins every tie below, which is what "the
// impl supplies it" means.
keep_impl_fn = (be :: CBackend, i: ImplId, im: Impl, name: str,
                out :: Vec<Member>) Res<(), AllocError> {
    im.members.loop((h, m) { keep_named_fn(m, name, out).try() });
    keep_bound_default(be, i, im, name, out)
}

// A required member is still absent here — `keep_named_fn` keeps only
// what has a body (see `impl_member_at` above).
keep_bound_default = (be :: CBackend, i: ImplId, im: Impl, name: str,
                      out :: Vec<Member>) Res<(), AllocError> {
    bound = be.check.impl_bound_type(im, i.decl.module.to_usize()).try();
    members ::= be.alloc.Vec<Member>();
    be.check.bound_members(bound, members).try();
    members.loop((h, m) { keep_named_fn(m, name, out).try() });
    Ok(());
}

keep_named_fn = (m: Member, name: str, out :: Vec<Member>)
                Res<(), AllocError> {
    member_named(m, name).match({
        false => Ok(()),
        true  => add_bodied(m, out),
    })
}

add_bodied = (m: Member, out :: Vec<Member>) Res<(), AllocError> {
    m.kind.match({
        Function(f) => add_if_bodied(m, f, out),
        _           => Ok(()),
    })
}

add_if_bodied = (m: Member, f: Function, out :: Vec<Member>)
                Res<(), AllocError> {
    has_body(f).match({
        false => Ok(()),
        true  => out.add(m),
    })
}

// A DECLARATION WITH NO BODY IS NOT A DEFINITION. An impl entry that
// only restates the bound's signature supplies nothing, and calling it
// would name a symbol nothing defines — so it is filtered here rather
// than refused later.
has_body* = (f: Function) bool {
    f.body.match({ Ok(_) => true, None => false })
}
