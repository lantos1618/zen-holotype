// tests/corpus/std/eq_is_in_asks_each_types_own_eq.zen
// is_in is membership - the form a run of || was spelling out - and the
// comparison is the SUBJECT'S own eq, not a bytewise guess and not
// whichever eq was declared last
//
// Mark's eq is deliberately the opposite law to Tag's. Dispatch that
// picked by name rather than by type would read the two Mark lines as
// true/false instead of false/true, which is a wrong ANSWER and not a
// compile error - the only kind of failure worth a corpus program.
//
// The near misses are the other half: a prefix of a member and a member
// with something appended are both absent, so nothing here is comparing
// over the shorter length.

Tag = { n*: i32 }

Tag.impl(Eq, {
    eq ::= (self: @Self, other: @Self) bool { self.n == other.n }
})

Mark = { n*: i32 }

Mark.impl(Eq, {
    eq ::= (self: @Self, other: @Self) bool { self.n != other.n }
})

main = (env: Env) Res<i32, AllocError> {
    println("hit {}", "i32".is_in(["i8", "i16", "i32", "u8"]));
    println("miss {}", "f32".is_in(["i8", "i16", "i32", "u8"]));
    println("first {}", "i8".is_in(["i8", "i16", "i32", "u8"]));
    println("last {}", "u8".is_in(["i8", "i16", "i32", "u8"]));
    println("prefix {}", "i3".is_in(["i8", "i16", "i32", "u8"]));
    println("suffix {}", "i321".is_in(["i8", "i16", "i32", "u8"]));
    println("empty {}", "".is_in(["i8", "i16", "i32", "u8"]));
    println("one {}", "i8".is_in(["i8"]));
    println("tag {}", Tag(n: 2).is_in([Tag(n: 1), Tag(n: 2)]));
    println("tag miss {}", Tag(n: 9).is_in([Tag(n: 1), Tag(n: 2)]));
    println("mark same {}", Mark(n: 1).is_in([Mark(n: 1)]));
    println("mark diff {}", Mark(n: 1).is_in([Mark(n: 2)]));
    Ok(0);
}
