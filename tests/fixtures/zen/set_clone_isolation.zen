halloc = std.mem.heap
sets = std.collections.set
{ println } = std.text.fmt
main = () i32 {
    alloc := halloc.gpa()
    a := alloc.addr()
    x := sets.of(a, 1).expect("of")
    x = x.add(a, 2).expect("add")
    c := x.clone(a).expect("clone")
    c = c.add(a, 3).expect("add")
    c = c.add(a, 4).expect("add")
    println(c.len())
    println(x.len())
    println(x.has(3).match ({ true => 1, false => 0 }))
    println(c.has(1).match ({ true => 1, false => 0 }))
    x.free(a)
    c.free(a)
    0
}
