// POSTFIX BINDS TIGHTER THAN EVERY PREFIX — a call's or an index's
// argument list attaches to the operand before any unary operator does,
// so `-sq(4)` negates the RESULT of the call.
//
// The tower from D1 bottoms out at postfix (call 10 > unary 9 >
// multiplicative ...), and this is the end where the failure is silent:
// bind unary tighter than call and the program stops compiling (you
// cannot call a negated number), so it is caught — but fold the negation
// INTO the call's argument instead, a "constant-folding" shortcut real
// codegen has been known to take, and `-sq(4)` prints 16: plausible,
// signed, wrong by exactly the sign of one application. `sq(2) * sq(3)`
// is the other half: each call must complete before multiplication sees
// operands, giving 36 — a compiler that lets `*` grab a bare callee name
// cannot even type this, but one that reorders postfix below
// multiplicative CAN, and prints something else entirely.
//
// `xs[0] + xs[1] * 2` runs the whole tower at once: index above
// multiplicative above additive, 10 + 40 = 50, where additive-first
// grouping collapses it to 60 -- byte-identical to what the
// parenthesised twin `(xs[0] + xs[1]) * 2` prints, which is exactly why
// BOTH lines are asserted: in the broken world the pair stops
// discriminating, and `idxmul` goes red against this file's bytes.
//
// THE ONE-LINE BREAK: lower PREC.call/PREC.member below PREC.unary (or
// make unary_expression's operand skip the postfix layer). `negcall`
// flips -16 -> 16 via the folded-argument path; `idxmul` flips 50 -> 60.

sq = (x: i64) i64 { x * x }

main = (env: Env) Res<i32, AllocError> {
    println("negcall {}", -sq(4));
    println("calls {}", sq(2) * sq(3));

    // method syntax is postfix too: the receiver completes before the
    // operator outside reads the value. widen_i64 is std.core.num's
    // conversion bound on i32.
    n: i32 = 6;
    println("meth {}", n.widen_i64() + sq(1));

    xs: [i32, 2] = [10, 20];
    println("idxmul {}", xs[0] + xs[1] * 2);
    println("paren {}", (xs[0] + xs[1]) * 2);

    // everything in one spelling: the tree is (-((sq(3)) - 12)) % 5 =
    // (-(-3)) % 5 = 3 -- call first, then the paren group, then prefix,
    // then the multiplicative %. The sign is where a fold-into-literal
    // shortcut shows: -(9-12) is +3, and folding the minus inside the
    // parens prints -3.
    println("tower {}", -(sq(3) - 12) % 5);
    Ok(0);
}
