// Everything a folder-root alias is allowed to carry across the boundary:
// a starred type, a starred field, a starred method and a starred free
// function.
//
// `slack` and `rehome` have no star and must stay here. They are named,
// not omitted: a test that only proves what IS visible cannot tell a
// working gate from an absent one.

Bag* = {
    len* :: i32,
    slack :: i32 = 2,

    add* = (self :: @Self, n: i32) () {
        self.rehome();
        self.len = self.len + n;
    }

    rehome = (self :: @Self) () {
        self.len = self.len + 1;
    }
}

reseat* = (n: i32) i32 { n * 3 }
