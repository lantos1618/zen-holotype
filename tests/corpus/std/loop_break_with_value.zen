// tests/corpus/std/loop_break_with_value.zen
// h.break(value) makes the loop an EXPRESSION: it evaluates to
// Ok(value), and the passes after the break never run

main = (env: Env) Res<i32, AllocError> {
    seen ::= 0;
    Range(0, 10).loop((h, value) {
        seen = seen + 1;
        (value == 4).then(() { h.break(value * 100) });
    }).match({
        Ok(n) => println("broke with {}", n),
        None  => println("ran to the end"),
    })
    println("passes {}", seen);
    Ok(0);
}
