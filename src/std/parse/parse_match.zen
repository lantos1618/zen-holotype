// src/std/parse/parse_match.zen
// Match arms.
//
// "Control flow is one thing: `.match`, a method." So there is no
// match rule and no match statement — only the argument `.match`
// takes, which is what this file reads. `parse_expr.zen` recognises
// the call and hands over at the `{`.
//
// EXHAUSTIVENESS IS NOT HERE. "Match is always exhaustive, in every
// position: cover every case or write `_`" is a load-bearing
// correctness property and it is sema's, checked on the `Match` node
// this builds. A parser that tried would have to know what an enum is.
//
// `=>` IS LOCATED, not merely required. `Arm.arrow_span` exists
// because the formatter aligns arms on it, and it cannot align what it
// cannot find. It is taken before the token is consumed, so a missing
// `=>` still leaves the diagnostic and the span on the same token.

Alloc, AllocError = std.mem
Span, Pos, no_trivia = std.ast.ast_span
ExprId, PatternId = std.ast.ast_id
Arm = std.ast.ast_node
Token, TokenKind, same = std.parse.parse_token
Parser, Mark = std.parse.parser
pattern = std.parse.parse_pattern
expr = std.parse.parse_expr
block_expr = std.parse.parse_stmt

// `{ pattern => expr, .. }` — the arm list, and the span of the braces
// around it. A trailing comma is allowed; `DESIGN.md` writes one on
// every multi-line match it contains.
arms* = (p :: Parser, out :: Vec<Arm>) Res<Span, AllocError> {
    start = p.here();
    open = p.here_span();
    p.expect(
        TokenKind.BraceOpen,
        "expected `{` to open this `.match`'s arms"
    ).try();
    running ::= !p.at_kind(TokenKind.BraceClose) && !p.at_eof();
    loop(() { running }, (h) {
        before = p.at;
        out.add(p.one_arm().try()).try();
        running = !p.at_kind(
            TokenKind.BraceClose
        ) && !p.at_eof() && p.at > before;
    });
    p.expect_close(
        TokenKind.BraceClose,
        "unclosed `{`: these match arms are never closed",
        open
    ).try();
    Ok(p.span_from(start));
}

// One arm. It claims its own trailing trivia because a comment after
// an arm belongs to that arm and not to the next one — the
// `trivia_in_arm` and `trivia_between_arms` cases in
// tests/corpus/parse are exactly this line.
one_arm = (p :: Parser) Res<Arm, AllocError> {
    m = p.open();
    pat = p.pattern().try();
    arrow = p.here_span();
    p.expect(TokenKind.Arrow, "expected `=>` after this arm's pattern").try();
    body = p.arm_body().try();
    end = p.prev_end;
    span = p.span_from(m.start);

    // The arm consumes its OWN separator, and that is what makes
    // `Circle => "c",  // after an arm` attach to this arm rather than
    // become the leading trivia of the next one. The span is taken
    // first, because a node's span excludes the separator that follows
    // it (POSITIONS.md).
    p.eat(TokenKind.Comma).try();
    Ok(Arm(
        pattern: pat,
        arrow_span: arrow,
        body: body,
        span: span,
        leading: m.leading,
        trailing: p.claim_trailing(end),
    ));
}

// An arm's body is an expression or a block, and a block in value
// position is an expression too — `Err(_) => { room = false; h.break(); }`
// is written throughout the standard library.
arm_body = (p :: Parser) Res<ExprId, AllocError> {
    p.at_kind(TokenKind.BraceOpen).match({
        true  => p.block_expr(),
        false => p.expr(),
    });
}
