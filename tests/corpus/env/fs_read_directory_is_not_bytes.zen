// tests/corpus/env/fs_read_directory_is_not_bytes.zen
// A directory is not bytes, and saying so is the whole point: a
// compiler resolving `<folder>/<folder>.zen` walks candidate paths,
// and "this one is a folder" is the answer that tells it to descend
// rather than the answer that tells it to give up.
//
// `.` is the working directory, so this test asserts nothing about
// where the runner staged it.

FsError = std.env

main = (env: Env) Res<i32, FsError> {
    alloc ::= env.mem.alloc();

    env.fs.read(alloc, ".").match({
        Ok(text) => println("read {} bytes", text.len()),
        Err(NotFound) => println("not found"),
        Err(Denied) => println("denied"),
        Err(IsDir) => println(". is a directory"),
        Err(Failed) => println("failed"),
        Err(OutOfMemory) => println("out of memory"),
    });

    // the probes say the same thing without opening it
    println("exists {} is_dir {}", env.fs.exists("."), env.fs.is_dir("."));
    Ok(0);
}
