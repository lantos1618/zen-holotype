{ to_exit } = std.core.bool
{ String, new_in, push_in, finish_in } = std.text.string
{ len } = std.text.str
{ expect } = std.core.result
{ Allocator } = std.mem.alloc
alloc = std.mem.heap
push_byte = (s: String, a: Allocator, v: u8) String {
    s
        .push_in(a, v)
        .expect("push")
        .push_in(a, v)
        .expect("push")
}
build = (a: Allocator) StringView {
    a
        .new_in()
        .expect("new_in")
        .push_byte(a, 'x')
        .push_byte(a, 'x')
        .push_byte(a, 'x')
        .push_byte(a, 'x')
        .push_byte(a, 'x')
        .push_byte(a, 'x')
        .push_byte(a, 'x')
        .push_byte(a, 'x')
        .finish_in(a)
        .expect("finish")
}
main = () i32 {
    heap := alloc.gpa()
    s := build(heap.addr())
    (s.len() == 16).to_exit()
}
