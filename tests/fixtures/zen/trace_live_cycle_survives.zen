// A cycle that is still LIVE — an external reference on a member — must SURVIVE collection, and
// the collector must terminate while restoring it. This is the case trial deletion exists for:
// mark paints the cycle grey and decrements internal counts, scan finds a member whose count is
// still positive (the external ref), and scan-black walks the cycle putting the counts back.
//
// Every other trace fixture collects a graph where EVERYTHING is garbage, so gather runs and the
// restore path never executes. Without the colour guard in cc_scan_black, restoring re-enters
// through the cycle's own back edge forever: this program printed `1` and then died with
// `zen: panic: stack overflow (recursion too deep)`, never reaching `2`.
//
// Exit 0 means both phases ran: the live cycle survived AND a fully-garbage cycle still collects.
{ to_exit } = std.core.bool
{ expect } = std.core.result
halloc = std.mem.heap
trace = std.mem.trace
// A 2-cycle with one external reference. Must terminate and must NOT reclaim the cycle.
live_cycle_survives = () bool {
    h = halloc.gpa()
    a = h.addr()
    x = trace.tracked_in(a, trace.Node(
        has: 0,
        kid: null_ptr(),
    )).expect("tracked x")
    y = trace.tracked_in(a, trace.Node(
        has: 0,
        kid: null_ptr(),
    )).expect("tracked y")
    trace.set_kid(x, y)
    trace.set_kid(y, x)
    x.inc()    // the external reference that keeps the cycle alive
    trace.root_in(a, x).expect("root x")
    trace.collect_in(a).expect("collect")
    // Reached only if the restore terminated; a second pass must be stable too.
    trace.root_in(a, x).expect("root x again")
    trace.collect_in(a).expect("collect again")
    true
}
// The all-garbage path the existing fixtures cover — must keep working after the guard.
garbage_cycle_collects = () bool {
    h = halloc.gpa()
    a = h.addr()
    p = trace.tracked_in(a, trace.Node(
        has: 0,
        kid: null_ptr(),
    )).expect("tracked p")
    q = trace.tracked_in(a, trace.Node(
        has: 0,
        kid: null_ptr(),
    )).expect("tracked q")
    trace.set_kid(p, q)
    trace.set_kid(q, p)
    trace.root_in(a, p).expect("root p")
    trace.collect_in(a).expect("collect")
    true
}
main = () i32 { (live_cycle_survives() && garbage_cycle_collects()).to_exit() }
