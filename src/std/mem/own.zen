// @self-hosted-only: generic Drop dispatch depends on self-hosted
// monomorphization and the post-inline resolve pass.
//
// TLDR:
// - `Drop` is the destructor trait: `drop: (self: MutPtr<Self>) void`.
// - `Own<T>` is a ref-counted owner with layout [count:i64 | value:T].
// - `clone` bumps the count; `release` decrements it.
// - At zero, `release` calls the payload's `.drop()` before freeing the block.
// - `new_in` / `release_in` use the caller's allocator.
// - `new_in` returns Result so allocation failure stays in the value flow.
// - `Resource` at the bottom is only a concrete fixture for tests/examples.
{ AllocatorBackend, val_slot, rc_block_new_in } = std.mem.alloc
{ Result, IoError, ok, err } = std.core.result
Drop*: {
    drop: (self: MutPtr<Self>) void,
}
Own*<T>: {
    base: RawPtr<u8>,
    val   = (o: Own<T>) MutSlice<T> { val_slot<T>(o.base) }
    get   = (o: Own<T>) T { o.val()[0] }
    ptr   = (o: Own<T>) MutPtr<T> { o.val()[0].addr() }
    count = (o: Own<T>) i64 { load_i64(o.base) }
    clone = (o: Own<T>) Own<T> {
        store_i64(o.base, load_i64(o.base) + 1)
        Own<T>(base: o.base)
    }
    release_in = (o: Own<T>, a: AllocatorBackend) void {
        n = load_i64(o.base) - 1
        store_i64(o.base, n)
        (n == 0).then({
            o.finalize_in(a)
        })
    }
    finalize_in = (o: Own<T>, a: AllocatorBackend) void {
        o.ptr().drop()
        a.release(o.base)
    }
}
new_in*<T> = (a: AllocatorBackend, x: T) Result<Own<T>, IoError> {
    rc_block_new_in(a, x).match ({
        .Ok(base) => ok(Own<T>(base: base)),
        .Err(e)   => err(e),
    })
}
Resource*: {
    id: i32,
    slot: i32,
}
Resource.impl(Drop, {
    drop = (s: MutPtr<Resource>) void { s.slot = s.id }
})
