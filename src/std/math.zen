//! link: m
// std.math — allocation-free i64 helpers and f64 math.
//
// Bodyless declarations bind directly to C libm. Zen has no overloading, so
// transcendental functions use f64 and integer-specific helpers use i64.
{ step_while } = std.core.count
// Constants
PI* = 3.141592653589793
E* = 2.718281828459045
TAU* = 6.283185307179586
SQRT2* = 1.4142135623730951
LN2* = 0.6931471805599453
LN10* = 2.302585092994046
// Zen has no infinity or NaN literals. Floating-point division by zero follows IEEE-754.
INF* = 1.0 / 0.0
NAN* = 0.0 / 0.0
// Integer helpers
// abs(min_i64) cannot be represented and wraps.
abs* = (x: i64) i64 { (x < 0).then({ 0 - x }, { x }) }
sign* = (x: i64) i64 {
    (x > 0).match ({
        true  => 1,
        false => (x < 0).then({ 0 - 1 }, { 0 }),
    })
}
// Euclid's algorithm. gcd(0, 0) = 0.
gcd* = (a: i64, b: i64) i64 { (b == 0).then({ a.abs() }, { gcd(b, a % b) }) }
// Dividing before multiplying reduces the chance of intermediate overflow.
lcm* = (a: i64, b: i64) i64 { (a == 0 || b == 0).then({ 0 }, { (a / gcd(a, b) * b).abs() }) }
// Exponentiation by squaring. Negative exponents have no integer result and return 0.
ipow* = (base: i64, exp: i64) i64 {
    (exp < 0).match ({
        true  => 0,
        false => {
            result ::= 1
            factor ::= base
            exp.step_while((e) { e > 0 }, (e) {
                (e % 2 == 1).then({
                    result = result * factor
                })
                factor = factor * factor
                e / 2
            })
            result
        },
    })
}
// Kept as the descriptive spelling of ipow.
pow_i* = (base: i64, exp: i64) i64 { ipow(base, exp) }
// Largest r such that r*r <= n. Returns 0 for n <= 0.
isqrt* = (n: i64) i64 {
    (n <= 0).match ({
        true  => 0,
        false => {
            x ::= n
            // n / 2 + 1 is equivalent to (n + 1) / 2 without overflowing at max_i64.
            (n / 2 + 1).step_while((next) { next < x }, (next) {
                x = next
                (x + n / x) / 2
            })
            x
        },
    })
}
// Generic algebra
min*<T> = (a: T, b: T) T { (a < b).then({ a }, { b }) }
max*<T> = (a: T, b: T) T { (a > b).then({ a }, { b }) }
// Assumes lo <= hi.
clamp*<T> = (x: T, lo: T, hi: T) T {
    (x < lo).match ({
        true  => lo,
        false => (x > hi).then({ hi }, { x }),
    })
}
// t is not clamped.
lerp*<T> = (a: T, b: T, t: T) T { a + (b - a) * t }
// Float helpers
fabs* = (x: f64) f64
// NaN maps to 0.0.
fsign* = (x: f64) f64 {
    (x > 0.0).match ({
        true  => 1.0,
        false => (x < 0.0).then({ 0.0 - 1.0 }, { 0.0 }),
    })
}
fmin* = (a: f64, b: f64) f64 { min<f64>(a, b) }
fmax* = (a: f64, b: f64) f64 { max<f64>(a, b) }
// Integer exponent, including min_i64, in O(log |exp|) multiplications.
fpow* = (base: f64, exp: i64) f64 {
    result ::= 1.0
    factor ::= (exp < 0).then({ 1.0 / base }, { base })
    exp.step_while((e) { e != 0 }, (e) {
        (e % 2 != 0).then({
            result = result * factor
        })
        factor = factor * factor
        e / 2
    })
    result
}
degrees* = (rad: f64) f64 { rad * (180.0 / PI) }
radians* = (deg: f64) f64 { deg * (PI / 180.0) }
// Float classification
isnan* = (x: f64) bool { x != x }
isinf* = (x: f64) bool { x == INF || x == 0.0 - INF }
isfinite* = (x: f64) bool { (isnan(x) || isinf(x)) == false }
// Roots and powers
sqrt* = (x: f64) f64
cbrt* = (x: f64) f64
pow* = (base: f64, exp: f64) f64
// Avoids intermediate overflow in sqrt(x*x + y*y).
hypot* = (x: f64, y: f64) f64
// Exponentials and logarithms
exp* = (x: f64) f64
exp2* = (x: f64) f64
expm1* = (x: f64) f64
log* = (x: f64) f64
log2* = (x: f64) f64
log10* = (x: f64) f64
log1p* = (x: f64) f64
// Trigonometry (radians)
sin* = (x: f64) f64
cos* = (x: f64) f64
tan* = (x: f64) f64
asin* = (x: f64) f64
acos* = (x: f64) f64
atan* = (x: f64) f64
atan2* = (y: f64, x: f64) f64
sinh* = (x: f64) f64
cosh* = (x: f64) f64
tanh* = (x: f64) f64
// Rounding and remainder
floor* = (x: f64) f64
ceil* = (x: f64) f64
round* = (x: f64) f64
trunc* = (x: f64) f64
fmod* = (x: f64, y: f64) f64
