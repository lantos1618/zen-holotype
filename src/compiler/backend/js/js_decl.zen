// compiler.backend.js.js_decl — function, parameter, and global declaration JS-emission over the genc AST.
// Extracted from compiler.backend.js.js; consumes statement emission + the width/typed-var table from
// compiler.backend.js.js_expr, and name mangling from compiler.backend.js.js_lit. Module assembly stays in compiler.backend.js.js.
{ String } = std.text.string
{ Func, Param, GlobalData } = compiler.ast.ast_types
{ gstr_append } = compiler.genc
{ Malloc } = std.mem.alloc
{ jint, jname } = compiler.backend.js.js_lit
{ js_stmts, js_expr, int_width, js_w_open, js_w_close, vw_note, vw_reset, set_ret_w, js_boxed_w } = compiler.backend.js.js_expr
{ js_box_reset, js_box_scan } = compiler.backend.js.js_box
{ js_cp_needed, js_cp_open, js_cp_close } = compiler.backend.js.js_copy
// ── declarations ──────────────────────────────────────────────────────────────────────────────────
// a function; every param is a bare JS name (types erased). `main` becomes `zen_main`.
js_func_name = (s: String, a: MutPtr<Malloc>, name: StringView) String {
    (name == "main").then({ s.gstr_append(a, "zen_main") }, { s.jname(a, name) })
}
js_params = (s: String, a: MutPtr<Malloc>, ps: [Param]) String {
    out ::= s
    ps.loop((h, i, p) {
        out = (i == 0).then({ out }, { out.gstr_append(a, ", ") })
        out = out.jname(a, p.name)
    })
    out
}
js_param_norms = (s: String, a: MutPtr<Malloc>, ps: [Param]) String {
    out ::= s
    ps.loop((h, i, p) {
        vw_note(p.name, p.ty)
        out = out.js_param_norm(a, p)
    })
    out
}
// A param is coerced to its declared width at entry (C truncates there), COPIED there if it is a
// struct/enum/slice VALUE (C's by-value parameter passing: a callee that writes its param must not
// reach the caller's), and then — if the body takes its address — moved into a linear-memory cell, so
// `addr(p)` yields a real offset. Order matters: the value is width-correct BEFORE it is written into
// the cell, and the copy is what the cell then holds. The three are mutually exclusive by type.
js_param_norm = (s: String, a: MutPtr<Malloc>, p: Param) String {
    w = int_width(p.ty)
    normed = (w == 0).match ({
        true  => s.js_param_copy(a, p),
        false => s
            .jname(a, p.name)
            .gstr_append(a, " = ")
            .js_w_open(a, w)
            .jname(a, p.name)
            .js_w_close(a, w)
            .gstr_append(a, "; "),
    })
    bw = js_boxed_w(p.name)
    (bw == 0).match ({
        true  => normed,
        false => normed
            .jname(a, p.name)
            .gstr_append(a, " = __zr.box(")
            .jname(a, p.name)
            .gstr_append(a, ", ")
            .jint(a, bw)
            .gstr_append(a, "); "),
    })
}
js_param_copy = (s: String, a: MutPtr<Malloc>, p: Param) String {
    js_cp_needed(p.ty).match ({
        true  => s
            .jname(a, p.name)
            .gstr_append(a, " = ")
            .js_cp_open(a, p.ty)
            .jname(a, p.name)
            .js_cp_close(a, p.ty)
            .gstr_append(a, "; "),
        false => s,
    })
}
js_func* = (s: String, a: MutPtr<Malloc>, f: Func) String {
    vw_reset(a)
    js_box_reset(a)
    js_box_scan(f.body)    // BEFORE emission: `addr(x)` may appear textually after x's `let`
    set_ret_w(int_width(f.ret))
    s
        .gstr_append(a, "function ")
        .js_func_name(a, f.name)
        .gstr_append(a, "(")
        .js_params(a, f.params)
        .gstr_append(a, ") { ")
        .js_param_norms(a, f.params)
        .js_stmts(a, f.body)
        .gstr_append(a, "}\n")
}
// a module-level global `name ::= init` -> `let name = init;` (mutable; some are scheduler/runtime state).
js_global* = (s: String, a: MutPtr<Malloc>, g: GlobalData) String {
    s
        .gstr_append(a, "let ")
        .jname(a, g.name)
        .gstr_append(a, " = ")
        .js_expr(a, g.init)
        .gstr_append(a, ";\n")
}
