// src/std/std.zen
//
// The library's whole surface, in one file of starred re-exports.
// A folder root is its folder's public surface and nothing else;
// anything absent is module-private on purpose (`grow`, `Entry`).
//
// Each line mirrors a module root, itself a file of starred
// re-exports, so a module can move a declaration between its own
// files without this file changing.
//
// std.core is the prelude and auto-imported, but is re-exported
// anyway so `std.Res` names the same type the prelude does.

Res*, Ok*, Err*, None*, ok_or*, then*, bool* = std.core
Drop*, Scope* = std.core
i8*, i16*, i32*, i64* = std.core
u8*, u16*, u32*, u64*, usize* = std.core
f32*, f64* = std.core
loop*, find*, filter*, map*, LoopHandle*, Range* = std.core
Eq*, Hash*, Hasher*, Display* = std.core
IoError*, WriteError*, Sink*, Path*, Duration* = std.core

// the allocator, and the law: no Alloc parameter, no allocation.
// Ptr and null_ptr are the raw floor everything above stands on
AllocError*, Alloc*, Arena*, Mem*, Ptr*, null_ptr* = std.mem

// str is borrowed bytes; String is owned, growable, and IS the Vec
str*, String* = std.text

// Entry is absent because it has no star: collections are sealed,
// and what a Map is made of is not part of what a Map is
Vec*, Map* = std.collections

// json is streaming both ways — the value arena keeps a number's
// lexeme and a reply assembles as text through `Nest` — because a
// tree-shaped document model would cost twenty thousand allocations
// per keystroke where this costs zero. The LSP was its first caller;
// `src/lsp/lsp_json.zen`'s own move note is why it is here now.
JsonId*, Run*, Pair*, Json*, Jsons*,
    write_text*, whole_of*, written*, Nest*, obj*, arr*,
    JsonFault*, MAX_NESTING*, Reader*, read*,
    fine*, faulted*, faulted_ok* = std.json

// the capability root. all authority flows from the Env main receives
Env*, Console*, Fs*, FsError*, Net*, ArgError* = std.env
Threads*, Thread*, ThreadError* = std.env

TestError*, Tester*, Bencher*, BenchStats* = std.test

BuildError*, BuildFault*, Package*, Builder*, Budget* = std.build
Os*, Arch*, Dep*, Exe*, Lib*, Extern*, Test*, Bench* = std.build

// std.actor and std.thread — the scheduler and its behaviors — arrive
// at stage 5, outside the seed subset: no line here until then; the
// compiler never imports them. The raw Threads capability above is
// already real (std.env): a thread is the one authority that outlives
// its creator, so it hangs off Env as the escape hatch — the actor
// runtime is what waits.
