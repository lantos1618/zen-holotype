// pthread-backed synchronization. with() takes a non-capturing function and an explicit state pointer.
{ zeroed, release } = std.mem.raw
{ panic } = std.core.result
{ is_null } = std.core.ptr
{ pthread_mutex_init, pthread_mutex_lock, pthread_mutex_unlock, pthread_mutex_destroy } = std.c.libc
{ pthread_cond_init, pthread_cond_wait, pthread_cond_signal, pthread_cond_broadcast,
  pthread_cond_destroy } = std.c.libc
// Sized for the largest supported ABI; Darwin arm64 requires a 64-byte mutex cell.
MUTEX_SIZE = 64
COND_SIZE = 64
Mutex*: {
    raw: RawPtr<u8>,
    lock = (m: Mutex) void {
        pthread_mutex_lock(m.raw)
        { }
    }
    unlock = (m: Mutex) void {
        pthread_mutex_unlock(m.raw)
        { }
    }
    with = (m: Mutex, body: (argument: RawPtr<u8>) void, arg: RawPtr<u8>) void {
        pthread_mutex_lock(m.raw)
        body(arg)
        pthread_mutex_unlock(m.raw)
        { }
    }
    destroy = (m: Mutex) void {
        pthread_mutex_destroy(m.raw)
        release(m.raw)
    }
}
new_mutex* = () Mutex {
    raw = zeroed(MUTEX_SIZE)
    is_null(raw).then({
        panic("sync: mutex cell allocation failed")
    })
    pthread_mutex_init(raw, null_ptr())
    Mutex(raw: raw)
}
// wait atomically unlocks and relocks m; callers must hold m and recheck after spurious wakeups.
CondVar*: {
    raw: RawPtr<u8>,
    wait = (c: CondVar, m: Mutex) void {
        pthread_cond_wait(c.raw, m.raw)
        { }
    }
    signal = (c: CondVar) void {
        pthread_cond_signal(c.raw)
        { }
    }
    broadcast = (c: CondVar) void {
        pthread_cond_broadcast(c.raw)
        { }
    }
    destroy = (c: CondVar) void {
        pthread_cond_destroy(c.raw)
        release(c.raw)
    }
}
new_cond* = () CondVar {
    raw = zeroed(COND_SIZE)
    is_null(raw).then({
        panic("sync: condvar cell allocation failed")
    })    // as new_mutex, above
    pthread_cond_init(raw, null_ptr())
    CondVar(raw: raw)
}
// Once publishes completion through a sequentially consistent atomic flag.
Once: {
    flag: RawPtr<u8>,
    mtx: Mutex,
    run = (o: Once, body: (argument: RawPtr<u8>) void, arg: RawPtr<u8>) void {
        (atomic_load_i64(o.flag) != 0 == false).then({
            o.mtx.lock()    // -> atomic i64 cell
            (atomic_load_i64(o.flag) == 0).then({
                body(arg)    // re-check under the lock (another thread may have won)
                atomic_store_i64(o.flag, 1)
            })
            o.mtx.unlock()
        })
    }
    destroy = (o: Once) void {
        release(o.flag)
        o.mtx.destroy()
    }
}
new_once = () Once {
    flag = zeroed(8)
    Once(
        flag: flag,
        mtx: new_mutex(),
    )
}
