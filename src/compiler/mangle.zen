// Mangled bytes are ABI and generic-instance identity. `mangle_ty` is the source of truth;
// `mangle_str_in` builds the
// full instance name by appending `mangle_ty` per arg, so the byte length is derived from the actual
// bytes written — there is no separate measure/write cascade to drift out of sync.
{ view } = std.text.str
{ Allocator } = std.mem.alloc
{ Ty, Field, FnTData } = compiler.ast.ast_types
{ k_mut_ptr, k_raw_ptr, write_str, finish_buf,
  acquire_or_die } = compiler.genc
{ dec_digit } = compiler.astops
{ loop_at } = std.core.count
// the monomorphized C name of a generic instance: `Box<i32>` -> `Box_i32`, `Vec<Ptr<u8>>` ->
// `Vec_ptr_u8`. Pointer KINDS get distinct fragments (`rawptr_`/`ptr_`/`mutptr_`) even though all
// still lower to `T*`; the name is also the generic-instance identity used by mono/check dedup.
// A C identifier fragment per arg (prims by name, a nested generic by its own mangled name).
ptr_mangle_prefix = (s: String, a: Allocator, kind: i32) String {
    (kind == k_raw_ptr()).match ({
        true  => s.add("rawptr_"),
        false => (kind == k_mut_ptr()).match ({
            true  => s.add("mutptr_"),
            false => s.add("ptr_"),
        }),
    })
}
// Slice mutability is a CHECKER distinction over one `{ptr,len}` layout, so it is deliberately
// absent from `mangle_ty` (the ABI/layout name: both kinds are `zslice`) and present here, in the
// semantic key — a generic body that STORES through its `[T]` parameter must not be reused for a
// read-only `Slice<T>` instantiation, which is exactly what this mangler exists to prevent.
slice_mangle_prefix = (s: String, a: Allocator, kind: i32) String {
    (kind == k_mut_ptr()).then({ s.add("slice_") }, { s.add("roslice_") })
}
mangle_ty = (s: String, a: Allocator, t: Ty) String {
    t.match ({
        .I32           => s.add("i32"),
        .I64           => s.add("i64"),
        .U8            => s.add("u8"),
        .F64           => s.add("f64"),
        .Bool          => s.add("bool"),
        // ABI/layout name: the family is still `const char*` in Phase 1, so aggregate C instances may
        // share one layout. Recursive generic FUNCTIONS use mangle_semantic_in below instead.
        .StringView    => s.add("str"),
        .StringCstr    => s.add("str"),
        .StringLiteral => s.add("str"),
        .Void          => s.add("void"),
        .Named(n)      => s.add(n),
        .Generic(g)    => s.add(g.mangled),
        .Ptr(pd)       => s.ptr_mangle_prefix(a, pd.kind).mangle_ty(a, load(pd.pointee)),
        .Slice(e)      => s.add("slice_").mangle_ty(a, load(e.pointee)),
        .FnT(ft)       => s.add("fn"),
    })
}
// the C typedef name for a function type, used when a function VALUE needs a precise C type that an
// append-style declarator can't spell (a function RETURN type): `(AppState,i32)AppState` ->
// `__fnt_AppState_i32_r_AppState`. The matching `typedef Ret (*name)(Args);` is emitted by c_emit.
fnt_cname* = (a: Allocator, ft: FnTData) StringView {
    s ::= a.String(48).add("__fnt")
    ft.params.loop_at((i, p) { s = s.add("_").mangle_ty(a, p) })
    s.add("_r_").mangle_ty(a, load(ft.ret)).finish_cstr()
}
// `base<args…>` -> `base_<arg0>_<arg1>…`. Built by appending `mangle_ty` per arg into a String, so the
// name's length is EXACTLY the bytes written — a single ABI cascade (mangle_ty) with no parallel
// measure/write copies to desync (the seed fixpoint would surface any mismatch as a re-keyed symbol).
mangle_str_in* = (a: Allocator, base: StringView, args: MutSlice<Ty>) StringView {
    out ::= a.String(base.view().len + 16).add(base)
    args.loop_at((i, t) { out = out.add("_").mangle_ty(a, t) })
    out.finish_cstr()
}
// Semantic instance key for recursive/hidden-return generic FUNCTIONS. Aggregate ABI names may share
// a layout while string_* all lower to const char*, but function bodies carry checker-stamped return
// provenance. Keeping those function names distinct prevents an unrelated import from deciding whether
// `expect(Result<StringCstr, E>)` reuses a StringView-specialized body.
mangle_semantic_ty = (s: String, a: Allocator, t: Ty) String {
    t.match ({
        .I32           => s.add("i32"),
        .I64           => s.add("i64"),
        .U8            => s.add("u8"),
        .F64           => s.add("f64"),
        .Bool          => s.add("bool"),
        .StringView    => s.add("StringView"),
        .StringCstr    => s.add("StringCstr"),
        .StringLiteral => s.add("StringLiteral"),
        .Void          => s.add("void"),
        .Named(n)      => s.add(n),
        .Generic(g)    => {
            out ::= s.add(g.name)
            g.args.loop_at((i, x) { out = out.add("_").mangle_semantic_ty(a, x) })
            out
        },
        .Ptr(pd)       => s.add("ptr_").mangle_semantic_ty(a, load(pd.pointee)),
        .Slice(e)      => s.slice_mangle_prefix(a, e.kind).mangle_semantic_ty(a, load(e.pointee)),
        .FnT(ft)       => {
            out ::= s.add("fn")
            ft.params.loop_at((i, x) { out = out.add("_").mangle_semantic_ty(a, x) })
            out.add("_r_").mangle_semantic_ty(a, load(ft.ret))
        },
    })
}
mangle_semantic_in* = (a: Allocator, base: StringView, args: MutSlice<Ty>) StringView {
    out ::= a.String(64).add(base)
    args.loop_at((i, x) { out = out.add("_").mangle_semantic_ty(a, x) })
    out.finish_cstr()
}
// `ns.Type` — a dotted qualified name. The FAITHFUL parser (fmt) keeps a namespace-qualified struct
// literal's `ns.` prefix (`trace.Node(has: 0)`) so the formatter round-trips it verbatim; the flatten
// pipeline resolves `ns.Type` to `Type` BEFORE parsing, so only fmt reaches the dotted form.
dotted_name_in* = (a: Allocator, ns: StringView, name: StringView) StringView {
    n = ns.view().len + 1 + name.view().len
    buf: RawPtr<u8> = a.acquire_or_die(n + 1)
    end = buf.write_str(buf.write_str(buf.write_str(0, ns), "."), name)
    buf.finish_buf(end)
}
// ── indexed enum-payload record naming ──────────────────────────────────────────
// Multi-value enum payloads lower to records with ordered `_0`, `_1`, ... fields. The declaration
// and constructor use the same generated `__payload...` name, and the parser hoists each distinct
// payload record as an ordinary StructDecl for checking and code generation.
payload_fields_len = (fields: MutSlice<Field>) i64 {
    n ::= 0
    fields.loop_at((i, f) { n = n + 1 + f.name.view().len })    // 1 for the '_' separator
    n
}
payload_write_fields = (dst: RawPtr<u8>, at: i64, fields: MutSlice<Field>) i64 {
    out ::= at
    fields.loop_at((i, f) {
        out = dst.write_str(out, "_")
        out = dst.write_str(out, f.name)
    })
    out
}
mangle_payload_in* = (a: Allocator, fields: MutSlice<Field>) StringView {
    n = 9 + fields.payload_fields_len()    // "__payload" = 9 bytes
    buf: RawPtr<u8> = a.acquire_or_die(n + 1)
    end = buf.payload_write_fields(buf.write_str(0, "__payload"), fields)
    buf.finish_buf(end)
}
// The positional field name `_<i>` (`_0`, `_1`, …) for a synthesized multi-field variant payload struct
// (`B(i32, i32)` ≡ `B({_0: i32, _1: i32})`). The SAME generator feeds the enum-decl payload type and the
// `.B(a, b)` constructor, so their payload-record names mangle identically.
pf_write = (dst: RawPtr<u8>, at: i64, v: i32) i64 {
    (v < 10).match ({
        true  => {
            dst.offset(at).store(dec_digit(v.to_i64()))
            at + 1
        },
        false => {
            np = dst.pf_write(at, v / 10)
            dst.offset(np).store(dec_digit((v % 10).to_i64()))
            np + 1
        },
    })
}
// A unique local name `__chaintmp_<pos>` for the temp a chained call `f(a)(b)` binds its closure
// callee to (see compiler.parse_expr.parse_chained_call). `pos` is the call's byte offset, unique
// per source, so sibling/nested chained calls never collide.
chain_tmp_name* = (a: Allocator, pos: i32) StringView {
    buf: RawPtr<u8> = a.acquire_or_die(32)
    buf.finish_buf(buf.pf_write(buf.write_str(0, "__chaintmp_"), pos))
}
// A unique local name `__comptmp_<pos>_<k>` for a hoisted compound-assign index (see the
// compiler.parse_stmt comp_* desugars). `pos` is the statement's byte offset (unique per source) and
// `k` the index ordinal within the place, so sibling hoists in one statement never collide; the `__`
// prefix keeps it out of the user namespace (same convention as chain_tmp_name).
comp_tmp_name* = (a: Allocator, pos: i32, k: i32) StringView {
    buf: RawPtr<u8> = a.acquire_or_die(40)
    buf.finish_buf(buf.pf_write(buf.write_str(buf.pf_write(buf.write_str(0, "__comptmp_"), pos), "_"), k))
}
// Unique local for evaluate-once match lowering. The first arm/literal position is source-unique.
match_tmp_name* = (a: Allocator, pos: i32) StringView {
    buf: RawPtr<u8> = a.acquire_or_die(32)
    buf.finish_buf(buf.pf_write(buf.write_str(0, "__matchtmp_"), pos))
}
payload_fname* = (a: Allocator, idx: i32) StringView {
    buf: RawPtr<u8> = a.acquire_or_die(24)
    buf.finish_buf(buf.pf_write(buf.write_str(0, "_"), idx))
}
// the mangled C name of a trait method's concrete impl: `impl_<Trait>_<Type>_<method>` — so two
// types implementing the same trait method emit DISTINCT C functions. UFCS dispatch routes `x.m()` to
// the impl for x's type (compiler.check dispatch_name).
impl_cname_in* = (a: Allocator, trname: StringView, ty: StringView, method: StringView) StringView {
    n = 5 + trname.view().len + 1 + ty.view().len + 1 + method.view().len
    buf: RawPtr<u8> = a.acquire_or_die(n + 1)
    p1 = buf.write_str(0, "impl_")
    p2 = buf.write_str(p1, trname)
    p3 = buf.write_str(p2, "_")
    p4 = buf.write_str(p3, ty)
    p5 = buf.write_str(p4, "_")
    buf.finish_buf(buf.write_str(p5, method))
}
