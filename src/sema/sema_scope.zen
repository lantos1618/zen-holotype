ExprId, BlockId, Block, Call, Struct = std.ast
Paren, Access, Member, Function, Param, Span, TypeId = std.ast
Try, Name, Expr = std.ast
Vec = std.collections
spelled_name = sema.sema_handle
AllocError = std.mem
str = std.text
Range = std.core
DeclId = sema.sema_id
decl_at = sema.sema_def
Checker, UNRESOLVED = sema.sema_check
tail_expr = sema.sema_hoist
SemaFault, NameFault = sema.sema_diag
Own, place_type, path_root, joined_source, access_view, returned_view = sema.sema_own
TyId = sema.sema_ty
own_member = sema.sema_recv
call_callee = sema.sema_call

// `@scope` names the enclosing block: it may be passed inward but never
// returned, stored in a construction, or read by an escaping closure. A
// value backed by an arena this body made may not be returned either.

check_scope_returned* = (c :: Checker, o :: Own, id: BlockId, b: Block)
                         Res<(), AllocError> {
    (id.index == o.body.index).match({
        false => Ok(()),
        true  => c.tail_expr(b).match({
            None  => Ok(()),
            Ok(v) => c.refuse_scope_returned(o, v),
        }),
    })
}

check_scope_stored* = (c :: Checker, id: ExprId, k: Call)
                      Res<(), AllocError> {
    c.is_construction(id).match({
        false => Ok(()),
        true  => c.refuse_scope_args(k),
    })
}

is_construction* = (c :: Checker, id: ExprId) bool {
    c.resolved_call(id).match({
        None  => false,
        Ok(d) => c.decl_is_struct(d),
    })
}

decl_is_struct = (c :: Checker, d: DeclId) bool {
    c.tree.decl_at(d).match({
        None   => false,
        Ok(dc) => dc.kind.match({ Struct(_) => true, _ => false }),
    })
}

refuse_scope_args = (c :: Checker, k: Call) Res<(), AllocError> {
    k.args.loop((h, a) { c.refuse_scope_expr(a.value).try() });
    Ok(());
}

refuse_scope_expr = (c :: Checker, id: ExprId) Res<(), AllocError> {
    node = c.tree.expr_at(id);
    node.kind.match({
        Scope    => c.refuse(
            node.span,
            SemaFault.ScopeEscapes(NameFault(name: ""))
        ),
        Paren(p) => c.refuse_scope_expr(p.inner),
        _        => Ok(()),
    })
}

check_scope_captured* = (c :: Checker, o :: Own, span: Span, text: str)
                        Res<(), AllocError> {
    o.captures_scope(text).match({
        false => Ok(()),
        true  => c.refuse(span, SemaFault.ScopeEscapes(NameFault(name: text))),
    })
}

// The expression through which a `@scope` leaves, if one does.
scope_escape = (c :: Checker, o :: Own, id: ExprId) Res<ExprId> {
    c.scope_carries(o, id).match({
        false => None,
        true  => c.scope_escape_of(o, id),
    })
}

scope_escape_of = (c :: Checker, o :: Own, id: ExprId) Res<ExprId> {
    c.tree.expr_at(id).kind.match({
        Scope         => Ok(id),
        Name(n)       => o.scoped_var(n.text).match({ true => Ok(id), false => None }),
        Paren(p)      => c.scope_escape(o, p.inner),
        Try(t)        => c.scope_escape(o, t.operand),
        Access(_)     => c.scope_field_escape(o, id),
        Index(x)      => c.scope_escape(o, x.base),
        Array(a)      => c.scope_escape_in_values(o, a.elems),
        FixedArray(a) => c.scope_escape_in_values(o, a.elems),
        Match(m)      => m.arms.find(
            (arm) { c.scope_escapes(o, arm.body) }
        ).match({
            None => None, Ok(arm) => c.scope_escape(o, arm.body),
        }),
        Block(b)      => o.block_scoped(b).match({ true => Ok(id), false => None }),
        Call(k)       => c.returned_view(o, id, k, "").match({
            None     => c.scope_escape_in_args(o, k),
            Ok(view) => view.scoped.match({ true => Ok(id), false => None }),
        }),
        _             => None,
    })
}

scope_field_escape = (
    c  :: Checker,
    o  :: Own,
    id : ExprId
) Res<ExprId> {
    c.access_view(o, id).scoped.match({ true => Ok(id), false => None })
}

scope_escape_in_values = (
    c      :: Checker,
    o      :: Own,
    values : Vec<ExprId>
) Res<ExprId> {
    values.find((value) { c.scope_escapes(o, value) }).match({
        None => None, Ok(value) => c.scope_escape(o, value),
    })
}

scope_escape_in_args = (c :: Checker, o :: Own, k: Call) Res<ExprId> {
    k.args.find((a) { c.scope_escapes(o, a.value) }).match({
        None  => None,
        Ok(a) => c.scope_escape(o, a.value),
    })
}

scope_escapes = (c :: Checker, o :: Own, id: ExprId) bool {
    c.scope_escape(o, id).match({ Ok(_) => true, None => false })
}

scope_alias* = (c :: Checker, o :: Own, id: ExprId) bool {
    c.scope_escapes(o, id)
}

refuse_scope_returned = (c :: Checker, o :: Own, id: ExprId)
                        Res<(), AllocError> {
    c.scope_escape(o, id).match({
        None   => Ok(()),
        Ok(at) => c.refuse_scope_node(at),
    })
}

// A binding leaves with its name in the message, the keyword without one.
refuse_scope_node = (c :: Checker, at: ExprId) Res<(), AllocError> {
    node = c.tree.expr_at(at);
    name = node.kind.match({ Name(n) => n.text, _ => "" });
    c.refuse(node.span, SemaFault.ScopeEscapes(NameFault(name: name)))
}

scope_carries = (c :: Checker, o :: Own, id: ExprId) bool {
    c.leaf_prim(c.place_type(o, id)).len == 0
}

// The primitive a type bottoms out at through any `Res`; "" for a
// non-primitive, and for an untyped place, which may hold anything.
leaf_prim = (c: Checker, ty: TyId) str {
    ty.eq(UNRESOLVED).match({
        true  => "",
        false => c.types.at(ty).match({
            Res(r) => c.leaf_prim(r.value),
            _      => c.prim_name(ty),
        }),
    })
}

is_scope_value* = (c :: Checker, id: ExprId) bool {
    c.tree.expr_at(id).kind.match({
        Scope    => true,
        Paren(p) => c.is_scope_value(p.inner),
        _        => false,
    })
}

// A method that takes an `Alloc` may keep its lambda arguments alive
// past the call.
call_escapes* = (c :: Checker, o :: Own, k: Call) bool {
    c.tree.expr_at(k.callee).kind.match({
        Access(a) => c.member_escapes(o, a),
        _         => false,
    })
}

member_escapes = (c :: Checker, o :: Own, a: Access) bool {
    c.own_member(c.place_type(o, a.base), a.name.text).match({
        None  => false,
        Ok(m) => m.kind.match({
            Function(f) => c.takes_alloc(f),
            _           => false,
        }),
    })
}

takes_alloc = (c :: Checker, f: Function) bool {
    f.params.find((p) { c.param_is_alloc(p) }).match({
        Ok(_) => true,
        None  => false,
    })
}

param_is_alloc = (c :: Checker, p: Param) bool {
    p.type.match({
        None    => false,
        Ok(tid) => c.tree.type_at(tid).kind.match({
            Named(n) => n.name.text.eq("Alloc"),
            _        => false,
        }),
    })
}

check_arena_returned* = (c :: Checker, o :: Own, id: BlockId, b: Block)
                        Res<(), AllocError> {
    (id.index == o.body.index).match({
        false => Ok(()),
        true  => c.tail_expr(b).match({
            None  => Ok(()),
            Ok(v) => c.refuse_if_arena(o, v),
        }),
    })
}

refuse_if_arena = (c :: Checker, o :: Own, id: ExprId) Res<(), AllocError> {
    c.arena_name(o, id).match({
        None  => Ok(()),
        Ok(n) => c.refuse(
            c.tree.expr_at(id).span,
            SemaFault.ArenaEscapes(NameFault(name: n))
        ),
    })
}

// A binding's initialiser: the arena itself (`env.mem.alloc()`, typed
// `Arena`) or anything drawn from one already tainted.
is_arena_backed* = (c :: Checker, o :: Own, id: ExprId) bool {
    c.holds_pointer(o, id) &&
        (c.is_arena_ty(c.place_type(o, id)) || c.draws_on_arena(o, id))
}

is_arena_ty* = (c :: Checker, ty: TyId) bool {
    c.types.at(ty).match({
        Named(n) => n.name.eq("Arena") && c.world.module_name(n.decl).eq("std.mem.mem_arena"),
        _        => false,
    })
}

draws_on_arena = (c :: Checker, o :: Own, id: ExprId) bool {
    c.arena_name(o, id).match({ Ok(_) => true, None => false })
}

// The arena-backed binding an expression draws on, if one.
arena_name = (c :: Checker, o :: Own, id: ExprId) Res<str> {
    c.holds_pointer(o, id).match({
        false => None,
        true  => c.arena_name_of(o, id),
    })
}

arena_name_of = (c :: Checker, o :: Own, id: ExprId) Res<str> {
    c.tree.expr_at(id).kind.match({
        Name(n)       => o.arena_var(n.text).match({ true => Ok(n.text), false => None }),
        Paren(p)      => c.arena_name(o, p.inner),
        Try(t)        => c.arena_name(o, t.operand),
        Access(_)     => c.arena_field_name(o, id),
        Index(x)      => c.arena_name(o, x.base),
        Array(a)      => c.arena_name_in_values(o, a.elems),
        FixedArray(a) => c.arena_name_in_values(o, a.elems),
        Match(m)      => m.arms.find(
            (arm) { c.draws_on_arena(o, arm.body) }
        ).match({
            None => None, Ok(arm) => c.arena_name(o, arm.body),
        }),
        Block(b)      => o.block_arena(b),
        Call(k)       => c.returned_view(o, id, k, "").match({
            None     => c.arena_name_in_call(o, k),
            Ok(view) => view.arena.match({ true => Ok(""), false => None }),
        }),
        _             => None,
    })
}

arena_field_name = (c :: Checker, o :: Own, id: ExprId) Res<str> {
    c.access_view(o, id).arena.ensure().try();
    Ok(c.field_root_name(id))
}

arena_name_in_values = (c :: Checker, o :: Own, values: Vec<ExprId>) Res<str> {
    values.find((value) { c.draws_on_arena(o, value) }).match({
        None => None, Ok(value) => c.arena_name(o, value),
    })
}

arena_name_in_call = (c :: Checker, o :: Own, k: Call) Res<str> {
    c.arena_name_of_callee(o, k).match({
        Ok(n) => Ok(n),
        None  => c.arena_name_in_args(o, k),
    })
}

arena_name_of_callee = (c :: Checker, o :: Own, k: Call) Res<str> {
    c.tree.call_callee(k).kind.match({
        Access(a) => c.arena_name(o, a.base),
        _         => None,
    })
}

arena_name_in_args = (c :: Checker, o :: Own, k: Call) Res<str> {
    k.args.find((a) { c.draws_on_arena(o, a.value) }).match({
        None  => None,
        Ok(a) => c.arena_name(o, a.value),
    })
}

holds_pointer = (c :: Checker, o :: Own, id: ExprId) bool {
    is_pointerish(c.leaf_prim(c.place_type(o, id)))
}

is_pointerish = (name: str) bool { name.len == 0 || name.eq("str") }

// Preserve the completed value while the block's local names still exist.
remember_block_origin* = (c :: Checker, o :: Own, id: BlockId, b: Block)
                         Res<(), AllocError> {
    c.tail_expr(b).match({
        None      => o.remember_block(id, false, None, None),
        Ok(value) => o.remember_block(
            id,
            c.scope_escapes(o, value),
            c.arena_name(o, value),
            c.arena_source(o, value)
        ),
    })
}

// A parameter's destination outlives this call. Local storage may retain
// local arena views, but borrowed caller storage may not receive them.
check_arena_stored* = (
    c      :: Checker,
    o      :: Own,
    target : ExprId,
    value  : ExprId
) Res<(), AllocError> {
    c.path_root(o, target).match({
        None     => Ok(()),
        Ok(root) => o.owned_at(root).match({
            true  => Ok(()),
            false => c.arena_name(o, value).match({
                None     => Ok(()),
                Ok(name) => c.refuse(
                    c.tree.expr_at(target).span,
                    SemaFault.ArenaStored(NameFault(name: name))
                ),
            }),
        }),
    })
}

Sources = {
    local :: bool,
    source :: Res<ExprId>,

    add = (self :: @Self, c :: Checker, o :: Own, value: ExprId) () {
        local       = c.is_arena_backed(o, value);
        self.source = joined_source(
            self.local,
            self.source,
            local,
            c.arena_source(o, value)
        );
        self.local  = self.local || local;
    }
}

arena_source* = (c :: Checker, o :: Own, id: ExprId) Res<ExprId> {
    c.is_arena_backed(o, id).match({
        false => None,
        true  => c.tree.expr_at(id).kind.match({
            Name(n)       => o.arena_source(n.text),
            Consume(x)    => c.arena_source(o, x.operand),
            Paren(p)      => c.arena_source(o, p.inner),
            Try(t)        => c.arena_source(o, t.operand),
            Access(_)     => c.access_view(o, id).source,
            Index(x)      => c.arena_source(o, x.base),
            Array(a)      => c.array_source(o, a.elems),
            FixedArray(a) => c.array_source(o, a.elems),
            Block(b)      => o.block_source(b),
            Match(m)      => {
                found ::= Sources(local: false, source: None);
                m.arms.loop((arm) { found.add(c, o, arm.body); });
                found.source
            },
            Call(k)       => c.is_arena_ty(c.place_type(o, id)).match({
                true  => Ok(id),
                false => c.returned_view(o, id, k, "").match({
                    Ok(view) => view.source,
                    None     => {
                    found ::= Sources(local: false, source: None);
                    c.tree.call_callee(k).kind.match({
                        Access(a) => found.add(c, o, a.base),
                        _         => (),
                    });
                    k.args.loop((arg) { found.add(c, o, arg.value); });
                    found.source
                    },
                })
            }),
            _             => None,
        }),
    })
}

array_source = (c :: Checker, o :: Own, values: Vec<ExprId>) Res<ExprId> {
    found ::= Sources(local: false, source: None);
    values.loop((value) { found.add(c, o, value); });
    found.source
}

stored_arena_backed* = (
    c      :: Checker,
    o      :: Own,
    target : ExprId,
    value  : ExprId
) bool {
    external = c.path_root(o, target).match({
        None => false, Ok(root) => !o.owned_at(root),
    });
    (!(external && c.is_arena_ty(c.place_type(o, value)))) && c.is_arena_backed(o, value)
}

// Moving the allocation owner into caller storage ends this body's ownership.
// Only dependents with that definite source lose their local-arena origin.
release_stored_arena* = (c :: Checker, o :: Own, target: ExprId, value: ExprId)
                       Res<(), AllocError> {
    c.path_root(o, target).match({
        None     => Ok(()),
        Ok(root) => o.owned_at(root).match({
            true  => Ok(()),
            false => c.tree.expr_at(value).kind.match({
                Paren(p)   => c.release_stored_arena(o, target, p.inner),
                Consume(x) => c.is_arena_ty(c.place_type(o, x.operand)).match({
                    false => Ok(()),
                    true  => c.arena_source(o, x.operand).match({
                        None => Ok(()), Ok(source) => o.release_arena(source),
                    }),
                }),
                _          => Ok(()),
            }),
        }),
    })
}

field_root_name = (c: Checker, id: ExprId) str {
    c.tree.expr_at(id).kind.match({
        Name(name)     => name.text,
        Paren(paren)   => c.field_root_name(paren.inner),
        Access(access) => c.field_root_name(access.base),
        Index(index)   => c.field_root_name(index.base),
        _              => "",
    })
}
