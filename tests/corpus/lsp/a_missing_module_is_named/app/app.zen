// THE FILE ON DISK. The buffer that replaces it imports a module that
// exists NOWHERE — the fault this test is about — so this one imports
// only what is staged: a module that is only ever wrong in an overlay
// is an editor's shape anyway.
Point = app.shape

near = (p: Point, n: i32) i32 {
    s = p.x + n;
    s
}
