// The empty string is a str with len 0 and it equals ONLY itself: the
// length gate answers before the byte walk can, so "" == "x" must be
// false WITHOUT ever dereferencing data -- an empty literal's pointer
// may point anywhere (or nowhere) and reading through it would be
// undefined behaviour that happens to work until a backend changes how
// zero-sized statics are laid out.
//
// The interesting row is `"" == "x"` being FALSE. A byte walk with no
// length guard reads min(0, 1) = 0 bytes and concludes "no difference
// found" -- true -- which is exactly what a memcmp-style eq over the
// shorter operand produces. That wrong answer looks plausible and prints
// as a clean boolean, which is why this file exists.
//
// Breaks it: drop the len gate in text_str.zen's eq (or clamp the walk
// to the shorter length) and rows 3 and 4 flip to true while rows 1-2
// stay green.

main = (env: Env) Res<i32, AllocError> {
    empty = "";
    println("{}", empty == "");
    println("{}", empty == empty);
    println("{}", empty == "x");
    println("{}", "x" == empty);
    println("[]");
    Ok(0);
}
