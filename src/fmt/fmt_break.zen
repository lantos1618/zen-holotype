// src/fmt/fmt_break.zen
// The WIDTH rule: a line is 80 columns, and a list that does not fit
// breaks vertically. The second rule that reaches inside a declaration
// and the first that changes how many LINES one takes — which is why it
// is a pass of its own (`fmt.zen` runs it after the pads, re-lexing
// what that wrote) and not a table keyed by line like `fmt_decl.zen`'s:
// this rule's own edits would move that table's keys.
//
// TWO FORMS, one mechanic — find the list's separators, set the
// whitespace around each:
//
//   - BRACKETED LISTS. `f(a, b)`, construction `Sym(name: n, ..)` and a
//     function's `(a: A, b: B)` — a declaration's, a lambda's, a
//     function type's. Packed past the width: one item per line at +4,
//     `)` on a line of its own back at the opener's indent.
//
//     ONE RULE FOR ARGUMENTS AND PARAMETERS, and that is the point.
//     Parameters used to be nobody's: over the width an author wrapped
//     them by hand under the `(`, and this rule then held that layout
//     forever. Two lists a comma apart in kind cannot be allowed to
//     disagree about what wrapping looks like.
//
//     THE `)` GETS ITS OWN LINE rather than hugging the last item.
//     Hugging costs a line and reads fine for a call, but a parameter
//     list closes into ` Res<..> {` and the body that follows is also at
//     +4 — hugged, a signature's last parameter and the body's first
//     statement are the same shape at the same column. A closer at the
//     opener's indent is the line that separates them, and it is worth
//     more than the line it costs; `AST_CONTRACT.md` records
//     `params_span` for exactly this decision.
//
//   - UNION BARS. An enum's variants (and an anonymous union's members)
//     packed past the width: one per line, the bar leading at +4.
//
// JOIN FIRST, THEN BREAK, and the join is why a shape here is COMPUTED
// rather than inherited. The rule used to only break, so a list a human
// had wrapped by hand was ratified forever and two identical calls in
// one file could carry two different shapes. Now the pass runs in two
// halves over the same mechanic:
//
//   - JOIN, innermost first: every gap of every list becomes its packed
//     form — the opener hugs the first item, a separator and one space
//     stand between two, the closer hugs the last. An item is left
//     alone, so a list can only pack once the lists INSIDE it have; the
//     rounds are what make that "innermost first", and they settle when
//     a round moves nothing.
//   - BREAK, outermost first: the packed line, measured. A list INSIDE
//     one this round broke keeps — it just moved to a new line and a
//     new indent, and the width it is judged at is the one it lands at,
//     which the next round reads off the text. So
//     `be.report(a, b, GenFault.Unsupported(".."))` breaks at the outer
//     parens, and the inner call, now alone on a line that fits, stays
//     packed.
//
// TWO LISTS KEEP RATHER THAN BREAK. One SHARING its line with a
// disjoint one: `f(a) || g(b)` over the width has no list whose break
// fixes the line, the width lives in the operators, and breaking one
// side is raggedness — that line is a human's to re-shape. And a
// WRAPPER, a list whose one item is another list: `out.add(Sym(..))`
// has one place worth breaking and the inner break is the one that buys
// width. Rounds are also what makes the pass idempotent: a list already
// in the broken form emits the bytes it has, and a round that moves
// nothing does not CLAIM the list, so the lists inside it are asked
// next.
//
// MOVES NO TOKEN: every comma, bar and item byte is the author's; only
// whitespace around a separator is set, so `fmt.zen`'s guard covers
// this rule with the same three lines it always had.
//
// REFUSES:
//   - a gap holding anything but whitespace and its separator — a
//     comment there is a token, and overwriting one is the accident
//     this folder exists to prevent.
//   - a list with a multi-line ITEM (a closure body, a record literal):
//     the item's inner lines carry their own indentation, which neither
//     half can re-lay-out. `.loop((h) { .. })` and its kin are the
//     common case and stay as written. A nested CALL broken across
//     lines is NOT this case — it packs first, and then its container
//     has a one-line item and packs too.
//   - a COMMENT anywhere in the span, refused for joining outright.
//     A `//` runs to end of line, so packing a list across one would
//     pull every item after it INTO the comment: code deleted. Found by
//     scanning for `//` and `/*`, which reads a `"http://"` inside a
//     string as a comment and declines the list — conservative in the
//     only direction that is safe.
//   - JOINING a parameter list that is written one per line. That shape
//     is a COLUMN `fmt_decl.zen` owns — it lines the `:`/`::` up — and
//     packing it would carry that column onto a line with nothing to
//     align to. The two rules meet here and this is the seam; such a
//     list is still BROKEN back to the canonical form when it is not in
//     it, so nothing is frozen except the choice to stay vertical.
//
// NOT LISTS FOR THIS RULE: records and array literals. The mechanic
// would fit them; the demand is unwritten; the corpus comes first.

Alloc, AllocError = std.mem
str, String = std.text
Vec = std.collections
Range = std.core
Span = std.ast.ast_span
Ast = std.ast.ast_arena
ExprId, TypeId, BlockId = std.ast.ast_id
Module, Decl, Type, Call, Union, Enum, Param = std.ast.ast_node
scan, Source, Lexed = std.lex.lex
Parser, module = std.parse.parse
Src = fmt.fmt_src

// 80, because that is the width the tree already keeps: measured across
// src/, 372 of 52092 lines exceed it (93 exceed 100), and this rule's
// worked example — `ValueShape` in parse_lookahead.zen — sits at 84,
// between the two candidates. `make cap` counts a FILE's lines; nothing
// else in the tree names a column count, so it is written here, once.
WIDTH*: usize = 80

// One separator-bounded piece of a list, in bytes: an argument, a
// variant, a union member. Half-open, like the spans it comes from.
Item = {
    lo: usize,
    hi: usize,
}

// A list that COULD break: where it sits, what separates its items,
// whether brackets close the ends (a call's or a signature's parens) or
// nothing does (an enum or union, whose first variant stays on the `=`
// line), and whether it may VETO a neighbour sharing its line.
//
// Only a parameter list may not. `shares_line` below refuses to break
// either of two disjoint lists on one line because neither break fixes
// `f(a) || g(b)`, and that argument is about SIBLINGS in an expression.
// A signature's parens are not a sibling of anything: `handle = (r: Req)
// Res<str, Io | ..> {` is one declaration whose return union is the part
// worth breaking. So a parameter list still DEFERS to a neighbour — it
// is asked the question — and simply never answers it for one.
//
// `params` is separate from `vetoes` although only a parameter list has
// either answer today: one says what this list does to a NEIGHBOUR, the
// other what `fmt_decl.zen` writes INSIDE it.
Cand = {
    lo: usize,
    hi: usize,
    line: usize,
    end_line: usize,
    sep: u8,
    parens: bool,
    vetoes: bool,
    params: bool,
    items: Vec<Item>,
}

// One whitespace replacement: `[from, to)` becomes `text`.
Edit = {
    from: usize,
    to: usize,
    text: String,
}

// The pass `fmt.zen`'s `render` wires in after the pads: pack every
// list in `text` to one line, then break the ones that do not fit.
// `file` only names the source for diagnostics; the pass speaks offsets
// throughout.
break_lines* = (a: Alloc, file: str, text: str) Res<String, AllocError> {
    packed = rounds(a, file, text, true).try();
    rounds(a, file, packed.view(), false)
}

// One half of the pass, run until a round moves nothing.
rounds = (a: Alloc, file: str, text: str, join: bool)
         Res<String, AllocError> {
    cur   ::= copy_of(a, text).try();
    turns ::= 0;
    loop(() { turns < 16 }, (h) {
        next  = one_round(a, file, cur.view(), join).try();
        turns = turns + 1;
        next.view().eq(cur.view()).match({
            true  => h.break(),
            false => { cur = next; },
        });
    });
    Ok(cur);
}

// One round: re-lex and re-parse (the last round's edits moved every
// offset), re-lay what this text re-lays, hand back the new bytes. The
// 16-round cap in `rounds` is a belt, not a budget: a joining round
// that moves something packed a list no earlier round could reach, a
// breaking round that moves something broke one no earlier round had,
// and lists are finite.
one_round = (a: Alloc, file: str, text: str, join: bool)
            Res<String, AllocError> {
    lexed = scan(a, Source(file: file, text: text)).try();
    lexed.is_clean().match({
        false => copy_of(a, text),
        true  => round_clean(a, text, lexed, join),
    })
}

// A clean re-lex should always parse — the input did, and the rounds in
// between move no token — but a pass that falls back to its input can
// never eat code, so the unlikely arm is a copy, not a trap.
round_clean = (a: Alloc, text: str, lexed: Lexed, join: bool)
              Res<String, AllocError> {
    p ::= a.Parser(lexed);
    m = p.module(lexed.source.file).try();
    (p.diags.len == 0).match({
        false => copy_of(a, text),
        true  => {
            src = a.Src(text).try();
            edits ::= a.Vec<Edit>();
            judge(a, src, collect(a, src, p.tree, m).try(), edits, join).try();
            apply(a, text, edits)
        },
    })
}

copy_of = (a: Alloc, text: str) Res<String, AllocError> {
    out ::= a.String().try();
    out.add_bytes(text).try();
    Ok(out);
}

// -------------------------------------------------------------------
// finding the lists
// -------------------------------------------------------------------

// Every list in the file, sorted by (start, end reversed): a container
// comes out before what it holds and two disjoint lists come out left
// to right. That is the order the breaking below needs — outermost
// first, so a list is asked about its width only once every list AROUND
// it has answered.
collect = (a: Alloc, src: Src, tree: Ast, m: Module)
          Res<Vec<Cand>, AllocError> {
    cands ::= a.Vec<Cand>();
    id    ::= ExprId(index: 0);
    Range(0, tree.expr_ids()).loop((h, i) {
        tree.expr_at(id).kind.match({
            Call(c)   => add_call(a, src, cands, c),
            Lambda(l) => add_params(a, src, cands, l.params, l.params_span),
            _         => no_list(),
        }).try();
        id = ExprId(index: id.index + 1);
    });
    tid ::= TypeId(index: 0);
    Range(0, tree.type_ids()).loop((h, i) {
        t = tree.type_at(tid);
        t.kind.match({
            Union(u) => add_union(a, src, tree, cands, t, u),
            Fn(f)    => add_params(a, src, cands, f.params, f.params_span),
            _        => no_list(),
        }).try();
        tid = TypeId(index: tid.index + 1);
    });
    m.decls.loop((h, i, d) {
        add_decl(a, src, cands, d).try();
    });
    bid ::= BlockId(index: 0);
    Range(0, tree.block_ids()).loop((h, i) {
        tree.block_at(bid).stmts.loop((g, j, s) {
            s.kind.match({
                Decl(d) => add_decl(a, src, cands, d),
                _       => no_list(),
            }).try();
        });
        bid = BlockId(index: bid.index + 1);
    });
    in_order(cands);
    Ok(cands);
}

// Nothing to collect here. Allocates nothing but still speaks
// `Res<(), AllocError>` since its callers match it beside the `add_`
// functions, and sibling arms must agree on a type (fmt_decl.zen's
// `unaligned` is the same pattern).
no_list = () Res<(), AllocError> { Ok(()) }

// `f(a, b)`, `Point(x: 3, y: 4)`: the parens are the list's ends and
// the commas its separators. Zero arguments is not a list.
add_call = (a: Alloc, src: Src, cands :: Vec<Cand>, c: Call)
           Res<(), AllocError> {
    (c.args.len == 0).match({
        true  => no_list(),
        false => {
            items ::= a.Vec<Item>();
            c.args.loop((h, i, arg) {
                items.add(Item(
                    lo: src.offset(arg.span.start),
                    hi: src.offset(arg.span.end)
                )).try();
            });
            cands.add(Cand(
                lo: src.offset(c.args_span.start),
                hi: src.offset(c.args_span.end),
                line: c.args_span.start.line,
                end_line: c.args_span.end.line,
                sep: ',',
                parens: true,
                vetoes: true,
                params: false,
                items: items,
            ))
        },
    })
}

// A declaration, wherever it stands: an enum's variants are a list, and
// so are a function's parameters. Both, because a function declared
// inside a block is still a declaration and `Enum` already had to be
// reached at both levels.
add_decl = (a: Alloc, src: Src, cands :: Vec<Cand>, d: Decl)
           Res<(), AllocError> {
    d.kind.match({
        Enum(e)     => add_enum(a, src, cands, e),
        Function(f) => add_params(a, src, cands, f.params, f.params_span),
        _           => no_list(),
    })
}

// `(a: A, b: B)`. The same shape as a call's arguments — `params_span`
// is the parens and a `Param`'s span stops before its comma, exactly as
// `args_span` and `Arg` do — so the two share every rule below and can
// never drift apart. Zero parameters is not a list.
add_params = (
    a     : Alloc,
    src   : Src,
    cands :: Vec<Cand>,
    ps    : Vec<Param>,
    span  : Span
) Res<(), AllocError> {
    (ps.len == 0).match({
        true  => no_list(),
        false => {
            items ::= a.Vec<Item>();
            ps.loop((h, i, p) {
                items.add(Item(
                    lo: src.offset(p.span.start),
                    hi: src.offset(p.span.end)
                )).try();
            });
            cands.add(Cand(
                lo: src.offset(span.start),
                hi: src.offset(span.end),
                line: span.start.line,
                end_line: span.end.line,
                sep: ',',
                parens: true,
                vetoes: false,
                params: true,
                items: items,
            ))
        },
    })
}

// `A | B` in type position. The union's own span is first-member to
// last-member (parse_type.zen gathers it flat), which is exactly the
// region this rule re-lays-out.
add_union = (
    a     : Alloc,
    src   : Src,
    tree  : Ast,
    cands :: Vec<Cand>,
    t     : Type,
    u     : Union
) Res<(), AllocError> {
    items ::= a.Vec<Item>();
    u.members.loop((h, i, mid) {
        s = tree.type_at(mid).span;
        items.add(Item(lo: src.offset(s.start), hi: src.offset(s.end))).try();
    });
    cands.add(Cand(
        lo: src.offset(t.span.start),
        hi: src.offset(t.span.end),
        line: t.span.start.line,
        end_line: t.span.end.line,
        sep: '|',
        parens: false,
        vetoes: true,
        params: false,
        items: items,
    ))
}

// `Shape = Circle(Circle) | Rect(Rect) | Unit`. One variant has no
// separator, so it is not a list — `AllocError* = | OutOfMemory` keeps
// its leading bar alone either way.
add_enum = (a: Alloc, src: Src, cands :: Vec<Cand>, e: Enum)
           Res<(), AllocError> {
    (e.variants.len < 2).match({
        true  => no_list(),
        false => {
            items ::= a.Vec<Item>();
            e.variants.loop((h, i, v) {
                items.add(Item(
                    lo: src.offset(v.span.start),
                    hi: src.offset(v.span.end)
                )).try();
            });
            first = e.variants.ptr().read(0);
            last  = e.variants.ptr().read(e.variants.len - 1);
            cands.add(Cand(
                lo: src.offset(first.span.start),
                hi: src.offset(last.span.end),
                line: first.span.start.line,
                end_line: last.span.end.line,
                sep: '|',
                parens: false,
                vetoes: true,
                params: false,
                items: items,
            ))
        },
    })
}

// Insertion sort: a file holds a handful of lists, and the comparison
// is two fields. (lo, hi) pairs are distinct per candidate — two parser
// spans that share both ends would be the same node — so the order is
// total and no stability question arises.
in_order = (cands :: Vec<Cand>) () {
    Range(1, cands.len).loop((h, i) {
        j ::= i;
        loop(() { j > 0 && before(
            cands.ptr().read(j),
            cands.ptr().read(j - 1)
        ) }, (g) {
            tmp = cands.ptr().read(j - 1);
            cands.ptr().write(j - 1, cands.ptr().read(j));
            cands.ptr().write(j, tmp);
            j = j - 1;
        });
    });
}

before = (x: Cand, y: Cand) bool {
    (x.lo < y.lo) || (x.lo == y.lo && x.hi > y.hi)
}

// -------------------------------------------------------------------
// judging
// -------------------------------------------------------------------

// Every list, in sorted order: re-lay the ones this round re-lays,
// leave the rest. `moved` is parallel to `cands` because a Cand carries
// a Vec and copying one to mark it would copy the handle, not the mark.
//
// A JOINING round claims nothing: joins are disjoint by construction (a
// list rewrites its own gaps, and a list inside it lies wholly inside an
// ITEM). A BREAKING round claims what it actually moved — `emit_break`
// answers that — and the lists inside a claim are asked again next
// round, where the text says where they landed.
judge = (
    a     : Alloc,
    src   : Src,
    cands : Vec<Cand>,
    edits :: Vec<Edit>,
    join  : bool
) Res<(), AllocError> {
    moved ::= a.Vec<bool>();
    Range(0, cands.len).loop((h, i) { moved.add(false).try(); });
    Range(0, cands.len).loop((h, i) {
        c = cands.ptr().read(i);
        relaid(src, cands, moved, c, join).match({
            false => no_list(),
            true  => join.match({
                true  => emit_join(a, c, edits),
                false => break_and_mark(a, src, c, edits, moved, i),
            }),
        }).try();
    });
    in_byte_order(edits);
    Ok(());
}

break_and_mark = (
    a     : Alloc,
    src   : Src,
    c     : Cand,
    edits :: Vec<Edit>,
    moved :: Vec<bool>,
    i     : usize
) Res<(), AllocError> {
    moved.ptr().write(i, emit_break(a, src, c, edits).try());
    Ok(());
}

// Is this list re-laid out this round? Both halves need the gaps to be
// rewritable at all; past that, joining asks only that no comment and
// no owned column stand in the way, and breaking asks the width.
relaid = (
    src   : Src,
    cands : Vec<Cand>,
    moved : Vec<bool>,
    c     : Cand,
    join  : bool
) bool {
    may_relay(src, c) && join.match({
        true  => may_join(src, c),
        false => !inside_moved(cands, moved, c)
              && !wraps_one_list(cands, c)
              && !shares_line(src, cands, c)
              && too_wide(src, c),
    })
}

// A list inside one this round broke keeps: the break gave it a new
// line and a new indent, and only the next round, over the rewritten
// text, can read the width it lands at. Sorted order means every
// container was judged before this one, so the marks are the answer.
inside_moved = (cands: Vec<Cand>, moved: Vec<bool>, c: Cand) bool {
    found ::= false;
    Range(0, cands.len).loop((h, j) {
        other = cands.ptr().read(j);
        holds = moved.ptr().read(j) && other.lo <= c.lo && other.hi >= c.hi;
        holds.match({
            true  => { found = true; h.break(); },
            false => (),
        });
    });
    found;
}

// A WRAPPER KEEPS AND ITS ONE ITEM BREAKS. `out.add(Sym(..))` over the
// width has one place worth breaking: the inner list's break is what
// brings every line under it, and breaking the wrapper too costs two
// lines and an indent level for a `)` carrying nothing. Not a rule
// about calls — `Ok(Job(..))` and `edits.add(Edit(..))` are the shape,
// and no width is bought by a wrapper's own break.
wraps_one_list = (cands: Vec<Cand>, c: Cand) bool {
    (c.items.len == 1) && ends_the_item(cands, c, c.items.ptr().read(0))
}

// Is some list INSIDE `c` closing exactly where its only item does? A
// list ends at its closer, so that is what makes the item a list and
// not merely a thing with a list in it.
ends_the_item = (cands: Vec<Cand>, c: Cand, only: Item) bool {
    found ::= false;
    Range(0, cands.len).loop((h, j) {
        d = cands.ptr().read(j);
        (d.lo > c.lo && d.hi == only.hi).match({
            true  => { found = true; h.break(); },
            false => (),
        });
    });
    found;
}

// May this list be PACKED? A comment in the span forbids it outright
// (the header says why), and so does a parameter list written one per
// line, whose `:`/`::` column belongs to `fmt_decl.zen`.
may_join = (src: Src, c: Cand) bool {
    uncommented(src, c.lo, c.hi) && !(c.params && !one_line(src, c.lo, c.hi))
}

// Is `[from, to)` free of comment openers? Bytes and not tokens, so a
// `//` inside a string literal counts — a list is declined, never
// mis-packed, and that is the direction to be wrong in.
uncommented = (src: Src, from: usize, to: usize) bool {
    clear ::= true;
    Range(from, to).loop((h, i) {
        (src.text.index(i) == '/' && opens_comment(src, i + 1, to)).match({
            true  => { clear = false; h.break(); },
            false => (),
        });
    });
    clear;
}

opens_comment = (src: Src, at: usize, to: usize) bool {
    (at < to) && (src.text.index(at) == '/' || src.text.index(at) == '*')
}

// The packed line, measured: what precedes the list on its line, the
// list with every whitespace run collapsed to one space, what follows
// it. The collapse is a JUDGMENT, not an edit — a multi-line item
// (refused in `may_relay`) never gets re-laid-out for real.
too_wide = (src: Src, c: Cand) bool {
    packed_width(src, c) > WIDTH
}

// A list SHARING its line with a disjoint one that VETOES keeps: no
// list's break fixes `f(a) || g(b)` (the over-wide part is the operator
// chain, which is no list), and breaking one side of it reads worse
// than the long line did. Nested lists don't count — a container has
// already answered for itself, and an item is exactly who may inherit
// this line. A parameter list does not veto (see `Cand`), so the return
// union it sits beside still breaks and the parameters, asked next
// round on a line that got shorter, no longer need to.
shares_line = (src: Src, cands: Vec<Cand>, c: Cand) bool {
    ls = src.line_at(c.line);
    le = src.after_line(c.line);
    found ::= false;
    Range(0, cands.len).loop((h, j) {
        d        = cands.ptr().read(j);
        disjoint = d.lo >= c.hi || d.hi <= c.lo;
        (d.vetoes && disjoint && d.lo < le && d.hi > ls).match({
            true  => { found = true; h.break(); },
            false => (),
        });
    });
    found;
}

packed_width = (src: Src, c: Cand) usize {
    prefix = c.lo - src.line_at(c.line);
    suffix = src.trim_back(c.hi, src.after_line(c.end_line)) - c.hi;
    prefix + collapsed(src, c.lo, c.hi) + suffix
}

collapsed = (src: Src, from: usize, to: usize) usize {
    n  ::= 0;
    ws ::= false;
    Range(from, to).loop((h, i) {
        sp = src.text.index(i).is_space();
        (sp && ws).match({
            true  => (),
            false => { n = n + 1; },
        });
        ws = sp;
    });
    n;
}

// May this rule rewrite this list's gaps, either way? Every item on one
// line as written, brackets hugging nothing but whitespace, and each gap
// holding exactly its separator in whitespace (the header says why each
// clause exists).
may_relay = (src: Src, c: Cand) bool {
    first = c.items.ptr().read(0);
    last  = c.items.ptr().read(c.items.len - 1);
    clear ::= c.parens.match({
        true  => all_space(src, c.lo + 1, first.lo)
              && all_space(src, last.hi, c.hi - 1),
        false => true,
    });
    Range(0, c.items.len - 1).loop((h, i) {
        item = c.items.ptr().read(i);
        ok   = one_line(src, item.lo, item.hi)
          && clean_gap(src, item.hi, c.items.ptr().read(i + 1).lo, c.sep);
        ok.match({
            true  => (),
            false => { clear = false; h.break(); },
        });
    });
    clear && one_line(src, last.lo, last.hi);
}

one_line = (src: Src, from: usize, to: usize) bool {
    flat ::= true;
    Range(from, to).loop((h, i) {
        (src.text.index(i) == '\n').match({
            true  => { flat = false; h.break(); },
            false => (),
        });
    });
    flat;
}

// The gap between two items: whitespace, the separator, whitespace, and
// nothing else. The separator is found by walking bytes — safe here and
// nowhere else, because a gap holds only trivia and the one punctuator:
// a comment shows up as a byte that is neither, and the gap is refused.
clean_gap = (src: Src, from: usize, to: usize, sep: u8) bool {
    mid = skip_space(src, from, to);
    (mid < to && src.text.index(mid) == sep).match({
        false => false,
        true  => skip_space(src, mid + 1, to) == to,
    })
}

all_space = (src: Src, from: usize, to: usize) bool {
    skip_space(src, from, to) == to
}

skip_space = (src: Src, from: usize, to: usize) usize {
    at ::= from;
    loop(() { at < to && src.text.index(at).is_space() }, (h) {
        at = at + 1;
    });
    at;
}

// -------------------------------------------------------------------
// joining and breaking
// -------------------------------------------------------------------

// The canonical PACKED form: a bracketed list's `(` hugs its first item
// and its `)` hugs the last, and every gap between two items is the
// separator and one space — a comma closing the item before it, a bar
// standing between two. An item's own bytes are untouched, which is why
// a list packs only after the lists inside it have.
emit_join = (a: Alloc, c: Cand, edits :: Vec<Edit>) Res<(), AllocError> {
    gone ::= a.String().try();
    first = c.items.ptr().read(0);
    last  = c.items.ptr().read(c.items.len - 1);
    c.parens.match({
        true  => edits.add(Edit(from: c.lo + 1, to: first.lo, text: gone)),
        false => no_list(),
    }).try();
    Range(0, c.items.len - 1).loop((h, i) {
        rep ::= a.String().try();
        c.parens.match({
            true  => (),
            false => { rep.add_byte(' ').try(); },
        });
        rep.add_byte(c.sep).try();
        rep.add_byte(' ').try();
        edits.add(Edit(
            from: c.items.ptr().read(i).hi,
            to: c.items.ptr().read(i + 1).lo,
            text: rep
        )).try();
    });
    c.parens.match({
        true  => edits.add(Edit(from: last.hi, to: c.hi - 1, text: gone)),
        false => no_list(),
    }).try();
    Ok(());
}

// The canonical BROKEN form: head gap (a bracketed list's `(` to its
// first item) becomes newline+indent, each inter-item gap becomes
// separator + newline+indent — an enum's separator LEADS the next line,
// a call's comma closes this one — and the tail gap becomes a newline
// back at the OPENER'S indent, so `)` stands alone.
//
// ANSWERS WHETHER THE LIST ACTUALLY MOVED, which is what makes the
// rounds converge on more than the outermost break: a list already in
// this form writes the bytes it has, claims nothing, and so the lists
// inside it are judged this round where they really sit.
emit_break = (a: Alloc, src: Src, c: Cand, edits :: Vec<Edit>)
             Res<bool, AllocError> {
    was   = edits.len;
    start = src.line_at(c.line);
    close ::= a.String().try();
    close.add_byte('\n').try();
    close.add_bytes(src.slice_at(
        start,
        skip_space(src, start, src.after_line(c.line))
    )).try();
    nl ::= a.String().try();
    nl.add_bytes(close.view()).try();
    nl.add_bytes("    ").try();
    first = c.items.ptr().read(0);
    last  = c.items.ptr().read(c.items.len - 1);
    c.parens.match({
        true  => edits.add(Edit(from: c.lo + 1, to: first.lo, text: nl)),
        false => no_list(),
    }).try();
    Range(0, c.items.len - 1).loop((h, i) {
        rep ::= a.String().try();
        c.parens.match({
            true  => { rep.add_byte(c.sep).try();
                       rep.add_bytes(nl.view()).try(); },
            false => { rep.add_bytes(nl.view()).try();
                       rep.add_byte(c.sep).try();
                       rep.add_byte(' ').try(); },
        });
        edits.add(Edit(
            from: c.items.ptr().read(i).hi,
            to: c.items.ptr().read(i + 1).lo,
            text: rep
        )).try();
    });
    c.parens.match({
        true  => edits.add(Edit(from: last.hi, to: c.hi - 1, text: close)),
        false => no_list(),
    }).try();
    Ok(rewrites(src, edits, was));
}

// Does any edit added since `was` say something the bytes don't already
// say? Comparing texts and not spans, because the whole question is
// whether re-emitting a list is a no-op.
rewrites = (src: Src, edits: Vec<Edit>, was: usize) bool {
    found ::= false;
    Range(was, edits.len).loop((h, i) {
        e = edits.ptr().read(i);
        e.text.view().eq(src.slice_at(e.from, e.to)).match({
            false => { found = true; h.break(); },
            true  => (),
        });
    });
    found;
}

// Insertion sort, by where each edit starts. A joining round has a list
// rewrite gaps that lie AROUND the gaps of the lists inside it, so the
// candidate order and the byte order are two different orders and
// `apply` needs the second one. Edits never overlap: a list's gaps are
// its own, and a list inside it lies wholly inside an ITEM.
in_byte_order = (edits :: Vec<Edit>) () {
    Range(1, edits.len).loop((h, i) {
        j ::= i;
        loop(() { j > 0 && edits.ptr().read(j).from
                         < edits.ptr().read(j - 1).from }, (g) {
            tmp = edits.ptr().read(j - 1);
            edits.ptr().write(j - 1, edits.ptr().read(j));
            edits.ptr().write(j, tmp);
            j = j - 1;
        });
    });
}

// The edits, in byte order, over the author's bytes.
apply = (a: Alloc, text: str, edits: Vec<Edit>) Res<String, AllocError> {
    out ::= a.String().try();
    at  ::= 0;
    Range(0, edits.len).loop((h, i) {
        e = edits.ptr().read(i);
        out.add_bytes(text.slice(at, e.from)).try();
        out.add_bytes(e.text.view()).try();
        at = e.to;
    });
    out.add_bytes(text.slice(at, text.len)).try();
    Ok(out);
}
