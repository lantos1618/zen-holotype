// A program's answer and its narration are two streams, and a caller
// redirects them apart: `2>/dev/null` silences the narration and keeps
// the answer. `env.out.errorln` is the second stream -- stdout is the
// answer, stderr is the program talking about itself.
//
// THE RUNNER IS THE CALLER: it compares `.expected` against STDOUT and
// `.stderr` against STDERR, so this test fails in both directions at
// once if the two members share one stream. The bytes are chosen so no
// plausible wrong answer looks right: interleaved lines, and stderr
// carrying text that appears nowhere on stdout.

main = (env: Env) Res<i32, IoError> {
    n = 7;
    b = true;
    env.out.println("answer 1");
    env.out.errorln("count {} bool {}", n, b).try();
    env.out.println("answer 2");
    env.out.errorln("narration 2").try();
    Ok(0);
}
