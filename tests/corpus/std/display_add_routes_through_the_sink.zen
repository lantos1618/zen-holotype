// `out.add("{}:{}", ..)` -- the format door a toString is WRITTEN
// through, and the one text_fmt.zen declares without a body. Every
// other Display test writes its toString with out.write, which is the
// floor rather than the door, so nothing pinned this: the door was
// emitted as a call to a symbol nothing defines, and the linker was the
// only thing that ever said so.
//
// the sink here is the CONSOLE, so main takes no allocator: a value
// that formats itself through {} still allocates nothing.

Tag = {
    ch: u8,
}

Tag.impl(Display, {
    toString ::= (self: @Self, out :: Sink) Res<(), WriteError> {
        out.add("<").try();
        out.write_byte(self.ch).try();
        out.add(">")
    }
})

// every hole a primitive can land on, in one door: a str, a signed
// integer at its negative extreme, an unsigned one, and a bool. a `{`
// with nothing behind it is a literal byte, which is the format rule
// text_fmt.zen states and the only place it is pinned
Row = {
    name: str,
    depth: i32,
    count: usize,
    open: bool,
}

Row.impl(Display, {
    toString ::= (self: @Self, out :: Sink) Res<(), WriteError> {
        out.add("{} { {} {} {} }", self.name, self.depth, self.count, self.open)
    }
})

// a Display INSIDE another one's format string: the inner toString is
// handed the same sink, so nesting never allocates
Pair = {
    left: Tag,
    right: Row,
}

Pair.impl(Display, {
    toString ::= (self: @Self, out :: Sink) Res<(), WriteError> {
        out.add("pair {} and {}", self.left, self.right)
    }
})

main = (env: Env) Res<i32, AllocError> {
    t = Tag(ch: 'z');
    r = Row(name: "node", depth: -12, count: 300, open: true);

    println("{}", t);
    println("{}", r);
    println("{}", Pair(left: t, right: r));

    Ok(0);
}
