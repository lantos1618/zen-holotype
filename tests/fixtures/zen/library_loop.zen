// The `.loop` KEYWORD, written as an ordinary LIBRARY call — std.core.count's `loop_at`/`loop_while`.
// Every shape the keyword covers is exercised here against a hand-computed answer, so a miscompiled
// library loop flips an exit code rather than passing silently:
//   plain iteration (index AND value) · early exit · nested loops (inner stops itself, and inner
//   stops the OUTER) · a body that mutates enclosing state and the slice itself · zero-length input ·
//   `return` from the body returning from the ENCLOSING function.
// The two library entries differ only in what the body ANSWERS: `loop_at`'s body is `void` and always
// runs to the end; `loop_while`'s body answers "keep going?" AFTER it has run and reports the index it
// stopped ON (`xs.len` when it never stopped). Zen has no overloading, so these cannot share a name.
// Exit 0 = every case matched expectation; the exit code is the first case number that did not.
{ loop_at, loop_while } = std.core.count
sum_vals = (xs: MutSlice<i64>) i64 {
    t ::= 0
    xs.loop_at((i, x) { t = t + x })
    t
}
sum_idx = (xs: MutSlice<i64>) i64 {
    t ::= 0
    xs.loop_at((i, x) { t = t + i })
    t
}
// the `h.break` shape: a sentinel set inside the body, answered as the body's tail
first_neg = (xs: MutSlice<i64>) i64 {
    found ::= 0 - 1
    xs.loop_while((i, x) {
        (x < 0).then({
            found = i
        })
        found < 0
    })
    found
}
// early exit that needs no sentinel at all — the reported stop index IS the answer
stop_at = (xs: MutSlice<i64>, want: i64) i64 { xs.loop_while((i, x) { x != want }) }
// nested: the inner loop stops itself, the outer keeps running (std.collections.iter.sort's shape)
inner_stops_self = (xs: MutSlice<i64>) i64 {
    n ::= 0
    xs.loop_at((i, x) {
        xs.loop_while((k, y) {
            n = n + 1
            y < 3
        })
    })
    n
}
// nested: the inner loop stops the OUTER one — the jump the keyword's `h.break` cannot make either
// (no `.loop` body in the tree breaks an enclosing loop), carried by a flag both bodies answer.
inner_stops_outer = (xs: MutSlice<i64>) i64 {
    hits ::= 0
    go ::= true
    xs.loop_while((i, x) {
        xs.loop_while((k, y) {
            (x + y == 7).then({
                hits = hits + 1
                go = false
            })
            go
        })
        go
    })
    hits
}
// the body writes THROUGH the slice it is iterating
double_in_place = (xs: MutSlice<i64>) i64 {
    xs.loop_at((i, x) { xs[i] = x * 2 })
    xs[0] + xs[1] + xs[2]
}
count_runs = (xs: MutSlice<i64>) i64 {
    n ::= 0
    xs.loop_at((i, x) { n = n + 1 })
    n
}
// `return` inside the body returns from THIS function, not from the loop
find_ret = (xs: MutSlice<i64>) i64 {
    xs.loop_at((i, x) {
        (x == 5).then({
            return i * 100
        })
    })
    0 - 1
}
main = () i32 {
    v :: MutSlice<i64> = [1, 2, 3, 0 - 4, 5]
    empty :: MutSlice<i64> = []
    (v.sum_vals() == 7 == false).then({
        return 1
    })    // 1+2+3-4+5
    (v.sum_idx() == 10 == false).then({
        return 2
    })    // 0+1+2+3+4
    (v.first_neg() == 3 == false).then({
        return 3
    })
    w :: MutSlice<i64> = [1, 99, 2]
    (w.stop_at(99) == 1 == false).then({
        return 4
    })
    (v.stop_at(99) == 5 == false).then({
        return 5
    })    // never stopped -> len
    p :: MutSlice<i64> = [1, 2, 3, 4]
    (p.inner_stops_self() == 12 == false).then({
        return 6
    })    // 3 inner passes x 4 outer
    (p.inner_stops_outer() == 1 == false).then({
        return 7
    })    // 1+6 == 7, exactly one hit
    d :: MutSlice<i64> = [1, 2, 3]
    (d.double_in_place() == 12 == false).then({
        return 8
    })    // 2+4+6
    (empty.count_runs() == 0 == false).then({
        return 9
    })
    (empty.loop_while((i, x) { true }) == 0 == false).then({
        return 10
    })
    (v.find_ret() == 400 == false).then({
        return 11
    })    // 5 sits at index 4
    (p.find_ret() == 0 - 1 == false).then({
        return 12
    })
    0
}
