// tests/corpus/traps/div_i32_min_neg_one.zen
// i32.MIN / -1 is OVERFLOW wearing division's clothes: the quotient
// is i32.MAX + 1, and on x86 it faults exactly like a zero divisor.
// the message must say overflow, not divide by zero

// main must name an error type. a trap never lifts into Res:
// it aborts the process
Error = Overflow | DivideByZero | OutOfBounds

main = (env: Env) Res<i32, Error> {
    x: i32       = i32.MIN;
    neg_one: i32 = -1;
    q            = x / neg_one;
    println("{}", q);
    Ok(0);
}
