// tests/corpus/traps/sub_u32_min.zen
// u32.MIN - 1 traps. borrowing past zero is overflow, and an
// unsigned type has nowhere below zero to put the result

// main must name an error type. a trap never lifts into Res:
// it aborts the process
Error = Overflow | DivideByZero | OutOfBounds

main = (env: Env) Res<i32, Error> {
    x: u32 = u32.MIN;
    diff   = x - 1;
    println("{}", diff);
    Ok(0);
}
