// A NESTED BLOCK IN TAIL POSITION IS THE FUNCTION'S VALUE (issue #764,
// hole 3). `{ 11 }` and `{ inner().try() }` written as a function's
// whole body are `StmtKind.Block`, not `StmtKind.Expr`, so the block
// held no statement back as its value: `deliver_expr_stmt` answered
// Ok(()) for it and the emitted C ended in a bare `return;` with the
// success value already cast to `(void)` — at -O0 the uninitialised
// return slot matched neither match arm and the program trapped; on
// other builds it printed 0 and exited 0. Both spellings must deliver:
// the commit that fixed hole 1 claimed "a literal tail always worked",
// which was true only for the expression spelling.
inner = () Res<i32, AllocError> { Ok(11) }

blkLit = () Res<i32, AllocError> { { 11 } }
blkTry = () Res<i32, AllocError> { { inner().try() } }

main = (env: Env) Res<i32, AllocError> {
    println("blkLit -> {}", blkLit().match({ Ok(v) => v, Err(_) => -1 }));
    println("blkTry -> {}", blkTry().match({ Ok(v) => v, Err(_) => -1 }));
    Ok(0);
}
