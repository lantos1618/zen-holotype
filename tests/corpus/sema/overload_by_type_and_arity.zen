// resolution is on declared parameter types and arity, closures
// included: a closure's type is its full signature, and there is no
// carve-out for it. DESIGN.md, Overloading.

Handle = {
    id: i32,
}

show = (env: Env, n: i32) () { println("int {}", n) }
show = (env: Env, s: str) () { println("str {}", s) }
show = (env: Env, a: i32, b: i32) () { println("two {} {}", a, b) }

// the loop-shaped case: the two bodies differ only in the closure's
// parameter list, which IS its type
run = (env: Env, body: (h: Handle) ()) () {
    body(Handle(id: 1));
}

run = (env: Env, body: (h: Handle, index: usize) ()) () {
    body(Handle(id: 2), 5);
}

main = (env: Env) Res<i32, AllocError> {
    show(env, 1);
    show(env, "hello");
    show(env, 3, 4);

    run(env, (h) { println("plain {}", h.id) });
    run(env, (h, i) { println("indexed {} {}", h.id, i) });
    Ok(0);
}
