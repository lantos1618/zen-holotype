// Writes auto-import quick fixes for undefined module-level names.

str, String = std.text
Vec = std.collections
Alloc, AllocError = std.mem
Range = std.core
Pos, Span = std.ast.ast_span
module_index_of = std.ast.ast_named
before = std.ast.ast_find
Checker = sema.sema_check
Diag = sema.sema_diag
Def, module_display = sema.sema_def
ModuleTable = sema.sema_def
to_pos, to_wire, WirePos, WireRange = lsp.lsp_pos
written, obj, arr, Nest, to_json = std.json

Action = {
    name: str,
    module: str,

    write = (self: @Self, t: Alloc, at: WirePos, uri: str, list :: Nest,
             out :: String) Res<(), AllocError> {
        stmt  ::= t.String("{} = {}", self.name, self.module).try();
        title ::= t.String("Import {}", stmt.view()).try();
        stmt.add("\n").try();

        list.next(out).try();
        fix ::= obj(out).try();
        fix.text("title", title.view(), out).try();
        fix.text("kind", "quickfix", out).try();
        fix.key("edit", out).try();
        edit ::= obj(out).try();
        edit.key("changes", out).try();
        changes ::= obj(out).try();
        changes.key(uri, out).try();
        edits ::= arr(out).try();
        edits.next(out).try();
        encoded ::= ActionTextEdit(range: WireRange(start: at, end: at), newText: stmt.view()).to_json(t).try();
        out.add(encoded.view()).try();
        edits.close(out).try();
        changes.close(out).try();
        edit.close(out).try();
        fix.close(out)
    }
}

ActionTextEdit = {
    range: WireRange,
    newText: str,
}

write_actions* = (
    c    : Checker,
    t    : Alloc,
    file : str,
    text : str,
    uri  : str,
    from : WirePos,
    upto : WirePos,
    out  :: String
) Res<(), AllocError> {
    fixes ::= Fixes(c: c, t: t, file: file, found: t.Vec<Action>());
    lo = to_pos(text, from.line, from.character);
    hi = to_pos(text, upto.line, upto.character);
    Range(0, c.diag_count()).loop((h, i) {
        c.diag_at(i).match({
            None  => written(),
            Ok(d) => fixes.offer(d, lo, hi),
        }).try();
    });
    fixes.write(text, uri, out)
}

// Collects one import fix per undefined name reported inside the range.
Fixes = {
    c     : Checker,
    t     : Alloc,
    file  : str,
    found :: Vec<Action>,

    offer = (self :: @Self, d: Diag, from: Pos, upto: Pos)
            Res<(), AllocError> {
        (d.file.eq(self.file) && d.span.covers(from, upto)).match({
            false => written(),
            true  => d.fault.match({
                UndefinedName(nf) => self.offer_name(nf.name),
                _                 => written(),
            }),
        })
    }

    offer_name = (self :: @Self, name: str) Res<(), AllocError> {
        self.found.find((a) { a.name.eq(name) }).match({
            Ok(_) => written(),
            None  => {
                defs ::= self.t.Vec<Def>();
                self.c.world.exported_named(name, defs).try();
                defs.loop((h, d) {
                    mi = d.id.module.to_usize();
                    self.c.world.table_at(mi).match({
                        None      => written(),
                        Ok(table) => self.offer_at(name, mi, table),
                    }).try();
                });
                Ok(())
            },
        })
    }

    offer_at = (self :: @Self, name: str, mi: usize, table: ModuleTable)
               Res<(), AllocError> {
        offered = self.spoken_home(name, mi, table).try();
        self.found.find((a) { a.name.eq(name) && a.module.eq(offered) }).match({
            Ok(_) => written(),
            None  => self.found.add(Action(name: name, module: offered)),
        })
    }

    // The folder root when it re-exports `name`, else the module itself.
    spoken_home = (self: @Self, name: str, mi: usize, table: ModuleTable)
                  Res<str, AllocError> {
        spoken = module_display(table.name);
        spoken.eq(table.name).match({
            true  => Ok(table.name),
            false => self.c.world.index_of(spoken).match({
                None  => Ok(table.name),
                Ok(r) => (r == mi).match({
                    true  => Ok(table.name),
                    false => {
                        at_root ::= self.t.Vec<Def>();
                        visited ::= self.t.Vec<usize>();
                        self.c.world.exports_of(
                            r,
                            name,
                            at_root,
                            visited
                        ).try();
                        Ok((at_root.len > 0).match({
                            true  => spoken,
                            false => table.name,
                        }))
                    },
                }),
            }),
        })
    }

    // Fixes insert after the last import of the file.
    insert_at = (self: @Self, text: str) WirePos {
        line ::= 1;
        module_index_of(self.c.tree, self.file).match({
            None   => {},
            Ok(mi) => self.c.tree.module_at(mi).match({
                None  => {},
                Ok(m) => m.decls.loop((h, d) {
                    d.kind.match({
                        Import(_) => { line = d.span.end.line + 1; },
                        _         => {},
                    });
                }),
            }),
        });
        to_wire(text, Pos(line: line, col: 1))
    }

    write = (self: @Self, text: str, uri: str, out :: String)
            Res<(), AllocError> {
        at = self.insert_at(text);
        list ::= arr(out).try();
        self.found.loop((h, a) { a.write(self.t, at, uri, list, out).try(); });
        list.close(out)
    }
}

// An empty range covers a span it sits inside; otherwise the two overlap.
covers = (span: Span, from: Pos, upto: Pos) bool {
    empty = from.line == upto.line && from.col == upto.col;
    (empty).match({
        true  => !before(from, span.start) && before(from, span.end),
        false => before(span.start, upto) && before(from, span.end),
    })
}
