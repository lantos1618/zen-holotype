// tests/corpus/stdin/an_empty_stream_answers_zero_and_no_error/main.zen
// END OF INPUT IS `Ok(0)`, NOT AN ERROR. The floor answers fread's 0 with
// Ok and no error, so a reader's "stream closed" arm is reached by
// COUNTING, never by matching: a read that turned an empty stream into
// Err(Closed), or into a zero that skipped the len bump, prints the wrong
// line below. This is the one end-of-input signal Stdin has.
//
// The harness feeds main.stdin (empty = a pipe that closes at once).

main = (env: Env) Res<i32, AllocError> {
    a ::= env.mem.alloc();
    b ::= a.Vec<u8>();
    b.reserve(8).try();

    env.in.read(b, 4).match({
        Err(_) => println("an empty stream was an error"),
        Ok(n) =>
            (n == 0).match({
                true  => println("empty stream is ok zero"),
                false => println("empty stream answered {} bytes", n),
            }),
    });

    // nothing arrived, so nothing may be in the buffer
    println("len {}", b.len);
    Ok(0);
}
