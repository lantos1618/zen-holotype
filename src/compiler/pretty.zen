// compiler.pretty — an AST pretty-printer (canonical Zen text) over the shared genc AST.  @self-hosted-only
//
// Unlike c_emit/js (which consume the LOWERED AST), pretty consumes the FAITHFUL parse_module
// output — the parser keeps `recv.method(args)` as a `MethodCall` node, so the formatter prints it back
// as `recv.method(args)` with the UFCS surface syntax PRESERVED (the whole point: `s.len()` formats as
// `s.len()`, never the flattened `len(s)`).
//
// Style: 4-space indent; a multi-arm `.match ({ … })` splits one arm per line with `=>` aligned and a
// trailing comma on the last arm; multi-field struct literals split one field per line; short single-arm
// / single-expr bodies stay inline.
//
// Same fluent UFCS String-builder walk as js, allocator explicit: `s.ff_append(a, x).ff_expr(a, e)`.
{ String } = std.text.string
{ view } = std.text.str
{ Malloc } = std.mem.alloc
{ Stmt, Decl, Param, Ty, PtrData, CondData, LetData } = compiler.ast.ast_types
{ ptr_kw, slice_kw, k_slice_dflt, gstr_push, gstr_append, acquire_or_die, acquire_or_die } = compiler.genc
{ gstr_int, left_pos_of, stmt_left_pos } = compiler.astops
{ Comment, rawstr_end } = compiler.lex
{ at, rawstr_at } = std.text.ascii
{ times, upto } = std.core.count
{ ff_cond_inline, ff_cond_is_then, ff_cond_multiline, ff_cond_nested, ff_current_col, ff_expr,
  ff_fits_width, ff_recv, ff_then } = compiler.pretty_expr
{ ff_decl, ff_is_anon_payload_name, ff_is_hoisted } = compiler.pretty_decl
// ── comment sidecar state ──────────────────────────────────────────────────────
// The formatter weaves SOURCE comments back into its AST walk. Comments live in a position-sorted
// table (compiler.lex.collect_comments) keyed by byte offset; this module holds the source + table +
// a cursor (the next un-emitted comment). As the walk reaches each statement / decl it FLUSHES every
// leading comment whose start precedes that node, and after a statement it emits a same-line trailing
// comment. Comments never enter the AST, so the lowered tree (and emitted C) is identical with or
// without them — only the formatted text changes. State is module-level (mirrors parse's exports_buf).
gf_no_cmts = () [Comment] { slice(null_ptr(), 0) }
gf_empty_str = () StringView { "" }    // a str-typed (not fixed-array) empty literal
gf_src := gf_empty_str()
gf_cmts := gf_no_cmts()
gf_idx := 0
// the source offset where the current top-level decl ENDS (= the next decl's position). Used as the
// drain boundary for a body's LAST statement, so its interior comments drain up to the decl end but NEVER
// past it into the following decl. Set per top-level decl in pretty_module_in; 0 = the final decl.
gf_block_end := 0
pretty_set_block_end* = (e: i32) void { gf_block_end = e }
pretty_set_comments* = (src: StringView, cmts: [Comment]) void {
    gf_src = src
    gf_cmts = cmts
    gf_idx = 0
}
// Is `name` a NAMESPACE import alias in this module (`hm = std.collections.hmap` / `right = right`)?
// The alias qualification pass (compiler.resolve strip_ns) is TEXTUAL and needs `alias.member`
// adjacent on one line, so the chain-wrapper must never split a spine off an alias base. Detection
// scans the module source lazily for a column-0 `name = <dotted-ident-path>` line (the ns-line
// shape): only called for overflowing spines, and over-matching merely keeps a line long — safe.
gf_ident_ch = (b: u8) bool {
    b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z' || b >= '0' && b <= '9' || b == '_' || b == '.'
}
gf_is_alias* = (name: StringView) bool {
    v: [u8] := name.view()
    src: [u8] := gf_src.view()
    at_bol := true
    src.len.times((i) {
        hit := at_bol && i + v.len + 3 <= src.len
        j: i64 := 0
        @while (hit && j < v.len) {
            (src[i + j] == v[j] == false).then({
                hit = false
            })
            j = j + 1
        }
        (hit && src[i + v.len] == ' ' && src[i + v.len + 1] == '=' && src[i + v.len + 2] == ' ').then({
            k := i + v.len + 3
            ok := k < src.len && gf_ident_ch(src[k])
            @while (k < src.len && src[k] != '\n') {
                ok = (gf_ident_ch(src[k]) || src[k] == '\r').then({ ok }, { false })
                k = k + 1
            }
            ok.then({
                return true
            })
        })
        at_bol = src[i] == '\n'
    })
    false
}
// the line number (count of '\n' before `pos`) — used to decide if a trailing comment shares a stmt's line.
gf_line_of* = (pos: i32) i32 {
    i := 0
    n := 0
    @while (i < pos) {
        (at(gf_src, i) == '\n').then({
            n = n + 1
        })
        i = i + 1
    }
    n
}
// append one comment's raw text, trimming trailing whitespace (a `//` span runs to but not past '\n';
// trailing spaces before the newline are dropped so the formatted line has no dangling whitespace).
gf_cmt_end = (c: Comment) i32 {
    e := c.start + c.len
    @while (e > c.start
        && (at(gf_src, e - 1) == ' ' || at(gf_src, e - 1) == '\t' || at(gf_src, e - 1) == '\r')) {
        e = e - 1
    }
    e
}
ff_cmt_text = (s: String, a: MutPtr<Malloc>, c: Comment) String {
    out := s
    e := gf_cmt_end(c)
    c.start.upto(e, (i) { out = out.ff_push(a, at(gf_src, i)) })
    out
}
// flush every LEADING (own-line) comment whose start is before `before` — each on its own indented line.
// A `before` of 0 means "position unknown": flush nothing (the comment will land at the next known pos).
ff_flush_leading* = (s: String, a: MutPtr<Malloc>, before: i32, ind: i32) String {
    (before <= 0).then({
        return s
    })
    out := s
    @while (gf_idx < gf_cmts.len
        && gf_cmts[gf_idx].start < before
        && gf_cmts[gf_idx].trailing.then({ false }, { true })) {
        out = out.ff_indent(a, ind).ff_cmt_text(a, gf_cmts[gf_idx]).ff_append(a, "\n")
        gf_idx = gf_idx + 1
    }
    out
}
// weave a trailing comment that sits on the SAME source line as `line` (the construct's opening line)
// inline after the text just emitted, then advance the cursor. Used by the boolean-`.match` (Cond)
// printer to keep a comment written on the `x.match ({ …` opening line ON that line, rather than letting
// it escape past the construct's closing `})` (and, when the block inlines, past the enclosing `}`). It
// is idempotent because the comment re-anchors to the SAME physical line every pass: after formatting the
// comment still trails the `.match ({` line, so the next `gf_line_of` check re-matches and re-weaves it.
ff_open_trailing* = (s: String, a: MutPtr<Malloc>, line: i32) String {
    (gf_idx < gf_cmts.len && gf_cmts[gf_idx].trailing && gf_line_of(gf_cmts[gf_idx].start) == line).match ({
        true  => {
            out := s.ff_append(a, "    ").ff_cmt_text(a, gf_cmts[gf_idx])
            gf_idx = gf_idx + 1
            out
        },
        false => s,
    })
}
// rightmost arm-LABEL offset of a Cond (`true`/`false` token, recorded by the parser; 0 = synthesized).
gf_cond_arm_max = (d: CondData) i32 { (d.tpos > d.epos).then({ d.tpos }, { d.epos }) }
// Does a pending comment belong ON the `x.match ({ …` OPENING line of this boolean `.match` (Cond) — i.e.
// interior to the construct, written after `({` and BEFORE the arms — as opposed to a comment trailing
// the whole statement (after the closing `})`)? The distinction matters because only the interior comment
// has no home in the one-line inline form and would escape past the construct/enclosing block. It must be
// a trailing comment on the subject's source line AND sit strictly before the arm bodies (`start < body_max`),
// which requires the arms to carry positions. When BOTH arms are position-less (bare literals like `1`/`0`),
// there is no reliable bound to tell an opening-line comment apart from one trailing a one-line `})`, so we
// deliberately do NOT force expansion — see the residual noted in ff_cond, keeping already-clean one-liners
// (and their statement-trailing comments) untouched rather than risk relocating them.
gf_cond_open_cmt* = (d: CondData) bool {
    (gf_idx >= gf_cmts.len).then({
        return false
    })
    (gf_cmts[gf_idx].trailing == false).then({
        return false
    })
    rp := left_pos_of(d.c)
    (rp <= 0).then({
        return false
    })
    (gf_line_of(gf_cmts[gf_idx].start) != gf_line_of(rp)).then({
        return false
    })
    bm := d.gf_cond_arm_max()
    bm > 0 && gf_cmts[gf_idx].start < bm
}
// Is the next pending comment INTERIOR to this Cond — sitting after the receiver and before the arm
// bodies (own-line OR trailing)? Such a comment has no home in the one-line inline form, so its presence
// forces the multiline printer, which weaves it beside its arm. Position-less bare-literal arms (bm == 0)
// give no bound, so an interior comment there is left inline (the acknowledged residual in ff_cond).
gf_cond_interior_cmt* = (d: CondData) bool {
    (gf_idx >= gf_cmts.len).then({
        return false
    })
    rp := left_pos_of(d.c)
    bm := d.gf_cond_arm_max()
    bm > 0 && gf_cmts[gf_idx].start > rp && gf_cmts[gf_idx].start < bm
}
// if the NEXT pending comment is TRAILING (code precedes it on its source line), emit it inline after
// the just-printed statement (two spaces then the text). Source order + the trailing flag make this
// unambiguous and IDEMPOTENT: a trailing comment always immediately follows its own statement, and a
// leading (own-line) comment of the next statement has trailing=false, so it is never grabbed here.
// (A line check would not be idempotent — formatting moves a comment trailing a multi-line construct's
// opening line to after its closing `})`, a different physical line, flipping it to own-line on re-fmt.)
ff_trailing* = (s: String, a: MutPtr<Malloc>, boundary: i32) String {
    (gf_idx < gf_cmts.len && gf_cmts[gf_idx].trailing && gf_before(gf_cmts[gf_idx].start, boundary)).match ({
        true  => {
            out := s.ff_append(a, "    ").ff_cmt_text(a, gf_cmts[gf_idx])
            gf_idx = gf_idx + 1
            out
        },
        false => s,
    })
}
// is `start` before the next statement's position `boundary`? boundary 0 = "no next stmt" = unbounded
// (the trailing comment is the last thing in the block, so it belongs to the statement just printed).
gf_before = (start: i32, boundary: i32) bool {
    (boundary <= 0).then({ true }, { start < boundary })
}
// DRAIN the just-printed statement's trailing-comment region [stmt, boundary): the FIRST pending comment
// prints inline iff it is trailing (shares the statement's source line); EVERY remaining comment STRICTLY
// before the boundary prints on its own line at `ind`. Draining the whole region is what makes the
// formatter IDEMPOTENT for multi-line statements: a comment interior to a multi-line `.match` that reflow
// moves to after the statement still falls in the SAME [stmt, boundary) region on the next pass, so it
// drains identically (rather than leaking onto the following statement and migrating each format).
//   boundary 0 = "no next statement / unknown end": the inline same-line comment is still emitted, but the
//   own-line drain is SUPPRESSED — own-line comments after the LAST statement belong to the NEXT decl (or
//   are flushed as that decl's leading comments), NOT greedily consumed into this block (which, with an
//   unbounded drain, would suck every following section comment in the whole file into the first function).
ff_drain = (s: String, a: MutPtr<Malloc>, db: i32, ib: i32, ind: i32) String {
    // ib <= 0 ⇒ this is the block's LAST statement: emit NO inline trailing comment here (a comment after
    // the block's closing `}` is a DECL-level trailing, handled by ff_top_decl) — otherwise the unbounded
    // ff_trailing would steal a much-later decl's comment. ib > 0 ⇒ a real next-stmt bound.
    out := (ib > 0).then({ s.ff_trailing(a, ib) }, { s })
    (db <= 0).then({
        return out
    })
    @while (gf_idx < gf_cmts.len && gf_cmts[gf_idx].start < db) {
        out = out.ff_append(a, "\n").ff_indent(a, ind).ff_cmt_text(a, gf_cmts[gf_idx])    // no own-line drain without a real next-stmt boundary
        gf_idx = gf_idx + 1
    }
    out
}
// flush all comments still pending (end of module): each as its own line.
ff_flush_rest = (s: String, a: MutPtr<Malloc>, ind: i32) String {
    out := s
    @while (gf_idx < gf_cmts.len) {
        out = out.ff_indent(a, ind).ff_cmt_text(a, gf_cmts[gf_idx]).ff_append(a, "\n")
        gf_idx = gf_idx + 1
    }
    out
}
// a top-level decl's representative source offset = its OWN start byte (the name/keyword position), so a
// leading comment ABOVE the decl flushes at that decl and a comment INSIDE a body (e.g. before the first
// statement) is NOT hoisted above the decl — the body's own ff_stmts drain emits it in place. Body-less
// decls (enum/struct/global/foreign) now carry a real `pos`, so their leading comments no longer pile up
// at the next positioned decl / EOF. 0 = genuinely unknown (synthesized / DRaw) → leading comments defer.
// (Funcs/globals keep a body/init fallback for any synthesized node whose pos was never recorded.)
// Every source-parsed decl carries its own name byte offset, so use it DIRECTLY (no body/init fallback):
// a function whose name sits at offset 0 (the first decl in a file) legitimately reports 0, and 0 is the
// "defer" sentinel — which is exactly right, since nothing precedes byte 0, and a comment INSIDE the body
// drains in place via ff_stmts rather than being hoisted above the decl. Synthesized decls (DRaw, compiler
// rewrites) have pos 0 and harmlessly defer.
gf_decl_pos = (d: Decl) i32 {
    d.match ({
        .DFunc(f)         => f.pos,
        .DForeign(f)      => f.pos,
        .DTraitDefault(t) => t.fn.pos,
        .DStruct(sd)      => sd.pos,
        .DEnum(ed)        => ed.pos,
        .DGenStruct(g)    => g.pos,
        .DGenEnum(g)      => g.pos,
        .DGlobal(g)       => g.pos,
        .DImpl(im)        => im.pos,
        .DImport(im)      => im.pos,
        _                 => 0,
    })
}
// ── String builder shims (reuse the canonical genc String API) ───────────────
ff_string* = (a: MutPtr<Malloc>, cap: i64) String {
    String(
        ptr: a.acquire_or_die(cap),
        len: 0,
        cap: cap,
    )
}
ff_append* = (s: String, a: MutPtr<Malloc>, t: StringView) String { s.gstr_append(a, t) }
// A `"""…"""` literal is reproduced from SOURCE, byte for byte. Re-rendering it through the normal
// string path would escape the contents back into `\"` and `\n` — turning the user's raw text into
// exactly the form the raw literal exists to avoid, and silently rewriting their file. Returns the
// whole literal INCLUDING both delimiters, or "" when `pos` does not open one (pos 0 = synthesized
// node, and gf_src is empty outside `zen fmt`, so both fall through to the escaping path).
gf_raw_lit* = (a: MutPtr<Malloc>, pos: i32) StringView {
    v: [u8] := gf_src.view()
    (pos <= 0 || pos + 6 > v.len.to_i32() || gf_src.rawstr_at(pos) == false).then({
        return ""
    })
    end := gf_src.rawstr_end(pos + 3)
    out := a.gstr_string(end - pos + 1)
    pos.upto(end, (i) { out = out.ff_push(a, at(gf_src, i)) })
    out.gstr_finish(a)
}
ff_push* = (s: String, a: MutPtr<Malloc>, b: u8) String { s.gstr_push(a, b) }
// integer rendering is the shared gstr_int/gstr_uint (compiler.astops); a `.Int` node with the top bit
// set (n<0 as i64) is a u64 literal ABOVE i64-max — real negatives are `0 - x` Bin nodes, never a
// negative `.Int` — so gstr_int reinterprets its exact bit pattern and prints UNSIGNED decimal
// (`0xcbf29ce484222325` → `14695981039346656037`, not the wrong signed `-3750763034362895579`).
// render a char-literal byte `n` back as a `'x'` literal (a `.Byte` AST node ONLY ever comes from a
// char literal, so this round-trips `'a'` → `'a'` instead of leaking the raw byte value `97`). Common
// escapes are re-escaped; a printable ASCII byte prints bare; anything else falls back to the integer
// (which still emits the identical value, so the lowered AST / C is unchanged either way).
ff_char* = (s: String, a: MutPtr<Malloc>, n: i32) String {
    (n == '\n').then({
        return s.ff_append(a, "'\\n'")
    })
    (n == '\t').then({
        return s.ff_append(a, "'\\t'")
    })
    (n == '\r').then({
        return s.ff_append(a, "'\\r'")
    })
    (n == '\0').then({
        return s.ff_append(a, "'\\0'")
    })
    (n == '\\').then({
        return s.ff_append(a, "'\\\\'")
    })
    (n == '\'').then({
        return s.ff_append(a, "'\\''")
    })
    (n >= ' ' && n <= '~').match ({
        true  => s.ff_append(a, "'").ff_push(a, to_u8(n)).ff_append(a, "'"),
        false => s.gstr_int(a, n),
    })
}
// n levels of 4-space indentation
ff_indent* = (s: String, a: MutPtr<Malloc>, n: i32) String {
    (n <= 0).then({ s }, { s.ff_append(a, "    ").ff_indent(a, n - 1) })
}
// ── types ────────────────────────────────────────────────────────────────────
ff_ty* = (s: String, a: MutPtr<Malloc>, t: Ty) String {
    t.match ({
        .I32           => s.ff_append(a, "i32"),
        .I64           => s.ff_append(a, "i64"),
        .U8            => s.ff_append(a, "u8"),
        .F64           => s.ff_append(a, "f64"),
        .Bool          => s.ff_append(a, "bool"),
        .Void          => s.ff_append(a, "void"),
        .StringView    => s.ff_append(a, "StringView"),
        .StringCstr    => s.ff_append(a, "StringCstr"),
        .StringLiteral => s.ff_append(a, "StringLiteral"),
        .Named(nm)     => s.ff_append(a, nm),
        .Ptr(pd)       => s
            .ff_append(a, ptr_kw(pd.kind))
            .ff_append(a, "<")
            .ff_ty(a, load(pd.pointee))
            .ff_append(a, ">"),
        .Slice(p)      => s.ff_slice_ty(a, p),
        .FnT(ft)       => s
            .ff_append(a, "(")
            .ff_tys(a, ft.params)
            .ff_append(a, ") ")
            .ff_ty(a, load(ft.ret)),
        .Generic(g)    => s
            .ff_append(a, g.name)
            .ff_append(a, "<")
            .ff_tys(a, g.args)
            .ff_append(a, ">"),
    })
}
// `[T]` is the sugar for the DEFAULT slice kind, so print that spelling back verbatim (every
// existing source writes it); only the non-default kind needs its keyword form.
ff_slice_ty = (s: String, a: MutPtr<Malloc>, pd: PtrData) String {
    (pd.kind == k_slice_dflt()).match ({
        true  => s.ff_append(a, "[").ff_ty(a, load(pd.pointee)).ff_append(a, "]"),
        false => s
            .ff_append(a, slice_kw(pd.kind))
            .ff_append(a, "<")
            .ff_ty(a, load(pd.pointee))
            .ff_append(a, ">"),
    })
}
ff_tys* = (s: String, a: MutPtr<Malloc>, ts: [Ty]) String {
    out := s
    ts.loop((h, i, t) {
        out = (i == 0).then({ out }, { out.ff_append(a, ", ") })
        out = out.ff_ty(a, t)
    })
    out
}
ff_cond* = (s: String, a: MutPtr<Malloc>, d: CondData, ind: i32) String {
    d.ff_cond_is_then().then({
        return s.ff_then(a, d, ind)
    })
    d.ff_cond_nested().then({
        return s.ff_cond_multiline(a, d, ind)
    })
    // A comment written on the `x.match ({ …` opening line (interior, before the arms) has no home in the
    // one-line inline form and would escape past the construct/enclosing block — expand so the multiline
    // printer can weave it onto that same opening line. A comment trailing the whole statement (after
    // `})`) is NOT interior and keeps the clean inline form. RESIDUAL: when both arm bodies are
    // position-less bare literals, gf_cond_open_cmt cannot bound the opening line, so such an interior
    // comment on a sole-body boolean match may still migrate (never worse than the pre-fix behavior).
    d.gf_cond_interior_cmt().then({
        return s.ff_cond_multiline(a, d, ind)
    })
    saved_comment := gf_idx
    trial := a.ff_string(256).ff_cond_inline(a, d, ind)
    gf_idx = saved_comment
    single_line := trial.ff_str_has_nl().then({ false }, { true })
    (single_line && trial.ff_fits_width(s.ff_current_col(), 100)).match ({
        true  => s.ff_cond_inline(a, d, ind),
        false => s.ff_cond_multiline(a, d, ind),
    })
}
// ── statements ─────────────────────────────────────────────────────────────────
// Two block flavors, matching the parser's TWO body parsers:
//  • VALUE block (drop_ret = true): a function/lambda body — the parser's `parse_stmts` turns the
//    trailing expression into a Return, so the LAST Return is the implicit value and prints BARE
//    (`{ s.len() }`, not `{ return s.len() }`). A non-last Return is a genuine early return → keeps `return`.
//  • STATEMENT block (drop_ret = false): a match-arm / loop / if / while block — the parser's `parse_block`
//    has NO trailing-return rule, so a Return there is ALWAYS an explicit early return → ALWAYS keep `return`.
// is there a '\n' anywhere in the built String? (used to keep an inline body inline only when its single
// statement formats to ONE line — a multi-arm match / multi-field struct splits and forces multi-line.)
ff_scan_nl = (p: RawPtr<u8>, i: i64, n: i64) bool {
    (i >= n).match ({
        true  => false,
        false => (load(offset(p, i)) == '\n').then({ true }, { ff_scan_nl(p, i + 1, n) }),
    })
}
ff_str_has_nl* = (s: String) bool { ff_scan_nl(s.ptr, 0, s.len) }
// does the single statement format to ONE physical line? Formats into a THROWAWAY String. ff_stmt_at can
// reach ff_arms (a Match weaves comments and ADVANCES gf_idx), so the comment cursor is SNAPSHOT and
// RESTORED — making this trial render side-effect-free (otherwise a single-statement body that holds a
// match would have its arm comments consumed by the trial and then DROPPED by the real render).
// WIDTH gate for the inline `{ <stmt> }` body: header column + "{ " + stmt + " }" must fit in 100.
// An overlong one-liner expands to block form, where the statement re-renders at ind+1 and the
// chain-wrapping in ff_bin / the MethodCall spine takes over (compiler.pretty_expr).
ff_one_line_fits = (a: MutPtr<Malloc>, s: String, st: Stmt, drop: bool, ind: i32) bool {
    save := gf_idx
    trial := a.ff_string(256).ff_stmt_at(a, st, drop, ind)
    gf_idx = save
    trial.ff_fits_width(s.ff_current_col() + 2, 98)
}
ff_one_line = (a: MutPtr<Malloc>, st: Stmt, drop: bool, ind: i32) bool {
    save := gf_idx
    r := ff_str_has_nl(a.ff_string(256).ff_stmt_at(a, st, drop, ind)).then({ false }, { true })
    gf_idx = save
    r
}
// Inlining a single-statement body skips ff_stmts, so it is SAFE exactly when ff_stmts would weave no
// comment into this body. For one statement (the last), ff_stmts drains nothing (db = ib = 0) and only
// ff_flush_leading(sp) can emit anything — and that emits a comment ONLY when the FIRST pending comment is
// an own-line (non-trailing) comment with start < sp (it returns immediately for sp <= 0 and STOPS at the
// first trailing comment). Mirroring that test EXACTLY makes the inline and multi-line paths handle
// comments identically, so the choice is idempotent even as struct-interior comments migrate across passes.
ff_no_lead_cmt = (sp: i32) bool {
    (sp <= 0).then({
        return true
    })
    (gf_idx >= gf_cmts.len).then({
        return true
    })
    (gf_cmts[gf_idx].start >= sp).then({
        return true
    })
    gf_cmts[gf_idx].trailing
}
// A VALUE block (drop_ret = a function / lambda / method body) whose body is ONE single-line statement
// stays inline — `{ s.len() }` — matching the codebase's one-liner style and keeping `zenc doc`'s first
// line intact. STATEMENT blocks (match arms / loop / if / while, drop_ret = false) ALWAYS expand, as the
// fixtures require. Inlining is suppressed when a leading comment sits inside the body (it would be dropped).
ff_block* = (s: String, a: MutPtr<Malloc>, body: [Stmt], ind: i32, drop_ret: bool) String {
    (body.len == 0).match ({
        true  => s.ff_append(a, "{ }"),
        false => (drop_ret
            && body.len == 1
            && ff_no_lead_cmt(stmt_left_pos(body[0]))
            && a.ff_one_line(body[0], drop_ret, ind)
            && a.ff_one_line_fits(s, body[0], drop_ret, ind)).match ({
            true  => s.ff_append(a, "{ ").ff_stmt_at(a, body[0], drop_ret, ind).ff_append(a, " }"),
            false => {
                open := s.ff_append(a, "{\n")
                inner := open.ff_stmts(a, body, ind + 1, drop_ret)
                inner.ff_indent(a, ind).ff_append(a, "}")
            },
        }),
    })
}
ff_stmts = (s: String, a: MutPtr<Malloc>, body: [Stmt], ind: i32, drop_ret: bool) String {
    out := s
    last := body.len - 1
    body.loop((h, i, st) {
        // Both the OWN-LINE drain and the INLINE same-line comment are capped at the NEXT statement's pos,
        // so neither pulls a following statement's comment back. The LAST statement uses 0 for BOTH — it
        // emits no trailing comment itself; a comment trailing the block's closing `}` is a DECL-level
        // trailing comment, emitted by ff_top_decl (bounded by the next decl), which keeps it from being
        // stolen by a sibling one-liner and keeps re-formatting idempotent.
        nb := (i < last).then({ stmt_left_pos(body[i + 1]) }, { 0 })
        out = out.ff_one_stmt(a, st, drop_ret && i == last, ind, nb, nb)
    })
    out
}
// one statement line: leading comments (before it) → the statement → its trailing comment → newline.
// `db` (own-line drain boundary) caps which following comments this statement absorbs; `ib` (inline
// boundary) caps the single same-line trailing comment.
ff_one_stmt = (
    s: String,
    a: MutPtr<Malloc>,
    st: Stmt,
    drop: bool,
    ind: i32,
    db: i32,
    ib: i32,
) String {
    sp := stmt_left_pos(st)
    lead := s.ff_flush_leading(a, sp, ind)
    body := lead.ff_indent(a, ind).ff_stmt_at(a, st, drop, ind)
    withc := body.ff_drain(a, db, ib, ind)
    withc.ff_append(a, "\n")
}
ff_stmt_at = (s: String, a: MutPtr<Malloc>, st: Stmt, drop: bool, ind: i32) String {
    drop.match ({
        true  => st.match ({
            .Return(e) => s.ff_expr(a, e, ind),
            _          => s.ff_stmt(a, st, ind),
        }),
        false => s.ff_stmt(a, st, ind),
    })
}
ff_stmt = (s: String, a: MutPtr<Malloc>, st: Stmt, ind: i32) String {
    st.match ({
        .Let(l)      => s.ff_let(a, l, ind),
        .Assign(asn) => s.ff_expr(a, asn.target, ind).ff_append(a, " = ").ff_expr(a, asn.value, ind),
        .Return(e)   => s.ff_append(a, "return ").ff_expr(a, e, ind),
        .ExprStmt(e) => s.ff_expr(a, e, ind),
        // Internal branch IR is never parsed from Zen source. If a resolved tree is printed through
        // this API, preserve the language invariant by spelling it as a boolean `.match`.
        .If(f)       => s
            .ff_append(a, "(")
            .ff_expr(a, f.c, ind)
            .ff_append(a, ").match ({ true => ")
            .ff_block(a, f.then, ind, false)
            .ff_append(a, ", false => ")
            .ff_block(a, f.els, ind, false)
            .ff_append(a, " })"),
        .While(w)    => s
            .ff_append(a, "@while (")
            .ff_expr(a, w.c, ind)
            .ff_append(a, ") ")
            .ff_block(a, w.body, ind, false),
        .IndexSet(x) => s
            .ff_recv(a, x.seq, ind)
            .ff_append(a, "[")
            .ff_expr(a, x.idx, ind)
            .ff_append(a, "] = ")
            .ff_expr(a, x.value, ind),
    })
}
// `name := value` (inferred) or `name: T := value` (annotated)
ff_let = (s: String, a: MutPtr<Malloc>, l: LetData, ind: i32) String {
    head := l.ty.match ({
        .Void => s.ff_append(a, l.name),
        _     => s.ff_append(a, l.name).ff_append(a, ": ").ff_ty(a, l.ty),
    })
    head.ff_append(a, " := ").ff_expr(a, l.value, ind)
}
// ── module: each decl on its own line; hoisted methods + inherent-impl markers are skipped (their
// bodies print inside the owning struct / trait impl instead). ───────────────────────────────────
pretty_module_in* = (a: MutPtr<Malloc>, decls: [Decl], exp: [Param]) String {
    s := a.ff_string(8192)
    out := s
    decls.loop((h, i, d) {
        nb := a.gf_next_decl_pos(decls, i + 1)    // the next EMITTED decl's pos → trailing-comment boundary
        pretty_set_block_end(nb)    // bound this decl's body last-stmt drain to the decl end
        d.match ({
            .DFunc(f)          => (a.ff_is_hoisted(decls, f.name) == false).then({
                out = a.ff_top_decl(out, exp, decls, d, nb)
            }),
            .DImpl(im)         => (im.ty == im.trname == false).then({
                out = a.ff_top_decl(out, exp, decls, d, nb)
            }),
            .DTraitDefault(td) => { },    // body re-inlined at its record's field slot (ff_record_field)
            .DStruct(sd)       => (a.ff_is_anon_payload_name(decls, sd.name) == false).then({
                out = a.ff_top_decl(out, exp, decls, d, nb)
            }),    // suppress synthesized multi-field variant-payload structs (rendered inline as `(t0, …)`)
            _                  => {
                out = a.ff_top_decl(out, exp, decls, d, nb)
            },
        })
    })
    out.ff_flush_rest(a, 0)
}
// the source position of the next decl at or after index `i` that HAS one (skips position-less decls,
// e.g. inherent-impl markers, so the boundary is a real source offset). 0 = none left. Used only to cap
// which trailing comment belongs to the decl just printed — a slightly loose bound is harmless.
gf_next_decl_pos = (a: MutPtr<Malloc>, decls: [Decl], i: i32) i32 {
    (i >= decls.len).then({
        return 0
    })
    // a DTraitDefault is never emitted at top level (its body prints inside its record), so its pos —
    // a byte INSIDE the record's own text — must not serve as the record's trailing-comment boundary.
    // A HOISTED method DFunc (inherent or trait-impl) is likewise re-inlined inside its owner, and now
    // carries its own name offset (for ff_methods' leading-comment flush); that offset sits BEFORE the
    // owner's closing brace, so it too must be skipped — otherwise a comment trailing the record's `}`
    // would be truncated out of the record's trailing-comment region and leak into the next decl's body.
    p := decls[i].match ({
        .DTraitDefault(td) => 0,
        .DFunc(f)          => a.ff_is_hoisted(decls, f.name).then({ 0 }, { f.pos }),
        _                  => gf_decl_pos(decls[i]),
    })
    (p > 0).then({ p }, { a.gf_next_decl_pos(decls, i + 1) })
}
// one top-level decl: leading comments (col 0) → the decl → its trailing comment (bounded by `nb`) → newline.
ff_top_decl = (a: MutPtr<Malloc>, s: String, exp: [Param], decls: [Decl], d: Decl, nb: i32) String {
    lead := s.ff_flush_leading(a, gf_decl_pos(d), 0)
    body := lead.ff_decl(a, exp, decls, d)
    withc := body.ff_trailing(a, nb)    // a decl gets only an inline same-line comment; own-line
    withc.ff_append(a, "\n")
}    // comments between decls are LEADING for the next decl
