// src/gen/gen_c/gen_c_alloc.zen
// `alloc.create<T>()` — the one member of `Alloc` whose body is this
// backend's.
// `mem_alloc.zen` declares it as a hook with no body, and no impl in the
// language supplies one — `gen_c_fat.zen` puts a NULL in its slot for
// that reason. DESIGN.md calls it "the typed conveniences: one T's
// worth of storage, already named": storage is `raw`, naming it is
// `Ptr.to`.
// WITHOUT THIS FILE THE CALL RESOLVES TO NOTHING: `p =
// alloc.create<Node>().try()` left `p` untyped, so `p.write(0, ..)` and
// `p.read(0)` were reported unresolved a line later — one missing
// member surfacing as three errors, none naming it.
// NO NEW MACHINERY: the `raw` called is the receiver's OWN, under the
// symbol `raw_call` builds. Its `Res<Ptr<u8>, E>` is rebuilt at
// `Res<Ptr<T>, E>` by `gen_c_bound.zen`'s `convert`, out of a temporary
// — so `raw` is called ONCE, not twice with the second allocation
// leaking. The argument list is written as TEXT, since there's no call
// node for it: the source wrote `create`, not `raw`.
// 16 IS ALIGN_MAX, not a guess — `mem_arena.zen` re-requests every run
// at the strictest alignment any Zen value needs, so this asks for what
// the arena would give anyway and keeps its size header intact.
// `gen_c_fs.zen` writes the same 16 for the same reason.
// ELEMENT TYPE IS NOT LOOKED UP BY NAME. `Ptr`/`AllocError` are prelude
// names; interning them here would be a second opinion on which
// declaration they are. Both come off `raw`'s own declared return type
// (`Res<Ptr<u8>, AllocError>`) instead — element is the only thing that
// changes, error set is the allocator's own.

ExprId, Access, Call, Function, TypeId = std.ast
AllocError = std.mem
Vec = std.collections
str, String = std.text
TyId, TyNamed, TyRes = sema.sema_ty
Ctx = sema.sema_check
Inst = sema.sema_inst
self_ctx = sema.sema_member
CBackend = gen.gen_c.gen_c_state
untyped = gen.gen_c.gen_c_report
sub, recv_inst, inst_open, any_open = gen.gen_c.gen_c_mono
request_type = gen.gen_c.gen_c_type
Site, site_of, method_sig, member_symbol = gen.gen_c.gen_c_member
impl_member_of = gen.gen_c.gen_c_impl
write_arg = gen.gen_c.gen_c_call
convert, write_sizeof = gen.gen_c.gen_c_bound
ptr_at = gen.gen_c.gen_c_ptr

// recognising

// The receiver's own `raw`, and the site its symbol is built from. One
// value rather than two lookups: recognising `create` and lowering it
// ask the same question, and asking it twice is how the two come to
// disagree about which allocator they meant.
RawFn* = {
    site*: Site,
    f*: Function,
}

// The name AND a receiver that really allocates: a type with no `raw`
// has no `create` this file could write.
// Asked LAST, after the receiver's own declaration and impls are
// searched, so a type declaring its own `create` still wins.
alloc_raw* = (be :: CBackend, rty: TyId, name: str)
             Res<Res<RawFn>, AllocError> {
    name.eq("create").match({
        false => Ok(None),
        true  => be.raw_of(rty),
    })
}

raw_of = (be :: CBackend, rty: TyId) Res<Res<RawFn>, AllocError> {
    site_of(be, rty).try().match({
        None  => Ok(None),
        Ok(s) => be.raw_at_site(s),
    })
}

// `(self, size, align)` is three, and the arity is asked because
// "resolution is on declared parameter types and arity" — a `raw` of
// another shape is another function.
raw_at_site = (be :: CBackend, s: Site) Res<Res<RawFn>, AllocError> {
    be.impl_member_of(s.decl, "raw", 3).try().match({
        None  => Ok(None),
        Ok(f) => Ok(Ok(RawFn(site: s, f: f))),
    })
}

// what it evaluates to

// The three types one `create` settles: what is being made, what `raw`
// answers with, and what the call itself is.
Created* = {
    elem*: TyId,
    raw_ret*: TyId,
    ret*: TyId,
}

// `Res<Ptr<T>, AllocError>`. Sema doesn't answer it — `create` is a
// generic member with no body, so the memo holds an unknown — and an
// unanswered `.try()` operand is a temporary declared at nothing.
create_type* = (be :: CBackend, c: Call, a: Access, rty: TyId, ctx: Ctx)
               Res<Res<TyId>, AllocError> {
    be.alloc_raw(rty, a.name.text).try().match({
        None  => Ok(None),
        Ok(r) => be.created_type(c, rty, r, ctx),
    })
}

created_type = (be :: CBackend, c: Call, rty: TyId, r: RawFn, ctx: Ctx)
               Res<Res<TyId>, AllocError> {
    be.created(c, rty, r, ctx).try().match({
        None  => Ok(None),
        Ok(x) => Ok(Ok(x.ret)),
    })
}

// THE WRITTEN TYPE ARGUMENT AND NOTHING ELSE. `create` takes no
// argument to infer from, so `create()` with nothing to name is a
// refusal: the element is what the size is taken of, and inventing one
// is a `malloc` of the wrong length that links and runs.
created = (be :: CBackend, c: Call, rty: TyId, r: RawFn, ctx: Ctx)
          Res<Res<Created>, AllocError> {
    c.targs.get(0).match({
        None  => Ok(None),
        Ok(t) => be.created_of(t, rty, r, ctx),
    })
}

created_of = (be :: CBackend, t: TypeId, rty: TyId, r: RawFn, ctx: Ctx)
             Res<Res<Created>, AllocError> {
    elem = sub(be, be.check.type_from_ast(t, ctx).try()).try();
    rt   = be.raw_result(rty, r).try();
    be.created_at(elem, rt)
}

created_at = (be :: CBackend, elem: TyId, rt: TyId)
             Res<Res<Created>, AllocError> {
    be.check.types.at(rt).match({
        Res(x) => be.created_res(elem, rt, x),
        _      => Ok(None),
    })
}

created_res = (be :: CBackend, elem: TyId, rt: TyId, x: TyRes)
              Res<Res<Created>, AllocError> {
    be.check.types.at(x.value).match({
        Named(n) => be.created_named(elem, rt, x, n),
        _        => Ok(None),
    })
}

// A `raw` answering anything but a run of bytes is not an allocator,
// and this file has nothing to say about its `create`.
created_named = (be :: CBackend, elem: TyId, rt: TyId, x: TyRes, n: TyNamed)
                Res<Res<Created>, AllocError> {
    n.name.eq("Ptr").match({
        false => Ok(None),
        true  => be.created_ptr(elem, rt, x, n),
    })
}

created_ptr = (be :: CBackend, elem: TyId, rt: TyId, x: TyRes, n: TyNamed)
              Res<Res<Created>, AllocError> {
    pt  = be.ptr_at(n, elem).try();
    ret = be.check.types.res_failure(pt, x.error).try();
    Ok(Ok(Created(elem: elem, raw_ret: rt, ret: ret)));
}

// What `raw` answers, READ OFF ITS OWN DECLARATION with `@Self` bound
// to this receiver — read and not built, so the temporary `convert`
// declares carries the callee's own C type.
raw_result = (be :: CBackend, rty: TyId, r: RawFn) Res<TyId, AllocError> {
    sctx = be.check.self_ctx(r.site.decl.module.to_usize(), rty).try();
    r.f.ret.match({
        None  => be.check.types.unknown(),
        Ok(t) => sub(be, be.check.type_from_ast(t, sctx).try()),
    })
}

// the body

// `false` when the receiver is not an allocator, which is the caller's
// signal to carry on down the ordinary path — the same shape
// `lower_eq_call` uses, and for the same reason: this file answering
// "not mine" must not look like this file answering "no such member".
lower_create* = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    ctx : Ctx,
    out :: String
) Res<bool, AllocError> {
    be.alloc_raw(rty, a.name.text).try().match({
        None  => Ok(false),
        Ok(r) => be.write_create(id, c, a, rty, r, ctx, out),
    })
}

write_create = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    r   : RawFn,
    ctx : Ctx,
    out :: String
) Res<bool, AllocError> {
    be.created(c, rty, r, ctx).try().match({
        None  => be.nothing_to_make(id, out),
        Ok(x) => be.write_made(a, rty, r, x, ctx, out),
    })
}

nothing_to_make = (be :: CBackend, id: ExprId, out :: String)
                  Res<bool, AllocError> {
    be.untyped(id, "create", out).try();
    Ok(true);
}

write_made = (
    be  :: CBackend,
    a   : Access,
    rty : TyId,
    r   : RawFn,
    x   : Created,
    ctx : Ctx,
    out :: String
) Res<bool, AllocError> {
    call ::= be.alloc.String().try();
    be.raw_call(a.base, rty, r, x, ctx, call).try().match({
        false => Ok(false),
        true  => be.rebuild_at_elem(call.view(), x, out),
    })
}

rebuild_at_elem = (be :: CBackend, call: str, x: Created, out :: String)
                  Res<bool, AllocError> {
    be.request_type(x.ret).try();
    be.convert(call, x.raw_ret, x.ret, out).try();
    Ok(true);
}

// The receiver's own `raw`, under the symbol `a.raw(..)` would have
// produced: the same qualified name over the same signature, and the
// same queue entry — so the call this file writes and the call the
// source could have written cannot come out as two functions.
raw_call = (
    be   :: CBackend,
    recv : ExprId,
    rty  : TyId,
    r    : RawFn,
    x    : Created,
    ctx  : Ctx,
    out  :: String
) Res<bool, AllocError> {
    inst = be.recv_inst(rty).try();
    sig ::= be.alloc.Vec<TyId>();
    be.method_sig(
        rty,
        r.site.decl,
        r.f,
        r.site.decl.module.to_usize(),
        inst,
        sig
    ).try();
    (be.inst_open(inst) || be.any_open(sig)).match({
        true  => Ok(false),
        false => be.write_raw_call(recv, rty, r, x, sig, inst, ctx, out),
    })
}

write_raw_call = (
    be   :: CBackend,
    recv : ExprId,
    rty  : TyId,
    r    : RawFn,
    x    : Created,
    sig  : Vec<TyId>,
    inst : Inst,
    ctx  : Ctx,
    out  :: String
) Res<bool, AllocError> {
    sym = be.member_symbol(rty, r.site, "raw", sig, inst).try();
    out.fmt("{}(", sym.view()).try();
    be.write_arg(recv, 0, r.f, sig, ctx, out).try();
    be.write_sizeof(x.elem, out).try();
    out.add_bytes(", 16)").try();
    Ok(true);
}
