{ buf_in, dup_in, node_in, concat_in } = std.core.slice
{ expect } = std.core.result
alloc = std.mem.heap
arena = std.mem.arena
main = () i32 {
    heap := alloc.gpa()
    a := arena.make_in(heap.addr(), 1024).expect("make_in")
    xs := a.addr().dup_in([1, 2, 3]).expect("dup_in")
    ys := a.addr().concat_in(xs, [4, 5]).expect("concat_in")
    p := a.addr().node_in(9).expect("node_in")
    zs := a.addr().buf_in(2, xs).expect("buf_in")
    zs[0] = load(p)
    zs[1] = ys[4]
    out := zs[0] + zs[1]
    a.addr().free(heap.addr())
    out
}
