// Exercises the std.sys.os additions end to end: args() as an owned MutSlice<str>, has_flag / flag_str over argv,
// and a set_env → getEnv → unset_env round-trip (deterministic — no argv needed for the env half).
halloc = std.mem.heap
{ args, has_flag, flag_str, set_env, unset_env, getEnv } = std.sys.os
{ expect } = std.core.result
{ println } = std.text.fmt
main = () i32 {
    heap = halloc.gpa()
    // args() = the whole command line as one owned slice; argv[0] is the program, argc = .len.
    // Returns Result now (OOM surfaces as .Err instead of a null-backbone crash); this fail-fast
    // root closes with .expect.
    av = heap.addr().args().expect("args: out of memory")
    println(av.len)
    // has_flag / flag_str are the minimal flag reader over argv.
    println(has_flag("--verbose").then({ "verbose-on" }, { "verbose-off" }))
    // flag_str returns "" when the key is absent (this fixture is run without it).
    println((flag_str("--out") == "").then({ "out-empty" }, { "out-set" }))
    // env round-trip: set → read → unset → read (deterministic).
    set_env("ZEN_OS_TEST", "hi")
    println(getEnv("ZEN_OS_TEST"))
    unset_env("ZEN_OS_TEST")
    println((getEnv("ZEN_OS_TEST") == "").then({ "unset-ok" }, { "unset-bad" }))
    0
}
