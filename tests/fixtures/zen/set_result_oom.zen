// Set fallible ops surface OOM as a Result value (errors-as-values), matching HMap. The happy path over a
// real heap allocator builds a set (of/add/grow) and probes it; the OOM path runs every allocating entry
// point (of/empty/add) through a failing allocator and asserts each returns .Err instead of null-derefing.
halloc = std.mem.heap
sets = std.collections.set
{ Allocator, try_acquire } = std.mem.alloc
{ Result, IoError } = std.core.result
{ to_exit } = std.core.bool
// an allocator that always fails — every acquire/resize yields null, which try_acquire maps to .Err(.NotFound).
LimitAlloc: {
    _: i32,
}
LimitAlloc.impl(Allocator, {
    acquire = (a: MutPtr<LimitAlloc>, n: i64) RawPtr<u8> { null_ptr() }
    resize = (a: MutPtr<LimitAlloc>, p: RawPtr<u8>, n: i64) RawPtr<u8> { null_ptr() }
    release = (a: MutPtr<LimitAlloc>, p: RawPtr<u8>) void { }
})
main = () i32 {
    alloc := halloc.gpa()
    a := alloc.addr()
    // happy path: of seeds, add grows past cap 1, dup is a no-op, membership answers correctly.
    s := sets.of(a, 10).expect("of")
    s = s.add(a, 20).expect("add")
    s = s.add(a, 30).expect("add")
    s = s.add(a, 10).expect("add")
    good := s.len() == 3 && s.has(20) && s.has(10) && s.has(30)
    s.free(a)
    // OOM path: a failing allocator makes each allocating op return .Err rather than crash.
    lim := LimitAlloc(_: 0)
    l := lim.addr()
    of_err := sets.of(l, 7).match ({
        .Err(e) => true,
        .Ok(z)  => false,
    })
    er: Result<sets.Set<i64>, IoError> := sets.empty(l)
    empty_err := er.match ({
        .Err(e) => true,
        .Ok(z)  => false,
    })
    // a set that lives on the good allocator but grows through the failing one → grow returns .Err.
    g := sets.of(a, 1).expect("of")
    add_err := g.add(l, 2).match ({
        .Err(e) => true,
        .Ok(z)  => false,
    })
    g.free(a)
    ok := good && of_err && empty_err && add_err
    ok.to_exit()
}
