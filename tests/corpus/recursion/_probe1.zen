// probe: plain self recursion, depth 10, sum 1..n
sum_to = (n: i64) i64 {
    (n <= 0).match({
        true  => 0,
        false => n + sum_to(n - 1),
    });
}

fib = (n: i32) i32 {
    (n < 2).match({
        true  => n,
        false => fib(n - 1) + fib(n - 2),
    });
}

main = (env: Env) Res<i32, AllocError> {
    println("{}", sum_to(10));
    println("{}", fib(10));
    Ok(0);
}
