// A view may not outlive the arena it points into. `alloc` is an
// ordinary scope-local value, so `Arena.drop` frees its pages when
// `word` returns and the `str` the caller holds points at reclaimed
// memory. Two calls printed `a=  b=XY` with exit 0 (#788): the second
// arena reuses the first's freed block and overwrites the bytes `a`
// still names.

word = (env: Env, letters: str) Res<str, AllocError> {
    alloc ::= env.mem.alloc();
    buf   ::= alloc.String().try();
    buf.add_bytes(letters).try();
    Ok(buf.view());
}

main = (env: Env) Res<i32, AllocError> {
    a = word(env, "ab").try();
    b = word(env, "XY").try();
    println("a={} b={}", a, b);
    Ok(0);
}
