// src/gen/gen_c/gen_c_try.zen
// What `.try()` is in C.
//
// `gen_c_flow.zen` is the other half of control flow — `.match`, the
// one conditional. The two are separated because they are two subjects
// that share only a destination: a match decides WHICH value, and this
// decides whether there is one at all.
//
// `.try()` IS A RETURN, and that is DESIGN.md's own framing: "it
// unwraps Ok, or returns the Err — or the None — from the ENCLOSING
// function", which is "a jump out through a frame boundary, exactly
// what `h.break(v)` does". So it lowers to a guard and a `return`, and
// the thing returned is built from the enclosing function's OWN Res
// type — never converted, because "there is no From".
//
// WIDENING A SET ON THE WAY OUT IS A CONSTRUCTION, NOT A COPY. `.try()`
// is legal when the callee's set is CONTAINED in the caller's, and this
// used to demand the two be the same type — which made every merge
// DESIGN.md promises a report. The caller's error value is built:
// tagged with the member the callee's error IS, carrying it unchanged.
// The value moves one box out.
//
// A DECLARED SET AND A STRUCTURAL ONE ARE TWO CONSTRUCTIONS. A declared
// enum widens through a VARIANT, which has a path and a name. `A | B`
// written inline, or a set sema inferred, has neither — its members are
// types, and the member type is its own name. `Carry` below is the
// three answers, and they are three because a variant name and a member
// type are not the same thing.
//
// A SET AND ANOTHER SPELLING OF THE SAME SET ARE NOT TWO SETS, and
// `Carry.Copy` is the whole of what that costs. DESIGN.md settled the
// numbering — "a union's tags are numbered by a canonical order over
// its members, never by declaration order" — so `Error = AllocError |
// IoError` and `WriteError = IoError | AllocError` agree tag for tag,
// and the propagation between them is bytes. This used to report, and
// reporting was right while the numbering was open: a memcpy across two
// numberings is a miscompilation rather than a missing feature.
//
// A STRICT WIDENING IS A RE-TAGGING, and it is the case canonical
// numbering does not reach — nor was it ever claimed to, since that rule
// is about two spellings of ONE set. A callee's `IoError | AllocError`
// into a caller's set of three is two genuinely different types whose
// canonical ranks genuinely differ, so `Carry.Retag` maps the tag member
// by member and copies the payload, which needs no mapping: a member's
// field is named after the member's own type on both sides.
//
// WHAT IS STILL NOT LOWERED: a widening whose destination cannot NAME
// one of the members. `Error = WriteError | FsError` is a set of four
// where the enum has two variants, so no variant names `IoError` and
// there is no tag constant to map to. `gen_c_layout.variant_ranks`
// refuses to rank that same shape and falls back to declaration order;
// refusing it in both places is what keeps the tags written here equal
// to the tags emitted there. It reports.

Ast, Expr, ExprId, Decl, DeclKind, Enum, Variant, Span = std.ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId, Ty, Types, TyNamed, TyRes, ResForm = sema.sema_ty
World, Def, decl_at = sema.sema_def
Checker, Ctx = sema.sema_check
Inst = sema.sema_inst
Emit = gen.gen_emit
sym_member, sym_variant, sym_gen = gen.gen_name
RES_PATH, is_failure = gen.gen_name
sym_union_variant, sym_union_member = gen.gen_name
GenFault = gen.gen_diag
CBackend = gen.gen_c.gen_c_state
enter_struct_tparams, leave_tparams = gen.gen_c.gen_c_mono
ctype, is_unit, variant_type, decl_ctx, decl_inst = gen.gen_c.gen_c_type
write_qname = gen.gen_c.gen_c_layout
Dest, write_dest, deliver = gen.gen_c.gen_c_stmt
res_type_of = gen.gen_c.gen_c_expr
write_set_value = gen.gen_c.gen_c_widen
declare_temp = gen.gen_c.gen_c_flow
unwind_to = gen.gen_c.gen_c_own

lower_try* = (
    be      :: CBackend,
    node    : Expr,
    operand : ExprId,
    ctx     : Ctx,
    dst     : Dest
) Res<(), AllocError> {
    rt = res_type_of(be, operand, ctx).try();
    be.check.types.at(rt).match({
        Res(r) => lower_try_res(be, node, operand, r, rt, ctx, dst),
        _      => be.report_expr(
            operand,
            GenFault.Untyped("the operand of .try()")
        ),
    })
}

lower_try_res = (
    be      :: CBackend,
    node    : Expr,
    operand : ExprId,
    r       : TyRes,
    rt      : TyId,
    ctx     : Ctx,
    dst     : Dest
) Res<(), AllocError> {
    tmp ::= be.alloc.String().try();
    sym_gen(tmp, "t", be.next_tmp()).try();
    declare_temp(be, rt, tmp.view()).try();
    deliver(be, operand, ctx, rt, Dest.Into(tmp.view())).try();
    write_guard(be, node, r, tmp.view(), ctx).try();
    unwrap(be, r, tmp.view(), dst).try();
    Ok(());
}

write_guard = (be :: CBackend, node: Expr, r: TyRes, tmp: str, ctx: Ctx)
              Res<(), AllocError> {
    be.write("if (").try();
    be.write(tmp).try();
    be.write(".zg_tag != ").try();
    tag ::= be.alloc.String().try();
    sym_variant(tag, RES_PATH, "Ok").try();
    be.write(tag.view()).try();
    be.writeln(") {").try();
    be.indent();
    // EVERY EARLY EXIT IS A SCOPE EXIT, and `.try()` is the common one:
    // it is "a jump out through a frame boundary", so every block from
    // here out to the function's own runs its defers and its drops
    // first. Depth 0 is the whole frame. The error is carried in `tmp`,
    // which is a temporary and is never tracked, so there is nothing
    // here the returned value could be aliasing.
    unwind_to(be, 0, "").try();
    propagate(be, node, r, tmp, ctx).try();
    be.dedent();
    be.writeln("}").try();
    Ok(());
}

// The value the enclosing function returns. It is built from the
// CALLER's own Res type and nothing is converted: "propagation merges
// sets" is a containment rule, not a conversion, and there is no From.
propagate = (be :: CBackend, node: Expr, r: TyRes, tmp: str, ctx: Ctx)
            Res<(), AllocError> {
    be.check.types.at(ctx.ret).match({
        Res(want) => propagate_into(be, node, r, want, tmp, ctx),
        _         => be.report(
            node.span.file,
            node.span,
            GenFault.Unsupported(".try() outside a Res function")
        ),
    })
}

// The two forms must agree — an absence cannot become a failure and
// sema has already said so — and then the error is either the caller's
// own or one member of it.
propagate_into = (
    be   :: CBackend,
    node : Expr,
    r    : TyRes,
    want : TyRes,
    tmp  : str,
    ctx  : Ctx
) Res<(), AllocError> {
    forms_agree(r.form, want.form).match({
        false => report_widening(be, node),
        true  => propagate_failure(be, node, r, want, tmp, ctx),
    })
}

// The error types only matter when there is an error to carry. An
// absence propagates as a tag and nothing else, and a bare `Ok(..)`
// raises nothing — "its error set is an open `_` with nothing in it" —
// so comparing that set to the caller's asks about a value neither one
// will ever hold.
propagate_failure = (
    be   :: CBackend,
    node : Expr,
    r    : TyRes,
    want : TyRes,
    tmp  : str,
    ctx  : Ctx
) Res<(), AllocError> {
    is_failure(r.form).match({
        false => write_propagation(be, r, want, tmp, ctx, Carry.Same),
        true  => propagate_error(be, node, r, want, tmp, ctx),
    })
}

// The same set carries straight across: one C type, one payload member,
// nothing to build. A different one is a widening, and `into` says which
// of the caller's members it widens through.
propagate_error = (
    be   :: CBackend,
    node : Expr,
    r    : TyRes,
    want : TyRes,
    tmp  : str,
    ctx  : Ctx
) Res<(), AllocError> {
    r.error.eq(want.error).match({
        true  => write_propagation(be, r, want, tmp, ctx, Carry.Same),
        false => propagate_wider(be, node, r, want, tmp, ctx),
    })
}

// ONE SET IN TWO SPELLINGS IS NOT A WIDENING AT ALL (header). DESIGN.md:
// "A union is its members. Order and spelling are not part of its
// identity", and `set_of` is the question that says so — an inferred set
// with no declaration behind it included. Two ids reach here for one
// type, so the IDS are the wrong thing to compare.
//
// Which leaves only C's own nominal typing: one layout under two struct
// tags. `Carry.Copy` is that, and it is a COPY rather than a re-tagging
// switch because the tags agree — `gen_c_layout.write_enum_tags` numbers
// a union's members canonically.
propagate_wider = (
    be   :: CBackend,
    node : Expr,
    r    : TyRes,
    want : TyRes,
    tmp  : str,
    ctx  : Ctx
) Res<(), AllocError> {
    same_set(be, r.error, want.error).match({
        true  => write_propagation(be, r, want, tmp, ctx, Carry.Copy),
        false => widen_or_report(be, node, r, want, tmp, ctx),
    })
}

same_set = (be :: CBackend, got: TyId, want: TyId) bool {
    be.check.set_of(got).eq(be.check.set_of(want))
}

// The two constructions the header names, forked here rather than
// inside `carrier` because the two answers are not the same kind of
// thing: a variant name, or a member type.
widen_or_report = (
    be   :: CBackend,
    node : Expr,
    r    : TyRes,
    want : TyRes,
    tmp  : str,
    ctx  : Ctx
) Res<(), AllocError> {
    be.check.types.at(want.error).match({
        Union(_) => widen_into_set(be, node, r, want, tmp, ctx),
        _        => widen_into_enum(be, node, r, want, tmp, ctx),
    })
}

widen_into_enum = (
    be   :: CBackend,
    node : Expr,
    r    : TyRes,
    want : TyRes,
    tmp  : str,
    ctx  : Ctx
) Res<(), AllocError> {
    carrier(be, want.error, r.error).match({
        None  => retag_or_report(be, node, r, want, tmp, ctx),
        Ok(v) => write_propagation(be, r, want, tmp, ctx, Carry.Variant(v)),
    })
}

// MEMBERSHIP IS THE WHOLE QUESTION for a structural set, and `set_has`
// is sema's own containment test — the one that admitted this `.try()`
// in the first place, so asking it again here cannot disagree with the
// check that let the program through.
//
// A set that does NOT contain the callee's error still reports. That is
// not a widening this backend has not got to yet; it is a widening that
// does not exist, and the only way to reach it is for sema to have let
// something past.
widen_into_set = (
    be   :: CBackend,
    node : Expr,
    r    : TyRes,
    want : TyRes,
    tmp  : str,
    ctx  : Ctx
) Res<(), AllocError> {
    be.check.types.set_has(want.error, r.error).match({
        false => retag_or_report(be, node, r, want, tmp, ctx),
        true  => write_propagation(
            be,
            r,
            want,
            tmp,
            ctx,
            Carry.Member(r.error)
        ),
    })
}

// A STRICT WIDENING IS THE ONE CASE CANONICAL NUMBERING DOES NOT
// COLLAPSE (header): `Res<T, A|B>` into `Res<T, A|B|C>` is two genuinely
// different sets — a member the destination adds anywhere but last
// shifts every rank after it — so the tag has to be mapped member by
// member, the "per-member switch" DESIGN.md names as the price of
// getting the numbering wrong.
//
// Only the TAG is mapped. A member's payload field is named after the
// member's own TYPE and carries a value of it, in a declared enum and a
// structural set alike, so the payload crosses untouched — the bytes are
// already the member they say they are, and only the number in front of
// them means something different on each side.
//
// The map is decided before a byte is written, and a member either side
// cannot name aborts back to a report. All-or-nothing for
// `gen_c_layout.variant_ranks`' reason: a half-built map leaves some tag
// unmapped, and an unmapped tag is a wrong ERROR VARIANT at runtime with
// no diagnostic and no C that fails to compile.
retag_or_report = (
    be   :: CBackend,
    node : Expr,
    r    : TyRes,
    want : TyRes,
    tmp  : str,
    ctx  : Ctx
) Res<(), AllocError> {
    retaggable(be, r.error, want.error).match({
        false => report_widening(be, node),
        true  => write_propagation(be, r, want, tmp, ctx, Carry.Retag),
    })
}

retaggable = (be :: CBackend, from_set: TyId, to_set: TyId) bool {
    within(be, from_set, to_set) && all_tagged(be, from_set, to_set)
}

// CONTAINMENT IS ASKED OF THE SETS, NOT OF THE SPELLINGS. `set_within`
// walks the destination's member list, so a destination written as a
// declared NAME has to be resolved to the union it stands for first —
// the same `set_of` question `same_set` above asks.
within = (be :: CBackend, from_set: TyId, to_set: TyId) bool {
    narrow = be.check.set_of(from_set);
    wide   = be.check.set_of(to_set);
    be.check.types.set_within(narrow, wide)
}

all_tagged = (be :: CBackend, from_set: TyId, to_set: TyId) bool {
    members ::= be.alloc.Vec<TyId>();
    canon = be.check.set_of(from_set);
    be.check.types.members_of(canon, members).match({
        Err(_) => false,
        Ok(_)  => no_member_untagged(be, from_set, to_set, members),
    })
}

no_member_untagged = (
    be       :: CBackend,
    from_set : TyId,
    to_set   : TyId,
    members  : Vec<TyId>
) bool {
    untagged(be, from_set, to_set, members).match({
        Ok(_) => false,
        None  => true,
    })
}

untagged = (
    be       :: CBackend,
    from_set : TyId,
    to_set   : TyId,
    members  : Vec<TyId>
) Res<usize> {
    Range(0, members.len).find((i) {
        members.get(i).match({
            None  => true,
            Ok(m) => both_tagged(be, from_set, to_set, m) == false,
        })
    })
}

both_tagged = (be :: CBackend, from_set: TyId, to_set: TyId, m: TyId) bool {
    tagged(be, from_set, m) && tagged(be, to_set, m)
}

// A structural set composes a tag constant out of the two type codes and
// always has one. A declared enum names it through the VARIANT that
// carries the member's type, so it has one only when such a variant
// exists — which `Error = WriteError | FsError` does NOT, because
// `union_ty` flattened `WriteError` into four members and no variant
// names any one of them. Same shape `gen_c_layout.variant_ranks` refuses
// to rank, refused in both places or the tags this writes are not the
// tags that file emitted.
tagged = (be :: CBackend, set: TyId, m: TyId) bool {
    be.check.types.at(set).match({
        Union(_) => true,
        _        => named_tagged(be, set, m),
    })
}

named_tagged = (be :: CBackend, set: TyId, m: TyId) bool {
    carrier(be, set, m).match({
        None  => false,
        Ok(_) => true,
    })
}

// Which variant of the caller's set carries `err`.
//
// Compared by TYPE and not by name: two modules may each declare an
// `AllocError` and they are two types, so a name match would tag the
// wrong variant and the payload would be read as the wrong struct.
carrier = (be :: CBackend, set: TyId, err: TyId) Res<str> {
    be.check.types.at(set).match({
        Named(n) => named_carrier(be, n, err),
        _        => None,
    })
}

named_carrier = (be :: CBackend, n: TyNamed, err: TyId) Res<str> {
    decl_at(be.tree, n.decl).match({
        None  => None,
        Ok(d) => decl_carrier(be, n, d, err),
    })
}

decl_carrier = (be :: CBackend, n: TyNamed, d: Decl, err: TyId) Res<str> {
    d.kind.match({
        Enum(e) => variant_carrying(be, n, e.variants, err),
        _       => None,
    })
}

// The walk allocates and the answer is an absence, so the two are kept
// apart the way `variant_payload` above keeps them apart: a lookup that
// ran out of memory has not found a carrier.
variant_carrying = (
    be       :: CBackend,
    n        : TyNamed,
    variants : Vec<Variant>,
    err      : TyId
) Res<str> {
    found ::= be.alloc.Vec<str>();
    collect_carrier(be, n, variants, err, found).match({
        Err(_) => None,
        Ok(_)  => found.get(0),
    })
}

collect_carrier = (
    be       :: CBackend,
    n        : TyNamed,
    variants : Vec<Variant>,
    err      : TyId,
    found    :: Vec<str>
) Res<(), AllocError> {
    ctx  = decl_ctx(be, n);
    inst = decl_inst(be, n).try();
    mark = enter_struct_tparams(be, n.decl).try();
    variants.loop((h, v) {
        keep_carrier(be, n, v, err, ctx, inst, found).try();
    });
    leave_tparams(be, mark).try();
    Ok(());
}

keep_carrier = (
    be    :: CBackend,
    n     : TyNamed,
    v     : Variant,
    err   : TyId,
    ctx   : Ctx,
    inst  : Inst,
    found :: Vec<str>
)
               Res<(), AllocError> {
    carries(be, n, v, err, ctx, inst).match({
        false => Ok(()),
        true  => found.add(v.name.text),
    })
}

carries = (
    be   :: CBackend,
    n    : TyNamed,
    v    : Variant,
    err  : TyId,
    ctx  : Ctx,
    inst : Inst
) bool {
    variant_type(be, n, v, ctx, inst).match({
        None  => false,
        Ok(t) => t.eq(err),
    })
}

forms_agree = (got: ResForm, want: ResForm) bool {
    is_failure(got).match({
        true  => is_failure(want),
        false => is_failure(want) == false,
    })
}

report_widening = (be :: CBackend, node: Expr) Res<(), AllocError> {
    be.report(
        node.span.file,
        node.span,
        GenFault.Unsupported("widening an error set through .try()")
    ).try();
    Ok(());
}

// How the callee's error becomes the caller's.
//
// `Same` is one C type and a copy. `Variant` widens into a DECLARED
// enum, through the variant that names the callee's error type.
// `Member` widens into a STRUCTURAL set, whose member type is its own
// name, so the type is what is carried. `Copy` is one set spelled two
// ways: nothing built and nothing tagged, the bytes already say which
// member they are. `Retag` is the caller's set being STRICTLY LARGER,
// where the payload is copied like `Copy` but the tag cannot be — the
// two sets number the same member differently and only a runtime map
// says which is which — and it carries nothing because the two sets are
// already in hand.
//
// Five cases and not a `Res<str>` with a convention: a variant name and
// a member type are two different things, and the C written for each is
// different too.
Carry = Same | Variant(str) | Member(TyId) | Copy | Retag

// `into` says how the caller's error payload is built out of the
// callee's — except for `Copy` and `Retag`, where it is not built.
write_propagation = (
    be   :: CBackend,
    r    : TyRes,
    want : TyRes,
    tmp  : str,
    ctx  : Ctx,
    into : Carry
) Res<(), AllocError> {
    into.match({
        Copy  => write_copy(be, r, tmp, ctx),
        Retag => write_retag(be, r, want, tmp, ctx),
        _     => write_built(be, r, want, tmp, ctx, into),
    })
}

write_built = (
    be   :: CBackend,
    r    : TyRes,
    want : TyRes,
    tmp  : str,
    ctx  : Ctx,
    into : Carry
) Res<(), AllocError> {
    line ::= be.alloc.String().try();
    line.add_bytes("return (").try();
    ctype(be, ctx.ret, line).try();
    line.add_bytes("){ .zg_tag = ").try();
    failure_tag(be, r, line).try();
    is_failure(r.form).then(() {
        carry_error(be, want, tmp, into, line).try()
    });
    line.add_bytes(" };").try();
    be.writeln(line.view())
}

// The same set, carried across the two struct tags C insists on.
//
// THE TWO LAYOUTS ARE IDENTICAL BY CONSTRUCTION, which is what makes
// this three lines rather than a per-member switch: same members, so
// the same payload union; canonical tags, so the same numbering; and
// `sym_union_member` gives a member its own name on both sides.
// DESIGN.md: "Canonical numbering makes the widening a copy."
//
// `memcpy` and not an assignment because C's struct types are nominal:
// there is no operator that spells "these two layouts are one". The
// size is the DESTINATION's, which is safe because the sets are equal —
// `same_set` is what admitted this — so both fields are one size.
write_copy = (be :: CBackend, r: TyRes, tmp: str, ctx: Ctx)
             Res<(), AllocError> {
    w ::= be.alloc.String().try();
    sym_gen(w, "w", be.next_tmp()).try();
    write_carrier_decl(be, r, w.view(), ctx).try();
    write_carrier_copy(be, w.view(), tmp).try();
    write_return(be, w.view())
}

// The caller's Res, its payload carried across and its TAG mapped.
//
// Statements and not an initializer, for `write_copy`'s reason and one
// more: C has no expression that spells "this union's bytes are that
// union's", and here the tag is not a constant either — it is a
// function of the tag the value arrived carrying.
write_retag = (be :: CBackend, r: TyRes, want: TyRes, tmp: str, ctx: Ctx)
              Res<(), AllocError> {
    w ::= be.alloc.String().try();
    sym_gen(w, "w", be.next_tmp()).try();
    write_carrier_decl(be, r, w.view(), ctx).try();
    write_payload_copy(be, w.view(), tmp).try();
    write_tag_map(be, r.error, want.error, w.view(), tmp).try();
    write_return(be, w.view())
}

write_return = (be :: CBackend, w: str) Res<(), AllocError> {
    ret ::= be.alloc.String().try();
    ret.add_bytes("return ").try();
    ret.add_bytes(w).try();
    ret.add_bytes(";").try();
    be.writeln(ret.view())
}

// THE PAYLOAD ONLY, AND AT THE SOURCE'S SIZE. `write_carrier_copy` above
// takes the whole error value at the DESTINATION's size, which it may do
// because the two sets are equal. Here they are not: the destination's
// tag is the one thing that must NOT be copied, and its payload union
// may be the wider of the two, so its size is the wrong size to read
// through the source.
//
// A union's members all begin at offset zero, so the source's payload
// bytes land exactly where the destination reads the same member — and
// there are never too many of them, because every source member is a
// destination member and a union is at least as large as its largest.
write_payload_copy = (be :: CBackend, w: str, tmp: str) Res<(), AllocError> {
    line ::= be.alloc.String().try();
    line.add_bytes("memcpy(&").try();
    read_payload(w, line).try();
    line.add_bytes(", &").try();
    read_payload(tmp, line).try();
    line.add_bytes(", sizeof(").try();
    read_payload(tmp, line).try();
    line.add_bytes("));").try();
    be.writeln(line.view())
}

// A set of two or more members always HAS a payload union: there is one
// unit type, so at most one member can be the empty one and the rest
// carry something. A strict widening is only ever reached with a source
// of two or more — one member is not a union, and a union of one
// collapses to its member before it is ever built.
read_payload = (v: str, out :: String) Res<(), AllocError> {
    read_error(v, out).try();
    out.add_bytes(".zg_data").try();
    Ok(());
}

read_tag = (v: str, out :: String) Res<(), AllocError> {
    read_error(v, out).try();
    out.add_bytes(".zg_tag").try();
    Ok(());
}

// One case per member of the SOURCE set, which is the only tag values
// this value can arrive with. `retaggable` has already established that
// both sides can name every one of them.
write_tag_map = (
    be       :: CBackend,
    from_set : TyId,
    to_set   : TyId,
    w        : str,
    tmp      : str
) Res<(), AllocError> {
    members ::= be.alloc.Vec<TyId>();
    canon = be.check.set_of(from_set);
    be.check.types.members_of(canon, members).try();
    open_switch(be, tmp).try();
    members.loop((h, m) {
        write_tag_case(be, from_set, to_set, m, w).try();
    });
    be.dedent();
    be.writeln("}").try();
    Ok(());
}

open_switch = (be :: CBackend, tmp: str) Res<(), AllocError> {
    line ::= be.alloc.String().try();
    line.add_bytes("switch (").try();
    read_tag(tmp, line).try();
    line.add_bytes(") {").try();
    be.writeln(line.view()).try();
    be.indent();
    Ok(());
}

write_tag_case = (
    be       :: CBackend,
    from_set : TyId,
    to_set   : TyId,
    m        : TyId,
    w        : str
) Res<(), AllocError> {
    line ::= be.alloc.String().try();
    line.add_bytes("case ").try();
    write_member_tag(be, from_set, m, line).try();
    line.add_bytes(": ").try();
    read_tag(w, line).try();
    line.add_bytes(" = ").try();
    write_member_tag(be, to_set, m, line).try();
    line.add_bytes("; break;").try();
    be.writeln(line.view())
}

// The tag constant a set gives one of its members, whichever way the set
// is spelled — the two namings `tagged` asks about, written out. The
// miss `tagged` screens for writes nothing and cannot be reached: this
// runs only after `retaggable` said every member has a name on both
// sides.
write_member_tag = (be :: CBackend, set: TyId, m: TyId, out :: String)
                   Res<(), AllocError> {
    be.check.types.at(set).match({
        Union(_) => sym_union_variant(out, be.types(), be.world(), set, m),
        _        => write_variant_tag(be, set, m, out),
    })
}

write_variant_tag = (be :: CBackend, set: TyId, m: TyId, out :: String)
                    Res<(), AllocError> {
    carrier(be, set, m).match({
        None  => Ok(()),
        Ok(v) => write_named_tag(be, set, v, out),
    })
}

write_named_tag = (be :: CBackend, set: TyId, v: str, out :: String)
                  Res<(), AllocError> {
    qname ::= be.alloc.String().try();
    set_qname(be, set, qname).try();
    out.sym_variant(qname.view(), v)
}

write_carrier_decl = (be :: CBackend, r: TyRes, w: str, ctx: Ctx)
                     Res<(), AllocError> {
    line ::= be.alloc.String().try();
    ctype(be, ctx.ret, line).try();
    line.add_bytes(" ").try();
    line.add_bytes(w).try();
    line.add_bytes(" = { .zg_tag = ").try();
    failure_tag(be, r, line).try();
    line.add_bytes(" };").try();
    be.writeln(line.view())
}

write_carrier_copy = (be :: CBackend, w: str, tmp: str)
                     Res<(), AllocError> {
    line ::= be.alloc.String().try();
    line.add_bytes("memcpy(&").try();
    read_error(w, line).try();
    line.add_bytes(", &").try();
    read_error(tmp, line).try();
    line.add_bytes(", sizeof(").try();
    read_error(w, line).try();
    line.add_bytes("));").try();
    be.writeln(line.view())
}

failure_tag = (be :: CBackend, r: TyRes, out :: String) Res<(), AllocError> {
    is_failure(r.form).match({
        true  => out.sym_variant(RES_PATH, "Err"),
        false => out.sym_variant(RES_PATH, "None"),
    })
}

carry_error = (
    be   :: CBackend,
    want : TyRes,
    tmp  : str,
    into : Carry,
    out  :: String
) Res<(), AllocError> {
    out.add_bytes(", .zg_data.").try();
    out.sym_member("Err").try();
    out.add_bytes(" = ").try();
    into.match({
        Variant(v) => wrap_error(be, want.error, v, tmp, out),
        Member(m)  => wrap_set_error(be, want.error, m, tmp, out),
        // `Same` carries the value across untouched. `Copy` and `Retag`
        // would too, and never arrive: `write_propagation` sends them to
        // `write_copy` and `write_retag` before anything is built,
        // because a copy across two struct tags is statements and not an
        // initializer.
        _          => read_error(tmp, out),
    }).try();
    Ok(());
}

read_error = (tmp: str, out :: String) Res<(), AllocError> {
    out.add_bytes(tmp).try();
    out.add_bytes(".zg_data.").try();
    out.sym_member("Err").try();
    Ok(());
}

// The caller's set, built around the callee's error: tagged with the
// variant that names the callee's error TYPE, carrying the value
// unchanged. The two `Res`es are two C structs with two different
// payload members, so there was never a copy that could have worked.
wrap_error = (
    be      :: CBackend,
    set     : TyId,
    variant : str,
    tmp     : str,
    out     :: String
) Res<(), AllocError> {
    qname ::= be.alloc.String().try();
    set_qname(be, set, qname).try();
    out.add_bytes("(").try();
    ctype(be, set, out).try();
    out.add_bytes("){ .zg_tag = ").try();
    out.sym_variant(qname.view(), variant).try();
    out.add_bytes(", .zg_data.").try();
    out.sym_member(variant).try();
    out.add_bytes(" = ").try();
    read_error(tmp, out).try();
    out.add_bytes(" }").try();
    Ok(());
}

// A STRUCTURAL SET IS BUILT THE SAME WAY WHEREVER IT IS BUILT, so the
// value itself is `gen_c_widen.write_set_value` and only the piece of C
// it wraps is decided here: the callee's error read out of the
// temporary. `wrap_error` above is the declared-enum twin, and it is
// separate because a declaration has a path and a variant name where a
// set has neither.
wrap_set_error = (
    be     :: CBackend,
    set    : TyId,
    member : TyId,
    tmp    : str,
    out    :: String
) Res<(), AllocError> {
    code ::= be.alloc.String().try();
    read_error(tmp, code).try();
    write_set_value(be, code.view(), member, set, out)
}

set_qname = (be :: CBackend, set: TyId, out :: String) Res<(), AllocError> {
    be.check.types.at(set).match({
        Named(n) => write_qname(be, out, n),
        _        => Ok(()),
    })
}

// `.try()` evaluates to the Ok payload. A unit payload has no member
// to read, so the destination gets nothing — which is right: `()` is
// not a value C can hold.
unwrap = (be :: CBackend, r: TyRes, tmp: str, dst: Dest)
         Res<(), AllocError> {
    is_unit(be, r.value).match({
        true  => Ok(()),
        false => write_unwrap(be, tmp, dst),
    })
}

write_unwrap = (be :: CBackend, tmp: str, dst: Dest) Res<(), AllocError> {
    place ::= be.alloc.String().try();
    place.add_bytes(tmp).try();
    place.add_bytes(".zg_data.").try();
    sym_member(place, "Ok").try();
    write_dest(be, dst, place.view())
}
