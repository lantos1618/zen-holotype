// src/sema/sema_join.zen
// Computes the value type of a match by folding once over its arms.
// `sema_match.zen` decides which values reach an arm; this module decides
// what comes back out.
//
// `Res` is the whole difficulty, and a deliberate one. `Ok(x)` is
// OPEN — which `Res` it closes isn't decided until an expectation
// says — so an arm carrying one is only half an answer. Joining is not
// subtyping or unification: it reads the FORM off the arm that has one
// and the PAYLOAD off the arm that has one, since a match written
// `Ok(v)` / `None` has neither arm knowing both.
//
// Otherwise the first arm supplies the type: Zen has no numeric tower or
// general common supertype. Arm agreement is checked by `sema_hoist`.

AllocError = std.mem
TyId, TyRes, is_failure = sema.sema_ty
Checker = sema.sema_check

join* = (c :: Checker, a: TyId, b: TyId) Res<TyId, AllocError> {
    c.is_unknown(a).match({
        true  => Ok(b),
        false => c.keep_or_settle(a, b),
    })
}

keep_or_settle = (c :: Checker, a: TyId, b: TyId) Res<TyId, AllocError> {
    (c.open_res(a) && (c.is_unknown(b) == false)).match({
        true  => c.settled_res(a, b),
        false => c.settle_reversed(a, b),
    })
}

// Repeat the join with reversed arms because arm ordering is not a type fact.
settle_reversed = (c :: Checker, a: TyId, b: TyId) Res<TyId, AllocError> {
    (c.open_res(b) && (c.is_unknown(a) == false)).match({
        true  => c.settled_res(b, a),
        false => c.settled_literal(a, b),
    })
}

// A literal is not a settled match type, so a concrete compatible arm
// supplies its context (the same collapse used by `check_literal`).
settled_literal = (c :: Checker, a: TyId, b: TyId) Res<TyId, AllocError> {
    (c.is_literal_ty(a) && c.concrete(b) && c.assignable(a, b)).match({
        true  => Ok(b),
        false => c.literal_reversed(a, b),
    })
}

// The same question with the arms the other way round, for
// `settle_reversed`'s reason: which arm carried the literal is the
// author's ordering, not a fact about the type.
literal_reversed = (c :: Checker, a: TyId, b: TyId) Res<TyId, AllocError> {
    (c.is_literal_ty(b) && c.concrete(a) && c.assignable(b, a)).match({
        true  => Ok(a),
        false => c.merged_or_first(a, b),
    })
}

// NEVER SETTLE A LITERAL INTO A SLOT NOBODY HAS COMPUTED — `sema_hoist`
// states the standing rule as "never count an unsettled slot".
// `assignable` says an `int` reaches an unsubstituted `T`, so without
// this the arm `false => <T>` in a generic body took the whole join to
// `T` and handed codegen a `>` between two things it has no scalar for
// (`std/mem/mem_arena.zen:126`).
concrete = (c: Checker, id: TyId) bool {
    (unsettled(c, id) || c.is_var(id)) == false
}

// Settling an open `Res` takes the other arm's FORM and keeps its own
// PAYLOAD. E.g. `op = p.peek().kind.match({ Bang => Ok(UnOp.Not), ..,
// _ => None })` is `Res<UnOp>`: `None` says the FORM (absence, no
// reason), `Ok` says the PAYLOAD. Taking `None`'s type whole threw the
// payload away and answered `Res<Infer>` — a backend struct with an
// `int` where `UnOp` goes.
settled_res = (c :: Checker, a: TyId, b: TyId) Res<TyId, AllocError> {
    c.types.at(b).match({
        Res(rb) => c.settled_form(a, b, rb),
        _       => Ok(b),
    })
}

settled_form = (c :: Checker, a: TyId, b: TyId, rb: TyRes)
               Res<TyId, AllocError> {
    unsettled(c, rb.value).match({
        false => Ok(b),
        true  => c.carried_value(a, b, rb),
    })
}

carried_value = (c :: Checker, a: TyId, b: TyId, rb: TyRes)
                Res<TyId, AllocError> {
    c.open_value(a).match({
        None  => Ok(b),
        Ok(v) => c.at_form(v, rb),
    })
}

at_form = (c :: Checker, value: TyId, rb: TyRes) Res<TyId, AllocError> {
    rb.form.match({
        Absence => c.types.res_absence(value),
        Failure => c.types.res_failure(value, rb.error),
        Open    => c.types.res_open(value),
    })
}

// Two settled failures are one value with two ways to go wrong: the
// match is worth `Res<T, Ea | Eb>`. DESIGN.md (Errors): "the error
// type of a Res is a union, and propagation merges sets" — stated for
// a call, but an arm is the same join sideways. First-arm-wins typed
// `true => fails(n)` / `false => faults(n)` as `Res<(), AllocError>`
// and left the second arm nowhere to go; gcc rejected the assignment.
//
// This is the one exception to first-arm-wins, and not an invented
// supertype: the set already has a lattice (`union_ty` canonicalises,
// `set_within` reads it), so the join exists and only the arms had
// never been asked.
merged_or_first = (c :: Checker, a: TyId, b: TyId) Res<TyId, AllocError> {
    c.types.at(a).match({
        Res(ra) => c.merge_against(a, b, ra),
        _       => Ok(a),
    })
}

merge_against = (c :: Checker, a: TyId, b: TyId, ra: TyRes)
                Res<TyId, AllocError> {
    c.types.at(b).match({
        Res(rb) => c.merge_failures(a, ra, rb),
        _       => Ok(a),
    })
}

// Only two failures over one value type merge. An absence carries no
// reason (no set to contribute); an open `Res` is `settled_res`'s case
// above; two different value types are the "cannot express" case
// first-arm-wins is for. An error still a hole is not a set either —
// folding it in would freeze an undecided type into a union nobody
// wrote.
merge_failures = (c :: Checker, a: TyId, ra: TyRes, rb: TyRes)
                 Res<TyId, AllocError> {
    (is_failure(ra.form) && is_failure(rb.form) && ra.value.eq(rb.value)
     && (unsettled(c, ra.error) == false)
     && (unsettled(c, rb.error) == false)).match({
        false => Ok(a),
        true  => c.merged_failure(ra, rb),
    })
}

merged_failure = (c :: Checker, ra: TyRes, rb: TyRes) Res<TyId, AllocError> {
    set = c.types.merge(ra.error, rb.error).try();
    c.types.res_failure(ra.value, set)
}

// The payload an open `Res` carries, when it carries a settled one.
open_value = (c: Checker, id: TyId) Res<TyId> {
    c.types.at(id).match({
        Res(r) => c.keep_settled(r.value),
        _      => None,
    })
}

keep_settled = (c: Checker, value: TyId) Res<TyId> {
    unsettled(c, value).match({ true => None, false => Ok(value) })
}

unsettled = (c: Checker, id: TyId) bool {
    c.is_unknown(id) || c.is_infer(id)
}

open_res = (c: Checker, id: TyId) bool {
    c.types.at(id).match({
        Res(r) => r.form.match({ Open => true, _ => false }),
        _      => false,
    })
}
