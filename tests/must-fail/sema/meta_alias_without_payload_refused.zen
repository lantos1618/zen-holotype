// AN ALIAS WITH NOWHERE TO LAND IS REFUSED, NOT GUESSED (#768). The
// `Alias` arm of `meta_name` used to promise that "`.name` is equally
// real on a struct, an enum and an alias" — but an alias whose target
// has no declaration payload (`Count = i64`) has no NAME to read off
// anything: its decl is `Alias`, and the arm fired on it only because
// the resolution had collapsed `Count` to `i64` and back to Count's own
// nominal. With the written type resolved one step short of the
// collapse (`sema_type.written_type`), the arm fires on real aliases —
// `corpus/meta/alias_name_is_what_was_written` pins that — and a
// payload-less one is refused here, exactly like the primitive it
// names.
//
// The refusal is one diagnostic at the `@meta` token, and poison — not
// a cascade.

Count = i64

main = (env: Env) Res<i32, AllocError> {
    println("{}", @meta(x: Count).name);
    Ok(0);
}
