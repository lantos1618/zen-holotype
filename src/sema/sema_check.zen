// src/sema/sema_check.zen
// The query engine. Everything else in this folder is a question asked
// of it.
//
// DESIGN.md decision 3: "Sema is memoized queries, not monolithic
// passes. `type_of(node)`, `defs_of(name)`. This is the same machinery
// as comptime memoization — build it once." So this file is not a walk
// that computes everything; it is a table of answers, and a walk that
// fills it in on demand.
//
// THE SHAPE OF A QUERY, and every one of them has it:
//
//     q(self :: @Self, key, ctx) Res<Answer, AllocError> {
//         self.memo.get(key).match({
//             None    => self.compute_q(key, ctx),   // fills the memo
//             Ok(hit) => Ok(hit),
//         })
//     }
//
// The key is a node id, which is why `ast_id.zen` made ids `Eq + Hash`
// and why `sema_id.zen` had to invent two more for the families the AST
// holds by value. Ask `type_of` twice and the second answer costs a
// `Map` lookup — which is the property an LSP needs, and the reason
// hover is not a recompile.
//
// WHERE THE `Alloc` IS. Law 1 says anything that needs memory takes an
// `Alloc`, and a memo table needs memory. It is a FIELD, set at
// construction through `alloc.Checker(tree)` — exactly as `Vec` stores
// `alloc: Alloc`, as `Ast` does, and as DESIGN.md blesses when it says
// "that is why `Vec` can store `alloc: Alloc` by value". The law is
// satisfied where the allocator ENTERS, and every query still says it
// can allocate the only way a signature can: `Res<_, AllocError>`. A
// query taking a second `Alloc` parameter beside the one its memo table
// already grows through would be two allocators for one table.
//
// A DIAGNOSTIC IS A VALUE. The only `Err` in this file is `AllocError`.
// A program full of mistakes still analyses: it yields the types it
// could compute and the diagnostics it owes, which is what lets an LSP
// show four errors instead of the first one.
//
// POISON, NOT CASCADE. A query that reports returns `Ty.Unknown`, and
// `Unknown` is assignable to and from everything. One mistake, one
// diagnostic.

Ast, Expr, ExprId, Type, TypeId, Span, Ident, Literal, LiteralKind = ast
BinOp, UnOp, Block, BlockId, Stmt, StmtKind = ast
Param, Binary, Unary, Bind, ExprStmt = ast
Alloc, AllocError = std.mem
Vec, Map = std.collections
str, String = std.text
Range = std.core
DeclId = sema.sema_id
TyId, Ty, Types, ResForm, TyRes = sema.sema_ty
World, Def, DefKind = sema.sema_def
Diag, SemaFault, NameFault, TypeFault, PairFault = sema.sema_diag

// One name in scope, and what it is.
//
// `mutable` is recorded and not yet enforced: the receiver rule and
// use-after-consume are stage 3, and PLAN.md puts the ownership checker
// in `sema_own.zen` precisely so this file does not grow it early.
Binding* = {
    name*: str,
    ty*: TyId,
    mutable*: bool,
}

// What a query needs to know that its key does not carry.
//
// A node id names a node; it does not say which module the node is in,
// what `@Self` means there, or what the enclosing function returns. Those
// are threaded, and they are the reason a query takes a `ctx` beside its
// key.
//
// `ret` and `has_ret` are what `.try()` answers to: "the enclosing
// function must return a compatible Res", and a closure inherits its
// caller's, because "a non-escaping closure may return through its
// caller".
Ctx* = {
    module*: usize,
    ret*: TyId,
    has_ret*: bool,
    self_ty*: TyId,
    has_self*: bool,
}

Checker* = {
    tree: Ast,
    world :: World,
    types* :: Types,
    diags :: Vec<Diag>,

    // the memo tables. Both key on a node id, which is the whole reason
    // ids exist rather than node values.
    expr_memo :: Map<ExprId, TyId>,
    type_memo :: Map<TypeId, TyId>,

    // the scope stack: one flat Vec with marks, not a chain of frames.
    // A chain needs indirection and every frame is an allocation; a
    // stack needs a `usize` and `release` is what pops it.
    locals :: Vec<Binding>,

    alloc: Alloc,

    // -----------------------------------------------------------------
    // what came out
    // -----------------------------------------------------------------

    diag_count* = (self: @Self) usize { self.diags.len }

    diag_at* = (self: @Self, i: usize) Res<Diag> { self.diags.get(i) }

    type_store* = (self: @Self) Types { self.types }

    modules* = (self: @Self) World { self.world }

    // Every diagnostic, rendered, one per line. The store is this
    // checker's own, so a caller never has to pair the two up.
    render_diags* = (self: @Self, out :: String) Res<(), AllocError> {
        self.diags.loop((h, d) {
            d.render(self.types, out).try();
            out.add_bytes("\n").try();
        });
        Ok(());
    }

    report* = (self :: @Self, file: str, span: Span, fault: SemaFault)
              Res<(), AllocError> {
        self.diags.add(Diag(file: file, span: span, fault: fault))
    }

    // -----------------------------------------------------------------
    // scopes
    //
    // `mark` / `release` rather than push/pop of frames: entering a
    // block records where the stack was, leaving it drops everything
    // added since. Shadowing falls out for free, because `lookup` walks
    // from the top down.
    // -----------------------------------------------------------------

    mark* = (self: @Self) usize { self.locals.len }

    bind* = (self :: @Self, name: str, ty: TyId, mutable: bool)
            Res<(), AllocError> {
        self.locals.add(Binding(name: name, ty: ty, mutable: mutable))
    }

    // Drop every binding added since `mark`. `Vec` has no truncate, so
    // this takes the last element as many times as there are extras —
    // which is what truncate would have been.
    release* = (self :: @Self, mark: usize) Res<(), AllocError> {
        extra = self.locals.len - mark;
        Range(0, extra).loop((h, i) {
            self.locals.take(self.locals.len - 1);
        });
        Ok(());
    }

    // The innermost binding of `name`. Walks from the top so an inner
    // scope shadows an outer one, which is the only thing the ordering
    // of this Vec is for.
    lookup* = (self: @Self, name: str) Res<Binding> {
        n = self.locals.len;
        Range(0, n).find((k) {
            self.locals.get(n - k - 1).match({
                Ok(b) => b.name.eq(name),
                None  => false,
            })
        }).match({
            None    => None,
            Ok(k)   => self.locals.get(n - k - 1),
        })
    }

    // -----------------------------------------------------------------
    // QUERY: the type a written type node denotes
    //
    // `ast.Type` is what the author wrote; this is what it means. The
    // memo makes the two-way trip once per node, which matters because
    // a signature's parameter types are read at every call site.
    // -----------------------------------------------------------------

    type_from_ast* = (self :: @Self, id: TypeId, ctx: Ctx)
                     Res<TyId, AllocError> {
        self.type_memo.get(id).match({
            None    => self.compute_type(id, ctx),
            Ok(hit) => Ok(hit),
        })
    }

    compute_type = (self :: @Self, id: TypeId, ctx: Ctx)
                   Res<TyId, AllocError> {
        // seed the memo with poison before recursing, so a type that
        // mentions itself bottoms out instead of looping. A recursive
        // type is a real thing — `Node = { next: Ptr<Node> }` — and the
        // layout question is answered elsewhere.
        poison = self.types.unknown().try();
        self.type_memo.set(id, poison).try();
        node = self.tree.type_at(id);
        got = self.type_kind(node, ctx).try();
        self.type_memo.set(id, got).try();
        Ok(got);
    }

    type_kind = (self :: @Self, node: Type, ctx: Ctx) Res<TyId, AllocError> {
        node.kind.match({
            Unit      => self.types.prim("()"),
            SelfType  => self.self_type(ctx),
            Infer     => self.types.infer(),
            Variadic  => self.types.prim("..."),
            Named(n)  => self.named_type(node, n.name, n.args, ctx),
            Union(u)  => self.union_type(u.members, ctx),
            Fn(f)     => self.fn_type(f.params, f.ret, ctx),
            Array(t)  => self.array_type(t.elem, ctx),
        })
    }

    self_type = (self :: @Self, ctx: Ctx) Res<TyId, AllocError> {
        ctx.has_self.match({
            false => self.types.unknown(),
            true  => Ok(ctx.self_ty),
        })
    }

    union_type = (self :: @Self, members: Vec<TypeId>, ctx: Ctx)
                 Res<TyId, AllocError> {
        parts ::= self.alloc.Vec<TyId>();
        members.loop((h, m) {
            parts.add(self.type_from_ast(m, ctx).try()).try();
        });
        self.types.union_ty(parts)
    }

    fn_type = (self :: @Self, params: Vec<Param>, ret: TypeId, ctx: Ctx)
              Res<TyId, AllocError> {
        ptys ::= self.alloc.Vec<TyId>();
        params.loop((h, p) {
            ptys.add(self.param_type(p, ctx).try()).try();
        });
        rty = self.type_from_ast(ret, ctx).try();
        self.types.fn_ty(ptys, rty)
    }

    param_type = (self :: @Self, p: Param, ctx: Ctx) Res<TyId, AllocError> {
        p.type.match({
            None    => self.types.infer(),
            Ok(t)   => self.type_from_ast(t, ctx),
        })
    }

    // `[u8, 64]`. The element type is what an assignment has to agree
    // about; the COUNT is a comptime expression and is not carried here
    // yet, so a provable out-of-range index is out of reach. That is a
    // gap and it is named in the report rather than papered over.
    array_type = (self :: @Self, elem: TypeId, ctx: Ctx)
                 Res<TyId, AllocError> {
        e = self.type_from_ast(elem, ctx).try();
        args ::= self.alloc.Vec<TyId>();
        args.add(e).try();
        self.types.named(ARRAY_DECL, "[]", "[]", args)
    }

    // A written name, applied to its arguments.
    //
    // `Res` is recognised structurally rather than resolved, and that is
    // not a special case for a favourite type: `Res<T>` and `Res<T, E>`
    // are two arities of one name, sema asks "which form is this" at
    // every `.try()`, and a nominal answer would make every one of those
    // questions a field read through a declaration.
    named_type = (self :: @Self, node: Type, name: Ident, args: Vec<TypeId>,
                  ctx: Ctx) Res<TyId, AllocError> {
        tys ::= self.alloc.Vec<TyId>();
        args.loop((h, a) {
            tys.add(self.type_from_ast(a, ctx).try()).try();
        });
        name.text.eq("Res").match({
            true  => self.res_type(tys),
            false => self.declared_type(node, name, tys, ctx),
        })
    }

    res_type = (self :: @Self, args: Vec<TyId>) Res<TyId, AllocError> {
        value = args.get(0).match({ Ok(v) => v, None => UNRESOLVED });
        args.len.match({
            1 => self.types.res_absence(value),
            2 => self.res_failure_of(args, value),
            _ => self.types.unknown(),
        })
    }

    res_failure_of = (self :: @Self, args: Vec<TyId>, value: TyId)
                     Res<TyId, AllocError> {
        args.get(1).match({
            None    => self.types.unknown(),
            Ok(e)   => self.types.res_failure(value, e),
        })
    }

    // A primitive, or a declaration the module can see.
    //
    // The primitive check comes first because no module declares `i32`
    // in a way this layer can reach, and a name that is both would be a
    // language change rather than a lookup order.
    declared_type = (self :: @Self, node: Type, name: Ident, args: Vec<TyId>,
                     ctx: Ctx) Res<TyId, AllocError> {
        is_prim(name.text).match({
            true  => self.types.prim(name.text),
            false => self.lookup_named(node, name, args, ctx),
        })
    }

    lookup_named = (self :: @Self, node: Type, name: Ident, args: Vec<TyId>,
                    ctx: Ctx) Res<TyId, AllocError> {
        found ::= self.alloc.Vec<Def>();
        self.world.defs_of(ctx.module, name.text, found).try();
        found.get(0).match({
            None    => self.unresolved_type(node, name),
            Ok(d)   => self.types.named(d.id, d.qname, d.name, args),
        })
    }

    unresolved_type = (self :: @Self, node: Type, name: Ident)
                      Res<TyId, AllocError> {
        self.report(node.span.file, name.span,
                    SemaFault.UndefinedName(NameFault(name: name.text))).try();
        self.types.unknown()
    }

    // -----------------------------------------------------------------
    // QUERY: the type of an expression
    //
    // The one DESIGN.md names first. Memoized on the node id, so a
    // second ask is a lookup and an LSP hover is not a recompile.
    // -----------------------------------------------------------------

    type_of* = (self :: @Self, id: ExprId, ctx: Ctx) Res<TyId, AllocError> {
        self.expr_memo.get(id).match({
            None    => self.compute_expr(id, ctx),
            Ok(hit) => Ok(hit),
        })
    }

    compute_expr = (self :: @Self, id: ExprId, ctx: Ctx)
                   Res<TyId, AllocError> {
        poison = self.types.unknown().try();
        self.expr_memo.set(id, poison).try();
        node = self.tree.expr_at(id);
        got = self.expr_kind(node, ctx).try();
        self.expr_memo.set(id, got).try();
        Ok(got);
    }

    expr_kind = (self :: @Self, node: Expr, ctx: Ctx) Res<TyId, AllocError> {
        node.kind.match({
            Literal(l)  => self.literal_type(l),
            Unit        => self.types.prim("()"),
            SelfType    => self.self_type(ctx),
            Name(n)     => self.name_type(node, n.text, ctx),
            Paren(p)    => self.type_of(p.inner, ctx),
            Binary(b)   => self.binary_type(node, b, ctx),
            Unary(u)    => self.unary_type(u, ctx),
            Try(t)      => self.try_type(node, t.operand, ctx),
            Consume(c)  => self.type_of(c.operand, ctx),
            Block(b)    => self.block_type(b, ctx),
            _           => self.types.unknown(),
        })
    }

    // An integer literal is its own type until a context settles it —
    // "a literal's type comes from its context". `int` and `float` are
    // assignable to every width, and to nothing else.
    literal_type = (self :: @Self, l: Literal) Res<TyId, AllocError> {
        l.kind.match({
            Int   => self.types.prim("int"),
            Float => self.types.prim("float"),
            Str   => self.types.prim("str"),
            Char  => self.types.prim("u8"),
            Bool  => self.types.prim("bool"),
        })
    }

    // A bare identifier. A local shadows everything, then the module's
    // own declarations, then what it imported — and the `*` gate is
    // inside `defs_of`, not repeated here.
    name_type = (self :: @Self, node: Expr, text: str, ctx: Ctx)
                Res<TyId, AllocError> {
        self.lookup(text).match({
            None    => self.global_name_type(node, text, ctx),
            Ok(b)   => Ok(b.ty),
        })
    }

    global_name_type = (self :: @Self, node: Expr, text: str, ctx: Ctx)
                       Res<TyId, AllocError> {
        found ::= self.alloc.Vec<Def>();
        self.world.defs_of(ctx.module, text, found).try();
        found.get(0).match({
            None    => self.unresolved_name(node, text),
            Ok(d)   => self.def_type(d),
        })
    }

    unresolved_name = (self :: @Self, node: Expr, text: str)
                      Res<TyId, AllocError> {
        self.report(node.span.file, node.span,
                    SemaFault.UndefinedName(NameFault(name: text))).try();
        self.types.unknown()
    }

    // A name that denotes a DECLARATION rather than a value. A type used
    // as a value is the type itself — `Shape.Unit` reads through it —
    // and a function's own type is what overload resolution narrows.
    def_type = (self :: @Self, d: Def) Res<TyId, AllocError> {
        empty ::= self.alloc.Vec<TyId>();
        self.types.named(d.id, d.qname, d.name, empty)
    }

    // `a == b` is `bool` whatever the operands are; `a + b` is the
    // operands' type. Both sides are typed either way, because a
    // diagnostic inside an unused operand is still a diagnostic.
    binary_type = (self :: @Self, node: Expr, b: Binary, ctx: Ctx)
                  Res<TyId, AllocError> {
        lhs = self.type_of(b.lhs, ctx).try();
        rhs = self.type_of(b.rhs, ctx).try();
        is_predicate(b.op).match({
            true  => self.types.bool_ty(),
            false => self.arith_type(lhs, rhs),
        })
    }

    // The wider of the two: a literal takes the other side's type, which
    // is "a literal's type comes from its context" one level in.
    arith_type = (self :: @Self, lhs: TyId, rhs: TyId) Res<TyId, AllocError> {
        // the match yields a bare TyId and the `Ok` is outside it: two
        // arms that are both `Ok(..)` give the match no written type to
        // take from its first arm.
        Ok(self.is_literal_ty(lhs).match({
            true  => rhs,
            false => lhs,
        }));
    }

    unary_type = (self :: @Self, u: Unary, ctx: Ctx) Res<TyId, AllocError> {
        inner = self.type_of(u.operand, ctx).try();
        u.op.match({
            Not  => self.types.bool_ty(),
            Neg  => Ok(inner),
            Addr => Ok(inner),
        })
    }


    // -----------------------------------------------------------------
    // `.try()`
    //
    // "It unwraps Ok, or returns the Err — or the None — from the
    // ENCLOSING function." Three rules go with it and all three are law
    // 4: the enclosing function must return a compatible Res, a `Res<T>`
    // may not try into a `Res<T, E>` function, and nothing is converted.
    // -----------------------------------------------------------------

    try_type = (self :: @Self, node: Expr, operand: ExprId, ctx: Ctx)
               Res<TyId, AllocError> {
        got = self.type_of(operand, ctx).try();
        self.types.at(got).match({
            Res(r) => self.try_res(node, r, got, ctx),
            _      => self.try_not_res(node, got, ctx),
        })
    }

    try_not_res = (self :: @Self, node: Expr, got: TyId, ctx: Ctx)
                  Res<TyId, AllocError> {
        // poison never produces a second diagnostic
        self.is_unknown(got).match({
            false => self.try_needs_res(node, got),
            true  => Ok(got),
        })
    }

    try_needs_res = (self :: @Self, node: Expr, got: TyId)
                    Res<TyId, AllocError> {
        want = self.types.unknown().try();
        self.report(node.span.file, node.span,
                    SemaFault.TryNeedsRes(TypeFault(
                        name: "", expected: want, found: got))).try();
        self.types.unknown()
    }

    try_res = (self :: @Self, node: Expr, r: TyRes, got: TyId, ctx: Ctx)
              Res<TyId, AllocError> {
        ctx.has_ret.match({
            false => self.try_outside_res(node, got),
            true  => self.try_into(node, r, got, ctx),
        })
    }

    try_outside_res = (self :: @Self, node: Expr, got: TyId)
                      Res<TyId, AllocError> {
        want = self.types.unknown().try();
        self.report(node.span.file, node.span,
                    SemaFault.TryOutsideRes(TypeFault(
                        name: "", expected: want, found: got))).try();
        Ok(got)
    }

    // The enclosing function returns a Res. Which one decides whether
    // this propagation is legal at all.
    try_into = (self :: @Self, node: Expr, r: TyRes, got: TyId, ctx: Ctx)
               Res<TyId, AllocError> {
        self.types.at(ctx.ret).match({
            Res(want) => self.try_merge(node, r, want, got),
            _         => self.try_outside_res(node, got),
        })
    }

    try_merge = (self :: @Self, node: Expr, r: TyRes, want: TyRes, got: TyId)
                Res<TyId, AllocError> {
        // an absence propagating into a failure is the one shape law 4
        // names outright: "a None never becomes an Err. You name the
        // reason" — and `.ok_or(..)` is where that is written.
        absence_into_failure(r.form, want.form).match({
            true  => self.try_absence(node, got, r.value),
            false => self.try_set(node, r, want),
        })
    }

    try_absence = (self :: @Self, node: Expr, got: TyId, value: TyId)
                  Res<TyId, AllocError> {
        want = self.types.res_failure(value, got).try();
        self.report(node.span.file, node.span,
                    SemaFault.TryAbsenceIntoFailure(TypeFault(
                        name: "", expected: want, found: got))).try();
        Ok(value)
    }

    // "propagation merges sets" — and merging is containment, not
    // conversion. The callee's set must already be part of the
    // caller's; there is no From to bridge them.
    try_set = (self :: @Self, node: Expr, r: TyRes, want: TyRes)
              Res<TyId, AllocError> {
        both_failures(r.form, want.form).match({
            true  => self.try_contained(node, r, want),
            false => Ok(r.value),
        })
    }

    try_contained = (self :: @Self, node: Expr, r: TyRes, want: TyRes)
                    Res<TyId, AllocError> {
        self.types.set_within(r.error, want.error).match({
            false => self.try_no_conversion(node, r, want),
            true  => Ok(r.value),
        })
    }

    try_no_conversion = (self :: @Self, node: Expr, r: TyRes, want: TyRes)
                        Res<TyId, AllocError> {
        self.report(node.span.file, node.span,
                    SemaFault.NoErrorConversion(TypeFault(
                        name: "",
                        expected: want.error,
                        found: r.error))).try();
        Ok(r.value)
    }

    // -----------------------------------------------------------------
    // blocks
    //
    // "A block is a value too." Its value is the trailing expression
    // written without a `;`; DESIGN.md also lets a `;`-terminated tail
    // be the value, and the AST records only what was written, so this
    // is where that is decided.
    // -----------------------------------------------------------------

    block_type* = (self :: @Self, id: BlockId, ctx: Ctx)
                  Res<TyId, AllocError> {
        mark = self.mark();
        blk = self.tree.block_at(id);
        tail = self.walk_stmts(blk, ctx).try();
        got = blk.value.match({
            Ok(e)   => self.type_of(e, ctx),
            None    => Ok(tail),
        }).try();
        self.release(mark).try();
        Ok(got);
    }

    // Every statement, in order, so a binding is in scope for the ones
    // after it. The last statement's type is carried out because a
    // `;`-terminated tail closes a function: "`0;` closes a Res<i32, E>
    // function like `Ok(0);` does".
    walk_stmts = (self :: @Self, blk: Block, ctx: Ctx)
                 Res<TyId, AllocError> {
        last ::= self.types.prim("()").try();
        blk.stmts.loop((h, s) {
            last = self.stmt_type(s, ctx).try();
        });
        Ok(last);
    }

    stmt_type = (self :: @Self, s: Stmt, ctx: Ctx) Res<TyId, AllocError> {
        s.kind.match({
            Expr(e)  => self.type_of(e.expr, ctx),
            Bind(b)  => self.bind_stmt(b, ctx),
            Block(b) => self.block_type(b, ctx),
            Decl(_)  => self.types.prim("()"),
        })
    }

    // `x = e;`, `x: T ::= e;`. A written type wins and the value is
    // checked against it; with none, the value's type is the binding's.
    bind_stmt = (self :: @Self, b: Bind, ctx: Ctx) Res<TyId, AllocError> {
        got = self.type_of(b.value, ctx).try();
        want = b.type.match({
            Ok(t)   => self.type_from_ast(t, ctx),
            None    => Ok(got),
        }).try();
        self.check_assign(b, got, want, ctx).try();
        self.bind_target(b, want).try();
        self.types.prim("()")
    }

    check_assign = (self :: @Self, b: Bind, got: TyId, want: TyId, ctx: Ctx)
                   Res<(), AllocError> {
        node = self.tree.expr_at(b.value);
        self.coerce(node.span.file, node.span, got, want, "").try();
        Ok(());
    }

    // Only a bare name introduces a binding. `self.len = ..` and
    // `buf[i] = ..` are assignments to something that already exists,
    // which is why `Bind.target` is an expression and not an `Ident`.
    bind_target = (self :: @Self, b: Bind, ty: TyId) Res<(), AllocError> {
        target = self.tree.expr_at(b.target);
        target.kind.match({
            Name(n) => self.bind(n.text, ty, b.mutable),
            _       => Ok(()),
        }).try();
        Ok(());
    }

    // -----------------------------------------------------------------
    // agreement
    // -----------------------------------------------------------------

    // Is a value of type `got` acceptable where `want` is expected?
    //
    // One-way, and deliberately lenient in three places: poison agrees
    // with everything (one mistake, one diagnostic), a hole agrees with
    // everything (`_` is a hole), and a literal agrees with any type of
    // its family (a literal's type comes from its context).
    assignable* = (self: @Self, got: TyId, want: TyId) bool {
        got.eq(want)
            || self.is_unknown(got) || self.is_unknown(want)
            || self.is_infer(got) || self.is_infer(want)
            || self.literal_fits(got, want)
            || self.set_assignable(got, want)
    }

    // A union target accepts any of its members: widening an error set
    // is what `.try()` does, and it is not a conversion.
    set_assignable = (self: @Self, got: TyId, want: TyId) bool {
        self.types.at(want).match({
            Union(_) => self.types.set_has(want, got),
            _        => false,
        })
    }

    literal_fits = (self: @Self, got: TyId, want: TyId) bool {
        self.is_int_literal(got).match({
            true  => is_integer(self.prim_name(want)),
            false => self.float_fits(got, want),
        })
    }

    float_fits = (self: @Self, got: TyId, want: TyId) bool {
        self.is_float_literal(got) && is_float(self.prim_name(want))
    }

    // Report a mismatch, or say nothing. The one place `expected X,
    // found Y` is raised, so the rule for when it is NOT raised —
    // poison, holes, literals — lives in `assignable` alone.
    coerce* = (self :: @Self, file: str, span: Span, got: TyId, want: TyId,
               name: str) Res<(), AllocError> {
        self.assignable(got, want).match({
            false => self.mismatch(file, span, got, want, name),
            true  => Ok(()),
        })
    }

    mismatch = (self :: @Self, file: str, span: Span, got: TyId, want: TyId,
                name: str) Res<(), AllocError> {
        self.report(file, span, SemaFault.TypeMismatch(TypeFault(
            name: name, expected: want, found: got)))
    }

    // -----------------------------------------------------------------
    // asking a type what it is
    // -----------------------------------------------------------------

    is_unknown* = (self: @Self, id: TyId) bool {
        self.types.at(id).match({ Unknown => true, _ => false })
    }

    is_infer* = (self: @Self, id: TyId) bool {
        self.types.at(id).match({ Infer => true, _ => false })
    }

    prim_name* = (self: @Self, id: TyId) str {
        self.types.at(id).match({ Prim(p) => p.name, _ => "" })
    }

    is_literal_ty = (self: @Self, id: TyId) bool {
        self.is_int_literal(id) || self.is_float_literal(id)
    }

    is_int_literal = (self: @Self, id: TyId) bool {
        self.prim_name(id).eq("int")
    }

    is_float_literal = (self: @Self, id: TyId) bool {
        self.prim_name(id).eq("float")
    }
}

// `alloc.Checker(tree)` — a ufcs function whose first parameter is an
// Alloc, beside the type it builds, exactly as `Vec`, `Map`, `Ast` and
// `Types` are. It builds the module graph eagerly, because every query
// below needs it and building it twice is the thing memoization exists
// to prevent.
Checker* = (a: Alloc, tree: Ast) Res<Checker, AllocError> {
    Ok(Checker(
        tree: tree,
        world: a.World(tree).try(),
        types: a.Types(),
        diags: a.Vec<Diag>(),
        expr_memo: a.Map<ExprId, TyId>(),
        type_memo: a.Map<TypeId, TyId>(),
        locals: a.Vec<Binding>(),
        alloc: a,
    ));
}

// A context with nothing in it: module 0, no `@Self`, no enclosing Res.
// A caller fills in what it knows.
Ctx* = (module: usize, none: TyId) Ctx {
    Ctx(module: module, ret: none, has_ret: false,
        self_ty: none, has_self: false)
}

// The declaration a fixed-array type is nominal on. There isn't one —
// `[u8, 64]` is written, not declared — so this names a coordinate no
// module occupies, and `named` keys on it like any other.
ARRAY_DECL* : DeclId = DeclId(module: 4294967295, decl: 0)

// The `TyId` a lookup falls back to before the store has answered. It is
// index 0, which the store's own construction order makes the first type
// ever interned; nothing reads it as a type, only as a placeholder an
// error path immediately replaces.
UNRESOLVED* : TyId = TyId(index: 0)

// `==`, `!=`, `<`, `&&` and their kin are `bool` whatever they compare;
// everything else in `BinOp` yields its operands' type.
is_predicate* = (op: BinOp) bool {
    op.match({
        Equal => true, NotEqual => true,
        Less => true, LessEq => true, Greater => true, GreaterEq => true,
        And => true, Or => true,
        _ => false,
    })
}

// The scalars no module declares. A list rather than a lookup, because
// it is closed by the language and a name that is almost one of these is
// a name, not a near miss.
is_prim* = (name: str) bool {
    is_integer(name) || is_float(name)
        || name.eq("bool") || name.eq("str") || name.eq("()")
}

is_integer* = (name: str) bool {
    name.eq("i8") || name.eq("i16") || name.eq("i32") || name.eq("i64")
        || name.eq("u8") || name.eq("u16") || name.eq("u32") || name.eq("u64")
        || name.eq("usize")
}

is_float* = (name: str) bool { name.eq("f32") || name.eq("f64") }

// `Res<T>` propagating into a `Res<T, E>` function. Named because the
// rule it stands for has a name: only success lifts, and an absence
// carries no reason to become one.
absence_into_failure* = (got: ResForm, want: ResForm) bool {
    got.match({
        Absence => want.match({ Failure => true, _ => false }),
        _       => false,
    })
}

both_failures* = (got: ResForm, want: ResForm) bool {
    got.match({
        Failure => want.match({ Failure => true, _ => false }),
        _       => false,
    })
}
