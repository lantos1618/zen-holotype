// lsp.zen — `zenc lsp`: a Language Server Protocol server over stdio. Speaks the framed
// Content-Length wire format, publishes diagnostics on open/change, and answers go-to-definition.
// The JSON here is hand-rolled (std.format.json isn't in the seed manifest) and deliberately
// minimal: enough of a reader to pull the fields the protocol needs out of a request body.
{ Malloc, heap_scope_begin, heap_scope_end } = std.mem.alloc
{ view, is_empty } = std.text.str
{ then } = std.core.bool
{ contents_in } = std.io.file
{ read, write } = std.c.libc
{ hex_char, hex_nibble } = std.text.ascii    // shared hex nibble encode/decode
{ advance_while, repeat_while, step_while } = std.core.count
{ CheckDiagnostic, desc_or } = compiler.validate.diag
{ denrich_check } = compiler.validate.enrich
{ parse_module } = compiler.parse
{ resolve_module } = compiler.check_resolve
{ ufcs_vis_of } = compiler.check
{ check_module_ownership_diagnostic_from_source, check_module_parse_diagnostic_from_source,
  check_module_no_if_diagnostic_from_source, check_module_no_ternary_diagnostic_from_source,
  check_module_no_coroutine_diagnostic_from_source, check_module_reserved_diagnostic_from_source,
  check_module_escape_diagnostic_from_source, check_module_leak_diagnostic_from_source,
  check_module_addr_escape_diagnostic_from_source, check_module_send_rc_diagnostic_from_source,
  check_module_scratch_diagnostic_from_source, check_module_send_mut_diagnostic_from_source,
  check_module_bound_diagnostic_from_source, check_module_arg_diagnostic_from_source,
  check_module_or_return_diagnostic_from_source, check_module_unknown_type_diagnostic_from_source,
  check_module_ffi_diagnostic_from_source, check_module_mustuse_diagnostic_from_source,
  check_module_infinite_type_diagnostic_from_source, check_module_main_diagnostic_from_source,
  check_module_batch_vis } = compiler.validate.core
{ DiagSpan } = compiler.diagnostic
{ resolve_failed, resolve_message, resolve_program_data, ResolvedProgram } = compiler.resolve
{ impl_cname_in } = compiler.mangle
{ gstr_string, gstr_append, gstr_finish, gstr_push, acquire_or_die, acquire_or_die } = compiler.genc
{ push_int, dirname, cstr_range, cstr_substr } = compiler.drvutil
{ lspt_legend, lspt_tokens } = compiler.lsp_tokens
{ lspd_cache_tokens, lspd_close, lspd_find, lspd_set, lspd_text_at, lspd_tokens_at } = compiler.lsp_docs
{ cd_or, locate_diag } = compiler.drvdiag
{ ff_is_hoisted } = compiler.pretty_decl
{ lsp_byte_of_pos, lsp_col_of, lsp_find_def, lsp_ident_end, lsp_ident_start, lsp_line_of,
  lspq_hover, lspq_items } = compiler.lsp_query
// ── `zenc lsp` — diagnostics-only Language Server over stdio (LSP Stage 1) ─────────────────────────
// A JSON-RPC 2.0 loop: read `Content-Length: N\r\n\r\n<N-byte JSON body>` frames from stdin, run the
// EXISTING check pipeline (resolve -> parse -> the diagnostic channels) on each opened/changed
// document, and PUSH `textDocument/publishDiagnostics`. This only ADDS a subcommand — no compiler
// internals change; it rides check_module_batch + the specialized channels the driver already uses.
// Full-sync per document: the text is checked standalone; its directory is derived from the
// `file://` URI so sibling/std imports resolve (an error INSIDE an imported module is pinned to the
// open file's head with the real location in the message). Stage 1 adds: didClose (clears
// diagnostics), MethodNotFound replies for unimplemented requests, byte->UTF-16 position conversion,
// and a Content-Length sanity ceiling. Every feature reads the OPEN document out of the document
// store (compiler.lsp_docs) that didOpen/didChange fill, never off disk — while the client holds a
// buffer open, that buffer IS the document. Conformance suite: tests/harness_lsp.zen. Stage 2b adds
// hover and completion, both answered TEXTUALLY by compiler.lsp_query (which states exactly what
// they cover) so they survive the unparseable buffer an editor holds between keystrokes; and
// documentSymbol, the outline `gO` and the `]m`/`[m` method motions are driven by.
// PROTOCOL WRITES GO TO STDOUT (fd 1); every diagnostic/log the pipeline emits stays on stderr, so the
// JSON-RPC stream is never corrupted.
lout = (s: StringView) i64 {
    v = s.view()
    write(1, v.ptr, v.len)
}
// frame + write one JSON-RPC message: `Content-Length: <bytes>\r\n\r\n<body>`.
lsp_send = (mp: MutPtr<Malloc>, body: StringView) i64 {
    lout(mp
        .gstr_string(48)
        .gstr_append(mp, "Content-Length: ")
        .push_int(mp, body.view().len)
        .gstr_append(mp, "\r\n\r\n")
        .gstr_finish(mp))
    lout(body)
}
// ── JSON string EMISSION (own escaper; the task sanctions building output as strings) ─────────────
push_uesc = (sb: String, mp: MutPtr<Malloc>, b: u8) String {
    bi = b.to_i64()
    sb
        .gstr_append(mp, "\\u00")
        .gstr_push(mp, hex_char(bi >> 4 & 15))
        .gstr_push(mp, hex_char(bi & 15))
}
// append `s` as a JSON string LITERAL (surrounding quotes + escaped) to the builder.
push_jstr = (sb: String, mp: MutPtr<Malloc>, s: StringView) String {
    cur ::= sb.gstr_push(mp, '"')
    v: [u8] = s.view()
    v.loop((h, i, b) {
        cur = (b == '"').match ({
            true  => cur.gstr_append(mp, "\\\""),
            false => (b == '\\').match ({
                true  => cur.gstr_append(mp, "\\\\"),
                false => (b == '\n').match ({
                    true  => cur.gstr_append(mp, "\\n"),
                    false => (b == '\r').match ({
                        true  => cur.gstr_append(mp, "\\r"),
                        false => (b == '\t').match ({
                            true  => cur.gstr_append(mp, "\\t"),
                            false => (b < 32).match ({
                                true  => cur.push_uesc(mp, b),
                                false => cur.gstr_push(mp, b),
                            }),
                        }),
                    }),
                }),
            }),
        })
    })
    cur.gstr_push(mp, '"')
}
// ── incoming JSON extraction (hand-rolled; std.json's `parse`/`get` collide with the compiler's own
// flat `parse`/`get` names once this closure imports compiler.parse, so a targeted scanner is used).
// The scanner walks left-to-right skipping over complete JSON strings, so a `"key":` byte-pattern that
// happens to sit INSIDE a string value (e.g. the document source text) is never mistaken for a key.
// String scanning/decoding ITERATES (step_while) so a megabyte document never recurses the C stack.
// index just past the closing quote of the string opening at v[i]=='"' (respecting `\` escapes).
json_str_end = (v: [u8], i: i64) i64 {
    e = (i + 1).step_while((j) { j < v.len && v[j] != '"' }, (j) {
        (v[j] == '\\').then({ j + 2 }, { j + 1 })
    })
    (e < v.len).then({ e + 1 }, { v.len })
}
json_skip_ws = (v: [u8], p: i64) i64 {
    p.advance_while((q) {
        q < v.len && (v[q] == ' ' || v[q] == '\t' || v[q] == '\n' || v[q] == '\r')
    })
}
json_range_eq = (v: [u8], start: i64, kv: [u8], k: i64) bool {
    (k >= kv.len).match ({
        true  => true,
        false => (v[start + k] == kv[k]).then({ v.json_range_eq(start, kv, k + 1) }, { false }),
    })
}
json_str_eq_range = (v: [u8], start: i64, end: i64, kv: [u8]) bool {
    (end - start != kv.len).then({ false }, { v.json_range_eq(start, kv, 0) })
}
// the byte offset of the VALUE for the first object key named `key`, or -1. Strings are consumed whole,
// so key matches inside a value never fire and nesting is transparent.
json_find_key = (v: [u8], key: StringView) i64 {
    kv: [u8] = key.view()
    result :: i64 = 0 - 1
    zero: i64 = 0
    zero.step_while((i) { result < 0 && i < v.len }, (i) {
        (v[i] == '"').match ({
            true  => {
                se = v.json_str_end(i)
                cs = v.json_skip_ws(se)
                (cs < v.len && v[cs] == ':' && v.json_str_eq_range(i + 1, se - 1, kv)).then({
                    result = v.json_skip_ws(cs + 1)
                })
                se
            },
            false => i + 1,
        })
    })
    result
}
json_hexq = (v: [u8], at: i64) i64 {
    (at + 3 >= v.len).match ({
        true  => 0 - 1,
        false => {
            h0 = hex_nibble(v[at])
            h1 = hex_nibble(v[at + 1])
            h2 = hex_nibble(v[at + 2])
            h3 = hex_nibble(v[at + 3])
            (h0 < 0 || h1 < 0 || h2 < 0 || h3 < 0).match ({
                true  => 0 - 1,
                false => h0 * 4096 + h1 * 256 + h2 * 16 + h3,
            })
        },
    })
}
// UTF-8 encode a BMP code point into the builder (1–3 bytes).
push_utf8 = (sb: String, mp: MutPtr<Malloc>, cp: i64) String {
    (cp < 128).match ({
        true  => sb.gstr_push(mp, cp.to_u8()),
        false => (cp < 2048).match ({
            true  => sb
                .gstr_push(mp, (192 | cp >> 6).to_u8())
                .gstr_push(mp, (128 | cp & 63).to_u8()),
            false => sb
                .gstr_push(mp, (224 | cp >> 12).to_u8())
                .gstr_push(mp, (128 | cp >> 6 & 63).to_u8())
                .gstr_push(mp, (128 | cp & 63).to_u8()),
        }),
    })
}
// decode the JSON string opening at v[i]=='"' into an allocator-owned view (escapes resolved).
json_decode_str = (mp: MutPtr<Malloc>, v: [u8], i: i64) StringView {
    sb ::= mp.gstr_string(v.len - i + 1)
    (i + 1).step_while((j) { j < v.len && v[j] != '"' }, (j) {
        b = v[j]
        (b == '\\' && j + 1 < v.len).match ({
            true  => {
                e = v[j + 1]
                (e == 'n').match ({
                    true  => {
                        sb = sb.gstr_push(mp, '\n')
                        j + 2
                    },
                    false => (e == 't').match ({
                        true  => {
                            sb = sb.gstr_push(mp, '\t')
                            j + 2
                        },
                        false => (e == 'r').match ({
                            true  => {
                                sb = sb.gstr_push(mp, '\r')
                                j + 2
                            },
                            false => (e == 'b').match ({
                                true  => {
                                    sb = sb.gstr_push(mp, '\x08')
                                    j + 2
                                },
                                false => (e == 'f').match ({
                                    true  => {
                                        sb = sb.gstr_push(mp, '\x0c')
                                        j + 2
                                    },
                                    false => (e == 'u').match ({
                                        true  => {
                                            cp = v.json_hexq(j + 2)
                                            (cp < 0).match ({
                                                true  => {
                                                    sb = sb.gstr_push(mp, e)
                                                    j + 2
                                                },
                                                false => {
                                                    sb = sb.push_utf8(mp, cp)
                                                    j + 6
                                                },
                                            })
                                        },
                                        false => {
                                            sb = sb.gstr_push(mp, e)
                                            j + 2
                                        },
                                    }),
                                }),
                            }),
                        }),
                    }),
                })
            },
            false => {
                sb = sb.gstr_push(mp, b)
                j + 1
            },
        })
    })
    sb.gstr_finish(mp)
}
// raw bytes of the value at v[i]: a quoted string (incl. quotes) or a bare token up to `,`/`}`/`]`/ws.
json_raw_at = (mp: MutPtr<Malloc>, v: [u8], i: i64) StringView {
    (i >= v.len).match ({
        true  => "null",
        false => (v[i] == '"').match ({
            true  => mp.cstr_range(v, i, v.json_str_end(i)),
            false => {
                e = i.advance_while((p) {
                    p < v.len
                        && v[p] != ','
                        && v[p] != '}'
                        && v[p] != ']'
                        && v[p] != ' '
                        && v[p] != '\t'
                        && v[p] != '\n'
                        && v[p] != '\r'
                })
                mp.cstr_range(v, i, e)
            },
        }),
    })
}
// the decoded string value of the first key `key`, or "" if absent / non-string.
json_str_field = (mp: MutPtr<Malloc>, body: StringView, key: StringView) StringView {
    v: [u8] = body.view()
    p = v.json_find_key(key)
    (p < 0 || p >= v.len).match ({
        true  => "",
        false => (v[p] == '"').then({ mp.json_decode_str(v, p) }, { "" }),
    })
}
// the request id as a raw JSON fragment (number or quoted string), echoed verbatim into the reply.
lsp_id = (mp: MutPtr<Malloc>, body: StringView) StringView {
    v: [u8] = body.view()
    p = v.json_find_key("id")
    (p < 0).then({ "null" }, { mp.json_raw_at(v, p) })
}
// ── URI -> filesystem path (strip a leading `file://`; percent-decoding is a later refinement) ─────
lsp_has_prefix = (s: StringView, pre: StringView) bool {
    sv: [u8] = s.view()
    pv: [u8] = pre.view()
    (sv.len < pv.len).then({ false }, { lsp_prefix_bytes(sv, pv, 0) })
}
lsp_prefix_bytes = (sv: [u8], pv: [u8], i: i64) bool {
    (i >= pv.len).match ({
        true  => true,
        false => (sv[i] == pv[i]).then({ sv.lsp_prefix_bytes(pv, i + 1) }, { false }),
    })
}
lsp_uri_path = (mp: MutPtr<Malloc>, uri: StringView) StringView {
    uri.lsp_has_prefix("file://").match ({
        true  => mp.cstr_substr(uri, 7, to_i32(uri.view().len - 7)),
        false => uri,
    })
}
// ── DiagSpan (1-based line/col, 1-based-inclusive end_col) -> LSP 0-based range ────────────────────
// LSP is 0-based: line -> line-1, start.character -> col-1. end_col is the 1-based inclusive last
// column, numerically the 0-based EXCLUSIVE end — so end.character = end_col (never a further -1). An
// unlocated span (line 0) is pinned to the file start with a 1-char range so the squiggle is visible.
ZSpan: {
    l: i64,
    c: i64,
    e: i64,
}
lsp_end_char = (sp: DiagSpan) i64 {
    ec = to_i64(sp.end_col)
    cc = to_i64(sp.col - 1)
    (ec > cc).then({ ec }, { cc + 1 })
}
lsp_zero_span = (sp: DiagSpan) ZSpan {
    (sp.line > 0).match ({
        true  => ZSpan(
            l: to_i64(sp.line - 1),
            c: (sp.col > 0).then({ to_i64(sp.col - 1) }, { 0 }),
            e: sp.lsp_end_char(),
        ),
        false => ZSpan(
            l: 0,
            c: 0,
            e: 1,
        ),
    })
}
// ── byte columns -> UTF-16 columns (LSP `character` counts UTF-16 CODE UNITS, not bytes) ──────────
// zenc spans are byte columns into the source line; a client fed byte columns misplaces squiggles on
// any line with non-ASCII bytes before the error. Conversion walks the located line once: every
// non-continuation byte counts 1 unit, and a 4-byte UTF-8 lead (>= 0xF0, a supplementary-plane char)
// counts 2 (its UTF-16 surrogate pair).
lsp_line_start = (v: [u8], ln: i64) i64 {
    k :: i64 = 0
    zero: i64 = 0
    zero.step_while((i) { k < ln && i < v.len }, (i) {
        (v[i] == '\n').then({
            k = k + 1
        })
        i + 1
    })
}
lsp_utf16_col = (v: [u8], ls: i64, bytecol: i64) i64 {
    u :: i64 = 0
    end = ls + bytecol
    ls.step_while((i) { i < v.len && i < end && v[i] != '\n' }, (i) {
        bi = v[i].to_i64()
        (bi & 192 != 128).then({
            u = u + (bi >= 240).then({ 2 }, { 1 })
        })
        i + 1
    })
    u
}
// ── one diagnostic -> one LSP Diagnostic object, accumulated (comma-separated) into the array ──────
DiagAcc: {
    sb: String,
    n: i32,
}
lsp_push_diag = (
    mp: MutPtr<Malloc>,
    acc: DiagAcc,
    rp: ResolvedProgram,
    raw: [Decl],
    decls: [Decl],
    path: StringView,
    user: StringView,
    cd: CheckDiagnostic,
) DiagAcc {
    (cd.code == 0).match ({
        true  => acc,
        false => {
            dl = rp.locate_diag(cd.source_offset, cd.span_width, path, user)
            z = lsp_zero_span(dl.sp)
            // byte -> UTF-16 columns against the line the span actually points into (dl.src is the
            // owning module's source; for the open document it IS the client's text).
            sv: [u8] = dl.src.view()
            ls = sv.lsp_line_start(z.l)
            zc ::= sv.lsp_utf16_col(ls, z.c)
            ze ::= sv.lsp_utf16_col(ls, z.e)
            ze = (ze > zc).then({ ze }, { zc + 1 })
            // enrich exactly like the CLI (emit_one): denriched message + world-teaching undefined-name hint.
            msg = desc_or(mp.denrich_check(raw, decls, cd.source_offset, cd.code, cd.kind), cd.message)
            hint ::= cd.hint
            (cd.kind == "undefined-name").then({
                wh = mp.undefined_name_hint(rp.table, rp.flat, cd.source_offset)
                (is_empty(wh) == false).then({
                    hint = wh
                })
            })
            full ::= is_empty(hint).match ({
                true  => msg,
                false => mp
                    .gstr_string(128)
                    .gstr_append(mp, msg)
                    .gstr_append(mp, " — ")
                    .gstr_append(mp, hint)
                    .gstr_finish(mp),
            })
            // an error living in an IMPORTED module (dl.path != the open document) must not squiggle
            // an unrelated range of the open file: pin it to the file head and name the real location
            // in the message, so the information survives without a lying range.
            line :: i64 = z.l
            (dl.path == path).match ({
                true  => 0,
                false => {
                    line = 0
                    zc = 0
                    ze = 1
                    full = mp
                        .gstr_string(128)
                        .gstr_append(mp, "in imported module ")
                        .gstr_append(mp, dl.path)
                        .gstr_append(mp, ":")
                        .push_int(mp, to_i64(dl.sp.line))
                        .gstr_append(mp, ": ")
                        .gstr_append(mp, full)
                        .gstr_finish(mp)
                    0
                },
            })
            sep = (acc.n > 0).then({ "," }, { "" })
            sb2 = acc.sb
                .gstr_append(mp, sep)
                .gstr_append(mp, "{\"range\":{\"start\":{\"line\":")
                .push_int(mp, line)
                .gstr_append(mp, ",\"character\":")
                .push_int(mp, zc)
                .gstr_append(mp, "},\"end\":{\"line\":")
                .push_int(mp, line)
                .gstr_append(mp, ",\"character\":")
                .push_int(mp, ze)
                .gstr_append(mp, "}},\"severity\":1,\"code\":")
                .push_jstr(mp, cd.kind)
                .gstr_append(mp, ",\"source\":\"zen\",\"message\":")
                .push_jstr(mp, full)
                .gstr_append(mp, "}")
            DiagAcc(
                sb: sb2,
                n: acc.n + 1,
            )
        },
    })
}
// run the pipeline on `text` and PUBLISH. Structural blockers (no-if, parse) are reported ALONE —
// their flat sentinels would otherwise spray bogus type errors. Otherwise every specialized semantic
// channel (reserved/ownership/escape/leak/…/mustuse) contributes its diagnostic AND the whole main
// batch (names/types/arity/exhaustiveness/…) is collected, so an ownership error shows alongside type
// errors rather than one channel hiding the rest. Empty array => clears old squiggles.
// one whole-file diagnostic carrying `msg` verbatim — the shape a REJECTED resolve reports through.
lsp_head_diag = (mp: MutPtr<Malloc>, msg: StringView) StringView {
    mp
        .gstr_string(256)
        .gstr_append(mp, "{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":1}},\"severity\":1,\"code\":\"unresolved-import\",\"source\":\"zen\",\"message\":")
        .push_jstr(mp, mp.lsp_trim_nl(msg))
        .gstr_append(mp, "}")
        .gstr_finish(mp)
}
// the latched rejection text is newline-terminated (it was written straight to stderr); an LSP
// message keeps its internal newlines (hint lines) but never a trailing one.
lsp_trim_nl = (mp: MutPtr<Malloc>, s: StringView) StringView {
    v: [u8] = s.view()
    (v.len > 0 && v[v.len - 1] == '\n').then({ mp.cstr_substr(s, 0, to_i32(v.len - 1)) }, { s })
}
lsp_diags_array = (
    mp: MutPtr<Malloc>,
    root: StringView,
    path: StringView,
    text: StringView,
) StringView {
    rp = mp.resolve_program_data(root, mp.dirname(path), path, text)
    // A REJECTED resolve (unknown module / unknown name / dup-fn …) is reported ALONE and the server
    // stays up: half of every import line a user types names a module that does not exist yet, and the
    // flat built from a missing module would otherwise spray bogus undefined-name errors over the file.
    resolve_failed().then({
        return mp.lsp_head_diag(resolve_message())
    })
    raw = mp.parse_module(rp.flat)
    decls = mp.resolve_module(raw)
    nif = check_module_no_if_diagnostic_from_source(rp.flat)
        .cd_or(check_module_no_ternary_diagnostic_from_source(rp.flat))
        .cd_or(check_module_no_coroutine_diagnostic_from_source(rp.flat))
    pars = mp.check_module_parse_diagnostic_from_source(decls, rp.flat)
    acc = DiagAcc(
        sb: mp.gstr_string(256),
        n: 0,
    )
    done = (nif.code != 0).match ({
        true  => mp.lsp_push_diag(acc, rp, raw, decls, path, text, nif),
        false => (pars.code != 0).match ({
            true  => mp.lsp_push_diag(acc, rp, raw, decls, path, text, pars),
            false => {
                a ::= acc
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_reserved_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_ownership_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_escape_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_leak_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_addr_escape_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_send_rc_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_scratch_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_send_mut_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_bound_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_arg_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_or_return_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_unknown_type_diagnostic_from_source(decls, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_ffi_diagnostic_from_source(decls, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, check_module_infinite_type_diagnostic_from_source(decls, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, check_module_main_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_mustuse_diagnostic_from_source(raw, rp.flat))
                ds = mp.check_module_batch_vis(decls, rp.flat, mp.ufcs_vis_of(rp.flat, rp.regions, rp.table))
                ds.loop((h, i, cd) {
                    a = mp.lsp_push_diag(a, rp, raw, decls, path, text, cd)
                })
                a
            },
        }),
    })
    done.sb.gstr_finish(mp)
}
lsp_publish = (mp: MutPtr<Malloc>, root: StringView, uri: StringView, text: StringView) i64 {
    arr = mp.lsp_diags_array(root, mp.lsp_uri_path(uri), text)
    mp.lsp_send(mp
        .gstr_string(512)
        .gstr_append(mp, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":")
        .push_jstr(mp, uri)
        .gstr_append(mp, ",\"diagnostics\":[")
        .gstr_append(mp, arr)
        .gstr_append(mp, "]}}")
        .gstr_finish(mp))
}
// ── request/notification handlers ─────────────────────────────────────────────────────────────────
lsp_reply_initialize = (mp: MutPtr<Malloc>, body: StringView) i64 {
    mp.lsp_send(mp
        .gstr_string(256)
        .gstr_append(mp, "{\"jsonrpc\":\"2.0\",\"id\":")
        .gstr_append(mp, mp.lsp_id(body))
        .gstr_append(mp, ",\"result\":{\"capabilities\":{\"textDocumentSync\":1,\"definitionProvider\":true,\"hoverProvider\":true,\"documentSymbolProvider\":true,\"completionProvider\":{\"resolveProvider\":false},\"semanticTokensProvider\":{\"legend\":{\"tokenTypes\":")
        .gstr_append(mp, lspt_legend())
        .gstr_append(mp, ",\"tokenModifiers\":[]},\"full\":true}},\"serverInfo\":{\"name\":\"zenc-lsp\",\"version\":\"0.2.0-dev\"}}}")
        .gstr_finish(mp))
}
// ── go-to-definition / hover / completion (the textual query features) ──────────────────────────
// The scanning these share — cursor position → the identifier under it → the FILE's top-level
// declaration of that name — lives in compiler.lsp_query, so all three ask one scanner. Textual
// (ctags-style) rather than resolver-backed: it resolves same-file top-level decls (fn/type/const),
// which is the common jump, and it keeps working on the half-typed buffer an editor actually holds.
// Cross-file targets, locals and overload-precise resolution are the documented next slices.
// reply to a definition request with a Location for def at (line, col) spanning `nlen` bytes, or null.
lsp_reply_location = (
    mp: MutPtr<Malloc>,
    body: StringView,
    uri: StringView,
    line: i64,
    col: i64,
    nlen: i64,
) i64 {
    mp.lsp_send(mp
        .gstr_string(256)
        .gstr_append(mp, "{\"jsonrpc\":\"2.0\",\"id\":")
        .gstr_append(mp, mp.lsp_id(body))
        .gstr_append(mp, ",\"result\":{\"uri\":")
        .push_jstr(mp, uri)
        .gstr_append(mp, ",\"range\":{\"start\":{\"line\":")
        .push_int(mp, line)
        .gstr_append(mp, ",\"character\":")
        .push_int(mp, col)
        .gstr_append(mp, "},\"end\":{\"line\":")
        .push_int(mp, line)
        .gstr_append(mp, ",\"character\":")
        .push_int(mp, col + nlen)
        .gstr_append(mp, "}}}}")
        .gstr_finish(mp))
}
// read a non-negative integer JSON field by key (e.g. position.line / .character).
lsp_json_int = (body: StringView, key: StringView) i64 {
    v: [u8] = body.view()
    p = v.json_find_key(key)
    (p < 0).then({ 0 }, { v.lsp_parse_dec(p, 0) })
}
lsp_parse_dec = (v: [u8], i: i64, acc: i64) i64 {
    (i < v.len && v[i] >= '0' && v[i] <= '9').match ({
        true  => v.lsp_parse_dec(i + 1, acc * 10 + (v[i] - '0').to_i64()),
        false => acc,
    })
}
// the text of `uri` AS THE CLIENT SEES IT: the open buffer when the document is in the store, the
// file on disk otherwise (a jump target the editor never opened). "" = neither, i.e. unreadable.
lsp_doc_text = (mp: MutPtr<Malloc>, uri: StringView) StringView {
    i = lspd_find(uri)
    (i >= 0).match ({
        true  => lspd_text_at(i),
        false => contents_in(mp, mp.lsp_uri_path(uri)).match ({
            .Ok(txt) => txt,
            .Err(er) => "",
        }),
    })
}
// `file://` URI for a filesystem path — the inverse of lsp_uri_path, needed for a jump target the
// client never named (the file of an imported module).
lsp_path_uri = (mp: MutPtr<Malloc>, path: StringView) StringView {
    mp
        .gstr_string(128)
        .gstr_append(mp, "file://")
        .gstr_append(mp, path)
        .gstr_finish(mp)
}
// byte offset of the NAME of the top-level declaration called `name`, or 0. Every decl kind spells
// pos 0 as "synthesized", so 0 doubles as this scan's miss.
lsp_decl_pos = (decls: [Decl], name: StringView) i32 {
    found :: i32 = 0
    decls.loop((h, i, d) {
        p = d.match ({
            .DFunc(f)      => (f.name == name).then({ f.pos }, { 0 }),
            .DForeign(f)   => (f.name == name).then({ f.pos }, { 0 }),
            .DStruct(sd)   => (sd.name == name).then({ sd.pos }, { 0 }),
            .DGenStruct(g) => (g.name == name).then({ g.pos }, { 0 }),
            .DEnum(ed)     => (ed.name == name).then({ ed.pos }, { 0 }),
            .DGenEnum(g)   => (g.name == name).then({ g.pos }, { 0 }),
            .DGlobal(g)    => (g.name == name).then({ g.pos }, { 0 }),
            _              => 0,
        })
        (found == 0).then({
            found = p
        })
    })
    found
}
// a METHOD's declaration, reached through the DImpl record that still carries its ORIGINAL name. The
// parser HOISTS both a trait impl's methods and a type body's INHERENT methods into mangled
// `impl_<Tr>_<Ty>_<m>` functions, so a bare `area` matches no decl name until it is un-mangled — the
// same un-hoisting compiler.pretty_decl does to round-trip a type body.
lsp_method_pos = (mp: MutPtr<Malloc>, decls: [Decl], name: StringView) i32 {
    found :: i32 = 0
    decls.loop((h, i, d) {
        d.match ({
            .DImpl(im) => im.methods.loop((h2, k, m) {
                (found == 0 && m.name == name).then({
                    found = decls.lsp_decl_pos(mp.impl_cname_in(im.trname, im.ty, m.name))
                })
            }),
            _          => { },
        })
    })
    found
}
// resolve `name` THROUGH THE COMPILER and answer with its real file:line:col. The pipeline is the one
// the diagnostics already run: resolve_program_data flattens every imported module into a single
// program, parse_module + resolve_module hand back declarations that each carry the byte offset of
// their own name, and `locate_diag` maps such an offset back to the module it actually came from —
// the identical machinery that puts a cross-module diagnostic in the right file. So "where is this
// declared" is exactly "find the decl, locate its pos", and an imported name, a sibling module's fn
// and a type's inherent method all become reachable; none of them is a column-0 head of the open file.
// false = could not answer (the program does not resolve, or the name is not a positioned
// declaration), and the caller falls back to the textual scan.
lsp_def_via_ast = (
    mp: MutPtr<Malloc>,
    root: StringView,
    body: StringView,
    path: StringView,
    text: StringView,
    name: StringView,
) bool {
    rp = mp.resolve_program_data(root, mp.dirname(path), path, text)
    resolve_failed().then({
        return false
    })
    decls = mp.resolve_module(mp.parse_module(rp.flat))
    off ::= decls.lsp_decl_pos(name)
    (off == 0).then({
        off = mp.lsp_method_pos(decls, name)
    })
    (off == 0).then({
        return false
    })
    dl = rp.locate_diag(off, to_i32(name.view().len), path, text)
    (dl.sp.line <= 0).then({
        return false
    })
    z = lsp_zero_span(dl.sp)
    sv: [u8] = dl.src.view()
    ls = sv.lsp_line_start(z.l)
    zc = sv.lsp_utf16_col(ls, z.c)
    ze = sv.lsp_utf16_col(ls, z.e)
    mp.lsp_reply_location(body, mp.lsp_path_uri(dl.path), z.l, zc, (ze > zc).match ({
        true  => ze - zc,
        false => 1,
    }))
    true
}
// GO-TO-DEFINITION. Two resolvers, in this order:
//
//   1. THROUGH THE COMPILER (lsp_def_via_ast) — the authoritative answer, and the only one that can
//      leave the open file.
//   2. THE TEXTUAL SCAN, when the buffer does not RESOLVE: a half-typed import names no module, so
//      resolution reports and returns instead of producing a program. compiler.lsp_query keeps
//      answering about the intact half of the file, which is what it was written for.
//
// Still answered null, deliberately: struct FIELDS and local bindings. A Field carries no source
// position in compiler.ast.ast_types, so there is nothing to point at — closing that is an AST
// change, not an LSP one.
lsp_definition = (mp: MutPtr<Malloc>, root: StringView, body: StringView) i64 {
    uri = mp.json_str_field(body, "uri")
    txt = mp.lsp_doc_text(uri)
    v: [u8] = txt.view()
    off = v.lsp_byte_of_pos(body.lsp_json_int("line"), body.lsp_json_int("character"), 0, 0)
    s = v.lsp_ident_start(off)
    e = v.lsp_ident_end(off)
    (e <= s).then({
        return mp.lsp_reply_null(body)
    })
    mp.lsp_def_via_ast(root, body, mp.lsp_uri_path(uri), txt, mp.cstr_range(v, s, e)).then({
        return 0
    })
    name: [u8] = v.ptr.offset(s).slice(e - s)
    d = v.lsp_find_def(name, 0, true)
    (d < 0).match ({
        true  => mp.lsp_reply_null(body),
        false => mp.lsp_reply_location(body, uri, v.lsp_line_of(d, 0, 0, 0), v.lsp_col_of(d, 0, 0), e - s),
    })
}
// HOVER: the declaration under the cursor as markdown — a fenced signature plus the doc comment
// above it. compiler.lsp_query decides what that covers; "nothing to say" comes back as "" and is
// answered with a null result, the protocol's own spelling of "no hover here" (never an empty popup).
lsp_hover = (mp: MutPtr<Malloc>, body: StringView) i64 {
    txt = mp.lsp_doc_text(mp.json_str_field(body, "uri"))
    md = mp.lspq_hover(txt, body.lsp_json_int("line"), body.lsp_json_int("character"))
    is_empty(md).then({
        return mp.lsp_reply_null(body)
    })
    mp.lsp_send(mp
        .gstr_string(512)
        .gstr_append(mp, "{\"jsonrpc\":\"2.0\",\"id\":")
        .gstr_append(mp, mp.lsp_id(body))
        .gstr_append(mp, ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":")
        .push_jstr(mp, md)
        .gstr_append(mp, "}}}")
        .gstr_finish(mp))
}
// COMPLETION: the names compiler.lsp_query can see from the buffer alone. `isIncomplete:false` is a
// promise that this IS the whole list for the position, so the client may filter it locally instead
// of asking again on the next keystroke — true here precisely because the list does not depend on
// the prefix being typed.
lsp_completion = (mp: MutPtr<Malloc>, body: StringView) i64 {
    items = mp.lspq_items(mp.lsp_doc_text(mp.json_str_field(body, "uri")))
    sb ::= mp
        .gstr_string(2048)
        .gstr_append(mp, "{\"jsonrpc\":\"2.0\",\"id\":")
        .gstr_append(mp, mp.lsp_id(body))
        .gstr_append(mp, ",\"result\":{\"isIncomplete\":false,\"items\":[")
    items.loop((h, i, it) {
        sb = sb
            .gstr_append(mp, (i > 0).then({ "," }, { "" }))
            .gstr_append(mp, "{\"label\":")
            .push_jstr(mp, it.label)
            .gstr_append(mp, ",\"kind\":")
            .push_int(mp, it.kind)
            .gstr_append(mp, ",\"detail\":")
            .push_jstr(mp, it.detail)
            .gstr_append(mp, "}")
    })
    mp.lsp_send(sb.gstr_append(mp, "]}}").gstr_finish(mp))
}
// ── documentSymbol: the OUTLINE of the open buffer ────────────────────────────────────────────────
// LSP SymbolKind numbers (protocol §DocumentSymbol), spelled once so no call site carries a bare
// integer. Field=8 and EnumMember=22 are absent on purpose: neither a Field nor a VariantDef carries
// a source position in compiler.ast.ast_types, so there is nothing honest to point a range at.
LSP_SK_METHOD = () i64 { 6 }
LSP_SK_ENUM = () i64 { 10 }
LSP_SK_FUNCTION = () i64 { 12 }
LSP_SK_VARIABLE = () i64 { 13 }
LSP_SK_STRUCT = () i64 { 23 }
// 0-based line of byte `off`, walked ITERATIVELY — lsp_line_of recurses once per byte, which a
// definition can afford (one conversion per request) and an outline cannot (four per symbol).
lsp_line_at = (v: [u8], off: i64) i64 {
    ln :: i64 = 0
    zero: i64 = 0
    zero.step_while((i) { i < off && i < v.len }, (i) {
        (v[i] == '\n').then({
            ln = ln + 1
        })
        i + 1
    })
    ln
}
// byte offset of the start of the line `off` sits on.
lsp_bol_at = (v: [u8], off: i64) i64 {
    off.step_while((i) { i > 0 && v[i - 1] != '\n' }, (i) { i - 1 })
}
// one LSP Position for a byte offset. `character` is a UTF-16 code-unit column, not a byte column.
lsp_push_pos = (sb: String, mp: MutPtr<Malloc>, v: [u8], off: i64) String {
    o = (off < v.len).then({ off }, { v.len })
    ls = v.lsp_bol_at(o)
    sb
        .gstr_append(mp, "{\"line\":")
        .push_int(mp, v.lsp_line_at(o))
        .gstr_append(mp, ",\"character\":")
        .push_int(mp, v.lsp_utf16_col(ls, o - ls))
        .gstr_append(mp, "}")
}
lsp_push_range = (sb: String, mp: MutPtr<Malloc>, v: [u8], s: i64, e: i64) String {
    sb
        .gstr_append(mp, "{\"start\":")
        .lsp_push_pos(mp, v, s)
        .gstr_append(mp, ",\"end\":")
        .lsp_push_pos(mp, v, e)
        .gstr_append(mp, "}")
}
// one DocumentSymbol, up to but NOT including its `children` key — the caller closes the object.
// `selectionRange` is exactly the name (what the editor jumps to); `range` runs to `last`, which the
// caller widens to cover nested children. It is NOT the declaration's full source extent: no Decl in
// compiler.ast.ast_types carries an end offset, and inventing one by brace-matching would be a guess.
lsp_push_sym = (
    sb: String,
    mp: MutPtr<Malloc>,
    v: [u8],
    name: StringView,
    kind: i64,
    off: i64,
    last: i64,
) String {
    sb
        .gstr_append(mp, "{\"name\":")
        .push_jstr(mp, name)
        .gstr_append(mp, ",\"kind\":")
        .push_int(mp, kind)
        .gstr_append(mp, ",\"range\":")
        .lsp_push_range(mp, v, off, last)
        .gstr_append(mp, ",\"selectionRange\":")
        .lsp_push_range(mp, v, off, off + name.view().len)
}
// a childless DocumentSymbol.
lsp_leaf_sym = (mp: MutPtr<Malloc>, v: [u8], name: StringView, kind: i64, off: i64) StringView {
    mp
        .gstr_string(192)
        .lsp_push_sym(mp, v, name, kind, off, off + name.view().len)
        .gstr_append(mp, "}")
        .gstr_finish(mp)
}
// the methods of ONE impl record, comma-joined ("" when it declares none that is positioned). The
// name emitted is the one the SOURCE writes: the parser HOISTS both a trait impl's methods and a type
// body's INHERENT methods into mangled `impl_<Tr>_<Ty>_<m>` top-level functions, and that mangled name
// must never reach the client — it supplies the position, the DImpl record supplies the name.
lsp_impl_syms = (mp: MutPtr<Malloc>, decls: [Decl], v: [u8], im: ImplData) StringView {
    sb ::= mp.gstr_string(256)
    n ::= 0
    im.methods.loop((h, k, m) {
        off = to_i64(decls.lsp_decl_pos(mp.impl_cname_in(im.trname, im.ty, m.name)))
        (off > 0).then({
            sb = sb
                .gstr_append(mp, (n > 0).then({ "," }, { "" }))
                .gstr_append(mp, mp.lsp_leaf_sym(v, m.name, LSP_SK_METHOD(), off))
            n = n + 1
        })
    })
    sb.gstr_finish(mp)
}
// every method the file declares FOR type `ty`. A `Type.impl(Trait, { … })` block and a type body's
// inherent methods are both recorded as a DImpl (the inherent one names the type as its own trait),
// so one walk over the impls covers both spellings.
lsp_method_syms = (mp: MutPtr<Malloc>, decls: [Decl], v: [u8], ty: StringView) StringView {
    sb ::= mp.gstr_string(384)
    n ::= 0
    decls.loop((h, i, d) {
        d.match ({
            .DImpl(im) => (im.ty == ty).then({
                one = mp.lsp_impl_syms(decls, v, im)
                (is_empty(one) == false).then({
                    sb = sb.gstr_append(mp, (n > 0).then({ "," }, { "" })).gstr_append(mp, one)
                    n = n + 1
                })
            }),
            _          => { },
        })
    })
    sb.gstr_finish(mp)
}
// the byte the method run of `ty` ends at, or `from` when it has none. A parent's `range` must ENCLOSE
// its children's, so the type symbol's range is stretched to its last method's name.
lsp_methods_end = (mp: MutPtr<Malloc>, decls: [Decl], ty: StringView, from: i64) i64 {
    last ::= from
    decls.loop((h, i, d) {
        d.match ({
            .DImpl(im) => (im.ty == ty).then({
                im.methods.loop((h2, k, m) {
                    off = to_i64(decls.lsp_decl_pos(mp.impl_cname_in(im.trname, im.ty, m.name)))
                    e = off + m.name.view().len
                    (off > 0 && e > last).then({
                        last = e
                    })
                })
            }),
            _          => { },
        })
    })
    last
}
// a TYPE symbol with its methods NESTED as `children` — what makes an outline an outline instead of a
// name list. Its FIELDS are not listed: a Field carries no position (the same AST gap that keeps
// go-to-definition off a field).
lsp_type_sym = (
    mp: MutPtr<Malloc>,
    decls: [Decl],
    v: [u8],
    name: StringView,
    kind: i64,
    off: i64,
) StringView {
    mp
        .gstr_string(384)
        .lsp_push_sym(mp, v, name, kind, off, mp.lsp_methods_end(decls, name, off + name.view().len))
        .gstr_append(mp, ",\"children\":[")
        .gstr_append(mp, mp.lsp_method_syms(decls, v, name))
        .gstr_append(mp, "]}")
        .gstr_finish(mp)
}
// does THIS file declare the type `name`? An impl whose type lives in another file has no parent
// symbol here, so its methods are emitted at top level rather than dropped.
lsp_has_type = (decls: [Decl], name: StringView) bool {
    found ::= false
    decls.loop((h, i, d) {
        d.match ({
            .DStruct(sd)   => (sd.name == name).then({
                found = true
            }),
            .DGenStruct(g) => (g.name == name).then({
                found = true
            }),
            .DEnum(ed)     => (ed.name == name).then({
                found = true
            }),
            .DGenEnum(g)   => (g.name == name).then({
                found = true
            }),
            _              => { },
        })
    })
    found
}
// the DocumentSymbol JSON for one top-level declaration, "" when it is not one. Skipped: import
// records and module aliases (they name another file), trait defaults, raw C escapes, every
// SYNTHESIZED decl (pos 0 — the parser's anonymous-struct shapes and its syntax-error sentinel), and
// every hoisted method function, which is re-emitted under its type instead.
lsp_decl_sym = (mp: MutPtr<Malloc>, decls: [Decl], v: [u8], d: Decl) StringView {
    d.match ({
        .DFunc(f)      => (f.pos == 0 || mp.ff_is_hoisted(decls, f.name)).match ({
            true  => "",
            false => mp.lsp_leaf_sym(v, f.name, LSP_SK_FUNCTION(), to_i64(f.pos)),
        }),
        .DForeign(f)   => (f.pos == 0).match ({
            true  => "",
            false => mp.lsp_leaf_sym(v, f.name, LSP_SK_FUNCTION(), to_i64(f.pos)),
        }),
        .DStruct(sd)   => (sd.pos == 0).match ({
            true  => "",
            false => mp.lsp_type_sym(decls, v, sd.name, LSP_SK_STRUCT(), to_i64(sd.pos)),
        }),
        .DGenStruct(g) => (g.pos == 0).match ({
            true  => "",
            false => mp.lsp_type_sym(decls, v, g.name, LSP_SK_STRUCT(), to_i64(g.pos)),
        }),
        .DEnum(ed)     => (ed.pos == 0).match ({
            true  => "",
            false => mp.lsp_type_sym(decls, v, ed.name, LSP_SK_ENUM(), to_i64(ed.pos)),
        }),
        .DGenEnum(g)   => (g.pos == 0).match ({
            true  => "",
            false => mp.lsp_type_sym(decls, v, g.name, LSP_SK_ENUM(), to_i64(g.pos)),
        }),
        .DGlobal(g)    => (g.pos == 0 || g.alias).match ({
            true  => "",
            false => mp.lsp_leaf_sym(v, g.name, LSP_SK_VARIABLE(), to_i64(g.pos)),
        }),
        .DImpl(im)     => decls.lsp_has_type(im.ty).then({ "" }, { mp.lsp_impl_syms(decls, v, im) }),
        _              => "",
    })
}
// the whole `DocumentSymbol[]` body for `text` — the PARSE of the open buffer, and nothing else. Not
// the resolved program go-to-definition walks: that one flattens every imported module into a single
// decl list, and an outline that listed std's declarations as this document's would be a lie. Parsing
// alone also keeps the outline answering while an import line is half-typed.
lsp_symbols_json = (mp: MutPtr<Malloc>, text: StringView) StringView {
    decls = mp.parse_module(text)
    v: [u8] = text.view()
    sb ::= mp.gstr_string(1024)
    n ::= 0
    decls.loop((h, i, d) {
        one = mp.lsp_decl_sym(decls, v, d)
        (is_empty(one) == false).then({
            sb = sb.gstr_append(mp, (n > 0).then({ "," }, { "" })).gstr_append(mp, one)
            n = n + 1
        })
    })
    sb.gstr_finish(mp)
}
// DOCUMENT SYMBOL (`gO`, and the `]m`/`[m` method motions built on it). Answered from the OPEN
// BUFFER via lsp_doc_text, so an unsaved edit is in the outline the moment it is typed.
lsp_document_symbol = (mp: MutPtr<Malloc>, body: StringView) i64 {
    syms = mp.lsp_symbols_json(mp.lsp_doc_text(mp.json_str_field(body, "uri")))
    mp.lsp_send(mp
        .gstr_string(1024)
        .gstr_append(mp, "{\"jsonrpc\":\"2.0\",\"id\":")
        .gstr_append(mp, mp.lsp_id(body))
        .gstr_append(mp, ",\"result\":[")
        .gstr_append(mp, syms)
        .gstr_append(mp, "]}")
        .gstr_finish(mp))
}
lsp_send_tokens = (mp: MutPtr<Malloc>, body: StringView, data: StringView) i64 {
    mp.lsp_send(mp
        .gstr_string(8192)
        .gstr_append(mp, "{\"jsonrpc\":\"2.0\",\"id\":")
        .gstr_append(mp, mp.lsp_id(body))
        .gstr_append(mp, ",\"result\":{\"data\":")
        .gstr_append(mp, data)
        .gstr_append(mp, "}}")
        .gstr_finish(mp))
}
// Semantic tokens for an OPEN document come from the client's buffer and are memoized against its
// LSP version, so the keystroke that does not change the version (a repeat request, a client that
// re-asks after a scroll) costs a lookup instead of a full lex of the file. A document the client
// has NOT opened is still read from disk — and not cached, since nothing then tells us when it
// changed. `lspd_set` drops the cache on every text write, so a hit can only ever be this text.
lsp_semantic_tokens = (mp: MutPtr<Malloc>, body: StringView) i64 {
    uri = mp.json_str_field(body, "uri")
    i = lspd_find(uri)
    (i >= 0).match ({
        true  => {
            cached = lspd_tokens_at(i)
            data = is_empty(cached).match ({
                true  => {
                    fresh = mp.lspt_tokens(lspd_text_at(i))
                    lspd_cache_tokens(i, fresh)
                    fresh
                },
                false => cached,
            })
            mp.lsp_send_tokens(body, data)
        },
        false => contents_in(mp, mp.lsp_uri_path(uri)).match ({
            .Ok(txt) => mp.lsp_send_tokens(body, mp.lspt_tokens(txt)),
            .Err(er) => mp.lsp_reply_null(body),
        }),
    })
}
lsp_reply_null = (mp: MutPtr<Malloc>, body: StringView) i64 {
    mp.lsp_send(mp
        .gstr_string(96)
        .gstr_append(mp, "{\"jsonrpc\":\"2.0\",\"id\":")
        .gstr_append(mp, mp.lsp_id(body))
        .gstr_append(mp, ",\"result\":null}")
        .gstr_finish(mp))
}
// JSON-RPC MethodNotFound for a REQUEST we don't implement. A request left unanswered stalls the
// client (nvim blocks a hover round-trip until its timeout); the error reply fails it instantly.
lsp_reply_method_not_found = (mp: MutPtr<Malloc>, body: StringView) i64 {
    mp.lsp_send(mp
        .gstr_string(128)
        .gstr_append(mp, "{\"jsonrpc\":\"2.0\",\"id\":")
        .gstr_append(mp, mp.lsp_id(body))
        .gstr_append(mp, ",\"error\":{\"code\":-32601,\"message\":\"method not found\"}}")
        .gstr_finish(mp))
}
// notification families we deliberately swallow WITHOUT a reply (replying to a notification is a
// protocol violation). `id` presence alone is not the test: e.g. workspace/didChangeConfiguration
// params may contain an unrelated "id" key that the flat key scanner would find.
lsp_is_notification = (method: StringView) bool {
    method.lsp_has_prefix("$/")
        || method.lsp_has_prefix("textDocument/did")
        || method.lsp_has_prefix("workspace/did")
        || method == "initialized"
        || method == "exit"
}
// publish an EMPTY diagnostics array for `uri` (didClose: the client keeps stale squiggles otherwise).
lsp_publish_clear = (mp: MutPtr<Malloc>, uri: StringView) i64 {
    mp.lsp_send(mp
        .gstr_string(160)
        .gstr_append(mp, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":")
        .push_jstr(mp, uri)
        .gstr_append(mp, ",\"diagnostics\":[]}}")
        .gstr_finish(mp))
}
// didOpen/didChange (full-sync) both carry the whole document text; the first `text` key is the
// document content (the URI's `text` in didOpen, the single contentChange's `text` in didChange) and
// `version` is the client's monotonic edit counter. Both land in the store — which takes ownership of
// the decoded uri/text and frees the pair they replace — and the publish then reads the text back
// OUT of the store, so diagnostics and highlighting are provably answering about the same bytes.
lsp_did_change = (mp: MutPtr<Malloc>, root: StringView, body: StringView) i64 {
    uri = mp.json_str_field(body, "uri")
    i = lspd_set(uri, mp.json_str_field(body, "text"), body.lsp_json_int("version"))
    mp.lsp_publish(root, uri, lspd_text_at(i))
}
// dispatch one message. Returns 0 = keep serving, 1 = shutdown received, 2 = exit. Unknown
// NOTIFICATIONS are no-ops; an unknown REQUEST (an "id" key outside the notification families) gets
// a MethodNotFound error so the client never waits on a reply that will not come.
lsp_handle = (mp: MutPtr<Malloc>, root: StringView, body: StringView) i32 {
    method = mp.json_str_field(body, "method")
    (method == "initialize").then({
        mp.lsp_reply_initialize(body)
        return 0
    })
    (method == "shutdown").then({
        mp.lsp_reply_null(body)
        return 1
    })
    (method == "exit").then({
        return 2
    })
    (method == "textDocument/didOpen" || method == "textDocument/didChange").then({
        mp.lsp_did_change(root, body)
        return 0
    })
    (method == "textDocument/didClose").then({
        closed = mp.json_str_field(body, "uri")
        lspd_close(closed)
        mp.lsp_publish_clear(closed)
        return 0
    })
    (method == "textDocument/definition").then({
        mp.lsp_definition(root, body)
        return 0
    })
    (method == "textDocument/hover").then({
        mp.lsp_hover(body)
        return 0
    })
    (method == "textDocument/completion").then({
        mp.lsp_completion(body)
        return 0
    })
    (method == "textDocument/documentSymbol").then({
        mp.lsp_document_symbol(body)
        return 0
    })
    (method == "textDocument/semanticTokens/full").then({
        mp.lsp_semantic_tokens(body)
        return 0
    })
    v: [u8] = body.view()
    (v.json_find_key("id") >= 0 && lsp_is_notification(method) == false).then({
        mp.lsp_reply_method_not_found(body)
    })
    0
}
// ── stdio framing: read `Content-Length: N\r\n\r\n` headers, then exactly N body bytes ─────────────
LSP_HDR_CAP = () i64 { 1024 }
// sanity ceiling on a claimed body size (64 MiB). A hostile/corrupt `Content-Length: 100000000000000`
// would otherwise reach acquire(), fail, and null-deref-panic the server; over-limit frames are
// skipped like unparseable ones and the header scan resynchronizes on the next frame.
LSP_BODY_MAX = () i64 { 67108864 }
// read stdin one byte at a time into `buf` until the CRLFCRLF terminator (so we never over-read into
// the body). Returns the header length incl. terminator; 0 on clean EOF before any byte; -1 on error.
lsp_read_headers = (mp: MutPtr<Malloc>, buf: RawPtr<u8>, off: i64) i64 {
    r = read(0, buf.offset(off), 1)
    (r <= 0).match ({
        true  => (off == 0).then({ 0 }, { 0 - 1 }),
        false => (off >= 3
            && load(buf.offset(off - 3)) == '\r'
            && load(buf.offset(off - 2)) == '\n'
            && load(buf.offset(off - 1)) == '\r'
            && load(buf.offset(off)) == '\n').match ({
            true  => off + 1,
            false => (off + 1 >= LSP_HDR_CAP()).match ({
                true  => 0 - 1,
                false => mp.lsp_read_headers(buf, off + 1),
            }),
        }),
    })
}
lsp_match_bytes = (buf: RawPtr<u8>, i: i64, wv: [u8], k: i64) bool {
    (k >= wv.len).match ({
        true  => true,
        false => (load(buf.offset(i + k)) == wv[k]).match ({
            true  => buf.lsp_match_bytes(i, wv, k + 1),
            false => false,
        }),
    })
}
lsp_match_at = (buf: RawPtr<u8>, i: i64, len: i64, word: StringView) bool {
    wv: [u8] = word.view()
    (i + wv.len > len).then({ false }, { buf.lsp_match_bytes(i, wv, 0) })
}
// read a decimal starting at `i` (skipping leading spaces); -1 if no digit before end/non-space.
lsp_read_dec = (buf: RawPtr<u8>, i: i64, len: i64, acc: i64, started: bool) i64 {
    (i >= len).match ({
        true  => started.then({ acc }, { 0 - 1 }),
        false => {
            b = load(buf.offset(i))
            (b >= '0' && b <= '9').match ({
                true  => buf.lsp_read_dec(i + 1, len, acc * 10 + (b - '0').to_i64(), true),
                false => (b == ' ' && started == false).match ({
                    true  => buf.lsp_read_dec(i + 1, len, acc, false),
                    false => started.then({ acc }, { 0 - 1 }),
                }),
            })
        },
    })
}
lsp_content_length = (buf: RawPtr<u8>, i: i64, len: i64) i64 {
    (i >= len).match ({
        true  => 0 - 1,
        false => buf.lsp_match_at(i, len, "Content-Length:").match ({
            true  => buf.lsp_read_dec(i + 15, len, 0, false),
            false => buf.lsp_content_length(i + 1, len),
        }),
    })
}
// read exactly `n` body bytes into `buf` (read() may return short; loop until filled or EOF).
lsp_read_body = (buf: RawPtr<u8>, off: i64, n: i64) i64 {
    (off >= n).match ({
        true  => off,
        false => {
            r = read(0, buf.offset(off), n - off)
            (r <= 0).then({ off }, { buf.lsp_read_body(off + r, n) })
        },
    })
}
// the JSON-RPC stdio loop: frame -> dispatch, until `exit`. Exit code follows the LSP convention:
// 0 if `exit` arrived after `shutdown`, else 1 (also 1 if the stream closes without a clean shutdown).
lsp_cmd* = (mp: MutPtr<Malloc>, root: StringView) i32 {
    hbuf = mp.acquire_or_die(LSP_HDR_CAP())
    shut ::= false
    code ::= 1
    repeat_while((frame) {
        hlen = mp.lsp_read_headers(hbuf, 0)
        (hlen <= 0).match ({
            true  => {
                code = shut.then({ 0 }, { 1 })
                false
            },
            false => {
                n = hbuf.lsp_content_length(0, hlen)
                (n < 0 || n > LSP_BODY_MAX()).match ({
                    true  => true,
                    false => {
                        // ONE REQUEST, ONE SCOPE: the frame buffer, the JSON decode, and the whole
                        // check pipeline the handler runs all allocate inside the scope and are
                        // reclaimed together here. A batch compile may leak — it exits — but this
                        // loop runs that pipeline once per keystroke, where the same non-free is
                        // ~58 MB of growth per edit. Only the document store outlives the scope,
                        // and it owns durable copies (compiler.lsp_docs). `act` is a scalar, so it
                        // survives the reclaim by value.
                        heap_scope_begin()
                        body = mp.acquire_or_die(n + 1)
                        got = body.lsp_read_body(0, n)
                        body.offset(got).store(0)
                        act = mp.lsp_handle(root, cstr(body))
                        heap_scope_end()
                        (act == 1).then({
                            shut = true
                        })
                        (act == 2).match ({
                            true  => {
                                code = shut.then({ 0 }, { 1 })
                                false
                            },
                            false => true,
                        })
                    },
                })
            },
        })
    })
    code
}
