// stdin_echo.zen — the canonical unix filter: read stdin line by line, number and
// upper-case each line ("hello" -> "1: HELLO"), print it, and exit 0 at EOF.
//
//   $ printf 'hello\nworld\n' | zenc run examples/stdin_echo.zen
//   1: HELLO
//   2: WORLD
//
// The whole stdin surface is allocator-explicit (no hidden heap): grab a gpa Heap,
// take its addr(), and thread that MutPtr through every call.
halloc = std.mem.heap
{ lines } = std.io.stdin
{ formatln, arg_int, arg_str } = std.text.fmt
{ to_upper, view } = std.text.str
main = () i32 {
    heap := halloc.gpa()
    a := heap.addr()
    n: i64 := 0
    // `lines` runs the closure once per line (the '\n' is stripped) and returns the
    // line count in a Result. Each `line` buffer is released after the closure returns,
    // so the upper-cased copy we allocate from it we release ourselves.
    total := a.lines((line) {
        n = n + 1
        up := a.to_upper(line)
        formatln("{}: {}", [arg_int(n), arg_str(up)])
        a.release(up.view().ptr)
    })
    // Ok(count) -> success; a read/alloc failure surfaces as Err.
    total.match ({
        .Ok(count) => 0,
        .Err(e)    => 255,
    })
}
