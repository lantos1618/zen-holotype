// AN ARRAY OF STRUCTS COPIES WHOLE, EVERY FIELD, IN ORDER.
//
// `ys ::= xs` is a full copy of the struct that wraps the C array — the
// whole point of the wrapper (gen_c/gen_c_array.zen) — and this file
// checks the copy at the width where a partial one shows: i64 elements,
// values past 2^31, so a backend that copies only 4 bytes per element
// (the int-sized habit from i32 arrays) truncates every value to its low
// half and still prints NUMBERS, just smaller ones.
//
// The read-back is deliberately reversed (3, 2, 1, 0): it forces all four
// elements to have arrived, not just the head — a memcpy of a prefix
// leaves the tail reading as zeros, and zeros are exactly what this
// corpus refuses to accept as an answer.

main = (env: Env) Res<i32, AllocError> {
    xs: [i64, 4] = [1000000007, 2, 998244353, 5];
    ys ::= xs;
    println("{} {} {} {}", ys[3], ys[2], ys[1], ys[0]);
    Ok(0);
}
