// `ignore` says at the call site that a failure is not acted on;
// `without_err` forgets the reason so the one-type-parameter helpers apply.

main = (env: Env) Res<i32, AllocError> {
    failing: Res<u64, str> = Err("no");
    fine: Res<u64, str>    = Ok(3);
    failing.ignore();
    println(
        "without_err on Err falls back {}",
        failing.without_err().value_or(9)
    );
    println("without_err on Ok keeps {}", fine.without_err().value_or(9));
    Ok(0);
}
