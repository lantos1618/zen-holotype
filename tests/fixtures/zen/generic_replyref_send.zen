halloc = std.mem.heap
{ to_exit } = std.core.bool
{ Result, IoError, expect } = std.core.result
{ Context, Receiver, ReplyRef, ActorCell } = std.concurrent.actor
Msg*: Ping(ReplyRef<StringView>)
Room*: {
    n: i32,
}
Room.impl(Receiver, {
    receive = (room: MutPtr<Room>, ctx: Context<Msg>) void {
        ctx.msg.match ({
            .Ping(reply_to) => reply_to.send("done"),
        })
    }
})
main = () i32 {
    alloc := halloc.gpa()
    cell_r: Result<ActorCell<Msg>, IoError> := alloc.addr().cell(4)
    cell := cell_r.expect("gpa cell allocation")
    room := Room(n: 0)
    out_r: Result<StringView, IoError> := cell.request(alloc.addr(), room.addr(), (reply_to) {
        .Ping(reply_to)
    })
    out := out_r.expect("gpa reply allocation")
    cell.free(alloc.addr())
    (out == "done").to_exit()
}
