// compiler.genc_emit_decl — type, signature, function, struct, enum, and top-level decl C-emission.
// Extracted from compiler.genc_emit. Consumes statement/block emission from compiler.genc_emit_expr.
{ String } = std.text.string
{ Decl, Func, Param, Ty, Field, StructDecl, EnumDecl, VariantDef, FnTData, ty_cname_in, gstr_append } = compiler.genc
{ fnt_cname } = compiler.mangle
{ Malloc } = std.mem.alloc
{ slice_any } = compiler.astops
{ gen_block, gen_block_void } = compiler.genc_emit_expr
any_payload = (vs: [VariantDef]) bool {
    found := false
    vs.loop((h, i, v) {
        found = v.payload.match ({
            .Void => found,
            _     => true,
        })
    })
    found
}
gen_ty_list = (s: String, alloc: MutPtr<Malloc>, ts: [Ty]) String {
    out := s
    ts.loop((h, i, t) {
        out = (i == 0).match ({ true => out, false => out.gstr_append(alloc, ", ") })    // comma-separated bare types: `A, B, C`
        out = out.gstr_append(alloc, alloc.ty_cname_in(t))
    })
    out
}
// a function-pointer parameter `RET (*name)(ARG, …)`. Most FnT params are a template's lambda (inlined
// at the call site, never emitted); but an FnT param that survives into a REAL C signature — an extern
// callback like makecontext's `void(*func)()` — must render as an actual function pointer here.
gen_fnptr_param = (s: String, alloc: MutPtr<Malloc>, ft: FnTData, name: string_view) String {
    s
        .gstr_append(alloc, alloc.ty_cname_in(load(ft.ret)))
        .gstr_append(alloc, "(*")
        .gstr_append(alloc, name)
        .gstr_append(alloc, ")(")
        .gen_ty_list(alloc, ft.params)
        .gstr_append(alloc, ")")
}
gen_params = (s: String, alloc: MutPtr<Malloc>, ps: [Param]) String {
    out := s
    ps.loop((h, i, p) {
        out = (i == 0).match ({ true => out, false => out.gstr_append(alloc, ", ") })    // comma between, not before
        out = p.ty.match ({
            .FnT(ft) => out.gen_fnptr_param(alloc, ft, p.name),
            _        => out
                .gstr_append(alloc, alloc.ty_cname_in(p.ty))
                .gstr_append(alloc, " ")
                .gstr_append(alloc, p.name),
        })
    })
    out
}
// emit one function, appending to `s` (so a module can stream several into one buffer)
// The Zen entry `main` is emitted as C `zen_main`; the OS-level `main(argc,argv)` lives in zenrt.c
// (it stashes argv and calls zen_main). Every other function keeps its source name.
c_func_name = (name: string_view) string_view {
    (name == "main").match ({ true => "zen_main", false => name })
}
// `main = (sys: Sys) i32` — the capability entry: exactly one parameter typed `Sys`. When present, the
// user's main is emitted under `zen_user_main` and a NILADIC `zen_main(void)` trampoline (below) calls
// it with `std.sys.root()`, so the C boundary (zenrt.c) stays byte-identical to the `main = () i32` case.
main_is_sys* = (f: Func) bool {
    (f.name == "main").match ({
        true  => (f.params.len == 1).match ({
            true  => f.params[0].ty.match ({
                .Named(nm) => nm == "Sys",
                _          => false,
            }),
            false => false,
        }),
        false => false,
    })
}
// the C function name for `f`: `main` -> `zen_main`, unless it is the `(sys: Sys)` entry, whose user
// body is emitted as `zen_user_main` (the `zen_main` trampoline is appended separately by gen_func).
c_func_name_f = (f: Func) string_view {
    f.main_is_sys().match ({ true => "zen_user_main", false => c_func_name(f.name) })
}
// a function signature `ret name(params)` — shared by the definition and the forward proto
// the C name for a return type: a function-VALUE return (FnT) uses its precise typedef (M1c) so the
// caller can call the result; everything else is the plain C type name.
ret_cname = (alloc: MutPtr<Malloc>, ret: Ty) string_view {
    ret.match ({
        .FnT(ft) => alloc.fnt_cname(ft),
        _        => alloc.ty_cname_in(ret),
    })
}
gen_sig = (s: String, alloc: MutPtr<Malloc>, f: Func) String {
    s
        .gstr_append(alloc, alloc.ret_cname(f.ret))
        .gstr_append(alloc, " ")
        .gstr_append(alloc, c_func_name_f(f))
        .gstr_append(alloc, "(")
        .gen_params(alloc, f.params)
        .gstr_append(alloc, ")")
}
// `typedef Ret (*__fnt_…)(Args);` for every function-RETURN type that is itself a function type, so a
// fn returning a function value has a precise, callable C return type. C11 allows an identical typedef
// to repeat, so no dedup is needed. Emitted after the forward struct typedefs (a fn-pointer typedef may
// reference an as-yet-incomplete struct) and before the prototypes that use it as a return type.
gen_fnt_typedef_ret = (s: String, alloc: MutPtr<Malloc>, ret: Ty) String {
    ret.match ({
        .FnT(ft) => s
            .gstr_append(alloc, "typedef ")
            .gstr_append(alloc, alloc.ty_cname_in(load(ft.ret)))
            .gstr_append(alloc, " (*")
            .gstr_append(alloc, alloc.fnt_cname(ft))
            .gstr_append(alloc, ")(")
            .gen_fnt_params(alloc, ft.params)
            .gstr_append(alloc, "); "),
        _        => s,
    })
}
gen_fnt_typedefs* = (s: String, alloc: MutPtr<Malloc>, decls: [Decl]) String {
    out := s
    decls.loop((h, i, d) {
        out = d.match ({
            .DFunc(f)    => out.gen_fnt_typedef_ret(alloc, f.ret),
            .DForeign(f) => out.gen_fnt_typedef_ret(alloc, f.ret),
            _            => out,
        })
    })
    out
}
gen_func* = (s: String, alloc: MutPtr<Malloc>, f: Func) String {
    out := s.gen_sig(alloc, f)
    f.main_is_sys().match ({
        true  => {
            // `main = (sys: Sys) i32`: emit ONLY the user body as `zen_user_main(Sys sys)` (its own braces,
            // no init prefix). The NILADIC `zen_main` trampoline that inits globals and feeds it the root
            // capability is appended ONCE by genModuleIn (below), where the whole decl list is in scope — so
            // it can name `root` correctly even when std.sys.root was reached through a namespace alias, which
            // renames the module's value decls (`root` -> `<alias>__root`). zenrt.c calls `zen_main()`
            // unchanged — the C boundary never sees `Sys`.
            out = out.gstr_append(alloc, " ")
            out = out.gen_func_body(alloc, f)
        },
        false => (f.name == "main").match ({
            true  => {
                out = out.gstr_append(alloc, " { zen__init_globals(); ")
                out = out.gen_func_body(alloc, f)
                out = out.gstr_append(alloc, " }")
            },
            false => {
                out = out.gstr_append(alloc, " ")
                out = out.gen_func_body(alloc, f)
            },
        }),
    })
    out
}
gen_func_body = (s: String, alloc: MutPtr<Malloc>, f: Func) String {
    // Use `s` EXACTLY ONCE: gen_block reallocs s's buffer (freeing the old pointer), so the previous
    // form (out := s.gen_block(...); then for Void out = s.gen_block_void(...)) reused a freed `s`
    // (heap-use-after-free) for every void function whose body grows the output buffer.
    rt: Ty := f.ret
    rt.match ({
        .Void => s.gen_block_void(alloc, f.body),
        _     => s.gen_block(alloc, f.body),
    })
}
// a forward declaration so a function may call one defined later (mutual / out-of-order recursion)
gen_proto* = (s: String, alloc: MutPtr<Malloc>, d: Decl) String {
    out := s
    (d.is_template() == false).then({
        d.match ({
            .DFunc(f)    => {
                out = out.gen_sig(alloc, f).gstr_append(alloc, "; ")
            },
            .DForeign(f) => {
                out = out.gen_sig(alloc, f).gstr_append(alloc, "; ")
            },
            _            => { },
        })
    })
    out
}
// emit a struct typedef: `typedef struct { int32_t x; int32_t y; } Point;`
// the C arg list of a function type: `i32, i32` (empty -> `void`).
gen_fnt_params = (s: String, alloc: MutPtr<Malloc>, ps: [Ty]) String {
    out := s
    ps.loop((h, i, p) {
        out = (i == 0).match ({ true => out, false => out.gstr_append(alloc, ", ") })
        out = out.gstr_append(alloc, alloc.ty_cname_in(p))
    })
    (ps.len == 0).match ({ true => out.gstr_append(alloc, "void"), false => out })
}
// a struct field declaration. A function-VALUE field (FnT) is emitted as a precise C function-pointer
// declarator `Ret (*name)(Args)` — so the field is natively callable and a same-signature function or
// lifted lambda assigns to it with no cast (M1 closures, non-capturing). All other fields are `T name`.
gen_field_decl = (s: String, alloc: MutPtr<Malloc>, fld: Field) String {
    fld.ty.match ({
        .FnT(ft) => s
            .gstr_append(alloc, alloc.ty_cname_in(load(ft.ret)))
            .gstr_append(alloc, " (*")
            .gstr_append(alloc, fld.name)
            .gstr_append(alloc, ")(")
            .gen_fnt_params(alloc, ft.params)
            .gstr_append(alloc, "); "),
        _        => s
            .gstr_append(alloc, alloc.ty_cname_in(fld.ty))
            .gstr_append(alloc, " ")
            .gstr_append(alloc, fld.name)
            .gstr_append(alloc, "; "),
    })
}
gen_struct* = (s: String, alloc: MutPtr<Malloc>, sd: StructDecl) String {
    open := s.gstr_append(alloc, "struct ").gstr_append(alloc, sd.name).gstr_append(alloc, " { ")
    sd.fields.loop((h, i, fld) {
        open = open.gen_field_decl(alloc, fld)
    })
    open.gstr_append(alloc, "};")
}
// emit an enum's union members (the payload-carrying variants) and tag constants
gen_union = (s: String, alloc: MutPtr<Malloc>, vs: [VariantDef]) String {
    u := s.gstr_append(alloc, " union { ")
    vs.loop((h, i, v) {
        v.payload.match ({
            .Void => { },
            _     => {
                u = u
                    .gstr_append(alloc, alloc.ty_cname_in(v.payload))
                    .gstr_append(alloc, " ")
                    .gstr_append(alloc, v.name)
                    .gstr_append(alloc, "; ")
            },
        })
    })
    u.gstr_append(alloc, "} u;")
}
gen_tags = (s: String, alloc: MutPtr<Malloc>, ename: string_view, vs: [VariantDef]) String {
    e := s.gstr_append(alloc, " enum { ")
    vs.loop((h, i, v) {
        e = (i == 0).match ({ true => e, false => e.gstr_append(alloc, ", ") })
        e = e.gstr_append(alloc, ename).gstr_append(alloc, "_").gstr_append(alloc, v.name)
    })
    e.gstr_append(alloc, " };")
}
// emit an enum (tagged union): `typedef struct { int32_t tag; union { … } u; } E; enum { E_A, … };`
gen_enum* = (s: String, alloc: MutPtr<Malloc>, ed: EnumDecl) String {
    out := s
        .gstr_append(alloc, "struct ")
        .gstr_append(alloc, ed.name)
        .gstr_append(alloc, " { int32_t tag;")
    any_payload(ed.variants).then({
        out = out.gen_union(alloc, ed.variants)
    })
    out.gstr_append(alloc, " };").gen_tags(alloc, ed.name, ed.variants)
}
// is struct `name` impl'd anywhere (appears as a DImpl.trname)? A trait IS impl'd; a data struct
// holding function-VALUE (closure) fields is NOT — that's how the emitter tells a closure record apart
// from a trait, since both are "structs with FnT fields" by shape.
struct_is_impld = (decls: [Decl], name: string_view) bool {
    decls.slice_any((d) {
        d.match ({
            .DImpl(im) => im.trname == name,
            _          => false,
        })
    })
}
// a trait-shaped struct (FnT fields) is treated as a trait — skipped in codegen — ONLY when it is an
// actual trait (impl'd somewhere). A never-impl'd FnT-field struct is a closure record and IS emitted.
emit_is_trait* = (decls: [Decl], d: Decl) bool {
    d.is_trait().match ({
        true  => d.match ({
            .DStruct(sd) => decls.struct_is_impld(sd.name),
            _            => false,
        }),
        false => false,
    })
}
// forward-declare a struct/enum tag so recursive types compile: `typedef struct N N;`
gen_fwd* = (s: String, alloc: MutPtr<Malloc>, decls: [Decl], d: Decl) String {
    out := s
    (decls.emit_is_trait(d) == false).then({
        d.match ({
            .DStruct(sd) => {
                out = out
                    .gstr_append(alloc, "typedef struct ")
                    .gstr_append(alloc, sd.name)
                    .gstr_append(alloc, " ")
                    .gstr_append(alloc, sd.name)
                    .gstr_append(alloc, "; ")
            },
            .DEnum(ed)   => {
                out = out
                    .gstr_append(alloc, "typedef struct ")
                    .gstr_append(alloc, ed.name)
                    .gstr_append(alloc, " ")
                    .gstr_append(alloc, ed.name)
                    .gstr_append(alloc, "; ")
            },
            _            => { },
        })
    })
    out
}
// emit a top-level declaration (a function, a struct, an enum, or verbatim C)
gen_decl* = (s: String, alloc: MutPtr<Malloc>, d: Decl) String {
    out := s
    d.match ({
        .DFunc(f)    => {
            out = out.gen_func(alloc, f)
        },
        .DStruct(sd) => {
            out = out.gen_struct(alloc, sd)
        },
        .DEnum(ed)   => {
            out = out.gen_enum(alloc, ed)
        },
        .DRaw(c)     => {
            out = out.gstr_append(alloc, c)
        },
        _            => { },
    })
    out
}
