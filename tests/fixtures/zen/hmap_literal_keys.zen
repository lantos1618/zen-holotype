// Untyped int literals at HMap<i64, str> call sites must COERCE to the pinned K=i64, not rebind
// K to i32 (which hashed i64 keys with impl_Hash_i32_hash — silent .None lookups; the fixture's
// values are the flip-proof for that bug).
hm = std.collections.hmap
{ println } = std.text.fmt
halloc = std.mem.heap
main = () i32 {
    alloc = halloc.gpa()
    a = alloc.addr()
    k1: i64 = 1
    m ::= hm.of(a, k1, "one").expect("of")    // pins HMap<i64, str>
    m = m.put(a, 2, "two").expect("put")    // literal key in non-first arg position
    m = m.put(a, 3, "three").expect("put")
    m.get(2).match ({
        .Some(v) => println(v),    // two
        .None    => println("WRONG none for 2"),
    })
    m.get(k1).match ({
        .Some(v) => println(v),    // one
        .None    => println("WRONG none for 1"),
    })
    println(m.get_or(3, "missing"))    // three
    println(m.len())    // 3
    // mixed literal key + typed value var in one call
    v4 = "four"
    m = m.put(a, 4, v4).expect("put4")
    println(m.get_or(4, "missing"))    // four
    // an EXPLICITLY i32-keyed map keeps working with literal keys
    k32: i32 = 10
    n ::= hm.of(a, k32, "ten").expect("of32")
    n = n.put(a, 20, "twenty").expect("put32")
    println(n.get_or(20, "missing"))    // twenty
    println(n.get_or(10, "missing"))    // ten
    println(n.len())    // 2
    m.free(a)
    n.free(a)
    0
}
