// src/gen/gen_c/gen_c_widen.zen
// A VALUE REACHING A TYPE WIDER THAN ITS OWN: a MEMBER reaching a set,
// or a `Res` reaching a `Res` with a wider error set. Both are paid for
// the same way — BUILD the wider value rather than assign the narrower
// one — so they share this file.
//
// The set half moved here from `gen_c_expr.zen`, which had grown two
// subjects: what an expression IS, and what it becomes on the way
// somewhere. `expr` still asks both in order; the answers live here.
//
// ---------------------------------------------------------------------
// widening a `Res` ANYWHERE THAT IS NOT A `return`
//
// "The error type of a `Res` is a union, and propagation merges sets"
// (DESIGN.md, Errors). `gen_c_try.zen` pays for it via `.try()`. A match
// pays for it too: its arms deliver into ONE shared temporary declared
// at the merged type —
//
//     (n > 1).match({ true => fails(n), false => faults(n) })
//
// — and `Res<(), AllocError>` vs `Res<(), AllocError | Fault>` are
// different C structs, so `cc` rejected programs sema had admitted.
//
// A WIDENING IS A REBUILD, AND THE REBUILD ALREADY EXISTS.
// `gen_c_bound.convert` rebuilds a `Res` variant by variant (tag,
// success payload, error payload) because no two `Res` instantiations
// are guaranteed to share a layout. This file decides WHEN to widen;
// `convert` decides HOW — one layout decision, not two.
//
// NARROW ON PURPOSE. Only what `convert` can actually build is claimed:
// same forms, same success payload, error unchanged or ONE MEMBER
// reaching a structural set. A set reaching a WIDER set is a re-tagging
// (the two number their members differently) — that's a statement, not
// an expression, and costs `gen_c_try.write_retag`. Claiming it here
// would emit the wrong member number: a silent wrong value at runtime.
// So instead it falls through to a bare assignment `cc` refuses — a
// report, not a miscompilation.

Ast, Expr, ExprId = std.ast
Alloc, AllocError = std.mem
str, String = std.text
TyId, Ty, Types, TyRes, ResForm = sema.sema_ty
Checker, Ctx = sema.sema_check
is_failure = gen.gen_name
CBackend = gen.gen_c.gen_c_state

expr, ty_of, value_expr = gen.gen_c.gen_c_expr
convert = gen.gen_c.gen_c_bound
ctype = gen.gen_c.gen_c_type
sym_union_variant, sym_union_member = gen.gen_name
has_var = sema.sema_inst

// Does this value have to be REBUILT to reach the `Res` that is wanted?
needs_widen* = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId)
               Res<bool, AllocError> {
    be.check.types.at(want).match({
        Res(w) => widens_into(be, id, ctx, want, w),
        _      => Ok(false),
    })
}

// A TYPE NOBODY HAS COMPUTED IS NOT WIDENED (same reason as
// `gen_c_hoist.zen`): an `Unknown` or still-open answer says nothing
// about the value, so rebuilding on it would invent a conversion.
widens_into = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId, w: TyRes)
              Res<bool, AllocError> {
    unknown = be.check.types.unknown().try();
    cty = ty_of(be, id, ctx, unknown).try();
    settled(be, cty).match({
        false => Ok(false),
        true  => Ok(res_widens(be, cty, want, w)),
    })
}

settled = (be :: CBackend, cty: TyId) bool {
    (be.check.is_unknown(cty) || has_var(be.check, cty)) == false
}

res_widens = (be :: CBackend, cty: TyId, want: TyId, w: TyRes) bool {
    cty.eq(want).match({
        true  => false,
        false => res_parts_widen(be, cty, w),
    })
}

res_parts_widen = (be :: CBackend, cty: TyId, w: TyRes) bool {
    be.check.types.at(cty).match({
        Res(g) => parts_widen(be, g, w),
        _      => false,
    })
}

// THE SUCCESS PAYLOAD MUST ALREADY AGREE — this file widens the ERROR
// set only. `Res<u8, E>` reaching `Res<T, E>` is erasure's question
// (`gen_c_bound.zen`, with the instantiation in hand); here there is
// none, so the two success payloads must already be one type.
parts_widen = (be :: CBackend, g: TyRes, w: TyRes) bool {
    (is_failure(g.form) == is_failure(w.form)) && g.value.eq(w.value)
        && error_widens(be, g, w)
}

// An absence carries no error, so its `error` slot is the unit type and
// comparing it says nothing — the two `Res`es differ in their success
// payload or not at all, and `parts_widen` has already answered that.
error_widens = (be :: CBackend, g: TyRes, w: TyRes) bool {
    is_failure(g.form).match({
        false => false,
        true  => member_reaches_set(be, g.error, w.error),
    })
}

// ONE MEMBER REACHING A SET, never a set reaching a wider one (see
// header). `set_has` is sema's own containment test — the one that
// admitted the program — so asking it again cannot disagree.
member_reaches_set = (be :: CBackend, got: TyId, want: TyId) bool {
    (got.eq(want) == false) && (is_set(be, got) == false)
        && is_set(be, want) && be.check.types.set_has(want, got)
}

is_set = (be :: CBackend, ty: TyId) bool {
    be.check.types.at(ty).match({ Union(_) => true, _ => false })
}

// THE VALUE AT ITS OWN TYPE, THEN REBUILT AT THE WANTED ONE. Lowering
// at `want` directly would ask the value to be something it is not;
// `convert` spills it into a temporary and reads the tag and payload
// off that, so the value is read three times without being evaluated
// three times.
widen_expr* = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId,
               out :: String) Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    cty = ty_of(be, id, ctx, unknown).try();
    code ::= be.alloc.String().try();
    expr(be, id, ctx, cty, code).try();
    convert(be, code.view(), cty, want, out)
}

// ---------------------------------------------------------------------
// a member reaching a SET
//
// The older shape: `Err(AllocError.OutOfMemory)` inside a
// `Res<(), AllocError | Fault>` is a member written where the set is
// wanted; sema admits it because "a union target accepts any of its
// members". Without this it emitted as a bare member assignment into
// the set's struct — no tag, wrong type, `cc` rejecting an unreported
// program.
// ---------------------------------------------------------------------

// A value whose own type is a MEMBER of the wanted set, not the set
// itself — a value already at the set's type is a copy and needs
// nothing.
needs_set* = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId)
            Res<bool, AllocError> {
    be.check.types.at(want).match({
        Union(_) => member_reaches_set(be, id, ctx, want),
        _        => Ok(false),
    })
}

member_reaches_set = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId)
                     Res<bool, AllocError> {
    unknown = be.check.types.unknown().try();
    cty = ty_of(be, id, ctx, unknown).try();
    Ok(settled_member(be, cty, want));
}

// `set_has` answers TRUE for an unsubstituted type parameter (`sema_ty`:
// a set nobody has computed cannot be said to be absent) — right for a
// containment CHECK, wrong here since there is no C value to tag, so
// it's asked past.
settled_member = (be: CBackend, cty: TyId, want: TyId) bool {
    (be.check.is_unknown(cty) == false) && (cty.eq(want) == false)
        && is_named_or_res(be, cty) && be.check.types.set_has(want, cty)
}

is_named_or_res = (be: CBackend, cty: TyId) bool {
    be.check.types.at(cty).match({
        Named(_) => true,
        Res(_)   => true,
        _        => false,
    })
}

// The value at ITS OWN type, then the set built around it — lowering it
// at the set would ask for the member to already be one.
set_expr* = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId,
             out :: String) Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    cty = ty_of(be, id, ctx, unknown).try();
    code ::= be.alloc.String().try();
    value_expr(be, id, ctx, cty, code).try();
    write_set_value(be, code.view(), cty, want, out)
}

// The set, tagged with the member the value IS and carrying it
// unchanged. Exported because `.try()` widening builds the same value
// out of a different piece of C — the two are one layout decision and
// must not be written twice.
write_set_value* = (be :: CBackend, code: str, member: TyId, set: TyId,
                    out :: String) Res<(), AllocError> {
    out.add_bytes("(").try();
    ctype(be, set, out).try();
    out.add_bytes("){ .zg_tag = ").try();
    sym_union_variant(out, be.types(), be.world(), set, member).try();
    out.add_bytes(", .zg_data.").try();
    sym_union_member(out, be.types(), be.world(), member).try();
    out.add_bytes(" = ").try();
    out.add_bytes(code).try();
    out.add_bytes(" }").try();
    Ok(());
}
