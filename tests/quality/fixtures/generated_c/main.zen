Box<T> = {
    value: T
}

Choice = Number(i32) | Empty

score = (choice: Choice) i32 {
    choice.match({
        Number(value) => value,
        Empty => 0,
    });
}

main = (env: Env) Res<i32, AllocError> {
    boxed = Box(value: Choice.Number(21));
    println("generated C score: {}", score(boxed.value));
    Ok(0);
}
