// A raw pointer remains non-transferable when it sits inside a stored field.

PointerBox = { data: Ptr<u8> }

Worker = {}

Worker.impl(Actor, {
    process = (self :: @Self, ctx: Context, payload: PointerBox) {
        ctx.env.out.println("received")
    }
})

forward = (worker: Ref<Worker>, payload: PointerBox) Res<(), ActorError> {
    worker.process(payload).try();
    Ok(())
}

main = (env: Env) Res<i32, AllocError> { Ok(0) }
