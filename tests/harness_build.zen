// tests/harness_build.zen — BUILD category for the Zen-native correctness harness: the self-hosted
// replacement for tests/test_build.py (the 3728-line pytest that drives `zenc build`/`run`/`check`
// against real fixture programs). NO Python: this file declares fixture cases as Zen data and a
// CUSTOM runner drives the committed `zenc` binary via std.io, asserting exit code and/or stdout.
//
// ── THE CUSTOM RUNNER (why it differs from harness_lib.run_value) ──────────────────────────────────
// run_value compiles a tiny `test*` snippet through tests/harness_runner.c and compares a printed int.
// A BUILD fixture is a whole `main = () i32 { … }` program: we `zenc build <path> -o $ZT/zob`, run the
// binary, and assert its EXIT CODE and (optionally) its STDOUT. The exit code is captured by embedding
// `test "$?" -eq <want_exit>` in the shell command — `std.io.file.shell` returns the system(3) wait
// status (exit<<8), not the raw code, so we let the shell do the comparison and check rc==0 instead.
//
// FixtureCase { path, want_exit, want_out, check_out }:
//   path      relative-to-ROOT path of the .zen program (the harness runs from the repo root).
//   want_exit decimal STRING of the expected process exit code (string so it interpolates into the
//             shell `test` command without an int→str conversion).
//   want_out  exact expected stdout bytes (with embedded "\n"); only asserted when check_out is true.
//   check_out true => also assert stdout equals want_out; false => assert exit code only.
//
// For `zenc check` accept/reject fixtures we reuse harness_lib.run_verdict on the fixture SOURCE.
{ Malloc, malloc, free } = std.mem.alloc
{ out, save, contents_in, shell } = std.io.file
{ len, contains, is_empty, starts_with } = std.text.str
{ new_in, append_in, finish_in } = std.text.string
{ VerdictCase, run_verdict, run_verdicts, DiagCase, run_diags, zo_path, zo_cmd, zo_par_run,
  zo_idpath, zo_join } = harness_lib
// a BUILD fixture: build the program, run it, assert exit code (+ optional stdout).
FixtureCase*: {
    path: string_view,
    want_exit: string_view,
    want_out: string_view,
    check_out: bool,
}
// an EMIT case: `zenc emit <path>` must emit C containing every `present` string and none of `absent`.
EmitCase*: {
    path: string_view,
    present: [string_view],
    absent: [string_view],
}
// a DOC case: `zenc doc <target>` must succeed (exit 0), its markdown containing every `present` string
// and none of `absent` (target = a `std.x.y` module name OR a `file.zen` path, both relative to ROOT).
DocCase*: {
    target: string_view,
    present: [string_view],
    absent: [string_view],
}
// a SHELL case: a self-contained `/bin/sh` pipeline that encodes a whole procedural test (project mode,
// fmt idempotency, --help/--version, bad-file, cross-module sibling diagnostics, emit byte-equality). It
// must exit 0 iff the test passes — every assertion is a `&&`-chained command / `test`/`grep -F` check.
ShellCase*: {
    name: string_view,
    cmd: string_view,
}
// helper: build the command body  `./zen build <path> -o $ZT/zob 2>/dev/null` (wrapped by zo_cmd).
build_cmd = (mp: MutPtr<Malloc>, path: string_view) string_view {
    s := mp.new_in().expect("harness: oom")
    s = s.append_in(mp, "./zen build ").expect("harness: oom")
    s = s.append_in(mp, path).expect("harness: oom")
    s = s.append_in(mp, " -o $ZT/zob 2>/dev/null").expect("harness: oom")
    mp.finish_in(s).expect("harness: oom")
}
// helper: build the command body  `$ZT/zob > $ZT/zob_out.txt 2>/dev/null; test "$?" -eq <want_exit>`
// (returns rc 0 iff the program's exit code equals want_exit; stdout is left in $ZT/zob_out.txt).
run_cmd = (mp: MutPtr<Malloc>, want_exit: string_view) string_view {
    s := mp.new_in().expect("harness: oom")
    s = s
        .append_in(mp, "$ZT/zob > $ZT/zob_out.txt 2>/dev/null; test \"$?\" -eq ")
        .expect("harness: oom")
    s = s.append_in(mp, want_exit).expect("harness: oom")
    mp.finish_in(s).expect("harness: oom")
}
// run ONE build fixture: build must succeed, then exit code (+ optional stdout) must match.
run_fixture* = (fc: FixtureCase) bool {
    m := Malloc(_: 0)
    mp := m.addr()
    save(mp.zo_path("zob_out.txt"), "", 0)
    bc := shell(mp.zo_cmd(mp.build_cmd(fc.path))).expect("harness: shell")
    (bc == 0).match ({
        true  => {
            rc := shell(mp.zo_cmd(mp.run_cmd(fc.want_exit))).expect("harness: shell")    // `zenc build` must succeed
            (rc == 0).match ({
                true  => fc.check_out.match ({
                    true  => mp.contents_in(mp.zo_path("zob_out.txt")).match ({
                        .Ok(got) => got == fc.want_out,    // exit code mismatch => fail
                        .Err(e)  => false,
                    }),
                    false => true,
                }),
                false => false,
            })
        },
        false => false,
    })
}    // exit-only fixture: matched
// ── PARALLEL build/emit/doc runners (dogfoods std.thread via harness_lib's zo_par_run) ─────────────
// Same three-phase shape as harness_lib's parallel runners: build a self-contained per-case command that
// writes gid-namespaced result file(s) (each `zenc build/run` gets its OWN output binary `zob<gid>` and
// stdout `zobout<gid>` — the serial runner reused fixed `zob`/`zob_out.txt`, fatal under parallelism),
// run the batch across the worker pool, then compare IN ORDER — byte-identical verdict to serial.
// (run_shells stays SERIAL: its cases are hand-written `$ZT` pipelines with shared scratch names.)
// PHASE A command: only the heavy `zenc build` (cc). Parallel-safe — a compile spawns no app threads.
// The program is NOT run here: many build fixtures are CONCURRENCY/pool acceptance programs that spawn
// their OWN pthreads, so running 16 at once oversubscribes threads and fails nondeterministically.
fix_build_cmd = (mp: MutPtr<Malloc>, gid: i64, fc: FixtureCase) string_view {
    z: string_view := ""
    zob := mp.zo_idpath("zob", gid, "")
    brc := mp.zo_idpath("zobbrc", gid, ".txt")
    mp.zo_join([z, "if ./zen build ", fc.path, " -o ", zob, " 2>/dev/null; then echo P > ", brc, "; else echo F > ", brc, "; fi"])
}
// PHASE B (SERIAL, one fixture at a time): the build must have succeeded, then RUN the binary now (serially
// — no thread oversubscription) and assert exit == want_exit (+ optional stdout). Same verdict as serial.
fix_run_ok = (mp: MutPtr<Malloc>, gid: i64, fc: FixtureCase) bool {
    built := mp.contents_in(mp.zo_idpath("zobbrc", gid, ".txt")).match ({
        .Ok(s)  => s.starts_with("P"),
        .Err(e) => false,
    })
    built.match ({
        true  => {
            z: string_view := ""
            zob := mp.zo_idpath("zob", gid, "")
            o := mp.zo_idpath("zobout", gid, ".txt")
            rc := shell(mp.zo_join([z, zob, " > ", o, " 2>/dev/null; test \"$?\" -eq ", fc.want_exit])).expect("harness: shell")
            (rc == 0).match ({
                true  => fc.check_out.match ({
                    true  => mp.contents_in(mp.zo_idpath("zobout", gid, ".txt")).match ({
                        .Ok(got) => got == fc.want_out,
                        .Err(e)  => false,
                    }),
                    false => true,
                }),
                false => false,
            })
        },
        false => false,
    })
}
// batch BUILD runner + reporter: build the fixtures IN PARALLEL (the cc-heavy step), then run+check them
// SERIALLY (thread-spawning concurrency fixtures must not be oversubscribed). Byte-identical verdict.
run_fixtures* = (name: string_view, cs: [FixtureCase]) i32 {
    out(name)
    out("\n")
    m := Malloc(_: 0)
    mp := m.addr()
    n := cs.len
    base := malloc(n * 8)
    cmds: [string_view] := base.slice(n)
    cs.loop((h, i, c) {
        cmds[i] = mp.fix_build_cmd(i, c)
    })
    zo_par_run(cmds, n)
    fails := 0
    cs.loop((h, i, c) {
        mp.fix_run_ok(i, c).match ({
            true  => out("."),
            false => {
                out("F")
                fails = fails + 1
            },
        })
    })
    out("\n")
    free(base)
    fails
}
// helper: build a one-arg command  `./zen <verb> <path> <redirect>`
cmd_for = (
    mp: MutPtr<Malloc>,
    verb: string_view,
    path: string_view,
    redirect: string_view,
) string_view {
    s := mp.new_in().expect("harness: oom")
    s = s.append_in(mp, "./zen ").expect("harness: oom")
    s = s.append_in(mp, verb).expect("harness: oom")
    s = s.append_in(mp, " ").expect("harness: oom")
    s = s.append_in(mp, path).expect("harness: oom")
    s = s.append_in(mp, redirect).expect("harness: oom")
    mp.finish_in(s).expect("harness: oom")
}
// check every `present` substring is in `txt` and every `absent` substring is NOT — return the AND.
all_present_absent = (txt: string_view, present: [string_view], absent: [string_view]) bool {
    ok := true
    present.loop((h, i, s) {
        (txt.contains(s) == false).then({
            ok = false
        })
    })
    absent.loop((h, i, s) {
        txt.contains(s).then({
            ok = false
        })
    })
    ok
}
// run ONE emit case: `zenc emit` must succeed and the C must satisfy present/absent.
run_emit* = (ec: EmitCase) bool {
    m := Malloc(_: 0)
    mp := m.addr()
    rc := shell(mp.zo_cmd(mp.cmd_for("emit", ec.path, " > $ZT/zoe_emit.c 2>/dev/null"))).expect("harness: shell")
    (rc == 0).match ({
        true  => mp.contents_in(mp.zo_path("zoe_emit.c")).match ({
            .Ok(txt) => all_present_absent(txt, ec.present, ec.absent),
            .Err(e)  => false,
        }),
        false => false,
    })
}
emit_cmd = (mp: MutPtr<Malloc>, gid: i64, ec: EmitCase) string_view {
    z: string_view := ""
    c := mp.zo_idpath("zoeemit", gid, ".c")
    rc := mp.zo_idpath("zoeemitrc", gid, ".txt")
    mp.zo_join([z, "if ./zen emit ", ec.path, " > ", c, " 2>/dev/null; then echo P > ", rc, "; else echo F > ", rc, "; fi"])
}
emit_ok = (mp: MutPtr<Malloc>, gid: i64, ec: EmitCase) bool {
    passed := mp.contents_in(mp.zo_idpath("zoeemitrc", gid, ".txt")).match ({
        .Ok(s)  => s.starts_with("P"),
        .Err(e) => false,
    })
    passed.match ({
        true  => mp.contents_in(mp.zo_idpath("zoeemit", gid, ".c")).match ({
            .Ok(txt) => all_present_absent(txt, ec.present, ec.absent),
            .Err(e)  => false,
        }),
        false => false,
    })
}
run_emits* = (name: string_view, cs: [EmitCase]) i32 {
    out(name)
    out("\n")
    m := Malloc(_: 0)
    mp := m.addr()
    n := cs.len
    base := malloc(n * 8)
    cmds: [string_view] := base.slice(n)
    cs.loop((h, i, c) {
        cmds[i] = mp.emit_cmd(i, c)
    })
    zo_par_run(cmds, n)
    fails := 0
    cs.loop((h, i, c) {
        mp.emit_ok(i, c).match ({
            true  => out("."),
            false => {
                out("F")
                fails = fails + 1
            },
        })
    })
    out("\n")
    free(base)
    fails
}
// run ONE doc case: `zenc doc <target>` must exit 0 and the markdown must satisfy present/absent.
run_doc* = (dc: DocCase) bool {
    m := Malloc(_: 0)
    mp := m.addr()
    rc := shell(mp.zo_cmd(mp.cmd_for("doc", dc.target, " > $ZT/zoe_doc.txt 2>&1"))).expect("harness: shell")
    (rc == 0).match ({
        true  => mp.contents_in(mp.zo_path("zoe_doc.txt")).match ({
            .Ok(txt) => all_present_absent(txt, dc.present, dc.absent),
            .Err(e)  => false,
        }),
        false => false,
    })
}
doc_cmd = (mp: MutPtr<Malloc>, gid: i64, dc: DocCase) string_view {
    z: string_view := ""
    f := mp.zo_idpath("zoedoc", gid, ".txt")
    rc := mp.zo_idpath("zoedocrc", gid, ".txt")
    mp.zo_join([z, "if ./zen doc ", dc.target, " > ", f, " 2>&1; then echo P > ", rc, "; else echo F > ", rc, "; fi"])
}
doc_ok = (mp: MutPtr<Malloc>, gid: i64, dc: DocCase) bool {
    passed := mp.contents_in(mp.zo_idpath("zoedocrc", gid, ".txt")).match ({
        .Ok(s)  => s.starts_with("P"),
        .Err(e) => false,
    })
    passed.match ({
        true  => mp.contents_in(mp.zo_idpath("zoedoc", gid, ".txt")).match ({
            .Ok(txt) => all_present_absent(txt, dc.present, dc.absent),
            .Err(e)  => false,
        }),
        false => false,
    })
}
run_docs* = (name: string_view, cs: [DocCase]) i32 {
    out(name)
    out("\n")
    m := Malloc(_: 0)
    mp := m.addr()
    n := cs.len
    base := malloc(n * 8)
    cmds: [string_view] := base.slice(n)
    cs.loop((h, i, c) {
        cmds[i] = mp.doc_cmd(i, c)
    })
    zo_par_run(cmds, n)
    fails := 0
    cs.loop((h, i, c) {
        mp.doc_ok(i, c).match ({
            true  => out("."),
            false => {
                out("F")
                fails = fails + 1
            },
        })
    })
    out("\n")
    free(base)
    fails
}
// A ShellCase pipeline whose body spawns its OWN app pthreads (a pool/actor acceptance fixture) must NOT
// run concurrently with the other cases: N such fixtures at once oversubscribe the scheduler and fail
// nondeterministically (the exact hazard #485 caught for build fixtures). These run SERIALLY; everything
// else runs across the worker pool. Identified by case name (the pool-isolation cases and the live-pool
// abort case are the ones that qualify).
shell_is_serial = (name: string_view) bool {
    name == "pool_actor_panic_isolation"
        || name == "pool_actor_stackoverflow_isolation"
        || name == "pool_actor_panic_box_freed"
        || name == "main_oom_panic_with_live_pool_aborts"
}
// wrap ONE shell case's body so it is self-contained + gid-isolated: bind `$ZT` to a PER-CASE scratch
// subdir `<zo_dir>/sh<gid>` (freshly recreated) so the hand-written pipelines — which reuse fixed scratch
// names like `$ZT/zbp.c`, `$ZT/zfmt.zen` — never clobber each other under concurrency, then record the
// pipeline's pass/fail as a P/F marker in `shrc<gid>.txt` (outside the subdir) for the in-order Phase C.
// The pipeline's own stdout+stderr are sent to /dev/null: the pass/fail is the exit code (captured in the
// marker), everything a case needs it already redirects into `$ZT`, and a few fixtures otherwise leak a
// stray line (a fixture's own program output, a `fmt --check` "needs formatting") that — under parallel
// execution — would interleave with the dot stream at a timing-dependent point, breaking determinism.
shell_wrap = (mp: MutPtr<Malloc>, gid: i64, cmd: string_view) string_view {
    z: string_view := ""
    zt := mp.zo_idpath("sh", gid, "")
    rc := mp.zo_idpath("shrc", gid, ".txt")
    mp.zo_join([z, "ZT=", zt, "; rm -rf \"$ZT\"; mkdir -p \"$ZT\"; if ( ", cmd, " ) >/dev/null 2>&1; then echo P > ", rc, "; else echo F > ", rc, "; fi"])
}
shell_ok = (mp: MutPtr<Malloc>, gid: i64) bool {
    mp.contents_in(mp.zo_idpath("shrc", gid, ".txt")).match ({
        .Ok(s)  => s.starts_with("P"),
        .Err(e) => false,
    })
}
// run the shell cases: the pipeline must exit 0. Thread-spawning cases (shell_is_serial) run one at a time;
// all others run across the worker pool. Every case's body is gid-isolated (its own `$ZT` subdir), so the
// fixed scratch names never collide. Phase C reads the P/F markers IN ORDER — byte-identical verdict to serial.
run_shells* = (name: string_view, cs: [ShellCase]) i32 {
    m := Malloc(_: 0)
    mp := m.addr()
    out(name)
    out("\n")
    n := cs.len
    // Phase A: build every case's wrapped command; partition into the parallel-safe batch (dense array
    // `pcmds`) and run the thread-spawning ones serially right here (their markers land the same way).
    pbase := malloc(n * 8)
    pcmds: [string_view] := pbase.slice(n)
    pn: i64 := 0
    cs.loop((h, i, c) {
        w := mp.shell_wrap(i, c.cmd)
        c.name.shell_is_serial().match ({
            true  => {
                shell(w).expect("harness: shell")
            },
            false => {
                pcmds[pn] = w
                pn = pn + 1
            },
        })
    })
    zo_par_run(pcmds, pn)
    // Phase C: read markers IN ORIGINAL ORDER → identical '.'/'F' sequence, fail count, exit code.
    fails := 0
    cs.loop((h, i, c) {
        mp.shell_ok(i).match ({
            true  => out("."),
            false => {
                out("F")
                fails = fails + 1
            },
        })
    })
    out("\n")
    free(pbase)
    fails
}
harness_build_run* = () i32 {
    fp := "tests/fixtures/zen/"
    // ── (a) build+run+exit-only fixtures (concurrency / scope / runtime acceptance programs) ──────
    ex := run_fixtures("build exit", [
        FixtureCase(
            path: "tests/fixtures/zen/zero_size_alloc.zen",
            want_exit: "0",
            want_out: "",
            check_out: false,
        ), FixtureCase(
            path: "tests/fixtures/zen/println_byte_count.zen",
            want_exit: "0",
            want_out: "",
            check_out: false,
        ),
