// std.rt — the still-live ambient runtime capability (see STATUS.md for the transition state).
//
// `Rt` reifies the allocator/runtime context a body runs in. The ambient rt is a thread-local
// default singleton: trivial programs need no setup, while boundaries may inject a custom value.
//
// Surface (import as `rt = std.rt`, then `rt.current()` / `rt.with(...)` / `rt.alloc(n)`):
//   rt.current()         -> Rt      read the ambient thread-local rt (process default when unset)
//   rt.with(custom, body) -> R      save-set-restore the ambient rt around a lexical block
//   rt.set_default(rt)              pick the whole program's rt once, before worker spawn
//   rt.default()         -> Rt      the process-wide default rt (heap unless set_default was called)
//   rt.alloc(n)          -> RawPtr  allocate n bytes via the AMBIENT rt (no allocator threading)
//   rt.resize(p, n)      -> RawPtr  grow/shrink via the ambient rt
//   rt.release(p)                   free via the ambient rt
//   rt.heap_rt()         -> Rt      the built-in heap vtable (malloc/free), also for injection
//
// The ambient default has TWO layers. `default_rt` is a PROCESS global — the
// runtime a program picks once via `rt.set_default(...)` at the top of main; every unset thread (main +
// pool workers) honors it, so a whole PARALLEL program can run under an arena. The thread-local `slot`
// is the per-actor override the pool sets around each behavior. `current()` = slot when set, else
// the process default. `set_default` is startup-only: it PANICS if called after the first spawn.
//
// WHY thread-local, not a true global: the pool runs different actors on different OS workers
// concurrently, so "current rt" must be per-worker — a shared mutable global would race and hand a
// behavior the wrong actor's heap. The default init (`slot = heap_rt()`) runs once on the main
// thread (in zen__init_globals). A FRESH worker thread sees a zero-initialized slot, so `ready == 0`
// is the sentinel that means "nothing injected here" and `current()` falls back to the process default.
// The pool uses this slot to inject the actor's runtime around each behavior call.
{ DynAlloc, dyn_of, heap_acquire, heap_resize, heap_release } = std.mem.alloc
{ panic } = std.core.result
// The runtime capability value. The three fn-pointer fields are the allocator vtable (Self erased
// to RawPtr<u8> state, so any allocator plugs in without generic threading). `state` is the allocator
// instance data (null for heap). `ready` is the init sentinel:
// 1 = a real Rt; 0 = a zero-init thread-local slot on a fresh worker => use the heap default.
Rt*: {
    mem_acquire: (RawPtr<u8>, i64) RawPtr<u8>,
    mem_resize: (RawPtr<u8>, RawPtr<u8>, i64) RawPtr<u8>,
    mem_release: (RawPtr<u8>, RawPtr<u8>) void,
    state: RawPtr<u8>,
    ready: i64,
}
// The default heap vtable is the canonical malloc/realloc/free floor from std.mem.alloc
// (heap_acquire/heap_resize/heap_release, imported above; state unused). rt.zen IS the runtime's
// default heap-allocator floor, so it sits on the raw-allocation allowlist alongside
// std.mem.{alloc,raw} / pool / thread — it just no longer re-inlines the three-line body.
// The process-wide default rt: heap-backed, no state. Cheap to build (just fills a struct), so
// `current()` reconstructs it on demand when nothing is injected rather than storing it.
heap_rt* = () Rt {
    Rt(
        mem_acquire: heap_acquire,
        mem_resize: heap_resize,
        mem_release: heap_release,
        state: null_ptr(),
        ready: 1,
    )
}
// Build a custom rt from an allocator vtable (state = the allocator instance data). This is what
// callers pass to `with(...)` to inject an arena, a pool allocator, or a test mock/failing allocator.
mem_rt* = (acquire: (RawPtr<u8>, i64) RawPtr<u8>, resize: (RawPtr<u8>, RawPtr<u8>, i64) RawPtr<u8>, release: (RawPtr<u8>, RawPtr<u8>) void, state: RawPtr<u8>) Rt {
    Rt(
        mem_acquire: acquire,
        mem_resize: resize,
        mem_release: release,
        state: state,
        ready: 1,
    )
}
// ── process-wide DEFAULT rt ───────────────────────────────────────────────────────────────────────
// `default_rt` is a PROCESS global (NOT thread-local): it is the runtime a program picks ONCE, at the
// top of `main`, and every unset thread — the main thread AND every pool worker — honors it. Heap by
// default, so a program that never opts in is byte-identical. It replaces the two hardcoded `heap_rt()`
// call sites (this file's `current()` fallback + pool.zen/pool_actor.zen's default-spawn art), so a
// whole PARALLEL program — pool actors included — can be run under an arena / custom allocator, which
// `with`/`enter` (current-thread-only) cannot achieve.
default_rt := heap_rt()
// The startup-contract guard: set to 1 by `mark_spawned` on the FIRST pool spawn. `set_default` PANICS
// if called after this, turning the shared-mutable-global race (a worker reading `default_rt` while
// main rewrites it) into a teaching error. The write is monotonic 0->1, so even a nested-spawn write
// from a worker can only make the guard fire MORE, never falsely pass. Main-thread startup logic.
spawned := 0
// Read the process default (the configurable "trivial default"). Used by `current()`'s unset fallback
// and by the default-spawn paths in pool.zen / pool_actor.zen.
default* = () Rt { default_rt }
// Configure the process-wide default rt — call ONCE, at the top of `main`, BEFORE spawning any actor.
// Writes the process global (honored by pool workers via their zeroed-slot fallback) AND the main
// thread's own slot (so main-thread ambient allocation honors it immediately). PANICS if called after
// the first spawn: `default_rt` is read by worker threads with no lock, so it is only safe to write
// during single-threaded startup; a later call would race.
set_default* = (custom: Rt) void {
    (spawned == 0).match ({
        true  => {
            default_rt = custom
            slot = custom
        },
        false => panic("rt.set_default must be called before spawning any actor"),
    })
}
// Called by the pool's single spawn choke point (pool_spawn_rt) on every spawn: latches the guard so a
// subsequent `set_default` is rejected. Idempotent (monotonic 0->1).
mark_spawned* = () void { spawned = 1 }
// The ambient current-rt, per OS thread. Init runs once on the main thread; fresh workers see a
// zeroed slot (ready == 0) and fall back to the process default via `current()`.
slot := thread_local(heap_rt())
// Read the ambient rt. Never returns a half-built value: a zeroed slot means "unset" => process default.
current* = () Rt { (slot.ready == 0).match ({ true => default(), false => slot }) }
// Rebind the ambient rt for the dynamic extent of `body`, then restore — the injectable boundary
// (arenas, and crucially test injection: a mock / failing allocator). Save-set-restore, and
// exception-safe: behaviors are run-to-completion, so no unwinding can leak the saved slot.
with*<R> = (custom: Rt, body: () R) R {
    saved := slot
    slot = custom
    out := body()
    slot = saved
    out
}
// Pool-actor hook: explicit save-set-restore on the ambient slot, WITHOUT a
// closure. `with` above takes a niladic callback, but the pool calls an actor's behavior through a raw
// `(RawPtr<u8>, i64) void` fn-ptr in a hot worker loop — there is no closure to hand it. So the pool
// does `saved := rt.enter(a.rt); a.behavior(a.user, msg); rt.leave(saved)` around each behavior run,
// making `rt.current()` inside the behavior resolve to that actor's own rt (Pony per-actor heap). A
// fresh worker's zeroed slot (ready == 0) already falls back to the heap default, so this is a pure
// write; and behaviors are run-to-completion (no unwinding), so the saved slot can never leak.
enter* = (custom: Rt) Rt {
    saved := slot
    slot = custom
    saved
}
leave* = (saved: Rt) void { slot = saved }
// The ambient allocation path: read the current rt and dispatch through its vtable. This is the
// single demonstrable proof that allocation reads the ambient rt with no allocator parameter. The
// vtable fields are prefixed `mem_` so they never collide with these same-named public fns.
alloc* = (n: i64) RawPtr<u8> {
    r := current()
    r.mem_acquire(r.state, n)
}
resize* = (p: RawPtr<u8>, n: i64) RawPtr<u8> {
    r := current()
    r.mem_resize(r.state, p, n)
}
release* = (p: RawPtr<u8>) void {
    r := current()
    r.mem_release(r.state, p)
}
// Narrow an Rt to JUST its allocator capability (a `DynAlloc` value): keep acquire/resize/release +
// state, drop sched/gc/ready. This is the bridge the ambient collections cross ONCE at construction —
// they then store the narrow `DynAlloc`, not the whole `Rt` bundle: a container takes the narrowest
// capability it needs, an Allocator, never the world (see MEMORY_MODEL.md).
dyn_of_rt* = (r: Rt) DynAlloc { dyn_of(r.mem_acquire, r.mem_resize, r.mem_release, r.state) }
// The AMBIENT allocator, narrowed: read `current()` ONCE and hand back a `DynAlloc`. This is the single
// ambient draw on the ambient-container construction path; every later container op allocates through
// the stored `DynAlloc`, never re-reading the thread-local.
dyn_current* = () DynAlloc { dyn_of_rt(current()) }
