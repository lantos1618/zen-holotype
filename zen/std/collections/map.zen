// std.collections.map — a string_view-keyed associative map with an EXPLICIT allocator.
// Every op that allocates takes the allocator as `a: MutPtr<A>` and goes through std.mem.alloc's `Allocator`
// trait — nothing here hides a malloc. Fallible ops (`empty`, `of`, `clone`, `put`, `append`, `grow`) return
// Result<Map<T>, IoError> — allocation failure is a value: `.expect("…")` at fail-fast roots,
// `.or_return()` inside Result-returning fns.
//
// LOOKUP: `get(k, dflt)` returns a caller-supplied default on a miss — convenient, but a stored value equal
// to `dflt` is then indistinguishable from an absent key. When that distinction matters, use `get_opt(k)`,
// which returns `Opt<T>` (`.Some(v)` present / `.None` absent).
//
// Lookup is O(1) AVERAGE via an open hash index (FNV-1a over the key bytes, separate chaining into the
// insertion-ordered key/val columns). The index lives in one i64 buffer of `2*cap` slots: the first `cap`
// slots are bucket HEADS (entry index or -1), the next `cap` slots are the per-entry NEXT links. The index
// is rebuilt on grow. This keeps the O(n^2) decl scans in the compiler from dominating compile time.
//
// Layout: two PARALLEL buffers of `cap` slots — `keys` holds string pointers, `vals` holds T's —
// plus `len` live entries, plus `idx` (the 2*cap i64 hash index). Keys are BORROWED views: the map
// stores the pointer, not a copy, so a key must outlive the map (string literals always do; `dup` one from
// std.text.str otherwise). Key comparison is byte-wise `eq` from std.text.str, never pointer `==`.
//
//   alloc := default()
//   a := alloc.addr()
//   w := maps.of(a, "the", 1).expect("of")    // Map<i32>; T inferred from the seed
//   w  = w.put(a, "cat", 2).expect("put")     // insert — grows through alloc when full
//   w  = w.put(a, "the", 9).expect("put")     // upsert — same key overwrites in place
//   n := w.get("the", 0)                   // 9; absent keys produce the default
//   w.free(a)                              // hand all buffers back to alloc
//
// Allocator-threaded constructors remain free functions; Map-owned operations live on Map<T>, so
// callers use w.put(...), w.free(...), w.get(...), w.has(...), and w.len().
//
// VALUE-MOLD CONTRACT (read before sharing a Map handle). A `Map<T>` is a small by-value header
// {keys, vals, idx, len, cap} over allocator-owned buffers, exactly like std.collections.vec. Two
// consequences follow from that — both are by-design, not bugs:
//   1. ALWAYS USE THE RETURNED MAP. `put` may grow, which reallocs the buffers and returns
//      an updated header whose pointers differ from the input's. A handle captured BEFORE such a grow
//      then points at freed memory — reading or further mutating it is use-after-free. Treat a Map
//      like a fresh value each op: `m = m.put(a, k, v)`; never keep and reuse a pre-`put` copy.
//   2. NO IMPLICIT VALUE SEMANTICS. Two headers copied from the same Map share one backing buffer, so
//      an in-place upsert (`put` on an existing key) is visible through every copy. If you need an
//      independent snapshot (e.g. a child scope that must not write through to its parent), take an
//      explicit deep copy with `m.clone(a).expect("clone")` first (clone is fallible — it allocates),
//      then mutate the copy.
//
{ Allocator, try_acquire } = std.mem.alloc    // explicit allocator trait
{ Result, IoError, Opt } = std.core.result
{ eq, view } = std.text.str    // byte-wise equality (`==` on strings compares POINTERS) + hashing view
// One key slot. The named one-pointer wrapper keeps this raw backing-store layout explicit.
MKey: {
    k: string_view,
}
// one index slot: a single i64 (bucket head or next link).
MIdx: {
    i: i64,
}
Map*<T>: {
    keys: RawPtr<u8>,
    vals: RawPtr<u8>,
    idx: RawPtr<u8>,
    len: i64,
    cap: i64,
    keys = (m: Map<T>) [string_view] {
        // Live view over the LEN live entries (stored compactly in slots [0, len) in insertion
        // order — there is no delete, so no gaps). Sized to `len`, NOT `cap`: a `.loop` over the
        // result iterates only real entries instead of walking the empty/NULL tail of the backing
        // table (which segfaults). The append writers (`append`/`of`) index slot
        // `len` (one past) via raw pointer arithmetic, which ignores the slice's `.len`, so writing
        // the next slot still lands in the cap-sized backing buffer — only `.loop`/`.len` consumers
        // observe the tighter bound.
        slice(m.keys, m.len)
    }
    vals = (m: Map<T>) [T] { slice(m.vals, m.len) }
    keys_all = (m: Map<T>) [string_view] {
        // CAP-sized views over the full backing buffers, for the one-past-len APPEND write (slot [len],
        // which is < cap and so in-bounds here, but past the len-sized `keys()`/`vals()` views).
        slice(m.keys, m.cap)
    }
    vals_all = (m: Map<T>) [T] { slice(m.vals, m.cap) }
    index = (m: Map<T>) [i64] {
        // 2*cap i64 slots: [0,cap) bucket heads, [cap,2*cap) per-entry next links.
        slice(m.idx, m.cap * 2)
    }
    len = (m: Map<T>) i64 { m.len }
    find = (m: Map<T>, k: string_view) i64 {
        // O(1) average: hash to a bucket, walk the chain comparing keys bytewise.
        (m.cap == 0).match ({
            true  => 0 - 1,
            false => mfind(m.keys(), m.index(), m.cap, mhash(k, m.cap), k),
        })
    }
    set = (m: Map<T>, i: i64, v: T) Map<T> {
        vals := m.vals()
        vals[i] = v
        m
    }
    get_at = (m: Map<T>, i: i64, dflt: T) T { (i < 0).match ({ true => dflt, false => m.vals()[i] }) }
    get = (m: Map<T>, k: string_view, dflt: T) T { m.get_at(m.find(k), dflt) }
    get_opt = (m: Map<T>, k: string_view) Opt<T> {
        // The value under k as an option: .Some(v) if present, .None if absent. Unlike `get(k, dflt)`,
        // this distinguishes an absent key from a stored value that happens to equal the default.
        i := m.find(k)
        out: Opt<T> := (i < 0).match ({ true => .None, false => .Some(m.vals()[i]) })
        out
    }
    has = (m: Map<T>, k: string_view) bool { m.find(k) >= 0 }
    grow<A> = (m: Map<T>, a: MutPtr<A>) Result<Map<T>, IoError> {
        cap := m.cap * 2 + 1
        a.try_acquire(cap * sizeof(MKey)).match ({
            .Ok(kp) => {
                a.try_acquire(cap * sizeof(T)).match ({
                    .Ok(vp) => {
                        a.try_acquire(cap * 2 * sizeof(MIdx)).match ({
                            .Ok(ip) => {
                                oldks := m.keys()
                                oldvs := m.vals()
                                next := Map<T>(
                                    keys: kp,
                                    vals: vp,
                                    idx: ip,
                                    len: m.len,
                                    cap: cap,
                                )
                                keys := next.keys()
                                vals := next.vals()
                                oldks.loop((h, i, k) {
                                    (i < m.len).match ({ true => {
                                        keys[i] = k
                                        vals[i] = oldvs[i]
                                    }, false => {
                                        h.break
                                    } })
                                })
                                a.release(m.keys)
                                a.release(m.vals)
                                a.release(m.idx)
                                ok: Result<Map<T>, IoError> := .Ok(next.reindex())
                                ok
                            },
                            .Err(e) => {
                                a.release(kp)
                                a.release(vp)
                                err: Result<Map<T>, IoError> := .Err(e)
                                err
                            },
                        })
                    },
                    .Err(e) => {
                        a.release(kp)
                        err: Result<Map<T>, IoError> := .Err(e)
                        err
                    },
                })
            },
            .Err(e) => {
                err: Result<Map<T>, IoError> := .Err(e)
                err
            },
        })
    }
    reindex = (m: Map<T>) Map<T> {
        // Rebuild the hash index from the live key column. O(len).
        ix := m.index()
        cap := m.cap
        ix.loop((h, i, v) {
            // clear all bucket heads to -1
            (i < cap).match ({ true => {
                ix[i] = 0 - 1
            }, false => {
                h.break
            } })
        })
        ks := m.keys()
        ks.loop((h, i, k) {
            (i < m.len).match ({ true => {
                b := mhash(k, cap)
                ix[cap + i] = ix[b]
                ix[b] = i
            }, false => {
                h.break
            } })
        })
        m
    }
    link = (m: Map<T>, slot: i64) Map<T> {
        // Append a key/val pair (caller has ensured the key is absent) and link it into its bucket.
        ix := m.index()
        b := mhash(m.keys()[slot], m.cap)
        ix[m.cap + slot] = ix[b]
        ix[b] = slot
        m
    }
    append<A> = (m: Map<T>, a: MutPtr<A>, k: string_view, v: T) Result<Map<T>, IoError> {
        k := k
        v := v
        out: Result<Map<T>, IoError> := (m.len < m.cap).match ({ true => {
            keys := m.keys_all()
            vals := m.vals_all()
            keys[m.len] = k
            vals[m.len] = v
            ok: Result<Map<T>, IoError> := .Ok(Map<T>(
                keys: m.keys,
                vals: m.vals,
                idx: m.idx,
                len: m.len + 1,
                cap: m.cap,
            ).link(m.len))
            ok
        }, false => {
            m.grow(a).match ({
                .Ok(next) => {
                    keys := next.keys_all()
                    vals := next.vals_all()
                    keys[next.len] = k
                    vals[next.len] = v
                    ok: Result<Map<T>, IoError> := .Ok(Map<T>(
                        keys: next.keys,
                        vals: next.vals,
                        idx: next.idx,
                        len: next.len + 1,
                        cap: next.cap,
                    ).link(next.len))
                    ok
                },
                .Err(e)   => {
                    err: Result<Map<T>, IoError> := .Err(e)
                    err
                },
            })
        } })
        out
    }
    put<A> = (m: Map<T>, a: MutPtr<A>, k: string_view, v: T) Result<Map<T>, IoError> {
        // Insert or upsert (allocation failure is a value). RETURNS the updated map — always rebind to
        // the result (`m = m.put(...).expect("…")`). On grow the buffers are realloced, so any handle
        // captured before this call dangles (see the VALUE-MOLD CONTRACT above). On an existing key the
        // value is overwritten IN PLACE, so the new value is visible through every header that shares
        // this map's storage; `clone` first for an independent copy.
        i := m.find(k)
        out: Result<Map<T>, IoError> := (i < 0).match ({ true => m.append(a, k, v), false => {
            next := m.set(i, v)
            ok: Result<Map<T>, IoError> := .Ok(next)
            ok
        } })
        out
    }
    free<A> = (m: Map<T>, a: MutPtr<A>) void {
        a.release(m.keys)
        a.release(m.vals)
        a.release(m.idx)
    }
    clone<A> = (m: Map<T>, a: MutPtr<A>) Result<Map<T>, IoError> {
        // Deep-copy the map into fresh buffers from `a`, giving the result INDEPENDENT storage: mutating
        // the clone (or the original) never writes through to the other. This is the tool for value
        // semantics the by-value header doesn't provide on its own — clone before handing a Map to a child
        // scope that must not corrupt its parent. Keys stay BORROWED (the pointers are copied, not the
        // bytes — same outlives-the-map rule as everywhere else); values are copied by value. The clone
        // owns its buffers and must be `free`d independently. O(len). Allocation failure is a value: OOM on
        // any of the three acquires is returned as .Err (already-acquired buffers are released first).
        cap := m.cap
        a.try_acquire(cap * sizeof(MKey)).match ({
            .Ok(kp) => {
                a.try_acquire(cap * sizeof(T)).match ({
                    .Ok(vp) => {
                        a.try_acquire(cap * 2 * sizeof(MIdx)).match ({
                            .Ok(ip) => {
                                next := Map<T>(
                                    keys: kp,
                                    vals: vp,
                                    idx: ip,
                                    len: m.len,
                                    cap: cap,
                                )
                                srcks := m.keys()
                                srcvs := m.vals()
                                dstks := next.keys()
                                dstvs := next.vals()
                                srcks.loop((h, i, k) {
                                    (i < m.len).match ({ true => {
                                        dstks[i] = k
                                        dstvs[i] = srcvs[i]
                                    }, false => {
                                        h.break
                                    } })
                                })
                                ok: Result<Map<T>, IoError> := .Ok(next.reindex())
                                ok
                            },
                            .Err(e) => {
                                a.release(kp)
                                a.release(vp)
                                err: Result<Map<T>, IoError> := .Err(e)
                                err
                            },
                        })
                    },
                    .Err(e) => {
                        a.release(kp)
                        err: Result<Map<T>, IoError> := .Err(e)
                        err
                    },
                })
            },
            .Err(e) => {
                err: Result<Map<T>, IoError> := .Err(e)
                err
            },
        })
    }
    each_pair = (m: Map<T>, f: (string_view, T) void) void {
        // Visit every live entry as (key, value) together, in insertion order. `f` is invoked DIRECTLY in
        // the loop body so an inline lambda splices in (like iter.each). Walking `keys()`/`vals()` in
        // parallel at the call site is no longer needed: `m.each_pair((k, v){ … })`.
        ks := m.keys()
        vs := m.vals()
        ks.loop((h, i, k) {
            (i < m.len).match ({ true => {
                f(k, vs[i])
            }, false => {
                h.break
            } })
        })
    }
}
// FNV-1a hash of k's bytes, folded into [0, cap). cap is always >= 1 at call sites.
mhash = (k: string_view, cap: i64) i64 {
    bs: [u8] := k.view()
    h := 2166136261
    bs.loop((hh, i, b) {
        h = (h ^ to_i64(b)) * 16777619
    })
    // mask to non-negative then mod into the bucket range
    (h & 4611686018427387903) % cap
}
// Walk bucket chain b for key k in the index ix over key column ks (cap entries, links at [cap..]).
mfind = (ks: [string_view], ix: [i64], cap: i64, b: i64, k: string_view) i64 { mchain(ks, ix, cap, ix[b], k) }
mchain = (ks: [string_view], ix: [i64], cap: i64, e: i64, k: string_view) i64 {
    (e < 0).match ({
        true  => 0 - 1,
        false => eq(ks[e], k).match ({ true => e, false => mchain(ks, ix, cap, ix[cap + e], k) }),
    })
}
// a zero-entry `Map<T>` with capacity for at least one entry (so `put` has a slot before the first
// grow). Allocation failure is a value — returns Result<Map<T>, IoError>. Unlike `of`, no seed pins T,
// and T appears only in the RETURN type, which inference can't reach through a `.expect` chain — pin it
// with a two-step annotation (like hmap.empty):
//   r: Result<Map<i32>, IoError> := maps.empty(a)
//   m := r.expect("empty")
// A is inferred from `a`. The index is reindexed (its single bucket head cleared to -1) so `find`/`get`
// on the empty map return absent immediately. Pair with `put`/`get`/`free` like `of`.
empty*<T, A> = (a: MutPtr<A>) Result<Map<T>, IoError> {
    a.try_acquire(sizeof(MKey)).match ({
        .Ok(kp) => {
            a.try_acquire(sizeof(T)).match ({
                .Ok(vp) => {
                    a.try_acquire(2 * sizeof(MIdx)).match ({
                        .Ok(ip) => {
                            m := Map<T>(
                                keys: kp,
                                vals: vp,
                                idx: ip,
                                len: 0,
                                cap: 1,
                            )
                            ok: Result<Map<T>, IoError> := .Ok(m.reindex())
                            ok
                        },
                        .Err(e) => {
                            a.release(kp)
                            a.release(vp)
                            err: Result<Map<T>, IoError> := .Err(e)
                            err
                        },
                    })
                },
                .Err(e) => {
                    a.release(kp)
                    err: Result<Map<T>, IoError> := .Err(e)
                    err
                },
            })
        },
        .Err(e) => {
            err: Result<Map<T>, IoError> := .Err(e)
            err
        },
    })
}
// a `Map<T>` seeded with one entry, its buffers acquired from `a`. T inferred from the seed value
// (Zen has no call-site type args). Starts at cap 1.
of*<T, A> = (a: MutPtr<A>, seed_key: string_view, seed_val: T) Result<Map<T>, IoError> {
    a.try_acquire(sizeof(MKey)).match ({
        .Ok(kp) => {
            a.try_acquire(sizeof(T)).match ({
                .Ok(vp) => {
                    a.try_acquire(2 * sizeof(MIdx)).match ({
                        .Ok(ip) => {
                            m := Map<T>(
                                keys: kp,
                                vals: vp,
                                idx: ip,
                                len: 1,
                                cap: 1,
                            )
                            keys := m.keys()
                            vals := m.vals()
                            keys[0] = seed_key
                            vals[0] = seed_val
                            ok: Result<Map<T>, IoError> := .Ok(m.reindex())
                            ok
                        },
                        .Err(e) => {
                            a.release(kp)
                            a.release(vp)
                            err: Result<Map<T>, IoError> := .Err(e)
                            err
                        },
                    })
                },
                .Err(e) => {
                    a.release(kp)
                    err: Result<Map<T>, IoError> := .Err(e)
                    err
                },
            })
        },
        .Err(e) => {
            err: Result<Map<T>, IoError> := .Err(e)
            err
        },
    })
}
