// src/lsp/lsp_diag.zen
// `textDocument/publishDiagnostics`: what a build found, said to a client.
//
// `design_lsp.md` §5: the queries are somebody else's — `Build` answers
// `diag_count`/`diag_at` for lex and parse, the `Checker` `Build.whole`
// hands back answers the same pair for sema. This file decides WHEN to
// build, WHICH file each answer belongs to, and how an answer is taken
// BACK. The build itself — and the arena it lives and dies by — moved to
// `lsp_built.zen`; what remains here is policy.
//
// WHEN, AND THE DEBOUNCE THAT IS NOT ONE. §5 asks for a debounce — build
// after a quiet interval — but a quiet interval cannot be observed:
// `Stdin.read` blocks until it has exactly the bytes asked for
// (`src/std/env/env.zen`), there is no clock, and threads arrive at
// stage 5 (`PLAN.md`). So instead: A CHANGE MARKS, A SETTLE POINT
// BUILDS. `didOpen`/`didChange` record which document is owed a build;
// the transport calls `settled` once it has answered everything it
// currently holds. This COALESCES a batch to ONE build of the LAST
// buffer, and is ORDERED (one build at a time, always the newest
// document, so §5's race is absent by construction).
//
// AND THE BUILD ITSELF IS SHARED: `settled` does not build, it ENSURES —
// `lsp_built.zen`'s single flight. A settle for a state a query already
// built publishes from the held slot without rebuilding; a settle for a
// new state builds once and the queries that follow reuse it. What a
// settle still costs when nothing changed since the last settle: one key
// comparison, no build at all.
//
// HONEST ABOUT THE PIPE: over `lsp_stdio.zen` a settle point is every
// message, since `short_by` asks for exactly one message's bytes and a
// blocking reader cannot look past it — so over a real editor this
// coalesces nothing at the TRANSPORT (the missing piece is a read that
// can say "nothing more is waiting", or a second thread; `Stdin` has
// neither, and adding one is not this folder's call). What coalesces
// instead is the BUILD: the slot above, the byte-identical `didChange`
// skip in `lsp_serve.zen`'s `stored`, and the unchanged-notification
// skip at `say_one` below.
//
// WHICH FILE, AND WHY CLEARING IS THE HARD HALF. A build reports across
// the whole program, so diagnostics belong to many files though only one
// is open; every diagnostic is grouped by the URI its own span names,
// one notification per URI.
//
// THE PROTOCOL HAS NO "REMOVE". A notification REPLACES a file's list,
// so taking an error back means publishing an EMPTY list for that file
// — a server publishing only what it found would leave stale errors on
// screen forever. So `showing` is the set of URIs currently carrying
// errors, and every build publishes for three sets: the edited file
// (always), every file this build found something in, and every file
// `showing` holds that this build found nothing in (the clearing).
//
// AND NOTHING IS SAID TWICE. `say_one` compares the framed body against
// the last one sent for that URI (`said`) and skips the write when they
// match — the same byte comparison `lsp_serve.zen`'s `stored` applies
// to incoming buffers, applied to outgoing notifications. The clearing
// still works: a file that stops being wrong has a DIFFERENT body (the
// empty list) than the one `said` holds, so the take-back always goes
// out. `showing` updates whether or not a frame was written — the dedup
// is about the wire, never about the state.
//
// SEVERITY, AND WHERE THE NOTE WENT. EVERY DIAGNOSTIC IS AN ERROR,
// severity 1 — a fact about this compiler (one tally `Build.faults`, no
// phase survives a build), not a simplification; changes the day a
// warning exists.
//
// THE NOTE BECOMES `relatedInformation`, NOT PART OF THE MESSAGE. A
// `parse.parse_diag.Note` is a sentence AND A SPAN — folding it into the
// message would throw the span away; `relatedInformation` is the
// protocol's field for exactly that pair, rendered by a client as
// somewhere to jump to.
//
// SEMA'S SECOND POSITION IS ALREADY IN ITS SENTENCE and stays there: a
// `PairFault` names two declarations and `write_detail` writes both —
// `sema_diag.zen` owns that wording.

str, String = std.text
Vec, Map = std.collections
Alloc, AllocError = std.mem
Span = std.ast.ast_span
Note = std.parse.parse_diag
Checker = sema.sema_check
root_for, relative_to = zen.zen_path
write_range = lsp.lsp_pos
write_text, written = lsp.lsp_json
write_frame, write_decimal = lsp.lsp_frame
path_of = lsp.lsp_uri
// The one arena string-copy, exported (`lsp_reply.zen`).
own_str = lsp.lsp_reply
// The one build the session keeps, and what it gathered. `Spot` is
// RE-EXPORTED, not moved in spirit: a diagnostic already belonging to a
// file is shaped where the build that produced it lives.
Built, Spot* = lsp.lsp_built
// The semantic half of colour: what the held build settled about each
// name, gathered by `lsp_names.zen` off the SAME `Checker` the
// diagnostics come from — a second build per keystroke is the cost
// `design_lsp.md` §5 prices, and it is paid nowhere twice.
Classed, sort_classes = lsp.lsp_colour

// What a query borrows from the held build: the checker (a header copy,
// read-only — `lsp_built.zen`'s header is the doctrine) and the root it
// ran against, which a definition needs to turn another module's span
// into a URI. `c` is a `Res` because a successful `ensure` having left a
// build in the slot is a fact the type system cannot see.
Shared* = {
    c*: Res<Checker>,
    root*: str,
}

// The server's diagnostics half: which document owes a build, which
// files are showing errors right now, and the one build everything
// shares. A TYPE OF ITS OWN rather than four fields on `Server`: the
// server owns the documents, this owns what has been said about them.
Diagnostics* = {
    a: Alloc,

    // The document a build is owed to, or "" when none — one, not a
    // queue: a build is whole-program, so the newest document answers
    // for every older one.
    owed :: str = "",

    // Every URI currently carrying a non-empty list — the ONLY thing
    // that makes clearing possible. SESSION-ARENA COPIES: the spots they
    // were read from die with the slot's next build, and this set must
    // not.
    showing :: Vec<str>,

    // THE ONE BUILD, shared with every query. See `lsp_built.zen`.
    built :: Built,

    // May `classed` be served? A change stales it (`owes`): the rows
    // describe the text the last SETTLE saw, not the text the buffer now
    // holds. A query-driven rebuild does NOT set this — colour follows
    // the settle, and the lexical fallback is never wrong.
    fresh :: bool = false,

    // THE LAST NOTIFICATION SENT, per URI — the dedup `say_one` applies.
    // Keys and bodies are session-arena copies for the same reason
    // `showing` is.
    said :: Map<str, str>,

    // A document changed. Nothing is built here — see the header. The
    // freshness goes with the change; the slot's own key notices the new
    // bytes at the next `ensure`.
    owes* = (self :: @Self, uri: str) () {
        self.owed = uri;
        self.fresh = false;
    }

    // The names the last settle classified in `uri`, sorted for
    // `lsp_colour.zen`'s search. AN EMPTY VEC IS THE WHOLE FALLBACK:
    // no workspace, no build yet, a change not yet settled and a build
    // with faults all look alike here, and all mean "lexical colours".
    // Rows are COPIED OUT (`t`, the request's arena): the slot's pages
    // are freed by the next build, so nothing may hold a row past it.
    classes_for* = (self :: @Self, t: Alloc, uri: str)
                   Res<Vec<Classed>, AllocError> {
        found ::= t.Vec<Classed>();
        self.fresh.match({
            false => written(),
            true  => self.gather(uri, found),
        }).try();
        sort_classes(found).try();
        Ok(found);
    }

    gather = (self :: @Self, uri: str, found :: Vec<Classed>)
             Res<(), AllocError> {
        self.built.classed().match({
            None        => written(),
            Ok(classed) => self.each_of(classed, uri, found),
        })
    }

    each_of = (self :: @Self, classed: Vec<Classed>, uri: str,
               found :: Vec<Classed>) Res<(), AllocError> {
        classed.loop((h, cl) {
            cl.uri.eq(uri).match({
                true  => found.add(cl),
                false => Ok(()),
            }).try();
        });
        Ok(());
    }

    // WHAT A QUERY SHARES, with the caller having ruled out the
    // lone-module case (an empty workspace is ITS branch, as it has
    // always been). The slot is ensured for the document being asked
    // about — building once if the state is new — and its checker
    // answers. `c` is a `Res` because the type system cannot see that a
    // successful `ensure` left a build in the slot; the `None` arm at
    // the call site is unreachable and falls back to a build of its own.
    shared* = (self :: @Self, env: Env, workspace: str, uris: Vec<str>,
               docs: Map<str, str>, path: str, t: Alloc)
              Res<Shared, AllocError> {
        root = root_for(env, t, workspace, path);
        self.built.ensure(env, root, relative_to(root, path), uris, docs).try();
        Ok(Shared(c: self.built.checker(), root: self.built.root()));
    }

    // THE SETTLE POINT: if a build is owed, it happens here — or is
    // FOUND here, when a query already built this exact state (the
    // slot's key is the document bytes; a queued `didChange` followed by
    // a query is one build, with the publish below reading its spots).
    // `uris` and `docs` are the server's open documents; the overlay
    // must carry EVERY unsaved buffer, not only the edited one — a build
    // reading disk for the others would report errors already fixed on
    // screen. `t` is scratch for this settle alone.
    settled* = (self :: @Self, env: Env, workspace: str, uris: Vec<str>,
                docs: Map<str, str>, t: Alloc, out :: String)
               Res<(), AllocError> {
        self.owed.is_empty().match({
            true  => written(),
            false => self.build_owed(env, workspace, uris, docs, t, out),
        })
    }

    // NO WORKSPACE, NO DIAGNOSTICS — a refusal, not a gap. Without a
    // root there is nothing to build but the open file alone, and a
    // lone-module check reports every imported name as undefined: a
    // screen of red about a program that is fine. Hover degrades to the
    // lone module because its failure is silence; this one's is noise,
    // so it does not degrade at all. A document not under the workspace
    // (`root_for` climbs to "") is treated the same way.
    build_owed = (self :: @Self, env: Env, workspace: str, uris: Vec<str>,
                  docs: Map<str, str>, t: Alloc, out :: String)
                 Res<(), AllocError> {
        uri = self.owed;
        self.owed = "";
        path = path_of(uri);
        root = root_for(env, t, workspace, path);
        (workspace.is_empty() || root.is_empty()).match({
            true  => written(),
            false => self.told(
                env,
                root,
                relative_to(root, path),
                uri,
                uris,
                docs,
                t,
                out
            ),
        })
    }

    told = (self :: @Self, env: Env, root: str, entry: str, uri: str,
            uris: Vec<str>, docs: Map<str, str>, t: Alloc, out :: String)
           Res<(), AllocError> {
        self.built.ensure(env, root, entry, uris, docs).try();
        self.fresh = true;
        // `ensure` just left the spots in the slot; `None` is
        // unreachable and answered by publishing nothing, never by
        // guessing.
        self.built.spots().match({
            None      => written(),
            Ok(spots) => self.say_all(env, t, uri, uris, docs, spots, out),
        })
    }

    // THE THREE SETS, in order: the edited document, then every other
    // file this build found something in, then every file that was
    // showing errors and is not in either.
    say_all = (self :: @Self, env: Env, t: Alloc, uri: str, uris: Vec<str>,
               docs: Map<str, str>, spots: Vec<Spot>, out :: String)
              Res<(), AllocError> {
        now ::= t.Vec<str>();
        uris_of(spots, now).try();
        self.say_one(env, t, uri, uris, docs, spots, out).try();
        now.loop((h, u) {
            u.eq(uri).match({
                true  => written(),
                false => self.say_one(env, t, u, uris, docs, spots, out),
            }).try();
        });
        self.take_back(env, t, uri, now, uris, docs, spots, out).try();
        self.remember_showing(now).try();
        Ok(());
    }

    // `showing` OUTLIVES the build the URIs were read from, so each is
    // copied into the session arena — the slot's pages go back on the
    // next build (`lsp_built.zen`), and a set that points into freed
    // pages is a use-after-free, not a stale string.
    remember_showing = (self :: @Self, now: Vec<str>) Res<(), AllocError> {
        self.showing = self.a.Vec<str>();
        now.loop((h, u) {
            kept = own_str(self.a, u).try();
            self.showing.add(kept).try();
        });
        Ok(());
    }

    // ONE FILE'S LIST, SAID AT MOST ONCE PER CONTENT. The body is built,
    // compared against the last one sent for this URI, and written only
    // when different — an unchanged build's answer costs a comparison,
    // not a frame.
    say_one = (self :: @Self, env: Env, t: Alloc, uri: str, uris: Vec<str>,
               docs: Map<str, str>, spots: Vec<Spot>, out :: String)
              Res<(), AllocError> {
        body ::= t.String().try();
        write_notification(t, uri, text_of(
            env,
            t,
            uri,
            docs
        ), spots, body).try();
        self.said.get(uri).match({
            None     => self.send(uri, body, out),
            Ok(prev) => prev.eq(body.view()).match({
                true  => written(),
                false => self.send(uri, body, out),
            }),
        })
    }

    send = (self :: @Self, uri: str, body: String, out :: String)
           Res<(), AllocError> {
        kept_uri = own_str(self.a, uri).try();
        kept_body = own_str(self.a, body.view()).try();
        self.said.set(kept_uri, kept_body).try();
        write_frame(body.view(), out)
    }

    // AN EMPTY LIST FOR EVERY FILE THAT HAS STOPPED BEING WRONG. The
    // edited document is excluded — already published once.
    take_back = (self :: @Self, env: Env, t: Alloc, uri: str, now: Vec<str>,
                 uris: Vec<str>, docs: Map<str, str>, spots: Vec<Spot>,
                 out :: String) Res<(), AllocError> {
        self.showing.loop((h, u) {
            gone(u, uri, now).match({
                false => written(),
                true  => self.say_one(env, t, u, uris, docs, spots, out),
            }).try();
        });
        Ok(());
    }
}

Diagnostics* = (a: Alloc, env: Env) Diagnostics {
    Diagnostics(
        a: a,
        showing: a.Vec<str>(),
        built: env.Built(),
        said: a.Map<str, str>()
    )
}

// Was this URI showing errors and is it not among the ones that have
// them now?
gone = (u: str, uri: str, now: Vec<str>) bool {
    u.eq(uri).match({
        true  => false,
        false => now.find((n) { n.eq(
            u
        ) }).match({ Ok(_) => false, None => true }),
    })
}

// The distinct URIs these spots name, in the order they were found.
uris_of = (spots: Vec<Spot>, into :: Vec<str>) Res<(), AllocError> {
    spots.loop((h, s) {
        into.find((u) { u.eq(s.uri) }).match({
            Ok(_) => written(),
            None  => into.add(s.uri),
        }).try();
    });
    Ok(());
}

// --- the notification --------------------------------------------------

// The bytes the spans in `uri` were measured against: the open buffer if
// there is one, disk otherwise, "" when neither answers. "" IS NOT A
// SILENT FAILURE: `to_wire` clamps, so an unreadable file's positions
// convert to 0:0 — the diagnostic still reaches the client and names the
// file; only the underline is off. Worse to drop the diagnostic.
text_of = (env: Env, t: Alloc, uri: str, docs: Map<str, str>) str {
    docs.get(uri).match({
        Ok(text) => text,
        None     => on_disk(env, t, path_of(uri)),
    })
}

on_disk = (env: Env, t: Alloc, path: str) str {
    env.fs.read(t, path).match({
        Ok(text) => text.view(),
        Err(_)   => "",
    })
}

// ONE FILE'S WHOLE LIST, framed — an empty `diagnostics` array is the
// only way a client is told an error is gone. THE TEXT IS THE FILE'S
// OWN: converting a span against another file's bytes would underline
// the right file at the wrong position.
publish* = (a: Alloc, uri: str, text: str, spots: Vec<Spot>, out :: String)
           Res<(), AllocError> {
    body ::= a.String().try();
    write_notification(a, uri, text, spots, body).try();
    write_frame(body.view(), out)
}

// `textDocument/publishDiagnostics`, as the protocol spells it. A
// NOTIFICATION AND NOT A REPLY: no `id`, the one message this server
// sends unprompted.
write_notification = (
    a: Alloc,
    uri: str,
    text: str,
    spots: Vec<Spot>,
    body :: String
) Res<(), AllocError> {
    body.add_bytes(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":"
    ).try();
    write_text(uri, body).try();
    body.add_bytes(",\"diagnostics\":[").try();
    n ::= 0;
    spots.loop((h, s) { n = one_of(s, uri, text, n, body).try(); });
    body.add_bytes("]}}")
}

// This spot, if it belongs to this file, and the count so it can tell
// whether a comma comes first.
one_of = (s: Spot, uri: str, text: str, n: usize, out :: String)
         Res<usize, AllocError> {
    s.uri.eq(uri).match({
        false => Ok(n),
        true  => written_at(s, text, n, out),
    })
}

written_at = (s: Spot, text: str, n: usize, out :: String)
             Res<usize, AllocError> {
    comma(n, out).try();
    write_spot(s, text, out).try();
    Ok(n + 1);
}

comma = (n: usize, out :: String) Res<(), AllocError> {
    (n > 0).match({ true  => out.add_bytes(","), false => written() })
}

write_spot = (s: Spot, text: str, out :: String) Res<(), AllocError> {
    out.add_bytes("{\"range\":").try();
    write_range(text, s.span, out).try();
    out.add_bytes(",\"severity\":").try();
    write_decimal(ERROR, out).try();
    out.add_bytes(",\"source\":\"zen\",\"message\":").try();
    write_text(s.message, out).try();
    write_note(s, text, out).try();
    out.add_bytes("}")
}

// THE NOTE, AS THE SECOND PLACE TO LOOK. THE NOTE'S URI IS THE
// DIAGNOSTIC'S: `parse_diag.zen`'s only builder of a note,
// `expect_close`, anchors on the opening delimiter of the same file it
// is reading — reusing the URI already in hand avoids a second
// path-to-URI conversion that could disagree.
write_note = (s: Spot, text: str, out :: String) Res<(), AllocError> {
    s.note.match({
        None  => written(),
        Ok(n) => write_related(s.uri, n, text, out),
    })
}

write_related = (uri: str, n: Note, text: str, out :: String)
                Res<(), AllocError> {
    out.add_bytes(",\"relatedInformation\":[{\"location\":{\"uri\":").try();
    write_text(uri, out).try();
    out.add_bytes(",\"range\":").try();
    write_range(text, n.span, out).try();
    out.add_bytes("},\"message\":").try();
    write_text(n.message, out).try();
    out.add_bytes("}]")
}

// `DiagnosticSeverity.Error` — the constant that changes the day there
// is a second severity.
ERROR*: usize = 1
