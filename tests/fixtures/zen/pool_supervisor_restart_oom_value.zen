// HAZARD 2: a supervisor whose RESTART cannot allocate must get a VALUE, not a process abort.
//
// `supervise` `.expect`s internally, so an out-of-memory during a restart — which happens MID-RUN, under
// exactly the memory pressure that killed the child — killed the whole process. `try_supervise` returns
// `Result<Child<ActorT>, ActorError>` instead, and the ORDER inside it (spawn the replacement BEFORE
// freeing the dead instance) is what makes the `.Err` actionable: the caller's own `Child` value is still
// intact, so it can RETRY once the pressure lifts. This fixture proves both halves — the failure is a
// value, and the retry actually brings the agent back.
//
// DETERMINISTIC INJECTION: the child's mailbox ring is `CAP * 8` = 313*8 = 2504 bytes, a size unique in
// this program, so `FAIL_SIZE=2504` targets exactly the spawn path. `FAIL_SKIP=1 FAIL_COUNT=1` fails only
// the SECOND such allocation: the initial `start_child` succeeds, the first restart is out of memory, and
// the retry succeeds. Size-and-occurrence targeting (not a global FAIL_AT counter) is what makes this
// reproducible in a program with worker threads racing for allocations.
//
// TIMELINE: Work(10) → Poison (divide by zero → actor DEAD) → try_supervise #1 → `.Err(.Oom)`
//   → try_supervise #2 → `.Ok(fresh child)` → Work(5) handled by the restarted instance.
//
// Asserted by the `pool_supervisor_restart_oom_value` shell case:
//   uninjected                            -> exit 41 (restart succeeds first try; no `.Err` observed)
//   FAIL_SIZE=2504 FAIL_SKIP=1 FAIL_COUNT=1 -> exit 42 (restart #1 REFUSED as a value, retry recovered)
{ pool_open, pool_actor_dead, Pool } = std.concurrent.pool
{ malloc, free } = std.mem.alloc
{ dispatch } = std.concurrent.pool_actor    // destructured: the faithful formatter accepts an unqualified generic call
pa = std.concurrent.pool_actor
{ Context, Receiver } = std.concurrent.pool_actor
WORKERS := 2
CAP := 313    // mailbox ring = 313*8 = 2504 bytes — the injection target, unique in this program
Msg*: Work(i64) | Poison(i64)
Agent*: {
    acc: RawPtr<u8>,
    seen: i64,
}
Agent.impl(Receiver, {
    receive = (a: MutPtr<Agent>, ctx: Context<Msg>) void {
        ctx.msg.match ({
            .Work(n)   => {
                atomic_add_i64(a.acc, n)
                a.seen = a.seen + 1
            },
            .Poison(d) => {
                boom := 100 / d    // d == 0 → integer divide by zero → PANIC; the worker marks the actor dead
                atomic_add_i64(a.acc, boom)
            },
        })
    }
})    // Poison's body is unreached past the divide
tramp = (user: RawPtr<u8>, msg: i64) void { dispatch<Agent, Msg>(user, msg) }
main = () i32 {
    acc := assert_nonnull(malloc(8))
    store_i64(acc, 0)
    spec := pa.child_spec(CAP, Agent(
        acc: acc,
        seen: 0,
    ), tramp, pa.permanent())
    child0 := pa.start_child(spec)
    p := pool_open(WORKERS, 16)
    p.send(child0.handle, Msg.Work(10))
    p.send(child0.handle, Msg.Poison(0))
    p.pool_quiesce()
    crashed := pool_actor_dead(child0.handle.raw)
    // RESTART ATTEMPT #1 — out of memory under injection. The `.Err` leaves `child0` untouched and usable.
    r1 := child0.try_supervise()
    refused := r1.match ({
        .Ok(c)  => false,
        .Err(e) => true,
    })
    after1 := r1.match ({
        .Ok(c)  => c,
        .Err(e) => child0,
    })
    // RESTART ATTEMPT #2 — the pressure has lifted; the retry is what makes the `.Err` ACTIONABLE.
    r2 := after1.try_supervise()
    child1 := r2.match ({
        .Ok(c)  => c,
        .Err(e) => after1,
    })
    recovered := r2.match ({
        .Ok(c)  => true,
        .Err(e) => false,
    })
    restarted := child1.restarts == 1
    p.send(child1.handle, Msg.Work(5))
    p.pool_quiesce()
    acc_total := load_i64(acc)
    fresh_seen := pa.actor_state(child1.handle).seen
    still_alive := pool_actor_dead(child1.handle.raw) == false
    p.pool_quiesce_stop()
    pa.close(child1.handle)
    p.pool_close()
    free(acc)
    ok := crashed && recovered && restarted && acc_total == 15 && fresh_seen == 1 && still_alive
    ok.match ({
        true  => refused.then({ 42 }, { 41 }),
        false => 1,
    })
}
