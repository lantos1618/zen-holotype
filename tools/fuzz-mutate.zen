// tools/fuzz-mutate.zen — the mutation engine behind scripts/fuzz-run.sh, written in Zen.
//
//   ./zen run tools/fuzz-mutate.zen ITERS PER CRASH_DIR ASAN_BIN SEED...
//
// Same positional argv as the scripts/fuzz_mutate.py it replaces. Each iteration picks a random seed,
// applies 1..6 random byte/structure mutations, caps the result at 1 MiB, writes it to
// /tmp/fuzz_mutate_in.zen and runs `ASAN_BIN check` on it under a `timeout PER`. Anything that trips a
// sanitizer banner, dies by signal (exit >= 128), or hangs is recorded in CRASH_DIR, deduped by
// failure signature. Exit status is 1 when there is any finding and 0 otherwise — findings FAIL the
// run, which is what fuzz-run.sh's status reports.
//
// TWO DELIBERATE DIVERGENCES FROM THE PYTHON, both outside the contract:
//   • The mutation STREAM differs. Python drove Mersenne Twister self-seeded from OS entropy, so every
//     campaign explored new mutations but no finding could be replayed. This drives std.rand's
//     xoshiro256** from the wall clock — same exploration — and PRINTS the seed, which `FUZZ_SEED=<n>`
//     replays exactly. The probability BANDS (0.25/0.45/0.65/0.80/0.92) and the op set are identical.
//   • The dedupe signature is sha256's first 12 hex chars, not sha1's. The signature is an opaque
//     within-run dedupe key — nothing reads it back or compares it across runs — so the hash choice is
//     free; the KEY it is computed from (failure class + first `#1` frame) is unchanged.
// The contract — what counts as a hit, what gets deduped, the crash-file names, the printed lines and
// the exit status — is preserved exactly.
//
// TIMEOUTS: Python used subprocess timeout=PER then re-confirmed at PER*4. Here the shell's coreutils
// `timeout` does it: exit 124 means the budget blew. A first 124 is re-run at PER*4, and only a SECOND
// 124 is a hang (an ASan run can blow a tight budget under CPU contention without looping forever).
{ arg, argc, clock_ms } = std.sys.os
{ Malloc } = std.mem.alloc
{ close, getenv, memcpy, memmove, open, write } = std.c.libc
{ contents_bytes_in, MODE_644, O_WRTRUNC, save } = std.io.file
{ run } = std.sys.process
{ of } = std.mem.raw
{ Rng, seed } = std.rand
{ sha256_hex } = std.hash
{ cat_in, find, len, parse_int, split_in, substr_in, view } = std.text.str
{ finish_in } = std.text.string
{ integer_in } = std.text.num
{ sb } = std.text.sb
{ expect, or } = std.core.result
{ then } = std.core.bool
{ arg_int, arg_str, format } = std.text.fmt
// The mutation scratch buffer holds 1 MiB of output plus slack for the inserts still in flight (an op
// can add at most 500 bytes and there are at most 6 per iteration); everything is clamped to it, so a
// pathological seed truncates rather than running off the end.
BUF_CAP = to_i64(2097152)
OUT_CAP = to_i64(1048576)    // 1 << 20 — the Python's `bytes(b[:1 << 20])` cap
TMP_IN = "/tmp/fuzz_mutate_in.zen"
// The unambiguous sanitizer banners — NOT bare words like "stack-overflow", which the compiler echoes
// back when a fuzzed input happens to contain that text in a comment (a false positive).
G_HIT = ["ERROR: AddressSanitizer:", "SUMMARY: AddressSanitizer", "SUMMARY: UndefinedSanitizer", "runtime error:"]
// The failure classes that name a signature, in the alternation order the Python's regex used: a tie
// on position is broken by this order, and the leftmost match wins overall.
G_CLASS = ["heap-buffer-overflow", "stack-buffer-overflow", "global-buffer-overflow", "heap-use-after-free", "stack-overflow", "SEGV", "runtime error:", "stack-use-after-return"]
CLASS_RUNTIME = to_i64(6)    // index of "runtime error:" — the one class whose match runs to end-of-line
FRAME_HEAD = "#1 0x"
FRAME_SEP = " in "
// A global takes its type from its initializer (a bare `0` is i32, a bare `""` is StringLiteral), so
// the i64 counters and the StringView slots are seeded through these two zero-values.
zero = () i64 { 0 }
empty_sv = () StringView { "" }
// configuration, resolved once from argv
g_iters ::= zero()
g_per ::= zero()
g_cr ::= empty_sv()
g_cmd_fast ::= empty_sv()    // timeout PER   ASAN check TMP 2>&1
g_cmd_slow ::= empty_sv()    // timeout PER*4 ASAN check TMP 2>&1
// running state (module-level mutable globals, the shape tools/sigs.zen and tools/check-docs.zen use)
g_len ::= zero()    // live byte count in the mutation buffer
g_iter ::= zero()
g_hits ::= zero()
g_hangs ::= zero()
g_hang_seen ::= false
g_seen ::= empty_sv()    // "|sig|sig|…" — membership is a find of the delimited key
imin = (a: i64, b: i64) i64 { (a < b).then({ a }, { b }) }
imax = (a: i64, b: i64) i64 { (a > b).then({ a }, { b }) }
itos = (mp: MutPtr<Malloc>, n: i64) StringView {
    mp
        .integer_in(n)
        .expect("fuzz-mutate: oom")
        .finish_in(mp)
        .expect("fuzz-mutate: oom")
}
// ── raw byte IO ───────────────────────────────────────────────────────────────
// The mutated input is arbitrary bytes — NUL and 0xff included — so it cannot go through the
// str-shaped writers (std.io.file.save measures its data with strlen and would stop at the first NUL).
// Write the exact byte count straight to the fd instead.
write_bytes = (path: StringView, b: [u8]) i64 {
    fd = path.open(O_WRTRUNC, MODE_644)
    (fd < 0).match ({
        true  => 0 - 1,
        false => {
            w = fd.write(b.ptr, b.len)
            fd.close()
            w
        },
    })
}
// ── byte-level scanning (the compiled-output searches that `find` cannot do on a str) ─────────────
bytes_has_at = (v: [u8], p: Slice<u8>, at: i64) bool {
    ok ::= at >= 0 && at + p.len <= v.len
    p.loop((h, i, b) {
        ok.then({
            (v[at + i] == b == false).then({
                ok = false
            })
        })
    })
    ok
}
bytes_find_from = (v: [u8], p: Slice<u8>, start: i64) i64 {
    res ::= 0 - 1
    v.loop((h, i, b) {
        (i >= start && v.bytes_has_at(p, i)).then({
            res = i
            h.break
        })
    })
    res
}
is_hex_lc = (b: u8) bool { b >= '0' && b <= '9' || b >= 'a' && b <= 'f' }
is_ident = (b: u8) bool {
    b >= '0' && b <= '9' || b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z' || b == '_'
}
// recursion depth = the run's own length (a hex address, an identifier) — short and bounded
hex_run_end = (v: [u8], i: i64) i64 {
    (i < v.len && is_hex_lc(v[i])).then({ v.hex_run_end(i + 1) }, { i })
}
ident_run_end = (v: [u8], i: i64) i64 {
    (i < v.len && is_ident(v[i])).then({ v.ident_run_end(i + 1) }, { i })
}
// ── the mutation ops ──────────────────────────────────────────────────────────
MOp: Flip | Trunc | Ins | Dup | Del | Over
// the Python's probability bands, unchanged: <0.25 flip, <0.45 truncate, <0.65 insert, <0.80
// duplicate, <0.92 delete, else overwrite
pick_op = (p: f64) MOp {
    (p < 0.25).match ({
        true  => MOp.Flip,
        false => (p < 0.45).match ({
            true  => MOp.Trunc,
            false => (p < 0.65).match ({
                true  => MOp.Ins,
                false => (p < 0.80).match ({
                    true  => MOp.Dup,
                    false => (p < 0.92).then({ MOp.Del }, { MOp.Over }),
                }),
            }),
        }),
    })
}
pick_tok = (rp: MutPtr<Rng>, toks: [[u8]]) [u8] {
    t: [u8] = toks[rp.range(0, toks.len)]
    t
}
// how many of `want` bytes still fit under BUF_CAP
room = (want: i64) i64 { imin(want, BUF_CAP - g_len) }
// open a gap of `m` bytes at `i`, sliding the tail right
shift_right = (b: [u8], i: i64, m: i64) void {
    memmove(b.ptr.offset(i + m), b.ptr.offset(i), g_len - i)
    g_len = g_len + m
}
op_flip = (rp: MutPtr<Rng>, b: [u8], i: i64) void {
    b[i] = to_u8(to_i64(b[i]) ^ 1 << rp.range(0, 8))
}
op_ins = (b: [u8], i: i64, t: [u8]) void {
    m = room(t.len)
    (m > 0).then({
        b.shift_right(i, m)
        memcpy(b.ptr.offset(i), t.ptr, m)
    })
}
// `b[i:i] = b[i:j]` — the duplicated span lands at i+m after the shift, so it copies back from there
op_dup = (rp: MutPtr<Rng>, b: [u8], i: i64) void {
    j = imin(g_len, i + rp.range(1, 129))
    m = room(j - i)
    (m > 0).then({
        b.shift_right(i, m)
        memcpy(b.ptr.offset(i), b.ptr.offset(i + m), m)
    })
}
op_del = (rp: MutPtr<Rng>, b: [u8], i: i64) void {
    e = imin(g_len, i + rp.range(1, 65))
    memmove(b.ptr.offset(i), b.ptr.offset(e), g_len - e)
    g_len = g_len - (e - i)
}
// `b[i:i + len(t)] = t` — same length in the middle, extends the buffer when it lands past the end
op_over = (b: [u8], i: i64, t: [u8]) void {
    m = imin(t.len, BUF_CAP - i)
    (m > 0).then({
        memcpy(b.ptr.offset(i), t.ptr, m)
        g_len = imax(g_len, i + m)
    })
}
apply_op = (rp: MutPtr<Rng>, toks: [[u8]], b: [u8], op: MOp, i: i64) void {
    op.match ({
        .Flip  => rp.op_flip(b, i),
        .Trunc => {
            g_len = i
        },
        .Ins   => b.op_ins(i, rp.pick_tok(toks)),
        .Dup   => rp.op_dup(b, i),
        .Del   => rp.op_del(b, i),
        .Over  => b.op_over(i, rp.pick_tok(toks)),
    })
}
// an emptied buffer is refilled with a whole token, exactly as the Python's `if not b` branch does
mutate_step = (rp: MutPtr<Rng>, toks: [[u8]], b: [u8]) void {
    (g_len <= 0).match ({
        true  => {
            t = rp.pick_tok(toks)
            memcpy(b.ptr, t.ptr, t.len)
            g_len = t.len
        },
        false => {
            p = rp.next_f64()
            i = rp.range(0, g_len)
            rp.apply_op(toks, b, pick_op(p), i)
        },
    })
}
mutate_n = (rp: MutPtr<Rng>, toks: [[u8]], b: [u8], k: i64) void {
    (k > 0).then({
        rp.mutate_step(toks, b)
        rp.mutate_n(toks, b, k - 1)
    })
}
mutate = (rp: MutPtr<Rng>, toks: [[u8]], b: [u8], src: [u8]) void {
    g_len = imin(src.len, BUF_CAP)
    (g_len > 0).then({
        memcpy(b.ptr, src.ptr, g_len)
    })
    rp.mutate_n(toks, b, rp.range(1, 7))
    g_len = imin(g_len, OUT_CAP)
}
// ── classification ────────────────────────────────────────────────────────────
is_hit = (s: StringView) bool {
    got ::= false
    G_HIT.loop((h, i, p) {
        (s.find(p) >= 0).then({
            got = true
            h.break
        })
    })
    got
}
clip100 = (mp: MutPtr<Malloc>, s: StringView) StringView {
    (s.len() > 100).then({ mp.substr_in(s, 0, 100).expect("fuzz-mutate: oom") }, { s })
}
first_hit_line = (mp: MutPtr<Malloc>, out: StringView) StringView {
    res :: StringView = ""
    lines = mp.split_in(out, '\n')
    lines.loop((h, i, l) {
        is_hit(l).then({
            res = mp.clip100(l)
            h.break
        })
    })
    res
}
// `runtime error:[^\n]*` — the class text runs to the end of its line
line_from = (mp: MutPtr<Malloc>, out: StringView, pos: i64) StringView {
    v: [u8] = out.view()
    e ::= v.len
    v.loop((h, i, b) {
        (i >= pos && b == '\n').then({
            e = i
            h.break
        })
    })
    mp.substr_in(out, pos, e - pos).expect("fuzz-mutate: oom")
}
// the leftmost failure class in `out`, ties broken by G_CLASS order (the regex alternation's rule);
// with no class at all the key falls back to the Python's `sig%d` of the exit code
class_key = (mp: MutPtr<Malloc>, out: StringView, rc: i64) StringView {
    best ::= 0 - 1
    bi ::= 0 - 1
    G_CLASS.loop((h, i, p) {
        at = out.find(p)
        (at >= 0 && (bi < 0 || at < best)).then({
            best = at
            bi = i
        })
    })
    (bi < 0).match ({
        true  => mp.cat_in("sig", mp.itos(rc)),
        false => (bi == CLASS_RUNTIME).then({ mp.line_from(out, best) }, { G_CLASS[bi] }),
    })
}
// `#1 0x[0-9a-f]+ in ([A-Za-z0-9_]+)` — the first non-asan frame's function name, "?" when absent.
// Recursion depth = the number of "#1 0x" occurrences in the report (one, in practice).
frame_from = (mp: MutPtr<Malloc>, out: StringView, v: [u8], hv: Slice<u8>, start: i64) StringView {
    p = v.bytes_find_from(hv, start)
    (p < 0).match ({
        true  => "?",
        false => {
            q = v.hex_run_end(p + hv.len)
            fit = q > p + hv.len && v.bytes_has_at(FRAME_SEP.view(), q)
            ns = q + FRAME_SEP.len()
            ne = fit.then({ v.ident_run_end(ns) }, { ns })
            (fit && ne > ns).match ({
                true  => mp.substr_in(out, ns, ne - ns).expect("fuzz-mutate: oom"),
                false => mp.frame_from(out, v, hv, p + 1),
            })
        },
    })
}
frame_key = (mp: MutPtr<Malloc>, out: StringView) StringView {
    v: [u8] = out.view()
    hv: Slice<u8> = FRAME_HEAD.view()
    mp.frame_from(out, v, hv, 0)
}
// the dedupe key: `<class>@<frame>`, hashed and truncated to 12 hex chars. OPAQUE — it never leaves
// the run, so sha256-instead-of-sha1 changes nothing a caller can observe.
sig_of = (mp: MutPtr<Malloc>, out: StringView, rc: i64) StringView {
    key = mp.cat_in(mp.cat_in(mp.class_key(out, rc), "@"), mp.frame_key(out))
    mp.substr_in(mp.sha256_hex(key.view()), 0, 12).expect("fuzz-mutate: oom")
}
// ── reporting ─────────────────────────────────────────────────────────────────
say_hit = (s: StringView, rc: i64, first: StringView) void {
    format("[{}] HIT {} rc={}: {} -> crash_{}.zen\n", [arg_int(g_iter), arg_str(s), arg_int(rc), arg_str(first), arg_str(s)])
}
say_hang = () void {
    format("[{}] HANG (>{}s) -> hang_{}.zen\n", [arg_int(g_iter), arg_int(g_per * 4), arg_int(g_iter)])
}
say_progress = () void {
    format("...{}/{} ({} unique hits, {} hangs)\n", [arg_int(g_iter), arg_int(g_iters), arg_int(g_hits), arg_int(g_hangs)])
}
say_done = () void {
    format("done: {} iters, {} unique sanitizer hits, {} hangs -> {}\n", [arg_int(g_iter), arg_int(g_hits), arg_int(g_hangs), arg_str(g_cr)])
}
crash_path = (mp: MutPtr<Malloc>, s: StringView, ext: StringView) StringView {
    mp.cat_in(mp.cat_in(mp.cat_in(g_cr, "/crash_"), s), ext)
}
record_hit = (mp: MutPtr<Malloc>, data: [u8], out: StringView, rc: i64) void {
    s = mp.sig_of(out, rc)
    key = mp.cat_in(mp.cat_in("|", s), "|")
    (g_seen.find(key) >= 0 == false).then({
        g_seen = mp.cat_in(g_seen, key)
        g_hits = g_hits + 1
        mp.crash_path(s, ".zen").write_bytes(data)
        save(mp.crash_path(s, ".log"), out, out.len()).or(0)
        say_hit(s, rc, mp.first_hit_line(out))
    })
}
// only the FIRST hang is recorded — the Python keeps one "hang" entry in the same dedupe set
record_hang = (mp: MutPtr<Malloc>, data: [u8]) void {
    (g_hang_seen == false).then({
        g_hang_seen = true
        g_hangs = g_hangs + 1
        mp.cat_in(mp.cat_in(mp.cat_in(g_cr, "/hang_"), mp.itos(g_iter)), ".zen").write_bytes(data)
        say_hang()
    })
}
// a first 124 is only a suspicion; re-run at 4x and let a second 124 settle it
reconfirm = (mp: MutPtr<Malloc>, data: [u8]) void {
    r = mp.run(g_cmd_slow).expect("fuzz-mutate: cannot run the compiler")
    (r.exit == 124).then({
        mp.record_hang(data)
    })
}
// a sanitizer report, OR a crash-signal exit (>= 128, e.g. 139 SEGV / 134 SIGABRT)
classify = (mp: MutPtr<Malloc>, data: [u8], out: StringView, rc: i64) void {
    (is_hit(out) || rc >= 128).then({
        mp.record_hit(data, out, rc)
    })
}
one_iter = (mp: MutPtr<Malloc>, rp: MutPtr<Rng>, toks: [[u8]], b: [u8], seeds: [[u8]]) void {
    g_iter = g_iter + 1
    src: [u8] = seeds[rp.range(0, seeds.len)]
    rp.mutate(toks, b, src)
    data: [u8] = b.ptr.slice(g_len)
    TMP_IN.write_bytes(data)
    r = mp.run(g_cmd_fast).expect("fuzz-mutate: cannot run the compiler")
    (r.exit == 124).then({ mp.reconfirm(data) }, { mp.classify(data, r.stdout, r.exit) })
    (g_iter % 1000 == 0).then({
        say_progress()
    })
}
// ── setup ─────────────────────────────────────────────────────────────────────
// "9" * 300, "0x" + "f" * 200, "a" * 500 … — a prefix plus a repeated run, as one byte slice
rep_tok = (mp: MutPtr<Malloc>, pre: StringView, s: StringView, n: i64) Slice<u8> {
    mp
        .sb()
        .s(pre)
        .rep(s, n)
        .done()
        .expect("fuzz-mutate: oom")
        .view()
}
// The 0x00 and 0xff tokens are built by hand: a NUL is not expressible as a str (it terminates one),
// and `zen fmt` rewrites a `"\xff"` escape into a raw 0xff byte, which would leave this source file
// non-UTF-8.
byte_tok = (mp: MutPtr<Malloc>, v: i64) [u8] {
    p :: [u8] = assert_nonnull(mp.acquire(1)).slice(1)
    p[0] = to_u8(v)
    p
}
// Adversarial tokens: unbalanced openers, huge digit/identifier runs, stray quotes/escapes, and Zen
// keywords that drive the deepest parser/checker paths (match/loop/impl/generics).
make_tokens = (mp: MutPtr<Malloc>) [[u8]] {
    ts: [[u8]] = ["{".view(), "[".view(), "(".view(), "<".view(), "}".view(), "]".view(), ")".view(), ">".view(), "\"".view(), "'".view(), "\\".view(), "`".view(), mp.rep_tok("", "9", 300), mp.rep_tok("0x", "f", 200), mp.rep_tok("", "a", 500), mp.rep_tok("", ".", 64), mp.rep_tok("", "=", 32), "match".view(), ".loop".view(), "impl".view(), "return".view(), "=>".view(), "<T>".view(), "::".view(), "or_return".view(), byte_tok(mp, 0), byte_tok(mp, 255), "//".view(), "/*".view(), "*/".view(), "\n\t".view(), mp.rep_tok("", "_", 100)]
    // the literal has automatic storage; copy it onto the heap so it outlives this frame
    out :: [[u8]] = of(ts[0], ts.len)
    ts.loop((h, i, t) {
        out[i] = t
    })
    out
}
load_seeds = (mp: MutPtr<Malloc>, first: i32) [[u8]] {
    n = to_i64(argc()) - to_i64(first)
    out :: [[u8]] = of(mp.contents_bytes_in(arg(first)).expect("fuzz-mutate: unreadable seed"), n)
    out.loop((h, i, x) {
        out[i] = mp.contents_bytes_in(arg(first + to_i32(i))).expect("fuzz-mutate: unreadable seed")
    })
    out
}
// `timeout <secs> <ASAN> check <TMP_IN> 2>&1` — the shell gives us the combined streams and coreutils
// `timeout` gives us exit 124 on a blown budget
cmd_for = (mp: MutPtr<Malloc>, asan: StringView, secs: i64) StringView {
    mp
        .sb()
        .s("timeout ")
        .i(secs)
        .s(" ")
        .s(asan)
        .s(" check ")
        .s(TMP_IN)
        .s(" 2>&1")
        .done()
        .expect("fuzz-mutate: oom")
}
// The mutation stream's seed. Default: the wall clock, so successive campaigns explore DIFFERENT
// mutations — the property the entropy-seeded Python had, and the whole point of running the fuzzer
// twice. Unlike the Python, the seed is PRINTED, and `FUZZ_SEED=<n>` replays that exact stream, so a
// finding is reproducible instead of merely lucky.
rng_seed = () i64 {
    p = getenv("FUZZ_SEED")
    (p == null_ptr()).then({ clock_ms() }, { cstr(p).parse_int() })
}
usage = () i32 {
    format("usage: fuzz-mutate ITERS PER CRASH_DIR ASAN_BIN SEED...\n", [])
    2
}
fuzz = (mp: MutPtr<Malloc>) i32 {
    g_iters = arg(1).parse_int()
    g_per = arg(2).parse_int()
    g_cr = arg(3)
    g_cmd_fast = mp.cmd_for(arg(4), g_per)
    g_cmd_slow = mp.cmd_for(arg(4), g_per * 4)
    toks = mp.make_tokens()
    seeds = mp.load_seeds(5)
    sd = rng_seed()
    format("fuzz-mutate: seed={} (FUZZ_SEED={} replays this exact stream)\n", [arg_int(sd), arg_int(sd)])
    r = seed(sd)
    rp = r.addr()
    b: [u8] = assert_nonnull(mp.acquire(BUF_CAP)).slice(BUF_CAP)
    ticks: [u8] = assert_nonnull(mp.acquire(imax(g_iters, 1))).slice(imax(g_iters, 1))
    ticks.loop((h, i, x) {
        (i < g_iters).then({
            mp.one_iter(rp, toks, b, seeds)
        })
    })
    say_done()
    (g_hits > 0 || g_hangs > 0).then({ 1 }, { 0 })
}
main = () i32 {
    m = Malloc(_: 0)
    mp = m.addr()
    (argc() < 6).then({ usage() }, { mp.fuzz() })
}
