word = (env: Env, letters: str) Res<str, AllocError> {
    alloc ::= env.mem.alloc();
    buf   ::= alloc.String().try();
    buf.add(letters).try();
    output: str ::= "";
    output = buf.view();
    Ok(output)
}
main = (env: Env) Res<i32, AllocError> {
    a = word(env, "ab").try();
    println("{}", a);
    Ok(0)
}
