// compiler.check_lower — statement-position match/cond → if lowering. Extracted from compiler.check (pure move).
{ Expr, Stmt, Decl, Ty, EnumDecl, ArmData, MatchData, CondData } = compiler.ast.ast_types
{ cbuf, bin, cond, member, arrow, mktag, slett, sexpr, sif, block, gstr_string, gstr_append,
  gstr_finish } = compiler.genc
{ Allocator } = std.mem.alloc
{ one_stmt, slice_any } = compiler.astops
{ Env, arm_env, cenode, extend_env, no_stmts } = compiler.check
{ loop_at } = std.core.count
match_has_wild = (m: MatchData) bool { m.arms.slice_any((ar) { ar.variant == "_" }) }
arm_covers_v = (m: MatchData, vn: StringView) bool { m.arms.slice_any((ar) { ar.variant == vn }) }
ed_covered = (ed: EnumDecl, m: MatchData) bool {
    all ::= true
    ed.variants.loop_at((i, v) { all = m.arm_covers_v(v.name).then({ all }, { false }) })
    all
}
enum_exhaustive = (decls: [Decl], m: MatchData) bool {
    found ::= false
    decls.loop_at((i, d) {
        found = d.match ({
            .DEnum(ed) => (ed.name == m.ename).then({ ed.ed_covered(m) }, { found }),
            _          => found,
        })
    })
    found
}
match_lowerable = (decls: [Decl], m: MatchData) bool {
    match_has_wild(m).then({ true }, { decls.enum_exhaustive(m) })
}
branch_stmts = (a: Allocator, env: Env, e: Ptr<Expr>) [Stmt] {
    out ::= a.one_stmt(a.lower_stmt_expr(env, e))
    load(e).match ({
        .Block(b) => {
            out = a.relower_block_tail(env, b.stmts)
        },
        _         => { },
    })
    out
}
// Re-lower the TAIL statement of a discarded (statement-position) arm body. The arm body was resolved
// as a VALUE (its `exp` kept so inner `return .Err(x)` infers the right enum), so a tail match/cond is
// still a value Match/Cond node — in discarded position its arm `return`s would be flattened to value
// exprs and silently dropped. Re-running the stmt lowering on the tail keeps those returns as real
// control flow, and recurses through branch_stmts into arbitrarily-nested arm tails. Non-tail statements
// keep their resolved form (already lowered with last=false); only their bindings thread into the env.
relower_tail_stmt = (a: Allocator, env: Env, st: Stmt) Stmt {
    st.match ({
        .ExprStmt(e) => a.lower_stmt_expr(env, e),
        _            => st,
    })
}
env_over = (a: Allocator, env: Env, stmts: [Stmt], upto: i64) Env {
    out ::= env
    stmts.loop_at((i, st) { out = (i < upto).then({ a.extend_env(out, st) }, { out }) })
    out
}
relower_block_tail = (a: Allocator, env: Env, stmts: [Stmt]) [Stmt] {
    n = stmts.len
    (n == 0).match ({
        true  => stmts,
        false => {
            buf ::= cbuf<Stmt>(a, n)
            envT = a.env_over(env, stmts, n - 1)
            stmts.loop_at((i, st) {
                buf[i] = (i == n - 1).then({ a.relower_tail_stmt(envT, st) }, { st })
            })
            buf
        },
    })
}
tag_const* = (a: Allocator, ename: StringView, variant: StringView) StringView {
    s ::= a.gstr_string(64)
    s = s.gstr_append(a, ename)
    s = s.gstr_append(a, "_")
    s = s.gstr_append(a, variant)
    s.gstr_finish(a)
}
subj_tag* = (a: Allocator, subj: Ptr<Expr>, ptr: bool) Ptr<Expr> {
    out ::= a.cenode(member(subj, "tag"))
    ptr.then({
        out = a.cenode(arrow(subj, "tag"))
    })
    out
}
subj_payload* = (a: Allocator, subj: Ptr<Expr>, variant: StringView, ptr: bool) Ptr<Expr> {
    u ::= a.cenode(member(subj, "u"))
    ptr.then({
        u = a.cenode(arrow(subj, "u"))
    })
    a.cenode(member(u, variant))
}
arm_then = (a: Allocator, env: Env, t: Ty, m: MatchData, ar: ArmData) [Stmt] {
    body = a.branch_stmts(a.arm_env(env, t, ar), ar.body)
    out ::= body
    (ar.bind == "" == false).then({
        // TYPED payload let (not bare slet): without the concrete payload type, a later light/inline
        // inference can't recover the binding's type from the enum union access (`e.u.Num`), so a
        // generic call on it (`println(n)`) fails to monomorphize → link error. Same fix the or_return
        // lowering already uses (slett with subj_variant_payload). Void payload type falls back to slet.
        out = a.cons_stmt(slett(ar.bind, env.subj_variant_payload(t, ar.variant), a.subj_payload(m.subj, ar.variant, m.ptr)), body)
    })
    out
}
cons_stmt = (a: Allocator, head: Stmt, rest: [Stmt]) [Stmt] {
    buf ::= cbuf<Stmt>(a, rest.len + 1)
    buf[0] = head
    rest.loop_at((i, st) { buf[i + 1] = st })
    buf
}
// Build if/else chain over enum arms.
lower_match_arms = (a: Allocator, env: Env, t: Ty, m: MatchData, i: i32) [Stmt] {
    out ::= no_stmts()
    (i >= m.arms.len == false).then({
        ar = m.arms[i]
        (ar.variant == "_").match ({
            true  => {
                out = a.branch_stmts(env, ar.body)
            },
            false => {
                // Keep the tag as a semantic Tag node. C folds `.tag` to its enum constant, while JS
                // emits the variant string; baking a C-only `Enum_Variant` Var breaks the JS backend.
                tag = a.subj_tag(a.cenode(mktag(m.ename, ar.variant)), false)
                cond = a.cenode(bin("==", a.subj_tag(m.subj, m.ptr), tag))
                out = a.one_stmt(sif(cond, a.arm_then(env, t, m, ar), a.lower_match_arms(env, t, m, i + 1)))
            },
        })
    })
    out
}
lower_match_stmt = (a: Allocator, env: Env, m: MatchData) Stmt {
    t = env.infer_expr(m.subj)
    stmts = a.lower_match_arms(env, t, m, 0)
    out ::= sexpr(a.cenode(block(stmts)))
    (stmts.len == 1).then({
        out = stmts[0]
    })
    out
}
// Bool/literal match in statement position: Cond -> if/else, recursing for literal chains.
lower_cond_stmt = (a: Allocator, env: Env, d: CondData) Stmt {
    sif(d.c, a.branch_stmts(env, d.t), a.cond_else(env, d.e))
}
cond_else = (a: Allocator, env: Env, e: Ptr<Expr>) [Stmt] {
    out ::= a.branch_stmts(env, e)
    load(e).match ({
        .Cond(d) => {
            out = a.one_stmt(a.lower_cond_stmt(env, d))
        },
        _        => { },
    })
    out
}
// Lower resolved statement-position expressions whose values are discarded.
lower_stmt_expr* = (a: Allocator, env: Env, e: Ptr<Expr>) Stmt {
    out ::= sexpr(e)
    load(e).match ({
        .Match(m) => env.decls.match_lowerable(m).match ({
            true  => {
                out = a.lower_match_stmt(env, m)
            },
            false => {
                out = sexpr(e)
            },
        }),
        .Cond(d)  => {
            // A one-armed `.match` must survive into validation so it cannot silently become an if with
            // an invented no-op branch. `.then` and explicit two-arm matches carry oa=0 and lower normally.
            out = (d.oa == 0).then({ a.lower_cond_stmt(env, d) }, { sexpr(e) })
        },
        _         => {
            out = sexpr(e)
        },
    })
    out
}
