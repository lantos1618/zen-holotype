// C keyword collisions, part 1 of 3: the 32 keywords of C89.
//
// Zen has no control-flow keywords at all — `.match` is a method, `loop`
// is a function, `then` is a ufcs function on bool — so every name below
// is an ordinary, legal, unremarkable Zen identifier that somebody will
// write. `register` is the one that hurts: it reads as a perfectly good
// variable name and it is a hard C syntax error, not a warning.
//
// the list IS the test. a keyword missing from this file is a keyword the
// mangler is allowed to miss, so it is enumerated in full and in order.
//
// two ways this goes red, both wanted:
//   - a name reaches C unmangled       -> the C compiler rejects the file
//   - two names mangle to one C name   -> redefinition, or the sum moves

main = (env: Env) Res<i32, AllocError> {
    auto     = 1;
    break    = 2;
    case     = 3;
    char     = 4;
    const    = 5;
    continue = 6;
    default  = 7;
    do       = 8;
    double   = 9;
    else     = 10;
    enum     = 11;
    extern   = 12;
    float    = 13;
    for      = 14;
    goto     = 15;
    if       = 16;
    int      = 17;
    long     = 18;
    register = 19;
    return   = 20;
    short    = 21;
    signed   = 22;
    sizeof   = 23;
    static   = 24;
    struct   = 25;
    switch   = 26;
    typedef  = 27;
    union    = 28;
    unsigned = 29;
    void     = 30;
    volatile = 31;
    while    = 32;

    sum ::= 0;
    sum = sum + auto;
    sum = sum + break;
    sum = sum + case;
    sum = sum + char;
    sum = sum + const;
    sum = sum + continue;
    sum = sum + default;
    sum = sum + do;
    sum = sum + double;
    sum = sum + else;
    sum = sum + enum;
    sum = sum + extern;
    sum = sum + float;
    sum = sum + for;
    sum = sum + goto;
    sum = sum + if;
    sum = sum + int;
    sum = sum + long;
    sum = sum + register;
    sum = sum + return;
    sum = sum + short;
    sum = sum + signed;
    sum = sum + sizeof;
    sum = sum + static;
    sum = sum + struct;
    sum = sum + switch;
    sum = sum + typedef;
    sum = sum + union;
    sum = sum + unsigned;
    sum = sum + void;
    sum = sum + volatile;
    sum = sum + while;

    println("c89 {}", sum);
    Ok(0);
}
