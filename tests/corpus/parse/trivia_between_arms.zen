// comments BETWEEN match arms. the second one must attach to the
// `false` arm as leading trivia -- not to the `true` arm as trailing
// trivia, and not to the enclosing call.
// GAP: DESIGN.md does not say which node owns a comment on its own line.

main = (env: Env) Res<i32, ArgError> {
    n = 1;
    (n == 0).match({
        // before the first arm
        true  => println("{}", n * 0),
        // between the first arm and the second
        false => println("{}", n * 40 + 5),
    });
    Ok(0);
}
