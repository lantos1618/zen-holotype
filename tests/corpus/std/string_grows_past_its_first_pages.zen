// tests/corpus/std/string_grows_past_its_first_pages.zen
// String is a Vec<u8>, so it reallocs like one. 200 appends cross
// every doubling from 8 upward; the bytes written before the first
// realloc must still be there afterwards

Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    alloc ::= env.mem.alloc();
    sb ::= alloc.String("").try();

    Range(0, 200).loop((h, value) {
        sb.add("x").try();
    })
    sb.add("!").try();

    text = sb.view();
    println("len {}", text.len);
    (text[0] == 'x').match({
        true  => println("first is x"),
        false => println("first is not x"),
    })
    (text[200] == '!').match({
        true  => println("last is bang"),
        false => println("last is not bang"),
    })
    Ok(0);
}
