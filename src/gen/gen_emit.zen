// Deterministic output buffering and stable collection ordering.
// `Emit` owns its `String`; callers read or transfer the completed buffer
// From the emitter so later growth cannot diverge from a copied header.

Alloc, AllocError = std.mem
str, String = std.text
Vec = std.collections
Range = std.core

// Four spaces, once. A backend asking for an indent should not also be
// deciding how wide one is.
INDENT* : usize = 4

Emit* = {
    text :: String,
    depth :: usize,

    // A newline was just written; the next byte starts a line and must
    // indent first. Tracked here, not per call site, so a blank line
    // stays blank — nothing on it, no indent.
    fresh :: bool,

    // writing

    // A `\n` ends a line wherever it arrives. `fresh` was set in `line`
    // alone, so a run carrying its own newline left everything after it
    // hard against the margin — nothing in the tree wrote one until a
    // format door began handing whole multi-line runs through here.
    bytes* = (self :: @Self, s: str) Res<(), AllocError> {
        start ::= 0;
        Range(0, s.len).loop((h, i) {
            (s[i] == '\n').then(() {
                self.run(s.slice(start, i)).try();
                self.line().try();
                start = i + 1;
            });
        });
        self.run(s.slice(start, s.len))
    }

    // A run with no line ending in it: one indent, one append. Empty
    // writes nothing, so a blank line stays blank.
    run = (self :: @Self, s: str) Res<(), AllocError> {
        (s.len == 0).match({
            true  => Ok(()),
            false => self.open_run(s),
        })
    }

    open_run = (self :: @Self, s: str) Res<(), AllocError> {
        self.open_line().try();
        self.text.add(s)
    }

    byte* = (self :: @Self, b: u8) Res<(), AllocError> {
        (b == '\n').match({
            true  => self.line(),
            false => self.open_byte(b),
        })
    }

    open_byte = (self :: @Self, b: u8) Res<(), AllocError> {
        self.open_line().try();
        self.text.add(b)
    }

    // A decimal, no separators, most significant digit first. String owns
    // the AllocError-only writer; Emit owns only opening the indented line.
    number* = (self :: @Self, v: usize) Res<(), AllocError> {
        self.open_line().try();
        self.text.write_usize(v)
    }

    // End the line. A blank line is `line` twice and gets no indent.
    line* = (self :: @Self) Res<(), AllocError> {
        self.text.add('\n').try();
        self.fresh = true;
        Ok(());
    }

    // `s`, then the newline. The shape almost every emission has.
    say* = (self :: @Self, s: str) Res<(), AllocError> {
        self.bytes(s).try();
        self.line()
    }

    open_line = (self :: @Self) Res<(), AllocError> {
        self.fresh.then(() { self.write_indent().try() });
        self.fresh = false;
        Ok(());
    }

    write_indent = (self :: @Self) Res<(), AllocError> {
        Range(0, self.depth * INDENT).loop((h, i) {
            self.text.add(' ').try();
        });
        Ok(());
    }

    // depth

    indent* = (self :: @Self) () { self.depth = self.depth + 1; }

    // Saturating: an unbalanced backend should produce ugly, readable C,
    // not an aborted compilation.
    dedent* = (self :: @Self) () {
        (self.depth > 0).then(() { self.depth = self.depth - 1; });
    }

    // reading back

    view* = (self: @Self) str { self.text.view() }

    len* = (self: @Self) usize { self.text.len() }

    // Transfer the finished buffer to a longer-lived owner. The Emit is not
    // written again after this; returning its String header avoids copying
    // every byte of a completed function body into a second arena buffer.
    into_string* = (self: @Self) String { self.text }
}

// `alloc.Emit()` — ufcs constructor beside the type it builds, like
// `Vec`, `Map`, `Ast`, `Types`. Allocates its buffer up front.
Emit* = (a: Alloc) Res<Emit, AllocError> {
    Ok(Emit(text: a.String().try(), depth: 0, fresh: true));
}

// The one ordering primitive. The positions of `keys`, rearranged so
// reading them in the returned order reads `keys` in lexicographic byte
// order.
//
// A permutation, not a sorted copy, so the caller keeps whatever the
// keys belong to (a declaration, a type, a function) without this file
// needing to know what that is.
//
// Bottom-up merge sort, stable: equal keys keep input order, so a duplicate
// name (a backend should report that, not silently reorder it) doesn't move
// under shuffled input. The compiler has thousands of long mangled keys;
// insertion sort made ordering quadratic in both comparisons and bytes.
order* = (a: Alloc, keys: Vec<String>) Res<Vec<usize>, AllocError> {
    out ::= a.Vec<usize>();
    tmp ::= a.Vec<usize>();
    Range(0, keys.len).loop((h, i) {
        out.add(i).try();
        tmp.add(i).try();
    });
    width         ::= 1;
    source_is_out ::= true;
    loop(() { width < out.len }, (h) {
        source_is_out.match({
            true  => merge_pass(out, tmp, keys, width),
            false => merge_pass(tmp, out, keys, width),
        }).try();
        source_is_out = !source_is_out;
        (width > out.len / 2).match({
            true  => h.break(),
            false => { width = width * 2; },
        });
    });
    (!source_is_out).then(() { copy_order(tmp, out).try() });
    Ok(out);
}

merge_pass = (
    src   : Vec<usize>,
    dst   :: Vec<usize>,
    keys  : Vec<String>,
    width : usize
)
             Res<(), AllocError> {
    start ::= 0;
    loop(() { start < src.len }, (h) {
        left  = smaller(width, src.len - start);
        mid   = start + left;
        right = smaller(width, src.len - mid);
        merge_run(src, dst, keys, start, mid, mid + right).try();
        start = mid + right;
    });
    Ok(())
}

smaller = (a: usize, b: usize) usize {
    (a < b).match({ true => a, false => b })
}

merge_run = (
    src   : Vec<usize>,
    dst   :: Vec<usize>,
    keys  : Vec<String>,
    start : usize,
    mid   : usize,
    end   : usize
) Res<(), AllocError> {
    left  ::= start;
    right ::= mid;
    Range(start, end).loop((h, at) {
        take_right = right_first(src, keys, left, mid, right, end);
        from       = take_right.match({ true => right, false => left });
        put(dst, at, src.get(from).value_or(0)).try();
        take_right.match({
            true  => { right = right + 1; },
            false => { left = left + 1; },
        });
    });
    Ok(())
}

right_first = (
    src   : Vec<usize>,
    keys  : Vec<String>,
    left  : usize,
    mid   : usize,
    right : usize,
    end   : usize
) bool {
    (left == mid).match({
        true  => true,
        false => (right == end).match({
            true  => false,
            false => earlier(
                keys,
                src.get(right).value_or(0),
                src.get(left).value_or(0)
            ),
        }),
    })
}

copy_order = (src: Vec<usize>, dst :: Vec<usize>) Res<(), AllocError> {
    Range(0, src.len).loop((h, i) {
        put(dst, i, src.get(i).value_or(0)).try();
    });
    Ok(())
}

// `keys[i]` strictly before `keys[j]` — strict, so equal keys never
// swap and the sort stays stable. Ordering itself is `std.text`'s,
// beside `str.eq`, not here.
earlier = (keys: Vec<String>, i: usize, j: usize) bool {
    view_at(keys, i).before(view_at(keys, j))
}

view_at = (keys: Vec<String>, i: usize) str {
    keys.get(i).match({ Ok(s) => s.view(), None => "" })
}

// `Vec.set` refuses an out-of-range index with a bare `Res<()>` (no
// reason), and `.try()` won't lift a `None` into `Res<_, AllocError>`.
// Both indices here are in range by construction; `sema_ty.zen` carries
// the same five lines for the same reason.
put = (out :: Vec<usize>, i: usize, v: usize) Res<(), AllocError> {
    out.set(i, v).match({
        None  => Err(AllocError.OutOfMemory),
        Ok(_) => Ok(()),
    })
}
