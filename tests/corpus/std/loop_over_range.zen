// tests/corpus/std/loop_over_range.zen
// ranged, no index: the upper bound is exclusive - Range(0, 4) is
// four passes, and the off-by-one that makes it five is the whole
// reason this test names the count as well as the values

main = (env: Env) Res<i32, AllocError> {
    count ::= 0;
    Range(0, 4).loop((h, value) {
        println("{}", value);
        count = count + 1;
    })
    println("count {}", count);
    Ok(0);
}
