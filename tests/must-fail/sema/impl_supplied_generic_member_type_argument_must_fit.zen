// The chosen signature is declared by the bound even when an impl supplies
// the body. Written type arguments must settle that signature before fitting.

Chooser = {
    choose* ::= <T>(self: @Self, value: T) T
}

Tool = {}

Tool.impl(Chooser, {
    choose = <T>(self: @Self, value: T) T { value }
})

main = (env: Env) Res<i32, AllocError> {
    text: str = "wrong";
    value = Tool().choose<i32>(text);
    println("{}", value);
    Ok(0);
}
