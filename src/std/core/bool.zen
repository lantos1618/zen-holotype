// One-sided conditional. `then` returns Ok(value) when true and None when
// false, so it composes with `.try()`, `ok_or`, and `.match`:
//
//   (n > 0).then(() { n * 2 }).ok_or(Error.NotPositive).try();
//
Eq = std.core.eq

// UFCS permits both `b.then(..)` and `then(b, ..)`.
then* = <T>(b: bool, f: () T) Res<T> {
    b.match({
        true  => Ok(f()),
        false => None,
    });
}

// Turn a condition into the caller's error type.
ensure* = <E>(b: bool, reason: E) Res<(), E> {
    b.match({
        true  => Ok(()),
        false => Err(reason),
    });
}

bool* = {}

bool.impl(Eq, { eq ::= (self: @Self, other: @Self) bool { self == other } })
