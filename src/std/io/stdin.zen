// std.io.stdin — line-oriented standard input, the missing half of a unix filter/REPL.
//
// Three surfaces, all allocator-explicit (no hidden heap):
//
//   { read_line, read_all, read_all_bytes, lines } = std.io.stdin
//   a.read_line()          // Result<Opt<StringView>, IoError> — Some(line) per line, None at EOF
//   a.read_all()           // Result<StringView, IoError>      — everything until EOF, one owned buffer
//   a.read_all_bytes()     // Result<[u8], IoError>             — same, BINARY-SAFE (length-carrying)
//   a.lines((line) { … })  // Result<i64, IoError>      — run a closure per line, count returned
//
// Lines are returned WITHOUT the trailing '\n'. A final unterminated line ("abc" then EOF)
// still comes back as Some("abc"); the next call reports None. The `StringView` surfaces are
// allocator-owned NUL-terminated buffers (same contract as std.io.file.contents_in), so a stdin
// stream containing NULs truncates the TEXT view at the first NUL — pipe binary through
// `read_all_bytes`, whose `[u8]` carries the true byte count and preserves embedded NULs.
{ read } = std.c.libc
{ Result, IoError, Opt, ok, err } = std.core.result
{ AllocatorBackend } = std.mem.alloc
{ String, init, push_in, finish_in, free_in } = std.text.string
{ view } = std.text.str
{ repeat_while } = std.core.count    // the do-while — `@while` lives in the primitive, not here
STDIN = 0
READ_CHUNK = 4096
// read(2) failed outright: no errno plumbing at this floor, so carry the -1 sentinel
// (exactly what std.io.file.read_file_open does for a bad lseek).
read_failed = () IoError { IoError.Errno(0 - 1) }
// Reads one line from stdin: Ok(.Some(line)) without the '\n', Ok(.None) at EOF,
// Err on read/allocation failure. The line is an allocator-owned view — release it
// via `a.release(line.view().ptr)` (or let an arena reclaim it) when done.
//
// The 1-byte read target is acquired and RELEASED here rather than written as a `cell: [u8] = [0]`
// local: a slice literal bound to a local is heap-promoted by the C backend (gen_slicelit) and never
// freed, so the "on the stack" cell this used to hold leaked one byte per line read — unbounded on a
// filter draining a large stream. The escape analysis cannot stack it either, since `cell.ptr` is
// handed to read(2). One acquire/release per line is noise beside the per-BYTE read syscall below.
read_line* = (a: AllocatorBackend) Result<Opt<StringView>, IoError> {
    a.try_acquire(1).match ({
        .Err(e)   => err(e),
        .Ok(cell) => {
            out = a.read_line_into(cell.slice(1))
            a.release(cell)
            out
        },
    })
}
read_line_into = (a: AllocatorBackend, cell: [u8]) Result<Opt<StringView>, IoError> {
    a.init(64).match ({
        .Err(e) => err(e),
        .Ok(s0) => {
            s ::= s0
            consumed ::= 0    // bytes taken off the stream, INCLUDING a '\n'
            failed ::= false
            ev ::= IoError.Eof
            // at least one read(2) always happens, so this is the do-while shape: `repeat_while`
            repeat_while((step) {
                r = STDIN.read(cell.ptr, 1)
                failed = r < 0
                ev = failed.then({ read_failed() }, { ev })
                consumed = consumed + (r > 0).then({ 1 }, { 0 })
                more = r > 0 && cell[0] != '\n'
                // builder-threaded push: every arm yields the String, so failure stays a value
                s = more.match ({
                    true  => a.push_in(s, cell[0]).match ({
                        .Ok(ns)  => ns,
                        .Err(pe) => {
                            failed = true
                            ev = pe
                            s
                        },
                    }),
                    false => s,
                })
                more && failed == false
            })
            out: Result<Opt<StringView>, IoError> = failed.match ({
                true  => {
                    s.free_in(a)
                    err(ev)
                },
                false => (consumed == 0).match ({
                    true  => {
                        s.free_in(a)
                        none: Opt<StringView> = .None
                        ok(none)
                    },
                    false => s.finish_in(a).match ({
                        .Ok(line) => {
                            some: Opt<StringView> = .Some(line)
                            ok(some)
                        },
                        .Err(fe)  => err(fe),
                    }),
                }),
            })
            out
        },
    })
}
// Append `n` bytes of `chunk` onto `s`; Err carries the allocation failure.
append_chunk = (a: AllocatorBackend, s: String, chunk: RawPtr<u8>, n: i64) Result<String, IoError> {
    cur ::= s
    failed ::= false
    ev ::= IoError.Eof
    bs: [u8] = chunk.slice(n)
    bs.loop((h, i, b) {
        cur = a.push_in(cur, b).match ({
            .Ok(ns)  => ns,
            .Err(pe) => {
                failed = true
                ev = pe
                cur
            },
        })
        failed.then({
            h.break
        })
    })
    out: Result<String, IoError> = failed.then({ err(ev) }, { ok(cur) })
    out
}
// Drains stdin to EOF into one allocator-owned String builder — the shared core of read_all /
// read_all_bytes. The builder carries the true byte count, so binary data (embedded NULs) is intact;
// the caller decides whether to re-view it as NUL-terminated text (finish_in) or raw bytes (.bytes()).
drain_stdin = (a: AllocatorBackend) Result<String, IoError> {
    a.try_acquire(READ_CHUNK).match ({
        .Err(e)    => err(e),
        .Ok(chunk) => a.init(READ_CHUNK).match ({
            .Err(e) => {
                a.release(chunk)
                err(e)
            },
            .Ok(s0) => {
                s ::= s0
                failed ::= false
                ev ::= IoError.Eof
                repeat_while((step) {
                    r = STDIN.read(chunk, READ_CHUNK)
                    failed = r < 0
                    ev = failed.then({ read_failed() }, { ev })
                    s = (r > 0).match ({
                        true  => a.append_chunk(s, chunk, r).match ({
                            .Ok(ns)  => ns,
                            .Err(ae) => {
                                failed = true
                                ev = ae
                                s
                            },
                        }),
                        false => s,
                    })
                    r > 0 && failed == false
                })
                a.release(chunk)
                out: Result<String, IoError> = failed.match ({
                    true  => {
                        s.free_in(a)
                        err(ev)
                    },
                    false => ok(s),
                })
                out
            },
        }),
    })
}
// Reads stdin to EOF into one allocator-owned NUL-terminated view (the stdin twin of
// std.io.file.contents_in — `a.contents_in("/dev/stdin")` needs a seekable fd; this doesn't).
// TEXT surface: an embedded NUL truncates the view — use read_all_bytes for binary-safe reads.
// The buffer is the CALLER's: release it via `a.release(text.view().ptr)` (or let an arena reclaim
// it), exactly like read_line's line. Every internal scratch block is already freed by drain_stdin.
read_all* = (a: AllocatorBackend) Result<StringView, IoError> {
    a.drain_stdin().match ({
        .Ok(s)  => s.finish_in(a).match ({
            .Ok(done) => ok(done),
            .Err(e)   => err(e),
        }),
        .Err(e) => err(e),
    })
}
// Reads stdin to EOF into one allocator-owned length-carrying `[u8]` — BINARY-SAFE: embedded NULs are
// preserved (the true byte count rides in the slice length). Pipe images / gzip / any non-text stream
// through a Zen filter without truncation. Also the CALLER's buffer: `a.release_slice(bytes)`.
read_all_bytes* = (a: AllocatorBackend) Result<[u8], IoError> {
    a.drain_stdin().match ({
        .Ok(s)  => ok(s.bytes()),
        .Err(e) => err(e),
    })
}
// Runs `on_line` once per stdin line (line passed WITHOUT its '\n') until EOF; returns how
// many lines were seen. Each line's buffer is RELEASED after `on_line` returns — copy what
// must outlive the call. `on_line` is a first-class closure arg, same shape as
// std.collections.iter's helpers, so an inline lambda splices straight in:
// `a.lines((line) { out(line) })`.
lines* = (a: AllocatorBackend, on_line: (StringView) void) Result<i64, IoError> {
    n :: i64 = 0
    failed ::= false
    ev ::= IoError.Eof
    // uniform bool arms: side effects thread through the outer locals, and the match IS the
    // "keep going?" answer `repeat_while` asks for — no `done` flag left to carry.
    repeat_while((step) {
        a.read_line().match ({
            .Err(e) => {
                failed = true
                ev = e
                false
            },
            .Ok(o)  => o.match ({
                .None       => false,
                .Some(line) => {
                    on_line(line)
                    n = n + 1
                    a.release(line.view().ptr)
                    true
                },
            }),
        })
    })
    out: Result<i64, IoError> = failed.then({ err(ev) }, { ok(n) })
    out
}
