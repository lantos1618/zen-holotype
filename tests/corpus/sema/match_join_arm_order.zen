// WHICH ARM IS OPEN IS THE AUTHOR'S ORDERING, NOT A FACT ABOUT THE TYPE.
//
// A match written `Ok(v)` / `None` has neither arm knowing both halves:
// `Ok` says the PAYLOAD and `None` says the FORM, so `sema_join.zen`
// reads one off each and settles the pair into `Res<Op>`. It used to do
// that only when the OPEN arm came first, because the fold asks about
// the arms so far and never about the arm being added.
//
// Written the other way round the join took `None`'s type whole and
// answered `Res<Infer>` — a backend struct with an `int` where `Op`
// goes, which `cc` rejected with "incompatible types". The two bindings
// below are the same match with the arms swapped, and neither has a
// written type to settle them from the outside, so the join is the only
// thing that can. They must type the same.

Op = Not | Neg

name_of = (o: Op) str {
    o.match({ Not => "not", Neg => "neg" })
}

main = (env: Env) Res<i32, AllocError> {
    n = 1;

    ok_first = n.match({
        1 => Ok(Op.Not),
        _ => None,
    });
    none_first = n.match({
        0 => None,
        _ => Ok(Op.Neg),
    });

    ok_first.match({
        Ok(o) => println("{}", name_of(o)),
        None  => println("none"),
    });
    none_first.match({
        Ok(o) => println("{}", name_of(o)),
        None  => println("none"),
    });
    Ok(0);
}
