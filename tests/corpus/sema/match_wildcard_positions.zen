// `_` in every position it can appear: as a whole arm, as a payload
// pattern, as an inner payload of a nested pattern, and as the single
// arm covering an entire enum.

Cell =
    Full(i32),
    Blank

Slot =
    Left(Cell),
    Right(Cell),
    Gone

// `_` as a whole arm, covering two remaining variants
tail_arm = (env: Env, s: Slot) () {
    s.match({
        Left(c) => cell_arm(env, c),
        _       => println("not left"),
    })
}

// `_` inside a payload: the variant is named, the payload is not bound
cell_arm = (env: Env, c: Cell) () {
    c.match({
        Full(_) => println("full"),
        _       => println("blank"),
    })
}

// `_` as the payload of every arm, with the enum still fully covered
payload_arm = (env: Env, s: Slot) () {
    s.match({
        Left(_)  => println("left"),
        Right(_) => println("right"),
        Gone     => println("gone"),
    })
}

// `_` nested one level down
nested_arm = (env: Env, s: Slot) () {
    s.match({
        Left(Full(_)) => println("left full"),
        Left(_)       => println("left other"),
        _             => println("other"),
    })
}

// `_` alone: legal, and exhaustive by construction
any_arm = (env: Env, s: Slot) () {
    s.match({
        _ => println("any"),
    })
}

main = (env: Env) Res<i32, AllocError> {
    tail_arm(env, Slot.Left(Cell.Full(1)));
    tail_arm(env, Slot.Gone);
    payload_arm(env, Slot.Right(Cell.Blank));
    nested_arm(env, Slot.Left(Cell.Full(2)));
    nested_arm(env, Slot.Left(Cell.Blank));
    nested_arm(env, Slot.Gone);
    any_arm(env, Slot.Gone);
    Ok(0);
}
