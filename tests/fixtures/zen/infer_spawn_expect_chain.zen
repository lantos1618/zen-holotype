{ to_exit } = std.core.bool
{ expect } = std.core.result
heap = std.mem.heap
actor = std.concurrent.actor
Msg*: Inc
Counter*: { n: i32 }
Counter.impl(actor.Receiver<Msg>, {
    receive = (c: MutPtr<Counter>, ctx: actor.Context<Msg>) void { c.n = c.n + 1 }
})
main = () i32 {
    h := heap.gpa()
    counter := actor.spawn(h.addr(), 8, Counter(n: 0)).expect("spawn counter")
    counter.free(h.addr())
    true.to_exit()
}
