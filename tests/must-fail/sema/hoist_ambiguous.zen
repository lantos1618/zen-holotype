// hoisting fires only when exactly ONE variant carries the type. in
// Res<i32, i32> both Ok and Err do, so a bare 32 has two readings and
// the explicit form is required. DESIGN.md, std.core.
//
// position: the value that would have been hoisted.

Pair = {
    bar: Res<i32, i32>,
}

main = (env: Env) Res<i32, AllocError> {
    p = Pair(bar: 32);
    Ok(0);
}
