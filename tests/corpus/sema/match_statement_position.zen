// match is exhaustive in EVERY position, and statement position is the
// one where a dropped case would otherwise be invisible: nothing reads
// the value, so nothing else would complain.

Signal =
    Start,
    Stop,
    Reset

step = (env: Env, s: Signal) () {
    // value discarded: this match is a statement
    s.match({
        Start => println("start"),
        Stop  => println("stop"),
        Reset => println("reset"),
    })

    // same again, in statement position inside a loop body
    [0, 1].loop((h, n) {
        s.match({
            Start => println("start {}", n),
            Stop  => println("stop {}", n),
            Reset => println("reset {}", n),
        })
    })
}

main = (env: Env) Res<i32, AllocError> {
    step(env, Signal.Start);
    step(env, Signal.Reset);
    Ok(0);
}
