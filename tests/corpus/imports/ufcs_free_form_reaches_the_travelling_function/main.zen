// Importing Box also makes its travelling UFCS function available. Method and
// free-call spellings must resolve to the same function and print the same value.

Box = box.box

main = (env: Env) Res<i32, IoError> {
    b = Box(label: 3);
    println("{}", b.describe());
    println("{}", describe(b));
    Ok(0);
}
