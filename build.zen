// build.zen — zen builds zen. `make` bootstraps once (cc compiles the committed seed; nothing
// else can — no zen exists yet); from then on: `./zen build` → ./zen-next, `mv zen-next zen`
// to promote (cc cannot overwrite the running binary).
// Constraints worth knowing: -fno-strict-aliasing must accompany -O2 (the emitted C puns
// pointers); never -O0 (the recursion-only compiler needs sibling-call elimination or it blows
// the C stack) — which is also why zen-debug is -g on -O1, not -O0.
{ Build } = std.build
build = (b: MutPtr<Build>) void {
    b.install(b
        .exe("zen")
        .root(".")
        .main("driver.zen")
        .out("zen-next")
        .cflags("-O2 -fno-strict-aliasing"))
    b.install(b
        .exe("zen-debug")
        .root(".")
        .main("driver.zen")
        .out("zen-debug")
        .cflags("-g"))
}
