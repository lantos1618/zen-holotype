{ println } = std.io.print
{ Result, IoError } = std.core.result
divmod = (n: i32, d: i32) Result<DivMod, IoError> {
    (d == 0).match ({
        true  => .Err(.NotFound),
        false => .Ok(DivMod(
            q: n / d,
            r: n % d,
        )),
    })
}
main = () i32 {
    divmod(7, 2).match ({
        .Ok(v)  => {
            println(v.q)
            println(v.r)
        },
        .Err(e) => println(0 - 1),
    })
    0
}
DivMod: {
    q: i32,
    r: i32,
}
