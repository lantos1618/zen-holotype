// Dot has no impl of Boxy, so it has no width, no height, and no area.
// the bound is the promise; this call does not keep it.
//
// position: the call whose argument fails the bound.

Boxy = {
    width: i32,
    height: i32,

    area* ::= (self: @Self) i32 { self.width * self.height }
}

Dot = {
    x: i32,
}

scale = <T: Boxy>(shape: T, k: i32) i32 { shape.area() * k }

main = (env: Env) Res<i32, AllocError> {
    println("{}", scale(Dot(x: 1), 2));
    Ok(0);
}
