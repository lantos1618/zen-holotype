// std.sys.process.run captures a subprocess's stdout AND exit code; run_ok collapses a nonzero exit into
// an error. This fixture asserts all four in one program, exiting 0 only if every check holds:
//   1. run("printf hello")   -> stdout == "hello", exit == 0
//   2. run("sh -c 'exit 7'") -> exit == 7 (nonzero exit is captured, not an error)
//   3. run_ok on #1          -> Ok("hello")
//   4. run_ok on #2          -> Err (nonzero exit becomes an error)
{ run, run_ok, Output } = std.sys.process
heap = std.mem.heap
main = () i32 {
    m := heap.gpa()
    a := m.addr()
    a.run("printf hello").match ({
        .Err(e) => 11,
        .Ok(o)  => (o.stdout == "hello").match ({
            true  => (o.exit == 0).match ({
                true  => {
                    a.run("sh -c 'exit 7'").match ({
                        .Err(e2) => 14,
                        .Ok(o2)  => (o2.exit == 7).match ({
                            true  => {
                                a.run_ok("printf hello").match ({
                                    .Err(e3) => 16,
                                    .Ok(s)   => (s == "hello").match ({
                                        true  => {
                                            a.run_ok("sh -c 'exit 7'").match ({
                                                .Err(e4) => 0,
                                                .Ok(s2)  => 18,
                                            })
                                        },
                                        false => 17,
                                    }),
                                })
                            },
                            false => 15,
                        }),
                    })
                },
                false => 13,
            }),
            false => 12,
        }),
    })
}
