Builder, BuildError = std.build

build = (b :: Builder) Res<(), BuildError> {
    b.exe_test("passing", {src: Path("pass.zen"), deps: []}).try();
    b.exe_test("failing", {src: Path("fail.zen"), deps: []}).try();
    b.exe_test("after_failure", {src: Path("pass.zen"), deps: []}).try();
    Ok(())
}
