// pool_actor_demo.zen — typed actors on the multi-threaded pool (the parallel KEEP path).
//
//   $ zenc run examples/pool_actor_demo.zen
//   total=1000 workers_busy>=1
//   ok
//
// Contrast with `actor_demo.zen`: that path drains INLINE on the caller thread (cooperative
// request/reply). This path schedules typed `receive` on pool workers via a one-line concrete
// trampoline stub (`pa.dispatch` does the typed unboxing). One stub per (Msg, ActorT) until the
// compiler can emit addressable generic instantiations.
{ println, formatln, arg_int } = std.text.fmt
{ pool_open, Pool } = std.concurrent.pool
{ dispatch } = std.concurrent.pool_actor
pa = std.concurrent.pool_actor
{ Context, Receiver } = std.concurrent.pool_actor
NMSG := 1000
WORKERS := 2
Msg*: Inc(i64)
Counter*: {
    total: i64,
}
Counter.impl(Receiver, {
    receive = (c: MutPtr<Counter>, ctx: Context<Msg>) void {
        ctx.msg.match ({
            .Inc(n) => {
                c.total = c.total + n
            },
        })
    }
})
// Concrete trampoline: pool behaviors are type-erased `(RawPtr<u8>, i64) void`. The stub must be
// concrete (generic fns inline, so their address can't be taken); pa.dispatch does the rest.
tramp = (user: RawPtr<u8>, msg: i64) void { dispatch<Counter, Msg>(user, msg) }
blast = (p: MutPtr<Pool>, h: pa.PooledHandle<Counter>, k: i64) void {
    (k < NMSG).then({
        p.send(h, Msg.Inc(1))
        blast(p, h, k + 1)
    })
}
main = () i32 {
    h := pa.spawn_actor_heap(NMSG + 8, Counter(total: 0), tramp)
    p := pool_open(WORKERS, 4)
    blast(p, h, 0)
    p.pool_quiesce_stop()
    busy := p.workers_busy()
    total := pa.actor_state(h).total
    pa.close(h)
    p.pool_close()
    formatln("total={}", [arg_int(total)])
    ok := total == NMSG && busy >= 1
    ok.then({ println("ok") }, { println("MISMATCH") })
    ok.then({ 0 }, { 1 })
}
