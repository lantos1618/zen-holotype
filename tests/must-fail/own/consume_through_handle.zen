// `consume` of something reached through a HANDLE. `env` is the
// capability root: two words that point at what the runtime owns, and
// a bitwise copy of it sees the same `argv`.
//
// moving out of it would leave every other copy of the handle holding
// a dead Vec, and there is no single binding the checker could mark
// dead to prevent that. you may only move what this frame owns.

main = (env: Env) Res<i32, IoError> {
    args = consume env.argv;
    args.get(0).match({
        Ok(a) => println(a),
        None  => println("no argv"),
    })
    Ok(0);
}
