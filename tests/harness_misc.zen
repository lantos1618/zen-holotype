// tests/harness_misc.zen — the MISC category for the Zen-native correctness harness. It ports six of the
// remaining pytest suites into self-hosted Zen cases driven against the committed `zenc` binary (NO
// Python). Sub-suites, each returning a fail count, summed by `harness_misc_run`:
//
//   traits       <- tests/test_traits.py        (impl/dispatch VALUE + conformance VERDICT)
//   string_types <- tests/test_string_types.py   (text/Cstr/str lattice VERDICT)
//   num_parse    <- tests/test_num_parse.py       (std.text.num parse, value + error-as-value, via `zenc run`)
//   hashing      <- std.hash                       (SHA-256 published test vectors + FNV-1a-64, via `zenc run`)
//   acid         <- tests/test_acid.py            (every real std/compiler source EMITs, output starts with HEAD)
//   differential <- tests/test_differential.py    (large generated constructs: 80 params/fields/match-arms)
//   faithful_ast <- tests/test_faithful_ast.py    (`fmt --ast` UFCS/round-trip/idempotency + emit-equal corpus)
//
// Helpers are `om_`-prefixed so they never collide on the flat-import flatten with std (std.io.file
// already defines `read_file*`), harness_lib, or the other category files.
{ VCase, VerdictCase, run_value, run_values, run_verdicts, run_suite, zo_path, zo_cmd, zo_par_run, zo_idpath, zo_join } = harness_lib
{ Malloc } = std.mem.alloc
{ out, out_bytes, save, contents_in, shell } = std.io.file
{ eq, len, contains, starts_with, is_empty, view, substr } = std.text.str
{ new_in, append_in, finish_in, push_in } = std.text.string
{ expect } = std.core.result
{ malloc, free } = std.mem.alloc
// the zslice header every emission must begin with (mirrors _oracle.HEAD).
HEAD := "typedef struct { void* ptr; int64_t len; } zslice; "
// ── shared helpers ────────────────────────────────────────────────────────────
om_read_file = (mp: MutPtr<Malloc>, path: string_view) string_view {
    mp.contents_in(path).match ({
        .Ok(t)  => t,
        .Err(e) => "",
    })
}
om_not = (b: bool) bool { b.match ({ true => false, false => true }) }
// concat 2 / 3 strs into a fresh allocator-owned cstr (for building shell commands with a path arg).
om_cat2 = (mp: MutPtr<Malloc>, a: string_view, b: string_view) string_view {
    s := mp.new_in().expect("harness: oom")
    s = s.append_in(mp, a).expect("harness: oom")
    s = s.append_in(mp, b).expect("harness: oom")
    mp.finish_in(s).expect("harness: oom")
}
om_cat3 = (mp: MutPtr<Malloc>, a: string_view, b: string_view, c: string_view) string_view { mp.om_cat2(a, mp.om_cat2(b, c)) }
// ════════════════════════════════════════════════════════════════════════════════
// traits  <- tests/test_traits.py
// VALUE: impl methods compile + dispatch via UFCS (incl. a DECLARED trait with an impl).
// VERDICT: impl conformance — accept a complete/matching impl; reject missing/wrong-signature ones
// (`zenc check` emits `error[conformance]`, equivalent to the pytest `check_count(...) == 1`).
// ════════════════════════════════════════════════════════════════════════════════
harness_misc_traits = () i32 {
    v := run_values("traits value", [VCase(
        src: "Point*: { x: i32, y: i32 }\nPoint.impl(Show, { sumk = (p: Ptr<Point>, k: i32) i32 { p.x + p.y + k } })\ntest* = () i32 { p := Point(x: 3, y: 4)\n p.addr().sumk(10) }",
        want: "17",
    ), VCase(
        src: "Counter*: { n: i32 }\nCounter.impl(Inc, { bump = (c: Ptr<Counter>) i32 { c.n + 1 }  get = (c: Ptr<Counter>) i32 { c.n } })\ntest* = () i32 { c := Counter(n: 41)\n c.addr().bump() }",
        want: "42",
    ), VCase(
        src: "Box*: { v: i32 }\nBox.impl(B, { val = (b: Ptr<Box>) i32 { b.v }  twice = (b: Ptr<Box>) i32 { b.val() + b.val() } })\ntest* = () i32 { b := Box(v: 21)\n b.addr().twice() }",
        want: "42",
    ), VCase(
        src: "Show*: { render: (Ptr<Self>) i32 }\nPoint*: { x: i32, y: i32 }\nPoint.impl(Show, { render = (p: Ptr<Point>) i32 { p.x * 10 + p.y } })\ntest* = () i32 { p := Point(x: 4, y: 2)\n p.addr().render() }",
        want: "42",
    )])
    // one impl method via UFCS; field access on a Ptr receiver auto-derefs
    // two methods in one impl block
    // an impl method that chains another UFCS call
    // a DECLARED trait (skipped from codegen) whose impl provides the called method
    d := run_verdicts("traits verdict", [VerdictCase(
        src: "Show*: { render: (Ptr<Self>) i32, area: (Ptr<Self>) i32 }\nPoint*: { x: i32 }\nPoint.impl(Show, { render = (p: Ptr<Point>) i32 { p.x }  area = (p: Ptr<Point>) i32 { p.x } })",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "Show*: { render: (Ptr<Self>, i32) i32 }\nPoint*: { x: i32 }\nPoint.impl(Show, { render = (p: Ptr<Point>, k: i32) i32 { p.x + k } })",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "Show*: { render: (Ptr<Self>) i32, area: (Ptr<Self>) i32 }\nPoint*: { x: i32 }\nPoint.impl(Show, { render = (p: Ptr<Point>) i32 { p.x } })",
        should_pass: false,
        kind: "conformance",
    ), VerdictCase(
        src: "Show*: { render: (Ptr<Self>) i32, area: (Ptr<Self>) i32 }\nPoint*: { x: i32 }\narea* = (n: i32) i32 { n }\nPoint.impl(Show, { render = (p: Ptr<Point>) i32 { p.x } })",
        should_pass: false,
        kind: "conformance",
    ), VerdictCase(
        src: "Show*: { render: (Ptr<Self>) i32 }\nPoint*: { x: i32 }\nPoint.impl(Show, { render = (p: Ptr<Point>, k: i32) i32 { p.x } })",
        should_pass: false,
        kind: "conformance",
    ), VerdictCase(
        src: "Show*: { render: (Ptr<Self>) i32 }\nPoint*: { x: i32 }\nPoint.impl(Show, { render = (p: Ptr<Point>) bool { p.x < 1 } })",
        should_pass: false,
        kind: "conformance",
    ), VerdictCase(
        src: "Show*: { render: (Ptr<Self>, i32) i32 }\nPoint*: { x: i32 }\nPoint.impl(Show, { render = (p: Ptr<Point>, k: u8) i32 { p.x } })",
        should_pass: false,
        kind: "conformance",
    )])
    // complete impl conforms
    // matching signature (Self -> Point) conforms
    // missing a required method -> reject
    // an unrelated global `area` does NOT satisfy a deficient impl -> reject
    // arity mismatch (impl takes an extra param) -> reject
    // return-type mismatch (bool vs i32) -> reject
    // param-type mismatch (u8 vs i32, not the Self param) -> reject
    v + d
}
// ════════════════════════════════════════════════════════════════════════════════
// Canonical string provenance names + their directional value lattice. Coercions are outer-value
// only: mutable pointers and generic storage remain invariant, and match joins choose the broader
// provenance independent of arm order. The three old spellings remain parser aliases during migration.
// ════════════════════════════════════════════════════════════════════════════════
harness_misc_string_types = () i32 {
    run_verdicts("string_types verdict", [VerdictCase(
        src: "take = (s: string_literal) i32 { 0 }\nmain = () i32 { take(\"ok\") }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "take = (s: string_view) i32 { 0 }\nmain = () i32 { take(\"ok\") }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "take = (s: string_view) i32 { 0 }\nmain = () i32 { take(cstr(null_ptr())) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "take = (s: string_cstr) i32 { 0 }\nmain = () i32 { take(cstr(null_ptr())) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "take = (s: string_literal) i32 { 0 }\nmain = () i32 { take(cstr(null_ptr())) }",
        should_pass: false,
        kind: "arg-type",
    ), VerdictCase(
        src: "bad = (s: string_view) string_literal { s }\nmain = () i32 { 0 }",
        should_pass: false,
        kind: "return-fit",
    ), VerdictCase(
        src: "bad = (v: string_view, b: bool) string_literal { b.match ({ true => \"literal\", false => v }) }\nmain = () i32 { 0 }",
        should_pass: false,
        kind: "return-fit",
    ), VerdictCase(
        src: "bad = (v: string_view, b: bool) string_literal { b.match ({ true => v, false => \"literal\" }) }\nmain = () i32 { 0 }",
        should_pass: false,
        kind: "return-fit",
    ), VerdictCase(
        src: "E: Lit | Borrow(string_view)\nbad = (e: E) string_literal { e.match ({ .Lit => \"literal\", .Borrow(v) => v }) }\nmain = () i32 { 0 }",
        should_pass: false,
        kind: "return-fit",
    ), VerdictCase(
        src: "E: Borrow(string_view) | Lit\nbad = (e: E) string_literal { e.match ({ .Borrow(v) => v, .Lit => \"literal\" }) }\nmain = () i32 { 0 }",
        should_pass: false,
        kind: "return-fit",
    ), VerdictCase(
        src: "good = (v: string_view, b: bool) string_view { b.match ({ true => \"literal\", false => v }) }\nmain = () i32 { 0 }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "Box<T>: { value: T }\nneeds_literal = (b: Box<string_literal>) i32 { 0 }\nbad = (v: string_view) i32 { b: Box<string_view> := Box<string_view>(value: v)  needs_literal(b) }\nmain = () i32 { bad(\"ok\") }",
        should_pass: false,
        kind: "arg-type",
    ), VerdictCase(
        src: "R<T>: Ok(T) | Err(i32)\nbad = (r: R<string_cstr>) R<string_view> { r }\nmain = () i32 { 0 }",
        should_pass: false,
        kind: "return-fit",
    ), VerdictCase(
        src: "R<T>: Ok(T) | Err(i32)\ngood = (r: R<string_cstr>) R<string_view> { r.match ({ .Ok(v) => .Ok(v), .Err(e) => .Err(e) }) }\nmain = () i32 { 0 }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "overwrite = (p: MutPtr<string_view>, v: string_view) void { p.store(v) }\nlaunder = (slot: string_literal, v: string_view) string_literal { overwrite(slot.addr(), v)  slot }\nmain = () i32 { launder(\"safe\", cstr(null_ptr()))  0 }",
        should_pass: false,
        kind: "arg-type",
    ), VerdictCase(
        src: "legacy = (v: str, l: text, c: Cstr) i32 { 0 }\nmain = () i32 { legacy(\"view\", \"literal\", cstr(null_ptr())) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "Label*: { label: (string_view) i32 }\nstr.impl(Label, { label = (s: string_view) i32 { 0 } })\nmain = () i32 { \"legacy\".label() }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "bar = (x: str) i32 { foo(x) }\nfoo = (s: text) i32 { 0 }\nmain = () i32 { bar(\"hi\") }",
        should_pass: false,
        kind: "arg-type",
    )])
}
// ════════════════════════════════════════════════════════════════════════════════
// num_parse  <- tests/test_num_parse.py
// Run ONE real program through `zenc run` (std.text.num imports resolved) and assert both the value
// path (numbers parse correctly) and the error-as-value path (garbage/empty/out-of-range is `.Err`,
// never a silent 0). The value-case harness can't drive this (it has no module resolver), so this is
// a small custom `zenc run` + stdout-substring runner.
// ════════════════════════════════════════════════════════════════════════════════
NP_PROG := "{ put } = std.text.fmt\n{ parse_f64, parse_i64_checked, parse_i64_radix } = std.text.num\n{ ParseError } = std.text.str\nemit_f = (label: str, r: Result<f64, ParseError>) void {\n    r.match ({\n        .Ok(v)  => { put(label).s(\"=Ok\").f(v).nl()  {} },\n        .Err(e) => { put(label).s(\"=Err\").nl()  {} }\n    })\n}\nemit_i = (label: str, r: Result<i64, ParseError>) void {\n    r.match ({\n        .Ok(v)  => { put(label).s(\"=Ok\").i(v).nl()  {} },\n        .Err(e) => { put(label).s(\"=Err\").nl()  {} }\n    })\n}\nmain = () i32 {\n    emit_f(\"f_pi|\",   parse_f64(\"3.14\"))\n    emit_f(\"f_neg|\",  parse_f64(\"-2.5\"))\n    emit_f(\"f_exp|\",  parse_f64(\"1e3\"))\n    emit_f(\"f_int|\",  parse_f64(\"42\"))\n    emit_f(\"f_bad|\",  parse_f64(\"abc\"))\n    emit_f(\"f_mt|\",   parse_f64(\"\"))\n    emit_f(\"f_dot2|\", parse_f64(\"1.2.3\"))\n    emit_i(\"i_ok|\",   parse_i64_checked(\"123\"))\n    emit_i(\"i_bad|\",  parse_i64_checked(\"12x\"))\n    emit_i(\"i_mt|\",   parse_i64_checked(\"\"))\n    emit_i(\"r_hex|\",  parse_i64_radix(\"ff\", 16))\n    emit_i(\"r_bin|\",  parse_i64_radix(\"1010\", 2))\n    emit_i(\"r_bad|\",  parse_i64_radix(\"zz\", 16))\n    0\n}\n"
harness_misc_num_parse = () i32 {
    m := Malloc(_: 0)
    mp := m.addr()
    save(mp.zo_path("zo_misc_np.zen"), NP_PROG, len(NP_PROG))
    save(mp.zo_path("zo_misc_np.out"), "", 0)
    shell(mp.zo_cmd("./zen run $ZT/zo_misc_np.zen > $ZT/zo_misc_np.out 2>/dev/null"))
    txt := mp.om_read_file(mp.zo_path("zo_misc_np.out"))
    run_suite("num_parse (run)", [txt.contains("f_pi|=Ok3.14\n"), txt.contains("f_neg|=Ok-2.5\n"), txt.contains("f_exp|=Ok1000.0\n"), txt.contains("f_int|=Ok42.0\n"), txt.contains("i_ok|=Ok123\n"), txt.contains("r_hex|=Ok255\n"), txt.contains("r_bin|=Ok10\n"), txt.contains("f_bad|=Err\n"), txt.contains("f_mt|=Err\n"), txt.contains("f_dot2|=Err\n"), txt.contains("i_bad|=Err\n"), txt.contains("i_mt|=Err\n"), txt.contains("r_bad|=Err\n")])
}
// value path: numbers parse correctly
// error-as-value path: garbage / empty / bad-digit is .Err, NOT a silent 0
// ════════════════════════════════════════════════════════════════════════════════
// hashing  <- std.hash (SHA-256 + FNV-1a-64)
// Run a real program through `zenc run` (std.hash imports resolved) and assert the SHA-256 hex output
// matches the PUBLISHED FIPS 180-4 / RFC 6234 test vectors BYTE-FOR-BYTE (empty, "abc", and a longer
// multi-block string), plus FNV-1a-64 against its known "abc" value and its determinism / distinctness.
// The value-case harness can't drive this (no module resolver + it clashes with libc redecls), so this
// mirrors num_parse's custom `zenc run` + stdout-substring runner. These are the crypto correctness gate.
// ════════════════════════════════════════════════════════════════════════════════
HASH_PROG := "{ put } = std.text.fmt\n{ view } = std.text.str\n{ Malloc } = std.mem.alloc\n{ sha256_hex, fnv1a } = std.hash\nmain = () i32 {\n    m := Malloc(_: 0)\n    mp := m.addr()\n    put(\"empty=\").s(mp.sha256_hex(\"\".view())).nl()\n    put(\"abc=\").s(mp.sha256_hex(\"abc\".view())).nl()\n    put(\"fox=\").s(mp.sha256_hex(\"The quick brown fox jumps over the lazy dog\".view())).nl()\n    put(\"fnv_abc=\").b(fnv1a(\"abc\".view()) == 16654208175385433931).nl()\n    put(\"fnv_det=\").b(fnv1a(\"hello\".view()) == fnv1a(\"hello\".view())).nl()\n    put(\"fnv_ne=\").b(fnv1a(\"abc\".view()) != fnv1a(\"abd\".view())).nl()\n    0\n}\n"
harness_misc_hash = () i32 {
    m := Malloc(_: 0)
    mp := m.addr()
    save(mp.zo_path("zo_misc_hash.zen"), HASH_PROG, len(HASH_PROG))
    save(mp.zo_path("zo_misc_hash.out"), "", 0)
    shell(mp.zo_cmd("./zen run $ZT/zo_misc_hash.zen > $ZT/zo_misc_hash.out 2>/dev/null"))
    txt := mp.om_read_file(mp.zo_path("zo_misc_hash.out"))
    run_suite("hashing (run)", [txt.contains("empty=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\n"), txt.contains("abc=ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\n"), txt.contains("fox=d7a8fbb307d7809469ca9abcb0082e4f8d5651e46d3cdb762d02d0bf37c9e592\n"), txt.contains("fnv_abc=true\n"), txt.contains("fnv_det=true\n"), txt.contains("fnv_ne=true\n")])
}
// SHA-256 vectors match the published FIPS 180-4 / RFC 6234 digests exactly
// FNV-1a-64 hits its known "abc" value, is deterministic, and separates distinct inputs
// ════════════════════════════════════════════════════════════════════════════════
// acid  <- tests/test_acid.py
// Every real src/std/*.zen and src/compiler/*.zen file is fed THROUGH the EMIT binary AS-IS; the
// emission must succeed (rc 0), begin with the zslice HEAD (a non-trivial, well-formed C unit), AND
// every top-level non-generic, non-exported declaration name must survive into the emitted C — the
// Zen equivalent of pytest's `for name in _DECL_RE.findall(src): assert name in out`.
// ════════════════════════════════════════════════════════════════════════════════
om_is_alpha = (b: u8) bool { b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z' || b == '_' }
om_is_alnum = (b: u8) bool { om_is_alpha(b) || b >= '0' && b <= '9' }
// Mirror of `_DECL_RE = ^([a-zA-Z_]\w*)\s*=\s*\(` (re.M): scan `src` for each line-initial
// `name = (` declaration (col-0 only; `name*`/`name = <T>(` are excluded since the char after the
// name is not `=`, and a generic's `<` is not `(`), and require every such `name` to appear in `c`.
// `\s` is approximated by space/tab between the tokens (the only whitespace real source uses there);
// this only ever matches a SUBSET of the regex, so it can never raise a failure the regex wouldn't.
// Byte access goes through a single `[u8]` view (O(1) index) — NOT `at` (which re-strlens per call).
om_decls_survive = (mp: MutPtr<Malloc>, src: string_view, c: string_view) bool {
    sv: [u8] := src.view()
    n := sv.len
    i: i64 := 0
    ls := true    // at a line start?
    ok := true
    @while (i < n) {
        b := sv[i]
        (ls && om_is_alpha(b)).then({
            // identifier [i, e)
            e := i
            @while (e < n && om_is_alnum(sv[e])) {
                e = e + 1
            }
            // skip spaces/tabs, expect '='
            q := e
            @while (q < n && (sv[q] == ' ' || sv[q] == '\t')) {
                q = q + 1
            }
            (q < n && sv[q] == '=').then({
                // skip spaces/tabs, expect '('
                q2 := q + 1
                @while (q2 < n && (sv[q2] == ' ' || sv[q2] == '\t')) {
                    q2 = q2 + 1
                }
                (q2 < n && sv[q2] == '(').then({
                    name := mp.substr(src, i, e - i).expect("harness: oom")
                    (contains(c, name) == false).then({
                        ok = false
                    })
                })
            })
        })
        ls = b == '\n'
        i = i + 1
    }
    ok
}
// PARALLEL acid (3-phase, dogfoods zo_par_run): `zenc emit <src>` for each real compiler/std source runs
// across the worker pool, each writing a gid-namespaced C output + P/F marker; Phase C reads them IN ORDER
// and applies the SAME check (rc 0 AND output starts with HEAD AND every top-level decl name survives) —
// byte-identical verdict to the old serial loop. Emitting the big compiler files serially was ~21s.
om_acid_cmd = (mp: MutPtr<Malloc>, gid: i64, path: string_view) string_view {
    z: string_view := ""
    outp := mp.zo_idpath("zo_acid", gid, ".c")
    rc := mp.zo_idpath("zo_acidrc", gid, ".txt")
    mp.zo_join([z, "if ./zen emit ", path, " > ", outp, " 2>/dev/null; then echo P > ", rc, "; else echo F > ", rc, "; fi"])
}
om_acid_ok = (mp: MutPtr<Malloc>, gid: i64, path: string_view) bool {
    passed := mp.om_read_file(mp.zo_idpath("zo_acidrc", gid, ".txt")).starts_with("P")
    passed.match ({
        true  => {
            txt := mp.om_read_file(mp.zo_idpath("zo_acid", gid, ".c"))
            src := mp.om_read_file(path)
            txt.starts_with(HEAD).match ({ true => mp.om_decls_survive(src, txt), false => false })
        },
        false => false,
    })
}
harness_misc_acid = () i32 {
    m := Malloc(_: 0)
    mp := m.addr()
    files := ["src/std/concurrent/atomic.zen", "src/std/build.zen", "src/std/json.zen", "src/std/math.zen", "src/std/os.zen", "src/std/rand.zen", "src/std/scope.zen", "src/std/concurrent/sync.zen", "src/std/concurrent/thread.zen", "src/compiler/check.zen", "src/compiler/passes/ptrkind.zen", "src/compiler/passes/lift.zen", "src/compiler/passes/orreturn.zen", "src/compiler/passes/subst.zen", "src/compiler/passes/closures.zen", "src/compiler/passes/refcount.zen", "src/compiler/validate/util.zen", "src/compiler/validate/diag.zen", "src/compiler/validate/ownership.zen", "src/compiler/validate/args.zen", "src/compiler/validate/kinds.zen", "src/compiler/validate/enrich.zen", "src/compiler/validate/core.zen", "src/compiler/diagnostic.zen", "src/compiler/genc.zen", "src/compiler/genc_emit.zen", "src/compiler/pretty.zen", "src/compiler/lex.zen", "src/compiler/mono.zen", "src/compiler/parse.zen", "src/compiler/parse_expr.zen", "src/compiler/parse_stmt.zen", "src/compiler/parse_type.zen"]
    out("acid (emit real sources)")
    out("\n")
    n := files.len
    base := malloc(n * 8)
    cmds: [string_view] := base.slice(n)
    files.loop((h, i, f) {
        cmds[i] = mp.om_acid_cmd(i, f)
    })
    zo_par_run(cmds, n)
    fails := 0
    files.loop((h, i, f) {
        mp.om_acid_ok(i, f).match ({
            true  => out("."),
            false => {
                out("F")
                fails = fails + 1
            },
        })
    })
    out("\n")
    free(base)
    fails
}
// ════════════════════════════════════════════════════════════════════════════════
// differential  <- tests/test_differential.py
// Large GENERATED constructs (the bug-hunt #15/#16 parser-buffer overflow guard): 80 params, 80
// fields, 80 match arms — all comfortably past the old fixed caps (64 / 16). Built as Zen source
// strings here, then run through the VALUE harness.
// ════════════════════════════════════════════════════════════════════════════════
// append a 2-digit identifier suffix ("00".."79") — leading zeros are fine inside an identifier.
om_app2 = (mp: MutPtr<Malloc>, s: String, n: i32) String {
    tens: u8 := ('0' + n / 10).to_u8()
    ones: u8 := ('0' + (n - n / 10 * 10)).to_u8()
    s2 := mp.push_in(s, tens).expect("harness: oom")
    mp.push_in(s2, ones).expect("harness: oom")
}
// append a decimal integer VALUE (no leading zeros) — for argument / arm constants.
om_app_int = (mp: MutPtr<Malloc>, s: String, n: i32) String {
    (n < 10).match ({
        true  => {
            d: u8 := ('0' + n).to_u8()
            mp.push_in(s, d).expect("harness: oom")
        },
        false => {
            s2 := mp.om_app_int(s, n / 10)
            d2: u8 := ('0' + (n - n / 10 * 10)).to_u8()
            mp.push_in(s2, d2).expect("harness: oom")
        },
    })
}
om_sep = (mp: MutPtr<Malloc>, s: String, i: i32) String { (i == 0).match ({
    true  => s,
    false => s.append_in(mp, ", ").expect("harness: oom"),
}) }
// "p00: i32, p01: i32, ..." — param declarations
om_decl_params = (mp: MutPtr<Malloc>, s: String, i: i32, n: i32) String {
    (i >= n).match ({
        true  => s,
        false => {
            s1 := mp.om_sep(s, i)
            s2 := s1.append_in(mp, "p").expect("harness: oom")
            s3 := mp.om_app2(s2, i)
            s4 := s3.append_in(mp, ": i32").expect("harness: oom")
            mp.om_decl_params(s4, i + 1, n)
        },
    })
}
// "0, 1, ..., 79" — call argument values
om_call_args = (mp: MutPtr<Malloc>, s: String, i: i32, n: i32) String {
    (i >= n).match ({
        true  => s,
        false => {
            s1 := mp.om_sep(s, i)
            s2 := mp.om_app_int(s1, i)
            mp.om_call_args(s2, i + 1, n)
        },
    })
}
// "x00: i32, x01: i32, ..." — field declarations
om_decl_fields = (mp: MutPtr<Malloc>, s: String, i: i32, n: i32) String {
    (i >= n).match ({
        true  => s,
        false => {
            s1 := mp.om_sep(s, i)
            s2 := s1.append_in(mp, "x").expect("harness: oom")
            s3 := mp.om_app2(s2, i)
            s4 := s3.append_in(mp, ": i32").expect("harness: oom")
            mp.om_decl_fields(s4, i + 1, n)
        },
    })
}
// "x00: 0, x01: 1, ..." — struct-literal field inits
om_init_fields = (mp: MutPtr<Malloc>, s: String, i: i32, n: i32) String {
    (i >= n).match ({
        true  => s,
        false => {
            s1 := mp.om_sep(s, i)
            s2 := s1.append_in(mp, "x").expect("harness: oom")
            s3 := mp.om_app2(s2, i)
            s4 := s3.append_in(mp, ": ").expect("harness: oom")
            s5 := mp.om_app_int(s4, i)
            mp.om_init_fields(s5, i + 1, n)
        },
    })
}
// "0 => 0, 1 => 2, ..." — match arms (value i => 2*i)
om_arms = (mp: MutPtr<Malloc>, s: String, i: i32, n: i32) String {
    (i >= n).match ({
        true  => s,
        false => {
            s1 := mp.om_sep(s, i)
            s2 := mp.om_app_int(s1, i)
            s3 := s2.append_in(mp, " => ").expect("harness: oom")
            s4 := mp.om_app_int(s3, i * 2)
            mp.om_arms(s4, i + 1, n)
        },
    })
}
om_gen_many_params = (mp: MutPtr<Malloc>) string_view {
    s := mp.new_in().expect("harness: oom")
    s = s.append_in(mp, "f* = (").expect("harness: oom")
    s = mp.om_decl_params(s, 0, 80)
    s = s.append_in(mp, ") i32 { p79 }\ntest* = () i32 { f(").expect("harness: oom")
    s = mp.om_call_args(s, 0, 80)
    s = s.append_in(mp, ") }").expect("harness: oom")
    mp.finish_in(s).expect("harness: oom")
}
om_gen_many_fields = (mp: MutPtr<Malloc>) string_view {
    s := mp.new_in().expect("harness: oom")
    s = s.append_in(mp, "S*: { ").expect("harness: oom")
    s = mp.om_decl_fields(s, 0, 80)
    s = s.append_in(mp, " }\ntest* = () i32 { S(").expect("harness: oom")
    s = mp.om_init_fields(s, 0, 80)
    s = s.append_in(mp, ").x79 }").expect("harness: oom")
    mp.finish_in(s).expect("harness: oom")
}
om_gen_many_arms = (mp: MutPtr<Malloc>) string_view {
    s := mp.new_in().expect("harness: oom")
    s = s.append_in(mp, "test* = () i32 { (50).match({ ").expect("harness: oom")
    s = mp.om_arms(s, 0, 80)
    s = s.append_in(mp, ", _ => 999 }) }").expect("harness: oom")
    mp.finish_in(s).expect("harness: oom")
}
harness_misc_differential = () i32 {
    m := Malloc(_: 0)
    mp := m.addr()
    r1 := run_value(VCase(
        src: mp.om_gen_many_params(),
        want: "79",
    ))
    r2 := run_value(VCase(
        src: mp.om_gen_many_fields(),
        want: "79",
    ))
    r3 := run_value(VCase(
        src: mp.om_gen_many_arms(),
        want: "100",
    ))
    run_suite("differential (large constructs)", [r1, r2, r3])
}
// ════════════════════════════════════════════════════════════════════════════════
// faithful_ast  <- tests/test_faithful_ast.py
// `zenc fmt --ast` pretty-prints the FAITHFUL AST: UFCS survives the round-trip, the printer doesn't
// introduce the three known bug classes (dropped parens / spurious return / mangled imports), formatting
// is idempotent, and on a REAL corpus emit(fmt F) == emit(F) and fmt(fmt F) == fmt(F).
// ════════════════════════════════════════════════════════════════════════════════
// fmt --ast a source string, returning the formatted output.
om_do_fmt = (mp: MutPtr<Malloc>, src: string_view) string_view {
    save(mp.zo_path("zo_misc_fa.zen"), src, len(src))
    save(mp.zo_path("zo_misc_fa.out"), "", 0)
    shell(mp.zo_cmd("./zen fmt --ast $ZT/zo_misc_fa.zen > $ZT/zo_misc_fa.out 2>/dev/null"))
    mp.om_read_file(mp.zo_path("zo_misc_fa.out"))
}
// emit a source string, returning the emitted C.
om_do_emit = (mp: MutPtr<Malloc>, src: string_view) string_view {
    save(mp.zo_path("zo_misc_em.zen"), src, len(src))
    save(mp.zo_path("zo_misc_em.c"), "", 0)
    shell(mp.zo_cmd("./zen emit $ZT/zo_misc_em.zen > $ZT/zo_misc_em.c 2>/dev/null"))
    mp.om_read_file(mp.zo_path("zo_misc_em.c"))
}
// `zenc run` a source string, returning the program's exit code (a value-returning main's value).
// `shell` already DECODES the wait status (WEXITSTATUS, or 128 + signal), so its `.Ok` is the exit code
// a normally-terminating program returned.
om_run_rc = (src: string_view) i32 {
    m := Malloc(_: 0)
    mp := m.addr()
    save(mp.zo_path("zo_misc_run.zen"), src, len(src))
    shell(mp.zo_cmd("./zen run $ZT/zo_misc_run.zen > /dev/null 2>&1")).expect("harness: shell")
}
// fmt --ast a source, then run the FORMATTED output; returns its exit code.
om_fmt_then_run = (mp: MutPtr<Malloc>, src: string_view) i32 {
    save(mp.zo_path("zo_misc_ftr.zen"), src, len(src))
    shell(mp.zo_cmd("./zen fmt --ast $ZT/zo_misc_ftr.zen > $ZT/zo_misc_ftr_f.zen 2>/dev/null"))
    shell(mp.zo_cmd("./zen run $ZT/zo_misc_ftr_f.zen > /dev/null 2>&1")).expect("harness: shell")
}
// fmt(fmt src) == fmt(src) on a source string.
om_fmt_idem = (src: string_view) bool {
    m := Malloc(_: 0)
    mp := m.addr()
    save(mp.zo_path("zo_misc_id.zen"), src, len(src))
    shell(mp.zo_cmd("./zen fmt --ast $ZT/zo_misc_id.zen > $ZT/zo_misc_id1.zen 2>/dev/null"))
    shell(mp.zo_cmd("./zen fmt --ast $ZT/zo_misc_id1.zen > $ZT/zo_misc_id2.zen 2>/dev/null"))
    shell(mp.zo_cmd("cmp -s $ZT/zo_misc_id1.zen $ZT/zo_misc_id2.zen")).expect("harness: shell") == 0
}
// fmt(fmt F) == fmt(F) on a real corpus file at repo path `rel`.
om_corpus_idem = (mp: MutPtr<Malloc>, rel: string_view) bool {
    shell(mp.zo_cmd(mp.om_cat3("./zen fmt --ast ", rel, " > $ZT/zo_misc_c1.zen 2>/dev/null")))
    shell(mp.zo_cmd("./zen fmt --ast $ZT/zo_misc_c1.zen > $ZT/zo_misc_c2.zen 2>/dev/null"))
    shell(mp.zo_cmd("cmp -s $ZT/zo_misc_c1.zen $ZT/zo_misc_c2.zen")).expect("harness: shell") == 0
}
// emit(fmt F) == emit(F): the formatted AST resolves to byte-identical C (ZEN_ROOT=. resolves the
// repo's std/compiler imports for both the original copy and the formatted copy identically).
om_corpus_emit_eq = (mp: MutPtr<Malloc>, rel: string_view) bool {
    shell(mp.zo_cmd(mp.om_cat3("./zen fmt --ast ", rel, " > $ZT/zo_misc_cf.zen 2>/dev/null")))
    shell(mp.zo_cmd(mp.om_cat3("cp ", rel, " $ZT/zo_misc_co.zen")))
    shell(mp.zo_cmd("ZEN_ROOT=. ./zen emit --force $ZT/zo_misc_co.zen > $ZT/zo_misc_eo.c 2>/dev/null"))
    shell(mp.zo_cmd("ZEN_ROOT=. ./zen emit --force $ZT/zo_misc_cf.zen > $ZT/zo_misc_ef.c 2>/dev/null"))
    shell(mp.zo_cmd("cmp -s $ZT/zo_misc_eo.c $ZT/zo_misc_ef.c")).expect("harness: shell") == 0
}
harness_misc_faithful = () i32 {
    m := Malloc(_: 0)
    mp := m.addr()
    // fmt-output / emit / run scenarios (one bool per pytest assertion class).
    o_ufcs := mp.om_do_fmt("len = (s: str) i32 { 5 }\nmain = () i32 { x := \"hi\"\n x.len() }\n")
    o_chain := mp.om_do_fmt("add = (a: i32, b: i32) i32 { a + b }\nmain = () i32 { 1.add(2).add(3) }\n")
    o_arms := mp.om_do_fmt("add = (a: i32, b: i32) i32 { a + b }\nOpt: Some(i32) | None\nclassify = (o: Opt) i32 { o.match ({ .Some(n) => n.add(1), .None => 0 }) }\n")
    o_bin := mp.om_do_fmt("check = (n: i32) i32 { (n > 0).match ({ true => 1, false => 0 }) }\n")
    o_tail := mp.om_do_fmt("len = (s: str) i32 { 5 }\nf = (s: str) i32 { s.len() }\n")
    o_ret := mp.om_do_fmt("g = (n: i32) i32 {\n    (n < 0).match ({ true => { return 9 }, false => {} })\n    n\n}\n")
    o_imp := mp.om_do_fmt("{ println } = std.text.fmt\nhelper* = (n: i32) i32 { n }\nmain = () i32 { 0 }\n")
    o_lam := mp.om_do_fmt("apply = (f: (i32) i32, n: i32) i32 { f(n) }\nmain = () i32 { g := (x: i32) i32 { x + 1 }\n apply(g, 7) }\n")
    o_var := mp.om_do_fmt("sum = (xs: ...i32) i32 { 0 }\n")
    o_vdef := mp.om_do_fmt("Pixel: RGB(i32) | Blank = RGB(255)\n")
    o_simpl := mp.om_do_fmt("Label*: { label: (str) i32 }\nstr.impl(Label, { label = (s: str) i32 { 0 } })\n")
    // #61: a u64 literal above i64-max round-trips to its exact UNSIGNED decimal, never the signed-
    // normalized value (0xcbf29ce484222325 → 14695981039346656037, NOT -3750763034362895579).
    o_u64 := mp.om_do_fmt("main = () i32 { x: u64 := 0xcbf29ce484222325\n 0 }\n")
    o_emit := mp.om_do_emit("len = (s: str) i32 { 5 }\nmain = () i32 { x := \"hi\"\n x.len() }\n")
    f1 := run_suite("faithful_ast (fmt/run)", [o_emit.contains("len("), o_ufcs.contains("x.len()"), om_not(o_ufcs.contains("len(x)")), o_chain.contains("1.add(2).add(3)"), o_arms.contains(".Some(n) => n.add(1),"), o_arms.contains(".None    => 0,"), o_bin.contains("(n > 0).match"), om_not(o_bin.contains("n > 0.match")), o_tail.contains("s.len()"), om_not(o_tail.contains("return s.len()")), o_ret.contains("return 9"), o_imp.contains("{ println } = std.text.fmt"), o_imp.contains("helper* = (n: i32) i32"), o_lam.contains("(x: i32) i32 {"), om_not(o_lam.contains("x: void")), o_var.contains("xs: ...i32"), o_vdef.contains("Blank = RGB(255)"), o_simpl.contains("string_view.impl(Label"), om_not(o_simpl.contains("str.impl(Label")), o_u64.contains("14695981039346656037"), om_not(o_u64.contains("3750763034362895579")), om_fmt_idem("main = () i32 { x: u64 := 0xcbf29ce484222325\n 0 }\n"), om_run_rc("inc = (n: i32) i32 { n + 1 }\ndbl = (n: i32) i32 { n * 2 }\nmain = () i32 { 5.inc().dbl() }\n") == 12, om_run_rc("add3 = (a: i32, b: i32, c: i32) i32 { a + b * 10 + c * 100 }\nmain = () i32 { 1.add3(2, 0) }\n") == 21, mp.om_fmt_then_run("inc = (n: i32) i32 { n + 1 }\ndbl = (n: i32) i32 { n * 2 }\nmain = () i32 { 5.inc().dbl() }\n") == 12, mp.om_fmt_then_run("apply = (f: (i32) i32, n: i32) i32 { f(n) }\nmain = () i32 { g := (x: i32) i32 { x + 1 }\n apply(g, 7) }\n") == 8, om_fmt_idem("Point: { x: i32, y: i32 }\nOpt: Some(i32) | None\nadd = (a: i32, b: i32) i32 { a + b }\nclassify = (o: Opt) i32 { o.match ({ .Some(n) => n.add(1), .None => 0 }) }\nmain = () i32 { p := Point(x: 3, y: 4)  1.add(2).add(3) }\n")])
    // PHASE 1: emit of `s.len()` still lowers to the flat `len(...)`
    // PHASE 2: fmt --ast keeps UFCS — `x.len()`, NOT `len(x)`
    // a multi-arg method chain round-trips with method args inside the parens
    // match arms split one-per-line, `=>` aligned, trailing comma, UFCS body kept
    // a Bin subject of `.match` stays parenthesized
    // an implicit tail expr prints bare (no spurious `return`)
    // an EXPLICIT early return keeps the keyword
    // imports print their `= <module>` tail; exported decls keep `*`
    // lambda `: Type` params + return type are PRESERVED; an unannotated param prints bare, never `x: void`
    // a `...T` variadic param round-trips as `...T`
    // a zero-arg variant default keeps its ` = expr` tail
    // a >i64-max u64 literal prints its exact unsigned decimal (not the signed-normalized value) + is a fmt fixpoint
    // UFCS method chain runs to the same value as the prefix form ((5+1)*2 = 12)
    // a method with extra args lowers to recv-first order (add3(1, 2, 0) = 21)
    // the formatted source recompiles + runs to the same value (12)
    // the formatted lambda program recompiles + runs (8)
    // formatting is a fixpoint on a mixed program
    // round-trip over a REAL corpus: idempotent AND emit(fmt) == emit(orig) per file.
    corpus := ["src/std/text/str.zen", "src/std/core/result.zen", "src/std/mem/rc.zen", "src/std/mem/trace.zen", "src/std/collections/vec.zen", "src/compiler/lex.zen", "src/compiler/parse_type.zen", "src/compiler/parse_expr.zen"]
    out("faithful_ast (corpus round-trip)")
    out("\n")
    cfails := 0
    corpus.loop((h, i, rel) {
        mp.om_corpus_idem(rel).match ({
            true  => out("."),
            false => {
                out("F")
                cfails = cfails + 1
            },
        })
        mp.om_corpus_emit_eq(rel).match ({
            true  => out("."),
            false => {
                out("F")
                cfails = cfails + 1
            },
        })
    })
    out("\n")
    f1 + cfails
}
// ── variant-break shapes (#364 follow-up): fmt round-trip must preserve behavior ──
// The comment-gap ctor and the depth-suppressed splits (paren group / slice element / match-arm
// value) all normalize to the one-line `Type.Variant(…)` under fmt; the formatted source must
// recompile and run to the SAME value, and formatting must be a fixpoint on the raw shapes.
harness_misc_vbreak = () i32 {
    m := Malloc(_: 0)
    mp := m.addr()
    s_cmt := "Res: Okv(i32) | Nov\nmain = () i32 {\n    x := Res /* continuation\n    comment */ .Okv(42)\n    x.match ({ .Okv(v) => v, .Nov => 9, })\n}\n"
    s_arm := "Res: Okv(i32) | Nov\npick = (c: bool) Res {\n    c.match ({\n        true => Res\n        .Okv(1),\n        false => Res.Nov,\n    })\n}\nmain = () i32 { pick(true).match ({ .Okv(v) => v + 41, .Nov => 9, }) }\n"
    s_paren := "Res: Okv(i32) | Nov\nmain = () i32 {\n    x := (Res\n    .Okv(2))\n    x.match ({ .Okv(v) => v + 40, .Nov => 9, })\n}\n"
    s_slice := "Res: Okv(i32) | Nov\nmain = () i32 {\n    xs: [Res] := [Res.Okv(1), Res\n    .Okv(2)]\n    xs[1].match ({ .Okv(v) => v + 40, .Nov => 9, })\n}\n"
    // #53: a VALUE-position bare ctor `.None` (RHS of `:=`) directly before a parenthesized statement
    // must NOT fuse into a call `.None(cond)…` — the `(` starts a NEW statement. The same-line gate in
    // parse_ctor_named keeps `.None` a bare tag; the formatted source must run to the SAME value (5) and
    // the formatter output must never emit the glued `.None(` call.
    s_valnone := "Opt<T>: Some(T) | None\nf = (cond: bool) i32 {\n    out: Opt<i32> := .None\n    (cond).match ({ true => { out = .Some(5) }, false => {} })\n    out.match ({ .Some(v) => v, .None => 0 })\n}\nmain = () i32 { f(true) }\n"
    o_valnone := mp.om_do_fmt(s_valnone)
    run_suite("variant-break fmt round-trip", [om_run_rc(s_cmt) == 42, mp.om_fmt_then_run(s_cmt) == 42, om_run_rc(s_arm) == 42, mp.om_fmt_then_run(s_arm) == 42, om_run_rc(s_paren) == 42, mp.om_fmt_then_run(s_paren) == 42, om_run_rc(s_slice) == 42, mp.om_fmt_then_run(s_slice) == 42, om_fmt_idem(s_cmt), om_fmt_idem(s_arm), om_fmt_idem(s_paren), om_fmt_idem(s_slice), om_run_rc(s_valnone) == 5, mp.om_fmt_then_run(s_valnone) == 5, om_fmt_idem(s_valnone), o_valnone.contains(":= .None"), om_not(o_valnone.contains(".None("))])
}
// errors-as-values fixes in std.io.file, asserted directly:
//  - save() now checks close() and STILL returns .Ok(bytes) on a normal path (the close guard didn't
//    break the happy path — the close-FAILURE path can't be provoked without an NFS/ENOSPC mount).
//  - shell() returns Result<i32, IoError> whose .Ok is the DECODED exit status (the shell `$?`
//    convention): WEXITSTATUS for a normal exit, 127 for a command sh can't run, 128 + signal for a
//    signal death. Before the fix it handed back the raw wait status with these folded together.
om_shell_code = (cmd: string_view) i32 {
    shell(cmd).match ({
        .Ok(c)  => c,
        .Err(e) => 0 - 1,
    })
}
// out/out_bytes are the low-level stdout write funnel; they now return Result<i64, IoError> (a
// write-all loop) instead of swallowing a short/failed write(2). This asserts the NEW contract in
// process: writing the 3-byte "hi\n" MATCHES as `.Ok(3)` — adversarial, since a wrong count or an
// `.Err` fails the bool. The 3 bytes land on the harness's own stdout (same sink as the progress
// dots). (println/print stay best-effort and keep their i64 signatures — exercised by every other
// value case that prints via fmt.)
om_out_bytes_ok = () bool {
    out_bytes(view("hi\n")).match ({
        .Ok(n)  => n == 3,
        .Err(e) => false,
    })
}
harness_misc_iofile = () i32 {
    m := Malloc(_: 0)
    mp := m.addr()
    saved := save(mp.zo_path("zo_misc_save.txt"), "hello", 5).match ({
        .Ok(n)  => n == 5,
        .Err(e) => false,
    })
    run_suite("io.file (save close-check + shell decoded status + out_bytes Result)", [saved, om_out_bytes_ok(), om_shell_code("exit 0") == 0, om_shell_code("exit 3") == 3, om_shell_code("exit 42") == 42, om_shell_code("this_is_not_a_real_command_zqx 2>/dev/null") == 127, om_shell_code("kill -9 $$") == 137])
}
// ── FFI drift gate: std's foreign prototypes vs the REAL system headers ─────────
// scripts/ffi_verify.sh re-lowers every foreign decl in the std closure via `zenc emit` and
// compares the extracted prototypes against glibc's declarations (libm verbatim under the
// conflicting-types rule, the rest slot-by-slot at ABI-class level via g++ static_asserts).
// The script exits 0 with a notice on non-Linux hosts or without gcc/g++ (a clean SKIP), so
// this case only bites where the system headers exist — CI always has them.
harness_misc_ffi_verify = () i32 {
    m := Malloc(_: 0)
    mp := m.addr()
    run_suite("ffi-verify (foreign prototypes match system headers)", [shell(mp.zo_cmd("scripts/ffi_verify.sh ./zen > /dev/null 2>&1")).expect("harness: shell") == 0])
}
// ── category entry: sum every sub-suite's fail count ────────────────────────────
harness_misc_run* = () i32 {
    fails := 0
    fails = fails + harness_misc_traits()
    fails = fails + harness_misc_string_types()
    fails = fails + harness_misc_num_parse()
    fails = fails + harness_misc_hash()
    fails = fails + harness_misc_acid()
    fails = fails + harness_misc_differential()
    fails = fails + harness_misc_faithful()
    fails = fails + harness_misc_vbreak()
    fails = fails + harness_misc_iofile()
    fails = fails + harness_misc_ffi_verify()
    fails
}
