// The record `env.args<T>()` answers is usable at its written type: a
// `.try()` unwraps it into a Cfg slot, its fields read, and the call fits a
// `Res<Cfg, ArgError>` slot rather than retaining the door's unbound `T`.
//
// The annotations are intentional. Inference through an unannotated generic
// result is a general backend gap (and is not specific to this capability);
// this test pins the capability's concrete answer without claiming that gap
// is closed here.

ArgError = std.env

Cfg = {
    count :: usize = 7,
    name:    str,
}

main = (env: Env) Res<i32, ArgError> {
    direct: Cfg = env.args<Cfg>().try();
    println("{} {}", direct.name, direct.count);
    answer: Res<Cfg, ArgError> = env.args<Cfg>();
    answer.match({
        Ok(c)  => println("again {}", c.name),
        Err(_) => println("failed"),
    });
    Ok(0);
}
