// M4 SLICE 2'S GATE, THE BY-HAND TWIN of `field_walk_via_meta.zen`:
// the same program with every field spelled out — what the walk's
// unrolling claims to BE. The two share one byte-identical oracle.

Row = {
    n: i64,
    flag: bool,
    tag: str,

    show* = (self: @Self) () {
        println("n={}", self.n);
        println("flag={}", self.flag);
        println("tag={}", self.tag);
    },

    skip_tag* = (self: @Self) () {
        println("kept n");
        println("kept flag");
    },

    stop_at_flag* = (self: @Self) () {
        println("seen n");
    },
}

Box<T> = {
    v: T,

    show* = (self: @Self) () {
        println("box.v={}", self.v);
    },
}

describe* = (r: Row) () {
    println("[n] {}", r.n);
    println("[flag] {}", r.flag);
    println("[tag] {}", r.tag);
}

main = (env: Env) Res<i32, AllocError> {
    r = Row(n: 17, flag: true, tag: "qy");
    r.show();
    describe(r);
    r.skip_tag();
    r.stop_at_flag();
    println("count {}", 3);
    Box<i64>(v: 41).show();
    Box<str>(v: "hi").show();
    Ok(0);
}
