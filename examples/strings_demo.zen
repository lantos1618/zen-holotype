// strings_demo.zen — WHERE DO THE BYTES LIVE?
//
// A small real program (a log-line reformatter) written so that every byte in it can be
// pointed at and named: which block holds it, who owns that block, and when it dies.
//
//   $ ./zen run examples/strings_demo.zen
//
// It turns lines like `2026-07-25T10:31:02 ERROR auth: token expired` into an aligned
// table, and on the way walks five things in order: (1) every string-ish type side by
// side and what each OWNS, (2) a BORROW next to a COPY, (3) formatting, (4) buffer
// movement into/out of a callee and into a struct, (5) release.
//
// The rule followed everywhere: an ALLOCATED block is named in a comment together with
// whoever frees it. If you cannot name the freer, it is a leak.
//
// The allocator is THREADED, not ambient: every function that allocates takes `a: Allocator`
// as a parameter, so the freer is always something the caller can name. That parameter is
// sugar — `(a: Allocator)` is `<A: Allocator>(a: MutPtr<A>)` — and writing the bound is what
// makes a wrong allocator fail at the CALL, not inside std. docs/string-vec-model.md carries
// the wider model (allocator carried vs threaded, and where the string types are going).
//
// TWO HOUSE RULES shape the code below. Examples are gated ABOVE the raw pointer floor
// (no `offset`, no `slice(`, no `cstr`, no `sizeof`), so every block here comes out of a
// std.text.str call and every window is a `.view()`. A raw pointer is NAMED in exactly one
// shape — `something.view().ptr`, the argument `a.release` wants — and never arithmetic'd.
// And comments never trail after code, never sit directly above a `.loop(…)` / `.then(…)`
// statement, and never end a function body: `zen fmt` relocates all three (HONEST NOTE 3).
halloc = std.mem.heap
{ println, formatln, arg_int, arg_str, arg_owned } = std.text.fmt
{ String, init, append_in, free_in } = std.text.string
{ sb } = std.text.sb
{ view, len, find, substr, split, nbuf, pad_right, repeat, trim_view, trim_prefix, own_ptr,
  own_window } = std.text.str
{ Result, ok, expect } = std.core.result
{ Allocator, release_slice } = std.mem.alloc
// `str` is NUL-terminated, so dropping a PREFIX is free — the source's own NUL still
// terminates what is left, and `trim_prefix` just hands back a pointer further along the
// same block. Dropping a SUFFIX is not free (the new end has no NUL of its own). That one
// asymmetry is why the parser below COPIES its first three fields and BORROWS the last.
wider = (x: i64, y: i64) i64 { (x > y).then({ x }, { y }) }
// ── 1. every string-ish type, side by side ───────────────────────────────────
// Four types today. docs/string-vec-model.md names the five ROLES they are converging on
// (literal / const / fixed / growable / view) and why `String` is exactly `Vec<u8>`.
show_types = (a: Allocator) void {
    println("-- 1. every string-ish type, and what it owns --")
    // (a) STRING LITERAL — bytes in the binary's read-only data. No allocation, no free;
    //     they outlive every function that sees them.
    lit: StringView = "zen strings"
    formatln("  literal  {} len={}  storage=binary .rodata          freed=never", [arg_str(lit), arg_int(lit.len())])
    // (b) str / StringView — a BORROWED, NUL-terminated pointer, carrying no length and
    //     no allocator. Same address as `lit`; owns nothing, the literal is still owner.
    borrowed: StringView = lit
    formatln("  str      {} len={}  storage=whatever it points at   freed=by that owner", [arg_str(borrowed), arg_int(borrowed.len())])
    // (c) [u8] — a slice: (ptr, len). A WRITABLE window over someone else's block. Owns
    //     nothing either, but it carries a length and you can store through it.
    win: Slice<u8> = lit.view()
    formatln("  [u8]     {} len={}  storage=whatever it points at   freed=by that owner", [arg_str(lit), arg_int(win.len)])
    // (d) String — the only OWNING type: (ptr, len, cap) over an allocator-backed block
    //     that grows. The next two lines ALLOCATE; the free_in below is the freer.
    g ::= a.init(16).expect("strings_demo: out of memory")
    g = a.append_in(g, lit).expect("strings_demo: out of memory")
    formatln("  String   {} len={}  storage=heap block from `a`     freed=free_in (cap={})", [arg_str(lit), arg_int(g.len), arg_int(g.cap)])
    // FREE: the String's block. Nothing else in this function allocated.
    g.free_in(a)
}
// ── 2. borrowing vs copying ──────────────────────────────────────────────────
show_borrow_vs_copy = (a: Allocator) void {
    println("")
    println("-- 2. borrow vs copy --")
    padded: StringView = "   auth: token expired   "
    // BORROW. trim_view returns a [u8] aiming INTO `padded`. Zero bytes allocated. It is
    // a [u8] and not a str precisely because the trimmed end has no NUL of its own.
    tv: Slice<u8> = padded.trim_view()
    formatln("  BORROW  trim_view -> [u8] len={}, allocated 0 bytes (aims into the literal)", [arg_int(tv.len)])
    // COPY. THIS LINE ALLOCATED: substr mallocs len+1 bytes through `a` and copies into
    // them, so the result gets its own NUL and can be handed round as a str.
    cp = a.substr(padded, 3, tv.len).expect("strings_demo: out of memory")
    formatln("  COPY    substr    -> str  len={}, allocated {} bytes (fresh block, `a` owns it)", [arg_int(cp.len()), arg_int(tv.len + 1)])
    // ALIASING, made unmissable. ALLOC: `mine` is a fresh block, freed six lines down.
    mine = a.substr("shared bytes", 0, 12).expect("strings_demo: out of memory")
    // OWN: a WRITABLE window over mine's block. `view()` is the borrowed, read-only window and
    // would refuse the store below — `own_window` is the spelling that says "I allocated these".
    port :: [u8] = mine.own_ptr().own_window(mine.len())
    // One store through the window. Nothing copies it back — the source simply IS those
    // bytes, so `mine` reads differently on the very next line.
    port[0] = 'S'
    formatln("  ALIAS   stored 'S' through a [u8] window; its source now reads: {}", [arg_str(mine)])
    // FREE both copies. `padded` and "shared bytes" are literals and are NOT freed —
    // handing .rodata to free() would abort. Only what `a` handed out goes back to `a`.
    a.release(cp.own_ptr())
    a.release(mine.own_ptr())
    println("  FREED   both substr blocks released; the two literals are never freed")
}
// ── the parser: three copies and one borrow ──────────────────────────────────
// One parsed log line. The asymmetry is the whole lesson:
//   ts, level, comp  end BEFORE the end of the line, so each needs its own NUL and so
//                    its own block — three COPIES owned by parse_line's allocator.
//   msg              runs to the end of the line, so it is a free tail view: a BORROW
//                    into the caller's line buffer, dying with it.
Fields*: {
    ts: StringView,
    level: StringView,
    comp: StringView,
    msg: StringView,
    // Release exactly the three blocks parse_line allocated. `msg` is deliberately
    // absent: it points into the MIDDLE of the caller's line block, and freeing an
    // interior pointer is undefined. Whoever frees the line frees msg with it.
    free = (f: Fields, a: Allocator) void {
        a.release(f.ts.own_ptr())
        a.release(f.level.own_ptr())
        a.release(f.comp.own_ptr())
    }
}
blank_fields = () Fields {
    Fields(
        ts: "",
        level: "",
        comp: "",
        msg: "",
    )
}
// A field length, clamped so a missing separator still yields a legal (empty) copy; the
// real complaint is raised once, below, after every block has been accounted for.
upto = (i: i64) i64 { (i < 0).then({ 0 }, { i }) }
// "<ts> <level> <comp>: <msg>" -> Fields, or an .Err message. Parse failure IS a value
// (it is expected); allocation failure panics via `.expect`, this being a fail-fast root
// — the same call shape wordfreq.zen and jq.zen use.
//
// Read it as an alternating rhythm: substr ALLOCATES a field, trim_prefix then steps over
// the bytes just copied for FREE. Three mallocs, three zero-cost steps.
parse_line* = (a: Allocator, line: StringView) Result<Fields, StringView> {
    i1 = line.find(" ")
    // ALLOC 1 of 3.
    ts = a.substr(line, 0, i1.upto()).expect("strings_demo: out of memory")
    // BORROW: same block as `line`, just further along. 0 bytes.
    rest = line.trim_prefix(ts).trim_prefix(" ")
    i2 = rest.find(" ")
    // ALLOC 2 of 3.
    level = a.substr(rest, 0, i2.upto()).expect("strings_demo: out of memory")
    body = rest.trim_prefix(level).trim_prefix(" ")
    i3 = body.find(":")
    // ALLOC 3 of 3.
    comp = a.substr(body, 0, i3.upto()).expect("strings_demo: out of memory")
    // BORROW: the tail of the caller's line block, and the last field. 0 bytes.
    msg = body.trim_prefix(comp).trim_prefix(": ")
    (i1 < 0 || i2 < 0 || i3 < 0).match ({
        true  => {
            // FREE: the error path owns the three blocks it already took, and must give
            // them back. A `return` that skipped this would leak on every bad line.
            a.release(ts.own_ptr())
            a.release(level.own_ptr())
            a.release(comp.own_ptr())
            bad: Result<Fields, StringView> = .Err("expected '<ts> <level> <comp>: <msg>'")
            return bad
        },
        false => 0,
    })
    // Three owned blocks and one borrow. Their freer is Fields.free above, which
    // free_rows calls once per row.
    f = Fields(
        ts: ts,
        level: level,
        comp: comp,
        msg: msg,
    )
    out: Result<Fields, StringView> = ok(f)
    out
}
// Column widths, widened one parsed row at a time. A pure value: nothing owned.
Widths*: {
    ts: i64,
    level: i64,
    comp: i64,
    msg: i64,
    widen = (w: Widths, f: Fields) Widths {
        Widths(
            ts: w.ts.wider(f.ts.len()),
            level: w.level.wider(f.level.len()),
            comp: w.comp.wider(f.comp.len()),
            msg: w.msg.wider(f.msg.len()),
        )
    }
}
// ── 4. buffer movement ───────────────────────────────────────────────────────
// (a) A buffer passed INTO a callee. The CALLER allocated `out`; this function only
//     stores into it and never keeps the pointer, so ownership does NOT move — the
//     caller still frees. Overwriting bytes in place: no allocation anywhere here.
rule_into* = (out: [u8], fill: u8) void {
    out.loop((h, i, b) {
        out[i] = fill
    })
}
// Append `t`, padded to `w` columns, onto the String. Three memory events in three lines:
// pad_right ALLOCATES a temporary, append_in COPIES its bytes into the String's block, the
// now-dead temporary is RELEASED on the spot. This is the shape to copy.
push_pad = (a: Allocator, g: String, t: StringView, w: i64) String {
    p = a.pad_right(t, w, ' ')
    out = a.append_in(g, p).expect("strings_demo: out of memory")
    a.release(p.own_ptr())
    out
}
// (b) A buffer returned OUT of a callee. The String is built from `a` and RETURNED, so
//     ownership MOVES to the caller, who must call free_in. Growth is realloc inside
//     `a`, so the bytes never live on this stack frame and the return is safe.
render_row* = (a: Allocator, f: Fields, w: Widths) String {
    g ::= a.init(64).expect("strings_demo: out of memory")
    g = a.push_pad(g, f.ts, w.ts + 2)
    g = a.push_pad(g, f.level, w.level + 2)
    g = a.push_pad(g, f.comp, w.comp + 2)
    a.append_in(g, f.msg).expect("strings_demo: out of memory")
}
// (c) A buffer parked in a STRUCT. Report OWNS `body` (a String block) and BORROWS
//     `title` (a literal in .rodata). One field must be freed and the other must never
//     be; the `free` method is where that asymmetry is written down.
Report*: {
    title: StringView,
    body: String,
    free = (r: Report, a: Allocator) void { r.body.free_in(a) }
}
// Print every row: a block out of render_row, parked in a Report, then given back.
print_rows* = (a: Allocator, rows: [Fields], n: i64, w: Widths) void {
    rows.loop((h, i, f) {
        (i < n).then({
            // ALLOC: ownership MOVED out of render_row and into this frame.
            row = a.render_row(f, w)
            // The Report now holds the only reference to that block; `title` is a
            // literal it merely borrows and must never free.
            r = Report(
                title: "row",
                body: row,
            )
            // arg_owned writes the String by (ptr, len). Its bytes are NOT
            // NUL-terminated, so reading it as a str would need finish_in first.
            formatln("  {}", [arg_owned(r.body)])
            // FREE: Report hands the row block back; `title` is left untouched.
            r.free(a)
        })
    })
}
// ── 5. release ───────────────────────────────────────────────────────────────
// Three blocks per row. `msg` is never freed on its own: it is an interior pointer, and
// the line block it aims into is the thing that owns those bytes.
free_rows* = (a: Allocator, rows: [Fields], n: i64) void {
    rows.loop((h, i, f) {
        (i < n).then({
            f.free(a)
        })
    })
}
// The per-line copies split handed out — and so the bytes every `msg` borrow points at.
// Nothing may read a Fields after this runs.
free_lines* = (a: Allocator, lines: [StringView]) void {
    lines.loop((h, i, ln) {
        a.release(ln.view().ptr)
    })
}
log_text = () StringView {
    "2026-07-25T10:31:02 ERROR auth: token expired\n2026-07-25T10:31:07 WARN cache: 3 evictions\nnot a log line\n2026-07-25T10:32:00 INFO http: GET /health 200"
}
// HONEST NOTE 1, about main below. A `[T]` is (ptr, len), and `lines`/`rows` are the OWNING
// kind: split and nbuf each build one out of a single acquire of len * sizeof(T) bytes, so the
// slice's ptr is that block's base. Those two SLICE BACKBONES (lines.len * 8 bytes, rows.len *
// 32, 160 in all) go back through `a.release_slice(...)` at the bottom of main — the allocator
// surface's counterpart to nbuf, and the freer named alongside those two allocations below.
// Hand it an OWNING slice only: a window (`.view()`, `.trim_view()`) aims into the middle of
// somebody else's block, and freeing an interior pointer is undefined — `msg`'s rule exactly.
//
// HONEST NOTE 2 — what valgrind actually says, and all that is left. 37 allocations, 36 frees,
// ZERO bytes lost: every block named above goes back to `a`. The one survivor is 21 bytes STILL
// REACHABLE — fmt's integer scratch, one buffer per thread for the process lifetime (std.text.fmt
// `digits`), not a leak per integer and not this file's to free. Earlier revisions of this note
// also charged the program ~800 bytes for the `[arg_int(x), …]` slice literals handed to formatln;
// codegen no longer heap-promotes those, so that cost is gone. Re-measure before believing a
// number in a comment: `./zen build examples/strings_demo.zen -o /tmp/sd && valgrind /tmp/sd`.
//
// HONEST NOTE 3 — `zen fmt` moves comments: a trailing `// …`, a comment above a
// `.loop(…)` call, and a comment at the tail of a function body were each relocated on
// this file's first formatting pass. The layout here is written to dodge all three.
main = () i32 {
    m = halloc.gpa()
    a = m.addr()
    a.show_types()
    a.show_borrow_vs_copy()
    println("")
    println("-- 3-5. the real program: log lines -> aligned table --")
    // The source text is a LITERAL: static, never freed, outlives main.
    src: StringView = log_text()
    // split ALLOCATES twice over: one block for the [StringView] backbone, and one
    // NUL-terminated copy per line (it cannot hand back views — a line ends at '\n' and
    // there is no NUL there). free_lines frees the copies, release_slice the backbone.
    lines: [StringView] = a.split(src, '\n')
    // ALLOC: the row array's backbone. Its freer is the release_slice at the end of main.
    rows :: [Fields] = a.nbuf(blank_fields(), lines.len)
    n :: i64 = 0
    w ::= Widths(
        ts: 0,
        level: 0,
        comp: 0,
        msg: 0,
    )
    lines.loop((h, i, ln) {
        a.parse_line(ln).match ({
            .Ok(f)    => {
                rows[n] = f
                n = n + 1
                w = w.widen(f)
                0
            },
            .Err(msg) => formatln("  skipped line {}: {}", [arg_int(i + 1), arg_str(msg)]),
        })
    })
    // ── 3. formatting, two ways ──
    // (a) formatln STREAMS. The formatted bytes never exist as a buffer at all: each
    //     template chunk and each arg goes straight to write(2). Nothing to free.
    formatln("  parsed {} of {} lines; column widths {}/{}/{}/{}", [arg_int(n), arg_int(lines.len), arg_int(w.ts), arg_int(w.level), arg_int(w.comp), arg_int(w.msg)])
    // (b) std.text.sb BUILDS. The same pieces assembled into ONE owned, realloc'd heap
    //     block; `done()` returns the NUL-terminated str aiming at it, and that block is
    //     `a`'s until the release below. Use it when the text must be handed onwards.
    // The `StringView` annotation says "borrowed bytes we own the block of": `done()` hands back a
    // `StringCstr`, whose view is conservatively read-only because that one spelling covers BOTH
    // `.rodata` literals and heap blocks (docs/string-vec-model.md), and a read-only window has no
    // pointer to free through.
    head: StringView = a
        .sb()
        .s("  ")
        .s("TIME")
        .rep(" ", w.ts + 2 - "TIME".len())
        .s("LEVEL")
        .rep(" ", w.level + 2 - "LEVEL".len())
        .s("WHERE")
        .rep(" ", w.comp + 2 - "WHERE".len())
        .s("MESSAGE")
        .done()
        .expect("strings_demo: out of memory")
    println(head)
    // FREE: the built header block.
    a.release(head.own_ptr())
    // ── 4a. a buffer passed INTO a callee: we allocate it, rule_into only fills it. ──
    // ALLOC: repeat hands back a NUL-terminated block of `total` spaces. `own_window()` is the
    // WRITABLE window over it — `view()` would hand back a read-only `Slice<u8>`, because a view
    // borrows and cannot know it is looking at a block the caller owns.
    total = w.ts + w.level + w.comp + w.msg + 6
    canvas = a.repeat(" ", total)
    bar: [u8] = canvas.own_ptr().own_window(total)
    bar.rule_into('-')
    formatln("  {}", [arg_str(canvas)])
    // FREE: still ours. rule_into never took ownership, so nothing else can free it.
    a.release(canvas.own_ptr())
    a.print_rows(rows, n, w)
    a.free_rows(rows, n)
    a.free_lines(lines)
    // FREE: the two backbones, last — each slice must still be readable while the blocks it
    // points AT are being freed above. Nothing may read `rows` or `lines` after these.
    a.release_slice(rows)
    a.release_slice(lines)
    0
}
