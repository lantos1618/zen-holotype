    )])
    // #392: a value-consumed match arm that yields no value — caret on the offending arm.
    // the original intrinsic-collision repro (fn at byte 0 → position-less, message still exact).
    // R2: a NESTED field write through a read-only `Ptr<T>` is positioned on the write target.
    // R3: an index-set into a slice field of a read-only `Ptr<T>`.
    // R6: exhaustiveness on a LOCAL-binding subject is now positioned on the subject (was position-less).
    // R7: a value-less body tail is positioned on the last statement, with the fall-through message.
    // a ONE-ARMED bool `.match` in VALUE position is non-exhaustive (the missing branch has no value):
    // a POSITIONED exhaustiveness diagnostic, identical in shape to the enum case above — NOT the old
    // position-less undefined-name sentinel. (In statement position the same form is legal; see oracle_value.)
    // ── (h) `zenc emit` C-substring assertions (enum switch / bool ternary / no self-capture) ─────
    em := run_emits("build emit", [EmitCase(
        path: "tests/fixtures/zen/enum_emit.zen",
        present: ["switch (_subj.tag)", "case R_Ok:"],
        absent: [],
    ), EmitCase(
        path: "tests/fixtures/zen/bool_emit.zen",
        present: ["return (b ? 1LL : 0LL);"],
        absent: ["switch"],
    ), EmitCase(
        path: "tests/fixtures/zen/gen_template_local_no_capture.zen",
        present: [],
        absent: ["int32_t value = value"],
    )])
    // ── (i) `zenc doc` public-surface + legacy-name assertions across the std modules + genc.zen ──
    dc := run_docs("build doc", [DocCase(
        target: "std.text.fmt",
        present: ["# std.text.fmt", "Display*: {", "write_int_in*<A> = (a: MutPtr<A>, n: i64) Result<i64, IoError>", "write_float_in*<A> = (a: MutPtr<A>, x: f64) Result<i64, IoError>", "print*<T> = (x: T) i64 { x.fmt_print() }", "println*<T> = (x: T) i64 { x.fmt_println() }", "Display is the current type-directed print surface"],
        absent: ["print_owned", "print_int", "println_int", "try_write_int_in", "try_write_float_in"],
    ), DocCase(
        target: "std.text.string",
        present: ["init*<A> = (a: MutPtr<A>, cap: i64) Result<String, IoError>", "new_in*<A> = (a: MutPtr<A>) Result<String, IoError>"],
        absent: ["try_init", "try_new", "new* = "],
    ), DocCase(
        target: "std.mem.own",
        present: ["new_in*<A, T> = (a: MutPtr<A>, x: T) Result<Own<T>, IoError>"],
        absent: ["new*<T>", "try_new", "release = (o: Own<T>)", "own_new", "own_clone", "own_ptr", "own_release"],
    ), DocCase(
        target: "std.mem.rc",
        present: ["new_in*<A, T> = (a: MutPtr<A>, x: T) Result<Rc<T>, IoError>"],
        absent: ["new*<T>", "try_new", "drop = (r: Rc<T>)", "rc_new", "rc_get", "rc_clone", "rc_drop", "rc_count"],
    ), DocCase(
        target: "std.mem.arc",
        present: ["new_in*<A, T> = (a: MutPtr<A>, x: T) Result<Arc<T>, IoError>"],
        absent: ["new*<T>", "try_new", "drop = (r: Arc<T>)", "arc_new", "arc_get", "arc_clone", "arc_drop", "arc_count"],
    ), DocCase(
