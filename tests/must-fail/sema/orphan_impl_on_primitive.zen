// A PRIMITIVE'S IMPLS HANG OFF ITS PRELUDE DECLARATION. `u8` is declared
// in `std.core.num`, and every reader of the impl table narrows the
// whole-program list to the module that declares the target — so an
// impl written here is not a weaker impl, it is dead text.
//
// THE SILENCE IS WHAT THIS TEST GUARDS. Before `SemaFault.OrphanImpl`
// this file compiled clean, and the only symptom was `<T: Eq>` refusing
// a `u8` somewhere else with nothing on screen saying why — a build that
// looks like it worked. Delete the check and this file goes green, which
// is the failure, not the fix.
//
// position: the impl declaration.

u8.impl(Eq, {
    eq ::= (self: @Self, other: @Self) bool { self == other }
})

main = (env: Env) Res<i32, AllocError> {
    println("{}", ' '.is_in([' ', '\t']));
    Ok(0);
}
