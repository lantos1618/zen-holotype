// @self-hosted-only — imports the self-hosted-only std.concurrent.coroutine. Its mechanics are validated by an
// equivalent self-contained test (test_differential).
//
// std.concurrent.actor — COOPERATIVE typed actors (inline drain on the caller thread).
//
// This is the request/reply / demo path: `send` enqueues into a Ring mailbox; `run` / `request` /
// `ask` drain that mailbox SYNCHRONOUSLY on the calling thread (with optional coroutine
// `runtime_checkpoint` between messages). It is NOT scheduled on `std.concurrent.pool`.
//
// For PARALLEL typed actors across N OS cores, use `std.concurrent.pool_actor` (the KEEP path).
// That module adapts typed `receive` onto the pool via a concrete per-(M, ActorT) trampoline.
// Merging these two surfaces (auto-trampoline / typed spawn→pool) is tracked; until then treat
// them as two APIs with different scheduling semantics.
//
// This module OWNS the canonical `Context<M>` / `Receiver<M>` types; pool_actor imports them, so both
// actor surfaces share ONE message-wrapper/trait definition (no same-name shadow in the flat namespace).
// Because pool_actor's closure also flattens in std.concurrent.pool + std.concurrent.thread, this
// module's names must stay DISTINCT from theirs: the cooperative mailbox ref is `CellRef<M>` (pool.zen
// owns `ActorRef` — the sendable cross-thread reply address) and the cooperative constructor is
// `spawn_handle` (std.concurrent.thread owns `spawn`).
//
// User code defines a message enum and a receiver, then tells typed messages through an ActorCell<M>
// or an ActorHandle<M, ActorT>. ActorHandle owns allocator-backed actor state for demo-facing code.
{ AllocatorBackend } = std.mem.alloc
{ Result, IoError } = std.core.result
{ runtime_checkpoint } = std.concurrent.runtime
{ Ring, ring } = std.concurrent.ring
ACTOR_STATE_SIZE = 32    // RawPtr<u8> buf + head/tail/cap i64 slots (one Ring<M>).
// Back-pressure sentinel: a `request`/`ask` whose message could not be enqueued (mailbox FULL) surfaces
// `.Err(.Errno(EAGAIN))` rather than reading an uninitialized reply. IoError has no dedicated "would
// block" variant, so we reuse the POSIX code for "resource temporarily unavailable / would block" —
// the exact meaning here: the mailbox is momentarily full; retry after draining. Read it back by
// matching `.Errno(EAGAIN)` on the returned error.
EAGAIN = 11
Context*<M>: {
    msg: M,
}
Receiver*<M>: {
    receive: (self: MutPtr<Self>, context: Context<M>) void,
}
// Internal system state owns one allocator-backed Ring<M> block plus one allocator-backed message
// buffer. CellRef shares the state; it never allocates or frees. The mailbox is a Ring<M> (the single
// shared ring abstraction, std.concurrent.ring) held behind the RawPtr state slot.
ActorSystem<M>: {
    state: RawPtr<u8>,
    state_slot = (sys: ActorSystem<M>) MutSlice<Ring<M>> { sys.state.slice(1) }
    ref        = (sys: ActorSystem<M>) CellRef<M> { CellRef<M>(state: sys.state) }
    messages = (sys: ActorSystem<M>) MutSlice<M> {
        state = sys.state_slot()
        state[0].slots()
    }
    has_messages = (sys: ActorSystem<M>) bool {
        state = sys.state_slot()
        state[0].nonempty()
    }
    next_message = (sys: ActorSystem<M>) M {
        state ::= sys.state_slot()
        cur = state[0]
        message = cur.peek()
        state[0] = cur.advance()
        message
    }
    run<ActorT: Receiver> = (sys: ActorSystem<M>, actor: MutPtr<ActorT>) void {
        sys.messages().loop((h, i, slot) {
            sys.has_messages().match ({
                true  => {
                    message: M = sys.next_message()
                    actor.receive(Context<M>(msg: message))
                    runtime_checkpoint()
                },
                false => {
                    h.break
                },
            })
        })
    }
    free = (sys: ActorSystem<M>, alloc: AllocatorBackend) void {
        state = sys.state_slot()
        state[0].free(alloc)
        alloc.release(sys.state)
    }
}
// The cooperative mailbox reference (`cell.ref()` / `engine.ref()`): same-thread enqueue only.
// Named CellRef, NOT ActorRef — std.concurrent.pool owns `ActorRef` (the sendable pool reply address).
CellRef*<M>: {
    state: RawPtr<u8>,
    ref_state = (ref: CellRef<M>) MutSlice<Ring<M>> { ref.state.slice(1) }
    send = (ref: CellRef<M>, message: M) bool {
        state ::= ref.ref_state()
        cur = state[0]
        cur.is_full().match ({
            true  => false,
            false => {
                state[0] = cur.push(message)
                true
            },
        })
    }
}
ReplyRef*<T>: {
    value: RawPtr<u8>,
    ready: RawPtr<u8>,
    values = (reply: ReplyRef<T>) MutSlice<T> { reply.value.slice(1) }
    send = (reply: ReplyRef<T>, value: T) bool {
        vals :: MutSlice<T> = reply.value.slice(1)
        vals[0] = value
        reply.ready.store_i64(1)
        true
    }
    ready = (reply: ReplyRef<T>) bool {
        // Cooperative only: meaningful after a same-thread `run`/`request` drain. Not pool-safe.
        reply.ready.load_i64() == 1
    }
    claim = (reply: ReplyRef<T>, alloc: AllocatorBackend) T {
        // Reads the reply value after the caller has already drained (request/ask call `run` first).
        // Does NOT spin on `ready` — under the cooperative model the drain is synchronous, so the
        // value is already written. A pool-aware future would park; this path never will.
        vals = reply.values()
        value = vals[0]
        alloc.release(reply.value)
        alloc.release(reply.ready)
        value
    }
    discard = (reply: ReplyRef<T>, alloc: AllocatorBackend) void {
        // Free the reply cell WITHOUT reading it — for the back-pressure path where the request was
        // never enqueued (mailbox full), so no value was ever written. Mirrors `claim`'s two releases
        // minus the (uninitialized) read, so no allocation leaks when a request bounces off a full box.
        alloc.release(reply.value)
        alloc.release(reply.ready)
    }
}
context<M> = (msg: M) Context<M> { Context<M>(msg: msg) }
reply<T> = (alloc: AllocatorBackend) Result<ReplyRef<T>, IoError> {
    alloc.try_acquire(sizeof(T)).match ({
        .Ok(value) => {
            alloc.try_acquire(8).match ({
                .Ok(ready) => {
                    ready.store_i64(0)
                    ok: Result<ReplyRef<T>, IoError> = .Ok(ReplyRef<T>(
                        value: value,
                        ready: ready,
                    ))
                    ok
                },
                .Err(e)    => {
                    alloc.release(value)
                    err: Result<ReplyRef<T>, IoError> = .Err(e)
                    err
                },
            })
        },
        .Err(e)    => {
            err: Result<ReplyRef<T>, IoError> = .Err(e)
            err
        },
    })
}
make_system<M> = (alloc: AllocatorBackend, cap: i64) Result<ActorSystem<M>, IoError> {
    alloc.try_acquire(ACTOR_STATE_SIZE).match ({
        .Ok(state) => {
            mailbox: Result<Ring<M>, IoError> = alloc.ring(cap)
            mailbox.match ({
                .Ok(r)  => {
                    slot ::= state.slice(1)
                    slot[0] = r
                    ok: Result<ActorSystem<M>, IoError> = .Ok(ActorSystem<M>(state: state))
                    ok
                },
                .Err(e) => {
                    alloc.release(state)
                    err: Result<ActorSystem<M>, IoError> = .Err(e)
                    err
                },
            })
        },
        .Err(e)    => {
            err: Result<ActorSystem<M>, IoError> = .Err(e)
            err
        },
    })
}
ActorEngine*<M>: {
    sys: ActorSystem<M>,
    ref           = (engine: ActorEngine<M>) CellRef<M> { engine.sys.ref() }
    drain<ActorT> = (engine: ActorEngine<M>, actor: MutPtr<ActorT>) void { engine.sys.run(actor) }
    free = (engine: ActorEngine<M>, alloc: AllocatorBackend) void { engine.sys.free(alloc) }
}
engine<M> = (alloc: AllocatorBackend, cap: i64) Result<ActorEngine<M>, IoError> {
    sys: Result<ActorSystem<M>, IoError> = alloc.make_system(cap)
    sys.match ({
        .Ok(s)  => {
            ok: Result<ActorEngine<M>, IoError> = .Ok(ActorEngine<M>(sys: s))
            ok
        },
        .Err(e) => {
            err: Result<ActorEngine<M>, IoError> = .Err(e)
            err
        },
    })
}
ActorCell*<M>: {
    inner: ActorEngine<M>,
    ref  = (cell: ActorCell<M>) CellRef<M> { cell.inner.ref() }
    send = (cell: ActorCell<M>, message: M) bool { cell.ref().send(message) }
    reply<T> = (cell: ActorCell<M>, alloc: AllocatorBackend) Result<ReplyRef<T>, IoError> {
        alloc.reply()
    }
    drain<ActorT> = (cell: ActorCell<M>, actor: MutPtr<ActorT>) void { cell.inner.drain(actor) }
    claim_reply<ActorT, T> = (
        cell: ActorCell<M>,
        alloc: AllocatorBackend,
        actor: MutPtr<ActorT>,
        reply_to: ReplyRef<T>,
    ) T {
        cell.drain(actor)
        reply_to.claim(alloc)
    }
    claim_checked<ActorT, T> = (
        cell: ActorCell<M>,
        alloc: AllocatorBackend,
        actor: MutPtr<ActorT>,
        reply_to: ReplyRef<T>,
    ) Result<T, IoError> {
        // Drain, then read the reply ONLY if it was actually written. Under the cooperative model the drain
        // is synchronous, so a message that was enqueued and handled leaves `ready == 1`; a message that
        // never got enqueued (mailbox full) leaves `ready == 0` — reading it would return uninitialized
        // garbage, so we free the cell and surface back-pressure instead. Shared by `request` and `ask`.
        cell.drain(actor)
        reply_to.ready().match ({
            true  => {
                got: Result<T, IoError> = .Ok(reply_to.claim(alloc))
                got
            },
            false => {
                reply_to.discard(alloc)
                miss: Result<T, IoError> = .Err(.Errno(EAGAIN))
                miss
            },
        })
    }
    ask<ActorT, T> = (
        cell: ActorCell<M>,
        alloc: AllocatorBackend,
        actor: MutPtr<ActorT>,
        issue: (reply: ReplyRef<T>) void,
    ) Result<T, IoError> {
        r: Result<ReplyRef<T>, IoError> = cell.reply(alloc)
        r.match ({
            .Ok(reply_to) => {
                issue(reply_to)
                cell.claim_checked(alloc, actor, reply_to)
            },
            .Err(e)       => {
                failed: Result<T, IoError> = .Err(e)
                failed
            },
        })
    }
    request<ActorT, T> = (
        cell: ActorCell<M>,
        alloc: AllocatorBackend,
        actor: MutPtr<ActorT>,
        make: (reply: ReplyRef<T>) M,
    ) Result<T, IoError> {
        r: Result<ReplyRef<T>, IoError> = cell.reply(alloc)
        r.match ({
            .Ok(reply_to) => {
                cell.send(make(reply_to)).match ({
                    true  => cell.claim_checked(alloc, actor, reply_to),
                    false => {
                        // mailbox FULL: nothing enqueued, the actor never runs, so the reply cell would
                        // stay uninitialized. Free it and report back-pressure instead of Ok(garbage).
                        reply_to.discard(alloc)
                        full: Result<T, IoError> = .Err(.Errno(EAGAIN))
                        full
                    },
                })
            },
            .Err(e)       => {
                failed: Result<T, IoError> = .Err(e)
                failed
            },
        })
    }
    free = (cell: ActorCell<M>, alloc: AllocatorBackend) void { cell.inner.free(alloc) }
}
ActorHandle*<M, ActorT>: {
    inner_cell: ActorCell<M>,
    state: RawPtr<u8>,
    actor = (handle: ActorHandle<M, ActorT>) MutPtr<ActorT> {
        slot: MutSlice<ActorT> = handle.state.slice(1)
        slot[0].addr()
    }
    send = (handle: ActorHandle<M, ActorT>, message: M) bool {
        state :: MutSlice<Ring<M>> = handle.inner_cell.inner.sys.state.slice(1)
        cur = state[0]
        cur.is_full().match ({
            true  => false,
            false => {
                state[0] = cur.push(message)
                true
            },
        })
    }
    run = (handle: ActorHandle<M, ActorT>) void {
        state :: MutSlice<Ring<M>> = handle.inner_cell.inner.sys.state.slice(1)
        actor_slot: MutSlice<ActorT> = handle.state.slice(1)
        actor = actor_slot[0].addr()
        messages: MutSlice<M> = state[0].slots()
        messages.loop((h, i, slot) {
            cur = state[0]
            cur.nonempty().match ({
                true  => {
                    message: M = cur.peek()
                    state[0] = cur.advance()
                    actor.receive(Context<M>(msg: message))
                    runtime_checkpoint()
                },
                false => {
                    h.break
                },
            })
        })
    }
    claim_checked<T> = (
        handle: ActorHandle<M, ActorT>,
        alloc: AllocatorBackend,
        reply_to: ReplyRef<T>,
    ) Result<T, IoError> {
        // Drain the mailbox inline, then read the reply ONLY if it was written (see ActorCell.claim_checked).
        // A request that never enqueued (mailbox full) leaves `ready == 0`; we free the cell and report
        // back-pressure rather than returning Ok over an uninitialized reply.
        handle.run()
        reply_to.ready().match ({
            true  => {
                got: Result<T, IoError> = .Ok(reply_to.claim(alloc))
                got
            },
            false => {
                reply_to.discard(alloc)
                miss: Result<T, IoError> = .Err(.Errno(EAGAIN))
                miss
            },
        })
    }
    request<T> = (
        handle: ActorHandle<M, ActorT>,
        alloc: AllocatorBackend,
        make: (reply: ReplyRef<T>) M,
    ) Result<T, IoError> {
        // Cooperative RPC: enqueue + inline `run` + read reply. Blocks the caller; not pool-parallel.
        r: Result<ReplyRef<T>, IoError> = alloc.reply()
        r.match ({
            .Ok(reply_to) => {
                handle.send(make(reply_to)).match ({
                    true  => handle.claim_checked(alloc, reply_to),
                    false => {
                        // mailbox FULL: nothing enqueued, so the reply cell stays uninitialized.
                        reply_to.discard(alloc)
                        full: Result<T, IoError> = .Err(.Errno(EAGAIN))
                        full
                    },
                })
            },
            .Err(e)       => {
                failed: Result<T, IoError> = .Err(e)
                failed
            },
        })
    }
    ask<T> = (
        handle: ActorHandle<M, ActorT>,
        alloc: AllocatorBackend,
        issue: (reply: ReplyRef<T>) void,
    ) Result<T, IoError> {
        r: Result<ReplyRef<T>, IoError> = alloc.reply()
        r.match ({
            .Ok(reply_to) => {
                issue(reply_to)
                handle.claim_checked(alloc, reply_to)
            },
            .Err(e)       => {
                failed: Result<T, IoError> = .Err(e)
                failed
            },
        })
    }
    free = (handle: ActorHandle<M, ActorT>, alloc: AllocatorBackend) void {
        state: MutSlice<Ring<M>> = handle.inner_cell.inner.sys.state.slice(1)
        state[0].free(alloc)
        alloc.release(handle.inner_cell.inner.sys.state)
        alloc.release(handle.state)
    }
}
// Allocate actor state + mailbox and return an ActorHandle. Named spawn_handle, NOT spawn —
// std.concurrent.thread owns `spawn`, and both flatten into any pool_actor program's closure.
spawn_handle*<M, ActorT> = (
    alloc: AllocatorBackend,
    cap: i64,
    actor: ActorT,
) Result<ActorHandle<M, ActorT>, IoError> {
    alloc.try_acquire(sizeof(ActorT)).match ({
        .Ok(state) => {
            slot :: MutSlice<ActorT> = state.slice(1)
            slot[0] = actor
            cell: Result<ActorCell<M>, IoError> = alloc.cell(cap)
            cell.match ({
                .Ok(c)  => {
                    ok: Result<ActorHandle<M, ActorT>, IoError> = .Ok(ActorHandle<M, ActorT>(
                        inner_cell: c,
                        state: state,
                    ))
                    ok
                },
                .Err(e) => {
                    alloc.release(state)
                    err: Result<ActorHandle<M, ActorT>, IoError> = .Err(e)
                    err
                },
            })
        },
        .Err(e)    => {
            err: Result<ActorHandle<M, ActorT>, IoError> = .Err(e)
            err
        },
    })
}
cell*<M> = (alloc: AllocatorBackend, cap: i64) Result<ActorCell<M>, IoError> {
    engine: Result<ActorEngine<M>, IoError> = alloc.engine(cap)
    engine.match ({
        .Ok(e)  => {
            ok: Result<ActorCell<M>, IoError> = .Ok(ActorCell<M>(inner: e))
            ok
        },
        .Err(e) => {
            err: Result<ActorCell<M>, IoError> = .Err(e)
            err
        },
    })
}
