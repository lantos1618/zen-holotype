// .or_return() INSIDE MATCH ARMS (statement-position arms): the hoist is scoped to the arm, so an
// untaken arm never evaluates (or propagates) its receiver. Exit 109 = 6 + 1 + 100 + 2:
// f(1,1)=Ok(6); f(0,1)=Err (1); f(0,0)=Ok(100) — the or_return arm is NOT taken, so no Err fires
// even though g(0) would fail; h(0)=Err (2).
{ Result, IoError } = std.core.result
g = (ok: i32) Result<i32, IoError> { (ok == 1).then({ .Ok(5) }, { .Err(.NotFound) }) }
add1 = (n: i32) i32 { n + 1 }
f = (ok: i32, sel: i32) Result<i32, IoError> {
    out := 0
    (sel == 1).match ({
        true  => {
            out = add1(g(ok).or_return())
        },
        false => {
            out = 100
        },
    })
    .Ok(out)
}
h = (ok: i32) Result<i32, IoError> {
    v := 0
    (ok >= 0).then({
        v = add1(g(ok).or_return())
    })
    .Ok(v)
}
main = () i32 {
    a := f(1, 1).match ({
        .Ok(v)  => v,
        .Err(e) => 0,
    })    // 6
    b := f(0, 1).match ({
        .Ok(v)  => 0,
        .Err(e) => 1,
    })    // 1
    c := f(0, 0).match ({
        .Ok(v)  => v,
        .Err(e) => 0,
    })    // 100
    d := h(0).match ({
        .Ok(v)  => 0,
        .Err(e) => 2,
    })    // 2
    a + b + c + d
}
