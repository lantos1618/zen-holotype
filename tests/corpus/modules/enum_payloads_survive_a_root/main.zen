// an enum keeps its variants across a re-export: each arm is still its own
// value, so none of them reads as already covered
Pos, Node = shape.shape

show = (n: Node) str {
    n.match({
        Leaf(v) => "leaf",
        At(p)   => "at",
        Empty   => "empty",
    });
}

main = (env: Env) Res<i32, IoError> {
    println(show(Node.Leaf(7)));
    println(show(Node.At(Pos(line: 2))));
    println(show(Node.Empty));
    Ok(0);
}
