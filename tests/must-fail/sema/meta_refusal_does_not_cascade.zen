// ONE MISTAKE, ONE DIAGNOSTIC — the property, with `.count` to make it
// fail. `@meta` was refused by the BACKEND until 2026-08-17 and the node
// typed as `Ty.Unknown` on the way there, so a program that read a
// member of the poison or printed it collected a second sentence about a
// form whose first sentence was already "this does not compile".
// `meta_value_form_refused` is where that shows: two diagnostics before,
// one after. It cannot carry this `.count` — the bootstrapper still
// cascades three sentences there, and a must-fail expectation is read by
// both toolchains.
//
// SO THE COUNT LIVES IN THE ONE SHAPE BOTH AGREE ABOUT: the meta value
// is handed to a parameter with a WRITTEN type and nothing else is asked
// of it, and poison is assignable to anything, so the refusal is the only
// sentence either compiler has. Measured against the pre-refusal binary,
// this shape gave one diagnostic there too — the count is a guard on what
// the next milestone may not regress, not the evidence that the cascade
// closed.
//
// position: the `@meta` token.

Point = { x: i64, y: i64 }

count_of = (n: i64) i64 { n }

main = (env: Env) Res<i32, AllocError> {
    p = Point(x: 1, y: 2);
    println("{}", count_of(@meta(p)));
    Ok(0);
}
