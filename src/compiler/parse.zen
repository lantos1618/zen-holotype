// Public parser entry and declaration parsers.
// Expressions, statements, and types live in parse_expr/parse_stmt/parse_type.
{ Expr, Func, Stmt, Param, Ty, Decl } = compiler.ast.ast_types
{ param, gsdef_at, genumdef_at, dfunc, dstruct, denum, dforeign, dimport_at, dgenstruct, dgenenum,
  dglobal, dglobal_at, dglobal_tl_at, dglobal_alias_at, lit, tvoid } = compiler.genc
{ Token, Scan, scan, lerr_reset, lerr_get, lerr_off_get } = compiler.lex
{ slice_any } = compiler.astops
{ at } = std.text.ascii
{ Malloc } = std.mem.alloc
{ parse_or } = compiler.parse_expr
{ enode, is_op, is_op1, is_walrus, lexeme } = compiler.parse_atom
{ is_dot, is_ident_tok } = compiler.parse_postfix
{ is_lparen, tyargs_end } = compiler.parse_primary
{ build_body } = compiler.parse_stmt
{ parse_ty, fill_params, param_buf, take_params, skip_block, skip_to_brace, skip_to_lparen,
  lbrace_off, bopen_enter, bopen_exit, is_lbrace, is_rbrace, is_langle, tok_eq, perr_set,
  perr_set_at, perr_set_bad_at, perr_set_kind_at, perr_set_misgen_at, perr_reset, perr_get,
  perr_off_get, perr_kind_get, pdepth_reset, delim_reset, PE_BADBIND, PE_MISGEN, PE_UNCLOSED,
  PE_ARROW, PE_EXPR, PE_DECL, PE_INIT, PE_EOF, vbreak_reset, vbreak_get, anon_reset, anon_decls_get } = compiler.parse_type
{ parse_tparams, skip_name_star, parse_struct_at, parse_enum_at, has_data_field } = compiler.parse_type_decl
{ fill_impl, fill_impl_methods, fill_defaults, fill_inherent_struct } = compiler.parse_impl
{ implicit_tparams } = compiler.parse_implicit
// `foreign` means a bodyless function declaration, emitted as DForeign.
DeclEnd*: {
    func: Func,
    next: i32,
    foreign: bool,
}
no_body = (a: MutPtr<Malloc>) [Stmt] { slice(null_ptr(), 0) }
parse_decl_at* = (a: MutPtr<Malloc>, src: string_view, pos: i32) DeclEnd {
    nt := src.scan(pos)
    name := a.lexeme(src, nt.tok)
    // An EXPLICIT tparam list `<A, B: Trait>` sits right after the name (before the `=` value
    // marker): `bump<AllocT> = (…)`. It carries trait BOUNDS that can't be inferred from usage;
    // tparams without a bound are also collected implicitly from tyvar-shaped param/return types.
    tp := a.parse_tparams(src, src.skip_name_star(pos))
    // PARSER TOTALITY: after `name [*] [<T…>]` the ONLY legal continuation of a function decl is
    // `= (`. skip_to_lparen below would otherwise SKIM SILENTLY over any junk between the name and
    // the first `(` — so garbage like `this is not zen }{ (((` mis-parsed as a function decl and
    // `zenc fmt` would destructively rewrite the file. Flag the first unexpected token as a parse
    // error (the module is rejected via the syntax sentinel); parsing still advances past the decl.
    eqm := src.scan(tp.next)
    src.is_op1(eqm.tok, '=').match ({
        true  => (src.is_lparen(src.scan(eqm.next).tok) == false).then({
            perr_set_at(src.scan(eqm.next).tok.start)
        }),
        false => perr_set_at(eqm.tok.start),
    })
    buf := a.param_buf()
    pe := a.fill_params(src, src.skip_to_lparen(nt.next), buf, 0)
    rt := a.parse_ty(src, pe.next)
    params := buf.take_params(pe.count)
    src.is_lbrace(src.scan(rt.next).tok).match ({
        true  => a.parse_fn_body(src, name, params, tp.names, rt.ty, src.skip_to_brace(rt.next), nt.tok.start, src.lbrace_off(rt.next)),
        false => DeclEnd(
            func: Func(
                name: name,
                params: params,
                ret: rt.ty,
                tparams: tp.names,
                body: a.no_body(),
                pos: nt.tok.start,
            ),
            next: rt.next,
            foreign: true,
        ),
    })
}
parse_fn_body = (
    a: MutPtr<Malloc>,
    src: string_view,
    name: string_view,
    params: [Param],
    tparams: [Param],
    ret: Ty,
    bstart: i32,
    dpos: i32,
    bopen: i32,
) DeclEnd {
    // anchor the body's `{` so an end-of-input inside it carets the OPENING brace (see bopen_enter)
    prev := bopen_enter(bopen)
    func := Func(
        name: name,
        params: params,
        ret: ret,
        tparams: tparams,
        body: a.build_body(src, bstart),
        pos: dpos,
    )
    end := src.skip_block(bstart)
    bopen_exit(prev)
    DeclEnd(
        func: func,
        next: end,
        foreign: false,
    )
}
is_star* = (src: string_view, t: Token) bool { src.is_op(t, '*') }
is_colon* = (src: string_view, t: Token) bool { src.is_op(t, ':') }
decl_marker* = (src: string_view, pos: i32) Scan {
    nt := src.scan(pos)
    a1 := src.scan(nt.next)
    a2 := src.is_star(a1.tok).then({ src.scan(a1.next) }, { a1 })
    a3 := src.is_langle(a2.tok).then({ src.scan_tyargs(a2) }, { a2 })
    // Also step over a TRAILING `*` after the type-arg list (`Name<T>*:`, the misordered generic-decl
    // head). This lets decl_is_struct/decl_is_enum find the real `:` marker so the decl parses and
    // advances correctly; decl_is_misordered_generic separately flags it as the wrong `*` placement.
    src.is_star(a3.tok).then({ src.scan(a3.next) }, { a3 })
}
// The MISORDERED generic-decl head `Name<T>*:` (type params before the `*`, e.g. a user copying the old
// SPEC) — the canonical form is `Name*<T>:` (star glued to the name, e.g. `Result*<T, E>:`). Detected as:
// name, `<…>` type-arg list, then `*`, then `:`. Reported at the `<` (misgen_langle_off).
decl_is_misordered_generic = (src: string_view, pos: i32) bool {
    a1 := src.scan(src.scan(pos).next)
    src.is_langle(a1.tok).match ({
        true  => {
            te := src.tyargs_end(a1.next, 1)
            (te < 0).match ({
                true  => false,
                false => {
                    star := src.scan(te)
                    src.is_star(star.tok).then({ src.is_colon(src.scan(star.next).tok) }, { false })
                },
            })
        },
        false => false,
    })
}
// the `<` offset of a misordered generic-decl head (the caret for its diagnostic).
misgen_langle_off = (src: string_view, pos: i32) i32 { src.scan(src.scan(pos).next).tok.start }
// Malformed `<...>` falls back to the `<` token so scan never receives a negative pos.
scan_tyargs = (src: string_view, a2: Scan) Scan {
    te := src.tyargs_end(a2.next, 1)
    (te < 0).then({ a2 }, { src.scan(te) })
}
decl_is_struct = (src: string_view, pos: i32) bool {
    m := src.decl_marker(pos)
    src.is_colon(m.tok).then({ src.is_lbrace(src.scan(m.next).tok) }, { false })
}
decl_is_enum = (src: string_view, pos: i32) bool {
    m := src.decl_marker(pos)
    src.is_colon(m.tok).match ({
        true  => src.is_lbrace(src.scan(m.next).tok).then({ false }, { true }),
        false => false,
    })
}
decl_is_global = (src: string_view, pos: i32) bool { src.is_walrus(src.decl_marker(pos).tok) }
// a TYPED top-level global `name : Type := expr` — matches the in-function typed-let form. The marker is
// a single ':' (not ':=', a plain global; not ': {', a struct); after the annotation the operator must be
// ':=' (walrus). It must be ':=', NOT '=': an enum's default-valued first variant reads as `Name = value`
// (`Colour: Red = RGB(...) | …`), so a single '=' here is an enum, not a global. The annotation drives
// nothing the inferred type wouldn't (resolve_global re-infers from the init), so it is parsed + discarded.
decl_is_typed_global = (a: MutPtr<Malloc>, src: string_view, pos: i32) bool {
    m := src.decl_marker(pos)
    (src.is_colon(m.tok) && m.tok.len == 1).match ({
        true  => src.is_lbrace(src.scan(m.next).tok).match ({
            true  => false,
            false => {
                te := a.parse_ty(src, m.next)
                src.is_walrus(src.scan(te.next).tok)
            },
        }),
        false => false,
    })
}
// position just past a typed global's init expression (the type annotation is skipped, init parsed).
typed_global_end = (a: MutPtr<Malloc>, src: string_view, pos: i32) i32 {
    m := src.decl_marker(pos)
    te := a.parse_ty(src, m.next)
    a.parse_or(src, src.scan(te.next).next).next
}
// a MODULE-ALIAS binding `name = std.mem.raw` / `name = sibling` — a `name = <module-path>` whose RHS is a
// bare or dotted module PATH (idents joined by `.`) that TERMINATES at the declaration boundary. The
// faithful parser would otherwise mis-read it as a function decl and swallow the following decls; routed to
// fill_global so the RHS parses as an ordinary (Member-chain) expr.
// NARROW: only a path that ends at a decl boundary is an alias. If a value-expression token (`(`, `[`, `<`,
// an operator, …) follows the leading ident or the dotted path, the RHS is a VALUE, not a module path —
// e.g. `K = Ctor(...)`, `K = compute()`, `K = a + b`. Those fall through to decl_is_bad_binding, which
// emits `error[bad-binding]` ("use `:=` for a value global") instead of planting a void `dglobal_alias`
// that ICEs codegen (void ORIGIN) or silently tolerates `=` as a second spelling of `:=`.
decl_is_module_alias = (src: string_view, pos: i32) bool {
    m := src.decl_marker(pos)
    src.is_op1(m.tok, '=').match ({
        true  => is_ident_tok(src.scan(m.next).tok).match ({
            true  => {
                end := src.skip_path(m.next)    // walk the bare/dotted path; land past its last ident
                src.decl_path_at_boundary(src.scan(end).tok)
            },
            false => false,
        }),
        false => false,
    })
}    // followed by a decl boundary, not a value-expr token
// The token after a module-alias path must be a declaration boundary: the next top-level decl name
// (`.Ident`), an import (`{`), or end of file (`.Eof`). Anything else — `(` (call), `[` (index), `<`
// (generic), or any operator (`+`, `*`, …) — means the RHS is a value expression, not a module path.
decl_path_at_boundary = (src: string_view, t: Token) bool {
    t.kind.match ({
        .Ident => true,
        .Eof   => true,
        _      => src.is_lbrace(t),
    })
}
// a MALFORMED single-`=` top-level binding: marker `=` whose RHS is NEITHER an ident (a module alias,
// `raw = std.mem.raw`) NOR `(` (a function literal, `f = () i32 {…}`). Reached only after the alias
// path is peeled, so this is a value global written with `=` (`k = 5`) — which must use `:=`. Left to
// `fill_func` it silently mis-parses `= <expr>` and swallows the FOLLOWING declaration (and its `*`
// export marker); this predicate routes it to a clean `error[bad-binding]` instead.
decl_is_bad_binding = (src: string_view, pos: i32) bool {
    m := src.decl_marker(pos)
    src.is_op1(m.tok, '=').match ({
        true  => src.is_lparen(src.scan(m.next).tok).then({ false }, { true }),
        false => false,
    })
}
decl_buf = (a: MutPtr<Malloc>) [Decl] { slice(a.acquire(16384 * sizeof(Decl)), 16384) }
take_decls = (buf: [Decl], n: i32) [Decl] { slice(buf.ptr, n) }
// ── EXPORT markers (the `*` after a top-level decl name) ─────────────────────────────────────────
// `skip_name_star` discards the `*` from the AST, but it is load-bearing (cross-module export +
// flatten dedup). The formatter needs it, so parse_module records the starred top-level names in a
// module-level buffer (mirroring the anon-struct state) — NOT in the AST, so the compiler pipeline is
// untouched. The driver reads `exports_get()` after parse_module and hands it to the formatter.
// ── registry OVERFLOW flag ───────────────────────────────────────────────────────────────────────
// The fixed-capacity registries below (exports / alias prefixes / module sigs) must never DROP data
// silently: a full registry sets this STICKY flag and parse_module plants a `__capacity` sentinel, so
// an oversized program is REJECTED with `error[capacity]` instead of compiling with lost exports or
// alias facts. Sticky because the resolve-time registries (alias prefixes, module sigs) fill BEFORE
// parse_module runs — perr_* would be cleared by parse_module's perr_reset. Cleared per program by
// the resolve-entry resets below (never by exports_reset, which runs after resolve).
reg_overflow := 0
reg_overflow_note = () void { reg_overflow = 1 }
reg_overflow_get = () bool { reg_overflow == 1 }
reg_overflow_reset = () void { reg_overflow = 0 }
exports_buf := no_exports()
exports_n := 0
no_exports = () [Param] { slice(null_ptr(), 0) }
exports_reset = (a: MutPtr<Malloc>) void {
    exports_buf = slice(a.acquire(16384 * sizeof(Param)), 16384)
    exports_n = 0
}
exports_get* = () [Param] { slice(exports_buf.ptr, exports_n) }
note_export = (name: string_view) void {
    (exports_n < exports_buf.len).match ({
        true  => {
            exports_buf[exports_n] = param(name, tvoid())
            exports_n = exports_n + 1
        },
        false => reg_overflow_note(),
    })
}
// ── ALIAS-PREFIX registry (UFCS through module aliases) ──────────────────────────────────────────
// compiler.resolve flattens `m = sibling` by prefixing sibling's decls with `m__`. The checker's
// alias-UFCS fallback must distinguish a REAL alias prefix (`m`) from a plain user fn that merely has
// `__` in its name (`foo__grow`) — otherwise it invents phantom methods. resolve records each alias it
// stamps here (reset at every resolve_program_data entry); check reads `alias_prefixes_get()` and only
// treats a decl as alias-shaped when its prefix ∈ this set. Separate from exports_buf so parse_module's
// exports_reset never clobbers it (resolve runs BEFORE parse of the flat source).
alias_prefix_buf := no_exports()
alias_prefix_n := 0
alias_prefixes_reset* = (a: MutPtr<Malloc>) void {
    alias_prefix_buf = slice(a.acquire(4096 * sizeof(Param)), 4096)
    alias_prefix_n = 0
    reg_overflow_reset()
}
alias_prefixes_get* = () [Param] { slice(alias_prefix_buf.ptr, alias_prefix_n) }
alias_prefix_seen = (name: string_view) bool {
    alias_prefixes_get().slice_any((p) { p.name == name })
}
note_alias_prefix* = (name: string_view) void {
    // Overflow is keyed on FULLNESS only (buffer full → reject); a not-full-but-already-seen name is a
    // dedup skip, NOT an overflow. Structured as capacity-outer / seen-inner so the two are distinct.
    (alias_prefix_n < alias_prefix_buf.len).match ({
        true  => (name.alias_prefix_seen() == false).then({
            alias_prefix_buf[alias_prefix_n] = param(name, tvoid())
            alias_prefix_n = alias_prefix_n + 1
        }),
        false => reg_overflow_note(),
    })
}
// ── MODULE-SIG registry (per-alias export signatures, Stage B4) ──────────────────────────────────
// The resolver's ModuleSig knowledge (which names a module provides, with what flags, from which
// ModuleId), threaded to the checker WITHOUT a compiler.resolve import (resolve → check_validate
// → check is a layering cycle — the alias_prefixes_* precedent above). resolve stamps one SigEntry
// per (ns-alias bind, provided symbol) while resolve_program_data appends module bodies, in APPEND
// order — the same order the alias-prefixed decls occupy in the flat, so enumeration preserves the
// checker's deterministic decl-order tie-break. Reset per program next to alias_prefixes_reset.
// Flags pack the ProvidedSymbol facts (decoded by /bit%2, no bitwise ops — see resolve's ModuleSig).
SigEntry*: {
    alias: string_view,
    name: string_view,
    flags: i64,
    origin: i64,
    sig_pub      = (e: SigEntry) bool { e.flags / 1 % 2 == 1 }
    sig_type     = (e: SigEntry) bool { e.flags / 2 % 2 == 1 }
    sig_imported = (e: SigEntry) bool { e.flags / 4 % 2 == 1 }
    sig_foreign  = (e: SigEntry) bool { e.flags / 8 % 2 == 1 }
}
module_sig_flags* = (is_pub: bool, is_type: bool, imported: bool, foreign: bool) i64 {
    is_pub.then({ 1 }, { 0 }) + is_type.then({ 2 }, { 0 }) + imported.then({ 4 }, { 0 }) + foreign.match ({
        true  => 8,
        false => 0,
    })
}
module_sig_buf := no_sigs()
module_sig_n := 0
no_sigs = () [SigEntry] { slice(null_ptr(), 0) }
module_sigs_reset* = (a: MutPtr<Malloc>) void {
    module_sig_buf = slice(a.acquire(32768 * sizeof(SigEntry)), 32768)
    module_sig_n = 0
    reg_overflow_reset()
}
module_sigs_get* = () [SigEntry] { slice(module_sig_buf.ptr, module_sig_n) }
// has this (alias, origin ModuleId) pair been stamped already? A module bound twice under the SAME
// alias appends its body once — stamping twice would invent phantom duplicate candidates. A single
// alias name bound to two DIFFERENT modules keeps both stamps (both bodies reach the flat).
module_sig_alias_stamped* = (alias: string_view, origin: i64) bool {
    module_sigs_get().slice_any((e) { e.alias == alias && e.origin == origin })
}
note_module_sig* = (alias: string_view, name: string_view, flags: i64, origin: i64) void {
    (module_sig_n < module_sig_buf.len).match ({
        true  => {
            module_sig_buf[module_sig_n] = SigEntry(
                alias: alias,
                name: name,
                flags: flags,
                origin: origin,
            )
            module_sig_n = module_sig_n + 1
        },
        false => reg_overflow_note(),
    })
}
// record the decl name at `pos` if the token right after it is `*` — the export marker skip_name_star drops.
note_export_if_starred = (a: MutPtr<Malloc>, src: string_view, pos: i32) void {
    nt := src.scan(pos)
    src.is_star(src.scan(nt.next).tok).then({
        note_export(a.lexeme(src, nt.tok))
    })
}
// Imports carry no code, but their names become DImport records for the checker.
decl_is_import = (src: string_view, pos: i32) bool { src.is_lbrace(src.scan(pos).tok) }
skip_path = (src: string_view, pos: i32) i32 {
    id := src.scan(pos)
    dot := src.scan(id.next)
    src.is_dot(dot.tok).then({ src.skip_path(dot.next) }, { id.next })
}
import_buf = (a: MutPtr<Malloc>) [Param] { slice(a.acquire(256 * sizeof(Param)), 256) }
ImportEnd: {
    count: i32,
    next: i32,
}
record_name = (a: MutPtr<Malloc>, src: string_view, sc: Scan, buf: [Param], i: i32) ImportEnd {
    // Guard the import-name buffer.
    (i >= buf.len).then({
        perr_set_at(sc.tok.start)
        return ImportEnd(
            count: i,
            next: sc.next,
        )
    })
    buf[i] = param(a.lexeme(src, sc.tok), tvoid())
    a.fill_import_names(src, sc.next, buf, i + 1)
}
fill_import_names = (
    a: MutPtr<Malloc>,
    src: string_view,
    pos: i32,
    buf: [Param],
    i: i32,
) ImportEnd {
    sc := src.scan(pos)
    sc.tok.kind.match ({
        .Eof => {
            perr_set_at(pos)
            ImportEnd(
                count: i,
                next: sc.next,
            )
        },
        _    => src.is_rbrace(sc.tok).match ({
            true  => ImportEnd(
                count: i,
                next: sc.next,
            ),
            false => is_ident_tok(sc.tok).match ({
                true  => a.record_name(src, sc, buf, i),
                false => a.fill_import_names(src, sc.next, buf, i),
            }),
        }),
    })
}
// One parsed top-level decl's continuation: where parsing resumes and the next free decl slot.
// The decl parsers RETURN this instead of tail-calling fill_decls, so a module's decl count costs
// constant C stack (the loop below) rather than one frame per decl — see docs/STATUS.md's P1 row.
DCont*: {
    next: i32,
    i: i32,
}
fill_decls = (a: MutPtr<Malloc>, src: string_view, pos: i32, buf: [Decl], i: i32) i32 {
    p := pos
    n := i
    go := true
    @while (go) {
        // Leave one slot for the syntax-error sentinel. A full decl_buf is a CAPACITY overflow:
        // plant the __capacity sentinel directly (this return value IS buf.len, so parse_module's
        // prepend path would skip its own sentinel) with the caret on the first unparseable decl.
        (n >= buf.len - 1).match ({
            true  => {
                perr_set_at(p)
                reg_overflow_note()
                buf[n] = dglobal("__capacity", tvoid(), a.enode(lit(p)))
                n = n + 1
                go = false
            },
            false => {
                sc := src.scan(p)
                sc.tok.kind.match ({
                    .Eof => {
                        go = false
                    },
                    _    => src.decl_is_import(p).match ({
                        true  => {
                            c := a.fill_import(src, p, buf, n)
                            p = c.next
                            n = c.i
                        },
                        false => sc.tok.kind.match ({
                            // Bad top-level tokens become syntax sentinels, then parsing resumes.
                            .Ident => {
                                c := a.fill_decl(src, p, buf, n)
                                p = c.next
                                n = c.i
                            },
                            _      => {
                                // a failure exactly AT the last fired variant break's `.` is the split-statement
                                // shape: a NEGATIVE offset selects the rule-naming KVBREAK diagnostic (0 - off).
                                // Anything else here is a token that cannot BEGIN a declaration — say so.
                                vb := sc.tok.start == vbreak_get() && vbreak_get() != 0
                                vb.match ({
                                    true  => perr_set_at(sc.tok.start),
                                    false => perr_set_kind_at(sc.tok.start, PE_DECL()),
                                })
                                off := vb.then({ 0 - sc.tok.start }, { perr_off_get() })
                                buf[n] = dglobal("__syntax_error", tvoid(), a.enode(lit(off)))
                                p = sc.next
                                n = n + 1
                            },
                        }),
                    }),
                })
            },
        })
    }
    n
}
decl_is_impl* = (src: string_view, pos: i32) bool {
    nt := src.scan(pos)
    dot := src.scan(nt.next)
    src.is_dot(dot.tok).then({ src.tok_eq(src.scan(dot.next).tok, "impl") }, { false })
}
fill_decl = (a: MutPtr<Malloc>, src: string_view, pos: i32, buf: [Decl], i: i32) DCont {
    a.note_export_if_starred(src, pos)
    // A misordered generic head `Name<T>*:` is a clean error (caret at the `<`): flag it, then let the
    // normal struct/enum cascade parse-and-advance past it (the module is rejected via the sentinel).
    src.decl_is_misordered_generic(pos).then({
        perr_set_misgen_at(src.misgen_langle_off(pos))
    })
    src.decl_is_impl(pos).match ({
        true  => a.fill_impl(src, pos, buf, i),
        false => (src.decl_is_global(pos) || src.decl_is_module_alias(pos)).match ({
            true  => a.fill_global(src, pos, buf, i),
            false => a.decl_is_typed_global(src, pos).match ({
                true  => a.fill_typed_global(src, pos, buf, i),
                false => src.decl_is_struct(pos).match ({
                    true  => a.fill_struct(src, pos, buf, i),
                    false => src.decl_is_enum(pos).match ({
                        true  => a.fill_enum(src, pos, buf, i),
                        false => src.decl_is_bad_binding(pos).match ({
                            true  => a.fill_bad_binding(src, pos, buf, i),
                            false => a.fill_func(src, pos, buf, i),
                        }),
                    }),
                }),
            }),
        }),
    })
}
// A module global whose init is `thread_local(x)` becomes a thread-local global with init `x`.
// The wrapper is unwrapped here so the checker/codegen-init see the bare init; only the C storage
// class changes (`static _Thread_local`). Reusable for any per-OS-thread global (scheduler workers).
global_decl = (a: MutPtr<Malloc>, nm: string_view, init: Ptr<Expr>, alias: bool, dpos: i32) Decl {
    alias.then({
        return dglobal_alias_at(nm, tvoid(), init, dpos)
    })    // `name = mod` → keep the `=` form for round-trip
    load(init).match ({
        .Call(c) => (c.fn == "thread_local" && c.args.len == 1).match ({
            true  => dglobal_tl_at(nm, tvoid(), a.enode(c.args[0]), dpos),
            false => dglobal_at(nm, tvoid(), init, dpos),
        }),
        _        => dglobal_at(nm, tvoid(), init, dpos),
    })
}
fill_global = (a: MutPtr<Malloc>, src: string_view, pos: i32, buf: [Decl], i: i32) DCont {
    nt := src.scan(pos)
    nm := a.lexeme(src, nt.tok)
    mk := src.decl_marker(pos)
    alias := src.is_op1(mk.tok, '=')    // single `=` (a module alias) vs `:=` (a value global)
    pe := a.parse_or(src, mk.next)
    buf[i] = a.global_decl(nm, pe.expr, alias, nt.tok.start)
    DCont(
        next: pe.next,
        i: i + 1,
    )
}
// A malformed `name = <expr>` binding (see decl_is_bad_binding): flag a bad-binding parse error caret
// at the RHS, then parse the RHS as an expression PURELY to find where it ends — so we resume at the
// next declaration instead of letting fill_func swallow it. No decl is planted for this line (the
// module is rejected via the sentinel parse_module plants); the next decl fills this slot.
fill_bad_binding = (a: MutPtr<Malloc>, src: string_view, pos: i32, buf: [Decl], i: i32) DCont {
    mk := src.decl_marker(pos)
    perr_set_bad_at(src.scan(mk.next).tok.start)
    pe := a.parse_or(src, mk.next)
    DCont(
        next: pe.next,
        i: i,
    )
}
// `name : Type := expr` — a typed value global (always a value global, never a module alias — those
// carry no annotation — so alias = false). The type annotation is parsed then discarded (re-inferred).
fill_typed_global = (a: MutPtr<Malloc>, src: string_view, pos: i32, buf: [Decl], i: i32) DCont {
    nt := src.scan(pos)
    nm := a.lexeme(src, nt.tok)
    m := src.decl_marker(pos)    // the single ':'
    te := a.parse_ty(src, m.next)    // the (discarded) type annotation; te.next lands at ':='
    op := src.scan(te.next)
    pe := a.parse_or(src, op.next)
    buf[i] = a.global_decl(nm, pe.expr, false, nt.tok.start)
    DCont(
        next: pe.next,
        i: i + 1,
    )
}
fill_enum = (a: MutPtr<Malloc>, src: string_view, pos: i32, buf: [Decl], i: i32) DCont {
    ee := a.parse_enum_at(src, pos)
    buf[i] = (ee.ntp > 0).match ({
        true  => dgenenum(genumdef_at(ee.ed.name, ee.tparams, ee.ed.variants, ee.ed.pos)),
        false => denum(ee.ed),
    })
    DCont(
        next: ee.next,
        i: i + 1,
    )
}
fill_func = (a: MutPtr<Malloc>, src: string_view, pos: i32, buf: [Decl], i: i32) DCont {
    de := a.parse_decl_at(src, pos)
    buf[i] = de.foreign.then({ dforeign(de.func) }, { dfunc(de.func) })
    DCont(
        next: de.next,
        i: i + 1,
    )
}
fill_struct = (a: MutPtr<Malloc>, src: string_view, pos: i32, buf: [Decl], i: i32) DCont {
    se := a.parse_struct_at(src, pos)
    inherent := se.defaults.len > 0 && se.sd.fields.has_data_field()
    ni := inherent.match ({
        true  => a.fill_inherent_struct(se, buf, i),
        false => {
            buf[i] = (se.ntp > 0).match ({
                true  => dgenstruct(gsdef_at(se.sd.name, se.tparams, se.sd.fields, se.sd.pos)),
                false => dstruct(se.sd),
            })
            a.fill_defaults(se.sd.name, se.defaults, buf, i + 1, 0)
        },
    })
    DCont(
        next: se.next,
        i: ni,
    )
}
fill_import = (a: MutPtr<Malloc>, src: string_view, pos: i32, buf: [Decl], i: i32) DCont {
    nbuf := a.import_buf()
    ie := a.fill_import_names(src, src.scan(pos).next, nbuf, 0)
    eq := src.scan(ie.next)
    pth := a.read_import_path(src, eq.next)    // capture `std.text.fmt` text (kept for the formatter)
    buf[i] = dimport_at(nbuf.take_params(ie.count), pth.text, src.scan(pos).tok.start)
    DCont(
        next: pth.next,
        i: i + 1,
    )
}
// Read the dotted module path `a.b.c` after an import `=`, returning its verbatim text + resume pos.
ImportPath: {
    text: string_view,
    next: i32,
}
path_end_tok = (src: string_view, pos: i32) Token {
    id := src.scan(pos)
    dot := src.scan(id.next)
    src.is_dot(dot.tok).then({ src.path_end_tok(dot.next) }, { id.tok })
}
read_import_path = (a: MutPtr<Malloc>, src: string_view, pos: i32) ImportPath {
    first := src.scan(pos)
    last := src.path_end_tok(pos)
    n := last.start + last.len - first.tok.start
    p: RawPtr<u8> := a.acquire(n + 1)
    src.path_copy_into(first.tok.start, p, 0, n)
    p.offset(n).store(0)
    ImportPath(
        text: cstr(p),
        next: src.skip_path(pos),
    )
}
path_copy_into = (src: string_view, from: i32, dst: RawPtr<u8>, i: i32, n: i32) void {
    (i >= n == false).then({
        dst.offset(i).store(load(offset(src, from + i)))
        src.path_copy_into(from, dst, i + 1, n)
    })
}
parse_module* = (a: MutPtr<Malloc>, src: string_view) [Decl] {
    perr_reset()
    pdepth_reset()
    delim_reset()
    vbreak_reset()
    lerr_reset()
    a.anon_reset()
    a.exports_reset()
    buf := a.decl_buf()
    n := a.fill_decls(src, 0, buf, 0)
    n2 := a.append_anon_decls(buf, n)    // hoist synthesized anon-struct decls
    decls := (perr_get() || lerr_get() || reg_overflow_get()).match ({
        true  => a.prepend_syntax_error(buf, n2),
        false => buf.take_decls(n2),
    })
    a.implicit_tparams(decls)
}
// Append the distinct anonymous-struct shapes collected during the parse as ordinary DStructs, so the
// checker + codegen treat them as named structs. Guarded against the decl buffer's syntax-error slot.
append_anon_decls = (a: MutPtr<Malloc>, buf: [Decl], n: i32) i32 {
    i := n
    anon_decls_get().loop((h, j, sd) {
        (i < buf.len - 1).match ({
            true  => {
                buf[i] = dstruct(sd)
                i = i + 1
            },
            false => {
                perr_set()
            },
        })
    })
    i
}
// The taxonomy kind → the sentinel decl name compiler.validate.kinds maps to a diagnostic. Each
// named sentinel says WHAT THE PARSER EXPECTED; `__syntax_error` stays the catch-all for the sites
// that have no better answer yet (and, with a NEGATIVE offset, for the variant-break split shape).
sentinel_name = (kind: i32) string_view {
    (kind == PE_BADBIND()).then({
        return "__bad_binding"
    })
    (kind == PE_MISGEN()).then({
        return "__misordered_generic"
    })
    (kind == PE_UNCLOSED()).then({
        return "__unclosed_block"
    })
    (kind == PE_ARROW()).then({
        return "__expected_arrow"
    })
    (kind == PE_EXPR()).then({
        return "__expected_expr"
    })
    (kind == PE_DECL()).then({
        return "__expected_decl"
    })
    (kind == PE_INIT()).then({
        return "__expected_init"
    })
    (kind == PE_EOF()).then({
        return "__unexpected_eof"
    })
    reg_overflow_get().then({ "__capacity" }, { "__syntax_error" })
}
// Parser totality: any parse/lex failure plants a leading syntax sentinel.
prepend_syntax_error = (a: MutPtr<Malloc>, buf: [Decl], n: i32) [Decl] {
    (n >= buf.len).match ({
        true  => buf.take_decls(n),
        false => {
            i := n
            @while (i > 0) {
                buf[i] = buf[i - 1]
                i = i - 1
            }
            off := (perr_off_get() == 0).then({ lerr_off_get() }, { perr_off_get() })
            voff := (off == vbreak_get() && off != 0).then({ 0 - off }, { off })    // vbreak dot → KVBREAK
            buf[0] = dglobal(sentinel_name(perr_kind_get()), tvoid(), a.enode(lit(voff)))
            buf.take_decls(n + 1)
        },
    })
}
// decl_span is compiler.resolve's boundary oracle; it reuses the real decl parsers.
// `is_type` marks a struct/enum/trait declaration (a `Name: …` head, NOT a `name :=`/`name =` value).
// compiler.resolve uses it so a namespace alias canonicalizes TYPE names to their bare spelling
// (one C identity, deduped) instead of alias-prefixing them — only value/fn decls get the `alias__` prefix.
DeclSpan*: {
    name: string_view,
    named: bool,
    eof: bool,
    is_type: bool,
    start: i32,
    next: i32,
}
decl_span* = (a: MutPtr<Malloc>, src: string_view, pos: i32) DeclSpan {
    sc := src.scan(pos)
    sc.tok.kind.match ({
        .Eof => DeclSpan(
            name: "",
            named: false,
            eof: true,
            is_type: false,
            start: sc.tok.start,
            next: sc.next,
        ),
        _    => src.decl_is_import(pos).match ({
            true  => DeclSpan(
                name: "",
                named: false,
                eof: false,
                is_type: false,
                start: sc.tok.start,
                next: src.import_span_end(pos),
            ),
            false => sc.tok.kind.match ({
                .Ident => a.named_span(src, pos, sc.tok.start),
                _      => DeclSpan(
                    name: "",
                    named: false,
                    eof: false,
                    is_type: false,
                    start: sc.tok.start,
                    next: sc.next,
                ),
            }),
        }),
    })
}
named_span = (a: MutPtr<Malloc>, src: string_view, pos: i32, start: i32) DeclSpan {
    nm := a.lexeme(src, src.scan(pos).tok)
    src.decl_is_impl(pos).match ({
        true  => DeclSpan(
            name: nm,
            named: false,
            eof: false,
            is_type: false,
            start: start,
            next: a.impl_span_end(src, pos),
        ),
        false => src.decl_is_global(pos).match ({
            true  => DeclSpan(
                name: nm,
                named: true,
                eof: false,
                is_type: false,
                start: start,
                next: a.parse_or(src, src.decl_marker(pos).next).next,
            ),
            false => a.decl_is_typed_global(src, pos).match ({
                true  => DeclSpan(
                    name: nm,
                    named: true,
                    eof: false,
                    is_type: false,
                    start: start,
                    next: a.typed_global_end(src, pos),
                ),
                false => src.decl_is_struct(pos).match ({
                    true  => DeclSpan(
                        name: nm,
                        named: true,
                        eof: false,
                        is_type: true,
                        start: start,
                        next: a.parse_struct_at(src, pos).next,
                    ),
                    false => src.decl_is_enum(pos).match ({
                        true  => DeclSpan(
                            name: nm,
                            named: true,
                            eof: false,
                            is_type: true,
                            start: start,
                            next: a.parse_enum_at(src, pos).next,
                        ),
                        false => DeclSpan(
                            name: nm,
                            named: true,
                            eof: false,
                            is_type: false,
                            start: start,
                            next: a.parse_decl_at(src, pos).next,
                        ),
                    }),
                }),
            }),
        }),
    })
}
// Parse impl methods into scratch buffers only to find the block end.
impl_scratch = (a: MutPtr<Malloc>) [Decl] { slice(a.acquire(1024 * sizeof(Decl)), 1024) }
impl_span_end = (a: MutPtr<Malloc>, src: string_view, pos: i32) i32 {
    ie := a.fill_impl_methods(src, src.skip_to_brace(pos), a.impl_scratch(), 0, a.param_buf(), 0, "", "")
    src.scan(ie.next).next
}
import_close = (src: string_view, pos: i32) i32 {
    sc := src.scan(pos)
    sc.tok.kind.match ({
        .Eof => sc.next,
        _    => src.is_rbrace(sc.tok).then({ sc.next }, { src.import_close(sc.next) }),
    })
}
import_span_end = (src: string_view, pos: i32) i32 {
    src.skip_path(src.scan(src.import_close(src.scan(pos).next)).next)
}
