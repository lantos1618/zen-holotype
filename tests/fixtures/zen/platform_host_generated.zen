{ host } = std.sys.platform
main = () i32 {
    p = host()
    p.os.match ({
        .Linux => p.arch.match ({
            .X86_64 => 0,
            .Arm64  => 0,
            _       => 1,
        }),
        .MacOS => p.arch.match ({
            .X86_64 => 0,
            .Arm64  => 0,
            _       => 1,
        }),
        _      => 0,
    })
}
