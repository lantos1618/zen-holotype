// `zenc run prog.zen a b c` forwards everything after the source path to the compiled
// binary's argv; the program reads it back via std.os.arg(i)/argc() (argv[0] = the binary).
{ arg, argc } = std.os
{ println } = std.text.fmt
echo_from = (i: i32) i32 {
    (i >= argc()).match ({ true => 0, false => {
        println(arg(i))
        echo_from(i + 1)
    } })
}
main = () i32 {
    println(argc() - 1)
    echo_from(1)
}
