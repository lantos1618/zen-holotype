// tests/corpus/string-basic/str_find_split_trim_serve_a_csv/main.zen
// issue #776: str's search members serving the program that asked for
// them. One CSV, four rows, each chosen so an edge the hand-rolled
// version got wrong shows up in the total:
//
//   "apple,3"      the ordinary row: find the comma, take what follows.
//   ",5"           an EMPTY FIELD before the comma -- still a name and
//                  a value, found at index 0.
//   "banana"       NO COMMA -- find misses, None is the answer the walk
//                  skips, not a trap and not a zero.
//   "cherry, 7"    a SPACE before the number -- trim_start is what
//                  stands between the caller and whitespace math.
//
// The file ends WITHOUT a newline, so the last row reaches the walk only
// if a tail with no terminator is still a piece. The total answers for
// all four rows at once (15); the hand-rolled scanners this replaces
// each got one of these edges wrong. Every question goes through ONE
// implementation in text_str.
//
// Turning digits into a number is text-to-number, filed separately
// (#774) -- so the value fold below stays hand-rolled, exactly as the
// issue's own program wrote it, and THIS issue owes only the finding,
// splitting and trimming around it.

FsError = std.env

digit_val = (b: u8) i64 { b.to_i64() - 48 }

num_at = (s: str, at: usize) i64 {
    acc ::= 0;
    Range(at, s.len).loop((h, i) {
        b = s[i];
        (b >= '0' && b <= '9').match({
            true  => { acc = acc * 10 + digit_val(b); },
            false => { h.break(0); },
        });
    });
    acc;
}

main = (env: Env) Res<i32, FsError> {
    alloc ::= env.mem.alloc();
    // the file arrives through env.fs -- written here, read back whole,
    // the same door any real CSV comes through
    env.fs.write("rows.csv", "apple,3\n,5\nbanana\ncherry, 7").try();

    s = env.fs.read(alloc, "rows.csv").try().view();
    total ::= 0;
    rows  ::= 0;

    s.split('\n').loop((h, line) {
        // trim's None IS the blank line: nothing left after the spaces
        // are taken off. The walk states that once, here, instead of
        // every caller re-deciding what an empty piece means
        line.trim().match({
            Ok(row) => {
                rows = rows + 1;
                row.find(',').match({
                    Ok(c) => {
                        row.slice(c + 1, row.len).trim_start().match({
                            Ok(field) => { total = total + num_at(field, 0); },
                            None      => {},
                        });
                    },
                    None  => {},
                });
            },
            None    => {},
        });
    });

    println("total = {} (want 15)", total);
    println("rows = {} (want 4)", rows);
    Ok(0);
}
