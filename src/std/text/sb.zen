// Chainable string builder with sticky allocation failure. done() returns the first error and frees
// the partial buffer; later operations are no-ops after failure.
{ String, init, push_in, append_in, finish_in, free_in } = std.text.string
{ integer_in } = std.text.num
{ AllocatorBackend } = std.mem.alloc
{ Result, IoError, ok, err } = std.core.result
{ view } = std.text.str
{ loop_at } = std.core.count
Sb*<A>: {
    a: MutPtr<A>,
    buf: String,
    oom: bool,
    s = (b: Sb<A>, t: StringView) Sb<A> {
        b.oom.match ({
            true  => b,
            false => b.a.append_in(b.buf, t).match ({
                .Ok(g)  => Sb<A>(
                    a: b.a,
                    buf: g,
                    oom: false,
                ),
                .Err(e) => Sb<A>(
                    a: b.a,
                    buf: b.buf,
                    oom: true,
                ),
            }),
        })
    }
    ch = (b: Sb<A>, c: u8) Sb<A> {
        b.oom.match ({
            true  => b,
            false => b.a.push_in(b.buf, c).match ({
                .Ok(g)  => Sb<A>(
                    a: b.a,
                    buf: g,
                    oom: false,
                ),
                .Err(e) => Sb<A>(
                    a: b.a,
                    buf: b.buf,
                    oom: true,
                ),
            }),
        })
    }
    i = (b: Sb<A>, n: i64) Sb<A> {
        // append n's decimal digits (std.text.num renders into a scratch String, freed here).
        b.oom.match ({
            true  => b,
            false => b.a.integer_in(n).match ({
                .Ok(d)  => b.a.finish_in(d).match ({
                    .Ok(txt) => {
                        out = b.s(txt)
                        d.free_in(b.a)
                        out
                    },
                    .Err(e)  => {
                        d.free_in(b.a)
                        Sb<A>(
                            a: b.a,
                            buf: b.buf,
                            oom: true,
                        )
                    },
                }),
                .Err(e) => Sb<A>(
                    a: b.a,
                    buf: b.buf,
                    oom: true,
                ),
            }),
        })
    }
    rep = (b: Sb<A>, t: StringView, n: i64) Sb<A> {
        // append t, n times — ITERATIVE. n <= 0 or an empty t appends nothing.
        b.oom.match ({
            true  => b,
            false => {
                tv = t.view()
                cnt = (n < 0).then({ 0 }, { n })
                total = tv.len * cnt
                (total == 0).then({ b }, { b.sb_fill(tv, total) })
            },
        })
    }
    done = (b: Sb<A>) Result<StringCstr, IoError> {
        // settle the chain: the finished NUL-terminated str, or the sticky failure.
        // On the Err path the partial buffer is freed — nothing owns it after done.
        b.oom.match ({
            true  => {
                b.buf.free_in(b.a)
                err(.Errno(SB_ENOMEM))
            },
            false => b.a.finish_in(b.buf),
        })
    }
}
// errno 12 (out of memory). Named locally: std.io.file keeps a private `ENOMEM = 12` too, and a
// closure holding both modules (the harness does) would collide on the flat namespace.
SB_ENOMEM = 12
// start a builder on `a`; an initial-allocation failure is recorded as the sticky flag.
sb*<A: AllocatorBackend> = (a: MutPtr<A>) Sb<A> {
    a.init(16).match ({
        .Ok(g)  => Sb<A>(
            a: a,
            buf: g,
            oom: false,
        ),
        .Err(e) => Sb<A>(
            a: a,
            buf: String(
                ptr: null_ptr(),
                len: 0,
                cap: 0,
            ),
            oom: true,
        ),
    })
}
// grow `s` so `need + 1` more bytes fit (the +1 keeps done's NUL in-place, string.zen's invariant).
sb_grow = (a: AllocatorBackend, s: String, need: i64) Result<String, IoError> {
    s = s
    (s.len + need + 1 > s.cap).match ({
        true  => {
            ncap = (s.cap + need + 1) * 2
            a.try_resize(s.ptr, ncap).match ({
                .Ok(p)  => ok(String(
                    ptr: p,
                    len: s.len,
                    cap: ncap,
                )),
                .Err(e) => err(e),
            })
        },
        false => ok(s),
    })
}
// rep's fill: ONE reservation of the whole block, then an iterative modulo copy over the
// destination slice (`dst[k] = tv[k % tv.len]`, exactly str.zen's repeat_in). No recursion,
// no per-chunk realloc — the buffer cannot move mid-copy, so tv may not alias it safely anyway.
sb_fill<A> = (b: Sb<A>, tv: Slice<u8>, total: i64) Sb<A> {
    b.a.sb_grow(b.buf, total).match ({
        .Ok(g)  => {
            dst :: MutSlice<u8> = g.ptr.offset(g.len).slice(total)
            dst.loop_at((k, x) { dst[k] = tv[k % tv.len] })
            Sb<A>(
                a: b.a,
                buf: String(
                    ptr: g.ptr,
                    len: g.len + total,
                    cap: g.cap,
                ),
                oom: false,
            )
        },
        .Err(e) => Sb<A>(
            a: b.a,
            buf: b.buf,
            oom: true,
        ),
    })
}
