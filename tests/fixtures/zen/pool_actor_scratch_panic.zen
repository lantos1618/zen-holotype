// PANIC-PATH SCRATCH RECLAIM proof (std.concurrent.pool + pool_actor, S4-lite). Three typed actors on a
// 3-worker pool, each with its OWN tiny scratch arena. The MIDDLE actor bump-allocates into its scratch
// and THEN divides by zero on a single poison `Boom(0)` message — it panics INSIDE `receive`, after the
// scratch bump. The other two are survivors: PERMSG `Work` messages each, every one bump-allocating a
// CHUNK into scratch and counting a success. SCAP holds only 4 chunks, so the survivors completing their
// full PERMSG each is itself proof the pool RESETS scratch every behavior (normal path, under load, while
// a sibling is crashing).
//
// The crux: the panicking actor's scratch is RESET ON THE CRASH PATH (pool.zen drain_batch resets after
// __zen_actor_call returns, whether it returned or panicked — on the worker's NORMAL stack). So after
// quiescence the bomber's arena bump pointer is back at 0 — its pre-panic allocation was reclaimed
// wholesale, no leak, structurally. Without the crash-branch reset, `used()` would still read CHUNK.
//
// PROOF (exit 7 iff ALL hold):
//   ok == 2*PERMSG          — both survivors processed their full load => worker survived the panic AND
//                             other actors keep working (panic isolation intact) AND their scratch reset
//                             every message (a 256-byte arena served 2000 allocations apiece).
//   bomber used() == 0      — the CRASH-PATH reset reclaimed the panicking behavior's scratch (no leak).
//   surv used() == 0        — each survivor's final behavior reset too (bump pointer left at 0).
// Run under `cc -fsanitize=address` it also reports NO leak: per-behavior work is bump-allocated into
// scratch (no per-message malloc), and every scratch backing block is freed by free_scratch after close.
{ pool_open, Pool } = std.concurrent.pool
{ malloc, free } = std.mem.alloc
{ is_null } = std.core.ptr
{ Arena } = std.mem.arena
pa = std.concurrent.pool_actor
{ Context, Receiver } = std.concurrent.pool_actor
PERMSG := 2000
SCAP := 256
CHUNK := 64
WORKERS := 3
Msg*: Work(i64) | Boom(i64)
Worker*: {
    scratch: MutPtr<Arena>,
    ok: RawPtr<u8>,
}
Worker.impl(Receiver, {
    receive = (w: MutPtr<Worker>, ctx: Context<Msg>) void {
        ctx.msg.match ({
            .Work(n) => {
                p := w.scratch.bump(CHUNK)
                (is_null(p) == false).then({
                    atomic_add_i64(w.ok, 1)
                })
            },
            .Boom(n) => {
                hit := w.scratch.bump(CHUNK)    // allocate into scratch FIRST (off advances to CHUNK)
                (is_null(hit) == false).then({
                    g := 100 / n    // n == 0 → integer divide by zero → PANIC (worker catches it)
                    atomic_add_i64(w.ok, g)
                })
            },
        })
    }
})    // unreached on panic
tramp = (user: RawPtr<u8>, msg: i64) void {
    a: [Worker] := user.slice(1)
    b: [Msg] := msg.offset(0).slice(1)
    a[0].addr().receive(Context(msg: b[0]))
    pa.free_msg(msg)
}
send_work = (p: MutPtr<Pool>, h: pa.PooledHandle<Worker>, k: i64) void {
    (k < PERMSG).then({
        p.send(h, Msg.Work(k))
        send_work(p, h, k + 1)
    })
}
main = () i32 {
    ok := assert_nonnull(malloc(8))
    store_i64(ok, 0)
    sc0 := pa.new_scratch(SCAP)
    sc1 := pa.new_scratch(SCAP)
    sc2 := pa.new_scratch(SCAP)
    h0 := pa.spawn_actor_scratch_heap(PERMSG + 16, Worker(
        scratch: sc0,
        ok: ok,
    ), tramp, sc0)
    h1 := pa.spawn_actor_scratch_heap(16, Worker(
        scratch: sc1,
        ok: ok,
    ), tramp, sc1)
    h2 := pa.spawn_actor_scratch_heap(PERMSG + 16, Worker(
        scratch: sc2,
        ok: ok,
    ), tramp, sc2)
    p := pool_open(WORKERS, 16)
    send_work(p, h0, 0)
    p.send(h1, Msg.Boom(0))    // ONE poison message → the middle actor panics after touching its scratch
    send_work(p, h2, 0)
    p.pool_quiesce_stop()
    got := load_i64(ok)
    bomb_used := sc1.used()    // 0 iff the crash-path reset reclaimed the panicking behavior's scratch
    s0_used := sc0.used()
    s2_used := sc2.used()
    pa.close(h0)
    pa.close(h1)
    pa.close(h2)
    p.pool_close()
    pa.free_scratch(sc0)
    pa.free_scratch(sc1)
    pa.free_scratch(sc2)
    free(ok)
    (got == 2 * PERMSG && bomb_used == 0 && s0_used == 0 && s2_used == 0).then({ 7 }, { 1 })
}
