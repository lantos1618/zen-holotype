// M4 SLICE 1'S GATE, THE VIA-META HALF (`docs/design_meta.md` §7, M4
// slice 1): `@meta(self: @Self).fields().len` folds at sema time to the
// WRITTEN type's FIELD count — `Struct.members` filtered to
// `MemberKind.Field`, so a constant member (`k: i64 = 5`) and a method
// do not count. The fold is a COMPTIME USIZE and answers as one
// (`sema_check.meta_count_type`); no hidden usize-to-i64 conversion
// exists (#756 family), so the reader methods are spelled `usize`.
// The backend lowers them as ordinary integer literals, having learned
// nothing new.
//
// THE TWIN IS THE ORACLE (§6.3): `field_count_by_hand` writes each
// count by hand and must print byte-identical stdout.
//
// ALL FOUR COUNTS GO THROUGH THE FOLD. One, Mixed and Muddle carry a
// `fields` reader whose body is the chain over `@Self`; EMPTY CANNOT —
// a reader on Empty would make it non-empty — so its count is asked
// DIRECTLY, in expression position, through the same typed form
// (`@meta(t: Empty).fields().len`); `t` is the receiver slot this rule
// never reads. Two routes, one answer each.
//
// MUTATION RESISTANCE (§6.4): line one asserts all four counts out
// loud; line two is an arithmetic witness with no zero term — a
// transposed or skipped field changes it. A filter that also counted
// consts prints `counts 0 1 3 3` / `witness 114` instead of
// `counts 0 1 3 2` / `witness 93`; one that counted nothing prints
// `counts 0 0 0 0` / `witness 0`.

Empty = { }

One = {
    only: i64,

    fields* = (self: @Self) usize { @meta(self: @Self).fields().len },
}

Mixed = {
    a: i64,
    b: bool,
    c: str,

    fields* = (self: @Self) usize { @meta(self: @Self).fields().len },
}

Muddle = {
    p: i64,
    q: bool,

    k: i64 = 5,

    go* = (self: @Self) i64 { 7 },

    fields* = (self: @Self) usize { @meta(self: @Self).fields().len },
}

main = (env: Env) Res<i32, AllocError> {
    o      = One(only: 11);
    x      = Mixed(a: 10, b: true, c: "s");
    m      = Muddle(p: 1, q: true);
    println("counts {} {} {} {}",
            @meta(t: Empty).fields().len,
            o.fields(), x.fields(), m.fields());
    println("witness {}",
            ((@meta(t: Empty).fields().len * 1)
             + (o.fields() * 2) + (x.fields() * 5) + (m.fields() * 7)) * 3);
    Ok(0);
}
