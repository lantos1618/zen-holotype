// THE FIELD BINDER STANDING AS A VALUE (`docs/design_meta.md` §7, M4
// slice 2). `field` is a comptime term: its `name` folds, and it is the
// projection's argument — everything else is the wall. Printed, it is
// a comptime term where a value was wanted.
//
// position: the `field` use, not the walk and not the `println`.

One = { only: i64 }

main = (env: Env) Res<i32, AllocError> {
    o = One(only: 1);
    @meta(x: One).fields().loop((h, field) {
        println("{}", field);
    });
    Ok(0);
}
