// the second declarer of `Box`. same name, same field list, different
// arithmetic: the only thing distinguishing the two types is WHICH
// module a value was built in -- so each module builds its own, and
// exports the factory beside the type.
//
// bare `Box(..)` is deliberately NOT used here: with both declarers
// imported, constructor resolution is order-dependent (see LANE.md),
// and a test standing on it would wobble. factories remove every
// ambiguity but the one under test.
Box* = {
    label*: i32,
}

make_crate* = (n: i32) Box { Box(label: n) }

describe* = (b: Box) i32 { b.label * 1000 }
