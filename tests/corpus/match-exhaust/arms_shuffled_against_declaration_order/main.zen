// The arms are written in an order that agrees with NEITHER the declaration
// order nor the obvious alphabetical one, and every arm answers a different
// number.
//
// A union's tags are numbered by a canonical order over its members, never
// by declaration order (DESIGN.md § Layout), so a dispatch built against one
// numbering while the arm chain was emitted in the other silently pairs
// every value with the wrong arm. Nothing rejects: each arm typechecks, the
// C is valid, and the sum still prints as A NUMBER -- just not this one.
// The three orders here (declaration Zulu/Mike/Alpha, arm order
// Alpha/Zulu/Mike, alphabetical Alpha/Mike/Zulu) disagree pairwise, so any
// single off-by-one between tag and arm shows in the totals.
//
// Breaks if: the arm chain is emitted in a different member order than the
// one the tags were assigned in -- at least one arm misdispatches and the
// line reads something other than "11 22 30" / "63".

Tag = Zulu | Mike | Alpha

pick = (t: Tag) i32 {
    t.match({
        Alpha => 30,
        Zulu  => 11,
        Mike  => 22,
    });
}

main = (env: Env) Res<i32, AllocError> {
    println("{} {} {}", pick(Tag.Zulu), pick(Tag.Mike), pick(Tag.Alpha));
    total = pick(Tag.Zulu) + pick(Tag.Mike) + pick(Tag.Alpha);
    println("{}", total);
    Ok(0);
}
