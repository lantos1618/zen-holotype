// an enum keeps its variants AND ITS PAYLOADS across a re-export: each arm
// is still its own value, and what each arm carries is still what was put
// in it. Naming the payload and never reading it left the second half
// unobserved -- a compiler zeroing every payload printed the same three
// lines -- so every arm reads what it bound and prints it.
Pos, Node = shape.shape

show = (n: Node) () {
    n.match({
        Leaf(v) => println("leaf {}", v),
        At(p)   => println("at {}", p.line),
        Empty   => println("empty"),
    });
}

main = (env: Env) Res<i32, IoError> {
    show(Node.Leaf(97));
    show(Node.Leaf(3141));
    show(Node.At(Pos(line: 26)));
    show(Node.Empty);
    Ok(0);
}
