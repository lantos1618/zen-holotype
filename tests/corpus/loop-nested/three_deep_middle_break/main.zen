// tests/corpus/loop-nested/three_deep_middle_break.zen
// a break fired from the DEEPEST body with the MIDDLE loop's handle
// stops the middle loop and unwinds only its own frame: the inner
// loop's tail never prints, the outer loop's body does, every time.
//
// Two levels of nesting is the minimum to name a depth; three is the
// first depth that is neither innermost nor outermost. A lowering
// that only understands "nearest loop" and "outermost function" — the
// two shapes the flat tests exercise — binds this handle to the wrong
// one of the three and still prints a full grid of plausible lines;
// which lines survive is the whole assertion.
//
// The break fires on the inner value 2 of every middle pass: if it
// were read as an INNER break, "inner after" would print twice per
// middle pass; as an OUTER break, "middle done" would print once in
// total. Both counts are visible in the expected file.

main = (env: Env) Res<i32, AllocError> {
    Range(0, 3).loop((h_out, o) {
        println("outer {}", o);
        Range(0, 2).loop((h_mid, m) {
            println("  middle {} {}", o, m);
            Range(0, 4).loop((h_in, i) {
                (i == 2).then(() { h_mid.break() });
                println("    inner {} {} {}", o, m, i);
            });
            println("    inner after");
        });
        println("  middle done");
    });
    Ok(0);
}
