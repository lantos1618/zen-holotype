{ eq } = std.text.str
{ ord } = std.core.bool
Box<T>: {
    value: T,
    get = (box: Box<T>) T { box.value }
}
Msg*: Hold(Box<string_view>) | Empty
main = () i32 {
    msg := Msg.Hold(Box<string_view>(value: "generic"))
    got := msg.match ({
        .Hold(box) => box.get(),
        .Empty     => "empty",
    })
    eq(got, "generic").ord()
}
