// `g = (x: usize) () { .. }` — a declaration whose return type is
// written `()`.
//
// R1a classifies a declaration's value by the token after the parameter
// list's `)`, and that test deliberately refused a `(`, so that
// `g = (f)(x)` stays a call of a parenthesised callee. But a function
// that WRITES its unit return type has a `(` there too, so
// `strip_bom = (lx :: Lexer) () { .. }` in src/std/lex/lex_scan.zen was
// classified as a constant and its parameter list parsed as an
// expression.
//
// What tells the two apart is one more group: a second `(..)` followed
// by a `{` is a return type and a body, and a call is never followed by
// a block.
//
// THE SIGNATURE-ONLY SPELLING IS NOW CALLED. `Sink.put` -- the actually
// novel case, a `()` return type with NO `{` after it at all -- used to be
// declared and never observed, and the file's only runtime expectation was
// the argument echoed back from the easy half. `Doubler` implements it and
// the value that comes out has to have travelled through the signature.

shout = (env: Env, n: i32) () { println("{}", n * 6 + 4) }

// the signature-only spelling of the same thing, which has no `{` after
// it at all and must still not be read as a call
Sink = {
    put* = (self: @Self, e: Env, n: i32) ()
}

Doubler = { factor: i32 }

Doubler.impl(Sink, {
    put* = (self: @Self, e: Env, n: i32) () { println("{}", n * self.factor) }
})

main = (env: Env) Res<i32, ArgError> {
    shout(env, 7);
    d = Doubler(factor: 3);
    d.put(env, 14);
    d.put(env, 100);
    Ok(0);
}
