{ Result, IoError, err, ok } = std.core.result
f = (sel: i32) Result<i32, IoError> {
    v := (sel == 1).match ({ true => {
        return ok(41)
    }, false => {
        return err(IoError.Denied)
    } })
    .Ok(v + 1)
}
main = () i32 {
    a := f(1).match ({
        .Ok(v)  => v,
        .Err(e) => 0,
    })    // 41
    b := f(0).match ({
        .Ok(v)  => 0,
        .Err(e) => 2,
    })    // 2
    a + b
}    // 43
