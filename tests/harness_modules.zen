                    src: "{ strip_ns_into, add_name } = compiler.resolve\n{ Malloc } = std.mem.alloc\n{ expect } = std.core.result\n{ String, init } = std.text.string\n{ contains, len, view } = std.text.str\n{ new_in, append_in, finish_in } = std.text.string\n{ to_exit } = std.core.bool\nsname = (s: str) String { a := Malloc(_: 0)  a.addr().init(32).expect(\"init\").append_in(a.addr(), s).expect(\"oom\") }\ngenrep = (mp: MutPtr<Malloc>, chunk: str, n: i32) str { s := mp.new_in().expect(\"oom\")  i := 0  @while (i < n) { s = s.append_in(mp, chunk).expect(\"oom\")  i = i + 1 }  mp.finish_in(s).expect(\"oom\") }\nmain = () i32 {\n    a := Malloc(_: 0)\n    ap := a.addr()\n    body := ap.genrep(\"right.thing()\\n\", 3500)\n    src := ap.new_in().expect(\"oom\").append_in(ap, \"main = () i32 {\\n\").expect(\"oom\").append_in(ap, body).expect(\"oom\").append_in(ap, \"}\\n\").expect(\"oom\").finish_in(ap).expect(\"oom\")\n    quals := ap.init(32).expect(\"init\").add_name(ap, sname(\"right\"))\n    qnames := ap.init(64).expect(\"init\").add_name(ap, sname(\"right.thing\"))\n    empty := ap.init(1).expect(\"init\")\n    out := ap.init(65536).expect(\"init\").strip_ns_into(ap, src, 0, quals, qnames, qnames, empty, true).finish_in(ap).expect(\"oom\")\n    ok := out.contains(\"right__thing()\") && (!out.contains(\"right.thing()\"))\n    ok.to_exit()\n}\n",
                ),
            ],
            entry: "p.zen",
            want: 0,
        ),
        ModValCase(
            files: [
                ModFile(
                    name: "p.zen",
                    src: mp.zo_join([z, "{ Malloc } = std.mem.alloc\n{ dedup_decls } = compiler.resolve\n{ contains } = std.text.str\n{ to_exit } = std.core.bool\nmain = () i32 {\n    a := Malloc(_: 0)\n    src := \"", esc_nl(mp, dedup260), "\"\n    out := a.addr().dedup_decls(src, 0, 0)\n    ok := out.contains(\"v259\") && (!out.contains(\"777\"))\n    ok.to_exit()\n}\n"]),
                ),
            ],
            entry: "p.zen",
            want: 0,
        ),
        ModValCase(
            files: [
                ModFile(
                    name: "geo.zen",
                    src: "Point*: { x: i32, y: i32 }\nnorm1* = (p: Point) i32 { p.x + p.y }\nscale* = (p: Point, k: i32) Point { Point(x: p.x * k, y: p.y * k) }\n",
                ),
                ModFile(
