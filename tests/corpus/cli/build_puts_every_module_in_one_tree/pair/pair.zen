// The imported half of the two-module program under `pair/`.
//
// Its module name is `pair` from BOTH roots this file is compiled under,
// which is what makes the pair spellable at all: the folder-root rule
// says `<folder>/<folder>.zen`, so `pair` resolves here from the staged
// `src/`, and the flat rule says `<root>/<name>.zen`, so `pair` resolves
// here again from `src/pair`. The import in `main.zen` beside it is the
// same three characters either way.

Leaf* = {
    n*: i32,
}

leaf_value* = () i32 { 42 }
