// identifiers that are not C KEYWORDS but are still not yours.
//
// three groups, and a mangler built from a keyword list handles none of
// them:
//
// 1. RESERVED TO THE IMPLEMENTATION (C11 §7.1.3). Any identifier beginning
//    with an underscore followed by an uppercase letter, or containing a
//    double underscore, is reserved for ANY use, at ANY scope. An
//    identifier beginning with a single underscore is reserved at file
//    scope. Using one is undefined behaviour, not an error — so this group
//    fails silently on the compiler you tested and loudly on the next one.
//    Handling the whole CLASS also covers every `_Uppercase` C11 keyword
//    for free, which is the reason to do it as a class and not a list.
//
// 2. VENDOR KEYWORDS. gcc/clang/msvc extend the keyword set. `asm` and
//    `typeof` are keywords in gnu modes, `near`/`far` in some embedded
//    targets, `__declspec`/`__int64` on msvc. gen_c emits C that a user
//    compiles with a compiler we do not choose.
//
// 3. NAMES GEN_C ITSELF EMITS. This is the group that has no external
//    authority to look up, and the only one that can be got right by
//    construction: pick a prefix no mangled user name can ever produce,
//    and every generated temporary, trap helper and runtime entry point
//    goes in it. `__builtin_add_overflow` is here because DESIGN.md's
//    failure model REQUIRES gen_c to emit it — signed overflow is UB, so
//    the check cannot be post-hoc — and a user binding of that name must
//    not be able to shadow the builtin at the point the trap expands.
//
// none of these are hypothetical: each is a real Zen identifier a user is
// entitled to write, and each one is legal Zen.

main = (env: Env) Res<i32, AllocError> {
    _x = 1;
    _y = 2;
    _Z = 3;
    __z = 4;

    asm = 5;
    __asm__ = 6;
    __attribute__ = 7;
    __declspec = 8;
    __inline = 9;
    __restrict = 10;
    __typeof__ = 11;
    _Pragma = 12;
    __int64 = 13;
    near = 14;
    far = 15;

    __builtin_add_overflow = 16;
    __builtin_sub_overflow = 17;
    __builtin_mul_overflow = 18;
    __builtin_expect = 19;
    zen_trap = 20;
    zen_main = 21;
    t0 = 22;
    tmp = 23;
    _zen_0 = 24;

    sum ::= 0;
    sum = sum + _x;
    sum = sum + _y;
    sum = sum + _Z;
    sum = sum + __z;
    sum = sum + asm;
    sum = sum + __asm__;
    sum = sum + __attribute__;
    sum = sum + __declspec;
    sum = sum + __inline;
    sum = sum + __restrict;
    sum = sum + __typeof__;
    sum = sum + _Pragma;
    sum = sum + __int64;
    sum = sum + near;
    sum = sum + far;
    sum = sum + __builtin_add_overflow;
    sum = sum + __builtin_sub_overflow;
    sum = sum + __builtin_mul_overflow;
    sum = sum + __builtin_expect;
    sum = sum + zen_trap;
    sum = sum + zen_main;
    sum = sum + t0;
    sum = sum + tmp;
    sum = sum + _zen_0;

    println("reserved {}", sum);
    Ok(0);
}
