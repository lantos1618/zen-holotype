// src/std/std.zen
//
// The library's whole surface, in one file of starred re-exports.
// A folder root is its folder's public surface and nothing else, so
// every name a program can reach through `std` is listed here, and
// anything absent is module-private on purpose: `grow` and `Entry`
// are the named cases.
//
// Each line mirrors the module root it names, which is itself a
// file of starred re-exports. That is a chain, deliberately: the
// module below is free to move a declaration between its own files
// without a single line here changing.
//
// std.core is the prelude and is auto-imported, so a program never
// writes `Res` or `then` down. It is re-exported anyway — a surface
// with a hole in it is not a surface, and `std.Res` must name the
// same type the prelude does.

Res*, Ok*, Err*, None*, ok_or*, then* = std.core
Drop*, Scope* = std.core
i8*, i16*, i32*, i64* = std.core
u8*, u16*, u32*, u64*, usize* = std.core
f32*, f64* = std.core
loop*, find*, filter*, map*, pairs*, LoopHandle*, Range* = std.core
Eq*, Hash*, Hasher*, Display* = std.core
IoError*, WriteError*, Sink*, Path*, Duration* = std.core

// the allocator, and the law: no Alloc parameter, no allocation.
// Ptr and null_ptr are the raw floor everything above stands on
AllocError*, Alloc*, Arena*, Mem*, Ptr*, null_ptr* = std.mem

// str is borrowed bytes; String is owned, growable, and IS the Vec
str*, String* = std.text

// Entry is absent because it has no star: collections are sealed,
// and what a Map is made of is not part of what a Map is
Vec*, Map* = std.collections

// the capability root. all authority flows from the Env main receives
Env*, Console*, Fs*, Net*, ArgError* = std.env
Threads*, Thread*, ThreadError* = std.env

TestError*, Tester*, Bencher*, BenchStats* = std.test

BuildError*, Package*, Builder*, Budget* = std.build
Os*, Arch*, Dep*, Exe*, Lib*, Extern*, Test*, Bench* = std.build

// std.actor and std.thread arrive at stage 5. They are outside the
// seed subset, so the compiler itself never imports them, and a
// line here before the module exists would be a promise this file
// cannot keep.
