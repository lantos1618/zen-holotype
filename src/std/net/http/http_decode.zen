// Incremental and offline HTTP/1 response decoding.

Alloc = std.mem
str, String, str_at = std.text
Res, Range, ok_or = std.core
Sink = std.core.io
Vec = std.collections
HttpError, HttpResponseMeta, HttpResponse, http_error = std.net.http.http_types
Stream, read = std.net.tls

HEADER_END: str = "\r\n\r\n"
HTTP_HEAD_MAX: usize = 65536

BodyFraming = BodyNone | BodyChunked | BodyLength(usize) | BodyClose

ParsedHead = {
    meta: HttpResponseMeta,
    framing: BodyFraming,
}

ResponseParts = {
    head: ParsedHead,
    body: str,
}

parse_status_line = (line: str) Res<i32, HttpError> {
    first   = line.find(' ').ok_or(HttpError.DecodeFailed).try();
    version = line.slice(0, first);
    (version.eq("HTTP/1.0") || version.eq("HTTP/1.1"))
        .ensure(HttpError.DecodeFailed).try();

    after  = line.slice(first + 1, line.len);
    second = after.find(' ').ok_or(HttpError.DecodeFailed).try();
    code   = after.slice(0, second);
    (code.len == 3 && code[0].is_digit()
        && code[1].is_digit() && code[2].is_digit())
        .ensure(HttpError.DecodeFailed).try();
    code.parse_i32().ok_or(HttpError.DecodeFailed)
}

field_name_byte = (b: u8) bool {
    b.is_alnum() || b.is_in([
        '!', '#', '$', '%', '&', '\'', '*', '+', '-', '.', '^', '_', '`', '|',
        '~'
    ])
}

field_name = (name: str) bool {
    (name.len > 0) && Range(0, name.len).find((i) {
        !name[i].field_name_byte()
    }).match({ Ok(_) => false, None => true })
}

HeaderDecoder = {
    status :: i32,
    content_length :: usize,
    found_length :: bool,
    transfer_seen :: bool,
    final_chunked :: bool,

    length = (self :: @Self, value: str) Res<(), HttpError> {
        parts ::= value.split(',');
        found ::= false;
        loop((h) {
            parts.next().match({
                None    => h.break(),
                Ok(raw) => {
                    item = raw.trim().ok_or(HttpError.DecodeFailed).try();
                    (item.len > 0).ensure(HttpError.DecodeFailed).try();
                    n = item.parse_usize().ok_or(HttpError.DecodeFailed).try();
                    self.found_length.then(() {
                        (self.content_length == n)
                            .ensure(HttpError.DecodeFailed).try();
                    });
                    self.content_length = n;
                    self.found_length   = true;
                    found               = true;
                },
            });
        });
        found.ensure(HttpError.DecodeFailed)
    }

    transfer = (self :: @Self, value: str) Res<(), HttpError> {
        parts ::= value.split(',');
        found ::= false;
        loop((h) {
            parts.next().match({
                None    => h.break(),
                Ok(raw) => {
                    coding = raw.trim().ok_or(HttpError.DecodeFailed).try();
                    (coding.len > 0).ensure(HttpError.DecodeFailed).try();
                    (!self.final_chunked).ensure(HttpError.DecodeFailed).try();
                    self.transfer_seen = true;
                    self.final_chunked = coding.eq_ignore_case("chunked");
                    found              = true;
                },
            });
        });
        found.ensure(HttpError.DecodeFailed)
    }

    field = (self :: @Self, line: str) Res<(), HttpError> {
        colon = line.find(':').ok_or(HttpError.DecodeFailed).try();
        name  = line.slice(0, colon);
        name.field_name().ensure(HttpError.DecodeFailed).try();
        value = line.slice(colon + 1, line.len)
            .trim().ok_or(HttpError.DecodeFailed).try();

        name.eq_ignore_case("content-length").then(() {
            self.length(value).try();
        });
        name.eq_ignore_case("transfer-encoding").then(() {
            self.transfer(value).try();
        });
        Ok(())
    }

    finish = (self: @Self) Res<ParsedHead, HttpError> {
        (!(self.transfer_seen && self.found_length))
            .ensure(HttpError.DecodeFailed).try();
        no_body = (self.status >= 100 && self.status < 200)
            || self.status == 204 || self.status == 304;
        framing = no_body.match({
            true  => BodyFraming.BodyNone,
            false => self.transfer_seen.match({
                true  => self.final_chunked.match({
                    true  => BodyFraming.BodyChunked,
                    false => BodyFraming.BodyClose,
                }),
                false => self.found_length.match({
                    true  => BodyFraming.BodyLength(self.content_length),
                    false => BodyFraming.BodyClose,
                }),
            }),
        });
        Ok(ParsedHead(
            meta: HttpResponseMeta(
                status: self.status,
                content_length: self.content_length,
                has_content_length: self.found_length,
                chunked: self.transfer_seen && self.final_chunked
            ),
            framing: framing
        ))
    }
}

parse_headers = (block: str) Res<ParsedHead, HttpError> {
    lines ::= block.split('\n');
    status_line = lines.next().ok_or(HttpError.DecodeFailed).try();
    status      = status_line.parse_status_line().try();
    decoder ::= HeaderDecoder(
        status: status,
        content_length: 0,
        found_length: false,
        transfer_seen: false,
        final_chunked: false
    );

    loop((h) {
        lines.next().match({
            None    => h.break(),
            Ok(raw) => {
                line = raw.trim_end().ok_or(HttpError.DecodeFailed).try();
                (line.len == 0).then(() { h.break(); });
                decoder.field(line).try();
            },
        });
    });
    decoder.finish()
}

parts_at = (raw: str, end: usize) Res<ResponseParts, HttpError> {
    (end + HEADER_END.len <= HTTP_HEAD_MAX)
        .ensure(HttpError.DecodeFailed).try();
    block = raw.slice(0, end);
    head  = block.parse_headers().try();
    Ok(ResponseParts(
        head: head,
        body: raw.slice(end + HEADER_END.len, raw.len)
    ))
}

response_parts = (raw: str) Res<ResponseParts, HttpError> {
    end = raw.find(HEADER_END).ok_or(HttpError.DecodeFailed).try();
    raw.parts_at(end)
}

// A close-delimited body treats orderly transport close as its end; every
// other read keeps Closed as a premature RecvFailed.
read_eof = (s: Stream, buf :: Vec<u8>, n: usize) Res<usize, HttpError> {
    s.read(buf, n).match({
        Ok(got) => Ok(got),
        Err(e)  => e.match({ Closed => Ok(0), _ => Err(e.http_error()) }),
    })
}

write_body = (out :: Sink, bytes: str) Res<(), HttpError> {
    (bytes.len > 0).then(() {
        out.write(bytes).match({
            Ok(_)  => Ok(()),
            Err(e) => Err(HttpError.BodyWriteFailed(e)),
        }).try();
    });
    Ok(())
}

ChunkPhase = Size
    | Extension
    | SizeLf
    | Data
    | DataCr
    | DataLf
    | Trailer
    | TrailerLf
    | TrailerEndLf
    | Done

// Incremental HTTP chunk framing. `feed` may stop at any byte boundary;
// only Data slices reach the sink, while sizes, extensions and trailers are
// consumed here. The same decoder serves socket reads and offline parsing.
ChunkDecoder = {
    phase ::             ChunkPhase = ChunkPhase.Size,
    size ::              usize = 0,
    digits ::            usize = 0,
    left ::              usize = 0,
    trailer_has_bytes :: bool = false,
    trailer_has_colon :: bool = false,

    done = (self: @Self) bool {
        self.phase.match({ Done => true, _ => false })
    }

    feed = (self :: @Self, bytes: str, out :: Sink)
           Res<(), HttpError> {
        at ::= 0;
        loop((h) {
            (at >= bytes.len || self.done()).then(() { h.break(); });
            self.phase.match({
                Data => { at = self.feed_data(bytes, at, out).try(); },
                _    => {
                    self.step(bytes[at]).try();
                    at = at + 1;
                },
            });
        });
        Ok(())
    }

    feed_data = (self :: @Self, bytes: str, at: usize, out :: Sink)
                Res<usize, HttpError> {
        available = bytes.len - at;
        take      = (self.left < available).match({
            true => self.left, false => available
        });
        out.write_body(bytes.slice(at, at + take)).try();
        self.left = self.left - take;
        (self.left == 0).then(() { self.phase = ChunkPhase.DataCr; });
        Ok(at + take)
    }

    step = (self :: @Self, b: u8) Res<(), HttpError> {
        self.phase.match({
            Size         => self.size_byte(b),
            Extension    => self.extension_byte(b),
            SizeLf       => self.size_lf(b),
            Data         => Err(HttpError.DecodeFailed),
            DataCr       => self.expect(b, '\r', ChunkPhase.DataLf),
            DataLf       => self.data_lf(b),
            Trailer      => self.trailer_byte(b),
            TrailerLf    => self.trailer_lf(b),
            TrailerEndLf => self.expect(b, '\n', ChunkPhase.Done),
            Done         => Ok(()),
        })
    }

    size_byte = (self :: @Self, b: u8) Res<(), HttpError> {
        b.hex_usize().match({
            Ok(d) => {
                (self.size <= (usize.MAX - d) / 16)
                    .ensure(HttpError.DecodeFailed).try();
                self.size   = self.size * 16 + d;
                self.digits = self.digits + 1;
                Ok(())
            },
            None  => {
                (self.digits > 0).ensure(HttpError.DecodeFailed).try();
                b.match({
                    ';'  => { self.phase = ChunkPhase.Extension; Ok(()) },
                    '\r' => { self.phase = ChunkPhase.SizeLf; Ok(()) },
                    _    => Err(HttpError.DecodeFailed),
                })
            },
        })
    }

    extension_byte = (self :: @Self, b: u8) Res<(), HttpError> {
        (b != '\n').ensure(HttpError.DecodeFailed).try();
        (b == '\r').then(() { self.phase = ChunkPhase.SizeLf; });
        Ok(())
    }

    size_lf = (self :: @Self, b: u8) Res<(), HttpError> {
        (b == '\n').ensure(HttpError.DecodeFailed).try();
        (self.size == 0).match({
            true  => { self.phase = ChunkPhase.Trailer; Ok(()) },
            false => {
                self.left  = self.size;
                self.phase = ChunkPhase.Data;
                Ok(())
            },
        })
    }

    data_lf = (self :: @Self, b: u8) Res<(), HttpError> {
        (b == '\n').ensure(HttpError.DecodeFailed).try();
        self.size   = 0;
        self.digits = 0;
        self.phase  = ChunkPhase.Size;
        Ok(())
    }

    trailer_byte = (self :: @Self, b: u8) Res<(), HttpError> {
        (b != '\n').ensure(HttpError.DecodeFailed).try();
        (b == '\r').match({
            true  => self.trailer_has_bytes.match({
                true  => {
                    self.trailer_has_colon.ensure(HttpError.DecodeFailed)
                        .try();
                    self.phase = ChunkPhase.TrailerLf;
                    Ok(())
                },
                false => {
                    self.phase = ChunkPhase.TrailerEndLf;
                    Ok(())
                },
            }),
            false => {
                self.trailer_has_colon.match({
                    true  => (b == '\t' || (b >= ' ' && b != 127))
                        .ensure(HttpError.DecodeFailed),
                    false => (b == ':').match({
                        true  => {
                            self.trailer_has_bytes
                                .ensure(HttpError.DecodeFailed).try();
                            self.trailer_has_colon = true;
                            Ok(())
                        },
                        false => b.field_name_byte()
                            .ensure(HttpError.DecodeFailed),
                    }),
                }).try();
                self.trailer_has_bytes = true;
                Ok(())
            },
        })
    }

    trailer_lf = (self :: @Self, b: u8) Res<(), HttpError> {
        (b == '\n').ensure(HttpError.DecodeFailed).try();
        self.trailer_has_bytes = false;
        self.trailer_has_colon = false;
        self.phase             = ChunkPhase.Trailer;
        Ok(())
    }

    expect = (self :: @Self, got: u8, want: u8, next: ChunkPhase)
             Res<(), HttpError> {
        (got == want).ensure(HttpError.DecodeFailed).try();
        self.phase = next;
        Ok(())
    }

    finish = (self: @Self) Res<(), HttpError> {
        self.done().ensure(HttpError.DecodeFailed)
    }
}

// One response body after its headers have been decoded.
ResponseBody = {
    a:          Alloc,
    framing:    BodyFraming,
    prefetched: str,

    into = (self: @Self, s: Stream, out :: Sink) Res<(), HttpError> {
        self.framing.match({
            BodyNone      => Ok(()),
            BodyChunked   => self.chunked(s, out),
            BodyLength(n) => self.known_length(s, n, out),
            BodyClose     => self.until_eof(s, out),
        })
    }

    chunked = (self: @Self, s: Stream, out :: Sink)
              Res<(), HttpError> {
        dec ::= ChunkDecoder();
        dec.feed(self.prefetched, out).try();
        chunk ::= self.a.Vec<u8>();
        loop((h) {
            dec.done().then(() { h.break(); });
            got = s.read(chunk, 4096).try((e) { e.http_error() });
            (got > 0).ensure(HttpError.RecvFailed).try();
            dec.feed(str_at(chunk.ptr(), got), out).try();
        });
        dec.finish()
    }

    known_length = (self: @Self, s: Stream, n: usize, out :: Sink)
                   Res<(), HttpError> {
        take = (n < self.prefetched.len).match({
            true  => n,
            false => self.prefetched.len,
        });
        out.write_body(self.prefetched.slice(0, take)).try();
        self.read_exact(s, n - take, out)
    }

    read_exact = (self: @Self, s: Stream, n: usize, out :: Sink)
                 Res<(), HttpError> {
        left  ::= n;
        chunk ::= self.a.Vec<u8>();
        loop((h) {
            (left == 0).then(() { h.break(); });
            ask = (left < 4096).match({ true => left, false => 4096 });
            got = s.read(chunk, ask).try((e) { e.http_error() });
            (got > 0).ensure(HttpError.RecvFailed).try();
            out.write_body(str_at(chunk.ptr(), got)).try();
            left = left - got;
        });
        Ok(())
    }

    until_eof = (self: @Self, s: Stream, out :: Sink)
                Res<(), HttpError> {
        out.write_body(self.prefetched).try();
        chunk ::= self.a.Vec<u8>();
        loop((h) {
            got = s.read_eof(chunk, 4096).try();
            (got == 0).then(() { h.break(); });
            out.write_body(str_at(chunk.ptr(), got)).try();
        });
        Ok(())
    }
}

// The head is bounded by HTTP_HEAD_MAX; body bytes are never accumulated,
// each chunk is written to `out` before the next read.
read_response_into* = (s: Stream, a: Alloc, out :: Sink)
                      Res<HttpResponseMeta, HttpError> {
    head ::= a.String().try(HttpError.RecvFailed);

    end: Res<usize> ::= None;
    chunk           ::= a.Vec<u8>();
    loop((h) {
        end.match({ Ok(_) => h.break(), None => () });
        got = s.read(chunk, 4096).try((e) { e.http_error() });
        (got > 0).ensure(HttpError.RecvFailed).try();
        head.add(str_at(chunk.ptr(), got)).try(HttpError.RecvFailed);
        head.view().find(HEADER_END).match({
            Ok(at) => {
                (at + HEADER_END.len <= HTTP_HEAD_MAX)
                    .ensure(HttpError.DecodeFailed).try();
                end = Ok(at);
            },
            None   => (head.view().len <= HTTP_HEAD_MAX)
                .ensure(HttpError.DecodeFailed).try(),
        });
    });

    at    = end.ok_or(HttpError.DecodeFailed).try();
    parts = head.view().parts_at(at).try();
    ResponseBody(a: a, framing: parts.head.framing, prefetched: parts.body).into(s, out).try();
    Ok(parts.head.meta)
}

// Offline twin of the network path: metadata plus the same Sink/error
// contract, without allocating a second body buffer.
parse_response_into* = (raw: str, out :: Sink)
                       Res<HttpResponseMeta, HttpError> {
    parts = raw.response_parts().try();
    parts.head.framing.match({
        BodyNone      => Ok(()),
        BodyChunked   => {
            dec ::= ChunkDecoder();
            dec.feed(parts.body, out).try();
            dec.finish()
        },
        BodyLength(n) => {
            (parts.body.len >= n).ensure(HttpError.DecodeFailed).try();
            out.write_body(parts.body.slice(0, n))
        },
        BodyClose     => out.write_body(parts.body),
    }).try();
    Ok(parts.head.meta)
}

// Buffered response parser over the streaming sink API.
parse_response* = (raw: str, a: Alloc) Res<HttpResponse, HttpError> {
    body ::= a.String().try(HttpError.RecvFailed);
    meta = raw.parse_response_into(body).try();
    Ok(HttpResponse(status: meta.status, body: body));
}
