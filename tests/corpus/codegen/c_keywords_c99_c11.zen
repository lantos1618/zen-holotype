// C keyword collisions, part 2 of 3: the 12 keywords C99 and C11 added.
//
// these are the ones a mangler written from memory misses, because they
// arrived after the list everybody memorised. `restrict` and `inline` look
// like ordinary words; the `_Uppercase` forms look like they could not
// possibly be user identifiers, which is exactly why nobody guards them.
//
// note that every `_Uppercase` name here is ALSO reserved to the C
// implementation for any use (C11 §7.1.3), so a mangler that handles the
// reserved-identifier class handles these for free — and a mangler that
// special-cases keywords one by one does not. see c_reserved_identifiers.zen.

main = (env: Env) Res<i32, AllocError> {
    _Alignas       = 1;
    _Alignof       = 2;
    _Atomic        = 3;
    _Bool          = 4;
    _Complex       = 5;
    _Generic       = 6;
    _Imaginary     = 7;
    _Noreturn      = 8;
    _Static_assert = 9;
    _Thread_local  = 10;
    inline         = 11;
    restrict       = 12;

    sum ::= 0;
    sum = sum + _Alignas;
    sum = sum + _Alignof;
    sum = sum + _Atomic;
    sum = sum + _Bool;
    sum = sum + _Complex;
    sum = sum + _Generic;
    sum = sum + _Imaginary;
    sum = sum + _Noreturn;
    sum = sum + _Static_assert;
    sum = sum + _Thread_local;
    sum = sum + inline;
    sum = sum + restrict;

    println("c99c11 {}", sum);
    Ok(0);
}
