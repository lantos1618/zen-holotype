// Writes flat document symbols from declarations in the open buffer.

str, String = std.text
Vec = std.collections
Alloc, AllocError = std.mem
Decl, Span, Ident = std.ast
TextRange, text_range = lsp.lsp_pos
parse_standalone = lsp.lsp_query
arr, Nest, to_json = std.json

SymbolKind* = | Class = 5 // LSP has no type-alias symbol kind.
    | Enum = 10
    | Function = 12
    | Constant = 14
    | Struct = 23

Sym* = {
    name*: str,
    kind*: SymbolKind,
    span*: Span,
    name_span*: Span,

    write = (self: @Self, a: Alloc, uri: str, text: str, list :: Nest,
             out :: String) Res<(), AllocError> {
        list.next(out).try();
        encoded ::= SymbolInformation(name: self.name, kind: self.kind.discriminant(), location: SymbolLocation(uri: uri, range: text_range(text, self.span)), selectionRange: text_range(text, self.name_span)).to_json(a).try();
        out.add(encoded.view())
    }
}

SymbolLocation = {
    uri: str,
    range: TextRange,
}

SymbolInformation = {
    name: str,
    kind: u64,
    location: SymbolLocation,
    selectionRange: TextRange,
}

symbols_at* = (a: Alloc, text: str) Res<Vec<Sym>, AllocError> {
    p ::= parse_standalone(a, "doc", text).try();
    m = p.module("doc").try();
    symbols ::= a.Vec<Sym>();
    m.decls.loop((decl) {
        decl.symbol().match({
            Ok(symbol) => symbols.add(symbol).try(),
            None       => (),
        });
    });
    Ok(symbols)
}

symbol = (self: Decl) Res<Sym> {
    self.kind.match({
        Function(f) => f.name.symbol(SymbolKind.Function, self.span),
        Struct(s)   => s.name.symbol(SymbolKind.Struct, self.span),
        Enum(e)     => e.name.symbol(SymbolKind.Enum, self.span),
        Alias(x)    => x.name.symbol(SymbolKind.Class, self.span),
        Const(k)    => k.name.symbol(SymbolKind.Constant, self.span),
        _           => None,
    })
}

// A declaration whose name the parser has not settled yet has no symbol.
symbol = (self: Ident, kind: SymbolKind, span: Span) Res<Sym> {
    (self.text.len > 0).ensure().try();
    Ok(Sym(name: self.text, kind: kind, span: span, name_span: self.span))
}

write_symbols* = (a: Alloc, uri: str, text: str, syms: Vec<Sym>, out :: String)
                 Res<(), AllocError> {
    list ::= arr(out).try();
    syms.loop((symbol) { symbol.write(a, uri, text, list, out).try(); });
    list.close(out)
}
