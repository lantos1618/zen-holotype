// Token arrives twice, by two paths. one module defines it, so the
// two imports must not collide and alpha's Token IS beta's Token
//
// EACH ARM IS SEPARATELY OBSERVABLE, which is what a diamond test owes:
// `token_tagged` is declared in alpha and `token_twice` in beta, and ONE
// value built once is handed to both. An arm that was never reached
// cannot answer, and a Token that is two types cannot be passed down
// both -- while the numbers, 5 and 21 in and 521 and 42 out, come from
// no field a compiler could have zeroed or swapped.
Token, token_id, token_tagged = alpha.alpha
Token, token_twice = beta.beta

main = (env: Env) Res<i32, IoError> {
    t = Token(id: 21, tag: 5);
    println("{}", t.token_id());
    println("{}", t.token_twice());
    println("{}", t.token_tagged());
    Ok(0);
}
