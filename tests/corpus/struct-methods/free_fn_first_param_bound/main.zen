// THE FREE FUNCTION'S FIRST PARAMETER DECLARES A BOUND, and the receiver
// is the concrete type that impls it: `alloc.boxed(7)` on an `Arena`,
// exactly the shape every program in the language opens with -- DESIGN.md's
// own `Vec* = <T>(a: Alloc) Vec<T>` called as `alloc.Vec<i32>()`.
//
// "every exported free function whose first parameter type is `x`'s type"
// has to mean what it means for every other parameter: an impl of the
// bound counts. The wrong reading matches declared types literally, finds
// no `boxed` on `Arena`, and answers "no `boxed` on `Arena`" -- a
// diagnostic that would make the prelude itself uncallable, since nothing
// anywhere constructs a Vec by naming an Arena.
//
// Only the type travels here: `boxed` sits beside Box in box.zen and no
// import names it. And the pool must still filter -- `labelled` shares the
// name-and-arity shape but declares a `str` first, so it must stay out of
// an Arena's candidates.
//
// Breaks if: first-parameter matching stops at exact (declared) types --
// `b = alloc.boxed(7)` rejects with "no `boxed` on `Arena`".

Box = box.box

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    b = alloc.boxed(7);
    println("{}", b.n);
    println("{}", b.twice());
    Ok(0);
}
