// THE CHECK RUNS PER LOAD, ON THE ITERATION'S OWN INDEX. A loop walking
// Range(0, 6) over a length of 4 prints three values and traps when the
// index reaches 4 -- not four values, and not a check hoisted out of the
// loop that clears the whole walk because index 0 was fine.
//
// Range's half-open end is what makes asking for 6 legal while touching
// 4 is fatal; the two boundaries are different expressions and a backend
// that confuses them fails this differently than it fails an at-len
// literal, which is why both exist. What stdout holds is exactly the
// in-range prefix, in order, then nothing: the abort cuts the loop
// before its fifth iteration can print.

// a trap never lifts into Res: it aborts the process
Error = Overflow | DivideByZero | OutOfBounds

main = (env: Env) Res<i32, Error> {
    primes = [i32, 4](2, 3, 5, 7);
    Range(0, 6).loop((h, i) {
        println("{}", primes[i]);
    });
    println("unreachable");
    Ok(0);
}
