Link = {
    value: i64,
    next: Ptr<Link>,
}

// the recursive builder allocates through a helper whose Res was
// already unwrapped by ITS caller -- create is called exactly once,
// in main.
build = (cell: Ptr<Link>, n: i64) Link {
    (n <= 0).match({
        true  => Link(value: 1000, next: null_ptr<Link>()),
        false => {
            rest = build(cell, n - 1);
            cell.write(0, Link(value: n * 10, next: null_ptr<Link>()));
            Link(value: n * 10, next: cell);
        },
    });
}

main = (env: Env) Res<i32, AllocError> {
    Ok(0);
}

noop = () i64 { 7 }
