// THE FILE ON DISK. The test's buffer (opened over this URI) is a
// different text — the same file plus an undefined `Bag` — because the
// overlay, not these bytes, is what the server checks. If the overlay
// is ever ignored, no diagnostic means no quickfix and `main.expected`
// goes red on the first row.
Point = app.shape

near = (p: Point) i32 { p.x }
