// std.text.ascii -- ASCII char-class predicates and hex-nibble helpers shared by the lexer,
// resolver, and parsers.
//
// These are intentionally tiny and allocation-free. A `str` is a NUL-terminated
// byte pointer, so `at` is just raw indexed byte access; the class predicates
// are ASCII source/text classes, not Unicode.
{ AllocatorBackend } = std.mem.alloc
{ step_while } = std.core.count    // THE loop — `@while` lives in the primitive, not here
at* = (s: StringView, i: i32) u8 { s.offset(i).load() }
is_digit* = (b: u8) bool { b >= '0' && b <= '9' }
is_hex* = (b: u8) bool { b.is_digit() || b >= 'a' && b <= 'f' || b >= 'A' && b <= 'F' }
is_bin* = (b: u8) bool { b == '0' || b == '1' }
is_oct* = (b: u8) bool { b >= '0' && b <= '7' }
is_alpha* = (b: u8) bool { b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z' || b == '_' }
is_alnum* = (b: u8) bool { b.is_alpha() || b.is_digit() }
is_upper* = (b: u8) bool { b >= 'A' && b <= 'Z' }    // Uppercase = a type/variant name's first byte
is_space* = (b: u8) bool { b == ' ' || b == '\t' || b == '\n' || b == '\r' }
// intra-LINE whitespace only: a scanner walking one line (a diagnostic's marker field, an import
// line) must NOT step over the '\n' that ends it, so it asks is_blank, never is_space.
is_blank* = (b: u8) bool { b == ' ' || b == '\t' }
// the 'A'..'Z' / 'a'..'z' case shift; non-letters pass through. ASCII-ONLY (bytes 0x80+ untouched).
// The BYTE fold, shared by std.text.str's copying `to_lower`/`to_upper` and std.net.http's
// case-insensitive header names — a char class, so it lives with the char classes.
to_ascii_lower* = (b: u8) u8 { (b >= 'A' && b <= 'Z').then({ b + ('a' - 'A') }, { b }) }
to_ascii_upper* = (b: u8) u8 { (b >= 'a' && b <= 'z').then({ b - ('a' - 'A') }, { b }) }
// ── source-text openers (2–3 byte lookahead at a byte offset) ────────────────────────
// `//`, `/*` and `"""`. Every textual pass over Zen source asks the same question at a byte
// offset — the lexer's whitespace skip, the resolver's flatten / visibility scans, the formatter's
// raw-literal guard — so the openers live here beside the char classes, not once per scanner.
line_comment_at* = (s: StringView, p: i32) bool { s.at(p) == '/' && s.at(p + 1) == '/' }
block_comment_at* = (s: StringView, p: i32) bool { s.at(p) == '/' && s.at(p + 1) == '*' }
rawstr_at* = (s: StringView, p: i32) bool {
    s.at(p) == '"' && s.at(p + 1) == '"' && s.at(p + 2) == '"'
}
// nibble value (0..15) -> its LOWERCASE hex byte (`0`-`9`, `a`-`f`). The hex-ENCODE nibble, shared by
// the encoders in std.encoding / std.json.
hex_char* = (v: i64) u8 {
    (v < 10).then({ ('0'.to_i64() + v).to_u8() }, { ('a'.to_i64() + v - 10).to_u8() })
}
// hex byte -> its nibble value (0..15), or -1 for a non-hex byte. Accepts both cases on input.
// The hex-DECODE nibble, shared by the decoders in std.format.{json,encoding} / std.net.http. Named
// `hex_nibble` (NOT `hex_val`) on purpose: the compiler's parse_expr.zen defines its own `hex_val`
// with an i32 return, and std.text.ascii is in the compiler's own import closure, so a same-named
// helper here would be dedup'd against parse_expr's copy under the flat namespace.
hex_nibble* = (b: u8) i64 {
    (b >= '0' && b <= '9').match ({
        true  => (b - '0').to_i64(),
        false => (b >= 'a' && b <= 'f').match ({
            true  => (b - 'a').to_i64() + 10,
            false => (b >= 'A' && b <= 'F').then({ (b - 'A').to_i64() + 10 }, { 0 - 1 }),
        }),
    })
}
// ── shared escape mechanism ───────────────────────────────────────────────────
// The scan-and-emit loop every string-literal escaper shares: walk the NUL-terminated bytes of `v`
// and fold each through `esc`. The per-target escape TABLES (C's `\ooo` octal, JS's short escapes,
// the formatter's `\xNN`) differ by design and stay at their call sites — only the loop shape lives
// here. `esc` is an FnT param, so each call site splices its own table at monomorphization time
// (zero runtime dispatch); `S` is the accumulator (a string builder — kept generic so this file
// stays import-free) and `A` the allocator threaded through it. Used by the C backend (gen_strlit),
// the JS backend (jstrlit), and the formatter (ff_strlit). std.format.{json,serde} do NOT use it,
// deliberately: json's write_str_lit is run-copy (bulk-appends runs of pass-through bytes, a
// different loop shape), and serde's jw_str folds an error-carrying JwSt state, not a builder.
escape_into*<S, A: AllocatorBackend> = (
    s: S,
    a: MutPtr<A>,
    v: StringView,
    esc: (S, MutPtr<A>, u8) S,
) S {
    acc ::= s
    zero: i32 = 0
    zero.step_while((k) { at(v, k) != 0 }, (k) {
        acc = esc(acc, a, at(v, k))
        k + 1
    })
    acc
}    // ITERATIVE: a ~50KB string literal escapes O(n) by iteration, not O(n) C-stack recursion
