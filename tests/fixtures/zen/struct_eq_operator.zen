// Struct `==` / `!=`: values of the same struct type compare STRUCTURALLY. An `eq` method provided
// by an impl on the type WINS (resolve dispatch); otherwise the resolver derives a per-field `==`
// fold via reflection — string fields ride __str_eq, enum fields tag-compare, struct fields recurse.
// Non-Var operands are bound once (a side-effecting operand runs once, not per field).
// Exit 0 = every case matched expectation.
Point: {
    x: i64,
    y: i64,
}
Rect: {
    a: Point,
    b: Point,
}
Name: {
    first: string_view,
    last: string_view,
}
Box<T>: {
    v: T,
    w: T,
}
// impl override: equality that deliberately IGNORES `note` — proves the impl wins over the fold.
EqOps*: {
    eq: (Self, Self) bool,
}
Tagged: {
    id: i64,
    note: string_view,
}
Tagged.impl(EqOps, {
    eq = (a: Tagged, b: Tagged) bool { a.id == b.id }
})
mk_count = (c: MutPtr<i64>) Point {
    store(c, load(c) + 1)
    Point(
        x: 1,
        y: 2,
    )
}
main = () i32 {
    p := Point(
        x: 3,
        y: 4,
    )
    q := Point(
        x: 3,
        y: 4,
    )
    r := Point(
        x: 3,
        y: 9,
    )
    // derived ==/!= on flat scalar struct
    (p == q == false).then({
        return 1
    })
    (p != r == false).then({
        return 2
    })
    // string fields ride __str_eq
    (Name(
        first: "ada",
        last: "byron",
    ) == Name(
        first: "ada",
        last: "byron",
    ) == false).then({
        return 3
    })
    // nested struct fields recurse
    r1 := Rect(
        a: p,
        b: q,
    )
    r2 := Rect(
        a: p,
        b: r,
    )
    (r1 == r1 == false).then({
        return 4
    })
    (r1 != r2 == false).then({
        return 5
    })
    // generic struct instance
    (Box<i64>(
        v: 5,
        w: 6,
    ) == Box<i64>(
        v: 5,
        w: 6,
    ) == false).then({
        return 6
    })
    // impl override: same id, different note — impl says EQUAL
    t1 := Tagged(
        id: 7,
        note: "alpha",
    )
    t2 := Tagged(
        id: 7,
        note: "beta",
    )
    (t1 == t2 == false).then({
        return 7
    })
    // side-effecting operand evaluated ONCE
    n: i64 := 0
    (mk_count(n.addr()) == mk_count(n.addr()) == false).then({
        return 8
    })
    (n == 2 == false).then({
        return 9
    })
    0
}
