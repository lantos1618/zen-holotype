// AN ARRAY-LITERAL ELEMENT OF ANOTHER TYPE OWES THE SLOT ITS TYPE. A
// literal mints its own type from its FIRST element (`[0, v]` is an
// `[int, 2]`), and `array_assignable` grants that every array of its
// length, so the `i16` in slot one was computed and thrown away --
// until the store narrowed it to 255, a plausible wrong answer nothing
// reported. The scalar twin (`a: u8 = v`) was always refused; only the
// array hid it.
//
// element zero is deliberately a literal that FITS: had it been the bad
// element, `[u8, 2]` vs `[i16, 2]` would be refused by
// `array_assignable` itself and this file would pin the wrong gate.
// The interesting case is the one where the minted type is already
// right and only the later element disagrees.

main = (env: Env) Res<i32, AllocError> {
    v: i16 = i16.MAX;
    xs: [u8, 2] = [0, v];
    println("{}", xs[1].to_i64());
    Ok(0);
}
