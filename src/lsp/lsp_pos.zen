// Converts between Zen's 1-based byte columns and LSP's 0-based UTF-16
// positions. Out-of-range positions clamp to valid line boundaries.

str, String = std.text
Range = std.core
Alloc, AllocError = std.mem
Pos, Span = std.ast.ast_span
codepoint_at, UTF8_MIN_4 = std.text.text_utf8
to_json = std.json

WirePos* = {
    line*: usize,
    character*: usize,
}

// JSON-owned protocol shape shared by every response that carries a range.
// Keeping this distinct from the parser's byte-oriented Span prevents wire
// encoding details from leaking into each response writer.
WireRange* = {
    start*: WirePos,
    end*: WirePos,
}

LineRun* = {
    start*: usize,
    end*: usize,
}

run_of* = (text: str, line: usize) LineRun {
    at   ::= 0;
    seen ::= 0;
    done ::= line == 0;
    (!done).then(() {
        Range(0, text.len).loop((h, i) {
            (!done && text.index(i) == '\n').then(() {
                seen = seen + 1;
                at   = i + 1;
                (seen == line).then(() { done = true; h.break(); });
            });
        });
    });
    (seen < line).match({
        true  => LineRun(start: text.len, end: text.len),
        false => LineRun(start: at, end: end_of(text, at)),
    })
}

end_of = (text: str, from: usize) usize {
    Range(from, text.len).find((i) { text.index(i) == '\n' }).match({
        Ok(i) => i,
        None  => text.len,
    })
}

Step* = {
    units*: usize,
    bytes*: usize,
}

step_at* = (text: str, at: usize) Step {
    text.codepoint_at(at).match({
        Err(_) => Step(units: 1, bytes: 1),
        Ok(c)  => (c.value < UTF8_MIN_4).match({
            true  => Step(units: 1, bytes: c.len),
            false => Step(units: 2, bytes: c.len),
        }),
    })
}

to_pos* = (text: str, line: usize, character: usize) Pos {
    run = run_of(text, line);
    at    ::= run.start;
    units ::= 0;
    done  ::= false;
    loop(() { !done && at < run.end && units < character }, (h) {
        step = step_at(text, at);
        ((units + step.units) > character).match({
            true  => { done = true; },
            false => { at = at + step.bytes; units = units + step.units; },
        });
    });
    Pos(line: line + 1, col: at - run.start + 1);
}

to_wire* = (text: str, p: Pos) WirePos {
    line   = (p.line == 0).match({ true => 0, false => p.line - 1 });
    run    = run_of(text, line);
    target = target_of(run, p.col);
    at    ::= run.start;
    units ::= 0;
    done  ::= false;
    loop(() { !done && at < target }, (h) {
        step = step_at(text, at);
        ((at + step.bytes) > target).match({
            true  => { done = true; },
            false => { at = at + step.bytes; units = units + step.units; },
        });
    });
    WirePos(line: line, character: units);
}

wire_at* = (text: str, line: usize, col: usize) WirePos {
    to_wire(text, Pos(line: line, col: col))
}

wire_range* = (text: str, span: Span) WireRange {
    WireRange(start: to_wire(text, span.start), end: to_wire(text, span.end))
}

whole_range* = (text: str) WireRange {
    WireRange(
        start: WirePos(line: 0, character: 0),
        end: WirePos(line: past_last_line(text), character: 0)
    )
}

units_of* = (text: str, from: usize, upto: usize) usize {
    at    ::= from;
    units ::= 0;
    loop(at < upto, (h) {
        step  = step_at(text, at);
        at    = at + step.bytes;
        units = units + step.units;
    });
    units;
}

target_of = (run: LineRun, col: usize) usize {
    at = (col == 0).match({ true => run.start, false => run.start + col - 1 });
    (at > run.end).match({ true => run.end, false => at })
}

write_wire* = (a: Alloc, p: WirePos, out :: String) Res<(), AllocError> {
    encoded ::= p.to_json(a).try();
    out.add(encoded.view())
}

write_whole* = (a: Alloc, text: str, out :: String) Res<(), AllocError> {
    encoded ::= whole_range(text).to_json(a).try();
    out.add(encoded.view())
}

past_last_line = (text: str) usize {
    n ::= 1;
    Range(0, text.len).loop((h, i) {
        (text.index(i) == '\n').then(() { n = n + 1; });
    });
    n;
}

write_range* = (a: Alloc, text: str, span: Span, out :: String)
              Res<(), AllocError> {
    encoded ::= wire_range(text, span).to_json(a).try();
    out.add(encoded.view())
}
