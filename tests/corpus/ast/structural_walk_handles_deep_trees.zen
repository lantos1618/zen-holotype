scan, Source = std.lex
Parser, module = std.parse
WalkNode, WalkEvent, WalkVisitor, DeclVisit, DeclSite, DeclParent = std.ast

FailAt = {
    base: Alloc,
    calls: Ptr<usize>,
    fail: usize,

    accepts = (self: @Self) bool {
        index = self.calls.read(0);
        self.calls.write(0, index + 1);
        index != self.fail
    }
}

FailAt.impl(Alloc, {
    raw = (self: @Self, size: usize, align: usize) Res<Ptr<u8>, AllocError> {
        self.accepts().ensure(AllocError.OutOfMemory).try();
        self.base.raw(size, align)
    }
    realloc = <T>(self: @Self, ptr: Ptr<T>, count: usize) Res<Ptr<T>, AllocError> {
        self.accepts().ensure(AllocError.OutOfMemory).try();
        self.base.realloc(ptr, count)
    }
})

Trace = {
    entered :: usize = 0,
    left :: usize = 0,
    depth :: usize = 0,
    peak :: usize = 0,
    stop: usize,
}
Trace.impl(WalkVisitor, {
    visit = (self :: @Self, event: WalkEvent) Res<(), AllocError> {
        event.match({
            Enter(_) => {
                self.entered = self.entered + 1;
                self.depth   = self.depth + 1;
                (self.depth > self.peak).then(() { self.peak = self.depth; });
            },
            Leave(_) => { self.left = self.left + 1; self.depth = self.depth - 1; },
        });
        (self.entered + self.left < self.stop).ensure(
            AllocError.OutOfMemory
        ).try();
        Ok(())
    }
})

main = (env: Env) Res<(), AllocError> {
    a = env.mem.alloc();
    source ::= a.String("main = () i32 { 1").try();
    Range(1, 10000).loop((index) { source.add(" + 1").try(); });
    source.add(" }").try();
    lexed = scan(a, Source(file: "deep.zen", text: source.view())).try();
    parser ::= a.Parser(lexed);
    parsed      = parser.module("deep").try();
    declaration = parsed.decls.get(0).ok_or(AllocError.OutOfMemory).try();
    root        = WalkNode.Declaration(DeclVisit(
        site: DeclSite(parent: DeclParent.Module(0), index: 0),
        value: declaration
    ));
    trace ::= Trace(stop: usize.MAX);
    calls ::= a.Vec<usize>();
    calls.add(0).try();
    parser.tree.walk(
        FailAt(base: a, calls: calls.ptr(), fail: usize.MAX),
        root,
        trace
    ).try();
    total = calls.ptr().read(0);
    println("parsed {}", lexed.diags.len == 0 && parser.diags.len == 0);
    println(
        "deep {} balanced {} visits {}",
        trace.peak > 10000,
        trace.depth == 0 && trace.entered == trace.left,
        trace.entered + trace.left
    );
    refused ::= total > 0;
    Range(0, total).loop((index) {
        calls.ptr().write(0, 0);
        observer ::= Trace(stop: usize.MAX);
        result  = parser.tree.walk(
            FailAt(base: a, calls: calls.ptr(), fail: index),
            root,
            observer
        );
        refused = refused && result.match({ Err(_) => true, Ok(_) => false });
    });
    println("allocation failures {}", refused);
    observer ::= Trace(stop: 17);
    result = parser.tree.walk(a, root, observer);
    println(
        "visitor stops {}",
        result.match({ Err(_) => true, Ok(_) => false }) && observer.entered + observer.left == 17
    );
    Ok(())
}
