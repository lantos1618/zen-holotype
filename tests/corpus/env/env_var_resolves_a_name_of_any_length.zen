// The runner exports names of 5039 `V` bytes and 4096 `B` bytes for this
// test. Both must resolve, while an unset name remains distinguishable.
main = (env: Env) Res<i32, IoError> {
    over = env.var(
        ""
    ).match({
        Ok(_) => "5039 present",
        None  => "5039 absent",
    });
    println("{}", over);
    at = env.var(
        ""
    ).match({
        Ok(_) => "4096 present",
        None  => "4096 absent",
    });
    println("{}", at);
    env.var("ZEN_NO_SUCH_VARIABLE_EXISTS_ANYWHERE").match({
        Ok(_) => println("the absent name is somehow set"),
        None  => println("the absent name is absent"),
    });
    Ok(0);
}
