// Map.get returns Res<i32> -- the None form. .try() into a function
// returning Res<i32, Error> would have to invent a reason, and a reason
// is never invented. `.ok_or(..)` is the required form:
// corpus/sema/ok_or_try. DESIGN.md, Errors.
//
// position: the .try() call.

LookupError = NotFound | Malformed

Error = LookupError | AllocError

main = (env: Env) Res<i32, Error> {
    alloc ::= env.mem.alloc();
    ages ::= alloc.Map<str, i32>();
    ages.set("ada", 36).try();

    age = ages.get("ada").try();
    println("{}", age);
    Ok(0);
}
