// tests/corpus/std/loop_break_without_value.zen
// h.break() with no argument: the loop evaluates to None. same
// non-local exit, no value carried out

main = (env: Env) Res<i32, AllocError> {
    Range(0, 10).loop((h, value) {
        println("{}", value);
        (value == 2).then(() { h.break() });
    });
    println("after");
    Ok(0);
}
