// Writes flat document symbols from declarations in the open buffer.

str, String = std.text
Vec = std.collections
Alloc, AllocError = std.mem
scan, Source = std.lex
Parser = std.parse
Ast, Module, Decl, Span, Ident = std.ast
WireRange, wire_range = lsp.lsp_pos
written, arr, Nest, to_json = std.json

Sym* = {
    name*: str,
    kind*: usize,
    span*: Span,
    name_span*: Span,
}

SymbolLocation = {
    uri: str,
    range: WireRange,
}

SymbolInformation = {
    name: str,
    kind: usize,
    location: SymbolLocation,
    selectionRange: WireRange,
}

CLASS*: usize = 5        // LSP has no type-alias symbol kind.
ENUM*: usize = 10
FUNCTION*: usize = 12
CONSTANT*: usize = 14
STRUCT*: usize = 23

symbols_at* = (a: Alloc, text: str, out :: Vec<Sym>) Res<(), AllocError> {
    tree ::= a.Ast();
    lexed = scan(a, Source(file: "doc", text: text)).try();
    p ::= a.Parser(lexed, tree);
    m = p.module("doc").try();
    module_syms(m, out)
}

module_syms = (m: Module, out :: Vec<Sym>) Res<(), AllocError> {
    m.decls.loop((h, d) { decl_sym(d, out).try(); });
    Ok(());
}

decl_sym = (d: Decl, out :: Vec<Sym>) Res<(), AllocError> {
    d.kind.match({
        Function(f) => add_sym(out, f.name, FUNCTION, d.span),
        Struct(s)   => add_sym(out, s.name, STRUCT, d.span),
        Enum(e)     => add_sym(out, e.name, ENUM, d.span),
        Alias(x)    => add_sym(out, x.name, CLASS, d.span),
        Const(k)    => add_sym(out, k.name, CONSTANT, d.span),
        _           => written(),
    })
}

add_sym = (out :: Vec<Sym>, id: Ident, kind: usize, span: Span)
        Res<(), AllocError> {
    (id.text.len > 0).then(() {
        out.add(Sym(
            name: id.text,
            kind: kind,
            span: span,
            name_span: id.span
        )).try();
    });
    Ok(())
}

write_symbols* = (a: Alloc, uri: str, text: str, syms: Vec<Sym>, out :: String)
                 Res<(), AllocError> {
    list ::= arr(out).try();
    syms.loop((h, s) { write_sym(a, s, uri, text, list, out).try(); });
    list.close(out)
}

write_sym = (a: Alloc, s: Sym, uri: str, text: str, list :: Nest, out :: String)
            Res<(), AllocError> {
    list.next(out).try();
    encoded ::= SymbolInformation(name: s.name, kind: s.kind, location: SymbolLocation(uri: uri, range: wire_range(text, s.span)), selectionRange: wire_range(text, s.name_span)).to_json(a).try();
    out.add(encoded.view())
}
