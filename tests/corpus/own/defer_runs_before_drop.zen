// two orderings in one program, both from DESIGN.md: defers run LIFO,
// and ALL of them run before ANY drop.
//
// registration order is a, one, b, two; the output is two, one (LIFO
// over the block's stack of closures), then drop b, drop a (reverse
// declaration). a defer registered after a binding still runs first —
// they are two stacks, not one interleaved one.

Noisy = {
    env: Env,
    tag: str,
}

Noisy.impl(Drop, {
    drop = (self :: @Self) () { self.env.out.println("drop {}", self.tag) }
})

main = (env: Env) Res<i32, IoError> {
    a = Noisy(env: env, tag: "a");
    @scope.defer(() { println("defer one") });
    b = Noisy(env: env, tag: "b");
    @scope.defer(() { println("defer two") });
    println("body");
    Ok(0);
}
