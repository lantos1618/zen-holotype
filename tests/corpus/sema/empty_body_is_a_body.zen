// A body with no statements and no value is still a body. Asking the
// block for its last statement without asking first whether it HAS one
// computes `stmts.len - 1` on a `usize` zero, and unsigned underflow is
// a trap this compiler aborts on -- so `nothing = () () { }` did not
// compile to nothing, it killed the compiler with `trap: integer
// overflow` inside sema.
//
// The `;`-terminated print below is the other half of the same rule: a
// last statement that yields nothing is a statement, not the value
// `main` returns, so it does not have to fit `Res<i32, CfgError>`.

CfgError = Missing | Bad

nothing = () () { }

main = (env: Env) Res<i32, CfgError> {
    nothing();
    println("empty body compiled");
    Ok(0);
}
