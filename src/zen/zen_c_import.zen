// Canonical driver-side representation of one build C-import request.
// It is formed after build.zen runs and before the synthetic module enters
// sema. Identity includes the normalized target and ordered import inputs.

Alloc, AllocError = std.mem
str, String = std.text
Vec = std.collections
Target, CImport = std.build
Ast, Module, CHeader, CTypeBinding, CBinding, CBindingId = std.ast

CImportRequest* = {
    spec*: CImport,
    identity*: String,

    attach_module* = (
        self : @Self,
        a    : Alloc,
        node : Module,
        tree :: Ast,
    ) Res<CImportModule, AllocError> {
        headers ::= a.Vec<CHeader>();
        self.spec.headers.loop((h, path) {
            headers.add(CHeader(path: path, system: true)).try();
        });
        types   = a.Vec<CTypeBinding>();
        module  = tree.module_count();
        binding = tree.add_c_module(
            node,
            CBinding(headers: headers, types: types)
        ).try();
        Ok(CImportModule(module: module, binding: binding))
    }
}

// The two stable coordinates the loader needs after inserting a synthetic
// binding module. World already identifies modules by their Ast index.
CImportModule* = {
    module*: usize,
    binding*: CBindingId,
}

request* = (a: Alloc, spec: CImport) Res<CImportRequest, AllocError> {
    out ::= a.String("c-import-v1|").try();
    out.add_target(spec.target).try();
    out.add_list("headers", spec.headers).try();
    out.add_list("include-paths", spec.include_paths).try();
    out.add_list("defines", spec.defines).try();
    out.add_list("libraries", spec.libraries).try();
    Ok(CImportRequest(spec: spec, identity: out))
}

add_target = (out :: String, selected: Target) Res<(), AllocError> {
    out.fmt(
        "target-v1|{}|{}|{}|",
        selected.os.stable_name(),
        selected.arch.stable_name(),
        selected.abi.stable_name()
    )
}

add_list = (out :: String, name: str, values: Vec<str>)
           Res<(), AllocError> {
    out.fmt("{}:{}|", name, values.len).try();
    values.loop((h, value) { out.fmt("{}:{}|", value.len, value).try() });
    Ok(())
}
