// @self-hosted-only
// Stdout output. Direct numeric paths stream; format/formatln use canonical String interpolation.
{ AllocatorBackend, heap_allocator } = std.mem.alloc
{ out_bytes } = std.io.file
{ view, at } = std.text.str
{ String, StringArg, string_arg, string, add_format } = std.text.string
{ integer_in, float_in } = std.text.num
{ f64_special, num_write_integer, num_write_udigits, num_uwrite_udigits, num_write_fpad,
  num_write_zeros, num_fexp, num_fsig, num_fstrip, num_fndig, num_fpow10i } = std.text.num_render
{ Result, IoError, ok, err, or, panic } = std.core.result
{ alloc } = std.mem.raw
{ is_null } = std.core.ptr
Display*: {
    fmt_print: (self: Self) i64,
    fmt_println: (self: Self) i64,
}
// Print an owned temporary String and release its buffer.
print_owned_in = (a: AllocatorBackend, t: String) i64 {
    w = out_bytes(t.bytes()).or(0)
    t.free_in(a)
    w
}
write_text = (s: StringView) i64 { out_bytes(s.view()).or(0) }
newline = () i64 { "\n".write_text() }
write_string = (s: String) i64 { out_bytes(s.bytes()).or(0) }
write_int_in* = (a: AllocatorBackend, n: i64) Result<i64, IoError> {
    a.integer_in(n).match ({
        .Ok(t)  => ok(print_owned_in(a, t)),
        .Err(e) => err(e),
    })
}
write_float_in* = (a: AllocatorBackend, x: f64) Result<i64, IoError> {
    a.float_in(x).match ({
        .Ok(t)  => ok(print_owned_in(a, t)),
        .Err(e) => err(e),
    })
}
write_digit = (d: i64) i64 { out_bytes("0123456789".offset(d).slice(1)).or(0) }
// Stream the first `len` bytes of the digit print_scratch in one out_bytes call.
// The digit loops themselves live ONCE in std.text.num_render;
// output is byte-identical to the old per-digit streaming — same digits, one write call.
write_scratch = (p: RawPtr<u8>, len: i64) i64 { out_bytes(slice(p, len)).or(0) }
// ONE digit print_scratch per OS thread, allocated on first use and reused by every writer below.
// 21 bytes covers the widest render: "-9223372036854775808" and u64-max are both 20 bytes.
//
// It is NOT a `b: [u8] = [0, …]` local: a slice literal is heap-promoted (the C backend cannot yet
// tell a non-escaping literal from an escaping one — see gen_slicelit's KNOWN LEAK) and the block is
// never freed, so the old shape leaked 21 bytes per integer printed, linearly. One cell per thread
// for the process lifetime costs a null test per call instead of a malloc.
//
// `thread_local`, so actors printing on different pool workers never interleave digits — and the
// const `null_ptr()` init means a freshly spawned worker starts unset rather than sharing the main
// thread's cell. Sharing ONE cell across the writers is safe because none of them holds the print_scratch
// across a call to another: each fills it and streams it before the next writer runs.
SCRATCH_LEN = 21
// PREFIXED name: Zen's namespace is flat and const-by-default makes a bare `x = v` an ASSIGNMENT
// whenever `x` names a module global, so a global called `scratch` would silently claim that word
// in every module that reaches std.io.print.
print_scratch ::= thread_local(null_ptr())
digits = () RawPtr<u8> {
    print_scratch.is_null().then({
        print_scratch = alloc(SCRATCH_LEN)
    })
    print_scratch.is_null().then({
        panic("print: out of memory")
    })
    print_scratch
}
// Non-negative n (callers: float significand/exponent paths and the sign-split below).
write_uint = (n: i64) i64 {
    b = digits()
    b.write_scratch(num_write_udigits(b, 0, n))
}
// Signed decimal; num_write_integer's negative-domain walk renders i64 min correctly.
write_int = (n: i64) i64 {
    b = digits()
    b.write_scratch(num_write_integer(b, n))
}
// Unsigned decimal for the full u64 range: num_uwrite_udigits keeps `/` and `%` UNSIGNED,
// so values above i64 max (e.g. 18446744073709551615) print correctly, unlike write_int
// which would treat the high bit as a sign.
write_u64 = (n: u64) i64 {
    b = digits()
    b.write_scratch(num_uwrite_udigits(b, 0, n))
}
write_fpad = (n: i64, w: i64) i64 {
    b = digits()
    b.write_scratch(num_write_fpad(b, 0, n, w))
}
// ── float formatting: 15 significant digits, trailing zeros trimmed ───────────
//
// A printed f64 round-trips for every value needing <= 15 significant digits — which is
// every literal a human writes (3.14, 0.5, 100.0) AND 0.123456789 (the old fixed 6-decimal
// path silently truncated it to "0.123457"). 0.1 + 0.2 still prints "0.3": at 15 digits the
// 0.30000000000000004 representation rounds back to "0.3". 15 (not 16/17) is the most the
// naive f64-scaling digit extraction stays clean for — 16+ reintroduces noise on round
// values (65536.0 would print "65535.99999999998"). inf/nan and the e-notation path for
// magnitudes outside [1e-4, 1e15) are preserved.
//
// The pure numeric decomposition (num_fexp / num_fsig / num_fstrip / num_fndig / num_fpow10i,
// plus their num_fexp_up/down, num_fpow10x, num_fscale_up/dn internals) lives ONCE in
// std.text.num_render and is imported above — only the streaming render below is print-specific.
fzeros = (n: i64) i64 {
    b = digits()
    b.write_scratch(num_write_zeros(b, 0, n))
}
// fixed-notation body for significand `digs` (`ndig` digits, leading digit at place e, -4<=e<15).
write_ffixed = (digs: i64, ndig: i64, e: i64) i64 {
    (e < 0).match ({
        true  => "0.".write_text() + fzeros(0 - e - 1) + write_uint(digs),
        false => (ndig <= e + 1).match ({
            true  => write_uint(digs) + fzeros(e + 1 - ndig) + ".0".write_text(),
            false => {
                fw = ndig - (e + 1)    // fractional digit count
                write_uint(digs / num_fpow10i(fw)) + ".".write_text() + write_fpad(digs % num_fpow10i(fw), fw)
            },
        }),
    })
}
// scientific-notation body "d.ddd e±EE".
write_fsci = (digs: i64, ndig: i64, e: i64) i64 {
    msd = digs / num_fpow10i(ndig - 1)
    rest = digs % num_fpow10i(ndig - 1)
    mant = write_digit(msd) + ".".write_text() + (ndig == 1).match ({
        true  => write_digit(0),
        false => write_fpad(rest, ndig - 1),
    })
    sgn = (e < 0).then({ "e-".write_text() }, { "e+".write_text() })
    mant + sgn + write_uint((e < 0).then({ 0 - e }, { e }))
}
// non-negative magnitude: zero prints "0.0"; otherwise 15 sig digits, trailing zeros
// trimmed, in fixed notation for e in [-4,14] and scientific outside it.
write_fabs_digits = (x: f64) i64 {
    (x == 0.0).match ({
        true  => "0.0".write_text(),
        false => {
            e0 = num_fexp(x)
            d0 = num_fsig(x, e0)
            e = (d0 >= 1000000000000000).then({ e0 + 1 }, { e0 })    // carry across 10^15
            digs = num_fstrip((d0 >= 1000000000000000).then({ d0 / 10 }, { d0 }))
            ndig = num_fndig(digs)
            (e >= 0 - 4 && e < 15).match ({
                true  => write_ffixed(digs, ndig, e),
                false => write_fsci(digs, ndig, e),
            })
        },
    })
}
write_float = (x: f64) i64 {
    sp = x.f64_special()
    (sp.at(0) != '\0').match ({
        true  => sp.write_text(),
        false => (x < 0.0).match ({
            true  => "-".write_text() + write_fabs_digits(0.0 - x),
            false => write_fabs_digits(x),
        }),
    })
}
// Display is the current type-directed print surface; real overload sets can replace the typed aliases later.
print*<T: Display> = (x: T) i64 { x.fmt_print() }
println*<T: Display> = (x: T) i64 { x.fmt_println() }
// ── Printer: ergonomic mixed-type formatted output in ONE statement ──────────
//
// `println` takes a single value, so the first thing a newcomer wants — printing
// "x=<int> y=<str> z=<float>" on one line — needs a different surface. Printer is
// a streaming builder: each piece is written to stdout immediately (no allocation,
// no temporary buffer), and a running byte count is threaded so the whole line
// reads as ONE expression mixing values of different kinds:
//
//   put("x=").i(x).s(" y=").s(y).s(" z=").f(z).nl()        // x=3 y=hello z=3.14
//   put(word).s(": ").i(count).nl()                        // the: 5
//
//   .s(t)    append a str (string literals and `str` values; also separators)
//   .i(n)    append an i64                .f(x)      append an f64
//   .b(x)    append a bool                .owned(g)  append an owned String
//   .sp()    append a single space        .nl()      end the line (newline)
//
// Each op is a NON-GENERIC method picked by name, so the type of every value is
// explicit at the call site and resolution is unambiguous across modules. Every op
// returns a `Printer`, so they chain; `.n` is the running byte count.
//
// IMPLEMENTATION NOTES (two cross-module gotchas these ops thread around):
//
//   * The ops are METHODS on Printer (defined inside the struct), not top-level
//     `s*`/`i*`/`f*` functions. Imports flatten into one namespace, so exporting
//     short names like `f` or `s` would clash with an importer's own top-level
//     `f`/`s` ("duplicate top-level definition"). As methods they're namespaced
//     under the receiver type and never pollute the global namespace.
//
//   * Every Printer-returning body ends in a *direct* `Printer(n: …)` constructor,
//     never a `.method()`-chain expression. A function whose return EXPRESSION is a
//     cross-module method-chain has its result type inferred from the chain, and
//     that inferred type fails to unify with the imported `Printer` at the call site
//     (assign-fit / arg-type errors). The literal constructor keeps the struct
//     identity intact across the module boundary.
//
// See LIMITATION at the bottom for the broader dispatch story.
Printer*: {
    n: i64,
    s = (p: Printer, t: StringView) Printer { Printer(n: p.n + t.write_text()) }
    i = (p: Printer, k: i64) Printer { Printer(n: p.n + k.write_int()) }
    f = (p: Printer, x: f64) Printer { Printer(n: p.n + x.write_float()) }
    b = (p: Printer, x: bool) Printer {
        t = x.then({ "true" }, { "false" })
        Printer(n: p.n + t.write_text())
    }
    owned = (p: Printer, g: String) Printer { Printer(n: p.n + g.write_string()) }
    sp    = (p: Printer) Printer { Printer(n: p.n + " ".write_text()) }
    nl    = (p: Printer) Printer { Printer(n: p.n + newline()) }
}
// Start a Printer chain with a literal prefix (the common "label=" case).
// Named `put` (not `out`) to avoid colliding with std.io.file.out (an i64-returning
// raw byte writer) — a same-named free function in another module would shadow this
// one's Printer return type at the call site.
put* = (t: StringView) Printer { Printer(n: t.write_text()) }
// String-backed interpolation compatibility. a.String(template, values...) is the canonical
// surface. These constructors and output helpers are thin adapters; parsing and value rendering
// live only in std.text.string.
arg_int* = (n: i64) StringArg { string_arg(.Int(n)) }
arg_flt* = (x: f64) StringArg { string_arg(.Float(x)) }
arg_str* = (s: StringView) StringArg { string_arg(.Text(s)) }
arg_bool* = (x: bool) StringArg { string_arg(.Bool(x)) }
arg_owned* = (g: String) StringArg { string_arg(.Owned(g)) }
format* = (template: StringView, args: ...StringArg) i64 {
    a = heap_allocator()
    g = a.string().add_format(template, args)
    g.live().match ({
        true  => {
            n = g.write_string()
            g.drop()
            n
        },
        false => {
            g.drop()
            panic("string: out of memory")
            0
        },
    })
}
formatln* = (template: StringView, args: ...StringArg) i64 { format(template, args) + newline() }
// LIMITATION — why typed ops (.i/.f/.s) and not one generic `.v(x)` or printf:
//
//   1. A single generic `v<T>(p: Printer, x: T) Printer` would read cleanest —
//      `put("x=").v(x).v(y)` — dispatching through the Display trait. But a generic
//      free function whose body ALSO takes a STRUCT-typed parameter (`p: Printer`)
//      currently fails arg-type checking when CALLED FROM ANOTHER MODULE. It checks
//      fine inside this module, and the value-only generics `println<T>`/`print<T>`
//      work cross-module — only the threaded-Printer generic trips the gap. Typed
//      ops sidestep it entirely: no generics involved.
//
// The streaming Printer still earns its place for gap (1) and allocation-free output.
// When the compiler closes gap (1) — generic + struct-param dispatch across
// modules — a single `.v(x)` can layer on without changing this core.
StringView.impl(Display, {
    fmt_print   = (s: StringView) i64 { s.write_text() }
    fmt_println = (s: StringView) i64 { s.write_text() + newline() }
})
String.impl(Display, {
    fmt_print   = (s: String) i64 { s.write_string() }
    fmt_println = (s: String) i64 { s.write_string() + newline() }
})
i32.impl(Display, {
    fmt_print   = (n: i32) i64 { n.write_int() }
    fmt_println = (n: i32) i64 { n.write_int() + newline() }
})
i64.impl(Display, {
    fmt_print   = (n: i64) i64 { n.write_int() }
    fmt_println = (n: i64) i64 { n.write_int() + newline() }
})
u8.impl(Display, {
    fmt_print   = (n: u8) i64 { n.write_int() }
    fmt_println = (n: u8) i64 { n.write_int() + newline() }
})
// Narrower signed widths: widen to i64 (sign-preserving) and reuse the integer formatter.
i8.impl(Display, {
    fmt_print   = (n: i8) i64 { to_i64(n).write_int() }
    fmt_println = (n: i8) i64 { to_i64(n).write_int() + newline() }
})
i16.impl(Display, {
    fmt_print   = (n: i16) i64 { to_i64(n).write_int() }
    fmt_println = (n: i16) i64 { to_i64(n).write_int() + newline() }
})
// Unsigned u16/u32 fit in i64 (max ~4.29e9 < 9.2e18), so widen and reuse write_int.
u16.impl(Display, {
    fmt_print   = (n: u16) i64 { to_i64(n).write_int() }
    fmt_println = (n: u16) i64 { to_i64(n).write_int() + newline() }
})
u32.impl(Display, {
    fmt_print   = (n: u32) i64 { to_i64(n).write_int() }
    fmt_println = (n: u32) i64 { to_i64(n).write_int() + newline() }
})
// u64 can exceed i64 max, so format via the unsigned path.
u64.impl(Display, {
    fmt_print   = (n: u64) i64 { write_u64(n) }
    fmt_println = (n: u64) i64 { write_u64(n) + newline() }
})
f64.impl(Display, {
    fmt_print   = (x: f64) i64 { x.write_float() }
    fmt_println = (x: f64) i64 { x.write_float() + newline() }
})
// f32 widens losslessly to f64, so it prints through the same 15-significant-digit path.
f32.impl(Display, {
    fmt_print   = (x: f32) i64 { to_f64(x).write_float() }
    fmt_println = (x: f32) i64 { to_f64(x).write_float() + newline() }
})
bool.impl(Display, {
    fmt_print   = (b: bool) i64 { b.then({ "true".write_text() }, { "false".write_text() }) }
    fmt_println = (b: bool) i64 { b.fmt_print() + newline() }
})
