Tag, One, Two, Three, Only, Single = mode.mode

name = (t: Tag) str {
    t.match({
        One   => "one",
        Two   => "two",
        Three => "three",
    });
}

main = (env: Env) Res<i32, IoError> {
    println(name(Tag.One));
    println(name(Two));
    println(name(Three));
    o: Only = Single;
    o.match({ Single => println("single") });
    Ok(0);
}
