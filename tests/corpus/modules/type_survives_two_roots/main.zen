// main never names `inner_box`, the file that actually declares any of this
//
// EVERY PROBE HAS TO BE ABLE TO ANSWER WRONG. Reading one field of one
// generic and matching a one-variant enum said only that the hops
// compiled: the field could have been the only field, and the arm was the
// only arm. So the struct that travels has two fields with two distinct
// non-default values, a GENERIC reads the second of them, and the enum
// that travels is matched on the variant that is not first -- a tag that
// arrived as zero prints `once` and says so.
Box, Tick, Once, Twice, unwrap, seen_of = deep.deep

main = (env: Env) Res<i32, IoError> {
    b = Box<i32>(value: 91, seen: 7);
    println("{}", b.value);
    println("{}", unwrap(b));
    println("{}", seen_of(b));
    t: Tick = Twice;
    t.match({ Once => println("once"), Twice => println("twice") });
    Ok(0);
}
