// hoisting fires when exactly ONE variant carries the type: Res<i32> has
// one such variant (Ok), so a bare 32 lifts. the ambiguous case is
// must-fail/sema/hoist_ambiguous, and Err never lifts at all --
// must-fail/sema/hoist_err_not_lifted.

CfgError =
    Missing,
    Bad

Holder = {
    bar: Res<i32>,
}

seven = () Res<i32, CfgError> {
    // a bare value closes a Res function exactly as Ok(7) does
    7;
}

main = (env: Env) Res<i32, CfgError> {
    lifted   = Holder(bar: 32);
    explicit = Holder(bar: Ok(32));

    lifted.bar.match({
        Ok(n) => println("lifted {}", n),
        None  => println("lifted none"),
    })
    explicit.bar.match({
        Ok(n) => println("explicit {}", n),
        None  => println("explicit none"),
    })
    seven().match({
        Ok(n)  => println("seven {}", n),
        Err(_) => println("seven err"),
    })
    Ok(0);
}
