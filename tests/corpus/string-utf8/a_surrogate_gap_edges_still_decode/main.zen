// U+D7FF then U+E000: the two edges of the surrogate gap, ADJACENT in
// one literal. Both must decode -- 55295 and 57344. The trap is the
// shortcut: a decoder that bans the whole 0xED lead band instead of
// checking values would lose U+D7FF, and real Hangul lives just below
// the gap. The ED A0 80 surrogate case in
// a_well_formed_lead_with_a_forbidden_value_is_invalid/ proves the MIDDLE
// of the band is rejected; this one proves the edges survive.
Utf8Error = std.text.text_utf8

main = (env: Env) Res<i32, Utf8Error> {
    s = "퟿";
    println("len {} cps {}", s.len, s.count_codepoints().try());
    walk ::= s.codepoints();
    first ::= walk.next().try();
    second ::= walk.next().try();
    println("{} {}", first, second);
    Ok(0);
}
