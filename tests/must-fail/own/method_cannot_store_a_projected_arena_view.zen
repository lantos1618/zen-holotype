Input = { text: str }
Box = {
    text :: str,
    put = (self :: @Self, input: Input) () { self.text = input.text; }
}
bad = (env: Env, box :: Box) Res<(), AllocError> {
    a    = env.mem.alloc();
    text = a.String("dangling").try();
    box.put(Input(text: text.view()));
    Ok(())
}
main = (env: Env) Res<(), AllocError> {
    box ::= Box(text: "");
    bad(env, box).try();
    println(box.text);
    Ok(())
}
