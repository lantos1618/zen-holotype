// PROBE 3: isolate the nested-wrap case. Is it u8(200)? nesting? field chain?
Wrap<T> = { held: T }
wrap = <T>(t: T) Wrap<T> { Wrap(held: t) }

main = (env: Env) Res<i32, AllocError> {
    // layer 1 alone
    one = wrap(u8(200));
    println("one {}", one.held);

    // two layers
    inner = wrap(u8(201));
    outer = wrap(inner);
    println("outer {}", outer.held.held);

    // same nesting without u8
    inner2 = wrap("s");
    outer2 = wrap(inner2);
    println("outer-str {}", outer2.held.held);

    // three layers of u64
    l1 = wrap(4000000001);
    l2 = wrap(l1);
    l3 = wrap(l2);
    println("three {}", l3.held.held.held);
    Ok(0);
}
