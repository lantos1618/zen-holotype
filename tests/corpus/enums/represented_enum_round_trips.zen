Frame = | Data = 0x0 | Ping = 0x6 | Unknown(u8)
Closed = | Red = 1 | Blue = 2

main = (env: Env) Res<i32, IoError> {
    ping    = Frame.from_discriminant(0x6);
    unknown = Frame.from_discriminant(0xff);
    println("{} {}", ping.discriminant(), unknown.discriminant());
    ping.match({
        Ping => println("ping"),
        _    => println("wrong known variant"),
    });
    unknown.match({
        Unknown(raw) => println("unknown {}", raw),
        _            => println("known"),
    });

    Closed.from_discriminant(2).match({
        Ok(value) => println("closed {}", value.discriminant()),
        None      => println("missing known"),
    });
    Closed.from_discriminant(9).match({
        Ok(value) => println("unexpected {}", value.discriminant()),
        None      => println("closed miss"),
    });
    Ok(0)
}
