// a string is one TOKEN, so nothing inside it is read as syntax.
// as a `seq` rule the grammar let `extras` -- whitespace and both
// comment forms -- match between the rule's elements, so `"// x"`
// matched a line_comment INSIDE the string, ran to the end of the
// next line, and corrupted every literal after it.
main = (env: Env) Res<i32, ArgError> {
    a = "// not a comment";
    b = "/* nor this */";
    c = "still fine";
    println("{}", a);
    println("{}", b);
    println("{}", c);
    Ok(0);
}
