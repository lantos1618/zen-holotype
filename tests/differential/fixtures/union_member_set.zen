// A structural union's generated tag and payload member must agree for every
// member, independent of the union's source order.
NotFound = | NotFound
Denied = | Denied
Set = Denied | NotFound

show = (error: Set) () {
    error.match({
        NotFound(value) => value.match({
            NotFound => println("not found"),
        }),
        Denied(value)   => value.match({
            Denied => println("denied"),
        }),
    })
}

main = (env: Env) Res<i32, AllocError> {
    show(Set.NotFound(NotFound.NotFound));
    show(Set.Denied(Denied.Denied));
    (env.argv.len > 0).match({ true => Ok(0), false => Ok(9) })
}
