// Allocation-free numeric rendering shared by owned strings, numeric conversion, and stdout fmt.
// Keep the digit and floating-point spelling logic here so every sink emits identical bytes.
num_udigit_count* = (n: i64) i64 { (n < 10).then({ 1 }, { 1 + num_udigit_count(n / 10) }) }
num_ndigit_count* = (n: i64) i64 { (n > 0 - 10).then({ 1 }, { 1 + num_ndigit_count(n / 10) }) }
num_integer_len* = (n: i64) i64 {
    (n < 0).then({ 1 + num_ndigit_count(n) }, { num_udigit_count(n) })
}
num_two_digits* = () StringView {
    "00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899"
}
num_write_upair = (p: RawPtr<u8>, at: i64, pair: i64) i64 {
    tbl = num_two_digits()
    p.offset(at).store(tbl.offset(2 * pair).load())
    p.offset(at + 1).store(tbl.offset(2 * pair + 1).load())
    at + 2
}
num_write_udigits* = (p: RawPtr<u8>, at: i64, n: i64) i64 {
    (n < 100).match ({
        true  => (n < 10).match ({
            true  => {
                p.offset(at).store('0' + n)
                at + 1
            },
            false => num_write_upair(p, at, n),
        }),
        false => {
            next = num_write_udigits(p, at, n / 100)
            num_write_upair(p, next, n % 100)
        },
    })
}
num_write_ndigits = (p: RawPtr<u8>, at: i64, n: i64) i64 {
    (n > 0 - 10).match ({
        true  => {
            p.offset(at).store('0' + (0 - n))
            at + 1
        },
        false => {
            next = num_write_ndigits(p, at, n / 10)
            p.offset(next).store('0' + (0 - n % 10))
            next + 1
        },
    })
}
num_write_integer* = (p: RawPtr<u8>, n: i64) i64 {
    (n < 0).match ({
        true  => {
            p.store('-')
            num_write_ndigits(p, 1, n)
        },
        false => num_write_udigits(p, 0, n),
    })
}
num_uudigit_count* = (n: u64) i64 { (n < 10).then({ 1 }, { 1 + num_uudigit_count(n / 10) }) }
num_uwrite_udigits* = (p: RawPtr<u8>, at: i64, n: u64) i64 {
    (n < 100).match ({
        true  => (n < 10).match ({
            true  => {
                p.offset(at).store('0' + to_i64(n))
                at + 1
            },
            false => num_write_upair(p, at, to_i64(n)),
        }),
        false => {
            next = num_uwrite_udigits(p, at, n / 100)
            num_write_upair(p, next, to_i64(n % 100))
        },
    })
}
num_copy_text = (p: RawPtr<u8>, at: i64, s: StringView, i: i64) i64 {
    b = s.offset(i).load()
    (b == '\0').match ({
        true  => at,
        false => {
            p.offset(at).store(b)
            num_copy_text(p, at + 1, s, i + 1)
        },
    })
}
num_text_len_at = (s: StringView, i: i64) i64 {
    (s.offset(i).load() == '\0').then({ i }, { num_text_len_at(s, i + 1) })
}
num_text_len = (s: StringView) i64 { num_text_len_at(s, 0) }
num_write_fpad* = (p: RawPtr<u8>, at: i64, n: i64, w: i64) i64 {
    (w == 1).match ({
        true  => {
            p.offset(at).store('0' + n % 10)
            at + 1
        },
        false => {
            next = num_write_fpad(p, at, n / 10, w - 1)
            p.offset(next).store('0' + n % 10)
            next + 1
        },
    })
}
num_write_zeros* = (p: RawPtr<u8>, at: i64, k: i64) i64 {
    (k <= 0).match ({
        true  => at,
        false => {
            p.offset(at).store('0')
            num_write_zeros(p, at + 1, k - 1)
        },
    })
}
num_fexp_up = (x: f64, e: i64) i64 { (x < 10.0).then({ e }, { num_fexp_up(x / 10.0, e + 1) }) }
num_fexp_down = (x: f64, e: i64) i64 { (x >= 1.0).then({ e }, { num_fexp_down(x * 10.0, e - 1) }) }
num_fexp* = (x: f64) i64 { (x >= 1.0).then({ num_fexp_up(x, 0) }, { num_fexp_down(x, 0) }) }
num_fpow10x = (n: i64) f64 { (n <= 0).then({ 1.0 }, { 10.0 * num_fpow10x(n - 1) }) }
num_fscale_up = (a: f64, k: i64) f64 {
    (k <= 22).then({ a * num_fpow10x(k) }, { num_fscale_up(a * num_fpow10x(22), k - 22) })
}
num_fscale_dn = (a: f64, k: i64) f64 {
    (k <= 22).then({ a / num_fpow10x(k) }, { num_fscale_dn(a / num_fpow10x(22), k - 22) })
}
num_fsig* = (a: f64, e: i64) i64 {
    (e >= 14).match ({
        true  => to_i64(num_fscale_dn(a, e - 14) + 0.5),
        false => to_i64(num_fscale_up(a, 14 - e) + 0.5),
    })
}
num_fstrip* = (n: i64) i64 { (n % 10 == 0 && n >= 10).then({ num_fstrip(n / 10) }, { n }) }
num_fndig* = (n: i64) i64 { (n < 10).then({ 1 }, { 1 + num_fndig(n / 10) }) }
num_fpow10i* = (n: i64) i64 { (n <= 0).then({ 1 }, { 10 * num_fpow10i(n - 1) }) }
num_write_ffixed = (p: RawPtr<u8>, at: i64, digs: i64, ndig: i64, e: i64) i64 {
    (e < 0).match ({
        true  => {
            p.offset(at).store('0')
            p.offset(at + 1).store('.')
            z = num_write_zeros(p, at + 2, 0 - e - 1)
            num_write_udigits(p, z, digs)
        },
        false => (ndig <= e + 1).match ({
            true  => {
                d = num_write_udigits(p, at, digs)
                z = num_write_zeros(p, d, e + 1 - ndig)
                p.offset(z).store('.')
                p.offset(z + 1).store('0')
                z + 2
            },
            false => {
                fw = ndig - (e + 1)
                d = num_write_udigits(p, at, digs / num_fpow10i(fw))
                p.offset(d).store('.')
                num_write_fpad(p, d + 1, digs % num_fpow10i(fw), fw)
            },
        }),
    })
}
num_write_fsci = (p: RawPtr<u8>, at: i64, digs: i64, ndig: i64, e: i64) i64 {
    p.offset(at).store('0' + digs / num_fpow10i(ndig - 1))
    p.offset(at + 1).store('.')
    m = (ndig == 1).match ({
        true  => {
            p.offset(at + 2).store('0')
            at + 3
        },
        false => num_write_fpad(p, at + 2, digs % num_fpow10i(ndig - 1), ndig - 1),
    })
    p.offset(m).store('e')
    (e < 0).match ({
        true  => {
            p.offset(m + 1).store('-')
            num_write_udigits(p, m + 2, 0 - e)
        },
        false => {
            p.offset(m + 1).store('+')
            num_write_udigits(p, m + 2, e)
        },
    })
}
num_write_fabs_digits = (p: RawPtr<u8>, at: i64, x: f64) i64 {
    (x == 0.0).match ({
        true  => {
            p.offset(at).store('0')
            p.offset(at + 1).store('.')
            p.offset(at + 2).store('0')
            at + 3
        },
        false => {
            e0 = num_fexp(x)
            d0 = num_fsig(x, e0)
            e = (d0 >= 1000000000000000).then({ e0 + 1 }, { e0 })
            digs = num_fstrip((d0 >= 1000000000000000).then({ d0 / 10 }, { d0 }))
            ndig = num_fndig(digs)
            (e >= 0 - 4 && e < 15).match ({
                true  => num_write_ffixed(p, at, digs, ndig, e),
                false => num_write_fsci(p, at, digs, ndig, e),
            })
        },
    })
}
f64_special* = (x: f64) StringView {
    (x != x).match ({
        true  => "nan",
        false => (x - x != 0.0).match ({
            true  => (x < 0.0).then({ "-inf" }, { "inf" }),
            false => "",
        }),
    })
}
num_is_special_text = (s: StringView) bool { s.offset(0).load() != '\0' }
num_float_cap* = (x: f64) i64 {
    sp = x.f64_special()
    sp.num_is_special_text().then({ num_text_len(sp) + 1 }, { 80 })
}
num_write_float* = (p: RawPtr<u8>, x: f64) i64 {
    sp = x.f64_special()
    sp.num_is_special_text().match ({
        true  => num_copy_text(p, 0, sp, 0),
        false => (x < 0.0).match ({
            true  => {
                p.store('-')
                num_write_fabs_digits(p, 1, 0.0 - x)
            },
            false => num_write_fabs_digits(p, 0, x),
        }),
    })
}
