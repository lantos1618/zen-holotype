// Comments are tokens because the formatter preserves them as trivia.
//
// Block comments DO NOT NEST: `/* a /* b */` is closed by the first `*/`.
// There is no depth counter, so there is none to get wrong.
//
// Inputs are assembled at runtime because a literal containing a comment
// opener would itself be tokenized as a comment.

scan, Source, kind_name, message, text_of = std.lex.lex
Alloc, AllocError = std.mem
str, String = std.text

// `//` followed by whatever the caller wants
line_comment = (alloc: Alloc, rest: str) Res<String, AllocError> {
    sb ::= alloc.String().try();
    sb.add('/').try();
    sb.add('/').try();
    sb.add(rest).try();
    Ok(sb);
}

// `/*` followed by whatever the caller wants
block_comment = (alloc: Alloc, rest: str) Res<String, AllocError> {
    sb ::= alloc.String().try();
    sb.add('/').try();
    sb.add('*').try();
    sb.add(rest).try();
    Ok(sb);
}

dump = (env: Env, alloc: Alloc, text: str) Res<(), AllocError> {
    src = Source(file: "in.zen", text: text);
    out = scan(alloc, src).try();
    println("[{}]", text);
    out.tokens.loop((h, t) {
        println("  {} [{}]", kind_name(t.kind), text_of(src, t));
    });
    out.diags.loop((h, d) {
        println(
            "  ! {}:{} {}",
            d.span.start.line,
            d.span.start.col,
            message(d.fault)
        );
    });
    Ok(());
}

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();

    println("-- line comments");
    dump(env, alloc, line_comment(alloc, " to end of line").try().view()).try();
    // the newline is whitespace and belongs to the gap, not to the comment
    dump(env, alloc, line_comment(alloc, " first\nx").try().view()).try();
    // a comment at end of file with no trailing newline still closes
    dump(env, alloc, line_comment(alloc, "").try().view()).try();
    // a file of nothing but comments has no code tokens and is not an error
    dump(env, alloc, line_comment(alloc, " only").try().view()).try();

    println("-- block comments");
    dump(env, alloc, block_comment(alloc, " one */").try().view()).try();
    dump(
        env,
        alloc,
        block_comment(alloc, " over\ntwo lines */ x").try().view()
    ).try();
    // NOT NESTED: the first `*/` closes it, and `b */` is left over as code
    dump(env, alloc, block_comment(alloc, " a /* b */").try().view()).try();
    // a single `*` inside is not a close
    dump(env, alloc, block_comment(alloc, " a * b */").try().view()).try();

    println("-- unterminated");
    // reported at the `/*`, which is the thing that needs closing — not at
    // end of file, which names no useful location
    dump(env, alloc, block_comment(alloc, " never closed").try().view()).try();
    dump(env, alloc, block_comment(alloc, "").try().view()).try();
    // `/*` then `*` then end of file: the close is half written
    dump(env, alloc, block_comment(alloc, " a *").try().view()).try();

    println("-- slash is still division");
    dump(env, alloc, "a / b").try();
    Ok(0);
}
