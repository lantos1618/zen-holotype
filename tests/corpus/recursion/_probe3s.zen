Link = {
    value: i64,
    next: Ptr<Link>,
}

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    p = alloc.create<Link>().try();
    q = alloc.create<Link>().try();
    q.write(0, Link(value: 50, next: null_ptr<Link>()));
    p.write(0, Link(value: 5, next: q));
    println("{}", p.read(0).value);
    println("{}", p.read(0).next.read(0).value);
    Ok(0);
}
