{ request_arena } = std.mem.alloc
// Growable allocator-backed byte string.
// Operations return updated headers because resize may move the backing allocation.
{ len, view } = std.text.str
{ AllocatorBackend, Allocator } = std.mem.alloc
{ Result, IoError, ok, err } = std.core.result
buf = std.mem.buffer
// Carried strings retain their birth allocator; its state must outlive every derived owner.
// OOM is sticky until freeze(). Uncarried headers never dispatch through an empty vtable.
String*: {
    ptr: RawPtr<u8>,
    len: i64,
    cap: i64,
    carried: bool,
    oom: bool,
    alloc: Allocator,
    add = (s: String, t: StringView) String {
        v = s.string_buffer()
        d = v.alloc
        buf.buffer_live(v).match ({
            true  => buf.buffer_settle(v, buf.buffer_extend(d.addr(), v, t.view(), 1)).buffer_string(),
            false => s,
        })
    }
    add_one = (s: String, b: u8) String {
        v = s.string_buffer()
        d = v.alloc
        b = b
        buf.buffer_live(v).match ({
            true  => buf.buffer_settle(v, buf.buffer_extend(d.addr(), v, slice(b.addr(), 1), 1)).buffer_string(),
            false => s,
        })
    }
    add_slice = (s: String, t: [u8]) String {
        // t is length-delimited and need not be NUL-terminated.
        v = s.string_buffer()
        d = v.alloc
        buf.buffer_live(v).match ({
            true  => buf.buffer_settle(v, buf.buffer_extend(d.addr(), v, t, 1)).buffer_string(),
            false => s,
        })
    }
    view = (s: String) [u8] { slice(s.ptr, s.len) }
    freeze = (s: String) Result<StringConst, IoError> {
        buf.buffer_freeze(s.string_buffer()).match ({
            .Ok(c)  => ok(c.buffer_string_const()),
            .Err(e) => err(e),
        })
    }
    drop = (s: String) void { buf.buffer_drop(s.string_buffer()) }
    live = (s: String) bool { buf.buffer_live(s.string_buffer()) }
    settle = (s: String, r: Result<String, IoError>) String {
        br: Result<buf.Buffer<u8>, IoError> = r.match ({
            .Ok(g)  => .Ok(g.string_buffer()),
            .Err(e) => .Err(e),
        })
        buf.buffer_settle(s.string_buffer(), br).buffer_string()
    }
    relink = (s: String, g: String) String {
        br: Result<buf.Buffer<u8>, IoError> = .Ok(g.string_buffer())
        buf.buffer_settle(s.string_buffer(), br).buffer_string()
    }
    poison = (s: String) String {
        br: Result<buf.Buffer<u8>, IoError> = .Err(.NotFound)
        buf.buffer_settle(s.string_buffer(), br).buffer_string()
    }
    bytes   = (s: String) [u8] { s.ptr.slice(s.len) }
    push_in = (s: String, a: AllocatorBackend, b: u8) Result<String, IoError> { a.push_in(s, b) }
    append_in = (s: String, a: AllocatorBackend, t: StringView) Result<String, IoError> {
        a.append_in(s, t)
    }
    finish_in = (s: String, a: AllocatorBackend) Result<StringCstr, IoError> { a.finish_in(s) }
    free_in   = (s: String, a: AllocatorBackend) void { a.free_in(s) }
}
// Header adapters preserve String's public layout.
string_buffer = (s: String) buf.Buffer<u8> {
    buf.Buffer<u8>(
        ptr: s.ptr,
        len: s.len,
        cap: s.cap,
        carried: s.carried,
        oom: s.oom,
        alloc: s.alloc,
    )
}
buffer_string = (v: buf.Buffer<u8>) String {
    String(
        ptr: v.ptr,
        len: v.len,
        cap: v.cap,
        carried: v.carried,
        oom: v.oom,
        alloc: v.alloc,
    )
}
// Explicit allocator operations are fallible.
init* = (a: AllocatorBackend, cap: i64) Result<String, IoError> {
    // cap excludes the spare byte reserved for finish_in's trailing NUL.
    actual = cap + 1
    a.try_acquire(actual).match ({
        .Ok(p)  => ok(String(
            ptr: p,
            len: 0,
            cap: actual,
        )),
        .Err(e) => err(e),
    })
}
new_in* = (a: AllocatorBackend) Result<String, IoError> { a.init(16) }
// Bind s once so inlining a builder expression remains linear.
reserve_in = (a: AllocatorBackend, s: String, need: i64) Result<String, IoError> {
    s = s
    buf.buffer_reserve(a, s.string_buffer(), need).match ({
        .Ok(v)  => ok(v.buffer_string()),
        .Err(e) => err(e),
    })
}
// Force value args to locals first so callers may safely pass expressions that read `s`.
push_in* = (a: AllocatorBackend, s: String, b: u8) Result<String, IoError> {
    b = b
    buf.buffer_extend(a, s.string_buffer(), slice(b.addr(), 1), 1).match ({
        .Ok(v)  => ok(v.buffer_string()),
        .Err(e) => err(e),
    })
}
append_in* = (a: AllocatorBackend, s: String, t: StringView) Result<String, IoError> {
    t = t
    buf.buffer_extend(a, s.string_buffer(), t.view(), 1).match ({
        .Ok(v)  => ok(v.buffer_string()),
        .Err(e) => err(e),
    })
}
// Append a length-delimited slice; no NUL terminator is required.
append_slice_in* = (a: AllocatorBackend, s: String, t: Slice<u8>) Result<String, IoError> {
    t = t
    buf.buffer_extend(a, s.string_buffer(), t, 1).match ({
        .Ok(v)  => ok(v.buffer_string()),
        .Err(e) => err(e),
    })
}
finish_in* = (a: AllocatorBackend, s: String) Result<StringCstr, IoError> {
    // The maintained spare byte avoids relocation and preserves the owning header.
    a.reserve_in(s, 1).match ({
        .Ok(done) => {
            done.ptr.offset(done.len).store(0)
            ok(cstr(done.ptr))
        },
        .Err(e)   => err(e),
    })
}
// Keep the owning String visible so ownership validation invalidates it.
free_in* = (a: AllocatorBackend, s: String) void { a.release(s.ptr) }
// Fixed is writable; Const is read-only. Both retain their allocator for drop().
StringFixed*: {
    ptr: RawPtr<u8>,
    len: i64,
    alloc: Allocator,
    view = (s: StringFixed) [u8] { slice(s.ptr, s.len) }
    get  = (s: StringFixed, i: i64) u8 { s.view()[i] }
    set = (s: StringFixed, i: i64, b: u8) void {
        v ::= s.view()
        v[i] = b
    }
    drop = (s: StringFixed) void { buf.buffer_fixed_drop(s.string_fixed_buffer()) }
}
StringConst*: {
    ptr: RawPtr<u8>,
    len: i64,
    alloc: Allocator,
    view = (s: StringConst) Slice<u8> { slice(s.ptr, s.len) }
    get  = (s: StringConst, i: i64) u8 { s.view()[i] }
    drop = (s: StringConst) void { buf.buffer_const_drop(s.string_const_buffer()) }
}
string_fixed_buffer = (s: StringFixed) buf.BufferFixed<u8> {
    buf.BufferFixed<u8>(
        ptr: s.ptr,
        len: s.len,
        alloc: s.alloc,
    )
}
buffer_string_fixed = (v: buf.BufferFixed<u8>) StringFixed {
    StringFixed(
        ptr: v.ptr,
        len: v.len,
        alloc: v.alloc,
    )
}
string_const_buffer = (s: StringConst) buf.BufferConst<u8> {
    buf.BufferConst<u8>(
        ptr: s.ptr,
        len: s.len,
        alloc: s.alloc,
    )
}
buffer_string_const = (v: buf.BufferConst<u8>) StringConst {
    StringConst(
        ptr: v.ptr,
        len: v.len,
        alloc: v.alloc,
    )
}
// string records initial OOM for freeze(); string_fixed reports it immediately.
string* = (a: Allocator, cap: i64) String {
    v: buf.Buffer<u8> = buf.buffer_new(a, cap + 1)
    v.buffer_string()
}
string_fixed* = (a: Allocator, n: i64) Result<StringFixed, IoError> {
    r: Result<buf.BufferFixed<u8>, IoError> = buf.buffer_fixed(a, n)
    r.match ({
        .Ok(v)  => ok(v.buffer_string_fixed()),
        .Err(e) => err(e),
    })
}
// Converting a frozen String back to growable storage always copies.
string_from* = (a: Allocator, c: StringConst) String {
    src: [u8] = slice(c.ptr, c.len)
    a.string(c.len).add_slice(src)
}
