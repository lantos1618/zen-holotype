// @self-hosted-only: allocator-owned buffers and Drop-owned C handles.
{ Own, Drop, new_in } = std.mem.own
{ Allocator, try_acquire } = std.mem.alloc
{ O_RDONLY } = std.io.file
{ open, close } = std.c.libc
{ Result, IoError, ok_if, ok, err } = std.core.result
Buf*: {
    p: RawPtr<u8>,
    len: i64,
    get = (b: Ptr<Buf>, i: i64) u8 { b.p.offset(i).load() }
    set = (b: MutPtr<Buf>, i: i64, v: u8) void { b.p.offset(i).store(v) }
    free = (b: MutPtr<Buf>, alloc: Allocator) void {
        alloc.release(b.p)
        b.p = null_ptr()
        b.len = 0
    }
}
// `buf` allocates through the caller's allocator, so it returns Result<Buf, IoError>.
buf* = (alloc: Allocator, n: i64) Result<Buf, IoError> {
    (n <= 0).match ({
        true  => ok(Buf(
            p: null_ptr(),
            len: 0,
        )),
        false => alloc.try_acquire(n).match ({
            .Ok(p)  => ok(Buf(
                p: p,
                len: n,
            )),
            .Err(e) => err(e),
        }),
    })
}
// POSIX open returns a raw descriptor; File closes it through Drop.
File*: {
    fd: i32,
}
file_in* = (alloc: Allocator, path: StringView) Result<Own<File>, IoError> {
    path.open(O_RDONLY, 0).ok_if().match ({
        .Ok(fd) => {
            alloc.new_in(File(fd: fd)).match ({
                .Ok(o)  => ok(o),
                .Err(e) => {
                    fd.close()
                    err(e)
                },
            })
        },
        .Err(e) => err(e),
    })
}
file* = (alloc: Allocator, path: StringView) Result<Own<File>, IoError> { alloc.file_in(path) }
File.impl(Drop, {
    drop = (f: MutPtr<File>) void { f.fd.close() }
})
