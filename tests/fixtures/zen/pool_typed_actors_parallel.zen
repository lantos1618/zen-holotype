// Typed actors run on the pool, in parallel, exactly once.
// — no caller-thread inline drain. NACT typed actors each receive PERMSG typed `Inc(1)` messages; each
// `receive` atomically adds 1 to a SHARED accumulator. Sends go through the pool (pool_send via the
// monomorphized trampoline), drained by WORKERS workers. Exit gate = (a) the total is EXACT (no lost/dup
// work → exactly-once across the mailbox MPSC + scheduled-flag transitions — the CORRECTNESS property).
// Worker fan-out (>= 2 workers busy) is observed but NON-FATAL: a starved runner can legally drain every
// mailbox on one worker, and that must not flake a correct run to exit 3.
// This is the typed analogue of pool_parallel_actors; the actor's `receive` is the pool behavior now.
{ pool_open, Pool } = std.concurrent.pool
{ malloc, free } = std.mem.alloc
pa = std.concurrent.pool_actor
{ Context, Receiver } = std.concurrent.pool_actor
NACT = 8
PERMSG = 5000
WORKERS = 4
PH_SIZE = 16    // sizeof(PooledHandle<Worker>) = 2 RawPtr; sizeof-of-a-generic-instance does not parse
acc = malloc(8)
handles = malloc(NACT * PH_SIZE)
Msg*: Inc(i64)
Worker*: {
    acc: RawPtr<u8>,
}
Worker.impl(Receiver, {
    receive = (w: MutPtr<Worker>, ctx: Context<Msg>) void {
        ctx.msg.match ({
            .Inc(n) => {
                atomic_add_i64(w.acc, n)
            },
        })
    }
})
// the concrete per-(Msg, Worker) trampoline: decode the actor state + the boxed message, dispatch to the
// typed receiver, reclaim the box. Concrete (Zen has no address for a generic fn), one per actor type.
// `Context(msg: b[0])` infers M from the field (Context is the canonical std.concurrent.actor type,
// imported through pool_actor's destructured re-export).
tramp = (user: RawPtr<u8>, msg: i64) void {
    a: MutSlice<Worker> = user.slice(1)
    b: MutSlice<Msg> = msg.offset(0).slice(1)
    a[0].addr().receive(Context(msg: b[0]))
    pa.free_msg(msg)
}
hslot = () MutSlice<pa.PooledHandle<Worker>> { handles.slice(NACT) }
spawn_all = (i: i64) void {
    (i < NACT).then({
        hs ::= hslot()
        hs[i] = pa.spawn_actor_heap(PERMSG + 16, Worker(acc: acc), tramp)
        spawn_all(i + 1)
    })
}
send_n = (p: MutPtr<Pool>, h: pa.PooledHandle<Worker>, k: i64) void {
    (k < PERMSG).then({
        p.send(h, Msg.Inc(1))
        send_n(p, h, k + 1)
    })
}
blast = (p: MutPtr<Pool>, i: i64) void {
    (i < NACT).then({
        hs = hslot()
        send_n(p, hs[i], 0)
        blast(p, i + 1)
    })
}
close_all = (i: i64) void {
    (i < NACT).then({
        hs = hslot()
        pa.close(hs[i])
        close_all(i + 1)
    })
}
main = () i32 {
    store_i64(acc, 0)
    spawn_all(0)
    p = pool_open(WORKERS, NACT + 8)
    blast(p, 0)
    p.pool_quiesce_stop()
    p.workers_busy()    // observed to exercise the API post-quiesce; see note below — NON-FATAL
    total = load_i64(acc)
    close_all(0)
    p.pool_close()
    free(handles)
    free(acc)
    expected = NACT * PERMSG
    // `busy >= 2` used to gate the exit code, but it is a MACHINE observation, not a correctness
    // property: on a starved runner (CI fans many harness suites across few cores) one worker can
    // legally drain every mailbox before a second is ever scheduled. That flaked exit 3 on a
    // correct run, so parallelism is now NON-FATAL — the exit gate is the exactly-once total alone.
    (total == expected).then({ 7 }, { 1 })
}
