// src/gen/gen_c/gen_c_assoc.zen
// `Type.name(..)` — a member called with NO receiver.
//
// "A struct body may bind a name to a value, read as `Type.NAME`", and a
// function is a value. So `Duration.seconds(2)` is a member read through
// its type, and it is not a method with the type shoved into the
// receiver slot — which is what this backend did, emitting an undeclared
// `D2` that no Zen diagnostic named and only `cc` caught.
//
// A CONSTRUCTOR IS WHY THE FORM HAS TO EXIST. `seconds = (n: u64)
// Duration` takes a number and returns the type, so travelling with its
// first parameter would file it under `u64` and put `.seconds()` on
// every integer in every program.
//
// THE FIRST PARAMETER IS THE WHOLE TEST, and it is asked of the RESOLVED
// type rather than of the written spelling: a parameter that is the
// receiver's own type is a method — "a method is a UFCS function whose
// first parameter happens to be named `self`" — whether it was written
// `@Self` or spelled out. Anything else, including no parameter at all,
// is an associated function. A method reached this way has no spelling
// in the language, so it stays a refusal.
//
// EVERYTHING ELSE IS `gen_c_member.zen`'S METHOD CALL WITH THE RECEIVER
// DROPPED: the same qualified name, the same signature, the same queue
// entry. The two cannot disagree about which function they mean, and
// `gen_c_decl.zen` lowers the body it queues without knowing which of
// the two asked for it.

Ast, Expr, ExprId, Decl, Struct, Member, MemberKind = ast
Function, Param, Access, Call, Arg, Span, Ident = ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
DeclId = sema.sema_id
TyId, Ty, Types = sema.sema_ty
Checker, Ctx = sema.sema_check
Inst = sema.sema_inst
Def, DefKind, decl_at = sema.sema_def
self_ctx = sema.sema_member
module_named_by = sema.sema_module
param_type = sema.sema_type
sym_fn = gen.gen_name
CBackend, MethodRef = gen.gen_c.gen_c_state
unsupported = gen.gen_c.gen_c_state
any_open, recv_inst, inst_open = gen.gen_c.gen_c_mono
enter_struct_tparams, leave_tparams = gen.gen_c.gen_c_mono
write_arg, signature_of, plain = gen.gen_c.gen_c_call
construct = gen.gen_c.gen_c_build
Site, site_of, member_at, method_sig, join = gen.gen_c.gen_c_member
by_arity = gen.gen_c.gen_c_impl

// The base named a type and the name is not one of its variants. A
// member it declares that wants no receiver is this; anything else is
// the caller's refusal to report, so the answer is `false` and not a
// diagnostic of its own.
lower_assoc_call* = (be :: CBackend, id: ExprId, c: Call, a: Access,
                     ty: TyId, ctx: Ctx, out :: String)
                    Res<bool, AllocError> {
    be.check.module_named_by(ty).match({
        Ok(mi) => lower_module_call(be, id, c, a, mi, ctx, out),
        None   => lower_type_assoc(be, id, c, a, ty, ctx, out),
    })
}

lower_type_assoc = (be :: CBackend, id: ExprId, c: Call, a: Access,
                    ty: TyId, ctx: Ctx, out :: String)
                   Res<bool, AllocError> {
    site_of(be, ty).try().match({
        None  => Ok(false),
        Ok(s) => assoc_at_site(be, id, c, a, ty, s, ctx, out),
    })
}

// ---------------------------------------------------------------------
// `module.name(..)`
//
// `sh = shape` then `sh.reseat(3)`. The base is not a type at all, so
// none of the machinery above applies: there is no site, no receiver and
// no member table, only a module and a name.
// ---------------------------------------------------------------------

// THE MODULE IS HALF THE QUESTION. Two modules may declare one top-level
// name, so the declaration is looked up in the module the alias names —
// and through the `*` gate, which is the same query sema typed the node
// with, so the two cannot mean different declarations.
lower_module_call = (be :: CBackend, id: ExprId, c: Call, a: Access,
                     mi: usize, ctx: Ctx, out :: String)
                    Res<bool, AllocError> {
    found ::= be.alloc.Vec<Def>();
    be.check.world.exported_defs(mi, a.name.text, found).try();
    found.get(0).match({
        None  => Ok(false),
        Ok(d) => lower_module_def(be, id, c, d, ctx, out),
    })
}

lower_module_def = (be :: CBackend, id: ExprId, c: Call, d: Def, ctx: Ctx,
                    out :: String) Res<bool, AllocError> {
    d.kind.match({
        FunctionDef => lower_module_fn(be, id, c, d, ctx, out),
        StructDef   => module_construct(be, id, c, d, ctx, out),
        _           => Ok(false),
    })
}

module_construct = (be :: CBackend, id: ExprId, c: Call, d: Def, ctx: Ctx,
                    out :: String) Res<bool, AllocError> {
    construct(be, id, c, d, ctx, out).try();
    Ok(true);
}

lower_module_fn = (be :: CBackend, id: ExprId, c: Call, d: Def, ctx: Ctx,
                   out :: String) Res<bool, AllocError> {
    decl_at(be.tree, d.id).match({
        None  => Ok(false),
        Ok(x) => x.kind.match({
            Function(f) => module_fn_decl(be, id, c, d, f, ctx, out),
            _           => Ok(false),
        }),
    })
}

// A NARROW PATH THAT REFUSES RATHER THAN GUESSES.
//
// `gen_c_call.zen` owns the general call — the loop intrinsic, inlining
// a lambda parameter, the bodiless floor — and every door into it starts
// by looking the name up from the CALLER's module, which is not where
// this declaration lives. Rebuilding that chain here would be a second
// answer to a question that has one, so the case with none of it is
// emitted and the rest is reported. The arguments are still written in
// the CALLER's `ctx`: a name inside an argument means what it means
// where it was written, not where the callee was declared.
module_fn_decl = (be :: CBackend, id: ExprId, c: Call, d: Def, f: Function,
                  ctx: Ctx, out :: String) Res<bool, AllocError> {
    inst ::= be.alloc.Inst();
    sig ::= be.alloc.Vec<TyId>();
    read = signature_of(be, d, inst, sig).try();
    (read && plain(f) && has_body(f)).match({
        false => refuse_module_fn(be, id, out),
        true  => write_module_call(be, c, d, f, sig, inst, ctx, out),
    })
}

has_body = (f: Function) bool {
    f.body.match({ Ok(_) => true, None => false })
}

refuse_module_fn = (be :: CBackend, id: ExprId, out :: String)
                   Res<bool, AllocError> {
    unsupported(be, id,
                "a generic or bodiless function reached through a module",
                out).try();
    Ok(true);
}

// The same symbol `gen_c_call.zen` writes for a plain call and the same
// queue entry, so the definition this links to is the one lowered for it.
write_module_call = (be :: CBackend, c: Call, d: Def, f: Function,
                     sig: Vec<TyId>, inst: Inst, ctx: Ctx, out :: String)
                    Res<bool, AllocError> {
    sym ::= be.alloc.String().try();
    sym_fn(sym, be.check.types, be.check.world, d.qname, sig, inst).try();
    be.need_function(d, inst, sym.view()).try();
    out.add_bytes(sym.view()).try();
    out.add_bytes("(").try();
    c.args.loop((h, i, arg) {
        write_assoc_arg(be, arg, i, f, sig, ctx, out).try();
    });
    out.add_bytes(")").try();
    Ok(true);
}

assoc_at_site = (be :: CBackend, id: ExprId, c: Call, a: Access, ty: TyId,
                 s: Site, ctx: Ctx, out :: String) Res<bool, AllocError> {
    found ::= be.alloc.Vec<Member>();
    member_at(be, s, a.name.text, found).try();
    kept ::= be.alloc.Vec<Member>();
    keep_assoc(be, found, ty, s, kept).try();
    // AT THE ARITY WRITTEN, and with no receiver every argument is one
    // of the declaration's own — which is the same rule a method call
    // reads two members of one name by, minus the receiver.
    by_arity(be, kept, c.args.len).match({
        None  => Ok(false),
        Ok(m) => assoc_member(be, id, c, a, ty, s, m, ctx, out),
    })
}

assoc_member = (be :: CBackend, id: ExprId, c: Call, a: Access, ty: TyId,
                s: Site, m: Member, ctx: Ctx, out :: String)
               Res<bool, AllocError> {
    m.kind.match({
        Function(f) => write_assoc_call(be, id, c, a, ty, s, f, ctx, out),
        _           => Ok(false),
    })
}

keep_assoc = (be :: CBackend, found: Vec<Member>, ty: TyId, s: Site,
              out :: Vec<Member>) Res<(), AllocError> {
    found.loop((h, m) { keep_if_assoc(be, m, ty, s, out).try() });
    Ok(());
}

keep_if_assoc = (be :: CBackend, m: Member, ty: TyId, s: Site,
                 out :: Vec<Member>) Res<(), AllocError> {
    m.kind.match({
        Function(f) => keep_receiverless(be, m, f, ty, s, out),
        _           => Ok(()),
    })
}

keep_receiverless = (be :: CBackend, m: Member, f: Function, ty: TyId,
                     s: Site, out :: Vec<Member>) Res<(), AllocError> {
    takes_receiver(be, f, ty, s).try().match({
        true  => Ok(()),
        false => out.add(m),
    })
}

// Is this member's first parameter the type itself? Resolved with
// `@Self` bound to the receiver, so `(self: @Self)` and `(self:
// Duration)` are one answer and neither depends on how it was spelled.
takes_receiver = (be :: CBackend, f: Function, ty: TyId, s: Site)
                 Res<bool, AllocError> {
    f.params.get(0).match({
        None  => Ok(false),
        Ok(p) => first_is_self(be, p, ty, s),
    })
}

first_is_self = (be :: CBackend, p: Param, ty: TyId, s: Site)
                Res<bool, AllocError> {
    sctx = be.check.self_ctx(s.decl.module.to_usize(), ty).try();
    mark = enter_struct_tparams(be, s.decl).try();
    declared = be.check.param_type(p, sctx).try();
    leave_tparams(be, mark).try();
    Ok(declared.eq(ty));
}

// The symbol is the TYPE's qualified name plus the member's, over the
// declared signature — `gen_c_member.zen`'s rule, and the reason two
// types' `zero` are two symbols without a counter.
write_assoc_call = (be :: CBackend, id: ExprId, c: Call, a: Access,
                    ty: TyId, s: Site, f: Function, ctx: Ctx, out :: String)
                   Res<bool, AllocError> {
    inst = recv_inst(be, ty).try();
    sig ::= be.alloc.Vec<TyId>();
    method_sig(be, ty, s.decl, f, s.decl.module.to_usize(), inst, sig).try();
    (inst_open(be, inst) || any_open(be, sig)).match({
        true  => refuse_open(be, id, out),
        false => emit_assoc_call(be, c, a, ty, s, f, sig, inst, ctx, out),
    })
}

// With no receiver the type's arguments have nowhere to come from, so
// saying so is the point: monomorphising at unknown would compile, and
// would be a different function.
refuse_open = (be :: CBackend, id: ExprId, out :: String)
              Res<bool, AllocError> {
    unsupported(be, id,
                "an associated function whose type arguments nothing settles",
                out).try();
    Ok(true);
}

emit_assoc_call = (be :: CBackend, c: Call, a: Access, ty: TyId, s: Site,
                   f: Function, sig: Vec<TyId>, inst: Inst, ctx: Ctx,
                   out :: String) Res<bool, AllocError> {
    qname ::= be.alloc.String().try();
    join(qname, s.qname, a.name.text).try();
    sym ::= be.alloc.String().try();
    sym_fn(sym, be.check.types, be.check.world, qname.view(), sig, inst).try();
    be.need_method(MethodRef(self_ty: ty, decl: s.decl, name: a.name.text,
                             sig: sig, qname: qname.view()),
                   inst, sym.view()).try();
    out.add_bytes(sym.view()).try();
    out.add_bytes("(").try();
    c.args.loop((h, i, arg) {
        write_assoc_arg(be, arg, i, f, sig, ctx, out).try();
    });
    out.add_bytes(")").try();
    Ok(true);
}

// A named helper rather than a `.then` inside the loop body: a loop
// binding read inside a nested closure does not resolve.
// docs/SEMA_BOOTSTRAP_FIXES.md §10.
write_assoc_arg = (be :: CBackend, arg: Arg, i: usize, f: Function,
                   sig: Vec<TyId>, ctx: Ctx, out :: String)
                  Res<(), AllocError> {
    (i > 0).match({
        true  => out.add_bytes(", "),
        false => Ok(()),
    }).try();
    write_arg(be, arg.value, i, f, sig, ctx, out)
}
