// numbers with no whitespace around them: 1+2 must lex as three tokens,
// and 1.5 must not become 1 . 5.
//
// The float half compares 1.5 against something OTHER than itself. A literal
// compared to a copy of itself says "yes" under any consistent misreading --
// 1.5 read as 15, as 1, or as 0 -- so the arithmetic below pins the value
// instead: only a 1.5 that really is one-and-a-half doubles to 3.0.
Error = AllocError | IoError

same = (a: f64, b: f64) str {
    (a == b).match({
        true  => "yes",
        false => "no",
    });
}

main = (env: Env) Res<i32, Error> {
    a:i32=1+2;
    b:i32=3*4;
    c:i32=2*3+4*5;
    d:i32=100-1;
    println("{}", a);
    println("{}", b);
    println("{}", c);
    println("{}", d);
    println("{}", same(1.5+1.5, 3.0));
    println("{}", same(1.5*2.0, 3.0));
    println("{}", same(1.5, 15.0));
    println("{}", same(1.5, 1.0));
    println("{}", same(1.5-0.5, 1.0));
    Ok(0);
}
