// src/fmt/fmt.zen
// Formats the compiler's parsed tree while preserving its token stream.
// Current rules normalize blank lines, trailing whitespace, selected
// alignment gaps, and over-wide lists. Declarations otherwise retain their
// source text. Files with lexical or syntactic faults are left unchanged.

Alloc, AllocError = std.mem
str, String = std.text
Vec = std.collections
Range = std.core
Pos, TriviaRun = std.ast.ast_span
Ast = std.ast.ast_arena
Module, Decl = std.ast.ast_node
scan, Source, Lexed, text_of = std.lex.lex
Diag, Parser, module = std.parse.parse

Src* = fmt.fmt_src
Out* = fmt.fmt_out
Aligned* = fmt.fmt_decl
align_columns = fmt.fmt_decl
break_lines = fmt.fmt_break

// The formatted bytes, source diagnostics, and token-preservation result.
Render* = {
    // Empty when formatting was refused.
    text*: String,

    // Non-empty diagnostics leave the source unchanged.
    diags*: Vec<Diag>,

    // False means a formatting rule changed a token.
    faithful*: bool,
}

// Formatting starts from an already-lexed file so lexical faults remain
// available to the caller.
render* = (a: Alloc, lexed: Lexed) Res<Render, AllocError> {
    src = a.Src(lexed.source.text).try();
    p ::= a.Parser(lexed);
    m = p.module(lexed.source.file).try();
    (p.diags.len == 0).match({
        false => rejected(a, p.diags),
        true  => printed(a, src, p.tree, m, lexed),
    })
}

rejected = (a: Alloc, diags: Vec<Diag>) Res<Render, AllocError> {
    Ok(Render(text: a.String().try(), diags: diags, faithful: false));
}

printed = (a: Alloc, src: Src, tree: Ast, m: Module, lexed: Lexed)
          Res<Render, AllocError> {
    out ::= a.Out().try();
    out.write_module(a, a.Aligned(src, tree, m).try(), src, tree, m).try();
    broke = break_lines(a, lexed.source.file, out.view()).try();
    text  = align_columns(a, lexed.source.file, broke.view()).try();
    ok    = unchanged_tokens(a, lexed, text.view()).try();
    Ok(Render(text: text, diags: a.Vec<Diag>(), faithful: ok));
}

// Print declarations and their trivia in source order.
write_module* = (
    out  :: Out,
    a    : Alloc,
    al   : Aligned,
    src  : Src,
    tree : Ast,
    m    : Module
) Res<(), AllocError> {
    m.decls.loop((h, i, d) {
        out.write_trivia(tree, d.leading).try();
        out.write_decl(a, al, src, tree, m, i, d).try();
    });
    out.write_trivia(tree, m.trailing).try();
    Ok(());
}

// Comments are copied as source slices and are not rewrapped.
write_trivia = (out :: Out, tree: Ast, run: TriviaRun) Res<(), AllocError> {
    Range(0, run.len).loop((h, i) {
        piece = tree.trivia_at(run, i);
        piece.kind.match({
            Blank => out.blank(),
            _     => out.say_at(piece.span.start.col, piece.text),
        }).try();
    });
    Ok(());
}

// Copy through the next printable item rather than stopping at Decl.span;
// trailing comments can belong to a declaration's last nested node.
write_decl = (
    out  :: Out,
    a    : Alloc,
    al   : Aligned,
    src  : Src,
    tree : Ast,
    m    : Module,
    i    : usize,
    d    : Decl
) Res<(), AllocError> {
    from = src.offset(d.span.start);
    to   = src.offset(next_start(tree, m, i));
    text = al.padded(
        a,
        src,
        from,
        src.trim_back(from, to),
        d.span.start.line
    ).try();
    out.say(text.view())
}

// Where the next thing this file prints begins: the following
// declaration's leading trivia, or the declaration itself, or — after
// the last one — whatever is left at end of file.
next_start = (tree: Ast, m: Module, i: usize) Pos {
    m.decls.get(i + 1).match({
        Ok(next) => run_start(tree, next.leading).match({
            Ok(p) => p,
            None  => next.span.start,
        }),
        None     => run_start(tree, m.trailing).match({
            Ok(p) => p,
            None  => m.span.end,
        }),
    })
}

run_start = (tree: Ast, run: TriviaRun) Res<Pos> {
    (run.len == 0).match({
        true  => None,
        false => Ok(tree.trivia_at(run, 0).span.start),
    })
}

// The formatted output must contain the same token kinds and bytes.
unchanged_tokens = (a: Alloc, before: Lexed, text: str) Res<bool, AllocError> {
    after = scan(a, Source(file: before.source.file, text: text)).try();
    Ok(after.is_clean() && same_stream(before, after));
}

same_stream = (before: Lexed, after: Lexed) bool {
    (before.tokens.len == after.tokens.len) && every_token_same(before, after)
}

every_token_same = (before: Lexed, after: Lexed) bool {
    ok ::= true;
    Range(0, before.tokens.len).loop((h, i) {
        token_same(before, after, i).match({
            true  => (),
            false => { ok = false; h.break(); },
        });
    });
    ok;
}

// Compare both kind and bytes so neither token identity nor spelling changes.
token_same = (before: Lexed, after: Lexed, i: usize) bool {
    before.tokens.get(i).match({
        None  => false,
        Ok(x) => after.tokens.get(i).match({
            None  => false,
            Ok(y) => x.kind == y.kind
                  && text_of(before.source, x).eq(text_of(after.source, y)),
        }),
    })
}
