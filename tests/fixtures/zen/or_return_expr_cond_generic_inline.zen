// .or_return() in CONDITIONAL position (a match-arm VALUE) inside a GENERIC fn — the Err path.
// resolve_orx wraps the Err-guard `return` inside a value block, which the inliner's early-return
// lift cannot see, so the generic must NOT be inlined (it monomorphizes via mono_rec instead).
// The callee's early Err-return must NOT escape into the caller: caller(0) must RECOVER via its
// own .Err arm. Exit 44 = the recovery value (an escaped return would skip it → main would see the
// raw Err and exit 200).
{ Result, IoError } = std.core.result
gk = (ok: i32) Result<i32, IoError> { (ok == 1).then({ .Ok(5) }, { .Err(.NotFound) }) }
pick<T> = (sel: i32, ok: i32, d: T) Result<i32, IoError> {
    v := (sel == 1).then({ gk(ok).or_return() }, { 70 })
    .Ok(v)
}
caller = (ok: i32) Result<i32, IoError> {
    a := pick(1, ok, 9).match ({
        .Ok(v)  => v,
        .Err(e) => 44,
    })
    .Ok(a)
}    // recovery proves the callee's early return did not escape into caller
main = () i32 {
    caller(0).match ({
        .Ok(v)  => v,
        .Err(e) => 200,
    })
}
