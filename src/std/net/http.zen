// src/std/net/http.zen
// HTTP/1.1 client built on std.net.tcp and std.net.tls. No new C floors:
// DNS is left to the stream constructors, and every byte is moved through
// the same Vec<u8>/String primitives the rest of std owns.

Alloc, AllocError, Ptr, null_ptr = std.mem
str, String, str_at = std.text
Res, ok_or = std.core
Drop = std.core
Sink, WriteError = std.core.io
Vec = std.collections
TcpStream, TcpError = std.net.tcp
TlsStream, TlsError = std.net.tls

HttpError* = ConnectFailed
    | TlsFailed
    | SendFailed
    | RecvFailed
    | DecodeFailed
    | BodyWriteFailed(WriteError)
    | Status(i32)

HttpResponseMeta* = {
    status*:             i32,
    content_length*:     usize,
    has_content_length*: bool,
    chunked*:            bool,
}

HttpResponse* = {
    status*: i32,
    body*:   String,
}

// ------------------------------------------------------------------
// URL parsing. Scheme, host, port and path are extracted in pure Zen.
// ------------------------------------------------------------------

ParsedUrl = {
    scheme: str,
    host:   str,
    port:   u16,
    path:   str,
}

parse_u16 = (s: str) Res<u16, HttpError> {
    (s.len > 0).match({
        false => Err(HttpError.DecodeFailed),
        true  => {
            acc: u16 = 0;
            ok ::= true;
            Range(0, s.len).loop((h, i) {
                b = s[i];
                (b >= '0' && b <= '9').match({
                    false => { ok = false; h.break(); },
                    true  => {},
                });
                digit = (b - '0').to_u16();
                limit = (u16.MAX - digit) / 10;
                (acc > limit).match({
                    true  => { ok = false; h.break(); },
                    false => {},
                });
                acc = acc * 10 + digit;
            });
            ok.match({
                true  => Ok(acc),
                false => Err(HttpError.DecodeFailed),
            });
        },
    });
}

default_port = (scheme: str) Res<u16, HttpError> {
    scheme.eq_ignore_case("http").match({
        true  => Ok(80),
        false => scheme.eq_ignore_case("https").match({
            true  => Ok(443),
            false => Err(HttpError.DecodeFailed),
        }),
    });
}

parse_url = (url: str) Res<ParsedUrl, HttpError> {
    colon = url.find(':').ok_or(HttpError.DecodeFailed).try();
    (colon + 2 < url.len).match({
        true  => Ok(()),
        false => Err(HttpError.DecodeFailed),
    }).try();
    (url.index(colon + 1) == '/' && url.index(colon + 2) == '/').match({
        true  => Ok(()),
        false => Err(HttpError.DecodeFailed),
    }).try();

    scheme = url.slice(0, colon);
    rest   = url.slice(colon + 3, url.len);

    slash     = rest.find('/').match({ Ok(i) => i, None => rest.len });
    host_port = rest.slice(0, slash);
    path      = (slash == rest.len).match({
        true  => "/",
        false => rest.slice(slash, rest.len),
    });

    host ::= "";
    port: u16 = 0;
    host_port.find(':').match({
        Ok(col) => {
            host = host_port.slice(0, col);
            port = parse_u16(host_port.slice(col + 1, host_port.len)).try();
        },
        None    => {
            host = host_port;
            port = default_port(scheme).try();
        },
    });

    Ok(ParsedUrl(scheme: scheme, host: host, port: port, path: path));
}

// ------------------------------------------------------------------
// Integer/text helpers used while building and parsing messages.
// ------------------------------------------------------------------

parse_i32 = (s: str) Res<i32, HttpError> {
    (s.len > 0).match({
        false => Err(HttpError.DecodeFailed),
        true  => {
            acc: i32 = 0;
            ok ::= true;
            Range(0, s.len).loop((h, i) {
                b = s[i];
                (b >= '0' && b <= '9').match({
                    false => { ok = false; h.break(); },
                    true  => {},
                });
                digit = (b - '0').to_i32();
                limit = (i32.MAX - digit) / 10;
                (acc > limit).match({
                    true  => { ok = false; h.break(); },
                    false => {},
                });
                acc = acc * 10 + digit;
            });
            ok.match({
                true  => Ok(acc),
                false => Err(HttpError.DecodeFailed),
            });
        },
    });
}

parse_usize = (s: str) Res<usize, HttpError> {
    (s.len > 0).match({
        false => Err(HttpError.DecodeFailed),
        true  => {
            acc: usize = 0;
            ok ::= true;
            Range(0, s.len).loop((h, i) {
                b = s[i];
                (b >= '0' && b <= '9').match({
                    false => { ok = false; h.break(); },
                    true  => {},
                });
                digit = (b - '0').to_usize();
                limit = (usize.MAX - digit) / 10;
                (acc > limit).match({
                    true  => { ok = false; h.break(); },
                    false => {},
                });
                acc = acc * 10 + digit;
            });
            ok.match({
                true  => Ok(acc),
                false => Err(HttpError.DecodeFailed),
            });
        },
    });
}

// ------------------------------------------------------------------
// Transport wrapper: one shape for plain TCP and TLS.
// ------------------------------------------------------------------

Stream = Tcp(TcpStream) | Tls(TlsStream)

http_from_tcp_err = (e: TcpError) HttpError {
    e.match({
        ConnectFailed => HttpError.ConnectFailed,
        WriteFailed   => HttpError.SendFailed,
        ReadFailed    => HttpError.RecvFailed,
        Closed        => HttpError.RecvFailed,
    });
}

http_from_tls_err = (e: TlsError) HttpError {
    e.match({
        ConnectFailed => HttpError.ConnectFailed,
        TlsFailed     => HttpError.TlsFailed,
        WriteFailed   => HttpError.SendFailed,
        ReadFailed    => HttpError.RecvFailed,
        Closed        => HttpError.RecvFailed,
    });
}

connect_stream = (a: Alloc, parsed: ParsedUrl) Res<Stream, HttpError> {
    parsed.scheme.eq_ignore_case("https").match({
        true  => TlsStream.connect(a, parsed.host, parsed.port).match({
            Ok(s)  => Ok(Stream.Tls(s)),
            Err(e) => Err(http_from_tls_err(e)),
        }),
        false => parsed.scheme.eq_ignore_case("http").match({
            true  => TcpStream.connect(a, parsed.host, parsed.port).match({
                Ok(s)  => Ok(Stream.Tcp(s)),
                Err(e) => Err(http_from_tcp_err(e)),
            }),
            false => Err(HttpError.DecodeFailed),
        }),
    });
}

stream_write = (s: Stream, bytes: str) Res<(), HttpError> {
    s.match({
        Tcp(t) => t.write(bytes).match({
            Ok(_)  => Ok(()),
            Err(e) => Err(http_from_tcp_err(e)),
        }),
        Tls(t) => t.write(bytes).match({
            Ok(_)  => Ok(()),
            Err(e) => Err(http_from_tls_err(e)),
        }),
    });
}

stream_read = (
    s   : Stream,
    a   : Alloc,
    buf :: Vec<u8>,
    n   : usize
) Res<usize, HttpError> {
    s.match({
        Tcp(t) => t.read(a, buf, n).match({
            Ok(g)  => Ok(g),
            Err(e) => Err(http_from_tcp_err(e)),
        }),
        Tls(t) => t.read(a, buf, n).match({
            Ok(g)  => Ok(g),
            Err(e) => Err(http_from_tls_err(e)),
        }),
    });
}

// Only a close-delimited body treats orderly transport close as its framing.
// Every other read path needs Closed to remain a premature RecvFailed.
stream_read_eof = (s: Stream, a: Alloc, buf :: Vec<u8>, n: usize)
                  Res<usize, HttpError> {
    s.match({
        Tcp(t) => t.read(a, buf, n).match({
            Ok(g)  => Ok(g),
            Err(e) => e.match({
                Closed => Ok(0),
                _      => Err(http_from_tcp_err(e)),
            }),
        }),
        Tls(t) => t.read(a, buf, n).match({
            Ok(g)  => Ok(g),
            Err(e) => e.match({
                Closed => Ok(0),
                _      => Err(http_from_tls_err(e)),
            }),
        }),
    })
}

stream_close = (s: Stream) () {
    s.match({
        Tcp(t) => t.close(),
        Tls(t) => t.close(),
    });
}

// The union owns the transport it wraps: a client error path between
// connect and close (a `.try()` in post) leaves scope through drop,
// which is the close the error path never spelled. The success path
// spells it as `stream_close(consume stream)` — the move disarms this
// drop, so the fd and the SSL context are released exactly once.
Stream.impl(Drop, {
    drop = (self :: @Self) () { stream_close(self) }
})

// ------------------------------------------------------------------
// Request assembly.
// ------------------------------------------------------------------

unit_or = (r: Res<(), AllocError>, to: HttpError) Res<(), HttpError> {
    r.match({
        Ok(_)  => Ok(()),
        Err(_) => Err(to),
    });
}

string_or = (r: Res<String, AllocError>, to: HttpError) Res<String, HttpError> {
    r.match({
        Ok(s)  => Ok(s),
        Err(_) => Err(to),
    });
}

build_request = (
    a       : Alloc,
    parsed  : ParsedUrl,
    headers : Vec<str>,
    body    : str
) Res<String, HttpError> {
    sb ::= string_or(a.String(), HttpError.SendFailed).try();

    unit_or(sb.add_bytes("POST "), HttpError.SendFailed).try();
    unit_or(sb.add_bytes(parsed.path), HttpError.SendFailed).try();
    unit_or(sb.add_bytes(" HTTP/1.1\r\nHost: "), HttpError.SendFailed).try();
    unit_or(sb.add_bytes(parsed.host), HttpError.SendFailed).try();
    unit_or(sb.add_bytes("\r\n"), HttpError.SendFailed).try();

    headers.loop((h, header) {
        unit_or(sb.add_bytes(header), HttpError.SendFailed).try();
        unit_or(sb.add_bytes("\r\n"), HttpError.SendFailed).try();
    });

    unit_or(sb.add_bytes("Content-Length: "), HttpError.SendFailed).try();
    unit_or(sb.fmt("{}", body.len), HttpError.SendFailed).try();
    unit_or(sb.add_bytes("\r\n\r\n"), HttpError.SendFailed).try();
    unit_or(sb.add_bytes(body), HttpError.SendFailed).try();

    Ok(sb);
}

// ------------------------------------------------------------------
// Response parsing.
// ------------------------------------------------------------------

find_crlf2 = (s: str) Res<usize> {
    (s.len >= 4).match({
        false => None,
        true  => {
            hit: Res<usize> = None;
            Range(0, s.len - 3).loop((h, i) {
                (s[i] == '\r' && s[i + 1] == '\n' && s[i + 2] == '\r' && s[i + 3] == '\n').match({
                    true  => { hit = Ok(i); h.break(0); },
                    false => {},
                });
            });
            hit;
        },
    });
}

parse_status_line = (line: str) Res<i32, HttpError> {
    first  = line.find(' ').ok_or(HttpError.DecodeFailed).try();
    after  = line.slice(first + 1, line.len);
    second = after.find(' ').match({ Ok(i) => i, None => after.len });
    code   = after.slice(0, second);
    parse_i32(code).try();
}

final_coding_is_chunked = (value: str) Res<bool, HttpError> {
    parts   ::= value.split(',');
    found   ::= false;
    chunked ::= false;
    loop((h) {
        parts.next().match({
            None    => h.break(),
            Ok(raw) => {
                coding = raw.trim().ok_or(HttpError.DecodeFailed).try();
                (coding.len > 0).match({
                    true  => Ok(()),
                    false => Err(HttpError.DecodeFailed),
                }).try();
                found   = true;
                chunked = coding.eq_ignore_case("chunked");
            },
        });
    });
    found.match({
        true  => Ok(chunked),
        false => Err(HttpError.DecodeFailed),
    })
}

parse_headers = (block: str) Res<HttpResponseMeta, HttpError> {
    (block.len <= HTTP_HEAD_MAX).match({
        true  => Ok(()),
        false => Err(HttpError.DecodeFailed),
    }).try();
    // the cursor door, not the Range one: every line is visited from
    // where the last ended, so a block of n bytes parses in O(n)
    // instead of one rescan per line
    lines ::= block.split('\n');
    status_line = lines.next().ok_or(HttpError.DecodeFailed).try();
    status      = parse_status_line(status_line).try();

    content_length ::= 0;
    found_length   ::= false;
    chunked        ::= false;

    loop((h) {
        lines.next().match({
            None    => h.break(),
            Ok(raw) => {
                line = raw.trim_end().ok_or(HttpError.DecodeFailed).try();
                (line.len == 0).match({ true => { h.break(); }, false => {} });

                colon = line.find(':').ok_or(HttpError.DecodeFailed).try();
                name  = line.slice(0, colon);
                value = line.slice(colon + 1, line.len).trim().ok_or(HttpError.DecodeFailed).try();

                name.eq_ignore_case("content-length").match({
                    true  => {
                        content_length = parse_usize(value).try();
                        found_length   = true;
                    },
                    false => {},
                });
                name.eq_ignore_case("transfer-encoding").match({
                    true  => { chunked = final_coding_is_chunked(
                        value
                    ).try(); },
                    false => {},
                });
            },
        });
    });

    Ok(HttpResponseMeta(
        status: status,
        content_length: content_length,
        has_content_length: found_length,
        chunked: chunked
    ));
}

HTTP_HEAD_MAX: usize = 65536

sink_write = (out :: Sink, bytes: str) Res<(), HttpError> {
    (bytes.len == 0).match({
        true  => Ok(()),
        false => out.write(bytes).match({
            Ok(_)  => Ok(()),
            Err(e) => Err(HttpError.BodyWriteFailed(e)),
        }),
    })
}

ChunkPhase = Size
    | Extension
    | SizeLf
    | Data
    | DataCr
    | DataLf
    | Trailer
    | TrailerLf
    | TrailerEndLf
    | Done

hex_value = (b: u8) Res<usize> {
    (b >= '0' && b <= '9').match({
        true  => Ok((b - '0').to_usize()),
        false => (b >= 'a' && b <= 'f').match({
            true  => Ok((b - 'a').to_usize() + 10),
            false => (b >= 'A' && b <= 'F').match({
                true  => Ok((b - 'A').to_usize() + 10),
                false => None,
            }),
        }),
    })
}

// Incremental HTTP chunk framing. `feed` may stop at any byte boundary;
// only Data slices reach the sink, while sizes, extensions and trailers are
// consumed here. The same decoder serves socket reads and offline parsing.
ChunkDecoder = {
    phase ::        ChunkPhase,
    size ::        usize,
    digits ::      usize,
    left ::        usize,
    trailer_has_bytes :: bool,

    done = (self: @Self) bool {
        self.phase.match({ Done => true, _ => false })
    }

    fail = (self: @Self) Res<(), HttpError> {
        Err(HttpError.DecodeFailed)
    }

    feed = (self :: @Self, bytes: str, out :: Sink)
           Res<(), HttpError> {
        at ::= 0;
        loop((h) {
            (at >= bytes.len || self.done()).match({
                true => h.break(), false => {}
            });
            self.phase.match({
                Size         => {
                    b = bytes[at]; at = at + 1;
                    hex_value(b).match({
                        Ok(d) => {
                            (self.size > (usize.MAX - d) / 16).match({
                                true  => self.fail().try(),
                                false => {},
                            });
                            self.size   = self.size * 16 + d;
                            self.digits = self.digits + 1;
                        },
                        None  => (b == ';' && self.digits > 0).match({
                            true  => { self.phase = ChunkPhase.Extension; },
                            false => (b == '\r' && self.digits > 0).match({
                                true  => { self.phase = ChunkPhase.SizeLf; },
                                false => self.fail().try(),
                            }),
                        }),
                    });
                },
                Extension    => {
                    b = bytes[at]; at = at + 1;
                    (b == '\r').match({
                        true  => { self.phase = ChunkPhase.SizeLf; },
                        false => (b == '\n').match({
                            true  => self.fail().try(),
                            false => {},
                        }),
                    });
                },
                SizeLf       => {
                    b = bytes[at]; at = at + 1;
                    (b == '\n').match({
                        false => self.fail().try(),
                        true  => (self.size == 0).match({
                            true  => { self.phase = ChunkPhase.Trailer; },
                            false => {
                                self.left  = self.size;
                                self.phase = ChunkPhase.Data;
                            },
                        }),
                    });
                },
                Data         => {
                    available = bytes.len - at;
                    take      = (self.left < available).match({
                        true => self.left, false => available
                    });
                    sink_write(out, bytes.slice(at, at + take)).try();
                    at        = at + take;
                    self.left = self.left - take;
                    (self.left == 0).match({
                        true  => { self.phase = ChunkPhase.DataCr; },
                        false => {},
                    });
                },
                DataCr       => {
                    b = bytes[at]; at = at + 1;
                    (b == '\r').match({
                        true  => { self.phase = ChunkPhase.DataLf; },
                        false => self.fail().try(),
                    });
                },
                DataLf       => {
                    b = bytes[at]; at = at + 1;
                    (b == '\n').match({
                        false => self.fail().try(),
                        true  => {
                            self.size   = 0;
                            self.digits = 0;
                            self.phase  = ChunkPhase.Size;
                        },
                    });
                },
                Trailer      => {
                    b = bytes[at]; at = at + 1;
                    (b == '\r').match({
                        true  => (!self.trailer_has_bytes).match({
                            true  => { self.phase = ChunkPhase.TrailerEndLf; },
                            false => { self.phase = ChunkPhase.TrailerLf; },
                        }),
                        false => (b == '\n').match({
                            true  => self.fail().try(),
                            false => { self.trailer_has_bytes = true; },
                        }),
                    });
                },
                TrailerLf    => {
                    b = bytes[at]; at = at + 1;
                    (b == '\n').match({
                        false => self.fail().try(),
                        true  => {
                            self.trailer_has_bytes = false;
                            self.phase             = ChunkPhase.Trailer;
                        },
                    });
                },
                TrailerEndLf => {
                    b = bytes[at]; at = at + 1;
                    (b == '\n').match({
                        true  => { self.phase = ChunkPhase.Done; },
                        false => self.fail().try(),
                    });
                },
                Done         => {},
            });
        });
        Ok(())
    }

    finish = (self: @Self) Res<(), HttpError> {
        self.done().match({ true => Ok(()), false => self.fail() })
    }
}

chunk_decoder = () ChunkDecoder {
    ChunkDecoder(
        phase: ChunkPhase.Size,
        size: 0,
        digits: 0,
        left: 0,
        trailer_has_bytes: false
    )
}

status_has_no_body = (status: i32) bool {
    (status >= 100 && status < 200) || status == 204 || status == 304
}

// One response body after its headers have been decoded. A sink write
// completes before the next socket read: a slow sink applies backpressure,
// and any WriteError stops the receive loop without consuming more bytes.
ResponseBody = {
    a:          Alloc,
    meta:       HttpResponseMeta,
    prefetched: str,

    into = (self: @Self, s: Stream, out :: Sink) Res<(), HttpError> {
        self.body_forbidden().match({
            true  => Ok(()),
            false => self.meta.chunked.match({
                true  => self.chunked(s, out),
                false => self.meta.has_content_length.match({
                    true  => self.known_length(s, out),
                    false => self.until_eof(s, out),
                }),
            }),
        })
    }

    body_forbidden = (self: @Self) bool {
        status_has_no_body(self.meta.status)
    }

    chunked = (self: @Self, s: Stream, out :: Sink)
              Res<(), HttpError> {
        dec ::= chunk_decoder();
        dec.feed(self.prefetched, out).try();
        chunk ::= self.a.Vec<u8>();
        loop((h) {
            dec.done().match({ true => h.break(), false => {} });
            got = stream_read(s, self.a, chunk, 4096).try();
            (got > 0).match({
                true  => Ok(()),
                false => Err(HttpError.RecvFailed),
            }).try();
            dec.feed(str_at(chunk.ptr(), got), out).try();
        });
        dec.finish()
    }

    known_length = (self: @Self, s: Stream, out :: Sink)
                   Res<(), HttpError> {
        take = (self.meta.content_length < self.prefetched.len).match({
            true  => self.meta.content_length,
            false => self.prefetched.len,
        });
        sink_write(out, self.prefetched.slice(0, take)).try();
        self.read_exact(s, self.meta.content_length - take, out)
    }

    read_exact = (self: @Self, s: Stream, n: usize, out :: Sink)
                 Res<(), HttpError> {
        left  ::= n;
        chunk ::= self.a.Vec<u8>();
        loop((h) {
            (left == 0).match({ true => h.break(), false => {} });
            ask = (left < 4096).match({ true => left, false => 4096 });
            got = stream_read(s, self.a, chunk, ask).try();
            (got > 0).match({
                true  => Ok(()),
                false => Err(HttpError.RecvFailed),
            }).try();
            sink_write(out, str_at(chunk.ptr(), got)).try();
            left = left - got;
        });
        Ok(())
    }

    until_eof = (self: @Self, s: Stream, out :: Sink)
                Res<(), HttpError> {
        sink_write(out, self.prefetched).try();
        chunk ::= self.a.Vec<u8>();
        loop((h) {
            got = stream_read_eof(s, self.a, chunk, 4096).try();
            (got == 0).match({ true => h.break(), false => {} });
            sink_write(out, str_at(chunk.ptr(), got)).try();
        });
        Ok(())
    }
}

// Headers are bounded by their terminator; body bytes are never accumulated.
// Each received body chunk is synchronously handed to `out` before another
// read, so backpressure and sink failure are visible at this API boundary.
read_response_into = (s: Stream, a: Alloc, out :: Sink)
                     Res<HttpResponseMeta, HttpError> {
    head ::= string_or(a.String(), HttpError.RecvFailed).try();

    found_end ::= false;
    chunk     ::= a.Vec<u8>();
    loop((h) {
        found_end.match({ true => h.break(), false => {} });
        got = stream_read(s, a, chunk, 4096).try();
        (got == 0).match({
            true  => h.break(),
            false => {
                unit_or(
                    head.add_bytes(str_at(chunk.ptr(), got)),
                    HttpError.RecvFailed
                ).try();
                find_crlf2(head.view()).match({
                    Ok(end) => (end + 4 <= HTTP_HEAD_MAX).match({
                        true  => { found_end = true; },
                        false => Err(HttpError.DecodeFailed).try(),
                    }),
                    None    => (head.view().len <= HTTP_HEAD_MAX).match({
                        true  => {},
                        false => Err(HttpError.DecodeFailed).try(),
                    }),
                });
            },
        });
    });

    end          = find_crlf2(head.view()).ok_or(HttpError.DecodeFailed).try();
    header_block = head.view().slice(0, end);
    info         = parse_headers(header_block).try();

    head_body = head.view().slice(end + 4, head.view().len);
    ResponseBody(a: a, meta: info, prefetched: head_body).into(s, out).try();
    Ok(info)
}

// Offline twin of the network path: metadata plus the same Sink/error
// contract, without allocating a second body buffer.
parse_response_into* = (raw: str, out :: Sink)
                       Res<HttpResponseMeta, HttpError> {
    end          = find_crlf2(raw).ok_or(HttpError.DecodeFailed).try();
    header_block = raw.slice(0, end);
    body_bytes   = raw.slice(end + 4, raw.len);
    meta         = parse_headers(header_block).try();

    status_has_no_body(meta.status).match({
        true  => {},
        false => meta.chunked.match({
            true  => {
                dec ::= chunk_decoder();
                dec.feed(body_bytes, out).try();
                dec.finish().try();
            },
            false => {
                take = (meta.has_content_length
                        && meta.content_length < body_bytes.len).match({
                    true  => meta.content_length,
                    false => body_bytes.len,
                });
                sink_write(out, body_bytes.slice(0, take)).try();
            },
        }),
    });
    Ok(meta)
}

// Existing allocating parser, kept as a String-sink compatibility wrapper.
parse_response* = (a: Alloc, raw: str) Res<HttpResponse, HttpError> {
    body ::= string_or(a.String(), HttpError.RecvFailed).try();
    meta = parse_response_into(raw, body).try();
    Ok(HttpResponse(status: meta.status, body: body));
}

// ------------------------------------------------------------------
// Public client.
// ------------------------------------------------------------------

HttpClient* = {
    // Streaming POST. `out.write` is the backpressure point: no next read
    // happens until it returns, and its exact WriteError is preserved in
    // BodyWriteFailed. HTTP error statuses are metadata here because their
    // response bodies are still useful to a streaming caller.
    post_into* = (self: @Self, a: Alloc, url: str, headers: Vec<str>,
                  body: str, out :: Sink)
                  Res<HttpResponseMeta, HttpError> {
        parsed = parse_url(url).try();
        req    = build_request(a, parsed, headers, body).try();
        stream = connect_stream(a, parsed).try();
        stream_write(stream, req.view()).try();
        meta = read_response_into(stream, a, out).try();
        // the move disarms the drop Stream carries, so this is the one
        // close; every `.try()` above exits through that drop instead
        stream_close(consume stream);
        Ok(meta)
    }

    // Compatibility API: buffer through String's Sink impl, then retain the
    // original >=400 Status behavior.
    post* = (self: @Self, a: Alloc, url: str, headers: Vec<str>, body: str)
            Res<HttpResponse, HttpError> {
        response_body ::= string_or(a.String(), HttpError.RecvFailed).try();
        meta     = self.post_into(a, url, headers, body, response_body).try();
        response = HttpResponse(status: meta.status, body: response_body);
        (meta.status >= 400).match({
            true  => Err(HttpError.Status(meta.status)),
            false => Ok(response),
        });
    }
}
