// `g = f` on a Drop type. DESIGN.md states this one as the REASON
// consume exists: "the compiler calls drop exactly once, so `g = f`
// on a Drop type cannot copy — both would drop".
//
// the move has to be written at the use site. there is no Clone
// trait and no implicit move: want a second one, construct a second
// one (corpus/own/consume_then_construct_again.zen).

Buf = {
    id: i32,
}

Buf.impl(Drop, {
    drop = (self :: @Self) () { /* nothing to release: id is bytes */ }
})

main = (env: Env) Res<i32, IoError> {
    f = Buf(id: 1);
    g = f;
    println("{}", g.id);
    Ok(0);
}
