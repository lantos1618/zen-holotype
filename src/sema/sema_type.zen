// Expression and block typing. `type_of` memoizes by `ExprId`; blocks use
// their trailing expression as their value. Calls, matches, member access,
// `.try()`, and written types delegate to their focused modules.

Expr, ExprId, Literal = std.ast
Decl, Const = std.ast
Block, BlockId, Stmt = std.ast
Binary, Unary, Bind, Match, Access, Call, Lambda = std.ast
ArrayLit, FixedArray, Index = std.ast
AllocError = std.mem
Vec = std.collections
str = std.text
TyId, TyArray = sema.sema_ty
Def, decl_at = sema.sema_def
SemaFault, NameFault = sema.sema_diag
Checker, Ctx, Binding = sema.sema_check
is_predicate = sema.sema_check
try_type = sema.sema_try
alias_module, module_not_a_value = sema.sema_module
match_type = sema.sema_match
access_type, computed_member = sema.sema_member
variant_type = sema.sema_static
call_type = sema.sema_call
meta_type = sema.sema_meta
meta_refused, walk_name, walk_projection_type = sema.sema_meta
WalkName = sema.sema_meta
bind_stmt = sema.sema_place
is_handle_ty, refuse_handle_at = sema.sema_handle
check_binary, check_index, check_literal = sema.sema_trap
element_agrees = sema.sema_trap
check_arms, check_arms_agree = sema.sema_hoist
check_statement = sema.sema_effect
check_eq = sema.sema_bound
operands_agree = sema.sema_operand
seed_left_spine, spine_ahead = sema.sema_spine
type_from_ast, self_type, declared_or_alias = sema.sema_denote

type_of* = (c :: Checker, id: ExprId, ctx: Ctx) Res<TyId, AllocError> {
    // A WALK'S PROJECTION IS ASKED AGAIN PER PASS (`sema_meta.zen`):
    // while the backend lowers one pass, a marked `recv.at(field)` is
    // the CURRENT field's type, not the memo's last one. A miss is this
    // function's ordinary question, below.
    c.walk_projection_type(id, ctx).try().match({
        Ok(ty) => Ok(ty),
        None   => c.rechecking().match({
            // inside a walk's per-field check the memo's READ is
            // bypassed — the body is typed again BECAUSE the answer
            // changes per field; the write in `compute_expr` stands.
            true  => c.compute_expr(id, ctx),
            false => c.expr_memo.get(id).match({
                None    => c.compute_expr(id, ctx),
                Ok(hit) => Ok(hit),
            }),
        }),
    })
}

compute_expr* = (c :: Checker, id: ExprId, ctx: Ctx)
               Res<TyId, AllocError> {
    poison = c.types.unknown().try();
    c.expr_memo.set(id, poison).try();
    node = c.tree.expr_at(id);
    got  = c.expr_kind(id, node, ctx).try();
    c.expr_memo.set(id, got).try();
    Ok(got);
}

// `id` is threaded beside `node` for the two kinds that record an answer
// under it: a call names a declaration, and a field access names the
// type that supplied it. An `Expr` is a value and carries no id, so a
// query that writes into a memo keyed on the node has to be told which
// node it is.
expr_kind* = (c :: Checker, id: ExprId, node: Expr, ctx: Ctx)
             Res<TyId, AllocError> {
    node.kind.match({
        Literal(l)    => c.literal_type(l),
        Unit          => c.types.prim("()"),
        SelfType      => c.self_type(ctx),
        Name(n)       => c.name_type(id, node, n.text, ctx),
        Paren(p)      => c.type_of(p.inner, ctx),
        Binary(b)     => c.binary_type(node, b, ctx),
        Unary(u)      => c.unary_type(node, u, ctx),
        Try(t)        => c.try_type(t.name_span, t.operand, t.error, ctx),
        Consume(x)    => c.type_of(x.operand, ctx),
        Block(b)      => c.block_type(b, ctx),
        Match(m)      => c.match_type(node, m, ctx),
        Access(a)     => c.access_type(id, node, a, ctx),
        Call(k)       => c.call_type(id, node, k, ctx),
        Array(a)      => c.array_lit_type(a, ctx),
        FixedArray(f) => c.fixed_array_type(f, ctx),
        Index(x)      => c.index_element_type(node, x, ctx),
        Meta(_)       => c.meta_type(node, ctx),
        _             => c.types.unknown(),
    })
}

// A CLOSURE'S SHAPE, WHICH IS ITS ARITY AND NOTHING ELSE: `sema.zen`
// says a closure "infers its parameter types FROM that signature, not
// the other way", so every slot is the `_` hole and only the count is
// known.
//
// NOT WHAT `expr_kind` ANSWERS, and deliberately. Poison is right for
// a closure a signature is about to supply — the ordinary
// `f.loop((h, v) { .. })` — and the price of poison is that it agrees
// with everything. Only a caller that knows no signature is coming
// asks for this instead; `sema_match.zen` is the one that does.
lambda_type* = (c :: Checker, l: Lambda) Res<TyId, AllocError> {
    hole = c.types.infer().try();
    params ::= c.alloc.Vec<TyId>();
    l.params.loop((h, p) { params.add(hole).try() });
    c.types.fn_ty(params, hole)
}

// `[0, 1, 2]` — a fixed array whose count is how many were written and
// whose element is the FIRST one's type ("the reading is chosen by what
// the elements ARE": nothing here is a type, so this is a literal). The
// rest are still typed, for their own diagnostics. An empty literal has
// no element to ask, and `_` is the honest answer — the same hole
// `Res<Cfg, _>` writes.
array_lit_type* = (c :: Checker, a: ArrayLit, ctx: Ctx)
                 Res<TyId, AllocError> {
    elem ::= c.types.infer().try();
    a.elems.loop((h, i, e) {
        got = c.type_of(e, ctx).try();
        (i == 0).then(() { elem = got; });
    });
    c.types.array(elem, a.elems.len)
}

// A fixed array's written element type is the expected type for each value.
// Check literal bounds and match-arm agreement here because no assignment,
// parameter, or field check surrounds an array element.
fixed_array_type* = (c :: Checker, f: FixedArray, ctx: Ctx)
                   Res<TyId, AllocError> {
    ty   = c.type_from_ast(f.type, ctx).try();
    elem = element_of(c, ty);
    f.elems.loop((h, e) {
        c.type_of(e, ctx).try();
        c.element_agrees(e, elem).try();
        c.check_literal(e, elem).try();
        c.check_arms(e, elem).try();
    });
    Ok(ty);
}

// A written array type that resolved to something else is a type
// somebody has already reported on, and it expects nothing of its
// elements.
element_of = (c: Checker, ty: TyId) TyId {
    c.types.at(ty).match({ Array(a) => a.elem, _ => ty })
}

// `buf[i]`. The element, when the receiver is a fixed array — the one
// place a literal index can be compared against a count, since both
// are known at once here. Everything else indexes through the `index`
// its type declares, the backend's question; it stays poison here.
index_element_type* = (c :: Checker, node: Expr, x: Index, ctx: Ctx)
                     Res<TyId, AllocError> {
    base = c.type_of(x.base, ctx).try();
    c.type_of(x.index, ctx).try();
    c.types.at(base).match({
        Array(a) => c.array_element(node, x, a),
        _        => c.types.unknown(),
    })
}

array_element = (c :: Checker, node: Expr, x: Index, a: TyArray)
               Res<TyId, AllocError> {
    c.check_index(node, x, a).try();
    Ok(a.elem);
}

// An integer literal is its own type until a context settles it —
// "a literal's type comes from its context". `int` and `float` are
// assignable to every width, and to nothing else.
literal_type* = (c :: Checker, l: Literal) Res<TyId, AllocError> {
    l.kind.match({
        Int   => c.types.prim("int"),
        Float => c.types.prim("float"),
        Str   => c.types.prim("str"),
        Char  => c.types.prim("u8"),
        Bool  => c.types.prim("bool"),
    })
}

// A bare identifier. A local shadows everything, then the module's
// own declarations, then what it imported — and the `*` gate is
// inside `defs_of`, not repeated here.
//
// A WALK'S TWO BINDERS ARE ASKED ABOUT FIRST (`sema_meta.walk_name`):
// their legal readings — `field.name`, `recv.at(field)`, `h.break()`,
// `h.next()` — never reach here, so a name that still does is the
// comptime term standing as a VALUE, and the wall answers.
name_type* = (c :: Checker, id: ExprId, node: Expr, text: str, ctx: Ctx)
            Res<TyId, AllocError> {
    c.walk_name(text).match({
        WalkNone => c.lookup(text).match({
            None  => c.unbound_name_type(node, text, ctx),
            Ok(b) => c.bound_name_type(id, b),
        }),
        _        => c.meta_refused(node),
    })
}

// A name answered out of the scope stack. The id is threaded so a use
// of a formal parameter is WRITTEN DOWN (`param_memo`): the binding is
// released at scope exit, and after it the LSP has no way to tell a
// parameter from a `let`-style local without this bit.
bound_name_type = (c :: Checker, id: ExprId, b: Binding)
                  Res<TyId, AllocError> {
    b.param.match({
        true  => c.param_memo.set(id, true),
        false => Ok(()),
    }).try();
    Ok(b.ty);
}

// `None` is the prelude's own variant: `Res<T>` is recognised
// structurally, so the value form is too. It carries no reason — that's
// what makes it an absence, not an error.
unbound_name_type* = (c :: Checker, node: Expr, text: str, ctx: Ctx)
                    Res<TyId, AllocError> {
    text.eq("None").match({
        true  => c.none_type(),
        false => c.global_name_type(node, text, ctx),
    })
}

none_type* = (c :: Checker) Res<TyId, AllocError> {
    hole = c.types.infer().try();
    c.types.res_absence(hole)
}

global_name_type* = (c :: Checker, node: Expr, text: str, ctx: Ctx)
                   Res<TyId, AllocError> {
    c.world.first_def_of(ctx.module, text).try().match({
        None  => c.variant_name_type(node, text, ctx),
        Ok(d) => c.value_def_type(node, d),
    })
}

// A MODULE IS A NAMESPACE, NOT A VALUE — the mistake is the USE, not
// the binding: `sh = shape` then `sh.reseat(3)` is a real pattern the
// corpus gates, but `println("{}", sh)` is not. The diagnostic lands
// here, naming the module the bare name stands for — the old error was
// "cannot print a value of this type".
value_def_type* = (c :: Checker, node: Expr, d: Def) Res<TyId, AllocError> {
    c.alias_module(d.id).match({
        None   => c.def_type(d),
        Ok(mi) => c.module_not_a_value(node.span, d.name, mi),
    })
}

// A BARE VARIANT: `Two` where a visible enum declares it, and no
// declaration of that name does. A declaration wins, and must:
// `Res*, Ok*, None* = std.core.result` puts variant names in scope
// everywhere, so a program declaring one of them means the declaration
// — the variant is what's left when nothing else answered.
variant_name_type* = (c :: Checker, node: Expr, text: str, ctx: Ctx)
                    Res<TyId, AllocError> {
    found ::= c.alloc.Vec<Def>();
    c.world.variant_defs(c.tree, ctx.module, text, found).try();
    found.get(0).match({
        None  => c.unresolved_name(node, text),
        Ok(d) => c.bare_variant_type(d, text),
    })
}

bare_variant_type = (c :: Checker, d: Def, text: str)
                   Res<TyId, AllocError> {
    ty = c.decl_as_type(d).try();
    c.variant_type(ty, text)
}

unresolved_name* = (c :: Checker, node: Expr, text: str)
                  Res<TyId, AllocError> {
    c.report(
        node.span.file,
        node.span,
        SemaFault.UndefinedName(NameFault(name: text))
    ).try();
    c.types.unknown()
}

// A name that denotes a DECLARATION rather than a value: a type used as
// a value is the type itself (`Shape.Unit` reads through it), a
// function's own type is what overload resolution narrows.
//
// A CONSTANT IS NOT ITS OWN TYPE, the one form here that isn't:
// `RES_PATH* : str = "std.core.result.Res"` binds a `str`, so reading
// the name as a nominal type `RES_PATH` failed every argument built
// from it against that `str` parameter — "no overload matches" on a
// call whose only irregularity was a named argument.
//
// AN ALIAS IS NOT ITS OWN TYPE EITHER, for the same reason:
// `Alias.Circle` is `Shape.Circle`. `declared_or_alias` is the
// written-type path's resolution, asked with no arguments.
def_type* = (c :: Checker, d: Def) Res<TyId, AllocError> {
    d.kind.match({
        ConstDef => c.const_type(d),
        AliasDef => c.def_alias_type(d),
        _        => c.decl_as_type(d),
    })
}

def_alias_type* = (c :: Checker, d: Def) Res<TyId, AllocError> {
    empty ::= c.alloc.Vec<TyId>();
    c.declared_or_alias(d, empty)
}

decl_as_type* = (c :: Checker, d: Def) Res<TyId, AllocError> {
    empty ::= c.alloc.Vec<TyId>();
    c.types.named(d.id, d.qname, d.name, empty)
}

// What a constant's name denotes: the type it was declared with, or —
// with none written — the type of the value it was bound to. Resolved
// in the declaring module, as `alias_written_type` is and for its reason.
const_type* = (c :: Checker, d: Def) Res<TyId, AllocError> {
    decl_at(c.tree, d.id).match({
        Ok(x) => c.const_decl_type(x, d),
        None  => c.types.unknown(),
    })
}

const_decl_type = (c :: Checker, x: Decl, d: Def) Res<TyId, AllocError> {
    poison = c.types.unknown().try();
    ctx    = Ctx(d.id.module.to_usize(), poison);
    x.kind.match({
        Const(k) => c.written_or_value(k, ctx),
        _        => c.types.unknown(),
    })
}

written_or_value = (c :: Checker, k: Const, ctx: Ctx) Res<TyId, AllocError> {
    k.type.match({
        Ok(t) => c.type_from_ast(t, ctx),
        None  => c.type_of(k.value, ctx),
    })
}

// `a == b` is `bool` whatever the operands are; `a + b` is the
// operands' type — both sides typed either way, since a diagnostic
// inside an unused operand is still a diagnostic.
//
// THE LEFT OPERAND IS SEEDED FIRST WHEN IT IS ITSELF AN OPERATOR
// (`sema_spine.zen`): an operator chain is left-nested and built with a
// loop, so `b.lhs` can be ten thousand levels deep and recursing
// segfaults. The seed types those levels bottom-up, the order this
// function reaches them anyway, so `type_of` below is a memo hit; the
// guard just keeps the walk's frame off the stack for an ordinary
// operand — most of them.
binary_type* = (c :: Checker, node: Expr, b: Binary, ctx: Ctx)
              Res<TyId, AllocError> {
    c.spine_ahead(b.lhs).match({
        false => Ok(()),
        true  => c.seed_left_spine(b.lhs, ctx),
    }).try();
    lhs     = c.type_of(b.lhs, ctx).try();
    rhs     = c.type_of(b.rhs, ctx).try();
    operand = c.arith_type(lhs, rhs).try();
    got     = is_predicate(b.op).match({
        true  => c.types.bool_ty(),
        false => Ok(operand),
    }).try();
    // a trap the compiler can prove will fire is a compile error, and
    // the operand types are what decides what fits
    c.check_binary(b, got).try();
    // `&&`/`||` short-circuit on a truth, so their operands are bools
    c.check_logical(b, lhs, rhs).try();
    // `==` dispatches to `Eq`, and a type with no impl has nothing to
    // call — the operand type is what says so, never the result's
    c.check_eq(b, operand).try();
    // AN OPERAND ANSWERS TO ITS PAIR — `sema_operand.zen` says how
    c.operands_agree(b, lhs, rhs).try();
    // AN OPERAND WRITES NO TYPE DOWN, so a match standing in one owes
    // only its own arms — `arith_type` above takes the join and never
    // asks what it was joined from, which is how `b.match({ true => 1,
    // false => false }) + 1` came out `2`.
    c.check_arms_agree(b.lhs).try();
    c.check_arms_agree(b.rhs).try();
    Ok(got);
}

// The wider of the two: a literal takes the other side's type, which
// is "a literal's type comes from its context" one level in.
arith_type* = (c :: Checker, lhs: TyId, rhs: TyId) Res<TyId, AllocError> {
    // the match yields a bare TyId and the `Ok` is outside it: two
    // arms that are both `Ok(..)` give the match no written type to
    // take from its first arm.
    Ok(c.is_literal_ty(lhs).match({
        true  => rhs,
        false => lhs,
    }));
}

unary_type* = (c :: Checker, node: Expr, u: Unary, ctx: Ctx)
             Res<TyId, AllocError> {
    inner = c.type_of(u.operand, ctx).try();
    u.op.match({
        Not  => c.check_not(u, inner),
        Neg  => Ok(inner),
        Addr => c.addr_type(node, u, inner, ctx),
    })
}

// `&c.width` on an impl-supplied field: there is no storage, so there is
// no address. The diagnostic lands on the address-of expression, which
// is where the `&` the author has to delete is.
addr_type* = (c :: Checker, node: Expr, u: Unary, inner: TyId, ctx: Ctx)
            Res<TyId, AllocError> {
    operand = c.tree.expr_at(u.operand);
    operand.kind.match({
        Access(a) => c.addr_of_access(node, a, inner, ctx),
        _         => Ok(inner),
    })
}

addr_of_access* = (
    c     :: Checker,
    node  : Expr,
    a     : Access,
    inner : TyId,
    ctx   : Ctx
) Res<TyId, AllocError> {
    c.computed_member(a, ctx).try().match({
        true  => c.no_address(node, a, inner),
        false => Ok(inner),
    })
}

no_address* = (c :: Checker, node: Expr, a: Access, inner: TyId)
             Res<TyId, AllocError> {
    c.report(
        node.span.file,
        node.span,
        SemaFault.ComputedFieldAddress(NameFault(name: a.name.text))
    ).try();
    Ok(inner);
}

// -----------------------------------------------------------------
// blocks
//
// "A block is a value too." Its value is the trailing expression
// written without a `;`, or — DESIGN.md — a `;`-terminated tail; the
// AST records only what was written, and this is where that's decided.
// -----------------------------------------------------------------

// A LOOP HANDLE IS NOT A VALUE, so no block EVALUATES to one. The
// question lives here and not at `check_return` because the loop body
// has no return-type slot to fail against: `check_return` only ever
// sees a function body, so `{ h }` as the tail of `.loop((h, x) {..})`
// passed sema in silence and gen_c emitted `(void)(zu_l1h);`, refused
// by cc alone. Asked once, where every block's value is decided.
//
// BOTH SPELLINGS ARE ASKED, because they compile to the same C: the
// written value, and the `;`-terminated last statement a block falls
// out through. `sema_hoist.tail_expr` reads only the first, which is
// why the fallback lives beside the reader of `Block.value`.
refuse_handle_tail* = (c :: Checker, block: Block, got: TyId)
                      Res<(), AllocError> {
    tail_node(block).match({
        None   => Ok(()),
        Ok(id) => c.is_handle_ty(got).match({
            false => Ok(()),
            true  => c.refuse_handle_at(id),
        }),
    })
}

tail_node = (block: Block) Res<ExprId> {
    block.value.match({
        Ok(v) => Ok(v),
        None  => last_stmt_expr(block),
    })
}

last_stmt_expr = (block: Block) Res<ExprId> {
    n = block.stmts.len;
    (n > 0).match({
        false => None,
        true  => block.stmts.get(n - 1).match({
            None  => None,
            Ok(s) => s.kind.match({
                Expr(e) => Ok(e.expr),
                _       => None,
            }),
        }),
    })
}

block_type* = (c :: Checker, id: BlockId, ctx: Ctx)
              Res<TyId, AllocError> {
    mark  = c.mark();
    outer = c.enter_block();
    block = c.tree.block_at(id);
    tail  = c.walk_stmts(block, ctx).try();
    got   = block.value.match({
        Ok(e) => c.type_of(e, ctx),
        None  => Ok(tail),
    }).try();
    c.refuse_handle_tail(block, got).try();
    c.leave_block(outer);
    c.release(mark).try();
    Ok(got);
}

// Every statement, in order, so a binding is in scope for the ones
// after it. The last statement's type is carried out because a
// `;`-terminated tail closes a function: "`0;` closes a Res<i32, E>
// function like `Ok(0);` does".
walk_stmts* = (c :: Checker, block: Block, ctx: Ctx)
             Res<TyId, AllocError> {
    last ::= c.types.prim("()").try();
    n = block.stmts.len;
    block.stmts.loop((h, i, s) {
        last = c.stmt_type(s, ctx).try();
        c.check_statement(block, i, n, s, last).try();
    });
    Ok(last);
}

stmt_type* = (c :: Checker, s: Stmt, ctx: Ctx) Res<TyId, AllocError> {
    s.kind.match({
        Expr(e)  => c.type_of(e.expr, ctx),
        Bind(b)  => c.bind_stmt(b, ctx),
        Block(b) => c.block_type(b, ctx),
        Decl(_)  => c.types.prim("()"),
    })
}

// `target = value;` is its own subject and lives in `sema_place.zen`:
// a declaration and a write are one statement here, and telling them
// apart is a question about the TARGET rather than about any node.
