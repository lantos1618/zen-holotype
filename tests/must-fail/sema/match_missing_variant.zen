// Gone has no arm and there is no `_`. match is always exhaustive, so
// this is an error rather than a silent fallthrough.
//
// position: the match expression (its receiver).

Slot = Left(i32) | Right(i32) | Gone

describe = (env: Env, s: Slot) () {
    s.match({
        Left(n)  => println("left {}", n),
        Right(n) => println("right {}", n),
    });
}

main = (env: Env) Res<i32, AllocError> {
    describe(env, Slot.Gone);
    Ok(0);
}
