// U+FFFD (EF BF BD), the replacement character, as DATA. A decoder
// that emits U+FFFD for bad input -- the conventional move -- would
// print identical bytes here and look correct while corrupting valid
// text. It must decode to exactly 65533, count once, and occupy 3
// bytes; nothing in this input is invalid, so no substitution may fire.
Utf8Error = std.text.text_utf8

main = (env: Env) Res<i32, Utf8Error> {
    s = "�";
    println("len {} cps {}", s.len, s.count_codepoints().try());
    s.codepoint_at(0).match({
        Ok(c) => println("U+{} l{}", c.value, c.len),
        Err(_) => println("bad"),
    });
    Ok(0);
}
