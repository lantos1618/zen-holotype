// `_` already covers everything below it, so the Gone arm can never run.
// an unreachable arm is a mistake about what the code does, and is
// rejected rather than dropped.
//
// position: the unreachable arm's pattern.

Slot = Left(i32) | Right(i32) | Gone

describe = (env: Env, s: Slot) () {
    s.match({
        Left(n) => println("left {}", n),
        _       => println("other"),
        Gone    => println("gone"),
    })
}

main = (env: Env) Res<i32, AllocError> {
    describe(env, Slot.Gone);
    Ok(0);
}
