Alloc, AllocError = std.mem
str, String = std.text
Range = std.core

FIRST*: usize = 1

Out* = {
    // Writes mutate this buffer, so it must be borrowed mutably.
    text* :: String,

    // Anything at all has been written. Until it has, an owed blank
    // separates the start of the file from its first line, which is
    // nothing.
    started :: bool = false,

    // A blank line is due before the next content.
    owed :: bool = false,

    say* = (self :: @Self, s: str) Res<(), AllocError> {
        self.say_at(FIRST, s)
    }

    say_at* = (self :: @Self, col: usize, s: str) Res<(), AllocError> {
        self.open().try();
        Range(FIRST, col).loop((h, i) { self.text.add(' ').try() });
        self.text.add(s).try();
        self.text.add('\n')
    }

    blank* = (self :: @Self) Res<(), AllocError> {
        self.owed = true;
        Ok(());
    }

    open = (self :: @Self) Res<(), AllocError> {
        (self.owed && self.started).then(() {
            self.text.add('\n').try();
        });
        self.owed    = false;
        self.started = true;
        Ok(());
    }

    view* = (self: @Self) str { self.text.view() }
}

// Allocates its buffer up front, like `Emit`.
Out* = (a: Alloc) Res<Out, AllocError> {
    Ok(Out(text: a.String().try()));
}
