// THE MATCH'S VALUE IS THE PAYLOAD BINDING, READ FROM EACH ARM. Each
// match binds its payload and delivers the arm's value to the match's own
// result slot; the failure this pins is an arm delivering from the WRONG
// place -- the scrutinee, or the previous match's slot -- which crosses
// the numbers: 40 where 41 belongs, 41 where 30 belongs. Valid C,
// printable, quietly wrong; nothing rejects it.
//
// Four widths on purpose: i64, None (no member read at all -- the slot
// must still receive 30), f64 (a float member through the union), u8.
// The None case is the one a tag-only backend cannot fake: no binding is
// in scope, so whatever lands in the slot came from the ARM.

main = (env: Env) Res<i32, AllocError> {
    a: Res<i64> = Ok(40);
    x: i64 = a.match({
        Ok(v)  => v + 1,
        None   => 0,
    });
    println("x {}", x);

    b: Res<i64> = None;
    y: i64 = b.match({
        Ok(v)  => v,
        None   => 30,
    });
    println("y {}", y);

    d: Res<f64> = Ok(0.25);
    z: f64 = d.match({
        Ok(v)  => v * 4.0,
        None   => 9.0,
    });
    println("z {}", z);

    s: Res<u8> = Ok(65);
    t: u8 = s.match({
        Ok(c)  => c + 1,
        None   => 0,
    });
    println("t {}", t);
    Ok(0);
}
