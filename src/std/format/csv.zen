// CSV rows are allocator-owned [[StringView]]. Quoted fields may contain delimiters and newlines;
// doubled quotes decode to one quote. Unterminated quotes return .Eof; allocation failure is fatal.
// LF and CRLF parse identically; blank lines and a trailing newline add no row. There is no release
// helper for a successful parse: free field/backbone allocations with the same allocator, or parse
// from an arena and reset it. A failed parse hands back no pointers, so it frees its own scratch.
{ AllocatorBackend, release_slice } = std.mem.alloc
{ Result, IoError, expect } = std.core.result
{ String, new_in, push_in, append_in, finish_in, free_in } = std.text.string
{ view, own_ptr } = std.text.str
{ loop_at, step_while } = std.core.count
{ Vec, vec_in } = std.collections.vec
cok = (r: Result<String, IoError>) String { r.expect("std.csv: allocation failed") }
cfin = (r: Result<StringCstr, IoError>) StringView { r.expect("std.csv: allocation failed") }
cnew = (a: AllocatorBackend) String { a.new_in().expect("std.csv: allocation failed") }
// Spelled out per element type rather than once over `<T>`: the element type has to reach `vec_in`
// through an annotated binding, and a wrapper's own `T` is not that.
crows = (a: AllocatorBackend) Vec<MutSlice<StringView>> {
    v: Result<Vec<MutSlice<StringView>>, IoError> = a.vec_in(1)
    v.expect("std.csv: allocation failed")
}
crow = (a: AllocatorBackend) Vec<StringView> {
    v: Result<Vec<StringView>, IoError> = a.vec_in(1)
    v.expect("std.csv: allocation failed")
}
cpush<T> = (v: Vec<T>, a: AllocatorBackend, x: T) Vec<T> {
    v.push(a, x).expect("std.csv: allocation failed")
}
// ── parse ──────────────────────────────────────────────────────────────────────────
// What one input byte means. `Escaped` is the `""` pair — the only token wider than a byte, which is
// why the scan carries an explicit cursor instead of a plain index loop. `Skip` is a bare CR: the
// carriage return of a CRLF, dropped so both line endings parse identically.
CsvTok: Byte(u8) | Quote | Escaped | Sep | End | Skip
csv_tok = (sv: Slice<u8>, i: i64, quoted: bool) CsvTok {
    b = sv[i]
    (b == '"').then({
        (quoted && i + 1 < sv.len && sv[i + 1] == '"').then({
            return .Escaped
        })
        return .Quote
    })
    quoted.then({
        return .Byte(b)
    })    // commas / CR / LF are literal while quoted
    (b == ',').then({
        return .Sep
    })
    (b == '\n').then({
        return .End
    })
    (b == '\r').then({
        return .Skip
    })
    .Byte(b)
}
// An unterminated quote returns Err, so nothing built is reachable from the result: release every
// field, every record backbone, and the in-progress builder rather than abandoning the scratch.
csv_abandon = (
    a: AllocatorBackend,
    rows: Vec<MutSlice<StringView>>,
    row: Vec<StringView>,
    sb: String,
) void {
    rows
        .view()
        .loop_at((i, r) {
            done: MutSlice<StringView> = r
            done.loop_at((j, f) { a.release(f.own_ptr()) })
            a.release_slice(done)
        })
    row.view().loop_at((j, f) { a.release(f.own_ptr()) })
    sb.free_in(a)
    row.free(a)
    rows.free(a)
}
parse* = (a: AllocatorBackend, text: StringView) Result<MutSlice<MutSlice<StringView>>, IoError> {
    sv: Slice<u8> = text.view()
    rows :: Vec<MutSlice<StringView>> = a.crows()
    fields :: Vec<StringView> = a.crow()
    sb :: String = a.cnew()
    quoted ::= false
    active ::= false    // is a record in progress? a blank line and a trailing LF add no row
    pos ::= 0
    pos = pos.step_while((i) { i < sv.len }, (i) {
        csv_tok(sv, i, quoted).match ({
            .Byte(c) => {
                sb = sb.push_in(a, c).cok()
                active = true
                i + 1
            },
            .Escaped => {
                sb = sb.push_in(a, '"').cok()    // "" inside a quoted field -> one literal quote
                i + 2
            },
            .Quote   => {
                quoted = quoted == false
                active = true
                i + 1
            },
            .Sep     => {
                fields = fields.cpush(a, sb.finish_in(a).cfin())    // end field
                sb = a.cnew()
                active = true
                i + 1
            },
            .End     => {
                active.then({
                    fields = fields.cpush(a, sb.finish_in(a).cfin())    // end field, then end record
                    rows = rows.cpush(a, fields.view())
                    fields = a.crow()
                    sb = a.cnew()
                    active = false
                })
                i + 1
            },
            .Skip    => i + 1,
        })
    })
    quoted.then({
        a.csv_abandon(rows, fields, sb)
        bad: Result<MutSlice<MutSlice<StringView>>, IoError> = .Err(.Eof)
        return bad
    })
    active.match ({
        true  => {
            fields = fields.cpush(a, sb.finish_in(a).cfin())    // flush the final unterminated record
            rows = rows.cpush(a, fields.view())
        },
        // No record in progress (the usual case — the text ended with a newline): the builder and
        // field backbone opened for the NEXT record are dead, and neither is reachable from the
        // returned rows. Free them, or every parse leaks one of each.
        false => {
            sb.free_in(a)
            fields.free(a)
        },
    })
    out: Result<MutSlice<MutSlice<StringView>>, IoError> = .Ok(rows.view())
    out
}
// ── write_rows ─────────────────────────────────────────────────────────────────────
// does `s` need quoting? (contains a delimiter, a quote, or a line break)
field_needs_quote = (s: StringView) bool {
    sv: Slice<u8> = s.view()
    sv.loop_at((i, b) {
        (b == ',' || b == '"' || b == '\n' || b == '\r').then({
            return true
        })
    })
    false
}
// append `s` to the builder as one CSV field, quoting (and doubling embedded quotes) if required.
write_field = (a: AllocatorBackend, sb: String, s: StringView) String {
    (s.field_needs_quote() == false).then({
        return sb.append_in(a, s).cok()
    })
    sv: Slice<u8> = s.view()
    out :: String = sb.push_in(a, '"').cok()
    sv.loop_at((i, b) {
        (b == '"').then({
            out = out.push_in(a, '"').cok()
        })    // an embedded quote is doubled
        out = out.push_in(a, b).cok()
    })
    out.push_in(a, '"').cok()
}
// Render `rows` to a single CSV view: fields joined by commas, records terminated by LF (including
// a trailing LF after the last record). Round-trips through `parse`. Returns Ok always (allocation
// failure is fatal by policy); the Result signature mirrors parse and the rest of std.
write_rows* = (
    a: AllocatorBackend,
    rows: MutSlice<MutSlice<StringView>>,
) Result<StringView, IoError> {
    out :: String = a.cnew()
    rows.loop_at((i, row) {
        r: MutSlice<StringView> = row
        r.loop_at((j, f) {
            (j > 0).then({
                out = out.push_in(a, ',').cok()
            })
            out = a.write_field(out, f)
        })
        out = out.push_in(a, '\n').cok()
    })
    .Ok(out.finish_in(a).cfin())
}
