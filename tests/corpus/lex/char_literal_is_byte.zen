// a char literal IS its byte value: str is BYTES, indexing yields u8,
// so 'a' and 97 are the same u8 and must compare equal.
Error = AllocError | IoError

same = (a: u8, code: u8) str {
    (a == code).match({
        true  => "yes",
        false => "no",
    });
}

main = (env: Env) Res<i32, Error> {
    println("{}", same(' ', 32));
    println("{}", same('0', 48));
    println("{}", same('9', 57));
    println("{}", same(':', 58));
    println("{}", same('A', 65));
    println("{}", same('a', 97));
    println("{}", same('\n', 10));
    println("{}", same('\t', 9));
    println("{}", same('\'', 39));
    println("{}", same('\\', 92));
    println("{}", same('a', 98));
    Ok(0);
}
