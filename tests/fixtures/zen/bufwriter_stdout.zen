// std.io.bufwriter acceptance: a tiny 4-byte buffer forces auto-flush mid-stream, and the assembled
// output must be byte-exact (no loss/dup at flush boundaries), binary-safe, and complete after close.
{ Malloc } = std.mem.alloc
{ stdout_bufw_in, bufw_write, bufw_println, bufw_write_bytes, bufw_close } = std.io.bufwriter
main = () i32 {
    m := Malloc(_: 0)
    a := m.addr()
    w := a.stdout_bufw_in(4).expect("oom")
    wp := w.addr()
    wp.bufw_write(a, "abcdef").or(0)
    wp.bufw_println(a, "gh").or(0)
    b: [u8] := [88, 89]
    wp.bufw_write_bytes(a, b).or(0)
    wp.bufw_close(a).or(0)
    0
}
