// src/gen/gen_c/gen_c_fs.zen
// THE FILESYSTEM CAPABILITY, in C.
//
// `gen_c_cap.zen` is the other half — the members whose body IS the
// backend, and the memory ones. This is the four `Fs` declares, and
// they are a subject of their own for a reason the code makes plain:
// three of them are a `stat` and a `fopen`, and the fourth ALLOCATES.
//
// A PATH ARRIVES AS A `str`, which borrows its bytes and is therefore
// NOT NUL-terminated, and the kernel wants a NUL. The copy happens in
// the C floor rather than here: `exists` has no `Alloc` in its
// signature, so by law 1 it may not have any memory either.
//
// `read` IS THE ONE THAT ALLOCATES, and it does it THROUGH A BOUND: it
// takes an `Alloc`, which is "an ordinary struct whose fields happen to
// be functions", so the value it was handed is a fat value and the
// buffer comes out of a call through that record. It is the only place
// in the backend that calls through one without a call node to lower.
//
// THE C FLOOR ANSWERS WITH AN ORDINAL and this turns it back into a
// variant BY NAME, so `env.zen` may rename or reorder its own error set
// without the backend agreeing to it in secret. The ordinals are the
// floor's own, written down in exactly one place at each end.

Ast, Expr, ExprKind, ExprId, Decl, DeclKind, Struct, Member, MemberKind = ast
Function, Access, Call, Arg, Span, Ident, TypeId = ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId, Ty, Types, TyNamed = sema.sema_ty
World, Def = sema.sema_def
Checker, Ctx = sema.sema_check
write_usize = sema.sema_diag
sym_member, sym_variant, sym_gen, RES_PATH = gen.gen_name
GenFault = gen.gen_diag
CBackend = gen.gen_c.gen_c_state
unsupported = gen.gen_c.gen_c_state
ctype, request_type = gen.gen_c.gen_c_type
expr = gen.gen_c.gen_c_expr
declare_temp, payload_type = gen.gen_c.gen_c_flow
Slot = gen.gen_c.gen_c_fat
slot_call = gen.gen_c.gen_c_bound
assign, arg_text, field_of = gen.gen_c.gen_c_cap
write_assign_ok, write_assign_ok_unit, write_assign_err = gen.gen_c.gen_c_cap

// -----------------------------------------------------------------
// the filesystem
//
// A path arrives as a `str`, which borrows its bytes and is therefore
// NOT NUL-terminated, and the kernel wants a NUL. The copy happens in
// the C floor rather than here: `exists` has no `Alloc` in its
// signature, so by law 1 it may not have any memory either.
//
// EVERY PATH IS SPILLED INTO A TEMPORARY FIRST. A `str` is a pointer
// and a count, both of which are read, so an argument that is a call
// would otherwise be made twice.
// -----------------------------------------------------------------

// `exists` and `is_dir`: one `stat`, and no failure a caller acts on.
// A path that cannot be stat'd is, for the purpose of "should I try to
// open this", a path that is not there.
lower_probe* = (be :: CBackend, c: Call, name: str, ctx: Ctx, out :: String)
              Res<(), AllocError> {
    be.need_fs();
    path ::= be.alloc.String().try();
    path_args(be, c, 0, ctx, path).try();
    out.add_bytes("(zg_fs_kind(").try();
    out.add_bytes(path.view()).try();
    out.add_bytes(")").try();
    out.add_bytes(probe_test(name)).try();
    out.add_bytes(")").try();
    Ok(());
}

probe_test = (name: str) str {
    name.eq("is_dir").match({ true => " == 1", false => " >= 0" })
}

// `write`: the whole file at once, the mirror of `read`. It takes no
// `Alloc` because it allocates nothing — the bytes are the caller's and
// stay the caller's — which is also why it is the half of the pair this
// backend can write today.
lower_write* = (be :: CBackend, id: ExprId, c: Call, ret: TyId, ctx: Ctx,
               out :: String) Res<(), AllocError> {
    be.need_fs();
    i32_ty = be.check.types.prim("i32").try();
    path ::= be.alloc.String().try();
    path_args(be, c, 0, ctx, path).try();
    data ::= be.alloc.String().try();
    path_args(be, c, 1, ctx, data).try();
    rc ::= be.alloc.String().try();
    sym_gen(rc, "t", be.next_tmp()).try();
    dst ::= be.alloc.String().try();
    sym_gen(dst, "t", be.next_tmp()).try();
    declare_temp(be, i32_ty, rc.view()).try();
    declare_temp(be, ret, dst.view()).try();
    write_fs_call(be, rc.view(), "zg_fs_write(", path.view(), data.view()).try();
    open_rc_test(be, rc.view()).try();
    fs_chain(be, ret, rc.view(), dst.view(), 1).try();
    close_else(be).try();
    write_assign_ok_unit(be, ret, dst.view()).try();
    close_block(be).try();
    out.add_bytes(dst.view())
}

write_fs_call = (be :: CBackend, rc: str, fn: str, first: str, second: str)
                Res<(), AllocError> {
    line ::= be.alloc.String().try();
    line.add_bytes(rc).try();
    line.add_bytes(" = ").try();
    line.add_bytes(fn).try();
    line.add_bytes(first).try();
    line.add_bytes(", ").try();
    line.add_bytes(second).try();
    line.add_bytes(");").try();
    be.writeln(line.view())
}

// `(const unsigned char *)<tmp>.data, <tmp>.len` — the two halves of a
// `str`, spilled once. `str` is the one type whose C representation is
// the runtime floor's rather than its declaration's, so its fields are
// spelled the floor's way and not the mangler's.
path_args* = (be :: CBackend, c: Call, i: usize, ctx: Ctx, out :: String)
            Res<(), AllocError> {
    sty = be.check.types.prim("str").try();
    tmp ::= be.alloc.String().try();
    sym_gen(tmp, "t", be.next_tmp()).try();
    declare_temp(be, sty, tmp.view()).try();
    value ::= be.alloc.String().try();
    arg_text(be, c, i, sty, ctx, value).try();
    assign(be, tmp.view(), value.view()).try();
    out.add_bytes("(const unsigned char *)").try();
    out.add_bytes(tmp.view()).try();
    out.add_bytes(".data, ").try();
    out.add_bytes(tmp.view()).try();
    out.add_bytes(".len").try();
    Ok(());
}

// -----------------------------------------------------------------
// `fs.read(alloc, path)` — THE CAPABILITY THAT ALLOCATES
//
// `Fs.read` takes an `Alloc` and puts the file in a buffer it hands
// out. An `Alloc` is a BOUND — "an ordinary struct whose fields happen
// to be functions" — so the value the caller passed is a FAT VALUE, and
// this is the one place in the backend that calls through a record it
// did not lower a call node for.
//
// THE `String` IS WRITTEN FIELD BY FIELD, which is the same licence
// `lower_alloc` takes with an `ArenaState` and for the same reason: the
// memory enters the program here, so the one place that knows the shape
// is the place the value is born. `len` is what ARRIVED and `capacity`
// is what was asked for — a short read must not leave a String claiming
// bytes nobody ever wrote, and the run really is `want` wide, which is
// what a later grow may reuse.
// -----------------------------------------------------------------

lower_read* = (be :: CBackend, id: ExprId, c: Call, ret: TyId, aty: TyId,
              ctx: Ctx, out :: String) Res<(), AllocError> {
    be.need_fs();
    payload_type(be, ret, "Ok").match({
        None    => unsupported(be, id, "Fs.read must return a Res<String, FsError>", out),
        Ok(sty) => read_string(be, id, c, ret, sty, aty, ctx, out),
    })
}

read_string = (be :: CBackend, id: ExprId, c: Call, ret: TyId, sty: TyId,
               aty: TyId, ctx: Ctx, out :: String) Res<(), AllocError> {
    field_of(be, sty, "data").try().match({
        None    => unsupported(be, id, "Fs.read must return a Res<String, FsError>", out),
        Ok(vty) => read_run(be, id, c, ret, sty, vty, aty, ctx, out),
    })
}

read_run = (be :: CBackend, id: ExprId, c: Call, ret: TyId, sty: TyId,
            vty: TyId, aty: TyId, ctx: Ctx, out :: String)
           Res<(), AllocError> {
    usize_ty = be.check.types.prim("usize").try();
    i32_ty = be.check.types.prim("i32").try();
    request_type(be, sty).try();
    request_type(be, vty).try();
    path ::= be.alloc.String().try();
    path_args(be, c, 1, ctx, path).try();
    al ::= be.alloc.String().try();
    hold_alloc(be, c, aty, ctx, al).try();
    want ::= be.alloc.String().try();
    sym_gen(want, "t", be.next_tmp()).try();
    got ::= be.alloc.String().try();
    sym_gen(got, "t", be.next_tmp()).try();
    rc ::= be.alloc.String().try();
    sym_gen(rc, "t", be.next_tmp()).try();
    dst ::= be.alloc.String().try();
    sym_gen(dst, "t", be.next_tmp()).try();
    declare_temp(be, usize_ty, want.view()).try();
    declare_temp(be, usize_ty, got.view()).try();
    declare_temp(be, i32_ty, rc.view()).try();
    declare_temp(be, ret, dst.view()).try();
    assign(be, want.view(), "0").try();
    assign(be, got.view(), "0").try();
    write_size_call(be, rc.view(), path.view(), want.view()).try();
    open_rc_test(be, rc.view()).try();
    fs_chain(be, ret, rc.view(), dst.view(), 1).try();
    close_else(be).try();
    read_body(be, id, ret, sty, vty, aty, al.view(), path.view(),
              want.view(), got.view(), rc.view(), dst.view()).try();
    close_block(be).try();
    out.add_bytes(dst.view())
}

// The `Alloc` in a temporary of its own: the record is read twice — for
// the slot and for the receiver behind it — and an argument read twice
// is an argument evaluated twice.
hold_alloc = (be :: CBackend, c: Call, aty: TyId, ctx: Ctx,
              out :: String) Res<(), AllocError> {
    sym_gen(out, "t", be.next_tmp()).try();
    value ::= be.alloc.String().try();
    arg_text(be, c, 0, aty, ctx, value).try();
    declare_temp(be, aty, out.view()).try();
    assign(be, out.view(), value.view()).try();
    Ok(());
}

write_size_call = (be :: CBackend, rc: str, path: str, want: str)
                  Res<(), AllocError> {
    line ::= be.alloc.String().try();
    line.add_bytes(rc).try();
    line.add_bytes(" = zg_fs_size(").try();
    line.add_bytes(path).try();
    line.add_bytes(", &").try();
    line.add_bytes(want).try();
    line.add_bytes(");").try();
    be.writeln(line.view())
}

// ALIGN_MAX, exactly as `create` asks for: it is what the arena would
// have given anyway, and it keeps the size header the arena writes
// ahead of every run intact — so a String read off the disk still grows
// through the ordinary `realloc`.
read_body = (be :: CBackend, id: ExprId, ret: TyId, sty: TyId, vty: TyId,
             aty: TyId, al: str, path: str, want: str, got: str, rc: str,
             dst: str) Res<(), AllocError> {
    call ::= be.alloc.String().try();
    args ::= be.alloc.String().try();
    args.add_bytes(", ").try();
    args.add_bytes(want).try();
    args.add_bytes(", 16").try();
    slot_call(be, al, aty, "raw", args.view(), 2, call).try().match({
        None     => unsupported_line(be, id, "Fs.read needs an Alloc"),
        Ok(slot) => run_and_read(be, ret, sty, vty, aty, slot, al, path,
                                 want, got, rc, dst, call.view()),
    })
}

unsupported_line = (be :: CBackend, id: ExprId, what: str)
                   Res<(), AllocError> {
    sink ::= be.alloc.String().try();
    unsupported(be, id, what, sink)
}

run_and_read = (be :: CBackend, ret: TyId, sty: TyId, vty: TyId, aty: TyId,
                slot: Slot, al: str, path: str, want: str, got: str,
                rc: str, dst: str, call: str) Res<(), AllocError> {
    run ::= be.alloc.String().try();
    sym_gen(run, "t", be.next_tmp()).try();
    declare_temp(be, slot.ret, run.view()).try();
    assign(be, run.view(), call).try();
    open_not_ok(be, run.view()).try();
    write_assign_err(be, ret, "OutOfMemory", dst).try();
    close_else(be).try();
    buf ::= be.alloc.String().try();
    sym_gen(buf, "t", be.next_tmp()).try();
    declare_ptr(be, buf.view()).try();
    read_ok_payload(be, run.view(), buf.view()).try();
    write_read_call(be, rc, path, buf.view(), want, got).try();
    open_rc_test(be, rc).try();
    fs_chain(be, ret, rc, dst, 1).try();
    close_else(be).try();
    write_string_ok(be, ret, sty, vty, al, buf.view(), got, want, dst).try();
    close_block(be).try();
    close_block(be).try();
    Ok(());
}

declare_ptr = (be :: CBackend, name: str) Res<(), AllocError> {
    line ::= be.alloc.String().try();
    line.add_bytes("unsigned char *").try();
    line.add_bytes(name).try();
    line.add_bytes(";").try();
    be.writeln(line.view())
}

read_ok_payload = (be :: CBackend, run: str, buf: str)
                  Res<(), AllocError> {
    value ::= be.alloc.String().try();
    value.add_bytes("(unsigned char *)").try();
    value.add_bytes(run).try();
    value.add_bytes(".zg_data.").try();
    sym_member(value, "Ok").try();
    assign(be, buf, value.view())
}

open_not_ok = (be :: CBackend, run: str) Res<(), AllocError> {
    line ::= be.alloc.String().try();
    line.add_bytes("if (").try();
    line.add_bytes(run).try();
    line.add_bytes(".zg_tag != ").try();
    sym_variant(line, RES_PATH, "Ok").try();
    line.add_bytes(") {").try();
    be.writeln(line.view()).try();
    be.indent();
    Ok(());
}

write_read_call = (be :: CBackend, rc: str, path: str, buf: str, want: str,
                   got: str) Res<(), AllocError> {
    line ::= be.alloc.String().try();
    line.add_bytes(rc).try();
    line.add_bytes(" = zg_fs_read(").try();
    line.add_bytes(path).try();
    line.add_bytes(", ").try();
    line.add_bytes(buf).try();
    line.add_bytes(", ").try();
    line.add_bytes(want).try();
    line.add_bytes(", &").try();
    line.add_bytes(got).try();
    line.add_bytes(");").try();
    be.writeln(line.view())
}

write_string_ok = (be :: CBackend, ret: TyId, sty: TyId, vty: TyId,
                   al: str, buf: str, got: str, want: str, dst: str)
                  Res<(), AllocError> {
    value ::= be.alloc.String().try();
    value.add_bytes("(").try();
    ctype(be, sty, value).try();
    value.add_bytes("){ .").try();
    sym_member(value, "data").try();
    value.add_bytes(" = ").try();
    write_vec_literal(be, vty, al, buf, got, want, value).try();
    value.add_bytes(" }").try();
    write_assign_ok(be, ret, value.view(), dst)
}

write_vec_literal = (be :: CBackend, vty: TyId, al: str, buf: str,
                     got: str, want: str, out :: String)
                    Res<(), AllocError> {
    out.add_bytes("(").try();
    ctype(be, vty, out).try();
    out.add_bytes("){ ").try();
    write_vec_field(be, vty, "data", buf, out, true).try();
    write_vec_field(be, vty, "len", got, out, false).try();
    write_vec_field(be, vty, "capacity", want, out, false).try();
    write_vec_field(be, vty, "alloc", al, out, false).try();
    out.add_bytes(" }").try();
    Ok(());
}

// A field std drops is a line this stops writing rather than a
// diagnostic: `collections_vec.zen` owns the shape.
write_vec_field = (be :: CBackend, vty: TyId, name: str, value: str,
                   out :: String, first: bool) Res<(), AllocError> {
    field_of(be, vty, name).try().match({
        None  => Ok(()),
        Ok(_) => write_named_init(be, name, value, out, first),
    })
}

write_named_init = (be :: CBackend, name: str, value: str, out :: String,
                    first: bool) Res<(), AllocError> {
    first.match({ true => Ok(()), false => out.add_bytes(", ") }).try();
    out.add_bytes(".").try();
    sym_member(out, name).try();
    out.add_bytes(" = ").try();
    out.add_bytes(value).try();
    Ok(());
}

// -----------------------------------------------------------------
// the failure chain
//
// The C floor answers with an ORDINAL and this turns it back into a
// variant BY NAME, so env.zen may rename or reorder its own error set
// without the backend agreeing to it in secret. The ordinals are the
// floor's own, written down in exactly one place at each end.
// -----------------------------------------------------------------

fs_name = (n: usize) str {
    (n == 1).match({ true => "NotFound", false => fs_name_2(n) })
}

fs_name_2 = (n: usize) str {
    (n == 2).match({ true => "Denied", false => fs_name_3(n) })
}

fs_name_3 = (n: usize) str {
    (n == 3).match({ true => "IsDir", false => "Failed" })
}

// `if (rc == 1) { .. } else { if (rc == 2) { .. } else { .. } }`. The
// last arm is the plain `else`: the floor returns exactly these
// ordinals, so a chain testing all four would end in a branch nothing
// can reach — and an unreachable arm naming a reason is how a wrong
// reason gets reported later.
fs_chain* = (be :: CBackend, ret: TyId, rc: str, dst: str, n: usize)
           Res<(), AllocError> {
    (n > 3).match({
        true  => write_assign_err(be, ret, fs_name(n), dst),
        false => fs_branch(be, ret, rc, dst, n),
    })
}

fs_branch = (be :: CBackend, ret: TyId, rc: str, dst: str, n: usize)
            Res<(), AllocError> {
    open_ordinal_test(be, rc, n).try();
    write_assign_err(be, ret, fs_name(n), dst).try();
    close_else(be).try();
    fs_chain(be, ret, rc, dst, n + 1).try();
    close_block(be).try();
    Ok(());
}

open_ordinal_test = (be :: CBackend, rc: str, n: usize)
                    Res<(), AllocError> {
    line ::= be.alloc.String().try();
    line.add_bytes("if (").try();
    line.add_bytes(rc).try();
    line.add_bytes(" == ").try();
    write_usize(line, n).try();
    line.add_bytes(") {").try();
    be.writeln(line.view()).try();
    be.indent();
    Ok(());
}

open_rc_test* = (be :: CBackend, rc: str) Res<(), AllocError> {
    line ::= be.alloc.String().try();
    line.add_bytes("if (").try();
    line.add_bytes(rc).try();
    line.add_bytes(" != 0) {").try();
    be.writeln(line.view()).try();
    be.indent();
    Ok(());
}

open_null_test = (be :: CBackend, raw: str) Res<(), AllocError> {
    line ::= be.alloc.String().try();
    line.add_bytes("if (").try();
    line.add_bytes(raw).try();
    line.add_bytes(" == NULL) {").try();
    be.writeln(line.view()).try();
    be.indent();
    Ok(());
}

close_else* = (be :: CBackend) Res<(), AllocError> {
    be.dedent();
    be.writeln("} else {").try();
    be.indent();
    Ok(());
}

close_block* = (be :: CBackend) Res<(), AllocError> {
    be.dedent();
    be.writeln("}").try();
    Ok(());
}
