Position = { line: usize, column: usize }
read = (positions: Vec<Position>) Res<Position, AllocError> {
    position = positions.get(0).ok_or(AllocError.OutOfMemory).try();
    Ok(position)
}
position = (env: Env) Res<Position, AllocError> {
    a = env.mem.alloc();
    positions ::= a.Vec<Position>();
    positions.add(Position(line: 42, column: 7)).try();
    read(positions)
}
main = (env: Env) Res<(), AllocError> {
    value = position(env).try();
    println("{}:{}", value.line, value.column);
    Ok(())
}
