// js_int64_battery.zen — dual-backend 64-bit / unsigned integer cross-check. Every line is a value that a
// JS `number` (32-bit ops, 53-bit mantissa) gets WRONG: a 64-bit shift/multiply, an unsigned `>>`, a u64
// past 2^63, i64 signed division. The js backend models i64/u64 as BigInt, so C and node must agree.
//   C:  zen run   tests/fixtures/zen/js_int64_battery.zen
//   JS: zen build --target js tests/fixtures/zen/js_int64_battery.zen -o /tmp/b.js && node /tmp/b.js
{ println } = std.text.fmt
main = () i32 {
    a: i64 = 1
    println(a << 40)    // 1099511627776 (JS `<<` is 32-bit -> was 256)
    println(a << 62)    // 4611686018427387904
    b: i64 = 123456789
    println(b * 987654321)    // 121932631112635269 (product > 2^53)
    n: i64 = 0 - 100
    println(n / 3)    // -33 (signed truncating division)
    println(n % 7)    // -2
    println(n >> 1)    // -50 (arithmetic shift)
    u: u32 = 4294967288
    println(u >> 1)    // 2147483644 (logical >>> ; signed was 4294967292)
    m: u64 = 18446744073709551615
    println(m)    // 18446744073709551615 (u64 max)
    println(m / 2)    // 9223372036854775807
    println(m % 10)    // 5
    i: i32 = 100000
    println(to_i64(i) * to_i64(i))
    0
}    // 10000000000 (widened multiply, exact)
