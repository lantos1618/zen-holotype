// `env.args<T>()` fills a record from the command line and the
// environment: a flag wins, a variable is second, and a `str` field that
// neither filled takes the next positional word. Res fields may be
// absent and defaulted fields optional; `-C` is the one-letter spelling.
// The numeric edges exercise all three supported parsers, including a
// negative i64 and u64.MAX, and conflicting FLEET/MODEL variables prove
// that a flag wins rather than merely coexisting with the environment.

ArgError = std.env

// The shape the agent-zen entry point wants: switches, numbers with
// defaults, a text default, a one-letter flag that is also the first
// positional, an optional second positional, an optional number, and a
// required secret spelled as its variable, which only the environment
// supplies: uppercase means no flag and never a positional.
Cli = {
    stream ::  bool  = false,
    fleet ::   usize = 0,
    model ::   str   = "default-model",
    C:         str,
    prompt:    Res<str>,
    retries:   Res<usize>,
    delta:     i64,
    limit:     u64,
    KEY:       str,
}

show = (r: Res<Cli, ArgError>) () {
    r.match({
        Ok(c)           => {
            println("stream {}", c.stream);
            println("fleet {}", c.fleet);
            println("model {}", c.model);
            println("C {}", c.C);
            println("prompt {}", c.prompt.value_or("<none>"));
            println("retries {}", c.retries.value_or(99));
            println("delta {}", c.delta);
            println("limit {}", c.limit);
            println("key {}", c.KEY);
        },
        Err(Missing(f)) => println("missing {}", f),
        Err(Parse(f))   => println("parse {}", f),
    })
}

main = (env: Env) Res<i32, AllocError> {
    show(env.args<Cli>());
    Ok(0);
}
