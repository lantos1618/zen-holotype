// AN INTEGER OF ANOTHER WIDTH BROKEN OUT OF A LOOP — REFUSED, though
// every C compiler here would have accepted the emitted code.
//
// The items are u8, so the loop's own T is u8 and the break slot is one
// byte wide; `wide` is i64. Before `gen_c_handle.break_value_fits` asked
// loop_handle.zen's rule, this program compiled clean under plain
// `-std=c11 -O0`, ran, and printed 44 for 300 — the value truncated
// through the slot with no diagnostic anywhere. A wrong answer that
// looks plausible is the failure mode this repo fears most
// (field_default_that_calls_a_function.zen tells the same story); the
// str version of this mistake at least drew a cc error.
//
// position: the break call.

main = (env: Env) Res<i32, AllocError> {
    wide: i64      = 300;
    items: [u8, 1] = [1];
    items.loop((h, v) {
        h.break(wide);
    }).match({
        Ok(n) => println("{}", n),
        None  => println("none"),
    });
    Ok(0);
}
