// src/gen/gen_c/gen_c_member.zen
// What a call through a DOT is.
//
// `gen_c_call.zen` owns `f(a)`; this file owns `x.f(a)`. DESIGN.md has
// one rule and three readings of it — "a method is a UFCS function
// whose first parameter happens to be named `self`" — so `x.f(a)` is:
//
//   Shape.Circle(c)   a VARIANT carrying a payload: the base names a
//                     type, and a payload variant IS the function that
//                     builds one
//   s.is_empty()      a MEMBER the receiver's type declares, whose
//                     first parameter is the receiver
//   v.push(x)         a FREE FUNCTION whose first parameter is the
//                     receiver's type — "importing a type pulls its
//                     world along ... exported ufcs functions"
//
// SEMA ALREADY DECIDES BETWEEN THEM and this file asks it rather than
// re-deciding: `base_of` says whether the base is a type or a value,
// `members_of` says what the dot reaches. NOT read back off sema: which
// declaration a call resolved to — `Cand` carries a signature and no
// `DeclId` — so the lowering re-derives that from the AST.
//
// THE SEAM IS NARROWED HERE, NOT CLOSED: `pick_member` below chooses
// between two members of one name by calling `recv_sig_fits`, the
// CHECKER'S OWN predicate — so the two can't disagree about the rule,
// only the inputs. Closing it means sema recording WHICH MEMBER a dot
// resolved to, and it can't today: `call_memo` is `ExprId -> DeclId`, a
// `DeclId` can't name a member. `MemberId` already exists for this —
// `sema_id.zen` names it as one of three questions a coordinate keys.
//
// A MEMBER FUNCTION IS AN ORDINARY FUNCTION with the receiver's type as
// its first parameter; its symbol is the TYPE's qualified name plus the
// member's — `sym_fn`'s existing rule with one more segment, which is
// what makes two types' `get` two symbols without a counter.
//
// WHAT THIS FILE REFUSES, it refuses BY NAME: a `GenFault` with a
// position, never C that compiles but means something else.
//
// A MEMBER WITH NO BODY IS ASKED OF `gen_c_cap.zen` FIRST: either a
// capability whose floor is the target language's (that file writes
// it), or a declaration nothing defines — still a refusal here.

Ast, Expr, ExprKind, ExprId, Decl, DeclKind, Struct, Member, MemberKind = std.ast
Function, Param, Access, Call, Arg, Span, Ident, TypeId, Impl = std.ast
Lambda = std.ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
DeclId, ImplId = sema.sema_id
TyId, Ty, Types, TyNamed, TyFn, Prim = sema.sema_ty
World, Def, DefKind, decl_at = sema.sema_def
Checker, Ctx = sema.sema_check
Inst = sema.sema_inst
Base, Found, base_of, members_of, member_named, self_ctx = sema.sema_member
Actual = sema.sema_call
recv_sig_fits, ty_at, tail_swallows = sema.sema_cand
Case, cases_of, find_case = sema.sema_case
impl_bound_type, bound_members = sema.sema_supply
is_case = sema.sema_match
module_of, sym_fn, sym_member, sym_variant = gen.gen_name
GenFault = gen.gen_diag
CBackend, MethodRef = gen.gen_c.gen_c_state
unsupported, unresolved, untyped, ambiguous = gen.gen_c.gen_c_report
sub, sub_with, any_open, recv_inst, inst_open = gen.gen_c.gen_c_mono
enter_struct_tparams, leave_tparams = gen.gen_c.gen_c_mono
ctype, is_unit, decl_ctx = gen.gen_c.gen_c_type
expr, ty_of, want_of = gen.gen_c.gen_c_expr
lower_plain_call, write_arg, write_call_args = gen.gen_c.gen_c_call
handle_depth, lower_handle_call = gen.gen_c.gen_c_handle
inlines, inline_method = gen.gen_c.gen_c_inline
is_ptr_member, lower_ptr_member = gen.gen_c.gen_c_ptr
lower_create = gen.gen_c.gen_c_alloc
is_capability, lower_capability = gen.gen_c.gen_c_cap
is_fat = gen.gen_c.gen_c_fat
lower_fat_call = gen.gen_c.gen_c_bound
lower_assoc_call = gen.gen_c.gen_c_assoc
sink_door_shape, lower_member_door = gen.gen_c.gen_c_sink
is_floor_door, lower_floor_door = gen.gen_c.gen_c_floor
by_arity, bodied_fn, impl_member, kept_or_arity = gen.gen_c.gen_c_impl
has_body = gen.gen_c.gen_c_impl
impl_member_at = gen.gen_c.gen_c_impl
alias_of = gen.gen_c.gen_c_impl

// -----------------------------------------------------------------
// the entry point
// -----------------------------------------------------------------

// A LOOP HANDLE IS ASKED ABOUT FIRST, for the reason `gen_c_handle.zen`
// gives: `h` is not a value, so `h.break(v)` is recognised at the NAME
// and never resolved through a receiver's type.
lower_dot_call* = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    a    : Access,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    depth = handle_depth(be, a.base);
    (depth > 0).match({
        true  => lower_handle_call(be, id, c, a, depth, ctx, out),
        false => lower_resolved_dot(be, id, c, a, ctx, want, out),
    })
}

lower_resolved_dot = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    a    : Access,
    ctx  : Ctx,
    want : TyId,
    out  :: String
)
                     Res<(), AllocError> {
    b = be.check.base_of(a.base, ctx).try();
    b.is_type.match({
        true  => lower_static_call(be, id, c, a, b.ty, ctx, out),
        false => lower_receiver_call(be, id, c, a, ctx, out),
    })
}

// -----------------------------------------------------------------
// `Shape.Circle(c)` — a variant that carries a payload
//
// "A nullary variant IS a value of the enum; one carrying a payload is
// the function that builds one" — `Slot.Left(cell)` is an ordinary
// call, not a second construction form. Writes the same compound
// literal `gen_c_expr.zen` writes for a bare variant, plus the payload.
//
// A NAME THAT IS NOT A VARIANT IS `gen_c_assoc.zen`'S: a struct body may
// bind a function too (`Duration.seconds(2)` reads it through the
// type). It answers `false` when the type declares nothing of that name
// wanting no receiver — the refusal reported here, one diagnostic for
// one mistake.
// -----------------------------------------------------------------

lower_static_call = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    ty  : TyId,
    ctx : Ctx,
    out :: String
)
                    Res<(), AllocError> {
    be.check.is_case(ty, a.name.text).try().match({
        false => static_member_call(be, id, c, a, ty, ctx, out),
        true  => write_variant_call(be, id, c, a, ty, ctx, out),
    })
}

static_member_call = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    ty  : TyId,
    ctx : Ctx,
    out :: String
)
                     Res<(), AllocError> {
    lower_assoc_call(be, id, c, a, ty, ctx, out).try().match({
        true  => Ok(()),
        false => unsupported(
            be,
            id,
            "a call on a type that is not a variant",
            out
        ),
    })
}

write_variant_call = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    ty  : TyId,
    ctx : Ctx,
    out :: String
)
                     Res<(), AllocError> {
    cases ::= be.alloc.Vec<Case>();
    be.check.cases_of(ty, cases).try();
    find_case(cases, a.name.text).match({
        None   => unresolved(be, id, a.name.text, out),
        Ok(cs) => write_case_value(be, c, ty, cs, ctx, out),
    })
}

write_case_value = (
    be  :: CBackend,
    c   : Call,
    ty  : TyId,
    cs  : Case,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    qname ::= be.alloc.String().try();
    type_qname(be, ty, qname).try();
    out.add_bytes("(").try();
    ctype(be, ty, out).try();
    out.add_bytes("){ .zg_tag = ").try();
    out.sym_variant(qname.view(), cs.name).try();
    write_case_payload(be, c, cs, ctx, out).try();
    out.add_bytes(" }").try();
    Ok(());
}

// A unit payload takes no member: a void member is illegal C, which is
// the same rule `Ok(())` obeys.
write_case_payload = (
    be  :: CBackend,
    c   : Call,
    cs  : Case,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    no_payload(be, c, cs).match({
        true  => Ok(()),
        false => write_payload_arg(be, c, cs, ctx, out),
    })
}

no_payload = (be :: CBackend, c: Call, cs: Case) bool {
    (cs.has_payload == false) || is_unit(be, cs.payload) || (c.args.len == 0)
}

write_payload_arg = (
    be  :: CBackend,
    c   : Call,
    cs  : Case,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    out.add_bytes(", .zg_data.").try();
    out.sym_member(cs.name).try();
    out.add_bytes(" = ").try();
    c.args.get(0).match({
        None  => out.add_bytes("0"),
        Ok(a) => expr(be, a.value, ctx, cs.payload, out),
    })
}

// -----------------------------------------------------------------
// `x.f(a)` — a value receiver
// -----------------------------------------------------------------

lower_receiver_call = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    rty     = ty_of(be, a.base, ctx, unknown).try();
    site_of(be, rty).try().match({
        None  => lower_ufcs(be, id, c, a, rty, ctx, out),
        Ok(s) => with_site(be, id, c, a, rty, s, ctx, out),
    })
}

// A member the RECEIVER'S OWN DECLARATION supplies, or nothing — in
// which case the name is a free function reached through the dot, which
// is the ufcs half of the same rule.
with_site = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    s   : Site,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    found ::= be.alloc.Vec<Member>();
    member_at(be, s, a.name.text, found).try();
    pick_member(be, c, rty, s, found, ctx).try().match({
        None  => supplied_or_ufcs(be, id, c, a, rty, s, ctx, out),
        Ok(m) => member_kind(be, id, c, a, rty, s, m, ctx, out),
    })
}

// WHAT AN IMPL SUPPLIES IS AN OVERLOAD SET TOO, so it goes through
// `pick_member` below and not through arity alone.
supplied_or_ufcs = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    s   : Site,
    ctx : Ctx,
    out :: String
)
                   Res<(), AllocError> {
    found ::= be.alloc.Vec<Member>();
    impl_member_at(be, s.decl, a.name.text, found).try();
    pick_member(be, c, rty, s, found, ctx).try().match({
        None  => lower_ufcs(be, id, c, a, rty, ctx, out),
        Ok(m) => supplied_kind(be, id, c, a, rty, s, m, ctx, out),
    })
}

supplied_kind = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    s   : Site,
    m   : Member,
    ctx : Ctx,
    out :: String
)
                Res<(), AllocError> {
    m.kind.match({
        Function(f) => lower_method(be, id, c, a, rty, s, f, ctx, out),
        _           => lower_ufcs(be, id, c, a, rty, ctx, out),
    })
}

// -----------------------------------------------------------------
// which of two members of one name
//
// "Resolution is on declared parameter types AND arity" (DESIGN.md,
// Overloading) — a backend reading only arity answers whichever the
// member table listed first. `Display` declares a `toString` taking a
// sink and a sealed one taking an allocator, both arity two;
// `p.toString(alloc)` once lowered to the sink symbol with the
// allocator passed as a `Sink` of NULL function pointers. `cc` caught
// it only because the two return types differ — two overloads agreeing
// on return type would have been silent.
//
// THE PREDICATE IS SEMA'S OWN: `recv_sig_fits` is what the checker used
// to pick this very call's member, so calling it here (rather than
// writing a second one) means agreeing with the checker, not just
// agreeing with it today.
//
// ONE CANDIDATE IS NOT A CHOICE — this only runs where a name really
// did reach two members, so the common call pays only for the arity
// test.
// -----------------------------------------------------------------

pick_member = (
    be    :: CBackend,
    c     : Call,
    rty   : TyId,
    s     : Site,
    found : Vec<Member>,
    ctx   : Ctx
) Res<Res<Member>, AllocError> {
    (found.len < 2).match({
        true  => Ok(by_arity(be, found, c.args.len + 1)),
        false => member_that_fits(be, c, rty, s, found, ctx),
    })
}

// THE FIRST THAT FITS, and arity when none does. Both halves are the
// checker's: `pick_fitting` takes the first because "two members
// accepting the same call is an error AT THE DECLARATION", and
// `by_arity_ret` falls back for the case `fits` cannot answer — a
// receiver whose type is not settled, or a variadic signature.
member_that_fits = (
    be    :: CBackend,
    c     : Call,
    rty   : TyId,
    s     : Site,
    found : Vec<Member>,
    ctx   : Ctx
)
                   Res<Res<Member>, AllocError> {
    actuals ::= be.alloc.Vec<Actual>();
    call_actuals(be, c, ctx, actuals).try();
    kept ::= be.alloc.Vec<Member>();
    found.loop((h, m) { keep_fits(be, m, rty, s, actuals, kept).try() });
    Ok(kept_or_arity(be, kept, found, c.args.len + 1));
}

// A named helper rather than a `.then` inside the loop body: a loop
// binding read inside a nested closure does not resolve.
keep_fits = (
    be      :: CBackend,
    m       : Member,
    rty     : TyId,
    s       : Site,
    actuals : Vec<Actual>,
    kept    :: Vec<Member>
)
            Res<(), AllocError> {
    m.kind.match({
        Function(f) => keep_if_fits(be, m, f, rty, s, actuals, kept),
        _           => Ok(()),
    })
}

// `method_sig` and not the member's written types: `@Self` and the
// type's own parameters have to be bound before a declared parameter
// means anything, and the signature this builds is the one
// `emit_method_call` will mangle into the symbol.
keep_if_fits = (
    be      :: CBackend,
    m       : Member,
    f       : Function,
    rty     : TyId,
    s       : Site,
    actuals : Vec<Actual>,
    kept    :: Vec<Member>
)
               Res<(), AllocError> {
    inst = recv_inst(be, rty).try();
    sig ::= be.alloc.Vec<TyId>();
    method_sig(be, rty, s.decl, f, s.decl.module.to_usize(), inst, sig).try();
    be.check.recv_sig_fits(sig, actuals).try().match({
        true  => kept.add(m),
        false => Ok(()),
    })
}

call_actuals = (be :: CBackend, c: Call, ctx: Ctx, out :: Vec<Actual>)
               Res<(), AllocError> {
    c.args.loop((h, x) { out.add(arg_actual(be, x, ctx).try()).try() });
    Ok(());
}

// WHAT RESOLUTION READS OFF AN ARGUMENT, and no more. A lambda has no
// type until a signature settles it — "a closure's type is its full
// signature" — so its PARAMETER COUNT is what a candidate is tested
// against, which is the part a call site can see without inferring
// anything.
arg_actual = (be :: CBackend, x: Arg, ctx: Ctx) Res<Actual, AllocError> {
    unknown = be.check.types.unknown().try();
    be.tree.expr_at(x.value).kind.match({
        Lambda(l) => Ok(Actual(
            ty: unknown,
            is_lambda: true,
            arity: l.params.len,
            named: false,
            span: x.span
        )),
        _         => typed_actual(be, x, ctx, unknown),
    })
}

typed_actual = (be :: CBackend, x: Arg, ctx: Ctx, unknown: TyId)
               Res<Actual, AllocError> {
    ty = ty_of(be, x.value, ctx, unknown).try();
    Ok(Actual(ty: ty, is_lambda: false, arity: 0, named: false, span: x.span));
}

// -----------------------------------------------------------------
// the declaring site
//
// Which declaration owns a type's members, and under what qualified
// name a symbol built from it is written. A `Prim` has one too — "a
// prelude declaration of a primitive's name IS that primitive", so
// `str`'s members are `std.text.text_str.str`'s and the receiver stays
// the primitive.
// -----------------------------------------------------------------

Site* = {
    decl*: DeclId,
    qname*: str,
    generic*: bool,
}

site_of* = (be :: CBackend, rty: TyId) Res<Res<Site>, AllocError> {
    be.check.types.at(rty).match({
        Named(n) => named_site(be, n),
        Prim(p)  => prim_site(be, p.name),
        _        => Ok(None),
    })
}

named_site = (be :: CBackend, n: TyNamed) Res<Res<Site>, AllocError> {
    qname ::= be.alloc.String().try();
    join(qname, module_of(be.check.world, n.decl), n.name).try();
    Ok(Ok(Site(decl: n.decl, qname: qname.view(), generic: n.args.len > 0)));
}

prim_site = (be :: CBackend, name: str) Res<Res<Site>, AllocError> {
    defs ::= be.alloc.Vec<Def>();
    be.check.world.prelude_of(name, defs).try();
    defs.get(0).match({
        None  => Ok(None),
        Ok(d) => Ok(Ok(Site(decl: d.id, qname: d.qname, generic: false))),
    })
}

join* = (out :: String, module: str, name: str) Res<(), AllocError> {
    (module.len > 0).then(() { out.add_bytes(module).try() });
    (module.len > 0).then(() { out.add_bytes(".").try() });
    out.add_bytes(name).try();
    Ok(());
}

// The qualified name of a type, for a variant symbol.
type_qname = (be :: CBackend, ty: TyId, out :: String)
             Res<(), AllocError> {
    be.check.types.at(ty).match({
        Named(n) => join(out, module_of(be.check.world, n.decl), n.name),
        _        => Ok(()),
    })
}

// The member of `s` called `name`, when its declaration has one.
member_at* = (be :: CBackend, s: Site, name: str, out :: Vec<Member>)
             Res<(), AllocError> {
    decl_at(be.tree, s.decl).match({
        None  => Ok(()),
        Ok(d) => struct_member(d, name, out),
    }).try();
    Ok(());
}

struct_member = (d: Decl, name: str, out :: Vec<Member>)
                Res<(), AllocError> {
    d.kind.match({
        Struct(st) => keep_named(st, name, out),
        _          => Ok(()),
    })
}

keep_named = (st: Struct, name: str, out :: Vec<Member>)
             Res<(), AllocError> {
    st.members.loop((h, m) {
        member_named(m, name).then(() { out.add(m).try() });
    });
    Ok(());
}

// -----------------------------------------------------------------
// a member the type declares
// -----------------------------------------------------------------

member_kind = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    s   : Site,
    m   : Member,
    ctx : Ctx,
    out :: String
)
              Res<(), AllocError> {
    m.kind.match({
        Function(f) => lower_method(be, id, c, a, rty, s, f, ctx, out),
        _           => call_through_field(be, id, c, a, ctx, out),
    })
}

// A FIELD whose value is a function — what a fat value's slot is — is
// called through, which is the general form the header names: lower the
// callee expression, then call it.
call_through_field = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    unsupported(be, id, "a call through a function-valued field", out)
}

// A MEMBER HANDED A LAMBDA IS INLINED, exactly as a free function is:
// `cur.bump_while((b) { .. })` has a `(b: u8) bool` parameter, which has
// no C spelling and nothing to pass.
lower_method = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    s   : Site,
    f   : Function,
    ctx : Ctx,
    out :: String
)
               Res<(), AllocError> {
    inlines(be, c, f).match({
        true  => inline_method(be, id, c, a, rty, s.decl, f, ctx, out),
        false => lower_written_method(be, id, c, a, rty, s, f, ctx, out),
    })
}

lower_written_method = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    s   : Site,
    f   : Function,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    is_ptr_member(be, rty, a.name.text).match({
        true  => lower_ptr_member(
            be,
            id,
            c,
            a,
            rty,
            ctx,
            want_of(be, id, ctx).try(),
            out
        ),
        false => lower_declared_method(be, id, c, a, rty, s, f, ctx, out),
    })
}

lower_declared_method = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    s   : Site,
    f   : Function,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    is_capability(be, rty, a.name.text).match({
        true  => lower_capability(
            be,
            id,
            c,
            a,
            rty,
            s.decl.module.to_usize(),
            f,
            ctx,
            out
        ),
        false => lower_bound_or_method(be, id, c, a, rty, s, f, ctx, out),
    })
}

// THE FORMAT DOOR IS ASKED ABOUT FIRST, because both answers below get
// it wrong. `s.add("{}", x)` is bodyless BY DESIGN — `gen_c_sink.zen`
// says why — so `refuse_method` would reject the one spelling DESIGN.md
// writes; and on a receiver already typed `Sink` the fat branch would
// hunt an `add` slot `text_fmt.zen` deliberately never cut.
lower_bound_or_method = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    s   : Site,
    f   : Function,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    (a.name.text.eq("add") && sink_door_shape(be, f)).match({
        true  => lower_member_door(be, id, c, a.base, ctx, out),
        false => lower_floor_or_fat(be, id, c, a, rty, s, f, ctx, out),
    })
}

// `be.fmt("{};\n", name)` — the same door on the receiver's OWN byte
// writer, answering what that writer answers. A second door and not
// this one narrowed; `gen_c_floor.zen` holds the contract.
lower_floor_or_fat = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    s   : Site,
    f   : Function,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    be.is_floor_door(a.name.text, f).match({
        true  => be.lower_floor_door(id, c, a, rty, s, f, ctx, out),
        false => be.lower_fat_or_method(id, c, a, rty, s, f, ctx, out),
    })
}

// A MEMBER WITH NO BODY ON A VALUE WHOSE STATIC TYPE IS THE BOUND is
// the one call that can't be resolved statically: which function runs
// is decided by the impl behind the receiver, a `void *` in a record.
// `gen_c_fat.zen` writes it.
//
// EVERYTHING ELSE STILL RESOLVES STATICALLY: a member with a body is
// the bound's own default, specialised on this receiver; a concrete
// receiver is the impl's function, monomorphised. Neither builds a
// record.
lower_fat_or_method = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    s   : Site,
    f   : Function,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    (is_fat(be, rty) && (has_body(f) == false)).match({
        true  => lower_fat_call(be, id, c, a, rty, s, f, ctx, out),
        false => lower_ordinary_method(be, id, c, a, rty, s, f, ctx, out),
    })
}

lower_ordinary_method = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    s   : Site,
    f   : Function,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    refuse_method(be, s, f).match({
        true  => unsupported(be, id, method_fault(be, s, f), out),
        false => write_method_call(be, id, c, a, rty, s, f, ctx, out),
    })
}

// A GENERIC RECEIVER IS NOT A REFUSAL: `Vec<GenDiag>.add` is `Vec.add`
// emitted at `GenDiag`, the receiver's own arguments say which. Still
// refused: a member declaring type parameters OF ITS OWN
// (instantiation would need the receiver's arguments plus the call's;
// nothing in this tree declares one), and a member with no body that
// `gen_c_cap.zen` didn't claim as a capability — a symbol nothing would
// define.
refuse_method = (be :: CBackend, s: Site, f: Function) bool {
    (f.tparams.len > 0) || (has_body(f) == false)
}

method_fault = (be :: CBackend, s: Site, f: Function) str {
    (f.tparams.len > 0).match({
        true  => "a generic method",
        false => method_fault_2(f),
    })
}

method_fault_2 = (f: Function) str {
    has_body(f).match({
        false => "a call to a member with no body",
        true  => "a call to a member this backend does not lower",
    })
}

// The call itself: the receiver as argument zero, then the written
// arguments. The symbol is the header's — over the full signature, the
// receiver included, because the receiver IS the first parameter.
write_method_call = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    s   : Site,
    f   : Function,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    inst = recv_inst(be, rty).try();
    mi   = s.decl.module.to_usize();
    sig ::= be.alloc.Vec<TyId>();
    method_sig(be, rty, s.decl, f, mi, inst, sig).try();
    (inst_open(be, inst) || any_open(be, sig)).match({
        true  => unsupported(
            be,
            id,
            "a method on a receiver whose type arguments nothing settles",
            out
        ),
        false => emit_method_call(be, c, a, rty, s, f, sig, inst, ctx, out),
    })
}

// THE CALLEE OF A CALL REACHED BY MEMBER NAME: its qualified name, the
// symbol mangled from it, and the queue entry that makes the compiler
// emit the body that symbol names. Six lowerings reach a member this
// way — a method, `eq`, `index`, an associated function, `raw`, `drop`,
// `toString` — and a queue entry built differently from the symbol
// written beside it is a call to a function nothing defines.
member_symbol* = (
    be   :: CBackend,
    ty   : TyId,
    s    : Site,
    name : str,
    sig  : Vec<TyId>,
    inst : Inst
) Res<String, AllocError> {
    qname ::= be.alloc.String().try();
    join(qname, s.qname, name).try();
    sym ::= be.alloc.String().try();
    sym_fn(sym, be.check.types, be.check.world, qname.view(), sig, inst).try();
    be.need_method(
        MethodRef(
            self_ty: ty,
            decl: s.decl,
            name: name,
            sig: sig,
            qname: qname.view()
        ),
        inst,
        sym.view()
    ).try();
    Ok(sym);
}

emit_method_call = (
    be   :: CBackend,
    c    : Call,
    a    : Access,
    rty  : TyId,
    s    : Site,
    f    : Function,
    sig  : Vec<TyId>,
    inst : Inst,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    sym = member_symbol(be, rty, s, a.name.text, sig, inst).try();
    out.add_bytes(sym.view()).try();
    out.add_bytes("(").try();
    write_arg(be, a.base, 0, f, sig, ctx, out).try();
    write_rest(be, c, f, sig, ctx, out).try();
    out.add_bytes(")").try();
    Ok(());
}

// The declared parameter types of a member function, resolved in the
// module that declares it with `@Self` bound to the receiver — makes
// `(self: @Self, i: usize)` read as a function of the receiver rather
// than a name nothing binds.
//
// WITH THE TYPE'S PARAMETERS BOUND, then substituted: `Vec<T>.add`
// declares `(self :: @Self, v: T)`, and `T` BECOMES the receiver's own
// argument in that position.
method_sig* = (
    be   :: CBackend,
    rty  : TyId,
    decl : DeclId,
    f    : Function,
    mi   : usize,
    inst : Inst,
    sig  :: Vec<TyId>
)
              Res<(), AllocError> {
    sctx = be.check.self_ctx(mi, rty).try();
    mark = enter_struct_tparams(be, decl).try();
    f.params.loop((h, p) { add_method_param(be, p, sctx, inst, sig).try() });
    leave_tparams(be, mark).try();
    Ok(());
}

add_method_param = (
    be   :: CBackend,
    p    : Param,
    sctx : Ctx,
    inst : Inst,
    sig  :: Vec<TyId>
) Res<(), AllocError> {
    declared = be.check.param_type(p, sctx).try();
    sig.add(sub_with(be, declared, inst).try())
}

// THE RECEIVER IS ALREADY WRITTEN, so this is the free-function path with
// the offset that says so — `write_call_args` and not a second loop,
// because a member may end in a `vararg<T>` and a pack built two ways is
// a pack built one way wrongly.
write_rest = (
    be  :: CBackend,
    c   : Call,
    f   : Function,
    sig : Vec<TyId>,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    write_call_args(be, c, 1, f, sig, ctx, out)
}

// -----------------------------------------------------------------
// a member call the source did not write
//
// "`==` through `Eq` is the only operator that dispatches to an impl."
// `a == b` on a type C cannot compare is a call to that type's `eq`,
// going through THIS file's own path rather than a second one — the
// symbol, instantiation, and queue entry are the ones `a.eq(b)` would
// have produced, so the two can't disagree about which function they
// mean.
//
// STATICALLY RESOLVED, like every impl-supplied member here: operand
// types are known, so no function-pointer record takes part. A type
// impl'ing no `Eq` is the caller's refusal to report, not a symbol
// nothing defines.
// -----------------------------------------------------------------

lower_eq_call* = (
    be  :: CBackend,
    lhs : ExprId,
    rhs : ExprId,
    rty : TyId,
    ctx : Ctx,
    out :: String
) Res<bool, AllocError> {
    site_of(be, rty).try().match({
        None  => Ok(false),
        Ok(s) => eq_through_site(be, lhs, rhs, rty, s, ctx, out),
    })
}

eq_through_site = (
    be  :: CBackend,
    lhs : ExprId,
    rhs : ExprId,
    rty : TyId,
    s   : Site,
    ctx : Ctx,
    out :: String
)
                  Res<bool, AllocError> {
    eq_fn(be, s, rty).try().match({
        None  => Ok(false),
        Ok(f) => write_eq(be, lhs, rhs, rty, s, f, ctx, out),
    })
}

// The type's own `eq` first, then what an impl supplies — the order
// `sema_supply.zen` states, and for its reason.
eq_fn = (be :: CBackend, s: Site, rty: TyId) Res<Res<Function>, AllocError> {
    found ::= be.alloc.Vec<Member>();
    member_at(be, s, "eq", found).try();
    bodied_fn(found).match({
        Ok(f) => Ok(Ok(f)),
        None  => impl_member(be, s.decl, "eq"),
    })
}

write_eq = (
    be  :: CBackend,
    lhs : ExprId,
    rhs : ExprId,
    rty : TyId,
    s   : Site,
    f   : Function,
    ctx : Ctx,
    out :: String
) Res<bool, AllocError> {
    inst = recv_inst(be, rty).try();
    mi   = s.decl.module.to_usize();
    sig ::= be.alloc.Vec<TyId>();
    method_sig(be, rty, s.decl, f, mi, inst, sig).try();
    (inst_open(be, inst) || any_open(be, sig)).match({
        true  => Ok(false),
        false => emit_eq(be, lhs, rhs, rty, s, f, sig, inst, ctx, out),
    })
}

emit_eq = (
    be   :: CBackend,
    lhs  : ExprId,
    rhs  : ExprId,
    rty  : TyId,
    s    : Site,
    f    : Function,
    sig  : Vec<TyId>,
    inst : Inst,
    ctx  : Ctx,
    out  :: String
)
          Res<bool, AllocError> {
    sym = member_symbol(be, rty, s, "eq", sig, inst).try();
    out.add_bytes(sym.view()).try();
    out.add_bytes("(").try();
    write_arg(be, lhs, 0, f, sig, ctx, out).try();
    out.add_bytes(", ").try();
    write_arg(be, rhs, 1, f, sig, ctx, out).try();
    out.add_bytes(")").try();
    Ok(true);
}

// -----------------------------------------------------------------
// ufcs
//
// "A free function whose first param is the type is callable as a
// method." So the receiver becomes argument zero and there is no second
// mechanism — which is `gen_c_call.zen`'s ordinary call with one more
// argument, and is why `lower_plain_call` takes a receiver at all.
// -----------------------------------------------------------------

// `alloc.create<T>()` IS ASKED ABOUT FIRST, and only here at the end:
// it is declared on `Alloc` with no body and no impl supplies one, so
// the receiver's own declaration and its impls have both been searched
// and missed by the time this runs — which is what lets a type that
// declares a `create` of its own still win.
lower_ufcs = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    lower_create(be, id, c, a, rty, ctx, out).try().match({
        true  => Ok(()),
        false => ufcs_or_impl(be, id, c, a, rty, ctx, out),
    })
}

ufcs_or_impl = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    reaches(be, rty, a.name.text, c.args.len + 1).try().match({
        true  => impl_alias(be, id, c, a, rty, ctx, out),
        false => lower_plain_call(be, id, c, a.name.text, Ok(a.base), ctx, out),
    })
}

// An impl member that IS another function — `widen_u32 = to_u32` in
// std.core.num — lowers as that function with the receiver as argument
// zero: the very call the alias names, so the two spellings cannot
// disagree about what they mean. A member supplied any other way — a
// lambda, a record — still meets the refusal below.
impl_alias = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    site_of(be, rty).try().match({
        None  => unsupported(be, id, "a call to an impl-supplied member", out),
        Ok(s) => alias_target(be, id, c, a, s, ctx, out),
    });
}

alias_target = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    s   : Site,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    found = alias_of(be, s.decl, a.name.text).try();
    found.match({
        Ok(t) => lower_plain_call(be, id, c, t, Ok(a.base), ctx, out),
        None  => unsupported(be, id, "a call to an impl-supplied member", out),
    })
}

// Whether the dot reaches this name through an IMPL rather than the
// declaration's own body. `members_of` answers over both; the caller
// already found nothing in the body, so a hit here is an impl —
// `s.eq(t)` is one: `str` doesn't declare `eq`, `std.text` impls `Eq`
// on it. Naming that distinguishes "no impls yet" from "no such
// function".
//
// AT THIS CALL'S ARITY: a name reached at another arity isn't this
// call's name. `Box` declares `grow(self)` and a free `grow(b, by)`
// travels with the type; asking only whether the NAME is reached once
// refused `b.grow(10)` as unimplemented — DESIGN.md says the two are
// one overload set and the second is exactly the member this path
// exists to reach.
reaches = (be :: CBackend, rty: TyId, name: str, arity: usize)
          Res<bool, AllocError> {
    found ::= be.alloc.Vec<Found>();
    be.check.members_of(rty, name, found).try();
    Ok(any_at_arity(be, found, arity));
}

any_at_arity = (be: CBackend, found: Vec<Found>, arity: usize) bool {
    Range(0, found.len).find((i) {
        found.get(i).match({
            Ok(f) => fn_takes_args(be, f.ty, arity),
            None  => false,
        })
    }).match({ Ok(_) => true, None => false })
}

// A `Found` carries a type and not a declaration, so the arity is the
// resolved signature's — and `...` is a minimum here for the reason
// `gen_c_impl.zen`'s `fn_takes` gives, read off the interned primitive
// rather than off the written parameter.
fn_takes_args = (be: CBackend, ty: TyId, arity: usize) bool {
    be.check.types.at(ty).match({
        Fn(f) => (f.params.len == arity) || variadic_takes(be, f, arity),
        _     => false,
    })
}

variadic_takes = (be: CBackend, f: TyFn, arity: usize) bool {
    (f.params.len > 0)
        && be.check.tail_swallows(ty_at(f.params, f.params.len - 1))
        && ((arity + 1) >= f.params.len)
}
