// std.collections.set — a generic hash set `Set<T>` with an EXPLICIT allocator, in the std.collections.map mold.
// Every op that allocates takes the allocator as `a: MutPtr<A>` and goes through std.mem.alloc's `Allocator`
// trait — nothing here hides a malloc. Every op that ALLOCATES returns Result<Set<T>, IoError> —
// allocation failure (OOM) is a value, exactly like std.collections.hmap (`empty`/`of`/`add`/`append`/
// `grow`/`clone` and the set-algebra `union`/`intersect`/`difference`). `remove` never reallocs (swap-
// remove + in-place reindex — it can't OOM), so it stays a plain `Set<T>`, mirroring `HMap.delete`.
//
// Membership is O(1) AVERAGE via the SAME open hash index design as Map: FNV-1a over the element's bytes,
// separate chaining into the insertion-ordered element column. The index lives in one i64 buffer of `2*cap`
// slots: the first `cap` slots are bucket HEADS (entry index or -1), the next `cap` slots are the per-entry
// NEXT links. The index is rebuilt on grow.
//
// Layout: one element buffer of `cap + 1` T slots (`elems`) — the final slot is a reusable SCRATCH cell so
// `find`/`has` can hash/compare a query value without taking an allocator — plus `len` live entries and `idx`
// (the 2*cap i64 hash index).
//
//   alloc := default()
//   a := alloc.addr()
//   s := sets.of(a, 10).expect("of")       // Set<i64>; T inferred from the seed (of chains)
//   s  = s.add(a, 20).expect("add")        // insert — grows through alloc when full
//   s  = s.add(a, 10).expect("add")        // already present — no-op, len unchanged
//   s.has(20)                              // true
//   s  = s.remove(a, 10)                   // delete — never allocates, returns Set<T> directly
//   s.len()                                // live element count
//   s.free(a)                              // hand all buffers back to alloc
//
//   r: Result<Set<str>, IoError> := sets.empty(a)   // empty's T is return-only: pin via two-step annotation
//   w := r.expect("empty")
//
// Allocator-threaded constructors (`empty`, `of`) and the set-algebra operators (`union`, `intersect`,
// `difference`) remain free functions; Set-owned operations live on Set<T>, so callers use s.add(...),
// s.remove(...), s.has(...), s.len(), s.clone(...), s.each(...), and s.free(...).
//
// ELEMENT HASHING / WHICH TYPES (read before choosing T). Hashing and equality are BYTE-WISE over the
// element's `sizeof(T)` bytes. That is exactly right for value/POD element types — `i64`, `i32`, byte
// structs — where the bit pattern IS the identity. It is also correct for `str` ELEMENTS as long as equal
// strings share one pointer: Zen interns string LITERALS (verified), so literal-keyed string sets dedup
// correctly. For sets keyed on COMPUTED strings (where two equal contents may sit at different pointers),
// byte-hashing compares the pointer, not the content — use std.collections.map (a `Map<bool>`, whose hash
// is content-based) for those. Supported and tested here: `i64` and `str` (literals).
//
// VALUE-MOLD CONTRACT (read before sharing a Set handle). A `Set<T>` is a small by-value header
// {elems, idx, len, cap} over allocator-owned buffers, exactly like std.collections.map. Two consequences
// follow — both by-design, not bugs:
//   1. ALWAYS USE THE RETURNED SET. `add`/`remove` may grow/reindex, which reallocs the buffers and returns
//      an updated header whose pointers differ from the input's. A handle captured BEFORE such a call then
//      points at freed memory — reading or further mutating it is use-after-free. Treat a Set like a fresh
//      value each op: `s = s.add(a, x).expect("add")`; never keep and reuse a pre-`add` copy.
//   2. NO IMPLICIT VALUE SEMANTICS. Two headers copied from the same Set share one backing buffer. If you
//      need an independent snapshot (e.g. a child scope that must not write through to its parent), take an
//      explicit deep copy with `s.clone(a)` first, then mutate the copy.
//
// FLAT-NAMESPACE CAUTION. `add`, `has`, `remove`, `union`, `intersect`, `difference`, `each`, `len` are
// common names. Methods are scoped to Set<T> (UFCS `s.add(...)`), but the free functions
// (`empty`/`of`/`union`/`intersect`/`difference`) live at module scope — import this module qualified
// (`sets = std.collections.set`) rather than destructuring, so `sets.union` can't collide with another
// module's `union` after flattening.
//
{ Result, IoError } = std.core.result    // allocation failure is a Result value (OOM → .Err)
{ Allocator, try_acquire, DynAlloc, dyn_heap } = std.mem.alloc    // explicit allocator trait; DynAlloc = narrow Allocator stored by the AMBIENT form
Set*<T>: {
    elems: RawPtr<u8>,
    idx: RawPtr<u8>,
    len: i64,
    cap: i64,
    slots = (s: Set<T>) [T] {
        // cap + 1 T slots: [0,cap) live entries, slot `cap` is the reusable SCRATCH cell.
        slice(s.elems, s.cap + 1)
    }
    index = (s: Set<T>) [i64] {
        // 2*cap i64 slots: [0,cap) bucket heads, [cap,2*cap) per-entry next links.
        slice(s.idx, s.cap * 2)
    }
    len = (s: Set<T>) i64 { s.len }
    bytes_of = (s: Set<T>, slot: i64) [u8] {
        // a [u8] view of one slot's sizeof(T) bytes — the unit of hashing and equality.
        slice(s.elems.offset(slot * sizeof(T)), sizeof(T))
    }
    shash = (s: Set<T>, slot: i64) i64 {
        // FNV-1a of slot's bytes, folded into [0, cap). cap is always >= 1 at call sites.
        bs: [u8] := s.bytes_of(slot)
        h := 2166136261
        bs.loop((hh, i, b) {
            h = (h ^ to_i64(b)) * 16777619
        })
        (h & 4611686018427387903) % s.cap
    }
    seq = (s: Set<T>, a: i64, b: i64) bool {
        // byte-wise equality of two slots.
        ab: [u8] := s.bytes_of(a)
        bb: [u8] := s.bytes_of(b)
        eqf := true
        ab.loop((hh, i, x) {
            (x == bb[i] == false).then({
                eqf = false
            })
        })
        eqf
    }
    find = (s: Set<T>, x: T) i64 {
        // O(1) average: write the query into the scratch slot, hash to a bucket, walk the chain comparing bytes.
        (s.cap == 0).match ({
            true  => 0 - 1,
            false => {
                sl := s.slots()
                sl[s.cap] = x
                ix := s.index()
                s.schain(ix[s.shash(s.cap)])
            },
        })
    }
    schain = (s: Set<T>, e: i64) i64 {
        (e < 0).match ({
            true  => 0 - 1,
            false => s.seq(s.cap, e).match ({ true => e, false => s.schain(s.index()[s.cap + e]) }),
        })
    }
    has = (s: Set<T>, x: T) bool { s.find(x) >= 0 }
    grow<A> = (s: Set<T>, a: MutPtr<A>) Result<Set<T>, IoError> {
        // Acquire fresh buffers (double the cap), copy the live entries over, release the old ones, then
        // reindex. OOM at either acquire is returned as .Err (the old buffers stay valid and are NOT freed
        // on the failure path). Mirrors HMap.grow.
        cap := s.cap * 2 + 1
        a.try_acquire((cap + 1) * sizeof(T)).match ({
            .Ok(ep) => {
                a.try_acquire(cap * 2 * sizeof(i64)).match ({
                    .Ok(ip) => {
                        olds := s.slots()
                        next := Set<T>(
                            elems: ep,
                            idx: ip,
                            len: s.len,
                            cap: cap,
                        )
                        dst := next.slots()
                        olds.loop((h, i, e) {
                            (i < s.len).match ({
                                true  => {
                                    dst[i] = e
                                },
                                false => {
                                    h.break
                                },
                            })
                        })
                        a.release(s.elems)
                        a.release(s.idx)
                        ok: Result<Set<T>, IoError> := .Ok(next.reindex())
                        ok
                    },
                    .Err(e) => {
                        a.release(ep)
                        err: Result<Set<T>, IoError> := .Err(e)
                        err
                    },
                })
            },
            .Err(e) => {
                err: Result<Set<T>, IoError> := .Err(e)
                err
            },
        })
    }
    reindex = (s: Set<T>) Set<T> {
        // Rebuild the hash index from the live element column. O(len).
        ix := s.index()
        cap := s.cap
        ix.loop((h, i, v) {
            (i < cap).match ({
                true  => {
                    ix[i] = 0 - 1
                },
                false => {
                    h.break
                },
            })
        })
        sl := s.slots()
        sl.loop((h, i, e) {
            (i < s.len).match ({
                true  => {
                    b := s.shash(i)
                    ix[cap + i] = ix[b]
                    ix[b] = i
                },
                false => {
                    h.break
                },
            })
        })
        s
    }
    link = (s: Set<T>, slot: i64) Set<T> {
        // Link an already-written element slot into its bucket.
        ix := s.index()
        b := s.shash(slot)
        ix[s.cap + slot] = ix[b]
        ix[b] = slot
        s
    }
    append<A> = (s: Set<T>, a: MutPtr<A>, x: T) Result<Set<T>, IoError> {
        // Append an element (caller has ensured it is absent) and link it into its bucket. Grows first when
        // full; a grow OOM is returned as .Err. Mirrors HMap.append.
        x := x
        out: Result<Set<T>, IoError> := (s.len < s.cap).match ({
            true  => {
                sl := s.slots()
                sl[s.len] = x
                ok: Result<Set<T>, IoError> := .Ok(Set<T>(
                    elems: s.elems,
                    idx: s.idx,
                    len: s.len + 1,
                    cap: s.cap,
                ).link(s.len))
                ok
            },
            false => {
                s.grow(a).match ({
                    .Ok(next) => {
                        sl := next.slots()
                        sl[next.len] = x
                        ok: Result<Set<T>, IoError> := .Ok(Set<T>(
                            elems: next.elems,
                            idx: next.idx,
                            len: next.len + 1,
                            cap: next.cap,
                        ).link(next.len))
                        ok
                    },
                    .Err(e)   => {
                        err: Result<Set<T>, IoError> := .Err(e)
                        err
                    },
                })
            },
        })
        out
    }
    add<A> = (s: Set<T>, a: MutPtr<A>, x: T) Result<Set<T>, IoError> {
        // Insert if absent (allocation failure is a value). RETURNS the updated set — always rebind to the
        // result (`s = s.add(...).expect("…")` / `.or_return()`). Adding an element already present is a
        // no-op (len unchanged). On grow the buffers are realloced, so any handle captured before this call
        // dangles (see the VALUE-MOLD CONTRACT above). Mirrors HMap.put.
        i := s.find(x)
        out: Result<Set<T>, IoError> := (i < 0).match ({
            true  => s.append(a, x),
            false => {
                ok: Result<Set<T>, IoError> := .Ok(s)
                ok
            },
        })
        out
    }
    remove<A> = (s: Set<T>, a: MutPtr<A>, x: T) Set<T> {
        // Delete an element. RETURNS the updated set. Absent element => unchanged. Implemented as a swap-remove
        // (the last live element fills the hole) followed by a reindex; iteration order is NOT preserved. `a` is
        // accepted for signature symmetry with the other owned ops — `remove` never reallocs (it does not shrink).
        i := s.find(x)
        out: Set<T> := (i < 0).match ({
            true  => s,
            false => {
                sl := s.slots()
                sl[i] = sl[s.len - 1]
                next := Set<T>(
                    elems: s.elems,
                    idx: s.idx,
                    len: s.len - 1,
                    cap: s.cap,
                )
                next.reindex()
            },
        })
        out
    }
    free<A> = (s: Set<T>, a: MutPtr<A>) void {
        a.release(s.elems)
        a.release(s.idx)
    }
    clone<A> = (s: Set<T>, a: MutPtr<A>) Result<Set<T>, IoError> {
        // Deep-copy the set into fresh buffers from `a`, giving the result INDEPENDENT storage: mutating the
        // clone (or the original) never writes through to the other. The clone owns its buffers and must be
        // `free`d independently. O(len). OOM on either acquire is returned as .Err (the first buffer is
        // released before returning if the second fails).
        cap := s.cap
        a.try_acquire((cap + 1) * sizeof(T)).match ({
            .Ok(ep) => {
                a.try_acquire(cap * 2 * sizeof(i64)).match ({
                    .Ok(ip) => {
                        next := Set<T>(
                            elems: ep,
                            idx: ip,
                            len: s.len,
                            cap: cap,
                        )
                        src := s.slots()
                        dst := next.slots()
                        src.loop((h, i, e) {
                            (i < s.len).match ({
                                true  => {
                                    dst[i] = e
                                },
                                false => {
                                    h.break
                                },
                            })
                        })
                        ok: Result<Set<T>, IoError> := .Ok(next.reindex())
                        ok
                    },
                    .Err(e) => {
                        a.release(ep)
                        err: Result<Set<T>, IoError> := .Err(e)
                        err
                    },
                })
            },
            .Err(e) => {
                err: Result<Set<T>, IoError> := .Err(e)
                err
            },
        })
    }
    each = (s: Set<T>, f: (T) void) void {
        // Visit every live element, in insertion order (until the first remove). `f` is invoked DIRECTLY in the
        // loop body so an inline lambda splices in (like map.each_pair / iter.each): `s.each((x){ … })`.
        sl := s.slots()
        sl.loop((h, i, e) {
            (i < s.len).match ({
                true  => {
                    f(e)
                },
                false => {
                    h.break
                },
            })
        })
    }
}
// a zero-element `Set<T>` with capacity for at least one entry. No seed pins T, so it comes from the LHS
// annotation: `s: Set<i64> := sets.empty(a)`. A is inferred from `a`. The index is reindexed (its single
// bucket head cleared to -1) so `find`/`has` on the empty set return absent immediately.
empty*<T, A> = (a: MutPtr<A>) Result<Set<T>, IoError> {
    a.try_acquire((1 + 1) * sizeof(T)).match ({
        .Ok(ep) => {
            a.try_acquire(2 * sizeof(i64)).match ({
                .Ok(ip) => {
                    s := Set<T>(
                        elems: ep,
                        idx: ip,
                        len: 0,
                        cap: 1,
                    )
                    ok: Result<Set<T>, IoError> := .Ok(s.reindex())
                    ok
                },
                .Err(e) => {
                    a.release(ep)
                    err: Result<Set<T>, IoError> := .Err(e)
                    err
                },
            })
        },
        .Err(e) => {
            err: Result<Set<T>, IoError> := .Err(e)
            err
        },
    })
}
// a `Set<T>` seeded with one element, its buffers acquired from `a`. T inferred from the seed value
// (Zen has no call-site type args). Starts at cap 1.
of*<T, A> = (a: MutPtr<A>, first: T) Result<Set<T>, IoError> {
    a.try_acquire((1 + 1) * sizeof(T)).match ({
        .Ok(ep) => {
            a.try_acquire(2 * sizeof(i64)).match ({
                .Ok(ip) => {
                    s := Set<T>(
                        elems: ep,
                        idx: ip,
                        len: 1,
                        cap: 1,
                    )
                    sl := s.slots()
                    sl[0] = first
                    ok: Result<Set<T>, IoError> := .Ok(s.reindex())
                    ok
                },
                .Err(e) => {
                    a.release(ep)
                    err: Result<Set<T>, IoError> := .Err(e)
                    err
                },
            })
        },
        .Err(e) => {
            err: Result<Set<T>, IoError> := .Err(e)
            err
        },
    })
}
// add `e` to `r` only when `keep` — the Result-valued conditional-insert helper the folds below use.
// Returns `r` unchanged when `keep` is false.
add_if<T, A> = (a: MutPtr<A>, r: Set<T>, e: T, keep: bool) Result<Set<T>, IoError> {
    keep.match ({
        true  => r.add(a, e),
        false => {
            same: Result<Set<T>, IoError> := .Ok(r)
            same
        },
    })
}
// fold y's live elements into `r` (add-all), recursively; a per-element OOM threads out as .Err via
// or_return (works inside this generic Result<Set<T>, …> body since #54 substitutes T in the Err guard).
union_fold<T, A> = (a: MutPtr<A>, r: Set<T>, y: Set<T>, i: i64) Result<Set<T>, IoError> {
    (i >= y.len).match ({
        true  => {
            done: Result<Set<T>, IoError> := .Ok(r)
            done
        },
        false => {
            sl := y.slots()
            nr := r.add(a, sl[i]).or_return()
            a.union_fold(nr, y, i + 1)
        },
    })
}
// fold x's live elements into `r`, adding each only when `y.has(e) == keep_when` (true for intersect,
// false for difference); a per-element OOM threads out as .Err via or_return (#54).
sift_fold<T, A> = (a: MutPtr<A>, r: Set<T>, x: Set<T>, y: Set<T>, i: i64, keep_when: bool) Result<Set<T>, IoError> {
    (i >= x.len).match ({
        true  => {
            done: Result<Set<T>, IoError> := .Ok(r)
            done
        },
        false => {
            sl := x.slots()
            e := sl[i]
            keep := y.has(e) == keep_when
            nr := a.add_if(r, e, keep).or_return()
            a.sift_fold(nr, x, y, i + 1, keep_when)
        },
    })
}
// {x} ∪ {y}: a fresh set (buffers from `a`) holding every element of x and y. Starts as a clone of x, then
// folds y in; the inputs are untouched. O(|x| + |y|). Allocation failure is a value.
union*<T, A> = (a: MutPtr<A>, x: Set<T>, y: Set<T>) Result<Set<T>, IoError> {
    x.clone(a).match ({
        .Ok(r)  => a.union_fold(r, y, 0),
        .Err(e) => {
            err: Result<Set<T>, IoError> := .Err(e)
            err
        },
    })
}
// {x} ∩ {y}: a fresh set holding the elements present in BOTH. O(|x|) membership probes into y.
intersect*<T, A> = (a: MutPtr<A>, x: Set<T>, y: Set<T>) Result<Set<T>, IoError> {
    er: Result<Set<T>, IoError> := empty(a)
    er.match ({
        .Ok(r)  => a.sift_fold(r, x, y, 0, true),
        .Err(e) => {
            err: Result<Set<T>, IoError> := .Err(e)
            err
        },
    })
}
// {x} \ {y}: a fresh set holding the elements of x that are NOT in y. O(|x|) membership probes into y.
difference*<T, A> = (a: MutPtr<A>, x: Set<T>, y: Set<T>) Result<Set<T>, IoError> {
    er: Result<Set<T>, IoError> := empty(a)
    er.match ({
        .Ok(r)  => a.sift_fold(r, x, y, 0, false),
        .Err(e) => {
            err: Result<Set<T>, IoError> := .Err(e)
            err
        },
    })
}
// ── AMBIENT FORM (rt-drawn) ────────────────────────────────────────────────────────────────────────
// The allocator-free twin of `Set<T>`, in the exact `AVec<T>` mold (see std.collections.vec for the full
// rationale). `ASet<T>` STORES the narrow allocator captured at construction (the ambient rt narrowed to
// a `DynAlloc`) and draws every later allocation (grow, free) from THAT allocator — it never re-reads
// `current()` per op, so an ASet is safe to outlive the scope it was born in (re-reading would
// cross-allocator-free on grow). Everything
// above (the explicit `Set<T>` + `of(a, …)`/`s.add(a, x)`/`s.free(a)` forms and the set-algebra free fns)
// is UNCHANGED; this section only adds new names on a new type.
//
//   s: ASet<i64> := set.new()          // T from the annotation (nothing to infer it)
//   s  = s.add(10)                     // no allocator — bytes from the stored rt
//   s  = s.add(20)
//   s.has(10)                          // true
//   s  = s.remove(10)
//   n  := s.len()   s.each((x){ ... })
//   s.free()
//
//   t := set.from([1, 2, 2, 3])        // seed + dedup from a slice; T inferred (t.len() == 3)
ASet*<T>: {
    inner: Set<T>,
    alloc: DynAlloc,
    len = (w: ASet<T>) i64 { w.inner.len() }
    has = (w: ASet<T>, x: T) bool { w.inner.has(x) }
    each = (w: ASet<T>, f: (T) void) void { w.inner.each(f) }
    add = (w: ASet<T>, x: T) ASet<T> {
        // In a chain (`s.add(x).add(y)`) the receiver `w` is the previous op's side-effecting
        // result, and its link step is NON-idempotent. The inliner binds such a multiply-used arg
        // to one temp (evaluate-once), so referencing `w` several times below is safe.
        a := w.alloc
        ASet<T>(
            inner: w.inner.add(a.addr(), x).expect("set.add: out of memory"),
            alloc: w.alloc,
        )
    }
    remove = (w: ASet<T>, x: T) ASet<T> {
        a := w.alloc
        ASet<T>(
            inner: w.inner.remove(a.addr(), x),
            alloc: w.alloc,
        )
    }
    free = (w: ASet<T>) void {
        a := w.alloc
        w.inner.free(a.addr())
    }
}
// EXPLICIT-allocator constructor — THE REAL CONSTRUCTION PATH. Build a zero-element `ASet<T>` bound to a
// caller-supplied NARROW Allocator (`a: DynAlloc`), with NO ambient draw (docs/runtime-design.md:
// explicit capability threading is the model). The ambient `new()` below is a one-line shim — the single
// process-heap draw (`dyn_heap()`) on the set construction path.
new_in*<T> = (a: DynAlloc) ASet<T> {
    da := a
    sr: Result<Set<T>, IoError> := empty(da.addr())
    ASet<T>(
        inner: sr.expect("set.new: out of memory"),
        alloc: a,
    )
}
// a zero-element ambient `ASet<T>` (capacity for one, like `empty`). T comes from the LHS annotation:
// `s: ASet<i64> := set.new()`. The process heap is drawn ONCE here (as a DynAlloc) and stored for the
// life of the set. `new_in`'s body is inlined (no bare `new_in` call — that bare name is ambiguous with
// std.text.string's generic `new_in<A>(MutPtr<A>)` once both flatten together; qualified `set.new_in`
// stays the external real path).
new*<T> = () ASet<T> {
    a := dyn_heap()
    sr: Result<Set<T>, IoError> := empty(a.addr())
    ASet<T>(
        inner: sr.expect("set.new: out of memory"),
        alloc: a,
    )
}
// EXPLICIT-allocator seed constructor: an `ASet<T>` bound to `a`, seeded from a slice (dedups via `add`).
// No ambient draw. T inferred from the elements.
from_in*<T> = (a: DynAlloc, xs: [T]) ASet<T> {
    da := a
    sr: Result<Set<T>, IoError> := empty(da.addr())
    st := sr.expect("set.from: out of memory")
    xs.loop((h, i, x) {
        st = st.add(da.addr(), x).expect("set.from: out of memory")
    })
    ASet<T>(
        inner: st,
        alloc: a,
    )
}
// an ambient `ASet<T>` seeded from a slice. Narrow the process heap once; `from_in`'s body is inlined
// (no bare `from_in` call — same string-`new_in` collision avoidance).
from*<T> = (xs: [T]) ASet<T> {
    a := dyn_heap()
    sr: Result<Set<T>, IoError> := empty(a.addr())
    st := sr.expect("set.from: out of memory")
    xs.loop((h, i, x) {
        st = st.add(a.addr(), x).expect("set.from: out of memory")
    })
    ASet<T>(
        inner: st,
        alloc: a,
    )
}
