// THE TEST FRAMEWORK'S ASSERTION CANNOT BE CALLED, AND THIS IS WHERE
// THAT IS WRITTEN DOWN. `src/std/test/test.zen` declares `Tester.expect`
// with a signature and no body, exactly as `Console`'s and `Fs`'s
// members are declared -- but those bottom out in gen_c's floor, and
// this one bottoms out nowhere.
//
// A `Tester` VALUE IS CONSTRUCTIBLE: sema accepts the four fields
// below, lambdas included, and the construction on its own compiles.
// What does not lower is the CALL. `t.expect(false)` resolves to the
// member DECLARED in test.zen, not to the lambda sitting in the field,
// so gen_c_member.zen reaches its "a member with no body" refusal --
// which means no program in this tree can perform a `Tester`
// assertion, passing or failing.
//
// That is the whole reason `std.test` has no behavioural test: there is
// no behaviour. This file pins the refusal so it stays LOUD. The day
// the call lowers, run.py reports "the program compiled; it must be
// rejected", which is the signal to delete this file and write the
// tests it is standing in for -- starting with the one that matters,
// an `expect(false)` that actually reports a failure.
//
// The sibling file pins the other door, which fails differently.

Tester, TestError = std.test

Error = | Boom

main = (env: Env) Res<i32, Error> {
    alloc ::= env.mem.alloc();
    t = Tester(
        env: env,
        alloc: alloc,
        expect: (self: Tester, cond: bool) Res<(), TestError> {
            cond.match({
                true  => Ok(()),
                false => Err(TestError.Failed("expect(false) must fail")),
            })
        },
        expect_eq: <T: Eq>(self: Tester, a: T, b: T) Res<(), TestError> {
            Ok(())
        },
    );
    t.expect(false).match({
        Ok(_)  => println("passed"),
        Err(e) => e.match({ Failed(why) => println("failed: {}", why) }),
    });
    Ok(0);
}
