halloc = std.mem.heap
maps = std.collections.map
{ expect } = std.core.result
{ println } = std.io.print
main = () i32 {
    alloc = halloc.gpa()
    a = alloc.addr()
    w ::= a.allocator().map_of("k0", 0).expect("map")
    w = w.put(a, "k1", 10).expect("put")
    w = w.put(a, "k2", 20).expect("put")
    w = w.put(a, "k3", 30).expect("put")
    w = w.put(a, "k4", 40).expect("put")
    w = w.put(a, "k5", 50).expect("put")
    w = w.put(a, "k6", 60).expect("put")
    w = w.put(a, "k7", 70).expect("put")
    w = w.put(a, "k8", 80).expect("put")
    println(w.len())
    println(w.get("k0", 0 - 1))
    println(w.get("k8", 0 - 1))
    caps ::= a.allocator().map_of("uk", "london").expect("map")
    caps = caps.put(a, "fr", "paris").expect("put")
    caps = caps.put(a, "fr", "PARIS").expect("put")
    println(caps.get("fr", "?"))
    println(caps.get("de", "miss"))
    println(caps.len())
    w.free(a)
    caps.free(a)
    0
}
