        want_exit: "14",
        want_out: "",
        check_out: false,
    ), FixtureCase(
        path: "tests/fixtures/zen/string_explicit_allocator_result.zen",
        want_exit: "8",
        want_out: "",
        check_out: false,
    ), FixtureCase(
        path: "tests/fixtures/zen/build_struct_program.zen",
        want_exit: "12",
        want_out: "",
        check_out: false,
    ), FixtureCase(
        path: "tests/fixtures/zen/import_eq_true.zen",
        want_exit: "1",
        want_out: "",
        check_out: false,
    ), FixtureCase(
        path: "tests/fixtures/zen/import_eq_false.zen",
        want_exit: "0",
        want_out: "",
        check_out: false,
    ), FixtureCase(
        path: "tests/fixtures/zen/enum_match_widen.zen",
        want_exit: "0",
        want_out: "",
        check_out: false,
    ), FixtureCase(
        path: "tests/fixtures/zen/fmt_numeric_write_explicit_alloc.zen",
        want_exit: "0",
        want_out: "-71.25",
        check_out: true,
    ), FixtureCase(
        path: "tests/fixtures/zen/fmt_numeric_write_result.zen",
        want_exit: "0",
        want_out: "42",
        check_out: true,
    ), FixtureCase(
        path: "tests/fixtures/zen/net_loopback.zen",
        want_exit: "0",
        want_out: "",
        check_out: false,
    )])
    // return inside match arms (the manual unwrap-or-propagate idiom): guard-match `return err(e)`
    // + value-position diverging arms, nested/loop/bool/both-arms/generic variants — all
    // VALUE-verified on both the Ok and Err paths.
    // params shadow top-level names: closure param `f` + top-level `f` in one flattened program.
    // conditional-position (match-arm value) or_return in a generic, Err path: the callee's
    // early return must NOT escape into the caller (the caller's .Err recovery must run).
    // same shape, Ok path + branch-not-taken path (the guarded receiver must not evaluate).
    // conditional or_return inside a .loop body inside a generic (a return in a loop can
    // never lift to ?: — the generic must monomorphize, not inline).
    // or_return as a && RIGHT operand in a generic: Err propagates when the rhs runs, and the
    // rhs must not evaluate at all when the lhs is false.
    // build/run a struct program (zenc build emits a runnable binary): p.x*p.y = 12.
    // U1.3 std-import resolution: eq("ab","ab")=true=>1, eq("ab","xy")=false=>0.
    // enum match numeric arms widen the result type (i64) so got==big() holds.
    // fmt numeric write helpers (Result-always) thread an explicit (counting/limiting) allocator.
    // ── (b) build+run+stdout fixtures (print / text / map acceptance programs) ───────────────────
    so := run_fixtures("build stdout", [FixtureCase(
        path: "tests/fixtures/zen/print_text_and_ints.zen",
        want_exit: "0",
        want_out: "answer:\n42\ntrue\n",
        check_out: true,
    ), FixtureCase(
        path: "tests/fixtures/zen/print_str_and_string.zen",
        want_exit: "0",
        want_out: "borrowed\nalias\nowned!\nowned\n",
        check_out: true,
    ), FixtureCase(
        path: "tests/fixtures/zen/print_formatted_line.zen",
        want_exit: "0",
        want_out: "x=3 y=hello z=3.14\nthe: 5\nok=true\ng=world 5\n",
        check_out: true,
    ), FixtureCase(
        path: "tests/fixtures/zen/print_interpolated.zen",
        want_exit: "0",
        want_out: "name=Zen n=42\ns=hi i=7 f=3.14 b=true\nbraces {} and 9 done\nmissing 1  extra\nowned=world\n",
        check_out: true,
    ), FixtureCase(
        path: "tests/fixtures/zen/error_display_name.zen",
        want_exit: "0",
        want_out: "NotFound\nread failed: NotFound\nTrailing\n",
        check_out: true,
    ), FixtureCase(
        path: "tests/fixtures/zen/str_text_common_ty.zen",
        want_exit: "0",
        want_out: "no file\n",
        check_out: true,
    ), FixtureCase(
        path: "tests/fixtures/zen/str_ops_edges.zen",
        want_exit: "0",
        want_out: "6\n-1\n0\n1\n2\n0\n1\n1\n0\n1\n0\n0\n-7\n12\n0\n123456789012\n",
        check_out: true,
    ), FixtureCase(
        path: "tests/fixtures/zen/str_allocator_result.zen",
        want_exit: "0",
        want_out: "2\n3\n97\nell\nell\n0\n0\nor\nor\n",
        check_out: true,
    ), FixtureCase(
        path: "tests/fixtures/zen/str_try_parse_result.zen",
        want_exit: "0",
        want_out: "",
        check_out: true,
    ), FixtureCase(
        path: "tests/fixtures/zen/map_wordfreq.zen",
        want_exit: "0",
        want_out: "3\n2\n1\n-1\n1\n0\n5\n",
        check_out: true,
    ), FixtureCase(
        path: "tests/fixtures/zen/int_map_roundtrip.zen",
        want_exit: "0",
        want_out: "10\n20\n99\n-1\n11\n1\n0\n0\n5000\n6300\n-1\n65\n",
        check_out: true,
    ), FixtureCase(
        path: "tests/fixtures/zen/hmap_i64_grow_delete.zen",
        want_exit: "0",
        want_out: "51\n7\n51\n11\nnone\n50\n50\n50\n12\n51\n",
        check_out: true,
    ), FixtureCase(
        path: "tests/fixtures/zen/hmap_wordfreq.zen",
        want_exit: "0",
        want_out: "5\n3\n2\n-1\n1\n8\nnone\n4\n5\n",
        check_out: true,
    ), FixtureCase(
        path: "tests/fixtures/zen/hmap_struct_key.zen",
        want_exit: "0",
        want_out: "100\n73\n37\n-1\n100\n90\n0\n65\n",
        check_out: true,
    ), FixtureCase(
        path: "tests/fixtures/zen/hmap_delete_churn.zen",
        want_exit: "0",
        want_out: "200\n100\n100\n100\n200\n200\n",
        check_out: true,
    ), FixtureCase(
        path: "tests/fixtures/zen/hmap_literal_keys.zen",
        want_exit: "0",
        want_out: "two\none\nthree\n3\nfour\ntwenty\nten\n2\n",
        check_out: true,
    ), FixtureCase(
        path: "tests/fixtures/zen/generic_literal_pin.zen",
        want_exit: "0",
        want_out: "8\n8\n8\n8\n4\n8\n4\n1\n255\n",
        check_out: true,
    ), FixtureCase(
        path: "tests/fixtures/zen/print_floats.zen",
        want_exit: "0",
        want_out: "1.5\n0.25\n-3.0\n0.001\n2.0\n2.0\n0.0\n0.3\n1.0e-7\n",
        check_out: true,
    ), FixtureCase(
        path: "tests/fixtures/zen/print_f32.zen",
        want_exit: "0",
        want_out: "1.5\n0.251.5\n100.0\n",
        check_out: true,
    ), FixtureCase(
        path: "tests/fixtures/zen/print_float_precision.zen",
        want_exit: "0",
        want_out: "0.123456789\n2.718281828459\n65536.0\n1234567890.0\n123456.789\n0.0009765625\n",
        check_out: true,
    ), FixtureCase(
        path: "tests/fixtures/zen/print_float_tiny.zen",
        want_exit: "0",
        want_out: "1.0e-300\n5.0e-300\n1.0e-296\n1.0e-291\n1.0e-308\n2.2e-308\n1.5e-200\n",
        check_out: true,
    ), FixtureCase(
        path: "tests/fixtures/zen/str_concat.zen",
        want_exit: "0",
        want_out: "abc\nname=Zen!\n",
        check_out: true,
    ), FixtureCase(
        path: "tests/fixtures/zen/print_bool_literals.zen",
        want_exit: "0",
        want_out: "true\nfalse\n",
        check_out: true,
    ), FixtureCase(
        path: "tests/fixtures/zen/integer_print_negatives.zen",
        want_exit: "0",
        want_out: "0\n-7\n1000000\n",
        check_out: true,
    ), FixtureCase(
        path: "tests/fixtures/zen/main_sys.zen",
        want_exit: "0",
        want_out: "hi from sys\n",
        check_out: true,
    )])
    // flip-proof for the literal-rebind silent-wrong bug: literal keys against HMap<i64,str>
