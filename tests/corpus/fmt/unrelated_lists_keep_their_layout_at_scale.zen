render = fmt.fmt
scan, Source = std.lex

check = (env: Env, count: usize) Res<(), AllocError> {
    a = env.mem.alloc();
    input  ::= a.String("main = () {\n").try();
    wanted ::= a.String("main = () {\n").try();
    Range(0, count).loop((index) {
        input.add("    f(1,  2);\n").try();
        wanted.add("    f(1, 2);\n").try();
    });
    input.add("}\n").try();
    wanted.add("}\n").try();
    lexed  = scan(a, Source(file: "many.zen", text: input.view())).try();
    result = render(a, lexed).try();
    second = render(
        a,
        scan(a, Source(file: "many.zen", text: result.text.view())).try()
    ).try();
    println(
        "{} faithful {} exact {} fixed {}",
        count,
        result.faithful && second.faithful,
        result.text.view().eq(wanted.view()),
        result.text.view().eq(second.text.view())
    );
    Ok(())
}

main = (env: Env) Res<(), AllocError> {
    check(env, 100).try();
    check(env, 400).try();
    check(env, 1600).try();
    check(env, 6400).try();
    Ok(())
}
