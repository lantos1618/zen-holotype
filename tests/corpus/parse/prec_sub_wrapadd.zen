// `-` and `+%` are the same precedence and associate LEFT:
// max - one +% two is (max - one) +% two = 2147483646 +% 2, which wraps
// to -2147483648. the other reading, max - (one +% two), is 2147483644.

main = (env: Env) Res<i32, ArgError> {
    max: i32 = 2147483647;
    one: i32 = 1;
    two: i32 = 2;
    v = max - one +% two;
    println("{}", v);
    Ok(0);
}
