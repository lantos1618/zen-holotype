to_json = std.json

Meta = {
    attempt: usize,
}

Request = {
    prompt: str,
    stream: bool,
    meta: Meta,
}

main = (env: Env) Res<(), AllocError> {
    request = Request(
        prompt: "quote: \" slash: \\ newline:\n",
        stream: true,
        meta: Meta(attempt: 3),
    );
    encoded = request.to_json(env.mem.alloc()).try();
    env.out.println("{}", encoded.view());
    Ok(())
}
