// An UNUSED import: `spare` and the second spelling of Box are bound
// by an import line and never read again. STYLE.md makes every name on
// an import line a claimed dependency -- a review rule, not a language
// error -- so this must COMPILE, and the unused binding must still be
// the real thing, not a zero-value stand-in.
//
// The tree lost weeks to defaults silently producing zeros, so the
// unused-then-used name here is u64.MAX: if any pass drops the binding
// and answers "the default of its type" instead, this prints 0 and not
// 18446744073709551615.
//
// One-line breaker: treat an import whose bindings are never read as a
// name-table entry that never resolves -> 0 where MAX should be.

Box, spare = box.box

main = (env: Env) Res<i32, IoError> {
    b = Box(label: 6);
    println("{} {}", b.describe(), spare);
    Ok(0);
}
