// src/gen/gen_c/gen_c_decl.zen
// What a declaration is in C, and what a translation unit is.
// THE WALK IS REACHABILITY-DRIVEN. A compilation stages the whole of
// `std` beside the program, so lowering every declaration in every
// module would emit a translation unit nobody asked for. `emit_program`
// seeds ONE module's functions and follows the calls that resolve —
// one merged graph, walked from a root, each thing emitted once.
// BODIES ARE LOWERED FIRST, EMITTED LAST. Lowering discovers which
// types need definitions and which checked-arithmetic helpers the
// runtime carries, and C wants both above the first use. Each body is
// lowered into its own buffer, and the translation unit assembled
// afterwards in the order C requires — banner, runtime, helpers,
// typedefs, tags, type definitions, prototypes, bodies, `main`.
// EVERY LIST IS SORTED BY MANGLED NAME, making output independent of
// module discovery order — the property the determinism gate and
// fixpoint oracle stand on. A prototype above every body is what lets
// the sort be by name rather than dependency: C needs a declaration
// before a call, not a definition.

Module, Decl, Function, Param, Span = std.ast
BlockId, Struct, Enum, Member = std.ast
AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId = sema.sema_ty
Def, decl_at = sema.sema_def
Ctx = sema.sema_check
Inst = sema.sema_inst
param_type = sema.sema_denote
self_ctx = sema.sema_member
ty_at = sema.sema_cand
Emit, order = gen.gen_emit
sym_fn, sym_local = gen.gen_name
GenFault = gen.gen_diag
CBackend, MethodRef = gen.gen_c.gen_c_state
LocalSlot = gen.gen_c.gen_c_frame
sub, enter_tparams, leave_tparams = gen.gen_c.gen_c_mono
open_named = gen.gen_c.gen_c_mono
enter_struct_tparams = gen.gen_c.gen_c_mono
signature_of = gen.gen_c.gen_c_call
ctype, declarator, spellable, is_unit, has_storage = gen.gen_c.gen_c_type
declared_ret = gen.gen_c.gen_c_type
closure_storage = gen.gen_c.gen_c_report
emit_types = gen.gen_c.gen_c_layout
Dest, block = gen.gen_c.gen_c_stmt
takes_closure = gen.gen_c.gen_c_inline
impl_member_at, by_arity, kept_or_arity = gen.gen_c.gen_c_impl
method_sig = gen.gen_c.gen_c_member
emit_main = gen.gen_c.gen_c_main
emit_banner, emit_floor, emit_helpers, emit_print, emit_stderr = gen.gen_c.gen_c_runtime
emit_fs, emit_scope, emit_scope_floor = gen.gen_c.gen_c_runtime
emit_stdin = gen.gen_c.gen_c_stdin
emit_env = gen.gen_c.gen_c_env
emit_clock = gen.gen_c.gen_c_clock
emit_threads = gen.gen_c.gen_c_threads

// A bound on the reachable set, and a diagnostic at it rather than a
// walk that does not terminate.
// IT COUNTS FUNCTIONS LOWERED — same unit as `bootstrap/gen_c.py`'s
// `MAX_FUNCTIONS`, same number, so the two implementations agree on
// which programs they accept rather than differing by an undocumented
// factor. The number this replaced was 4096 and bounded LOOP TURNS,
// each lowering one free function AND one member function — a bound of
// 4096 on each, so neither 4096 nor 8192.
// WHAT SETS THE NUMBER: the largest program this backend compiles is
// itself — `zen build src` lowers 3167 free + 902 member functions
// (4069 total); `corpus/cli/build_walks_a_root_it_is_given`, staging the
// driver, lowers 3754. 8192 is a little over twice the largest, and
// guards a program's SIZE. A DIVERGENCE IS UNAFFECTED BY THE NUMBER: an
// infinite monomorphisation has no bound and hits 8192 exactly as
// surely as it hit 4096, one pass later.
MAX_FUNCTIONS* : usize = 8192

// The whole translation unit for the program rooted at module `mi`.
emit_program* = (be :: CBackend, mi: usize, out :: Emit)
                Res<(), AllocError> {
    be.lower_program(mi).try();
    be.emit_prelude(out).try();
    be.emit_protos(out).try();
    be.emit_bodies(out).try();
    be.emit_main(mi, out).try();
    Ok(());
}

// The lowering, with nothing assembled. Its own name because a
// multi-file emission runs it once and then assembles many files off
// the one result — the walk is over the whole program either way.
lower_program* = (be :: CBackend, mi: usize) Res<(), AllocError> {
    be.seed(mi).try();
    drain(be)
}

// Everything a translation unit needs above its first prototype. The
// top of the single file, and the top of `zen.h` when there are many.
emit_prelude = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    emit_banner(out).try();
    emit_floor(out).try();
    emit_scope_floor(be, out).try();
    emit_fs(be, out).try();
    be.emit_stdin(out).try();
    be.emit_env(out).try();
    be.emit_clock(out).try();
    be.emit_threads(out).try();
    emit_print(be, out).try();
    emit_stderr(be, out).try();
    emit_helpers(be, out).try();
    be.emit_types(out).try();
    // AFTER the types, because a capture record names them, and before
    // the prototypes, because a `Scope` parameter is a `zg_scope *`.
    emit_scope(be, out).try();
    Ok(());
}

// Every function the root module declares — the roots, for the reason
// the header gives.
seed = (be :: CBackend, mi: usize) Res<(), AllocError> {
    be.tree.module_at(mi).match({
        None  => Ok(()),
        Ok(m) => be.seed_module(m, mi),
    }).try();
    Ok(());
}

seed_module = (be :: CBackend, m: Module, mi: usize) Res<(), AllocError> {
    Range(0, m.decls.len).loop((h, di) {
        be.seed_decl(m, mi, di).try();
    });
    Ok(());
}

seed_decl = (be :: CBackend, m: Module, mi: usize, di: usize)
            Res<(), AllocError> {
    m.decls.get(di).match({
        None  => Ok(()),
        Ok(d) => be.seed_function(m, mi, d),
    }).try();
    Ok(());
}

seed_function = (be :: CBackend, m: Module, mi: usize, d: Decl)
                Res<(), AllocError> {
    d.kind.match({
        Function(f) => be.seed_named(m, mi, f),
        _           => Ok(()),
    })
}

// The declaration is found through `defs_of` rather than by index, so
// the `Def` a seed carries is the same value a call site would resolve
// to — one identity for a function, not two.
// A GENERIC FUNCTION IS NOT A ROOT. There is no `Vec<T>` in C, only
// `Vec<i32>` for each `T` a program asked for, and only a call site says
// which — so a generic declaration is skipped here, reached through
// `call_reachable`. A FUNCTION THAT TAKES A BODY IS NOT A ROOT EITHER,
// for a stronger reason: a `(v: T) bool` parameter has no C spelling at
// all, so such a declaration is never emitted — it exists only inlined
// at its call sites, like the six loop declarations.
seed_named = (be :: CBackend, m: Module, mi: usize, f: Function)
             Res<(), AllocError> {
    ((f.tparams.len > 0) || be.takes_closure(f)).match({
        true  => Ok(()),
        false => be.seed_defs(mi, f),
    })
}

seed_defs = (be :: CBackend, mi: usize, f: Function) Res<(), AllocError> {
    found ::= be.alloc.Vec<Def>();
    be.check.world.own_defs(mi, f.name.text, found).try();
    found.loop((h, d) { be.seed_def(d).try() });
    Ok(());
}

seed_def = (be :: CBackend, d: Def) Res<(), AllocError> {
    is_function(d).match({
        false => Ok(()),
        true  => be.seed_root(d),
    })
}

// The symbol is built the same way a call site builds it, because the
// queue's identity IS the symbol: a root queued under one name and
// called under another would be emitted twice.
seed_root = (be :: CBackend, d: Def) Res<(), AllocError> {
    inst ::= be.alloc.Inst();
    sig  ::= be.alloc.Vec<TyId>();
    be.signature_of(d, inst, sig).try();
    sym ::= be.alloc.String().try();
    sym_fn(sym, be.check.types, be.check.world, d.qname, sig, inst).try();
    be.need_function(d, inst, sym.view())
}

is_function = (d: Def) bool {
    d.kind.match({ FunctionDef => true, _ => false })
}

// Lower everything queued, including whatever lowering queues, under
// `MAX_FUNCTIONS`.
// TWO QUEUES, INTERLEAVED. Lowering a free function discovers member
// functions and vice versa, so draining one to exhaustion then the
// other doesn't converge — each cursor advances one step per turn,
// reaching a fixpoint in one bounded walk.
// THE LOOP RUNS WHILE THERE IS WORK, not a fixed number of turns: a
// fixed count cannot tell a finished walk from a cut-off one.
drain = (be :: CBackend) Res<(), AllocError> {
    fi ::= 0;
    mi ::= 0;
    loop(() { be.more(fi, mi) }, (h) {
        (fi < be.fn_queue.len).then(() {
            be.lower_queued(fi).try();
            fi = fi + 1;
        });
        (mi < be.m_queue.len).then(() {
            be.lower_queued_method(mi).try();
            mi = mi + 1;
        });
    });
    be.report_overrun(fi, mi).try();
    Ok(());
}

// Something left to lower, and room left to lower it in.
more = (be :: CBackend, fi: usize, mi: usize) bool {
    ((fi + mi) < MAX_FUNCTIONS)
        && ((fi < be.fn_queue.len) || (mi < be.m_queue.len))
}

// The bound, said out loud. WITHOUT THIS THE BACKEND SIMPLY STOPS: it
// writes a translation unit with functions missing from it, `cc`
// reports the first call to one of them, and the reader looks for a
// bug in a program that has none. Silent truncation is the worst
// failure mode this compiler has.
report_overrun = (be :: CBackend, fi: usize, mi: usize) Res<(), AllocError> {
    (fi < be.fn_queue.len).then(() { be.overrun_at_fn(fi).try() });
    ((fi >= be.fn_queue.len) && (mi < be.m_queue.len)).then(() {
        be.overrun_at_method(mi).try()
    });
    Ok(());
}

// Reported at the first thing that was NOT lowered, which is the only
// position that tells a reader anything: it is where the walk stopped.
overrun_at_fn = (be :: CBackend, fi: usize) Res<(), AllocError> {
    be.fn_queue.get(fi).match({
        None  => Ok(()),
        Ok(d) => be.report(
            d.span.file,
            d.span,
            GenFault.Overrun(MAX_FUNCTIONS)
        ),
    }).try();
    Ok(());
}

overrun_at_method = (be :: CBackend, mi: usize) Res<(), AllocError> {
    be.m_queue.get(mi).match({
        None  => Ok(()),
        Ok(m) => be.overrun_at_decl(m),
    }).try();
    Ok(());
}

// A member has no `Def` of its own, so its position is its owning
// declaration's — the same `DeclId` the queue entry already carries.
overrun_at_decl = (be :: CBackend, m: MethodRef) Res<(), AllocError> {
    decl_at(be.tree, m.decl).match({
        None  => Ok(()),
        Ok(x) => be.report(
            x.span.file,
            x.span,
            GenFault.Overrun(MAX_FUNCTIONS)
        ),
    }).try();
    Ok(());
}

// THE INSTANTIATION IS ENTERED BEFORE THE BODY AND NOT INSIDE IT. Every
// type the lowering reads is substituted through `be.inst`, so the one
// place that knows which emission this is has to be the one that sets
// it — and a queue entry carries the instantiation precisely so the
// symbol above the body is the symbol the call site wrote.
lower_queued = (be :: CBackend, i: usize) Res<(), AllocError> {
    be.enter_inst(be.queued_inst(i).match({
        Ok(x) => x,
        None  => be.alloc.Inst(),
    }));
    be.fn_queue.get(i).match({
        None  => Ok(()),
        Ok(d) => be.lower_def(d),
    }).try();
    Ok(());
}

lower_queued_method = (be :: CBackend, i: usize) Res<(), AllocError> {
    be.enter_inst(be.queued_m_inst(i).match({
        Ok(x) => x,
        None  => be.alloc.Inst(),
    }));
    be.m_queue.get(i).match({
        None  => Ok(()),
        Ok(m) => be.lower_method_ref(m),
    }).try();
    Ok(());
}

lower_def = (be :: CBackend, d: Def) Res<(), AllocError> {
    decl_at(be.tree, d.id).match({
        None  => Ok(()),
        Ok(x) => be.lower_decl(d, x),
    }).try();
    Ok(());
}

lower_decl = (be :: CBackend, d: Def, x: Decl) Res<(), AllocError> {
    x.kind.match({
        Function(f) => be.lower_function(d, x, f),
        _           => Ok(()),
    })
}

// one function

// A declaration with no body — `Required` or `Hook` — has nothing to
// lower and is not a fault.
lower_function = (be :: CBackend, d: Def, x: Decl, f: Function)
                 Res<(), AllocError> {
    f.body.match({
        None    => Ok(()),
        Ok(blk) => be.lower_body(d, x, f, blk),
    })
}

// THE TYPE PARAMETERS ARE IN SCOPE FOR THE WHOLE BODY, not just the
// signature: a local written `v: T` is a written type like any other,
// and `T` means nothing unless bound. What each one BECAME is
// `be.inst`, set by the queue entry.
lower_body = (be :: CBackend, d: Def, x: Decl, f: Function, blk: BlockId)
             Res<(), AllocError> {
    mi   = d.id.module.to_usize();
    ctx  = be.plain_ctx(mi);
    mark = be.enter_tparams(f.tparams, d.qname).try();
    be.lower_shape(f, blk, d.qname, d.name, d.span, ctx, ctx.self_ty, mi).try();
    be.leave_tparams(mark).try();
    Ok(());
}

// one member function
// "A method is a UFCS function whose first parameter happens to be
// named `self`" — so it goes through the same shape, with `@Self` bound
// and a qualified name carrying the TYPE rather than the module.

lower_method_ref = (be :: CBackend, m: MethodRef) Res<(), AllocError> {
    decl_at(be.tree, m.decl).match({
        None  => Ok(()),
        Ok(x) => be.method_in_decl(m, x),
    })
}

// An enum carries members the way a struct does — `Color.impl(Coloured,
// { rgb = (self: @Self) RGB<u8> { .. } })` is the encoding for values on
// variants — but it DECLARES none of its own (a variant is not a
// member), so everything it answers is what an impl supplies.
method_in_decl = (be :: CBackend, m: MethodRef, x: Decl)
                 Res<(), AllocError> {
    x.kind.match({
        Struct(s) => be.method_member(m, s),
        Enum(_)   => be.supplied_member(m),
        _         => Ok(()),
    })
}

// THE TYPE'S OWN MEMBERS FIRST, THEN WHAT AN IMPL SUPPLIES — same order
// `sema_supply.zen` states: a member the declaration writes is never
// contested, one an impl supplies is reached only when the declaration
// has none. AND AT THE SIGNATURE THE CALL SITE RESOLVED — same rule
// `pick_member` reads a receiver's members by: a name naming two members
// names neither on its own.
method_member = (be :: CBackend, m: MethodRef, s: Struct)
                Res<(), AllocError> {
    found ::= be.alloc.Vec<Member>();
    s.members.loop((h, mem) {
        mem.named(m.name).then(() { found.add(mem).try() });
    });
    be.by_sig(m, found).try().match({
        None    => supplied_member(be, m),
        Ok(mem) => be.method_body(m, mem),
    })
}

supplied_member = (be :: CBackend, m: MethodRef) Res<(), AllocError> {
    found ::= be.alloc.Vec<Member>();
    be.impl_member_at(m.decl, m.name, found).try();
    be.by_sig(m, found).try().match({
        None    => Ok(()),
        Ok(mem) => be.method_body(m, mem),
    })
}

// WHICH MEMBER THE CALL SITE MEANT, not merely one of that arity.
// The entry carries the signature `sym_fn` mangled into the symbol this
// body is about to be written under, so the member to lower is the one
// whose declared parameters ARE that signature. Asking arity alone once
// picked the first of `Display`'s two `toString`s for both queue
// entries: the sink body was emitted twice, and every call to the
// second ran the first.
// ONE CANDIDATE IS NOT A CHOICE: with one member the arity test is the
// whole answer, and `method_sig` resolves a whole signature.
by_sig = (be :: CBackend, m: MethodRef, found: Vec<Member>)
         Res<Res<Member>, AllocError> {
    (found.len < 2).match({
        true  => Ok(by_arity(be, found, m.sig.len)),
        false => be.member_with_sig(m, found),
    })
}

// ARITY WHEN NO SIGNATURE MATCHES, because not every queue entry's
// signature was built by `method_sig`: `gen_c_fat.zen` erases a slot's
// type parameters before mangling, so a thunk's entry names types this
// comparison cannot reproduce. Falling back leaves every entry that
// resolves today resolving the same way.
member_with_sig = (be :: CBackend, m: MethodRef, found: Vec<Member>)
                  Res<Res<Member>, AllocError> {
    kept ::= be.alloc.Vec<Member>();
    found.loop((h, mem) { be.keep_same_sig(m, mem, kept).try() });
    Ok(be.kept_or_arity(kept, found, m.sig.len));
}

// A named helper rather than a `.then` inside the loop body: a loop
// binding read inside a nested closure does not resolve.
keep_same_sig = (
    be   :: CBackend,
    m    : MethodRef,
    mem  : Member,
    kept :: Vec<Member>
) Res<(), AllocError> {
    mem.kind.match({
        Function(f) => be.keep_if_same_sig(m, mem, f, kept),
        _           => Ok(()),
    })
}

// `be.inst` and not an empty one: the queue entry's instantiation was
// entered before this body was reached, and it is the same `Inst` the
// call site substituted its own signature through.
keep_if_same_sig = (
    be   :: CBackend,
    m    : MethodRef,
    mem  : Member,
    f    : Function,
    kept :: Vec<Member>
) Res<(), AllocError> {
    sig ::= be.alloc.Vec<TyId>();
    be.method_sig(
        m.self_ty,
        m.decl,
        f,
        m.decl.module.to_usize(),
        be.inst,
        sig
    ).try();
    same_tys(sig, m.sig).match({
        true  => kept.add(mem),
        false => Ok(()),
    })
}

same_tys = (a: Vec<TyId>, b: Vec<TyId>) bool {
    (a.len == b.len) && Range(0, a.len).find((i) {
        ty_at(a, i).eq(ty_at(b, i)) == false
    }).match({ Ok(_) => false, None => true })
}

method_body = (be :: CBackend, m: MethodRef, mem: Member)
              Res<(), AllocError> {
    mem.kind.match({
        Function(f) => be.method_fn(m, mem, f),
        _           => Ok(()),
    })
}

method_fn = (be :: CBackend, m: MethodRef, mem: Member, f: Function)
            Res<(), AllocError> {
    f.body.match({
        None    => Ok(()),
        Ok(blk) => be.method_shape(m, mem, f, blk),
    })
}

// The TYPE's parameters and not the member's: "a method of `Vec<T>` is
// generic in `T` whether or not it declares any of its own", so what a
// member body names is the declaration it lives in.
method_shape = (
    be  :: CBackend,
    m   : MethodRef,
    mem : Member,
    f   : Function,
    blk : BlockId
) Res<(), AllocError> {
    mi      = m.decl.module.to_usize();
    self_ty = be.method_self(m).try();
    ctx     = be.check.self_ctx(mi, self_ty).try();
    mark    = be.enter_struct_tparams(m.decl).try();
    // AND THE MEMBER'S OWN, under the member's qualified name: an impl
    // reached through a bound's erased slot is emitted at the byte type,
    // and `T` in its body means nothing unless the same owner that bound
    // it in the queue entry binds it again here.
    be.enter_tparams(f.tparams, m.qname).try();
    be.lower_shape(f, blk, m.qname, m.name, mem.span, ctx, self_ty, mi).try();
    be.leave_tparams(mark).try();
    Ok(());
}

// `@Self` FOR A GENERIC RECEIVER IS THE DECLARATION'S OWN TYPE; for
// every other receiver it's the one the call site reached. The
// distinction is exactly where the memo can be wrong: a receiver with
// no arguments has one emission and nothing to confuse, and `str`'s
// receiver is a PRIMITIVE no declaration's name interns to.
method_self = (be :: CBackend, m: MethodRef) Res<TyId, AllocError> {
    be.generic_recv(m.self_ty).match({
        false => Ok(m.self_ty),
        true  => be.open_self(m),
    })
}

generic_recv = (be: CBackend, ty: TyId) bool {
    be.check.types.at(ty).match({ Named(n) => n.args.len > 0, _ => false })
}

open_self = (be :: CBackend, m: MethodRef) Res<TyId, AllocError> {
    be.open_named(m.decl).try().match({
        None  => Ok(m.self_ty),
        Ok(t) => Ok(t),
    })
}

// the shape both go through
// `sctx` is the context a SIGNATURE is read in — a free function's has
// no `@Self` and a member's binds it to the receiver — and everything
// else is the same question asked of the same nodes.

lower_shape = (
    be      :: CBackend,
    f       : Function,
    blk     : BlockId,
    qname   : str,
    name    : str,
    span    : Span,
    sctx    : Ctx,
    self_ty : TyId,
    mi      : usize
)
              Res<(), AllocError> {
    ret = be.return_type(f, sctx).try();
    // BEFORE THE BODY, because lowering a body keeps thunks as well as
    // the function itself and they belong in the same file.
    be.enter_unit(mi);
    be.reset_frame().try();
    be.check.release(0).try();
    sig   ::= be.alloc.Vec<TyId>();
    proto ::= be.alloc.String().try();
    bind_params(be, f, sctx, sig).try();
    be.write_proto(qname, name, span, f, ret, sig, proto).try();
    be.open_buf().try();
    be.write_body(blk, mi, ret, self_ty, sctx.has_self).try();
    be.keep(qname, sig, proto).try();
    Ok(());
}

// Written, then substituted: `Vec<T>.get` returns `Res<T>` and this
// emission is the one that knows which `T`.
return_type* = (be :: CBackend, f: Function, ctx: Ctx)
              Res<TyId, AllocError> {
    declared = be.declared_ret(f, ctx).try();
    sub(be, declared)
}

// A context with a module and nothing else: no `@Self`, no enclosing
// `Res`. The one a signature is read in, since a signature has no
// enclosing function of its own.
plain_ctx* = (be :: CBackend, mi: usize) Ctx {
    Ctx(
        module: mi,
        ret: TyId(index: 0),
        has_ret: false,
        self_ty: TyId(index: 0),
        has_self: false
    )
}

// The context a BODY is lowered in. `ret` and `has_ret` are what
// `.try()` answers to: "the enclosing function must return a
// compatible Res".
body_ctx* = (be :: CBackend, mi: usize, ret: TyId) Ctx {
    Ctx(
        module: mi,
        ret: ret,
        has_ret: is_res(be, ret),
        self_ty: TyId(index: 0),
        has_self: false
    )
}

// The same, for a member function: `@Self` stays bound while the body
// is walked, because a method's body names it as freely as its
// signature does.
self_body_ctx* = (
    be       :: CBackend,
    mi       : usize,
    ret      : TyId,
    self_ty  : TyId,
    has_self : bool
) Ctx {
    Ctx(
        module: mi,
        ret: ret,
        has_ret: is_res(be, ret),
        self_ty: self_ty,
        has_self: has_self
    )
}

is_res* = (be :: CBackend, ret: TyId) bool {
    be.check.types.at(ret).match({ Res(_) => true, _ => false })
}

// Parameters are declared in the backend's scope AND in sema's, in
// that order, because the C name a parameter gets is the one the
// prototype has to print and the type it has is the one `type_of` must
// answer with.
bind_params = (be :: CBackend, f: Function, ctx: Ctx, sig :: Vec<TyId>)
              Res<(), AllocError> {
    f.params.loop((h, p) {
        bind_param(be, p, ctx, sig).try();
    });
    Ok(());
}

// Through `param_type`, not `type_from_ast`: `self :: @Self` has a
// written type meaning the receiver, and only the query that knows
// `@Self` can answer it.
// TWO TYPES, AND THE DIFFERENCE IS THE WHOLE POINT. The C declaration
// takes THIS EMISSION's type, since that's what the prototype prints.
// Sema takes the DECLARED one, still in its own parameters, because
// sema's memo is keyed by node id alone — a concrete answer written
// there is the answer every other instantiation reads back. `ty_of`
// puts `be.inst` through every read instead.
bind_param = (be :: CBackend, p: Param, ctx: Ctx, sig :: Vec<TyId>)
             Res<(), AllocError> {
    declared = be.check.param_type(p, ctx).try();
    ty       = sub(be, declared).try();
    sig.add(ty).try();
    be.declare(p.name.text, ty, p.mutable).try();
    be.check.bind(p.name.text, declared, p.mutable, true).try();
    Ok(());
}

// `<linkage><ret> <symbol>(<params>)`. Static when the translation unit
// is the whole program, since then nothing but C's own `main` needs
// external linkage. A multi-file emission drops it: `be.linkage()` is
// the one place either answer is spelled.
write_proto = (
    be    :: CBackend,
    qname : str,
    name  : str,
    span  : Span,
    f     : Function,
    ret   : TyId,
    sig   : Vec<TyId>,
    out   :: String
)
              Res<(), AllocError> {
    be.check_spellable(name, span, ret, sig).try();
    out.add_bytes(be.linkage()).try();
    be.ctype(ret, out).try();
    out.add_bytes(" ").try();
    sym_fn(out, be.check.types, be.check.world, qname, sig, be.inst).try();
    out.add_bytes("(").try();
    be.write_params(f, sig, out).try();
    out.add_bytes(")").try();
    Ok(());
}

write_params = (be :: CBackend, f: Function, sig: Vec<TyId>, out :: String)
               Res<(), AllocError> {
    (f.params.len == 0).match({
        true  => out.add_bytes("void"),
        false => be.write_param_list(f, sig, out),
    })
}

write_param_list = (
    be  :: CBackend,
    f   : Function,
    sig : Vec<TyId>,
    out :: String
) Res<(), AllocError> {
    written ::= false;
    unknown = be.check.types.unknown().try();
    f.params.loop((h, i, p) {
        ty = sig.get(i).match({ Ok(t) => t, None => unknown });
        be.has_storage(ty).then(() {
            written.then(() { out.add_bytes(", ").try() });
            be.write_param(p, i, sig, out).try();
            written = true;
        });
    });
    (written == false).then(() { out.add_bytes("void").try() });
    Ok(());
}

// A `::` parameter is declared as a POINTER — see `ref_declarator`.
write_param = (
    be  :: CBackend,
    p   : Param,
    i   : usize,
    sig : Vec<TyId>,
    out :: String
) Res<(), AllocError> {
    ty = sig.get(i).match({ Ok(t) => t, None => TyId(index: 0) });
    name ::= be.alloc.String().try();
    be.slot_index(p.name.text, p.name.span, name).try();
    p.mutable.match({
        false => be.declarator(ty, name.view(), out),
        true  => be.ref_declarator(ty, name.view(), out),
    })
}

// A `::` parameter holds the ADDRESS of its argument, inlined or not:
// the body writes the caller's own bytes and every read of the name is
// a dereference, which is what `LocalSlot.by_ref` records.
ref_declarator* = (be :: CBackend, ty: TyId, name: str, out :: String)
                  Res<(), AllocError> {
    be.ctype(ty, out).try();
    out.fmt(" *{name}")
}

slot_index = (be :: CBackend, name: str, span: Span, out :: String)
             Res<(), AllocError> {
    be.slot_of(name).match({
        Ok(s) => be.write_param_slot(name, span, s, out),
        None  => sym_local(out, name, 1),
    })
}

write_param_slot* = (
    be   :: CBackend,
    name : str,
    span : Span,
    s    : LocalSlot,
    out  :: String
) Res<(), AllocError> {
    be.closure_storage(span, s, "a lambda-holding parameter").try().match({
        true  => sym_local(out, name, s.index),
        false => sym_local(out, name, 1),
    })
}

// A type with no C spelling is reported once, at the signature, rather
// than at every use of the parameter it belongs to.
check_spellable = (
    be   :: CBackend,
    name : str,
    span : Span,
    ret  : TyId,
    sig  : Vec<TyId>
) Res<(), AllocError> {
    be.report_unspellable(name, span, ret).try();
    sig.loop((h, t) { be.report_unspellable(name, span, t).try() });
    Ok(());
}

report_unspellable = (be :: CBackend, name: str, span: Span, t: TyId)
                     Res<(), AllocError> {
    be.spellable(t).match({
        true  => Ok(()),
        false => be.report(span.file, span, GenFault.Unspellable(name)),
    })
}

// The statements, indented, and no braces: the braces belong to the
// prototype the body is emitted under, and writing them in one place
// is what keeps the two from disagreeing. A unit-returning function
// discards its value; everything else returns one.
write_body = (
    be       :: CBackend,
    blk      : BlockId,
    mi       : usize,
    ret      : TyId,
    self_ty  : TyId,
    has_self : bool
) Res<(), AllocError> {
    ctx = be.self_body_ctx(mi, ret, self_ty, has_self);
    be.indent();
    block(be, blk, ctx, ret, be.destination(ret)).try();
    Ok(());
}

destination = (be :: CBackend, ret: TyId) Dest {
    be.is_unit(ret).match({
        true  => Dest.Discard,
        false => Dest.Return,
    })
}

keep = (be :: CBackend, qname: str, sig: Vec<TyId>, proto: String)
       Res<(), AllocError> {
    name ::= be.alloc.String().try();
    sym_fn(name, be.check.types, be.check.world, qname, sig, be.inst).try();
    text ::= be.alloc.String().try();
    text.add_bytes(be.text()).try();
    be.add_function(name, proto, text)
}

// assembly

emit_protos = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    externs = order(be.alloc, be.extern_names).try();
    externs.loop((h, i) {
        be.extern_protos.get(i).match({
            None  => Ok(()),
            Ok(p) => write_proto_line(out, p),
        }).try();
    });
    seq = order(be.alloc, be.fn_names).try();
    seq.loop((h, i) {
        be.fn_protos.get(i).match({
            None  => Ok(()),
            Ok(p) => write_proto_line(out, p),
        }).try();
    });
    out.line().try();
    Ok(());
}

write_proto_line = (out :: Emit, proto: String) Res<(), AllocError> {
    out.bytes(proto.view()).try();
    out.say(";").try();
    Ok(());
}

emit_bodies = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    seq = order(be.alloc, be.fn_names).try();
    seq.loop((h, i) {
        be.write_body_at(out, i).try();
    });
    Ok(());
}

write_body_at = (be :: CBackend, out :: Emit, i: usize)
                Res<(), AllocError> {
    be.fn_protos.get(i).match({
        None  => Ok(()),
        Ok(p) => out.bytes(p.view()),
    }).try();
    out.say(" {").try();
    be.fn_bodies.get(i).match({
        None  => Ok(()),
        Ok(b) => out.bytes(b.view()),
    }).try();
    out.say("}").try();
    out.line().try();
    Ok(());
}

// the same program, in one file per module
// ONE TRANSLATION UNIT IS 110,451 LINES AND 4,641 FUNCTIONS, and `cc
// -O2` is superlinear in a unit's size: the same code split into
// per-module files and compiled with `-j16` measured 8.4x faster, and
// only then can a compiler cache skip a module nothing changed.
// NOTHING HERE RE-LOWERS. `lower_program` has already run; a unit is a
// selection from the one sorted list of functions, so the bytes of a
// body do not depend on which file it lands in. `emit_program` above
// stays the whole interface for the single-file mode the committed
// seed is built by.

// The one header, included by every unit: the prelude, and a prototype
// for every function in the program. A prototype above every body is
// what already lets the bodies be sorted by name rather than by
// dependency, so this file is the single-file top with the bodies cut
// off it.
emit_header* = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    out.say("#ifndef ZEN_H").try();
    out.say("#define ZEN_H").try();
    out.line().try();
    be.emit_prelude(out).try();
    be.emit_protos(out).try();
    out.say("#endif").try();
    Ok(());
}

// One unit: every function whose body was lowered while module `u` was
// the one being lowered, and `main` when `u` is the root.
emit_unit* = (
    be   :: CBackend,
    root : usize,
    u    : usize,
    seq  : Vec<usize>,
    out  :: Emit
)
             Res<(), AllocError> {
    out.say("#include \"zen.h\"").try();
    out.line().try();
    seq.loop((h, i) {
        // `.match` and not `.then`: a loop binding read inside a nested
        // closure does not resolve, and `i` is one.
        (be.unit_of(i) == u).match({
            false => Ok(()),
            true  => be.write_body_at(out, i),
        }).try();
    });
    (u == root).match({
        false => Ok(()),
        true  => be.emit_main(root, out),
    }).try();
    Ok(());
}

// Whether module `u` owns any body at all. A module every one of whose
// functions is generic, inlined, or unreached contributes no file —
// and an empty `.c` would still cost a compiler process.
unit_used* = (be: CBackend, u: usize) bool {
    Range(0, be.fn_units.len).find((i) { be.unit_of(i) == u }).match({
        Ok(_) => true,
        None  => false,
    })
}
