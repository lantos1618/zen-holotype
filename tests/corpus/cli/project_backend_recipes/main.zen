project, Action = zen.zen_project
ProjectArgs = std.build

run = (env: Env, alloc: Alloc, target: str) Res<(), AllocError> {
    job = ProjectArgs(
        root: "src/app",
        target: target,
        std_root: "src",
        argv: alloc.Vec<str>()
    );
    println("{} {}", target, project(env, alloc, job, Action.Run).try());
    Ok(())
}

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    run(env, alloc, "script").try();
    run(env, alloc, "named_script").try();
    run(env, alloc, "native").try();
    println(
        "script file {}",
        env.fs.read(
            alloc,
            "src/app/build/linux-x86_64/script.js"
        ).match({ Ok(_) => true, Err(_) => false })
    );
    println(
        "named file {}",
        env.fs.read(
            alloc,
            "src/app/dist/chosen.js"
        ).match({ Ok(_) => true, Err(_) => false })
    );
    println(
        "assembly file {}",
        env.fs.read(
            alloc,
            "src/app/build/linux-x86_64/native.s"
        ).match({ Ok(_) => true, Err(_) => false })
    );
    Ok(0)
}
