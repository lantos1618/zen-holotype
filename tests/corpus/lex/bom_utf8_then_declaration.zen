seed: i32 = 5381
// a utf-8 BOM (EF BB BF) sits immediately before `seed`, with no comment
// between. The BOM must be stripped EXACTLY -- one byte too few and `\xbf`
// is a stray character, one byte too many and the name is `eed` -- so the
// value printed here, not merely the fact that the file compiles, is what
// says the strip landed on the right boundary.
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    println("{} {}", seed, seed * 2);
    Ok(0);
}
