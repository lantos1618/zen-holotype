// probeF: evaluation order inside println's argument list
Noisy = {
    env: Env,
    tag: str,
}

Noisy.impl(Drop, {
    drop = (self :: @Self) () { self.env.out.println("drop {}", self.tag) }
})

loud = (env: Env, s: str) i64 {
    f = Noisy(env: env, tag: "during");
    env.out.println("arg {}", s);
    5
}

main = (env: Env) Res<i32, IoError> {
    println("pre {} post", loud(env, "x"));
    Ok(0);
}
