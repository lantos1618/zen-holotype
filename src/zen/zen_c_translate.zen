// Optional Clang-backed translation of one C header into a raw Zen module.
// Clang is needed only to regenerate it; every compilation still reattaches
// the cached source to its header metadata through `attach` below.

Alloc, AllocError = std.mem
str, String = std.text
Vec = std.collections
Json, JsonId, Jsons, Run, read = std.json
ProcError = std.proc
Os, Arch, Abi, CImport = std.build
Ast, Module = std.ast
Source, Lexed, scan = std.lex
Parser = std.parse
CImportRequest, CImportModule = zen.zen_c_import

ClangExit* = {
    code*: i32,
    message*: str,
}

CTranslateFault* = NoMemory
    | Process(ProcError)
    | ClangFailed(ClangExit)
    | OneHeaderRequired
    | UnsupportedTarget
    | UnsafeArgument(str)
    | InvalidAst(str)
    | UnsupportedFunction(str)
    | UnsupportedType(str)
    | IdentityMismatch
    | GeneratedLex(usize)
    | GeneratedParse(usize)

CModule* = {
    source*: String,
    declarations*: usize,
}

CTranslation* = {
    module*: CModule,
    identity*: String,
}

// The returned source owns every `str` the synthetic AST sliced from it.
CAttachedTranslation* = {
    source*: String,
    attached*: CImportModule,
    identity*: String,
    declarations*: usize,
}

// Parse already-translated Zen into the program's one AST, then give that
// module the request's C headers. This is intentionally below build.zen and
// the CLI: executing a Builder still needs an evaluator that does not exist.
attach* = (
    a           : Alloc,
    name        : str,
    request     : CImportRequest,
    translation : CTranslation,
    tree        :: Ast,
) Res<CAttachedTranslation, CTranslateFault> {
    translation.identity.view().eq(request.identity.view()).match({
        false => Err(CTranslateFault.IdentityMismatch),
        true  => {
            source       = translation.module.source;
            declarations = translation.module.declarations;
            identity     = translation.identity;
            lexed        = scanned(
                a,
                Source(file: name, text: source.view())
            ).try();
            lexed.is_clean().match({
                false => Err(CTranslateFault.GeneratedLex(lexed.diags.len)),
                true  => {
                    p ::= a.Parser(lexed, tree);
                    raw = parsed_module(p, name).try();
                    // Hand every grown Vec header back on both success and
                    // parser refusal; Ast has exactly one owner.
                    tree = p.tree;
                    (p.diags.len == 0).match({
                        false => Err(CTranslateFault.GeneratedParse(
                            p.diags.len
                        )),
                        true  => attached(a, request, raw, tree).match({
                            Err(e)     => Err(e),
                            Ok(linked) => Ok(CAttachedTranslation(
                                source: source,
                                attached: linked,
                                identity: identity,
                                declarations: declarations
                            )),
                        }),
                    })
                },
            })
        },
    })
}

// Run the optional translator. `cwd` is explicit because header paths belong
// to the project graph, not the compiler process's ambient directory.
translate* = (
    env     : Env,
    a       : Alloc,
    cwd     : str,
    request : CImportRequest
) Res<CTranslation, CTranslateFault> {
    command = clang_command(a, "clang", request.spec).try();
    env.proc.run(a, cwd, command.view()).match({
        Err(e)     => Err(CTranslateFault.Process(e)),
        Ok(result) => (result.code == 0).match({
            false => Err(CTranslateFault.ClangFailed(ClangExit(
                code: result.code,
                message: result.err.view()
            ))),
            true  => translate_ast(a, result.out.view()).match({
                Err(e)     => Err(e),
                Ok(module) => Ok(CTranslation(
                    module: module,
                    identity: request.identity
                )),
            }),
        }),
    })
}

// Kept public so the deterministic test does not require the optional Clang
// executable. It consumes exactly the JSON emitted by `-ast-dump=json`.
translate_ast* = (a: Alloc, text: str) Res<CModule, CTranslateFault> {
    tree ::= a.Jsons();
    root  = json_read(a, tree, text).try();
    inner = field(tree, root, "inner").try();
    run   = array(tree, inner, "translation unit inner").try();
    out   ::= allocated(a.String(
        "// Generated by `zen bind c`; edit the C header, not this file.\n\nPtr = std.mem\n\n"
    )).try();
    count ::= 0;
    Range(0, run.len).loop((h, i) {
        node = item(tree, inner, i).try();
        kind = text_field(tree, node, "kind").try();
        kind.eq("FunctionDecl").then(() {
            // A declaration from an included header has `includedFrom`.
            // Bind the requested header, not its entire transitive libc.
            direct(tree, node).then(() {
                emit_function(tree, node, out).try();
                count = count + 1;
            });
        });
    });
    Ok(CModule(source: out, declarations: count))
}

clang_command = (a: Alloc, clang: str, spec: CImport)
                Res<String, CTranslateFault> {
    (spec.headers.len == 1).match({
        false => Err(CTranslateFault.OneHeaderRequired),
        true  => {
            out ::= allocated(a.String()).try();
            shell_word(out, clang).try();
            out.add_bytes(
                " -Xclang -ast-dump=json -fsyntax-only -x c --target="
            )
                .allocated_ok().try();
            out.add_bytes(
                target_name(
                    spec.target.os,
                    spec.target.arch,
                    spec.target.abi
                ).try()
            ).allocated_ok().try();
            spec.include_paths.loop((h, path) {
                out.add_bytes(" -I").allocated_ok().try();
                shell_word(out, path).try();
            });
            spec.defines.loop((h, define) {
                out.add_bytes(" -D").allocated_ok().try();
                shell_word(out, define).try();
            });
            out.add_bytes(" -- ").allocated_ok().try();
            shell_word(out, spec.headers.get(0).match({
                Ok(header) => header,
                None       => "",
            })).try();
            Ok(out)
        },
    })
}

target_name = (os: Os, arch: Arch, abi: Abi) Res<str, CTranslateFault> {
    os.match({
        Linux   => arch.match({
            X86_64 => abi.match({
                Gnu  => Ok("x86_64-linux-gnu"),
                Musl => Ok("x86_64-linux-musl"),
                _    => Err(CTranslateFault.UnsupportedTarget),
            }),
            Arm64  => abi.match({
                Gnu  => Ok("aarch64-linux-gnu"),
                Musl => Ok("aarch64-linux-musl"),
                _    => Err(CTranslateFault.UnsupportedTarget),
            }),
        }),
        Macos   => abi.match({
            Darwin => arch.match({
                X86_64 => Ok("x86_64-apple-darwin"),
                Arm64  => Ok("arm64-apple-darwin"),
            }),
            _      => Err(CTranslateFault.UnsupportedTarget),
        }),
        Windows => arch.match({
            X86_64 => abi.match({
                Msvc => Ok("x86_64-pc-windows-msvc"),
                Gnu  => Ok("x86_64-w64-windows-gnu"),
                _    => Err(CTranslateFault.UnsupportedTarget),
            }),
            Arm64  => abi.match({
                Msvc => Ok("aarch64-pc-windows-msvc"),
                _    => Err(CTranslateFault.UnsupportedTarget),
            }),
        }),
    })
}

shell_word = (out :: String, word: str) Res<(), CTranslateFault> {
    safe ::= true;
    Range(0, word.len).loop((h, i) {
        (word.index(i) == 0 || word.index(i) == '\n' || word.index(i) == '\r')
            .then(() { safe = false; h.break(); });
    });
    safe.match({
        false => Err(CTranslateFault.UnsafeArgument(word)),
        true  => {
            out.add_byte('\'').allocated_ok().try();
            Range(0, word.len).loop((h, i) {
                b = word.index(i);
                (b == '\'').match({
                    true  => out.add_bytes("'\\''").allocated_ok().try(),
                    false => out.add_byte(b).allocated_ok().try(),
                });
            });
            out.add_byte('\'').allocated_ok()
        },
    })
}

emit_function = (tree: Jsons, node: JsonId, out :: String)
                Res<(), CTranslateFault> {
    name = text_field(tree, node, "name").try();
    identifier(name).match({
        false => Err(CTranslateFault.UnsupportedFunction(name)),
        true  => forbidden_function(tree, node, name).match({
            Ok(_)  => {
                signature = text_field_in(tree, node, "type", "qualType").try();
                open      = signature.find('(').match({
                    Ok(i) => i,
                    None  => 0,
                });
                (open == 0).match({
                    true  => Err(CTranslateFault.UnsupportedType(signature)),
                    false => {
                        ret_c = signature.slice(0, open).trim_end().match({
                            Ok(s) => s,
                            None  => "",
                        });
                        ret   = zen_type(ret_c, true).try();
                        out.fmt("{}* = (", name).allocated_ok().try();
                        emit_params(tree, node, out).try();
                        out.fmt(") {}\n", ret).allocated_ok()
                    },
                })
            },
            Err(e) => Err(e),
        }),
    })
}

forbidden_function = (tree: Jsons, node: JsonId, name: str)
                     Res<(), CTranslateFault> {
    tree.field(node, "variadic").match({
        Ok(id) => tree.at(id).match({
            Json.Bool(true) => Err(CTranslateFault.UnsupportedFunction(name)),
            _               => no_body(tree, node, name),
        }),
        None   => no_body(tree, node, name),
    })
}

no_body = (tree: Jsons, node: JsonId, name: str)
          Res<(), CTranslateFault> {
    tree.field(node, "inner").match({
        None     => Ok(()),
        Ok(kids) => array(tree, kids, "function inner").match({
            Err(e)  => Err(e),
            Ok(run) => {
                body ::= false;
                Range(0, run.len).loop((h, i) {
                    child = item(tree, kids, i).try();
                    text_field(tree, child, "kind").try().eq("CompoundStmt")
                        .then(() { body = true; h.break(); });
                });
                body.match({
                    true  => Err(CTranslateFault.UnsupportedFunction(name)),
                    false => Ok(()),
                })
            },
        }),
    })
}

emit_params = (tree: Jsons, node: JsonId, out :: String)
              Res<(), CTranslateFault> {
    tree.field(node, "inner").match({
        None     => Ok(()),
        Ok(kids) => array(tree, kids, "function inner").match({
            Err(e)  => Err(e),
            Ok(run) => {
                said ::= false;
                arg  ::= 0;
                bad  ::= "";
                Range(0, run.len).loop((h, i) {
                    child = item(tree, kids, i).try();
                    kind  = text_field(tree, child, "kind").try();
                    kind.eq("ParmVarDecl").then(() {
                        said.match({
                            true  => out.add_bytes(", ").allocated_ok().try(),
                            false => {},
                        });
                        name = optional_text(tree, child, "name").match({
                            Ok(s) => s,
                            None  => "",
                        });
                        name.is_empty().match({
                            true  => out.fmt("arg{}", arg).allocated_ok().try(),
                            false => identifier(name).match({
                                true  => out.add_bytes(
                                    name
                                ).allocated_ok().try(),
                                false => { bad = name; h.break(); },
                            }),
                        });
                        bad.is_empty().then(() {
                            c = type_name(tree, child).try();
                            out.fmt(
                                ": {}",
                                zen_type(c, false).try()
                            ).allocated_ok().try();
                            said = true;
                            arg  = arg + 1;
                        });
                    });
                });
                bad.is_empty().match({
                    true  => Ok(()),
                    false => Err(CTranslateFault.UnsupportedFunction(bad)),
                })
            },
        }),
    })
}

type_name = (tree: Jsons, node: JsonId) Res<str, CTranslateFault> {
    owner = field(tree, node, "type").try();
    tree.field(owner, "desugaredQualType").match({
        Ok(id) => text_value(tree, id, "desugaredQualType"),
        None   => text_field(tree, owner, "qualType"),
    })
}

zen_type = (c: str, allow_void: bool) Res<str, CTranslateFault> {
    c.match({
        "void"               => allow_void.match({
            true  => Ok("()"),
            false => Err(CTranslateFault.UnsupportedType(c)),
        }),
        "char"               => Ok("c_char"),
        "signed char"        => Ok("c_schar"),
        "unsigned char"      => Ok("c_uchar"),
        "short"              => Ok("c_short"),
        "unsigned short"     => Ok("c_ushort"),
        "int"                => Ok("c_int"),
        "unsigned int"       => Ok("c_uint"),
        "long"               => Ok("c_long"),
        "unsigned long"      => Ok("c_ulong"),
        "long long"          => Ok("c_longlong"),
        "unsigned long long" => Ok("c_ulonglong"),
        "void *"             => Ok("Ptr<()>"),
        _                    => Err(CTranslateFault.UnsupportedType(c)),
    })
}

identifier = (name: str) bool {
    valid ::= !name.is_empty() && name.index(0).is_ident_start();
    Range(1, name.len).loop((h, i) {
        (!name.index(i).is_ident_cont()).then(() { valid = false; h.break(); });
    });
    valid && !name.is_in([
        "impl", "match", "loop", "true", "false", "struct", "enum"
    ])
}

direct = (tree: Jsons, node: JsonId) bool {
    tree.field(node, "loc").match({
        None      => false,
        Ok(place) => tree.field(place, "includedFrom").match({
            Ok(_) => false,
            None  => true,
        }),
    })
}

array = (tree: Jsons, id: JsonId, where: str) Res<Run, CTranslateFault> {
    tree.at(id).match({
        Json.Arr(run) => Ok(run),
        _             => Err(CTranslateFault.InvalidAst(where)),
    })
}

item = (tree: Jsons, id: JsonId, i: usize) Res<JsonId, CTranslateFault> {
    tree.item(id, i).match({
        Ok(value) => Ok(value),
        None      => Err(CTranslateFault.InvalidAst("array item")),
    })
}

field = (tree: Jsons, id: JsonId, name: str)
        Res<JsonId, CTranslateFault> {
    tree.field(id, name).match({
        Ok(value) => Ok(value),
        None      => Err(CTranslateFault.InvalidAst(name)),
    })
}

optional_text = (tree: Jsons, id: JsonId, name: str) Res<str> {
    tree.field(id, name).match({
        Ok(value) => tree.text(value),
        None      => None,
    })
}

text_field = (tree: Jsons, id: JsonId, name: str)
             Res<str, CTranslateFault> {
    field(tree, id, name).match({
        Err(e)    => Err(e),
        Ok(value) => text_value(tree, value, name),
    })
}

text_field_in = (tree: Jsons, id: JsonId, owner: str, name: str)
                Res<str, CTranslateFault> {
    field(tree, id, owner).match({
        Err(e)       => Err(e),
        Ok(owner_id) => text_field(tree, owner_id, name),
    })
}

text_value = (tree: Jsons, id: JsonId, name: str)
             Res<str, CTranslateFault> {
    tree.text(id).match({
        Ok(value) => Ok(value),
        None      => Err(CTranslateFault.InvalidAst(name)),
    })
}

json_read = (a: Alloc, tree :: Jsons, text: str)
            Res<JsonId, CTranslateFault> {
    read(a, tree, text).match({
        Ok(value) => Ok(value),
        Err(e)    => Err(CTranslateFault.InvalidAst("clang JSON")),
    })
}

allocated = <T>(r: Res<T, AllocError>) Res<T, CTranslateFault> {
    r.match({
        Ok(value) => Ok(value),
        Err(e)    => Err(CTranslateFault.NoMemory),
    })
}

allocated_ok = (r: Res<(), AllocError>) Res<(), CTranslateFault> {
    r.match({
        Ok(_)  => Ok(()),
        Err(e) => Err(CTranslateFault.NoMemory),
    })
}

scanned = (a: Alloc, source: Source) Res<Lexed, CTranslateFault> {
    scan(a, source).match({
        Ok(lexed) => Ok(lexed),
        Err(e)    => Err(CTranslateFault.NoMemory),
    })
}

parsed_module = (p :: Parser, name: str) Res<Module, CTranslateFault> {
    p.module(name).match({
        Ok(module) => Ok(module),
        Err(e)     => Err(CTranslateFault.NoMemory),
    })
}

attached = (
    a       : Alloc,
    request : CImportRequest,
    module  : Module,
    tree    :: Ast,
) Res<CImportModule, CTranslateFault> {
    request.attach_module(a, module, tree).match({
        Ok(linked) => Ok(linked),
        Err(e)     => Err(CTranslateFault.NoMemory),
    })
}
