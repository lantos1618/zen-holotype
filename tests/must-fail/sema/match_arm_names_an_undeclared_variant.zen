// `Purple` in a pattern over `Red | Green | Blue` is not a variant, not a
// constant, and not in scope anywhere — and the old compiler still bound
// it as a fresh binder covering every value. The match answered "purple"
// for every colour, read as exhaustive because a binder covers
// everything, compiled clean, and cc said nothing: a silent wrong answer
// that no oracle asking only "did it build" can see.
//
// The shape decides what an upper-case arm name must be: binders are
// lower-case everywhere else in the language, so an upper-case name that
// owns nothing here is a variant mistyped or never declared.
//
// position: the pattern that binds.

Colour = Red | Green | Blue

name = (c: Colour) str {
    c.match({
        Purple => "purple",
        _      => "something else",
    })
}

main = (env: Env) Res<i32, AllocError> {
    println("{}", name(Colour.Red));
    Ok(0);
}
