// compiler.parse_impl — impl/trait block parsing plus inherent-method / trait-default decl
// synthesis: turns `Type.impl(Trait, {…})` blocks and a data struct's `=`-methods into mangled
// DFuncs plus a DImpl conformance record. Split out of the compiler.parse god file. Style: UFCS.
{ Decl, Param, Func } = compiler.ast.ast_types
{ param, dfunc, dimpl, dimpl_at, dstruct, dgenstruct, dtraitdef, sdef_at, gsdef_at } = compiler.genc
{ impl_cname_in } = compiler.mangle
{ scan } = compiler.lex
{ Allocator } = std.mem.alloc
{ lexeme } = compiler.parse_atom
{ parse_ty, perr_set_at, impl_recv_param, irecv_enter, irecv_exit, is_comma, is_rbrace,
  skip_to_brace, param_buf, take_params } = compiler.parse_type
{ parse_decl_at, DCont } = compiler.parse
{ StructEnd, data_fields } = compiler.parse_type_decl
{ param_names_has } = compiler.astops
{ loop_at } = std.core.count
// Impl methods become mangled functions plus one DImpl conformance record.
ImplEnd*: {
    decls: i32,
    methods: i32,
    next: i32,
}
// String provenance changes value-flow rules, not read-only trait behavior: every string-family
// impl lives under the canonical `StringView` receiver, so `StringCstr.impl(...)` and
// `StringLiteral.impl(...)` land in the same table a `StringView` receiver dispatches through.
canonical_impl_receiver = (name: StringView) StringView {
    (name == "StringView" || name == "StringCstr" || name == "StringLiteral").match ({
        true  => "StringView",
        false => name,
    })
}
fill_impl* = (a: Allocator, src: StringView, pos: i32, buf: [Decl], i: i32) DCont {
    tnt = src.scan(pos)
    tyname = a.lexeme(src, tnt.tok).canonical_impl_receiver()
    dot = src.scan(tnt.next)
    kw = src.scan(dot.next)
    lp = src.scan(kw.next)
    trt = src.scan(lp.next)
    trname = a.lexeme(src, trt.tok)
    // the FULL trait reference (qualifier + type args, `actor.Receiver<Msg>`) as a Ty, kept on the DImpl
    // so the formatter round-trips it. trname (the FIRST token only) stays the mangle key — the hoisted
    // method DFuncs below are named from it, so checker/codegen lookups stay consistent.
    tre = a.parse_ty(src, lp.next)
    bstart = src.skip_to_brace(pos)
    mbuf = a.param_buf()
    ie = a.fill_impl_methods(src, bstart, buf, i, mbuf, 0, tyname, trname)
    buf[ie.decls] = dimpl_at(tyname, trname, tre.ty, mbuf.take_params(ie.methods), tnt.tok.start)
    rp = src.scan(ie.next)
    DCont(
        next: rp.next,
        i: ie.decls + 1,
    )
}
fill_impl_methods* = (
    a: Allocator,
    src: StringView,
    pos: i32,
    buf: [Decl],
    i: i32,
    mbuf: [Param],
    m: i32,
    tyname: StringView,
    trname: StringView,
) ImplEnd {
    sc = src.scan(pos)
    sc.tok.kind.match ({
        .Eof => {
            perr_set_at(pos)
            ImplEnd(
                decls: i,
                methods: m,
                next: sc.next,
            )
        },
        _    => src.is_comma(sc.tok).match ({
            true  => a.fill_impl_methods(src, sc.next, buf, i, mbuf, m, tyname, trname),
            false => src.is_rbrace(sc.tok).match ({
                true  => ImplEnd(
                    decls: i,
                    methods: m,
                    next: sc.next,
                ),
                false => a.fill_impl_one(src, pos, buf, i, mbuf, m, tyname, trname),
            }),
        }),
    })
}
fill_impl_one = (
    a: Allocator,
    src: StringView,
    pos: i32,
    buf: [Decl],
    i: i32,
    mbuf: [Param],
    m: i32,
    tyname: StringView,
    trname: StringView,
) ImplEnd {
    // Impl methods fill both decl and method-name buffers.
    (i >= buf.len - 1 || m >= mbuf.len).then({
        perr_set_at(pos)
        return ImplEnd(
            decls: i,
            methods: m,
            next: pos,
        )
    })
    prev = irecv_enter()    // inside an impl block the receiver slot may be written bare
    de = a.parse_decl_at(src, pos)
    irecv_exit(prev)
    cn = a.impl_cname_in(trname, tyname, de.func.name)
    buf[i] = dfunc(Func(
        name: cn,
        params: a.impl_recv_param(tyname, de.func.params),
        ret: de.func.ret,
        tparams: de.func.tparams,
        body: de.func.body,
    ))
    mbuf[m] = param(de.func.name, tvoid())
    a.fill_impl_methods(src, de.next, buf, i + 1, mbuf, m + 1, tyname, trname)
}
fill_defaults* = (
    a: Allocator,
    trname: StringView,
    defaults: [Func],
    buf: [Decl],
    i: i32,
    j: i32,
) i32 {
    (j == defaults.len).match ({
        true  => i,
        false => {
            buf[i] = dtraitdef(trname, defaults[j])
            a.fill_defaults(trname, defaults, buf, i + 1, j + 1)
        },
    })
}
join_tparams = (a: Allocator, outer: [Param], inner: [Param]) [Param] {
    buf ::= a.param_buf()
    n ::= 0
    outer.loop_at((i, p) {
        buf[n] = p
        n = n + 1
    })
    inner.loop_at((i, p) {
        (outer.param_names_has(p.name) == false).then({
            buf[n] = p
            n = n + 1
        })
    })
    buf.take_params(n)
}
fill_inherent_methods = (
    a: Allocator,
    tyname: StringView,
    tparams: [Param],
    methods: [Func],
    buf: [Decl],
    i: i32,
    mbuf: [Param],
    j: i32,
) i32 {
    (j == methods.len).match ({
        true  => i,
        false => {
            f = methods[j]
            // pos: keep the method's name offset so the formatter anchors leading comments ABOVE the
            // method (not hoisted into its body).
            buf[i] = dfunc(Func(
                name: a.impl_cname_in(tyname, tyname, f.name),
                params: f.params,
                ret: f.ret,
                tparams: a.join_tparams(tparams, f.tparams),
                body: f.body,
                pos: f.pos,
            ))
            mbuf[j] = param(f.name, tvoid())
            a.fill_inherent_methods(tyname, tparams, methods, buf, i + 1, mbuf, j + 1)
        },
    })
}
fill_inherent_struct* = (a: Allocator, se: StructEnd, buf: [Decl], i: i32) i32 {
    mbuf = a.param_buf()
    buf[i] = (se.ntp > 0).match ({
        true  => dgenstruct(gsdef_at(se.sd.name, se.tparams, a.data_fields(se.sd.fields, se.defaults), se.sd.pos)),
        false => dstruct(sdef_at(se.sd.name, a.data_fields(se.sd.fields, se.defaults), se.sd.pos)),
    })
    next = a.fill_inherent_methods(se.sd.name, se.tparams, se.defaults, buf, i + 1, mbuf, 0)
    buf[next] = dimpl(se.sd.name, se.sd.name, mbuf.take_params(se.defaults.len))
    next + 1
}
