    // Vec<i32> via allocator: empty/push/view/loop-sum/free — pins the return-only-T `empty` + `.view().loop` pattern
    // ── (f) more `zenc check` rejects (string/slice/own/rc/arc allocator-first — the former try_* twins
    // now double as deleted-name rejects; typed-local mismatch) ─
    vd2 := run_verdicts("build check 2", [
        VerdictCase(
            src: "string = std.text.string\nmain = () i32 { s := string.init(16)  0 }\n",
            should_pass: false,
            kind: "arg-type",
        ),
        VerdictCase(
            src: "string = std.text.string\nmain = () i32 { r := string.try_init(16)  0 }\n",
            should_pass: false,
            kind: "undefined-name",
        ),
        VerdictCase(
            src: "halloc = std.mem.heap\n{ new_in } = std.text.string\nmain = () i32 { a := halloc.gpa()  s := a.addr().new_in()  s.append(\"x\")  0 }\n",
            should_pass: false,
            kind: "undefined-name",
        ),
        VerdictCase(
            src: "halloc = std.mem.heap\n{ new_in } = std.text.string\nmain = () i32 { a := halloc.gpa()  s := a.addr().new_in()  s.push('x')  0 }\n",
            should_pass: false,
            kind: "undefined-name",
        ),
        VerdictCase(
            src: "halloc = std.mem.heap\n{ new_in } = std.text.string\nmain = () i32 { a := halloc.gpa()  s := a.addr().new_in()  done := s.finish()  0 }\n",
            should_pass: false,
            kind: "undefined-name",
        ),
        VerdictCase(
            src: "halloc = std.mem.heap\n{ new_in } = std.text.string\nmain = () i32 { a := halloc.gpa()  s := a.addr().new_in()  s.free()  0 }\n",
            should_pass: false,
            kind: "undefined-name",
        ),
        VerdictCase(
            src: "slice = std.core.slice\nmain = () i32 { xs := slice.alloc_buf(2, [0])  0 }\n",
            should_pass: false,
            kind: "arg-type",
        ),
        VerdictCase(
            src: "slice = std.core.slice\nmain = () i32 { r := slice.try_buf(2, [0])  0 }\n",
            should_pass: false,
            kind: "undefined-name",
        ),
        VerdictCase(
            src: "slice = std.core.slice\nmain = () i32 { xs := slice.dup([1, 2])  0 }\n",
            should_pass: false,
            kind: "arg-type",
        ),
        VerdictCase(
            src: "slice = std.core.slice\nmain = () i32 { r := slice.try_dup([1, 2])  0 }\n",
            should_pass: false,
            kind: "undefined-name",
        ),
        VerdictCase(
            src: "slice = std.core.slice\nmain = () i32 { p := slice.node(1)  0 }\n",
            should_pass: false,
            kind: "arg-type",
        ),
        VerdictCase(
            src: "slice = std.core.slice\nmain = () i32 { r := slice.try_node(1)  0 }\n",
            should_pass: false,
            kind: "undefined-name",
        ),
        VerdictCase(
            src: "slice = std.core.slice\nmain = () i32 { xs := slice.concat([1], [2])  0 }\n",
            should_pass: false,
            kind: "arg-type",
        ),
        VerdictCase(
            src: "slice = std.core.slice\nmain = () i32 { r := slice.try_concat([1], [2])  0 }\n",
            should_pass: false,
            kind: "undefined-name",
        ),
        VerdictCase(
            src: "halloc = std.mem.heap\n{ Resource, new_in } = std.mem.own\nmain = () i32 { a := halloc.gpa()  o := a.addr().new_in(Resource(id: 1, slot: 0))  o.release()  0 }\n",
            should_pass: false,
            kind: "trait-bound",
        ),
        VerdictCase(
            src: "halloc = std.mem.heap\n{ new_in } = std.mem.rc\nmain = () i32 { a := halloc.gpa()  r := a.addr().new_in(1)  r.drop()  0 }\n",
            should_pass: false,
            kind: "undefined-name",
        ),
        VerdictCase(
            src: "halloc = std.mem.heap\n{ new_in } = std.mem.arc\nmain = () i32 { a := halloc.gpa()  r := a.addr().new_in(1)  r.drop()  0 }\n",
            should_pass: false,
            kind: "undefined-name",
        ),
        VerdictCase(
            src: "main = () i32 { x: i32 := \"nope\"  0 }\n",
            should_pass: false,
            kind: "assign-fit",
        ),
        VerdictCase(
            src: "sizeof = (x: i64) i64 { x + 1 }\nmain = () i32 { 0 }\n",
            should_pass: false,
            kind: "reserved-name",
        ),
        VerdictCase(
            src: "atomic_add_i64 = (x: i64) i64 { x + 1 }\nmain = () i32 { 0 }\n",
            should_pass: false,
            kind: "reserved-name",
        ),
        VerdictCase(
            src: "to_i32 = (x: i64) i64 { x + 1 }\nmain = () i32 { 0 }\n",
            should_pass: false,
            kind: "reserved-name",
        ),
        VerdictCase(
            src: "malloc = (n: i64) i64 { n }\nmain = () i32 { 0 }\n",
            should_pass: false,
            kind: "reserved-name",
        ),
        VerdictCase(
            src: "loader = (x: i64) i64 { x + 1 }\nload2 = (x: i64) i64 { x + 2 }\nmy_load = (x: i64) i64 { x + 3 }\nmain = () i32 { to_i32(loader(1) + load2(1) + my_load(1) - 9) }\n",
            should_pass: true,
            kind: "",
        ),
        VerdictCase(
            src: "main = () i32 {\n    load := (x: i64) i64 { x + 1 }\n    to_i32(load(41) - 42)\n}\n",
            should_pass: true,
            kind: "",
        ),
        VerdictCase(
            src: "Cell: {\n    v: i64,\n    load = (c: Cell) i64 { c.v + 1 }\n}\nmain = () i32 { c := Cell(v: 41)  to_i32(c.load() - 42) }\n",
            should_pass: true,
            kind: "",
        ),
    ])
    // `free` is NOT imported here, so since #574 the honest per-module diagnosis is
    // undefined-name (with the import hint) — not an arg-type judged against the flat libc
    // `free` this call only reached through flat-namespace luck.
    // deleted allocator/string ctor names (`new`/`try_new`) destructure-imported from a module that no
    // longer defines them → kindless `unknown name in module` reject; pin the exact message (no error[kind]).
    vd2b := run_diags("build check 2 deleted-names", [
        DiagCase(
            src: "{ new } = std.text.string\nmain = () i32 { s := new()  0 }\n",
            wants: ["error: unknown name 'new' in module 'std.text.string' (no such top-level definition)"],
        ),
        DiagCase(
            src: "{ Resource, new } = std.mem.own\nmain = () i32 { o := new(Resource(id: 1, slot: 0))  0 }\n",
            wants: ["error: unknown name 'new' in module 'std.mem.own' (no such top-level definition)"],
        ),
        DiagCase(
            src: "{ Resource, try_new } = std.mem.own\nmain = () i32 { r := try_new(Resource(id: 1, slot: 0))  0 }\n",
            wants: ["error: unknown name 'try_new' in module 'std.mem.own' (no such top-level definition)"],
        ),
        DiagCase(
            src: "{ new } = std.mem.rc\nmain = () i32 { r := new(1)  0 }\n",
            wants: ["error: unknown name 'new' in module 'std.mem.rc' (no such top-level definition)"],
        ),
        DiagCase(
            src: "{ try_new } = std.mem.rc\nmain = () i32 { r := try_new(1)  0 }\n",
            wants: ["error: unknown name 'try_new' in module 'std.mem.rc' (no such top-level definition)"],
        ),
        DiagCase(
            src: "{ new } = std.mem.arc\nmain = () i32 { r := new(1)  0 }\n",
            wants: ["error: unknown name 'new' in module 'std.mem.arc' (no such top-level definition)"],
        ),
        DiagCase(
            src: "{ try_new } = std.mem.arc\nmain = () i32 { r := try_new(1)  0 }\n",
            wants: ["error: unknown name 'try_new' in module 'std.mem.arc' (no such top-level definition)"],
        ),
    ])
    // a top-level fn named after an intrinsic is a MISCOMPILE if accepted: calls dispatch on the
    // name in genc, so they'd hit the intrinsic (deref/segfault/cc error), never the user fn.
    // NEAR-MISS names are ordinary fns — the reject is exact-name only.
    // a LOCAL fn value may shadow an intrinsic name (#370/#377 route its calls soundly).
    // a STRUCT METHOD named like an intrinsic is hoisted under a mangled `impl_…` name — allowed.
    // ── (g) POSITIONED diagnostics: kind + file:line:col + caret + message + hint ─────────────────
    dg := run_diags("build diagnostics", [
        DiagCase(
            src: "if (true) { 1 }\n",
            wants: [":1:1: error[no-if]", "  if (true) { 1 }", "  ^~", "hint: in expression position write `cond.then({ yes }, { no })`"],
        ),
        DiagCase(
            src: "// a foreign decl with a slice param has no C ABI shape — the diagnostic names the offending\n// parameter and its type, positioned on the declaration, with the RawPtr-floor hint.\nfrob = (xs: [i32]) i64\nmain = () i32 { 0 }\n",
            wants: [":3:1: error[ffi-type]: foreign declaration `frob`: parameter `xs` has non-FFI-safe type `[i32]`", "  frob = (xs: [i32]) i64", "  ^~~~", "hint: a bodyless (foreign) declaration is a raw C prototype", "pass buffers through the RawPtr<T> floor (pointer + length)"],
        ),
        DiagCase(
            src: "main = () i32 {\n    if (1 < 2) { 1 } else { 0 }\n}\n",
            wants: [":2:5: error[no-if]: `if` is not part of Zen; conditional control flow uses `.match`", "      if (1 < 2) { 1 } else { 0 }", "      ^~", "hint: in expression position write `cond.then({ yes }, { no })`; for statement-position control flow replace `if (cond) { yes } else { no }` with `cond.match ({ true => yes, false => no })`; inside an enum arm, nest a boolean `.match` in the arm body"],
        ),
        DiagCase(
            src: "Box: Val(i32) | Empty\nmain = () i32 {\n    b: Box := .Val(1)\n    b.match ({\n        .Val(v) if v > 0 => 1,\n        .Val(v) => 2,\n        .Empty => 0,\n    })\n}\n",
            wants: [":5:17: error[no-if]", "          .Val(v) if v > 0 => 1,", "hint: in expression position write `cond.then({ yes }, { no })`"],
        ),
        DiagCase(
            src: "main = () i32 {\n    x := 1 > 0 ? 2 : 3\n    x\n}\n",
            wants: [":2:16: error[no-ternary]: ternary `?:` (and any `?`) is not part of Zen; conditional control flow is a visible postfix method, never punctuation", "      x := 1 > 0 ? 2 : 3", "      ^", "hint: use `cond.then({ yes }, { no })` for a conditional expression, or `.match` for statement-position control flow"],
        ),
        DiagCase(
            src: "R*: Ok(str) | Err(i32)\nmain = () i32 {\n    done := false\n    r: R = .Err(3)\n    s := r.match ({\n        .Ok(ns) => ns,\n        .Err(e) => { done = true },\n    })\n    0\n}\n",
            wants: [":7:22: error[arm-value]: match arm yields no value, but the match result is used as a value", "  .Err(e) => { done = true },", "^~~~", "hint: end every arm with an expression of the match's result type (or a diverging `return`); or stop consuming the match as a value and assign within each arm"],
        ),
        DiagCase(
            src: "// entry\nmain = (rt: i32) i32 {\n    return 0\n}\n",
            wants: [":2:1: error[main-signature]: `main` must be `() i32` or `(sys: Sys) i32`", "  main = (rt: i32) i32 {", "  ^~~~", "hint: declare it `main = () i32 { … }`, or take the root capability `main = (sys: Sys) i32 { … }` (import `{ Sys } = std.sys.root`) and thread narrow caps like `sys.stdout()` / `sys.heap()`"],
        ),
        DiagCase(
            src: "{ help } = util.helpers\nmain = () i32 { help() }\n",
            wants: ["error: unknown module 'util.helpers'", "no util/helpers.zen next to"],
        ),
        DiagCase(
            src: "add = (a: i32, b: i32) i32 { a + b }\nmain = () i32 { add(1) }\n",
            wants: [":2:17: error[arity]: wrong number of arguments: expected 2, found 1", "  main = () i32 { add(1) }", "                  ^~~", "hint: check the callee signature and pass exactly the declared parameters"],
        ),
        DiagCase(
            src: "takes_u8 = (b: u8) i32 { 0 }\nbig = () i64 { 9999999999 }\nmain = () i32 { takes_u8(big()) }\n",
            wants: [":3:26: error[arg-type]: expected `u8`, got `i64`", "  main = () i32 { takes_u8(big()) }", "                           ^~~", "hint: check the argument type or add an explicit conversion at the call site"],
        ),
        DiagCase(
            src: "f = (x: i32) i32 { x }\nmain = () i32 { f(\"s\") }\n",
            wants: [":2:19: error[arg-type]: expected `i32`, got `string_literal`", "  main = () i32 { f(\"s\") }", "                    ^~~", "hint: check the argument type or add an explicit conversion at the call site"],
        ),
        DiagCase(
            src: "take = (p: MutPtr<i32>) i32 { 0 }\nmain = () i32 {\n    x: i32 := 1\n    ro: Ptr<i32> := x.addr()\n    take(ro)\n}\n",
            wants: [":5:10: error[arg-type]: expected `MutPtr<i32>`, got `Ptr<i32>`", "      take(ro)", "           ^~", "hint: check the argument type or add an explicit conversion at the call site"],
        ),
        DiagCase(
            src: "Box*<T>: { v: T }\ntake = (b: Box<MutPtr<i32>>) i32 { 0 }\nmain = () i32 {\n    x: i32 := 1\n    ro: Ptr<i32> := x.addr()\n    b := Box<Ptr<i32>>(v: ro)\n    take(b)\n}\n",
            wants: [":7:10: error[arg-type]: expected `Box<MutPtr<i32>>`, got `Box<Ptr<i32>>`", "      take(b)", "           ^", "hint: check the argument type or add an explicit conversion at the call site"],
        ),
        DiagCase(
            src: "Show*: { render: (Ptr<Self>) i32 }\nPoint*: { x: i32 }\nPoint.impl(Show, { })\n",
            wants: [":3:1: error[conformance]: impl does not satisfy the trait", "  Point.impl(Show, { })", "  ^~~~~", "hint: define every required trait method with the exact receiver, parameter, and return types"],
        ),
        DiagCase(
            src: "Show*: { render: (Ptr<Self>) i32 }\nCircle*: { r: i32 }\nCircle.impl(Show, { render = (c: Ptr<Circle>) i32 { c.r } })\nBlob*: { v: i32 }\ndraw<A: Show> = (a: A) i32 { 0 }\nmain = () i32 { b := Blob(v: 3)  draw(b) }\n",
            wants: [":6:34: error[trait-bound]: type `Blob` does not satisfy the bound `Show` required by `draw` — missing method(s): render", "  main = () i32 { b := Blob(v: 3)  draw(b) }", "                                   ^~~~", "hint: implement the bound trait for this type (`Type.impl(Trait, { … })`), or relax the bound"],
        ),
        DiagCase(
            src: "Show*: { render: (Ptr<Self>) i32 }\nBlob*: { v: i32 }\nmain = () i32 { b := Blob(v: 3)  b.render() }\n",
            wants: [":3:36: error[trait-bound]: type `Blob` does not implement trait `Show` (which declares `render`) — missing method(s): render", "  main = () i32 { b := Blob(v: 3)  b.render() }", "                                     ^~~~~~", "hint: implement the bound trait for this type (`Type.impl(Trait, { … })`), or relax the bound"],
        ),
        DiagCase(
            src: "Show*: { render: (Ptr<Self>) i32 }\nCircle*: { r: i32 }\nCircle.impl(Show, { render = (c: Ptr<Circle>) i32 { c.r } })\nBlob*: { v: i32 }\nmain = () i32 { b := Blob(v: 3)  b.render() }\n",
            wants: [":5:36: error[trait-bound]: type `Blob` does not implement trait `Show` (which declares `render`) — missing method(s): render", "  main = () i32 { b := Blob(v: 3)  b.render() }", "                                     ^~~~~~", "hint: implement the bound trait for this type (`Type.impl(Trait, { … })`), or relax the bound"],
        ),
        DiagCase(
            src: "Blob*: { v: i32 }\ndraw<A: Renderable> = (a: A) i32 { 0 }\nmain = () i32 { b := Blob(v: 3)  draw(b) }\n",
            wants: [":3:34: error[trait-bound]: the bound `Renderable` required by `draw` names no declared trait", "  main = () i32 { b := Blob(v: 3)  draw(b) }", "                                   ^~~~"],
        ),
        DiagCase(
            src: "main = () i32 {\n    x := 5\n    y := (1 < 2)\n    x = y\n    x\n}\n",
            wants: [":4:5: error[assign-fit]: expected `i32`, got `bool`", "      x = y", "      ^", "hint: make the assigned value fit the target's type"],
        ),
        DiagCase(
            src: "main = () i32 {\n    s := [1, 2, 3]\n    b := (1 < 2)\n    s[0] = b\n    s[0]\n}\n",
            wants: [":4:5: error[assign-fit]: expected `i32`, got `bool`", "      s[0] = b", "      ^", "hint: make the assigned value fit the target's type"],
        ),
        DiagCase(
            src: "main = () i32 { 1 < 2 }\n",
            wants: [":1:19: error[return-fit]: expected `i32`, got `bool`", "  main = () i32 { 1 < 2 }", "                    ^", "hint: make the returned value fit the function's declared return type"],
        ),
        DiagCase(
            src: "main = () i32 {\n    x: i32 := \"hi\"\n    0\n}\n",
            wants: [":2:15: error[assign-fit]: expected `i32`, got `string_literal`", "      x: i32 := \"hi\"", "                ^~~~", "hint: make the assigned value fit the target's type"],
        ),
        DiagCase(
            src: "f = () i32 { \"hi\" }\nmain = () i32 { 0 }\n",
            wants: [":1:14: error[return-fit]: expected `i32`, got `string_literal`", "  f = () i32 { \"hi\" }", "               ^~~~", "hint: make the returned value fit the function's declared return type"],
        ),
        DiagCase(
            src: "P: { x: i32, y: i32 }\nf = (p: P) i32 {\n    p.nofield\n}\nmain = () i32 { 0 }\n",
            wants: [":3:7: error[struct-field]: struct `P` has no field `nofield` (fields: x, y)", "      p.nofield", "        ^~~~~~~", "hint: check the struct literal or field access against the declared fields"],
        ),
        DiagCase(
            src: "C: Red | Green | Blue\nf = (c: C) i32 {\n    c.match ({ .Red => 1, .Green => 2 })\n}\nmain = () i32 { 0 }\n",
            wants: [":3:5: error[exhaustiveness]: match does not cover variant `.Blue`", "      c.match ({ .Red => 1, .Green => 2 })", "      ^", "hint: add arms for every variant, or add an explicit `_` arm"],
        ),
        DiagCase(
            src: "C: Red | Green | Blue\nf = (c: C) i32 {\n    c.match ({ .Red => 1, .Red => 2, _ => 3 })\n}\nmain = () i32 { 0 }\n",
            wants: [":3:5: error[dup-variant]: duplicate match arm variant", "      c.match ({ .Red => 1, .Red => 2, _ => 3 })", "      ^", "hint: remove the repeated match arm for this variant"],
        ),
        DiagCase(
            src: "f = (n: i32) i32 {\n    x := (n > 3).match ({ true => 1 })\n    x\n}\nmain = () i32 { 0 }\n",
            wants: [":2:13: error[exhaustiveness]: boolean match does not handle both outcomes", "      x := (n > 3).match ({ true => 1 })", "              ^", "hint: add the missing `true`, `false`, or `_` arm; for an intentional one-way effect, use `condition.then({ ... })`"],
        ),
        DiagCase(
            src: "f = (n: i32) i32 {\n    n.match ({ 0 => 1, 1 => 2 })\n}\nmain = () i32 { 0 }\n",
            wants: [":2:5: error[exhaustiveness]: match does not cover every case; add a `_` arm", "      n.match ({ 0 => 1, 1 => 2 })", "      ^", "hint: a scalar `.match` over literal labels must end with a `_` arm"],
        ),
        DiagCase(
            src: "f = (b: bool) i32 {\n    b.match ({ true => 1, 0 => 2 })\n}\nmain = () i32 { 0 }\n",
            wants: [":2:27: error[match-label]: match arm label is not a `bool`; a boolean `.match` takes `true`, `false`, or `_`", "      b.match ({ true => 1, 0 => 2 })", "                            ^", "hint: replace the label with `true`, `false`, or a `_` wildcard"],
        ),
        DiagCase(
            src: "f* = () (i32, i32) { (1, 2) }\nmain = () i32 { 0 }\n",
            wants: ["error[parse]: expected a top-level declaration, found a token that cannot start one"],
        ),
        DiagCase(
            src: "main = () i32 {\n    x := = 5\n    0\n}\n",
            wants: [":2:10: error[parse]: expected an expression, found a token that cannot start one", "      x := = 5", "           ^", "hint: an expression starts with a literal, a name, a `.Variant`, a `(group)`, a `[a, b]` slice literal, or a `-`/`!` prefix"],
        ),
        DiagCase(
            src: "main = () i32 {\n    r := 1\n    r.match ({ 1 = 0, _ => 1 })\n}\n",
            wants: [":3:18: error[parse]: expected `=>` after this match-arm label", "      r.match ({ 1 = 0, _ => 1 })", "                   ^", "hint: a match arm is `label => value`; separate the label from its body with `=>`"],
        ),
        DiagCase(
            src: "main = () i32 {\n    0\n",
            wants: [":1:15: error[parse]: unclosed `{`: expected a matching `}`, found end of input", "  main = () i32 {", "                ^", "hint: close the block that opens on this line with a `}`"],
        ),
        DiagCase(
            src: "main = () i32 {\n    n := 1\n    (n > 0).then({\n        n\n",
            wants: [":3:18: error[parse]: unclosed `{`: expected a matching `}`, found end of input", "      (n > 0).then({", "                   ^", "hint: close the block that opens on this line with a `}`"],
        ),
        DiagCase(
            src: "main = () i32 {\n    y :=\n}\n",
            wants: [":2:7: error[parse]: expected an expression after `:=`, found the end of the binding", "      y :=", "        ^", "hint: give the binding a value (`name := <expr>`), or delete the binding"],
        ),
        DiagCase(
            src: "main = () i32 {\n    x := (1 +\n",
            wants: [":2:14: error[parse]: unexpected end of input while parsing an expression", "      x := (1 +", "               ^", "hint: the file ends mid-expression — finish it, or close the delimiter it left open"],
        ),
        DiagCase(
            src: "f = (x: Flarb) i64 { 0 }\nmain = () i32 { 0 }\n",
            wants: [":1:1: error[unknown-type]: unknown type name `Flarb`", "  f = (x: Flarb) i64 { 0 }", "  ^", "hint: declare the type, import it, or qualify it with its module (e.g. `mod.Type`)"],
        ),
        DiagCase(
            src: "main = () i32 { undefined_fn(1, 2) }\n",
            wants: [":1:17: error[undefined-name]: undefined name", "  main = () i32 { undefined_fn(1, 2) }", "                  ^~~~~~~~~~~~", "hint: declare the name, import it, or qualify the intended module binding"],
        ),
        DiagCase(
            src: "{ println } = std.text.fmt\nmain = () i32 {\n    println(\"hi\")\n    oops()\n}\n",
            wants: [":4:5: error[undefined-name]: undefined name", "      oops()", "      ^~~~", "hint: declare the name, import it, or qualify the intended module binding"],
        ),
        DiagCase(
            src: "wrap = (x: T) i32 { oops(x) }\nmain = () i32 { wrap(41) }\n",
            wants: [":1:21: error[undefined-name]: undefined name", "  wrap = (x: T) i32 { oops(x) }", "                      ^~~~"],
        ),
        DiagCase(
            src: "apply = (f: (i32) i32, x: i32) i32 { f(x) }\nmain = () i32 {\n    apply((n) { bad(n) }, 41)\n}\n",
            wants: [":3:17: error[undefined-name]: undefined name", "      apply((n) { bad(n) }, 41)", "                  ^~~"],
        ),
        DiagCase(
            src: "apply = (f: (i32) i32, x: i32) i32 { f(x) }\nmain = () i32 {\n    r := apply((n) { n + 1 }, 41)\n    nope(r)\n}\n",
            wants: [":4:5: error[undefined-name]: undefined name", "      nope(r)", "      ^~~~", "hint: declare the name, import it, or qualify the intended module binding"],
        ),
        DiagCase(
            src: "good = () i32 { 1 }\n@@@ !!!\nmain = () i32 { good() + 6 }\n",
            wants: ["expected a top-level declaration, found a token that cannot start one"],
        ),
        DiagCase(
            src: "halloc = std.mem.heap\n{ Resource, new_in } = std.mem.own\n{ expect } = std.core.result\nmain = () i32 {\n    alloc := halloc.gpa()\n    o := alloc.addr().new_in(Resource(id: 7, slot: 0)).expect(\"own\")\n    o.release_in(alloc.addr())\n    o.get().id\n}\n",
            wants: [":8:5: error[ownership]: use of an owner after it was consumed (moved, released, or dropped)", "      o.get().id", "      ^", "hint: an owner is consumed by release/drop, an actor send, a move into an owner-typed parameter, or a bare `c := o` copy; bind a fresh owner (`o.clone()`) instead of reusing the consumed local"],
        ),
        DiagCase(
            src: "halloc = std.mem.heap\n{ new_in } = std.mem.rc\n{ expect } = std.core.result\nmain = () i32 {\n    alloc := halloc.gpa()\n    r := alloc.addr().new_in(41).expect(\"rc\")\n    r.drop_in(alloc.addr())\n    r.get()\n}\n",
            wants: [":8:5: error[ownership]: use of an owner after it was consumed (moved, released, or dropped)", "      r.get()", "      ^"],
        ),
        DiagCase(
            src: "halloc = std.mem.heap\n{ new_in } = std.mem.arc\n{ expect } = std.core.result\nmain = () i32 {\n    alloc := halloc.gpa()\n    a := alloc.addr().new_in(41).expect(\"arc\")\n    a.drop_in(alloc.addr())\n    a.get()\n}\n",
            wants: [":8:5: error[ownership]: use of an owner after it was consumed (moved, released, or dropped)", "      a.get()", "      ^"],
        ),
        DiagCase(
            src: "{ Malloc } = std.mem.alloc\nhalloc = std.mem.heap\nHolder: { ptr: RawPtr<u8> }\nmain = () i32 {\n    a := halloc.gpa()\n    p := a.addr().acquire(64)\n    h := Holder(ptr: null_ptr())\n    h.ptr = p\n    a.addr().release(p)\n    v := load(h.ptr)\n    v.to_i32()\n}\n",
            wants: [":10:17: error[ownership]: use of an owner after it was consumed (moved, released, or dropped)", "      v := load(h.ptr)", "                  ^~~"],
        ),
        DiagCase(
            src: "{ Scope, with_sync } = std.scope\nhalloc = std.mem.heap\nleak = (s: MutPtr<Scope<A>>) RawPtr<u8> {\n    p := s.acquire(8)\n    p\n}\nmain = () i32 { h := halloc.gpa()  h.addr().with_sync(4096, leak)  0 }\n",
            wants: [":5:5: error[scope-escape]: value from scope `s` escapes its scope", "      p", "      ^", "hint: do not return a pointer from `s.acquire(...)`"],
        ),
        DiagCase(
            src: "{ Scope, with_sync } = std.scope\nhalloc = std.mem.heap\nleak = (s: MutPtr<Scope<A>>) RawPtr<u8> { s.acquire(8) }\nmain = () i32 { h := halloc.gpa()  h.addr().with_sync(4096, leak)  0 }\n",
            wants: ["error[scope-escape]: value from scope `s` escapes its scope"],
        ),
        DiagCase(
            src: "Inner: { v: i64 }\nBox: { inner: Inner }\npoke = (b: Ptr<Box>) void { b.inner.v = 99 }\nmain = () i32 { 0 }\n",
            wants: [":3:29: error[ptr-write]: cannot write through a read-only `Ptr<T>`", "  poke = (b: Ptr<Box>) void { b.inner.v = 99 }", "                              ^", "hint: give the pointer parameter/field the `MutPtr<T>` kind to permit writes through it"],
        ),
        DiagCase(
            src: "Buf: { data: [i64] }\npoke = (b: Ptr<Buf>) void { b.data[0] = 99 }\nmain = () i32 { 0 }\n",
            wants: [":2:29: error[ptr-write]: cannot write through a read-only `Ptr<T>`", "  poke = (b: Ptr<Buf>) void { b.data[0] = 99 }", "                              ^", "hint: give the pointer parameter/field the `MutPtr<T>` kind to permit writes through it"],
        ),
        DiagCase(
            src: "E: A | B | Cc\nmain = () i32 {\n    e := E.A\n    e.match ({ .A => 1, .B => 2 })\n    0\n}\n",
            wants: [":4:5: error[exhaustiveness]: match does not cover variant `.Cc`", "      e.match ({ .A => 1, .B => 2 })", "      ^", "hint: add arms for every variant, or add an explicit `_` arm"],
        ),
        DiagCase(
            src: "main = () i32 {\n    x: Widget := 0\n    x\n}\n",
            wants: [":2:5: error[unknown-type]: unknown type name `Widget`", "      x: Widget := 0", "      ^", "hint: declare the type, import it, or qualify it with its module (e.g. `mod.Type`)"],
        ),
        DiagCase(
            src: "Point*: { x: i32 }\nmain = () i32 {\n    p := Point(x: 1)\n    p.frobnicate()\n}\n",
            wants: [":4:7: error[method-not-found]: no method `frobnicate` on type `Point`, and no function `frobnicate` is in scope", "      p.frobnicate()", "        ^~~~~~~~~~", "hint: define the method (a top-level `fn` whose first parameter is the receiver, called `recv.method(...)`), or check the method name"],
        ),
        DiagCase(
            src: "main = () i32 { x := 5 }\n",
            wants: [":1:17: error[return-fit]: function body falls through with no value; add a trailing expression of the declared return type", "  main = () i32 { x := 5 }", "                  ^"],
        ),
        DiagCase(
            src: "load = (x: i64) i64 { x + 1 }\nmain = () i32 { to_i32(load(41)) }\n",
            wants: ["error[reserved-name]: `load` is a compiler intrinsic; a top-level function may not redefine it — calls would compile to the intrinsic, not this function", "hint: rename — `load` is a compiler intrinsic"],
        ),
        DiagCase(
            src: "// entry\nstore = (p: i64, v: i64) i64 { p + v }\nmain = () i32 { to_i32(store(1, 2)) }\n",
            wants: [":2:1: error[reserved-name]: `store` is a compiler intrinsic; a top-level function may not redefine it — calls would compile to the intrinsic, not this function", "  store = (p: i64, v: i64) i64 { p + v }", "  ^~~~~", "hint: rename — `store` is a compiler intrinsic"],
        ),
        DiagCase(
            src: "f = () i32 {\n    a := nope()\n    c: i32 := \"hi\"\n    \"s\"\n}\nmain = () i32 { f() }\n",
            wants: [":2:10: error[undefined-name]: undefined name", "      a := nope()", "           ^~~~", ":3:15: error[assign-fit]: expected `i32`, got `string_literal`", "      c: i32 := \"hi\"", ":4:5: error[return-fit]: expected `i32`, got `string_literal`", "      \"s\""],
        ),
        DiagCase(
            src: "{ println } = std.text.fmt\nPoint*: { x: i32 }\nmain = () i32 {\n    p := Point(x: 1)\n    println(p)\n    0\n}\n",
            wants: [":5:5: error[trait-bound]: type `Point` does not implement trait `Display` (which declares `fmt_println`) — missing method(s): fmt_print, fmt_println", "      println(p)", "      ^~~~~~~", "hint: implement the bound trait for this type (`Type.impl(Trait, { … })`), or relax the bound"],
        ),
        DiagCase(
            src: "{ print } = std.text.fmt\nQ*: { a: i32, b: i32 }\nmain = () i32 {\n    q := Q(a: 1, b: 2)\n    print(q)\n    0\n}\n",
            wants: [":5:5: error[trait-bound]: type `Q` does not implement trait `Display` (which declares `fmt_print`) — missing method(s): fmt_print, fmt_println", "      print(q)", "      ^~~~~", "hint: implement the bound trait for this type (`Type.impl(Trait, { … })`), or relax the bound"],
        ),
    ])
    // PARSE TAXONOMY: an arm label with no `=>` names the arrow, not "unparseable top-level input".
    // PARSE TAXONOMY: end of input with a block still open carets the OPENING `{` — the hint names
    // the line the block opened on instead of pointing inside the body at "this top-level declaration".
    // …and a NESTED block reports the INNER `{` (the brace anchor is lexically scoped).
    // PARSE TAXONOMY: a `:=` that binds nothing carets the `:=`.
    // PARSE TAXONOMY: the file ends mid-expression.
    // BUG FIX: an unknown type anchored on the FIRST declaration of a file (decl pos = byte 0) used
    // to print with NO line:col at all — the packed-kind encoding dropped position 0. Now it carets.
    // a pointer stored into a struct FIELD aliases the same allocation; freeing the source local
    // kills the field alias, so a later read of the field is a use-after-free (positioned at the field).
    // Multi-return uses named anonymous structs `{ x: T, y: U }`, not parenthesized type lists.
    // census #59b: a type error raised while checking a GENERIC stdlib body (here `println*<T>`'s
    // `x.fmt_println()`, instantiated for a type with no Display impl) must be attributed to the
    // USER's CALL SITE — `zod_v.zen:5:5` — NOT the library-internal line inside `std/text/fmt.zen`.
    // The `zod_v.zen:` prefix (via the leading `:`) is the whole point: before the fix this said
    // `src/std/text/fmt.zen:108`, a place the user never wrote.
    // same attribution for `print*<T>`: the caret lands on the user's `print(q)`, not std.
    // BATCH diagnostics (#43): three INDEPENDENT main-channel errors in one function — an undefined
    // name, an assign-fit, and a return-fit — must ALL be reported (per-statement recovery), not
    // just the first. Each keeps its own file:line:col + caret; the run continues past each error.
    // #392: a value-consumed match arm that yields no value — caret on the offending arm.
    // the original intrinsic-collision repro (fn at byte 0 → position-less, message still exact).
    // R2: a NESTED field write through a read-only `Ptr<T>` is positioned on the write target.
    // R3: an index-set into a slice field of a read-only `Ptr<T>`.
    // R6: exhaustiveness on a LOCAL-binding subject is now positioned on the subject (was position-less).
    // R7: a value-less body tail is positioned on the last statement, with the fall-through message.
    // a ONE-ARMED bool `.match` in VALUE position is non-exhaustive (the missing branch has no value):
    // a POSITIONED exhaustiveness diagnostic, identical in shape to the enum case above — NOT the old
    // position-less undefined-name sentinel. (In statement position the same form is legal; see harness_value.)
    // ── (h) `zenc emit` C-substring assertions (enum switch / bool ternary / no self-capture) ─────
    em := run_emits("build emit", [
        EmitCase(
            path: "tests/fixtures/zen/enum_emit.zen",
            present: ["switch (_subj.tag)", "case R_Ok:"],
            absent: [],
        ),
        EmitCase(
            path: "tests/fixtures/zen/bool_emit.zen",
            present: ["return (b ? 1LL : 0LL);"],
            absent: ["switch"],
        ),
        EmitCase(
            path: "tests/fixtures/zen/gen_template_local_no_capture.zen",
            present: [],
            absent: ["int32_t value = value"],
        ),
        EmitCase(
            path: "tests/fixtures/zen/slice_literal_alloc_emit.zen",
            present: ["_zsp = zen__salloc(sizeof(_zsa))", "(zslice){ .ptr = (void*)(int32_t[]){ 10LL, 20LL, 30LL }, .len = 3 }"],
            absent: ["_zsp = malloc(sizeof(_zsa))", "(void*)(int32_t[]){ 1LL, 2LL, 3LL }", "(void*)(int32_t[]){ 4LL, 5LL, 6LL }", "(void*)(int32_t[]){ 7LL, 8LL, 9LL }"],
        ),
    ])
    // ── (i) `zenc doc` public-surface + legacy-name assertions across the std modules + genc.zen ──
    dc := run_docs("build doc", [
        DocCase(
            target: "std.text.fmt",
