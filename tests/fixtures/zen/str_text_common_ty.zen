// #40 regression: a match mixing a `.Ok(s)` payload (infers `str`) with a string LITERAL arm
// (infers `text`) must unify to `str`, NOT void. A void-typed binding dispatched `println` on void
// and emitted an undefined `fmt_println` (link error). No `: str` annotation — the type is INFERRED.
halloc = std.mem.heap
{ contents_in } = std.io.file
{ println } = std.text.fmt
main = () i32 {
    heap := halloc.gpa()
    a := heap.addr()
    r := a.contents_in("/definitely/not/a/real/path.txt")
    line := r.match ({
        .Ok(s)  => s,
        .Err(e) => "no file",
    })
    println(line)
    0
}
