// a generic parameter swallows a concrete one: `init: A` accepts an
// Alloc, so these two can never be told apart at a call site. DESIGN.md,
// Overloading -- which is why the allocating loop variant is named `map`
// instead of being an overload of `loop`.
//
// positions: both declarations.

fold = <A>(init: A, body: (acc: A) A) A { body(init) }

fold = (alloc: Alloc, body: (acc: i32) i32) i32 { body(0) }

main = (env: Env) Res<i32, AllocError> {
    println("{}", fold(1, (acc) { acc + 1 }));
    Ok(0);
}
