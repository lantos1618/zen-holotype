// tests/corpus/loop-basic/index_and_value_differ_when_the_walk_is_not_zero_based/
// the two-body-parameter overload threads TWO things and they are not
// aliases: index is the pass count from zero, value the element. over
// Range(0, n) a lowering that hands the counter to both prints the
// right answer, so every discriminating case here walks something
// whose elements are not its indexes: a non-zero range, an array of
// negatives, a vec of values too wide for one machine word

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();

    // 0 10 / 1 11 / 2 12 - swap them and every line is wrong twice
    Range(10, 13).loop((h, index, value) {
        println("range {} {}", index, value);
    });

    // negatives cannot be pass counts at all
    [-4, -5, -6].loop((h, index, value) {
        println("array {} {}", index, value);
    });

    // 9000000001 does not survive a trip through i32; -7 does not
    // survive an unsigned slot. both print as plausible numbers
    nums ::= alloc.Vec<i64>();
    nums.add(-7).try();
    nums.add(9000000001).try();
    nums.loop((h, index, value) {
        println("vec {} {}", index, value);
    });
    Ok(0);
}
