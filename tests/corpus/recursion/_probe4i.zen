// probe: does a struct-typed recursive function work at all when the
// recursion is NOT inside a block arm?
mk = (n: i64) Link {
    (n <= 0).match({
        true  => Link(value: 1000, next: null_ptr<Link>()),
        false => Link(value: n * 10, next: null_ptr<Link>()),
    });
}

main = (env: Env) Res<i32, AllocError> {
    println("{}", mk(3).value);
    Ok(0);
}
