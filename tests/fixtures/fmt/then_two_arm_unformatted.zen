// `.then` two-arm canonicalization: a short exhaustive two-arm boolean `.match` becomes the
// conditional expression `c.then({ t }, { e })`; arms too long for one line keep the multiline
// `.match` form; a nested conditional keeps the match form with the INNER conditional rendered
// as `.then`; a conditional used as a postfix receiver is parenthesized so the output reparses
// to the same AST; block-bodied statement matches keep the `.match` spelling.
pick = (n: i32) i32 {
    a = (n > 3).match ({ true => 10, false => 20 })
    b = (n > 3).match ({ true => n.helper(1, 2, 3) + n.helper(4, 5, 6) + 999999, false => n.helper(7, 8, 9) + n.helper(10, 11, 12) + 888888 })
    c = (n < 3).match ({ true => 1, false => (n < 10).match ({ true => 2, false => 3 }) })
    d = (n > 3).match ({ true => 1, false => 2 }) + 5
    e = ((n > 3).match ({ true => 1, false => 2 })).helper(1, 2, 3)
    f = (n>3).then({7}, {8})
    a + b + c + d + e + f
}
helper = (n: i32, a: i32, b: i32, c: i32) i32 { n + a + b + c }
act = (c: bool) i32 {
    r = 0
    c.match ({ true => {
        r = 1
    }, false => {
        r = 2
    } })
    r
}
main = () i32 { pick(5) + act(true) }
