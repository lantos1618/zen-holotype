// A CALL NEEDS A FUNCTION. `n` is an i32 binding, and `n()` writes the
// call form over it -- the callee's TYPE is what decides, not the shape
// of the syntax, so a value of any non-Fn type refused here.
//
// Not `no overload matches`: that fault is for a name with candidates
// none of which fit. This one has no candidates at all, because an i32
// is not a thing with an arity.
//
// position: the callee, which is the half that has to change.

main = (env: Env) Res<i32, AllocError> {
    n: i32 = 3;
    println("{}", n());
    Ok(0);
}
