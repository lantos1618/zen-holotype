// A FREE FUNCTION ON A PRELUDE TYPE TRAVELS TO IT LIKE ANY OTHER: i32 is
// declared as an ordinary struct in std.core ("a prelude declaration of a
// primitive's name IS that primitive"), so a free function taking i32
// first is reachable through the dot on any i32 -- including one produced
// by a method call mid-chain.
//
// The plausible failure: member lookup special-cases primitives as builtin
// C types with no member table, so `n.halve()` answers "no `halve` on
// `i32`" while the identical call spelled `halve(n)` compiles. The chain
// form matters because it is how the language's own conversions read --
// `.to_i64()` is exactly this shape, reached on values, not imported.
//
// Breaks if: the dot skips the primitive's declared members -- the second
// line rejects or answers with the wrong body.

halve = (n: i32) i32 { n / 2 }

main = (env: Env) Res<i32, AllocError> {
    n: i32 = 9;
    println("direct {}", halve(n));
    println("dot    {}", n.halve());
    Ok(0);
}
