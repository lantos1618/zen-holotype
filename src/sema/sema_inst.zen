// src/sema/sema_inst.zen
// What a type parameter BECOMES. `sema_ty.zen` gives it its own type,
// `Ty.Var`; this file substitutes it.
//
// An instantiation is a pair of parallel lists, not a `Map` (same
// reason as the backend's type worklist: small, built once, read many
// times) — `vars` holds the `Ty.Var` ids, `args` what each became, so a
// lookup is a `u32` compare.
//
// The memo is not re-keyed by instantiation: a generic body is checked
// exactly once, generically; `ExprId` already separates call sites, and
// re-keying would re-check the body per instantiation, duplicating
// every diagnostic it owes.
//
// Substitution happens only at a call resolving (`sema_call.zen`) and a
// member reached through a generic receiver (`sema_member.zen`);
// everything downstream reads those answers rather than deriving them.
//
// A partial substitution is worse than none: `subst` leaves an unbound
// `Var` alone; `has_var` is what every consumer must check before
// emitting, since a `Var` reaching a backend mangles to one letter,
// colliding two instantiations into one symbol.

Decl, Struct, Enum, TParam, Span = std.ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId, TyNamed, TyRes, TyFn, ResForm = sema.sema_ty
decl_at = sema.sema_def
Checker = sema.sema_check

// One instantiation: which concrete type each type parameter became.
// The two `Vec`s are private, so an `Inst` can be held by value — living
// in a memo and a backend work queue at once, since nothing mutates it
// after `bind` finishes.
Inst* = {
    vars :: Vec<TyId>,
    args :: Vec<TyId>,

    // How many parameters this instantiation binds; zero is the empty
    // substitution every non-generic declaration is lowered under.
    len* = (self: @Self) usize { self.vars.len }

    // The i-th parameter and what it became, in declaration order —
    // needed to REBASE an instantiation (a call inside a generic body
    // instantiates at the enclosing body's own parameters).
    var_at* = (self: @Self, i: usize) Res<TyId> { self.vars.get(i) }

    arg_at* = (self: @Self, i: usize) Res<TyId> { self.args.get(i) }

    // Bind one parameter; first binding wins. Unifying `<T>(a: T, b: T)`
    // against `(i32, i32)` must not rebind `T` on the second argument —
    // a real disagreement is a mismatch the coercion check reports.
    bind* = (self :: @Self, v: TyId, arg: TyId) Res<(), AllocError> {
        self.bound(v).match({
            true  => Ok(()),
            false => self.push(v, arg),
        })
    }

    push = (self :: @Self, v: TyId, arg: TyId) Res<(), AllocError> {
        self.vars.add(v).try();
        self.args.add(arg).try();
        Ok(());
    }

    bound* = (self: @Self, v: TyId) bool {
        self.lookup(v).match({ Ok(_) => true, None => false })
    }

    // What `v` became, or nothing — "no binding", never "bound to
    // poison"; only one of those is a reason to refuse.
    lookup* = (self: @Self, v: TyId) Res<TyId> {
        n = self.vars.len;
        Range(0, n).find((k) {
            self.vars.get(k).match({ Ok(x) => x.eq(v), None => false })
        }).match({
            None  => None,
            Ok(k) => self.args.get(k),
        })
    }
}

// One call instantiating one generic declaration, paired with the call
// that made it, for `sema_depth.zen` to ask whether the instantiation
// set is finite. `Checker.inst_memo` holds the same answer keyed by
// call site, but a `Map` never lists, so edges are also appended to a
// `Vec` in resolution order for the termination walk.
//
// `from_owner` is the generic function whose body holds the call (empty
// at top level), making the walk a graph: an edge out of `ping` has
// `from_owner = "ping"` and `args` in `ping`'s own type parameters, for
// `subst` to chain forward.
InstEdge* = {
    from_owner*: str,
    to_owner*: str,
    to_name*: str,
    // the callee's own `Ty.Var`s and what this call gave them, both in
    // declaration order, so the pair is a substitution
    to_tvars*: Vec<TyId>,
    args*: Vec<TyId>,
    span*: Span,
}

// `alloc.Inst()`, a ufcs constructor like `Vec`, `Map` and `Types`. A
// bare value, not a `Res`: an empty instantiation owns no pages.
Inst* = (a: Alloc) Inst {
    Inst(vars: a.Vec<TyId>(), args: a.Vec<TyId>())
}

// ---------------------------------------------------------------------
// substitution
// ---------------------------------------------------------------------

// `ty` with every bound parameter replaced. Structural and total: an
// unmentioned parameter is unchanged, a mentioned-but-unbound one keeps
// it, since this has no position to report at.
subst* = (c :: Checker, ty: TyId, inst: Inst) Res<TyId, AllocError> {
    (inst.len() == 0).match({
        true  => Ok(ty),
        false => c.subst_kind(ty, inst),
    })
}

subst_kind = (c :: Checker, ty: TyId, inst: Inst) Res<TyId, AllocError> {
    c.types.at(ty).match({
        Var(_)   => Ok(inst.lookup(ty).match({ Ok(t) => t, None => ty })),
        Named(n) => c.subst_named(n, ty, inst),
        Res(r)   => c.subst_res(r, ty, inst),
        Fn(f)    => c.subst_fn(f, ty, inst),
        Union(u) => c.subst_union(u.members, ty, inst),
        _        => Ok(ty),
    })
}

// A nominal type is rebuilt from its arguments and keeps its
// declaration: `Vec<T>` at `T = u8` is `Vec<u8>`, which is a DIFFERENT
// interned id and the same declaration.
subst_named = (c :: Checker, n: TyNamed, ty: TyId, inst: Inst)
              Res<TyId, AllocError> {
    (n.args.len == 0).match({
        true  => Ok(ty),
        false => c.rebuild_named(n, inst),
    })
}

// `TyNamed` carries the bare name and declaration but not the qualified
// name the store keys on, so it's rebuilt from the declaration — the
// same two segments `Def.qname` joins, so the instantiation interns
// under the generic form's own path.
rebuild_named = (c :: Checker, n: TyNamed, inst: Inst)
                Res<TyId, AllocError> {
    args ::= c.alloc.Vec<TyId>();
    c.subst_list(n.args, inst, args).try();
    qname = owner_of(c, n.decl.module.to_usize(), n.name).try();
    c.types.named(n.decl, qname, n.name, args)
}

subst_res = (c :: Checker, r: TyRes, ty: TyId, inst: Inst)
            Res<TyId, AllocError> {
    value = c.subst(r.value, inst).try();
    error = c.subst(r.error, inst).try();
    unchanged(value, r.value, error, r.error).match({
        true  => Ok(ty),
        false => rebuild_res(c, value, error, r.form),
    })
}

unchanged = (a: TyId, b: TyId, x: TyId, y: TyId) bool {
    a.eq(b) && x.eq(y)
}

// `Types` builds a `Res` through the constructor its form names, and
// there is no fourth form to fall through to.
rebuild_res = (c :: Checker, value: TyId, error: TyId, form: ResForm)
              Res<TyId, AllocError> {
    form.match({
        Absence => c.types.res_absence(value),
        Failure => c.types.res_failure(value, error),
        Open    => c.types.res_open(value),
    })
}

subst_fn = (c :: Checker, f: TyFn, ty: TyId, inst: Inst)
           Res<TyId, AllocError> {
    params ::= c.alloc.Vec<TyId>();
    c.subst_list(f.params, inst, params).try();
    ret = c.subst(f.ret, inst).try();
    c.types.fn_ty(params, ret)
}

// Rebuilt through `union_ty`, which canonicalises: substituting two
// parameters into one type collapses the set, as writing it by hand would.
subst_union = (c :: Checker, members: Vec<TyId>, ty: TyId, inst: Inst)
              Res<TyId, AllocError> {
    parts ::= c.alloc.Vec<TyId>();
    c.subst_list(members, inst, parts).try();
    c.types.union_ty(parts)
}

subst_list* = (c :: Checker, src: Vec<TyId>, inst: Inst, out :: Vec<TyId>)
              Res<(), AllocError> {
    src.loop((h, t) { out.add(c.subst(t, inst).try()).try() });
    Ok(());
}

// Still mentions an unsubstituted parameter. `tcode` renders a `Var` as
// one letter, so `Vec<T>`/`Vec<U>` would collide into one C definition —
// silently wrong, the exact failure class monomorphisation exists to
// avoid. Unanswerable consumers refuse instead.
has_var* = (c: Checker, ty: TyId) bool {
    c.types.at(ty).match({
        Var(_)   => true,
        Named(n) => c.any_has_var(n.args),
        Res(r)   => c.has_var(r.value) || c.has_var(r.error),
        Fn(f)    => c.any_has_var(f.params) || c.has_var(f.ret),
        Union(u) => c.any_has_var(u.members),
        _        => false,
    })
}

any_has_var = (c: Checker, list: Vec<TyId>) bool {
    Range(0, list.len).find((i) {
        list.get(i).match({ Ok(t) => c.has_var(t), None => false })
    }).match({ Ok(_) => true, None => false })
}

// ---------------------------------------------------------------------
// where an instantiation comes from
// ---------------------------------------------------------------------

// The `Ty.Var`s a declaration's type parameters denote. `owner` must be
// the same string every reader builds, since `Var` is interned on it —
// `owner_of` is the one builder.
tparam_vars* = (
    c       :: Checker,
    tparams : Vec<TParam>,
    owner   : str,
    out     :: Vec<TyId>
) Res<(), AllocError> {
    tparams.loop((h, tp) {
        out.add(c.types.var(tp.name.text, owner).try()).try();
    });
    Ok(());
}

// The same vars, PUSHED INTO SCOPE rather than collected: a struct's
// `<T>` and a member's `<U>` resolve out of the tvar stack the same way.
push_tparams* = (c :: Checker, tparams: Vec<TParam>, owner: str)
                Res<(), AllocError> {
    tparams.loop((h, tp) {
        text = tp.name.text;
        c.push_tvar(text, c.types.var(text, owner).try()).try();
    });
    Ok(());
}

// A declaration's qualified name: module plus own name. `sema_call.zen`
// and `sema_member.zen` agree with this because both join the same two
// segments the same way.
owner_of* = (c :: Checker, mi: usize, name: str) Res<str, AllocError> {
    out ::= c.alloc.String("{}.{name}", module_name(c, mi)).try();
    Ok(out.view());
}

module_name* = (c: Checker, mi: usize) str {
    c.world.table_at(mi).match({ Ok(t) => t.name, None => "" })
}

// The instantiation a generic TYPE carries: `Vec<GenDiag>` binds `Vec`'s
// own `T`, so a member of a generic receiver answers about the
// receiver, not the declaration. Empty for the common non-generic case.
inst_of_named* = (c :: Checker, n: TyNamed) Res<Inst, AllocError> {
    inst ::= c.alloc.Inst();
    (n.args.len > 0).match({
        false => Ok(()),
        true  => c.fill_from_decl(n, inst),
    }).try();
    Ok(inst);
}

fill_from_decl = (c :: Checker, n: TyNamed, inst :: Inst)
                 Res<(), AllocError> {
    decl_at(c.tree, n.decl).match({
        None  => Ok(()),
        Ok(d) => c.fill_from_struct(n, d, inst),
    })
}

fill_from_struct = (c :: Checker, n: TyNamed, d: Decl, inst :: Inst)
                   Res<(), AllocError> {
    d.kind.match({
        Struct(s) => c.fill_tparams(n, s, inst),
        Enum(e)   => c.fill_enum_tparams(n, e, inst),
        _         => Ok(()),
    })
}

fill_tparams = (c :: Checker, n: TyNamed, s: Struct, inst :: Inst)
               Res<(), AllocError> {
    owner = owner_of(c, n.decl.module.to_usize(), s.name.text).try();
    vars ::= c.alloc.Vec<TyId>();
    c.tparam_vars(s.tparams, owner, vars).try();
    c.zip(vars, n.args, inst).try();
    Ok(());
}

// An enum's own arguments bind its parameters exactly as a struct's do:
// `Hold<Wide>` must answer `Has : Wide`, or the layout writes the
// payload as the bare parameter and the match arm reads it back as a
// structure. Same two steps as `fill_tparams`, over `e.tparams`.
fill_enum_tparams = (c :: Checker, n: TyNamed, e: Enum, inst :: Inst)
                    Res<(), AllocError> {
    owner = owner_of(c, n.decl.module.to_usize(), e.name.text).try();
    vars ::= c.alloc.Vec<TyId>();
    c.tparam_vars(e.tparams, owner, vars).try();
    c.zip(vars, n.args, inst).try();
    Ok(());
}

// Bind each parameter to the argument in its position; a shorter
// argument list binds what it can and leaves the rest unbound.
zip* = (c :: Checker, vars: Vec<TyId>, args: Vec<TyId>, inst :: Inst)
       Res<(), AllocError> {
    Range(0, vars.len).loop((h, i) {
        c.zip_one(vars, args, i, inst).try();
    });
    Ok(());
}

zip_one = (
    c    :: Checker,
    vars : Vec<TyId>,
    args : Vec<TyId>,
    i    : usize,
    inst :: Inst
) Res<(), AllocError> {
    vars.get(i).match({
        None  => Ok(()),
        Ok(v) => c.zip_arg(v, args, i, inst),
    })
}

zip_arg = (c :: Checker, v: TyId, args: Vec<TyId>, i: usize, inst :: Inst)
          Res<(), AllocError> {
    args.get(i).match({
        None  => Ok(()),
        Ok(t) => inst.bind(v, t),
    })
}

// ---------------------------------------------------------------------
// inference
// ---------------------------------------------------------------------

// Bind what an argument says about a declared parameter's type
// parameters. `<T>(p: Ptr<T>)` given `Ptr<u8>` binds `T = u8`; the walk
// is ordinary structural match, no occurs check, since a `Var` never
// appears inside the actual.
//
// Silent on disagreement: a parameter that doesn't line up binds
// nothing, and the caller finds out through `has_var` — reporting here
// would raise a diagnostic for an overload that was only being tried.
unify* = (c :: Checker, param: TyId, actual: TyId, inst :: Inst)
         Res<(), AllocError> {
    c.types.at(param).match({
        Var(_)   => c.bind_actual(param, actual, inst),
        Named(n) => unify_named(c, n, actual, inst),
        Res(r)   => unify_res(c, r, actual, inst),
        Fn(f)    => c.unify_fn(f, actual, inst),
        _        => Ok(()),
    })
}

// Poison never becomes a binding: an untypeable argument says nothing
// about `T` — binding `T = <unknown>` would emit a type nobody wrote.
//
// A type that still mentions a parameter is NOT poison — refusing it
// here used to turn an open answer into an opaque one. Bug found the
// hard way: `Range(1, 4).map(alloc, ..)` answers `Res<Vec<U>>` (map's
// own `U`, settled only by the body), and `ok_or`'s
// `<T>(r: Res<T>, ..)` declined to bind `T` at all — so
// `.ok_or(..).try()` answered a bare `T` instead of `Vec<U>`.
// `sema_call.zen` reaches no members through a foreign `Var`, so the
// `.loop` on it resolved to nothing, and a backend reading `call_memo`
// reported seven declarations of `loop` as an ambiguity.
//
// Binding keeps openness: `Vec<U>` is as open as `U`, and the refusal
// for it already lives at the consumer via `has_var`.
bind_actual = (c :: Checker, param: TyId, actual: TyId, inst :: Inst)
              Res<(), AllocError> {
    c.usable_actual(actual).match({
        false => Ok(()),
        true  => inst.bind(param, actual),
    })
}

usable_actual = (c: Checker, actual: TyId) bool {
    (c.is_unknown(actual) == false) && (c.is_infer(actual) == false)
}

unify_named = (c :: Checker, n: TyNamed, actual: TyId, inst :: Inst)
              Res<(), AllocError> {
    c.types.at(actual).match({
        Named(m) => unify_args(c, n, m, inst),
        _        => Ok(()),
    })
}

// Only two applications of ONE declaration say anything about each
// other's args: `Vec<T>` vs `Map<K, V>` is a mismatch, not inference.
unify_args = (c :: Checker, n: TyNamed, m: TyNamed, inst :: Inst)
             Res<(), AllocError> {
    n.decl.eq(m.decl).match({
        false => Ok(()),
        true  => c.unify_list(n.args, m.args, inst),
    })
}

unify_res = (c :: Checker, r: TyRes, actual: TyId, inst :: Inst)
            Res<(), AllocError> {
    c.types.at(actual).match({
        Res(s) => unify_res_parts(c, r, s, inst),
        _      => Ok(()),
    })
}

unify_res_parts = (c :: Checker, r: TyRes, s: TyRes, inst :: Inst)
                  Res<(), AllocError> {
    unify(c, r.value, s.value, inst).try();
    unify(c, r.error, s.error, inst).try();
    Ok(());
}

unify_fn = (c :: Checker, f: TyFn, actual: TyId, inst :: Inst)
           Res<(), AllocError> {
    c.types.at(actual).match({
        Fn(g) => c.unify_fn_parts(f, g, inst),
        _     => Ok(()),
    })
}

unify_fn_parts = (c :: Checker, f: TyFn, g: TyFn, inst :: Inst)
                 Res<(), AllocError> {
    c.unify_list(f.params, g.params, inst).try();
    unify(c, f.ret, g.ret, inst).try();
    Ok(());
}

unify_list* = (
    c       :: Checker,
    params  : Vec<TyId>,
    actuals : Vec<TyId>,
    inst    :: Inst
) Res<(), AllocError> {
    Range(0, params.len).loop((h, i) {
        unify_at(c, params, actuals, i, inst).try();
    });
    Ok(());
}

unify_at = (
    c       :: Checker,
    params  : Vec<TyId>,
    actuals : Vec<TyId>,
    i       : usize,
    inst    :: Inst
) Res<(), AllocError> {
    params.get(i).match({
        None  => Ok(()),
        Ok(p) => c.unify_actual_at(p, actuals, i, inst),
    })
}

unify_actual_at = (
    c       :: Checker,
    p       : TyId,
    actuals : Vec<TyId>,
    i       : usize,
    inst    :: Inst
) Res<(), AllocError> {
    actuals.get(i).match({
        None  => Ok(()),
        Ok(a) => unify(c, p, a, inst),
    })
}
