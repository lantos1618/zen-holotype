// A REJECT fixture: every function below is a way of trying to launder a read-only window back into
// writable memory through its `.ptr`, and `zen check` must refuse all of them. `.ptr` carries the
// window's own kind, so a `Slice<u8>` hands back `Ptr<u8>`, and `slice`/`store` on a read-only
// pointer are already errors — together they close the door. Before that, `v.ptr.slice(v.len)`
// type-checked as a writable `[u8]` and the store aborted at run time writing `.rodata`.
// Gated by the `readonly_ptr_no_launder` shell case in tests/harness_build.zen, which pins the exact
// diagnostics. This file NEVER compiles.
{ view } = std.text.str
// the shape that segfaulted: a literal's window, re-widened through its pointer
launder_literal = () u8 {
    v = "hello".view()
    w :: [u8] = v.ptr.slice(v.len)
    w[0] = 'H'
    w[0]
}
// the same via a StringLiteral local
launder_string_literal = (s: StringLiteral) u8 {
    v = s.view()
    w :: [u8] = v.ptr.slice(v.len)
    w[0] = 'H'
    w[0]
}
// the same via a StringCstr (a view of one is read-only too)
launder_string_cstr = (s: StringCstr) u8 {
    v = s.view()
    w :: [u8] = v.ptr.slice(v.len)
    w[0] = 'H'
    w[0]
}
// no slice needed: storing straight through the read-only pointer is the same write
launder_store = (s: StringCstr) i32 {
    v = s.view()
    v.ptr.store('H')
    0
}
// one hop further: byte arithmetic must not erase the read-only-ness either
launder_offset = (s: StringCstr) u8 {
    v = s.view()
    w :: [u8] = v.ptr.offset(0).slice(v.len)
    w[0] = 'H'
    w[0]
}
main = () i32 { to_i32(launder_literal()) }
