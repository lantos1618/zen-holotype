// char literals: 'a', the escaped quote, the escaped backslash, and
// the whitespace escapes. a char literal is one BYTE (str is bytes).
Error = AllocError | IoError

same = (a: u8, b: u8) str {
    (a == b).match({
        true  => "same",
        false => "different",
    })
}

main = (env: Env) Res<i32, Error> {
    println("{}", same('a', 'a'));
    println("{}", same('a', 'b'));
    println("{}", same('\'', '\''));
    println("{}", same('\\', '\\'));
    println("{}", same('\'', '\\'));
    println("{}", same('\n', '\t'));
    println("{}", same(':', ':'));
    Ok(0);
}
