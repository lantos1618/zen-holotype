// Creates checked state for either one buffer or a workspace build with an
// unsaved-buffer overlay.

str = std.text
Map = std.collections
Alloc, AllocError = std.mem
scan, Source = std.lex
Parser = std.parse
Ast = std.ast
Checker = sema.sema_check
check_all = sema.sema_decl
Build = zen.zen_build
root_for, relative_to, std_root_for = zen.zen_path

parse_standalone = (a: Alloc, name: str, text: str) Res<Parser, AllocError> {
    tree ::= a.Ast();
    lexed = scan(a, Source(file: name, text: text)).try();
    Ok(a.Parser(lexed, tree));
}

check_standalone* = (a: Alloc, name: str, text: str)
                    Res<Checker, AllocError> {
    p ::= parse_standalone(a, name, text).try();
    m = p.module("doc").try();
    p.tree.add_module(m).try();
    c ::= a.Checker(p.tree).try();
    check_all(c).try();
    Ok(c);
}

CheckedBuild* = {
    root*: str,
    rel*: str,
    c*: Checker,
}

WorkspaceCheck* = {
    b*: Build,
    c*: Checker,
}

check_workspace* = (
    env   : Env,
    a     : Alloc,
    root  : str,
    entry : str,
    docs  : Map<str, str>
) Res<WorkspaceCheck, AllocError> {
    b ::= a.Build(env, root);
    b.set_std_root(std_root_for(env, a));
    c = b.whole(entry, docs).try();
    Ok(WorkspaceCheck(b: b, c: c))
}

check_build* = (env: Env, a: Alloc, workspace: str, path: str, text: str)
               Res<CheckedBuild, AllocError> {
    root = root_for(env, a, workspace, path);
    rel  = relative_to(root, path);
    docs ::= a.Map<str, str>();
    docs.set(path, text).try();
    checked = check_workspace(env, a, root, rel, docs).try();
    Ok(CheckedBuild(root: root, rel: rel, c: checked.c));
}
