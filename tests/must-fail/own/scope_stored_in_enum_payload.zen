// the enum half of the STORED clause: `Box.Held(@scope)` is a variant
// constructor, not a struct construction, so the old decl_is_struct gate
// never saw it and the block left the frame inside an enum payload.

Box = Held(Scope) | Empty

here = () Box {
    Box.Held(@scope)
}

main = (env: Env) Res<i32, IoError> {
    b = here();
    Ok(0);
}
