Tester, TestError = std.test

Modulo = { value: i32 }
Modulo.impl(Eq, {
    eq = (self: @Self, other: @Self) bool {
        self.value % 10 == other.value % 10
    }
})

report = (answer: Res<(), TestError>) () {
    answer.match({
        Ok(_)  => println("pass"),
        Err(e) => e.match({ Failed(why) => println("fail: {}", why) }),
    });
}

main = (env: Env) () {
    t = Tester(env: env, alloc: env.mem.alloc());
    report(t.expect_eq(2, 2));
    report(t.expect_eq(2, 3));
    report(t.expect_eq("same", "same"));
    report(t.expect_eq("same", "different"));
    report(t.expect_eq(Modulo(value: 2), Modulo(value: 12)));
    report(t.expect_eq(Modulo(value: 2), Modulo(value: 13)));
}
