// std.time — monotonic & wall-clock access over POSIX clock_gettime.
//
// Two clocks, two jobs. CLOCK_MONOTONIC is a steadily-rising counter with no fixed epoch — it never
// jumps when the system clock is adjusted, so it is the RIGHT clock for MEASURING a duration
// (`mono_ns` then `elapsed_ns`). CLOCK_REALTIME is seconds/nanoseconds since the Unix epoch — the
// right clock for "what time is it now" (`wall_s`). Both go through clock_gettime, which writes a
// `struct timespec { i64 tv_sec; i64 tv_nsec }` into a 16-byte cell; we read the two i64 fields back
// out (tv_sec at +0, tv_nsec at +8) and fold them. The cell is a short-lived FFI scratch buffer from
// std.mem.raw — the explicit-alloc floor, the same justification as std.sync's pthread cells — and is
// freed before return, so callers thread no allocator and these stay plain UFCS-friendly functions.
{ clock_gettime } = std.c.libc
{ zeroed, release } = std.mem.raw
{ try_acquire } = std.mem.alloc
{ String } = std.text.string
{ Result, IoError, ok, err } = std.core.result
// nanosleep(const struct timespec *req, struct timespec *rem) suspends the calling thread until at
// least the requested interval elapses. It is a bodyless (foreign) decl — the same mechanism as
// clock_gettime above — so it lowers to a bare C call and libc's header declares it. `req` points at a
// filled `struct timespec` cell; `rem` is where the unslept remainder is written on an early wake — we
// always pass null (we don't retry on EINTR). On glibc it lives in libc itself (no -lrt needed).
nanosleep = (req: RawPtr<u8>, rem: RawPtr<u8>) i32
// Linux clock ids passed to clock_gettime.
CLOCK_REALTIME := 0
CLOCK_MONOTONIC := 1
// struct timespec layout on x86-64 Linux: two i64 words (tv_sec at +0, tv_nsec at +8).
TIMESPEC_SIZE := 16
NS_PER_S := 1000000000
NS_PER_MS := 1000000
MS_PER_S := 1000
// seconds-of-day arithmetic for the epoch → calendar breakdown (from_epoch) below.
SEC_PER_MIN := 60
SEC_PER_HOUR := 3600
SEC_PER_DAY := 86400
// read `clk` into a fresh timespec cell and fold the whole-seconds + nanoseconds fields to ns.
read_ns = (clk: i32) i64 {
    ts := zeroed(TIMESPEC_SIZE)
    clk.clock_gettime(ts)
    sec := ts.load_i64()
    nsec := ts.offset(8).load_i64()
    ts.release()
    sec * NS_PER_S + nsec
}
// read `clk` and return just its whole-seconds field.
read_s = (clk: i32) i64 {
    ts := zeroed(TIMESPEC_SIZE)
    clk.clock_gettime(ts)
    sec := ts.load_i64()
    ts.release()
    sec
}
// monotonic nanoseconds — for measuring elapsed time (no fixed epoch, never steps backward).
mono_ns* = () i64 { CLOCK_MONOTONIC.read_ns() }
// monotonic milliseconds (mono_ns folded down).
mono_ms* = () i64 { mono_ns() / NS_PER_MS }
// nanoseconds elapsed since an earlier `mono_ns()` reading.
elapsed_ns* = (start: i64) i64 { mono_ns() - start }
// milliseconds elapsed since an earlier `mono_ns()` reading.
elapsed_ms* = (start: i64) i64 { (mono_ns() - start) / NS_PER_MS }
// wall-clock seconds since the Unix epoch (CLOCK_REALTIME).
wall_s* = () i64 { CLOCK_REALTIME.read_s() }
// wall-clock nanoseconds since the Unix epoch (CLOCK_REALTIME).
wall_ns* = () i64 { CLOCK_REALTIME.read_ns() }
// ── sleeping ──────────────────────────────────────────────────────────────────
// Suspend this thread for `ms` milliseconds. Builds a `struct timespec` in a fresh 16-byte cell
// (tv_sec = whole seconds, tv_nsec = leftover ms as nanoseconds) and hands it to nanosleep; the
// remainder out-param is null (we don't retry on a signal). The cell is freed before return, so
// callers thread no allocator — same short-lived FFI-scratch pattern as read_ns above.
sleep_ms* = (ms: i64) void {
    ts := zeroed(TIMESPEC_SIZE)
    store_i64(ts, ms / MS_PER_S)
    store_i64(ts.offset(8), ms % MS_PER_S * NS_PER_MS)
    ts.nanosleep(null_ptr())
    ts.release()
}
// Suspend this thread for `s` seconds (sleep_ms folded up).
sleep_s* = (s: i64) void { sleep_ms(s * MS_PER_S) }
// ── calendar breakdown ────────────────────────────────────────────────────────
// A wall-clock instant split into UTC calendar fields. `weekday` is 0=Sunday .. 6=Saturday.
// This is a plain value; from_epoch below fills it from a Unix timestamp with pure arithmetic
// (no libc gmtime_r, so no struct-tm layout dependency and a fully deterministic result).
DateTime*: {
    year: i64,
    month: i64,
    day: i64,
    hour: i64,
    min: i64,
    sec: i64,
    weekday: i64,
}
// Split Unix epoch `secs` (seconds since 1970-01-01T00:00:00Z, assumed >= 0) into UTC calendar
// fields. Time-of-day is straight modular arithmetic; the date uses Howard Hinnant's civil-from-days
// algorithm, which shifts the epoch to an era anchored at 0000-03-01 so leap years fall out with
// exact integer division (valid across the whole positive range, DST-free because it is pure UTC).
from_epoch* = (secs: i64) DateTime {
    days := secs / SEC_PER_DAY
    rem := secs % SEC_PER_DAY
    hh := rem / SEC_PER_HOUR
    mm := rem % SEC_PER_HOUR / SEC_PER_MIN
    ss := rem % SEC_PER_MIN
    wd := (days + 4) % 7    // 1970-01-01 was a Thursday; +4 rebases to 0=Sunday
    z := days + 719468    // shift epoch to the 0000-03-01 era origin
    era := z / 146097    // one era = 400 years = 146097 days
    doe := z - era * 146097    // day-of-era [0, 146096]
    yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365    // year-of-era [0, 399]
    y := yoe + era * 400
    doy := doe - (365 * yoe + yoe / 4 - yoe / 100)    // day-of-year, March-based [0, 365]
    mp := (5 * doy + 2) / 153    // March-based month [0, 11]
    d := doy - (153 * mp + 2) / 5 + 1    // day-of-month [1, 31]
    m := (mp < 10).match ({ true => mp + 3, false => mp - 9 })    // civil month [1, 12]
    // March-based month means Jan/Feb of the calendar year belong to the next civil year.
    yr := (m <= 2).match ({ true => y + 1, false => y })
    DateTime(
        year: yr,
        month: m,
        day: d,
        hour: hh,
        min: mm,
        sec: ss,
        weekday: wd,
    )
}
// ── formatting ────────────────────────────────────────────────────────────────
// Write a fixed-width 2-digit decimal (00..99) at `p+at`, returning the next offset.
dt_w2 = (p: RawPtr<u8>, at: i64, n: i64) i64 {
    p.offset(at).store('0' + n / 10 % 10)
    p.offset(at + 1).store('0' + n % 10)
    at + 2
}
// Write a fixed-width 4-digit decimal (0000..9999) at `p+at`, returning the next offset.
dt_w4 = (p: RawPtr<u8>, at: i64, n: i64) i64 {
    p.offset(at).store('0' + n / 1000 % 10)
    p.offset(at + 1).store('0' + n / 100 % 10)
    p.offset(at + 2).store('0' + n / 10 % 10)
    p.offset(at + 3).store('0' + n % 10)
    at + 4
}
// Render `dt` as the 19-byte "YYYY-MM-DD HH:MM:SS" into buffer `p` (cap already reserved).
dt_write_iso = (p: RawPtr<u8>, dt: DateTime, cap: i64) String {
    a0 := dt_w4(p, 0, dt.year)
    p.offset(a0).store('-')
    a1 := dt_w2(p, a0 + 1, dt.month)
    p.offset(a1).store('-')
    a2 := dt_w2(p, a1 + 1, dt.day)
    p.offset(a2).store(' ')
    a3 := dt_w2(p, a2 + 1, dt.hour)
    p.offset(a3).store(':')
    a4 := dt_w2(p, a3 + 1, dt.min)
    p.offset(a4).store(':')
    a5 := dt_w2(p, a4 + 1, dt.sec)
    String(
        ptr: p,
        len: a5,
        cap: cap,
    )
}
// Format `dt` as an ISO-ish "YYYY-MM-DD HH:MM:SS" String, allocator-threaded like the other
// string-returning std builders — allocation failure is a value (Result). A 4-digit year is
// assumed (years 0..9999); this is deliberately not a full strftime.
//   dt := from_epoch(ts)
//   s := dt.iso_in(alloc.addr()).expect("oom")    // "2021-01-01 00:00:00"
iso_in*<A> = (dt: DateTime, a: MutPtr<A>) Result<String, IoError> {
    cap := 24    // 19 chars + NUL headroom for a later finish_in
    a.try_acquire(cap).match ({
        .Ok(p)  => ok(dt_write_iso(p, dt, cap)),
        .Err(e) => err(e),
    })
}
