// tests/must-fail/sema/construction_names_no_member.zen
//
// An argument naming no member of the constructed type is refused, with
// the name and the type it does not belong to. Before this rule a
// construction like `A(x: 1, nosuch: 99)` compiled, ran, and silently
// discarded the argument — a misspelt field name at a construction site
// was a zero nobody wrote, the same loss `construction is missing a
// required field` polices on the leaving-out side.
//
// position: the argument's name.

A = {
    x: i32,
}

main = (env: Env) Res<i32, AllocError> {
    a = A(x: 1, nosuch: 99);
    println("{}", a.x);
    Ok(0);
}
