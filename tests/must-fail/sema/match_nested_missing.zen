// the outer enum is fully covered and the inner one is not: Left(Blank)
// matches no arm. exhaustiveness is over the pattern SPACE, not over the
// top-level variant list.
//
// position: the match expression (its receiver).

Cell = Full(i32) | Blank

Slot = Left(Cell) | Right(Cell) | Gone

describe = (env: Env, s: Slot) () {
    s.match({
        Left(Full(n)) => println("left {}", n),
        Right(_)      => println("right"),
        Gone          => println("gone"),
    });
}

main = (env: Env) Res<i32, AllocError> {
    describe(env, Slot.Left(Cell.Blank));
    Ok(0);
}
