// mini-jq — a tiny JSON query CLI, built on the public std API as a dogfooding exercise.
//
//   ./zen run examples/jq.zen <filter> [file]
//
// filter grammar (a subset of jq):
//   .              identity (the whole document)
//   .a.b           object field access
//   .arr[0]        array indexing
//   .a.b[2].c      the two combined
//
// With no [file], JSON is read from stdin. Output is pretty-printed with 2-space indent.
// All failures (missing file, bad JSON, bad path) are reported as clean messages, never a crash.
json = std.format.json
os = std.sys.os
str = std.text.str
{ Malloc } = std.mem.alloc
{ print, println } = std.text.fmt
{ Value } = std.format.json
// UFCS method calls (recv.name(...)) need the free function's name in scope — a module
// alias alone is not enough, so bring the ones we call as methods into scope by name.
{ len, at, substr, cat, parse_int } = std.text.str
{ read_all } = std.io.stdin
{ contents } = std.io.file
// ── pretty printer ────────────────────────────────────────────────────────────
// Leaves (null/bool/number/string) are rendered by json.stringify so escaping and
// number formatting match the canonical encoder. Only arrays/objects are laid out here.
emit = (s: string_view) i64 { print(s) }
indent = (depth: i64) i64 {
    (depth <= 0).match ({
        true  => 0,
        false => {
            emit("  ")
            indent(depth - 1)
        },
    })
}
pretty<A> = (a: MutPtr<A>, v: Value, depth: i64) i64 {
    v.match ({
        .Arr(xs) => {
            (xs.len == 0).match ({
                true  => emit("[]"),
                false => {
                    emit("[\n")
                    xs.loop((h, i, x) {
                        indent(depth + 1)
                        a.pretty(x, depth + 1)
                        (i + 1 < xs.len).then({ emit(",") }, { 0 })
                        emit("\n")
                    })
                    indent(depth)
                    emit("]")
                },
            })
        },
        .Obj(o)  => {
            (o.entries.len == 0).match ({
                true  => emit("{}"),
                false => {
                    emit("{\n")
                    o.entries.loop((h, i, e) {
                        indent(depth + 1)
                        key: Value := .Str(e.key)
                        emit(json.stringify(a, key))
                        emit(": ")
                        a.pretty(e.val, depth + 1)
                        (i + 1 < o.entries.len).then({ emit(",") }, { 0 })
                        emit("\n")
                    })
                    indent(depth)
                    emit("}")
                },
            })
        },
        _        => emit(json.stringify(a, v)),
    })
}
// ── filter engine ─────────────────────────────────────────────────────────────
// Scan a field name starting at i (letters/digits/_/-), stopping at '.' or '['.
scan_key = (s: string_view, i: i64) i64 {
    (i >= s.len()).match ({
        true  => i,
        false => {
            b := str.at(s, i)
            (b == '.' || b == '[').then({ i }, { scan_key(s, i + 1) })
        },
    })
}
// Scan decimal digits starting at i, stopping at ']' or end.
scan_idx = (s: string_view, i: i64) i64 {
    (i >= s.len()).match ({
        true  => i,
        false => {
            b := str.at(s, i)
            (b >= '0' && b <= '9').then({ scan_idx(s, i + 1) }, { i })
        },
    })
}
// Apply the filter starting at byte i to the current value. Returns .Ok(selected)
// or .Err(message). Recurses down the path one segment at a time.
apply<A> = (a: MutPtr<A>, cur: Value, s: string_view, i: i64) Result<Value, string_view> {
    (i >= s.len()).match ({
        true  => {
            ok: Result<Value, string_view> := .Ok(cur)
            return ok
        },
        false => 0,
    })
    b := str.at(s, i)
    (b == '.').match ({
        true  => {
            j := scan_key(s, i + 1)
            (j == i + 1).match ({
                // bare "." with nothing after: identity if at end, else stray dot
                true  => {
                    (j >= s.len()).match ({
                        true  => {
                            ok: Result<Value, string_view> := .Ok(cur)
                            return ok
                        },
                        false => 0,
                    })
                },
                false => 0,
            })
            key := a.substr(s, i + 1, j - (i + 1)).expect("jq: substr failed")
            return json.get(cur, key).match ({
                .Some(nv) => a.apply(nv, s, j),
                .None     => {
                    msg := a.cat("jq: no such field: ", key)
                    e: Result<Value, string_view> := .Err(msg)
                    e
                },
            })
        },
        false => 0,
    })
    (b == '[').match ({
        true  => {
            j := scan_idx(s, i + 1)
            idxstr := a.substr(s, i + 1, j - (i + 1)).expect("jq: substr failed")
            (j < s.len() && str.at(s, j) == ']').match ({
                true  => 0,
                false => {
                    e: Result<Value, string_view> := .Err("jq: malformed index (expected ']')")
                    return e
                },
            })
            idx := str.parse_int(idxstr)
            return json.as_arr(cur).match ({
                .Some(xs) => (idx >= 0 && idx < xs.len).match ({
                    true  => a.apply(xs[idx], s, j + 1),
                    false => {
                        e: Result<Value, string_view> := .Err("jq: index out of range")
                        e
                    },
                }),
                .None     => {
                    e: Result<Value, string_view> := .Err("jq: not an array")
                    e
                },
            })
        },
        false => 0,
    })
    bad: Result<Value, string_view> := .Err("jq: bad filter syntax (expected '.' or '[')")
    bad
}
main = () i32 {
    mm: Malloc := Malloc(_: 0)
    a := mm.addr()
    n := os.argc()
    // arg(0) is the script path; user args start at arg(1).
    filter := (n >= 2).then({ os.arg(1) }, { "." })
    // Source: a file path in arg(2), else stdin.
    src := (n >= 3).match ({
        true  => a.contents(os.arg(2)).match ({
            .Err(e) => {
                println("jq: cannot read file")
                return 1
            },
            .Ok(s)  => s,
        }),
        false => a.read_all().match ({
            .Err(e) => {
                println("jq: cannot read stdin")
                return 1
            },
            .Ok(s)  => s,
        }),
    })
    doc := json.parse(a, src).match ({
        .Err(e) => {
            println("jq: invalid JSON")
            return 1
        },
        .Ok(v)  => v,
    })
    a.apply(doc, filter, 0).match ({
        .Err(msg) => {
            println(msg)
            1
        },
        .Ok(sel)  => {
            a.pretty(sel, 0)
            println("")
            0
        },
    })
}
