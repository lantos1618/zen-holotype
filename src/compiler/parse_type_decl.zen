// compiler.parse_type_decl — TYPE-DECLARATION parsing: struct/enum/field/variant bodies plus the
// type-parameter list (`<A, B: Trait>`). Produces StructEnd/EnumEnd/TParamEnd for the top-level
// dispatch in compiler.parse. Distinct from compiler.parse_type, which parses type EXPRESSIONS.
// Split out of the compiler.parse god file. Style: UFCS throughout.
{ Expr, Field, StructDecl, EnumDecl, VariantDef, Ty, Param, Func } = compiler.ast.ast_types
{ param, field, field_default, expr_null, sdef_at, edef_at, vdef, vdef_default, tnamed, tvoid,
  fnt_from_func_in, acquire_or_die, acquire_or_die } = compiler.genc
{ Token, Scan, scan } = compiler.lex
{ at } = std.text.ascii
{ Malloc } = std.mem.alloc
{ is_op, is_op1, lexeme } = compiler.parse_atom
{ is_ident_tok } = compiler.parse_postfix
{ is_lparen } = compiler.parse_primary
{ parse_bxor } = compiler.parse_expr
{ parse_ty, parse_variant_payload, perr_set_at, perr_set_kind_at, PE_FIELDDEFAULT, PEnd, is_langle,
  is_rangle, is_rbrace, is_comma, param_buf, skip_to_brace, take_params } = compiler.parse_type
{ parse_decl_at, decl_marker, is_colon, is_star } = compiler.parse
StructEnd*: {
    sd: StructDecl,
    tparams: [Param],
    ntp: i32,
    next: i32,
    defaults: [Func],
}
no_tparams = (a: MutPtr<Malloc>) [Param] { slice(null_ptr(), 0) }
skip_name_star* = (src: StringView, pos: i32) i32 {
    nt := src.scan(pos)
    a1 := src.scan(nt.next)
    src.is_star(a1.tok).then({ a1.next }, { nt.next })
}
TParamEnd*: {
    names: [Param],
    count: i32,
    next: i32,
}
parse_tparams* = (a: MutPtr<Malloc>, src: StringView, pos: i32) TParamEnd {
    sc := src.scan(pos)
    src.is_langle(sc.tok).match ({
        true  => a.parse_tparam_list(src, sc.next),
        false => TParamEnd(
            names: a.no_tparams(),
            count: 0,
            next: pos,
        ),
    })
}
parse_tparam_list = (a: MutPtr<Malloc>, src: StringView, pos: i32) TParamEnd {
    buf := a.param_buf()
    te := a.fill_tparams(src, pos, buf, 0)
    TParamEnd(
        names: buf.take_params(te.count),
        count: te.count,
        next: te.next,
    )
}
// A tparam may carry a trait bound: `<A: Allocator>`. The bound is stored in the Param's `ty`
// slot as a `Named(traitname)` (tparams otherwise leave `ty` = tvoid()); the checker enforces it
// at call sites. No bound => tvoid(), exactly the prior behaviour, so plain `<A>` is unchanged.
record_tparam = (a: MutPtr<Malloc>, src: StringView, sc: Scan, buf: [Param], i: i32) PEnd {
    // OVERFLOW GUARD: at the buffer's cap, flag and stop instead of writing past the heap block.
    (i >= buf.len).then({
        perr_set_at(sc.tok.start)
        return PEnd(
            count: i,
            next: sc.next,
        )
    })
    nm := a.lexeme(src, sc.tok)
    colon := src.scan(sc.next)    // peek: a `:` introduces a trait bound
    src.is_colon(colon.tok).match ({
        true  => {
            tr := src.scan(colon.next)    // the bound trait name
            buf[i] = param(nm, tnamed(a.lexeme(src, tr.tok)))
            a.fill_tparams(src, tr.next, buf, i + 1)
        },
        false => {
            buf[i] = param(nm, tvoid())
            a.fill_tparams(src, sc.next, buf, i + 1)
        },
    })
}
fill_tparams = (a: MutPtr<Malloc>, src: StringView, pos: i32, buf: [Param], i: i32) PEnd {
    sc := src.scan(pos)
    sc.tok.kind.match ({
        .Eof => {
            perr_set_at(pos)
            PEnd(
                count: i,
                next: sc.next,
            )
        },
        _    => src.is_rangle(sc.tok).match ({
            true  => PEnd(
                count: i,
                next: sc.next,
            ),
            false => is_ident_tok(sc.tok).match ({
                true  => a.record_tparam(src, sc, buf, i),
                false => a.fill_tparams(src, sc.next, buf, i),
            }),
        }),
    })
}
field_buf = (a: MutPtr<Malloc>) [Field] { slice(a.acquire_or_die(1024 * sizeof(Field)), 1024) }
take_fields = (buf: [Field], n: i32) [Field] { slice(buf.ptr, n) }
dfn_buf = (a: MutPtr<Malloc>) [Func] { slice(a.acquire_or_die(256 * sizeof(Func)), 256) }
take_dfns = (buf: [Func], n: i32) [Func] { slice(buf.ptr, n) }
// `m = (...) Ret {}` inside a pure method record is a trait default; inside a data record
// it is an inherent method attached to the struct.
FieldsEnd: {
    count: i32,
    ndef: i32,
    next: i32,
}
fill_fields = (
    a: MutPtr<Malloc>,
    src: StringView,
    pos: i32,
    buf: [Field],
    i: i32,
    dbuf: [Func],
    dn: i32,
) FieldsEnd {
    sc := src.scan(pos)
    sc.tok.kind.match ({
        .Eof => {
            perr_set_at(pos)
            FieldsEnd(
                count: i,
                ndef: dn,
                next: sc.next,
            )
        },
        _    => src.is_rbrace(sc.tok).match ({
            true  => FieldsEnd(
                count: i,
                ndef: dn,
                next: sc.next,
            ),
            false => a.fill_field(src, pos, buf, i, dbuf, dn),
        }),
    })
}
// Default methods store both the FnT requirement and the reusable body.
fill_field_default = (
    a: MutPtr<Malloc>,
    src: StringView,
    pos: i32,
    buf: [Field],
    i: i32,
    dbuf: [Func],
    dn: i32,
    nm: StringView,
) FieldsEnd {
    de := a.parse_decl_at(src, pos)
    buf[i] = field(nm, a.fnt_from_func_in(de.func))
    dbuf[dn] = de.func
    after := src.scan(de.next)
    nxt := src.is_comma(after.tok).then({ after.next }, { de.next })
    a.fill_fields(src, nxt, buf, i + 1, dbuf, dn + 1)
}
// ── FIELD DEFAULTS `total: i64 = 0` ─────────────────────────────────────────────────────────────
// A struct literal that omits the field gets this value instead of C's zero-fill (compiler
// .check_resolve.fill_field_defaults). The value must be a CONSTANT — a literal, `true`/`false`, or
// arithmetic over them (`-1` parses as `0 - 1`). A default is re-evaluated at every construction, so
// anything that CALLS could allocate there, and Zen keeps every allocation visible at its site: a
// non-constant default is `error[field-default]` rather than a hidden per-value effect.
FDflt: {
    expr: Ptr<Expr>,
    next: i32,
}
field_dflt_const = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Int(v)      => true,
        .Byte(b)     => true,
        .FloatLit(f) => true,
        .StrLit(sd)  => true,
        .Var(v)      => v.name == "true" || v.name == "false",
        .Bin(b)      => b.lhs.field_dflt_const() && b.rhs.field_dflt_const(),
        _            => false,
    })
}
field_dflt = (a: MutPtr<Malloc>, src: StringView, pos: i32) FDflt {
    eq := src.scan(pos)
    src.is_op1(eq.tok, '=').match ({
        true  => {
            de := a.parse_bxor(src, eq.next)
            (de.expr.field_dflt_const() == false).then({
                perr_set_kind_at(src.scan(eq.next).tok.start, PE_FIELDDEFAULT())
            })
            FDflt(
                expr: de.expr,
                next: de.next,
            )
        },
        false => FDflt(
            expr: expr_null(),
            next: pos,
        ),
    })
}
fill_field = (
    a: MutPtr<Malloc>,
    src: StringView,
    pos: i32,
    buf: [Field],
    i: i32,
    dbuf: [Func],
    dn: i32,
) FieldsEnd {
    // Guard both field and default-method buffers.
    (i >= buf.len || dn >= dbuf.len).then({
        perr_set_at(pos)
        return FieldsEnd(
            count: i,
            ndef: dn,
            next: pos,
        )
    })
    nt := src.scan(pos)
    nm := a.lexeme(src, nt.tok)
    mk := src.decl_marker(pos)
    src.is_op1(mk.tok, '=').match ({
        true  => a.fill_field_default(src, pos, buf, i, dbuf, dn, nm),
        false => {
            te := a.parse_ty(src, mk.next)
            df := a.field_dflt(src, te.next)
            buf[i] = field_default(nm, te.ty, df.expr)
            after := src.scan(df.next)
            src.is_comma(after.tok).match ({
                true  => a.fill_fields(src, after.next, buf, i + 1, dbuf, dn),
                false => is_ident_tok(after.tok).match ({
                    true  => a.fill_fields(src, df.next, buf, i + 1, dbuf, dn),
                    false => {
                        // A no-trailing-comma field list closes on `}`; anything else (a stray token, or EOF on an
                        // unterminated `{ …`) is a positioned parse error, not a silent close (task: unclosed `{`).
                        (src.is_rbrace(after.tok) == false).then({
                            perr_set_at(after.tok.start)
                        })
                        FieldsEnd(
                            count: i + 1,
                            ndef: dn,
                            next: after.next,
                        )
                    },
                }),
            })
        },
    })
}
parse_struct_at* = (a: MutPtr<Malloc>, src: StringView, pos: i32) StructEnd {
    nt := src.scan(pos)
    name := a.lexeme(src, nt.tok)
    tp := a.parse_tparams(src, src.skip_name_star(pos))
    bstart := src.skip_to_brace(nt.next)
    buf := a.field_buf()
    dbuf := a.dfn_buf()
    fe := a.fill_fields(src, bstart, buf, 0, dbuf, 0)
    StructEnd(
        sd: sdef_at(name, buf.take_fields(fe.count), nt.tok.start),
        tparams: tp.names,
        ntp: tp.count,
        next: fe.next,
        defaults: dbuf.take_dfns(fe.ndef),
    )
}
field_is_method* = (f: Field) bool {
    f.ty.match ({
        .FnT(fd) => true,
        _        => false,
    })
}
has_data_field* = (fields: [Field]) bool {
    found := false
    fields.loop((h, i, f) {
        found = f.field_is_method().then({ found }, { true })
    })
    found
}
// is `f` the SYNTHESIZED requirement field of one of the record's `=`-methods? fill_field_default
// adds an FnT field per default, and only THOSE must be stripped from an inherent struct's data
// fields. Match on name AND FnT type: a user-written fn-typed field (`cb: (i32) i32`) is a real
// data field (filtering on FnT alone silently dropped it), while a data field that merely SHARES a
// method's name (Map<T> has both a `keys` pointer field and a `keys = (…)` method) is not FnT.
is_default_field = (defaults: [Func], f: Field) bool {
    found := false
    defaults.loop((h, i, df) {
        found = found || df.name == f.name && f.field_is_method()
    })
    found
}
data_field_count = (fields: [Field], defaults: [Func]) i32 {
    n := 0
    fields.loop((h, i, f) {
        (defaults.is_default_field(f) == false).then({
            n = n + 1
        })
    })
    n
}
data_fields* = (a: MutPtr<Malloc>, fields: [Field], defaults: [Func]) [Field] {
    buf := a.field_buf()
    j := 0
    fields.loop((h, i, f) {
        (defaults.is_default_field(f) == false).then({
            buf[j] = f
            j = j + 1
        })
    })
    buf.take_fields(fields.data_field_count(defaults))
}
// Enum variants end at the first token that is not `|`.
EnumEnd*: {
    ed: EnumDecl,
    tparams: [Param],
    ntp: i32,
    next: i32,
}
VPay: {
    ty: Ty,
    next: i32,
}
VDf: {
    vdf: VariantDef,
    next: i32,
}
variant_buf = (a: MutPtr<Malloc>) [VariantDef] {
    slice(a.acquire_or_die(1024 * sizeof(VariantDef)), 1024)
}
take_variants = (buf: [VariantDef], n: i32) [VariantDef] { slice(buf.ptr, n) }
variant_payload = (a: MutPtr<Malloc>, src: StringView, pos: i32) VPay {
    te := a.parse_variant_payload(src, pos)
    VPay(
        ty: te.ty,
        next: te.next,
    )
}    // `(T)` single, or `(T1, T2, …)` -> anon struct
fill_variants = (a: MutPtr<Malloc>, src: StringView, pos: i32, buf: [VariantDef], i: i32) PEnd {
    nt := src.scan(pos)
    nt.tok.kind.match ({
        .Eof => {
            perr_set_at(pos)
            PEnd(
                count: i,
                next: nt.next,
            )
        },
        _    => a.fill_variant(src, nt, buf, i),
    })
}
fill_variant = (a: MutPtr<Malloc>, src: StringView, nt: Scan, buf: [VariantDef], i: i32) PEnd {
    // Guard the variant buffer.
    (i >= buf.len).then({
        perr_set_at(nt.tok.start)
        return PEnd(
            count: i,
            next: nt.next,
        )
    })
    // A variant NAME must be an identifier. Without this guard `lexeme` happily reads whatever
    // token sits here (a stray `|`, a literal, a mid-list empty `| |`) as a bogus variant name,
    // desyncing the parse and SILENTLY swallowing the following top-level decl (task #34, sibling
    // of #411). Mirror the .Eof branch: flag a positioned parse error and stop.
    (is_ident_tok(nt.tok) == false).then({
        perr_set_at(nt.tok.start)
        return PEnd(
            count: i,
            next: nt.next,
        )
    })
    nm := a.lexeme(src, nt.tok)
    pk := src.scan(nt.next)
    vd := a.variant_after(src, nm, nt, pk)
    buf[i] = vd.vdf
    after := src.scan(vd.next)
    src.is_op1(after.tok, '|').match ({
        true  => a.fill_variants(src, after.next, buf, i + 1),
        false => PEnd(
            count: i + 1,
            next: vd.next,
        ),
    })
}
// After the variant name, dispatch on the next token: `(Type)` payload, `= expr` default, or bare.
variant_after = (a: MutPtr<Malloc>, src: StringView, nm: StringView, nt: Scan, pk: Scan) VDf {
    src.is_lparen(pk.tok).match ({
        true  => {
            vp := a.variant_payload(src, pk.next)
            VDf(
                vdf: vdef(nm, vp.ty),
                next: vp.next,
            )
        },
        false => src.is_op1(pk.tok, '=').match ({
            true  => {
                de := a.parse_bxor(src, pk.next)
                VDf(
                    vdf: vdef_default(nm, tvoid(), de.expr),
                    next: de.next,
                )
            },
            false => VDf(
                vdf: vdef(nm, tvoid()),
                next: nt.next,
            ),
        }),
    })
}
skip_to_colon = (src: StringView, pos: i32) i32 {
    sc := src.scan(pos)
    src.is_colon(sc.tok).then({ sc.next }, { src.skip_to_colon(sc.next) })
}
// A single OPTIONAL leading `|` right after the enum colon is idiomatic alignment layout
// (`Status*: | Ok | Err`, or one-variant-per-line with a leading bar). Skip exactly one — a
// SECOND bar is a genuine empty variant that the fill_variant identifier guard rejects.
skip_leading_bar = (src: StringView, pos: i32) i32 {
    sc := src.scan(pos)
    src.is_op1(sc.tok, '|').then({ sc.next }, { pos })
}
parse_enum_at* = (a: MutPtr<Malloc>, src: StringView, pos: i32) EnumEnd {
    nt := src.scan(pos)
    name := a.lexeme(src, nt.tok)
    tp := a.parse_tparams(src, src.skip_name_star(pos))
    cpos := src.skip_leading_bar(src.skip_to_colon(tp.next))    // start PAST the tparam list — a `<T: Bound>` colon must not be mistaken for the enum's `:`
    buf := a.variant_buf()
    ve := a.fill_variants(src, cpos, buf, 0)
    EnumEnd(
        ed: edef_at(name, buf.take_variants(ve.count), nt.tok.start),
        tparams: tp.names,
        ntp: tp.count,
        next: ve.next,
    )
}
