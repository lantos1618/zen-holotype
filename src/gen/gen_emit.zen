// src/gen/gen_emit.zen
// Where the bytes go, and the one rule that makes them reproducible.
//
// DETERMINISM IS A PROPERTY OF THIS FILE, not checked for afterwards.
// PLAN.md 0.4 / TESTING.md: the fixpoint oracle is worthless without it.
// Two mechanisms buy it, both here only:
//   - THE ONLY WAY OUT IS `Emit`. A backend never touches the caller's
//     buffer, so there's one place a byte is written.
//   - `order` IS THE ONLY WAY TO ORDER A COLLECTION, sorted by a key
//     that's a pure function of the thing. Nothing here iterates a
//     `Map` or emits in discovery order.
//
// `Emit` deliberately does NOT wrap lines, know what C is, or place
// braces — it's a buffer, a depth, and a newline rule; output shape
// belongs to the backend.
//
// THE BUFFER IS READ BACK OFF THE `Emit`, never returned beside it — a
// `String` owns a `Vec`, so a copy diverges from the original on first
// growth (same reason `Parser` holds the `Ast` rather than handing it
// back).

Alloc, AllocError = std.mem
str, String = std.text
Vec = std.collections
Range = std.core
write_usize = sema.sema_diag
before = std.text

// Four spaces, once. A backend asking for an indent should not also be
// deciding how wide one is.
INDENT* : usize = 4

Emit* = {
    text :: String,
    depth :: usize,

    // A newline was just written; the next byte starts a line and must
    // indent first. Tracked here, not per call site, so a blank line
    // stays blank — nothing on it, no indent.
    fresh :: bool,

    // -----------------------------------------------------------------
    // writing
    // -----------------------------------------------------------------

    bytes* = (self :: @Self, s: str) Res<(), AllocError> {
        self.open_line().try();
        self.text.add_bytes(s)
    }

    byte* = (self :: @Self, b: u8) Res<(), AllocError> {
        self.open_line().try();
        self.text.add_byte(b)
    }

    // A decimal, no separators, most significant digit first. Lives
    // here (not per-backend) since every backend writes numbers.
    // `std.text` has no `AllocError`-only integer writer — the format
    // machinery speaks `WriteError` (std gap, docs/SEMA_BOOTSTRAP_FIXES.md)
    // — so this borrows sema's until one exists.
    number* = (self :: @Self, v: usize) Res<(), AllocError> {
        self.open_line().try();
        write_usize(self.text, v)
    }

    // End the line. A blank line is `line` twice and gets no indent.
    line* = (self :: @Self) Res<(), AllocError> {
        self.text.add_byte('\n').try();
        self.fresh = true;
        Ok(());
    }

    // `s`, then the newline. The shape almost every emission has.
    say* = (self :: @Self, s: str) Res<(), AllocError> {
        self.bytes(s).try();
        self.line()
    }

    open_line = (self :: @Self) Res<(), AllocError> {
        self.fresh.then(() { self.write_indent().try() });
        self.fresh = false;
        Ok(());
    }

    write_indent = (self :: @Self) Res<(), AllocError> {
        Range(0, self.depth * INDENT).loop((h, i) {
            self.text.add_byte(' ').try();
        });
        Ok(());
    }

    // -----------------------------------------------------------------
    // depth
    // -----------------------------------------------------------------

    indent* = (self :: @Self) () { self.depth = self.depth + 1; }

    // Saturating: an unbalanced backend should produce ugly, readable C,
    // not an aborted compilation.
    dedent* = (self :: @Self) () {
        (self.depth > 0).then(() { self.depth = self.depth - 1; });
    }

    // -----------------------------------------------------------------
    // reading back
    // -----------------------------------------------------------------

    view* = (self: @Self) str { self.text.view() }

    len* = (self: @Self) usize { self.text.len() }
}

// `alloc.Emit()` — ufcs constructor beside the type it builds, like
// `Vec`, `Map`, `Ast`, `Types`. Allocates its buffer up front.
Emit* = (a: Alloc) Res<Emit, AllocError> {
    Ok(Emit(text: a.String().try(), depth: 0, fresh: true));
}

// THE ONE ORDERING PRIMITIVE. The positions of `keys`, rearranged so
// reading them in the returned order reads `keys` in lexicographic byte
// order.
//
// A permutation, not a sorted copy, so the caller keeps whatever the
// keys belong to (a declaration, a type, a function) without this file
// needing to know what that is.
//
// Insertion sort, STABLE: equal keys keep input order, so a duplicate
// name (a backend should report that, not silently reorder it) doesn't
// move under shuffled input. Hundreds of top-level names per unit, never
// millions — the simplest-to-verify version is the right one.
order* = (a: Alloc, keys: Vec<String>) Res<Vec<usize>, AllocError> {
    out ::= a.Vec<usize>();
    Range(0, keys.len).loop((h, i) {
        insert_ordered(out, keys, i).try();
    });
    Ok(out);
}

insert_ordered = (out :: Vec<usize>, keys: Vec<String>, i: usize)
                 Res<(), AllocError> {
    out.add(i).try();
    n = out.len;
    Range(1, n).loop((h, k) {
        j = n - k;
        prev = index_at(out, j - 1);
        cur = index_at(out, j);
        earlier(keys, cur, prev).then(() {
            put(out, j - 1, cur).try();
            put(out, j, prev).try();
        });
    });
    Ok(());
}

// `keys[i]` strictly before `keys[j]` — strict, so equal keys never
// swap and the sort stays stable. Ordering itself is `std.text`'s,
// beside `str.eq`, not here.
earlier = (keys: Vec<String>, i: usize, j: usize) bool {
    view_at(keys, i).before(view_at(keys, j))
}

view_at = (keys: Vec<String>, i: usize) str {
    keys.get(i).match({ Ok(s) => s.view(), None => "" })
}

index_at = (v: Vec<usize>, i: usize) usize {
    v.get(i).match({ Ok(n) => n, None => 0 })
}

// `Vec.set` refuses an out-of-range index with a bare `Res<()>` (no
// reason), and `.try()` won't lift a `None` into `Res<_, AllocError>`.
// Both indices here are in range by construction; `sema_ty.zen` carries
// the same five lines for the same reason.
put = (out :: Vec<usize>, i: usize, v: usize) Res<(), AllocError> {
    out.set(i, v).match({
        None  => Err(AllocError.OutOfMemory),
        Ok(_) => Ok(()),
    })
}
