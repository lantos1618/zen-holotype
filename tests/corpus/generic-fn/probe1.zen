// PROBE 1: basic generic fn, several instantiations, printing u8/i64/str,
// explicit + inferred type args, snd<A,B>.
pick_first = <T>(a: T, b: T) T { a }

snd = <A, B>(a: A, b: B) B { b }

main = (env: Env) Res<i32, AllocError> {
    big   = pick_first(5000000005, 1);
    small = pick_first(250, 1);
    word  = pick_first("alpha", "beta");
    println("picked {} {} {}", big, small, word);

    // explicit spelling at one site
    wide = pick_first<i64>(9000000007, 2);
    println("wide {}", wide);

    lo = snd(5000000003, 245);
    hi = snd(245, 5000000003);
    println("snd {} {}", lo, hi);

    w2 = snd("gamma", 81);
    println("snd-str {}", w2);
    Ok(0);
}
