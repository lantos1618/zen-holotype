// The second escape route, and the one a return-type rule alone would miss:
// a struct outlives the call that filled it, so a pack in a field is a borrow
// with no bound on its lifetime at all.
//
// Refused by the position rule rather than by a rule about structs, which is
// the point of stating the rule on the TYPE: one scan answers the return
// type, the field, the type argument and the non-last parameter at once.
//
// position: the `vararg` in the field's type.

Bag = {
    held: vararg<i32>,
}

main = (env: Env) Res<i32, AllocError> {
    println("{}", Bag(held: 0).held.len);
    Ok(0);
}
