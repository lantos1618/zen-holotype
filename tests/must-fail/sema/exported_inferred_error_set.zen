// law 6: `*` means this name crosses a module boundary, and therefore
// its type is written, not inferred. an inferred error set on an
// exported function is exactly the case the law names.
//
// position: the inferred set.

CfgError = Missing | Bad

read_cfg* = (s: str) Res<i32, _> {
    (s == "7").match({
        true  => Ok(7),
        false => Err(CfgError.Bad),
    })
}

main = (env: Env) Res<i32, CfgError> {
    println("{}", read_cfg("7").try());
    Ok(0);
}
