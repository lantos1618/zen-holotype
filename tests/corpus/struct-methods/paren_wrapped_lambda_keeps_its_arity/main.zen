W = {
    v: i32,
    run = (self: @Self, f: (x: i32) i32) i32 { f(self.v) + 10 }
    run = (self: @Self, f: (x: i32, y: i32) i32) i32 {
        f(self.v, 2) + 20
    }
}

main = (env: Env) Res<i32, AllocError> {
    w = W(v: 3);
    println("bare {}", w.run((x: i32) i32 { x }));
    println("wrapped {}", w.run(((x: i32, y: i32) i32 { x * y })));
    Ok(0);
}
