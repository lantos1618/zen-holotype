// `+` binds tighter than `<`: 1 + 1 < 3 is (1 + 1) < 3.
// the other reading, 1 + (1 < 3), does not type-check.
// NOTE: `<` and `==` are the only comparisons DESIGN.md writes down.

main = (env: Env) Res<i32, ArgError> {
    (1 + 1 < 3).match({
        true => println("yes"),
        false => println("no"),
    });
    Ok(0);
}
