Link = {
    value: i64,
    next: Ptr<Link>,
}

build = (alloc: Alloc, n: i64) Link {
    cell = alloc.create<Link>().try();
    inner = build(alloc, n - 1).match({
        Ok(h)  => h,
        Err(_) => Link(value: -1, next: null_ptr<Link>()),
    });
    cell.write(0, inner);
    Link(value: n * 10, next: cell);
}

main = (env: Env) Res<i32, AllocError> {
    Ok(0);
}
