// js_narrow_trunc_battery.zen — dual-backend PER-OPERATION narrow-int truncation cross-check. Sibling of
// js_width_battery (boundary masks) and js_int64_battery (BigInt): here a narrow-int (i8/i16/i32, u8/u16/
// u32) `*`/`+`/`-` INTERMEDIATE overflows i32, and a following `%`/`/`/chained op must read the WRAPPED
// value — as C does at every step (-fwrapv). Before the per-op mask, the js backend only wrapped at the
// outermost op / at a typed boundary, so the inner double leaked and diverged (`a*b%1000` → 0 vs C's -968).
//   C:  zen run   tests/fixtures/zen/js_narrow_trunc_battery.zen
//   JS: zen build --target js tests/fixtures/zen/js_narrow_trunc_battery.zen -o /tmp/b.js && node /tmp/b.js
{ println } = std.text.fmt
main = () i32 {
    a: i32 = 1000000
    b: i32 = 1000000
    println(a * b % 1000)    // (a*b) wraps to i32 BEFORE %1000 -> -968 (was 0)
    c: i32 = 100000
    d: i32 = 100000
    println(c * d / 1000)    // (c*d) wraps to i32 BEFORE /1000 -> 1410065 (was 10000000)
    println(c * d + c * d)    // chained: each c*d wraps, sum wraps again -> -1474836480
    e: u32 = 100000
    println(e * e % 7)    // u32 product wraps, then % -> 3
    f: u16 = 60000
    g: u16 = 60000
    println(f * g % 1000)    // u16 product masked to 16 bits before % -> 120
    h: i16 = 200
    i: i16 = 200
    println(h * i)
    0
}    // i16 product sign-truncates -> -25536
