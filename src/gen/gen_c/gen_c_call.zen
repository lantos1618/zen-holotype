// src/gen/gen_c/gen_c_call.zen
// What a call is in C, and what a type a call names becomes.
//
// `Point(x: 3, y: 4)` and `area(p)` are the same AST node. Which one it
// is depends on what the callee NAMES — a struct is constructed, a
// function is called — a question about the declaration, not the call.
// THE QUESTION IS ASKED HERE; construction is `gen_c_build.zen`'s. The
// third thing a callee can name IS here — `Ok`/`Err`, not functions at
// all, built from the expected type.
//
// `Res` IS STRUCTURAL, so its constructors are built here from the
// EXPECTED type, not resolved. This follows sema: `TyRes` carries no
// declaration, because `Res<T>` and `Res<T, E>` are two arities of one
// name that sema disambiguates at every `.try()`. It's also why an
// expectation is needed — `Ok(0)` alone doesn't say `Res<i32>` or
// `Res<i32, E>`, and DESIGN.md's hoisting rule turns on exactly that.
//
// OVERLOAD RESOLUTION IS SEMA'S, READ BACK RATHER THAN REDONE. `Cand`
// carries the `DeclId` it came from, and `chosen` writes it into
// `Checker.call_memo` under the call's node id, so `loop`'s six
// declarations arrive here as a decision, not an ambiguity. A name with
// more than one declaration and NO recorded answer is still reported: a
// backend guessing would be a second, worse copy of sema's resolution
// rule.
//
// THE TYPE FALLBACK LIVES HERE for the same reason: sema doesn't type a
// call yet, so it doesn't type a `.try()` on one either, and only the
// place that already resolves callees can answer. The fallback stops
// firing the moment sema types a call.

Ast, Expr, ExprKind, ExprId, BlockId, Block, Stmt, StmtKind, Bind = ast
Decl, DeclKind, Struct, Member, MemberKind, Function = ast
Literal, LiteralKind, BinOp, UnOp, Binary, Unary, Match, Arm = ast
Pattern, PatternKind, Access, Call, Arg, Span, Ident = ast
Param, TypeId = ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
DeclId = sema.sema_id
TyId, Ty, Types, TyNamed, TyRes, ResForm = sema.sema_ty
World, Def, DefKind, decl_at = sema.sema_def
Checker, Ctx = sema.sema_check
Inst = sema.sema_inst
type_of, type_from_ast, stmt_type = sema.sema_type
satisfies_bound = sema.sema_bound
write_usize = sema.sema_diag
Emit = gen.gen_emit
sym_local, sym_member, sym_variant, sym_gen, sym_fn = gen.gen_name
RES_PATH, is_failure = gen.gen_name
GenFault = gen.gen_diag
CBackend = gen.gen_c.gen_c_state
LocalSlot = gen.gen_c.gen_c_frame
unsupported, unresolved, untyped, ambiguous = gen.gen_c.gen_c_report
sub, sub_with, open, any_open, inst_at = gen.gen_c.gen_c_mono
settled_inst, inst_open, enter_tparams, leave_tparams = gen.gen_c.gen_c_mono
complete_inst, call_ret_type = gen.gen_c.gen_c_infer
constructed, intern_named, recv_inst = gen.gen_c.gen_c_mono
lower_match = gen.gen_c.gen_c_flow
lower_try = gen.gen_c.gen_c_try
ctype, declarator, spellable, is_unit, c_prim = gen.gen_c.gen_c_type
is_c_integer, is_signed, variant_type, decl_ctx = gen.gen_c.gen_c_type
c_prim_known = gen.gen_c.gen_c_type
write_qname = gen.gen_c.gen_c_layout
field_type, request_type = gen.gen_c.gen_c_type
expr, ty_of, want_of = gen.gen_c.gen_c_expr
Dest, deliver = gen.gen_c.gen_c_stmt
is_print, lower_print = gen.gen_c.gen_c_print
lower_dot_call = gen.gen_c.gen_c_member
lower_loop = gen.gen_c.gen_c_loop
is_loop_shape = gen.gen_c.gen_c_shape
inlines, inline_call, closure_slot = gen.gen_c.gen_c_inline
is_null_ptr, lower_null_ptr = gen.gen_c.gen_c_ptr
lower_closure_call = gen.gen_c.gen_c_inline
construct = gen.gen_c.gen_c_build
is_format_door, lower_format_door = gen.gen_c.gen_c_fmt

// -----------------------------------------------------------------
// `Res` values
// -----------------------------------------------------------------

res_value* = (be :: CBackend, id: ExprId, want: TyId, variant: str,
             out :: String) Res<(), AllocError> {
    be.check.types.at(want).match({
        Res(_) => write_res_tagged(be, want, variant, out),
        _      => untyped(be, id, variant, out),
    })
}

write_res_tagged = (be :: CBackend, want: TyId, variant: str, out :: String)
                   Res<(), AllocError> {
    out.add_bytes("(").try();
    ctype(be, want, out).try();
    out.add_bytes("){ .zg_tag = ").try();
    out.sym_variant(RES_PATH, variant).try();
    out.add_bytes(" }").try();
    Ok(());
}

// `Ok(x)` / `Err(e)`: the tag, and the payload under the member the
// variant names. A unit payload takes no member — `Ok(())` carries
// nothing and a void member is illegal C.
//
// A UNIT PAYLOAD IS STILL EVALUATED: `Ok(f())` on a unit-returning `f`
// carries nothing but DOES something, and writing only the tag would
// drop the call. The literal `()` is the one case with nothing to run.
//
// EXPORTED BECAUSE HOISTING BUILDS THE SAME VALUE: `7;` closing a
// `Res<i32, E>` is `Ok(7)`, the same tag over the same payload —
// `gen_c_hoist.zen` writing its own copy would be two places holding
// one layout decision.
write_res_payload* = (be :: CBackend, id: ExprId, want: TyId, variant: str,
                      value: ExprId, payload: TyId, ctx: Ctx, out :: String)
                     Res<(), AllocError> {
    is_unit(be, payload).match({
        false => Ok(()),
        true  => run_for_effect(be, value, payload, ctx),
    }).try();
    out.add_bytes("(").try();
    ctype(be, want, out).try();
    out.add_bytes("){ .zg_tag = ").try();
    out.sym_variant(RES_PATH, variant).try();
    is_unit(be, payload).match({
        true  => Ok(()),
        false => write_payload_init(be, variant, value, payload, ctx, out),
    }).try();
    out.add_bytes(" }").try();
    Ok(());
}

run_for_effect = (be :: CBackend, value: ExprId, payload: TyId, ctx: Ctx)
                 Res<(), AllocError> {
    writes_nothing(be, value).match({
        true  => Ok(()),
        false => deliver(be, value, ctx, payload, Dest.Discard),
    })
}

writes_nothing = (be: CBackend, value: ExprId) bool {
    be.tree.expr_at(value).kind.match({ Unit => true, _ => false })
}

write_payload_init = (be :: CBackend, variant: str, value: ExprId,
                      payload: TyId, ctx: Ctx, out :: String)
                     Res<(), AllocError> {
    out.add_bytes(", .zg_data.").try();
    out.sym_member(variant).try();
    out.add_bytes(" = ").try();
    expr(be, value, ctx, payload, out).try();
    Ok(());
}

// THE THREE CALLEE FORMS. A bare name is a function or a type; a dot is
// `gen_c_member.zen`'s subject; anything else is a callable value, and
// the general form lowers the callee and calls through it.
lower_call* = (be :: CBackend, id: ExprId, c: Call, ctx: Ctx, want: TyId,
              out :: String) Res<(), AllocError> {
    be.tree.expr_at(c.callee).kind.match({
        Name(n)   => lower_name_callee(be, id, c, n.text, ctx, want, out),
        Access(a) => lower_dot_call(be, id, c, a, ctx, want, out),
        _         => lower_indirect(be, id, c, ctx, out),
    })
}

// A NAME BOUND TO A LAMBDA IS NOT A CALL THROUGH A VALUE: `f(x)` where
// `f` was handed a closure is the closure's own body, inlined here — a
// non-escaping stack closure has no closure record to box, so a
// function-typed parameter has no C storage to call through.
lower_name_callee = (be :: CBackend, id: ExprId, c: Call, name: str,
                     ctx: Ctx, want: TyId, out :: String)
                    Res<(), AllocError> {
    closure_slot(be, name).match({
        Ok(s) => lower_closure_call(be, id, c, s, ctx, want, out),
        None  => lower_named_call(be, id, c, name, ctx, want, out),
    })
}

// A callee that is neither a name nor a dot: lower the expression, then
// call through it. The callee's type says how many arguments it takes
// and what they are, so a callee sema couldn't type is REPORTED rather
// than called with a guessed signature.
lower_indirect = (be :: CBackend, id: ExprId, c: Call, ctx: Ctx,
                  out :: String) Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    fty = ty_of(be, c.callee, ctx, unknown).try();
    be.check.types.at(fty).match({
        Fn(f) => write_indirect(be, c, f.params, ctx, out),
        _     => unsupported(be, id, "a call through a value that is not a function", out),
    })
}

write_indirect = (be :: CBackend, c: Call, params: Vec<TyId>, ctx: Ctx,
                  out :: String) Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    out.add_bytes("(").try();
    expr(be, c.callee, ctx, unknown, out).try();
    out.add_bytes(")(").try();
    c.args.loop((h, i, a) {
        (i > 0).then(() { out.add_bytes(", ").try() });
        write_indirect_arg(be, a, i, params, ctx, out).try();
    });
    out.add_bytes(")").try();
    Ok(());
}

// A callee that is a VALUE has a `TyFn` and no `Param` list, so there is
// no `::` to read: a function type carries types and not binding
// markers. Everything goes by value, which is what a `TyFn` means.
write_indirect_arg = (be :: CBackend, a: Arg, i: usize, params: Vec<TyId>,
                      ctx: Ctx, out :: String) Res<(), AllocError> {
    want = params.get(i).match({ Ok(t) => t, None => TyId(index: 0) });
    expr(be, a.value, ctx, want, out)
}

lower_named_call = (be :: CBackend, id: ExprId, c: Call, name: str, ctx: Ctx,
                    want: TyId, out :: String) Res<(), AllocError> {
    is_res_ctor(name).match({
        true  => lower_res_ctor(be, id, c, name, ctx, want, out),
        false => lower_sugar_or_plain(be, id, c, name, ctx, out),
    })
}

// `println` is checked BEFORE resolution, only when nothing declares it:
// the sugar names no function, so there's nothing for the walk to find,
// but a module declaring its own `println` means that. `gen_c_print.zen`
// says why the `Env`-in-scope half of the law isn't enforced here.
lower_sugar_or_plain = (be :: CBackend, id: ExprId, c: Call, name: str,
                        ctx: Ctx, out :: String) Res<(), AllocError> {
    is_sugar(be, name, ctx).try().match({
        true  => lower_print(be, c, name, ctx, out),
        false => lower_plain_call(be, id, c, name, None, ctx, out),
    })
}

is_sugar = (be :: CBackend, name: str, ctx: Ctx) Res<bool, AllocError> {
    is_print(name).match({
        false => Ok(false),
        true  => undeclared(be, name, ctx),
    })
}

undeclared = (be :: CBackend, name: str, ctx: Ctx) Res<bool, AllocError> {
    found ::= be.alloc.Vec<Def>();
    be.check.world.defs_of(ctx.module, name, found).try();
    Ok(found.len == 0);
}

is_res_ctor* = (name: str) bool { name.eq("Ok") || name.eq("Err") }

lower_res_ctor = (be :: CBackend, id: ExprId, c: Call, name: str, ctx: Ctx,
                  want: TyId, out :: String) Res<(), AllocError> {
    be.check.types.at(want).match({
        Res(r) => lower_res_arg(be, id, c, name, r, ctx, want, out),
        _      => untyped(be, id, name, out),
    })
}

lower_res_arg = (be :: CBackend, id: ExprId, c: Call, name: str, r: TyRes,
                 ctx: Ctx, want: TyId, out :: String) Res<(), AllocError> {
    payload = name.eq("Ok").match({ true => r.value, false => r.error });
    c.args.get(0).match({
        None  => write_res_tagged(be, want, name, out),
        Ok(a) => write_res_payload(be, id, want, name, a.value, payload, ctx, out),
    })
}

// `recv` is the receiver a UFCS call reached this name through — "a free
// function whose first param is the type is callable as a method", so
// the receiver is argument zero and there is no second mechanism.
// `None` is the ordinary `f(a)`.
lower_plain_call* = (be :: CBackend, id: ExprId, c: Call, name: str,
                     recv: Res<ExprId>, ctx: Ctx, out :: String)
                    Res<(), AllocError> {
    found ::= be.alloc.Vec<Def>();
    be.check.world.defs_of(ctx.module, name, found).try();
    travelled_defs(be, name, recv, ctx, found).try();
    be.check.resolved_call(id).match({
        Ok(d) => chosen_def(be, id, c, name, found, d, recv, ctx, out),
        None  => sole_def(be, id, c, name, found, recv, ctx, out),
    })
}

// THE FUNCTIONS THAT TRAVELLED WITH THE RECEIVER'S TYPE — THE SAME POOL
// SEMA RESOLVED AGAINST. `sema_call.travelled_cands` is the other half;
// the two must agree or `resolved_call` names a declaration this list
// doesn't hold and the fallback re-decides it.
//
// Only a dot asks (`recv` is `None` for `f(a)`), and only a function
// whose FIRST PARAMETER is the receiver's own type answers. Without it
// `to_usize` — on no prelude line, a method on every integer — resolves
// to nothing.
travelled_defs = (be :: CBackend, name: str, recv: Res<ExprId>, ctx: Ctx,
                  found :: Vec<Def>) Res<(), AllocError> {
    recv.match({
        Ok(r) => travelled_for(be, name, r, ctx, found),
        None  => Ok(()),
    })
}

travelled_for = (be :: CBackend, name: str, r: ExprId, ctx: Ctx,
                 found :: Vec<Def>) Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    rty = ty_of(be, r, ctx, unknown).try();
    defs ::= be.alloc.Vec<Def>();
    be.check.world.exported_named(name, defs).try();
    defs.loop((h, d) { keep_travelled(be, d, rty, found).try() });
    Ok(());
}

keep_travelled = (be :: CBackend, d: Def, rty: TyId, found :: Vec<Def>)
                 Res<(), AllocError> {
    dup = has_def(found, d.id);
    dup.match({
        true  => Ok(()),
        false => add_receiving(be, d, rty, found),
    })
}

add_receiving = (be :: CBackend, d: Def, rty: TyId, found :: Vec<Def>)
                Res<(), AllocError> {
    receives(be, d, rty).try().match({
        true  => found.add(d),
        false => Ok(()),
    })
}

// Is the receiver this declaration's first parameter? Read off the
// DECLARED type, uninstantiated — so `(self: u32)` answers and
// `<T>(self: T)` does not, which is right: a bare parameter would
// swallow every receiver in the program.
receives = (be :: CBackend, d: Def, rty: TyId) Res<bool, AllocError> {
    inst ::= be.alloc.Inst();
    sig ::= be.alloc.Vec<TyId>();
    ok = signature_of(be, d, inst, sig).try();
    ok.match({ false => Ok(false), true => first_is(be, sig, rty) })
}

// `satisfies_bound` — an impl of the declared type, or the same type —
// is `sema_cand.takes_receiver`'s gate spelled again, since this is the
// second half of ONE pool. An `Arena` reaches `Vec* = <T>(a: Alloc)
// Vec<T>` through `Arena.impl(Alloc, ..)`; a pool narrower than sema's
// holds no declaration for what `resolved_call` wrote down, so
// `sole_def` re-decides an already-settled call and calls it not a
// function at all.
first_is = (be :: CBackend, sig: Vec<TyId>, rty: TyId)
           Res<bool, AllocError> {
    sig.get(0).match({
        None  => Ok(false),
        Ok(t) => satisfies_bound(be.check, rty, t),
    })
}

has_def = (found: Vec<Def>, id: DeclId) bool {
    Range(0, found.len).find((i) {
        found.get(i).match({ Ok(d) => d.id.eq(id), None => false })
    }).match({ Ok(_) => true, None => false })
}

// SEMA ALREADY ANSWERED THIS: `resolved_call` is the declaration
// overload resolution picked, keyed on this node, so six declarations
// of `loop` are candidates sema already chose between, not an ambiguity
// to re-discover.
chosen_def = (be :: CBackend, id: ExprId, c: Call, name: str,
              found: Vec<Def>, want: DeclId, recv: Res<ExprId>, ctx: Ctx,
              out :: String) Res<(), AllocError> {
    def_with_id(found, want).match({
        Ok(d) => call_kind(be, id, c, d, recv, ctx, out),
        None  => sole_def(be, id, c, name, found, recv, ctx, out),
    })
}

// The candidate sema resolved to. Read out of the queue's own
// entries, so a query and a lowering that both start from the same
// `resolved_call` cannot disagree about which declaration it named.
def_with_id* = (found: Vec<Def>, want: DeclId) Res<Def> {
    Range(0, found.len).find((i) {
        found.get(i).match({ Ok(d) => d.id.eq(want), None => false })
    }).match({
        Ok(i) => found.get(i),
        None  => None,
    })
}

// Nothing resolved this node, so the only choice a backend may make is
// the one with nothing to choose: exactly one declaration. Picking
// between candidates here is the guess the whole seam exists to avoid.
sole_def = (be :: CBackend, id: ExprId, c: Call, name: str, found: Vec<Def>,
            recv: Res<ExprId>, ctx: Ctx, out :: String)
           Res<(), AllocError> {
    found.len.match({
        0 => unresolved(be, id, name, out),
        1 => call_def(be, id, c, name, found, recv, ctx, out),
        _ => ambiguous(be, id, name, out),
    })
}

call_def = (be :: CBackend, id: ExprId, c: Call, name: str, found: Vec<Def>,
            recv: Res<ExprId>, ctx: Ctx, out :: String)
           Res<(), AllocError> {
    found.get(0).match({
        None  => unresolved(be, id, name, out),
        Ok(d) => call_kind(be, id, c, d, recv, ctx, out),
    })
}

// Same node, decided by what the callee names — a struct is
// constructed, a function is called.
call_kind = (be :: CBackend, id: ExprId, c: Call, d: Def, recv: Res<ExprId>,
             ctx: Ctx, out :: String) Res<(), AllocError> {
    d.kind.match({
        FunctionDef => call_resolved(be, id, c, d, recv, ctx, out),
        StructDef   => construct(be, id, c, d, ctx, out),
        _           => unsupported(be, id, "a call to something that is not a function", out),
    })
}

// The symbol is built from the DECLARATION's parameter types, making two
// overloads of a name two symbols. Read back out of the AST because
// sema doesn't yet answer "what is this function's type" — the seam
// closes when it does.
call_resolved = (be :: CBackend, id: ExprId, c: Call, d: Def,
                 recv: Res<ExprId>, ctx: Ctx, out :: String)
                Res<(), AllocError> {
    decl_at(be.tree, d.id).match({
        None  => unsupported(be, id, "a call to something that is not a plain function", out),
        Ok(x) => call_decl(be, id, c, d, x, recv, ctx, out),
    })
}

call_decl = (be :: CBackend, id: ExprId, c: Call, d: Def, x: Decl,
             recv: Res<ExprId>, ctx: Ctx, out :: String)
            Res<(), AllocError> {
    x.kind.match({
        Function(f) => call_fn(be, id, c, d, f, recv, ctx, out),
        _           => unsupported(be, id, "a call to something that is not a plain function", out),
    })
}

// THE LOOP INTRINSIC IS DECIDED BEFORE THE SIGNATURE IS READ, because
// there's no signature to read: `loop_iter.zen`'s six declarations have
// no bodies, and their type parameters are reachable only through the
// closure, which infers FROM a signature rather than settling one. Not
// an inference failure — it's the construct whose body this backend is.
call_fn = (be :: CBackend, id: ExprId, c: Call, d: Def, f: Function,
           recv: Res<ExprId>, ctx: Ctx, out :: String) Res<(), AllocError> {
    is_loop_shape(be, f).match({
        true  => lower_loop(be, id, c, f, recv, ctx, want_of(be, id, ctx).try(), out),
        false => call_or_inline(be, id, c, d, f, recv, ctx, out),
    })
}

// A CALLEE HANDED A LAMBDA IS INLINED RATHER THAN CALLED, not an
// optimisation: a `() T` parameter has no C spelling, so there's no
// symbol to emit and nothing to pass. `gen_c_inline.zen` is the general
// case the loop intrinsic is the special one of.
call_or_inline = (be :: CBackend, id: ExprId, c: Call, d: Def, f: Function,
                  recv: Res<ExprId>, ctx: Ctx, out :: String)
                 Res<(), AllocError> {
    inlines(be, c, f).match({
        true  => inline_call(be, id, c, d, f, recv, ctx, out),
        false => call_or_floor(be, id, c, d, f, recv, ctx, out),
    })
}

// `null_ptr<T>()` is a free function with no body, and the backend is
// its body — the same bargain `mem_ptr.zen`'s nine members strike, the
// one place a Ptr is made rather than used.
call_or_floor = (be :: CBackend, id: ExprId, c: Call, d: Def, f: Function,
                 recv: Res<ExprId>, ctx: Ctx, out :: String)
                Res<(), AllocError> {
    is_null_ptr(d.name).match({
        true  => lower_null_ptr(be, id, want_of(be, id, ctx).try(), out),
        false => call_or_format(be, id, c, d, f, recv, ctx, out),
    })
}

// `alloc.String("{}", x)` is a bodyless variadic declaration and the
// backend is its body, for the same reason: a variadic parameter has no
// C spelling and `{}` resolves by the argument's type, so there's
// nothing one body could have been.
call_or_format = (be :: CBackend, id: ExprId, c: Call, d: Def, f: Function,
                  recv: Res<ExprId>, ctx: Ctx, out :: String)
                 Res<(), AllocError> {
    is_format_door(be, d, f).match({
        true  => lower_format_door(be, id, c, d, f, recv, ctx, out),
        false => call_or_convert(be, id, c, d, f, recv, ctx, out),
    })
}

// `to_u64* = (self: u8) u64` is a signature with no body — `std.core.num`
// says why: "conversions are methods, never a cast keyword", and a cast
// can't be written in terms of anything below it, so the backend is the
// body.
//
// EMITTING THE CALL INSTEAD IS A LINKER ERROR, not a wrong answer: a
// bodyless declaration defines no symbol. That's how this was found —
// closing `to_usize`'s RESOLUTION without closing its BODY moved the
// fault rather than fixing it.
//
// ONLY LOSSLESS WIDENING IS DECLARED, so the cast is the whole of it,
// nothing to check. A narrowing conversion "can fail, so it belongs in
// a Res-returning function someone writes on purpose" — such a
// function has a body and never reaches here.
call_or_convert = (be :: CBackend, id: ExprId, c: Call, d: Def, f: Function,
                   recv: Res<ExprId>, ctx: Ctx, out :: String)
                  Res<(), AllocError> {
    convert_target(d, f).match({
        Ok(t) => lower_convert(be, c, d, t, recv, ctx, out),
        None  => call_signature(be, id, c, d, f, recv, ctx, out),
    })
}

// The primitive a bodyless one-parameter `to_<prim>` names. Asked of
// the DECLARATION and not of the name alone: a module's own `to_thing`
// with a body is its own function and is called like any other.
convert_target = (d: Def, f: Function) Res<str> {
    convert_shape(f).match({
        false => None,
        true  => keep_prim(after_to(d.name)),
    })
}

convert_shape = (f: Function) bool {
    bodyless(f) && (f.params.len == 1) && (f.tparams.len == 0)
}

bodyless = (f: Function) bool {
    f.body.match({ Ok(_) => false, None => true })
}

after_to = (name: str) str {
    ((name.len > 3) && name.slice(0, 3).eq("to_")).match({
        true  => name.slice(3, name.len),
        false => "",
    })
}

keep_prim = (target: str) Res<str> {
    c_prim_known(target).match({ true => Ok(target), false => None })
}

// The receiver, or the sole written argument: `b.to_u64()` and
// `to_u64(b)` are one call written two ways, which is what UFCS means.
lower_convert = (be :: CBackend, c: Call, d: Def, target: str,
                 recv: Res<ExprId>, ctx: Ctx, out :: String)
                Res<(), AllocError> {
    recv_arg(c, recv).match({
        None  => out.add_bytes("0"),
        Ok(v) => write_convert(be, d, v, target, ctx, out),
    })
}

// ARGUMENT ZERO OF THE SIGNATURE: the receiver when the call was
// written `x.f(..)`, and the first written argument when it was written
// `f(x, ..)`. The same shift `write_call` makes, and the one every
// lowering that reads past the dot needs.
recv_arg* = (c: Call, recv: Res<ExprId>) Res<ExprId> {
    recv.match({
        Ok(r) => Ok(r),
        None  => arg_value(c, 0),
    })
}

arg_value* = (c: Call, i: usize) Res<ExprId> {
    c.args.get(i).match({ Ok(a) => Ok(a.value), None => None })
}

// The operand takes the DECLARED parameter's type, not the target's, so
// a literal argument is written at the width it's converted FROM — the
// width the declaration chose the overload on.
write_convert = (be :: CBackend, d: Def, v: ExprId, target: str, ctx: Ctx,
                 out :: String) Res<(), AllocError> {
    inst ::= be.alloc.Inst();
    sig ::= be.alloc.Vec<TyId>();
    signature_of(be, d, inst, sig).try();
    unknown = be.check.types.unknown().try();
    src = sig.get(0).match({ Ok(t) => t, None => unknown });
    out.add_bytes("(").try();
    out.add_bytes(c_prim(target)).try();
    out.add_bytes(")(").try();
    expr(be, v, ctx, src, out).try();
    out.add_bytes(")").try();
    Ok(());
}

call_signature = (be :: CBackend, id: ExprId, c: Call, d: Def, f: Function,
                  recv: Res<ExprId>, ctx: Ctx, out :: String)
                 Res<(), AllocError> {
    raw = inst_at(be, id).try();
    settled = settled_inst(be, f.tparams, d.qname, raw).try();
    inst = complete_inst(be, c, d, f, settled, recv, ctx).try();
    sig ::= be.alloc.Vec<TyId>();
    ok = signature_of(be, d, inst, sig).try();
    ok.match({
        false => unsupported(be, id, plain_fault(be, d), out),
        true  => call_settled(be, id, c, d, f, sig, inst, recv, ctx, out),
    })
}

// A GENERIC CALL NOTHING SETTLED IS REFUSED, not emitted: a free
// parameter mangles to one letter, so every instantiation would be one
// C symbol and the linker would pick whichever body it saw last — a
// wrong answer with no diagnostic, the one outcome a backend may not
// produce.
call_settled = (be :: CBackend, id: ExprId, c: Call, d: Def, f: Function,
                sig: Vec<TyId>, inst: Inst, recv: Res<ExprId>, ctx: Ctx,
                out :: String) Res<(), AllocError> {
    (inst_open(be, inst) || any_open(be, sig)).match({
        true  => unsupported(be, id, "a generic call whose type arguments nothing settles", out),
        false => call_reachable(be, id, c, d, f, sig, inst, recv, ctx, out),
    })
}

// THE WALK IS REACHABILITY-DRIVEN and this is the edge it follows: a
// call that resolves queues the function it resolved to. Without it a
// translation unit calls symbols nothing defines — `cc` catches it, but
// a compiler shouldn't have emitted it.
//
// THE SYMBOL IS BUILT ONCE, USED TWICE — as the queue's identity and the
// call's text — so "was this already emitted" and "what do I call" are
// the same question. Two `Vec` instantiations are two entries exactly
// when they're two symbols.
call_reachable = (be :: CBackend, id: ExprId, c: Call, d: Def, f: Function,
                  sig: Vec<TyId>, inst: Inst, recv: Res<ExprId>, ctx: Ctx,
                  out :: String) Res<(), AllocError> {
    sym ::= be.alloc.String().try();
    sym_fn(sym, be.check.types, be.check.world, d.qname, sig, inst).try();
    be.need_function(d, inst, sym.view()).try();
    write_call(be, c, d, f, sig, sym.view(), recv, ctx, out)
}

// Which of the things a callee can be that this backend does not lower.
plain_fault = (be :: CBackend, d: Def) str {
    decl_at(be.tree, d.id).match({
        None  => "a call to something that is not a plain function",
        Ok(x) => decl_fault(x),
    })
}

decl_fault = (x: Decl) str {
    x.kind.match({
        Function(_) => "a call to a function whose parameters have no written type",
        _           => "a call to something that is not a plain function",
    })
}

// The declared parameter types of a function, in order, at this
// instantiation. `false` when the declaration isn't a function or a
// parameter has no written type to read.
//
// THE TYPE PARAMETERS GO BACK IN SCOPE around the read: `(v: T)` is a
// written type and `T` means nothing unless bound. Sema bound it while
// checking the declaration and let it go; this asks the same question
// again, later.
signature_of* = (be :: CBackend, d: Def, inst: Inst, sig :: Vec<TyId>)
                Res<bool, AllocError> {
    decl_at(be.tree, d.id).match({
        None  => Ok(false),
        Ok(x) => x.kind.match({
            Function(f) => params_into(be, d, f, inst, sig),
            _           => Ok(false),
        }),
    })
}

params_into = (be :: CBackend, d: Def, f: Function, inst: Inst,
               sig :: Vec<TyId>) Res<bool, AllocError> {
    mark = enter_tparams(be, f.tparams, d.qname).try();
    ok = collect_params(be, d, f.params, inst, sig).try();
    leave_tparams(be, mark).try();
    Ok(ok);
}

plain* = (f: Function) bool { f.tparams.len == 0 }

collect_params = (be :: CBackend, d: Def, params: Vec<Param>, inst: Inst,
                  sig :: Vec<TyId>) Res<bool, AllocError> {
    ctx = Ctx(module: d.id.module.to_usize(), ret: TyId(index: 0),
              has_ret: false, self_ty: TyId(index: 0), has_self: false);
    params.loop((h, p) {
        p.type.match({
            Ok(t) => add_param(be, t, ctx, inst, sig),
            None  => Ok(()),
        }).try();
    });
    Ok(sig.len == params.len);
}

// The declared type, then the instantiation. One substitution, not two:
// a declared parameter mentions only the CALLEE's parameters, and
// `settled_inst` already put the caller's answers into the arguments —
// what comes out is already in the caller's terms.
add_param = (be :: CBackend, t: TypeId, ctx: Ctx, inst: Inst,
             sig :: Vec<TyId>) Res<(), AllocError> {
    declared = be.check.type_from_ast(t, ctx).try();
    sig.add(sub_with(be, declared, inst).try())
}

write_call = (be :: CBackend, c: Call, d: Def, f: Function, sig: Vec<TyId>,
              sym: str, recv: Res<ExprId>, ctx: Ctx, out :: String)
             Res<(), AllocError> {
    out.add_bytes(sym).try();
    out.add_bytes("(").try();
    first = write_receiver(be, recv, f, sig, ctx, out).try();
    c.args.loop((h, i, a) {
        (i + first > 0).then(() { out.add_bytes(", ").try() });
        write_arg(be, a.value, i + first, f, sig, ctx, out).try();
    });
    out.add_bytes(")").try();
    Ok(());
}

// The receiver a ufcs call arrived through, as argument zero. The answer
// is how many arguments were written, which is what shifts the rest of
// them one place along their own signature.
write_receiver = (be :: CBackend, recv: Res<ExprId>, f: Function,
                  sig: Vec<TyId>, ctx: Ctx, out :: String)
                 Res<usize, AllocError> {
    recv.match({
        None     => Ok(0),
        Ok(base) => write_recv_expr(be, base, f, sig, ctx, out),
    })
}

write_recv_expr = (be :: CBackend, base: ExprId, f: Function,
                   sig: Vec<TyId>, ctx: Ctx, out :: String)
                  Res<usize, AllocError> {
    write_arg(be, base, 0, f, sig, ctx, out).try();
    Ok(1);
}

// An argument to a `::` parameter is passed BY ADDRESS: `::` says the
// callee writes the caller's own bytes, so there has to be an address
// to write through. Every such argument is a binding or a place —
// exactly what C's `&` takes.
write_arg* = (be :: CBackend, value: ExprId, i: usize, f: Function,
              sig: Vec<TyId>, ctx: Ctx, out :: String)
             Res<(), AllocError> {
    want = sig.get(i).match({ Ok(t) => t, None => TyId(index: 0) });
    by_ref(f, i).match({
        false => expr(be, value, ctx, want, out),
        true  => write_address(be, value, ctx, want, out),
    })
}

by_ref* = (f: Function, i: usize) bool {
    f.params.get(i).match({ Ok(p) => p.mutable, None => false })
}

// A `::` parameter is handed the ADDRESS of its argument, and that is
// true of an inlined body's argument too — `gen_c_inline.zen` writes the
// same `&(..)` for the same reason.
write_address* = (be :: CBackend, value: ExprId, ctx: Ctx, want: TyId,
                  out :: String) Res<(), AllocError> {
    out.add_bytes("&(").try();
    expr(be, value, ctx, want, out).try();
    out.add_bytes(")").try();
    Ok(());
}
