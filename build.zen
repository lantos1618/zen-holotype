// Build graph for the self-hosted compiler.

Builder, BuildError, Dep = std.build

build = (b :: Builder) Res<(), BuildError> {
    deps ::= b.alloc.Vec<Dep>();
    socket = b.lib("socket", {
        src: Path("src/std/net/socket/socket.zen"),
        libs: [],
        paths: [],
    }).try();
    tls    = b.lib("tls", {
        src: Path("src/std/net/tls/tls.zen"),
        libs: ["ssl", "crypto"],
        paths: [],
    }).try();
    deps.add(socket).try();
    deps.add(tls).try();
    b.exe("zen", {
        src: Path("src/zen/zen.zen"),
        deps: deps,
    }).try();
    Ok(())
}
