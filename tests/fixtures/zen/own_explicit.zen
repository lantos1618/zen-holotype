halloc = std.mem.heap
{ Resource, new_in } = std.mem.own
{ expect } = std.core.result
main = () i32 {
    alloc := halloc.gpa()
    o := alloc
        .addr()
        .new_in(Resource(
            id: 7,
            slot: 0,
        ))
        .expect("own_explicit: allocation failed")
    n := o.get().id
    o.release_in(alloc.addr())
    n
}
