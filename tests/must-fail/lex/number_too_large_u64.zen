// literals past u64.MAX, which fit no integer type at all: the lexer cannot
// hold them in a u64 accumulator.
//
// 20000000000000000000 is twenty digits, exactly as many as u64.MAX, so a
// lexer that rejected on DIGIT COUNT rather than on the accumulator
// overflowing would wrap it silently and still reject the twenty-one-digit
// one. u64.MAX itself stands above them and `.count 2` allows no third
// diagnostic.
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    ok: u64 = 18446744073709551615;
    bad: u64 = 18446744073709551616;
    same_width: u64 = 20000000000000000000;
    println("{} {} {}", ok, bad, same_width);
    Ok(0);
}
