// `/` and `%` are the same precedence and associate LEFT:
// 100 / 7 % 3 is (100 / 7) % 3 = 2, not 100 / (7 % 3) = 100.

main = (env: Env) Res<i32, ArgError> {
    v = 100 / 7 % 3;
    println("{}", v);
    println("{}", 10 + 7 % 3);
    println("{}", 2 + 3 * 4);
    println("{}", 100 / 5 * 2);
    println("{}", 20 - 2 * 3);
    println("{}", (2 + 3) * 4);
    println("{}", 10 - 3 - 2);
    println("{}", -2 + 3);
    Ok(0);
}
