// fmt-gate: `=` aligns across a RUN of consecutive ONE-LINE members, in a struct body and in an
// `.impl(Trait, { … })` block alike. A run is broken by an own-line comment, by a member whose body
// spans lines, by a name-width spread over 20 columns, and by any padding that would push a member's
// line past column 100 — each break restarts the alignment at the following member.
Sink*: {
    put: (self: Ptr<Self>, value: i64) i64,
}
Logger*: {
    level: i64,
    log   = (lg: Logger, kind: i64) i64 { lg.level + kind }
    debug = (lg: Logger) i64 { lg.log(1) }
    info  = (lg: Logger) i64 { lg.log(2) }
    // an own-line comment opens a new group
    warn  = (lg: Logger) i64 { lg.log(3) }
    error = (lg: Logger) i64 { lg.log(4) }
    trace = (lg: Logger) i64 {
        n = lg.log(5)
        n
    }
    audit = (lg: Logger) i64 { lg.log(6) }
    a_name_far_too_long_to_share_a_gutter = (lg: Logger) i64 { lg.log(7) }
    x = (lg: Logger) i64 { lg.log(8) }
    y = (lg: Logger) i64 { lg.log(9) }
}
Logger.impl(Sink, {
    put = (lg: Ptr<Logger>, n: i64) i64 { load(lg).log(n) }
})
Wide*: {
    n: i64,
    at = (w: Wide, first_index: i64, second_index: i64, third_index: i64, fourth: i64) i64 { w.n }
    narrower = (w: Wide) i64 { w.n }
}
main = () i32 {
    lg = Logger(level: 10)
    s = lg.debug() + lg.info() + lg.warn() + lg.error() + lg.trace() + lg.audit()
    t = lg.a_name_far_too_long_to_share_a_gutter() + lg.x() + lg.y()
    w = Wide(n: 1)
    u = w.at(1, 2, 3, 4) + w.narrower() + lg.addr().put(1)
    (s + t + u > 0).then({ 0 }, { 1 })
}
