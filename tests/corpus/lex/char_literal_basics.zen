// char literals: 'a', the escaped quote, the escaped backslash, and
// the whitespace escapes. a char literal is one BYTE (str is bytes).
//
// The escapes are pinned by VALUE, not just by syntax. `same('\n', '\t')`
// alone says "different" whether `\n` decodes to byte 10 or to the letter n,
// so the numeric lines below name the byte each escape must be, and the
// `'\n'` vs `'n'` line goes red the moment an escape decays into its letter.
Error = AllocError | IoError

same = (a: u8, b: u8) str {
    (a == b).match({
        true  => "same",
        false => "different",
    });
}

main = (env: Env) Res<i32, Error> {
    println("{}", same('a', 'a'));
    println("{}", same('a', 'b'));
    println("{}", same('\'', '\''));
    println("{}", same('\\', '\\'));
    println("{}", same('\'', '\\'));
    println("{}", same('\n', '\t'));
    println("{}", same('\n', 'n'));
    println("{}", same('\t', 't'));
    println("{}", same(':', ':'));
    println("{} {} {}", 'a', 'A', '0');
    println("{} {} {}", '\n', '\t', '\\');
    println("{} {}", '\'', ' ');
    Ok(0);
}
