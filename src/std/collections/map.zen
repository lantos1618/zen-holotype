// StringView-keyed hash map. Keys are borrowed and compared by bytes. Rebind maps returned by put;
// copied headers share allocator-owned storage. Use get_opt when absence differs from a default value.
// Allocating operations return Result<_, IoError>; free with the same allocator.
{ Allocator, AllocatorBackend, try_acquire3 } = std.mem.alloc    // explicit allocator trait; try_acquire3 = all-or-nothing 3-buffer acquire
{ Result, IoError, Opt } = std.core.result
{ view } = std.text.str    // byte-wise equality (`==` on strings compares POINTERS) + hashing view
{ fnv1a32 } = std.hash    // shared 32-bit FNV-1a byte fold (centralized in std.hash)
MKey: {
    k: StringView,
}
MIdx: {
    i: i64,
}
Map*<T>: {
    keys: RawPtr<u8>,
    vals: RawPtr<u8>,
    idx: RawPtr<u8>,
    len: i64,
    cap: i64,
    keys = (m: Map<T>) Slice<StringView> {
        // Live view over the LEN live entries (stored compactly in slots [0, len) in insertion
        // order — there is no delete, so no gaps). Sized to `len`, NOT `cap`: a `.loop` over the
        // result iterates only real entries instead of walking the empty/NULL tail of the backing
        // table (which segfaults). The append writers (`append`/`of`) index slot
        // `len` (one past) via raw pointer arithmetic, which ignores the slice's `.len`, so writing
        // the next slot still lands in the cap-sized backing buffer — only `.loop`/`.len` consumers
        // observe the tighter bound.
        slice(m.keys, m.len)
    }
    vals = (m: Map<T>) Slice<T> { slice(m.vals, m.len) }
    keys_all = (m: Map<T>) MutSlice<StringView> {
        // CAP-sized views over the full backing buffers, for the one-past-len APPEND write (slot [len],
        // which is < cap and so in-bounds here, but past the len-sized `keys()`/`vals()` views).
        slice(m.keys, m.cap)
    }
    vals_all = (m: Map<T>) MutSlice<T> { slice(m.vals, m.cap) }
    index = (m: Map<T>) MutSlice<i64> {
        // 2*cap i64 slots: [0,cap) bucket heads, [cap,2*cap) per-entry next links.
        slice(m.idx, m.cap * 2)
    }
    len = (m: Map<T>) i64 { m.len }
    find = (m: Map<T>, k: StringView) i64 {
        // O(1) average: hash to a bucket, walk the chain comparing keys bytewise.
        (m.cap == 0).then({ 0 - 1 }, { mfind(m.keys(), m.index(), m.cap, mhash(k, m.cap), k) })
    }
    set = (m: Map<T>, i: i64, v: T) Map<T> {
        vals ::= m.vals_all()
        vals[i] = v
        m
    }
    get_at = (m: Map<T>, i: i64, dflt: T) T { (i < 0).then({ dflt }, { m.vals()[i] }) }
    get    = (m: Map<T>, k: StringView, dflt: T) T { m.get_at(m.find(k), dflt) }
    get_opt = (m: Map<T>, k: StringView) Opt<T> {
        // The value under k as an option: .Some(v) if present, .None if absent. Unlike `get(k, dflt)`,
        // this distinguishes an absent key from a stored value that happens to equal the default.
        i = m.find(k)
        out: Opt<T> = (i < 0).then({ .None }, { .Some(m.vals()[i]) })
        out
    }
    has = (m: Map<T>, k: StringView) bool { m.find(k) >= 0 }
    grow = (m: Map<T>, a: AllocatorBackend) Result<Map<T>, IoError> {
        cap = m.cap * 2 + 1
        a.try_acquire3(cap * sizeof(MKey), cap * sizeof(T), cap * 2 * sizeof(MIdx)).match ({
            .Ok(bufs) => {
                kp = bufs.b1
                vp = bufs.b2
                ip = bufs.b3
                oldks = m.keys()
                oldvs = m.vals()
                next = Map<T>(
                    keys: kp,
                    vals: vp,
                    idx: ip,
                    len: m.len,
                    cap: cap,
                )
                keys ::= next.keys_all()
                vals ::= next.vals_all()
                oldks.loop((h, i, k) {
                    (i < m.len).match ({
                        true  => {
                            keys[i] = k
                            vals[i] = oldvs[i]
                        },
                        false => {
                            h.break
                        },
                    })
                })
                a.release(m.keys)
                a.release(m.vals)
                a.release(m.idx)
                ok: Result<Map<T>, IoError> = .Ok(next.reindex())
                ok
            },
            .Err(e)   => {
                err: Result<Map<T>, IoError> = .Err(e)
                err
            },
        })
    }
    reindex = (m: Map<T>) Map<T> {
        // Rebuild the hash index from the live key column. O(len).
        ix ::= m.index()
        cap = m.cap
        ix.loop((h, i, v) {
            // clear all bucket heads to -1
            (i < cap).match ({
                true  => {
                    ix[i] = 0 - 1
                },
                false => {
                    h.break
                },
            })
        })
        ks = m.keys()
        ks.loop((h, i, k) {
            (i < m.len).match ({
                true  => {
                    b = mhash(k, cap)
                    ix[cap + i] = ix[b]
                    ix[b] = i
                },
                false => {
                    h.break
                },
            })
        })
        m
    }
    link = (m: Map<T>, slot: i64) Map<T> {
        // Append a key/val pair (caller has ensured the key is absent) and link it into its bucket.
        ix ::= m.index()
        b = mhash(m.keys()[slot], m.cap)
        ix[m.cap + slot] = ix[b]
        ix[b] = slot
        m
    }
    append = (m: Map<T>, a: AllocatorBackend, k: StringView, v: T) Result<Map<T>, IoError> {
        k = k
        v = v
        out: Result<Map<T>, IoError> = (m.len < m.cap).match ({
            true  => {
                keys ::= m.keys_all()
                vals ::= m.vals_all()
                keys[m.len] = k
                vals[m.len] = v
                ok: Result<Map<T>, IoError> = .Ok(Map<T>(
                    keys: m.keys,
                    vals: m.vals,
                    idx: m.idx,
                    len: m.len + 1,
                    cap: m.cap,
                ).link(m.len))
                ok
            },
            false => {
                m.grow(a).match ({
                    .Ok(next) => {
                        keys ::= next.keys_all()
                        vals ::= next.vals_all()
                        keys[next.len] = k
                        vals[next.len] = v
                        ok: Result<Map<T>, IoError> = .Ok(Map<T>(
                            keys: next.keys,
                            vals: next.vals,
                            idx: next.idx,
                            len: next.len + 1,
                            cap: next.cap,
                        ).link(next.len))
                        ok
                    },
                    .Err(e)   => {
                        err: Result<Map<T>, IoError> = .Err(e)
                        err
                    },
                })
            },
        })
        out
    }
    put = (m: Map<T>, a: AllocatorBackend, k: StringView, v: T) Result<Map<T>, IoError> {
        // Insert or upsert (allocation failure is a value). RETURNS the updated map — always rebind to
        // the result (`m = m.put(...).expect("…")`). On grow the buffers are realloced, so any handle
        // captured before this call dangles (see the VALUE-MOLD CONTRACT above). On an existing key the
        // value is overwritten IN PLACE, so the new value is visible through every header that shares
        // this map's storage; `clone` first for an independent copy.
        i = m.find(k)
        out: Result<Map<T>, IoError> = (i < 0).match ({
            true  => m.append(a, k, v),
            false => {
                next = m.set(i, v)
                ok: Result<Map<T>, IoError> = .Ok(next)
                ok
            },
        })
        out
    }
    free = (m: Map<T>, a: AllocatorBackend) void {
        a.release(m.keys)
        a.release(m.vals)
        a.release(m.idx)
    }
    clone = (m: Map<T>, a: AllocatorBackend) Result<Map<T>, IoError> {
        // Deep-copy the map into fresh buffers from `a`, giving the result INDEPENDENT storage: mutating
        // the clone (or the original) never writes through to the other. This is the tool for value
        // semantics the by-value header doesn't provide on its own — clone before handing a Map to a child
        // scope that must not corrupt its parent. Keys stay BORROWED (the pointers are copied, not the
        // bytes — same outlives-the-map rule as everywhere else); values are copied by value. The clone
        // owns its buffers and must be `free`d independently. O(len). Allocation failure is a value: OOM on
        // any of the three acquires is returned as .Err (already-acquired buffers are released first).
        cap = m.cap
        a.try_acquire3(cap * sizeof(MKey), cap * sizeof(T), cap * 2 * sizeof(MIdx)).match ({
            .Ok(bufs) => {
                kp = bufs.b1
                vp = bufs.b2
                ip = bufs.b3
                next = Map<T>(
                    keys: kp,
                    vals: vp,
                    idx: ip,
                    len: m.len,
                    cap: cap,
                )
                srcks = m.keys()
                srcvs = m.vals()
                dstks ::= next.keys_all()
                dstvs ::= next.vals_all()
                srcks.loop((h, i, k) {
                    (i < m.len).match ({
                        true  => {
                            dstks[i] = k
                            dstvs[i] = srcvs[i]
                        },
                        false => {
                            h.break
                        },
                    })
                })
                ok: Result<Map<T>, IoError> = .Ok(next.reindex())
                ok
            },
            .Err(e)   => {
                err: Result<Map<T>, IoError> = .Err(e)
                err
            },
        })
    }
    each_pair = (m: Map<T>, f: (StringView, T) void) void {
        // Visit every live entry as (key, value) together, in insertion order. `f` is invoked DIRECTLY in
        // the loop body so an inline lambda splices in (like iter.each). Walking `keys()`/`vals()` in
        // parallel at the call site is no longer needed: `m.each_pair((k, v){ … })`.
        ks = m.keys()
        vs = m.vals()
        ks.loop((h, i, k) {
            (i < m.len).match ({
                true  => {
                    f(k, vs[i])
                },
                false => {
                    h.break
                },
            })
        })
    }
}
// FNV-1a hash of k's bytes, folded into [0, cap). cap is always >= 1 at call sites.
mhash = (k: StringView, cap: i64) i64 {
    // mask to non-negative then mod into the bucket range
    (fnv1a32(k.view()) & 4611686018427387903) % cap
}
// Walk bucket chain b for key k in the index ix over key column ks (cap entries, links at [cap..]).
mfind = (ks: Slice<StringView>, ix: Slice<i64>, cap: i64, b: i64, k: StringView) i64 {
    mchain(ks, ix, cap, ix[b], k)
}
// First-byte prefilter before the full compare — map lookups run on every name/decl-index query in
// the checker, and chain collisions almost always differ in byte 0. Same answers (equal strings
// share their first byte).
mchain = (ks: Slice<StringView>, ix: Slice<i64>, cap: i64, e: i64, k: StringView) i64 {
    (e < 0).match ({
        true  => 0 - 1,
        false => (load(offset(ks[e], 0)) == load(offset(k, 0)) && ks[e] == k).match ({
            true  => e,
            false => mchain(ks, ix, cap, ix[cap + e], k),
        }),
    })
}
// a zero-entry `Map<T>` with capacity for at least one entry (so `put` has a slot before the first
// grow). Allocation failure is a value — returns Result<Map<T>, IoError>. Unlike map_of, no seed pins T,
// and T appears only in the RETURN type, which inference can't reach through a `.expect` chain — pin it
// with a two-step annotation (like hmap.empty):
//   r: Result<Map<i32>, IoError> = maps.empty(a)
//   m = r.expect("empty")
// The index is reindexed (its single bucket head cleared to -1) so `find`/`get`
// on the empty map return absent immediately. Pair with put/get/free like map_of.
empty*<T> = (a: AllocatorBackend) Result<Map<T>, IoError> {
    a.try_acquire3(sizeof(MKey), sizeof(T), 2 * sizeof(MIdx)).match ({
        .Ok(bufs) => {
            kp = bufs.b1
            vp = bufs.b2
            ip = bufs.b3
            m = Map<T>(
                keys: kp,
                vals: vp,
                idx: ip,
                len: 0,
                cap: 1,
            )
            .Ok(m.reindex())
        },
        .Err(e)   => {
            .Err(e)
        },
    })
}
// a `Map<T>` seeded with one entry, its buffers acquired from `a`. T inferred from the seed value
// (Zen has no call-site type args). Starts at cap 1.
map_of_in*<T> = (a: AllocatorBackend, seed_key: StringView, seed_val: T) Result<Map<T>, IoError> {
    a.try_acquire3(sizeof(MKey), sizeof(T), 2 * sizeof(MIdx)).match ({
        .Ok(bufs) => {
            kp = bufs.b1
            vp = bufs.b2
            ip = bufs.b3
            m = Map<T>(
                keys: kp,
                vals: vp,
                idx: ip,
                len: 1,
                cap: 1,
            )
            keys ::= m.keys_all()
            vals ::= m.vals_all()
            keys[0] = seed_key
            vals[0] = seed_val
            .Ok(m.reindex())
        },
        .Err(e)   => {
            .Err(e)
        },
    })
}
// Importing this module installs the constructor on the passable allocator. The container-qualified
// name prevents collisions with Set/Vec/HMap factories on the same receiver.
MapFactory*: {
    map_of<T> = (a: Self, seed_key: StringView, seed_val: T) Result<Map<T>, IoError> {
        backend ::= a
        map_of_in(backend.addr(), seed_key, seed_val)
    },
}
Allocator.impl(MapFactory, { })
