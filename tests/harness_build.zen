    ])
    // the five atomic_* intrinsics, C vs node. genc lowers each to a __atomic_* builtin; before the
    // js backend lowered them too, `build --target js` exited 0 and the emitted call hit an
    // undefined name — `node` died with `ReferenceError: atomic_store_i64 is not defined`. Asserting
    // node's EXIT STATUS as well as the bytes is what gives this case teeth against that shape.
    // the js-target parity GATE itself: an intrinsic the js backend cannot lower must be a build-time
    // `error[js-target]` with NO output file, never a runtime ReferenceError. `--build-self` cannot be
    // pointed at a doctored backend from here, so the case pins the invariant the gate enforces —
    // every intrinsic genc's call_kind lowers is also lowered by js_call, checked by emitting a
    // program that exercises the whole set and asserting the .js names no undefined free function.
    // ZENC_NO_CACHE: report mode's OUTPUT is the product, but a check cache hit replays only the
    // `ok` line (the report diagnostics are not stored in the entry) — so under the harness's warm
    // shared ZENC_CACHE_DIR a second run would lose the error[ffi-ungranted] report and fail here.
    // This case must observe a real (cold) check; every other case is content-keyed-safe.
    // cargo-style profiles: `zen build` = dev (-O1 -g), `zen build -r` = release
    // (-O2 -fno-strict-aliasing). ZENC_SHOW_CC echoes each cc line to stderr (with the cache
    // bypassed — a hit never reaches cc); assert the fixture's compile line carries the dev
    // flags without -r and the release flags with it, and that BOTH binaries actually run.
    // A PATH-installed `zen` (invoked bare, so argv[0] is an unopenable relative `zen`) must STILL
    // cache: cache_self reads /proc/self/exe for the compiler-identity stamp, so the key is non-empty
    // and an entry is written. Before the fix the stamp was empty and no `check_` entry ever appeared.
    // c_library end-to-end: build+run the libm demo (cbrt 27 → 3, hypot 3 4 → 5 fold into exit 3)
    // and pin the generated module's shape (foreign decls + the opaque-handle struct).
    // use() is what grants: without it the genmod id doesn't resolve at all (even though the
    // build ran), and a hand-written dep with the same externs is error[ffi-ungranted].
    // a non-FFI-safe c_fn signature fails error[ffi-type], positioned AT the generated file.
    // genmod content is cache-keyed: unchanged rebuild replays (2 bin entries = build program +
    // target), an edited c_fn misses both and rebuilds a working binary.
    // args() owns the whole argv (len = 2 with --verbose, unwrapped from Result), has_flag/flag_str read it, set_env→getEnv→unset_env round-trips.
    // os_args_oom_result: args() under an always-fail allocator returns `.Err` as a value (prints `oom-err`, exit 0) — the OOM path never writes the argv strings through a null backbone.
    // io_file_result_paths: substitute this run's private scratch dir for the `@@T@@` placeholder, then
    // build+run; missing/denied/out paths now live under $ZT so concurrent runs never share scratch.
    // cown_result_paths: same substitution, and SEED the input file first so `cown.file_in` opens it
    // successfully and the allocator-wrap failure (LimitAlloc) is what yields the asserted .NotFound.
    // stdin_echo_filter_pipe: std.io.stdin.lines as a real unix filter — input PIPED via printf,
    // exit code = line count (3, incl. the unterminated final line), stdout cmp'd byte-exact.
    // stdin_read_all_cat: std.io.stdin.read_all is `cat` — redirected-file stdin round-trips
    // byte-exact, and empty stdin is Ok("") (exit 0, empty output), not an error.
    // io_file_nul_bytes: binary-safe file read — a file with an embedded NUL ("abc\0def", 7 bytes) read
    // via contents_bytes_in yields the FULL 7 bytes (NUL preserved); the text contents_in view stops at 3.
    // stdin_read_all_bytes_nul_cat: read_all_bytes + out_bytes is a binary `cat` — a piped stream with an
    // embedded NUL round-trips byte-exact (5 in, 5 out), where the strlen-based read_all would truncate.
    // c_target_rejects_js_platform_module: std.web.dom's stubs ARE the browser, so a C build could only
    // hand `ld` symbols no C host defines. The C entry points (build/emit) refuse with a POSITIONED
    // error[c-target] at the import and never reach cc — no `undefined reference` / `unknown type name`
    // may appear — while `check` and `emit-js` still accept the very same program.
    // foreign_decl_generic_return_emits_its_mono_struct: a BODYLESS decl's prototype names its types too,
    // so a generic instance reachable only from a foreign signature (`Opt<Widget>`) must still be
    // monomorphized and emitted; missing it made genc write a prototype over an undeclared C type.
    // ── (k) bootstrap-binary battery (ported from test_bootstrap.py + test_build_self.py): the committed
    // `./zen` IS the cc-built bootstrap binary, so drive it directly — emit-compile-run real programs,
    // survive malformed input (no signal death), report missing files, and `--build-self` usage errors.
    // (the self-host FIXPOINT itself is wired separately in oracle.zen via fixpoint_ok.)
    bs := run_shells("bootstrap", [
        ShellCase(
            name: "bootstrap_compiles_zen",
            cmd: "printf '%s' 'sq* = (n: i32) i32 { n * n }' | ./zen >$ZT/zbc.c 2>/dev/null && grep -Fq 'int32_t sq(int32_t n)' $ZT/zbc.c && { echo '#include <stdint.h>'; cat $ZT/zbc.c; echo 'int main(void){ return sq(7) == 49 ? 0 : 1; }'; } > $ZT/zbc_full.c && cc -std=gnu11 -w $ZT/zbc_full.c -o $ZT/zbc_bin 2>/dev/null && $ZT/zbc_bin",
        ),
        ShellCase(
            name: "bare_invocation_tty_help_vs_pipe_filter",
            cmd: "script -qec './zen' /dev/null </dev/null >$ZT/zbare_tty.txt 2>&1 && grep -Fq 'usage: zenc' $ZT/zbare_tty.txt && printf 'main = () i32 { 0 }\\n' | ./zen >$ZT/zbare_pipe.c 2>/dev/null && grep -Fq zslice $ZT/zbare_pipe.c",
        ),
        ShellCase(
            name: "bootstrap_run_bool_true_first",
            cmd: "printf 'f* = (n: i32) i32 { (n < 5).match({ true => 1, false => 0 }) }' | ./zen >$ZT/zbp.c 2>/dev/null && { echo '#include <stdint.h>'; echo '#include <stdbool.h>'; cat $ZT/zbp.c; echo 'int main(void){ return f(3)==1 && f(9)==0 ? 0 : 1; }'; } > $ZT/zbp_full.c && cc -std=gnu11 -w $ZT/zbp_full.c -o $ZT/zbp_bin 2>/dev/null && $ZT/zbp_bin",
        ),
        ShellCase(
            name: "bootstrap_run_bool_false_first",
            cmd: "printf 'g* = (n: i32) i32 { (n < 5).match({ false => 0, true => 1 }) }' | ./zen >$ZT/zbp.c 2>/dev/null && { echo '#include <stdint.h>'; echo '#include <stdbool.h>'; cat $ZT/zbp.c; echo 'int main(void){ return g(3)==1 && g(9)==0 ? 0 : 1; }'; } > $ZT/zbp_full.c && cc -std=gnu11 -w $ZT/zbp_full.c -o $ZT/zbp_bin 2>/dev/null && $ZT/zbp_bin",
        ),
        ShellCase(
            name: "bootstrap_run_recursion_fib",
            cmd: "printf 'fib* = (n: i32) i32 { (n < 2).match({ true => n, false => fib(n-1)+fib(n-2) }) }' | ./zen >$ZT/zbp.c 2>/dev/null && { echo '#include <stdint.h>'; echo '#include <stdbool.h>'; cat $ZT/zbp.c; echo 'int main(void){ return fib(10)==55 ? 0 : 1; }'; } > $ZT/zbp_full.c && cc -std=gnu11 -w $ZT/zbp_full.c -o $ZT/zbp_bin 2>/dev/null && $ZT/zbp_bin",
        ),
        ShellCase(
            name: "bootstrap_run_while_sum",
            cmd: "printf 'sum* = (n: i32) i32 {\\n s := 0\\n i := 1\\n @while(i <= n) {\\n  s = s + i\\n  i = i + 1\\n }\\n s\\n}' | ./zen >$ZT/zbp.c 2>/dev/null && { echo '#include <stdint.h>'; echo '#include <stdbool.h>'; cat $ZT/zbp.c; echo 'int main(void){ return sum(5)==15 ? 0 : 1; }'; } > $ZT/zbp_full.c && cc -std=gnu11 -w $ZT/zbp_full.c -o $ZT/zbp_bin 2>/dev/null && $ZT/zbp_bin",
        ),
        ShellCase(
            name: "bootstrap_run_nested_while",
            cmd: "printf 'grid* = (n: i32) i32 {\\n c := 0\\n i := 0\\n @while(i < n) {\\n  j := 0\\n  @while(j < n) {\\n   c = c + 1\\n   j = j + 1\\n  }\\n  i = i + 1\\n }\\n c\\n}' | ./zen >$ZT/zbp.c 2>/dev/null && { echo '#include <stdint.h>'; echo '#include <stdbool.h>'; cat $ZT/zbp.c; echo 'int main(void){ return grid(4)==16 ? 0 : 1; }'; } > $ZT/zbp_full.c && cc -std=gnu11 -w $ZT/zbp_full.c -o $ZT/zbp_bin 2>/dev/null && $ZT/zbp_bin",
        ),
        ShellCase(
            name: "bootstrap_run_enum_match",
            cmd: "printf 'Shape*: Circle(i32) | Square(i32)\\nmk* = (n: i32) Shape {\\n .Circle(n)\\n}\\narea* = (s: Shape) i32 {\\n s.match({ .Circle(r) => r*r*3, .Square(w) => w*w })\\n}' | ./zen >$ZT/zbp.c 2>/dev/null && { echo '#include <stdint.h>'; echo '#include <stdbool.h>'; cat $ZT/zbp.c; echo 'int main(void){ return area(mk(2))==12 ? 0 : 1; }'; } > $ZT/zbp_full.c && cc -std=gnu11 -w $ZT/zbp_full.c -o $ZT/zbp_bin 2>/dev/null && $ZT/zbp_bin",
        ),
        ShellCase(
            name: "bootstrap_run_struct_field",
            cmd: "printf 'Pt*: { x: i32, y: i32 }\\nmk* = (a: i32, b: i32) Pt {\\n Pt(x: a, y: b)\\n}\\nnsq* = (p: Pt) i32 {\\n p.x*p.x + p.y*p.y\\n}' | ./zen >$ZT/zbp.c 2>/dev/null && { echo '#include <stdint.h>'; echo '#include <stdbool.h>'; cat $ZT/zbp.c; echo 'int main(void){ return nsq(mk(3,4))==25 ? 0 : 1; }'; } > $ZT/zbp_full.c && cc -std=gnu11 -w $ZT/zbp_full.c -o $ZT/zbp_bin 2>/dev/null && $ZT/zbp_bin",
        ),
        ShellCase(
            name: "bootstrap_run_precedence",
            cmd: "printf 'e* = () i32 { 1 + 2 * 3 - 4 }' | ./zen >$ZT/zbp.c 2>/dev/null && { echo '#include <stdint.h>'; echo '#include <stdbool.h>'; cat $ZT/zbp.c; echo 'int main(void){ return e()==3 ? 0 : 1; }'; } > $ZT/zbp_full.c && cc -std=gnu11 -w $ZT/zbp_full.c -o $ZT/zbp_bin 2>/dev/null && $ZT/zbp_bin",
        ),
        ShellCase(
            name: "bootstrap_run_compare_and",
            cmd: "printf 'c* = (a: i32, b: i32) bool { (a < b) && (b < 10) }' | ./zen >$ZT/zbp.c 2>/dev/null && { echo '#include <stdint.h>'; echo '#include <stdbool.h>'; cat $ZT/zbp.c; echo 'int main(void){ return c(3,7) && !c(3,12) ? 0 : 1; }'; } > $ZT/zbp_full.c && cc -std=gnu11 -w $ZT/zbp_full.c -o $ZT/zbp_bin 2>/dev/null && $ZT/zbp_bin",
        ),
        ShellCase(
            name: "bootstrap_malformed_no_colon_param",
            cmd: "printf 'f* = (p i32) i32 { 1 }' | timeout 15 ./zen >/dev/null 2>&1; rc=$?; test \"$rc\" -lt 124",
        ),
        ShellCase(
            name: "bootstrap_malformed_colon_payload_enum",
            cmd: "printf 'E: A | Some: T' | timeout 15 ./zen >/dev/null 2>&1; rc=$?; test \"$rc\" -lt 124",
        ),
        ShellCase(
            name: "bootstrap_malformed_truncated_binop",
            cmd: "printf 'g* = () i32 { 6 *' | timeout 15 ./zen >/dev/null 2>&1; rc=$?; test \"$rc\" -lt 124",
        ),
        ShellCase(
            name: "bootstrap_malformed_unterminated_block",
            cmd: "printf 'h* = () i32 { 1' | timeout 15 ./zen >/dev/null 2>&1; rc=$?; test \"$rc\" -lt 124",
        ),
        ShellCase(
            name: "bootstrap_malformed_unterminated_import",
            cmd: "printf '{ a, b' | timeout 15 ./zen >/dev/null 2>&1; rc=$?; test \"$rc\" -lt 124",
        ),
        ShellCase(
            name: "bootstrap_malformed_unterminated_tparams",
            cmd: "printf 'f<T' | timeout 15 ./zen >/dev/null 2>&1; rc=$?; test \"$rc\" -lt 124",
        ),
        ShellCase(
            name: "bootstrap_malformed_empty",
            cmd: "printf '' | timeout 15 ./zen >/dev/null 2>&1; rc=$?; test \"$rc\" -lt 124",
        ),
        ShellCase(
            name: "bootstrap_malformed_lone_brace",
            cmd: "printf '{' | timeout 15 ./zen >/dev/null 2>&1; rc=$?; test \"$rc\" -lt 124",
        ),
        ShellCase(
            name: "bootstrap_malformed_lone_ident",
            cmd: "printf 'x' | timeout 15 ./zen >/dev/null 2>&1; rc=$?; test \"$rc\" -lt 124",
        ),
        ShellCase(
            name: "bootstrap_missing_file",
            cmd: "./zen /nonexistent/zzz.zen >$ZT/zmf.txt 2>&1; test \"$?\" = 1 && grep -Fq 'cannot open' $ZT/zmf.txt",
        ),
        ShellCase(
            name: "build_self_usage_missing_args",
            cmd: "./zen --build-self >$ZT/zbs.txt 2>&1; test \"$?\" = 2 && grep -Fq 'usage' $ZT/zbs.txt",
        ),
        ShellCase(
            name: "build_self_bad_srcroot",
            cmd: "./zen --build-self $ZT/zbs_x.c /nonexistent/zzz >$ZT/zbs2.txt 2>&1; test \"$?\" = 1 && grep -Fq 'cannot open' $ZT/zbs2.txt",
        ),
    ])
    // MALFORMED-INPUT cases. The bound is `< 124` (not `< 128`): 124 is `timeout`'s own exit, so the
    // old bound let a HUNG compiler pass a case whose whole point is that malformed input is handled
    // — the exact "a naive nonzero-exit read lets a hang pass" trap harness_lib documents.
    // STILL UNPINNED, deliberately: the bound also admits rc 0. All nine inputs below are currently
    // ACCEPTED by the bare-stdin path (`printf 'f* = (p i32) i32 { 1 }' | ./zen` exits 0 and emits C
    // carrying a `__syntax_error` sentinel), so pinning `= 1` here turns all nine red against a live
    // compiler defect rather than a test defect. Pin it in the same change that makes stdin reject.
    // Bare `zenc` (no subcommand, no file): on an interactive TTY it prints help and exits 0 instead
    // of silently blocking on a stdin read; when stdin is a PIPE it still filters source -> C. `script`
    // (util-linux) allocates a pty so isatty(0) is true for the help branch.
    ex + so + ex2 + so2 + exm + vd + r1 + r2 + vd2 + vd2b + dg + em + dc + sh + bs
}
