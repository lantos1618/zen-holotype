// tests/corpus/std/both_format_doors_write_the_same_bytes.zen
// ONE FORMAT STRING, TWO DOORS, ONE ANSWER (#755). `alloc.String(fmt,
// ..)` makes the buffer and `buf.fmt(fmt, ..)` appends to one that
// already exists, and for a long time only the first would take a hole
// that was not a `str` -- the second reported `a format hole on this
// door that is not a str` for the very same `{}`.
//
// The property under test is EQUALITY, not "it compiles": a door that
// lowers and then writes the wrong bytes would pass a compile check and
// fail here. So every case is written twice, once through each door, and
// the verdict is a comparison of what came out -- with the bytes
// themselves printed, so a red says WHAT differed and not only THAT it
// did.
//
// The holes cover every writer a `{}` can reach: the sink's own `write`
// for a `str`, `add_i64` at the negative extreme, `add_u64` past
// `i64.MAX`, `add_bool`, and a `Display`'s own `toString` -- which is
// the one that matters, because until this worked no writer in `src/`
// could be written as a format at all.

Point = {
    x: i64,
    y: i64,
}

Point.impl(Display, {
    toString ::= (self: @Self, out :: Sink) Res<(), WriteError> {
        out.add("({}, {})", self.x, self.y)
    }
})

// the two doors' bytes, side by side and then judged
verdict = (label: str, one: str, two: str) () {
    println("{} one [{}]", label, one);
    println("{} two [{}]", label, two);
    println("{} same {}", label, one.eq(two));
}

main = (env: Env) Res<i32, AllocError> {
    a ::= env.mem.alloc();

    // a str hole -- the one shape the appending door always took, here
    // so the equality holds across the change rather than only after it
    s1 ::= a.String("name={}!", "ada").try();
    s2 ::= a.String().try();
    s2.fmt("name={}!", "ada").try();
    verdict("str", s1.view(), s2.view());

    // an unsigned integer past i64.MAX, so add_u64 and not add_i64
    u ::= u64.MAX;
    u = 18446744073709551615;
    u1 ::= a.String("u={}!", u).try();
    u2 ::= a.String().try();
    u2.fmt("u={}!", u).try();
    verdict("u64", u1.view(), u2.view());

    // a signed integer at the extreme that has no positive counterpart
    i  ::= i64.MIN;
    i1 ::= a.String("i={}!", i).try();
    i2 ::= a.String().try();
    i2.fmt("i={}!", i).try();
    verdict("i64", i1.view(), i2.view());

    // A `u8` HOLE WRITES A NUMBER, not a character -- the same as
    // `println` and `String.add`, and a trap for anyone converting an
    // `add_byte` into a format. Pinned here because the floor door's
    // refusal used to be what caught it; `docs/design_fmt.md` §7 owes a
    // `{c}` hole for the character spelling.
    c ::= u8.MAX;
    c = 'z';
    c1 ::= a.String("c={}!", c).try();
    c2 ::= a.String().try();
    c2.fmt("c={}!", c).try();
    verdict("u8", c1.view(), c2.view());

    b ::= false;
    b = true;
    b1 ::= a.String("b={}!", b).try();
    b2 ::= a.String().try();
    b2.fmt("b={}!", b).try();
    verdict("bool", b1.view(), b2.view());

    // a Display: the hole runs the type's own toString, into whichever
    // buffer the door is holding
    p = Point(x: 3, y: -4);
    p1 ::= a.String("p={}!", p).try();
    p2 ::= a.String().try();
    p2.fmt("p={}!", p).try();
    verdict("display", p1.view(), p2.view());

    // every writer at once, with a named hole and a doubled brace in the
    // same format -- the walk is shared, so the two doors have to agree
    // about the literal runs as well as the holes
    n ::= u64.MAX;
    n = 7;
    m1 ::= a.String("{{{n}}} {} {} {}", "ada", i, p).try();
    m2 ::= a.String().try();
    m2.fmt("{{{n}}} {} {} {}", "ada", i, p).try();
    verdict("mixed", m1.view(), m2.view());

    // the appending door appends: a second call keeps what the first
    // wrote, which the allocating door cannot do at all
    m2.fmt(" then {}", u).try();
    println("appended [{}]", m2.view());

    Ok(0);
}
