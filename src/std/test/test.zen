// Test and benchmark contexts. Function names are used as test names in
// failure output.

Alloc = std.mem
Env = std.env
str = std.text

// Failed expectation with a user-facing reason.
TestError* = | Failed(str)

Tester* = {
    env*: Env,

    // Per-test arena, dropped after the test.
    alloc*: Alloc,

    // Return a failure so the harness can continue with later tests.
    expect* = (self: @Self, cond: bool) Res<(), TestError> {
        cond.match({
            true  => Ok(()),
            false => Err(TestError.Failed("expectation was false")),
        })
    }

    // The Eq bound selects the type's own equality implementation.
    expect_eq* = <T: Eq>(self: @Self, a: T, b: T) Res<(), TestError>
}

// Benchmark context with timing and allocation counters.
Bencher* = {
    env*: Env,
    alloc*: Alloc,

    // Run f until timing stabilizes.
    iter* = (self: @Self, f: () ()) BenchStats
}

// Per-operation benchmark measurements.
BenchStats* = {
    ns_op*: u64,
    allocs_op*: u64,
    bytes_op*: u64,
}
