// src/sema/sema_scope.zen
// A block, as a value, that may not leave its block.
//
// `@scope` "stands for the enclosing block, exactly as `h: LoopHandle`
// stands for the enclosing loop" — a value with a lifetime, which
// nothing else in the language has (every other rule here is about a
// TYPE or a UNIQUENESS), so it isn't folded into `sema_own.zen` beside
// the moves.
//
// NON-ESCAPING IS A FEATURE, NOT A LIMITATION: a closure registered on
// a scope keeps its captures in that scope's own storage, which works
// because the block outlives the closure by construction. Take the
// restriction away and `defer` needs a heap record, which law 1 forbids
// without an `Alloc`. Inward is fine: a helper registering cleanup on
// its caller's block is the whole point.
//
// All three ways out are checked here — stored in a struct, returned,
// captured by an escaping closure. The third needs "which closures
// escape" and gets a narrow answer; what it doesn't cover is written
// above `call_escapes` rather than left to be discovered.

ExprId, BlockId, Block, Call, Struct = std.ast
Paren, Access, Member, Function, Param, Span, TypeId = std.ast
Try, Name, Expr = std.ast
AllocError = std.mem
str = std.text
Range = std.core
DeclId = sema.sema_id
decl_at = sema.sema_def
Checker = sema.sema_check
tail_expr = sema.sema_hoist
SemaFault, NameFault = sema.sema_diag
refuse, Own, place_type, captures_scope = sema.sema_own
arena_var, scoped_var, UNTYPED = sema.sema_own
TyId = sema.sema_ty
own_member = sema.sema_recv

// RETURNED. The block is gone by the time the caller has the value, so
// every defer on it would run against a dead frame. Only the FUNCTION
// BODY's value is asked — a nested block's `@scope` value hands it to
// an enclosing block that's still open — and asked from INSIDE
// `own_block`, while this frame's bindings are still on `o.vars`: a
// binding of `@scope` records `scoped` only where it was declared, and
// `own_release` drops it before `check_own`'s caller would look.
//
// PROVENANCE, not syntax, which is what makes this half different from
// the two rules above it: `here = () Scope { s = @scope; s; }` leaves
// through the NAME, one step past any syntactic match. `tail_expr` and
// not `Block.value` — a body's last expression is the value it returns
// whether or not the author wrote the closing `;`.
check_scope_returned* = (c :: Checker, o :: Own, id: BlockId, b: Block)
                         Res<(), AllocError> {
    (id.index == o.body.index).match({
        false => Ok(()),
        true  => c.tail_expr(b).match({
            None  => Ok(()),
            Ok(v) => c.refuse_scope_returned(o, v),
        }),
    })
}

// STORED. `register(@scope, env)` passes it inward, legal; `Holder(s:
// @scope)` puts it in a value that can outlive the block. Read the same
// at the call site; only the resolved declaration tells them apart —
// what `call_memo` exists for.
check_scope_stored* = (c :: Checker, id: ExprId, k: Call)
                      Res<(), AllocError> {
    c.is_construction(id).match({
        false => Ok(()),
        true  => c.refuse_scope_args(k),
    })
}

is_construction = (c :: Checker, id: ExprId) bool {
    c.resolved_call(id).match({
        None  => false,
        Ok(d) => c.decl_is_struct(d),
    })
}

decl_is_struct = (c :: Checker, d: DeclId) bool {
    decl_at(c.tree, d).match({
        None   => false,
        Ok(dc) => dc.kind.match({ Struct(_) => true, _ => false }),
    })
}

refuse_scope_args = (c :: Checker, k: Call) Res<(), AllocError> {
    k.args.loop((h, a) { c.refuse_scope_expr(a.value).try() });
    Ok(());
}

// The keyword itself, wherever it was written — the syntactic half the
// STORED rule reads on a construction's arguments. Provenance lives in
// the RETURNED rule above; this stays a match on the AST kind.
refuse_scope_expr = (c :: Checker, id: ExprId) Res<(), AllocError> {
    node = c.tree.expr_at(id);
    node.kind.match({
        Scope    => c.refuse(
            node.span,
            SemaFault.ScopeEscapes(NameFault(name: ""))
        ),
        Paren(p) => c.refuse_scope_expr(p.inner),
        _        => Ok(()),
    })
}

// CAPTURED. The block outlives every frame registered on it (what
// non-escaping buys, and what makes `Scope` a bare pointer into
// automatic storage), so a closure outliving the block holds a pointer
// to a dead frame — use-after-free, not a style rule. Reported at the
// use inside the body: no separate capture list to point at.
check_scope_captured* = (c :: Checker, o :: Own, span: Span, text: str)
                        Res<(), AllocError> {
    captures_scope(o, text).match({
        false => Ok(()),
        true  => c.refuse(span, SemaFault.ScopeEscapes(NameFault(name: text))),
    })
}

// ---------------------------------------------------------------------
// WHICH BINDING NAMES A BLOCK, AND WHERE A TAIL DRAWS ON ONE
//
// The RETURNED rule reads the same state `sema_own.zen`'s walk keeps for
// the capture rule — a binding whose initialiser names the block records
// `OwnVar.scoped` where it was declared (`sema_own.zen`, `declare_var`)
// — so the walk below is PROVENANCE over that flag, not syntax. It is
// what lets the tail refuse `s`, `Ok(s)` and `h.s` one step past the
// keyword itself.
//
// WHAT IT DOES NOT COVER, named rather than hidden. Only bindings are
// tainted, never an expression: `() Scope { { @scope } }` needs no walk
// because the nested block's tail is refused by `check_scope_stored`
// when the outer body's own tail hands it on. A taint is not chased
// through a re-binding (`t = s`) nor out of a callee, and a parameter of
// type `Scope` is not recorded at all (`own_params` sets `scoped:
// false`). All of it is the same fail-open direction this file already
// takes: a false rejection makes a correct program uncompilable, a
// missing check only misses.
// ---------------------------------------------------------------------

// The innermost node whose value names this frame's block, or none —
// returned as a node so the refusal points at the value that leaves,
// not at the wrapper that carries it.
scope_escape = (c :: Checker, o :: Own, id: ExprId) Res<ExprId> {
    c.scope_carries(o, id).match({
        false => None,
        true  => c.scope_escape_of(o, id),
    })
}

scope_escape_of = (c :: Checker, o :: Own, id: ExprId) Res<ExprId> {
    c.tree.expr_at(id).kind.match({
        Scope     => Ok(id),
        Name(n)   => c.named_scope(o, id, n.text),
        Paren(p)  => c.scope_escape(o, p.inner),
        Try(t)    => c.scope_escape(o, t.operand),
        Access(a) => c.scope_escape(o, a.base),
        Call(k)   => c.scope_escape_in_args(o, k),
        _         => None,
    })
}

named_scope = (c :: Checker, o :: Own, id: ExprId, text: str) Res<ExprId> {
    scoped_var(o, text).match({ true => Ok(id), false => None })
}

// `Ok(s)` is a call whose ARGUMENT carries the block out; nothing else
// about a callee can name this frame's block, so only the arguments are
// asked, first offender wins.
scope_escape_in_args = (c :: Checker, o :: Own, k: Call) Res<ExprId> {
    Range(0, k.args.len).find((i) {
        k.args.get(i).match({
            None  => false,
            Ok(a) => c.scope_escapes(o, a.value),
        })
    }).match({
        None  => None,
        Ok(i) => k.args.get(i).match({
            None  => None,
            Ok(a) => c.scope_escape(o, a.value),
        }),
    })
}

scope_escapes = (c :: Checker, o :: Own, id: ExprId) bool {
    c.scope_escape(o, id).match({ Ok(_) => true, None => false })
}

refuse_scope_returned = (
    c  :: Checker,
    o  :: Own,
    id : ExprId
) Res<(), AllocError> {
    c.scope_escape(o, id).match({
        None   => Ok(()),
        Ok(at) => c.refuse_scope_node(o, at),
    })
}

refuse_scope_node = (c :: Checker, o :: Own, at: ExprId) Res<(), AllocError> {
    node = c.tree.expr_at(at);
    c.refuse(
        node.span,
        SemaFault.ScopeEscapes(NameFault(name: scope_fault_name(node)))
    )
}

// A binding leaves with its name in the message, the keyword alone
// without one — the same shape `check_scope_captured` prints.
scope_fault_name = (node: Expr) str {
    node.kind.match({
        Name(n) => n.text,
        _       => "",
    })
}

// Whether a value of this type could BE a block, or carry one out. The
// gate that keeps `wrap = (env: Env) () { register(@scope, env) }`
// compiling — its tail is a call whose argument names the block INWARD,
// legal — while refusing a wrapper whose payload does leave. A primitive
// is a copy and ends the chase; anything not a primitive is not
// something this file can rule out, so it is followed.
scope_carries = (c :: Checker, o :: Own, id: ExprId) bool {
    c.may_carry_scope(c.place_type(o, id))
}

may_carry_scope = (c: Checker, ty: TyId) bool {
    ty.eq(UNTYPED).match({
        true  => true,
        false => c.types.at(ty).match({
            Res(r) => c.may_carry_scope(r.value),
            _      => c.prim_name(ty).len == 0,
        }),
    })
}

// A binding of `@scope` names the block exactly as the keyword does, so
// `sema_own.zen` records the answer on it when declared. Chased no
// further than what's WRITTEN — `t = s` where `s` holds one is not
// seen, the same syntactic limit the two rules above have.
is_scope_value* = (c :: Checker, id: ExprId) bool {
    c.tree.expr_at(id).kind.match({
        Scope    => true,
        Paren(p) => c.is_scope_value(p.inner),
        _        => false,
    })
}

// ---------------------------------------------------------------------
// WHICH CLOSURES ESCAPE
//
// Read off the CALLEE'S SIGNATURE — law 7's job: "does it allocate,
// mutate, fail, escape — read the signature". `spawn` is declared
// `(self, a: Alloc, body: () Res<T, ThreadError>)`; the `Alloc` beside
// the body says "an escaping closure needs memory" — no allocator, no
// place to keep a closure past return.
//
// So `loop`/`fold`/`then` are untouched (no Alloc param), and
// `map`/`filter`, which do, are read as escaping at no cost: a body
// must NAME a `@scope` binding to be refused at all.
//
// WHAT IT DOES NOT COVER, named rather than hidden: a free function
// taking `Alloc` is not asked, only a method. A callee whose type isn't
// memoized, or whose member comes from an impl rather than the type's
// own body, reads as NON-escaping — fail-open, since a false rejection
// makes a correct program uncompilable and a missing check only misses.
// ---------------------------------------------------------------------

call_escapes* = (c :: Checker, o :: Own, k: Call) bool {
    c.tree.expr_at(k.callee).kind.match({
        Access(a) => c.member_escapes(o, a),
        _         => false,
    })
}

member_escapes = (c :: Checker, o :: Own, a: Access) bool {
    c.own_member(c.place_type(o, a.base), a.name.text).match({
        None  => false,
        Ok(m) => c.member_takes_alloc(m),
    })
}

member_takes_alloc = (c :: Checker, m: Member) bool {
    m.kind.match({
        Function(f) => c.takes_alloc(f),
        _           => false,
    })
}

takes_alloc = (c :: Checker, f: Function) bool {
    Range(0, f.params.len).find((i) {
        f.params.get(i).match({
            None  => false,
            Ok(p) => c.param_is_alloc(p),
        })
    }).match({ Ok(_) => true, None => false })
}

// `Alloc` by NAME, on the parameter as written — the argument's own
// type is the wrong thing to ask (`env.mem.alloc()` hands out an
// `Arena`); the callee declares what it's entitled to keep.
param_is_alloc = (c :: Checker, p: Param) bool {
    p.type.match({
        None    => false,
        Ok(tid) => c.type_is_alloc(tid),
    })
}

type_is_alloc = (c :: Checker, tid: TypeId) bool {
    c.tree.type_at(tid).kind.match({
        Named(n) => n.name.text.eq("Alloc"),
        _        => false,
    })
}

// ---------------------------------------------------------------------
// AN ARENA-BACKED VIEW MAY NOT OUTLIVE THE ARENA
//
// `alloc ::= env.mem.alloc()` makes an ordinary scope-local value, so
// `Arena.drop` frees its pages at the end of the body that made it. A
// `str` from `buf.view()` points INTO those pages, so returning it
// hands the caller freed memory — issue #788, where two calls to the
// same helper print `a=  b=XY` with exit 0.
//
// PROVENANCE, NOT SYNTAX, which is what makes this different from the
// three `@scope` rules above: the walk taints a BINDING when its
// initialiser makes an arena, or names a binding already tainted, and
// the tail of the function body is refused when it names one. Recorded
// on `OwnVar.arena` because only `sema_own.zen`'s walk knows what a
// name meant where it was written.
//
// A BINDING IS THE WHOLE TRIGGER, deliberately. `Built(arena:
// env.mem.alloc(), cur: None)` (`src/lsp/lsp_built.zen:215`) makes an
// arena inline and MOVES it into the value it returns — the struct now
// owns it, nothing is dropped at the end of the body, and no name is
// mentioned, so this rule never sees it. The same for an arena that
// arrived as a parameter: the caller's frame outlives this one, and
// `own_params` records `arena: false`.
//
// WHAT IT DOES NOT COVER, named rather than hidden. The FUNCTION BODY's
// tail only, matching `check_scope_returned` — a value that leaves
// through a struct field stored in an out-parameter, or through a
// closure, is not asked. The walk does not enter `Match`, so a body
// whose tail is a match returning an arena-backed view from one arm is
// missed. A taint is not chased through an assignment to a binding
// declared before the arena, nor out of a callee. All of that is the
// same fail-open direction the file already takes: a false rejection
// makes a correct program uncompilable, a missing check only misses.
// ---------------------------------------------------------------------

check_arena_returned* = (c :: Checker, o :: Own, id: BlockId, b: Block)
                        Res<(), AllocError> {
    (id.index == o.body.index).match({
        false => Ok(()),
        true  => c.tail_expr(b).match({
            None  => Ok(()),
            Ok(v) => c.refuse_if_arena(o, v),
        }),
    })
}

refuse_if_arena = (c :: Checker, o :: Own, id: ExprId) Res<(), AllocError> {
    c.arena_name(o, id).match({
        None  => Ok(()),
        Ok(n) => c.refuse(
            c.tree.expr_at(id).span,
            SemaFault.ArenaEscapes(NameFault(name: n))
        ),
    })
}

// A binding's initialiser: the arena itself (`env.mem.alloc()`, typed
// `Arena`) or anything drawn from one already tainted.
is_arena_backed* = (c :: Checker, o :: Own, id: ExprId) bool {
    c.holds_pointer(o, id) &&
        (c.is_arena_ty(c.place_type(o, id)) || c.draws_on_arena(o, id))
}

is_arena_ty = (c :: Checker, ty: TyId) bool {
    c.types.at(ty).match({
        Named(n) => n.name.eq("Arena"),
        _        => false,
    })
}

draws_on_arena = (c :: Checker, o :: Own, id: ExprId) bool {
    c.arena_name(o, id).match({ Ok(_) => true, None => false })
}

// WHICH tainted binding this expression draws on, or none. The name is
// carried rather than a bool so the diagnostic can say which allocator
// the value is standing on.
//
// The pointer guard is what keeps the walk from over-tainting: `buf.len`
// and `buf.view().eq(x)` are a `usize` and a `bool`, copies that carry
// no address into the pages, so the taint stops at them. Only `str` and
// the types this file cannot see through are followed.
arena_name = (c :: Checker, o :: Own, id: ExprId) Res<str> {
    c.holds_pointer(o, id).match({
        false => None,
        true  => c.arena_name_of(o, id),
    })
}

arena_name_of = (c :: Checker, o :: Own, id: ExprId) Res<str> {
    c.tree.expr_at(id).kind.match({
        Name(n)   => named_arena(o, n.text),
        Paren(p)  => c.arena_name(o, p.inner),
        Try(t)    => c.arena_name(o, t.operand),
        Access(a) => c.arena_name(o, a.base),
        Call(k)   => c.arena_name_in_call(o, k),
        _         => None,
    })
}

named_arena = (o: Own, text: str) Res<str> {
    arena_var(o, text).match({ true => Ok(text), false => None })
}

// `Ok(buf.view())` and `Tag(name: buf.view())` are both a `Call` whose
// ARGUMENT is the escaping value; `buf.view()` is one whose RECEIVER is.
// All three spellings reach a return today, so all three are asked.
arena_name_in_call = (c :: Checker, o :: Own, k: Call) Res<str> {
    c.arena_name_of_callee(o, k.callee).match({
        Ok(n) => Ok(n),
        None  => c.arena_name_in_args(o, k),
    })
}

arena_name_of_callee = (c :: Checker, o :: Own, id: ExprId) Res<str> {
    c.tree.expr_at(id).kind.match({
        Access(a) => c.arena_name(o, a.base),
        _         => None,
    })
}

arena_name_in_args = (c :: Checker, o :: Own, k: Call) Res<str> {
    Range(0, k.args.len).find((i) {
        c.arg_draws_on_arena(o, k, i)
    }).match({
        None  => None,
        Ok(i) => k.args.get(i).match({
            None  => None,
            Ok(a) => c.arena_name(o, a.value),
        }),
    })
}

arg_draws_on_arena = (c :: Checker, o :: Own, k: Call, i: usize) bool {
    k.args.get(i).match({
        None  => false,
        Ok(a) => c.draws_on_arena(o, a.value),
    })
}

// Whether a value of this type could hold an address into the arena's
// pages. A number, a `bool` or `()` is a copy and ends the chase; `str`
// is the view this whole rule is about; anything not a primitive is not
// something this file can rule out, so it is followed.
holds_pointer = (c :: Checker, o :: Own, id: ExprId) bool {
    c.carries_address(c.place_type(o, id))
}

// A `Res` is asked about its VALUE: `write_items(items, body)` in
// `src/lsp/lsp_serve.zen:723` names an arena-backed `Vec` and returns
// `Res<(), AllocError>`, so nothing of the arena leaves with it. Reading
// the wrapper instead of the payload made that a false rejection, which
// is the shape of mistake this rule cannot afford.
carries_address = (c :: Checker, ty: TyId) bool {
    ty.eq(UNTYPED).match({
        true  => true,
        false => c.types.at(ty).match({
            Res(r) => c.carries_address(r.value),
            _      => is_pointerish(c.prim_name(ty)),
        }),
    })
}

is_pointerish = (name: str) bool { name.len == 0 || name.eq("str") }
