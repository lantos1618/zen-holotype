// src/zen/zen_build.zen
// `zen build`: the four phases, wired together for the first time.
//
//     read -> lex -> parse -> check -> emit
//
// Everything below this file already existed and none of it had ever
// been called by anything. What is new is the wiring and the two things
// wiring needs: where a module's bytes are, and what to do with a
// phase's diagnostics.
//
// A DIAGNOSTIC IS A VALUE, AND SO IS A FAILED READ. The only `Err` in
// this file is `AllocError`, the rule `sema` and `gen` each arrived at
// independently and the only one the seed subset allows — PLAN.md 0.5
// has no error unions, so a function that both opens a file and
// allocates cannot name two failures. A file that will not open is
// counted and printed exactly like a syntax error, and the walk carries
// on: the second mistake in a build is worth as much as the first.
//
// THE MODULE TREE IS COMPUTED, NOT DISCOVERED. `std.env.Fs` has `read`,
// `exists` and `is_dir` and no listing, on purpose — a module path is
// `<folder>/<folder>.zen`, so every path here is built from an import's
// segments and ruled out with a stat.
//
// THE PROGRAM IS ONE `Ast`, and `parse_it` is the whole of how. A
// `Parser` is built around the tree the walk has filled so far and the
// tree is read back off it before the next module is read, so one
// counter hands out every id and an id means the same thing in every
// module. `Build.tree` says what that costs and when the tree is
// finished.
//
// WHAT STOPS THIS FILE SHORT OF A COMPILER is written down at `deliver`
// rather than hidden: emitting needs a way to write a file that `Fs`
// does not have. That is one declaration, and it is not in this folder.
//
// OVER 500 LINES, AND THE JUSTIFICATION STYLE.md ASKS FOR: the subject
// is one build, and its parts are the five phases of one — they share
// the `Build` that holds the tree, the tally and the authority, and
// splitting the walk from the check would put the `Ast` in one file and
// the only thing that finishes it in another. The one part that is NOT
// about a build has already left: what a module NAME is (`module_name`
// and its helpers, below) is a fact about a path, and it is written as
// free functions so a second driver reads the same rule.

Alloc, AllocError = std.mem
str, String = std.text
Vec = std.collections
Range = std.core
FsError = std.env

Ast = ast.ast_arena
Module, Alias, Named = ast.ast_node
QualifiedName = ast.ast_span

// THE `Diag` COLLISION. `lex`, `parse` and `sema` each export a type
// called `Diag` and a `message` beside it, and `A, B = module` cannot
// rename — so a driver cannot import all three flat.
//
// Aliasing the module and qualifying through it, which
// `tests/corpus/modules/module_alias_qualified` pins, was tried first
// and DOES NOT WORK for a name two modules declare: `lexer = lex` then
// `lexer.message(d.fault)` lowered to `gen.gen_diag.message(lexer,
// d.fault)` — the wrong module's function, with the alias passed as its
// receiver. An alias also binds a single-segment RHS only, so only a
// folder root can be aliased at all.
//
// What works is a flat import of the ONE `message` this file wants, and
// that answers the collision only because this driver never needs two
// at once. A driver that did would have nothing to write, and the
// language would need rename-on-import. Reported.
message = lex.lex

scan, Source, Lexed = lex.lex
Parser, module = parse.parse
Checker, check_all = sema.sema
PRELUDE, last_segment = sema.sema
Def, World = sema.sema
Emit, CBackend, emit_program = gen.gen

Job = zen.zen_cli

// WHERE A PROGRAM STARTS, spelled once. It is both a module name the
// entry probe looks for and the declaration the root must own, and the
// two must not be able to drift apart — a probe that finds `main.zen`
// and a check that demands `start` would reject every program in the
// language and blame the file it just found.
ENTRY: str = "main"

// A module of the program: what it is called, and where its bytes are.
//
// THE PATH IS THE IDENTITY AND THE NAME IS DERIVED FROM IT. Two
// spellings reach one file — `std/core/core.zen` is `std.core` to a
// module that writes the folder and `std.core.core` to one that writes
// the file — so a `Unit` keyed on the import that found it makes one
// file two modules with one set of declarations, and a program that
// never writes the short spelling then has no prelude at all.
// `docs/SEMA_BOOTSTRAP_FIXES.md` §13 is that bug with its reproducer.
Unit* = {
    name*: str,     // the dotted module name: `std.core.result`
    path*: str,     // where the bytes are, to open them: as given
    rel*:  str,     // the same file, relative to the compilation ROOT
}

// `rel` exists because `path` must not reach a Span. Every diagnostic
// and every emitted trap position carries its file, so an absolute path
// puts the checkout's location into the OUTPUT — and two checkouts of
// one tree then emit different bytes, which silently voids the fixpoint
// oracle the whole plan rests on. TESTING.md states the rule: "every
// path the compiler emits [is relative to the root], which is what makes
// the determinism check comparing two copies of a tree at different
// absolute paths meaningful."


// One build. It holds the authority the phases need and the tally of
// what went wrong, because the exit code is that tally and both
// `tests/run.py` and `scripts/fixpoint.sh` read it.
Build* = {
    env*: Env,
    alloc*: Alloc,
    root*: str,

    faults* :: usize = 0,
    units* :: usize = 0,

    // The entry's path relative to the root, kept for the one
    // diagnostic that is about the root itself rather than about
    // anything a span could point at — see `missing_main`.
    entry_rel* :: str = "",

    // THE PROGRAM'S TREE, and there is exactly one. Every parser is
    // built around it and hands it back, so an `ExprId` from the
    // ninety-first module and one from the first are indices into the
    // same arena — which is the only thing that makes a `Checker`
    // holding this tree able to answer about either.
    //
    // It must be FINISHED before `alloc.Checker(tree)`:
    // `SEMA_BOOTSTRAP_FIXES.md` §12 — a `Checker` copies the `Ast`, so
    // an `Ast` is a value and a copy of it is a snapshot. `walk`
    // completes before `back_end` is called, and nothing adds a node
    // after that.
    tree* :: Ast,

    // -----------------------------------------------------------------
    // the walk
    // -----------------------------------------------------------------

    // WHERE THE PROGRAM STARTS. `--entry <file>` answers it outright;
    // without one, the root is probed.
    //
    // The probe is what a directory with no listing can do, and it can
    // only find conventional names — which is why `--entry` exists.
    // `std.env.Fs` has no listing on purpose ("every member added here
    // is a member the self-hosted compiler has to keep working
    // forever"), and enumerating a directory is strictly more authority
    // than reading a path you were handed. The information is already
    // at the call site: whoever invokes the compiler knows the entry.
    // A single-file program named anything else is unreachable by
    // probing and reachable by being named, and that is the whole of it.
    //
    // A build is still a ROOT. The entry says where to start inside it;
    // every other module is found by following imports, exactly as
    // before.
    entry_of = (self :: @Self, named: str) Res<Unit, AllocError> {
        named.is_empty().match({
            false => self.entry_named(named),
            true  => self.entry_probed(),
        })
    }

    // `--entry` is relative to the root, because `Unit.rel` is what a
    // Span carries and an absolute path in a Span puts the checkout's
    // location into the emitted C — which voids the determinism check
    // that compares two copies of a tree at different paths.
    //
    // NOT PROBED. A named entry that is not there is reported by the
    // READ, which names the file the caller asked for; a probe
    // reporting it as well would be one mistake said twice, and the
    // caller who chose the name is owed the name back.
    entry_named = (self :: @Self, named: str) Res<Unit, AllocError> {
        path ::= self.alloc.String("{}/{}", self.root, named).try();
        self.unit_at(path.view())
    }

    // No `--entry`, so the entry point is a MODULE NAME resolved by the
    // same two probes every other module gets. Three names, most
    // conventional first:
    //
    //   main        every program in tests/corpus, and the
    //               `src: Path("src/main.zen")` DESIGN.md's own
    //               build.zen example writes
    //   <basename>  the folder-root rule `<folder>/<folder>.zen`,
    //               applied to the root itself
    //   zen         this tree, and only this tree
    //
    // The third is still a special case, and it is the one
    // `scripts/fixpoint.sh` rides: the gate runs `zen build src` with
    // no entry, so this order is load-bearing and must not move.
    entry_probed = (self :: @Self) Res<Unit, AllocError> {
        first = self.candidate(ENTRY).try();
        self.env.fs.exists(first.path).match({
            true  => Ok(first),
            false => self.entry_after_main(),
        })
    }

    entry_after_main = (self :: @Self) Res<Unit, AllocError> {
        second = self.candidate(base_of(self.root)).try();
        self.env.fs.exists(second.path).match({
            true  => Ok(second),
            false => self.candidate("zen"),
        })
    }

    // `<root>/<name>.zen`, or `<root>/<name>/<name>.zen` when the name
    // is a folder. A candidate is returned whether or not it is there —
    // a root with no entry is reported by the READ, which names the
    // file, and a probe reporting it too would be one mistake twice —
    // so the flat form also wins when NEITHER exists: the shorter path
    // is the one a diagnostic should carry.
    candidate = (self: @Self, name: str) Res<Unit, AllocError> {
        flat ::= self.alloc.String("{}/{}.zen", self.root, name).try();
        nest ::= self.alloc.String("{}/{}/{}.zen", self.root, name, name).try();
        take_flat = self.env.fs.exists(flat.view())
                 || !self.env.fs.exists(nest.view());
        take_flat.match({
            true  => self.unit_at(flat.view()),
            false => self.unit_at(nest.view()),
        })
    }

    // The module a FILE is. The name is a pure function of the path and
    // never of the spelling that found it, so `std.core` and
    // `std.core.core` are one module read once — see `Unit`.
    unit_at = (self: @Self, path: str) Res<Unit, AllocError> {
        name = module_name(self.alloc, self.root, path).try();
        Ok(Unit(name: name, path: path, rel: relative_to(self.root, path)));
    }

    // The whole program, breadth first from the entry. `seen` is both
    // the queue and the set: a module reached twice is added once, and
    // the index walks a list that is still growing, which is what makes
    // a worklist a Vec and not a recursion.
    walk = (self :: @Self, entry: Unit) Res<(), AllocError> {
        seen ::= self.alloc.Vec<Unit>();
        self.entry_rel = entry.rel;
        seen.add(entry).try();
        self.seed_prelude(seen).try();
        i ::= 0;
        loop(() { i < seen.len }, (h) {
            u = seen.get(i).match({ Ok(v) => v, None => entry });
            i = i + 1;
            self.front(u, seen).try();
        });
        Ok(());
    }

    // THE ONE IMPORT NOBODY WRITES. "`std.core` is imported into every
    // module, so `Res`, `Ok`, `Vec`, `Map`, `str`, `Env` and the rest
    // are in scope everywhere without a line" — and a walk that follows
    // imports will never follow the line that is not there.
    //
    // Law 2 makes `main = (env: Env) ..` the signature every program in
    // the language opens with, so the first program anyone writes names
    // `Env`, writes no import, and had no prelude in its `World` at all.
    // Every prelude name was undefined, not just `Env`.
    //
    // PROBED, NOT REQUIRED. A root with no `std/` beside it is a
    // program with no prelude, which `World.prelude_index` already
    // answers `None` to and which the small multi-file tests in
    // tests/corpus are. A missing prelude is not a fault, so nothing
    // here counts one.
    seed_prelude = (self :: @Self, seen :: Vec<Unit>) Res<(), AllocError> {
        flat = self.dotted_path(PRELUDE, false).try();
        self.env.fs.exists(flat).match({
            true  => self.queue(flat, seen),
            false => self.seed_prelude_folder(seen),
        })
    }

    seed_prelude_folder = (self :: @Self, seen :: Vec<Unit>)
                          Res<(), AllocError> {
        nest = self.dotted_path(PRELUDE, true).try();
        self.env.fs.exists(nest).match({
            true  => self.queue(nest, seen),
            false => Ok(()),
        })
    }

    // `file_of`'s rule over a DOTTED STRING rather than a parsed
    // `QualifiedName`: the prelude is named by a constant and no import
    // wrote it, so there is no AST node to read the segments off.
    dotted_path = (self: @Self, dotted: str, folder: bool)
                  Res<str, AllocError> {
        out ::= self.alloc.String("{}/", self.root).try();
        Range(0, dotted.len).loop((h, i) {
            out.add_byte(slash_for(dotted.index(i))).try();
        });
        folder.then(() {
            out.add_byte('/').try();
            out.add_bytes(last_segment(dotted)).try();
        });
        out.add_bytes(".zen").try();
        Ok(out.view());
    }

    // `<root>/a/b/c.zen`, or `<root>/a/b/c/c.zen` when the last segment
    // names a folder. The plain form is probed first because it is the
    // common one, and a folder that also has a file beside it is a
    // collision the module graph would reject anyway.
    file_of = (self: @Self, q: QualifiedName) Res<str, AllocError> {
        flat = self.joined(q, false).try();
        self.env.fs.exists(flat).match({
            true  => Ok(flat),
            false => self.joined(q, true),
        })
    }

    joined = (self: @Self, q: QualifiedName, folder: bool) Res<str, AllocError> {
        out ::= self.alloc.String("{}", self.root).try();
        q.segments.loop((h, s) {
            out.add_byte('/').try();
            out.add_bytes(s.text).try();
        });
        folder.then(() {
            out.add_byte('/').try();
            out.add_bytes(last_of(q)).try();
        });
        out.add_bytes(".zen").try();
        Ok(out.view());
    }

    // -----------------------------------------------------------------
    // one module: read, lex, parse
    // -----------------------------------------------------------------

    front = (self :: @Self, u: Unit, seen :: Vec<Unit>) Res<(), AllocError> {
        self.read(u.path).match({
            None     => Ok(()),
            Ok(text) => self.lex_it(u, text, seen),
        })
    }

    read = (self :: @Self, path: str) Res<String> {
        self.env.fs.read(self.alloc, path).match({
            Ok(text) => Ok(text),
            Err(e)   => self.fs_fault(path, e),
        })
    }

    fs_fault = (self :: @Self, path: str, e: FsError) Res<String> {
        self.faults = self.faults + 1;
        println("{}: {}", path, fs_message(e));
        None;
    }

    // A FILE WITH LEXICAL FAULTS IS REPORTED AND NOT PARSED. That is
    // `lex.zen`'s contract and not a shortcut: tree-sitter's opinion of
    // the wreckage was only ever a second diagnostic for one mistake,
    // and a hand-written parser's would be no better.
    lex_it = (self :: @Self, u: Unit, text: String, seen :: Vec<Unit>)
             Res<(), AllocError> {
        lexed = scan(self.alloc, Source(file: u.rel, text: text.view())).try();
        lexed.is_clean().match({
            false => self.lex_faults(lexed),
            true  => self.parse_it(u, lexed, seen),
        })
    }

    lex_faults = (self :: @Self, lexed: Lexed) Res<(), AllocError> {
        n ::= 0;
        lexed.diags.loop((h, d) {
            n = n + 1;
            println("{}:{}:{}: {}", d.file, d.span.start.line, d.span.start.col,
                    message(d.fault));
        });
        self.faults = self.faults + n;
        Ok(());
    }

    // ONE TREE, HANDED ALONG. The parser is built around the tree the
    // walk has filled so far and the tree is read back off it before the
    // next module is lexed, so every module in the program is in one
    // arena and an id means the same thing everywhere. There is one
    // parser alive at a time, which is what makes passing an `Ast` by
    // value sound: a `Vec` is a header, and two owners would diverge the
    // first time either grew.
    //
    // The order is the walk's order and the walk queues the entry first,
    // so module 0 is the root — which is what `emit_c` passes to the
    // backend and what `sema`'s `DefId.module` indexes.
    parse_it = (self :: @Self, u: Unit, lexed: Lexed, seen :: Vec<Unit>)
               Res<(), AllocError> {
        p ::= self.alloc.Parser(lexed, self.tree);
        m = p.module(u.name).try();
        n ::= 0;
        p.diags.loop((h, d) {
            n = n + 1;
            println("{}:{}:{}: {}", d.span.file, d.span.start.line,
                    d.span.start.col, d.message);
        });
        self.faults = self.faults + n;
        p.tree.add_module(m).try();
        self.tree = p.tree;
        self.units = self.units + 1;
        self.imports_of(m, seen).try();
        Ok(());
    }

    // Every module this one names, queued. An import is the only
    // declaration that reaches outside the file — except for the one
    // below it, which is why this match has two arms and not one.
    imports_of = (self :: @Self, m: Module, seen :: Vec<Unit>)
                 Res<(), AllocError> {
        m.decls.loop((h, d) {
            d.kind.match({
                Import(im) => self.enqueue(im.module, seen),
                Alias(al)  => self.alias_of(al, seen),
                _          => Ok(()),
            }).try();
        });
        Ok(());
    }

    enqueue = (self :: @Self, q: QualifiedName, seen :: Vec<Unit>)
              Res<(), AllocError> {
        self.queue(self.file_of(q).try(), seen)
    }

    // Queued on the PATH, because the path is the module and a spelling
    // is only a way of writing it: `std.core` and `std.core.core` reach
    // one file and must reach one `Unit`.
    queue = (self :: @Self, path: str, seen :: Vec<Unit>)
            Res<(), AllocError> {
        seen.find((u) { u.path.eq(path) }).match({
            Ok(_) => Ok(()),
            None  => self.queue_fresh(path, seen),
        })
    }

    queue_fresh = (self :: @Self, path: str, seen :: Vec<Unit>)
                  Res<(), AllocError> {
        seen.add(self.unit_at(path).try())
    }

    // A MODULE ALIAS IS AN `Alias`, NOT AN `Import`. `sh = shape` and
    // `Alias = Shape` are the same three tokens, and only name
    // resolution can say which — so a syntactic walk, which this is by
    // necessity because it runs before sema, cannot know.
    //
    // So a bare single-segment target is a CANDIDATE: probed, and
    // queued only when a file is actually there. The probe cannot live
    // in `enqueue`, because a missing file behind a real import is a
    // fault and has to stay one — a `Shape` that is a type would
    // otherwise report a module nobody asked for.
    alias_of = (self :: @Self, al: Alias, seen :: Vec<Unit>)
               Res<(), AllocError> {
        self.tree.type_at(al.target).kind.match({
            Named(n) => self.alias_named(n, seen),
            _        => Ok(()),
        })
    }

    // `Vec<u8>` names no module: a module path takes no type arguments.
    alias_named = (self :: @Self, n: Named, seen :: Vec<Unit>)
                  Res<(), AllocError> {
        (n.args.len == 0).match({
            false => Ok(()),
            true  => self.probe(n.name.text, seen),
        })
    }

    probe = (self :: @Self, name: str, seen :: Vec<Unit>)
            Res<(), AllocError> {
        u = self.candidate(name).try();
        self.env.fs.exists(u.path).match({
            false => Ok(()),
            true  => self.queue(u.path, seen),
        })
    }

    // -----------------------------------------------------------------
    // check
    // -----------------------------------------------------------------

    // Check and emit are ONE method because they share a `Checker`:
    // `CBackend` takes the one sema built, so a type is decided once and
    // the backend never re-derives it.
    //
    // ANY NUMBER OF MODULES REACHES THEM. `alloc.Checker(tree)` takes
    // ONE `Ast` and reads every module out of it — `World` is built by
    // walking `tree.module_count()` — and `parse_it` hands the one tree
    // from parser to parser, so the whole program is already in it.
    //
    // NOTHING PARSED IS NOT AN ERROR HERE. The read or the lex already
    // said why, and complaining about sema on top of that is "one
    // mistake, one diagnostic" broken by the driver itself. A tree with
    // no modules is also a tree `Checker` would walk zero times, so the
    // guard is about the diagnostic and not about the crash.
    //
    // SYNTAX FAULTS DO NOT SKIP THE CHECK, and that is this file's own
    // header: "the second mistake in a build is worth as much as the
    // first". A poison node types as unknown, which is what a poison
    // node is for; the tally is what the exit code reads and it already
    // counted the syntax error.
    back_end = (self :: @Self, job: Job) Res<(), AllocError> {
        (self.units == 0).match({
            true  => Ok(()),
            false => self.check_tree(job),
        })
    }

    // `check_all` IS THE WALK, and the driver does not get to write its
    // own. `sema_decl.zen` is "deliberately the only walk in the folder"
    // and it is the only thing that knows the protocol: a body's
    // parameters, type parameters and bounds have to be in scope while
    // `block_type` walks it, and they have to leave again before the
    // next declaration. A driver that called `block_type` on each body
    // itself would report every parameter of every function undefined,
    // which is what this one did.
    check_tree = (self :: @Self, job: Job) Res<(), AllocError> {
        c ::= self.alloc.Checker(self.tree).try();
        c.check_all().try();
        report ::= self.alloc.String("").try();
        c.render_diags(report).try();
        n = c.diag_count();
        self.faults = self.faults + n;
        (n > 0).then(() { println("{}", report.view()); });
        absent = self.missing_main(c, job).try();
        self.faults = self.faults + absent;
        ((n + absent) == 0).then(() { self.emit(c, job).try(); });
        Ok(());
    }

    // LAW 2 IS A LAW ABOUT PROGRAMS, and a root that declares no `main`
    // is not one. Nothing else in the pipeline notices: an empty file
    // lexes clean, parses to a module with no declarations, checks
    // without a complaint, and emits a translation unit that links to
    // nothing — so the compiler reported success for a file with no
    // program in it, and `tests/must-fail/lex/empty_file` and
    // `only_comments` sat red saying exactly that.
    //
    // MODULE 0 AND `own_defs`, both deliberately. The walk queues the
    // entry first, so module 0 is the root; and `defs_of` would fall
    // through to the imports and then the prelude, which means a `main`
    // ANYWHERE in the program would answer for the one the root owes.
    //
    // ASKED ONLY WHEN A PROGRAM IS BEING PRODUCED. `emit_c` is what
    // separates "compile this into a program" from "walk this root and
    // tell me what you found", and the second is a real question —
    // `tests/corpus/cli/` points the driver at a library on purpose to
    // measure the entry probe. Demanding `main` of a build that emits
    // nothing would fail those for having no program in a test that
    // never asked for one.
    missing_main = (self :: @Self, c :: Checker, job: Job)
                   Res<usize, AllocError> {
        job.emit_c.match({
            false => Ok(0),
            true  => self.root_declares_main(c),
        })
    }

    root_declares_main = (self :: @Self, c :: Checker) Res<usize, AllocError> {
        found ::= self.alloc.Vec<Def>();
        c.world.own_defs(0, ENTRY, found).try();
        (found.len > 0).match({
            true  => Ok(0),
            false => self.no_main(),
        })
    }

    // 1:1, because the mistake is the file and not a place in it.
    no_main = (self :: @Self) Res<usize, AllocError> {
        println("{}:1:1: no `{}`: law 2 makes `main = (env: Env) Res<i32, E>` where a program starts, and this root declares none",
                self.entry_rel, ENTRY);
        Ok(1);
    }

    // -----------------------------------------------------------------
    // emit
    // -----------------------------------------------------------------

    // A PROGRAM SEMA AGREED IS A PROGRAM, and only then. Handing the
    // backend a tree with unresolved names in it turns one diagnostic
    // into a second, worse one — which is why `check_tree` calls this
    // only when the count is zero.
    emit = (self :: @Self, c :: Checker, job: Job) Res<(), AllocError> {
        job.emit_c.match({
            false => Ok(()),
            true  => self.emit_c(c, job),
        })
    }

    // Module 0 is the root: the walk queues the entry first, and a
    // backend's roots are the functions the module it was asked to
    // compile declares.
    emit_c = (self :: @Self, c :: Checker, job: Job) Res<(), AllocError> {
        be ::= self.alloc.CBackend(self.tree, c).try();
        out ::= self.alloc.Emit().try();
        emit_program(be, 0, out).try();
        report ::= self.alloc.String("").try();
        be.render_diags(report).try();
        n = be.diag_count();
        self.faults = self.faults + n;
        (n > 0).then(() { println("{}", report.view()); });
        (n == 0).then(() { self.deliver(job, out).try(); });
        Ok(());
    }

    // WHERE THE BYTES GO. `-o <path>` writes the file; no `-o` sends the
    // C to stdout, which is what `-o -` would mean anyway.
    //
    // This used to be a FAULT — `std.env.Fs` was `read`, `exists` and
    // `is_dir`, so a compiler that emits C could not write one, and a
    // build that was asked for a file and produced none had to say so
    // rather than let the exit code lie. `Fs.write` closed it, exactly
    // as the note here predicted it would.
    //
    // A write that fails is a fault and not a trap: the disk being full
    // or the path being unwritable is a thing the caller acts on, and
    // `scripts/fixpoint.sh` compares files that have to exist.
    deliver = (self :: @Self, job: Job, out: Emit) Res<(), AllocError> {
        job.out.is_empty().match({
            true  => { println("{}", out.view()); Ok(()) },
            false => self.write_out(job, out),
        })
    }

    write_out = (self :: @Self, job: Job, out: Emit) Res<(), AllocError> {
        self.env.fs.write(job.out, out.view()).match({
            Ok(_)  => Ok(()),
            Err(e) => self.write_failed(job, e),
        })
    }

    write_failed = (self :: @Self, job: Job, e: FsError) Res<(), AllocError> {
        self.faults = self.faults + 1;
        println("-o {}: {}", job.out, fs_message(e));
        Ok(());
    }

    // -----------------------------------------------------------------

    // 0 when the build is clean, 1 when anything at all went wrong.
    // One code and not one per phase: a caller acts on "did this
    // produce a program", and `tests/run.py` and `scripts/fixpoint.sh`
    // both read exactly that.
    code* = (self: @Self) i32 {
        (self.faults == 0).match({
            true  => 0,
            false => 1,
        })
    }
}

// `alloc.Build(env, root)` — a ufcs function whose first parameter is an
// Alloc, beside the type it builds, exactly as `Vec`, `Ast` and `Parser`
// are.
Build* = (a: Alloc, env: Env, root: str) Build {
    Build(env: env, alloc: a, root: root, tree: a.Ast())
}

// THE ENTRY POINT of this file: one command line's worth of build.
build* = (env: Env, a: Alloc, job: Job) Res<i32, AllocError> {
    b ::= a.Build(env, job.root);
    entry = b.entry_of(job.entry).try();
    b.walk(entry).try();
    b.back_end(job).try();
    Ok(b.code());
}

// The last path component of a root — `probe` of `tests/corpus/x/probe`
// — which is what a folder repeats to name its root file. A root with no
// `/` in it is already its own basename, which is why `cut` starts at 0.
base_of = (root: str) str {
    root.slice(after_last_slash(root), root.len);
}

// One past the last `/`, and 0 when there is none — which is what makes
// a path with a single component its own last component.
after_last_slash = (path: str) usize {
    cut ::= 0;
    Range(0, path.len).loop((h, i) {
        (path.index(i) == '/').then(() { cut = i + 1; });
    });
    cut
}

// THE MODULE A PATH IS, and the name a `Unit` carries.
//
// The path relative to the root, with the separators as dots and the
// extension off: `<root>/a/b/c.zen` is `a.b.c`. That is the file's
// IDENTITY and it is one name, which is the point — a folder root has
// a second, shorter spelling (`std.core` for `std/core/core.zen`) and
// naming the module after whichever spelling arrived first is what made
// one file two modules with one set of declarations.
//
// The short spelling is not lost: it is a way of WRITING the identity
// rather than a second identity, and `World.index_of` is where the two
// meet — the same split `bootstrap/modules.py` draws between a file's
// `dotted` and the aliases its `_module_index` maps onto it.
module_name* = (a: Alloc, root: str, path: str) Res<str, AllocError> {
    inner = path.slice(root.len + 1, path.len - EXT_BYTES);
    out ::= a.String().try();
    Range(0, inner.len).loop((h, i) {
        out.add_byte(dot_for(inner.index(i))).try();
    });
    Ok(out.view());
}

// The same file, said relative to the compilation root: `module_name`
// without the dots and without dropping the extension. One `+ 1` for
// the separator, and a path that is not under the root comes back
// unchanged rather than being sliced into nonsense.
relative_to* = (root: str, path: str) str {
    (path.len > root.len + 1).match({
        true  => path.slice(root.len + 1, path.len),
        false => path,
    });
}

// `.zen`, and it is written here because `module_name` is the one place
// that has to take it back off.
EXT_BYTES : usize = 4

dot_for = (b: u8) u8 {
    (b == '/').match({ true  => '.', false => b })
}

// The inverse, for the one module named by a dotted CONSTANT rather
// than by a path: `std.core` is the prelude's name and `<root>/std/
// core.zen` is where its bytes are.
slash_for = (b: u8) u8 {
    (b == '.').match({ true  => '/', false => b })
}

// The last segment of a dotted name — `mem` of `std.mem` — which is what
// a folder repeats to name its root file.
last_of = (q: QualifiedName) str {
    q.segments.get(q.segments.len - 1).match({
        Ok(s) => s.text,
        None  => "",
    })
}

// What went wrong with a file, in the words the capability uses. Every
// one of these names the file it happened to, because "bad arguments" is
// not a reason and neither is "io error".
fs_message* = (e: FsError) str {
    e.match({
        NotFound    => "nothing is at that path",
        Denied      => "this process may not read it",
        IsDir       => "the path names a directory, and a directory is not bytes",
        Failed      => "the read started and did not finish",
        OutOfMemory => "the buffer could not be obtained",
    })
}
