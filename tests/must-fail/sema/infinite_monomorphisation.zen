// every call wraps T one layer deeper, so the instantiation set is
// infinite: grow<i32>, grow<Vec<i32>>, grow<Vec<Vec<i32>>>, ...
// sema must stop with a diagnostic. eating 64GB is not a diagnostic.
//
// position: the recursive call that widens T.

grow = <T>(alloc: Alloc, x: T) Res<(), AllocError> {
    v ::= alloc.Vec<T>();
    v.add(x).try();
    grow<Vec<T>>(alloc, v).try();
    Ok(());
}

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    grow<i32>(alloc, 1).try();
    Ok(0);
}
