// Zero is the lower valid boundary for a fixed-array count. The backend
// widens its physical C storage to one element while sema retains count zero.

accepts_zero = (xs: [u8, 0]) usize { 0 }

main = (env: Env) Res<i32, AllocError> {
    empty: [u8, 0] = [];
    println("{}", accepts_zero(empty));
    Ok(0);
}
