// `len` is BYTES (text_str.zen says so outright) and `count_codepoints`
// is the walk that pays for the character guarantee. One string carries
// all four sequence widths plus trailing ASCII: 1+2+3+4+1 = 11 bytes.
//
// The two numbers only agree with the truth when every step size is
// right: decode one byte short and the walk lands mid-sequence;
// double-step and both counts move together. The five decoded VALUES at
// the end pin each width's arithmetic individually -- a wrong
// continuation scale (5 payload bits instead of the correct 6) changes
// 233 or 8364 or 128512 while leaving every length untouched.
Utf8Error = std.text.text_utf8

main = (env: Env) Res<i32, Utf8Error> {
    s = "aé€😀b";
    println("len {}", s.len);
    println("cps {}", s.count_codepoints().try());
    walk ::= s.codepoints();
    first ::= walk.next().try();
    second ::= walk.next().try();
    third ::= walk.next().try();
    fourth ::= walk.next().try();
    fifth ::= walk.next().try();
    println("{} {} {} {} {}", first, second, third, fourth, fifth);
    Ok(0);
}
