// tests/corpus/std/vec_grows_past_eight.zen
// grow takes capacity 0 -> 8 on the first add, then 8 -> 16 on the
// ninth: the ninth add is the one that reallocs. every element must
// survive the move, in order. a Vec that has never grown has never
// been tested

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    v     ::= alloc.Vec<i32>();

    Range<i32>(0, 9).loop((h, n) {
        v.add(n * 10).try();
    });

    println("len {}", v.len);
    v.loop((h, n) {
        println("{}", n);
    });
    Ok(0);
}
