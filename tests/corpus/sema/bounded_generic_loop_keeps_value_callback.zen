// The bounded receiver cannot select the bool or condition-closure overload
// while its element type is still open. Nested wrappers keep the same value.
walk = <R: Range<T>, T>(range: R, body: (value: T) ()) () {
    range.loop((value) { body(value); });
}

walk_again = <R: Range<T>, T>(range: R, body: (value: T) ()) () {
    walk(range, (value) { body(value); });
}

source = (calls :: usize) Range<usize> {
    calls = calls + 1;
    Range<usize>(2, 5)
}

main = (env: Env) Res<i32, AllocError> {
    calls: usize ::= 0;
    sum: usize   ::= 0;
    walk_again(source(calls), (n) { sum = sum + n * 2; });
    println("range {} calls {}", sum, calls);
    walk_again([str, 2]("a", "b"), (value) { println("array {}", value); });
    alloc  ::= env.mem.alloc();
    values ::= alloc.Vec<usize>();
    values.add(5).try();
    values.add(7).try();
    walk_again(values, (n) { println("vec {}", n * 2); });
    loop(true, (h) { println("bool"); h.break(); });
    remaining: usize ::= 2;
    loop(() { remaining > 0 }, (h) {
        println("condition {}", remaining);
        remaining = remaining - 1;
    });
    Ok(0);
}
