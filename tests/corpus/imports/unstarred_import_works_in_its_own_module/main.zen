// The gate on an unstarred import, seen from INSIDE the module that
// wrote it: mid imports leaf's `double` WITHOUT a star, uses it in its
// own body, and stars only `quad`. leaf's name does not travel.
//
// The arithmetic is deliberately asymmetric -- n*3+1 applied twice is
// 22 from 2, while a truncated single application gives 7 and a zeroed
// binding gives 0 -- so any pass that resolves `double` inside mid to
// nothing prints a plausible number that is not 22. This is the
// positive half of unstarred_import_stays_private: the name WORKS
// where it was imported; it just doesn't leave with quad.
//
// One-line breaker: drop unstarred bindings from the importing
// module's own scope -> "cannot resolve `double`" (or 0 / 7 printed).

quad = mid.mid

main = (env: Env) Res<i32, IoError> {
    println("{}", quad(2));
    Ok(0);
}
