// tests/harness_math.zen — the MATH category of the Zen-native correctness harness. Exercises the
// std.math surface (libm-bound roots/trig/rounding, pure-Zen integer helpers, generics, constants, and
// float classification) end to end: each VCase's `src` imports std.math, computes an integer, and the
// emitted+compiled program must print `want`. Floats are checked with an epsilon by SCALING to an
// integer (e.g. `to_i64(sqrt(2.0) * 1000.0)` == 1414) — the value runner links libm on this platform, so
// the libm symbols resolve without an explicit `-lm`. See harness_lib.zen for the runner contract.
//
// Every libm case is evaluated OFF its fixed point. sin/tan/sinh/tanh at 0 and exp/cosh at 0 all agree
// with a constant stub, so the 0-point cases below cannot tell `sin` from `tan` from `{ 0.0 }` — stubbing
// sin/tan/sinh/tanh/expm1/log1p left the whole math suite green. The 1.0 cases beside them discriminate.
//
// (Per-case notes are kept OUT of the VCase list on purpose: the formatter hoists comments that sit
// between call arguments, so each case's `want` and its `src` expression are left to document themselves.)
{ VCase, run_values } = harness_lib
harness_math_run* = () i32 {
    run_values("math", [VCase(
        src: "{ sqrt } = std.math\ntest* = () i64 { to_i64(sqrt(2.0) * 1000.0) }",
        want: "1414",
    ), VCase(
        src: "{ cbrt } = std.math\ntest* = () i64 { to_i64(cbrt(27.0)) }",
        want: "3",
    ), VCase(
        src: "{ pow } = std.math\ntest* = () i64 { to_i64(pow(2.0, 10.0)) }",
        want: "1024",
    ), VCase(
        src: "{ hypot } = std.math\ntest* = () i64 { to_i64(hypot(3.0, 4.0)) }",
        want: "5",
    ), VCase(
        src: "{ exp2 } = std.math\ntest* = () i64 { to_i64(exp2(10.0)) }",
        want: "1024",
    ), VCase(
        src: "{ log2 } = std.math\ntest* = () i64 { to_i64(log2(8.0)) }",
        want: "3",
    ), VCase(
        src: "{ log10 } = std.math\ntest* = () i64 { to_i64(log10(1000.0)) }",
        want: "3",
    ), VCase(
        src: "{ expm1, log1p } = std.math\ntest* = () i64 { to_i64(expm1(0.0)) + to_i64(log1p(0.0)) }",
        want: "0",
    ), VCase(
        src: "{ floor } = std.math\ntest* = () i64 { to_i64(floor(3.7)) }",
        want: "3",
    ), VCase(
        src: "{ ceil } = std.math\ntest* = () i64 { to_i64(ceil(3.2)) }",
        want: "4",
    ), VCase(
        src: "{ round } = std.math\ntest* = () i64 { to_i64(round(2.5)) }",
        want: "3",
    ), VCase(
        src: "{ trunc } = std.math\ntest* = () i64 { to_i64(trunc(0.0 - 3.7)) }",
        want: "-3",
    ), VCase(
        src: "{ fmod } = std.math\ntest* = () i64 { to_i64(fmod(10.0, 3.0)) }",
        want: "1",
    ), VCase(
        src: "{ atan2 } = std.math\ntest* = () i64 { to_i64(atan2(1.0, 1.0) * 1000.0) }",
        want: "785",
    ), VCase(
        src: "{ cos, sin, tan } = std.math\ntest* = () i64 { to_i64(cos(0.0) * 100.0) + to_i64(sin(0.0)) + to_i64(tan(0.0)) }",
        want: "100",
    ), VCase(
        src: "{ asin } = std.math\ntest* = () i64 { to_i64(asin(1.0) * 1000.0) }",
        want: "1570",
    ), VCase(
        src: "{ acos } = std.math\ntest* = () i64 { to_i64(acos(0.0) * 1000.0) }",
        want: "1570",
    ), VCase(
        src: "{ atan } = std.math\ntest* = () i64 { to_i64(atan(1.0) * 1000.0) }",
        want: "785",
    ), VCase(
        src: "{ cosh, tanh, sinh } = std.math\ntest* = () i64 { to_i64(cosh(0.0)) + to_i64(sinh(0.0)) + to_i64(tanh(0.0)) }",
        want: "1",
    ), VCase(
        src: "{ exp, log } = std.math\ntest* = () i64 { to_i64(exp(0.0)) + to_i64(log(1.0)) }",
        want: "1",
    ), VCase(
        src: "{ sin, tan } = std.math\ntest* = () i64 { to_i64(sin(1.0) * 1000.0) + to_i64(tan(1.0) * 1000.0) }",
        want: "2398",
    ), VCase(
        src: "{ cosh, tanh, sinh } = std.math\ntest* = () i64 { to_i64(cosh(1.0) * 1000.0) + to_i64(sinh(1.0) * 1000.0) + to_i64(tanh(1.0) * 1000.0) }",
        want: "3479",
    ), VCase(
        src: "{ expm1, log1p } = std.math\ntest* = () i64 { to_i64(expm1(1.0) * 1000.0) + to_i64(log1p(1.0) * 1000.0) }",
        want: "2411",
    ), VCase(
        src: "{ exp } = std.math\ntest* = () i64 { to_i64(exp(1.0) * 1000.0) }",
        want: "2718",
    ), VCase(
        src: "{ abs } = std.math\ntest* = () i64 { abs(0 - 5) }",
        want: "5",
    ), VCase(
        src: "{ fabs } = std.math\ntest* = () i64 { to_i64(fabs(0.0 - 3.5) * 1000.0) }",
        want: "3500",
    ), VCase(
        src: "{ sign } = std.math\ntest* = () i64 { sign(0 - 3) * 100 + sign(7) * 10 + sign(0) }",
        want: "-90",
    ), VCase(
        src: "{ fsign } = std.math\ntest* = () i64 { to_i64(fsign(0.0 - 2.0)) }",
        want: "-1",
    ), VCase(
        src: "{ gcd } = std.math\ntest* = () i64 { gcd(12, 18) }",
        want: "6",
    ), VCase(
        src: "{ lcm } = std.math\ntest* = () i64 { lcm(4, 6) }",
        want: "12",
    ), VCase(
        src: "{ pow_i } = std.math\ntest* = () i64 { pow_i(2, 10) }",
        want: "1024",
    ), VCase(
        src: "{ ipow } = std.math\ntest* = () i64 { ipow(3, 4) }",
        want: "81",
    ), VCase(
        src: "{ isqrt } = std.math\ntest* = () i64 { isqrt(17) }",
        want: "4",
    ), VCase(
        src: "{ isqrt } = std.math\ntest* = () i64 { isqrt(144) * 100 + isqrt(143) }",
        want: "1211",
    ), VCase(
        src: "{ clamp } = std.math\ntest* = () i64 { clamp<i64>(5, 0, 3) }",
        want: "3",
    ), VCase(
        src: "{ clamp } = std.math\ntest* = () i64 { to_i64(clamp<f64>(0.0 - 2.0, 0.0, 3.0)) }",
        want: "0",
    ), VCase(
        src: "{ min, max } = std.math\ntest* = () i64 { min<i64>(3, 8) * 10 + max<i64>(3, 8) }",
        want: "38",
    ), VCase(
        src: "{ min, max } = std.math\ntest* = () i64 { to_i64(min<f64>(3.0, 8.0)) * 10 + to_i64(max<f64>(3.0, 8.0)) }",
        want: "38",
    ), VCase(
        src: "{ lerp } = std.math\ntest* = () i64 { lerp<i64>(0, 10, 2) + to_i64(lerp<f64>(0.0, 10.0, 0.5)) }",
        want: "25",
    ), VCase(
        src: "{ isnan, NAN } = std.math\ntest* = () i64 { isnan(NAN).then({ 1 }, { 0 }) + isnan(3.5).then({ 100 }, { 0 }) }",
        want: "1",
    ), VCase(
        src: "{ isinf, INF } = std.math\ntest* = () i64 { isinf(INF).then({ 10 }, { 0 }) + isinf(0.0 - INF).then({ 1 }, { 0 }) + isinf(3.5).then({ 100 }, { 0 }) }",
        want: "11",
    ), VCase(
        src: "{ isfinite, INF, NAN } = std.math\ntest* = () i64 { isfinite(3.5).then({ 1 }, { 0 }) + isfinite(INF).then({ 10 }, { 0 }) + isfinite(NAN).then({ 100 }, { 0 }) }",
        want: "1",
    ), VCase(
        src: "{ PI } = std.math\ntest* = () i64 { to_i64(PI * 1000.0) }",
        want: "3141",
    ), VCase(
        src: "{ E } = std.math\ntest* = () i64 { to_i64(E * 1000.0) }",
        want: "2718",
    ), VCase(
        src: "{ TAU } = std.math\ntest* = () i64 { to_i64(TAU * 1000.0) }",
        want: "6283",
    ), VCase(
        src: "{ SQRT2, sqrt } = std.math\ntest* = () i64 { to_i64(SQRT2 * 1000.0) + (to_i64(SQRT2 * 100000.0) == to_i64(sqrt(2.0) * 100000.0)).then({ 0 }, { 100000 }) }",
        want: "1414",
    ), VCase(
        src: "{ LN2, log } = std.math\ntest* = () i64 { to_i64(LN2 * 100000.0) + (to_i64(LN2 * 100000.0) == to_i64(log(2.0) * 100000.0)).then({ 0 }, { 100000 }) }",
        want: "69314",
    ), VCase(
        src: "{ LN10 } = std.math\ntest* = () i64 { to_i64(LN10 * 100000.0) }",
        want: "230258",
    ), VCase(
        src: "{ degrees, radians, PI } = std.math\ntest* = () i64 { to_i64(degrees(PI)) * 10000 + to_i64(radians(180.0) * 1000.0) }",
        want: "1803141",
    ), VCase(
        src: "{ fpow } = std.math\ntest* = () i64 { to_i64(fpow(2.0, 0 - 2) * 1000.0) }",
        want: "250",
    )])
}
