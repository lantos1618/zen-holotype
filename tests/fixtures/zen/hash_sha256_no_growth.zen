// std.hash.sha256 must not GROW THE HEAP with the number of calls.
//
// Every fixed buffer SHA-256 needs — the round constants, the message schedule, the running hash, the
// digest cell — used to be a slice literal bound to a LOCAL, and the C backend heap-promotes those
// (gen_slicelit) and never frees them: 1120 bytes leaked per sha256_hex call, linearly, while the
// module's own header claimed "no hidden heap". A valgrind sweep found it; this pins it.
//
// The teeth are the SHAPE of the measurement, not one number: live heap bytes are read before and
// after a 100-iteration run and again after a 200-iteration run, and BOTH deltas must be zero. A
// constant one-off allocation therefore passes (it lands in the warm-up), and only growth-per-call
// fails — which is exactly the class of leak worth a gate. The digests are re-checked against the
// published vectors in the same pass, so a "fix" that stops allocating by breaking the algorithm
// fails here too.
//
// PORTABILITY: `mallinfo2` is glibc (Linux). It is bound through the SysV x86-64 large-struct-return
// convention — hidden result pointer in as arg 0, handed back in rax — which is why the decl reads
// `(arg0: RawPtr<u8>) RawPtr<u8>`; `hg_abi_ok` verifies that at runtime and the case SKIPS (passes) when the
// convention does not hold, rather than reporting a number nobody can trust. Same binding, same
// caveat, as tests/harness_bench.zen's liveB/op column.
{ sha256_hex } = std.hash
{ AllocatorBackend, malloc, free } = std.mem.alloc
{ view, eq } = std.text.str
{ to_exit } = std.core.bool
{ times } = std.core.count
{ put } = std.io.print
halloc = std.mem.heap
mallinfo2 = (out: RawPtr<u8>) RawPtr<u8>
// struct mallinfo2 is ten size_t words; the two that matter are `uordblks` (bytes handed out of the
// brk arena) and `hblkhd` (bytes in mmap'd blocks — where glibc serves anything over ~128 KiB).
HG_MI_SIZE = () i64 { 80 }
HG_HBLKHD_OFF = () i64 { 32 }
HG_UORDBLKS_OFF = () i64 { 56 }
hg_live = (cell: RawPtr<u8>) i64 {
    mallinfo2(cell)
    load_i64(cell.offset(HG_UORDBLKS_OFF())) + load_i64(cell.offset(HG_HBLKHD_OFF()))
}
hg_abi_ok = (cell: RawPtr<u8>) bool { to_i64(mallinfo2(cell)) == to_i64(cell) }
// The published SHA-256 of "abc" (FIPS 180-4 appendix B.1) — the value `sha256sum` prints.
HG_ABC = () StringView { "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" }
// hash "abc" `n` times, releasing each result; returns how many produced the published digest.
hg_hash_n<A: AllocatorBackend> = (a: MutPtr<A>, n: i64) i64 {
    good :: i64 = 0
    n.times((i) {
        h = a.sha256_hex("abc".view())
        good = good + h.eq(HG_ABC()).then({ 1 }, { 0 })
        a.release(h.view().ptr)
    })
    good
}
main = () i32 {
    alloc = halloc.gpa()
    a = alloc.addr()
    cell = malloc(HG_MI_SIZE())
    // Warm-up: any ONE-OFF allocation (a first-use scratch cell, an arena's first chunk) happens here
    // so it cannot be mistaken for growth. Deliberate constants are not what this case is hunting.
    warm = a.hg_hash_n(4)
    // `false` = not the glibc large-struct-return ABI this binding assumes, so the numbers would be
    // fiction: the case SKIPS (reads as passing) rather than failing on a platform it cannot measure.
    ok = hg_abi_ok(cell).match ({
        true  => {
            b0 = hg_live(cell)
            g1 = a.hg_hash_n(100)
            b1 = hg_live(cell)
            g2 = a.hg_hash_n(200)
            b2 = hg_live(cell)
            grew = b1 - b0 + (b2 - b1)
            (grew == 0 == false).then({
                put("hash_sha256_no_growth: live heap grew ")
                    .i(b1 - b0)
                    .s(" B over 100 calls and ")
                    .i(b2 - b1)
                    .s(" B over 200 calls\n").n
            })
            grew == 0 && g1 == 100 && g2 == 200
        },
        false => true,
    })
    free(cell)
    (ok && warm == 4).to_exit()
}
