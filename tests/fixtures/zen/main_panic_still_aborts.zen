// NEGATIVE proof for per-actor panic isolation: a panic OUTSIDE a pool worker (here, in `main`) must STILL
// abort the whole process with exit 134, exactly as before isolation existed. The setjmp catch is installed
// ONLY around a pool worker's behavior call, so with no jmp target `zen__panic` calls `__zen_panic_unwind`
// (which returns) and then `abort()`s — the non-actor path is byte-identical. This pins that isolation did
// NOT weaken the normal abort. Asserted by the harness's `main_panic_still_aborts` shell case (exit 134 +
// the `zen: panic: integer divide by zero` line on stderr).
zero = () i64 { 0 }    // opaque 0 so the divide is a runtime div (routes through zen__divz), not folded
main = () i32 {
    d := zero()
    q := 100 / d    // integer divide by zero in main → zen__panic → abort() → 134 (no worker catch installed)
    q.to_i32()
}
