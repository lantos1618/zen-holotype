// tests/corpus/parse/parser_spans.zen
// Position accuracy: the exact span of every node in a small file.
//
// TESTING.md calls this "the one everyone skips and the one that
// decays fastest", and POSITIONS.md is the table it decays against.
// This is that table, executable. The conventions are POSITIONS.md's
// and every one of them is asserted below:
//
//   - 1-based lines, 1-based BYTE columns
//   - half-open: `end` is one past the last byte, so `Point` on line 2
//     is 2:1..2:6
//   - a node's span includes its own delimiters and all its children,
//     and excludes the separator that follows it
//   - a STATEMENT's span includes its `;`; the expression inside it
//     does not
//   - a node's span does NOT include its leading trivia
//   - the module's span is the whole file, trivia included
//
// The source these tokens stand for, with the columns they assert:
//
//   1  // a note
//   2  Point = {
//   3      x: i32,
//   4  }
//   5
//   6  main = () i32 {
//   7      p = Point(x: 3);
//   8      0
//   9  }
//
// src/lex/ did not exist when this was written, so the stream is built
// by hand — which is also what makes the columns above an assertion
// about the PARSER rather than about a scanner.

Token, TokenKind = parse.parse_token
Parser = parse.parser
module = parse.parse_decl
Ast = ast.ast_arena
Span, Pos = ast.ast_span
Decl, Block, Bind = ast.ast_node

at = (k: TokenKind, t: str, line: usize, col: usize, width: usize) Token {
    Token(
        kind: k,
        text: t,
        span: Span(
            file: "t.zen",
            start: Pos(line: line, col: col),
            end: Pos(line: line, col: col + width),
        ),
    )
}

push = (ts :: Vec<Token>, k: TokenKind, t: str, line: usize, col: usize, width: usize) Res<(), AllocError> {
    ts.add(at(k, t, line, col, width))
}

sp = (env: Env, label: str, s: Span) () {
    println("{} {}:{}..{}:{}", label, s.start.line, s.start.col, s.end.line, s.end.col);
}

show_struct = (env: Env, tree: Ast, d: Decl) () {
    d.kind.match({
        Struct(s) => {
            sp(env, "struct.name", s.name.span);
            sp(env, "struct.body", s.body_span);
            s.members.loop((h, mem) {
                sp(env, "member", mem.span);
                mem.kind.match({
                    Field(f) => {
                        sp(env, "field.name", f.name.span);
                        f.type.match({
                            Ok(t) => sp(env, "field.type", tree.type_at(t).span),
                            None  => println("field.type absent"),
                        });
                    },
                    _        => println("member is not a field"),
                });
            });
        },
        _         => println("decl 0 is not a struct"),
    });
}

show_fn = (env: Env, tree: Ast, d: Decl) () {
    d.kind.match({
        Function(f) => {
            sp(env, "fn.name", f.name.span);
            sp(env, "fn.params", f.params_span);
            f.ret.match({
                Ok(t) => sp(env, "fn.ret", tree.type_at(t).span),
                None  => println("fn.ret absent"),
            });
            f.body.match({
                Ok(b) => show_body(env, tree, tree.block_at(b)),
                None  => println("fn.body absent"),
            });
        },
        _           => println("decl 1 is not a function"),
    });
}

show_body = (env: Env, tree: Ast, b: Block) () {
    sp(env, "fn.block", b.span);
    b.stmts.loop((h, s) {
        sp(env, "stmt", s.span);
        s.kind.match({
            Bind(bd) => show_bind(env, tree, bd),
            _        => println("stmt is not a bind"),
        });
    });
    b.value.match({
        Ok(v) => sp(env, "block.value", tree.expr_at(v).span),
        None  => println("block.value absent"),
    });
}

show_bind = (env: Env, tree: Ast, bd: Bind) () {
    sp(env, "bind.target", tree.expr_at(bd.target).span);
    e = tree.expr_at(bd.value);
    sp(env, "bind.value", e.span);
    e.kind.match({
        Call(c) => c.args.loop((h, a) {
            sp(env, "arg", a.span);
            sp(env, "arg.value", tree.expr_at(a.value).span);
        }),
        _       => println("bind.value is not a call"),
    });
}

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    ts ::= alloc.Vec<Token>();

    ts.push(TokenKind.LineComment, "// a note", 1, 1, 9).try();

    ts.push(TokenKind.Ident, "Point", 2, 1, 5).try();
    ts.push(TokenKind.Eq, "=", 2, 7, 1).try();
    ts.push(TokenKind.LBrace, "{", 2, 9, 1).try();

    ts.push(TokenKind.Ident, "x", 3, 5, 1).try();
    ts.push(TokenKind.Colon, ":", 3, 6, 1).try();
    ts.push(TokenKind.Ident, "i32", 3, 8, 3).try();
    ts.push(TokenKind.Comma, ",", 3, 11, 1).try();

    ts.push(TokenKind.RBrace, "}", 4, 1, 1).try();
    ts.push(TokenKind.Blank, "", 5, 1, 0).try();

    ts.push(TokenKind.Ident, "main", 6, 1, 4).try();
    ts.push(TokenKind.Eq, "=", 6, 6, 1).try();
    ts.push(TokenKind.LParen, "(", 6, 8, 1).try();
    ts.push(TokenKind.RParen, ")", 6, 9, 1).try();
    ts.push(TokenKind.Ident, "i32", 6, 11, 3).try();
    ts.push(TokenKind.LBrace, "{", 6, 15, 1).try();

    ts.push(TokenKind.Ident, "p", 7, 5, 1).try();
    ts.push(TokenKind.Eq, "=", 7, 7, 1).try();
    ts.push(TokenKind.Ident, "Point", 7, 9, 5).try();
    ts.push(TokenKind.LParen, "(", 7, 14, 1).try();
    ts.push(TokenKind.Ident, "x", 7, 15, 1).try();
    ts.push(TokenKind.Colon, ":", 7, 16, 1).try();
    ts.push(TokenKind.Int, "3", 7, 18, 1).try();
    ts.push(TokenKind.RParen, ")", 7, 19, 1).try();
    ts.push(TokenKind.Semi, ";", 7, 20, 1).try();

    ts.push(TokenKind.Int, "0", 8, 5, 1).try();
    ts.push(TokenKind.RBrace, "}", 9, 1, 1).try();
    ts.push(TokenKind.Eof, "", 10, 1, 0).try();

    p ::= alloc.Parser(ts, "t.zen");
    m = p.module("t").try();

    sp(env, "module", m.span);
    println("diags {}", p.diags.len);
    println("decls {}", m.decls.len);

    m.decls.get(0).match({
        Ok(d) => {
            sp(env, "decl0", d.span);
            println("decl0.leading {}", d.leading.len);
            show_struct(env, p.tree, d);
        },
        None  => println("no decl 0"),
    });

    m.decls.get(1).match({
        Ok(d) => {
            sp(env, "decl1", d.span);
            show_fn(env, p.tree, d);
        },
        None  => println("no decl 1"),
    });

    Ok(0);
}
