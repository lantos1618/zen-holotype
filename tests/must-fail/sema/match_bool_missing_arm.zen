// bool is an enum with two cases and gets no exemption: one-sided is
// spelled `.then`, which is a different word and cannot be a typo.
//
// position: the match expression (its receiver).

main = (env: Env) Res<i32, AllocError> {
    n = 0;
    (n == 0).match({
        true => println("zero"),
    });
    Ok(0);
}
