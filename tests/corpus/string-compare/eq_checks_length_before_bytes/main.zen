// `==` on str is LENGTH FIRST: text_str.zen's eq refuses to start the byte
// walk at all unless the two lengths agree, because "comparing over the
// shorter length is the classic bug" -- a prefix of identical bytes would
// otherwise read as the whole. Every pair below shares its shorter side's
// bytes exactly; only the length tells them apart.
//
// The one-line change that breaks this file: delete the
// `self.len == other.len` gate in str.impl(Eq, ..)
// (src/std/text/text_str.zen) -- rows 3 and 4 turn true, and a map keyed
// by str starts colliding every prefix onto its extension.
//
// Both operand orders are printed on purpose: a gate written backwards
// (`>=`) or a walk that reads only the RIGHT operand's length keeps one
// row green and flips the other, which is exactly the asymmetry a single
// order hides.

main = (env: Env) Res<i32, AllocError> {
    println("{}", "ab" == "ab");
    println("{}", "ab" == "ac");
    println("{}", "abc" == "abcd");
    println("{}", "abcd" == "abc");
    Ok(0);
}
