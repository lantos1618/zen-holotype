// Blocking HTTP/1.1, one request per connection: responses read to EOF; chunked bodies are decoded,
// otherwise Content-Length trims the body. No TLS, redirects, cookies, or keep-alive.
// Network and parse failures are HttpError values; internal allocation failure panics. Parsed
// responses, requests, and URLs are released with response_free, request_free, and url_free.
{ AllocatorBackend, release_slice } = std.mem.alloc
{ Result, Opt, IoError, ok, err, expect } = std.core.result
{ TcpConn, TcpListener, serve, dial } = std.net.socket
{ String, init, append_in, push_in, finish_in } = std.text.string
{ view, find, substr, split, words, trim, starts_with, to_lower, contains, parse_int, nbuf,
  eq_ignore_case, own_ptr } = std.text.str
{ integer, hex_value } = std.text.num
{ is_hex } = std.text.ascii
{ take, drop, sub } = std.core.slice
{ loop_at } = std.core.count
{ step_while } = std.core.count
HttpError*: Connect(IoError) | Listen(IoError) | Io(IoError) | Malformed(StringView)
connect_err = (e: IoError) HttpError { .Connect(e) }
listen_err = (e: IoError) HttpError { .Listen(e) }
io_err = (e: IoError) HttpError { .Io(e) }
malformed = (m: StringView) HttpError { .Malformed(m) }
http_error_name* = (e: HttpError) StringView {
    e.match ({
        .Connect(x)   => "Connect",
        .Listen(x)    => "Listen",
        .Io(x)        => "Io",
        .Malformed(m) => m,
    })
}
// Only listener failures terminate serve_n.
fatal* = (e: HttpError) bool {
    e.match ({
        .Listen(x) => true,
        _          => false,
    })
}
Header*: {
    name: StringView,
    value: StringView,
}
// body and body_bytes share one allocation. body_bytes preserves embedded NULs; body truncates at
// the first NUL and is for text only.
Response*: {
    status: i32,
    headers: MutSlice<Header>,
    body: StringView,
    body_bytes: MutSlice<u8>,
    header = (r: Response, name: StringView) Opt<StringView> { lookup_header(r.headers, name) }
    ok     = (r: Response) bool { r.status >= 200 && r.status < 300 }
}
lookup_header = (headers: MutSlice<Header>, name: StringView) Opt<StringView> {
    res :: Opt<StringView> = .None
    headers.loop((h, i, hd) {
        hd.name.eq_ignore_case(name).then({
            res = .Some(hd.value)
            h.break
        })
    })
    res
}
// Frees parsed responses only; respond() borrows handler-owned strings.
response_free* = (a: AllocatorBackend, r: Response) void {
    a.release_headers(r.headers)
    a.release_slice(r.body_bytes)
}
crlfcrlf = (v: MutSlice<u8>) i64 {
    at :: i64 = 0 - 1
    v.loop((h, i, b) {
        (i + 4 > v.len).match ({
            true  => {
                h.break
            },
            false => (v[i] == '\r' && v[i + 1] == '\n' && v[i + 2] == '\r' && v[i + 3] == '\n').then({
                at = i
                h.break
            }),
        })
    })
    at
}
// Owns an exact-length byte copy followed by an uncounted NUL.
own_bytes = (a: AllocatorBackend, b: MutSlice<u8>) MutSlice<u8> {
    p = a.try_acquire(b.len + 1).expect("std.net.http: out of memory")
    out :: MutSlice<u8> = p.slice(b.len)
    b.loop_at((i, x) { out[i] = x })
    p.offset(b.len).store(0)
    out
}
release_strs = (a: AllocatorBackend, xs: MutSlice<StringView>) void {
    xs.loop_at((i, x) { a.release(x.own_ptr()) })
    a.release_slice(xs)
}
// Parsed headers own every name/value; caller-built headers do not.
release_headers = (a: AllocatorBackend, hs: MutSlice<Header>) void {
    hs.loop_at((i, hd) {
        a.release(hd.name.own_ptr())
        a.release(hd.value.own_ptr())
    })
    a.release_slice(hs)
}
MsgParts: {
    first: StringView,
    headers: MutSlice<Header>,
    body: MutSlice<u8>,
}
parse_parts = (a: AllocatorBackend, raw: MutSlice<u8>) Result<MsgParts, HttpError> {
    sep = raw.crlfcrlf()
    out: Result<MsgParts, HttpError> = (sep < 0).match ({
        true  => err(malformed("http: no CRLFCRLF header terminator")),
        false => {
            head = a.own_bytes(raw.take(sep))
            body_raw: MutSlice<u8> = raw.drop(sep + 4)
            lines = a.split(cstr(head.ptr), '\n')    // each line still carries a trailing '\r'
            res: Result<MsgParts, HttpError> = a.collect_headers(lines).match ({
                .Err(e)      => {
                    a.release(lines[0].own_ptr())    // `first` escapes on the Ok path only
                    bad: Result<MsgParts, HttpError> = .Err(e)
                    bad
                },
                .Ok(headers) => {
                    ok_res: Result<MsgParts, HttpError> = .Ok(MsgParts(
                        first: lines[0],
                        headers: headers,
                        body: a.decide_body(headers, body_raw),
                    ))
                    ok_res
                },
            })
            lines.loop_at((i, ln) {
                (i > 0).then({
                    a.release(ln.own_ptr())
                })
            })
            a.release_slice(lines)
            a.release(head.ptr)    // the scan buffer; every line is its own copy
            res
        },
    })
    out
}
parse_response* = (a: AllocatorBackend, raw: MutSlice<u8>) Result<Response, HttpError> {
    out: Result<Response, HttpError> = a.parse_parts(raw).match ({
        .Err(e) => .Err(e),
        .Ok(p)  => {
            res: Result<Response, HttpError> = a.parse_status(p.first).match ({
                .Err(e)     => {
                    a.release_headers(p.headers)    // an unparsable status line strands the rest
                    a.release_slice(p.body)
                    bad: Result<Response, HttpError> = .Err(e)
                    bad
                },
                .Ok(status) => {
                    ok_res: Result<Response, HttpError> = .Ok(Response(
                        status: status,
                        headers: p.headers,
                        body: cstr(p.body.ptr),
                        body_bytes: p.body,
                    ))
                    ok_res
                },
            })
            a.release(p.first.own_ptr())    // the status line is read for its code and nothing else
            res
        },
    })
    out
}
parse_status = (a: AllocatorBackend, line: StringView) Result<i32, HttpError> {
    toks = a.words(line)
    out: Result<i32, HttpError> = (toks.len < 2).match ({
        true  => err(malformed("http: status line has fewer than two tokens")),
        false => toks[0].starts_with("HTTP/").match ({
            true  => {
                code = toks[1].parse_int()
                (code < 100 || code > 599).match ({
                    true  => err(malformed("http: status code out of range")),
                    false => ok(to_i32(code)),
                })
            },
            false => err(malformed("http: status line does not start with HTTP/")),
        }),
    })
    a.release_strs(toks)
    out
}
trimmed_cut = (a: AllocatorBackend, s: StringView, start: i64, n: i64) StringView {
    cut = a.substr(s, start, n).expect("http: oom")
    out = a.trim(cut)
    a.release(cut.own_ptr())
    out
}
collect_headers = (
    a: AllocatorBackend,
    lines: MutSlice<StringView>,
) Result<MutSlice<Header>, HttpError> {
    n = lines.len - 1
    hs :: MutSlice<Header> = a.nbuf(Header(
        name: "",
        value: "",
    ), n)
    filled :: i64 = 0
    lines.loop((h, i, line) {
        (i == 0 == false).then({
            ci = line.find(":")
            (ci < 0).match ({
                true  => {
                    h.break
                },
                false => {
                    nm = a.trimmed_cut(line, 0, ci)
                    val = a.trimmed_cut(line, ci + 1, line.view().len - (ci + 1))
                    hs[i - 1] = Header(
                        name: nm,
                        value: val,
                    )
                    filled = filled + 1
                },
            })
        })
    })
    (filled == n).match ({
        true  => ok(hs),
        false => {
            a.release_headers(hs.take(filled))
            err(malformed("http: header line missing ':'"))
        },
    })
}
te_is_chunked = (a: AllocatorBackend, te: StringView) bool {
    lo = a.to_lower(te)
    out = lo.contains("chunked")
    a.release(lo.own_ptr())
    out
}
decide_body = (
    a: AllocatorBackend,
    headers: MutSlice<Header>,
    body_raw: MutSlice<u8>,
) MutSlice<u8> {
    chunked = lookup_header(headers, "Transfer-Encoding").match ({
        .Some(te) => a.te_is_chunked(te),
        .None     => false,
    })
    logical: MutSlice<u8> = chunked.match ({
        true  => a.decode_chunked(body_raw),
        false => lookup_header(headers, "Content-Length").match ({
            .Some(cl) => body_raw.take(cl.parse_int()),
            .None     => body_raw,
        }),
    })
    out = a.own_bytes(logical)
    chunked.then({
        a.release_slice(logical)
    })
    out
}
hex_end = (bv: MutSlice<u8>, i: i64) i64 {
    (i < bv.len && is_hex(bv[i])).then({ bv.hex_end(i + 1) }, { i })
}
after_lf = (bv: MutSlice<u8>, i: i64) i64 {
    (i >= bv.len).match ({
        true  => bv.len,
        false => (bv[i] == '\n').then({ i + 1 }, { bv.after_lf(i + 1) }),
    })
}
append_range = (a: AllocatorBackend, bv: Slice<u8>, start: i64, n: i64, sb: String) String {
    avail = bv.len - start
    m = (n < avail).then({ n }, { avail })
    part: Slice<u8> = slice(bv.ptr.offset(start), m)
    acc ::= sb
    part.loop_at((i, b) { acc = a.push_in(acc, b).expect("http: oom") })
    acc
}
chunk_loop = (a: AllocatorBackend, bv: MutSlice<u8>, i: i64, sb: String) String {
    (i >= bv.len).match ({
        true  => sb,
        false => {
            he = bv.hex_end(i)
            size = bv.sub(i, he).hex_value()
            data = bv.after_lf(he)    // past the size line's '\n'
            (size == 0).match ({
                true  => sb,
                false => {
                    filled = a.append_range(bv, data, size, sb)
                    a.chunk_loop(bv, bv.after_lf(data + size), filled)
                },
            })
        },
    })
}
decode_chunked = (a: AllocatorBackend, bv: MutSlice<u8>) MutSlice<u8> {
    sb = a.init(16).expect("http: oom")
    a.chunk_loop(bv, 0, sb).bytes()
}
append_decimal = (a: AllocatorBackend, sb: String, n: i64) String {
    d: StringView = a
        .integer(n)
        .expect("http: oom")
        .finish_in(a)
        .expect("http: oom")
    out = a.append_in(sb, d).expect("http: oom")
    a.release(d.own_ptr())
    out
}
crlf = (a: AllocatorBackend, sb: String) String { a.append_in(sb, "\r\n").expect("http: oom") }
build_request = (
    a: AllocatorBackend,
    method: StringView,
    host: StringView,
    path: StringView,
    headers: MutSlice<Header>,
    body: StringView,
) StringView {
    sb ::= a.init(16).expect("http: oom")
    sb = a.append_in(sb, method).expect("http: oom")
    sb = a.append_in(sb, " ").expect("http: oom")
    sb = a.append_in(sb, path).expect("http: oom")
    sb = a.append_in(sb, " HTTP/1.1").expect("http: oom")
    sb = a.crlf(sb)
    sb = a.append_in(sb, "Host: ").expect("http: oom")
    sb = a.append_in(sb, host).expect("http: oom")
    sb = a.crlf(sb)
    sb = a.append_in(sb, "Connection: close").expect("http: oom")
    sb = a.crlf(sb)
    headers.loop_at((i, hd) {
        sb = a.append_in(sb, hd.name).expect("http: oom")
        sb = a.append_in(sb, ": ").expect("http: oom")
        sb = a.append_in(sb, hd.value).expect("http: oom")
        sb = a.crlf(sb)
    })
    (body.view().len > 0).then({
        sb = a.append_in(sb, "Content-Length: ").expect("http: oom")
        sb = a.append_decimal(sb, to_i64(body.view().len))
        sb = a.crlf(sb)
    })
    sb = a.crlf(sb)    // blank line: end of headers
    sb = a.append_in(sb, body).expect("http: oom")
    a.finish_in(sb).expect("http: oom")
}
READ_CHUNK = 4096    // per-recv buffer size for draining the response
read_loop = (a: AllocatorBackend, c: TcpConn, buf: RawPtr<u8>, sb: String) String {
    c.recv_into(buf, READ_CHUNK).match ({
        .Ok(nr) => (nr <= 0).match ({
            true  => sb,
            false => a.read_loop(c, buf, a.append_range(buf.slice(nr), 0, nr, sb)),
        }),
        .Err(e) => sb,
    })
}
read_all = (a: AllocatorBackend, c: TcpConn) MutSlice<u8> {
    buf = a.acquire(READ_CHUNK)
    full = a.read_loop(c, buf, a.init(16).expect("http: oom"))
    a.release(buf)
    full.bytes()
}
request* = (
    a: AllocatorBackend,
    method: StringView,
    host: StringView,
    port: i32,
    path: StringView,
    headers: MutSlice<Header>,
    body: StringView,
) Result<Response, HttpError> {
    req = a.build_request(method, host, path, headers, body)
    out: Result<Response, HttpError> = dial(host, port).match ({
        .Err(e) => err(connect_err(e)),
        .Ok(c)  => c.send_str(req).match ({
            .Err(e) => {
                c.close_conn()
                err(io_err(e))
            },
            .Ok(w)  => {
                raw = a.read_all(c)
                c.close_conn()
                res = a.parse_response(raw)
                a.release_slice(raw)
                res
            },
        }),
    })
    a.release(req.own_ptr())    // the serialised request is on the wire (or the dial failed)
    out
}
no_headers* = (a: AllocatorBackend) MutSlice<Header> {
    a.nbuf(Header(
        name: "",
        value: "",
    ), 0)
}
one_header* = (a: AllocatorBackend, name: StringView, value: StringView) MutSlice<Header> {
    hs ::= a.nbuf(Header(
        name: "",
        value: "",
    ), 1)
    hs[0] = Header(
        name: name,
        value: value,
    )
    hs
}
get* = (
    a: AllocatorBackend,
    host: StringView,
    port: i32,
    path: StringView,
) Result<Response, HttpError> { a.request("GET", host, port, path, a.no_headers(), "") }
Url*: {
    host: StringView,
    port: i32,
    path: StringView,
}
// Accepts http:// or no scheme; defaults to port 80 and path "/". host and path are independent
// owned cuts released by url_free.
parse_url* = (a: AllocatorBackend, url: StringView) Result<Url, HttpError> {
    url.starts_with("https://").match ({
        true  => err(malformed("http: https is not supported (no TLS)")),
        false => {
            skip = url.starts_with("http://").then({ 7 }, { 0 })
            rest = a.substr(url, skip, url.view().len - skip).expect("http: oom")
            out: Result<Url, HttpError> = rest.contains("://").match ({
                true  => err(malformed("http: unsupported url scheme")),
                false => {
                    slash = rest.find("/")
                    alen = (slash < 0).then({ rest.view().len }, { slash })    // the authority run
                    auth = a.substr(rest, 0, alen).expect("http: oom")
                    path = (slash < 0).match ({
                        true  => a.substr("/", 0, 1).expect("http: oom"),
                        false => a.substr(rest, slash, rest.view().len - slash).expect("http: oom"),
                    })
                    colon = auth.find(":")
                    host = a
                        .substr(auth, 0, (colon < 0).then({ alen }, { colon }))
                        .expect("http: oom")
                    port = (colon < 0).match ({
                        true  => 80,
                        false => {
                            digits = a
                                .substr(auth, colon + 1, alen - (colon + 1))
                                .expect("http: oom")
                            n = digits.parse_int()
                            a.release(digits.own_ptr())
                            n
                        },
                    })
                    why = (host.view().len == 0).match ({
                        true  => "http: empty host in url",
                        false => (port < 1 || port > 65535).match ({
                            true  => "http: port out of range in url",
                            false => "",
                        }),
                    })
                    res: Result<Url, HttpError> = (why == "").match ({
                        true  => ok(Url(
                            host: host,
                            port: to_i32(port),
                            path: path,
                        )),
                        false => {
                            a.release(host.own_ptr())    // a rejected Url never reaches `url_free`
                            a.release(path.own_ptr())
                            bad: Result<Url, HttpError> = err(malformed(why))
                            bad
                        },
                    })
                    a.release(auth.own_ptr())    // `host` and the port digits are cut OUT of it
                    res
                },
            })
            a.release(rest.own_ptr())
            out
        },
    })
}
url_free* = (a: AllocatorBackend, u: Url) void {
    a.release(u.host.own_ptr())
    a.release(u.path.own_ptr())
}
url_of* = (a: AllocatorBackend, host: StringView, port: i32, path: StringView) StringView {
    sb ::= a.init(16).expect("http: oom")
    sb = a.append_in(sb, "http://").expect("http: oom")
    sb = a.append_in(sb, host).expect("http: oom")
    sb = a.append_in(sb, ":").expect("http: oom")
    sb = a.append_decimal(sb, to_i64(port))
    sb = a.append_in(sb, path).expect("http: oom")
    a.finish_in(sb).expect("http: oom")
}
http_get* = (a: AllocatorBackend, url: StringView) Result<Response, HttpError> {
    a.http_request(url, "GET", a.no_headers(), "")
}
http_request* = (
    a: AllocatorBackend,
    url: StringView,
    method: StringView,
    headers: MutSlice<Header>,
    body: StringView,
) Result<Response, HttpError> {
    a.parse_url(url).match ({
        .Err(e) => err(e),
        .Ok(u)  => {
            out = a.request(method, u.host, u.port, u.path, headers, body)
            a.url_free(u)
            out
        },
    })
}
Request*: {
    method: StringView,
    path: StringView,
    headers: MutSlice<Header>,
    body: StringView,
    body_bytes: MutSlice<u8>,
    header = (r: Request, name: StringView) Opt<StringView> { lookup_header(r.headers, name) }
}
request_free* = (a: AllocatorBackend, r: Request) void {
    a.release(r.method.own_ptr())
    a.release(r.path.own_ptr())
    a.release_headers(r.headers)
    a.release_slice(r.body_bytes)
}
parse_request* = (a: AllocatorBackend, raw: MutSlice<u8>) Result<Request, HttpError> {
    out: Result<Request, HttpError> = a.parse_parts(raw).match ({
        .Err(e) => .Err(e),
        .Ok(p)  => {
            toks = a.words(p.first)
            keep = toks.len >= 2    // method + target; a shorter request line is malformed
            res: Result<Request, HttpError> = (keep == false).match ({
                true  => err(malformed("http: request line has fewer than two tokens")),
                false => {
                    ok_res: Result<Request, HttpError> = .Ok(Request(
                        method: toks[0],
                        path: toks[1],
                        headers: p.headers,
                        body: cstr(p.body.ptr),
                        body_bytes: p.body,
                    ))
                    ok_res
                },
            })
            toks.loop_at((i, t) {
                (i >= 2 || keep == false).then({
                    a.release(t.own_ptr())
                })
            })
            a.release_slice(toks)
            a.release(p.first.own_ptr())    // the request line is read only through `toks`
            (keep == false).then({
                a.release_headers(p.headers)
                a.release_slice(p.body)
            })
            res
        },
    })
    out
}
status_reason* = (code: i32) StringView {
    (code == 200).then({
        return "OK"
    })
    (code == 201).then({
        return "Created"
    })
    (code == 204).then({
        return "No Content"
    })
    (code == 400).then({
        return "Bad Request"
    })
    (code == 404).then({
        return "Not Found"
    })
    (code == 405).then({
        return "Method Not Allowed"
    })
    (code == 500).then({
        return "Internal Server Error"
    })
    ""
}
// For embedded-NUL bodies, construct Response directly with an explicit body_bytes length.
respond* = (status: i32, headers: MutSlice<Header>, body: StringView) Response {
    Response(
        status: status,
        headers: headers,
        body: body,
        body_bytes: body.own_ptr().slice(body.view().len),
    )
}
// Returns bytes because the body may contain NULs.
build_response* = (a: AllocatorBackend, r: Response) MutSlice<u8> {
    sb ::= a.init(16).expect("http: oom")
    sb = a.append_in(sb, "HTTP/1.1 ").expect("http: oom")
    sb = a.append_decimal(sb, to_i64(r.status))
    sb = a.append_in(sb, " ").expect("http: oom")
    sb = a.append_in(sb, status_reason(r.status)).expect("http: oom")
    sb = a.crlf(sb)
    r.headers.loop_at((i, hd) {
        sb = a.append_in(sb, hd.name).expect("http: oom")
        sb = a.append_in(sb, ": ").expect("http: oom")
        sb = a.append_in(sb, hd.value).expect("http: oom")
        sb = a.crlf(sb)
    })
    sb = a.append_in(sb, "Content-Length: ").expect("http: oom")
    sb = a.append_decimal(sb, r.body_bytes.len)
    sb = a.crlf(sb)
    sb = a.append_in(sb, "Connection: close").expect("http: oom")
    sb = a.crlf(sb)
    sb = a.crlf(sb)    // blank line: end of headers
    a.append_range(r.body_bytes, 0, r.body_bytes.len, sb).bytes()
}
// Returns -1 until headers delimit the message. Request bodies require Content-Length; chunked
// requests are treated as bodyless.
wire_len = (a: AllocatorBackend, raw: MutSlice<u8>) i64 {
    sep = raw.crlfcrlf()
    (sep < 0).match ({
        true  => 0 - 1,
        false => {
            head = a.own_bytes(raw.take(sep))
            lines = a.split(cstr(head.ptr), '\n')
            body: i64 = a.collect_headers(lines).match ({
                .Ok(hs) => {
                    n = lookup_header(hs, "Content-Length").match ({
                        .Some(cl) => cl.parse_int(),
                        .None     => 0,
                    })
                    a.release_headers(hs)
                    n
                },
                .Err(e) => 0,
            })
            a.release_strs(lines)
            a.release(head.ptr)
            sep + 4 + body
        },
    })
}
read_msg_loop = (a: AllocatorBackend, c: TcpConn, buf: RawPtr<u8>, sb: String) String {
    raw = sb.bytes()
    want = a.wire_len(raw)
    (want >= 0 && raw.len >= want).match ({
        true  => sb,
        false => c.recv_into(buf, READ_CHUNK).match ({
            .Ok(nr) => (nr <= 0).match ({
                true  => sb,
                false => a.read_msg_loop(c, buf, a.append_range(buf.slice(nr), 0, nr, sb)),
            }),
            .Err(e) => sb,
        }),
    })
}
read_request = (a: AllocatorBackend, c: TcpConn) MutSlice<u8> {
    buf = a.acquire(READ_CHUNK)
    full = a.read_msg_loop(c, buf, a.init(16).expect("http: oom"))
    a.release(buf)
    full.bytes()
}
http_listen* = (host: StringView, port: i32) Result<TcpListener, HttpError> {
    serve(host, port).match ({
        .Ok(l)  => ok(l),
        .Err(e) => err(listen_err(e)),
    })
}
// Malformed accepted requests receive 400 before their error is returned.
serve_once*<A: AllocatorBackend> = (
    a: MutPtr<A>,
    l: TcpListener,
    handler: (MutPtr<A>, Request) Response,
) Result<Request, HttpError> {
    out: Result<Request, HttpError> = l.accept_conn().match ({
        .Err(e) => err(listen_err(e)),
        .Ok(c)  => {
            raw = a.read_request(c)
            res: Result<Request, HttpError> = a.parse_request(raw).match ({
                .Err(e)  => {
                    wire = a.build_response(respond(400, a.no_headers(), ""))
                    c.send(wire)
                    a.release_slice(wire)
                    err(e)
                },
                .Ok(req) => {
                    wire = a.build_response(handler(a, req))
                    sent: Result<Request, HttpError> = c.send(wire).match ({
                        .Ok(n)  => ok(req),
                        .Err(e) => err(io_err(e)),
                    })
                    a.release_slice(wire)
                    sent
                },
            })
            a.release_slice(raw)    // parsed into fresh buffers, never kept
            c.close_conn()
            res
        },
    })
    out
}
// n < 0 serves until a listener-level error; per-connection errors do not stop the loop.
serve_n*<A: AllocatorBackend> = (
    a: MutPtr<A>,
    l: TcpListener,
    n: i64,
    handler: (MutPtr<A>, Request) Response,
) i64 {
    live ::= true
    zero: i64 = 0
    zero.step_while((served) { live && (n < 0 || served < n) }, (served) {
        live = a.serve_once(l, handler).match ({
            .Ok(r)  => {
                a.request_free(r)    // the loop is the owner here — nothing above ever sees it
                true
            },
            .Err(e) => fatal(e).then({ false }, { true }),
        })
        live.then({ served + 1 }, { served })
    })
}
