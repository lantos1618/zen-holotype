# tools/fleet/tests/judge.list -- plan.list with `never` appended, which is
# a work list edited after the fleet started. `never` therefore has no
# baseline and no done marker, and it is the whole point of this fixture:
# a job this program never looked at is not a job that failed.
changed  prompts/noop.txt  targets/changed.txt
stuck    prompts/noop.txt  targets/stuck.txt
never    prompts/noop.txt  targets/never.txt
