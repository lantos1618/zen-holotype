// A match whose every arm returns closes its final `else` with
// `zg_unreachable`, so unannotated the chain reads to cc as a non-void
// function that can fall off its end — visible only as `-Wreturn-type`,
// which nothing grepped for (#806). The runtime helpers are ZG_NORETURN
// and the harness compiles with -Werror=return-type, so this program
// REFUSES TO BUILD on a runtime that lost the annotation instead of
// running and printing whatever the caller read out of thin air.
//
// EXPECTED STDOUT (written before running):
//   1
//   2
//   3
Color = | Red | Green | Blue

code = (c: Color) i32 {
    c.match({
        Red   => 1,
        Green => 2,
        Blue  => 3,
    })
}

main = (env: Env) Res<i32, AllocError> {
    println("{}", code(Color.Red));
    println("{}", code(Color.Green));
    println("{}", code(Color.Blue));
    Ok(0);
}
