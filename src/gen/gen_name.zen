// src/gen/gen_name.zen
// The name a Zen declaration has in a flat namespace.
//
// C has one namespace; Zen lets two modules declare the same top-level
// name. PLAN.md 0.4 makes five decisions for encoding a path into a C
// identifier; this file is all five, so a second backend inherits them.
// Lives here, not `gen_c.zen`, because the encoding names no C.
//
// 1. LENGTH-PREFIXED SCHEME. Joining components with `_` is provably
//    ambiguous — STYLE.md's own sibling-prefix convention triggers it:
//    `parse`+`expr_kind` and `parse_expr`+`kind` join to one string. A
//    component is its byte length then its bytes; a list is a count, an
//    underscore, then the components. A Zen identifier never starts
//    with a digit, so the length (maximal digit run) parses back
//    uniquely:
//        alpha + beta_gamma  ->  2_5alpha10beta_gamma
//        alpha_beta + gamma  ->  2_10alpha_beta5gamma
//
// 2. TWO PREFIXES, every emitted identifier under one. `zu_` from a
//    user name, `zg_` invented by the compiler. Neither starts with an
//    underscore, so neither is C11 7.1.3-reserved; `zu_` cannot produce
//    `zg_`, so `zg_trap` written by a user can't reach the runtime.
//    Every user identifier is mangled, so no C keyword or header macro
//    is ever emitted — decision 4 handled as an identifier CLASS, not a
//    hand-kept keyword list, which also covers every future `_Atomic`.
//
// 3. THE SITES. Types, functions, enum constants, struct members,
//    locals/parameters, and module values each carry a letter, so two
//    kinds of thing can share a Zen name without sharing a C one.
//    Struct members are the site everyone forgets, and the one that
//    breaks against `<errno.h>`.
//
// 5. A TYPE ARGUMENT RENDERS AS A PURE FUNCTION OF THE TYPE (`tcode`
//    below) — never instantiation order, a counter, or asking order.
//    Determinism dies here or nowhere.
//
// C STANDARD TARGETED IS C99, stated once in the runtime banner in
// `gen_c.zen`; this file only needs C11 7.1.3's identifier rules, which
// C99 shares.

str, String = std.text
Vec = std.collections
Alloc, AllocError = std.mem
Range = std.core
hex_digit = std.core.byte
write_usize = sema.sema_diag
TyId, Ty, Types, TyNamed, TyRes, TyArray, ResForm = sema.sema_ty
World = sema.sema_def
DeclId = sema.sema_id
Inst = sema.sema_inst

// Derived from a user name.
USR* : str = "zu_"

// Invented by the compiler: temporaries, helpers, the runtime, labels.
GEN* : str = "zg_"

// `Res` is structural in this compiler's type language — sema carries
// `TyRes(value, error, form)` rather than a declaration, because
// `Res<T>` and `Res<T, E>` are two arities of one name and every
// `.try()` asks which form it has. It still has to answer to the name
// the library gives it, so the path is written down once, here.
RES_PATH* : str = "std.core.result.Res"

// -----------------------------------------------------------------
// the encoding
// -----------------------------------------------------------------

// One length-prefixed component: `alpha` -> `5alpha`.
//
// A component that is not a Zen identifier is HEX-ESCAPED, since the
// output must be a C identifier: `x` followed by two hex digits per
// byte, which can't collide since a real identifier never reaches it.
comp* = (out :: String, name: str) Res<(), AllocError> {
    is_c_identifier(name).match({
        true  => plain_comp(out, name),
        false => escaped_comp(out, name),
    })
}

plain_comp = (out :: String, name: str) Res<(), AllocError> {
    out.write_usize(name.len).try();
    out.add_bytes(name)
}

escaped_comp = (out :: String, name: str) Res<(), AllocError> {
    out.write_usize(name.len * 2 + 1).try();
    out.add_bytes("x").try();
    Range(0, name.len).loop((h, i) {
        out.add_byte(hex_digit(name.index(i) / 16)).try();
        out.add_byte(hex_digit(name.index(i) % 16)).try();
    });
    Ok(());
}

// `[A-Za-z_][A-Za-z0-9_]*`, which is exactly what the language admits
// as an identifier and exactly what C admits as one.
is_c_identifier* = (name: str) bool {
    (name.len > 0) && name.index(0).is_ident_start() && rest_is_ident(name)
}

rest_is_ident = (name: str) bool {
    Range(1, name.len).find((i) { name.index(i).is_ident_cont() == false })
        .match({ Ok(_) => false, None => true })
}

// A list header: `3_`. A count always ends with `_` and a component
// never does, which is what tells the two apart on the way back.
count* = (out :: String, n: usize) Res<(), AllocError> {
    out.write_usize(n).try();
    out.add_bytes("_")
}

// A dotted Zen path as a counted list of components:
// `std.core.result` -> `3_3std4core6result`.
path* = (out :: String, qname: str) Res<(), AllocError> {
    count(out, segments(qname)).try();
    (qname.len > 0).then(() { write_segments(out, qname).try() });
    Ok(());
}

// A dotted path plus one more component — an enum's path and a variant
// name, which is the one place a symbol is a path with a tail.
path_with* = (out :: String, qname: str, tail: str) Res<(), AllocError> {
    count(out, segments(qname) + 1).try();
    (qname.len > 0).then(() { write_segments(out, qname).try() });
    comp(out, tail).try();
    Ok(());
}

// How many dot-separated segments `qname` has. An empty path has none,
// which is the only case that is not "one more than the dots".
segments* = (qname: str) usize {
    (qname.len == 0).match({
        true  => 0,
        false => dots(qname) + 1,
    })
}

dots = (qname: str) usize {
    n ::= 0;
    Range(0, qname.len).loop((h, i) {
        (qname.index(i) == '.').then(() { n = n + 1; });
    });
    n
}

write_segments = (out :: String, qname: str) Res<(), AllocError> {
    start ::= 0;
    Range(0, qname.len).loop((h, i) {
        (qname.index(i) == '.').then(() {
            comp(out, qname.slice(start, i)).try();
            start = i + 1;
        });
    });
    comp(out, qname.slice(start, qname.len)).try();
    Ok(());
}

// -----------------------------------------------------------------
// the sites
// -----------------------------------------------------------------

// The C name of a type: `zu_t4_3std4core6result3ResI1_b3i32`.
//
// `zu_` for a user declaration or the library `Res`; `zg_` when the
// compiler composed it from nothing a user wrote (anonymous union,
// fixed array). Both are still `tcode` — a pure function of the type.
sym_type* = (out :: String, types: Types, world: World, id: TyId)
            Res<(), AllocError> {
    out.add_bytes(prefix_of(types, id)).try();
    tcode(out, types, world, id).try();
    Ok(());
}

prefix_of = (types: Types, id: TyId) str {
    types.at(id).match({
        Named(_) => USR,
        Res(_)   => USR,
        _        => GEN,
    })
}

// A function. `sig` is the declared parameter types (what overloading
// resolves on), so two overloads of one name get two symbols by
// construction, not a counter.
//
// `inst` IS WHAT MAKES AN INSTANTIATION A SYMBOL: a generic function is
// emitted once per distinct type-argument set, so the arguments go in
// the name (decision 5). `Vec<i32>()` and `Vec<str>()` share a signature
// (`(a: Alloc)`) and differ only here — signature alone can't be the
// identity.
//
// `O` and `I` are two sections, not one: signature answers "which
// overload", arguments answer "which instantiation"; a program can
// differ in either independently.
sym_fn* = (
    out   :: String,
    types : Types,
    world : World,
    qname : str,
    sig   : Vec<TyId>,
    inst  : Inst
) Res<(), AllocError> {
    out.add_bytes(USR).try();
    out.add_bytes("f").try();
    path(out, qname).try();
    (sig.len > 0).then(() { write_sig(out, types, world, sig).try() });
    (inst.len() > 0).then(() { write_targs(out, types, world, inst).try() });
    Ok(());
}

write_sig = (out :: String, types: Types, world: World, sig: Vec<TyId>)
            Res<(), AllocError> {
    out.add_bytes("O").try();
    tcode_list(out, types, world, sig).try();
    Ok(());
}

// The type arguments, in the order the instantiation bound them, which
// is declaration order: `Inst` is a pair of parallel lists filled from
// `tparams` and never from a `Map`, so two runs that bind the same
// arguments write the same bytes.
write_targs = (out :: String, types: Types, world: World, inst: Inst)
              Res<(), AllocError> {
    out.add_bytes("I").try();
    count(out, inst.len()).try();
    Range(0, inst.len()).loop((h, i) {
        write_targ(out, types, world, inst, i).try();
    });
    Ok(());
}

// An argument this instantiation left free renders as `q`, the same
// letter an unsubstituted parameter takes — and the consumer refuses
// before it gets here, because two free parameters would be one symbol.
write_targ = (
    out   :: String,
    types : Types,
    world : World,
    inst  : Inst,
    i     : usize
) Res<(), AllocError> {
    inst.arg_at(i).match({
        None  => out.add_bytes("q"),
        Ok(t) => tcode(out, types, world, t),
    })
}

// An enum constant: the enum's own path with the variant appended.
//
// The tag is a function of the DECLARATION and never of an
// instantiation — `Res<i32, E>` and `Res<i32, F>` share `Ok`, and
// emitting the constant per instance is a C redefinition.
sym_variant* = (out :: String, qname: str, variant: str)
               Res<(), AllocError> {
    out.add_bytes(USR).try();
    out.add_bytes("e").try();
    path_with(out, qname, variant).try();
    Ok(());
}

// A struct member. Not qualified: a member name only has to be unique
// within its struct, and C gives every struct its own member namespace.
// It is mangled anyway, because `x.errno` against `<errno.h>` is the
// one collision a keyword list never catches.
sym_member* = (out :: String, name: str) Res<(), AllocError> {
    out.add_bytes(USR).try();
    out.add_bytes("m").try();
    comp(out, name).try();
    Ok(());
}

// -----------------------------------------------------------------
// a STRUCTURAL union
//
// `A | B` written inline, or a set sema inferred, is an enum with no
// declaration — no path. The tag constant and payload field sites that
// need one get it from the type itself: `tcode`, injective and
// self-delimiting (every component carries its length), so two type
// codes end to end parse back as two.
// -----------------------------------------------------------------

// A structural union's tag constant. `zg_`, same reason `sym_type`
// gives a structural union a `zg_` name: composed from nothing a user
// wrote.
//
// Both set AND member are in the name — member alone collides across
// sets that share it, and set alone isn't a constant at all.
sym_union_variant* = (
    out    :: String,
    types  : Types,
    world  : World,
    set    : TyId,
    member : TyId
) Res<(), AllocError> {
    out.add_bytes(GEN).try();
    out.add_bytes("e").try();
    tcode(out, types, world, set).try();
    tcode(out, types, world, member).try();
    Ok(());
}

// A structural union's payload field.
//
// A MEMBER THAT IS A DECLARATION TAKES ITS OWN NAME — a declared
// union-reading enum writes the same field: `Error = AllocError |
// IoError` and the structural `AllocError | IoError` both lay out
// `zu_m10AllocError`. Their tags agree too, now that
// `gen_c_layout.write_enum_tags` numbers a union-reading enum
// canonically, so propagation between them is a copy, not a re-tagging
// map.
sym_union_member* = (
    out    :: String,
    types  : Types,
    world  : World,
    member : TyId
) Res<(), AllocError> {
    types.at(member).match({
        Named(n) => sym_member(out, n.name),
        _        => sym_union_member_gen(out, types, world, member),
    })
}

// A member with no declaration has no written name, so its type code
// stands in for one — all a field name has to be is a pure function of
// the type, and `tcode` is that.
sym_union_member_gen = (
    out    :: String,
    types  : Types,
    world  : World,
    member : TyId
) Res<(), AllocError> {
    out.add_bytes(GEN).try();
    out.add_bytes("m").try();
    tcode(out, types, world, member).try();
    Ok(());
}

// A local or a parameter. `n` distinguishes shadowing bindings of one
// name in one function, and it is 1 for the first, which is written
// without a suffix so the common case reads.
sym_local* = (out :: String, name: str, n: usize) Res<(), AllocError> {
    out.add_bytes(USR).try();
    out.add_bytes("l").try();
    comp(out, name).try();
    (n > 1).then(() { write_shadow(out, n).try() });
    Ok(());
}

write_shadow = (out :: String, n: usize) Res<(), AllocError> {
    out.add_bytes("_").try();
    out.write_usize(n).try();
    Ok(());
}

// A module-level value binding.
sym_value* = (out :: String, qname: str) Res<(), AllocError> {
    out.add_bytes(USR).try();
    out.add_bytes("v").try();
    path(out, qname).try();
    Ok(());
}

// A compiler-invented name: a temporary, a label, a helper.
sym_gen* = (out :: String, stem: str, n: usize) Res<(), AllocError> {
    out.add_bytes(GEN).try();
    out.add_bytes(stem).try();
    out.write_usize(n).try();
    Ok(());
}

// -----------------------------------------------------------------
// tcode — the name of a TYPE
//
// Pure function of the type, injective — makes an instantiation's name
// independent of the run that produced it. Tag letters are lowercase,
// `I` is uppercase, so a tag is never mistaken for a component start:
// user-written `Pair_i32_i32` can never collide with `Pair<i32, i32>`.
// -----------------------------------------------------------------

tcode* = (out :: String, types: Types, world: World, id: TyId)
         Res<(), AllocError> {
    types.at(id).match({
        Prim(p)  => tcode_prim(out, p.name),
        Named(n) => tcode_of_named(out, types, world, n),
        Res(r)   => tcode_res(out, types, world, r),
        Fn(f)    => tcode_fn(out, types, world, f.params, f.ret),
        Union(u) => tcode_union(out, types, world, u.members),
        Array(a) => tcode_array(out, types, world, a),
        Var(_)   => out.add_bytes("q"),
        Infer    => out.add_bytes("q"),
        Unknown  => out.add_bytes("q"),
    }).try();
    Ok(());
}

// `()` is `z` and every other primitive is `b` plus its name. The unit
// type is separated because it is the one primitive with no bytes: it
// is `void` in a return position and unrepresentable in a field, and a
// backend has to be able to see that without a string compare.
tcode_prim = (out :: String, name: str) Res<(), AllocError> {
    name.eq("()").match({
        true  => out.add_bytes("z"),
        false => tcode_scalar(out, name),
    })
}

tcode_scalar = (out :: String, name: str) Res<(), AllocError> {
    out.add_bytes("b").try();
    comp(out, name).try();
    Ok(());
}

// The declaration's path is written a segment at a time rather than
// joined into a `String` first, so naming a type allocates nothing —
// every emitted symbol goes through here.
tcode_of_named = (out :: String, types: Types, world: World, n: TyNamed)
                 Res<(), AllocError> {
    out.add_bytes("t").try();
    count(out, segments(module_of(world, n.decl)) + 1).try();
    write_module_segments(out, world, n.decl).try();
    comp(out, n.name).try();
    (n.args.len > 0).then(() { write_args(out, types, world, n.args).try() });
    Ok(());
}

write_args = (out :: String, types: Types, world: World, args: Vec<TyId>)
             Res<(), AllocError> {
    out.add_bytes("I").try();
    tcode_list(out, types, world, args).try();
    Ok(());
}

// `Res<T>` renders as the library type applied to one argument,
// `Res<T, E>` to two — so a structural Res and a declared one share a C
// name. `Open` (a bare `Ok(x)` before an expectation settles it)
// renders as the absence form, its shape when nothing settles it.
tcode_res = (out :: String, types: Types, world: World, r: TyRes)
            Res<(), AllocError> {
    out.add_bytes("t").try();
    path(out, RES_PATH).try();
    out.add_bytes("I").try();
    count(out, res_arity(r.form)).try();
    tcode(out, types, world, r.value).try();
    is_failure(r.form).then(() { tcode(out, types, world, r.error).try() });
    Ok(());
}

res_arity* = (form: ResForm) usize {
    form.match({ Failure => 2, Absence => 1, Open => 1 })
}

is_failure* = (form: ResForm) bool {
    form.match({ Failure => true, Absence => false, Open => false })
}

// `[i32, 4]` is `a4_bi32`. THE COUNT IS IN THE NAME because it's in the
// type: `tcode` is injective, so `[i32, 4]` and `[i32, 5]` must not
// collide. Written as a list header, so `_` separates it from the
// element and nothing after can be read as more digits.
tcode_array = (out :: String, types: Types, world: World, a: TyArray)
              Res<(), AllocError> {
    out.add_bytes("a").try();
    count(out, a.count).try();
    tcode(out, types, world, a.elem).try();
    Ok(());
}

tcode_fn = (
    out    :: String,
    types  : Types,
    world  : World,
    params : Vec<TyId>,
    ret    : TyId
) Res<(), AllocError> {
    out.add_bytes("f").try();
    tcode(out, types, world, ret).try();
    tcode_list(out, types, world, params).try();
    Ok(());
}

// A union's members are already canonical — flat, sorted, deduped by
// the intern store — so `A | B` and `B | A` reach this in one order and
// produce one name. Sorting is the store's, not repeated here: two
// places that sort are two places that can disagree.
tcode_union = (
    out     :: String,
    types   : Types,
    world   : World,
    members : Vec<TyId>
) Res<(), AllocError> {
    out.add_bytes("u").try();
    tcode_list(out, types, world, members).try();
    Ok(());
}

tcode_list = (out :: String, types: Types, world: World, items: Vec<TyId>)
             Res<(), AllocError> {
    count(out, items.len).try();
    items.loop((h, t) { tcode(out, types, world, t).try() });
    Ok(());
}

// The module a declaration lives in.
//
// Built from `DeclId`, not a carried string: `TyNamed` holds the
// declaration and a bare name, but the bare name is diagnostic-only —
// two modules may share a top-level name, so the module is the half
// that makes the symbol unique.
module_of* = (world: World, decl: DeclId) str {
    world.table_at(decl.module.to_usize()).match({
        Ok(t) => t.name,
        None  => "",
    })
}

write_module_segments = (out :: String, world: World, decl: DeclId)
                        Res<(), AllocError> {
    name = module_of(world, decl);
    (name.len > 0).then(() { write_segments(out, name).try() });
    Ok(());
}
