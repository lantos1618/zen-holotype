Input = { text :: str, scratch: str }
Envelope = { input :: Input }
read = (envelope: Envelope) str { alias = envelope.input; alias.text }
word = (env: Env) Res<str, AllocError> {
    a         = env.mem.alloc();
    temporary = a.String("temporary").try();
    envelope ::= Envelope(input: Input(
        text: temporary.view(),
        scratch: temporary.view()
    ));
    envelope.input.text = "stable";
    Ok(read(envelope))
}
main = (env: Env) Res<(), AllocError> { println(word(env).try()); Ok(()) }
