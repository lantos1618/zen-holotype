// UNRESOLVED in DESIGN.md (PLAN.md 0.1 names it): is `Alias = Shape` a
// binding that aliases the type, or a one-variant enum whose single
// variant is called `Shape`? the two readings differ observably --
// under the first, `Alias.Circle` exists; under the second it does not.
Shape =
    Circle,
    Square

Alias = Shape

main = (env: Env) Res<i32, ArgError> {
    Ok(0);
}
