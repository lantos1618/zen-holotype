//! link: c
// tests/harness_bench.zen — Zen's BENCHMARK suite: the standing record of what a named operation
// costs, in TIME and in HEAP BYTES. It is deliberately NOT part of `make harness`: benchmarks are
// noisy, and a noisy number must never gate a merge. Run it by hand, keep the output, diff it later.
//
//   make -f bootstrap/Makefile bench          # build + run, one line per case
//   make -f bootstrap/Makefile bench > a.txt  # …then again after a change → `diff a.txt b.txt`
//
// ── WHY THIS EXISTS (the failure it is built to catch) ────────────────────────────────────────────
// `zen profile` and `zen run --time` are PROFILING: a snapshot of one run. Nothing here measured a
// named operation repeatedly, and nothing recorded a number a later run could be compared against.
// A past integer-formatting leak escaped normal profiling until valgrind exposed its linear growth.
// This suite reports `liveB/op` so the same class of regression stays visible as nonzero live bytes.
//
// ── OUTPUT ───────────────────────────────────────────────────────────────────────────────────────
// One line per case, fixed-width columns, no timestamps or paths — so two runs diff cleanly:
//
//   case                  iters      total_ns       ns/op   liveB/op             sink
//   slicelit_sum        1000000      43473370          43         48    1000002000000
//
//   iters     how many times the measured operation ran (see each case for what ONE op is)
//   total_ns  CLOCK_MONOTONIC nanoseconds across the whole timed loop
//   ns/op     total_ns / iters, truncated
//   liveB/op  (live heap bytes after − before) / iters — see MEASURING ALLOCATIONS below
//   sink      a checksum of the work done. DETERMINISTIC: it must be identical between two runs of
//             the same binary. It is printed so that (a) a reader can see the loop really ran, and
//             (b) the compiler cannot fold the loop away — the result is consumed and printed.
//
// Only ns/op and total_ns are expected to move between runs. See NOISE below.
//
// ── MEASURING ALLOCATIONS ────────────────────────────────────────────────────────────────────────
// `liveB/op` is glibc's own accounting of bytes currently handed out: `mallinfo2().uordblks +
// .hblkhd`, sampled immediately before and after the timed loop. It is EXACT for live bytes — a
// case that allocates and frees reads 0; a case that leaks reads its leak, rounded up to glibc's
// chunk granularity (a 53-byte leak in two chunks reads 80). It is NOT an allocation COUNT: a
// program that churns a million malloc/free pairs also reads 0. Counting calls needs an
// interposer — see the two external modes below, both of which this file is written to support.
//
//   EXACT ALLOCATION COUNTS + LEAK BACKTRACES (valgrind):
//     make -f bootstrap/Makefile bench-valgrind
//   which is:
//     ./zen build tests/harness_bench.zen -o /tmp/zbench &&
//     ZEN_BENCH_SCALE=1 valgrind --leak-check=full --num-callers=12 /tmp/zbench
//   Read "total heap usage: N allocs, M frees" and the LEAK SUMMARY. Divide by the iters column to
//   get allocs/op. NOTE: under valgrind glibc's malloc is replaced, so `liveB/op` reads 0 in every
//   row — the in-process column and the valgrind column are alternatives, never both at once.
//   Valgrind is ~30x slower; use ZEN_BENCH_SCALE to shrink the loops first.
//
//   PROCESS-WIDE ALLOCATION COUNT (the repo's own LD_PRELOAD shim, no valgrind slowdown):
//     cc -shared -fPIC -O2 scripts/alloc-fuzz/oom-shim.c -ldl -o /tmp/oom-shim.so
//     ZALLOC_COUNT=1 LD_PRELOAD=/tmp/oom-shim.so /tmp/zbench > /dev/null
//   prints ZALLOC_TOTAL=<n>. Run it at two scales (ZEN_BENCH_SCALE=1 and =2) and subtract: the
//   difference divided by the added iterations is the exact allocs/op, free of startup noise.
//
// ── NOISE ────────────────────────────────────────────────────────────────────────────────────────
// This is a shared dev box. Time columns move run to run; allocation columns do not. Measure the
// floor before believing a regression:
//
//   ZEN_BENCH_REPS=7 make -f bootstrap/Makefile bench
//
// re-runs every case N times in one process (each rep prefixed `# rep k/N`). MEASURED on the
// 16-core dev box at load average ~7 (other work running) — min-to-max ns/op over 9 reps:
//
//   slicelit_sum  42–43         2.4%      sort_by_i64  854160–866570   1.5%
//   sb_chain      308–313       1.6%      map_put_get  125–133         6.4%
//   string_append 245–250       2.0%      println_int  1157–1178       1.8%
//   formatln_int  1799–1826     1.5%
//
// WITHIN one process the floor is tight: ~2% for most cases, ~6% worst (map_put_get). ACROSS
// processes it is not. One whole-suite run taken while a `cc` was finishing in the background read
// sb_chain at 519 ns/op against a 303–317 baseline — a 1.7x excursion from contention alone, with
// the allocation columns unchanged. So: never act on a single run. Re-run with ZEN_BENCH_REPS and
// compare the reps to each other before comparing to yesterday, and re-measure the floor on the
// machine you are judging on — the table above is one box on one day.
//
// ── PROVING THE LOOPS ARE REAL ───────────────────────────────────────────────────────────────────
// A benchmark that measures nothing is worse than none, so check the emitted C rather than trusting
// the source: `./zen emit tests/harness_bench.zen > /tmp/zbench.c` and read a case. `bn_slicelit`
// lowers to a plain `while ((_z3__z3_i < n)) { … }` whose body is
//
//   ({ int64_t _zsa[] = { i, i+1, i+2, i+3 }; uint8_t* _zsp = zen__salloc(sizeof(_zsa));
//      memcpy(_zsp, (uint8_t*)_zsa, sizeof(_zsa)); (zslice){ .ptr = _zsp, .len = 4 }; })
//
// followed by two bounds-checked `zen__idx` reads folded into `_z__z_acc`, which is returned as
// `.sink` and printed. Each iteration therefore performs a real malloc and a real memcpy, and its
// result is observable — cc cannot delete the loop at any -O level. `bn_sb_chain` likewise crosses
// the string-builder, view, and allocator-release call boundaries, so its work cannot be dropped.
//
// ── NO BASELINE FILE, ON PURPOSE ─────────────────────────────────────────────────────────────────
// There is deliberately no committed file of "expected" numbers and nothing compares against one.
// A number that gates a merge on a shared box is a flaky test. Record output, let a human compare.
//
// ── WHAT THIS DOES NOT MEASURE ───────────────────────────────────────────────────────────────────
//   * Compiler throughput (parse/check/emit rates). `zen run --time` already reports those stages.
//   * Release-optimised code. The bench binary is built with the DEFAULT `zen build` dev profile
//     (-O1 -g), which is what `zen run` and a plain `zen build` give every user — not `-r`'s
//     -O2. Absolute ns/op is therefore pessimistic against a release build; the RATIOS between
//     cases, and the movement of one case over time, are the signal. Build with `-r` by hand if
//     you want the release picture, but then compare only against other `-r` runs.
//   * Anything multi-threaded.
//
// ── PORTABILITY ──────────────────────────────────────────────────────────────────────────────────
// Linux/glibc only. `mallinfo2` is a glibc symbol, and it is bound here through the SysV x86-64
// large-struct-return convention (the hidden result pointer is passed as arg 0 and returned in rax),
// which is why its Zen decl is `(RawPtr<u8>) RawPtr<u8>`. `bn_abi_ok` verifies that at startup by
// checking the returned pointer equals the one passed in; if it ever does not, every liveB/op prints
// as -1 rather than a fabricated number. These three foreign decls (`mallinfo2`, `dup`, `dup2`) live
// here rather than in std.c.libc because they are bench-harness tooling, and tests/ is outside the
// std FFI/boundary gates — nothing in the language or stdlib depends on them.
{ put, println, formatln, arg_int } = std.text.fmt
{ sb } = std.text.sb
{ new_in, append_in, finish_in, free_in } = std.text.string
{ integer_in } = std.text.num
{ sort_by } = std.sort
citer = std.core.count
// NAMESPACED: map.zen's constructors are bare `empty`/`of`, names too generic to pull into the flat
// import namespace alongside everything else this file imports.
maps = std.collections.map
{ Heap, malloc, free } = std.mem.alloc
{ open, close, memcpy } = std.c.libc
{ O_WRONLY } = std.io.file
{ mono_ns } = std.time.clock
{ view, len, is_empty, try_parse_int, own_ptr } = std.text.str
{ expect } = std.core.result
{ getEnv } = std.sys.os
// ── the libc floor this harness needs and std does not export ─────────────────────────────────────
// `struct mallinfo2` is ten size_t words; on SysV x86-64 a struct that large is returned through a
// hidden pointer passed as the first argument and handed back in rax, so binding it as
// "takes a buffer, returns that buffer" is ABI-exact. bn_abi_ok checks that claim at runtime.
mallinfo2 = (out: RawPtr<u8>) RawPtr<u8>
// dup/dup2: the print cases must not spray millions of lines into the report, so fd 1 is pointed at
// /dev/null for the duration of the timed loop and restored afterwards. The write(2) syscall still
// happens — that is the cost being measured; only the destination is cheap.
dup = (fd: i32) i32
dup2 = (oldfd: i32, newfd: i32) i32
STDOUT_FD = () i32 { 1 }
// struct mallinfo2 field offsets (glibc malloc.h field order, i64 words):
//   0 arena  1 ordblks  2 smblks  3 hblks  4 hblkhd  5 usmblks  6 fsmblks  7 uordblks  8 fordblks
MI_SIZE = () i64 { 80 }
MI_HBLKHD_OFF = () i64 { 32 }    // bytes currently held in mmap'd blocks (large allocations)
MI_UORDBLKS_OFF = () i64 { 56 }    // bytes currently handed out from the brk arena
// live heap bytes right now: brk-arena bytes in use plus mmap'd bytes in use. Both are needed —
// glibc serves allocations above the mmap threshold (128 KiB by default) outside the arena, and a
// leak there would be invisible in uordblks alone.
bn_live = (cell: RawPtr<u8>) i64 {
    mallinfo2(cell)
    load_i64(cell.offset(MI_UORDBLKS_OFF())) + load_i64(cell.offset(MI_HBLKHD_OFF()))
}
// the ABI self-check: mallinfo2 must return the very buffer it was handed. False means the hidden-
// pointer convention this binding assumes does not hold here, and every liveB/op is then reported
// as -1 instead of a number nobody can trust.
bn_abi_ok = (cell: RawPtr<u8>) bool { to_i64(mallinfo2(cell)) == to_i64(cell) }
// one case's measurement. `sink` must be identical across two runs of the same binary.
BenchRes: {
    ns: i64,
    bytes: i64,
    sink: i64,
}
// ── report formatting ─────────────────────────────────────────────────────────────────────────────
// Every writer returns the byte count fmt's Printer already threads, and every chain ends in `.n`.
// That trailing `.n` is load-bearing, not decoration: this file imports std.collections.map, whose
// `Map.put` is a value-mold method, and the must-use check is NAME-based — so a bare statement-
// position `put("…")` (std.text.fmt's Printer opener) is rejected as a discarded self-mutating
// container method. Consuming the Printer with `.n` states that the result was used.
NAME_W = () i64 { 16 }
ITERS_W = () i64 { 12 }
NS_W = () i64 { 14 }
NSOP_W = () i64 { 12 }
BYTES_W = () i64 { 11 }
SINK_W = () i64 { 17 }
bn_sp = (n: i64) i64 {
    w ::= to_i64(0)
    i ::= to_i64(0)
    @while (i < n) {
        w = w + put(" ").n
        i = i + 1
    }
    w
}
bn_digits = (v: i64) i64 {
    d ::= (v < 0).then({ 2 }, { 1 })
    x ::= (v < 0).then({ 0 - v }, { v })
    @while (x > 9) {
        d = d + 1
        x = x / 10
    }
    d
}
// right-align `v` in a `w`-wide column. The pad is bound BEFORE the digits are written: `a + b` has
// no defined evaluation order in the emitted C, so a single `bn_sp(…) + put(…).n` expression could
// print the number ahead of its padding.
bn_num = (v: i64, w: i64) i64 {
    pad = bn_sp(w - bn_digits(v))
    pad + put("").i(v).n
}
// left-align `t` in a `w`-wide column.
bn_text = (t: StringView, w: i64) i64 {
    head = put(t).n
    head + bn_sp(w - len(t))
}
// right-align `t` in a `w`-wide column (the header labels, so they sit over their numbers).
bn_rtext = (t: StringView, w: i64) i64 {
    pad = bn_sp(w - len(t))
    pad + put(t).n
}
// the column header. It mirrors bn_row's widths and padding EXACTLY, including no trailing space on
// the final column, so a run's output has no trailing whitespace anywhere and diffs byte-for-byte.
bn_header = () i64 {
    bn_text("case", NAME_W())
    bn_rtext("iters", ITERS_W() - 1)
    bn_sp(1)
    bn_rtext("total_ns", NS_W() - 1)
    bn_sp(1)
    bn_rtext("ns/op", NSOP_W() - 1)
    bn_sp(1)
    bn_rtext("liveB/op", BYTES_W() - 1)
    bn_sp(1)
    bn_rtext("sink", SINK_W() - 1)
    put("\n").n
}
// one report row. `ok` is the mallinfo2 ABI verdict: when it is false the allocation column is -1,
// never a guess.
bn_row = (name: StringView, iters: i64, r: BenchRes, ok: bool) i64 {
    bn_text(name, NAME_W())
    bn_num(iters, ITERS_W() - 1)
    bn_sp(1)
    bn_num(r.ns, NS_W() - 1)
    bn_sp(1)
    bn_num(r.ns / iters, NSOP_W() - 1)
    bn_sp(1)
    bn_num(ok.then({ r.bytes / iters }, { 0 - 1 }), BYTES_W() - 1)
    bn_sp(1)
    bn_num(r.sink, SINK_W() - 1)
    put("\n").n
}
// a bare informational line (`# …`), void so it can sit inside a `.then` action.
bn_note = (t: StringView) void {
    put(t).n
    { }
}
bn_rep_note = (rep: i64, reps: i64) void {
    put("# rep ")
        .i(rep)
        .s("/")
        .i(reps)
        .nl().n
    { }
}
// ── stdout muting (the print cases) ───────────────────────────────────────────────────────────────
bn_mute = () i32 {
    saved = dup(STDOUT_FD())
    devnull = open("/dev/null", O_WRONLY, 0)
    dup2(devnull, STDOUT_FD())
    close(devnull)
    saved
}
bn_unmute = (saved: i32) void {
    dup2(saved, STDOUT_FD())
    close(saved)
}
// ── the cases ─────────────────────────────────────────────────────────────────────────────────────
// Each case is `(allocator, mallinfo cell, iters) BenchRes`: it snapshots live bytes and the clock,
// runs `iters` operations, snapshots again, and folds the work into `sink`. Setup and teardown sit
// OUTSIDE the two snapshots, so neither shows up in the numbers. Every case is called once with a
// small iteration count as a warmup (discarded) before the measured call — first-touch page faults
// and glibc arena growth belong to nobody's per-op cost.
// ONE OP = build one 4-element `[i64]` slice literal and read two elements out of it.
// This is the control case as much as a measurement: a slice literal is a heap block
// (c_expr.zen's gen_slicelit promotes every literal, escaping or not, and never frees it), so a
// nonzero liveB/op here is CORRECT and expected — it is the documented KNOWN LEAK. If this row ever
// reads 0, either the leak was fixed (good, say so) or the measurement broke (check `sink` moved).
bn_slicelit = (mp: MutPtr<Heap>, cell: RawPtr<u8>, n: i64) BenchRes {
    acc ::= to_i64(0)
    b0 = bn_live(cell)
    t0 = mono_ns()
    i ::= to_i64(0)
    @while (i < n) {
        xs: MutSlice<i64> = [i, i + 1, i + 2, i + 3]
        acc = acc + xs[0] + xs[3]
        i = i + 1
    }
    t1 = mono_ns()
    BenchRes(
        ns: t1 - t0,
        bytes: bn_live(cell) - b0,
        sink: acc,
    )
}
// ONE OP = one step of a count loop over `0 .. n`, folding the index into `acc`.
// `count_while` and `count_times` are the SAME loop written two ways — hand-rolled `@while` versus
// std.collections.iter's `n.times`, whose body closure inlines. The body is a single add, so there is
// nowhere for iterator overhead to hide: read the two rows as a pair, and any gap between them IS the
// cost of the iterator surface.
bn_count_while = (mp: MutPtr<Heap>, cell: RawPtr<u8>, n: i64) BenchRes {
    acc ::= to_i64(0)
    b0 = bn_live(cell)
    t0 = mono_ns()
    i ::= to_i64(0)
    @while (i < n) {
        acc = acc + i
        i = i + 1
    }
    t1 = mono_ns()
    BenchRes(
        ns: t1 - t0,
        bytes: bn_live(cell) - b0,
        sink: acc,
    )
}
bn_count_times = (mp: MutPtr<Heap>, cell: RawPtr<u8>, n: i64) BenchRes {
    acc ::= to_i64(0)
    b0 = bn_live(cell)
    t0 = mono_ns()
    citer.times(n, (i) { acc = acc + i })
    t1 = mono_ns()
    BenchRes(
        ns: t1 - t0,
        bytes: bn_live(cell) - b0,
        sink: acc,
    )
}
// ONE OP = build "id=<n> name=zen!" with the std.text.sb chain and free the result.
// Paired with bn_string_append below: same output bytes, same allocator, different surface. The
// delta between the two rows is what Sb's sticky-error wrapper costs over raw String appends.
bn_sb_chain = (mp: MutPtr<Heap>, cell: RawPtr<u8>, n: i64) BenchRes {
    acc ::= to_i64(0)
    b0 = bn_live(cell)
    t0 = mono_ns()
    i ::= to_i64(0)
    @while (i < n) {
        s: StringView = mp
            .sb()
            .s("id=")
            .i(i)
            .s(" name=zen")
            .ch('!')
            .done()
            .expect("bench: sb")
        v = s.view()
        acc = acc + v.len
        free(s.own_ptr())
        i = i + 1
    }
    t1 = mono_ns()
    BenchRes(
        ns: t1 - t0,
        bytes: bn_live(cell) - b0,
        sink: acc,
    )
}
// ONE OP = build the SAME "id=<n> name=zen!" with raw std.text.string appends and free it.
// The digits go through `integer_in` + `finish_in` + `free_in`, which is exactly what `Sb.i` does
// internally — so this measures the ceremony, not a different algorithm.
bn_string_append = (mp: MutPtr<Heap>, cell: RawPtr<u8>, n: i64) BenchRes {
    acc ::= to_i64(0)
    b0 = bn_live(cell)
    t0 = mono_ns()
    i ::= to_i64(0)
    @while (i < n) {
        g ::= mp.new_in().expect("bench: new_in")
        g = mp.append_in(g, "id=").expect("bench: append")
        d = mp.integer_in(i).expect("bench: integer_in")
        g = mp.append_in(g, mp.finish_in(d).expect("bench: digits")).expect("bench: append")
        d.free_in(mp)
        g = mp.append_in(g, " name=zen!").expect("bench: append")
        s = mp.finish_in(g).expect("bench: finish")
        acc = acc + len(s)
        g.free_in(mp)
        i = i + 1
    }
    t1 = mono_ns()
    BenchRes(
        ns: t1 - t0,
        bytes: bn_live(cell) - b0,
        sink: acc,
    )
}
// ONE OP = `println(<i64>)` with fd 1 pointed at /dev/null.
// The write(2) syscall is real; only the destination is cheap. The muting happens outside the
// snapshots, so the two dup2 calls are not in the timings.
// The sink here is exactly `iters`, which looks degenerate but is honest: `i64`'s `fmt_println`
// (fmt.zen) is `{ n.write_int()  newline() }` — the digit count is DROPPED and only newline()'s 1
// is returned, so println's documented "byte count" is 1 for every integer. Nothing here can
// observe the digits. The loop is still un-elidable (each iteration is a write(2) syscall) and
// liveB/op still sees the per-call leak; only the checksum is weaker than formatln_int's.
bn_println_int = (mp: MutPtr<Heap>, cell: RawPtr<u8>, n: i64) BenchRes {
    acc ::= to_i64(0)
    saved = bn_mute()
    b0 = bn_live(cell)
    t0 = mono_ns()
    i ::= to_i64(0)
    @while (i < n) {
        acc = acc + println(i)
        i = i + 1
    }
    t1 = mono_ns()
    bytes = bn_live(cell) - b0
    bn_unmute(saved)
    BenchRes(
        ns: t1 - t0,
        bytes: bytes,
        sink: acc,
    )
}
// ONE OP = `formatln("id={}", [arg_int(<i64>)])` with fd 1 pointed at /dev/null.
// THE case this whole suite was built for. Two heap blocks leak per call — the `[Arg]` slice literal
// and `write_int`'s digit scratch, both heap-promoted by gen_slicelit and never freed — so liveB/op
// reads ~80 (53 payload bytes rounded up to glibc chunks). It must go to 0 when that is fixed.
bn_formatln_int = (mp: MutPtr<Heap>, cell: RawPtr<u8>, n: i64) BenchRes {
    acc ::= to_i64(0)
    saved = bn_mute()
    b0 = bn_live(cell)
    t0 = mono_ns()
    i ::= to_i64(0)
    @while (i < n) {
        acc = acc + formatln("id={}", [arg_int(i)])
        i = i + 1
    }
    t1 = mono_ns()
    bytes = bn_live(cell) - b0
    bn_unmute(saved)
    BenchRes(
        ns: t1 - t0,
        bytes: bytes,
        sink: acc,
    )
}
SORT_N = () i64 { 10000 }
// ONE OP = memcpy a pristine 10 000-element scramble into place, then `sort_by(<)` it.
// The scramble is built once (a deterministic LCG) outside the timed loop, so every iteration sorts
// the SAME input and `sink` is stable. The 80 KB memcpy IS inside the timing: measured separately
// at ~1.9 us against ~855 us for the sort, so it is ~0.2% of the op — a tax, not a confound. `sink`
// folds the first, middle and last element of every sorted pass, so a comparator that stopped
// ordering the slice would change it (with values drawn from [0, 1000000) the three pinned
// positions land near 0 / 500000 / 1000000 only if the sort really ran).
bn_sort_by = (mp: MutPtr<Heap>, cell: RawPtr<u8>, n: i64) BenchRes {
    m = SORT_N()
    srcbuf = assert_nonnull(malloc(m * sizeof(i64)))
    dstbuf = assert_nonnull(malloc(m * sizeof(i64)))
    src :: MutSlice<i64> = srcbuf.slice(m)
    dst: MutSlice<i64> = dstbuf.slice(m)
    seed ::= 12345
    src.loop((h, k, x) {
        seed = (seed * 1103515245 + 12345) % 2147483647
        src[k] = seed % 1000000
    })
    acc ::= to_i64(0)
    b0 = bn_live(cell)
    t0 = mono_ns()
    i ::= to_i64(0)
    @while (i < n) {
        memcpy(dstbuf, srcbuf, m * sizeof(i64))
        dst.sort_by((a: i64, b: i64) bool { a < b })
        acc = acc + dst[0] + dst[m / 2] + dst[m - 1]
        i = i + 1
    }
    t1 = mono_ns()
    bytes = bn_live(cell) - b0
    free(srcbuf)
    free(dstbuf)
    BenchRes(
        ns: t1 - t0,
        bytes: bytes,
        sink: acc,
    )
}
MAP_KEYS = () i64 { 2000 }
// ONE OP = one `Map<i64>.put` plus one `Map<i64>.get`, so `n` counts KEY OPERATIONS and the number
// of rounds is n / MAP_KEYS (every other case's `n` is already its op count — this keeps the column
// meaning uniform). A round builds a fresh map, inserts every key, reads every key back, and frees
// the map — that covers insertion, the rehash/grow path, and lookup. Keys are generated ONCE before
// the snapshots (Map borrows key pointers, so they must outlive it) and freed after, keeping key
// rendering out of both columns. liveB/op should be 0: every round frees what it took.
bn_map_put_get = (mp: MutPtr<Heap>, cell: RawPtr<u8>, n: i64) BenchRes {
    rounds = (n / MAP_KEYS() < 1).then({ 1 }, { n / MAP_KEYS() })
    nk = MAP_KEYS()
    keybuf = assert_nonnull(malloc(nk * sizeof(StringView)))
    keys :: MutSlice<StringView> = keybuf.slice(nk)
    keys.loop((h, k, x) {
        d = mp.integer_in(k * 7919).expect("bench: key")
        keys[k] = mp.finish_in(d).expect("bench: key")
    })
    acc ::= to_i64(0)
    b0 = bn_live(cell)
    t0 = mono_ns()
    i ::= to_i64(0)
    @while (i < rounds) {
        e: Result<maps.Map<i64>, IoError> = maps.empty(mp)
        m ::= e.expect("bench: map empty")
        keys.loop((h, k, key) {
            m = m.put(mp, key, k).expect("bench: map put")
        })
        keys.loop((h, k, key) {
            acc = acc + m.get(key, 0 - 1)
        })
        m.free(mp)
        i = i + 1
    }
    t1 = mono_ns()
    bytes = bn_live(cell) - b0
    keys.loop((h, k, key) {
        free(key.view().ptr)
    })
    free(keybuf)
    BenchRes(
        ns: t1 - t0,
        bytes: bytes,
        sink: acc,
    )
}
// ── driver ────────────────────────────────────────────────────────────────────────────────────────
// run one case: a discarded warmup call, then the measured call, then the row.
bn_run = (
    mp: MutPtr<Heap>,
    cell: RawPtr<u8>,
    ok: bool,
    name: StringView,
    iters: i64,
    warm: i64,
    f: (MutPtr<Heap>, RawPtr<u8>, i64) BenchRes,
) void {
    warmup = f(mp, cell, warm)    // discarded: first-touch faults and arena growth belong to no op
    bn_row(name, iters, f(mp, cell, iters), ok)
}
// a positive integer from the environment, or `dflt` when unset/unparseable/non-positive.
bn_env_n = (name: StringView, dflt: i64) i64 {
    e = getEnv(name)
    is_empty(e).match ({
        true  => dflt,
        false => try_parse_int(e).match ({
            .Ok(v)  => (v < 1).then({ dflt }, { v }),
            .Err(x) => dflt,
        }),
    })
}
// every case at its measured size, scaled by ZEN_BENCH_SCALE. The sizes are picked so each timed
// loop runs for order-10ms-to-1s (long enough that clock granularity and a stray context switch do
// not dominate) while the whole suite stays a few seconds.
bn_all = (mp: MutPtr<Heap>, cell: RawPtr<u8>, ok: bool, scale: i64) void {
    mp.bn_run(cell, ok, "slicelit_sum", 1000000 * scale, 1000, bn_slicelit)
    mp.bn_run(cell, ok, "count_while", 20000000 * scale, 1000, bn_count_while)
    mp.bn_run(cell, ok, "count_times", 20000000 * scale, 1000, bn_count_times)
    mp.bn_run(cell, ok, "sb_chain", 500000 * scale, 1000, bn_sb_chain)
    mp.bn_run(cell, ok, "string_append", 500000 * scale, 1000, bn_string_append)
    mp.bn_run(cell, ok, "println_int", 200000 * scale, 1000, bn_println_int)
    mp.bn_run(cell, ok, "formatln_int", 200000 * scale, 1000, bn_formatln_int)
    mp.bn_run(cell, ok, "sort_by_i64", 200 * scale, 2, bn_sort_by)
    mp.bn_run(cell, ok, "map_put_get", 400 * scale * MAP_KEYS(), MAP_KEYS(), bn_map_put_get)
}
main* = () i32 {
    m = Heap(_: 0)
    mp = m.addr()
    cell = assert_nonnull(malloc(MI_SIZE()))
    ok = bn_abi_ok(cell)
    (ok == false).then({
        bn_note("# WARNING: mallinfo2 did not return its argument — liveB/op unavailable\n")
    })
    scale = bn_env_n("ZEN_BENCH_SCALE", 1)
    reps = bn_env_n("ZEN_BENCH_REPS", 1)
    bn_header()
    r ::= to_i64(0)
    @while (r < reps) {
        (reps > 1).then({
            bn_rep_note(r + 1, reps)
        })
        mp.bn_all(cell, ok, scale)
        r = r + 1
    }
    free(cell)
    0
}
