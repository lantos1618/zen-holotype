// HYGIENE, REFUSED LOUDLY. `docs/design_meta.md` §7's M4 risk names
// `gen_c_inline.zen`'s header as "the record of how a captured `h` goes
// silently wrong rather than loudly": inlining a lambda puts its body
// inside another frame, and a free `h` there binds to whatever handle
// that frame has.
//
// AN UNROLLED LOOP HAS NO HANDLE AT ALL. There is no iteration to break
// out of and no next field to continue to — the residue is N nested
// blocks, and `h.break(true)` in one of them has no meaning M4 decided.
// So naming the lambda's first parameter is refused where it is
// written, rather than bound to something plausible.
//
// ONE SENTENCE, NOT ONE PER FIELD, and that is what `.count` holds:
// every field copies the SAME body, so a body the walk cannot copy is
// one mistake. `sema_meta.meta_one` stops at the first field for
// exactly this.
//
// position: the `h` the body named.

Rec = { alpha*: i64, beta*: str }

main = (env: Env) Res<i32, AllocError> {
    r = Rec(alpha: 71, beta: "quince");
    @meta(r: Rec).fields().loop((h, field) {
        h.break(true);
    });
    Ok(0);
}
