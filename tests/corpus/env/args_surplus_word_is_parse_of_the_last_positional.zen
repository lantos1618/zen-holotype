// More words than positional fields is Parse of the last one.

ArgError = std.env

// The shape the agent-zen entry point wants: switches, numbers with
// defaults, a text default, a one-letter flag that is also the first
// positional, an optional second positional, an optional number, and a
// required secret spelled as its variable, which only the environment
// supplies: uppercase means no flag and never a positional.
Cli = {
    stream ::  bool  = false,
    fleet ::   usize = 0,
    model ::   str   = "default-model",
    C:         str,
    prompt:    Res<str>,
    retries:   Res<usize>,
    KEY:       str,
}

show = (r: Res<Cli, ArgError>) () {
    r.match({
        Ok(c)           => {
            println("stream {}", c.stream);
            println("fleet {}", c.fleet);
            println("model {}", c.model);
            println("C {}", c.C);
            println("prompt {}", c.prompt.value_or("<none>"));
            println("retries {}", c.retries.value_or(99));
            println("key {}", c.KEY);
        },
        Err(Missing(f)) => println("missing {}", f),
        Err(Parse(f))   => println("parse {}", f),
    })
}

main = (env: Env) Res<i32, AllocError> {
    show(env.args<Cli>());
    Ok(0);
}
