// AN IMPL-SUPPLIED COMPUTED FIELD IS A TYPED POSITION. Its type is the
// bound's declaration (`width: i32` in Boxy), read back exactly as a
// use of the field reads it — so a match inside the field expression
// whose arms disagree must be refused, the same rule
// `match_arms_disagree` holds every written-type position to. Nothing
// walked the field value at all: it compiled, ran, and printed the 1
// nobody wrote — the same wrong answer issue 727's closure body printed.
//
// position: the arm that does not fit the bound's declaration.

Boxy = {
    width: i32,
    height: i32,
}

Square = {
    side :: i32,
}

Square.impl(Boxy, {
    width: self.side.match({ 0 => 0, _ => true }),
    height: self.side,
})

main = (env: Env) Res<i32, AllocError> {
    s = Square(side: 2);
    println("{}", s.width);
    Ok(0);
}
