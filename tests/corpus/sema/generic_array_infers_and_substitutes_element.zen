// Array element types participate in generic inference and substitution just
// like named-container arguments. The return type must settle to i64 here.

first = <T>(values: [T, 2]) T { values[0] }

main = (env: Env) Res<i32, AllocError> {
    values: [i64, 2] = [11, 22];
    got: i64         = first(values);
    println("{}", got);
    Ok(0);
}
