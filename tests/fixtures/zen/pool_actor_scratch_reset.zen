// PER-ACTOR SCRATCH RESET proof (std.concurrent.pool + pool_actor, S4-lite two-memory model). A single
// typed actor is given a TINY scratch arena (SCAP = 256 bytes) and bump-allocates a CHUNK = 64 bytes into
// `self.scratch` on EVERY message. It processes NMSG = 2000 messages. The arena holds only SCAP/CHUNK = 4
// chunks, so if the pool did NOT reset the scratch at each behavior boundary the 5th bump (and every one
// after) would return null and the actor could complete at most 4 successful allocations. Because the
// worker RESETS the scratch wholesale after every behavior (pool.zen drain_batch, on the normal stack),
// each `receive` sees a fresh off==0 arena, so ALL 2000 bumps succeed. The actor counts non-null bumps.
//
// PROOF (exit 7 iff BOTH hold):
//   (a) ok == NMSG            — a 256-byte arena served 2000×64-byte allocations => it was reset per message
//                               (unbounded reuse of a bounded backing block, the structural reclaim).
//   (b) sc.used() == 0        — after quiescence the LAST behavior's reset left the bump pointer at 0
//                               (the arena high-water is one chunk, never the cumulative 2000 chunks).
{ pool_open, pool_quiesce_stop, pool_close, Pool } = std.concurrent.pool
{ malloc, free } = std.mem.alloc
{ is_null } = std.core.ptr
{ Arena } = std.mem.arena
pa = std.concurrent.pool_actor
NMSG := 2000
SCAP := 256    // 4 chunks of headroom — far less than NMSG, so only per-behavior reset makes every bump fit
CHUNK := 64
WORKERS := 2
Msg*: Work(i64)
Worker*: {
    scratch: MutPtr<Arena>,
    ok: RawPtr<u8>,
}
Worker.impl(pa.Receiver, {
    receive = (w: MutPtr<Worker>, ctx: pa.Context<Msg>) void {
        ctx.msg.match ({
            .Work(n) => {
                p := w.scratch.bump(CHUNK)    // allocate this behavior's OWN temporary into scratch
                (is_null(p) == false).then({
                    atomic_add_i64(w.ok, 1)
                })
            },
        })
    }
})
tramp = (user: RawPtr<u8>, msg: i64) void {
    a: [Worker] := user.slice(1)
    b: [Msg] := msg.offset(0).slice(1)
    a[0].addr().receive(pa.Context(msg: b[0]))
    pa.free_msg(msg)
}
send_n = (p: MutPtr<Pool>, h: pa.PooledHandle<Worker>, k: i64) void {
    (k < NMSG).then({
        p.send(h, Msg.Work(k))
        send_n(p, h, k + 1)
    })
}
main = () i32 {
    ok := malloc(8)
    store_i64(ok, 0)
    sc := pa.new_scratch(SCAP)
    h := pa.spawn_actor_scratch_heap(NMSG + 16, Worker(
        scratch: sc,
        ok: ok,
    ), tramp, sc)
    p := pool_open(WORKERS, 16)
    send_n(p, h, 0)
    p.pool_quiesce_stop()
    got := load_i64(ok)
    high := sc.used()
    pa.close(h)
    p.pool_close()
    pa.free_scratch(sc)
    free(ok)
    (got == NMSG && high == 0).match ({ true => 7, false => 1 })
}
