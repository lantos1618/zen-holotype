// fmt one-shot idempotence on IMPORT-LIST REWRAP: a wrapped import list caught MID-EDIT — names
// added pushed the first line past 100 columns, and the remaining breaks no longer match the greedy
// refill (an underfull continuation line follows the overfull one). ONE fmt pass must produce the
// canonical wrap by REFLOWING from the flat name list — an immediate `fmt --check` must be clean,
// never a second "adjusting" pass (the #618 one-shot law, applied to ff_import_wrapped).
{ open, read, write, close, lseek, system, unlink, access, mkdir, rmdir, rename, opendir, readdir, rewinddir, closedir,
  getpid,
  isatty, calloc, memcpy, strlen, strcmp, getenv, clock_gettime, popen, pclose, fgets, abort } = std.c.libc
main = () i32 {
    (getpid() > 0).then({ 0 }, { 1 })
}
