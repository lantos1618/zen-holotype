// The std has no entropy, so Rng is a generator the caller seeds: the same
// seed replays the same sequence, and `below` never reaches its bound.

Rng = std.core

main = (env: Env) Res<i32, AllocError> {
    r1 ::= Rng.seeded(7);
    r2 ::= Rng.seeded(7);
    a = r1.next_u64();
    b = r2.next_u64();
    println("first from seed 7 is {}", a);
    println("same seed same answer {}", a == b);
    println("uses the full width {}", a > 4294967295);
    println("below 10 stays below {}", r1.below(10) < 10);
    println("zero bound {}", r1.below(0));
    r3 ::= Rng.seeded(7);
    println("rejection sample {}", r3.below(9223372036854775809));
    Ok(0);
}
