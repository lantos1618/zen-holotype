{ Map } = std.collections.map
{ Allocator, AllocatorVTable, allocator_of, heap_allocator } = std.mem.alloc
{ Result, IoError } = std.core.result
oom_acquire = (state: RawPtr<u8>, n: i64) RawPtr<u8> { null_ptr() }
oom_resize = (state: RawPtr<u8>, p: RawPtr<u8>, n: i64) RawPtr<u8> { null_ptr() }
oom_release = (state: RawPtr<u8>, p: RawPtr<u8>) void { }
oom_vtable ::= AllocatorVTable(
    vt_alloc: oom_acquire,
    vt_remap: oom_resize,
    vt_free: oom_release,
)
oom_allocator = () Allocator { allocator_of(null_ptr(), oom_vtable.addr().offset(0)) }
main = () i32 {
    a = heap_allocator()
    m ::= a.map_of("x", 42).expect("map")
    inferred = m.get("x", 0)
    m.free(a.addr())
    failed = oom_allocator().map_of("x", 1).match ({
        .Ok(w)  => false,
        .Err(e) => true,
    })
    (inferred == 42 && failed).then({ 0 }, { 1 })
}
