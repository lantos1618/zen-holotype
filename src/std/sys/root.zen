// std.sys.root — the root capability. The runtime builds ONE `Sys` and hands it to `main = (sys: Sys) i32`.
//
// `Sys` is a plain record bundling NARROW capabilities — a `Writer` (stdout/stderr), the process-heap
// `AllocatorBackend`, plus `Env` (argv + environment variables), `Clock` (monotonic + wall time), and `Fs`
// (file read/write). The whole point is ATTENUATION: a library function should take the narrowest
// capability it actually needs (a `Writer`, an `AllocatorBackend`), never the entire `Sys`.
//
//   main = (sys: Sys) i32 {
//       sys.stderr().write("hi\n")           // needs only a Writer
//       h = sys.heap()                      // the process heap AllocatorBackend
//       p = h.addr().acquire(64)
//       h.addr().release(p)
//       0
//   }
//   greet = (w: Writer) void { w.write("hello\n") }      // narrowest — a Writer, not the world
//
// This coexists with `main = () i32` (the niladic entry): the compiler emits a niladic `zen_main`
// trampoline that calls the user's main with `std.sys.root()` when the param is present, so the C
// boundary (zenrt.c) stays byte-identical. See docs/ARCHITECTURE.md for the entry pipeline.
//
{ Heap } = std.mem.alloc
{ gpa } = std.mem.heap
{ view } = std.text.str
{ Result, IoError, name, panic } = std.core.result
{ argc, arg, getEnv } = std.sys.os
{ mono_ns, wall_s } = std.time.clock
// The one fd write-all loop lives in std.io.file (the lowest-level file module, already imported here);
// `write` / `write_bytes` below thread the raw descriptor through it. See std.io.file for the contract.
{ contents, save, write_all } = std.io.file
STDOUT_FD = 1
STDERR_FD = 2
// Writer — a byte sink over a POSIX descriptor (fd 1 = stdout, fd 2 = stderr). The narrowest output
// capability: hand a library a `Writer` and it can emit bytes, nothing else. `write` takes a str (no
// trailing NUL assumed); `write_bytes` a length-tracked slice. Both do a write-all loop and surface
// failure as a value: `Result<i64, IoError>` (`.Ok(bytes_written)` or `.Err`) — so a broken pipe
// (EPIPE), full disk (ENOSPC), or closed fd is a value you can `.or_return()`/`.match`, never swallowed.
Writer*: {
    fd: i32,
    write = (w: Writer, s: StringView) Result<i64, IoError> {
        v = s.view()
        write_all(w.fd, v.ptr, v.len, 0)
    }
    write_bytes = (w: Writer, b: MutSlice<u8>) Result<i64, IoError> {
        write_all(w.fd, b.ptr, b.len, 0)
    }
    write_line = (w: Writer, s: StringView) Result<i64, IoError> {
        w.write(s).match ({
            .Err(e) => .Err(e),
            .Ok(n)  => w.write("\n").match ({
                .Err(e) => .Err(e),
                .Ok(m)  => .Ok(n + m),
            }),
        })
    }
    write_or_panic = (w: Writer, s: StringView) i64 {
        // Convenience for the "I want to know, but won't thread a Result" case: write, and on failure
        // PANIC loudly naming the IoError (framed `zen: panic: <err>`, then abort). One call, no `.match`,
        // no Result plumbing — the honest-but-fatal sink for scripts. Returns the byte count on success.
        w.write(s).match ({
            .Ok(n)  => n,
            .Err(e) => {
                panic(e.name())
                0
            },
        })
    }
}
stdout_writer = () Writer { Writer(fd: STDOUT_FD) }
stderr_writer = () Writer { Writer(fd: STDERR_FD) }
// Env — argv + environment variables (wraps std.sys.os): `argc()` counts CLI args (incl. argv[0]), `arg(i)`
// reads the i-th ("" if out of range), `get(name)` reads an env var ("" if unset).
Env: {
    _: i32,
    argc = (e: Env) i32 { argc() }
    arg  = (e: Env, i: i32) StringView { arg(i) }
    get  = (e: Env, name: StringView) StringView { getEnv(name) }
}
// Clock — monotonic + wall time (wraps std.time): `mono_ns()` is a steadily-rising counter (for
// durations), `wall_s()` is seconds since the Unix epoch.
Clock: {
    _: i32,
    mono_ns = (c: Clock) i64 { mono_ns() }
    wall_s  = (c: Clock) i64 { wall_s() }
}
// Fs — file read/write (wraps std.io.file): `read(a, path)` slurps a file into an `a`-owned
// NUL-terminated buffer; `save(path, data, n)` writes the first `n` bytes, creating/truncating.
Fs: {
    _: i32,
    read = (fs: Fs, a: MutPtr<Heap>, path: StringView) Result<StringView, IoError> {
        a.contents(path)
    }
    save = (fs: Fs, path: StringView, data: StringView, n: i64) Result<i64, IoError> {
        path.save(data, n)
    }
}
// Spawner — planned Sys capability for typed actor creation on the pool (tracked in docs/STATUS.md).
// Wave 3 stub: documents the surface. A real pooled spawn needs a concrete (ActorT, M) trampoline
// symbol, but this generic `spawn` signature carries no actor type — that wiring waits on the deferred
// #26 auto-trampoline. Until then `spawn` returns `.Err(.Errno(38))` (ENOSYS, "function not
// implemented") — an error VALUE the caller can `.match`/`.or_return`, never a process abort. Use
// std.concurrent.pool_actor's `spawn_actor` family for real typed actor creation today.
Spawner: {
    _: i32,
    spawn = (sp: Spawner) Result<i32, IoError> { .Err(.Errno(38)) }
}
// Sys — the root capability bundle, built by `root()` and passed to `main = (sys: Sys) i32`. Its methods
// hand out narrow capabilities: `heap()` the process heap AllocatorBackend, `stdout()`/`stderr()` the fd-1/fd-2
// Writers, `env()`/`clock()`/`fs()` the OS wrappers.
Sys*: {
    _out: Writer,
    _err: Writer,
    _env: Env,
    _clock: Clock,
    _fs: Fs,
    heap    = (s: Sys) Heap { gpa() }
    stdout  = (s: Sys) Writer { s._out }
    stderr  = (s: Sys) Writer { s._err }
    env     = (s: Sys) Env { s._env }
    clock   = (s: Sys) Clock { s._clock }
    fs      = (s: Sys) Fs { s._fs }
    spawner = (s: Sys) Spawner { Spawner(_: 0) }
}
// root() — assemble the default `Sys`: heap allocator, real stdout/stderr, env/clock/fs over the OS.
// Pure Zen — the compiler's niladic `zen_main` trampoline calls this to feed `main = (sys: Sys) i32`.
root* = () Sys {
    Sys(
        _out: stdout_writer(),
        _err: stderr_writer(),
        _env: Env(_: 0),
        _clock: Clock(_: 0),
        _fs: Fs(_: 0),
    )
}
