// The silent-glue repro: newline + `.Uppercase` ALWAYS ends the previous statement — even when
// the previous expression is a bare Uppercase variable. Before the fix, the uppercase-subject
// carve-out glued `x = Def` ⏎ `.Okv(x)` into the bogus qualified ctor `Def.Okv(x)` and the build
// failed with unknown-type; now `.Okv(x)` is the trailing expression of `pick`.
Res: Okv(i32) | Nov
pick = (y: i32) Res {
    Def = y + 1
    x = Def
    .Okv(x)
}
main = () i32 {
    pick(40).match ({
        .Okv(v) => v + 1,
        .Nov    => 7,
    })
}
