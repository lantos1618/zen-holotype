// tests/corpus/traps/index_runtime.zen
// an index the compiler cannot see is still bounds-checked. this one
// comes from the environment, so the check has to survive to runtime

// main must name an error type. a trap never lifts into Res:
// it aborts the process
Error = Overflow | DivideByZero | OutOfBounds

main = (env: Env) Res<i32, Error> {
    primes   = [i32, 4](2, 3, 5, 7);
    i: usize = env.vars.get("ZEN_TRAP_NEVER_SET").match({
        Ok(_) => 0,
        None  => 9,
    });
    v        = primes[i];
    println("{}", v);
    Ok(0);
}
