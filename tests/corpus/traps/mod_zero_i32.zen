// tests/corpus/traps/mod_zero_i32.zen
// x % 0 traps for the same reason x / 0 does: the same instruction
// computes both. the divisor comes from the environment

// main must name an error type. a trap never lifts into Res:
// it aborts the process
Error = Overflow | DivideByZero | OutOfBounds

main = (env: Env) Res<i32, Error> {
    // a zero the compiler cannot see: it comes from the environment
    zero: i32 = env.vars.get("ZEN_TRAP_NEVER_SET").match({
        Ok(_) => 1,
        None  => 0,
    })
    r = 10 % zero;
    println("{}", r);
    Ok(0);
}
