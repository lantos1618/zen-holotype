// An impl body is a body. `check_decl` matched `Function` and `Struct`
// and let an `Impl` fall through its wildcard, so a method an impl
// supplies was walked by nothing in sema at all and the return type it
// promised was checked by nobody.
//
// position: the tail expression, which is the value that has to change.

Boxy = {
    width: i32,
    height: i32,

    area* ::= (self: @Self) i32 { self.width * self.height }
}

Tile = {
    side: i32,
}

Tile.impl(Boxy, {
    width: self.side,
    height: self.side,

    area = (self: @Self) i32 { "not an int" }
})

main = (env: Env) Res<i32, AllocError> {
    println("{}", Tile(side: 2).area());
    Ok(0);
}
