// The same mistake written out — `Colour.Purple` — changes nothing:
// qualification is reduced to its last segment before the case list is
// asked, so the qualified spelling went down exactly the same path and
// bound everything in silence too.
//
// position: the pattern that binds.

Colour = Red | Green | Blue

name = (c: Colour) str {
    c.match({
        Colour.Purple => "purple",
    })
}

main = (env: Env) Res<i32, AllocError> {
    println("{}", name(Colour.Green));
    Ok(0);
}
