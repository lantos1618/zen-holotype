// Vec comes from std.collections, Circle from `circle`, and the
// instantiation Vec<Circle> belongs to neither module. this is the case
// whole-program compilation exists for -- DESIGN.md: "separate
// compilation would have to decide which object file owns Vec<Circle>".

Circle, area = circle.circle

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    shapes ::= alloc.Vec<Circle>();
    shapes.add(Circle(radius: 1)).try();
    shapes.add(Circle(radius: 2)).try();

    shapes.loop((h, c) {
        println("{}", c.area());
    });
    Ok(0);
}
