// tests/corpus/parse/parser_deep_nesting.zen
// 10,000 nested parentheses are a diagnostic, not a crash.
//
// TESTING.md: "A recursive-descent parser stack-overflows and this is
// a crash, not a diagnostic. Decide the depth limit and emit an error
// at it." src/std/parse/parser.zen decides, and says there why the number
// is what it is.
//
// THE PROBE DEPTHS STRADDLE THAT NUMBER AND ARE NOT THE NUMBER. What
// is being tested is the mechanism — a bound that reports — so one
// probe sits inside the limit and two sit outside it, and moving the
// limit means moving these rather than rewriting the test. 300 is the
// inside probe on purpose: it is what
// `tests/corpus/codegen/nesting_expr.zen` writes and argues for, so
// the two files agree about what the language promises to parse.
// They did NOT agree before — this file asserted a refusal at 300 that
// the other file expected to compile — and a limit cannot be both.
//
// THREE THINGS ARE ASSERTED, and the third is the one that is easy to
// get wrong:
//
//   it terminates, with an exit code and not a signal
//   it says so — one diagnostic
//   it is ANCHORED AT THE OUTERMOST BRACKET OF THE RUN. A diagnostic
//   pointing at level 257 of a 10,000-deep file names the one place
//   the author cannot see the problem from. And it must be ONE
//   diagnostic: past the limit the parser stops descending, so every
//   frame it unwinds through finds a delimiter it cannot close and
//   would otherwise report it — 256 messages for one mistake.

scan, Source = std.lex.lex
Parser, MAX_DEPTH = std.parse.parser
expr = std.parse.parse_expr
Ast = std.ast.ast_arena
ExprId = std.ast.ast_id

// `((( .. 1 .. )))`, built rather than written out, which is the only
// reason a 10,000-deep test is cheap enough to keep.
//
// It speaks `WriteError` rather than `AllocError` because `String.add`
// does: writing into a growable String can fail to grow (AllocError)
// and writing into a console can fail to write (IoError), and there is
// no `From`, so the honest type is the union. `.try()` merges either
// into this function's set for free.
nested = (alloc: Alloc, depth: usize) Res<str, WriteError> {
    sb ::= alloc.String("").try();
    Range(0, depth).loop((h, i) { sb.add("(").try(); });
    sb.add("1").try();
    Range(0, depth).loop((h, i) { sb.add(")").try(); });
    Ok(sb.view());
}

node_name = (tree: Ast, id: ExprId) str {
    tree.expr_at(id).kind.match({
        Paren(_)   => "paren",
        Unit       => "unit",
        Literal(_) => "literal",
        _          => "other",
    });
}

run = (env: Env, alloc: Alloc, depth: usize) Res<(), WriteError> {
    text = nested(alloc, depth).try();
    lexed = scan(alloc, Source(file: "t.zen", text: text)).try();
    p ::= alloc.Parser(lexed);
    p.drain().try();
    id = p.expr().try();

    // A parse that stopped still hands back a tree that can be WALKED.
    // That is the point of a poison node: the parser gives up on
    // reading further, not on producing something well formed, so a
    // consumer never has to ask whether the tree it was handed exists.
    println(
        "depth {} lex {} parse {} node {}",
        depth,
        lexed.diags.len,
        p.diags.len,
        node_name(p.tree, id)
    );
    p.diags.get(0).match({
        Ok(d) => println(
            "  at {}:{} {}",
            d.span.start.line,
            d.span.start.col,
            d.message
        ),
        None  => println("  no diagnostic"),
    });
    Ok(());
}

main = (env: Env) Res<i32, WriteError> {
    alloc ::= env.mem.alloc();
    println("limit {}", MAX_DEPTH);

    // just inside the limit: an ordinary expression, nothing to say
    run(env, alloc, 300).try();

    // past it, and far past it. Both must produce exactly one
    // diagnostic, anchored at column 1 — the outermost `(` of the run
    run(env, alloc, 400).try();
    run(env, alloc, 10000).try();
    Ok(0);
}
