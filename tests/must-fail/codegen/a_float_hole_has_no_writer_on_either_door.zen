// `text_fmt.zen` declares a writer for a bool and for both integer
// domains and none for a float, so a float hole is refused -- and since
// #755 it is refused THE SAME WAY through both doors, at both positions,
// with the same words. That is the property worth pinning: the doors
// agree about what they cannot write, not only about what they can.
//
// It is also the reason the appending door reports the SINK door's fault
// here and not its own. "a format hole on this door that is not a str"
// belongs to a receiver that is not a Sink; a String is one, so what a
// float runs out of is a writer.

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    f     ::= 1.5;

    buf ::= alloc.String().try();
    buf.fmt("f={}\n", f).try();

    fresh ::= alloc.String("f={}\n", f).try();
    println("{}", fresh.view());

    Ok(0);
}
