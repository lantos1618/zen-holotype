// src/lsp/lsp_hover.zen
// The one query, and the reason this stage was worth starting.
//
// A hover is a position, the thing under it, and what the checker
// already concluded about that thing:
//
//     position -> to_pos -> told_at -> a memo -> Types.name_of
//
// (`tests/corpus/sema_zen/a_cursor_position_finds_its_node` is the same
// round trip WITHOUT a server). Nothing here is a query; everything is a
// call into `src/std/ast/` and `src/sema/` — `DESIGN.md:45`'s "a thin server
// over compiler internals" meant literally. Memos are READ and not
// recomputed (`DESIGN.md` decision 3): `check_all` has already typed
// every node, so this file never calls `type_of`.
//
// FOUR ANSWERS, AND NOT ONE. An earlier version read `expr_memo` alone;
// probing every identifier in `add = (a: i32, b: i32) i32 { s = a + b; s }`
// only three of twelve positions answered (`a`, `b`, `s` where USED),
// missing the function's own name, every parameter/local at its
// declaration, and every `i32`. The finder that made the other three
// reachable lived here as `lsp_decl.zen` and is now `ast_named.zen`
// (moved on its second caller); this file says each as:
//
//   Sig      a function's name  -> its declaration, reprinted from the
//                                  AST's names and the checker's types
//   OfType   a written type     -> what `type_from_ast` resolved it to,
//                                  and for a primitive what the prelude
//                                  declares about it (doc line, members)
//   OfValue  an expression      -> what `type_of` gave it
//   Nothing  everything else    -> `null`, and see below
//
// A WRONG ANSWER IS WORSE THAN NO ANSWER — the rule every arm is written
// against. A miss anywhere in a compound answer (one parameter
// unresolved, no return type) discards the whole answer rather than
// shipping a partial one — costs listed at the bottom.
//
// TWO WAYS IN, AND THE WORKSPACE DECIDES. `hover_in` checks the document
// as part of a BUILD; `hover_at` checks it AS ONE MODULE standing alone,
// for when there is no root to build (no `rootUri`, or the two-file form
// of `zen lsp`) — there an import resolves to nothing and hover answers
// `null` rather than guessing.
//
// THREE WAYS IN NOW: `hover_with` asks the question of a build ALREADY
// MADE — the shared slot's checker (`lsp_built.zen`), which the settle
// and every query against one document state hold in common, so a hover
// after a settle builds nothing. `hover_in` and `hover_at` still rebuild
// per request — the slot's `None` fallback and the no-workspace case —
// and their pages die with the request's own arena.

str, String = std.text
Vec, Map = std.collections
Range = std.core
Alloc, AllocError = std.mem
scan, Source = std.lex
Parser = std.parse
Ast, Decl, ExprId, Member, TypeId, Span, Function, TriviaRun = std.ast
Checker = sema.sema_check
check_all = sema.sema_decl
// THE DRIVER, REACHED FROM THE SERVER (`design_lsp.md` §5): the
// alternative is a private copy of `walk` in this folder.
Build = zen.zen_build
root_for, relative_to = zen.zen_path
// `Types` IS IMPORTED FOR ITS METHODS: without this line the
// bootstrapper resolves `c.types.write_name` against `sema_diag` instead
// and reports it as not exported there.
Types, TyId, Ty, Prim = sema.sema_ty
Def, decl_at = sema.sema_def
to_pos, to_wire, WirePos = lsp.lsp_pos
Tell, told_at = lsp.lsp_decl

// What a hover found. `found` is false both for a position covered by
// nothing and for one whose type the checker never wrote down. `shown`
// is TEXT AND NOT A TYPE NAME: a function's name answers with its
// signature.
Hover* = {
    found*: bool,
    shown*: str,
    start*: WirePos,
    end*: WirePos,
}

// --- the two harnesses every way in shares ------------------------------

// THE STANDALONE PARSE: the buffer scanned and parsed as one module,
// never added to an arena unless the caller goes on to check it
// (`symbols_at` does not — an outline is an AST fact). Every caller
// names the module "doc"; `name` is what the spans carry as their file.
parse_standalone* = (a: Alloc, name: str, text: str) Res<Parser, AllocError> {
    tree ::= a.Ast();
    lexed = scan(a, Source(file: name, text: text)).try();
    Ok(a.Parser(lexed, tree));
}

// THE STANDALONE CHECK: the parse above, added to the arena and checked
// whole — what every no-workspace query (`complete_at`, `definition_at`
// and `hover_at` below) opens with.
check_standalone* = (a: Alloc, name: str, text: str) Res<Checker, AllocError> {
    p ::= parse_standalone(a, name, text).try();
    m = p.module("doc").try();
    p.tree.add_module(m).try();
    c ::= a.Checker(p.tree).try();
    check_all(c).try();
    Ok(c);
}

// What `check_build` hands back: the root it computed (a cross-file
// span converts against it), the document's name relative to it, and
// the checker the walk filled.
CheckedBuild* = {
    root*: str,
    rel*: str,
    c*: Checker,
}

// THE BUILD-BACKED HARNESS the `*_in` queries share: the compilation
// root COMPUTED and not the workspace (`root_for` accounts for an
// editor opening at the repository while this tree builds as
// `zen build src`), the open document as the entry — a file being
// edited is usually not reachable from `main` — and the buffer in the
// overlay, so the answer is about the text the editor shows.
check_build* = (env: Env, a: Alloc, workspace: str, path: str, text: str)
               Res<CheckedBuild, AllocError> {
    root = root_for(env, a, workspace, path);
    rel  = relative_to(root, path);
    docs ::= a.Map<str, str>();
    docs.set(path, text).try();
    b ::= a.Build(env, root);
    c = b.whole(rel, docs).try();
    Ok(CheckedBuild(root: root, rel: rel, c: c));
}

// The type under a wire position in `text`, and the span to underline.
// `name` is the CLIENT'S URI, verbatim, never a filesystem path: handed
// to both `Source` and `told_at`, so no `file://` conversion is needed.
hover_at* = (a: Alloc, name: str, text: str, line: usize, character: usize)
            Res<Hover, AllocError> {
    c ::= check_standalone(a, name, text).try();

    // THE CONVERSION HAPPENS EXACTLY HERE AND NOWHERE ELSE ON THE WAY
    // IN. Below this line every position is a Zen position.
    pos = to_pos(text, line, character);
    said(c, a, text, told_at(c.tree, name, pos))
}

// THE SAME QUESTION, ASKED OF A BUILD — the only way an IMPORTED name
// has ever had a type. `hover_at` checks the document alone, so `Vec`,
// `str` and any real import resolve to nothing and sema interns poison;
// `write_ty_id` correctly answers `null`.
//
// THE OPEN DOCUMENT IS THE ENTRY, not `main`: a file being edited is
// usually not reachable from the program's entry, so walking from the
// document reaches what it IMPORTS instead (`folder_root` pulls the
// sibling modules that complete a UFCS pool).
//
// THE COMPILATION ROOT IS COMPUTED AND NOT THE WORKSPACE: `root_for`
// accounts for an editor opening at the repository while this tree
// builds as `zen build src`.
//
// `rel` AND NOT THE URI IS WHAT SPANS CARRY: a build names a module by
// its path relative to the root, so `told_at` gets the same string
// `Source` was given.
hover_in* = (
    env       : Env,
    a         : Alloc,
    workspace : str,
    path      : str,
    text      : str,
    line      : usize,
    character : usize
) Res<Hover, AllocError> {
    root = root_for(env, a, workspace, path);
    docs ::= a.Map<str, str>();
    docs.set(path, text).try();
    b ::= a.Build(env, root);
    c   = b.whole(relative_to(root, path), docs).try();
    pos = to_pos(text, line, character);
    said(c, a, text, told_at(c.tree, relative_to(root, path), pos))
}

// THE SAME QUESTION, ASKED OF A BUILD ALREADY MADE — the shared slot's
// checker (`lsp_built.zen`), the way `definition_with` asks it. The work
// is exactly `hover_in`'s second half; the build above it is what the
// slot replaces. `a` is the REQUEST's arena: the answer is written into
// the reply and dies with the request, while the tree and the memos it
// reads live in the slot and are only READ.
hover_with* = (
    c         :: Checker,
    a         : Alloc,
    rel       : str,
    text      : str,
    line      : usize,
    character : usize
) Res<Hover, AllocError> {
    pos = to_pos(text, line, character);
    said(c, a, text, told_at(c.tree, rel, pos))
}

// A position in nothing is not a failure — hovering a comment or
// whitespace gets exactly this, turned into `null` by the server.
no_type* = () Hover {
    Hover(
        found: false,
        shown: "",
        start: WirePos(line: 0, character: 0),
        end: WirePos(line: 0, character: 0)
    )
}

// The `Tell`, said — one `String`, thrown away unread if the arm could
// not finish it.
said = (c :: Checker, a: Alloc, text: str, t: Tell) Res<Hover, AllocError> {
    out ::= a.String().try();
    t.match({
        Nothing    => nothing_found(),
        Sig(f)     => wired(
            text,
            f.name.span,
            write_decl_sig(c, f, out).try(),
            out
        ),
        OfType(ta) => wired(
            text,
            ta.span,
            write_written_ty(c, ta.id, out).try(),
            out
        ),
        OfValue(v) => wired(text, v.span, write_val(c, v.id, out).try(), out),
    })
}

nothing_found = () Res<Hover, AllocError> { Ok(no_type()) }

// The span converted back out — the ONLY place a hover learns its wire
// coordinates, `lsp_pos.zen`'s rule obeyed from the outside.
wired = (text: str, span: Span, known: bool, out :: String)
        Res<Hover, AllocError> {
    Ok(Hover(
        found: known,
        shown: out.view(),
        start: to_wire(text, span.start),
        end: to_wire(text, span.end)
    ));
}

// --- the three answers -------------------------------------------------

// A WRITTEN TYPE, resolved, and said in full. `type_from_ast`'s memo
// is keyed on exactly this `TypeId`, so `i32` costs a `Map` lookup.
// What a PRIMITIVE answers is more than its name: "a prelude
// declaration of a primitive's name IS that primitive" (DESIGN.md:438),
// and that declaration is the one place the language has anything to
// SAY about `i32` — so the answer is the name, the declaration's first
// doc line, and its exported members (`i32 — members: MIN, MAX, BITS`).
// A primitive the prelude does not declare (and every type in
// `hover_at`, where there is no prelude at all) still answers the bare
// name, which is the RESOLVED type (`Alias = Shape` hovers as `Shape`)
// and confirms the name is a type the checker knows — a name that
// resolves to nothing answers `null`. Signatures keep the bare name:
// they go through `write_ty` below, and a reprinted parameter list is
// no place for a doc comment.
write_written_ty = (
    c   :: Checker,
    id  : TypeId,
    out :: String
) Res<bool, AllocError> {
    c.type_memo.get(id).match({
        None     => no_answer(),
        Ok(memo) => write_ty_named(c, memo, out),
    })
}

write_ty = (c :: Checker, id: TypeId, out :: String) Res<bool, AllocError> {
    c.type_memo.get(id).match({
        None     => no_answer(),
        Ok(memo) => write_ty_id(c, memo, out),
    })
}

// The OfType answer for a resolved type: the prim's prelude note when
// there is one, the plain name otherwise.
write_ty_named = (c :: Checker, id: TyId, out :: String) Res<bool, AllocError> {
    poison_free(c, id).match({
        false => no_answer(),
        true  => c.types.at(id).match({
            Prim(p) => write_prim(c, id, p, out),
            _       => { c.types.write_name(id, out).try(); an_answer() },
        }),
    })
}

// The name first — it is the answer even when the prelude has nothing
// to add — then the declaration's note. A miss is not a lookup failure
// worth hiding the name over: `bool` answered exactly "bool" for
// years, and lone-module hover still does.
write_prim = (c :: Checker, id: TyId, p: Prim, out :: String)
             Res<bool, AllocError> {
    c.types.write_name(id, out).try();
    defs ::= c.alloc.Vec<Def>();
    c.world.prelude_of(p.name, defs).try();
    defs.get(0).match({
        None  => an_answer(),
        Ok(d) => {
            write_prelude_note(c, d, out).try();
            an_answer()
        },
    })
}

// ` — `, the declaration's first doc line when it has one, and its
// exported members — the starred ones, the surface a reader of the
// hovered module can actually reach (`str`'s `data` is deliberately
// absent). An unstarred member is the module's own business.
write_prelude_note = (c :: Checker, d: Def, out :: String) Res<(), AllocError> {
    decl_at(c.tree, d.id).match({
        None   => Ok(()),
        Ok(dd) => {
            doc = first_doc_line(c.tree, dd.leading);
            (doc.len > 0).then(() {
                out.add_bytes(" — ").try();
                out.add_bytes(doc).try();
            });
            write_members(c, dd, doc.len > 0, out)
        },
    })
}

write_members = (c :: Checker, dd: Decl, after_doc: bool, out :: String)
                Res<(), AllocError> {
    names ::= c.alloc.Vec<str>();
    dd.kind.match({
        Struct(s) => collect_names(s.members, names),
        _         => Ok(()),
    }).try();
    (names.len > 0).then(() {
        after_doc.match({
            true  => out.add_bytes("; members: "),
            false => out.add_bytes(" — members: "),
        }).try();
        names.loop((h, i, name) {
            (i > 0).then(() { out.add_bytes(", ").try() });
            out.add_bytes(name).try();
        });
    });
    Ok(());
}

collect_names = (ms: Vec<Member>, names :: Vec<str>) Res<(), AllocError> {
    ms.loop((h, m) { member_name(m, names).try(); });
    Ok(());
}

member_name = (m: Member, names :: Vec<str>) Res<(), AllocError> {
    m.kind.match({
        Field(f)    => keep_exported(f.exported, f.name.text, names),
        Const(k)    => keep_exported(k.exported, k.name.text, names),
        Function(f) => keep_exported(f.exported, f.name.text, names),
    })
}

keep_exported = (exported: bool, name: str, names :: Vec<str>)
                Res<(), AllocError> {
    exported.match({
        true  => names.add(name),
        false => Ok(()),
    })
}

// The declaration's first line of prose: the leading run's first line
// comment with its marker and margin stripped. A bare `//` spacer says
// nothing, so the scan moves past it rather than settling for empty.
first_doc_line = (tree: Ast, run: TriviaRun) str {
    doc ::= "";
    Range(0, run.len).loop((h, i) {
        (doc.len == 0).then(() {
            piece = tree.trivia_at(run, i);
            piece.kind.match({
                LineComment => { doc = comment_text(piece.text); },
                _           => (),
            });
        });
    });
    doc;
}

comment_text = (text: str) str {
    from ::= 0;
    loop(
        () { from < text.len && text.index(from) == '/' },
        (h) { from = from + 1; }
    );
    loop(
        () { from < text.len && text.index(from) == ' ' },
        (h) { from = from + 1; }
    );
    text.slice(from, text.len);
}

// AN EXPRESSION, from the memo the checker filled while typing the body.
// A MISS IS ANSWERED AS "NOTHING", not a made-up type: `design_lsp.md`'s
// open question 6 leaves unverified whether `expr_memo` covers every
// expression after `check_all`.
write_val = (c :: Checker, e: ExprId, out :: String) Res<bool, AllocError> {
    c.expr_memo.get(e).match({
        None     => no_answer(),
        Ok(memo) => write_ty_id(c, memo, out),
    })
}

// THE ONE PLACE A `TyId` BECOMES TEXT, and the one place poison is
// stopped. `Ty.Unknown` is what sema interns for "a type I could not
// compute and have already reported"; `Types.write_name` spells it
// `<unknown>`, which would show a user a hover naming a type that does
// not exist — so an unsettled type answers `null` instead. Was the
// common case before `hover_in`: every imported name resolved to
// poison, measured at 4/12 answers on a file that imports something vs
// 10/12 on one that does not, and still applies with no workspace.
write_ty_id = (c :: Checker, id: TyId, out :: String) Res<bool, AllocError> {
    poison_free(c, id).match({
        false => no_answer(),
        true  => { c.types.write_name(id, out).try(); an_answer() },
    })
}

// Does this type, anywhere inside it, contain poison? STRUCTURAL AND NOT
// TEXTUAL: checking the rendered name for `<unknown>` would put a second
// spelling of sema's marker here. `Ty` is a closed nine-variant enum, so
// the walk is total. `Infer` is NOT poison: `_` in `Res<Cfg, _>` is a
// hole law 6 permits, honest to show a user who wrote one.
poison_free = (c :: Checker, id: TyId) bool {
    c.types.at(id).match({
        Unknown   => false,
        Res(r)    => poison_free(c, r.value) && poison_free(c, r.error),
        Named(n)  => all_poison_free(c, n.args),
        Fn(f)     => poison_free(c, f.ret) && all_poison_free(c, f.params),
        Union(u)  => all_poison_free(c, u.members),
        Array(ar) => poison_free(c, ar.elem),
        _         => true,
    })
}

all_poison_free = (c :: Checker, ids: Vec<TyId>) bool {
    every ::= true;
    ids.loop((h, id) { every = every && poison_free(c, id); });
    every;
}

// A FUNCTION'S NAME ANSWERS WITH ITS DECLARATION, reprinted:
// `add = (a: i32, b: i32) i32`, not `(i32, i32) i32` (what
// `Types.write_name` would produce from the function's TYPE) — two
// signatures differing only in parameter names are one type, so the
// names come from the AST and are assembled here (`ast_node.zen`:
// "`(i32, i32) i32` says nothing about which `i32` is which").
//
// NOTHING IN IT IS INVENTED, except bounds on type parameters, dropped:
// `<T: Eq + Hash>` prints as `<T>` (printing a bound's own type members
// would double the length of the common case) — said here so a reader
// does not assume `T` is unbounded.
write_decl_sig = (
    c   :: Checker,
    f   : Function,
    out :: String
) Res<bool, AllocError> {
    out.add_bytes(f.name.text).try();
    out.add_bytes(" = ").try();
    write_tparams(f, out).try();
    out.add_bytes("(").try();
    whole ::= true;
    f.params.loop((h, i, prm) {
        (i > 0).then(() { out.add_bytes(", ").try() });
        out.add_bytes(prm.name.text).try();
        out.add_bytes(binder(prm.mutable)).try();
        whole = write_opt_ty(c, prm.type, out).try() && whole;
    });
    out.add_bytes(") ").try();
    Ok(write_opt_ty(c, f.ret, out).try() && whole);
}

write_tparams = (f: Function, out :: String) Res<(), AllocError> {
    (f.tparams.len == 0).match({
        true  => Ok(()),
        false => write_tparam_list(f, out),
    })
}

write_tparam_list = (f: Function, out :: String) Res<(), AllocError> {
    out.add_bytes("<").try();
    f.tparams.loop((h, i, tparam) {
        (i > 0).then(() { out.add_bytes(", ").try() });
        out.add_bytes(tparam.name.text).try();
    });
    out.add_bytes(">")
}

// `self :: @Self` and `a: i32` differ in whether the parameter may be
// mutated, so a reprinted signature keeps it.
binder = (mutable: bool) str {
    mutable.match({ true => " :: ", false => ": " })
}

// A TYPE THAT WAS NOT WRITTEN IS NOT GUESSED. `Param.type` is absent in
// a closure and `Function.ret` in a lambda; the whole signature is
// discarded rather than printing `()` and being silently wrong.
write_opt_ty = (c :: Checker, t: Res<TypeId>, out :: String)
               Res<bool, AllocError> {
    t.match({
        None   => no_answer(),
        Ok(id) => write_ty(c, id, out),
    })
}

// The two answers to "did that resolve", as functions so sibling match
// arms share one type.
an_answer = () Res<bool, AllocError> { Ok(true) }

no_answer = () Res<bool, AllocError> { Ok(false) }

// --- what is still `null`, on purpose ----------------------------------
//
// Listed so nobody rediscovers them — every one is a position a user
// WILL hover:
//
//   - A STRUCT'S OR ENUM'S OWN NAME (`Foo` in `Foo = { .. }`): a
//     declaration site has no `TypeId`; a USE hovers, the declaration
//     does not. Fix needs `sema_type.zen`'s `type_from_ast`.
//   - A PATTERN BINDER (`n` in `Ok(n) => ..`): no pattern memo,
//     `Binding` released at scope exit. `design_lsp.md` §2 prices the
//     fix at L3.
//   - A TYPE PARAMETER AT ITS DECLARATION (`T` in `<T>`): same shape as
//     a struct name; `T` used as a type hovers.
//   - AN IMPORTED NAME, WHEN THERE IS NO WORKSPACE: `hover_in` answers
//     it; without one `Vec` in `Vec = std.collections` has no type, and
//     the import DECLARATION is `Nothing` either way.
//   - A CLOSURE'S PARAMETER: `Param.type` is absent by construction.
