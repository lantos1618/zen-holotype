    ), DiagCase(
        src: "f = (n: i32) i32 {\n    x := (n > 3).match ({ true => 1 })\n    x\n}\nmain = () i32 { 0 }\n",
        wants: [":2:13: error[exhaustiveness]: match does not cover every variant", "      x := (n > 3).match ({ true => 1 })", "              ^", "hint: add arms for every variant, or add an explicit `_` arm"],
    ), DiagCase(
        src: "main = () i32 {\n    x := = 5\n    0\n}\n",
        wants: [":2:10: error[parse]: syntax error: unparseable top-level input", "      x := = 5", "           ^", "hint: check the syntax around this top-level declaration"],
    ), DiagCase(
        src: "main = () i32 { undefined_fn(1, 2) }\n",
        wants: [":1:17: error[undefined-name]: undefined name", "  main = () i32 { undefined_fn(1, 2) }", "                  ^~~~~~~~~~~~", "hint: declare the name, import it, or qualify the intended module binding"],
    ), DiagCase(
        src: "{ println } = std.text.fmt\nmain = () i32 {\n    println(\"hi\")\n    oops()\n}\n",
        wants: [":4:5: error[undefined-name]: undefined name", "      oops()", "      ^~~~", "hint: declare the name, import it, or qualify the intended module binding"],
    ), DiagCase(
        src: "wrap = (x: T) i32 { oops(x) }\nmain = () i32 { wrap(41) }\n",
        wants: [":1:21: error[undefined-name]: undefined name", "  wrap = (x: T) i32 { oops(x) }", "                      ^~~~"],
    ), DiagCase(
        src: "apply = (f: (i32) i32, x: i32) i32 { f(x) }\nmain = () i32 {\n    apply((n) { bad(n) }, 41)\n}\n",
        wants: [":3:17: error[undefined-name]: undefined name", "      apply((n) { bad(n) }, 41)", "                  ^~~"],
    ), DiagCase(
        src: "apply = (f: (i32) i32, x: i32) i32 { f(x) }\nmain = () i32 {\n    r := apply((n) { n + 1 }, 41)\n    nope(r)\n}\n",
        wants: [":4:5: error[undefined-name]: undefined name", "      nope(r)", "      ^~~~", "hint: declare the name, import it, or qualify the intended module binding"],
    ), DiagCase(
