// probeAM: Arena param, generic realloc<T>, .try() before use
mk = (ar: Arena) i64 {
    p0 = ar.raw(8, 16).try();
    p = ar.realloc<i64>(p0.to<i64>(), 1).try();
    p.write(0, 42);
    p.read(0)
}

main = (env: Env) Res<i32, AllocError> {
    a ::= env.mem.alloc();
    println("v {}", mk(a));
    Ok(0);
}
