// Canonical driver-side representation of one build C-import request.
// It is formed after build.zen runs and before the synthetic module enters
// sema. Header dependency bytes and translator version join this identity
// when the cache is implemented.

Alloc, AllocError = std.mem
str, String = std.text
Vec = std.collections
Os, Arch, Abi, CImport = std.build
Ast, Module, CHeader, CTypeBinding, CBinding, CBindingId = std.ast

CImportRequest* = {
    spec*: CImport,
    identity*: String,

    attach_module* = (
        self : @Self,
        a    : Alloc,
        node : Module,
        tree :: Ast,
    ) Res<CImportModule, AllocError> {
        headers ::= a.Vec<CHeader>();
        self.spec.headers.loop((h, path) {
            headers.add(CHeader(path: path, system: true)).try();
        });
        types   = a.Vec<CTypeBinding>();
        module  = tree.module_count();
        binding = tree.add_c_module(
            node,
            CBinding(headers: headers, types: types)
        ).try();
        Ok(CImportModule(module: module, binding: binding))
    }
}

// The two stable coordinates the loader needs after inserting a synthetic
// binding module. World already identifies modules by their Ast index.
CImportModule* = {
    module*: usize,
    binding*: CBindingId,
}

request* = (a: Alloc, spec: CImport) Res<CImportRequest, AllocError> {
    out ::= a.String("c-import-v1|").try();
    target(out, spec.target.os, spec.target.arch, spec.target.abi).try();
    add_list(out, "headers", spec.headers).try();
    add_list(out, "include-paths", spec.include_paths).try();
    add_list(out, "defines", spec.defines).try();
    add_list(out, "libraries", spec.libraries).try();
    Ok(CImportRequest(spec: spec, identity: out))
}

target = (out :: String, os: Os, arch: Arch, abi: Abi)
         Res<(), AllocError> {
    out.fmt("target-v1|{}|{}|{}|", os_name(os), arch_name(arch), abi_name(abi))
}

os_name = (os: Os) str {
    os.match({ Macos => "macos", Linux => "linux", Windows => "windows" })
}

arch_name = (arch: Arch) str {
    arch.match({ X86_64 => "x86_64", Arm64 => "arm64" })
}

abi_name = (abi: Abi) str {
    abi.match({ Gnu => "gnu", Musl => "musl", Msvc => "msvc", Darwin => "darwin" })
}

add_piece = (out :: String, value: str) Res<(), AllocError> {
    out.fmt("{}:{}|", value.len, value)
}

add_list = (out :: String, name: str, values: Vec<str>)
           Res<(), AllocError> {
    out.fmt("{}:{}|", name, values.len).try();
    values.loop((h, value) { add_piece(out, value).try() });
    Ok(())
}
