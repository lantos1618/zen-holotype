// tests/corpus/std/display_tostring_writes_into_buffer.zen
// toString writes into an EXISTING sink rather than returning a
// String, so two values land in one buffer and neither of them
// allocated to do it

Error = AllocError | IoError

Point = {
    x: i32,
    y: i32,
}

Point.impl(Display, {
    toString ::= (self: @Self, out :: Sink) Res<(), WriteError> {
        out.add("{}:{}", self.x, self.y)
    }
})

main = (env: Env) Res<i32, Error> {
    alloc ::= env.mem.alloc();
    sb ::= alloc.String("").try();

    Point(x: 1, y: 2).toString(sb).try();
    sb.add(" and ").try();
    Point(x: 3, y: 4).toString(sb).try();

    println("{}", sb.view());
    Ok(0);
}
