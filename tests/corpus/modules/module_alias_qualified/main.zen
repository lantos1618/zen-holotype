// Aliasing a module to a short name and qualifying through it is a real
// pattern, not a mistake -- `tests/corpus/codegen/mangle_module_collision`
// leans on it, and grammar R1a chose the alias reading of a bare RHS
// deliberately.
//
// This pins it in the modules suite, where the `*` gate lives, because the
// obvious way to close the leak next door (`sh = shape` then a BARE
// `reseat(3)`) is to make aliasing a module an error -- and that would
// take this program with it. A module alias is fine; a module used
// UNQUALIFIED is not.

sh = shape

main = (env: Env) Res<i32, ArgError> {
    println("{}", sh.reseat(3));

    b ::= sh.Bag(len: 1);
    b.add(4);
    println("{}", b.len);

    c = sh.Bag(len: 7);
    println("{}", c.len);
    Ok(0);
}
