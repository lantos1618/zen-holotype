// SHIFT BY width-1 ON A SIGNED OPERAND LANDS ON iN.MIN, AND STAYS SIGNED.
//
// `-3 *% -128` on an i8 is the signed twin of the unsigned top-bit test:
// the single surviving bit is the SIGN bit, so the answer is -128, not
// +128. This is the line that punishes a backend which computes shifts in
// an unsigned slot and stores back: every row below prints its MIN, and
// the unsigned reading of the same bytes prints the positive twin — so
// one wrong cast flips all four numbers while still printing plausible
// small powers of two.
//
// the constants are written as `iN.MIN`, not as digits: the literal path
// for -2147483648 is already pinned by codegen/negated_literal_i64_
// boundary.zen, and this test must fail on a SHIFT bug rather than ride
// along with a lexer one.
//
// the last row is the u64-width control on a NEGATIVE base — the width
// where C's own promotion rules change behaviour — so a fix that repairs
// 8/16/32 by widening to 64 cannot be wrong there and green everywhere.
//
// one-line break: emit the store-back cast as `(uintN_t)` instead of
// `(intN_t)` (or compute in an unsigned temporary of the operand's
// width) and -128 becomes 128, -32768 becomes 32768, and so on down.

main = (env: Env) Res<i32, AllocError> {
    b8:  i8  = -3;
    b16: i16 = -3;
    b32: i32 = -3;
    b64: i64 = -3;

    println("i8 {}", b8 *% i8.MIN);
    println("i16 {}", b16 *% i16.MIN);
    println("i32 {}", b32 *% i32.MIN);
    println("i64 {}", b64 *% i64.MIN);

    Ok(0);
}
