// src/zen/zen_fmt.zen
// `zen fmt`: read, format, compare or write.
//
// EVERYTHING THAT TOUCHES A FILE IS HERE and nothing that decides what
// formatted means is — `src/fmt/` takes a `Lexed` and hands back bytes,
// so it needs no capability and a corpus test can drive it with a
// string it made up. That is the same split `zen_cli.zen` and
// `zen_build.zen` make, and it is why `tests/corpus/fmt/` can exist.
//
// A DIRECTORY IS NOT A PATH THIS COMMAND TAKES. `std.env.Fs` has
// `read`, `exists` and `is_dir` and no listing, on purpose — and unlike
// a build, a format cannot compute its own file set: a build follows
// imports from an entry, and a file nobody imports still has to be
// formatted. So the file set is the caller's, `make fmt` supplies it
// with `find`, and a directory handed here is NAMED rather than
// silently skipped.
//
// THE PHASES ARE METHODS ON A STRUCT and not free functions, which is
// `zen_build.zen`'s shape and is load-bearing rather than cosmetic:
// `x.f(..)` resolves across the whole program, so a free `report`, a
// free `open` or a free `named` is one name with the methods of those
// names on `Checker`, `Parser` and `Types`. The bootstrapper says so
// outright — "named is not exported by module zen_fmt", reported at two
// files this lane never touched. A method on `Fmt` collides with
// nothing, and the tally it carries is the exit code anyway.

Alloc, AllocError = std.mem
str, String = std.text
FsError = std.env

scan, Source, Lexed, message = lex.lex
Render, render = fmt.fmt

FmtJob = zen.zen_cli
fs_message = zen.zen_build

// What happened to one file.
//
// `Failed` and `Differs` are counted apart because they are different
// answers: a file this compiler could not read is a fault whichever
// mode it is in, and a file that is merely unformatted is a fault only
// under `--check`. Collapsing them would make `zen fmt` with no flag
// report every file it had just fixed.
Outcome = Same | Wrote | Differs | Failed

// One run, and the tally the exit code is.
Fmt = {
    env: Env,
    alloc: Alloc,

    // `--check`: report, change nothing. Without it the files are
    // rewritten in place.
    check: bool,

    // A file that would not open, would not lex, or would not parse —
    // and the one case that is this folder's own bug, `unfaithful`.
    faults :: usize = 0,

    // A file `--check` found unformatted. Not a fault in the file's
    // author's sense, and still a red build: that IS the gate.
    unformatted :: usize = 0,

    one = (self :: @Self, path: str) Res<(), AllocError> {
        self.route(path).try().match({
            Failed  => { self.faults = self.faults + 1; },
            Differs => { self.unformatted = self.unformatted + 1; },
            _       => (),
        });
        Ok(());
    }

    route = (self :: @Self, path: str) Res<Outcome, AllocError> {
        self.env.fs.is_dir(path).match({
            true  => self.folder(path),
            false => self.bytes_of(path),
        })
    }

    folder = (self :: @Self, path: str) Res<Outcome, AllocError> {
        println("{}: is a directory — zen fmt takes files (see `make fmt`)", path);
        Ok(Outcome.Failed);
    }

    bytes_of = (self :: @Self, path: str) Res<Outcome, AllocError> {
        self.env.fs.read(self.alloc, path).match({
            Err(e)   => self.unreadable(path, e),
            Ok(text) => self.scan_it(path, text),
        })
    }

    unreadable = (self :: @Self, path: str, e: FsError) Res<Outcome, AllocError> {
        println("{}: {}", path, fs_message(e));
        Ok(Outcome.Failed);
    }

    // A FILE WITH LEXICAL FAULTS IS REPORTED AND NOT PARSED, which is
    // `lex.zen`'s contract and the reading `zen_build.zen` takes of it.
    // A formatter has a second reason to obey it: a tree built from
    // bytes the lexer could not read is a tree whose spans no longer
    // describe the file, and this stage prints from spans.
    scan_it = (self :: @Self, path: str, text: String) Res<Outcome, AllocError> {
        lexed = scan(self.alloc, Source(file: path, text: text.view())).try();
        lexed.is_clean().match({
            false => self.lex_diags(lexed),
            true  => self.print_it(path, text, lexed),
        })
    }

    lex_diags = (self :: @Self, lexed: Lexed) Res<Outcome, AllocError> {
        lexed.diags.loop((h, d) {
            println("{}:{}:{}: {}", d.file, d.span.start.line, d.span.start.col,
                    message(d.fault));
        });
        Ok(Outcome.Failed);
    }

    print_it = (self :: @Self, path: str, text: String, lexed: Lexed)
               Res<Outcome, AllocError> {
        out = render(self.alloc, lexed).try();
        (out.diags.len > 0).match({
            true  => self.syntax_diags(out),
            false => self.settled(path, text, out),
        })
    }

    syntax_diags = (self :: @Self, out: Render) Res<Outcome, AllocError> {
        out.diags.loop((h, d) {
            println("{}:{}:{}: {}", d.span.file, d.span.start.line,
                    d.span.start.col, d.message);
        });
        Ok(Outcome.Failed);
    }

    // THE GUARD IS NOT ADVISORY. `Render.faithful` false means the
    // printer changed the token stream, which is a bug in `src/fmt/`
    // and not a property of the file — so the file is left exactly as
    // it was found and the build goes red. A formatter that writes
    // anyway is an editor.
    settled = (self :: @Self, path: str, text: String, out: Render)
              Res<Outcome, AllocError> {
        out.faithful.match({
            false => self.unfaithful(path),
            true  => self.same_or_not(path, text, out),
        })
    }

    unfaithful = (self :: @Self, path: str) Res<Outcome, AllocError> {
        println("{}: zen fmt would have changed this file's tokens — left alone", path);
        println("  that is a bug in src/fmt/, not in the file");
        Ok(Outcome.Failed);
    }

    same_or_not = (self :: @Self, path: str, text: String, out: Render)
                  Res<Outcome, AllocError> {
        text.view().eq(out.text.view()).match({
            true  => Ok(Outcome.Same),
            false => self.change(path, out),
        })
    }

    change = (self :: @Self, path: str, out: Render) Res<Outcome, AllocError> {
        self.check.match({
            true  => self.name_it(path),
            false => self.write_it(path, out),
        })
    }

    // `--check` NAMES EVERY FILE. A gate that says "18 files differ"
    // and not which eighteen is a gate whose output has to be
    // reproduced by hand before it can be acted on.
    name_it = (self :: @Self, path: str) Res<Outcome, AllocError> {
        println("{}", path);
        Ok(Outcome.Differs);
    }

    write_it = (self :: @Self, path: str, out: Render) Res<Outcome, AllocError> {
        self.env.fs.write(path, out.text.view()).match({
            Ok(_)  => Ok(Outcome.Wrote),
            Err(e) => self.unreadable(path, e),
        })
    }

    // The summary, printed only when there is something to say. A
    // `--check` over a clean tree is the gate's green path, and a gate
    // that prints on green is a gate people learn to skip.
    //
    // THE EXIT CODE IS THE TALLY, as it is for a build.
    verdict = (self: @Self, files: usize) Res<i32, AllocError> {
        (self.unformatted > 0).then(() {
            println("zen fmt: {} of {} files are not formatted",
                    self.unformatted, files);
        });
        ((self.unformatted + self.faults) == 0).match({
            true  => Ok(0),
            false => Ok(1),
        })
    }
}

format* = (env: Env, alloc: Alloc, job: FmtJob) Res<i32, AllocError> {
    run ::= Fmt(env: env, alloc: alloc, check: job.check);
    paths = job.paths(alloc).try();
    paths.loop((h, path) { run.one(path).try() });
    run.verdict(paths.len)
}
