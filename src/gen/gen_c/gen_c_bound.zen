// Calls through a bound's fat record, the language's only dynamic
// dispatch. Slots erase pointer elements to bytes; arguments convert
// down and results rebuild upward (including `Res` variant-by-variant).
// Element size travels beside erased pointers; multiplication belongs
// only in the thunk built by `gen_c_fat`.

ExprId = std.ast
Function, Param, Access, Call, Arg, Impl, Member = std.ast
AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId, TyNamed, TyRes, is_failure = sema.sema_ty
Ctx = sema.sema_check
Inst, has_var = sema.sema_inst
self_ctx = sema.sema_member
param_type = sema.sema_denote
impl_bound_type = sema.sema_supply
sym_member, sym_variant = gen.gen_name
qualify = gen.gen_name
RES_PATH = gen.gen_name
CBackend = gen.gen_c.gen_c_state
unsupported = gen.gen_c.gen_c_report
sub_with, enter_tparams, leave_tparams = gen.gen_c.gen_c_mono
unify, arg_type = gen.gen_c.gen_c_mono
enter_struct_tparams = gen.gen_c.gen_c_mono
ctype, is_unit, request_type, is_ptr_named, declared_ret = gen.gen_c.gen_c_type
expr, ty_of, value_held, holds = gen.gen_c.gen_c_expr
write_set_value = gen.gen_c.gen_c_widen
init_temp = gen.gen_c.gen_c_flow
Site, site_of = gen.gen_c.gen_c_member
Slot, slots_of = gen.gen_c.gen_c_fat
has_body = gen.gen_c.gen_c_impl

// rebuilding a value at another type
// Erasure is what lets one slot serve every instantiation; this is the
// way back, under the header's rule that a conversion rebuilds.

convert* = (be :: CBackend, code: str, src: TyId, dst: TyId, out :: String)
           Res<(), AllocError> {
    src.eq(dst).match({
        true  => out.add(code),
        false => be.convert_kind(code, src, dst, out),
    })
}

convert_kind = (
    be   :: CBackend,
    code : str,
    src  : TyId,
    dst  : TyId,
    out  :: String
) Res<(), AllocError> {
    be.types().at(dst).match({
        Named(n) => be.convert_named(code, dst, n, out),
        Res(r)   => be.convert_res(code, src, dst, r, out),
        Union(_) => be.convert_set(code, src, dst, out),
        _        => out.add(code),
    })
}

// A value entering an error set is rebuilt with the destination tag.
// `rebuild_res` walks
// into the error payload with `convert` again, so `Res<(), AllocError>`
// rebuilt at `Res<(), AllocError | Fault>` lands here with the member on
// one side and the set on the other — two different C structs, so a bare
// copy is a program `cc` refuses. Built by the same
// `gen_c_widen.write_set_value` that builds the written form.
// A set reaching a wider set is left alone: its tags are numbered over
// its own members, so copying one across means a different member on
// the other side — a wrong error variant at runtime, from C that
// compiles. `gen_c_try.write_retag` maps it member by member as a
// switch statement, which a conversion in an expression buffer can't be.
convert_set = (
    be   :: CBackend,
    code : str,
    src  : TyId,
    dst  : TyId,
    out  :: String
) Res<(), AllocError> {
    be.tags_as_member(src, dst).match({
        false => out.add(code),
        true  => be.write_set_value(code, src, dst, out),
    })
}

tags_as_member = (be :: CBackend, src: TyId, dst: TyId) bool {
    be.types().at(src).match({
        Union(_) => false,
        _        => be.check.types.set_has(dst, src),
    })
}

convert_named = (
    be   :: CBackend,
    code : str,
    dst  : TyId,
    n    : TyNamed,
    out  :: String
) Res<(), AllocError> {
    is_ptr_named(n).match({
        true  => be.write_cast(code, dst, out),
        false => out.add(code),
    })
}

write_cast* = (be :: CBackend, code: str, dst: TyId, out :: String)
             Res<(), AllocError> {
    cty ::= be.alloc.String().try();
    be.ctype(dst, cty).try();
    out.fmt("(({}){code})", cty.view())
}

convert_res = (
    be   :: CBackend,
    code : str,
    src  : TyId,
    dst  : TyId,
    d    : TyRes,
    out  :: String
) Res<(), AllocError> {
    be.types().at(src).match({
        Res(s) => rebuild_res(be, code, src, s, dst, d, out),
        _      => out.add(code),
    })
}

// The value is read three times — its tag and each payload — so it
// lands in a temporary first.
rebuild_res = (
    be   :: CBackend,
    code : str,
    src  : TyId,
    s    : TyRes,
    dst  : TyId,
    d    : TyRes,
    out  :: String
) Res<(), AllocError> {
    be.request_type(dst).try();
    tmp ::= be.init_temp(src, "t", code).try();
    out.fmt("({}.zg_tag == ", tmp.view()).try();
    out.sym_variant(RES_PATH, "Ok").try();
    ok ::= be.alloc.String().try();
    be.res_arm(tmp.view(), "Ok", s.value, d.value, dst, ok).try();
    bad ::= be.alloc.String().try();
    be.fail_arm(tmp.view(), s, d, dst, bad).try();
    out.fmt(" ? {} : {})", ok.view(), bad.view())
}

fail_arm = (
    be  :: CBackend,
    tmp : str,
    s   : TyRes,
    d   : TyRes,
    dst : TyId,
    out :: String
) Res<(), AllocError> {
    is_failure(d.form).match({
        true  => be.res_arm(tmp, "Err", s.error, d.error, dst, out),
        false => be.bare_arm("None", dst, out),
    })
}

res_arm = (
    be  :: CBackend,
    tmp : str,
    v   : str,
    sp  : TyId,
    dp  : TyId,
    dst : TyId,
    out :: String
) Res<(), AllocError> {
    be.is_unit(dp).match({
        true  => be.bare_arm(v, dst, out),
        false => be.payload_arm(tmp, v, sp, dp, dst, out),
    })
}

bare_arm = (be :: CBackend, v: str, dst: TyId, out :: String)
           Res<(), AllocError> {
    be.arm_head(v, dst, out).try();
    out.add(" })").try();
    Ok(());
}

payload_arm = (
    be  :: CBackend,
    tmp : str,
    v   : str,
    sp  : TyId,
    dp  : TyId,
    dst : TyId,
    out :: String
) Res<(), AllocError> {
    be.arm_head(v, dst, out).try();
    mem ::= be.alloc.String().try();
    mem.sym_member(v).try();
    read ::= be.alloc.String().try();
    read.fmt("{tmp}.zg_data.").try();
    sym_member(read, v).try();
    val ::= be.alloc.String().try();
    be.convert(read.view(), sp, dp, val).try();
    out.fmt(", .zg_data.{} = {} })", mem.view(), val.view())
}

arm_head = (be :: CBackend, v: str, dst: TyId, out :: String)
           Res<(), AllocError> {
    cty ::= be.alloc.String().try();
    be.ctype(dst, cty).try();
    out.fmt("(({}){ .zg_tag = ", cty.view()).try();
    out.sym_variant(RES_PATH, v).try();
    Ok(());
}

// Calls through a bound record dispatch through the receiver's slot. A call
// is safe only when the member has a default or every implementation fills
// that slot; optional hooks may otherwise be NULL for one receiver.
lower_fat_call* = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    s   : Site,
    f   : Function,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    be.member_answered(f, rty, a.name.text).try().match({
        false => be.unsupported(
            id,
            "a bodiless member of a bound used as a value",
            out
        ),
        true  => {
            slots ::= be.alloc.Vec<Slot>();
            be.slots_of(rty, slots).try();
            pick_slot(slots, a.name.text, c.args.len).match({
                None     => be.unsupported(
                    id,
                    "a call through a bound with no such member",
                    out
                ),
                Ok(slot) => {
                    dispatch = BoundDispatch(
                        call: c,
                        receiver: rty,
                        site: s,
                        slot: slot,
                        ctx: ctx,
                    );
                    dispatch.lower(be, id, a, out)
                },
            })
        },
    })
}

// A default fills every record. A bodiless member is callable only when every
// implementation fills it; "some implementation" permits a NULL call for all
// the others.
member_answered = (be :: CBackend, f: Function, rty: TyId, name: str)
                  Res<bool, AllocError> {
    has_body(f).match({
        true  => Ok(true),
        false => be.bound_answered(rty, name),
    })
}

// Orphan impls are forbidden, so the world tables contain every possible slot
// provider. `seen` keeps a bound with no implementations from passing
// vacuously.
bound_answered = (be :: CBackend, rty: TyId, name: str)
                 Res<bool, AllocError> {
    seen    ::= false;
    missing ::= false;
    Range(0, be.check.world.count()).loop((h, mi) {
        be.check.world.table_at(mi).match({
            None    => (),
            Ok(tab) => tab.impls.loop((h, id) {
                be.check.world.impl_at(be.tree, id).match({
                    None     => (),
                    Ok(impl) => be.impl_bound_matches(impl, mi, rty).try()
                        .then(() {
                            seen = true;
                            (supplies_body(impl.members, name) == false)
                                .then(() { missing = true; h.break(); });
                        }),
                });
            }),
        });
        missing.then(() { h.break(); });
    });
    Ok(seen && !missing)
}

// Declaration identity distinguishes equally named bounds in different
// modules without requiring their generic arguments to have settled yet.
impl_bound_matches = (be :: CBackend, impl: Impl, mi: usize, rty: TyId)
                     Res<bool, AllocError> {
    bound = be.check.impl_bound_type(impl, mi).try();
    Ok(be.same_bound_decl(bound, rty))
}

same_bound_decl = (be: CBackend, a: TyId, b: TyId) bool {
    be.check.types.at(a).match({
        Named(x) => be.check.types.at(b).match({
            Named(y) => x.decl.eq(y.decl),
            _        => false,
        }),
        _        => false,
    })
}

supplies_body = (members: Vec<Member>, name: str) bool {
    Range(0, members.len).find((i) {
        members.get(i).match({
            None  => false,
            Ok(m) => m.kind.match({
                Function(f) => f.name.text.eq(name) && has_body(f),
                _           => false,
            }),
        })
    }).match({
        None  => false,
        Ok(_) => true,
    })
}

// Backend-generated calls through a bound record use this path. A
// capability's body is this backend, so there is no call node to lower
// and the record is still the only way to reach the impl — `Fs.read`
// allocating through its `Alloc`, `Sink.write` through its writer. The
// slot comes back too, since the caller needs a temporary at the type
// it answers with.
// Arguments arrive as text, each already comma-prefixed — only the
// caller knows what they are. A member with its own type parameters
// isn't reachable this way and doesn't need to be: `raw` is bytes and
// nothing more.
slot_call* = (
    be   :: CBackend,
    recv : str,
    tty  : TyId,
    name : str,
    args : str,
    argc : usize,
    out  :: String
) Res<Res<Slot>, AllocError> {
    slots ::= be.alloc.Vec<Slot>();
    be.slots_of(tty, slots).try();
    pick_slot(slots, name, argc).match({
        None     => Ok(None),
        Ok(slot) => be.write_named_slot(recv, slot, args, out),
    })
}

write_named_slot = (
    be   :: CBackend,
    recv : str,
    slot : Slot,
    args : str,
    out  :: String
) Res<Res<Slot>, AllocError> {
    be.request_type(slot.ret).try();
    out.fmt("{recv}.{}({recv}.zg_self{args})", slot.sym.view()).try();
    Ok(Ok(slot));
}

// Select by name and arity; a bound may declare overloads of one name.
// Resolution is on declared parameter types and
// arity", and a bound may declare two members of one name.
pick_slot = (slots: Vec<Slot>, name: str, args: usize) Res<Slot> {
    Range(0, slots.len).find((i) {
        slots.get(i).match({
            Ok(s) => s.name.eq(name) && (s.params.len == args),
            None  => false,
        })
    }).match({
        None  => None,
        Ok(i) => slots.get(i),
    })
}

// Facts fixed by slot selection and shared by type inference and emission.
BoundDispatch = {
    call: Call,
    receiver: TyId,
    site: Site,
    slot: Slot,
    ctx: Ctx,

    settle = (self: @Self, be :: CBackend) Res<BoundCall, AllocError> {
        owner ::= be.alloc.String().try();
        qualify(owner, self.site.qname, self.slot.name).try();
        sctx = be.check.self_ctx(
            self.site.decl.module.to_usize(),
            self.receiver
        ).try();
        mark = be.enter_struct_tparams(self.site.decl).try();
        be.enter_tparams(self.slot.f.tparams, owner.view()).try();
        declared ::= be.alloc.Vec<TyId>();
        be.declared_params(self.slot.f, sctx, declared).try();
        ret = be.declared_ret(self.slot.f, sctx).try();
        targs ::= be.alloc.Inst();
        infer_targs(be, self.call, declared, self.ctx, targs).try();
        be.leave_tparams(mark).try();
        Ok(BoundCall(
            dispatch: self,
            declared: declared,
            ret: ret,
            targs: targs,
        ));
    }

    lower = (self: @Self, be :: CBackend, id: ExprId, a: Access,
             out :: String) Res<(), AllocError> {
        call = self.settle(be).try();
        call.settled(be).match({
            false => be.unsupported(
                id,
                "a call through a bound whose type arguments nothing settles",
                out
            ),
            true  => call.emit(be, a, out),
        })
    }

    result_type = (self: @Self, be :: CBackend)
                  Res<Res<TyId>, AllocError> {
        call = self.settle(be).try();
        call.settled(be).match({
            false => Ok(None),
            true  => Ok(Ok(call.real_ret(be).try())),
        })
    }
}

// Settlement owns the declared parameter vector, inferred type arguments and
// declared return together until the call is emitted or its type is answered.
BoundCall = {
    dispatch: BoundDispatch,
    declared: Vec<TyId>,
    ret: TyId,
    targs: Inst,

    settled = (self: @Self, be: CBackend) bool {
        be.targs_settled(self.dispatch.slot, self.targs)
    }

    real_ret = (self: @Self, be :: CBackend) Res<TyId, AllocError> {
        be.sub_with(self.ret, self.targs)
    }

    // The receiver is evaluated once because the slot and `zg_self` both read
    // it. Arguments are converted from settled declarations to erased slots.
    emit = (self: @Self, be :: CBackend, a: Access, out :: String)
           Res<(), AllocError> {
        recv ::= be.alloc.String().try();
        expr(be, a.base, self.dispatch.ctx, self.dispatch.receiver, recv).try();
        r    ::= be.init_temp(self.dispatch.receiver, "t", recv.view()).try();
        call ::= be.alloc.String().try();
        call.fmt(
            "{}.{}({}.zg_self",
            r.view(),
            self.dispatch.slot.sym.view(),
            r.view()
        ).try();
        self.args(be, call).try();
        self.sizes(be, call).try();
        call.add(")").try();
        self.result(be, call.view(), out)
    }

    args = (self: @Self, be :: CBackend, out :: String)
           Res<(), AllocError> {
        self.dispatch.call.args.loop((h, i, arg) {
            hold = be.holds(self.dispatch.call, i + 1, 1);
            self.arg(be, arg, i, hold, out).try();
        });
        Ok(())
    }

    arg = (self: @Self, be :: CBackend, arg: Arg, i: usize, hold: bool,
           out :: String) Res<(), AllocError> {
        want = be.sub_with(
            self.declared.get(i).value_or(TyId(index: 0)),
            self.targs
        ).try();
        text ::= be.alloc.String().try();
        be.value_held(arg.value, self.dispatch.ctx, want, hold, text).try();
        out.add(", ").try();
        be.convert(
            text.view(),
            want,
            self.dispatch.slot.params.get(i).value_or(TyId(index: 0)),
            out
        ).try();
        Ok(())
    }

    sizes = (self: @Self, be :: CBackend, out :: String)
            Res<(), AllocError> {
        Range(0, self.targs.len()).loop((h, i) {
            self.size(be, i, out).try();
        });
        Ok(())
    }

    size = (self: @Self, be :: CBackend, i: usize, out :: String)
           Res<(), AllocError> {
        self.targs.arg_at(i).match({
            None  => out.add(", 1"),
            Ok(t) => be.write_sizeof(t, out),
        })
    }

    // Unit slots run for effect. Value slots rebuild the erased result at the
    // settled return type.
    result = (self: @Self, be :: CBackend, call: str, out :: String)
             Res<(), AllocError> {
        be.is_unit(self.dispatch.slot.ret).match({
            true  => be.fat_effect(call, out),
            false => self.value_back(be, call, out),
        })
    }

    value_back = (self: @Self, be :: CBackend, call: str, out :: String)
                 Res<(), AllocError> {
        real = self.real_ret(be).try();
        be.request_type(self.dispatch.slot.ret).try();
        be.request_type(real).try();
        tmp ::= be.init_temp(self.dispatch.slot.ret, "t", call).try();
        be.convert(tmp.view(), self.dispatch.slot.ret, real, out)
    }
}

// Bound members are not world declarations. Their type must come from the
// same settlement that rebuilds the erased result during emission.
fat_ret_type* = (be :: CBackend, c: Call, a: Access, ctx: Ctx)
                Res<Res<TyId>, AllocError> {
    unknown = be.check.types.unknown().try();
    rty     = be.ty_of(a.base, ctx, unknown).try();
    slots ::= be.alloc.Vec<Slot>();
    be.slots_of(rty, slots).try();
    pick_slot(slots, a.name.text, c.args.len).match({
        None     => Ok(None),
        Ok(slot) => site_of(be, rty).try().match({
            None       => Ok(None),
            Ok(member) => BoundDispatch(
                call: c,
                receiver: rty,
                site: member,
                slot: slot,
                ctx: ctx,
            ).result_type(be),
        }),
    })
}

declared_params = (
    be   :: CBackend,
    f    : Function,
    sctx : Ctx,
    out  :: Vec<TyId>
) Res<(), AllocError> {
    f.params.loop((h, i, p) { be.declared_param(p, i, sctx, out).try() });
    Ok(());
}

declared_param = (
    be   :: CBackend,
    p    : Param,
    i    : usize,
    sctx : Ctx,
    out  :: Vec<TyId>
) Res<(), AllocError> {
    (i == 0).match({
        true  => Ok(()),
        false => be.add_declared(p, sctx, out),
    })
}

add_declared = (be :: CBackend, p: Param, sctx: Ctx, out :: Vec<TyId>)
               Res<(), AllocError> {
    out.add(be.check.param_type(p, sctx).try())
}

infer_targs = (
    be       :: CBackend,
    c        : Call,
    declared : Vec<TyId>,
    ctx      : Ctx,
    out      :: Inst
) Res<(), AllocError> {
    c.args.loop((h, i, arg) {
        be.infer_one(arg, i, declared, ctx, out).try();
    });
    Ok(());
}

infer_one = (
    be       :: CBackend,
    arg      : Arg,
    i        : usize,
    declared : Vec<TyId>,
    ctx      : Ctx,
    out      :: Inst
) Res<(), AllocError> {
    declared.get(i).match({
        None  => Ok(()),
        Ok(d) => be.infer_against(arg, d, ctx, out),
    })
}

infer_against = (be :: CBackend, arg: Arg, d: TyId, ctx: Ctx, out :: Inst)
                Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    actual  = be.arg_type(arg.value, ctx, unknown).try();
    unify(be, d, actual, out)
}

// Every parameter bound, and bound to something closed. A free argument
// would become a `sizeof` of a type C has no name for. Named for its own
// question -- are the type arguments settled -- and not `settled`, which
// gen_c_settle.zen answers about a single TyId.
targs_settled = (be: CBackend, slot: Slot, targs: Inst) bool {
    (targs.len() == slot.elems) && be.all_closed(targs)
}

all_closed = (be: CBackend, targs: Inst) bool {
    Range(0, targs.len()).find((i) {
        targs.arg_at(i).match({ Ok(t) => has_var(be.check, t), None => true })
    }).match({ Ok(_) => false, None => true })
}

// Let C size concrete layouts; unit has no C object type and occupies one byte.
write_sizeof* = (be :: CBackend, t: TyId, out :: String)
               Res<(), AllocError> {
    be.is_unit(t).match({
        true  => out.add(", 1"),
        false => {
            be.request_type(t).try();
            cty ::= be.alloc.String().try();
            be.ctype(t, cty).try();
            out.fmt(", sizeof({})", cty.view())
        },
    })
}

fat_effect = (be :: CBackend, call: str, out :: String)
             Res<(), AllocError> {
    be.fmt("{call};\n").try();
    out.add("0")
}
