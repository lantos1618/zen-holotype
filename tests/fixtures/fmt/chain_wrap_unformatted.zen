{ starts_with, ends_with, view } = std.text.str
path_like_eq = (x: string_view, y: string_view) bool { x == y || (x.starts_with("./") && x.ends_with(y) && x.view().len == y.view().len + 2) || (y.starts_with("./") && y.ends_with(x) && y.view().len == x.view().len + 2) }
chain_test = (s: string_view) i64 { s.some_method_with_long_name(1).another_quite_long_method(2, 3).third_method_in_the_chain(4).fourth_one_to_overflow(5).and_a_fifth_for_good_measure(6) }
short_stays = (x: i64) bool { x == 1 || x == 2 }
short_chain = (s: string_view) i64 { s.view().len }
arm_wrap = (b: bool, s: string_view) i64 {
    b.match ({ true => s.some_method_with_long_name(1).another_quite_long_method(2, 3).third_method_in_the_chain(4).fourth_one_to_overflow(5), false => 0 })
}
main = () i32 { 0 }
