// An inferred member instantiation substitutes its return as well as its
// parameter. Passing str to id<T> makes the result str, never i32.

Tool = {
    id = <T>(self: @Self, value: T) T { value }
}

main = (env: Env) Res<i32, AllocError> {
    text: str = "text";
    number: i32 = Tool().id(text);
    println("{}", number);
    Ok(0);
}
