// src/sema/sema_place.zen
// `target = value;` — the one statement Zen spells two ways.
//
// `ast.Bind` writes a DECLARATION and a WRITE identically: one target
// expression, one value, no flag saying which. Every rule about an
// assignment starts by deciding which it's looking at — this file's
// subject.
//
// A bare name DECLARES: nothing to disagree with, so the only work is
// putting the name in scope. Anything else is a PLACE, which already
// has a type, an owner and a marker — `p.x = e` / `buf[i] = e` write
// into storage declared elsewhere, so the value must FIT it, the field
// must be writable, and it must have storage at all. Three rules about
// the target, none asked of a declaration.
//
// Lives beside `sema_type.zen` ("what does this node mean") rather than
// in it ("what does this statement do"). `sema_own.zen` and
// `sema_recv.zen` ask the remaining two questions, who owns the place
// and who may write through it: types here, permission there.

Expr, ExprId, Bind, Access = std.ast
AllocError = std.mem
str = std.text
TyId, TyArray, literal_default = sema.sema_ty
Checker, Ctx, Binding = sema.sema_check
SemaFault, NameFault, PairFault = sema.sema_diag
decl_at = sema.sema_def
computed_member, writable_member = sema.sema_member
check_literal = sema.sema_trap
check_arms, check_arms_agree = sema.sema_hoist
type_of = sema.sema_type
type_from_ast = sema.sema_denote

// `LoopHandle` by WHERE IT IS DECLARED, not by who names it: a program
// may call its own struct `LoopHandle` and bind that freely — the
// refusal answers the library type alone. Written here once for the
// same reason `gen_name.RES_PATH` is: the type is structural in the
// language but answers to a library name, and this check asks that
// name. An unknown module reads as NOT the handle — fail-open, since a
// missed check only misses while a false one refuses a legal program.
HANDLE_MODULE* : str = "std.core.loop.loop_handle"
HANDLE_NAME* : str = "LoopHandle"

// A LOOP HANDLE IS NOT A VALUE, so binding it is refused outright.
//
// `h` arrives in the body as the loop it came from — `gen_c_loop
// .bind_handle` gives the name no storage and lowers `h.break` at the
// NAME — but the signature `(h: LoopHandle, ..)` types it as an
// ordinary nominal, and `kept ::= h;` passed sema in silence and
// emitted C reading an undeclared variable. Reported at the VALUE, the
// one byte that names what cannot be kept; the bind itself runs on, so
// one mistake stays one diagnostic and nothing downstream re-asks.
refuse_handle_value* = (c :: Checker, id: ExprId, got: TyId)
                        Res<(), AllocError> {
    c.is_handle_ty(got).match({
        false => Ok(()),
        true  => c.refuse_handle_at(id),
    })
}

is_handle_ty = (c :: Checker, ty: TyId) bool {
    c.types.at(ty).match({
        Named(n) => c.is_handle_decl(n.decl.module.to_usize(), n.name),
        _        => false,
    })
}

is_handle_decl = (c :: Checker, mi: usize, name: str) bool {
    c.world.table_at(mi).match({
        None  => false,
        Ok(t) => t.name.eq(HANDLE_MODULE) && name.eq(HANDLE_NAME),
    })
}

refuse_handle_at = (c :: Checker, id: ExprId) Res<(), AllocError> {
    node = c.tree.expr_at(id);
    c.report(
        node.span.file,
        node.span,
        SemaFault.HandleNotAValue(NameFault(name: handle_spelling(c, id))),
    )
}

// The handle as WRITTEN, parens unwrapped, for the diagnostic to say
// what stood in the value position — `h` nine times out of ten, never
// assumed.
handle_spelling = (c :: Checker, id: ExprId) str {
    c.tree.expr_at(id).kind.match({
        Name(n)  => n.text,
        Paren(p) => handle_spelling(c, p.inner),
        _        => "",
    })
}

// `x = e;`, `x: T ::= e;`.
//
// ONE MISTAKE, ONE DIAGNOSTIC: a refused rebinding types as poison, so
// the value's own type is never contrasted against a binding the
// statement was not allowed to make.
bind_stmt* = (c :: Checker, b: Bind, ctx: Ctx) Res<TyId, AllocError> {
    got = c.type_of(b.value, ctx).try();
    c.refuse_handle_value(b.value, got).try();
    want = c.check_rebound(b).try().match({
        true  => c.types.unknown(),
        false => c.bind_want(b, got, ctx),
    }).try();
    c.check_assign(b, got, want, ctx).try();
    c.bind_target(b, want, ctx).try();
    c.types.prim("()")
}

// A PLAIN `=` WITH NO TYPE WRITTEN, which is the only spelling that can
// mean a write. `x: T ::= e` and `x ::= e` both DECLARE, whatever else
// is in scope, and the backend agrees: `gen_c_stmt.is_store` asks these
// same two questions before it asks the third.
plain_write = (b: Bind) bool {
    written = b.type.match({ Ok(_) => true, None => false });
    (b.mutable == false) && (written == false)
}

// WHICH BINDING A BARE NAME WRITES TO, when it writes to one at all.
//
// WORD FOR WORD `gen_c_stmt.is_store`, which is the point: the backend
// has always decided this question, and decided it this way — a plain
// `=`, no type written, a name already bound in the body. Sema answered
// "a fresh binding" to all three, so a rebinding was typed at the
// VALUE's type while the emitted C stored into the SLOT's, and
// `n ::= 42; n = 3.5;` became `zu_l1n = 3.5;` inside an `int64_t` with
// nothing but C to object. Two answers to one question is the defect;
// this deletes the second copy rather than adding a rule.
assign_binding = (c :: Checker, b: Bind) Res<Binding> {
    plain_write(b).match({
        false => None,
        true  => c.tree.expr_at(b.target).kind.match({
            Name(n) => c.lookup(n.text),
            _       => None,
        }),
    })
}

// A SECOND `=` BINDING OF ONE NAME IN ONE BLOCK, refused, naming both.
// Answers whether it fired.
//
// The first binding is `=` too, so it is set once and never written;
// and it is still live, so the block holds two bindings of one name
// with one C slot between them. Sema accepted that AT ANOTHER TYPE,
// because `lookup` walks from the top down and shadowing "falls out for
// free" (`sema_check.zen`) — freedom that is right for a nested block
// and wrong here, where nothing was nested.
//
// `lookup_here` and not `lookup`: a nested block IS how shadowing is
// spelled, and a match binder shadows legally.
check_rebound* = (c :: Checker, b: Bind) Res<bool, AllocError> {
    c.rebound_of(b).match({
        None    => Ok(false),
        Ok(old) => c.report_rebound(b, old),
    })
}

rebound_of = (c :: Checker, b: Bind) Res<Binding> {
    plain_write(b).match({
        false => None,
        true  => c.tree.expr_at(b.target).kind.match({
            Name(n) => settled_binding(c.lookup_here(n.text)),
            _       => None,
        }),
    })
}

// A MUTABLE FIRST BINDING IS NOT A MISTAKE: `::=` is exactly the
// permission to be written again, which is the fix this fault names.
settled_binding = (found: Res<Binding>) Res<Binding> {
    found.match({
        Ok(old) => old.mutable.match({ true => None, false => Ok(old) }),
        None    => None,
    })
}

report_rebound = (c :: Checker, b: Bind, old: Binding)
                 Res<bool, AllocError> {
    target = c.tree.expr_at(b.target);
    c.report(
        target.span.file,
        target.span,
        SemaFault.Rebound(PairFault(
            name: old.name,
            first: old.span,
            second: target.span,
        ))
    ).try();
    Ok(true);
}

// What the value has to fit. A written type wins; with none, a WRITE
// takes the storage's type and a fresh binding takes the value's. BUG
// this replaced: answering `got` for both asked whether the value fits
// itself, a check no value can fail — `self.n = "not an int"` on an
// `n :: i32` compiled clean. Value is typed BEFORE this is asked, since
// asking the place first would type a target that may not exist.
bind_want* = (c :: Checker, b: Bind, got: TyId, ctx: Ctx)
             Res<TyId, AllocError> {
    b.type.match({
        Ok(t) => c.type_from_ast(t, ctx),
        None  => c.assign_binding(b).match({
            Ok(old) => c.store_want(old.ty, got),
            None    => c.place_want(b.target, got, ctx),
        }),
    })
}

// A WRITE TAKES THE STORAGE'S TYPE, whatever the value's is — the
// bare-name half of `place_want`'s rule, and the half that was missing:
// `n ::= 42; n = 3.5;` emitted `zu_l1n = 3.5;` into an `int64_t`, and
// nothing but C had an opinion.
//
// EXCEPT THAT AN UNSETTLED SLOT HAS NOT CHOSEN A WIDTH. `n ::= 0`
// freezes the FAMILY and nothing more — `int` is the literal's own
// type, the slot it emits is an `int64_t`, and every integer reaches
// one — so `fields ::= 0; fields = fields + m.NULL` stores an `i32`
// exactly, while `n = 3.5` still has no integer to be. A settled slot
// has chosen, and then the choice is the answer.
store_want = (c :: Checker, old: TyId, got: TyId) Res<TyId, AllocError> {
    (c.is_literal_ty(old) && c.assignable(old, got)).match({
        true  => Ok(got),
        false => Ok(old),
    })
}

// A place's type is `type_of`'s answer for reads — a write asks the
// same question of the same node. Unresolved comes back poisoned, which
// `assignable` accepts: an unresolved place fails open.
place_want* = (c :: Checker, id: ExprId, got: TyId, ctx: Ctx)
              Res<TyId, AllocError> {
    c.tree.expr_at(id).kind.match({
        Name(_) => c.settled_array(got),
        _       => c.type_of(id, ctx),
    })
}

// A DECLARATION WITH NOTHING WRITTEN ON IT FREEZES WHAT THE VALUE IS
// WORTH, and an array's element cannot be left unsettled there the way
// a scalar's can. `n = 1` may stay `int` — C converts an `int64_t` into
// every integer position — but `[i32, 3]` is a STRUCT, and a local
// declared `[int, 3]` reaches no `[i32, 3]` in the program.
// `sema_apply.settled_arg_ty` settles a type argument for this reason
// and in these words: a literal settles before it is minted into
// another type. `gen_c_stmt.settled_value_type` is the same call at the
// same statement.
//
// ONLY WHERE NOTHING SAYS OTHERWISE. A written `[u8, 3]` IS the
// elements' context and reaches them through `assignable`, so it never
// arrives here — settling ahead of it would refuse what it accepts.
settled_array* = (c :: Checker, ty: TyId) Res<TyId, AllocError> {
    c.types.at(ty).match({
        Array(a) => c.settled_elem(ty, a),
        _        => Ok(ty),
    })
}

settled_elem = (c :: Checker, ty: TyId, a: TyArray) Res<TyId, AllocError> {
    elem = c.is_literal_ty(a.elem).match({
        true  => c.types.prim(literal_default(c.prim_name(a.elem))),
        false => c.settled_array(a.elem),
    }).try();
    elem.eq(a.elem).match({
        true  => Ok(ty),
        false => c.types.array(elem, a.count),
    })
}

check_assign* = (c :: Checker, b: Bind, got: TyId, want: TyId, ctx: Ctx)
               Res<(), AllocError> {
    node = c.tree.expr_at(b.value);
    c.coerce(node.span.file, node.span, got, want, "").try();
    // family agreeing != value fitting: `n: i32 = 2147483648` is an
    // `int` literal, and `literal_fits` says every one fits every
    // integer type, so `coerce` alone said nothing
    c.check_literal(b.value, want).try();
    c.written_want(b, want).try();
    Ok(());
}

// AN ARM STANDS WHERE THE MATCH STANDS (`sema_hoist.check_arms`), and a
// declaration with a written type is such a place: `n: i32 = b.match({
// true => 1, false => false })` puts both arms where `i32` is, and
// `coerce` above only ever saw the first one's type.
//
// WHICH WORD THE ARMS OWE, and never no word at all. `x := <match>`
// takes `want` FROM the value, so the position has none of its own —
// "expected" would name whichever arm came first, and no arm is
// entitled to speak for the position. What is still true is that the
// arms owe EACH OTHER, and `check_arms_agree` holds them to their own
// join and says so in the arms' voice. Answering `Ok(())` here instead
// is what let the mismatched-arm program through a binding.
written_want = (c :: Checker, b: Bind, want: TyId) Res<(), AllocError> {
    b.type.match({
        Ok(_) => c.check_arms(b.value, want),
        None  => c.check_arms_agree(b.value),
    })
}

// Only a bare name introduces a binding; `c.len = ..` and `buf[i] = ..`
// assign to something that already exists — why `Bind.target` is an
// expression, not an `Ident`.
bind_target* = (c :: Checker, b: Bind, ty: TyId, ctx: Ctx)
              Res<(), AllocError> {
    target = c.tree.expr_at(b.target);
    target.kind.match({
        Name(n)   => c.bind_name(b, n.text, target, ty),
        Access(a) => c.assign_access(target, a, ctx),
        _         => Ok(()),
    }).try();
    Ok(());
}

// A WRITE INTRODUCES NOTHING. Binding the name a second time would put
// two rows on the scope stack for one C slot, and the second row's type
// is what every later read would answer with — which is how `n = 3.5`
// came to read back as an `f64` from an `int64_t`.
bind_name = (c :: Checker, b: Bind, name: str, target: Expr, ty: TyId)
            Res<(), AllocError> {
    c.assign_binding(b).match({
        Ok(_) => Ok(()),
        None  => c.bind_at(name, ty, b.mutable, false, target.span),
    })
}

// `c.width = 5` on an impl-supplied field: there is nothing to assign
// into. "Mutation goes through exported methods, as it always does."
assign_access* = (c :: Checker, target: Expr, a: Access, ctx: Ctx)
                Res<(), AllocError> {
    c.writable_member(a, ctx).try();
    c.computed_member(a, ctx).try().match({
        true  => c.no_storage(target, a),
        false => Ok(()),
    })
}

no_storage* = (c :: Checker, target: Expr, a: Access) Res<(), AllocError> {
    c.report(
        target.span.file,
        target.span,
        SemaFault.ComputedFieldAssign(NameFault(name: a.name.text))
    )
}
