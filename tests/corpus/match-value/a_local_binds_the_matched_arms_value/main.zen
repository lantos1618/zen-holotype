// A LOCAL BOUND TO A MATCH HOLDS THE MATCHED ARM'S VALUE -- not the
// scrutinee, and not another arm's.
//
// Both bindings below match the SAME scrutinee `n = 9`, and the
// matching arm sits at a different POSITION in each (first in one,
// middle in the other). So "take the first arm" and "take the last
// arm written" each fail exactly one binding while compiling cleanly,
// and a lowering that leaks the scrutinee through fails both:
//
//   correct               40 460   500
//   scrutinee leaks out    9   9    18
//   first arm always      40 400   440
//   last arm always       41 406   447
//
// The sum is printed so a wrong PAIR cannot hide behind one lucky
// line: every wrong reading above sums differently.

main = (env: Env) Res<i32, AllocError> {
    n ::= 9;

    small = n.match({
        9 => 40,
        _ => 41,
    });
    large = n.match({
        0 => 400,
        9 => 460,
        _ => 406,
    });

    println("{} {}", small, large);
    println("{}", small + large);
    Ok(0);
}
