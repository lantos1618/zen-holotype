    ), DiagCase(
        src: "halloc = std.mem.heap\n{ new_in } = std.mem.rc\n{ expect } = std.core.result\nmain = () i32 {\n    alloc := halloc.gpa()\n    r := alloc.addr().new_in(41).expect(\"rc\")\n    r.drop_in(alloc.addr())\n    r.get()\n}\n",
        wants: [":8:5: error[ownership]: use of an owner after release/drop", "      r.get()", "      ^"],
    ), DiagCase(
