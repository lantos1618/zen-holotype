// tests/corpus/std/vec_grows_past_sixteen.zen
// two reallocs, not one: 0 -> 8 -> 16 -> 32. read back through get
// rather than loop, so this fails if realloc moved the buffer and
// indexed access still points at the old pages

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    v ::= alloc.Vec<i32>();

    Range(0, 17).loop((h, n) {
        v.add(n).try();
    });

    println("len {}", v.len);
    Range(0, 17).loop((h, i) {
        v.get(i).match({
            Ok(n) => println("{}", n),
            None  => println("missing {}", i),
        });
    });
    Ok(0);
}
