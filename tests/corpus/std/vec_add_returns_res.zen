// tests/corpus/std/vec_add_returns_res.zen
// add is Res<(), AllocError>: it can fail, because it can grow.
// the second matched add is the one at capacity, so the Res comes
// back through grow's own .try() and not just through the easy
// path that never allocates

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    v     ::= alloc.Vec<i32>();

    v.add(1).match({
        Ok(_)  => println("ok"),
        Err(_) => println("err"),
    });

    Range<i32>(0, 7).loop((h, n) {
        v.add(n).try();
    });

    // v is at len 8 = capacity: this add must grow
    v.add(9).match({
        Ok(_)  => println("ok past grow"),
        Err(_) => println("err past grow"),
    });
    Ok(0);
}
