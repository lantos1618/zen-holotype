// parameter names are documentation, not identity: `(first: T, second: T) T`
// and `(left: T, right: T) T` are the SAME signature. declaring both is
// an error at the declaration site, naming both declarations, and it
// fires when the generic is instantiated. DESIGN.md, Overloading.
//
// positions: both declarations. NOT the call site -- the call is only
// what triggers the check.

combine = <T>(first: T, second: T) T { first }

combine = <T>(left: T, right: T) T { right }

main = (env: Env) Res<i32, AllocError> {
    println("{}", combine(1, 2));
    Ok(0);
}
