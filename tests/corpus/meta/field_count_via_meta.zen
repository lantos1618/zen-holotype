// M4 SLICE 1'S GATE, THE VIA-META HALF (`docs/design_meta.md` §7, M4
// slice 1): `@meta(self: @Self).fields().len` folds at sema time to the
// WRITTEN type's FIELD count — `Struct.members` filtered to
// `MemberKind.Field`, so a constant member (`k: i64 = 5`) and a method
// do not count. The backend lowers it as an ordinary integer literal,
// having learned nothing new.
//
// THE TWIN IS THE ORACLE (§6.3): `field_count_by_hand` writes each
// count by hand and must print byte-identical stdout.
//
// THE FOUR ANSWERS, stated (§7 M4): Empty -> 0, One -> 1, Mixed -> 3,
// Muddle -> 2. The last is the mutation-resistant case: Muddle has
// four members and an implementation counting `members.len` prints 4.
//
// MUTATION RESISTANCE (§6.4): line one asserts all four counts out
// loud; line two is an arithmetic witness with no zero term — a
// transposed or skipped field changes it. A filter that also counted
// consts prints 0 1 3 3 / witness 108 instead of 0 1 3 2 / 87.

Empty = { }

One = {
    only: i64,
}

Mixed = {
    a: i64,
    b: bool,
    c: str,
}

Muddle = {
    p: i64,
    q: bool,

    k: i64 = 5,

    go* = (self: @Self) i64 { 7 },

    fields* = (self: @Self) i64 { @meta(self: @Self).fields().len },
}

main = (env: Env) Res<i32, AllocError> {
    println("counts {} {} {} {}",
        @meta(x: Empty).fields().len,
        @meta(x: One).fields().len,
        @meta(x: Mixed).fields().len,
        m.fields());
    println("witness {}",
        ((@meta(x: Empty).fields().len * 1)
            + (@meta(x: One).fields().len * 2)
            + (@meta(x: Mixed).fields().len * 5)
            + (@meta(x: Muddle).fields().len * 7)) * 3);
    Ok(0);
}
