// a Drop temporary in STATEMENT position has no binding, and the design
// is explicit: "never a temporary" — nobody owns it, so nothing may drop
// it. the trap is that dropping nothing looks like correct silence; what
// makes this discriminate is the two REAL bindings around it. an
// implementation that registered statement-position temporaries prints
// "drop 99" after `mid` (or at function exit), one that also broke
// reverse order over bindings prints 1 before 2. only c then b, with 99
// never appearing, is right.

Noisy = {
    env: Env,
    id: i32,
}

Noisy.impl(Drop, {
    drop = (self :: @Self) () { self.env.out.println("drop {}", self.id) }
})

main = (env: Env) Res<i32, IoError> {
    a = Noisy(env: env, id: 1);
    Noisy(env: env, id: 99);
    println("mid");
    b = Noisy(env: env, id: 2);
    println("end");
    Ok(0);
}
