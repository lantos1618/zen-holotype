// consumed inside a `.then` body, used after it. `.then` is an
// ordinary function taking a non-escaping closure, so the body is a
// path that may or may not run — the same join as a match arm, but
// reached through a closure rather than an arm.
//
// a checker that treats a closure body as opaque accepts this and is
// unsound; one that treats it as unconditional straight-line code
// rejects the corpus counterpart. it has to be a real edge.

Buf = {
    id: i32,
}

Buf.impl(Drop, {
    drop = (self :: @Self) () { /* nothing to release: id is bytes */ }
})

main = (env: Env) Res<i32, IoError> {
    f = Buf(id: 1);
    n = 1;
    (n == 1).then(() { consume f });
    println("{}", f.id);
    Ok(0);
}
