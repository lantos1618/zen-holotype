// fmt-gate: a trait's default method bodies must print INSIDE the record (never hoisted to top
// level, where `Self` is unbound), and a data record must keep a user-written fn-typed field.
Area*: {
    area:  (self: Ptr<Self>) i32,
    // double the area via the required method
    twice = (p: Ptr<Self>) i32 { p.area()*2 },
    quad = (p: Ptr<Self>) i32 {
        t = p.twice()
        t*2
    },
}
Mixed: {
    n:    i32,
    pick: (left: i32, right: i32) i32,
    bump = (m: Ptr<Mixed>) i32 { m.n+1 },
}
