// `(i + 1) < f.len` was read as a LAMBDA's parameter list, because the
// lookahead saw `<` after the `)` and `<T>(a: T) T` is a type that
// begins with an angle. One wrong fork then unwound into EIGHT
// diagnostics, all from the same spot -- which is the cascade this
// file's .count bounds.
//
// THE FORK IS BACK IN THE FILE. For a while this file held only the
// unclosed paren, so the shape it is named for -- a CLOSED `)` followed by
// `<` -- appeared nowhere in it, the lambda lookahead never fired, and
// reverting the original bug would have left the test green. `ok` below is
// that shape, and it must compile: a parser that takes the lambda fork
// reports on it and blows the count.
//
// The second function is genuinely wrong (the `(` is never closed), so
// one diagnostic is correct. What must never happen again is eight.
ok = (i: usize, n: usize) bool {
    (i + 1) < n
}

at = (f: str, i: usize) bool {
    (i + 1 < f.len;
}

main = (env: Env) Res<i32, ArgError> {
    println("{}", ok(1, 5));
    Ok(0);
}
