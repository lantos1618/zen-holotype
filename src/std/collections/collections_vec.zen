// src/std/collections/collections_vec.zen
// Vec<T>: the growable buffer everything else is built on. everything
// here is sealed (=) — collections are not extension points, and
// sealed methods compile to direct, inlinable calls

Alloc, AllocError, Ptr, null_ptr = std.mem
Range = std.core.range

Vec*<T> = {
    // an empty Vec owns no pages: a null data and a zero capacity ARE
    // the empty state, and realloc takes a null p as a fresh
    // allocation — so the first grow runs the same call every later
    // one does
    data :: Ptr<T> = null_ptr<T>(),
    len* :: usize = 0,      // * is readable outside; mutation still only via methods
    capacity :: usize = 0,

    // `:` set once at construction. an Alloc is a handle — two words
    // pointing at the arena — so grow can realloc THROUGH it while the
    // field itself stays immutable. `::` is shallow, and this is why
    alloc: Alloc,

    // grow lands in THIS frame, never inside a closure: the match is a
    // value and the .try() on it belongs to add. so a failed grow
    // returns Err from add and provably cannot fall through to the
    // write below
    add* = (self :: @Self, value: T) Res<(), AllocError> {
        (self.len == self.capacity).match({
            true  => self.grow(),
            false => Ok(()),
        }).try();
        self.data.write(self.len, value);
        self.len = self.len + 1;
        Ok(());
    }

    get* = (self: @Self, i: usize) Res<T> {
        (i < self.len).match({
            true  => Ok(self.data.read(i)),
            false => None,
        });
    }

    // the buffer itself. String.view builds a `str` over this Vec's
    // storage and cannot go through get; `data` stays unexported
    ptr* = (self: @Self) Ptr<T> { self.data }

    // the dual of get, and what a Map overwrites a row through. past
    // len is None exactly as get is: a write that can legitimately
    // miss is not a bug either
    set* = (self :: @Self, i: usize, value: T) Res<()> {
        (i < self.len).match({
            true  => { self.data.write(i, value); Ok(()) },
            false => None,
        });
    }

    // moves an element OUT, leaving the vec one shorter. without this a
    // Vec<T> of Drop values can be filled and never emptied
    take* = (self :: @Self, i: usize) Res<T> {
        value = self.get(i).try();
        Range(i + 1, self.len).loop((h, j) {
            self.data.write(j - 1, self.data.read(j));
        });
        self.len = self.len - 1;
        Ok(value);
    }

    // room for `n` MORE elements, before anything writes them.
    //
    // It exists because a CAPABILITY'S FLOOR fills a run this module
    // did not allocate: `Stdin.read` (std.env) hands the C floor the
    // buffer's spare capacity and the floor reads into it, so the room
    // has to be there BEFORE the call and cannot be made inside one.
    // Every other filler goes through `add` and needs none of this.
    //
    // It asks for DOUBLE what was requested, so that a caller reading a
    // stream a chunk at a time reallocs a logarithmic number of times
    // rather than once per chunk.
    reserve* = (self :: @Self, n: usize) Res<(), AllocError> {
        want = self.len + n;
        (want <= self.capacity).match({
            true  => Ok(()),
            false => self.reallocate(want * 2),
        })
    }

    grow = (self :: @Self) Res<(), AllocError> {
        self.reallocate((self.capacity == 0).match({
            true  => 8,
            false => self.capacity * 2,
        }))
    }

    reallocate = (self :: @Self, cap: usize) Res<(), AllocError> {
        self.data = self.alloc.realloc(self.data, cap).try();
        self.capacity = cap;
        Ok(());
    }
}

// a Vec IS a Range of its elements, and the impl is one line because
// `get` already answers exactly the question `at` asks — including the
// None past the end, which is what stops a walk rather than reading
// past the buffer.
//
// start and end are SUPPLIED, not stored (DESIGN.md: "you satisfy
// requirements, you never impl storage"), so a Vec stays exactly as
// wide as it was and one that grows mid-loop reports its new end
// rather than a stale one.
Vec.impl(Range<T>, {
    start: 0,
    end: self.len,

    at ::= (self: @Self, index: usize) Res<T> { self.get(index) }
})

// `alloc.Vec<i32>()`: a ufcs function whose first parameter is an
// Alloc, so it calls as a method on one. it lives beside Vec rather
// than on Alloc because only this module can see data and capacity,
// and a Vec-shaped default inside std.mem would point the dependency
// the wrong way.
//
// a bare value and not a Res: an empty Vec owns no pages, so
// construction cannot fail. the first add allocates and THAT is what
// returns Res
Vec* = <T>(a: Alloc) Vec<T> {
    Vec(alloc: a)
}
