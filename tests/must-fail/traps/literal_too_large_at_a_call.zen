// tests/must-fail/traps/literal_too_large_at_a_call.zen
// the SAME rule as literal_too_large_i32, in a position that is not an
// annotated binding. resolution picks a candidate on the family — an
// `int` literal fits every integer type — so the value was never asked
// about, and the argument truncated to -2147483648 in silence

// main must name an error type. a trap never lifts into Res:
// it aborts the process
Error = Overflow | DivideByZero | OutOfBounds

narrow = (n: i32) i32 { n }

main = (env: Env) Res<i32, Error> {
    v = narrow(2147483648);
    println("{}", v);
    Ok(0);
}
