// Alias semantics use the target type, but metadata reports the declaration
// spelling the user wrote. Thus `P2` behaves as `Point` while retaining `P2`
// as its metadata name.
//
// Printing each name with its length makes plausible wrong substitutions
// visible. Two generic instantiations also ensure each Meta node retains its
// own written type.
//
// The enum-target alias rides along: the DECL of `Colors = Color` is
// `Alias`, not `Enum`, and the written name must survive that too.

Point = {
    x: i64,
    y: i64,
}

Color = Red | Green

P2    = Point
Colors = Color

Box<T> = {
    v: T,
}

first = () str { @meta(x: Box<i64>).name }

second = () str { @meta(x: Box<bool>).name }

main = (env: Env) Res<i32, AllocError> {
    println("{} {}", @meta(x: P2).name, @meta(x: P2).name.len);
    println("{} {} {} {}", first(), first().len, second(), second().len);
    println("{} {}", @meta(x: Colors).name, @meta(x: Colors).name.len);
    Ok(0);
}
