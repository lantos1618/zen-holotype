// src/sema/sema_supply.zen
// What an IMPL supplies through a dot.
//
// `sema_member.zen` answers what a dot reaches; this answers the half of
// it that the type did not declare. The two split because they are two
// questions with two rules, and the file that held both said so in its
// own title:
//
//   THE TYPE'S OWN MEMBERS ARE STORAGE and win outright. Layout is fixed
//   at declaration and cannot depend on which impls are linked, so a
//   member the declaration writes is never contested.
//   AN IMPL'S ARE COMPUTED — "you satisfy requirements, you never impl
//   storage" — re-evaluated on read, read-only, non-addressable, and
//   invisible to layout. That is the whole of `Found.computed`.
//
// AN IMPL LIVES WITH THE TYPE, NOT WITH THE TRAIT, which is why
// `Impl.target` is an `Ident` and not a qualified type: there is no
// orphan impl to express, so the search is over one module's impls and a
// same-named type elsewhere is never confused for this one.
//
// A BOUND'S MEMBERS ARE READ IN THE BOUND'S OWN SCOPE, and that is the
// rule this file states three times because three readers need it.
// `Slot<T> = { held*: T }` declares `T` and its members mean it, so
// reading them without `T` bound reports it as undefined in the very
// declaration that binds it — from a caller that only asked what a dot
// reaches. `enter_*_tvars` is that binding, and it is always a pair.
//
// WHAT AN IMPL OWES is `sema_bound.zen`'s subject and not this one: this
// file asks what an impl PROVIDES to a reader, and that one asks whether
// it provided everything it promised. A required member with no body is
// absent here and a diagnostic there.

Ast, Expr, ExprId, Access, Ident, Span, Pos, TypeId = ast
Decl, DeclKind, Struct, Impl, Member, MemberKind = ast
Field, Const, Function, Form, Param, TParam = ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
DeclId, ImplId = sema.sema_id
TyId, Ty, Types, TyNamed, Prim = sema.sema_ty
World, Def, DefKind, decl_at = sema.sema_def
Checker, Ctx, UNRESOLVED = sema.sema_check
Found, member_named, member_type, nowhere = sema.sema_member
enter_struct_tvars, decl_span = sema.sema_member
type_from_ast, param_type = sema.sema_type

// "An impl lives with the type, not with the trait", so an impl of a
// type is in that type's own module — which is why the module index is
// part of the match and a same-named type elsewhere is not confused for
// this one.
impl_members* = (c :: Checker, n: TyNamed, ty: TyId, name: str,
                out :: Vec<Found>) Res<(), AllocError> {
    ids ::= c.alloc.Vec<ImplId>();
    c.world.impls_named(c.tree, n.name, ids).try();
    ids.loop((h, id) { local_impl(c, n, ty, name, id, out).try() });
    Ok(());
}

local_impl = (c :: Checker, n: TyNamed, ty: TyId, name: str, id: ImplId,
              out :: Vec<Found>) Res<(), AllocError> {
    (n.decl.module == id.decl.module).match({
        true  => impl_supplies(c, n, ty, name, id, out),
        false => Ok(()),
    })
}

impl_supplies = (c :: Checker, n: TyNamed, ty: TyId, name: str, id: ImplId,
                 out :: Vec<Found>) Res<(), AllocError> {
    c.world.impl_at(c.tree, id).match({
        Ok(im) => supplied(c, n, ty, name, id, im, out),
        None   => Ok(()),
    }).try();
    Ok(());
}

// An impl entry supplies the name, or the bound provides it with a body
// of its own — `area` comes along free because it "only ever needed a
// width and a height". Either way the TYPE is the one the bound
// declares, never the supplied expression's: `width: self.radius * 2.0`
// is an f64 because `Rect` said f64.
//
// A NAME IS AN OVERLOAD SET AND NOT A MEMBER, so this adds one `Found`
// PER DECLARATION and never one per impl. `Display` declares two
// `toString`s — a sink form and a sealed allocating one — and "overload
// resolution picks between them on the declared parameter type" can only
// be true if both survive to the call site. They did not: the type of
// the name was a fold over the members that kept the LAST match, so a
// set of two arrived as one, the allocating one, and every
// `p.toString(buffer)` in the language typed as `Res<String,
// WriteError>` while the backend correctly called the form returning
// `Res<(), WriteError>`. Nothing in sema was choosing wrongly — there
// was nothing left to choose FROM.
supplied = (c :: Checker, n: TyNamed, ty: TyId, name: str, id: ImplId,
            im: Impl, out :: Vec<Found>) Res<(), AllocError> {
    mi = n.decl.module.to_usize();
    bound = impl_bound_type(c, im, mi).try();
    tys ::= c.alloc.Vec<TyId>();
    supplied_types(c, im, bound, name, ty, tys).try();
    tys.loop((h, t) { add_supplied(c, t, bound, name, id, out).try() });
    Ok(());
}

// WHICH OF THE BOUND'S DECLARATIONS OF THIS NAME THE IMPL ACTUALLY
// REACHES. A bodied member — sealed, or a default — comes along on its
// own. A bodiless one is a requirement, and it is reachable exactly when
// the impl supplied that name.
//
// Asking `has_member` of the impl rather than matching its entry against
// a particular declaration is deliberate: which signature an impl
// satisfied is `sema_bound.zen`'s question, it is answered there against
// the whole set, and answering it a second time here with a weaker rule
// is how two files come to disagree about what an impl provided.
supplied_types = (c :: Checker, im: Impl, bound: TyId, name: str,
                  self_ty: TyId, out :: Vec<TyId>) Res<(), AllocError> {
    supplied_here = has_member(im.members, name);
    all ::= c.alloc.Vec<Member>();
    bound_members(c, bound, all).try();
    kept ::= c.alloc.Vec<Member>();
    all.loop((h, m) { keep_reachable(m, name, supplied_here, kept).try() });
    member_types(c, bound, kept, self_ty, out)
}

// A named helper rather than a `.then` inside the loop body: a loop
// binding read inside a nested closure does not resolve.
// docs/SEMA_BOOTSTRAP_FIXES.md §10.
keep_reachable = (m: Member, name: str, supplied_here: bool,
                  kept :: Vec<Member>) Res<(), AllocError> {
    (member_named(m, name) && (has_body(m) || supplied_here)).match({
        true  => kept.add(m),
        false => Ok(()),
    })
}

// The bound an impl names, resolved with the TARGET's type parameters
// in scope.
//
// `Vec.impl(Range<T>, ..)` writes `Vec`'s own `T`, and `Impl` has no
// `tparams` field to read because there is nothing for it to hold: an
// impl declares no type parameters, it borrows the ones the target
// declared. Every reader of `im.bound` goes through here so the three
// of them cannot disagree about what `T` meant — and because
// `type_from_ast` memoizes on the node id, the FIRST reader decides for
// all of them anyway.
impl_bound_type* = (c :: Checker, im: Impl, mi: usize)
                   Res<TyId, AllocError> {
    poison = c.types.unknown().try();
    tmark = c.tvar_mark();
    enter_target_tvars(c, im.target.text, mi).try();
    got = c.type_from_ast(im.bound, Ctx(mi, poison)).try();
    c.release_tvars(tmark).try();
    Ok(got);
}

// An impl lives in the module that declares its target, so the target
// is looked up there and nowhere else — which is the same fact that
// makes `Impl.target` an `Ident` and not a qualified type.
enter_target_tvars = (c :: Checker, target: str, mi: usize)
                     Res<(), AllocError> {
    defs ::= c.alloc.Vec<Def>();
    c.world.own_defs(mi, target, defs).try();
    defs.get(0).match({
        None    => Ok(()),
        Ok(d)   => enter_def_tvars(c, d, mi),
    }).try();
    Ok(());
}

enter_def_tvars = (c :: Checker, d: Def, mi: usize) Res<(), AllocError> {
    decl_at(c.tree, d.id).match({
        Ok(x) => enter_decl_tvars(c, x, mi),
        None  => Ok(()),
    }).try();
    Ok(());
}

enter_decl_tvars = (c :: Checker, d: Decl, mi: usize) Res<(), AllocError> {
    d.kind.match({
        Struct(s) => enter_struct_tvars(c, s, mi),
        _         => Ok(()),
    })
}

// The bound declares it AND gives it a body: sealed and default members
// come along with the impl, a required one does not.
has_body = (m: Member) bool {
    m.kind.match({
        Function(f) => f.body.match({ Ok(_) => true, None => false }),
        _           => false,
    })
}

add_supplied = (c :: Checker, ty: TyId, bound: TyId, name: str, id: ImplId,
                out :: Vec<Found>) Res<(), AllocError> {
    out.add(Found(
        name: name,
        ty: ty,
        computed: true,
        mutable: false,
        exported: true,  // an impl supplies what a bound REQUIRED; the star
        module: 0,       // that let the bound out already answered law 6
        bound: bound,
        span: impl_span(c, id),
    ))
}

// The third site of the same rule, and the one a member lookup alone
// would not show: a bound's members are read in the bound's own scope.
// `Slot<T> = { held*: T }` declares `T` and its members mean it, so
// reading them without it reports `T` as undefined in the declaration
// that binds it — from a caller that only asked what a dot reaches.
// THE FIRST declaration of the name, for a reader that wants a type and
// not a set: a COMPUTED FIELD. `width: self.radius * 2.0` is one
// declaration by construction — a field is storage-shaped and there is
// no such thing as two of it — so first, last and only are the same
// answer, and the caller that needs the set asks for the set.
bound_member_type* = (c :: Checker, bound: TyId, name: str, self_ty: TyId)
                     Res<TyId, AllocError> {
    tys ::= c.alloc.Vec<TyId>();
    bound_member_types(c, bound, name, self_ty, tys).try();
    tys.get(0).match({ Ok(t) => Ok(t), None => c.types.unknown() })
}

// EVERY declaration of the name, in source order, because a name is an
// overload set. The caller chooses; a fold here would choose by writing
// order and call it a type.
bound_member_types* = (c :: Checker, bound: TyId, name: str, self_ty: TyId,
                       out :: Vec<TyId>) Res<(), AllocError> {
    all ::= c.alloc.Vec<Member>();
    bound_members(c, bound, all).try();
    kept ::= c.alloc.Vec<Member>();
    all.loop((h, m) { keep_reachable(m, name, true, kept).try() });
    member_types(c, bound, kept, self_ty, out)
}

// The types of members already chosen, resolved in the BOUND's own
// scope. The `tvar` pair is what makes `Slot<T> = { held*: T }` readable
// at all — see this file's header, third statement of the same rule.
member_types = (c :: Checker, bound: TyId, ms: Vec<Member>, self_ty: TyId,
                out :: Vec<TyId>) Res<(), AllocError> {
    mi = bound_module(c, bound);
    tmark = c.tvar_mark();
    enter_bound_tvars(c, bound, mi).try();
    ms.loop((h, m) { out.add(member_type(c, m, mi, self_ty).try()).try() });
    c.release_tvars(tmark).try();
    Ok(());
}

enter_bound_tvars = (c :: Checker, bound: TyId, mi: usize)
                    Res<(), AllocError> {
    c.types.at(bound).match({
        Named(n) => enter_named_tvars(c, n, mi),
        _        => Ok(()),
    })
}

enter_named_tvars = (c :: Checker, n: TyNamed, mi: usize)
                    Res<(), AllocError> {
    decl_at(c.tree, n.decl).match({
        Ok(d) => enter_decl_tvars(c, d, mi),
        None  => Ok(()),
    }).try();
    Ok(());
}

// The members a bound declares, in source order.
bound_members* = (c :: Checker, bound: TyId, out :: Vec<Member>)
                 Res<(), AllocError> {
    c.types.at(bound).match({
        Named(n) => bound_decl_members(c, n, out),
        _        => Ok(()),
    }).try();
    Ok(());
}

bound_decl_members = (c :: Checker, n: TyNamed, out :: Vec<Member>)
                     Res<(), AllocError> {
    decl_at(c.tree, n.decl).match({
        Ok(d) => copy_struct_members(d, out),
        None  => Ok(()),
    }).try();
    Ok(());
}

copy_struct_members = (d: Decl, out :: Vec<Member>) Res<(), AllocError> {
    d.kind.match({
        Struct(s) => add_all_members(s, out),
        _         => Ok(()),
    })
}

add_all_members = (s: Struct, out :: Vec<Member>) Res<(), AllocError> {
    s.members.loop((h, m) { out.add(m).try() });
    Ok(());
}

bound_module = (c: Checker, bound: TyId) usize {
    c.types.at(bound).match({
        Named(n) => n.decl.module.to_usize(),
        _        => 0,
    })
}

// ---------------------------------------------------------------------
// DECLARED, WHICH IS NOT THE SAME AS REACHABLE
//
// `keep_reachable` above answers "does a dot reach this", and it
// correctly answers NO for a hook no impl supplied. `Alloc.create` is
// exactly that: `mem_alloc.zen` declares it with no body, no impl in the
// language supplies one, and `gen_c_alloc.zen` writes the body. So
// `alloc.create<Node>()` resolves to nothing in sema AND IS NOT A
// MISTAKE — while `b.size()` on a `Box` resolves to nothing and is.
//
// Only a diagnostic needs to tell those apart, so only a diagnostic asks
// this. A member lookup must keep answering "not reachable" to both, or
// the type of `create` becomes a bodiless signature and the backend's
// own answer stops being the one that counts.
// ---------------------------------------------------------------------

bound_declares* = (c :: Checker, ty: TyId, name: str)
                  Res<bool, AllocError> {
    c.types.at(ty).match({
        Named(n) => impls_declare(c, n, name),
        Prim(p)  => prim_impls_declare(c, p, name),
        // a type parameter promises what its bounds promise, and what
        // it stands for is not settled here
        Var(_)   => Ok(true),
        _        => Ok(false),
    })
}

impls_declare = (c :: Checker, n: TyNamed, name: str)
                Res<bool, AllocError> {
    ids ::= c.alloc.Vec<ImplId>();
    c.world.impls_named(c.tree, n.name, ids).try();
    hit ::= false;
    ids.loop((h, id) {
        impl_declares(c, n, name, id).try().then(() { hit = true; });
    });
    Ok(hit);
}

impl_declares = (c :: Checker, n: TyNamed, name: str, id: ImplId)
                Res<bool, AllocError> {
    (n.decl.module == id.decl.module).match({
        false => Ok(false),
        true  => impl_bound_declares(c, n, name, id),
    })
}

impl_bound_declares = (c :: Checker, n: TyNamed, name: str, id: ImplId)
                      Res<bool, AllocError> {
    c.world.impl_at(c.tree, id).match({
        Ok(im) => bound_of_impl_declares(c, n, name, im),
        None   => Ok(false),
    })
}

bound_of_impl_declares = (c :: Checker, n: TyNamed, name: str, im: Impl)
                         Res<bool, AllocError> {
    bound = impl_bound_type(c, im, n.decl.module.to_usize()).try();
    all ::= c.alloc.Vec<Member>();
    bound_members(c, bound, all).try();
    Ok(has_member(all, name));
}

// "A prelude declaration of a primitive's name IS that primitive", so
// the impls on `str` are the impls on the declaration the prelude
// exports under that spelling — the same detour `prim_members` makes.
prim_impls_declare = (c :: Checker, p: Prim, name: str)
                     Res<bool, AllocError> {
    defs ::= c.alloc.Vec<Def>();
    c.world.prelude_of(p.name, defs).try();
    defs.get(0).match({
        None  => Ok(false),
        Ok(d) => impls_declare(c, TyNamed(decl: d.id, name: p.name,
                                          args: c.alloc.Vec<TyId>()), name),
    })
}

has_member* = (members: Vec<Member>, name: str) bool {
    Range(0, members.len).find((i) {
        members.get(i).match({
            Ok(m) => member_named(m, name),
            None  => false,
        })
    }).match({ Ok(_) => true, None => false })
}

impl_span* = (c: Checker, id: ImplId) Span {
    decl_span(c, id.decl)
}
