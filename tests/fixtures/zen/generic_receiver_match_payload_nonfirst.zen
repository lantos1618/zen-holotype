{ eq } = std.text.str
{ to_exit } = std.core.bool
Box<T>: {
    value: T,
    get = (box: Box<T>) T { box.value }
}
Msg*: Empty | Hold(Box<string_view>)
main = () i32 {
    msg := Msg.Hold(Box<string_view>(value: "generic"))
    got := msg.match ({
        .Empty     => "empty",
        .Hold(box) => box.get(),
    })
    eq(got, "generic").to_exit()
}
