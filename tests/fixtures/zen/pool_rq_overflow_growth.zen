// OVERFLOW: make far more actors runnable at once than the pool's initial run-queue capacity
// (rqcap=4, 256 actors, ONE worker so the queue genuinely backs up while the main thread blasts
// sends). Before run-queue growth this hard-aborted ("pool: run-queue overflow", exit 134); with
// growth the queue reallocates under p.mu (4 -> 512 across doublings) and every message is still
// processed EXACTLY once. Each iteration asserts processed == accepted == NACT; repeated ITERS×
// (scheduling interleavings are probabilistic).
{ pool_open, pool_spawn, pool_send, pool_quiesce_stop, pool_close, pool_actor_free, pool_view, pool_raw, Pool } = std.concurrent.pool
{ println } = std.text.fmt
NACT := 256    // runnable actors (>> rqcap)
RQCAP := 4    // deliberately tiny initial run-queue capacity
WORKERS := 1    // one consumer, so pushes outpace pops
ITERS := 20
processed := malloc(8)
spin = (n: i64, s: i64) i64 { (n <= 0).match ({ true => s, false => spin(n - 1, s + n) }) }
// each message costs a little work, keeping the lone worker busy while the queue fills.
behave = (user: RawPtr<u8>, msg: i64) void {
    junk := spin(400, 0)
    (junk >= 0).match ({ true => {
        atomic_add_i64(user, 1)
    }, false => { } })
}
spawn_actors = (acts: RawPtr<u8>, i: i64) void {
    (i < NACT).match ({ true => {
        acts.offset(i * 8).store_i64(pool_spawn(processed, 8, behave))
        spawn_actors(acts, i + 1)
    }, false => { } })
}
// send ONE message to every actor: all NACT become runnable near-simultaneously.
send_all = (p: MutPtr<Pool>, acts: RawPtr<u8>, i: i64, ok: i64) i64 {
    (i >= NACT).match ({ true => ok, false => {
        a := acts.offset(i * 8).load_i64().offset(0)
        sent := p.pool_send(a, 1)
        send_all(p, acts, i + 1, sent.match ({ true => ok + 1, false => ok }))
    } })
}
free_actors = (acts: RawPtr<u8>, i: i64) void {
    (i < NACT).match ({ true => {
        pool_actor_free(acts.offset(i * 8).load_i64().offset(0))
        free_actors(acts, i + 1)
    }, false => { } })
}
// one overflow iteration: returns 1 on pass (exactly-once), 0 on fail.
iteration = () i64 {
    store_i64(processed, 0)
    acts := malloc(NACT * 8)
    spawn_actors(acts, 0)
    p := pool_open(WORKERS, RQCAP)
    sent := send_all(p, acts, 0, 0)
    p.pool_quiesce_stop()
    got := load_i64(processed)
    free_actors(acts, 0)
    p.pool_close()
    free(acts)
    (got == sent).match ({
        true  => (sent == NACT).match ({ true => 1, false => 0 }),
        false => 0,
    })
}
run_iters = (i: i64, passes: i64) i64 { (i >= ITERS).match ({
    true  => passes,
    false => run_iters(i + 1, passes + iteration()),
}) }
main = () i32 {
    passes := run_iters(0, 0)
    println(passes)
    free(processed)
    (passes == ITERS).match ({ true => 42, false => 1 })
}
