// PROBE 5: is the u8/u64 constructor call itself the bug? Compare direct
// println of the call vs storing it, plus i64/i32 constructors.
main = (env: Env) Res<i32, AllocError> {
    println("u8-direct {}", u8(200));
    x = u8(201);
    println("u8-bound {}", x);
    println("i32-direct {}", i32(202));
    y = i32(203);
    println("i32-bound {}", y);
    println("bool {}", true);
    r = Range(0, 3);
    println("range {} {}", r.start, r.end);
    Ok(0);
}
