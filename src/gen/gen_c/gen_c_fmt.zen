// src/gen/gen_c/gen_c_fmt.zen
// `alloc.String("{}/{}.zen", root, name)` — the allocating format door.
//
// `text_string.zen` declares it and writes no body, and says why: "the
// call is expanded where it is written, into this module's empty form
// followed by the same expansion `add` gets". A variadic parameter has
// no C spelling and `{}` is resolved BY THE ARGUMENT'S TYPE, so there is
// nothing a single body could have been — the compiler IS the body, the
// same bargain `Ptr`'s members and `Console.println` strike.
//
// EMITTING THE CALL INSTEAD IS A LINKER ERROR AND NOT A WRONG ANSWER: a
// bodyless declaration defines no symbol. `cc` reported seven of them
// against stage 2, all of them in `zen_build.zen`'s module-path
// resolution — so a compiler that skipped this door could not find its
// own source files.
//
// WHAT IS LEFT HERE IS THE BUFFER, NOT THE FORMAT. This door is the
// empty form followed by exactly the pieces `out.add(fmt, args)`
// writes, so the walk, the writers and the record over the buffer are
// `gen_c_sink.zen`'s and this file makes the String and hands it over.
// It held a second walk once, and two walks drift: that one wrote a
// `str` and reported every other hole, so `alloc.String("point {}", p)`
// was a diagnostic while `out.add("point {}", p)` wrote the point.
//
// WHAT THE TWO DOORS GENUINELY DO NOT SHARE IS THE ERROR, and that is
// why they are still two files. A write answers `Res<(), WriteError>`,
// this answers `Res<String, AllocError>`, and there is no conversion
// between them — see `write_failure_arm`, which is the one point where
// the sets meet.

ExprId, Decl, DeclKind, Function, Call = ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
TyId, TyRes = sema.sema_ty
Def, decl_at = sema.sema_def
Ctx = sema.sema_check
Inst = sema.sema_inst
sym_gen, sym_member = gen.gen_name
GenFault = gen.gen_diag
CBackend = gen.gen_c.gen_c_state
unsupported = gen.gen_c.gen_c_state
expr = gen.gen_c.gen_c_expr
declare_temp = gen.gen_c.gen_c_flow
signature_of = gen.gen_c.gen_c_call
write_assign_err = gen.gen_c.gen_c_cap
is_sink_door, lower_sink_door, bodyless = gen.gen_c.gen_c_sink
last_is_variadic, call_symbol, lower_pieces_into = gen.gen_c.gen_c_sink
write_jump_unless_ok, write_goto, write_label = gen.gen_c.gen_c_sink

// -----------------------------------------------------------------
// recognising the door
// -----------------------------------------------------------------

// THE TWO FORMAT DOORS, asked as one question because `gen_c_call.zen`
// asks it once. `alloc.String(fmt, args)` is this file's; `out.add(fmt,
// args)` is `gen_c_sink.zen`'s, and they are separate files because
// they carry a failure differently — see that file's head.
is_format_door* = (be: CBackend, d: Def, f: Function) bool {
    is_alloc_door(be, d, f) || is_sink_door(be, d, f)
}

// The bodyless `String(a: Alloc, fmt: str, args: ...)` and nothing
// else. Asked of the DECLARATION rather than of the name: a module's
// own three-parameter `String` with a body is an ordinary function and
// is called like one.
is_alloc_door = (be: CBackend, d: Def, f: Function) bool {
    d.name.eq("String") && bodyless(f) && (f.params.len == 3)
        && last_is_variadic(be, f)
}

// -----------------------------------------------------------------
// the expansion
// -----------------------------------------------------------------

lower_format_door* = (be :: CBackend, id: ExprId, c: Call, d: Def,
                      f: Function, recv: Res<ExprId>, ctx: Ctx,
                      out :: String) Res<(), AllocError> {
    is_sink_door(be, d, f).match({
        true  => lower_sink_door(be, id, c, d, f, recv, ctx, out),
        false => lower_alloc_door(be, id, c, d, f, recv, ctx, out),
    })
}

// A temporary at the call's own return type, filled by the empty form
// and then written into, and a label every failing write jumps to. The
// temporary IS the answer: `add_bytes` writes the `Ok` payload in
// place, so there is no second buffer to copy out of.
lower_alloc_door = (be :: CBackend, id: ExprId, c: Call, d: Def,
                    f: Function, recv: Res<ExprId>, ctx: Ctx,
                    out :: String) Res<(), AllocError> {
    empty_form(be, d).try().match({
        None  => unsupported(be, id, "a format door with no empty form", out),
        Ok(e) => lower_with_empty(be, id, c, d, f, e, recv, ctx, out),
    })
}

// The one-parameter `String` beside the door, in the door's OWN module.
// Reached by declaration and not through the caller's imports, because
// the expansion is the backend's: a caller that wrote
// `alloc.String("{}", x)` never named the empty form and must not have
// to import it.
empty_form = (be :: CBackend, d: Def) Res<Res<Def>, AllocError> {
    found ::= be.alloc.Vec<Def>();
    be.check.world.defs_of(d.id.module.to_usize(), "String", found).try();
    kept ::= be.alloc.Vec<Def>();
    found.loop((h, x) { keep_empty(be, x, kept).try() });
    Ok(kept.get(0));
}

keep_empty = (be :: CBackend, x: Def, out :: Vec<Def>)
             Res<(), AllocError> {
    decl_at(be.tree, x.id).match({
        None    => Ok(()),
        Ok(dec) => keep_empty_decl(dec, x, out),
    })
}

keep_empty_decl = (dec: Decl, x: Def, out :: Vec<Def>)
                  Res<(), AllocError> {
    dec.kind.match({
        Function(fn) => keep_one_param(fn, x, out),
        _            => Ok(()),
    })
}

keep_one_param = (fn: Function, x: Def, out :: Vec<Def>)
                 Res<(), AllocError> {
    ((fn.params.len == 1) && (bodyless(fn) == false)).match({
        false => Ok(()),
        true  => out.add(x),
    })
}

lower_with_empty = (be :: CBackend, id: ExprId, c: Call, d: Def,
                    f: Function, e: Def, recv: Res<ExprId>, ctx: Ctx,
                    out :: String) Res<(), AllocError> {
    ret = door_return(be, d, f).try();
    be.check.types.at(ret).match({
        Res(r) => write_door(be, id, c, d, e, r, ret, recv, ctx, out),
        _      => unsupported(be, id, "a format door that does not return a Res", out),
    })
}

// The door's declared return type, read in its own module. It names no
// type parameter, so there is nothing to substitute.
door_return = (be :: CBackend, d: Def, f: Function) Res<TyId, AllocError> {
    dctx = Ctx(module: d.id.module.to_usize(), ret: TyId(index: 0),
               has_ret: false, self_ty: TyId(index: 0), has_self: false);
    f.ret.match({
        Ok(t) => be.check.type_from_ast(t, dctx),
        None  => be.check.types.unknown(),
    })
}

write_door = (be :: CBackend, id: ExprId, c: Call, d: Def, e: Def,
              r: TyRes, ret: TyId, recv: Res<ExprId>, ctx: Ctx,
              out :: String) Res<(), AllocError> {
    tmp ::= be.alloc.String().try();
    sym_gen(tmp, "t", be.next_tmp()).try();
    declare_temp(be, ret, tmp.view()).try();
    done = be.next_tmp();
    write_empty_call(be, e, ret, c, recv, ctx, tmp.view()).try();
    write_jump_unless_ok(be, tmp.view(), done).try();
    write_buffer_pieces(be, id, c, r, ret, tmp.view(), done, recv, ctx).try();
    write_label(be, done).try();
    out.add_bytes(tmp.view())
}

// Argument zero of the SIGNATURE: the receiver when the call was
// written `alloc.String(..)`, and the first written argument when it
// was written `String(alloc, ..)`. The same shift `write_call` makes.
alloc_arg = (c: Call, recv: Res<ExprId>) Res<ExprId> {
    recv.match({
        Ok(x) => Ok(x),
        None  => arg_at(c, 0),
    })
}

arg_at = (c: Call, i: usize) Res<ExprId> {
    c.args.get(i).match({ Ok(a) => Ok(a.value), None => None })
}

// `zg_tN = <empty>(<alloc>);`
write_empty_call = (be :: CBackend, e: Def, ret: TyId, c: Call,
                    recv: Res<ExprId>, ctx: Ctx, tmp: str)
                   Res<(), AllocError> {
    line ::= be.alloc.String().try();
    line.add_bytes(tmp).try();
    line.add_bytes(" = ").try();
    call_symbol(be, e, line).try();
    line.add_bytes("(").try();
    alloc_arg(c, recv).match({
        None  => Ok(()),
        Ok(a) => write_alloc(be, e, a, ctx, line),
    }).try();
    line.add_bytes(");").try();
    be.writeln(line.view())
}

write_alloc = (be :: CBackend, e: Def, a: ExprId, ctx: Ctx, out :: String)
              Res<(), AllocError> {
    sig ::= be.alloc.Vec<TyId>();
    inst ::= be.alloc.Inst();
    signature_of(be, e, inst, sig).try();
    unknown = be.check.types.unknown().try();
    want = sig.get(0).match({ Ok(t) => t, None => unknown });
    expr(be, a, ctx, want, out)
}

// -----------------------------------------------------------------
// the pieces
//
// NOT WALKED HERE. `gen_c_sink.zen` walks the format and picks the
// writer for every hole, and this door's buffer IS a Sink, so the
// pieces are that door's with a different sink under them. There were
// two walks once and they drifted exactly as far as their writer sets:
// this one wrote a `str` and reported everything else, so a Point in
// `alloc.String("point {}", p)` was a diagnostic while the same Point
// in `out.add("point {}", p)` was written.
// -----------------------------------------------------------------

write_buffer_pieces = (be :: CBackend, id: ExprId, c: Call, r: TyRes,
                       ret: TyId, tmp: str, done: usize, recv: Res<ExprId>,
                       ctx: Ctx) Res<(), AllocError> {
    addr ::= be.alloc.String().try();
    ok_payload(be, tmp, addr).try();
    fail = be.next_tmp();
    wrote = lower_pieces_into(be, id, c, addr.view(), r.value, fail, recv,
                              ctx).try();
    wrote.match({
        false => be.report_expr(id, GenFault.Unsupported("a format door with no sink")),
        true  => write_failure_arm(be, ret, tmp, fail, done),
    })
}

// `&zg_tN.zg_data.<Ok>` — the String the writes go into, taken by
// address because a sink record holds a pointer to its receiver.
ok_payload = (be :: CBackend, tmp: str, out :: String)
             Res<(), AllocError> {
    out.add_bytes("&(").try();
    out.add_bytes(tmp).try();
    out.add_bytes(".zg_data.").try();
    out.sym_member("Ok").try();
    out.add_bytes(")").try();
    Ok(());
}

// `goto done; fail: ; zg_tN = Err(OutOfMemory);`
//
// THE TWO ERROR SETS MEET HERE AND NOWHERE ELSE. Every write reachable
// from a `{}` answers `Res<(), WriteError>` and this door answers
// `Res<String, AllocError>`; DESIGN.md has no conversion between them,
// because the sets are not nested and narrowing does not exist. So the
// reason is NAMED rather than carried: the one thing that can go wrong
// writing into a String this door made a line ago is that it could not
// GROW, and `OutOfMemory` is exactly that — `AllocError` has that one
// variant and it is exact. The bootstrapper names it the same way and
// says so at `full_of`.
//
// WIDENING THE DOOR'S DECLARED ERROR IS NOT THE ALTERNATIVE: 112
// corpus mains return `Res<i32, AllocError>` and call this, so a door
// answering `WriteError` would need a narrowing at every one of them.
//
// THE CONVERSION SITS ON THE FAILING PATH ONLY. A succeeding walk
// jumps over it, so nothing tests a value that is `Ok` by
// construction, and the door's own answer is left where it already is.
write_failure_arm = (be :: CBackend, ret: TyId, tmp: str, fail: usize,
                     done: usize) Res<(), AllocError> {
    write_goto(be, done).try();
    write_label(be, fail).try();
    write_assign_err(be, ret, "OutOfMemory", tmp)
}

