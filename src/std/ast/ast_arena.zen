// src/std/ast/ast_arena.zen
// Where nodes live.
//
// One `Ast` per compilation. It owns four arenas — expressions, types,
// patterns and blocks — plus the modules and every piece of trivia in
// source order, and it is the only thing that turns an id back into a
// node.
//
// Declarations, members, arms, arguments, parameters, variants and
// statements are NOT arenas: each is held by value inside its parent's
// `Vec`, since none of them closes a cycle. Only the four families
// below are mutually recursive.
//
// Everything here allocates through one `Alloc`. The AST is the
// longest-lived thing the compiler builds, so dropping its arena frees
// the whole tree at once — the trade an arena exists to make.

Alloc, AllocError, Ptr, null_ptr = std.mem
str = std.text
Range = std.core
Trivia, TriviaRun = std.ast.ast_span
ExprId, TypeId, PatternId, BlockId, CBindingId = std.ast.ast_id
Expr, Type, Pattern, Block, Module = std.ast.ast_node
ModuleOrigin, CBinding = std.ast.ast_node
CTypeBinding = std.ast.ast_node

NODE_PAGE: usize = 256

// Append-only storage for id-addressed nodes. A Vec copies its entire old
// capacity whenever it grows; an AST never needs that contiguous layout.
NodeArena<T> = {
    pages :: Vec<Ptr<T>>,
    len :: usize = 0,
    alloc: Alloc,

    add = (self :: @Self, value: T) Res<(), AllocError> {
        slot = self.len % NODE_PAGE;
        (slot == 0).then(() {
            page = self.alloc.realloc(null_ptr<T>(), NODE_PAGE).try();
            self.pages.add(page).try();
        });
        page = self.pages.get(self.len / NODE_PAGE)
            .ok_or(AllocError.OutOfMemory).try();
        page.write(slot, value);
        self.len = self.len + 1;
        Ok(())
    }

    at = (self: @Self, i: usize) T {
        self.pages.ptr().read(i / NODE_PAGE).read(i % NODE_PAGE)
    }
}

NodeArena = <T>(a: Alloc) NodeArena<T> {
    NodeArena(pages: a.Vec<Ptr<T>>(), alloc: a)
}

Ast* = {
    modules :: Vec<Module>,
    module_origins :: Vec<ModuleOrigin>,
    c_bindings :: Vec<CBinding>,
    exprs :: NodeArena<Expr>,
    types :: NodeArena<Type>,
    patterns :: NodeArena<Pattern>,
    blocks :: NodeArena<Block>,

    // every comment and blank in the compilation, in source order. A
    // node names a contiguous run of it rather than owning a list, and
    // the formatter can walk this to prove it dropped nothing.
    trivia :: Vec<Trivia>,

    // An id is a u32 (ast_id.zen says why); a Vec's len is a usize,
    // and std.core.num deliberately has no narrowing conversion
    // between them since one can fail. So the count is kept as the id
    // it will become — `add_expr` keeps counter and arena equal.
    expr_count :: u32 = 0,
    type_count :: u32 = 0,
    pattern_count :: u32 = 0,
    block_count :: u32 = 0,
    c_binding_count :: u32 = 0,

    alloc: Alloc,

    // -----------------------------------------------------------------
    // adding
    //
    // A node is added once and never mutated: an id stays pointing at
    // the same node forever, making it a legal memoized-query key. A
    // transformation builds a new node and gets a new id.
    // -----------------------------------------------------------------

    add_expr* = (self :: @Self, node: Expr) Res<ExprId, AllocError> {
        id = ExprId(index: self.expr_count);
        self.exprs.add(node).try();
        self.expr_count = self.expr_count + 1;
        Ok(id);
    }

    add_type* = (self :: @Self, node: Type) Res<TypeId, AllocError> {
        id = TypeId(index: self.type_count);
        self.types.add(node).try();
        self.type_count = self.type_count + 1;
        Ok(id);
    }

    add_pattern* = (self :: @Self, node: Pattern) Res<PatternId, AllocError> {
        id = PatternId(index: self.pattern_count);
        self.patterns.add(node).try();
        self.pattern_count = self.pattern_count + 1;
        Ok(id);
    }

    add_block* = (self :: @Self, node: Block) Res<BlockId, AllocError> {
        id = BlockId(index: self.block_count);
        self.blocks.add(node).try();
        self.block_count = self.block_count + 1;
        Ok(id);
    }

    add_module* = (self :: @Self, node: Module) Res<(), AllocError> {
        self.modules.reserve(1).try();
        self.module_origins.reserve(1).try();
        self.module_origins.add(ModuleOrigin.Source).try();
        self.modules.add(node)
    }

    // A C import is a module, not an attribute on each declaration. The
    // loader supplies its headers once and every bodyless declaration in
    // the module shares that origin.
    add_c_module* = (self :: @Self, node: Module, binding: CBinding)
                    Res<CBindingId, AllocError> {
        id = CBindingId(index: self.c_binding_count);
        self.modules.reserve(1).try();
        self.module_origins.reserve(1).try();
        self.c_bindings.reserve(1).try();
        self.c_bindings.add(binding).try();
        self.module_origins.add(ModuleOrigin.CBinding(id)).try();
        self.modules.add(node).try();
        self.c_binding_count = self.c_binding_count + 1;
        Ok(id)
    }

    // -----------------------------------------------------------------
    // reading
    //
    // These TRAP rather than returning `Res`: an id past the end of
    // its arena is a compiler bug, not input a caller can act on, and
    // routing it through `Res` would put `.try()` on every child
    // access and bury the signal that makes `.try()` readable.
    //
    // The explicit compare exists because an earlier version let the
    // subtraction underflow and trap on its own — it printed only
    // `trap: integer overflow` at a line in this file, naming neither
    // the id nor the cause, costing an afternoon to trace. `stale` is
    // what the compare buys, for the price of one free-beside-the-copy
    // length check.
    // -----------------------------------------------------------------

    expr_at* = (self: @Self, id: ExprId) Expr {
        i = id.index.to_usize();
        (i < self.exprs.len).match({
            true  => (),
            false => stale("expression", i, self.exprs.len),
        });
        self.exprs.at(i);
    }

    type_at* = (self: @Self, id: TypeId) Type {
        i = id.index.to_usize();
        (i < self.types.len).match({
            true  => (),
            false => stale("type", i, self.types.len),
        });
        self.types.at(i);
    }

    pattern_at* = (self: @Self, id: PatternId) Pattern {
        i = id.index.to_usize();
        (i < self.patterns.len).match({
            true  => (),
            false => stale("pattern", i, self.patterns.len),
        });
        self.patterns.at(i);
    }

    block_at* = (self: @Self, id: BlockId) Block {
        i = id.index.to_usize();
        (i < self.blocks.len).match({
            true  => (),
            false => stale("block", i, self.blocks.len),
        });
        self.blocks.at(i);
    }

    module_count* = (self: @Self) usize { self.modules.len }

    module_at* = (self: @Self, i: usize) Res<Module> { self.modules.get(i) }

    module_origin_at* = (self: @Self, i: usize) Res<ModuleOrigin> {
        self.module_origins.get(i)
    }

    c_binding_at* = (self: @Self, id: CBindingId) Res<CBinding> {
        self.c_bindings.get(id.index.to_usize())
    }

    c_type_at* = (self: @Self, module: u32, decl: u32) Res<CTypeBinding> {
        self.module_origin_at(module.to_usize()).match({
            Ok(ModuleOrigin.CBinding(id)) => self.c_binding_at(id).match({
                Ok(binding) => c_type_in(binding, decl),
                None        => None,
            }),
            _                             => None,
        })
    }

    // How many ids each arena has handed out. A consumer with a
    // POSITION rather than a root has no tree to walk — `ast_find.zen`
    // scans instead, and a scan needs an end.
    expr_ids* = (self: @Self) usize { self.exprs.len }
    type_ids* = (self: @Self) usize { self.types.len }
    pattern_ids* = (self: @Self) usize { self.patterns.len }
    block_ids* = (self: @Self) usize { self.blocks.len }

    // The same question for trivia: how many pieces the compilation
    // holds. The walk that audits ownership sums what the tree's runs
    // name and compares against this — a piece no run names is a
    // comment the parser dropped, which is invisible to every
    // consumer that only reads runs (fmt.zen's round trip included).
    trivia_count* = (self: @Self) usize { self.trivia.len }

    // -----------------------------------------------------------------
    // scanning
    //
    // The fold a position-holding consumer (ast_find.zen, ast_named.zen)
    // writes over every node of one family. ONE HELPER PER FAMILY, not
    // one generic: the four id types are distinct on purpose
    // (ast_id.zen), so nothing generic can span them. The id steps by
    // hand beside `Range.loop` because the loop's index is a usize, an
    // id is a u32, and there is deliberately no narrowing conversion
    // between them (the count fields above say why).
    // -----------------------------------------------------------------

    exprs_each* = (self: @Self, body: (id: ExprId, node: Expr) ()) () {
        id ::= ExprId(index: 0);
        Range(0, self.exprs.len).loop((h, i) {
            body(id, self.expr_at(id));
            id = ExprId(index: id.index + 1);
        });
    }

    types_each* = (self: @Self, body: (id: TypeId, node: Type) ()) () {
        id ::= TypeId(index: 0);
        Range(0, self.types.len).loop((h, i) {
            body(id, self.type_at(id));
            id = TypeId(index: id.index + 1);
        });
    }

    // The ids of the type nodes a predicate keeps. Beside `types_each`
    // rather than written over it: a rule about a type's POSITION has to
    // collect the ids and then go looking, and `types_each`'s body
    // answers `()`, so it can neither allocate nor fail.
    // `sema_vararg.zen` is the consumer and says what it is looking for.
    types_where* = (self: @Self, keep: (node: Type) bool, out :: Vec<TypeId>)
                   Res<(), AllocError> {
        id ::= TypeId(index: 0);
        Range(0, self.types.len).loop((h, i) {
            keep(self.type_at(id)).then(() { out.add(id).try() });
            id = TypeId(index: id.index + 1);
        });
        Ok(());
    }

    patterns_each* = (self: @Self, body: (id: PatternId, node: Pattern) ()) () {
        id ::= PatternId(index: 0);
        Range(0, self.patterns.len).loop((h, i) {
            body(id, self.pattern_at(id));
            id = PatternId(index: id.index + 1);
        });
    }

    blocks_each* = (self: @Self, body: (id: BlockId, node: Block) ()) () {
        id ::= BlockId(index: 0);
        Range(0, self.blocks.len).loop((h, i) {
            body(id, self.block_at(id));
            id = BlockId(index: id.index + 1);
        });
    }

    // -----------------------------------------------------------------
    // trivia
    //
    // Four calls because a run must be contiguous: take a `mark`, add
    // every piece the lexer produced, then close the run. A node's
    // leading run is what the lexer gathered before its first token;
    // its trailing run is what followed the last token up to newline.
    // -----------------------------------------------------------------

    trivia_mark* = (self: @Self) usize { self.trivia.len }

    add_trivia* = (self :: @Self, item: Trivia) Res<(), AllocError> {
        self.trivia.add(item)
    }

    trivia_run* = (self: @Self, mark: usize) TriviaRun {
        TriviaRun(at: mark, len: self.trivia.len - mark)
    }

    // `i` is an offset INSIDE the run, so a caller never sees an
    // absolute index. Out of range traps, like the node readers — and
    // with the same two-sided discipline: the offset against the run,
    // then the absolute index against the arena, since a run captured
    // in a stale `Ast` snapshot is the same bug as a stale id.
    trivia_at* = (self: @Self, run: TriviaRun, i: usize) Trivia {
        (i < run.len).match({
            true  => (),
            false => stale("trivia", i, run.len),
        });
        at = run.at + i;
        (at < self.trivia.len).match({
            true  => (),
            false => stale("trivia", at, self.trivia.len),
        });
        self.trivia.ptr().read(at);
    }
}

c_type_in = (binding: CBinding, decl: u32) Res<CTypeBinding> {
    Range(0, binding.types.len).find((i) {
        binding.types.get(i).match({
            Ok(row) => row.match({ Opaque(raw) => raw.decl == decl }),
            None    => false,
        })
    }).match({
        Ok(i) => binding.types.get(i),
        None  => None,
    })
}

// AN ID THE ARENA NEVER HANDED OUT, said in full before the trap fires.
//
// The likely cause is not "off by one": `Ast` is a VALUE and each
// arena is a `Vec` (pointer, length, capacity), so a copy of an `Ast`
// is a SNAPSHOT. `alloc.Checker(tree)` or `alloc.CBackend(tree, c)`
// captures the tree as it stood at that call; a node added afterwards
// exists only in the caller's tree, and its id is past the snapshot's
// arena end. SEMA_BOOTSTRAP_FIXES.md §12: the engine is a query over a
// FINISHED tree.
//
// Returns `()` but never does — the final subtraction underflows and
// traps, after this has already printed the reason.
stale = (what: str, index: usize, len: usize) () {
    println(
        "ast: {} id {} is past the end of an arena holding {}",
        what,
        index,
        len
    );
    println(
        "  an Ast is a value, so a copy of one is a snapshot: a node added after"
    );
    println(
        "  alloc.Checker(tree) or alloc.CBackend(tree, c) is not in the tree they hold"
    );
    len - len - 1;
}

// `alloc.Ast()` — a ufcs constructor, like `Vec` and `Map`. Returns a
// bare value, not a `Res`: an empty arena owns no pages, so
// construction cannot fail; the first `add_` is what can.
Ast* = (a: Alloc) Ast {
    Ast(
        modules: a.Vec<Module>(),
        module_origins: a.Vec<ModuleOrigin>(),
        c_bindings: a.Vec<CBinding>(),
        exprs: a.NodeArena<Expr>(),
        types: a.NodeArena<Type>(),
        patterns: a.NodeArena<Pattern>(),
        blocks: a.NodeArena<Block>(),
        trivia: a.Vec<Trivia>(),
        alloc: a,
    )
}
