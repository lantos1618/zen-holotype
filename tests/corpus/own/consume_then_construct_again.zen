// after a move the name is dead, and that is all that is dead. there
// is no Clone trait: want a second one, construct a second one.
//
// this is the accept side of copy_drop_without_consume.zen. two Bufs
// exist here, two drops run, and nothing is copied.

Buf = {
    id: i32,
}

Buf.impl(Drop, {
    drop = (self :: @Self) () { /* nothing to release: id is bytes */ }
})

main = (env: Env) Res<i32, IoError> {
    f = Buf(id: 1);
    g = consume f;
    again = Buf(id: 2);
    println("{}", g.id);
    println("{}", again.id);
    Ok(0);
}
