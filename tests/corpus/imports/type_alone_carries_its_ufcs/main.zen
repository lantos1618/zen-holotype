// Importing a TYPE pulls its world along: `describe` has no import
// line of its own, yet `b.describe()` resolves -- UFCS is answered
// from the receiver's type's module, not from this file's names.
// DESIGN.md: "x.f(..) never names f".
//
// The trap is a decoy. ball.zen declares its own `describe` taking a
// Ball, and Ball IS imported here -- so an importer that puts the
// importing file's bare names in front of the receiver's own members
// binds the wrong function and prints 4000 instead of 300: plausible,
// typed, and wrong.
//
// One-line breaker: resolve `b.describe()` in the importing file's
// scope before (or instead of) the receiver's type -> 4000.

Box = box.box
Ball = ball.ball

main = (env: Env) Res<i32, IoError> {
    b = Box(label: 3);
    println("{}", b.describe());
    Ok(0);
}
