// Vec and Map both declare `get`, and both are live in one program.
// each call is answered by the receiver's own -- a Vec index is a
// usize, a Map key is whatever K is, and the two never meet.

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();

    v ::= alloc.Vec<str>();
    v.add("ada").try();

    m ::= alloc.Map<str, i32>();
    m.set("ada", 1815).try();

    v.get(0).match({ Ok(s) => println("{}", s), None => println("no name") });
    m.get("ada").match({ Ok(y) => println("{}", y), None => println("no year") });
    v.get(9).match({ Ok(s) => println("{}", s), None => println("no name") });
    m.get("bob").match({ Ok(y) => println("{}", y), None => println("no year") });
    Ok(0);
}
