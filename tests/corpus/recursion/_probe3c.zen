Link = {
    value: i64,
    next: Ptr<Link>,
}

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    cell ::= alloc.create<Link>().try();
    cell.write(0, Link(value: 77, next: null_ptr<Link>()));
    got ::= cell.read(0);
    println("{}", got.value);
    println("{}", got.next.is_null().match({ true => 1, false => 0 }));
    Ok(0);
}
