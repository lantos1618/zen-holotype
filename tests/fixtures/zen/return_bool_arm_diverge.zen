{ Result, IoError, err } = std.core.result
g = (ok: i32) Result<i32, IoError> { (ok == 1).match ({ true => .Ok(5), false => .Err(.NotFound) }) }
f = (ok: i32) Result<i32, IoError> {
    v := (ok == 9).match ({ true => {
        return err(IoError.Denied)
    }, false => 7 })
    w := g(ok).match ({
        .Err(e) => {
            return err(e)
        },
        _       => 30,
    })
    .Ok(v + w)
}
main = () i32 {
    a := f(1).match ({
        .Ok(v)  => v,
        .Err(e) => 0,
    })    // 37
    b := f(9).match ({
        .Ok(v)  => 0,
        .Err(e) => 1,
    })    // 1
    c := f(0).match ({
        .Ok(v)  => 0,
        .Err(e) => 2,
    })    // 2
    a + b + c
}    // 40
