// tests/corpus/std/loop_find_returns_first.zen
// find is the loop word that deletes a guard: it stops at the
// FIRST match, so the answer is 6 and not 9

main = (env: Env) Res<i32, AllocError> {
    Range(0, 10).find((value) {
        value > 5
    }).match({
        Ok(n) => println("found {}", n),
        None  => println("none"),
    });
    Ok(0);
}
