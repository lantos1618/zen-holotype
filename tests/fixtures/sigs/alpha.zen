// tests/fixtures/sigs/alpha.zen — tiny module for the tools/sigs.zen harness case (parsed, never
// compiled): a global, an enum with a default constant, a tuple-payload variant, a struct, an
// exported fn and a private one.
MAX_SLOTS = 4
Color*: Red | Green | Blue = 2
Pair*: At(i32, i32) | Nothing
Point*: {
    x: i64,
    y: i64,
}
len2* = (p: Point) i64 { p.x * p.x + p.y * p.y }
scale = (p: Point, k: i64) Point {
    Point(
        x: p.x * k,
        y: p.y * k,
    )
}
