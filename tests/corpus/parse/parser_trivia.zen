// tests/corpus/parse/parser_trivia.zen
// Comments survive the parse, and land on the right node.
//
// "Trivia — comments and whitespace — is attached to nodes, not
// discarded. Then the formatter is `parse |> print` and can never
// disagree with the compiler about what the language is." Stage 2 is
// exactly that round trip, so anything the parser throws away here is
// a formatter bug being written today.
//
// The five placements TESTING.md names are all in the file below:
// before a declaration, after one, inside a match arm, between arms,
// and at end of file. AST_CONTRACT.md fixes who owns each:
//
//   LEADING  the outermost node beginning at that token — so the
//            comment above `Point` belongs to the DECLARATION, not to
//            its name and not to the module
//   TRAILING the outermost node whose span ends before it on that line
//   EOF      Module.trailing, which has nowhere else to go
//
// The source these tokens stand for:
//
//   1  // before the declaration
//   2  Point = {
//   3      x: i32,  // after the field
//   4  }
//   5
//   6  name = (s: Shape) str {
//   7      s.match({
//   8          // between the arms
//   9          Circle => "c",  // after an arm
//  10          Square => "s",
//  11      });
//  12  }
//  13  // at end of file

Token, TokenKind = parse.parse_token
Parser = parse.parser
module = parse.parse_decl
Ast = ast.ast_arena
Span, Pos, TriviaRun = ast.ast_span
Decl, Block, Module = ast.ast_node
ExprId = ast.ast_id

at = (k: TokenKind, t: str, line: usize, col: usize, width: usize) Token {
    Token(
        kind: k,
        text: t,
        span: Span(
            file: "t.zen",
            start: Pos(line: line, col: col),
            end: Pos(line: line, col: col + width),
        ),
    )
}

push = (ts :: Vec<Token>, k: TokenKind, t: str, line: usize, col: usize, width: usize) Res<(), AllocError> {
    ts.add(at(k, t, line, col, width))
}

// Every piece of a run, in order. A count alone would pass while the
// parser attached the wrong comment, which is the failure this test
// exists to catch.
show_run = (env: Env, tree: Ast, label: str, run: TriviaRun) () {
    println("{} {}", label, run.len);
    Range(0, run.len).loop((h, i) {
        t = tree.trivia_at(run, i);
        t.kind.match({
            LineComment  => println("  line {} {}", t.span.start.line, t.text),
            BlockComment => println("  block {} {}", t.span.start.line, t.text),
            Blank        => println("  blank {}", t.span.start.line),
        });
    });
}

show_members = (env: Env, tree: Ast, d: Decl) () {
    d.kind.match({
        Struct(s) => s.members.loop((h, mem) {
            show_run(env, tree, "member.leading", mem.leading);
            show_run(env, tree, "member.trailing", mem.trailing);
        }),
        _         => println("not a struct"),
    });
}

show_arms = (env: Env, tree: Ast, d: Decl) () {
    d.kind.match({
        Function(f) => f.body.match({
            Ok(b) => show_arms_in(env, tree, tree.block_at(b)),
            None  => println("no body"),
        }),
        _           => println("not a function"),
    });
}

show_arms_in = (env: Env, tree: Ast, b: Block) () {
    b.stmts.loop((h, s) {
        s.kind.match({
            Expr(es) => show_arms_of(env, tree, es.expr),
            _        => println("not an expression statement"),
        });
    });
}

show_arms_of = (env: Env, tree: Ast, id: ExprId) () {
    tree.expr_at(id).kind.match({
        Match(mt) => mt.arms.loop((h, a) {
            show_run(env, tree, "arm.leading", a.leading);
            show_run(env, tree, "arm.trailing", a.trailing);
        }),
        _         => println("not a match"),
    });
}

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    ts ::= alloc.Vec<Token>();

    ts.push(TokenKind.LineComment, "// before the declaration", 1, 1, 25).try();
    ts.push(TokenKind.Ident, "Point", 2, 1, 5).try();
    ts.push(TokenKind.Eq, "=", 2, 7, 1).try();
    ts.push(TokenKind.LBrace, "{", 2, 9, 1).try();
    ts.push(TokenKind.Ident, "x", 3, 5, 1).try();
    ts.push(TokenKind.Colon, ":", 3, 6, 1).try();
    ts.push(TokenKind.Ident, "i32", 3, 8, 3).try();
    ts.push(TokenKind.Comma, ",", 3, 11, 1).try();
    ts.push(TokenKind.LineComment, "// after the field", 3, 14, 18).try();
    ts.push(TokenKind.RBrace, "}", 4, 1, 1).try();
    ts.push(TokenKind.Blank, "", 5, 1, 0).try();

    ts.push(TokenKind.Ident, "name", 6, 1, 4).try();
    ts.push(TokenKind.Eq, "=", 6, 6, 1).try();
    ts.push(TokenKind.LParen, "(", 6, 8, 1).try();
    ts.push(TokenKind.Ident, "s", 6, 9, 1).try();
    ts.push(TokenKind.Colon, ":", 6, 10, 1).try();
    ts.push(TokenKind.Ident, "Shape", 6, 12, 5).try();
    ts.push(TokenKind.RParen, ")", 6, 17, 1).try();
    ts.push(TokenKind.Ident, "str", 6, 19, 3).try();
    ts.push(TokenKind.LBrace, "{", 6, 23, 1).try();

    ts.push(TokenKind.Ident, "s", 7, 5, 1).try();
    ts.push(TokenKind.Dot, ".", 7, 6, 1).try();
    ts.push(TokenKind.Ident, "match", 7, 7, 5).try();
    ts.push(TokenKind.LParen, "(", 7, 12, 1).try();
    ts.push(TokenKind.LBrace, "{", 7, 13, 1).try();

    ts.push(TokenKind.LineComment, "// between the arms", 8, 9, 19).try();
    ts.push(TokenKind.Ident, "Circle", 9, 9, 6).try();
    ts.push(TokenKind.FatArrow, "=>", 9, 16, 2).try();
    ts.push(TokenKind.Str, "\"c\"", 9, 19, 3).try();
    ts.push(TokenKind.Comma, ",", 9, 22, 1).try();
    ts.push(TokenKind.LineComment, "// after an arm", 9, 25, 15).try();

    ts.push(TokenKind.Ident, "Square", 10, 9, 6).try();
    ts.push(TokenKind.FatArrow, "=>", 10, 16, 2).try();
    ts.push(TokenKind.Str, "\"s\"", 10, 19, 3).try();
    ts.push(TokenKind.Comma, ",", 10, 22, 1).try();

    ts.push(TokenKind.RBrace, "}", 11, 5, 1).try();
    ts.push(TokenKind.RParen, ")", 11, 6, 1).try();
    ts.push(TokenKind.Semi, ";", 11, 7, 1).try();
    ts.push(TokenKind.RBrace, "}", 12, 1, 1).try();

    ts.push(TokenKind.LineComment, "// at end of file", 13, 1, 17).try();
    ts.push(TokenKind.Eof, "", 14, 1, 0).try();

    p ::= alloc.Parser(ts, "t.zen");
    m = p.module("t").try();
    println("diags {}", p.diags.len);

    show_run(env, p.tree, "module.leading", m.leading);

    m.decls.get(0).match({
        Ok(d) => {
            show_run(env, p.tree, "decl0.leading", d.leading);
            show_members(env, p.tree, d);
        },
        None  => println("no decl 0"),
    });

    m.decls.get(1).match({
        Ok(d) => show_arms(env, p.tree, d),
        None  => println("no decl 1"),
    });

    show_run(env, p.tree, "module.trailing", m.trailing);
    Ok(0);
}
