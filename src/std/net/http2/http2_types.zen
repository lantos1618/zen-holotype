// src/std/net/http2/http2_types.zen
// Shared HTTP/2 errors, response values, and wire types.

str, String = std.text
Range, Res = std.core
Sink, WriteError = std.core
ActorError = std.actor
Alloc, AllocError = std.mem

H2Error* = ConnectFailed
    | TlsFailed
    | SendFailed
    | RecvFailed
    | DecodeFailed
    | ProtocolFailed
    | Closed
    | Status(i32)

H2Response* = {
    status*: i32,
    body*:   String,
}

// Every variant is value-only and can cross a mailbox without borrowing the
// decoder's arena. Informational responses are visible instead of being
// silently discarded, and trailers need no sentinel status.
H2Head* = Informational(i32) | Response(i32) | Trailers

// A streaming request can fail in the connection or at the receiver mailbox.
H2StreamError* = Http(H2Error) | Receiver(ActorError)

// The frame size every peer must accept; this client never advertises more.
MAX_SEND*: usize = 16384

// DATA is copied into the mailbox itself. Its fixed capacity is HTTP/2's
// default maximum frame size; this client never advertises a larger one.
H2Chunk* = {
    bytes :: [u8, MAX_SEND],
    len*:  usize,

    get* = (self: @Self, at: usize) Res<u8> {
        (at < self.len).match({
            true  => Ok(self.bytes[at]),
            false => None,
        })
    }

    append_to* = (self: @Self, out :: String) Res<(), AllocError> {
        Range(0, self.len).loop((h, i) { out.add(self.bytes[i]).try(); });
        Ok(())
    }

    write_to* = (self: @Self, out :: Sink) Res<(), WriteError> {
        Range(0, self.len).loop((h, i) { out.write_byte(self.bytes[i]).try(); });
        Ok(())
    }

    // Make actor-owned text when a consumer needs a contiguous view. The
    // mailbox value itself remains allocation-free and independently owned.
    copy* = (self: @Self, a: Alloc) Res<String, AllocError> {
        out ::= a.String().try();
        self.append_to(out).try();
        Ok(out);
    }
}

h2_chunk* = (src: str) Res<H2Chunk, H2Error> {
    (src.len <= MAX_SEND).ensure(H2Error.ProtocolFailed).try();
    chunk ::= H2Chunk(bytes: [u8, MAX_SEND](), len: src.len);
    Range(0, src.len).loop((h, i) { chunk.bytes[i] = src[i]; });
    Ok(chunk);
}

// RFC 7540 §6 frame kinds. Zen enums intentionally do not promise a wire
// layout, so conversion is explicit at the frame boundary.
FrameType* = Data
    | Headers
    | Priority
    | Reset
    | Settings
    | Push
    | Ping
    | GoAway
    | WindowUpdate
    | Continuation
    | Unknown(u8)

frame_type* = (raw: u8) FrameType {
    raw.match({
        0 => FrameType.Data,
        1 => FrameType.Headers,
        2 => FrameType.Priority,
        3 => FrameType.Reset,
        4 => FrameType.Settings,
        5 => FrameType.Push,
        6 => FrameType.Ping,
        7 => FrameType.GoAway,
        8 => FrameType.WindowUpdate,
        9 => FrameType.Continuation,
        _ => FrameType.Unknown(raw),
    });
}

wire* = (kind: FrameType) u8 {
    kind.match({
        Data         => 0,
        Headers      => 1,
        Priority     => 2,
        Reset        => 3,
        Settings     => 4,
        Push         => 5,
        Ping         => 6,
        GoAway       => 7,
        WindowUpdate => 8,
        Continuation => 9,
        Unknown(raw) => raw,
    });
}

// flags
FLAG_END_STREAM*:  u8 = 1   // DATA, HEADERS
FLAG_ACK*:         u8 = 1   // SETTINGS, PING
FLAG_END_HEADERS*: u8 = 4   // HEADERS
FLAG_PADDED*:      u8 = 8   // DATA, HEADERS
FLAG_PRIORITY*:    u8 = 32  // HEADERS

SET_HEADER_TABLE*:   usize = 1
SET_INITIAL_WINDOW*: usize = 4

// the receive window we advertise, per stream and once on the connection
WINDOW*: usize = 16777216

// HTTP/2 flow-control windows are signed in effect but capped here.
DEFAULT_WINDOW*: usize = 65535
MAX_WINDOW*: usize = 2147483647

// sanity bound on any inbound frame payload
MAX_RECV*: usize = 1048576

PREFACE*: str = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"
