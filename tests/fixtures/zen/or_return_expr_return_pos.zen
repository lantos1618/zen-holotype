// .or_return() in RETURN and TRAILING-EXPRESSION position. Exit 50 = 6 + 1 + 42 + 1:
// retpos(1)=Ok(6), retpos(0)=Err, trailing(1)=Ok(42), trailing(0)=Err.
{ Result, IoError } = std.core.result
g = (ok: i32) Result<i32, IoError> { (ok == 1).match ({ true => .Ok(4), false => .Err(.NotFound) }) }
wrap = (n: i32) Result<i32, IoError> { .Ok(n + 2) }
retpos = (ok: i32) Result<i32, IoError> {
    return wrap(g(ok).or_return())
}
trailing = (ok: i32) Result<i32, IoError> {
    wrap(g(ok).or_return() * 10)
}
main = () i32 {
    a := retpos(1).match ({
        .Ok(v)  => v,
        .Err(e) => 0,
    })    // 6
    b := retpos(0).match ({
        .Ok(v)  => 0,
        .Err(e) => 1,
    })    // 1
    c := trailing(1).match ({
        .Ok(v)  => v,
        .Err(e) => 0,
    })    // 42
    d := trailing(0).match ({
        .Ok(v)  => 0,
        .Err(e) => 1,
    })    // 1
    a + b + c + d
}
