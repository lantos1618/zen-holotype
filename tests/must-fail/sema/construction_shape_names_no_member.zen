// tests/must-fail/sema/construction_shape_names_no_member.zen
//
// The shape face of the construction-name rule: `check_ctor_shape` runs
// `arg_fits_field` -> `named_arg_fits`, whose member lookup answered None
// -- a name the type declares no member of -- with "nothing to see", and
// whose Ok arm never asks `Found.constant`. It is alive only because
// `construct` refuses every argument through `check_ctor_fields` first;
// this file pins that ordering from the outside. With the gate lifted the
// program compiles, runs, and prints a value nobody wrote.
//
// position: the argument's name.

Cfg = {
    w: i32,
}

main = (env: Env) Res<i32, AllocError> {
    b = Cfg(w: 1, m: 99);
    println("{}", b.w);
    Ok(0);
}
