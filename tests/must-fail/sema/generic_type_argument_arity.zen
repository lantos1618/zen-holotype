// Once an explicit list is written it supplies exactly the declaration's list:
// neither a prefix nor a surplus suffix is a complete instantiation.

first = <T, U>(a: T, b: U) T { a }

main = (env: Env) Res<i32, AllocError> {
    println("{}", first<i32>(1, "one"));
    println("{}", first<i32, str, bool>(1, "one"));
    Ok(0);
}
