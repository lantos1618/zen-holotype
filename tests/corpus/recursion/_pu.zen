// probeU: create in a helper, but receiver from env.mem.alloc() inside the helper
mk = () Res<Ptr<i64>, AllocError> {
    a ::= env.mem.alloc();
    p = a.create<i64>().try();
    p.write(0, 7);
    Ok(p);
}

main = (env: Env) Res<i32, AllocError> {
    p = mk().try();
    println("v {}", p.read(0));
    Ok(0);
}
