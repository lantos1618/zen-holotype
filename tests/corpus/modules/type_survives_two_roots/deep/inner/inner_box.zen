// TWO fields and TWO variants, so a wrong answer has somewhere to show:
// one field cannot catch an offset, and a one-variant enum reads the same
// whether or not the tag survived the hops.
Box*<T> = {
    value*: T,
    seen*: usize,
}

Tick* = Once | Twice

unwrap*<T> = (b: Box<T>) T { b.value }

seen_of*<T> = (b: Box<T>) usize { b.seen }
