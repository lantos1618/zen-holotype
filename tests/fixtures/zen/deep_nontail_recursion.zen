// Deep NON-tail recursion that genuinely CANNOT be turned into a loop: the recursive result `r`
// feeds a branch (`(r < n).match(...)`) before this frame returns, so no sibling-call / accumulator
// transform applies at any -O level — each frame must persist. At depth 100,000,000 that exhausts
// the C stack and raises SIGSEGV. The runtime's SIGSEGV handler (zenrt.c, on a sigaltstack) turns
// that raw crash into the teaching panic `zen: panic: stack overflow (recursion too deep)` and a
// clean exit (code 134, the panic exit code) — NOT a silent `Segmentation fault`.
{ println } = std.text.fmt
depth = (n: i64) i64 {
    (n == 0).match ({
        true  => 0,
        false => {
            r = depth(n - 1)
            (r < n).then({ r + 1 }, { n })
        },
    })
}
main = () i32 {
    println(depth(100000000))
    0
}
