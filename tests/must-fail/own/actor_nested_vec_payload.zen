// A value wrapper must not hide allocator-backed storage from the actor
// transfer check.

VecBox = { bytes: Vec<u8> }
Envelope = { box: VecBox }

Worker = {}

Worker.impl(Actor, {
    process = (self :: @Self, ctx: Context, payload: Envelope) {
        ctx.env.out.println("received")
    }
})

forward = (worker: Ref<Worker>, payload: Envelope) Res<(), ActorError> {
    worker.process(payload).try();
    Ok(())
}

main = (env: Env) Res<i32, AllocError> { Ok(0) }
