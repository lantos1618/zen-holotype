// @self-hosted-only
// compiler.resolve_rename — the namespace/shadow rename, decided on the AST.
//
// A module bound under an alias (`L = lib`) gets its own value decls — and every reference to them —
// prefixed `L__name`, so two modules can export the same short name into Zen's flat C namespace. The
// user-shadow pass (compiler.resolve_shadow) is the same rename under a `zshadow` alias.
//
// The rename used to be a byte rewrite over the module's source, keyed on "identifier that appears in
// the export list". That spelling is shared by things which are NOT value references: a struct-literal
// field label `Box(len: n)`, an enum's variant LIST `E: Some(i64) | None`, a qualified variant
// `E.Some(n)` and a match arm `.Some(v)`. Each of those got prefixed too, so a module whose enum had a
// variant named like one of its own functions checked clean standalone and broke every consumer that
// aliased it — with the diagnostic pointing into the innocent file.
//
// The body is now PARSED and the rename is decided per AST NODE. Only a declared FUNCTION/GLOBAL name
// and a value REFERENCE — `Var`, `Call`, and a UFCS `MethodCall` method — can be renamed. `FieldInit`
// labels, `Field` decls, `Member` field names, `VariantDef` variants and `ArmData` patterns are
// DIFFERENT NODE KINDS: they have no marking site at all, so no guess is involved and no guard is
// needed to compensate for one.
//
// The walk records byte OFFSETS into a mark array and one linear pass splices `alias__` in at exactly
// those offsets. Staying a text substitution is deliberate: the flat program IS text downstream (the
// dedup passes, the shadow passes, and every `file:line:col` that resolves a flat offset back to a
// module's original line), and a marked-offset splice is line-preserving, so diagnostics are untouched.
{ Decl, Expr, Func, MethodCallData, Stmt, VariantDef } = compiler.ast.ast_types
{ expr_fold_children } = compiler.ast.expr_children
{ parse_module } = compiler.parse
{ gstr_string, gstr_finish, is_expr_null, acquire_or_die, acquire_or_die } = compiler.genc
{ Scan, scan } = compiler.lex
{ is_ident_tok } = compiler.parse_postfix
{ Malloc } = std.mem.alloc
{ String } = std.text.string
{ ModuleTable, mimport_name_span, rappend, rappend_span, rappend_string, res_ident_end, rpush,
  seen_name } = compiler.resolve
{ module_graph, str_bytes } = compiler.resolve_scan
{ at, is_alpha } = std.text.ascii
{ view } = std.text.str
{ loop_at } = std.core.count
// ── membership over a newline-delimited name set, compared against a SOURCE span ────────────────
// The rename set is built by the top-level symbol scan, so its entries are source spellings. Asking
// it about the source bytes (never about an AST name) keeps the decl and its references in step even
// where the parser rewrites a name — a C-keyword decl `double` is `double_zk` in the AST.
ren_line_eq = (set: Slice<u8>, i: i64, src: Slice<u8>, p: i64, e: i64) bool {
    (p == e).match ({
        true  => i < set.len && set[i] == '\n',
        false => (i < set.len && set[i] == src[p]).match ({
            true  => set.ren_line_eq(i + 1, src, p + 1, e),
            false => false,
        }),
    })
}
ren_next_line = (set: Slice<u8>, i: i64) i64 {
    (i >= set.len).match ({
        true  => set.len,
        false => (set[i] == '\n').then({ i + 1 }, { set.ren_next_line(i + 1) }),
    })
}
ren_seen = (set: Slice<u8>, src: Slice<u8>, p: i64, e: i64, i: i64) bool {
    (i >= set.len).match ({
        true  => false,
        false => set.ren_line_eq(i, src, p, e).match ({
            true  => true,
            false => set.ren_seen(src, p, e, set.ren_next_line(i)),
        }),
    })
}
// ── closure-wide TYPE names ─────────────────────────────────────────────────────────────────────
// `E.Some(n)` and `x.foo(n)` are the SAME node (a MethodCall with a Var receiver); what separates them
// is whether the receiver names a type. Zen's namespace is flat, so a name that is a type in any loaded
// module is a type here. Stamped once per program, beside the other resolve-entry resets.
ren_no_types = () StringView { "" }
ren_types ::= ren_no_types()
ren_types_set* = (a: MutPtr<Malloc>, table: ModuleTable) void {
    out ::= a.gstr_string(512)
    table.modules.loop_at((i, m) {
        m.graph.symbols.loop_at((j, sym) {
            sym.is_type.then({
                out = out.rappend(a, sym.name).rpush(a, '\n')
            })
        })
    })
    ren_types = out.gstr_finish(a)
}
// ── binder scope ────────────────────────────────────────────────────────────────────────────────
// A name bound by a param, a binding, a loop's index/element/handler, a lambda param or a match arm is a
// LOCAL: it is not this module's decl, so it is never renamed and neither are the references it binds.
// A stack with mark/drop gives real block scoping — a `x = …` shadows only the statements after it.
ren_no_binds = () [StringView] { slice(null_ptr(), 0) }
ren_binds ::= ren_no_binds()
ren_bind_n ::= 0
ren_binds_reset = (a: MutPtr<Malloc>) void {
    ren_binds = slice(a.acquire_or_die(256 * sizeof(StringView)), 256)
    ren_bind_n = 0
}
ren_bind_push = (a: MutPtr<Malloc>, nm: StringView) void {
    (ren_bind_n >= ren_binds.len).then({
        grown :: [StringView] = slice(a.acquire_or_die(ren_binds.len * 2 * sizeof(StringView)), ren_binds.len * 2)
        ren_binds.loop_at((i, v) { grown[i] = v })
        ren_binds = grown
    })
    ren_binds[ren_bind_n] = nm
    ren_bind_n = ren_bind_n + 1
}
ren_bind_mark = () i32 { ren_bind_n }
ren_bind_drop = (m: i32) void { ren_bind_n = m }
ren_bind_has = (nm: StringView) bool {
    found ::= false
    live: [StringView] = slice(ren_binds.ptr, ren_bind_n)
    live.loop((h, i, v) {
        (v == nm).then({
            found = true
            h.break
        })
    })
    found
}
// ── the walk ────────────────────────────────────────────────────────────────────────────────────
// `bound` flips what the walk marks: false = the value decls/references being RENAMED, true = the
// identifiers the binder stack knows are LOCALS (what the qualifier rewrite below needs to know).
RenCtx: {
    marks: [u8],
    sv: StringView,
    src: Slice<u8>,
    names: Slice<u8>,
    bound: bool,
}
// mark the identifier that STARTS at `p` when it is one of the names being renamed.
ren_mark_ref = (c: RenCtx, p: i32) void {
    ms ::= c.marks
    off = to_i64(p)
    (off >= 0 && off < ms.len).then({
        e = to_i64(c.sv.res_ident_end(p))
        c.names.ren_seen(c.src, off, e, 0).then({
            ms[off] = 1
        })
    })
}
// `bound` mode: mark the identifier at `p` unconditionally — the caller already established that the
// binder stack holds its name, which is the whole fact the qualifier rewrite asks for.
ren_mark_local = (c: RenCtx, p: i32) void {
    ms ::= c.marks
    off = to_i64(p)
    (off >= 0 && off < ms.len).then({
        ms[off] = 1
    })
}
ren_is_type_at = (c: RenCtx, p: i32) bool {
    ren_types.view().ren_seen(c.src, to_i64(p), to_i64(c.sv.res_ident_end(p)), 0)
}
ren_recv_is_type = (c: RenCtx, r: Ptr<Expr>) bool {
    r.is_expr_null().match ({
        true  => false,
        false => load(r).match ({
            .Var(v) => v.name.ren_bind_has().then({ false }, { c.ren_is_type_at(v.pos) }),
            _       => false,
        }),
    })
}
// `x.foo(y)` calls this module's `foo` by UFCS and must follow the rename; `E.Some(n)` is a VARIANT
// construction wearing the same node, so a receiver naming a type is never a UFCS receiver.
ren_ufcs = (c: RenCtx, mc: MethodCallData) void {
    (mc.method.ren_bind_has() == false && c.ren_recv_is_type(mc.recv) == false).then({
        c.ren_mark_ref(mc.pos)
    })
}
ren_kids = (c: RenCtx, a: MutPtr<Malloc>, e: Ptr<Expr>) i32 {
    0.expr_fold_children(e, (acc, ch) { c.ren_expr(a, ch) }, (acc, body) { c.ren_stmts(a, body) })
}
ren_expr = (c: RenCtx, a: MutPtr<Malloc>, e: Ptr<Expr>) i32 {
    e.is_expr_null().match ({
        true  => 0,
        false => load(e).match ({
            .Var(v)         => {
                v.name.ren_bind_has().match ({
                    true  => c.bound.then({
                        c.ren_mark_local(v.pos)
                    }),
                    false => c.ren_mark_ref(v.pos),
                })
                0
            },
            .Call(cl)       => {
                (cl.fn.ren_bind_has() == false).then({
                    c.ren_mark_ref(cl.pos)
                })
                c.ren_kids(a, e)
            },
            .MethodCall(mc) => {
                c.ren_ufcs(mc)
                c.ren_kids(a, e)
            },
            .Loop(l)        => {
                c.ren_expr(a, l.seq)
                m = ren_bind_mark()
                a.ren_bind_push(l.idx)
                a.ren_bind_push(l.elem)
                a.ren_bind_push(l.h)
                c.ren_stmts(a, l.body)
                ren_bind_drop(m)
                0
            },
            .Lambda(lm)     => {
                m = ren_bind_mark()
                lm.params.loop_at((i, p) { a.ren_bind_push(p.name) })
                c.ren_stmts(a, lm.body)
                ren_bind_drop(m)
                0
            },
            .Match(mt)      => {
                c.ren_expr(a, mt.subj)
                mt.arms.loop_at((i, ar) {
                    m = ren_bind_mark()
                    a.ren_bind_push(ar.bind)
                    c.ren_expr(a, ar.body)
                    ren_bind_drop(m)
                })
                0
            },
            _               => c.ren_kids(a, e),
        }),
    })
}
ren_stmts = (c: RenCtx, a: MutPtr<Malloc>, body: [Stmt]) i32 {
    m = ren_bind_mark()
    body.loop_at((i, s) { c.ren_stmt(a, s) })
    ren_bind_drop(m)
    0
}
ren_stmt = (c: RenCtx, a: MutPtr<Malloc>, s: Stmt) i32 {
    s.match ({
        .Let(l)      => {
            c.ren_expr(a, l.value)
            a.ren_bind_push(l.name)
            0
        },
        .Assign(g)   => {
            c.ren_expr(a, g.target)
            c.ren_expr(a, g.value)
        },
        .Return(e)   => c.ren_expr(a, e),
        .If(f)       => {
            c.ren_expr(a, f.c)
            c.ren_stmts(a, f.then)
            c.ren_stmts(a, f.els)
        },
        .While(w)    => {
            c.ren_expr(a, w.c)
            c.ren_stmts(a, w.body)
        },
        .IndexSet(x) => {
            c.ren_expr(a, x.seq)
            c.ren_expr(a, x.idx)
            c.ren_expr(a, x.value)
        },
        .ExprStmt(e) => c.ren_expr(a, e),
    })
}
ren_func = (c: RenCtx, a: MutPtr<Malloc>, f: Func) i32 {
    c.ren_mark_ref(f.pos)
    m = ren_bind_mark()
    f.params.loop_at((i, p) { a.ren_bind_push(p.name) })
    c.ren_stmts(a, f.body)
    ren_bind_drop(m)
    0
}
ren_variants = (c: RenCtx, a: MutPtr<Malloc>, vs: [VariantDef]) i32 {
    vs.loop_at((i, v) { c.ren_expr(a, v.dflt) })
    0
}
// A METHOD's name is marked too (an impl/inherent method's Func carries the mangled name at the bare
// method's source position). A method name is not a top-level symbol, but `x.m(y)` may dispatch either
// to a method or to a same-named free fn, so decl and call site have to move together or dispatch
// changes meaning — see ren_ufcs.
ren_decl = (c: RenCtx, a: MutPtr<Malloc>, d: Decl) i32 {
    d.match ({
        .DFunc(f)         => c.ren_func(a, f),
        .DForeign(f)      => c.ren_func(a, f),
        .DTraitDefault(t) => c.ren_func(a, t.fn),
        .DGlobal(g)       => c.ren_expr(a, g.init),
        .DEnum(e)         => c.ren_variants(a, e.variants),
        .DGenEnum(e)      => c.ren_variants(a, e.variants),
        _                 => 0,
    })
}
// splice `alias__` in at the marked identifier starts — the only text edit the rename makes, so every
// byte the walk did not name survives verbatim and no line boundary moves.
ren_apply = (out: String, a: MutPtr<Malloc>, s: StringView, marks: [u8], alias: String) String {
    cur ::= out
    pos :: i32 = 0
    bs: Slice<u8> = s.str_bytes()
    bs.loop_at((i, b) {
        ii = to_i32(i)
        (ii < pos == false).then({
            (marks[i] == 1).match ({
                true  => {
                    ie = s.res_ident_end(pos)
                    cur = cur.rappend_string(a, alias).rappend(a, "__").rappend_span(a, s, pos, ie)
                    pos = ie
                },
                false => {
                    cur = cur.rpush(a, b)
                    pos = pos + 1
                },
            })
        })
    })
    cur
}
ren_marks = (a: MutPtr<Malloc>, n: i64) [u8] {
    ms :: [u8] = slice(a.acquire_or_die(n + 1), n + 1)
    ms.loop_at((i, b) { ms[i] = 0 })
    ms
}
// THE rename: prefix `alias__` onto every occurrence of `names` in module body `s` that is a value
// decl or a value reference. Used both for a namespace alias and for the user-shadow rename.
rename_ns_names* = (
    out: String,
    a: MutPtr<Malloc>,
    s: StringView,
    names: String,
    alias: String,
) String {
    sb: Slice<u8> = s.str_bytes()
    c = RenCtx(
        marks: a.ren_marks(sb.len),
        sv: s,
        src: sb,
        names: names.bytes(),
        bound: false,
    )
    a.module_graph(s).symbols.loop_at((i, sym) {
        (sym.imported == false).then({
            c.ren_mark_ref(sym.start)
        })
    })
    a.ren_binds_reset()
    a.parse_module(s).loop_at((i, d) { c.ren_decl(a, d) })
    out.ren_apply(a, s, c.marks, alias)
}
// ── the namespace-QUALIFIER rewrite ─────────────────────────────────────────────────────────────
// Under a bind `A = mod`, `A.f` resolves three ways: to `A__f` when `f` is a VALUE decl of mod (the
// rename above moved it there), to a bare `f` when `f` is one of mod's TYPES (types keep their flat
// name) or mod is libc, and to itself otherwise. Which one it was used to be decided from the
// SPELLING alone — so a LOCAL named like an alias had its field reads rewritten into references to
// the module's function, silently: `m: S = S(val: 7)` ⨯ `m.val` became `m__val`, the function
// POINTER, and the program returned it instead of the field.
//
// The receiver is now decided on the AST. The walk above, run in `bound` mode, marks every identifier
// the binder stack knows is a variable — a param, a binding, a loop index/element/handler, a lambda
// param, a match-arm binding — and a marked identifier is never a qualifier. Candidate sites come
// from the LEXER, so a comment or a string literal is not a site at all. Application stays a
// marked-offset splice: `A.` and `A__` are the same line, so every `file:line:col` is untouched.
ren_no_names = () [u8] { slice(null_ptr(), 0) }
ns_local_marks = (a: MutPtr<Malloc>, s: StringView) [u8] {
    sb: Slice<u8> = s.str_bytes()
    c = RenCtx(
        marks: a.ren_marks(sb.len),
        sv: s,
        src: sb,
        names: ren_no_names(),
        bound: true,
    )
    a.ren_binds_reset()
    a.parse_module(s).loop_at((i, d) { c.ren_decl(a, d) })
    c.marks
}
qual_name_at = (out: String, a: MutPtr<Malloc>, s: StringView, p: i32, ie: i32) String {
    out.rappend_span(a, s, p, ie).rpush(a, '.').rappend_span(a, s, ie + 1, s.res_ident_end(ie + 1))
}
// what becomes of `A.f`, where `A` spans [p, ie): 0 = leave it alone, 1 = `A__f`, 2 = `f`.
qual_fate = (
    a: MutPtr<Malloc>,
    s: StringView,
    p: i32,
    ie: i32,
    qnames: String,
    strip_qnames: String,
    strip_all_quals: String,
) u8 {
    qn = qual_name_at(a.gstr_string(32), a, s, p, ie)
    qnames.seen_name(qn).match ({
        true  => 1,
        false => (strip_qnames.seen_name(qn)
            || strip_all_quals.seen_name(a.mimport_name_span(s, p, ie))).match ({
            true  => 2,
            false => 0,
        }),
    })
}
// classify ONE token and return where the scan resumes: past a qualifier that stays (nothing inside it
// can start another one), else past the head identifier (`A.f.g` — `f` may head a qualifier too).
qual_mark_tok = (
    a: MutPtr<Malloc>,
    s: StringView,
    sc: Scan,
    ms: [u8],
    locals: [u8],
    quals: String,
    qnames: String,
    strip_qnames: String,
    strip_all_quals: String,
) i32 {
    p = sc.tok.start
    ie = p + sc.tok.len
    (is_ident_tok(sc.tok)
        && locals[to_i64(p)] == 0
        && at(s, ie) == '.'
        && at(s, ie + 1).is_alpha()
        && quals.seen_name(a.mimport_name_span(s, p, ie))).match ({
        true  => {
            f = a.qual_fate(s, p, ie, qnames, strip_qnames, strip_all_quals)
            ms[to_i64(p)] = f
            (f == 0).then({ s.res_ident_end(ie + 1) }, { ie + 1 })
        },
        false => sc.next,
    })
}
qual_marks = (
    a: MutPtr<Malloc>,
    s: StringView,
    quals: String,
    qnames: String,
    strip_qnames: String,
    strip_all_quals: String,
) [u8] {
    locals = a.ns_local_marks(s)
    sb: Slice<u8> = s.str_bytes()
    ms = a.ren_marks(sb.len)
    pos :: i32 = 0
    sb.loop((h, i, b) {
        ii = to_i32(i)
        (ii < pos == false).then({
            sc = s.scan(pos)
            (sc.tok.len == 0).match ({
                true  => {
                    h.break
                },
                false => {
                    pos = a.qual_mark_tok(s, sc, ms, locals, quals, qnames, strip_qnames, strip_all_quals)
                },
            })
        })
    })
    ms
}
qual_apply = (out: String, a: MutPtr<Malloc>, s: StringView, marks: [u8]) String {
    cur ::= out
    pos :: i32 = 0
    bs: Slice<u8> = s.str_bytes()
    bs.loop_at((i, b) {
        ii = to_i32(i)
        (ii < pos == false).then({
            (marks[i] == 0).match ({
                true  => {
                    cur = cur.rpush(a, b)
                    pos = pos + 1
                },
                false => {
                    ie = s.res_ident_end(pos)
                    cur = (marks[i] == 1).match ({
                        true  => cur.rappend_span(a, s, pos, ie).rappend(a, "__"),
                        false => cur,
                    })
                    pos = ie + 1
                },
            })
        })
    })
    cur
}
// THE qualifier rewrite: resolve every `alias.name` in module body `s` against the ns-bind sets.
rewrite_ns_quals* = (
    out: String,
    a: MutPtr<Malloc>,
    s: StringView,
    quals: String,
    qnames: String,
    strip_qnames: String,
    strip_all_quals: String,
) String { out.qual_apply(a, s, a.qual_marks(s, quals, qnames, strip_qnames, strip_all_quals)) }
