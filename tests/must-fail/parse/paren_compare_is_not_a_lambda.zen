// `(i + 1) < f.len` was read as a LAMBDA's parameter list, because the
// lookahead saw `<` after the `)` and `<T>(a: T) T` is a type that
// begins with an angle. One wrong fork then unwound into EIGHT
// diagnostics, all from the same spot -- which is the cascade this
// file's .count bounds.
//
// The program below is genuinely wrong (the `(` is never closed), so
// one diagnostic is correct. What must never happen again is eight.
at = (f: str, i: usize) bool {
    (i + 1 < f.len;
}

main = (env: Env) Res<i32, ArgError> {
    Ok(0);
}
