// src/fmt/fmt_src.zen
// The bytes a module was parsed from, addressable by span.
//
// THE FORMATTER NEEDS ONE THING THE COMPILER NEVER DID: the original
// text of a node it will not rebuild. `ast_span.zen` carries `line:col`
// and drops the lexer's byte offset on purpose (a node outlives its
// Source), so turning a span back into bytes is a line index plus a
// subtraction — which belongs beside the formatter, not on every AST
// node. This is the whole mechanism behind "pass through verbatim".
//
// SPEAKS OFFSETS, NOT SPANS, past `offset` itself: a formatter usually
// asks "what lies between this node and the next thing I print" — two
// positions from two different nodes — which no single `Span` can say.

Alloc, AllocError = std.mem
str = std.text
Vec = std.collections
Range = std.core
Pos = std.ast.ast_span

Src* = {
    text*: str,

    // Byte offset of the first byte of each line. `starts.get(0)` is 0;
    // `Pos` is 1-based, so line `n` begins at `starts.get(n - 1)`. Built
    // once per file so a per-span scan doesn't go quadratic.
    starts: Vec<usize>,

    // Where a position is, as a byte offset. CLAMPED AT BOTH ENDS
    // rather than trapping: the one caller that can hand an
    // out-of-range position is the end-of-file span, and refusing the
    // last line is worse than reading to the end of it.
    offset* = (self: @Self, p: Pos) usize {
        (p.line == 0 || p.line > self.starts.len).match({
            true  => self.text.len,
            false => self.column_of(p),
        })
    }

    column_of = (self: @Self, p: Pos) usize {
        self.bounded(self.line_at(p.line) + col_index(p.col))
    }

    // One more than the newline count — a file without a trailing
    // newline still has a last line.
    lines* = (self: @Self) usize { self.starts.len }

    // The first byte of a 1-based line, and the first byte PAST it —
    // turns "this `=>` is on line 9" back into bytes without a scan
    // (fmt_decl.zen asks once per line).
    line_at* = (self: @Self, line: usize) usize {
        (line == 0).match({
            true  => 0,
            false => self.starts.get(line - 1).match({
                Ok(o) => o,
                None  => self.text.len,
            }),
        })
    }

    after_line* = (self: @Self, line: usize) usize {
        self.starts.get(line).match({
            Ok(o) => o,
            None  => self.text.len,
        })
    }

    // What a rule asks before rewriting a gap: a `// why` sitting there
    // is a COMMENT, and so a token, and replacing it with spaces is the
    // exact failure this folder prevents. A gap holding anything but
    // spaces is left untouched.
    //
    // A tab is not a space here, deliberately: its printed width is
    // unknown, so a gap holding one is declined rather than guessed at.
    all_spaces* = (self: @Self, from: usize, to: usize) bool {
        clear ::= true;
        Range(from, self.bounded(to)).loop((h, i) {
            (self.text.index(i) == ' ').match({
                true  => (),
                false => { clear = false; h.break(); },
            });
        });
        clear;
    }

    bounded = (self: @Self, at: usize) usize {
        (at < self.text.len).match({
            true  => at,
            false => self.text.len,
        })
    }

    // The bytes in `[from, to)`, verbatim.
    slice_at* = (self: @Self, from: usize, to: usize) str {
        (from < to).match({
            true  => self.text.slice(self.bounded(from), self.bounded(to)),
            false => "",
        })
    }

    // `to`, walked back over whitespace, never past `from`. The only
    // rule in this folder that DELETES an author's byte — safe because
    // it's whitespace, and whitespace is not a token (fmt.zen's guard).
    trim_back* = (self: @Self, from: usize, to: usize) usize {
        end ::= self.bounded(to);
        loop(() { end > from && self.text.index(end - 1).is_space() }, (h) {
            end = end - 1;
        });
        end;
    }
}

// A column is 1-based, so the line index is one less. No lexer
// produces a `0` column, but a test-built synthetic span might, and an
// unsigned underflow traps.
col_index = (col: usize) usize {
    (col == 0).match({
        true  => 0,
        false => col - 1,
    })
}

// The line index is the only thing it allocates.
Src* = (a: Alloc, text: str) Res<Src, AllocError> {
    starts ::= a.Vec<usize>();
    starts.add(0).try();
    Range(0, text.len).loop((h, i) {
        (text.index(i) == '\n').then(() { starts.add(i + 1).try() });
    });
    Ok(Src(text: text, starts: starts));
}
