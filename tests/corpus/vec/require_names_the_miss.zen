// `get` answers None for a miss, which callers who must propagate it had
// been converting into whatever error was nearest, usually OutOfMemory.
// `require` names the miss with both numbers without shadowing the `at`
// operation Vec already supplies as a Range.

Vec, OutOfBounds = std.collections

main = (env: Env) Res<i32, AllocError> {
    a = env.mem.alloc();
    v ::= a.Vec<u64>();
    v.add(10).try();
    v.add(20).try();
    v.require(1).match({
        Ok(x)  => println("required 1 = {}", x),
        Err(e) => println("miss {} of {}", e.index, e.len),
    });
    v.require(5).match({
        Ok(x)  => println("required 5 = {}", x),
        Err(e) => println("miss {} of {}", e.index, e.len),
    });
    v.at(5).match({
        Ok(x) => println("range at 5 = {}", x),
        None  => println("range at still answers None"),
    });
    Ok(0);
}
