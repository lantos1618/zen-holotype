// compiler.genc_emit_lit — integer/literal rendering + C string-escape leaf helpers for the C emitter.
// Extracted from compiler.genc_emit. Byte-only so this self-hosts (no std runtime beyond gstr append/push).
{ String } = std.text.string
{ sbyte, gstr_push, gstr_append } = compiler.genc
{ dec_digit } = compiler.astops
{ Malloc } = std.mem.alloc
// A non-printable byte as a 3-digit octal C escape `\ooo`. Octal (not `\xNN`) is used deliberately:
// hex escapes are greedy in C and would swallow a following literal hex digit, whereas an octal escape
// is capped at 3 digits, so any byte followed by any byte round-trips. dec_digit() only sees 0..7 here.
gen_oct_byte = (s: String, alloc: MutPtr<Malloc>, b: u8) String {
    n := b.to_i64()
    s
        .gstr_push(alloc, '\\')
        .gstr_push(alloc, dec_digit(n / 64))
        .gstr_push(alloc, dec_digit(n / 8 % 8))
        .gstr_push(alloc, dec_digit(n % 8))
}
// escape one byte for a C string literal. `"`/`\` are quoted; the common control bytes get their short
// escapes (\n \r \t); printable ASCII (0x20..0x7E) passes through; every other byte — CR was the bug
// (#50), plus \t, NUL, DEL and all non-printables/high bytes — is emitted as a 3-digit octal escape so
// any byte value in a Zen string survives the emitted C literal verbatim.
gen_escape_byte = (s: String, alloc: MutPtr<Malloc>, b: u8) String {
    (b == '"').match ({
        true  => s.gstr_append(alloc, "\\\""),
        false => (b == '\\').match ({
            true  => s.gstr_append(alloc, "\\\\"),
            false => (b == '\n').match ({
                true  => s.gstr_append(alloc, "\\n"),
                false => (b == '\r').match ({
                    true  => s.gstr_append(alloc, "\\r"),
                    false => (b == '\t').match ({
                        true  => s.gstr_append(alloc, "\\t"),
                        false => (b >= ' ' && b <= '~').match ({
                            true  => s.gstr_push(alloc, b),
                            false => s.gen_oct_byte(alloc, b),
                        }),
                    }),
                }),
            }),
        }),
    })
}
// a C string literal: `"` + each byte escaped + `"`
gen_strlit* = (s: String, alloc: MutPtr<Malloc>, v: string_view) String {
    s.gstr_append(alloc, "\"").gen_escape_from(alloc, v, 0).gstr_append(alloc, "\"")
}
// escape the str's bytes one by one (recursion to the NUL terminator). Avoiding view/slice keeps this
// helper independent of extra std runtime plumbing in the bootstrap source set.
gen_escape_from = (s: String, alloc: MutPtr<Malloc>, v: string_view, i: i32) String {
    acc := s
    k := i
    @while (sbyte(v, k) != 0) {
        acc = acc.gen_escape_byte(alloc, sbyte(v, k))
        k = k + 1
    }
    acc
}    // ITERATIVE: a ~50KB string literal escapes O(n) by iteration, not O(n) C-stack recursion
