// Inference through Wrap<T> settles T just as a direct T parameter does. The
// bound applies to that settled type even though T is nested in the signature.

Boxy = {
    width: i32,
}

Dot = {}

Wrap<T> = {
    value: T,
}

measure = <T: Boxy>(wrapped: Wrap<T>) i32 { 1 }

main = (env: Env) Res<i32, AllocError> {
    wrapped: Wrap<Dot> = Wrap(value: Dot());
    println("{}", measure(wrapped));
    Ok(0);
}
