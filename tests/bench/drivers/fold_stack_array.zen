// tests/bench/drivers/fold_stack_array.zen
// driver for bench_loop.zen's fold_stack_array; see vec_add.zen's
// header for why a driver exists at all. The body is NOT mirrored
// here: `loops.fold_stack_array_body()` is bench_loop.zen's own
// function, so there is one copy of the measured operation and
// nothing to keep in sync. The load-bearing number is allocs_op: 0
// -- a fold over a stack array compiles to a plain C for-loop, and
// if it ever allocates, an inliner regressed and the body is being
// boxed. Budget: ns_op 20, allocs_op 0, bytes_op 0
// (bench_budgets.zen).

loops = bench_loop

main = (env: Env) Res<i32, IoError> {
    total ::= 0;
    Range(0, 2000000).loop((h, i) {
        total = total + loops.fold_stack_array_body();
    });
    // escape via the exit code, not println -- see stored_field_read.zen
    (total > 0).match({
        true  => Ok(0),
        false => Ok(1),
    });
}
