// src/std/text/text.zen
// the folder root: nothing but starred re-exports. This file IS std.text's
// surface — a name that is not here does not cross the boundary, and a type
// listed here travels with its methods and its impls (str carries Eq and
// Hash; String carries add, view and the two allocating constructors).
//
// The layering underneath, lowest first: text_str is bytes and borrows,
// text_string owns and grows, text_utf8 reads meaning into the bytes, and
// text_fmt writes values back out as bytes. Nothing points upward.

str*, str_at*, before*, STR_HASH_SEED*, STR_HASH_MULT* = std.text.text_str

String* = std.text.text_string

Utf8Error*, Codepoint*, Codepoints*,
    codepoints*, codepoint_at*, validate_utf8*, count_codepoints*,
    UTF8_ASCII_MAX*, UTF8_CONT_MIN*, UTF8_LEAD_MIN*, UTF8_LEAD_2_MIN*,
    UTF8_LEAD_3_MIN*, UTF8_LEAD_4_MIN*, UTF8_LEAD_MAX*, UTF8_CONT_SCALE*,
    UTF8_MIN_3*, UTF8_MIN_4*, UTF8_SURROGATE_MIN*, UTF8_SURROGATE_MAX*,
    UTF8_MAX_CODEPOINT*, UTF8_MAX_LEN* = std.text.text_utf8

FmtStep*, fmt_next*, add_u64*, add_i64*, add_bool* = std.text.text_fmt
