// `env.threads.spawn(..)` IS REFUSED AT THE CALL, and the third of the
// three ways a bodiless capability can behave.
//
// `Threads` has two members and they do NOT agree with each other:
// `sleep` compiles and faults (pinned by
// `corpus/env/threads_sleep_crashes_issue_781`), `spawn` is refused
// here. The difference is not design, it is arithmetic -- `spawn` is
// generic in the body's result type and nothing settles `T`, so the
// backend has a reason to stop before it reaches the missing symbol.
// `sleep` is monomorphic and walks straight off the end.
//
// SO THIS FILE IS HALF OF A PAIR. Read alone it says "spawn is stage
// 5, as declared". Read beside the sleep test it says the two members
// of one capability fail differently, and only one of them says so.
//
// position: the call to `spawn`.

Thread, ThreadError = std.env

main = (env: Env) Res<i32, AllocError> {
    a ::= env.mem.alloc();
    env.threads.spawn(a, () Res<i32, ThreadError> { Ok(5) }).match({
        Ok(t)  => println("spawned"),
        Err(e) => println("failed"),
    });
    Ok(0)
}
