// src/gen/gen_c/gen_c_assoc.zen
// Lower `Type.name(..)` and `module.name(..)` calls. A type member is an
// associated function when its resolved first parameter is not the receiver
// type; methods remain the receiver-taking path owned by `gen_c_member.zen`.
// Both paths use the same qualified symbols and queued definitions.

ExprId, Member = std.ast
Function, Param, Access, Call, Arg = std.ast
AllocError = std.mem
Vec = std.collections
String = std.text
TyId = sema.sema_ty
Ctx = sema.sema_check
Inst = sema.sema_inst
Def, decl_at = sema.sema_def
self_ctx = sema.sema_member
module_named_by = sema.sema_module
param_type = sema.sema_denote
sym_fn = gen.gen_name
CBackend = gen.gen_c.gen_c_state
unsupported = gen.gen_c.gen_c_report
any_open, recv_inst, inst_open = gen.gen_c.gen_c_mono
enter_struct_tparams, leave_tparams = gen.gen_c.gen_c_mono
signature_of, plain, write_extern = gen.gen_c.gen_c_call
write_arg_at = gen.gen_c.gen_c_arg
holds = gen.gen_c.gen_c_expr
construct = gen.gen_c.gen_c_build
Site, site_of, member_at, method_sig = gen.gen_c.gen_c_member
member_symbol = gen.gen_c.gen_c_member
by_arity, has_body = gen.gen_c.gen_c_impl

// The base named a type and the name is not one of its variants. A
// member it declares that wants no receiver is this; anything else is
// the caller's refusal to report, so the answer is `false` and not a
// diagnostic of its own.
lower_assoc_call* = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    ty  : TyId,
    ctx : Ctx,
    out :: String
)
                    Res<bool, AllocError> {
    be.check.module_named_by(ty).match({
        Ok(mi) => be.lower_module_call(id, c, a, mi, ctx, out),
        None   => be.lower_type_assoc(id, c, a, ty, ctx, out),
    })
}

lower_type_assoc = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    ty  : TyId,
    ctx : Ctx,
    out :: String
)
                   Res<bool, AllocError> {
    site_of(be, ty).try().match({
        None  => Ok(false),
        Ok(s) => be.assoc_at_site(id, c, a, ty, s, ctx, out),
    })
}

// `module.name(..)`
// `sh = shape` then `sh.reseat(3)`. The base is not a type at all, so
// none of the machinery above applies: there is no site, no receiver and
// no member table, only a module and a name.

// THE MODULE IS HALF THE QUESTION: two modules may declare one
// top-level name, so lookup goes through the module the alias names and
// the `*` gate — the same query sema typed the node with.
lower_module_call = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    mi  : usize,
    ctx : Ctx,
    out :: String
)
                    Res<bool, AllocError> {
    found ::= be.alloc.Vec<Def>();
    be.check.world.exported_defs(mi, a.name.text, found).try();
    found.get(0).match({
        None  => Ok(false),
        Ok(d) => be.lower_module_def(id, c, d, ctx, out),
    })
}

lower_module_def = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    d   : Def,
    ctx : Ctx,
    out :: String
) Res<bool, AllocError> {
    d.kind.match({
        FunctionDef => be.lower_module_fn(id, c, d, ctx, out),
        StructDef   => be.module_construct(id, c, d, ctx, out),
        _           => Ok(false),
    })
}

module_construct = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    d   : Def,
    ctx : Ctx,
    out :: String
) Res<bool, AllocError> {
    construct(be, id, c, d, ctx, out).try();
    Ok(true);
}

lower_module_fn = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    d   : Def,
    ctx : Ctx,
    out :: String
) Res<bool, AllocError> {
    decl_at(be.tree, d.id).match({
        None  => Ok(false),
        Ok(x) => x.kind.match({
            Function(f) => be.module_fn_decl(id, c, d, f, ctx, out),
            _           => Ok(false),
        }),
    })
}

// A NARROW PATH THAT REFUSES RATHER THAN GUESSES. `gen_c_call.zen` owns
// the general call (loop intrinsic, lambda-param inlining, bodiless
// floor), and every door into it looks the name up from the CALLER's
// module — not where this declaration lives. Rebuilding that chain here
// would be a second answer to a question that has one, so only the
// plain case is emitted; the rest is reported. Arguments are still
// written in the CALLER's `ctx`: a name means what it means where
// written, not where the callee was declared.
module_fn_decl = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    d   : Def,
    f   : Function,
    ctx : Ctx,
    out :: String
) Res<bool, AllocError> {
    inst ::= be.alloc.Inst();
    sig  ::= be.alloc.Vec<TyId>();
    read = be.signature_of(d, inst, sig).try();
    (read && plain(f)).match({
        false => be.refuse_module_fn(id, out),
        true  => has_body(f).match({
            true  => be.write_module_call(c, d, f, sig, inst, ctx, out),
            false => {
                be.write_extern(id, c, d, f, sig, None, ctx, out).try();
                Ok(true)
            },
        }),
    })
}

refuse_module_fn = (be :: CBackend, id: ExprId, out :: String)
                   Res<bool, AllocError> {
    be.unsupported(
        id,
        "a generic or bodiless function reached through a module",
        out
    ).try();
    Ok(true);
}

// The same symbol `gen_c_call.zen` writes for a plain call and the same
// queue entry, so the definition this links to is the one lowered for it.
write_module_call = (
    be   :: CBackend,
    c    : Call,
    d    : Def,
    f    : Function,
    sig  : Vec<TyId>,
    inst : Inst,
    ctx  : Ctx,
    out  :: String
)
                    Res<bool, AllocError> {
    sym ::= be.alloc.String().try();
    sym_fn(sym, be.check.types, be.check.world, d.qname, sig, inst).try();
    be.need_function(d, inst, sym.view()).try();
    out.fmt("{}(", sym.view()).try();
    c.args.loop((h, i, arg) {
        be.write_assoc_arg(arg, i, be.holds(c, i, 0), f, sig, ctx, out).try();
    });
    out.add(")").try();
    Ok(true);
}

assoc_at_site = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    ty  : TyId,
    s   : Site,
    ctx : Ctx,
    out :: String
) Res<bool, AllocError> {
    found ::= be.alloc.Vec<Member>();
    member_at(be, s, a.name.text, found).try();
    kept ::= be.alloc.Vec<Member>();
    be.keep_assoc(found, ty, s, kept).try();
    // AT THE ARITY WRITTEN — the rule a method call reads two members
    // of one name by, minus the receiver: every argument is one of the
    // declaration's own.
    by_arity(be, kept, c.args.len).match({
        None  => Ok(false),
        Ok(m) => be.assoc_member(id, c, a, ty, s, m, ctx, out),
    })
}

assoc_member = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    ty  : TyId,
    s   : Site,
    m   : Member,
    ctx : Ctx,
    out :: String
)
               Res<bool, AllocError> {
    m.kind.match({
        Function(f) => be.write_assoc_call(id, c, a, ty, s, f, ctx, out),
        _           => Ok(false),
    })
}

keep_assoc = (
    be    :: CBackend,
    found : Vec<Member>,
    ty    : TyId,
    s     : Site,
    out   :: Vec<Member>
) Res<(), AllocError> {
    found.loop((h, m) { be.keep_if_assoc(m, ty, s, out).try() });
    Ok(());
}

keep_if_assoc = (
    be  :: CBackend,
    m   : Member,
    ty  : TyId,
    s   : Site,
    out :: Vec<Member>
) Res<(), AllocError> {
    m.kind.match({
        Function(f) => be.keep_receiverless(m, f, ty, s, out),
        _           => Ok(()),
    })
}

keep_receiverless = (
    be  :: CBackend,
    m   : Member,
    f   : Function,
    ty  : TyId,
    s   : Site,
    out :: Vec<Member>
) Res<(), AllocError> {
    takes_receiver(be, f, ty, s).try().match({
        true  => Ok(()),
        false => out.add(m),
    })
}

// The first parameter, resolved with `@Self` bound to the receiver, so
// `(self: @Self)` and `(self: Duration)` are one answer.
takes_receiver = (be :: CBackend, f: Function, ty: TyId, s: Site)
                 Res<bool, AllocError> {
    f.params.get(0).match({
        None  => Ok(false),
        Ok(p) => be.first_is_self(p, ty, s),
    })
}

first_is_self = (be :: CBackend, p: Param, ty: TyId, s: Site)
                Res<bool, AllocError> {
    sctx     = be.check.self_ctx(s.decl.module.to_usize(), ty).try();
    mark     = be.enter_struct_tparams(s.decl).try();
    declared = be.check.param_type(p, sctx).try();
    be.leave_tparams(mark).try();
    Ok(declared.eq(ty));
}

// The symbol is the TYPE's qualified name plus the member's, over the
// declared signature — `gen_c_member.zen`'s rule, and the reason two
// types' `zero` are two symbols without a counter.
write_assoc_call = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    ty  : TyId,
    s   : Site,
    f   : Function,
    ctx : Ctx,
    out :: String
)
                   Res<bool, AllocError> {
    inst = be.recv_inst(ty).try();
    sig ::= be.alloc.Vec<TyId>();
    be.method_sig(ty, s.decl, f, s.decl.module.to_usize(), inst, sig).try();
    (be.inst_open(inst) || be.any_open(sig)).match({
        true  => be.refuse_open(id, out),
        false => be.emit_assoc_call(c, a, ty, s, f, sig, inst, ctx, out),
    })
}

// With no receiver the type's arguments have nowhere to come from, so
// saying so is the point: monomorphising at unknown would compile, and
// would be a different function.
refuse_open = (be :: CBackend, id: ExprId, out :: String)
              Res<bool, AllocError> {
    be.unsupported(
        id,
        "an associated function whose type arguments nothing settles",
        out
    ).try();
    Ok(true);
}

emit_assoc_call = (
    be   :: CBackend,
    c    : Call,
    a    : Access,
    ty   : TyId,
    s    : Site,
    f    : Function,
    sig  : Vec<TyId>,
    inst : Inst,
    ctx  : Ctx,
    out  :: String
) Res<bool, AllocError> {
    sym = be.member_symbol(ty, s, a.name.text, sig, inst).try();
    out.fmt("{}(", sym.view()).try();
    c.args.loop((h, i, arg) {
        be.write_assoc_arg(arg, i, be.holds(c, i, 0), f, sig, ctx, out).try();
    });
    out.add(")").try();
    Ok(true);
}

// Named helper used by the argument loop.
write_assoc_arg = (
    be   :: CBackend,
    arg  : Arg,
    i    : usize,
    hold : bool,
    f    : Function,
    sig  : Vec<TyId>,
    ctx  : Ctx,
    out  :: String
)
                   Res<(), AllocError> {
    (i > 0).match({
        true  => out.add(", "),
        false => Ok(()),
    }).try();
    be.write_arg_at(arg.value, i, hold, f, sig, ctx, out)
}
