// `main = (sys: Sys) i32` — the capability entry (std.sys, additive alongside `main = () i32`).
// The compiler renames this to `zen_user_main` and emits a niladic `zen_main` trampoline that feeds it
// `std.sys.root()`, so the C boundary stays unchanged. Proves: the Sys param is accepted, stdout/stderr
// Writers work, and the heap Allocator is reachable — all threaded explicitly, no ambient rt.
{ Sys, Writer } = std.sys
// a library takes the NARROWEST capability it needs — a Writer, never the whole Sys.
greet = (w: Writer) void { w.write("hi from sys\n") }
main = (sys: Sys) i32 {
    greet(sys.stdout())
    sys.stderr().write("err channel\n")
    h := sys.heap()
    p := h.addr().acquire(64)
    h.addr().release(p)
    0
}
