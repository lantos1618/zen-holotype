InitArgs: {
    path: StringView,
    kind: i32,
    ok: bool,
    help: bool,
}
pick = (done: bool, path: StringView, kind: i32) InitArgs {
    done.match ({
        true  => InitArgs(
            path: path,
            kind: kind,
            ok: true,
            help: false,
        ),
        false => {
            next ::= path
            InitArgs(
                path: next,
                kind: kind,
                ok: false,
                help: false,
            )
        },
    })
}
main = () i32 { pick(true, "demo", 1).kind }
