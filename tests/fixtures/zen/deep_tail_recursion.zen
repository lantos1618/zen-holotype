// Deep TAIL recursion — the idiomatic Zen loop (control flow is `.match` + recursion).
// count/2 is self-tail-recursive: the recursive call is the whole `false` arm value, so genc
// emits it as a bare `return count(...)` — a C tail call. With the driver's `-O1
// -foptimize-sibling-calls` build flags, cc eliminates the frame, so this runs to a depth that
// would blow an -O0 stack (~250k) — here 1,000,000 — and prints the accumulated count.
{ println } = std.text.fmt
count = (n: i64, acc: i64) i64 { (n == 0).match ({ true => acc, false => count(n - 1, acc + 1) }) }
main = () i32 {
    println(count(1000000, 0))
    0
}
