// NEGATIVE-VALUED CONSTANTS: THE UNARY MINUS AND THE BORROWED SUBTRACTION.
//
// `gen_c_const.zen` spells I64_MIN itself as `-9223372036854775807 - 1`
// "costing only ... arithmetic the C compiler folds", which says the
// backend expects to inline operator-valued constants whose OPERANDS
// are literals. Two spellings, one per node kind the folder admits:
//
//   NEG  is Unary(Neg) over a literal
//   FLOOR is Binary(Sub) over two literals -- the exact shape of the
//        backend's own I64_MIN, one short of i64.MIN so the emitted C
//        cannot be the bare too-large token `-9223372036854775808`,
//        whose constant `9223372036854775808` has no signed type
//        (codegen/literal_boundaries_signed tells that story)
//   TINY is Unary(Neg) over ZERO: `-0` must print `0`, and a formatter
//        or fold that kept a sign bit prints `-0`
//
// The values are non-round on purpose: a truncated or re-associated
// fold shows up as a DIFFERENT number, not as zero.

NEG: i64 = -42

FLOOR: i64 = 0 - 9223372036854775807

TINY: i64 = -0

main = (env: Env) Res<i32, AllocError> {
    println("neg {} floor {} tiny {}", NEG, FLOOR, TINY);
    Ok(0);
}
