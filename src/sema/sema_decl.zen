// src/sema/sema_decl.zen
// What a module's declarations must satisfy, whether or not anything
// calls them.
//
// Everything else in this folder is a QUERY: ask about a node and get an
// answer. Three of the rules DESIGN.md fixes are not questions about a
// node at all, and nobody would ever ask them:
//
//   - a duplicate signature is wrong at the DECLARATION, "named for both
//     declarations", and a call site cannot discover it because at a
//     call site the two are indistinguishable.
//   - an impl missing a field is wrong at the IMPL, and a program that
//     never reads the missing field would otherwise compile.
//   - a body nobody calls still has to type-check, or the checker is a
//     linter for reachable code.
//
// So this is the walk that asks them, and it is deliberately the only
// walk in the folder. It is a driver over the queries, not a pass with
// state of its own: everything it computes is memoized where the queries
// already memoize it.

Module, Decl, Function, TParam, BlockId = std.ast
Struct, Impl, Member, Enum = std.ast
AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId = sema.sema_ty
Def, DefKind, ModuleTable, decl_at = sema.sema_def
Checker, Ctx = sema.sema_check
check_impl = sema.sema_bound
check_overloads = sema.sema_call
check_depth = sema.sema_depth
check_varargs = sema.sema_vararg
check_layout = sema.sema_layout
type_from_ast, param_type, block_type, decl_as_type = sema.sema_type
enter_struct_tvars = sema.sema_member
variant_payload = sema.sema_case
owner_of, push_tparams = sema.sema_inst
settle_raised = sema.sema_raise
check_return = sema.sema_hoist
check_own = sema.sema_own

// Every declaration rule, for one module.
check_module* = (c :: Checker, mi: usize) Res<(), AllocError> {
    c.world.table_at(mi).match({
        Ok(t) => check_table(c, t, mi),
        None  => Ok(()),
    })
}

// Every module in the compilation.
//
// The termination check runs LAST and over the whole program, because
// that is the only point at which it can run at all: it follows chains
// of instantiations across declarations and across modules, and a chain
// is not knowable until every body that contributes an edge to it has
// been walked.
check_all* = (c :: Checker) Res<(), AllocError> {
    Range(0, c.world.count()).loop((h, mi) {
        check_module(c, mi).try();
    });
    // these two are whole-program and both run LAST, for the same
    // reason: a struct nobody mentions still has to have a size, and
    // asking after the bodies means every field type a body already
    // resolved is a memo hit rather than a second resolution.
    //
    // A THIRD USED TO RUN HERE — the untyped `:`-self walk
    // `sema_recv.zen` records removing. Member bodies are walked now, so
    // it only doubled every diagnostic it raised.
    check_layout(c).try();
    check_depth(c).try();
    // A THIRD WHOLE-PROGRAM RULE, and whole-program for a different
    // reason: a `vararg` is legal in exactly one POSITION, and a type
    // node carries its span but not its parent — so the mentions and the
    // positions that permit them are two walks that have to meet.
    check_varargs(c).try();
    Ok(());
}

check_table = (c :: Checker, t: ModuleTable, mi: usize)
              Res<(), AllocError> {
    check_overload_sets(c, t, mi).try();
    t.impls.loop((h, id) { check_impl(c, id, mi).try() });
    check_bodies(c, mi).try();
    Ok(());
}

// One overload set per NAME, and checked once. The rule is about a set,
// a set has no order, and visiting it once per member would report the
// same pair as many times as the set is large.
check_overload_sets = (c :: Checker, t: ModuleTable, mi: usize)
                      Res<(), AllocError> {
    seen ::= c.alloc.Vec<str>();
    t.defs.loop((h, d) { one_set(c, d, mi, seen).try() });
    Ok(());
}

one_set = (c :: Checker, d: Def, mi: usize, seen :: Vec<str>)
          Res<(), AllocError> {
    (is_fn_def(d.kind) && (has_name(seen, d.name) == false)).match({
        true  => new_set(c, d.name, mi, seen),
        false => Ok(()),
    })
}

new_set = (c :: Checker, name: str, mi: usize, seen :: Vec<str>)
          Res<(), AllocError> {
    seen.add(name).try();
    c.check_overloads(mi, name).try();
    Ok(());
}

is_fn_def = (k: DefKind) bool {
    k.match({ FunctionDef => true, _ => false })
}

has_name = (seen: Vec<str>, name: str) bool {
    Range(0, seen.len).find((i) {
        seen.get(i).match({ Ok(s) => s.eq(name), None => false })
    }).match({ Ok(_) => true, None => false })
}

// ---------------------------------------------------------------------
// bodies
// ---------------------------------------------------------------------

check_bodies = (c :: Checker, mi: usize) Res<(), AllocError> {
    c.tree.module_at(mi).match({
        Ok(m) => check_decls(c, m, mi),
        None  => Ok(()),
    })
}

check_decls = (c :: Checker, m: Module, mi: usize) Res<(), AllocError> {
    m.decls.loop((h, d) { check_decl(c, d, m, mi).try() });
    Ok(());
}

check_decl = (c :: Checker, d: Decl, m: Module, mi: usize)
             Res<(), AllocError> {
    d.kind.match({
        Function(f) => check_function(c, f, m, mi),
        Struct(s)   => struct_bodies(c, s, m, mi),
        Enum(e)     => c.enum_payloads(e, mi),
        Impl(im)    => impl_bodies(c, im, m, mi),
        _           => Ok(()),
    })
}

// A VARIANT'S PAYLOAD IS A WRITTEN TYPE, and until now the only thing
// that resolved one was `cases_of`, which runs when something MATCHES on
// the enum. An enum nobody matches on had no resolved payload at all:
// `Expr = Array(ArrayLit)` left `type_memo` with no entry for
// `ArrayLit`, so a payload naming nothing drew no diagnostic and the LSP
// had nothing to hover or jump to inside the parentheses. The same rule
// as a body nobody calls, one line up.
//
// THE TYPE PARAMETERS ARE THE ENUM'S, as a struct's are its members' —
// `Opt<T> = Some(T)` writes `T` in a payload and the declaration that
// binds it is `Opt`.
enum_payloads = (c :: Checker, e: Enum, mi: usize) Res<(), AllocError> {
    tmark = c.tvar_mark();
    owner = c.owner_of(mi, e.name.text).try();
    c.push_tparams(e.tparams, owner).try();
    ctx = Ctx(mi, c.types.unknown().try());
    e.variants.loop((h, v) { c.variant_payload(v, ctx).try() });
    c.release_tvars(tmark)
}

// A MEMBER'S BODY IS A BODY. It runs the queries, because a query's
// answer is memoized and lowering reads it back — `supply_memo` above
// all: `Boxy.area`'s body reads `self.width` off `Boxy`, and it is
// EMITTED at every type that impls `Boxy`, by which time the bound that
// says which impl supplies the `width` is gone. Nothing walked these
// bodies, so there was no answer to read.
//
// AND IT RUNS THE DECLARATION RULES, which for a long time it did not:
// this was `check_body` minus `check_return` and minus `check_own`, on
// the reasoning that a query only RECORDS while those two REJECT. The
// reasoning described the change and not the rule. A member declares a
// return type and a member moves values, so a member's body owed both
// answers, and a struct-body method returning a `str` where its
// signature promised an `i32` compiled clean — even when it was called.
struct_bodies = (c :: Checker, s: Struct, m: Module, mi: usize)
                Res<(), AllocError> {
    self_ty = named_self(c, s.name.text, mi).try();
    tmark   = c.tvar_mark();
    enter_struct_tvars(c, s, mi).try();
    s.members.loop((h, mem) { member_body(c, mem, self_ty, m, mi).try() });
    c.release_tvars(tmark).try();
    Ok(());
}

// AN IMPL BODY GOT NO WALK AT ALL. `check_decl` matched `Function` and
// `Struct`, and an `Impl` fell through the wildcard — so a method an
// impl supplies was typed by nobody and not one rule in this folder
// reached it. What reached it instead was LOWERING, which is why a name
// an impl-supplied method could not resolve came back as `codegen cannot
// resolve` rather than as an undefined name.
//
// THE TYPE PARAMETERS ARE THE TARGET'S. `Vec.impl(Eq, ..)` supplies
// methods on `Vec<T>` whose bodies name `T`, and the declaration that
// binds `T` is `Vec` — the impl writes no parameter list of its own.
impl_bodies = (c :: Checker, im: Impl, m: Module, mi: usize)
              Res<(), AllocError> {
    name    = im.target.text;
    self_ty = named_self(c, name, mi).try();
    tmark   = c.tvar_mark();
    enter_target_tvars(c, name, mi).try();
    im.members.loop((h, mem) { member_body(c, mem, self_ty, m, mi).try() });
    c.release_tvars(tmark).try();
    Ok(());
}

// The named declaration's own type, with no arguments: `@Self` inside a
// member of `Vec<T>` is the `Vec` the declaration writes, and the
// receiver a call site reaches is a different question asked at the call
// site.
named_self = (c :: Checker, name: str, mi: usize) Res<TyId, AllocError> {
    target_decl(c, name, mi).try().match({
        Ok(d) => c.decl_as_type(d),
        None  => c.types.unknown(),
    })
}

enter_target_tvars = (c :: Checker, name: str, mi: usize)
                     Res<(), AllocError> {
    target_decl(c, name, mi).try().match({
        Ok(d) => target_tvars(c, d, mi),
        None  => Ok(()),
    })
}

target_decl = (c :: Checker, name: str, mi: usize)
              Res<Res<Def>, AllocError> {
    found ::= c.alloc.Vec<Def>();
    c.world.defs_of(mi, name, found).try();
    Ok(found.get(0));
}

target_tvars = (c :: Checker, d: Def, mi: usize) Res<(), AllocError> {
    decl_at(c.tree, d.id).match({
        Ok(x) => target_decl_tvars(c, x, mi),
        None  => Ok(()),
    })
}

target_decl_tvars = (c :: Checker, d: Decl, mi: usize)
                    Res<(), AllocError> {
    d.kind.match({
        Struct(s) => enter_struct_tvars(c, s, mi),
        _         => Ok(()),
    })
}

member_body = (
    c       :: Checker,
    mem     : Member,
    self_ty : TyId,
    m       : Module,
    mi      : usize
) Res<(), AllocError> {
    mem.kind.match({
        Function(f) => member_fn_body(c, f, self_ty, m, mi),
        _           => Ok(()),
    })
}

member_fn_body = (
    c       :: Checker,
    f       : Function,
    self_ty : TyId,
    m       : Module,
    mi      : usize
) Res<(), AllocError> {
    f.body.match({
        Ok(b) => check_body(c, f, b, Ok(self_ty), m, mi),
        None  => Ok(()),
    })
}

// A `Required` or `Hook` declaration has no body and nothing to check;
// the other two forms do. A top-level function has no `@Self`.
check_function* = (c :: Checker, f: Function, m: Module, mi: usize)
                  Res<(), AllocError> {
    f.body.match({
        Ok(b) => check_body(c, f, b, None, m, mi),
        None  => Ok(()),
    })
}

// The scope, the type parameters and the bounds all enter here and all
// leave here, in one place, so a body that reports cannot leak a binding
// into the next declaration. The raised list drains here for the reason
// `settle_raised` states: a `.try()` in one body would otherwise be
// attributed to the next declaration walked.
check_body = (
    c       :: Checker,
    f       : Function,
    body    : BlockId,
    self_ty : Res<TyId>,
    m       : Module,
    mi      : usize
) Res<(), AllocError> {
    smark = c.mark();
    tmark = c.tvar_mark();
    bmark = c.bound_mark();
    owner = qualified(c, m, f).try();
    enter_generics(c, f, owner, mi).try();
    ctx = body_ctx(c, f, mi, self_ty).try();
    bind_params(c, f, ctx).try();
    rmark = c.raised_mark();
    c.enter_owner(owner);
    got = c.block_type(body, ctx).try();
    c.enter_owner("");
    check_return(c, body, ctx, got).try();
    settle_raised(c, f, ctx, got, rmark).try();
    // AFTER typing and BEFORE the scope is released. Ownership is a fact
    // about the path to a node rather than about the node, so it is a
    // walk and not a query; and it reads the types typing decided rather
    // than computing any, so the parameters have to still be bound when
    // it runs.
    check_own(c, f, body, ctx).try();
    c.release_bounds(bmark).try();
    c.release_tvars(tmark).try();
    c.release(smark).try();
    Ok(());
}

// `ret` and `has_ret` are what `.try()` answers to. A function that does
// not return a `Res` has nowhere to return a failure TO, which is the
// whole of the `TryOutsideRes` rule.
//
// `self_ty` present is what a member's body names `@Self` as freely as
// its signature does; absent is a top-level function, where the poison
// type stands in and `has_self` says so.
body_ctx = (c :: Checker, f: Function, mi: usize, self_ty: Res<TyId>)
           Res<Ctx, AllocError> {
    poison = c.types.unknown().try();
    base   = Ctx(mi, poison);
    ret    = f.ret.match({
        Ok(r) => c.type_from_ast(r, base),
        None  => c.types.prim("()"),
    }).try();
    Ok(Ctx(
        module: mi,
        ret: ret,
        has_ret: is_res(c, ret),
        self_ty: self_or_poison(self_ty, poison),
        has_self: self_ty_given(self_ty)
    ));
}

self_or_poison = (self_ty: Res<TyId>, poison: TyId) TyId {
    self_ty.match({ Ok(t) => t, None => poison })
}

self_ty_given = (self_ty: Res<TyId>) bool {
    self_ty.match({ Ok(_) => true, None => false })
}

is_res = (c: Checker, ty: TyId) bool {
    c.types.at(ty).match({ Res(_) => true, _ => false })
}

// The bounds are resolved with the type parameters already in scope, so
// `<T: Boxy, U: Vec<T>>` reads `T` as the parameter and not as a
// declaration of that name somewhere else.
enter_generics = (c :: Checker, f: Function, owner: str, mi: usize)
                 Res<(), AllocError> {
    f.tparams.loop((h, tp) {
        text = tp.name.text;
        c.push_tvar(text, c.types.var(text, owner).try()).try();
    });
    poison = c.types.unknown().try();
    ctx    = Ctx(mi, poison);
    f.tparams.loop((h, tp) { push_bounds(c, tp, ctx).try() });
    Ok(());
}

push_bounds = (c :: Checker, tp: TParam, ctx: Ctx) Res<(), AllocError> {
    text = tp.name.text;
    tp.bounds.loop((h, b) {
        c.push_bound(text, c.type_from_ast(b, ctx).try()).try();
    });
    Ok(());
}

bind_params = (c :: Checker, f: Function, ctx: Ctx) Res<(), AllocError> {
    f.params.loop((h, p) {
        text    = p.name.text;
        mutable = p.mutable;
        c.bind(text, c.param_type(p, ctx).try(), mutable, true).try();
    });
    Ok(());
}

// The declaration's module-qualified name, which is what a `Ty.Var` is
// nominal on. Built the same way `sema_def.zen` builds a `Def.qname`,
// because the two have to agree: a type parameter resolved here and the
// same one resolved from a candidate must intern to one type.
qualified = (c :: Checker, m: Module, f: Function) Res<str, AllocError> {
    out ::= c.alloc.String("{}.{}", m.name, f.name.text).try();
    Ok(out.view());
}
