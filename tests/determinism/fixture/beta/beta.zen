// module `beta` — the same surface as `alpha`, different values.
//
// deliberately a near-duplicate. Two modules with identical top-level names
// is the case that makes a symbol table's iteration order visible: if
// declarations are emitted in map order, `alpha_name` and `beta_name` land
// in whichever buckets they hash to, and the emitted C reorders the moment
// anything else in the tree changes.

Item, Box, Kind, weight = gamma

name* = () str { "beta" }

tag* = () str { "beta tag" }

boxed* = () i32 {
    b = Box(value: Item(id: 2, label: "beta item"));
    b.value.id
}

counted* = () i32 {
    b = Box(value: 20);
    b.value
}

kind* = () i32 { weight(Kind.Small(5)) }

total* = () i32 { boxed() + counted() + kind() }
