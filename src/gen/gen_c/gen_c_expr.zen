// src/gen/gen_c/gen_c_expr.zen
// What an expression is in C.
//
// Every lowering here has one shape: statements go to the backend's
// buffer, and the C EXPRESSION naming the result goes to the caller's
// buffer. `gen_c_stmt.zen` owns where that result ends up; `gen_c_flow.zen`
// owns the two forms that cannot be C expressions at all.
//
// A spilling form where C wants a value is put in a temporary — the one
// non-shape-for-shape thing this file does: `deliver` hands a spill
// straight to its destination (already a place), but an argument is
// not one, so `spill_temp` makes one. `spills` asks whether a node IS a
// spill (`deliver`'s question); `spills_anywhere` asks whether one hides
// inside it, which short-circuiting needs since a hoisted `.try()` runs
// regardless of the left side — `gen_c_op.zen` owns that rule.
//
// Operators are `gen_c_op.zen`'s subject (`a + b` decides trap helper,
// `Eq` impl, or plain C) and left when this file outgrew its cap.
//
// Sema is the only source of a type: where `type_of` answers, its
// answer is used; where it does not (call, match, record), the
// context's expected type is used; with neither, an `Untyped` fault is
// raised rather than a guess.

Ast, Expr, ExprKind, ExprId, BlockId, Block, Stmt, StmtKind, Bind = std.ast
Decl, DeclKind, Struct, Member, MemberKind, Const, Consume = std.ast
Literal, LiteralKind, BinOp, UnOp, Binary, Unary, Match, Arm = std.ast
Pattern, PatternKind, Access, Call, Arg, Span, Ident = std.ast
Param, TypeId = std.ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId, Ty, Types, TyNamed, TyRes, ResForm = sema.sema_ty
World, Def, DefKind, decl_at = sema.sema_def
Checker, Ctx = sema.sema_check
type_of, type_from_ast, stmt_type = sema.sema_type
write_usize = sema.sema_diag
Emit = gen.gen_emit
sym_local, sym_member, sym_variant, sym_gen, sym_fn = gen.gen_name
RES_PATH, is_failure = gen.gen_name
GenFault = gen.gen_diag
CBackend = gen.gen_c.gen_c_state
LocalSlot = gen.gen_c.gen_c_frame
sub, constructed, unsettled = gen.gen_c.gen_c_mono
has_var = sema.sema_inst
loop_result_type = gen.gen_c.gen_c_shape
unsupported, unresolved, untyped, ambiguous = gen.gen_c.gen_c_report
lower_match = gen.gen_c.gen_c_flow
lower_try = gen.gen_c.gen_c_try
ctype, declarator, spellable, is_unit, c_prim = gen.gen_c.gen_c_type
is_c_integer, is_signed, variant_type, decl_ctx = gen.gen_c.gen_c_type
write_qname = gen.gen_c.gen_c_layout
lower_access, base_decl, type_const, TypeConst = gen.gen_c.gen_c_read
access_field_type = gen.gen_c.gen_c_read
lower_array_lit, lower_fixed_array = gen.gen_c.gen_c_array
field_type, request_type = gen.gen_c.gen_c_type
Dest, deliver, write_dest, destination_type = gen.gen_c.gen_c_stmt
plain_ctx = gen.gen_c.gen_c_decl
lower_call, res_value, is_res_ctor = gen.gen_c.gen_c_call
needs_hoist, hoist_expr = gen.gen_c.gen_c_hoist
needs_widen, widen_expr, needs_set, set_expr = gen.gen_c.gen_c_widen
is_print, body_end = gen.gen_c.gen_c_print
call_ret_type = gen.gen_c.gen_c_infer
lower_unary, lower_binary, binary_type = gen.gen_c.gen_c_op
lower_index, index_type = gen.gen_c.gen_c_index
is_ptr_member, ptr_member_type = gen.gen_c.gen_c_ptr
create_type = gen.gen_c.gen_c_alloc
field_of = gen.gen_c.gen_c_cap
inline_result_type = gen.gen_c.gen_c_settle
needs_fat, write_fat_value = gen.gen_c.gen_c_fat
release_binding = gen.gen_c.gen_c_own
lower_scope_ref, is_scope_ref, scope_type = gen.gen_c.gen_c_scope
lower_global_value = gen.gen_c.gen_c_const

// -----------------------------------------------------------------
// expressions
// -----------------------------------------------------------------

// Does this form need statements of its own? A spilling form may not
// appear where C wants a pure expression — the right operand of `&&`/`||`
// and an argument ask this first.
spills* = (be: CBackend, id: ExprId) bool {
    be.tree.expr_at(id).kind.match({
        Match(_) => true,
        Try(_)   => true,
        Block(_) => true,
        Paren(p) => spills(be, p.inner),
        _        => false,
    })
}

// Does lowering this expression need statements of its own ANYWHERE
// inside it? `spills` asks about the form ITSELF (`deliver`'s
// question); short-circuit needs this one, since a `.try()` three
// parens deep still lowers to an `if`/`return` that `expr` hoists out
// to where the operand was written.
//
// An unrecognised form answers YES: wrong in this direction is a
// refusal with a position, wrong the other way is a program computing
// the wrong thing — the one outcome a backend may not produce.
spills_anywhere* = (be: CBackend, id: ExprId) bool {
    be.tree.expr_at(id).kind.match({
        Literal(_) => false,
        Name(_)    => false,
        Unit       => false,
        Scope      => false,
        Consume(x) => spills_anywhere(be, x.operand),
        Paren(p)   => spills_anywhere(be, p.inner),
        Unary(u)   => spills_anywhere(be, u.operand),
        Binary(b)  => spills_anywhere(be, b.lhs) || spills_anywhere(be, b.rhs),
        Access(a)  => spills_anywhere(be, a.base),
        Index(x)   => spills_anywhere(be, x.base) || spills_anywhere(be, x.index),
        Call(c)    => call_spills(be, c),
        _          => true,
    })
}

call_spills = (be: CBackend, c: Call) bool {
    got ::= spills_anywhere(be, c.callee);
    c.args.loop((h, a) { got = got || spills_anywhere(be, a.value); });
    got
}

// The type of an expression.
//
// Sema first, always: where `type_of` answers, that answer is used.
// Where it does not yet (sema doesn't type a call, so not a `.try()` on
// one either), the callee's own declaration is read instead — the same
// "degrade to your own resolution when absent" the bootstrapper's
// backend documents. The fallback stops firing the moment sema types a
// call.
//
// The instantiation is applied HERE, once, so no lowering rule has to
// remember to: sema types a generic body once, generically, so every
// answer inside `Vec<T>.add` is about `T` until this substitutes the
// real `i32`.
//
// `@scope` is answered here, not by sema, for the same reason a local's
// type is: the FRAME is the authority. A block is not a value sema
// mints, but a `Scope` can be written as a parameter of the ordinary
// named type `std/core/scope.zen` declares — matched here. Without
// this, `inner = @scope;` binds a local of unknown type and every later
// use of `inner` is a name with no receiver.
ty_of* = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId)
         Res<TyId, AllocError> {
    is_scope_ref(be, id).match({
        true  => scope_type(be, ctx),
        false => settled_ty_of(be, id, ctx, want),
    })
}

settled_ty_of = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId)
                Res<TyId, AllocError> {
    local_answer(be, id).try().match({
        Ok(t) => Ok(t),
        None  => derived_answer(be, id, ctx, want),
    })
}

derived_answer = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId)
                 Res<TyId, AllocError> {
    ptr_answer(be, id, ctx, want).try().match({
        Ok(t) => Ok(t),
        None  => sema_answer(be, id, ctx, want),
    })
}

// The frame that declared a binding is the authority on its type, not
// sema's memo — the memo is keyed by node id alone, so an answer cached
// while lowering `Vec<Diag>.get` was read back for `Vec<TyId>.get`,
// emitting a call to the first symbol with the second's receiver. `cc`
// caught it; two types of one width would have hidden it.
//
// A handle and a closure are not values and have no type to give: `h`
// is a pair of labels, a lambda is a body to inline — both left to the
// paths that know what they are.
//
// A field read from one is the same rule one node up: `e.key` inside
// `Map<K, V>.confirms` derives from `e`'s type and the declaration, both
// held by the frame, so the memo has only a poisoned entry to give.
// Every instantiation of `confirms` called `str.eq`, including keys
// typed `ExprId` — swapping which map was built first swapped which
// `eq` every one of them called.
local_answer = (be :: CBackend, id: ExprId) Res<Res<TyId>, AllocError> {
    be.tree.expr_at(id).kind.match({
        Name(n)   => Ok(named_slot(be, n.text)),
        Access(a) => field_slot(be, a),
        _         => Ok(None),
    })
}

field_slot = (be :: CBackend, a: Access) Res<Res<TyId>, AllocError> {
    local_answer(be, a.base).try().match({
        None  => Ok(None),
        Ok(b) => known_field(be, b, a.name.text),
    })
}

// A member that is not STORAGE has no answer here — a nullary variant,
// a constant on a type and a method are three other readings of the
// same node, and `gen_c_read.zen` owns all three.
known_field = (be :: CBackend, base: TyId, name: str)
              Res<Res<TyId>, AllocError> {
    field_of(be, base, name).try().match({
        None  => Ok(None),
        Ok(t) => Ok(keep_known(be, t)),
    })
}

named_slot = (be :: CBackend, name: str) Res<TyId> {
    be.slot_of(name).match({
        None  => None,
        Ok(s) => value_slot(be, s),
    })
}

value_slot = (be :: CBackend, s: LocalSlot) Res<TyId> {
    ((s.handle == 0) && (s.closure == 0)).match({
        false => None,
        true  => keep_known(be, s.ty),
    })
}

keep_known = (be :: CBackend, ty: TyId) Res<TyId> {
    (be.check.is_unknown(ty) || has_var(be.check, ty)).match({
        true  => None,
        false => Ok(ty),
    })
}

sema_answer = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId)
              Res<TyId, AllocError> {
    got = sub(be, be.check.type_of(id, ctx).try()).try();
    be.check.is_unknown(got).match({
        false => settled_answer(be, id, ctx, got),
        true  => fallback_type(be, id, ctx, want),
    })
}

// `Ptr`'s members ARE the backend, so sema has no body to check and
// answers `p.to<u8>()` with a `Ptr` whose element nothing settled — not
// unknown, carries no `Var`, so nothing downstream questions it. A
// local declared at that type is a C pointer at the wrong stride:
// `src.back(8)` moved back thirty-two bytes, `realloc` read a length
// nobody wrote, and every row before the last grow was silently
// dropped. It compiled; the differential oracle caught it.
//
// So the backend answers first for exactly these members, the same
// authority it already has over lowering them.
ptr_answer = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId)
             Res<Res<TyId>, AllocError> {
    be.tree.expr_at(id).kind.match({
        Call(c) => ptr_call_answer(be, c, ctx, want),
        _       => Ok(None),
    })
}

ptr_call_answer = (be :: CBackend, c: Call, ctx: Ctx, want: TyId)
                  Res<Res<TyId>, AllocError> {
    be.tree.expr_at(c.callee).kind.match({
        Access(a) => ptr_dot_answer(be, c, a, ctx, want),
        _         => Ok(None),
    })
}

ptr_dot_answer = (be :: CBackend, c: Call, a: Access, ctx: Ctx, want: TyId)
                 Res<Res<TyId>, AllocError> {
    unknown = be.check.types.unknown().try();
    rty     = ty_of(be, a.base, ctx, unknown).try();
    is_ptr_member(be, rty, a.name.text).match({
        false => create_type(be, c, a, rty, ctx),
        true  => ptr_answer_of(be, c, a, rty, ctx, want),
    })
}

ptr_answer_of = (
    be :: CBackend,
    c: Call,
    a: Access,
    rty: TyId,
    ctx: Ctx,
    want: TyId
) Res<Res<TyId>, AllocError> {
    Ok(Ok(ptr_member_type(be, c, a, rty, ctx, want).try()));
}

// An open type is not an answer. Sema types `range.loop(body)` as
// `Res<T>` because only the closure could settle `T`, and a closure
// infers FROM a signature rather than into one — so the answer carries
// a `Var`, and a binding declared at it would be the one C type every
// loop shares. Only the loop family hits this; `gen_c_loop.zen` owns
// the rule. Everything else is handed back untouched.
settled_answer = (be :: CBackend, id: ExprId, ctx: Ctx, got: TyId)
                 Res<TyId, AllocError> {
    has_var(be.check, got).match({
        false => opaque_answer(be, id, ctx, got),
        true  => settle_open(be, id, ctx, got),
    })
}

// A type spelled with a hole in it is not an answer either. `open`
// asks about a free PARAMETER, but a BOUND's member leaves something
// else: `Alloc.realloc<T>` has no body to check, so
// `self.alloc.realloc(self.data, cap)` comes back `Res<Ptr<?>,
// AllocError>` with the element neither substituted nor a `Var` — a
// type `open` calls settled and `gen_name.tcode` writes `q` for. A
// `.try()` on it declared its temporary at that spelling instead of the
// real `Res<Ptr<u8>, AllocError>`.
//
// Straight to the call, not through the loop/inline steps above: those
// settle a `Var` the closure or callee's instantiation was going to
// bind, and there's no parameter here for either. What's missing is
// what the ARGUMENTS say — `settle_call`'s question.
opaque_answer = (be :: CBackend, id: ExprId, ctx: Ctx, got: TyId)
                Res<TyId, AllocError> {
    unsettled(be, got).match({
        false => Ok(got),
        true  => settle_call(be, id, ctx, got),
    })
}

// The loop family first, then a callee that is inlined. Both answer the
// same shape of question — "sema left this open because only the closure
// could settle it" — and both have to answer BEFORE anything is written,
// because a match scrutinee's temporary is declared at this answer and
// filled by the lowering's.
settle_open = (be :: CBackend, id: ExprId, ctx: Ctx, got: TyId)
              Res<TyId, AllocError> {
    walked = loop_result_type(be, id, ctx, got).try();
    has_var(be.check, walked).match({
        false => Ok(walked),
        true  => settle_inlined(be, id, ctx, walked),
    })
}

// AND THEN THE CALL ITSELF. Sema types a generic call as its DECLARED
// return, and inside a member body nothing recorded an instantiation to
// close it — so a `.try()` on one lands in a temporary declared at
// `Res<q, E>`, which is a C struct with an unresolved element. The
// arguments say which instantiation it is; `gen_c_call.zen` asks them.
settle_inlined = (be :: CBackend, id: ExprId, ctx: Ctx, got: TyId)
                 Res<TyId, AllocError> {
    inlined = inline_result_type(be, id, ctx, got).try();
    has_var(be.check, inlined).match({
        false => Ok(inlined),
        true  => settle_call(be, id, ctx, inlined),
    })
}

// A `.try()` ON ONE IS THE SAME QUESTION ONE NODE UP. Sema types
// `f().try()` as the callee's declared `Ok` payload, which is the
// parameter itself when the callee is generic — so the operand is
// re-asked and the payload read off the answer.
settle_call = (be :: CBackend, id: ExprId, ctx: Ctx, got: TyId)
              Res<TyId, AllocError> {
    be.tree.expr_at(id).kind.match({
        Call(c)  => call_ret_type(be, id, c, ctx, got),
        Try(t)   => try_value_type(be, t.operand, ctx, got),
        Paren(p) => ty_of(be, p.inner, ctx, got),
        _        => Ok(got),
    })
}

fallback_type = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId)
                Res<TyId, AllocError> {
    be.tree.expr_at(id).kind.match({
        Call(c)   => call_type(be, c, ctx, want),
        Paren(p)  => ty_of(be, p.inner, ctx, want),
        Try(t)    => try_value_type(be, t.operand, ctx, want),
        Index(x)  => index_type(be, x, ctx, want),
        Access(a) => access_field_type(be, a, ctx, want),
        Binary(b) => binary_type(be, b, ctx, want),
        _         => Ok(want),
    })
}

// What a call evaluates to: the callee's declared return type, or the
// type it constructs.
call_type = (be :: CBackend, c: Call, ctx: Ctx, want: TyId)
            Res<TyId, AllocError> {
    be.tree.expr_at(c.callee).kind.match({
        Name(n) => named_call_type(be, n.text, ctx, want),
        _       => Ok(want),
    })
}

named_call_type = (be :: CBackend, name: str, ctx: Ctx, want: TyId)
                  Res<TyId, AllocError> {
    is_res_ctor(name).match({
        true  => Ok(want),
        false => declared_call_type(be, name, ctx, want),
    })
}

declared_call_type = (be :: CBackend, name: str, ctx: Ctx, want: TyId)
                     Res<TyId, AllocError> {
    found ::= be.alloc.Vec<Def>();
    be.check.world.defs_of(ctx.module, name, found).try();
    found.len.match({
        1 => def_call_type(be, found, want),
        0 => sugar_call_type(be, name, want),
        _ => Ok(want),
    })
}

// The print sugar names no function, so the walk above finds nothing
// and falls back to `want` (`Unknown` at every question worth asking).
// Its value IS unit: `gen_c_print.lower_print` writes the console calls
// as statements and hands back `0` as a placeholder, correct only where
// the value is discarded.
//
// Answering `()` makes that placeholder unreachable. `Unknown` agrees
// with everything, so `gen_c_hoist.needs_hoist` used to read a
// `println` reaching `Res<(), E>` as "already fits" and emit `return
// 0;` from a function returning a struct — exactly what that file
// exists to stop. With unit as the answer the lift fires instead, and
// `write_res_payload` runs the print for effect before building `Ok`.
//
// A module declaring its own `println` means its own —
// `gen_c_call.is_sugar`'s rule, why this sits under the zero-def arm
// rather than in front of the walk.
sugar_call_type = (be :: CBackend, name: str, want: TyId)
                  Res<TyId, AllocError> {
    is_print(name).match({
        false => Ok(want),
        true  => be.check.types.prim("()"),
    })
}

def_call_type = (be :: CBackend, found: Vec<Def>, want: TyId)
                Res<TyId, AllocError> {
    found.get(0).match({
        None  => Ok(want),
        Ok(d) => def_result_type(be, d, want),
    })
}

def_result_type = (be :: CBackend, d: Def, want: TyId)
                  Res<TyId, AllocError> {
    d.kind.match({
        FunctionDef => function_ret(be, d, want),
        StructDef   => constructed(be, d),
        _           => Ok(want),
    })
}

function_ret = (be :: CBackend, d: Def, want: TyId) Res<TyId, AllocError> {
    decl_at(be.tree, d.id).match({
        None  => Ok(want),
        Ok(x) => decl_ret(be, d, x, want),
    })
}

decl_ret = (be :: CBackend, d: Def, x: Decl, want: TyId)
           Res<TyId, AllocError> {
    ctx = Ctx(
        module: d.id.module.to_usize(),
        ret: TyId(index: 0),
        has_ret: false,
        self_ty: TyId(index: 0),
        has_self: false
    );
    x.kind.match({
        Function(f) => written_ret(be, f.ret, ctx, want),
        _           => Ok(want),
    })
}

written_ret = (be :: CBackend, ret: Res<TypeId>, ctx: Ctx, want: TyId)
              Res<TyId, AllocError> {
    ret.match({
        None  => Ok(want),
        Ok(t) => sub(be, be.check.type_from_ast(t, ctx).try()),
    })
}

// `.try()` evaluates to its operand's Ok payload.
try_value_type = (be :: CBackend, operand: ExprId, ctx: Ctx, want: TyId)
                 Res<TyId, AllocError> {
    unknown = be.check.types.unknown().try();
    rt      = ty_of(be, operand, ctx, unknown).try();
    be.check.types.at(rt).match({
        Res(r) => Ok(r.value),
        _      => Ok(want),
    })
}

// The `Res` an expression is, when it is one. `.try()` and a `match`
// on a `Res` both need this and neither has a `want` that says it.
res_type_of* = (be :: CBackend, id: ExprId, ctx: Ctx)
               Res<TyId, AllocError> {
    unknown = be.check.types.unknown().try();
    ty_of(be, id, ctx, unknown)
}

// A spilling form where C wants an expression is spilled into a
// temporary — that's the whole of it. `.try()` is an `if` and a
// `return`, with no C expression for it; `deliver` hands a spill
// straight to its destination (already a place), but an argument is
// not one, so `spill_temp` makes one here, declared and filled BEFORE
// the statement being built — same place every other spill lands,
// since `deliver_simple` builds the expression text first and writes
// the line after.
//
// Four conversions funnel through this same three-door path (argument,
// field, return), each owned by whichever file builds it:
//   - a concrete value reaching a BOUND-typed slot becomes a fat value
//     (e.g. an `Arena` passed where `Alloc` is wanted), built here once
//     rather than at each of the three sites;
//   - a member reaching a structural-set slot, and a `Res` reaching a
//     wider-error `Res`, are the same shape — "the destination admits
//     more than the source has" — owned by `gen_c_widen.zen`;
//   - a bare success reaching a `Res` slot is the fourth: `7;` closing
//     `Res<i32, E>` is `Ok(7)` written shorter, built by
//     `gen_c_hoist.zen`.
expr* = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId, out :: String)
        Res<(), AllocError> {
    needs_set(be, id, ctx, want).try().match({
        true  => set_expr(be, id, ctx, want, out),
        false => hoist_or_value(be, id, ctx, want, out),
    })
}

hoist_or_value = (
    be :: CBackend,
    id: ExprId,
    ctx: Ctx,
    want: TyId,
    out :: String
) Res<(), AllocError> {
    needs_hoist(be, id, ctx, want).try().match({
        true  => hoist_expr(be, id, ctx, want, out),
        false => widen_or_value(be, id, ctx, want, out),
    })
}

// A `Res` reaching a `Res` with a wider error set arrives through the
// same three doors as the other conversions. Asked AFTER hoist (the two
// are disjoint by construction — a lifted value is not already a `Res`)
// and BEFORE the fat reading (a `Res` is never a bound). `gen_c_widen.zen`
// says what is claimed.
widen_or_value = (
    be :: CBackend,
    id: ExprId,
    ctx: Ctx,
    want: TyId,
    out :: String
) Res<(), AllocError> {
    needs_widen(be, id, ctx, want).try().match({
        true  => widen_expr(be, id, ctx, want, out),
        false => fat_or_value(be, id, ctx, want, out),
    })
}

fat_or_value = (
    be :: CBackend,
    id: ExprId,
    ctx: Ctx,
    want: TyId,
    out :: String
) Res<(), AllocError> {
    needs_fat(be, id, ctx, want).try().match({
        true  => fat_expr(be, id, ctx, want, out),
        false => value_expr(be, id, ctx, want, out),
    })
}

// The value AT ITS OWN TYPE, then the record over its address: lowering
// it at the bound would ask for a record that does not exist yet.
fat_expr = (
    be :: CBackend,
    id: ExprId,
    ctx: Ctx,
    want: TyId,
    out :: String
) Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    cty     = ty_of(be, id, ctx, unknown).try();
    code ::= be.alloc.String().try();
    value_expr(be, id, ctx, cty, code).try();
    write_fat_value(be, code.view(), cty, want, out)
}

value_expr* = (
    be :: CBackend,
    id: ExprId,
    ctx: Ctx,
    want: TyId,
    out :: String
) Res<(), AllocError> {
    spills(be, id).match({
        true  => spill_temp(be, id, ctx, want, out),
        false => write_expr(be, id, ctx, want, out),
    })
}

spill_temp = (
    be :: CBackend,
    id: ExprId,
    ctx: Ctx,
    want: TyId,
    out :: String
) Res<(), AllocError> {
    ty = destination_type(be, id, ctx, want).try();
    settled_place(be, ty).match({
        false => unsupported(
            be,
            id,
            "a spilling form whose type nothing settles",
            out
        ),
        true  => spill_settled(be, id, ctx, ty, out),
    })
}

// NOTHING WROTE AN EXPECTATION, so the node answers for itself. A
// lowering that reaches for a `want` it was never handed — `to<U>` on a
// member call, a null pointer, a loop's value — asks here rather than
// each inventing the unknown to ask `ty_of` with. The answer may still
// be the unknown, and that is information: a discarded loop still HAS a
// value, and `open_result` reads this to decide whether to give it
// storage.
want_of* = (be :: CBackend, id: ExprId, ctx: Ctx) Res<TyId, AllocError> {
    unknown = be.check.types.unknown().try();
    ty_of(be, id, ctx, unknown)
}

settled_place = (be :: CBackend, ty: TyId) bool {
    (be.check.is_unknown(ty) == false) && (has_var(be.check, ty) == false)
}

// A spilling form whose value is `()` has nothing to hold — a void
// temporary is illegal C — and it still RUNS: dropping it would drop
// the `.try()` that was the reason for writing it. `0` goes where the
// expression went, which is what the four report helpers write.
spill_settled = (
    be :: CBackend,
    id: ExprId,
    ctx: Ctx,
    ty: TyId,
    out :: String
) Res<(), AllocError> {
    is_unit(be, ty).match({
        true  => spill_effect(be, id, ctx, ty, out),
        false => spill_valued(be, id, ctx, ty, out),
    })
}

spill_effect = (
    be :: CBackend,
    id: ExprId,
    ctx: Ctx,
    ty: TyId,
    out :: String
) Res<(), AllocError> {
    deliver(be, id, ctx, ty, Dest.Discard).try();
    out.add_bytes("0")
}

spill_valued = (
    be :: CBackend,
    id: ExprId,
    ctx: Ctx,
    ty: TyId,
    out :: String
) Res<(), AllocError> {
    request_type(be, ty).try();
    tmp ::= be.alloc.String().try();
    sym_gen(tmp, "s", be.next_tmp()).try();
    line ::= be.alloc.String().try();
    declarator(be, ty, tmp.view(), line).try();
    line.add_bytes(";").try();
    be.writeln(line.view()).try();
    deliver(be, id, ctx, ty, Dest.Into(tmp.view())).try();
    out.add_bytes(tmp.view())
}

write_expr = (
    be :: CBackend,
    id: ExprId,
    ctx: Ctx,
    want: TyId,
    out :: String
) Res<(), AllocError> {
    node = be.tree.expr_at(id);
    node.kind.match({
        Literal(l)    => lower_literal(be, id, l, ctx, want, out),
        Name(n)       => lower_name(be, id, n.text, ctx, want, out),
        Paren(p)      => lower_paren(be, p.inner, ctx, want, out),
        Unary(u)      => lower_unary(be, node, u, ctx, want, out),
        Binary(b)     => lower_binary(be, node, b, ctx, want, out),
        Access(a)     => lower_access(be, id, a, ctx, want, out),
        Call(c)       => lower_call(be, id, c, ctx, want, out),
        Index(x)      => lower_index(be, id, x, ctx, out),
        Array(a)      => lower_array_lit(be, id, a, ctx, want, out),
        FixedArray(f) => lower_fixed_array(be, id, f, ctx, want, out),
        Unit          => out.add_bytes("0"),
        Scope         => lower_scope_ref(be, id, out),
        Consume(x)    => lower_consume(be, x, ctx, want, out),
        _             => unsupported(be, id, "this expression form", out),
    }).try();
    Ok(());
}

// `consume x` MOVES, and in C the bytes are simply copied — so the
// value here is the operand's own spelling and nothing more. What the
// move costs is the RECORD of it: this frame handed the value away, so
// it must not also destroy it, and the binding's live flag is cleared
// on the way past. Without that both the source and the destination
// drop, which is the double free `consume` exists to prevent.
lower_consume = (
    be :: CBackend,
    x: Consume,
    ctx: Ctx,
    want: TyId,
    out :: String
) Res<(), AllocError> {
    release_moved(be, x.operand).try();
    expr(be, x.operand, ctx, want, out)
}

release_moved = (be :: CBackend, id: ExprId) Res<(), AllocError> {
    be.tree.expr_at(id).kind.match({
        Name(n)  => release_binding(be, n.text),
        Paren(p) => release_moved(be, p.inner),
        _        => Ok(()),
    })
}

lower_paren = (
    be :: CBackend,
    id: ExprId,
    ctx: Ctx,
    want: TyId,
    out :: String
) Res<(), AllocError> {
    out.add_bytes("(").try();
    expr(be, id, ctx, want, out).try();
    out.add_bytes(")").try();
    Ok(());
}

// A literal is its RAW source slice, and that is deliberate: Zen's
// escape set is `\n \t \r \0 \\ \' \"` and every one of those is a C
// escape with the same meaning, so the bytes travel unchanged. A `str`
// is not a `char *` though — it is a pointer and a length — so a
// string literal is built as one.
lower_literal = (
    be :: CBackend,
    id: ExprId,
    l: Literal,
    ctx: Ctx,
    want: TyId,
    out :: String
) Res<(), AllocError> {
    l.kind.match({
        Str   => lower_str_literal(be, l, out),
        Int   => lower_int_literal(l.text, out),
        Float => out.add_bytes(l.text),
        Char  => out.add_bytes(l.text),
        Bool  => out.add_bytes(l.text),
    }).try();
    Ok(());
}

// A DECIMAL CONSTANT WITH NO SUFFIX HAS NO UNSIGNED TYPE IN C99, so one
// too large for `long long` is a constraint violation — `cc` picks
// `unsigned long long` anyway and warns, on every build, about `u64.MAX`
// and about FNV's basis. The suffix is read off the DIGITS and not off
// the settled type: a value `i64` can hold needs nothing, and one it
// cannot hold cannot be signed.
lower_int_literal = (text: str, out :: String) Res<(), AllocError> {
    out.add_bytes(text).try();
    over_i64(text).match({
        true  => out.add_bytes("ULL"),
        false => Ok(()),
    })
}

I64_MAX_DIGITS: str = "9223372036854775807"

// `lex_literal.number` reads decimal only — no separators, no leading
// zero, no suffix — so more digits is a larger number and equal digits
// order the same way bytes do.
over_i64 = (text: str) bool {
    (text.len == I64_MAX_DIGITS.len).match({
        true  => I64_MAX_DIGITS.before(text),
        false => text.len > I64_MAX_DIGITS.len,
    })
}

lower_str_literal = (be :: CBackend, l: Literal, out :: String)
                    Res<(), AllocError> {
    out.add_bytes("(zg_str){ (unsigned char *)").try();
    out.add_bytes(l.text).try();
    out.add_bytes(", ").try();
    out.write_usize(decoded_len(l.text)).try();
    out.add_bytes("u }").try();
    Ok(());
}

// The byte length a string literal denotes: its raw slice without the
// quotes, with each escape counting once.
//
// `esc` is "the previous byte opened an escape", so the byte that
// closes one is not counted and the backslash that opened it is.
decoded_len* = (raw: str) usize {
    n   ::= 0;
    esc ::= false;
    Range(1, body_end(raw)).loop((h, i) {
        (esc == false).then(() { n = n + 1; });
        esc = (esc == false) && (raw.index(i) == '\\');
    });
    n
}

// A bare identifier: a local, or a name the module declares. `None` is
// neither — it is a `Res` constructor, and `Res` is structural in this
// compiler's type language, so its constructors are too.
lower_name = (
    be :: CBackend,
    id: ExprId,
    text: str,
    ctx: Ctx,
    want: TyId,
    out :: String
) Res<(), AllocError> {
    be.slot_of(text).match({
        Ok(slot) => write_local(be, text, slot, out),
        None     => lower_global_name(be, id, text, ctx, want, out),
    })
}

// A `::` parameter holds the ADDRESS of its argument, so reading it is
// a dereference. Parenthesised, because every use of it is a use of the
// value: `(*p).x` and `*p.x` are different C.
write_local = (be :: CBackend, text: str, slot: LocalSlot, out :: String)
              Res<(), AllocError> {
    slot.by_ref.match({
        false => sym_local(out, text, slot.index),
        true  => write_deref(be, text, slot, out),
    })
}

write_deref = (be :: CBackend, text: str, slot: LocalSlot, out :: String)
              Res<(), AllocError> {
    out.add_bytes("(*").try();
    sym_local(out, text, slot.index).try();
    out.add_bytes(")").try();
    Ok(());
}

lower_global_name = (
    be :: CBackend,
    id: ExprId,
    text: str,
    ctx: Ctx,
    want: TyId,
    out :: String
) Res<(), AllocError> {
    text.eq("None").match({
        true  => res_value(be, id, want, "None", out),
        false => lower_global_value(be, id, text, ctx, want, out),
    })
}
