// there is no From and no implicit error conversion: an error does not
// change identity because the compiler found a conversion somewhere.
// the fix is to widen the declared set (AError | BError), not to convert.
//
// position: the .try() call.

AError = Zero | Negative

BError = TooBig | Odd

checked = (n: i32) Res<i32, AError> {
    (n == 0).match({
        true  => Err(AError.Zero),
        false => Ok(n),
    })
}

widened = (n: i32) Res<i32, BError> {
    a = checked(n).try();
    Ok(a);
}

main = (env: Env) Res<i32, BError> {
    println("{}", widened(1).try());
    Ok(0);
}
