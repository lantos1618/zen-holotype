// The query engine. Everything else in this folder is a question asked
// of it.
// Sema is a set of memoized queries populated on demand. Each query follows
// the same shape:
//
//     q(self :: @Self, key, ctx) Res<Answer, AllocError> {
//         self.memo.get(key).match({
//             None    => self.compute_q(key, ctx),   // fills the memo
//             Ok(hit) => Ok(hit),
//         })
//     }
//
// Keys are stable node ids. Checker owns the allocator used by its memo tables;
// query Err values are allocation failures only. Semantic diagnostics are
// collected values, and a reported query returns Unknown to prevent cascades.

Ast, ExprId, TypeId, Span = std.ast
nowhere = std.ast
BinOp, Unary, Binary, Access = std.ast
Alloc, AllocError = std.mem
Vec, Map = std.collections
str, String = std.text
Range = std.core
DeclId = sema.sema_id
TyId, Types, ResForm, TyRes, TyNamed, TyArray = sema.sema_ty
is_integer, is_float = sema.sema_ty
World, ImportBinding = sema.sema_def
module_display = sema.sema_def
Diag, SemaFault, TypeFault = sema.sema_diag
ExportFault = sema.sema_diag
Inst, InstEdge = sema.sema_inst

// One scoped name. Mutability feeds receiver/ownership checks, param feeds LSP
// classification, and span identifies the original binding in diagnostics.
Binding* = {
    name*: str,
    ty*: TyId,
    mutable*: bool,
    param*: bool,
    span*: Span,
}

// Binders for the active @meta field walk. Parameter spans distinguish the
// original binders from shadowing declarations; field is the current field.
WalkBind* = {
    h_name*: str,
    h_span*: Span,
    f_name*: str,
    f_span*: Span,
    field*: str,
}

// Query context not encoded in a node id: module, @Self, and enclosing return.
// Closures inherit return context because try may return through their caller.
Ctx* = {
    module*: usize,
    ret*: TyId,
    has_ret*: bool,
    self_ty*: TyId,
    has_self*: bool,
}

Checker* = {
    tree*: Ast,
    world* :: World,
    types* :: Types,
    diags :: Vec<Diag>,

    // Query results keyed by stable AST node ids.
    expr_memo* :: Map<ExprId, TyId>,
    type_memo* :: Map<TypeId, TyId>,

    // Successful `@meta(name: Type).name` folds, keyed by the written type.
    meta_memo* :: Map<TypeId, str>,

    // Successful field-count folds, also keyed by the written type.
    meta_count_memo* :: Map<TypeId, usize>,

    // Field-walk calls and the names each call unrolls over.
    meta_walks* :: Map<ExprId, Vec<str>>,

    // Accesses that read the current field walk's `field.name`.
    meta_name_reads* :: Map<ExprId, bool>,

    // Calls that project `recv.at(field)` in a field walk.
    meta_projs* :: Map<ExprId, bool>,

    // Active field-walk binder. Nested walks are rejected.
    walk_stack :: Vec<WalkBind>,

    // Field currently lowered by the backend for an unrolled walk pass.
    walk_now :: Vec<str>,

    // Nonzero while a field-walk body is rechecked with per-field types.
    meta_recheck :: usize,

    // Bound or declaration that supplied a field read.
    supply_memo* :: Map<ExprId, TyId>,

    // Declaration selected for each successfully resolved call.
    call_memo* :: Map<ExprId, DeclId>,

    // Name expressions that resolve to formal parameters.
    param_memo* :: Map<ExprId, bool>,

    // Access expressions used as a call's callee rather than as values.
    callee_access* :: Map<ExprId, bool>,

    // Type-argument substitution selected at each generic call site.
    inst_memo* :: Map<ExprId, Inst>,

    // Instantiation edges in resolution order.
    edges :: Vec<InstEdge>,

    // WHOSE BODY IS BEING CHECKED. The qualified name of the enclosing
    // function while `check_body` walks it, empty outside one.
    //
    // A call records the edge it makes, and an edge is only a
    // continuation of a chain if it knows which body it came from —
    // `pong<Vec<T>>` diverges because it is inside `ping`, and read on
    // its own it is just a call. `check_body` is the one place that
    // knows, so it is the one place that sets this.
    owner_now :: str = "",

    // THE SET A NAME STANDS FOR. `A | B` is a union of existing types
    // when every variant names one, and `WriteError` is then a NAME for
    // that set rather than a type of its own. The named type stays what
    // it was — gen_c's whole representation of a set is the declared
    // enum — and this says what it MEANS, which is the only part
    // containment needs. `sema_union.zen` explains why both are kept.
    //
    // Keyed on the named `TyId` and not on the declaration, so the
    // read-only side — `set_assignable` below — can ask without an
    // allocator. A name absent from this table is nominal and stands
    // for itself, which is what `set_of` answers.
    set_memo* :: Map<TyId, TyId>,

    // WHAT THE BODY BEING CHECKED RAISES. A `Res<T, _>` declares that
    // its set is a fact about its body, so the body has to be walked
    // before the signature is known — and every `.try()` that propagates
    // through it drops its callee's set in here on the way past.
    //
    // A stack with a mark, like `locals`, because a lambda body is
    // checked inside its enclosing function's and raises through it.
    raised :: Vec<TyId>,

    // the scope stack: one flat Vec with marks, not a chain of frames.
    // A chain needs indirection and every frame is an allocation; a
    // stack needs a `usize` and `release` is what pops it.
    locals :: Vec<Binding>,

    // WHERE THE INNERMOST BLOCK STARTS in that stack. `release` needs
    // only a mark passed down the call chain; deciding whether a name
    // is bound in THIS block needs the mark to be readable from
    // anywhere the block's statements reach, which a local cannot be.
    block_base :: usize,

    // the type parameters in scope, and the bounds on them. Two stacks
    // with marks, the same shape and for the same reason.
    //
    // A `Binding`'s `name` is the type parameter's — `T` — and its `ty`
    // is the `Ty.Var` it denotes in `tvars`, or one of its bounds in
    // `bounds`. `<K: Eq + Hash, V>` is three rows in `tvars` terms and
    // two in `bounds`, because "`Eq + Hash` is two requirements on one
    // type" and a list is the only shape that holds two.
    //
    // Not a field on `Ctx`: a `Ctx` is copied into every sub-query, and
    // a Vec copied by value is one Vec shared by accident.
    tvars :: Vec<Binding>,
    bounds :: Vec<Binding>,

    alloc*: Alloc,

    // -----------------------------------------------------------------
    // what came out
    // -----------------------------------------------------------------

    diag_count* = (self: @Self) usize { self.diags.len }

    diag_at* = (self: @Self, i: usize) Res<Diag> { self.diags.get(i) }

    type_store* = (self: @Self) Types { self.types }

    // The declaration this call resolved to, if resolution reached one.
    resolved_call* = (self: @Self, id: ExprId) Res<DeclId> {
        self.call_memo.get(id)
    }

    resolve_call* = (self :: @Self, id: ExprId, d: DeclId)
                    Res<(), AllocError> {
        self.call_memo.set(id, d)
    }

    // The text an `@meta(...).name` access folded to for this written
    // type, if it folded. A miss means the ordinary lowering applies.
    meta_str* = (self: @Self, t: TypeId) Res<str> {
        self.meta_memo.get(t)
    }

    // The count an `@meta(...).fields().len` chain folded to. A miss
    // means the ordinary lowering applies — every other dot and call.
    meta_count_of* = (self: @Self, t: TypeId) Res<usize> {
        self.meta_count_memo.get(t)
    }

    // The field names an `@meta(..).fields().loop(..)` walk unrolls
    // over, in declaration order, if the call is one. A miss means the
    // ordinary lowering applies.
    meta_walk_of* = (self: @Self, id: ExprId) Res<Vec<str>> {
        self.meta_walks.get(id)
    }

    // Whether this access is a walk's `field.name` fold. Presence IS
    // the answer; a miss means the ordinary member path.
    meta_name_read* = (self: @Self, id: ExprId) bool {
        self.meta_name_reads.get(id).match({ Ok(_) => true, None => false })
    }

    // Whether this call is a walk's `recv.at(field)` projection.
    meta_proj* = (self: @Self, id: ExprId) bool {
        self.meta_projs.get(id).match({ Ok(_) => true, None => false })
    }

    // The active walk's binder row, while sema checks a pass. A miss
    // means no walk is being checked — the ordinary answer for every
    // name the program was written with.
    walk_row* = (self: @Self) Res<WalkBind> {
        self.walk_stack.len.match({
            0 => None,
            n => self.walk_stack.get(n - 1),
        })
    }

    push_walk* = (self :: @Self, b: WalkBind) Res<(), AllocError> {
        self.walk_stack.add(b)
    }

    pop_walk* = (self :: @Self) () {
        self.walk_stack.take(self.walk_stack.len - 1);
    }

    // The field the backend is lowering a pass for, pushed once per
    // unrolled block. A miss means no walk is being lowered.
    push_walk_now* = (self :: @Self, name: str) Res<(), AllocError> {
        self.walk_now.add(name)
    }

    pop_walk_now* = (self :: @Self) () {
        self.walk_now.take(self.walk_now.len - 1);
    }

    walk_field_now* = (self: @Self) Res<str> {
        self.walk_now.len.match({
            0 => None,
            n => self.walk_now.get(n - 1),
        })
    }

    // The re-check depth, as a predicate: true while a walk's body is
    // being checked once per field, which is when `type_of` must not
    // answer from the memo.
    rechecking* = (self: @Self) bool { self.meta_recheck > 0 }

    enter_recheck* = (self :: @Self) () {
        self.meta_recheck = self.meta_recheck + 1;
    }

    leave_recheck* = (self :: @Self) () {
        self.meta_recheck = self.meta_recheck - 1;
    }


    // THE FOLD'S TYPE, OUT LOUD. The count is a comptime `usize` at its
    // own site — not a literal waiting for context — so a print hole or
    // a typed let asks sema, which answered the fold, rather than the
    // backend guessing. This is the one place §5's "no second evaluator"
    // rule could be violated from the other side; it reads the memo, it
    // computes nothing.
    meta_count_type* = (self :: @Self) Res<TyId, AllocError> {
        self.types.prim("usize")
    }

    // What this call instantiated its callee's type parameters with.
    // A miss means "the callee is not generic, or resolution could not
    // settle it" — never "it instantiated at nothing".
    resolved_inst* = (self: @Self, id: ExprId) Res<Inst> {
        self.inst_memo.get(id)
    }

    resolve_inst* = (self :: @Self, id: ExprId, inst: Inst)
                    Res<(), AllocError> {
        self.inst_memo.set(id, inst)
    }

    // The instantiation graph, as a listing. `sema_depth.zen` is the
    // only reader and it needs every edge, which a keyed memo cannot
    // hand back.
    note_edge* = (self :: @Self, e: InstEdge) Res<(), AllocError> {
        self.edges.add(e)
    }

    edge_count* = (self: @Self) usize { self.edges.len }

    edge_at* = (self: @Self, i: usize) Res<InstEdge> { self.edges.get(i) }

    // Whose body is being walked. `check_body` brackets one declaration
    // with these, so an edge recorded in between knows its caller.
    enter_owner* = (self :: @Self, owner: str) () { self.owner_now = owner; }

    owner_of_body* = (self: @Self) str { self.owner_now }

    modules* = (self: @Self) World { self.world }

    // Every diagnostic, rendered, one per line. The store is this
    // checker's own, so a caller never has to pair the two up.
    render_diags* = (self: @Self, out :: String) Res<(), AllocError> {
        self.diags.loop((h, d) {
            d.render(self.types, out).try();
            out.add("\n").try();
        });
        Ok(());
    }

    report* = (self :: @Self, file: str, span: Span, fault: SemaFault)
              Res<(), AllocError> {
        self.diags.add(Diag(file: file, span: span, fault: fault))
    }

    // -----------------------------------------------------------------
    // scopes
    //
    // `mark` / `release` rather than push/pop of frames: entering a
    // block records where the stack was, leaving it drops everything
    // added since. Shadowing falls out for free, because `lookup` walks
    // from the top down.
    // -----------------------------------------------------------------

    mark* = (self: @Self) usize { self.locals.len }

    // A BLOCK IS A SCOPE OF ITS OWN, and this is the pair that says so.
    // `enter_block` hands back the enclosing block's base for
    // `leave_block` to restore, the same shape as `mark`/`release` —
    // and for the same reason, since blocks nest.
    enter_block* = (self :: @Self) usize {
        was             = self.block_base;
        self.block_base = self.locals.len;
        was
    }

    leave_block* = (self :: @Self, was: usize) () { self.block_base = was; }

    // The binding of `name` DECLARED IN THE INNERMOST BLOCK, or
    // nothing. `lookup` walks the whole stack, which is what a use site
    // wants; a second declaration is only a mistake when the first one
    // is a statement of the same block, because a nested block is how
    // shadowing is spelled.
    // Forward, where `lookup` walks backward: a block holds at most one
    // binding of a name once this is enforced, so there is no innermost
    // to find. `gen_c_state.bound_in_frame` is the same walk over the
    // same shape, asking the backend's version of the question.
    lookup_here* = (self: @Self, name: str) Res<Binding> {
        Range(self.block_base, self.locals.len).find((k) {
            self.locals.get(k).match({
                Ok(b) => b.name.eq(name),
                None  => false,
            })
        }).match({
            None  => None,
            Ok(k) => self.locals.get(k),
        })
    }

    // `param` marks a formal parameter; `param_memo` is why it is recorded.
    bind* = (self :: @Self, name: str, ty: TyId, mutable: bool, param: bool)
            Res<(), AllocError> {
        self.bind_at(name, ty, mutable, param, nowhere())
    }

    // The same binding, with the position the name was written at. A
    // backend re-walking a body has no position to give and does not
    // need one; a declaration in source does, because `sema_place.zen`
    // reports a second binding of the name by pointing at both.
    bind_at* = (self :: @Self, name: str, ty: TyId, mutable: bool,
                param: bool, span: Span) Res<(), AllocError> {
        self.locals.add(Binding(
            name: name,
            ty: ty,
            mutable: mutable,
            param: param,
            span: span
        ))
    }

    // Drop every binding added since `mark`. `Vec` has no truncate, so
    // this takes the last element as many times as there are extras —
    // which is what truncate would have been.
    release* = (self :: @Self, mark: usize) Res<(), AllocError> {
        extra = self.locals.len - mark;
        Range(0, extra).loop((h, i) {
            self.locals.take(self.locals.len - 1);
        });
        Ok(());
    }

    // Move every binding added since `mark` aside, and put it back.
    //
    // `release` DROPS; a backend inlining a closure has to rewind to
    // the frame the closure was written in, lower its body there, and
    // then carry on with the callee's own bindings still live. Two
    // verbs because those are two different intentions, and only one of
    // them is reversible.
    detach_locals* = (self :: @Self, mark: usize, saved :: Vec<Binding>)
                     Res<(), AllocError> {
        extra = self.locals.len - mark;
        Range(0, extra).loop((h, i) {
            self.locals.take(self.locals.len - 1).match({
                Ok(b) => saved.add(b).try(),
                None  => (),
            });
        });
        Ok(());
    }

    // `saved` came off the top, so it goes back bottom-first.
    reattach_locals* = (self :: @Self, saved: Vec<Binding>)
                       Res<(), AllocError> {
        n = saved.len;
        Range(0, n).loop((h, i) {
            saved.get(n - i - 1).match({
                Ok(b) => self.locals.add(b).try(),
                None  => (),
            });
        });
        Ok(());
    }

    // -----------------------------------------------------------------
    // type parameters and their bounds
    //
    // `<T: Boxy>` puts `T` in scope as a type and `Boxy` in scope as
    // what `T` promises — and that promise is the only thing that can
    // choose between two impls supplying one name.
    // -----------------------------------------------------------------

    tvar_mark* = (self: @Self) usize { self.tvars.len }

    push_tvar* = (self :: @Self, name: str, ty: TyId) Res<(), AllocError> {
        self.tvars.add(Binding(
            name: name,
            ty: ty,
            mutable: false,
            param: false,
            span: nowhere()
        ))
    }

    release_tvars* = (self :: @Self, mark: usize) Res<(), AllocError> {
        extra = self.tvars.len - mark;
        Range(0, extra).loop((h, i) {
            self.tvars.take(self.tvars.len - 1);
        });
        Ok(());
    }

    // The `T` of an enclosing `<T>`, innermost first. A type parameter
    // shadows a declaration of the same name, exactly as a local
    // binding shadows one.
    lookup_tvar* = (self: @Self, name: str) Res<Binding> {
        n = self.tvars.len;
        Range(0, n).find((k) {
            self.tvars.get(n - k - 1).match({
                Ok(b) => b.name.eq(name),
                None  => false,
            })
        }).match({
            None  => None,
            Ok(k) => self.tvars.get(n - k - 1),
        })
    }

    bound_mark* = (self: @Self) usize { self.bounds.len }

    push_bound* = (self :: @Self, name: str, ty: TyId) Res<(), AllocError> {
        self.bounds.add(Binding(
            name: name,
            ty: ty,
            mutable: false,
            param: false,
            span: nowhere()
        ))
    }

    release_bounds* = (self :: @Self, mark: usize) Res<(), AllocError> {
        extra = self.bounds.len - mark;
        Range(0, extra).loop((h, i) {
            self.bounds.take(self.bounds.len - 1);
        });
        Ok(());
    }

    // A bound some generic in scope declared — the only question impl
    // selection asks.
    has_bound* = (self: @Self, ty: TyId) bool {
        Range(0, self.bounds.len).find((i) {
            self.bounds.get(i).match({ Ok(b) => b.ty.eq(ty), None => false })
        }).match({ Ok(_) => true, None => false })
    }

    // `bounds_of` asked as a predicate, so "does this parameter promise
    // anything at all" costs no allocation.
    is_bounded* = (self: @Self, name: str) bool {
        Range(0, self.bounds.len).find((i) {
            self.bounds.get(i).match({ Ok(b) => b.name.eq(name), None => false })
        }).match({ Ok(_) => true, None => false })
    }

    // Every bound on one type parameter. `<K: Eq + Hash>` has two, and
    // a member reachable through either is reachable through `K`.
    bounds_of* = (self: @Self, name: str, out :: Vec<TyId>)
                 Res<(), AllocError> {
        self.bounds.loop((h, b) {
            ty = b.ty;
            b.name.eq(name).then(() { out.add(ty).try() });
        });
        Ok(());
    }

    // The innermost binding of `name`. Walks from the top so an inner
    // scope shadows an outer one, which is the only thing the ordering
    // of this Vec is for.
    lookup* = (self: @Self, name: str) Res<Binding> {
        n = self.locals.len;
        Range(0, n).find((k) {
            self.locals.get(n - k - 1).match({
                Ok(b) => b.name.eq(name),
                None  => false,
            })
        }).match({
            None  => None,
            Ok(k) => self.locals.get(n - k - 1),
        })
    }

    // -----------------------------------------------------------------
    // agreement
    // -----------------------------------------------------------------

    // Whether `got` is acceptable where `want` is expected. One-way, and
    // deliberately lenient in three places: poison agrees with everything
    // (one mistake, one diagnostic), a hole agrees with everything (`_`
    // is a hole), and a literal agrees with any type of its family (a
    // literal's type comes from its context).
    assignable* = (self: @Self, got: TyId, want: TyId) bool {
        got.eq(want)
            || self.is_unknown(got) || self.is_unknown(want)
            || self.is_infer(got) || self.is_infer(want)
            || self.literal_fits(got, want)
            || self.set_assignable(got, want)
            || self.res_assignable(got, want)
            || self.array_assignable(got, want)
            || self.uninstantiated(got, want)
    }

    // TWO ARRAYS AGREE WHEN THEIR ELEMENTS DO, AT ONE LENGTH — the
    // leniency the line above grants a literal, read one level down.
    // `[1, 2, 3]` is `[int, 3]`, and a position that writes `[u8, 3]`
    // is the context those elements' type comes from, exactly as a
    // parameter is for a bare `1`. Without this a written array type
    // refused every literal ever written at it.
    //
    // The elements go back through `assignable`, so `[i32, 3]` still
    // does not reach `[u8, 3]` and `[u8, 3]` does not reach `[u8, 4]`.
    array_assignable = (self: @Self, got: TyId, want: TyId) bool {
        self.types.at(got).match({
            Array(g) => self.array_fits(g, want),
            _        => false,
        })
    }

    array_fits = (self: @Self, g: TyArray, want: TyId) bool {
        self.types.at(want).match({
            Array(w) => (g.count == w.count) && self.assignable(g.elem, w.elem),
            _        => false,
        })
    }

    // TWO `Res` AGREE WHEN THEIR PARTS DO, and this is the one place
    // hoisting is paid for. "`Ok(x)` is written before anyone knows
    // whether it closes a `Res<i32>` or a `Res<i32, E>`", so a bare
    // `Ok(..)` is `Open` — a form nobody has decided — and `Open` closes
    // either way. A DECIDED form must match: a `Res<T, E>` is not a
    // `Res<T>`, and accepting one for the other would let a failure
    // reach a signature with nowhere to return it.
    //
    // The parts go back through `assignable`, so `Res<u8>` reaches
    // `ok_or`'s `Res<T>` by the same rule that carries `Vec<T>` to
    // `Vec<Member>`, and `Res<i32>` still does not reach `Res<str>`.
    res_assignable = (self: @Self, got: TyId, want: TyId) bool {
        self.types.at(got).match({
            Res(g) => self.res_fits(g, want),
            _      => false,
        })
    }

    res_fits = (self: @Self, g: TyRes, want: TyId) bool {
        self.types.at(want).match({
            Res(w) => self.res_parts_fit(g, w),
            _      => false,
        })
    }

    res_parts_fit = (self: @Self, g: TyRes, w: TyRes) bool {
        forms_fit(g.form, w.form)
            && self.assignable(g.value, w.value)
            && self.assignable(g.error, w.error)
    }

    // Unsubstituted variables agree until inference supplies a concrete type.
    // Applications of the same declaration compare their arguments, while an
    // application against a bare generic head remains undecided.
    uninstantiated = (self: @Self, got: TyId, want: TyId) bool {
        self.is_var(got) || self.is_var(want) || self.same_applied(got, want)
    }

    // One type, or two applications of one declaration. Asked on its own
    // where assignability's other leniencies would be wrong — a poison
    // type is not an impl of a bound.
    same_type* = (self: @Self, a: TyId, b: TyId) bool {
        a.eq(b) || self.uninstantiated(a, b)
    }

    same_applied = (self: @Self, got: TyId, want: TyId) bool {
        self.types.at(got).match({
            Named(g) => self.applied_to(g, want),
            _        => false,
        })
    }

    applied_to = (self: @Self, g: TyNamed, want: TyId) bool {
        self.types.at(want).match({
            Named(w) => g.decl.eq(w.decl) && self.args_agree(g.args, w.args),
            _        => false,
        })
    }

    // Applied types compare every argument. A concrete value cannot forget its
    // arguments, but an expected bare generic head has no arguments to compare.
    args_agree = (self: @Self, g: Vec<TyId>, w: Vec<TyId>) bool {
        (g.len == w.len).match({
            false => self.wrote_no_args(w),
            true  => self.every_arg_agrees(g, w),
        })
    }

    // The context's expectation carries no arguments — a bare head, not
    // an application nobody filled in. What the value side forgot is
    // then nobody's lie: there was no answer written to contradict.
    wrote_no_args = (self: @Self, w: Vec<TyId>) bool { w.len == 0 }

    every_arg_agrees = (self: @Self, g: Vec<TyId>, w: Vec<TyId>) bool {
        Range(0, g.len).find((i) { self.arg_disagrees(g, w, i) })
            .match({ Ok(_) => false, None => true })
    }

    arg_disagrees = (self: @Self, g: Vec<TyId>, w: Vec<TyId>, i: usize) bool {
        g.get(i).match({
            None  => false,
            Ok(a) => self.arg_unlike(a, w, i),
        })
    }

    arg_unlike = (self: @Self, a: TyId, w: Vec<TyId>, i: usize) bool {
        w.get(i).match({
            None  => false,
            Ok(b) => self.assignable(a, b) == false,
        })
    }

    // -----------------------------------------------------------------
    // what a body raises
    // -----------------------------------------------------------------

    raised_mark* = (self: @Self) usize { self.raised.len }

    // The ACCESS a member id stands for, when it is one — `method_not_value`
    // reads the name and its span off it. A miss answers `None`: an access
    // that never reported keeps reporting nothing here.
    access_at* = (self: @Self, id: ExprId) Res<Access> {
        node = self.tree.expr_at(id);
        node.kind.match({
            Access(a) => Ok(a),
            _         => None,
        })
    }

    raise* = (self :: @Self, e: TyId) Res<(), AllocError> {
        self.raised.add(e)
    }

    // Everything raised since `mark`, moved out. It is a take and not a
    // read because the enclosing body has already been walked: leaving
    // the rows behind would make the NEXT function raise them too.
    take_raised* = (self :: @Self, mark: usize, out :: Vec<TyId>)
                   Res<(), AllocError> {
        Range(mark, self.raised.len).loop((h, i) {
            self.raised.get(i).match({
                None  => Ok(()),
                Ok(e) => out.add(e),
            }).try();
        });
        extra = self.raised.len - mark;
        Range(0, extra).loop((h, i) {
            self.raised.take(self.raised.len - 1);
        });
        Ok(());
    }

    // The set a type stands for. A name declared `A | B` stands for the
    // union of what its variants name; everything else stands for
    // itself. `sema_union.zen` records the first kind.
    set_of* = (self: @Self, id: TyId) TyId {
        self.set_memo.get(id).match({
            None    => id,
            Ok(set) => set,
        })
    }

    // A union target accepts any of its members: widening an error set
    // is what `.try()` does, and it is not a conversion.
    //
    // Both sides go through `set_of` because either may be a NAME for a
    // set — `WriteError` accepting an `AllocError` is the whole point,
    // and it is spelled with a name on both sides of the question.
    set_assignable = (self: @Self, got: TyId, want: TyId) bool {
        wide = self.set_of(want);
        self.types.at(wide).match({
            Union(_) => self.types.set_within(self.set_of(got), wide),
            _        => false,
        })
    }

    literal_fits = (self: @Self, got: TyId, want: TyId) bool {
        self.is_int_literal(got).match({
            true  => is_integer(self.prim_name(want)),
            false => self.float_fits(got, want),
        })
    }

    float_fits = (self: @Self, got: TyId, want: TyId) bool {
        self.is_float_literal(got) && is_float(self.prim_name(want))
    }

    // Report a mismatch, or say nothing. The one place `expected X,
    // found Y` is raised, so the rule for when it is NOT raised —
    // poison, holes, literals — lives in `assignable` alone.
    coerce* = (self :: @Self, file: str, span: Span, got: TyId, want: TyId,
               name: str) Res<(), AllocError> {
        self.assignable(got, want).match({
            false => self.mismatch(file, span, got, want, name),
            true  => Ok(()),
        })
    }

    mismatch* = (self :: @Self, file: str, span: Span, got: TyId, want: TyId,
                 name: str) Res<(), AllocError> {
        self.report(
            file,
            span,
            SemaFault.TypeMismatch(TypeFault(
                name: name,
                expected: want,
                found: got
            ))
        )
    }

    // A nullary generic variant carries only its declaration. A written
    // destination may supply its type arguments when both sides name that
    // declaration; ordinary assignability does not invent them.
    nullary_settles* = (self: @Self, got: TyId, want: TyId) bool {
        self.types.at(got).match({
            Named(g) => (g.args.len == 0) && self.types.at(want).match({
                Named(w) => g.decl.eq(w.decl),
                _        => false,
            }),
            _        => false,
        })
    }

    // `!` is logical negation — the method table has no `Not` to
    // dispatch to, so the operand is `bool` and nothing else. The
    // question goes through `coerce` so an operand that already
    // reported stays one mistake, one diagnostic, and the position is
    // the operator token, where the `!` the author has to delete is.
    check_not* = (self :: @Self, u: Unary, inner: TyId)
                 Res<TyId, AllocError> {
        want = self.types.bool_ty().try();
        self.coerce(u.op_span.file, u.op_span, inner, want, "").try();
        Ok(want);
    }

    // The operand-side half of being a logical operator, and the same
    // rule `check_not` states for `!`: `&&` and `||` short-circuit, and
    // short-circuiting is deciding whether the RIGHT side runs off the
    // left side's truth — which only a bool has. Every other predicate
    // (`<`, `==`) takes whatever scalar it is given, so the comparison
    // rule never covered these two.
    //
    // EACH SIDE ASKED ON ITS OWN, through the same `coerce`: a single
    // question about the pair would have to name one type as `found`,
    // and `true && 1` would then report the left one — a sentence about
    // the operand that is fine. Poison and holes stay silent there, so
    // one wrong operand is still one diagnostic.
    check_logical* = (self :: @Self, b: Binary, lhs: TyId, rhs: TyId)
                     Res<(), AllocError> {
        is_logical(b.op).match({
            false => Ok(()),
            true  => self.logical_operands(b, lhs, rhs),
        })
    }

    // The position is the operator token for both sides, as `check_not`
    // puts it on the `!`: the operator is what demanded a bool.
    logical_operands = (self :: @Self, b: Binary, lhs: TyId, rhs: TyId)
                       Res<(), AllocError> {
        want = self.types.bool_ty().try();
        self.coerce(b.op_span.file, b.op_span, lhs, want, "").try();
        self.coerce(b.op_span.file, b.op_span, rhs, want, "").try();
        Ok(());
    }

    // -----------------------------------------------------------------
    // asking a type what it is
    // -----------------------------------------------------------------

    is_unknown* = (self: @Self, id: TyId) bool {
        self.types.at(id).match({ Unknown => true, _ => false })
    }

    is_infer* = (self: @Self, id: TyId) bool {
        self.types.at(id).match({ Infer => true, _ => false })
    }

    is_var* = (self: @Self, id: TyId) bool {
        self.types.at(id).match({ Var(_) => true, _ => false })
    }

    prim_name* = (self: @Self, id: TyId) str {
        self.types.at(id).match({ Prim(p) => p.name, _ => "" })
    }

    is_literal_ty* = (self: @Self, id: TyId) bool {
        self.is_int_literal(id) || self.is_float_literal(id)
    }

    is_int_literal = (self: @Self, id: TyId) bool {
        self.prim_name(id).eq("int")
    }

    is_float_literal = (self: @Self, id: TyId) bool {
        self.prim_name(id).eq("float")
    }
}

// `alloc.Checker(tree)` — a ufcs function whose first parameter is an
// Alloc, beside the type it builds, exactly as `Vec`, `Map`, `Ast` and
// `Types` are. It builds the module graph eagerly, because every query
// below needs it and building it twice is the thing memoization exists
// to prevent.
//
// THE TREE MUST BE FINISHED FIRST. An `Ast` is a value — six `Vec`s, each
// a pointer, a length and a capacity — so this copies a SNAPSHOT. A node
// added to the caller's tree afterwards is invisible here, and asking
// about its id traps in `ast_arena.zen`, which is correct for an id the
// arena never handed out and says nothing about where the mistake was.
// Holding a reference instead would not help: a `Vec` grows by
// reallocating, so any handle taken before a growth points at freed pages.
Checker* = (a: Alloc, tree: Ast) Res<Checker, AllocError> {
    c ::= Checker(
        tree: tree,
        world: a.World(tree).try(),
        types: a.Types(),
        diags: a.Vec<Diag>(),
        expr_memo: a.Map<ExprId, TyId>(),
        type_memo: a.Map<TypeId, TyId>(),
        meta_memo: a.Map<TypeId, str>(),
        meta_count_memo: a.Map<TypeId, usize>(),
        meta_walks: a.Map<ExprId, Vec<str>>(),
        meta_name_reads: a.Map<ExprId, bool>(),
        meta_projs: a.Map<ExprId, bool>(),
        walk_stack: a.Vec<WalkBind>(),
        walk_now: a.Vec<str>(),
        meta_recheck: 0,
        supply_memo: a.Map<ExprId, TyId>(),
        call_memo: a.Map<ExprId, DeclId>(),
        param_memo: a.Map<ExprId, bool>(),
        callee_access: a.Map<ExprId, bool>(),
        inst_memo: a.Map<ExprId, Inst>(),
        edges: a.Vec<InstEdge>(),
        set_memo: a.Map<TyId, TyId>(),
        raised: a.Vec<TyId>(),
        locals: a.Vec<Binding>(),
        block_base: 0,
        tvars: a.Vec<Binding>(),
        bounds: a.Vec<Binding>(),
        alloc: a,
    );
    check_import_gate(c).try();
    Ok(c);
}

// THE `*` GATE IS A FACT ABOUT THE GRAPH, so it is asked once, here,
// where the graph is built — and not by a query, because no query would
// ever reach it. `defs_of` can only ever answer "nothing is in scope
// under that name"; the mistake is one hop away in the IMPORT, and by
// the time a use site notices, the name it wanted has already been
// filtered out. That is why this rule was silent for so long: the only
// thing left to see was a backend that could not resolve a symbol, which
// names the wrong phase and the wrong law.
check_import_gate = (c :: Checker) Res<(), AllocError> {
    blocked ::= c.alloc.Vec<ImportBinding>();
    Range(0, c.world.count()).loop((h, mi) {
        c.world.blocked_imports(c.tree, mi, blocked).try();
    });
    blocked.loop((h, b) { report_blocked(c, b).try() });
    Ok(());
}

// The two halves, unjoined. `sema_diag.zen` builds the sentence — this
// rule knows which name was refused and by which module, and nothing
// about how that reads.
report_blocked = (c :: Checker, b: ImportBinding) Res<(), AllocError> {
    c.report(
        b.span.file,
        b.span,
        SemaFault.NotExported(ExportFault(
            name: b.name,
            module: module_display(b.module)
        ))
    )
}

// A context with nothing in it: module 0, no `@Self`, no enclosing Res.
// A caller fills in what it knows.
Ctx* = (module: usize, none: TyId) Ctx {
    Ctx(
        module: module,
        ret: none,
        has_ret: false,
        self_ty: none,
        has_self: false
    )
}

// The `TyId` a lookup falls back to before the store has answered. It is
// index 0, which the store's own construction order makes the first type
// ever interned; nothing reads it as a type, only as a placeholder an
// error path immediately replaces.
UNRESOLVED* : TyId = TyId(index: 0)

// `==`, `!=`, `<` and their kin are `bool` whatever they compare;
// everything else in `BinOp` yields its operands' type. `&&`/`||` come
// out `bool` through this too — but unlike a comparison they also
// demand bool operands, which `check_logical` asks.
is_predicate* = (op: BinOp) bool {
    op.match({
        Equal => true, NotEqual => true,
        Less => true, LessEq => true, Greater => true, GreaterEq => true,
        And => true, Or => true,
        _ => false,
    })
}

// Logical operators short-circuit and require boolean operands.
is_logical* = (op: BinOp) bool {
    op.match({ And => true, Or => true, _ => false })
}

// Which `Res` a value is, when one of the two has not been decided.
// `Open` is what a bare `Ok(x)` carries and it closes either way; two
// decided forms must be the same one.
forms_fit* = (got: ResForm, want: ResForm) bool {
    got.match({
        Open    => true,
        Absence => undecided_or(want, false),
        Failure => undecided_or(want, true),
    })
}

undecided_or = (f: ResForm, failure: bool) bool {
    f.match({
        Open    => true,
        Failure => failure,
        Absence => failure == false,
    })
}

// `Res<T>` propagating into a `Res<T, E>` function. Named because the
// rule it stands for has a name: only success lifts, and an absence
// carries no reason to become one.
absence_into_failure* = (got: ResForm, want: ResForm) bool {
    got.match({
        Absence => want.match({ Failure => true, _ => false }),
        _       => false,
    })
}

both_failures* = (got: ResForm, want: ResForm) bool {
    got.match({
        Failure => want.match({ Failure => true, _ => false }),
        _       => false,
    })
}
