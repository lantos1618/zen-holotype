// src/lsp/lsp_built.zen
// The one build a session keeps, and the arena it dies by.
//
// A build of this tree is ~10 MB of arena pages (`Build.whole`: the walk,
// the tree, the `Checker`'s memos). Before this file every one of those
// builds — the diagnostics settle's AND each query's own — allocated from
// the SESSION arena, where nothing is ever reclaimed: RSS grew by the
// cost of a whole-program build per request, forever (a hover, a
// completion and a settle are three builds, so a keystroke with a hover
// cost ~30 MB, permanent).
//
// TWO RULES UNDO THAT, and both live here:
//
//   - A BUILD'S PAGES DIE WITH ITS REPLACEMENT. Everything a build
//     produces — `Build`, `Checker`, the spots and classifications read
//     off them — is allocated from THIS arena, one per build, dropped as
//     a whole when the next build replaces it. An arena is the language's
//     own primitive for exactly this: `mem_arena.zen`'s drop frees every
//     page at once. The field is dropped EXPLICITLY (`rebuild` below):
//     a struct field carries no drop glue (`gen_c_own.zen` registers
//     bindings, not fields), so without the call the old build's pages
//     would leak exactly as the session arena did.
//
//   - ONE BUILD PER DOCUMENT STATE, SINGLE-FLIGHT. The settle and every
//     query against the SAME state share this one build. The key is the
//     state a build reads: the compilation root, the entry module, and
//     every open buffer's bytes (`paths`/`texts`, the overlay, in open
//     order). `ensure` builds only when the key disagrees — a change
//     moves the bytes, so a stale slot cannot answer for a state it did
//     not see, and a queued query arriving after a `didChange` builds
//     once for the NEW state with the settle at batch end reusing it
//     (the stale-state stamp `design_lsp.md` §5 asks for, as a content
//     comparison rather than a version counter: a client that resends
//     the same bytes has changed nothing, which `lsp_serve.zen`'s
//     `stored` already relies on).
//
// WHAT A QUERY TAKES FROM THE SLOT is the `Checker` BY VALUE — a header
// copy (`zen_build.zen`'s `checked` hands it back the same way), read
// only through memos `check_all` already filled. Nothing mutates it:
// hover reads, definition reads, completion reads, and a query that
// types nothing new is the doctrine `lsp_hover.zen`'s header states.
//
// WHAT A QUERY MAY NOT KEEP is anything ALLOCATED FROM THE SLOT past
// the next `ensure`: eviction frees the pages. The answers are written
// into a caller's arena within the request (that is what makes eviction
// safe), `lsp_diag.zen` copies the URIs it keeps into the session arena,
// and `classed` is re-derived per request by `classes_for`.
//
// THE ENTRY IS PART OF THE KEY because the walk starts there: hovering
// a document that was not the settled one reaches modules the settle's
// walk may not have. A miss on the key is a rebuild, never a wrong
// answer; the common case — settle, then queries about the document
// just edited — is the hit.

str, String = std.text
Vec, Map = std.collections
Alloc, AllocError, Arena = std.mem
Range = std.core
Span = std.ast.ast_span
Note = std.parse.parse_diag
Checker = sema.sema_check
SemaFault, message, write_detail = sema.sema_diag
// IMPORTED FOR ITS METHODS: without this line the bootstrapper resolves
// `c.types`'s methods against another module (as `lsp_hover.zen` notes).
Types = sema.sema_ty
Build = zen.zen_build
Classed = lsp.lsp_colour
classify = lsp.lsp_names
uri_at, path_of = lsp.lsp_uri
// The one arena string-copy, exported (`lsp_reply.zen`).
own_str = lsp.lsp_reply
written = lsp.lsp_json

// ONE DIAGNOSTIC, ALREADY BELONGING TO A FILE. `uri` is resolved at
// gather time, not write time: a build knows its compilation root, a
// writer does not. `message` IS TEXT AND NOT A FAULT: sema's sentence
// needs the `Types` store that decided it, so it renders while the
// checker is in hand — and both are slot-arena `str`s, valid until the
// next `ensure` and no longer (the header's eviction rule).
Spot* = {
    uri*: str,
    message*: str,
    span*: Span,
    note*: Res<Note>,
}

// Everything one build produced, all of it in the slot's arena. A value
// of its own (not loose fields) so `cur` is all-or-nothing: half a build
// is never visible to a reader.
Inner = {
    root: str,          // the compilation root, copied into the arena
    entry: str,         // the open document, relative to the root
    paths: Vec<str>,    // the overlay the build saw: paths[i] held texts[i]
    texts: Vec<str>,
    b: Build,           // lex/parse's tally and diags
    c: Checker,         // sema's memos — what every query reads
    spots: Vec<Spot>,   // every diagnostic, grouped at publish time
    classed: Vec<Classed>,  // colour's semantic half; empty unless clean
}

Built* = {
    // THE PAGES OF `cur`, replaced as a whole. Field, not binding: the
    // session outlives any one scope, so the drop is explicit in
    // `rebuild` — the one place an old build is let go.
    arena :: Arena,

    // The build and its key, or nothing yet. `Res` and not a `ready`
    // flag beside loose fields: no build and no key arrive together.
    cur :: Res<Inner>,

    // Is the held build one for exactly this state? The key is CONTENT,
    // not versions: equal bytes are the same state however a client
    // numbers them.
    matches* = (self: @Self, root: str, entry: str, uris: Vec<str>,
                docs: Map<str, str>) bool {
        self.cur.match({
            None  => false,
            Ok(i) => i.root.eq(root) && i.entry.eq(entry)
                      && same_overlay(i, uris, docs),
        })
    }

    // The held build answers for this state — building only when it does
    // not already. THE SINGLE FLIGHT: settle and queries all funnel
    // through here, so one document state is built once no matter how
    // many requests ask.
    ensure* = (self :: @Self, env: Env, root: str, entry: str,
               uris: Vec<str>, docs: Map<str, str>) Res<(), AllocError> {
        self.matches(root, entry, uris, docs).match({
            true  => written(),
            false => self.rebuild(env, root, entry, uris, docs),
        })
    }

    rebuild = (self :: @Self, env: Env, root: str, entry: str,
               uris: Vec<str>, docs: Map<str, str>) Res<(), AllocError> {
        // THE OLD BUILD'S PAGES GO BACK HERE — the line this file
        // exists for. An arena with no pages yet drops nothing, so the
        // first rebuild needs no guard.
        self.arena.drop();
        self.arena = env.mem.alloc();

        // The key is copied INTO THE SLOT: the caller's `root`/`entry`
        // borrow a request's bytes, which the transport may reuse.
        kept_root = own_str(self.arena, root).try();
        kept_entry = own_str(self.arena, entry).try();

        // THE OVERLAY, snapshotted as the key and handed to the build:
        // every open buffer, keyed on the path `Build.read` looks up.
        // The texts themselves are NOT copied — the document store holds
        // them for the session (`lsp_serve.zen`), so the snapshot is a
        // Vec of references and the comparison is `eq` on bytes.
        paths ::= self.arena.Vec<str>();
        texts ::= self.arena.Vec<str>();
        over ::= self.arena.Map<str, str>();
        uris.loop((h, u) {
            docs.get(u).match({
                None     => written(),
                Ok(text) => {
                    paths.add(path_of(u)).try();
                    texts.add(text).try();
                    over.set(path_of(u), text).try();
                    Ok(())
                },
            }).try();
        });

        b ::= self.arena.Build(env, kept_root);
        c = b.whole(kept_entry, over).try();
        spots ::= self.arena.Vec<Spot>();
        from_build(b, self.arena, kept_root, spots).try();
        from_check(c, self.arena, kept_root, spots).try();
        // COLOUR'S HALF, off the same `Checker`, only when the build
        // found nothing wrong — with faults outstanding the memos hold
        // poison, and an empty `classed` is the lexical fallback's
        // trigger (`lsp_names.zen`'s doctrine, moved with the code).
        classed ::= self.arena.Vec<Classed>();
        (b.diag_count() == 0 && c.diag_count() == 0).match({
            true  => classify(self.arena, c, kept_root, classed),
            false => written(),
        }).try();

        self.cur = Ok(Inner(
            root: kept_root,
            entry: kept_entry,
            paths: paths,
            texts: texts,
            b: b,
            c: c,
            spots: spots,
            classed: classed
        ));
        Ok(());
    }

    // The checker, BY VALUE — a header copy, read-only by doctrine (see
    // the header). None before the first build.
    checker* = (self: @Self) Res<Checker> {
        self.cur.match({ None => None, Ok(i) => Ok(i.c) })
    }

    // The root the held build ran against, "" before the first one.
    root* = (self: @Self) str {
        self.cur.match({ None => "", Ok(i) => i.root })
    }

    spots* = (self: @Self) Res<Vec<Spot>> {
        self.cur.match({ None => None, Ok(i) => Ok(i.spots) })
    }

    classed* = (self: @Self) Res<Vec<Classed>> {
        self.cur.match({ None => None, Ok(i) => Ok(i.classed) })
    }
}

// An empty slot: an arena owning no pages (the first `raw` chains one)
// and no build. `env.mem.alloc()` is a TEMPORARY on purpose — a binding
// would be dropped at scope exit under the field it was just moved into.
Built* = (env: Env) Built {
    Built(arena: env.mem.alloc(), cur: None)
}

// Does the held overlay read exactly what the documents hold now? Same
// count, same order (`open` is insertion-ordered), same bytes. NOTHING
// HERE ALLOCATES — a comparison, not a build — so no arm is a `Res`.
same_overlay = (i: Inner, uris: Vec<str>, docs: Map<str, str>) bool {
    same ::= true;
    at ::= 0;
    uris.loop((h, u) {
        docs.get(u).match({
            None     => (),
            Ok(text) => {
                row = i.paths.get(at).match({
                    None  => false,
                    Ok(p) => p.eq(path_of(u))
                              && i.texts.get(at).match({
                                     None  => false,
                                     Ok(t) => t.eq(text),
                                 }),
                });
                same = same && row;
                at = at + 1;
            },
        });
    });
    same && (at == i.paths.len);
}

// --- what a build found -------------------------------------------------
//
// Moved from `lsp_diag.zen` unchanged in shape: the gather belongs with
// the arena that owns what it gathers, and this is that arena.

// LEX AND PARSE, off the `Build`. `Diag.span.file` is the module's path
// relative to the compilation root, exactly what a URI is built from.
from_build = (b :: Build, a: Alloc, root: str, spots :: Vec<Spot>)
             Res<(), AllocError> {
    Range(0, b.diag_count()).loop((h, i) {
        b.diag_at(i).match({
            None  => written(),
            Ok(d) => add_parse(a, root, d.message, d.span, d.note, spots),
        }).try();
    });
    Ok(());
}

add_parse = (
    a: Alloc,
    root: str,
    said: str,
    span: Span,
    note: Res<Note>,
    spots :: Vec<Spot>
) Res<(), AllocError> {
    spots.add(Spot(
        uri: uri_at(a, root, span.file).try(),
        message: said,
        span: span,
        note: note
    ))
}

// SEMA, off the `Checker` `whole` handed back. THE SENTENCE IS RENDERED
// HERE, while the store that decided it is in hand: `message` plus
// `write_detail` rather than `render`, since `render` opens with
// `file:line:col:` and a position already travelling beside a `range`
// would be the same fact said twice, once in a form no client can click.
from_check = (c :: Checker, a: Alloc, root: str, spots :: Vec<Spot>)
             Res<(), AllocError> {
    Range(0, c.diag_count()).loop((h, i) {
        c.diag_at(i).match({
            None  => written(),
            Ok(d) => add_sema(c, a, root, d.file, d.span, d.fault, spots),
        }).try();
    });
    Ok(());
}

add_sema = (
    c :: Checker,
    a: Alloc,
    root: str,
    file: str,
    span: Span,
    fault: SemaFault,
    spots :: Vec<Spot>
) Res<(), AllocError> {
    said ::= a.String().try();
    said.add_bytes(message(fault)).try();
    write_detail(fault, c.types, said).try();
    spots.add(Spot(
        uri: uri_at(a, root, file).try(),
        message: said.view(),
        span: span,
        note: None
    ))
}
