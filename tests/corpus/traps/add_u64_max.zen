// tests/corpus/traps/add_u64_max.zen
// u64.MAX + 1 traps. unsigned overflow is still overflow: it
// wraps only where +% says so

// main must name an error type. a trap never lifts into Res:
// it aborts the process
Error =
    Overflow,
    DivideByZero,
    OutOfBounds

main = (env: Env) Res<i32, Error> {
    x: u64 = u64.MAX;
    sum = x + 1;
    println("{}", sum);
    Ok(0);
}
