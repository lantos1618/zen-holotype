// src/lsp/lsp_frame.zen
// The envelope: `Content-Length: <n>\r\n\r\n<body>`, and nothing else.
//
// JSON-RPC over a byte stream needs exactly one thing the JSON reader
// cannot give it — where a message ENDS. Deliberately the smallest file
// in `src/lsp/`: a framing layer that knows what a message means can
// disagree with the one that parses it.
//
// THE BODY IS BYTES AND IS NOT SCANNED. `n` counts bytes, not
// characters; the body may contain `\r`, `\n` and any UTF-8 sequence, so
// splitting on newlines would corrupt any message containing one —
// `design_lsp.md:157` specifies a byte-counted `read` and explicitly no
// `read_line` for this reason.
//
// HEADER NAMES ARE COMPARED CASE-INSENSITIVELY, per protocol; every
// other header (e.g. optional `Content-Type`) is skipped, not rejected.

str, String, parse_usize = std.text
Range = std.core
AllocError = std.mem
to_lower, digit = std.core.byte

// One message, and where the next one starts. `next` rather than a
// consumed cursor, so the caller can walk a buffer of frames without this
// file holding any state.
Envelope* = {
    body*: str,
    next*: usize,
}

// Why a frame could not be read, and at which byte. `Short` is not an
// error at a live transport — it means the bytes have not all arrived;
// over a buffer it is end-of-input, so `frames_in` treats it as the stop
// condition rather than a failure.
FrameFault* = NoBlank(usize)     // headers that never ended
            | NoLength(usize)    // a header block with no Content-Length
            | BadLength(usize)   // a Content-Length that is not a number
            | Short(usize)       // fewer bytes than the length promises

// Where the fault sits. Every variant carries it, so there is nothing
// to decide.
byte* = (f: FrameFault) usize {
    f.match({
        NoBlank(i)   => i,
        NoLength(i)  => i,
        BadLength(i) => i,
        Short(i)     => i,
    })
}

// The fault, said for a person. `lsp_serve.zen`'s `frame_fault` reports
// it to a caller's stream and this folder's `fault_line` to a console;
// both say this sentence.
why* = (f: FrameFault) str {
    f.match({
        NoBlank(_)   => "the headers never ended",
        NoLength(_)  => "no Content-Length",
        BadLength(_) => "Content-Length is not a number",
        Short(_)     => "fewer bytes than Content-Length promised",
    })
}

// Whether the framing still made sense at `f`. Over a live transport
// `NoBlank` and `Short` are bytes still in flight, not faults; over a
// buffer `serve` ends the session at any of the four.
partial* = (f: FrameFault) bool {
    f.match({
        NoBlank(_)   => true,
        Short(_)     => true,
        NoLength(_)  => false,
        BadLength(_) => false,
    })
}

// The frame beginning at `at`.
frame_at* = (bytes: str, at: usize) Res<Envelope, FrameFault> {
    blank = blank_at(bytes, at).try();
    len   = length_in(bytes, at, blank).try();
    body  = blank + BLANK_LEN;
    (body + len <= bytes.len).match({
        false => Err(FrameFault.Short(body)),
        true  => Ok(Envelope(
            body: bytes.slice(body, body + len),
            next: body + len
        )),
    })
}

// How many more bytes the message beginning at `at` needs, ZERO when
// that cannot be known yet.
//
// THIS IS WHAT MAKES A LIVE TRANSPORT POSSIBLE. `Stdin.read` reads
// EXACTLY what it is asked for and blocks until it has it
// (`src/std/env/env.zen`), so asking for more than the message holds
// would wait on bytes the client will not send until answered, while the
// client waits on that answer. Asking for exactly what is missing cannot
// deadlock. Zero means "ask for one byte", which always makes progress
// while headers are still arriving (no `Content-Length` to compute from
// yet) — not simply `frame_at`'s `Short` read backward.
short_by* = (bytes: str, at: usize) usize {
    blank_at(bytes, at).match({
        Err(_)    => 0,
        Ok(blank) => length_in(bytes, at, blank).match({
            Err(_) => 0,
            Ok(n)  => missing(bytes, blank + BLANK_LEN + n),
        }),
    })
}

missing = (bytes: str, end: usize) usize {
    (end > bytes.len).match({
        true  => end - bytes.len,
        false => 0,
    })
}

blank_at = (bytes: str, at: usize) Res<usize, FrameFault> {
    (at <= bytes.len).match({
        false => Err(FrameFault.NoBlank(at)),
        true  => bytes.slice(at, bytes.len).find(BLANK).match({
            Ok(i) => Ok(at + i),
            None  => Err(FrameFault.NoBlank(at)),
        }),
    })
}

// The `Content-Length` value in the header block spanning `at..blank`.
// Scanned line by line because a header VALUE may itself contain a
// colon.
length_in = (bytes: str, at: usize, blank: usize) Res<usize, FrameFault> {
    from  ::= at;
    found ::= false;
    value ::= 0;
    bad   ::= false;
    loop(() { !found && !bad && from < blank }, (h) {
        stop = line_end(bytes, from, blank);
        is_length(bytes, from, stop).then(() {
            found = true;
            parse_usize(trimmed(bytes, from + NAME.len, stop)).match({
                Ok(n) => { value = n; },
                None  => { bad = true; found = false; },
            });
        });
        from = stop + CRLF_LEN;
    });
    bad.match({
        true  => Err(FrameFault.BadLength(at)),
        false => found.match({
            true  => Ok(value),
            false => Err(FrameFault.NoLength(at)),
        }),
    })
}

// The `\r` ending the header line at `from`, or the end of the block.
line_end = (bytes: str, from: usize, blank: usize) usize {
    Range(from, blank).find((i) { bytes.index(i) == '\r' }).match({
        Ok(i) => i,
        None  => blank,
    })
}

// Whether the line at `from` names Content-Length. Case-insensitive on
// the NAME; the colon must be there too — `Content-Lengthy: 3` is a
// different header.
is_length = (bytes: str, from: usize, stop: usize) bool {
    fits = from + NAME.len <= stop;
    same ::= fits;
    Range(0, NAME.len).loop((h, i) {
        same = same && to_lower(bytes.index(from + i)) == NAME.index(i);
    });
    same;
}

// A header value with its surrounding spaces removed. Only spaces and
// tabs — a header line's other whitespace is its terminator.
trimmed = (bytes: str, from: usize, stop: usize) str {
    lo ::= from;
    hi ::= stop;
    loop(() { lo < hi && blankish(bytes.index(lo)) }, (h) { lo = lo + 1; });
    loop(() { hi > lo && blankish(bytes.index(hi - 1)) }, (h) { hi = hi - 1; });
    bytes.slice(lo, hi);
}

blankish = (b: u8) bool { b == ' ' || b == '\t' }

// A message, framed, appended to `out`. EXACT BYTES, NO TRAILING
// NEWLINE — `Console.println` (`src/std/env/env.zen:45`) appends one
// `\n` and is unusable for this.
write_frame* = (body: str, out :: String) Res<(), AllocError> {
    out.add("Content-Length: ").try();
    write_decimal(body.len, out).try();
    out.add("\r\n\r\n").try();
    out.add(body)
}

// A usize, in decimal, with no allocation. The digit comes from a TABLE
// rather than arithmetic: this language has no narrowing conversion
// (`src/std/core/num.zen:124`), so indexing a ten-byte string by a value
// already known to be under ten is that conversion, spelled as a lookup.
write_decimal* = (n: usize, out :: String) Res<(), AllocError> {
    (n < 10).match({
        true  => out.add(digit(n)),
        false => {
            write_decimal(n / 10, out).try();
            out.add(digit(n % 10))
        },
    })
}

NAME*: str = "content-length:"
BLANK*: str = "\r\n\r\n"
BLANK_LEN*: usize = 4
CRLF_LEN*: usize = 2
