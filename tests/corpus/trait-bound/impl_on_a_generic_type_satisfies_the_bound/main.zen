// the impl lives on a GENERIC type: `Vec<i32>` satisfies `Range<i32>` by
// the impl in std.collections, and a user generic bounded by Range<i32>
// accepts it with nothing written here. whole-program compilation exists
// for this (the Vec<Circle> case, sema/generic_third_module) -- but that
// sibling pins construction; this one pins BOUND SATISFACTION by an
// instantiation, which is a different lookup: the bound must match the
// trait's parameters through the argument type's own.
//
// 7 vs 17 separates the two containers: same body, different storage,
// both walking through the SAME supplied `at`. A bound check that
// matched names rather than instantiations would reject the array or
// accept everything and answer 0.

draw = <R: Range<i32>>(r: R) i32 {
    acc ::= 0;
    r.loop((h, value) { (value > 0).then(() { acc = acc + value; }); });
    acc
}

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    xs ::= alloc.Vec<i32>();
    xs.add(3).try();
    xs.add(4).try();
    println("{}", draw(xs));
    ys ::= [9, 8];
    println("{}", draw(ys));
    Ok(0);
}
