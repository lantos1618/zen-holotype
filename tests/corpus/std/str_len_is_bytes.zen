// tests/corpus/std/str_len_is_bytes.zen
// str is BYTES. len is a byte count, not a character count: the
// two strings below have the same five characters and different
// lengths, and 5 for the second one is the bug this test exists
// to catch

main = (env: Env) Res<i32, AllocError> {
    ascii    = "hello";
    accented = "héllo";

    println("ascii {}", ascii.len);
    println("accented {}", accented.len);
    println("empty {}", "".len);
    Ok(0);
}
