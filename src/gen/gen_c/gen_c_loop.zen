// src/gen/gen_c/gen_c_loop.zen
// The one construct that has no Zen definition anywhere.
//
// `src/std/core/loop/loop_iter.zen` declares six signatures with no
// bodies: "a loop is the one thing that cannot be written in a
// language whose only control flow is `.match`, `.loop` and
// recursion" — writing `loop` in terms of `loop` is circular, and by
// recursion makes "compiles to a plain C for-loop" depend on a
// tail-call optimisation nobody gates. So the backend IS the body of
// all six.
//
// THE OVERLOAD IS READ OFF THE DECLARATION'S OWN PARAMETER NAMES, never
// the lambda at the call site: `loop_iter.zen` writes the body's
// parameter list — `(h: LoopHandle, index: usize, value: T)` — and
// which of `index`, `value`, `acc` appear is the whole difference
// between the six. `(h, i)` binds to `value` on the two-parameter form
// and to `index` on the counted one; only the declaration knows which.
//
// `h.break(v)` AND `h.next()` ARE `goto`s, NOT C's `break`/`continue`
// — `gen_c_handle.zen` argues why, and owns both verbs.
//
// WHAT IS BEING WALKED IS `gen_c_range.zen`'S SUBJECT, NOT THIS ONE:
// whether a range stores its bounds or an impl supplies them, and what
// one pass hands out, are RANGE questions; this file only asks for the
// answers.
//
// WHAT THIS FILE DOES NOT LOWER, IT REFUSES BY NAME — a fold, a body
// written somewhere other than the call site, a range whose element
// nothing settles.
//
// LOOPS NEVER ALLOCATE — the signature, not a promise: no declaration
// in `loop_iter.zen` takes an `Alloc`, and `index`, `value`, `acc` are
// plain automatic storage.

ExprId, Lambda = std.ast
Function, Param = std.ast
Call = std.ast
AllocError = std.mem
Vec = std.collections
str, String = std.text
TyId = sema.sema_ty
Checker, Ctx = sema.sema_check  // for `be.check.bind`: bootstrap resolves a method reached through a FIELD by the field's type NAME
sym_member, sym_gen, sym_variant = gen.gen_name
RES_PATH = gen.gen_name
CBackend = gen.gen_c.gen_c_state
LoopFrame = gen.gen_c.gen_c_frame
Shape, shape_of = gen.gen_c.gen_c_shape
Fold, no_fold, lower_fold, bind_acc = gen.gen_c.gen_c_fold
write_fold_result = gen.gen_c.gen_c_fold
unsupported = gen.gen_c.gen_c_report
ctype, declarator = gen.gen_c.gen_c_type
intern_res_open = gen.gen_c.gen_c_mono
has_var = sema.sema_inst
expr, ty_of = gen.gen_c.gen_c_expr
Dest, block = gen.gen_c.gen_c_stmt
supplies_bounds = gen.gen_c.gen_c_range
bind_text, is_res = gen.gen_c.gen_c_range
lower_supplied = gen.gen_c.gen_c_range
array_of, lower_array_walk = gen.gen_c.gen_c_array

// -----------------------------------------------------------------
// the lowering
// -----------------------------------------------------------------

// `args` is the call's arguments with the receiver, if there was one,
// already at the front: `range.loop(body)` and `loop(range, body)` are
// one call written two ways, which is what UFCS means.
lower_loop* = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    f    : Function,
    recv : Res<ExprId>,
    ctx  : Ctx,
    want : TyId,
    out  :: String
)
              Res<(), AllocError> {
    args ::= be.alloc.Vec<ExprId>();
    recv.match({
        None  => Ok(()),
        Ok(r) => args.add(r),
    }).try();
    c.args.loop((h, a) { args.add(a.value).try(); });
    args.get(args.len - 1).match({
        None  => unsupported(be, id, "a loop with no body", out),
        Ok(b) => lower_with_body(be, id, f, args, b, ctx, want, out),
    })
}

lower_with_body = (
    be   :: CBackend,
    id   : ExprId,
    f    : Function,
    args : Vec<ExprId>,
    body : ExprId,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    lambda_at(be, body).match({
        None    => unsupported(
            be,
            id,
            "a loop body written somewhere other than the call site",
            out
        ),
        Ok(lam) => lower_shaped(be, id, f, args, lam, ctx, want, out),
    })
}

lambda_at* = (be :: CBackend, id: ExprId) Res<Lambda> {
    be.tree.expr_at(id).kind.match({
        Lambda(l) => Ok(l),
        _         => None,
    })
}

lower_shaped = (
    be   :: CBackend,
    id   : ExprId,
    f    : Function,
    args : Vec<ExprId>,
    lam  : Lambda,
    ctx  : Ctx,
    want : TyId,
    out  :: String
)
               Res<(), AllocError> {
    sh = shape_of(be, f).try();
    sh.wants_acc.match({
        true  => lower_fold(be, id, sh, args, lam, ctx, want, out),
        false => lower_walk(
            be,
            id,
            sh,
            args,
            lam,
            ctx,
            want,
            no_fold(be).try(),
            out
        ),
    })
}

// THE FOUR NON-FOLD SHAPES, and the branch between them is what the
// arguments before the body are:
//
//   nothing        while true
//   a `() bool`    while cond, tested BEFORE each pass
//   anything else  a Range, walked half-open
lower_walk* = (
    be   :: CBackend,
    id   : ExprId,
    sh   : Shape,
    args : Vec<ExprId>,
    lam  : Lambda,
    ctx  : Ctx,
    want : TyId,
    fold : Fold,
    out  :: String
)
             Res<(), AllocError> {
    lead = first_lead(be, args);
    lead.match({
        None    => lower_forever(be, id, sh, None, lam, ctx, want, fold, out),
        Ok(one) => lower_led(be, id, sh, one, lam, ctx, want, fold, out),
    })
}

first_lead = (be :: CBackend, args: Vec<ExprId>) Res<ExprId> {
    (args.len > 1).match({
        false => None,
        true  => args.get(0),
    })
}

lower_led = (
    be   :: CBackend,
    id   : ExprId,
    sh   : Shape,
    one  : ExprId,
    lam  : Lambda,
    ctx  : Ctx,
    want : TyId,
    fold : Fold,
    out  :: String
)
            Res<(), AllocError> {
    is_cond(be, one).match({
        true  => lower_forever(be, id, sh, Ok(one), lam, ctx, want, fold, out),
        false => lower_range(be, id, sh, one, lam, ctx, want, fold, out),
    })
}

// A range whose bounds an impl supplies carries no accumulator yet, so
// it's refused BY NAME rather than walked: `gen_c_range.zen`'s own pass
// would discard the body's value — a fold that compiles and returns its
// seed, the one outcome a backend may not produce.
lower_impl_walk = (
    be   :: CBackend,
    id   : ExprId,
    sh   : Shape,
    one  : ExprId,
    rty  : TyId,
    lam  : Lambda,
    ctx  : Ctx,
    want : TyId,
    fold : Fold,
    out  :: String
) Res<(), AllocError> {
    fold.has.match({
        true  => unsupported(
            be,
            id,
            "a fold over a range whose bounds an impl supplies",
            out
        ),
        false => lower_supplied(be, id, sh, one, rty, lam, ctx, want, out),
    })
}

// The condition form's first argument is `() bool` — a lambda taking no
// parameters. A range never is.
is_cond = (be :: CBackend, one: ExprId) bool {
    lambda_at(be, one).match({
        None    => false,
        Ok(lam) => lam.params.len == 0,
    })
}

// -----------------------------------------------------------------
// while true, and while cond
// -----------------------------------------------------------------

lower_forever = (
    be   :: CBackend,
    id   : ExprId,
    sh   : Shape,
    cond : Res<ExprId>,
    lam  : Lambda,
    ctx  : Ctx,
    want : TyId,
    fold : Fold,
    out  :: String
) Res<(), AllocError> {
    st = open_result(be, want, out).try();
    counter ::= be.alloc.String().try();
    sh.wants_index.match({
        true  => open_counter(be, counter),
        false => Ok(()),
    }).try();
    be.writeln("for (;;) {").try();
    be.indent();
    cond.match({
        None    => Ok(()),
        Ok(one) => write_cond_guard(be, one, st.brk, ctx),
    }).try();
    usize_ty = be.check.types.prim("usize").try();
    run_body(
        be,
        sh,
        lam,
        counter.view(),
        "",
        counter.view(),
        usize_ty,
        fold,
        ctx
    ).try();
    close_pass(be, st, counter.view(), fold).try();
    Ok(());
}

// `while cond` is tested BEFORE each pass, "so a cond that is false to
// begin with runs the body zero times". The condition is a closure like
// the body is, so it is inlined the same way — into the top of the
// loop, where a `for (;;)` puts what a `while` would have in its head.
write_cond_guard = (be :: CBackend, one: ExprId, brk: usize, ctx: Ctx)
                   Res<(), AllocError> {
    lambda_at(be, one).match({
        None    => Ok(()),
        Ok(lam) => write_cond_body(be, lam, brk, ctx),
    })
}

write_cond_body = (be :: CBackend, lam: Lambda, brk: usize, ctx: Ctx)
                  Res<(), AllocError> {
    bool_ty = be.check.types.prim("bool").try();
    tmp ::= be.alloc.String().try();
    sym_gen(tmp, "c", be.next_tmp()).try();
    decl ::= be.alloc.String().try();
    declarator(be, bool_ty, tmp.view(), decl).try();
    decl.add_bytes(";").try();
    be.writeln(decl.view()).try();
    cmark = be.check.mark();
    lmark = be.mark();
    block(be, lam.body, ctx, bool_ty, Dest.Into(tmp.view())).try();
    be.release(lmark).try();
    be.check.release(cmark).try();
    be.write("if (!").try();
    be.write(tmp.view()).try();
    be.writeln(") { goto ").try();
    write_label(be, "brk", brk).try();
    be.writeln("; }").try();
    Ok(());
}

// -----------------------------------------------------------------
// a range
//
// HALF-OPEN, and the counter is the index space. `Range(0, 5)` is five
// passes; `index` counts PASSES and `value` is what the range holds, so
// over `Range(10, 13)` they are 0,1,2 and 10,11,12 — one name for both
// would make the two indistinguishable exactly when the range does not
// start at zero.
// -----------------------------------------------------------------

lower_range = (
    be   :: CBackend,
    id   : ExprId,
    sh   : Shape,
    one  : ExprId,
    lam  : Lambda,
    ctx  : Ctx,
    want : TyId,
    fold : Fold,
    out  :: String
) Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    rty     = ty_of(be, one, ctx, unknown).try();
    // A FIXED ARRAY IS ASKED ABOUT FIRST because it satisfies `Range`
    // intrinsically: it stores no `start` and no `end`, and it has no
    // declaration for an impl to live on, so neither of the two readings
    // below would find it. `gen_c_array.zen` says why that is the only
    // way `[T, N]` can satisfy anything.
    array_of(be, rty).match({
        Ok(a) => lower_array_walk(
            be,
            sh,
            one,
            rty,
            a,
            lam,
            ctx,
            want,
            fold,
            out
        ),
        None  => lower_range_impl(
            be,
            id,
            sh,
            one,
            rty,
            lam,
            ctx,
            want,
            fold,
            out
        ),
    })
}

lower_range_impl = (
    be   :: CBackend,
    id   : ExprId,
    sh   : Shape,
    one  : ExprId,
    rty  : TyId,
    lam  : Lambda,
    ctx  : Ctx,
    want : TyId,
    fold : Fold,
    out  :: String
) Res<(), AllocError> {
    supplies_bounds(be, rty).match({
        false => lower_impl_walk(
            be,
            id,
            sh,
            one,
            rty,
            lam,
            ctx,
            want,
            fold,
            out
        ),
        true  => lower_settled(be, id, sh, one, rty, lam, ctx, want, fold, out),
    })
}

// WHAT THE LOOP EVALUATES TO IS THE BACKEND'S ANSWER, NOT SEMA'S.
// `loop<R: Range<T>, T>` returns `Res<T>` and nothing settles `T` — it's
// reachable only through the closure, and a closure infers FROM a
// signature rather than into one. Sema hands back `Res<q>` (the
// mangler's word for an undecided type argument); emitting that as-is
// is how `h.break(v)` in one loop and another become one C type. A
// range that supplies no `at` walks its own index space, so its element
// is `usize` and the loop is `Res<usize>`.
lower_settled = (
    be   :: CBackend,
    id   : ExprId,
    sh   : Shape,
    one  : ExprId,
    rty  : TyId,
    lam  : Lambda,
    ctx  : Ctx,
    want : TyId,
    fold : Fold,
    out  :: String
) Res<(), AllocError> {
    elem    = be.check.types.prim("usize").try();
    settled = settle_res(be, want, elem).try();
    lower_bounded(be, id, sh, one, rty, lam, ctx, settled, fold, out)
}

// The loop's `Res<T>` at a `T` the backend worked out, or the written
// expectation when there was one — an expectation is a decision already
// made and outranks a reconstruction.
settle_res* = (be :: CBackend, want: TyId, elem: TyId)
             Res<TyId, AllocError> {
    has_var(be.check, want).match({
        false => Ok(want),
        true  => intern_res_open(be.check, elem),
    })
}

lower_bounded = (
    be   :: CBackend,
    id   : ExprId,
    sh   : Shape,
    one  : ExprId,
    rty  : TyId,
    lam  : Lambda,
    ctx  : Ctx,
    want : TyId,
    fold : Fold,
    out  :: String
) Res<(), AllocError> {
    rng = walk_temp(be, one, rty, ctx).try();

    st       = open_result(be, want, out).try();
    usize_ty = be.check.types.prim("usize").try();
    counter ::= be.alloc.String().try();
    sym_gen(counter, "i", be.next_tmp()).try();
    base ::= be.alloc.String().try();
    sym_gen(base, "b", be.next_tmp()).try();
    declare_usize(be, counter.view()).try();
    declare_usize(be, base.view()).try();
    limit ::= be.alloc.String().try();
    sym_gen(limit, "n", be.next_tmp()).try();
    declare_usize(be, limit.view()).try();
    assign_member(be, counter.view(), rng.view(), "start").try();
    assign_member(be, limit.view(), rng.view(), "end").try();
    be.write(base.view()).try();
    be.write(" = ").try();
    be.write(counter.view()).try();
    be.writeln(";").try();

    be.write("while (").try();
    be.write(counter.view()).try();
    be.write(" < ").try();
    be.write(limit.view()).try();
    be.writeln(") {").try();
    be.indent();
    run_body(
        be,
        sh,
        lam,
        counter.view(),
        base.view(),
        counter.view(),
        usize_ty,
        fold,
        ctx
    ).try();
    close_pass(be, st, counter.view(), fold).try();
    Ok(());
}

// THE COLLECTION IS EVALUATED ONCE, into a temporary of its own, and
// every pass — and every bound a pass reads — is a read of that
// temporary. Re-evaluating the expression between two reads would walk
// a different collection each time, so an array, a range and a bounded
// range all open the same way.
walk_temp* = (be :: CBackend, one: ExprId, rty: TyId, ctx: Ctx)
             Res<String, AllocError> {
    rng ::= be.alloc.String().try();
    sym_gen(rng, "r", be.next_tmp()).try();
    decl ::= be.alloc.String().try();
    declarator(be, rty, rng.view(), decl).try();
    decl.add_bytes(" = ").try();
    expr(be, one, ctx, rty, decl).try();
    decl.add_bytes(";").try();
    be.writeln(decl.view()).try();
    Ok(rng);
}

declare_usize* = (be :: CBackend, name: str) Res<(), AllocError> {
    usize_ty = be.check.types.prim("usize").try();
    decl ::= be.alloc.String().try();
    declarator(be, usize_ty, name, decl).try();
    decl.add_bytes(";").try();
    be.writeln(decl.view())
}

assign_member = (be :: CBackend, target: str, base: str, member: str)
                Res<(), AllocError> {
    line ::= be.alloc.String().try();
    line.add_bytes(target).try();
    line.add_bytes(" = ").try();
    line.add_bytes(base).try();
    line.add_bytes(".").try();
    sym_member(line, member).try();
    line.add_bytes(";").try();
    be.writeln(line.view())
}

// -----------------------------------------------------------------
// the parts every shape shares
// -----------------------------------------------------------------

// The loop's own value, and the frame `h.break` reads.
//
// "The loop evaluates to the final acc — or to `h.break(value)`, which
// is what makes the two forms one thing rather than two." A loop
// nothing broke out of evaluates to `None`; the temporary is
// initialised to it before the first pass rather than left to whatever
// the frame held.
open_result* = (be :: CBackend, want: TyId, out :: String)
              Res<LoopFrame, AllocError> {
    brk = be.next_tmp();
    cnt = be.next_tmp();
    result ::= be.alloc.String().try();
    keep = wants_result(be, want);
    keep.match({
        false => Ok(()),
        true  => open_result_temp(be, want, result),
    }).try();
    // A loop with no storage still writes `0` where the expression goes,
    // for the reason `gen_c_inline.zen`'s `write_result` gives.
    keep.match({
        true  => out.add_bytes(result.view()),
        false => out.add_bytes("0"),
    }).try();
    // The block depth OUTSIDE the loop's body, taken before the body's
    // own block is entered: `h.break()` and `h.next()` unwind back to
    // here, which is every block the `goto` jumps over.
    frame = LoopFrame(
        brk: brk,
        cnt: cnt,
        result: result.view(),
        has_result: keep,
        ty: want,
        depth: be.block_depth()
    );
    be.push_loop(frame).try();
    Ok(frame);
}

// A loop whose value nothing asked for gets no temporary, and writes
// `0` where the expression goes (see note above).
wants_result = (be :: CBackend, want: TyId) bool {
    has_var(be.check, want).match({
        true  => false,
        false => is_res(be, want),
    })
}

open_result_temp = (be :: CBackend, want: TyId, result :: String)
                   Res<(), AllocError> {
    sym_gen(result, "v", be.next_tmp()).try();
    decl ::= be.alloc.String().try();
    declarator(be, want, result.view(), decl).try();
    decl.add_bytes(" = (").try();
    ctype(be, want, decl).try();
    decl.add_bytes("){ .zg_tag = ").try();
    sym_variant(decl, RES_PATH, "None").try();
    decl.add_bytes(" };").try();
    be.writeln(decl.view())
}

// The body, inlined into the frame it was written in. The handle and
// the two threaded values are bound as ORDINARY LOCALS — "index and acc
// thread BY VALUE, so no cell is heap-allocated".
run_body* = (
    be      :: CBackend,
    sh      : Shape,
    lam     : Lambda,
    counter : str,
    base    : str,
    value   : str,
    ety     : TyId,
    fold    : Fold,
    ctx     : Ctx
)
           Res<(), AllocError> {
    cmark = be.check.mark();
    lmark = be.mark();
    bind_handle(be, lam).try();
    bind_threaded(be, sh, lam, counter, base, value, ety).try();
    bind_acc(be, sh, lam, fold).try();
    // A FOLD'S BODY IS ITS OWN VALUE: the pass computes the next
    // accumulator and the assignment is the thread. Every other shape
    // discards, which is what makes `()` its body's declared type.
    fold.has.match({
        true  => block(be, lam.body, ctx, fold.ty, Dest.Into(fold.cell)),
        false => discard_body(be, lam, ctx),
    }).try();
    be.release(lmark).try();
    be.check.release(cmark).try();
    Ok(());
}

discard_body = (be :: CBackend, lam: Lambda, ctx: Ctx)
               Res<(), AllocError> {
    unit = be.check.types.prim("()").try();
    block(be, lam.body, ctx, unit, Dest.Discard)
}

// `h` has no C storage: what the name means is the loop it came from.
bind_handle = (be :: CBackend, lam: Lambda) Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    lam.params.get(0).match({
        None  => Ok(()),
        Ok(p) => be.declare_handle(p.name.text, unknown, be.loop_depth()),
    }).try();
    be.check.bind(handle_name(lam), unknown, false, false).try();
    Ok(());
}

handle_name = (lam: Lambda) str {
    lam.params.get(0).match({ Ok(p) => p.name.text, None => "h" })
}

// THE BODY'S PARAMETERS AFTER `h`, AND WHICH IS WHICH IS THE
// DECLARATION'S ANSWER (see header): `index`/`value` are not
// interchangeable (see the half-open note above). A range that supplies
// no `at` walks its own index space, where the value IS the counter —
// what makes `Range(0, 5)` a bare C for-loop.
bind_threaded = (
    be      :: CBackend,
    sh      : Shape,
    lam     : Lambda,
    counter : str,
    base    : str,
    value   : str,
    ety     : TyId
) Res<(), AllocError> {
    (sh.wants_index || sh.wants_value).match({
        false => Ok(()),
        true  => bind_named(be, sh, lam, counter, base, value, ety),
    })
}

bind_named = (
    be      :: CBackend,
    sh      : Shape,
    lam     : Lambda,
    counter : str,
    base    : str,
    value   : str,
    ety     : TyId
) Res<(), AllocError> {
    (sh.wants_index && sh.wants_value).match({
        true  => bind_pair(be, lam, counter, base, value, ety),
        false => bind_single(be, sh, lam, counter, base, value, ety),
    })
}

// Both: `index` is parameter one and `value` is parameter two, in the
// order `loop_iter.zen` writes them.
bind_pair = (
    be      :: CBackend,
    lam     : Lambda,
    counter : str,
    base    : str,
    value   : str,
    ety     : TyId
) Res<(), AllocError> {
    bind_index(be, lam, 1, counter, base).try();
    bind_element(be, lam, 2, value, ety).try();
    Ok(());
}

bind_single = (
    be      :: CBackend,
    sh      : Shape,
    lam     : Lambda,
    counter : str,
    base    : str,
    value   : str,
    ety     : TyId
) Res<(), AllocError> {
    sh.wants_index.match({
        true  => bind_index(be, lam, 1, counter, base),
        false => bind_element(be, lam, 1, value, ety),
    })
}

// `index` is the pass count, so it is measured from where the walk
// started. A loop with no range has no base and counts from zero
// already.
bind_index = (
    be      :: CBackend,
    lam     : Lambda,
    i       : usize,
    counter : str,
    base    : str
) Res<(), AllocError> {
    lam.params.get(i).match({
        None  => Ok(()),
        Ok(p) => bind_offset(be, p, counter, base),
    })
}

bind_offset = (be :: CBackend, p: Param, counter: str, base: str)
              Res<(), AllocError> {
    usize_ty = be.check.types.prim("usize").try();
    text ::= be.alloc.String().try();
    (base.len > 0).match({
        true  => write_offset(counter, base, text),
        false => text.add_bytes(counter),
    }).try();
    bind_text(be, p.name.text, usize_ty, text.view())
}

bind_element* = (
    be    :: CBackend,
    lam   : Lambda,
    i     : usize,
    value : str,
    ety   : TyId
) Res<(), AllocError> {
    lam.params.get(i).match({
        None  => Ok(()),
        Ok(p) => bind_text(be, p.name.text, ety, value),
    })
}

write_offset = (counter: str, base: str, out :: String)
               Res<(), AllocError> {
    out.add_bytes("(").try();
    out.add_bytes(counter).try();
    out.add_bytes(" - ").try();
    out.add_bytes(base).try();
    out.add_bytes(")").try();
    Ok(());
}

// The `index` a counted `for (;;)` needs when there is no range to take
// one from.
open_counter = (be :: CBackend, counter :: String) Res<(), AllocError> {
    sym_gen(counter, "i", be.next_tmp()).try();
    declare_usize(be, counter.view()).try();
    be.write(counter.view()).try();
    be.writeln(" = 0;").try();
    Ok(());
}

// The tail of a pass: where `h.next()` lands, the step, and the `}`.
// The break label goes AFTER the closing brace, which is what makes it
// reachable from inside any construct the body happened to open.
close_pass* = (be :: CBackend, st: LoopFrame, counter: str, fold: Fold)
             Res<(), AllocError> {
    write_label(be, "cnt", st.cnt).try();
    be.writeln(": ;").try();
    (counter.len > 0).match({
        false => Ok(()),
        true  => step_counter(be, counter),
    }).try();
    be.dedent();
    be.writeln("}").try();
    // A FOLD THAT RAN TO THE END HAS AN ANSWER and a walk does not: the
    // result was seeded `None` before the first pass, and this is the
    // one place it becomes `Ok(acc)`. It is written BEFORE the break
    // label, so `h.break(v)` — which jumps past it — still wins.
    write_fold_result(be, st, fold).try();
    write_label(be, "brk", st.brk).try();
    be.writeln(": ;").try();
    be.pop_loop().try();
    Ok(());
}

step_counter = (be :: CBackend, counter: str) Res<(), AllocError> {
    be.write(counter).try();
    be.write(" = ").try();
    be.write(counter).try();
    be.writeln(" + 1;").try();
    Ok(());
}

write_label* = (be :: CBackend, stem: str, n: usize) Res<(), AllocError> {
    name ::= be.alloc.String().try();
    sym_gen(name, stem, n).try();
    be.write(name.view())
}
