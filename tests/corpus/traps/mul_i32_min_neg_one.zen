// tests/corpus/traps/mul_i32_min_neg_one.zen
// i32.MIN * -1 traps: the product is i32.MAX + 1, which does not
// exist. i32.MIN is the one value whose negation is unrepresentable

// main must name an error type. a trap never lifts into Res:
// it aborts the process
Error = Overflow | DivideByZero | OutOfBounds

main = (env: Env) Res<i32, Error> {
    x: i32       = i32.MIN;
    neg_one: i32 = -1;
    product      = x * neg_one;
    println("{}", product);
    Ok(0);
}
