// TEN .then()/.ok_or(..)/.try() LINKS, EACH UNWRAPPED TO ITS OWN
// BINDING AND PRINTED ON ITS OWN LINE: link k carries the constant
// 40+k, so the ten lines together assert that every hop produced its
// own Res, every .try() unwrapped it, and every binding stayed
// distinct across ten sequential propagation scopes.
//
// A backend that sizes ONE result slot for the whole chain -- instead
// of one per link -- collapses the hops into whatever the last link
// wrote; a lost propagation prints 0 or repeats a value.
//
// plausible wrong output: all lines equal, a zero line, or a missing
// line (an earlier hop's value clobbered by a later one).

ChainError = | Nope

main = (env: Env) Res<i32, ChainError> {
    v ::= (4 > 3).then(() { 40 }).ok_or(ChainError.Nope).try();
    println("{}", v);
    w ::= (4 > 3).then(() { 41 }).ok_or(ChainError.Nope).try();
    println("{}", w);
    x ::= (4 > 3).then(() { 42 }).ok_or(ChainError.Nope).try();
    println("{}", x);
    y ::= (4 > 3).then(() { 43 }).ok_or(ChainError.Nope).try();
    println("{}", y);
    z ::= (4 > 3).then(() { 44 }).ok_or(ChainError.Nope).try();
    println("{}", z);
    a ::= (4 > 3).then(() { 45 }).ok_or(ChainError.Nope).try();
    println("{}", a);
    b ::= (4 > 3).then(() { 46 }).ok_or(ChainError.Nope).try();
    println("{}", b);
    c ::= (4 > 3).then(() { 47 }).ok_or(ChainError.Nope).try();
    println("{}", c);
    d ::= (4 > 3).then(() { 48 }).ok_or(ChainError.Nope).try();
    println("{}", d);
    e ::= (4 > 3).then(() { 49 }).ok_or(ChainError.Nope).try();
    println("{}", e);
    Ok(0);
}
