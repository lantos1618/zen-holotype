// Carried String repeat is ITERATIVE — a 1,000,000-repeat must run flat, not recurse. Plain-cc builds
// (bootstrap CFLAGS, the harness's `cc -std=gnu11 -w`) carry no -O flag, so C tail calls are NOT
// eliminated: a self-calling rep at this depth is a verified segfault. This pins the loop route:
// half a million "ab"s (one reservation + a modulo fill), then spot-checks length and bytes.
{ request_arena, heap_allocator } = std.mem.alloc
{ String } = std.text.string
{ len, at } = std.text.str
{ to_exit } = std.core.bool
main = () i32 {
    m = request_arena(heap_allocator())
    a = m.addr()
    t = a.allocator().String().repeat("ab", 500000).finish_cstr()
    ok = len(t) == 1000000
        && t.at(0) == 'a'
        && t.at(1) == 'b'
        && t.at(999998) == 'a'
        && t.at(999999) == 'b'
    ok.to_exit()
}
