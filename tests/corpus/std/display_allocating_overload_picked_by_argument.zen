// tests/corpus/std/display_allocating_overload_picked_by_argument.zen
// two toStrings, one name: resolution is on the declared parameter
// type, so a Sink argument picks the outlined form and an Alloc
// picks the sealed allocating one. a String IS a Sink, so passing a
// buffer reaches the first. the second is DERIVED from the first, so
// they can never disagree - and this test is what says so out loud

Error = AllocError | IoError

Point = {
    x: i32,
    y: i32,
}

Point.impl(Display, {
    toString ::= (self: @Self, out :: Sink) Res<(), WriteError> {
        out.add("{}:{}", self.x, self.y)
    }
})

main = (env: Env) Res<i32, Error> {
    alloc ::= env.mem.alloc();
    p = Point(x: 5, y: 6);

    sb ::= alloc.String("").try();
    p.toString(sb).try();
    println("buffer {}", sb.view());

    owned = p.toString(alloc).try();
    println("owned {}", owned.view());

    (sb.view() == owned.view()).match({
        true  => println("agree"),
        false => println("diverged"),
    });
    Ok(0);
}
