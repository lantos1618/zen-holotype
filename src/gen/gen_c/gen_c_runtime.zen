// src/gen/gen_c/gen_c_runtime.zen
// Runtime C emitted for every program plus demand-driven helpers.
//
// Checked arithmetic tests operands before operations, avoiding signed C
// undefined behavior. Traps print the source position and exit 134. Compiler
// builtins are optional fast paths; portable checks preserve C99 behavior.

AllocError = std.mem
str, String = std.text
Emit, order = gen.gen_emit
CBackend = gen.gen_c.gen_c_state
c_prim, is_signed = gen.gen_c.gen_c_type

// The C standard this backend targets, stated in exactly one place.
C_STANDARD* : str = "C99 (ISO/IEC 9899:1999)"

// `/* text */` on its own line.
comment* = (out :: Emit, text: str) Res<(), AllocError> {
    out.bytes("/* ").try();
    out.bytes(text).try();
    out.say(" */").try();
    Ok(());
}

emit_banner* = (out :: Emit) Res<(), AllocError> {
    comment(out, "Generated by the Zen compiler. Do not edit.").try();
    comment(out, C_STANDARD).try();
    comment(
        out,
        "Deterministic: the same sources produce byte-identical C."
    ).try();
    comment(out, "No timestamp, no absolute path, no address.").try();
    out.line().try();
    out.say("#include <stdbool.h>").try();
    out.say("#include <stddef.h>").try();
    out.say("#include <stdint.h>").try();
    out.say("#include <stdio.h>").try();
    out.say("#include <stdlib.h>").try();
    out.say("#include <string.h>").try();
    out.line().try();
    Ok(());
}

// `str` uses this runtime layout; literals, field access, printing, and C
// callers must agree on its data pointer and byte length.
emit_floor* = (out :: Emit) Res<(), AllocError> {
    out.say(
        "typedef struct zg_str { unsigned char *data; size_t len; } zg_str;"
    ).try();
    out.line().try();
    emit_trap(out).try();
    emit_index(out).try();
    Ok(());
}

emit_trap = (out :: Emit) Res<(), AllocError> {
    // Both helpers never return. Select the available annotation without
    // raising the runtime's C99 language requirement.
    out.say(
        "#if defined(__STDC_VERSION__) && __STDC_VERSION__ >= 201112L"
    ).try();
    out.say("#define ZG_NORETURN _Noreturn").try();
    out.say("#elif defined(__GNUC__)").try();
    out.say("#define ZG_NORETURN __attribute__((noreturn))").try();
    out.say("#else").try();
    out.say("#define ZG_NORETURN").try();
    out.say("#endif").try();
    out.line().try();
    out.say(
        "static ZG_NORETURN void zg_trap(const char *file, unsigned long line,"
    ).try();
    out.say("                    unsigned long col, const char *what) {").try();
    out.indent();
    out.say("fflush(stdout);").try();
    out.say(
        "fprintf(stderr, \"%s:%lu:%lu: trap: %s\\n\", file, line, col, what);"
    ).try();
    out.say("fflush(stderr);").try();
    out.say("exit(134);").try();
    out.dedent();
    out.say("}").try();
    out.line().try();
    out.say(
        "static ZG_NORETURN void zg_unreachable(const char *file, unsigned long line,"
    ).try();
    out.say("                           unsigned long col) {").try();
    out.indent();
    out.say("zg_trap(file, line, col, \"unreachable match arm\");").try();
    out.dedent();
    out.say("}").try();
    out.line().try();
    out.say("#if defined(__GNUC__) && (__GNUC__ >= 5)").try();
    out.say("#define ZG_HAS_OVERFLOW_BUILTINS 1").try();
    out.say("#elif defined(__has_builtin)").try();
    out.say("#if __has_builtin(__builtin_add_overflow)").try();
    out.say("#define ZG_HAS_OVERFLOW_BUILTINS 1").try();
    out.say("#endif").try();
    out.say("#endif").try();
    out.line().try();
    Ok(());
}

// A fixed array's index is bounds-checked and TRAPS: it has no `Res`
// escape hatch, because an out-of-range index into something whose
// length is a comptime constant is a bug. `Vec.get` still returns
// `Res` — a lookup that can legitimately miss is not one.
emit_index = (out :: Emit) Res<(), AllocError> {
    out.say(
        "static size_t zg_idx_u(uint64_t i, size_t len, const char *file,"
    ).try();
    out.say("                       unsigned long line, unsigned long col) {").try();
    out.indent();
    out.say(
        "if (i >= (uint64_t)len) zg_trap(file, line, col, \"index out of bounds\");"
    ).try();
    out.say("return (size_t)i;").try();
    out.dedent();
    out.say("}").try();
    out.line().try();
    out.say(
        "static size_t zg_idx_s(int64_t i, size_t len, const char *file,"
    ).try();
    out.say("                       unsigned long line, unsigned long col) {").try();
    out.indent();
    out.say("if (i < 0 || (uint64_t)i >= (uint64_t)len)").try();
    out.indent();
    out.say("zg_trap(file, line, col, \"index out of bounds\");").try();
    out.dedent();
    out.say("return (size_t)i;").try();
    out.dedent();
    out.say("}").try();
    out.line().try();
    Ok(());
}

// Demand-driven console helpers. stdout and stderr use parallel families.
// Length guards keep null data pointers for empty strings away from `fwrite`.
emit_print* = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    be.uses_print().match({
        false => be.uses_fbuf().match({
            false => Ok(()),
            true  => write_float_scratch(out),
        }),
        true  => {
            write_print(out).try();
            write_float_scratch(out).try();
            Ok(())
        },
    })
}

// Float formatting copies from this scratch buffer before the next render.
// Forty bytes covers any `%g` double, its sign, and the terminator.
write_float_scratch = (out :: Emit) Res<(), AllocError> {
    out.say("static char zg_f64_scratch[40];").try();
    out.line().try();
    Ok(());
}

write_print = (out :: Emit) Res<(), AllocError> {
    out.say(
        "static void zg_print_bytes(const char *s, size_t n) { if (n) fwrite(s, 1, n, stdout); }"
    ).try();
    out.say(
        "static void zg_print_str(zg_str s) { if (s.len) fwrite(s.data, 1, s.len, stdout); }"
    ).try();
    out.say(
        "static void zg_print_i64(int64_t v) { fprintf(stdout, \"%lld\", (long long)v); }"
    ).try();
    out.say(
        "static void zg_print_u64(uint64_t v) { fprintf(stdout, \"%llu\", (unsigned long long)v); }"
    ).try();
    out.say(
        "static void zg_print_f64(double v) { fprintf(stdout, \"%g\", v); }"
    ).try();
    out.say(
        "static void zg_print_bool(bool v) { zg_print_bytes(v ? \"true\" : \"false\", v ? 4u : 5u); }"
    ).try();
    out.say("static void zg_print_nl(void) { fputc('\\n', stdout); }").try();
    out.line().try();
    Ok(());
}

// stderr mirrors the stdout helpers with the same formats.
emit_stderr* = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    be.uses_stderr().match({
        false => Ok(()),
        true  => write_stderr(out),
    })
}

write_stderr = (out :: Emit) Res<(), AllocError> {
    out.say(
        "static void zg_eprint_bytes(const char *s, size_t n) { if (n) fwrite(s, 1, n, stderr); }"
    ).try();
    out.say(
        "static void zg_eprint_str(zg_str s) { if (s.len) fwrite(s.data, 1, s.len, stderr); }"
    ).try();
    out.say(
        "static void zg_eprint_i64(int64_t v) { fprintf(stderr, \"%lld\", (long long)v); }"
    ).try();
    out.say(
        "static void zg_eprint_u64(uint64_t v) { fprintf(stderr, \"%llu\", (unsigned long long)v); }"
    ).try();
    out.say(
        "static void zg_eprint_f64(double v) { fprintf(stderr, \"%g\", v); }"
    ).try();
    out.say(
        "static void zg_eprint_bool(bool v) { zg_eprint_bytes(v ? \"true\" : \"false\", v ? 4u : 5u); }"
    ).try();
    out.say("static void zg_eprint_nl(void) { fputc('\\n', stderr); }").try();
    out.line().try();
    Ok(());
}

// `@scope` owns a block's LIFO defer stack and copied capture records. The
// environment union supplies the maximum required size and alignment. The
// fixed slot bound traps on registration rather than corrupting the frame.

// The name alone, before anything can spell `zg_scope *`. It is its own
// emission and not part of `emit_floor` because the floor is what EVERY
// program has, and a program that never defers must not carry this.
emit_scope_floor* = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    be.uses_scope().match({
        false => Ok(()),
        true  => write_scope_floor(out),
    })
}

write_scope_floor = (out :: Emit) Res<(), AllocError> {
    out.say("typedef struct zg_scope zg_scope;").try();
    out.say("#define ZG_DEFER_MAX 32").try();
    out.line().try();
    Ok(());
}

emit_scope* = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    be.uses_scope().match({
        false => Ok(()),
        true  => write_scope(be, out),
    })
}

write_scope = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    comment(out, "@scope: the block's own defer stack").try();
    write_defer_envs(be, out).try();
    write_defer_union(be, out).try();
    write_defer_runtime(out).try();
    Ok(());
}

write_defer_envs = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    Range(0, be.defer_env_count()).loop((h, i) {
        be.defer_env_at(i).match({
            None  => Ok(()),
            Ok(t) => write_env_line(out, t),
        }).try();
    });
    Ok(());
}

write_env_line = (out :: Emit, text: String) Res<(), AllocError> {
    out.bytes(text.view()).try();
    out.line().try();
    Ok(());
}

// A program that defers but captures nothing still needs a union with
// a member, so the `char` is not padding: it is what keeps the type
// legal when it is the only member.
write_defer_union = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    out.say("typedef union zg_defer_env {").try();
    out.say("    char zg_none;").try();
    Range(0, be.defer_env_count()).loop((h, i) {
        write_union_member(out, be.defer_env_id(i)).try();
    });
    out.say("} zg_defer_env;").try();
    out.line().try();
    Ok(());
}

write_union_member = (out :: Emit, n: usize) Res<(), AllocError> {
    out.bytes("    zg_env").try();
    out.number(n).try();
    out.bytes(" zg_u").try();
    out.number(n).try();
    out.say(";").try();
    Ok(());
}

write_defer_runtime = (out :: Emit) Res<(), AllocError> {
    out.say("typedef struct zg_defer_slot {").try();
    out.say("    void (*zg_fn)(void *);").try();
    out.say("    zg_defer_env zg_env;").try();
    out.say("} zg_defer_slot;").try();
    out.line().try();
    out.say("struct zg_scope {").try();
    out.say("    int zg_n;").try();
    out.say("    zg_defer_slot zg_slot[ZG_DEFER_MAX];").try();
    out.say("};").try();
    out.line().try();
    write_defer_push(out).try();
    write_defer_run(out).try();
    Ok(());
}

write_defer_push = (out :: Emit) Res<(), AllocError> {
    out.say(
        "static void zg_defer(zg_scope *s, void (*fn)(void *), const void *env,"
    ).try();
    out.say("                     size_t n, const char *file, unsigned long line,").try();
    out.say("                     unsigned long col) {").try();
    out.say("    if (s->zg_n >= ZG_DEFER_MAX)").try();
    out.say(
        "        zg_trap(file, line, col, \"too many deferred closures on one block\");"
    ).try();
    out.say("    s->zg_slot[s->zg_n].zg_fn = fn;").try();
    out.say("    if (n) memcpy(&s->zg_slot[s->zg_n].zg_env, env, n);").try();
    out.say("    s->zg_n++;").try();
    out.say("}").try();
    out.line().try();
    Ok(());
}

// LIFO, and BEFORE the block's drops. The slot is copied out and the
// count lowered before the call, so a closure that registers another
// one on the same block reuses the slot it is standing in without
// overwriting its own captures — and running an already-run scope is a
// no-op, which is what makes a non-local exit followed by the closing
// brace safe.
write_defer_run = (out :: Emit) Res<(), AllocError> {
    out.say("static void zg_scope_run(zg_scope *s) {").try();
    out.say("    while (s->zg_n > 0) {").try();
    out.say("        zg_defer_slot slot = s->zg_slot[s->zg_n - 1];").try();
    out.say("        s->zg_n--;").try();
    out.say("        slot.zg_fn(&slot.zg_env);").try();
    out.say("    }").try();
    out.say("}").try();
    out.line().try();
    Ok(());
}

// POSIX filesystem helpers are emitted only when a program uses `Fs`. Internal
// error ordinals are consumed by lowering and never escape generated C.

emit_fs* = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    be.uses_fs().match({
        false => Ok(()),
        true  => write_fs(out),
    })
}

write_fs = (out :: Emit) Res<(), AllocError> {
    out.say("#include <sys/stat.h>").try();
    out.say("#include <sys/file.h>").try();
    out.say("#include <fcntl.h>").try();
    out.say("#include <unistd.h>").try();
    out.say("#include <errno.h>").try();
    out.line().try();
    out.say("#ifndef S_ISDIR").try();
    out.say("#define S_ISDIR(m) (((m) & S_IFMT) == S_IFDIR)").try();
    out.say("#endif").try();
    out.line().try();
    comment(
        out,
        "a borrowed str is not NUL-terminated and the kernel wants a NUL"
    ).try();
    out.say("#define ZG_PATH_MAX 4096").try();
    out.line().try();
    write_fs_ordinals(out).try();
    write_fs_error(out).try();
    write_fs_path(out).try();
    write_fs_kind(out).try();
    write_fs_size(out).try();
    write_fs_write(out).try();
    write_fs_remove(out).try();
    write_fs_read(out).try();
    write_fs_lock(out).try();
    write_fs_unlock(out).try();
    Ok(());
}

write_fs_error = (out :: Emit) Res<(), AllocError> {
    out.say("static int zg_fs_error(int error) {").try();
    out.indent();
    out.say("switch (error) {").try();
    out.say("case ENOENT: case ENOTDIR: return ZG_FS_NOT_FOUND;").try();
    out.say("case EACCES: case EPERM: return ZG_FS_DENIED;").try();
    out.say("default: return ZG_FS_FAILED;").try();
    out.say("}").try();
    out.dedent();
    out.say("}").try();
    out.line().try();
    Ok(())
}

write_fs_ordinals = (out :: Emit) Res<(), AllocError> {
    comment(out, "FsError, by ordinal, in the order env.zen declares it").try();
    out.say("#define ZG_FS_OK 0").try();
    out.say("#define ZG_FS_NOT_FOUND 1").try();
    out.say("#define ZG_FS_DENIED 2").try();
    out.say("#define ZG_FS_IS_DIR 3").try();
    out.say("#define ZG_FS_EXISTS 4").try();
    out.say("#define ZG_FS_FAILED 5").try();
    out.line().try();
    Ok(());
}

// The copy lands in a fixed buffer so that asking whether a file exists
// never allocates: `exists` has no Alloc in its signature, so by law 1
// it may not have any memory either.
write_fs_path = (out :: Emit) Res<(), AllocError> {
    out.say(
        "static int zg_fs_path(char *buf, const unsigned char *p, size_t n) {"
    ).try();
    out.indent();
    out.say("if (n >= (size_t)ZG_PATH_MAX) return 0;").try();
    out.say("if (n) memcpy(buf, p, n);").try();
    out.say("buf[n] = '\\0';").try();
    out.say("return 1;").try();
    out.dedent();
    out.say("}").try();
    out.line().try();
    Ok(());
}

write_fs_kind = (out :: Emit) Res<(), AllocError> {
    comment(out, "-1 nothing is there, 0 a file, 1 a directory").try();
    out.say("static int zg_fs_kind(const unsigned char *p, size_t n) {").try();
    out.indent();
    out.say("char buf[ZG_PATH_MAX];").try();
    out.say("struct stat st;").try();
    out.say("if (!zg_fs_path(buf, p, n)) return -1;").try();
    out.say("if (stat(buf, &st) != 0) return -1;").try();
    out.say("return S_ISDIR(st.st_mode) ? 1 : 0;").try();
    out.dedent();
    out.say("}").try();
    out.line().try();
    Ok(());
}

// A directory is ruled out HERE and not at the read: fopen on one
// succeeds on glibc and fails only at the first fread, which would
// report the reason as a read that stopped rather than as what it is.
write_fs_size = (out :: Emit) Res<(), AllocError> {
    out.say(
        "static int zg_fs_size(const unsigned char *p, size_t n, size_t *out) {"
    ).try();
    out.indent();
    out.say("char buf[ZG_PATH_MAX];").try();
    out.say("struct stat st;").try();
    out.say("if (!zg_fs_path(buf, p, n)) return ZG_FS_FAILED;").try();
    out.say("if (stat(buf, &st) != 0)").try();
    out.say("    return zg_fs_error(errno);").try();
    out.say("if (S_ISDIR(st.st_mode)) return ZG_FS_IS_DIR;").try();
    out.say("if (st.st_size < 0) return ZG_FS_FAILED;").try();
    // /proc and other special files report st_size 0 but have content.
    // Hand back a bounded read window so fs.read allocates and fread
    // consumes until EOF; an actually-empty file just reads 0 bytes.
    out.say("*out = st.st_size == 0 ? 65536 : (size_t)st.st_size;").try();
    out.say("return ZG_FS_OK;").try();
    out.dedent();
    out.say("}").try();
    out.line().try();
    Ok(());
}

write_fs_write = (out :: Emit) Res<(), AllocError> {
    out.say("static int zg_fs_write(const unsigned char *p, size_t n,").try();
    out.say("                       const unsigned char *src, size_t len) {").try();
    out.indent();
    out.say("char buf[ZG_PATH_MAX];").try();
    out.say("FILE *fh;").try();
    out.say("if (!zg_fs_path(buf, p, n)) return ZG_FS_FAILED;").try();
    out.say("fh = fopen(buf, \"wb\");").try();
    out.say("if (fh == NULL) {").try();
    out.say("    if (errno == EISDIR) return ZG_FS_IS_DIR;").try();
    out.say("    return zg_fs_error(errno);").try();
    out.say("}").try();
    out.say(
        "if (len && fwrite(src, 1, len, fh) != len) { fclose(fh); return ZG_FS_FAILED; }"
    ).try();
    out.say("if (fclose(fh) != 0) return ZG_FS_FAILED;").try();
    out.say("return ZG_FS_OK;").try();
    out.dedent();
    out.say("}").try();
    out.line().try();
    Ok(());
}

// Remove reports whether this call removed an existing name: true when this
// call emptied the name,
// false when there was nothing at it, because "make sure this is gone"
// is answered YES by a path that holds nothing. Absence is therefore an
// Ok and never ZG_FS_NOT_FOUND here: the only ordinals this returns are
// the three refusals, which is why the gen-side chain starts at 2. The
// stat first keeps a directory away from remove(), which would happily
// rmdir an empty one -- a directory is a separate question and stays
// IsDir. ENOENT from the removal itself is still Ok(false): between the
// probe and the delete the name may have gone, and gone is what the
// caller wanted.
write_fs_remove = (out :: Emit) Res<(), AllocError> {
    out.say(
        "static int zg_fs_remove(const unsigned char *p, size_t n, bool *gone) {"
    ).try();
    out.indent();
    out.say("char buf[ZG_PATH_MAX];").try();
    out.say("struct stat st;").try();
    out.say("*gone = false;").try();
    out.say("if (!zg_fs_path(buf, p, n)) return ZG_FS_FAILED;").try();
    out.say("if (stat(buf, &st) != 0) {").try();
    out.say("    int error = zg_fs_error(errno);").try();
    out.say("    return error == ZG_FS_NOT_FOUND ? ZG_FS_OK : error;").try();
    out.say("}").try();
    out.say("if (S_ISDIR(st.st_mode)) return ZG_FS_IS_DIR;").try();
    out.say("if (remove(buf) == 0) { *gone = true; return ZG_FS_OK; }").try();
    out.say("if (errno == ENOENT || errno == ENOTDIR) return ZG_FS_OK;").try();
    out.say("if (errno == EISDIR) return ZG_FS_IS_DIR;").try();
    out.say("return zg_fs_error(errno);").try();
    out.dedent();
    out.say("}").try();
    out.line().try();
    Ok(());
}

// `*got` is what actually ARRIVED: the file may have shrunk between the
// size question and this one, and a short read is the honest length
// rather than a failure.
write_fs_read = (out :: Emit) Res<(), AllocError> {
    out.say(
        "static int zg_fs_read(const unsigned char *p, size_t n, unsigned char *dst,"
    ).try();
    out.say("                      size_t want, size_t *got) {").try();
    out.indent();
    out.say("char buf[ZG_PATH_MAX];").try();
    out.say("FILE *fh;").try();
    out.say("*got = 0;").try();
    out.say("if (!zg_fs_path(buf, p, n)) return ZG_FS_FAILED;").try();
    out.say("fh = fopen(buf, \"rb\");").try();
    out.say("if (fh == NULL) {").try();
    out.say("    if (errno == EISDIR) return ZG_FS_IS_DIR;").try();
    out.say("    return zg_fs_error(errno);").try();
    out.say("}").try();
    out.say("if (want) *got = fread(dst, 1, want, fh);").try();
    out.say("if (ferror(fh)) { fclose(fh); return ZG_FS_FAILED; }").try();
    out.say("fclose(fh);").try();
    out.say("return ZG_FS_OK;").try();
    out.dedent();
    out.say("}").try();
    out.line().try();
    Ok(());
}

// The non-blocking advisory lock is released with its descriptor, including
// after a crash. The path identifies the serialized resource and may not name
// a directory.
write_fs_lock = (out :: Emit) Res<(), AllocError> {
    comment(
        out,
        "the lock at p, or why not: Exists is someone else holding it"
    ).try();
    out.say(
        "static int zg_fs_lock(const unsigned char *p, size_t n, int *fd_out) {"
    ).try();
    out.indent();
    out.say("char buf[ZG_PATH_MAX];").try();
    out.say("struct stat st;").try();
    out.say("int fd;").try();
    out.say("*fd_out = -1;").try();
    out.say("if (!zg_fs_path(buf, p, n)) return ZG_FS_FAILED;").try();
    out.say("if (stat(buf, &st) == 0) {").try();
    out.say("    if (S_ISDIR(st.st_mode)) return ZG_FS_IS_DIR;").try();
    out.say("} else if (errno != ENOENT) return zg_fs_error(errno);").try();
    out.say("fd = open(buf, O_RDWR | O_CREAT | O_EXCL, 0666);").try();
    out.say("if (fd < 0 && errno == EEXIST)").try();
    out.say("    fd = open(buf, O_RDWR);").try();
    out.say("if (fd < 0) {").try();
    out.say("    return zg_fs_error(errno);").try();
    out.say("}").try();
    out.say("if (flock(fd, LOCK_EX | LOCK_NB) != 0) {").try();
    out.say("    int error = errno;").try();
    out.say("    close(fd);").try();
    out.say("    if (error == EWOULDBLOCK || error == EAGAIN)").try();
    out.say("        return ZG_FS_EXISTS;").try();
    out.say("    return zg_fs_error(error);").try();
    out.say("}").try();
    out.say("*fd_out = fd;").try();
    out.say("return ZG_FS_OK;").try();
    out.dedent();
    out.say("}").try();
    out.line().try();
    Ok(());
}

// Dropping the last reference to a descriptor releases its flock and
// closes it in one syscall, so the release is one line and cannot fail.
// A spent Lock releases nothing twice: the descriptor is gone, and a
// second close on it is the one error this floor refuses to risk.
write_fs_unlock = (out :: Emit) Res<(), AllocError> {
    comment(
        out,
        "the give-back: one close releases flock and fd together"
    ).try();
    out.say("static void zg_fs_unlock(int fd) {").try();
    out.indent();
    out.say("close(fd);").try();
    out.dedent();
    out.say("}").try();
    out.line().try();
    Ok(());
}

// One family per integer type the program actually performs a trapping
// operation on, in sorted order, so the runtime is a function of the
// program and not of the order its functions were lowered in.
emit_helpers* = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    seq = order(be.alloc, be.helper_types).try();
    seq.loop((h, i) {
        be.helper_types.get(i).match({
            None  => Ok(()),
            Ok(s) => emit_family(out, s.view()),
        }).try();
    });
    Ok(());
}

emit_family = (out :: Emit, prim: str) Res<(), AllocError> {
    ct  = c_prim(prim);
    uct = unsigned_of(ct);
    checked(out, ct, prim, "add", "__builtin_add_overflow").try();
    checked(out, ct, prim, "sub", "__builtin_sub_overflow").try();
    checked(out, ct, prim, "mul", "__builtin_mul_overflow").try();
    divide(out, ct, prim, "div", "/", is_signed(prim)).try();
    divide(out, ct, prim, "mod", "%", is_signed(prim)).try();
    wrapping(out, ct, uct, prim, "wadd", "+").try();
    wrapping(out, ct, uct, prim, "wsub", "-").try();
    wrapping(out, ct, uct, prim, "wmul", "*").try();
    Ok(());
}

// `static CT zg_<op>_<prim>(CT a, CT b, <position>) {`
open_helper = (out :: Emit, ct: str, prim: str, op: str, pos: bool)
              Res<(), AllocError> {
    out.bytes("static ").try();
    out.bytes(ct).try();
    out.bytes(" zg_").try();
    out.bytes(op).try();
    out.bytes("_").try();
    out.bytes(prim).try();
    out.bytes("(").try();
    out.bytes(ct).try();
    out.bytes(" a, ").try();
    out.bytes(ct).try();
    out.bytes(" b").try();
    pos.then(() {
        out.bytes(
            ", const char *file, unsigned long line, unsigned long col"
        ).try();
    });
    out.say(") {").try();
    out.indent();
    Ok(());
}

close_helper = (out :: Emit) Res<(), AllocError> {
    out.dedent();
    out.say("}").try();
    out.line().try();
    Ok(());
}

// The check happens BEFORE the operation, both ways round, for the
// reason the header gives. A builtin computes into a temporary and
// reports rather than overflowing; the fallback tests the operands
// against the type's own limits.
checked = (out :: Emit, ct: str, prim: str, op: str, builtin: str)
          Res<(), AllocError> {
    open_helper(out, ct, prim, op, true).try();
    out.say("#ifdef ZG_HAS_OVERFLOW_BUILTINS").try();
    out.bytes(ct).try();
    out.say(" r;").try();
    out.bytes("if (").try();
    out.bytes(builtin).try();
    out.say(
        "(a, b, &r)) zg_trap(file, line, col, \"integer overflow\");"
    ).try();
    out.say("return r;").try();
    out.say("#else").try();
    fallback(out, ct, prim, op).try();
    out.say("#endif").try();
    close_helper(out).try();
    Ok(());
}

// The portable form: a range test on the operands, then the wrapping
// operation `wrapped_return` writes.
fallback = (out :: Emit, ct: str, prim: str, op: str) Res<(), AllocError> {
    is_signed(prim).match({
        true  => signed_guard(out, prim, op),
        false => unsigned_guard(out, prim, op),
    }).try();
    wrapped_return(out, ct, unsigned_of(ct), c_symbol(op)).try();
    Ok(());
}

c_symbol* = (op: str) str {
    op.match({
        "add" => "+",
        "sub" => "-",
        _     => "*",
    })
}

// `a + b` overflows a signed type at the top when b is positive and at
// the bottom when it is negative, and `a - b` the other way round.
// Multiplication is the four-quadrant test: each sign pair has its own
// bound, and the divisor is never zero on the branch that uses it.
signed_guard = (out :: Emit, prim: str, op: str) Res<(), AllocError> {
    hi = max_macro(prim);
    lo = min_macro(prim);
    op.eq("add").match({
        true  => two_sided(
            out,
            "b > 0 && a > ",
            hi,
            " - b",
            "b < 0 && a < ",
            lo,
            " - b"
        ),
        false => signed_sub_or_mul(out, op, hi, lo),
    })
}

signed_sub_or_mul = (out :: Emit, op: str, hi: str, lo: str)
                    Res<(), AllocError> {
    op.eq("sub").match({
        true  => two_sided(
            out,
            "b < 0 && a > ",
            hi,
            " + b",
            "b > 0 && a < ",
            lo,
            " + b"
        ),
        false => signed_mul_guard(out, hi, lo),
    })
}

two_sided = (
    out     :: Emit,
    lead    : str,
    hi      : str,
    hi_tail : str,
    lead2   : str,
    lo      : str,
    lo_tail : str
) Res<(), AllocError> {
    out.bytes("if ((").try();
    out.bytes(lead).try();
    out.bytes(hi).try();
    out.bytes(hi_tail).try();
    out.bytes(") || (").try();
    out.bytes(lead2).try();
    out.bytes(lo).try();
    out.bytes(lo_tail).try();
    out.say("))").try();
    out.indent();
    out.say("zg_trap(file, line, col, \"integer overflow\");").try();
    out.dedent();
    Ok(());
}

signed_mul_guard = (out :: Emit, hi: str, lo: str) Res<(), AllocError> {
    out.say("if (a > 0) {").try();
    out.indent();
    quadrant(out, "b > 0", "a > ", hi, " / b").try();
    quadrant(out, "b < 0", "b < ", lo, " / a").try();
    out.dedent();
    out.say("} else if (a < 0) {").try();
    out.indent();
    quadrant(out, "b > 0", "a < ", lo, " / b").try();
    quadrant(out, "b < 0", "b < ", hi, " / a").try();
    out.dedent();
    out.say("}").try();
    Ok(());
}

quadrant = (out :: Emit, sign: str, lead: str, bound: str, tail: str)
           Res<(), AllocError> {
    out.bytes("if (").try();
    out.bytes(sign).try();
    out.bytes(" && ").try();
    out.bytes(lead).try();
    out.bytes(bound).try();
    out.bytes(tail).try();
    out.say(") zg_trap(file, line, col, \"integer overflow\");").try();
    Ok(());
}

// An unsigned type has no bottom, so each operation has one test.
unsigned_guard = (out :: Emit, prim: str, op: str) Res<(), AllocError> {
    op.eq("add").match({
        true  => one_sided(out, "a > ", max_macro(prim), " - b"),
        false => unsigned_sub_or_mul(out, op, max_macro(prim)),
    })
}

unsigned_sub_or_mul = (out :: Emit, op: str, hi: str) Res<(), AllocError> {
    op.eq("sub").match({
        true  => one_sided(out, "a < b", "", ""),
        false => one_sided(out, "b != 0 && a > ", hi, " / b"),
    })
}

one_sided = (out :: Emit, lead: str, bound: str, tail: str)
            Res<(), AllocError> {
    out.bytes("if (").try();
    out.bytes(lead).try();
    out.bytes(bound).try();
    out.bytes(tail).try();
    out.say(") zg_trap(file, line, col, \"integer overflow\");").try();
    Ok(());
}

// Wrapping operations use the same-width unsigned type, where C defines the
// arithmetic, before converting back to the signed representation.
wrapped_return = (out :: Emit, ct: str, uct: str, sym: str)
                 Res<(), AllocError> {
    out.bytes("return (").try();
    out.bytes(ct).try();
    out.bytes(")((").try();
    out.bytes(uct).try();
    out.bytes(")a ").try();
    out.bytes(sym).try();
    out.bytes(" (").try();
    out.bytes(uct).try();
    out.say(")b);").try();
    Ok(());
}

// A zero divisor traps; and on a signed type `MIN / -1` traps too, as
// an OVERFLOW — it is an overflow wearing division's clothes, and the
// message has to say so.
divide = (out :: Emit, ct: str, prim: str, op: str, sym: str, signed: bool)
         Res<(), AllocError> {
    open_helper(out, ct, prim, op, true).try();
    out.say("if (b == 0) zg_trap(file, line, col, \"divide by zero\");").try();
    signed.then(() { write_min_guard(out, prim).try() });
    out.bytes("return (").try();
    out.bytes(ct).try();
    out.bytes(")(a ").try();
    out.bytes(sym).try();
    out.say(" b);").try();
    close_helper(out).try();
    Ok(());
}

write_min_guard = (out :: Emit, prim: str) Res<(), AllocError> {
    out.bytes("if (a == ").try();
    out.bytes(min_macro(prim)).try();
    out.say(
        " && b == -1) zg_trap(file, line, col, \"integer overflow\");"
    ).try();
    Ok(());
}

// `+% -% *%` wrap, "for when wrapping is the intent" — the wrapping
// form with no guard in front of it.
wrapping = (out :: Emit, ct: str, uct: str, prim: str, op: str, sym: str)
           Res<(), AllocError> {
    open_helper(out, ct, prim, op, false).try();
    wrapped_return(out, ct, uct, sym).try();
    close_helper(out).try();
    Ok(());
}

unsigned_of* = (ct: str) str {
    ct.match({
        "int8_t"    => "uint8_t",
        "int16_t"   => "uint16_t",
        "int32_t"   => "uint32_t",
        "int64_t"   => "uint64_t",
        "ptrdiff_t" => "size_t",
        _           => ct,
    })
}

max_macro* = (prim: str) str {
    prim.match({
        "i8"    => "INT8_MAX",
        "i16"   => "INT16_MAX",
        "i32"   => "INT32_MAX",
        "i64"   => "INT64_MAX",
        "int"   => "INT64_MAX",
        "u8"    => "UINT8_MAX",
        "u16"   => "UINT16_MAX",
        "u32"   => "UINT32_MAX",
        "u64"   => "UINT64_MAX",
        "usize" => "SIZE_MAX",
        _       => "0",
    })
}

min_macro* = (prim: str) str {
    prim.match({
        "i8"  => "INT8_MIN",
        "i16" => "INT16_MIN",
        "i32" => "INT32_MIN",
        "i64" => "INT64_MIN",
        "int" => "INT64_MIN",
        _     => "0",
    })
}
