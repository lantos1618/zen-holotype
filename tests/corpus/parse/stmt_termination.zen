// DESIGN.md writes `nine = apply(add_i32, 4, 5);` WITH a semicolon and
// `Circle1 = AddFoo(Circle)` WITHOUT one, on the next line of the same
// block. both forms are attested, so both must parse. GAP: DESIGN.md
// never states the statement-termination rule.

double = (n: i32) i32 { n * 2 }

main = (env: Env) Res<i32, ArgError> {
    a = double(3)
    b = double(4);
    c = (a == 6).match({
        true => 1,
        false => 0,
    })
    println("{}", a + b + c);
    Ok(0);
}
