// `errorln` is Console's SECOND member and there is no third spelling
// of a console write: the bare `errorln(..)` sugar exists only for the
// two names `sema_call.is_print_sugar` answers to, so bare `errorln`
// is an undefined name -- reached with `env.out.errorln(..)` or not at
// all. DESIGN.md's sugar clause is about println; nothing here invents.

main = (env: Env) Res<i32, IoError> {
    errorln("not a sugar");
    Ok(0);
}
