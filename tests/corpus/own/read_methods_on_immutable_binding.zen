// the receiver rule only ever restricts `::` methods. a `:` method
// works on either kind of binding, and a `::` binding is not somehow
// barred from the read-only half of its own type.
//
// `w` is a `:` Vec — legal, and read-only forever. `v` is `::` and
// calls both. if a checker ever ties method choice to the binding
// marker in both directions, this file goes red.

Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    alloc ::= env.mem.alloc();

    v ::= alloc.Vec<i32>();
    v.add(7).try();
    v.get(0).match({
        Ok(n) => println("{}", n),
        None  => println("empty"),
    })

    w = alloc.Vec<i32>();
    w.get(0).match({
        Ok(n) => println("{}", n),
        None  => println("empty"),
    })

    Ok(0);
}
