halloc = std.mem.heap
sets = std.collections.set
{ println } = std.text.fmt
main = () i32 {
    alloc := halloc.gpa()
    a := alloc.addr()
    x := sets.of(a, 1).expect("of")
    x = x.add(a, 2).expect("add")
    x = x.add(a, 3).expect("add")
    y := sets.of(a, 3).expect("of")
    y = y.add(a, 4).expect("add")
    y = y.add(a, 5).expect("add")
    u := sets.union(a, x, y).expect("union")
    println(u.len())
    n := sets.intersect(a, x, y).expect("intersect")
    println(n.len())
    println(n.has(3) ? 1 : 0)
    d2 := sets.difference(a, x, y).expect("difference")
    println(d2.len())
    println(d2.has(1) ? 1 : 0)
    println(d2.has(3) ? 1 : 0)
    println(x.len())
    x.free(a)
    y.free(a)
    u.free(a)
    n.free(a)
    d2.free(a)
    0
}
