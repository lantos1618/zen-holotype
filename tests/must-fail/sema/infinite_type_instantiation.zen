// the same divergence in a TYPE rather than a function: Tree<i32> needs
// Tree<Vec<i32>> needs Tree<Vec<Vec<i32>>>. no value of the type is ever
// constructed -- naming it in a signature is enough to require it.
//
// position: the field whose type widens the parameter.

Tree<T> = {
    value: T,
    child: Tree<Vec<T>>,
}

root_value = (t: Tree<i32>) i32 { t.value }

main = (env: Env) Res<i32, AllocError> {
    Ok(0);
}
