            path: "examples/tour.zen",
            want_exit: "0",
            want_out: "",
            check_out: false,
        ),
        FixtureCase(
            path: "examples/http_tool.zen",
            want_exit: "2",
            want_out: "usage: http_tool [-i] http://host[:port][/path]\n",
            check_out: true,
        ),
    ])
    // ── (c) `zenc check` accept/reject fixtures (reuse harness_lib.run_verdict on inline SOURCE) ───
    vd := run_verdicts("build check", [
        VerdictCase(
            src: "main = () i32 { 6 * 2 }\n",
            should_pass: true,
            kind: "",
        ),
        VerdictCase(
            src: "{ eq } = std.text.str\nmain = () i32 { eq(\"ab\", \"ab\").match ({ true => 1, false => 0 }) }\n",
            should_pass: true,
            kind: "",
        ),
        VerdictCase(
            src: "main = () i32 { if (1 < 2) { return 9 } 7 }\n",
            should_pass: false,
            kind: "no-if",
        ),
        VerdictCase(
            src: "// `if` in prose is not syntax\nmain = () i32 { word := \"if\"  gift := 42  gift }\n",
            should_pass: true,
            kind: "",
        ),
        VerdictCase(
            src: "main = () i32 { 1 < 2 }\n",
            should_pass: false,
            kind: "return-fit",
        ),
        VerdictCase(
            src: "Msg*: A | B\nmain = () i32 {\n    msg := Msg.A()\n    msg.match({ .A => 1, .B => \"bad\" })\n}\n",
            should_pass: false,
            kind: "return-fit",
        ),
        VerdictCase(
            src: "Msg*: A | B\nmain = () i32 {\n    msg := Msg.A()\n    bad := msg.match({ .A => 1, .B => (1 < 2) })\n    0\n}\n",
            should_pass: false,
            kind: "return-fit",
        ),
        VerdictCase(
            src: "main = () i32 { undefined_fn(1, 2) }\n",
            should_pass: false,
            kind: "undefined-name",
        ),
        VerdictCase(
            src: "num = std.text.num\nmain = () i32 { s := num.integer(42)  0 }\n",
