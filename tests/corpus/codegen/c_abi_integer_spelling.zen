// C ABI integers are valid in foreign signatures without pretending their
// target-dependent widths are Zen's fixed-width arithmetic types.

abs = (n: c_int) c_int
to_c_int = (n: i32) c_int
to_i32 = (n: c_int) i32

abi_signature = (
    sc    : c_schar,
    uc    : c_uchar,
    ss    : c_short,
    us    : c_ushort,
    si    : c_int,
    ui    : c_uint,
    sl    : c_long,
    ul    : c_ulong,
    sll   : c_longlong,
    ull   : c_ulonglong,
    chars : Ptr<c_char>
) c_ulonglong

main = (env: Env) Res<i32, AllocError> {
    native = to_c_int(-7);
    println("abs={}", to_i32(abs(native)));
    Ok(0)
}
