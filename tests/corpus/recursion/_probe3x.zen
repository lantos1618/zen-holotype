Link = {
    value: i64,
    next: Ptr<Link>,
}

// unwrap create ONCE in main (match, not try), then pass the plain Ptr
// down; the recursive builder allocates through a helper so the generic
// call never sits inside a block arm.
cell_of = (alloc: Alloc) Link {
    alloc.create<Link>().match({
        Ok(p)  => Link(value: 0, next: p),
        Err(_) => Link(value: -1, next: null_ptr<Link>()),
    });
}

build = (alloc: Alloc, n: i64) Link {
    (n <= 0).match({
        true  => Link(value: 1000, next: null_ptr<Link>()),
        false => {
            wrapped = cell_of(alloc);
            rest = build(alloc, n - 1);
            wrapped.next.write(0, rest);
            Link(value: n * 10, next: wrapped.next);
        },
    });
}

sum = (node: Link) i64 {
    node.next.is_null().match({
        true  => node.value,
        false => node.value + sum(node.next.read(0)),
    });
}

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    println("{}", sum(build(alloc, 5)));
    Ok(0);
}
