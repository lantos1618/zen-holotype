// probeV: create in a helper, receiver bound inside the helper from a param Env
mk = (env: Env) Res<Ptr<i64>, AllocError> {
    a ::= env.mem.alloc();
    p = a.create<i64>().try();
    p.write(0, 7);
    Ok(p);
}

main = (env: Env) Res<i32, AllocError> {
    p = mk(env).try();
    println("v {}", p.read(0));
    Ok(0);
}
