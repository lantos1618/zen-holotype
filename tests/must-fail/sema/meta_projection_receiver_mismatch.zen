// A PROJECTION THROUGH THE WRONG RECEIVER (`docs/design_meta.md` §7,
// M4 slice 2). The walk reads ONE's fields; the body projects through
// an OTHER. The names are comptime but the storage is the receiver's,
// and OTHER has no `only` — so the field the pass is for is named in
// the diagnostic, not the `at`.
//
// position: the projection call, whose field the receiver lacks.

One = { only: i64 }

Other = { mine: i64 }

main = (env: Env) Res<i32, AllocError> {
    o = Other(mine: 1);
    @meta(x: One).fields().loop((h, field) {
        println("{}", o.at(field));
    });
    Ok(0);
}
