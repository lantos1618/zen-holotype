// tools/fuzz-corpus.zen — run every known-good Zen program through the ASan compiler, in Zen.
//
//   ./zen run tools/fuzz-corpus.zen            # from the repository root
//   ./zen run tools/fuzz-corpus.zen /path/to/repo
//
// Silent memory bugs (OOB reads, use-after-free, integer UB) frequently surface just by exercising
// VALID inputs under sanitizers, so this corpus pass is high-value on its own — no mutation required.
// Every `tests/fixtures/zen/**.zen` and `examples/**.zen` file is run through both `check` and `build`.
//
// Reports every input that trips a sanitizer or a signal (segv/abort). A non-sanitizer nonzero exit
// (a normal `check` rejection or type error) is NOT a finding — that is the compiler doing its job.
//
// Three FAIL-CLOSED guards, each exit 2, because a sweep that ran nothing must not report green:
//   • zen-asan missing and scripts/fuzz-build.sh could not produce it
//   • zen-asan still missing after the build
//   • an empty corpus
{ Allocator, heap_allocator } = std.mem.alloc
{ save, shell } = std.io.file
{ is_dir, read_dir } = std.sys.fs
{ access } = std.c.libc
{ run } = std.sys.process
{ arg, argc, getEnv, set_env } = std.sys.os
{ cat_in, contains, ends_with, is_empty, len, split_in, sv_lt, try_parse_int, view } = std.text.str
{ sort_by } = std.sort
{ String, init, append_in, finish_in } = std.text.string
{ arg_int, arg_str, format } = std.io.print
{ expect } = std.core.result
{ then } = std.core.bool
// access(path, X_OK) is the `[ -x ]` test. Named ACCESS_X_OK, not X_OK: a top-level Zen global lowers
// to a C global of the same name and `X_OK` is already a <unistd.h> macro.
ACCESS_X_OK = 1
// detect_leaks=0: the arena allocator never frees, so leaks are expected and would bury real hits.
ASAN_OPTS = "detect_leaks=0:abort_on_error=1:halt_on_error=1:detect_stack_use_after_return=1"
UBSAN_OPTS = "halt_on_error=1:print_stacktrace=1"
// grep -E 'runtime error:|ERROR|SUMMARY|#[0-9]' | head -12 — the excerpt printed under a hit banner
EXCERPT_LINES = 12
g_files ::= 0
g_hits ::= 0
g_found ::= 0
// ── path helpers ──────────────────────────────────────────────────────────────
is_exec = (path: StringView) bool { path.access(ACCESS_X_OK) == 0 }
// ── byte-lexicographic ordering, so the sweep visits the corpus in a stable order ──
// (`find` emits directory order, which varies between checkouts; the set of files is the same and the
// summary counts are identical, but a sorted walk makes a HIT list reproducible run to run)
sort_paths = (xs: MutSlice<StringView>) void {
    xs.sort_by((x: StringView, y: StringView) bool { x.sv_lt(y) })
}
// ── the corpus walk (`find <dir> -name '*.zen'`, a missing dir contributing nothing) ──
walk = (mp: Allocator, dir: StringView, acc: String) String {
    entries = mp.addr().read_dir(dir).expect("fuzz-corpus: cannot read directory")
    acc2 ::= acc
    entries.loop((h, i, entry) {
        full = mp.addr().cat_in(mp.addr().cat_in(dir, "/"), entry)
        acc2 = full.is_dir().match ({
            true  => mp.walk(full, acc2),
            false => entry.ends_with(".zen").match ({
                true  => {
                    g_found = g_found + 1
                    line = (g_found == 1).then({ full }, { mp.addr().cat_in("\n", full) })
                    mp.addr().append_in(acc2, line).expect("fuzz-corpus: oom")
                },
                false => acc2,
            }),
        })
    })
    acc2
}
walk_if_dir = (mp: Allocator, dir: StringView, acc: String) String {
    dir.is_dir().then({ mp.walk(dir, acc) }, { acc })
}
// ── hit classification ────────────────────────────────────────────────────────
// A sanitizer error prints "runtime error:" (UBSan) or an "AddressSanitizer"/"LeakSanitizer" banner;
// the runtime frames name __asan / __ubsan. A signal exit (rc >= 128) counts on its own.
is_sanitizer = (o: StringView) bool {
    o.contains("runtime error:")
        || o.contains("AddressSanitizer")
        || o.contains("LeakSanitizer")
        || o.contains("__asan")
        || o.contains("__ubsan")
}
// `#[0-9]`: a stack-frame marker anywhere in the line
has_frame_mark = (line: StringView) bool {
    v = line.view()
    found ::= false
    v.loop((h, i, b) {
        found = found || b == '#' && i + 1 < v.len && v[i + 1] >= '0' && v[i + 1] <= '9'
    })
    found
}
is_excerpt_line = (line: StringView) bool {
    line.contains("runtime error:")
        || line.contains("ERROR")
        || line.contains("SUMMARY")
        || line.has_frame_mark()
}
print_excerpt = (mp: Allocator, o: StringView) void {
    kept ::= 0
    mp.addr().split_in(o, '\n').loop((h, i, line) {
        (is_excerpt_line(line) && kept < EXCERPT_LINES).then({
            kept = kept + 1
            format("{}\n", [arg_str(line)])
        })
    })
}
report_hit = (mp: Allocator, mode: StringView, f: StringView, o: StringView, rc: i64) void {
    format("=== SANITIZER HIT: {} {} (rc={}) ===\n", [arg_str(mode), arg_str(f), arg_int(rc)])
    mp.print_excerpt(o)
    g_hits = g_hits + 1
}
// ── the probe plan ────────────────────────────────────────────────────────────
// A probe is one `$ASAN <mode> <file>` invocation. They are ENUMERATED first and RUN second (see
// run_probes) so the run can fan out: each probe is independent, and 500-odd sequential compiler
// invocations under ASan were the whole cost of this gate.
Probe*: {
    mode: StringView,
    path: StringView,
}
probe_buf = (mp: Allocator, n: i64) MutSlice<Probe> {
    slice(mp.addr().acquire(n * sizeof(Probe)).assert_nonnull(), n)
}
// Per-probe scratch, keyed by INDEX: `p_<i>.txt` is the probe's combined stdout+stderr and `p_<i>.rc`
// its exit status. Both are per-probe because the sweep is concurrent — the old single
// `-o /tmp/fuzz-corpus.out` was a shared output path, which is what made a parallel sweep unsound
// rather than merely un-attempted.
RUN_DIR = "/tmp/fuzz-corpus-run"
itoa = (mp: Allocator, n: i64) StringView {
    mp.addr().finish_in(mp.addr().integer(n).expect("fuzz-corpus: oom")).expect("fuzz-corpus: oom")
}
probe_path = (mp: Allocator, stem: StringView, i: i64, ext: StringView) StringView {
    mp.addr().cat_in(mp.addr().cat_in(mp.addr().cat_in(RUN_DIR, stem), mp.itoa(i)), ext)
}
// std.text.string's append_in takes ONE part; the command lines are built from many, so join here
// rather than nesting a dozen calls at each site.
add_all = (mp: Allocator, s: String, parts: MutSlice<StringView>) String {
    out ::= s
    parts.loop_at((i, t) { out = mp.addr().append_in(out, t).expect("fuzz-corpus: oom") })
    out
}
// One command line: run the probe, fold stderr in (std.sys.process captures stdout only, and every
// sanitizer banner lands on stderr), then record the exit status. `-o` goes to a per-probe path.
probe_cmd = (mp: Allocator, s: String, asan: StringView, p: Probe, i: i64) String {
    mp.add_all(s, [asan, " ", p.mode, " ", p.path, " -o ", mp.probe_path("/o_", i, ""), " > ", mp.probe_path("/p_", i, ".txt"), " 2>&1; printf %s $? > ", mp.probe_path("/p_", i, ".rc"), "\n"])
}
// A balanced worker pool: `nproc` shells, each running every n'th command line. Round-robin (rather
// than contiguous blocks) keeps the mix even — a `check` is fast and a `build` forks cc — so no worker
// is left holding all the slow probes. Results are keyed by index, so completion order is irrelevant
// and the REPORT stays in corpus order.
POOL_RUNNER = () StringView {
    "set -u\nT=\"$1\"\nN=\"$(nproc 2>/dev/null || echo 4)\"\nw=0\nwhile [ \"$w\" -lt \"$N\" ]; do\n  awk -v w=\"$w\" -v n=\"$N\" 'NR % n == w' \"$T/cmds.txt\" | sh &\n  w=$((w + 1))\ndone\nwait\n"
}
// Classify ONE finished probe from its recorded output and exit status. A missing `.rc` means the
// probe never ran to completion — reported as a hit, never silently skipped.
classify = (mp: Allocator, p: Probe, i: i64) void {
    mp.addr().contents_in(mp.probe_path("/p_", i, ".rc")).match ({
        .Err(e)  => mp.report_hit(p.mode, p.path, "probe produced no exit status", 0 - 1),
        .Ok(rcs) => {
            o = mp.addr().contents_in(mp.probe_path("/p_", i, ".txt")).match ({
                .Ok(t)  => t,
                .Err(e) => "",
            })
            rc = rcs.try_parse_int().match ({
                .Ok(v)  => v,
                .Err(x) => 0 - 1,
            })
            (is_sanitizer(o) || rc >= 128 || rc < 0).then({
                mp.report_hit(p.mode, p.path, o, rc)
            })
        },
    })
}
// ── the EOF-adjacent edge shapes, carried here as literal bytes ───────────────
// `at` is a raw indexed load whose ONLY bound is the NUL terminator, so a lookahead past the byte the
// caller has proven non-NUL reads off the end of the source buffer — real UB, in the parser, on
// untrusted input. Three shapes did exactly that until compiler.lex / compiler.parse_atom guarded the
// last read; each is the minimal input that trips its site:
//   `…}`    an operator char as the LAST byte  — sym_end probed pos+2 for `::=`, past the NUL
//   `…"hi\` a backslash as the last byte       — str_end's escape skip stepped p+2, past the NUL
//   `…'\x`  a truncated hex escape             — hex2 read the low nibble, past the NUL
// A corpus FILE cannot pin them: each ends mid-token with no trailing newline, and the fmt gate (which
// covers tests/, examples/ and tools/) would rewrite that ending away. So they are written out and
// swept through the same ASan `check` as everything else.
EDGE_SRCS = () MutSlice<StringView> {
    ["main = () void {\n    x = 1\n    x.println()\n}", "main = () void {\n    s = \"hi\\", "main = () void {\n    c = '\\x"]
}
// Each edge shape gets its OWN file: they are swept concurrently with everything else, so a single
// rewritten scratch path would race.
edge_path = (mp: Allocator, i: i64) StringView { mp.probe_path("/edge_", i, ".zen") }
write_edges = (mp: Allocator) void {
    EDGE_SRCS().loop_at((i, src) {
        mp
            .edge_path(i)
            .save(src, src.len())
            .expect("fuzz-corpus: cannot write the edge-shape input")
    })
}
// ── setup: the ASan compiler must exist, or the sweep proves nothing ──────────
fail2 = (msg: StringView) i32 {
    format("{}\n", [arg_str(msg)])
    2
}
// `[ -x "$ASAN" ] || scripts/fuzz-build.sh "$ASAN"` — the builder's own output goes straight to the
// terminal (std.io.file.shell is the non-capturing system(3) floor), exactly as the shell version did.
build_asan = (mp: Allocator, root: StringView, asan: StringView) bool {
    cmd = mp
        .addr()
        .cat_in(mp.addr().cat_in(mp.addr().cat_in(root, "/scripts/fuzz-build.sh "), asan), "")
    cmd.shell().match ({
        .Ok(rc) => rc == 0,
        .Err(e) => false,
    })
}
ensure_asan = (mp: Allocator, root: StringView, asan: StringView) i32 {
    asan.is_exec().match ({
        true  => 0,
        false => mp.build_asan(root, asan).match ({
            true  => asan.is_exec().match ({
                true  => 0,
                false => fail2(mp
                    .addr()
                    .cat_in("fuzz-corpus: FAIL — ", mp
                        .addr()
                        .cat_in(asan, " is missing after build"))),
            }),
            false => fail2(mp.addr().cat_in("fuzz-corpus: FAIL — could not build ", asan)),
        }),
    })
}
// Enumerate the plan: `check` and `build` for every corpus file, then `check` for each edge shape.
// Corpus order is preserved, so the hit list reads the same as the serial sweep did.
plan_probes = (mp: Allocator, corpus: MutSlice<StringView>) MutSlice<Probe> {
    ne = EDGE_SRCS().len
    ps :: MutSlice<Probe> = mp.probe_buf(corpus.len * 2 + ne)
    corpus.loop_at((i, f) {
        ps[i * 2] = Probe(
            mode: "check",
            path: f,
        )
        ps[i * 2 + 1] = Probe(
            mode: "build",
            path: f,
        )
    })
    EDGE_SRCS().loop_at((i, src) {
        ps[corpus.len * 2 + i] = Probe(
            mode: "check",
            path: mp.edge_path(i),
        )
    })
    ps
}
// Write the command list, run it through the pool, and fail closed if the pool itself could not run.
// ── SHARDING: split the probe list across CI runners ─────────────────────────
// The sweep is core-bound — the pool already saturates one machine, so the only lever left is more
// machines. FUZZ_SHARDS=<n> FUZZ_SHARD=<i> runs probes where `index % n == i`; the default 1/0 is the
// whole sweep, so a plain `./zen run tools/fuzz-corpus.zen` is unchanged. Indices stay GLOBAL, so
// scratch paths never collide and each shard's hit list is still in corpus order.
env_int = (name: StringView, dflt: i64) i64 {
    e = getEnv(name)
    is_empty(e).match ({
        true  => dflt,
        false => e.try_parse_int().match ({
            .Ok(v)  => v,
            .Err(x) => dflt,
        }),
    })
}
shards = () i64 {
    n = env_int("FUZZ_SHARDS", 1)
    (n < 1).then({ 1 }, { n })
}
shard_index = () i64 {
    i = env_int("FUZZ_SHARD", 0)
    (i < 0 || i >= shards()).then({ 0 }, { i })
}
mine = (i: i64) bool { i % shards() == shard_index() }
run_probes = (mp: Allocator, asan: StringView, ps: MutSlice<Probe>) bool {
    cmds ::= mp.addr().init(ps.len * 256).expect("fuzz-corpus: oom")
    ps.loop_at((i, p) { cmds = i.mine().then({ mp.probe_cmd(cmds, asan, p, i) }, { cmds }) })
    text = mp.addr().finish_in(cmds).expect("fuzz-corpus: oom")
    cmds_path = mp.addr().cat_in(RUN_DIR, "/cmds.txt")
    cmds_path.save(text, text.len()).expect("fuzz-corpus: cannot write the probe list")
    runner = mp.addr().cat_in(RUN_DIR, "/pool.sh")
    runner
        .save(POOL_RUNNER(), POOL_RUNNER().len())
        .expect("fuzz-corpus: cannot write the pool runner")
    mp.addr().cat_in(mp.addr().cat_in("sh ", runner), mp.addr().cat_in(" ", RUN_DIR)).shell().match ({
        .Ok(rc) => rc == 0,
        .Err(e) => false,
    })
}
sweep = (mp: Allocator, asan: StringView, corpus: MutSlice<StringView>) i32 {
    corpus.sort_paths()
    mp
        .addr()
        .cat_in(mp.addr().cat_in("rm -rf ", RUN_DIR), mp.addr().cat_in(" && mkdir -p ", RUN_DIR))
        .shell()
        .expect("fuzz-corpus: cannot prepare the run directory")
    mp.write_edges()
    ps = mp.plan_probes(corpus)
    (mp.run_probes(asan, ps) == false).then({
        return fail2("fuzz-corpus: FAIL — the probe pool did not run")
    })
    ps.loop_at((i, p) { i.mine().then({ mp.classify(p, i) g_files = g_files + 1 }) })
    format("shard {}/{}: {} probes, {} sanitizer hits\n", [arg_int(shard_index()), arg_int(shards()), arg_int(g_files), arg_int(g_hits)])
    (g_hits == 0).then({ 0 }, { 1 })
}
run_sweep = (mp: Allocator, root: StringView, asan: StringView) i32 {
    empty = mp.addr().init(8192).expect("fuzz-corpus: oom")
    fixtures = mp.walk_if_dir(mp.addr().cat_in(root, "/tests/fixtures/zen"), empty)
    both = mp.walk_if_dir(mp.addr().cat_in(root, "/examples"), fixtures)
    listed = mp.addr().finish_in(both).expect("fuzz-corpus: oom")
    // An empty corpus is a broken run, not a clean one.
    (g_found == 0).match ({
        true  => fail2("fuzz-corpus: FAIL — no corpus files found under tests/fixtures/zen or examples"),
        false => mp.sweep(asan, mp.addr().split_in(listed, '\n')),
    })
}
main = () i32 {
    mp = heap_allocator()
    root = (argc() > 1).then({ arg(1) }, { "." })
    asan = mp.addr().cat_in(root, "/zen-asan")
    set_env("ASAN_OPTIONS", ASAN_OPTS)
    set_env("UBSAN_OPTIONS", UBSAN_OPTS)
    (mp.ensure_asan(root, asan) == 0).then({ mp.run_sweep(root, asan) }, { 2 })
}
