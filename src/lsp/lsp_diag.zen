// src/lsp/lsp_diag.zen
// `textDocument/publishDiagnostics`: what a build found, said to a client.
// Changes mark a pending whole-program build; settling ensures that build and
// publishes one notification per affected URI. Empty lists clear previous
// diagnostics. Byte-identical notifications are suppressed without changing
// the server's remembered state.

str, String = std.text
Vec, Map = std.collections
Alloc, AllocError = std.mem
Note = std.parse.parse_diag
Checker = sema.sema_check
root_for, relative_to = zen.zen_path
write_range = lsp.lsp_pos
obj, arr, Nest, written = std.json
write_frame, write_decimal = lsp.lsp_frame
path_of = lsp.lsp_uri
// Arena-backed string ownership helper.
own_str = lsp.lsp_reply
// The build retained by the session and its diagnostic rows.
Built, Spot* = lsp.lsp_built
// Semantic name classifications gathered from the retained build.
Classed = lsp.lsp_colour

// Read-only query access to a retained checker and its compilation root.
Shared* = {
    c*: Res<Checker>,
    root*: str,
}

// Pending diagnostic work, published state, and the shared build.
Diagnostics* = {
    a: Alloc,

    // The newest document requiring a whole-program build, or empty.
    owed :: str = "",

    // Session-owned URIs currently carrying non-empty diagnostics.
    showing :: Vec<str>,

    // Closed documents awaiting an empty diagnostic notification.
    closing :: Vec<str>,

    // Build shared by diagnostics and document queries.
    built :: Built,

    // Semantic classes are valid only for the most recently settled text.
    fresh :: bool = false,

    // Last notification body per URI, owned by the session arena.
    said :: Map<str, str>,

    // Mark changed text for the next settle and stale semantic classes.
    owes* = (self :: @Self, uri: str) () {
        self.built.invalidate();
        self.owed  = uri;
        self.fresh = false;
    }

    // Disk changes retire the build because its cache key covers overlays,
    // not dependency bytes read from disk.
    stales* = (self :: @Self, uri: str) () {
        self.built.invalidate();
        self.fresh = false;
        self.owed.is_empty().then(() { self.owed = uri; });
    }

    // Closing retires the overlay build and schedules a diagnostic clear.
    closed* = (self :: @Self, uri: str, next: str)
              Res<(), AllocError> {
        self.built.invalidate();
        self.fresh = false;
        self.owed  = next;
        self.closing.find((u) { u.eq(uri) }).match({
            Ok(_) => written(),
            None  => self.closing.add(uri),
        })
    }

    // Sorted semantic classifications from the last settle. Empty means the
    // caller should use lexical classifications.
    classes_for* = (self :: @Self, t: Alloc, uri: str)
                   Res<Vec<Classed>, AllocError> {
        self.fresh.match({
            false => Ok(t.Vec<Classed>()),
            true  => self.built.classed_for(t, uri),
        })
    }

    // Ensure the workspace build and expose it to a document query.
    shared* = (self :: @Self, env: Env, workspace: str, uris: Vec<str>,
               docs: Map<str, str>, path: str, t: Alloc)
              Res<Shared, AllocError> {
        root = root_for(env, t, workspace, path);
        self.built.ensure(env, root, relative_to(root, path), uris, docs).try();
        Ok(Shared(c: self.built.checker(), root: self.built.root()));
    }

    // Ensure one whole-program build for the pending state and publish it.
    // The overlay includes every open document; `t` is settle-local scratch.
    settled* = (self :: @Self, env: Env, workspace: str, uris: Vec<str>,
                docs: Map<str, str>, t: Alloc, out :: String)
               Res<(), AllocError> {
        self.clear_closed(env, t, uris, docs, out).try();
        self.owed.is_empty().match({
            true  => written(),
            false => self.build_owed(env, workspace, uris, docs, t, out),
        })
    }

    clear_closed = (self :: @Self, env: Env, t: Alloc, uris: Vec<str>,
                    docs: Map<str, str>, out :: String)
                   Res<(), AllocError> {
        empty ::= t.Vec<Spot>();
        self.closing.loop((h, uri) {
            self.say_one(env, t, uri, uris, docs, empty, out).try();
        });
        kept ::= self.a.Vec<str>();
        self.showing.loop((h, uri) {
            self.closing.find((u) { u.eq(uri) }).match({
                Ok(_) => written(),
                None  => kept.add(uri),
            }).try();
        });
        self.showing = kept;
        self.closing = self.a.Vec<str>();
        Ok(())
    }

    // Without a workspace root, suppress diagnostics rather than report
    // imported names as undefined from an incomplete single-file build.
    build_owed = (self :: @Self, env: Env, workspace: str, uris: Vec<str>,
                  docs: Map<str, str>, t: Alloc, out :: String)
                 Res<(), AllocError> {
        uri       = self.owed;
        self.owed = "";
        path      = path_of(uri);
        root      = root_for(env, t, workspace, path);
        (workspace.is_empty() || root.is_empty()).match({
            true  => written(),
            false => self.told(
                env,
                root,
                relative_to(root, path),
                uri,
                uris,
                docs,
                t,
                out
            ),
        })
    }

    told = (self :: @Self, env: Env, root: str, entry: str, uri: str,
            uris: Vec<str>, docs: Map<str, str>, t: Alloc, out :: String)
           Res<(), AllocError> {
        self.built.ensure(env, root, entry, uris, docs).try();
        self.fresh = true;
        // If the retained build is unexpectedly absent, publish nothing.
        self.built.spots().match({
            None      => written(),
            Ok(spots) => self.say_all(env, t, uri, uris, docs, spots, out),
        })
    }

    // Publish the edited URI, current diagnostic URIs, then required clears.
    say_all = (self :: @Self, env: Env, t: Alloc, uri: str, uris: Vec<str>,
               docs: Map<str, str>, spots: Vec<Spot>, out :: String)
              Res<(), AllocError> {
        now ::= t.Vec<str>();
        uris_of(spots, now).try();
        self.say_one(env, t, uri, uris, docs, spots, out).try();
        now.loop((h, u) {
            u.eq(uri).match({
                true  => written(),
                false => self.say_one(env, t, u, uris, docs, spots, out),
            }).try();
        });
        self.take_back(env, t, uri, now, uris, docs, spots, out).try();
        self.remember_showing(now).try();
        Ok(());
    }

    // Copy URIs into the session arena because the build arena is replaceable.
    remember_showing = (self :: @Self, now: Vec<str>) Res<(), AllocError> {
        self.showing = self.a.Vec<str>();
        now.loop((h, u) {
            kept = own_str(self.a, u).try();
            self.showing.add(kept).try();
        });
        Ok(());
    }

    // Send one URI's list only when its serialized body changed.
    say_one = (self :: @Self, env: Env, t: Alloc, uri: str, uris: Vec<str>,
               docs: Map<str, str>, spots: Vec<Spot>, out :: String)
              Res<(), AllocError> {
        body ::= t.String().try();
        write_notification(
            t,
            uri,
            text_of(env, t, uri, docs),
            spots,
            body
        ).try();
        self.said.get(uri).match({
            None     => self.send(uri, body, out),
            Ok(prev) => prev.eq(body.view()).match({
                true  => written(),
                false => self.send(uri, body, out),
            }),
        })
    }

    send = (self :: @Self, uri: str, body: String, out :: String)
           Res<(), AllocError> {
        kept_uri  = own_str(self.a, uri).try();
        kept_body = own_str(self.a, body.view()).try();
        self.said.set(kept_uri, kept_body).try();
        write_frame(body.view(), out)
    }

    // Clear previously showing URIs absent from the current result.
    take_back = (self :: @Self, env: Env, t: Alloc, uri: str, now: Vec<str>,
                 uris: Vec<str>, docs: Map<str, str>, spots: Vec<Spot>,
                 out :: String) Res<(), AllocError> {
        self.showing.loop((h, u) {
            gone(u, uri, now).match({
                false => written(),
                true  => self.say_one(env, t, u, uris, docs, spots, out),
            }).try();
        });
        Ok(());
    }
}

Diagnostics.impl(Drop, {
    drop = (self :: @Self) () { self.built.drop(); }
})

Diagnostics* = (a: Alloc, env: Env) Diagnostics {
    Diagnostics(
        a: a,
        showing: a.Vec<str>(),
        closing: a.Vec<str>(),
        built: env.Built(),
        said: a.Map<str, str>()
    )
}

// This URI was showing errors and is not among the ones that have them
// now.
gone = (u: str, uri: str, now: Vec<str>) bool {
    u.eq(uri).match({
        true  => false,
        false => now.find(
            (n) { n.eq(u) }
        ).match({ Ok(_) => false, None => true }),
    })
}

// The distinct URIs these spots name, in the order they were found.
uris_of = (spots: Vec<Spot>, into :: Vec<str>) Res<(), AllocError> {
    spots.loop((h, s) {
        into.find((u) { u.eq(s.uri) }).match({
            Ok(_) => written(),
            None  => into.add(s.uri),
        }).try();
    });
    Ok(());
}

// --- the notification --------------------------------------------------

// The bytes the spans in `uri` were measured against: the open buffer if
// there is one, disk otherwise, or empty when neither answers. `to_wire`
// clamps positions for missing text so the diagnostic still reaches the client.
text_of = (env: Env, t: Alloc, uri: str, docs: Map<str, str>) str {
    docs.get(uri).match({
        Ok(text) => text,
        None     => on_disk(env, t, path_of(uri)),
    })
}

on_disk = (env: Env, t: Alloc, path: str) str {
    env.fs.read(t, path).match({
        Ok(text) => text.view(),
        Err(_)   => "",
    })
}

// Frame one file's complete list. An empty list clears prior diagnostics;
// spans are converted against that file's own text.
publish* = (a: Alloc, uri: str, text: str, spots: Vec<Spot>, out :: String)
           Res<(), AllocError> {
    body ::= a.String().try();
    write_notification(a, uri, text, spots, body).try();
    write_frame(body.view(), out)
}

// `textDocument/publishDiagnostics` is a notification and therefore has no id.
write_notification = (
    a     : Alloc,
    uri   : str,
    text  : str,
    spots : Vec<Spot>,
    body  :: String
) Res<(), AllocError> {
    top ::= obj(body).try();
    top.text("jsonrpc", "2.0", body).try();
    top.text("method", "textDocument/publishDiagnostics", body).try();
    top.key("params", body).try();
    params ::= obj(body).try();
    params.text("uri", uri, body).try();
    params.key("diagnostics", body).try();
    items ::= arr(body).try();
    spots.loop((h, s) { one_of(s, uri, text, items, body).try(); });
    items.close(body).try();
    params.close(body).try();
    top.close(body)
}

// This spot, if it belongs to this file.
one_of = (s: Spot, uri: str, text: str, items :: Nest, out :: String)
         Res<(), AllocError> {
    s.uri.eq(uri).match({
        false => written(),
        true  => written_at(s, text, items, out),
    })
}

written_at = (s: Spot, text: str, items :: Nest, out :: String)
             Res<(), AllocError> {
    items.next(out).try();
    write_spot(s, text, out)
}

write_spot = (s: Spot, text: str, out :: String) Res<(), AllocError> {
    spot ::= obj(out).try();
    spot.key("range", out).try();
    write_range(text, s.span, out).try();
    spot.key("severity", out).try();
    write_decimal(ERROR, out).try();
    spot.text("source", "zen", out).try();
    spot.text("message", s.message, out).try();
    write_note(s, text, spot, out).try();
    spot.close(out)
}

// Related information points to the diagnostic's URI and note span.
write_note = (
    s    : Spot,
    text : str,
    spot :: Nest,
    out  :: String
) Res<(), AllocError> {
    s.note.match({
        None  => written(),
        Ok(n) => write_related(s.uri, n, text, spot, out),
    })
}

// `next` owns array separators for every related-information entry.
write_related = (uri: str, n: Note, text: str, spot :: Nest, out :: String)
                Res<(), AllocError> {
    spot.key("relatedInformation", out).try();
    notes ::= arr(out).try();
    notes.next(out).try();
    note ::= obj(out).try();
    note.key("location", out).try();
    at ::= obj(out).try();
    at.text("uri", uri, out).try();
    at.key("range", out).try();
    write_range(text, n.span, out).try();
    at.close(out).try();
    note.text("message", n.message, out).try();
    note.close(out).try();
    notes.close(out)
}

// LSP `DiagnosticSeverity.Error`.
ERROR*: usize = 1
