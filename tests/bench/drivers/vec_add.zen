// tests/bench/drivers/vec_add.zen
// driver for bench_vec.zen's vec_add. The bench body runs here in a
// plain loop; the clock lives OUTSIDE the process (scripts/bench.py,
// wall time minus the null driver's), because std has no clock and
// constructing a Bencher needs trait dispatch gen_c does not have yet
// ("supplied by an impl; gen_c has no trait dispatch yet").
//
// THE BODY IS NOT COPIED HERE. `vecs.vec_add_body(alloc)` is
// bench_vec.zen's own function, so the operation this times and the
// operation that file documents are the same bytes -- a driver that
// restated the body is what let `allocs_op` drift away from the
// bench it claims to measure. Budget: ns_op 40, allocs_op 1,
// bytes_op 64 (bench_budgets.zen).

vecs = bench_vec

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    Range(0, 1000000).loop((h, i) {
        vecs.vec_add_body(alloc).try();
    });
    Ok(0);
}
