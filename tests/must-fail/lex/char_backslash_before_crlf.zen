// the twin of char_backslash_before_newline on a CRLF checkout. the
// backslash before the CR escapes nothing either: zen has no line
// continuation, and the ending arriving as two bytes does not make it
// one.
//
// before the fix this said "unknown escape sequence" first, at the
// backslash -- a rule nobody broke -- before the true sentence arrived.
// one mistake, one diagnostic: the span-lines rule, at the opening
// quote, and nothing else.
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    c: u8 = '\
    Ok(0);
}
