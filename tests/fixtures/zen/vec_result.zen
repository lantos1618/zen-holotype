{ AllocatorBackend, Allocator, AllocatorVTable, allocator_of, malloc, free } = std.mem.alloc
halloc = std.mem.heap
{ Result, IoError } = std.core.result
vec = std.collections.vec
LimitAlloc: {
    left: i32,
}
LimitAlloc.impl(AllocatorBackend, {
    acquire = (a: MutPtr<LimitAlloc>, n: i64) RawPtr<u8> {
        (a.left > 0).match ({
            true  => {
                a.left = a.left - 1
                malloc(n)
            },
            false => null_ptr(),
        })
    }
    resize  = (a: MutPtr<LimitAlloc>, p: RawPtr<u8>, n: i64) RawPtr<u8> { null_ptr() }
    release = (a: MutPtr<LimitAlloc>, p: RawPtr<u8>) void { free(p) }
})
limit_acquire = (state: RawPtr<u8>, n: i64) RawPtr<u8> {
    a: MutPtr<LimitAlloc> = state
    a.acquire(n)
}
limit_resize = (state: RawPtr<u8>, p: RawPtr<u8>, n: i64) RawPtr<u8> {
    a: MutPtr<LimitAlloc> = state
    a.resize(p, n)
}
limit_release = (state: RawPtr<u8>, p: RawPtr<u8>) void {
    a: MutPtr<LimitAlloc> = state
    a.release(p)
}
limit_vtable ::= AllocatorVTable(
    vt_alloc: limit_acquire,
    vt_remap: limit_resize,
    vt_free: limit_release,
)
limit_allocator = (a: MutPtr<LimitAlloc>) Allocator {
    allocator_of(a.offset(0), limit_vtable.addr().offset(0))
}
success = () i32 {
    m = halloc.gpa()
    a = m.addr()
    r0: Result<vec.Vec<i32>, IoError> = vec.of(a.allocator(), [1])
    r0.match ({
        .Ok(v0) => {
            r1: Result<vec.Vec<i32>, IoError> = v0.push(a, 2)
            r1.match ({
                .Ok(v)  => {
                    n = v.get(0) + v.get(1)
                    v.free(a)
                    n
                },
                .Err(e) => 90,
            })
        },
        .Err(e) => 91,
    })
}
failure = () i32 {
    lim = LimitAlloc(left: 1)
    a = lim.addr()
    r0: Result<vec.Vec<i32>, IoError> = vec.of(limit_allocator(a), [4])
    r0.match ({
        .Ok(v)  => {
            r1: Result<vec.Vec<i32>, IoError> = v.push(a, 5)
            r1.match ({
                .Ok(v2) => {
                    v2.free(a)
                    80
                },
                .Err(e) => {
                    n = v.get(0)
                    v.free(a)
                    n
                },
            })
        },
        .Err(e) => 81,
    })
}
main = () i32 {
    n = success() + failure()
    (n == 7).then({ 0 }, { n })
}
