// tests/harness_boundaries.zen — BOUNDARY category for the Zen harness: Zen linting its OWN source for
// the no-hidden-heap / no-raw-primitive rules. This is the self-hosted port of ALL 8 source-grep
// tests in tests/test_primitive_boundaries.py — the compiler audits its own tree, in itself, with
// NO Python. Each sub-suite below mirrors one python test's regex + file-set + allowlist EXACTLY.
//
// PORTED (python fn → sub-suite):
//   1. test_examples_stay_above_raw_primitives          → "examples stay above raw primitives"
//   2. test_raw_checkpoint_stays_behind_…               → "raw checkpoint behind coroutine/runtime"
//   3. test_atwhile_stays_in_compiler_or_…              → "@while behind compiler/substrate"
//   4. test_raw_allocation_calls_stay_behind_…          → "raw-alloc behind allocator floor"
//   5. test_trace_gather_does_not_fall_back_…           → "trace gather uses owned scratch"
//   6. test_io_contents_allocator_path_uses_try_acquire → "io contents_in uses try_acquire"
//   7. test_map_try_paths_use_result_allocator_helpers  → "map try paths use result helpers"
//   8. test_fmt_try_numeric_writes_use_fallible_…       → "fmt try writes use fallible num helpers"
//
// HOW: enumerate the python file set (rglob *.zen under examples/tools/src/std/src/compiler) via
// `find ... > $ZT/ob_files.txt`, then read+scan each file in Zen. The byte scanner mirrors the
// python regexes over `//`-comment-stripped text; the single-file region tests mirror python's
// `_code(...).split(marker,1)[…]` substring slicing on comment-stripped source.
{ Malloc } = std.mem.alloc
{ out, contents_in, shell } = std.io.file
{ ne, view, is_empty, split_in, nbuf, find, contains, substr } = std.text.str
{ new_in, push_in, finish_in } = std.text.string
{ expect } = std.core.result
{ run_suite, zo_path, zo_cmd } = harness_lib
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// SHARED byte-scan machinery: faithful port of python's `re` over `_code`-stripped source.
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// regex `\w` class member: [A-Za-z0-9_].
is_word_char = (b: u8) bool { b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z' || b >= '0' && b <= '9' || b == '_' }
not_word = (b: u8) bool { b.is_word_char().match ({ true => false, false => true }) }
// `(?<!\.)\b` boundary before sv[i]: prev byte is NOT a word char AND NOT `.` (keeps UFCS `.free(`
// method calls from matching). Written as a pure boolean for the `||`/`&&` chains below.
is_boundary_before = (b: u8) bool { (b < 'a' || b > 'z') && (b < 'A' || b > 'Z') && (b < '0' || b > '9') && b != '_' && b != '.' }
// `\b` boundary before index i (plain word boundary; `.` is allowed, matching a bare `\bNAME`).
bb_plain = (sv: [u8], i: i64) bool { i == 0 || sv[i - 1].not_word() }
// `(?<!\.)\b` boundary before index i (word boundary that ALSO excludes a preceding `.`).
bb_dot = (sv: [u8], i: i64) bool { i == 0 || sv[i - 1].is_boundary_before() }
// `\s` skip: advance past spaces/tabs/newlines/CRs, returning the next index (or len at EOF).
skip_ws = (sv: [u8], j: i64) i64 {
    (j >= sv.len).match ({
        true  => j,
        false => {
            b := sv[j]
            (b == ' ' || b == '\t' || b == '\n' || b == '\r').match ({
                true  => sv.skip_ws(j + 1),
                false => j,
            })
        },
    })
}
// do `nv`'s bytes appear at sv[at..]? (caller guards at + nv.len <= sv.len)
tok_at = (sv: [u8], nv: [u8], at: i64) bool {
    ok := true
    nv.loop((h, i, b) {
        (sv[at + i] == b == false).then({
            ok = false
            h.break
        })
    })
    ok
}
// the `\bNAME\s*\(` tail: keyword `name` starts at sv[i] AND is followed by `\s*(`. The trailing `(`
// is what rejects e.g. `mallocate` and distinguishes `load(` from `load_i64(`.
name_matches = (sv: [u8], i: i64, name: string_view) bool {
    nv := name.view()
    (i + nv.len > sv.len).match ({
        true  => false,
        false => sv.tok_at(nv, i).match ({
            true  => {
                j := sv.skip_ws(i + nv.len)
                j < sv.len && sv[j] == '('
            },
            false => false,
        }),
    })
}
// the `\bNAME\b` tail: keyword `name` starts at sv[i] AND the byte after it is a word boundary (a
// non-word char or EOF). Used for the bare `break` / `continue` keywords (no trailing `(`).
word_matches = (sv: [u8], i: i64, name: string_view) bool {
    nv := name.view()
    (i + nv.len > sv.len).match ({
        true  => false,
        false => sv.tok_at(nv, i).match ({
            true  => {
                p := i + nv.len
                p >= sv.len || sv[p].not_word()
            },
            false => false,
        }),
    })
}
// the `@while\b` match anchored at i: literal `@while` followed by a word boundary (no before-anchor
// — the `@` is a literal char in the pattern, not a `\b`).
atwhile_at = (sv: [u8], i: i64) bool {
    nv := "@while".view()
    (i + nv.len > sv.len).match ({
        true  => false,
        false => sv.tok_at(nv, i).match ({
            true  => {
                p := i + nv.len
                p >= sv.len || sv[p].not_word()
            },
            false => false,
        }),
    })
}
// a pattern match anchored at index i. kind selects the regex shape:
//   0 = `\bNAME\s*\(`        (call, plain word boundary — `.NAME(` still matches, as in python)
//   1 = `(?<!\.)\bNAME\s*\(` (call, boundary EXCLUDING a leading `.` — e.g. "raw addr")
//   2 = `\bNAME\b`           (bare keyword — break / continue)
//   _ = `@while\b`           (the literal @while token; `name` is ignored)
matches_kind_at = (sv: [u8], i: i64, name: string_view, kind: i64) bool {
    (kind == 0).match ({
        true  => sv.bb_plain(i) && sv.name_matches(i, name),
        false => (kind == 1).match ({
            true  => sv.bb_dot(i) && sv.name_matches(i, name),
            false => (kind == 2).match ({
                true  => sv.bb_plain(i) && sv.word_matches(i, name),
                false => sv.atwhile_at(i),
            }),
        }),
    })
}
// does this file (a `[u8]` view of raw source) contain `pattern` of `kind` OUTSIDE a `//` line
// comment? We track an in-comment flag (set at `//`, cleared at newline) — the same comment-stripping
// python's `_code` does. Block comments and string literals are NOT special-cased (matching python).
file_has = (sv: [u8], name: string_view, kind: i64) bool {
    found := false
    in_comment := false
    sv.loop((h, i, b) {
        (b == '\n').then({
            in_comment = false
        })
        (in_comment == false).then({
            (b == '/' && i + 1 < sv.len && sv[i + 1] == '/').match ({
                true  => {
                    in_comment = true
                },
                false => sv.matches_kind_at(i, name, kind).then({
                    found = true
                    h.break
                }),
            })
        })
    })
    found
}
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// comment-stripping (python `_code`) + region slicing (python `src.split(marker,1)[…]`).
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// strip `//` line comments, keeping the part before `//` on each line plus the newline — byte-exact
// port of `_code`'s `"\n".join(line.split("//",1)[0] for line in …)`. (No block-comment/string
// handling, matching python.) Returns an allocator-owned NUL-terminated copy.
strip_comments_in = (mp: MutPtr<Malloc>, src: string_view) string_view {
    sv := src.view()
    s := mp.new_in().expect("harness: oom")
    in_comment := false
    sv.loop((h, i, b) {
        (b == '\n').match ({
            true  => {
                s = s.push_in(mp, b).expect("harness: oom")
                in_comment = false
            },
            false => (in_comment == false).then({
                (b == '/' && i + 1 < sv.len && sv[i + 1] == '/').match ({
                    true  => {
                        in_comment = true
                    },
                    false => {
                        s = s.push_in(mp, b).expect("harness: oom")
                    },
                })
            }),
        })
    })
    mp.finish_in(s).expect("harness: oom")
}
// everything strictly AFTER the first occurrence of `m` (python `src.split(m,1)[1]`); "" if absent.
after_marker = (mp: MutPtr<Malloc>, src: string_view, m: string_view) string_view {
    i := src.find(m)
    (i < 0).match ({
        true  => "",
        false => {
            sv := src.view()
            start := i + m.view().len
            mp.substr(src, start, sv.len - start).expect("harness: oom")
        },
    })
}
// everything strictly BEFORE the first occurrence of `m` (python `s.split(m,1)[0]`); all of `s` if
// `m` is absent (python returns the whole string as the sole split field).
before_marker = (mp: MutPtr<Malloc>, s: string_view, m: string_view) string_view {
    j := s.find(m)
    (j < 0).match ({ true => s, false => mp.substr(s, 0, j).expect("harness: oom") })
}
// the region between the first `m1` and the first following `m2` — python `split(m1,1)[1].split(m2,1)[0]`.
region = (mp: MutPtr<Malloc>, src: string_view, m1: string_view, m2: string_view) string_view { mp.before_marker(mp.after_marker(src, m1), m2) }
not_contains = (s: string_view, needle: string_view) bool { s.contains(needle).match ({
    true  => false,
    false => true,
}) }
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// SUITE 4: raw malloc/calloc/realloc/free stay behind the allocator floor (the original port).
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// RAW_ALLOC_ALLOWED's complement, mirrored EXACTLY from test_primitive_boundaries.py.
alloc_not_whitelisted = (path: string_view) bool { ne(path, "src/std/mem/alloc.zen") && ne(path, "src/std/mem/raw.zen") && ne(path, "src/std/rt.zen") && ne(path, "src/std/concurrent/thread.zen") && ne(path, "src/std/concurrent/pool.zen") && ne(path, "src/std/concurrent/pool_actor.zen") && ne(path, "src/compiler/genc.zen") && ne(path, "src/compiler/genc_emit.zen") && ne(path, "src/compiler/genc_emit_expr.zen") }
// `(?<!\.)\b(?:malloc|calloc|realloc|free)\s*\(` anchored at i (kind 1 = dot-excluded boundary).
file_has_raw_alloc = (sv: [u8]) bool { sv.file_has("malloc", 1) || sv.file_has("calloc", 1) || sv.file_has("realloc", 1) || sv.file_has("free", 1) }
alloc_passes = (mp: MutPtr<Malloc>, path: string_view) bool {
    path.is_empty().match ({
        true  => true,
        false => mp.contents_in(path).match ({
            .Ok(raw) => (raw.view().file_has_raw_alloc() && path.alloc_not_whitelisted()).match ({
                true  => false,
                false => true,
            }),
            .Err(e)  => true,
        }),
    })
}
alloc_suite = (mp: MutPtr<Malloc>) i32 {
    mp.contents_in(mp.zo_path("ob_files.txt")).match ({
        .Ok(listing) => {
            files := mp.split_in(listing, '\n')
            results: [bool] := mp.nbuf(true, files.len)
            files.loop((h, i, path) {
                results[i] = mp.alloc_passes(path)
            })
            run_suite("boundaries: raw-alloc behind allocator floor", results)
        },
        .Err(e)      => run_suite("boundaries: raw-alloc (cannot enumerate files)", [false]),
    })
}
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// SUITE 1: examples stay above raw primitives (EXAMPLE_PRIMITIVES, examples/*.zen, no allowlist).
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// kind per python pattern: "raw addr" = 1 (dot-excluded); break/continue = 2 (bare word); @while = 3
// (literal token); everything else = 0 (plain `\bNAME\s*\(`). `offset`'s `(?:\boffset|\.\s*offset)`
// alternation is equivalent to `\boffset\s*\(` for matching (both fire iff offset starts at a boundary).
example_violation = (sv: [u8]) bool { sv.file_has("addr", 1) || sv.file_has("checkpoint_current", 0) || sv.file_has("@while", 3) || sv.file_has("break", 2) || sv.file_has("continue", 2) || sv.file_has("malloc", 0) || sv.file_has("load", 0) || sv.file_has("store", 0) || sv.file_has("load_i64", 0) || sv.file_has("store_i64", 0) || sv.file_has("atomic_add_i64", 0) || sv.file_has("offset", 0) || sv.file_has("null_ptr", 0) || sv.file_has("slice", 0) || sv.file_has("cstr", 0) || sv.file_has("sizeof", 0) }
example_passes = (mp: MutPtr<Malloc>, path: string_view) bool {
    path.is_empty().match ({
        true  => true,
        false => mp.contents_in(path).match ({
            .Ok(raw) => raw.view().example_violation().match ({ true => false, false => true }),
            .Err(e)  => true,
        }),
    })
}
example_suite = (mp: MutPtr<Malloc>) i32 {
    shell(mp.zo_cmd("find examples -name '*.zen' 2>/dev/null | LC_ALL=C sort > $ZT/ob_examples.txt"))
    mp.contents_in(mp.zo_path("ob_examples.txt")).match ({
        .Ok(listing) => {
            files := mp.split_in(listing, '\n')
            results: [bool] := mp.nbuf(true, files.len)
            files.loop((h, i, path) {
                results[i] = mp.example_passes(path)
            })
            run_suite("boundaries: examples stay above raw primitives", results)
        },
        .Err(e)      => run_suite("boundaries: examples (cannot enumerate files)", [false]),
    })
}
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// SUITE 2: raw checkpoint_current stays behind std.concurrent.coroutine/runtime.
// ─────────────────────────────────────────────────────────────────────────────────────────────────
checkpoint_allowed = (path: string_view) bool { path == "src/std/concurrent/coroutine.zen" || path == "src/std/concurrent/runtime.zen" }
// the import regex `\{[^}\n]*\bcheckpoint_current\b[^}\n]*\}\s*=\s*std\.concurrent\.coroutine`, per
// (comment-stripped) line: a destructure that brings `checkpoint_current` in from the coroutine module
// — `{ … checkpoint_current … } = std.concurrent.coroutine` with the import target after the name.
line_checkpoint_import = (line: string_view) bool {
    ci := line.find("checkpoint_current")
    (ci < 0).match ({
        true  => false,
        false => {
            si := line.find("std.concurrent.coroutine")
            si > ci && line.contains("{") && line.contains("}")
        },
    })
}
has_checkpoint_import = (mp: MutPtr<Malloc>, clean: string_view) bool {
    lines := mp.split_in(clean, '\n')
    found := false
    lines.loop((h, i, line) {
        line.line_checkpoint_import().then({
            found = true
            h.break
        })
    })
    found
}
checkpoint_passes = (mp: MutPtr<Malloc>, path: string_view) bool {
    path.is_empty().match ({
        true  => true,
        false => path.checkpoint_allowed().match ({
            true  => true,
            false => mp.contents_in(path).match ({
                .Ok(raw) => {
                    has_call := raw.view().file_has("checkpoint_current", 0)
                    has_imp := raw.contains("checkpoint_current").match ({
                        true  => mp.has_checkpoint_import(mp.strip_comments_in(raw)),
                        false => false,
                    })
                    (has_call || has_imp).match ({ true => false, false => true })
                },
                .Err(e)  => true,
            }),
        }),
    })
}
checkpoint_suite = (mp: MutPtr<Malloc>) i32 {
    mp.contents_in(mp.zo_path("ob_files.txt")).match ({
        .Ok(listing) => {
            files := mp.split_in(listing, '\n')
            results: [bool] := mp.nbuf(true, files.len)
            files.loop((h, i, path) {
                results[i] = mp.checkpoint_passes(path)
            })
            run_suite("boundaries: raw checkpoint behind coroutine/runtime", results)
        },
        .Err(e)      => run_suite("boundaries: checkpoint (cannot enumerate files)", [false]),
    })
}
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// SUITE 3: @while stays in the compiler / named low-level substrate.
// ─────────────────────────────────────────────────────────────────────────────────────────────────
atwhile_allowed = (path: string_view) bool { path == "src/compiler/lex.zen" || path == "src/compiler/parse.zen" || path == "src/compiler/parse_expr.zen" || path == "src/compiler/parse_atom.zen" || path == "src/compiler/parse_stmt.zen" || path == "src/compiler/parse_type.zen" || path == "src/compiler/pretty.zen" || path == "src/compiler/pretty_expr.zen" || path == "src/compiler/genc.zen" || path == "src/compiler/genc_emit.zen" || path == "src/compiler/genc_emit_lit.zen" || path == "src/compiler/diagnostic.zen" || path == "src/compiler/validate/util.zen" || path == "src/compiler/validate/diag.zen" || path == "src/std/math.zen" || path == "src/std/sys/fs.zen" || path == "src/std/io/stdin.zen" || path == "src/std/hash.zen" }
// low-level numeric/filesystem/stdin substrate: these primitives MUST iterate, not recurse — an
// unbounded recursion depth (huge exponent / directory entry count / stdin byte or line count /
// SHA-256 512-bit block count over a large message) is a stack-overflow segfault. The compiler's
// lexer/codegen/diagnostic scanners join for the same reason: a ~50KB string literal, a long numeric
// literal, or a long source line must lex/emit/caret by iteration, not per-byte recursion (#66c).
atwhile_passes = (mp: MutPtr<Malloc>, path: string_view) bool {
    path.is_empty().match ({
        true  => true,
        false => path.atwhile_allowed().match ({
            true  => true,
            false => mp.contents_in(path).match ({
                .Ok(raw) => raw.view().file_has("@while", 3).match ({
                    true  => false,
                    false => true,
                }),
                .Err(e)  => true,
            }),
        }),
    })
}
atwhile_suite = (mp: MutPtr<Malloc>) i32 {
    mp.contents_in(mp.zo_path("ob_files.txt")).match ({
        .Ok(listing) => {
            files := mp.split_in(listing, '\n')
            results: [bool] := mp.nbuf(true, files.len)
            files.loop((h, i, path) {
                results[i] = mp.atwhile_passes(path)
            })
            run_suite("boundaries: @while behind compiler/substrate", results)
        },
        .Err(e)      => run_suite("boundaries: @while (cannot enumerate files)", [false]),
    })
}
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// SUITE 5: std.mem.trace cc_gather uses collection-owned scratch, not default list growth.
// ─────────────────────────────────────────────────────────────────────────────────────────────────
trace_suite = (mp: MutPtr<Malloc>) i32 {
    mp.contents_in("src/std/mem/trace.zen").match ({
        .Ok(raw) => {
            src := mp.strip_comments_in(raw)
            gather := mp.region(src, "cc_gather = ", "Node*: ")
            run_suite("boundaries: trace gather uses owned scratch", [gather.not_contains(".list_push("), gather.contains(".list_push_static(")])
        },
        .Err(e)  => run_suite("boundaries: trace gather (unreadable)", [false]),
    })
}
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// SUITE 6: std.io.file contents_in allocator path keeps failure in Result flow (try_acquire).
// ─────────────────────────────────────────────────────────────────────────────────────────────────
io_suite = (mp: MutPtr<Malloc>) i32 {
    mp.contents_in("src/std/io/file.zen").match ({
        .Ok(raw) => {
            src := mp.strip_comments_in(raw)
            body := mp.region(src, "read_file_alloc", "read_file_open")
            run_suite("boundaries: io contents_in uses try_acquire", [body.contains(".try_acquire("), body.not_contains(".acquire("), src.not_contains("default()")])
        },
        .Err(e)  => run_suite("boundaries: io file (unreadable)", [false]),
    })
}
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// SUITE 7: std.collections.map fallible paths (the unified Result API) use the Result allocator
// helpers — grow/of go through the all-or-nothing try_acquire3 combinator (which rolls back partially
// acquired buffers on OOM), append grows through grow; never a bare panicking acquire.
// ─────────────────────────────────────────────────────────────────────────────────────────────────
map_suite = (mp: MutPtr<Malloc>) i32 {
    mp.contents_in("src/std/collections/map.zen").match ({
        .Ok(raw) => {
            src := mp.strip_comments_in(raw)
            grow := mp.region(src, "grow<A>", "reindex = ")
            appnd := mp.region(src, "append<A>", "put<A>")
            // `of` is the last fn in map.zen, so its region runs to EOF (no following marker).
            of := mp.after_marker(src, "of*<T, A>")
            run_suite("boundaries: map fallible paths use result helpers", [grow.contains(".try_acquire3("), grow.not_contains(".acquire("), appnd.contains(".grow("), appnd.not_contains(".acquire("), of.contains(".try_acquire3("), of.not_contains(".acquire(")])
        },
        .Err(e)  => run_suite("boundaries: map (unreadable)", [false]),
    })
}
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// SUITE 8: std.text.fmt allocator-backed numeric writes (Result-always) go through the unified
// Result num helpers (never a bare acquire); the plain streaming writes never touch an allocator.
// ─────────────────────────────────────────────────────────────────────────────────────────────────
fmt_suite = (mp: MutPtr<Malloc>) i32 {
    mp.contents_in("src/std/text/fmt.zen").match ({
        .Ok(raw) => {
            src := mp.strip_comments_in(raw)
            ti := mp.region(src, "write_int_in", "write_float_in")
            tf := mp.region(src, "write_float_in", "write_int = ")
            wi := mp.region(src, "write_int = ", "write_fpad")
            // "// Display" is a comment marker — stripped by `_code`, so (faithfully) absent here, which
            // makes `wf` run from `write_float = ` to EOF (python's split returns the whole remainder).
            wf := mp.region(src, "write_float = ", "// Display")
            run_suite("boundaries: fmt allocator writes use fallible num helpers", [ti.contains(".integer_in("), ti.not_contains(".acquire("), tf.contains(".float_in("), tf.not_contains(".acquire("), wi.not_contains(".integer_in(") && wi.not_contains(".write_int_in("), wf.not_contains(".float_in(") && wf.not_contains(".write_float_in("), src.not_contains("default()")])
        },
        .Err(e)  => run_suite("boundaries: fmt (unreadable)", [false]),
    })
}
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// SUITE 8: a large string literal lexes + runs — the #66c cliff. A ~200KB string literal used to
// overflow the C stack (str_end / unescape / gen_escape_from recursed per byte). Generate a program
// with a 200000-char string, compile + run it, and assert the runtime string's length is exact. At the
// default stack this crashed (SIGSEGV) with the old per-char recursion; iterative lexing/codegen fixes it.
bigstr_suite = (mp: MutPtr<Malloc>) i32 {
    rc := shell(mp.zo_cmd("head -c 200000 /dev/zero | tr '\\0' A > $ZT/bb.txt; { printf '{ len } = std.text.str\\n{ to_exit } = std.core.bool\\nmain = () i32 {\\n    s := \"'; cat $ZT/bb.txt; printf '\"\\n    (s.len() == 200000).to_exit()\\n}\\n'; } > $ZT/bigstr.zen; ./zen run $ZT/bigstr.zen")).expect("harness: shell")
    run_suite("boundaries: 200KB string literal lexes + runs (no stack overflow, #66c)", [rc == 0])
}
// ─────────────────────────────────────────────────────────────────────────────────────────────────
harness_boundaries_run* = () i32 {
    m := Malloc(_: 0)
    mp := m.addr()
    // enumerate exactly the python full file set: rglob *.zen under examples, tools, src/std, src/compiler.
    shell(mp.zo_cmd("find examples tools src/std src/compiler -name '*.zen' 2>/dev/null | LC_ALL=C sort > $ZT/ob_files.txt"))
    fails := 0
    fails = fails + mp.example_suite()
    fails = fails + mp.checkpoint_suite()
    fails = fails + mp.atwhile_suite()
    fails = fails + mp.alloc_suite()
    fails = fails + mp.trace_suite()
    fails = fails + mp.io_suite()
    fails = fails + mp.map_suite()
    fails = fails + mp.fmt_suite()
    fails = fails + mp.bigstr_suite()
    fails
}
