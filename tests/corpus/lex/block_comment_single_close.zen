// FORK 2 of 2 on NESTED BLOCK COMMENTS. DESIGN.md does not decide.
// This file assumes nesting is NOT supported: the comment below closes
// at its one */ and the program is reached. Under a nesting lexer the
// comment runs to EOF instead -- that reading is
// tests/must-fail/lex/block_comment_nested_eof.zen, same source.
/* a /* b */
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    println("block comments do not nest");
    Ok(0);
}
