// an identifier that merely STARTS with a reserved word must lex as one
// identifier: consumed, matcher, truely, loopy, then.
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    consumed: i32 = 1;
    matcher: i32 = 2;
    truely: i32 = 3;
    falsehood: i32 = 4;
    loopy: i32 = 5;
    thenable: i32 = 6;
    println("{}", consumed + matcher + truely + falsehood + loopy + thenable);
    Ok(0);
}
