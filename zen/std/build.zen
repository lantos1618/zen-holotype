// std.build — a build program registers targets into a runner-owned graph.
// Target configuration remains plain borrowed data; the short-lived Build context owns only
// the registry storage and releases it after emitting the graph.
{ print, println } = std.text.fmt
{ Platform, Os, Arch, Abi, host } = std.platform
{ Malloc } = std.mem.alloc
{ panic } = std.core.result
Build*: {
    alloc_: Malloc,
    host_: Platform,
    target_: Platform,
    targets_: [Target],
    count_: i64,
    host = (b: Ptr<Build>) Platform { b.host_ }
    target = (b: Ptr<Build>) Platform { b.target_ }
    exe = (b: Ptr<Build>, name: string_view) Target { exe(name).target(b.target_) }
    install = (b: MutPtr<Build>, target: Target) void {
        (b.count_ >= b.targets_.len).match ({
            true  => panic("std.build: target capacity exceeded"),
            false => {
                b.targets_[b.count_] = target
                b.count_ = b.count_ + 1
            },
        })
    }
    emit_spec = (b: Ptr<Build>) void {
        println(b.count_)
        installed: [Target] := slice(b.targets_.ptr, b.count_)
        installed.loop((h, i, target) {
            target.emit_target()
        })
    }
    deinit = (b: MutPtr<Build>) void { b.alloc_.addr().release(b.targets_.ptr) }
}
build_context* = () Build {
    a := Malloc(_: 0)
    p := host()
    slots: [Target] := slice(assert_nonnull(a.addr().acquire(256 * sizeof(Target))), 256)
    Build(
        alloc_: a,
        host_: p,
        target_: p,
        targets_: slots,
        count_: 0,
    )
}
Target*: {
    name: string_view,
    root_: string_view,
    main_: string_view,
    out_: string_view,
    links_: string_view,
    sources_: [string_view],
    frameworks_: [string_view],
    libraries_: [string_view],
    platform_: Platform,
    root = (t: Target, p: string_view) Target {
        Target(
            name: t.name,
            root_: p,
            main_: t.main_,
            out_: t.out_,
            links_: t.links_,
            sources_: t.sources_,
            frameworks_: t.frameworks_,
            libraries_: t.libraries_,
            platform_: t.platform_,
        )
    }
    main = (t: Target, p: string_view) Target {
        Target(
            name: t.name,
            root_: t.root_,
            main_: p,
            out_: t.out_,
            links_: t.links_,
            sources_: t.sources_,
            frameworks_: t.frameworks_,
            libraries_: t.libraries_,
            platform_: t.platform_,
        )
    }
    out = (t: Target, p: string_view) Target {
        Target(
            name: t.name,
            root_: t.root_,
            main_: t.main_,
            out_: p,
            links_: t.links_,
            sources_: t.sources_,
            frameworks_: t.frameworks_,
            libraries_: t.libraries_,
            platform_: t.platform_,
        )
    }
    target = (t: Target, p: Platform) Target {
        Target(
            name: t.name,
            root_: t.root_,
            main_: t.main_,
            out_: t.out_,
            links_: t.links_,
            sources_: t.sources_,
            frameworks_: t.frameworks_,
            libraries_: t.libraries_,
            platform_: p,
        )
    }
    links = (t: Target, l: string_view) Target {
        Target(
            name: t.name,
            root_: t.root_,
            main_: t.main_,
            out_: t.out_,
            links_: l,
            sources_: t.sources_,
            frameworks_: t.frameworks_,
            libraries_: t.libraries_,
            platform_: t.platform_,
        )
    }
    sources = (t: Target, xs: [string_view]) Target {
        Target(
            name: t.name,
            root_: t.root_,
            main_: t.main_,
            out_: t.out_,
            links_: t.links_,
            sources_: xs,
            frameworks_: t.frameworks_,
            libraries_: t.libraries_,
            platform_: t.platform_,
        )
    }
    frameworks = (t: Target, xs: [string_view]) Target {
        Target(
            name: t.name,
            root_: t.root_,
            main_: t.main_,
            out_: t.out_,
            links_: t.links_,
            sources_: t.sources_,
            frameworks_: xs,
            libraries_: t.libraries_,
            platform_: t.platform_,
        )
    }
    libraries = (t: Target, xs: [string_view]) Target {
        Target(
            name: t.name,
            root_: t.root_,
            main_: t.main_,
            out_: t.out_,
            links_: t.links_,
            sources_: t.sources_,
            frameworks_: t.frameworks_,
            libraries_: xs,
            platform_: t.platform_,
        )
    }
    sources_on = (t: Target, os: Os, xs: [string_view]) Target { (t.platform_.os == os).match ({
        true  => t.sources(xs),
        false => t,
    }) }
    frameworks_on = (t: Target, os: Os, xs: [string_view]) Target { (t.platform_.os == os).match ({
        true  => t.frameworks(xs),
        false => t,
    }) }
    libraries_on = (t: Target, os: Os, xs: [string_view]) Target { (t.platform_.os == os).match ({
        true  => t.libraries(xs),
        false => t,
    }) }
    emit_target = (t: Target) void {
        // Legacy single-library setter. Prefer `.libraries(["pthread", ...])`.
        // Six fixed lines: name, root, main, out, linker flags, compiler inputs.
        println(t.name)
        println(t.root_)
        println(t.main_)
        println(t.out_)
        (t.links_ != "").then({
            print("-l")
            print(t.links_)
            print(" ")
        })
        t.libraries_.loop((h, i, lib) {
            print("-l")
            print(lib)
            print(" ")
        })
        t.frameworks_.loop((h, i, framework) {
            print("-framework ")
            print(framework)
            print(" ")
        })
        println("")
        t.sources_.loop((h, i, source) {
            print(source)
            print(" ")
        })
        println("")
        println(build_os_code(t.platform_.os))
        println(build_arch_code(t.platform_.arch))
        println(build_abi_code(t.platform_.abi))
    }
}
build_os_code = (os: Os) i32 {
    os.match ({
        .MacOS   => 1,
        .Linux   => 2,
        .Windows => 3,
        .FreeBSD => 4,
        _        => 0,
    })
}
build_arch_code = (arch: Arch) i32 {
    arch.match ({
        .Arm64   => 1,
        .X86_64  => 2,
        .RiscV64 => 3,
        .Wasm32  => 4,
        _        => 0,
    })
}
build_abi_code = (abi: Abi) i32 {
    abi.match ({
        .Darwin => 1,
        .Gnu    => 2,
        .Musl   => 3,
        .Msvc   => 4,
        .Wasi   => 5,
        _       => 0,
    })
}
exe* = (name: string_view) Target {
    empty: [string_view] := []
    Target(
        name: name,
        root_: "",
        main_: "",
        out_: "",
        links_: "pthread",
        sources_: empty,
        frameworks_: empty,
        libraries_: empty,
        platform_: host(),
    )
}
