== a hand-wrapped array literal fills instead of keeping its layout
faithful: true, fixpoint
1 (33) |is_c_integer = (name: str) bool {|
2 (16) |    name.is_in([|
3 (76) |        "i8", "i16", "i32", "i64", "int", "u8", "u16", "u32", "u64", "usize"|
4 (6) |    ])|
5 (1) |}|
== a fill runs onto a second line only once the first is full
faithful: true, fixpoint
1 (23) |words = (w: str) bool {|
2 (13) |    w.is_in([|
3 (72) |        "alpha", "bravo", "charlie", "delta", "echo", "foxtrot", "golf",|
4 (51) |        "hotel", "india", "juliett", "kilo", "lima"|
5 (6) |    ])|
6 (1) |}|
== a short array literal joins back onto one line
faithful: true, fixpoint
1 (30) |is_signed = (name: str) bool {|
2 (36) |    name.is_in(["i8", "i16", "i32"])|
3 (1) |}|
== an array literal with a trailing comma is left exactly as written
faithful: true, fixpoint
1 (18) |budgets = () i32 {|
2 (9) |    sum([|
3 (10) |        1,|
4 (10) |        2,|
5 (6) |    ])|
6 (1) |}|
