// clones.zen — structural clone detection over the RESOLVED AST.
//
// Two functions are clones when their trees have the same shape once locally-bound names are
// abstracted away. This is a tree walk, not a text match: `zen audit` already parses the program,
// so the structure is right there and there is no reason to approximate it with a regex over
// source text. Whitespace, comments, formatting and parameter naming cannot affect the result,
// because none of them survive into the AST.
//
// CANONICALISATION — the whole design lives in these three rules, and each was calibrated against
// this tree by measuring how many groups it produces and hand-checking the result:
//
//   1. BOUND names (params, `let` locals) are replaced by their binding INDEX. This is what makes
//      `is_walrus(t)` and `is_assign(tok)` hash equal — the only difference is a parameter name.
//   2. FREE names (called functions, types, enum variants) are kept VERBATIM. This is the rule that
//      matters most. Abstracting them too collapses every `t.match({ .X => true, _ => false })`
//      predicate onto one hash: measured on this tree that inflates 14 real groups to 148, almost
//      all false — `.Ptr` and `.Slice` are not interchangeable just because the shape matches.
//   3. LITERALS are kept. Replacing them with a hole merges functions that differ only in a
//      constant, which is usually a real distinction (measured: 14 groups -> 35).
//
// The fingerprint is an FNV-1a fold over node tags plus those canonical leaves, so equal hash means
// equal canonical tree. Collisions are astronomically unlikely at this scale and would surface as a
// reviewable finding, never as a silent rewrite.
//
// EVERY child must be folded in. A node whose children are skipped is not an abstraction, it is a
// lie: the first cut hashed a struct literal as its type name alone and duly reported `parse_not`
// (which builds a `cond`) as identical to `parse_neg` (which builds a `bin_at("-")`) — the entire
// difference sat in the unhashed fields. tests/harness_misc.zen plants that exact near-miss.
{ Malloc } = std.mem.alloc
{ then } = std.core.bool
{ view } = std.text.str
{ fnv1a64_fold } = std.hash
{ is_expr_null, acquire_or_die } = compiler.genc
{ Expr, FieldInit, Func, LambdaData, LoopData, MatchData, Stmt, Ty } = compiler.ast.ast_types
{ loop_at } = std.core.count
// Binding scope: names bound by this function, in binding order. Small and linear — a function with
// enough locals for the scan to matter is already a problem this tool wants to report.
CloneCtx*: {
    names: [StringView],
    n: i64,
    nodes: i64,
}
CLONE_BASIS = () i64 { 0 - 3750763034362895579 }    // the FNV-1a-64 offset basis as an i64
CLONE_PRIME = () i64 { 1099511628211 }
// fold a small structural tag (a node kind) into the running hash
clone_tag = (h: i64, tag: i64) i64 { (h ^ tag) * CLONE_PRIME() }
// count a visited node — the size gate below is on TREE size, not statement count. A one-statement
// body is the norm in this language (`f = (x) bool { x.match({ ... }) }`), so gating on statements
// reports nothing at all.
clone_node = (cx: MutPtr<CloneCtx>, h: i64) i64 {
    cx.nodes = cx.nodes + 1
    h
}
// fold a verbatim name / literal text
clone_text = (h: i64, s: StringView) i64 { h.fnv1a64_fold(s.view()) }
clone_bound_at = (cx: MutPtr<CloneCtx>, name: StringView, i: i64) i64 {
    (i >= cx.n).then({
        return 0 - 1
    })
    (cx.names[i] == name).then({
        return i
    })
    cx.clone_bound_at(name, i + 1)
}
// register a newly bound name (params, let). Silently saturates: past capacity a name simply reads
// as free, which can only ever SPLIT a clone group, never merge two unrelated functions.
clone_bind = (cx: MutPtr<CloneCtx>, name: StringView) void {
    (cx.n < cx.names.len).then({
        cx.names[cx.n] = name
        cx.n = cx.n + 1
    })
}
// RULE 1 + 2: a bound name hashes as its binding index; a free name hashes as itself.
clone_name = (cx: MutPtr<CloneCtx>, h: i64, name: StringView) i64 {
    i = cx.clone_bound_at(name, 0)
    (i < 0).then({
        return h.clone_tag(2).clone_text(name)
    })
    h.clone_tag(1).clone_tag(i)
}
clone_ty = (h: i64, t: Ty) i64 {
    t.match ({
        .I32           => h.clone_tag(20),
        .I64           => h.clone_tag(21),
        .U8            => h.clone_tag(22),
        .F64           => h.clone_tag(23),
        .Bool          => h.clone_tag(24),
        .Void          => h.clone_tag(25),
        .StringView    => h.clone_tag(26),
        .StringCstr    => h.clone_tag(27),
        .StringLiteral => h.clone_tag(28),
        .Named(nm)     => h.clone_tag(29).clone_text(nm),
        .Ptr(pd)       => h.clone_tag(30).clone_tag(pd.kind).clone_ty(load(pd.pointee)),
        .Slice(el)     => h.clone_tag(31).clone_tag(el.kind).clone_ty(load(el.pointee)),
        .FnT(f)        => f.params.clone_tys(h.clone_tag(32)).clone_ty(load(f.ret)),
        .Generic(g)    => g.args.clone_tys(h.clone_tag(33).clone_text(g.name)),
    })
}
clone_tys = (ts: [Ty], h: i64) i64 {
    acc ::= h
    ts.loop_at((i, t) { acc = acc.clone_ty(t) })
    acc
}
clone_exprs = (cx: MutPtr<CloneCtx>, h: i64, xs: [Expr]) i64 {
    acc ::= h
    xs.loop_at((i, x) { acc = cx.clone_expr(acc, x.addr()) })
    acc
}
clone_expr = (cx: MutPtr<CloneCtx>, h0: i64, e: Ptr<Expr>) i64 {
    h = cx.clone_node(h0)
    load(e).match ({
        .Int(v)         => h.clone_tag(40).clone_tag(v),
        .Byte(v)        => h.clone_tag(41).clone_tag(v),
        .FloatLit(s)    => h.clone_tag(42).clone_text(s),
        .StrLit(s)      => h.clone_tag(43).clone_text(s.value),
        .Var(v)         => cx.clone_name(h.clone_tag(44), v.name),
        .Bin(b)         => cx.clone_expr(cx.clone_expr(h.clone_tag(45).clone_text(b.op), b.lhs), b.rhs),
        .Call(c)        => cx.clone_exprs(h.clone_tag(46).clone_text(c.fn), c.args),
        .MethodCall(mc) => cx.clone_exprs(cx.clone_expr(h.clone_tag(47).clone_text(mc.method), mc.recv), mc.args),
        .Cond(d)        => cx.clone_expr(cx.clone_expr(cx.clone_expr(h.clone_tag(48), d.c), d.t), d.e),
        .Member(m)      => cx.clone_expr(h.clone_tag(m.ptr.then({ 50 }, { 49 })).clone_text(m.field), m.obj),
        .MakeEnum(mk)   => cx.clone_opt(h.clone_tag(51).clone_text(mk.ty).clone_text(mk.variant), mk.payload),
        .MakeStruct(s)  => cx.clone_inits(h.clone_tag(52).clone_text(s.ty), s.inits),
        .Tag(t)         => h.clone_tag(53).clone_text(t.ty).clone_text(t.variant),
        .Index(ix)      => cx.clone_expr(cx.clone_expr(h.clone_tag(54), ix.seq), ix.idx),
        .SliceLit(sl)   => cx.clone_exprs(h.clone_tag(55).clone_ty(sl.elem), sl.items),
        .Match(m)       => cx.clone_arms(cx.clone_expr(h.clone_tag(56), m.subj), m),
        .Block(b)       => cx.clone_stmts(h.clone_tag(57), b.stmts),
        .Loop(l)        => cx.clone_loop(h.clone_tag(58), l),
        .Lambda(l)      => cx.clone_lambda(h.clone_tag(59), l),
    })
}
clone_arms = (cx: MutPtr<CloneCtx>, h: i64, m: MatchData) i64 {
    acc ::= h
    m.arms.loop_at((i, a) {
        cx.clone_bind(a.bind)    // `.Some(v) =>` binds v — rule 1, or the arm's spelling of v splits the group
        acc = cx.clone_expr(acc.clone_tag(60).clone_text(a.variant), a.body)
    })
    acc
}
// A struct literal's field VALUES are real children. Hashing only the type name — as the first cut
// did — makes every literal of one type identical, which merged `parse_not` with `parse_neg`: both
// build a `PExpr(expr: …, next: …)` and everything that distinguishes them lives in the fields.
// Field names follow rule 2 (free, verbatim), so `S(a: t, b: u)` and `S(a: u, b: t)` differ.
clone_inits = (cx: MutPtr<CloneCtx>, h: i64, inits: [FieldInit]) i64 {
    acc ::= h
    inits.loop_at((i, f) { acc = cx.clone_expr(acc.clone_tag(61).clone_text(f.name), f.value) })
    acc
}
// An optional child — an enum payload (`.None` has none) or a synthesized valueless return. Absent is
// TAGGED, so it can never hash equal to a present child.
clone_opt = (cx: MutPtr<CloneCtx>, h: i64, e: Ptr<Expr>) i64 {
    e.is_expr_null().then({ h.clone_tag(62) }, { cx.clone_expr(h, e) })
}
// The loop header BINDS its index / element / handler names, so rule 1 covers them: without this
// `xs.loop((h, i, x) { … })` and `ys.loop((h, i, y) { … })` hash differently and the group splits on
// the spelling of a loop variable. All three bind unconditionally (a name the source omitted is ""),
// so the binding indices stay aligned between any two loops.
clone_loop = (cx: MutPtr<CloneCtx>, h: i64, l: LoopData) i64 {
    acc = cx.clone_expr(h, l.seq).clone_ty(l.elemTy)
    cx.clone_bind(l.idx)
    cx.clone_bind(l.elem)
    cx.clone_bind(l.h)
    cx.clone_stmts(acc, l.body)
}
clone_lambda = (cx: MutPtr<CloneCtx>, h: i64, l: LambdaData) i64 {
    acc ::= h
    l.params.loop_at((i, p) {
        cx.clone_bind(p.name)
        acc = acc.clone_ty(p.ty)
    })
    cx.clone_stmts(acc, l.body)
}
clone_stmts = (cx: MutPtr<CloneCtx>, h: i64, body: [Stmt]) i64 {
    acc ::= h
    body.loop_at((i, st) { acc = cx.clone_stmt(acc, st) })
    acc
}
clone_stmt = (cx: MutPtr<CloneCtx>, h0: i64, st: Stmt) i64 {
    h = cx.clone_node(h0)
    st.match ({
        .Let(l)      => {
            v = cx.clone_expr(h.clone_tag(70).clone_ty(l.ty), l.value)
            cx.clone_bind(l.name)    // bind AFTER the initialiser: `x = x` refers to the OUTER x
            v
        },
        .Assign(a)   => cx.clone_expr(cx.clone_expr(h.clone_tag(71), a.target), a.value),
        .Return(r)   => cx.clone_opt(h.clone_tag(72), r),
        .ExprStmt(x) => cx.clone_expr(h.clone_tag(73), x),
        .IndexSet(s) => cx.clone_expr(cx.clone_expr(cx.clone_expr(h.clone_tag(74), s.seq), s.idx), s.value),
        .If(f)       => cx.clone_stmts(cx.clone_stmts(cx.clone_expr(h.clone_tag(75), f.c), f.then), f.els),
        .While(w)    => cx.clone_stmts(cx.clone_expr(h.clone_tag(76), w.c), w.body),
    })
}
CLONE_SCOPE_CAP = () i64 { 128 }
// The fingerprint of one function: parameter TYPES (so a differing signature never collides), then
// the body. Parameter NAMES are bound, not hashed — rule 1.
clone_fn* = (mp: MutPtr<Malloc>, f: Func) i64 {
    buf: [StringView] = slice(mp.acquire_or_die(CLONE_SCOPE_CAP() * sizeof(StringView)), CLONE_SCOPE_CAP())
    c = CloneCtx(
        names: buf,
        n: 0,
        nodes: 0,
    )
    cx = c.addr()
    h ::= CLONE_BASIS().clone_ty(f.ret)
    f.params.loop_at((i, p) {
        cx.clone_bind(p.name)
        h = h.clone_ty(p.ty)
    })
    r = cx.clone_stmts(h, f.body)
    small = cx.nodes < CLONE_MIN_NODES()
    mp.release(buf.ptr)
    small.then({ 0 }, { r })
}    // 0 = below the size gate, not worth reporting — see CLONE_MIN_NODES
// THE SIZE GATE — a function whose canonical tree has fewer than this many nodes is never reported.
//
// It is NOT a precision filter. Structural identity is exact: every child is folded in, so a reported
// pair really does have the same tree and there is nothing here to be wrong about. The gate is a
// VOLUME dial, and the question it answers is "is this pair worth a human opening two files?".
//
// The line drawn at 8: eight nodes is the smallest body holding TWO operations over TWO leaves —
// `b == ' ' || b == '\t'` is exactly 8 — and two operations is the smallest body in which two copies
// can silently DIVERGE. Teach one `is_ws` about '\r' and its twin quietly disagrees; that is the
// hazard this tool exists to surface. Below 8 the body is one operation or one constant
// (`slice(null_ptr(), 0)`, `x + 1`, a call forwarding its arguments): duplicated, but with no logic
// in it to drift, so merging buys an import and nothing else.
//
// Measured on the tree as it stood when this gate was chosen (`zen audit driver.zen`, converged
// seed, findings at each gate) — the sweep that picked the number:
//
//     gate    4    6    8   10   12   14   16   20   24
//     found  60   42   39   25   22   20   15    9    5
//
// and, hand-checked, what each tier ADMITS:
//
//   8  (+14)  is_ws == mf_ws, lspt_upper == is_upper_byte == is_upper_b, is_logic_op == ko_is_sc ==
//             is_shortcircuit, and a SEVEN-strong `xs.slice_any((p) { p.name == n })` family
//             (tmiss_has_tp, has_tparam, has_method, names_has, ka_param_named, …). Byte-identical
//             bodies, every one mergeable — the highest-value tier in the sweep, and precisely the
//             char-class/predicate de-duplication already on the roadmap.
//   6  (+3)   tybuf == tybuf1, ff_slice_elem == vararg_elem. Real, marginal: single expressions.
//   4  (+18)  the noise floor arrives — no_exports == empty_params == vw_none, all three
//             `slice(null_ptr(), 0)`, and CLONE_BASIS == FNV_BASIS, two i64 CONSTANTS. "Structurally
//             identical" has stopped meaning "duplicated logic" by here.
//
// That whole 8-tier has since been merged away (the two de-duplication rounds this detector was
// built to drive), so the gate now reports ZERO on this tree — the tool's own success condition,
// and the reason `zen audit` keeps running it: the next copy-paste is what it is watching for.
//
// 6 is defensible (it admits 3 real pairs and no junk) and 4 is not (a majority of its tier is junk).
// 8 is the shipped default because it is the last gate whose entire admitted tier is code that can
// rot out of sync. Raising it hides real duplication rather than false findings: 12 — the first cut's
// number — drops all 14 of the 8-tier pairs, which is 17 genuine clones traded for a shorter report.
CLONE_MIN_NODES* = () i64 { 8 }
