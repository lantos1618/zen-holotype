// the same missing arm, in STATEMENT position where nothing reads the
// value. DESIGN.md: match is exhaustive in every position -- this is the
// one where a dropped case would otherwise be invisible.
//
// position: the match expression (its receiver).

Signal = Start | Stop | Reset

step = (env: Env, s: Signal) () {
    s.match({
        Start => println("start"),
        Stop  => println("stop"),
    });
}

main = (env: Env) Res<i32, AllocError> {
    step(env, Signal.Reset);
    Ok(0);
}
