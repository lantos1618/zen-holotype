c_prim = gen.gen_c
is_prim, is_integer, c_integer = sema.sema_ty

main = (env: Env) Res<i32, AllocError> {
    println(
        "{}|{}|{}|{}|{}|{}|{}|{}|{}|{}|{}",
        c_prim("c_char"),
        c_prim("c_schar"),
        c_prim("c_uchar"),
        c_prim("c_short"),
        c_prim("c_ushort"),
        c_prim("c_int"),
        c_prim("c_uint"),
        c_prim("c_long"),
        c_prim("c_ulong"),
        c_prim("c_longlong"),
        c_prim("c_ulonglong")
    );
    println(
        "primitive={} foreign-integer={} zen-integer={}",
        is_prim("c_int"),
        c_integer("c_int"),
        is_integer("c_int")
    );
    Ok(0)
}
