// Regression (root of #69/#480): the inliner must evaluate a call argument EXACTLY ONCE even when
// the callee's parameter is referenced several times in the body. A GENERIC fn is inlined by textual
// substitution, so a param used N times used to re-splice — and thus RE-EVALUATE — the arg N times.
// When that arg is itself a side-effecting inlined expansion (a chained call whose receiver is the
// previous op's result), the effect compounded ~3^depth → hang / slice-OOB / wrong result.
//
// `bump` is generic (→ inlined) and references its receiver `w` three times (w.p, w.p, w.v). Chained
// as `b.bump(1).bump(2).bump(3)`, each op's receiver is the previous op's inlined Block. Each `bump`
// increments the shared counter EXACTLY ONCE, so after a 3-deep chain the counter is 3 (not 13, the
// pre-fix multi-eval value) and the accumulated value is 1+2+3 = 6.
{ put } = std.text.fmt
Box*<T>: {
    p: MutPtr<i32>,
    v: T,
}
bump<T> = (w: Box<T>, x: T) Box<T> {
    store(w.p, load(w.p) + 1)
    Box<T>(
        p: w.p,
        v: w.v + x,
    )
}
main = () i32 {
    c := 0
    b := Box<i32>(
        p: c.addr(),
        v: 0,
    )
    b2 := b.bump(1).bump(2).bump(3)
    put("count=").i(c).nl()    // 3 — one eval per bump, not 13 (pre-fix multi-eval)
    put("v=").i(b2.v).nl()    // 6 — 1 + 2 + 3 accumulated once each
    put("done").nl()
    0
}
