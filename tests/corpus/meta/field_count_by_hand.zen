// M4 SLICE 1'S GATE, THE BY-HAND HALF: the same program as
// `field_count_via_meta` with each folded count written out by hand —
// no `@meta` anywhere. The two share one byte-identical `.expected`,
// and the pair disagreeing is exactly the differential signal `@meta`
// otherwise cannot get (`docs/design_meta.md` §6.3).
//
// The counts ARE the answer a field-filtered walk owes: Empty has no
// members, One has its single field, Mixed three fields, and Muddle
// has FOUR members of which only p and q are fields — k is a constant
// (the immutable-with-default spelling) and go is a method.

Empty = { }

One = {
    only: i64,
}

Mixed = {
    a: i64,
    b: bool,
    c: str,
}

Muddle = {
    p: i64,
    q: bool,

    k: i64 = 5,

    go* = (self: @Self) i64 { 7 },
}

main = (env: Env) Res<i32, AllocError> {
    e: i64 = 0;
    o: i64 = 1;
    m: i64 = 3;
    d: i64 = 2;
    println("counts {} {} {} {}", e, o, m, d);
    println("witness {}", ((e * 1) + (o * 2) + (m * 5) + (d * 7)) * 3);
    Ok(0);
}
