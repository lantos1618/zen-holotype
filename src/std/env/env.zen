// src/std/env/env.zen
//
// The capability root. `main` receives one Env and ALL authority flows
// from it (printing, pages, files, sockets, threads, spawning) — law
// 2, and why there's no ambient io or allocator below this file: a
// function that prints or allocates was handed the authority to, and
// its signature says so.
//
// Every field is STARRED. `env.mem`/`env.out`/`env.argv` are read from
// user code throughout tests/corpus, and an unstarred field is
// invisible outside its module (law 6), so a bare-field Env would be
// unusable outside std.
//
// Env is the one place a law bends: `println(..)` is sugar for
// `<the Env in scope>.out.println(..)`, resolved BY TYPE not by
// binding name — no Env in scope is a compile error (DESIGN.md
// "Still open").

// Mem is std.mem's page authority, not this file's: `env.mem.alloc()`
// makes an Arena; Env just supplies where the authority arrives from.
Alloc, Mem = std.mem
Vec = std.collections
str, String = std.text

// From the prelude: u64, Res, None, and the IoError every Console and
// Stdin signature names (declared by std.core.io). Actor and Ref arrive
// with std.actor at stage 5.

// A required field was absent, or present and didn't parse as its
// type — both name the field; a reason is never invented.
ArgError* = Missing(str) | Parse(str)

// stdout and stderr.
//
// TWO MEMBERS, ONE STREAM EACH: stdout is the program's ANSWER and
// stderr is the program TALKING ABOUT ITSELF — narration, progress,
// diagnostics — so a caller takes the answer from the pipe and
// silences everything else with `2>/dev/null`. Not two ways to reach
// one place: every unix tool that parses another tool's output leans
// on exactly this split.
Console* = {
    println* = (self: @Self, fmt: str, args: ...) Res<(), IoError>

    // same floor, the other stream. No `error` sugar: the sugar exists
    // only where DESIGN.md writes it, for `println`.
    errorln* = (self: @Self, fmt: str, args: ...) Res<(), IoError>
}

// standard input, the only way a byte stream reaches this language —
// a capability like every other one here.
//
// ONE MEMBER, BYTE-COUNTED. No `read_line`, never will be: a
// `Content-Length` body is BYTES, and splitting the stream on newlines
// would corrupt any message carrying one. Line discipline is the
// caller's question, asked over bytes it already holds.
//
// `buf` IS FILLED, NOT RETURNED: `read` allocates nothing (law 1, no
// Alloc), so it can only write into capacity the caller already made
// via `Vec.reserve`; skip that and get `Full`.
//
// READS EXACTLY `n` BYTES, BLOCKS UNTIL IT HAS THEM. A shorter count
// means end of input — asking for more than the peer will send before
// hearing back is a deadlock, so a self-describing-format reader asks
// for exactly what's missing. ZERO IS THE ONLY end-of-input signal; a
// closed stream is not a failure.
Stdin* = {
    read* = (self: @Self, buf :: Vec<u8>, n: usize) Res<usize, IoError>
}

// What reading a file can do instead of handing back bytes. Each is a
// real field failure a caller acts on, so Res not a trap (law 5).
//
// ONE NOMINAL ENUM, not a union: the compiler is written in the seed
// subset, which has no error unions (PLAN.md 0.5) — that's what puts
// OutOfMemory here beside AllocError's own (allocation has exactly one
// failure, no From to convert through). When unions arrive this
// becomes Res<String, FsError | AllocError> and the variant goes.
//
// Failed is the floor, not a shrug: a read that began and didn't
// finish is a real outcome a scanner can't abstain from naming.
FsError* = NotFound       // nothing is at that path
         | Denied         // something is, and this process may not read it
         | IsDir          // the path names a directory, and a directory is not bytes
         | Failed         // the read started and did not finish
         | OutOfMemory    // the buffer could not be obtained

// The filesystem capability, reached only as `env.fs` (law 2, no
// ambient authority).
//
// Each member is one question the compiler asks: what does this file
// say, is anything at this path, is it a folder, can what was written
// be taken back. No open handle, seek, listing, or permission surface
// — a module path is COMPUTED (<folder>/<folder>.zen), not discovered,
// so walking a source tree is two probes and a read.
Fs* = {
    // the whole file at once, into memory `a` owns. Alloc is explicit
    // since reading allocates (law 1); the String returned is not
    // Drop and everything it holds goes back when `a` does.
    //
    // The bytes are BYTES — UTF-8 is not checked here (std.text.text_utf8
    // is where that question is asked, by a caller that wants it).
    read* = (self: @Self, a: Alloc, path: str) Res<String, FsError>

    // bool not Res: neither can fail in a way a caller acts on — an
    // unstat'able path is, for "should I try to open this", just not
    // there. Exist beside `read` so ruling out a candidate costs a
    // stat, not a whole file.
    exists* = (self: @Self, path: str) bool
    is_dir* = (self: @Self, path: str) bool

    // mirror of `read`, and what `zen build src -o stage2.c` needs to
    // honour its own `-o`. No append, mode, or handle — writes one file
    // once. No Alloc: allocates nothing, bytes stay the caller's.
    write* = (self: @Self, path: str, bytes: str) Res<(), FsError>

    // the answer to "make sure this is gone" (#757) — without it,
    // `write` could create state nothing could retire. Same shape as
    // `write`: one path, no Alloc, no handle. NotFound is NOT a
    // failure — the caller's question was already answered by a path
    // that holds nothing — so the bool carries what happened: true
    // when THIS call emptied the name, false when there was nothing
    // to do. A directory version is a separate question.
    remove* = (self: @Self, path: str) Res<bool, FsError>
}

// The network capability. Same as Fs: named, unspecified, empty.
Net* = {
}

ThreadError* = SpawnFailed | Panicked

Thread* = {
    id: u64,

    // block until the body finishes, and yield its result
    join* = <T>(self: @Self) Res<T, ThreadError>
}

// The thread escape hatch, for ffi and batch work. A thread is the one
// kind of authority that can OUTLIVE its creator — why it hangs off
// Env and there's no ambient `thread.spawn`.
//
// spawn takes an Alloc because the body is an ESCAPING closure: it
// runs somewhere its creator's frame can't reach, so it needs its own
// memory. The law doesn't stop at collections.
//
// Never block inside a behavior — it parks a scheduler thread and
// starves every actor queued on it. Not yet enforced by the type
// system; see the report.
// STAGE 5: sleep is a backend capability today (the C floor is
// nanosleep); spawn has no floor yet and stays refused.
Threads* = {
    spawn* = <T>(self: @Self, a: Alloc, body: () Res<T, ThreadError>) Res<Thread, ThreadError>

    sleep* = (self: @Self, ms: u64) ()
}

// The clock capability, reached only as `env.clock` (law 2, no ambient
// authority). Two members, both Duration-valued, no formatting and no
// calendar — the same shape Fs has, and the split is the point:
//
//   since_start is MONOTONIC: for measuring, never for telling the
//   time. It answers with a span since an unspecified epoch, which is
//   all a Duration can honestly be.
//
//   unix is the WALL clock, separately, because they are different
//   authorities and conflating them is how a leap second breaks a
//   timer.
//
// Neither can fail in a way a caller acts on — reading the clock has
// no path-shaped way to miss — so plain Duration and not Res.
Clock* = {
    since_start* = (self: @Self) Duration
    unix*        = (self: @Self) Duration
}

Env* = {
    argv*: Vec<str>,       // raw argv; argv.get(0) is the program path
    out*: Console,         // stdout / stderr
    in*: Stdin,            // stdin, byte-counted, no line discipline
    mem*: Mem,             // page authority: env.mem.alloc() makes an arena
    fs*: Fs,
    net*: Net,
    threads*: Threads,     // the escape hatch, no longer ambient
    clock*: Clock,         // since_start measures; unix tells

    // ONE environment variable, by name. NOT a `Map<str, str>` field:
    // the Env is built before `main` is entered and the only allocator
    // door is `env.mem.alloc()` INSIDE it, so a map here could only ever
    // be the zeroed one C's rule leaves behind — and a zeroed map
    // answers None for every key that IS exported. A capability instead,
    // whose floor is `getenv`.
    //
    // No Alloc, by law 1: the bytes are the process's own environment
    // block, borrowed for its lifetime exactly as an `argv` row is. A
    // caller that wants to keep them past an `execve` copies them.
    //
    // `Res<str>` and not `Res<str, E>`: a variable that is not set is an
    // absence, not a failure — there is no reason to name.
    var* = (self: @Self, name: str) Res<str>

    // Typed args: declare a schema struct, this fills it. Each field
    // maps to `--flag` plus its SCREAMING env var (flag wins); Res<T>
    // fields may be absent, defaulted fields are optional, everything
    // else is required and errors BY NAME — no string fishing.
    //
    // STAGE 5: filling the schema is an @meta walk over T's fields,
    // outside the seed subset (PLAN.md 0.5) — body arrives with
    // src/meta/meta.zen; this signature is DESIGN.md's and won't change.
    args* = <T>(self: @Self) Res<T, ArgError>

    // Spawning is authority too: an actor outlives the block that made
    // it, its arena rooted in the runtime, not main's.
    //
    // STAGE 5: Actor and Ref are declared by std.actor, arriving with
    // the runtime. Kept here (DESIGN.md's signature) so Env's surface
    // is complete and the dependency is visible, not discovered later.
    spawn* = <A: Actor>(self: @Self, actor: A) Ref<A>
}
