// `!=` is NOT a second trait method: DESIGN.md names Eq with one method,
// and sema_bound.zen's comment is explicit -- "`ne` is always `!eq`, they
// can never diverge". The backend lowers NotEqual as the SAME impl call
// under one `!`, so != must agree with == on identical operands with
// nothing more than negation between them.
//
// That agreement is only observable when BOTH spellings of the same
// question are printed, which is what rows 1-2 do for the length-gate
// path ("abc" vs "abcd") and rows 3-4 do for the byte-walk path ("ab"
// vs "ac"). A backend that lowered `!=` to a pointer comparison, or to
// memcmp over the shorter operand, answers one spelling right and the
// other wrong on exactly these pairs.
//
// Breaks it: make lower_eq_op's is_negated branch emit the call WITHOUT
// its `!` (or drop the `!` in write_equality) -- every row below flips.

main = (env: Env) Res<i32, AllocError> {
    println("{}", "abc" != "abcd");
    println("{}", "abc" == "abcd");
    println("{}", "ab" != "ac");
    println("{}", "ab" == "ac");
    println("{}", "" != "");
    Ok(0);
}
