// A function stored in a local keeps its declared arity. Calling the local is
// checked by the same signature rule as calling the declaration directly.
//
// position: the call with a missing argument.

use = (local: (a: i32, b: i32) i32) i32 { local(1) }

main = (env: Env) Res<i32, AllocError> {
    println("{}", use((a: i32, b: i32) i32 { a + b }));
    Ok(0);
}
