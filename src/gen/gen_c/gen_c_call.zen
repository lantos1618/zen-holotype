// src/gen/gen_c/gen_c_call.zen
// What a call is in C, and what a type a call names becomes.
// `Point(x: 3, y: 4)` and `area(p)` are the same AST node. Which one it
// is depends on what the callee NAMES — a struct is constructed, a
// function is called — a question about the declaration, not the call.
// THE QUESTION IS ASKED HERE; construction is `gen_c_build.zen`'s. The
// third thing a callee can name IS here — `Ok`/`Err`, not functions at
// all, built from the expected type.
// `Res` IS STRUCTURAL, so its constructors are built here from the
// EXPECTED type, not resolved. This follows sema: `TyRes` carries no
// declaration, because `Res<T>` and `Res<T, E>` are two arities of one
// name that sema disambiguates at every `.try()`. It's also why an
// expectation is needed — `Ok(0)` alone doesn't say `Res<i32>` or
// `Res<i32, E>`, and DESIGN.md's hoisting rule turns on exactly that.
// OVERLOAD RESOLUTION IS SEMA'S, READ BACK RATHER THAN REDONE. `Cand`
// carries the `DeclId` it came from, and `chosen` writes it into
// `Checker.call_memo` under the call's node id, so `loop`'s seven
// declarations arrive here as a decision, not an ambiguity. A name with
// more than one declaration and NO recorded answer is still reported: a
// backend guessing would be a second, worse copy of sema's resolution
// rule.

ExprId = std.ast
Decl, Function = std.ast
Access, Call, Arg = std.ast
Param, TypeId = std.ast
ModuleOrigin, CBinding, CBindingId = std.ast
AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
DeclId = sema.sema_id
TyId, TyRes = sema.sema_ty
Def, decl_at = sema.sema_def
Ctx = sema.sema_check
Inst = sema.sema_inst
type_from_ast = sema.sema_denote
satisfies_bound = sema.sema_bound
pack_slot, pack_elem = sema.sema_vararg
sym_member, sym_variant, sym_fn = gen.gen_name
RES_PATH = gen.gen_name
CBackend = gen.gen_c.gen_c_state
unsupported, unresolved, untyped, ambiguous = gen.gen_c.gen_c_report
sub_with, any_open, inst_at = gen.gen_c.gen_c_mono
settled_inst, inst_open, enter_tparams, leave_tparams = gen.gen_c.gen_c_mono
complete_inst = gen.gen_c.gen_c_infer
ctype, is_unit, has_storage, c_prim, spellable, declared_ret = gen.gen_c.gen_c_type
c_prim_known = gen.gen_c.gen_c_type
lower_checked_narrow = gen.gen_c.gen_c_num
expr, ty_of, want_of = gen.gen_c.gen_c_expr
value_held, holds = gen.gen_c.gen_c_expr
Dest, deliver = gen.gen_c.gen_c_stmt
is_print, lower_print = gen.gen_c.gen_c_print
lower_dot_call = gen.gen_c.gen_c_member
lower_loop = gen.gen_c.gen_c_loop
is_loop_shape = gen.gen_c.gen_c_shape
inlines, inline_call, closure_slot = gen.gen_c.gen_c_inline
is_null_ptr, lower_null_ptr = gen.gen_c.gen_c_ptr
lower_closure_call = gen.gen_c.gen_c_inline
construct = gen.gen_c.gen_c_build
is_format_door, lower_format_door = gen.gen_c.gen_c_fmt
address_of = gen.gen_c.gen_c_fat
call_callee = sema.sema_call

// One source call, carried unchanged through resolution and emission.
// Keeping these together makes the private lowering chain say what it
// accepts instead of repeating four independent parameters at each hop.
CallSite = {
    id: ExprId,
    c: Call,
    recv: Res<ExprId>,
    ctx: Ctx,
}

// `Res` values

res_value* = (
    be      :: CBackend,
    id      : ExprId,
    want    : TyId,
    variant : str,
    out     :: String
) Res<(), AllocError> {
    be.check.types.at(want).match({
        Res(_) => be.write_res_tagged(want, variant, out),
        _      => be.untyped(id, variant, out),
    })
}

write_res_tagged = (be :: CBackend, want: TyId, variant: str, out :: String)
                   Res<(), AllocError> {
    cty ::= be.alloc.String().try();
    be.ctype(want, cty).try();
    tag ::= be.alloc.String().try();
    tag.sym_variant(RES_PATH, variant).try();
    out.fmt("({}){ .zg_tag = {} }", cty.view(), tag.view())
}

// `Ok(x)` / `Err(e)`: the tag, and the payload under the member the
// variant names. A unit payload takes no member — `Ok(())` carries
// nothing and a void member is illegal C.
// A UNIT PAYLOAD IS STILL EVALUATED: `Ok(f())` on a unit-returning `f`
// carries nothing but DOES something, and writing only the tag would
// drop the call. The literal `()` is the one case with nothing to run.
// EXPORTED BECAUSE HOISTING BUILDS THE SAME VALUE: `7;` closing a
// `Res<i32, E>` is `Ok(7)`, the same tag over the same payload —
// `gen_c_hoist.zen` writing its own copy would be two places holding
// one layout decision.
write_res_payload* = (
    be      :: CBackend,
    id      : ExprId,
    want    : TyId,
    variant : str,
    value   : ExprId,
    payload : TyId,
    ctx     : Ctx,
    out     :: String
)
                     Res<(), AllocError> {
    be.is_unit(payload).match({
        false => Ok(()),
        true  => be.run_for_effect(value, payload, ctx),
    }).try();
    cty ::= be.alloc.String().try();
    be.ctype(want, cty).try();
    out.fmt("({}){ .zg_tag = ", cty.view()).try();
    out.sym_variant(RES_PATH, variant).try();
    be.is_unit(payload).match({
        true  => Ok(()),
        false => be.write_payload_init(variant, value, payload, ctx, out),
    }).try();
    out.add(" }").try();
    Ok(());
}

run_for_effect = (be :: CBackend, value: ExprId, payload: TyId, ctx: Ctx)
                 Res<(), AllocError> {
    be.writes_nothing(value).match({
        true  => Ok(()),
        false => be.deliver(value, ctx, payload, Dest.Discard),
    })
}

writes_nothing = (be: CBackend, value: ExprId) bool {
    be.tree.expr_at(value).kind.match({ Unit => true, _ => false })
}

write_payload_init = (
    be      :: CBackend,
    variant : str,
    value   : ExprId,
    payload : TyId,
    ctx     : Ctx,
    out     :: String
)
                     Res<(), AllocError> {
    out.add(", .zg_data.").try();
    out.sym_member(variant).try();
    out.add(" = ").try();
    be.expr(value, ctx, payload, out).try();
    Ok(());
}

// THE THREE CALLEE FORMS. A bare name is a function or a type; a dot is
// `gen_c_member.zen`'s subject; anything else is a callable value, and
// the general form lowers the callee and calls through it.
lower_call* = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    call_callee(be.tree, c).kind.match({
        Name(n)   => be.lower_name_callee(id, c, n.text, ctx, want, out),
        Access(a) => be.lower_dot_call(id, c, a, ctx, want, out),
        _         => be.lower_indirect(id, c, ctx, out),
    })
}

// A NAME BOUND TO A LAMBDA IS NOT A CALL THROUGH A VALUE: `f(x)` where
// `f` was handed a closure is the closure's own body, inlined here — a
// non-escaping stack closure has no closure record to box, so a
// function-typed parameter has no C storage to call through.
lower_name_callee = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    name : str,
    ctx  : Ctx,
    want : TyId,
    out  :: String
)
                    Res<(), AllocError> {
    be.closure_slot(name).match({
        Ok(s) => be.lower_closure_call(id, c, s, ctx, want, out),
        None  => be.lower_named_call(id, c, name, ctx, want, out),
    })
}

// A callee that is neither a name nor a dot: lower the expression, then
// call through it. The callee's type says how many arguments it takes
// and what they are, so a callee sema couldn't type is REPORTED rather
// than called with a guessed signature.
lower_indirect = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    fty     = be.ty_of(c.callee, ctx, unknown).try();
    be.check.types.at(fty).match({
        Fn(f) => be.write_indirect(c, f.params, ctx, out),
        _     => be.unsupported(
            id,
            "a call through a value that is not a function",
            out
        ),
    })
}

write_indirect = (
    be     :: CBackend,
    c      : Call,
    params : Vec<TyId>,
    ctx    : Ctx,
    out    :: String
) Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    out.add("(").try();
    be.expr(c.callee, ctx, unknown, out).try();
    out.add(")(").try();
    c.args.loop((h, i, a) {
        (i > 0).then(() { out.add(", ").try() });
        hold = be.holds(c, i, 0);
        be.write_indirect_arg(a, i, hold, params, ctx, out).try();
    });
    out.add(")").try();
    Ok(());
}

// A callee that is a VALUE has a `TyFn` and no `Param` list, so there is
// no `::` to read: a function type carries types and not binding
// markers. Everything goes by value, which is what a `TyFn` means.
write_indirect_arg = (
    be     :: CBackend,
    a      : Arg,
    i      : usize,
    hold   : bool,
    params : Vec<TyId>,
    ctx    : Ctx,
    out    :: String
) Res<(), AllocError> {
    want = params.get(i).match({ Ok(t) => t, None => TyId(index: 0) });
    be.value_held(a.value, ctx, want, hold, out)
}

lower_named_call = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    name : str,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    is_res_ctor(name).match({
        true  => be.lower_res_ctor(id, c, name, ctx, want, out),
        false => be.lower_sugar_or_plain(id, c, name, ctx, want, out),
    })
}

// `println` is checked BEFORE resolution, only when nothing declares it:
// the sugar names no function, so there's nothing for the walk to find,
// but a module declaring its own `println` means that. `gen_c_print.zen`
// says why the `Env`-in-scope half of the law isn't enforced here.
lower_sugar_or_plain = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    name : str,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    be.is_sugar(name, ctx).try().match({
        true  => be.lower_print(c, name, ctx, out),
        false => be.lower_plain_call(id, c, name, None, ctx, want, out),
    })
}

is_sugar = (be :: CBackend, name: str, ctx: Ctx) Res<bool, AllocError> {
    is_print(name).match({
        false => Ok(false),
        true  => be.undeclared(name, ctx),
    })
}

undeclared = (be :: CBackend, name: str, ctx: Ctx) Res<bool, AllocError> {
    found ::= be.alloc.Vec<Def>();
    be.check.world.defs_of(ctx.module, name, found).try();
    Ok(found.len == 0);
}

is_res_ctor* = (name: str) bool { name.eq("Ok") || name.eq("Err") }

lower_res_ctor = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    name : str,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    be.check.types.at(want).match({
        Res(r) => be.lower_res_arg(id, c, name, r, ctx, want, out),
        _      => be.untyped(id, name, out),
    })
}

lower_res_arg = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    name : str,
    r    : TyRes,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    payload = name.eq("Ok").match({ true => r.value, false => r.error });
    c.args.get(0).match({
        None  => be.write_res_tagged(want, name, out),
        Ok(a) => be.write_res_payload(
            id,
            want,
            name,
            a.value,
            payload,
            ctx,
            out
        ),
    })
}

// `recv` is the receiver a UFCS call reached this name through — "a free
// function whose first param is the type is callable as a method", so
// the receiver is argument zero and there is no second mechanism.
// `None` is the ordinary `f(a)`.
lower_plain_call* = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    name : str,
    recv : Res<ExprId>,
    ctx  : Ctx,
    want : TyId,
    out  :: String
)
                    Res<(), AllocError> {
    s = CallSite(id: id, c: c, recv: recv, ctx: ctx);
    found ::= be.alloc.Vec<Def>();
    be.check.world.defs_of(ctx.module, name, found).try();
    be.travelled_defs(name, s, found).try();
    be.check.resolved_call(id).match({
        Ok(d) => be.chosen_def(s, name, found, d, want, out),
        None  => be.sole_def(s, name, found, want, out),
    })
}

// THE FUNCTIONS THAT TRAVELLED WITH THE RECEIVER'S TYPE — THE SAME POOL
// SEMA RESOLVED AGAINST. `sema_call.travelled_cands` is the other half,
// and `first_is` below says what a narrower pool costs.
// A dot asks through the receiver. The FREE FORM asks through argument
// zero (#771): UFCS says `f(x)` and `x.f()` are one call surface, so a
// call sema resolved through the travelled pool must find that same
// declaration HERE — when this pool held only the dot's half, `f(x)`
// arrived with an empty `found` and `sole_def` refused with `cannot
// resolve`: right line, wrong pass. The gates are unchanged: only an
// exported function whose FIRST PARAMETER takes the type joins, a
// declaration already in the list is not added twice, and `<T>` swallows
// nothing it did not swallow at the dot (`first_is` reads the DECLARED
// signature, uninstantiated).
travelled_defs = (
    be    :: CBackend,
    name  : str,
    s     : CallSite,
    found :: Vec<Def>
) Res<(), AllocError> {
    s.recv.match({
        Ok(r) => be.travelled_for(name, r, s.ctx, found),
        None  => s.c.args.get(0).match({
            None  => Ok(()),
            Ok(a) => be.travelled_for(name, a.value, s.ctx, found),
        }),
    })
}

travelled_for = (
    be    :: CBackend,
    name  : str,
    r     : ExprId,
    ctx   : Ctx,
    found :: Vec<Def>
) Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    rty     = be.ty_of(r, ctx, unknown).try();
    defs ::= be.alloc.Vec<Def>();
    be.check.world.exported_named(name, defs).try();
    defs.loop((h, d) { be.keep_travelled(d, rty, found).try() });
    Ok(());
}

keep_travelled = (be :: CBackend, d: Def, rty: TyId, found :: Vec<Def>)
                 Res<(), AllocError> {
    dup = has_def(found, d.id);
    dup.match({
        true  => Ok(()),
        false => be.add_receiving(d, rty, found),
    })
}

add_receiving = (be :: CBackend, d: Def, rty: TyId, found :: Vec<Def>)
                Res<(), AllocError> {
    be.receives(d, rty).try().match({
        true  => found.add(d),
        false => Ok(()),
    })
}

// Whether the receiver is this declaration's first parameter, read off
// the DECLARED type, uninstantiated — so `(self: u32)` answers and
// `<T>(self: T)` does not, which is right: a bare parameter would
// swallow every receiver in the program.
receives = (be :: CBackend, d: Def, rty: TyId) Res<bool, AllocError> {
    inst ::= be.alloc.Inst();
    sig  ::= be.alloc.Vec<TyId>();
    ok = be.signature_of(d, inst, sig).try();
    ok.match({ false => Ok(false), true => be.first_is(sig, rty) })
}

// `satisfies_bound` — an impl of the declared type, or the same type —
// is `sema_cand.takes_receiver`'s gate spelled again, since this is the
// second half of ONE pool. An `Arena` reaches `Vec* = <T>(a: Alloc)
// Vec<T>` through `Arena.impl(Alloc, ..)`; a pool narrower than sema's
// holds no declaration for what `resolved_call` wrote down, so
// `sole_def` re-decides an already-settled call and calls it not a
// function at all.
first_is = (be :: CBackend, sig: Vec<TyId>, rty: TyId)
           Res<bool, AllocError> {
    sig.get(0).match({
        None  => Ok(false),
        Ok(t) => satisfies_bound(be.check, rty, t),
    })
}

// MEMBERSHIP IS THE SEARCH ALREADY WRITTEN: `def_with_id` runs this
// exact find over these exact entries, so "is it in the pool" is that
// answer read as a question — not a second ladder that could drift
// from the first.
has_def = (found: Vec<Def>, id: DeclId) bool {
    def_with_id(found, id).match({ Ok(_) => true, None => false })
}

// SEMA ALREADY ANSWERED THIS (header): `resolved_call` is the
// declaration overload resolution picked, keyed on this node.
chosen_def = (
    be    :: CBackend,
    s     : CallSite,
    name  : str,
    found : Vec<Def>,
    want  : DeclId,
    dest  : TyId,
    out   :: String
) Res<(), AllocError> {
    def_with_id(found, want).match({
        Ok(d) => be.call_kind(s, d, dest, out),
        None  => be.sole_def(s, name, found, dest, out),
    })
}

// The candidate sema resolved to. Read out of the queue's own
// entries, so a query and a lowering that both start from the same
// `resolved_call` cannot disagree about which declaration it named.
def_with_id* = (found: Vec<Def>, want: DeclId) Res<Def> {
    Range(0, found.len).find((i) {
        found.get(i).match({ Ok(d) => d.id.eq(want), None => false })
    }).match({
        Ok(i) => found.get(i),
        None  => None,
    })
}

// Nothing resolved this node, so the only choice a backend may make is
// the one with nothing to choose: exactly one declaration. Picking
// between candidates here is the guess the whole seam exists to avoid.
sole_def = (
    be    :: CBackend,
    s     : CallSite,
    name  : str,
    found : Vec<Def>,
    dest  : TyId,
    out   :: String
)
           Res<(), AllocError> {
    found.len.match({
        0 => be.unresolved(s.id, name, out),
        1 => be.call_kind(
            s,
            found.get(0).ok_or(AllocError.OutOfMemory).try(),
            dest,
            out
        ),
        _ => be.ambiguous(s.id, name, out),
    })
}

call_kind = (
    be   :: CBackend,
    s    : CallSite,
    d    : Def,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    d.kind.match({
        FunctionDef => be.call_resolved(s, d, want, out),
        StructDef   => be.construct(s.id, s.c, d, s.ctx, out),
        _           => be.unsupported(
            s.id,
            "a call to something that is not a function",
            out
        ),
    })
}

// The symbol is built from the DECLARATION's parameter types, making two
// overloads of a name two symbols. Read back out of the AST because
// sema doesn't yet answer "what is this function's type" — the seam
// closes when it does.
call_resolved = (
    be   :: CBackend,
    s    : CallSite,
    d    : Def,
    want : TyId,
    out  :: String
)
                Res<(), AllocError> {
    decl_at(be.tree, d.id).match({
        None  => be.unsupported(
            s.id,
            "a call to something that is not a plain function",
            out
        ),
        Ok(x) => be.call_decl(s, d, x, want, out),
    })
}

call_decl = (
    be   :: CBackend,
    s    : CallSite,
    d    : Def,
    x    : Decl,
    want : TyId,
    out  :: String
)
            Res<(), AllocError> {
    x.kind.match({
        Function(f) => be.call_fn(s, d, f, want, out),
        _           => be.unsupported(
            s.id,
            "a call to something that is not a plain function",
            out
        ),
    })
}

// THE LOOP INTRINSIC IS DECIDED BEFORE THE SIGNATURE IS READ, because
// there's no signature to read: `loop_iter.zen`'s seven declarations have
// no bodies, and their type parameters are reachable only through the
// closure, which infers FROM a signature rather than settling one. Not
// an inference failure — it's the construct whose body this backend is.
call_fn = (
    be   :: CBackend,
    s    : CallSite,
    d    : Def,
    f    : Function,
    dest : TyId,
    out  :: String
) Res<(), AllocError> {
    // THE DESTINATION'S CONCRETE ANSWER OUTRANKS SEMA'S OPEN ONE. Sema
    // leaves the loop's `T` undecided (`Res<q>`), and `want_of` asks it
    // again with nothing to go on. A context that already named the type
    // — `found: Res<usize> = loop(..)` — handed this call a decision,
    // and dropping it here declared the result temporary at whatever the
    // break arguments reconstructed instead (#784). The unknown falls
    // through to `want_of`, the only speaker left.
    decided = be.check.is_unknown(dest).match({
        false => Ok(dest),
        true  => be.want_of(s.id, s.ctx),
    }).try();
    be.is_loop_shape(f).match({
        true  => be.lower_loop(s.id, s.c, f, s.recv, s.ctx, decided, out),
        false => be.call_or_inline(s, d, f, out),
    })
}

// A CALLEE HANDED A LAMBDA IS INLINED RATHER THAN CALLED, not an
// optimisation: a `() T` parameter has no C spelling, so there's no
// symbol to emit and nothing to pass. `gen_c_inline.zen` is the general
// case the loop intrinsic is the special one of.
call_or_inline = (
    be  :: CBackend,
    s   : CallSite,
    d   : Def,
    f   : Function,
    out :: String
)
                 Res<(), AllocError> {
    be.inlines(s.c, f).match({
        true  => be.inline_call(s.id, s.c, d, f, s.recv, s.ctx, out),
        false => be.call_or_floor(s, d, f, out),
    })
}

// `null_ptr<T>()` is a free function with no body, and the backend is
// its body — the same bargain `mem_ptr.zen`'s nine members strike, the
// one place a Ptr is made rather than used.
call_or_floor = (
    be  :: CBackend,
    s   : CallSite,
    d   : Def,
    f   : Function,
    out :: String
)
                Res<(), AllocError> {
    is_null_ptr(d.name).match({
        true  => be.lower_null_ptr(s.id, be.want_of(s.id, s.ctx).try(), out),
        false => be.call_or_format(s, d, f, out),
    })
}

// `alloc.String("{}", x)` is a bodyless variadic declaration and the
// backend is its body, for the same reason: a variadic parameter has no
// C spelling and `{}` resolves by the argument's type, so there's
// nothing one body could have been.
call_or_format = (
    be  :: CBackend,
    s   : CallSite,
    d   : Def,
    f   : Function,
    out :: String
)
                 Res<(), AllocError> {
    be.is_format_door(d, f).match({
        true  => be.lower_format_door(s.id, s.c, d, f, s.recv, s.ctx, out),
        false => be.call_or_convert(s, d, f, out),
    })
}

// `to_u64* = (self: u8) u64` is a signature with no body — `std.core.num`
// says why: "conversions are methods, never a cast keyword", and a cast
// can't be written in terms of anything below it, so the backend is the
// body.
// EMITTING THE CALL INSTEAD IS A LINKER ERROR, not a wrong answer: a
// bodyless declaration defines no symbol. That's how this was found —
// closing `to_usize`'s RESOLUTION without closing its BODY moved the
// fault rather than fixing it.
// ONLY LOSSLESS WIDENING IS DECLARED, so the cast is the whole of it,
// nothing to check. A narrowing conversion "can fail, so it belongs in
// a Res-returning function someone writes on purpose" — such a
// function has a body and never reaches here.
call_or_convert = (
    be  :: CBackend,
    s   : CallSite,
    d   : Def,
    f   : Function,
    out :: String
)
                  Res<(), AllocError> {
    checked_narrow(d, f).match({
        true  => be.lower_narrow_call(s, d, out),
        false => convert_target(d, f).match({
            Ok(t) => be.lower_convert(s.c, d, t, s.recv, s.ctx, out),
            None  => be.call_or_plain(s, d, f, out),
        }),
    })
}

checked_narrow = (d: Def, f: Function) bool {
    d.qname.eq("std.core.num.to_u8") && d.name.eq("to_u8") && convert_shape(f)
}

lower_narrow_call = (be :: CBackend, s: CallSite, d: Def, out :: String)
                    Res<(), AllocError> {
    inst ::= be.alloc.Inst();
    sig  ::= be.alloc.Vec<TyId>();
    be.signature_of(d, inst, sig).try();
    unknown = be.check.types.unknown().try();
    src     = sig.get(0).match({ Ok(t) => t, None => unknown });
    ret     = be.check.type_of(s.id, s.ctx).try();
    recv_arg(s.c, s.recv).match({
        None      => out.add("0"),
        Ok(value) => be.lower_checked_narrow(s.id, value, src, ret, s.ctx, out),
    })
}

// A bodyless free function is a foreign C symbol, emitted only when called.
// Compiler-owned floors have already diverted above this point.
call_or_plain = (
    be  :: CBackend,
    s   : CallSite,
    d   : Def,
    f   : Function,
    out :: String
)
                 Res<(), AllocError> {
    bodyless(f).match({
        true  => be.call_extern(s, d, f, out),
        false => be.call_signature(s, d, f, out),
    })
}

call_extern = (
    be  :: CBackend,
    s   : CallSite,
    d   : Def,
    f   : Function,
    out :: String
) Res<(), AllocError> {
    plain(f).match({
        false => be.unsupported(
            s.id,
            "a generic function has no single foreign symbol",
            out
        ),
        true  => {
            inst ::= be.alloc.Inst();
            sig  ::= be.alloc.Vec<TyId>();
            be.signature_of(d, inst, sig).try().match({
                false => be.unsupported(
                    s.id,
                    "a foreign function whose parameters have no written type",
                    out
                ),
                true  => be.write_extern_at(s, d, f, sig, out),
            })
        },
    })
}

write_extern* = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    d    : Def,
    f    : Function,
    sig  : Vec<TyId>,
    recv : Res<ExprId>,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    s = CallSite(id: id, c: c, recv: recv, ctx: ctx);
    be.write_extern_at(s, d, f, sig, out)
}

write_extern_at = (
    be  :: CBackend,
    s   : CallSite,
    d   : Def,
    f   : Function,
    sig : Vec<TyId>,
    out :: String
) Res<(), AllocError> {
    ret = be.foreign_ret(d, f).try();
    be.foreign_types_spellable(ret, sig).match({
        false => be.unsupported(
            s.id,
            "a foreign function with a type C cannot spell",
            out
        ),
        true  => be.foreign_origin_call(s, d, f, ret, sig, out),
    })
}

foreign_origin_call = (
    be  :: CBackend,
    s   : CallSite,
    d   : Def,
    f   : Function,
    ret : TyId,
    sig : Vec<TyId>,
    out :: String
) Res<(), AllocError> {
    be.tree.module_origin_at(d.id.module.to_usize()).match({
        Ok(ModuleOrigin.CBinding(id)) => be.header_owned_call(
            s,
            d,
            f,
            sig,
            id,
            out
        ),
        _                             => be.raw_foreign_call(
            s,
            d,
            f,
            ret,
            sig,
            out
        ),
    })
}

raw_foreign_call = (
    be  :: CBackend,
    s   : CallSite,
    d   : Def,
    f   : Function,
    ret : TyId,
    sig : Vec<TyId>,
    out :: String
) Res<(), AllocError> {
    proto ::= be.alloc.String().try();
    be.foreign_proto(d.name, f, ret, sig, proto).try();
    be.need_extern(d.name, proto).try().match({
        false => be.unsupported(
            s.id,
            "one foreign symbol declared with more than one signature",
            out
        ),
        true  => be.write_call(s, d, f, sig, d.name, out),
    })
}

header_owned_call = (
    be  :: CBackend,
    s   : CallSite,
    d   : Def,
    f   : Function,
    sig : Vec<TyId>,
    id  : CBindingId,
    out :: String
) Res<(), AllocError> {
    be.tree.c_binding_at(id).match({
        None    => be.bad_c_binding(
            s.id,
            "a C binding module has no binding metadata",
            out
        ),
        Ok(raw) => be.use_c_binding(s, d, f, sig, raw, out),
    })
}

use_c_binding = (
    be  :: CBackend,
    s   : CallSite,
    d   : Def,
    f   : Function,
    sig : Vec<TyId>,
    raw : CBinding,
    out :: String
) Res<(), AllocError> {
    (raw.headers.len == 0).match({
        true  => be.bad_c_binding(
            s.id,
            "a C binding module has no headers",
            out
        ),
        false => be.use_c_headers(s, d, f, sig, raw, out),
    })
}

use_c_headers = (
    be  :: CBackend,
    s   : CallSite,
    d   : Def,
    f   : Function,
    sig : Vec<TyId>,
    raw : CBinding,
    out :: String
) Res<(), AllocError> {
    valid ::= true;
    raw.headers.loop((h, header) {
        be.need_c_header(header.path, header.system).try().match({
            true  => (),
            false => { valid = false; },
        });
    });
    valid.match({
        true  => be.write_call(s, d, f, sig, d.name, out),
        false => be.bad_c_binding(
            s.id,
            "a C binding header path contains a byte that cannot appear in an include name",
            out
        ),
    })
}

bad_c_binding = (be :: CBackend, id: ExprId, why: str, out :: String)
                Res<(), AllocError> {
    be.unsupported(id, why, out)
}

foreign_ret = (be :: CBackend, d: Def, f: Function)
              Res<TyId, AllocError> {
    be.declared_ret(
        f,
        Ctx(
            module: d.id.module.to_usize(),
            ret: TyId(index: 0),
            has_ret: false,
            self_ty: TyId(index: 0),
            has_self: false
        )
    )
}

foreign_types_spellable = (be: CBackend, ret: TyId, sig: Vec<TyId>) bool {
    be.spellable(ret) && Range(0, sig.len).find((i) {
        sig.get(i).match({
            Ok(t) => !be.spellable(t),
            None  => true,
        })
    }).match({ Ok(_) => false, None => true })
}

foreign_proto = (
    be   :: CBackend,
    name : str,
    f    : Function,
    ret  : TyId,
    sig  : Vec<TyId>,
    out  :: String
) Res<(), AllocError> {
    out.add("extern ").try();
    be.ctype(ret, out).try();
    out.fmt(" {name}(").try();
    (f.params.len == 0).match({
        true  => out.add("void"),
        false => be.foreign_params(f, sig, out),
    }).try();
    out.add(")")
}

foreign_params = (be :: CBackend, f: Function, sig: Vec<TyId>, out :: String)
                 Res<(), AllocError> {
    f.params.loop((h, i, p) {
        (i > 0).then(() { out.add(", ").try() });
        ty = sig.get(i).match({ Ok(t) => t, None => TyId(index: 0) });
        be.ctype(ty, out).try();
        (p.mutable).then(() { out.add(" *").try() });
    });
    Ok(())
}

// The primitive a bodyless one-parameter `to_<prim>` names. Asked of
// the DECLARATION and not of the name alone: a module's own `to_thing`
// with a body is its own function and is called like any other.
convert_target = (d: Def, f: Function) Res<str> {
    convert_shape(f).match({
        false => None,
        true  => keep_prim(after_to(d.name)),
    })
}

convert_shape = (f: Function) bool {
    bodyless(f) && (f.params.len == 1) && (f.tparams.len == 0)
}

bodyless = (f: Function) bool {
    f.body.match({ Ok(_) => false, None => true })
}

after_to = (name: str) str {
    ((name.len > 3) && name.slice(0, 3).eq("to_")).match({
        true  => name.slice(3, name.len),
        false => "",
    })
}

keep_prim = (target: str) Res<str> {
    c_prim_known(target).match({ true => Ok(target), false => None })
}

// The receiver, or the sole written argument: `b.to_u64()` and
// `to_u64(b)` are one call written two ways, which is what UFCS means.
lower_convert = (
    be     :: CBackend,
    c      : Call,
    d      : Def,
    target : str,
    recv   : Res<ExprId>,
    ctx    : Ctx,
    out    :: String
)
                Res<(), AllocError> {
    recv_arg(c, recv).match({
        None  => out.add("0"),
        Ok(v) => be.write_convert(d, v, target, ctx, out),
    })
}

// ARGUMENT ZERO OF THE SIGNATURE: the receiver when the call was
// written `x.f(..)`, and the first written argument when it was written
// `f(x, ..)`. The same shift `write_call` makes, and the one every
// lowering that reads past the dot needs.
recv_arg* = (c: Call, recv: Res<ExprId>) Res<ExprId> {
    recv.match({
        Ok(r) => Ok(r),
        None  => arg_value(c, 0),
    })
}

arg_value* = (c: Call, i: usize) Res<ExprId> {
    c.args.get(i).match({ Ok(a) => Ok(a.value), None => None })
}

// The operand takes the DECLARED parameter's type, not the target's, so
// a literal argument is written at the width it's converted FROM — the
// width the declaration chose the overload on.
write_convert = (
    be     :: CBackend,
    d      : Def,
    v      : ExprId,
    target : str,
    ctx    : Ctx,
    out    :: String
) Res<(), AllocError> {
    inst ::= be.alloc.Inst();
    sig  ::= be.alloc.Vec<TyId>();
    be.signature_of(d, inst, sig).try();
    unknown = be.check.types.unknown().try();
    src     = sig.get(0).match({ Ok(t) => t, None => unknown });
    out.fmt("({})(", c_prim(target)).try();
    be.expr(v, ctx, src, out).try();
    out.add(")")
}

call_signature = (
    be  :: CBackend,
    s   : CallSite,
    d   : Def,
    f   : Function,
    out :: String
)
                 Res<(), AllocError> {
    raw     = be.inst_at(s.id).try();
    settled = be.settled_inst(f.tparams, d.qname, raw).try();
    inst    = be.complete_inst(s.c, d, f, settled, s.recv, s.ctx).try();
    sig ::= be.alloc.Vec<TyId>();
    ok = be.signature_of(d, inst, sig).try();
    ok.match({
        false => be.unsupported(s.id, be.plain_fault(d), out),
        true  => be.call_settled(s, d, f, sig, inst, out),
    })
}

// A GENERIC CALL NOTHING SETTLED IS REFUSED, not emitted, for the
// reason `gen_c_mono.zen`'s header gives: a free parameter mangles to
// one letter, so every instantiation would be one C symbol.
call_settled = (
    be   :: CBackend,
    s    : CallSite,
    d    : Def,
    f    : Function,
    sig  : Vec<TyId>,
    inst : Inst,
    out  :: String
) Res<(), AllocError> {
    (be.inst_open(inst) || be.any_open(sig)).match({
        true  => be.unsupported(
            s.id,
            "a generic call whose type arguments nothing settles",
            out
        ),
        false => be.call_reachable(s, d, f, sig, inst, out),
    })
}

// THE EDGE THE REACHABILITY WALK FOLLOWS (`gen_c_decl.zen`): a call that
// resolves queues the function it resolved to. Without it a translation
// unit calls symbols nothing defines — `cc` catches it, but a compiler
// shouldn't have emitted it.
// THE SYMBOL IS BUILT ONCE, USED TWICE — as the queue's identity and the
// call's text — so "was this already emitted" and "what do I call" are
// the same question. Two `Vec` instantiations are two entries exactly
// when they're two symbols.
call_reachable = (
    be   :: CBackend,
    s    : CallSite,
    d    : Def,
    f    : Function,
    sig  : Vec<TyId>,
    inst : Inst,
    out  :: String
) Res<(), AllocError> {
    sym ::= be.alloc.String().try();
    sym_fn(sym, be.check.types, be.check.world, d.qname, sig, inst).try();
    be.need_function(d, inst, sym.view()).try();
    be.write_call(s, d, f, sig, sym.view(), out)
}

// Which of the things a callee can be that this backend does not lower.
plain_fault = (be :: CBackend, d: Def) str {
    decl_at(be.tree, d.id).match({
        None  => "a call to something that is not a plain function",
        Ok(x) => decl_fault(x),
    })
}

decl_fault = (x: Decl) str {
    x.kind.match({
        Function(_) => "a call to a function whose parameters have no written type",
        _           => "a call to something that is not a plain function",
    })
}

// The declared parameter types of a function, in order, at this
// instantiation. `false` when the declaration isn't a function or a
// parameter has no written type to read.
// THE TYPE PARAMETERS GO BACK IN SCOPE around the read: `(v: T)` is a
// written type and `T` means nothing unless bound — `gen_c_mono.zen`'s
// `enter_tparams`, and its header says why.
signature_of* = (be :: CBackend, d: Def, inst: Inst, sig :: Vec<TyId>)
                Res<bool, AllocError> {
    decl_at(be.tree, d.id).match({
        None  => Ok(false),
        Ok(x) => x.kind.match({
            Function(f) => be.params_into(d, f, inst, sig),
            _           => Ok(false),
        }),
    })
}

params_into = (
    be   :: CBackend,
    d    : Def,
    f    : Function,
    inst : Inst,
    sig  :: Vec<TyId>
) Res<bool, AllocError> {
    mark = be.enter_tparams(f.tparams, d.qname).try();
    ok   = be.collect_params(d, f.params, inst, sig).try();
    be.leave_tparams(mark).try();
    Ok(ok);
}

plain* = (f: Function) bool { f.tparams.len == 0 }

collect_params = (
    be     :: CBackend,
    d      : Def,
    params : Vec<Param>,
    inst   : Inst,
    sig    :: Vec<TyId>
) Res<bool, AllocError> {
    ctx = Ctx(
        module: d.id.module.to_usize(),
        ret: TyId(index: 0),
        has_ret: false,
        self_ty: TyId(index: 0),
        has_self: false
    );
    params.loop((h, p) {
        p.type.match({
            Ok(t) => be.add_param(t, ctx, inst, sig),
            None  => Ok(()),
        }).try();
    });
    Ok(sig.len == params.len);
}

// The declared type, then the instantiation. One substitution, not two:
// a declared parameter mentions only the CALLEE's parameters, and
// `settled_inst` already put the caller's answers into the arguments —
// what comes out is already in the caller's terms.
add_param = (
    be   :: CBackend,
    t    : TypeId,
    ctx  : Ctx,
    inst : Inst,
    sig  :: Vec<TyId>
) Res<(), AllocError> {
    declared = be.check.type_from_ast(t, ctx).try();
    sig.add(be.sub_with(declared, inst).try())
}

write_call = (
    be  :: CBackend,
    s   : CallSite,
    d   : Def,
    f   : Function,
    sig : Vec<TyId>,
    sym : str,
    out :: String
)
             Res<(), AllocError> {
    out.fmt("{sym}(").try();
    first = be.write_receiver(s.recv, s.c, f, sig, s.ctx, out).try();
    be.write_call_args(s.c, first, f, sig, s.ctx, out).try();
    out.add(")").try();
    Ok(());
}

// The arguments, from signature position `first` on: as written, or with
// the tail gathered into one `vararg<T>` value. ONE dispatch, read here
// and by the METHOD path (`gen_c_member.zen`'s `emit_method_call`) — a pack
// built the same way whichever spelling reached it, which is the same
// reason `pack_sig_fits` is one function in sema.
write_call_args* = (
    be    :: CBackend,
    c     : Call,
    first : usize,
    f     : Function,
    sig   : Vec<TyId>,
    ctx   : Ctx,
    out   :: String
) Res<(), AllocError> {
    pack_slot(be.types(), sig).match({
        None     => be.write_written_args(c, first, f, sig, ctx, out),
        Ok(slot) => be.write_to_pack(c, first, slot, f, sig, ctx, out),
    })
}

write_written_args = (
    be    :: CBackend,
    c     : Call,
    first : usize,
    f     : Function,
    sig   : Vec<TyId>,
    ctx   : Ctx,
    out   :: String
) Res<(), AllocError> {
    written ::= first > 0;
    unknown = be.check.types.unknown().try();
    c.args.loop((h, i, a) {
        pos = i + first;
        ty  = sig.get(pos).match({ Ok(t) => t, None => unknown });
        be.has_storage(ty).match({
            false => be.deliver(a.value, ctx, ty, Dest.Discard),
            true  => {
                written.then(() { out.add(", ").try() });
                hold = be.holds(c, pos, first);
                be.write_arg_at(a.value, pos, hold, f, sig, ctx, out).try();
                written = true;
                Ok(())
            },
        }).try();
    });
    Ok(());
}

// A `vararg<T>` PARAMETER TAKES ONE C ARGUMENT, NOT N. The fixed prefix
// is written as it always was; everything from `slot` on becomes a single
// pack value, built here.
// `slot` is a SIGNATURE index and so is `i + first`, which is what lets a
// ufcs receiver occupy position zero without shifting the pack.
write_to_pack = (
    be    :: CBackend,
    c     : Call,
    first : usize,
    slot  : usize,
    f     : Function,
    sig   : Vec<TyId>,
    ctx   : Ctx,
    out   :: String
) Res<(), AllocError> {
    c.args.loop((h, i, a) {
        ((i + first) < slot).then(() {
            (i + first > 0).then(() { out.add(", ").try() });
            hold = be.holds(c, i + first, first);
            be.write_arg_at(a.value, i + first, hold, f, sig, ctx, out).try();
        });
    });
    (slot > 0).then(() { out.add(", ").try() });
    pack = sig.get(slot).match({ Ok(t) => t, None => TyId(index: 0) });
    be.write_pack(c, first, slot, pack, ctx, out);
}

// THE PACK IS A C COMPOUND LITERAL OVER A COMPOUND LITERAL: a run of the
// swallowed arguments, and the two words that describe it. Both have
// automatic storage in the CALLING block, which is exactly long enough
// for the call and no longer — so the pack borrows and never owns, and
// `sema_vararg.zen` refuses every position it could outlive the call from.
// No allocation, so `make bench-allocs` is untouched by a vararg call.
write_pack = (
    be    :: CBackend,
    c     : Call,
    first : usize,
    slot  : usize,
    pack  : TyId,
    ctx   : Ctx,
    out   :: String
) Res<(), AllocError> {
    be.is_forwarded_pack(c, first, slot, pack, ctx).try().match({
        true  => be.write_forwarded(c, first, slot, pack, ctx, out),
        false => be.write_spread(c, first, slot, pack, ctx, out),
    })
}

// FORWARDING: one swallowed argument that is ALREADY the pack, passed
// straight through. This is the whole point of `vararg<T>` over `...` —
// a marker carrying no element type has no C value to hand on — and it
// is a struct copy, not a rebuild.
// The two readings of one slot cannot collide because `vararg` does not
// nest: an argument of the pack's own type is never also one of its
// elements.
is_forwarded_pack = (
    be    :: CBackend,
    c     : Call,
    first : usize,
    slot  : usize,
    pack  : TyId,
    ctx   : Ctx
) Res<bool, AllocError> {
    ((c.args.len + first) == (slot + 1)).match({
        false => Ok(false),
        true  => be.pack_typed_arg(c, first, slot, pack, ctx),
    })
}

pack_typed_arg = (
    be    :: CBackend,
    c     : Call,
    first : usize,
    slot  : usize,
    pack  : TyId,
    ctx   : Ctx
) Res<bool, AllocError> {
    arg_value(c, slot - first).match({
        None  => Ok(false),
        Ok(v) => be.same_as_pack(v, pack, ctx),
    })
}

same_as_pack = (be :: CBackend, v: ExprId, pack: TyId, ctx: Ctx)
               Res<bool, AllocError> {
    got = be.ty_of(v, ctx, pack).try();
    Ok(got.eq(pack));
}

write_forwarded = (
    be    :: CBackend,
    c     : Call,
    first : usize,
    slot  : usize,
    pack  : TyId,
    ctx   : Ctx,
    out   :: String
) Res<(), AllocError> {
    arg_value(c, slot - first).match({
        None  => Ok(()),
        Ok(v) => be.expr(v, ctx, pack, out),
    })
}

// `(<pack>){ .data = (<elem>[]){ a, b, c }, .len = 3u }`, and `{ 0 }` for
// an empty pack — a zero-length array initialiser is a GNU extension, and
// `{ 0 }` says the same thing in C99: a null run of length zero.
write_spread = (
    be    :: CBackend,
    c     : Call,
    first : usize,
    slot  : usize,
    pack  : TyId,
    ctx   : Ctx,
    out   :: String
) Res<(), AllocError> {
    out.add("(").try();
    be.ctype(pack, out).try();
    out.add(")").try();
    ((c.args.len + first) == slot).match({
        true  => out.add("{ 0 }"),
        false => be.write_run(c, first, slot, pack, ctx, out),
    })
}

write_run = (
    be    :: CBackend,
    c     : Call,
    first : usize,
    slot  : usize,
    pack  : TyId,
    ctx   : Ctx,
    out   :: String
) Res<(), AllocError> {
    elem = pack_elem(be.types(), pack).match({ Ok(t) => t, None => pack });
    out.add("{ .").try();
    sym_member(out, "data").try();
    out.add(" = (").try();
    be.ctype(elem, out).try();
    out.add("[]){ ").try();
    be.write_pack_elems(c, first, slot, elem, ctx, out).try();
    out.add(" }, .").try();
    sym_member(out, "len").try();
    out.add(" = ").try();
    out.write_usize(c.args.len + first - slot).try();
    out.add("u }").try();
    Ok(());
}

// Each swallowed argument at the pack's ELEMENT type, so a literal takes
// its width from `T` exactly as it would in a fixed array literal.
write_pack_elems = (
    be    :: CBackend,
    c     : Call,
    first : usize,
    slot  : usize,
    elem  : TyId,
    ctx   : Ctx,
    out   :: String
) Res<(), AllocError> {
    c.args.loop((h, i, a) {
        ((i + first) >= slot).then(() {
            ((i + first) > slot).then(() { out.add(", ").try() });
            hold = be.holds(c, i + first, first);
            be.value_held(a.value, ctx, elem, hold, out).try();
        });
    });
    Ok(());
}

// The receiver a ufcs call arrived through, as argument zero. The answer
// is how many arguments were written, which is what shifts the rest of
// them one place along their own signature.
write_receiver = (
    be   :: CBackend,
    recv : Res<ExprId>,
    c    : Call,
    f    : Function,
    sig  : Vec<TyId>,
    ctx  : Ctx,
    out  :: String
)
                 Res<usize, AllocError> {
    recv.match({
        None     => Ok(0),
        Ok(base) => be.write_recv_expr(base, c, f, sig, ctx, out),
    })
}

// A receiver stands before every argument, so it is held whenever any of
// them still has a call to run.
write_recv_expr = (
    be   :: CBackend,
    base : ExprId,
    c    : Call,
    f    : Function,
    sig  : Vec<TyId>,
    ctx  : Ctx,
    out  :: String
)
                  Res<usize, AllocError> {
    hold = be.holds(c, 0, 1);
    be.write_arg_at(base, 0, hold, f, sig, ctx, out).try();
    Ok(1);
}

// An argument to a `::` parameter is passed BY ADDRESS: `::` says the
// callee writes the caller's own bytes, so there has to be an address
// to write through. The argument text is not assumed to be a place —
// a call result is a temporary this frame owns but is an rvalue in C —
// so `address_of` takes `&` of a place and spills anything else into a
// temporary first.
write_arg* = (
    be    :: CBackend,
    value : ExprId,
    i     : usize,
    f     : Function,
    sig   : Vec<TyId>,
    ctx   : Ctx,
    out   :: String
)
             Res<(), AllocError> {
    be.write_arg_at(value, i, false, f, sig, ctx, out)
}

// The argument, HELD or not. A `::` parameter is never held: it is handed
// the address of its argument, and the address of a copy is a different
// variable — the callee would write the temporary and the caller would
// never see it. It does not need to be: `write_address` takes `&` of a
// place, and a place runs nothing.
write_arg_at* = (
    be    :: CBackend,
    value : ExprId,
    i     : usize,
    hold  : bool,
    f     : Function,
    sig   : Vec<TyId>,
    ctx   : Ctx,
    out   :: String
) Res<(), AllocError> {
    want = sig.get(i).match({ Ok(t) => t, None => TyId(index: 0) });
    by_ref(f, i).match({
        false => be.value_held(value, ctx, want, hold, out),
        true  => be.write_address(value, ctx, want, out),
    })
}

by_ref* = (f: Function, i: usize) bool {
    f.params.get(i).match({ Ok(p) => p.mutable, None => false })
}

// A `::` parameter is handed the ADDRESS of its argument, and that is
// true of an inlined body's argument too — `gen_c_inline.zen` goes
// through the same place-aware lowering for the same reason.
write_address* = (
    be    :: CBackend,
    value : ExprId,
    ctx   : Ctx,
    want  : TyId,
    out   :: String
) Res<(), AllocError> {
    code ::= be.alloc.String().try();
    be.expr(value, ctx, want, code).try();
    be.address_of(code.view(), want, out).try();
    Ok(());
}
