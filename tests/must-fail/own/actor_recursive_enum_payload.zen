// Recursive payloads terminate classification, while an unsafe branch later
// in the same enum is still found.

Message = End | Next(Message) | Bytes(Vec<u8>)

Worker = {}

Worker.impl(Actor, {
    process = (self :: @Self, ctx: Context, payload: Message) {
        ctx.env.out.println("received")
    }
})

forward = (worker: Ref<Worker>, payload: Message) Res<(), ActorError> {
    worker.process(payload).try();
    Ok(())
}

main = (env: Env) Res<i32, AllocError> { Ok(0) }
