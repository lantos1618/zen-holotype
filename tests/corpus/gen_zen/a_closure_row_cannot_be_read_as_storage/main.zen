Ast = std.ast.ast_arena
Pos, Span = std.ast.ast_span
AllocError = std.mem
String = std.text
Checker = sema.sema_check
CBackend, LocalSlot = gen.gen_c
write_name_slot = gen.gen_c.gen_c_expr
write_scope_slot = gen.gen_c.gen_c_scope
write_param_slot = gen.gen_c.gen_c_decl

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    tree  ::= alloc.Ast();
    check ::= alloc.Checker(tree).try();
    ty = check.types.prim("i32").try();
    be ::= alloc.CBackend(tree, check).try();
    closure    = LocalSlot(
        name: "f",
        index: 0,
        ty: ty,
        by_ref: false,
        handle: 0,
        closure: 1
    );
    storage    = LocalSlot(
        name: "x",
        index: 7,
        ty: ty,
        by_ref: false,
        handle: 0,
        closure: 0
    );
    read_span  = Span(
        file: "in.zen",
        start: Pos(line: 4, col: 7),
        end: Pos(line: 4, col: 8)
    );
    scope_span = Span(
        file: "in.zen",
        start: Pos(line: 5, col: 9),
        end: Pos(line: 5, col: 10)
    );
    read ::= alloc.String().try();
    be.write_name_slot("f", read_span, closure, read).try();
    scope ::= alloc.String().try();
    be.write_scope_slot("f", scope_span, closure, scope).try();
    param ::= alloc.String().try();
    be.write_param_slot("f", read_span, closure, param).try();
    read_ok ::= alloc.String().try();
    be.write_name_slot("x", read_span, storage, read_ok).try();
    scope_ok ::= alloc.String().try();
    be.write_scope_slot("x", scope_span, storage, scope_ok).try();
    param_ok ::= alloc.String().try();
    be.write_param_slot("x", read_span, storage, param_ok).try();
    faults ::= alloc.String().try();
    be.render_diags(faults).try();
    println(
        "closure: read={} scope={} param={}",
        read.view(),
        scope.view(),
        param.view()
    );
    println(
        "storage: read={} scope={} param={}",
        read_ok.view(),
        scope_ok.view(),
        param_ok.view()
    );
    print("faults:\n{}", faults.view());
    Ok(0)
}
