// A name declared in TWO modules, both imported bare. The two `Box`es
// are independent nominal types that happen to share a name and a
// field list -- structurally identical, so no type check anywhere can
// tell them apart. Only the receiver's identity deals each `.describe`
// to its own module: 300 = label * 100 (box), 4000 = label * 1000
// (crate).
//
// This is the plausible-wrong-answer case: a resolver keyed on the
// NAME alone picks one declaration and answers 300 twice or 4000
// twice -- all numbers, all wrong. Values are built through each
// module's own `make`, so nothing here leans on bare-constructor
// resolution; the ONLY thing being exercised is receiver-side deal-out
// of two same-named free functions across an import.
//
// One-line breaker: key overload resolution on the imported name
// instead of the declared parameter type -> one number printed twice.

Box, describe, make_box = box.box

Box, describe, make_crate = crate.crate

main = (env: Env) Res<i32, IoError> {
    a = make_box(3);
    b = make_crate(4);
    println("{}", a.describe());
    println("{}", b.describe());
    Ok(0);
}
