// the classic: -2147483648 is unary minus applied to 2147483648, which
// does NOT fit in i32 on its own. it must still be accepted as i32.MIN.
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    lo: i32 = -2147483648;
    hi: i32 = 2147483647;
    println("{}", lo);
    println("{}", hi);
    println("{} {}", lo == i32.MIN, hi == i32.MAX);
    Ok(0);
}
