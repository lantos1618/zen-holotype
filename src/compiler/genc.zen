// Shared AST constructors and codegen helpers. AST types live in compiler.ast.ast_types;
// compiler.mangle imports these buffer helpers back, a cycle supported by the flat bootstrap TU.
{ Expr, VarData, BinData, CallData, MethodCallData, CondData, MemberData, MakeEnumData,
  MakeStructData, FieldInit, TagData, ArmData, MatchData, StrData, SliceData, IndexData, LoopData,
  LambdaData, BlockData, Stmt, LetData, AssignData, IfData, WhileData, IndexSetData, Ty, FnTData,
  GenericData, PtrData, Param, Func, Field, StructDecl, GenStructDecl, VariantDef, EnumDecl,
  GenEnumDecl, ImplData, ImportData, GlobalData, TraitDefData, Decl } = compiler.ast.ast_types
{ String } = std.text.string
{ view } = std.text.str
{ step_while, loop_at } = std.core.count
{ Allocator } = std.mem.alloc
{ panic } = std.core.result
{ mangle_str_in } = compiler.mangle
// T appears only in the return type, so callers use an explicit turbofish.
cbuf*<T> = (a: Allocator, n: i64) MutSlice<T> { slice(a.acquire_or_die(n * sizeof(T)), n) }
sbyte* = (v: StringView, i: i64) u8 { load(offset(v, i)) }
// pointer KIND tag (safety-goal-D). All three spellings still lower to `T*`; their semantic/mono
// names remain distinct so a generic wrapper cannot erase a nested capability. Direct pointer
// direction is checked by `fits`/`mode_fits`. 0=RawPtr (nullable FFI floor), 1=Ptr (read-only borrow),
// 2=MutPtr (writable borrow). Mirrors the `() i32` constant style used for the K* diag codes.
k_raw_ptr* = () i32 { 0 }
k_ptr* = () i32 { 1 }
k_mut_ptr* = () i32 { 2 }
// The canonical surface keyword for a pointer kind. Shared by the formatter and diagnostics so a
// rejected `Ptr<T>` -> `MutPtr<T>` conversion never prints two indistinguishable `Ptr<T>` types.
ptr_kw* = (kind: i32) StringView {
    (kind == k_raw_ptr()).match ({
        true  => "RawPtr",
        false => (kind == k_mut_ptr()).then({ "MutPtr" }, { "Ptr" }),
    })
}
// Compiler-owned allocations use these allocator value-method UFCS targets, including in stripped bootstrap drivers.
acquire* = (a: Allocator, n: i64) RawPtr<u8> { a.acquire(n) }
resize = (a: Allocator, p: RawPtr<u8>, n: i64) RawPtr<u8> { a.resize(p, n) }
// The compiler's OWN allocations are INFALLIBLE BY CONTRACT, and these two verbs are where that
// contract is written down. The AST/table/String buffers below are built in expression position from
// ~50 files and have no error channel to thread a `Result` through; a compiler that cannot allocate
// also has nothing useful left to do. So allocation failure STOPS here with a named panic
// (`zen: panic: compiler: out of memory`) instead of handing back a null the caller dereferences —
// the difference between a diagnosable abort and a segfault, exactly as std.concurrent.pool's
// `or_die` does for the scheduler's un-Result-able allocations. `n <= 0` is acquire's legal empty
// allocation (it returns null by design), so it is NOT a failure. Sites that CAN carry the failure as
// a value should use `try_acquire` instead; these are the ones that cannot.
acquire_or_die* = (a: Allocator, n: i64) RawPtr<u8> {
    p = a.acquire(n)
    (p == null_ptr() && n > 0).then({
        panic("compiler: out of memory")
    })
    p
}
resize_or_die* = (a: Allocator, p: RawPtr<u8>, n: i64) RawPtr<u8> {
    q = a.resize(p, n)
    (q == null_ptr() && n > 0).then({
        panic("compiler: out of memory")
    })
    q
}
write_str* = (dst: RawPtr<u8>, at: i64, t: StringView) i64 { dst.write_str_at(at, t, 0) }
write_str_at = (dst: RawPtr<u8>, at: i64, t: StringView, i: i64) i64 {
    at + i.step_while((k) { load(offset(t, k)) != 0 }, (k) {
        dst.offset(at + k).store(load(offset(t, k)))
        k + 1
    })
}    // ITERATIVE: copying a long string is O(n) iteration, not O(n) C-stack recursion
finish_buf* = (dst: RawPtr<u8>, n: i64) StringView {
    dst.offset(n).store(0)
    cstr(dst)
}
// constructors — return a value; the caller calls `.addr()` on an Expr to make a child, and
// builds the body as a slice of statements: `[slet("y", e.addr()), sret(r.addr())]`
lit* = (n: i64) Expr { .Int(n) }
byte_lit* = (n: i32) Expr { .Byte(n) }    // a char literal's byte value (typed u8 by the checker)
flit* = (t: StringView) Expr { .FloatLit(t) }    // a float literal — its lexeme text, emitted verbatim (typed f64)
vref* = (nm: StringView) Expr {
    .Var(VarData(
        name: nm,
        pos: 0,
    ))
}
vref_at* = (nm: StringView, p: i32) Expr {
    .Var(VarData(
        name: nm,
        pos: p,
    ))
}
bin_at* = (op: StringView, l: Ptr<Expr>, r: Ptr<Expr>, p: i32) Expr {
    .Bin(BinData(
        op: op,
        lhs: l,
        rhs: r,
        pos: p,
        rty: tvoid(),
    ))
}
// like bin_at but records a sub-width int RESULT type so genc re-truncates the promoted value.
bin_rty* = (op: StringView, l: Ptr<Expr>, r: Ptr<Expr>, p: i32, rt: Ty) Expr {
    .Bin(BinData(
        op: op,
        lhs: l,
        rhs: r,
        pos: p,
        rty: rt,
    ))
}
bin* = (op: StringView, l: Ptr<Expr>, r: Ptr<Expr>) Expr { bin_at(op, l, r, 0) }
// C promotes every operand narrower than its own arithmetic width, and Zen only narrows at a store —
// so a used operator RESULT leaks the un-truncated value. u8/i8/i16/u16 promote to `int` for any
// operator; i32/u32 promote to `long long` beside the `LL` of an untyped integer literal (gen_int_lit),
// which is why `(a: i32) + 1 < a` silently computed at 64 bits. Only i64/u64 are already at width.
subword_ty* = (t: Ty) bool {
    t.match ({
        .U8       => true,
        .I32      => true,
        .Named(n) => n == "i8" || n == "i16" || n == "u16" || n == "u32",
        _         => false,
    })
}
narrow_op* = (op: StringView) bool {
    op == "+" || op == "-" || op == "*" || op == "<<" || op == "&" || op == "|" || op == "^"
}
// result type to record on a Bin so genc re-truncates a sub-width arithmetic result; Void = no cast.
// `rty` must be the binop's OWN result type (num_result), not the lhs's: truncating `i32 * i64` to
// the lhs width would be a new silent truncation in place of the old silent widening.
arith_rty* = (op: StringView, rty: Ty) Ty {
    (narrow_op(op) && subword_ty(rty)).then({ rty }, { tvoid() })
}
call_origin_full* = (
    fn: StringView,
    args: MutSlice<Expr>,
    targs: MutSlice<Ty>,
    p: i32,
    raw: bool,
    origin: StringView,
) Expr {
    .Call(CallData(
        fn: fn,
        args: args,
        targs: targs,
        pos: p,
        raw: raw,
        origin: origin,
    ))
}
call_full* = (fn: StringView, args: MutSlice<Expr>, targs: MutSlice<Ty>, p: i32, raw: bool) Expr {
    call_origin_full(fn, args, targs, p, raw, "")
}
call* = (fn: StringView, args: MutSlice<Expr>) Expr { call_full(fn, args, no_tys(), 0, false) }
call_at* = (fn: StringView, args: MutSlice<Expr>, p: i32) Expr {
    call_full(fn, args, no_tys(), p, false)
}
raw_call_at* = (fn: StringView, args: MutSlice<Expr>, p: i32) Expr {
    call_full(fn, args, no_tys(), p, true)
}
// explicit turbofish call `fn<T, …>(args)` — type args pinned at the call site.
call_targs_at* = (fn: StringView, args: MutSlice<Expr>, targs: MutSlice<Ty>, p: i32) Expr {
    call_full(fn, args, targs, p, false)
}
emcall* = (recv: Ptr<Expr>, method: StringView, args: MutSlice<Expr>, p: i32) Expr {
    .MethodCall(MethodCallData(
        recv: recv,
        method: method,
        args: args,
        pos: p,
    ))
}
cond* = (c: Ptr<Expr>, t: Ptr<Expr>, e: Ptr<Expr>) Expr { cond_at(c, t, e, 0, 0, 0) }
cond_oa* = (c: Ptr<Expr>, t: Ptr<Expr>, e: Ptr<Expr>, oa: i32) Expr { cond_at(c, t, e, oa, 0, 0) }
cond_at* = (c: Ptr<Expr>, t: Ptr<Expr>, e: Ptr<Expr>, oa: i32, tpos: i32, epos: i32) Expr {
    .Cond(CondData(
        c: c,
        t: t,
        e: e,
        oa: oa,
        tpos: tpos,
        epos: epos,
    ))
}
// the one field-access constructor; `ptr` picks `->` over `.` at emit (see MemberData). A pass that
// REBUILDS a Member must carry `m.ptr` through — dropping it silently re-emits a deref as a value read.
mfield* = (o: Ptr<Expr>, f: StringView, p: i32, ptr: bool) Expr {
    .Member(MemberData(
        obj: o,
        field: f,
        pos: p,
        ptr: ptr,
    ))
}
member* = (o: Ptr<Expr>, f: StringView) Expr { mfield(o, f, 0, false) }
member_at* = (o: Ptr<Expr>, f: StringView, p: i32) Expr { mfield(o, f, p, false) }
arrow* = (o: Ptr<Expr>, f: StringView) Expr { mfield(o, f, 0, true) }
mkenum_full = (
    ty: StringView,
    mty: StringView,
    targs: MutSlice<Ty>,
    v: StringView,
    p: Ptr<Expr>,
    tp: i32,
    vp: i32,
) Expr {
    .MakeEnum(MakeEnumData(
        ty: ty,
        mty: mty,
        variant: v,
        targs: targs,
        payload: p,
        ty_pos: tp,
        variant_pos: vp,
    ))
}
mkenum* = (ty: StringView, v: StringView, p: Ptr<Expr>) Expr {
    mkenum_full(ty, ty, no_tys(), v, p, 0, 0)
}
mkenum_at* = (ty: StringView, v: StringView, p: Ptr<Expr>, tp: i32, vp: i32) Expr {
    mkenum_full(ty, ty, no_tys(), v, p, tp, vp)
}
mkenumg* = (
    ty: StringView,
    mty: StringView,
    targs: MutSlice<Ty>,
    v: StringView,
    p: Ptr<Expr>,
) Expr { mkenum_full(ty, mty, targs, v, p, 0, 0) }
mkenumg_at* = (
    ty: StringView,
    mty: StringView,
    targs: MutSlice<Ty>,
    v: StringView,
    p: Ptr<Expr>,
    tp: i32,
    vp: i32,
) Expr { mkenum_full(ty, mty, targs, v, p, tp, vp) }
finit* = (nm: StringView, v: Ptr<Expr>) FieldInit { finit_at(nm, v, 0) }
finit_at* = (nm: StringView, v: Ptr<Expr>, p: i32) FieldInit {
    FieldInit(
        name: nm,
        value: v,
        pos: p,
    )
}
mkstruct* = (ty: StringView, inits: MutSlice<FieldInit>) Expr {
    .MakeStruct(MakeStructData(
        ty: ty,
        mty: ty,
        targs: no_tys(),
        inits: inits,
        pos: 0,
    ))
}
mkstruct_at* = (ty: StringView, inits: MutSlice<FieldInit>, p: i32) Expr {
    .MakeStruct(MakeStructData(
        ty: ty,
        mty: ty,
        targs: no_tys(),
        inits: inits,
        pos: p,
    ))
}
mkstructg_at* = (
    ty: StringView,
    mty: StringView,
    targs: MutSlice<Ty>,
    inits: MutSlice<FieldInit>,
    p: i32,
) Expr {
    .MakeStruct(MakeStructData(
        ty: ty,
        mty: mty,
        targs: targs,
        inits: inits,
        pos: p,
    ))
}
no_tys* = () MutSlice<Ty> { slice(null_ptr(), 0) }    // an empty [Ty] (non-generic literal's targs)
slit* = (elem: Ty, items: MutSlice<Expr>) Expr {
    .SliceLit(SliceData(
        elem: elem,
        items: items,
    ))
}
eindex* = (seq: Ptr<Expr>, i: Ptr<Expr>, elem: Ty) Expr {
    .Index(IndexData(
        seq: seq,
        idx: i,
        elem: elem,
    ))
}
eloop* = (
    seq: Ptr<Expr>,
    idx: StringView,
    elem: StringView,
    elemTy: Ty,
    body: MutSlice<Stmt>,
    h: StringView,
) Expr { eloop_at(seq, idx, elem, elemTy, body, h, 0, 0, 0) }
eloop_at* = (
    seq: Ptr<Expr>,
    idx: StringView,
    elem: StringView,
    elemTy: Ty,
    body: MutSlice<Stmt>,
    h: StringView,
    hp: i32,
    ip: i32,
    ep: i32,
) Expr {
    .Loop(LoopData(
        seq: seq,
        idx: idx,
        elem: elem,
        elemTy: elemTy,
        body: body,
        h: h,
        h_pos: hp,
        idx_pos: ip,
        elem_pos: ep,
    ))
}
lam_r* = (params: MutSlice<Param>, body: MutSlice<Stmt>, ret: Ty) Expr {
    .Lambda(LambdaData(
        params: params,
        body: body,
        ret: ret,
    ))
}
block* = (stmts: MutSlice<Stmt>) Expr { .Block(BlockData(stmts: stmts)) }
// A braced value-position body (match/cond arm) whose LAST statement is an explicit `return`
// DIVERGES: it yields no value (control leaves the enclosing function), so it contributes nothing
// to the surrounding match/cond value type and must emit as real statements, never be flattened to
// an expression. Only arm/loop blocks (parse_block) can look like this: fn/lambda BODIES also end
// in .Return (the parser's implicit trailing return), but those never reach value positions intact —
// the inliner's blockify strips the trailing return (ret_to_expr / cps_value) before splicing.
stmts_diverge* = (stmts: MutSlice<Stmt>) bool {
    (stmts.len > 0).match ({
        true  => stmts[stmts.len - 1].match ({
            .Return(r) => true,
            _          => false,
        }),
        false => false,
    })
}
blk_diverges* = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Block(b) => b.stmts.stmts_diverge(),
        _         => false,
    })
}
// is_fnt (Ty), is_generic_fn (Func), is_template/is_trait (Decl), struct_is_trait (StructDecl) and
// has_fnt_param ([Param]) moved to compiler.astops (grouped with the Ty::is_fnt trait impl they use),
// so this base module carries no reference to a method defined outside its own import closure.
no_fnt_labels = () MutSlice<StringView> { slice(null_ptr(), 0) }
fntype_labeled* = (params: MutSlice<Ty>, labels: MutSlice<StringView>, ret: Ptr<Ty>) Ty {
    .FnT(FnTData(
        params: params,
        labels: labels,
        ret: ret,
    ))
}
fntype* = (params: MutSlice<Ty>, ret: Ptr<Ty>) Ty { fntype_labeled(params, no_fnt_labels(), ret) }
fntype_params* = (a: Allocator, params: MutSlice<Param>, ret: Ptr<Ty>) Ty {
    tys ::= cbuf<Ty>(a, params.len)
    labels ::= cbuf<StringView>(a, params.len)
    params.loop_at((i, p) {
        tys[i] = p.ty
        labels[i] = p.name
    })
    fntype_labeled(tys, labels, ret)
}
mktag_full = (
    ty: StringView,
    mty: StringView,
    targs: MutSlice<Ty>,
    v: StringView,
    tp: i32,
    vp: i32,
) Expr {
    .Tag(TagData(
        ty: ty,
        mty: mty,
        variant: v,
        targs: targs,
        ty_pos: tp,
        variant_pos: vp,
    ))
}
mktag* = (ty: StringView, v: StringView) Expr { mktag_full(ty, ty, no_tys(), v, 0, 0) }
mktag_at* = (ty: StringView, v: StringView, tp: i32, vp: i32) Expr {
    mktag_full(ty, ty, no_tys(), v, tp, vp)
}
mktagg* = (ty: StringView, mty: StringView, targs: MutSlice<Ty>, v: StringView) Expr {
    mktag_full(ty, mty, targs, v, 0, 0)
}
mktagg_at* = (
    ty: StringView,
    mty: StringView,
    targs: MutSlice<Ty>,
    v: StringView,
    tp: i32,
    vp: i32,
) Expr { mktag_full(ty, mty, targs, v, tp, vp) }
arm* = (v: StringView, bind: StringView, body: Ptr<Expr>) ArmData {
    arm_spans(v, bind, body, 0, 0, 0)
}
arm_at* = (v: StringView, bind: StringView, body: Ptr<Expr>, p: i32) ArmData {
    arm_spans(v, bind, body, p, 0, 0)
}
arm_spans* = (v: StringView, bind: StringView, body: Ptr<Expr>, p: i32, vp: i32, bp: i32) ArmData {
    ArmData(
        variant: v,
        bind: bind,
        body: body,
        pos: p,
        variant_pos: vp,
        bind_pos: bp,
    )
}    // source-backed (formatter anchors arm comments)
ematch* = (subj: Ptr<Expr>, ename: StringView, arms: MutSlice<ArmData>) Expr {
    .Match(MatchData(
        subj: subj,
        ename: ename,
        arms: arms,
        ptr: false,
    ))
}
ematchp* = (subj: Ptr<Expr>, ename: StringView, arms: MutSlice<ArmData>) Expr {
    .Match(MatchData(
        subj: subj,
        ename: ename,
        arms: arms,
        ptr: true,
    ))
}
strlit_at* = (v: StringView, p: i32) Expr {
    .StrLit(StrData(
        value: v,
        pos: p,
    ))
}    // a source-backed string literal
tstring_view* = () Ty { .StringView }
tstring_cstr* = () Ty { .StringCstr }
tstring_literal* = () Ty { .StringLiteral }
tstr* = () Ty { .StringView }    // deprecated alias → StringView
// The ONE Let constructor: `m` records the source's `::` mutability mark. Every synthesized let
// (temps, or_return payloads, inliner binds) goes through the `m`-less wrappers below and is MUTABLE
// — a compiler-generated name has no source spelling to enforce, and the const rule is a rule about
// what the USER wrote.
slett_atm* = (nm: StringView, t: Ty, v: Ptr<Expr>, p: i32, m: bool) Stmt {
    .Let(LetData(
        name: nm,
        ty: t,
        value: v,
        pos: p,
        mut: m,
    ))
}
slet* = (nm: StringView, v: Ptr<Expr>) Stmt { slett_atm(nm, tvoid(), v, 0, true) }
slett* = (nm: StringView, t: Ty, v: Ptr<Expr>) Stmt { slett_atm(nm, t, v, 0, true) }    // a TYPED let
slet_at* = (nm: StringView, v: Ptr<Expr>, p: i32) Stmt { slett_atm(nm, tvoid(), v, p, true) }    // source-backed let (formatter needs the name position)
slett_at* = (nm: StringView, t: Ty, v: Ptr<Expr>, p: i32) Stmt { slett_atm(nm, t, v, p, true) }
sret* = (v: Ptr<Expr>) Stmt { .Return(v) }
sexpr* = (v: Ptr<Expr>) Stmt { .ExprStmt(v) }    // a bare expression evaluated for effect
sassign* = (tgt: Ptr<Expr>, v: Ptr<Expr>) Stmt {
    .Assign(AssignData(
        target: tgt,
        value: v,
        pos: 0,
    ))
}
sassign_at* = (tgt: Ptr<Expr>, v: Ptr<Expr>, p: i32) Stmt {
    .Assign(AssignData(
        target: tgt,
        value: v,
        pos: p,
    ))
}
sidxset_at* = (seq: Ptr<Expr>, i: Ptr<Expr>, elem: Ty, v: Ptr<Expr>, p: i32) Stmt {
    .IndexSet(IndexSetData(
        seq: seq,
        idx: i,
        elem: elem,
        value: v,
        pos: p,
    ))
}
sif* = (c: Ptr<Expr>, t: MutSlice<Stmt>, e: MutSlice<Stmt>) Stmt {
    .If(IfData(
        c: c,
        then: t,
        els: e,
    ))
}
swhile* = (c: Ptr<Expr>, b: MutSlice<Stmt>) Stmt {
    .While(WhileData(
        c: c,
        body: b,
    ))
}
ti32* = () Ty { .I32 }
ti64* = () Ty { .I64 }
tu8* = () Ty { .U8 }
tf64* = () Ty { .F64 }
tbool* = () Ty { .Bool }
tnamed* = (n: StringView) Ty { .Named(n) }
tgeneric* = (nm: StringView, args: MutSlice<Ty>, mangled: StringView) Ty {
    .Generic(GenericData(
        name: nm,
        args: args,
        mangled: mangled,
    ))
}
tptr* = (t: Ptr<Ty>) Ty {
    .Ptr(PtrData(
        pointee: t,
        kind: k_mut_ptr(),
    ))
}
tptr_k* = (t: Ptr<Ty>, k: i32) Ty {
    .Ptr(PtrData(
        pointee: t,
        kind: k,
    ))
}
// `[T]` sugar: a slice of the DEFAULT kind. `k_slice_dflt` is the one place the default lives, so
// flipping `[T]` between writable and read-only is a one-line change (see docs/string-vec-model.md).
tslice* = (e: Ptr<Ty>) Ty { tslice_k(e, k_slice_dflt()) }
tslice_k* = (e: Ptr<Ty>, k: i32) Ty {
    .Slice(PtrData(
        pointee: e,
        kind: k,
    ))
}
// slice mutability, spelled with the SAME kind tags as pointers: `Slice<T>` is the read-only window
// (k_ptr) and `MutSlice<T>` is the writable one (k_mut_ptr). Brackets are value syntax only.
// A read-only slice is what `.view()` of a `StringLiteral`/`StringCstr` yields, so writing into
// `.rodata` is a checker error instead of a segfault.
k_slice_dflt* = () i32 { k_mut_ptr() }
slice_kw* = (kind: i32) StringView { (kind == k_ptr()).then({ "Slice" }, { "MutSlice" }) }
param* = (nm: StringView, t: Ty) Param { param_at(nm, t, 0) }
param_at* = (nm: StringView, t: Ty, p: i32) Param {
    Param(
        name: nm,
        ty: t,
        variadic: false,
        pos: p,
    )
}
pvariadic* = (nm: StringView, t: Ty) Param { pvariadic_at(nm, t, 0) }
pvariadic_at* = (nm: StringView, t: Ty, p: i32) Param {
    Param(
        name: nm,
        ty: t,
        variadic: true,
        pos: p,
    )
}    // a `...T` param: ty = the collected `[T]`
field* = (nm: StringView, t: Ty) Field { field_at(nm, t, 0) }
field_at* = (nm: StringView, t: Ty, p: i32) Field {
    Field(
        name: nm,
        ty: t,
        dflt: null_ptr(),
        pos: p,
    )
}
field_default* = (nm: StringView, t: Ty, e: Ptr<Expr>) Field { field_default_at(nm, t, e, 0) }
field_default_at* = (nm: StringView, t: Ty, e: Ptr<Expr>, p: i32) Field {
    Field(
        name: nm,
        ty: t,
        dflt: e,
        pos: p,
    )
}
sdef* = (nm: StringView, fs: MutSlice<Field>) StructDecl {
    StructDecl(
        name: nm,
        fields: fs,
        pos: 0,
    )
}
sdef_at* = (nm: StringView, fs: MutSlice<Field>, p: i32) StructDecl {
    StructDecl(
        name: nm,
        fields: fs,
        pos: p,
    )
}    // source-backed (formatter anchors a leading comment above the struct)
gsdef_at* = (nm: StringView, tps: MutSlice<Param>, fs: MutSlice<Field>, p: i32) GenStructDecl {
    GenStructDecl(
        name: nm,
        tparams: tps,
        fields: fs,
        pos: p,
    )
}
genumdef_at* = (
    nm: StringView,
    tps: MutSlice<Param>,
    vs: MutSlice<VariantDef>,
    p: i32,
) GenEnumDecl {
    GenEnumDecl(
        name: nm,
        tparams: tps,
        variants: vs,
        pos: p,
    )
}
tvoid* = () Ty { .Void }
vdef* = (nm: StringView, p: Ty) VariantDef { vdef_at(nm, p, 0) }
vdef_at* = (nm: StringView, p: Ty, pos: i32) VariantDef {
    VariantDef(
        name: nm,
        payload: p,
        dflt: null_ptr(),
        pos: pos,
    )
}
vdef_default* = (nm: StringView, p: Ty, e: Ptr<Expr>) VariantDef { vdef_default_at(nm, p, e, 0) }
vdef_default_at* = (nm: StringView, p: Ty, e: Ptr<Expr>, pos: i32) VariantDef {
    VariantDef(
        name: nm,
        payload: p,
        dflt: e,
        pos: pos,
    )
}
expr_null* = () Ptr<Expr> { vdef("", tvoid()).dflt }    // a null Ptr<Expr> carrying the right static type
is_expr_null* = (e: Ptr<Expr>) bool { e == null_ptr() }
edef_at* = (nm: StringView, vs: MutSlice<VariantDef>, p: i32) EnumDecl {
    EnumDecl(
        name: nm,
        variants: vs,
        pos: p,
    )
}    // source-backed (formatter leading-comment anchor)
dfunc* = (f: Func) Decl { .DFunc(f) }
dstruct* = (sd: StructDecl) Decl { .DStruct(sd) }
denum* = (ed: EnumDecl) Decl { .DEnum(ed) }
dforeign* = (f: Func) Decl { .DForeign(f) }
dimport_at* = (names: MutSlice<Param>, module: StringView, p: i32) Decl {
    .DImport(ImportData(
        names: names,
        module: module,
        pos: p,
    ))
}    // source-backed import (formatter anchors a file-header comment above it)
dgenstruct* = (gsd: GenStructDecl) Decl { .DGenStruct(gsd) }
dgenenum* = (ged: GenEnumDecl) Decl { .DGenEnum(ged) }
dimpl* = (ty: StringView, trname: StringView, methods: MutSlice<Param>) Decl {
    .DImpl(ImplData(
        ty: ty,
        trname: trname,
        trty: tnamed(trname),
        methods: methods,
        pos: 0,
        trait_pos: 0,
    ))
}
dimpl_at* = (
    ty: StringView,
    trname: StringView,
    trty: Ty,
    methods: MutSlice<Param>,
    pos: i32,
) Decl { dimpl_spans(ty, trname, trty, methods, pos, 0) }
dimpl_spans* = (
    ty: StringView,
    trname: StringView,
    trty: Ty,
    methods: MutSlice<Param>,
    pos: i32,
    trait_pos: i32,
) Decl {
    .DImpl(ImplData(
        ty: ty,
        trname: trname,
        trty: trty,
        methods: methods,
        pos: pos,
        trait_pos: trait_pos,
    ))
}
// The ONE global constructor: `m` records the `::` mutability mark, mirroring slett_atm for locals.
// A module ALIAS (`m = std.mod`) and a synthesized global are constants — neither has a source
// spelling that could mark them mutable.
dglobal_full* = (
    name: StringView,
    ty: Ty,
    init: Ptr<Expr>,
    p: i32,
    tl: bool,
    alias: bool,
    m: bool,
) Decl {
    .DGlobal(GlobalData(
        name: name,
        ty: ty,
        init: init,
        tl: tl,
        alias: alias,
        pos: p,
        mut: m,
    ))
}
dglobal* = (name: StringView, ty: Ty, init: Ptr<Expr>) Decl {
    dglobal_full(name, ty, init, 0, false, false, true)
}
dglobal_tl* = (name: StringView, ty: Ty, init: Ptr<Expr>) Decl {
    dglobal_full(name, ty, init, 0, true, false, true)
}
dglobal_at* = (name: StringView, ty: Ty, init: Ptr<Expr>, p: i32) Decl {
    dglobal_full(name, ty, init, p, false, false, true)
}
dglobal_tl_at* = (name: StringView, ty: Ty, init: Ptr<Expr>, p: i32) Decl {
    dglobal_full(name, ty, init, p, true, false, true)
}
dglobal_alias_at* = (name: StringView, ty: Ty, init: Ptr<Expr>, p: i32) Decl {
    dglobal_full(name, ty, init, p, false, true, false)
}    // source-backed module-alias
dtraitdef* = (trname: StringView, fn: Func) Decl {
    .DTraitDefault(TraitDefData(
        trname: trname,
        fn: fn,
    ))
}
// `t` boxed into a fresh 1-element heap cell — THE way a Ty child (Ptr pointee, Slice elem,
// FnT ret) is attached to its parent, since the AST recurses through Ptr<Ty>.
tnode* = (a: Allocator, t: Ty) Ptr<Ty> {
    buf ::= cbuf<Ty>(a, 1)
    buf[0] = t
    buf[0].addr()
}
// the FnT SIGNATURE of a function (its param types + ret) — used to give a default-bodied trait method
// a Field type so conformance sees a normal method signature. Allocates a [Ty] of the param types.
fnt_param_tys_in = (a: Allocator, ps: MutSlice<Param>) MutSlice<Ty> {
    buf ::= cbuf<Ty>(a, ps.len)
    ps.loop_at((i, p) { buf[i] = p.ty })
    buf
}
fnt_from_func_in* = (a: Allocator, f: Func) Ty { a.fntype_params(f.params, a.tnode(f.ret)) }
// map a narrow int/float type name to its C type; any other name passes through unchanged.
// the checker accepts i8/i16/u16/u32/u64/f32 but they reach genc as Named(name), so without
// this they'd leak the Zen name (`u32`, `f32`, …) straight to cc as an unknown C type.
width_cname = (n: StringView) StringView {
    (n == "i8").then({
        return "int8_t"
    })
    (n == "i16").then({
        return "int16_t"
    })
    (n == "u16").then({
        return "uint16_t"
    })
    (n == "u32").then({
        return "uint32_t"
    })
    (n == "u64").then({
        return "uint64_t"
    })
    (n == "f32").then({
        return "float"
    })
    n
}
// THE C spelling of a type's HEAD — the single source of truth for the two passes below. They must
// agree byte for byte, because cname_len sizes the buffer that cname_write then fills: the lengths
// used to be spelled here as literals (7, 6, 4, 11, …), so re-spelling a type in the write ladder
// and forgetting its count in the length ladder under-sized the buffer and wrote past it.
cname_head = (t: Ty) StringView {
    t.match ({
        .I32           => "int32_t",
        .I64           => "int64_t",
        .U8            => "uint8_t",
        .F64           => "double",
        .Bool          => "bool",
        .Void          => "void",
        .StringView    => "const char*",
        .StringCstr    => "const char*",
        .StringLiteral => "const char*",
        .Named(n)      => width_cname(n),
        .Generic(g)    => g.mangled,
        .Ptr(pd)       => "",    // recursive: a pointer's spelling is its pointee's plus `*` — see below
        .Slice(e)      => "zslice",
        .FnT(ft)       => "zfn",
    })
}
cname_len = (t: Ty) i64 {
    t.match ({
        .Ptr(pd) => load(pd.pointee).cname_len() + 1,
        _        => t.cname_head().view().len,
    })
}
cname_write = (dst: RawPtr<u8>, at: i64, t: Ty) i64 {
    t.match ({
        .Ptr(pd) => dst.write_str(dst.cname_write(at, load(pd.pointee)), "*"),
        _        => dst.write_str(at, t.cname_head()),
    })
}
// the C type name of a Ty as a plain string — used to substitute `sizeof(T)` in a generic body
// (the tparam Var `T` becomes the concrete type's C name, so `sizeof(T)` → `sizeof(Expr)`).
ty_cname_in* = (a: Allocator, t: Ty) StringView {
    n = t.cname_len()
    buf: RawPtr<u8> = a.acquire_or_die(n + 1)
    buf.finish_buf(buf.cname_write(0, t))
}
// ── type substitution (tparam→arg): shared by compiler.check (subst_ty_in/find_genenum) and the
//    monomorphize pass (compiler.mono). A tiny stack of [Ty] buffer helpers + the recursive
//    substitution + the generic-enum lookup; they're TYPE helpers, so they live in the base. ──
// substitute tparam→arg in a type (recursing Ptr/Slice); a Named that IS a tparam becomes its arg.
tparam_arg = (tparams: MutSlice<Param>, args: MutSlice<Ty>, n: StringView, dflt: Ty) Ty {
    found ::= dflt
    tparams.loop_at((i, tp) {
        // Guard `i < args.len`: a WRONG-ARITY explicit targ list (too few `<…>` args for the declared
        // tparams) would otherwise index past `args` and panic. Leave an un-pinned tparam lenient here;
        // the targ-arity diagnostic (kv_makestruct_targ_kind) owns the real error report.
        found = (tp.name == n && i < args.len).then({ args[i] }, { found })
    })
    found
}
subst_ty_in* = (a: Allocator, tparams: MutSlice<Param>, args: MutSlice<Ty>, t: Ty) Ty {
    t.match ({
        .Named(n)   => tparams.tparam_arg(args, n, t),
        .Ptr(pd)    => tptr_k(a.tnode(a.subst_ty_in(tparams, args, load(pd.pointee))), pd.kind),
        .Slice(e)   => tslice_k(a.tnode(a.subst_ty_in(tparams, args, load(e.pointee))), e.kind),
        .Generic(g) => a.subst_generic_in(tparams, args, g),    // a nested generic field: substitute its args, re-mangle
        .FnT(ft)    => a.subst_fnt_in(tparams, args, ft),    // a function-VALUE field `(state: S, value: i32) S`: substitute inside the signature
        _           => t,
    })
}
// substitute tparam→arg inside a function type `(state: S, value: i32) S` -> `(state: AppState, value: i32) AppState`.
subst_fnt_in = (a: Allocator, tparams: MutSlice<Param>, args: MutSlice<Ty>, ft: FnTData) Ty {
    ptys ::= cbuf<Ty>(a, ft.params.len)
    ft.params.loop_at((i, p) { ptys[i] = a.subst_ty_in(tparams, args, p) })
    fntype_labeled(ptys, ft.labels, a.tnode(a.subst_ty_in(tparams, args, load(ft.ret))))
}
// substitute tparam→arg inside a nested generic instance `Inner<T>` -> `Inner<i32>` (new mangled name).
subst_generic_in = (a: Allocator, tparams: MutSlice<Param>, args: MutSlice<Ty>, g: GenericData) Ty {
    // `tys` (not `buf`): mangle_str_in inlines a local `buf: RawPtr<u8>`, and the inliner
    // substitutes args by name — a caller arg also named `buf` would be captured by that local.
    tys ::= cbuf<Ty>(a, g.args.len)
    g.args.loop_at((i, gt) { tys[i] = a.subst_ty_in(tparams, args, gt) })
    tgeneric(g.name, tys, a.mangle_str_in(g.name, tys))
}
find_genenum* = (decls: MutSlice<Decl>, name: StringView) GenEnumDecl {
    found ::= GenEnumDecl(
        name: "",
        tparams: slice(null_ptr(), 0),
        variants: slice(null_ptr(), 0),
    )
    decls.loop_at((i, d) {
        found = d.match ({
            .DGenEnum(g) => (g.name == name).then({ g }, { found }),
            _            => found,
        })
    })
    found
}
