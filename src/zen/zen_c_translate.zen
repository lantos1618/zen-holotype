// Optional Clang-backed translation of one C header into a raw Zen module.
// Clang is needed only to regenerate it; every compilation still reattaches
// the cached source to its header metadata through `attach` below.

Alloc, AllocError = std.mem
str, String = std.text
Vec = std.collections
Json, JsonId, Jsons, Run, read = std.json
ProcError = std.proc
CImport = std.build
Ast, Module = std.ast
Source, Lexed, scan, is_zen_name = std.lex
Parser = std.parse
CImportRequest, CImportModule = zen.zen_c_import

ClangExit* = {
    code*: i32,
    message*: str,
}

CTranslateFault* = NoMemory
    | Process(ProcError)
    | ClangFailed(ClangExit)
    | OneHeaderRequired
    | UnsupportedTarget
    | UnsafeArgument(str)
    | InvalidAst(str)
    | UnsupportedFunction(str)
    | UnsupportedType(str)
    | IdentityMismatch
    | GeneratedLex(usize)
    | GeneratedParse(usize)

CModule* = {
    source*: String,
    declarations*: usize,
}

CTranslation* = {
    module*: CModule,
    identity*: String,
}

// The returned source owns every `str` the synthetic AST sliced from it.
CAttachedTranslation* = {
    source*: String,
    attached*: CImportModule,
    identity*: String,
    declarations*: usize,
}

// Parse already-translated Zen into the program's one AST, then give that
// module the request's C headers.
attach* = (
    a           : Alloc,
    name        : str,
    request     : CImportRequest,
    translation : CTranslation,
    tree        :: Ast,
) Res<CAttachedTranslation, CTranslateFault> {
    translation.identity.view().eq(request.identity.view()).match({
        false => Err(CTranslateFault.IdentityMismatch),
        true  => {
            source       = translation.module.source;
            declarations = translation.module.declarations;
            identity     = translation.identity;
            lexed        = scan(a, Source(file: name, text: source.view()))
                .try(CTranslateFault.NoMemory);
            lexed.is_clean().match({
                false => Err(CTranslateFault.GeneratedLex(lexed.diags.len)),
                true  => {
                    p ::= a.Parser(lexed, tree);
                    raw = p.module(name)
                        .try(CTranslateFault.NoMemory);
                    // Hand every grown Vec header back on both success and
                    // parser refusal; Ast has exactly one owner.
                    tree = p.tree;
                    (p.diags.len == 0).match({
                        false => Err(CTranslateFault.GeneratedParse(
                            p.diags.len
                        )),
                        true  => request.attach_module(a, raw, tree)
                            .replace_err(CTranslateFault.NoMemory).match({
                            Err(e)     => Err(e),
                            Ok(linked) => Ok(CAttachedTranslation(
                                source: source,
                                attached: linked,
                                identity: identity,
                                declarations: declarations
                            )),
                        }),
                    })
                },
            })
        },
    })
}

// Run the optional translator. `cwd` is explicit because header paths belong
// to the project graph, not the compiler process's ambient directory.
translate* = (
    env     : Env,
    a       : Alloc,
    cwd     : str,
    request : CImportRequest
) Res<CTranslation, CTranslateFault> {
    command = request.spec.clang_command(a, "clang").try();
    env.proc.run(a, cwd, command.view()).match({
        Err(e)     => Err(CTranslateFault.Process(e)),
        Ok(result) => (result.code == 0).match({
            false => Err(CTranslateFault.ClangFailed(ClangExit(
                code: result.code,
                message: result.err.view()
            ))),
            true  => translate_ast(a, result.out.view()).match({
                Err(e)     => Err(e),
                Ok(module) => Ok(CTranslation(
                    module: module,
                    identity: request.identity
                )),
            }),
        }),
    })
}

// Translate Clang's `-ast-dump=json` output into a Zen C module.
translate_ast* = (a: Alloc, text: str) Res<CModule, CTranslateFault> {
    tree ::= a.Jsons();
    root  = read(a, tree, text)
        .replace_err(CTranslateFault.InvalidAst("clang JSON")).try();
    inner = tree.field_of(root, "inner").try();
    run   = tree.array(inner, "translation unit inner").try();
    out   ::= a.String(
        "// Generated by `zen bind c`; edit the C header, not this file.\n\nPtr = std.mem\n\n"
    ).try(CTranslateFault.NoMemory);
    count ::= 0;
    Range(0, run.len).loop((h, i) {
        node = tree.item_of(inner, i).try();
        kind = tree.text_field(node, "kind").try();
        kind.eq("FunctionDecl").then(() {
            // `includedFrom` marks a declaration reached through another
            // header; bind the requested header, not its transitive includes.
            tree.direct(node).then(() {
                tree.emit_function(node, out).try();
                count = count + 1;
            });
        });
    });
    Ok(CModule(source: out, declarations: count))
}

clang_command = (spec: CImport, a: Alloc, clang: str)
                Res<String, CTranslateFault> {
    (spec.headers.len == 1).match({
        false => Err(CTranslateFault.OneHeaderRequired),
        true  => {
            out ::= a.String().try(CTranslateFault.NoMemory);
            out.shell_word(clang).try();
            out.add(" -Xclang -ast-dump=json -fsyntax-only -x c --target=")
                .try(CTranslateFault.NoMemory);
            out.add(
                spec.target.clang_triple().ok_or(
                    CTranslateFault.UnsupportedTarget
                ).try()
            ).try(CTranslateFault.NoMemory);
            spec.include_paths.loop((h, path) {
                out.add(" -I").try(CTranslateFault.NoMemory);
                out.shell_word(path).try();
            });
            spec.defines.loop((h, define) {
                out.add(" -D").try(CTranslateFault.NoMemory);
                out.shell_word(define).try();
            });
            out.add(" -- ").try(CTranslateFault.NoMemory);
            out.shell_word(spec.headers.get(0).match({
                Ok(header) => header,
                None       => "",
            })).try();
            Ok(out)
        },
    })
}

shell_word = (out :: String, word: str) Res<(), CTranslateFault> {
    safe ::= true;
    Range(0, word.len).loop((h, i) {
        (word.index(i) == 0 || word.index(i) == '\n' || word.index(i) == '\r')
            .then(() { safe = false; h.break(); });
    });
    safe.match({
        false => Err(CTranslateFault.UnsafeArgument(word)),
        true  => {
            out.add('\'').try(CTranslateFault.NoMemory);
            Range(0, word.len).loop((h, i) {
                b = word.index(i);
                (b == '\'').match({
                    true  => out.add("'\\''").try(CTranslateFault.NoMemory),
                    false => out.add(b).try(CTranslateFault.NoMemory),
                });
            });
            out.add('\'').replace_err(CTranslateFault.NoMemory)
        },
    })
}

emit_function = (tree: Jsons, node: JsonId, out :: String)
                Res<(), CTranslateFault> {
    name = tree.text_field(node, "name").try();
    name.is_zen_name().match({
        false => Err(CTranslateFault.UnsupportedFunction(name)),
        true  => tree.forbidden_function(node, name).match({
            Ok(_)  => {
                signature = tree.text_field_in(node, "type", "qualType").try();
                open      = signature.find('(').match({
                    Ok(i) => i,
                    None  => 0,
                });
                (open == 0).match({
                    true  => Err(CTranslateFault.UnsupportedType(signature)),
                    false => {
                        ret_c = signature.slice(0, open).trim_end().match({
                            Ok(s) => s,
                            None  => "",
                        });
                        ret   = ret_c.zen_type(true).try();
                        out.fmt("{}* = (", name).try(CTranslateFault.NoMemory);
                        tree.emit_params(node, out).try();
                        out.fmt(") {}\n", ret).replace_err(CTranslateFault.NoMemory)
                    },
                })
            },
            Err(e) => Err(e),
        }),
    })
}

forbidden_function = (tree: Jsons, node: JsonId, name: str)
                     Res<(), CTranslateFault> {
    tree.field(node, "variadic").match({
        Ok(id) => tree.at(id).match({
            Json.Bool(true) => Err(CTranslateFault.UnsupportedFunction(name)),
            _               => tree.no_body(node, name),
        }),
        None   => tree.no_body(node, name),
    })
}

no_body = (tree: Jsons, node: JsonId, name: str)
          Res<(), CTranslateFault> {
    tree.field(node, "inner").match({
        None     => Ok(()),
        Ok(kids) => tree.array(kids, "function inner").match({
            Err(e)  => Err(e),
            Ok(run) => {
                body ::= false;
                Range(0, run.len).loop((h, i) {
                    child = tree.item_of(kids, i).try();
                    tree.text_field(child, "kind").try().eq("CompoundStmt")
                        .then(() { body = true; h.break(); });
                });
                body.match({
                    true  => Err(CTranslateFault.UnsupportedFunction(name)),
                    false => Ok(()),
                })
            },
        }),
    })
}

emit_params = (tree: Jsons, node: JsonId, out :: String)
              Res<(), CTranslateFault> {
    tree.field(node, "inner").match({
        None     => Ok(()),
        Ok(kids) => tree.array(kids, "function inner").match({
            Err(e)  => Err(e),
            Ok(run) => {
                said ::= false;
                arg  ::= 0;
                bad  ::= "";
                Range(0, run.len).loop((h, i) {
                    child = tree.item_of(kids, i).try();
                    kind  = tree.text_field(child, "kind").try();
                    kind.eq("ParmVarDecl").then(() {
                        said.then(() {
                            out.add(", ").try(CTranslateFault.NoMemory);
                        });
                        name = tree.optional_text(child, "name").match({
                            Ok(s) => s,
                            None  => "",
                        });
                        name.is_empty().match({
                            true  => out.fmt(
                                "arg{}",
                                arg
                            ).try(CTranslateFault.NoMemory),
                            false => name.is_zen_name().match({
                                true  => out.add(
                                    name
                                ).try(CTranslateFault.NoMemory),
                                false => { bad = name; h.break(); },
                            }),
                        });
                        bad.is_empty().then(() {
                            c = tree.type_name(child).try();
                            out.fmt(
                                ": {}",
                                c.zen_type(false).try()
                            ).try(CTranslateFault.NoMemory);
                            said = true;
                            arg  = arg + 1;
                        });
                    });
                });
                bad.is_empty().match({
                    true  => Ok(()),
                    false => Err(CTranslateFault.UnsupportedFunction(bad)),
                })
            },
        }),
    })
}

type_name = (tree: Jsons, node: JsonId) Res<str, CTranslateFault> {
    owner = tree.field_of(node, "type").try();
    tree.field(owner, "desugaredQualType").match({
        Ok(id) => tree.text_value(id, "desugaredQualType"),
        None   => tree.text_field(owner, "qualType"),
    })
}

zen_type = (c: str, allow_void: bool) Res<str, CTranslateFault> {
    c.match({
        "void"               => allow_void.match({
            true  => Ok("()"),
            false => Err(CTranslateFault.UnsupportedType(c)),
        }),
        "char"               => Ok("c_char"),
        "signed char"        => Ok("c_schar"),
        "unsigned char"      => Ok("c_uchar"),
        "short"              => Ok("c_short"),
        "unsigned short"     => Ok("c_ushort"),
        "int"                => Ok("c_int"),
        "unsigned int"       => Ok("c_uint"),
        "long"               => Ok("c_long"),
        "unsigned long"      => Ok("c_ulong"),
        "long long"          => Ok("c_longlong"),
        "unsigned long long" => Ok("c_ulonglong"),
        "void *"             => Ok("Ptr<()>"),
        _                    => Err(CTranslateFault.UnsupportedType(c)),
    })
}

direct = (tree: Jsons, node: JsonId) bool {
    tree.field(node, "loc").match({
        None      => false,
        Ok(place) => tree.field(place, "includedFrom").match({
            Ok(_) => false,
            None  => true,
        }),
    })
}

// The `Jsons` accessors below are the `Res<T>` doors of `std.json` with an
// `InvalidAst` fault naming what was missing.
array = (tree: Jsons, id: JsonId, where: str) Res<Run, CTranslateFault> {
    tree.at(id).match({
        Json.Arr(run) => Ok(run),
        _             => Err(CTranslateFault.InvalidAst(where)),
    })
}

item_of = (tree: Jsons, id: JsonId, i: usize) Res<JsonId, CTranslateFault> {
    tree.item(id, i).match({
        Ok(value) => Ok(value),
        None      => Err(CTranslateFault.InvalidAst("array item")),
    })
}

field_of = (tree: Jsons, id: JsonId, name: str)
           Res<JsonId, CTranslateFault> {
    tree.field(id, name).match({
        Ok(value) => Ok(value),
        None      => Err(CTranslateFault.InvalidAst(name)),
    })
}

optional_text = (tree: Jsons, id: JsonId, name: str) Res<str> {
    tree.field(id, name).match({
        Ok(value) => tree.text(value),
        None      => None,
    })
}

text_field = (tree: Jsons, id: JsonId, name: str)
             Res<str, CTranslateFault> {
    tree.field_of(id, name).match({
        Err(e)    => Err(e),
        Ok(value) => tree.text_value(value, name),
    })
}

text_field_in = (tree: Jsons, id: JsonId, owner: str, name: str)
                Res<str, CTranslateFault> {
    tree.field_of(id, owner).match({
        Err(e)       => Err(e),
        Ok(owner_id) => tree.text_field(owner_id, name),
    })
}

text_value = (tree: Jsons, id: JsonId, name: str)
             Res<str, CTranslateFault> {
    tree.text(id).match({
        Ok(value) => Ok(value),
        None      => Err(CTranslateFault.InvalidAst(name)),
    })
}
