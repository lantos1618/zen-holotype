// probeAS3: recursion carrying a fixed array through each frame
step = (xs: [i64, 3], n: i64) i64 {
    (n == 0).match({
        true  => xs[0] + xs[1] + xs[2],
        false => step([i64, 3](xs[2], xs[0] * 2, xs[1]), n - 1),
    });
}

main = (env: Env) Res<i32, AllocError> {
    println("{}", step([i64, 3](1, 0, 0), 5));
    Ok(0);
}
