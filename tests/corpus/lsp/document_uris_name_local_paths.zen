// The LSP and Fs name the same remote document differently. A remote
// server must discard VS Code's authority before opening the local path.

str = std.text
Alloc, AllocError = std.mem
Map = std.collections
path_of, uri_at, doc_text = lsp.lsp_uri

show = (a: Alloc, uri: str) Res<(), AllocError> { println("{}", path_of(a, uri).try()); Ok(()) }

main = (env: Env) Res<i32, AllocError> {
    a ::= env.mem.alloc();
    show(a, "file:///home/ubuntu/zenc/main.zen").try();
    show(a, "file://src/main.zen").try();
    show(a, "vscode-remote://ssh-remote+box/home/ubuntu/zenc/main.zen").try();
    show(a, "vscode-remote://dev-container+abc/workspaces/zenc/main.zen").try();
    show(a, "vscode-remote://ssh-remote+box").try();
    show(a, "untitled:Untitled-1").try();
    show(a, "").try();
    show(a, "file://").try();
    show(a, "vscode-remote://").try();
    show(a, "vscode-remote:///").try();
    show(a, "FILE:///home/ubuntu/main.zen").try();
    show(a, "/tmp/raw path.zen").try();
    show(a, "src/raw%20name.zen").try();

    show(a, "file:///tmp/with%20space/%25%23caf%C3%A9.zen").try();
    show(a, "file://localhost/tmp/main.zen").try();
    show(a, "vscode-remote://ssh-remote+box/tmp/with%20space.zen").try();
    show(a, "file:///tmp/%00%GG.zen").try();
    println("{}", uri_at(a, "/workspace", "main.zen").try());
    println("{}", uri_at(a, "/with space", "x%#é.zen").try());
    docs ::= a.Map<str, str>();
    docs.set("file:///same.zen", "local overlay").try();
    docs.set("vscode-remote://host/same.zen", "remote overlay").try();
    println("{}", doc_text(env, a, docs, "file:///same.zen"));
    println("{}", doc_text(env, a, docs, "vscode-remote://host/same.zen"));
    Ok(0);
}
