== a signature past the width breaks one parameter per line
faithful: true, fixpoint
1 |lower_write* = (|
2 |    be  :: CBackend,|
3 |    id  : ExprId,|
4 |    c   : Call,|
5 |    ret : TyId,|
6 |    ctx : Ctx,|
7 |    out :: String|
8 |) Res<(), AllocError> {|
9 |    be.need_fs()|
10 |}|
== a hand-wrapped signature is re-laid, not preserved
faithful: true, fixpoint
1 |add_union = (|
2 |    a     : Alloc,|
3 |    src   : Src,|
4 |    tree  : Ast,|
5 |    cands :: Vec<Cand>,|
6 |    t     : Type,|
7 |    u     : Union|
8 |) Res<(), AllocError> {|
9 |    u.run()|
10 |}|
== a signature under the width keeps its one line
faithful: true, fixpoint
1 |break_lines* = (a: Alloc, file: str, text: str) Res<String, AllocError> {|
2 |    a.run()|
3 |}|
== parameters defer to the return union on their line
faithful: true, fixpoint
1 |handle = (r: Req) Res<str, Io|
2 |    | Parse|
3 |    | Net|
4 |    | AddressInUse|
5 |    | ConnectionReset|
6 |    | TimedOut> {|
7 |    r.run()|
8 |}|
