// THE LEAK this directory was missing.
//
// Grammar R1a makes a single bare name on the right an ALIAS, not an
// import -- that is what lets `Alias = Shape` need no lookahead. So this
// line binds `reseat` to the MODULE `vec`, and it is a coincidence that
// `vec` also declares an unstarred function of that same name.
//
// Every other spelling of this mistake is already rejected: `zz = vec`
// then `zz.reseat(3)`, `reseat.reseat(3)`, `Bag, reseat = vec`, and
// `reseat = vec.vec` all name the gate. Only the collision below was
// accepted, silently, because on that path nothing thought a module was
// involved at all -- and a module is not a callable value under any
// export status, starred or not.

reseat = vec

main = (env: Env) Res<i32, IoError> {
    println("{}", reseat(3));
    Ok(0);
}
