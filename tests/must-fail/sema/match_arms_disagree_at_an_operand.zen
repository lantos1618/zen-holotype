// MUST FAIL: two arms of a `.match` disagree, and the match is an
// OPERAND of `+`.
//
// An operand writes no type down either: `sema_type.arith_type` reads
// the two sides' types and takes the wider, and a join is a type like
// any other — it never asks what it was joined from. So the whole
// expression came out `int`, cc accepted it, and `b.match({ true => 1,
// false => false }) + 1` evaluated to 2.
//
// The third position with no word of its own, after an untyped binding
// and a parameter declared `T`.
f = (b: bool) i32 {
    b.match({
        true  => 1,
        false => false,
    }) + 1;
}

main = (env: Env) Res<i32, ArgError> {
    println("{}", f(false));
    Ok(0);
}
