// `found.get(0)` is Vec's `get`, because `found` is a Vec. Map declares
// `get` too, and a Map is nowhere in this program -- resolving the name
// across the program instead of on the receiver instantiated `Map.get`
// at K = ?, V = ?, which then reported three diagnostics inside
// std/collections about code this file never calls.

Found = { computed*: bool }

computed_member = (a: Alloc) Res<bool, AllocError> {
    found ::= a.Vec<Found>();
    found.add(Found(computed: true)).try();
    found.get(0).match({ Ok(f) => Ok(f.computed), None => Ok(false) });
}

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    println("{}", computed_member(alloc).try());
    Ok(0);
}
