Builder, BuildError, Codegen = std.build

build = (builder :: Builder) Res<(), BuildError> {
    builder.exe("script", {
        src: Path("entry.zen"), deps: [], backend: Codegen.Js
    }).try();
    builder.exe("named_script", {
        src: Path("entry.zen"), deps: [], backend: Codegen.Js,
        out: Ok(Path("dist/chosen.js"))
    }).try();
    builder.exe("native", {
        src: Path("entry.zen"), deps: [], backend: Codegen.Asm
    }).try();
    Ok(())
}
