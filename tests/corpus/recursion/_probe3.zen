// probe 3: recursive type through Ptr, walk + build, plus generic fn recursion
Link = {
    value: i64,
    next: Ptr<Link>,
}

make_chain = (n: i64) Link {
    (n <= 0).match({
        true  => Link(value: 1000, next: null_ptr<Link>()),
        false => Link(value: n * 10, next: null_ptr<Link>()),
    });
}

main = (env: Env) Res<i32, AllocError> {
    println("{}", make_chain(3).value);
    Ok(0);
}
