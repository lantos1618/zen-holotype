// an impl-supplied field is computed on every read, so it can never go
// stale: change the storage it derives from and the next read shows it.
// DESIGN.md, Declarations. `&s.width` and `s.width = ..` are rejected --
// see must-fail/sema/computed_field_address and computed_field_assign.

Boxy = {
    width: i32,
    height: i32,

    area* ::= (self: @Self) i32 { self.width * self.height }
}

Square = {
    side :: i32,
}

// Square stays one i32 wide: layout never depends on which impls are
// linked. area comes along free -- it only ever needed a width and a height
Square.impl(Boxy, {
    width: self.side,
    height: self.side,
})

main = (env: Env) Res<i32, AllocError> {
    s ::= Square(side: 2);
    println("{}", s.width);
    println("{}", s.area());

    s.side = 5;
    println("{}", s.width);
    println("{}", s.area());
    Ok(0);
}
