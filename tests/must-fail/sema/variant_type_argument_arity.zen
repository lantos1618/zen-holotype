// A variant call applies the enum head at exactly its declared type arity.

Duo<T, U> = First(T) | Second(U)
Plain = Yes | No

main = (env: Env) Res<i32, AllocError> {
    println("{}", Duo.First<i32>(1));
    println("{}", Duo.First<i32, str, bool>(1));
    println("{}", Plain.Yes<str>());
    Ok(0);
}
