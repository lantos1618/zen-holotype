// src/ast/ast_find.zen
// A cursor position, and the node under it.
//
// Every other consumer of this tree walks DOWNWARD from a root: the
// checker starts at a module, the backend starts at `main`, the
// formatter starts at a file. An editor does not. It arrives holding a
// byte offset and nothing else, and asks which node is there —
// `PLAN.md` stage 4 lists that as the one LSP primitive nothing else
// needs, which is exactly why it was the one missing.
//
// It is a SCAN AND NOT A WALK, and that is the point rather than a
// shortcut. `ast_arena.zen` already holds every expression, type,
// pattern and block in one flat `Vec` with its span, so "which node is
// at this position" is a fold over four lists and needs no traversal,
// no parent links and no second index. A walk would need every node
// form to know its own children — the thing the id'd arenas exist to
// avoid.
//
// SMALLEST WINS, and containment is what orders the candidates: two
// nodes covering one position are nested (a tree has no other shape),
// so "strictly inside the best so far" is a total order over the
// candidates and the answer does not depend on arena order. That is
// what makes this deterministic, which is the property `fmt` and the
// fixpoint both stand on.
//
// The position convention is `AST_CONTRACT.md`'s and is not restated
// here: 1-based line, 1-based BYTE column, span half-open, so a
// position equal to `end` is PAST the node. A cursor sitting one past
// the last byte of `foo` is not on `foo`, which is what makes the
// answer stable as an editor moves through a line.

// NOTHING HERE ALLOCATES, and law 1 says so in the only way that
// counts: no `Alloc` parameter on any signature below. A cursor query
// runs per keystroke, and one that grew a list would be the first thing
// an LSP had to work around.
str = std.text
Range = std.core
Pos, Span = ast.ast_span
ExprId, TypeId, PatternId, BlockId = ast.ast_id
Ast = ast.ast_arena

// Which arena the answer came out of. An LSP asks different questions
// of each — hover is `type_of` on an `ExprId`, and a `TypeId` under the
// cursor is a go-to-definition on a written type — so the answer names
// the family rather than erasing it to an index.
NodeRef* = ExprNode(ExprId) | TypeNode(TypeId) | PatternNode(PatternId)
         | BlockNode(BlockId)

// Is `p` inside `span`, in `file`? Half-open, so `end` is past it.
in_span* = (span: Span, file: str, p: Pos) bool {
    span.file.eq(file) && !before(p, span.start) && before(p, span.end)
}

// Is `a` earlier in the file than `b`? Line first, then byte column.
before* = (a: Pos, b: Pos) bool {
    (a.line < b.line) || (a.line == b.line && a.col < b.col)
}

// Is `inner` strictly inside `outer` — the same span is not.
inside* = (inner: Span, outer: Span) bool {
    !before(inner.start, outer.start)
        && !before(outer.end, inner.end)
        && (before(outer.start, inner.start) || before(inner.end, outer.end))
}

// THE QUERY: the smallest node of any family covering `p` in `file`.
//
// `None` when the position is in no node at all — past the end of the
// file, or inside trivia, which is a run on `Ast` and not a node. That
// is an answer and not a failure: an editor hovering over a comment
// gets nothing, which is correct.
node_at* = (tree: Ast, file: str, p: Pos) Res<NodeRef> {
    best ::= NodeRef.ExprNode(ExprId(index: 0));
    have ::= false;
    span ::= empty_span();
    eid ::= ExprId(index: 0);
    Range(0, tree.expr_ids()).loop((h, i) {
        ex = tree.expr_at(eid);
        take(ex.span, file, p, have, span).then(() {
            best = NodeRef.ExprNode(eid);
            span = ex.span;
            have = true;
        });
        eid = ExprId(index: eid.index + 1);
    });
    tid ::= TypeId(index: 0);
    Range(0, tree.type_ids()).loop((h, i) {
        ty = tree.type_at(tid);
        take(ty.span, file, p, have, span).then(() {
            best = NodeRef.TypeNode(tid);
            span = ty.span;
            have = true;
        });
        tid = TypeId(index: tid.index + 1);
    });
    pid ::= PatternId(index: 0);
    Range(0, tree.pattern_ids()).loop((h, i) {
        pat = tree.pattern_at(pid);
        take(pat.span, file, p, have, span).then(() {
            best = NodeRef.PatternNode(pid);
            span = pat.span;
            have = true;
        });
        pid = PatternId(index: pid.index + 1);
    });
    bid ::= BlockId(index: 0);
    Range(0, tree.block_ids()).loop((h, i) {
        blk = tree.block_at(bid);
        take(blk.span, file, p, have, span).then(() {
            best = NodeRef.BlockNode(bid);
            span = blk.span;
            have = true;
        });
        bid = BlockId(index: bid.index + 1);
    });
    have.match({ true => Ok(best), false => None })
}

// HOVER'S OWN DOOR: the smallest EXPRESSION covering `p`.
//
// A separate query rather than a filter over `node_at`, because they
// answer different questions. `x: i32 = 1` has a `Type` node over the
// `i32` and an `Expr` over the `1`, and a hover on `i32` wants the type
// node; a hover that wants a VALUE's type wants the expression that is
// there, not the smallest node of any kind that happens to cover it.
expr_node_at* = (tree: Ast, file: str, p: Pos) Res<ExprId> {
    best ::= ExprId(index: 0);
    have ::= false;
    span ::= empty_span();
    eid ::= ExprId(index: 0);
    Range(0, tree.expr_ids()).loop((h, i) {
        ex = tree.expr_at(eid);
        take(ex.span, file, p, have, span).then(() {
            best = eid;
            span = ex.span;
            have = true;
        });
        eid = ExprId(index: eid.index + 1);
    });
    have.match({ true => Ok(best), false => None })
}

// Does this candidate beat the best so far? It has to cover the
// position, and then either be the first thing that does or sit
// strictly inside what already does.
take = (cand: Span, file: str, p: Pos, have: bool, best: Span) bool {
    in_span(cand, file, p) && (!have || inside(cand, best))
}

// A span no candidate is inside, for the "nothing yet" state. It is
// never read before `have` is true; it exists because a mutable local
// needs a value to start at.
empty_span = () Span {
    Span(file: "", start: Pos(line: 0, col: 0), end: Pos(line: 0, col: 0))
}
