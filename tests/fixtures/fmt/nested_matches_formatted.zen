Box: Val(i32) | Empty
sz = (o: Box) string_view {
    o.match ({
        .Val(v) => v > 10 ? "big" : "small",
        .Empty  => "none",
    })
}
tier = (o: Box) i32 {
    o.match ({
        .Val(v) => (v > 100).match ({
            true  => 3,
            false => v > 10 ? 2 : 1,
        }),
        .Empty  => 0,
    })
}
main = () i32 { 0 }
