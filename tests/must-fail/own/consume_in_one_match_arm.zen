// consumed on one path and not the other. after the match the two
// paths join, and a binding that is dead on ANY incoming path is
// dead: the checker joins by "consumed if consumed anywhere".
//
// the dual of this file is corpus/own/consume_in_every_match_arm.zen,
// where every arm consumes and the join is clean.

Buf = {
    id: i32,
}

Buf.impl(Drop, {
    drop = (self :: @Self) () { /* nothing to release: id is bytes */ }
})

main = (env: Env) Res<i32, IoError> {
    f = Buf(id: 1);
    n = 1;
    kept = (n == 1).match({
        true  => consume f,
        false => Buf(id: 2),
    });
    println("{}", f.id);
    println("{}", kept.id);
    Ok(0);
}
