== a run lines up on the widest name
faithful: true, fixpoint
1 |f = () i32 {|
2 |    path ::= 1;|
3 |    rc   ::= 2;|
4 |    dst  ::= 3;|
5 |    4|
6 |}|
== hand padding outside a run is unmade
faithful: true, fixpoint
1 |f = () i32 {|
2 |    only ::= 1;|
3 |    g();|
4 |    other ::= 2;|
5 |    3|
6 |}|
== a statement between two bindings makes two runs
faithful: true, fixpoint
1 |f = () i32 {|
2 |    short       ::= 1;|
3 |    much_longer ::= 2;|
4 |    g();|
5 |    a  ::= 3;|
6 |    bb ::= 4;|
7 |    5|
8 |}|
== a blank line makes two runs
faithful: true, fixpoint
1 |f = () i32 {|
2 |    short       ::= 1;|
3 |    much_longer ::= 2;|
4 ||
5 |    a  ::= 3;|
6 |    bb ::= 4;|
7 |    5|
8 |}|
== `=` and `::=` never share a column
faithful: true, fixpoint
1 |f = () i32 {|
2 |    first = 1;|
3 |    second ::= 2;|
4 |    third = 3;|
5 |    4|
6 |}|
== a written type is part of the name
faithful: true, fixpoint
1 |f = () i32 {|
2 |    x: i32       = 1;|
3 |    neg_one: i32 = -1;|
4 |    q            = x / neg_one;|
5 |    q|
6 |}|
