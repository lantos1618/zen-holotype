// module `delta` — a third instantiation of `Box`, at `str`.
//
// three instantiations across four modules is enough for the emission order
// of the instantiation cache to be observable. It also gives the
// string-literal pool something to sort: `"delta label"`, `"delta"` and the
// literals in `alpha`, `beta` and `gamma` are unrelated strings whose hash
// order and whose source order are different.

Box = gamma

name* = () str { "delta" }

label* = () str {
    b = Box(value: "delta label");
    b.value
}

total* = () i32 { 5 }
