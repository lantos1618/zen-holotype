// src/sema/sema_call.zen
// What a call means, and which declaration it means.
//
// DESIGN.md, Overloading: "Resolution is on declared parameter types AND
// arity, and a closure's type is its full signature. There is no
// carve-out: `loop` overloads on `(h: LoopHandle, value: T)` versus
// `(h: LoopHandle, index: usize, value: T)` for exactly the reason
// `toString` overloads on a buffer versus an allocator."
//
// So a closure argument is matched on its PARAMETER COUNT and not waved
// through. That single line is why `loop` can be one name with six
// declarations, and a resolver that treated every closure as
// interchangeable would make five of them unreachable.
//
// PARAMETER NAMES ARE NOT IDENTITY. `TyFn` carries no names, so two
// candidates differing only in them are one signature and there is
// nothing to compare — which is exactly why declaring both is an error
// AT THE DECLARATION, naming both. A call site cannot be where that is
// discovered, because at a call site the two are indistinguishable; the
// call is only what triggers the check.
//
// A GENERIC PARAMETER SWALLOWS A CONCRETE ONE. `<A>(init: A, ..)` and
// `(alloc: Alloc, ..)` can never be told apart, so they may not be
// overloads — which is why DESIGN.md gives the allocating loop variant
// its own name, `map`. `swallows` below is that rule, and it is careful
// in the one way the bootstrapper records paying for: only a type
// parameter belonging to the CANDIDATE BEING TESTED is a wildcard.
// Without that, `loop<R, T>(range: R, ..)` and `loop<K, V>(map:
// Map<K,V>, ..)` look interchangeable, and the prelude declares both.
//
// OVER 500 LINES, AND THE JUSTIFICATION STYLE.md ASKS FOR: the subject
// is "which declaration does this call mean", and the declaration-site
// rules are the same question asked without a call. `same_signature` and
// `swallows` are the two halves of "can a call site tell these apart",
// and `matches` is that same comparison against real arguments — three
// readings of one predicate. Splitting them would leave the rule that
// two candidates are indistinguishable in a module that cannot see what
// distinguishing them means.
//
// A LAMBDA ARGUMENT'S BODY IS NOT TYPED HERE. "A closure passed to a
// function whose signature is already known infers its parameter types
// from that signature" — so typing the body before resolution has picked
// a candidate would type it against parameters that do not exist yet.
// The arity is what resolution needs and the arity is what it reads.

Ast, Expr, ExprId, Call, Arg, Access, Lambda, Ident, Span, Pos, nowhere = std.ast
Decl, DeclKind, Struct, Function, TParam, Param, TypeId = std.ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
DeclId = sema.sema_id
TyId, Ty, Types, TyFn, TyNamed, TyVar = sema.sema_ty
World, Def, DefKind, decl_at = sema.sema_def
Diag, SemaFault, NameFault, TypeFault, PairFault = sema.sema_diag
Checker, Ctx, UNRESOLVED = sema.sema_check
Inst, tparam_vars = sema.sema_inst
construct, instantiate = sema.sema_apply
Found, Base, base_of, members_of = sema.sema_member
is_type_def, opaque, first_found = sema.sema_member
static_access = sema.sema_static
first_hidden, hidden_member = sema.sema_member
satisfies_bound, check_bounds = sema.sema_bound
check_literal = sema.sema_trap
check_arms = sema.sema_hoist
bound_declares = sema.sema_supply
type_from_ast, type_of, param_type = sema.sema_type
alias_module, module_not_a_value = sema.sema_module
cands_of, travelled_cands, matches = sema.sema_cand
ty_at, is_tvar, recv_sig_fits = sema.sema_cand

// One candidate, as resolution sees it.
//
// `owner` is the declaration's qualified name, and it is what makes a
// type parameter identifiable: `Ty.Var` is nominal on its owner as well
// as its name, so `T` of one candidate is never `T` of another.
//
// `id` is WHICH DECLARATION this candidate came from, and it is what a
// resolution is. Without it the answer to "which of the six `loop`s did
// this call mean" exists only for as long as `chosen` runs, and every
// later consumer has to re-derive it from the name — which is how a
// backend ends up reporting an ambiguity that sema had settled.
Cand* = {
    id*: DeclId,
    name*: str,
    owner*: str,
    params*: Vec<TyId>,
    ret*: TyId,
    // the `Ty.Var`s this candidate's own type parameters denote, in
    // declaration order. They are built once, where the signature is
    // resolved, because that is the only place `T` and `owner` are both
    // in hand — and an instantiation is exactly a value for each of
    // these.
    tvars*: Vec<TyId>,
    tbounds*: Vec<TBound>,
    generic*: bool,
    span*: Span,
}

// One bound on one type parameter. A list, because `<K: Eq + Hash>` has
// two and "`+` is not `|`".
TBound* = {
    name*: str,
    bound*: TyId,
}

// One argument, as resolution sees it. A lambda has no type until a
// signature settles it, so it carries what resolution actually uses.
Actual* = {
    ty*: TyId,
    is_lambda*: bool,
    arity*: usize,
    // did the argument NAME a field? `Point(x: 3)` and `f(3)` are the
    // same node and are not the same thing: AST_CONTRACT.md gives the
    // `name: value` form to construction and to an impl's supplied
    // field, and a call's arguments are positional. Recorded here
    // because resolution is the one place the difference decides
    // anything.
    named*: bool,
    span*: Span,
}

// ---------------------------------------------------------------------
// QUERY: the type of a call
// ---------------------------------------------------------------------

// `id` is the CALL's own node id, and it is threaded rather than
// derived: an `Expr` is a value and carries no id, so the only place
// that knows which node this is, is the query that was asked about it.
// It is the key `chosen` writes the resolution under.
call_type* = (c :: Checker, id: ExprId, node: Expr, call: Call, ctx: Ctx)
             Res<TyId, AllocError> {
    callee = c.tree.expr_at(call.callee);
    callee.kind.match({
        Access(a) => member_call(c, id, node, call, a, ctx),
        Name(n)   => named_call(c, id, node, call, n.text, ctx),
        _         => indirect_call(c, node, call, ctx),
    })
}

actuals_of = (c :: Checker, args: Vec<Arg>, ctx: Ctx, out :: Vec<Actual>)
             Res<(), AllocError> {
    args.loop((h, a) {
        out.add(actual_of(c, a, ctx).try()).try();
    });
    Ok(());
}

actual_of = (c :: Checker, a: Arg, ctx: Ctx) Res<Actual, AllocError> {
    node = c.tree.expr_at(a.value);
    node.kind.match({
        Lambda(l) => lambda_actual(c, l, a),
        _         => value_actual(c, a, ctx),
    })
}

is_named = (a: Arg) bool { a.name.match({ Ok(_) => true, None => false }) }

lambda_actual = (c :: Checker, l: Lambda, a: Arg) Res<Actual, AllocError> {
    poison = c.types.unknown().try();
    Ok(Actual(
        ty: poison,
        is_lambda: true,
        arity: l.params.len,
        named: is_named(a),
        span: a.span
    ));
}

value_actual = (c :: Checker, a: Arg, ctx: Ctx) Res<Actual, AllocError> {
    ty = c.type_of(a.value, ctx).try();
    Ok(Actual(
        ty: ty,
        is_lambda: false,
        arity: 0,
        named: is_named(a),
        span: a.span
    ));
}

// ---------------------------------------------------------------------
// `f(..)`
// ---------------------------------------------------------------------

named_call = (
    c :: Checker,
    id: ExprId,
    node: Expr,
    call: Call,
    name: str,
    ctx: Ctx
) Res<TyId, AllocError> {
    actuals ::= c.alloc.Vec<Actual>();
    actuals_of(c, call.args, ctx, actuals).try();
    is_res_ctor(name).match({
        true  => res_ctor_type(c, name, actuals),
        false => print_or_call(c, id, node, call, name, actuals, ctx),
    })
}

// THE PRINT SUGAR HAS A TYPE, AND IT IS `()`.
//
// `println(..)` is "sugar for `<the Env in scope>.out.println(..)`",
// and no declaration of that name exists to resolve against — so a call
// through it fell all the way to `no_overload`, found no candidate at
// all, stayed silent by the rule above, and was answered with poison.
// Poison agrees with everything, so `println("x")` was a legal value of
// whatever type the context asked for. That is the poison mechanism
// being spent on a value that is not a mistake: the sugar owes no
// diagnostic, it simply returns nothing, and `()` is the type that says
// so. `gen_c_print.zen` has said the same all along — "a print is a
// statement sequence whose value is unit".
//
// THE TWO NAMES ARE `gen_c_print.is_print`'s, and they have to be: sema
// answering `()` for a name the backend does not recognise as a print
// would hand codegen an unresolved call wearing a real type.
print_or_call = (
    c :: Checker,
    id: ExprId,
    node: Expr,
    call: Call,
    name: str,
    actuals: Vec<Actual>,
    ctx: Ctx
)
                Res<TyId, AllocError> {
    is_print_sugar(name).match({
        true  => c.types.prim("()"),
        false => local_or_decl_call(c, id, node, call, name, actuals, ctx),
    })
}

is_print_sugar = (name: str) bool { name.eq("println") || name.eq("print") }

// `Ok(x)` and `Err(e)` are the prelude's own variants and there is
// nothing to resolve: `Res<T>` and `Res<T, E>` are two arities of one
// name, recognised structurally exactly as `sema_type.zen` recognises
// the written type. `Ok(x)` is OPEN — which `Res` it closes is not
// decided until an expectation says.
is_res_ctor = (name: str) bool { name.eq("Ok") || name.eq("Err") }

res_ctor_type = (c :: Checker, name: str, actuals: Vec<Actual>)
                Res<TyId, AllocError> {
    payload = first_ty(c, actuals).try();
    name.eq("Ok").match({
        true  => c.types.res_open(payload),
        false => err_res(c, payload),
    })
}

// Only success lifts, so `Err(e)` says nothing about the value type.
err_res = (c :: Checker, e: TyId) Res<TyId, AllocError> {
    hole = c.types.infer().try();
    c.types.res_failure(hole, e)
}

first_ty = (c :: Checker, actuals: Vec<Actual>) Res<TyId, AllocError> {
    actuals.get(0).match({
        None  => c.types.prim("()"),
        Ok(a) => Ok(a.ty),
    })
}

local_or_decl_call = (
    c :: Checker,
    id: ExprId,
    node: Expr,
    call: Call,
    name: str,
    actuals: Vec<Actual>,
    ctx: Ctx
)
                     Res<TyId, AllocError> {
    c.lookup(name).match({
        None  => decl_call(c, id, node, call, name, None, actuals, ctx),
        Ok(b) => fn_ret(c, node, b.ty),
    })
}

// A declaration of that name: a function to resolve against, or a type
// to construct.
//
// The functions are tried FIRST and the type only when none matches,
// which is the fix for the bootstrapper's §9: `World* = (a: Alloc, tree:
// Ast) Res<World, AllocError>` declared beside `World* = { .. }` is the
// pairing `std.collections` uses for `Vec`, and matching the struct's
// fields positionally instead of the function is what made three
// constructors in this folder unwritable.
decl_call = (
    c :: Checker,
    id: ExprId,
    node: Expr,
    call: Call,
    name: str,
    recv: Res<TyId>,
    actuals: Vec<Actual>,
    ctx: Ctx
)
            Res<TyId, AllocError> {
    cands ::= c.alloc.Vec<Cand>();
    cands_of(c, ctx.module, name, cands).try();
    travelled_cands(c, name, recv, cands).try();
    kept ::= c.alloc.Vec<Cand>();
    keep_matching(c, cands, actuals, kept).try();
    (kept.len > 0).match({
        true  => chosen(c, id, node, call, kept, actuals, ctx),
        false => construct_or_fail(c, id, node, call, name, recv, cands, ctx),
    })
}

keep_matching = (
    c :: Checker,
    cands: Vec<Cand>,
    actuals: Vec<Actual>,
    kept :: Vec<Cand>
) Res<(), AllocError> {
    cands.loop((h, k) { keep_one(c, k, actuals, kept).try() });
    Ok(());
}

// A named helper rather than a `.then` inside the loop body: a loop
// binding read inside a nested closure does not resolve.
// docs/SEMA_BOOTSTRAP_FIXES.md §10.
keep_one = (c :: Checker, k: Cand, actuals: Vec<Actual>, kept :: Vec<Cand>)
           Res<(), AllocError> {
    matches(c, k, actuals).try().match({
        true  => kept.add(k),
        false => Ok(()),
    })
}

construct_or_fail = (
    c :: Checker,
    id: ExprId,
    node: Expr,
    call: Call,
    name: str,
    recv: Res<TyId>,
    cands: Vec<Cand>,
    ctx: Ctx
)
                    Res<TyId, AllocError> {
    defs ::= c.alloc.Vec<Def>();
    c.world.defs_of(ctx.module, name, defs).try();
    type_def_of(defs).match({
        None  => unresolved(c, node, call, name, recv, cands),
        Ok(d) => construct_def(c, id, node, call, d, ctx),
    })
}

// A CALL THROUGH A RECEIVER IS A MEMBER THAT IS NOT THERE, and that is a
// different sentence from "no overload matches". `b.size()` where `size`
// belongs to `Bag` has no candidate BECAUSE `size` is not on `Box` — so
// the diagnostic has to name the type that was asked, and land on the
// name after the dot rather than on the receiver expression. Reported
// here whether or not a candidate of the name exists anywhere: for a
// receiver call this IS the diagnostic, and nothing else in the folder
// owes one.
unresolved = (
    c :: Checker,
    node: Expr,
    call: Call,
    name: str,
    recv: Res<TyId>,
    cands: Vec<Cand>
) Res<TyId, AllocError> {
    recv.match({
        Ok(ty) => no_such_method(c, call, name, ty),
        None   => no_overload(c, node, name, cands),
    })
}

// A NAME A BOUND DECLARED IS NOT A NAME THE TYPE NEVER HEARD OF, even
// when no impl supplies it. `alloc.create<Node>()` reaches nothing here
// and is not a mistake — `gen_c_alloc.zen` writes that body — so this
// asks `bound_declares` and not the member table, which is the question
// whose answer is `no` for both.
no_such_method = (c :: Checker, call: Call, name: str, ty: TyId)
                 Res<TyId, AllocError> {
    bound_declares(c, ty, name).try().match({
        true  => c.types.unknown(),
        false => report_no_method(c, call, name, ty),
    })
}

report_no_method = (c :: Checker, call: Call, name: str, ty: TyId)
                   Res<TyId, AllocError> {
    poison = c.types.unknown().try();
    at     = callee_name_span(c, call);
    c.report(at.file, at,
             SemaFault.NoSuchField(TypeFault(
                 name: name,
                 expected: poison,
                 found: ty
             ))).try();
    c.types.unknown()
}

// The name after the dot. A receiver call always has an `Access` callee
// — that is what made it one — and the span is read back off the node
// rather than threaded through six signatures that have no other use
// for it.
callee_name_span = (c: Checker, call: Call) Span {
    c.tree.expr_at(call.callee).kind.match({
        Access(a) => a.name.span,
        _         => nowhere(),
    })
}

// A MODULE IS NOT A CONSTRUCTOR. `is_type_def` answers about a `DefKind`
// and an alias is a type declaration by kind — but `reseat = vec` aliases
// a MODULE, and constructing it invented a nominal type of the alias's own
// name that nothing declares. That is how an unstarred `reseat` inside
// `vec` became callable through a name that never meant it.
construct_def = (
    c :: Checker,
    id: ExprId,
    node: Expr,
    call: Call,
    d: Def,
    ctx: Ctx
) Res<TyId, AllocError> {
    c.alias_module(d.id).match({
        None   => construct(c, id, call, d, ctx),
        Ok(mi) => c.module_not_a_value(node.span, d.name, mi),
    })
}

type_def_of = (defs: Vec<Def>) Res<Def> {
    Range(0, defs.len).find((i) {
        defs.get(i).match({ Ok(d) => is_type_def(d.kind), None => false })
    }).match({
        Ok(i) => defs.get(i),
        None  => None,
    })
}

// CONSTRUCTING IS A RESOLUTION TOO, and it is recorded for the same
// reason a call is: `Checker* = { .. }` beside `Checker* = (a: Alloc,
// ..)` is two declarations of one name, and which of them a call site
// meant is decided here and nowhere else.
// No candidate of that arity or those types. Silent when there were no
// candidates at all: the name resolved to something that is not a
// function, and that is somebody else's diagnostic.
no_overload = (c :: Checker, node: Expr, name: str, cands: Vec<Cand>)
              Res<TyId, AllocError> {
    (cands.len > 0).then(() {
        c.report(
            node.span.file,
            node.span,
            SemaFault.NoOverload(NameFault(name: name))
        ).try();
    });
    c.types.unknown()
}

// The first candidate that matched, and THE PLACE THE ANSWER IS WRITTEN
// DOWN. Everything after resolution — the backend most of all — reads
// `call_memo` rather than asking the name again, because the name is
// exactly what could not answer.
chosen = (
    c :: Checker,
    id: ExprId,
    node: Expr,
    call: Call,
    kept: Vec<Cand>,
    actuals: Vec<Actual>,
    ctx: Ctx
) Res<TyId, AllocError> {
    kept.get(0).match({
        None  => c.types.unknown(),
        Ok(k) => chosen_ret(c, id, node, call, k, actuals, ctx),
    })
}

chosen_ret = (
    c :: Checker,
    id: ExprId,
    node: Expr,
    call: Call,
    k: Cand,
    actuals: Vec<Actual>,
    ctx: Ctx
) Res<TyId, AllocError> {
    c.resolve_call(id, k.id).try();
    check_bounds(c, k, actuals, node.span).try();
    arg_literals(c, call.args, k.params, recv_off(call, actuals)).try();
    instantiate(c, id, call, k, actuals, ctx)
}

// WHETHER PARAMETER ZERO HAS AN ARGUMENT, derived and not plumbed:
// `ufcs_call` prepends the receiver to the ACTUALS resolution matched
// on, and `actuals_of` is otherwise one-for-one with the written
// arguments — so the difference is 1 for `x.f(a)` and 0 for `f(a)`.
//
// `arg_literals` documented this offset from the day it was written and
// the one call site passed 0. So `x.f(a)` checked `a` against the
// RECEIVER's type; `check_literal` is silent when that is not an integer
// type, which kept an assertion that was already written and already
// tested inert for every dotted call in the language.
recv_off = (call: Call, actuals: Vec<Actual>) usize {
    actuals.len - call.args.len
}

// RESOLUTION PICKED THE CANDIDATE ON THE FAMILY, so somebody still has
// to ask about the value. `fits` is `assignable`, and `assignable` reads
// "a literal's type comes from its context" as: an `int` agrees with
// every integer type — which is right about `narrow(3000000000)` being a
// call to `narrow` and says nothing about 3000000000 not being an i32.
//
// AFTER RESOLUTION AND NOT DURING IT. A candidate that a literal
// overflows is still the candidate the author meant; refusing it during
// the fit would silently pick a wider overload instead of naming the
// mistake, and with no wider one in scope would report "no overload
// matches" for a call whose only fault is one digit too many.
//
// `off` IS THE RECEIVER — `recv_sig_fits`' rule, and `recv_off` above
// is where this call site decides it.
arg_literals* = (c :: Checker, args: Vec<Arg>, params: Vec<TyId>, off: usize)
               Res<(), AllocError> {
    i ::= off;
    args.loop((h, a) {
        param_literal(c, a.value, params, i).try();
        i = i + 1;
    });
    Ok(());
}

// A VARIADIC CALL HAS NO PARAMETER HERE, and a parameter nobody declared
// expects nothing of the argument. The length is asked rather than
// `ty_at`'s `UNRESOLVED`, which is type zero — whichever type that
// happens to be interned as.
param_literal = (c :: Checker, id: ExprId, params: Vec<TyId>, i: usize)
                Res<(), AllocError> {
    (i < params.len).match({
        false => Ok(()),
        true  => param_wants(c, id, ty_at(params, i)),
    })
}

// ONE QUESTION ASKED OF TWO SHAPES: a literal is asked whether it fits
// the declared type, and a match is several values standing in one
// place, so every ARM is asked the same thing (`sema_hoist.check_arms`,
// the rule itself and never a second copy of it). Resolution picked the
// candidate on the FIRST arm's type and no arm speaks for the rest —
// which is how `g(b.match({ true => 1, false => false }))` reached an
// `i32` parameter as a 0 nobody wrote.
param_wants = (c :: Checker, id: ExprId, want: TyId) Res<(), AllocError> {
    c.check_literal(id, want).try();
    c.check_arms(id, want)
}

// ---------------------------------------------------------------------
// `x.f(..)`
// ---------------------------------------------------------------------

member_call = (
    c :: Checker,
    id: ExprId,
    node: Expr,
    call: Call,
    ac: Access,
    ctx: Ctx
) Res<TyId, AllocError> {
    b = base_of(c, ac.base, ctx).try();
    b.is_type.match({
        true  => static_call(c, node, call, ac, b.ty, ctx),
        false => receiver_call(c, id, node, call, ac, b, ctx),
    })
}

// `Slot.Left(cell)` — a variant carrying a payload IS the function that
// builds one, so this is an ordinary call through it.
static_call = (
    c :: Checker,
    node: Expr,
    call: Call,
    ac: Access,
    ty: TyId,
    ctx: Ctx
) Res<TyId, AllocError> {
    got = c.static_access(call.callee, node, ac, ty, ctx).try();
    fn_ret(c, node, got)
}

receiver_call = (
    c :: Checker,
    id: ExprId,
    node: Expr,
    call: Call,
    ac: Access,
    b: Base,
    ctx: Ctx
) Res<TyId, AllocError> {
    opaque(c, b.ty).match({
        true  => c.types.unknown(),
        false => known_receiver_call(c, id, node, call, ac, b, ctx),
    })
}

// LAW 6 BEFORE OVERLOAD RESOLUTION, and the same gate `sema_member.zen`
// puts before `pick`. A call resolves its own callee against the member
// table rather than going through `access_type`, so a method the asking
// module may not see arrives here and nowhere else — and a rule enforced
// on `v.grow` but not on `v.grow()` is enforced on the spelling nobody
// writes. Before, not after: a hidden member is not a candidate that
// loses to another, and falling through to `ufcs_call` would report it
// as a name the type does not have.
known_receiver_call = (
    c :: Checker,
    id: ExprId,
    node: Expr,
    call: Call,
    ac: Access,
    b: Base,
    ctx: Ctx
)
                      Res<TyId, AllocError> {
    actuals ::= c.alloc.Vec<Actual>();
    actuals_of(c, call.args, ctx, actuals).try();
    found ::= c.alloc.Vec<Found>();
    members_of(c, b.ty, ac.name.text, found).try();
    first_hidden(found, ctx.module).match({
        Ok(f) => hidden_member(c, ac, f),
        None  => reachable_call(c, id, node, call, ac, b, found, actuals, ctx),
    })
}

reachable_call = (
    c :: Checker,
    id: ExprId,
    node: Expr,
    call: Call,
    ac: Access,
    b: Base,
    found: Vec<Found>,
    actuals: Vec<Actual>,
    ctx: Ctx
) Res<TyId, AllocError> {
    (found.len > 0).match({
        true  => method_call(c, node, found, actuals),
        false => ufcs_call(c, id, node, call, ac, b, actuals, ctx),
    })
}

// A method's receiver is its first parameter — "a method is a UFCS
// function whose first parameter happens to be named `self`" — so the
// arity a call site sees is one less than the signature's.
//
// DECLARED PARAMETER TYPES FIRST, AND ARITY ONLY AS A FALLBACK. This
// asked arity alone, and arity is the half of the rule that cannot
// separate `toString(self, out :: Sink)` from `toString(self, a:
// Alloc)` — both are two. So the answer was whichever the member table
// listed first, for a name whose whole point is that the ARGUMENT
// decides. `display.zen` says it where the two are declared: "overload
// resolution picks between them on the declared parameter type: a buffer
// or an allocator."
//
// The arity fallback is kept and is not laziness: `fits` is a question
// about types, and where a receiver's type is not settled, or the
// signature is variadic, it answers `false` for every candidate.
// Falling back leaves every call that resolves today resolving the same
// way, so this can only change an answer where a strictly better one
// exists.
method_call = (
    c :: Checker,
    node: Expr,
    found: Vec<Found>,
    actuals: Vec<Actual>
) Res<TyId, AllocError> {
    pick_fitting(c, found, actuals).try().match({
        Ok(f) => fn_ret(c, node, f.ty),
        None  => by_arity_ret(c, node, found, actuals),
    })
}

by_arity_ret = (
    c :: Checker,
    node: Expr,
    found: Vec<Found>,
    actuals: Vec<Actual>
) Res<TyId, AllocError> {
    pick_arity(c, found, actuals.len + 1).match({
        None  => first_found_ret(c, node, found),
        Ok(f) => fn_ret(c, node, f.ty),
    })
}

// The first member whose declared parameters accept these arguments.
// FIRST and not "the only one": two members accepting the same call is
// an overload set a call site cannot tell apart, and that is an error AT
// THE DECLARATION — `check_overloads` names both — because at a call
// site the two are indistinguishable and there is nothing to report.
pick_fitting = (c :: Checker, found: Vec<Found>, actuals: Vec<Actual>)
               Res<Res<Found>, AllocError> {
    kept ::= c.alloc.Vec<Found>();
    found.loop((h, f) { keep_fitting(c, f, actuals, kept).try() });
    Ok(first_found(kept));
}

// A named helper rather than a `.then` inside the loop body: a loop
// binding read inside a nested closure does not resolve.
// docs/SEMA_BOOTSTRAP_FIXES.md §10.
keep_fitting = (
    c :: Checker,
    f: Found,
    actuals: Vec<Actual>,
    kept :: Vec<Found>
) Res<(), AllocError> {
    params ::= c.alloc.Vec<TyId>();
    fn_params(c, f.ty, params).try();
    recv_sig_fits(c, params, actuals).try().match({
        true  => kept.add(f),
        false => Ok(()),
    })
}

// A member that is not a function has no parameters and fits no call.
fn_params = (c :: Checker, ty: TyId, out :: Vec<TyId>)
            Res<(), AllocError> {
    c.types.at(ty).match({
        Fn(f) => copy_tys(f.params, out),
        _     => Ok(()),
    }).try();
    Ok(());
}

copy_tys = (xs: Vec<TyId>, out :: Vec<TyId>) Res<(), AllocError> {
    xs.loop((h, x) { out.add(x).try() });
    Ok(());
}

pick_arity = (c: Checker, found: Vec<Found>, want: usize) Res<Found> {
    Range(0, found.len).find((i) {
        found.get(i).match({
            Ok(f) => fn_arity_is(c, f.ty, want),
            None  => false,
        })
    }).match({
        Ok(i) => found.get(i),
        None  => None,
    })
}

fn_arity_is = (c: Checker, ty: TyId, want: usize) bool {
    c.types.at(ty).match({ Fn(f) => f.params.len == want, _ => false })
}

first_found_ret = (c :: Checker, node: Expr, found: Vec<Found>)
                  Res<TyId, AllocError> {
    found.get(0).match({
        None  => c.types.unknown(),
        Ok(f) => fn_ret(c, node, f.ty),
    })
}

// "A free function whose first param is the type is callable as a
// method." So the receiver becomes argument zero and resolution runs
// exactly as it does for `f(x, ..)` — there is no second mechanism.
ufcs_call = (
    c :: Checker,
    id: ExprId,
    node: Expr,
    call: Call,
    ac: Access,
    b: Base,
    actuals: Vec<Actual>,
    ctx: Ctx
)
            Res<TyId, AllocError> {
    all ::= c.alloc.Vec<Actual>();
    all.add(Actual(
        ty: b.ty,
        is_lambda: false,
        arity: 0,
        named: false,
        span: node.span
    )).try();
    actuals.loop((h, a) { all.add(a).try() });
    decl_call(c, id, node, call, ac.name.text, Ok(b.ty), all, ctx)
}

indirect_call = (c :: Checker, node: Expr, call: Call, ctx: Ctx)
                Res<TyId, AllocError> {
    ty = c.type_of(call.callee, ctx).try();
    fn_ret(c, node, ty)
}

fn_ret = (c :: Checker, node: Expr, ty: TyId) Res<TyId, AllocError> {
    c.types.at(ty).match({
        Fn(f)   => Ok(f.ret),
        Unknown => Ok(ty),
        Infer   => Ok(ty),
        _       => not_callable(c, node, ty),
    })
}

not_callable = (c :: Checker, node: Expr, ty: TyId) Res<TyId, AllocError> {
    poison = c.types.unknown().try();
    c.report(node.span.file, node.span,
             SemaFault.NotCallable(TypeFault(
                 name: "",
                 expected: poison,
                 found: ty
             ))).try();
    c.types.unknown()
}

// ---------------------------------------------------------------------
// the declaration-site rules
//
// An overload set is wrong WHERE IT IS WRITTEN, so both diagnostics
// carry both declarations' positions and neither carries a call's.
// ---------------------------------------------------------------------

check_overloads* = (c :: Checker, mi: usize, name: str)
                   Res<(), AllocError> {
    cands ::= c.alloc.Vec<Cand>();
    cands_of(c, mi, name, cands).try();
    Range(0, cands.len).loop((h, i) {
        Range(i + 1, cands.len).loop((h2, j) {
            check_pair(c, name, cands, i, j).try();
        });
    });
    Ok(());
}

check_pair = (c :: Checker, name: str, cands: Vec<Cand>, i: usize, j: usize)
             Res<(), AllocError> {
    cands.get(i).match({
        None  => Ok(()),
        Ok(a) => check_against(c, name, a, cands, j),
    })
}

check_against = (
    c :: Checker,
    name: str,
    a: Cand,
    cands: Vec<Cand>,
    j: usize
) Res<(), AllocError> {
    cands.get(j).match({
        None  => Ok(()),
        Ok(b) => compare(c, name, a, b),
    })
}

compare = (c :: Checker, name: str, a: Cand, b: Cand) Res<(), AllocError> {
    (a.params.len == b.params.len).match({
        true  => compare_same_arity(c, name, a, b),
        false => Ok(()),
    })
}

compare_same_arity = (c :: Checker, name: str, a: Cand, b: Cand)
                     Res<(), AllocError> {
    same_signature(c, a, b).match({
        true  => duplicate(c, name, a, b),
        false => maybe_swallow(c, name, a, b),
    })
}

// Names are documentation, so `<T>(first: T, second: T)` and
// `<T>(left: T, right: T)` are the SAME signature. Two type parameters
// in the same position are one type for this purpose: `<T>(a: T)` and
// `<U>(a: U)` differ in nothing a call site can see.
same_signature* = (c: Checker, a: Cand, b: Cand) bool {
    Range(0, a.params.len).find((i) {
        same_param(c, ty_at(a.params, i), ty_at(b.params, i)) == false
    }).match({ Ok(_) => false, None => true })
}

same_param = (c: Checker, x: TyId, y: TyId) bool {
    x.eq(y) || (is_tvar(c, x) && is_tvar(c, y))
}

maybe_swallow = (c :: Checker, name: str, a: Cand, b: Cand)
                Res<(), AllocError> {
    ((a.generic || b.generic) && swallows(c, a, b)).match({
        true  => ambiguous(c, name, a, b),
        false => Ok(()),
    })
}

// Does either candidate's generic accept everything the other's
// concrete parameter does, position by position? Only a type parameter
// belonging to the candidate being tested is a wildcard — that is what
// keeps `loop(range: R, ..)` and `loop(map: Map<K,V>, ..)` distinct.
swallows* = (c: Checker, a: Cand, b: Cand) bool {
    all_eat(c, a, b) || all_eat(c, b, a)
}

all_eat = (c: Checker, g: Cand, k: Cand) bool {
    g.generic && Range(0, g.params.len).find((i) {
        eats(c, ty_at(g.params, i), ty_at(k.params, i), g.owner) == false
    }).match({ Ok(_) => false, None => true })
}

eats = (c: Checker, x: TyId, y: TyId, owner: str) bool {
    var_of(c, x, owner) || x.eq(y) || structural_eats(c, x, y, owner)
}

var_of = (c: Checker, x: TyId, owner: str) bool {
    c.types.at(x).match({ Var(v) => v.owner.eq(owner), _ => false })
}

structural_eats = (c: Checker, x: TyId, y: TyId, owner: str) bool {
    c.types.at(x).match({
        Fn(f)    => fn_eats(c, f, y, owner),
        Named(n) => named_eats(c, n, y, owner),
        _        => false,
    })
}

fn_eats = (c: Checker, f: TyFn, y: TyId, owner: str) bool {
    c.types.at(y).match({
        Fn(g) => (f.params.len == g.params.len)
                     && all_eats(c, f.params, g.params, owner)
                     && eats(c, f.ret, g.ret, owner),
        _     => false,
    })
}

named_eats = (c: Checker, n: TyNamed, y: TyId, owner: str) bool {
    c.types.at(y).match({
        Named(m) => n.decl.eq(m.decl) && (n.args.len == m.args.len)
                        && all_eats(c, n.args, m.args, owner),
        _        => false,
    })
}

all_eats = (c: Checker, xs: Vec<TyId>, ys: Vec<TyId>, owner: str) bool {
    Range(0, xs.len).find((i) {
        eats(c, ty_at(xs, i), ty_at(ys, i), owner) == false
    }).match({ Ok(_) => false, None => true })
}

duplicate = (c :: Checker, name: str, a: Cand, b: Cand) Res<(), AllocError> {
    c.report(a.span.file, a.span,
             SemaFault.DuplicateSignature(PairFault(
                 name: name,
                 first: a.span,
                 second: b.span
             )))
}

ambiguous = (c :: Checker, name: str, a: Cand, b: Cand) Res<(), AllocError> {
    c.report(a.span.file, a.span,
             SemaFault.AmbiguousOverload(PairFault(
                 name: name,
                 first: a.span,
                 second: b.span
             )))
}
