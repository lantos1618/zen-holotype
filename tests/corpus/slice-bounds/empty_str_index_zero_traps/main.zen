// LEN ZERO IS NOT A SPECIAL CASE SOMEONE WROTE DOWN. An empty str has
// data aimed at ""'s NUL and len 0, so s[0] must die through the SAME
// underflow every other out-of-range index uses -- `len - 0 - 1` on a
// length of zero. An is_empty shortcut, or a defaulted byte handed back
// to be helpful, prints 0 here: a perfectly plausible u8, which makes
// it worthless as a sentinel and is why this is a trap and not a Res.
//
// the empty literal arrives as a call parameter, so nothing proves its
// length at compile time and the check has to survive to the generated
// C. The println of len 0 lands first; the trap after it is stderr's
// business, not this file's.

// a trap never lifts into Res: it aborts the process
Error = Overflow | DivideByZero | OutOfBounds

first = (s: str) u8 { s[0] }

main = (env: Env) Res<i32, Error> {
    e = "";
    println("len {}", e.len);
    println("{}", first(e));
    println("unreachable");
    Ok(0);
}
