{ Expr, Stmt, Decl, Func, Param, Ty, EnumDecl, Field, ImplData, MatchData, CallData, MethodCallData,
  BlockData, LambdaData, SliceData } = compiler.ast.ast_types
{ cbuf, stmts_diverge, subst_ty_in, tgeneric, ti32, ti64, tu8, tf64, tbool, tstring_cstr,
  tstring_literal, tnamed, tnode, tslice, tvoid } = compiler.genc
{ impl_cname_in } = compiler.mangle
{ Allocator } = std.mem.alloc
{ is_empty } = std.text.str
{ xform_arm_env } = compiler.passes.subst
{ map_slice, param_names_has } = compiler.astops
{ VList, DeclIndex, bin_ty, common_ty, dispatch_recv_name, enum_name, gen_variant_payload,
  is_direct_tparam, is_lit_numeric, is_str_t, is_void_ty, is_weak_targ_arg, lookup_var,
  slice_member, ty_under_ptr, vcons } = compiler.check
{ loop_at } = std.core.count
light_sl_elem = (
    a: Allocator,
    items: MutSlice<Expr>,
    env: Ptr<VList>,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
) Ty { (items.len == 0).then({ tvoid() }, { items[0].addr().light_ty(a, env, decls, idx) }) }
light_slice = (
    a: Allocator,
    sd: SliceData,
    env: Ptr<VList>,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
) Ty {
    sd.elem.is_void_ty().match ({
        true  => tslice(a.tnode(a.light_sl_elem(sd.items, env, decls, idx))),
        false => tslice(a.tnode(sd.elem)),
    })
}
// Light call type mirrors infer_call for template-splice inference.
// `lits` mirrors targ_of: false scans only typed (non-literal) args, true only literals — the
// weakest binding source, consulted after the expected return type (see call_targ).
light_one = (
    params: MutSlice<Param>,
    a: Allocator,
    args: MutSlice<Expr>,
    tp: StringView,
    env: Ptr<VList>,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    lits: bool,
) Ty {
    found ::= tvoid()
    params.loop_at((i, p) {
        found = found.is_void_ty().match ({
            true  => (i < args.len && args[i].addr().is_lit_numeric() == lits).match ({
                true  => p.ty.unify_ty(args[i].addr().light_ty(a, env, decls, idx), tp),
                false => found,
            }),
            false => found,
        })
    })
    found
}
light_ret_one = (ret: Ty, exp: Ty, tp: StringView) Ty {
    exp.is_void_ty().then({ tvoid() }, { ret.unify_ty(exp, tp) })
}
light_targ = (
    f: Func,
    a: Allocator,
    args: MutSlice<Expr>,
    exp: Ty,
    tp: StringView,
    env: Ptr<VList>,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
) Ty {
    arg ::= f.params.light_one(a, args, tp, env, decls, idx, false)
    arg = arg.is_void_ty().then({ f.ret.light_ret_one(exp, tp) }, { arg })
    arg.is_void_ty().then({ f.params.light_one(a, args, tp, env, decls, idx, true) }, { arg })
}
light_targs = (
    f: Func,
    a: Allocator,
    args: MutSlice<Expr>,
    exp: Ty,
    env: Ptr<VList>,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
) MutSlice<Ty> {
    buf = map_slice(a, f.tparams, (tp) { f.light_targ(a, args, exp, tp.name, env, decls, idx) })
    a.deep_targs(f.tparams, buf, f.params, args, env, decls, idx)
}
light_call_ty = (
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    a: Allocator,
    c: CallData,
    env: Ptr<VList>,
) Ty {
    // conversion/size intrinsics (not in the decl index) mirror infer_call, so e.g. `to_i64(0)`
    // as a generic-call arg PINS that tparam instead of light-typing to void (need-annotation).
    (c.fn == "each_field" || c.fn == "zip_fields").then({
        return tvoid()
    })
    (c.fn == "field_eq").then({
        return tbool()
    })
    (c.fn == "variant_name").then({
        return tstring_literal()
    })
    (c.fn == "cstr").then({
        return tstring_cstr()
    })
    (c.fn == "to_i32").then({
        return ti32()
    })
    (c.fn == "to_i64" || c.fn == "sizeof").then({
        return ti64()
    })
    (c.fn == "to_u8").then({
        return tu8()
    })
    (c.fn == "to_f64").then({
        return tf64()
    })
    f = idx.idx_func(decls, c.fn)
    (f.tparams.len > 0).match ({
        true  => a.subst_ty_in(f.tparams, f.light_targs(a, c.args, tvoid(), env, decls, idx), f.ret),
        false => f.ret,
    })
}
light_last_stmt_ty = (
    a: Allocator,
    stmts: MutSlice<Stmt>,
    env: Ptr<VList>,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
) Ty {
    stmts[stmts.len - 1].match ({
        .ExprStmt(e) => e.light_ty(a, env, decls, idx),
        .Return(r)   => r.light_ty(a, env, decls, idx),
        _            => tvoid(),
    })
}
light_extend = (
    a: Allocator,
    env: Ptr<VList>,
    st: Stmt,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
) Ptr<VList> {
    st.match ({
        .Let(l) => a.vcons(l.name, l.ty.is_void_ty().match ({
            true  => l.value.light_ty(a, env, decls, idx),
            false => l.ty,
        }), env),
        _       => env,
    })
}
light_block_ty_from = (
    a: Allocator,
    stmts: MutSlice<Stmt>,
    env: Ptr<VList>,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    i: i32,
) Ty {
    (i >= stmts.len).match ({
        true  => tvoid(),
        false => (i == stmts.len - 1).match ({
            true  => a.light_last_stmt_ty(stmts, env, decls, idx),
            false => a.light_block_ty_from(stmts, a.light_extend(env, stmts[i], decls, idx), decls, idx, i + 1),
        }),
    })
}
// mirrors block_ty: a diverging value block (trailing explicit `return`) has no value type.
light_block_ty = (
    a: Allocator,
    b: BlockData,
    env: Ptr<VList>,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
) Ty {
    b.stmts.stmts_diverge().match ({
        true  => tvoid(),
        false => a.light_block_ty_from(b.stmts, env, decls, idx, 0),
    })
}
light_member_ty = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    obj: Ty,
    field: StringView,
) Ty {
    obj.ty_under_ptr().match ({
        .Generic(g) => idx.idx_genstruct_field(a, decls, g.name, field, g.args),
        .Slice(e)   => a.slice_member(field, e.kind),
        _           => idx.idx_struct_field(decls, obj.enum_name(), field),
    })
}
light_ty* = (
    e: Ptr<Expr>,
    a: Allocator,
    env: Ptr<VList>,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
) Ty {
    load(e).match ({
        .Int(n)        => ti32(),
        .Block(b)      => a.light_block_ty(b, env, decls, idx),
        .Byte(n)       => tu8(),
        .FloatLit(ft)  => tf64(),
        .StrLit(s)     => tstring_literal(),
        .MakeStruct(m) => (m.targs.len > 0).match ({
            true  => tgeneric(m.ty, m.targs, m.mty),
            false => tnamed(m.ty),
        }),
        .MakeEnum(mk)  => (mk.targs.len > 0).match ({
            true  => tgeneric(mk.ty, mk.targs, mk.mty),
            false => tnamed(mk.ty),
        }),
        .Tag(t)        => (t.targs.len > 0).match ({
            true  => tgeneric(t.ty, t.targs, t.mty),
            false => tnamed(t.ty),
        }),
        .SliceLit(sd)  => a.light_slice(sd, env, decls, idx),
        .Var(v)        => env.lookup_var(v.name),
        .Call(c)       => light_call_ty(decls, idx, a, c, env),
        .Member(m)     => a.light_member_ty(decls, idx, m.obj.light_ty(a, env, decls, idx), m.field),
        .Bin(b)        => bin_ty(b.op, b.lhs.light_ty(a, env, decls, idx)),
        .Cond(d)       => d.t
            .light_ty(a, env, decls, idx)
            .common_ty(d.e.light_ty(a, env, decls, idx)),
        .Match(m)      => a.light_match_ty(m, env, decls, idx),
        // resolve stamps `elem` on every Index (keep_elem), so an indexed receiver types without
        // re-deriving it from the sequence. Without this arm `cs[0].variant_name()` light-types to
        // void, vn_hook finds no variants and PRESERVES the call for a later template splice that
        // never comes in non-generic code — `zen check` passes and the link then fails on an
        // undefined reference to `variant_name`.
        .Index(ix)     => ix.elem,
        _              => tvoid(),
    })
}
// Forward inference through method chains: inlining a generic receiver leaves a Block whose tail is
// a Match (`good.map_err(f)` → `({ … r.match({…}) })`), so the NEXT call in the chain
// (`.expect(msg)`) must be able to light-type it or its tparams silently default to void. Fold the
// same safe join as full inference; taking the first arm makes string provenance depend on arm order.
light_match_ty = (
    a: Allocator,
    m: MatchData,
    env: Ptr<VList>,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
) Ty {
    st = m.subj.light_ty(a, env, decls, idx)
    found ::= tvoid()
    m.arms.loop_at((i, ar) {
        found = found.common_ty(ar.body.light_ty(a, a.xform_arm_env(decls, idx, st, m.ename, ar, env), decls, idx))
    })
    found
}
// Unify a param type against an arg type to infer one tparam.
unify_ty* = (pty: Ty, aty: Ty, tp: StringView) Ty {
    pty.match ({
        .Named(n)   => (n == tp).then({ aty }, { tvoid() }),
        .Generic(g) => aty.match ({
            .Generic(ga) => g.args.unify_args(ga.args, tp),
            _            => tvoid(),
        }),
        .Ptr(pd)    => aty.match ({
            .Ptr(pa) => load(pd.pointee).unify_ty(load(pa.pointee), tp),
            _        => tvoid(),
        }),
        .Slice(e)   => aty.match ({
            .Slice(ea) => load(e.pointee).unify_ty(load(ea.pointee), tp),
            _          => tvoid(),
        }),
        _           => tvoid(),
    })
}
unify_args = (pargs: MutSlice<Ty>, aargs: MutSlice<Ty>, tp: StringView) Ty {
    found ::= tvoid()
    pargs.loop_at((i, pa) {
        found = found.is_void_ty().match ({
            true  => (i < aargs.len).then({ pa.unify_ty(aargs[i], tp) }, { found }),
            false => found,
        })
    })
    found
}
// The declared payload type of variant `vn`, scanning every enum decl (concrete or generic).
variant_payload_ty = (decls: MutSlice<Decl>, vn: StringView) Ty {
    found ::= tvoid()
    decls.loop_at((i, d) {
        found = found.is_void_ty().match ({
            true  => d.match ({
                .DEnum(ed)   => ed.enum_variant_payload(vn),
                .DGenEnum(g) => g.gen_variant_payload(vn),
                _            => tvoid(),
            }),
            false => found,
        })
    })
    found
}
enum_variant_payload = (ed: EnumDecl, vn: StringView) Ty {
    found ::= tvoid()
    ed.variants.loop_at((i, v) { found = (v.name == vn).then({ v.payload }, { found }) })
    found
}
// Infer a lambda parameter's concrete type from a `.Variant(param)` constructor in the body: the
// variant declares the payload type (e.g. `Get(ReplyRef<i32>)`), so the param `(reply){...}` that is
// passed straight into `.Get(reply)` is ReplyRef<i32>. This lets a generic FnT param `(reply: ReplyRef<T>) R`
// recover T even with no return to flow it from — the actor ask/request inline-closure reply handler.
lam_param_payload = (decls: MutSlice<Decl>, body: MutSlice<Stmt>, pname: StringView) Ty {
    found ::= tvoid()
    body.loop_at((i, st) {
        found = found.is_void_ty().then({ decls.lpp_stmt(st, pname) }, { found })
    })
    found
}
lpp_stmt = (decls: MutSlice<Decl>, st: Stmt, pname: StringView) Ty {
    st.match ({
        .ExprStmt(e) => decls.lpp_expr(e, pname),
        .Return(r)   => decls.lpp_expr(r, pname),
        .Let(l)      => decls.lpp_expr(l.value, pname),
        .Assign(x)   => decls.lpp_expr(x.value, pname),
        _            => tvoid(),
    })
}
lpp_expr = (decls: MutSlice<Decl>, e: Ptr<Expr>, pname: StringView) Ty {
    load(e).match ({
        .MakeEnum(mk)   => decls.lpp_payload(mk.variant, mk.payload, pname),
        .Call(c)        => decls.lpp_args(c.args, pname),
        .MethodCall(mc) => decls.lpp_mcall(mc, pname),
        .Block(b)       => decls.lam_param_payload(b.stmts, pname),
        _               => tvoid(),
    })
}
lpp_payload = (
    decls: MutSlice<Decl>,
    variant: StringView,
    payload: Ptr<Expr>,
    pname: StringView,
) Ty {
    load(payload).match ({
        .Var(v) => (v.name == pname).then({ decls.variant_payload_ty(variant) }, { tvoid() }),
        _       => tvoid(),
    })
}
lpp_args = (decls: MutSlice<Decl>, args: MutSlice<Expr>, pname: StringView) Ty {
    found ::= tvoid()
    args.loop_at((i, ar) {
        found = found.is_void_ty().then({ decls.lpp_expr(ar.addr(), pname) }, { found })
    })
    found
}
lpp_mcall = (decls: MutSlice<Decl>, mc: MethodCallData, pname: StringView) Ty {
    r = decls.lpp_expr(mc.recv, pname)
    r.is_void_ty().then({ decls.lpp_args(mc.args, pname) }, { r })
}
// Unify a generic FnT param `(reply: ReplyRef<T>) R` against a lambda argument by inferring each lambda
// param's concrete type from its body (the `.Variant(param)` site that declares it).
lam_unify = (decls: MutSlice<Decl>, fpty: Ty, lm: LambdaData, tp: StringView) Ty {
    fpty.match ({
        .FnT(ft) => {
            found ::= tvoid()
            ft.params.loop_at((i, pt) {
                found = found.is_void_ty().match ({
                    true  => (i < lm.params.len).match ({
                        true  => pt.unify_ty(decls.lam_param_payload(lm.body, lm.params[i].name), tp),
                        false => found,
                    }),
                    false => found,
                })
            })
            // A tparam appearing ONLY in the closure's RETURN position `(value: T) U` binds from the lambda's
            // DECLARED return type (else it would default to void -> a `[void]` result, a silent miscompile).
            found.is_void_ty().match ({
                true  => lm.ret.is_void_ty().then({ found }, { load(ft.ret).unify_ty(lm.ret, tp) }),
                false => found,
            })
        },
        _        => tvoid(),
    })
}
// `lits` mirrors targ_of: numeric and string literal args are the weakest binding source.
weak_targ_light = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    pty: Ty,
    arg: Ptr<Expr>,
    tp: StringView,
    env: Ptr<VList>,
) bool {
    arg.is_weak_targ_arg()
        || pty.is_direct_tparam(tp) && arg.light_ty(a, env, decls, idx).is_str_t()
}
infer_one = (
    params: MutSlice<Param>,
    a: Allocator,
    cargs: MutSlice<Expr>,
    tp: StringView,
    env: Ptr<VList>,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    lits: bool,
) Ty {
    found ::= tvoid()
    params.loop_at((i, p) {
        found = found.is_void_ty().match ({
            true  => (i < cargs.len
                && a.weak_targ_light(decls, idx, p.ty, cargs[i].addr(), tp, env) == lits).match ({
                true  => a.unify_carg(decls, idx, p.ty, cargs[i].addr(), tp, env),
                false => found,
            }),
            false => found,
        })
    })
    found
}
// A lambda argument carries no inferrable value type (light_ty -> void); recover a tparam in its FnT
// param position from the lambda body instead. Other args unify against their light type as before.
unify_carg = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    pty: Ty,
    carg: Ptr<Expr>,
    tp: StringView,
    env: Ptr<VList>,
) Ty {
    load(carg).match ({
        .Lambda(lm) => decls.lam_unify(pty, lm, tp),
        _           => pty.unify_ty(carg.light_ty(a, env, decls, idx), tp),
    })
}
infer_one_exp = (
    params: MutSlice<Param>,
    ret: Ty,
    exp: Ty,
    a: Allocator,
    cargs: MutSlice<Expr>,
    tp: StringView,
    env: Ptr<VList>,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
) Ty {
    arg ::= params.infer_one(a, cargs, tp, env, decls, idx, false)
    arg = arg.is_void_ty().then({ ret.light_ret_one(exp, tp) }, { arg })
    arg.is_void_ty().then({ params.infer_one(a, cargs, tp, env, decls, idx, true) }, { arg })
}
// ── deep tparam fallbacks: two LAST-RESORT inference sources for a tparam that neither the value
//    args nor the expected type could bind (it would otherwise silently default to void → a
//    `Result<T,void>` mono whose union elides the member the ctor still writes → uncompilable C).
//    They run as a POST-pass over the full targ buffer so each can consult the tparams that DID bind.
// does `t` mention the type-param name `n` anywhere?
ty_mentions* = (t: Ty, n: StringView) bool {
    t.match ({
        .Named(x)   => x == n,
        .Generic(g) => g.args.tys_mention(n),
        .Ptr(pd)    => load(pd.pointee).ty_mentions(n),
        .Slice(e)   => load(e.pointee).ty_mentions(n),
        .FnT(ft)    => ft.params.tys_mention(n) || load(ft.ret).ty_mentions(n),
        _           => false,
    })
}
tys_mention = (ts: MutSlice<Ty>, n: StringView) bool {
    f ::= false
    ts.loop_at((i, t) { f = f || t.ty_mentions(n) })
    f
}
ty_mentions_any* = (t: Ty, tparams: MutSlice<Param>) bool {
    f ::= false
    tparams.loop_at((i, tp) { f = f || t.ty_mentions(tp.name) })
    f
}
// FALLBACK 1 — closure-return inference: a tparam that appears in an FnT param's RETURN position
// (`on_err: (error: E) F`) whose argument is an UNANNOTATED lambda binds from the lambda BODY's type: bind
// the lambda params to their (already-inferred-targ-substituted) declared types, light-type the body,
// and unify. Bails (void) if the body's type still mentions any tparam (nothing concrete was learned).
lam_body_targ = (
    a: Allocator,
    tparams: MutSlice<Param>,
    targs: MutSlice<Ty>,
    params: MutSlice<Param>,
    cargs: MutSlice<Expr>,
    tp: StringView,
    env: Ptr<VList>,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
) Ty {
    found ::= tvoid()
    params.loop_at((i, p) {
        found = found.is_void_ty().match ({
            true  => (i < cargs.len).match ({
                true  => a.lam_body_one(tparams, targs, p.ty, cargs[i].addr(), tp, env, decls, idx),
                false => found,
            }),
            false => found,
        })
    })
    found
}
lam_body_one = (
    a: Allocator,
    tparams: MutSlice<Param>,
    targs: MutSlice<Ty>,
    pty: Ty,
    carg: Ptr<Expr>,
    tp: StringView,
    env: Ptr<VList>,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
) Ty {
    pty.match ({
        .FnT(ft) => load(carg).match ({
            .Lambda(lm) => (lm.ret.is_void_ty() && load(ft.ret).ty_mentions(tp)).match ({
                true  => {
                    e2 ::= env
                    lm.params.loop_at((k, lp) {
                        e2 = a.vcons(lp.name, (k < ft.params.len).match ({
                            true  => a.subst_ty_in(tparams, targs, ft.params[k]),
                            false => tvoid(),
                        }), e2)
                    })
                    bty = a.light_block_ty_from(lm.body, e2, decls, idx, 0)
                    (bty.is_void_ty() || bty.ty_mentions_any(tparams)).match ({
                        true  => tvoid(),
                        false => load(ft.ret).unify_ty(bty, tp),
                    })
                },
                false => tvoid(),
            }),
            _           => tvoid(),
        }),
        _        => tvoid(),
    })
}
// FALLBACK 2 — trait-impl inference: a tparam that only names a generic TRAIT's type param
// (`spawn<A, M, ActorT>` returning `ActorHandle<M, ActorT>`, where the Receiver<M> trait ties M to
// the actor) binds from a CO-TARG's impl of that trait: ActorT bound Counter, and
// `Counter.impl(Receiver<Msg>)` solves M=Msg by unifying the trait's method declarations against the
// impl's concrete method signatures (the parser drops the written `<Msg>`, so the methods are the
// only place the instantiation survives). Solves only traits whose tparam NAME matches `tp`.
impl_trait_targ* = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    tparams: MutSlice<Param>,
    targs: MutSlice<Ty>,
    tp: StringView,
) Ty {
    found ::= tvoid()
    tparams.loop_at((i, x) {
        found = found.is_void_ty().match ({
            true  => a.impl_trait_targ_of(decls, idx, targs[i].dispatch_recv_name(), tp),
            false => found,
        })
    })
    found
}
impl_trait_targ_of = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    tyname: StringView,
    tp: StringView,
) Ty {
    is_empty(tyname).match ({
        true  => tvoid(),
        false => {
            found ::= tvoid()
            decls.loop_at((i, d) {
                found = found.is_void_ty().match ({
                    true  => d.match ({
                        .DImpl(im) => (im.ty == tyname).match ({
                            true  => a.impl_trait_solve(decls, idx, im, tp),
                            false => tvoid(),
                        }),
                        _          => tvoid(),
                    }),
                    false => found,
                })
            })
            found
        },
    })
}
impl_trait_solve = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    im: ImplData,
    tp: StringView,
) Ty {
    g = idx.idx_genstruct(decls, im.trname)
    (is_empty(g.name) || g.tparams.param_names_has(tp) == false).match ({
        true  => tvoid(),
        false => {
            found ::= tvoid()
            g.fields.loop_at((i, f) {
                found = found.is_void_ty().match ({
                    true  => a.impl_method_solve(decls, idx, im, f, tp),
                    false => found,
                })
            })
            found
        },
    })
}
impl_method_solve = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    im: ImplData,
    f: Field,
    tp: StringView,
) Ty {
    f.ty.match ({
        .FnT(ft) => {
            mf = idx.idx_func(decls, a.impl_cname_in(im.trname, im.ty, f.name))
            is_empty(mf.name).match ({
                true  => tvoid(),
                false => {
                    found ::= load(ft.ret).unify_ty(mf.ret, tp)
                    ft.params.loop_at((j, pt) {
                        found = found.is_void_ty().match ({
                            true  => (j < mf.params.len).match ({
                                true  => pt.unify_ty(mf.params[j].ty, tp),
                                false => found,
                            }),
                            false => found,
                        })
                    })
                    found
                },
            })
        },
        _        => tvoid(),
    })
}
// The post-pass driver: fill any still-void targ from fallback 1 then fallback 2, in tparam order
// (so a later fallback sees everything earlier ones bound).
deep_targs = (
    a: Allocator,
    tparams: MutSlice<Param>,
    buf: MutSlice<Ty>,
    params: MutSlice<Param>,
    cargs: MutSlice<Expr>,
    env: Ptr<VList>,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
) MutSlice<Ty> {
    tparams.loop_at((i, tp) {
        buf[i] = buf[i].is_void_ty().match ({
            true  => a.lam_body_targ(tparams, buf, params, cargs, tp.name, env, decls, idx),
            false => buf[i],
        })
    })
    tparams.loop_at((i, tp) {
        buf[i] = buf[i].is_void_ty().match ({
            true  => a.impl_trait_targ(decls, idx, tparams, buf, tp.name),
            false => buf[i],
        })
    })
    buf
}
// etargs = explicit turbofish type args: a present one PINS the i-th tparam (overriding inference),
// an absent one (i past etargs) is inferred from value args / expected type as before.
infer_targs* = (
    a: Allocator,
    tparams: MutSlice<Param>,
    params: MutSlice<Param>,
    ret: Ty,
    exp: Ty,
    cargs: MutSlice<Expr>,
    env: Ptr<VList>,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    etargs: MutSlice<Ty>,
) MutSlice<Ty> {
    buf ::= cbuf<Ty>(a, tparams.len)
    tparams.loop_at((i, tp) {
        buf[i] = (i < etargs.len).match ({
            true  => etargs[i],
            false => params.infer_one_exp(ret, exp, a, cargs, tp.name, env, decls, idx),
        })
    })
    a.deep_targs(tparams, buf, params, cargs, env, decls, idx)
}
