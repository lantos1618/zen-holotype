// A BLOCK-BODIED ARM NEED NO COMMA before the next arm.
//
// Issue #770: `./zen` has always parsed the comma-less spelling --
// parse_match.zen eats each arm's separator with `p.eat`, so an arm owns
// its comma and may omit it -- while grammar/match_block demanded one and
// reddened `make parse` on files written in this legal shape. This file
// pins the compiler-legal spelling in the one suite BOTH parsers read:
// tests/run.py compiles it, `make parse`/grammar_test.py run tree-sitter
// over it, so the two cannot drift apart here again without a red gate
// naming this file.
//
// The value proves the DISPATCH as well as the parse: the taken arm adds
// 42 to `good`, the untaken one would have printed instead of added, and
// the total is printed rather than returned -- `Ok(good)` would leave as
// the exit code, which the runner reads, not as stdout. A lowering that
// ran the wrong arm or dropped the block's assignment prints a number
// other than 42. The comma after the second arm stays, so what is under
// test is exactly the separator between two block-or-call bodies.

main = (env: Env) Res<i32, ArgError> {
    good ::= 0;
    (6 == 6).match({
        true  => { good = good + 6 * 7; }
        false => println("lost an ascii byte"),
    });
    println("{}", good);
    Ok(0);
}
