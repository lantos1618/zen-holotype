// the use sits on an arm that can never be taken: `0 == 1` is false
// for every run of this program. it is STILL an error.
//
// the checker is flow-sensitive, not path-sensitive: it follows the
// shape of the control flow graph and never evaluates a condition to
// decide an edge is dead. anything else makes acceptance depend on
// how clever constant folding was that day.

Buf = {
    id: i32,
}

Buf.impl(Drop, {
    drop = (self :: @Self) () { /* nothing to release: id is bytes */ }
})

main = (env: Env) Res<i32, IoError> {
    f = Buf(id: 1);
    g = consume f;
    n = (0 == 1).match({
        true  => f.id,
        false => 0,
    })
    println("{}", n);
    println("{}", g.id);
    Ok(0);
}
