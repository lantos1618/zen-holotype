// a struct containing itself by value has no finite size. it must be
// rejected with a diagnostic, and the layout query must not loop.
// `next: Ptr<Node>` is the legal form -- corpus/sema/recursive_type_ptr.
//
// position: the field whose type is the struct being declared.

Node = {
    value: i32,
    next: Node,
}

main = (env: Env) Res<i32, AllocError> {
    Ok(0);
}
