// Durable state for documents currently owned by the editor.
{ Allocator } = std.mem.alloc
{ memcpy } = std.c.libc
{ view } = std.text.str
{ then } = std.core.bool
{ loop_at } = std.core.count
LspDoc: {
    uri: StringView,
    text: StringView,
    tokens: StringView,
    version: i64,
    tok_version: i64,
}
LspDocs*: {
    alloc: Allocator,
    buf: [LspDoc],
    n: i64,
    deinit = (docs: MutPtr<LspDocs>) void { lspd_deinit(docs) }
}
lspd_none = () [LspDoc] { slice(null_ptr(), 0) }
lspd_init* = (alloc: Allocator) LspDocs {
    LspDocs(
        alloc: alloc,
        buf: lspd_none(),
        n: 0,
    )
}
lspd_alloc = (docs: MutPtr<LspDocs>, n: i64) [LspDoc] {
    slice(assert_nonnull(docs.alloc.acquire(n * sizeof(LspDoc))), n)
}
lspd_grow = (docs: MutPtr<LspDocs>) void {
    (docs.n >= docs.buf.len).then({
        grown ::= docs.lspd_alloc((docs.buf.len < 4).then({ 4 }, { docs.buf.len * 2 }))
        old = docs.buf.ptr
        docs.buf.loop_at((i, d) { grown[i] = d })
        docs.buf = grown
        (old != null_ptr()).then({
            docs.alloc.release(old)
        })
    })
}
lspd_own = (docs: MutPtr<LspDocs>, s: StringView) StringView {
    v: Slice<u8> = s.view()
    (v.len == 0).match ({
        true  => "",
        false => {
            p = docs.alloc.acquire(v.len + 1)
            (p == null_ptr()).match ({
                true  => "",
                false => {
                    memcpy(p, v.ptr, v.len)
                    p.offset(v.len).store(0)
                    cstr(p)
                },
            })
        },
    })
}
lspd_release = (docs: MutPtr<LspDocs>, s: StringView) void {
    (s.view().len > 0).then({
        docs.alloc.release(s.offset(0))
    })
}
lspd_free_entry = (docs: MutPtr<LspDocs>, i: i64) void {
    d = docs.buf[i]
    docs.lspd_release(d.uri)
    docs.lspd_release(d.text)
    docs.lspd_release(d.tokens)
}
lspd_scan = (docs: MutPtr<LspDocs>, i: i64, uri: StringView) i64 {
    (i >= docs.n).match ({
        true  => 0 - 1,
        false => (docs.buf[i].uri == uri).then({ i }, { docs.lspd_scan(i + 1, uri) }),
    })
}
lspd_find* = (docs: MutPtr<LspDocs>, uri: StringView) i64 { docs.lspd_scan(0, uri) }
lspd_text_at* = (docs: MutPtr<LspDocs>, i: i64) StringView { docs.buf[i].text }
lspd_tokens_at* = (docs: MutPtr<LspDocs>, i: i64) StringView {
    d = docs.buf[i]
    (d.tok_version == d.version).then({ d.tokens }, { "" })
}
lspd_set* = (docs: MutPtr<LspDocs>, uri: StringView, text: StringView, version: i64) i64 {
    i = docs.lspd_find(uri)
    fresh = LspDoc(
        uri: docs.lspd_own(uri),
        text: docs.lspd_own(text),
        tokens: "",
        version: version,
        tok_version: 0 - 1,
    )
    (i < 0).match ({
        true  => {
            docs.lspd_grow()
            docs.buf[docs.n] = fresh
            docs.n = docs.n + 1
            docs.n - 1
        },
        false => {
            docs.lspd_free_entry(i)
            docs.buf[i] = fresh
            i
        },
    })
}
lspd_cache_tokens* = (docs: MutPtr<LspDocs>, i: i64, toks: StringView) void {
    d = docs.buf[i]
    owned = docs.lspd_own(toks)
    docs.lspd_release(d.tokens)
    docs.buf[i] = LspDoc(
        uri: d.uri,
        text: d.text,
        tokens: owned,
        version: d.version,
        tok_version: d.version,
    )
}
lspd_close* = (docs: MutPtr<LspDocs>, uri: StringView) void {
    i = docs.lspd_find(uri)
    (i >= 0).then({
        docs.lspd_free_entry(i)
        docs.buf[i] = docs.buf[docs.n - 1]
        docs.n = docs.n - 1
    })
}
lspd_deinit = (docs: MutPtr<LspDocs>) void {
    live: [LspDoc] = slice(docs.buf.ptr, docs.n)
    live.loop_at((i, d) { docs.lspd_free_entry(i) })
    (docs.buf.ptr != null_ptr()).then({
        docs.alloc.release(docs.buf.ptr)
    })
    docs.buf = lspd_none()
    docs.n = 0
}
