// src/lsp/lsp_fmt.zen
// `textDocument/formatting` reuses the formatter used by `zen fmt` and
// returns at most one whole-document edit. Invalid or incomplete source,
// an unfaithful render, and an already-formatted buffer all return `[]` so
// the editor leaves the document unchanged.

str, String = std.text
Alloc, AllocError = std.mem
scan, Source, Lexed = std.lex
render = fmt.fmt
write_whole = lsp.lsp_pos
obj, arr = std.json

// Format the editor's current buffer, including unsaved changes.
write_edits* = (a: Alloc, text: str, out :: String) Res<(), AllocError> {
    lexed = scan(a, Source(file: "doc", text: text)).try();
    lexed.is_clean().match({
        false => no_edits(out),
        true  => rendered(a, text, lexed, out),
    })
}

// Do not emit a no-op edit: clients may move the cursor or mark the document
// dirty even when replacement text is identical.
rendered = (a: Alloc, text: str, lexed: Lexed, out :: String)
           Res<(), AllocError> {
    shaped = render(a, lexed).try();
    (shaped.diags.len == 0
        && shaped.faithful
        && !text.eq(shaped.text.view())).match({
        false => no_edits(out),
        true  => whole_edit(text, shaped.text.view(), out),
    })
}

no_edits = (out :: String) Res<(), AllocError> {
    out.add("[]")
}

// The replacement range is measured against the original buffer.
whole_edit = (text: str, shaped: str, out :: String) Res<(), AllocError> {
    edits ::= arr(out).try();
    edits.next(out).try();
    edit ::= obj(out).try();
    edit.key("range", out).try();
    write_whole(text, out).try();
    edit.text("newText", shaped, out).try();
    edit.close(out).try();
    edits.close(out)
}
