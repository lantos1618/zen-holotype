// tests/corpus/std/display_nesting_reuses_the_buffer.zen
// nesting never allocates: Line's toString hands its own buffer
// down to Point's, so the whole tree is written into the single
// String main made. an inner toString that allocated would still
// print this, which is why the bench next door counts allocs

Error = AllocError | IoError

Point = {
    x: i32,
    y: i32,
}

Point.impl(Display, {
    toString ::= (self: @Self, out :: Sink) Res<(), WriteError> {
        out.fmt("{}:{}", self.x, self.y)
    }
})

Line = {
    a: Point,
    b: Point,
}

Line.impl(Display, {
    toString ::= (self: @Self, out :: Sink) Res<(), WriteError> {
        out.fmt("line ").try();
        self.a.toString(out).try();
        out.fmt(" -> ").try();
        self.b.toString(out).try();
        Ok(());
    }
})

main = (env: Env) Res<i32, Error> {
    alloc ::= env.mem.alloc();
    sb    ::= alloc.String("").try();

    line = Line(a: Point(x: 1, y: 2), b: Point(x: 3, y: 4));
    line.toString(sb).try();

    println("{}", sb.view());

    direct ::= alloc.String("").try();
    Point(x: 1, y: 2).toString(direct).try();
    direct.add(" and ").try();
    Point(x: 3, y: 4).toString(direct).try();
    println("{}", direct.view());
    Ok(0);
}
