// module `gamma` — the shared types.
//
// `alpha`, `beta` and `delta` all instantiate `Box` from here, at three
// different types, and one of those types (`Item`) also lives here. That is
// DESIGN.md's reason for whole-program compilation stated as a fixture:
// nothing about `Box<Item>` belongs to alpha or to gamma, so wherever
// gen_c decides to emit it, the decision must not depend on which module
// it happened to reach first.

Item* = {
    id: i32,
    label: str
}

Box*<T> = {
    value: T
}

Kind* = Small(i32) | Large(i32) | Plain

name* = () str { "gamma" }

marker* = () str { "gamma marker" }

weight* = (k: Kind) i32 {
    k.match({
        Small(n) => n,
        Large(n) => n * 2,
        Plain => 0,
    });
}
