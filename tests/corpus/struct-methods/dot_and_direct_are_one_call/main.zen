// THE DIRECT CALL AND THE DOT CALL ARE THE SAME FUNCTION: `f(x)` spelled
// with an explicit import binding and `x.f()` reached through the type
// both land on one body, and their answers agree.
//
// DESIGN.md splits the two halves of name visibility apart -- a BARE name
// needs its import ("a name that is not imported is not visible"), while
// `x.f(..)` "never names f" and so travels with the type unimported. The
// subtle wrong implementation resolves each spelling through a different
// mechanism and they disagree: the dot finds the free function, the bare
// call misses it (or vice versa), or the two spellings bind to two
// different symbols and only one of them runs. Both lines must answer
// identically because there is only one function to answer.
//
// Breaks if: the imported-binding form of an exported UFCS function
// resolves to a different (or no) symbol than the dot form -- either line
// changes.

Box = box.box
perimeter = box.box

main = (env: Env) Res<i32, AllocError> {
    b = Box(w: 3, h: 4);
    println("dot    {}", b.perimeter());
    println("direct {}", perimeter(b));
    Ok(0);
}
