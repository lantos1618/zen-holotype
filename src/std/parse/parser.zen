// src/std/parse/parser.zen
// Shared parser state: cursor, AST, diagnostics, trivia ownership, and depth.
// Syntax errors append diagnostics and poison nodes so parsing can continue;
// allocation failure is the only returned failure.

Alloc, AllocError = std.mem
Ast = std.ast.ast_arena
Span, Pos, Trivia, TriviaKind, TriviaRun, no_trivia, Ident = std.ast.ast_span
Token, TokenKind, Source, Lexed, is_trivia, text_of, empty_eof = std.parse.parse_token
Diag, diag, diag_at, truncated = std.parse.parse_diag

// Shared nesting limit for recursive parser, sema, and codegen walks. Binary
// spines are iterative and therefore do not consume this budget.
MAX_DEPTH*: usize = 304

// A node, opened. The two facts that are true at a node's first token
// and false one token later: where it begins, and what trivia stood
// before it. One value and not two parameters, because a parse
// function taking a `Pos` and a `TriviaRun` separately is one someone
// will one day hand the wrong pair.
Mark* = {
    start*: Pos,
    leading*: TriviaRun,

    // The same position with the trivia given away. A node built
    // AROUND another one — a `Binary` over its left operand, a `Call`
    // over its callee — starts at the same token, and only one of them
    // may own the run or the formatter prints the comment twice. The
    // inner node has it; this is how the outer one says so.
    //
    // That is the right way round: an expression is never the outermost
    // node at its own first token (a statement, argument, arm or field
    // always opened before it), so the run is empty wherever the
    // distinction is visible, and where it is not empty — an array
    // element, which has no wrapper node — the innermost IS the element.
    bare* = (self: @Self) Mark {
        Mark(start: self.start, leading: no_trivia())
    }
}

Parser* = {
    tokens: Vec<Token>,

    // The bytes the tokens were cut from. A token is a kind and a span
    // and carries no text (`lex_token.zen`: a `str` on every token of a
    // ten-megabyte file holds what both ends of the span already name),
    // so the parser holds the Source and slices it where a name or a
    // literal needs its bytes.
    source*: Source,

    // Always the index of a NON-trivia token. Everything between the
    // previous token and this one has already been drained into
    // `tree.trivia` and named by `pending`.
    at* :: usize = 0,

    // The tree being built, and the reason a caller constructs a Parser
    // rather than calling a parse function with an `Ast`: a Vec is a
    // header of its own, so a copy of an `Ast` diverges from the
    // original the first time either grows. Read back as `p.tree`.
    tree* :: Ast,

    diags* :: Vec<Diag>,

    // Where the last token consumed ended: the second half of a node's
    // `start_of(first) .. end_of(last)` span, half-open.
    prev_end* :: Pos = Pos(line: 1, col: 1),

    // The line the last token passed ended on. A blank line is a gap
    // between two spans and nothing else, so this is the whole of the
    // state that measuring one needs.
    gap_line :: usize = 1,

    // The trivia gathered before `at`, unclaimed. A node beginning at
    // this token takes it; the first one to ask is the OUTERMOST,
    // because recursive descent enters outside-in, which is exactly
    // AST_CONTRACT.md's ownership rule.
    pending :: TriviaRun,

    // The depth guard. `anchor` is the outermost construct of the
    // current run — set as depth leaves `run_base` — because a
    // diagnostic pointing at level 257 of a 10,000-deep file names the
    // one place the author cannot see the problem from.
    //
    // A RUN STARTS INSIDE A BODY AND NOT AT IT: a function's body is
    // the function, not a level within it, so the outermost bracket of
    // `main = () { {{{{ .. }}}} }` is the first `{` on the statement
    // and not `main`'s own. A body is the only thing that moves
    // `run_base`; an ordinary nested block is a level like any other,
    // which keeps the anchor on the first of ten thousand braces.
    depth :: usize = 0,
    run_base :: usize = 0,
    anchor :: Span,
    too_deep* :: bool = false,

    // Whether a diagnostic has been reported since the last statement
    // or declaration boundary. See `hushed`.
    said :: bool = false,

    alloc*: Alloc,

    // -----------------------------------------------------------------
    // looking
    // -----------------------------------------------------------------

    // The token under the cursor. Past the end this is the `Eof` the
    // lexer promised, forever, so no loop below needs a length check.
    peek* = (self: @Self) Token {
        self.tokens.get(self.at).match({
            Ok(t) => t,
            None  => self.eof_token(),
        });
    }

    // The text under the cursor. Two questions need it: is this
    // identifier the wildcard `_`, and is this method call `.impl(`.
    at_text* = (self: @Self, want: str) bool {
        self.at_kind(TokenKind.Ident) && self.text(self.peek()) == want
    }

    // What a cursor past the end reads. `scan` promises exactly one
    // `Eof`, last, so this is that token — but trapping on an empty
    // stream would crash on a bug somewhere else, so an empty one
    // reads position zero and gets a `None` turned into `Eof`.
    eof_token = (self: @Self) Token {
        (self.tokens.len == 0).match({
            true  => empty_eof(),
            false => self.last_token(),
        });
    }

    last_token = (self: @Self) Token {
        self.tokens.get(self.tokens.len - 1).match({
            Ok(t) => t,
            None  => empty_eof(),
        });
    }

    // The lexer's `Span` carries no `file` and its `Pos` carries a byte
    // `offset`; an AST node's `Span` carries the file and no offset.
    // Both are right — a token belongs to one Source and a node
    // outlives it — so the conversion happens HERE, once, and nothing
    // downstream sees two span types.
    span_of* = (self: @Self, t: Token) Span {
        Span(
            file: self.source.file,
            start: Pos(line: t.span.start.line, col: t.span.start.col),
            end: Pos(line: t.span.end.line, col: t.span.end.col),
        );
    }

    // A token's bytes: quotes, escapes and comment markers included,
    // exactly as written. `Literal.text` is specified as the raw source
    // slice, because the formatter reprints it byte for byte.
    text* = (self: @Self, t: Token) str { text_of(self.source, t) }

    // One non-trivia token further on. Two grammatical decisions need
    // it: `name:` versus `name =` inside a record body, and `Name`
    // versus `Name(` in a pattern.
    peek_next* = (self: @Self) Token { self.peek_n(1) }

    // The `n`th non-trivia token from the cursor, `0` being the cursor
    // itself. Three is the deepest anything asks — `A . impl (` — and
    // it is asked once per declaration, so a scan is cheaper than a
    // second index to keep in agreement.
    peek_n* = (self: @Self, n: usize) Token {
        found ::= self.eof_token();
        seen  ::= 0;
        Range(self.at, self.tokens.len).loop((h, k) {
            t = self.token_at(k);
            t.kind.is_trivia().match({
                true  => (),
                false => (seen == n).match({
                    true  => { found = t; h.break(); },
                    false => { seen = seen + 1; },
                }),
            });
        });
        found;
    }

    // The stream, by index, for the bounded scans that decide the three
    // ambiguities. They look at kinds and never at the cursor, so they
    // are the one thing here that reads past `at`.
    tokens_len* = (self: @Self) usize { self.tokens.len }

    token_kind_at* = (self: @Self, k: usize) TokenKind {
        self.tokens.get(k).match({
            Ok(t) => t.kind,
            None  => TokenKind.Eof,
        });
    }

    at_kind* = (self: @Self, kind: TokenKind) bool {
        self.peek().kind == kind
    }

    at_eof* = (self: @Self) bool { self.at_kind(TokenKind.Eof) }

    here_span* = (self: @Self) Span { self.span_of(self.peek()) }

    here* = (self: @Self) Pos { self.here_span().start }

    // A node's span, closed. `start` was taken before its first token
    // was consumed; `prev_end` is where its last one ended.
    span_from* = (self: @Self, start: Pos) Span {
        Span(file: self.source.file, start: start, end: self.prev_end)
    }

    // Open a node: where it starts, and the trivia that came before it.
    // Taken FIRST — both are facts about the token the node begins at,
    // and consuming it destroys them. Every node in this folder is
    // opened with one of these and closed with the matching `add_*`.
    open* = (self :: @Self) Mark {
        Mark(start: self.here(), leading: self.claim_leading())
    }

    // The identifier under the cursor, or a diagnostic and an empty one.
    // Empty rather than absent: a declaration with no readable name is
    // still a declaration, and dropping it loses every node inside it.
    ident* = (self :: @Self, message: str) Res<Ident, AllocError> {
        self.at_kind(TokenKind.Ident).match({
            true  => self.ident_here(),
            false => self.ident_missing(message),
        });
    }

    ident_here = (self :: @Self) Res<Ident, AllocError> {
        span  = self.here_span();
        token = self.bump().try();
        Ok(Ident(text: self.text(token), span: span));
    }

    ident_missing = (self :: @Self, message: str) Res<Ident, AllocError> {
        self.error_at(message, self.gap_span()).try();
        Ok(Ident(text: "", span: self.empty_span()));
    }

    // Consume one token and say nothing. What recovery is made of.
    skip* = (self :: @Self) Res<(), AllocError> {
        self.bump().try();
        Ok(());
    }

    // Success, spelled with its error type.
    //
    // BOOTSTRAPPER BUG, reported with a reproducer: `Ok(())` alone is a
    // `Res<()>`, a DIFFERENT TYPE from `Res<(), AllocError>`, so a
    // `.match` whose every arm is a bare `Ok(())` is typed without an
    // error channel. `.try()`ing that inside a function that has one
    // emits C reading an `Err` field off a struct with no such field,
    // and nothing says so until `cc` does. So every arm meaning
    // "nothing to do here" says which `Res` it is.
    nothing* = (self: @Self) Res<(), AllocError> { Ok(()) }

    // An empty span at the cursor, for a poison node: it stands where
    // the missing construct would have stood and covers no bytes, so
    // nothing downstream mistakes it for source the author wrote.
    empty_span* = (self: @Self) Span {
        here = self.here();
        Span(file: self.source.file, start: here, end: here);
    }

    // WHERE A MISSING TOKEN GOES, which is not where the parser found
    // out it was missing. `(x == 0).then(() { x = 1 })` wants a `;`
    // after the `1`; a caret on the `}` names the one token on the line
    // that is fine. Same rule as `expect_close` in the other direction:
    // anchor on a position someone can put a cursor on and type the
    // fix. It matters most at the end of a line, where the next token
    // is on the NEXT one — a trailing `|` on line 15 reported at 16:1
    // names a line the author did not write.
    gap_span* = (self: @Self) Span {
        Span(file: self.source.file, start: self.prev_end, end: self.prev_end)
    }

    // -----------------------------------------------------------------
    // moving
    // -----------------------------------------------------------------

    // Consume the current token and drain the trivia behind it.
    // Draining EAGERLY is what makes trailing trivia expressible: a
    // node that has just finished needs to know whether a comment
    // follows it on the same line, and it cannot ask about tokens it
    // has not reached.
    bump* = (self :: @Self) Res<Token, AllocError> {
        token         = self.peek();
        self.prev_end = self.span_of(token).end;
        self.gap_line = token.span.end.line;
        self.at       = self.at + 1;
        self.drain().try();
        Ok(token);
    }

    // Move onto the next non-trivia token, recording everything passed
    // over. Called after every bump, and once before the first.
    drain* = (self :: @Self) Res<(), AllocError> {
        mark = self.tree.trivia_mark();
        stop ::= self.tokens.len;
        Range(self.at, self.tokens.len).loop((h, k) {
            t = self.token_at(k);
            t.kind.is_trivia().match({
                true  => self.keep_trivia(t),
                false => { stop = k; h.break(); self.nothing() },
            }).try();
            self.gap_line = t.span.end.line;
        });
        self.blank_before(self.token_at(stop)).try();
        self.at      = stop;
        self.pending = self.tree.trivia_run(mark);
        Ok(());
    }

    token_at = (self: @Self, k: usize) Token {
        self.tokens.get(k).match({
            Ok(t) => t,
            None  => self.eof_token(),
        });
    }

    keep_trivia = (self :: @Self, t: Token) Res<(), AllocError> {
        self.blank_before(t).try();
        self.tree.add_trivia(Trivia(
            kind: t.kind.trivia_kind(),
            text: self.text(t),
            span: self.span_of(t),
        ));
    }

    // A BLANK LINE IS DERIVED, NOT LEXED: whitespace "is recoverable
    // exactly from the gap between two spans, and 'was there a blank
    // line here' is `next.start.line > prev.end.line + 1` rather than a
    // stored fact that can go stale."
    //
    // Measured here, once, at the only place that cares: the formatter
    // must not silently delete a blank line the author wrote, and
    // `TriviaKind.Blank` is where it survives. One `Blank` stands for a
    // run however long — collapsing them is a formatting rule.
    blank_before = (self :: @Self, t: Token) Res<(), AllocError> {
        (t.span.start.line > self.gap_line + 1).match({
            true  => self.keep_blank(t),
            false => self.nothing(),
        });
    }

    keep_blank = (self :: @Self, t: Token) Res<(), AllocError> {
        self.tree.add_trivia(Trivia(
            kind: TriviaKind.Blank,
            text: "",
            span: Span(
                file: self.source.file,
                start: Pos(line: self.gap_line + 1, col: 1),
                end: Pos(line: t.span.start.line, col: 1),
            ),
        ));
    }

    // Consume `kind` if it is here — an optional comma, an optional
    // `*`, an optional return type.
    eat* = (self :: @Self, kind: TokenKind) Res<bool, AllocError> {
        self.at_kind(kind).match({
            true  => { self.bump().try(); Ok(true) },
            false => Ok(false),
        });
    }

    // Consume `kind` or say so, once, in the caller's words — only the
    // caller knows what was being built: "expected `=>` after this
    // arm's pattern" is a sentence "expected FatArrow" cannot become.
    expect* = (self :: @Self, kind: TokenKind, message: str) Res<bool, AllocError> {
        self.at_kind(kind).match({
            true  => self.took(),
            false => self.missed(message),
        });
    }

    // Separate typed arms keep the result type explicit.
    took = (self :: @Self) Res<bool, AllocError> {
        self.bump().try();
        Ok(true);
    }

    missed = (self :: @Self, message: str) Res<bool, AllocError> {
        self.error(message).try();
        Ok(false);
    }

    // `expect`, anchored where the missing token GOES rather than on
    // the token that arrived instead. Not every `expect` wants this: a
    // missing `=>` is best reported on the expression that turned up
    // where the arrow belonged, because that IS what the reader has to
    // look at. A missing `;` is the other case.
    expect_after* = (self :: @Self, kind: TokenKind, message: str) Res<bool, AllocError> {
        self.at_kind(kind).match({
            true  => self.took(),
            false => self.missed_after(message),
        });
    }

    missed_after = (self :: @Self, message: str) Res<bool, AllocError> {
        self.error_at(message, self.gap_span()).try();
        Ok(false);
    }

    // Consume a closing delimiter, or point at the OPENING one. The
    // author's mistake is the `(` they never closed; the end of the
    // file is merely where the parser found out. Anchoring on the
    // opener turns "unexpected end of file" into a position someone can
    // put a cursor on.
    expect_close* = (self :: @Self, kind: TokenKind, message: str, open: Span) Res<bool, AllocError> {
        self.at_kind(kind).match({
            true  => self.took(),
            false => self.unclosed(message, open),
        });
    }

    unclosed = (self :: @Self, message: str, open: Span) Res<bool, AllocError> {
        self.hushed().match({
            true  => self.nothing(),
            false => { self.said = true; self.diags.add(diag_at(
                message,
                open,
                "the parser gave up here",
                self.here_span(),
            )) },
        }).try();
        Ok(false);
    }

    // -----------------------------------------------------------------
    // complaining
    // -----------------------------------------------------------------

    // One diagnostic, at the cursor. Every syntax error goes through
    // here or through `expect_close`, so "how many diagnostics did one
    // mistake produce" is a question about this file and nowhere else.
    error* = (self :: @Self, message: str) Res<(), AllocError> {
        self.error_at(message, self.here_span())
    }

    error_at* = (self :: @Self, message: str, span: Span) Res<(), AllocError> {
        self.hushed().match({
            true  => self.nothing(),
            false => self.say(message, span),
        });
    }

    // WHICH SENTENCE a rejection carries is `parse_diag.zen`'s, not
    // this file's — including the one case where the caller's is
    // overridden, a file that simply stopped. `truncated` is that whole
    // rule.
    say = (self :: @Self, message: str, span: Span) Res<(), AllocError> {
        self.said = true;
        self.diags.add(diag(
            truncated(message, span, self.at_eof(), self.here_span().start),
            span,
        ));
    }

    // Suppress follow-on diagnostics while unwinding a depth refusal or after
    // the first syntax error in a statement. `resume` ends that containment.
    hushed = (self: @Self) bool { self.too_deep || self.said }

    // A statement or a declaration boundary: whatever the parser reads
    // next stands on its own, so the next mistake is a new one.
    resume* = (self :: @Self) () { self.said = false; }

    // -----------------------------------------------------------------
    // trivia
    //
    // The parser decides ownership once; everything downstream reads
    // it. AST_CONTRACT.md fixes both rules; this implements them.
    // -----------------------------------------------------------------

    // The run gathered before the current token, claimed by the first
    // node to ask. Recursive descent enters outside-in, so the first
    // asker IS the outermost node beginning at that token — which is
    // why a file's opening comments belong to the declaration and not
    // to its name.
    //
    // PRECONDITION: call at ENTRY, before consuming anything. A node
    // that claims after consuming a token claims the wrong run.
    claim_leading* = (self :: @Self) TriviaRun {
        run          = self.pending;
        self.pending = no_trivia();
        run;
    }

    // The comment that follows a node on its own line. Only the nodes a
    // list or a body separates — field, parameter, variant, arm,
    // statement, declaration — ask for this, which is AST_CONTRACT.md's
    // "the outermost node whose span ends before it on that line" made
    // decidable: those are exactly the nodes that finish last on their
    // line.
    //
    // Takes ONE piece off the front of the pending run, so the run
    // stays contiguous and the next node's leading trivia begins where
    // this left off.
    claim_trailing* = (self :: @Self, end: Pos) TriviaRun {
        (self.pending.len == 0).match({
            true  => no_trivia(),
            false => self.claim_trailing_at(end),
        });
    }

    claim_trailing_at = (self :: @Self, end: Pos) TriviaRun {
        first     = self.tree.trivia_at(self.pending, 0);
        same_line = first.span.start.line == end.line;
        comment   = first.kind.match({
            Blank => false,
            _     => true,
        });
        (same_line && comment).match({
            true  => {
                taken        = TriviaRun(at: self.pending.at, len: 1);
                self.pending = TriviaRun(
                    at: self.pending.at + 1,
                    len: self.pending.len - 1
                );
                taken;
            },
            false => no_trivia(),
        });
    }

    // Everything left at end of file. It has nowhere else to go, and a
    // formatter that drops it fails its own round trip.
    claim_rest* = (self :: @Self) TriviaRun { self.claim_leading() }

    // A block's closing brace, claimed by the block the brace closes.
    //
    // A block is the one node whose last act is consuming a delimiter
    // of its own — a statement ends at `;` or at its value, and it is
    // the enclosing block that moves past either; a block ends AT its
    // `}` and must move past it itself. The comment between the last
    // statement (or, in a bare block or closure body, the opening
    // `{`) and that `}` sits in `pending` while the body is read: no
    // statement begins there to claim it as leading, no statement has
    // ended there to claim it as trailing, and bumping the brace
    // without claiming first would drain the run PAST the comment and
    // overwrite pending with one starting beyond it — the comment
    // owned by nobody, found by walking every run of every node
    // against the arena.
    //
    // So the block claims what stands before its own closing token,
    // exactly as `Module.trailing` owns what stands before end of
    // file: nowhere else for it to go, and a formatter that drops it
    // fails its own round trip. AST_CONTRACT.md names this rule
    // beside the other three.
    claim_close* = (self :: @Self) TriviaRun { self.claim_leading() }

    // -----------------------------------------------------------------
    // depth
    //
    // A crash is not a diagnostic. Every recursive entry point in this
    // folder brackets itself with these two and checks `too_deep`
    // before recursing again, which unwinds a 10,000-deep file instead
    // of riding it into the stack guard.
    //
    // Depth counts AST links, including links built by postfix loops, because
    // later phases recursively walk the resulting tree. `unwind` releases
    // loop-charged links one at a time.
    // -----------------------------------------------------------------

    enter* = (self :: @Self) Res<(), AllocError> {
        (self.depth == self.run_base).match({
            true  => { self.anchor = self.here_span(); self.nothing() },
            false => self.nothing(),
        }).try();
        self.depth = self.depth + 1;
        (self.depth > MAX_DEPTH && !self.too_deep).match({
            true  => {
                self.too_deep = true;
                self.diags.add(diag(
                    "nesting too deep: this construct nests deeper than the parser reads",
                    self.anchor,
                )).try();
                Ok(());
            },
            false => self.nothing(),
        });
    }

    // A body opened, and the depth a run inside it counts from. The
    // pair is a caller's to hold because a body is recognised by its
    // CALLER — `fn_body`, a lambda's — and nowhere else: to `block`
    // every brace looks alike.
    run_from* = (self :: @Self) usize {
        was           = self.run_base;
        self.run_base = self.depth + 1;
        was;
    }

    run_until* = (self :: @Self, was: usize) () { self.run_base = was; }

    leave* = (self :: @Self) () { self.depth = self.depth - 1; }

    // `leave`, once per link, for a loop that charged its levels one at
    // a time. The links of a chain are all open until the chain ends —
    // each node is built AROUND the last — so they are released
    // together, not as the loop goes round.
    unwind* = (self :: @Self, links: usize) () { self.depth = self.depth - links; }
}

// `alloc.Parser(lexed)`. It takes what `scan` RETURNS, tokens and
// source together, because the two are useless apart: a token is a
// span into bytes it does not carry. `lexed.diags` stays the caller's
// — a file that did not lex is reported and not parsed, and deciding
// that is the driver's job.
//
// The cursor is NOT primed here: priming drains trivia, which
// allocates, and a constructor that can fail is one every caller has
// to `.try()`. `module` primes it as its first act.
Parser* = (a: Alloc, lexed: Lexed) Parser {
    a.Parser(lexed, a.Ast())
}

// `alloc.Parser(lexed, tree)` — the same constructor, handed a tree
// that is already holding modules.
//
// A WHOLE PROGRAM IS ONE `Ast`. An id is an index into its arena, so
// ninety-one parsers with ninety-one trees are ninety-one id spaces and
// an `ExprId` from one means nothing to a `Checker` holding another.
//
// It is a VALUE and not a reference, and that is the protocol: the
// driver hands the tree in, the parser adds this module's nodes to its
// copy, and the driver reads `p.tree` back before building the next
// parser. One owner at a time, in sequence — the same fact `Checker`
// relies on when it takes the finished tree by value
// (SEMA_BOOTSTRAP_FIXES.md §12). Two parsers alive at once over one
// tree would diverge the first time either `Vec` grew.
Parser* = (a: Alloc, lexed: Lexed, tree: Ast) Parser {
    origin = Span(
        file: lexed.source.file,
        start: Pos(line: 1, col: 1),
        end: Pos(line: 1, col: 1),
    );
    Parser(
        tokens: lexed.tokens,
        source: lexed.source,
        tree: tree,
        diags: a.Vec<Diag>(),
        pending: no_trivia(),
        anchor: origin,
        alloc: a,
    );
}

// What a trivia token is, as trivia.
trivia_kind* = (self: TokenKind) TriviaKind {
    self.match({
        BlockComment => TriviaKind.BlockComment,
        _            => TriviaKind.LineComment,
    });
}
