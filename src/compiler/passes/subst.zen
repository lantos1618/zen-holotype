{ ArmData, CallData, Decl, Expr, Field, FieldInit, GenStructDecl, LambdaData, MakeStructData,
  MatchData, Param, Stmt, Ty, VarData, VariantDef } = compiler.ast.ast_types
{ cbuf, arm, arm_spans, bin_at, block, call_origin_full, cond_oa, eindex, eloop_at, ematch, ematchp,
  finit, finit_at, lam_r, member_at, mfield, mkenum_at, mkenumg_at, mkstruct_at, mkstructg_at,
  mktag, mktag_at, mktagg, mktagg_at, param, param_at, sassign_at, sexpr, sidxset_at, sif, slett_at,
  slett_atm, slit, sret, strlit_at, subst_ty_in, swhile, tvoid, ty_cname_in, vref_at } = compiler.genc
{ mangle_str_in } = compiler.mangle
{ DeclIndex, VList, cebuf, cenode, add_fnt_param, add_lambda_arg, add_subst_arg, add_subst_param,
  bind_fnret, callee_subst_name, blockify, cat_stmts, fnret_of, gen_variant_payload, inline_lambda,
  is_void_ty, enum_name, let_value_lambda, local_name_at, no_stmts, param_index, pbuf, recall,
  ref_pos, vcons } = compiler.check
{ light_ty } = compiler.check_infer
{ cs_or, maybe_template } = compiler.check_inline
{ Allocator } = std.mem.alloc
{ map_slice, one_stmt } = compiler.astops
{ loop_at } = std.core.count
subst_var = (
    a: Allocator,
    params: MutSlice<Param>,
    args: MutSlice<Expr>,
    name: StringView,
    e: Ptr<Expr>,
) Ptr<Expr> {
    idx = params.param_index(name)
    (idx < 0).then({ e }, { a.subst_keep_pos(args[idx].addr(), e.ref_pos()) })
}
// A substituted reference is a renamed local's `vref` (built pos-less) or a spliced source arg. When
// the substitution target is a bare Var, carry the ORIGINAL reference's source position onto a fresh
// node (so a later diagnostic — e.g. a non-exhaustive match on a local subject — still gets a caret);
// a non-Var arg keeps its own node (and its own positions) unchanged.
subst_keep_pos = (a: Allocator, arg: Ptr<Expr>, p: i32) Ptr<Expr> {
    load(arg).match ({
        .Var(v) => a.cenode(vref_at(v.name, (v.pos <= 0).then({ p }, { v.pos }))),
        _       => arg,
    })
}
// the source position of a substituted REFERENCE (always a Var at the xform `.Var` call site).
xform_args = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    args: MutSlice<Expr>,
    params: MutSlice<Param>,
    fargs: MutSlice<Expr>,
    env: Ptr<VList>,
) MutSlice<Expr> {
    buf ::= a.cebuf(args.len)
    args.loop_at((i, ar) { buf[i] = load(a.xform_expr(decls, idx, ar.addr(), params, fargs, env)) })
    buf
}
xform_arm_payload = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    subj: Ty,
    ename: StringView,
    ar: ArmData,
) Ty {
    subj.match ({
        .Generic(g) => a.subst_ty_in(idx.idx_genenum(decls, g.name).tparams, g.args, idx
            .idx_genenum(decls, g.name)
            .gen_variant_payload(ar.variant)),
        _           => idx.idx_variant_payload(decls, ename, ar.variant),
    })
}
xform_arm_env* = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    subj: Ty,
    ename: StringView,
    ar: ArmData,
    env: Ptr<VList>,
) Ptr<VList> {
    out ::= env
    (ar.bind == "" == false).then({
        out = a.vcons(ar.bind, a.xform_arm_payload(decls, idx, subj, ename, ar), env)
    })
    out
}
xform_arms = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    subj: Ty,
    ename: StringView,
    arms: MutSlice<ArmData>,
    params: MutSlice<Param>,
    fargs: MutSlice<Expr>,
    env: Ptr<VList>,
    exp: Ty,
) MutSlice<ArmData> {
    buf ::= cbuf<ArmData>(a, arms.len)
    arms.loop_at((i, ar) {
        bind ::= ""
        ps ::= params
        xs ::= fargs
        (ar.bind == "" == false).then({
            bind = a.local_name_at(ar.bind, env, params.len)
            ps = a.add_subst_param(params, ar.bind)
            xs = a.add_subst_arg(fargs, bind)
        })
        br = arm_spans(ar.variant, bind, ar.body, ar.pos, ar.variant_pos, ar.bind_pos)
        aenv = a.xform_arm_env(decls, idx, subj, ename, br, env)
        buf[i] = arm_spans(ar.variant, bind, a.xform_expr_exp(decls, idx, ar.body, ps, xs, aenv, exp), ar.pos, ar.variant_pos, ar.bind_pos)
    })
    buf
}
subst_targs = (
    a: Allocator,
    tparams: MutSlice<Param>,
    targs: MutSlice<Ty>,
    xs: MutSlice<Ty>,
) MutSlice<Ty> { map_slice(a, xs, (t) { a.subst_ty_in(tparams, targs, t) }) }
subst_genlit_g = (
    a: Allocator,
    cs: i32,
    tparams: MutSlice<Param>,
    targs: MutSlice<Ty>,
    m: MakeStructData,
) Expr {
    nt = a.subst_targs(tparams, targs, m.targs)
    mkstructg_at(m.ty, a.mangle_str_in(m.ty, nt), nt, a.subst_inits(cs, tparams, targs, m.inits), cs_or(cs, m.pos))
}
subst_genlit = (
    a: Allocator,
    cs: i32,
    tparams: MutSlice<Param>,
    targs: MutSlice<Ty>,
    m: MakeStructData,
) Expr {
    (m.targs.len > 0).match ({
        true  => a.subst_genlit_g(cs, tparams, targs, m),
        false => mkstruct_at(m.ty, a.subst_inits(cs, tparams, targs, m.inits), cs_or(cs, m.pos)),
    })
}
subst_inits = (
    a: Allocator,
    cs: i32,
    tparams: MutSlice<Param>,
    targs: MutSlice<Ty>,
    inits: MutSlice<FieldInit>,
) MutSlice<FieldInit> {
    map_slice(a, inits, (fi) {
        finit_at(fi.name, a.subst_expr(cs, tparams, targs, fi.value), fi.pos)
    })
}
subst_exprs = (
    a: Allocator,
    cs: i32,
    tparams: MutSlice<Param>,
    targs: MutSlice<Ty>,
    xs: MutSlice<Expr>,
) MutSlice<Expr> {
    buf ::= a.cebuf(xs.len)
    xs.loop_at((i, x) { buf[i] = load(a.subst_expr(cs, tparams, targs, x.addr())) })
    buf
}
subst_arms = (
    a: Allocator,
    cs: i32,
    tparams: MutSlice<Param>,
    targs: MutSlice<Ty>,
    arms: MutSlice<ArmData>,
) MutSlice<ArmData> {
    map_slice(a, arms, (ar) {
        arm_spans(ar.variant, ar.bind, a.subst_expr(cs, tparams, targs, ar.body), ar.pos, ar.variant_pos, ar.bind_pos)
    })
}
subst_match = (
    a: Allocator,
    cs: i32,
    tparams: MutSlice<Param>,
    targs: MutSlice<Ty>,
    m: MatchData,
) Ptr<Expr> {
    subj = a.subst_expr(cs, tparams, targs, m.subj)
    arms = a.subst_arms(cs, tparams, targs, m.arms)
    m.ptr.match ({
        true  => a.cenode(ematchp(subj, m.ename, arms)),
        false => a.cenode(ematch(subj, m.ename, arms)),
    })
}
// Substitute and remangle generic-enum ctors/tags inside template bodies.
subst_mkenum = (
    a: Allocator,
    tparams: MutSlice<Param>,
    targs: MutSlice<Ty>,
    ety: StringView,
    etargs: MutSlice<Ty>,
    variant: StringView,
    p: Ptr<Expr>,
    ty_pos: i32,
    variant_pos: i32,
) Ptr<Expr> {
    (etargs.len > 0).match ({
        true  => a.cenode(a.subst_mkenum_g(tparams, targs, ety, etargs, variant, p, ty_pos, variant_pos)),
        false => a.cenode(mkenum_at(ety, variant, p, ty_pos, variant_pos)),
    })
}
subst_mkenum_g = (
    a: Allocator,
    tparams: MutSlice<Param>,
    targs: MutSlice<Ty>,
    ety: StringView,
    etargs: MutSlice<Ty>,
    variant: StringView,
    p: Ptr<Expr>,
    ty_pos: i32,
    variant_pos: i32,
) Expr {
    nt = a.subst_targs(tparams, targs, etargs)
    mkenumg_at(ety, a.mangle_str_in(ety, nt), nt, variant, p, ty_pos, variant_pos)
}
subst_tag = (
    a: Allocator,
    tparams: MutSlice<Param>,
    targs: MutSlice<Ty>,
    ety: StringView,
    etargs: MutSlice<Ty>,
    variant: StringView,
    ty_pos: i32,
    variant_pos: i32,
) Ptr<Expr> {
    (etargs.len > 0).match ({
        true  => a.cenode(a.subst_tag_g(tparams, targs, ety, etargs, variant, ty_pos, variant_pos)),
        false => a.cenode(mktag_at(ety, variant, ty_pos, variant_pos)),
    })
}
subst_tag_g = (
    a: Allocator,
    tparams: MutSlice<Param>,
    targs: MutSlice<Ty>,
    ety: StringView,
    etargs: MutSlice<Ty>,
    variant: StringView,
    ty_pos: i32,
    variant_pos: i32,
) Expr {
    nt = a.subst_targs(tparams, targs, etargs)
    mktagg_at(ety, a.mangle_str_in(ety, nt), nt, variant, ty_pos, variant_pos)
}
// `sizeof(T)` uses the tparam name as a value; rewrite it to the concrete C type name. A non-tparam
// Var is rebuilt (not passed through) so its position also retargets to the call site under `cs`.
subst_tparam_var = (
    a: Allocator,
    cs: i32,
    tparams: MutSlice<Param>,
    targs: MutSlice<Ty>,
    v: VarData,
    e: Ptr<Expr>,
) Ptr<Expr> {
    i = tparams.param_index(v.name)
    (i < 0).match ({
        true  => (cs == 0).then({ e }, { a.cenode(vref_at(v.name, cs)) }),
        false => a.cenode(vref_at(a.ty_cname_in(targs[i]), cs_or(cs, v.pos))),
    })
}
// A lambda body is ORDINARY code of the enclosing generic: its param/return/local annotations name
// the enclosing tparams, so an instance must substitute through it. Passing the node through left
// `MutPtr<T>` in the substituted copy, which then lifted to a top-level fn naming an undeclared `T`.
subst_lam = (
    a: Allocator,
    cs: i32,
    tparams: MutSlice<Param>,
    targs: MutSlice<Ty>,
    lm: LambdaData,
) Expr {
    ps = map_slice(a, lm.params, (p) {
        param_at(p.name, a.subst_ty_in(tparams, targs, p.ty), p.pos)
    })
    lam_r(ps, a.subst_body(cs, tparams, targs, lm.body), a.subst_ty_in(tparams, targs, lm.ret))
}
subst_expr = (
    a: Allocator,
    cs: i32,
    tparams: MutSlice<Param>,
    targs: MutSlice<Ty>,
    e: Ptr<Expr>,
) Ptr<Expr> {
    load(e).match ({
        .Var(v)        => a.subst_tparam_var(cs, tparams, targs, v, e),
        .Bin(b)        => a.cenode(bin_at(b.op, a.subst_expr(cs, tparams, targs, b.lhs), a.subst_expr(cs, tparams, targs, b.rhs), cs_or(cs, b.pos))),
        .Cond(d)       => a.cenode(cond_oa(a.subst_expr(cs, tparams, targs, d.c), a.subst_expr(cs, tparams, targs, d.t), a.subst_expr(cs, tparams, targs, d.e), d.oa)),
        .Member(m)     => a.cenode(mfield(a.subst_expr(cs, tparams, targs, m.obj), m.field, cs_or(cs, m.pos), m.ptr)),
        .Call(c)       => a.cenode(call_origin_full(c.fn, a.subst_exprs(cs, tparams, targs, c.args), a.subst_targs(tparams, targs, c.targs), cs_or(cs, c.pos), c.raw, c.origin)),
        .MakeEnum(mk)  => a.subst_mkenum(tparams, targs, mk.ty, mk.targs, mk.variant, a.subst_expr(cs, tparams, targs, mk.payload), mk.ty_pos, mk.variant_pos),
        .Tag(t)        => a.subst_tag(tparams, targs, t.ty, t.targs, t.variant, t.ty_pos, t.variant_pos),
        .MakeStruct(m) => a.cenode(a.subst_genlit(cs, tparams, targs, m)),
        .Match(mm)     => a.subst_match(cs, tparams, targs, mm),
        .Index(ix)     => a.cenode(eindex(a.subst_expr(cs, tparams, targs, ix.seq), a.subst_expr(cs, tparams, targs, ix.idx), a.subst_ty_in(tparams, targs, ix.elem))),
        .Loop(l)       => a.cenode(eloop_at(a.subst_expr(cs, tparams, targs, l.seq), l.idx, l.elem, a.subst_ty_in(tparams, targs, l.elemTy), a.subst_body(cs, tparams, targs, l.body), l.h, l.h_pos, l.idx_pos, l.elem_pos)),
        .SliceLit(sd)  => a.cenode(slit(a.subst_ty_in(tparams, targs, sd.elem), a.subst_exprs(cs, tparams, targs, sd.items))),
        .Block(b)      => a.cenode(block(a.subst_body(cs, tparams, targs, b.stmts))),
        .Lambda(lm)    => a.cenode(a.subst_lam(cs, tparams, targs, lm)),
        _              => e,
    })
}
subst_stmt = (a: Allocator, cs: i32, tparams: MutSlice<Param>, targs: MutSlice<Ty>, st: Stmt) Stmt {
    st.match ({
        .Let(l)      => slett_atm(l.name, a.subst_ty_in(tparams, targs, l.ty), a.subst_expr(cs, tparams, targs, l.value), cs_or(cs, l.pos), l.mut),
        .Assign(x)   => sassign_at(a.subst_expr(cs, tparams, targs, x.target), a.subst_expr(cs, tparams, targs, x.value), cs_or(cs, x.pos)),
        .Return(r)   => sret(a.subst_expr(cs, tparams, targs, r)),
        .ExprStmt(e) => sexpr(a.subst_expr(cs, tparams, targs, e)),
        .If(f)       => sif(a.subst_expr(cs, tparams, targs, f.c), a.subst_body(cs, tparams, targs, f.then), a.subst_body(cs, tparams, targs, f.els)),
        .While(w)    => swhile(a.subst_expr(cs, tparams, targs, w.c), a.subst_body(cs, tparams, targs, w.body)),
        .IndexSet(x) => sidxset_at(a.subst_expr(cs, tparams, targs, x.seq), a.subst_expr(cs, tparams, targs, x.idx), a.subst_ty_in(tparams, targs, x.elem), a.subst_expr(cs, tparams, targs, x.value), cs_or(cs, x.pos)),
    })
}
subst_body* = (
    a: Allocator,
    cs: i32,
    tparams: MutSlice<Param>,
    targs: MutSlice<Ty>,
    body: MutSlice<Stmt>,
) MutSlice<Stmt> { map_slice(a, body, (st) { a.subst_stmt(cs, tparams, targs, st) }) }
// ── struct reflection intrinsics: field_eq / each_field / zip_fields ──────────────────────────────
// `x.field_eq(y)` is desugared (check_desugar) to Call{fn:"field_eq", args:[x,y]}; during INLINING
// the receiver's concrete type is known, so it EXPANDS here to a per-field `==` fold:
//   true && x.f0 == y.f0 && x.f1 == y.f1 && …
// Scalar fields compare with a plain `Bin("==")`. STRING and ENUM fields ALSO use `Bin("==")`: the
// resolve pass that runs AFTER this inline pass rewrites string `==` → __str_eq and enum `==` → a
// tag compare. A STRUCT-typed field RECURSES into its own per-field fold — termination is
// structural (a struct cannot contain itself by value). The result is ordinary Bin/Member nodes,
// so genc/js emit them with NO backend change.
// the per-field view a reflection intrinsic iterates: Named structs from the decl index, GENERIC
// struct instances from the generic decl with tparams substituted per the instance's targs.
reflect_fields* = (a: Allocator, decls: MutSlice<Decl>, idx: DeclIndex, t: Ty) MutSlice<Field> {
    t.match ({
        .Named(n)   => idx.idx_struct_fields(decls, n),
        .Generic(g) => a.rf_subst_fields(idx.idx_genstruct(decls, g.name), g.args),
        _           => idx.idx_struct_fields(decls, ""),
    })
}
rf_subst_fields = (a: Allocator, gs: GenStructDecl, targs: MutSlice<Ty>) MutSlice<Field> {
    buf ::= cbuf<Field>(a, gs.fields.len)
    gs.fields.loop_at((i, f) {
        buf[i] = Field(
            name: f.name,
            ty: a.subst_ty_in(gs.tparams, targs, f.ty),
            dflt: f.dflt,
            pos: f.pos,
        )
    })
    buf
}
fe_true = (a: Allocator, pos: i32) Ptr<Expr> { a.cenode(vref_at("true", pos)) }
fe_field_cmp = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    rx: Ptr<Expr>,
    ry: Ptr<Expr>,
    f: Field,
    pos: i32,
) Ptr<Expr> {
    nested = a.reflect_fields(decls, idx, f.ty)
    (nested.len > 0).match ({
        true  => a.fe_fold(decls, idx, a.cenode(member_at(rx, f.name, pos)), a.cenode(member_at(ry, f.name, pos)), nested, 0, a.fe_true(pos), pos),
        false => a.cenode(bin_at("==", a.cenode(member_at(rx, f.name, pos)), a.cenode(member_at(ry, f.name, pos)), pos)),
    })
}    // struct-typed field: recursive per-field fold on the nested struct
fe_fold = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    rx: Ptr<Expr>,
    ry: Ptr<Expr>,
    flds: MutSlice<Field>,
    i: i32,
    acc: Ptr<Expr>,
    pos: i32,
) Ptr<Expr> {
    (i >= flds.len).match ({
        true  => acc,
        false => a.fe_fold(decls, idx, rx, ry, flds, i + 1, a.cenode(bin_at("&&", acc, a.fe_field_cmp(decls, idx, rx, ry, flds[i], pos), pos)), pos),
    })
}
expand_field_eq = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    flds: MutSlice<Field>,
    cargs: MutSlice<Expr>,
    pos: i32,
) Ptr<Expr> {
    a.fe_fold(decls, idx, cargs[0].addr(), cargs[1].addr(), flds, 0, a.fe_true(pos), pos)
}
// ── each_field / zip_fields: typed per-field iteration, unrolled at inline time ────────────────────
// `x.each_field(f)` becomes one inlined call of the lambda per field:  { f("f0", x.f0); … }  (Zig
// `inline for` / Nim `fieldPairs`). Each unrolled copy of the lambda body is re-xformed HERE against
// THAT field's member expr, so generic calls inside resolve per-field-type independently, and a
// nested `each_field`/`field_eq` on a struct-typed field expands recursively through this same hook.
// `x.zip_fields(y, f)` is the paired form: f("f0", x.f0, y.f0); …  Both are void: the expansion is a
// Block of ExprStmts (ordinary nodes — NO backend change). Sibling copies land in sibling C scopes,
// so the per-copy renamed locals never collide.
ef_args = (a: Allocator, name: StringView, vx: Expr, pos: i32) MutSlice<Expr> {
    buf ::= a.cebuf(2)
    buf[0] = strlit_at(name, pos)
    buf[1] = vx
    buf
}
ef_args_zip = (a: Allocator, name: StringView, vx: Expr, vy: Expr, pos: i32) MutSlice<Expr> {
    buf ::= a.cebuf(3)
    buf[0] = strlit_at(name, pos)
    buf[1] = vx
    buf[2] = vy
    buf
}
expand_each_field = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    flds: MutSlice<Field>,
    cargs: MutSlice<Expr>,
    env: Ptr<VList>,
    pos: i32,
) Ptr<Expr> {
    rx = cargs[0].addr()
    buf ::= cbuf<Stmt>(a, flds.len)
    flds.loop_at((i, f) {
        buf[i] = sexpr(a.inline_lambda(decls, idx, cargs[1], a.ef_args(f.name, member_at(rx, f.name, pos), pos), env))
    })
    a.cenode(block(buf))
}
expand_zip_fields = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    flds: MutSlice<Field>,
    cargs: MutSlice<Expr>,
    env: Ptr<VList>,
    pos: i32,
) Ptr<Expr> {
    rx = cargs[0].addr()
    ry = cargs[1].addr()
    buf ::= cbuf<Stmt>(a, flds.len)
    flds.loop_at((i, f) {
        buf[i] = sexpr(a.inline_lambda(decls, idx, cargs[2], a.ef_args_zip(f.name, member_at(rx, f.name, pos), member_at(ry, f.name, pos), pos), env))
    })
    a.cenode(block(buf))
}
// a subject expr other than a plain Var is bound to a temp ONCE — the expansion reads each field
// from the SAME evaluation, so a side-effecting receiver (`mk().each_field(..)`) runs exactly once.
refl_needs_bind = (e: Expr) bool {
    e.match ({
        .Var(v) => false,
        _       => true,
    })
}
refl_dispatch = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    fn: StringView,
    flds: MutSlice<Field>,
    cargs: MutSlice<Expr>,
    env: Ptr<VList>,
    pos: i32,
) Ptr<Expr> {
    (fn == "field_eq").then({
        return a.expand_field_eq(decls, idx, flds, cargs, pos)
    })
    (fn == "each_field").then({
        return a.expand_each_field(decls, idx, flds, cargs, env, pos)
    })
    a.expand_zip_fields(decls, idx, flds, cargs, env, pos)
}
// the reflection hook: expand ONLY when the shape is fully concrete and well-formed; otherwise
// PRESERVE the call (recall) — a template body re-reaches this hook at the call-site splice with
// concrete types, and a genuinely ill-formed call gets its positioned diagnostic from validation
// (kv_reflect_kind: receiver class, subject-type match, lambda shape, arity).
refl_hook = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    c: CallData,
    cargs: MutSlice<Expr>,
    params: MutSlice<Param>,
    env: Ptr<VList>,
) Ptr<Expr> {
    want = (c.fn == "zip_fields").then({ 3 }, { 2 })
    (cargs.len == want == false).then({
        return a.recall(c, c.fn, cargs)
    })
    st = cargs[0].addr().light_ty(a, env, decls, idx)
    flds = a.reflect_fields(decls, idx, st)
    (flds.len == 0).then({
        return a.recall(c, c.fn, cargs)
    })
    (c.fn == "each_field" == false).then({
        yn = cargs[1].addr().light_ty(a, env, decls, idx).enum_name()
        (yn == "" == false && yn == st.enum_name() == false).then({
            return a.recall(c, c.fn, cargs)
        })
    })
    (c.fn == "field_eq" == false).then({
        ok = cargs[want - 1].match ({
            .Lambda(lm) => lm.params.len == to_i64(want),
            .Var(v)     => true,
            _           => false,
        })
        (ok == false).then({
            return a.recall(c, c.fn, cargs)
        })
    })
    nsub = (c.fn == "each_field").then({ 1 }, { 2 })
    nb ::= 0
    cargs.loop_at((i, ce) {
        (i < to_i64(nsub) && ce.refl_needs_bind()).then({
            nb = nb + 1
        })
    })
    (nb == 0).then({
        return a.refl_dispatch(decls, idx, c.fn, flds, cargs, env, c.pos)
    })
    bb ::= cbuf<Stmt>(a, nb)
    args2 ::= a.cebuf(cargs.len)
    j ::= 0
    cargs.loop_at((i, ce) {
        args2[i] = ce
        (i < to_i64(nsub) && ce.refl_needs_bind()).then({
            nm = a.local_name_at("__refl", env, params.len + to_i32(i))
            bb[j] = slett_at(nm, tvoid(), a.cenode(ce), c.pos)
            args2[i] = vref_at(nm, c.pos)
            j = j + 1
        })
    })
    a.blockify(a.cat_stmts(bb, a.one_stmt(sexpr(a.refl_dispatch(decls, idx, c.fn, flds, args2, env, c.pos)))))
}
// ── variant_name: the ENUM half of reflection, unrolled at inline time ────────────────────────────
// `e.variant_name()` becomes an ordinary match yielding one string LITERAL per variant:
//   e.match({ .Debug => "Debug", .Info => "Info", … })
// so the name costs a switch and a `const char*` — no allocation, no runtime table, no string data
// beyond the literals the program would have written by hand. The name is returned EXACTLY as
// declared: case folding is a runtime string operation (it allocates), so a caller who wants
// `"DEBUG"` writes that transform itself.
// Variant names come from the decl index; a GENERIC enum reads its GENERIC decl, since variant names
// never depend on the type args. Payload variants bind nothing — the name is the payload-free fact.
// gen_match already binds the subject to `_subj` once, so a side-effecting receiver evaluates exactly
// once with no temp of our own (unlike each_field, which reads the subject once per field). The
// result is ordinary Match/StrLit nodes, so genc and genjs emit it exactly as they emit a
// hand-written match — NO backend change.
reflect_variants* = (idx: DeclIndex, decls: MutSlice<Decl>, t: Ty) MutSlice<VariantDef> {
    t.match ({
        .Named(n)   => idx.idx_enum_variants(decls, n),
        .Generic(g) => idx.idx_genenum(decls, g.name).variants,
        _           => idx.idx_enum_variants(decls, ""),
    })
}
expand_variant_name = (
    a: Allocator,
    vs: MutSlice<VariantDef>,
    subj: Ptr<Expr>,
    ename: StringView,
    pos: i32,
) Ptr<Expr> {
    arms ::= cbuf<ArmData>(a, vs.len)
    vs.loop_at((i, v) { arms[i] = arm(v.name, "", a.cenode(strlit_at(v.name, pos))) })
    a.cenode(ematch(subj, ename, arms))
}
// Expand ONLY when the receiver is a concrete enum; otherwise PRESERVE the call (recall) so a
// template body re-reaches this hook at the call-site splice with the concrete type, and an
// ill-formed receiver gets its positioned diagnostic from validation (kv_variant_name_kind).
vn_hook = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    c: CallData,
    cargs: MutSlice<Expr>,
    env: Ptr<VList>,
) Ptr<Expr> {
    (cargs.len == 1 == false).then({
        return a.recall(c, c.fn, cargs)
    })
    st = cargs[0].addr().light_ty(a, env, decls, idx)
    vs = idx.reflect_variants(decls, st)
    (vs.len == 0).then({
        return a.recall(c, c.fn, cargs)
    })
    a.expand_variant_name(vs, cargs[0].addr(), st.enum_name(), c.pos)
}
// Empty Named marks a generic template currently being inlined.
xform_call = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    c: CallData,
    params: MutSlice<Param>,
    fargs: MutSlice<Expr>,
    env: Ptr<VList>,
    exp: Ty,
) Ptr<Expr> {
    cargs = a.xform_args(decls, idx, c.args, params, fargs, env)
    (c.fn == "field_eq" || c.fn == "each_field" || c.fn == "zip_fields").then({
        return a.refl_hook(decls, idx, c, cargs, params, env)
    })
    (c.fn == "variant_name").then({
        return a.vn_hook(decls, idx, c, cargs, env)
    })
    fi = params.param_index(c.fn)
    (fi < 0).match ({
        true  => a.maybe_template(decls, idx, c, cargs, env, exp),
        false => params[fi].ty.is_fnt().match ({
            true  => a.inline_lambda(decls, idx, fargs[fi], cargs, env),
            false => a.recall(c, fargs[fi].callee_subst_name(c.fn), cargs),
        }),
    })
}
// an indirect call through a renamed local (a fn-value let): the substituted arg is the
// renamed local's Var, so recall through its renamed C name (not the stale original).
xform_match = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    m: MatchData,
    params: MutSlice<Param>,
    fargs: MutSlice<Expr>,
    env: Ptr<VList>,
    exp: Ty,
) Ptr<Expr> {
    subj = a.xform_expr(decls, idx, m.subj, params, fargs, env)
    st = subj.light_ty(a, env, decls, idx)
    arms = a.xform_arms(decls, idx, st, m.ename, m.arms, params, fargs, env, exp)
    out ::= a.cenode(ematch(subj, m.ename, arms))
    m.ptr.then({
        out = a.cenode(ematchp(subj, m.ename, arms))
    })
    out
}
xform_inits = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    inits: MutSlice<FieldInit>,
    params: MutSlice<Param>,
    fargs: MutSlice<Expr>,
    env: Ptr<VList>,
) MutSlice<FieldInit> {
    map_slice(a, inits, (fi) {
        finit_at(fi.name, a.xform_expr(decls, idx, fi.value, params, fargs, env), fi.pos)
    })
}
xform_lambda = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    lm: LambdaData,
    params: MutSlice<Param>,
    fargs: MutSlice<Expr>,
    env: Ptr<VList>,
) Ptr<Expr> {
    // RENAME the lambda's own params, exactly as `.Loop` renames idx/elem/h. A lambda is the only
    // binder xform used to leave spelled as written, so a template's `(n) { … body(n) … }` re-bound
    // any `n` free in the SPLICED argument — a caller PARAMETER named `n` (a caller local is already
    // renamed) silently read the lambda's `n` instead. That is `repeat_while` reading 0 for 5.
    ps ::= params
    xs ::= fargs
    nps ::= a.pbuf(lm.params.len)
    lm.params.loop_at((i, p) {
        nm = a.local_name_at(p.name, env, params.len + to_i64(i))
        nps[i] = param_at(nm, p.ty, p.pos)
        ps = a.add_subst_param(ps, p.name)
        xs = a.add_subst_arg(xs, nm)
    })
    // bind the lambda's OWN return type (possibly void) so an enclosing fn's fnret never leaks
    // into the lambda body's `return`s.
    a.cenode(lam_r(nps, a.xform_body(decls, idx, lm.body, ps, xs, a.bind_fnret(env, lm.ret), tvoid()), lm.ret))
}
xform_expr = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    e: Ptr<Expr>,
    params: MutSlice<Param>,
    fargs: MutSlice<Expr>,
    env: Ptr<VList>,
) Ptr<Expr> { a.xform_expr_exp(decls, idx, e, params, fargs, env, tvoid()) }
xform_expr_exp = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    e: Ptr<Expr>,
    params: MutSlice<Param>,
    fargs: MutSlice<Expr>,
    env: Ptr<VList>,
    exp: Ty,
) Ptr<Expr> {
    out ::= e
    load(e).match ({
        .Var(v)         => {
            out = a.subst_var(params, fargs, v.name, e)
        },
        .Call(c)        => {
            out = a.xform_call(decls, idx, c, params, fargs, env, exp)
        },
        .Bin(b)         => {
            out = a.cenode(bin_at(b.op, a.xform_expr(decls, idx, b.lhs, params, fargs, env), a.xform_expr(decls, idx, b.rhs, params, fargs, env), b.pos))
        },
        .Cond(d)        => {
            out = a.cenode(cond_oa(a.xform_expr(decls, idx, d.c, params, fargs, env), a.xform_expr_exp(decls, idx, d.t, params, fargs, env, exp), a.xform_expr_exp(decls, idx, d.e, params, fargs, env, exp), d.oa))
        },
        .Member(m)      => {
            out = a.cenode(mfield(a.xform_expr(decls, idx, m.obj, params, fargs, env), m.field, m.pos, m.ptr))
        },
        .MakeEnum(mk)   => {
            out = a.cenode(mkenumg_at(mk.ty, mk.mty, mk.targs, mk.variant, a.xform_expr(decls, idx, mk.payload, params, fargs, env), mk.ty_pos, mk.variant_pos))
        },
        .MakeStruct(sd) => {
            out = a.cenode(mkstructg_at(sd.ty, sd.mty, sd.targs, a.xform_inits(decls, idx, sd.inits, params, fargs, env), sd.pos))
        },
        .Match(m)       => {
            out = a.xform_match(decls, idx, m, params, fargs, env, exp)
        },
        .Index(ix)      => {
            out = a.cenode(eindex(a.xform_expr(decls, idx, ix.seq, params, fargs, env), a.xform_expr(decls, idx, ix.idx, params, fargs, env), ix.elem))
        },
        .Loop(l)        => {
            lidx = a.local_name_at(l.idx, env, params.len)
            elem = a.local_name_at(l.elem, env, params.len + 1)
            hnd = a.local_name_at(l.h, env, params.len + 2)
            ps1 = a.add_subst_param(a.add_subst_param(a.add_subst_param(params, l.idx), l.elem), l.h)
            xs1 = a.add_subst_arg(a.add_subst_arg(a.add_subst_arg(fargs, lidx), elem), hnd)
            // The element binding's TYPE has to enter the lookup env, not just its renamed name:
            // a body that light-types the element (`x.variant_name()`) otherwise sees void, so
            // vn_hook finds no variants and preserves the call for a template splice that never
            // comes — `zen check` passes and the link fails on an undefined `variant_name`.
            env1 = a.vcons(elem, l.elemTy, env)
            out = a.cenode(eloop_at(a.xform_expr(decls, idx, l.seq, params, fargs, env), lidx, elem, l.elemTy, a.xform_body(decls, idx, l.body, ps1, xs1, env1, tvoid()), hnd, l.h_pos, l.idx_pos, l.elem_pos))
        },
        .Lambda(lm)     => {
            out = a.xform_lambda(decls, idx, lm, params, fargs, env)
        },
        .SliceLit(sd)   => {
            out = a.cenode(slit(sd.elem, a.xform_args(decls, idx, sd.items, params, fargs, env)))
        },
        .Block(b)       => {
            out = a.cenode(block(a.xform_body(decls, idx, b.stmts, params, fargs, env, exp)))
        },
        _               => { },
    })
    out
}
xform_stmt = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    st: Stmt,
    params: MutSlice<Param>,
    fargs: MutSlice<Expr>,
    env: Ptr<VList>,
    exp: Ty,
) Stmt {
    out ::= st
    st.match ({
        .Let(l)      => {
            out = st.let_value_lambda().match ({
                true  => sexpr(a.cenode(block(no_stmts()))),
                false => slett_atm(a.local_name_at(l.name, env, params.len), l.ty, a.xform_expr_exp(decls, idx, l.value, params, fargs, env, l.ty), l.pos, l.mut),
            })
        },    // lambda-alias let: dropped (spliced at uses)
        .Assign(x)   => {
            out = sassign_at(a.xform_expr(decls, idx, x.target, params, fargs, env), a.xform_expr(decls, idx, x.value, params, fargs, env), x.pos)
        },
        .Return(r)   => {
            // a return's operand infers against the enclosing fn's return type (threaded via
            // bind_fnret), NOT the positional exp — which is void for every non-tail statement, so
            // a nested match-arm `return err(e)` inlined here otherwise instantiates err<void, E>.
            rt = env.fnret_of()
            out = sret(a.xform_expr_exp(decls, idx, r, params, fargs, env, rt.is_void_ty().match ({
                true  => exp,
                false => rt,
            })))
        },
        .ExprStmt(e) => {
            out = sexpr(a.xform_expr_exp(decls, idx, e, params, fargs, env, exp))
        },
        .If(f)       => {
            out = sif(a.xform_expr(decls, idx, f.c, params, fargs, env), a.xform_body(decls, idx, f.then, params, fargs, env, tvoid()), a.xform_body(decls, idx, f.els, params, fargs, env, tvoid()))
        },
        .While(w)    => {
            out = swhile(a.xform_expr(decls, idx, w.c, params, fargs, env), a.xform_body(decls, idx, w.body, params, fargs, env, tvoid()))
        },
        .IndexSet(x) => {
            out = sidxset_at(a.xform_expr(decls, idx, x.seq, params, fargs, env), a.xform_expr(decls, idx, x.idx, params, fargs, env), x.elem, a.xform_expr(decls, idx, x.value, params, fargs, env), x.pos)
        },
    })
    out
}
// Thread local light types so generic call args can infer from Vars.
xform_let_ext = (
    a: Allocator,
    env: Ptr<VList>,
    st: Stmt,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    params: MutSlice<Param>,
) Ptr<VList> {
    out ::= env
    st.match ({
        .Let(l) => {
            ty ::= l.ty
            l.ty.is_void_ty().then({
                ty = l.value.light_ty(a, env, decls, idx)
            })
            out = a.vcons(a.local_name_at(l.name, env, params.len), ty, env)
        },
        _       => { },
    })
    out
}
xform_param_shadow = (a: Allocator, params: MutSlice<Param>, st: Stmt) MutSlice<Param> {
    out ::= params
    st.match ({
        .Let(l) => {
            out = st.let_value_lambda().match ({
                true  => a.add_fnt_param(params, l.name),
                false => a.add_subst_param(params, l.name),
            })
        },
        _       => { },
    })
    out
}
xform_arg_shadow = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    args: MutSlice<Expr>,
    st: Stmt,
    params: MutSlice<Param>,
    env: Ptr<VList>,
) MutSlice<Expr> {
    out ::= args
    st.match ({
        .Let(l) => {
            out = st.let_value_lambda().match ({
                true  => a.add_lambda_arg(args, a.xform_expr(decls, idx, l.value, params, args, env)),
                false => a.add_subst_arg(args, a.local_name_at(l.name, env, params.len)),
            })
        },
        _       => { },
    })
    out
}
xform_body* = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    body: MutSlice<Stmt>,
    params: MutSlice<Param>,
    fargs: MutSlice<Expr>,
    env: Ptr<VList>,
    exp: Ty,
) MutSlice<Stmt> {
    buf ::= cbuf<Stmt>(a, body.len)
    e ::= env
    ps ::= params
    xs ::= fargs
    body.loop_at((i, st) {
        want ::= tvoid()
        (i == body.len - 1).then({
            want = exp
        })
        buf[i] = a.xform_stmt(decls, idx, st, ps, xs, e, want)
        e = a.xform_let_ext(e, st, decls, idx, ps)
        xs = a.xform_arg_shadow(decls, idx, xs, st, ps, e)
        ps = a.xform_param_shadow(ps, st)
    })
    buf
}
