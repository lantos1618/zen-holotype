// std.core.path owns path assembly so callers do not each grow a String and
// reimplement the separator boundary. Empty and already-terminated bases are
// deliberately included: they are the two edges most local copies disagree
// about.

main = (env: Env) Res<i32, AllocError> {
    a ::= env.mem.alloc();
    plain = join_path(a, "work", "file.zen").try();
    ended = join_path(a, "work/", "file.zen").try();
    empty = join_path(a, "", "file.zen").try();
    println("{}", plain.view());
    println("{}", ended.view());
    println("{}", empty.view());
    Ok(0);
}
