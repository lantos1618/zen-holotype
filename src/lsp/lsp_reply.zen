// Reads JSON-RPC request fields and writes response envelopes and capabilities.

str, String = std.text
Alloc, AllocError = std.mem
Jsons, JsonId, write_text, written, obj, Nest,
    JsonFault, to_json = std.json
Hover = lsp.lsp_hover
Target, write_location = lsp.lsp_def
WireRange = lsp.lsp_pos
write_legend = lsp.lsp_colour

method_of* = (tree: Jsons, req: JsonId) str {
    string_at(tree, req, "method")
}

DecodedRequest* = {
    tree: Jsons,
    request: JsonId,
    id: JsonId,

    method* = (self: @Self) str { method_of(self.tree, self.request) }

    params* = (self: @Self) JsonId { params_of(self.tree, self.request) }

    param* = (self: @Self, name: str) JsonId {
        param(self.tree, self.request, name)
    }

    field_at* = (self: @Self, value: JsonId, name: str) JsonId {
        self.tree.field(value, name).match({ None => value, Ok(v) => v })
    }

    string_at* = (self: @Self, value: JsonId, name: str) str {
        string_at(self.tree, value, name)
    }

    number_at* = (self: @Self, value: JsonId, name: str) usize {
        number_at(self.tree, value, name)
    }
}

DecodedRequest* = (tree: Jsons, request: JsonId, id: JsonId) DecodedRequest {
    DecodedRequest(tree: tree, request: request, id: id)
}

RequestTurn* = {
    temporary: Alloc,
    response :: String,

    alloc* = (self: @Self) Alloc { self.temporary }

    is_empty* = (self: @Self) bool { self.response.is_empty() }

    view* = (self: @Self) str { self.response.view() }

    result* = (self :: @Self, request: DecodedRequest, body: str)
              Res<(), AllocError> {
        result(request.tree, request.id, body, self.response)
    }

    failed* = (self :: @Self, request: DecodedRequest, code: RpcFault,
               why: str) Res<(), AllocError> {
        failed(request.tree, request.id, code, why, self.response)
    }

    parse_error* = (self :: @Self, fault: JsonFault) Res<(), AllocError> {
        parse_error(fault, self.response)
    }
}

RequestTurn* = (temporary: Alloc) Res<RequestTurn, AllocError> {
    Ok(RequestTurn(temporary: temporary, response: temporary.String().try()))
}

params_of* = (tree: Jsons, req: JsonId) JsonId {
    tree.field(req, "params").match({ None => req, Ok(ps) => ps })
}

param* = (tree: Jsons, req: JsonId, name: str) JsonId {
    ps = params_of(tree, req);
    tree.field(ps, name).match({ None => ps, Ok(v) => v })
}

string_at* = (tree: Jsons, obj: JsonId, name: str) str {
    tree.field(obj, name).match({
        None  => "",
        Ok(v) => tree.text(v).match({ Ok(s) => s, None => "" }),
    })
}

number_at* = (tree: Jsons, obj: JsonId, name: str) usize {
    tree.field(obj, name).match({
        None  => 0,
        Ok(v) => tree.whole(v).match({ Ok(n) => n, None => 0 }),
    })
}

result = (tree: Jsons, rid: JsonId, body: str, msg :: String)
         Res<(), AllocError> {
    reply ::= head(tree, rid, msg).try();
    reply.key("result", msg).try();
    msg.add(body).try();
    reply.close(msg)
}

failed = (
    tree : Jsons,
    rid  : JsonId,
    code : RpcFault,
    why  : str,
    msg  :: String
) Res<(), AllocError> {
    reply ::= head(tree, rid, msg).try();
    reply.key("error", msg).try();
    fault ::= obj(msg).try();
    fault.key("code", msg).try();
    msg.add('-').try();
    msg.write_usize(rpc_code(code)).try();
    fault.key("message", msg).try();
    write_text(why, msg).try();
    fault.close(msg).try();
    reply.close(msg)
}

head = (tree: Jsons, rid: JsonId, msg :: String) Res<Nest, AllocError> {
    reply ::= obj(msg).try();
    reply.text("jsonrpc", "2.0", msg).try();
    reply.key("id", msg).try();
    tree.write(rid, msg).try();
    Ok(reply)
}

parse_error = (f: JsonFault, msg :: String) Res<(), AllocError> {
    reply ::= obj(msg).try();
    reply.text("jsonrpc", "2.0", msg).try();
    reply.key("id", msg).try();
    msg.add("null").try();
    reply.key("error", msg).try();
    why ::= obj(msg).try();
    why.key("code", msg).try();
    msg.add('-').try();
    msg.write_usize(rpc_code(RpcFault.ParseError)).try();
    why.key("message", msg).try();
    write_fault(f, msg).try();
    why.close(msg).try();
    reply.close(msg)
}

write_fault = (f: JsonFault, msg :: String) Res<(), AllocError> {
    msg.add('"').try();
    said = fault_text(f);
    msg.add(said.why).try();
    said.at.match({
        None  => written(),
        Ok(i) => { msg.add(" at byte ").try(); msg.write_usize(i) },
    }).try();
    msg.add('"')
}

FaultText = { why: str, at: Res<usize> }

fault_text = (f: JsonFault) FaultText {
    f.match({
        Unexpected(i) => FaultText(why: "unexpected byte", at: Ok(i)),
        Truncated(i)  => FaultText(
            why: "the document ended inside a value",
            at: Ok(i)
        ),
        BadEscape(i)  => FaultText(why: "bad escape", at: Ok(i)),
        BadNumber(i)  => FaultText(why: "not a JSON number", at: Ok(i)),
        TooDeep(i)    => FaultText(why: "nested too deeply", at: Ok(i)),
        Trailing(i)   => FaultText(
            why: "trailing bytes after the value",
            at: Ok(i)
        ),
        NoMemory      => FaultText(why: "out of memory", at: None),
    })
}

MarkupContent = {
    kind: str,
    value: str,
}

HoverResult = {
    contents: MarkupContent,
    range: WireRange,
}

write_hover* = (a: Alloc, h: Hover, out :: String) Res<(), AllocError> {
    encoded ::= HoverResult(contents: MarkupContent(kind: "plaintext", value: h.shown), range: WireRange(start: h.start, end: h.end)).to_json(a).try();
    out.add(encoded.view())
}

write_target* = (a: Alloc, t: Target, body :: String) Res<(), AllocError> {
    t.found.match({
        false => body.add("null"),
        true  => write_location(a, t, body),
    })
}

write_capabilities* = (out :: String) Res<(), AllocError> {
    out.add(
        "{\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true,\"definitionProvider\":true,\"documentSymbolProvider\":true,\"documentFormattingProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\"]},\"codeActionProvider\":{\"codeActionKinds\":[\"quickfix\"]},\"semanticTokensProvider\":{\"legend\":"
    ).try();
    write_legend(out).try();
    out.add(
        ",\"full\":true}},\"serverInfo\":{\"name\":\"zen\",\"version\":\"0\"}}"
    )
}

SEMANTIC_TOKENS*: str = "textDocument/semanticTokens/full"

Request* = Initialize
    | Shutdown
    | Hover
    | Definition
    | Outline
    | Completion
    | Colour
    | Format
    | Action
    | Unknown

request_of* = (method: str) Request {
    found: Res<Request> = loop<Request>((h) {
        method.eq("textDocument/hover").then(() { h.break(Request.Hover) });
        method.eq("textDocument/definition").then(() { h.break(Request.Definition) });
        method.eq("textDocument/completion").then(() { h.break(Request.Completion) });
        method.eq("textDocument/documentSymbol").then(() { h.break(Request.Outline) });
        method.eq(SEMANTIC_TOKENS).then(() { h.break(Request.Colour) });
        method.eq("textDocument/formatting").then(() { h.break(Request.Format) });
        method.eq("textDocument/codeAction").then(() { h.break(Request.Action) });
        method.eq("initialize").then(() { h.break(Request.Initialize) });
        method.eq("shutdown").then(() { h.break(Request.Shutdown) });
        h.break(Request.Unknown);
    });
    found.match({
        Ok(one) => one,
        None    => Request.Unknown,
    });
}

RpcFault* = ParseError | MethodNotFound | InvalidParams | NotInitialized

rpc_code = (f: RpcFault) usize {
    f.match({
        ParseError     => 32700,
        MethodNotFound => 32601,
        InvalidParams  => 32602,
        NotInitialized => 32002,
    })
}

own_str* = (a: Alloc, s: str) Res<str, AllocError> {
    out ::= a.String().try();
    out.add(s).try();
    Ok(out.view());
}
