// src/gen/gen_c/gen_c_flow.zen
// What control flow is in C.
//
// Zen has exactly one conditional — `.match`, always exhaustive, in
// every position — and it is not a C expression, so it emits STATEMENTS
// and hands a destination its value. Everything in `gen_c_expr.zen`
// that spills spills into this or into `.try()`.
//
// `gen_c_try.zen` is the other non-local form: a match decides WHICH
// value, `.try()` decides whether there is one at all — two subjects,
// two files.
//
// A match becomes an `if` chain, not a `switch`: a pattern is not
// always a constant (a binder matches everything, a literal pattern on
// a non-integer is a comparison), so `switch` would serve only the enum
// case. The chain closes with `zg_unreachable`, which makes the C
// total — exhaustiveness is sema's to check, and a value matching no
// arm traps there instead of falling out with an uninitialised result.

Ast, Expr, ExprId, Match, Arm, Pattern, PatternId, PatternKind = std.ast
Literal, LiteralKind, Decl, DeclKind, Enum, Variant, Span = std.ast
Destructure, QualifiedName, Ident = std.ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId, Ty, Types, TyNamed, TyRes, ResForm = sema.sema_ty
World, Def, decl_at = sema.sema_def
Checker, Ctx = sema.sema_check
Inst = sema.sema_inst
type_of = sema.sema_type
last_segment = sema.sema_match
write_usize = sema.sema_diag
Emit = gen.gen_emit
sym_local, sym_member, sym_variant, sym_gen = gen.gen_name
RES_PATH, is_failure = gen.gen_name
GenFault = gen.gen_diag
CBackend = gen.gen_c.gen_c_state
enter_struct_tparams, leave_tparams = gen.gen_c.gen_c_mono
ctype, declarator, is_unit, variant_type, decl_ctx = gen.gen_c.gen_c_type
decl_inst = gen.gen_c.gen_c_type
write_qname = gen.gen_c.gen_c_layout
Dest, deliver, write_dest = gen.gen_c.gen_c_stmt
expr, res_type_of, ty_of, decoded_len = gen.gen_c.gen_c_expr
is_str = gen.gen_c.gen_c_read
write_position = gen.gen_c.gen_c_op

// -----------------------------------------------------------------
// match
// -----------------------------------------------------------------

lower_match* = (
    be   :: CBackend,
    node : Expr,
    m    : Match,
    ctx  : Ctx,
    ty   : TyId,
    dst  : Dest
) Res<(), AllocError> {
    st = res_type_of(be, m.scrutinee, ctx).try();
    scrut ::= be.alloc.String().try();
    sym_gen(scrut, "s", be.next_tmp()).try();
    declare_temp(be, st, scrut.view()).try();
    deliver(be, m.scrutinee, ctx, st, Dest.Into(scrut.view())).try();
    m.arms.loop((h, i, arm) {
        open_arm(be, arm, i, st, scrut.view(), ctx).try();
        deliver(be, arm.body, ctx, ty, dst).try();
    });
    close_arms(be, node, m).try();
    Ok(());
}

declare_temp* = (be :: CBackend, ty: TyId, name: str) Res<(), AllocError> {
    decl ::= be.alloc.String().try();
    declarator(be, ty, name, decl).try();
    decl.add_bytes(";").try();
    be.writeln(decl.view())
}

// `if (..) {` for the first arm, `} else if (..) {` for the rest. The
// bindings a pattern introduces are declared INSIDE the branch, which
// is what makes `Ok(n)` legal in one arm and unknown in the next.
open_arm = (
    be    :: CBackend,
    arm   : Arm,
    i     : usize,
    st    : TyId,
    scrut : str,
    ctx   : Ctx
) Res<(), AllocError> {
    cond ::= be.alloc.String().try();
    arm_cond(be, arm.pattern, st, scrut, cond).try();
    (i > 0).match({
        true  => chain_arm(be, cond.view()),
        false => first_arm(be, cond.view()),
    }).try();
    arm_bind(be, arm.pattern, st, scrut, ctx).try();
    Ok(());
}

first_arm = (be :: CBackend, cond: str) Res<(), AllocError> {
    be.write("if (").try();
    be.write(cond).try();
    be.writeln(") {").try();
    be.indent();
    Ok(());
}

chain_arm = (be :: CBackend, cond: str) Res<(), AllocError> {
    be.dedent();
    be.write("} else if (").try();
    be.write(cond).try();
    be.writeln(") {").try();
    be.indent();
    Ok(());
}

// The chain's `else`: a value that matched no arm traps at the `match`
// token rather than leaving the destination uninitialised.
close_arms = (be :: CBackend, node: Expr, m: Match) Res<(), AllocError> {
    (m.arms.len == 0).match({
        true  => write_unreachable(be, node, m),
        false => close_chain(be, node, m),
    })
}

close_chain = (be :: CBackend, node: Expr, m: Match) Res<(), AllocError> {
    be.dedent();
    be.writeln("} else {").try();
    be.indent();
    write_unreachable(be, node, m).try();
    be.dedent();
    be.writeln("}").try();
    Ok(());
}

write_unreachable = (be :: CBackend, node: Expr, m: Match)
                    Res<(), AllocError> {
    pos ::= be.alloc.String().try();
    write_position(be, node.span.file, m.name_span, pos).try();
    be.write("zg_unreachable(").try();
    be.write(pos.view()).try();
    be.writeln(");").try();
    Ok(());
}

// -----------------------------------------------------------------
// patterns
// -----------------------------------------------------------------

arm_cond = (
    be    :: CBackend,
    pid   : PatternId,
    st    : TyId,
    scrut : str,
    out   :: String
) Res<(), AllocError> {
    pat = be.tree.pattern_at(pid);
    pat.kind.match({
        Wild           => out.add_bytes("1"),
        Literal(l)     => literal_cond(be, pat, l, st, scrut, out),
        Name(p)        => name_cond(be, p.name, st, scrut, out),
        Destructure(d) => destructure_cond(be, d, st, scrut, out),
    }).try();
    Ok(());
}

// A payload pattern that is a literal narrows the arm; testing only the
// tag would be the worst kind of wrong: `Ok('\n')` and `Ok('\\')` would
// compile to the same (valid) condition, the first swallowing every
// `Ok`. So the tag and the payload's own test (`literal_cond`, one
// level down) are written together.
destructure_cond = (
    be    :: CBackend,
    d     : Destructure,
    st    : TyId,
    scrut : str,
    out   :: String
) Res<(), AllocError> {
    tag_cond(be, d.name, st, scrut, out).try();
    payload_cond(be, d, st, scrut, out)
}

// The payload's test is `arm_cond` again, one level down, against the
// payload's place and type. Depth is not a special form: `Left(Full(n))`
// is two tag tests for the same reason `Ok(3)` is a tag test and a
// comparison.
payload_cond = (
    be    :: CBackend,
    d     : Destructure,
    st    : TyId,
    scrut : str,
    out   :: String
) Res<(), AllocError> {
    payload_type(be, st, last_segment(d.name)).match({
        None  => bare_payload(be, d),
        Ok(t) => nested_cond(be, d, t, scrut, out),
    })
}

// A variant with no payload cannot have a literal one, and reaching
// `.zg_data` for it would be a union member nothing declared. The arm
// is refused rather than narrowed, which keeps the rule this file works
// by: lower it exactly, or report it.
bare_payload = (be :: CBackend, d: Destructure) Res<(), AllocError> {
    inner = be.tree.pattern_at(d.binder);
    inner.kind.match({
        Literal(_) => report_nested(be, inner),
        _          => Ok(()),
    })
}

nested_cond = (
    be    :: CBackend,
    d     : Destructure,
    t     : TyId,
    scrut : str,
    out   :: String
) Res<(), AllocError> {
    narrows(be, d.binder, t).match({
        false => Ok(()),
        true  => write_nested_cond(be, d, t, scrut, out),
    })
}

write_nested_cond = (
    be    :: CBackend,
    d     : Destructure,
    t     : TyId,
    scrut : str,
    out   :: String
) Res<(), AllocError> {
    place ::= be.alloc.String().try();
    payload_place(be, last_segment(d.name), scrut, place).try();
    out.add_bytes(" && ").try();
    arm_cond(be, d.binder, t, place.view(), out)
}

// Whether a pattern tests anything at all. A wildcard and a binder match
// every value, so joining their `1` onto the chain would say nothing;
// every other shape narrows. This is why `Ok(n)` stays a bare tag test.
narrows = (be :: CBackend, pid: PatternId, st: TyId) bool {
    be.tree.pattern_at(pid).kind.match({
        Wild    => false,
        Name(p) => is_variant(be, st, last_segment(p.name)),
        _       => true,
    })
}

// Where a variant's payload lives: the union member under the tag. Both
// the test and the binding reach it, and they must spell it the same.
payload_place = (be :: CBackend, variant: str, scrut: str, out :: String)
                Res<(), AllocError> {
    out.add_bytes(scrut).try();
    out.add_bytes(".zg_data.").try();
    sym_member(out, variant)
}

report_nested = (be :: CBackend, inner: Pattern) Res<(), AllocError> {
    be.report(
        inner.span.file,
        inner.span,
        GenFault.Unsupported("a nested pattern")
    )
}

// `true =>` is the scrutinee, `false =>` is its negation, and an
// integer or character pattern is an equality. A string is the one
// pattern that is not a scalar, so it is not an operator.
literal_cond = (
    be    :: CBackend,
    pat   : Pattern,
    l     : Literal,
    st    : TyId,
    scrut : str,
    out   :: String
) Res<(), AllocError> {
    l.kind.match({
        Bool  => bool_cond(l.text, scrut, out),
        Int   => equality(scrut, l.text, out),
        Char  => equality(scrut, l.text, out),
        Float => equality(scrut, l.text, out),
        Str   => str_cond(be, pat, l, st, scrut, out),
    })
}

bool_cond = (text: str, scrut: str, out :: String) Res<(), AllocError> {
    text.eq("true").match({
        true  => out.add_bytes(scrut),
        false => negate(scrut, out),
    })
}

negate = (scrut: str, out :: String) Res<(), AllocError> {
    out.add_bytes("!").try();
    out.add_bytes(scrut).try();
    Ok(());
}

equality = (scrut: str, text: str, out :: String) Res<(), AllocError> {
    out.add_bytes("(").try();
    out.add_bytes(scrut).try();
    out.add_bytes(" == ").try();
    out.add_bytes(text).try();
    out.add_bytes(")").try();
    Ok(());
}

// A `str` is a pointer and a length, so `==` would compare a STRUCT
// against a `char *` — invalid C, once emitted silently. Compared the
// way `str.impl(Eq)` does: LENGTH first, then bytes. Length first is
// correctness, not optimisation — comparing over the shorter length is
// the classic bug, and a prefix is not the whole.
//
// `.data` and `.len` are spelled the runtime floor's way, not the
// mangler's: `zg_str` is the floor's struct.
str_cond = (
    be    :: CBackend,
    pat   : Pattern,
    l     : Literal,
    st    : TyId,
    scrut : str,
    out   :: String
) Res<(), AllocError> {
    is_str(be, st).match({
        false => unsupported_cond(be, pat, out),
        true  => write_str_cond(l, scrut, out),
    })
}

write_str_cond = (l: Literal, scrut: str, out :: String)
                 Res<(), AllocError> {
    n = decoded_len(l.text);
    out.add_bytes("(").try();
    out.add_bytes(scrut).try();
    out.add_bytes(".len == ").try();
    out.write_usize(n).try();
    out.add_bytes("u").try();
    (n > 0).match({
        true  => str_bytes_cond(l, scrut, n, out),
        false => Ok(()),
    }).try();
    out.add_bytes(")").try();
    Ok(());
}

// The empty string is its length and nothing more: a zero-length `str`
// may carry a null `data`, and that is not a pointer `memcmp` may be
// handed even for zero bytes.
str_bytes_cond = (l: Literal, scrut: str, n: usize, out :: String)
                 Res<(), AllocError> {
    out.add_bytes(" && memcmp(").try();
    out.add_bytes(scrut).try();
    out.add_bytes(".data, ").try();
    out.add_bytes(l.text).try();
    out.add_bytes(", ").try();
    out.write_usize(n).try();
    out.add_bytes("u) == 0").try();
    Ok(());
}

// A string pattern on a scrutinee that is not a `str`. The arm is
// reported and its condition is never true, which keeps the chain total
// without inventing a comparison.
unsupported_cond = (be :: CBackend, pat: Pattern, out :: String)
                   Res<(), AllocError> {
    be.report(
        pat.span.file,
        pat.span,
        GenFault.Unsupported("a string pattern")
    ).try();
    out.add_bytes("0")
}

// A bare name is a nullary VARIANT when the scrutinee's type has one
// by that name, and a BINDER otherwise. "They are the same tokens, and
// which one it is depends on what is in scope" — here, on what the
// scrutinee is.
name_cond = (
    be    :: CBackend,
    q     : QualifiedName,
    st    : TyId,
    scrut : str,
    out   :: String
) Res<(), AllocError> {
    is_variant(be, st, last_segment(q)).match({
        true  => tag_cond(be, q, st, scrut, out),
        false => out.add_bytes("1"),
    })
}

tag_cond = (
    be    :: CBackend,
    q     : QualifiedName,
    st    : TyId,
    scrut : str,
    out   :: String
) Res<(), AllocError> {
    qname ::= be.alloc.String().try();
    enum_path(be, st, qname).try();
    out.add_bytes("(").try();
    out.add_bytes(scrut).try();
    out.add_bytes(".zg_tag == ").try();
    out.sym_variant(qname.view(), last_segment(q)).try();
    out.add_bytes(")").try();
    Ok(());
}

// The bindings a pattern introduces, declared inside the branch that
// tested it.
arm_bind = (be :: CBackend, pid: PatternId, st: TyId, scrut: str, ctx: Ctx)
           Res<(), AllocError> {
    be.tree.pattern_at(pid).kind.match({
        Name(p)        => bind_name(be, p.name, st, scrut, ctx),
        Destructure(d) => bind_payload(be, d, st, scrut, ctx),
        _              => Ok(()),
    })
}

bind_name = (
    be    :: CBackend,
    q     : QualifiedName,
    st    : TyId,
    scrut : str,
    ctx   : Ctx
) Res<(), AllocError> {
    name = last_segment(q);
    is_variant(be, st, name).match({
        true  => Ok(()),
        false => bind_local(be, name, st, scrut),
    })
}

// `Ok(n)` binds `n` to the payload under the variant's member;
// `Left(Full(n))` binds `n` one level further down, walked by
// `arm_bind` again — a nested binder the walk never reached is a name
// the arm body cannot resolve. A literal or wildcard payload binds
// nothing; `arm_cond` has already turned it into a test.
bind_payload = (
    be    :: CBackend,
    d     : Destructure,
    st    : TyId,
    scrut : str,
    ctx   : Ctx
) Res<(), AllocError> {
    payload_type(be, st, last_segment(d.name)).match({
        None  => Ok(()),
        Ok(t) => bind_inner(be, d, t, scrut, ctx),
    })
}

bind_inner = (be :: CBackend, d: Destructure, t: TyId, scrut: str, ctx: Ctx)
             Res<(), AllocError> {
    place ::= be.alloc.String().try();
    payload_place(be, last_segment(d.name), scrut, place).try();
    arm_bind(be, d.binder, t, place.view(), ctx)
}

// A C declaration for a pattern binding, plus the same binding in
// sema's own scope so `type_of` answers for every use of it.
bind_local = (be :: CBackend, name: str, ty: TyId, init: str)
             Res<(), AllocError> {
    n = be.declare(name, ty, false).try();
    be.check.bind(name, ty, false, false).try();
    cname ::= be.alloc.String().try();
    sym_local(cname, name, n).try();
    decl ::= be.alloc.String().try();
    declarator(be, ty, cname.view(), decl).try();
    decl.add_bytes(" = ").try();
    decl.add_bytes(init).try();
    decl.add_bytes(";").try();
    be.writeln(decl.view())
}

// -----------------------------------------------------------------
// what an enum's variants are
//
// Two shapes and one question. `Res` carries no declaration — it is
// structural in sema's type language — so its variants are read off
// its form; everything else reads them off the declaration.
// -----------------------------------------------------------------

is_variant* = (be :: CBackend, st: TyId, name: str) bool {
    be.check.types.at(st).match({
        Res(r)   => res_has(r, name),
        Named(n) => enum_has(be, n, name),
        _        => false,
    })
}

res_has = (r: TyRes, name: str) bool {
    name.eq("Ok") || failure_name(r, name)
}

failure_name = (r: TyRes, name: str) bool {
    is_failure(r.form).match({
        true  => name.eq("Err"),
        false => name.eq("None"),
    })
}

enum_has = (be :: CBackend, n: TyNamed, name: str) bool {
    decl_at(be.tree, n.decl).match({
        None  => false,
        Ok(d) => decl_has(d, name),
    })
}

decl_has = (d: Decl, name: str) bool {
    d.kind.match({
        Enum(e) => variants_have(e.variants, name),
        _       => false,
    })
}

variants_have = (variants: Vec<Variant>, name: str) bool {
    Range(0, variants.len).find((i) {
        variants.get(i).match({
            Ok(v) => v.name.text.eq(name),
            None  => false,
        })
    }).match({ Ok(_) => true, None => false })
}

// The path a tag constant is built from.
enum_path* = (be :: CBackend, st: TyId, out :: String) Res<(), AllocError> {
    be.check.types.at(st).match({
        Res(_)   => out.add_bytes(RES_PATH),
        Named(n) => write_qname(be, out, n),
        _        => Ok(()),
    })
}

// The type a variant's payload has, or nothing when it carries none.
payload_type* = (be :: CBackend, st: TyId, variant: str) Res<TyId> {
    be.check.types.at(st).match({
        Res(r)   => res_payload(be, r, variant),
        Named(n) => enum_payload(be, n, variant),
        _        => None,
    })
}

res_payload = (be :: CBackend, r: TyRes, variant: str) Res<TyId> {
    variant.eq("Ok").match({
        true  => non_unit(be, r.value),
        false => res_error_payload(be, r, variant),
    })
}

res_error_payload = (be :: CBackend, r: TyRes, variant: str) Res<TyId> {
    is_failure(r.form).match({
        true  => non_unit(be, r.error),
        false => None,
    })
}

non_unit = (be :: CBackend, id: TyId) Res<TyId> {
    is_unit(be, id).match({
        true  => None,
        false => Ok(id),
    })
}

enum_payload = (be :: CBackend, n: TyNamed, variant: str) Res<TyId> {
    decl_at(be.tree, n.decl).match({
        None  => None,
        Ok(d) => decl_payload(be, n, d, variant),
    })
}

decl_payload = (be :: CBackend, n: TyNamed, d: Decl, variant: str)
               Res<TyId> {
    d.kind.match({
        Enum(e) => variant_payload(be, n, e.variants, variant),
        _       => None,
    })
}

variant_payload = (
    be       :: CBackend,
    n        : TyNamed,
    variants : Vec<Variant>,
    variant  : str
) Res<TyId> {
    found ::= be.alloc.Vec<TyId>();
    collect_payload(be, n, variants, variant, found).match({
        Err(_) => None,
        Ok(_)  => first_payload(be, found),
    })
}

// A payload is read at the ENUM'S OWN ARGUMENTS, exactly as a struct
// field is: `Slot<T>.Left` carries a `T`, and matching on a `Slot<u8>`
// binds a `u8`.
collect_payload = (
    be       :: CBackend,
    n        : TyNamed,
    variants : Vec<Variant>,
    variant  : str,
    found    :: Vec<TyId>
) Res<(), AllocError> {
    ctx  = decl_ctx(be, n);
    inst = decl_inst(be, n).try();
    mark = enter_struct_tparams(be, n.decl).try();
    variants.loop((h, v) {
        keep_payload(be, n, v, variant, ctx, inst, found).try();
    });
    leave_tparams(be, mark).try();
    Ok(());
}

keep_payload = (
    be      :: CBackend,
    n       : TyNamed,
    v       : Variant,
    variant : str,
    ctx     : Ctx,
    inst    : Inst,
    found   :: Vec<TyId>
)
               Res<(), AllocError> {
    v.name.text.eq(variant).match({
        false => Ok(()),
        true  => add_payload_type(be, n, v, ctx, inst, found),
    })
}

add_payload_type = (
    be    :: CBackend,
    n     : TyNamed,
    v     : Variant,
    ctx   : Ctx,
    inst  : Inst,
    found :: Vec<TyId>
) Res<(), AllocError> {
    variant_type(be, n, v, ctx, inst).match({
        Ok(t) => found.add(t),
        None  => Ok(()),
    })
}

first_payload = (be :: CBackend, found: Vec<TyId>) Res<TyId> {
    found.get(0).match({
        None  => None,
        Ok(t) => non_unit(be, t),
    })
}
