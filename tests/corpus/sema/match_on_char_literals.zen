// `b.match({ 'a' => .. })` — a match arm whose pattern is a CHARACTER
// literal. `match_on_str_literals.zen` covers the str scrutinee, which
// is the shape that needed a comparison written by hand; a char is a
// scalar and goes through `equality` like an integer, and nothing tested
// that it does. `gen_c_flow.literal_cond` could have dropped the `Char`
// arm into "always matches" and every test would still have passed.
//
// The escapes are the second half and the reason the byte is PRINTED
// beside its name. A char literal's text is handed to `cc` verbatim, so
// `'\n'` is one byte because C says so; the scrutinees come out of a
// STRING literal, whose bytes are C's but whose LENGTH `gen_c_expr`
// counts itself in `decoded_len`. The loop walks `s.len`, so a `\n`
// counted as two characters walks off the end of the string, and the
// byte printed beside the name is what makes that visible instead of
// merely probable.
//
// `'\''` and `'\\'` are the two that a naive scanner ends the literal
// on. The near misses matter as much as the hits: 'b' next to 'a', a
// carriage return next to a newline, and a byte no arm names all have to
// reach `_`, which is what says the comparison narrows rather than
// merely fires.

classify = (b: u8) str {
    b.match({
        'a'  => "letter-a",
        'z'  => "letter-z",
        '0'  => "digit-zero",
        '\n' => "newline",
        '\t' => "tab",
        '\\' => "backslash",
        '\'' => "quote",
        '"'  => "double-quote",
        ' '  => "space",
        _    => "other",
    })
}

show = (s: str) () {
    Range(0, s.len).loop((h, i) {
        println("{} {}", s[i], classify(s[i]));
    });
}

main = (env: Env) Res<i32, AllocError> {
    show("az0");
    show("\n\t\\'\" ");
    show("b\r1");
    Ok(0);
}
