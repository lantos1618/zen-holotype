// DESIGN.md: `println("{}", shape)` routes through the type's toString,
// and the sink it is handed is the CONSOLE -- so printing a value
// allocates nothing. main takes no allocator, which is the assertion:
// hello-world does not grow an arena because one of its values is a
// Display.

Tag = {
    ch: u8,
}

Tag.impl(Display, {
    toString ::= (self: @Self, out :: Sink) Res<(), WriteError> {
        out.write("<").try();
        out.write_byte(self.ch).try();
        out.write(">")
    }
})

main = (env: Env) Res<i32, AllocError> {
    a = Tag(ch: 'a');
    println("{}", a);
    println("one {} two {} three", a, Tag(ch: 'c'));
    println("{} {} {}", 7, a, true);
    Ok(0);
}
