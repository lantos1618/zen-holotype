Build = zen.zen_build
plan = zen.zen_build_plan
Target, Os, Arch, Abi = std.build
Map = std.collections

main = (env: Env) Res<i32, AllocError> {
    a ::= env.mem.alloc();
    b ::= a.Build(env, "src/fixture");
    b.set_std_root("src");
    docs    = a.Map<str, str>();
    checked = b.whole("build.zen", docs).try();
    target  = Target(os: Os.Linux, arch: Arch.X86_64, abi: Abi.Gnu);
    plan(a, b.tree, checked, target).match({
        Err(e) => println("plan refused"),
        Ok(p)  => {
            println("counts {} {} {}", p.imports.len, p.libs.len, p.exes.len);
            p.imports.get(0).match({
                None   => println("missing import"),
                Ok(ci) => println(
                    "import {} {} {}",
                    ci.name,
                    ci.spec.headers.get(0).match({ Ok(v) => v, None => "?" }),
                    ci.spec.libraries.get(0).match({ Ok(v) => v, None => "?" })
                ),
            });
            p.libs.get(0).match({
                None    => println("missing lib"),
                Ok(lib) => println("lib {} {}", lib.name, lib.spec.src.text),
            });
            p.exes.get(0).match({
                None    => println("missing exe"),
                Ok(exe) => println(
                    "exe {} {} {} {}",
                    exe.name,
                    exe.spec.src.text,
                    exe.spec.deps.get(
                        0
                    ).match({ Ok(v) => v.name, None => "?" }),
                    exe.spec.deps.get(1).match({ Ok(v) => v.name, None => "?" })
                ),
            });
        },
    });
    Ok(0)
}
