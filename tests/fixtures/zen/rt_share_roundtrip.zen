// rt M2 slice 1 (docs/rt-scoped-runtime.md §4): Shared<T> freeze round-trip. `share(v, a)` moves the
// value into a refcounted block; `.get()` reads it back (7) and `.count()` is 1 after the freeze; exit
// = 8. `.view()` yields a readonly Ptr<i32> (no write path). Drop frees the block.
share = std.mem.share
halloc = std.mem.heap
main = () i32 {
    heap := halloc.gpa()
    a := heap.addr()
    sh := share.share(7, a)
    p: Ptr<i32> := sh.view()
    r := to_i32(sh.get()) + to_i32(sh.count())
    sh.drop_in(a)
    r
}
