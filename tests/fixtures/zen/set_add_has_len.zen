halloc = std.mem.heap
sets = std.collections.set
{ Result, IoError } = std.core.result
{ println } = std.text.fmt
main = () i32 {
    alloc := halloc.gpa()
    a := alloc.addr()
    s := sets.of(a, 10).expect("of")
    s = s.add(a, 10).expect("add")
    println(s.len())
    s = s.add(a, 20).expect("add")
    s = s.add(a, 30).expect("add")
    s = s.add(a, 40).expect("add")
    s = s.add(a, 20).expect("add")
    println(s.len())
    println(s.has(30).then({ 1 }, { 0 }))
    println(s.has(99).then({ 1 }, { 0 }))
    s = s.remove(a, 30)
    println(s.len())
    println(s.has(30).then({ 1 }, { 0 }))
    sum := 0
    s.each((x) { sum = sum + x })
    println(sum)
    wr: Result<sets.Set<string_view>, IoError> := sets.empty(a)
    w := wr.expect("empty")
    w = w.add(a, "the").expect("add")
    w = w.add(a, "cat").expect("add")
    w = w.add(a, "the").expect("add")
    println(w.len())
    println(w.has("cat").then({ 1 }, { 0 }))
    println(w.has("dog").then({ 1 }, { 0 }))
    s.free(a)
    w.free(a)
    0
}
