// PROBE 2c: bound satisfied via typed bindings (literals are `int`, which has
// no Eq impl of its own).

Pt = {
    x: i32,
    y: i32,
}

same = <T: Eq>(a: T, b: T) bool { a.eq(b) }

mid = <N>(a: N, b: N) N { a }

Wrap<T> = { held: T }
wrap = <T>(t: T) Wrap<T> { Wrap(held: t) }

main = (env: Env) Res<i32, AllocError> {
    a1: u64 = 3000;
    a2: u64 = 3000;
    b1: u64 = 3001;
    println("eq {} {}", same(a1, a2), same(a1, b1));
    s1 = "ab";
    s2 = "ab";
    println("eq-str {}", same(s1, s2));

    p = Pt(x: 11, y: 22);
    q = mid(p, Pt(x: 99, y: 99));
    println("mid {} {}", q.x, q.y);

    // N learned from the binding's written type
    n: u8 = mid(1, 2);
    println("narrowed {}", n);

    w = wrap(4000000004);
    println("wrap {}", w.held);
    ws = wrap("deep");
    println("wrap-str {}", ws.held);

    // nested: generic call feeding a generic call
    inner = wrap(u8(200));
    outer = wrap(inner);
    println("nested {}", outer.held.held);
    Ok(0);
}
