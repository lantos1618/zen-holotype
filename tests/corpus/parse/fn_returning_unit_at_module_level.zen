// `g = (x: usize) () { .. }` — a declaration whose return type is
// written `()`.
//
// R1a classifies a declaration's value by the token after the parameter
// list's `)`, and that test deliberately refused a `(`, so that
// `g = (f)(x)` stays a call of a parenthesised callee. But a function
// that WRITES its unit return type has a `(` there too, so
// `strip_bom = (lx :: Lexer) () { .. }` in src/lex/lex_scan.zen was
// classified as a constant and its parameter list parsed as an
// expression.
//
// What tells the two apart is one more group: a second `(..)` followed
// by a `{` is a return type and a body, and a call is never followed by
// a block.

shout = (env: Env, n: i32) () { println("{}", n) }

// the signature-only spelling of the same thing, which has no `{` after
// it at all and must still not be read as a call
Sink = {
    put* = (self: @Self, n: i32) ()
}

main = (env: Env) Res<i32, ArgError> {
    shout(env, 7);
    Ok(0);
}
