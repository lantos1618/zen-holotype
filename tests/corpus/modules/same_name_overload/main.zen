// two modules define `label`. both are imported and both are used:
// resolution is on declared parameter types, so the names coexist
Circle, label = circle.circle
Square, label = square.square

main = (env: Env) Res<i32, IoError> {
    println(Circle(radius: 1).label());
    println(Square(side: 2).label());
    Ok(0);
}
