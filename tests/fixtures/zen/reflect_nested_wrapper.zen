Point: {
    x: i64,
    y: i64,
}
Rect: {
    a: Point,
    b: Point,
}
nested<T> = (v: T) T {
    w ::= v
    w.each_field((n, fv) {
        leaf ::= fv
        leaf.each_field((n2, fv2) { fv2 = fv2 + 1 })
        fv = leaf
    })
    w
}
wrapn<T> = (v: T) T { v.nested() }
main = () i32 {
    r = Rect(
        a: Point(
            x: 1,
            y: 1,
        ),
        b: Point(
            x: 1,
            y: 1,
        ),
    )
    r2 = wrapn(r)
    (r2.a.x == 2 && r2.b.y == 2).then({ 0 }, { 6 })
}
