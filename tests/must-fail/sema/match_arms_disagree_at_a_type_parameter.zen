// MUST FAIL: two arms of a `.match` disagree, and the parameter they
// stand at is DECLARED `T`. `match_arms_disagree_at_an_argument` is the
// same defect at a parameter with a concrete type; this is why closing
// it there was not enough.
//
// A TYPE VARIABLE EXPECTS NOTHING YET. `assignable` says every type
// reaches an unsubstituted parameter — that leniency is what lets one
// generic body be checked once — so `check_arms` asked both arms whether
// they fit `T`, both said yes, and the silence was indistinguishable
// from agreement.
//
// So the arms are their own authority here, exactly as at an untyped
// binding: `sema_call.param_holds` sends an unsettled parameter to
// `check_arms_agree`, which holds them to their own join.
id = <T>(x: T) T { x }

f = (b: bool) i32 {
    id(b.match({
        true  => 1,
        false => false,
    }))
}

main = (env: Env) Res<i32, ArgError> {
    println("{}", f(false));
    Ok(0);
}
