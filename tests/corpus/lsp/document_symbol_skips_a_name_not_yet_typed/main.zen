// A DECLARATION WHOSE NAME THE PARSER INVENTED IS NOT AN OUTLINE ENTRY.
//
// Mid-typing buffers carry one: `= ` parses as a declaration missing its
// name, and the parser's recovery Ident has EMPTY text. The protocol's
// `name` must not be falsy — one empty row makes the client (VS Code's
// `asSymbolInformation` validates) reject the WHOLE list, which is the
// error storm this test keeps from returning: the outline for a buffer
// with a bare `=` lists the real declarations and nothing else.

str, String = std.text
Alloc, AllocError = std.mem
Server, serve = lsp.lsp_serve
write_frame, frame_at = lsp.lsp_frame
write_text = std.json

// One real declaration, then the not-yet-typed one.
DOC*: str = "main = () {\n    println(\"hi\")\n}\n\n= \n"

URI*: str = "file:///a.zen"

main = (env: Env) Res<i32, AllocError> {
    a ::= env.mem.alloc();

    input ::= a.String().try();
    write_frame(
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}",
        input
    ).try();
    write_frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}",
        input
    ).try();
    open_doc(a, input).try();
    ask(a, input).try();
    write_frame(
        "{\"jsonrpc\":\"2.0\",\"id\":99,\"method\":\"shutdown\"}",
        input
    ).try();

    s   ::= a.Server(env);
    out ::= a.String().try();
    serve(s, input.view(), out).try();
    walk_replies(out.view());
    Ok(0);
}

open_doc = (a: Alloc, into :: String) Res<(), AllocError> {
    body ::= a.String().try();
    body.add(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":"
    ).try();
    write_text(URI, body).try();
    body.add(",\"text\":").try();
    write_text(DOC, body).try();
    body.add("}}}").try();
    write_frame(body.view(), into)
}

ask = (a: Alloc, into :: String) Res<(), AllocError> {
    body ::= a.String().try();
    body.add(
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/documentSymbol\",\"params\":{\"textDocument\":{\"uri\":"
    ).try();
    write_text(URI, body).try();
    body.add("}}}").try();
    write_frame(body.view(), into)
}

// Reply 0 is `initialize`, reply 1 is the outline, the last is
// `shutdown`; only the middle one is this test's row.
walk_replies = (out: str) () {
    at    ::= 0;
    seen  ::= 0;
    going ::= true;
    loop(() { going && at < out.len }, (h) {
        frame_at(out, at).match({
            Err(_) => { going = false; },
            Ok(fr) => { at = fr.next; shown(seen, fr.body); seen = seen + 1; },
        });
    });
}

shown = (i: usize, body: str) () {
    (i == 1).match({
        true  => println("    {}", body),
        false => (),
    });
}
