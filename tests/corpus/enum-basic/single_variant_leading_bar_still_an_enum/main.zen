// A SINGLE-VARIANT ENUM, WRITTEN WITH THE LEADING BAR. `Solo = | Lone(i64)`
// is the form DESIGN.md calls "the bar leads" -- the spelling that keeps a
// one-variant enum from parsing as an alias -- and it must still lay out as
// an enum: tag 0 plus the union member, not the payload bare. The neighbour
// enum keeps Solo from being the only type in the program, the same way
// field-default zeros hide when nothing else has a value.
//
// The wrong answers are all plausible numbers: lowering `|` to a no-op and
// storing 77777777 as the whole value prints it back fine here but breaks
// every two-variant read beside it; reading the payload from offset 0 of an
// enum whose member sits after the tag prints the tag (0) or garbage. Only
// the real layout survives BOTH the x13 multiply and Duo's second arm.

Solo = | Lone(i64)
Duo  = Heads | Tails

main = (env: Env) Res<i32, AllocError> {
    s: Solo = Solo.Lone(77777777);
    s.match({
        Lone(v) => println("lone {} x13 {}", v, v * 13),
    });
    d: Duo = Duo.Tails;
    d.match({
        Heads => println("heads"),
        Tails => println("tails"),
    });
    Ok(0);
}
