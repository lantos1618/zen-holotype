// MUST FAIL: an unannotated nullary variant of a GENERIC enum crosses a
// call boundary. `x = Opt.None` types x as the bare head (variant_value,
// sema_static.zen:132 -- "a nullary variant IS a value of the enum"),
// nothing downstream writes arguments for it, and `args_agree`
// (sema_check.zen) answered true to every arity mismatch -- so sema
// passed pick(x) while pick was monomorphised at Opt<i32> and the C
// named two structs for one value:
//
//     expected 'zu_t2_5repro3OptI1_b3i32' but argument is of type
//     'zu_t2_5repro3Opt'
//
// Zen exits 0 and cc is the type checker. A declaration that HAS type
// parameters wrote them for a reason: nothing agrees with its
// application by forgetting them.
//
// position: the argument that carries no answer, where the call asks
// what `x` is.

Opt<T> = Some(T) | None

pick = (o: Opt<i32>) i32 { o.match({ Some(v) => v, None => 0 }) }

main = (env: Env) Res<i32, AllocError> {
    x = Opt.None;
    println("{}", pick(x));
    Ok(0);
}
