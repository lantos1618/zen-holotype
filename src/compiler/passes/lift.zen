// compiler.passes.lift — lambda lifting sub-pass extracted from compiler.check.
{ ArmData, Decl, Expr, FieldInit, FnTData, Func, LambdaData, Param, Stmt, Ty } = compiler.ast.ast_types
{ cbuf, arm, arrow_at, bin_at, block, cond_oa, dfunc, eindex, eloop, ematch, ematchp, finit,
  gstr_append, gstr_finish, gstr_string, lam_r, member_at, mkenumg, mkstructg_at, sassign_at, sexpr,
  sidxset_at, sif, slett_at, slit, sret, swhile, tvoid, vref, acquire_or_die, acquire_or_die } = compiler.genc
{ gstr_int, map_slice } = compiler.astops
{ DeclIndex, VList, empty_params, pbuf, recall, var_bound, vcons, vnil } = compiler.check
{ field_fnt } = compiler.check_inline
{ Malloc } = std.mem.alloc
{ expr_fold_children } = compiler.ast.expr_children
lift_toplevel = (idx: DeclIndex, decls: [Decl], n: StringView) bool {
    idx.func_idx.get(n, 0 - 1) >= 0 || idx.global_idx.get(n, 0 - 1) >= 0
}
// A CALLED name that some impl (or trait default) provides is a METHOD dispatch, not a captured
// value. Without this, an identical lambda's liftability turned on whether an unrelated module
// happened to define a free fn of the same name — `release` exists in std.mem.raw, `acquire` does
// not, so `r.release(p)` lifted and `r.acquire(n)` did not.
lift_method = (idx: DeclIndex, n: StringView) bool { idx.tmethod_idx.get(n, 0 - 1) >= 0 }
lift_is_captured* = (decls: [Decl], idx: DeclIndex, bound: Ptr<VList>, n: StringView) bool {
    (bound.var_bound(n) || idx.lift_toplevel(decls, n) || n == "true" || n == "false").match ({
        true  => false,
        false => true,
    })
}
lift_extend* = (a: MutPtr<Malloc>, bound: Ptr<VList>, st: Stmt) Ptr<VList> {
    st.match ({
        .Let(l) => a.vcons(l.name, tvoid(), bound),
        _       => bound,
    })
}
lift_lamparams* = (a: MutPtr<Malloc>, bound: Ptr<VList>, ps: [Param]) Ptr<VList> {
    out := bound
    ps.loop((h, i, p) {
        out = a.vcons(p.name, tvoid(), out)
    })
    out
}
lift_args_cap = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    bound: Ptr<VList>,
    xs: [Expr],
) bool {
    found := false
    xs.loop((h, i, x) {
        found = found.then({ true }, { a.lift_expr_cap(decls, idx, bound, x.addr()) })
    })
    found
}
lift_arms_cap = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    bound: Ptr<VList>,
    arms: [ArmData],
) bool {
    found := false
    arms.loop((h, i, ar) {
        found = found.match ({
            true  => true,
            false => a.lift_expr_cap(decls, idx, a.vcons(ar.bind, tvoid(), bound), ar.body),
        })
    })
    found
}
lift_body_cap = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    bound: Ptr<VList>,
    body: [Stmt],
) bool {
    found := false
    b := bound
    body.loop((h, i, st) {
        found = found.then({ true }, { a.lift_stmt_cap(decls, idx, b, st) })
        b = a.lift_extend(b, st)
    })
    found
}
lift_stmt_cap = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    bound: Ptr<VList>,
    st: Stmt,
) bool {
    st.match ({
        .Let(l)      => a.lift_expr_cap(decls, idx, bound, l.value),
        .Assign(x)   => a.lift_expr_cap(decls, idx, bound, x.target)
            || a.lift_expr_cap(decls, idx, bound, x.value),
        .Return(r)   => a.lift_expr_cap(decls, idx, bound, r),
        .ExprStmt(e) => a.lift_expr_cap(decls, idx, bound, e),
        .If(f)       => a.lift_expr_cap(decls, idx, bound, f.c)
            || a.lift_body_cap(decls, idx, bound, f.then)
            || a.lift_body_cap(decls, idx, bound, f.els),
        .While(w)    => a.lift_expr_cap(decls, idx, bound, w.c)
            || a.lift_body_cap(decls, idx, bound, w.body),
        .IndexSet(x) => a.lift_expr_cap(decls, idx, bound, x.seq)
            || a.lift_expr_cap(decls, idx, bound, x.idx)
            || a.lift_expr_cap(decls, idx, bound, x.value),
    })
}
lift_expr_cap = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    bound: Ptr<VList>,
    e: Ptr<Expr>,
) bool {
    load(e).match ({
        // the shapes that are NOT a plain descent: `.Var`/`.Call` NAME a binding, and
        // `.Match`/`.Loop`/`.Lambda` EXTEND the bound set for their bodies (arm binder, loop
        // idx/elem, lambda params). Everything else delegates to the one exhaustive child listing.
        .Var(v)     => lift_is_captured(decls, idx, bound, v.name),
        .Call(c)    => lift_is_captured(decls, idx, bound, c.fn) && idx.lift_method(c.fn) == false
            || a.lift_args_cap(decls, idx, bound, c.args),
        .Match(m)   => a.lift_expr_cap(decls, idx, bound, m.subj)
            || a.lift_arms_cap(decls, idx, bound, m.arms),
        .Loop(l)    => a.lift_expr_cap(decls, idx, bound, l.seq)
            || a.lift_body_cap(decls, idx, a.vcons(l.idx, tvoid(), a.vcons(l.elem, tvoid(), bound)), l.body),
        .Lambda(la) => a.lift_body_cap(decls, idx, a.lift_lamparams(bound, la.params), la.body),
        _           => false.expr_fold_children(e, (acc, ch) {
            acc || a.lift_expr_cap(decls, idx, bound, ch)
        }, (acc, body) { acc || a.lift_body_cap(decls, idx, bound, body) }),
    })
}
// a lambda is liftable iff it does NOT capture (only its own params + body binders + top-level names).
lift_liftable* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, lm: LambdaData) bool {
    a.lift_body_cap(decls, idx, a.lift_lamparams(a.vnil(), lm.params), lm.body) == false
}
// --- the lift transform: replace each liftable lambda (in a field-init / return value) with the name
//     of a freshly generated top-level fn, collected (with a shared counter) for appending. ---
lift_name = (a: MutPtr<Malloc>, k: i64) StringView {
    s := a.gstr_string(24).gstr_append(a, "__lam_")
    s.gstr_int(a, k).gstr_finish(a)
}
// the (function) type of struct `sty`'s field `fname` — substituted for a generic instance's targs.
lift_func_of = (a: MutPtr<Malloc>, lm: LambdaData, ft: FnTData, name: StringView) Decl {
    ps := a.pbuf(lm.params.len)
    lm.params.loop((h, i, p) {
        ps[i] = param(p.name, (i < ft.params.len).then({ ft.params[i] }, { tvoid() }))
    })
    dfunc(Func(
        name: name,
        params: ps,
        ret: load(ft.ret),
        tparams: empty_params(),
        body: lm.body,
    ))
}
// A lambda lifted out of a GENERIC body still names its enclosing type params (`r: MutPtr<A> := s`),
// so the lifted fn must carry them — otherwise it is a top-level fn mentioning an undeclared `A`. The
// decls generated while rewriting ONE function are exactly gen[lo..hi), so stamping that range covers
// every nesting depth. A tparam'd lifted fn is a TEMPLATE (genc skips it); the mono INSTANCE of the
// enclosing fn was copied before this pass and lifts its own already-substituted lambda.
lift_tag_tparams = (gen: [Decl], lo: i32, hi: i32, tps: [Param]) void {
    (tps.len > 0).then({
        gen.loop((h, i, g) {
            (i >= lo && i < hi).then({
                gen[i] = g.match ({
                    .DFunc(f) => dfunc(Func(
                        name: f.name,
                        params: f.params,
                        ret: f.ret,
                        tparams: tps,
                        body: f.body,
                    )),
                    _         => g,
                })
            })
        })
    })
}
// lift the value `val` if it is a liftable lambda whose expected type `fnt` is a function type; else
// recurse so nested lift sites are still found.
lift_at = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    gcp: RawPtr<u8>,
    gen: [Decl],
    fnt: Ty,
    val: Ptr<Expr>,
) Ptr<Expr> {
    load(val).match ({
        .Lambda(lm) => fnt.match ({
            .FnT(ft) => a.lift_liftable(decls, idx, lm).match ({
                true  => {
                    k := load_i64(gcp)
                    nm := a.lift_name(k)
                    gen[k.to_i32()] = a.lift_func_of(lm, ft, nm)
                    store_i64(gcp, k + 1)
                    a.cenode(vref(nm))
                },
                false => a.lift_rw_expr(decls, idx, gcp, gen, val),
            }),
            _        => a.lift_rw_expr(decls, idx, gcp, gen, val),
        }),
        _           => a.lift_rw_expr(decls, idx, gcp, gen, val),
    })
}
lift_rw_args = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    gcp: RawPtr<u8>,
    gen: [Decl],
    xs: [Expr],
) [Expr] {
    buf := a.cebuf(xs.len)
    xs.loop((h, i, x) {
        buf[i] = load(a.lift_rw_expr(decls, idx, gcp, gen, x.addr()))
    })
    buf
}
lift_rw_inits = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    gcp: RawPtr<u8>,
    gen: [Decl],
    sty: StringView,
    targs: [Ty],
    inits: [FieldInit],
) [FieldInit] {
    map_slice(a, inits, (fi) {
        finit(fi.name, a.lift_at(decls, idx, gcp, gen, a.field_fnt(decls, idx, sty, targs, fi.name), fi.value))
    })
}
lift_rw_arms = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    gcp: RawPtr<u8>,
    gen: [Decl],
    arms: [ArmData],
) [ArmData] {
    map_slice(a, arms, (ar) {
        arm(ar.variant, ar.bind, a.lift_rw_expr(decls, idx, gcp, gen, ar.body))
    })
}
lift_rw_expr = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    gcp: RawPtr<u8>,
    gen: [Decl],
    e: Ptr<Expr>,
) Ptr<Expr> {
    load(e).match ({
        .MakeStruct(s) => a.cenode(mkstructg_at(s.ty, s.mty, s.targs, a.lift_rw_inits(decls, idx, gcp, gen, s.ty, s.targs, s.inits), s.pos)),
        .Bin(b)        => a.cenode(bin_at(b.op, a.lift_rw_expr(decls, idx, gcp, gen, b.lhs), a.lift_rw_expr(decls, idx, gcp, gen, b.rhs), b.pos)),
        .Cond(d)       => a.cenode(cond_oa(a.lift_rw_expr(decls, idx, gcp, gen, d.c), a.lift_rw_expr(decls, idx, gcp, gen, d.t), a.lift_rw_expr(decls, idx, gcp, gen, d.e), d.oa)),
        .Member(m)     => a.cenode(member_at(a.lift_rw_expr(decls, idx, gcp, gen, m.obj), m.field, m.pos)),
        .Arrow(ar)     => a.cenode(arrow_at(a.lift_rw_expr(decls, idx, gcp, gen, ar.obj), ar.field, ar.pos)),
        .Call(c)       => a.recall(c, c.fn, a.lift_rw_args(decls, idx, gcp, gen, c.args)),
        .MakeEnum(mk)  => a.cenode(mkenumg(mk.ty, mk.mty, mk.targs, mk.variant, a.lift_rw_expr(decls, idx, gcp, gen, mk.payload))),
        .Match(m)      => m.ptr.match ({
            true  => a.cenode(ematchp(a.lift_rw_expr(decls, idx, gcp, gen, m.subj), m.ename, a.lift_rw_arms(decls, idx, gcp, gen, m.arms))),
            false => a.cenode(ematch(a.lift_rw_expr(decls, idx, gcp, gen, m.subj), m.ename, a.lift_rw_arms(decls, idx, gcp, gen, m.arms))),
        }),
        .Index(ix)     => a.cenode(eindex(a.lift_rw_expr(decls, idx, gcp, gen, ix.seq), a.lift_rw_expr(decls, idx, gcp, gen, ix.idx), ix.elem)),
        .SliceLit(sd)  => a.cenode(slit(sd.elem, a.lift_rw_args(decls, idx, gcp, gen, sd.items))),
        .Loop(l)       => a.cenode(eloop(a.lift_rw_expr(decls, idx, gcp, gen, l.seq), l.idx, l.elem, l.elemTy, a.lift_rw_body(decls, idx, gcp, gen, tvoid(), l.body), l.h)),
        .Block(bl)     => a.cenode(block(a.lift_rw_body(decls, idx, gcp, gen, tvoid(), bl.stmts))),
        .Lambda(lm)    => a.cenode(lam_r(lm.params, a.lift_rw_body(decls, idx, gcp, gen, tvoid(), lm.body), lm.ret)),
        _              => e,
    })
}
// Lambdas lift in value positions the inliner can't splice: STRUCT-FIELD inits (lift_rw_inits) and
// RETURN / tail-expression positions (a body's implicit return) when the declared return type is a
// function type — `fnret` carries that type; `tail` marks the body's last (implicit-return) statement.
lift_rw_stmt = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    gcp: RawPtr<u8>,
    gen: [Decl],
    fnret: Ty,
    tail: bool,
    st: Stmt,
) Stmt {
    st.match ({
        .Let(l)      => slett_at(l.name, l.ty, a.lift_rw_expr(decls, idx, gcp, gen, l.value), l.pos),
        .Assign(x)   => sassign_at(a.lift_rw_expr(decls, idx, gcp, gen, x.target), a.lift_rw_expr(decls, idx, gcp, gen, x.value), x.pos),
        .Return(r)   => sret(a.lift_at(decls, idx, gcp, gen, fnret, r)),
        .ExprStmt(e) => sexpr(tail.match ({
            true  => a.lift_at(decls, idx, gcp, gen, fnret, e),
            false => a.lift_rw_expr(decls, idx, gcp, gen, e),
        })),
        .If(f)       => sif(a.lift_rw_expr(decls, idx, gcp, gen, f.c), a.lift_rw_body(decls, idx, gcp, gen, fnret, f.then), a.lift_rw_body(decls, idx, gcp, gen, fnret, f.els)),
        .While(w)    => swhile(a.lift_rw_expr(decls, idx, gcp, gen, w.c), a.lift_rw_body(decls, idx, gcp, gen, tvoid(), w.body)),
        .IndexSet(x) => sidxset_at(a.lift_rw_expr(decls, idx, gcp, gen, x.seq), a.lift_rw_expr(decls, idx, gcp, gen, x.idx), x.elem, a.lift_rw_expr(decls, idx, gcp, gen, x.value), x.pos),
    })
}
lift_rw_body = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    gcp: RawPtr<u8>,
    gen: [Decl],
    fnret: Ty,
    body: [Stmt],
) [Stmt] {
    buf := cbuf<Stmt>(a, body.len)
    body.loop((h, i, st) {
        buf[i] = a.lift_rw_stmt(decls, idx, gcp, gen, fnret, i == body.len - 1, st)
    })
    buf
}
lift_rw_decl = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    gcp: RawPtr<u8>,
    gen: [Decl],
    d: Decl,
) Decl {
    d.match ({
        .DFunc(f) => {
            lo := load_i64(gcp).to_i32()
            nb := a.lift_rw_body(decls, idx, gcp, gen, f.ret, f.body)
            gen.lift_tag_tparams(lo, load_i64(gcp).to_i32(), f.tparams)
            dfunc(Func(
                name: f.name,
                params: f.params,
                ret: f.ret,
                tparams: f.tparams,
                body: nb,
                pos: f.pos,
            ))
        },
        _         => d,
    })
}
lift_lambdas* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex) [Decl] {
    gcp: RawPtr<u8> := a.acquire_or_die(8)
    store_i64(gcp, 0)
    gen := cbuf<Decl>(a, 4096)
    out := cbuf<Decl>(a, decls.len + 4096)
    decls.loop((h, i, d) {
        out[i] = a.lift_rw_decl(decls, idx, gcp, gen, d)
    })
    n := load_i64(gcp)
    k := decls.len
    gen.loop((h, i, g) {
        (i < n.to_i32()).then({
            out[k] = g
            k = k + 1
        })
    })
    slice(out.ptr, k)
}
// ── M1 keystone: ESCAPING capturing closures → a by-value closure struct ─────────────────────────
// A function whose DECLARED return is a function type `(P…)R` and whose body TAIL is a lambda that
// CAPTURES the function's parameters cannot inline-splice (it escapes the frame) nor bare-fn-lift (a
// bare C function pointer carries no environment). Lower it to a by-value closure with NO hidden heap:
//   • a generated struct `__clos_K { p1: T1, … }` holding the enclosing params by value;
//   • a top-level call fn `__clos_K_call = (__clenv: __clos_K, P…) R { body[pN -> __clenv.pN] }`.
// The tail lambda becomes the struct literal `__clos_K{ p1: p1, … }`, so the function returns the
// closure BY VALUE (a struct copy). A later indirect call `g(args)` on a closure-typed local is
// rewritten by resolve_call to `__clos_K_call(g, args)`. SUPPORTED captures are the enclosing
// function's PARAMETERS; a lambda that captures a non-parameter LOCAL is left untouched (it falls
// through to the clean error[lambda-value]). The whole enclosing param row is captured (harmless
// over-capture keeps the lowering simple and avoids per-name free analysis for the struct shape).
