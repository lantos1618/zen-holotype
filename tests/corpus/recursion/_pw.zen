// probeW: create in a helper taking Alloc, but call the method with explicit
// type argument spelling a.create<i64>()
mk = (a: Alloc) Res<Ptr<i64>, AllocError> {
    p = a.create<i64>().try();
    p.write(0, 7);
    Ok(p);
}

main = (env: Env) Res<i32, AllocError> {
    aa ::= env.mem.alloc();
    p = mk(aa).try();
    println("v {}", p.read(0));
    Ok(0);
}
