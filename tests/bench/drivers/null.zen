// tests/bench/drivers/null.zen
// the zero point every bench is measured against: same staging, same
// std, same process spawn, no loop. bench.py subtracts this wall time
// from each bench's before dividing by iterations, so process startup
// and prelude setup are not counted as op cost.

main = (env: Env) Res<i32, IoError> {
    Ok(0);
}
