// A generic call is accepted only after its argument and answer agree on T.
// The native answer makes a wrong monomorphization observable.
identity = <T>(value: T) T { value }

main = (env: Env) Res<i32, AllocError> {
    value: i32 = identity(41);
    println("generic {}", value + 1);
    (env.argv.len > 0).match({ true => Ok(0), false => Ok(9) })
}
