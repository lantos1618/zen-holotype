Pos, Span = std.ast

main = () () {
    text = "x = \"é\"\r\nnext\n";
    span = Span(
        file: "sample.zen",
        start: Pos(line: 1, col: 6),
        end: Pos(line: 1, col: 8)
    );
    println(
        "byte columns {}",
        span.text_in(text).match({ Ok(body) => body.eq("é"), None => false })
    );
    println("crlf {}", Pos(line: 2, col: 1).offset_in(text).value_or(99) == 10);
    println(
        "final empty line {}",
        Pos(line: 3, col: 1).offset_in(text).value_or(99) == text.len
    );
    println(
        "empty source {}",
        Pos(line: 1, col: 1).offset_in("").value_or(99) == 0
    );
    println(
        "invalid line {}",
        Pos(line: 4, col: 1).offset_in(text).match({ None => true, Ok(_) => false })
    );
    println(
        "invalid column {}",
        Pos(line: 2, col: 8).offset_in(text).match({ None => true, Ok(_) => false })
    );
    println(
        "zero refused {}",
        Pos(line: 0, col: 1).offset_in(text).match({ None => true, Ok(_) => false })
    );
    reverse = Span(file: "sample.zen", start: span.end, end: span.start);
    println(
        "reversed refused {}",
        reverse.text_in(text).match({ None => true, Ok(_) => false })
    );
}
