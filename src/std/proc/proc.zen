// src/std/proc/proc.zen
// Safe process execution over the native floor.

Alloc, AllocError, Ptr, null_ptr = std.mem
str, String, str_at = std.text
Res, ok_or = std.core

zg_proc_run = (
    cwd      : str,
    cmd      : str,
    code_out : Ptr<i32>,
    out_buf  : Ptr<Ptr<u8>>,
    out_len  : Ptr<usize>,
    err_buf  : Ptr<Ptr<u8>>,
    err_len  : Ptr<usize>
) i32

free = (p: Ptr<()>) ()

ProcError* = SpawnFailed | WaitFailed | ReadFailed

ProcOutput* = {
    code*: i32,
    out*:  String,
    err*:  String,
}

proc_error = (rc: i32) ProcError {
    rc.match({
        1 => SpawnFailed,
        2 => WaitFailed,
        _ => ReadFailed,
    })
}

string_from_c = (a: Alloc, p: Ptr<u8>, n: usize) Res<String, ProcError> {
    @scope.defer(() { free(p.to<()>()) });
    s ::= a.String().try(ProcError.ReadFailed);
    view = str_at(p, n);
    s.add(view).try(ProcError.ReadFailed);
    Ok(s);
}

Process* = {
    run* = (self: @Self, a: Alloc, cwd: str, cmd: str) Res<ProcOutput, ProcError> {
        code_p ::= a.create<i32>().try(ProcError.ReadFailed);
        code_p.write(0, 0);
        out_p_p ::= a.create<Ptr<u8>>().try(ProcError.ReadFailed);
        out_p_p.write(0, null_ptr<u8>());
        out_n_p ::= a.create<usize>().try(ProcError.ReadFailed);
        out_n_p.write(0, 0);
        err_p_p ::= a.create<Ptr<u8>>().try(ProcError.ReadFailed);
        err_p_p.write(0, null_ptr<u8>());
        err_n_p ::= a.create<usize>().try(ProcError.ReadFailed);
        err_n_p.write(0, 0);

        rc = zg_proc_run(cwd, cmd, code_p, out_p_p, out_n_p, err_p_p, err_n_p);

        (rc == 0).match({
            false => Err(proc_error(rc)),
            true  => {
                code  = code_p.read(0);
                out_p = out_p_p.read(0);
                out_n = out_n_p.read(0);
                err_p = err_p_p.read(0);
                err_n = err_n_p.read(0);

                string_from_c(a, out_p, out_n).match({
                    Err(e)    => {
                        free(err_p.to<()>());
                        Err(e)
                    },
                    Ok(out_s) => string_from_c(a, err_p, err_n).match({
                        Err(e)    => Err(e),
                        Ok(err_s) => Ok(ProcOutput(
                            code: code,
                            out:  out_s,
                            err:  err_s
                        )),
                    }),
                });
            },
        })
    }
}
