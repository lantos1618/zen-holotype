// THE TWO HALVES OF STD TALK. `usize` is what every length and index
// is (Vec.len, argv.len, Range) and `u64` is what Duration(ns:) and
// Hash.hash are -- before issue 756 a count could never become a
// duration. Every conversion below was refused as "no `to_u64` on
// `usize`" until std.core.num declared them; the digit-parse line is
// the issue's own second example.
//
// Values past i32's range ride along to prove no half-width hop;
// usize.MAX itself stays unprinted -- no corpus test may print a usize
// extreme (std/core/num.zen says why).

check = (x: bool) str {
    x.match({
        true  => "yes",
        false => "no",
    });
}

main = (env: Env) Res<i32, AllocError> {
    n: usize = 4000734512;
    b: u8    = 7;
    w: u16   = 400;
    d: u8    = '5';
    println("{}", n.to_u64());
    println("{}", b.to_usize());
    println("{}", w.to_usize());
    println("{}", check(n.to_u64() == 4000734512));
    println("{}", check((d - '0').to_usize().to_u64() == 5));
    Ok(0);
}
