// `*` binds tighter than `+%`: max +% two * two is max +% (2 * 2),
// which wraps to -2147483645.
// the other reading, (max +% 2) * 2, is -2147483647 * 2 and TRAPS.

main = (env: Env) Res<i32, ArgError> {
    max: i32 = 2147483647;
    two: i32 = 2;
    v        = max +% two * two;
    println("{}", v);
    Ok(0);
}
