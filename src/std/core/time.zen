// std.core.time
// a span, not a clock. reading the clock is authority and lives
// on Env; describing a duration is arithmetic and lives here

Duration* = {
    ns*: u64,
}

nanos*   = (n: u64) Duration
micros*  = (n: u64) Duration
millis*  = (n: u64) Duration
seconds* = (n: u64) Duration
minutes* = (n: u64) Duration

// Duration.seconds(60) reads better than seconds(60) at a call
// site far from this module, and both spellings are the same
// function — a constant is looked up on the type, a ufcs call on
// the argument
add* = (self: Duration, other: Duration) Duration
sub* = (self: Duration, other: Duration) Res<Duration>
millis_of* = (self: Duration) u64
