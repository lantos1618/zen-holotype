// The display protocol. One method an impl defines — write yourself
// into a caller-owned Sink — plus an allocating form derived from it.
//
// `toString` takes a Sink the caller owns, so nesting and console
// printing allocate nothing. A String param instead would need an
// Alloc `println` doesn't have — allocating behind the caller's back
// or forcing simple printing into an arena. Deriving the allocating form
// keeps both representations identical.

Alloc = std.mem
String = std.text
Sink, WriteError = std.core.io

// Every form speaks WriteError: a Sink may report I/O failure and the derived
// String form may report allocation failure.

Display* = {
    // Optional structural fallback used when an impl has no pretty form.
    // Its eventual default body depends on field reflection.
    dump* ::= (self: @Self, out :: Sink) Res<(), WriteError>

    // The pretty representation. Formatting routes through this when present
    // and otherwise uses dump.
    toString* ::= (self: @Self, out :: Sink) Res<(), WriteError>

    // Allocating convenience derived from the Sink form.
    toString* = (self: @Self, a: Alloc) Res<String, WriteError> {
        sb ::= a.String().try();
        self.toString(sb).try();
        Ok(sb);
    }
}
