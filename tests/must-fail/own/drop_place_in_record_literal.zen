// A LIVE DROP PLACE INSIDE A RECORD LITERAL. `Keeper(n: v)` copies
// every field value's bytes into the new value, so with `v` still
// alive there are two owners and drop would run twice — the same
// defect as `g = f`, one node deeper. The legal spelling is
// `consume v` at the field (m9 pins that it is accepted and drops
// once). check_drop_copy reaches Record literals since the ctor rule;
// this file goes red if that reach ever disappears.
//
// (Array literals take the same walk; a sibling could pin them, but
// one node shape is enough to hold the rule in place.)

Noisy = {
    env: Env,
    id: i64,
}

Noisy.impl(Drop, {
    drop = (self :: @Self) () { println("drop {}", self.id) }
})

Keeper = {
    n: Noisy,
}

main = (env: Env) Res<i32, AllocError> {
    v = Noisy(env: env, id: 7);
    k = Keeper(n: v);
    println("made");
    Ok(0);
}
