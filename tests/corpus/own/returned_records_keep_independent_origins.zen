Input = { text: str, scratch: str }
Envelope = { input: Input, other: str }
Box = { text :: str }
identity = <T>(value: T) T { value }
wrap = (input: Input) Envelope { Envelope(input: input, other: "stable") }
view = (
    envelope : Envelope
) str { alias = envelope; inner = alias.input; inner.text }
put = (box :: Box, envelope: Envelope) () { box.text = view(envelope); }
fill = (env: Env, box :: Box, text: str) Res<(), AllocError> {
 a        = env.mem.alloc();
 local    = a.String("temporary").try();
 input    = Input(text: text, scratch: local.view());
 alias    = identity(input);
 envelope = wrap(alias);
 put(box, envelope);
 println(box.text);
 Ok(())
}
main = (env: Env) Res<(), AllocError> {
 box ::= Box(text: ""); fill(env, box, "caller").try(); println(box.text); Ok(())
}
