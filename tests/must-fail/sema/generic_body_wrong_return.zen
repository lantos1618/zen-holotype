// The return type a generic declares is a promise its body has to fit
// at the declaration, not at the call: a `str` tail is not an `i32`
// under any `T`. Checked only per instantiation, this compiled clean
// for exactly as long as nobody called it.
//
// position: the tail expression, which is the value that has to change.

broken* = <T>(x: T) i32 { "not an int" }

main* = () () {}
