// A NO-RANGE LOOP'S PAYLOAD IS WHAT THE BODY BREAKS WITH -- `h.break(-7)`
// comes back -7, signed, not reinterpreted through a usize slot.
//
// `loop((h){..})` has no range and no item: the break arguments are the
// only type source for the loop's T. The backend settled the payload to
// usize unconditionally, so -7 kept its bits and lost its sign --
// printing 18446744073709551609. The payload must be taken from what the
// body breaks with.
//
// breaks this: settling a no-range loop's payload at usize instead of
// the body's break arguments.
//
// issue: 784

main = (env: Env) Res<i32> {
    r = loop((h) { h.break(-7); });
    r.match({ Ok(v) => println("got {}", v), None => println("none") });
    Ok(0);
}
