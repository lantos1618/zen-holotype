// The ambient rt inside a behavior is the actor's own rt.
// The actor is spawned with a COUNTING rt whose `acquire` bumps a counter. Its `receive` calls the
// AMBIENT `rt.alloc` (no rt param threaded) — which resolves to `rt.current()`, i.e. the thread-local
// slot the pool worker set to THIS actor's rt around the behavior (pool.zen rt.enter/leave). So each of
// the N messages drives the counter by exactly one: after quiescence, counter == N proves the worker
// injected the actor's rt as the ambient before `receive`. Adversarial: if the slot write were removed,
// `rt.current()` would fall back to the heap default, the counting `acquire` would never fire, and the
// counter would stay 0 — a different exit code. Exit N (== 40) == proof holds.
{ pool_open, Pool } = std.concurrent.pool
{ malloc, free, realloc, Allocator, AllocatorVTable, allocator_of } = std.mem.alloc
{ mem_rt, alloc, release } = std.rt
pa = std.concurrent.pool_actor
{ Context, Receiver } = std.concurrent.pool_actor
N = 40
allocs = malloc(8)    // the counting rt's counter: # of ambient allocs observed inside behaviors
Msg*: Ping
Probe*: {
    hits: i64,
}
// counting allocator vtable (state = the `allocs` counter). `acquire` bumps the counter, so an ambient
// rt.alloc executed under this rt is OBSERVABLE.
count_acquire = (state: RawPtr<u8>, n: i64) RawPtr<u8> {
    atomic_add_i64(state, 1)
    malloc(n)
}
count_resize = (state: RawPtr<u8>, p: RawPtr<u8>, n: i64) RawPtr<u8> { realloc(p, n) }
count_release = (state: RawPtr<u8>, p: RawPtr<u8>) void { free(p) }
count_vtable ::= AllocatorVTable(
    vt_alloc: count_acquire,
    vt_remap: count_resize,
    vt_free: count_release,
)
count_allocator = (state: RawPtr<u8>) Allocator {
    allocator_of(state, count_vtable.addr().offset(0))
}
Probe.impl(Receiver, {
    receive = (pr: MutPtr<Probe>, ctx: Context<Msg>) void {
        ctx.msg.match ({
            .Ping => {
                q = alloc(16)    // AMBIENT alloc — resolves to the actor's counting rt (the proof)
                release(q)
                pr.hits = pr.hits + 1
            },
        })
    }
})
tramp = (user: RawPtr<u8>, msg: i64) void {
    a: [Probe] = user.slice(1)
    b: [Msg] = msg.offset(0).slice(1)
    a[0].addr().receive(Context(msg: b[0]))
    pa.free_msg(msg)
}
send_pings = (p: MutPtr<Pool>, h: pa.PooledHandle<Probe>, k: i64) void {
    (k < N).then({
        p.send(h, Msg.Ping)
        send_pings(p, h, k + 1)
    })
}
main = () i32 {
    store_i64(allocs, 0)
    crt = mem_rt(count_allocator(allocs))
    h = pa.spawn_actor(64, Probe(hits: 0), tramp, crt)
    p = pool_open(2, 8)
    send_pings(p, h, 0)
    p.pool_quiesce_stop()
    observed = load_i64(allocs)
    hits = pa.actor_state(h).hits
    pa.close(h)
    p.pool_close()
    free(allocs)
    // proof: the counting rt fired once per message (ambient == the actor's rt) AND the actor saw all N.
    (observed == N).match ({
        true  => (hits == N).then({ to_i32(observed) }, { 1 }),
        false => 2,
    })
}
