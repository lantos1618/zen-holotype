// src/lsp/lsp_json.zen
// JSON as a value, an arena over it, and the writer.
//
// Nothing else in this tree speaks JSON, and the protocol does — the
// first of `design_lsp.md` §1's five genuinely-new things.
//
// IT LIVES HERE AND IT MOVES. `STYLE.md`'s stranger test would put it in
// `std`, but `src/std/env/env.zen:83` warns every `std` member is one
// the self-hosted compiler must keep working forever, and the compiler
// will never parse JSON — so it stays in `src/lsp/` until `std.json` the
// day a second caller wants it.
//
// A CHILD IS AN ID, NEVER A VALUE (`src/AST_CONTRACT.md` rule 2): an
// `Obj` holding a `Json` holding an `Obj` has no size, so recursion goes
// through an arena exactly as `Expr` does. An array and object each name
// a contiguous RUN in a side list.
//
// A NUMBER IS ITS LEXEME: `Num` carries the bytes it was written with,
// not a parsed value. JSON's number grammar is not Zen's (`1e10`, `-0`
// are valid JSON; `DESIGN.md:99` rejects a leading zero) so parsing into
// a Zen numeric type would REJECT valid JSON, which a transport may not
// do. Every number this server reads is a small non-negative integer
// (`whole` is that narrow reading), and keeping the lexeme makes the
// writer byte-exact for free — what makes the round-trip gate mean
// something.

str, String = std.text
Vec = std.collections
Alloc, AllocError = std.mem
Range = std.core
hex_digit = std.core.byte

// An index into a `Jsons`. A struct, not a bare usize — same reason
// `ExprId` is not one.
JsonId* = { index*: usize }

// A contiguous run in one of the side lists: arrays name a run of
// `items`, objects a run of `pairs`.
Run* = {
    at*: usize,
    len*: usize,
}

// One member of an object: the DECODED key, and its value — a lookup
// comparing raw lexemes would miss members whose escapes differ.
Pair* = {
    key*: str,
    value*: JsonId,
}

// The six JSON values. `Text` rather than `Str`, since `str` is a type
// in scope and a shadowing variant reads as a mistake.
Json* = Null
      | Bool(bool)
      | Num(str)      // the lexeme, verbatim
      | Text(str)     // the decoded bytes
      | Arr(Run)      // a run of `items`
      | Obj(Run)      // a run of `pairs`

// The arena — same shape and idea as sema's `Types`: one store owning
// every value, and ids that mean nothing without it.
Jsons* = {
    nodes :: Vec<Json>,
    items :: Vec<JsonId>,
    pairs :: Vec<Pair>,

    // An id no `Jsons` handed out is a caller bug, so it TRAPS rather
    // than answering `Null`. The subtraction IS the check, `str.index`'s
    // idiom.
    at* = (self: @Self, id: JsonId) Json {
        self.nodes.len - id.index - 1;
        self.nodes.get(id.index).match({
            Ok(v) => v,
            None  => Json.Null,
        })
    }

    add* = (self :: @Self, v: Json) Res<JsonId, AllocError> {
        id = JsonId(index: self.nodes.len);
        self.nodes.add(v).try();
        Ok(id);
    }

    // Append a built-up list of children as ONE run, copied from a
    // caller-owned `Vec` since a nested array's own children land in
    // `items` between its siblings'.
    add_items* = (self :: @Self, ids: Vec<JsonId>) Res<Run, AllocError> {
        run = Run(at: self.items.len, len: ids.len);
        Range(0, ids.len).loop((h, i) {
            self.items.add(id_or_zero(ids.get(i))).try();
        });
        Ok(run);
    }

    add_pairs* = (self :: @Self, ps: Vec<Pair>) Res<Run, AllocError> {
        run = Run(at: self.pairs.len, len: ps.len);
        Range(0, ps.len).loop((h, i) {
            self.pairs.add(pair_or_empty(ps.get(i))).try();
        });
        Ok(run);
    }

    // --- reading ----------------------------------------------------
    //
    // Every one of these answers `None` rather than failing: a missing
    // field is refused by name, not a reason to stop reading the stream.

    // The member named `name`, if `id` is an object that has one. LAST
    // WINS on a duplicate key (RFC 8259 leaves it undefined; every
    // mainstream implementation takes the last).
    field* = (self: @Self, id: JsonId, name: str) Res<JsonId> {
        self.at(id).match({
            Obj(run) => self.scan(run, name),
            _        => None,
        })
    }

    scan = (self: @Self, run: Run, name: str) Res<JsonId> {
        found ::= JsonId(index: 0);
        have  ::= false;
        Range(run.at, run.at + run.len).loop((h, i) {
            p = pair_or_empty(self.pairs.get(i));
            p.key.eq(name).then(() {
                found = p.value;
                have  = true;
            });
        });
        have.match({ true => Ok(found), false => None })
    }

    // Element `i` of an array — `contentChanges[0]` is how a Full-sync
    // `didChange` carries its text, the only array this server reads.
    item* = (self: @Self, id: JsonId, i: usize) Res<JsonId> {
        self.at(id).match({
            Arr(run) => (i < run.len).match({
                true  => self.items.get(run.at + i),
                false => None,
            }),
            _        => None,
        })
    }

    text* = (self: @Self, id: JsonId) Res<str> {
        self.at(id).match({ Text(s) => Ok(s), _ => None })
    }

    // A JSON number read as a non-negative integer (id, line, character,
    // length). `None` unless the lexeme is exactly digits — a sign,
    // point or exponent is a valid JSON number and NOT a whole one, and
    // answering 1 for `1e10` is a quiet wrong.
    whole* = (self: @Self, id: JsonId) Res<usize> {
        self.at(id).match({
            Num(lex) => whole_of(lex),
            _        => None,
        })
    }

    // --- writing ----------------------------------------------------

    // The value at `id`, as JSON, into `out`. Deterministic, no spaces:
    // members come out in the order read or built, so two runs over one
    // input produce one byte string — the round-trip gate's property.
    write* = (self: @Self, id: JsonId, out :: String) Res<(), AllocError> {
        self.at(id).match({
            Null     => out.add_bytes("null"),
            Bool(b)  => out.add_bytes(
                b.match({ true => "true", false => "false" })
            ),
            Num(lex) => out.add_bytes(lex),
            Text(s)  => write_text(s, out),
            Arr(run) => self.write_items(run, out),
            Obj(run) => self.write_pairs(run, out),
        })
    }

    write_items = (self: @Self, run: Run, out :: String) Res<(), AllocError> {
        out.add_bytes("[").try();
        Range(0, run.len).loop((h, i) {
            comma(i, out).try();
            self.write(id_or_zero(self.items.get(run.at + i)), out).try();
        });
        out.add_bytes("]")
    }

    write_pairs = (self: @Self, run: Run, out :: String) Res<(), AllocError> {
        out.add_bytes("{").try();
        Range(0, run.len).loop((h, i) {
            comma(i, out).try();
            p = pair_or_empty(self.pairs.get(run.at + i));
            write_text(p.key, out).try();
            out.add_bytes(":").try();
            self.write(p.value, out).try();
        });
        out.add_bytes("}")
    }
}

Jsons* = (a: Alloc) Jsons {
    Jsons(nodes: a.Vec<Json>(), items: a.Vec<JsonId>(), pairs: a.Vec<Pair>())
}

// The separator before element `i`, which is nothing before the first.
comma = (i: usize, out :: String) Res<(), AllocError> {
    (i > 0).match({ true => out.add_bytes(","), false => written() })
}

// `Ok(())` with its error side named — see `lsp_json_read.zen`'s `fine`.
written* = () Res<(), AllocError> { Ok(()) }

// An in-range `get`, bounds-checked by construction — `Res` has no `or`,
// and writing the match five times would bury what matters.
id_or_zero = (r: Res<JsonId>) JsonId {
    r.match({ Ok(v) => v, None => JsonId(index: 0) })
}

pair_or_empty = (r: Res<Pair>) Pair {
    r.match({ Ok(v) => v, None => Pair(key: "", value: JsonId(index: 0)) })
}

// A JSON string literal, escaped, quotes included.
//
// SHARED BY THE WRITER AND BY EVERY REPLY, a free function rather than a
// method on `Jsons`: a reply is assembled as text with no arena behind
// it. The escape set is the minimum JSON requires — quote, backslash,
// everything below 32; `/` is NOT escaped (legal bare; "accepts `\/`,
// never writes it" is what every implementation ships). BYTES ABOVE 127
// PASS THROUGH UNTOUCHED — valid UTF-8 is valid JSON as itself, and
// re-encoding to `\u` escapes risks corrupting a non-ASCII identifier for
// no reason.
write_text* = (s: str, out :: String) Res<(), AllocError> {
    out.add_byte('"').try();
    Range(0, s.len).loop((h, i) {
        escaped(s.index(i), out).try();
    });
    out.add_byte('"')
}

escaped = (b: u8, out :: String) Res<(), AllocError> {
    (b == '"').match({
        true  => out.add_bytes("\\\""),
        false => (b == '\\').match({
            true  => out.add_bytes("\\\\"),
            false => (b < SPACE).match({
                true  => control(b, out),
                false => out.add_byte(b),
            }),
        }),
    })
}

// The three JSON names worth having for a control byte, `\u00XX` for the
// rest — a newline inside a diagnostic message is common, and a hex
// escape there would make expected files unreadable.
control = (b: u8, out :: String) Res<(), AllocError> {
    (b == '\n').match({
        true  => out.add_bytes("\\n"),
        false => (b == '\r').match({
            true  => out.add_bytes("\\r"),
            false => (b == '\t').match({
                true  => out.add_bytes("\\t"),
                false => hex_escape(b, out),
            }),
        }),
    })
}

// `\u00XX`, reachable only for a byte below 32 — the high two digits are
// always `00` and are written rather than computed.
hex_escape = (b: u8, out :: String) Res<(), AllocError> {
    out.add_bytes("\\u00").try();
    out.add_byte(hex_digit(b / NIBBLE_BASE)).try();
    out.add_byte(hex_digit(b % NIBBLE_BASE))
}

SPACE*: u8 = 32
NIBBLE_BASE*: u8 = 16

// A lexeme read as a usize, or `None` if not exactly digits. Overflow
// answers `None` and never wraps — worse to answer with low bits than
// to refuse.
whole_of* = (lex: str) Res<usize> {
    n  ::= 0;
    ok ::= !lex.is_empty();
    Range(0, lex.len).loop((h, i) {
        stepped(n, lex.index(i)).match({
            Ok(next) => { n = next; },
            None     => { ok = false; },
        });
    });
    ok.match({ true => Ok(n), false => None })
}

// One more digit on the end of `n`.
//
// A FREE FUNCTION AND NOT A NESTED CLOSURE — a bootstrapper limit: a
// `.then(() { .. })` closure inside the loop body reading the loop's `b`
// gets `bootstrap/` to resolve that capture to the wrong binding
// (reports "no method `to_u32` on `bool`" against the loop's `ok`). The
// self-hosted compiler gets it right, so the two must agree.
stepped = (n: usize, b: u8) Res<usize> {
    (b >= '0' && b <= '9').match({
        false => None,
        true  => fits(n, (b - '0').to_u32().to_usize()),
    })
}

// The guard runs BEFORE the multiply — an overflowing `*` TRAPS, and a
// trap is not a refusal.
fits = (n: usize, d: usize) Res<usize> {
    (n > (USIZE_MAX - d) / 10).match({
        true  => None,
        false => Ok(n * 10 + d),
    })
}

USIZE_MAX*: usize = 18446744073709551615
