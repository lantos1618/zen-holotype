// MUST FAIL: `dyn`. DESIGN.md:141 — "No `dyn`, no vtable concept, no boxing, no
// allocation." A trait value is a fat record built with `.as(Display)` and stored
// directly: `printers ::= alloc.Vec<Display>();` (DESIGN.md:144). The bare struct
// name IS the trait type.

printers* = (alloc: Alloc) Vec<dyn Display> {
    alloc.Vec<dyn Display>()
}
