// src/lsp/lsp_serve.zen
// The server: lifecycle, a document overlay, and a dispatch table.
//
// It answers NINE requests — `lsp_reply.zen`'s `Request` union is that
// list — and refuses everything else BY NAME with `-32601` and the method
// spelled back, `src/zen/zen_cli.zen`'s own rule one level down: a
// command that silently does nothing is worse than one that says it is
// not written.
//
//   initialize                 capabilities, and the gate opens
//   shutdown                   `null`, and no more work is accepted
//   textDocument/hover                 lsp_hover.zen
//   textDocument/definition            lsp_def.zen
//   textDocument/documentSymbol        lsp_symbol.zen
//   textDocument/completion            lsp_compl.zen
//   textDocument/semanticTokens/full   lsp_colour.zen
//   textDocument/formatting            lsp_fmt.zen
//   textDocument/codeAction            lsp_action.zen
//   didOpen / didChange        the overlay, Full sync only
//   workspace/didChangeWatchedFiles
//                              retire a build whose disk inputs changed
//   didClose                   remove the buffer from the overlay
//   initialized / exit / $/cancelRequest
//                              notifications, no reply and nothing to do
//   everything else            -32601, with the method named
//
// SYNC IS FULL AND CANNOT USEFULLY BE INCREMENTAL — `design_lsp.md` §5
// holds the three structural reasons. `$/cancelRequest` is DROPPED and
// not recorded: there is no yield point in `check_all`, and this server
// is single-threaded (threads are outside `PLAN.md`'s seed subset).
//
// THIS FILE HOLDS NO TRANSPORT. `one` takes request bytes and appends
// reply bytes; `serve` walks a buffer of frames the same way — so
// `lsp_stdio.zen` puts a pipe under the same server the corpus drives
// from a file, and the two answer identically by construction.
//
// OVER 500 LINES, per STYLE.md's justification: the subject is one
// session (lifecycle, document store, the table that routes one
// message, and the arena discipline of every answer) sharing the
// `Server` that holds all four. `publishDiagnostics`' own subject is
// `lsp_diag.zen`'s and the build itself `lsp_built.zen`'s, leaving here
// the trigger and the routing.

str, String = std.text
Vec, Map = std.collections
Range = std.core
Alloc, AllocError, Arena = std.mem
Checker = sema.sema_check
Jsons, JsonId, written, read = std.json
FrameFault, frame_at, write_frame, write_decimal = lsp.lsp_frame
Hover, hover_at, hover_in, hover_with = lsp.lsp_hover
definition_at, definition_in, definition_with = lsp.lsp_def
Sym, symbols_at, write_symbols = lsp.lsp_symbol
write_edits = lsp.lsp_fmt
Item, complete_at, complete_in, complete_shared = lsp.lsp_compl
sort_items, write_items = lsp.lsp_compl
// The colours, and the legend `initialize` advertises them under — one
// file, for the reason `lsp_reply.zen` gives at its own import.
write_tokens = lsp.lsp_colour
// The one message this server sends unprompted, the policy that decides
// when, and the one build the settle and the queries share
// (`lsp_built.zen` — reached through `Diagnostics`, whose slot it is).
Diagnostics, Shared = lsp.lsp_diag
// The one quickfix: an import line for an undefined name, read off the
// SAME shared build the diagnostics came from.
write_actions = lsp.lsp_action
relative_to = zen.zen_path
// The wire's shapes: a request's fields read, a reply built. Their own
// file (`lsp_reply.zen`) since the session met STYLE.md's hard cap.
method_of, params_of, param, string_at, number_at = lsp.lsp_reply
result, failed, parse_error, write_hover, write_target = lsp.lsp_reply
write_capabilities = lsp.lsp_reply
RpcFault, own_str = lsp.lsp_reply
request_of = lsp.lsp_reply
path_of = lsp.lsp_uri

// The whole of the server's state.
//
// `docs` maps a URI to the open buffer's text in `docs_arena`: owned,
// not borrowed from a request, but replaceable as one unit so full-sync
// edits do not retain every old version for the session.
Server* = {
    a: Alloc,

    // THE AUTHORITY A QUERY NEEDS. Hover is a build now and reads the
    // disk, so the server holds the same `Env` the driver does.
    env: Env,

    // Full-sync edits replace whole buffers. Their bytes live in this
    // replaceable arena so old versions do not accumulate for the session.
    docs_arena :: Arena,

    // THE WORKSPACE, from `initialize`'s `rootUri`, as a path. Empty
    // until `initialize` arrives or the client sends none — load-bearing
    // emptiness: it sends hover back to the single-module answer instead
    // of building a root nobody named. NOT THE COMPILATION ROOT
    // (`zen_path.root_for` computes that from the document); this is
    // only the floor it may not climb past.
    workspace :: str = "",

    docs :: Map<str, str>,

    // THE SAME DOCUMENTS, IN OPENING ORDER: a `Map` here cannot be
    // walked, and a build's overlay must carry EVERY unsaved buffer, not
    // only the one being edited.
    open :: Vec<str>,

    // What has been said about those documents, and what is owed — the
    // policy lives in `lsp_diag.zen`; this file only marks and settles.
    notes :: Diagnostics,

    ready :: bool,        // `initialize` has been answered
    stopping :: bool,     // `shutdown` has been answered

    // Whether `shutdown` has been answered. The FIELD stays unexported:
    // nothing outside this file may decide when the server stops
    // accepting work.
    stopped* = (self: @Self) bool { self.stopping }

    // One message: read it, route it, frame whatever it produced.
    //
    // `t` IS THE MESSAGE'S OWN ARENA, dropped by the caller when the
    // reply has been written: the JSON tree, the reply being built and
    // every answer's scratch live there, so a request leaves nothing
    // behind. What must outlive the message — the documents, the open
    // list, what `initialize` learned — borrows the request's BYTES
    // (which the transport holds for the session) or allocates from
    // `self.a`, never from `t`.
    one* = (self :: @Self, t: Alloc, body: str, out :: String)
           Res<(), AllocError> {
        tree ::= t.Jsons();
        msg  ::= t.String().try();
        read(t, tree, body).match({
            Err(f)  => parse_error(f, msg),
            Ok(req) => self.route(t, tree, req, msg),
        }).try();
        // AN EMPTY MESSAGE IS A NOTIFICATION AND GETS NO FRAME — the
        // protocol forbids replying to one.
        msg.is_empty().match({
            true  => written(),
            false => write_frame(msg.view(), out),
        })
    }

    route = (self :: @Self, t: Alloc, tree: Jsons, req: JsonId, msg :: String)
            Res<(), AllocError> {
        method = method_of(tree, req);
        // THE PRESENCE OF `id` IS WHAT MAKES A MESSAGE A REQUEST, not
        // the method name — a table of notification names would be a
        // second, divergent copy of the spec.
        tree.field(req, "id").match({
            None    => self.notified(tree, req, method),
            Ok(rid) => self.requested(t, tree, req, method, rid, msg),
        })
    }

    // BEFORE `initialize`, EVERY REQUEST IS REFUSED with `-32002` — the
    // one piece of lifecycle a server cannot skip.
    requested = (self :: @Self, t: Alloc, tree: Jsons, req: JsonId,
                 method: str, rid: JsonId, msg :: String)
                Res<(), AllocError> {
        (self.ready || method.eq("initialize")).match({
            false => failed(
                tree,
                rid,
                RpcFault.NotInitialized,
                "the server has not been initialized",
                msg
            ),
            true  => self.answered(t, tree, req, method, rid, msg),
        })
    }

    // ONE FLAT MATCH: the string compares already happened, once, in
    // `request_of` — a compare-per-method ladder nests one level per
    // method, and the parser budgets stack per nesting level.
    answered = (self :: @Self, t: Alloc, tree: Jsons, req: JsonId,
                method: str, rid: JsonId, msg :: String)
               Res<(), AllocError> {
        request_of(method).match({
            Initialize => self.initialized(t, tree, req, rid, msg),
            Shutdown   => {
                self.stopping = true;
                result(tree, rid, "null", msg)
            },
            Hover      => self.hovered(t, tree, req, rid, msg),
            Definition => self.defined(t, tree, req, rid, msg),
            Outline    => self.outlined(t, tree, req, rid, msg),
            Completion => self.completed(t, tree, req, rid, msg),
            Colour     => self.coloured(t, tree, req, rid, msg),
            Format     => self.formatted(t, tree, req, rid, msg),
            Action     => self.acted(t, tree, req, rid, msg),
            Unknown    => self.unknown(t, tree, rid, method, msg),
        })
    }

    // `initialize` IS WHERE A SERVER LEARNS WHERE IT IS: `rootUri`
    // arrives once and every later request names only a document.
    //
    // A CLIENT THAT SENDS NONE IS NOT AN ERROR. `rootUri` is nullable
    // and a single-file editor session has no root — the field stays
    // empty and hover falls back to checking the open document alone.
    //
    // `rootPath` IS NOT READ — the deprecated spelling of the same
    // thing, and a second source for one fact can disagree with the
    // first.
    initialized = (self :: @Self, t: Alloc, tree: Jsons, req: JsonId,
                   rid: JsonId, msg :: String) Res<(), AllocError> {
        self.ready     = true;
        self.workspace = own_str(
            self.a,
            path_of(string_at(tree, params_of(tree, req), "rootUri"))
        ).try();
        caps ::= t.String().try();
        write_capabilities(caps).try();
        result(tree, rid, caps.view(), msg)
    }

    // REFUSED BY NAME: the method is echoed so a client's log says which
    // request is unimplemented, not that some request failed.
    unknown = (self :: @Self, t: Alloc, tree: Jsons, rid: JsonId, method: str,
               msg :: String) Res<(), AllocError> {
        why ::= t.String().try();
        why.add_bytes("no handler for ").try();
        why.add_bytes(method).try();
        why.add_bytes(
            " - see docs/design_lsp.md for the stage it arrives at"
        ).try();
        failed(tree, rid, RpcFault.MethodNotFound, why.view(), msg)
    }

    // `initialized`, `exit` and `$/cancelRequest` mean "nothing to do
    // here" and fall through the final arm.
    notified = (self :: @Self, tree: Jsons, req: JsonId, method: str)
               Res<(), AllocError> {
        handled: Res<Res<(), AllocError>> = loop<Res<(), AllocError>>((h) {
            method.eq("textDocument/didOpen").then(() {
                h.break(self.opened(tree, req))
            });
            method.eq("textDocument/didChange").then(() {
                h.break(self.changed(tree, req))
            });
            method.eq("textDocument/didClose").then(() {
                h.break(self.closed(tree, req))
            });
            method.eq("workspace/didChangeWatchedFiles").then(() {
                h.break(self.watched(tree, req))
            });
            h.break(written());
        });
        handled.match({ Ok(done) => done, None => written() })
    }

    // OPEN DOCUMENTS COME FROM THE OVERLAY, not disk. VS Code emits a file
    // watcher notification when one is saved as well as the didChange that
    // supplied its bytes; invalidating for that second event rebuilt the
    // same whole program twice. Only a CLOSED dependency can change an input
    // the build read from disk.
    watched = (self :: @Self, tree: Jsons, req: JsonId)
              Res<(), AllocError> {
        changes = param(tree, req, "changes");
        i     ::= 0;
        stale ::= false;
        more  ::= true;
        loop(more, (h) {
            tree.item(changes, i).match({
                None       => { more = false; },
                Ok(change) => {
                    uri = string_at(tree, change, "uri");
                    self.docs.get(uri).match({
                        None  => { stale = true; },
                        Ok(_) => (),
                    });
                    i = i + 1;
                },
            });
        });
        (stale && self.open.len > 0).match({
            false => written(),
            true  => self.open.get(self.open.len - 1).match({
                None      => written(),
                Ok(entry) => { self.notes.stales(entry); Ok(()) },
            }),
        })
    }

    opened = (self :: @Self, tree: Jsons, req: JsonId) Res<(), AllocError> {
        doc = param(tree, req, "textDocument");
        self.remember(string_at(tree, doc, "uri"), string_at(tree, doc, "text"))
    }

    // FULL SYNC: `contentChanges[0].text` is the whole new buffer, since
    // `initialize` advertised `textDocumentSync: 1`; a `range` field
    // would mean incremental sync, never asked for, and is not read.
    changed = (self :: @Self, tree: Jsons, req: JsonId) Res<(), AllocError> {
        uri   = string_at(tree, param(tree, req, "textDocument"), "uri");
        edits = param(tree, req, "contentChanges");
        text  = tree.item(edits, 0).match({
            None    => "",
            Ok(one) => string_at(tree, one, "text"),
        });
        self.remember(uri, text)
    }

    // Closing retires the overlay so subsequent builds read this file
    // from disk. Map has no removal, so replace the small document store;
    // the open-order Vec loses the same row.
    closed = (self :: @Self, tree: Jsons, req: JsonId)
             Res<(), AllocError> {
        doc = param(tree, req, "textDocument");
        uri = string_at(tree, doc, "uri");
        self.docs.get(uri).match({
            None  => written(),
            Ok(_) => self.forget(uri),
        })
    }

    forget = (self :: @Self, uri: str) Res<(), AllocError> {
        stable = own_str(self.a, uri).try();
        self.replace_docs(uri, None).try();
        Range(0, self.open.len).find((i) {
            self.open.get(i).match({ None => false, Ok(u) => u.eq(uri) })
        }).match({
            None   => (),
            Ok(at) => { self.open.take(at); },
        });
        next = (self.open.len == 0).match({
            true  => "",
            false => self.open.get(self.open.len - 1).match({
                None => "", Ok(u) => u
            }),
        });
        self.notes.closed(stable, next)
    }

    // A URI with no text is not stored — an empty document and an
    // absent one are different states.
    remember = (self :: @Self, uri: str, text: str) Res<(), AllocError> {
        uri.is_empty().match({
            true  => written(),
            false => self.stored(uri, text),
        })
    }

    // Unchanged bytes preserve both the document arena and cached build.
    stored = (self :: @Self, uri: str, text: str) Res<(), AllocError> {
        self.docs.get(uri).match({
            None     => self.changed_to(uri, text),
            Ok(held) => held.eq(text).match({
                true  => written(),
                false => self.changed_to(uri, text),
            }),
        })
    }

    changed_to = (self :: @Self, uri: str, text: str) Res<(), AllocError> {
        stable = self.listed(uri).try();
        self.replace_docs(uri, Ok(text)).try();
        self.notes.owes(stable);
        Ok(());
    }

    listed = (self :: @Self, uri: str) Res<str, AllocError> {
        self.open.find((u) { u.eq(uri) }).match({
            Ok(found) => Ok(found),
            None      => {
                kept = own_str(self.a, uri).try();
                self.open.add(kept).try();
                Ok(kept)
            },
        })
    }

    replace_docs = (self :: @Self, uri: str, text: Res<str>)
                   Res<(), AllocError> {
        fresh_arena ::= self.env.mem.alloc();
        fresh       ::= fresh_arena.Map<str, str>();
        self.docs.pairs((h, key, value) {
            key.eq(uri).match({
                true  => written(),
                false => fresh.set(
                    own_str(fresh_arena, key).try(),
                    own_str(fresh_arena, value).try()
                ),
            }).try();
        });
        text.match({
            None        => written(),
            Ok(replace) => fresh.set(
                own_str(fresh_arena, uri).try(),
                own_str(fresh_arena, replace).try()
            ),
        }).try();
        self.docs_arena.drop();
        self.docs_arena = consume fresh_arena;
        self.docs       = fresh;
        Ok(())
    }

    // THE SETTLE POINT: every message the transport was holding has been
    // answered, so `lsp_diag.zen`'s `settled` — which ensures rather
    // than builds — is called here, by `serve` at buffer end and by
    // `lsp_stdio.zen` after each drain. `t` is the batch's scratch.
    //
    // NOTHING IS SENT AFTER `shutdown`: no work is accepted once it has
    // been answered, and an unprompted notification between `shutdown`
    // and `exit` is work the client has just said it does not want.
    settled* = (self :: @Self, t: Alloc, out :: String) Res<(), AllocError> {
        self.stopping.match({
            true  => written(),
            false => self.notes.settled(
                self.env,
                self.workspace,
                self.open,
                self.docs,
                t,
                out
            ),
        })
    }

    // THE ONE REFUSAL ALL SEVEN DOCUMENT QUERIES MAKE, written once: a uri
    // no `didOpen` ever named. A CLIENT BUG, so `-32602` names it rather
    // than answering `null`, `[]` or `{}` — each of those reads as
    // "there is nothing here", which is a different and false statement
    // about a document the server has never seen.
    //
    // `tests/corpus/lsp/every_query_refuses_a_uri_never_opened` asserts
    // all seven on the wire, because three of them were covered by nothing
    // and a shared refusal is exactly what turns silently into a `null`.
    unopened = (self :: @Self, tree: Jsons, rid: JsonId, msg :: String)
               Res<(), AllocError> {
        failed(
            tree,
            rid,
            RpcFault.InvalidParams,
            "no open document for that uri",
            msg
        )
    }

    hovered = (self :: @Self, t: Alloc, tree: Jsons, req: JsonId, rid: JsonId,
               msg :: String) Res<(), AllocError> {
        uri       = string_at(tree, param(tree, req, "textDocument"), "uri");
        where     = param(tree, req, "position");
        line      = number_at(tree, where, "line");
        character = number_at(tree, where, "character");
        self.docs.get(uri).match({
            None     => self.unopened(tree, rid, msg),
            // THE WORKSPACE DECIDES, the way `lsp_hover.zen`'s header
            // spells out: without one the lone module answers from the
            // request's own arena, with one the SHARED build's checker
            // does — so a hover after a settle builds nothing.
            Ok(text) => {
                body ::= t.String().try();
                self.workspace.is_empty().match({
                    true  => {
                        qa ::= self.env.mem.alloc();
                        self.write_hovered(
                            hover_at(qa, uri, text, line, character).try(),
                            body
                        )
                    },
                    false => self.shared_hover(
                        t,
                        uri,
                        text,
                        line,
                        character,
                        body
                    ),
                }).try();
                result(tree, rid, body.view(), msg)
            },
        })
    }

    // COLOUR READS WHAT THE DIAGNOSTICS' BUILD SETTLED, and an empty
    // `classes_for` IS the lexical answer, so the fallback costs no
    // branch.
    coloured = (self :: @Self, t: Alloc, tree: Jsons, req: JsonId,
                rid: JsonId, msg :: String) Res<(), AllocError> {
        uri = string_at(tree, param(tree, req, "textDocument"), "uri");
        self.docs.get(uri).match({
            None     => self.unopened(tree, rid, msg),
            Ok(text) => {
                body ::= t.String().try();
                names = self.notes.classes_for(t, uri).try();
                write_tokens(t, uri, text, names, body).try();
                result(tree, rid, body.view(), msg)
            },
        })
    }

    // THE SESSION, HANDED TO THE BUILD. `lsp_diag.zen`'s `shared` wants
    // four fields off this server alongside the document's path, and all
    // three workspace-backed queries below want the same five — so they
    // are named once here rather than at each call.
    build_for = (self :: @Self, path: str, t: Alloc) Res<Shared, AllocError> {
        self.notes.shared(
            self.env,
            self.workspace,
            self.open,
            self.docs,
            path,
            t
        )
    }

    // HOVER OFF THE SHARED BUILD, the way `write_definition` below does
    // it — `lsp_diag.zen`'s `shared` is what ensures the slot, and its
    // `None` arm is unreachable, falling back to a per-request build of
    // its own rather than a guess.
    shared_hover = (self :: @Self, t: Alloc, uri: str, text: str,
                    line: usize, character: usize, body :: String)
                   Res<(), AllocError> {
        path = path_of(uri);
        sh   = self.build_for(path, t).try();
        sh.c.match({
            None  => {
                qa ::= self.env.mem.alloc();
                self.write_hovered(
                    hover_in(
                        self.env,
                        qa,
                        self.workspace,
                        path,
                        text,
                        line,
                        character
                    ).try(),
                    body
                )
            },
            Ok(c) => self.write_hovered(
                hover_with(
                    c,
                    t,
                    relative_to(sh.root, path),
                    text,
                    line,
                    character
                ).try(),
                body
            ),
        })
    }

    // A hover, or the protocol's `null` when the position answered
    // nothing — the two lines every hover answer shares, once.
    write_hovered = (self :: @Self, h: Hover, body :: String)
                    Res<(), AllocError> {
        h.found.match({
            false => body.add_bytes("null"),
            true  => write_hover(h, body),
        })
    }

    // DEFINITION and COMPLETION take the same two params as hover and
    // let THE WORKSPACE DECIDE the same way `hovered` above spells out.
    defined = (self :: @Self, t: Alloc, tree: Jsons, req: JsonId, rid: JsonId,
               msg :: String) Res<(), AllocError> {
        uri       = string_at(tree, param(tree, req, "textDocument"), "uri");
        where     = param(tree, req, "position");
        line      = number_at(tree, where, "line");
        character = number_at(tree, where, "character");
        self.docs.get(uri).match({
            None     => self.unopened(tree, rid, msg),
            Ok(text) => {
                body ::= t.String().try();
                self.workspace.is_empty().match({
                    true  => {
                        qa ::= self.env.mem.alloc();
                        write_target(
                            definition_at(qa, uri, text, line, character).try(),
                            body
                        )
                    },
                    false => self.write_definition(
                        t,
                        uri,
                        text,
                        line,
                        character,
                        body
                    ),
                }).try();
                result(tree, rid, body.view(), msg)
            },
        })
    }

    write_definition = (self :: @Self, t: Alloc, uri: str, text: str,
                        line: usize, character: usize, body :: String)
                       Res<(), AllocError> {
        path = path_of(uri);
        sh   = self.build_for(path, t).try();
        sh.c.match({
            // Unreachable, as in `shared_hover`; the per-request build
            // answers instead.
            None  => {
                qa ::= self.env.mem.alloc();
                write_target(
                    definition_in(
                        self.env,
                        qa,
                        self.workspace,
                        path,
                        uri,
                        text,
                        line,
                        character
                    ).try(),
                    body
                )
            },
            Ok(c) => write_target(
                definition_with(
                    self.env,
                    c,
                    t,
                    sh.root,
                    self.docs,
                    uri,
                    text,
                    relative_to(sh.root, path),
                    line,
                    character
                ).try(),
                body
            ),
        })
    }

    // THE OUTLINE NEEDS NO BUILD AND NO WORKSPACE: a declaration's kind
    // and spans are AST facts, so the buffer alone answers — the same
    // economy colour's lexical half makes. Its scratch is the request's
    // arena, like every other answer's.
    outlined = (self :: @Self, t: Alloc, tree: Jsons, req: JsonId, rid: JsonId,
                msg :: String) Res<(), AllocError> {
        uri = string_at(tree, param(tree, req, "textDocument"), "uri");
        self.docs.get(uri).match({
            None     => self.unopened(tree, rid, msg),
            Ok(text) => {
                syms ::= t.Vec<Sym>();
                symbols_at(t, text, syms).try();
                body ::= t.String().try();
                write_symbols(uri, text, syms, body).try();
                result(tree, rid, body.view(), msg)
            },
        })
    }

    // FORMATTING NEEDS NO BUILD AND NO WORKSPACE, the same economy the
    // outline makes. Every refusal is `lsp_fmt.zen`'s and every one of
    // them is `[]`, for the reason its header gives.
    formatted = (self :: @Self, t: Alloc, tree: Jsons, req: JsonId,
                 rid: JsonId, msg :: String) Res<(), AllocError> {
        uri = string_at(tree, param(tree, req, "textDocument"), "uri");
        self.docs.get(uri).match({
            None     => self.unopened(tree, rid, msg),
            Ok(text) => {
                body ::= t.String().try();
                write_edits(t, text, body).try();
                result(tree, rid, body.view(), msg)
            },
        })
    }

    // CODE ACTION IS A QUERY ON THE SETTLED BUILD, the way definition is:
    // the names it offers imports for come from the checker's OWN diags,
    // so no workspace or no build in the slot means `[]` — never a guess
    // (`lsp_action.zen's` header), never a per-request rebuild (the settle
    // at batch end holds the state a quickfix asks about).
    acted = (self :: @Self, t: Alloc, tree: Jsons, req: JsonId, rid: JsonId,
             msg :: String) Res<(), AllocError> {
        uri   = string_at(tree, param(tree, req, "textDocument"), "uri");
        range = param(tree, req, "range");
        first = param(tree, range, "start");
        last  = param(tree, range, "end");
        self.docs.get(uri).match({
            None     => self.unopened(tree, rid, msg),
            Ok(text) => {
                body ::= t.String().try();
                self.workspace.is_empty().match({
                    true  => body.add_bytes("[]"),
                    false => self.shared_actions(
                        t,
                        uri,
                        text,
                        number_at(tree, first, "line"),
                        number_at(tree, first, "character"),
                        number_at(tree, last, "line"),
                        number_at(tree, last, "character"),
                        body
                    ),
                }).try();
                result(tree, rid, body.view(), msg)
            },
        })
    }

    shared_actions = (self :: @Self, t: Alloc, uri: str, text: str,
                      sl: usize, sc: usize, el: usize, ec: usize,
                      body :: String) Res<(), AllocError> {
        path = path_of(uri);
        sh   = self.build_for(path, t).try();
        sh.c.match({
            None  => body.add_bytes("[]"),
            Ok(c) => write_actions(
                c,
                t,
                relative_to(sh.root, path),
                text,
                uri,
                sl,
                sc,
                el,
                ec,
                body
            ),
        })
    }

    // COMPLETION IN THREE PARTS, by where the build comes from. No
    // workspace: the lone module, in the request's own arena. A workspace
    // and a trigger that is not after a dot: the buffer parses as it
    // stands, so the SHARED build's checker answers. After a dot the
    // buffer does not parse — `complete_in` patches in a dummy identifier
    // and builds THAT, a state the slot never holds by definition, so
    // the patched build is the request's own and dies with `qa`.
    completed = (self :: @Self, t: Alloc, tree: Jsons, req: JsonId,
                 rid: JsonId, msg :: String) Res<(), AllocError> {
        uri       = string_at(tree, param(tree, req, "textDocument"), "uri");
        where     = param(tree, req, "position");
        line      = number_at(tree, where, "line");
        character = number_at(tree, where, "character");
        self.docs.get(uri).match({
            None     => self.unopened(tree, rid, msg),
            Ok(text) => {
                body ::= t.String().try();
                self.workspace.is_empty().match({
                    true  => {
                        qa    ::= self.env.mem.alloc();
                        items ::= qa.Vec<Item>();
                        complete_at(qa, text, line, character, items).try();
                        sort_items(items).try();
                        write_items(items, body)
                    },
                    false => self.write_completion(
                        t,
                        uri,
                        text,
                        line,
                        character,
                        body
                    ),
                }).try();
                result(tree, rid, body.view(), msg)
            },
        })
    }

    write_completion = (self :: @Self, t: Alloc, uri: str, text: str,
                        line: usize, character: usize, body :: String)
                       Res<(), AllocError> {
        path = path_of(uri);
        sh   = self.build_for(path, t).try();
        done = sh.c.match({
            // Unreachable, as in `write_definition`; the patched build
            // below answers instead.
            None  => false,
            Ok(c) => self.shared_completion(
                c,
                t,
                sh.root,
                path,
                text,
                line,
                character,
                body
            ).try(),
        });
        done.match({
            true  => written(),
            false => self.patched_completion(path, text, line, character, body),
        })
    }

    shared_completion = (self :: @Self, c: Checker, t: Alloc, root: str,
                         path: str, text: str, line: usize, character: usize,
                         body :: String) Res<bool, AllocError> {
        items ::= t.Vec<Item>();
        done = complete_shared(
            c,
            t,
            relative_to(root, path),
            text,
            line,
            character,
            items
        ).try();
        done.match({
            false => written(),
            true  => {
                sort_items(items).try();
                write_items(items, body)
            },
        }).try();
        Ok(done);
    }

    patched_completion = (self :: @Self, path: str, text: str, line: usize,
                          character: usize, body :: String)
                         Res<(), AllocError> {
        qa    ::= self.env.mem.alloc();
        items ::= qa.Vec<Item>();
        complete_in(
            self.env,
            qa,
            self.workspace,
            path,
            text,
            line,
            character,
            items
        ).try();
        sort_items(items).try();
        write_items(items, body)
    }
}

Server.impl(Drop, {
    drop = (self :: @Self) () {
        self.notes.drop();
        self.docs_arena.drop();
    }
})

Server* = (a: Alloc, env: Env) Server {
    docs_arena ::= env.mem.alloc();
    server_with_docs(a, env, consume docs_arena)
}

server_with_docs = (a: Alloc, env: Env, docs_arena :: Arena) Server {
    docs = docs_arena.Map<str, str>();
    Server(
        a: a,
        env: env,
        docs_arena: consume docs_arena,
        docs: docs,
        open: a.Vec<str>(),
        notes: a.Diagnostics(env),
        ready: false,
        stopping: false
    )
}

// Every frame in `input`, answered into `out`.
//
// A malformed frame STOPS the session: framing is the one layer where
// recovery is impossible — the header of this message is the only thing
// that says where the next starts, so skipping forward would
// resynchronise onto a byte inside somebody's document.
//
// THE BUFFER FORM ANSWERS FROM THE SESSION ARENA THROUGHOUT — `s.a`
// stands in for the per-message scratch `lsp_stdio.zen` hands `one`,
// since a file-driven session ends with the process and nothing is
// reclaimed before then anyway.
serve* = (s :: Server, input: str, out :: String) Res<(), AllocError> {
    at    ::= 0;
    going ::= true;
    loop(() { going && at < input.len }, (h) {
        frame_at(input, at).match({
            Err(f) => { going = false; frame_fault(f, out).try(); },
            Ok(fr) => { at = fr.next; s.one(s.a, fr.body, out).try(); },
        });
    });
    // THE END OF A BUFFER IS A SETTLE POINT — what makes a batch of
    // changes cost one build.
    s.settled(s.a, out)
}

// A framing fault is reported to the caller's stream, not to a client
// (which cannot be replied to if it cannot be framed).
frame_fault = (f: FrameFault, out :: String) Res<(), AllocError> {
    out.add_bytes("lsp: bad frame at byte ").try();
    write_decimal(f.byte(), out).try();
    out.add_bytes(" (").try();
    out.add_bytes(f.why()).try();
    out.add_bytes(")\n")
}

// The arena string-copy the document store and the workspace keep is
// `lsp_reply.zen`'s `own_str` — the folder's only one.
