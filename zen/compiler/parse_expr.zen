// compiler.parse_expr — expression parsing: atoms, postfixes, matches, literals, calls, and precedence.
{ Expr, Stmt, Ty, ArmData, FieldInit, Field, Param, lit, byte_lit, flit, vref, vref_at, bin, bin_at, call, call_at, raw_call_at, call_targs_at, emcall, cond, cond_oa, member, member_at, mkstruct, mkstruct_at, finit, mkenum, mktag, mkenumg, mktagg, arm, arm_at, ematch, strlit, strlit_at, eindex, slit, eloop, lam_r, block, sret, slet, sexpr, mkstructg, mkstructg_at, mangle_str_in, mangle_anon_in, dotted_name_in, payload_fname, chain_tmp_name, field, param, tvoid, ti32, ti64, tu8, tf64, tbool, tstring_literal, tnamed } = compiler.genc
{ Token, Scan, scan, is_hex_prefix, is_bin_prefix, is_oct_prefix } = compiler.lex
{ at, is_digit } = std.text.bytes
{ Malloc } = std.mem.alloc
{ is_lbrace, is_lbracket, is_rbrace, is_rbracket, is_rparen, is_comma, is_langle, is_rangle, tok_eq, tok_in, parse_tyargs, parse_ty, TyEnd, param_buf, take_params, skip_block, PEnd, perr_set, perr_set_at, pdepth_enter, pdepth_exit, pdepth_over, register_anon, delim_enter, delim_exit, stmt_level, vbreak_note } = compiler.parse_type
{ build_body, parse_block, materialize } = compiler.parse_stmt
PExpr*: {
    expr: Ptr<Expr>,
    next: i32,
}
ebuf = (a: MutPtr<Malloc>) [Expr] { slice(a.acquire(sizeof(Expr)), 1) }
enode* = (a: MutPtr<Malloc>, v: Expr) Ptr<Expr> {
    buf := a.ebuf()
    buf[0] = v
    buf[0].addr()
}
// Copy a token span into an owned NUL-terminated str.
copy_span = (src: string_view, start: i32, dst: RawPtr<u8>, n: i32) void {
    i := 0
    @while (i < n) {
        store(offset(dst, i), src.at(start + i))
        i = i + 1
    }
}
// C keywords are mangled at the lexeme choke point so defs/refs stay consistent.
is_c_kw = (src: string_view, t: Token) bool {
    src.tok_in(t, "double|short|long|int|char|float|unsigned|signed").then({
        return true
    })
    src.tok_in(t, "union|struct|enum|typedef|static|extern|const|volatile").then({
        return true
    })
    src.tok_in(t, "register|auto|inline|restrict|if|else|for|while").then({
        return true
    })
    src.tok_in(t, "do|switch|case|default|goto|void|continue|break").then({
        return true
    })
    false
}
// FAITHFUL mode: the FORMATTER parses RAW (pre-flatten) source and must round-trip every identifier
// EXACTLY — including the few that collide with C keywords (`float`, `if`, `default`, …). The normal
// pipeline mangles those to `name_zk` (below) so the emitted C is legal; fmt never emits C, so in faithful
// mode the mangle is DISABLED and `float` formats back to `float`, not `float_zk`. Module-level state
// (mirrors perr / exports_buf); driver.fmt_render flips it on around the faithful parse, off after.
gf_faithful_lexeme := false
set_faithful_lexeme* = (b: bool) void { gf_faithful_lexeme = b }
lexeme* = (a: MutPtr<Malloc>, src: string_view, t: Token) string_cstr {
    (src.is_c_kw(t) && gf_faithful_lexeme.match ({ true => false, false => true })).match ({
        true  => {
            p := a.acquire(t.len + 4)
            src.copy_span(t.start, p, t.len)
            store(offset(p, t.len), '_')
            store(offset(p, t.len + 1), 'z')
            store(offset(p, t.len + 2), 'k')
            store(offset(p, t.len + 3), 0)
            cstr(p)
        },
        false => {
            p := a.acquire(t.len + 1)
            src.copy_span(t.start, p, t.len)
            store(offset(p, t.len), 0)
            cstr(p)
        },
    })
}
// A float literal carries its source text verbatim into C, but C float syntax rejects `_`; copy the
// span dropping any digit separators (`1_000.5` -> `1000.5`).
copy_no_us = (src: string_view, pos: i32, end: i32, dst: RawPtr<u8>, di: i32) i32 {
    p := pos
    d := di
    @while (p < end) {
        (src.at(p) == '_').match ({
            true  => {
                p = p + 1
            },
            false => {
                store(offset(dst, d), src.at(p))
                p = p + 1
                d = d + 1
            },
        })
    }
    d
}
float_lexeme = (a: MutPtr<Malloc>, src: string_view, t: Token) string_view {
    p := a.acquire(t.len + 1)
    n := src.copy_no_us(t.start, t.start + t.len, p, 0)
    store(offset(p, n), 0)
    cstr(p)
}
is_op* = (src: string_view, t: Token, c: u8) bool {
    t.kind.match ({
        .Sym => src.at(t.start) == c,
        _    => false,
    })
}
is_addsub = (src: string_view, t: Token) bool { src.is_op(t, '+') || src.is_op(t, '-') }
is_muldiv = (src: string_view, t: Token) bool { src.is_op(t, '*') || src.is_op(t, '/') || src.is_op(t, '%') }
op_str* = (b: u8) string_literal {
    (b == '+').match ({
        true  => "+",
        false => (b == '-').match ({
            true  => "-",
            false => (b == '*').match ({
                true  => "*",
                false => (b == '%').match ({ true => "%", false => "/" }),
            }),
        }),
    })
}
digit_val = (b: u8) i32 { b - '0' }
hex_val = (b: u8) i32 {
    b.is_digit().match ({
        true  => b - '0',
        false => (b >= 'a' && b <= 'f').match ({ true => b - 'a' + 10, false => b - 'A' + 10 }),
    })
}
// The largest accumulator / remaining digit for which `acc * base + digit` still fits 2^64-1 on the
// last step: `floor((2^64-1) / base)` and `(2^64-1) mod base`. Used to catch overflow BEFORE it wraps.
u64max_div = (base: i32) u64 {
    (base == 16).match ({
        true  => 1152921504606846975,
        false => (base == 2).match ({
            true  => 9223372036854775807,
            false => (base == 8).match ({
                true  => 2305843009213693951,
                false => 1844674407370955161,
            }),
        }),
    })
}
u64max_mod = (base: i32) u64 {
    (base == 16).match ({
        true  => 15,
        false => (base == 2).match ({
            true  => 1,
            false => (base == 8).match ({ true => 7, false => 5 }),
        }),
    })
}
// Accumulate the base-`base` literal in [pos, end) into a 64-bit value. `_` digit separators carry no
// value and are threaded past. The value is built in u64 (so a full-range u64 literal keeps its exact
// bit pattern) and returned reinterpreted as i64 — the declared/inferred width narrows it at the store.
// ITERATIVE (a long literal is O(n) heap iteration, not O(n) C-stack — a 200KB numeric literal must not
// overflow the lexer stack). OVERFLOW: a literal whose value exceeds 2^64-1 is unrepresentable in ANY
// zen integer type, so instead of silently wrapping to a wrong value it flags a positioned parse error
// (caret at `off`, the literal's first byte) and the module is rejected.
int_acc = (src: string_view, pos: i32, end: i32, base: i32, off: i32) i64 {
    acc: u64 := 0
    over := false
    bu: u64 := base
    lim: u64 := u64max_div(base)
    rem: u64 := u64max_mod(base)
    p := pos
    @while (p < end) {
        b := src.at(p)
        (b == '_').match ({
            true  => {
                p = p + 1
            },
            false => {
                d: u64 := (base == 16).match ({ true => b.hex_val(), false => b.digit_val() })
                (acc > lim || acc == lim && d > rem).then({
                    over = true
                })
                acc = acc * bu + d
                p = p + 1
            },
        })
    }
    over.then({
        perr_set_at(off)
    })
    acc.to_i64()
}
// `0x...` base-16, `0b...` base-2, `0o...` base-8; otherwise decimal.
to_int = (src: string_view, t: Token) i64 {
    src.is_hex_prefix(t.start).match ({
        true  => src.int_acc(t.start + 2, t.start + t.len, 16, t.start),
        false => src.is_bin_prefix(t.start).match ({
            true  => src.int_acc(t.start + 2, t.start + t.len, 2, t.start),
            false => src.is_oct_prefix(t.start).match ({
                true  => src.int_acc(t.start + 2, t.start + t.len, 8, t.start),
                false => src.int_acc(t.start, t.start + t.len, 10, t.start),
            }),
        }),
    })
}
parse_atom* = (a: MutPtr<Malloc>, src: string_view, pos: i32) PExpr {
    // DEPTH CAP (see parse_type.zen): every nested expression form — parens, prefix `-`/`!`, slice
    // literals, `.match`/`.loop`, lambdas — funnels through parse_atom, so one guard here bounds them
    // all. Past the cap, set the parse-error flag and return a placeholder WITHOUT recursing further;
    // the enclosing frames simply unwind (each does O(1) work), so there is no hang.
    pdepth_enter()
    r := pdepth_over().match ({
        true  => PExpr(
            expr: a.enode(lit(0)),
            next: pos,
        ),
        false => a.parse_postfix(src, a.parse_base(src, pos)),
    })
    pdepth_exit()
    r
}
parse_base = (a: MutPtr<Malloc>, src: string_view, pos: i32) PExpr {
    sc := src.scan(pos)
    sc.tok.kind.match ({
        .Int   => PExpr(
            expr: a.enode(lit(src.to_int(sc.tok))),
            next: sc.next,
        ),
        .Float => PExpr(
            expr: a.enode(flit(a.float_lexeme(src, sc.tok))),
            next: sc.next,
        ),
        .Char  => PExpr(
            expr: a.enode(byte_lit(src.char_val(sc.tok.start))),
            next: sc.next,
        ),
        .Str   => src.str_open(sc.tok).match ({
            true  => a.parse_garbage(src, sc),
            false => PExpr(
                expr: a.enode(strlit_at(a.str_val(src, sc.tok), sc.tok.start)),
                next: sc.next,
            ),
        }),
        .Ident => a.parse_ident(src, sc),
        .Eof   => {
            perr_set_at(sc.tok.start)
            PExpr(
                expr: a.enode(lit(0)),
                next: sc.next,
            )
        },
        _      => src.is_raw_at(sc.tok).match ({
            true  => a.parse_raw_call(src, sc),
            false => a.parse_other(src, sc),
        }),
    })
}
// Unterminated string tokens run to end-of-file.
str_open = (src: string_view, t: Token) bool { t.len < 2 || src.at(t.start + t.len - 1) != '"' }
// Bad atom: flag (with the offending token's offset), consume one token for progress, placeholder.
parse_garbage = (a: MutPtr<Malloc>, src: string_view, sc: Scan) PExpr {
    perr_set_at(sc.tok.start)
    PExpr(
        expr: a.enode(lit(0)),
        next: sc.next,
    )
}
// Non-literal atoms: ctor, prefix op, slice literal, lambda, parenthesized expr.
parse_other = (a: MutPtr<Malloc>, src: string_view, sc: Scan) PExpr {
    src.is_lbrace(sc.tok).then({
        return a.parse_postfix(src, src.looks_anon_struct(sc.next).match ({
            true  => a.parse_anon_struct_lit(src, sc.next),
            false => a.parse_arm_block(src, sc),
        }))
    })
    src.is_dot(sc.tok).then({
        return a.parse_ctor(src, sc)
    })
    src.is_not(sc.tok).then({
        return a.parse_not(src, sc)
    })
    src.is_minus(sc.tok).then({
        return a.parse_neg(src, sc)
    })
    src.is_lbracket(sc.tok).then({
        return a.parse_slicelit(src, sc)
    })
    (src.is_lparen(sc.tok) == false).then({
        return a.parse_garbage(src, sc)
    })
    a.lam_open(src, sc).match ({ true => a.parse_lambda(src, sc), false => a.parse_paren(src, sc) })
}
// Backslash escape byte value. `\\ \" \'` fall through `_ => e` (the char itself).
esc_byte = (e: u8) u8 {
    (e == 'n').match ({
        true  => 10,
        false => (e == 't').match ({
            true  => 9,
            false => (e == 'r').match ({
                true  => 13,
                false => (e == '0').match ({ true => 0, false => e }),
            }),
        }),
    })
}
// Two hex digits at `pos`,`pos+1` → one byte value (0..255) for `\xNN`. Returns i32 (the arithmetic
// type); the store/char-lit sites narrow to the byte, matching how `char_val` carries byte values as i32.
hex2 = (src: string_view, pos: i32) i32 { src.at(pos).hex_val() * 16 + src.at(pos + 1).hex_val() }
char_val = (src: string_view, start: i32) i32 {
    b := src.at(start + 1)
    (b == '\\').match ({
        true  => (src.at(start + 2) == 'x').match ({
            true  => src.hex2(start + 3),
            false => esc_byte(src.at(start + 2)),
        }),
        false => b,
    })
}    // '\xNN'
// String literal value: copy content and resolve escapes.
str_val = (a: MutPtr<Malloc>, src: string_view, t: Token) string_view {
    p := a.acquire(t.len)
    n := src.unescape(t.start + 1, t.start + t.len - 1, p, 0)
    store(offset(p, n), 0)
    cstr(p)
}
// Copy [pos, end) into `dst`, resolving `\`-escapes, returning the byte count written. ITERATIVE (a
// 50KB string literal is O(n) heap iteration, not O(n) C-stack — per-char recursion overflowed the
// stack on a long literal). `\xNN` consumes 4 source chars → 1 byte; other `\c` consumes 2 → 1 byte.
unescape = (src: string_view, pos: i32, end: i32, dst: RawPtr<u8>, di: i32) i32 {
    p := pos
    d := di
    @while (p < end) {
        (src.at(p) == '\\').match ({
            true  => (src.at(p + 1) == 'x').match ({
                true  => {
                    store(offset(dst, d), src.hex2(p + 2))
                    p = p + 4
                    d = d + 1
                },
                false => {
                    store(offset(dst, d), esc_byte(src.at(p + 1)))
                    p = p + 2
                    d = d + 1
                },
            }),
            false => {
                store(offset(dst, d), src.at(p))
                p = p + 1
                d = d + 1
            },
        })
    }
    d
}
// Leading-dot enum constructor; compiler.check fills the enum type.
parse_ctor = (a: MutPtr<Malloc>, src: string_view, dot: Scan) PExpr {
    vt := src.scan(dot.next)
    vt.tok.kind.match ({
        .Ident => a.parse_ctor_named(src, vt),
        _      => a.reject_match(vt.next),
    })
}
// SAME-LINE GATE (mirrors parse_ident / parse_qual_ctor / parse_method): a bare leading-dot ctor
// `.Variant(payload)` binds its `(payload)` ONLY when the `(` sits on the SAME line as the variant
// name. A NEWLINE before the `(` means `.Variant` is a bare tag VALUE (`out := .None`) and the `(`
// begins a NEW statement (`(cond).match(…)`) — never a bogus call `.None(cond)` glued across the
// break. Without this gate a value-position `.None` before a parenthesized statement fused into a
// call, silently changing program meaning (surfaced by the formatter round-trip; #53).
parse_ctor_named = (a: MutPtr<Malloc>, src: string_view, vt: Scan) PExpr {
    vn := a.lexeme(src, vt.tok)
    nx := src.scan(vt.next)
    (src.is_lparen(nx.tok) && src.nl_between(vt.next, nx.tok.start).match ({
        true  => false,
        false => true,
    })).match ({
        true  => src.is_rparen(src.scan(nx.next).tok).match ({
            true  => a.parse_ctor_empty(src, vn, nx),
            false => a.parse_ctor_payload(src, vn, nx),
        }),
        false => PExpr(
            expr: a.enode(mktag("", vn)),
            next: vt.next,
        ),
    })
}
parse_ctor_empty = (a: MutPtr<Malloc>, src: string_view, vn: string_view, lp: Scan) PExpr {
    rp := src.scan(lp.next)
    PExpr(
        expr: a.enode(mktag("", vn)),
        next: rp.next,
    )
}
parse_ctor_payload = (a: MutPtr<Malloc>, src: string_view, vn: string_view, lp: Scan) PExpr {
    pl := a.parse_payload_args(src, lp)
    PExpr(
        expr: a.enode(mkenum("", vn, pl.expr)),
        next: pl.next,
    )
}    // `.Variant(a, b, …)` payload
// Parse the `(a, b, …)` args of a variant constructor into the payload EXPR: one arg is the payload
// directly; 2+ args become an anon struct `{_0: a, _1: b, …}` matching the multi-field decl synthesis.
parse_payload_args = (a: MutPtr<Malloc>, src: string_view, lp: Scan) PExpr {
    buf := a.finit_buf()
    pe := a.fill_payload_args(src, lp.next, buf, 0)
    inits := buf.take_inits(pe.count)
    (pe.count == 1).match ({
        true  => PExpr(
            expr: inits[0].value,
            next: pe.next,
        ),
        false => PExpr(
            expr: a.enode(mkstruct(a.mangle_anon_in(a.inits_as_fields(inits)), inits)),
            next: pe.next,
        ),
    })
}    // single payload: the arg itself
fill_payload_args = (a: MutPtr<Malloc>, src: string_view, pos: i32, buf: [FieldInit], i: i32) PEnd {
    (i >= buf.len).then({
        perr_set_at(pos)
        return PEnd(
            count: i,
            next: pos,
        )
    })
    v := a.parse_or_nested(src, pos)
    buf[i] = finit(a.payload_fname(i), v.expr)
    after := src.scan(v.next)
    src.is_comma(after.tok).match ({
        true  => a.fill_payload_args(src, after.next, buf, i + 1),
        false => {
            (src.is_rparen(after.tok) == false).then({
                perr_set_at(after.tok.start)
            })
            PEnd(
                count: i + 1,
                next: after.next,
            )
        },
    })
}    // past ')'
// a boolean `.match` lowers to genc's ternary Cond: `(subj).match { true => X, false => Y }`
is_dot* = (src: string_view, t: Token) bool { src.is_op(t, '.') }
is_match_kw = (src: string_view, t: Token) bool {
    t.kind.match ({
        .Ident => src.tok_eq(t, "match"),
        _      => false,
    })
}
is_match_at = (src: string_view, pos: i32) bool {
    dot := src.scan(pos)    // a '.' followed by `match`?
    src.is_dot(dot.tok).match ({ true => src.is_match_kw(src.scan(dot.next).tok), false => false })
}
is_then_kw = (src: string_view, t: Token) bool {
    t.kind.match ({
        .Ident => src.tok_eq(t, "then"),
        _      => false,
    })
}
// Reserve only the exact lazy-control shape `.then({`; a normal field named `then` (notably IfData.then)
// and an ordinary method call with non-block arguments must continue through the regular field parser.
is_then_at = (src: string_view, pos: i32) bool {
    dot := src.scan(pos)
    kw := src.scan(dot.next)
    lp := src.scan(kw.next)
    open := src.scan(lp.next)
    src.is_dot(dot.tok) && src.is_then_kw(kw.tok) && src.is_lparen(lp.tok) && src.is_lbrace(open.tok)
}
// `.field` is field access (genc Member, chainable: `a.b.c`); `.match` is the ternary above.
// match is checked first, so a `.match` is never mistaken for a field named `match`.
is_ident_tok* = (t: Token) bool {
    t.kind.match ({
        .Ident => true,
        _      => false,
    })
}
is_field_at = (src: string_view, pos: i32) bool {
    dot := src.scan(pos)
    src.is_dot(dot.tok).match ({ true => is_ident_tok(src.scan(dot.next).tok), false => false })
}
// A postfix index `base[i]` continues the expression ONLY if the `[` is on the SAME line as
// `base`. A `[` that opens a new line is a slice-literal STATEMENT (`[1, 2, 3]`), not an index —
// without this guard it glues onto the previous statement (`x := 7` ⨯ `[1]` → `x := 7[1]`).
is_index_at = (src: string_view, pos: i32) bool {
    sc := src.scan(pos)
    src.is_lbracket(sc.tok) && src.nl_between(pos, sc.tok.start).match ({
        true  => false,
        false => true,
    })
}
// A postfix call suffix `base(args)` — a CHAINED call `make_adder(10)(5)` where `base` is itself a
// call result. ADJACENCY is the gate: the `(` must touch the base's last token with NO intervening
// whitespace (`)(`, the lexical signature of a chain). A `(` separated by a space/newline opens a NEW
// statement — Zen separates statements by whitespace, so `… / 2.0  (ng == g).match(…)` is two
// statements, NOT a call of `2.0`. Same-line-only (as for `[index]`) is too weak: it would glue a
// whitespace-separated parenthesized statement onto the previous expression.
is_call_at = (src: string_view, pos: i32) bool {
    sc := src.scan(pos)
    src.is_lparen(sc.tok) && sc.tok.start == pos
}
// Only a CALL-result (or a prior chain BLOCK, for `f(a)(b)(c)`) is a valid chained-call base: those are
// the forms that can yield a closure VALUE. Restricting here (with adjacency above) keeps the suffix from
// firing on a literal/binop/index base that merely abuts a `(` — which would change program semantics.
is_chain_base = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Call(c)  => true,
        .Block(b) => true,
        _         => false,
    })
}
// a newline in the gap before the next token? COMMENT-AWARE: a comment is whitespace, so its
// CONTENT must never change the parse — a newline INSIDE a `/* … */` block comment is not a line
// break (`Res /* two\nlines */ .Okv(1)` stays ONE line), while the newline that TERMINATES a `//`
// line comment is a real break (everything after it is a new line). Both scans stay inside the
// [lo, hi) gap between two real tokens, so any comment the lexer skipped there is complete.
nl_between = (src: string_view, lo: i32, hi: i32) bool {
    (lo >= hi).then({
        return false
    })
    (src.at(lo) == '\n').then({
        return true
    })
    (src.at(lo) == '/' && lo + 1 < hi && src.at(lo + 1) == '/').then({
        return src.raw_nl(lo + 2, hi)
    })    // `//` runs to its newline; that newline counts
    (src.at(lo) == '/' && lo + 1 < hi && src.at(lo + 1) == '*').then({
        return src.nl_between(src.skip_gap_comment(lo + 2, hi), hi)
    })    // `/* … */` is a single space
    src.nl_between(lo + 1, hi)
}
// raw '\n' scan (the pre-comment-aware nl_between): used for the tail of a `//` comment, whose
// terminating newline is a real line break.
raw_nl = (src: string_view, lo: i32, hi: i32) bool { (lo >= hi).match ({
    true  => false,
    false => src.at(lo) == '\n' || src.raw_nl(lo + 1, hi),
}) }
// skip past the `*/` closing a block comment inside a token gap; an unterminated tail (only
// possible when hi is the EOF sentinel) just ends the gap scan.
skip_gap_comment = (src: string_view, pos: i32, hi: i32) i32 {
    (pos + 1 >= hi).match ({
        true  => hi,
        false => (src.at(pos) == '*' && src.at(pos + 1) == '/').match ({
            true  => pos + 2,
            false => src.skip_gap_comment(pos + 1, hi),
        }),
    })
}
is_loop_kw = (src: string_view, t: Token) bool {
    t.kind.match ({
        .Ident => src.tok_eq(t, "loop"),
        _      => false,
    })
}
is_loop_at = (src: string_view, pos: i32) bool {
    dot := src.scan(pos)
    src.is_dot(dot.tok).match ({ true => src.is_loop_kw(src.scan(dot.next).tok), false => false })
}
// A statement-leading enum constructor `.Ok(x)` after a COMPLETED expression is a NEW statement,
// not a `.field` chain continuation: Zen has no semicolons, so `g + 1  .Ok(g)` is two statements.
// Methods/fields are lowercase, so a `.` followed by an UPPERCASE name is never a real field access
// — it is either a qualified ctor `Type.Variant` (handled by parse_field/is_qual_ctor) or a
// leading-dot ctor. The rule is TOTAL: a NEWLINE before a `.Uppercase` ALWAYS ends the previous
// statement — a qualified ctor must keep its dot on the SAME line as the type (`Res.Okv(y)`), else
// `x := Res` ⏎ `.Okv(y)` would silently glue into `Res.Okv(y)`. SAME-LINE GATE (mirrors
// is_index_at): a leading-dot ctor begins a NEW statement so a NEWLINE always precedes it; a
// `.Uppercase` on the SAME line as its base is a qualified ctor or genuine UPPERCASE FIELD access
// (`s.Big`, `o.inner.Val`) and must NOT break.
// STATEMENT-LEVEL ONLY (stmt_level, parse_type.zen): inside an unclosed `(`/`[`/arm value a new
// statement cannot begin, so breaking there could only manufacture a parse error — the split
// `true => Res` ⏎ `.Okv(1),` arm and the parenthesized `(Res` ⏎ `.Okv(2))` stay one expression.
is_variant_break = (src: string_view, pos: i32) bool {
    dot := src.scan(pos)
    fld := src.scan(dot.next)
    br := stmt_level() && src.nl_between(pos, dot.tok.start) && is_upper_byte(src.at(fld.tok.start))
    br.then({
        vbreak_note(dot.tok.start)
    })    // remember the dot for the KVBREAK diagnostic
    br
}
// parse a full expression INSIDE an open delimiter (call/ctor/index/slice/struct-lit element,
// paren group, match-arm value): a new statement cannot begin there, so the newline+`.Uppercase`
// variant break is suppressed for the sub-parse (see is_variant_break / parse_type.delim_depth).
parse_or_nested* = (a: MutPtr<Malloc>, src: string_view, pos: i32) PExpr {
    delim_enter()
    r := a.parse_or(src, pos)
    delim_exit()
    r
}
parse_postfix = (a: MutPtr<Malloc>, src: string_view, base: PExpr) PExpr {
    src.is_match_at(base.next).match ({
        true  => a.parse_match(src, base),
        false => src.is_then_at(base.next).match ({
            true  => a.parse_then(src, base),
            false => src.is_loop_at(base.next).match ({
                true  => a.parse_loop(src, base),
                false => (src.is_field_at(base.next) && src.is_variant_break(base.next).match ({
                    true  => false,
                    false => true,
                })).match ({
                    true  => a.parse_field(src, base),
                    false => src.is_index_at(base.next).match ({
                        true  => a.parse_index(src, base),
                        false => (src.is_call_at(base.next) && base.expr.is_chain_base()).match ({
                            true  => a.parse_chained_call(src, base),
                            false => base,
                        }),
                    }),
                }),
            }),
        }),
    })
}
// Lower a chained call `base(args)` (base is a closure-valued expression, not a bare name) to a block
// `({ __chaintmp_N := base  __chaintmp_N(args) })`: binding the callee to a LOCAL reuses the supported
// closure-local-call path (compiler.check.clos_local_call_name rewrites `__chaintmp_N(args)` to the
// generated `__clos_K_call(__chaintmp_N, args)`). The block's trailing call is its value.
parse_chained_call = (a: MutPtr<Malloc>, src: string_view, base: PExpr) PExpr {
    lp := src.scan(base.next)
    at := lp.tok.start
    buf := a.arg_buf()
    ae := a.fill_args(src, lp.next, buf, 0)
    tmpname := a.chain_tmp_name(at)
    sbuf: [Stmt] := slice(a.acquire(2 * sizeof(Stmt)), 2)
    sbuf[0] = slet(tmpname, base.expr)
    sbuf[1] = sexpr(a.enode(call_at(tmpname, buf.take_args(ae.count), at)))
    a.parse_postfix(src, PExpr(
        expr: a.enode(block(sbuf)),
        next: ae.next,
    ))
}
// Foreach over recv; compiler.check fills the element type.
parse_loop = (a: MutPtr<Malloc>, src: string_view, base: PExpr) PExpr {
    dot := src.scan(base.next)
    kw := src.scan(dot.next)
    lp := src.scan(kw.next)
    op := src.scan(lp.next)
    ht := src.scan(op.next)
    hname := a.lexeme(src, ht.tok)
    c1 := src.scan(ht.next)
    it := src.scan(c1.next)
    iname := a.lexeme(src, it.tok)
    c2 := src.scan(it.next)
    xt := src.scan(c2.next)
    xname := a.lexeme(src, xt.tok)
    cl := src.scan(xt.next)
    ob := src.scan(cl.next)
    blk := a.parse_block(src, ob.next)
    rp := src.scan(blk.next)
    a.parse_postfix(src, PExpr(
        expr: a.enode(eloop(base.expr, iname, xname, tvoid(), a.materialize(blk.list), hname)),
        next: rp.next,
    ))
}
parse_index = (a: MutPtr<Malloc>, src: string_view, base: PExpr) PExpr {
    lb := src.scan(base.next)
    ie := a.parse_or_nested(src, lb.next)
    rb := src.scan(ie.next)
    a.parse_postfix(src, PExpr(
        expr: a.enode(eindex(base.expr, ie.expr, tvoid())),
        next: rb.next,
    ))
}
// Field access, UFCS calls, and qualified enum constructors share the dot parser.
is_upper_byte = (b: u8) bool { b >= 'A' && b <= 'Z' }
is_qual_ctor = (base: PExpr, name: string_view) bool {
    rn := subj_name(base.expr)
    rn.at(0).is_upper_byte() && name.at(0).is_upper_byte()
}
// A NAMESPACE-qualified struct literal `ns.Type(field: val, …)` (e.g. `trace.Node(has: 0)`): an Uppercase
// type name after the dot whose `(` opens a `field:` shape. The faithful parser (fmt) sees the raw,
// pre-flatten source where the `ns.` alias is still present (the flatten pipeline resolves `ns.Type` to
// `Type` first, so only fmt reaches here); a method call takes POSITIONAL args (no `name:`), so the
// `field:` shape disambiguates. Round-trips via a `MakeStruct` whose type carries the dotted `ns.Type`.
is_qual_struct_lit = (src: string_view, base: PExpr, name: string_view, fld: Scan) bool {
    nx := src.scan(fld.next)
    subj_name(base.expr).at(0) != 0 && name.at(0).is_upper_byte() && src.is_lparen(nx.tok) && src.nl_between(fld.next, nx.tok.start).match ({
        true  => false,
        false => true,
    }) && src.paren_is_struct(nx.next)
}
parse_qual_struct_lit = (a: MutPtr<Malloc>, src: string_view, base: PExpr, name: string_view, fld: Scan) PExpr {
    open := src.scan(fld.next)
    qn := a.dotted_name_in(subj_name(base.expr), name)
    buf := a.finit_buf()
    fe := a.fill_pinits(src, open.next, buf, 0)
    PExpr(
        expr: a.enode(mkstruct(qn, buf.take_inits(fe.count))),
        next: fe.next,
    )
}
// A namespace-qualified GENERIC type head `subj.Name<TyArgs>` — returns the position just past the
// closing `>` (or -1 if not a well-formed generic head). Like is_qual_struct_lit, only the faithful
// (fmt) parser reaches here: the flatten pipeline strips the `subj.` alias before the compiler parse,
// leaving the bare `Name<TyArgs>…` forms that parse_ident handles.
qual_generic_after = (src: string_view, base: PExpr, name: string_view, fld: Scan) i32 {
    nx := src.scan(fld.next)
    (subj_name(base.expr).at(0) != 0 && name.at(0).is_upper_byte() && src.is_langle(nx.tok)).match ({
        true  => src.tyargs_end(nx.next, 1),
        false => 0 - 1,
    })
}
// `subj.Name<TyArgs>(field: val, …)` — a qualified generic struct literal.
is_qual_generic_struct_lit = (src: string_view, base: PExpr, name: string_view, fld: Scan) bool {
    after := src.qual_generic_after(base, name, fld)
    (after < 0).match ({
        true  => false,
        false => {
            sc := src.scan(after)
            src.is_lparen(sc.tok) && src.nl_between(after, sc.tok.start).match ({
                true  => false,
                false => true,
            }) && src.paren_is_struct(sc.next)
        },
    })
}
// `subj.Name<TyArgs>.Variant(args)` (or nullary `subj.Name<TyArgs>.None`) — a qualified generic ctor.
is_qual_generic_ctor = (src: string_view, base: PExpr, name: string_view, fld: Scan) bool {
    after := src.qual_generic_after(base, name, fld)
    (after < 0).match ({
        true  => false,
        false => {
            dot := src.scan(after)
            src.is_dot(dot.tok).match ({
                true  => {
                    vt := src.scan(dot.next)
                    is_ident_tok(vt.tok) && a_lex_upper(src, vt.tok)
                },
                false => false,
            })
        },
    })
}
parse_qual_generic_struct_lit = (a: MutPtr<Malloc>, src: string_view, base: PExpr, name: string_view, fld: Scan) PExpr {
    qn := a.dotted_name_in(subj_name(base.expr), name)
    lt := src.scan(fld.next)    // '<'
    ta := a.parse_tyargs(src, lt.next)
    open := src.scan(ta.next)    // '('
    buf := a.finit_buf()
    fe := a.fill_pinits(src, open.next, buf, 0)
    PExpr(
        expr: a.enode(mkstructg_at(qn, a.mangle_str_in(qn, ta.args), ta.args, buf.take_inits(fe.count), fld.tok.start)),
        next: fe.next,
    )
}
parse_qual_generic_ctor = (a: MutPtr<Malloc>, src: string_view, base: PExpr, name: string_view, fld: Scan) PExpr {
    qn := a.dotted_name_in(subj_name(base.expr), name)
    lt := src.scan(fld.next)    // '<'
    ta := a.parse_tyargs(src, lt.next)
    dot := src.scan(ta.next)    // '.'
    vs := src.scan(dot.next)    // the variant name
    vn := a.lexeme(src, vs.tok)
    a.finish_generic_ctor(src, qn, a.mangle_str_in(qn, ta.args), ta.args, vn, vs)
}
parse_field = (a: MutPtr<Malloc>, src: string_view, base: PExpr) PExpr {
    dot := src.scan(base.next)
    fld := src.scan(dot.next)
    name := a.lexeme(src, fld.tok)
    is_qual_generic_struct_lit(src, base, name, fld).match ({
        true  => a.parse_postfix(src, a.parse_qual_generic_struct_lit(src, base, name, fld)),
        false => is_qual_generic_ctor(src, base, name, fld).match ({
            true  => a.parse_postfix(src, a.parse_qual_generic_ctor(src, base, name, fld)),
            false => is_qual_struct_lit(src, base, name, fld).match ({
                true  => a.parse_postfix(src, a.parse_qual_struct_lit(src, base, name, fld)),
                false => is_qual_ctor(base, name).match ({
                    true  => a.parse_postfix(src, a.parse_qual_ctor(src, subj_name(base.expr), name, fld)),
                    false => a.parse_field_plain(src, base, name, fld),
                }),
            }),
        }),
    })
}
// SAME-LINE GATE (mirrors parse_qual_ctor / parse_ident): the method-call `(` must sit on the same line
// as the `.field` — a NEWLINE before it makes `base.field` a plain member access and the `(` a new
// statement (`nd := 10 + ed.w` ⏎ `(nd < 100).match(…)`), not `ed.w(nd < 100)`.
parse_field_plain = (a: MutPtr<Malloc>, src: string_view, base: PExpr, name: string_view, fld: Scan) PExpr {
    nx := src.scan(fld.next)
    (src.is_lparen(nx.tok) && src.nl_between(fld.next, nx.tok.start).match ({
        true  => false,
        false => true,
    })).match ({
        true  => a.parse_method(src, base, name, nx, fld.tok.start),
        false => a.parse_postfix(src, PExpr(
            expr: a.enode(member_at(base.expr, name, fld.tok.start)),
            next: fld.next,
        )),
    })
}
// Qualified enum constructors preserve the explicit type. SAME-LINE GATE (mirrors parse_ident): the
// payload `(` must sit on the same line as the variant — a NEWLINE before it makes `Type.Variant` a
// nullary tag and the `(` a new statement (`a := State.Idle` ⏎ `(a).q()`), not `State.Idle(a)`.
parse_qual_ctor = (a: MutPtr<Malloc>, src: string_view, tyname: string_view, vn: string_view, fld: Scan) PExpr {
    nx := src.scan(fld.next)
    (src.is_lparen(nx.tok) && src.nl_between(fld.next, nx.tok.start).match ({
        true  => false,
        false => true,
    })).match ({
        true  => src.is_rparen(src.scan(nx.next).tok).match ({
            true  => PExpr(
                expr: a.enode(mktag(tyname, vn)),
                next: src.scan(nx.next).next,
            ),
            false => a.parse_qual_payload(src, tyname, vn, nx),
        }),
        false => PExpr(
            expr: a.enode(mktag(tyname, vn)),
            next: fld.next,
        ),
    })
}
parse_qual_payload = (a: MutPtr<Malloc>, src: string_view, tyname: string_view, vn: string_view, lp: Scan) PExpr {
    pl := a.parse_payload_args(src, lp)
    PExpr(
        expr: a.enode(mkenum(tyname, vn, pl.expr)),
        next: pl.next,
    )
}    // `Type.Variant(a, b, …)` payload
// FAITHFUL: `recv.method(args)` -> MethodCall(recv, method, args) — keeps the UFCS surface form. The
// args here are the METHOD args only (recv is carried separately); compiler.check.desugar_method_calls
// lowers it back to the flat `Call(fn: method, args: [recv] ++ args, pos: at)` the old parser produced.
parse_method = (a: MutPtr<Malloc>, src: string_view, base: PExpr, name: string_view, lp: Scan, at: i32) PExpr {
    buf := a.arg_buf()
    ae := a.fill_args(src, lp.next, buf, 0)
    a.parse_postfix(src, PExpr(
        expr: a.enode(emcall(base.expr, name, buf.take_args(ae.count), at)),
        next: ae.next,
    ))
}
// A bare `return` keyword (not braced) in arm-body position.
is_return_arm = (src: string_view, t: Token) bool {
    t.kind.match ({
        .Ident => src.tok_eq(t, "return"),
        _      => false,
    })
}
// A one-statement `[Stmt]` holding `return v` — so `=> return v` lowers exactly like `=> { return v }`.
ret_arm_stmts = (a: MutPtr<Malloc>, v: Ptr<Expr>) [Stmt] {
    buf := slice(a.acquire(sizeof(Stmt)), 1)
    buf[0] = sret(v)
    buf
}
parse_arm_return = (a: MutPtr<Malloc>, src: string_view, kw: Scan) PExpr {
    v := a.parse_or_nested(src, kw.next)
    PExpr(
        expr: a.enode(block(a.ret_arm_stmts(v.expr))),
        next: v.next,
    )
}    // the returned value
// Match arm body: brace block, a bare `return expr`, or a single expression.
parse_arm_body = (a: MutPtr<Malloc>, src: string_view, pos: i32) PExpr {
    sc := src.scan(pos)
    src.is_lbrace(sc.tok).match ({
        true  => a.parse_arm_block(src, sc),
        false => src.is_return_arm(sc.tok).match ({
            true  => a.parse_arm_return(src, sc),
            false => a.parse_or_nested(src, pos),
        }),
    })
}
parse_arm_block = (a: MutPtr<Malloc>, src: string_view, open: Scan) PExpr {
    // Use parse_block so statement-position match arms do not turn trailing expressions into real returns.
    blk := a.parse_block(src, open.next)
    PExpr(
        expr: a.enode(block(a.materialize(blk.list))),
        next: blk.next,
    )
}
// `.match ({ ... })` dispatches by first arm kind: variant, bool, or literal.
skip_rparen = (src: string_view, pos: i32) i32 {
    sc := src.scan(pos)
    src.is_rparen(sc.tok).match ({
        true  => sc.next,
        false => {
            perr_set_at(sc.tok.start)
            pos
        },
    })
}
close_match = (src: string_view, e: PExpr) PExpr {
    PExpr(
        expr: e.expr,
        next: src.skip_rparen(e.next),
    )
}
parse_match = (a: MutPtr<Malloc>, src: string_view, subj: PExpr) PExpr {
    dot := src.scan(subj.next)
    kw := src.scan(dot.next)
    lp := src.scan(kw.next)
    open := src.scan(lp.next)
    (src.is_lparen(lp.tok) && src.is_lbrace(open.tok)).match ({
        true  => src.close_match(a.parse_match_arms(src, subj, open)),
        false => {
            perr_set_at(lp.tok.start)
            a.reject_match(open.next)
        },
    })
}
// A lazy one-way boolean effect. Unlike a one-armed `.match`, `.then({ ... })` states explicitly that
// false is a no-op. It lowers through the ordinary two-branch Cond path with an explicit empty false
// block, so statement-position control flow stays lazy and value-position use is rejected as valueless.
parse_then = (a: MutPtr<Malloc>, src: string_view, subj: PExpr) PExpr {
    dot := src.scan(subj.next)
    kw := src.scan(dot.next)
    lp := src.scan(kw.next)
    open := src.scan(lp.next)
    (src.is_lparen(lp.tok) && src.is_lbrace(open.tok)).match ({
        true  => {
            body := a.parse_block(src, open.next)
            rp := src.scan(body.next)
            src.is_rparen(rp.tok).match ({
                true  => a.parse_postfix(src, PExpr(
                    expr: a.enode(cond(subj.expr, a.enode(block(a.materialize(body.list))), a.empty_arm())),
                    next: rp.next,
                )),
                false => {
                    perr_set_at(rp.tok.start)
                    a.reject_match(rp.next)
                },
            })
        },
        false => {
            perr_set_at(lp.tok.start)
            a.reject_match(open.next)
        },
    })
}
parse_match_arms = (a: MutPtr<Malloc>, src: string_view, subj: PExpr, open: Scan) PExpr {
    first := src.scan(open.next)
    src.is_dot(first.tok).match ({
        true  => a.parse_variant_match(src, subj, open),
        false => src.is_bool_label(first.tok).match ({
            true  => a.parse_bool_match(src, subj, open),
            false => a.parse_lit_match(src, subj, open),
        }),
    })
}
is_bool_label = (src: string_view, t: Token) bool { src.tok_eq(t, "true") || src.tok_eq(t, "false") }
is_wild_label = (src: string_view, t: Token) bool { src.tok_eq(t, "_") }
// Bad/non-exhaustive match forms become an unknown sentinel call for validation to reject.
no_args = (a: MutPtr<Malloc>) [Expr] { slice(null_ptr(), 0) }
reject_match = (a: MutPtr<Malloc>, next: i32) PExpr {
    PExpr(
        expr: a.enode(call("__nonexhaustive_match", a.no_args())),
        next: next,
    )
}
// A best-effort source position for the match SUBJECT, so a non-enum `.match` reject can carry a
// caret "at the match" (mirrors the enum path's subject caret). Bottoms out at the subject Var.
match_subj_pos = (e: Ptr<Expr>) i32 {
    load(e).match ({
        .Var(v)    => v.pos,
        .Bin(b)    => b.lhs.match_subj_pos(),
        .Member(m) => m.obj.match_subj_pos(),
        .Index(ix) => ix.seq.match_subj_pos(),
        .Call(c)   => c.pos,
        _          => 0,
    })
}
// A literal-scalar `.match` with NO `_` wildcard is non-exhaustive: the value domain is unbounded, so
// no finite set of literal labels covers every case. Distinct sentinel (`__nonexhaustive_lit`) carrying
// the subject position — the validator maps it to a POSITIONED error[exhaustiveness], never undefined-name.
reject_exhaust = (a: MutPtr<Malloc>, next: i32, pos: i32) PExpr {
    PExpr(
        expr: a.enode(call_at("__nonexhaustive_lit", a.no_args(), pos)),
        next: next,
    )
}
// A boolean `.match` arm labelled with a non-boolean literal (`true => 1, 0 => 2`) is a label-TYPE
// error. Distinct sentinel (`__badmatchlabel`) carrying the offending LABEL's position — the validator
// maps it to a POSITIONED error[match-label] with a caret on the bad label, never undefined-name.
reject_label = (a: MutPtr<Malloc>, next: i32, pos: i32) PExpr {
    PExpr(
        expr: a.enode(call_at("__badmatchlabel", a.no_args(), pos)),
        next: next,
    )
}
// Shared `=> body` parse step for bool/literal/variant arm walkers.
arm_rhs = (a: MutPtr<Malloc>, src: string_view, pos: i32, bare_ok: bool) PExpr {
    nx := src.scan(pos)
    src.is_fat_arrow(nx.tok).match ({
        true  => a.parse_arm_body(src, nx.next),
        false => {
            (bare_ok == false).then({
                perr_set_at(nx.tok.start)
            })
            PExpr(
                expr: a.enode(block(a.no_arm_stmts())),
                next: pos,
            )
        },
    })
}
// Bool match requires two arms or a wildcard; assembly is order-independent.
BoolArmEnd*: {
    lab: Token,
    body: Ptr<Expr>,
    ok: bool,
    next: i32,
}
bool_arm = (a: MutPtr<Malloc>, src: string_view, pos: i32) BoolArmEnd {
    lt := src.scan(pos)
    rhs := a.arm_rhs(src, lt.next, src.is_wild_label(lt.tok))
    BoolArmEnd(
        lab: lt.tok,
        body: rhs.expr,
        ok: src.is_bool_label(lt.tok) || src.is_wild_label(lt.tok),
        next: rhs.next,
    )
}
parse_bool_match = (a: MutPtr<Malloc>, src: string_view, subj: PExpr, open: Scan) PExpr {
    a0 := a.bool_arm(src, open.next)
    sep := src.scan(a0.next)
    src.is_comma(sep.tok).match ({
        true  => a.bool_second(src, subj, a0, sep.next),
        false => src.is_rbrace(sep.tok).match ({
            true  => a.bool_one(src, subj, a0, sep.next),
            false => a.reject_match(sep.next),
        }),
    })
}
// No comma after the only arm: `(c).match ({ true => … })` remains represented as a one-armed Cond so
// validation can issue a targeted exhaustiveness diagnostic. Use `.then({ ... })` for an intentional
// one-way effect, or spell the missing bool / `_` arm explicitly.
bool_second = (a: MutPtr<Malloc>, src: string_view, subj: PExpr, a0: BoolArmEnd, pos: i32) PExpr {
    nx := src.scan(pos)
    src.is_rbrace(nx.tok).match ({
        true  => a.bool_one(src, subj, a0, nx.next),
        false => a.bool_close(src, subj, a0, a.bool_arm(src, pos)),
    })
}    // trailing comma after the only arm — still one-armed
// Build the invalid one-armed Cond, retaining a synthetic empty branch only so the ordinary AST can carry
// the source through resolution to the targeted diagnostic. oa records the missing side.
empty_arm = (a: MutPtr<Malloc>) Ptr<Expr> { a.enode(block(a.no_arm_stmts())) }
bool_one = (a: MutPtr<Malloc>, src: string_view, subj: PExpr, a0: BoolArmEnd, next: i32) PExpr {
    a0.ok.match ({
        true  => src.tok_eq(a0.lab, "false").match ({
            true  => PExpr(
                expr: a.enode(cond_oa(subj.expr, a.empty_arm(), a0.body, 2)),
                next: next,
            ),
            false => PExpr(
                expr: a.enode(cond_oa(subj.expr, a0.body, a.empty_arm(), 1)),
                next: next,
            ),
        }),
        false => a.reject_match(next),
    })
}
bool_close = (a: MutPtr<Malloc>, src: string_view, subj: PExpr, a0: BoolArmEnd, a1: BoolArmEnd) PExpr {
    c0 := src.scan(a1.next)
    close := src.is_comma(c0.tok).match ({ true => src.scan(c0.next), false => c0 })
    (a0.ok && a1.ok && src.is_rbrace(close.tok)).match ({
        true  => src.tok_eq(a0.lab, "true").match ({
            true  => PExpr(
                expr: a.enode(cond(subj.expr, a0.body, a1.body)),
                next: close.next,
            ),
            false => PExpr(
                expr: a.enode(cond(subj.expr, a1.body, a0.body)),
                next: close.next,
            ),
        }),
        false => a1.ok.match ({
            true  => a.reject_match(close.next),
            false => a.reject_label(close.next, a1.lab.start),
        }),
    })
}
// Literal match lowers to nested equality conditionals.
LitArmEnd*: {
    test: Ptr<Expr>,
    body: Ptr<Expr>,
    wild: bool,
    next: i32,
}
parse_lit_match = (a: MutPtr<Malloc>, src: string_view, subj: PExpr, open: Scan) PExpr {
    first := src.scan(open.next)
    src.is_wild_label(first.tok).match ({
        true  => a.parse_lit_arms(src, subj, open.next),
        false => a.parse_lit_first(src, subj, open.next),
    })
}
parse_lit_first = (a: MutPtr<Malloc>, src: string_view, subj: PExpr, pos: i32) PExpr {
    arm := a.parse_lit_arm(src, subj, pos)
    after := src.scan(arm.next)
    src.is_rbrace(after.tok).match ({
        true  => a.reject_exhaust(after.next, subj.expr.match_subj_pos()),
        false => a.parse_lit_after(src, subj, arm, after),
    })
}
parse_lit_arms = (a: MutPtr<Malloc>, src: string_view, subj: PExpr, pos: i32) PExpr {
    arm := a.parse_lit_arm(src, subj, pos)
    after := src.scan(arm.next)
    a.parse_lit_after(src, subj, arm, after)
}
parse_lit_after = (a: MutPtr<Malloc>, src: string_view, subj: PExpr, arm: LitArmEnd, after: Scan) PExpr {
    after.tok.kind.match ({
        .Eof => {
            perr_set_at(after.tok.start)
            a.reject_match(after.next)
        },
        _    => src.is_rbrace(after.tok).match ({
            true  => arm.wild.match ({
                true  => PExpr(
                    expr: arm.body,
                    next: after.next,
                ),
                false => a.reject_exhaust(after.next, subj.expr.match_subj_pos()),
            }),
            false => src.is_comma(after.tok).match ({
                true  => a.lit_arm_more(src, subj, arm, after),
                false => {
                    perr_set_at(after.tok.start)
                    a.reject_match(after.next)
                },
            }),
        }),
    })
}
// Trailing comma may close a literal match; otherwise parse the next arm.
lit_arm_more = (a: MutPtr<Malloc>, src: string_view, subj: PExpr, arm: LitArmEnd, after: Scan) PExpr {
    nx := src.scan(after.next)
    src.is_rbrace(nx.tok).match ({
        true  => arm.wild.match ({
            true  => PExpr(
                expr: arm.body,
                next: nx.next,
            ),
            false => a.reject_exhaust(nx.next, subj.expr.match_subj_pos()),
        }),
        false => a.cons_lit_arm(src, subj, arm, after),
    })
}
cons_lit_arm = (a: MutPtr<Malloc>, src: string_view, subj: PExpr, arm: LitArmEnd, after: Scan) PExpr {
    rest := a.parse_lit_arms(src, subj, after.next)
    PExpr(
        expr: a.enode(cond(arm.test, arm.body, rest.expr)),
        next: rest.next,
    )
}
parse_lit_arm = (a: MutPtr<Malloc>, src: string_view, subj: PExpr, pos: i32) LitArmEnd {
    sc := src.scan(pos)
    src.is_wild_label(sc.tok).match ({
        true  => a.parse_lit_arm_wild(src, sc),
        false => a.parse_lit_arm_val(src, subj, pos),
    })
}
// Wildcard literal arm is an always-true default.
parse_lit_arm_wild = (a: MutPtr<Malloc>, src: string_view, us: Scan) LitArmEnd {
    rhs := a.arm_rhs(src, us.next, true)
    LitArmEnd(
        test: a.enode(lit(1)),
        body: rhs.expr,
        wild: true,
        next: rhs.next,
    )
}
// A non-wildcard value arm is a literal label followed by `=> body`.
parse_lit_arm_val = (a: MutPtr<Malloc>, src: string_view, subj: PExpr, pos: i32) LitArmEnd { a.parse_lit_arm_lit(src, subj, pos) }
parse_lit_arm_lit = (a: MutPtr<Malloc>, src: string_view, subj: PExpr, pos: i32) LitArmEnd {
    le := a.parse_atom(src, pos)    // the literal label (0, 'a', -5, …)
    rhs := a.arm_rhs(src, le.next, false)
    LitArmEnd(
        test: a.enode(bin("==", subj.expr, le.expr)),
        body: rhs.expr,
        wild: false,
        next: rhs.next,
    )
}    // the mandatory `=> body`
subj_name = (e: Ptr<Expr>) string_view {
    load(e).match ({
        .Var(v) => v.name,
        _       => "",
    })
}
// Variant match arms; compiler.check fills the enum name.
arm_buf = (a: MutPtr<Malloc>) [ArmData] { slice(a.acquire(1024 * sizeof(ArmData)), 1024) }
take_arms = (buf: [ArmData], n: i32) [ArmData] { slice(buf.ptr, n) }
// A comma-separated payload binder list `(x, y, …)` — one entry for a single binder, N for a destructure.
BindList*: {
    names: [string_view],
    count: i32,
    next: i32,
}
// One binder slot: a borrowed string view. Kept as a named struct for generic buffer element sizing;
// a one-pointer struct is exactly one binder slot (see map.zen).
NameSlot: {
    s: string_view,
}
bind_buf = (a: MutPtr<Malloc>) [string_view] { slice(a.acquire(64 * sizeof(NameSlot)), 64) }
fill_binds = (a: MutPtr<Malloc>, src: string_view, pos: i32, buf: [string_view], i: i32) BindList {
    (i >= buf.len).then({
        perr_set_at(pos)
        return BindList(
            names: buf,
            count: i,
            next: pos,
        )
    })
    bt := src.scan(pos)
    // Each binder must be an identifier (or `_`); a literal like `.Some(123)` is garbage.
    (is_ident_tok(bt.tok) == false).then({
        perr_set_at(bt.tok.start)
    })
    buf[i] = a.lexeme(src, bt.tok)
    nx := src.scan(bt.next)
    src.is_comma(nx.tok).match ({
        true  => a.fill_binds(src, nx.next, buf, i + 1),
        false => {
            (src.is_rparen(nx.tok) == false).then({
                perr_set_at(nx.tok.start)
            })
            BindList(
                names: buf,
                count: i + 1,
                next: nx.next,
            )
        },
    })
}
arm_binds = (a: MutPtr<Malloc>, src: string_view, pos: i32) BindList { a.fill_binds(src, pos, a.bind_buf(), 0) }
// Multi-binder destructure `.A(x, y) => body` desugars to ONE synthetic binder `__zen_payload` bound to
// the anon-struct payload, plus prepended `x := __zen_payload._0  y := __zen_payload._1 …` lets, then the
// original body as the trailing value — lowering to the existing single-binder + field-access form.
fill_destr = (a: MutPtr<Malloc>, bl: BindList, stm: [Stmt], k: i32) void {
    (k < bl.count).then({
        stm[k] = slet(bl.names[k], a.enode(member(a.enode(vref("__zen_payload")), a.payload_fname(k))))
        a.fill_destr(bl, stm, k + 1)
    })
}
destr_body = (a: MutPtr<Malloc>, bl: BindList, body: Ptr<Expr>) Ptr<Expr> {
    n := bl.count
    stm := slice(a.acquire((n + 1) * sizeof(Stmt)), n + 1)
    a.fill_destr(bl, stm, 0)
    stm[n] = sexpr(body)
    a.enode(block(stm))
}
fill_arms = (a: MutPtr<Malloc>, src: string_view, pos: i32, buf: [ArmData], i: i32) PEnd {
    sc := src.scan(pos)
    sc.tok.kind.match ({
        .Eof => {
            perr_set_at(pos)
            PEnd(
                count: i,
                next: sc.next,
            )
        },
        _    => src.is_rbrace(sc.tok).match ({
            true  => PEnd(
                count: i,
                next: sc.next,
            ),
            false => a.fill_marm(src, pos, buf, i),
        }),
    })
}
// Variant or wildcard arm; the leading token tells them apart.
fill_marm = (a: MutPtr<Malloc>, src: string_view, pos: i32, buf: [ArmData], i: i32) PEnd {
    // Guard fixed-size arm buffer.
    (i >= buf.len).then({
        perr_set_at(pos)
        return PEnd(
            count: i,
            next: pos,
        )
    })
    src.is_dot(src.scan(pos).tok).match ({
        true  => a.fill_varm(src, pos, buf, i),
        false => a.fill_wild(src, pos, buf, i),
    })
}
fill_varm = (a: MutPtr<Malloc>, src: string_view, pos: i32, buf: [ArmData], i: i32) PEnd {
    dot := src.scan(pos)
    vt := src.scan(dot.next)
    vn := a.lexeme(src, vt.tok)
    pk := src.scan(vt.next)
    src.is_lparen(pk.tok).match ({
        true  => a.fill_varm_bound(src, vn, pk.next, buf, i, dot.tok.start),
        false => {
            rhs := a.arm_rhs(src, vt.next, false)
            buf[i] = arm_at(vn, "", rhs.expr, dot.tok.start)
            a.arm_tail(src, rhs.next, buf, i)
        },
    })
}
// `.Variant(binders…) => body`: a single binder keeps the existing form; multiple binders desugar.
fill_varm_bound = (a: MutPtr<Malloc>, src: string_view, vn: string_view, pos: i32, buf: [ArmData], i: i32, dpos: i32) PEnd {
    bl := a.arm_binds(src, pos)
    rhs := a.arm_rhs(src, bl.next, false)
    buf[i] = (bl.count == 1).match ({
        true  => arm_at(vn, bl.names[0], rhs.expr, dpos),
        false => arm_at(vn, "__zen_payload", a.destr_body(bl, rhs.expr), dpos),
    })
    a.arm_tail(src, rhs.next, buf, i)
}
// Distinguish `_ => body` from terminal bare `_`.
is_fat_arrow = (src: string_view, t: Token) bool {
    t.kind.match ({
        .Sym => t.len == 2 && src.at(t.start) == '=' && src.at(t.start + 1) == '>',
        _    => false,
    })
}
no_arm_stmts = (a: MutPtr<Malloc>) [Stmt] { slice(null_ptr(), 0) }
// Wildcard arm or terminal bare `_`; non-wild labels here are parse errors.
fill_wild = (a: MutPtr<Malloc>, src: string_view, pos: i32, buf: [ArmData], i: i32) PEnd {
    us := src.scan(pos)
    (src.is_wild_label(us.tok) == false).then({
        perr_set_at(us.tok.start)
    })
    rhs := a.arm_rhs(src, us.next, true)
    buf[i] = arm_at("_", "", rhs.expr, us.tok.start)
    a.arm_tail(src, rhs.next, buf, i)
}
// Comma continues arm list; rbrace closes it; anything else is a parse error.
arm_tail = (a: MutPtr<Malloc>, src: string_view, pos: i32, buf: [ArmData], i: i32) PEnd {
    after := src.scan(pos)
    src.is_comma(after.tok).match ({
        true  => a.fill_arms(src, after.next, buf, i + 1),
        false => {
            (src.is_rbrace(after.tok) == false).then({
                perr_set_at(after.tok.start)
            })
            PEnd(
                count: i + 1,
                next: after.next,
            )
        },
    })
}
parse_variant_match = (a: MutPtr<Malloc>, src: string_view, subj: PExpr, open: Scan) PExpr {
    buf := a.arm_buf()
    ae := a.fill_arms(src, open.next, buf, 0)
    PExpr(
        expr: a.enode(ematch(subj.expr, "", buf.take_arms(ae.count))),
        next: ae.next,
    )
}
is_lparen* = (src: string_view, t: Token) bool { src.is_op(t, '(') }
is_raw_at = (src: string_view, t: Token) bool { src.is_op(t, '@') }
// One-char `:` marks struct field init; `:=` is a different two-byte symbol.
is_field_colon* = (src: string_view, t: Token) bool { src.is_op(t, ':') && t.len == 1 }
// `Name(` is a struct construction iff the first item is `ident:`.
paren_is_struct = (src: string_view, pos: i32) bool {
    id := src.scan(pos)
    is_ident_tok(id.tok).match ({
        true  => src.is_field_colon(src.scan(id.next).tok),
        false => false,
    })
}
parse_ident = (a: MutPtr<Malloc>, src: string_view, sc: Scan) PExpr {
    name := a.lexeme(src, sc.tok)
    nx := src.scan(sc.next)
    // Calls/constructions only continue on the same line as the name.
    (src.is_lparen(nx.tok) && src.nl_between(sc.next, nx.tok.start).match ({
        true  => false,
        false => true,
    })).match ({
        true  => src.paren_is_struct(nx.next).match ({
            true  => a.parse_paren_struct_lit(src, name, nx, sc.tok.start),
            false => a.parse_call(src, name, nx, sc.tok.start),
        }),
        false => src.is_langle(nx.tok).match ({
            true  => src.looks_generic_lit(nx.next).match ({
                true  => a.parse_generic_struct_lit(src, name, nx.next, sc.tok.start),
                false => src.looks_turbofish(nx.next).match ({
                    true  => a.parse_turbofish_call(src, name, nx.next, sc.tok.start),
                    false => src.looks_generic_ctor(nx.next).match ({
                        true  => a.parse_generic_ctor(src, name, nx.next),
                        false => PExpr(
                            expr: a.enode(vref_at(name, sc.tok.start)),
                            next: sc.next,
                        ),
                    }),
                }),
            }),
            false => PExpr(
                expr: a.enode(vref_at(name, sc.tok.start)),
                next: sc.next,
            ),
        }),
    })
}
// A generic enum constructor with EXPLICIT type args: `Name<TyArgs>.Variant(args)` (or nullary
// `Name<TyArgs>.None`). Distinguished from turbofish/generic-struct-lit (which want a `(` after the
// `>`) by an Uppercase `.Variant` following the closing `>`. If the shape isn't exact, `<` stays the
// comparison operator (so `a < b > c` is intact).
looks_generic_ctor = (src: string_view, pos: i32) bool {
    after := src.tyargs_end(pos, 1)
    (after < 0).match ({
        true  => false,
        false => {
            dot := src.scan(after)
            src.is_dot(dot.tok).match ({
                true  => {
                    vt := src.scan(dot.next)
                    is_ident_tok(vt.tok) && a_lex_upper(src, vt.tok)
                },
                false => false,
            })
        },
    })
}
// First byte of a token span is Uppercase (a variant/type name, not a lowercase field/method).
a_lex_upper = (src: string_view, t: Token) bool { src.at(t.start).is_upper_byte() }
parse_generic_ctor = (a: MutPtr<Malloc>, src: string_view, name: string_view, pos: i32) PExpr {
    ta := a.parse_tyargs(src, pos)    // pos just past '<'
    dot := src.scan(ta.next)    // the '.'
    vs := src.scan(dot.next)    // the variant name
    vn := a.lexeme(src, vs.tok)
    a.finish_generic_ctor(src, name, a.mangle_str_in(name, ta.args), ta.args, vn, vs)
}
// Shared tail for unqualified/qualified generic enum ctors: SAME-LINE payload gate (mirrors
// parse_qual_ctor) — a NEWLINE before `(` makes `Type<T>.Variant` a nullary tag and `(` a new
// statement. Empty `()` → nullary tag; `(a, …)` → payload enum; no `(` → nullary tag.
finish_generic_ctor = (a: MutPtr<Malloc>, src: string_view, ty: string_view, mty: string_view, targs: [Ty], vn: string_view, vs: Scan) PExpr {
    nx := src.scan(vs.next)
    (src.is_lparen(nx.tok) && src.nl_between(vs.next, nx.tok.start).match ({
        true  => false,
        false => true,
    })).match ({
        true  => src.is_rparen(src.scan(nx.next).tok).match ({
            true  => PExpr(
                expr: a.enode(mktagg(ty, mty, targs, vn)),
                next: src.scan(nx.next).next,
            ),
            false => {
                pl := a.parse_payload_args(src, nx)
                PExpr(
                    expr: a.enode(mkenumg(ty, mty, targs, vn, pl.expr)),
                    next: pl.next,
                )
            },
        }),
        false => PExpr(
            expr: a.enode(mktagg(ty, mty, targs, vn)),
            next: vs.next,
        ),
    })
}
// Turbofish: `name<Type, …>(args)` — an explicit-type-arg CALL (positional args, NOT a struct lit).
// Disambiguates from comparison: require a well-formed `<Type…>` (parse_type tokens, matching `>`)
// IMMEDIATELY followed by a `(` that is NOT a `field:` struct (that's looks_generic_lit's job). If
// the shape isn't exact, `<` stays the comparison operator (so `a < b`, `a < b && c > d` are intact).
looks_turbofish = (src: string_view, pos: i32) bool {
    after := src.tyargs_end(pos, 1)
    (after < 0).match ({
        true  => false,
        false => {
            sc := src.scan(after)
            src.is_lparen(sc.tok).match ({
                true  => src.paren_is_struct(sc.next).match ({ true => false, false => true }),
                false => false,
            })
        },
    })
}
parse_turbofish_call = (a: MutPtr<Malloc>, src: string_view, name: string_view, pos: i32, at: i32) PExpr {
    ta := a.parse_tyargs(src, pos)    // pos just past '<'
    lp := src.scan(ta.next)    // the '('
    buf := a.arg_buf()
    ae := a.fill_args(src, lp.next, buf, 0)
    PExpr(
        expr: a.enode(call_targs_at(name, buf.take_args(ae.count), ta.args, at)),
        next: ae.next,
    )
}
// Decide whether `<...>` starts generic struct construction, not a comparison.
looks_generic_lit = (src: string_view, pos: i32) bool {
    after := src.tyargs_end(pos, 1)
    (after < 0).match ({ true => false, false => src.generic_open(after) })
}
generic_open = (src: string_view, after: i32) bool {
    sc := src.scan(after)
    src.is_lparen(sc.tok).match ({ true => src.paren_is_struct(sc.next), false => false })
}
tyargs_end* = (src: string_view, pos: i32, depth: i32) i32 {
    // DEPTH CAP: bound recursion so pathologically-nested `Ptr<Ptr<…>>` annotations
    // become a clean parse error (-1) instead of a stack overflow. Real programs never
    // approach this nesting (the monomorphizer caps well-formed depth at 24).
    (depth > 256).then({
        return 0 - 1
    })
    sc := src.scan(pos)
    // A `>>` token (lexed as one shift op) closes TWO generic levels in EXPRESSION position, mirroring
    // parse_type's gt_resume split. Must be tested BEFORE is_rangle: `is_op(t, '>')` matches on the FIRST
    // char only, so a `>>` would otherwise be mis-read as a single close that skips both '>' chars.
    src.is_langle(sc.tok).match ({
        true  => src.tyargs_end(sc.next, depth + 1),
        false => src.is_shr_close(sc.tok).match ({
            true  => (depth == 1).match ({
                true  => sc.tok.start + 1,
                false => (depth == 2).match ({
                    true  => sc.next,
                    false => src.tyargs_end(sc.next, depth - 2),
                }),
            }),
            false => src.is_rangle(sc.tok).match ({
                true  => (depth == 1).match ({
                    true  => sc.next,
                    false => src.tyargs_end(sc.next, depth - 1),
                }),
                false => src.is_tyarg_tok(sc.tok).match ({
                    true  => src.tyargs_end(sc.next, depth),
                    false => 0 - 1,
                }),
            }),
        }),
    })
}
is_tyarg_tok = (src: string_view, t: Token) bool { is_ident_tok(t) || src.is_comma(t) || src.is_lbracket(t) || src.is_rbracket(t) || src.is_lparen(t) || src.is_rparen(t) || src.is_op(t, ':') }    // fn-type args `() R` — a `(A,B) R` element inside `Name<…>`; `:` = a decl tparam bound `<T: Trait>`
// Generic struct construction is `Name<...>(f: v)`.
parse_generic_struct_lit = (a: MutPtr<Malloc>, src: string_view, name: string_view, pos: i32, tnpos: i32) PExpr {
    ta := a.parse_tyargs(src, pos)    // pos just past '<'
    open := src.scan(ta.next)
    buf := a.finit_buf()
    fe := a.fill_pinits(src, open.next, buf, 0)
    mty := a.mangle_str_in(name, ta.args)
    inits := buf.take_inits(fe.count)
    PExpr(
        expr: a.enode(mkstructg_at(name, mty, ta.args, inits, tnpos)),
        next: fe.next,
    )
}
// ── anonymous (structural) struct literal `{ q: v, r: v }` ────────────────────────
// Distinguished from a brace BLOCK (`{ stmts }`) by the leading shape `ident :` (single colon) whose
// first top-level separator is a `,` or the closing `}` — NOT a `:=` (which would make it a typed-let
// block `{ x: T := … }`). The literal's structural name (mangle_anon_in over the field names) matches
// the one parse_type synthesizes for the corresponding `{ q: T, r: T }` TYPE, so they share a C struct.
is_walrus_tok = (src: string_view, t: Token) bool {
    t.kind.match ({
        .Sym => t.len == 2 && src.at(t.start) == ':' && src.at(t.start + 1) == '=',
        _    => false,
    })
}
looks_anon_struct* = (src: string_view, pos: i32) bool {
    id := src.scan(pos)    // pos just past '{'
    is_ident_tok(id.tok).match ({
        true  => {
            c := src.scan(id.next)
            src.is_field_colon(c.tok).match ({
                true  => src.anon_scan_kind(c.next, 0) == 1,
                false => false,
            })
        },
        false => false,
    })
}
// 1 = anon struct (a top-level ',' or the closing '}'), 0 = block (a top-level ':='), -1 = EOF/garbage.
anon_scan_kind = (src: string_view, pos: i32, depth: i32) i32 {
    sc := src.scan(pos)
    sc.tok.kind.match ({
        .Eof => 0 - 1,
        _    => src.is_lbrace(sc.tok).match ({
            true  => src.anon_scan_kind(sc.next, depth + 1),
            false => src.is_rbrace(sc.tok).match ({
                true  => (depth == 0).match ({
                    true  => 1,
                    false => src.anon_scan_kind(sc.next, depth - 1),
                }),
                false => src.anon_scan_open(sc, depth),
            }),
        }),
    })
}
anon_scan_open = (src: string_view, sc: Scan, depth: i32) i32 {
    (src.is_lparen(sc.tok) || src.is_lbracket(sc.tok)).match ({
        true  => src.anon_scan_kind(sc.next, depth + 1),
        false => (src.is_rparen(sc.tok) || src.is_rbracket(sc.tok)).match ({
            true  => src.anon_scan_kind(sc.next, depth - 1),
            false => (depth == 0).match ({
                true  => src.is_walrus_tok(sc.tok).match ({
                    true  => 0,
                    false => src.is_comma(sc.tok).match ({
                        true  => 1,
                        false => src.anon_scan_kind(sc.next, depth),
                    }),
                }),
                false => src.anon_scan_kind(sc.next, depth),
            }),
        }),
    })
}
afield_lit_buf = (a: MutPtr<Malloc>) [Field] { slice(a.acquire(256 * sizeof(Field)), 256) }
// Syntactically infer a literal field VALUE's type, mirroring the checker's infer_expr for the forms a
// struct-literal field can take directly (int/byte/float/string literals and nested struct literals). The
// structural NAME is names-only, so this only feeds the synthesized StructDecl's C field types; a value the
// parser can't read (a var/call result) falls back to i32 (the un-annotated default).
infer_lit_ty = (value: Ptr<Expr>) Ty {
    load(value).match ({
        .Int(n)        => (n > 2147483647 || n < 0 - 2147483648).match ({
            true  => ti64(),
            false => ti32(),
        }),
        .Byte(b)       => tu8(),
        .FloatLit(ft)  => tf64(),
        .StrLit(s)     => tstring_literal(),
        .MakeStruct(s) => tnamed(s.ty),
        _              => ti32(),
    })
}
inits_as_fields = (a: MutPtr<Malloc>, inits: [FieldInit]) [Field] {
    buf := a.afield_lit_buf()
    inits.loop((h, i, fi) {
        buf[i] = field(fi.name, infer_lit_ty(fi.value))
    })    // names-only mangle; types feed the hoisted StructDecl
    slice(buf.ptr, inits.len)
}
parse_anon_struct_lit = (a: MutPtr<Malloc>, src: string_view, pos: i32) PExpr {
    buf := a.finit_buf()    // pos just past '{'
    fe := a.fill_ainits(src, pos, buf, 0)
    inits := buf.take_inits(fe.count)
    fields := a.inits_as_fields(inits)
    name := a.mangle_anon_in(fields)
    register_anon(name, fields)
    PExpr(
        expr: a.enode(mkstruct(name, inits)),
        next: fe.next,
    )
}    // hoist the synthesized struct decl (a bare literal has no type-position decl)
fill_ainits = (a: MutPtr<Malloc>, src: string_view, pos: i32, buf: [FieldInit], i: i32) PEnd {
    sc := src.scan(pos)
    sc.tok.kind.match ({
        .Eof => {
            perr_set_at(pos)
            PEnd(
                count: i,
                next: sc.next,
            )
        },
        _    => src.is_rbrace(sc.tok).match ({
            true  => PEnd(
                count: i,
                next: sc.next,
            ),
            false => a.fill_ainit(src, pos, buf, i),
        }),
    })
}
fill_ainit = (a: MutPtr<Malloc>, src: string_view, pos: i32, buf: [FieldInit], i: i32) PEnd {
    (i >= buf.len).then({
        perr_set_at(pos)
        return PEnd(
            count: i,
            next: pos,
        )
    })
    nt := src.scan(pos)    // field name
    nm := a.lexeme(src, nt.tok)
    colon := src.scan(nt.next)    // ':'
    v := a.parse_or_nested(src, colon.next)    // the value expression
    buf[i] = finit(nm, v.expr)
    after := src.scan(v.next)    // ',' / next field / '}'
    src.is_comma(after.tok).match ({
        true  => a.fill_ainits(src, after.next, buf, i + 1),
        false => is_ident_tok(after.tok).match ({
            true  => a.fill_ainits(src, v.next, buf, i + 1),
            false => PEnd(
                count: i + 1,
                next: after.next,
            ),
        }),
    })
}
// Paren struct construction: `Name(field: value, ...)`.
finit_buf = (a: MutPtr<Malloc>) [FieldInit] { slice(a.acquire(1024 * sizeof(FieldInit)), 1024) }
take_inits = (buf: [FieldInit], n: i32) [FieldInit] { slice(buf.ptr, n) }
parse_paren_struct_lit = (a: MutPtr<Malloc>, src: string_view, name: string_view, open: Scan, tnpos: i32) PExpr {
    buf := a.finit_buf()
    fe := a.fill_pinits(src, open.next, buf, 0)
    PExpr(
        expr: a.enode(mkstruct_at(name, buf.take_inits(fe.count), tnpos)),
        next: fe.next,
    )
}
fill_pinits = (a: MutPtr<Malloc>, src: string_view, pos: i32, buf: [FieldInit], i: i32) PEnd {
    sc := src.scan(pos)
    src.is_rparen(sc.tok).match ({
        true  => PEnd(
            count: i,
            next: sc.next,
        ),
        false => a.fill_pinit(src, pos, buf, i),
    })
}
fill_pinit = (a: MutPtr<Malloc>, src: string_view, pos: i32, buf: [FieldInit], i: i32) PEnd {
    // Guard fixed-size field-init buffer.
    (i >= buf.len).then({
        perr_set_at(pos)
        return PEnd(
            count: i,
            next: pos,
        )
    })
    nt := src.scan(pos)
    nm := a.lexeme(src, nt.tok)
    colon := src.scan(nt.next)
    v := a.parse_or_nested(src, colon.next)
    buf[i] = finit(nm, v.expr)
    after := src.scan(v.next)
    src.is_comma(after.tok).match ({
        true  => a.fill_pinits(src, after.next, buf, i + 1),
        false => {
            // A struct-construction `Name(f: v, …)` must close on ')'; a missing ')' is a parse error, not a
            // silent terminator (mirrors fill_payload_args).
            (src.is_rparen(after.tok) == false).then({
                perr_set_at(after.tok.start)
            })
            PEnd(
                count: i + 1,
                next: after.next,
            )
        },
    })
}
// Argument and slice-literal buffers; slice literals need more room for data tables.
arg_buf = (a: MutPtr<Malloc>) [Expr] { slice(a.acquire(256 * sizeof(Expr)), 256) }
slit_buf = (a: MutPtr<Malloc>) [Expr] { slice(a.acquire(2048 * sizeof(Expr)), 2048) }
take_args = (buf: [Expr], n: i32) [Expr] { slice(buf.ptr, n) }
parse_call = (a: MutPtr<Malloc>, src: string_view, name: string_view, lp: Scan, at: i32) PExpr {
    buf := a.arg_buf()
    ae := a.fill_args(src, lp.next, buf, 0)
    PExpr(
        expr: a.enode(call_at(name, buf.take_args(ae.count), at)),
        next: ae.next,
    )
}
parse_raw_call = (a: MutPtr<Malloc>, src: string_view, at: Scan) PExpr {
    nm := src.scan(at.next)
    nm.tok.kind.match ({
        .Ident => {
            lp := src.scan(nm.next)
            src.is_lparen(lp.tok).match ({
                true  => {
                    buf := a.arg_buf()
                    ae := a.fill_args(src, lp.next, buf, 0)
                    PExpr(
                        expr: a.enode(raw_call_at(a.lexeme(src, nm.tok), buf.take_args(ae.count), nm.tok.start)),
                        next: ae.next,
                    )
                },
                false => {
                    perr_set_at(lp.tok.start)
                    PExpr(
                        expr: a.enode(lit(0)),
                        next: nm.next,
                    )
                },
            })
        },
        _      => {
            perr_set_at(nm.tok.start)
            PExpr(
                expr: a.enode(lit(0)),
                next: at.next,
            )
        },
    })
}
fill_args = (a: MutPtr<Malloc>, src: string_view, pos: i32, buf: [Expr], i: i32) PEnd {
    sc := src.scan(pos)
    src.is_rparen(sc.tok).match ({
        true  => PEnd(
            count: i,
            next: sc.next,
        ),
        false => a.fill_arg(src, pos, buf, i),
    })
}
fill_arg = (a: MutPtr<Malloc>, src: string_view, pos: i32, buf: [Expr], i: i32) PEnd {
    // Guard fixed-size arg buffer.
    (i >= buf.len).then({
        perr_set_at(pos)
        return PEnd(
            count: i,
            next: pos,
        )
    })
    arg := a.parse_or_nested(src, pos)
    buf[i] = load(arg.expr)
    after := src.scan(arg.next)
    src.is_comma(after.tok).match ({
        true  => a.fill_args(src, after.next, buf, i + 1),
        false => {
            // The arg list must close on ')'. Anything else (a missing ')', e.g. `id(1 }`) is a parse error —
            // flag it instead of silently treating the stray token as a terminator and swallowing what follows.
            (src.is_rparen(after.tok) == false).then({
                perr_set_at(after.tok.start)
            })
            PEnd(
                count: i + 1,
                next: after.next,
            )
        },
    })
}
parse_paren = (a: MutPtr<Malloc>, src: string_view, open: Scan) PExpr {
    inner := a.parse_or_nested(src, open.next)
    close := src.scan(inner.next)
    src.is_rparen(close.tok).match ({
        true  => PExpr(
            expr: inner.expr,
            next: close.next,
        ),
        false => {
            perr_set_at(close.tok.start)
            PExpr(
                expr: inner.expr,
                next: inner.next,
            )
        },
    })
}
// Prefix ops lower without adding Unary nodes.
is_minus = (src: string_view, t: Token) bool { src.is_op(t, '-') }
parse_neg = (a: MutPtr<Malloc>, src: string_view, sc: Scan) PExpr {
    inner := a.parse_atom(src, sc.next)
    PExpr(
        expr: a.enode(bin_at("-", a.enode(lit(0)), inner.expr, sc.tok.start)),
        next: inner.next,
    )
}
is_not = (src: string_view, t: Token) bool {
    t.kind.match ({
        .Sym => src.at(t.start) == '!' && t.len == 1,
        _    => false,
    })
}
parse_not = (a: MutPtr<Malloc>, src: string_view, sc: Scan) PExpr {
    inner := a.parse_atom(src, sc.next)
    PExpr(
        expr: a.enode(cond(inner.expr, a.enode(vref("false")), a.enode(vref("true")))),
        next: inner.next,
    )
}
// Slice literal element type is filled by compiler.check.
fill_sitems = (a: MutPtr<Malloc>, src: string_view, pos: i32, buf: [Expr], i: i32) PEnd {
    sc := src.scan(pos)
    src.is_rbracket(sc.tok).match ({
        true  => PEnd(
            count: i,
            next: sc.next,
        ),
        false => a.fill_sitem(src, pos, buf, i),
    })
}
fill_sitem = (a: MutPtr<Malloc>, src: string_view, pos: i32, buf: [Expr], i: i32) PEnd {
    // Guard fixed-size slice item buffer.
    (i >= buf.len).then({
        perr_set_at(pos)
        return PEnd(
            count: i,
            next: pos,
        )
    })
    it := a.parse_or_nested(src, pos)
    buf[i] = load(it.expr)
    after := src.scan(it.next)
    src.is_comma(after.tok).match ({
        true  => a.fill_sitems(src, after.next, buf, i + 1),
        false => {
            // A slice literal `[a, b, …]` must close on ']'; a missing ']' is a parse error, not a silent end.
            (src.is_rbracket(after.tok) == false).then({
                perr_set_at(after.tok.start)
            })
            PEnd(
                count: i + 1,
                next: after.next,
            )
        },
    })
}
parse_slicelit = (a: MutPtr<Malloc>, src: string_view, open: Scan) PExpr {
    buf := a.slit_buf()
    ae := a.fill_sitems(src, open.next, buf, 0)
    a.parse_postfix(src, PExpr(
        expr: a.enode(slit(tvoid(), buf.take_args(ae.count))),
        next: ae.next,
    ))
}
// Lambda opening is `(params){`, otherwise `(` starts a parenthesized expression. Params may carry an
// optional `: Type` each, and the `)` may be followed by an optional return type before the `{` — so the
// detector (and parser) skip those with parse_ty. The compiler's own untyped lambdas `(h,i,x){…}` never
// hit a `:`/return-type, so parse_ty is not invoked for them (the seed is unaffected).
// `)` followed by `{`, or by a return TYPE then `{`.
lam_ret_brace = (a: MutPtr<Malloc>, src: string_view, pos: i32) bool {
    src.is_lbrace(src.scan(pos).tok).match ({
        true  => true,
        false => src.is_lbrace(src.scan(a.parse_ty(src, pos).next).tok),
    })
}    // skip a return type, then '{'
lam_open = (a: MutPtr<Malloc>, src: string_view, open: Scan) bool { a.lam_params_ok(src, open.next) }
lam_params_ok = (a: MutPtr<Malloc>, src: string_view, pos: i32) bool {
    sc := src.scan(pos)
    src.is_rparen(sc.tok).match ({
        true  => a.lam_ret_brace(src, sc.next),
        false => sc.tok.kind.match ({
            .Ident => a.lam_after_name(src, sc.next),
            _      => false,
        }),
    })
}
lam_after_name = (a: MutPtr<Malloc>, src: string_view, pos: i32) bool {
    sc := src.scan(pos)
    src.is_op(sc.tok, ':').match ({
        true  => a.lam_after_sep(src, src.scan(a.parse_ty(src, sc.next).next)),
        false => a.lam_after_sep(src, sc),
    })
}    // skip `: Type`
// After a param (and its optional type): a ',' starts another param, a ')' ends the list.
lam_after_sep = (a: MutPtr<Malloc>, src: string_view, sep: Scan) bool {
    src.is_comma(sep.tok).match ({
        true  => a.lam_params_ok(src, sep.next),
        false => src.is_rparen(sep.tok).match ({
            true  => a.lam_ret_brace(src, sep.next),
            false => false,
        }),
    })
}
// Lambda params accept an optional `: Type` each; the type is KEPT on the Param so the formatter
// round-trips it (Void when unannotated). It stays inert otherwise — FnT context supplies the real
// types when the lambda is inline-spliced, so the body still binds the names as before.
fill_lnames = (a: MutPtr<Malloc>, src: string_view, pos: i32, buf: [Param], i: i32) PEnd {
    sc := src.scan(pos)
    src.is_rparen(sc.tok).match ({
        true  => PEnd(
            count: i,
            next: sc.next,
        ),
        false => a.fill_lname(src, pos, buf, i),
    })
}
fill_lname = (a: MutPtr<Malloc>, src: string_view, pos: i32, buf: [Param], i: i32) PEnd {
    // Guard fixed-size lambda-param buffer.
    (i >= buf.len).then({
        perr_set_at(pos)
        return PEnd(
            count: i,
            next: pos,
        )
    })
    nt := src.scan(pos)
    sep0 := src.scan(nt.next)
    te := src.is_op(sep0.tok, ':').match ({
        true  => a.parse_ty(src, sep0.next),
        false => TyEnd(
            ty: tvoid(),
            next: nt.next,
        ),
    })    // optional `: Type` — kept for round-trip (Void when absent)
    buf[i] = param(a.lexeme(src, nt.tok), te.ty)
    sep := src.scan(te.next)
    src.is_comma(sep.tok).match ({
        true  => a.fill_lnames(src, sep.next, buf, i + 1),
        false => PEnd(
            count: i + 1,
            next: sep.next,
        ),
    })
}
parse_lambda = (a: MutPtr<Malloc>, src: string_view, open: Scan) PExpr {
    buf := a.param_buf()
    pe := a.fill_lnames(src, open.next, buf, 0)
    // optional return type before the body '{' — KEEP it (lam_r) so a generic call can infer a tparam
    // bound only by a closure-param's return position `(T) U`.
    rt := src.is_lbrace(src.scan(pe.next).tok).match ({
        true  => TyEnd(
            ty: tvoid(),
            next: pe.next,
        ),
        false => a.parse_ty(src, pe.next),
    })
    ob := src.scan(rt.next)
    body := a.build_body(src, ob.next)
    endp := src.skip_block(ob.next)
    a.parse_postfix(src, PExpr(
        expr: a.enode(lam_r(buf.take_params(pe.count), body, rt.ty)),
        next: endp,
    ))
}
// Precedence ladder, left-associative unless noted.
parse_term = (a: MutPtr<Malloc>, src: string_view, pos: i32) PExpr { a.term_rest(src, a.parse_atom(src, pos)) }
term_rest = (a: MutPtr<Malloc>, src: string_view, lhs: PExpr) PExpr {
    sc := src.scan(lhs.next)
    src.is_muldiv(sc.tok).match ({ true => a.term_more(src, lhs, sc), false => lhs })
}
term_more = (a: MutPtr<Malloc>, src: string_view, lhs: PExpr, sc: Scan) PExpr {
    rhs := a.parse_atom(src, sc.next)
    a.term_rest(src, PExpr(
        expr: a.enode(bin_at(src.at(sc.tok.start).op_str(), lhs.expr, rhs.expr, sc.tok.start)),
        next: rhs.next,
    ))
}
parse_expr = (a: MutPtr<Malloc>, src: string_view, pos: i32) PExpr { a.expr_rest(src, a.parse_term(src, pos)) }
expr_rest = (a: MutPtr<Malloc>, src: string_view, lhs: PExpr) PExpr {
    sc := src.scan(lhs.next)
    src.is_addsub(sc.tok).match ({ true => a.expr_more(src, lhs, sc), false => lhs })
}
expr_more = (a: MutPtr<Malloc>, src: string_view, lhs: PExpr, sc: Scan) PExpr {
    rhs := a.parse_term(src, sc.next)
    a.expr_rest(src, PExpr(
        expr: a.enode(bin_at(src.at(sc.tok.start).op_str(), lhs.expr, rhs.expr, sc.tok.start)),
        next: rhs.next,
    ))
}
// Bitwise precedence is shift > & > ^ > |, tighter than comparison.
is_shift = (src: string_view, t: Token) bool {
    t.kind.match ({
        .Sym => t.len == 2 && src.at(t.start) == src.at(t.start + 1) && (src.at(t.start) == '<' || src.at(t.start) == '>'),
        _    => false,
    })
}
shift_op_str = (src: string_view, t: Token) string_view { (src.at(t.start) == '<').match ({
    true  => "<<",
    false => ">>",
}) }
parse_shift = (a: MutPtr<Malloc>, src: string_view, pos: i32) PExpr { a.shift_rest(src, a.parse_expr(src, pos)) }
shift_rest = (a: MutPtr<Malloc>, src: string_view, lhs: PExpr) PExpr {
    sc := src.scan(lhs.next)
    src.is_shift(sc.tok).match ({ true => a.shift_more(src, lhs, sc), false => lhs })
}
shift_more = (a: MutPtr<Malloc>, src: string_view, lhs: PExpr, sc: Scan) PExpr {
    rhs := a.parse_expr(src, sc.next)
    a.shift_rest(src, PExpr(
        expr: a.enode(bin_at(src.shift_op_str(sc.tok), lhs.expr, rhs.expr, sc.tok.start)),
        next: rhs.next,
    ))
}
is_band = (src: string_view, t: Token) bool {
    t.kind.match ({
        .Sym => t.len == 1 && src.at(t.start) == '&',
        _    => false,
    })
}
is_bxor = (src: string_view, t: Token) bool {
    t.kind.match ({
        .Sym => t.len == 1 && src.at(t.start) == '^',
        _    => false,
    })
}
is_bbor = (src: string_view, t: Token) bool {
    t.kind.match ({
        .Sym => t.len == 1 && src.at(t.start) == '|',
        _    => false,
    })
}
parse_band = (a: MutPtr<Malloc>, src: string_view, pos: i32) PExpr { a.band_rest(src, a.parse_shift(src, pos)) }
band_rest = (a: MutPtr<Malloc>, src: string_view, lhs: PExpr) PExpr {
    sc := src.scan(lhs.next)
    src.is_band(sc.tok).match ({ true => a.band_more(src, lhs, sc), false => lhs })
}
band_more = (a: MutPtr<Malloc>, src: string_view, lhs: PExpr, sc: Scan) PExpr {
    rhs := a.parse_shift(src, sc.next)
    a.band_rest(src, PExpr(
        expr: a.enode(bin_at("&", lhs.expr, rhs.expr, sc.tok.start)),
        next: rhs.next,
    ))
}
// Exported for enum-variant default exprs (`Name = expr`): parses everything tighter than a single
// `|`, so the variant separator is never swallowed as bitwise-or.
parse_bxor* = (a: MutPtr<Malloc>, src: string_view, pos: i32) PExpr { a.bxor_rest(src, a.parse_band(src, pos)) }
bxor_rest = (a: MutPtr<Malloc>, src: string_view, lhs: PExpr) PExpr {
    sc := src.scan(lhs.next)
    src.is_bxor(sc.tok).match ({ true => a.bxor_more(src, lhs, sc), false => lhs })
}
bxor_more = (a: MutPtr<Malloc>, src: string_view, lhs: PExpr, sc: Scan) PExpr {
    rhs := a.parse_band(src, sc.next)
    a.bxor_rest(src, PExpr(
        expr: a.enode(bin_at("^", lhs.expr, rhs.expr, sc.tok.start)),
        next: rhs.next,
    ))
}
parse_bor = (a: MutPtr<Malloc>, src: string_view, pos: i32) PExpr { a.bor_rest(src, a.parse_bxor(src, pos)) }
bor_rest = (a: MutPtr<Malloc>, src: string_view, lhs: PExpr) PExpr {
    sc := src.scan(lhs.next)
    src.is_bbor(sc.tok).match ({ true => a.bor_more(src, lhs, sc), false => lhs })
}
bor_more = (a: MutPtr<Malloc>, src: string_view, lhs: PExpr, sc: Scan) PExpr {
    rhs := a.parse_bxor(src, sc.next)
    a.bor_rest(src, PExpr(
        expr: a.enode(bin_at("|", lhs.expr, rhs.expr, sc.tok.start)),
        next: rhs.next,
    ))
}
// Comparison excludes shifts and `=>`; `=` alone is assignment.
is_cmp_byte = (b: u8, len: i32) bool { b == '=' && len == 2 || b == '!' && len == 2 || b == '<' || b == '>' }
is_cmp = (src: string_view, t: Token) bool {
    t.kind.match ({
        .Sym => src.at(t.start).is_cmp_byte(t.len) && src.is_shift(t).match ({
            true  => false,
            false => true,
        }) && src.is_fat_arrow(t).match ({ true => false, false => true }),
        _    => false,
    })
}
cmp_op_str = (src: string_view, t: Token) string_view {
    b0 := src.at(t.start)
    (b0 == '=').match ({
        true  => "==",
        false => (b0 == '!').match ({
            true  => "!=",
            false => (b0 == '<').match ({
                true  => (t.len == 2).match ({ true => "<=", false => "<" }),
                false => (t.len == 2).match ({ true => ">=", false => ">" }),
            }),
        }),
    })
}
parse_cmp = (a: MutPtr<Malloc>, src: string_view, pos: i32) PExpr { a.cmp_rest(src, a.parse_bor(src, pos)) }
cmp_rest = (a: MutPtr<Malloc>, src: string_view, lhs: PExpr) PExpr {
    sc := src.scan(lhs.next)
    src.is_cmp(sc.tok).match ({ true => a.cmp_more(src, lhs, sc), false => lhs })
}
cmp_more = (a: MutPtr<Malloc>, src: string_view, lhs: PExpr, sc: Scan) PExpr {
    rhs := a.parse_bor(src, sc.next)
    a.cmp_rest(src, PExpr(
        expr: a.enode(bin_at(src.cmp_op_str(sc.tok), lhs.expr, rhs.expr, sc.tok.start)),
        next: rhs.next,
    ))
}
// Logic: && binds tighter than ||, both looser than comparison.
is_and = (src: string_view, t: Token) bool {
    t.kind.match ({
        .Sym => t.len == 2 && src.at(t.start) == '&',
        _    => false,
    })
}
is_or = (src: string_view, t: Token) bool {
    t.kind.match ({
        .Sym => t.len == 2 && src.at(t.start) == '|',
        _    => false,
    })
}
parse_and = (a: MutPtr<Malloc>, src: string_view, pos: i32) PExpr { a.and_rest(src, a.parse_cmp(src, pos)) }
and_rest = (a: MutPtr<Malloc>, src: string_view, lhs: PExpr) PExpr {
    sc := src.scan(lhs.next)
    src.is_and(sc.tok).match ({ true => a.and_more(src, lhs, sc), false => lhs })
}
and_more = (a: MutPtr<Malloc>, src: string_view, lhs: PExpr, sc: Scan) PExpr {
    rhs := a.parse_cmp(src, sc.next)
    a.and_rest(src, PExpr(
        expr: a.enode(bin_at("&&", lhs.expr, rhs.expr, sc.tok.start)),
        next: rhs.next,
    ))
}
parse_or* = (a: MutPtr<Malloc>, src: string_view, pos: i32) PExpr { a.or_rest(src, a.parse_and(src, pos)) }
or_rest = (a: MutPtr<Malloc>, src: string_view, lhs: PExpr) PExpr {
    sc := src.scan(lhs.next)
    src.is_or(sc.tok).match ({ true => a.or_more(src, lhs, sc), false => lhs })
}
or_more = (a: MutPtr<Malloc>, src: string_view, lhs: PExpr, sc: Scan) PExpr {
    rhs := a.parse_and(src, sc.next)
    a.or_rest(src, PExpr(
        expr: a.enode(bin_at("||", lhs.expr, rhs.expr, sc.tok.start)),
        next: rhs.next,
    ))
}
