// src/sema/sema_apply.zen
// What a call APPLIES its callee to: the type arguments, and what a
// construction is applied to.
//
// `sema_call.zen` answers which declaration a call means. That is one
// question and this is a second one asked of the same node, because a
// call to `<T>(x: T) T` picks a declaration AND a `T`, and only the
// first of the two is resolution. Splitting them is what keeps
// "resolution is on declared parameter types and arity" a rule about
// arity and types, with nothing about inference folded into it.
//
// TWO SOURCES, AND THE WRITTEN ONE WINS. `alloc.Vec<Unit>()` names its
// argument outright; `alloc.realloc(p, n)` says it only through
// `p: Ptr<T>` against a `Ptr<u8>`. `Inst.bind` keeps the first binding,
// so ordering the two sources IS the precedence rule and there is no
// second mechanism.
//
// A PARAMETER NEITHER SOURCE REACHES STAYS FREE, and nothing here
// reports it. A candidate is TRIED before it is chosen — `keep_matching`
// runs this over overloads the program never used — so a diagnostic
// raised from inside would name a declaration nobody called. The refusal
// belongs at the consumer, which is what `has_var` is for and why the
// backend asks it before it writes a symbol.
//
// A CONSTRUCTION IS APPLIED TOO, and for the same reason: a nominal type
// at some arguments, never a bare head. `construct` gives the two forms.

ExprId, Call, Arg = std.ast
Decl, Struct, TypeId, Impl = std.ast
AllocError = std.mem
Vec = std.collections
str = std.text
Range = std.core
ImplId = sema.sema_id
TyId, TyNamed, literal_default = sema.sema_ty
Def, decl_at = sema.sema_def
Checker, Ctx = sema.sema_check
Inst, InstEdge, subst, unify, tparam_vars, zip = sema.sema_inst
has_var, inst_of_named = sema.sema_inst
Cand, TBound, Actual = sema.sema_call
ty_at = sema.sema_cand
impl_bound_type = sema.sema_supply
type_from_ast, type_of = sema.sema_type
check_ctor_fields = sema.sema_hoist
check_ctor_shape = sema.sema_bound
Found, members_of = sema.sema_member

// A GENERIC STRUCT IS CONSTRUCTED AT WHAT THE CALL WROTE, and at its own
// parameters when the call wrote nothing.
//
// `Box<i32>(held: 7)` says which `Box` outright. `Vec(alloc: a)` inside
// `Vec<T>`'s own constructor says nothing and means the declaration's
// own `T` — which the enclosing instantiation then substitutes. Both
// answer an APPLIED type: a bare `Vec` has no arguments to substitute
// and no fields a backend could lay out, so it is never the answer.
construct* = (c :: Checker, id: ExprId, call: Call, d: Def, ctx: Ctx)
            Res<TyId, AllocError> {
    c.resolve_call(id, d.id).try();
    args ::= c.alloc.Vec<TyId>();
    c.ctor_args(call, d, ctx, args).try();
    applied = c.types.named(d.id, d.qname, d.name, args).try();
    ty      = c.settled_ctor_type(call, d, ctx, args, applied).try();
    c.check_ctor_fields(call, ty, ctx).try();
    c.check_ctor_shape(call, ty, c.tree.expr_at(id).span).try();
    Ok(ty);
}

// ---------------------------------------------------------------------
// WHAT THE ARGUMENTS SAY A CONSTRUCTION'S TYPE ARGUMENTS ARE
//
// `Pair(first: 5, second: p)` writes no type arguments, and the only
// thing that says which `Pair` it is are the arguments: `first: A` meets
// a `5`. That is the SAME inference a generic function's arguments
// already get above — asked of a field instead of a parameter — and
// leaving it out is what made a local `Pair<A, B>` at its own free
// variables, so `p.first` reached no member and the backend had no
// layout to write.
//
// A PARAMETER NO ARGUMENT REACHES STAYS FREE, exactly as at a call:
// `Range(0, 5)` names no `T` and nothing here is entitled to guess one.
// ---------------------------------------------------------------------

settled_ctor_type = (
    c       :: Checker,
    call    : Call,
    d       : Def,
    ctx     : Ctx,
    vars    : Vec<TyId>,
    applied : TyId
)
                    Res<TyId, AllocError> {
    ((vars.len == 0) || (call.targs.len > 0)).match({
        true  => Ok(applied),
        false => c.ctor_type_from_args(call, d, ctx, vars, applied),
    })
}

ctor_type_from_args = (
    c       :: Checker,
    call    : Call,
    d       : Def,
    ctx     : Ctx,
    vars    : Vec<TyId>,
    applied : TyId
)
                      Res<TyId, AllocError> {
    inst ::= c.alloc.Inst();
    call.args.loop((h, a) { c.unify_ctor_arg(a, applied, ctx, inst).try() });
    (inst.len() == 0).match({
        true  => Ok(applied),
        false => c.rebuilt_ctor_type(d, vars, inst),
    })
}

rebuilt_ctor_type = (c :: Checker, d: Def, vars: Vec<TyId>, inst: Inst)
                    Res<TyId, AllocError> {
    args ::= c.alloc.Vec<TyId>();
    vars.loop((h, v) { args.add(arg_for(v, inst)).try() });
    c.types.named(d.id, d.qname, d.name, args)
}

// NAMED ARGUMENTS ONLY, the restriction `check_ctor_fields` already
// states: a field is reached by its name, and a positional argument to
// a constructor is a different resolution and not this rule's to read.
unify_ctor_arg = (
    c       :: Checker,
    a       : Arg,
    applied : TyId,
    ctx     : Ctx,
    inst    :: Inst
) Res<(), AllocError> {
    a.name.match({
        None   => Ok(()),
        Ok(nm) => c.unify_ctor_field(a, nm.text, applied, ctx, inst),
    })
}

// The field is read off the type at its OWN parameters, so a declared
// `first: A` comes back as the very `Var` `vars` holds and the binding
// lands where `rebuilt_ctor_type` looks for it.
unify_ctor_field = (
    c       :: Checker,
    a       : Arg,
    name    : str,
    applied : TyId,
    ctx     : Ctx,
    inst    :: Inst
) Res<(), AllocError> {
    found ::= c.alloc.Vec<Found>();
    c.members_of(applied, name, found).try();
    found.get(0).match({
        None  => Ok(()),
        Ok(f) => unify(c, f.ty, c.settled_arg_ty(a, ctx).try(), inst),
    })
}

// A TYPE ARGUMENT IS NOT AN ANNOTATION. An unsettled integer literal is
// `int` and settles to the type WRITTEN for it; a type argument writes
// nothing, so `Pair(first: 5, ..)` settles its `5` the way every other
// unannotated `5` settles rather than making `int` the argument a
// mangled symbol then carries — which would mint a `Pair<int, int>`
// beside the `Pair<i32, i32>` every annotated program builds.
settled_arg_ty = (c :: Checker, a: Arg, ctx: Ctx) Res<TyId, AllocError> {
    got = c.type_of(a.value, ctx).try();
    c.is_literal_ty(got).match({
        false => Ok(got),
        true  => c.types.prim(literal_default(c.prim_name(got))),
    })
}

ctor_args = (c :: Checker, call: Call, d: Def, ctx: Ctx, out :: Vec<TyId>)
            Res<(), AllocError> {
    (call.targs.len == 0).match({
        true  => c.decl_tparams(d, out),
        false => c.written_ctor_args(call.targs, ctx, out),
    })
}

// Written arguments mean what they mean at the call site, as
// `bind_written` says of a generic function's.
written_ctor_args = (
    c     :: Checker,
    targs : Vec<TypeId>,
    ctx   : Ctx,
    out   :: Vec<TyId>
) Res<(), AllocError> {
    targs.loop((h, t) { out.add(c.type_from_ast(t, ctx).try()).try() });
    Ok(());
}

decl_tparams = (c :: Checker, d: Def, out :: Vec<TyId>)
               Res<(), AllocError> {
    decl_at(c.tree, d.id).match({
        None    => Ok(()),
        Ok(dec) => c.struct_tparams(d, dec, out),
    })
}

struct_tparams = (c :: Checker, d: Def, dec: Decl, out :: Vec<TyId>)
                 Res<(), AllocError> {
    dec.kind.match({
        Struct(s) => c.tparam_vars(s.tparams, d.qname, out),
        _         => Ok(()),
    })
}

// A GENERIC CANDIDATE IS INSTANTIATED: `<T>(x: T) T` called with an
// `i32` answers `i32` and not `T`. The instantiation is recorded under
// the call's own id beside the declaration, because downstream needs both —
// a backend that knew which function but not which `T` would be picking
// one of the two answers out of the air.
instantiate* = (
    c       :: Checker,
    id      : ExprId,
    call    : Call,
    k       : Cand,
    actuals : Vec<Actual>,
    ctx     : Ctx
) Res<TyId, AllocError> {
    k.generic.match({
        false => Ok(k.ret),
        true  => c.instantiated_ret(id, call, k, actuals, ctx),
    })
}

instantiated_ret = (
    c       :: Checker,
    id      : ExprId,
    call    : Call,
    k       : Cand,
    actuals : Vec<Actual>,
    ctx     : Ctx
)
                   Res<TyId, AllocError> {
    inst = c.call_inst(call, k, actuals, ctx).try();
    c.resolve_inst(id, inst).try();
    note_edge(c, id, k, inst).try();
    c.subst(k.ret, inst)
}

// THE EDGE THE TERMINATION CHECK FOLLOWS. `sema_depth.zen` asks whether
// the instantiation set is finite, and it cannot ask it of one call: the
// answer lives in the CHAIN a call belongs to, and `grow<Vec<T>>` is
// only divergent because it sits inside `grow`. So the edge is recorded
// here — where the callee, its type parameters and what this call gave
// them are all in hand — and the walk runs once the whole program has
// been checked.
//
// A free parameter stays its own `Var`, and the walk stops on a chain
// that still mentions one rather than guessing.
note_edge = (c :: Checker, id: ExprId, k: Cand, inst: Inst)
            Res<(), AllocError> {
    args ::= c.alloc.Vec<TyId>();
    k.tvars.loop((h, v) { args.add(arg_for(v, inst)).try() });
    c.note_edge(InstEdge(
        from_owner: c.owner_of_body(),
        to_owner: k.owner,
        to_name: k.name,
        to_tvars: k.tvars,
        args: args,
        span: c.tree.expr_at(id).span,
    ))
}

arg_for = (v: TyId, inst: Inst) TyId {
    inst.lookup(v).match({ Ok(t) => t, None => v })
}

// WHAT THE CALL SAID `T` IS. The header's two sources in precedence
// order — written first, because `bind` keeps the first binding — and
// then what a bound says. A parameter neither reaches stays free.
call_inst = (
    c       :: Checker,
    call    : Call,
    k       : Cand,
    actuals : Vec<Actual>,
    ctx     : Ctx
) Res<Inst, AllocError> {
    inst ::= c.alloc.Inst();
    c.written_targs(call, k, inst, ctx).try();
    infer_targs(c, k, actuals, inst).try();
    c.infer_from_bounds(k, inst).try();
    Ok(inst);
}

written_targs = (c :: Checker, call: Call, k: Cand, inst :: Inst, ctx: Ctx)
                Res<(), AllocError> {
    (call.targs.len == 0).match({
        true  => Ok(()),
        false => c.bind_written(call.targs, k, inst, ctx),
    })
}

// The written arguments mean what they mean AT THE CALL SITE, so they
// resolve in the caller's module and not the callee's.
bind_written = (
    c     :: Checker,
    targs : Vec<TypeId>,
    k     : Cand,
    inst  :: Inst,
    ctx   : Ctx
) Res<(), AllocError> {
    tys ::= c.alloc.Vec<TyId>();
    targs.loop((h, t) { tys.add(c.type_from_ast(t, ctx).try()).try() });
    zip(c, k.tvars, tys, inst).try();
    Ok(());
}

infer_targs = (c :: Checker, k: Cand, actuals: Vec<Actual>, inst :: Inst)
              Res<(), AllocError> {
    Range(0, k.params.len).loop((h, i) {
        infer_at(c, k, actuals, i, inst).try();
    });
    Ok(());
}

infer_at = (
    c       :: Checker,
    k       : Cand,
    actuals : Vec<Actual>,
    i       : usize,
    inst    :: Inst
) Res<(), AllocError> {
    actuals.get(i).match({
        None  => Ok(()),
        Ok(a) => infer_from(c, ty_at(k.params, i), a, inst),
    })
}

// A LAMBDA SAYS NOTHING ABOUT `T`. "A closure passed to a function whose
// signature is already known infers its parameter types FROM that
// signature", so the arrow points the other way and a lambda's poison
// type is not an inference.
infer_from = (c :: Checker, param: TyId, a: Actual, inst :: Inst)
             Res<(), AllocError> {
    a.is_lambda.match({
        true  => Ok(()),
        false => unify(c, param, a.ty, inst),
    })
}

// ---------------------------------------------------------------------
// A PARAMETER NAMED ONLY INSIDE ANOTHER'S BOUND
//
// `<R: Range<T>, T> = (range: R, body: (h: LoopHandle, value: T) ())` is
// the form the whole loop family is written in, and `range.zen` says
// why: a bound MONOMORPHISES, so `at` is a direct call and the body
// inlines. The cost is that `T` appears in no parameter of its own —
// the only thing naming it is the closure, and "a closure infers its
// parameter types FROM the signature" points that arrow the other way.
// So the loop above leaves `T` free and everything downstream sees an
// element nothing settled: `filter`'s own `alloc.Vec<T>()` has no
// symbol to write, and a value typed `T` is a foreign parameter that
// reaches no members at all.
//
// ONCE `R` IS KNOWN THE BOUND ANSWERS, and both shapes it comes in are
// one unification against the bound as written.
// ---------------------------------------------------------------------

infer_from_bounds = (c :: Checker, k: Cand, inst :: Inst)
                    Res<(), AllocError> {
    k.tbounds.loop((h, tb) { infer_one_bound(c, k, tb, inst).try() });
    Ok(());
}

infer_one_bound = (c :: Checker, k: Cand, tb: TBound, inst :: Inst)
                  Res<(), AllocError> {
    v = c.types.var(tb.name, k.owner).try();
    inst.lookup(v).match({
        None  => Ok(()),
        Ok(g) => infer_through_bound(c, tb.bound, g, inst),
    })
}

infer_through_bound = (c :: Checker, bound: TyId, g: TyId, inst :: Inst)
                      Res<(), AllocError> {
    same_head(c, bound, g).match({
        true  => infer_own_bound(c, bound, g, inst),
        false => infer_impl_bound(c, bound, g, inst),
    })
}

same_head = (c: Checker, a: TyId, b: TyId) bool {
    c.types.at(a).match({
        Named(x) => head_is(c, x, b),
        _        => false,
    })
}

head_is = (c: Checker, x: TyNamed, b: TyId) bool {
    c.types.at(b).match({ Named(y) => x.decl.eq(y.decl), _ => false })
}

// THE ARGUMENT IS THE BOUND ITSELF: `Range(0, 6)` reaching `R:
// Range<T>`. A value of the bound's own type carries only what its
// declaration gives it, and `range.zen` gives it nothing — "a Range
// that supplies no `at` walks its own index space, which is what makes
// `Range(0, 5)` mean 0, 1, 2, 3, 4 with nothing behind it". So an
// argument nothing settled IS the index, and the index is a `usize`.
//
// That is not a guess, it is the answer the backend already writes:
// `gen_c_loop.lower_settled` walks a range that stores its own bounds
// with `elem` fixed at `usize`. The two have to agree, or a fold's
// accumulator is declared at a type the walk does not produce.
infer_own_bound = (c :: Checker, bound: TyId, g: TyId, inst :: Inst)
                  Res<(), AllocError> {
    usize_ty = c.types.prim("usize").try();
    bs ::= c.alloc.Vec<TyId>();
    gs ::= c.alloc.Vec<TyId>();
    named_args(c, bound, bs).try();
    named_args(c, g, gs).try();
    (bs.len == gs.len).match({
        false => Ok(()),
        true  => unify_index_space(c, bs, gs, usize_ty, inst),
    })
}

unify_index_space = (
    c        :: Checker,
    bs       : Vec<TyId>,
    gs       : Vec<TyId>,
    usize_ty : TyId,
    inst     :: Inst
) Res<(), AllocError> {
    bs.loop((h, i, b) {
        unify(c, b, settled_or_index(c, ty_at(gs, i), usize_ty), inst).try();
    });
    Ok(());
}

settled_or_index = (c: Checker, t: TyId, usize_ty: TyId) TyId {
    has_var(c, t).match({ true => usize_ty, false => t })
}

named_args = (c :: Checker, ty: TyId, out :: Vec<TyId>)
             Res<(), AllocError> {
    c.types.at(ty).match({
        Named(n) => n.args.loop((h, a) { out.add(a).try() }),
        _        => (),
    });
    Ok(());
}

// THE ARGUMENT IMPLS THE BOUND: `Vec<i32>` reaching `R: Range<T>`.
// "An impl lives with the type, not with the trait", so the impls of
// the argument's own declaration are the ones to read, and
// `Vec.impl(Range<T>, ..)` is where it says which of `Vec`'s OWN
// arguments the bound's argument is. The impl writes `Vec`'s `T`;
// putting it through the receiver's own instantiation is what turns it
// into `i32`.
infer_impl_bound = (c :: Checker, bound: TyId, g: TyId, inst :: Inst)
                   Res<(), AllocError> {
    c.types.at(g).match({
        Named(n) => infer_named_impl(c, bound, n, inst),
        _        => Ok(()),
    })
}

infer_named_impl = (c :: Checker, bound: TyId, n: TyNamed, inst :: Inst)
                   Res<(), AllocError> {
    impl_bound_at(c, bound, n).try().match({
        None   => Ok(()),
        Ok(gb) => unify(c, bound, gb, inst),
    })
}

impl_bound_at = (c :: Checker, bound: TyId, n: TyNamed)
                Res<Res<TyId>, AllocError> {
    ids ::= c.alloc.Vec<ImplId>();
    c.world.impls_named(c.tree, n.name, ids).try();
    impl_bound_from(c, ids, 0, bound, n)
}

// The first impl of that bound. Written as a walk rather than a loop
// because the answer is the FIRST hit and a `find` cannot ask a
// question that allocates.
impl_bound_from = (
    c     :: Checker,
    ids   : Vec<ImplId>,
    i     : usize,
    bound : TyId,
    n     : TyNamed
) Res<Res<TyId>, AllocError> {
    ids.get(i).match({
        None   => Ok(None),
        Ok(id) => impl_bound_or_next(c, ids, i, id, bound, n),
    })
}

impl_bound_or_next = (
    c     :: Checker,
    ids   : Vec<ImplId>,
    i     : usize,
    id    : ImplId,
    bound : TyId,
    n     : TyNamed
) Res<Res<TyId>, AllocError> {
    impl_applied(c, id, bound, n).try().match({
        Ok(t) => Ok(Ok(t)),
        None  => impl_bound_from(c, ids, i + 1, bound, n),
    })
}

impl_applied = (c :: Checker, id: ImplId, bound: TyId, n: TyNamed)
               Res<Res<TyId>, AllocError> {
    (n.decl.module == id.decl.module).match({
        false => Ok(None),
        true  => impl_applied_local(c, id, bound, n),
    })
}

impl_applied_local = (c :: Checker, id: ImplId, bound: TyId, n: TyNamed)
                     Res<Res<TyId>, AllocError> {
    c.world.impl_at(c.tree, id).match({
        None   => Ok(None),
        Ok(im) => impl_applied_of(c, im, bound, n),
    })
}

impl_applied_of = (c :: Checker, im: Impl, bound: TyId, n: TyNamed)
                  Res<Res<TyId>, AllocError> {
    mi  = n.decl.module.to_usize();
    got = impl_bound_type(c, im, mi).try();
    same_head(c, got, bound).match({
        false => Ok(None),
        true  => applied_at_recv(c, got, n),
    })
}

applied_at_recv = (c :: Checker, got: TyId, n: TyNamed)
                  Res<Res<TyId>, AllocError> {
    recv = inst_of_named(c, n).try();
    Ok(Ok(subst(c, got, recv).try()));
}
