// src/lex/lex_byte.zen
// Which kind of token, if any, a byte can begin.
//
// WHAT A BYTE IS belongs to std.core.byte and is not repeated here —
// `is_digit`, `is_space`, `is_ident_start`, `is_ident_cont`. What's left
// is what genuinely names Zen: which byte begins which token, and which
// escapes Zen has.
//
// Classification and byte WALKING are separate files — this is a table,
// lex_cursor.zen is a machine — so a change to what begins a token never
// touches the code that counts lines.
//
// There is no `Punct` class, deliberately: that table lives in
// lex_punct.zen, and a second copy here could disagree with it. `Other`
// means only "not one of the shapes below"; the punct table decides the
// rest.

// what a byte can start
ByteClass* =
      Space      // skipped; never a token
    | Slash      // `//`, `/*`, or division: one byte of lookahead tells them apart
    | Quote      // "
    | Apos       // '
    | Digit
    | Letter     // an identifier's first byte, `_` included
    | At         // @Self, @meta, @scope, and nothing else
    | Other      // punctuation, or a byte that begins no Zen token at all

// the three bytes of a UTF-8 byte-order mark, written as numbers because
// Zen's escape set has no `\xEF` and inventing one would be a language
// change.
//
// These name UTF-8 rather than the lexer — they belong beside
// UTF8_LEAD_2_MIN in std.text.text_utf8, and are here only because that
// module doesn't declare them yet.
BOM_FIRST*: u8 = 239
BOM_SECOND*: u8 = 187
BOM_THIRD*: u8 = 191

// THE escape set, and nothing else. An unknown escape is an error, never a
// silent literal character: `"\q"` does not mean `q`. This one IS a Zen
// fact rather than a byte fact, which is why it stays
is_escape* = (b: u8) bool {
    (b == 'n') || (b == 't') || (b == 'r') || (b == '0')
        || (b == '\\') || (b == '\'') || (b == '"')
}

class_of* = (b: u8) ByteClass {
    b.is_space().match({
        true  => ByteClass.Space,
        false => b.is_digit().match({
            true  => ByteClass.Digit,
            false => b.is_ident_start().match({
                true  => ByteClass.Letter,
                false => opener_class(b),
            }),
        }),
    });
}

// the four bytes that open something rather than being something, and the
// fallthrough. Split out so `class_of` stays a readable ladder of ranges
opener_class = (b: u8) ByteClass {
    (b == '/').match({
        true  => ByteClass.Slash,
        false => (b == '"').match({
            true  => ByteClass.Quote,
            false => (b == '\'').match({
                true  => ByteClass.Apos,
                false => (b == '@').match({
                    true  => ByteClass.At,
                    false => ByteClass.Other,
                }),
            }),
        }),
    });
}
