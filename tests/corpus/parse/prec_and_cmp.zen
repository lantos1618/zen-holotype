// `==` binds tighter than `&&`: a == 1 && b == 2 is (a == 1) && (b == 2).
// DESIGN.md writes exactly this shape in Map.get and in build.zen.

main = (env: Env) Res<i32, ArgError> {
    a = 1;
    b = 2;
    (a == 1 && b == 2).match({
        true  => println("yes"),
        false => println("no"),
    });
    Ok(0);
}
