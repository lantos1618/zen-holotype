// The build IS a Zen program: `zenc build .` runs this and links the Target it returns.
{ Build } = std.build
build = (b: MutPtr<Build>) void {
    target := b.exe("build-zen-demo").root("src").main("main.zen").out("fixture-bin")
    b.install(b.target().os.match ({
        .Linux => target,
        _      => target,
    }))
    platforms := [b.target()]
    platforms.loop((h, i, platform) {
        b.install(b.exe("build-zen-alt").root("src").main("main.zen").out("fixture-bin-alt").target(platform))
    })
}
