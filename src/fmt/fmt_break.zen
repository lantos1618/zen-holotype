// Canonical line breaking for calls, declarations, unions, enums, and arrays.
// Packing runs inside-out; breaking runs outside-in. Each round reparses so
// spans and indentation describe the current text. The pass changes only
// whitespace and refuses lists whose comments, layout, or separators cannot
// be preserved exactly.

Alloc, AllocError = std.mem
str, String = std.text
Vec = std.collections
Range = std.core
Span = std.ast.ast_span
Ast = std.ast.ast_arena
ExprId, TypeId, BlockId = std.ast.ast_id
Module, Decl, Type, Expr, Call, ArrayLit, Union, Enum, Param = std.ast.ast_node
scan, Source, Lexed = std.lex.lex
Parser, module = std.parse.parse
Src = fmt.fmt_src

// The formatter's single line-width policy.
WIDTH*: usize = 80

// One separator-bounded piece of a list, in bytes: an argument, a
// variant, a union member. Half-open, like the spans it comes from.
Item = {
    lo: usize,
    hi: usize,
}

// A separator-bounded list that may be packed or broken. Parameter lists do
// not veto a disjoint neighbour on the same line, allowing a wide return
// union to break independently. `fill` lets arrays pack several items per
// broken line; other list kinds stack one item per line.
Cand = {
    lo: usize,
    hi: usize,
    line: usize,
    end_line: usize,
    sep: u8,
    parens: bool,
    vetoes: bool,
    params: bool,
    fill: bool,
    items: Vec<Item>,
}

// One whitespace replacement: `[from, to)` becomes `text`.
Edit = {
    from: usize,
    to: usize,
    text: String,
}

// Pack eligible lists, then break those that remain too wide.
break_lines* = (a: Alloc, file: str, text: str) Res<String, AllocError> {
    packed = rounds(a, file, text, true).try();
    rounds(a, file, packed.view(), false)
}

// Run one direction until a round makes no change.
rounds = (a: Alloc, file: str, text: str, join: bool)
         Res<String, AllocError> {
    cur   ::= copy_of(a, text).try();
    turns ::= 0;
    loop(turns < 16, (h) {
        next  = one_round(a, file, cur.view(), join).try();
        turns = turns + 1;
        next.view().eq(cur.view()).match({
            true  => h.break(),
            false => { cur = next; },
        });
    });
    Ok(cur);
}

// Re-lexing each round prevents edits from using stale offsets. The cap is a
// convergence guard; each productive round reaches a previously blocked list.
one_round = (a: Alloc, file: str, text: str, join: bool)
            Res<String, AllocError> {
    lexed = scan(a, Source(file: file, text: text)).try();
    lexed.is_clean().match({
        false => copy_of(a, text),
        true  => round_clean(a, text, lexed, join),
    })
}

// Whitespace edits should preserve parsing. On violation, keep the input.
round_clean = (a: Alloc, text: str, lexed: Lexed, join: bool)
              Res<String, AllocError> {
    p ::= a.Parser(lexed);
    m = p.module(lexed.source.file).try();
    (p.diags.len == 0).match({
        false => copy_of(a, text),
        true  => {
            src = a.Src(text).try();
            edits ::= a.Vec<Edit>();
            judge(a, src, collect(a, src, p.tree, m).try(), edits, join).try();
            apply(a, text, edits)
        },
    })
}

// Return an owned copy of unchanged input.
copy_of* = (a: Alloc, text: str) Res<String, AllocError> {
    out ::= a.String().try();
    out.add(text).try();
    Ok(out);
}

// -------------------------------------------------------------------
// finding the lists
// -------------------------------------------------------------------

// Sort by start and then reverse end: containers precede nested lists, while
// disjoint lists remain left to right.
collect = (a: Alloc, src: Src, tree: Ast, m: Module)
          Res<Vec<Cand>, AllocError> {
    cands ::= a.Vec<Cand>();
    id    ::= ExprId(index: 0);
    Range(0, tree.expr_ids()).loop((h, i) {
        e = tree.expr_at(id);
        e.kind.match({
            Call(c)   => add_call(a, src, cands, c),
            Array(al) => add_array(a, src, tree, cands, e, al),
            Lambda(l) => add_params(a, src, cands, l.params, l.params_span),
            _         => no_list(),
        }).try();
        id = ExprId(index: id.index + 1);
    });
    tid ::= TypeId(index: 0);
    Range(0, tree.type_ids()).loop((h, i) {
        t = tree.type_at(tid);
        t.kind.match({
            Union(u) => add_union(a, src, tree, cands, t, u),
            Fn(f)    => add_params(a, src, cands, f.params, f.params_span),
            _        => no_list(),
        }).try();
        tid = TypeId(index: tid.index + 1);
    });
    m.decls.loop((h, i, d) {
        add_decl(a, src, cands, d).try();
    });
    bid ::= BlockId(index: 0);
    Range(0, tree.block_ids()).loop((h, i) {
        tree.block_at(bid).stmts.loop((g, j, s) {
            s.kind.match({
                Decl(d) => add_decl(a, src, cands, d),
                _       => no_list(),
            }).try();
        });
        bid = BlockId(index: bid.index + 1);
    });
    in_order(cands);
    Ok(cands);
}

// The no-op result used beside allocating collector arms.
no_list = () Res<(), AllocError> { Ok(()) }

// Calls and constructors use parenthesized, comma-separated lists.
add_call = (a: Alloc, src: Src, cands :: Vec<Cand>, c: Call)
           Res<(), AllocError> {
    (c.args.len == 0).match({
        true  => no_list(),
        false => {
            items ::= a.Vec<Item>();
            c.args.loop((h, i, arg) {
                items.add(Item(
                    lo: src.offset(arg.span.start),
                    hi: src.offset(arg.span.end)
                )).try();
            });
            cands.add(Cand(
                lo: src.offset(c.args_span.start),
                hi: src.offset(c.args_span.end),
                line: c.args_span.start.line,
                end_line: c.args_span.end.line,
                sep: ',',
                parens: true,
                vetoes: true,
                params: false,
                fill: false,
                items: items,
            ))
        },
    })
}

// Arrays share the bracketed-list rules but may fill multiple items per line.
add_array = (
    a     : Alloc,
    src   : Src,
    tree  : Ast,
    cands :: Vec<Cand>,
    e     : Expr,
    al    : ArrayLit
) Res<(), AllocError> {
    (al.elems.len == 0).match({
        true  => no_list(),
        false => {
            items ::= a.Vec<Item>();
            al.elems.loop((h, i, eid) {
                s = tree.expr_at(eid).span;
                items.add(Item(
                    lo: src.offset(s.start),
                    hi: src.offset(s.end)
                )).try();
            });
            cands.add(Cand(
                lo: src.offset(e.span.start),
                hi: src.offset(e.span.end),
                line: e.span.start.line,
                end_line: e.span.end.line,
                sep: ',',
                parens: true,
                vetoes: true,
                params: false,
                fill: true,
                items: items,
            ))
        },
    })
}

// Collect list-bearing declarations at module or block scope.
add_decl = (a: Alloc, src: Src, cands :: Vec<Cand>, d: Decl)
           Res<(), AllocError> {
    d.kind.match({
        Enum(e)     => add_enum(a, src, cands, e),
        Function(f) => add_params(a, src, cands, f.params, f.params_span),
        _           => no_list(),
    })
}

// Parameters use the same parenthesized, comma-separated shape as arguments.
add_params = (
    a     : Alloc,
    src   : Src,
    cands :: Vec<Cand>,
    ps    : Vec<Param>,
    span  : Span
) Res<(), AllocError> {
    (ps.len == 0).match({
        true  => no_list(),
        false => {
            items ::= a.Vec<Item>();
            ps.loop((h, i, p) {
                items.add(Item(
                    lo: src.offset(p.span.start),
                    hi: src.offset(p.span.end)
                )).try();
            });
            cands.add(Cand(
                lo: src.offset(span.start),
                hi: src.offset(span.end),
                line: span.start.line,
                end_line: span.end.line,
                sep: ',',
                parens: true,
                vetoes: false,
                params: true,
                fill: false,
                items: items,
            ))
        },
    })
}

// A union span covers its first through last member.
add_union = (
    a     : Alloc,
    src   : Src,
    tree  : Ast,
    cands :: Vec<Cand>,
    t     : Type,
    u     : Union
) Res<(), AllocError> {
    items ::= a.Vec<Item>();
    u.members.loop((h, i, mid) {
        s = tree.type_at(mid).span;
        items.add(Item(lo: src.offset(s.start), hi: src.offset(s.end))).try();
    });
    cands.add(Cand(
        lo: src.offset(t.span.start),
        hi: src.offset(t.span.end),
        line: t.span.start.line,
        end_line: t.span.end.line,
        sep: '|',
        parens: false,
        vetoes: true,
        params: false,
        fill: false,
        items: items,
    ))
}

// An enum needs at least two variants to have a separator to rewrite.
add_enum = (a: Alloc, src: Src, cands :: Vec<Cand>, e: Enum)
           Res<(), AllocError> {
    (e.variants.len < 2).match({
        true  => no_list(),
        false => {
            items ::= a.Vec<Item>();
            e.variants.loop((h, i, v) {
                items.add(Item(
                    lo: src.offset(v.span.start),
                    hi: src.offset(v.span.end)
                )).try();
            });
            first = e.variants.ptr().read(0);
            last  = e.variants.ptr().read(e.variants.len - 1);
            cands.add(Cand(
                lo: src.offset(first.span.start),
                hi: src.offset(last.span.end),
                line: first.span.start.line,
                end_line: last.span.end.line,
                sep: '|',
                parens: false,
                vetoes: true,
                params: false,
                fill: false,
                items: items,
            ))
        },
    })
}

// Insertion sort: a file holds a handful of lists. (lo, hi) pairs are
// distinct per candidate — two parser spans sharing both ends would be
// the same node — so the order is total and stability never arises.
in_order = (cands :: Vec<Cand>) () {
    Range(1, cands.len).loop((h, i) {
        j ::= i;
        loop(() { j > 0 && before(
            cands.ptr().read(j),
            cands.ptr().read(j - 1)
        ) }, (g) {
            tmp = cands.ptr().read(j - 1);
            cands.ptr().write(j - 1, cands.ptr().read(j));
            cands.ptr().write(j, tmp);
            j = j - 1;
        });
    });
}

before = (x: Cand, y: Cand) bool {
    (x.lo < y.lo) || (x.lo == y.lo && x.hi > y.hi)
}

// -------------------------------------------------------------------
// judging
// -------------------------------------------------------------------

// `moved` is parallel to `cands`; copying a candidate would also copy its
// item-vector handle. Packing edits only gaps and needs no claims. Breaking
// marks changed containers so their nested lists wait for the next reparse.
judge = (
    a     : Alloc,
    src   : Src,
    cands : Vec<Cand>,
    edits :: Vec<Edit>,
    join  : bool
) Res<(), AllocError> {
    moved ::= a.Vec<bool>();
    Range(0, cands.len).loop((h, i) { moved.add(false).try(); });
    Range(0, cands.len).loop((h, i) {
        c = cands.ptr().read(i);
        relaid(src, cands, moved, c, join).match({
            false => no_list(),
            true  => join.match({
                true  => emit_join(a, c, edits),
                false => break_and_mark(a, src, c, edits, moved, i),
            }),
        }).try();
    });
    in_byte_order(edits);
    Ok(());
}

break_and_mark = (
    a     : Alloc,
    src   : Src,
    c     : Cand,
    edits :: Vec<Edit>,
    moved :: Vec<bool>,
    i     : usize
) Res<(), AllocError> {
    moved.ptr().write(i, emit_break(a, src, c, edits).try());
    Ok(());
}

// Packing requires safe gaps; breaking also excludes lists affected by this
// round or by a disjoint neighbour and requires an over-wide packed form.
relaid = (
    src   : Src,
    cands : Vec<Cand>,
    moved : Vec<bool>,
    c     : Cand,
    join  : bool
) bool {
    may_relay(src, c) && join.match({
        true  => may_join(src, c),
        false => !inside_moved(cands, moved, c)
              && !wraps_one_list(cands, c)
              && !shares_line(src, cands, c)
              && too_wide(src, c),
    })
}

// A nested list waits one round after its container moves so its width and
// indentation are measured from reparsed text.
inside_moved = (cands: Vec<Cand>, moved: Vec<bool>, c: Cand) bool {
    found ::= false;
    Range(0, cands.len).loop((h, j) {
        other = cands.ptr().read(j);
        holds = moved.ptr().read(j) && other.lo <= c.lo && other.hi >= c.hi;
        holds.match({
            true  => { found = true; h.break(); },
            false => (),
        });
    });
    found;
}

// A one-item wrapper stays packed when a nested list ending with that item can
// solve the width by itself.
wraps_one_list = (cands: Vec<Cand>, c: Cand) bool {
    (c.items.len == 1) && ends_the_item(cands, c, c.items.ptr().read(0))
}

// Whether a nested list closes at the end of the wrapper's only item.
ends_the_item = (cands: Vec<Cand>, c: Cand, only: Item) bool {
    found ::= false;
    Range(0, cands.len).loop((h, j) {
        d = cands.ptr().read(j);
        (d.lo > c.lo && d.hi == only.hi).match({
            true  => { found = true; h.break(); },
            false => (),
        });
    });
    found;
}

// Comments and already-columnar parameter lists must keep their layout.
may_join = (src: Src, c: Cand) bool {
    uncommented(src, c.lo, c.hi) && !(c.params && !one_line(src, c.lo, c.hi))
}

// This conservative byte scan may decline a string containing `//`; declining
// is safe because it leaves the source untouched.
uncommented = (src: Src, from: usize, to: usize) bool {
    clear ::= true;
    Range(from, to).loop((h, i) {
        (src.text.index(i) == '/' && opens_comment(src, i + 1, to)).match({
            true  => { clear = false; h.break(); },
            false => (),
        });
    });
    clear;
}

opens_comment = (src: Src, at: usize, to: usize) bool {
    (at < to) && (src.text.index(at) == '/' || src.text.index(at) == '*')
}

// Measure the line as if eligible whitespace runs were collapsed.
too_wide = (src: Src, c: Cand) bool {
    packed_width(src, c) > WIDTH
}

// Do not break one of two disjoint vetoing lists on a shared line: neither
// break alone fixes the surrounding expression. Nested lists do not count.
shares_line = (src: Src, cands: Vec<Cand>, c: Cand) bool {
    ls = src.line_at(c.line);
    le = src.after_line(c.line);
    found ::= false;
    Range(0, cands.len).loop((h, j) {
        d        = cands.ptr().read(j);
        disjoint = d.lo >= c.hi || d.hi <= c.lo;
        (d.vetoes && disjoint && d.lo < le && d.hi > ls).match({
            true  => { found = true; h.break(); },
            false => (),
        });
    });
    found;
}

packed_width = (src: Src, c: Cand) usize {
    prefix = c.lo - src.line_at(c.line);
    suffix = src.trim_back(c.hi, src.after_line(c.end_line)) - c.hi;
    prefix + collapsed(src, c.lo, c.hi) + suffix
}

collapsed = (src: Src, from: usize, to: usize) usize {
    n  ::= 0;
    ws ::= false;
    Range(from, to).loop((h, i) {
        sp = src.text.index(i).is_space();
        (sp && ws).match({
            true  => (),
            false => { n = n + 1; },
        });
        ws = sp;
    });
    n;
}

// Rewriting is safe only for single-line items, whitespace-only bracket gaps,
// and gaps containing exactly the expected separator plus whitespace.
may_relay = (src: Src, c: Cand) bool {
    first = c.items.ptr().read(0);
    last  = c.items.ptr().read(c.items.len - 1);
    clear ::= c.parens.match({
        true  => src.all_space(c.lo + 1, first.lo)
              && src.all_space(last.hi, c.hi - 1),
        false => true,
    });
    Range(0, c.items.len - 1).loop((h, i) {
        item = c.items.ptr().read(i);
        ok   = one_line(src, item.lo, item.hi)
          && clean_gap(src, item.hi, c.items.ptr().read(i + 1).lo, c.sep);
        ok.match({
            true  => (),
            false => { clear = false; h.break(); },
        });
    });
    clear && one_line(src, last.lo, last.hi);
}

one_line = (src: Src, from: usize, to: usize) bool {
    flat ::= true;
    Range(from, to).loop((h, i) {
        (src.text.index(i) == '\n').match({
            true  => { flat = false; h.break(); },
            false => (),
        });
    });
    flat;
}

// Accept whitespace, one separator, then whitespace and nothing else.
clean_gap = (src: Src, from: usize, to: usize, sep: u8) bool {
    mid = src.skip_space(from, to);
    (mid < to && src.text.index(mid) == sep).match({
        false => false,
        true  => src.skip_space(mid + 1, to) == to,
    })
}

// -------------------------------------------------------------------
// joining and breaking
// -------------------------------------------------------------------

// Packed form: brackets hug their items and separators carry one space.
emit_join = (a: Alloc, c: Cand, edits :: Vec<Edit>) Res<(), AllocError> {
    gone ::= a.String().try();
    first = c.items.ptr().read(0);
    last  = c.items.ptr().read(c.items.len - 1);
    c.parens.match({
        true  => edits.add(Edit(from: c.lo + 1, to: first.lo, text: gone)),
        false => no_list(),
    }).try();
    Range(0, c.items.len - 1).loop((h, i) {
        rep ::= a.String().try();
        c.parens.match({
            true  => (),
            false => { rep.add(' ').try(); },
        });
        rep.add(c.sep).try();
        rep.add(' ').try();
        edits.add(Edit(
            from: c.items.ptr().read(i).hi,
            to: c.items.ptr().read(i + 1).lo,
            text: rep
        )).try();
    });
    c.parens.match({
        true  => edits.add(Edit(from: last.hi, to: c.hi - 1, text: gone)),
        false => no_list(),
    }).try();
    Ok(());
}

// Broken form puts bracketed items at +4 indentation and the closer at the
// opener's indentation. Commas trail items; union and enum bars lead them.
// The result says whether any emitted edit changed bytes, allowing already
// broken containers to stop blocking their nested lists.
emit_break = (a: Alloc, src: Src, c: Cand, edits :: Vec<Edit>)
             Res<bool, AllocError> {
    was    = edits.len;
    start  = src.line_at(c.line);
    indent = src.skip_space(start, src.after_line(c.line)) - start;
    close ::= a.String().try();
    close.fmt("\n{}", src.slice_at(start, start + indent)).try();
    nl ::= a.String().try();
    nl.fmt("{}    ", close.view()).try();
    first = c.items.ptr().read(0);
    last  = c.items.ptr().read(c.items.len - 1);
    c.parens.match({
        true  => edits.add(Edit(from: c.lo + 1, to: first.lo, text: nl)),
        false => no_list(),
    }).try();
    c.fill.match({
        true  => filled_gaps(a, c, edits, nl.view(), indent + 4),
        false => stacked_gaps(a, c, edits, nl.view()),
    }).try();
    c.parens.match({
        true  => edits.add(Edit(from: last.hi, to: c.hi - 1, text: close)),
        false => no_list(),
    }).try();
    Ok(rewrites(src, edits, was));
}

// Stack one item per line.
stacked_gaps = (a: Alloc, c: Cand, edits :: Vec<Edit>, nl: str)
               Res<(), AllocError> {
    Range(0, c.items.len - 1).loop((h, i) {
        rep ::= a.String().try();
        c.parens.match({
            true  => { rep.add(c.sep).try();
                       rep.add(nl).try(); },
            false => { rep.add(nl).try();
                       rep.add(c.sep).try();
                       rep.add(' ').try(); },
        });
        edits.add(Edit(
            from: c.items.ptr().read(i).hi,
            to: c.items.ptr().read(i + 1).lo,
            text: rep
        )).try();
    });
    Ok(());
}

// Fill greedily from left to right. A non-final item's width includes its
// comma because the comma cannot move to the next line.
filled_gaps = (
    a      : Alloc,
    c      : Cand,
    edits  :: Vec<Edit>,
    nl     : str,
    indent : usize
) Res<(), AllocError> {
    col ::= indent + item_width(c, 0);
    Range(0, c.items.len - 1).loop((h, i) {
        next  = c.items.ptr().read(i + 1);
        grown = col + 1 + item_width(c, i + 1);
        rep ::= a.String().try();
        rep.add(c.sep).try();
        (grown <= WIDTH).match({
            true  => { rep.add(' ').try();
                       col = grown; },
            false => { rep.add(nl).try();
                       col = indent + item_width(c, i + 1); },
        });
        edits.add(Edit(
            from: c.items.ptr().read(i).hi,
            to: next.lo,
            text: rep
        )).try();
    });
    Ok(());
}

// Width of a single-line item, including its trailing comma when present.
item_width = (c: Cand, i: usize) usize {
    it = c.items.ptr().read(i);
    (it.hi - it.lo) + (i + 1 < c.items.len).match({
        true  => 1,
        false => 0,
    })
}

// Whether an edit added since `was` differs from the current source bytes.
rewrites = (src: Src, edits: Vec<Edit>, was: usize) bool {
    found ::= false;
    Range(was, edits.len).loop((h, i) {
        e = edits.ptr().read(i);
        e.text.view().eq(src.slice_at(e.from, e.to)).match({
            false => { found = true; h.break(); },
            true  => (),
        });
    });
    found;
}

// Sort edits by byte position. Candidate nesting order differs from edit order;
// edits never overlap because each list owns only its gaps.
in_byte_order = (edits :: Vec<Edit>) () {
    Range(1, edits.len).loop((h, i) {
        j ::= i;
        loop(() { j > 0 && edits.ptr().read(j).from
                         < edits.ptr().read(j - 1).from }, (g) {
            tmp = edits.ptr().read(j - 1);
            edits.ptr().write(j - 1, edits.ptr().read(j));
            edits.ptr().write(j, tmp);
            j = j - 1;
        });
    });
}

// Apply non-overlapping edits in byte order.
apply = (a: Alloc, text: str, edits: Vec<Edit>) Res<String, AllocError> {
    out ::= a.String().try();
    at  ::= 0;
    Range(0, edits.len).loop((h, i) {
        e = edits.ptr().read(i);
        out.fmt("{}{}", text.slice(at, e.from), e.text.view()).try();
        at = e.to;
    });
    out.add(text.slice(at, text.len)).try();
    Ok(out);
}
