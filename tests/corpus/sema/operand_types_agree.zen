// AN OPERAND ANSWERS TO ITS PAIR (sema_type.operands_agree), and this
// is the legal side of that rule -- the rejections live in
// must-fail/traps/literal_operand_out_of_range and
// must-fail/sema/comparison_operands_disagree.
//
// A LITERAL still takes its type from its context, so a literal operand
// against a narrow binding stays legal at every value that fits: `200`
// is no wider than the `u8` beside it. Two settled operands of the SAME
// type agree by being the same type, whatever the width. And a float
// pair is not an integer pair, so nothing new is asked of it -- the
// comparison is written rather than printed because {}'s digit count
// for a float is deliberately unspecified (lex/number_float_basics).

main = (env: Env) Res<i32, AllocError> {
    n: u8    = 200;
    m: u8    = 3;
    w: usize = 9;
    x: f64   = 1.5;
    y: f64   = 0.5;
    println("{}", (n / 2).to_i64());
    println("{}", (n - 1).to_i64());
    println("{}", (n / m).to_i64());
    println("{}", n > 199);
    println("{}", w == 9);
    println("{}", (x + y) == 2.0);
    Ok(0);
}
