// INDEXING AN ARRAY OF STRUCTS STEPS ONE WHOLE ELEMENT PER SLOT.
//
// `[Point, 3]` is a struct around a C array of POINT-sized slots
// (gen_c/gen_c_array.zen wraps the C array precisely so value semantics
// exist), and `tri[i].f` is two offsets composed: the element stride,
// then the field inside it. A backend that takes the stride from the
// FIELD's width compiles without a word of complaint — ints all the way
// down — and reads the neighbouring field of the previous element.
//
// The values below are chosen so that failure mode prints an ASCENDING
// run: with a 4-byte stride, `tri[1].x` is tri[0].y and `tri[2].x` is
// tri[1].x, giving "1 2 3", which looks like perfectly reasonable data.
// Only the true stride prints "1 3 7". The second line forces a field of
// the LAST element through arithmetic, so a walk that stops one element
// early cannot hide.

Point = { x: i32, y: i32 }

main = (env: Env) Res<i32, AllocError> {
    tri: [Point, 3] = [
        Point(x: 1, y: 2), Point(x: 3, y: 5), Point(x: 7, y: 11)
    ];
    println("{} {} {}", tri[0].x, tri[1].x, tri[2].x);
    println("{}", tri[0].y + tri[1].y + tri[2].y);
    Ok(0);
}
