// drvutil.zen — the driver's small shared helpers: stdout/stderr writes, integer and byte-range
// pushes onto a genc String, and path slicing. Split out of driver.zen so the extracted verbs
// (lsp, profile, buildproj) can reach them without importing the driver itself, which would be a
// cycle: the driver imports each verb's entry point.
{ Malloc } = std.mem.alloc
{ view, is_empty } = std.text.str
{ then } = std.core.bool
{ or } = std.core.result    // discard `out` write Results — the driver's stdout is best-effort
{ out } = std.io.file
{ clock_ms, getEnv } = std.sys.os
{ getpid, opendir, closedir } = std.c.libc
{ gstr_string, gstr_append, gstr_finish, gstr_push } = compiler.genc    // the seed's String API
{ eprint, exit, resolve_failed, resolve_program_data, ResolvedProgram } = compiler.resolve    // eprint = the shared stderr write
say* = (s: string_view) i64 {
    out(s).or(0)
    out("\n").or(0)
}
// Intermediate /tmp files are namespaced by pid so two concurrent `zenc` invocations never clobber
// each other's temp.c / temp.bin (a fixed path made one process compile/run the OTHER's program).
// getpid() is constant for the life of a run, so each builder yields the SAME path on every call —
// the write + the cc command (TMPC), and the build output + the run (TMPBIN), stay consistent.
pid_digit = (d: i64) u8 { load(offset("0123456789", d)) }
// `pid_digit` INDEXES a literal, so a negative `n` reads before it — undefined, and in practice a NUL
// that truncates the whole built string at `cstr()`. A caller that slips a negative in deserves `-12`,
// not a silently half-written JSON frame.
push_int* = (s: String, mp: MutPtr<Malloc>, n: i64) String {
    (n < 0).then({
        return s.gstr_push(mp, '-').push_int(mp, 0 - n)
    })
    (n < 10).match ({
        true  => s.gstr_push(mp, pid_digit(n)),
        false => {
            hs := s.push_int(mp, n / 10)
            hs.gstr_push(mp, pid_digit(n % 10))
        },
    })
}    // hoist (gstr_reserve re-evals the receiver)
pid_path* = (mp: MutPtr<Malloc>, pre: string_view, suf: string_view) string_view {
    mp
        .gstr_string(64)
        .gstr_append(mp, pre)
        .push_int(mp, getpid())
        .gstr_append(mp, suf)
        .gstr_finish(mp)
}
// ── path helpers ────────────────────────────────────────────────────────────────────────────────
dirname* = (mp: MutPtr<Malloc>, p: string_view) string_view {
    v := p.view()
    cut := last_slash(v, 0, 0 - 1)
    (cut < 0).then({ "." }, { mp.cstr_prefix(p, cut) })
}
last_slash* = (v: [u8], i: i64, best: i64) i64 {
    (i >= v.len).then({ best }, { v.last_slash(i + 1, (v[i] == '/').then({ i }, { best })) })
}
// the first `n` bytes of `p` as an owned str — built through the allocator (no raw malloc).
cstr_prefix* = (mp: MutPtr<Malloc>, p: string_view, n: i64) string_view {
    push_prefix(mp.gstr_string(n + 1), mp, p.view(), 0, n).gstr_finish(mp)
}
push_prefix* = (s: String, mp: MutPtr<Malloc>, v: [u8], i: i64, n: i64) String {
    (i >= n).then({ s }, { push_prefix(s.gstr_push(mp, v[i]), mp, v, i + 1, n) })
}
pad_sp* = (s: String, mp: MutPtr<Malloc>, n: i64) String {
    (n <= 0).then({ s }, { s.gstr_push(mp, ' ').pad_sp(mp, n - 1) })
}
finish_cstr* = (s: String, mp: MutPtr<Malloc>) string_view { cstr(s.ptr) }
// bytes [a, b) as an owned str (through the allocator, like cstr_prefix).
push_span* = (s: String, mp: MutPtr<Malloc>, v: [u8], i: i64, n: i64) String {
    (i >= n).then({ s }, { push_span(s.gstr_push(mp, v[i]), mp, v, i + 1, n) })
}
bs_push_range* = (mp: MutPtr<Malloc>, out: String, v: [u8], p: i64, e: i64) String {
    (p >= e).then({ out }, { mp.bs_push_range(out.gstr_push(mp, v[p]), v, p + 1, e) })
}
join2* = (mp: MutPtr<Malloc>, a: string_view, b: string_view) string_view {
    mp
        .gstr_string(256)
        .gstr_append(mp, a)
        .gstr_append(mp, "/")
        .gstr_append(mp, b)
        .gstr_finish(mp)
}
// the bytes [s,e) of `v` as a fresh owned cstr — the loader/LSP/audit substring verb. ITERATIVE:
// a JSON body or module region is arbitrarily long, so it must not recurse the C stack per byte.
cstr_range* = (mp: MutPtr<Malloc>, v: [u8], s: i64, e: i64) string_view {
    o := mp.gstr_string(e - s + 1)
    i := s
    @while (i < e) {
        o = o.gstr_push(mp, v[i])
        i = i + 1
    }
    o.gstr_finish(mp)
}
// src[start .. start+n) as an owned str. (named cstr_* to avoid colliding with std.text.str's
// generic `substr` once the modules are flattened together — a plain `substr` would emit a second
// C `substr` definition.)
cstr_substr* = (mp: MutPtr<Malloc>, s: string_view, start: i32, n: i32) string_view {
    v: [u8] := s.view()
    mp.bs_push_range(mp.gstr_string(n + 1), v, start, start + n).gstr_finish(mp)
}
// ── ZENC_TIME=1: coarse wall-clock per pipeline stage (stderr) ───────────────────────────────────
// Reads CLOCK_MONOTONIC straight through libc (std.time isn't in the seed manifest). The timespec
// cell is a STACK slice literal, deliberately not an allocator cell: a heap alloc+free here would
// perturb the allocation sequence mid-pipeline, and the reading must observe the compiler, not move
// it. `zt_log` prints "zenc: time <stage> <ms>ms" when ZENC_TIME is set and returns the new reading,
// so stages chain: `t1 := mp.zt_log("parse", t0)`.
zt_on* = () bool { is_empty(getEnv("ZENC_TIME")) == false }
zt_log* = (mp: MutPtr<Malloc>, name: string_view, start_ms: i64) i64 {
    now := clock_ms()
    zt_on().then({
        eprint(mp
            .gstr_string(64)
            .gstr_append(mp, "zenc: time ")
            .gstr_append(mp, name)
            .gstr_append(mp, " ")
            .push_int(mp, now - start_ms)
            .gstr_append(mp, "ms\n")
            .gstr_finish(mp))
        { }
    })
    now
}
// ── the compile pipeline (resolve imports -> parse -> resolve_module) ─────────────────────────────
// the full resolved program (flat + per-module table) — check/build keep it so a diagnostic can
// render against the imported module its error actually lives in.
// THE CLI's resolve step. `compiler.resolve` reports a rejection and latches rather than killing
// the process (the language server has to survive a half-typed import), so the CLI reinstates its own
// contract here: the message is already on stderr, and exiting NOW — before parse/check can add
// output — reproduces the old in-library `exit(1)` byte for byte. The server calls
// `resolve_program_data` + `resolve_failed()` directly instead, and keeps serving.
resolve_prog_or_exit* = (
    mp: MutPtr<Malloc>,
    root: string_view,
    path: string_view,
    src: string_view,
) ResolvedProgram {
    rp := mp.resolve_program_data(root, mp.dirname(path), path, src)
    resolve_failed().then({
        exit(1)
    })
    rp
}
dir_exists* = (path: string_view) bool {
    d := opendir(path)
    (d == null_ptr()).match ({
        true  => false,
        false => {
            closedir(d)
            true
        },
    })
}
