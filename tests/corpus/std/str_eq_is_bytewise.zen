// tests/corpus/std/str_eq_is_bytewise.zen
// == on str is bytewise: same bytes, same string. length is part
// of it, so a prefix is not equal to the whole - the classic bug
// is a memcmp over the shorter length with no length test

main = (env: Env) Res<i32, AllocError> {
    ("abc" == "abc").match({
        true  => println("same same"),
        false => println("same differ"),
    });
    ("abc" == "abd").match({
        true  => println("last byte same"),
        false => println("last byte differ"),
    });
    ("abc" == "abcd").match({
        true  => println("prefix same"),
        false => println("prefix differ"),
    });
    ("" == "").match({
        true  => println("empty same"),
        false => println("empty differ"),
    });
    Ok(0);
}
