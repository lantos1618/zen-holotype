// a free function is callable as a method when its FIRST PARAMETER is
// the receiver's type, and only then. `size` takes a Bag, so it is on
// Bag and on nothing else -- sharing the name with a Box's call site
// does not put it there.
//
// position: the method name, after the dot.

Box = {
    w: i32,
}

Bag = {
    n: i32,
}

size = (g: Bag) i32 { g.n }

main = (env: Env) Res<i32, AllocError> {
    b = Box(w: 3);
    println("{}", b.size());
    Ok(0);
}
