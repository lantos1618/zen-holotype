// A member's explicit generic arguments obey its bounds, including a bound on
// a return-only parameter that cannot be recovered from value arguments.

Boxy = {
    width: i32,
}

Dot = {}

Tool = {
    measure = <T: Boxy>(self: @Self) i32 { 1 }
}

main = (env: Env) Res<i32, AllocError> {
    tool = Tool();
    println("{}", tool.measure<Dot>());
    Ok(0);
}
