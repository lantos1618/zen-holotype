// Parser-specific token helpers. Comments remain tokens, token text is borrowed
// from Source, and `_` becomes a wildcard only in permitted grammar positions.

Token*, TokenKind*, Source*, Lexed*, kind_name* = std.lex.lex

Pos, Span = std.lex.lex

// Synthetic Eof for an empty token stream.
empty_eof* = () Token {
    at = Pos(offset: 0, line: 1, col: 1);
    Token(kind: TokenKind.Eof, span: Span(start: at, end: at));
}

// Whether a token carries source trivia.
is_trivia* = (kind: TokenKind) bool {
    kind.match({
        LineComment  => true,
        BlockComment => true,
        _            => false,
    });
}

// `_` remains an identifier until the parser recognizes wildcard or inference
// syntax.
WILDCARD*: str = "_"
