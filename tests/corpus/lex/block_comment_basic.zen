/* a block comment before the declarations */
// an ordinary line comment
//no space after the slashes
///three slashes
//! bang comment
// a line comment may contain /* an unclosed block opener and a " quote
// and an apostrophe ' and even a \ backslash
Error = AllocError | IoError

/* a block comment may span
   several lines, and may contain // a line comment,
   a "quoted string", an apostrophe ' , a lone * , a lone / ,
   and a star-slash lookalike like * / written apart */
main /* name */ = /* eq */ (env: Env) /* params */ Res<i32, Error> /* ret */ {
    println(/* between tokens */ "one"); // trailing after a statement
    // a comment on its own line inside a block
    println("two"); /* after a statement */
    /**/
    /* */
    /***/
    println("three");
    /* a block comment between executable statements */
    println("body reached");
    Ok(0);
}
// a comment after the last declaration
