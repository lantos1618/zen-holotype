Left = Number(i32) | Empty
Right = | Text(str)

number = (value: i32) Res<i32, Left | Right> { Err(Left.Number(value)) }
text = (value: str) Res<i32, Left | Right> { Err(Right.Text(value)) }
empty = () Res<i32, Left | Right> { Err(Left.Empty) }

show = (result: Res<i32, Left | Right>) () {
    result.match({
        Ok(value)  => println("ok {}", value),
        Err(error) => error.match({
            Left(Number(0))      => println("zero"),
            Left(Number(value))  => println("number {}", value),
            Left(Empty)          => println("empty"),
            Right(Text("hello")) => println("hello"),
            Right(Text(value))   => println("text {}", value),
        }),
    });
}

rebuild = (result: Res<i32, Left | Right>) Res<i32, Left> {
    result.match({
        Ok(value)  => Ok(value),
        Err(error) => error.match({
            Left  => Err(Left.Number(12)),
            Right => Err(Left.Empty),
        }),
    })
}

main = (env: Env) Res<i32, AllocError> {
    show(number(0));
    show(number(7));
    show(empty());
    show(text("hello"));
    show(text("other"));
    rebuild(number(0)).match({
        Ok(_)      => (),
        Err(value) => value.match({
            Number(n) => println("rebuilt {}", n),
            Empty     => println("unexpected empty"),
        }),
    });
    Ok(0)
}
