// tests/bench/bench_vec.zen
// benches live next to tests and take a Bencher exactly as tests
// take a Tester; build.zen finds them by that single parameter.
// because ALL allocation goes through Alloc, the alloc and byte
// counts come free and are identical on every machine - which is
// why they are a HARD gate and ns_op is not

// gated by, from DESIGN.md's own build.zen:
//   Budget(name: "vec_add", ns_op: 40, allocs_op: 1, bytes_op: 64)
//
// one add on an empty Vec is exactly one grow: capacity 0 -> 8.
// two allocations here means grow stopped doubling

Alloc = std.mem
Bencher, TestError = std.test

// THE MEASURED OPERATION, AND THE ONLY COPY OF IT.
// drivers/vec_add.zen imports THIS function; see bench_loop.zen's
// note on why a driver may not restate a body. The Alloc is a
// PARAMETER because the bench draws it from `bn.alloc` and the
// driver from `env.mem.alloc()` -- the two harnesses differ, the
// operation does not.
vec_add_body* = (alloc: Alloc) Res<(), AllocError> {
    v ::= alloc.Vec<i32>();
    v.add(1).try();
    Ok(());
}

vec_add* = (bn: Bencher) Res<(), TestError> {
    bn.iter(() {
        vec_add_body(bn.alloc);
    });
    Ok(());
}
