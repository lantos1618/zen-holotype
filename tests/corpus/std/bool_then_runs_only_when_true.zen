// tests/corpus/std/bool_then_runs_only_when_true.zen
// the false side does nothing at all - the closure is not called.
// a `then` that evaluated its body eagerly would count twice here
// and still print the right Res

main = (env: Env) Res<i32, AllocError> {
    hits ::= 0;
    (1 == 1).then(() { hits = hits + 1 });
    (1 == 2).then(() { hits = hits + 1 });
    (2 > 1).then(() { hits = hits + 1 });
    println("hits {}", hits);
    Ok(0);
}
