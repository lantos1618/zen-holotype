// Params SHADOW top-level names: a closure param named `f` must resolve to the LOCAL param inside
// its fn's body even though a top-level `f` exists in the flattened program. This exact clash used
// to mis-resolve `or_else`'s closure param against any host-program `f` and flag a bogus arity
// error (dodged in #365 by renaming; fixed for real by the shadowing guard in check_validate).
// Exit 61 = apply(20, double)=40 + Err.or_else(→3)=3 + top-level f(10,8)=18.
{ Result, IoError } = std.core.result
f = (a: i32, b: i32) i32 { a + b }
apply<T> = (x: T, f: (arg0: T) T) T { f(x) }
mkerr = () Result<i32, IoError> { .Err(.NotFound) }
main = () i32 {
    a = apply(20, (v) { v * 2 })
    b = mkerr().or_else((e) { 3 })
    c = f(10, 8)
    a + b + c
}
