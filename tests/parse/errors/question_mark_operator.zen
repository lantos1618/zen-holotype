// MUST FAIL: the `?` error-propagation operator. DESIGN.md:152 — "no `?` operator".
// Propagation is written `.try()` (DESIGN.md:411-415), which is the non-local-exit
// intrinsic and the same mechanism as `h.break` (DESIGN.md:158).

read_cfg* = (p: Path) Res<Cfg, IoError> {
    c = load(p)?;
    Ok(c);
}
