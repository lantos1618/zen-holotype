Span = std.ast
Decl, Struct, Impl, Member, Field = std.ast
Function = std.ast
AllocError = std.mem
Vec = std.collections
str = std.text
Range = std.core
ImplId = sema.sema_id
TyId, TyNamed, Prim = sema.sema_ty
Def, decl_at = sema.sema_def
Checker, Ctx = sema.sema_check
Found, member_type, supplied_found = sema.sema_member
enter_struct_tvars, decl_span = sema.sema_member
type_from_ast = sema.sema_denote

// One impl declared beside its target type, with its bound resolved.
LocalImpl* = {
    id*: ImplId,
    im*: Impl,
    bound*: TyId,
}

// Impls are matched by type name and declaring module; a same-named type
// elsewhere has its own impls.
local_impls* = (c :: Checker, n: TyNamed, out :: Vec<LocalImpl>)
               Res<(), AllocError> {
    ids ::= c.alloc.Vec<ImplId>();
    c.world.impls_named(c.tree, n.name, ids).try();
    mi = n.decl.module.to_usize();
    ids.loop((h, id) {
        (n.decl.module == id.decl.module).then(() {
            c.world.impl_at(c.tree, id).match({
                None   => Ok(()),
                Ok(im) => out.add(LocalImpl(
                    id: id,
                    im: im,
                    bound: c.impl_bound_type(im, mi).try()
                )),
            }).try();
        });
    });
    Ok(());
}

// The prelude declaration of a primitive's name, as the type its impls
// attach to.
prim_named* = (c :: Checker, p: Prim) Res<Res<TyNamed>, AllocError> {
    defs ::= c.alloc.Vec<Def>();
    c.world.prelude_of(p.name, defs).try();
    Ok(defs.get(0).match({
        None  => None,
        Ok(d) => Ok(TyNamed(
            decl: d.id,
            name: p.name,
            args: c.alloc.Vec<TyId>()
        )),
    }))
}

impl_members* = (
    c    :: Checker,
    n    : TyNamed,
    ty   : TyId,
    name : str,
    out  :: Vec<Found>
) Res<(), AllocError> {
    impls ::= c.alloc.Vec<LocalImpl>();
    c.local_impls(n, impls).try();
    impls.loop((h, li) { c.supplied(li, ty, name, out).try() });
    Ok(());
}

supplied = (c :: Checker, li: LocalImpl, ty: TyId, name: str, out :: Vec<Found>)
           Res<(), AllocError> {
    tys ::= c.alloc.Vec<TyId>();
    c.supplied_types(li.im, li.bound, name, ty, tys).try();
    span = c.impl_span(li.id);
    tys.loop((h, t) { out.add(supplied_found(name, t, li.bound, span)).try() });
    Ok(());
}

supplied_types = (
    c       :: Checker,
    im      : Impl,
    bound   : TyId,
    name    : str,
    self_ty : TyId,
    out     :: Vec<TyId>
) Res<(), AllocError> {
    supplied_here = im.members.has_member(name);
    all ::= c.alloc.Vec<Member>();
    c.bound_members(bound, all).try();
    kept ::= c.alloc.Vec<Member>();
    all.loop((h, m) { m.keep_reachable(name, supplied_here, kept).try() });
    c.member_types(bound, kept, self_ty, out)
}

keep_reachable = (
    m             : Member,
    name          : str,
    supplied_here : bool,
    kept          :: Vec<Member>
) Res<(), AllocError> {
    (m.named(name) && (m.has_body() || supplied_here)).match({
        true  => kept.add(m),
        false => Ok(()),
    })
}

impl_bound_type* = (c :: Checker, im: Impl, mi: usize)
                   Res<TyId, AllocError> {
    poison = c.types.unknown().try();
    tmark  = c.tvar_mark();
    c.enter_impl_target_tvars(im.target.text, mi).try();
    got = c.type_from_ast(im.bound, Ctx(mi, poison)).try();
    c.release_tvars(tmark).try();
    Ok(got);
}

enter_impl_target_tvars = (c :: Checker, target: str, mi: usize)
                          Res<(), AllocError> {
    defs ::= c.alloc.Vec<Def>();
    c.world.own_defs(mi, target, defs).try();
    defs.get(0).match({
        None  => Ok(()),
        Ok(d) => c.tree.decl_at(d.id).match({
            Ok(x) => c.enter_decl_tvars(x, mi),
            None  => Ok(()),
        }),
    })
}

enter_decl_tvars = (c :: Checker, d: Decl, mi: usize) Res<(), AllocError> {
    d.kind.match({
        Struct(s) => c.enter_struct_tvars(s, mi),
        _         => Ok(()),
    })
}

// Sealed and default bound members provide bodies; required members do not.
has_body = (m: Member) bool {
    m.kind.match({
        Function(f) => f.body.match({ Ok(_) => true, None => false }),
        _           => false,
    })
}

bound_member_type* = (c :: Checker, bound: TyId, name: str, self_ty: TyId)
                     Res<TyId, AllocError> {
    tys ::= c.alloc.Vec<TyId>();
    c.bound_member_types(bound, name, self_ty, tys).try();
    tys.get(0).match({ Ok(t) => Ok(t), None => c.types.unknown() })
}

// Preserve every declaration in an overload set and its source order.
bound_member_types* = (
    c       :: Checker,
    bound   : TyId,
    name    : str,
    self_ty : TyId,
    out     :: Vec<TyId>
) Res<(), AllocError> {
    all ::= c.alloc.Vec<Member>();
    c.bound_members(bound, all).try();
    kept ::= c.alloc.Vec<Member>();
    all.loop((h, m) { m.keep_reachable(name, true, kept).try() });
    c.member_types(bound, kept, self_ty, out)
}

// Member types resolve in the bound's own type-parameter scope.
member_types = (
    c       :: Checker,
    bound   : TyId,
    ms      : Vec<Member>,
    self_ty : TyId,
    out     :: Vec<TyId>
) Res<(), AllocError> {
    mi    = c.bound_module(bound);
    tmark = c.tvar_mark();
    c.enter_bound_tvars(bound, mi).try();
    ms.loop((h, m) { out.add(c.member_type(m, mi, self_ty).try()).try() });
    c.release_tvars(tmark).try();
    Ok(());
}

enter_bound_tvars = (c :: Checker, bound: TyId, mi: usize)
                    Res<(), AllocError> {
    c.types.at(bound).match({
        Named(n) => c.tree.decl_at(n.decl).match({
            Ok(d) => c.enter_decl_tvars(d, mi),
            None  => Ok(()),
        }),
        _        => Ok(()),
    })
}

// The members a bound declares, in source order.
bound_members* = (c :: Checker, bound: TyId, out :: Vec<Member>)
                 Res<(), AllocError> {
    c.types.at(bound).match({
        Named(n) => c.tree.decl_at(n.decl).match({
            Ok(d) => d.kind.match({
                Struct(s) => {
                    s.members.loop((h, m) { out.add(m).try() });
                    Ok(())
                },
                _         => Ok(()),
            }),
            None  => Ok(()),
        }),
        _        => Ok(()),
    })
}

// The i-th field a positional constructor argument supplies. Methods
// and struct constants have no per-value storage and take no seat.
storage_seat_name* = (c :: Checker, ty: TyId, i: usize)
                     Res<str, AllocError> {
    name    ::= "";
    seen    ::= 0;
    members ::= c.alloc.Vec<Member>();
    c.bound_members(ty, members).try();
    members.loop((h, m) {
        m.storage_member().then(() {
            (seen == i).then(() { name = m.name().text; });
            seen = seen + 1;
        });
    });
    Ok(name);
}

storage_member = (m: Member) bool {
    m.kind.match({
        Field(f) => f.type.match({ Ok(_) => true, None => false }),
        _        => false,
    })
}

bound_module = (c: Checker, bound: TyId) usize {
    c.types.at(bound).match({
        Named(n) => n.decl.module.to_usize(),
        _        => 0,
    })
}

bound_declares* = (c :: Checker, ty: TyId, name: str)
                  Res<bool, AllocError> {
    c.types.at(ty).match({
        Named(n) => c.impls_declare(n, name),
        Prim(p)  => c.prim_named(p).try().match({
            None   => Ok(false),
            Ok(pn) => c.impls_declare(pn, name),
        }),
        // a type parameter's members are settled at instantiation
        Var(_)   => Ok(true),
        _        => Ok(false),
    })
}

impls_declare = (c :: Checker, n: TyNamed, name: str)
                Res<bool, AllocError> {
    impls ::= c.alloc.Vec<LocalImpl>();
    c.local_impls(n, impls).try();
    hit ::= false;
    impls.loop((h, li) {
        all ::= c.alloc.Vec<Member>();
        c.bound_members(li.bound, all).try();
        all.has_member(name).then(() { hit = true; });
    });
    Ok(hit);
}

has_member* = (members: Vec<Member>, name: str) bool {
    members.find((m) { m.named(name) }).match({ Ok(_) => true, None => false })
}

impl_span* = (c: Checker, id: ImplId) Span {
    c.decl_span(id.decl)
}
