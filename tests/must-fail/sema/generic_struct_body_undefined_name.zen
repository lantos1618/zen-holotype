// A generic struct's method is a generic body too: its `T` is bound by
// the struct, and nothing checks the body at a call either -- a method
// call resolves against the SIGNATURE, so before declaration checking
// this body was read by nobody but lowering, which answered an
// undefined name with `unresolved name` from the wrong phase.
//
// position: the name that resolves to nothing.

Box*<T> = {
    v: T,

    get* = (self: @Self) T { nowhere }
}

main* = () () {}
