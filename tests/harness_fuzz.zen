// tests/harness_fuzz.zen — the FUZZ category for the Zen-native harness. It ports the two pytest fuzz
// suites into self-hosted Zen, driven against the committed `zenc` binary (NO Python):
//
//   _fuzz_campaign.py   -> a crash-hunt over MANY generated malformed inputs (random token soup,
//                          random byte noise, grammar-aware "targeted" recursion bombs)
//   test_harness_fuzz.py -> the crash-class REGRESSION gate (one minimal representative per malformed-
//                          input non-termination bug the campaign originally surfaced)
//
// Unlike the value/verdict categories, this is NOT a correctness harness: a clean *reject* is fine.
// It is a CRASH-RESISTANCE gate. `zenc check`/`emit` must terminate WITHOUT a signal (no segfault /
// SIGABRT) and WITHOUT hanging. The only failures here are real robustness bugs.
//
// ── HOW A CRASH IS DETECTED ─────────────────────────────────────────────────────────────────────
// Each probe runs under `timeout 60`. Inside the worker shell, `$?` is already the decoded exit code:
//   * clean accept/reject -> 0/1
//   * timeout            -> 124
//   * signal             -> 128 + signal
// `zenc check`/`emit` only exit 0 or 1 cleanly on these inputs, so code >= 124 separates a crash or
// hang from a clean reject. (Verified adversarially: segv->139, hang->124, reject->1.)
//
// Helpers are `fz_`-prefixed so they never collide on the flat-import flatten with std/harness_lib/etc.
{ run_suite, zo_path, zo_cmd, zo_par_run, zo_idpath, zo_join } = harness_lib
{ Malloc, malloc, free } = std.mem.alloc
{ out, save, shell, contents_in } = std.io.file
{ len, try_parse_int, view } = std.text.str
{ String, new_in, append_in, finish_in, push_in } = std.text.string
{ expect } = std.core.result
{ Rng, seed } = std.rand
// fixed, reproducible seed (NO Date.now — the sequence is identical on every run).
FZ_SEED := 20260623
// a real (well-formed) program; the truncation generator feeds prefixes of it (off-by-token garbage).
FZ_FULL := "P*: { x: i32 }\nf* = (p: P) i32 { p.x .match ({ 0 => 1, _ => 2 }) }\ntest* = () i32 { f(P(x: 5)) }"
// ── small builders (the value harness can't reach these; we build Zen source strings by hand) ─────
// append a decimal integer VALUE (no leading zeros) — for generated type-cycle names.
fz_app_int = (mp: MutPtr<Malloc>, s: String, n: i64) String {
    (n < 10).match ({
        true  => {
            d: u8 := ('0' + n).to_u8()
            mp.push_in(s, d).expect("fuzz: oom")
        },
        false => {
            s2 := mp.fz_app_int(s, n / 10)
            d2: u8 := ('0' + (n - n / 10 * 10)).to_u8()
            mp.push_in(s2, d2).expect("fuzz: oom")
        },
    })
}
// append `frag` n times — for N-deep unterminated blocks / parens / tyarg tails.
fz_rep = (mp: MutPtr<Malloc>, s: String, frag: string_view, i: i64, n: i64) String {
    (i >= n).then({ s }, { mp.fz_rep(s.append_in(mp, frag).expect("fuzz: oom"), frag, i + 1, n) })
}
// "A0*: { f: A1 }\nA1*: { f: A2 }\n...A(n-1)*: { f: A0 }\n" — a by-value struct type cycle of length n.
fz_cycle = (mp: MutPtr<Malloc>, s: String, i: i64, n: i64) String {
    (i >= n).match ({
        true  => s,
        false => {
            s1 := s.append_in(mp, "A").expect("fuzz: oom")
            s2 := mp.fz_app_int(s1, i)
            s3 := s2.append_in(mp, "*: { f: A").expect("fuzz: oom")
            s4 := mp.fz_app_int(s3, (i + 1) % n)
            s5 := s4.append_in(mp, " }\n").expect("fuzz: oom")
            mp.fz_cycle(s5, i + 1, n)
        },
    })
}
// push the first k bytes of `src` — yields an off-by-token truncation of a real program.
fz_trunc_go = (mp: MutPtr<Malloc>, s: String, sv: [u8], i: i64, k: i64) String {
    (i >= k).then({ s }, { mp.fz_trunc_go(mp.push_in(s, sv[i]).expect("fuzz: oom"), sv, i + 1, k) })
}
fz_trunc = (mp: MutPtr<Malloc>, src: string_view, k: i64) string_view {
    sv := src.view()
    s := mp.new_in().expect("fuzz: oom")
    mp.finish_in(mp.fz_trunc_go(s, sv, 0, k)).expect("fuzz: oom")
}
// ── input generators (deterministic via the seeded Rng) ───────────────────────────
// token soup: n random tokens from `toks` joined by spaces.
fz_soup = (
    mp: MutPtr<Malloc>,
    s: String,
    toks: [string_view],
    nt: i64,
    rp: MutPtr<Rng>,
    i: i64,
    n: i64,
) String {
    (i >= n).match ({
        true  => s,
        false => {
            tok := toks[rp.range(0, nt)]
            s1 := s.append_in(mp, tok).expect("fuzz: oom")
            s2 := s1.append_in(mp, " ").expect("fuzz: oom")
            mp.fz_soup(s2, toks, nt, rp, i + 1, n)
        },
    })
}
// byte noise: n random printable bytes in [32, 126].
fz_noise = (mp: MutPtr<Malloc>, s: String, rp: MutPtr<Rng>, i: i64, n: i64) String {
    (i >= n).match ({
        true  => s,
        false => {
            b: u8 := (' ' + rp.range(0, 95)).to_u8()
            mp.fz_noise(mp.push_in(s, b).expect("fuzz: oom"), rp, i + 1, n)
        },
    })
}
// grammar-aware malformed programs aimed at the recursion sites (cycles, unterminated nests, tyargs,
// recursive generics, polymorphic-recursive types, truncations).
fz_targeted = (mp: MutPtr<Malloc>, rp: MutPtr<Rng>, pick: i64) string_view {
    (pick == 0).match ({
        true  => mp
            .finish_in(mp.fz_cycle(mp.new_in().expect("fuzz: oom"), 0, rp.range(2, 7)))
            .expect("fuzz: oom"),
        false => (pick == 1).match ({
            true  => mp
                .finish_in(mp.fz_rep(mp
                    .new_in()
                    .expect("fuzz: oom")
                    .append_in(mp, "test* = () i32 { ")
                    .expect("fuzz: oom"), "{ ", 0, rp.range(1, 9)))
                .expect("fuzz: oom"),
            false => (pick == 2).match ({
                true  => mp
                    .finish_in(mp.fz_rep(mp
                        .new_in()
                        .expect("fuzz: oom")
                        .append_in(mp, "test* = () i32 { ")
                        .expect("fuzz: oom"), "( ", 0, rp.range(1, 12)))
                    .expect("fuzz: oom"),
                false => (pick == 3).match ({
                    true  => mp
                        .finish_in(mp.fz_rep(mp
                            .new_in()
                            .expect("fuzz: oom")
                            .append_in(mp, "test* = () i32 { 0 .match ({ ")
                            .expect("fuzz: oom"), ".V => 0 ", 0, rp.range(1, 7)))
                        .expect("fuzz: oom"),
                    false => (pick == 4).match ({
                        true  => mp
                            .finish_in(mp.fz_rep(mp
                                .new_in()
                                .expect("fuzz: oom")
                                .append_in(mp, "Foo")
                                .expect("fuzz: oom"), "<", 0, rp.range(1, 6)))
                            .expect("fuzz: oom"),
                        false => (pick == 5).match ({
                            true  => "a<T> = (x: T) T { b(x) }  b<T> = (x: T) T { a(x) }  test* = () i32 { a(1) }",
                            false => (pick == 6).match ({
                                true  => "Box<T>: { next: Box<Box<T>> }  use* = (b: Box<i32>) i32 { 0 }",
                                false => mp.fz_trunc(FZ_FULL, rp.range(1, len(FZ_FULL))),
                            }),
                        }),
                    }),
                }),
            }),
        }),
    })
}    // type cycle
// ── PARALLEL crash-resistance batch (dogfoods std.thread via harness_lib's zo_par_run) ─────────────
// Each input is probed by BOTH `zenc check` and `zenc emit` under `timeout 60`; a DECODED exit ≥ 124
// (timeout=124 / 128+signal) is a crash/hang. The shell command computes the 0..2 crash count itself and
// writes it to a per-input marker file, so the whole batch runs across the worker pool; Phase C reads the
// markers IN ORDER, printing '.'/crash-report exactly as the serial runner did (byte-identical output).
fz_cmd = (mp: MutPtr<Malloc>, gid: i64) string_view {
    z: string_view := ""
    f := mp.zo_idpath("fz", gid, ".zen")
    rc := mp.zo_idpath("fzrc", gid, ".txt")
    mp.zo_join([z, "timeout 60 ./zen check ", f, " >/dev/null 2>&1; a=$?; timeout 60 ./zen emit ", f, " >/dev/null 2>&1; b=$?; c=0; [ $a -ge 124 ] && c=$((c+1)); [ $b -ge 124 ] && c=$((c+1)); printf %s $c > ", rc])
}
// crash count for input gid (0..2). An unreadable marker counts as a crash (fail loud, never silently pass).
fz_crash_count = (mp: MutPtr<Malloc>, gid: i64) i32 {
    mp.contents_in(mp.zo_idpath("fzrc", gid, ".txt")).match ({
        .Ok(s)  => try_parse_int(s).match ({
            .Ok(v)  => to_i32(v),
            .Err(e) => 2,
        }),
        .Err(e) => 2,
    })
}
// run every generated src through both probes in parallel, then report IN ORDER; returns total crashes.
fz_batch = (mp: MutPtr<Malloc>, srcs: [string_view], n: i64) i32 {
    base := malloc(n * 8)
    cmds: [string_view] := base.slice(n)
    i: i64 := 0
    @while (i < n) {
        save(mp.zo_idpath("fz", i, ".zen"), srcs[i], len(srcs[i]))
        cmds[i] = mp.fz_cmd(i)
        i = i + 1
    }
    zo_par_run(cmds, n)
    crashes := 0
    j: i64 := 0
    @while (j < n) {
        cn := mp.fz_crash_count(j)
        (cn > 0).match ({
            true  => {
                out("\n!! CRASH/HANG on input: ")
                out(srcs[j])
                out("\n")
                crashes = crashes + cn
            },
            false => out("."),
        })
        j = j + 1
    }
    free(base)
    crashes
}
// ── phase drivers: generate all srcs (serial, seeded RNG threaded in the SAME order as before → the
// inputs are byte-identical to the serial suite), then run the whole phase across the worker pool. ──
fz_soup_phase = (mp: MutPtr<Malloc>, toks: [string_view], nt: i64, rp: MutPtr<Rng>, n: i64) i32 {
    base := malloc(n * 8)
    srcs: [string_view] := base.slice(n)
    i: i64 := 0
    @while (i < n) {
        srcs[i] = mp
            .finish_in(mp.fz_soup(mp.new_in().expect("fuzz: oom"), toks, nt, rp, 0, rp.range(1, 30)))
            .expect("fuzz: oom")
        i = i + 1
    }
    r := mp.fz_batch(srcs, n)
    free(base)
    r
}
fz_noise_phase = (mp: MutPtr<Malloc>, rp: MutPtr<Rng>, n: i64) i32 {
    base := malloc(n * 8)
    srcs: [string_view] := base.slice(n)
    i: i64 := 0
    @while (i < n) {
        srcs[i] = mp
            .finish_in(mp.fz_noise(mp.new_in().expect("fuzz: oom"), rp, 0, rp.range(1, 60)))
            .expect("fuzz: oom")
        i = i + 1
    }
    r := mp.fz_batch(srcs, n)
    free(base)
    r
}
fz_target_phase = (mp: MutPtr<Malloc>, rp: MutPtr<Rng>, n: i64) i32 {
    base := malloc(n * 8)
    srcs: [string_view] := base.slice(n)
    i: i64 := 0
    @while (i < n) {
        srcs[i] = mp.fz_targeted(rp, rp.range(0, 8))
        i = i + 1
    }
    r := mp.fz_batch(srcs, n)
    free(base)
    r
}
// crash-class REGRESSIONS: one minimal representative per known malformed-input non-termination bug.
fz_seed_phase = (mp: MutPtr<Malloc>) i32 {
    seeds: [string_view] := ["g := g", "a := b\nb := a", "A*: { b: B } B*: { a: A }", "f = () i32 {", "f = () i32 { 0 .match ({ 1 => 2", "T*: { x: i32 } T.impl(Tr, { m = () void {", "f = () i32 { x := 5  x[0 ", "f = () i32 { s := [1,2]  s[0 = 3 }", "Foo<", "f<T> = (x: T) T { f(x) }", "a<T> = (x: T) T { b(x) }  b<T> = (x: T) T { a(x) }  test* = () i32 { a(1) }", "Box<T>: { next: Box<Box<T>> }  use* = (b: Box<i32>) i32 { 0 }", "P<T>: { a: T, n: P<P<T>> }  test* = () i32 { 0 }  use* = (b: P<i32>) i32 { 0 }"]    // self-referential global init
    // mutually-referential globals
    // struct A<->B by value
    // unterminated block
    // unterminated match arms
    // unterminated impl body
    // `[` never closed
    // idxset `[` scan past EOF
    // `<` with no closing `>`
    // self-recursive generic -> inliner
    mp.fz_batch(seeds, seeds.len)
}
// ── category entry: run every phase, sum crashes (a non-zero result is a REAL bug to report) ──────
harness_fuzz_run* = () i32 {
    m := Malloc(_: 0)
    mp := m.addr()
    r := seed(FZ_SEED)
    rp := r.addr()
    // a grammar-flavoured alphabet (mirrors _fuzz_campaign.ALPHA): keywords, punctuation, names.
    toks: [string_view] := ["test*", "f*", "=", "(", ")", "i32", "i64", "bool", "str", "{", "}", "x", "y", "p", ":=", ":", "5", "0", "1", ".match", "[", "]", "+", "-", "*", "/", "P", "C", "T", "f", "<", ">", "2", "return", "_", "=>", ",", ".", ".Some", ".None", "|", "impl", "Drop", "loop", "addr", "slice", "void", "Ptr", "MutPtr", "&&", "||", "==", "!=", "g", "h", ".Ok", ".Err", "@while", "sizeof", "use*", "Box", "n:"]
    nt: i64 := toks.len
    out("fuzz: crash-resistance over generated malformed inputs\n")
    out("fuzz seeds (crash-class regressions)\n")
    sf := mp.fz_seed_phase()
    out("\nfuzz token-soup (100)\n")
    pf := mp.fz_soup_phase(toks, nt, rp, 100)
    out("\nfuzz byte-noise (60)\n")
    nf := mp.fz_noise_phase(rp, 60)
    out("\nfuzz targeted recursion-bombs (60)\n")
    tf := mp.fz_target_phase(rp, 60)
    out("\n")
    // report via the standard suite line (one synthetic bool: "no crashes found").
    total := sf + pf + nf + tf
    run_suite("fuzz (no crash/hang found)", [total == 0])
}
