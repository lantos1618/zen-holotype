// compiler.check_resolve — the resolve/lowering walk (pure move from compiler.check).
// Rebuilds each expr/stmt/decl with resolved enum names, constructor types, UFCS dispatch,
// generic instances, variadic collection, and or_return lowering. One-way dependency on
// compiler.check (Env/infer/inline helpers); the check↔check_* cycles resolve via `*` exports.
{ ArmData, AssignData, BinData, CallData, Decl, Expr, Field, FieldInit, Func, GenStructDecl,
  GenericData, GlobalData, LetData, LoopData, MakeStructData, MatchData, MemberData, Param,
  SliceData, Stmt, Ty } = compiler.ast.ast_types
{ arith_rty, arm_at, arrow_at, bin, bin_at, bin_rty, block, call, call_at, cbuf, cond_oa, dfunc,
  dglobal, dglobal_tl, eindex, eloop, ematch, ematchp, finit, flit, gstr_append, gstr_finish,
  gstr_string, is_expr_null, lit, member, member_at, mkenumg, mkstruct_at, mkstructg_at, mktag,
  mktagg, narrow_op, no_tys, sassign_at, sexpr, sidxset_at, sif, slet, slett, slett_at, slett_atm,
  slit, sret, subst_ty_in, swhile, ti32, tvoid, vref } = compiler.genc
{ mangle_semantic_in, mangle_str_in } = compiler.mangle
{ gstr_int, is_prim_width, map_slice, one_stmt, param_names_has, slice_any } = compiler.astops
{ Malloc } = std.mem.alloc
{ is_empty, view } = std.text.str
{ getenv, write } = std.c.libc
{ clock_ms } = std.sys.os
{ lift_lambdas } = compiler.passes.lift
{ orx_count, orx_rw, orx_rw_stmt, orx_stmt_count } = compiler.passes.orreturn
{ clos_call_rewrite, clos_local_call_name } = compiler.passes.closures
{ unify_ty } = compiler.check_infer
{ reflect_fields } = compiler.passes.subst
{ eq_impl_provides, eq_struct_fields_ok } = compiler.validate.kinds
{ LitVal, fold_wide_int } = compiler.validate.util
{ inline_decl, lower_closures, mono_close, no_inline_gen_f } = compiler.check_inline
{ desugar_method_calls, expand_defaults, fill_enum_defaults } = compiler.check_desugar
{ lower_stmt_expr, subj_payload, subj_tag, tag_const } = compiler.check_lower
{ DeclIndex, Env, arm_env, bin_res_ty, bind_fnret, build_decl_index, cebuf, cenode, dispatch_recv,
  ctor_payload_exp, dispatch_recv_name, elem_of, empty_params, enum_inst_mk, enum_inst_tag,
  enum_name, extend_env, fnret_of, gen_variant_payload, gsubst, is_str_t, is_void_ty, local_name_at,
  no_stmts, params_env, pointee_of, recall, ty_is_ptr, vcons } = compiler.check
// Stamp enum constructors with their concrete generic instance when needed.
resolve_mkenum = (
    a: MutPtr<Malloc>,
    env: Env,
    ety: StringView,
    emty: StringView,
    etargs: [Ty],
    variant: StringView,
    payload: Ptr<Expr>,
) Ptr<Expr> {
    p = a.resolve_expr(env.with_exp(env.ctor_payload_exp(ety, etargs, variant)), payload)
    (etargs.len > 0).match ({
        true  => {
            p2 = a.restamp_enum_payload(env, ety, etargs, variant, p)
            a.cenode(mkenumg(ety, emty, etargs, variant, p2))
        },
        false => (ety == "").match ({
            true  => a.resolve_mkenum_fresh(env, variant, p),
            false => a.cenode(mkenumg(ety, emty, no_tys(), variant, p)),
        }),
    })
}
resolve_mkenum_fresh = (a: MutPtr<Malloc>, env: Env, variant: StringView, p: Ptr<Expr>) Ptr<Expr> {
    inst = env.enum_inst_mk(variant, p)
    p2 = a.restamp_enum_payload(env, inst.base, inst.targs, variant, p)
    a.cenode(mkenumg(inst.base, inst.mty, inst.targs, variant, p2))
}
// A multi-field variant payload lowers to a positional anon struct whose tparams mirror the enum's.
// resolve_genlit_bare infers the anon instance from the literal init types (integer literals → i32),
// which can disagree with the enum instance (Tree<i64>, Two<i32,i64>). Re-stamp the payload
// MakeStruct with the monomorphized payload type from the enum's tparam→arg map — same rebuild as
// compiler.mono.mono_payload, but on the constructor side so collect_ty discovers one instance.
restamp_enum_payload = (
    a: MutPtr<Malloc>,
    env: Env,
    ename: StringView,
    etargs: [Ty],
    variant: StringView,
    p: Ptr<Expr>,
) Ptr<Expr> {
    load(p).match ({
        .MakeStruct(sd) => env.enum_payload_mono_ty(ename, etargs, variant).match ({
            .Generic(cg) => (cg.name == sd.ty).match ({
                true  => a.cenode(mkstructg_at(sd.ty, cg.mangled, cg.args, sd.inits, sd.pos)),
                false => p,
            }),
            _            => p,
        }),
        _               => p,
    })
}
resolve_mktag = (
    a: MutPtr<Malloc>,
    env: Env,
    ety: StringView,
    emty: StringView,
    etargs: [Ty],
    variant: StringView,
) Ptr<Expr> {
    (etargs.len > 0).match ({
        true  => a.emit_tag_or_default(env, ety, emty, etargs, variant),
        false => (ety == "").match ({
            true  => a.resolve_mktag_fresh(env, variant),
            false => a.emit_tag_or_default(env, ety, emty, no_tys(), variant),
        }),
    })
}
resolve_mktag_fresh = (a: MutPtr<Malloc>, env: Env, variant: StringView) Ptr<Expr> {
    inst = env.enum_inst_tag(variant)
    a.emit_tag_or_default(env, inst.base, inst.mty, inst.targs, variant)
}
// A zero-arg `.Name` / `Type.Name`: if the variant declares a default (`Name = expr`), build the
// payload constructor with the baked-in constant; otherwise the bare tag.
emit_tag_or_default = (
    a: MutPtr<Malloc>,
    env: Env,
    base: StringView,
    mty: StringView,
    targs: [Ty],
    variant: StringView,
) Ptr<Expr> {
    def = env.didx.idx_variant_default(env.decls, base, variant)
    def.is_expr_null().match ({
        true  => a.cenode(mktagg(base, mty, targs, variant)),
        false => {
            p = a.resolve_expr(env.clr_exp(), def)
            p2 = a.restamp_enum_payload(env, base, targs, variant, p)
            a.cenode(mkenumg(base, mty, targs, variant, p2))
        },
    })
}
// Keep concrete slice element types across re-resolve.
keep_elem = (env: Env, existing: Ty, seq: Ptr<Expr>) Ty {
    existing.is_void_ty().then({ env.infer_expr(seq).elem_of() }, { existing })
}
// For index assignment, fall back to the stored value's type when the sequence elem is unknown.
set_elem = (env: Env, existing: Ty, seq: Ptr<Expr>, value: Ptr<Expr>) Ty {
    e = env.keep_elem(existing, seq)
    e.is_void_ty().then({ env.infer_expr(value) }, { e })
}
// A written targ that is just the struct's own type-param name (e.g. literal `A`) needs inference.
is_placeholder_targ = (tparams: [Param], t: Ty) bool {
    t.match ({
        .Named(n) => tparams.param_names_has(n),
        _         => false,
    })
}
init_field_ty = (env: Env, inits: [FieldInit], fname: StringView) Ty {
    found ::= tvoid()
    inits.loop((h, i, fi) {
        found = (fi.name == fname).then({ env.infer_expr(fi.value) }, { found })
    })
    found
}
// Unify each declared field type against its init's inferred type to recover one tparam's concrete arg.
struct_targ_one = (env: Env, fields: [Field], inits: [FieldInit], tp: StringView) Ty {
    found ::= tvoid()
    fields.loop((h, i, f) {
        found = found.is_void_ty().match ({
            true  => f.ty.unify_ty(env.init_field_ty(inits, f.name), tp),
            false => found,
        })
    })
    found
}
pick_targ = (inf: Ty, fallback: Ty) Ty { inf.is_void_ty().then({ fallback }, { inf }) }
infer_struct_targs = (
    a: MutPtr<Malloc>,
    env: Env,
    gsd: GenStructDecl,
    written: [Ty],
    inits: [FieldInit],
) [Ty] {
    buf ::= cbuf<Ty>(a, written.len)
    written.loop((h, i, t) {
        buf[i] = (i < gsd.tparams.len && gsd.tparams.is_placeholder_targ(t)).match ({
            true  => env.struct_targ_one(gsd.fields, inits, gsd.tparams[i].name).pick_targ(t),
            false => t,
        })
    })
    buf
}
genlit_g = (a: MutPtr<Malloc>, env: Env, sd: MakeStructData, inits: [FieldInit]) Ptr<Expr> {
    nt = a.infer_struct_targs(env, env.env_gstruct(sd.ty), sd.targs, inits)
    a.cenode(mkstructg_at(sd.ty, a.mangle_str_in(sd.ty, nt), nt, inits, sd.pos))
}
// the expected type's args, when it names generic struct `base` — the authoritative source for a bare
// literal's type args under a `st: Store<AppState> := …` annotation (or any expected-type position).
exp_targs_for = (exp: Ty, base: StringView) [Ty] {
    exp.match ({
        .Generic(g) => (g.name == base).then({ g.args }, { no_tys() }),
        _           => no_tys(),
    })
}
// Type args for a BARE generic-struct literal (no explicit `<…>`): the expected/annotation type wins,
// else infer each tparam by unifying its declared field types against the supplied field-value types.
bare_struct_targs = (a: MutPtr<Malloc>, env: Env, gsd: GenStructDecl, inits: [FieldInit]) [Ty] {
    exp_args = env.exp.exp_targs_for(gsd.name)
    (exp_args.len == gsd.tparams.len).match ({
        true  => exp_args,
        false => map_slice(a, gsd.tparams, (tp) { env.struct_targ_one(gsd.fields, inits, tp.name) }),
    })
}
// A bare `Store(state: …)` literal of a GENERIC struct carries no type args; infer them so the instance
// is mangled (mty) and discovered/emitted by compiler.mono, exactly like the explicit `Store<…>(…)` form.
// A bare literal of a plain (non-generic) struct is unchanged.
resolve_genlit_bare = (
    a: MutPtr<Malloc>,
    env: Env,
    sd: MakeStructData,
    inits: [FieldInit],
) Ptr<Expr> {
    gsd = env.env_gstruct(sd.ty)
    is_empty(gsd.name).match ({
        true  => a.cenode(mkstructg_at(sd.ty, sd.mty, sd.targs, inits, sd.pos)),
        false => {
            nt = a.bare_struct_targs(env, gsd, inits)
            a.cenode(mkstructg_at(sd.ty, a.mangle_str_in(sd.ty, nt), nt, inits, sd.pos))
        },
    })
}
resolve_genlit = (a: MutPtr<Malloc>, env: Env, sd: MakeStructData) Ptr<Expr> {
    inits = a.resolve_inits(env.clr_exp(), sd, sd.inits)
    (sd.targs.len > 0).match ({
        true  => a.genlit_g(env, sd, inits),
        false => a.resolve_genlit_bare(env, sd, inits),
    })
}
// Rebuild expressions with resolved enum, constructor, member, and loop metadata.
// Entry hook: an expression that still holds unconditional-position `.or_return()` calls (only
// possible in CONDITIONALLY-evaluated positions — cond/match branch values, `&&`/`||` right
// operands — since fill_orx already hoisted every statement-level occurrence) is wrapped into a
// value block scoped to that branch. See the "or_return in EXPRESSION position" section below.
resolve_expr = (a: MutPtr<Malloc>, env: Env, e: Ptr<Expr>) Ptr<Expr> {
    (e.orx_count() > 0).then({ a.resolve_orx(env, e) }, { a.resolve_expr_plain(env, e) })
}
resolve_expr_plain = (a: MutPtr<Malloc>, env: Env, e: Ptr<Expr>) Ptr<Expr> {
    load(e).match ({
        .Match(m)       => a.resolve_match(env, m),
        .MakeEnum(mk)   => a.resolve_mkenum(env, mk.ty, mk.mty, mk.targs, mk.variant, mk.payload),
        .Tag(t)         => a.resolve_mktag(env, t.ty, t.mty, t.targs, t.variant),
        .Bin(b)         => a.resolve_bin(env, b),
        .Cond(c)        => a.cenode(cond_oa(a.resolve_expr(env.clr_exp(), c.c), a.resolve_expr(env, c.t), a.resolve_expr(env, c.e), c.oa)),
        .Call(c)        => a.resolve_call(env, c),
        .Member(mm)     => a.resolve_member(env, mm),
        // An Arrow (a pass-1 Member→Arrow conversion) must keep resolving its OBJECT on later passes:
        // a generic call inside it is only rewritten to its mono instance by the FINAL resolve (the
        // instance decls don't exist earlier), and with no Arrow case that call stayed a bare
        // template name (`counter.actor().n` emitted an undefined C symbol).
        .Arrow(ar)      => a.cenode(arrow_at(a.resolve_expr(env.clr_exp(), ar.obj), ar.field, ar.pos)),
        .MakeStruct(sd) => a.resolve_genlit(env, sd),
        .Index(ix)      => a.cenode(eindex(a.resolve_expr(env.clr_exp(), ix.seq), a.resolve_expr(env.clr_exp(), ix.idx), env.keep_elem(ix.elem, ix.seq))),
        .Loop(l)        => a.resolve_loop(env, l),
        .SliceLit(sd)   => a.resolve_slicelit(env, sd),
        .Block(b)       => a.cenode(block(a.resolve_value_body(env, b.stmts))),
        _               => e,
    })
}
// Element type precedence: expected > already-set > inferred-from-items. The parser writes every
// source literal as `slit(tvoid(), …)`, so a non-void `sd.elem` was put there by a lowering pass
// (collect_varargs, subst, lift) and must survive re-resolution. resolve_module resolves several
// times, and the expected type for an already-collected variadic slot is the ELEMENT type T — whose
// `elem_of()` is void — so re-inferring narrows `...i64` built from bare int literals back to `[i32]`
// on the second pass, and the callee then reads i64s out of i32 slots.
resolve_slicelit = (a: MutPtr<Malloc>, env: Env, sd: SliceData) Ptr<Expr> {
    keep = env.exp.elem_of().is_void_ty() && sd.elem.is_void_ty() == false
    et = keep.then({ sd.elem }, { env.sl_elem_exp(sd.items) })
    a.cenode(slit(et, a.resolve_args(env.with_exp(et), sd.items)))
}
// Field access auto-derefs pointer receivers.
resolve_member = (a: MutPtr<Malloc>, env: Env, mm: MemberData) Ptr<Expr> {
    obj = a.resolve_expr(env.clr_exp(), mm.obj)
    env.infer_expr(mm.obj).ty_is_ptr().match ({
        true  => a.cenode(arrow_at(obj, mm.field, mm.pos)),
        false => a.cenode(member_at(obj, mm.field, mm.pos)),
    })
}
// Resolve foreach body with index and element bindings.
resolve_loop = (a: MutPtr<Malloc>, env: Env, l: LoopData) Ptr<Expr> {
    et = env.keep_elem(l.elemTy, l.seq)
    env2 = Env(
        vars: a.vcons(l.elem, et, a.vcons(l.idx, ti32(), env.vars)),
        decls: env.decls,
        didx: env.didx,
        exp: env.exp,
        a: env.a,
    )
    a.cenode(eloop(a.resolve_expr(env.clr_exp(), l.seq), l.idx, l.elem, et, a.resolve_body(env2, l.body), l.h))
}
fields_ty_of = (fields: [Field], fname: StringView) Ty {
    found ::= tvoid()
    fields.loop((h, i, f) {
        found = (f.name == fname).then({ f.ty }, { found })
    })
    found
}
// The declared type of the field being initialized is the expected type for its value. Without it a
// bare slice literal in a field slot keeps the i32 literal default: `Holder(xs: [1, 2, 3])` against a
// declared `xs: [i64]` emits a 12-byte `int32_t` backing array with `.len = 3`, while every reader
// indexes it with `sizeof(int64_t)` — so the bounds check passes (the length IS 3) and index 2 reads
// past the end of the block. A generic struct's field type may name a tparam: substitute the WRITTEN
// type args when the literal has any, and otherwise leave it void, because a BARE generic literal
// infers its targs from these very inits and pinning an expected type here would be circular.
init_exp_ty = (a: MutPtr<Malloc>, env: Env, sd: MakeStructData, fname: StringView) Ty {
    plain = env.didx.idx_struct_field(env.decls, sd.ty, fname)
    plain.is_void_ty().match ({
        true  => (sd.targs.len > 0).match ({
            true  => {
                gsd = env.env_gstruct(sd.ty)
                a.subst_ty_in(gsd.tparams, sd.targs, gsd.fields.fields_ty_of(fname))
            },
            false => tvoid(),
        }),
        false => plain,
    })
}
resolve_inits = (a: MutPtr<Malloc>, env: Env, sd: MakeStructData, inits: [FieldInit]) [FieldInit] {
    written = map_slice(a, inits, (fi) {
        finit(fi.name, a.resolve_expr(env.with_exp(a.init_exp_ty(env, sd, fi.name)), fi.value))
    })
    a.fill_field_defaults(env, sd, written)
}
// ── FIELD DEFAULTS: `Sum*: { total: i64 = 0 }` ──────────────────────────────────────────────────
// A literal that OMITS a field declaring a default gets that constant; a field with no default
// keeps C's designated-initializer zero-fill, so every literal written before defaults existed is
// byte-for-byte unchanged. The written inits come first and WIN — the appended slots only cover
// names the literal never mentions — which also makes re-resolution idempotent (resolve_module
// resolves several times; the later passes find nothing missing).
struct_decl_fields = (env: Env, sd: MakeStructData) [Field] {
    plain = env.didx.idx_struct_fields(env.decls, sd.ty)
    (plain.len > 0).then({ plain }, { env.env_gstruct(sd.ty).fields })
}
inits_have = (inits: [FieldInit], nm: StringView) bool {
    found ::= false
    inits.loop((h, i, fi) {
        found = found || fi.name == nm
    })
    found
}
dflt_is_missing = (f: Field, inits: [FieldInit]) bool {
    is_expr_null(f.dflt) == false && inits.inits_have(f.name) == false
}
dflt_missing_count = (fields: [Field], inits: [FieldInit]) i32 {
    n ::= 0
    fields.loop((h, i, f) {
        f.dflt_is_missing(inits).then({
            n = n + 1
        })
    })
    n
}
fill_field_defaults = (
    a: MutPtr<Malloc>,
    env: Env,
    sd: MakeStructData,
    inits: [FieldInit],
) [FieldInit] {
    fields = env.struct_decl_fields(sd)
    n = fields.dflt_missing_count(inits)
    (n == 0).match ({
        true  => inits,
        false => {
            buf ::= cbuf<FieldInit>(a, inits.len + n)
            j ::= 0
            inits.loop((h, i, fi) {
                buf[j] = fi
                j = j + 1
            })
            fields.loop((h, i, f) {
                f.dflt_is_missing(inits).then({
                    buf[j] = finit(f.name, a.resolve_expr(env.with_exp(f.ty), f.dflt))
                    j = j + 1
                })
            })
            buf
        },
    })
}
// `Sum()` — a zero-argument call naming a STRUCT (with no function of that name) is the EMPTY struct
// literal: every defaulted field takes its constant, the rest zero-fill. `Sum(f: v)` is already a
// literal by the parser's `field:` shape, which an empty `()` cannot show, so only this form needs
// the declaration table to tell a constructor from a call.
is_bare_struct_lit = (env: Env, nm: StringView) bool {
    env.didx.struct_idx.get(nm, 0 - 1) >= 0 && is_empty(env.env_func(nm).name)
}
no_field_inits = () [FieldInit] { slice(null_ptr(), 0) }
enum_payload_mono_ty = (env: Env, ename: StringView, etargs: [Ty], variant: StringView) Ty {
    env
        .env_genenum(ename)
        .gen_variant_payload(variant)
        .gsubst(env, GenericData(
            name: ename,
            args: etargs,
            mangled: env.a.mangle_str_in(ename, etargs),
        ))
}
// Fill match enum name and choose pointer/value tag access.
resolve_match = (a: MutPtr<Malloc>, env: Env, m: MatchData) Ptr<Expr> {
    subj2 = a.resolve_expr(env.clr_exp(), m.subj)
    t = env.infer_expr(subj2)
    en = t.enum_name()
    arms = a.resolve_arms(env, t, m.arms)
    t.ty_is_ptr().match ({
        true  => a.cenode(ematchp(subj2, en, arms)),
        false => a.cenode(ematch(subj2, en, arms)),
    })
}
resolve_args = (a: MutPtr<Malloc>, env: Env, args: [Expr]) [Expr] {
    buf ::= a.cebuf(args.len)
    args.loop((h, i, ar) {
        buf[i] = load(a.resolve_expr(env, ar.addr()))
    })
    buf
}
arg_exp = (ps: [Param], i: i32) Ty { (i < ps.len).then({ ps[i].ty }, { tvoid() }) }
str_eq_args = (a: MutPtr<Malloc>, lhs: Ptr<Expr>, rhs: Ptr<Expr>) [Expr] {
    buf ::= a.cebuf(2)
    buf[0] = load(lhs)
    buf[1] = load(rhs)
    buf
}
// An enum VALUE is a tagged union; raw C `==` on the struct is invalid. `==`/`!=` between two enum
// VALUES of the same type lower to a TAG comparison (concrete + generic-instance enums). A POINTER to
// an enum is NOT included: `p == null_ptr()` / `p1 == p2` are pointer-identity comparisons (valid C),
// not value equality — including Ptr here mis-lowered `e == null_ptr()` (e: Ptr<Expr>, Expr an enum)
// to `e->tag == …`. NOTE: tag-only compares the active VARIANT, not the payload — `Run(1) == Run(2)`
// is `true`; payloadless / state-style enums (the common case) compare exactly; full structural
// (payload) equality is a deliberate follow-up.
is_enum_ty = (env: Env, t: Ty) bool {
    t.match ({
        .Named(n)   => env.didx.enum_idx.get(n, 0 - 1) >= 0,
        .Generic(g) => is_empty(env.env_genenum(g.name).name) == false,
        _           => false,
    })
}
resolve_bin = (a: MutPtr<Malloc>, env: Env, b: BinData) Ptr<Expr> {
    // A constant binop that overflows i32 becomes the `.Int` it denotes, so every consumer — the
    // width inference behind a `:=` slot most of all — reads the VALUE instead of the leftmost
    // operand's width. See fold_wide_int: in-range constant math is left exactly as written.
    wide = fold_wide_int(b.op, b.lhs, b.rhs)
    wide.ok.then({
        return a.cenode(lit(wide.v))
    })
    lhs = a.resolve_expr(env.clr_exp(), b.lhs)
    rhs = a.resolve_expr(env.clr_exp(), b.rhs)
    cmp = b.op == "==" || b.op == "!="
    lty = env.infer_expr(lhs)
    (cmp && lty.is_str_t() && env.infer_expr(rhs).is_str_t()).match ({
        true  => a.cenode(call((b.op == "==").then({ "__str_eq" }, { "__str_ne" }), a.str_eq_args(lhs, rhs))),
        false => (cmp && env.is_enum_ty(lty)).match ({
            true  => a.cenode(bin_at(b.op, a.subj_tag(lhs, lty.ty_is_ptr()), a.subj_tag(rhs, lty.ty_is_ptr()), b.pos)),
            false => (cmp
                && env.is_struct_val_ty(lty)
                && env.infer_expr(rhs).ty_eq(lty)
                && (env.eq_impl_provides(lty) || env.eq_struct_fields_ok(lty))).match ({
                true  => a.resolve_struct_eq(env, b.op, lty, lhs, rhs, b.pos),
                false => a.resolve_arith(env, b.op, lty, lhs, rhs, b.pos),
            }),
        }),
    })
}
// ── struct `==` / `!=`: values of the SAME struct type compare structurally ────────────────────────
// An `eq` method provided by an impl on the type WINS (dispatch_recv — same index trait calls use);
// otherwise DERIVE a per-field `==` fold from the fields (reflection), ONE level deep: the rebuilt
// fold re-enters resolve_expr, so a string field lowers to __str_eq, an enum field to a tag compare,
// and a struct field back through THIS arm — full recursion with no extra machinery. A POINTER to a
// struct stays C pointer identity (mirrors the enum-tag rule above). Non-Var subjects are bound to
// temps ONCE so a side-effecting operand (`mk() == mk()`) runs once, not once per field.
is_struct_val_ty = (env: Env, t: Ty) bool {
    t.match ({
        .Named(n)   => env.didx.struct_idx.get(n, 0 - 1) >= 0,
        .Generic(g) => env.didx.genstruct_idx.get(g.name, 0 - 1) >= 0,
        _           => false,
    })
}
seq_subject = (a: MutPtr<Malloc>, env: Env, e: Ptr<Expr>, k: i64, pos: i32) SeqBind {
    load(e).match ({
        .Var(v) => SeqBind(
            bind: sexpr(a.cenode(vref_at("true", pos))),
            subj: e,
            bound: false,
        ),
        _       => {
            nm = a.local_name_at("__seq", env.vars, k)
            SeqBind(
                bind: slett_at(nm, tvoid(), e, pos),
                subj: a.cenode(vref_at(nm, pos)),
                bound: true,
            )
        },
    })
}
SeqBind: {
    bind: Stmt,
    subj: Ptr<Expr>,
    bound: bool,
}
seq_fold = (a: MutPtr<Malloc>, flds: [Field], lx: Ptr<Expr>, rx: Ptr<Expr>, pos: i32) Ptr<Expr> {
    acc ::= a.cenode(vref_at("true", pos))
    flds.loop((h, i, f) {
        acc = a.cenode(bin_at("&&", acc, a.cenode(bin_at("==", a.cenode(member_at(lx, f.name, pos)), a.cenode(member_at(rx, f.name, pos)), pos)), pos))
    })
    acc
}
seq_neg = (a: MutPtr<Malloc>, op: StringView, e: Ptr<Expr>, pos: i32) Ptr<Expr> {
    (op == "!=").then({ a.cenode(bin_at("==", e, a.cenode(vref_at("false", pos)), pos)) }, { e })
}
resolve_struct_eq = (
    a: MutPtr<Malloc>,
    env: Env,
    op: StringView,
    lty: Ty,
    lhs: Ptr<Expr>,
    rhs: Ptr<Expr>,
    pos: i32,
) Ptr<Expr> {
    tyname = lty.dispatch_recv_name()
    dn = (env.didx.impl_idx.get(tyname, 0 - 1) < 0).match ({
        true  => "eq",
        false => a.dispatch_recv(env.decls, env.didx, "eq", tyname),
    })
    (dn == "eq").match ({
        true  => {
            lb = a.seq_subject(env, lhs, 91, pos)
            rb = a.seq_subject(env, rhs, 92, pos)
            fold = a.seq_neg(op, a.seq_fold(reflect_fields(a, env.decls, env.didx, lty), lb.subj, rb.subj, pos), pos)
            out = (lb.bound || rb.bound).match ({
                true  => {
                    stmts ::= cbuf<Stmt>(a, 3)
                    stmts[0] = lb.bind
                    stmts[1] = rb.bind
                    stmts[2] = sexpr(fold)
                    a.cenode(block(stmts))
                },
                false => fold,
            })
            a.resolve_expr(env, out)
        },
        false => a.resolve_expr(env, a.seq_neg(op, a.cenode(call(dn, a.str_eq_args(lhs, rhs))), pos)),
    })
}
// FLOAT DIVISION is retagged `/.` so a backend can tell it from integer `/`: C already dispatches at
// compile time via `_Generic` (IEEE for double, guarded for int), but the JS backend erases types, so
// without this marker it would route `0.0/0.0` through the integer div-by-zero guard and spuriously
// panic. `/.` says "IEEE division, no zero guard". Fires when either operand is f64 (a numeric literal
// on the other side adapts to f64). All other arithmetic falls through to the `-f64` negation fixup.
resolve_arith = (
    a: MutPtr<Malloc>,
    env: Env,
    op: StringView,
    lty: Ty,
    lhs: Ptr<Expr>,
    rhs: Ptr<Expr>,
    p: i32,
) Ptr<Expr> {
    (op == "/" && (lty.is_f64_ty() || env.infer_expr(rhs).is_f64_ty())).match ({
        true  => a.cenode(bin_at("/.", lhs, rhs, p)),
        false => a.resolve_f64_neg(env, op, lty, lhs, rhs, p),
    })
}
// Prefix `-f64` parses as `0 - x`; rewrite that zero to `0.0`.
is_int_zero = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Int(n) => n == 0,
        _       => false,
    })
}
resolve_f64_neg = (
    a: MutPtr<Malloc>,
    env: Env,
    op: StringView,
    lty: Ty,
    lhs: Ptr<Expr>,
    rhs: Ptr<Expr>,
    p: i32,
) Ptr<Expr> {
    (op == "-" && lhs.is_int_zero() && env.infer_expr(rhs).is_f64_ty()).match ({
        true  => a.cenode(bin_at(op, a.cenode(flit("0.0")), rhs, p)),
        false => a.cenode(bin_rty(op, lhs, rhs, p, env.narrow_rty(op, lty, lhs, rhs))),
    })
}
// The width genc must re-truncate this binop to, or Void. Uses the binop's OWN result type, so
// `(i32) * 3` truncates to i32 while `(i32) * (i64)` stays 64-bit. Guarded by narrow_op so a
// non-arithmetic binop never pays to infer its rhs.
narrow_rty = (env: Env, op: StringView, lty: Ty, lhs: Ptr<Expr>, rhs: Ptr<Expr>) Ty {
    narrow_op(op).then({ arith_rty(op, env.bin_res_ty(lty, lhs, rhs)) }, { tvoid() })
}
// ── variadic params: a trailing `...T` param collects the surplus call args into a `[T]` ──
// Detect the marker (set by the parser), the element type T, and the per-arg expected type
// (T for a collected element). Lowering happens AFTER arg resolution, in resolve_call.
last_variadic = (ps: [Param]) bool { (ps.len > 0).then({ ps[ps.len - 1].variadic }, { false }) }
vararg_elem = (t: Ty) Ty {
    t.match ({
        .Slice(e) => load(e.pointee),
        _         => t,
    })
}
// expected type for arg i: the element type T for any arg in a variadic param's collected tail.
arg_exp_v* = (ps: [Param], i: i32) Ty {
    last_variadic(ps).match ({
        true  => {
            fixed = ps.len - 1
            (i < fixed).then({ ps.arg_exp(i) }, { ps[fixed].ty.vararg_elem() })
        },
        false => ps.arg_exp(i),
    })
}
// resolve_module re-runs resolve_decl several times (resolve/inline passes), so collection must be
// IDEMPOTENT: a call already lowered has exactly param-count args with a SliceLit in the variadic
// slot. Re-collecting it would nest `[[…]]`. Detect that shape and leave it untouched.
is_slicelit_expr = (e: Expr) bool {
    e.match ({
        .SliceLit(s) => true,
        _            => false,
    })
}
// The same test doubles as SPREAD: a value of the collected `[T]` type passed in the variadic slot is
// forwarded as-is instead of being wrapped one level deeper. That keeps the pre-varargs
// `formatln(t, [arg_int(n)])` spelling working after `args` becomes `...Arg`, and lets a variadic fn
// forward its own collected slice to another (`formatln` -> `format`). The two readings never collide:
// a `[T]` can only be an ELEMENT of a `...T` list when T = [T], which no type satisfies.
already_collected = (env: Env, ps: [Param], args: [Expr]) bool {
    (args.len == ps.len && args.len > 0).match ({
        true  => {
            last = args[args.len - 1]
            is_slicelit_expr(last) || env.infer_expr(last.addr()).fits(ps[ps.len - 1].ty)
        },
        false => false,
    })
}
// ── implicit variant wrapping in the variadic tail ───────────────────────────
// `formatln("{} {}", n, s)` against `args: ...Arg` wraps each surplus argument as the `Arg` variant
// that carries its static type — `.Int(n)`, `.Str(s)` — so no call site spells `arg_int`/`arg_str`.
// It fires only when the element type is a concrete enum, the argument is not already that enum, and
// EXACTLY ONE variant's payload accepts the argument's type under the ordinary `fits` lattice (so an
// i32 widens into `.Int(i64)` and a string literal lands in `.Str(StringView)`). Zero candidates — a
// struct, say — or several leave the argument alone and the normal arg-type error stands.
vararg_variant = (env: Env, ename: StringView, got: Ty) StringView {
    hit ::= ""
    n :: i32 = 0
    env.didx.idx_enum_variants(env.decls, ename).loop((h, i, v) {
        got.fits(v.payload).then({
            hit = v.name
            n = n + 1
        })
    })
    (n == 1).then({ hit }, { "" })
}
vararg_wrap = (a: MutPtr<Malloc>, env: Env, ps: [Param], i: i32, e: Expr) Expr {
    (last_variadic(ps) && i >= ps.len - 1).match ({
        true  => {
            want = ps[ps.len - 1].ty.vararg_elem()
            ename = want.enum_name()
            got = env.infer_expr(e.addr())
            // `got.fits(collected)` is the SPREAD arm of already_collected: skip it here too, so a
            // re-resolve pass (or an explicit `[T]`) is never wrapped as one more element — which an
            // enum carrying a `[Self]` payload would otherwise accept.
            (ename == "" || got.ty_eq(want) || got.is_void_ty() || got.fits(ps[ps.len - 1].ty)).match ({
                true  => e,
                false => env.vararg_variant(ename, got).match_wrap(a, ename, e),
            })
        },
        false => e,
    })
}
match_wrap = (variant: StringView, a: MutPtr<Malloc>, ename: StringView, e: Expr) Expr {
    (variant == "").match ({
        true  => e,
        false => load(a.cenode(mkenumg(ename, ename, no_tys(), variant, a.cenode(e)))),
    })
}
// rewrite `f(a, b, c)` with `f = (x: X, ys: ...Y)` into `f(a, [b, c])`: surplus args → one SliceLit.
collect_varargs = (a: MutPtr<Malloc>, env: Env, ps: [Param], args: [Expr]) [Expr] {
    (last_variadic(ps) && env.already_collected(ps, args) == false).match ({
        true  => {
            fixed = ps.len - 1
            (args.len < fixed).match ({
                true  => args,
                false => {
                    elem = ps[fixed].ty.vararg_elem()    // too few args: let the validator report arity
                    vbuf ::= a.cebuf(args.len - fixed)
                    args.loop((h, j, e) {
                        (j >= fixed).then({
                            vbuf[j - fixed] = e
                        })
                    })
                    out ::= a.cebuf(fixed + 1)
                    args.loop((h, j, e) {
                        (j < fixed).then({
                            out[j] = e
                        })
                    })
                    out[fixed] = slit(elem, vbuf)
                    out
                },
            })
        },
        false => args,
    })
}
// The expected type for argument `i` of a (generic or plain) call. For a generic fn, the param type may
// name a tparam (`x: T`); substituting the inferred type args gives the CONCRETE expected type, which
// lets a bare variant ctor argument (`.Num(n)` for a `Vec<Tok>.push`) resolve against the right enum
// instead of guessing by variant name. FnT (lambda) params keep the void expected-type they had before
// (they are spliced/inlined later), so existing template-lambda resolution is unchanged. A variadic
// param's collected args take element type T (via arg_exp_v) before any tparam substitution.
// `b.op(args)` desugars to `op(b, args)`; when `op` names no function but IS a function-VALUE field of
// b's type (FnT), this is an INDIRECT call through that field (M1 closures). Detect it: the callee is
// not a known/dispatched function and arg0 has an FnT field of that name.
fnfield_ty = (env: Env, recv: Ptr<Expr>, field: StringView) Ty {
    env.infer_expr(env.a.cenode(member(recv, field)))
}
is_fn_field_call = (env: Env, dn: StringView, args: [Expr]) bool {
    (env.env_func(dn).name == "" && args.len > 0).match ({
        true  => env.fnfield_ty(args[0].addr(), dn).is_fnt(),
        false => false,
    })
}
// rewrite `op(b, x, y)` -> `({ __zclos_recv := b.op   __zclos_recv(x, y) })`: bind the field value to a
// local, then call the local. This reuses the existing local-fn-value call path (C `__auto_type` +
// native indirect call) — no new genc call node. Block scoping keeps the fixed temp name nesting-safe.
rewrite_fn_field_call = (a: MutPtr<Malloc>, env: Env, field: StringView, buf: [Expr]) Ptr<Expr> {
    rest ::= a.cebuf(buf.len - 1)
    buf.loop((h, i, e) {
        (i > 0).then({
            rest[i - 1] = e
        })
    })
    letst = slet("__zclos_recv", a.cenode(member(buf[0].addr(), field)))
    callx = a.cenode(call("__zclos_recv", rest))
    sbuf2 ::= cbuf<Stmt>(a, 2)
    sbuf2[0] = letst
    sbuf2[1] = sexpr(callx)
    a.cenode(block(sbuf2))
}
// `recv.len()` on a slice `[T]` is the slice's length FIELD (the element count). Resolving it
// receiver-type-aware here means it NEVER mis-dispatches to a same-named free fn (e.g. str.len, whose
// receiver is `str`, not `[T]`) — which otherwise yields a misleading arg-type error. Rewriting to the
// `.len` Member reuses the fully-supported field path (infer/validate/genc) and stays idempotent: a
// later resolve pass sees a Member, not a Call.
is_slice_len_call = (env: Env, fn: StringView, buf: [Expr]) bool {
    (fn == "len" && buf.len == 1).match ({
        true  => env.infer_expr(buf[0].addr()).match ({
            .Slice(e) => true,
            _         => false,
        }),
        false => false,
    })
}
// UFCS auto-ref: a value `T` passed where param0 is `Ptr<T>` / `MutPtr<T>` (e.g. `r.next()` with
// `next = (r: MutPtr<Rng>) …`) is rewritten to `addr(r)` so the call type-checks and emits `&r`.
// Lvalue-only (Var/Member/Index/Arrow): a temp like `seed(1).next()` would otherwise mutate a
// discarded copy. Already-pointer args and unknown/void types are left alone (idempotent).
is_auto_ref_lvalue = (e: Expr) bool {
    e.match ({
        .Var(v)    => true,
        .Member(m) => true,
        .Index(ix) => true,
        .Arrow(ar) => true,
        _          => false,
    })
}
needs_ufcs_auto_ref = (env: Env, ps: [Param], arg0: Expr) bool {
    (ps.len > 0 && ps[0].ty.is_nonnull_ptr_ty()).match ({
        true  => {
            want = ps[0].ty.pointee_of()
            got = env.infer_expr(arg0.addr())
            (want.is_void_ty() || got.is_void_ty() || got.is_ptr_ty_g()).match ({
                true  => false,
                false => got.ty_eq(want) && arg0.is_auto_ref_lvalue(),
            })
        },
        false => false,
    })
}
ufcs_auto_ref_arg0 = (a: MutPtr<Malloc>, env: Env, ps: [Param], buf: [Expr], pos: i32) void {
    (buf.len > 0 && env.needs_ufcs_auto_ref(ps, buf[0])).then({
        ab ::= a.cebuf(1)
        ab[0] = buf[0]
        buf[0] = load(a.cenode(call_at("addr", ab, pos)))
    })
}
// `g(args)` where `g` is a LOCAL of by-value closure-struct type (lower_closures generated a struct
// `__clos_K` for it plus a call fn `__clos_K_call`) is an indirect closure call. Return the call-fn
// name if `g` is such a local (its type is a Named struct with a matching `_call` fn in the index),
// else "". The closure value is threaded as the call's first argument (its captured environment).
resolve_call = (a: MutPtr<Malloc>, env: Env, c: CallData) Ptr<Expr> {
    (c.args.len == 0 && env.is_bare_struct_lit(c.fn)).then({
        return a.resolve_expr(env, a.cenode(mkstruct_at(c.fn, no_field_inits(), c.pos)))
    })
    dn = env.dispatch_name(c)
    fn = env.env_func(dn)
    ps = fn.params
    tmpl = fn.is_generic_fn()
    targs = tmpl.then({ env.call_targs(fn, c.args, c.targs) }, { no_tys() })
    buf ::= a.cebuf(c.args.len)
    c.args.loop((h, i, ar) {
        ex = env.call_arg_exp(tmpl, fn.tparams, targs, ps, i)
        buf[i] = a.vararg_wrap(env, ps, i, load(a.resolve_expr(env.with_exp(ex), ar.addr())))
    })
    // After args resolve: value→Ptr/MutPtr auto-ref on arg0 (UFCS MutPtr receivers like r.next()).
    (ps.len == buf.len).then({
        a.ufcs_auto_ref_arg0(env, ps, buf, c.pos)
    })
    cclos = env.clos_local_call_name(c.fn)
    env.is_slice_len_call(c.fn, buf).match ({
        true  => a.cenode(member(buf[0].addr(), "len")),
        false => (cclos == "").match ({
            true  => env.is_fn_field_call(dn, buf).match ({
                true  => a.rewrite_fn_field_call(env, c.fn, buf),
                false => a.recall(c, env.rec_dispatch(dn, fn, c.args, c.targs), a.collect_varargs(env, ps, buf)),
            }),
            false => a.clos_call_rewrite(c, cclos, buf),
        }),
    })
}
// A call to a recursive generic fn routes to the mangled monomorphic instance once mono_rec has emitted
// it (the instance decl exists in the index). Until then — in resolve passes BEFORE mono_rec runs, and
// for the never-instantiated template itself — it stays the bare template name. This guard keeps
// resolve_call idempotent across passes and unchanged for every non-recursive call.
rec_dispatch = (env: Env, dn: StringView, fn: Func, args: [Expr], etargs: [Ty]) StringView {
    (fn.name == dn && fn.params.len == args.len && fn.no_inline_gen_f()).match ({
        true  => {
            m = env.a.mangle_semantic_in(dn, env.call_targs(fn, args, etargs))
            (env.didx.func_idx.get(m, 0 - 1) >= 0).then({ m }, { dn })
        },
        false => dn,
    })
}
resolve_arms = (a: MutPtr<Malloc>, env: Env, t: Ty, arms: [ArmData]) [ArmData] {
    map_slice(a, arms, (ar) {
        aenv = a.arm_env(env, t, ar)
        arm_at(ar.variant, ar.bind, a.resolve_expr(aenv, ar.body), ar.pos)
    })
}
// Resolve statements, preserving expected type only for value-producing tail expressions.
store_local_ty = (t: Ty) Ty {
    t.match ({
        .Void    => tvoid(),
        .FnT(ft) => tvoid(),
        _        => t,
    })
}
resolve_let = (a: MutPtr<Malloc>, env: Env, l: LetData) Stmt {
    v = a.resolve_expr(env.let_exp(l.ty), l.value)
    ty = l.ty.is_void_ty().then({ env.clr_exp().infer_expr(v).store_local_ty() }, { l.ty })
    // Infer the stored type under the SAME cleared expected-type the value was resolved with: an
    // unannotated let has no target type, so the enclosing function's `exp` must not leak in. Else a
    // generic call whose return is a bare tparam (`with_sync … R`) unifies R against that stray exp
    // (e.g. main's i32) and the let is mistyped — value Result, type i32.
    slett_atm(l.name, ty, v, l.pos, l.mut)
}
// `vtail` = this body is a VALUE block (reached via resolve_expr `.Block`), so its TAIL expression is
// the block's value and must NOT be discard-lowered even with no expected type. Without it, an inlined
// fn whose value is a bare match/cond — wrapped in a block once a binding Let is prepended — spliced as
// a match subject (resolved with cleared exp) would lower that tail match to a value-less `if`, leaving
// the `({ … })` void (GCC: `_subj declared void`). Statement bodies pass vtail=false (unchanged).
resolve_stmt = (a: MutPtr<Malloc>, env: Env, st: Stmt, last: bool, vtail: bool) Stmt {
    out ::= st
    st.match ({
        .Let(l)      => {
            out = a.resolve_let(env, l)
        },
        .Assign(x)   => {
            out = sassign_at(a.resolve_expr(env, x.target), a.resolve_expr(env.clr_exp(), x.value), x.pos)
        },
        .Return(r)   => {
            // A return's operand is expected to be the ENCLOSING FN's return type, wherever the
            // return sits (lowered conditional branch, value-position arm block, loop body). Falls back to the
            // positional exp when no fnret is bound (globals) or the fn returns void.
            rt = env.vars.fnret_of()
            out = sret(a.resolve_expr(rt.is_void_ty().then({ env }, { env.with_exp(rt) }), r))
        },
        .ExprStmt(e) => {
            last.match ({
                true  => (env.exp.is_void_ty() == false).match ({
                    true  => {
                        out = sexpr(a.resolve_expr(env, e))
                    },
                    false => vtail.match ({
                        true  => {
                            out = sexpr(a.resolve_expr(env.clr_exp(), e))
                        },
                        false => {
                            out = a.lower_stmt_expr(env, a.resolve_expr(env.clr_exp(), e))
                        },
                    }),
                }),
                false => {
                    out = a.lower_stmt_expr(env, a.resolve_expr(env.disc_env(e), e))
                },
            })
        },
        .If(f)       => {
            out = sif(a.resolve_expr(env.clr_exp(), f.c), a.resolve_body(env, f.then), a.resolve_body(env, f.els))
        },
        .While(w)    => {
            out = swhile(a.resolve_expr(env.clr_exp(), w.c), a.resolve_body(env, w.body))
        },
        .IndexSet(x) => {
            out = sidxset_at(a.resolve_expr(env.clr_exp(), x.seq), a.resolve_expr(env.clr_exp(), x.idx), env.set_elem(x.elem, x.seq, x.value), a.resolve_expr(env.clr_exp(), x.value), x.pos)
        },
    })
    out
}
// `x := recv.or_return()` is keyword-free error propagation: the Ok payload becomes x, while an Err
// early-returns the receiver from the enclosing function. It lowers to a temp-bind + Err-guard +
// Ok-payload bind (three statements), so one source statement expands into three resolved ones.
is_or_return_call* = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Call(c) => c.fn == "or_return" && c.args.len == 1,
        _        => false,
    })
}
let_is_or_return = (st: Stmt) bool {
    st.match ({
        .Let(l) => l.value.is_or_return_call(),
        _       => false,
    })
}
stmt_out_span = (st: Stmt) i32 {
    st.orx_stmt_count() * 3 + st.let_is_or_return().then({ 3 }, { 1 })
}    // each hoisted expression-position or_return adds a 3-stmt let-lowering
body_out_len = (body: [Stmt]) i32 {
    n ::= 0
    body.loop((h, i, st) {
        n = n + st.stmt_out_span()
    })
    n
}
or_return_recv = (a: MutPtr<Malloc>, e: Ptr<Expr>) Ptr<Expr> {
    out ::= e
    load(e).match ({
        .Call(c) => {
            out = c.args[0].addr()
        },
        _        => { },
    })
    out
}
or_temp_name = (a: MutPtr<Malloc>, name: StringView) StringView {
    s ::= a.gstr_string(64)
    s = s.gstr_append(a, "_orret_")
    s = s.gstr_append(a, name)
    s.gstr_finish(a)
}
// ── the Err-guard's return value ──
// VERBATIM receiver when its whole Result type is the enclosing fn's, or when either side is not
// fully concrete here (tparam/unknown residue — the pre-#377 behavior). Otherwise REBUILT as the
// ENCLOSING fn's Result carrying the receiver's Err payload: `(Want){ .tag=Err, .u.Err=tmp.u.Err }`.
// The rebuild is what lets a fallible pipeline chain steps with DIFFERENT Ok types — a
// `Result<Cfg, E>` receiver inside a `Result<i32, E>` fn: the Ok payload is consumed locally by the
// binding this lowering feeds, so only E must line up (v1: exact same E, no From/Into).
// `env.exp` here IS the fn's return type wherever the statement-level hoisting lowering runs (fn
// bodies, if/while bodies); conditional-position wraps (resolve_orx) run under a local expected
// type, where the gate below fails closed to the verbatim return — matching the or-return
// validator, which keeps the strict full-Result requirement exactly there (ko_at's `cnd`).
// The concreteness gate mirrors the validator's unknown_ty deferrals (plus the prim widths), so
// every receiver/return pair the validator accepts with differing Ok payloads gets the rebuild.
orret_gen_declared = (decls: [Decl], n: StringView) bool {
    decls.slice_any((d) {
        d.match ({
            .DGenStruct(g) => g.name == n,
            .DGenEnum(g)   => g.name == n,
            _              => false,
        })
    })
}
orret_named_known = (env: Env, n: StringView) bool {
    env.didx.struct_idx.get(n, 0 - 1) >= 0
        || env.didx.enum_idx.get(n, 0 - 1) >= 0
        || env.decls.orret_gen_declared(n)
        || n.is_prim_width()
}
orret_ty_known = (env: Env, t: Ty) bool {
    t.match ({
        .Void       => false,
        .Named(n)   => env.orret_named_known(n),
        .Generic(g) => env.orret_args_known(g.args),
        .Ptr(pd)    => env.orret_ty_known(load(pd.pointee)),
        .Slice(e)   => env.orret_ty_known(load(e.pointee)),
        _           => true,
    })
}
orret_args_known = (env: Env, args: [Ty]) bool {
    k ::= true
    args.loop((h, i, t) {
        k = env.orret_ty_known(t).then({ k }, { false })
    })
    k
}
// Build `Want.Err(payload)` for a concrete want (Named enum or generic instance). The generic
// instance's mono name is the fn return type's own, so gen_types has already emitted it.
orret_mkerr = (a: MutPtr<Malloc>, want: Ty, payload: Ptr<Expr>, tmp: StringView) Ptr<Expr> {
    want.match ({
        .Named(n)   => a.cenode(mkenumg(n, n, no_tys(), "Err", payload)),
        .Generic(g) => a.cenode(mkenumg(g.name, (g.mangled == "").match ({
            true  => a.mangle_str_in(g.name, g.args),
            false => g.mangled,
        }), g.args, "Err", payload)),
        _           => a.cenode(vref(tmp)),
    })
}
orret_err_value = (a: MutPtr<Malloc>, env: Env, t: Ty, tmp: StringView, ptr: bool) Ptr<Expr> {
    want = env.exp
    (t.ty_eq(want)
        || want.ty_eq(t)
        || env.orret_ty_known(want) == false
        || env.orret_ty_known(t) == false).match ({
        true  => a.cenode(vref(tmp)),
        false => {
            wE = env.subj_variant_payload(want, "Err")
            rE = env.subj_variant_payload(t, "Err")
            (wE.is_void_ty() || rE.is_void_ty() || wE.ty_eq(rE) == false).match ({
                true  => a.cenode(vref(tmp)),
                false => a.orret_mkerr(want, a.subj_payload(a.cenode(vref(tmp)), "Err", ptr), tmp),
            })
        },
    })
}
// The Err-guard's tag constant, built as a re-manglable Tag node whose `.tag` genc folds to the bare
// `<mty>_<variant>` identifier — byte-identical to the old baked `tag_const` vref for a concrete
// receiver. Riding on a Tag (not a raw string) is what lets subst_expr rewrite T→concrete when this
// generic body is inlined at a concrete T, so or_return works in a generic Result-returning fn whose
// Ok type carries T (#54). A pointer/opaque receiver falls back to the verbatim baked constant.
or_err_tag = (a: MutPtr<Malloc>, t: Ty, variant: StringView) Ptr<Expr> {
    t.match ({
        .Named(n)   => a.subj_tag(a.cenode(mktag(n, variant)), false),
        .Generic(g) => a.subj_tag(a.cenode(mktagg(g.name, (g.mangled == "").match ({
            true  => a.mangle_str_in(g.name, g.args),
            false => g.mangled,
        }), g.args, variant)), false),
        _           => a.cenode(vref(a.tag_const(t.enum_name(), variant))),
    })
}
lower_or_return_let = (a: MutPtr<Malloc>, env: Env, l: LetData) [Stmt] {
    recv2 = a.resolve_expr(env.clr_exp(), a.or_return_recv(l.value))
    t = env.infer_expr(recv2)
    ptr = t.ty_is_ptr()
    tmp = a.or_temp_name(l.name)
    cnd = a.cenode(bin("==", a.subj_tag(a.cenode(vref(tmp)), ptr), a.or_err_tag(t, "Err")))
    buf ::= cbuf<Stmt>(a, 3)
    buf[0] = slett(tmp, t, recv2)
    buf[1] = sif(cnd, a.one_stmt(sret(a.orret_err_value(env, t, tmp, ptr))), no_stmts())
    buf[2] = slett(l.name, env.subj_variant_payload(t, "Ok"), a.subj_payload(a.cenode(vref(tmp)), "Ok", ptr))
    buf
}
lower_or_return = (a: MutPtr<Malloc>, env: Env, st: Stmt) [Stmt] {
    out ::= no_stmts()
    st.match ({
        .Let(l) => {
            out = a.lower_or_return_let(env, l)
        },
        _       => { },
    })
    out
}
// ── or_return in EXPRESSION position ─────────────────────────────────────────────────────────
// `recv.or_return()` is legal in ANY expression position, not just as a whole let value: mid-chain
// (`f().or_return().m()`), as a call argument, in return/trailing position, and in match arms. Each
// expression-position occurrence is HOISTED into a fresh direct let `_orx_K := recv.or_return()` —
// which reuses the 3-stmt let-lowering above — and the original site reads the temp. Hoists are
// emitted left-to-right in source order and innermost-first (a receiver's own or_returns hoist
// before the outer one), so the FIRST Err in evaluation order is the one propagated.
// UNCONDITIONALLY-evaluated positions hoist to statement level (fill_orx), where the Err-guard `if`
// is a real statement the inliner's early-return lift can see. CONDITIONALLY-evaluated positions —
// cond/match branch values and `&&`/`||` right operands — must NOT hoist past their guard: those
// are wrapped in place into a value block `({ _orx := recv.or_return()  _orx })` when resolve_expr
// reaches the branch (resolve_orx), so the receiver only evaluates if its branch is taken.
// orx_count counts the hoistable (unconditional-position) or_returns of ONE expression. Nested
// statement bodies (Block/Loop/Lambda/If/While) and conditional branches are NOT counted — each is
// resolved in its own scope, where this same machinery fires again. Resolution erases every
// or_return, so the count is 0 on already-resolved trees (the re-resolve passes stay idempotent).
resolve_orx = (a: MutPtr<Malloc>, env: Env, e: Ptr<Expr>) Ptr<Expr> {
    k = e.orx_count()
    hbuf = cbuf<Stmt>(a, k)
    r = a.orx_rw(hbuf, 0, 0, e)
    stmts ::= cbuf<Stmt>(a, k + 1)
    hbuf.loop((h, i, hst) {
        stmts[i] = hst
    })
    stmts[k] = sexpr(r.e)
    a.cenode(block(a.resolve_value_body(env, stmts)))
}
// Resolve a statement sequence while threading let bindings.
noop2 = () void { }
resolve_body = (a: MutPtr<Malloc>, env: Env, body: [Stmt]) [Stmt] {
    a.resolve_body_ex(env, body, false)
}
// resolve a VALUE-position block body: same as resolve_body but the trailing expression is kept as the
// block's value (see resolve_stmt's `vtail`).
resolve_value_body = (a: MutPtr<Malloc>, env: Env, body: [Stmt]) [Stmt] {
    a.resolve_body_ex(env, body, true)
}
resolve_body_ex = (a: MutPtr<Malloc>, env: Env, body: [Stmt], vtail: bool) [Stmt] {
    buf = cbuf<Stmt>(a, body.body_out_len())
    a.fill_stmts(env, body, buf, 0, 0, vtail)
    buf
}
fill_stmts = (
    a: MutPtr<Malloc>,
    env: Env,
    body: [Stmt],
    buf: [Stmt],
    i: i32,
    o: i32,
    vtail: bool,
) void { (i < body.len).then({ a.fill_stmt(env, body, buf, i, o, vtail) }, { noop2() }) }
fill_stmt = (
    a: MutPtr<Malloc>,
    env: Env,
    body: [Stmt],
    buf: [Stmt],
    i: i32,
    o: i32,
    vtail: bool,
) void {
    st = body[i]
    k = st.orx_stmt_count()
    (k > 0).match ({
        true  => a.fill_orx(env, body, buf, i, o, vtail, k),
        false => st.let_is_or_return().match ({
            true  => a.fill_or_return(env, body, buf, i, o, vtail),
            false => {
                resolved = a.resolve_stmt(env, st, i == body.len - 1, vtail)
                buf[o] = resolved
                a.fill_stmts(a.extend_env(env, resolved), body, buf, i + 1, o + 1, vtail)
            },
        }),
    })
}
// A statement holding k expression-position or_returns: hoist each into a fresh direct temp let
// (orx_rw_stmt), run every hoisted let through the SAME 3-stmt let-lowering, then emit the rewritten
// statement itself (which may still be a direct or_return let — its own lowering unchanged). The
// output slot count is exactly stmt_out_span's 3*k + (3|1), keeping body_out_len's buffer sizing.
fill_orx = (
    a: MutPtr<Malloc>,
    env: Env,
    body: [Stmt],
    buf: [Stmt],
    i: i32,
    o: i32,
    vtail: bool,
    k: i32,
) void {
    hbuf = cbuf<Stmt>(a, k)
    st2 = a.orx_rw_stmt(hbuf, o, body[i])
    env2 ::= env
    oo ::= o
    hbuf.loop((h, j, hst) {
        ls = a.lower_or_return(env2, hst)
        buf[oo] = ls[0]
        buf[oo + 1] = ls[1]
        buf[oo + 2] = ls[2]
        env2 = a.extend_env(a.extend_env(a.extend_env(env2, ls[0]), ls[1]), ls[2])
        oo = oo + 3
    })
    st2.let_is_or_return().match ({
        true  => {
            ls = a.lower_or_return(env2, st2)
            buf[oo] = ls[0]
            buf[oo + 1] = ls[1]
            buf[oo + 2] = ls[2]
            env2 = a.extend_env(a.extend_env(a.extend_env(env2, ls[0]), ls[1]), ls[2])
            oo = oo + 3
        },
        false => {
            resolved = a.resolve_stmt(env2, st2, i == body.len - 1, vtail)
            buf[oo] = resolved
            env2 = a.extend_env(env2, resolved)
            oo = oo + 1
        },
    })
    a.fill_stmts(env2, body, buf, i + 1, oo, vtail)
}
fill_or_return = (
    a: MutPtr<Malloc>,
    env: Env,
    body: [Stmt],
    buf: [Stmt],
    i: i32,
    o: i32,
    vtail: bool,
) void {
    stmts = a.lower_or_return(env, body[i])
    buf[o] = stmts[0]
    buf[o + 1] = stmts[1]
    buf[o + 2] = stmts[2]
    env2 = a.extend_env(a.extend_env(a.extend_env(env, stmts[0]), stmts[1]), stmts[2])
    a.fill_stmts(env2, body, buf, i + 1, o + 3, vtail)
}
// Rebuild decls with resolved bodies/inits.
resolve_func = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, f: Func) Func {
    env = Env(
        vars: a.bind_fnret(a.params_env(f.params), f.ret),
        decls: decls,
        didx: idx,
        exp: f.ret,
        a: a,
    )
    Func(
        name: f.name,
        params: f.params,
        ret: f.ret,
        tparams: f.tparams,
        body: a.resolve_body(env, f.body),
        pos: f.pos,
    )
}
resolve_global = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, g: GlobalData) Decl {
    env = Env(
        vars: a.params_env(empty_params()),
        decls: decls,
        didx: idx,
        exp: tvoid(),
        a: a,
    )
    g.tl.match ({
        true  => dglobal_tl(g.name, env.infer_expr(g.init), a.resolve_expr(env, g.init)),
        false => dglobal(g.name, env.infer_expr(g.init), a.resolve_expr(env, g.init)),
    })
}
resolve_decl* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, d: Decl) Decl {
    d.match ({
        .DFunc(f)   => dfunc(a.resolve_func(decls, idx, f)),
        .DGlobal(g) => a.resolve_global(decls, idx, g),
        _           => d,
    })
}
rm_log = (a: MutPtr<Malloc>, name: StringView, start_ms: i64) i64 {
    now = clock_ms()
    (getenv("ZENC_TIME") == null_ptr() == false).then({
        s = a
            .gstr_string(64)
            .gstr_append(a, "zenc: time   ")
            .gstr_append(a, name)
            .gstr_append(a, " ")
            .gstr_int(a, now - start_ms)
            .gstr_append(a, "ms\n")
            .gstr_finish(a)
        v = s.view()
        write(2, v.ptr, v.len)
        { }
    })
    now
}
resolve_module* = (a: MutPtr<Malloc>, raw: [Decl]) [Decl] {
    t0 = clock_ms()
    decls0 = a.expand_defaults(a.desugar_method_calls(raw))
    decls = a.fill_enum_defaults(decls0, a.build_decl_index(decls0))
    t1 = a.rm_log("desugar", t0)
    // Decl order/count are stable across resolve+inline passes (each rebuilds bodies in place), so a
    // name→index map is rebuilt once per pass over the current slice.
    didx = a.build_decl_index(decls)
    buf ::= cbuf<Decl>(a, decls.len)
    decls.loop((h, i, d) {
        buf[i] = a.resolve_decl(decls, didx, d)
    })
    t2 = a.rm_log("resolve-pass1", t1)
    bidx = a.build_decl_index(buf)
    inl ::= cbuf<Decl>(a, buf.len)
    buf.loop((h, i, d) {
        inl[i] = a.inline_decl(buf, bidx, d)
    })
    t3 = a.rm_log("inline-pass1", t2)
    iidx = a.build_decl_index(inl)
    out ::= cbuf<Decl>(a, inl.len)
    inl.loop((h, i, d) {
        out[i] = a.resolve_decl(inl, iidx, d)
    })
    t4 = a.rm_log("resolve-pass2", t3)
    oidx = a.build_decl_index(out)
    inl2 ::= cbuf<Decl>(a, out.len)
    out.loop((h, i, d) {
        inl2[i] = a.inline_decl(out, oidx, d)
    })
    t5 = a.rm_log("inline-pass2", t4)
    // emit one concrete fn per generic instance BEFORE the final resolve, so each instance body gets
    // resolved (dispatch on its concrete types) and resolve_call rewrites generic calls to it —
    // iterated to closure because instance bodies splice HOFs that can expose further instances.
    exp2 = a.mono_close(inl2, 0, 0)
    t6 = a.rm_log("mono", t5)
    // lower ESCAPING capturing closures (a fn returning a lambda over its params) to a by-value closure
    // struct + a top-level call fn, BEFORE the non-capturing lift and the final resolve. The final
    // resolve then sees the rewritten return type (the closure struct) and rewrites indirect calls.
    clos = a.lower_closures(exp2, a.build_decl_index(exp2))
    // lift non-capturing lambda LITERALS in value positions (struct-field inits / returns) to top-level
    // fns BEFORE the final resolve, so the generated fns + the fn-value references they leave behind get
    // resolved. Remaining capturing lambdas are left for check_validate's error[lambda-value].
    lifted = a.lift_lambdas(clos, a.build_decl_index(clos))
    t7 = a.rm_log("lower-lambdas", t6)
    eidx = a.build_decl_index(lifted)
    out2 ::= cbuf<Decl>(a, lifted.len)
    lifted.loop((h, i, d) {
        out2[i] = a.resolve_decl(lifted, eidx, d)
    })
    a.rm_log("resolve-pass3", t7)
    out2
}
