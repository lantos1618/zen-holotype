// SHIFT BY ZERO IS THE IDENTITY, ON EVERY WIDTH AND BOTH SIGNS.
//
// Zen has no `<<` token: a shift by n is spelled as n wrapping
// multiplies (`*%`) by the base, and this file is the n == 0 case --
// zero factors, so the answer is the operand bit for bit. The hazard is
// the backend shortcut "a shift is always some C op": an emitter that
// folds the shift family into one helper, or constant-folds `base**0`
// to 0 instead of 1 on the way down (an easy slip in a pow loop), turns
// every line below into 0 -- a plausible-looking number that still
// prints.
//
// the operands are deliberately NOT symmetric: -7 next to 5, i8 next to
// u64. A helper that special-cases width 8, or reads the operand through
// an unsigned temporary, flips exactly the negative columns while the
// positive ones stay green.
//
// one-line break: make the shift lowering emit its result slot zeroed
// and skip the copy when the count is zero ("nothing to do") — or fold
// base**0 to 0 — and every line below prints 0.

main = (env: Env) Res<i32, AllocError> {
    b: i8    = -7;
    w: u16   = 65535;
    t: i32   = 2000000011;
    m: u32   = 4294967291;
    q: i64   = -9000000000000000003;
    z: usize = 18446744073709551611;

    println("i8 {}", b);
    println("u16 {}", w);
    println("i32 {}", t);
    println("u32 {}", m);
    println("i64 {}", q);
    println("usize {}", z);

    Ok(0);
}
