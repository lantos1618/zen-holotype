// tests/corpus/traps/mul_i16_min_neg_one.zen
// i16.MIN * -1 traps: the product is i16.MAX + 1, which does not
// exist. i16.MIN is the one value whose negation is unrepresentable

// main must name an error type. a trap never lifts into Res:
// it aborts the process
Error =
    Overflow,
    DivideByZero,
    OutOfBounds

main = (env: Env) Res<i32, Error> {
    x: i16 = i16.MIN;
    neg_one: i16 = -1;
    product = x * neg_one;
    println("{}", product);
    Ok(0);
}
