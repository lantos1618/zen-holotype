// Usage facts and optional bounded source review, generated by Zen itself.
Build = zen.zen_build
RootPolicy, analyse, review = sema.sema_usage

main = (env: Env) Res<i32, AllocError> {
    result: Res<i32> = loop<i32>((done) {
        (env.argv.len < 6 || env.argv.len > 8).then(() {
            println(
                "usage: zen-usage SOURCE_ROOT ENTRY STD_ROOT main|loaded_exports OUTPUT.json [--review REVIEW.md]"
            );
            done.break(2);
        });
        (env.argv.len == 7 || (env.argv.len == 8
            && env.argv.get(6).value_or("").eq("--review") == false)).then(() {
            println("expected --review REVIEW.md after OUTPUT.json");
            done.break(2);
        });
        a        = env.mem.alloc();
        root     = env.argv.get(1).value_or("");
        entry    = env.argv.get(2).value_or("");
        standard = env.argv.get(3).value_or("");
        selected = env.argv.get(4).value_or("");
        output   = env.argv.get(5).value_or("");
        policy   = selected.match({
            "main"           => Ok(RootPolicy.Main),
            "loaded_exports" => Ok(RootPolicy.LoadedExports),
            _                => None,
        });
        policy.match({
            None      => { println("unknown root policy: {}", selected); done.break(2); },
            Ok(roots) => {
                build ::= a.Build(env, root);
                build.set_std_root(standard);
                (env.argv.len == 8).then(() { build.capture_sources(); });
                check = build.whole(entry, a.Map<str, str>()).try();
                (build.diag_count() > 0 || check.diag_count() > 0).then(() {
                    println(
                        "usage report refused: source loading, parsing or semantic checking failed"
                    );
                    done.break(1);
                });
                analyse(a, build.tree, check, 0, roots).match({
                    Err(fault) => fault.match({
                        OutOfMemory  => { Err(AllocError.OutOfMemory).try(); },
                        InvalidInput => { println("usage report refused: incomplete checked input"); done.break(1); },
                        InvalidRoots => { println("usage report refused: root policy selects no roots or an ambiguous main"); done.break(1); },
                    }),
                    Ok(report) => {
                        text = report.json(a, root, standard).try();
                        env.fs.write(output, text.view()).match({
                            Ok(_)  => (),
                            Err(_) => { println("could not write usage report: {}", output); done.break(1); },
                        });
                        (env.argv.len == 8).then(() {
                            path = env.argv.get(7).value_or("");
                            build.sources.match({
                                None        => { println("review source capture is missing"); done.break(1); },
                                Ok(sources) => {
                                    pack = report.review(a, sources, 40).try();
                                    env.fs.write(path, pack.view()).match({
                                        Ok(_)  => (),
                                        Err(_) => { println("could not write source review: {}", path); done.break(1); },
                                    });
                                },
                            });
                        });
                        done.break(0);
                    },
                });
            },
        });
    });
    Ok(result.value_or(1))
}
