// src/sema/sema_call.zen
// What a call means, and which declaration it means.
//
// DESIGN.md, Overloading: "Resolution is on declared parameter types AND
// arity, and a closure's type is its full signature. There is no
// carve-out: `loop` overloads on `(h: LoopHandle, value: T)` versus
// `(h: LoopHandle, index: usize, value: T)` for exactly the reason
// `toString` overloads on a buffer versus an allocator."
//
// So a closure argument is matched on its PARAMETER COUNT and not waved
// through. That single line is why `loop` can be one name with six
// declarations, and a resolver that treated every closure as
// interchangeable would make five of them unreachable.
//
// PARAMETER NAMES ARE NOT IDENTITY. `TyFn` carries no names, so two
// candidates differing only in them are one signature and there is
// nothing to compare — which is exactly why declaring both is an error
// AT THE DECLARATION, naming both. A call site cannot be where that is
// discovered, because at a call site the two are indistinguishable; the
// call is only what triggers the check.
//
// A GENERIC PARAMETER SWALLOWS A CONCRETE ONE. `<A>(init: A, ..)` and
// `(alloc: Alloc, ..)` can never be told apart, so they may not be
// overloads — which is why DESIGN.md gives the allocating loop variant
// its own name, `map`. `swallows` below is that rule, and it is careful
// in the one way the bootstrapper records paying for: only a type
// parameter belonging to the CANDIDATE BEING TESTED is a wildcard.
// Without that, `loop<R, T>(range: R, ..)` and `loop<K, V>(map:
// Map<K,V>, ..)` look interchangeable, and the prelude declares both.
//
// OVER 500 LINES, AND THE JUSTIFICATION STYLE.md ASKS FOR: the subject
// is "which declaration does this call mean", and the declaration-site
// rules are the same question asked without a call. `same_signature`,
// `swallows` and `matches` are three readings of one predicate — "can a
// call site tell these apart" — and splitting them would leave that rule
// in a module that cannot see what distinguishing them means.
//
// A LAMBDA ARGUMENT'S BODY IS TYPED AFTER RESOLUTION AND NOT BEFORE IT.
// "A closure passed to a function whose signature is already known
// infers its parameter types from that signature" — so the arity is all
// resolution reads, and the body is walked once the candidate is picked
// and its parameters are known (`arg_lambdas`, `lambda_body`). Walked at
// all only since then: `own_lambda` had entered `l.body` from the day it
// was written and the type walk had no equivalent, so every statement
// inside every closure in the language was checked by nothing.

Expr, ExprId, Call, Arg, Access, Lambda, Param, Span, nowhere = std.ast
AllocError = std.mem
Vec = std.collections
str = std.text
Range = std.core
DeclId = sema.sema_id
TyId, TyFn, TyNamed = sema.sema_ty
Def = sema.sema_def
SemaFault, NameFault, TypeFault, PairFault = sema.sema_diag
Checker, Ctx = sema.sema_check
refuse_handle_argument = sema.sema_handle
meta_call = sema.sema_meta
construct, instantiate, variant_call_type = sema.sema_apply
subst_list = sema.sema_inst
is_case = sema.sema_match
Found, Base, base_of, members_of = sema.sema_member
is_type_def, opaque, first_found = sema.sema_member
static_access = sema.sema_static
first_hidden, hidden_member = sema.sema_member
check_bounds = sema.sema_bound
check_literal = sema.sema_trap
check_arms, check_arms_agree = sema.sema_hoist
bound_declares = sema.sema_supply
type_of, block_type = sema.sema_type
param_type = sema.sema_denote
alias_module, module_not_a_value = sema.sema_module
cands_of, travelled_cands, matches = sema.sema_cand
ty_at, is_tvar, recv_sig_fits = sema.sema_cand

// One candidate, as resolution sees it.
//
// `owner` is the declaration's qualified name, and it is what makes a
// type parameter identifiable: `Ty.Var` is nominal on its owner as well
// as its name, so `T` of one candidate is never `T` of another.
//
// `id` is WHICH DECLARATION this candidate came from, and it is what a
// resolution is. Without it the answer to "which of the six `loop`s did
// this call mean" exists only for as long as `chosen` runs, and every
// later consumer has to re-derive it from the name — which is how a
// backend ends up reporting an ambiguity that sema had settled.
Cand* = {
    id*: DeclId,
    name*: str,
    owner*: str,
    params*: Vec<TyId>,
    ret*: TyId,
    // the `Ty.Var`s this candidate's own type parameters denote, in
    // declaration order. They are built once, where the signature is
    // resolved, because that is the only place `T` and `owner` are both
    // in hand — and an instantiation is exactly a value for each of
    // these.
    tvars*: Vec<TyId>,
    tbounds*: Vec<TBound>,
    generic*: bool,
    span*: Span,
}

// One bound on one type parameter. A list, because `<K: Eq + Hash>` has
// two and "`+` is not `|`".
TBound* = {
    name*: str,
    bound*: TyId,
}

// One argument, as resolution sees it. A lambda has no type until a
// signature settles it, so it carries what resolution actually uses.
Actual* = {
    ty*: TyId,
    is_lambda*: bool,
    arity*: usize,
    // whether the argument NAMED a field. `Point(x: 3)` and `f(3)` are
    // the same node and not the same thing: AST_CONTRACT.md gives the
    // `name: value` form to construction and to an impl's supplied
    // field, and a call's arguments are positional. Recorded here
    // because resolution is the one place the difference decides
    // anything.
    named*: bool,
    span*: Span,
}

// ---------------------------------------------------------------------
// QUERY: the type of a call
// ---------------------------------------------------------------------

// `id` is the CALL's own node id, and it is threaded rather than
// derived: an `Expr` is a value and carries no id, so the only place
// that knows which node this is, is the query that was asked about it.
// It is the key `chosen` writes the resolution under.
call_type* = (c :: Checker, id: ExprId, node: Expr, call: Call, ctx: Ctx)
             Res<TyId, AllocError> {
    callee = c.tree.expr_at(call.callee);
    callee.kind.match({
        Access(a) => c.member_call(id, node, call, a, ctx),
        Name(n)   => c.named_call(id, node, call, n.text, ctx),
        _         => c.indirect_call(node, call, ctx),
    })
}

actuals_of = (c :: Checker, args: Vec<Arg>, ctx: Ctx, out :: Vec<Actual>)
             Res<(), AllocError> {
    args.loop((h, a) {
        out.add(c.actual_of(a, ctx).try()).try();
    });
    Ok(());
}

actual_of = (c :: Checker, a: Arg, ctx: Ctx) Res<Actual, AllocError> {
    node = c.tree.expr_at(a.value);
    node.kind.match({
        Lambda(l) => c.lambda_actual(l, a),
        _         => c.value_actual(a, ctx),
    })
}

is_named = (a: Arg) bool { a.name.match({ Ok(_) => true, None => false }) }

lambda_actual = (c :: Checker, l: Lambda, a: Arg) Res<Actual, AllocError> {
    poison = c.types.unknown().try();
    Ok(Actual(
        ty: poison,
        is_lambda: true,
        arity: l.params.len,
        named: is_named(a),
        span: a.span
    ));
}

value_actual = (c :: Checker, a: Arg, ctx: Ctx) Res<Actual, AllocError> {
    ty = c.type_of(a.value, ctx).try();
    Ok(Actual(
        ty: ty,
        is_lambda: false,
        arity: 0,
        named: is_named(a),
        span: a.span
    ));
}

// ---------------------------------------------------------------------
// `f(..)`
// ---------------------------------------------------------------------

named_call = (
    c    :: Checker,
    id   : ExprId,
    node : Expr,
    call : Call,
    name : str,
    ctx  : Ctx
) Res<TyId, AllocError> {
    actuals ::= c.alloc.Vec<Actual>();
    c.actuals_of(call.args, ctx, actuals).try();
    is_res_ctor(name).match({
        true  => c.res_ctor_type(name, actuals),
        false => c.print_or_call(id, node, call, name, actuals, ctx),
    })
}

// THE PRINT SUGAR HAS A TYPE, AND IT IS `()`.
//
// `println(..)` is "sugar for `<the Env in scope>.out.println(..)`",
// and no declaration of that name exists to resolve against — so a call
// through it fell all the way to `no_overload`, found no candidate at
// all, stayed silent by the rule above, and was answered with poison.
// Poison agrees with everything, so `println("x")` was a legal value of
// whatever type the context asked for. That is the poison mechanism
// being spent on a value that is not a mistake: the sugar owes no
// diagnostic, it simply returns nothing, and `()` is the type that says
// so. `gen_c_print.zen` has said the same all along — "a print is a
// statement sequence whose value is unit".
//
// THE TWO NAMES ARE `gen_c_print.is_print`'s, and they have to be: sema
// answering `()` for a name the backend does not recognise as a print
// would hand codegen an unresolved call wearing a real type.
print_or_call = (
    c       :: Checker,
    id      : ExprId,
    node    : Expr,
    call    : Call,
    name    : str,
    actuals : Vec<Actual>,
    ctx     : Ctx
)
                Res<TyId, AllocError> {
    is_print_sugar(name).match({
        true  => c.print_type(call),
        false => c.local_or_decl_call(id, node, call, name, actuals, ctx),
    })
}

// A PRINT IS THE ONE CALL WHOSE ARGUMENTS HAVE NO PARAMETERS TO OWE.
// No declaration resolves, so `param_literal` never walks them, and a
// match written here had nothing at all holding its arms together:
// `println("{}", b.match({ true => 1, false => false }))` compiled and
// printed the 0 the `match_arms_disagree*` tests exist to stop.
print_type = (c :: Checker, call: Call) Res<TyId, AllocError> {
    call.args.loop((h, a) { c.check_arms_agree(a.value).try() });
    c.types.prim("()")
}

is_print_sugar = (name: str) bool { name.eq("println") || name.eq("print") }

// `Ok(x)` and `Err(e)` are the prelude's own variants and there is
// nothing to resolve: `Res<T>` and `Res<T, E>` are two arities of one
// name, recognised structurally exactly as `sema_denote.zen` recognises
// the written type. `Ok(x)` is OPEN — which `Res` it closes is not
// decided until an expectation says.
is_res_ctor = (name: str) bool { name.eq("Ok") || name.eq("Err") }

res_ctor_type = (c :: Checker, name: str, actuals: Vec<Actual>)
                Res<TyId, AllocError> {
    payload = c.first_ty(actuals).try();
    name.eq("Ok").match({
        true  => c.types.res_open(payload),
        false => c.err_res(payload),
    })
}

// Only success lifts, so `Err(e)` says nothing about the value type.
err_res = (c :: Checker, e: TyId) Res<TyId, AllocError> {
    hole = c.types.infer().try();
    c.types.res_failure(hole, e)
}

first_ty = (c :: Checker, actuals: Vec<Actual>) Res<TyId, AllocError> {
    actuals.get(0).match({
        None  => c.types.prim("()"),
        Ok(a) => Ok(a.ty),
    })
}

local_or_decl_call = (
    c       :: Checker,
    id      : ExprId,
    node    : Expr,
    call    : Call,
    name    : str,
    actuals : Vec<Actual>,
    ctx     : Ctx
)
                     Res<TyId, AllocError> {
    c.lookup(name).match({
        None  => c.decl_call(id, node, call, name, None, actuals, ctx),
        Ok(b) => c.sig_ret(node, call, b.ty, 0, ctx),
    })
}

// A declaration of that name: a function to resolve against, or a type
// to construct.
//
// The functions are tried FIRST and the type only when none matches,
// which is the fix for the bootstrapper's §9: `World* = (a: Alloc, tree:
// Ast) Res<World, AllocError>` declared beside `World* = { .. }` is the
// pairing `std.collections` uses for `Vec`, and matching the struct's
// fields positionally instead of the function is what made three
// constructors in this folder unwritable.
decl_call = (
    c       :: Checker,
    id      : ExprId,
    node    : Expr,
    call    : Call,
    name    : str,
    recv    : Res<TyId>,
    actuals : Vec<Actual>,
    ctx     : Ctx
)
            Res<TyId, AllocError> {
    cands ::= c.alloc.Vec<Cand>();
    c.cands_of(ctx.module, name, cands).try();
    c.travelled_cands(name, recv, cands).try();
    // THE FREE FORM OF A UFCS NAME REACHES THE SAME FUNCTION THE DOT
    // DOES (#771). `x.f(a)` arrives as `ufcs_call`, which prepends the
    // receiver and hands `decl_call` a real `recv` — so the travelled
    // pool above answers it. But UFCS says those are ONE call surface,
    // and `f(x)` arrives HERE, where `recv` is `None`: the pool was
    // never asked, sema answered silence, and CODEGEN refused with
    // `cannot resolve` — right line, wrong pass. When there is no
    // receiver the receiver IS argument zero, so ask the SAME pool the
    // dot asks, through its type. The pool's own gates still hold: only
    // an exported function whose FIRST parameter takes that type joins,
    // already-present candidates are not added twice, and `<T>` swallows
    // nothing it did not swallow at the dot.
    recv.match({
        Ok(_) => Ok(()),
        None  => actuals.get(0).match({
            None  => Ok(()),
            Ok(a) => c.travelled_cands(name, Ok(a.ty), cands),
        }),
    }).try();
    kept ::= c.alloc.Vec<Cand>();
    c.keep_matching(cands, actuals, kept).try();
    (kept.len > 0).match({
        true  => c.chosen(id, node, call, kept, actuals, ctx),
        false => c.construct_or_fail(id, node, call, name, recv, cands, ctx),
    })
}

keep_matching = (
    c       :: Checker,
    cands   : Vec<Cand>,
    actuals : Vec<Actual>,
    kept    :: Vec<Cand>
) Res<(), AllocError> {
    cands.loop((h, k) { c.keep_one(k, actuals, kept).try() });
    Ok(());
}

// A named helper rather than a `.then` inside the loop body:
// docs/SEMA_BOOTSTRAP_FIXES.md §10, which now records that gap CLOSED,
// to be re-tested before removal.
keep_one = (c :: Checker, k: Cand, actuals: Vec<Actual>, kept :: Vec<Cand>)
           Res<(), AllocError> {
    c.matches(k, actuals).try().match({
        true  => kept.add(k),
        false => Ok(()),
    })
}

construct_or_fail = (
    c     :: Checker,
    id    : ExprId,
    node  : Expr,
    call  : Call,
    name  : str,
    recv  : Res<TyId>,
    cands : Vec<Cand>,
    ctx   : Ctx
)
                    Res<TyId, AllocError> {
    defs ::= c.alloc.Vec<Def>();
    c.world.defs_of(ctx.module, name, defs).try();
    type_def_of(defs).match({
        None  => unresolved(c, node, call, name, recv, cands),
        Ok(d) => c.construct_def(id, node, call, d, ctx),
    })
}

// A CALL THROUGH A RECEIVER IS A MEMBER THAT IS NOT THERE, and that is a
// different sentence from "no overload matches". `b.size()` where `size`
// belongs to `Bag` has no candidate BECAUSE `size` is not on `Box` — so
// the diagnostic has to name the type that was asked, and land on the
// name after the dot rather than on the receiver expression. Reported
// here whether or not a candidate of the name exists anywhere: for a
// receiver call this IS the diagnostic, and nothing else in the folder
// owes one.
unresolved = (
    c     :: Checker,
    node  : Expr,
    call  : Call,
    name  : str,
    recv  : Res<TyId>,
    cands : Vec<Cand>
) Res<TyId, AllocError> {
    recv.match({
        Ok(ty) => c.no_such_method(call, name, ty),
        None   => c.no_overload(node, name, cands),
    })
}

// A NAME A BOUND DECLARED IS NOT A NAME THE TYPE NEVER HEARD OF, even
// when no impl supplies it. `alloc.create<Node>()` reaches nothing here
// and is not a mistake — `gen_c_alloc.zen` writes that body — so this
// asks `bound_declares` and not the member table, which is the question
// whose answer is `no` for both.
no_such_method = (c :: Checker, call: Call, name: str, ty: TyId)
                 Res<TyId, AllocError> {
    bound_declares(c, ty, name).try().match({
        true  => c.types.unknown(),
        false => c.report_no_method(call, name, ty),
    })
}

report_no_method = (c :: Checker, call: Call, name: str, ty: TyId)
                   Res<TyId, AllocError> {
    poison = c.types.unknown().try();
    at     = c.callee_name_span(call);
    c.report(
        at.file,
        at,
        SemaFault.NoSuchField(TypeFault(
            name: name,
            expected: poison,
            found: ty
        ))
    ).try();
    c.types.unknown()
}

// The name after the dot. A receiver call always has an `Access` callee
// — that is what made it one — and the span is read back off the node
// rather than threaded through six signatures that have no other use
// for it.
callee_name_span = (c: Checker, call: Call) Span {
    c.tree.expr_at(call.callee).kind.match({
        Access(a) => a.name.span,
        _         => nowhere(),
    })
}

// CONSTRUCTING IS A RESOLUTION TOO, recorded by `construct` for the same
// reason a call is: `Checker* = { .. }` beside `Checker* = (a: Alloc,
// ..)` is two declarations of one name, and which of them a call site
// meant is decided here and nowhere else.
//
// A MODULE IS NOT A CONSTRUCTOR. `is_type_def` answers about a `DefKind`
// and an alias is a type declaration by kind — but `reseat = vec` aliases
// a MODULE, and constructing it invented a nominal type of the alias's own
// name that nothing declares. That is how an unstarred `reseat` inside
// `vec` became callable through a name that never meant it.
construct_def = (
    c    :: Checker,
    id   : ExprId,
    node : Expr,
    call : Call,
    d    : Def,
    ctx  : Ctx
) Res<TyId, AllocError> {
    c.alias_module(d.id).match({
        None   => construct(c, id, call, d, ctx),
        Ok(mi) => c.module_not_a_value(node.span, d.name, mi),
    })
}

type_def_of = (defs: Vec<Def>) Res<Def> {
    Range(0, defs.len).find((i) {
        defs.get(i).match({ Ok(d) => is_type_def(d.kind), None => false })
    }).match({
        Ok(i) => defs.get(i),
        None  => None,
    })
}

// No candidate of that arity or those types. Silent when there were no
// candidates at all: the name resolved to something that is not a
// function, and that is somebody else's diagnostic.
no_overload = (c :: Checker, node: Expr, name: str, cands: Vec<Cand>)
              Res<TyId, AllocError> {
    (cands.len > 0).then(() {
        c.report(
            node.span.file,
            node.span,
            SemaFault.NoOverload(NameFault(name: name))
        ).try();
    });
    c.types.unknown()
}

// The first candidate that matched, and THE PLACE THE ANSWER IS WRITTEN
// DOWN. Everything after resolution — the backend most of all — reads
// `call_memo` rather than asking the name again, because the name is
// exactly what could not answer.
chosen = (
    c       :: Checker,
    id      : ExprId,
    node    : Expr,
    call    : Call,
    kept    : Vec<Cand>,
    actuals : Vec<Actual>,
    ctx     : Ctx
) Res<TyId, AllocError> {
    kept.get(0).match({
        None  => c.types.unknown(),
        Ok(k) => c.chosen_ret(id, node, call, k, actuals, ctx),
    })
}

chosen_ret = (
    c       :: Checker,
    id      : ExprId,
    node    : Expr,
    call    : Call,
    k       : Cand,
    actuals : Vec<Actual>,
    ctx     : Ctx
) Res<TyId, AllocError> {
    c.resolve_call(id, k.id).try();
    c.check_bounds(k, actuals, node.span).try();
    c.arg_literals(call.args, k.params, recv_off(call, actuals)).try();
    ret = c.instantiate(id, call, k, actuals, ctx).try();
    params ::= c.alloc.Vec<TyId>();
    c.settled_params(id, k, params).try();
    c.arg_lambdas(call.args, params, recv_off(call, actuals), ctx).try();
    c.args_handle_check(call.args, params, recv_off(call, actuals), ctx).try();
    Ok(ret);
}

// ONE SEAT FOR THE HANDLE-AS-ARGUMENT REFUSAL. Lambda arguments are
// skipped — their bodies are already typed through `arg_lambdas`, and a
// lambda is the one legal inward path for a handle. Every other
// argument whose settled formal cannot receive handles inward is the
// bug #782 names: accepted here in silence, `zu_l1h` undeclared in cc.
args_handle_check = (
    c      :: Checker,
    args   : Vec<Arg>,
    params : Vec<TyId>,
    off    : usize,
    ctx    : Ctx
) Res<(), AllocError> {
    i ::= off;
    args.loop((h, a) {
        c.refuse_handle_argument(a, ty_at(params, i), ctx).try();
        i = i + 1;
    });
    Ok(());
}

// `k.params` STILL NAMES THE CALLEE'S OWN `T`, and the caller's body is
// the one that will be lowered — a `Var` owned by `loop` means nothing
// to the frame the closure was written in. So the walk reads back what
// `instantiate` settled and asks about THOSE types.
settled_params = (c :: Checker, id: ExprId, k: Cand, out :: Vec<TyId>)
                 Res<(), AllocError> {
    c.resolved_inst(id).match({
        None    => copy_tys(k.params, out),
        Ok(ins) => c.subst_list(k.params, ins, out),
    })
}

// A LAMBDA ARGUMENT'S BODY IS STATEMENTS, AND STATEMENTS ARE TYPED.
// `sema_own.own_lambda` has walked `l.body` since the day it was
// written; the type walk had no equivalent, so `(h, v) { x: i32 = true;
// }` was checked by nothing at all while the identical bind one line
// out was refused.
//
// AFTER RESOLUTION, for the reason `arg_literals` is above it: only the
// chosen candidate knows what `(h, v)` ARE, and typing the body before
// it is picked would type it against parameters that do not exist yet.
//
// ONCE PER LAMBDA, which is why this hangs off the places resolution
// ENDS rather than off `actual_of`: a second walk is a second copy of
// every diagnostic in the body.
arg_lambdas = (
    c      :: Checker,
    args   : Vec<Arg>,
    params : Vec<TyId>,
    off    : usize,
    ctx    : Ctx
) Res<(), AllocError> {
    i ::= off;
    args.loop((h, a) {
        c.arg_lambda(a.value, params, i, ctx).try();
        i = i + 1;
    });
    Ok(());
}

arg_lambda = (c :: Checker, id: ExprId, params: Vec<TyId>, i: usize, ctx: Ctx)
             Res<(), AllocError> {
    c.tree.expr_at(id).kind.match({
        Lambda(l) => c.lambda_body(l, ty_at(params, i), ctx),
        _         => Ok(()),
    })
}

// The same shape as `check_body`: mark the scope, bind the parameters,
// walk, release. What is NOT the same is `ctx` — it is passed through
// untouched, because a `.try()` in a closure body propagates out through
// the call and answers to the enclosing `ret`; what the closure itself
// returns is decided by nothing here.
lambda_body = (c :: Checker, l: Lambda, sig: TyId, ctx: Ctx)
              Res<(), AllocError> {
    ptys ::= c.alloc.Vec<TyId>();
    c.fn_params(sig, ptys).try();
    smark = c.mark();
    l.params.loop((h, i, p) {
        ty = c.lambda_param(p, ptys, i, ctx).try();
        c.bind(p.name.text, ty, p.mutable, true).try();
    });
    c.block_type(l.body, ctx).try();
    c.release(smark).try();
    Ok(());
}

// "A closure passed to a function whose signature is already known
// infers its parameter types FROM that signature" — and a written
// annotation still wins over it, which is what `param_type` answers.
// Where the signature says nothing the hole is bound: it agrees with
// everything, so the parameter reports nothing rather than nonsense.
lambda_param = (c :: Checker, p: Param, ptys: Vec<TyId>, i: usize, ctx: Ctx)
               Res<TyId, AllocError> {
    p.type.match({
        Ok(_) => c.param_type(p, ctx),
        None  => c.sig_param(ptys, i),
    })
}

sig_param = (c :: Checker, ptys: Vec<TyId>, i: usize) Res<TyId, AllocError> {
    (i < ptys.len).match({
        true  => c.settled_or_poison(ty_at(ptys, i)),
        false => c.types.unknown(),
    })
}

// A PARAMETER THE CALL DID NOT SETTLE IS POISON, NOT ITS OWN `Var`.
// `settled_param` is the predicate `param_holds` asks a few lines above,
// for the same reason: an unsubstituted variable expects nothing of the
// value, so nothing is checked either way.
//
// AND `Checker.expr_memo` IS KEYED BY NODE, so whatever this binds is
// what `gen_c_op.operand_type` reads back at lowering time — the backend
// asks sema for the type of an operand rather than deriving it. A `Var`
// or a hole memoized there is not "no answer", it is an answer the
// backend cannot lower: `loop<R: Range<T>, T>` settles no `T`, and
// `(v == 3)` inside its body became "comparing values that are not
// scalars" for a comparison that lowers perfectly well from the
// backend's own reading. Poison is the one type it knows to step around.
settled_or_poison = (c :: Checker, ty: TyId) Res<TyId, AllocError> {
    c.settled_param(ty).match({ true => Ok(ty), false => c.types.unknown() })
}

// WHETHER PARAMETER ZERO HAS AN ARGUMENT, derived and not plumbed:
// `ufcs_call` prepends the receiver to the ACTUALS resolution matched
// on, and `actuals_of` is otherwise one-for-one with the written
// arguments — so the difference is 1 for `x.f(a)` and 0 for `f(a)`.
//
// `arg_literals` documented this offset from the day it was written and
// the one call site passed 0. So `x.f(a)` checked `a` against the
// RECEIVER's type; `check_literal` is silent when that is not an integer
// type, which kept an assertion that was already written and already
// tested inert for every dotted call in the language.
recv_off = (call: Call, actuals: Vec<Actual>) usize {
    actuals.len - call.args.len
}

// RESOLUTION PICKED THE CANDIDATE ON THE FAMILY, so somebody still has
// to ask about the value. `fits` is `assignable`, and `assignable` reads
// "a literal's type comes from its context" as: an `int` agrees with
// every integer type — which is right about `narrow(3000000000)` being a
// call to `narrow` and says nothing about 3000000000 not being an i32.
//
// AFTER RESOLUTION AND NOT DURING IT. A candidate that a literal
// overflows is still the candidate the author meant; refusing it during
// the fit would silently pick a wider overload instead of naming the
// mistake, and with no wider one in scope would report "no overload
// matches" for a call whose only fault is one digit too many.
//
// `off` IS THE RECEIVER — `recv_sig_fits`' rule, and `recv_off` above
// is where this call site decides it.
arg_literals* = (c :: Checker, args: Vec<Arg>, params: Vec<TyId>, off: usize)
               Res<(), AllocError> {
    i ::= off;
    args.loop((h, a) {
        c.param_literal(a.value, params, i).try();
        i = i + 1;
    });
    Ok(());
}

// A VARIADIC CALL HAS NO PARAMETER HERE, and a parameter nobody declared
// expects nothing of the argument. The length is asked rather than
// `ty_at`'s `UNRESOLVED`, which is type zero — whichever type that
// happens to be interned as.
param_literal = (c :: Checker, id: ExprId, params: Vec<TyId>, i: usize)
                Res<(), AllocError> {
    (i < params.len).match({
        false => c.check_arms_agree(id),
        true  => c.param_wants(id, ty_at(params, i)),
    })
}

// ONE QUESTION ASKED OF TWO SHAPES: a literal is asked whether it fits
// the declared type, and a match is several values standing in one
// place, so every ARM is asked the same thing (`sema_hoist.check_arms`,
// the rule itself and never a second copy of it). Resolution picked the
// candidate on the FIRST arm's type and no arm speaks for the rest —
// which is how `g(b.match({ true => 1, false => false }))` reached an
// `i32` parameter as a 0 nobody wrote.
param_wants = (c :: Checker, id: ExprId, want: TyId) Res<(), AllocError> {
    c.check_literal(id, want).try();
    c.param_holds(id, want)
}

// A PARAMETER DECLARED `T` EXPECTS NOTHING YET, and `assignable` says
// so — every type reaches an unsubstituted variable. So `id(b.match({
// true => 1, false => false }))` had a `want` that agreed with both
// arms, which is the same silence as having no parameter at all. In
// both cases the arms are their own authority and owe their join, not
// the declaration. Variadics arrive here through `param_literal`'s
// other branch for the same reason.
param_holds = (c :: Checker, id: ExprId, want: TyId) Res<(), AllocError> {
    c.settled_param(want).match({
        true  => c.check_arms(id, want),
        false => c.check_arms_agree(id),
    })
}

settled_param = (c: Checker, want: TyId) bool {
    (c.is_var(want) || c.is_infer(want) || c.is_unknown(want)) == false
}

// ---------------------------------------------------------------------
// `x.f(..)`
// ---------------------------------------------------------------------

member_call = (
    c    :: Checker,
    id   : ExprId,
    node : Expr,
    call : Call,
    ac   : Access,
    ctx  : Ctx
) Res<TyId, AllocError> {
    // THE CALL WRITTEN BESIDE THIS ACCESS IS THE EXEMPTION #772's refusal
    // reads. Marked BEFORE anything types the callee, because typing it is
    // what reaches `settled` — through `static_access` when the base names
    // a type (`Duration.millis(2)`, whose callee resolves as an ordinary
    // member read first), while a value receiver (`v.grow()`) never passes
    // `settled` at all. Presence says "read through its call"; absence is
    // the #772 mistake, a method standing where its return value was wanted.
    c.callee_access.set(call.callee, true).try();
    // A `@meta(..)` BASE IS THE EVALUATOR'S QUESTION BEFORE IT IS A CALL.
    // Intercepted HERE, not left to `reachable_call`: a `.foo()` on any
    // receiver resolves by ordinary UFCS and falls through to a free
    // function when no member matches (`sema_call.reachable_call`), which
    // would hunt for a free `fields` and answer a name error instead of
    // the fold. The backend lowers this same call through
    // `lower_meta_call`.
    c.tree.expr_at(ac.base).kind.match({
        Meta(_) => c.meta_call(call, ctx),
        _       => Ok(()),
    }).try();
    b = base_of(c, ac.base, ctx).try();
    b.is_type.match({
        true  => c.static_call(node, call, ac, b.ty, ctx),
        false => c.receiver_call(id, node, call, ac, b, ctx),
    })
}

// `Slot.Left(cell)` — a variant carrying a payload IS the function that
// builds one, so this is an ordinary call through it.
//
// ORDINARY, NOT IDENTICAL: a variant ctor's `.ret` is the enum at the
// declaration's own parameters (`variant_ctor` builds it from `cs.payload`
// as written), and extracting it raw is how `Opt.Some(41)` typed its let
// `Opt<Var>` — free parameter mangled into the C symbol. A generic
// function's call instantiates its return from what the arguments say
// (`sema_apply.instantiate`); a variant's does the same, in
// `variant_call_type`. Everything else here keeps `fn_ret`'s answers.
static_call = (
    c    :: Checker,
    node : Expr,
    call : Call,
    ac   : Access,
    ty   : TyId,
    ctx  : Ctx
) Res<TyId, AllocError> {
    got = c.static_access(call.callee, node, ac, ty, ctx).try();
    c.sig_lambdas(call, got, 0, ctx).try();
    c.is_case(ty, ac.name.text).try().match({
        true  => c.variant_call_type(call, ty, ac.name.text, ctx),
        false => c.fn_ret(node, got),
    })
}

receiver_call = (
    c    :: Checker,
    id   : ExprId,
    node : Expr,
    call : Call,
    ac   : Access,
    b    : Base,
    ctx  : Ctx
) Res<TyId, AllocError> {
    c.opaque(b.ty).match({
        true  => c.types.unknown(),
        false => c.known_receiver_call(id, node, call, ac, b, ctx),
    })
}

// LAW 6 BEFORE OVERLOAD RESOLUTION, and the same gate `sema_member.zen`
// puts before `pick`. A call resolves its own callee against the member
// table rather than going through `access_type`, so a method the asking
// module may not see arrives here and nowhere else — and a rule enforced
// on `v.grow` but not on `v.grow()` is enforced on the spelling nobody
// writes. Before, not after: a hidden member is not a candidate that
// loses to another, and falling through to `ufcs_call` would report it
// as a name the type does not have.
known_receiver_call = (
    c    :: Checker,
    id   : ExprId,
    node : Expr,
    call : Call,
    ac   : Access,
    b    : Base,
    ctx  : Ctx
)
                      Res<TyId, AllocError> {
    actuals ::= c.alloc.Vec<Actual>();
    c.actuals_of(call.args, ctx, actuals).try();
    found ::= c.alloc.Vec<Found>();
    c.members_of(b.ty, ac.name.text, found).try();
    first_hidden(found, ctx.module).match({
        Ok(f) => c.hidden_member(ac, f),
        None  => c.reachable_call(id, node, call, ac, b, found, actuals, ctx),
    })
}

reachable_call = (
    c       :: Checker,
    id      : ExprId,
    node    : Expr,
    call    : Call,
    ac      : Access,
    b       : Base,
    found   : Vec<Found>,
    actuals : Vec<Actual>,
    ctx     : Ctx
) Res<TyId, AllocError> {
    (found.len > 0).match({
        true  => c.method_call(node, call, found, actuals, ctx),
        false => c.ufcs_call(id, node, call, ac, b, actuals, ctx),
    })
}

// A method's receiver is its first parameter — "a method is a UFCS
// function whose first parameter happens to be named `self`" — so the
// arity a call site sees is one less than the signature's.
//
// DECLARED PARAMETER TYPES FIRST, AND ARITY ONLY AS A FALLBACK. This
// asked arity alone, and arity is the half of the rule that cannot
// separate `toString(self, out :: Sink)` from `toString(self, a:
// Alloc)` — both are two. So the answer was whichever the member table
// listed first, for a name whose whole point is that the ARGUMENT
// decides. `display.zen` says it where the two are declared: "overload
// resolution picks between them on the declared parameter type: a buffer
// or an allocator."
//
// The arity fallback is kept and is not laziness: `fits` is a question
// about types, and where a receiver's type is not settled, or the
// signature is variadic, it answers `false` for every candidate.
// Falling back leaves every call that resolves today resolving the same
// way, so this can only change an answer where a strictly better one
// exists.
method_call = (
    c       :: Checker,
    node    : Expr,
    call    : Call,
    found   : Vec<Found>,
    actuals : Vec<Actual>,
    ctx     : Ctx
) Res<TyId, AllocError> {
    c.pick_fitting(found, actuals).try().match({
        Ok(f) => c.sig_ret(node, call, f.ty, 1, ctx),
        None  => c.by_arity_ret(node, call, found, actuals, ctx),
    })
}

by_arity_ret = (
    c       :: Checker,
    node    : Expr,
    call    : Call,
    found   : Vec<Found>,
    actuals : Vec<Actual>,
    ctx     : Ctx
) Res<TyId, AllocError> {
    c.pick_arity(found, actuals.len + 1).match({
        None  => c.first_found_ret(node, call, found, ctx),
        Ok(f) => c.sig_ret(node, call, f.ty, 1, ctx),
    })
}

// The first member whose declared parameters accept these arguments.
// FIRST and not "the only one": two members accepting the same call is
// an overload set a call site cannot tell apart, and that is an error AT
// THE DECLARATION — `check_overloads` names both — because at a call
// site the two are indistinguishable and there is nothing to report.
pick_fitting = (c :: Checker, found: Vec<Found>, actuals: Vec<Actual>)
               Res<Res<Found>, AllocError> {
    kept ::= c.alloc.Vec<Found>();
    found.loop((h, f) { c.keep_fitting(f, actuals, kept).try() });
    Ok(first_found(kept));
}

// A named helper, as `keep_one`: docs/SEMA_BOOTSTRAP_FIXES.md §10.
keep_fitting = (
    c       :: Checker,
    f       : Found,
    actuals : Vec<Actual>,
    kept    :: Vec<Found>
) Res<(), AllocError> {
    params ::= c.alloc.Vec<TyId>();
    c.fn_params(f.ty, params).try();
    c.recv_sig_fits(params, actuals).try().match({
        true  => kept.add(f),
        false => Ok(()),
    })
}

// A member that is not a function has no parameters and fits no call.
fn_params = (c :: Checker, ty: TyId, out :: Vec<TyId>)
            Res<(), AllocError> {
    c.types.at(ty).match({
        Fn(f) => copy_tys(f.params, out),
        _     => Ok(()),
    }).try();
    Ok(());
}

copy_tys = (xs: Vec<TyId>, out :: Vec<TyId>) Res<(), AllocError> {
    xs.loop((h, x) { out.add(x).try() });
    Ok(());
}

pick_arity = (c: Checker, found: Vec<Found>, want: usize) Res<Found> {
    Range(0, found.len).find((i) {
        found.get(i).match({
            Ok(f) => c.fn_arity_is(f.ty, want),
            None  => false,
        })
    }).match({
        Ok(i) => found.get(i),
        None  => None,
    })
}

fn_arity_is = (c: Checker, ty: TyId, want: usize) bool {
    c.types.at(ty).match({ Fn(f) => f.params.len == want, _ => false })
}

first_found_ret = (
    c     :: Checker,
    node  : Expr,
    call  : Call,
    found : Vec<Found>,
    ctx   : Ctx
) Res<TyId, AllocError> {
    found.get(0).match({
        None  => c.types.unknown(),
        Ok(f) => c.sig_ret(node, call, f.ty, 1, ctx),
    })
}

// "A free function whose first param is the type is callable as a
// method." So the receiver becomes argument zero and resolution runs
// exactly as it does for `f(x, ..)` — there is no second mechanism.
ufcs_call = (
    c       :: Checker,
    id      : ExprId,
    node    : Expr,
    call    : Call,
    ac      : Access,
    b       : Base,
    actuals : Vec<Actual>,
    ctx     : Ctx
)
            Res<TyId, AllocError> {
    all ::= c.alloc.Vec<Actual>();
    all.add(Actual(
        ty: b.ty,
        is_lambda: false,
        arity: 0,
        named: false,
        span: node.span
    )).try();
    actuals.loop((h, a) { all.add(a).try() });
    c.decl_call(id, node, call, ac.name.text, Ok(b.ty), all, ctx)
}

indirect_call = (c :: Checker, node: Expr, call: Call, ctx: Ctx)
                Res<TyId, AllocError> {
    ty = c.type_of(call.callee, ctx).try();
    c.sig_ret(node, call, ty, 0, ctx)
}

// A CALL THROUGH A SIGNATURE THAT IS ALREADY A TYPE — a member the
// table answered with, a local holding a function, a variant
// constructor, a callee that is an expression. `off` IS THE RECEIVER,
// as `recv_off` decides it for the resolved-candidate path: a member's
// first parameter is its `self` and the written arguments start at one.
//
// Nothing is instantiated here, so a generic member's own `T` reaches
// the closure as itself. That is the same type the member's body is
// checked at, and no worse an answer than the one its declaration gives.
sig_ret = (
    c    :: Checker,
    node : Expr,
    call : Call,
    ty   : TyId,
    off  : usize,
    ctx  : Ctx
) Res<TyId, AllocError> {
    c.sig_lambdas(call, ty, off, ctx).try();
    c.sig_args_handle_check(node, call, ty, off, ctx).try();
    c.fn_ret(node, ty)
}

// THE SAME SEAT AS `chosen_ret`, ONE SURFACE OVER. `keep.add(h)` on a
// `Vec<LoopHandle>` resolves here, not through `decl_call` — and the
// refusal that #782 hung on the candidate path never ran, so zen said
// yes and cc read `zu_l1h` undeclared out of the monomorphised `add`.
// The signature is already a type, so its parameters ARE the settled
// formals; the same skip-the-lambda rule applies, and the receiver
// (`off`) is not an argument and is not asked.
//
// THE ONE SKIP THAT IS NOT A LAMBDA ARGUMENT: a callee whose NAME is a
// local binding holds a body, not a declaration — `body(h, k, v)`
// inside `map`, `pairs` — and the call is SPLICED
// (`gen_c_inline.lower_closure_call`), the same legal inward path a
// lambda argument takes. A member (`keep.add`) or a declaration
// (`take`) compiles for real and is asked. Fail-open on purpose: a
// local could only hold a real function through fn pointers, which the
// backend does not lower.
sig_args_handle_check = (
    c    :: Checker,
    node : Expr,
    call : Call,
    ty   : TyId,
    off  : usize,
    ctx  : Ctx
) Res<(), AllocError> {
    spliced = c.tree.expr_at(call.callee).kind.match({
        Name(n) => c.lookup(n.text).match({
            Ok(_) => true,
            None  => false,
        }),
        _       => false,
    });
    spliced.match({
        true  => Ok(()),
        false => {
            params ::= c.alloc.Vec<TyId>();
            c.fn_params(ty, params).try();
            c.args_handle_check(call.args, params, off, ctx).try();
            Ok(());
        },
    })
}

// The walk on its own, for the one caller that does not want `fn_ret`'s
// answer: a variant constructor's return is the enum at the
// instantiation its argument settled (`variant_call_type`), and its
// payload can still be a lambda.
sig_lambdas = (c :: Checker, call: Call, ty: TyId, off: usize, ctx: Ctx)
              Res<(), AllocError> {
    params ::= c.alloc.Vec<TyId>();
    c.fn_params(ty, params).try();
    c.arg_lambdas(call.args, params, off, ctx)
}

fn_ret = (c :: Checker, node: Expr, ty: TyId) Res<TyId, AllocError> {
    c.types.at(ty).match({
        Fn(f)   => Ok(f.ret),
        Unknown => Ok(ty),
        Infer   => Ok(ty),
        _       => c.not_callable(node, ty),
    })
}

not_callable = (c :: Checker, node: Expr, ty: TyId) Res<TyId, AllocError> {
    poison = c.types.unknown().try();
    c.report(
        node.span.file,
        node.span,
        SemaFault.NotCallable(TypeFault(name: "", expected: poison, found: ty))
    ).try();
    c.types.unknown()
}

// ---------------------------------------------------------------------
// the declaration-site rules
//
// An overload set is wrong WHERE IT IS WRITTEN, so both diagnostics
// carry both declarations' positions and neither carries a call's.
// ---------------------------------------------------------------------

check_overloads* = (c :: Checker, mi: usize, name: str)
                   Res<(), AllocError> {
    cands ::= c.alloc.Vec<Cand>();
    c.cands_of(mi, name, cands).try();
    Range(0, cands.len).loop((h, i) {
        Range(i + 1, cands.len).loop((h2, j) {
            c.check_pair(name, cands, i, j).try();
        });
    });
    Ok(());
}

check_pair = (c :: Checker, name: str, cands: Vec<Cand>, i: usize, j: usize)
             Res<(), AllocError> {
    cands.get(i).match({
        None  => Ok(()),
        Ok(a) => c.check_against(name, a, cands, j),
    })
}

check_against = (
    c     :: Checker,
    name  : str,
    a     : Cand,
    cands : Vec<Cand>,
    j     : usize
) Res<(), AllocError> {
    cands.get(j).match({
        None  => Ok(()),
        Ok(b) => c.compare(name, a, b),
    })
}

compare = (c :: Checker, name: str, a: Cand, b: Cand) Res<(), AllocError> {
    (a.params.len == b.params.len).match({
        true  => c.compare_same_arity(name, a, b),
        false => Ok(()),
    })
}

compare_same_arity = (c :: Checker, name: str, a: Cand, b: Cand)
                     Res<(), AllocError> {
    c.same_signature(a, b).match({
        true  => c.duplicate(name, a, b),
        false => c.maybe_swallow(name, a, b),
    })
}

// Names are documentation, so `<T>(first: T, second: T)` and
// `<T>(left: T, right: T)` are the SAME signature. Two type parameters
// in the same position are one type for this purpose: `<T>(a: T)` and
// `<U>(a: U)` differ in nothing a call site can see.
same_signature* = (c: Checker, a: Cand, b: Cand) bool {
    Range(0, a.params.len).find((i) {
        c.same_param(ty_at(a.params, i), ty_at(b.params, i)) == false
    }).match({ Ok(_) => false, None => true })
}

same_param = (c: Checker, x: TyId, y: TyId) bool {
    x.eq(y) || (c.is_tvar(x) && c.is_tvar(y))
}

maybe_swallow = (c :: Checker, name: str, a: Cand, b: Cand)
                Res<(), AllocError> {
    ((a.generic || b.generic) && c.swallows(a, b)).match({
        true  => ambiguous(c, name, a, b),
        false => Ok(()),
    })
}

// Either candidate's generic accepts everything the other's concrete
// parameter does, position by position. Only a type parameter
// belonging to the candidate being tested is a wildcard — that is what
// keeps `loop(range: R, ..)` and `loop(map: Map<K,V>, ..)` distinct.
swallows* = (c: Checker, a: Cand, b: Cand) bool {
    c.all_eat(a, b) || c.all_eat(b, a)
}

all_eat = (c: Checker, g: Cand, k: Cand) bool {
    g.generic && Range(0, g.params.len).find((i) {
        c.eats(ty_at(g.params, i), ty_at(k.params, i), g.owner) == false
    }).match({ Ok(_) => false, None => true })
}

eats = (c: Checker, x: TyId, y: TyId, owner: str) bool {
    c.var_of(x, owner) || x.eq(y) || c.structural_eats(x, y, owner)
}

var_of = (c: Checker, x: TyId, owner: str) bool {
    c.types.at(x).match({ Var(v) => v.owner.eq(owner), _ => false })
}

structural_eats = (c: Checker, x: TyId, y: TyId, owner: str) bool {
    c.types.at(x).match({
        Fn(f)    => c.fn_eats(f, y, owner),
        Named(n) => c.named_eats(n, y, owner),
        _        => false,
    })
}

fn_eats = (c: Checker, f: TyFn, y: TyId, owner: str) bool {
    c.types.at(y).match({
        Fn(g) => (f.params.len == g.params.len)
                     && c.all_eats(f.params, g.params, owner)
                     && c.eats(f.ret, g.ret, owner),
        _     => false,
    })
}

named_eats = (c: Checker, n: TyNamed, y: TyId, owner: str) bool {
    c.types.at(y).match({
        Named(m) => n.decl.eq(m.decl) && (n.args.len == m.args.len)
                        && c.all_eats(n.args, m.args, owner),
        _        => false,
    })
}

all_eats = (c: Checker, xs: Vec<TyId>, ys: Vec<TyId>, owner: str) bool {
    Range(0, xs.len).find((i) {
        c.eats(ty_at(xs, i), ty_at(ys, i), owner) == false
    }).match({ Ok(_) => false, None => true })
}

duplicate = (c :: Checker, name: str, a: Cand, b: Cand) Res<(), AllocError> {
    c.report(
        a.span.file,
        a.span,
        SemaFault.DuplicateSignature(PairFault(
            name: name,
            first: a.span,
            second: b.span
        ))
    )
}

ambiguous = (c :: Checker, name: str, a: Cand, b: Cand) Res<(), AllocError> {
    c.report(
        a.span.file,
        a.span,
        SemaFault.AmbiguousOverload(PairFault(
            name: name,
            first: a.span,
            second: b.span
        ))
    )
}
