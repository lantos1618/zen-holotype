// probeT: create via env.mem.alloc() inline (no Alloc-typed parameter)
Cell = {
    value: i64,
    next: Ptr<Cell>,
}

main = (env: Env) Res<i32, AllocError> {
    a ::= env.mem.alloc();
    cell = a.create<Cell>().try();
    cell.write(0, Cell(value: 7, next: null_ptr<Cell>()));
    println("v {}", cell.read(0).value);
    Ok(0);
}
