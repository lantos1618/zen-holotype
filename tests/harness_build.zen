        ),
        VerdictCase(
            src: "num = std.text.num\nmain = () i32 { r := num.try_float(1.5)  0 }\n",
            should_pass: false,
            kind: "undefined-name",
        ),
        VerdictCase(
            src: "text = std.text.str\nmain = () i32 { bs := text.dup_bytes(\"xy\")  0 }\n",
            should_pass: false,
            kind: "arg-type",
        ),
        VerdictCase(
            src: "text = std.text.str\nmain = () i32 { r := text.try_dup_bytes(\"xy\")  0 }\n",
            should_pass: false,
            kind: "undefined-name",
        ),
        VerdictCase(
            src: "text = std.text.str\nmain = () i32 { s := text.substr(\"hello\", 1, 3)  0 }\n",
            should_pass: false,
            kind: "arg-type",
        ),
        VerdictCase(
            src: "text = std.text.str\nmain = () i32 { r := text.try_substr(\"hello\", 1, 3)  0 }\n",
            should_pass: false,
            kind: "undefined-name",
        ),
        VerdictCase(
            src: "main = () i32 { undefined_thing }\n",
            should_pass: false,
            kind: "undefined-name",
        ),
        VerdictCase(
            src: "id = (n: i32) i32 { n }\nmain = () i32 { id(undefined_thing) }\n",
            should_pass: false,
            kind: "undefined-name",
        ),
        VerdictCase(
            src: "Box<T>: { v: T }\nmk<T> = (x: T) i64 { b := Box<T>(v: x)  sizeof(T) }\npick = (c: bool) bool { c.match ({ true => false, false => true }) }\nmain = () i32 { 0 }\n",
            should_pass: true,
            kind: "",
        ),
        VerdictCase(
            src: "R*: Ok(i32) | Err\nmain = () i32 { r := .Ok(7)  r.match({ .Ok(v) => v, .Err => 0 }) }\n",
            should_pass: true,
            kind: "",
        ),
        VerdictCase(
            src: "main = () i32 { true.match({ true => { x := 4  x }, false => 0 }) }\n",
            should_pass: true,
            kind: "",
