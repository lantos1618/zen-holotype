// src/std/json/json_write.zen
// JSON as a value, an arena over it, and the writer.
//
// This belongs in std rather than in any one protocol client: parsing or
// writing a JSON document names no higher-level subsystem. It stays a
// streaming value arena with no recursive tree allocation, not a document
// model the compiler itself must depend on.
//
// Children are ids rather than embedded values, which keeps recursive values
// fixed-size. Arrays and objects each name a contiguous run in a side list.
//
// Num stores its original lexeme because JSON accepts spellings that Zen
// numeric literals do not, including exponents and negative zero. `whole`
// provides the narrower non-negative-integer view when a protocol needs it.

str, String = std.text
Vec = std.collections
Alloc, AllocError = std.mem
Range = std.core
hex_digit, HEX_BASE = std.core.byte

// A typed index into a Jsons arena.
JsonId* = { index*: usize }

// A contiguous run in one of the side lists: arrays name a run of
// `items`, objects a run of `pairs`.
Run* = {
    at*: usize,
    len*: usize,
}

// One object member: the decoded key and its value. A lookup
// comparing raw lexemes would miss members whose escapes differ.
Pair* = {
    key*: str,
    value*: JsonId,
}

// The six JSON values. `Text` rather than `Str`, since `str` is a type
// in scope and a shadowing variant reads as a mistake.
Json* = Null
      | Bool(bool)
      | Num(str)      // the lexeme, verbatim
      | Text(str)     // the decoded bytes
      | Arr(Run)      // a run of `items`
      | Obj(Run)      // a run of `pairs`

// The arena — same shape and idea as sema's `Types`: one store owning
// every value, and ids that mean nothing without it.
Jsons* = {
    nodes :: Vec<Json>,
    items :: Vec<JsonId>,
    pairs :: Vec<Pair>,

    // An id outside this arena is a caller bug and traps through subtraction.
    at* = (self: @Self, id: JsonId) Json {
        self.nodes.len - id.index - 1;
        self.nodes.get(id.index).match({
            Ok(v) => v,
            None  => Json.Null,
        })
    }

    add* = (self :: @Self, v: Json) Res<JsonId, AllocError> {
        id = JsonId(index: self.nodes.len);
        self.nodes.add(v).try();
        Ok(id);
    }

    // Append a built-up list of children as one run, copied from a
    // caller-owned `Vec` since a nested array's own children land in
    // `items` between its siblings'.
    add_items* = (self :: @Self, ids: Vec<JsonId>) Res<Run, AllocError> {
        run = Run(at: self.items.len, len: ids.len);
        Range(0, ids.len).loop((h, i) {
            self.items.add(ids.get(i).value_or(JsonId(index: 0))).try();
        });
        Ok(run);
    }

    add_pairs* = (self :: @Self, ps: Vec<Pair>) Res<Run, AllocError> {
        run = Run(at: self.pairs.len, len: ps.len);
        Range(0, ps.len).loop((h, i) {
            self.pairs.add(ps.get(i).value_or(Pair(key: "", value: JsonId(index: 0)))).try();
        });
        Ok(run);
    }

    // --- reading ----------------------------------------------------
    //
    // Every one of these answers `None` rather than failing: a missing
    // field is refused by name, not a reason to stop reading the stream.

    // The named member, if id is an object. Duplicate keys use the last value.
    field* = (self: @Self, id: JsonId, name: str) Res<JsonId> {
        self.at(id).match({
            Obj(run) => self.scan(run, name),
            _        => None,
        })
    }

    scan = (self: @Self, run: Run, name: str) Res<JsonId> {
        found ::= JsonId(index: 0);
        have  ::= false;
        Range(run.at, run.at + run.len).loop((h, i) {
            p = self.pairs.get(i).value_or(Pair(key: "", value: JsonId(index: 0)));
            p.key.eq(name).then(() {
                found = p.value;
                have  = true;
            });
        });
        have.match({ true => Ok(found), false => None })
    }

    // Element i when id is an array and the index is in range.
    item* = (self: @Self, id: JsonId, i: usize) Res<JsonId> {
        self.at(id).match({
            Arr(run) => (i < run.len).match({
                true  => self.items.get(run.at + i),
                false => None,
            }),
            _        => None,
        })
    }

    text* = (self: @Self, id: JsonId) Res<str> {
        self.at(id).match({ Text(s) => Ok(s), _ => None })
    }

    // A JSON number read as a non-negative integer. None unless the complete
    // lexeme is decimal digits; signs, fractions, and exponents are rejected.
    whole* = (self: @Self, id: JsonId) Res<usize> {
        self.at(id).match({
            Num(lex) => lex.parse_usize(),
            _        => None,
        })
    }

    // --- writing ----------------------------------------------------

    // The value at `id`, as JSON, into `out`. Deterministic, no spaces:
    // members come out in the order read or built, so two runs over one
    // input produce one byte string — the round-trip gate's property.
    write* = (self: @Self, id: JsonId, out :: String) Res<(), AllocError> {
        self.at(id).match({
            Null     => out.add("null"),
            Bool(b)  => out.add(b.match({ true => "true", false => "false" })),
            Num(lex) => out.add(lex),
            Text(s)  => write_text(s, out),
            Arr(run) => self.write_items(run, out),
            Obj(run) => self.write_pairs(run, out),
        })
    }

    write_items = (self: @Self, run: Run, out :: String) Res<(), AllocError> {
        items ::= arr(out).try();
        Range(0, run.len).loop((h, i) {
            items.next(out).try();
            self.write(
                self.items.get(run.at + i).value_or(JsonId(index: 0)),
                out
            ).try();
        });
        items.close(out)
    }

    write_pairs = (self: @Self, run: Run, out :: String) Res<(), AllocError> {
        pairs ::= obj(out).try();
        Range(0, run.len).loop((h, i) {
            p = self.pairs.get(run.at + i).value_or(Pair(key: "", value: JsonId(index: 0)));
            pairs.key(p.key, out).try();
            self.write(p.value, out).try();
        });
        pairs.close(out)
    }
}

Jsons* = (a: Alloc) Jsons {
    Jsons(nodes: a.Vec<Json>(), items: a.Vec<JsonId>(), pairs: a.Vec<Pair>())
}

// `Ok(())` with its error side named — see `json_read.zen`'s `fine`.
written* = () Res<(), AllocError> { Ok(()) }

// --- a container being written ----------------------------------------
// Nest streams container punctuation without building an arena value. It
// owns separator placement, key escaping, and the matching closing bracket.
// A nested container has its own Nest, so nesting depth remains explicit in
// the caller.
Nest* = {
    said :: bool,
    ends: u8,

    // The separator this container owes before its next member, which is
    // nothing before the first — an array element calls this directly,
    // an object member gets it from `key`.
    next* = (self :: @Self, out :: String) Res<(), AllocError> {
        owed      = self.said;
        self.said = true;
        owed.match({ true => out.add(','), false => written() })
    }

    // `"name":`, with the comma before it and the escaping inside it.
    key* = (self :: @Self, name: str, out :: String) Res<(), AllocError> {
        self.next(out).try();
        write_text(name, out).try();
        out.add(':')
    }

    // A member whose value is a string — the common case, and the one
    // where forgetting to escape is a malformed reply rather than a
    // wrong number.
    text* = (self :: @Self, name: str, v: str, out :: String)
            Res<(), AllocError> {
        self.key(name, out).try();
        write_text(v, out)
    }

    // The bracket this container opened with, whichever it was.
    close* = (self: @Self, out :: String) Res<(), AllocError> {
        out.add(self.ends)
    }
}

// `{`, and the `}` that will close it.
obj* = (out :: String) Res<Nest, AllocError> {
    out.add('{').try();
    Ok(Nest(said: false, ends: '}'));
}

// `[`, and the `]` that will close it.
arr* = (out :: String) Res<Nest, AllocError> {
    out.add('[').try();
    Ok(Nest(said: false, ends: ']'));
}

// A JSON string literal, escaped, quotes included.
//
// Shared by the arena writer and direct reply writers, so this is a free
// function rather than a method on Jsons. The escape set is the JSON-required
// quote, backslash, and control
// bytes. Slash and UTF-8 bytes above 127 pass through unchanged.
write_text* = (s: str, out :: String) Res<(), AllocError> {
    out.add('"').try();
    Range(0, s.len).loop((h, i) {
        escaped(s.index(i), out).try();
    });
    out.add('"')
}

// Named escapes cover common controls; every other byte below 32 uses
// `\u00XX`.
escaped = (b: u8, out :: String) Res<(), AllocError> {
    b.match({
        '"'  => out.add("\\\""),
        '\\' => out.add("\\\\"),
        '\n' => out.add("\\n"),
        '\r' => out.add("\\r"),
        '\t' => out.add("\\t"),
        _    => (b < SPACE).match({
            true  => hex_escape(b, out),
            false => out.add(b),
        }),
    })
}

// `\u00XX`, reachable only for a byte below 32 — the high two digits are
// always `00` and are written rather than computed.
hex_escape = (b: u8, out :: String) Res<(), AllocError> {
    out.add("\\u00").try();
    out.add(hex_digit(b / HEX_BASE)).try();
    out.add(hex_digit(b % HEX_BASE))
}

SPACE*: u8 = ' '
