// src/gen/gen_c/gen_c_infer.zen
// Complete generic call instantiations left open after sema. Settled calls
// pass through unchanged.

ExprId, Decl, Function, Param = std.ast
Access, Call, Member = std.ast
AllocError = std.mem
Vec = std.collections
str = std.text
TyId = sema.sema_ty
Def, decl_at = sema.sema_def
Ctx = sema.sema_check
Inst = sema.sema_inst
type_from_ast = sema.sema_denote
pack_slot, pack_elem = sema.sema_vararg
CBackend = gen.gen_c.gen_c_state
declared_ret = gen.gen_c.gen_c_type
inst_at, inst_open, settled_inst = gen.gen_c.gen_c_mono
sub_with, unify, arg_type = gen.gen_c.gen_c_mono
enter_tparams, leave_tparams = gen.gen_c.gen_c_mono
fat_ret_type = gen.gen_c.gen_c_bound
impl_member_at, bodied_fn = gen.gen_c.gen_c_impl
site_of, method_sig = gen.gen_c.gen_c_member
Site = gen.gen_c.gen_c_member
recv_inst = gen.gen_c.gen_c_mono

// Stable call facts are receiver state; the backend and accumulating answer
// remain explicit mutable borrows.
InferCall = {
    call: Call,
    recv: Res<ExprId>,
    ctx: Ctx,

    complete = (self: @Self, be :: CBackend, d: Def, f: Function,
                settled: Inst) Res<Inst, AllocError> {
        be.inst_open(settled).match({
            false => Ok(settled),
            true  => self.infer(be, d, f),
        })
    }

    infer = (self: @Self, be :: CBackend, d: Def, f: Function)
            Res<Inst, AllocError> {
        dctx = decl_ctx(d);
        mark = be.enter_tparams(f.tparams, d.qname).try();
        declared ::= be.alloc.Vec<TyId>();
        f.params.loop((h, p) { written_param(be, p, dctx, declared).try() });
        found ::= be.alloc.Inst();
        at = UnifyCall(declared: declared, ctx: self.ctx);
        at.receiver(be, self.recv, found).try();
        first = self.recv.match({ Ok(_) => 1, None => 0 });
        self.call.args.loop((h, i, a) {
            at.arg(be, a.value, i + first, found).try();
        });
        be.leave_tparams(mark).try();
        be.settled_inst(f.tparams, d.qname, found)
    }
}

// The declared vector and caller context are read-only for the whole walk.
UnifyCall = {
    declared: Vec<TyId>,
    ctx: Ctx,

    receiver = (self: @Self, be :: CBackend, recv: Res<ExprId>, out :: Inst)
               Res<(), AllocError> {
        recv.match({ None => Ok(()), Ok(base) => self.arg(be, base, 0, out) })
    }

    arg = (self: @Self, be :: CBackend, value: ExprId, i: usize,
           out :: Inst) Res<(), AllocError> {
        pack_slot(be.types(), self.declared).match({
            None     => self.declared_arg(be, value, i, out),
            Ok(slot) => self.packed_arg(be, value, i, slot, out),
        })
    }

    declared_arg = (self: @Self, be :: CBackend, value: ExprId, i: usize,
                    out :: Inst) Res<(), AllocError> {
        self.declared.get(i).match({
            None  => Ok(()),
            Ok(d) => self.against(be, value, d, out),
        })
    }

    // Swallowed arguments use the pack element. Forwarded packs structurally
    // unify with the pack itself.
    packed_arg = (self: @Self, be :: CBackend, value: ExprId, i: usize,
                  slot: usize, out :: Inst) Res<(), AllocError> {
        (i < slot).match({
            true  => self.declared_arg(be, value, i, out),
            false => self.swallowed(be, value, slot, out),
        })
    }

    swallowed = (self: @Self, be :: CBackend, value: ExprId, slot: usize,
                  out :: Inst) Res<(), AllocError> {
        pack    = self.declared.get(slot).match({
            Ok(t) => t,
            None  => TyId(index: 0),
        });
        unknown = be.check.types.unknown().try();
        actual  = be.arg_type(value, self.ctx, unknown).try();
        unify(be, against_pack(be, pack, actual), actual, out)
    }

    against = (self: @Self, be :: CBackend, value: ExprId, d: TyId,
               out :: Inst) Res<(), AllocError> {
        unknown = be.check.types.unknown().try();
        actual  = be.arg_type(value, self.ctx, unknown).try();
        unify(be, d, actual, out)
    }
}

complete_inst* = (
    be      :: CBackend,
    c       : Call,
    d       : Def,
    f       : Function,
    settled : Inst,
    recv    : Res<ExprId>,
    ctx     : Ctx
)
                  Res<Inst, AllocError> {
    InferCall(call: c, recv: recv, ctx: ctx).complete(be, d, f, settled)
}

decl_ctx = (d: Def) Ctx {
    Ctx(
        module: d.id.module.to_usize(),
        ret: TyId(index: 0),
        has_ret: false,
        self_ty: TyId(index: 0),
        has_self: false
    )
}

// Parameter types stay as written: unification needs `Vec<T>`.
written_param = (be :: CBackend, p: Param, dctx: Ctx, out :: Vec<TyId>)
                Res<(), AllocError> {
    p.type.match({
        None  => Ok(()),
        Ok(t) => out.add(be.check.type_from_ast(t, dctx).try()),
    })
}

against_pack = (be: CBackend, pack: TyId, actual: TyId) TyId {
    pack_elem(be.types(), actual).match({
        Ok(_) => pack,
        None  => pack_elem(
            be.types(),
            pack
        ).match({ Ok(e) => e, None => pack }),
    })
}

// Keeps `(id, call, receiver, context, fallback)` out of every step in the
// name -> definition -> declaration -> function walk.
ReturnCall = {
    id: ExprId,
    call: Call,
    recv: Res<ExprId>,
    ctx: Ctx,
    want: TyId,

    resolve = (self: @Self, be :: CBackend) Res<TyId, AllocError> {
        be.tree.expr_at(self.call.callee).kind.match({
            Name(n)   => self.named(be, n.text),
            Access(a) => self.accessed(be, a),
            _         => Ok(self.want),
        })
    }

    // Bound members have no `Def`; their dedicated rule runs first.
    accessed = (self: @Self, be :: CBackend, a: Access)
               Res<TyId, AllocError> {
        be.fat_ret_type(self.call, a, self.ctx).try().match({
            Ok(t) => Ok(t),
            None  => ImplAccess(access: a, ctx: self.ctx).resolve(be).try().match({
                Ok(t) => Ok(t),
                None  => self.with_recv(Ok(a.base)).named(be, a.name.text),
            }),
        })
    }

    with_recv = (self: @Self, recv: Res<ExprId>) ReturnCall {
        ReturnCall(
            id: self.id,
            call: self.call,
            recv: recv,
            ctx: self.ctx,
            want: self.want
        )
    }

    // One candidate or nothing; overload resolution remains sema's rule.
    named = (self: @Self, be :: CBackend, name: str)
            Res<TyId, AllocError> {
        found ::= be.alloc.Vec<Def>();
        be.check.world.defs_of(self.ctx.module, name, found).try();
        found.len.match({
            1 => found.get(0).match({
                None  => Ok(self.want),
                Ok(d) => self.definition(be, d),
            }),
            _ => Ok(self.want),
        })
    }

    definition = (self: @Self, be :: CBackend, d: Def)
                 Res<TyId, AllocError> {
        decl_at(be.tree, d.id).match({
            None    => Ok(self.want),
            Ok(dec) => dec.kind.match({
                Function(f) => self.function(be, d, f),
                _           => Ok(self.want),
            }),
        })
    }

    function = (self: @Self, be :: CBackend, d: Def, f: Function)
               Res<TyId, AllocError> {
        raw      = be.inst_at(self.id).try();
        settled  = be.settled_inst(f.tparams, d.qname, raw).try();
        inst     = InferCall(call: self.call, recv: self.recv, ctx: self.ctx)
            .complete(be, d, f, settled).try();
        mark     = be.enter_tparams(f.tparams, d.qname).try();
        declared = be.declared_ret(f, decl_ctx(d)).try();
        be.leave_tparams(mark).try();
        be.sub_with(declared, inst)
    }
}

// Impl-supplied member return at the receiver's concrete instantiation.
MemberReturn = {
    site: Site,
    receiver: TyId,

    supplied = (self: @Self, be :: CBackend, name: str)
               Res<Res<TyId>, AllocError> {
        found ::= be.alloc.Vec<Member>();
        be.impl_member_at(self.site.decl, name, found).try();
        bodied_fn(found).match({
            None  => Ok(None),
            Ok(f) => self.settled(be, f),
        })
    }

    settled = (self: @Self, be :: CBackend, f: Function)
              Res<Res<TyId>, AllocError> {
        inst = be.recv_inst(self.receiver).try();
        sig ::= be.alloc.Vec<TyId>();
        be.method_sig(
            self.receiver,
            self.site.decl,
            f,
            self.site.decl.module.to_usize(),
            inst,
            sig
        ).try();
        (be.inst_open(inst) || be.any_open(sig)).match({
            true  => Ok(None),
            false => Ok(Ok(self.declared(be, f, inst).try())),
        })
    }

    declared = (self: @Self, be :: CBackend, f: Function, inst: Inst)
               Res<TyId, AllocError> {
        sctx = be.check.self_ctx(
            self.site.decl.module.to_usize(),
            self.site.ty
        ).try();
        mark = be.enter_struct_tparams(self.site.decl).try();
        ret  = be.declared_ret(f, sctx).try();
        be.leave_tparams(mark).try();
        be.sub_with(ret, inst)
    }
}

ImplAccess = {
    access: Access,
    ctx: Ctx,

    resolve = (self: @Self, be :: CBackend) Res<Res<TyId>, AllocError> {
        unknown = be.check.types.unknown().try();
        rty     = be.ty_of(self.access.base, self.ctx, unknown).try();
        be.site_of(rty).try().match({
            None     => Ok(None),
            Ok(site) => MemberReturn(site: site, receiver: rty)
                .supplied(be, self.access.name.text),
        })
    }
}

// What a call evaluates to at the arguments' settled instantiation.
call_ret_type* = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    ctx  : Ctx,
    want : TyId
) Res<TyId, AllocError> {
    ReturnCall(id: id, call: c, recv: None, ctx: ctx, want: want).resolve(be)
}
