// src/fmt/fmt.zen
// PLAN.md stage 2: `parse |> print`.
//
// THE SAME PARSER AND THE SAME TRIVIA — nothing here reads a byte of
// Zen; `lex` reads bytes, `parse` builds the tree, this file walks the
// same tree the compiler is checked against. PLAN.md rule 2: never a
// second parser, never a second AST, never a "just for the formatter"
// path.
//
// WHAT THIS STAGE FORMATS, deliberately narrow:
//   - the file's SHAPE: declarations in source order, one per line,
//     with their leading/trailing comments.
//   - BLANK LINES: a run collapses to one; dropped before the first
//     decl or after the last; file ends with exactly one newline
//     (`fmt_out.zen`).
//   - trailing whitespace after a declaration.
//   - the WIDTH OF THE GAP before a match arm's `=>` (`fmt_decl.zen`,
//     the one rule here that knows what it's looking at — DESIGN.md
//     asks for aligned arms and the parser already locates every `=>`).
//
// WHAT IT PASSES THROUGH VERBATIM: every declaration's own text, minus
// that one gap — struct bodies, signatures, arm bodies, everything.
// These forms could be rebuilt from the AST, but rebuilding means
// layout decisions nobody has written down yet, and a printer
// inventing them would silently reflow the whole corpus on its first
// run. Remaining rules (short arms on one line, wrapping, trailing
// commas) arrive in `fmt_decl.zen` one form at a time, against a
// corpus — each one MOVES or ADDS a token, the line the guard below
// draws, which is why `=>` alignment (which moves neither) went first.
//
// WHAT IT REFUSES: a file with lexical or syntactic faults — a tree
// with a hole no longer describes the source, and printing from one is
// how a formatter eats code.
//
// THE GUARD — `faithful` below: formatting moves whitespace and
// nothing else, so the output's token stream must equal the input's,
// one for one, comments included. Checkable in one extra `scan`; turns
// "silently reflowed something unmodeled" from a shipped bug into an
// outcome that cannot leave this function.

Alloc, AllocError = std.mem
str, String = std.text
Vec = std.collections
Range = std.core
Pos, TriviaRun = ast.ast_span
Ast = ast.ast_arena
Module, Decl = ast.ast_node
scan, Source, Lexed, text_of = lex.lex
Diag, Parser, module = parse.parse
same = parse.parse_token

Src* = fmt.fmt_src
Out* = fmt.fmt_out
Aligned* = fmt.fmt_decl

// What formatting one file came to. Three fields, not a three-way enum:
// a caller acts on all three at once (print diags, compare text, refuse
// to write when the guard fails), which an enum would force into a
// match over things that are never in conflict.
Render* = {
    // Meaningful only when `diags` is empty and `faithful` is true;
    // empty otherwise.
    text*: String,

    // Non-empty means the file was NOT formatted — caller reports these
    // and leaves the bytes alone.
    diags*: Vec<Diag>,

    // The output lexes to the same tokens as the input. False is a bug
    // in this folder; writing anyway turns a formatter into an editor.
    faithful*: bool,
}

// Format one already-lexed file. Takes `Lexed` not bytes so LEXICAL
// faults stay with the caller: `lex.zen`'s contract is that a file with
// them is reported, not parsed — the same split `zen_build.zen` makes.
render* = (a: Alloc, lexed: Lexed) Res<Render, AllocError> {
    src = a.Src(lexed.source.text).try();
    p ::= a.Parser(lexed);
    m = p.module(lexed.source.file).try();
    (p.diags.len == 0).match({
        false => rejected(a, p.diags),
        true  => printed(a, src, p.tree, m, lexed),
    })
}

rejected = (a: Alloc, diags: Vec<Diag>) Res<Render, AllocError> {
    Ok(Render(text: a.String().try(), diags: diags, faithful: false));
}

printed = (a: Alloc, src: Src, tree: Ast, m: Module, lexed: Lexed)
          Res<Render, AllocError> {
    out ::= a.Out().try();
    write_module(out, a, a.Aligned(src, tree).try(), src, tree, m).try();
    ok = unchanged_tokens(a, lexed, out.view()).try();
    Ok(Render(text: out.text, diags: a.Vec<Diag>(), faithful: ok));
}

// -------------------------------------------------------------------
// printing
// -------------------------------------------------------------------

// The file: every declaration in source order, and the trivia that
// belongs to each. `Module.decls` IS the file, imports included (see
// ast_node.zen), so there's one loop here and no second pass.
write_module* = (out :: Out, a: Alloc, al: Aligned, src: Src, tree: Ast,
                 m: Module) Res<(), AllocError> {
    m.decls.loop((h, i, d) {
        write_trivia(out, tree, d.leading).try();
        write_decl(out, a, al, src, tree, m, i, d).try();
    });
    write_trivia(out, tree, m.trailing).try();
    Ok(());
}

// A run of comments and blanks, at the left margin. `text` is the raw
// source slice, so a six-line block comment is one `say` of six lines.
// Nothing here parses or rewraps a comment (ast_span.zen).
write_trivia = (out :: Out, tree: Ast, run: TriviaRun) Res<(), AllocError> {
    Range(0, run.len).loop((h, i) {
        piece = tree.trivia_at(run, i);
        piece.kind.match({
            Blank => out.blank(),
            _     => out.say_at(piece.span.start.col, piece.text),
        }).try();
    });
    Ok(());
}

// One declaration, as its author wrote it: from its first token to the
// start of the next printed thing, trailing whitespace trimmed.
//
// BOUNDED BY THE NEXT PRINTED ITEM, NOT THE DECLARATION'S OWN SPAN —
// the difference between a formatter and one that eats comments. E.g.
// in `Cli* = Build(Job) | Missing(str)   // a flag ..`, the trailing
// comment belongs to the last VARIANT, not the declaration, so
// `Decl.span`/`Decl.trailing` stop short and a slice cut to either
// would drop it. Copying the whole gap between printed items also
// preserves the comment's alignment column.
//
// DELETED: trailing whitespace (not a token, per the guard) and blank
// lines (they live as `Blank` trivia in the NEXT item's leading run).
//
// WIDENED/NARROWED: the gap before a match arm's `=>` (`fmt_decl.zen`),
// applied HERE inside the verbatim copy rather than by a rebuilding
// printer — the bytes stay the author's, only that one gap's width is
// set.
write_decl = (out :: Out, a: Alloc, al: Aligned, src: Src, tree: Ast,
              m: Module, i: usize, d: Decl) Res<(), AllocError> {
    from = src.offset(d.span.start);
    to = src.offset(next_start(tree, m, i));
    text = al.padded(a, src, from, src.trim_back(from, to),
                     d.span.start.line).try();
    out.say(text.view())
}

// Where the next thing this file prints begins: the following
// declaration's leading trivia, or the declaration itself, or — after
// the last one — whatever is left at end of file.
next_start = (tree: Ast, m: Module, i: usize) Pos {
    m.decls.get(i + 1).match({
        Ok(next) => run_start(tree, next.leading).match({
            Ok(p) => p,
            None  => next.span.start,
        }),
        None     => run_start(tree, m.trailing).match({
            Ok(p) => p,
            None  => m.span.end,
        }),
    })
}

run_start = (tree: Ast, run: TriviaRun) Res<Pos> {
    (run.len == 0).match({
        true  => None,
        false => Ok(tree.trivia_at(run, 0).span.start),
    })
}

// -------------------------------------------------------------------
// the guard
// -------------------------------------------------------------------

// The output says exactly what the input said.
//
// Whitespace is not a token, a comment IS one — everything this stage
// may change is invisible to the lexer, everything it may not is a
// token. So the streams must match one for one (count, kind, bytes),
// and any rule added later is checked by the same three lines. Costs
// one extra scan, the price of proving a subset formatter untouched
// the rest.
//
// Not named `faithful` (that's `Render`'s field): a free function and
// a field of one name would collide for the resolver.
unchanged_tokens = (a: Alloc, before: Lexed, text: str) Res<bool, AllocError> {
    after = scan(a, Source(file: before.source.file, text: text)).try();
    Ok(after.is_clean() && same_stream(before, after));
}

same_stream = (before: Lexed, after: Lexed) bool {
    (before.tokens.len == after.tokens.len) && every_token_same(before, after)
}

every_token_same = (before: Lexed, after: Lexed) bool {
    ok ::= true;
    Range(0, before.tokens.len).loop((h, i) {
        token_same(before, after, i).match({
            true  => (),
            false => { ok = false; h.break(); },
        });
    });
    ok;
}

// Kind AND bytes: kind alone would let one identifier become another;
// bytes alone would suffice only if the lexer is context-free — asking
// for both costs one comparison and removes the need to be sure of that.
token_same = (before: Lexed, after: Lexed, i: usize) bool {
    before.tokens.get(i).match({
        None  => false,
        Ok(x) => after.tokens.get(i).match({
            None  => false,
            Ok(y) => x.kind.same(y.kind)
                  && text_of(before.source, x).eq(text_of(after.source, y)),
        }),
    })
}
