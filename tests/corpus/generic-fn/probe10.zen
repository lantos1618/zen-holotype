// PROBE 10: boundary of the primitive-ctor bug. Real structs: named +
// positional args. Primitives: positional + named + nested.
Pt = { x: i32, y: i32 }

main = (env: Env) Res<i32, AllocError> {
    a = Pt(x: 11, y: 22);
    println("named {} {}", a.x, a.y);
    b = Pt(33, 44);
    println("positional {} {}", b.x, b.y);
    c = Pt(y: 66, x: 55);
    println("reordered {} {}", c.x, c.y);
    Ok(0);
}
