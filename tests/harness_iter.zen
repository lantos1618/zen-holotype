// tests/harness_iter.zen — the ITER category of the Zen-native correctness harness: exercises the
// std.collections.iter combinator toolkit (sum/product/count_if/any/all/none/min_of/max_of/reduce/
// position/fold_to and the allocator-threaded producers range_in/take_in/zip_in) end to end.
//
// The value-case runner (harness_value) has no module resolver, so — like harness_misc's num_parse /
// hashing suites — this drives ONE real program through `./zen run` (which resolves std.collections.iter's
// full closure) and asserts its labelled stdout lines contain the expected results. Each assertion is a
// self-contained fact (e.g. an empty slice's min_of is `.None`), so a miscompiled combinator flips its
// line and fails the case. See harness_lib.zen for the run_suite contract.
//
// Every predicate combinator is asserted in BOTH directions (`allf`/`nonef`), and fold_to is asserted on
// a value that depends on every element (`ftoi`). Without those, `all`/`none` were only ever expected
// true and `fold_to` only ever expected a value its last element alone produces: stubbing `all` to
// `{ true }` left this suite green.
{ run_suite } = harness_lib
{ Malloc, malloc, free } = std.mem.alloc
{ out, save, contents_in, shell } = std.io.file
{ len } = std.text.str
{ zo_path, zo_cmd } = harness_lib
// read a scratch file's whole contents, or "" if it could not be read.
hi_read = (mp: MutPtr<Malloc>, path: StringView) StringView {
    mp.contents_in(path).match ({
        .Ok(t)  => t,
        .Err(e) => "",
    })
}
// The one program under test: imports the iter surface, prints one labelled line per fact.
ITER_PROG := "{ Malloc } = std.mem.alloc\n{ put } = std.text.fmt\n{ sum, product, count_if, any, all, none, min_of, max_of, reduce, position, fold_to, range_in, take_in, zip_in } = std.collections.iter\nmain = () i32 {\n    m := Malloc(_: 0)\n    mp := m.addr()\n    xs: [i64] := [1, 2, 3]\n    d: i64 := 0 - 1\n    put(\"sum=\").i(sum(xs)).nl()\n    ps: [i64] := [1, 2, 3, 4]\n    put(\"prod=\").i(product(ps)).nl()\n    put(\"cif=\").i(ps.count_if((x){ x % 2 == 0 })).nl()\n    put(\"any=\").b(xs.any((x){ x == 2 })).nl()\n    put(\"all=\").b(xs.all((x){ x > 0 })).nl()\n    put(\"none=\").b(xs.none((x){ x > 9 })).nl()\n    put(\"allf=\").b(xs.all((x){ x > 2 })).nl()\n    put(\"nonef=\").b(xs.none((x){ x == 2 })).nl()\n    put(\"min=\").i(xs.min_of().match ({ .Some(v) => v, .None => d })).nl()\n    put(\"max=\").i(xs.max_of().match ({ .Some(v) => v, .None => d })).nl()\n    empty: [i64] := []\n    put(\"emin=\").b(empty.min_of().match ({ .Some(v) => false, .None => true })).nl()\n    put(\"red=\").i(xs.reduce((a, b){ a + b }).match ({ .Some(v) => v, .None => d })).nl()\n    put(\"ered=\").b(empty.reduce((a, b){ a + b }).match ({ .Some(v) => false, .None => true })).nl()\n    put(\"pos=\").i(xs.position((x){ x == 3 }).match ({ .Some(v) => v, .None => d })).nl()\n    put(\"epos=\").b(xs.position((x){ x == 9 }).match ({ .Some(v) => false, .None => true })).nl()\n    put(\"fto=\").b(ps.fold_to(false, (acc: bool, x: i64) bool { acc || x > 3 })).nl()\n    z0: i64 := 0\n    put(\"ftoi=\").i(ps.fold_to(z0, (acc: i64, x: i64) i64 { acc + x })).nl()\n    r := mp.range_in(5).expect(\"range\")\n    put(\"rlen=\").i(r.len).s(\" r0=\").i(r[0]).s(\" r4=\").i(r[4]).s(\" rsum=\").i(sum(r)).nl()\n    tk := mp.take_in(ps, 2).expect(\"take\")\n    put(\"tklen=\").i(tk.len).s(\" tksum=\").i(sum(tk)).nl()\n    ys: [i64] := [10, 20]\n    z := mp.zip_in(xs, ys).expect(\"zip\")\n    put(\"zlen=\").i(z.len).s(\" za0=\").i(z[0].a).s(\" zb0=\").i(z[0].b).s(\" za1=\").i(z[1].a).s(\" zb1=\").i(z[1].b).nl()\n    0\n}\n"
COUNT_PROG := "{ put } = std.text.fmt\n{ times, times_while, upto, upto_while } = std.core.count\nfirst_at_least = (xs: [i64], lim: i64) i64 {\n    xs.len.times((i) {\n        (xs[i] >= lim).then({\n            return xs[i]\n        })\n    })\n    0 - 1\n}\nmain = () i32 {\n    e: i64 := 0\n    0.times((i) { e = e + 1 })\n    put(\"empty=\").i(e).nl()\n    one: i64 := 0\n    1.times((i) { one = one + 1 + i })\n    put(\"one=\").i(one).nl()\n    neg: i64 := 0\n    (0 - 4).times((i) { neg = neg + 1 })\n    put(\"neg=\").i(neg).nl()\n    t: i64 := 0\n    5.times((i) { t = t + i })\n    put(\"sum5=\").i(t).nl()\n    u: i64 := 0\n    3.upto(7, (i) { u = u + i })\n    put(\"upto=\").i(u).nl()\n    eu: i64 := 0\n    7.upto(3, (i) { eu = eu + 1 })\n    put(\"eupto=\").i(eu).nl()\n    hits: i64 := 0\n    st := 10.times_while((i) {\n        hits = hits + 1\n        i < 4\n    })\n    put(\"stop=\")\n        .i(st)\n        .s(\" hits=\")\n        .i(hits)\n        .nl()\n    full := 3.times_while((i) { true })\n    put(\"full=\").i(full).nl()\n    uw := 2.upto_while(9, (i) { i < 5 })\n    put(\"uw=\").i(uw).nl()\n    grid: i64 := 0\n    3.times((r) { 4.times((c) { grid = grid + r * 4 + c }) })\n    put(\"grid=\").i(grid).nl()\n    seen: i64 := 0\n    xs: [i64] := [1, 2, 3]\n    xs.loop((h, k, x) {\n        2.times((j) {\n            seen = seen + 1\n            (k == 1).then({\n                h.break\n            })\n        })\n    })\n    put(\"brk=\").i(seen).nl()\n    put(\"ret=\").i(xs.first_at_least(2)).nl()\n    w: i32 := 4\n    ww: i64 := 0\n    w.times((k) { ww = ww + k.to_i64() })\n    put(\"w32=\").i(ww).nl()\n    0\n}\n"
LOOP_PROG := "{ put } = std.text.fmt\n{ advance_while, repeat_while, step_while } = std.core.count\nfirst_gap = (v: [u8], from: i64) i64 {\n    from.advance_while((p) {\n        (p >= v.len).then({\n            return 0 - 1\n        })\n        v[p] != ' '\n    })\n}\ncap_param = (n: i64) i64 {\n    seen: i64 := 0 - 1\n    repeat_while((q) {\n        seen = n\n        false\n    })\n    seen\n}\ncap_param_i = (i: i64) i64 {\n    seen: i64 := 0 - 1\n    repeat_while((q) {\n        seen = i\n        false\n    })\n    seen\n}\ncap_local = (v: i64) i64 {\n    n := v\n    seen: i64 := 0 - 1\n    repeat_while((q) {\n        seen = n\n        false\n    })\n    seen\n}\ncap_step = (n: i64) i64 {\n    seen: i64 := 0 - 1\n    0.step_while((q) { q < 1 }, (q) {\n        seen = n\n        q + 1\n    })\n    seen\n}\nmain = () i32 {\n    v: [u8] := ['a', 'b', 'c', ' ', 'd']\n    put(\"adv=\").i(0.advance_while((p) { p < v.len && v[p] != ' ' })).nl()\n    zs: i64 := 0\n    put(\"adv0=\").i(3.step_while((p) { p < v.len && v[p] != ' ' }, (p) {\n        zs = zs + 1\n        p + 1\n    })).nl()\n    put(\"zsteps=\").i(zs).nl()\n    put(\"back=\").i(v.len.step_while((p) { p > 0 && v[p - 1] != ' ' }, (p) { p - 1 })).nl()\n    e: [u8] := ['x', '\\\\', ' ', 'y', ' ']\n    put(\"var=\").i(0.step_while((p) { p < e.len && e[p] != ' ' }, (p) {\n        (e[p] == '\\\\').then({ p + 2 }, { p + 1 })\n    })).nl()\n    n: i64 := 0\n    0.step_while((p) { p < v.len }, (p) {\n        (v[p] == ' ').then({\n            n = n + 1\n        })\n        p + 1\n    })\n    put(\"carry=\").i(n).nl()\n    once: i64 := 0\n    put(\"rep1=\").i(repeat_while((k) {\n        once = once + 1\n        false\n    })).nl()\n    put(\"once=\").i(once).nl()\n    acc: i64 := 0\n    put(\"reps=\").i(repeat_while((k) {\n        acc = acc + k\n        acc < 6\n    })).nl()\n    put(\"acc=\").i(acc).nl()\n    put(\"ret=\").i(v.first_gap(0)).nl()\n    put(\"retn=\").i(v.first_gap(4)).nl()\n    seen: i64 := 0\n    xs: [i64] := [1, 2, 3]\n    xs.loop((h, k, x) {\n        0.advance_while((p) {\n            seen = seen + 1\n            p < 1\n        })\n        (k == 1).then({\n            h.break\n        })\n    })\n    put(\"brk=\").i(seen).nl()\n    w: i32 := 0\n    put(\"w32=\").i(w.advance_while((p) { p < 3 }).to_i64()).nl()\n    put(\"capp=\").i(cap_param(5)).nl()\n    put(\"capi=\").i(cap_param_i(6)).nl()\n    put(\"capl=\").i(cap_local(7)).nl()\n    put(\"caps=\").i(cap_step(8)).nl()\n    0\n}\n"
harness_iter_run* = () i32 {
    m := Malloc(_: 0)
    mp := m.addr()
    save(mp.zo_path("zo_iter.zen"), ITER_PROG, len(ITER_PROG))
    save(mp.zo_path("zo_iter.out"), "", 0)
    shell(mp.zo_cmd("./zen run $ZT/zo_iter.zen > $ZT/zo_iter.out 2>/dev/null"))
    txt := mp.hi_read(mp.zo_path("zo_iter.out"))
    fails := run_suite("iter (run)", [txt.contains("sum=6\n"), txt.contains("prod=24\n"), txt.contains("cif=2\n"), txt.contains("any=true\n"), txt.contains("all=true\n"), txt.contains("none=true\n"), txt.contains("allf=false\n"), txt.contains("nonef=false\n"), txt.contains("min=1\n"), txt.contains("max=3\n"), txt.contains("emin=true\n"), txt.contains("red=6\n"), txt.contains("ered=true\n"), txt.contains("pos=2\n"), txt.contains("epos=true\n"), txt.contains("fto=true\n"), txt.contains("ftoi=10\n"), txt.contains("rlen=5 r0=0 r4=4 rsum=10\n"), txt.contains("tklen=2 tksum=3\n"), txt.contains("zlen=2 za0=1 zb0=10 za1=2 zb1=20\n")])
    fails + mp.hi_count_run() + mp.hi_loop_run()
}
// The COUNT-ITERATION suite: the allocation-free `times`/`upto` count loops (and their early-exit
// `_while` pair). Facts asserted here are the ones an off-by-one in the bound flips — an empty range
// (`empty`/`eupto`), a single step (`one`), a negative count (`neg`), the full sums (`sum5`/`upto`/
// `w32`), a nested pair of count loops (`grid`) — plus the two early exits that are half the reason
// `@while` gets reached for: `h.break` of an ENCLOSING `.loop` fired from inside a count body (`brk`)
// and a `return` out of the enclosing function (`ret`).
hi_count_run = (mp: MutPtr<Malloc>) i32 {
    save(mp.zo_path("zo_count.zen"), COUNT_PROG, len(COUNT_PROG))
    save(mp.zo_path("zo_count.out"), "", 0)
    shell(mp.zo_cmd("./zen run $ZT/zo_count.zen > $ZT/zo_count.out 2>/dev/null"))
    txt := mp.hi_read(mp.zo_path("zo_count.out"))
    run_suite("iter count (run)", [txt.contains("empty=0\n"), txt.contains("one=1\n"), txt.contains("neg=0\n"), txt.contains("sum5=10\n"), txt.contains("upto=18\n"), txt.contains("eupto=0\n"), txt.contains("stop=4 hits=5\n"), txt.contains("full=3\n"), txt.contains("uw=5\n"), txt.contains("grid=66\n"), txt.contains("brk=3\n"), txt.contains("ret=2\n"), txt.contains("w32=6\n")])
}
// The LOOP suite: `step_while` — THE single `@while` in the tree — and the two shorthands over it.
// Facts asserted here are the ones a broken combinator flips: a guard already false at the seed must
// run the step ZERO times and report the seed (`adv0`/`zsteps`), a reverse step must walk down
// (`back`), a data-dependent step must be able to jump more than one (`var`), state carried in the
// STEP must survive every pass (`carry`), `repeat_while` must run at least once and report its pass
// count (`rep1`/`once`/`reps`/`acc`), a `return` inside a guard must leave the ENCLOSING function
// (`ret`/`retn`), an enclosing `.loop`'s `h.break` must still break THAT loop (`brk`), and the cursor
// type must come from the seed, not be pinned to i64 (`w32`).
// `capp`/`capi`/`capl`/`caps` pin INLINER HYGIENE: a body lambda reading an enclosing PARAMETER whose
// name collides with a binder inside the combinator it is spliced into. `repeat_while` calls the body
// from inside its own `(n)` lambda, so `capp` read that cursor (0) instead of the parameter (5) until
// xform_lambda renamed the binder. `capi` covers count.zen's other binder spelling, `capl` holds the
// enclosing-LOCAL case that always worked, and `caps` the direct `step_while` shape — so a regression
// in any direction is visible. Distinct expected values catch cross-wiring, not just zeroing.
hi_loop_run = (mp: MutPtr<Malloc>) i32 {
    save(mp.zo_path("zo_loop.zen"), LOOP_PROG, len(LOOP_PROG))
    save(mp.zo_path("zo_loop.out"), "", 0)
    shell(mp.zo_cmd("./zen run $ZT/zo_loop.zen > $ZT/zo_loop.out 2>/dev/null"))
    txt := mp.hi_read(mp.zo_path("zo_loop.out"))
    run_suite("iter loop (run)", [txt.contains("adv=3\n"), txt.contains("adv0=3\n"), txt.contains("zsteps=0\n"), txt.contains("back=4\n"), txt.contains("var=4\n"), txt.contains("carry=1\n"), txt.contains("rep1=1\n"), txt.contains("once=1\n"), txt.contains("reps=4\n"), txt.contains("acc=6\n"), txt.contains("ret=3\n"), txt.contains("retn=-1\n"), txt.contains("brk=4\n"), txt.contains("w32=3\n"), txt.contains("capp=5\n"), txt.contains("capi=6\n"), txt.contains("capl=7\n"), txt.contains("caps=8\n")])
}
