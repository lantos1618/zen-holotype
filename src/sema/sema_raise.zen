Function, TypeId, Span = std.ast
AllocError = std.mem
Vec = std.collections
TyId, TyRes = sema.sema_ty
Checker, Ctx = sema.sema_check
SemaFault, NameFault = sema.sema_diag

// Called once per body, with the mark taken before it was walked.
// Everything raised since then belongs to this function.
settle_raised* = (
    c    :: Checker,
    f    : Function,
    ctx  : Ctx,
    got  : TyId,
    mark : usize
) Res<(), AllocError> {
    raised ::= c.alloc.Vec<TyId>();
    c.take_raised(mark, raised).try();
    c.inferred_error(ctx.ret).match({
        None  => Ok(()),
        Ok(_) => c.settle_signature(f, ctx, got, raised),
    })
}

inferred_error = (c :: Checker, ret: TyId) Res<TyId> {
    c.types.at(ret).match({
        Res(r) => c.infer_hole(r),
        _      => None,
    })
}

infer_hole = (c :: Checker, r: TyRes) Res<TyId> {
    c.is_infer(r.error).match({
        false => None,
        true  => Ok(r.error),
    })
}

settle_signature = (
    c      :: Checker,
    f      : Function,
    ctx    : Ctx,
    got    : TyId,
    raised :: Vec<TyId>
) Res<(), AllocError> {
    c.report_if_exported(f).try();
    c.body_error(got, raised).try();
    set = c.types.union_ty(raised).try();
    c.write_ret(f, ctx, set)
}

report_if_exported = (c :: Checker, f: Function) Res<(), AllocError> {
    f.exported.match({
        false => Ok(()),
        true  => c.report_hole(f),
    })
}

report_hole = (c :: Checker, f: Function) Res<(), AllocError> {
    span = c.hole_span(f).match({ None => f.name.span, Ok(s) => s });
    c.refuse(span, SemaFault.InferredSetExported(NameFault(name: f.name.text)))
}

hole_span = (c :: Checker, f: Function) Res<Span> {
    f.ret.match({
        None   => None,
        Ok(id) => c.res_hole_span(id),
    })
}

res_hole_span = (c :: Checker, id: TypeId) Res<Span> {
    c.tree.type_at(id).kind.match({
        Named(n) => c.arg_span(n.args, 1),
        _        => None,
    })
}

arg_span = (c :: Checker, args: Vec<TypeId>, i: usize) Res<Span> {
    args.get(i).match({
        None  => None,
        Ok(a) => Ok(c.tree.type_at(a).span),
    })
}

body_error = (c :: Checker, got: TyId, raised :: Vec<TyId>)
             Res<(), AllocError> {
    c.types.at(got).match({
        Res(r) => c.keep_error(r, raised),
        _      => Ok(()),
    })
}

keep_error = (c :: Checker, r: TyRes, raised :: Vec<TyId>)
             Res<(), AllocError> {
    c.carries_error(r).match({
        false => Ok(()),
        true  => raised.add(r.error),
    })
}

// A settled failure set; a hole or poison is not one.
carries_error = (c :: Checker, r: TyRes) bool {
    ((c.is_infer(r.error) || c.is_unknown(r.error)) == false)
        && r.form.match({ Failure => true, _ => false })
}

// The return type's own node is what every reader of the signature asks,
// so its memo is rewritten in place.
write_ret = (c :: Checker, f: Function, ctx: Ctx, set: TyId)
            Res<(), AllocError> {
    f.ret.match({
        None   => Ok(()),
        Ok(id) => c.write_ret_memo(id, ctx, set),
    })
}

write_ret_memo = (c :: Checker, id: TypeId, ctx: Ctx, set: TyId)
                 Res<(), AllocError> {
    c.types.at(ctx.ret).match({
        Res(r) => c.write_settled(id, r, set),
        _      => Ok(()),
    })
}

write_settled = (c :: Checker, id: TypeId, r: TyRes, set: TyId)
                Res<(), AllocError> {
    settled = c.types.res_failure(r.value, set).try();
    c.type_memo.set(id, settled)
}
