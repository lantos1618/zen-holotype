// An UNGUARDED null dereference: `slice(null_ptr(), 8)` builds a [u8] over a null base with a positive
// length, so the runtime's slice bounds check passes (0 < 8) but the load at index 0 dereferences address
// 0 and raises SIGSEGV. The runtime's SIGSEGV handler (zenrt.c, on a sigaltstack) inspects the faulting
// address: near-0 ⇒ it reports `zen: panic: null pointer dereference` — NOT the misleading
// `stack overflow` it used to print for every SIGSEGV — then exits with the panic code (134).
{ println } = std.text.fmt
main = () i32 {
    xs: [u8] := slice(null_ptr(), 8)
    v := xs[0]
    println(v.to_i32())
    0
}
