Decl, Struct, Enum, TParam, Span = std.ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId, TyNamed, TyRes, TyFn, ResForm = sema.sema_ty
decl_at = sema.sema_def
Checker = sema.sema_check

Inst* = {
    vars :: Vec<TyId>,
    args :: Vec<TyId>,

    // How many parameters this instantiation binds; zero is the empty
    // substitution every non-generic declaration is lowered under.
    len* = (self: @Self) usize { self.vars.len }

    // Parameters and their substitutions remain in declaration order.
    var_at* = (self: @Self, i: usize) Res<TyId> { self.vars.get(i) }

    arg_at* = (self: @Self, i: usize) Res<TyId> { self.args.get(i) }

    // Bind one parameter; first binding wins. Unifying `<T>(a: T, b: T)`
    // against `(i32, i32)` must not rebind `T` on the second argument —
    // a real disagreement is a mismatch the coercion check reports.
    bind* = (self :: @Self, v: TyId, arg: TyId) Res<(), AllocError> {
        self.bound(v).match({
            true  => Ok(()),
            false => self.push(v, arg),
        })
    }

    push = (self :: @Self, v: TyId, arg: TyId) Res<(), AllocError> {
        self.vars.add(v).try();
        self.args.add(arg).try();
        Ok(());
    }

    bound* = (self: @Self, v: TyId) bool {
        self.lookup(v).match({ Ok(_) => true, None => false })
    }

    // What `v` became, or nothing — "no binding", never "bound to
    // poison"; only one of those is a reason to refuse.
    lookup* = (self: @Self, v: TyId) Res<TyId> {
        n = self.vars.len;
        Range(0, n).find((k) {
            self.vars.get(k).match({ Ok(x) => x.eq(v), None => false })
        }).match({
            None  => None,
            Ok(k) => self.args.get(k),
        })
    }
}

InstEdge* = {
    from_owner*: str,
    to_owner*: str,
    to_name*: str,
    // the callee's own `Ty.Var`s and what this call gave them, both in
    // declaration order, so the pair is a substitution
    to_tvars*: Vec<TyId>,
    args*: Vec<TyId>,
    span*: Span,
}

// `alloc.Inst()`, a ufcs constructor like `Vec`, `Map` and `Types`. A
// bare value, not a `Res`: an empty instantiation owns no pages.
Inst* = (a: Alloc) Inst {
    Inst(vars: a.Vec<TyId>(), args: a.Vec<TyId>())
}

subst* = (c :: Checker, ty: TyId, inst: Inst) Res<TyId, AllocError> {
    (inst.len() == 0).match({
        true  => Ok(ty),
        false => c.subst_kind(ty, inst),
    })
}

subst_kind = (c :: Checker, ty: TyId, inst: Inst) Res<TyId, AllocError> {
    c.types.at(ty).match({
        Var(_)   => Ok(inst.lookup(ty).match({ Ok(t) => t, None => ty })),
        Named(n) => c.subst_named(n, ty, inst),
        Res(r)   => c.subst_res(r, ty, inst),
        Fn(f)    => c.subst_fn(f, ty, inst),
        Union(u) => c.subst_union(u.members, ty, inst),
        _        => Ok(ty),
    })
}

subst_named = (c :: Checker, n: TyNamed, ty: TyId, inst: Inst)
              Res<TyId, AllocError> {
    (n.args.len == 0).match({
        true  => Ok(ty),
        false => c.rebuild_named(n, inst),
    })
}

rebuild_named = (c :: Checker, n: TyNamed, inst: Inst)
                Res<TyId, AllocError> {
    args ::= c.alloc.Vec<TyId>();
    c.subst_list(n.args, inst, args).try();
    qname = owner_of(c, n.decl.module.to_usize(), n.name).try();
    c.types.named(n.decl, qname, n.name, args)
}

subst_res = (c :: Checker, r: TyRes, ty: TyId, inst: Inst)
            Res<TyId, AllocError> {
    value = c.subst(r.value, inst).try();
    error = c.subst(r.error, inst).try();
    unchanged(value, r.value, error, r.error).match({
        true  => Ok(ty),
        false => rebuild_res(c, value, error, r.form),
    })
}

unchanged = (a: TyId, b: TyId, x: TyId, y: TyId) bool {
    a.eq(b) && x.eq(y)
}

// `Types` builds a `Res` through the constructor its form names, and
// there is no fourth form to fall through to.
rebuild_res = (c :: Checker, value: TyId, error: TyId, form: ResForm)
              Res<TyId, AllocError> {
    form.match({
        Absence => c.types.res_absence(value),
        Failure => c.types.res_failure(value, error),
        Open    => c.types.res_open(value),
    })
}

subst_fn = (c :: Checker, f: TyFn, ty: TyId, inst: Inst)
           Res<TyId, AllocError> {
    params ::= c.alloc.Vec<TyId>();
    c.subst_list(f.params, inst, params).try();
    ret = c.subst(f.ret, inst).try();
    c.types.fn_ty(params, ret)
}

// Rebuilt through `union_ty`, which canonicalises: substituting two
// parameters into one type collapses the set, as writing it by hand would.
subst_union = (c :: Checker, members: Vec<TyId>, ty: TyId, inst: Inst)
              Res<TyId, AllocError> {
    parts ::= c.alloc.Vec<TyId>();
    c.subst_list(members, inst, parts).try();
    c.types.union_ty(parts)
}

subst_list* = (c :: Checker, src: Vec<TyId>, inst: Inst, out :: Vec<TyId>)
              Res<(), AllocError> {
    src.loop((h, t) { out.add(c.subst(t, inst).try()).try() });
    Ok(());
}

has_var* = (c: Checker, ty: TyId) bool {
    c.types.at(ty).match({
        Var(_)   => true,
        Named(n) => c.any_has_var(n.args),
        Res(r)   => c.has_var(r.value) || c.has_var(r.error),
        Fn(f)    => c.any_has_var(f.params) || c.has_var(f.ret),
        Union(u) => c.any_has_var(u.members),
        _        => false,
    })
}

any_has_var = (c: Checker, list: Vec<TyId>) bool {
    Range(0, list.len).find((i) {
        list.get(i).match({ Ok(t) => c.has_var(t), None => false })
    }).match({ Ok(_) => true, None => false })
}

tparam_vars* = (
    c       :: Checker,
    tparams : Vec<TParam>,
    owner   : str,
    out     :: Vec<TyId>
) Res<(), AllocError> {
    tparams.loop((h, tp) {
        out.add(c.types.var(tp.name.text, owner).try()).try();
    });
    Ok(());
}

// Push type parameters into the same scope used for later substitution.
push_tparams* = (c :: Checker, tparams: Vec<TParam>, owner: str)
                Res<(), AllocError> {
    tparams.loop((h, tp) {
        text = tp.name.text;
        c.push_tvar(text, c.types.var(text, owner).try()).try();
    });
    Ok(());
}

owner_of* = (c :: Checker, mi: usize, name: str) Res<str, AllocError> {
    out ::= c.alloc.String("{}.{name}", module_name(c, mi)).try();
    Ok(out.view());
}

module_name* = (c: Checker, mi: usize) str {
    c.world.table_at(mi).match({ Ok(t) => t.name, None => "" })
}

inst_of_named* = (c :: Checker, n: TyNamed) Res<Inst, AllocError> {
    inst ::= c.alloc.Inst();
    (n.args.len > 0).match({
        false => Ok(()),
        true  => c.fill_from_decl(n, inst),
    }).try();
    Ok(inst);
}

fill_from_decl = (c :: Checker, n: TyNamed, inst :: Inst)
                 Res<(), AllocError> {
    decl_at(c.tree, n.decl).match({
        None  => Ok(()),
        Ok(d) => c.fill_from_struct(n, d, inst),
    })
}

fill_from_struct = (c :: Checker, n: TyNamed, d: Decl, inst :: Inst)
                   Res<(), AllocError> {
    d.kind.match({
        Struct(s) => c.fill_tparams(n, s, inst),
        Enum(e)   => c.fill_enum_tparams(n, e, inst),
        _         => Ok(()),
    })
}

fill_tparams = (c :: Checker, n: TyNamed, s: Struct, inst :: Inst)
               Res<(), AllocError> {
    owner = owner_of(c, n.decl.module.to_usize(), s.name.text).try();
    vars ::= c.alloc.Vec<TyId>();
    c.tparam_vars(s.tparams, owner, vars).try();
    c.zip(vars, n.args, inst).try();
    Ok(());
}

fill_enum_tparams = (c :: Checker, n: TyNamed, e: Enum, inst :: Inst)
                    Res<(), AllocError> {
    owner = owner_of(c, n.decl.module.to_usize(), e.name.text).try();
    vars ::= c.alloc.Vec<TyId>();
    c.tparam_vars(e.tparams, owner, vars).try();
    c.zip(vars, n.args, inst).try();
    Ok(());
}

// Bind each parameter to the argument in its position; a shorter
// argument list binds what it can and leaves the rest unbound.
zip* = (c :: Checker, vars: Vec<TyId>, args: Vec<TyId>, inst :: Inst)
       Res<(), AllocError> {
    Range(0, vars.len).loop((h, i) {
        c.zip_one(vars, args, i, inst).try();
    });
    Ok(());
}

zip_one = (
    c    :: Checker,
    vars : Vec<TyId>,
    args : Vec<TyId>,
    i    : usize,
    inst :: Inst
) Res<(), AllocError> {
    vars.get(i).match({
        None  => Ok(()),
        Ok(v) => c.zip_arg(v, args, i, inst),
    })
}

zip_arg = (c :: Checker, v: TyId, args: Vec<TyId>, i: usize, inst :: Inst)
          Res<(), AllocError> {
    args.get(i).match({
        None  => Ok(()),
        Ok(t) => inst.bind(v, t),
    })
}

// inference
unify* = (c :: Checker, param: TyId, actual: TyId, inst :: Inst)
         Res<(), AllocError> {
    c.types.at(param).match({
        Var(_)   => c.bind_actual(param, actual, inst),
        Named(n) => unify_named(c, n, actual, inst),
        Res(r)   => unify_res(c, r, actual, inst),
        Fn(f)    => c.unify_fn(f, actual, inst),
        _        => Ok(()),
    })
}

bind_actual = (c :: Checker, param: TyId, actual: TyId, inst :: Inst)
              Res<(), AllocError> {
    c.usable_actual(actual).match({
        false => Ok(()),
        true  => inst.bind(param, actual),
    })
}

usable_actual = (c: Checker, actual: TyId) bool {
    (c.is_unknown(actual) == false) && (c.is_infer(actual) == false)
}

unify_named = (c :: Checker, n: TyNamed, actual: TyId, inst :: Inst)
              Res<(), AllocError> {
    c.types.at(actual).match({
        Named(m) => unify_args(c, n, m, inst),
        _        => Ok(()),
    })
}

// Only applications of the same declaration can unify their arguments.
unify_args = (c :: Checker, n: TyNamed, m: TyNamed, inst :: Inst)
             Res<(), AllocError> {
    n.decl.eq(m.decl).match({
        false => Ok(()),
        true  => c.unify_list(n.args, m.args, inst),
    })
}

unify_res = (c :: Checker, r: TyRes, actual: TyId, inst :: Inst)
            Res<(), AllocError> {
    c.types.at(actual).match({
        Res(s) => unify_res_parts(c, r, s, inst),
        _      => Ok(()),
    })
}

unify_res_parts = (c :: Checker, r: TyRes, s: TyRes, inst :: Inst)
                  Res<(), AllocError> {
    unify(c, r.value, s.value, inst).try();
    unify(c, r.error, s.error, inst).try();
    Ok(());
}

unify_fn = (c :: Checker, f: TyFn, actual: TyId, inst :: Inst)
           Res<(), AllocError> {
    c.types.at(actual).match({
        Fn(g) => c.unify_fn_parts(f, g, inst),
        _     => Ok(()),
    })
}

unify_fn_parts = (c :: Checker, f: TyFn, g: TyFn, inst :: Inst)
                 Res<(), AllocError> {
    c.unify_list(f.params, g.params, inst).try();
    unify(c, f.ret, g.ret, inst).try();
    Ok(());
}

unify_list* = (
    c       :: Checker,
    params  : Vec<TyId>,
    actuals : Vec<TyId>,
    inst    :: Inst
) Res<(), AllocError> {
    Range(0, params.len).loop((h, i) {
        unify_at(c, params, actuals, i, inst).try();
    });
    Ok(());
}

unify_at = (
    c       :: Checker,
    params  : Vec<TyId>,
    actuals : Vec<TyId>,
    i       : usize,
    inst    :: Inst
) Res<(), AllocError> {
    params.get(i).match({
        None  => Ok(()),
        Ok(p) => c.unify_actual_at(p, actuals, i, inst),
    })
}

unify_actual_at = (
    c       :: Checker,
    p       : TyId,
    actuals : Vec<TyId>,
    i       : usize,
    inst    :: Inst
) Res<(), AllocError> {
    actuals.get(i).match({
        None  => Ok(()),
        Ok(a) => unify(c, p, a, inst),
    })
}
