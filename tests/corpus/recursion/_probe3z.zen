Link = {
    value: i64,
    next: Ptr<Link>,
}

// create ONCE in main (try), then a helper that allocates per call.
cell_of = (alloc: Alloc, cell: Ptr<Link>) Link {
    cell.write(0, Link(value: 0, next: null_ptr<Link>()));
    Link(value: 0, next: null_ptr<Link>());
}

build = (alloc: Alloc, n: i64) Link {
    (n <= 0).match({
        true  => Link(value: 1000, next: null_ptr<Link>()),
        false => {
            wrapped = cell_of(alloc);
            rest = build(alloc, n - 1);
            wrapped.next.write(0, rest);
            Link(value: n * 10, next: wrapped.next);
        },
    });
}

main = (env: Env) Res<i32, AllocError> {
    Ok(0);
}
