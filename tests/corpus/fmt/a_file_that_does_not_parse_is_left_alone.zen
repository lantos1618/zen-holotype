// A FORMATTER'S FIRST DUTY IS TO REFUSE. A tree built from a file with
// a hole in it is a tree whose spans no longer describe the source, and
// this stage prints from spans — so a file that does not parse comes
// back with its diagnostics and no bytes, and the driver leaves it
// exactly as it found it.
//
// This is the difference between a formatter and the worst tool in a
// toolchain: one that reformats a half-typed file into something that
// parses, and is therefore no longer what was typed.

Alloc, AllocError = std.mem
str = std.text
scan, Source = std.lex.lex
render = fmt.fmt

main = (env: Env) Res<i32, AllocError> {
    a ::= env.mem.alloc();
    tried(a, "a good file", "a = 1\n").try();
    tried(a, "a lexical fault", "a = 1~\n").try();
    tried(a, "a declaration with no value", "a =\n").try();
    tried(a, "an unclosed brace", "Point = {\n    x: i32,\n").try();
    Ok(0);
}

tried = (a: Alloc, what: str, text: str) Res<(), AllocError> {
    lexed = scan(a, Source(file: "in.zen", text: text)).try();
    out   = render(a, lexed).try();
    println(
        "{}: diagnostics {}, bytes {}",
        what,
        out.diags.len,
        out.text.len()
    );
    Ok(());
}
