// FORK 1 of 2 on NESTED BLOCK COMMENTS. DESIGN.md does not decide.
// This file assumes nesting is NOT supported: the comment closes at its
// first */ and the two tildes that follow are not Zen tokens. The other
// reading is tests/corpus/lex/block_comment_nested.zen, same source
// line. Exactly one of the two can pass.
/* outer /* inner */ ~~ */
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    println("unreachable under the non-nesting reading");
    Ok(0);
}
