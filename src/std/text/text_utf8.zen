// UTF-8 decoding and encoding over byte-oriented str and String values.
// Both directions share the boundary constants below. Byte-to-u32 conversion
// only widens; multiplication by UTF8_CONT_SCALE supplies the six-bit shift
// needed to assemble and split code points.

str = std.text.text_str
String = std.text.text_string
AllocError = std.mem.mem

// the offset of the byte where the sequence stops making sense
Utf8Error* = | Invalid(usize) | InvalidCodepoint(u32)

// one decoded codepoint and the width of the sequence it came from
Codepoint* = {
    value*: u32,
    len*: usize,
}

// a walk over the codepoints of a str. No Alloc, so it is a cursor, not a
// collection — the caller keeps whatever it wants to keep
Codepoints* = {
    bytes: str,
    at* :: usize,

    is_done* = (self: @Self) bool { self.at == self.bytes.len }

    // decodes the sequence at the cursor and steps past it. Only valid while
    // `is_done` is false
    next* = (self :: @Self) Res<u32, Utf8Error> {
        c       = codepoint_at(self.bytes, self.at).try();
        self.at = self.at + c.len;
        Ok(c.value);
    }
}

codepoints* = (s: str) Codepoints { Codepoints(bytes: s, at: 0) }

// Every decoding operation walks through this primitive.
codepoint_at* = (s: str, at: usize) Res<Codepoint, Utf8Error> {
    lead = s.get(at).ok_or(Utf8Error.Invalid(at)).try();
    sequence_len(lead).match({
        1 => Ok(Codepoint(value: lead.to_u32(), len: 1)),
        2 => s.two_byte(at, lead),
        3 => s.three_byte(at, lead),
        4 => s.four_byte(at, lead),
        _ => Err(Utf8Error.Invalid(at)),
    });
}

// walks every sequence and keeps none of them
validate_utf8* = (s: str) Res<(), Utf8Error> {
    walk ::= s.codepoints();
    loop(!walk.is_done(), (h) { walk.next().try(); });
    Ok(());
}

// the count that `len` deliberately is not. Characters cost a walk, and the
// walk is written out here so the price is visible at the call
count_codepoints* = (s: str) Res<usize, Utf8Error> {
    walk ::= s.codepoints();
    n    ::= 0;
    loop(!walk.is_done(), (h) {
        walk.next().try();
        n = n + 1;
    });
    Ok(n);
}

// ---------------------------------------------------------------------------
// UTF-8's own boundaries, exported since callers may want them
// ---------------------------------------------------------------------------

UTF8_ASCII_MAX*: u8 = 128       // first byte that is not a codepoint by itself
UTF8_CONT_MIN*: u8 = 128        // continuation bytes are 128..191
UTF8_LEAD_MIN*: u8 = 192        // 192 and 193 lead only OVERLONG sequences
UTF8_LEAD_2_MIN*: u8 = 194      // first lead of a well-formed 2-byte sequence
UTF8_LEAD_3_MIN*: u8 = 224
UTF8_LEAD_4_MIN*: u8 = 240
UTF8_LEAD_MAX*: u8 = 245        // 245 and up cannot reach U+10FFFF

UTF8_CONT_SCALE*: u32 = 64      // the 6 payload bits of a continuation byte
UTF8_MIN_3*: u32 = 2048         // below this, 3 bytes is overlong
UTF8_MIN_4*: u32 = 65536        // below this, 4 bytes is overlong
UTF8_SURROGATE_MIN*: u32 = 55296
UTF8_SURROGATE_MAX*: u32 = 57343
UTF8_MAX_CODEPOINT*: u32 = 1114111
UTF8_MAX_LEN*: usize = 4        // no sequence is longer

// the byte-order mark, U+FEFF as its three bytes. The lexer skips one
// at a file's start; home is here because these name UTF-8, not Zen.
BOM_FIRST*: u8 = 239
BOM_SECOND*: u8 = 187
BOM_THIRD*: u8 = 191

// width of the sequence starting with `lead`, or 0 if it can't start one:
// a continuation byte, an overlong lead, or past reach of U+10FFFF.
// Early return over a pyramid: the one-shot loop is a breakable block,
// each `.then` a guard that returns its length, the last break the rest.
// The typed binding is load-bearing — a match on the loop call itself
// leaves T unresolved, and the bootstrapper lowers it to garbage
sequence_len = (lead: u8) usize {
    found: Res<usize> = loop((h) {
        (lead < UTF8_ASCII_MAX).then(() { h.break(1) });
        (lead < UTF8_LEAD_2_MIN).then(() { h.break(0) });
        (lead < UTF8_LEAD_3_MIN).then(() { h.break(2) });
        (lead < UTF8_LEAD_4_MIN).then(() { h.break(3) });
        (lead < UTF8_LEAD_MAX).then(() { h.break(4) });
        h.break(0);
    });
    found.match({
        Ok(len) => len,
        None    => 0,
    });
}

// the 6 payload bits of the continuation byte at `at`
continuation = (s: str, at: usize) Res<u32, Utf8Error> {
    b = s.get(at).ok_or(Utf8Error.Invalid(at)).try();
    ((b >= UTF8_CONT_MIN) && (b < UTF8_LEAD_MIN)).match({
        true  => Ok((b - UTF8_CONT_MIN).to_u32()),
        false => Err(Utf8Error.Invalid(at)),
    });
}

// no value check: UTF8_LEAD_2_MIN already excludes the only two overlong
// leads a 2-byte sequence has
two_byte = (s: str, at: usize, lead: u8) Res<Codepoint, Utf8Error> {
    c1    = s.continuation(at + 1).try();
    value = (lead - UTF8_LEAD_MIN).to_u32() * UTF8_CONT_SCALE + c1;
    Ok(Codepoint(value: value, len: 2));
}

three_byte = (s: str, at: usize, lead: u8) Res<Codepoint, Utf8Error> {
    c1    = s.continuation(at + 1).try();
    c2    = s.continuation(at + 2).try();
    value = (lead - UTF8_LEAD_3_MIN).to_u32() * UTF8_CONT_SCALE * UTF8_CONT_SCALE
        + c1 * UTF8_CONT_SCALE
        + c2;
    // Overlong and surrogate ranges are both visible in the value, so one test does
    // the work of two lead-byte special cases and cannot disagree with itself
    ((value >= UTF8_MIN_3)
        && ((value < UTF8_SURROGATE_MIN) || (value > UTF8_SURROGATE_MAX))).match({
        true  => Ok(Codepoint(value: value, len: 3)),
        false => Err(Utf8Error.Invalid(at)),
    });
}

four_byte = (s: str, at: usize, lead: u8) Res<Codepoint, Utf8Error> {
    c1    = s.continuation(at + 1).try();
    c2    = s.continuation(at + 2).try();
    c3    = s.continuation(at + 3).try();
    value = (lead - UTF8_LEAD_4_MIN).to_u32()
            * UTF8_CONT_SCALE * UTF8_CONT_SCALE * UTF8_CONT_SCALE
        + c1 * UTF8_CONT_SCALE * UTF8_CONT_SCALE
        + c2 * UTF8_CONT_SCALE
        + c3;
    ((value >= UTF8_MIN_4) && (value <= UTF8_MAX_CODEPOINT)).match({
        true  => Ok(Codepoint(value: value, len: 4)),
        false => Err(Utf8Error.Invalid(at)),
    });
}

// ---------------------------------------------------------------------------
// the other direction: a codepoint, as bytes
// ---------------------------------------------------------------------------

// Append one Unicode scalar value. Surrogates and values above U+10FFFF are
// not Unicode scalar values and are rejected before any byte is written.
push_utf8* = (v: u32, out :: String) Res<(), Utf8Error | AllocError> {
    scalar(v).match({
        false => Err(Utf8Error.InvalidCodepoint(v)),
        true  => encoded_len(v).match({
            1 => out.add(narrow(v).try()),
            2 => two_wide(v, out),
            3 => three_wide(v, out),
            _ => four_wide(v, out),
        }),
    })
}

scalar = (v: u32) bool {
    (v <= UTF8_MAX_CODEPOINT)
        && !(v >= UTF8_SURROGATE_MIN && v <= UTF8_SURROGATE_MAX)
}

// The encoded width is one plus the number of UTF-8 boundaries the scalar
// crosses. push_utf8 dispatches once on that width.
encoded_len = (v: u32) usize {
    1 + past(v, UTF8_ASCII_MAX.to_u32()) + past(v, UTF8_MIN_3) + past(v, UTF8_MIN_4)
}

// one more byte, or not
past = (v: u32, bound: u32) usize {
    (v >= bound).match({ true => 1, false => 0 })
}

two_wide = (v: u32, out :: String) Res<(), Utf8Error | AllocError> {
    cont = UTF8_CONT_MIN.to_u32();
    out.add(narrow(UTF8_LEAD_MIN.to_u32() + v / UTF8_CONT_SCALE).try()).try();
    out.add(narrow(cont + v % UTF8_CONT_SCALE).try())
}

three_wide = (v: u32, out :: String) Res<(), Utf8Error | AllocError> {
    cont = UTF8_CONT_MIN.to_u32();
    out.add(
        narrow(
            UTF8_LEAD_3_MIN.to_u32() + v / (UTF8_CONT_SCALE * UTF8_CONT_SCALE)
        ).try()
    ).try();
    out.add(narrow(cont + (v / UTF8_CONT_SCALE) % UTF8_CONT_SCALE).try()).try();
    out.add(narrow(cont + v % UTF8_CONT_SCALE).try())
}

four_wide = (v: u32, out :: String) Res<(), Utf8Error | AllocError> {
    cont = UTF8_CONT_MIN.to_u32();
    out.add(narrow(
        UTF8_LEAD_4_MIN.to_u32()
            + v / (UTF8_CONT_SCALE * UTF8_CONT_SCALE * UTF8_CONT_SCALE)
    ).try()).try();
    out.add(
        narrow(
            cont + (v / (UTF8_CONT_SCALE * UTF8_CONT_SCALE)) % UTF8_CONT_SCALE
        ).try()
    ).try();
    out.add(narrow(cont + (v / UTF8_CONT_SCALE) % UTF8_CONT_SCALE).try()).try();
    out.add(narrow(cont + v % UTF8_CONT_SCALE).try())
}

narrow = (v: u32) Res<u8, Utf8Error> {
    v.to_u8().ok_or(Utf8Error.InvalidCodepoint(v))
}
