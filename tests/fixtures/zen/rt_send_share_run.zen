// rt M2 slice 1 (docs/rt-scoped-runtime.md §4): a `Shared<T>` promoted from scratch is a LEGAL send
// payload — the scratch-escape checker accepts it and it runs. The receiver reads the frozen value
// back through the readonly view (41), exit = 42.
{ Shared } = std.mem.share
share = std.mem.share
halloc = std.mem.heap
Pk*: {
    s: Shared<i64>,
}
H*: {
    id: i32,
}
send = (h: H, m: Pk) i64 { m.s.get() }
main = () i32 {
    heap := halloc.gpa()
    a := heap.addr()
    v: i64 := 41
    sh := v.share(a)
    h := H(id: 1)
    r := send(h, Pk(s: sh))
    sh.drop_in(a)
    to_i32(r) + 1
}
