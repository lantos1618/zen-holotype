// src/lsp/lsp_diag.zen
// `textDocument/publishDiagnostics`: what a build found, said to a client.
//
// `design_lsp.md` §5: the queries are somebody else's — `Build` answers
// `diag_count`/`diag_at` for lex and parse, the `Checker` `Build.whole`
// hands back answers the same pair for sema. This file decides WHEN to
// build, WHICH file each answer belongs to, and how an answer is taken
// BACK.
//
// WHEN, AND THE DEBOUNCE THAT IS NOT ONE. §5 asks for a debounce — build
// after a quiet interval — but a quiet interval cannot be observed:
// `Stdin.read` blocks until it has exactly the bytes asked for
// (`src/std/env/env.zen`), there is no clock, and threads arrive at
// stage 5 (`PLAN.md`). So instead: A CHANGE MARKS, A SETTLE POINT
// BUILDS. `didOpen`/`didChange` record which document is owed a build;
// the transport calls `settled` once it has answered everything it
// currently holds. This COALESCES a batch to ONE build of the LAST
// buffer, and is ORDERED (one build at a time, always the newest
// document, so §5's race is absent by construction).
//
// HONEST ABOUT THE PIPE: over `lsp_stdio.zen` a settle point is every
// message, since `short_by` asks for exactly one message's bytes and a
// blocking reader cannot look past it — so over a real editor this
// coalesces nothing yet (the missing piece is a read that can say
// "nothing more is waiting", or a second thread). The cheap mitigation
// meanwhile: `lsp_serve.zen` marks nothing when a `didOpen`/`didChange`
// carries text the document already holds.
//
// WHICH FILE, AND WHY CLEARING IS THE HARD HALF. A build reports across
// the whole program, so diagnostics belong to many files though only one
// is open; every diagnostic is grouped by the URI its own span names,
// one notification per URI.
//
// THE PROTOCOL HAS NO "REMOVE". A notification REPLACES a file's list,
// so taking an error back means publishing an EMPTY list for that file
// — a server publishing only what it found would leave stale errors on
// screen forever. So `showing` is the set of URIs currently carrying
// errors, and every build publishes for three sets: the edited file
// (always), every file this build found something in, and every file
// `showing` holds that this build found nothing in (the clearing).
//
// SEVERITY, AND WHERE THE NOTE WENT. EVERY DIAGNOSTIC IS AN ERROR,
// severity 1 — a fact about this compiler (one tally `Build.faults`, no
// phase survives a build), not a simplification; changes the day a
// warning exists.
//
// THE NOTE BECOMES `relatedInformation`, NOT PART OF THE MESSAGE. A
// `parse.parse_diag.Note` is a sentence AND A SPAN — folding it into the
// message would throw the span away; `relatedInformation` is the
// protocol's field for exactly that pair, rendered by a client as
// somewhere to jump to.
//
// SEMA'S SECOND POSITION IS ALREADY IN ITS SENTENCE and stays there: a
// `PairFault` names two declarations and `write_detail` writes both —
// `sema_diag.zen` owns that wording.

str, String = std.text
Vec, Map = std.collections
Alloc, AllocError = std.mem
Range = std.core
Span = ast.ast_span
// PARSE'S `Diag` AND SEMA'S both name `Diag` and `A, B = module` cannot
// rename, so sema's diagnostic fields travel as parameters, its type
// never named; only parse's `Note` is used as a value.
Note = parse.parse_diag
Checker = sema.sema_check
SemaFault, message, write_detail = sema.sema_diag
// IMPORTED FOR ITS METHODS: without this line the bootstrapper resolves
// `c.types`'s methods against another module (as `lsp_hover.zen` notes).
Types = sema.sema_ty
Build = zen.zen_build
root_for, relative_to = zen.zen_path
write_range = lsp.lsp_pos
write_text, written = lsp.lsp_json
write_frame, write_decimal = lsp.lsp_frame
path_of, uri_at = lsp.lsp_uri
// The semantic half of colour: what the build below settled about each
// name, gathered by `lsp_names.zen` off the SAME `Checker` the
// diagnostics come from — a second build per keystroke is the cost
// `design_lsp.md` §5 prices, and it is paid nowhere twice.
Classed, sort_classes = lsp.lsp_colour
classify = lsp.lsp_names

// ONE DIAGNOSTIC, ALREADY BELONGING TO A FILE. `uri` is resolved at
// gather time, not write time: a build knows its compilation root, a
// writer does not. `message` IS TEXT AND NOT A FAULT: sema's sentence
// needs the `Types` store that decided it, belonging to a `Checker` this
// value must outlive, so it renders while the checker is in hand.
Spot* = {
    uri*: str,
    message*: str,
    span*: Span,
    note*: Res<Note>,
}

// The server's diagnostics half: which document owes a build, and which
// files are showing errors right now. A TYPE OF ITS OWN rather than four
// fields on `Server`: the server owns the documents, this owns what has
// been said about them.
Diagnostics* = {
    a: Alloc,

    // The document a build is owed to, or "" when none — one, not a
    // queue: a build is whole-program, so the newest document answers
    // for every older one.
    owed :: str = "",

    // Every URI currently carrying a non-empty list — the ONLY thing
    // that makes clearing possible.
    showing :: Vec<str>,

    // WHAT THE LAST CLEAN BUILD KNEW ABOUT EACH NAME, for colour.
    // Filled by `told` when the build found nothing wrong, EMPTIED by
    // `owes` — one change stales everything, because the build is
    // whole-program and what a name MEANS in an unchanged file can turn
    // on an edit somewhere else. The fallback when this is empty is
    // `lsp_colour.zen`'s lexical answer, which is never wrong.
    classed :: Vec<Classed>,

    // A document changed. Nothing is built here — see the header. The
    // classifications go with the change: they describe the text the
    // last build saw, not the text the buffer now holds.
    owes* = (self :: @Self, uri: str) () {
        self.owed = uri;
        self.classed = self.a.Vec<Classed>();
    }

    // The names the last clean build classified in `uri`, sorted for
    // `lsp_colour.zen`'s search. AN EMPTY VEC IS THE WHOLE FALLBACK:
    // no workspace, no build yet, a change not yet settled and a build
    // with faults all look alike here, and all mean "lexical colours".
    classes_for* = (self :: @Self, uri: str) Res<Vec<Classed>, AllocError> {
        found ::= self.a.Vec<Classed>();
        self.classed.loop((h, cl) {
            cl.uri.eq(uri).match({
                true  => found.add(cl),
                false => Ok(()),
            }).try();
        });
        sort_classes(found).try();
        Ok(found);
    }

    // THE SETTLE POINT: if a build is owed, it happens here. `uris` and
    // `docs` are the server's open documents; the overlay must carry
    // EVERY unsaved buffer, not only the edited one — a build reading
    // disk for the others would report errors already fixed on screen.
    settled* = (self :: @Self, env: Env, workspace: str, uris: Vec<str>,
                docs: Map<str, str>, out :: String) Res<(), AllocError> {
        self.owed.is_empty().match({
            true  => written(),
            false => self.build_owed(env, workspace, uris, docs, out),
        })
    }

    // NO WORKSPACE, NO DIAGNOSTICS — a refusal, not a gap. Without a
    // root there is nothing to build but the open file alone, and a
    // lone-module check reports every imported name as undefined: a
    // screen of red about a program that is fine. Hover degrades to the
    // lone module because its failure is silence; this one's is noise,
    // so it does not degrade at all. A document not under the workspace
    // (`root_for` climbs to "") is treated the same way.
    build_owed = (self :: @Self, env: Env, workspace: str, uris: Vec<str>,
                  docs: Map<str, str>, out :: String) Res<(), AllocError> {
        uri = self.owed;
        self.owed = "";
        path = path_of(uri);
        root = root_for(env, self.a, workspace, path);
        (workspace.is_empty() || root.is_empty()).match({
            true  => written(),
            false => self.told(env, root, path, uri, uris, docs, out),
        })
    }

    told = (self :: @Self, env: Env, root: str, path: str, uri: str,
            uris: Vec<str>, docs: Map<str, str>, out :: String)
           Res<(), AllocError> {
        spots ::= self.a.Vec<Spot>();
        classed ::= self.a.Vec<Classed>();
        found_in(env, self.a, root, path, overlay_of(self.a, uris, docs).try(),
                 spots, classed).try();
        self.classed = classed;
        self.say_all(env, uri, uris, docs, spots, out)
    }

    // THE THREE SETS, in order: the edited document, then every other
    // file this build found something in, then every file that was
    // showing errors and is not in either.
    say_all = (self :: @Self, env: Env, uri: str, uris: Vec<str>,
               docs: Map<str, str>, spots: Vec<Spot>, out :: String)
              Res<(), AllocError> {
        now ::= self.a.Vec<str>();
        uris_of(spots, now).try();
        say_one(env, self.a, uri, uris, docs, spots, out).try();
        now.loop((h, u) {
            u.eq(uri).match({
                true  => written(),
                false => say_one(env, self.a, u, uris, docs, spots, out),
            }).try();
        });
        self.take_back(env, uri, now, uris, docs, spots, out).try();
        self.showing = now;
        Ok(());
    }

    // AN EMPTY LIST FOR EVERY FILE THAT HAS STOPPED BEING WRONG. The
    // edited document is excluded — already published once.
    take_back = (self :: @Self, env: Env, uri: str, now: Vec<str>,
                 uris: Vec<str>, docs: Map<str, str>, spots: Vec<Spot>,
                 out :: String) Res<(), AllocError> {
        self.showing.loop((h, u) {
            gone(u, uri, now).match({
                false => written(),
                true  => say_one(env, self.a, u, uris, docs, spots, out),
            }).try();
        });
        Ok(());
    }
}

Diagnostics* = (a: Alloc) Diagnostics {
    Diagnostics(a: a, showing: a.Vec<str>(), classed: a.Vec<Classed>())
}

// Was this URI showing errors and is it not among the ones that have
// them now?
gone = (u: str, uri: str, now: Vec<str>) bool {
    u.eq(uri).match({
        true  => false,
        false => now.find((n) { n.eq(u) }).match({ Ok(_) => false, None => true }),
    })
}

// --- the build ---------------------------------------------------------

// A WHOLE BUILD, AND EVERYTHING THREE PHASES FOUND. Shaped after
// `lsp_hover.zen`'s `hover_in` deliberately (same `Build.whole`, overlay,
// computed root); only which output is read differs — hover wants the
// memos, this wants the diagnostics. Both halves matter so a server
// never shows type errors while silently swallowing syntax errors.
// `speaking` is already false under `whole` (stops the driver's
// `println` landing mid frame-stream); this file relies on diagnostics
// still being COLLECTED while not said.
//
// THE SECOND OUTPUT IS COLOUR'S. `classed` is filled from the same
// `Checker` when — and only when — the build found NOTHING wrong: with
// faults outstanding the memos hold poison, and both files' doctrine is
// that no answer beats a wrong one. An empty `classed` is not a failure
// here; it is the lexical fallback's trigger.
found_in* = (env: Env, a: Alloc, root: str, path: str, docs: Map<str, str>,
             spots :: Vec<Spot>, classed :: Vec<Classed>)
            Res<(), AllocError> {
    b ::= a.Build(env, root);
    c = b.whole(relative_to(root, path), docs).try();
    from_build(b, a, root, spots).try();
    from_check(c, a, root, spots).try();
    (b.diag_count() == 0 && c.diag_count() == 0).match({
        true  => classify(a, c, root, classed),
        false => written(),
    })
}

// LEX AND PARSE, off the `Build`. `Diag.span.file` is the module's path
// relative to the compilation root, exactly what a URI is built from.
from_build = (b :: Build, a: Alloc, root: str, spots :: Vec<Spot>)
             Res<(), AllocError> {
    Range(0, b.diag_count()).loop((h, i) {
        b.diag_at(i).match({
            None  => written(),
            Ok(d) => add_parse(a, root, d.message, d.span, d.note, spots),
        }).try();
    });
    Ok(());
}

add_parse = (a: Alloc, root: str, said: str, span: Span, note: Res<Note>,
             spots :: Vec<Spot>) Res<(), AllocError> {
    spots.add(Spot(uri: uri_at(a, root, span.file).try(), message: said,
                   span: span, note: note))
}

// SEMA, off the `Checker` `whole` handed back. THE SENTENCE IS RENDERED
// HERE, while the store that decided it is in hand: `message` plus
// `write_detail` rather than `render`, since `render` opens with
// `file:line:col:` and a position already travelling beside a `range`
// would be the same fact said twice, once in a form no client can click.
from_check = (c :: Checker, a: Alloc, root: str, spots :: Vec<Spot>)
             Res<(), AllocError> {
    Range(0, c.diag_count()).loop((h, i) {
        c.diag_at(i).match({
            None  => written(),
            Ok(d) => add_sema(c, a, root, d.file, d.span, d.fault, spots),
        }).try();
    });
    Ok(());
}

add_sema = (c :: Checker, a: Alloc, root: str, file: str, span: Span,
            fault: SemaFault, spots :: Vec<Spot>) Res<(), AllocError> {
    said ::= a.String().try();
    said.add_bytes(message(fault)).try();
    write_detail(fault, c.types, said).try();
    spots.add(Spot(uri: uri_at(a, root, file).try(), message: said.view(),
                   span: span, note: None))
}

// Every open buffer, keyed the way `Build.read` looks one up: on the
// path, what `Unit.path` holds and `path_of` produces.
overlay_of = (a: Alloc, uris: Vec<str>, docs: Map<str, str>)
             Res<Map<str, str>, AllocError> {
    over ::= a.Map<str, str>();
    uris.loop((h, u) {
        docs.get(u).match({
            None     => written(),
            Ok(text) => over.set(path_of(u), text),
        }).try();
    });
    Ok(over);
}

// The distinct URIs these spots name, in the order they were found.
uris_of = (spots: Vec<Spot>, into :: Vec<str>) Res<(), AllocError> {
    spots.loop((h, s) {
        into.find((u) { u.eq(s.uri) }).match({
            Ok(_) => written(),
            None  => into.add(s.uri),
        }).try();
    });
    Ok(());
}

// --- the notification --------------------------------------------------

// ONE FILE'S WHOLE LIST, framed — an empty `diagnostics` array is the
// only way a client is told an error is gone. THE TEXT IS THE FILE'S
// OWN: converting a span against another file's bytes would underline
// the right file at the wrong position.
say_one = (env: Env, a: Alloc, uri: str, uris: Vec<str>, docs: Map<str, str>,
           spots: Vec<Spot>, out :: String) Res<(), AllocError> {
    publish(a, uri, text_of(env, a, uri, docs), spots, out)
}

// The bytes the spans in `uri` were measured against: the open buffer if
// there is one, disk otherwise, "" when neither answers. "" IS NOT A
// SILENT FAILURE: `to_wire` clamps, so an unreadable file's positions
// convert to 0:0 — the diagnostic still reaches the client and names the
// file; only the underline is off. Worse to drop the diagnostic.
text_of = (env: Env, a: Alloc, uri: str, docs: Map<str, str>) str {
    docs.get(uri).match({
        Ok(text) => text,
        None     => on_disk(env, a, path_of(uri)),
    })
}

on_disk = (env: Env, a: Alloc, path: str) str {
    env.fs.read(a, path).match({
        Ok(text) => text.view(),
        Err(_)   => "",
    })
}

// `textDocument/publishDiagnostics`, as the protocol spells it. A
// NOTIFICATION AND NOT A REPLY: no `id`, the one message this server
// sends unprompted.
publish* = (a: Alloc, uri: str, text: str, spots: Vec<Spot>, out :: String)
           Res<(), AllocError> {
    body ::= a.String().try();
    body.add_bytes("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":").try();
    write_text(uri, body).try();
    body.add_bytes(",\"diagnostics\":[").try();
    n ::= 0;
    spots.loop((h, s) { n = one_of(s, uri, text, n, body).try(); });
    body.add_bytes("]}}").try();
    write_frame(body.view(), out)
}

// This spot, if it belongs to this file, and the count so it can tell
// whether a comma comes first.
one_of = (s: Spot, uri: str, text: str, n: usize, out :: String)
         Res<usize, AllocError> {
    s.uri.eq(uri).match({
        false => Ok(n),
        true  => written_at(s, text, n, out),
    })
}

written_at = (s: Spot, text: str, n: usize, out :: String)
             Res<usize, AllocError> {
    comma(n, out).try();
    write_spot(s, text, out).try();
    Ok(n + 1);
}

comma = (n: usize, out :: String) Res<(), AllocError> {
    (n > 0).match({ true  => out.add_bytes(","), false => written() })
}

write_spot = (s: Spot, text: str, out :: String) Res<(), AllocError> {
    out.add_bytes("{\"range\":").try();
    write_range(text, s.span, out).try();
    out.add_bytes(",\"severity\":").try();
    write_decimal(ERROR, out).try();
    out.add_bytes(",\"source\":\"zen\",\"message\":").try();
    write_text(s.message, out).try();
    write_note(s, text, out).try();
    out.add_bytes("}")
}

// THE NOTE, AS THE SECOND PLACE TO LOOK. THE NOTE'S URI IS THE
// DIAGNOSTIC'S: `parse_diag.zen`'s only builder of a note,
// `expect_close`, anchors on the opening delimiter of the same file it
// is reading — reusing the URI already in hand avoids a second
// path-to-URI conversion that could disagree.
write_note = (s: Spot, text: str, out :: String) Res<(), AllocError> {
    s.note.match({
        None  => written(),
        Ok(n) => write_related(s.uri, n, text, out),
    })
}

write_related = (uri: str, n: Note, text: str, out :: String)
                Res<(), AllocError> {
    out.add_bytes(",\"relatedInformation\":[{\"location\":{\"uri\":").try();
    write_text(uri, out).try();
    out.add_bytes(",\"range\":").try();
    write_range(text, n.span, out).try();
    out.add_bytes("},\"message\":").try();
    write_text(n.message, out).try();
    out.add_bytes("}]")
}

// `DiagnosticSeverity.Error` — the constant that changes the day there
// is a second severity.
ERROR*: usize = 1
