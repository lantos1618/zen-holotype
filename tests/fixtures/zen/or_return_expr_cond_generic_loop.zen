// conditional-position .or_return() inside a .loop body inside a GENERIC fn. A return inside a
// loop can never be lifted to `?:`, so the generic must monomorphize (mono_rec), where the Err-guard
// is an honest function return that exits sum_ok — not the caller. caller([1,2,3]) sums cleanly to
// 6; caller([1,20,3]) hits the guard at 20, gk(0) yields Err, sum_ok early-returns it, and the
// caller RECOVERS to 50. Exit 56 = 6 + 50.
{ Result, IoError } = std.core.result
gk = (ok: i32) Result<i32, IoError> { (ok == 1).then({ .Ok(5) }, { .Err(.NotFound) }) }
sum_ok<T> = (xs: [i32], lim: i32, d: T) Result<i32, IoError> {
    s := 0
    xs.loop((h, i, x) {
        v := (x > lim).then({ gk(0).or_return() }, { x })
        s = s + v
    })
    .Ok(s)
}
caller = (xs: [i32]) i32 {
    sum_ok(xs, 10, 9).match ({
        .Ok(v)  => v,
        .Err(e) => 50,
    })
}    // recovery proves the callee's early return did not escape into caller
main = () i32 {
    clean := caller([1, 2, 3])    // 6
    bail := caller([1, 20, 3])    // 50
    clean + bail
}
