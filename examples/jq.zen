// mini-jq — a tiny JSON query CLI, built on the public std API as a dogfooding exercise.
//
//   ./zen run examples/jq.zen '.a.b[0]' file.json
//   cat file.json | ./zen run examples/jq.zen '.a.b[0]'
//
// filter grammar (a subset of jq):
//   .              identity (the whole document)
//   .a.b           object field access
//   .arr[0]        array indexing
//   .a.b[2].c      the two combined
//
// With no [file], JSON is read from stdin. Output is std.format.json's 2-space `pretty`.
// All failures (missing file, bad JSON, bad path) are values: a clean message, a non-zero exit.
json = std.format.json
{ Value, JsonError } = std.format.json
{ Result, expect, name } = std.core.result
{ gpa } = std.mem.heap
{ println, formatln, arg_str, arg_int } = std.text.fmt
{ len, at, substr, cat, parse_int } = std.text.str
{ read_all } = std.io.stdin
{ contents } = std.io.file
{ argc, arg } = std.sys.os
// std.format.json exposes `JsonError` (with the byte offset that makes a parse failure
// actionable) but no namer for it — std.text.regex and std.net.http both ship an `error_name`.
// Rendering the variants by hand is the gap, not a design choice.
report_bad_json = (e: JsonError) i64 {
    e.match ({
        .Unexpected(p)      => formatln("jq: invalid JSON: unexpected character at byte {}", [arg_int(p)]),
        .BadString(p)       => formatln("jq: invalid JSON: bad string at byte {}", [arg_int(p)]),
        .BadNumber(p)       => formatln("jq: invalid JSON: bad number at byte {}", [arg_int(p)]),
        .BadLiteral(p)      => formatln("jq: invalid JSON: bad literal at byte {}", [arg_int(p)]),
        .TrailingGarbage(p) => formatln("jq: invalid JSON: trailing garbage at byte {}", [arg_int(p)]),
        .UnexpectedEof      => println("jq: invalid JSON: unexpected end of input"),
        .TooDeep            => println("jq: invalid JSON: nesting too deep"),
    })
}
// ── filter engine ─────────────────────────────────────────────────────────────
// Scan a field name starting at i, stopping at the next '.' or '['.
scan_key = (s: string_view, i: i64) i64 {
    (i >= s.len()).match ({
        true  => i,
        false => {
            b := s.at(i)
            (b == '.' || b == '[').then({ i }, { s.scan_key(i + 1) })
        },
    })
}
// Scan decimal digits starting at i, stopping at ']' or end.
scan_idx = (s: string_view, i: i64) i64 {
    (i >= s.len()).match ({
        true  => i,
        false => {
            b := s.at(i)
            (b >= '0' && b <= '9').then({ s.scan_idx(i + 1) }, { i })
        },
    })
}
// Apply the filter starting at byte i to the current value: .Ok(selected) or .Err(message).
// One path segment per call, recursing into the tail.
apply<A> = (a: MutPtr<A>, cur: Value, s: string_view, i: i64) Result<Value, string_view> {
    (i >= s.len()).match ({
        true  => {
            done: Result<Value, string_view> := .Ok(cur)
            return done
        },
        false => 0,
    })
    b := s.at(i)
    (b == '.').match ({
        true  => {
            j := s.scan_key(i + 1)
            // a bare trailing "." is the identity filter
            (j == i + 1 && j >= s.len()).match ({
                true  => {
                    id: Result<Value, string_view> := .Ok(cur)
                    return id
                },
                false => 0,
            })
            key := a.substr(s, i + 1, j - (i + 1)).expect("jq: substr failed")
            return json.get(cur, key).match ({
                .Some(nv) => a.apply(nv, s, j),
                .None     => {
                    miss: Result<Value, string_view> := .Err(a.cat("jq: no such field: ", key))
                    miss
                },
            })
        },
        false => 0,
    })
    (b == '[').match ({
        true  => {
            j := s.scan_idx(i + 1)
            (j == i + 1 || j >= s.len() || s.at(j) != ']').match ({
                true  => {
                    bad: Result<Value, string_view> := .Err("jq: malformed index (expected [N])")
                    return bad
                },
                false => 0,
            })
            idx := a.substr(s, i + 1, j - (i + 1)).expect("jq: substr failed").parse_int()
            return json.as_arr(cur).match ({
                .Some(xs) => (idx < xs.len).match ({
                    true  => a.apply(xs[idx], s, j + 1),
                    false => {
                        oob: Result<Value, string_view> := .Err("jq: index out of range")
                        oob
                    },
                }),
                .None     => {
                    nota: Result<Value, string_view> := .Err("jq: not an array")
                    nota
                },
            })
        },
        false => 0,
    })
    syn: Result<Value, string_view> := .Err("jq: bad filter syntax (expected '.' or '[')")
    syn
}
main = () i32 {
    h := gpa()
    a := h.addr()
    n := argc()
    // arg(0) is the program; the filter is arg(1), an optional source file arg(2).
    filter := (n >= 2).then({ arg(1) }, { "." })
    src := (n >= 3).match ({
        true  => a.contents(arg(2)).match ({
            .Err(e) => {
                formatln("jq: {}: {}", [arg_str(arg(2)), arg_str(name(e))])
                return 1
            },
            .Ok(s)  => s,
        }),
        false => a.read_all().match ({
            .Err(e) => {
                formatln("jq: <stdin>: {}", [arg_str(name(e))])
                return 1
            },
            .Ok(s)  => s,
        }),
    })
    doc := json.parse(a, src).match ({
        .Err(e) => {
            report_bad_json(e)
            return 1
        },
        .Ok(v)  => v,
    })
    a.apply(doc, filter, 0).match ({
        .Err(msg) => {
            println(msg)
            1
        },
        .Ok(sel)  => {
            // json.pretty is the 2-space indented encoder — the whole hand-rolled printer this
            // example used to carry is one library call now.
            println(json.pretty(a, sel))
            0
        },
    })
}
