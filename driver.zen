// driver.zen — the zenc CLI, in Zen. Dispatches on the command line and drives the compiler
// (resolve -> parse -> check -> genModule) and the C backend (cc). This replaces bootstrap/driver.c:
// once it roots --build-self, the seed carries `main` (emitted as zen_main) and driver.c is deleted.
{ arg, argc, getEnv } = std.sys.os
{ Os, Arch, Abi, Platform, host } = std.sys.platform
{ Malloc } = std.mem.alloc
{ eq, view } = std.text.str
{ fnv1a64_fold } = std.hash    // shared FNV-1a-64 rolling byte fold (centralized in std.hash)
{ gstr_string, gstr_append, gstr_finish, gstr_push } = compiler.genc    // the seed's String API (string.zen isn't in the manifest)
{ contents_in, out, out_bytes, save, O_RDONLY, O_WRONLY, O_CREAT, O_EXCL, O_WRTRUNC, MODE_644, MODE_755 } = std.io.file
{ or, expect } = std.core.result    // discard `out`/`out_bytes` write Results — the driver's stdout is best-effort
{ then } = std.core.bool
{ open, read, write, close, system, unlink, mkdir, rmdir, opendir, closedir, getpid, isatty } = std.c.libc
{ parse_module, exports_get } = compiler.parse
{ set_faithful_lexeme } = compiler.parse_atom
{ perr_get } = compiler.parse_type
{ lerr_get, collect_comments } = compiler.lex
{ resolve_module } = compiler.check
{ CheckDiagnostic, desc_or } = compiler.validate.diag
{ check_module_ownership_diagnostic_from_source, check_module_parse_diagnostic_from_source, check_module_no_if_diagnostic_from_source, check_module_reserved_diagnostic_from_source, check_module_escape_diagnostic_from_source, check_module_leak_diagnostic_from_source, check_module_addr_escape_diagnostic_from_source, check_module_send_rc_diagnostic_from_source, check_module_scratch_diagnostic_from_source, check_module_send_mut_diagnostic_from_source, check_module_bound_diagnostic_from_source, check_module_arg_diagnostic_from_source, check_module_or_return_diagnostic_from_source, check_module_unknown_type_diagnostic_from_source, check_module_ffi_diagnostic_from_source, check_module_mustuse_diagnostic_from_source, check_module_infinite_type_diagnostic_from_source, check_module_main_diagnostic_from_source, check_module_batch } = compiler.validate.core
{ denrich_check } = compiler.validate.enrich
{ genModuleIn } = compiler.genc_emit
{ genJsModuleIn } = compiler.genjs
{ pretty_module_in, pretty_set_comments } = compiler.pretty
{ diag_user_span, diag_line_span, DiagSpan, render_diagnostic, manifest_value_span } = compiler.diagnostic
{ resolve_program_data, first_user_import_in, ResolvedProgram, ModuleEntry, file_exists, ImportEdge, import_edges, seen_name, add_name, module_path, FlatRegion, fregion_find, fregion_src_line, undefined_name_hint } = std.internal.resolve
{ ffi_grants_set, ffi_grants_get, genmods_set, genmods_get } = std.internal.resolve_ffi
say = (s: string_view) i64 {
    out(s).or(0)
    out("\n").or(0)
}
derr = (s: string_view) i64 {
    v := s.view()
    write(2, v.ptr, v.len)
}    // diagnostics go to stderr
// the first FAILING diagnostic, else clean. `cd_or(a, b)` = a if a failed, else b — so this is a flat
// precedence chain of the checks in order, not a brace pyramid. Checks are independent and side-effect
// free, so running them all is harmless; the reported diagnostic is still the first failure in order.
cd_or = (a: CheckDiagnostic, b: CheckDiagnostic) CheckDiagnostic { (a.code == 0).match ({
    true  => b,
    false => a,
}) }
// the SPECIALIZED channels only (parse / ownership / escape / sendability / bound / … — every check
// EXCEPT the main type channel). If one fires it is the ROOT of the rejection: reported alone, so a
// downstream cascade of type errors from the same cause is suppressed. The main channel (names /
// types / arity / fit / exhaustiveness / …) is batched separately — check_module_batch — so its
// INDEPENDENT errors are all reported at once. A parse error, being here, always short-circuits the
// batch (the flat sentinels would otherwise spray bogus type errors).
check_diag_no_main = (mp: MutPtr<Malloc>, raw: [Decl], decls: [Decl], flat: string_view) CheckDiagnostic { check_module_no_if_diagnostic_from_source(flat).cd_or(mp.check_module_parse_diagnostic_from_source(decls, flat)).cd_or(mp.check_module_reserved_diagnostic_from_source(raw, flat)).cd_or(mp.check_module_ownership_diagnostic_from_source(raw, flat)).cd_or(mp.check_module_escape_diagnostic_from_source(raw, flat)).cd_or(mp.check_module_leak_diagnostic_from_source(raw, flat)).cd_or(mp.check_module_addr_escape_diagnostic_from_source(raw, flat)).cd_or(mp.check_module_send_rc_diagnostic_from_source(raw, flat)).cd_or(mp.check_module_scratch_diagnostic_from_source(raw, flat)).cd_or(mp.check_module_send_mut_diagnostic_from_source(raw, flat)).cd_or(mp.check_module_bound_diagnostic_from_source(raw, flat)).cd_or(mp.check_module_arg_diagnostic_from_source(raw, flat)).cd_or(mp.check_module_or_return_diagnostic_from_source(raw, flat)).cd_or(mp.check_module_unknown_type_diagnostic_from_source(decls, flat)).cd_or(mp.check_module_ffi_diagnostic_from_source(decls, flat)).cd_or(check_module_infinite_type_diagnostic_from_source(decls, flat)).cd_or(check_module_main_diagnostic_from_source(raw, flat)).cd_or(mp.check_module_mustuse_diagnostic_from_source(raw, flat)) }
RenderTarget*: {
    path: string_view,
    src: string_view,
}
pick_module = (flat: string_view, mods: [ModuleEntry], i: i64, off: i32, w: i32, rpath: string_view, rsrc: string_view) RenderTarget {
    (i >= mods.len).match ({
        true  => RenderTarget(
            path: rpath,
            src: rsrc,
        ),
        false => {
            m := mods[i]
            sp := diag_user_span(flat, m.source, off, w)
            (sp.line > 0).match ({
                true  => RenderTarget(
                    path: m.path,
                    src: m.source,
                ),
                false => flat.pick_module(mods, i + 1, off, w, rpath, rsrc),
            })
        },
    })
}
pick_render = (rp: ResolvedProgram, off: i32, w: i32, rpath: string_view, rsrc: string_view) RenderTarget {
    (diag_user_span(rp.flat, rsrc, off, w).line == 0).match ({
        true  => rp.flat.pick_module(rp.table.modules, 0, off, w, rpath, rsrc),
        false => RenderTarget(
            path: rpath,
            src: rsrc,
        ),
    })
}
// a fully located diagnostic: the module file it lives in plus its line:col span there.
DiagLoc: {
    path: string_view,
    src: string_view,
    sp: DiagSpan,
}
// IDENTITY-FIRST location: binary-search the resolver's region map (flat offset → module + original
// line — exact even when two modules share identical line text), then recover the column against that
// single known line. The whole-table fuzzy scan survives ONLY as the last resort for offsets no
// region contains (synthesized positions, separator bytes).
locate_diag = (rp: ResolvedProgram, off: i32, w: i32, rpath: string_view, rsrc: string_view) DiagLoc {
    ri := rp.regions.fregion_find(to_i64(off))
    (off >= 0 && ri >= 0).then({
        srcline := rp.regions.fregion_src_line(rp.line_srcs, rp.flat, ri, to_i64(off))
        (srcline > 0).then({
            m := rp.table.modules[rp.regions[ri].midx]
            return DiagLoc(
                path: m.path,
                src: m.source,
                sp: diag_line_span(rp.flat, m.source, off, w, srcline),
            )
        })
    })
    rt := pick_render(rp, off, w, rpath, rsrc)
    DiagLoc(
        path: rt.path,
        src: rt.src,
        sp: diag_user_span(rp.flat, rt.src, off, w),
    )
}
// render ONE diagnostic (file:line:col + caret + hint) to stderr, mapping its flat offset to the
// module its error actually lives in. cd.count>1 appends the legacy inline "(+K more)" suffix — used
// only on the specialized-channel path, where a single root error stands in for a whole cascade.
emit_one = (mp: MutPtr<Malloc>, raw: [Decl], decls: [Decl], rp: ResolvedProgram, path: string_view, user: string_view, cd: CheckDiagnostic) i64 {
    dl := locate_diag(rp, cd.source_offset, cd.span_width, path, user)
    msg := desc_or(mp.denrich_check(raw, decls, cd.source_offset, cd.code, cd.kind), cd.message)
    // World teaching hint: an undefined name that some closure module EXPORTS names that module
    // (with the import to write) instead of the generic advice — see undefined_name_hint.
    hint := cd.hint
    eq(cd.kind, "undefined-name").then({
        wh := mp.undefined_name_hint(rp.table, rp.flat, cd.source_offset)
        (is_empty(wh) == false).then({
            hint = wh
        })
    })
    derr(mp.render_diagnostic(dl.path, dl.src, dl.sp.line, dl.sp.col, dl.sp.end_col, cd.kind, msg, hint, cd.count))
}
// Source-only commands (`fmt` and the deliberately-untyped raw emitter) do not own a ResolvedProgram,
// but the no-if language rule still applies. Render the same structured diagnostic directly against
// their input so every user-facing command teaches the canonical `.match` replacement.
report_no_if_plain = (mp: MutPtr<Malloc>, path: string_view, src: string_view) i32 {
    cd := check_module_no_if_diagnostic_from_source(src)
    (cd.code == 0).match ({
        true  => 0,
        false => {
            sp := diag_user_span(src, src, cd.source_offset, cd.span_width)
            derr(mp.render_diagnostic(path, src, sp.line, sp.col, sp.end_col, cd.kind, cd.message, cd.hint, cd.count))
            1
        },
    })
}
// Checked commands preflight the resolved flat source before parsing or semantic lowering. This keeps
// the obsolete guard parser/lowerer out of the execution path and still maps an `if` in an imported
// module back to that module's real file.
report_no_if_resolved = (mp: MutPtr<Malloc>, rp: ResolvedProgram, path: string_view, user: string_view) i32 {
    cd := check_module_no_if_diagnostic_from_source(rp.flat)
    (cd.code == 0).match ({
        true  => 0,
        false => {
            dl := locate_diag(rp, cd.source_offset, cd.span_width, path, user)
            derr(mp.render_diagnostic(dl.path, dl.src, dl.sp.line, dl.sp.col, dl.sp.end_col, cd.kind, cd.message, cd.hint, cd.count))
            1
        },
    })
}
// how many main-channel diagnostics we print before collapsing the rest into a single trailer line.
DIAG_CAP = () i32 { 20 }
// after the cap, one line naming the K un-rendered errors (so the tail is never silently dropped).
emit_more_trailer = (mp: MutPtr<Malloc>, k: i32) i64 {
    s := mp.gstr_string(48).gstr_append(mp, "zenc: (+").push_int(mp, to_i64(k)).gstr_append(mp, " more error")
    s2 := (k == 1).match ({
        true  => s.gstr_push(mp, ')'),
        false => s.gstr_push(mp, 's').gstr_push(mp, ')'),
    })
    derr(s2.gstr_push(mp, '\n').gstr_finish(mp))
}
// 0 if clean; else render EVERY main-channel diagnostic (capped, with a trailer) and return the count.
report_check = (mp: MutPtr<Malloc>, raw: [Decl], decls: [Decl], rp: ResolvedProgram, path: string_view, user: string_view) i32 {
    // a specialized channel (parse / ownership / escape / bound / …) is the ROOT — report it alone.
    spec := mp.check_diag_no_main(raw, decls, rp.flat)
    (spec.code != 0).match ({
        true  => {
            mp.emit_one(raw, decls, rp, path, user, spec)
            spec.count
        },
        false => {
            ds := mp.check_module_batch(decls, rp.flat)
            n := to_i32(ds.len)
            ds.loop((h, i, cd) {
                (to_i32(i) < DIAG_CAP()).then({
                    mp.emit_one(raw, decls, rp, path, user, cd)
                })
            })
            (n > DIAG_CAP()).then({
                mp.emit_more_trailer(n - DIAG_CAP())
            })
            n
        },
    })
}
// run/build temp.c swaps the emitted HEAD typedef for the zenrt.h include; the PROG variant also
// suppresses zenrt's String (the program emits its own). --build-self uses the plain seed variant.
// module-level str CONSTS don't emit as C globals in the seed, so these are zero-arg fns.
HEAD = () string_view { "typedef struct { void* ptr; int64_t len; } zslice; " }
HEAD_REPL = () string_view { "#define ZEN_NO_STRING 1\n#define ZEN_NO_MALLOC 1\n#include \"zenrt.h\"\n" }
// Intermediate /tmp files are namespaced by pid so two concurrent `zenc` invocations never clobber
// each other's temp.c / temp.bin (a fixed path made one process compile/run the OTHER's program).
// getpid() is constant for the life of a run, so each builder yields the SAME path on every call —
// the write + the cc command (TMPC), and the build output + the run (TMPBIN), stay consistent.
pid_digit = (d: i64) u8 { load(offset("0123456789", d)) }
push_int = (s: String, mp: MutPtr<Malloc>, n: i64) String {
    (n < 10).match ({
        true  => s.gstr_push(mp, pid_digit(n)),
        false => {
            hs := s.push_int(mp, n / 10)
            hs.gstr_push(mp, pid_digit(n % 10))
        },
    })
}    // hoist (gstr_reserve re-evals the receiver)
pid_path = (mp: MutPtr<Malloc>, pre: string_view, suf: string_view) string_view { mp.gstr_string(64).gstr_append(mp, pre).push_int(mp, getpid()).gstr_append(mp, suf).gstr_finish(mp) }
TMPC = (mp: MutPtr<Malloc>) string_view { mp.pid_path("/tmp/zenc_zd_", ".c") }
TMPBIN = (mp: MutPtr<Malloc>) string_view { mp.pid_path("/tmp/zenc_zd_", ".bin") }
// ── path helpers ────────────────────────────────────────────────────────────────────────────────
dirname = (mp: MutPtr<Malloc>, p: string_view) string_view {
    v := p.view()
    cut := last_slash(v, 0, 0 - 1)
    (cut < 0).match ({ true => ".", false => mp.cstr_prefix(p, cut) })
}
last_slash = (v: [u8], i: i64, best: i64) i64 {
    (i >= v.len).match ({
        true  => best,
        false => v.last_slash(i + 1, (v[i] == '/').match ({ true => i, false => best })),
    })
}
// the first `n` bytes of `p` as an owned str — built through the allocator (no raw malloc).
cstr_prefix = (mp: MutPtr<Malloc>, p: string_view, n: i64) string_view { push_prefix(mp.gstr_string(n + 1), mp, p.view(), 0, n).gstr_finish(mp) }
push_prefix = (s: String, mp: MutPtr<Malloc>, v: [u8], i: i64, n: i64) String { (i >= n).match ({
    true  => s,
    false => push_prefix(s.gstr_push(mp, v[i]), mp, v, i + 1, n),
}) }
// ── the compile pipeline (resolve imports -> parse -> resolve_module) ─────────────────────────────
// flatten imports from disk: root = dir of the zen binary (holds src/std + src/compiler), progdir =
// dir of the program (holds its siblings). Import-free programs pass through unchanged.
flatten = (mp: MutPtr<Malloc>, root: string_view, path: string_view, src: string_view) string_view { mp.resolve_program_data(root, mp.dirname(path), path, src).flat }
// the full resolved program (flat + per-module table) — check/build keep it so a diagnostic can
// render against the imported module its error actually lives in.
resolve_prog = (mp: MutPtr<Malloc>, root: string_view, path: string_view, src: string_view) ResolvedProgram { mp.resolve_program_data(root, mp.dirname(path), path, src) }
decls_of = (mp: MutPtr<Malloc>, root: string_view, path: string_view, src: string_view) [Decl] { mp.resolve_module(mp.parse_module(mp.flatten(root, path, src))) }
// write the runnable temp.c: zenrt.h-include head, then the emitted body (after HEAD).
write_runnable_c = (tmpc: string_view, gen: String) bool {
    hl := HEAD().view().len
    fd := tmpc.open(O_WRTRUNC, MODE_644)
    (fd < 0).match ({
        true  => false,
        false => {
            hv := HEAD_REPL().view()
            fd.write(hv.ptr, hv.len)
            fd.write(gen.ptr.offset(hl), gen.len - hl)
            fd.close()
            true
        },
    })
}
// cc -std=gnu11 -O1 -foptimize-sibling-calls -fwrapv -w -fno-diagnostics-show-caret -I<root>/bootstrap TMPC <root>/bootstrap/zenrt.c <ccflags> <links> -o <out>
// ccflags/links come from a project's zen.toml (extra .c files + `-l` libs); empty for single files.
// -O1 -foptimize-sibling-calls: Zen's ONLY loop is recursion (control flow is `.match` + recursion), so
// self-tail-recursive fns — emitted by genc as a bare `return f(...)` (proper C tail position) — MUST get
// sibling-call elimination or a deep idiomatic loop blows the C stack (raw SIGSEGV ~250k frames at -O0).
// The opt fires only at >= -O1; -O1 (not -O2) keeps -fstrict-aliasing OFF, which this void*-punning
// emitted C relies on. Affects BUILT/RUN user programs only — the bootstrap seed compiles via
// bootstrap/Makefile CFLAGS, untouched, so the byte-exact fixpoint is unaffected. Non-tail recursion
// whose result feeds a branch still overflows — caught by zenrt.c's stack-overflow panic.
cc_command = (mp: MutPtr<Malloc>, root: string_view, tmpc: string_view, out: string_view, ccflags: string_view, links: string_view, ccname: string_view) string_view { mp.gstr_string(256).gstr_append(mp, ccname).gstr_append(mp, " -std=gnu11 -Wno-error=implicit-function-declaration -O1 -foptimize-sibling-calls -fwrapv -w -I").gstr_append(mp, root).gstr_append(mp, "/bootstrap ").gstr_append(mp, tmpc).gstr_append(mp, " ").gstr_append(mp, root).gstr_append(mp, "/bootstrap/zenrt.c ").gstr_append(mp, ccflags).gstr_append(mp, " ").gstr_append(mp, links).gstr_append(mp, " -lm").gstr_append(mp, " -o ").gstr_append(mp, out).gstr_finish(mp) }    // libm: always link (sin/cos/log/exp/pow); free if unused
// ── cross-toolchain selection (`Target.target(platform)` in build.zen) ────────────────────────────
// A native Spec (target "") compiles with host `cc` — the command line above, byte-identical to
// before. A cross triple resolves a C compiler in this order:
//   1. $ZENC_TARGET_CC — the verbatim compiler command (the documented escape hatch);
//   2. the conventional cross gcc `<triple>-gcc` on PATH (aarch64-linux-gnu-gcc, …), which brings
//      its own sysroot libc, so -lm/-lpthread and a project's `link =` just work;
//   3. `zig cc -target <triple>` when zig is on PATH.
// Nothing found -> a LOUD error and no build. There is NEVER a silent host-cc fallback: a wrong-
// architecture binary that "builds fine" is strictly worse than an error.
which_ok = (mp: MutPtr<Malloc>, name: string_view) bool { mp.gstr_string(64).gstr_append(mp, "command -v ").gstr_append(mp, name).gstr_append(mp, " >/dev/null 2>&1").gstr_finish(mp).system() == 0 }
cross_cc = (mp: MutPtr<Malloc>, target: string_view) string_view {
    eq(target, "").then({
        return "cc"
    })
    envcc := getEnv("ZENC_TARGET_CC")
    (eq(envcc, "") == false).then({
        return envcc
    })
    gcc := mp.gstr_string(32).gstr_append(mp, target).gstr_append(mp, "-gcc").gstr_finish(mp)
    mp.which_ok(gcc).then({
        return gcc
    })
    mp.which_ok("zig").then({
        return mp.gstr_string(48).gstr_append(mp, "zig cc -target ").gstr_append(mp, target).gstr_finish(mp)
    })
    derr("zenc: error: cross target ")
    derr(target)
    derr(" needs a toolchain — set ZENC_TARGET_CC, or install ")
    derr(gcc)
    derr(" or zig\n")
    ""
}
// ── content-hash compile cache ────────────────────────────────────────────────────────────────────
// check/run/build re-frontend the WHOLE flattened import closure on every invocation (~27s for a
// program importing the compiler). The cache keys a fully-SUCCESSFUL result by CONTENT: FNV-1a 64-bit
// over the running zenc binary's own bytes (a rebuilt compiler invalidates everything it ever cached),
// the version string, the command kind, ccflags/links (a token naming a readable file — a project's
// extra native .c — folds in its bytes, so editing it misses), and the SOURCE of every module in the
// import closure (the probe loads the transitive module table only — the flattened text it would
// produce is a deterministic function of those sources plus the stamped compiler, so hashing the
// inputs covers it while skipping the expensive namespace-strip/dedup flatten on a hit). No mtimes,
// no filesystem paths: an identical program is an identical key. A `check` hit replays the ok line
// from a marker file; a `run`/`build` hit copies the cached binary into place. Failures are NEVER
// cached (the entry is written only after the full pipeline succeeded). ZENC_NO_CACHE=1 (any
// non-empty value) bypasses both reads and writes; ZENC_CACHE_DIR overrides /tmp/zenc-cache (the
// harness's cache cases point it at scratch). i64 wraps like the spec's u64: every build has -fwrapv.
FNV_BASIS = () i64 { 0 - 3750763034362895579 }    // 0xcbf29ce484222325, the FNV-1a-64 offset basis, as an i64
fnv_str = (h: i64, s: string_view) i64 { h.fnv1a64_fold(s.view()) }
flag_token_end = (v: [u8], i: i64) i64 { (i >= v.len || v[i] == ' ').match ({
    true  => i,
    false => v.flag_token_end(i + 1),
}) }
// fold a flag string: its text (order + non-file tokens like -lm), plus the CONTENT of every
// whitespace token that names a readable file (a project's extra .c sources compiled into the binary).
fnv_flag_files = (mp: MutPtr<Malloc>, h: i64, v: [u8], i: i64) i64 {
    (i >= v.len).match ({
        true  => h,
        false => (v[i] == ' ').match ({
            true  => mp.fnv_flag_files(h, v, i + 1),
            false => {
                e := flag_token_end(v, i)
                tok := push_prefix(mp.gstr_string(e - i + 1), mp, v, i, e).gstr_finish(mp)
                h2 := contents_in(mp, tok).match ({
                    .Ok(c)  => h.fnv_str(c),
                    .Err(x) => h,
                })
                mp.fnv_flag_files(h2, v, e)
            },
        }),
    })
}
fnv_flags = (h: i64, mp: MutPtr<Malloc>, s: string_view) i64 {
    v: [u8] := s.view()
    mp.fnv_flag_files(h.fnv_str(s), v, 0)
}
// the compiler's own identity: the hash of the running zenc binary. A rebuilt zenc — new checker, new
// codegen, new zenrt.c, all compiled in — yields a new stamp, so an old binary's entries can never be
// replayed by a new one. The identity SOURCE is `/proc/self/exe` (Linux): the kernel resolves it to the
// real binary regardless of how the process was launched, so a PATH-installed `zenc` (whose argv[0] is a
// bare, unreadable `zenc`) still stamps and thus still caches. Falls back to argv[0] when /proc is absent
// (non-Linux), then to 0 — an unavailable stamp DISABLES the cache for the run (empty key). Read in
// explicit-length chunks and fold as [u8]: an ELF binary has a NUL at byte 5, so any strlen-based view
// (contents_in -> .view()) would hash only the first ~4 bytes and stamp EVERY build identically.
self_exe_fd = () i32 {
    fd := "/proc/self/exe".open(O_RDONLY, 0)
    (fd < 0).match ({ true => arg(0).open(O_RDONLY, 0), false => fd })
}
cache_self = (mp: MutPtr<Malloc>) i64 {
    fd := self_exe_fd()
    (fd < 0).match ({
        true  => 0,
        false => {
            h := fd.cache_self_fold(mp.gstr_string(65536), FNV_BASIS())
            fd.close()
            h
        },
    })
}
cache_self_fold = (fd: i32, buf: String, h: i64) i64 {
    n := fd.read(buf.ptr, 65536)
    (n <= 0).match ({
        true  => h,
        false => fd.cache_self_fold(buf, h.fnv1a64_fold(buf.ptr.slice(n))),
    })
}
cache_hex_digit = (d: i64) u8 { load(offset("0123456789abcdef", d)) }
push_hex = (s: String, mp: MutPtr<Malloc>, h: i64, i: i64) String {
    (i < 0).match ({
        true  => s,
        false => {
            hs := s.gstr_push(mp, cache_hex_digit(h >> i * 4 & 15))
            hs.push_hex(mp, h, i - 1)
        },
    })
}    // nibble i*4..0, most significant first (hoist: gstr_reserve re-evals the receiver)
cache_dir = () string_view {
    e := getEnv("ZENC_CACHE_DIR")
    eq(e, "").match ({ true => "/tmp/zenc-cache", false => e })
}
cache_on = () bool { eq(getEnv("ZENC_NO_CACHE"), "") }
// ── the probe's light closure walk ── the resolver's own module walk (module_table) builds a full
// per-module symbol graph twice over; the probe only needs BYTES, so it walks the same import edges
// (the resolver's exported edge scanner — the one source of truth for what an import line is) and
// folds each module's logical id + entire source into the key. Any edit to any imported file, however
// deep, changes the key. An unreadable/unknown module folds its id only — the miss path then reports
// it with the resolver's real diagnostic (and a failed pipeline never populates the cache).
CacheWalk: {
    seen: String,
    h: i64,
}
edges_of = (mp: MutPtr<Malloc>, src: string_view) [ImportEdge] { mp.import_edges(src).expect("zenc: cache probe: allocation failed") }
// id → file through the resolver's ONE exported module_path (the canonical ModuleId → path fn),
// so the probe can never drift from the loader's mapping.
cache_module_path = (mp: MutPtr<Malloc>, root: string_view, progdir: string_view, id: string_view) string_view { mp.module_path(root, progdir, mp.gstr_string(24).gstr_append(mp, id)) }
cache_walk_one = (mp: MutPtr<Malloc>, root: string_view, progdir: string_view, id: string_view, st: CacheWalk) CacheWalk {
    idn := mp.gstr_string(24).gstr_append(mp, id)
    st.seen.seen_name(idn).match ({
        true  => st,
        false => {
            next := CacheWalk(
                seen: st.seen.add_name(mp, idn),
                h: st.h.fnv_str(id),
            )
            contents_in(mp, mp.cache_module_path(root, progdir, id)).match ({
                .Ok(msrc) => mp.cache_walk_edges(root, progdir, mp.edges_of(msrc), CacheWalk(
                    seen: next.seen,
                    h: next.h.fnv_str(msrc),
                )),
                .Err(e)   => next,
            })
        },
    })
}
cache_walk_edges = (mp: MutPtr<Malloc>, root: string_view, progdir: string_view, edges: [ImportEdge], st: CacheWalk) CacheWalk {
    cur := st
    edges.loop((lh, i, e) {
        cur = mp.cache_walk_one(root, progdir, e.module, cur)
    })
    cur
}
// the on-disk entry for one (kind, program) pair: <dir>/<kind>_<16 hex digits>.
cache_probe = (mp: MutPtr<Malloc>, kind: string_view, root: string_view, path: string_view, src: string_view, ccflags: string_view, links: string_view, target: string_view) string_view {
    // An unreadable binary (neither /proc/self/exe nor argv[0] opens) means the compiler-identity stamp
    // is unavailable; a shared degenerate stamp would let a REBUILT compiler replay a stale entry. Empty
    // key = cache disabled for this run.
    self := mp.cache_self()
    (self == 0).then({
        return ""
    })
    // ZEN_VIS_REPORT is part of the key: a report-only sweep (visibility/private-leak violations
    // print but never fail) must not stamp a check-ok an ENFORCED run would replay as clean.
    // The manifest/registry FFI grants are part of the key (stamped by the spec commands before any
    // probe): a program cached as clean under `ffi = "dep"` must MISS once the grant is revoked. The
    // entry-file pragma needs no folding — it lives in `src`, already keyed.
    // The registered c_library genmod map folds in the same way (the generated files' CONTENT is
    // hashed by the walk below through module_path; the map itself covers id/path re-registration).
    // The cross-target triple is part of the key: flipping `Target.target(...)` MUST miss — a
    // cached aarch64 binary must never replay as the x86_64 build (or vice versa).
    h0 := self.fnv_str(VERSION()).fnv_str(kind).fnv_str(getEnv("ZEN_VIS_REPORT")).fnv_str(ffi_grants_get()).fnv_str(genmods_get()).fnv_flags(mp, ccflags).fnv_flags(mp, links).fnv_str(target).fnv_str(src)
    st := mp.cache_walk_edges(root, mp.dirname(path), mp.edges_of(src), CacheWalk(
        seen: mp.gstr_string(256),
        h: h0,
    ))
    mp.gstr_string(96).gstr_append(mp, cache_dir()).gstr_push(mp, '/').gstr_append(mp, kind).gstr_push(mp, '_').push_hex(mp, st.h, 15).gstr_finish(mp)
}
// mark a fully-successful `check`: the marker's EXISTENCE is the cached verdict (content is cosmetic).
cache_put_ok = (path: string_view) i64 {
    mkdir(cache_dir(), MODE_755)
    save(path, "ok\n", 3).or(0)
}
// copy the cached binary into place; chmod so the exec bit survives any pre-existing destination.
cache_bin_cmd = (mp: MutPtr<Malloc>, cb: string_view, out: string_view) string_view { mp.gstr_string(160).gstr_append(mp, "cp ").quote_arg(mp, cb).gstr_push(mp, ' ').quote_arg(mp, out).gstr_append(mp, " && chmod 755 ").quote_arg(mp, out).gstr_finish(mp) }
// publish a built binary: copy to a pid-suffixed temp inside the cache dir, then atomic `mv -f` — a
// concurrent zenc never observes a half-written entry (and an exec'ing reader never sees ETXTBSY).
cache_store_bin = (mp: MutPtr<Malloc>, cb: string_view, out: string_view) i32 {
    mkdir(cache_dir(), MODE_755)
    tmp := mp.gstr_string(96).gstr_append(mp, cb).gstr_push(mp, '.').push_int(mp, getpid()).gstr_finish(mp)
    mp.gstr_string(256).gstr_append(mp, "cp ").quote_arg(mp, out).gstr_push(mp, ' ').quote_arg(mp, tmp).gstr_append(mp, " && mv -f ").quote_arg(mp, tmp).gstr_push(mp, ' ').quote_arg(mp, cb).gstr_finish(mp).system()
}
// type-check, then (if clean) emit + cc to `out`. returns 0 on success, 1 on a check error or cc
// failure. The cache wraps this whole pipeline: a hit copies the previously-built binary and skips
// resolve-onward re-verification (the key proves the identical closure already compiled cleanly).
compile_to = (mp: MutPtr<Malloc>, root: string_view, path: string_view, src: string_view, out: string_view, ccflags: string_view, links: string_view, target: string_view) i32 {
    ccname := mp.cross_cc(target)
    eq(ccname, "").then({
        return 1
    })    // unresolvable cross toolchain: already reported loudly; NEVER fall back to host cc
    cb := mp.cache_probe("bin", root, path, src, ccflags, links, target)
    (cache_on() && eq(cb, "") == false && file_exists(cb) && mp.cache_bin_cmd(cb, out).system() == 0).match ({
        true  => 0,
        false => {
            rc := mp.compile_flat(root, path, src, out, ccflags, links, ccname)
            (rc == 0 && cache_on() && eq(cb, "") == false).then({
                mp.cache_store_bin(cb, out)
            })
            rc
        },
    })
}
compile_flat = (mp: MutPtr<Malloc>, root: string_view, path: string_view, src: string_view, out: string_view, ccflags: string_view, links: string_view, ccname: string_view) i32 {
    rp := mp.resolve_prog(root, path, src)
    (mp.report_no_if_resolved(rp, path, src) == 0).match ({
        true  => {
            raw := mp.parse_module(rp.flat)
            decls := mp.resolve_module(raw)
            (mp.report_check(raw, decls, rp, path, src) == 0).match ({
                true  => {
                    gen := mp.genModuleIn(decls)
                    tmpc := mp.TMPC()
                    write_runnable_c(tmpc, gen).match ({
                        true  => (mp.cc_command(root, tmpc, out, ccflags, links, ccname).system() == 0).match ({
                            true  => 0,
                            false => {
                                derr("zenc: internal: generated C failed to compile (this is a compiler bug — please report)\n")
                                1
                            },
                        }),
                        false => 1,
                    })
                },
                false => 1,
            })
        },
        false => 1,
    })
}
// ── subcommands ───────────────────────────────────────────────────────────────────────────────────
// `emit <file>` type-checks FIRST (like check/build) and STOPS on any error, so a type-broken program
// never produces C that references undefined names. `--force` / `--no-check` are CLI aliases of the
// checked path (they do NOT bypass the validator); flag may sit before OR after the path.
emit_file = (mp: MutPtr<Malloc>, root: string_view, a2: string_view, a3: string_view) i32 {
    flag2 := eq(a2, "--force") || eq(a2, "--no-check")
    path := flag2.match ({ true => a3, false => a2 })
    force := flag2 || eq(a3, "--force") || eq(a3, "--no-check")
    force.match ({ true => mp.emit_raw(root, path), false => mp.emit_checked(root, path) })
}
// emit_raw is an alias of emit_checked — kept so older call sites still resolve.
emit_raw = (mp: MutPtr<Malloc>, root: string_view, path: string_view) i32 { mp.emit_checked(root, path) }
// checked: run the full report_check pipeline; emit only when clean, else exit 1 with the diagnostic.
emit_checked = (mp: MutPtr<Malloc>, root: string_view, path: string_view) i32 {
    contents_in(mp, path).match ({
        .Ok(src) => {
            rp := mp.resolve_prog(root, path, src)
            (mp.report_no_if_resolved(rp, path, src) == 0).match ({
                true  => {
                    raw := mp.parse_module(rp.flat)
                    decls := mp.resolve_module(raw)
                    (mp.report_check(raw, decls, rp, path, src) == 0).match ({
                        true  => {
                            out_bytes(mp.genModuleIn(decls).bytes())
                            0
                        },
                        false => 1,
                    })
                },
                false => 1,
            })
        },
        .Err(e)  => {
            derr("zenc: cannot read input\n")
            1
        },
    })
}
// ── genjs backend (task #46): Zen AST -> JavaScript. `emit-js` checks then emits the floor
// (bootstrap/zenrt.js) + the module JS; `build --target js` writes the same to a .js file. Additive:
// it reuses the exact resolve/parse/check pipeline, only swapping genModuleIn for genJsModuleIn. ──
js_floor = (mp: MutPtr<Malloc>, root: string_view) string_view {
    contents_in(mp, mp.bs_join(root, "bootstrap/zenrt.js")).match ({
        .Ok(src) => src,
        .Err(e)  => {
            derr("zenc: emit-js: cannot open bootstrap/zenrt.js floor\n")
            ""
        },
    })
}
// emit floor + module JS to stdout (checked): a type-broken program never produces JS.
emit_js = (mp: MutPtr<Malloc>, root: string_view, path: string_view) i32 {
    contents_in(mp, path).match ({
        .Ok(src) => {
            rp := mp.resolve_prog(root, path, src)
            (mp.report_no_if_resolved(rp, path, src) == 0).match ({
                true  => {
                    raw := mp.parse_module(rp.flat)
                    decls := mp.resolve_module(raw)
                    (mp.report_check(raw, decls, rp, path, src) == 0).match ({
                        true  => {
                            out(mp.js_floor(root))
                            out("\n")
                            out_bytes(mp.genJsModuleIn(decls).bytes())
                            0
                        },
                        false => 1,
                    })
                },
                false => 1,
            })
        },
        .Err(e)  => {
            derr("zenc: emit-js: cannot read input\n")
            1
        },
    })
}
// `zenc build --target js <file> [-o out.js]` -> write floor + module JS to `out` (default a.js).
build_js = (mp: MutPtr<Malloc>, root: string_view, path: string_view, out_path: string_view) i32 {
    contents_in(mp, path).match ({
        .Ok(src) => {
            rp := mp.resolve_prog(root, path, src)
            (mp.report_no_if_resolved(rp, path, src) == 0).match ({
                true  => {
                    raw := mp.parse_module(rp.flat)
                    decls := mp.resolve_module(raw)
                    (mp.report_check(raw, decls, rp, path, src) == 0).match ({
                        true  => {
                            js := mp.gstr_string(8192).gstr_append(mp, mp.js_floor(root)).gstr_append(mp, "\n")
                            mod := mp.genJsModuleIn(decls)
                            full := js.gstr_append(mp, mod.finish_cstr(mp))
                            save(out_path, full.finish_cstr(mp), full.len).match ({
                                .Ok(n)  => {
                                    derr("zenc: wrote ")
                                    derr(out_path)
                                    derr("\n")
                                    0
                                },
                                .Err(e) => 1,
                            })
                        },
                        false => 1,
                    })
                },
                false => 1,
            })
        },
        .Err(e)  => {
            derr("zenc: build --target js: cannot read input\n")
            1
        },
    })
}
finish_cstr = (s: String, mp: MutPtr<Malloc>) string_view { cstr(s.ptr) }
// `zenc build --target js <file> [-o out]` -> genjs; otherwise the ordinary C `build`. Args:
// arg(2)=--target arg(3)=js arg(4)=<file> arg(5)=-o arg(6)=<out>.
build_target = (mp: MutPtr<Malloc>, root: string_view) i32 {
    (eq(arg(2), "--target") && eq(arg(3), "js")).match ({
        true  => {
            out := eq(arg(5), "-o").match ({ true => arg(6), false => "a.js" })
            mp.build_js(root, arg(4), out)
        },
        false => eq(arg(2), "--target").match ({
            true  => mp.build_named_plan(root, arg(4), arg(3)),
            false => file_exists(mp.join2(arg(2), "build.zen")).match ({
                true  => mp.build_all_plan(root, arg(2)),
                false => mp.build_spec(root, mp.resolve_spec(root, arg(2)), arg(3), arg(4)),
            }),
        }),
    })
}
// check/build/run operate on a Spec (a single file, or a zen.toml project). spec.source is the
// entry; spec.ccflags/links/out come from a project's manifest (empty for a single file).
check_spec = (mp: MutPtr<Malloc>, root: string_view, spec: Spec) i32 { spec.ok.match ({
    true  => mp.check_spec_ok(root, spec),
    false => 1,
}) }    // resolve_spec already reported why
check_spec_ok = (mp: MutPtr<Malloc>, root: string_view, spec: Spec) i32 {
    ffi_grants_set(spec.ffi)    // manifest/registry FFI grants: stamped before probe AND resolve
    genmods_set(spec.genmods)    // registered c_library genmods: same stamp discipline
    contents_in(mp, spec.source).match ({
        .Ok(src) => {
            // a probe hit means this exact closure content already checked clean: replay the ok line.
            ck := mp.cache_probe("check", root, spec.source, src, spec.ccflags, spec.links, spec.target)
            (cache_on() && eq(ck, "") == false && file_exists(ck)).match ({
                true  => check_ok_line(spec.source),
                false => {
                    rp := mp.resolve_prog(root, spec.source, src)
                    (mp.report_no_if_resolved(rp, spec.source, src) == 0).match ({
                        true  => {
                            raw := mp.parse_module(rp.flat)
                            decls := mp.resolve_module(raw)
                            (mp.report_check(raw, decls, rp, spec.source, src) == 0).match ({
                                true  => {
                                    (cache_on() && eq(ck, "") == false).then({
                                        cache_put_ok(ck)
                                    })
                                    check_ok_line(spec.source)
                                },
                                false => 1,
                            })
                        },
                        false => 1,
                    })
                },
            })
        },
        .Err(e)  => {
            derr("zenc: cannot open input\n")
            1
        },
    })
}
check_ok_line = (path: string_view) i32 {
    derr("zenc: ")
    derr(path)
    derr(": ok\n")
    0
}    // <path>: ok -> stderr
build_spec = (mp: MutPtr<Malloc>, root: string_view, spec: Spec, flag: string_view, outarg: string_view) i32 {
    spec.ok.match ({
        true  => {
            spec.library.then({
                derr("zenc: cannot build a library project yet; use `zenc check <project>`\n")
                return 1
            })
            ffi_grants_set(spec.ffi)    // manifest/registry FFI grants: stamped before probe AND resolve
            genmods_set(spec.genmods)    // registered c_library genmods: same stamp discipline
            out := eq(spec.out, "").match ({ true => build_out(flag, outarg), false => spec.out })
            contents_in(mp, spec.source).match ({
                .Ok(src) => (mp.compile_to(root, spec.source, src, out, spec.ccflags, spec.links, spec.target) == 0).match ({
                    true  => file_exists(out).match ({
                        true  => {
                            derr("zenc: wrote ")
                            derr(out)
                            derr("\n")
                            0
                        },
                        false => {
                            derr("zenc: build produced no binary: ")
                            derr(out)
                            derr(" (compiler reported success but the file is missing)\n")
                            1
                        },
                    }),
                    false => {
                        derr("zenc: build failed: ")
                        derr(spec.source)
                        derr("\n")
                        1
                    },
                }),
                .Err(e)  => {
                    derr("zenc: cannot open input: ")
                    derr(spec.source)
                    derr("\n")
                    1
                },
            })
        },
        false => 1,
    })
}
// shell-quote one forwarded arg for the `system()` sh -c line: wrap in single quotes,
// an embedded `'` becomes `'\''` (close, escaped quote, reopen).
quote_arg = (s: String, mp: MutPtr<Malloc>, t: string_view) String {
    cur := s.gstr_push(mp, '\'')
    v: [u8] := t.view()
    v.loop((h, i, b) {
        cur = (b == '\'').match ({
            true  => cur.gstr_append(mp, "'\\''"),
            false => cur.gstr_push(mp, b),
        })
    })
    cur.gstr_push(mp, '\'')
}
append_run_args = (s: String, mp: MutPtr<Malloc>, i: i32, n: i32) String {
    (i >= n).match ({
        true  => s,
        false => s.gstr_push(mp, ' ').quote_arg(mp, arg(i)).append_run_args(mp, i + 1, n),
    })
}
// `zenc run <file> a b c` — everything after the source path is forwarded to the program's argv
// (arg(3)..; the program reads it back via std.sys.os.arg(i)/argc(), argv[0] being the temp binary).
run_command = (mp: MutPtr<Malloc>, bin: string_view) string_view { mp.gstr_string(128).gstr_append(mp, bin).append_run_args(mp, 3, argc()).gstr_finish(mp) }
run_spec = (mp: MutPtr<Malloc>, root: string_view, spec: Spec) i32 {
    spec.ok.match ({
        true  => {
            spec.library.then({
                derr("zenc: cannot run a library project; use `zenc check <project>`\n")
                return 1
            })
            ffi_grants_set(spec.ffi)    // manifest/registry FFI grants: stamped before probe AND resolve
            genmods_set(spec.genmods)    // registered c_library genmods: same stamp discipline
            contents_in(mp, spec.source).match ({
                .Ok(src) => {
                    bin := mp.TMPBIN()
                    (mp.compile_to(root, spec.source, src, bin, spec.ccflags, spec.links, spec.target) == 0).match ({
                        true  => mp.run_command(bin).system() / 256,
                        false => 1,
                    })
                },
                .Err(e)  => {
                    derr("zenc: cannot open input: ")
                    derr(spec.source)
                    derr("\n")
                    1
                },
            })
        },
        false => 1,
    })
}
// the project ROOT (holds src/std + src/compiler + bootstrap): $ZEN_ROOT if set (a relocated binary
// points it at a checkout), else the directory of the binary (argv[0]).
root_of = (mp: MutPtr<Malloc>) string_view {
    e := getEnv("ZEN_ROOT")
    eq(e, "").match ({ true => mp.dirname(arg(0)), false => e })
}
HELP = () string_view { "usage: zenc <run|build|check|emit|doc|fmt|init|lsp|targets|--build-self|--version|--help> <file>\n  zenc init [path] [--bin|--lib]\n  zenc build <project>                 build its registered default targets\n  zenc build --target <name> <project> build one registered target\n  zenc targets <project>               list registered targets\n  zenc doc <std.mod|file.zen>\n  zenc lsp                             diagnostics-only Language Server (JSON-RPC over stdio)\n  cat file.zen | zenc   (source -> C filter)\n" }
VERSION = () string_view { "zenc 0.2.0-dev (self-hosted; zen driver)" }    // also folded into every cache key
main = () i32 {
    m := Malloc(_: 0)
    mp := m.addr()
    root := mp.root_of()
    cmd := arg(1)
    eq(cmd, "--help").match ({
        true  => {
            say(HELP())
            0
        },
        false => eq(cmd, "--version").match ({
            true  => {
                say(VERSION())
                0
            },
            false => eq(cmd, "--build-self").match ({
                true  => eq(arg(2), "").match ({
                    true  => {
                        derr("usage: zenc --build-self <out.c> <srcroot>\n")
                        2
                    },
                    false => mp.build_self(arg(3), arg(2)),
                }),
                false => eq(cmd, "emit").match ({
                    true  => mp.emit_file(root, arg(2), arg(3)),
                    false => eq(cmd, "emit-js").match ({
                        true  => mp.emit_js(root, arg(2)),
                        false => eq(cmd, "check").match ({
                            true  => mp.check_spec(root, mp.resolve_spec(root, arg(2))),
                            false => eq(cmd, "run").match ({
                                true  => mp.run_spec(root, mp.resolve_spec(root, arg(2))),
                                false => eq(cmd, "build").match ({
                                    true  => mp.build_target(root),
                                    false => eq(cmd, "targets").match ({
                                        true  => mp.list_plan_targets(root, arg(2)),
                                        false => eq(cmd, "fmt").match ({
                                            true  => mp.fmt_cmd(arg(2), arg(3)),
                                            false => eq(cmd, "doc").match ({
                                                true  => mp.doc_cmd(root, arg(2)),
                                                false => eq(cmd, "init").match ({
                                                    true  => mp.zi_cmd(),
                                                    false => eq(cmd, "lsp").match ({
                                                        true  => mp.lsp_cmd(root),
                                                        false => mp.default_emit(cmd),
                                                    }),
                                                }),
                                            }),
                                        }),
                                    }),
                                }),
                            }),
                        }),
                    }),
                }),
            }),
        }),
    })
}    // --build-self <out.c> <srcroot>
build_out = (flag: string_view, out: string_view) string_view { eq(flag, "-o").match ({
    true  => out,
    false => "a.out",
}) }    // `zenc <file>` (or stdin) -> raw C on stdout, the harness filter
// build output path: `build <file> -o <out>` -> <out>, else "a.out".
// the DEFAULT mode (no subcommand): `zenc <file>` or `cat … | zenc` -> emit C to stdout, RAW
// (resolve_module only, NO import flatten — std imports stay as-is; the harness depends on this).
// No subcommand and no file: bare `zenc`. An interactive terminal (isatty(0)) gets the help text
// rather than silently blocking on a stdin read; a pipe (`cat file.zen | zenc`) still filters to C.
default_emit = (mp: MutPtr<Malloc>, path: string_view) i32 {
    eq(path, "").match ({
        true  => (isatty(0) != 0).match ({
            true  => {
                say(HELP())
                0
            },
            false => mp.stdin_emit(mp.read_stdin()),
        }),
        false => mp.raw_emit_file(path),
    })
}
// piped stdin has no directory, so a sibling import `{ f } = b` can't resolve — error cleanly instead
// of emitting C that references undefined names (std imports stay raw, which the harness relies on).
stdin_emit = (mp: MutPtr<Malloc>, src: string_view) i32 {
    sib := mp.first_user_import_in(src)
    eq(sib, "").match ({
        true  => mp.raw_emit_src("<stdin>", src),
        false => {
            derr(mp.gstr_string(256).gstr_append(mp, "zenc: <stdin>: error: sibling import '").gstr_append(mp, sib).gstr_append(mp, "' needs a source file on disk (stdin has no directory); use `zenc build <file.zen>`\n").gstr_finish(mp))
            1
        },
    })
}
raw_emit_file = (mp: MutPtr<Malloc>, path: string_view) i32 {
    contents_in(mp, path).match ({
        .Ok(src) => mp.raw_emit_src(path, src),
        .Err(e)  => {
            derr("zenc: cannot open input\n")
            1
        },
    })
}
raw_emit_src = (mp: MutPtr<Malloc>, path: string_view, src: string_view) i32 {
    (mp.report_no_if_plain(path, src) == 0).match ({
        true  => {
            out_bytes(mp.genModuleIn(mp.resolve_module(mp.parse_module(src))).bytes())
            0
        },
        false => 1,
    })
}
// read all of fd 0 (stdin/pipe — no seekable size) into one buffer.
STDIN_CAP := 8388608
read_stdin = (mp: MutPtr<Malloc>) string_view {
    buf := mp.acquire(STDIN_CAP)
    n := read_fd_all(0, buf, 0, STDIN_CAP)
    buf.offset(n).store(0)
    cstr(buf)
}
read_fd_all = (fd: i32, buf: RawPtr<u8>, off: i64, cap: i64) i64 {
    r := fd.read(buf.offset(off), cap - off)
    (r <= 0).match ({
        true  => off,
        false => (off + r >= cap).match ({
            true  => cap,
            false => read_fd_all(fd, buf, off + r, cap),
        }),
    })
}
// ── --build-self: regenerate the seed (ported from bootstrap/driver.c build_self) ─────────────────
BS_HEAD = () string_view { "typedef struct { void* ptr; int64_t len; } zslice; " }
BS_HEAD_REPL = () string_view { "#define ZEN_NO_MALLOC 1\n#include \"zenrt.h\"\n" }
bs_is_space = (b: u8) bool {
    (b == ' ').match ({
        true  => true,
        false => (b == '\t').match ({
            true  => true,
            false => (b == '\n').match ({
                true  => true,
                false => (b == '\r').match ({
                    true  => true,
                    false => (b == 11).match ({ true => true, false => b == 12 }),
                }),
            }),
        }),
    })
}
bs_skip_space = (v: [u8], i: i64, e: i64) i64 {
    (i >= e).match ({
        true  => e,
        false => bs_is_space(v[i]).match ({ true => v.bs_skip_space(i + 1, e), false => i }),
    })
}
bs_trim_end = (v: [u8], s: i64, e: i64) i64 {
    (e <= s).match ({
        true  => s,
        false => bs_is_space(v[e - 1]).match ({ true => v.bs_trim_end(s, e - 1), false => e }),
    })
}
bs_line_end = (v: [u8], p0: i64, n: i64) i64 {
    p := p0
    @while (p < n && v[p] != '\n') {
        p = p + 1
    }    // iterative: a long line must not recurse per char
    p
}
bs_eq_run = (v: [u8], at: i64, nv: [u8], i: i64) bool {
    (i >= nv.len).match ({
        true  => true,
        false => (v[at + i] == nv[i]).match ({ true => v.bs_eq_run(at, nv, i + 1), false => false }),
    })
}
bs_match_at = (v: [u8], at: i64, e: i64, needle: string_view) bool {
    nv := needle.view()
    (at + nv.len > e).match ({ true => false, false => v.bs_eq_run(at, nv, 0) })
}
bs_has_needle = (v: [u8], p: i64, e: i64) bool {
    (p >= e).match ({
        true  => false,
        false => v.bs_match_at(p, e, "= std.").match ({
            true  => true,
            false => v.bs_match_at(p, e, "= compiler.").match ({
                true  => true,
                false => v.bs_has_needle(p + 1, e),
            }),
        }),
    })
}
// `{` opening an import, tolerating a binding name directly after it (`{println}`) as well as `{ p`.
bs_brace_open = (b: u8) bool { b == ' ' || b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z' || b == '_' }
bs_is_import = (v: [u8], p: i64, e: i64) bool {
    s := v.bs_skip_space(p, e)
    (s + 1 < e).match ({
        true  => (v[s] == '{').match ({
            true  => v[s + 1].bs_brace_open().match ({
                true  => v.bs_has_needle(p, e),
                false => false,
            }),
            false => false,
        }),
        false => false,
    })
}
bs_push_range = (mp: MutPtr<Malloc>, out: String, v: [u8], p: i64, e: i64) String { (p >= e).match ({
    true  => out,
    false => mp.bs_push_range(out.gstr_push(mp, v[p]), v, p + 1, e),
}) }
bs_strip_file = (mp: MutPtr<Malloc>, out: String, v: [u8], p: i64, n: i64, first: bool) String {
    (p >= n).match ({
        true  => out,
        false => {
            e := v.bs_line_end(p, n)
            drop := v.bs_is_import(p, e)
            o2 := drop.match ({
                true  => out,
                false => {
                    sep := first.match ({ true => out, false => out.gstr_push(mp, '\n') })
                    mp.bs_push_range(sep, v, p, e)
                },
            })
            nf := drop.match ({ true => first, false => false })
            (e >= n).match ({ true => o2, false => mp.bs_strip_file(o2, v, e + 1, n, nf) })
        },
    })
}
bs_join = (mp: MutPtr<Malloc>, root: string_view, rel: string_view) string_view { mp.gstr_string(256).gstr_append(mp, root).gstr_append(mp, "/").gstr_append(mp, rel).gstr_finish(mp) }
bs_rel = (mp: MutPtr<Malloc>, mv: [u8], s: i64, t: i64) string_view { mp.bs_push_range(mp.gstr_string(256), mv, s, t).gstr_finish(mp) }
bs_add_source = (mp: MutPtr<Malloc>, out: String, root: string_view, rel: string_view) String {
    path := mp.bs_join(root, rel)
    contents_in(mp, path).match ({
        .Ok(src) => {
            sv := src.view()
            mp.bs_strip_file(out, sv, 0, sv.len, true)
        },
        .Err(e)  => {
            derr("zenc: --build-self: cannot open a source file\n")
            out
        },
    })
}
bs_walk_manifest = (mp: MutPtr<Malloc>, out: String, root: string_view, mv: [u8], p: i64, n: i64, count: i64) String {
    (p >= n).match ({
        true  => out,
        false => {
            e := mv.bs_line_end(p, n)
            s := mv.bs_skip_space(p, e)
            t := mv.bs_trim_end(s, e)
            keep := (s < t).match ({ true => mv[s] != '#', false => false })
            o2 := keep.match ({
                true  => {
                    sep := (count > 0).match ({ true => out.gstr_push(mp, '\n'), false => out })
                    rel := mp.bs_rel(mv, s, t)
                    mp.bs_add_source(sep, root, rel)
                },
                false => out,
            })
            nc := keep.match ({ true => count + 1, false => count })
            (e >= n).match ({
                true  => o2,
                false => mp.bs_walk_manifest(o2, root, mv, e + 1, n, nc),
            })
        },
    })
}
bs_gen_end = (gv: [u8], n: i64) i64 {
    (n <= 0).match ({
        true  => 0,
        false => bs_is_space(gv[n - 1]).match ({ true => gv.bs_gen_end(n - 1), false => n }),
    })
}
bs_write = (out_path: string_view, gen: String) bool {
    hl := BS_HEAD().view().len
    end := gen.bytes().bs_gen_end(gen.len)
    fd := out_path.open(O_WRTRUNC, MODE_644)
    (fd < 0).match ({
        true  => false,
        false => {
            hv := BS_HEAD_REPL().view()
            fd.write(hv.ptr, hv.len)
            fd.write(gen.ptr.offset(hl), end - hl)
            fd.close()
            true
        },
    })
}
// emit the seed from the manifest concatenation `flat` (kept byte-exact), but ONLY after the compiler's
// own source has passed its strict validator. The manifest flat itself is NOT directly checkable — it
// deliberately omits the std modules whose symbols zenrt.c provides at the C level (`view`, `String`, …),
// so as a raw concatenation it references hundreds of "undefined" runtime names. So validation runs on
// the IMPORT-RESOLVED `driver.zen` entry (the same path `zenc check driver.zen` uses): that pulls in
// those std modules so the names ARE declared, dedups, and runs the full checker over the real program.
bs_emit_checked = (mp: MutPtr<Malloc>, root: string_view, out_path: string_view, flat: string_view, entry: string_view, esrc: string_view) i32 {
    rp := mp.resolve_prog(root, entry, esrc)
    (mp.report_no_if_resolved(rp, entry, esrc) == 0).match ({
        true  => {
            raw := mp.parse_module(rp.flat)
            decls := mp.resolve_module(raw)
            (mp.report_check(raw, decls, rp, entry, esrc) == 0).match ({
                true  => {
                    gen := mp.genModuleIn(mp.resolve_module(mp.parse_module(flat)))    // type error in compiler source — fail, don't regenerate a miscompiled seed
                    gen.bytes().bs_eq_run(0, BS_HEAD().view(), 0).match ({
                        true  => bs_write(out_path, gen).match ({ true => 0, false => 1 }),
                        false => {
                            derr("zenc: --build-self: emitted C did not start with the expected head\n")
                            1
                        },
                    })
                },
                false => 1,
            })
        },
        false => 1,
    })
}
build_self = (mp: MutPtr<Malloc>, root: string_view, out_path: string_view) i32 {
    mpath := mp.bs_join(root, "bootstrap/sources.txt")
    contents_in(mp, mpath).match ({
        .Ok(man) => {
            mv := man.view()
            flat := mp.bs_walk_manifest(mp.gstr_string(256), root, mv, 0, mv.len, 0).gstr_finish(mp)
            entry := mp.bs_join(root, "driver.zen")
            contents_in(mp, entry).match ({
                .Ok(esrc) => mp.bs_emit_checked(root, out_path, flat, entry, esrc),
                .Err(e)   => {
                    derr("zenc: --build-self: cannot open driver.zen for validation\n")
                    1
                },
            })
        },
        .Err(e)  => {
            derr("zenc: --build-self: cannot open bootstrap/sources.txt\n")
            1
        },
    })
}
// ── doc: a module's public decls + their leading doc comments (ported from driver.c doc_source) ───
ends_zen = (s: string_view) bool {
    v: [u8] := s.view()
    v.len >= 4 && v[v.len - 4] == '.' && v[v.len - 3] == 'z' && v[v.len - 2] == 'e' && v[v.len - 1] == 'n'
}
is_name_start = (b: u8) bool { b >= 'A' && b <= 'Z' || b >= 'a' && b <= 'z' || b == '_' }
push_mod = (mp: MutPtr<Malloc>, s: String, v: [u8], i: i64) String {
    (i >= v.len).match ({
        true  => s,
        false => mp.push_mod(s.gstr_push(mp, (v[i] == '.').match ({ true => '/', false => v[i] })), v, i + 1),
    })
}
mod_path = (mp: MutPtr<Malloc>, root: string_view, mod: string_view) string_view {
    ends_zen(mod).match ({
        true  => mod,
        false => {
            rel := mp.push_mod(mp.gstr_string(128).gstr_append(mp, "src/"), mod.view(), 0).gstr_append(mp, ".zen").gstr_finish(mp)
            mp.gstr_string(256).gstr_append(mp, root).gstr_append(mp, "/").gstr_append(mp, rel).gstr_finish(mp)
        },
    })
}
doc_has_star = (v: [u8], i: i64, t: i64) bool {
    (i >= t).match ({
        true  => false,
        false => (v[i] == '*').match ({
            true  => true,
            false => (v[i] == '=' || v[i] == ':').match ({
                true  => false,
                false => v.doc_has_star(i + 1, t),
            }),
        }),
    })
}
doc_is_pub = (v: [u8], p: i64, t: i64) bool { (p >= t).match ({
    true  => false,
    false => is_name_start(v[p]) && v.doc_has_star(p, t),
}) }
out_range = (v: [u8], p: i64, t: i64) i64 { out_bytes(slice(v.ptr.offset(p), t - p)).or(0) }
doc_line = (mp: MutPtr<Malloc>, v: [u8], p: i64, t: i64, docs: String) String {
    (t - p >= 2 && v[p] == '/' && v[p + 1] == '/').match ({
        true  => {
            s := (p + 2 < t && v[p + 2] == ' ').match ({ true => p + 3, false => p + 2 })
            dl := mp.bs_push_range(docs, v, s, t)
            dl.gstr_push(mp, '\n')
        },
        false => (p >= t).match ({
            true  => mp.gstr_string(256),
            false => doc_is_pub(v, p, t).match ({
                true  => {
                    out_bytes(docs.bytes())
                    v.out_range(p, t)
                    out("\n")
                    mp.gstr_string(256)
                },
                false => mp.gstr_string(256),
            }),
        }),
    })
}
doc_lines = (mp: MutPtr<Malloc>, v: [u8], p: i64, docs: String) i64 {
    (p >= v.len).match ({
        true  => 0,
        false => {
            e := v.bs_line_end(p, v.len)
            t := v.bs_trim_end(p, e)
            d2 := mp.doc_line(v, p, t, docs)
            mp.doc_lines(v, (e >= v.len).match ({ true => v.len, false => e + 1 }), d2)
        },
    })
}
doc_cmd = (mp: MutPtr<Malloc>, root: string_view, modarg: string_view) i32 {
    eq(modarg, "").match ({
        true  => {
            derr("usage: zenc doc <std.mod|file.zen>\n")
            2
        },
        false => contents_in(mp, mp.mod_path(root, modarg)).match ({
            .Ok(src) => {
                out("# ")
                out(modarg)
                out("\n")
                mp.doc_lines(src.view(), 0, mp.gstr_string(256))
                0
            },
            .Err(e)  => {
                derr("zenc: doc: cannot open module\n")
                1
            },
        }),
    })
}
// ── THE formatter: the AST pretty-printer (compiler.pretty) with source comments woven back in. ──────
// (The old line-reindenter — fmt_source/fmt_lines/fmt_scan/fmt_indent — has been RETIRED: it only
//  reindented + trimmed, never reflowed multi-arm matches, and overflowed the stack on big files. The
//  AST pretty-printer below is now the single formatter behind `zenc fmt`.)
// Parse the file FAITHFULLY (parse_module keeps MethodCall — UFCS preserved `s.len()`, not flat `len(s)`),
// collect its comments into a positioned sidecar table, then pretty-print: 4-space indent, multi-arm
// `.match` split one arm per line with `=>` aligned + trailing comma, multi-field struct literals one
// field per line, short single-arm/single-expr bodies inline, and every comment kept in place. Comments
// stay OUT of the AST, so the formatted source resolves to byte-identical C (formatting is a no-op on the
// lowered tree). This is the engine behind BOTH `zenc fmt` (in-place / --check) and `fmt --stdout`.
//
// fmt parses the RAW (pre-flatten) source — module-alias lines and qualified types the post-flatten
// pipeline never feeds parse_module. Qualified types `ns.Type` now parse; a residual construct the
// faithful parser still can't represent plants a parse error, and a faithful printer must REFUSE a file
// it cannot round-trip rather than silently rewrite it — so on any parse/lex error we fail cleanly.
FmtResult*: {
    text: string_view,
    len: i64,
    ok: bool,
}    // ok=false => parse/lex error, text/len unused
fmt_render = (mp: MutPtr<Malloc>, src: string_view) FmtResult {
    set_faithful_lexeme(true)    // keep C-keyword identifiers RAW (float, if, …) for round-trip
    decls := mp.parse_module(src)    // faithful AST (keeps MethodCall)
    set_faithful_lexeme(false)
    (perr_get() || lerr_get()).match ({
        true  => FmtResult(
            text: "",
            len: 0,
            ok: false,
        ),
        false => {
            exps := exports_get()
            pretty_set_comments(src, mp.collect_comments(src))
            o := mp.pretty_module_in(decls, exps)
            FmtResult(
                text: o.gstr_finish(mp),
                len: o.len,
                ok: true,
            )
        },
    })
}
fmt_parse_err = (mp: MutPtr<Malloc>) i32 {
    derr("zenc: fmt: cannot format (syntax error — a faithful formatter refuses a file it cannot represent)\n")
    1
}
// THE single source of truth for "would apply rewrite this file?" — a file is dirty iff the formatted
// text differs from the source byte-for-byte. BOTH the `--check` and apply branches of `fmt_file` gate
// on this, so `fmt --check X` reports dirty iff `fmt X` would rewrite X — the two can never drift apart.
// The two length gates kill the strcmp/NUL blind spot: `src` is the file bytes (NUL-free) and `r.len` is
// the formatter's true byte count, so `strlen(src) != r.len` OR `strlen(r.text) != r.len` (an embedded
// NUL shortening the C string) both flag dirty; once all three lengths agree the content is NUL-free and
// equal-length, so `eq` (strcmp) then compares every one of the r.len bytes — a full byte-for-byte match.
fmt_dirty = (src: string_view, r: FmtResult) bool {
    sv := src.view()
    rv := r.text.view()
    (sv.len != r.len).match ({
        true  => true,
        false => (rv.len != r.len).match ({
            true  => true,
            false => eq(src, r.text).match ({ true => false, false => true }),
        }),
    })
}
// `zenc fmt [--check] <file>`: format IN PLACE (or, with --check, exit 1 when the file is not already
// formatted, writing nothing). Idempotent — formatting an already-formatted file is a no-op.
fmt_file = (mp: MutPtr<Malloc>, path: string_view, check: bool) i32 {
    contents_in(mp, path).match ({
        .Ok(src) => {
            (mp.report_no_if_plain(path, src) == 0).match ({
                true  => {
                    r := mp.fmt_render(src)
                    r.ok.match ({
                        true  => fmt_dirty(src, r).match ({
                            true  => check.match ({
                                true  => {
                                    derr("zenc: ")
                                    derr(path)
                                    derr(": needs formatting\n")
                                    1
                                },
                                false => save(path, r.text, r.len).match ({
                                    .Ok(n)  => 0,
                                    .Err(e) => 1,
                                }),
                            }),
                            false => 0,
                        }),
                        false => mp.fmt_parse_err(),
                    })
                },
                false => 1,
            })
        },
        .Err(e)  => {
            derr("zenc: fmt: cannot open input\n")
            1
        },
    })
}
// `zenc fmt --stdout <file>` (alias: --ast, kept for back-compat): write the formatted text to stdout.
fmt_stdout = (mp: MutPtr<Malloc>, path: string_view) i32 {
    contents_in(mp, path).match ({
        .Ok(src) => {
            (mp.report_no_if_plain(path, src) == 0).match ({
                true  => {
                    r := mp.fmt_render(src)
                    r.ok.match ({
                        true  => {
                            out(r.text)
                            0
                        },
                        false => mp.fmt_parse_err(),
                    })
                },
                false => 1,
            })
        },
        .Err(e)  => {
            derr("zenc: fmt: cannot open input\n")
            1
        },
    })
}
fmt_cmd = (mp: MutPtr<Malloc>, a2: string_view, a3: string_view) i32 {
    (eq(a2, "--ast") || eq(a2, "--stdout")).match ({
        true  => eq(a3, "").match ({
            true  => {
                derr("usage: zenc fmt --stdout <in.zen>\n")
                2
            },
            false => mp.fmt_stdout(a3),
        }),
        false => eq(a2, "--check").match ({
            true  => eq(a3, "").match ({
                true  => {
                    derr("usage: zenc fmt [--check] <in.zen>\n")
                    2
                },
                false => mp.fmt_file(a3, true),
            }),
            false => eq(a2, "").match ({
                true  => {
                    derr("usage: zenc fmt [--check] <in.zen>\n")
                    2
                },
                false => mp.fmt_file(a2, false),
            }),
        }),
    })
}
// ── project bootstrap: `zenc init [path] [--bin|--lib]` ──────────────────────────────────
// The templates live in this driver, so a relocated standalone zenc does not need a templates
// directory beside it. Fully flagged invocations never touch stdin; missing values are prompted.
ZI_USAGE = () string_view { "usage: zenc init [path] [--bin|--lib]\n       zenc init --help\n" }
ZiInitArgs: {
    path: string_view,
    kind: i32,
    ok: bool,
    help: bool,
}
ZI_KIND_PROMPT := 0
ZI_KIND_EXECUTABLE := 1
ZI_KIND_LIBRARY := 2
zi_pick_kind = (have: i32, want: i32) i32 { (have == ZI_KIND_PROMPT || have == want).match ({
    true  => want,
    false => 0 - 1,
}) }
zi_init_args = (path: string_view, kind: i32, ok: bool, help: bool) ZiInitArgs {
    ZiInitArgs(
        path: path,
        kind: kind,
        ok: ok,
        help: help,
    )
}
zi_scan_args = (i: i32, n: i32, path: string_view, kind: i32, valid: bool) ZiInitArgs {
    (i >= n).then({
        return zi_init_args(path, kind, valid, false)
    })
    a := arg(i)
    eq(a, "--help").then({
        return zi_init_args(path, kind, true, true)
    })
    (eq(a, "--bin") || eq(a, "--exe")).then({
        next := zi_pick_kind(kind, ZI_KIND_EXECUTABLE)
        return zi_scan_args(i + 1, n, path, next, valid && next > 0)
    })
    eq(a, "--lib").then({
        next := zi_pick_kind(kind, ZI_KIND_LIBRARY)
        return zi_scan_args(i + 1, n, path, next, valid && next > 0)
    })
    v: [u8] := a.view()
    (v.len > 0 && v[0] == '-').match ({
        true  => zi_init_args(path, kind, false, false),
        false => eq(path, "").match ({
            true  => zi_scan_args(i + 1, n, a, kind, valid),
            false => zi_init_args(path, kind, false, false),
        }),
    })
}
// One prompt line, without consuming the next prompt's input (read_stdin intentionally reads to EOF).
zi_read_line = (mp: MutPtr<Malloc>, prompt: string_view) string_view {
    derr(prompt)
    s := mp.gstr_string(64)
    cell: [u8] := [0]
    done := false
    @while (done == false) {
        n := read(0, cell.ptr, 1)
        done = n <= 0 || cell[0] == '\n'
        s = (n > 0 && cell[0] != '\n' && cell[0] != '\r').match ({
            true  => s.gstr_push(mp, cell[0]),
            false => s,
        })
    }
    s.gstr_finish(mp)
}
zi_kind_choice = (s: string_view) i32 {
    (eq(s, "") || eq(s, "1") || eq(s, "bin") || eq(s, "exe") || eq(s, "executable")).match ({
        true  => ZI_KIND_EXECUTABLE,
        false => (eq(s, "2") || eq(s, "lib") || eq(s, "library")).match ({
            true  => ZI_KIND_LIBRARY,
            false => 0 - 1,
        }),
    })
}
zi_prompt_kind = (mp: MutPtr<Malloc>) i32 {
    derr("Project type:\n  1) Executable\n  2) Library\n")
    zi_kind_choice(mp.zi_read_line("Select [1]: "))
}
// Names are embedded in TOML, a string literal, and the executable output path. Keep them portable
// and injection-free until the compiler's own cc command quotes arbitrary project paths.
zi_ascii_alnum = (b: u8) bool { b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z' || b >= '0' && b <= '9' }
zi_name_tail = (v: [u8], i: i64) bool {
    (i >= v.len).match ({
        true  => true,
        false => (zi_ascii_alnum(v[i]) || v[i] == '_' || v[i] == '-').match ({
            true  => v.zi_name_tail(i + 1),
            false => false,
        }),
    })
}
zi_name_valid = (s: string_view) bool {
    v: [u8] := s.view()
    v.len > 0 && zi_ascii_alnum(v[0]) && v.zi_name_tail(1)
}
zi_path_char = (b: u8) bool { zi_ascii_alnum(b) || b == '_' || b == '-' || b == '.' || b == '/' }
zi_dot_segment = (v: [u8], start: i64, end: i64) bool {
    n := end - start
    n == 1 && v[start] == '.' || n == 2 && v[start] == '.' && v[start + 1] == '.'
}
zi_path_valid_at = (v: [u8], i: i64, start: i64) bool {
    (i >= v.len).match ({
        true  => v.zi_dot_segment(start, i) == false,
        false => (zi_path_char(v[i]) && (v[i] != '/' || i == 0 || v[i - 1] != '/')).match ({
            true  => (v[i] == '/').match ({
                true  => (v.zi_dot_segment(start, i) == false).match ({
                    true  => v.zi_path_valid_at(i + 1, i + 1),
                    false => false,
                }),
                false => v.zi_path_valid_at(i + 1, start),
            }),
            false => false,
        }),
    })
}
zi_path_valid = (s: string_view) bool { s.view().zi_path_valid_at(0, 0) }
zi_trim_end = (v: [u8], n: i64) i64 { (n > 0 && v[n - 1] == '/').match ({
    true  => v.zi_trim_end(n - 1),
    false => n,
}) }
zi_normal_path = (mp: MutPtr<Malloc>, raw: string_view) string_view {
    v: [u8] := raw.view()
    n := v.zi_trim_end(v.len)
    (n == v.len).match ({ true => raw, false => mp.cstr_substr(raw, 0, to_i32(n)) })
}
zi_project_name = (mp: MutPtr<Malloc>, path: string_view) string_view {
    v: [u8] := path.view()
    slash := last_slash(v, 0, 0 - 1)
    start := slash + 1
    mp.cstr_substr(path, to_i32(start), to_i32(v.len - start))
}
zi_is_dir = (path: string_view) bool {
    d := opendir(path)
    (d == null_ptr()).match ({
        true  => false,
        false => {
            closedir(d)
            true
        },
    })
}
ZI_OPEN_NEW := O_WRONLY | O_CREAT | O_EXCL
ZiDirCreate: {
    ok: bool,
    created: bool,
}
// mkdir may lose a race after the existence probe. A directory now present is usable, but `created`
// stays false so rollback never removes something another process owns.
zi_ensure_dir = (path: string_view) ZiDirCreate {
    file_exists(path).match ({
        true  => ZiDirCreate(
            ok: zi_is_dir(path),
            created: false,
        ),
        false => (mkdir(path, MODE_755) == 0).match ({
            true  => ZiDirCreate(
                ok: true,
                created: true,
            ),
            false => ZiDirCreate(
                ok: zi_is_dir(path),
                created: false,
            ),
        }),
    })
}
zi_make_tree = (mp: MutPtr<Malloc>, path: string_view) ZiDirCreate {
    v: [u8] := path.view()
    i: i64 := 1
    ok := true
    @while (i < v.len && ok) {
        (v[i] == '/').then({
            prefix := mp.cstr_substr(path, 0, to_i32(i))
            ok = zi_ensure_dir(prefix).ok
        })
        i = i + 1
    }
    ok.match ({
        true  => zi_ensure_dir(path),
        false => ZiDirCreate(
            ok: false,
            created: false,
        ),
    })
}
zi_write_all = (fd: i32, p: RawPtr<u8>, n: i64) bool {
    (n <= 0).match ({
        true  => true,
        false => {
            wrote := write(fd, p, n)
            (wrote <= 0).match ({
                true  => false,
                false => zi_write_all(fd, p.offset(wrote), n - wrote),
            })
        },
    })
}
// Exclusive creation is the no-clobber guarantee even if another process races the preflight.
zi_save_new = (path: string_view, data: string_view) bool {
    fd := open(path, ZI_OPEN_NEW, MODE_644)
    (fd < 0).match ({
        true  => false,
        false => {
            v: [u8] := data.view()
            wrote := zi_write_all(fd, v.ptr, v.len)
            shut := close(fd) == 0
            (wrote && shut).match ({
                true  => true,
                false => {
                    unlink(path)
                    false
                },
            })
        },
    })
}
zi_manifest = (mp: MutPtr<Malloc>, name: string_view, kind: i32) string_view {
    s := mp.gstr_string(160).gstr_append(mp, "package = \"").gstr_append(mp, name)
    (kind == ZI_KIND_LIBRARY).match ({
        true  => s.gstr_append(mp, "\"\nkind = \"library\"\nroot = \"src\"\nmain = \"lib.zen\"\n").gstr_finish(mp),
        false => s.gstr_append(mp, "\"\nkind = \"executable\"\nroot = \"src\"\nmain = \"main.zen\"\nout = \"").gstr_append(mp, name).gstr_append(mp, "\"\n").gstr_finish(mp),
    })
}
zi_source = (mp: MutPtr<Malloc>, name: string_view, kind: i32) string_view {
    (kind == ZI_KIND_LIBRARY).match ({
        true  => "answer* = () i32 { 42 }\n",
        false => mp.gstr_string(128).gstr_append(mp, "{ println } = std.text.fmt\nmain = () i32 {\n    println(\"Hello from ").gstr_append(mp, name).gstr_append(mp, "!\")\n    0\n}\n").gstr_finish(mp),
    })
}
zi_collision = (path: string_view) i32 {
    derr("zenc init: ")
    derr(path)
    derr(" already exists; nothing was changed\n")
    1
}
zi_remove_dir = (path: string_view) void { removed := rmdir(path) }
zi_cleanup_dirs = (srcdir: string_view, target: string_view, made_src: bool, made_target: bool) void {
    made_src.then(() { zi_remove_dir(srcdir) })
    made_target.then(() { zi_remove_dir(target) })
}
zi_create = (mp: MutPtr<Malloc>, target: string_view, name: string_view, kind: i32) i32 {
    manifest := mp.join2(target, "zen.toml")
    buildfile := mp.join2(target, "build.zen")
    srcdir := mp.join2(target, "src")
    entry := (kind == ZI_KIND_LIBRARY).match ({ true => "lib.zen", false => "main.zen" })
    source := mp.join2(srcdir, entry)
    target_exists := file_exists(target)
    (target_exists && zi_is_dir(target) == false).then({
        derr("zenc init: target exists and is not a directory: ")
        derr(target)
        derr("\n")
        return 1
    })
    file_exists(buildfile).then({
        return zi_collision(buildfile)
    })
    file_exists(manifest).then({
        return zi_collision(manifest)
    })
    (file_exists(srcdir) && zi_is_dir(srcdir) == false).then({
        return zi_collision(srcdir)
    })
    file_exists(source).then({
        return zi_collision(source)
    })
    target_dir := mp.zi_make_tree(target)
    (target_dir.ok == false).then({
        derr("zenc init: could not create project directory: ")
        derr(target)
        derr("\n")
        return 1
    })
    src_dir := zi_ensure_dir(srcdir)
    (src_dir.ok == false).then({
        derr("zenc init: could not create source directory: ")
        derr(srcdir)
        derr("\n")
        zi_cleanup_dirs(srcdir, target, false, target_dir.created)
        return 1
    })
    (zi_save_new(source, mp.zi_source(name, kind)) == false).then({
        derr("zenc init: could not create source file: ")
        derr(source)
        derr("\n")
        zi_cleanup_dirs(srcdir, target, src_dir.created, target_dir.created)
        return 1
    })
    (zi_save_new(manifest, mp.zi_manifest(name, kind)) == false).then({
        unlink(source)
        derr("zenc init: could not create manifest: ")
        derr(manifest)
        derr("\n")
        zi_cleanup_dirs(srcdir, target, src_dir.created, target_dir.created)
        return 1
    })
    derr("Created ")
    derr((kind == ZI_KIND_LIBRARY).match ({ true => "library", false => "executable" }))
    derr(" project `")
    derr(name)
    derr("` at ")
    derr(target)
    derr("\n")
    derr((kind == ZI_KIND_LIBRARY).match ({
        true  => "Check it with: zenc check ",
        false => "Run it with: zenc run ",
    }))
    derr(target)
    derr("\n")
    0
}
zi_cmd = (mp: MutPtr<Malloc>) i32 {
    parsed := zi_scan_args(2, argc(), "", ZI_KIND_PROMPT, true)
    parsed.help.then({
        say(ZI_USAGE())
        return 0
    })
    (parsed.ok == false).then({
        derr(ZI_USAGE())
        return 2
    })
    rawpath := eq(parsed.path, "").match ({
        true  => mp.zi_read_line("Project name or path: "),
        false => parsed.path,
    })
    path := mp.zi_normal_path(rawpath)
    (eq(path, "") || zi_path_valid(path) == false).then({
        derr("zenc init: project path uses unsafe characters or a '.'/'..' component\n")
        return 2
    })
    name := mp.zi_project_name(path)
    (zi_name_valid(name) == false).then({
        derr("zenc init: project name must match [A-Za-z0-9][A-Za-z0-9_-]*\n")
        return 2
    })
    kind := (parsed.kind == ZI_KIND_PROMPT).match ({
        true  => mp.zi_prompt_kind(),
        false => parsed.kind,
    })
    (kind != ZI_KIND_EXECUTABLE && kind != ZI_KIND_LIBRARY).then({
        derr("zenc init: choose 1/executable or 2/library\n")
        return 2
    })
    mp.zi_create(path, name, kind)
}
// ── project mode: `zenc build|run|check <dir>` driven by <dir>/zen.toml ───────────────────────────
Spec*: {
    source: string_view,
    out: string_view,
    ccflags: string_view,
    links: string_view,
    ffi: string_view,
    genmods: string_view,
    target: string_view,
    library: bool,
    ok: bool,
}    // target: "" = native (host cc), else a cross triple like "aarch64-linux-gnu"
join2 = (mp: MutPtr<Malloc>, a: string_view, b: string_view) string_view { mp.gstr_string(256).gstr_append(mp, a).gstr_append(mp, "/").gstr_append(mp, b).gstr_finish(mp) }
link_flag = (mp: MutPtr<Malloc>, lk: string_view) string_view { mp.gstr_string(8).gstr_append(mp, "-l").gstr_append(mp, lk).gstr_finish(mp) }
// src[start .. start+n) as an owned str. (named cstr_* to avoid colliding with std.text.str's
// generic `substr` once the modules are flattened together — a plain `substr` would emit a second
// C `substr` definition.)
cstr_substr = (mp: MutPtr<Malloc>, s: string_view, start: i32, n: i32) string_view {
    v: [u8] := s.view()
    mp.bs_push_range(mp.gstr_string(n + 1), v, start, start + n).gstr_finish(mp)
}
// a zen.toml `key = "value"` -> the value (or "" if absent), via the Zen manifest parser.
manifest_value = (mp: MutPtr<Malloc>, src: string_view, key: string_view) string_view {
    sp := manifest_value_span(src, to_i32(src.view().len), key, 0)
    (sp.start < 0).match ({ true => "", false => mp.cstr_substr(src, sp.start, sp.len) })
}
// read <dir>/zen.toml -> a project Spec (ok=false if absent or missing root/main).
proj_spec = (mp: MutPtr<Malloc>, dir: string_view) Spec {
    contents_in(mp, mp.join2(dir, "zen.toml")).match ({
        .Ok(src) => {
            root := mp.manifest_value(src, "root")
            main := mp.manifest_value(src, "main")
            kind := mp.manifest_value(src, "kind")
            kind_ok := eq(kind, "") || eq(kind, "executable") || eq(kind, "library")
            (eq(root, "") || eq(main, "") || kind_ok == false).match ({
                true  => Spec(
                    source: "",
                    out: "",
                    ccflags: "",
                    links: "",
                    ffi: "",
                    genmods: "",
                    target: "",
                    library: false,
                    ok: false,
                ),
                false => {
                    out := mp.manifest_value(src, "out")
                    cc := mp.manifest_value(src, "ccflags")
                    lk := mp.manifest_value(src, "link")
                    fg := mp.manifest_value(src, "ffi")
                    Spec(
                        source: mp.join2(mp.join2(dir, root), main),
                        out: eq(out, "").match ({ true => "", false => mp.join2(dir, out) }),
                        ccflags: cc,
                        links: eq(lk, "").match ({ true => "", false => mp.link_flag(lk) }),
                        ffi: fg,
                        genmods: "",
                        target: "",
                        library: eq(kind, "library"),
                        ok: true,
                    )
                },
            })
        },
        .Err(e)  => Spec(
            source: "",
            out: "",
            ccflags: "",
            links: "",
            ffi: "",
            genmods: "",
            target: "",
            library: false,
            ok: false,
        ),
    })
}
// arg -> Spec: a directory with build.zen/zen.toml is a project; otherwise a single file (empty
// cc/links/out). A manifest that EXISTS but is malformed (missing root/main, won't compile) is a loud
// error (ok=false) — NOT a silent fall-through to treating the directory itself as a source file.
resolve_spec = (mp: MutPtr<Malloc>, root: string_view, arg: string_view) Spec {
    file_exists(mp.join2(arg, "build.zen")).match ({
        true  => mp.build_zen_spec(root, arg),
        false => file_exists(mp.join2(arg, "zen.toml")).match ({
            true  => {
                s := mp.proj_spec(arg)
                s.ok.match ({
                    true  => s,
                    false => {
                        derr("zenc: ")
                        derr(mp.join2(arg, "zen.toml"))
                        derr(": invalid manifest (need `root`/`main`; optional `kind` is executable or library)\n")
                        s
                    },
                })
            },
            false => Spec(
                source: arg,
                out: "",
                ccflags: "",
                links: "",
                ffi: "",
                genmods: "",
                target: "",
                library: false,
                ok: true,
            ),
        }),
    })
}    // a single .zen file
// ── build.zen mode: the build IS a Zen program. Append a main that prints its Target's spec, compile
// + run it (capturing stdout to a file), parse the 10-line records back (name/root/main/out/links/
// sources/os/arch/abi/ffi — see std.build's emit_target). Wins over zen.toml. ─────────────────────
BUILDBIN = (mp: MutPtr<Malloc>) string_view { mp.pid_path("/tmp/zenbuild_spec_", ".bin") }
SPECFILE = (mp: MutPtr<Malloc>) string_view { mp.pid_path("/tmp/zenbuild_spec_", ".txt") }
BUILD_TAIL = () string_view { "\nmain = () i32 { b := build_context()  build(b.addr())  b.emit_spec()  b.deinit()  0 }\n" }
// the [start,end) of line `idx` (0-based) in v; field idx of the emitted spec.
line_start = (v: [u8], idx: i32, p: i64) i64 {
    (idx <= 0).match ({
        true  => p,
        false => (p >= v.len).match ({
            true  => p,
            false => v.line_start(idx - 1, v.bs_line_end(p, v.len) + 1),
        }),
    })
}
spec_field = (mp: MutPtr<Malloc>, v: [u8], idx: i32) string_view {
    s := v.line_start(idx, 0)
    e := v.bs_line_end(s, v.len)
    mp.bs_push_range(mp.gstr_string(e - s + 1), v, s, e).gstr_finish(mp)
}
source_word_end = (v: [u8], i: i64) i64 { (i >= v.len || v[i] == ' ').match ({
    true  => i,
    false => v.source_word_end(i + 1),
}) }
source_words = (mp: MutPtr<Malloc>, dir: string_view, v: [u8], i: i64, out: String) String {
    (i >= v.len).match ({
        true  => out,
        false => (v[i] == ' ').match ({
            true  => mp.source_words(dir, v, i + 1, out),
            false => {
                e := v.source_word_end(i)
                prefixed := (v[i] == '/').match ({
                    true  => out,
                    false => out.gstr_append(mp, dir).gstr_append(mp, "/"),
                })
                next := mp.bs_push_range(prefixed, v, i, e).gstr_append(mp, " ")
                mp.source_words(dir, v, e, next)
            },
        }),
    })
}
source_flags = (mp: MutPtr<Malloc>, dir: string_view, src: string_view) string_view { mp.source_words(dir, src.view(), 0, mp.gstr_string(128)).gstr_finish(mp) }
// ── the plan's platform fields (lines 7-9 of each 10-line record: os/arch/abi as the integer
// codes std.build's build_os_code/build_arch_code/build_abi_code print). A record whose codes
// match the HOST (std.build defaults every Target to host()) — or a legacy short plan with the
// lines absent — is a NATIVE build: Spec.target stays "" and the cc path is untouched. Anything
// else is a cross target, canonicalized to the `<arch>-<os>-<abi>` GNU config triple
// (aarch64-linux-gnu, riscv64-linux-musl, …) that names the conventional cross gcc. ─────────────
spec_code = (s: string_view) i32 {
    v: [u8] := s.view()
    (v.len <= 0).match ({ true => 0 - 1, false => to_i32(v[0] - '0') })
}    // one plan code line -> its integer (codes are single digits); absent line -> -1
cross_os_code = (o: Os) i32 {
    o.match ({
        .MacOS   => 1,
        .Linux   => 2,
        .Windows => 3,
        .FreeBSD => 4,
        _        => 0,
    })
}    // mirrors std.build's build_os_code
cross_arch_code = (a: Arch) i32 {
    a.match ({
        .Arm64   => 1,
        .X86_64  => 2,
        .RiscV64 => 3,
        .Wasm32  => 4,
        _        => 0,
    })
}    // mirrors std.build's build_arch_code
cross_abi_code = (b: Abi) i32 {
    b.match ({
        .Darwin => 1,
        .Gnu    => 2,
        .Musl   => 3,
        .Msvc   => 4,
        .Wasi   => 5,
        _       => 0,
    })
}    // mirrors std.build's build_abi_code
cross_os_name = (n: i32) string_view {
    (n == 1).match ({
        true  => "macos",
        false => (n == 2).match ({
            true  => "linux",
            false => (n == 3).match ({
                true  => "windows",
                false => (n == 4).match ({ true => "freebsd", false => "unknown" }),
            }),
        }),
    })
}
cross_arch_name = (n: i32) string_view {
    (n == 1).match ({
        true  => "aarch64",
        false => (n == 2).match ({
            true  => "x86_64",
            false => (n == 3).match ({
                true  => "riscv64",
                false => (n == 4).match ({ true => "wasm32", false => "unknown" }),
            }),
        }),
    })
}
cross_abi_name = (n: i32) string_view {
    (n == 1).match ({
        true  => "darwin",
        false => (n == 2).match ({
            true  => "gnu",
            false => (n == 3).match ({
                true  => "musl",
                false => (n == 4).match ({
                    true  => "msvc",
                    false => (n == 5).match ({ true => "wasi", false => "unknown" }),
                }),
            }),
        }),
    })
}
cross_triple = (mp: MutPtr<Malloc>, osc: i32, arc: i32, abc: i32) string_view {
    hp := host()
    absent := osc < 0 || arc < 0 || abc < 0
    is_host := osc == cross_os_code(hp.os) && arc == cross_arch_code(hp.arch) && abc == cross_abi_code(hp.abi)
    (absent || is_host).match ({
        true  => "",
        false => mp.gstr_string(32).gstr_append(mp, cross_arch_name(arc)).gstr_append(mp, "-").gstr_append(mp, cross_os_name(osc)).gstr_append(mp, "-").gstr_append(mp, cross_abi_name(abc)).gstr_finish(mp),
    })
}
// v1 cross scope is LINUX cross-ARCH only: aarch64/x86_64/riscv64, gnu or musl. Cross-OS (macOS/
// Windows/FreeBSD) and wasm error loudly instead of producing garbage — bootstrap/zenrt.c is
// POSIX/glibc-shaped (sigaltstack, ucontext SP reads, pthread), and no conventional Linux-hosted
// cross toolchain exists for those targets.
cross_supported = (osc: i32, arc: i32, abc: i32) bool { osc == 2 && (arc == 1 || arc == 2 || arc == 3) && (abc == 2 || abc == 3) }
parse_spec_at = (mp: MutPtr<Malloc>, dir: string_view, specsrc: string_view, index: i32) Spec {
    v: [u8] := specsrc.view()
    base := 1 + index * 10
    name := mp.spec_field(v, base)
    root := mp.spec_field(v, base + 1)
    main := mp.spec_field(v, base + 2)
    out := mp.spec_field(v, base + 3)
    link := mp.spec_field(v, base + 4)
    cc := mp.spec_field(v, base + 5)
    osc := spec_code(mp.spec_field(v, base + 6))
    arc := spec_code(mp.spec_field(v, base + 7))
    abc := spec_code(mp.spec_field(v, base + 8))
    fg := mp.spec_field(v, base + 9)
    tgt := mp.cross_triple(osc, arc, abc)
    (eq(root, "") || eq(main, "")).match ({
        true  => {
            derr("zenc: build.zen: target is missing root/main\n")
            Spec(
                source: "",
                out: "",
                ccflags: "",
                links: "",
                ffi: "",
                genmods: "",
                target: "",
                library: false,
                ok: false,
            )
        },
        false => (eq(tgt, "") == false && cross_supported(osc, arc, abc) == false).match ({
            true  => {
                derr("zenc: build.zen: cross target ")
                derr(tgt)
                derr(" is unsupported in v1 (Linux aarch64|x86_64|riscv64, gnu|musl only)\n")
                empty_spec()
            },
            false => Spec(
                source: mp.join2(mp.join2(dir, root), main),
                out: eq(out, "").match ({
                    true  => eq(name, "").match ({ true => "", false => mp.join2(dir, name) }),
                    false => mp.join2(dir, out),
                }),
                ccflags: mp.source_flags(dir, cc),
                links: link,
                ffi: fg,
                genmods: mp.genmods_extract(dir, specsrc, index),
                target: tgt,
                library: false,
                ok: true,
            ),
        }),
    })
}
empty_spec = () Spec {
    Spec(
        source: "",
        out: "",
        ccflags: "",
        links: "",
        ffi: "",
        genmods: "",
        target: "",
        library: false,
        ok: false,
    )
}
// ── c_library genmods: the plan's trailing section (see std.build's c_library block) ─────────────
// After the N×10 target lines the plan carries the use()-records: one count line `G`, then per
// record a header line `<target> <id> <lib> <K>` followed by exactly K lines of generated module
// source (line-count-prefixed framing — the body is opaque to the line-based transport). For the
// SELECTED target the driver writes each body to <projdir>/.zen/gen/<id>.zen (gitignored) and
// returns the resolver registry text (`<id> <path>` lines) for genmods_set — stamped beside the
// ffi grants, before probe AND resolve, so the cache walk and the module loader both see the
// generated file through the one canonical module_path.
GENSUB = () string_view { ".zen/gen" }
gmx_tok_end = (v: [u8], i: i64) i64 { (i >= v.len || v[i] == ' ' || v[i] == '\n').match ({
    true  => i,
    false => v.gmx_tok_end(i + 1),
}) }
gmx_skip_lines = (v: [u8], p: i64, k: i32) i64 {
    (k <= 0 || p >= v.len).match ({
        true  => p,
        false => v.gmx_skip_lines(v.bs_line_end(p, v.len) + 1, k - 1),
    })
}
gmx_write = (mp: MutPtr<Malloc>, dir: string_view, id: string_view, body: string_view, blen: i64) string_view {
    mkdir(mp.join2(dir, ".zen"), MODE_755)
    gdir := mp.join2(dir, GENSUB())
    mkdir(gdir, MODE_755)
    gpath := mp.gstr_string(96).gstr_append(mp, gdir).gstr_append(mp, "/").gstr_append(mp, id).gstr_append(mp, ".zen").gstr_finish(mp)
    save(gpath, body, blen).match ({
        .Ok(n)  => { },
        .Err(e) => derr("zenc: build.zen: cannot write generated module\n"),
    })
    gpath
}
genmods_from = (mp: MutPtr<Malloc>, dir: string_view, specsrc: string_view, tname: string_view, p: i64, left: i32, acc: String) string_view {
    v: [u8] := specsrc.view()
    (left <= 0 || p >= v.len).match ({
        true  => acc.gstr_finish(mp),
        false => {
            te := v.gmx_tok_end(p)
            ie := v.gmx_tok_end(te + 1)
            le := v.gmx_tok_end(ie + 1)
            ke := v.bs_line_end(le + 1, v.len)
            be := v.gmx_skip_lines(ke + 1, v.plan_nat(le + 1, ke, 0))
            nxt := eq(mp.cstr_substr(specsrc, to_i32(p), to_i32(te - p)), tname).match ({
                true  => {
                    id := mp.cstr_substr(specsrc, to_i32(te + 1), to_i32(ie - te - 1))
                    body := mp.cstr_substr(specsrc, to_i32(ke + 1), to_i32(be - ke - 1))
                    acc.gstr_append(mp, id).gstr_append(mp, " ").gstr_append(mp, mp.gmx_write(dir, id, body, be - ke - 1)).gstr_push(mp, '\n')
                },
                false => acc,
            })
            mp.genmods_from(dir, specsrc, tname, be, left - 1, nxt)
        },
    })
}
genmods_extract = (mp: MutPtr<Malloc>, dir: string_view, specsrc: string_view, index: i32) string_view {
    v: [u8] := specsrc.view()
    gs := v.line_start(1 + specsrc.plan_count() * 10, 0)
    g := v.plan_nat(gs, v.bs_line_end(gs, v.len), 0)
    mp.genmods_from(dir, specsrc, mp.spec_field(v, 1 + index * 10), v.bs_line_end(gs, v.len) + 1, g, mp.gstr_string(64))
}
plan_nat = (v: [u8], i: i64, e: i64, n: i32) i32 {
    (i >= e).match ({
        true  => n,
        false => (v[i] >= '0' && v[i] <= '9').match ({
            true  => v.plan_nat(i + 1, e, n * 10 + to_i32(v[i] - '0')),
            false => n,
        }),
    })
}
plan_count = (specsrc: string_view) i32 {
    v := specsrc.view()
    v.plan_nat(0, v.bs_line_end(0, v.len), 0)
}
PlanSource*: {
    src: string_view,
    ok: bool,
}
build_zen_plan = (mp: MutPtr<Malloc>, root: string_view, dir: string_view) PlanSource {
    contents_in(mp, mp.join2(dir, "build.zen")).match ({
        .Ok(bsrc) => {
            es := mp.gstr_string(1024).gstr_append(mp, bsrc).gstr_append(mp, BUILD_TAIL())
            entry := es.gstr_finish(mp)
            epath := mp.join2(dir, ".zenbuild_entry.zen")
            save(epath, entry, es.len).match ({
                .Ok(n)  => { },
                .Err(e) => { },
            })
            bbin := mp.BUILDBIN()
            rc := mp.compile_to(root, epath, entry, bbin, "", "", "")    // the build program always runs on the HOST
            unlink(epath)    // don't leave the entry in the project dir
            (rc == 0).match ({
                true  => {
                    spf := mp.SPECFILE()
                    mp.gstr_string(256).gstr_append(mp, bbin).gstr_append(mp, " > ").gstr_append(mp, spf).gstr_finish(mp).system()
                    sp := contents_in(mp, spf).match ({
                        .Ok(spec) => PlanSource(
                            src: spec,
                            ok: true,
                        ),
                        .Err(e)   => PlanSource(
                            src: "",
                            ok: false,
                        ),
                    })
                    unlink(bbin)
                    unlink(spf)
                    sp
                },
                false => {
                    derr("zenc: build.zen: the build program did not compile\n")
                    PlanSource(
                        src: "",
                        ok: false,
                    )
                },
            })
        },
        .Err(e)   => PlanSource(
            src: "",
            ok: false,
        ),
    })
}
plan_find_name = (mp: MutPtr<Malloc>, src: string_view, wanted: string_view, i: i32, n: i32) i32 {
    (i >= n).match ({
        true  => 0 - 1,
        false => eq(mp.spec_field(src.view(), 1 + i * 10), wanted).match ({
            true  => i,
            false => mp.plan_find_name(src, wanted, i + 1, n),
        }),
    })
}
build_zen_spec = (mp: MutPtr<Malloc>, root: string_view, dir: string_view) Spec {
    p := mp.build_zen_plan(root, dir)
    (p.ok && p.src.plan_count() > 0).match ({
        true  => mp.parse_spec_at(dir, p.src, 0),
        false => empty_spec(),
    })
}    // no build.zen -> try zen.toml
build_named_plan = (mp: MutPtr<Malloc>, root: string_view, dir: string_view, wanted: string_view) i32 {
    p := mp.build_zen_plan(root, dir)
    n := p.src.plan_count()
    i := mp.plan_find_name(p.src, wanted, 0, n)
    (p.ok && i >= 0).match ({
        true  => mp.build_spec(root, mp.parse_spec_at(dir, p.src, i), "", ""),
        false => {
            derr("zenc: build.zen: no target named `")
            derr(wanted)
            derr("`\n")
            1
        },
    })
}
build_plan_from = (mp: MutPtr<Malloc>, root: string_view, dir: string_view, src: string_view, i: i32, n: i32, failures: i32) i32 {
    (i >= n).match ({
        true  => failures,
        false => mp.build_plan_from(root, dir, src, i + 1, n, failures + mp.build_spec(root, mp.parse_spec_at(dir, src, i), "", "")),
    })
}
build_all_plan = (mp: MutPtr<Malloc>, root: string_view, dir: string_view) i32 {
    p := mp.build_zen_plan(root, dir)
    p.ok.match ({
        true  => mp.build_plan_from(root, dir, p.src, 0, p.src.plan_count(), 0),
        false => 1,
    })
}
list_plan_from = (mp: MutPtr<Malloc>, src: string_view, i: i32, n: i32) i32 {
    (i >= n).match ({
        true  => 0,
        false => {
            say(mp.spec_field(src.view(), 1 + i * 10))
            mp.list_plan_from(src, i + 1, n)
        },
    })
}
list_plan_targets = (mp: MutPtr<Malloc>, root: string_view, dir: string_view) i32 {
    p := mp.build_zen_plan(root, dir)
    p.ok.match ({ true => mp.list_plan_from(p.src, 0, p.src.plan_count()), false => 1 })
}
// ── `zenc lsp` — diagnostics-only Language Server over stdio (LSP Stage 0) ─────────────────────────
// A JSON-RPC 2.0 loop: read `Content-Length: N\r\n\r\n<N-byte JSON body>` frames from stdin, run the
// EXISTING check pipeline (resolve -> parse -> the diagnostic channels) on each opened/changed
// document, and PUSH `textDocument/publishDiagnostics`. This only ADDS a subcommand — no compiler
// internals change; it rides check_module_batch + the specialized channels the driver already uses.
// Single-file scope (full-sync): the document text is checked standalone; its directory is derived
// from the `file://` URI so sibling/std imports resolve. Multi-file project awareness is later.
// PROTOCOL WRITES GO TO STDOUT (fd 1); every diagnostic/log the pipeline emits stays on stderr, so the
// JSON-RPC stream is never corrupted.
lout = (s: string_view) i64 {
    v := s.view()
    write(1, v.ptr, v.len)
}
// frame + write one JSON-RPC message: `Content-Length: <bytes>\r\n\r\n<body>`.
lsp_send = (mp: MutPtr<Malloc>, body: string_view) i64 {
    lout(mp.gstr_string(48).gstr_append(mp, "Content-Length: ").push_int(mp, body.view().len).gstr_append(mp, "\r\n\r\n").gstr_finish(mp))
    lout(body)
}
// ── JSON string EMISSION (own escaper; the task sanctions building output as strings) ─────────────
lsp_hexd = (n: i64) u8 { (n < 10).match ({
    true  => ('0'.to_i64() + n).to_u8(),
    false => ('a'.to_i64() + n - 10).to_u8(),
}) }
push_uesc = (sb: String, mp: MutPtr<Malloc>, b: u8) String {
    bi := b.to_i64()
    sb.gstr_append(mp, "\\u00").gstr_push(mp, lsp_hexd(bi >> 4 & 15)).gstr_push(mp, lsp_hexd(bi & 15))
}
// append `s` as a JSON string LITERAL (surrounding quotes + escaped) to the builder.
push_jstr = (sb: String, mp: MutPtr<Malloc>, s: string_view) String {
    cur := sb.gstr_push(mp, '"')
    v: [u8] := s.view()
    v.loop((h, i, b) {
        cur = (b == '"').match ({
            true  => cur.gstr_append(mp, "\\\""),
            false => (b == '\\').match ({
                true  => cur.gstr_append(mp, "\\\\"),
                false => (b == '\n').match ({
                    true  => cur.gstr_append(mp, "\\n"),
                    false => (b == '\r').match ({
                        true  => cur.gstr_append(mp, "\\r"),
                        false => (b == '\t').match ({
                            true  => cur.gstr_append(mp, "\\t"),
                            false => (b < 32).match ({
                                true  => cur.push_uesc(mp, b),
                                false => cur.gstr_push(mp, b),
                            }),
                        }),
                    }),
                }),
            }),
        })
    })
    cur.gstr_push(mp, '"')
}
// ── incoming JSON extraction (hand-rolled; std.json's `parse`/`get` collide with the compiler's own
// flat `parse`/`get` names once this closure imports compiler.parse, so a targeted scanner is used).
// The scanner walks left-to-right skipping over complete JSON strings, so a `"key":` byte-pattern that
// happens to sit INSIDE a string value (e.g. the document source text) is never mistaken for a key.
// String scanning/decoding is ITERATIVE (`@while`) so a megabyte document never recurses the C stack.
// index just past the closing quote of the string opening at v[i]=='"' (respecting `\` escapes).
json_str_end = (v: [u8], i: i64) i64 {
    j := i + 1
    done: i64 := 0 - 1
    @while (done < 0 && j < v.len) {
        b := v[j]
        (b == '\\').match ({
            true  => {
                j = j + 2
            },
            false => (b == '"').match ({
                true  => {
                    done = j + 1
                },
                false => {
                    j = j + 1
                },
            }),
        })
    }
    (done < 0).match ({ true => v.len, false => done })
}
json_skip_ws = (v: [u8], p: i64) i64 {
    q := p
    @while (q < v.len && (v[q] == ' ' || v[q] == '\t' || v[q] == '\n' || v[q] == '\r')) {
        q = q + 1
    }
    q
}
json_range_eq = (v: [u8], start: i64, kv: [u8], k: i64) bool {
    (k >= kv.len).match ({
        true  => true,
        false => (v[start + k] == kv[k]).match ({
            true  => v.json_range_eq(start, kv, k + 1),
            false => false,
        }),
    })
}
json_str_eq_range = (v: [u8], start: i64, end: i64, kv: [u8]) bool { (end - start != kv.len).match ({
    true  => false,
    false => v.json_range_eq(start, kv, 0),
}) }
// the byte offset of the VALUE for the first object key named `key`, or -1. Strings are consumed whole,
// so key matches inside a value never fire and nesting is transparent.
json_find_key = (v: [u8], key: string_view) i64 {
    kv: [u8] := key.view()
    i: i64 := 0
    result: i64 := 0 - 1
    stop := false
    @while (stop == false && i < v.len) {
        (v[i] == '"').match ({
            true  => {
                se := v.json_str_end(i)
                cs := v.json_skip_ws(se)
                (cs < v.len && v[cs] == ':').match ({
                    true  => v.json_str_eq_range(i + 1, se - 1, kv).match ({
                        true  => {
                            result = v.json_skip_ws(cs + 1)
                            stop = true
                        },
                        false => {
                            i = se
                        },
                    }),
                    false => {
                        i = se
                    },
                })
            },
            false => {
                i = i + 1
            },
        })
    }
    result
}
json_hexq = (v: [u8], at: i64) i64 {
    (at + 3 >= v.len).match ({
        true  => 0 - 1,
        false => {
            h0 := hexval(v[at])
            h1 := hexval(v[at + 1])
            h2 := hexval(v[at + 2])
            h3 := hexval(v[at + 3])
            (h0 < 0 || h1 < 0 || h2 < 0 || h3 < 0).match ({
                true  => 0 - 1,
                false => h0 * 4096 + h1 * 256 + h2 * 16 + h3,
            })
        },
    })
}
hexval = (b: u8) i64 {
    (b >= '0' && b <= '9').match ({
        true  => to_i64(b - '0'),
        false => (b >= 'a' && b <= 'f').match ({
            true  => to_i64(b - 'a') + 10,
            false => (b >= 'A' && b <= 'F').match ({ true => to_i64(b - 'A') + 10, false => 0 - 1 }),
        }),
    })
}
// UTF-8 encode a BMP code point into the builder (1–3 bytes).
push_utf8 = (sb: String, mp: MutPtr<Malloc>, cp: i64) String {
    (cp < 128).match ({
        true  => sb.gstr_push(mp, cp.to_u8()),
        false => (cp < 2048).match ({
            true  => sb.gstr_push(mp, (192 | cp >> 6).to_u8()).gstr_push(mp, (128 | cp & 63).to_u8()),
            false => sb.gstr_push(mp, (224 | cp >> 12).to_u8()).gstr_push(mp, (128 | cp >> 6 & 63).to_u8()).gstr_push(mp, (128 | cp & 63).to_u8()),
        }),
    })
}
// decode the JSON string opening at v[i]=='"' into an allocator-owned view (escapes resolved).
json_decode_str = (mp: MutPtr<Malloc>, v: [u8], i: i64) string_view {
    sb := mp.gstr_string(v.len - i + 1)
    j := i + 1
    stop := false
    @while (stop == false && j < v.len) {
        b := v[j]
        (b == '"').match ({
            true  => {
                stop = true
            },
            false => (b == '\\' && j + 1 < v.len).match ({
                true  => {
                    e := v[j + 1]
                    (e == 'n').match ({
                        true  => {
                            sb = sb.gstr_push(mp, '\n')
                            j = j + 2
                        },
                        false => (e == 't').match ({
                            true  => {
                                sb = sb.gstr_push(mp, '\t')
                                j = j + 2
                            },
                            false => (e == 'r').match ({
                                true  => {
                                    sb = sb.gstr_push(mp, '\r')
                                    j = j + 2
                                },
                                false => (e == 'b').match ({
                                    true  => {
                                        sb = sb.gstr_push(mp, 8.to_u8())
                                        j = j + 2
                                    },
                                    false => (e == 'f').match ({
                                        true  => {
                                            sb = sb.gstr_push(mp, 12.to_u8())
                                            j = j + 2
                                        },
                                        false => (e == 'u').match ({
                                            true  => {
                                                cp := v.json_hexq(j + 2)
                                                (cp < 0).match ({
                                                    true  => {
                                                        sb = sb.gstr_push(mp, e)
                                                        j = j + 2
                                                    },
                                                    false => {
                                                        sb = sb.push_utf8(mp, cp)
                                                        j = j + 6
                                                    },
                                                })
                                            },
                                            false => {
                                                sb = sb.gstr_push(mp, e)
                                                j = j + 2
                                            },
                                        }),
                                    }),
                                }),
                            }),
                        }),
                    })
                },
                false => {
                    sb = sb.gstr_push(mp, b)
                    j = j + 1
                },
            }),
        })
    }
    sb.gstr_finish(mp)
}
// raw bytes of the value at v[i]: a quoted string (incl. quotes) or a bare token up to `,`/`}`/`]`/ws.
json_raw_at = (mp: MutPtr<Malloc>, v: [u8], i: i64) string_view {
    (i >= v.len).match ({
        true  => "null",
        false => (v[i] == '"').match ({
            true  => mp.json_slice(v, i, v.json_str_end(i)),
            false => {
                e := i
                stop := false
                @while (stop == false && e < v.len) {
                    b := v[e]
                    (b == ',' || b == '}' || b == ']' || b == ' ' || b == '\t' || b == '\n' || b == '\r').match ({
                        true  => {
                            stop = true
                        },
                        false => {
                            e = e + 1
                        },
                    })
                }
                mp.json_slice(v, i, e)
            },
        }),
    })
}
json_slice = (mp: MutPtr<Malloc>, v: [u8], start: i64, end: i64) string_view {
    sb := mp.gstr_string(end - start + 1)
    j := start
    @while (j < end) {
        sb = sb.gstr_push(mp, v[j])
        j = j + 1
    }
    sb.gstr_finish(mp)
}
// the decoded string value of the first key `key`, or "" if absent / non-string.
json_str_field = (mp: MutPtr<Malloc>, body: string_view, key: string_view) string_view {
    v: [u8] := body.view()
    p := v.json_find_key(key)
    (p < 0 || p >= v.len).match ({
        true  => "",
        false => (v[p] == '"').match ({ true => mp.json_decode_str(v, p), false => "" }),
    })
}
// the request id as a raw JSON fragment (number or quoted string), echoed verbatim into the reply.
lsp_id = (mp: MutPtr<Malloc>, body: string_view) string_view {
    v: [u8] := body.view()
    p := v.json_find_key("id")
    (p < 0).match ({ true => "null", false => mp.json_raw_at(v, p) })
}
// ── URI -> filesystem path (strip a leading `file://`; percent-decoding is a later refinement) ─────
lsp_has_prefix = (s: string_view, pre: string_view) bool {
    sv: [u8] := s.view()
    pv: [u8] := pre.view()
    (sv.len < pv.len).match ({ true => false, false => lsp_prefix_bytes(sv, pv, 0) })
}
lsp_prefix_bytes = (sv: [u8], pv: [u8], i: i64) bool {
    (i >= pv.len).match ({
        true  => true,
        false => (sv[i] == pv[i]).match ({ true => sv.lsp_prefix_bytes(pv, i + 1), false => false }),
    })
}
lsp_uri_path = (mp: MutPtr<Malloc>, uri: string_view) string_view {
    uri.lsp_has_prefix("file://").match ({
        true  => mp.cstr_substr(uri, 7, to_i32(uri.view().len - 7)),
        false => uri,
    })
}
// ── DiagSpan (1-based line/col, 1-based-inclusive end_col) -> LSP 0-based range ────────────────────
// LSP is 0-based: line -> line-1, start.character -> col-1. end_col is the 1-based inclusive last
// column, numerically the 0-based EXCLUSIVE end — so end.character = end_col (never a further -1). An
// unlocated span (line 0) is pinned to the file start with a 1-char range so the squiggle is visible.
ZSpan: {
    l: i64,
    c: i64,
    e: i64,
}
lsp_end_char = (sp: DiagSpan) i64 {
    ec := to_i64(sp.end_col)
    cc := to_i64(sp.col - 1)
    (ec > cc).match ({ true => ec, false => cc + 1 })
}
lsp_zero_span = (sp: DiagSpan) ZSpan {
    (sp.line > 0).match ({
        true  => ZSpan(
            l: to_i64(sp.line - 1),
            c: (sp.col > 0).match ({ true => to_i64(sp.col - 1), false => 0 }),
            e: sp.lsp_end_char(),
        ),
        false => ZSpan(
            l: 0,
            c: 0,
            e: 1,
        ),
    })
}
// ── one diagnostic -> one LSP Diagnostic object, accumulated (comma-separated) into the array ──────
DiagAcc: {
    sb: String,
    n: i32,
}
lsp_push_diag = (mp: MutPtr<Malloc>, acc: DiagAcc, rp: ResolvedProgram, raw: [Decl], decls: [Decl], path: string_view, user: string_view, cd: CheckDiagnostic) DiagAcc {
    (cd.code == 0).match ({
        true  => acc,
        false => {
            dl := rp.locate_diag(cd.source_offset, cd.span_width, path, user)
            z := lsp_zero_span(dl.sp)
            // enrich exactly like the CLI (emit_one): denriched message + world-teaching undefined-name hint.
            msg := desc_or(mp.denrich_check(raw, decls, cd.source_offset, cd.code, cd.kind), cd.message)
            hint := cd.hint
            eq(cd.kind, "undefined-name").then({
                wh := mp.undefined_name_hint(rp.table, rp.flat, cd.source_offset)
                (is_empty(wh) == false).then({
                    hint = wh
                })
            })
            full := is_empty(hint).match ({
                true  => msg,
                false => mp.gstr_string(128).gstr_append(mp, msg).gstr_append(mp, " — ").gstr_append(mp, hint).gstr_finish(mp),
            })
            sep := (acc.n > 0).match ({ true => ",", false => "" })
            sb2 := acc.sb.gstr_append(mp, sep).gstr_append(mp, "{\"range\":{\"start\":{\"line\":").push_int(mp, z.l).gstr_append(mp, ",\"character\":").push_int(mp, z.c).gstr_append(mp, "},\"end\":{\"line\":").push_int(mp, z.l).gstr_append(mp, ",\"character\":").push_int(mp, z.e).gstr_append(mp, "}},\"severity\":1,\"code\":").push_jstr(mp, cd.kind).gstr_append(mp, ",\"source\":\"zen\",\"message\":").push_jstr(mp, full).gstr_append(mp, "}")
            DiagAcc(
                sb: sb2,
                n: acc.n + 1,
            )
        },
    })
}
// run the pipeline on `text` and PUBLISH. Structural blockers (no-if, parse) are reported ALONE —
// their flat sentinels would otherwise spray bogus type errors. Otherwise every specialized semantic
// channel (reserved/ownership/escape/leak/…/mustuse) contributes its diagnostic AND the whole main
// batch (names/types/arity/exhaustiveness/…) is collected, so an ownership error shows alongside type
// errors rather than one channel hiding the rest. Empty array => clears old squiggles.
lsp_diags_array = (mp: MutPtr<Malloc>, root: string_view, path: string_view, text: string_view) string_view {
    rp := mp.resolve_prog(root, path, text)
    raw := mp.parse_module(rp.flat)
    decls := mp.resolve_module(raw)
    nif := check_module_no_if_diagnostic_from_source(rp.flat)
    pars := mp.check_module_parse_diagnostic_from_source(decls, rp.flat)
    acc := DiagAcc(
        sb: mp.gstr_string(256),
        n: 0,
    )
    done := (nif.code != 0).match ({
        true  => mp.lsp_push_diag(acc, rp, raw, decls, path, text, nif),
        false => (pars.code != 0).match ({
            true  => mp.lsp_push_diag(acc, rp, raw, decls, path, text, pars),
            false => {
                a := acc
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_reserved_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_ownership_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_escape_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_leak_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_addr_escape_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_send_rc_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_scratch_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_send_mut_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_bound_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_arg_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_or_return_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_unknown_type_diagnostic_from_source(decls, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_ffi_diagnostic_from_source(decls, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, check_module_infinite_type_diagnostic_from_source(decls, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, check_module_main_diagnostic_from_source(raw, rp.flat))
                a = mp.lsp_push_diag(a, rp, raw, decls, path, text, mp.check_module_mustuse_diagnostic_from_source(raw, rp.flat))
                ds := mp.check_module_batch(decls, rp.flat)
                ds.loop((h, i, cd) {
                    a = mp.lsp_push_diag(a, rp, raw, decls, path, text, cd)
                })
                a
            },
        }),
    })
    done.sb.gstr_finish(mp)
}
lsp_publish = (mp: MutPtr<Malloc>, root: string_view, uri: string_view, text: string_view) i64 {
    arr := mp.lsp_diags_array(root, mp.lsp_uri_path(uri), text)
    mp.lsp_send(mp.gstr_string(512).gstr_append(mp, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":").push_jstr(mp, uri).gstr_append(mp, ",\"diagnostics\":[").gstr_append(mp, arr).gstr_append(mp, "]}}").gstr_finish(mp))
}
// ── request/notification handlers ─────────────────────────────────────────────────────────────────
lsp_reply_initialize = (mp: MutPtr<Malloc>, body: string_view) i64 { mp.lsp_send(mp.gstr_string(256).gstr_append(mp, "{\"jsonrpc\":\"2.0\",\"id\":").gstr_append(mp, mp.lsp_id(body)).gstr_append(mp, ",\"result\":{\"capabilities\":{\"textDocumentSync\":1},\"serverInfo\":{\"name\":\"zenc-lsp\",\"version\":\"0.2.0-dev\"}}}").gstr_finish(mp)) }
lsp_reply_null = (mp: MutPtr<Malloc>, body: string_view) i64 { mp.lsp_send(mp.gstr_string(96).gstr_append(mp, "{\"jsonrpc\":\"2.0\",\"id\":").gstr_append(mp, mp.lsp_id(body)).gstr_append(mp, ",\"result\":null}").gstr_finish(mp)) }
// didOpen/didChange (full-sync) both carry the whole document text; the first `text` key is the
// document content (the URI's `text` in didOpen, the single contentChange's `text` in didChange).
lsp_did_change = (mp: MutPtr<Malloc>, root: string_view, body: string_view) i64 { mp.lsp_publish(root, mp.json_str_field(body, "uri"), mp.json_str_field(body, "text")) }
// dispatch one message. Returns 0 = keep serving, 1 = shutdown received, 2 = exit. Unknown methods
// (initialized / didClose / anything else) are no-ops so the server never crashes on them.
lsp_handle = (mp: MutPtr<Malloc>, root: string_view, body: string_view) i32 {
    method := mp.json_str_field(body, "method")
    eq(method, "initialize").match ({
        true  => {
            mp.lsp_reply_initialize(body)
            0
        },
        false => eq(method, "shutdown").match ({
            true  => {
                mp.lsp_reply_null(body)
                1
            },
            false => eq(method, "exit").match ({
                true  => 2,
                false => (eq(method, "textDocument/didOpen") || eq(method, "textDocument/didChange")).match ({
                    true  => {
                        mp.lsp_did_change(root, body)
                        0
                    },
                    false => 0,
                }),
            }),
        }),
    })
}
// ── stdio framing: read `Content-Length: N\r\n\r\n` headers, then exactly N body bytes ─────────────
LSP_HDR_CAP = () i64 { 1024 }
// read stdin one byte at a time into `buf` until the CRLFCRLF terminator (so we never over-read into
// the body). Returns the header length incl. terminator; 0 on clean EOF before any byte; -1 on error.
lsp_read_headers = (mp: MutPtr<Malloc>, buf: RawPtr<u8>, off: i64) i64 {
    r := read(0, buf.offset(off), 1)
    (r <= 0).match ({
        true  => (off == 0).match ({ true => 0, false => 0 - 1 }),
        false => (off >= 3 && load(buf.offset(off - 3)) == '\r' && load(buf.offset(off - 2)) == '\n' && load(buf.offset(off - 1)) == '\r' && load(buf.offset(off)) == '\n').match ({
            true  => off + 1,
            false => (off + 1 >= LSP_HDR_CAP()).match ({
                true  => 0 - 1,
                false => mp.lsp_read_headers(buf, off + 1),
            }),
        }),
    })
}
lsp_match_bytes = (buf: RawPtr<u8>, i: i64, wv: [u8], k: i64) bool {
    (k >= wv.len).match ({
        true  => true,
        false => (load(buf.offset(i + k)) == wv[k]).match ({
            true  => buf.lsp_match_bytes(i, wv, k + 1),
            false => false,
        }),
    })
}
lsp_match_at = (buf: RawPtr<u8>, i: i64, len: i64, word: string_view) bool {
    wv: [u8] := word.view()
    (i + wv.len > len).match ({ true => false, false => buf.lsp_match_bytes(i, wv, 0) })
}
// read a decimal starting at `i` (skipping leading spaces); -1 if no digit before end/non-space.
lsp_read_dec = (buf: RawPtr<u8>, i: i64, len: i64, acc: i64, started: bool) i64 {
    (i >= len).match ({
        true  => started.match ({ true => acc, false => 0 - 1 }),
        false => {
            b := load(buf.offset(i))
            (b >= '0' && b <= '9').match ({
                true  => buf.lsp_read_dec(i + 1, len, acc * 10 + (b - '0').to_i64(), true),
                false => (b == ' ' && started == false).match ({
                    true  => buf.lsp_read_dec(i + 1, len, acc, false),
                    false => started.match ({ true => acc, false => 0 - 1 }),
                }),
            })
        },
    })
}
lsp_content_length = (buf: RawPtr<u8>, i: i64, len: i64) i64 {
    (i >= len).match ({
        true  => 0 - 1,
        false => buf.lsp_match_at(i, len, "Content-Length:").match ({
            true  => buf.lsp_read_dec(i + 15, len, 0, false),
            false => buf.lsp_content_length(i + 1, len),
        }),
    })
}
// read exactly `n` body bytes into `buf` (read() may return short; loop until filled or EOF).
lsp_read_body = (buf: RawPtr<u8>, off: i64, n: i64) i64 {
    (off >= n).match ({
        true  => off,
        false => {
            r := read(0, buf.offset(off), n - off)
            (r <= 0).match ({ true => off, false => buf.lsp_read_body(off + r, n) })
        },
    })
}
// the JSON-RPC stdio loop: frame -> dispatch, until `exit`. Exit code follows the LSP convention:
// 0 if `exit` arrived after `shutdown`, else 1 (also 1 if the stream closes without a clean shutdown).
lsp_cmd = (mp: MutPtr<Malloc>, root: string_view) i32 {
    hbuf := mp.acquire(LSP_HDR_CAP())
    running := true
    shut := false
    code := 1
    @while (running) {
        hlen := mp.lsp_read_headers(hbuf, 0)
        (hlen <= 0).match ({
            true  => {
                running = false
                code = shut.match ({ true => 0, false => 1 })
            },
            false => {
                n := hbuf.lsp_content_length(0, hlen)
                (n < 0).match ({
                    true  => 0,
                    false => {
                        body := mp.acquire(n + 1)
                        got := body.lsp_read_body(0, n)
                        body.offset(got).store(0)
                        act := mp.lsp_handle(root, cstr(body))
                        (act == 1).then({
                            shut = true
                        })
                        (act == 2).then({
                            running = false
                            code = shut.match ({ true => 0, false => 1 })
                        })
                        0
                    },
                })
            },
        })
    }
    code
}
