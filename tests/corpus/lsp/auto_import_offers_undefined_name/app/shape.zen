// The module the test's buffer imports. It imports `kit` and USES the
// name — an unused import is its own fault, and this test's diagnostics
// list is part of its assertion — so `Bag` is in the world's tables for
// `exported_named` to find while the buffer's own `Bag` stays undefined.
Bag = app.kit

Point* = {
    x*: i32,
    y*: i32,
}

bagged* = (b: Bag) i32 { b.n }
