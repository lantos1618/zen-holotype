// src/gen/gen_c/gen_c_state.zen
// What the C backend holds while it works.
//
// The split is `sema_check.zen`'s and for its reason: STATE here,
// BEHAVIOUR in the files beside it, so the dependency points one way
// and a lowering rule never has to import the thing lowering it.
//
// FIVE THINGS, and each one exists to keep the output a pure function
// of the input:
//
//   - THE TYPE WORKLIST is two parallel `Vec`s and not a `Map`, because
//     it is EMITTED. A `Map` cannot be walked in an order that survives
//     a different insertion sequence, and `gen_emit.order` sorts these
//     by mangled name — which is `tcode`, a pure function of the type.
//   - THE LOCAL SCOPE is a stack with marks, exactly as sema's is, plus
//     a per-function list of every name ever declared. The second one
//     is what gives a shadowing binding its number: `zu_l1x` and
//     `zu_l1x_2` are two C names for two Zen bindings that share a
//     spelling, and the number counts declarations rather than depth so
//     that leaving and re-entering a block cannot reuse one.
//   - THE TEMPORARY COUNTER is reset at every function, so a function's
//     temporaries depend on its own body and on nothing that was
//     compiled before it.
//   - THE HELPER SET records which integer types a checked operation
//     was emitted for, so the runtime carries one family per type the
//     program actually uses rather than all ten.
//   - THE BODY BUFFER is scratch. Bodies are lowered first because
//     lowering is what discovers which types and which helpers the
//     program needs; the translation unit is assembled afterwards, in
//     the order C requires.
//
// THE CHECKER IS TAKEN, NOT BORROWED. `Checker` owns `Vec`s and `Map`s,
// so a copy diverges from the original the first time either grows —
// the same reason `Parser` holds the `Ast` rather than handing it back.
// Hand it in at construction and read every answer back off the
// backend.

Ast, ExprId, Span, Lambda = ast
str, String = std.text
Alloc, AllocError = std.mem
Vec = std.collections
Range = std.core
DeclId = sema.sema_id
TyId, Types = sema.sema_ty
World, Def = sema.sema_def
Checker, Ctx = sema.sema_check
Inst = sema.sema_inst
Emit = gen.gen_emit
GenDiag, GenFault, render_gen = gen.gen_diag

// One binding in scope, and the number that makes its C name unique
// inside its function.
LocalSlot* = {
    name*: str,
    index*: usize,
    ty*: TyId,

    // Is the C name a POINTER to the value rather than the value?
    // "`::` means the method writes the receiver's OWN BYTES", so a
    // `::` parameter is passed by address and every read of it goes
    // through a dereference. A `::=` LOCAL is not by reference: it is
    // the frame's own storage and there is nothing to alias.
    by_ref*: bool,

    // WHICH LOOP THIS NAME IS THE HANDLE OF, 1-based, or 0 for an
    // ordinary binding. `(h, value) { .. }` binds `h` to a
    // `LoopHandle`, which is not a value and has no C storage: it is
    // the two labels of the loop it came from, so the binding carries
    // the loop's depth and `h.break(v)` reads the frame back out.
    // Depth and not a pointer because a body inlined inside another
    // body has both loops in scope and the inner one shadows.
    handle*: usize,

    // WHICH CLOSURE THIS NAME IS, 1-based, or 0 for an ordinary
    // binding. A lambda handed to a function-typed parameter has no C
    // storage either: "a body is a non-escaping stack closure, inlined
    // at the call site, so there is no closure record to box". So the
    // binding carries an index into the backend's closure table and
    // `f(x)` inlines the lambda rather than calling through a pointer.
    closure*: usize,
}

// A lambda bound to a function-typed parameter, and everything the
// inliner needs to put its body back where it was written.
//
// THE FRAME IS THE HALF THAT IS EASY TO GET WRONG. A closure's free
// names mean what they meant WHERE IT WAS WRITTEN, and inlining puts
// the body inside the callee's frame — where `find`'s own
// `range.loop((h, value) { .. })` would otherwise capture a caller's
// `h`, silently and with a different value rather than with an error.
// So `home` and `check_home` are the two scope stacks' depths at the
// point the lambda was written, and the inliner rewinds both.
//
// `ctx` is the CALLER's, and that is what makes a `.try()` inside a
// lambda body return from the real function it was written in rather
// than from the callee it was inlined into.
Closure* = {
    lam*: Lambda,
    // the closure's declared parameter types, from the signature it was
    // handed to: "a closure passed to a function whose signature is
    // already known infers its parameter types from that signature"
    ptys*: Vec<TyId>,
    ret*: TyId,
    home*: usize,
    check_home*: usize,
    inst*: Inst,
    ctx*: Ctx,
}

// The two labels and the result of one loop being lowered.
//
// `h.break(v)` and `h.next()` are `goto`s and not C's `break` and
// `continue`: an inlined body sits inside whatever the lowering of a
// `.match` produced, and a C `break` there would leave that construct
// rather than the loop. A label is unambiguous wherever it is written.
LoopFrame* = {
    brk*: usize,        // the label a `break` jumps to
    cnt*: usize,        // the label the next pass starts at
    result*: str,       // the C name the loop's value lands in
    has_result*: bool,  // ..when it has one; a discarded loop has none
    ty*: TyId,          // the `Res<T>` that value is
}

// One member function reached through a dot, and the receiver it was
// reached at.
//
// A `Def` cannot carry it: a member is not a top-level declaration and
// `World` never mints one for it. So the identity is written out —
// `qname` is the TYPE's qualified name plus the member's, which is what
// makes two types' `get` two symbols without a counter.
MethodRef* = {
    self_ty*: TyId,
    decl*: DeclId,   // the declaration that owns the member
    name*: str,
    qname*: str,
}

CBackend* = {
    tree*: Ast,
    check* :: Checker,

    // where a body is lowered. Scratch, and one per function: the
    // translation unit is assembled from the kept texts afterwards.
    buf :: Emit,

    diags :: Vec<GenDiag>,

    // the types this program needs a C definition for
    type_names* :: Vec<String>,
    type_ids* :: Vec<TyId>,
    // `Vec<usize>` and not `Vec<bool>`: a `Res<bool>` defeats the
    // bootstrapper's inference of `Ok`, which is recorded with a
    // reproducer in docs/GEN_BOOTSTRAP_FIXES.md. 0 is pending, 1 is
    // written.
    type_done* :: Vec<usize>,

    // the integer types a checked `+ - * / %` was emitted for
    helper_types* :: Vec<String>,

    // did anything reach `println`? The print floor is emitted only for
    // a program that prints, exactly as the checked-arithmetic families
    // are emitted only for the types a program computes on.
    print_used :: bool,

    // did anything reach the filesystem? The two POSIX headers the FS
    // floor needs are the one place the emitted C leaves C99, so a
    // program that never opens a file must not pay for them.
    fs_used :: bool,

    // the functions to lower, and the ones already lowered.
    //
    // REACHABILITY, NOT THE WHOLE TREE. A compilation stages the whole
    // of `std` beside the program, and lowering every declaration in it
    // would emit a translation unit nobody asked for and a diagnostic
    // for every form this backend does not reach yet. So the walk is
    // seeded with one module's functions and follows the calls that
    // resolve — which is also what "compilation is whole-program" means
    // in practice: one merged graph, walked from a root.
    fn_queue* :: Vec<Def>,
    // the member functions reached through a dot. A second queue and
    // not a second kind of `Def`: a member has no top-level declaration
    // to mint one from, and `World` is the wrong place to teach that.
    m_queue* :: Vec<MethodRef>,
    // WHAT EACH QUEUED THING IS INSTANTIATED AT, parallel to the queue
    // beside it. A generic function is emitted once per distinct set of
    // type arguments, so a queue entry is a `(declaration, instantiation)`
    // pair — and the pair is carried rather than re-derived, because the
    // symbol written at the call site and the symbol written above the
    // body have to be the same bytes.
    fn_insts :: Vec<Inst>,
    m_insts :: Vec<Inst>,
    // the instantiation the function CURRENTLY being lowered is at.
    // Empty for everything that is not generic, which is what makes
    // `subst` cost one field read on the common path.
    inst* :: Inst,
    fn_seen :: Vec<String>,
    fn_names* :: Vec<String>,
    fn_protos* :: Vec<String>,
    fn_bodies* :: Vec<String>,

    // per function
    locals :: Vec<LocalSlot>,
    declared :: Vec<String>,
    // the loops open at this point in the lowering, innermost last
    loops :: Vec<LoopFrame>,
    // every lambda bound during this function, appended and never
    // popped: a `LocalSlot` names one by index and the index has to
    // outlive the scope the name was visible in, because the body is
    // lowered after the frame has been rewound past it.
    closures :: Vec<Closure>,
    // how many callees are open at this point. A bound, so a callee
    // that inlines itself reports rather than not terminating.
    depth* :: usize,
    tmp* :: usize,

    alloc*: Alloc,

    // -----------------------------------------------------------------
    // what came out
    // -----------------------------------------------------------------

    diag_count* = (self: @Self) usize { self.diags.len }

    diag_at* = (self: @Self, i: usize) Res<GenDiag> { self.diags.get(i) }

    render_diags* = (self: @Self, out :: String) Res<(), AllocError> {
        self.diags.loop((h, d) {
            render_gen(d, out).try();
            out.add_bytes("\n").try();
        });
        Ok(());
    }

    report* = (self :: @Self, file: str, span: Span, fault: GenFault)
              Res<(), AllocError> {
        self.diags.add(GenDiag(file: file, span: span, fault: fault))
    }

    // A fault raised against an expression, which is where almost every
    // one of them is raised. Saves each call site the two-line walk
    // back to the node for its position.
    report_expr* = (self :: @Self, id: ExprId, fault: GenFault)
                   Res<(), AllocError> {
        node = self.tree.expr_at(id);
        self.report(node.span.file, node.span, fault)
    }

    types* = (self: @Self) Types { self.check.types }

    world* = (self: @Self) World { self.check.world }

    // -----------------------------------------------------------------
    // the type worklist
    // -----------------------------------------------------------------

    // Is this type already queued? The name is the identity, because
    // the name IS the type: `tcode` is injective, so two types share a
    // name exactly when they are one type.
    type_index* = (self: @Self, name: str) Res<usize> {
        Range(0, self.type_names.len).find((i) {
            self.type_names.get(i).match({
                Ok(s) => s.view().eq(name),
                None  => false,
            })
        })
    }

    queue_type* = (self :: @Self, name: String, id: TyId)
                  Res<(), AllocError> {
        self.type_names.add(name).try();
        self.type_ids.add(id).try();
        self.type_done.add(0).try();
        Ok(());
    }

    type_name_at* = (self: @Self, i: usize) str {
        self.type_names.get(i).match({ Ok(s) => s.view(), None => "" })
    }

    type_id_at* = (self: @Self, i: usize) Res<TyId> { self.type_ids.get(i) }

    is_done* = (self: @Self, i: usize) bool {
        self.type_done.get(i).match({ Ok(n) => n == 1, None => true })
    }

    mark_done* = (self :: @Self, i: usize) Res<(), AllocError> {
        self.type_done.set(i, 1).match({
            None  => Err(AllocError.OutOfMemory),
            Ok(_) => Ok(()),
        })
    }

    // -----------------------------------------------------------------
    // the checked-arithmetic helpers
    // -----------------------------------------------------------------

    // One family per integer type the program actually performs a
    // trapping operation on. A family and not a single helper because
    // the eight are written by one rule and splitting them would make
    // the runtime depend on which operators a program happened to use,
    // which is a lot of conditional emission to save a few lines.
    need_helpers* = (self :: @Self, prim: str) Res<(), AllocError> {
        self.has_helpers(prim).match({
            false => self.add_helpers(prim),
            true  => Ok(()),
        })
    }

    has_helpers = (self: @Self, prim: str) bool {
        Range(0, self.helper_types.len).find((i) {
            self.helper_types.get(i).match({
                Ok(s) => s.view().eq(prim),
                None  => false,
            })
        }).match({ Ok(_) => true, None => false })
    }

    add_helpers = (self :: @Self, prim: str) Res<(), AllocError> {
        owned ::= self.alloc.String().try();
        owned.add_bytes(prim).try();
        self.helper_types.add(owned)
    }

    // -----------------------------------------------------------------
    // the print floor
    // -----------------------------------------------------------------

    need_print* = (self :: @Self) () { self.print_used = true; }

    uses_print* = (self: @Self) bool { self.print_used }

    // -----------------------------------------------------------------
    // the filesystem floor
    // -----------------------------------------------------------------

    need_fs* = (self :: @Self) () { self.fs_used = true; }

    uses_fs* = (self: @Self) bool { self.fs_used }

    // -----------------------------------------------------------------
    // writing a body
    //
    // The buffer is NOT an exported field: `*` on a field means
    // readable outside the module and "mutation only ever goes through
    // exported methods", so these six are that. They also keep the
    // lowering files from knowing that a body is written through an
    // `Emit` at all.
    // -----------------------------------------------------------------

    write* = (self :: @Self, s: str) Res<(), AllocError> { self.buf.bytes(s) }

    writeln* = (self :: @Self, s: str) Res<(), AllocError> { self.buf.say(s) }

    newline* = (self :: @Self) Res<(), AllocError> { self.buf.line() }

    indent* = (self :: @Self) () { self.buf.indent(); }

    dedent* = (self :: @Self) () { self.buf.dedent(); }

    text* = (self: @Self) str { self.buf.view() }

    // A fresh buffer, so each function's body is a function of its own
    // source and of nothing lowered before it.
    open_buf* = (self :: @Self) Res<(), AllocError> {
        self.buf = self.alloc.Emit().try();
        Ok(());
    }

    // -----------------------------------------------------------------
    // the function worklist
    // -----------------------------------------------------------------

    // Queue a function for lowering, once.
    //
    // THE MANGLED SYMBOL IS THE IDENTITY and the qualified name is not,
    // for two reasons that arrived together: `loop` has six declarations
    // under one qualified name and they are six functions, and
    // `Vec<i32>()` and `Vec<str>()` are two emissions of one declaration.
    // The symbol separates both, because it carries the signature and
    // the type arguments — which is the same string the call site just
    // wrote, so a queue hit means the caller is calling something
    // already queued and never something merely named alike.
    need_function* = (self :: @Self, d: Def, inst: Inst, sym: str)
                     Res<(), AllocError> {
        self.seen_function(sym).match({
            false => self.push_function(d, inst, sym),
            true  => Ok(()),
        })
    }

    seen_function = (self: @Self, sym: str) bool {
        Range(0, self.fn_seen.len).find((i) {
            self.fn_seen.get(i).match({
                Ok(s) => s.view().eq(sym),
                None  => false,
            })
        }).match({ Ok(_) => true, None => false })
    }

    // Queue a member function for lowering, once. The same `fn_seen`
    // set as a free function's, because the same rule applies and the
    // two name spaces cannot collide: a method's qualified name has a
    // TYPE where a function's has a module.
    need_method* = (self :: @Self, m: MethodRef, inst: Inst, sym: str)
                   Res<(), AllocError> {
        self.seen_function(sym).match({
            false => self.push_method(m, inst, sym),
            true  => Ok(()),
        })
    }

    push_method = (self :: @Self, m: MethodRef, inst: Inst, sym: str)
                  Res<(), AllocError> {
        self.remember(sym).try();
        self.m_queue.add(m).try();
        self.m_insts.add(inst).try();
        Ok(());
    }

    push_function = (self :: @Self, d: Def, inst: Inst, sym: str)
                    Res<(), AllocError> {
        self.remember(sym).try();
        self.fn_queue.add(d).try();
        self.fn_insts.add(inst).try();
        Ok(());
    }

    remember = (self :: @Self, sym: str) Res<(), AllocError> {
        owned ::= self.alloc.String().try();
        owned.add_bytes(sym).try();
        self.fn_seen.add(owned)
    }

    // What the i-th queued thing is instantiated at. An entry with no
    // row is not generic, which is what an empty `Inst` means.
    queued_inst* = (self: @Self, i: usize) Res<Inst> { self.fn_insts.get(i) }

    queued_m_inst* = (self: @Self, i: usize) Res<Inst> { self.m_insts.get(i) }

    // ENTERING AN INSTANTIATION IS NOT A STACK. A body is lowered to
    // completion before the next queue entry is popped — a call inside
    // it queues rather than recurses — so one field is the whole of the
    // state, and clearing it is what makes a non-generic body see no
    // substitution at all.
    enter_inst* = (self :: @Self, inst: Inst) () { self.inst = inst; }

    // One lowered function: its C name, its prototype and its body,
    // held apart so the three can be emitted in the order C wants and
    // sorted by the one key that is a pure function of the function.
    add_function* = (self :: @Self, name: String, proto: String,
                     body: String) Res<(), AllocError> {
        self.fn_names.add(name).try();
        self.fn_protos.add(proto).try();
        self.fn_bodies.add(body).try();
        Ok(());
    }

    // -----------------------------------------------------------------
    // locals
    //
    // `mark` / `release` rather than a chain of frames, exactly as
    // sema's scope stack is: entering a block records where the stack
    // was, leaving it drops everything added since, and shadowing falls
    // out of walking from the top down.
    // -----------------------------------------------------------------

    mark* = (self: @Self) usize { self.locals.len }

    release* = (self :: @Self, mark: usize) Res<(), AllocError> {
        extra = self.locals.len - mark;
        Range(0, extra).loop((h, i) {
            self.locals.take(self.locals.len - 1);
        });
        Ok(());
    }

    // Introduce a binding, and answer with the number its C name
    // carries. Counting DECLARATIONS rather than nesting depth is what
    // makes the number unique inside the function: two sibling blocks
    // each binding `x` get 1 and 2, and neither can collide with the
    // other's C declaration.
    declare* = (self :: @Self, name: str, ty: TyId, by_ref: bool)
               Res<usize, AllocError> {
        n = self.declared_count(name) + 1;
        owned ::= self.alloc.String().try();
        owned.add_bytes(name).try();
        self.declared.add(owned).try();
        self.locals.add(LocalSlot(name: name, index: n, ty: ty,
                                  by_ref: by_ref, handle: 0,
                                  closure: 0)).try();
        Ok(n);
    }

    // Bind a name to a lambda. Like a handle, it has no C storage: what
    // the name means is a body to inline, and the index is where it is
    // kept.
    declare_closure* = (self :: @Self, name: str, cl: Closure)
                       Res<(), AllocError> {
        self.closures.add(cl).try();
        self.locals.add(LocalSlot(name: name, index: 0,
                                  ty: cl.ret, by_ref: false, handle: 0,
                                  closure: self.closures.len)).try();
        Ok(());
    }

    closure_at* = (self: @Self, i: usize) Res<Closure> {
        self.closures.get(i - 1)
    }

    // -----------------------------------------------------------------
    // rewinding, for an inlined body
    //
    // `release` drops bindings; this MOVES them aside and puts them
    // back. A closure is lowered in the frame it was written in, which
    // is below the callee's own parameters — and those parameters are
    // still live afterwards, so they cannot be dropped.
    // -----------------------------------------------------------------

    detach* = (self :: @Self, mark: usize, saved :: Vec<LocalSlot>)
              Res<(), AllocError> {
        extra = self.locals.len - mark;
        Range(0, extra).loop((h, i) {
            self.locals.take(self.locals.len - 1).match({
                Ok(s) => saved.add(s).try(),
                None  => (),
            });
        });
        Ok(());
    }

    // `saved` came off the top, so it goes back bottom-first.
    reattach* = (self :: @Self, saved: Vec<LocalSlot>) Res<(), AllocError> {
        n = saved.len;
        Range(0, n).loop((h, i) {
            saved.get(n - i - 1).match({
                Ok(s) => self.locals.add(s).try(),
                None  => (),
            });
        });
        Ok(());
    }

    enter_call* = (self :: @Self) () { self.depth = self.depth + 1; }

    leave_call* = (self :: @Self) () { self.depth = self.depth - 1; }

    // Bind `h` to the loop it came from. A handle has no C storage and
    // no declaration is written for it: what the name means is a pair
    // of labels, and `depth` is where to read them.
    declare_handle* = (self :: @Self, name: str, ty: TyId, depth: usize)
                      Res<(), AllocError> {
        self.locals.add(LocalSlot(name: name, index: 0, ty: ty,
                                  by_ref: false, handle: depth,
                                  closure: 0))
    }

    // -----------------------------------------------------------------
    // the loop stack
    //
    // A stack and not a field: `range.loop((h, r) { r.loop((g, c) { .. }) })`
    // has two loops open at once, and `h.break` in the inner body must
    // reach the outer one's labels rather than the innermost.
    // -----------------------------------------------------------------

    push_loop* = (self :: @Self, frame: LoopFrame) Res<(), AllocError> {
        self.loops.add(frame)
    }

    pop_loop* = (self :: @Self) Res<(), AllocError> {
        self.loops.take(self.loops.len - 1).match({
            Ok(_) => Ok(()),
            None  => Err(AllocError.OutOfMemory),
        })
    }

    loop_depth* = (self: @Self) usize { self.loops.len }

    // The frame a handle names. `depth` is 1-based, so it is also the
    // count of loops that were open when the handle was bound.
    loop_frame* = (self: @Self, depth: usize) Res<LoopFrame> {
        self.loops.get(depth - 1)
    }

    declared_count = (self: @Self, name: str) usize {
        n ::= 0;
        self.declared.loop((h, s) {
            s.view().eq(name).then(() { n = n + 1; });
        });
        n
    }

    // The innermost binding of `name`, or nothing. Walks from the top,
    // which is the only thing the ordering of this stack is for.
    slot_of* = (self: @Self, name: str) Res<LocalSlot> {
        n = self.locals.len;
        Range(0, n).find((k) {
            self.locals.get(n - k - 1).match({
                Ok(b) => b.name.eq(name),
                None  => false,
            })
        }).match({
            None  => None,
            Ok(k) => self.locals.get(n - k - 1),
        })
    }

    // Everything a function's frame holds, dropped between functions.
    // The temporary counter is reset here and nowhere else, so a
    // function's temporaries are a function of its own body.
    reset_frame* = (self :: @Self) Res<(), AllocError> {
        self.release(0).try();
        extra = self.declared.len;
        Range(0, extra).loop((h, i) {
            self.declared.take(self.declared.len - 1);
        });
        open = self.loops.len;
        Range(0, open).loop((h, i) {
            self.loops.take(self.loops.len - 1);
        });
        held = self.closures.len;
        Range(0, held).loop((h, i) {
            self.closures.take(self.closures.len - 1);
        });
        self.depth = 0;
        self.tmp = 0;
        Ok(());
    }

    next_tmp* = (self :: @Self) usize {
        self.tmp = self.tmp + 1;
        self.tmp
    }
}

// `alloc.CBackend(tree, check)` — a ufcs function whose first parameter
// is an Alloc, beside the type it builds, exactly as `Vec`, `Map`,
// `Ast`, `Types` and `Checker` are.
CBackend* = (a: Alloc, tree: Ast, check: Checker) Res<CBackend, AllocError> {
    Ok(CBackend(
        tree: tree,
        check: check,
        buf: a.Emit().try(),
        diags: a.Vec<GenDiag>(),
        type_names: a.Vec<String>(),
        type_ids: a.Vec<TyId>(),
        type_done: a.Vec<usize>(),
        helper_types: a.Vec<String>(),
        print_used: false,
        fs_used: false,
        fn_queue: a.Vec<Def>(),
        m_queue: a.Vec<MethodRef>(),
        fn_insts: a.Vec<Inst>(),
        m_insts: a.Vec<Inst>(),
        inst: a.Inst(),
        fn_seen: a.Vec<String>(),
        fn_names: a.Vec<String>(),
        fn_protos: a.Vec<String>(),
        fn_bodies: a.Vec<String>(),
        locals: a.Vec<LocalSlot>(),
        declared: a.Vec<String>(),
        loops: a.Vec<LoopFrame>(),
        closures: a.Vec<Closure>(),
        depth: 0,
        tmp: 0,
        alloc: a,
    ));
}

// -----------------------------------------------------------------
// reporting, with something to emit while reporting
//
// Four shapes, and each one writes `0` into the caller's buffer so the
// emitted C still parses around the diagnostic. They live beside
// `report` rather than in a lowering file because all four lowering
// files raise all four, and a helper with a caller in three modules
// belongs below them.
// -----------------------------------------------------------------

// A node form this backend does not lower yet.
unsupported* = (be :: CBackend, id: ExprId, what: str, out :: String)
               Res<(), AllocError> {
    be.report_expr(id, GenFault.Unsupported(what)).try();
    out.add_bytes("0")
}

// A name with no declaration behind it.
unresolved* = (be :: CBackend, id: ExprId, name: str, out :: String)
              Res<(), AllocError> {
    be.report_expr(id, GenFault.Unresolved(name)).try();
    out.add_bytes("0")
}

// Sema had no type and the context supplied none.
untyped* = (be :: CBackend, id: ExprId, what: str, out :: String)
           Res<(), AllocError> {
    be.report_expr(id, GenFault.Untyped(what)).try();
    out.add_bytes("0")
}

// A name with more than one declaration, and no overload rule to
// choose between them.
ambiguous* = (be :: CBackend, id: ExprId, name: str, out :: String)
             Res<(), AllocError> {
    be.report_expr(id, GenFault.Ambiguous(name)).try();
    out.add_bytes("0")
}
