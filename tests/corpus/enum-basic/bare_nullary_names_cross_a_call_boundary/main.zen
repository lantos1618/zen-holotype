// BARE NULLARY NAMES IN EXPRESSION POSITION, INSIDE A CALLEE, PICKED AT
// RUNTIME. `Zebra` never names its enum: sema must reach the enclosing
// function's RESULT type and gen_c must emit THAT enum's tag constant --
// the two halves ask the same table separately, and nothing ties the
// answers together (codegen/bare_variant_picks_its_own_enum pins the
// shared-name case; this pins the ordinary one, where only the result
// type says which enum was meant).
//
// A lazy lowering -- name not locally bound, assume a variant, emit tag
// 0 -- is valid C and answers "got zebra" for EVERY call. Only lookup
// through the result type puts yonder and apple where they belong, and
// all three indices are asked for through a nested bool-match so no
// construction site sits at index 0 by luck.

Word = Zebra | Yonder | Apple

pick = (n: i64) Word {
    (n == 0).match({
        true  => Zebra,
        false => (n == 1).match({
            true  => Yonder,
            false => Apple,
        }),
    })
}

main = (env: Env) Res<i32, AllocError> {
    pick(0).match({
        Zebra  => println("got zebra"),
        Yonder => println("got yonder"),
        Apple  => println("got apple"),
    });
    pick(1).match({
        Zebra  => println("got zebra"),
        Yonder => println("got yonder"),
        Apple  => println("got apple"),
    });
    pick(2).match({
        Zebra  => println("got zebra"),
        Yonder => println("got yonder"),
        Apple  => println("got apple"),
    });
    Ok(0);
}
