// The unit is not part of a Duration. `seconds(60)` and
// `minutes(1)` are the SAME VALUE, which is the whole argument for
// five constructors over an enum: as variants they would be two
// values that must compare equal, and every operation would begin by
// normalising to the representation this struct simply has.
Duration, seconds, minutes, millis, micros, nanos = std.core.time
Unit, unit_of, count_in, suffix = std.core.time
millis_of, seconds_of, nanos_of = std.core.time

main = (env: Env) Res<i32, ArgError> {
    a = seconds(60);
    b = minutes(1);
    println("{}", a.ns == b.ns);

    // one accessor per constructor, and they truncate
    d = millis(1500);
    println("{}", d.seconds_of());
    println("{}", d.millis_of());
    println("{}", micros(1500).millis_of());

    // ufcs: the constructor travels with u64, its first parameter
    n: u64 = 2;
    println("{}", n.seconds().nanos_of());

    // sub is a Res because a Duration is unsigned: a shorter span
    // minus a longer one has no answer, and that is an absence
    seconds(1).sub(seconds(3)).match({
        Ok(_) => println("negative"),
        None  => println("no answer"),
    });
    // and the unit IS an enum -- where the distinction survives, which
    // is at display time: a caller matches on `unit_of` to pick a
    // suffix, and nothing had to store it
    show(d);
    show(seconds(90));
    show(nanos(5));
    Ok(0);
}

show = (self: Duration) () {
    u = self.unit_of();
    println("{}{}", self.count_in(u), suffix(u));
}
