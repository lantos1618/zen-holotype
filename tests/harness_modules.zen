                    src: "s = std.text.str\nmain = () i32 {\n  name := \"hello\"\n  name.eq(\"hello\").match ({ true => to_i32(name.len()), false => 0 })\n}\n",
                ),
            ],
            entry: "p.zen",
            want: 5,
        ),
        ModValCase(
