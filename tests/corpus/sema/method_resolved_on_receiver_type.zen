// a method is resolved on its RECEIVER's type, never by name across the
// program. two unrelated types declare `size`, and each call gets its
// own -- the other one is not a candidate and never was.

Box = {
    w: i32,
    size = (self: @Self) i32 { self.w * self.w }
}

Bag = {
    n: i32,
    size = (self: @Self) str { "bag" }
}

main = (env: Env) Res<i32, AllocError> {
    b = Box(w: 3);
    g = Bag(n: 7);
    println("{}", b.size());
    println("{}", g.size());
    Ok(0);
}
