// the same escape through a construction at the tail: `s` names the
// block, and `Holder(s: s)` hands the block to a value whose type
// carries it out. The field now outlives the frame it points into.

Holder = {
    s: Scope,
}

make = () Holder {
    s = @scope;
    Holder(s: s)
}

main = (env: Env) Res<i32, IoError> {
    h = make();
    Ok(0);
}
