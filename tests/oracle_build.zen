    ), DiagCase(
        src: "f = () i32 { \"hi\" }\nmain = () i32 { 0 }\n",
        wants: [":1:14: error[return-fit]: expected `i32`, got `str`", "  f = () i32 { \"hi\" }", "               ^~~~", "hint: make the returned value fit the function's declared return type"],
    ), DiagCase(
