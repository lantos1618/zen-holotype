// the trap check must run on EVERY iteration's divisor, not just the
// first. a lowering that hoists the zero-test out of the loop body (or
// emits it once for a loop-invariant divisor) lets iteration 2 kill
// the process with a raw SIGFPE instead of Zen's trap line.
//
// the divisors come from an array indexed by the loop variable, so no
// two iterations share a value and none is a compile-time constant:
// iteration 1 divides 42 by 6 and prints, iteration 2 divides 7 by 0
// and traps -- with `q 7` printed exactly once and exit 134.
//
// `println` inside the loop body also pins that stdout before a trap
// survives.

Error = Overflow | DivideByZero | OutOfBounds

main = (env: Env) Res<i32, Error> {
    ds = [i32, 2](6, 0);
    ns = [i32, 2](42, 7);

    Range(0, 2).loop((h, i) {
        q = ns[i] / ds[i];
        println("q {}", q);
    });

    Ok(0);
}
