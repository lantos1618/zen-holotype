// tests/corpus/loop-basic/vec_walk_hands_out_insertion_order_elements/
// a Vec satisfies Range by SUPPLYING start 0 and end self.len, not
// storing them, and the walk must read through the same bounds check
// `get` answers through - the element handed to the body comes from
// the buffer, the index from the pass counter. i64 payloads catch a
// word-wide slot; str payloads catch pointer lifetimes; the count
// after each walk catches a dropped or duplicated pass

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();

    // insertion order, no index: ada grace alan
    names ::= alloc.Vec<str>();
    names.add("ada").try();
    names.add("grace").try();
    names.add("alan").try();
    n ::= 0;
    names.loop((h, name) {
        println("{}", name);
        n = n + 1;
    });
    println("count {}", n);

    // with index, over i64s that punish a narrow element slot
    nums ::= alloc.Vec<i64>();
    nums.add(9000000000).try();
    nums.add(-7).try();
    m ::= 0;
    nums.loop((h, index, value) {
        println("{} {}", index, value);
        m = m + index + 1;
    });
    println("passes {}", m);
    Ok(0);
}
