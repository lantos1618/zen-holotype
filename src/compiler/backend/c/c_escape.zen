// compiler.backend.c.c_escape — per-slice-literal ESCAPE classification for gen_slicelit.
//
// A bare C compound literal `(T[]){…}` has AUTOMATIC storage, so a slice literal whose `.ptr` outlives
// the frame must be heap-promoted (see gen_slicelit). This module proves the opposite for ONE literal
// shape — the single most common one in the language — so those literals can stay on the stack:
//
//     f(…, [a, b, c], …)      where f only BORROWS the matching parameter
//
// C gives a compound literal written in an argument the lifetime of the ENCLOSING BLOCK, which always
// outlives the call itself. So the only way such a literal can dangle is the CALLEE keeping the slice
// past its own frame. A parameter is BORROWED when the callee's body uses it in exactly four ways:
//   `p.len`      — reads the length
//   `p[i]`       — reads/writes an element (elements are copied out; the backing address is not)
//   `p.loop(…)`  — iterates it
//   `g(…, p, …)` — hands it to a callee that itself only borrows that parameter (bounded hops)
// Anything else — bound to a local, returned, stored into a struct/slice/enum, reassigned, passed to an
// unknown or foreign callee, or reached through `p.ptr` / `p[i].addr()` — is a RETAIN.
//
// HEAP-BY-DEFAULT is the law here. Every question this analysis cannot answer answers "retains", so a
// misclassification is a leak, never a use-after-free: an unknown callee retains, an out-of-range
// parameter index retains, recursion past the depth bound retains, and an unset table (a module that
// never ran slx_classify) reports every literal as escaping.
//
// The verdict table is a module GLOBAL (the same shape resolve_ffi uses for its grants) because the C
// emitters thread only an allocator: gen_expr has no `decls` to consult. genModuleIn stamps it from the
// MONOMORPHIZED decls — after inlining, so every call the emitter will see is the call analysed here.
{ Decl, Expr, Func, Stmt, CallData, Ty } = compiler.ast.ast_types
{ expr_fold_children } = compiler.ast.expr_children
{ slice_any } = compiler.astops
{ Malloc } = std.mem.alloc
{ Map, of } = std.collections.map
// One function's borrowed-parameter set: bit `i` is set when parameter `i` is provably borrowed.
SlxMask*: {
    fn: string_view,
    mask: i64,
}
slx_no_masks = () [SlxMask] { slice(null_ptr(), 0) }
slx_masks := slx_no_masks()
slx_masks_set = (xs: [SlxMask]) void { slx_masks = xs }
// how many interprocedural hops a parameter may be threaded through before the analysis gives up (and
// answers "retains"). Bounded so self- and mutual recursion terminate.
slx_depth = () i32 { 4 }
// THE emitter query: may the slice literal at argument `pi` of a call to `fn` live on the stack?
// Unset table / unknown fn / any bit not proven → false → gen_slicelit heap-promotes as before.
slx_arg_is_borrowed* = (fn: string_view, pi: i32) bool {
    slx_masks.slice_any((k) { k.fn == fn && k.mask.slx_bit(pi) })
}
slx_bit = (mask: i64, pi: i32) bool {
    (pi >= 0 && pi < 63).then({ mask >> to_i64(pi) & 1 == 1 }, { false })
}
slx_is_var = (e: Ptr<Expr>, nm: string_view) bool {
    load(e).match ({
        .Var(v) => v.name == nm,
        _       => false,
    })
}
slx_is_slice = (t: Ty) bool {
    t.match ({
        .Slice(el) => true,
        _          => false,
    })
}
// Does `nm` escape anywhere in `e`? A bare `.Var(nm)` in ANY position this file has not explicitly
// whitelisted is a retain, so an Expr variant nobody thought about cannot silently read as a borrow:
// the `_` arm delegates to compiler.ast.expr_children's one exhaustive child listing.
slx_expr_retains = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    fidx: Map<i64>,
    e: Ptr<Expr>,
    nm: string_view,
    depth: i32,
) bool {
    load(e).match ({
        .Var(v)    => v.name == nm,
        // `nm.len` is a borrow; `nm.ptr` (or any other field) hands out the backing address.
        .Member(m) => (m.obj.slx_is_var(nm) && m.field == "len").match ({
            true  => false,
            false => a.slx_expr_retains(decls, fidx, m.obj, nm, depth),
        }),
        .Index(ix) => a.slx_expr_retains(decls, fidx, ix.idx, nm, depth)
            || ix.seq.slx_is_var(nm) == false && a.slx_expr_retains(decls, fidx, ix.seq, nm, depth),
        .Loop(l)   => a.slx_body_retains(decls, fidx, l.body, nm, depth)
            || l.seq.slx_is_var(nm) == false && a.slx_expr_retains(decls, fidx, l.seq, nm, depth),
        .Call(c)   => a.slx_call_retains(decls, fidx, c, nm, depth),
        _          => false.expr_fold_children(e, (acc, ch) {
            acc || a.slx_expr_retains(decls, fidx, ch, nm, depth)
        }, (acc, body) { acc || a.slx_body_retains(decls, fidx, body, nm, depth) }),
    })
}
// `nm` as a bare argument is a borrow only when the callee borrows that parameter (one bounded hop);
// `nm` as the CALLEE is the binding invoked, which this analysis does not model → retain.
// `addr` is the ONE intrinsic that turns a borrow back into the backing address: `nm[i].addr()` reads as
// an element access above, but the pointer it yields points INTO the literal's storage, so ANY mention of
// `nm` under an `addr` is a retain.
slx_call_retains = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    fidx: Map<i64>,
    c: CallData,
    nm: string_view,
    depth: i32,
) bool {
    (c.fn == "addr").match ({
        true  => c.args.slx_mentions_args(nm),
        false => {
            r := c.fn == nm
            c.args.loop((h, j, arg) {
                r = r
                    || arg.addr().slx_is_var(nm).match ({
                        true  => a.slx_param_retains(decls, fidx, c.fn, j, depth - 1),
                        false => a.slx_expr_retains(decls, fidx, arg.addr(), nm, depth),
                    })
            })
            r
        },
    })
}
// does `nm` appear ANYWHERE under `e`? The whitelist-free companion of slx_expr_retains, for positions
// where no use of the binding is a borrow.
slx_mentions_e = (e: Ptr<Expr>, nm: string_view) bool {
    load(e).match ({
        .Var(v) => v.name == nm,
        _       => false.expr_fold_children(e, (acc, ch) { acc || ch.slx_mentions_e(nm) }, (acc, body) {
            acc || body.slx_mentions_body(nm)
        }),
    })
}
slx_mentions_args = (args: [Expr], nm: string_view) bool {
    args.slice_any((x) { x.addr().slx_mentions_e(nm) })
}
slx_mentions_body = (body: [Stmt], nm: string_view) bool {
    body.slice_any((st) { st.slx_mentions_st(nm) })
}
slx_mentions_st = (st: Stmt, nm: string_view) bool {
    st.match ({
        .Let(l)      => l.value.slx_mentions_e(nm),
        .Assign(x)   => x.target.slx_mentions_e(nm) || x.value.slx_mentions_e(nm),
        .Return(r)   => r.slx_mentions_e(nm),
        .ExprStmt(e) => e.slx_mentions_e(nm),
        .If(f)       => f.c.slx_mentions_e(nm)
            || f.then.slx_mentions_body(nm)
            || f.els.slx_mentions_body(nm),
        .While(w)    => w.c.slx_mentions_e(nm) || w.body.slx_mentions_body(nm),
        .IndexSet(x) => x.seq.slx_mentions_e(nm)
            || x.idx.slx_mentions_e(nm)
            || x.value.slx_mentions_e(nm),
    })
}
// Does the KNOWN local fn `fn` retain its parameter `pi` past its own frame? An unknown name (an
// intrinsic, a foreign decl, a call through a value) is not analysable → retains.
slx_param_retains = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    fidx: Map<i64>,
    fn: string_view,
    pi: i32,
    depth: i32,
) bool {
    (depth <= 0).match ({
        true  => true,
        false => {
            j := fidx.get(fn, to_i64(0) - 1)
            (j < 0).match ({
                true  => true,
                false => decls[j].match ({
                    .DFunc(f) => (pi >= 0 && pi < f.params.len).match ({
                        true  => a.slx_body_retains(decls, fidx, f.body, f.params[pi].name, depth),
                        false => true,
                    }),
                    _         => true,
                }),
            })
        },
    })
}
slx_body_retains = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    fidx: Map<i64>,
    body: [Stmt],
    nm: string_view,
    depth: i32,
) bool { body.slice_any((st) { a.slx_stmt_retains(decls, fidx, st, nm, depth) }) }
// `nm[i] = v` writes THROUGH the slice into the caller's own backing store — a borrow, like `nm[i]`.
// An assignment whose TARGET is `nm` rebinds the parameter; that is left as a retain (conservative).
slx_stmt_retains = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    fidx: Map<i64>,
    st: Stmt,
    nm: string_view,
    depth: i32,
) bool {
    st.match ({
        .Let(l)      => a.slx_expr_retains(decls, fidx, l.value, nm, depth),
        .Assign(x)   => a.slx_expr_retains(decls, fidx, x.target, nm, depth)
            || a.slx_expr_retains(decls, fidx, x.value, nm, depth),
        .Return(r)   => a.slx_expr_retains(decls, fidx, r, nm, depth),
        .ExprStmt(e) => a.slx_expr_retains(decls, fidx, e, nm, depth),
        .If(f)       => a.slx_expr_retains(decls, fidx, f.c, nm, depth)
            || a.slx_body_retains(decls, fidx, f.then, nm, depth)
            || a.slx_body_retains(decls, fidx, f.els, nm, depth),
        .While(w)    => a.slx_expr_retains(decls, fidx, w.c, nm, depth)
            || a.slx_body_retains(decls, fidx, w.body, nm, depth),
        .IndexSet(x) => a.slx_expr_retains(decls, fidx, x.idx, nm, depth)
            || a.slx_expr_retains(decls, fidx, x.value, nm, depth)
            || x.seq.slx_is_var(nm) == false && a.slx_expr_retains(decls, fidx, x.seq, nm, depth),
    })
}
slx_has_slice_param = (f: Func) bool { f.params.slice_any((p) { p.ty.slx_is_slice() }) }
// the borrowed-parameter bitmask of one function. `bit` doubles per parameter, so a function with more
// than 63 parameters simply stops setting bits (bit overflows to 0 under -fwrapv) — heap, as always.
slx_fn_mask = (a: MutPtr<Malloc>, decls: [Decl], fidx: Map<i64>, f: Func) i64 {
    mask := to_i64(0)
    bit := to_i64(1)
    f.params.loop((h, j, p) {
        (bit > 0
            && p.ty.slx_is_slice()
            && a.slx_body_retains(decls, fidx, f.body, p.name, slx_depth()) == false).then({
            mask = mask | bit
        })
        bit = bit * 2
    })
    mask
}
slx_fn_index = (a: MutPtr<Malloc>, decls: [Decl]) Map<i64> {
    m := of(a, "", to_i64(0) - 1).expect("c_escape: fn-index alloc")
    decls.loop((h, i, d) {
        d.match ({
            .DFunc(f) => {
                m = m.put(a, f.name, to_i64(i)).expect("c_escape: fn-index alloc")
            },
            _         => { },
        })
    })
    m
}
slx_mask_count = (decls: [Decl]) i64 {
    n := to_i64(0)
    decls.loop((h, i, d) {
        d.match ({
            .DFunc(f) => f.slx_has_slice_param().then({
                n = n + 1
            }),
            _         => { },
        })
    })
    n
}
slx_mask_buf = (a: MutPtr<Malloc>, n: i64) [SlxMask] { slice(a.acquire(n * sizeof(SlxMask)), n) }
// Stamp the verdict table for one translation unit. Only functions that actually take a slice are
// walked, so a module with no slice parameters costs one decl sweep and nothing else.
slx_classify* = (a: MutPtr<Malloc>, decls: [Decl]) void {
    n := decls.slx_mask_count()
    (n == 0).match ({
        true  => slx_masks_set(slx_no_masks()),
        false => {
            xs := a.slx_mask_buf(n)
            fidx := a.slx_fn_index(decls)
            k := to_i64(0)
            decls.loop((h, i, d) {
                d.match ({
                    .DFunc(f) => f.slx_has_slice_param().then({
                        xs[k] = SlxMask(
                            fn: f.name,
                            mask: a.slx_fn_mask(decls, fidx, f),
                        )
                        k = k + 1
                    }),
                    _         => { },
                })
            })
            slx_masks_set(xs)
        },
    })
}
