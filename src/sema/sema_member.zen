// src/sema/sema_member.zen
// What a dot reaches, and what an impl owes.
//
// DESIGN.md: "there are no traits, only structs. A struct whose fields
// happen to be functions, used as a bound, is what other languages call
// a trait." So one member lookup serves a field, a constant and a method
// alike, and a rule limiting bounds to structs-of-functions would reject
// DESIGN.md's own `Rect` impl — two `f64` fields and one method.
//
// YOU SATISFY REQUIREMENTS; YOU NEVER IMPL STORAGE. A field the type
// declares is storage; a field an impl supplies is COMPUTED — re-evaluated
// on read, read-only, non-addressable, invisible to layout. `Found.computed`
// carries this, and the type's own member always wins over an impl's,
// since layout is fixed at declaration regardless of which impls link in.
//
// Covers three sources — the type's own body, its impls, and a type
// parameter's bounds — compared by one selection rule against one
// `Found` shape. `sema_bound.zen` covers the different question "what an
// impl OWES"; `sema_static.zen` covers `Type.NAME`, which has no
// receiver, impl or bound.
//
// THE BOUND IN SCOPE SELECTS, NEVER FILE ORDER: two impls supplying one
// name is an error unless a generic in scope declares one of the two
// bounds (`Checker.bounds`). With nothing in scope, the diagnostic names
// BOTH impls, not just one side.

Expr, ExprId, Access, Span, TypeId, nowhere = std.ast
Struct, Member = std.ast
Field, Const, Function = std.ast
AllocError = std.mem
Vec = std.collections
str = std.text
DeclId = sema.sema_id
TyId, TyNamed, Prim = sema.sema_ty
Def, DefKind, decl_at, module_display = sema.sema_def
SemaFault, TypeFault, PairFault = sema.sema_diag
ExportFault = sema.sema_diag
Checker, Ctx, Binding = sema.sema_check
Inst, subst, inst_of_named, owner_of, push_tparams = sema.sema_inst
is_prim = sema.sema_ty
impl_members, bound_member_types = sema.sema_supply
type_of = sema.sema_type
type_from_ast, param_type = sema.sema_denote
global_name_type, def_type = sema.sema_type
static_value = sema.sema_static
meta_access, meta_len_chain, is_count_chain = sema.sema_meta
meta_name_fold, meta_refused, walk_name, WalkName = sema.sema_meta

// One thing a dot could reach. `computed`: false means the type declares
// it (has an address); true means an impl supplies it (does not).
// `exported`/`module` are law 6, carried rather than decided here since
// `members_of` takes a type and a name, not a `Ctx` — the star is a fact
// about the declaration, and both travel to the access site to be judged.
// `constant`: the member is a struct-body Const (R4's `name: T = value`),
// one value per type rather than storage per instance — a construction
// names fields, so this bit is what lets one refuse to supply one.
Found* = {
    name*: str,
    ty*: TyId,
    computed*: bool,
    constant*: bool,
    mutable*: bool,
    exported*: bool,  // `*` on the member itself
    module*: usize,   // the module that DECLARES it, never the one importing
    bound*: TyId,   // the bound that supplies it; poison when the type owns it
    span*: Span,    // the declaration, or the impl — where the fix goes
}

// What a base expression denotes: a TYPE (`i32.MAX`, `Shape.Unit`) or a
// VALUE (`p.x`) — reads the same, means different things, and only
// resolution can tell them apart.
Base* = {
    ty*: TyId,
    is_type*: bool,
}

// ---------------------------------------------------------------------
// QUERY: the type of `base.name`
// ---------------------------------------------------------------------

// A `@meta` target is no member lookup: the whole access is the
// comptime evaluator's question (`sema_meta.zen`), answered under the
// written type the `Meta` node carries. Intercepted here rather than
// in `expr_kind` because this is where the access is typed.
access_type* = (c :: Checker, id: ExprId, node: Expr, ac: Access, ctx: Ctx)
               Res<TyId, AllocError> {
    c.tree.expr_at(ac.base).kind.match({
        Meta(_) => c.meta_access(ac, ctx),
        // A WALK BINDER AS THE BASE (`sema_meta.zen`): `field.name` is
        // the walk's one folding access, and every other reading of
        // either binder — `field.len`, `h.break` standing as a value —
        // is the comptime term asked for a member it does not have.
        // A name that is nobody's binder takes the ordinary path.
        Name(n) => c.walk_name(n.text).match({
            WalkNone   => c.member_access(id, node, ac, ctx),
            WalkHandle => c.meta_refused(node),
            WalkField  => c.meta_name_fold(id, node, ac),
        }),
        _       => c.member_access(id, node, ac, ctx),
    })
}

member_access = (c :: Checker, id: ExprId, node: Expr, ac: Access, ctx: Ctx)
                Res<TyId, AllocError> {
    // THE COUNT'S CHAIN, SEEN FROM ITS TOP: `.len` is an Access whose
    // base is a Call whose callee is an Access whose base is a Meta —
    // `@meta(T).fields().len`. Decided HERE and ANSWERED HERE, before
    // anything types the call beneath it: the ordinary path would call
    // `base_of` on the Call, whose Meta-based callee is the wall
    // (`sema_call.member_call` refuses it), so the one shape this slice
    // lifts out of the wall would meet its own refusal instead of its
    // number. Every OTHER `.len` — on a Vec, a str, an array — misses
    // the strict three-level shape and takes the ordinary path below,
    // untouched.
    c.is_count_chain(ac).match({
        true  => c.meta_len_chain(ac, ctx),
        false => {
            b = base_of(c, ac.base, ctx).try();
            b.is_type.match({
                true  => c.static_value(id, node, ac, b.ty, ctx),
                false => c.value_access(id, node, ac, b.ty, ctx),
            })
        },
    })
}

// A bare name that resolves to a declaration — or to a primitive — is
// the type itself. A local binding shadows it, because a local always
// shadows everything: `str` the parameter is not `str` the type.
base_of* = (c :: Checker, id: ExprId, ctx: Ctx) Res<Base, AllocError> {
    node = c.tree.expr_at(id);
    node.kind.match({
        Name(n) => c.named_base(id, node, n.text, ctx),
        _       => c.value_base(id, ctx),
    })
}

value_base = (c :: Checker, id: ExprId, ctx: Ctx) Res<Base, AllocError> {
    ty = c.type_of(id, ctx).try();
    Ok(Base(ty: ty, is_type: false));
}

// A name base is typed here because it's the one base `type_of` never
// memoizes: a name is answered straight out of scope, so `p` in `p.left`
// was typed and never recorded, leaving a hover on the receiver of a
// field access with no answer for a node sema knew the type of. A type
// name still gets no entry — `i32` in `i32.MAX` denotes no value, and a
// wrong answer is worse than no answer (same rule `write_val` states).
named_base = (c :: Checker, id: ExprId, node: Expr, text: str, ctx: Ctx)
             Res<Base, AllocError> {
    b = c.lookup(text).match({
        None  => c.global_base(node, text, ctx),
        Ok(l) => c.bound_base(id, l),
    }).try();
    b.is_type.match({
        false => c.expr_memo.set(id, b.ty),
        true  => Ok(()),
    }).try();
    Ok(b);
}

// A base answered out of the scope stack — `p` in `p.left`. Same
// recording as `sema_type.bound_name_type`: a parameter use is noted
// so the LSP can paint it one once the scope is gone.
bound_base = (c :: Checker, id: ExprId, b: Binding) Res<Base, AllocError> {
    b.param.match({
        true  => c.param_memo.set(id, true),
        false => Ok(()),
    }).try();
    Ok(Base(ty: b.ty, is_type: false));
}

global_base = (c :: Checker, node: Expr, text: str, ctx: Ctx)
              Res<Base, AllocError> {
    is_prim(text).match({
        true  => {
            ty = c.types.prim(text).try();
            Ok(Base(ty: ty, is_type: true));
        },
        false => c.decl_base(node, text, ctx),
    })
}

decl_base = (c :: Checker, node: Expr, text: str, ctx: Ctx)
            Res<Base, AllocError> {
    found ::= c.alloc.Vec<Def>();
    c.world.defs_of(ctx.module, text, found).try();
    found.get(0).match({
        // Through `def_type` and not `named` directly, so a constant
        // used as a base reads its DECLARED type: `PATH.len` is a
        // `str`'s `len`, and a nominal type called `PATH` has no
        // members at all.
        Ok(d) => {
            ty = c.def_type(d).try();
            Ok(Base(ty: ty, is_type: is_type_def(d.kind)));
        },
        // A name that resolves to nothing at all is left to `type_of`,
        // the one place "undefined name" is raised. Two places raising
        // it is two diagnostics for one mistake.
        None  => {
            ty = c.global_name_type(node, text, ctx).try();
            Ok(Base(ty: ty, is_type: false));
        },
    })
}

is_type_def* = (k: DefKind) bool {
    k.match({ StructDef => true, EnumDef => true, AliasDef => true, _ => false })
}

// ---------------------------------------------------------------------
// `value.name`
// ---------------------------------------------------------------------

value_access* = (
    c    :: Checker,
    id   : ExprId,
    node : Expr,
    ac   : Access,
    ty   : TyId,
    ctx  : Ctx
) Res<TyId, AllocError> {
    c.opaque(ty).match({
        true  => c.types.unknown(),
        false => c.known_access(id, node, ac, ty, ctx),
    })
}

opaque* = (c: Checker, ty: TyId) bool {
    c.is_unknown(ty) || c.is_infer(ty) || c.foreign_tvar(ty)
}

// A type parameter that is nobody's here: `Vec`'s own `T`, arriving on a
// value because the call that produced it did not SUBSTITUTE (not this
// function's `T` — `TyVar` is nominal on its owner). Checks both: an
// enclosing `<T>` with no bound reaches no members, while a `T: Boxy`
// reaches `Boxy`'s members regardless of whether the parameter was
// pushed — that case is `bound_reachable`'s.
foreign_tvar = (c: Checker, ty: TyId) bool {
    c.types.at(ty).match({
        Var(v) => c.in_scope_tvar(v.name, ty) == false,
        _      => false,
    })
}

// Declared as a type parameter, or declared with a bound — either puts
// it in scope. The bound alone is enough, and it's the case that
// matters: `bound_reachable` reads bounds and nothing else, so a
// constrained `T` has members to find — calling it foreign would silence
// the diagnostic the bound exists to make possible.
in_scope_tvar = (c: Checker, name: str, ty: TyId) bool {
    c.is_bounded(name)
        || c.lookup_tvar(name).match({ Ok(b) => b.ty.eq(ty), None => false })
}

// Law 6 reaches members too: `*` means the name crosses a module
// boundary. Checked BEFORE `pick`, not inside it: a member the asking
// module can't see isn't a candidate at all, and the mistake is at the
// dot — skipping this lets `pick` fall through to `ufcs_or_missing` and
// falsely claim the field doesn't exist. Compares against `Found.module`,
// the DECLARING module, never the importing one, so an import can't
// launder a name past the star by spelling (`zz = vec`, `Vec = vec.vec`).
known_access = (
    c    :: Checker,
    id   : ExprId,
    node : Expr,
    ac   : Access,
    ty   : TyId,
    ctx  : Ctx
) Res<TyId, AllocError> {
    found ::= c.alloc.Vec<Found>();
    c.members_of(ty, ac.name.text, found).try();
    first_hidden(found, ctx.module).match({
        Ok(f) => c.hidden_member(ac, f),
        None  => pick(c, id, node, ac, ty, found, ctx),
    })
}

// The first member of the set the asking module may not see. A struct
// declares a name once, so a set from the type's own body has at most
// one element and "first" is "the one"; a set from impls is all-computed
// and never hidden. Exported because `members_of` has two consumers — a
// call resolves its own callee in `sema_call.zen` — and gating only the
// one this file owns once made `v.grow` a mistake and `v.grow()` legal.
first_hidden* = (found: Vec<Found>, mi: usize) Res<Found> {
    found.find((f) { hidden_from(f, mi) })
}

// Inside the declaring module every member is reachable — that is what
// makes `self.grow()` legal in `vec.zen` and `v.grow()` not.
hidden_from = (f: Found, mi: usize) bool {
    (f.exported == false) && (f.module != mi)
}

hidden_member* = (c :: Checker, ac: Access, f: Found) Res<TyId, AllocError> {
    c.report(
        ac.name.span.file,
        ac.name.span,
        SemaFault.NotExported(ExportFault(
            name: ac.name.text,
            module: c.module_of(f)
        ))
    ).try();
    c.types.unknown()
}

// The name a reader wrote, not the path the compiler walked:
// `module_display` collapses `vec.vec` back to the `vec` in the import.
module_of = (c :: Checker, f: Found) str {
    c.world.table_at(f.module).match({
        Ok(t) => module_display(t.name),
        None  => "",
    })
}

pick = (
    c     :: Checker,
    id    : ExprId,
    node  : Expr,
    ac    : Access,
    ty    : TyId,
    found : Vec<Found>,
    ctx   : Ctx
) Res<TyId, AllocError> {
    found.len.match({
        0 => c.ufcs_or_missing(node, ac, ty, ctx),
        1 => c.first_type(id, ty, found),
        _ => c.select(id, node, ac, ty, found),
    })
}

// The one place a member is settled, and so the one place the answer is
// written down — monomorphisation replaces `T` with the concrete type,
// and by then nothing says which impl was in view.
//
// A METHOD IS NOT THE VALUE ITS RETURN TYPE WOULD BE. `found.ty` of a
// method is `Fn(..)`, and every position past this point — an argument
// slot, an operand, a print hole — asks only whether that type fits, so
// handing it on let `Range(0, s.len)` reach gen_c and emit C reading
// `.len` off a struct that has no such member. The access is refused
// here, at the dot where the missing call is.
first_type = (c :: Checker, id: ExprId, ty: TyId, found: Vec<Found>)
             Res<TyId, AllocError> {
    found.get(0).match({
        None  => c.types.unknown(),
        Ok(f) => settled(c, id, ty, f),
    })
}

// The bound that promised it, or the receiver when the receiver's own
// declaration carries it: `Boxy.area` reads `self.width` off `Boxy` and
// EMITS at a `Tile` two impls supply a `width` for — `Boxy` picks.
settled = (c :: Checker, id: ExprId, ty: TyId, f: Found)
          Res<TyId, AllocError> {
    from = c.is_unknown(f.bound).match({ true => ty, false => f.bound });
    c.supply_memo.set(id, from).try();
    c.types.at(f.ty).match({
        Fn(_) => c.callee_access.get(id).match({
            Ok(true) => Ok(f.ty),
            _        => c.method_not_value(id, f.ty),
        }),
        _     => Ok(f.ty),
    })
}

// Two impls supply this name. The bound in scope selects; with none, it
// is an error naming both, never file order.
select = (
    c     :: Checker,
    id    : ExprId,
    node  : Expr,
    ac    : Access,
    ty    : TyId,
    found : Vec<Found>
) Res<TyId, AllocError> {
    kept ::= c.alloc.Vec<Found>();
    found.loop((h, f) {
        c.has_bound(f.bound).match({ true => kept.add(f), false => Ok(()) }).try();
    });
    kept.len.match({
        1 => c.first_type(id, ty, kept),
        _ => ambiguous(c, node, ac, found),
    })
}

ambiguous = (c :: Checker, node: Expr, ac: Access, found: Vec<Found>)
            Res<TyId, AllocError> {
    first  = span_of(found, 0);
    second = span_of(found, 1);
    c.report(
        ac.name.span.file,
        ac.name.span,
        SemaFault.AmbiguousMember(PairFault(
            name: ac.name.text,
            first: first,
            second: second
        ))
    ).try();
    c.types.unknown()
}

span_of = (found: Vec<Found>, i: usize) Span {
    found.get(i).match({ Ok(f) => f.span, None => nowhere() })
}

// "Importing a type pulls its world along: its methods, its trait impls,
// and exported ufcs functions" (a free function whose first param is the
// type, callable as a method). So a name the type doesn't declare is
// still reachable if a function of that name exists — resolution happens
// at the CALL, where the argument list is known.
//
// A MEMBER THE TYPE DOES DECLARE IS NOT A VALUE WHEN IT IS A METHOD. The
// lookup answers `Fn(..)` for one — `String.len` is `(String) usize` —
// and that answer flowed into every position that asks nothing but "does
// it fit": an argument slot (`Range(0, s.len)`) and an operator's
// operands took a bare method as if it were the number it returns, and
// gen_c emitted C reading a struct member that does not exist. A method
// is read only through its call, so `pick` refuses the access here —
// naming the method and the call it is missing.
//
// THE NAME COMES OFF THE NODE BY ID, not off a carried value: every memo
// this checker keeps is keyed by `ExprId`, and `settled` is reached from
// several callers that hold exactly that.
method_not_value = (c :: Checker, id: ExprId, fn_ty: TyId)
                   Res<TyId, AllocError> {
    poison = c.types.unknown().try();
    node   = c.tree.expr_at(id);
    ac     = c.access_at(id);
    span   = ac.match({ Ok(a) => a.name.span, None => node.span });
    text   = ac.match({ Ok(a) => a.name.text, None => "" });
    c.report(
        span.file,
        span,
        SemaFault.MethodNotValue(TypeFault(
            name: text,
            expected: poison,
            found: fn_ty
        ))
    ).try();
    poison;
}

ufcs_or_missing = (c :: Checker, node: Expr, ac: Access, ty: TyId, ctx: Ctx)
                  Res<TyId, AllocError> {
    defs ::= c.alloc.Vec<Def>();
    c.world.defs_of(ctx.module, ac.name.text, defs).try();
    (defs.len > 0).match({
        true  => c.types.unknown(),
        false => c.no_such_field(node, ac, ty),
    })
}

no_such_field = (c :: Checker, node: Expr, ac: Access, ty: TyId)
                Res<TyId, AllocError> {
    poison = c.types.unknown().try();
    c.report(
        ac.name.span.file,
        ac.name.span,
        SemaFault.NoSuchField(TypeFault(
            name: ac.name.text,
            expected: poison,
            found: ty
        ))
    ).try();
    c.types.unknown()
}

// The member `ac` names on its base's type, when there is one — the one
// lookup both member rules share, so they can never disagree about which
// fields they judge.
found_of = (c :: Checker, ac: Access, ctx: Ctx) Res<Res<Found>, AllocError> {
    b = base_of(c, ac.base, ctx).try();
    found ::= c.alloc.Vec<Found>();
    c.members_of(b.ty, ac.name.text, found).try();
    Ok(first_found(found));
}

// Whether `base.name` is supplied by an impl — "read-only and
// non-addressable, no storage, nothing to assign into."
computed_member* = (c :: Checker, ac: Access, ctx: Ctx)
                   Res<bool, AllocError> {
    f = c.found_of(ac, ctx).try();
    Ok(f.match({ Ok(m) => m.computed, None => false }));
}

// TWO RULES, NOT ONE (`field_write_outside` is the test that says so):
// DESIGN.md, "`*` on a field means readable outside the module; mutation
// only ever goes through exported methods." So this rule reads `module`,
// not `exported` — no star grants writing, so an exported field and an
// unexported one are equally unwritable from outside, and a field that
// fails it is not told to add a star it already has. Computed members
// are skipped: no storage, no declaring module to compare against.
writable_member* = (c :: Checker, ac: Access, ctx: Ctx)
                   Res<(), AllocError> {
    c.found_of(ac, ctx).try().match({
        Ok(f) => c.written_from(ac, f, ctx),
        None  => Ok(()),
    })
}

written_from = (c :: Checker, ac: Access, f: Found, ctx: Ctx)
               Res<(), AllocError> {
    ((f.computed == false) && (f.module != ctx.module)).match({
        true  => c.not_writable(ac, f),
        false => Ok(()),
    })
}

not_writable = (c :: Checker, ac: Access, f: Found) Res<(), AllocError> {
    c.report(
        ac.name.span.file,
        ac.name.span,
        SemaFault.NotWritable(ExportFault(
            name: ac.name.text,
            module: c.module_of(f)
        ))
    )
}

// `found.get(0)` written here rather than inline: a `Vec.get` on a
// locally-bound Vec, inside an expression with an expectation, resolves
// to `Map.get` at unknown type arguments. docs/SEMA_BOOTSTRAP_FIXES.md §11.
first_found* = (found: Vec<Found>) Res<Found> { found.get(0) }

// ---------------------------------------------------------------------
// the member table
// ---------------------------------------------------------------------

// Every member of `ty` called `name`. The type's OWN members first, and
// they are the whole answer when there are any: layout is declared, and
// an impl cannot add storage to it.
members_of* = (c :: Checker, ty: TyId, name: str, out :: Vec<Found>)
              Res<(), AllocError> {
    c.types.at(ty).match({
        Named(n) => c.named_members(n, ty, name, out),
        Prim(p)  => c.prim_members(p, ty, name, out),
        Var(v)   => c.bound_reachable(v.name, ty, name, out),
        _        => Ok(()),
    }).try();
    Ok(());
}

// "A prelude declaration of a primitive's name IS that primitive"
// (`sema_ty.named` records what minting a second one cost). `str` is an
// ordinary struct in `std.text.text_str` carrying `len`, `get`, `index`
// and `slice`, so a `Prim` gets the same lookup a `Named` gets, over the
// declaration the prelude exports under the same spelling — impls
// included, which is how `str`'s `Eq` reaches a literal. The receiver
// stays the primitive's own `TyId`, not the prelude declaration's.
prim_members = (
    c    :: Checker,
    p    : Prim,
    ty   : TyId,
    name : str,
    out  :: Vec<Found>
) Res<(), AllocError> {
    defs ::= c.alloc.Vec<Def>();
    c.world.prelude_of(p.name, defs).try();
    defs.get(0).match({
        None  => Ok(()),
        Ok(d) => {
            args ::= c.alloc.Vec<TyId>();
            c.named_members(
                TyNamed(decl: d.id, name: p.name, args: args),
                ty,
                name,
                out
            )
        },
    })
}

// A type parameter's members are the ones its BOUNDS promise, and
// nothing else: inside `<T: Boxy>(t: T)`, `t.width` reads `Boxy`'s width
// and the two impls on the concrete type never come into it.
bound_reachable = (
    c     :: Checker,
    tname : str,
    ty    : TyId,
    name  : str,
    out   :: Vec<Found>
) Res<(), AllocError> {
    bounds ::= c.alloc.Vec<TyId>();
    c.bounds_of(tname, bounds).try();
    bounds.loop((h, b) {
        c.bound_member(b, ty, name, out).try();
    });
    Ok(());
}

// One `Found` per declaration, for the reason `sema_supply.zen` states at
// `supplied`: `<T: Display>(t: T)` reaches the same two `toString`s a
// concrete receiver does, and a bound answering with one type would make
// the generic case pick differently from the concrete one.
bound_member = (
    c     :: Checker,
    bound : TyId,
    ty    : TyId,
    name  : str,
    out   :: Vec<Found>
) Res<(), AllocError> {
    tys ::= c.alloc.Vec<TyId>();
    c.bound_member_types(bound, name, ty, tys).try();
    span = c.bound_span(bound);
    tys.loop((h, t) {
        out.add(Found(
            name: name,
            ty: t,
            computed: true,
            constant: false,
            mutable: false,
            exported: true,
            module: 0,
            bound: bound,
            span: span,
        )).try();
    });
    Ok(());
}

bound_span = (c: Checker, bound: TyId) Span {
    c.types.at(bound).match({
        Named(n) => c.decl_span(n.decl),
        _        => nowhere(),
    })
}

decl_span* = (c: Checker, id: DeclId) Span {
    decl_at(c.tree, id).match({ Ok(d) => d.span, None => nowhere() })
}

named_members = (
    c    :: Checker,
    n    : TyNamed,
    ty   : TyId,
    name : str,
    out  :: Vec<Found>
) Res<(), AllocError> {
    decl_at(c.tree, n.decl).match({
        Ok(d) => d.kind.match({
            Struct(s) => struct_members(c, s, n, ty, name, out),
            _         => Ok(()),
        }),
        None  => Ok(()),
    }).try();
    (out.len == 0).then(() { c.impl_members(n, ty, name, out).try() });
    Ok(());
}

// The receiver's arguments are substituted into what the declaration
// promised: `Vec`'s own `get* = (self: @Self, i: usize) Res<T>` resolves
// to `Res<T>` with `T` a `Var`, so a `Vec<u8>` reaching it answers
// `Res<u8>` — via the receiver's own `TyNamed.args`, no second mechanism.
struct_members = (
    c    :: Checker,
    s    : Struct,
    n    : TyNamed,
    ty   : TyId,
    name : str,
    out  :: Vec<Found>
) Res<(), AllocError> {
    mi     = n.decl.module.to_usize();
    poison = c.types.unknown().try();
    inst   = c.inst_of_named(n).try();
    tmark  = c.tvar_mark();
    c.enter_struct_tvars(s, mi).try();
    s.members.loop((h, m) {
        m.named(name).match({
            false => Ok(()),
            true  => c.add_own(m, name, mi, ty, poison, inst, out),
        }).try();
    });
    c.release_tvars(tmark).try();
    Ok(());
}

// The `T` of `Vec<T>`, in scope in the members `Vec` declares — the same
// reason a function's type parameters are in scope in its body. Nothing
// did this for a struct before, so `Vec`'s own `get* = (self: @Self, i:
// usize) Res<T>` reported `T` as undefined inside the declaration that
// binds it. Pushes a `Ty.Var`, not the corresponding type ARGUMENT:
// `TyVar` is nominal on its owner, so the `T` of `Vec` and the `T` of
// `Map` can never be confused.
enter_struct_tvars* = (c :: Checker, s: Struct, mi: usize)
                     Res<(), AllocError> {
    owner = owner_of(c, mi, s.name.text).try();
    c.push_tparams(s.tparams, owner)
}

add_own = (
    c      :: Checker,
    m      : Member,
    name   : str,
    mi     : usize,
    ty     : TyId,
    poison : TyId,
    inst   : Inst,
    out    :: Vec<Found>
)
          Res<(), AllocError> {
    declared = member_type(c, m, mi, ty).try();
    out.add(Found(
        name: name,
        ty: c.subst(declared, inst).try(),
        computed: false,
        constant: m.kind.match({
            Const(_) => true,
            _        => false,
        }),
        mutable: m.mutable(),
        exported: m.exported(),
        module: mi,
        bound: poison,
        span: m.span,
    ))
}

// Resolved in the module that DECLARES the member, with `@Self` bound to
// the type asked about — so `area* ::= (self: @Self) i32` reads as a
// function of the receiver.
member_type* = (c :: Checker, m: Member, mi: usize, self_ty: TyId)
               Res<TyId, AllocError> {
    ctx = c.self_ctx(mi, self_ty).try();
    m.kind.match({
        Field(f)    => c.opt_type(f.type, ctx),
        Const(k)    => c.opt_type(k.type, ctx),
        Function(f) => c.fn_member_type(f, ctx),
    })
}

self_ctx* = (c :: Checker, mi: usize, self_ty: TyId) Res<Ctx, AllocError> {
    poison = c.types.unknown().try();
    Ok(Ctx(
        module: mi,
        ret: poison,
        has_ret: false,
        self_ty: self_ty,
        has_self: true
    ));
}

opt_type = (c :: Checker, t: Res<TypeId>, ctx: Ctx) Res<TyId, AllocError> {
    t.match({
        Ok(x) => c.type_from_ast(x, ctx),
        None  => c.types.unknown(),
    })
}

// A member's own type parameters are in scope in its signature too:
// `to* = <U>(self: @Self) Ptr<U>` reads `U` as the parameter it declares.
fn_member_type = (c :: Checker, f: Function, ctx: Ctx)
                 Res<TyId, AllocError> {
    tmark = c.tvar_mark();
    owner = owner_of(c, ctx.module, f.name.text).try();
    c.push_tparams(f.tparams, owner).try();
    ptys ::= c.alloc.Vec<TyId>();
    f.params.loop((h, p) { ptys.add(c.param_type(p, ctx).try()).try() });
    rty = f.ret.match({
        Ok(r) => c.type_from_ast(r, ctx),
        None  => c.types.prim("()"),
    }).try();
    got = c.types.fn_ty(ptys, rty).try();
    c.release_tvars(tmark).try();
    Ok(got);
}
