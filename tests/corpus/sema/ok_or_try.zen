// a None never becomes an Err: you name the reason. `.ok_or(..)` is the
// required form, and only then may .try() propagate. DESIGN.md, Errors.
// the rejected shape is must-fail/sema/try_option_into_res.

LookupError = NotFound | Malformed

Error = LookupError | AllocError

main = (env: Env) Res<i32, Error> {
    alloc ::= env.mem.alloc();
    ages  ::= alloc.Map<str, i32>();
    ages.set("ada", 36).try();

    age = ages.get("ada").ok_or(LookupError.NotFound).try();
    println("{}", age);

    ages.get("bob").ok_or(LookupError.NotFound).match({
        Ok(n)  => println("bob {}", n),
        Err(_) => println("bob missing"),
    });
    Ok(0);
}
