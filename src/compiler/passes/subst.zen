// compiler.passes.subst — generic substitution + xform sub-pass extracted from compiler.check.
{ cbuf, ArmData, CallData, Decl, Expr, FieldInit, LambdaData, MakeStructData, MatchData, Param, Stmt, Ty, VarData, arm, arrow_at, bin_at, block, call_full, cond_oa, eindex, eloop, ematch, ematchp, finit, lam_r, mangle_str_in, member_at, mkenum, mkenumg, mkstruct_at, mkstructg_at, mktag, mktagg, sassign_at, sexpr, sidxset_at, sif, slett_at, slit, sret, subst_ty_in, swhile, tvoid, ty_cname_in, vref_at } = compiler.genc
{ DeclIndex, VList, add_fnt_param, add_lambda_arg, add_subst_arg, add_subst_param, bind_fnret, callee_subst_name, fnret_of, gen_variant_payload, idx_genenum, idx_variant_payload, inline_lambda, is_void_ty, let_value_lambda, local_name_at, no_stmts, param_index, recall, ref_pos, vcons } = compiler.check
{ light_ty } = compiler.check_infer
{ cs_or, maybe_template } = compiler.check_inline
{ Malloc } = std.mem.alloc
{ eq } = std.text.str
subst_var = (a: MutPtr<Malloc>, params: [Param], args: [Expr], name: string_view, e: Ptr<Expr>) Ptr<Expr> {
    idx := params.param_index(name)
    (idx < 0).match ({ true => e, false => a.subst_keep_pos(args[idx].addr(), e.ref_pos()) })
}
// A substituted reference is a renamed local's `vref` (built pos-less) or a spliced source arg. When
// the substitution target is a bare Var, carry the ORIGINAL reference's source position onto a fresh
// node (so a later diagnostic — e.g. a non-exhaustive match on a local subject — still gets a caret);
// a non-Var arg keeps its own node (and its own positions) unchanged.
subst_keep_pos = (a: MutPtr<Malloc>, arg: Ptr<Expr>, p: i32) Ptr<Expr> {
    load(arg).match ({
        .Var(v) => a.cenode(vref_at(v.name, (v.pos <= 0).match ({ true => p, false => v.pos }))),
        _       => arg,
    })
}
// the source position of a substituted REFERENCE (always a Var at the xform `.Var` call site).
xform_args = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, args: [Expr], params: [Param], fargs: [Expr], env: Ptr<VList>) [Expr] {
    buf := a.cebuf(args.len)
    args.loop((h, i, ar) {
        buf[i] = load(a.xform_expr(decls, idx, ar.addr(), params, fargs, env))
    })
    buf
}
xform_arm_payload = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, subj: Ty, ename: string_view, ar: ArmData) Ty {
    subj.match ({
        .Generic(g) => a.subst_ty_in(idx.idx_genenum(decls, g.name).tparams, g.args, idx.idx_genenum(decls, g.name).gen_variant_payload(ar.variant)),
        _           => idx.idx_variant_payload(decls, ename, ar.variant),
    })
}
xform_arm_env* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, subj: Ty, ename: string_view, ar: ArmData, env: Ptr<VList>) Ptr<VList> {
    out := env
    (eq(ar.bind, "") == false).then({
        out = a.vcons(ar.bind, a.xform_arm_payload(decls, idx, subj, ename, ar), env)
    })
    out
}
xform_arms = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, subj: Ty, ename: string_view, arms: [ArmData], params: [Param], fargs: [Expr], env: Ptr<VList>, exp: Ty) [ArmData] {
    buf := cbuf<ArmData>(a, arms.len)
    arms.loop((h, i, ar) {
        bind := ""
        ps := params
        xs := fargs
        (eq(ar.bind, "") == false).then({
            bind = a.local_name_at(ar.bind, env, params.len)
            ps = a.add_subst_param(params, ar.bind)
            xs = a.add_subst_arg(fargs, bind)
        })
        br := arm(ar.variant, bind, ar.body)
        aenv := a.xform_arm_env(decls, idx, subj, ename, br, env)
        buf[i] = arm(ar.variant, bind, a.xform_expr_exp(decls, idx, ar.body, ps, xs, aenv, exp))
    })
    buf
}
subst_targs = (a: MutPtr<Malloc>, tparams: [Param], targs: [Ty], xs: [Ty]) [Ty] {
    buf := cbuf<Ty>(a, xs.len)
    xs.loop((h, i, t) {
        buf[i] = a.subst_ty_in(tparams, targs, t)
    })
    buf
}
subst_genlit_g = (a: MutPtr<Malloc>, cs: i32, tparams: [Param], targs: [Ty], m: MakeStructData) Expr {
    nt := a.subst_targs(tparams, targs, m.targs)
    mkstructg_at(m.ty, a.mangle_str_in(m.ty, nt), nt, a.subst_inits(cs, tparams, targs, m.inits), cs_or(cs, m.pos))
}
subst_genlit = (a: MutPtr<Malloc>, cs: i32, tparams: [Param], targs: [Ty], m: MakeStructData) Expr {
    (m.targs.len > 0).match ({
        true  => a.subst_genlit_g(cs, tparams, targs, m),
        false => mkstruct_at(m.ty, a.subst_inits(cs, tparams, targs, m.inits), cs_or(cs, m.pos)),
    })
}
subst_inits = (a: MutPtr<Malloc>, cs: i32, tparams: [Param], targs: [Ty], inits: [FieldInit]) [FieldInit] {
    buf := cbuf<FieldInit>(a, inits.len)
    inits.loop((h, i, fi) {
        buf[i] = finit(fi.name, a.subst_expr(cs, tparams, targs, fi.value))
    })
    buf
}
subst_exprs = (a: MutPtr<Malloc>, cs: i32, tparams: [Param], targs: [Ty], xs: [Expr]) [Expr] {
    buf := a.cebuf(xs.len)
    xs.loop((h, i, x) {
        buf[i] = load(a.subst_expr(cs, tparams, targs, x.addr()))
    })
    buf
}
subst_arms = (a: MutPtr<Malloc>, cs: i32, tparams: [Param], targs: [Ty], arms: [ArmData]) [ArmData] {
    buf := cbuf<ArmData>(a, arms.len)
    arms.loop((h, i, ar) {
        buf[i] = arm(ar.variant, ar.bind, a.subst_expr(cs, tparams, targs, ar.body))
    })
    buf
}
subst_match = (a: MutPtr<Malloc>, cs: i32, tparams: [Param], targs: [Ty], m: MatchData) Ptr<Expr> {
    subj := a.subst_expr(cs, tparams, targs, m.subj)
    arms := a.subst_arms(cs, tparams, targs, m.arms)
    m.ptr.match ({
        true  => a.cenode(ematchp(subj, m.ename, arms)),
        false => a.cenode(ematch(subj, m.ename, arms)),
    })
}
// Substitute and remangle generic-enum ctors/tags inside template bodies.
subst_mkenum = (a: MutPtr<Malloc>, tparams: [Param], targs: [Ty], ety: string_view, etargs: [Ty], variant: string_view, p: Ptr<Expr>) Ptr<Expr> {
    (etargs.len > 0).match ({
        true  => a.cenode(a.subst_mkenum_g(tparams, targs, ety, etargs, variant, p)),
        false => a.cenode(mkenum(ety, variant, p)),
    })
}
subst_mkenum_g = (a: MutPtr<Malloc>, tparams: [Param], targs: [Ty], ety: string_view, etargs: [Ty], variant: string_view, p: Ptr<Expr>) Expr {
    nt := a.subst_targs(tparams, targs, etargs)
    mkenumg(ety, a.mangle_str_in(ety, nt), nt, variant, p)
}
subst_tag = (a: MutPtr<Malloc>, tparams: [Param], targs: [Ty], ety: string_view, etargs: [Ty], variant: string_view) Ptr<Expr> {
    (etargs.len > 0).match ({
        true  => a.cenode(a.subst_tag_g(tparams, targs, ety, etargs, variant)),
        false => a.cenode(mktag(ety, variant)),
    })
}
subst_tag_g = (a: MutPtr<Malloc>, tparams: [Param], targs: [Ty], ety: string_view, etargs: [Ty], variant: string_view) Expr {
    nt := a.subst_targs(tparams, targs, etargs)
    mktagg(ety, a.mangle_str_in(ety, nt), nt, variant)
}
// `sizeof(T)` uses the tparam name as a value; rewrite it to the concrete C type name. A non-tparam
// Var is rebuilt (not passed through) so its position also retargets to the call site under `cs`.
subst_tparam_var = (a: MutPtr<Malloc>, cs: i32, tparams: [Param], targs: [Ty], v: VarData, e: Ptr<Expr>) Ptr<Expr> {
    i := tparams.param_index(v.name)
    (i < 0).match ({
        true  => (cs == 0).match ({ true => e, false => a.cenode(vref_at(v.name, cs)) }),
        false => a.cenode(vref_at(a.ty_cname_in(targs[i]), cs_or(cs, v.pos))),
    })
}
subst_expr = (a: MutPtr<Malloc>, cs: i32, tparams: [Param], targs: [Ty], e: Ptr<Expr>) Ptr<Expr> {
    load(e).match ({
        .Var(v)        => a.subst_tparam_var(cs, tparams, targs, v, e),
        .Bin(b)        => a.cenode(bin_at(b.op, a.subst_expr(cs, tparams, targs, b.lhs), a.subst_expr(cs, tparams, targs, b.rhs), cs_or(cs, b.pos))),
        .Cond(d)       => a.cenode(cond_oa(a.subst_expr(cs, tparams, targs, d.c), a.subst_expr(cs, tparams, targs, d.t), a.subst_expr(cs, tparams, targs, d.e), d.oa)),
        .Member(m)     => a.cenode(member_at(a.subst_expr(cs, tparams, targs, m.obj), m.field, cs_or(cs, m.pos))),
        .Arrow(ar)     => a.cenode(arrow_at(a.subst_expr(cs, tparams, targs, ar.obj), ar.field, cs_or(cs, ar.pos))),
        .Call(c)       => a.cenode(call_full(c.fn, a.subst_exprs(cs, tparams, targs, c.args), a.subst_targs(tparams, targs, c.targs), cs_or(cs, c.pos), c.raw)),
        .MakeEnum(mk)  => a.subst_mkenum(tparams, targs, mk.ty, mk.targs, mk.variant, a.subst_expr(cs, tparams, targs, mk.payload)),
        .Tag(t)        => a.subst_tag(tparams, targs, t.ty, t.targs, t.variant),
        .MakeStruct(m) => a.cenode(a.subst_genlit(cs, tparams, targs, m)),
        .Match(mm)     => a.subst_match(cs, tparams, targs, mm),
        .Index(ix)     => a.cenode(eindex(a.subst_expr(cs, tparams, targs, ix.seq), a.subst_expr(cs, tparams, targs, ix.idx), a.subst_ty_in(tparams, targs, ix.elem))),
        .Loop(l)       => a.cenode(eloop(a.subst_expr(cs, tparams, targs, l.seq), l.idx, l.elem, a.subst_ty_in(tparams, targs, l.elemTy), a.subst_body(cs, tparams, targs, l.body), l.h)),
        .SliceLit(sd)  => a.cenode(slit(a.subst_ty_in(tparams, targs, sd.elem), a.subst_exprs(cs, tparams, targs, sd.items))),
        .Block(b)      => a.cenode(block(a.subst_body(cs, tparams, targs, b.stmts))),
        _              => e,
    })
}
subst_stmt = (a: MutPtr<Malloc>, cs: i32, tparams: [Param], targs: [Ty], st: Stmt) Stmt {
    st.match ({
        .Let(l)      => slett_at(l.name, a.subst_ty_in(tparams, targs, l.ty), a.subst_expr(cs, tparams, targs, l.value), cs_or(cs, l.pos)),
        .Assign(x)   => sassign_at(a.subst_expr(cs, tparams, targs, x.target), a.subst_expr(cs, tparams, targs, x.value), cs_or(cs, x.pos)),
        .Return(r)   => sret(a.subst_expr(cs, tparams, targs, r)),
        .ExprStmt(e) => sexpr(a.subst_expr(cs, tparams, targs, e)),
        .If(f)       => sif(a.subst_expr(cs, tparams, targs, f.c), a.subst_body(cs, tparams, targs, f.then), a.subst_body(cs, tparams, targs, f.els)),
        .While(w)    => swhile(a.subst_expr(cs, tparams, targs, w.c), a.subst_body(cs, tparams, targs, w.body)),
        .IndexSet(x) => sidxset_at(a.subst_expr(cs, tparams, targs, x.seq), a.subst_expr(cs, tparams, targs, x.idx), a.subst_ty_in(tparams, targs, x.elem), a.subst_expr(cs, tparams, targs, x.value), cs_or(cs, x.pos)),
    })
}
subst_body* = (a: MutPtr<Malloc>, cs: i32, tparams: [Param], targs: [Ty], body: [Stmt]) [Stmt] {
    buf := cbuf<Stmt>(a, body.len)
    body.loop((h, i, st) {
        buf[i] = a.subst_stmt(cs, tparams, targs, st)
    })
    buf
}
// Empty Named marks a generic template currently being inlined.
xform_call = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, c: CallData, params: [Param], fargs: [Expr], env: Ptr<VList>, exp: Ty) Ptr<Expr> {
    cargs := a.xform_args(decls, idx, c.args, params, fargs, env)
    fi := params.param_index(c.fn)
    (fi < 0).match ({
        true  => a.maybe_template(decls, idx, c, cargs, env, exp),
        false => params[fi].ty.is_fnt().match ({
            true  => a.inline_lambda(decls, idx, fargs[fi], cargs, env),
            false => a.recall(c, fargs[fi].callee_subst_name(c.fn), cargs),
        }),
    })
}
// an indirect call through a renamed local (a fn-value let): the substituted arg is the
// renamed local's Var, so recall through its renamed C name (not the stale original).
xform_match = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, m: MatchData, params: [Param], fargs: [Expr], env: Ptr<VList>, exp: Ty) Ptr<Expr> {
    subj := a.xform_expr(decls, idx, m.subj, params, fargs, env)
    st := subj.light_ty(a, env, decls, idx)
    arms := a.xform_arms(decls, idx, st, m.ename, m.arms, params, fargs, env, exp)
    out := a.cenode(ematch(subj, m.ename, arms))
    m.ptr.then({
        out = a.cenode(ematchp(subj, m.ename, arms))
    })
    out
}
xform_inits = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, inits: [FieldInit], params: [Param], fargs: [Expr], env: Ptr<VList>) [FieldInit] {
    buf := cbuf<FieldInit>(a, inits.len)
    inits.loop((h, i, fi) {
        buf[i] = finit(fi.name, a.xform_expr(decls, idx, fi.value, params, fargs, env))
    })
    buf
}
xform_lambda = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, lm: LambdaData, params: [Param], fargs: [Expr], env: Ptr<VList>) Ptr<Expr> {
    ps := params
    xs := fargs
    lm.params.loop((h, i, p) {
        ps = a.add_subst_param(ps, p.name)
        xs = a.add_subst_arg(xs, p.name)
    })
    // bind the lambda's OWN return type (possibly void) so an enclosing fn's fnret never leaks
    // into the lambda body's `return`s.
    a.cenode(lam_r(lm.params, a.xform_body(decls, idx, lm.body, ps, xs, a.bind_fnret(env, lm.ret), tvoid()), lm.ret))
}
xform_expr = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, e: Ptr<Expr>, params: [Param], fargs: [Expr], env: Ptr<VList>) Ptr<Expr> { a.xform_expr_exp(decls, idx, e, params, fargs, env, tvoid()) }
xform_expr_exp = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, e: Ptr<Expr>, params: [Param], fargs: [Expr], env: Ptr<VList>, exp: Ty) Ptr<Expr> {
    out := e
    load(e).match ({
        .Var(v)         => {
            out = a.subst_var(params, fargs, v.name, e)
        },
        .Call(c)        => {
            out = a.xform_call(decls, idx, c, params, fargs, env, exp)
        },
        .Bin(b)         => {
            out = a.cenode(bin_at(b.op, a.xform_expr(decls, idx, b.lhs, params, fargs, env), a.xform_expr(decls, idx, b.rhs, params, fargs, env), b.pos))
        },
        .Cond(d)        => {
            out = a.cenode(cond_oa(a.xform_expr(decls, idx, d.c, params, fargs, env), a.xform_expr_exp(decls, idx, d.t, params, fargs, env, exp), a.xform_expr_exp(decls, idx, d.e, params, fargs, env, exp), d.oa))
        },
        .Member(m)      => {
            out = a.cenode(member_at(a.xform_expr(decls, idx, m.obj, params, fargs, env), m.field, m.pos))
        },
        .Arrow(ar)      => {
            out = a.cenode(arrow_at(a.xform_expr(decls, idx, ar.obj, params, fargs, env), ar.field, ar.pos))
        },
        .MakeEnum(mk)   => {
            out = a.cenode(mkenumg(mk.ty, mk.mty, mk.targs, mk.variant, a.xform_expr(decls, idx, mk.payload, params, fargs, env)))
        },
        .MakeStruct(sd) => {
            out = a.cenode(mkstructg_at(sd.ty, sd.mty, sd.targs, a.xform_inits(decls, idx, sd.inits, params, fargs, env), sd.pos))
        },
        .Match(m)       => {
            out = a.xform_match(decls, idx, m, params, fargs, env, exp)
        },
        .Index(ix)      => {
            out = a.cenode(eindex(a.xform_expr(decls, idx, ix.seq, params, fargs, env), a.xform_expr(decls, idx, ix.idx, params, fargs, env), ix.elem))
        },
        .Loop(l)        => {
            lidx := a.local_name_at(l.idx, env, params.len)
            elem := a.local_name_at(l.elem, env, params.len + 1)
            hnd := a.local_name_at(l.h, env, params.len + 2)
            ps1 := a.add_subst_param(a.add_subst_param(a.add_subst_param(params, l.idx), l.elem), l.h)
            xs1 := a.add_subst_arg(a.add_subst_arg(a.add_subst_arg(fargs, lidx), elem), hnd)
            out = a.cenode(eloop(a.xform_expr(decls, idx, l.seq, params, fargs, env), lidx, elem, l.elemTy, a.xform_body(decls, idx, l.body, ps1, xs1, env, tvoid()), hnd))
        },
        .Lambda(lm)     => {
            out = a.xform_lambda(decls, idx, lm, params, fargs, env)
        },
        .SliceLit(sd)   => {
            out = a.cenode(slit(sd.elem, a.xform_args(decls, idx, sd.items, params, fargs, env)))
        },
        .Block(b)       => {
            out = a.cenode(block(a.xform_body(decls, idx, b.stmts, params, fargs, env, exp)))
        },
        _               => { },
    })
    out
}
xform_stmt = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, st: Stmt, params: [Param], fargs: [Expr], env: Ptr<VList>, exp: Ty) Stmt {
    out := st
    st.match ({
        .Let(l)      => {
            out = st.let_value_lambda().match ({
                true  => sexpr(a.cenode(block(no_stmts()))),
                false => slett_at(a.local_name_at(l.name, env, params.len), l.ty, a.xform_expr_exp(decls, idx, l.value, params, fargs, env, l.ty), l.pos),
            })
        },    // lambda-alias let: dropped (spliced at uses)
        .Assign(x)   => {
            out = sassign_at(a.xform_expr(decls, idx, x.target, params, fargs, env), a.xform_expr(decls, idx, x.value, params, fargs, env), x.pos)
        },
        .Return(r)   => {
            // a return's operand infers against the enclosing fn's return type (threaded via
            // bind_fnret), NOT the positional exp — which is void for every non-tail statement, so
            // a nested match-arm `return err(e)` inlined here otherwise instantiates err<void, E>.
            rt := env.fnret_of()
            out = sret(a.xform_expr_exp(decls, idx, r, params, fargs, env, rt.is_void_ty().match ({
                true  => exp,
                false => rt,
            })))
        },
        .ExprStmt(e) => {
            out = sexpr(a.xform_expr_exp(decls, idx, e, params, fargs, env, exp))
        },
        .If(f)       => {
            out = sif(a.xform_expr(decls, idx, f.c, params, fargs, env), a.xform_body(decls, idx, f.then, params, fargs, env, tvoid()), a.xform_body(decls, idx, f.els, params, fargs, env, tvoid()))
        },
        .While(w)    => {
            out = swhile(a.xform_expr(decls, idx, w.c, params, fargs, env), a.xform_body(decls, idx, w.body, params, fargs, env, tvoid()))
        },
        .IndexSet(x) => {
            out = sidxset_at(a.xform_expr(decls, idx, x.seq, params, fargs, env), a.xform_expr(decls, idx, x.idx, params, fargs, env), x.elem, a.xform_expr(decls, idx, x.value, params, fargs, env), x.pos)
        },
    })
    out
}
// Thread local light types so generic call args can infer from Vars.
xform_let_ext = (a: MutPtr<Malloc>, env: Ptr<VList>, st: Stmt, decls: [Decl], idx: DeclIndex, params: [Param]) Ptr<VList> {
    out := env
    st.match ({
        .Let(l) => {
            ty := l.ty
            l.ty.is_void_ty().then({
                ty = l.value.light_ty(a, env, decls, idx)
            })
            out = a.vcons(a.local_name_at(l.name, env, params.len), ty, env)
        },
        _       => { },
    })
    out
}
xform_param_shadow = (a: MutPtr<Malloc>, params: [Param], st: Stmt) [Param] {
    out := params
    st.match ({
        .Let(l) => {
            out = st.let_value_lambda().match ({
                true  => a.add_fnt_param(params, l.name),
                false => a.add_subst_param(params, l.name),
            })
        },
        _       => { },
    })
    out
}
xform_arg_shadow = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, args: [Expr], st: Stmt, params: [Param], env: Ptr<VList>) [Expr] {
    out := args
    st.match ({
        .Let(l) => {
            out = st.let_value_lambda().match ({
                true  => a.add_lambda_arg(args, a.xform_expr(decls, idx, l.value, params, args, env)),
                false => a.add_subst_arg(args, a.local_name_at(l.name, env, params.len)),
            })
        },
        _       => { },
    })
    out
}
xform_body* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, body: [Stmt], params: [Param], fargs: [Expr], env: Ptr<VList>, exp: Ty) [Stmt] {
    buf := cbuf<Stmt>(a, body.len)
    e := env
    ps := params
    xs := fargs
    body.loop((h, i, st) {
        want := tvoid()
        (i == body.len - 1).then({
            want = exp
        })
        buf[i] = a.xform_stmt(decls, idx, st, ps, xs, e, want)
        e = a.xform_let_ext(e, st, decls, idx, ps)
        xs = a.xform_arg_shadow(decls, idx, xs, st, ps, e)
        ps = a.xform_param_shadow(ps, st)
    })
    buf
}
