// the literal below is one below i32.MIN.
//
// i32.MIN ITSELF stands one line above it and `.count 1` allows no second
// diagnostic, so a checker that rejects negative literals wholesale -- which
// a lone -2147483649 cannot tell apart from a correct bound -- goes red here
// rather than passing for the wrong reason. corpus/lex/number_i32_min_literal
// carries the same boundary as a running program.
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    ok: i32 = -2147483648;
    bad: i32 = -2147483649;
    println("{} {}", ok, bad);
    Ok(0);
}
