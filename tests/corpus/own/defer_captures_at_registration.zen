// "a closure registered on a scope keeps its captures in that scope's own
// storage". the frame that wrote the closure is gone by the time it runs, so
// the captures are COPIED when `defer` is called — a later write to the
// binding cannot be visible, and `note`'s frame has long returned.

note = (s: Scope, tag: str) () {
    s.defer(() { println("note {}", tag) });
}

main = (env: Env) Res<i32, IoError> {
    n ::= 1;
    @scope.defer(() { println("n was {}", n) });
    note(@scope, "from a helper");
    n = 99;
    println("n is now {}", n);
    Ok(0);
}
