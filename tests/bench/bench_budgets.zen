// tests/bench/bench_budgets.zen
// budgets are code, reviewed like code, so the numbers live beside
// the benches they gate rather than in a config file nobody reads.
// scripts/bench.py reads this list; there is no build.zen yet, and
// this header used to say one passed the list to b.bench.
//
// WHO ENFORCES WHICH NUMBER, exactly, because a budget nobody
// measures is worse than no budget -- it reads as enforced:
//
//   allocs_op, bytes_op   `make test`, through `bench.py
//                         --allocs-only`. Deterministic, so over
//                         budget FAILS. Measured at the LIBC
//                         boundary: each driver is linked through
//                         `ld --wrap=malloc` and compiled twice, and
//                         the per-op figure is the slope between N
//                         and 2N iterations. An arena serves many Zen
//                         allocations out of one 64 KiB page, so a
//                         measured figure is a LOWER BOUND on Zen
//                         allocator calls and the budget is a
//                         CEILING: under budget is not a claim that
//                         the design's count was met. Zero is the one
//                         value checked exactly -- a loop that never
//                         reaches the heap has a slope of exactly 0.
//
//   ns_op                 `make bench`, and nothing else. A wall
//                         clock reddens on a loaded machine, and a
//                         gate people learn to read past is worse
//                         than none. Tracked against the rolling
//                         median in baseline.json; over budget warns,
//                         an absurd miss fails.

Budget = std.build

budgets* = [Budget, 4](
    // DESIGN.md, the example build.zen. one add, one grow, one alloc
    Budget(name: "vec_add", ns_op: 40, allocs_op: 1, bytes_op: 64),

    // DESIGN.md names these two together and says what their
    // divergence would mean: uniform access is not free. bytes_op
    // is not given there; 0 follows from allocs_op: 0
    Budget(name: "stored_field_read", ns_op: 2, allocs_op: 0, bytes_op: 0),
    Budget(name: "computed_field_read", ns_op: 2, allocs_op: 0, bytes_op: 0),

    // TESTING.md names allocs_op: 0 for the fold and nothing else.
    // ns_op here is a first guess against a rolling median, NOT a
    // number from the design
    Budget(name: "fold_stack_array", ns_op: 20, allocs_op: 0, bytes_op: 0),
)
