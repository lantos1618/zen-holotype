// src/gen/gen_c/gen_c_handle.zen
// `h.break(v)` and `h.next()` — leaving a loop, and leaving a pass.
//
// Its own file rather than the tail of `gen_c_loop.zen`: DESIGN.md
// frames `.try()` as "a jump out through a frame boundary, exactly what
// `h.break(v)` does" — the loop file answers what a loop IS, this one
// what a jump out of one is, the question `gen_c_flow.zen` answers for
// `.try()`.
//
// Both are `goto`s, neither is C's `break`/`continue`: the body is
// inlined into whatever the lowering of a `.match` produced (an `if`
// chain today), and a C `break` there would leave that construct rather
// than the loop. A label cannot be captured that way, the whole reason
// `LoopFrame` carries two of them.
//
// A handle is not a value: `h` has no C storage and no type sema can
// name — the binding holds the DEPTH of the loop it came from, so
// `h.break` is recognised at the NAME rather than resolved through a
// receiver's type. That's why `handle_depth` is asked before anything
// else in `lower_dot_call`.

ExprId, Access, Call = std.ast
AllocError = std.mem
str, String = std.text
TyId = sema.sema_ty
Ctx = sema.sema_check
literal_overflows = sema.sema_trap
sym_member, sym_variant = gen.gen_name
RES_PATH = gen.gen_name
CBackend = gen.gen_c.gen_c_state
LoopFrame = gen.gen_c.gen_c_frame
GenFault = gen.gen_diag
unsupported = gen.gen_c.gen_c_report
ctype, is_unit = gen.gen_c.gen_c_type
expr = gen.gen_c.gen_c_expr
bare_name = gen.gen_c.gen_c_stmt
write_label = gen.gen_c.gen_c_loop
unwind_to = gen.gen_c.gen_c_own

// -----------------------------------------------------------------
// the two verbs — the same jump `.try()` is, one frame down
// -----------------------------------------------------------------

// The base has to be a bare name bound to a handle: a handle is not a
// value, so there is nothing else it could be reached through.
handle_depth* = (be :: CBackend, base: ExprId) usize {
    be.tree.expr_at(base).kind.match({
        Name(n) => be.slot_handle(n.text),
        _       => 0,
    })
}

slot_handle = (be :: CBackend, name: str) usize {
    be.slot_of(name).match({
        Ok(s) => s.handle,
        None  => 0,
    })
}

lower_handle_call* = (
    be    :: CBackend,
    id    : ExprId,
    c     : Call,
    a     : Access,
    depth : usize,
    ctx   : Ctx,
    out   :: String
)
                     Res<(), AllocError> {
    be.loop_frame(depth).match({
        None   => be.unsupported(
            id,
            "a loop handle used outside its loop",
            out
        ),
        Ok(fr) => be.handle_verb(id, c, a.name.text, fr, ctx, out),
    })
}

handle_verb = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    name : str,
    fr   : LoopFrame,
    ctx  : Ctx,
    out  :: String
)
              Res<(), AllocError> {
    name.eq("next").match({
        true  => be.leave_pass(fr, out),
        false => be.handle_break(id, c, name, fr, ctx, out),
    })
}

// `h.next()` leaves this iteration's block. Every exit is a scope exit,
// and a `goto` jumps OVER the closing brace the cleanup would run at —
// so this iteration's defers and drops run here instead. Nothing is
// handed out of a pass that ends this way, so there is nothing to keep.
leave_pass = (be :: CBackend, fr: LoopFrame, out :: String)
             Res<(), AllocError> {
    be.unwind_to(fr.depth, "").try();
    be.jump_to("cnt", fr.cnt, out)
}

handle_break = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    name : str,
    fr   : LoopFrame,
    ctx  : Ctx,
    out  :: String
)
               Res<(), AllocError> {
    name.eq("break").match({
        false => be.unsupported(
            id,
            "a loop handle has only `break` and `next`",
            out
        ),
        true  => be.write_break(id, c, fr, ctx, out),
    })
}

// `h.break(v)` writes the loop's value before it jumps, and `h.break()`
// leaves it as the `None` the loop opened with — which is what makes
// "the loop evaluates to `h.break(value)`" true without a second exit.
write_break = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    fr  : LoopFrame,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    ((c.args.len > 0) && (fr.has_result == false)).match({
        true  => be.unsupported(
            id,
            "a loop whose value type nothing settles, broken with a value",
            out
        ),
        false => Ok(()),
    }).try();
    // THE VALUE BROKEN WITH IS NOT FREE TO CHOOSE ITS TYPE. `loop_handle.zen`
    // states the rule — break's `T` "is the enclosing loop's own T, fixed by
    // the loop this handle names, never by the call" — and the frame's
    // settled type is that answer: the walked element, or a fold's
    // accumulator (`settle_res`, `gen_c_loop.zen`). Sema never sees either
    // side of the question: `h` is bound at `unknown` (`bind_handle`) and
    // sema does not walk lambda bodies at all, so this is the one place the
    // two types meet. Without the check, a disagreement is a compound
    // literal in the wrong slot for cc to catch — and two integers of
    // different widths convert silently, compiling clean and answering
    // garbage.
    ((c.args.len > 0) && (fr.has_result)).match({
        false => Ok(()),
        true  => be.break_fits(id, c, fr, ctx),
    }).try();
    (fr.has_result && (c.args.len > 0)).match({
        false => Ok(()),
        true  => be.write_break_value(c, fr, ctx),
    }).try();
    // The value is written before the cleanup, and the cleanup before
    // the jump: the result lands in storage outside the loop, so it
    // survives the drops.
    be.unwind_to(fr.depth, be.break_keep(c)).try();
    be.jump_to("brk", fr.brk, out)
}

// A binding handed OUT of the loop by `h.break(x)` is not this pass's
// to destroy. Only a bare name can be one — anything larger has been
// copied into the result by now.
break_keep = (be :: CBackend, c: Call) str {
    c.args.get(0).match({
        None  => "",
        Ok(a) => be.bare_name(a.value),
    })
}

// The break argument against the loop's own payload, the rule
// `write_break`'s comment states. `assignable` is the one gate a value
// passes at every other position a type is expected — literals fit their
// family, poison and holes agree with everything, and an unsubstituted
// parameter reaches any instantiation — so a legal break cannot fail it
// (`find`'s `h.break(value)` breaks with the element itself; std's
// `text_utf8` breaks with `usize` literals over a `usize` walk). What
// fails it is exactly what the slot could not hold.
break_fits = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    fr  : LoopFrame,
    ctx : Ctx
) Res<(), AllocError> {
    c.args.get(0).match({
        None  => Ok(()),
        Ok(a) => be.break_value_fits(a.value, fr, ctx, id),
    })
}

break_value_fits = (
    be    :: CBackend,
    value : ExprId,
    fr    : LoopFrame,
    ctx   : Ctx,
    id    : ExprId
) Res<(), AllocError> {
    payload = ok_payload(be, fr.ty).try();
    unknown = be.check.types.unknown().try();
    got     = be.ty_of(value, ctx, unknown).try();
    be.check.assignable(got, payload).match({
        true  => be.break_literal_fits(value, payload),
        false => be.break_type_fault(id, got, payload),
    })
}

// AND A LITERAL FITS ITS FAMILY, NOT ITS TYPE. That leniency is what
// keeps `Range(0, 5).loop(.. h.break(42) ..)` legal over a `usize`
// walk, and it is also what let `h.break(300)` over a `[u8]` walk
// truncate to 44 with exit 0 and no diagnostic — the break was the one
// typed position in this language with no range check on it, while
// `q: u8 = 300` has been refused all along. `cc` says `-Woverflow`
// here and `zen` said nothing (#766).
break_literal_fits = (be :: CBackend, value: ExprId, payload: TyId)
                     Res<(), AllocError> {
    be.check.literal_overflows(value, payload).match({
        false => Ok(()),
        true  => be.break_range_fault(value, payload),
    })
}

// The position is the literal the author has to change, which is not
// the `h.break` that carries it — `sema_trap.out_of_range` puts its
// caret in the same place for the same reason.
break_range_fault = (be :: CBackend, value: ExprId, payload: TyId)
                    Res<(), AllocError> {
    want ::= be.name_of_or(payload).try();
    what ::= be.alloc.String(
        "h.break(v) is not free to choose its type: the loop's own T is "
    ).try();
    what.add_bytes(want.view()).try();
    what.add_bytes(", and this literal does not fit it").try();
    be.report_expr(value, GenFault.Unsupported(what.view()))
}

// One sentence, both types named. `name_of` spells a type as the
// program wrote it; the sentence goes out through `Unsupported` because
// that fault IS "this position cannot hold what was handed to it" —
// there is deliberately no second copy of sema's TypeMismatch here.
break_type_fault = (
    be      :: CBackend,
    id      : ExprId,
    got     : TyId,
    payload : TyId
) Res<(), AllocError> {
    want  ::= be.name_of_or(payload).try();
    found ::= be.name_of_or(got).try();
    what  ::= be.alloc.String(
        "h.break(v) is not free to choose its type: the loop's own T is "
    ).try();
    what.add_bytes(want.view()).try();
    what.add_bytes(", broken with ").try();
    what.add_bytes(found.view()).try();
    be.report_expr(id, GenFault.Unsupported(what.view()))
}

// A type nobody can name yet reads as `?`, never as an empty string:
// the diagnostic still has to say something stood where the payload
// belongs.
name_of_or = (be :: CBackend, ty: TyId) Res<String, AllocError> {
    be.check.types.name_of(ty).match({
        Ok(n) => Ok(n),
        None  => be.alloc.String("?"),
    })
}

write_break_value = (be :: CBackend, c: Call, fr: LoopFrame, ctx: Ctx)
                    Res<(), AllocError> {
    c.args.get(0).match({
        None  => Ok(()),
        Ok(a) => be.assign_ok(a.value, fr, ctx),
    })
}

assign_ok = (be :: CBackend, value: ExprId, fr: LoopFrame, ctx: Ctx)
            Res<(), AllocError> {
    payload = ok_payload(be, fr.ty).try();
    cty ::= be.alloc.String().try();
    be.ctype(fr.ty, cty).try();
    tag ::= be.alloc.String().try();
    sym_variant(tag, RES_PATH, "Ok").try();
    line ::= be.alloc.String().try();
    line.fmt(
        "{} = ({}){ .zg_tag = {}",
        fr.result,
        cty.view(),
        tag.view()
    ).try();
    be.is_unit(payload).match({
        true  => Ok(()),
        false => write_ok_payload(be, value, payload, ctx, line),
    }).try();
    line.add_bytes(" };").try();
    be.writeln(line.view())
}

write_ok_payload = (
    be      :: CBackend,
    value   : ExprId,
    payload : TyId,
    ctx     : Ctx,
    line    :: String
) Res<(), AllocError> {
    mem ::= be.alloc.String().try();
    sym_member(mem, "Ok").try();
    line.fmt(", .zg_data.{} = ", mem.view()).try();
    expr(be, value, ctx, payload, line).try();
    Ok(());
}

ok_payload = (be :: CBackend, ty: TyId) Res<TyId, AllocError> {
    be.check.types.at(ty).match({
        Res(r) => Ok(r.value),
        _      => be.check.types.prim("()"),
    })
}

// A jump is a STATEMENT and the call it came from is an expression, so
// the `goto` goes to the buffer and a `0` goes where the value would
// have been. Nothing reads that `0`: control has already left.
jump_to = (be :: CBackend, stem: str, n: usize, out :: String)
          Res<(), AllocError> {
    be.write("goto ").try();
    be.write_label(stem, n).try();
    be.writeln(";").try();
    out.add_bytes("0")
}
