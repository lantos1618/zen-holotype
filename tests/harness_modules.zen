        ),
        ModValCase(
            files: [
                ModFile(
                    name: "p.zen",
                    src: "rt = std.rt\nmain = () i32 {\n  p := rt.alloc(8)\n  p.store_i64(1234)\n  v := p.load_i64()\n  rt.release(p)\n  (v == 1234).match ({ true => 3, false => 1 })\n}\n",
                ),
            ],
