// `consume` of an ELEMENT. `bufs[0]` is not a place the checker can
// track: the index is a runtime value, so "which element is dead" is
// not a fact the compiler holds, and the array still drops all two.
//
// a struct field is a fixed place and gets tracked (see
// consume_field_then_use.zen). an element is not, and the difference
// is the whole point of this file.

Buf = {
    id: i32,
}

Buf.impl(Drop, {
    drop = (self :: @Self) () { /* nothing to release: id is bytes */ }
})

main = (env: Env) Res<i32, IoError> {
    bufs = [Buf, 2](Buf(id: 1), Buf(id: 2));
    b = consume bufs[0];
    println("{}", b.id);
    Ok(0);
}
