// the literal form and the named constant must be the same value.
Error = AllocError | IoError

same = (a: i32, b: i32) str {
    (a == b).match({
        true  => "yes",
        false => "no",
    })
}

main = (env: Env) Res<i32, Error> {
    println("{}", same(-2147483648, i32.MIN));
    println("{}", same(2147483647, i32.MAX));
    Ok(0);
}
