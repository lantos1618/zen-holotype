// src/zen/zen_build.zen
// `zen build`: the five phases, wired together.
//
//     read -> lex -> parse -> check -> emit
//
// A DIAGNOSTIC IS A VALUE, AND SO IS A FAILED READ. The only `Err` here
// is `AllocError`, the only one the seed subset allows (PLAN.md 0.5 has
// no error unions, so a function that both opens a file and allocates
// can't name two failures). A file that won't open is counted and
// printed like a syntax error; the walk carries on — the second mistake
// in a build is worth as much as the first.
//
// THE MODULE TREE IS COMPUTED, NOT DISCOVERED: `std.env.Fs` has no
// listing, on purpose — a module path is `<folder>/<folder>.zen`, so
// every path here is built from an import's segments and ruled out
// with a stat.
//
// THE PROGRAM IS ONE `Ast`: one counter hands out every id, so an id
// means the same thing in every module. `Build.tree` says what that
// costs and when the tree is finished.
//
// OVER 500 LINES, JUSTIFIED BY STYLE.md: the subject is one build and
// its parts are that build's five phases, sharing the `Build` that
// holds the tree, tally and authority — splitting the walk from the
// check would put the `Ast` in one file and the thing that finishes it
// in another. What is NOT about a build has left: what a module is
// CALLED and where its bytes ARE is `zen_path.zen`, free functions, so
// a second driver reads one rule.

Alloc, AllocError = std.mem
str, String = std.text
Vec, Map = std.collections
Range = std.core
FsError = std.env

Ast = std.ast.ast_arena
Module, Alias, Named = std.ast.ast_node
Pos, Span, QualifiedName = std.ast.ast_span

// THE `Diag` COLLISION: `lex`, `parse` and `sema` each export a type
// called `Diag` plus a `message`, and `A, B = module` cannot rename, so
// a driver can't import all three flat.
//
// BUG, reported: aliasing the module and qualifying through it (pinned
// by `tests/corpus/modules/module_alias_qualified`) DOES NOT WORK for a
// name two modules declare — `lexer = lex` then `lexer.message(d.fault)`
// lowered to the wrong module's function, with the alias as receiver.
//
// What works: a flat import of the ONE `message` this file wants. That
// answers the collision only because this driver never needs two at
// once; a driver that did would need rename-on-import.
message = std.lex.lex

// WHAT A DIAGNOSTIC IS ONCE IT LEAVES A PHASE — `parse`'s type, per
// that file's own header: a compiler type, not a parser type.
Diag, diag, say = std.parse.parse_diag

scan, Source, Lexed = std.lex.lex
Parser, module = std.parse.parse
Checker, check_all = sema.sema
PRELUDE, last_segment = sema.sema
check_module_graph = sema.sema
Def = sema.sema
Emit, CBackend, emit_program = gen.gen
lower_program, emit_header, emit_unit, unit_used = gen.gen

Job = zen.zen_cli

// What a module PATH means is not a phase of a build, so it lives in
// `zen_path.zen`. Only the ones called by BARE NAME are here:
// `base_of`/`after_last_slash` take a `str` first and are reached
// through the value.
slash_for = zen.zen_path
unit_at, candidate, joined, relative_to = zen.zen_path

// WHERE A PROGRAM STARTS is a fact about a path too: `ENTRY` is the
// module name the probe looks for AND the declaration
// `root_declares_main` demands, so the two cannot drift.
ENTRY, entry_of = zen.zen_path

Unit* = zen.zen_path

// What order the walk reaches modules in: arithmetic on an index.
walk_index = zen.zen_order

// One build. It holds the authority the phases need and the tally of
// what went wrong, because the exit code is that tally and both
// `tests/run.py` and `scripts/fixpoint.sh` read it.
Build* = {
    env*: Env,
    alloc*: Alloc,
    root*: str,

    faults* :: usize = 0,
    units* :: usize = 0,

    // EVERY LEX AND PARSE DIAGNOSTIC THIS BUILD FOUND, in order found;
    // `faults` is only the count. `publishDiagnostics` needs the span,
    // sentence and location as VALUES (docs/design_lsp.md §5); a server
    // re-lexing for positions the driver already had is the second
    // implementation that document exists to prevent.
    //
    // SEMA'S ARE NOT IN HERE: a `SemaFault` renders against the type
    // store that decided it, and the `Checker` holding both already
    // answers `diag_count`.
    diags* :: Vec<Diag>,

    // WHICH ORDER THE WALK REACHES MODULES IN; empty is written-import
    // order. `zen_order.zen` is the whole of it.
    permute* :: str = "",

    // Mutation of an exported field goes through an exported method —
    // the order is a DEBUG flag a command line decides.
    walk_order* = (self :: @Self, order: str) () {
        self.permute = order;
    }

    // THE EDITOR'S BUFFER, BEFORE THE DISK — keyed on `Unit.path`, the
    // string `read` is handed. design_lsp.md §5 chose this over an `Fs`
    // the server writes: `Fs`'s members have no bodies (they ARE the
    // authority), so interposing there is a language feature and this
    // is one field.
    //
    // EMPTY IN EVERY BUILD A COMMAND LINE ASKS FOR — a constraint, not
    // a hope: `run_once` never touches it, so `zen build` misses on the
    // first lookup and reads the disk exactly as before
    // (scripts/fixpoint.sh says so).
    overlay* :: Map<str, str>,

    // WHETHER A DIAGNOSTIC IS SAID OUT LOUD as found. True for a
    // command line; false for `whole`, since a language server writes
    // JSON-RPC frames to stdout and NOTHING else (design_lsp.md §6),
    // and a driver `println` would corrupt the protocol stream. `diags`
    // fills either way — only the saying is off.
    speaking* :: bool = true,

    // The entry's path relative to the root, kept for the one
    // diagnostic about the root itself rather than a span — see
    // `missing_main`.
    entry_rel* :: str = "",

    // THE PROGRAM'S TREE — exactly one. Every parser is built around it
    // and hands it back, so an `ExprId` from module 91 and one from
    // module 1 are indices into the same arena.
    //
    // PRECONDITION: FINISHED before `alloc.Checker(tree)`
    // (SEMA_BOOTSTRAP_FIXES.md §12) — a `Checker` copies the `Ast` as a
    // value, so the copy is a snapshot. `walk` completes before
    // `back_end` is called; nothing adds a node after that.
    tree* :: Ast,

    // -----------------------------------------------------------------
    // the walk
    // -----------------------------------------------------------------

    // The whole program, breadth first from the entry. `seen` is both
    // queue and set: a module reached twice is added once, and the index
    // walks a still-growing list — a worklist as a Vec, not a recursion.
    walk* = (self :: @Self, entry: Unit) Res<(), AllocError> {
        seen ::= self.alloc.Vec<Unit>();
        self.entry_rel = entry.rel;
        seen.add(entry).try();
        self.seed_prelude(seen).try();
        i ::= 0;
        loop(() { i < seen.len }, (h) {
            u = seen.get(i).match({ Ok(v) => v, None => entry });
            i = i + 1;
            self.front(u, seen).try();
        });
        Ok(());
    }

    // THE ONE IMPORT NOBODY WRITES: `std.core` is in every module, so
    // `Res`/`Ok`/`Vec`/`Map`/`str`/`Env` are in scope without a line —
    // and a walk that follows imports never follows the line that is
    // not there.
    //
    // PROBED, NOT REQUIRED: a root with no `std/` beside it is a program
    // with no prelude, which `World.prelude_index` already answers
    // `None` to, and which the small tests in tests/corpus are. A
    // missing prelude is not a fault.
    seed_prelude = (self :: @Self, seen :: Vec<Unit>) Res<(), AllocError> {
        flat = self.dotted_path(PRELUDE, false).try();
        self.env.fs.exists(flat).match({
            true  => self.queue(flat, seen),
            false => self.seed_prelude_folder(seen),
        })
    }

    seed_prelude_folder = (self :: @Self, seen :: Vec<Unit>)
                          Res<(), AllocError> {
        nest = self.dotted_path(PRELUDE, true).try();
        self.env.fs.exists(nest).match({
            true  => self.queue(nest, seen),
            false => Ok(()),
        })
    }

    // `file_of`'s rule over a DOTTED STRING rather than a parsed
    // `QualifiedName`: the prelude is named by a constant with no
    // import behind it, so there's no AST node to read segments off.
    dotted_path = (self: @Self, dotted: str, folder: bool)
                  Res<str, AllocError> {
        out ::= self.alloc.String("{}/", self.root).try();
        Range(0, dotted.len).loop((h, i) {
            out.add_byte(slash_for(dotted.index(i))).try();
        });
        folder.then(() { out.fmt("/{}", last_segment(dotted)).try() });
        out.add_bytes(".zen").try();
        Ok(out.view());
    }

    // -----------------------------------------------------------------
    // one module: read, lex, parse
    // -----------------------------------------------------------------

    front = (self :: @Self, u: Unit, seen :: Vec<Unit>) Res<(), AllocError> {
        self.read(u.path).match({
            None     => Ok(()),
            Ok(text) => self.lex_it(u, text, seen),
        })
    }

    // THE OVERLAY FIRST, THE DISK SECOND — a miss is the whole of what
    // a build without an editor attached does.
    read = (self :: @Self, path: str) Res<str> {
        self.overlay.get(path).match({
            Ok(text) => Ok(text),
            None     => self.read_disk(path),
        })
    }

    // A `str` NOT A `String`: the walk only `view()`s the bytes — scan
    // holds spans into them and parse reads those back, so the buffer
    // already had to outlive the `String` local. `str` lets one branch
    // above hand back a buffer it does not own.
    read_disk = (self :: @Self, path: str) Res<str> {
        self.env.fs.read(self.alloc, path).match({
            Ok(text) => Ok(text.view()),
            Err(e)   => self.fs_fault(path, e),
        })
    }

    // COUNTED, SAID AND HELD. Reached by the ENTRY and by a read that
    // fails after the probe (the file left between `import_path` and
    // `read`, or the failure is not absence at all) — for those the
    // file itself IS the subject, so the span is its first position.
    // An import whose target is absent never gets here: `missing_import`
    // anchors that fault at the import, where the fix goes.
    //
    // HELD because a language server builds with `speaking` false, and
    // collecting is then the ONLY way a missing module reaches
    // `publishDiagnostics` — an unreadable import otherwise surfaced
    // only as phantom `undefined name` faults downstream.
    fs_fault = (self :: @Self, path: str, e: FsError) Res<str> {
        self.faults = self.faults + 1;
        self.speaking.then(() { println("{}: {}", path, fs_message(e)); });
        at = Span(
            file: relative_to(self.root, path),
            start: Pos(line: 1, col: 1),
            end: Pos(line: 1, col: 1),
        );
        // An allocation failure DROPS the held copy — `Res<str>`'s
        // `None` already means "the read failed", and the fault is
        // counted and said either way.
        self.diags.add(diag(fs_message(e), at)).match({
            Ok(_)  => (),
            Err(_) => (),
        });
        None;
    }

    // ONE DIAGNOSTIC, HELD AND SAID, never one without the other.
    //
    // SAID OFF THE VEC, NOT OFF THE ARGUMENT, which makes the
    // collection load-bearing rather than a copy nobody reads: a
    // `diags` that stopped collecting would also go silent, and all 117
    // of `tests/must-fail` would say so. Said HERE, not in a pass at the
    // end — keeps stdout byte-identical, a failed READ prints as the
    // walk reaches it.
    report = (self :: @Self, d: Diag) Res<(), AllocError> {
        at          = self.diags.len;
        self.faults = self.faults + 1;
        self.diags.add(d).try();
        self.diags.get(at).match({
            Ok(held) => self.speaking.then(() { held.say(); }),
            None     => (),
        });
        Ok(());
    }

    // A FILE WITH LEXICAL FAULTS IS REPORTED AND NOT PARSED — lex.zen's
    // contract, not a shortcut: a parser's opinion of the wreckage
    // would only be a second diagnostic for one mistake.
    lex_it = (self :: @Self, u: Unit, text: str, seen :: Vec<Unit>)
             Res<(), AllocError> {
        lexed = scan(self.alloc, Source(file: u.rel, text: text)).try();
        lexed.is_clean().match({
            false => self.lex_faults(lexed),
            true  => self.parse_it(u, lexed, seen),
        })
    }

    // A LEXICAL FAULT TAKES THE DRIVER'S SHAPE HERE: `LexFault` is an
    // enum whose sentence is `message`; a lex `Span` carries byte
    // OFFSETS and no file. No note — the lexer builds none.
    lex_faults = (self :: @Self, lexed: Lexed) Res<(), AllocError> {
        lexed.diags.loop((h, d) {
            at = Span(
                file: d.file,
                start: Pos(line: d.span.start.line, col: d.span.start.col),
                end: Pos(line: d.span.end.line, col: d.span.end.col),
            );
            self.report(diag(message(d.fault), at)).try();
        });
        Ok(());
    }

    // ONE TREE, HANDED ALONG. The parser is built around the tree the
    // walk has filled so far and hands it back before the next module
    // is lexed. One parser alive at a time is what makes passing an
    // `Ast` by value sound: a `Vec` is a header, and two owners would
    // diverge the first time either grew.
    //
    // The walk queues the entry first, so module 0 is the root — what
    // `emit_c` passes to the backend and what `DefId.module` indexes.
    parse_it = (self :: @Self, u: Unit, lexed: Lexed, seen :: Vec<Unit>)
               Res<(), AllocError> {
        p ::= self.alloc.Parser(lexed, self.tree);
        m = p.module(u.name).try();
        // Already the driver's shape, note and all: moved, not rebuilt.
        p.diags.loop((h, d) { self.report(d).try(); });
        p.tree.add_module(m).try();
        self.tree  = p.tree;
        self.units = self.units + 1;
        self.imports_of(m, seen).try();
        Ok(());
    }

    // Every module this one names, queued. An import is the only
    // declaration reaching outside the file — except the one below it,
    // which is why this matches two kinds and not one.
    //
    // BY INDEX, NOT `loop`: `walk_index` decides the walk's order. Per
    // module, not over the finished worklist, since discovery and
    // parsing interleave — parsing `seen[i]` appends its imports, so no
    // whole list ever exists to shuffle.
    imports_of = (self :: @Self, m: Module, seen :: Vec<Unit>)
                 Res<(), AllocError> {
        Range(0, m.decls.len).loop((h, i) {
            m.decls.get(walk_index(self.permute, m.decls.len, i)).match({
                None  => Ok(()),
                Ok(d) => d.kind.match({
                    Import(im) => self.enqueue(im.module, seen),
                    Alias(al)  => self.alias_of(al, seen),
                    _          => Ok(()),
                }),
            }).try();
        });
        Ok(());
    }

    enqueue = (self :: @Self, q: QualifiedName, seen :: Vec<Unit>)
              Res<(), AllocError> {
        // A parse-broken import recovers with an EMPTY segment
        // (`parser.zen`'s `ident_missing` reports the real fault and
        // returns `Ident(text: "")` so parsing can carry on). Walking
        // that name would probe `<root>//.zen` and report a second fault
        // against a file nobody wrote — the parse fault beside it is the
        // whole story, so the walk stops here.
        q.segments.find((s) { s.text.is_empty() }).match({
            Ok(_) => Ok(()),
            None  => {
                flat   = joined(self.alloc, self.root, q, false).try();
                folder = joined(self.alloc, self.root, q, true).try();
                self.import_path(flat, folder).match({
                    Ok(path) => {
                        self.queue(path, seen).try();
                        self.folder_root(path, seen)
                    },
                    None     => self.missing_import(q),
                })
            },
        })
    }

    // WHERE THE BYTES AN IMPORT NAMES ARE, OR NOWHERE. `file_of` cannot
    // answer this: it picks the folder form the moment the flat probe
    // misses, and it asks the DISK only — a module that exists so far
    // only as an editor buffer is in the overlay, and a probe that
    // skipped it would fault a file the user is looking at. The order
    // here is `read`'s order, per shape: overlay first, disk second.
    import_path = (self :: @Self, flat: str, folder: str) Res<str> {
        self.overlay.get(flat).match({
            Ok(_) => Ok(flat),
            None  => self.import_path_disk(flat, folder),
        })
    }

    import_path_disk = (self :: @Self, flat: str, folder: str) Res<str> {
        self.env.fs.exists(flat).match({
            true  => Ok(flat),
            false => self.import_path_folder(folder),
        })
    }

    import_path_folder = (self :: @Self, folder: str) Res<str> {
        self.overlay.get(folder).match({
            Ok(_) => Ok(folder),
            None  => self.env.fs.exists(folder).match({
                true  => Ok(folder),
                false => None,
            }),
        })
    }

    // A MISSING IMPORT IS ANCHORED AT THE IMPORT, never at the absent
    // file: `q.span` covers the whole dotted name in the module that
    // WROTE it, which is where the fix goes. Pinning the fault on the
    // missing path instead (what `fs_fault` must do for the entry, whose
    // own absence is the subject) handed the language server a
    // diagnostic under a URI that exists nowhere — an unopenable
    // problem-panel entry for `add_expr/add_expr.zen` and every name
    // like it. "One mistake, one diagnostic, anchored where the fix
    // goes." Two imports of the same absent module are two diagnostics,
    // one per site — two places to fix.
    missing_import = (self :: @Self, q: QualifiedName)
                     Res<(), AllocError> {
        self.report(diag(fs_message(FsError.NotFound), q.span))
    }

    // A NESTED MODULE TRAVELS WITH ITS FOLDER — the one place an
    // import-driven walk has to admit UFCS is not import-driven.
    //
    // DESIGN.md's UFCS candidate set (members of `x`'s type, its
    // impls'/bounds' methods, every exported free function whose FIRST
    // PARAMETER TYPE is `x`'s type) is a whole-program query, so
    // `c.type_of(id, ctx)` depended on which modules the walk happened
    // to load — a program's MEANING is not a loader's to decide. It bit
    // where the rule is written down: `sema_check.zen` does NOT import
    // `sema_type.zen` on purpose, since `type_of` reaches a `Checker` BY
    // UFCS, and the four `tests/corpus/sema_zen/` LSP-query programs
    // said so as "codegen has no type for".
    //
    // THE FOLDER ROOT IS THE ANSWER, THE WHOLE TREE IS NOT: a folder
    // root is a file of starred re-exports, so queueing it pulls in
    // exactly the siblings that complete the pool. A MODULE THAT IS ITS
    // OWN FOLDER ROOT queues nothing more — the walk climbs one level,
    // never to the compilation root.
    folder_root = (self :: @Self, path: str, seen :: Vec<Unit>)
                  Res<(), AllocError> {
        cut = path.after_last_slash();
        (cut > self.root.len + 1).match({
            false => Ok(()),
            true  => self.queue_folder_root(path.slice(0, cut - 1), path, seen),
        })
    }

    // Probed, not required, like the entry probe: a folder with no root
    // file is one the module graph would reject on its own terms;
    // reporting it here would blame the import living next to it.
    queue_folder_root = (self :: @Self, dir: str, path: str, seen :: Vec<Unit>)
                        Res<(), AllocError> {
        root_file ::= self.alloc.String("{}/{}.zen", dir, dir.base_of()).try();
        skip = root_file.view().eq(path)
            || !self.env.fs.exists(root_file.view());
        skip.match({
            true  => Ok(()),
            false => self.queue(root_file.view(), seen),
        })
    }

    // Queued on the PATH: the path is the module, a spelling is only a
    // way of writing it — `std.core` and `std.core.core` reach one file
    // and must reach one `Unit`.
    queue = (self :: @Self, path: str, seen :: Vec<Unit>)
            Res<(), AllocError> {
        seen.find((u) { u.path.eq(path) }).match({
            Ok(_) => Ok(()),
            None  => self.queue_fresh(path, seen),
        })
    }

    queue_fresh = (self :: @Self, path: str, seen :: Vec<Unit>)
                  Res<(), AllocError> {
        seen.add(unit_at(self.alloc, self.root, path).try())
    }

    // A MODULE ALIAS IS AN `Alias`, NOT AN `Import`: `sh = shape` and
    // `Alias = Shape` are the same three tokens, and only name
    // resolution can tell which — a syntactic walk, which this
    // necessarily is since it runs before sema, cannot know.
    //
    // A bare single-segment target is a CANDIDATE: probed, queued only
    // when a file is actually there. The probe cannot live in `enqueue`,
    // since a missing file behind a real import is a fault that must
    // stay one.
    alias_of = (self :: @Self, al: Alias, seen :: Vec<Unit>)
               Res<(), AllocError> {
        self.tree.type_at(al.target).kind.match({
            Named(n) => self.alias_named(n, seen),
            _        => Ok(()),
        })
    }

    // `Vec<u8>` names no module: a module path takes no type arguments.
    alias_named = (self :: @Self, n: Named, seen :: Vec<Unit>)
                  Res<(), AllocError> {
        (n.args.len == 0).match({
            false => Ok(()),
            true  => self.probe(n.name.text, seen),
        })
    }

    probe = (self :: @Self, name: str, seen :: Vec<Unit>)
            Res<(), AllocError> {
        u = candidate(self.env, self.alloc, self.root, name).try();
        self.env.fs.exists(u.path).match({
            false => Ok(()),
            true  => self.queue(u.path, seen),
        })
    }

    // -----------------------------------------------------------------
    // check
    // -----------------------------------------------------------------

    // A WHOLE BUILD, FOR A READER THAT IS NOT A COMMAND LINE. `zen
    // build` ends at an exit code, and that was once the only way in —
    // so the language server (wanting the tree, the Checker's memos, the
    // diagnostics) had no entry point and checked the open document as a
    // lone module: every imported name was poison, and hover (which
    // refuses poison) went silent on every real file.
    //
    // NO EMIT, NO SAYING: no program to produce, only a question to
    // answer. `faults`/`diags` still hold what went wrong as values, for
    // `publishDiagnostics`.
    //
    // `run_once` is deliberately NOT written in terms of this: a command
    // line's build reports as it goes and emits at the end, and folding
    // both orders into one method to save four lines is how a build's
    // stdout moves by a byte.
    whole* = (self :: @Self, named: str, docs: Map<str, str>)
             Res<Checker, AllocError> {
        self.overlay  = docs;
        self.speaking = false;
        entry         = entry_of(self.env, self.alloc, self.root, named).try();
        self.walk(entry).try();
        self.checked()
    }

    // WHERE A `Checker` COMES FROM, the only place.
    //
    // HANDED BACK, NOT STORED IN A FIELD: a `Checker`'s `Map`s are
    // headers, so a copy kept on `Build` would silently stop agreeing
    // with the one `emit` goes on using.
    checked* = (self :: @Self) Res<Checker, AllocError> {
        c ::= self.alloc.Checker(self.tree).try();
        c.check_all().try();
        Ok(c);
    }

    // Check and emit are ONE method since they share a `Checker`:
    // `CBackend` takes the sema built, so a type is decided once and the
    // backend never re-derives it.
    //
    // NOTHING PARSED IS NOT AN ERROR HERE: the read or lex already said
    // why, and complaining about sema too would break "one mistake, one
    // diagnostic".
    //
    // SYNTAX FAULTS DO NOT SKIP THE CHECK (this file's header: the
    // second mistake is worth as much as the first). A poison node types
    // as unknown, which is what it is for; the tally already counted the
    // syntax error.
    back_end* = (self :: @Self, job: Job) Res<(), AllocError> {
        (self.units == 0).match({
            true  => Ok(()),
            false => self.check_tree(job),
        })
    }

    // `check_all` IS THE WALK; a driver does not write its own.
    // `sema_decl.zen` is deliberately the only walk in the folder,
    // knowing the protocol a driver does not: a body's params, type
    // params and bounds must be in scope while `block_type` walks it,
    // then leave before the next declaration. A driver calling
    // `block_type` on each body itself once reported every parameter of
    // every function undefined.
    check_tree = (self :: @Self, job: Job) Res<(), AllocError> {
        c      ::= self.checked().try();
        report ::= self.alloc.String("").try();
        c.render_diags(report).try();
        // TWO RULES ARE ABOUT THE MODULE GRAPH, not any node in it, so
        // `check_all`'s walk never asks them: a module importing itself,
        // and a top-level constant needing a value from a module whose
        // own needs it back. Kept ahead of `emit` — a constant cycle has
        // no initialisation order.
        n           = c.diag_count()
          + check_module_graph(self.alloc, self.tree, c.world, report).try();
        self.faults = self.faults + n;
        (n > 0).then(() { println("{}", report.view()); });
        absent      = self.main_check(c, job).try();
        self.faults = self.faults + absent;
        // THE WHOLE TALLY, NOT SEMA'S ALONE. This once read `n + absent`
        // — every fault except what the LEXER/PARSER found — so a file
        // with a syntax error and no name errors was handed to the
        // backend anyway, which said "codegen does not lower this yet"
        // about the poison node the parser had already reported: two
        // sentences, one mistake.
        (self.faults == 0).then(() { self.emit(c, job).try(); });
        Ok(());
    }

    // ONE MISTAKE, ONE DIAGNOSTIC. A file that failed to lex or parse
    // is a FRAGMENT: `main` is not reliably among what it declares, so
    // asking asks a question the earlier fault already answered.
    // `must-fail/lex/bom_mid_file` was once told its byte-order mark was
    // misplaced AND that it declared no program — two sentences, one
    // mistake.
    main_check = (self :: @Self, c :: Checker, job: Job)
                 Res<usize, AllocError> {
        (self.faults == 0).match({
            false => Ok(0),
            true  => self.missing_main(c, job),
        })
    }

    // LAW 2 IS A LAW ABOUT PROGRAMS; a root declaring no `main` is not
    // one. Nothing else in the pipeline notices: an empty file lexes
    // clean, parses to a module with no declarations, checks without
    // complaint, emits a translation unit linking to nothing — so the
    // compiler once reported success for a file with no program, and
    // `tests/must-fail/lex/empty_file`/`only_comments` sat red.
    //
    // MODULE 0 AND `own_defs`, both deliberately: the walk queues the
    // entry first, and `defs_of` would fall through to imports then the
    // prelude — a `main` ANYWHERE in the program would answer for the
    // one the root owes.
    //
    // ASKED ONLY WHEN A PROGRAM IS BEING PRODUCED: `tests/corpus/cli/`
    // points the driver at a library on purpose to measure the entry
    // probe; demanding `main` of a build that emits nothing fails those.
    missing_main = (self :: @Self, c :: Checker, job: Job)
                   Res<usize, AllocError> {
        job.emit_c.match({
            false => Ok(0),
            true  => self.root_declares_main(c),
        })
    }

    root_declares_main = (self :: @Self, c :: Checker) Res<usize, AllocError> {
        found ::= self.alloc.Vec<Def>();
        c.world.own_defs(0, ENTRY, found).try();
        (found.len > 0).match({
            true  => Ok(0),
            false => self.no_main(),
        })
    }

    // 1:1, because the mistake is the file and not a place in it.
    no_main = (self :: @Self) Res<usize, AllocError> {
        println(
            "{}:1:1: no `{}`: law 2 makes `main = (env: Env) Res<i32, E>` where a program starts, and this root declares none",
            self.entry_rel,
            ENTRY
        );
        Ok(1);
    }

    // -----------------------------------------------------------------
    // emit
    // -----------------------------------------------------------------

    // A PROGRAM SEMA AGREED IS A PROGRAM, only then: handing the
    // backend a tree with unresolved names turns one diagnostic into a
    // second, worse one — why `check_tree` calls this only at zero.
    emit = (self :: @Self, c :: Checker, job: Job) Res<(), AllocError> {
        job.emit_c.match({
            false => Ok(()),
            true  => self.emit_c(c, job),
        })
    }

    // TWO SHAPES OF THE SAME PROGRAM. `-o <file.c>` is one translation
    // unit and stays the whole of what the committed seed is built by;
    // `--emit-c-dir <dir>` is one file per module beside a `zen.h`,
    // which a C compiler builds in parallel and a compiler cache can
    // skip a module of. Neither changes what is lowered.
    emit_c = (self :: @Self, c :: Checker, job: Job) Res<(), AllocError> {
        job.dir.is_empty().match({
            true  => self.emit_one(c, job),
            false => self.emit_many(c, job),
        })
    }

    emit_one = (self :: @Self, c :: Checker, job: Job) Res<(), AllocError> {
        be  ::= self.alloc.CBackend(self.tree, c).try();
        out ::= self.alloc.Emit().try();
        emit_program(be, 0, out).try();
        report ::= self.alloc.String("").try();
        be.render_diags(report).try();
        n           = be.diag_count();
        self.faults = self.faults + n;
        (n > 0).then(() { println("{}", report.view()); });
        (n == 0).then(() { self.deliver(job, out).try(); });
        Ok(());
    }

    // THE DIAGNOSTICS ARE READ BEFORE ONE BYTE IS WRITTEN, exactly as
    // above: the header is assembled first because assembling it is
    // what emits the type definitions, and everything a unit adds after
    // that is bytes already lowered.
    emit_many = (self :: @Self, c :: Checker, job: Job) Res<(), AllocError> {
        be ::= self.alloc.CBackend(self.tree, c).try();
        be.use_externs();
        lower_program(be, 0).try();
        hdr ::= self.alloc.Emit().try();
        emit_header(be, hdr).try();
        report ::= self.alloc.String("").try();
        be.render_diags(report).try();
        n           = be.diag_count();
        self.faults = self.faults + n;
        (n > 0).then(() { println("{}", report.view()); });
        (n == 0).then(() { self.write_units(be, job, hdr).try(); });
        Ok(());
    }

    write_units = (self :: @Self, be :: CBackend, job: Job, hdr: Emit)
                  Res<(), AllocError> {
        self.write_at(job.dir, "zen.h", hdr.view()).try();
        Range(0, self.tree.module_count()).loop((h, u) {
            self.write_unit(be, job, u).try();
        });
        Ok(());
    }

    // MODULE 0 IS WRITTEN WHATEVER IT HOLDS: it is the root, and `main`
    // is emitted into it. Every other module with no body of its own
    // contributes no file, because an empty one still costs a process.
    write_unit = (self :: @Self, be :: CBackend, job: Job, u: usize)
                 Res<(), AllocError> {
        ((u == 0) || unit_used(be, u)).match({
            false => Ok(()),
            true  => self.write_unit_at(be, job, u),
        })
    }

    write_unit_at = (self :: @Self, be :: CBackend, job: Job, u: usize)
                    Res<(), AllocError> {
        out ::= self.alloc.Emit().try();
        emit_unit(be, 0, u, out).try();
        name ::= self.alloc.String().try();
        self.unit_file(be, u, name).try();
        self.write_at(job.dir, name.view(), out.view())
    }

    // THE FILE IS NAMED FOR THE MODULE, dots and all, because the
    // module path is already the one name no two modules share — a
    // counter would renumber every file when one module was added, and
    // a renamed file is a compiler-cache miss.
    unit_file = (self :: @Self, be :: CBackend, u: usize, out :: String)
                Res<(), AllocError> {
        self.tree.module_at(u).match({
            None  => out.add_bytes("zg_unit"),
            Ok(m) => out.add_bytes(m.name),
        }).try();
        out.add_bytes(".c")
    }

    write_at = (self :: @Self, dir: str, name: str, bytes: str)
               Res<(), AllocError> {
        path ::= self.alloc.String().try();
        path.fmt("{dir}/{name}").try();
        self.env.fs.write(path.view(), bytes).match({
            Ok(_)  => Ok(()),
            Err(e) => self.unit_write_failed(path.view(), e),
        })
    }

    unit_write_failed = (self :: @Self, path: str, e: FsError)
                        Res<(), AllocError> {
        self.faults = self.faults + 1;
        println("--emit-c-dir {}: {}", path, fs_message(e));
        Ok(());
    }

    // WHERE THE BYTES GO. `-o <path>` writes the file; no `-o` sends C
    // to stdout (what `-o -` would mean anyway).
    //
    // A write that fails is a fault, not a trap: a full disk or
    // unwritable path is a thing the caller acts on, and
    // `scripts/fixpoint.sh` compares files that have to exist.
    deliver = (self :: @Self, job: Job, out: Emit) Res<(), AllocError> {
        job.out.is_empty().match({
            true  => { println("{}", out.view()); Ok(()) },
            false => self.write_out(job, out),
        })
    }

    write_out = (self :: @Self, job: Job, out: Emit) Res<(), AllocError> {
        self.env.fs.write(job.out, out.view()).match({
            Ok(_)  => Ok(()),
            Err(e) => self.write_failed(job, e),
        })
    }

    write_failed = (self :: @Self, job: Job, e: FsError) Res<(), AllocError> {
        self.faults = self.faults + 1;
        println("-o {}: {}", job.out, fs_message(e));
        Ok(());
    }

    // -----------------------------------------------------------------

    // HOW MANY, on one line, last. "One mistake produces one
    // diagnostic" is a claim about a NUMBER, and a compiler printing
    // diagnostics but not its count leaves that unmeasurable —
    // `tests/run.py` reads this line to enforce a `.count` sidecar.
    tally* = (self: @Self) () {
        (self.faults > 0).then(
            () { println("zen: {} diagnostic(s)", self.faults); }
        );
    }

    // WHAT THIS BUILD FOUND, as values — deliberately the same pair
    // `Checker` exports, so one reader shape serves both.
    diag_count* = (self: @Self) usize { self.diags.len }

    diag_at* = (self: @Self, i: usize) Res<Diag> { self.diags.get(i) }

    // 0 when clean, 1 when anything went wrong. One code, not one per
    // phase: a caller acts on "did this produce a program", and
    // `tests/run.py`/`scripts/fixpoint.sh` both read exactly that.
    code* = (self: @Self) i32 {
        (self.faults == 0).match({
            true  => 0,
            false => 1,
        })
    }
}

Build* = (a: Alloc, env: Env, root: str) Build {
    Build(
        env: env,
        alloc: a,
        root: root,
        tree: a.Ast(),
        diags: a.Vec<Diag>(),
        overlay: a.Map<str, str>()
    )
}

// What went wrong with a file. Every one of these names what actually
// happened, because "bad arguments" is not a reason and neither is
// "io error".
fs_message* = (e: FsError) str {
    e.match({
        NotFound    => "nothing is at that path",
        Denied      => "this process may not read it",
        IsDir       => "the path names a directory, and a directory is not bytes",
        Failed      => "the read started and did not finish",
        OutOfMemory => "the buffer could not be obtained",
    })
}
