// the file's last byte is the closing brace: no trailing newline.
//
// This one can only fail LOUDLY -- drop the last byte and the file does not
// parse -- so what it adds beyond compile-survival is that the value on the
// final statement line is COMPUTED, not a constant string: a lexer that
// mangles the last token before EOF cannot print the right number by
// accident. comment_at_eof_no_newline is the same EOF shape with a comment
// as the last token instead of code.
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    n: i32 = 40;
    println("{} {}", n + 2, n * 2);
    Ok(0);}