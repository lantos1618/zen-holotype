// src/lsp/lsp_uri.zen
// The protocol names documents by URI; Fs opens paths. Keep that
// conversion here so every LSP feature agrees about the same document.

str, String = std.text
Alloc, AllocError = std.mem

FILE_SCHEME*: str = "file://"
REMOTE_SCHEME: str = "vscode-remote://"

// This borrowed form handles conversions that need no new bytes. Paths
// and unknown schemes stay unchanged rather than risking a wrong file.
// Percent decoding needs owned output, which this interface cannot make.
path_of* = (uri: str) str {
    uri.starts_with(FILE_SCHEME).match({
        true  => uri.slice(FILE_SCHEME.len, uri.len),
        false => uri.starts_with(REMOTE_SCHEME).match({
            true  => remote_path(uri),
            false => uri,
        }),
    })
}

// VS Code Remote runs the server on the remote host. Its URI authority
// selects that host; only the absolute path is meaningful to its Fs.
remote_path = (uri: str) str {
    tail = uri.slice(REMOTE_SCHEME.len, uri.len);
    tail.find('/').match({
        Ok(at) => tail.slice(at, tail.len),
        None   => uri,
    })
}

// URI output currently targets local file clients. A remote URI base
// must be retained by Server before this can reproduce its authority.
uri_at* = (a: Alloc, root: str, rel: str) Res<str, AllocError> {
    out ::= a.String("{}{}/{}", FILE_SCHEME, root, rel).try();
    Ok(out.view());
}
