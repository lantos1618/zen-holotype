// std.collections.iter - slice iteration helpers, all backed by closures.
//
// `fold`, `each`, and `find` allocate nothing. Allocating
// `[U]`/`[T]` helpers thread the caller allocator (`map_in`, `filter_in`, and the
// receiver-style `map`, `filter` aliases) — no hidden heap, and allocator failure
// stays in the value flow as Result<_, IoError>.
// The closure args (`f`, `keep`, `pred`) are first-class: inline lambdas and stored
// closures both work, generic over the element type. `find` reports its hit as `Opt<T>`.
{ Allocator, try_acquire } = std.mem.alloc
{ Result, IoError, Opt, ok, err } = std.core.result
{ take, drop, dup_in, buf_in } = std.core.slice
// Pairing structs for `zip_in`/`enumerate_in` — the flat namespace has no tuples (rejected), so a
// two-value element is a NAMED anonymous struct, exactly as multi-return is elsewhere in the tree.
Pair*<T, U>: {
    a: T,
    b: U,
}
IdxPair*<T>: {
    i: i64,
    v: T,
}
fold*<T> = (xs: [T], init: T, f: (T, T) T) T {
    acc := init
    xs.loop((h, i, x) {
        acc = f(acc, x)
    })
    acc
}
each*<T> = (xs: [T], f: (T) void) void {
    xs.loop((h, i, x) {
        f(x)
    })
}
// First element satisfying `pred`, as `Opt<T>` (`.None` if none match). Allocates nothing; stops at the
// first hit via `h.break`. `pred` is invoked DIRECTLY in the loop body so an inline lambda splices in:
// `xs.find((x){ x > 2 })`; a stored `p := (x: T) bool { … }  xs.find(p)` works too.
find*<T> = (xs: [T], pred: (T) bool) Opt<T> {
    out: Opt<T> := .None
    xs.loop((h, i, x) {
        pred(x).then({
            out = .Some(x)
            h.break
        })
    })
    out
}
map_in*<T, U> = (a: Allocator, xs: [T], f: (T) U) Result<[U], IoError> {
    (xs.len <= 0).match ({
        true  => {
            empty: [U] := slice(null_ptr(), 0)
            ok(empty)
        },
        false => a.try_acquire(xs.len * sizeof(U)).match ({
            .Ok(p)  => {
                out: [U] := p.slice(xs.len)
                xs.loop((h, i, x) {
                    out[i] = f(x)
                })
                ok(out)
            },
            .Err(e) => err(e),
        }),
    })
}
filter_in*<T> = (a: Allocator, xs: [T], keep: (T) bool) Result<[T], IoError> {
    (xs.len <= 0).match ({
        true  => {
            empty: [T] := slice(null_ptr(), 0)
            ok(empty)
        },
        false => a.try_acquire(xs.len * sizeof(T)).match ({
            .Ok(p)  => {
                buf: [T] := p.slice(xs.len)
                n := 0
                xs.loop((h, i, x) {
                    buf[n] = x
                    n = n + keep(x).then({ 1 }, { 0 })
                })
                ok(slice(buf[0].addr(), n))
            },
            .Err(e) => err(e),
        }),
    })
}
// In-place insertion sort of a mutable `[T]`, ordered by the comparator `less(a, b)` (true when
// `a` must come before `b`). Allocates nothing — it permutes `xs` directly. Stable. O(n^2), which is
// fine for the small slices these collections produce; callers wanting more can sort into a Vec.
// `xs := [3,1,2]  xs.sort((a, b){ a < b })` leaves `xs` == [1,2,3]; a `(a,b){ a > b }` comparator
// sorts descending. The comparator `less` is invoked DIRECTLY in the loop body (never forwarded to a
// helper) so an inline lambda splices in, exactly as it does for `fold`/`each`.
sort<T> = (xs: [T], less: (T, T) bool) void {
    xs.loop((ho, i, _) {
        xs.loop((hi, k, _) {
            // Outer pass: insert each xs[i] into the already-sorted prefix [0, i).
            // Inner pass: sink element at j = i - k leftward while it precedes its neighbour. The break
            // closes the inner loop only (its own handler `hi`), leaving the outer pass running.
            j := i - k
            (j <= 0).match ({
                true  => {
                    hi.break
                },
                false => less(xs[j], xs[j - 1]).match ({
                    true  => {
                        tmp := xs[j]
                        xs[j] = xs[j - 1]
                        xs[j - 1] = tmp
                    },
                    false => {
                        hi.break
                    },
                }),
            })
        })
    })
}
map*<T, U> = (a: Allocator, xs: [T], f: (T) U) Result<[U], IoError> { a.map_in(xs, f) }
filter*<T> = (a: Allocator, xs: [T], keep: (T) bool) Result<[T], IoError> { a.filter_in(xs, keep) }
// ── SCALAR COMBINATORS (allocator-free) ──────────────────────────────────────────────────────────
// None of these allocate, so none thread an allocator. They are the everyday reductions over a `[T]`.
// `fold_to` is the GENERAL fold — accumulate into a DIFFERENT type `U` than the element `T`; the older
// `fold` above (init and accumulator both `T`) stays for its existing callers (Vec.fold delegates to it).
fold_to*<T, U> = (xs: [T], init: U, f: (U, T) U) U {
    acc := init
    xs.loop((h, i, x) {
        acc = f(acc, x)
    })
    acc
}
// `sum`/`product` reduce an INTEGER slice (i8..i64, u8..u64) — T must support `+`/`*` AND accept the
// integer literal `0`/`1` as its additive/multiplicative identity, which the assign-fit checker allows
// only for integer T (a float local won't take a bare `0`). Empty → the identity (`0`/`1`). For a
// float sum, use `fold`/`fold_to` with an explicit `0.0`/`1.0` seed: `xs.fold(0.0, (a, b){ a + b })`.
sum*<T> = (xs: [T]) T {
    acc: T := 0
    xs.loop((h, i, x) {
        acc = acc + x
    })
    acc
}
product*<T> = (xs: [T]) T {
    acc: T := 1
    xs.loop((h, i, x) {
        acc = acc * x
    })
    acc
}
// element count. Identical to `xs.len`; kept for API parity with `count_if`.
count*<T> = (xs: [T]) i64 { xs.len }
// how many elements satisfy `pred`.
count_if*<T> = (xs: [T], pred: (T) bool) i64 {
    n := 0
    xs.loop((h, i, x) {
        pred(x).then({
            n = n + 1
        })
    })
    n
}
// `any`: does at least one element satisfy `pred`? Stops at the first hit via `h.break`. Empty → false.
any*<T> = (xs: [T], pred: (T) bool) bool {
    out := false
    xs.loop((h, i, x) {
        pred(x).then({
            out = true
            h.break
        })
    })
    out
}
// `all`: do ALL elements satisfy `pred`? Stops at the first miss. Empty → true (vacuous truth).
all*<T> = (xs: [T], pred: (T) bool) bool {
    out := true
    xs.loop((h, i, x) {
        (pred(x) == false).then({
            out = false
            h.break
        })
    })
    out
}
// `none`: does NO element satisfy `pred`? Empty → true.
none*<T> = (xs: [T], pred: (T) bool) bool { xs.any(pred) == false }
// `min_by`/`max_by`: the minimum/maximum element under the comparator `less(a, b)` (true when `a`
// orders before `b`, exactly like `sort`). Empty slice → `.None`. Ties keep the FIRST occurrence.
min_by*<T> = (xs: [T], less: (T, T) bool) Opt<T> {
    out: Opt<T> := .None
    xs.loop((h, i, x) {
        keep := out.match ({
            .Some(m) => less(x, m),
            .None    => true,
        })
        keep.then({
            out = .Some(x)
        })
    })
    out
}
max_by*<T> = (xs: [T], less: (T, T) bool) Opt<T> {
    out: Opt<T> := .None
    xs.loop((h, i, x) {
        keep := out.match ({
            .Some(m) => less(m, x),
            .None    => true,
        })
        keep.then({
            out = .Some(x)
        })
    })
    out
}
// `min_of`/`max_of`: the minimum/maximum element of a slice under the natural `<` on T (any T whose
// values support `<`), as `Opt<T>` (`.None` for an empty slice). For a custom order use `min_by`/`max_by`.
// NAMED `*_of` (not `min`/`max`) on purpose: `std.math` already owns the binary `min<T>(a, b)` /
// `max<T>(a, b)` in the flat namespace, and a program importing both std.math and this module must not
// collide on those names (one export would shadow the other → arity errors at the call site).
min_of*<T> = (xs: [T]) Opt<T> { xs.min_by((a, b) { a < b }) }
max_of*<T> = (xs: [T]) Opt<T> { xs.max_by((a, b) { a < b }) }
// `reduce`: fold with NO init — the accumulator seeds from the first element, so an empty slice is
// `.None` (unlike `fold`, which always has `init`). `f` combines the running accumulator with the next.
reduce*<T> = (xs: [T], f: (T, T) T) Opt<T> {
    out: Opt<T> := .None
    xs.loop((h, i, x) {
        out = out.match ({
            .Some(acc) => {
                r: Opt<T> := .Some(f(acc, x))
                r
            },
            .None      => {
                r: Opt<T> := .Some(x)
                r
            },
        })
    })
    out
}
// `position`: index of the FIRST element satisfying `pred`, as `Opt<i64>` (`.None` if none). Stops at
// the hit via `h.break`. (For value equality use core.slice's `index_of`; for the element itself, `find`.)
position*<T> = (xs: [T], pred: (T) bool) Opt<i64> {
    out: Opt<i64> := .None
    xs.loop((h, i, x) {
        pred(x).then({
            out = .Some(i.to_i64())
            h.break
        })
    })
    out
}
// ── PRODUCERS (allocator-threaded) ───────────────────────────────────────────────────────────────
// Each allocates a fresh owned slice through the caller's allocator; failure stays in the value flow as
// Result<_, IoError>. Empty results allocate nothing (a null/0 slice). The allocator is the first arg, so
// UFCS reads as `a.range_in(5)`. (For `reverse`/`concat` and the zero-copy `take`/`drop` VIEWS, use
// std.core.slice — those already exist there; the `take_in`/`skip_in` here return OWNED copies.)
range_in* = (a: Allocator, n: i64) Result<[i64], IoError> {
    (n <= 0).match ({
        true  => {
            empty: [i64] := slice(null_ptr(), 0)
            ok(empty)
        },
        false => a.try_acquire(n * sizeof(i64)).match ({
            .Ok(p)  => {
                out: [i64] := p.slice(n)
                out.loop((h, i, x) {
                    out[i] = i
                })
                ok(out)
            },
            .Err(e) => err(e),
        }),
    })
}
// [lo, hi) ascending; hi <= lo → empty.
range_from_in* = (a: Allocator, lo: i64, hi: i64) Result<[i64], IoError> {
    n := (hi > lo).then({ hi - lo }, { 0 })
    (n <= 0).match ({
        true  => {
            empty: [i64] := slice(null_ptr(), 0)
            ok(empty)
        },
        false => a.try_acquire(n * sizeof(i64)).match ({
            .Ok(p)  => {
                out: [i64] := p.slice(n)
                out.loop((h, i, x) {
                    out[i] = lo + i
                })
                ok(out)
            },
            .Err(e) => err(e),
        }),
    })
}
// lo, lo+step, … < hi (step > 0). A non-positive step or hi <= lo yields an empty slice (never a hang).
range_step_in* = (a: Allocator, lo: i64, hi: i64, step: i64) Result<[i64], IoError> {
    n := (step > 0 && hi > lo).then({ (hi - lo + step - 1) / step }, { 0 })
    (n <= 0).match ({
        true  => {
            empty: [i64] := slice(null_ptr(), 0)
            ok(empty)
        },
        false => a.try_acquire(n * sizeof(i64)).match ({
            .Ok(p)  => {
                out: [i64] := p.slice(n)
                out.loop((h, i, x) {
                    out[i] = lo + i * step
                })
                ok(out)
            },
            .Err(e) => err(e),
        }),
    })
}
// `enumerate_in`: pair each element with its index as `IdxPair<T>{ i, v }`. Storage comes through
// core.slice's `buf_in` (a typed empty `like` fixes the element type, so its internal `sizeof` resolves
// the struct size at mono — `sizeof(IdxPair<T>)` can't be spelled directly in an expression).
enumerate_in*<T> = (a: Allocator, xs: [T]) Result<[IdxPair<T>], IoError> {
    like: [IdxPair<T>] := slice(null_ptr(), 0)
    a.buf_in(xs.len, like).match ({
        .Ok(out) => {
            xs.loop((h, i, x) {
                out[i] = IdxPair<T>(
                    i: i.to_i64(),
                    v: x,
                )
            })
            ok(out)
        },
        .Err(e)  => err(e),
    })
}
// `zip_in`: pair xs[i] with ys[i] up to the SHORTER length, as `Pair<T, U>{ a, b }`.
zip_in*<T, U> = (a: Allocator, xs: [T], ys: [U]) Result<[Pair<T, U>], IoError> {
    n := (xs.len < ys.len).then({ xs.len }, { ys.len })
    like: [Pair<T, U>] := slice(null_ptr(), 0)
    a.buf_in(n, like).match ({
        .Ok(out) => {
            out.loop((h, i, x) {
                out[i] = Pair<T, U>(
                    a: xs[i],
                    b: ys[i],
                )
            })
            ok(out)
        },
        .Err(e)  => err(e),
    })
}
// `take_in`/`skip_in`: OWNED copies of the first `n` / everything after the first `n` elements (n is
// clamped to [0, len]). These allocate; for zero-copy VIEWS use core.slice's `take`/`drop`.
take_in*<T> = (a: Allocator, xs: [T], n: i64) Result<[T], IoError> { a.dup_in(xs.take(n)) }
skip_in*<T> = (a: Allocator, xs: [T], n: i64) Result<[T], IoError> { a.dup_in(xs.drop(n)) }
