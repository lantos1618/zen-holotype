// C/JS STRUCT VALUE SEMANTICS. A Zen struct is a VALUE — C copies it at every binding — while a JS
// object is a REFERENCE, so every line here printed a different number under `node` than under the C
// binary while both exited 0: the silent-miscompile class. Run under BOTH backends and compared byte
// for byte (harness_build's js_struct_value_battery_dual_backend), so a regression in either reddens
// the build. The emitter's side is compiler.backend.js.js_copy.
//
// Each block pins one position C copies at, and the last two pin what a copy deliberately does NOT do:
//   1. `b ::= a`               — the plain copy (`b.v = 9` left `a.v` at 9 on js, 1 in C).
//   2. a NESTED struct         — the copy is DEEP; a shallow `{...a}` would still alias `.inner`.
//   3. a struct holding a `MutSlice<T>` — the {ptr,len} HEADER copies and the BUFFER is SHARED, exactly as C
//      copies the zslice and leaves the pointee alone: `g.s.len` is private, `g.s[0]` is not.
//   4. an ENUM payload         — copied INTO the union at construction and OUT again at the arm bind.
//   5. a by-value PARAMETER    — a callee that writes its param cannot reach the caller's value.
//   6. a RETURN                — the returned value is the caller's own, not the callee's storage,
//      including a return of `load(p)` through a pointer (which is a copy of the pointee, not it).
//   7. a slice-literal ITEM and an indexed element STORE — both copy, like C's array initialization.
{ println } = std.text.fmt
Inner: {
    v: i64,
}
Nest: {
    a: i64,
    inner: Inner,
}
Holder: {
    tag: i64,
    s: MutSlice<i64>,
}
Box: Val(Nest) | Empty
// writes its own copy of a by-value param; the caller's Nest must be untouched
bump = (n: Nest) i64 {
    n.a = 99
    n.inner.v = 99
    n.a + n.inner.v
}
mk = (v: i64) Nest {
    Nest(
        a: v,
        inner: Inner(v: v * 2),
    )
}
// returns the POINTEE by value: the caller gets a copy, not the pointed-to struct
deref = (p: MutPtr<Nest>) Nest { load(p) }
main = () i32 {
    // 1 — the plain copy
    a ::= Inner(v: 1)
    b ::= a
    b.v = 9
    println(a.v)
    println(b.v)
    // 2 — a nested struct: deep
    n = Nest(
        a: 1,
        inner: Inner(v: 2),
    )
    m ::= n
    m.a = 10
    m.inner.v = 20
    println(n.a)
    println(n.inner.v)
    println(m.a)
    println(m.inner.v)
    // 3 — a struct holding a slice: header copied, buffer shared
    xs: MutSlice<i64> = [1, 2, 3]
    h = Holder(
        tag: 1,
        s: xs,
    )
    g ::= h
    g.tag = 2
    g.s.len = 1
    g.s[0] = 7
    println(h.tag)
    println(h.s.len)
    println(h.s[0])
    println(g.s.len)
    println(xs[0])
    // 4 — a struct in an enum payload, and the arm bind
    bx = Box.Val(n)
    v = bx.match ({
        .Val(x) => {
            x.inner.v = 77
            x.inner.v
        },
        .Empty  => 0,
    })
    println(v)
    println(n.inner.v)
    println(bx.match ({
        .Val(x) => x.inner.v,
        .Empty  => 0,
    }))
    // 5 — passed by value to a function that writes it
    println(n.bump())
    println(n.a)
    println(n.inner.v)
    // 6 — returned from a function, and returned through a pointer deref
    r ::= mk(3)
    r.inner.v = 5
    println(r.a)
    println(r.inner.v)
    println(mk(3).inner.v)
    d ::= n.addr().deref()
    d.inner.v = 42
    println(n.inner.v)
    println(d.inner.v)
    // 7 — a slice-literal item, an element read, and an element store
    ss :: MutSlice<Inner> = [a, b]
    a.v = 30
    println(ss[0].v)
    e ::= ss[0]
    e.v = 50
    println(ss[0].v)
    ss[1] = e
    e.v = 60
    println(ss[1].v)
    0
}
