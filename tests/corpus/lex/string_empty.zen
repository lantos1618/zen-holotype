// the empty string literal, and adjacent quotes that are not one token.
//
// `""` prints as nothing, which is also what a pipeline producing nothing at
// all prints, so every line here CONTRASTS the empty literal with a neighbour
// that must survive it: a length beside a non-zero length, an argument beside
// a non-empty argument, and a byte read out of the concatenation.
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    empty = "";
    println("{} {}", empty.len, "abc".len);
    println("[{}][{}]", "", "x");
    println("[{}][{}]", "y", "");
    println("[{}][{}][{}]", "", "", "z");
    joined = "ab";
    println("{} {}", joined.len, joined[1]);
    Ok(0);
}
