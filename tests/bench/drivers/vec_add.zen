// tests/bench/drivers/vec_add.zen
// driver for bench_vec.zen's vec_add. The bench body runs here in a
// plain loop; the clock lives OUTSIDE the process (scripts/bench.py,
// wall time minus the null driver's), because std has no clock and
// constructing a Bencher needs trait dispatch gen_c does not have yet
// ("supplied by an impl; gen_c has no trait dispatch yet").
//
// The body below is the bench's, kept in sync by hand: one add on an
// empty Vec is exactly one grow, capacity 0 -> 8. Budget: ns_op 40,
// allocs_op 1, bytes_op 64 (bench_budgets.zen).

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    Range(0, 1000000).loop((h, i) {
        v ::= alloc.Vec<i32>();
        v.add(1).try();
    });
    Ok(0);
}
