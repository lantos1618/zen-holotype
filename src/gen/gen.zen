// Code generation owns backend selection and artifact rendering. Drivers
// publish each borrowed artifact synchronously; no filesystem policy lives here.
// Direct C entry points remain available to compiler tools and backend tests.

Emit*, order* = gen.gen_emit
CBackend*, emit_program*, render_symbol_map* = gen.gen_c
lower_program*, emit_header*, emit_unit*, group_bodies*, ModuleBodies* = gen.gen_c

Alloc, AllocError, Mem = std.mem
Ast = std.ast
Checker = sema.sema
Codegen = std.build
String, str = std.text
lower = gen.gen_lower
Program = gen.gen_ir
emit_js = gen.gen_js
X86_64LinuxGnu = gen.gen_asm_x86
verify, message = gen.gen_verify

Layout* = Single | Modules
ArtifactKind* = Source | Symbols

ScalarBackend = Js | Asm

// Names and bytes borrow the renderer's current buffer. Consumers must write
// or copy them during the callback; retaining this record extends no lifetime.
Artifact* = {
    kind*: ArtifactKind,
    name*: str,
    text*: str,
}

Generation* = {
    alloc*: Alloc,
    mem*: Mem,
    tree*: Ast,
    check*: Checker,
    backend*: Codegen,
    entry*: usize,
    layout*: Layout,
    ffi*: bool,
    symbols*: bool,

    // Lowering diagnostics precede publication. The returned count includes
    // backend faults and publication failures; allocation errors stay typed.
    emit* = (self: @Self, report :: String,
             publish: (artifact: Artifact) Res<usize, AllocError>)
            Res<usize, AllocError> {
        self.backend.match({
            Js  => self.scalar(
                ScalarBackend.Js,
                report,
                (artifact) { publish(artifact) }
            ),
            Asm => self.scalar(
                ScalarBackend.Asm,
                report,
                (artifact) { publish(artifact) }
            ),
            C   => {
                be ::= self.alloc.CBackend(self.tree, self.check).try();
                self.ffi.then(() { be.enable_ffi(); });
                output ::= COutput(generation: self, be: be);
                faults = self.layout.match({
                    Single  => output.single(
                        report,
                        (artifact) { publish(artifact) }
                    ),
                    Modules => output.modules(
                        report,
                        (artifact) { publish(artifact) }
                    ),
                }).try();
                (faults == 0 && self.symbols).match({
                    true  => output.symbols((artifact) { publish(artifact) }),
                    false => Ok(faults),
                })
            },
        })
    }

    scalar = (self: @Self, backend: ScalarBackend, report :: String,
              publish: (artifact: Artifact) Res<usize, AllocError>)
             Res<usize, AllocError> {
        single = self.layout.match({ Single => true, Modules => false });
        (single && self.symbols == false).match({
            false => {
                report.add(
                    "error: JS and assembly backends require single-file output without a symbol map\n"
                ).try();
                Ok(1)
            },
            true  => lower(
                self.alloc,
                self.tree,
                self.check,
                self.entry
            ).match({
                Err(error)  => error.match({
                    OutOfMemory        => Err(AllocError.OutOfMemory),
                    Unsupported(fault) => {
                        report.fmt(
                            "{}:{}:{}: error: unsupported by this backend: {}\n",
                            fault.span.file,
                            fault.span.start.line,
                            fault.span.start.col,
                            fault.what
                        ).try();
                        Ok(1)
                    },
                }),
                Ok(program) => self.render_scalar(
                    backend,
                    program,
                    report,
                    (artifact) { publish(artifact) }
                ),
            }),
        })
    }

    render_scalar = (self: @Self, backend: ScalarBackend, program: Program,
                     report :: String,
                     publish: (artifact: Artifact) Res<usize, AllocError>)
                    Res<usize, AllocError> {
        program.verify(self.alloc).match({
            Err(error) => error.match({
                OutOfMemory    => Err(AllocError.OutOfMemory),
                Invalid(fault) => {
                    report.fmt(
                        "compiler error: invalid IR at function {}, block {}: {}\n",
                        fault.function,
                        fault.block,
                        fault.reason.message()
                    ).try();
                    Ok(1)
                },
            }),
            Ok(_)      => {
                    out  = backend.match({
                        Js  => emit_js(self.alloc, program),
                        Asm => X86_64LinuxGnu(alloc: self.alloc).emit(program),
                    }).try();
                    name = backend.match({ Js => "zen.js", Asm => "zen.s" });
                    publish(Artifact(
                        kind: ArtifactKind.Source,
                        name: name,
                        text: out.view()
                    ))
            },
        })
    }

}

// One backend owns lowering state throughout rendering. Split C lowers once,
// retains its stable order, and releases each scratch buffer after publication.
COutput = {
    generation: Generation,
    be :: CBackend,

    single = (self :: @Self, report :: String,
              publish: (artifact: Artifact) Res<usize, AllocError>)
             Res<usize, AllocError> {
        out ::= self.generation.alloc.Emit().try();
        self.be.emit_program(self.generation.entry, out).try();
        self.be.render_diags(report).try();
        faults = self.be.diag_count();
        (faults == 0).match({
            false => Ok(faults),
            true  => publish(Artifact(
                kind: ArtifactKind.Source,
                name: "zen.c",
                text: out.view()
            )),
        })
    }

    modules = (self :: @Self, report :: String,
               publish: (artifact: Artifact) Res<usize, AllocError>)
              Res<usize, AllocError> {
        self.be.use_externs();
        self.be.lower_program(self.generation.entry).try();
        header ::= self.generation.alloc.Emit().try();
        self.be.emit_header(header).try();
        self.be.render_diags(report).try();
        faults = self.be.diag_count();
        (faults == 0).match({
            false => Ok(faults),
            true  => {
                groups = self.be.group_bodies().try();
                failed ::= publish(Artifact(
                    kind: ArtifactKind.Source,
                    name: "zen.h",
                    text: header.view()
                )).try();
                groups.loop((h, group) {
                    unit = group.unit;
                    ((unit == self.generation.entry) || (group.functions.len > 0)).then(() {
                        scratch ::= self.generation.mem.alloc();
                        out     ::= scratch.Emit().try();
                        self.be.emit_unit(
                            self.generation.entry,
                            group,
                            out
                        ).try();
                        module_name = self.generation.tree.module_at(
                            unit
                        ).match({
                            None    => "zg_unit",
                            Ok(mod) => mod.name,
                        });
                        name        = scratch.String("{}.c", module_name).try();
                        failed      = failed + publish(Artifact(
                            kind: ArtifactKind.Source,
                            name: name.view(),
                            text: out.view()
                        )).try();
                    });
                });
                Ok(failed)
            },
        })
    }

    symbols = (self :: @Self,
               publish: (artifact: Artifact) Res<usize, AllocError>)
              Res<usize, AllocError> {
        out ::= self.generation.alloc.String().try();
        self.be.render_symbol_map(out).try();
        publish(Artifact(
            kind: ArtifactKind.Symbols,
            name: "symbols",
            text: out.view()
        ))
    }
}
