// Public streaming JSON reader and writer surface. Nest exposes writer state;
// reading stores values in the caller's arena rather than a separate tree.

JsonId*, Run*, Pair*, Json*, Jsons*,
    write_text*, written*, Nest*, obj*, arr* = std.json.json_write

JsonFault*, MAX_NESTING*, Reader*, read* = std.json.json_read

JsonEvent*, Decoder* = std.json.json_stream

to_json* = std.json.json_meta
