// driver.zen — the zenc CLI, in Zen. Dispatches on the command line and drives the compiler
// (resolve -> parse -> check -> genModule) and the C backend (cc). This replaces bootstrap/driver.c:
// once it roots --build-self, the seed carries `main` (emitted as zen_main) and driver.c is deleted.
{ arg, argc, clock_ms, getEnv } = std.sys.os
{ Os, Arch, Abi, host } = std.sys.platform
{ Malloc } = std.mem.alloc
{ view, is_empty, starts_with } = std.text.str
{ Map, of } = std.collections.map    // bs_shake: name -> decl-index / seen-set maps
{ impl_cname_in } = compiler.mangle    // bs_shake: recompute hoisted impl-method names
{ fnv1a64_fold } = std.hash    // shared FNV-1a-64 rolling byte fold (centralized in std.hash)
{ gstr_string, gstr_append, gstr_finish, gstr_push, cbuf, acquire_or_die } = compiler.genc    // the seed's String API (string.zen isn't in the manifest)
{ contents_in, save, write_all, O_RDONLY, O_WRONLY, O_CREAT, O_EXCL, O_WRTRUNC, MODE_644, MODE_755 } = std.io.file
{ or, expect } = std.core.result
{ then } = std.core.bool
{ advance_while, repeat_while, step_while } = std.core.count
{ open, read, write, close, system, unlink, mkdir, rmdir, getpid, isatty, clock_gettime } = std.c.libc
{ parse_module, exports_get } = compiler.parse
{ set_faithful_lexeme } = compiler.parse_atom
{ perr_get, perr_off_get } = compiler.parse_type
{ lerr_get, lerr_off_get, collect_comments } = compiler.lex
{ resolve_module } = compiler.check_resolve
{ genModuleIn } = compiler.backend.c.c_emit
{ genJsModuleIn } = compiler.backend.js.js
{ pretty_module_in, pretty_set_comments } = compiler.pretty
{ mut_infer_decls } = compiler.astops
{ diag_user_span, render_diagnostic, manifest_value_span } = compiler.diagnostic
{ eprint, first_user_import_in, file_exists } = compiler.resolve
{ ffi_grants_set, ffi_grants_get, genmods_set, genmods_get } = compiler.resolve_ffi
{ say, stdout_put, stdout_put_bytes, out_status, eprint, push_int, pid_path, dirname, last_slash,
  push_prefix, push_span, pad_sp, finish_cstr, join2, cstr_substr, bs_push_range, zt_log,
  resolve_prog_or_exit, dir_exists } = compiler.drvutil
{ report_no_if_plain, report_no_if_resolved, report_check, report_js_unsupported,
  report_c_unsupported } = compiler.drvdiag
{ js_unsupported_reset } = compiler.backend.js.js_expr
{ lsp_cmd } = compiler.lsp
{ FNV_BASIS, fnv_str, CacheWalk, edges_of, cache_walk_edges } = compiler.modgraph
{ AudCtx, aud_decl_name, aud_index, aud_tail_at, aud_ref, aud_mref, aud_walk_fn, aud_walk_sig,
  aud_td_idxs, aud_impl_dflts, aud_tables, audit_cmd } = compiler.audit
// run/build temp.c swaps the emitted HEAD typedef for the zenrt.h include; the PROG variant also
// suppresses zenrt's String (the program emits its own). --build-self uses the plain seed variant.
// module-level str CONSTS don't emit as C globals in the seed, so these are zero-arg fns.
HEAD = () StringView { "typedef struct { void* ptr; int64_t len; } zslice; " }
HEAD_REPL = () StringView {
    "#define ZEN_NO_STRING 1\n#define ZEN_NO_MALLOC 1\n#include \"zenrt.h\"\n"
}
TMPC = (mp: MutPtr<Malloc>) StringView { mp.pid_path("/tmp/zenc_zd_", ".c") }
TMPBIN = (mp: MutPtr<Malloc>) StringView { mp.pid_path("/tmp/zenc_zd_", ".bin") }
// write the runnable temp.c: zenrt.h-include head, then the emitted body (after HEAD).
write_runnable_c = (tmpc: StringView, gen: String) bool {
    hl = HEAD().view().len
    fd = tmpc.open(O_WRTRUNC, MODE_644)
    (fd < 0).match ({
        true  => false,
        false => {
            hv = HEAD_REPL().view()
            // A short write (ENOSPC/EIO), or a deferred error that only surfaces at close, leaves a
            // TRUNCATED temp.c that `cc` would then compile. `write_all` retries short writes and
            // reports the rest as a value; close is still run on the failure path (the fd must not
            // leak), and its own nonzero return counts as a failed write.
            wh = write_all(fd, hv.ptr, hv.len, 0).or(0 - 1)
            wb = write_all(fd, gen.ptr.offset(hl), gen.len - hl, 0).or(0 - 1)
            closed = fd.close()
            wh >= 0 && wb >= 0 && closed == 0
        },
    })
}
// cc -std=gnu11 -O1 -foptimize-sibling-calls -fwrapv -w -fno-diagnostics-show-caret -I<root>/bootstrap TMPC <root>/bootstrap/zenrt.c <profile> <ccflags> <links> -o <out>
// ── build profiles (cargo-style) ── `zen build` = dev, `zen build -r|--release` = release. The
// profile's flags land after the base defaults and BEFORE ccflags, so cc's last-flag-wins rule
// keeps the precedence: base defaults < profile < Target.cflags/zen.toml ccflags.
//   dev (default):     base -O1 plus -g       — fast compile, debuggable. NOT -O0: Zen's ONLY loop
//     is recursion (control flow is `.match` + recursion), so self-tail-recursive fns — emitted by
//     genc as a bare `return f(...)` (proper C tail position) — MUST get sibling-call elimination
//     or a deep idiomatic loop blows the C stack (raw SIGSEGV ~250k frames at -O0). The opt fires
//     only at >= -O1; -O1 also keeps -fstrict-aliasing OFF, which this void*-punning emitted C
//     relies on.
//   release (-r):      -O2 -fno-strict-aliasing — the optimized profile. -fno-strict-aliasing is
//     MANDATORY alongside -O2 (the emitted C puns pointers; -O2 alone would turn strict aliasing
//     back on and miscompile).
// `zen run` and single-file builds share this path and stay on the dev profile (only `zen build`
// parses -r): a run's temp binary wants the fastest cc turnaround. Profiles affect BUILT/RUN user
// programs only — the bootstrap seed compiles via bootstrap/Makefile CFLAGS (pinned -O2: built
// once, used heavily), so the byte-exact fixpoint is unaffected. Non-tail recursion whose result
// feeds a branch still overflows — caught by zenrt.c's stack-overflow panic.
// ccflags/links come from a project's zen.toml or build.zen (extra .c files, `-l` libs, and
// `-`-prefixed cc flags); empty for single files.
PROFILE_DEV = () StringView { "-g" }    // on top of the base -O1: effective `-O1 -g`
PROFILE_RELEASE = () StringView { "-O2 -fno-strict-aliasing" }    // overrides the base -O1
// `zen profile` compiles dev-profile PLUS frame pointers (perf's `--call-graph fp` walks them; -O1
// stays — profiling unoptimized code lies about where time goes). The gprof fallback adds -pg
// instrumentation. Both fold into the compile-cache key via profile_get, so a profiling binary
// never replays as (or from) a plain dev build.
PROFILE_PERF = () StringView { "-g -fno-omit-frame-pointer" }
PROFILE_GPROF = () StringView { "-g -pg -fno-omit-frame-pointer" }
profile_flags ::= PROFILE_DEV()
profile_release_set = () void { profile_flags = PROFILE_RELEASE() }
profile_perf_set = () void { profile_flags = PROFILE_PERF() }
profile_gprof_set = () void { profile_flags = PROFILE_GPROF() }
profile_get = () StringView { profile_flags }
cc_command = (
    mp: MutPtr<Malloc>,
    root: StringView,
    tmpc: StringView,
    out: StringView,
    ccflags: StringView,
    links: StringView,
    ccname: StringView,
) StringView {
    line = mp
        .gstr_string(256)
        .gstr_append(mp, ccname)
        .gstr_append(mp, " -std=gnu11 -Wno-error=implicit-function-declaration -O1 -foptimize-sibling-calls -fwrapv -w -I")
        .gstr_append(mp, root)
        .gstr_append(mp, "/bootstrap ")
        .gstr_append(mp, tmpc)
        .gstr_append(mp, " ")
        .gstr_append(mp, root)
        .gstr_append(mp, "/bootstrap/zenrt.c ")
        .gstr_append(mp, profile_get())
        .gstr_append(mp, " ")
        .gstr_append(mp, ccflags)
        .gstr_append(mp, " ")
        .gstr_append(mp, links)
        .gstr_append(mp, " -lm")
        .gstr_append(mp, " -o ")
        .gstr_append(mp, out)
        .gstr_finish(mp)
    // ZENC_SHOW_CC (any non-empty value): echo the full cc line to stderr — the observable record
    // of which profile/flags a compile actually used (the harness's profile cases assert on it).
    // A cache HIT never reaches cc, so pair it with ZENC_NO_CACHE=1/a fresh ZENC_CACHE_DIR.
    (getEnv("ZENC_SHOW_CC") == "" == false).then({
        eprint(line)
        eprint("\n")
    })
    line
}    // libm: always link (sin/cos/log/exp/pow); free if unused
// ── cross-toolchain selection (`Target.target(platform)` in build.zen) ────────────────────────────
// A native Spec (target "") compiles with host `cc` — the command line above, byte-identical to
// before. A cross triple resolves a C compiler in this order:
//   1. $ZENC_TARGET_CC — the verbatim compiler command (the documented escape hatch);
//   2. the conventional cross gcc `<triple>-gcc` on PATH (aarch64-linux-gnu-gcc, …), which brings
//      its own sysroot libc, so -lm/-lpthread and a project's `link =` just work;
//   3. `zig cc -target <triple>` when zig is on PATH.
// Nothing found -> a LOUD error and no build. There is NEVER a silent host-cc fallback: a wrong-
// architecture binary that "builds fine" is strictly worse than an error.
which_ok = (mp: MutPtr<Malloc>, name: StringView) bool {
    mp
        .gstr_string(64)
        .gstr_append(mp, "command -v ")
        .gstr_append(mp, name)
        .gstr_append(mp, " >/dev/null 2>&1")
        .gstr_finish(mp)
        .system() == 0
}
cross_cc = (mp: MutPtr<Malloc>, target: StringView) StringView {
    (target == "").then({
        return "cc"
    })
    envcc = getEnv("ZENC_TARGET_CC")
    (envcc == "" == false).then({
        return envcc
    })
    gcc = mp
        .gstr_string(32)
        .gstr_append(mp, target)
        .gstr_append(mp, "-gcc")
        .gstr_finish(mp)
    mp.which_ok(gcc).then({
        return gcc
    })
    mp.which_ok("zig").then({
        return mp
            .gstr_string(48)
            .gstr_append(mp, "zig cc -target ")
            .gstr_append(mp, target)
            .gstr_finish(mp)
    })
    eprint("zenc: error: cross target ")
    eprint(target)
    eprint(" needs a toolchain — set ZENC_TARGET_CC, or install ")
    eprint(gcc)
    eprint(" or zig\n")
    ""
}
flag_token_end = (v: [u8], i: i64) i64 {
    (i >= v.len || v[i] == ' ').then({ i }, { v.flag_token_end(i + 1) })
}
// fold a flag string: its text (order + non-file tokens like -lm), plus the CONTENT of every
// whitespace token that names a readable file (a project's extra .c sources compiled into the binary).
fnv_flag_files = (mp: MutPtr<Malloc>, h: i64, v: [u8], i: i64) i64 {
    (i >= v.len).match ({
        true  => h,
        false => (v[i] == ' ').match ({
            true  => mp.fnv_flag_files(h, v, i + 1),
            false => {
                e = flag_token_end(v, i)
                tok = push_prefix(mp.gstr_string(e - i + 1), mp, v, i, e).gstr_finish(mp)
                h2 = contents_in(mp, tok).match ({
                    .Ok(c)  => h.fnv_str(c),
                    .Err(x) => h,
                })
                mp.fnv_flag_files(h2, v, e)
            },
        }),
    })
}
fnv_flags = (h: i64, mp: MutPtr<Malloc>, s: StringView) i64 {
    v: [u8] = s.view()
    mp.fnv_flag_files(h.fnv_str(s), v, 0)
}
// the compiler's own identity: the hash of the running zenc binary. A rebuilt zenc — new checker, new
// codegen, new zenrt.c, all compiled in — yields a new stamp, so an old binary's entries can never be
// replayed by a new one. The identity SOURCE is `/proc/self/exe` (Linux): the kernel resolves it to the
// real binary regardless of how the process was launched, so a PATH-installed `zenc` (whose argv[0] is a
// bare, unreadable `zenc`) still stamps and thus still caches. Falls back to argv[0] when /proc is absent
// (non-Linux), then to 0 — an unavailable stamp DISABLES the cache for the run (empty key). Read in
// explicit-length chunks and fold as [u8]: an ELF binary has a NUL at byte 5, so any strlen-based view
// (contents_in -> .view()) would hash only the first ~4 bytes and stamp EVERY build identically.
self_exe_fd = () i32 {
    fd = "/proc/self/exe".open(O_RDONLY, 0)
    (fd < 0).then({ arg(0).open(O_RDONLY, 0) }, { fd })
}
cache_self = (mp: MutPtr<Malloc>) i64 {
    fd = self_exe_fd()
    (fd < 0).match ({
        true  => 0,
        false => {
            h = fd.cache_self_fold(mp.gstr_string(65536), FNV_BASIS())
            fd.close()
            h
        },
    })
}
cache_self_fold = (fd: i32, buf: String, h: i64) i64 {
    n = fd.read(buf.ptr, 65536)
    (n <= 0).then({ h }, { fd.cache_self_fold(buf, h.fnv1a64_fold(buf.ptr.slice(n))) })
}
cache_hex_digit = (d: i64) u8 { load(offset("0123456789abcdef", d)) }
push_hex = (s: String, mp: MutPtr<Malloc>, h: i64, i: i64) String {
    (i < 0).match ({
        true  => s,
        false => {
            hs = s.gstr_push(mp, cache_hex_digit(h >> i * 4 & 15))
            hs.push_hex(mp, h, i - 1)
        },
    })
}    // nibble i*4..0, most significant first (hoist: gstr_reserve re-evals the receiver)
cache_dir = () StringView {
    e = getEnv("ZENC_CACHE_DIR")
    (e == "").then({ "/tmp/zenc-cache" }, { e })
}
cache_on = () bool { getEnv("ZENC_NO_CACHE") == "" }
// the on-disk entry for one (kind, program) pair: <dir>/<kind>_<16 hex digits>.
cache_probe = (
    mp: MutPtr<Malloc>,
    kind: StringView,
    root: StringView,
    path: StringView,
    src: StringView,
    ccflags: StringView,
    links: StringView,
    target: StringView,
) StringView {
    // An unreadable binary (neither /proc/self/exe nor argv[0] opens) means the compiler-identity stamp
    // is unavailable; a shared degenerate stamp would let a REBUILT compiler replay a stale entry. Empty
    // key = cache disabled for this run.
    self = mp.cache_self()
    (self == 0).then({
        return ""
    })
    // ZEN_VIS_REPORT is part of the key: a report-only sweep (visibility/private-leak violations
    // print but never fail) must not stamp a check-ok an ENFORCED run would replay as clean.
    // The manifest/registry FFI grants are part of the key (stamped by the spec commands before any
    // probe): a program cached as clean under `ffi = "dep"` must MISS once the grant is revoked. The
    // entry-file pragma needs no folding — it lives in `src`, already keyed.
    // The registered c_library genmod map folds in the same way (the generated files' CONTENT is
    // hashed by the walk below through module_path; the map itself covers id/path re-registration).
    // The cross-target triple is part of the key: flipping `Target.target(...)` MUST miss — a
    // cached aarch64 binary must never replay as the x86_64 build (or vice versa).
    // The build profile (dev vs release, see cc_command) is part of the key the same way: a dev
    // `-O1 -g` binary must never replay as the `-r` release build (or vice versa).
    h0 = self
        .fnv_str(VERSION())
        .fnv_str(kind)
        .fnv_str(getEnv("ZEN_VIS_REPORT"))
        .fnv_str(ffi_grants_get())
        .fnv_str(genmods_get())
        .fnv_str(profile_get())
        .fnv_flags(mp, ccflags)
        .fnv_flags(mp, links)
        .fnv_str(target)
        .fnv_str(src)
    st = mp.cache_walk_edges(root, mp.dirname(path), mp.edges_of(src), CacheWalk(
        seen: mp.gstr_string(256),
        h: h0,
    ))
    mp
        .gstr_string(96)
        .gstr_append(mp, cache_dir())
        .gstr_push(mp, '/')
        .gstr_append(mp, kind)
        .gstr_push(mp, '_')
        .push_hex(mp, st.h, 15)
        .gstr_finish(mp)
}
// mark a fully-successful `check`: the marker's EXISTENCE is the cached verdict (content is cosmetic).
cache_put_ok = (path: StringView) i64 {
    mkdir(cache_dir(), MODE_755)
    save(path, "ok\n", 3).or(0)
}
// copy the cached binary into place; chmod so the exec bit survives any pre-existing destination.
cache_bin_cmd = (mp: MutPtr<Malloc>, cb: StringView, out: StringView) StringView {
    mp
        .gstr_string(160)
        .gstr_append(mp, "cp ")
        .quote_arg(mp, cb)
        .gstr_push(mp, ' ')
        .quote_arg(mp, out)
        .gstr_append(mp, " && chmod 755 ")
        .quote_arg(mp, out)
        .gstr_finish(mp)
}
// publish a built binary: copy to a pid-suffixed temp inside the cache dir, then atomic `mv -f` — a
// concurrent zenc never observes a half-written entry (and an exec'ing reader never sees ETXTBSY).
cache_store_bin = (mp: MutPtr<Malloc>, cb: StringView, out: StringView) i32 {
    mkdir(cache_dir(), MODE_755)
    tmp = mp
        .gstr_string(96)
        .gstr_append(mp, cb)
        .gstr_push(mp, '.')
        .push_int(mp, getpid())
        .gstr_finish(mp)
    mp
        .gstr_string(256)
        .gstr_append(mp, "cp ")
        .quote_arg(mp, out)
        .gstr_push(mp, ' ')
        .quote_arg(mp, tmp)
        .gstr_append(mp, " && mv -f ")
        .quote_arg(mp, tmp)
        .gstr_push(mp, ' ')
        .quote_arg(mp, cb)
        .gstr_finish(mp)
        .system()
}
// ── `--time` stage clocks (`zen run --time` / `zen build --time`) ─────────────────────────────────
// Wall-clock per driver-visible pipeline stage, printed as a compact table on stderr after the verb
// finishes. Off by default: tm_mark/tm_lap return 0 without reading the clock, so the stamps woven
// through compile_flat cost nothing when the flag is absent. Finer in-compiler splits (desugar/
// inline/mono inside check+emit) are a follow-up — these are the honest driver-level boundaries.
time_on ::= false
time_enable = () void { time_on = true }
tm_flatten ::= to_i64(0)
tm_parse ::= to_i64(0)
tm_resolve ::= to_i64(0)
tm_check ::= to_i64(0)
tm_emit ::= to_i64(0)
tm_cc ::= to_i64(0)
tm_cache_hit ::= false
// CLOCK_MONOTONIC via the libc clock_gettime FFI (std.time.clock is not in the seed manifest, so
// the driver reads the two timespec i64 fields itself — same layout contract as std.time.clock).
TM_CLOCK_MONOTONIC = () i32 { 1 }
TM_NS_PER_S = () i64 { 1000000000 }
tm_now = (mp: MutPtr<Malloc>) i64 {
    cell = mp.acquire_or_die(16)
    clock_gettime(TM_CLOCK_MONOTONIC(), cell)
    load_i64(cell) * TM_NS_PER_S() + load_i64(cell.offset(8))
}
tm_mark = (mp: MutPtr<Malloc>) i64 { time_on.then({ mp.tm_now() }, { 0 }) }
tm_lap = (mp: MutPtr<Malloc>, t0: i64) i64 { time_on.then({ mp.tm_now() - t0 }, { 0 }) }
// nanoseconds -> "12.3" (milliseconds, one decimal).
push_ms = (s: String, mp: MutPtr<Malloc>, ns: i64) String {
    t = ns / 100000
    s.push_int(mp, t / 10).gstr_push(mp, '.').push_int(mp, t % 10)
}
tm_row = (mp: MutPtr<Malloc>, name: StringView, ns: i64) void {
    eprint(mp
        .gstr_string(64)
        .gstr_append(mp, "  ")
        .gstr_append(mp, name)
        .pad_sp(mp, 22 - name.view().len)
        .push_ms(mp, ns)
        .gstr_append(mp, " ms\n")
        .gstr_finish(mp))
    { }
}
tm_report = (mp: MutPtr<Malloc>, wall: i64, other_label: StringView) void {
    time_on.then({
        sum = tm_flatten + tm_parse + tm_resolve + tm_check + tm_emit + tm_cc
        eprint("zenc --time: pipeline stages\n")
        tm_cache_hit.then({
            eprint("  (binary cache hit — compile stages skipped; ZENC_NO_CACHE=1 forces a full compile)\n")
            { }
        })
        mp.tm_row("flatten", tm_flatten)
        mp.tm_row("parse", tm_parse)
        mp.tm_row("resolve", tm_resolve)
        mp.tm_row("check", tm_check)
        mp.tm_row("mono+emit", tm_emit)
        mp.tm_row("cc", tm_cc)
        mp.tm_row(other_label, wall - sum)
        mp.tm_row("total", wall)
    })
}
// type-check, then (if clean) emit + cc to `out`. returns 0 on success, 1 on a check error or cc
// failure. The cache wraps this whole pipeline: a hit copies the previously-built binary and skips
// resolve-onward re-verification (the key proves the identical closure already compiled cleanly).
compile_to = (
    mp: MutPtr<Malloc>,
    root: StringView,
    path: StringView,
    src: StringView,
    out: StringView,
    ccflags: StringView,
    links: StringView,
    target: StringView,
) i32 {
    ccname = mp.cross_cc(target)
    (ccname == "").then({
        return 1
    })    // unresolvable cross toolchain: already reported loudly; NEVER fall back to host cc
    cb = mp.cache_probe("bin", root, path, src, ccflags, links, target)
    (cache_on() && cb == "" == false && file_exists(cb) && mp.cache_bin_cmd(cb, out).system() == 0).match ({
        true  => {
            tm_cache_hit = true
            0
        },
        false => {
            rc = mp.compile_flat(root, path, src, out, ccflags, links, ccname)
            (rc == 0 && cache_on() && cb == "" == false).then({
                mp.cache_store_bin(cb, out)
            })
            rc
        },
    })
}
compile_flat = (
    mp: MutPtr<Malloc>,
    root: StringView,
    path: StringView,
    src: StringView,
    out: StringView,
    ccflags: StringView,
    links: StringView,
    ccname: StringView,
) i32 {
    t0 = mp.tm_mark()
    rp = mp.resolve_prog_or_exit(root, path, src)
    tm_flatten = mp.tm_lap(t0)
    (mp.report_no_if_resolved(rp, path, src) == 0).match ({
        true  => {
            t1 = mp.tm_mark()
            raw = mp.parse_module(rp.flat)
            tm_parse = mp.tm_lap(t1)
            t2 = mp.tm_mark()
            decls = mp.resolve_module(raw)
            tm_resolve = mp.tm_lap(t2)
            t3 = mp.tm_mark()
            crc = mp.report_check(raw, decls, rp, path, src)
            tm_check = mp.tm_lap(t3)
            // gate BEFORE emission: a js-platform import has no C implementation to link against,
            // and `ld`'s undefined-reference dump is not a diagnostic a user can act on.
            (crc == 0 && mp.report_c_unsupported(rp, path, src) == 0).match ({
                true  => {
                    t4 = mp.tm_mark()
                    gen = mp.genModuleIn(decls)
                    tm_emit = mp.tm_lap(t4)
                    tmpc = mp.TMPC()
                    write_runnable_c(tmpc, gen).match ({
                        true  => {
                            t5 = mp.tm_mark()
                            ccrc = mp.cc_command(root, tmpc, out, ccflags, links, ccname).system()
                            tm_cc = mp.tm_lap(t5)
                            (ccrc == 0).match ({
                                true  => 0,
                                false => {
                                    eprint("zenc: internal: generated C failed to compile (this is a compiler bug — please report)\n")
                                    1
                                },
                            })
                        },
                        false => 1,
                    })
                },
                false => 1,
            })
        },
        false => 1,
    })
}
// ── subcommands ───────────────────────────────────────────────────────────────────────────────────
// `emit <file>` type-checks FIRST (like check/build) and STOPS on any error, so a type-broken program
// never produces C that references undefined names. `--force` / `--no-check` are CLI aliases of the
// checked path (they do NOT bypass the validator); flag may sit before OR after the path.
emit_file = (mp: MutPtr<Malloc>, root: StringView, a2: StringView, a3: StringView) i32 {
    flag2 = a2 == "--force" || a2 == "--no-check"
    path = flag2.then({ a3 }, { a2 })
    force = flag2 || a3 == "--force" || a3 == "--no-check"
    force.then({ mp.emit_raw(root, path) }, { mp.emit_checked(root, path) })
}
// emit_raw is an alias of emit_checked — kept so older call sites still resolve.
emit_raw = (mp: MutPtr<Malloc>, root: StringView, path: StringView) i32 {
    mp.emit_checked(root, path)
}
// checked: run the full report_check pipeline; emit only when clean, else exit 1 with the diagnostic.
emit_checked = (mp: MutPtr<Malloc>, root: StringView, path: StringView) i32 {
    contents_in(mp, path).match ({
        .Ok(src) => {
            rp = mp.resolve_prog_or_exit(root, path, src)
            (mp.report_no_if_resolved(rp, path, src) == 0).match ({
                true  => {
                    raw = mp.parse_module(rp.flat)
                    decls = mp.resolve_module(raw)
                    (mp.report_check(raw, decls, rp, path, src) == 0
                        && mp.report_c_unsupported(rp, path, src) == 0).match ({
                        true  => {
                            stdout_put_bytes(mp.genModuleIn(decls).bytes())
                            0
                        },
                        false => 1,
                    })
                },
                false => 1,
            })
        },
        .Err(e)  => {
            eprint("zenc: cannot read input\n")
            1
        },
    })
}
// ── js backend (task #46): Zen AST -> JavaScript. `emit-js` checks then emits the floor
// (bootstrap/zenrt.js) + the module JS; `build --target js` writes the same to a .js file. Additive:
// it reuses the exact resolve/parse/check pipeline, only swapping genModuleIn for genJsModuleIn. ──
js_floor = (mp: MutPtr<Malloc>, root: StringView) StringView {
    contents_in(mp, mp.join2(root, "bootstrap/zenrt.js")).match ({
        .Ok(src) => src,
        .Err(e)  => {
            eprint("zenc: emit-js: cannot open bootstrap/zenrt.js floor\n")
            ""
        },
    })
}
// emit floor + module JS to stdout (checked): a type-broken program never produces JS.
emit_js = (mp: MutPtr<Malloc>, root: StringView, path: StringView) i32 {
    contents_in(mp, path).match ({
        .Ok(src) => {
            rp = mp.resolve_prog_or_exit(root, path, src)
            (mp.report_no_if_resolved(rp, path, src) == 0).match ({
                true  => {
                    raw = mp.parse_module(rp.flat)
                    decls = mp.resolve_module(raw)
                    (mp.report_check(raw, decls, rp, path, src) == 0).match ({
                        true  => {
                            js_unsupported_reset()
                            mod = mp.genJsModuleIn(decls)
                            (mp.report_js_unsupported(rp, path, src) == 0).match ({
                                true  => {
                                    stdout_put(mp.js_floor(root))
                                    stdout_put("\n")
                                    stdout_put_bytes(mod.bytes())
                                    0
                                },
                                false => 1,
                            })
                        },
                        false => 1,
                    })
                },
                false => 1,
            })
        },
        .Err(e)  => {
            eprint("zenc: emit-js: cannot read input\n")
            1
        },
    })
}
// `zenc build --target js <file> [-o out.js]` -> write floor + module JS to `out` (default a.js).
build_js = (mp: MutPtr<Malloc>, root: StringView, path: StringView, out_path: StringView) i32 {
    contents_in(mp, path).match ({
        .Ok(src) => {
            rp = mp.resolve_prog_or_exit(root, path, src)
            (mp.report_no_if_resolved(rp, path, src) == 0).match ({
                true  => {
                    raw = mp.parse_module(rp.flat)
                    decls = mp.resolve_module(raw)
                    (mp.report_check(raw, decls, rp, path, src) == 0).match ({
                        true  => {
                            js = mp
                                .gstr_string(8192)
                                .gstr_append(mp, mp.js_floor(root))
                                .gstr_append(mp, "\n")
                            js_unsupported_reset()
                            mod = mp.genJsModuleIn(decls)
                            // gate BEFORE save: a .js holding a call to an undefined function must
                            // never reach disk, or `node` reports the compiler's bug as the user's.
                            (mp.report_js_unsupported(rp, path, src) == 0).match ({
                                true  => {
                                    full = js.gstr_append(mp, mod.finish_cstr(mp))
                                    save(out_path, full.finish_cstr(mp), full.len).match ({
                                        .Ok(n)  => {
                                            eprint("zenc: wrote ")
                                            eprint(out_path)
                                            eprint("\n")
                                            0
                                        },
                                        .Err(e) => 1,
                                    })
                                },
                                false => 1,
                            })
                        },
                        false => 1,
                    })
                },
                false => 1,
            })
        },
        .Err(e)  => {
            eprint("zenc: build --target js: cannot read input\n")
            1
        },
    })
}
// `zenc build`/`zenc targets` with no project argument default to the current directory when it
// holds a build.zen — so `./zen build` at the repo root builds the compiler's own registered
// targets. An explicit argument (file or dir) is never rewritten.
proj_dir = (a: StringView) StringView { (a == "" && file_exists("build.zen")).then({ "." }, { a }) }
// `zenc build [-r|--release] [--time] [--target <name>] [project]` — leading flags directly after
// `build` are consumed by build_flags (in any order): `-r`/`--release` selects the RELEASE profile
// (see the profile block above cc_command), `--time` turns on the stage table; every later
// positional shifts by their count (`s`). `zenc build --target js <file> [-o out]` -> the js
// backend; otherwise the ordinary C `build`. Unshifted args: arg(2)=--target arg(3)=js
// arg(4)=<file> arg(5)=-o arg(6)=<out>.
build_flags = (s: i32) i32 {
    a = arg(2 + s)
    (a == "--time").then({
        time_enable()
        return build_flags(s + 1)
    })
    (a == "-r" || a == "--release").then({
        profile_release_set()
        return build_flags(s + 1)
    })
    s
}
build_target = (mp: MutPtr<Malloc>, root: StringView, s: i32) i32 {
    (arg(2 + s) == "--target" && arg(3 + s) == "js").match ({
        true  => {
            out = (arg(5 + s) == "-o").then({ arg(6 + s) }, { "a.js" })
            mp.build_js(root, arg(4 + s), out)
        },
        false => (arg(2 + s) == "--target").match ({
            true  => mp.build_named_plan(root, proj_dir(arg(4 + s)), arg(3 + s)),
            false => {
                dir = proj_dir(arg(2 + s))
                file_exists(mp.join2(dir, "build.zen")).match ({
                    true  => mp.build_all_plan(root, dir),
                    false => mp.build_spec(root, mp.resolve_spec(root, dir), arg(3 + s), arg(4 + s)),
                })
            },
        }),
    })
}
// check/build/run operate on a Spec (a single file, or a zen.toml project). spec.source is the
// entry; spec.ccflags/links/out come from a project's manifest (empty for a single file).
check_spec = (mp: MutPtr<Malloc>, root: StringView, spec: Spec) i32 {
    spec.ok.then({ mp.check_spec_ok(root, spec) }, { 1 })
}    // resolve_spec already reported why
check_spec_ok = (mp: MutPtr<Malloc>, root: StringView, spec: Spec) i32 {
    ffi_grants_set(spec.ffi)    // manifest/registry FFI grants: stamped before probe AND resolve
    genmods_set(spec.genmods)    // registered c_library genmods: same stamp discipline
    contents_in(mp, spec.source).match ({
        .Ok(src) => {
            // a probe hit means this exact closure content already checked clean: replay the ok line.
            ck = mp.cache_probe("check", root, spec.source, src, spec.ccflags, spec.links, spec.target)
            (cache_on() && ck == "" == false && file_exists(ck)).match ({
                true  => check_ok_line(spec.source),
                false => {
                    rp = mp.resolve_prog_or_exit(root, spec.source, src)
                    (mp.report_no_if_resolved(rp, spec.source, src) == 0).match ({
                        true  => {
                            raw = mp.parse_module(rp.flat)
                            decls = mp.resolve_module(raw)
                            (mp.report_check(raw, decls, rp, spec.source, src) == 0).match ({
                                true  => {
                                    (cache_on() && ck == "" == false).then({
                                        cache_put_ok(ck)
                                    })
                                    check_ok_line(spec.source)
                                },
                                false => 1,
                            })
                        },
                        false => 1,
                    })
                },
            })
        },
        .Err(e)  => {
            eprint("zenc: cannot open input\n")
            1
        },
    })
}
check_ok_line = (path: StringView) i32 {
    eprint("zenc: ")
    eprint(path)
    eprint(": ok\n")
    0
}    // <path>: ok -> stderr
build_spec = (
    mp: MutPtr<Malloc>,
    root: StringView,
    spec: Spec,
    flag: StringView,
    outarg: StringView,
) i32 {
    spec.ok.match ({
        true  => {
            spec.library.then({
                eprint("zenc: cannot build a library project yet; use `zenc check <project>`\n")
                return 1
            })
            ffi_grants_set(spec.ffi)    // manifest/registry FFI grants: stamped before probe AND resolve
            genmods_set(spec.genmods)    // registered c_library genmods: same stamp discipline
            out = (spec.out == "").then({ build_out(flag, outarg) }, { spec.out })
            contents_in(mp, spec.source).match ({
                .Ok(src) => (mp.compile_to(root, spec.source, src, out, spec.ccflags, spec.links, spec.target) == 0).match ({
                    true  => file_exists(out).match ({
                        true  => {
                            eprint("zenc: wrote ")
                            eprint(out)
                            eprint("\n")
                            0
                        },
                        false => {
                            eprint("zenc: build produced no binary: ")
                            eprint(out)
                            eprint(" (compiler reported success but the file is missing)\n")
                            1
                        },
                    }),
                    false => {
                        eprint("zenc: build failed: ")
                        eprint(spec.source)
                        eprint("\n")
                        1
                    },
                }),
                .Err(e)  => {
                    eprint("zenc: cannot open input: ")
                    eprint(spec.source)
                    eprint("\n")
                    1
                },
            })
        },
        false => 1,
    })
}
// shell-quote one forwarded arg for the `system()` sh -c line: wrap in single quotes,
// an embedded `'` becomes `'\''` (close, escaped quote, reopen).
quote_arg = (s: String, mp: MutPtr<Malloc>, t: StringView) String {
    cur ::= s.gstr_push(mp, '\'')
    v: [u8] = t.view()
    v.loop((h, i, b) {
        cur = (b == '\'').then({ cur.gstr_append(mp, "'\\''") }, { cur.gstr_push(mp, b) })
    })
    cur.gstr_push(mp, '\'')
}
append_run_args = (s: String, mp: MutPtr<Malloc>, i: i32, n: i32) String {
    (i >= n).match ({
        true  => s,
        false => s.gstr_push(mp, ' ').quote_arg(mp, arg(i)).append_run_args(mp, i + 1, n),
    })
}
// `zenc run <file> a b c` — everything after the source path is forwarded to the program's argv
// (arg(3).., or arg(4).. when `--time` shifted the path; the program reads it back via
// std.sys.os.arg(i)/argc(), argv[0] being the temp binary).
run_fwd_from ::= 3
run_command = (mp: MutPtr<Malloc>, bin: StringView) StringView {
    mp
        .gstr_string(128)
        .gstr_append(mp, bin)
        .append_run_args(mp, to_i32(run_fwd_from), argc())
        .gstr_finish(mp)
}
run_spec = (mp: MutPtr<Malloc>, root: StringView, spec: Spec) i32 {
    spec.ok.match ({
        true  => {
            spec.library.then({
                eprint("zenc: cannot run a library project; use `zenc check <project>`\n")
                return 1
            })
            ffi_grants_set(spec.ffi)    // manifest/registry FFI grants: stamped before probe AND resolve
            genmods_set(spec.genmods)    // registered c_library genmods: same stamp discipline
            contents_in(mp, spec.source).match ({
                .Ok(src) => {
                    bin = mp.TMPBIN()
                    (mp.compile_to(root, spec.source, src, bin, spec.ccflags, spec.links, spec.target) == 0).match ({
                        true  => mp.run_command(bin).system() / 256,
                        false => 1,
                    })
                },
                .Err(e)  => {
                    eprint("zenc: cannot open input: ")
                    eprint(spec.source)
                    eprint("\n")
                    1
                },
            })
        },
        false => 1,
    })
}
// ── `zenc run`/`zenc build` verb wrappers: peel `--time`, run, then print the stage table ─────────
run_cmd = (mp: MutPtr<Malloc>, root: StringView) i32 {
    tt = arg(2) == "--time"
    tt.then({
        time_enable()
        run_fwd_from = 4
    })
    t0 = mp.tm_mark()
    rc = mp.run_spec(root, mp.resolve_spec(root, tt.then({ arg(3) }, { arg(2) })))
    mp.tm_report(mp.tm_lap(t0), "other (io/cache/run)")
    rc
}
build_cmd = (mp: MutPtr<Malloc>, root: StringView) i32 {
    s = build_flags(0)
    t0 = mp.tm_mark()
    rc = mp.build_target(root, s)
    mp.tm_report(mp.tm_lap(t0), "other (io/cache)")
    rc
}
// ── `zenc profile` — sampling profiler with zen-native names ──────────────────────────────────────
// Compiles the program dev-profile plus frame pointers (PROFILE_PERF above), records with
// `perf record -g --call-graph fp`, and renders `perf report --no-children` as a top-20
// `SELF% CUM% FUNCTION` table — hoisted impl methods (`impl_<Trait>_<Ty>_<m>` in the emitted C)
// are demangled back to `Ty.m` via the same parse-level DImpl walk the audit/sigs tools use.
// No perf on PATH (or perf denied by perf_event_paranoid, observable as zero samples) falls back
// to gprof `-pg` instrumentation; neither present is an honest error naming both. `--raw` dumps
// the untouched perf/gprof report instead of the table.
PROF_TOP = () i64 { 20 }
PROF_USAGE = () StringView { "usage: zenc profile [--raw] <file.zen|project> [-- prog args]\n" }
ProfArgs: {
    path: StringView,
    raw: bool,
    fwd: i32,
}
// one parsed report row: pct in hundredths of a percent (-1 = not a data row), the raw C symbol,
// and the DSO it lives in ("" for gprof, whose flat profile is single-binary by construction).
ProfRow: {
    pct: i64,
    sym: StringView,
    dso: StringView,
}
ProfPct: {
    val: i64,
    end: i64,
}
ProfParse: {
    n: i64,
    samples: StringView,
}
ProfNames: {
    idx: Map<i64>,
    disp: [StringView],
}
prof_args = (i: i32, n: i32, acc: ProfArgs) ProfArgs {
    (i >= n).then({
        return acc
    })
    a = arg(i)
    (a == "--").then({
        return ProfArgs(
            path: acc.path,
            raw: acc.raw,
            fwd: i + 1,
        )
    })
    (a == "--raw").then({
        return prof_args(i + 1, n, ProfArgs(
            path: acc.path,
            raw: true,
            fwd: acc.fwd,
        ))
    })
    (acc.path == "").match ({
        true  => prof_args(i + 1, n, ProfArgs(
            path: a,
            raw: acc.raw,
            fwd: acc.fwd,
        )),
        false => prof_args(i + 1, n, acc),
    })
}
// ── report parsing: byte-level line scan (bounds are the line's [ls, le), never the whole file) ──
prof_skip_sp = (v: [u8], i: i64, e: i64) i64 {
    (i < e && (v[i] == ' ' || v[i] == '\t')).then({ v.prof_skip_sp(i + 1, e) }, { i })
}
prof_skip_tok = (v: [u8], i: i64, e: i64) i64 {
    (i < e && v[i] == ' ' == false && v[i] == '\t' == false).match ({
        true  => v.prof_skip_tok(i + 1, e),
        false => i,
    })
}
prof_rtrim = (v: [u8], ls: i64, e: i64) i64 {
    (e > ls && (v[e - 1] == ' ' || v[e - 1] == '\t' || v[e - 1] == '\r')).match ({
        true  => v.prof_rtrim(ls, e - 1),
        false => e,
    })
}
prof_digits = (v: [u8], i: i64, e: i64, acc: i64) ProfPct {
    (i < e && v[i] >= '0' && v[i] <= '9').match ({
        true  => v.prof_digits(i + 1, e, acc * 10 + to_i64(v[i]) - to_i64('0')),
        false => ProfPct(
            val: acc,
            end: i,
        ),
    })
}
// "12.34" at i -> 1234 hundredths (perf and gprof both print percentages as %.2f; anything else,
// including a bare integer or a "7208/7208" calls token, is rejected with val -1).
prof_pct = (v: [u8], i: i64, e: i64) ProfPct {
    d1 = v.prof_digits(i, e, 0)
    (d1.end == i).then({
        return ProfPct(
            val: 0 - 1,
            end: i,
        )
    })
    (d1.end < e && v[d1.end] == '.').match ({
        true  => {
            d2 = v.prof_digits(d1.end + 1, e, 0)
            (d2.end == d1.end + 3).match ({
                true  => ProfPct(
                    val: d1.val * 100 + d2.val,
                    end: d2.end,
                ),
                false => ProfPct(
                    val: 0 - 1,
                    end: d2.end,
                ),
            })
        },
        false => ProfPct(
            val: 0 - 1,
            end: d1.end,
        ),
    })
}
prof_span = (mp: MutPtr<Malloc>, v: [u8], a: i64, b: i64) StringView {
    push_span(mp.gstr_string(b - a + 1), mp, v, a, b).gstr_finish(mp)
}
prof_starts = (v: [u8], ls: i64, le: i64, lit: StringView) bool {
    w: [u8] = lit.view()
    (le - ls < w.len).then({
        return false
    })
    ok ::= true
    w.loop((h, i, b) {
        ok = ok && v[ls + i] == b
    })
    ok
}
prof_token = (mp: MutPtr<Malloc>, v: [u8], i: i64, e: i64) StringView {
    a = v.prof_skip_sp(i, e)
    mp.prof_span(v, a, v.prof_skip_tok(a, e))
}
// a perf data row: `   12.34%  cmd  dso  [.] symbol` (the `#` header/comment lines, callchain
// residue, and anything not opening with a %.2f percent are all rejected).
prof_perf_row = (mp: MutPtr<Malloc>, v: [u8], ls: i64, le: i64) ProfRow {
    none = ProfRow(
        pct: 0 - 1,
        sym: "",
        dso: "",
    )
    e = v.prof_rtrim(ls, le)
    i = v.prof_skip_sp(ls, e)
    (i >= e || v[i] < '0' || v[i] > '9').then({
        return none
    })
    p = v.prof_pct(i, e)
    (p.val < 0 || p.end >= e || v[p.end] == '%' == false).then({
        return none
    })
    j ::= v.prof_skip_sp(p.end + 1, e)
    j = v.prof_skip_tok(j, e)    // command (the process name)
    j = v.prof_skip_sp(j, e)
    d0 = j
    j = v.prof_skip_tok(j, e)    // shared object
    dso = mp.prof_span(v, d0, j)
    j = v.prof_skip_sp(j, e)
    (j < e && v[j] == '[').then({
        j = v.prof_skip_tok(j, e)    // the "[.]"/"[k]" privilege marker
        j = v.prof_skip_sp(j, e)
    })
    (j >= e).then({
        return none
    })
    // an unresolved plain address (restricted kallsyms / stripped dso) tells the user nothing —
    // drop the row so the top-20 stays meaningful zen/libc names.
    (j + 1 < e && v[j] == '0' && v[j + 1] == 'x').then({
        return none
    })
    ProfRow(
        pct: p.val,
        sym: mp.prof_span(v, j, e),
        dso: dso,
    )
}
prof_parse_perf = (mp: MutPtr<Malloc>, body: StringView, rows: [ProfRow]) ProfParse {
    v: [u8] = body.view()
    n ::= 0
    samples ::= ""
    ls ::= 0
    v.loop((h, i, b) {
        (b == '\n').then({
            (n < rows.len).then({
                v.prof_starts(ls, i, "# Samples: ").then({
                    samples = mp.prof_token(v, ls + 11, i)
                })
                r = mp.prof_perf_row(v, ls, i)
                (r.pct >= 0).then({
                    rows[n] = r
                    n = n + 1
                })
            })
            ls = i + 1
        })
    })
    ProfParse(
        n: n,
        samples: samples,
    )
}
// first char of the last space-separated token in [lo, e); lo if the span is one token.
prof_tok_back = (v: [u8], lo: i64, i: i64) i64 {
    (i <= lo).then({
        return lo
    })
    (v[i - 1] == ' ' || v[i - 1] == '\t').then({ i }, { v.prof_tok_back(lo, i - 1) })
}
// a gprof flat-profile data row: ` 33.34   0.02   0.02   7208  0.00  0.00  name` (numeric middle
// columns vary — uncounted rows leave calls/ms blank — so the NAME is the last token, guarded to
// not itself start with a digit).
prof_gprof_row = (mp: MutPtr<Malloc>, v: [u8], ls: i64, le: i64) ProfRow {
    none = ProfRow(
        pct: 0 - 1,
        sym: "",
        dso: "",
    )
    e = v.prof_rtrim(ls, le)
    i = v.prof_skip_sp(ls, e)
    (i >= e || v[i] < '0' || v[i] > '9').then({
        return none
    })
    p = v.prof_pct(i, e)
    (p.val < 0 || p.end >= e || v[p.end] == ' ' == false).then({
        return none
    })
    t = v.prof_tok_back(p.end + 1, e)
    (t <= p.end + 1 || v[t] >= '0' && v[t] <= '9').then({
        return none
    })
    ProfRow(
        pct: p.val,
        sym: mp.prof_span(v, t, e),
        dso: "",
    )
}
prof_parse_gprof = (mp: MutPtr<Malloc>, body: StringView, rows: [ProfRow]) i64 {
    v: [u8] = body.view()
    n ::= 0
    ls ::= 0
    v.loop((h, i, b) {
        (b == '\n').then({
            (n < rows.len).then({
                r = mp.prof_gprof_row(v, ls, i)
                (r.pct >= 0).then({
                    rows[n] = r
                    n = n + 1
                })
            })
            ls = i + 1
        })
    })
    n
}
// ── demangling: hoisted impl-method C names back to `Ty.m` (mirrors tools/sigs.zen + audit) ──────
prof_disp = (mp: MutPtr<Malloc>, ty: StringView, mname: StringView) StringView {
    mp
        .gstr_string(48)
        .gstr_append(mp, ty)
        .gstr_push(mp, '.')
        .gstr_append(mp, mname)
        .gstr_finish(mp)
}
prof_names = (mp: MutPtr<Malloc>, decls: [Decl]) ProfNames {
    tds = mp.aud_td_idxs(decls)
    n ::= 0
    decls.loop((h, i, d) {
        d.match ({
            .DImpl(im) => {
                n = n + im.methods.len + decls.aud_impl_dflts(tds, im.trname)
            },
            _          => { },
        })
    })
    disp ::= cbuf<StringView>(mp, n + 1)
    seedv: i64 = 0 - 1
    m ::= of(mp, "", seedv).expect("profile: oom")
    k ::= 0
    decls.loop((h, i, d) {
        d.match ({
            .DImpl(im) => {
                im.methods.loop((h2, j, p) {
                    m = m
                        .put(mp, mp.impl_cname_in(im.trname, im.ty, p.name), k)
                        .expect("profile: oom")
                    disp[k] = mp.prof_disp(im.ty, p.name)
                    k = k + 1
                })
                tds.loop((h2, j, ti) {
                    decls[ti].match ({
                        .DTraitDefault(td) => {
                            (td.trname == im.trname).then({
                                m = m
                                    .put(mp, mp.impl_cname_in(im.trname, im.ty, td.fn.name), k)
                                    .expect("profile: oom")
                                disp[k] = mp.prof_disp(im.ty, td.fn.name)
                                k = k + 1
                            })
                        },
                        _                  => { },
                    })
                })
            },
            _          => { },
        })
    })
    ProfNames(
        idx: m,
        disp: disp,
    )
}
// the compiled program's parse-level decls carry every DImpl — a light frontend pass (resolve
// imports + parse, no check) is enough to rebuild the impl-method name table for display.
prof_names_of = (mp: MutPtr<Malloc>, root: StringView, spec: Spec, src: StringView) ProfNames {
    rp = mp.resolve_prog_or_exit(root, spec.source, src)
    mp.prof_names(mp.parse_module(rp.flat))
}
prof_binname = (mp: MutPtr<Malloc>, p: StringView) StringView {
    v: [u8] = p.view()
    cut = last_slash(v, 0, 0 - 1)
    (cut < 0).then({ p }, { cstr(offset(p, cut + 1)) })
}
// %.2f right-aligned to 6 columns (from hundredths).
push_pct = (s: String, mp: MutPtr<Malloc>, h: i64) String {
    ip = h / 100
    pad = (ip < 10).match ({
        true  => 3,
        false => (ip < 100).match ({
            true  => 2,
            false => (ip < 1000).then({ 1 }, { 0 }),
        }),
    })
    s2 = s.pad_sp(mp, pad).push_int(mp, ip).gstr_push(mp, '.')
    f = h % 100
    (f < 10).then({ s2.gstr_push(mp, '0').push_int(mp, f) }, { s2.push_int(mp, f) })
}
prof_table = (
    mp: MutPtr<Malloc>,
    source: StringView,
    engine: StringView,
    samples: StringView,
    rows: [ProfRow],
    n: i64,
    names: ProfNames,
    binname: StringView,
) void {
    hdr ::= mp
        .gstr_string(128)
        .gstr_append(mp, "zen profile: ")
        .gstr_append(mp, source)
        .gstr_append(mp, " — ")
        .gstr_append(mp, engine)
    hdr = (samples == "").match ({
        true  => hdr,
        false => hdr.gstr_append(mp, ", ").gstr_append(mp, samples).gstr_append(mp, " samples"),
    })
    say(hdr.gstr_finish(mp))
    say("  SELF%     CUM%  FUNCTION")
    cum ::= to_i64(0)
    rows.loop((h, i, r) {
        (i < n).then({
            cum = cum + r.pct
            di = names.idx.get(r.sym, 0 - 1)
            disp = (di < 0).then({ r.sym }, { names.disp[di] })
            line ::= mp
                .gstr_string(96)
                .push_pct(mp, r.pct)
                .gstr_append(mp, "  ")
                .push_pct(mp, cum)
                .gstr_append(mp, "  ")
                .gstr_append(mp, disp)
            line = (r.dso == binname || r.dso == "" || r.dso.starts_with("[")).match ({
                true  => line,
                false => line.gstr_append(mp, "  [").gstr_append(mp, r.dso).gstr_append(mp, "]"),
            })
            say(line.gstr_finish(mp))
        })
    })
}
// perf lane. Returns the program's exit code on success, or -1 meaning "perf yielded no samples —
// try gprof" (perf on PATH but perf_event_paranoid too strict is exactly this shape).
prof_perf = (mp: MutPtr<Malloc>, root: StringView, spec: Spec, src: StringView, pa: ProfArgs) i32 {
    profile_perf_set()
    bin = mp.pid_path("/tmp/zenprof_", ".bin")
    (mp.compile_to(root, spec.source, src, bin, spec.ccflags, spec.links, spec.target) == 0 == false).then({
        return 1
    })
    data = mp.pid_path("/tmp/zenprof_", ".data")
    prc = mp
        .gstr_string(256)
        .gstr_append(mp, "perf record -q -g --call-graph fp -o ")
        .gstr_append(mp, data)
        .gstr_append(mp, " -- ")
        .gstr_append(mp, bin)
        .append_run_args(mp, pa.fwd, argc())
        .gstr_finish(mp)
        .system()
    txt = mp.pid_path("/tmp/zenprof_", ".txt")
    mp
        .gstr_string(256)
        .gstr_append(mp, "perf report --stdio --no-children ")
        .gstr_append(mp, pa.raw.then({ "" }, { "-g none " }))
        .gstr_append(mp, "-i ")
        .gstr_append(mp, data)
        .gstr_append(mp, " > ")
        .gstr_append(mp, txt)
        .gstr_append(mp, " 2>/dev/null")
        .gstr_finish(mp)
        .system()
    body = contents_in(mp, txt).or("")
    pa.raw.then({
        (body == "").then({
            return 0 - 1
        })
        stdout_put(body)
        return 0
    })
    rows = cbuf<ProfRow>(mp, PROF_TOP())
    pp = mp.prof_parse_perf(body, rows)
    (pp.n == 0).then({
        return 0 - 1
    })
    mp.prof_table(spec.source, "perf", pp.samples, rows, pp.n, mp.prof_names_of(root, spec, src), mp.prof_binname(bin))
    prc / 256
}
// gprof lane: recompile with -pg, run inside a scratch dir (gmon.out lands in the program's cwd),
// then `gprof -b -p` for the flat profile (-b alone, with the call graph, for --raw).
prof_gprof = (mp: MutPtr<Malloc>, root: StringView, spec: Spec, src: StringView, pa: ProfArgs) i32 {
    profile_gprof_set()
    bin = mp.pid_path("/tmp/zenprof_", ".bin")
    (mp.compile_to(root, spec.source, src, bin, spec.ccflags, spec.links, spec.target) == 0 == false).then({
        return 1
    })
    dir = mp.pid_path("/tmp/zenprof_gm_", "")
    rrc = mp
        .gstr_string(256)
        .gstr_append(mp, "mkdir -p ")
        .gstr_append(mp, dir)
        .gstr_append(mp, " && cd ")
        .gstr_append(mp, dir)
        .gstr_append(mp, " && ")
        .gstr_append(mp, bin)
        .append_run_args(mp, pa.fwd, argc())
        .gstr_finish(mp)
        .system()
    txt = mp.pid_path("/tmp/zenprof_", ".txt")
    mp
        .gstr_string(256)
        .gstr_append(mp, "gprof -b ")
        .gstr_append(mp, pa.raw.then({ "" }, { "-p " }))
        .gstr_append(mp, bin)
        .gstr_push(mp, ' ')
        .gstr_append(mp, dir)
        .gstr_append(mp, "/gmon.out > ")
        .gstr_append(mp, txt)
        .gstr_append(mp, " 2>/dev/null")
        .gstr_finish(mp)
        .system()
    body = contents_in(mp, txt).or("")
    (body == "").then({
        eprint("zenc: profile: gprof produced no output (did the program run? did it exit through panic?)\n")
        return 1
    })
    pa.raw.then({
        stdout_put(body)
        return 0
    })
    rows = cbuf<ProfRow>(mp, PROF_TOP())
    n = mp.prof_parse_gprof(body, rows)
    (n == 0).then({
        eprint("zenc: profile: no samples — the program finished too fast to profile; give it more work\n")
        return 1
    })
    mp.prof_table(spec.source, "gprof", "", rows, n, mp.prof_names_of(root, spec, src), "")
    rrc / 256
}
prof_run = (
    mp: MutPtr<Malloc>,
    root: StringView,
    spec: Spec,
    src: StringView,
    pa: ProfArgs,
    have_perf: bool,
) i32 {
    have_perf.match ({
        true  => {
            rc = mp.prof_perf(root, spec, src, pa)
            (rc >= 0).then({
                return rc
            })
            mp.which_ok("gprof").match ({
                true  => {
                    eprint("zenc: perf recorded no samples (perf_event_paranoid too strict?); falling back to gprof\n")
                    mp.prof_gprof(root, spec, src, pa)
                },
                false => {
                    eprint("zenc: perf recorded no samples (check /proc/sys/kernel/perf_event_paranoid) and gprof is not installed\n")
                    1
                },
            })
        },
        false => mp.prof_gprof(root, spec, src, pa),
    })
}
profile_cmd = (mp: MutPtr<Malloc>, root: StringView) i32 {
    pa = prof_args(2, argc(), ProfArgs(
        path: "",
        raw: false,
        fwd: argc(),
    ))
    (pa.path == "").then({
        eprint(PROF_USAGE())
        return 2
    })
    have_perf = mp.which_ok("perf")
    (have_perf == false && mp.which_ok("gprof") == false).then({
        eprint("zenc: profile needs a profiler on PATH: install `perf` (linux-tools) or `gprof` (binutils)\n")
        return 1
    })
    spec = mp.resolve_spec(root, pa.path)
    spec.ok.match ({
        true  => {
            spec.library.then({
                eprint("zenc: cannot profile a library project; profile a program with a main\n")
                return 1
            })
            ffi_grants_set(spec.ffi)    // manifest/registry FFI grants: stamped before probe AND resolve
            genmods_set(spec.genmods)    // registered c_library genmods: same stamp discipline
            contents_in(mp, spec.source).match ({
                .Ok(src) => mp.prof_run(root, spec, src, pa, have_perf),
                .Err(e)  => {
                    eprint("zenc: cannot open input: ")
                    eprint(spec.source)
                    eprint("\n")
                    1
                },
            })
        },
        false => 1,
    })
}
// the project ROOT (holds src/std + src/compiler + bootstrap): $ZEN_ROOT if set (a relocated binary
// points it at a checkout), else the directory of the binary (argv[0]).
root_of = (mp: MutPtr<Malloc>) StringView {
    e = getEnv("ZEN_ROOT")
    (e == "").then({ mp.dirname(arg(0)) }, { e })
}
// ONE command list drives BOTH dispatch and `--help`, so the two can never drift (they did: `emit-js`
// was dispatched and documented in the README but missing from the hardcoded usage string).
// `run` takes the whole context — every handler reads its own `arg(n)`, and the `--build-self` pair
// shares one handler that tells the two apart by `cmd`. An empty `help` gets no usage line (the
// command still shows up in the `<…>` name list).
Cmd: {
    name: StringView,
    help: StringView,
    run: (MutPtr<Malloc>, StringView, StringView) i32,
}
cmd_init = (mp: MutPtr<Malloc>, root: StringView, cmd: StringView) i32 { mp.zi_cmd() }
cmd_build = (mp: MutPtr<Malloc>, root: StringView, cmd: StringView) i32 { mp.build_cmd(root) }
cmd_run = (mp: MutPtr<Malloc>, root: StringView, cmd: StringView) i32 { mp.run_cmd(root) }
cmd_profile = (mp: MutPtr<Malloc>, root: StringView, cmd: StringView) i32 { mp.profile_cmd(root) }
cmd_targets = (mp: MutPtr<Malloc>, root: StringView, cmd: StringView) i32 {
    mp.list_plan_targets(root, proj_dir(arg(2)))
}
cmd_doc = (mp: MutPtr<Malloc>, root: StringView, cmd: StringView) i32 { mp.doc_cmd(root, arg(2)) }
cmd_audit = (mp: MutPtr<Malloc>, root: StringView, cmd: StringView) i32 {
    mp.audit_cmd(root, arg(2), arg(3), arg(4))
}
cmd_lsp = (mp: MutPtr<Malloc>, root: StringView, cmd: StringView) i32 { mp.lsp_cmd(root) }
cmd_check = (mp: MutPtr<Malloc>, root: StringView, cmd: StringView) i32 {
    mp.check_spec(root, mp.resolve_spec(root, arg(2)))
}
cmd_emit = (mp: MutPtr<Malloc>, root: StringView, cmd: StringView) i32 {
    mp.emit_file(root, arg(2), arg(3))
}
cmd_emit_js = (mp: MutPtr<Malloc>, root: StringView, cmd: StringView) i32 {
    mp.emit_js(root, arg(2))
}
cmd_fmt = (mp: MutPtr<Malloc>, root: StringView, cmd: StringView) i32 { mp.fmt_cmd(arg(2), arg(3)) }
cmd_build_self = (mp: MutPtr<Malloc>, root: StringView, cmd: StringView) i32 {
    (arg(2) == "").match ({
        true  => {
            eprint("usage: zenc --build-self[-full] <out.c> <srcroot>\n")
            2
        },
        false => mp.build_self(arg(3), arg(2), cmd == "--build-self"),
    })
}
COMMANDS = () [Cmd] {
    [
        Cmd(
            name: "init",
            help: "init [path] [--bin|--lib]",
            run: cmd_init,
        ),
        Cmd(
            name: "build",
            help: "build [-r|--release] [--time] [--target <name>] [project]\n                                       build registered targets — dev profile (-O1 -g) by default,\n                                       -r/--release = optimized (-O2 -fno-strict-aliasing)",
            run: cmd_build,
        ),
        Cmd(
            name: "run",
            help: "run [--time] <file|project> [args]  compile + run; --time prints per-stage compile timings",
            run: cmd_run,
        ),
        Cmd(
            name: "profile",
            help: "profile [--raw] <file.zen|project> [-- args]\n                                       sampling profile (perf; gprof fallback) with zen-native names",
            run: cmd_profile,
        ),
        Cmd(
            name: "targets",
            help: "targets <project>               list registered targets",
            run: cmd_targets,
        ),
        Cmd(
            name: "doc",
            help: "doc <std.mod|file.zen>",
            run: cmd_doc,
        ),
        Cmd(
            name: "audit",
            help: "audit <file.zen> [--strict]     dead-code, unused-import + clone report (--strict exits 1;\n                                       clones are advisory and never affect the exit code)\n  zenc audit --workspace <dir> [--strict]  union dead-code across every main-bearing entry under <dir>",
            run: cmd_audit,
        ),
        Cmd(
            name: "lsp",
            help: "lsp                             diagnostics-only Language Server (JSON-RPC over stdio)",
            run: cmd_lsp,
        ),
        Cmd(
            name: "check",
            help: "",
            run: cmd_check,
        ),
        Cmd(
            name: "emit",
            help: "",
            run: cmd_emit,
        ),
        Cmd(
            name: "emit-js",
            help: "",
            run: cmd_emit_js,
        ),
        Cmd(
            name: "fmt",
            help: "fmt [--check|--stdout|--migrate] <in.zen>...\n                                       --migrate rewrites the retired `x ::= v` spelling to const-by-default\n                                       (`x = v` when the binding is never assigned, `x ::= v` when it is)",
            run: cmd_fmt,
        ),
        Cmd(
            name: "--build-self",
            help: "--build-self <out.c> <root>     regenerate the seed, tree-shaken (only decls reachable from main)",
            run: cmd_build_self,
        ),
        Cmd(
            name: "--build-self-full",
            help: "--build-self-full <out.c> <root>  regenerate the full seed (no tree-shake; every manifest decl)",
            run: cmd_build_self,
        ),
    ]
}
HELP = (mp: MutPtr<Malloc>) StringView {
    cs: [Cmd] = COMMANDS()
    s ::= mp.gstr_string(2048).gstr_append(mp, "usage: zenc <")
    cs.loop((h, i, c) {
        s = (i > 0).then({ s.gstr_append(mp, "|") }, { s })
        s = s.gstr_append(mp, c.name)
    })
    s = s.gstr_append(mp, "|--version|--help> <file>\n")
    cs.loop((h, i, c) {
        s = (c.help == "").match ({
            true  => s,
            false => s.gstr_append(mp, "  zenc ").gstr_append(mp, c.help).gstr_append(mp, "\n"),
        })
    })
    s.gstr_append(mp, "  cat file.zen | zenc   (source -> C filter)\n").gstr_finish(mp)
}
VERSION = () StringView { "zenc 0.2.0-dev (self-hosted; zen driver)" }    // also folded into every cache key
// one flat pass over COMMANDS() — `hit` (not the return code) decides "found", so a command that
// legitimately exits nonzero is never mistaken for an unknown one and re-run as `default_emit`.
dispatch_cmd = (mp: MutPtr<Malloc>, root: StringView, cmd: StringView) i32 {
    rc ::= 0
    hit ::= false
    cs: [Cmd] = COMMANDS()
    cs.loop((h, i, c) {
        (c.name == cmd).then({
            rc = c.run(mp, root, cmd)
            hit = true
            h.break
        })
    })
    hit.then({ rc }, { mp.default_emit(cmd) })
}
main = () i32 {
    m = Malloc(_: 0)
    mp = m.addr()
    root = mp.root_of()
    cmd = arg(1)
    // out_status: a stdout write that was LOST (full disk, closed pipe) outranks the command's own
    // exit code — `zenc emit x.zen > file` must not report success having written nothing.
    rc = (cmd == "--help").match ({
        true  => {
            say(mp.HELP())
            0
        },
        false => (cmd == "--version").match ({
            true  => {
                say(VERSION())
                0
            },
            false => mp.dispatch_cmd(root, cmd),
        }),
    })
    out_status(rc)
}    // --build-self <out.c> <srcroot>
build_out = (flag: StringView, out: StringView) StringView {
    (flag == "-o").then({ out }, { "a.out" })
}    // `zenc <file>` (or stdin) -> raw C on stdout, the harness filter
// build output path: `build <file> -o <out>` -> <out>, else "a.out".
// the DEFAULT mode (no subcommand): `zenc <file>` or `cat … | zenc` -> emit C to stdout, RAW
// (resolve_module only, NO import flatten — std imports stay as-is; the harness depends on this).
// No subcommand and no file: bare `zenc`. An interactive terminal (isatty(0)) gets the help text
// rather than silently blocking on a stdin read; a pipe (`cat file.zen | zenc`) still filters to C.
default_emit = (mp: MutPtr<Malloc>, path: StringView) i32 {
    (path == "").match ({
        true  => (isatty(0) != 0).match ({
            true  => {
                say(mp.HELP())
                0
            },
            false => mp.stdin_emit(mp.read_stdin()),
        }),
        false => mp.raw_emit_file(path),
    })
}
// piped stdin has no directory, so a sibling import `{ f } = b` can't resolve — error cleanly instead
// of emitting C that references undefined names (std imports stay raw, which the harness relies on).
stdin_emit = (mp: MutPtr<Malloc>, src: StringView) i32 {
    sib = mp.first_user_import_in(src)
    (sib == "").match ({
        true  => mp.raw_emit_src("<stdin>", src),
        false => {
            eprint(mp
                .gstr_string(256)
                .gstr_append(mp, "zenc: <stdin>: error: sibling import '")
                .gstr_append(mp, sib)
                .gstr_append(mp, "' needs a source file on disk (stdin has no directory); use `zenc build <file.zen>`\n")
                .gstr_finish(mp))
            1
        },
    })
}
raw_emit_file = (mp: MutPtr<Malloc>, path: StringView) i32 {
    contents_in(mp, path).match ({
        .Ok(src) => mp.raw_emit_src(path, src),
        .Err(e)  => {
            eprint("zenc: cannot open input\n")
            1
        },
    })
}
raw_emit_src = (mp: MutPtr<Malloc>, path: StringView, src: StringView) i32 {
    (mp.report_no_if_plain(path, src) == 0).match ({
        true  => {
            stdout_put_bytes(mp.genModuleIn(mp.resolve_module(mp.parse_module(src))).bytes())
            0
        },
        false => 1,
    })
}
// read all of fd 0 (stdin/pipe — no seekable size) into one buffer.
STDIN_CAP = 8388608
read_stdin = (mp: MutPtr<Malloc>) StringView {
    buf = mp.acquire_or_die(STDIN_CAP)
    n = read_fd_all(0, buf, 0, STDIN_CAP)
    buf.offset(n).store(0)
    cstr(buf)
}
read_fd_all = (fd: i32, buf: RawPtr<u8>, off: i64, cap: i64) i64 {
    r = fd.read(buf.offset(off), cap - off)
    (r <= 0).match ({
        true  => off,
        false => (off + r >= cap).then({ cap }, { read_fd_all(fd, buf, off + r, cap) }),
    })
}
// ── --build-self: regenerate the seed (ported from bootstrap/driver.c build_self) ─────────────────
BS_HEAD = () StringView { "typedef struct { void* ptr; int64_t len; } zslice; " }
BS_HEAD_REPL = () StringView { "#define ZEN_NO_MALLOC 1\n#include \"zenrt.h\"\n" }
bs_is_space = (b: u8) bool {
    (b == ' ').match ({
        true  => true,
        false => (b == '\t').match ({
            true  => true,
            false => (b == '\n').match ({
                true  => true,
                false => (b == '\r').match ({
                    true  => true,
                    false => (b == 11).then({ true }, { b == 12 }),
                }),
            }),
        }),
    })
}
bs_skip_space = (v: [u8], i: i64, e: i64) i64 {
    (i >= e).match ({
        true  => e,
        false => bs_is_space(v[i]).then({ v.bs_skip_space(i + 1, e) }, { i }),
    })
}
bs_trim_end = (v: [u8], s: i64, e: i64) i64 {
    (e <= s).match ({
        true  => s,
        false => bs_is_space(v[e - 1]).then({ v.bs_trim_end(s, e - 1) }, { e }),
    })
}
bs_line_end = (v: [u8], p0: i64, n: i64) i64 { p0.advance_while((p) { p < n && v[p] != '\n' }) }    // iterative: a long line must not recurse per char
bs_eq_run = (v: [u8], at: i64, nv: [u8], i: i64) bool {
    (i >= nv.len).match ({
        true  => true,
        false => (v[at + i] == nv[i]).then({ v.bs_eq_run(at, nv, i + 1) }, { false }),
    })
}
bs_match_at = (v: [u8], at: i64, e: i64, needle: StringView) bool {
    nv = needle.view()
    (at + nv.len > e).then({ false }, { v.bs_eq_run(at, nv, 0) })
}
bs_has_needle = (v: [u8], p: i64, e: i64) bool {
    (p >= e).match ({
        true  => false,
        false => v.bs_match_at(p, e, "= std.").match ({
            true  => true,
            false => v.bs_match_at(p, e, "= compiler.").match ({
                true  => true,
                false => v.bs_has_needle(p + 1, e),
            }),
        }),
    })
}
// `{` opening an import, tolerating a binding name directly after it (`{println}`) as well as `{ p`.
bs_brace_open = (b: u8) bool {
    b == ' ' || b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z' || b == '_'
}
bs_is_import = (v: [u8], p: i64, e: i64) bool {
    s = v.bs_skip_space(p, e)
    (s + 1 < e).match ({
        true  => (v[s] == '{').match ({
            true  => v[s + 1].bs_brace_open().then({ v.bs_has_needle(p, e) }, { false }),
            false => false,
        }),
        false => false,
    })
}
bs_strip_file = (mp: MutPtr<Malloc>, out: String, v: [u8], p: i64, n: i64, first: bool) String {
    (p >= n).match ({
        true  => out,
        false => {
            e = v.bs_line_end(p, n)
            drop = v.bs_is_import(p, e)
            o2 = drop.match ({
                true  => out,
                false => {
                    sep = first.then({ out }, { out.gstr_push(mp, '\n') })
                    mp.bs_push_range(sep, v, p, e)
                },
            })
            nf = drop.then({ first }, { false })
            (e >= n).then({ o2 }, { mp.bs_strip_file(o2, v, e + 1, n, nf) })
        },
    })
}
bs_rel = (mp: MutPtr<Malloc>, mv: [u8], s: i64, t: i64) StringView {
    mp.bs_push_range(mp.gstr_string(256), mv, s, t).gstr_finish(mp)
}
bs_add_source = (mp: MutPtr<Malloc>, out: String, root: StringView, rel: StringView) String {
    path = mp.join2(root, rel)
    contents_in(mp, path).match ({
        .Ok(src) => {
            sv = src.view()
            mp.bs_strip_file(out, sv, 0, sv.len, true)
        },
        .Err(e)  => {
            eprint("zenc: --build-self: cannot open a source file\n")
            out
        },
    })
}
bs_walk_manifest = (
    mp: MutPtr<Malloc>,
    out: String,
    root: StringView,
    mv: [u8],
    p: i64,
    n: i64,
    count: i64,
) String {
    (p >= n).match ({
        true  => out,
        false => {
            e = mv.bs_line_end(p, n)
            s = mv.bs_skip_space(p, e)
            t = mv.bs_trim_end(s, e)
            keep = (s < t).then({ mv[s] != '#' }, { false })
            o2 = keep.match ({
                true  => {
                    sep = (count > 0).then({ out.gstr_push(mp, '\n') }, { out })
                    rel = mp.bs_rel(mv, s, t)
                    mp.bs_add_source(sep, root, rel)
                },
                false => out,
            })
            nc = keep.then({ count + 1 }, { count })
            (e >= n).then({ o2 }, { mp.bs_walk_manifest(o2, root, mv, e + 1, n, nc) })
        },
    })
}
bs_gen_end = (gv: [u8], n: i64) i64 {
    (n <= 0).match ({
        true  => 0,
        false => bs_is_space(gv[n - 1]).then({ gv.bs_gen_end(n - 1) }, { n }),
    })
}
bs_write = (out_path: StringView, gen: String) bool {
    hl = BS_HEAD().view().len
    end = gen.bytes().bs_gen_end(gen.len)
    fd = out_path.open(O_WRTRUNC, MODE_644)
    (fd < 0).match ({
        true  => false,
        false => {
            hv = BS_HEAD_REPL().view()
            // Same hazard as write_runnable_c, on a file that OUTLIVES the run: a truncated seed
            // reported as written is a corrupt bootstrap that only explodes on the next build.
            wh = write_all(fd, hv.ptr, hv.len, 0).or(0 - 1)
            wb = write_all(fd, gen.ptr.offset(hl), end - hl, 0).or(0 - 1)
            closed = fd.close()
            wh >= 0 && wb >= 0 && closed == 0
        },
    })
}
// emit the seed from the manifest concatenation `flat` (kept byte-exact), but ONLY after the compiler's
// own source has passed its strict validator. The manifest flat itself is NOT directly checkable — it
// deliberately omits the std modules whose symbols zenrt.c provides at the C level (`view`, `String`, …),
// so as a raw concatenation it references hundreds of "undefined" runtime names. So validation runs on
// the IMPORT-RESOLVED `driver.zen` entry (the same path `zenc check driver.zen` uses): that pulls in
// those std modules so the names ARE declared, dedups, and runs the full checker over the real program.
bs_emit_checked = (
    mp: MutPtr<Malloc>,
    root: StringView,
    out_path: StringView,
    flat: StringView,
    entry: StringView,
    esrc: StringView,
    shake: bool,
) i32 {
    t0 = clock_ms()
    rp = mp.resolve_prog_or_exit(root, entry, esrc)
    t1 = mp.zt_log("resolve-imports", t0)
    (mp.report_no_if_resolved(rp, entry, esrc) == 0).match ({
        true  => {
            raw = mp.parse_module(rp.flat)
            t2 = mp.zt_log("parse", t1)
            decls = mp.resolve_module(raw)
            t3 = mp.zt_log("resolve", t2)
            (mp.report_check(raw, decls, rp, entry, esrc) == 0).match ({
                true  => {
                    t4 = mp.zt_log("validate", t3)
                    rawf = mp.parse_module(flat)
                    t5 = mp.zt_log("parse-manifest", t4)
                    kept = shake.then({ mp.bs_shake(rawf) }, { rawf })
                    t6 = mp.zt_log("shake", t5)
                    rd = mp.resolve_module(kept)    // type error in compiler source — fail, don't regenerate a miscompiled seed
                    t7 = mp.zt_log("resolve-manifest", t6)
                    gen = mp.genModuleIn(rd)
                    mp.zt_log("emit", t7)
                    mp.zt_log("total", t0)
                    gen.bytes().bs_eq_run(0, BS_HEAD().view(), 0).match ({
                        true  => bs_write(out_path, gen).then({ 0 }, { 1 }),
                        false => {
                            eprint("zenc: --build-self: emitted C did not start with the expected head\n")
                            1
                        },
                    })
                },
                false => 1,
            })
        },
        false => 1,
    })
}
// ── --build-self tree-shake: emit only decls reachable from `main` ────────────────────────────────
// Reuses the `zen audit` reachability fixpoint (AudCtx + the aud_* walkers) over the manifest flat:
// the dual raw+resolved walk, the bare-method-name fanout (aud_mref) and the live-type -> impl-method
// fanout (aud_implms). Kept regardless of reachability (the audit's documented exemption classes, all
// in the keep direction): DRaw escapes, DImport records, DForeign prototypes, module-alias binds,
// `__`-prefixed decls, DImpl conformance records whose type is live (or a builtin receiver with no
// type decl to anchor), trait defaults of live traits, and the bare/alias twin of any live name (both
// copies come from the same source line). bs_close then re-walks every KEPT decl until the seen set
// stops growing, so the kept set is reference-closed: no emitted decl can reference a dropped one.
// `--build-self-full` bypasses the shake (the fat seed, every manifest decl).
bs_trait_live = (ac: MutPtr<AudCtx>, trname: StringView) bool {
    neg1: i64 = 0 - 1
    ac.ridx.get(trname, neg1) < 0 || ac.seen.has(trname)
}
// mark a kept-for-a-reason name live when the fixpoint alone did not reach it: `__`-synthesized
// decls, and the bare/alias twin of a live name (same source line, so it is emitted either way).
bs_root_twin = (ac: MutPtr<AudCtx>, tails: Map<i64>, nm: StringView) void {
    nta = nm.aud_tail_at()
    twin = tails.has(nm) || nta > 0 && ac.seen.has(cstr(offset(nm, nta)))
    (is_empty(nm) == false && (nm.starts_with("__") || twin)).then({
        ac.aud_ref(nm)
    })
}
// one closure sweep: walk every decl the emission filter keeps unconditionally, so their references
// join the live set (DForeign signature types, live-trait default bodies, alias binds, twins).
bs_root_kept = (ac: MutPtr<AudCtx>, tails: Map<i64>, d: Decl) void {
    d.match ({
        .DForeign(f)       => ac.aud_walk_sig(f),
        .DTraitDefault(td) => ac.bs_trait_live(td.trname).then({
            ac.aud_walk_fn(td.fn)
        }),
        .DImpl(im)         => { },
        .DGlobal(g)        => {
            g.alias.then({
                ac.aud_ref(g.name)
            })
            ac.bs_root_twin(tails, g.name)
        },
        _                  => ac.bs_root_twin(tails, d.aud_decl_name()),
    })
}
// `__`-tail set of the live names, rebuilt per sweep (aud_run's twin-suppression set, keep direction).
bs_tails = (ac: MutPtr<AudCtx>) Map<i64> {
    seedv: i64 = 0 - 1
    tails ::= of(ac.mp, "", seedv).expect("build-self: oom")
    ac.seen.keys().loop((h, i, k) {
        ta = k.aud_tail_at()
        (ta > 0).then({
            one: i64 = 1
            tails = tails.put(ac.mp, cstr(offset(k, ta)), one).expect("build-self: oom")
        })
    })
    tails
}
// iterate bs_root_kept sweeps to a fixpoint: newly-live names can make more types live, which keeps
// more impl blocks, whose methods reference more names — stop when the seen set stops growing.
bs_close = (ac: MutPtr<AudCtx>, raw: [Decl]) void {
    repeat_while((pass) {
        prev = ac.seen.keys().len
        tails = ac.bs_tails()
        raw.loop((h, i, d) {
            ac.bs_root_kept(tails, d)
        })
        ac.seen.keys().len != prev
    })
}
// the emission filter over the closed live set: which raw manifest decls reach the seed.
bs_keep = (ac: MutPtr<AudCtx>, d: Decl) bool {
    neg1: i64 = 0 - 1
    d.match ({
        .DImpl(im)         => ac.ridx.get(im.ty, neg1) < 0 || ac.seen.has(im.ty),
        .DTraitDefault(td) => ac.bs_trait_live(td.trname),
        .DForeign(f)       => true,
        _                  => {
            nm = d.aud_decl_name()
            is_empty(nm) || ac.seen.has(nm)
        },
    })
}
// reachability-filter the parsed manifest flat: root `main` (plus the `main(sys)` trampoline's `root`
// and every impl on a builtin receiver, exactly as `zen audit` roots), run the aud_* fixpoint over
// the raw AND resolved decls, close over the always-kept classes, then keep only what bs_keep passes.
// The kept subset is re-resolved by the caller, so mono instances, lowered closures and materialized
// trait defaults are re-synthesized for the surviving decls only.
bs_shake = (mp: MutPtr<Malloc>, raw: [Decl]) [Decl] {
    rdecls = mp.resolve_module(raw)
    t = mp.aud_tables(raw)
    seedv: i64 = 0 - 1
    c = AudCtx(
        mp: mp,
        decls: raw,
        rdecls: rdecls,
        ridx: mp.aud_index(raw),
        xidx: mp.aud_index(rdecls),
        seen: of(mp, "", seedv).expect("build-self: oom"),
        mseen: of(mp, "", seedv).expect("build-self: oom"),
        pairs: t.pairs,
        implms: t.implms,
    )
    ac = c.addr()
    ac.aud_ref("main")
    mi = c.ridx.get("main", 0 - 1)
    (mi >= 0).then({
        raw[mi].match ({
            .DFunc(f) => {
                (f.params.len > 0).then({
                    ac.aud_mref("root")
                })
            },
            _         => { },
        })
    })
    raw.loop((h, i, d) {
        d.match ({
            .DImpl(im) => {
                (c.ridx.get(im.ty, 0 - 1) < 0).then({
                    ac.aud_ref(im.trname)
                    im.methods.loop((h2, j, p) {
                        ac.aud_ref(mp.impl_cname_in(im.trname, im.ty, p.name))
                    })
                })
            },
            _          => { },
        })
    })
    ac.bs_close(raw)
    n ::= 0
    raw.loop((h, i, d) {
        ac.bs_keep(d).then({
            n = n + 1
        })
    })
    kept ::= cbuf<Decl>(mp, n)
    k ::= 0
    raw.loop((h, i, d) {
        ac.bs_keep(d).then({
            kept[k] = d
            k = k + 1
        })
    })
    kept
}
build_self = (mp: MutPtr<Malloc>, root: StringView, out_path: StringView, shake: bool) i32 {
    mpath = mp.join2(root, "bootstrap/sources.txt")
    contents_in(mp, mpath).match ({
        .Ok(man) => {
            mv = man.view()
            flat = mp.bs_walk_manifest(mp.gstr_string(256), root, mv, 0, mv.len, 0).gstr_finish(mp)
            entry = mp.join2(root, "driver.zen")
            contents_in(mp, entry).match ({
                .Ok(esrc) => mp.bs_emit_checked(root, out_path, flat, entry, esrc, shake),
                .Err(e)   => {
                    eprint("zenc: --build-self: cannot open driver.zen for validation\n")
                    1
                },
            })
        },
        .Err(e)  => {
            eprint("zenc: --build-self: cannot open bootstrap/sources.txt\n")
            1
        },
    })
}
// ── doc: a module's public decls + their leading doc comments (ported from driver.c doc_source) ───
ends_zen = (s: StringView) bool {
    v: [u8] = s.view()
    v.len >= 4
        && v[v.len - 4] == '.'
        && v[v.len - 3] == 'z'
        && v[v.len - 2] == 'e'
        && v[v.len - 1] == 'n'
}
is_name_start = (b: u8) bool { b >= 'A' && b <= 'Z' || b >= 'a' && b <= 'z' || b == '_' }
push_mod = (mp: MutPtr<Malloc>, s: String, v: [u8], i: i64) String {
    (i >= v.len).match ({
        true  => s,
        false => mp.push_mod(s.gstr_push(mp, (v[i] == '.').then({ '/' }, { v[i] })), v, i + 1),
    })
}
mod_path = (mp: MutPtr<Malloc>, root: StringView, mod: StringView) StringView {
    ends_zen(mod).match ({
        true  => mod,
        false => {
            rel = mp
                .push_mod(mp.gstr_string(128).gstr_append(mp, "src/"), mod.view(), 0)
                .gstr_append(mp, ".zen")
                .gstr_finish(mp)
            mp
                .gstr_string(256)
                .gstr_append(mp, root)
                .gstr_append(mp, "/")
                .gstr_append(mp, rel)
                .gstr_finish(mp)
        },
    })
}
doc_has_star = (v: [u8], i: i64, t: i64) bool {
    (i >= t).match ({
        true  => false,
        false => (v[i] == '*').match ({
            true  => true,
            false => (v[i] == '=' || v[i] == ':').then({ false }, { v.doc_has_star(i + 1, t) }),
        }),
    })
}
doc_is_pub = (v: [u8], p: i64, t: i64) bool {
    (p >= t).then({ false }, { is_name_start(v[p]) && v.doc_has_star(p, t) })
}
out_range = (v: [u8], p: i64, t: i64) i64 {
    stdout_put_bytes(slice(v.ptr.offset(p), t - p))
    0
}
doc_line = (mp: MutPtr<Malloc>, v: [u8], p: i64, t: i64, docs: String) String {
    (t - p >= 2 && v[p] == '/' && v[p + 1] == '/').match ({
        true  => {
            s = (p + 2 < t && v[p + 2] == ' ').then({ p + 3 }, { p + 2 })
            dl = mp.bs_push_range(docs, v, s, t)
            dl.gstr_push(mp, '\n')
        },
        false => (p >= t).match ({
            true  => mp.gstr_string(256),
            false => doc_is_pub(v, p, t).match ({
                true  => {
                    stdout_put_bytes(docs.bytes())
                    v.out_range(p, t)
                    stdout_put("\n")
                    mp.gstr_string(256)
                },
                false => mp.gstr_string(256),
            }),
        }),
    })
}
doc_lines = (mp: MutPtr<Malloc>, v: [u8], p: i64, docs: String) i64 {
    (p >= v.len).match ({
        true  => 0,
        false => {
            e = v.bs_line_end(p, v.len)
            t = v.bs_trim_end(p, e)
            d2 = mp.doc_line(v, p, t, docs)
            mp.doc_lines(v, (e >= v.len).then({ v.len }, { e + 1 }), d2)
        },
    })
}
doc_cmd = (mp: MutPtr<Malloc>, root: StringView, modarg: StringView) i32 {
    (modarg == "").match ({
        true  => {
            eprint("usage: zenc doc <std.mod|file.zen>\n")
            2
        },
        false => contents_in(mp, mp.mod_path(root, modarg)).match ({
            .Ok(src) => {
                stdout_put("# ")
                stdout_put(modarg)
                stdout_put("\n")
                mp.doc_lines(src.view(), 0, mp.gstr_string(256))
                0
            },
            .Err(e)  => {
                eprint("zenc: doc: cannot open module\n")
                1
            },
        }),
    })
}
// ── THE formatter: the AST pretty-printer (compiler.pretty) with source comments woven back in. ──────
// (The old line-reindenter — fmt_source/fmt_lines/fmt_scan/fmt_indent — has been RETIRED: it only
//  reindented + trimmed, never reflowed multi-arm matches, and overflowed the stack on big files. The
//  AST pretty-printer below is now the single formatter behind `zenc fmt`.)
// Parse the file FAITHFULLY (parse_module keeps MethodCall — UFCS preserved `s.len()`, not flat `len(s)`),
// collect its comments into a positioned sidecar table, then pretty-print: 4-space indent, multi-arm
// `.match` split one arm per line with `=>` aligned + trailing comma, multi-field struct literals one
// field per line, short single-arm/single-expr bodies inline, and every comment kept in place. Comments
// stay OUT of the AST, so the formatted source resolves to byte-identical C (formatting is a no-op on the
// lowered tree). This is the engine behind BOTH `zenc fmt` (in-place / --check) and `fmt --stdout`.
//
// fmt parses the RAW (pre-flatten) source — module-alias lines and qualified types the post-flatten
// pipeline never feeds parse_module. Qualified types `ns.Type` now parse; a residual construct the
// faithful parser still can't represent plants a parse error, and a faithful printer must REFUSE a file
// it cannot round-trip rather than silently rewrite it — so on any parse/lex error we fail cleanly.
FmtResult*: {
    text: StringView,
    len: i64,
    ok: bool,
}    // ok=false => parse/lex error, text/len unused
// `zenc fmt --migrate`: ONE-SHOT rewrite of the retired `x = v` spelling to const-by-default.
// Off by default, so an ordinary `zenc fmt` PRESERVES what the source wrote — mutability is a
// declaration, not a formatting choice, and re-deriving it on every format would silently flip a
// deliberate `::=` whose only write sits behind a shape the analysis cannot see.
fmt_migrate ::= 0
fmt_set_migrate = (on: bool) void { fmt_migrate = on.then({ 1 }, { 0 }) }
fmt_render = (mp: MutPtr<Malloc>, src: StringView) FmtResult {
    set_faithful_lexeme(true)    // keep C-keyword identifiers RAW (float, if, …) for round-trip
    decls = mp.parse_module(src)    // faithful AST (keeps MethodCall)
    set_faithful_lexeme(false)
    (fmt_migrate == 1).then({
        mut_infer_decls(decls)
    })
    (perr_get() || lerr_get()).match ({
        true  => FmtResult(
            text: "",
            len: 0,
            ok: false,
        ),
        false => {
            exps = exports_get()
            pretty_set_comments(src, mp.collect_comments(src))
            o = mp.pretty_module_in(decls, exps)
            FmtResult(
                text: o.gstr_finish(mp),
                len: o.len,
                ok: true,
            )
        },
    })
}
// Positioned refusal: render the parse/lex failure as a standard `zenc: <path>:<line>:<col>:
// error[parse]` diagnostic against the RAW source (fmt owns no ResolvedProgram — the raw source IS
// the user source, so diag_user_span maps the offset directly). A negative offset is the vbreak
// encoding (parse.fill_decls) — clamp to its absolute position for the caret.
fmt_parse_err = (mp: MutPtr<Malloc>, path: StringView, src: StringView) i32 {
    off = (perr_off_get() == 0).then({ lerr_off_get() }, { perr_off_get() })
    o = (off < 0).then({ 0 - off }, { off })
    sp = diag_user_span(src, src, o, 1)
    eprint(mp.render_diagnostic(path, src, sp.line, sp.col, sp.end_col, "parse", "cannot format (syntax error — a faithful formatter refuses a file it cannot represent)", "fix the parse error first (`zenc check` reports the full diagnostic), then re-run fmt", 1))
    1
}
// THE single source of truth for "would apply rewrite this file?" — a file is dirty iff the formatted
// text differs from the source byte-for-byte. BOTH the `--check` and apply branches of `fmt_file` gate
// on this, so `fmt --check X` reports dirty iff `fmt X` would rewrite X — the two can never drift apart.
// The two length gates kill the strcmp/NUL blind spot: `src` is the file bytes (NUL-free) and `r.len` is
// the formatter's true byte count, so `strlen(src) != r.len` OR `strlen(r.text) != r.len` (an embedded
// NUL shortening the C string) both flag dirty; once all three lengths agree the content is NUL-free and
// equal-length, so `eq` (strcmp) then compares every one of the r.len bytes — a full byte-for-byte match.
fmt_dirty = (src: StringView, r: FmtResult) bool {
    sv = src.view()
    rv = r.text.view()
    (sv.len != r.len).match ({
        true  => true,
        false => (rv.len != r.len).match ({
            true  => true,
            false => (src == r.text).then({ false }, { true }),
        }),
    })
}
// `zenc fmt [--check] <file>`: format IN PLACE (or, with --check, exit 1 when the file is not already
// formatted, writing nothing). Idempotent — formatting an already-formatted file is a no-op.
fmt_file = (mp: MutPtr<Malloc>, path: StringView, check: bool) i32 {
    contents_in(mp, path).match ({
        .Ok(src) => {
            (mp.report_no_if_plain(path, src) == 0).match ({
                true  => {
                    r = mp.fmt_render(src)
                    r.ok.match ({
                        true  => fmt_dirty(src, r).match ({
                            true  => check.match ({
                                true  => {
                                    eprint("zenc: ")
                                    eprint(path)
                                    eprint(": needs formatting\n")
                                    1
                                },
                                false => save(path, r.text, r.len).match ({
                                    .Ok(n)  => 0,
                                    .Err(e) => 1,
                                }),
                            }),
                            false => 0,
                        }),
                        false => mp.fmt_parse_err(path, src),
                    })
                },
                false => 1,
            })
        },
        .Err(e)  => {
            eprint("zenc: fmt: cannot open input\n")
            1
        },
    })
}
// `zenc fmt --stdout <file>` (alias: --ast, kept for back-compat): write the formatted text to stdout.
fmt_stdout = (mp: MutPtr<Malloc>, path: StringView) i32 {
    contents_in(mp, path).match ({
        .Ok(src) => {
            (mp.report_no_if_plain(path, src) == 0).match ({
                true  => {
                    r = mp.fmt_render(src)
                    r.ok.match ({
                        true  => {
                            stdout_put(r.text)
                            0
                        },
                        false => mp.fmt_parse_err(path, src),
                    })
                },
                false => 1,
            })
        },
        .Err(e)  => {
            eprint("zenc: fmt: cannot open input\n")
            1
        },
    })
}
// `zenc fmt [--check] <a.zen> <b.zen> …` processes EVERY file argument (argv[i]..argv[n-1]) — a
// trailing argument is never silently skipped (the old handler formatted only the first file and
// exited 0, so `fmt --check a.zen b.zen` could bless an unformatted b.zen). Each file goes through
// fmt_file, which names its own offender on stderr; the fold keeps the last nonzero per-file status,
// so the exit code is 0 iff EVERY file is clean (--check) / formatted successfully (apply).
fmt_files = (mp: MutPtr<Malloc>, i: i32, n: i32, check: bool, rc: i32) i32 {
    (i >= n).match ({
        true  => rc,
        false => {
            r = mp.fmt_file(arg(i), check)
            mp.fmt_files(i + 1, n, check, (r == 0).then({ rc }, { r }))
        },
    })
}
fmt_cmd = (mp: MutPtr<Malloc>, a2: StringView, a3: StringView) i32 {
    fmt_set_migrate(a2 == "--migrate")
    (a2 == "--migrate").then({
        return (a3 == "").match ({
            true  => {
                eprint("usage: zenc fmt --migrate <in.zen>...\n")
                2
            },
            false => mp.fmt_files(3, argc(), false, 0),
        })
    })
    (a2 == "--ast" || a2 == "--stdout").match ({
        true  => (a3 == "").match ({
            true  => {
                eprint("usage: zenc fmt --stdout <in.zen>\n")
                2
            },
            false => mp.fmt_stdout(a3),
        }),
        false => (a2 == "--check").match ({
            true  => (a3 == "").match ({
                true  => {
                    eprint("usage: zenc fmt [--check] <in.zen>...\n")
                    2
                },
                false => mp.fmt_files(3, argc(), true, 0),
            }),
            false => (a2 == "").match ({
                true  => {
                    eprint("usage: zenc fmt [--check] <in.zen>...\n")
                    2
                },
                false => mp.fmt_files(2, argc(), false, 0),
            }),
        }),
    })
}
// ── project bootstrap: `zenc init [path] [--bin|--lib]` ──────────────────────────────────
// The templates live in this driver, so a relocated standalone zenc does not need a templates
// directory beside it. Fully flagged invocations never touch stdin; missing values are prompted.
ZI_USAGE = () StringView { "usage: zenc init [path] [--bin|--lib]\n       zenc init --help\n" }
ZiInitArgs: {
    path: StringView,
    kind: i32,
    ok: bool,
    help: bool,
}
ZI_KIND_PROMPT = 0
ZI_KIND_EXECUTABLE = 1
ZI_KIND_LIBRARY = 2
zi_pick_kind = (have: i32, want: i32) i32 {
    (have == ZI_KIND_PROMPT || have == want).then({ want }, { 0 - 1 })
}
zi_init_args = (path: StringView, kind: i32, ok: bool, help: bool) ZiInitArgs {
    ZiInitArgs(
        path: path,
        kind: kind,
        ok: ok,
        help: help,
    )
}
zi_scan_args = (i: i32, n: i32, path: StringView, kind: i32, valid: bool) ZiInitArgs {
    (i >= n).then({
        return zi_init_args(path, kind, valid, false)
    })
    a = arg(i)
    (a == "--help").then({
        return zi_init_args(path, kind, true, true)
    })
    (a == "--bin" || a == "--exe").then({
        next = zi_pick_kind(kind, ZI_KIND_EXECUTABLE)
        return zi_scan_args(i + 1, n, path, next, valid && next > 0)
    })
    (a == "--lib").then({
        next = zi_pick_kind(kind, ZI_KIND_LIBRARY)
        return zi_scan_args(i + 1, n, path, next, valid && next > 0)
    })
    v: [u8] = a.view()
    (v.len > 0 && v[0] == '-').match ({
        true  => zi_init_args(path, kind, false, false),
        false => (path == "").match ({
            true  => zi_scan_args(i + 1, n, a, kind, valid),
            false => zi_init_args(path, kind, false, false),
        }),
    })
}
// One prompt line, without consuming the next prompt's input (read_stdin intentionally reads to EOF).
zi_read_line = (mp: MutPtr<Malloc>, prompt: StringView) StringView {
    eprint(prompt)
    s ::= mp.gstr_string(64)
    cell: [u8] = [0]
    repeat_while((k) {
        n = read(0, cell.ptr, 1)
        s = (n > 0 && cell[0] != '\n' && cell[0] != '\r').then({ s.gstr_push(mp, cell[0]) }, { s })
        (n <= 0 || cell[0] == '\n') == false
    })
    s.gstr_finish(mp)
}
zi_kind_choice = (s: StringView) i32 {
    (s == "" || s == "1" || s == "bin" || s == "exe" || s == "executable").match ({
        true  => ZI_KIND_EXECUTABLE,
        false => (s == "2" || s == "lib" || s == "library").then({ ZI_KIND_LIBRARY }, { 0 - 1 }),
    })
}
zi_prompt_kind = (mp: MutPtr<Malloc>) i32 {
    eprint("Project type:\n  1) Executable\n  2) Library\n")
    zi_kind_choice(mp.zi_read_line("Select [1]: "))
}
// Names are embedded in TOML, a string literal, and the executable output path. Keep them portable
// and injection-free until the compiler's own cc command quotes arbitrary project paths.
zi_ascii_alnum = (b: u8) bool {
    b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z' || b >= '0' && b <= '9'
}
zi_name_tail = (v: [u8], i: i64) bool {
    (i >= v.len).match ({
        true  => true,
        false => (zi_ascii_alnum(v[i]) || v[i] == '_' || v[i] == '-').match ({
            true  => v.zi_name_tail(i + 1),
            false => false,
        }),
    })
}
zi_name_valid = (s: StringView) bool {
    v: [u8] = s.view()
    v.len > 0 && zi_ascii_alnum(v[0]) && v.zi_name_tail(1)
}
zi_path_char = (b: u8) bool { zi_ascii_alnum(b) || b == '_' || b == '-' || b == '.' || b == '/' }
zi_dot_segment = (v: [u8], start: i64, end: i64) bool {
    n = end - start
    n == 1 && v[start] == '.' || n == 2 && v[start] == '.' && v[start + 1] == '.'
}
zi_path_valid_at = (v: [u8], i: i64, start: i64) bool {
    (i >= v.len).match ({
        true  => v.zi_dot_segment(start, i) == false,
        false => (zi_path_char(v[i]) && (v[i] != '/' || i == 0 || v[i - 1] != '/')).match ({
            true  => (v[i] == '/').match ({
                true  => (v.zi_dot_segment(start, i) == false).match ({
                    true  => v.zi_path_valid_at(i + 1, i + 1),
                    false => false,
                }),
                false => v.zi_path_valid_at(i + 1, start),
            }),
            false => false,
        }),
    })
}
zi_path_valid = (s: StringView) bool { s.view().zi_path_valid_at(0, 0) }
zi_trim_end = (v: [u8], n: i64) i64 {
    (n > 0 && v[n - 1] == '/').then({ v.zi_trim_end(n - 1) }, { n })
}
zi_normal_path = (mp: MutPtr<Malloc>, raw: StringView) StringView {
    v: [u8] = raw.view()
    n = v.zi_trim_end(v.len)
    (n == v.len).then({ raw }, { mp.cstr_substr(raw, 0, to_i32(n)) })
}
zi_project_name = (mp: MutPtr<Malloc>, path: StringView) StringView {
    v: [u8] = path.view()
    slash = last_slash(v, 0, 0 - 1)
    start = slash + 1
    mp.cstr_substr(path, to_i32(start), to_i32(v.len - start))
}
ZI_OPEN_NEW = O_WRONLY | O_CREAT | O_EXCL
ZiDirCreate: {
    ok: bool,
    created: bool,
}
// mkdir may lose a race after the existence probe. A directory now present is usable, but `created`
// stays false so rollback never removes something another process owns.
zi_ensure_dir = (path: StringView) ZiDirCreate {
    file_exists(path).match ({
        true  => ZiDirCreate(
            ok: dir_exists(path),
            created: false,
        ),
        false => (mkdir(path, MODE_755) == 0).match ({
            true  => ZiDirCreate(
                ok: true,
                created: true,
            ),
            false => ZiDirCreate(
                ok: dir_exists(path),
                created: false,
            ),
        }),
    })
}
zi_make_tree = (mp: MutPtr<Malloc>, path: StringView) ZiDirCreate {
    v: [u8] = path.view()
    ok ::= true
    one: i64 = 1
    one.step_while((i) { i < v.len && ok }, (i) {
        (v[i] == '/').then({
            prefix = mp.cstr_substr(path, 0, to_i32(i))
            ok = zi_ensure_dir(prefix).ok
        })
        i + 1
    })
    ok.match ({
        true  => zi_ensure_dir(path),
        false => ZiDirCreate(
            ok: false,
            created: false,
        ),
    })
}
zi_write_all = (fd: i32, p: RawPtr<u8>, n: i64) bool {
    (n <= 0).match ({
        true  => true,
        false => {
            wrote = write(fd, p, n)
            (wrote <= 0).then({ false }, { zi_write_all(fd, p.offset(wrote), n - wrote) })
        },
    })
}
// Exclusive creation is the no-clobber guarantee even if another process races the preflight.
zi_save_new = (path: StringView, data: StringView) bool {
    fd = open(path, ZI_OPEN_NEW, MODE_644)
    (fd < 0).match ({
        true  => false,
        false => {
            v: [u8] = data.view()
            wrote = zi_write_all(fd, v.ptr, v.len)
            shut = close(fd) == 0
            (wrote && shut).match ({
                true  => true,
                false => {
                    unlink(path)
                    false
                },
            })
        },
    })
}
zi_manifest = (mp: MutPtr<Malloc>, name: StringView, kind: i32) StringView {
    s = mp.gstr_string(160).gstr_append(mp, "package = \"").gstr_append(mp, name)
    (kind == ZI_KIND_LIBRARY).match ({
        true  => s
            .gstr_append(mp, "\"\nkind = \"library\"\nroot = \"src\"\nmain = \"lib.zen\"\n")
            .gstr_finish(mp),
        false => s
            .gstr_append(mp, "\"\nkind = \"executable\"\nroot = \"src\"\nmain = \"main.zen\"\nout = \"")
            .gstr_append(mp, name)
            .gstr_append(mp, "\"\n")
            .gstr_finish(mp),
    })
}
zi_source = (mp: MutPtr<Malloc>, name: StringView, kind: i32) StringView {
    (kind == ZI_KIND_LIBRARY).match ({
        true  => "answer* = () i32 { 42 }\n",
        false => mp
            .gstr_string(128)
            .gstr_append(mp, "{ println } = std.text.fmt\nmain = () i32 {\n    println(\"Hello from ")
            .gstr_append(mp, name)
            .gstr_append(mp, "!\")\n    0\n}\n")
            .gstr_finish(mp),
    })
}
zi_collision = (path: StringView) i32 {
    eprint("zenc init: ")
    eprint(path)
    eprint(" already exists; nothing was changed\n")
    1
}
zi_remove_dir = (path: StringView) void { removed = rmdir(path) }
zi_cleanup_dirs = (srcdir: StringView, target: StringView, made_src: bool, made_target: bool) void {
    made_src.then(() { zi_remove_dir(srcdir) })
    made_target.then(() { zi_remove_dir(target) })
}
zi_create = (mp: MutPtr<Malloc>, target: StringView, name: StringView, kind: i32) i32 {
    manifest = mp.join2(target, "zen.toml")
    buildfile = mp.join2(target, "build.zen")
    srcdir = mp.join2(target, "src")
    entry = (kind == ZI_KIND_LIBRARY).then({ "lib.zen" }, { "main.zen" })
    source = mp.join2(srcdir, entry)
    target_exists = file_exists(target)
    (target_exists && dir_exists(target) == false).then({
        eprint("zenc init: target exists and is not a directory: ")
        eprint(target)
        eprint("\n")
        return 1
    })
    file_exists(buildfile).then({
        return zi_collision(buildfile)
    })
    file_exists(manifest).then({
        return zi_collision(manifest)
    })
    (file_exists(srcdir) && dir_exists(srcdir) == false).then({
        return zi_collision(srcdir)
    })
    file_exists(source).then({
        return zi_collision(source)
    })
    target_dir = mp.zi_make_tree(target)
    (target_dir.ok == false).then({
        eprint("zenc init: could not create project directory: ")
        eprint(target)
        eprint("\n")
        return 1
    })
    src_dir = zi_ensure_dir(srcdir)
    (src_dir.ok == false).then({
        eprint("zenc init: could not create source directory: ")
        eprint(srcdir)
        eprint("\n")
        zi_cleanup_dirs(srcdir, target, false, target_dir.created)
        return 1
    })
    (zi_save_new(source, mp.zi_source(name, kind)) == false).then({
        eprint("zenc init: could not create source file: ")
        eprint(source)
        eprint("\n")
        zi_cleanup_dirs(srcdir, target, src_dir.created, target_dir.created)
        return 1
    })
    (zi_save_new(manifest, mp.zi_manifest(name, kind)) == false).then({
        unlink(source)
        eprint("zenc init: could not create manifest: ")
        eprint(manifest)
        eprint("\n")
        zi_cleanup_dirs(srcdir, target, src_dir.created, target_dir.created)
        return 1
    })
    eprint("Created ")
    eprint((kind == ZI_KIND_LIBRARY).then({ "library" }, { "executable" }))
    eprint(" project `")
    eprint(name)
    eprint("` at ")
    eprint(target)
    eprint("\n")
    eprint((kind == ZI_KIND_LIBRARY).match ({
        true  => "Check it with: zenc check ",
        false => "Run it with: zenc run ",
    }))
    eprint(target)
    eprint("\n")
    0
}
zi_cmd = (mp: MutPtr<Malloc>) i32 {
    parsed = zi_scan_args(2, argc(), "", ZI_KIND_PROMPT, true)
    parsed.help.then({
        say(ZI_USAGE())
        return 0
    })
    (parsed.ok == false).then({
        eprint(ZI_USAGE())
        return 2
    })
    rawpath = (parsed.path == "").match ({
        true  => mp.zi_read_line("Project name or path: "),
        false => parsed.path,
    })
    path = mp.zi_normal_path(rawpath)
    (path == "" || zi_path_valid(path) == false).then({
        eprint("zenc init: project path uses unsafe characters or a '.'/'..' component\n")
        return 2
    })
    name = mp.zi_project_name(path)
    (zi_name_valid(name) == false).then({
        eprint("zenc init: project name must match [A-Za-z0-9][A-Za-z0-9_-]*\n")
        return 2
    })
    kind = (parsed.kind == ZI_KIND_PROMPT).then({ mp.zi_prompt_kind() }, { parsed.kind })
    (kind != ZI_KIND_EXECUTABLE && kind != ZI_KIND_LIBRARY).then({
        eprint("zenc init: choose 1/executable or 2/library\n")
        return 2
    })
    mp.zi_create(path, name, kind)
}
// ── project mode: `zenc build|run|check <dir>` driven by <dir>/zen.toml ───────────────────────────
Spec*: {
    source: StringView,
    out: StringView,
    ccflags: StringView,
    links: StringView,
    ffi: StringView,
    genmods: StringView,
    target: StringView,
    library: bool,
    ok: bool,
}    // target: "" = native (host cc), else a cross triple like "aarch64-linux-gnu"
link_flag = (mp: MutPtr<Malloc>, lk: StringView) StringView {
    mp
        .gstr_string(8)
        .gstr_append(mp, "-l")
        .gstr_append(mp, lk)
        .gstr_finish(mp)
}
// a zen.toml `key = "value"` -> the value (or "" if absent), via the Zen manifest parser.
manifest_value = (mp: MutPtr<Malloc>, src: StringView, key: StringView) StringView {
    sp = manifest_value_span(src, to_i32(src.view().len), key, 0)
    (sp.start < 0).then({ "" }, { mp.cstr_substr(src, sp.start, sp.len) })
}
// read <dir>/zen.toml -> a project Spec (ok=false if absent or missing root/main).
proj_spec = (mp: MutPtr<Malloc>, dir: StringView) Spec {
    contents_in(mp, mp.join2(dir, "zen.toml")).match ({
        .Ok(src) => {
            root = mp.manifest_value(src, "root")
            main = mp.manifest_value(src, "main")
            kind = mp.manifest_value(src, "kind")
            kind_ok = kind == "" || kind == "executable" || kind == "library"
            (root == "" || main == "" || kind_ok == false).match ({
                true  => Spec(
                    source: "",
                    out: "",
                    ccflags: "",
                    links: "",
                    ffi: "",
                    genmods: "",
                    target: "",
                    library: false,
                    ok: false,
                ),
                false => {
                    out = mp.manifest_value(src, "out")
                    cc = mp.manifest_value(src, "ccflags")
                    lk = mp.manifest_value(src, "link")
                    fg = mp.manifest_value(src, "ffi")
                    Spec(
                        source: mp.join2(mp.join2(dir, root), main),
                        out: (out == "").then({ "" }, { mp.join2(dir, out) }),
                        ccflags: cc,
                        links: (lk == "").then({ "" }, { mp.link_flag(lk) }),
                        ffi: fg,
                        genmods: "",
                        target: "",
                        library: kind == "library",
                        ok: true,
                    )
                },
            })
        },
        .Err(e)  => Spec(
            source: "",
            out: "",
            ccflags: "",
            links: "",
            ffi: "",
            genmods: "",
            target: "",
            library: false,
            ok: false,
        ),
    })
}
// arg -> Spec: a directory with build.zen/zen.toml is a project; otherwise a single file (empty
// cc/links/out). A manifest that EXISTS but is malformed (missing root/main, won't compile) is a loud
// error (ok=false) — NOT a silent fall-through to treating the directory itself as a source file.
resolve_spec = (mp: MutPtr<Malloc>, root: StringView, arg: StringView) Spec {
    file_exists(mp.join2(arg, "build.zen")).match ({
        true  => mp.build_zen_spec(root, arg),
        false => file_exists(mp.join2(arg, "zen.toml")).match ({
            true  => {
                s = mp.proj_spec(arg)
                s.ok.match ({
                    true  => s,
                    false => {
                        eprint("zenc: ")
                        eprint(mp.join2(arg, "zen.toml"))
                        eprint(": invalid manifest (need `root`/`main`; optional `kind` is executable or library)\n")
                        s
                    },
                })
            },
            false => Spec(
                source: arg,
                out: "",
                ccflags: "",
                links: "",
                ffi: "",
                genmods: "",
                target: "",
                library: false,
                ok: true,
            ),
        }),
    })
}    // a single .zen file
// ── build.zen mode: the build IS a Zen program. Append a main that prints its Target's spec, compile
// + run it (capturing stdout to a file), parse the 10-line records back (name/root/main/out/links/
// sources/os/arch/abi/ffi — see std.build's emit_target). Wins over zen.toml. ─────────────────────
BUILDBIN = (mp: MutPtr<Malloc>) StringView { mp.pid_path("/tmp/zenbuild_spec_", ".bin") }
SPECFILE = (mp: MutPtr<Malloc>) StringView { mp.pid_path("/tmp/zenbuild_spec_", ".txt") }
BUILD_TAIL = () StringView {
    "\nmain = () i32 { b = build_context()  build(b.addr())  b.emit_spec()  b.deinit()  0 }\n"
}
// the [start,end) of line `idx` (0-based) in v; field idx of the emitted spec.
line_start = (v: [u8], idx: i32, p: i64) i64 {
    (idx <= 0).match ({
        true  => p,
        false => (p >= v.len).then({ p }, { v.line_start(idx - 1, v.bs_line_end(p, v.len) + 1) }),
    })
}
spec_field = (mp: MutPtr<Malloc>, v: [u8], idx: i32) StringView {
    s = v.line_start(idx, 0)
    e = v.bs_line_end(s, v.len)
    mp.bs_push_range(mp.gstr_string(e - s + 1), v, s, e).gstr_finish(mp)
}
source_word_end = (v: [u8], i: i64) i64 {
    (i >= v.len || v[i] == ' ').then({ i }, { v.source_word_end(i + 1) })
}
source_words = (mp: MutPtr<Malloc>, dir: StringView, v: [u8], i: i64, out: String) String {
    (i >= v.len).match ({
        true  => out,
        false => (v[i] == ' ').match ({
            true  => mp.source_words(dir, v, i + 1, out),
            false => {
                e = v.source_word_end(i)
                // a `-`-prefixed word is a cc flag (Target.cflags / `-l` link input), passed
                // through verbatim; anything else names a project-relative extra .c source
                // (absolute paths also pass through).
                prefixed = (v[i] == '/' || v[i] == '-').match ({
                    true  => out,
                    false => out.gstr_append(mp, dir).gstr_append(mp, "/"),
                })
                next = mp.bs_push_range(prefixed, v, i, e).gstr_append(mp, " ")
                mp.source_words(dir, v, e, next)
            },
        }),
    })
}
source_flags = (mp: MutPtr<Malloc>, dir: StringView, src: StringView) StringView {
    mp.source_words(dir, src.view(), 0, mp.gstr_string(128)).gstr_finish(mp)
}
// ── the plan's platform fields (lines 7-9 of each 10-line record: os/arch/abi as the integer
// codes std.build's build_os_code/build_arch_code/build_abi_code print). A record whose codes
// match the HOST (std.build defaults every Target to host()) — or a legacy short plan with the
// lines absent — is a NATIVE build: Spec.target stays "" and the cc path is untouched. Anything
// else is a cross target, canonicalized to the `<arch>-<os>-<abi>` GNU config triple
// (aarch64-linux-gnu, riscv64-linux-musl, …) that names the conventional cross gcc. ─────────────
spec_code = (s: StringView) i32 {
    v: [u8] = s.view()
    (v.len <= 0).then({ 0 - 1 }, { to_i32(v[0] - '0') })
}    // one plan code line -> its integer (codes are single digits); absent line -> -1
cross_os_code = (o: Os) i32 {
    o.match ({
        .MacOS   => 1,
        .Linux   => 2,
        .Windows => 3,
        .FreeBSD => 4,
        _        => 0,
    })
}    // mirrors std.build's build_os_code
cross_arch_code = (a: Arch) i32 {
    a.match ({
        .Arm64   => 1,
        .X86_64  => 2,
        .RiscV64 => 3,
        .Wasm32  => 4,
        _        => 0,
    })
}    // mirrors std.build's build_arch_code
cross_abi_code = (b: Abi) i32 {
    b.match ({
        .Darwin => 1,
        .Gnu    => 2,
        .Musl   => 3,
        .Msvc   => 4,
        .Wasi   => 5,
        _       => 0,
    })
}    // mirrors std.build's build_abi_code
cross_os_name = (n: i32) StringView {
    (n == 1).match ({
        true  => "macos",
        false => (n == 2).match ({
            true  => "linux",
            false => (n == 3).match ({
                true  => "windows",
                false => (n == 4).then({ "freebsd" }, { "unknown" }),
            }),
        }),
    })
}
cross_arch_name = (n: i32) StringView {
    (n == 1).match ({
        true  => "aarch64",
        false => (n == 2).match ({
            true  => "x86_64",
            false => (n == 3).match ({
                true  => "riscv64",
                false => (n == 4).then({ "wasm32" }, { "unknown" }),
            }),
        }),
    })
}
cross_abi_name = (n: i32) StringView {
    (n == 1).match ({
        true  => "darwin",
        false => (n == 2).match ({
            true  => "gnu",
            false => (n == 3).match ({
                true  => "musl",
                false => (n == 4).match ({
                    true  => "msvc",
                    false => (n == 5).then({ "wasi" }, { "unknown" }),
                }),
            }),
        }),
    })
}
cross_triple = (mp: MutPtr<Malloc>, osc: i32, arc: i32, abc: i32) StringView {
    hp = host()
    absent = osc < 0 || arc < 0 || abc < 0
    is_host = osc == cross_os_code(hp.os)
        && arc == cross_arch_code(hp.arch)
        && abc == cross_abi_code(hp.abi)
    (absent || is_host).match ({
        true  => "",
        false => mp
            .gstr_string(32)
            .gstr_append(mp, cross_arch_name(arc))
            .gstr_append(mp, "-")
            .gstr_append(mp, cross_os_name(osc))
            .gstr_append(mp, "-")
            .gstr_append(mp, cross_abi_name(abc))
            .gstr_finish(mp),
    })
}
// v1 cross scope is LINUX cross-ARCH only: aarch64/x86_64/riscv64, gnu or musl. Cross-OS (macOS/
// Windows/FreeBSD) and wasm error loudly instead of producing garbage — bootstrap/zenrt.c is
// POSIX/glibc-shaped (sigaltstack, ucontext SP reads, pthread), and no conventional Linux-hosted
// cross toolchain exists for those targets.
cross_supported = (osc: i32, arc: i32, abc: i32) bool {
    osc == 2 && (arc == 1 || arc == 2 || arc == 3) && (abc == 2 || abc == 3)
}
parse_spec_at = (mp: MutPtr<Malloc>, dir: StringView, specsrc: StringView, index: i32) Spec {
    v: [u8] = specsrc.view()
    base = 1 + index * 10
    name = mp.spec_field(v, base)
    root = mp.spec_field(v, base + 1)
    main = mp.spec_field(v, base + 2)
    out = mp.spec_field(v, base + 3)
    link = mp.spec_field(v, base + 4)
    cc = mp.spec_field(v, base + 5)
    osc = spec_code(mp.spec_field(v, base + 6))
    arc = spec_code(mp.spec_field(v, base + 7))
    abc = spec_code(mp.spec_field(v, base + 8))
    fg = mp.spec_field(v, base + 9)
    tgt = mp.cross_triple(osc, arc, abc)
    (root == "" || main == "").match ({
        true  => {
            eprint("zenc: build.zen: target is missing root/main\n")
            Spec(
                source: "",
                out: "",
                ccflags: "",
                links: "",
                ffi: "",
                genmods: "",
                target: "",
                library: false,
                ok: false,
            )
        },
        false => (tgt == "" == false && cross_supported(osc, arc, abc) == false).match ({
            true  => {
                eprint("zenc: build.zen: cross target ")
                eprint(tgt)
                eprint(" is unsupported in v1 (Linux aarch64|x86_64|riscv64, gnu|musl only)\n")
                empty_spec()
            },
            false => Spec(
                source: mp.join2(mp.join2(dir, root), main),
                out: (out == "").match ({
                    true  => (name == "").then({ "" }, { mp.join2(dir, name) }),
                    false => mp.join2(dir, out),
                }),
                ccflags: mp.source_flags(dir, cc),
                links: link,
                ffi: fg,
                genmods: mp.genmods_extract(dir, specsrc, index),
                target: tgt,
                library: false,
                ok: true,
            ),
        }),
    })
}
empty_spec = () Spec {
    Spec(
        source: "",
        out: "",
        ccflags: "",
        links: "",
        ffi: "",
        genmods: "",
        target: "",
        library: false,
        ok: false,
    )
}
// ── c_library genmods: the plan's trailing section (see std.build's c_library block) ─────────────
// After the N×10 target lines the plan carries the use()-records: one count line `G`, then per
// record a header line `<target> <id> <lib> <K>` followed by exactly K lines of generated module
// source (line-count-prefixed framing — the body is opaque to the line-based transport). For the
// SELECTED target the driver writes each body to <projdir>/.zen/gen/<id>.zen (gitignored) and
// returns the resolver registry text (`<id> <path>` lines) for genmods_set — stamped beside the
// ffi grants, before probe AND resolve, so the cache walk and the module loader both see the
// generated file through the one canonical module_path.
GENSUB = () StringView { ".zen/gen" }
gmx_tok_end = (v: [u8], i: i64) i64 {
    (i >= v.len || v[i] == ' ' || v[i] == '\n').then({ i }, { v.gmx_tok_end(i + 1) })
}
gmx_skip_lines = (v: [u8], p: i64, k: i32) i64 {
    (k <= 0 || p >= v.len).then({ p }, { v.gmx_skip_lines(v.bs_line_end(p, v.len) + 1, k - 1) })
}
gmx_write = (
    mp: MutPtr<Malloc>,
    dir: StringView,
    id: StringView,
    body: StringView,
    blen: i64,
) StringView {
    mkdir(mp.join2(dir, ".zen"), MODE_755)
    gdir = mp.join2(dir, GENSUB())
    mkdir(gdir, MODE_755)
    gpath = mp
        .gstr_string(96)
        .gstr_append(mp, gdir)
        .gstr_append(mp, "/")
        .gstr_append(mp, id)
        .gstr_append(mp, ".zen")
        .gstr_finish(mp)
    save(gpath, body, blen).match ({
        .Ok(n)  => { },
        .Err(e) => eprint("zenc: build.zen: cannot write generated module\n"),
    })
    gpath
}
genmods_from = (
    mp: MutPtr<Malloc>,
    dir: StringView,
    specsrc: StringView,
    tname: StringView,
    p: i64,
    left: i32,
    acc: String,
) StringView {
    v: [u8] = specsrc.view()
    (left <= 0 || p >= v.len).match ({
        true  => acc.gstr_finish(mp),
        false => {
            te = v.gmx_tok_end(p)
            ie = v.gmx_tok_end(te + 1)
            le = v.gmx_tok_end(ie + 1)
            ke = v.bs_line_end(le + 1, v.len)
            be = v.gmx_skip_lines(ke + 1, v.plan_nat(le + 1, ke, 0))
            nxt = (mp.cstr_substr(specsrc, to_i32(p), to_i32(te - p)) == tname).match ({
                true  => {
                    id = mp.cstr_substr(specsrc, to_i32(te + 1), to_i32(ie - te - 1))
                    body = mp.cstr_substr(specsrc, to_i32(ke + 1), to_i32(be - ke - 1))
                    acc
                        .gstr_append(mp, id)
                        .gstr_append(mp, " ")
                        .gstr_append(mp, mp.gmx_write(dir, id, body, be - ke - 1))
                        .gstr_push(mp, '\n')
                },
                false => acc,
            })
            mp.genmods_from(dir, specsrc, tname, be, left - 1, nxt)
        },
    })
}
genmods_extract = (
    mp: MutPtr<Malloc>,
    dir: StringView,
    specsrc: StringView,
    index: i32,
) StringView {
    v: [u8] = specsrc.view()
    gs = v.line_start(1 + specsrc.plan_count() * 10, 0)
    g = v.plan_nat(gs, v.bs_line_end(gs, v.len), 0)
    mp.genmods_from(dir, specsrc, mp.spec_field(v, 1 + index * 10), v.bs_line_end(gs, v.len) + 1, g, mp.gstr_string(64))
}
plan_nat = (v: [u8], i: i64, e: i64, n: i32) i32 {
    (i >= e).match ({
        true  => n,
        false => (v[i] >= '0' && v[i] <= '9').match ({
            true  => v.plan_nat(i + 1, e, n * 10 + to_i32(v[i] - '0')),
            false => n,
        }),
    })
}
plan_count = (specsrc: StringView) i32 {
    v = specsrc.view()
    v.plan_nat(0, v.bs_line_end(0, v.len), 0)
}
PlanSource*: {
    src: StringView,
    ok: bool,
}
build_zen_plan = (mp: MutPtr<Malloc>, root: StringView, dir: StringView) PlanSource {
    contents_in(mp, mp.join2(dir, "build.zen")).match ({
        .Ok(bsrc) => {
            es = mp.gstr_string(1024).gstr_append(mp, bsrc).gstr_append(mp, BUILD_TAIL())
            entry = es.gstr_finish(mp)
            epath = mp.join2(dir, ".zenbuild_entry.zen")
            save(epath, entry, es.len).match ({
                .Ok(n)  => { },
                .Err(e) => { },
            })
            bbin = mp.BUILDBIN()
            rc = mp.compile_to(root, epath, entry, bbin, "", "", "")    // the build program always runs on the HOST
            unlink(epath)    // don't leave the entry in the project dir
            (rc == 0).match ({
                true  => {
                    spf = mp.SPECFILE()
                    mp
                        .gstr_string(256)
                        .gstr_append(mp, bbin)
                        .gstr_append(mp, " > ")
                        .gstr_append(mp, spf)
                        .gstr_finish(mp)
                        .system()
                    sp = contents_in(mp, spf).match ({
                        .Ok(spec) => PlanSource(
                            src: spec,
                            ok: true,
                        ),
                        .Err(e)   => PlanSource(
                            src: "",
                            ok: false,
                        ),
                    })
                    unlink(bbin)
                    unlink(spf)
                    sp
                },
                false => {
                    eprint("zenc: build.zen: the build program did not compile\n")
                    PlanSource(
                        src: "",
                        ok: false,
                    )
                },
            })
        },
        .Err(e)   => PlanSource(
            src: "",
            ok: false,
        ),
    })
}
plan_find_name = (mp: MutPtr<Malloc>, src: StringView, wanted: StringView, i: i32, n: i32) i32 {
    (i >= n).match ({
        true  => 0 - 1,
        false => (mp.spec_field(src.view(), 1 + i * 10) == wanted).match ({
            true  => i,
            false => mp.plan_find_name(src, wanted, i + 1, n),
        }),
    })
}
build_zen_spec = (mp: MutPtr<Malloc>, root: StringView, dir: StringView) Spec {
    p = mp.build_zen_plan(root, dir)
    (p.ok && p.src.plan_count() > 0).then({ mp.parse_spec_at(dir, p.src, 0) }, { empty_spec() })
}    // no build.zen -> try zen.toml
build_named_plan = (mp: MutPtr<Malloc>, root: StringView, dir: StringView, wanted: StringView) i32 {
    p = mp.build_zen_plan(root, dir)
    n = p.src.plan_count()
    i = mp.plan_find_name(p.src, wanted, 0, n)
    (p.ok && i >= 0).match ({
        true  => mp.build_spec(root, mp.parse_spec_at(dir, p.src, i), "", ""),
        false => {
            eprint("zenc: build.zen: no target named `")
            eprint(wanted)
            eprint("`\n")
            1
        },
    })
}
build_plan_from = (
    mp: MutPtr<Malloc>,
    root: StringView,
    dir: StringView,
    src: StringView,
    i: i32,
    n: i32,
    failures: i32,
) i32 {
    (i >= n).match ({
        true  => failures,
        false => mp.build_plan_from(root, dir, src, i + 1, n, failures + mp.build_spec(root, mp.parse_spec_at(dir, src, i), "", "")),
    })
}
build_all_plan = (mp: MutPtr<Malloc>, root: StringView, dir: StringView) i32 {
    p = mp.build_zen_plan(root, dir)
    p.ok.then({ mp.build_plan_from(root, dir, p.src, 0, p.src.plan_count(), 0) }, { 1 })
}
list_plan_from = (mp: MutPtr<Malloc>, src: StringView, i: i32, n: i32) i32 {
    (i >= n).match ({
        true  => 0,
        false => {
            say(mp.spec_field(src.view(), 1 + i * 10))
            mp.list_plan_from(src, i + 1, n)
        },
    })
}
list_plan_targets = (mp: MutPtr<Malloc>, root: StringView, dir: StringView) i32 {
    p = mp.build_zen_plan(root, dir)
    p.ok.then({ mp.list_plan_from(p.src, 0, p.src.plan_count()) }, { 1 })
}
