Emit, order = gen.gen_emit

main = (env: Env) Res<i32, AllocError> {
    a   ::= env.mem.alloc();
    out ::= a.Emit().try();
    out.dedent();
    out.indent();
    out.bytes("").try();
    out.bytes("one\n\ntwo\n").try();
    out.indent();
    out.byte('x').try();
    out.number(42).try();
    out.byte('\n').try();
    out.dedent();
    out.say("done").try();
    out.line().try();
    println("indentation {}", out.view().eq("    one\n\n    two\n        x42\n    done\n\n"));

    keys ::= a.Vec<String>();
    ["z", "a", "b", "a", "", "z", "a"].loop((h, key) {
        text ::= a.String().try();
        text.add(key).try();
        keys.add(text).try();
    });
    indices = order(a, keys).try();
    indices.loop((h, i) { println("{}", i); });
    empty ::= a.Vec<String>();
    println("empty {}", order(a, empty).try().len);
    Ok(0)
}
