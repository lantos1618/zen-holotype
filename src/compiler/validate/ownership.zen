// compiler.validate.ownership — move/consume/escape/leak analysis + DeadList/AliasList worklists.
{ ArmData, CallData, Decl, Expr, Field, FieldInit, Func, GenericData, ImplData, LetData,
  MethodCallData, Param, Stmt, Ty, VariantDef } = compiler.ast.ast_types
{ gstr_append, gstr_finish, gstr_string, k_mut_ptr, k_slice_dflt, ptr_kw, slice_kw, tnamed, tvoid,
  acquire_or_die } = compiler.genc
{ impl_cname_in } = compiler.mangle
{ DeclIndex, Env, arm_env, dispatch_recv, dispatch_recv_name, extend_env, is_intrinsic, is_void_ty,
  pointee_of, recv_name } = compiler.check
{ Malloc } = std.mem.alloc
{ slice_any } = compiler.astops
{ expr_fold_children } = compiler.ast.expr_children
{ expect } = std.core.result
{ Map, of } = std.collections.map
{ is_empty } = std.text.str
{ env_imported, env_params, env_trait_method, expr_pos, is_deref_intrinsic, is_direct_scope_acquire,
  is_pure_owner_getter, is_scope_acquire, is_scope_alloc_member, is_scope_param_ty, pos_or,
  ty_is_ptr_t, ty_mentions_tparam, unknown_ty } = compiler.validate.util
{ KMUSTUSE } = compiler.validate.diag
{ arg_var_name, mkstruct_field_kills, slicelit_elem_kills, struct_fields, sx_named } = compiler.validate.args
{ enum_variants, first_gen_arg } = compiler.validate.kinds
{ kv_at, name_read_in_args, name_read_in_body, name_read_in_expr } = compiler.validate.core
{ loop_at } = std.core.count
DeadList*: DeadNil | DeadCons(DeadCell)    // let/assign/while/if/index-set produce no value
// Raw ownership validation runs before resolve_module in the CLI, while source-level
// allocator-explicit `o.release_in(a)` / `r.drop_in(a)` calls still exist. After generic inlining those calls
// become plain pointer operations, so this rule cannot be recovered reliably later.
DeadCell: {
    name: StringView,
    tail: Ptr<DeadList>,
}
dead_buf = (a: MutPtr<Malloc>) [DeadList] { slice(a.acquire_or_die(sizeof(DeadList)), 1) }
dead_node = (a: MutPtr<Malloc>, v: DeadList) Ptr<DeadList> {
    buf ::= a.dead_buf()
    buf[0] = v
    buf[0].addr()
}
dead_nil* = (a: MutPtr<Malloc>) Ptr<DeadList> { a.dead_node(.DeadNil) }
dead_cons* = (a: MutPtr<Malloc>, name: StringView, tail: Ptr<DeadList>) Ptr<DeadList> {
    a.dead_node(.DeadCons(DeadCell(
        name: name,
        tail: tail,
    )))
}
dead_has* = (seen: Ptr<DeadList>, name: StringView) bool {
    seen.match ({
        .DeadNil     => false,
        .DeadCons(c) => (c.name == name).then({ true }, { c.tail.dead_has(name) }),
    })
}
// REVIVAL: rebuild the kill-set without `name`. Rebinding a freed/moved local to a fresh value clears
// its dead state (so `p = malloc(); a.release(p); p = malloc(); use(p)` and the idiomatic
// `p = a.resize(p, n)` are NOT use-after-free). Removes every occurrence (dups are harmless).
dead_remove* = (a: MutPtr<Malloc>, seen: Ptr<DeadList>, name: StringView) Ptr<DeadList> {
    seen.match ({
        .DeadNil     => seen,
        .DeadCons(c) => (c.name == name).match ({
            true  => a.dead_remove(c.tail, name),
            false => a.dead_cons(c.name, a.dead_remove(c.tail, name)),
        }),
    })
}
// ── ALIAS CLASSES (name-only) ────────────────────────────────────────────────────────────────────
// `q = p` copies a POINTER, not the allocation: freeing either name frees the ONE allocation, so a
// later use (or second free) of the other name is a hole the per-name kill-set misses. We track
// direct pointer-copy binds (`q = p` / `q = p`, both bare locals, pointer-typed) as ALIAS PAIRS;
// killing any name kills its whole (transitive) alias class, while REVIVAL stays per-name: rebinding
// `q` detaches only `q` (its pairs are dropped, only `q` leaves the kill-set). Anything indirect —
// field reads, call returns, `.addr()` — is deliberately untracked (under-reject, never over-reject),
// matching the bare-locals-only scope of the rest of this pass.
AliasList*: AliasNil | AliasCons(AliasCell)
AliasCell: {
    x: StringView,
    y: StringView,
    tail: Ptr<AliasList>,
}
alias_buf = (a: MutPtr<Malloc>) [AliasList] { slice(a.acquire_or_die(sizeof(AliasList)), 1) }
alias_node = (a: MutPtr<Malloc>, v: AliasList) Ptr<AliasList> {
    buf ::= a.alias_buf()
    buf[0] = v
    buf[0].addr()
}
alias_nil* = (a: MutPtr<Malloc>) Ptr<AliasList> { a.alias_node(.AliasNil) }
alias_cons = (
    a: MutPtr<Malloc>,
    x: StringView,
    y: StringView,
    tail: Ptr<AliasList>,
) Ptr<AliasList> {
    a.alias_node(.AliasCons(AliasCell(
        x: x,
        y: y,
        tail: tail,
    )))
}
// drop every pair mentioning `name` — a rebind of `name` detaches it from its old class.
alias_drop = (a: MutPtr<Malloc>, al: Ptr<AliasList>, name: StringView) Ptr<AliasList> {
    al.match ({
        .AliasNil     => al,
        .AliasCons(c) => (c.x == name || c.y == name).match ({
            true  => a.alias_drop(c.tail, name),
            false => a.alias_cons(c.x, c.y, a.alias_drop(c.tail, name)),
        }),
    })
}
// grow `acc` with every name reachable from `name` through the pair list (transitive closure; `acc`
// doubles as the visited set, so shared members are added once and cycles terminate).
alias_reach = (
    a: MutPtr<Malloc>,
    rest: Ptr<AliasList>,
    full: Ptr<AliasList>,
    name: StringView,
    acc: Ptr<DeadList>,
) Ptr<DeadList> {
    rest.match ({
        .AliasNil     => acc,
        .AliasCons(c) => {
            out ::= acc
            (c.x == name && out.dead_has(c.y) == false).then({
                out = a.alias_reach(full, full, c.y, a.dead_cons(c.y, out))
            })
            (c.y == name && out.dead_has(c.x) == false).then({
                out = a.alias_reach(full, full, c.x, a.dead_cons(c.x, out))
            })
            a.alias_reach(c.tail, full, name, out)
        },
    })
}
// kill `name` AND its alias class: every class member joins the kill-set (its own fresh closure set,
// so members already dead never mask the traversal).
dead_kill* = (
    a: MutPtr<Malloc>,
    seen: Ptr<DeadList>,
    al: Ptr<AliasList>,
    name: StringView,
) Ptr<DeadList> { a.dead_union(a.alias_reach(al, al, name, a.dead_cons(name, a.dead_nil())), seen) }
owner_base* = (t: Ty) StringView {
    t.match ({
        .Generic(g) => g.name,
        .Named(n)   => n,
        _           => "",
    })
}
// Consume verbs are matched with `sx_named` (bare OR `…__verb` alias-suffixed), never plain `eq`: a
// namespace bind (`m = sibling`) flattens the bound module's `release`/`drop` fns to `m__release`/
// `m__drop`, and a qualified call site (`m.drop(r, a)`) arrives here ALREADY prefixed — a bare-`eq`
// matcher would silently skip the consume and miss the use-after-free. Same policy as the send/spawn
// matchers below (see sx_named). A user fn deliberately named `x__drop` matches too — consistent with
// how a fn simply NAMED `drop` already matches today; the owner-typed-arg gate still applies.
is_consume_method = (env: Env, c: CallData) bool {
    (c.args.len > 0).match ({
        true  => {
            base = env.infer_expr(c.args[0].addr()).owner_base()
            c.fn.sx_named("release", "__release").match ({
                true  => base == "Own",
                false => c.fn.sx_named("release_in", "__release_in").match ({
                    true  => base == "Own",
                    false => c.fn.sx_named("drop", "__drop").match ({
                        true  => base == "Rc" || base == "Arc",
                        false => c.fn.sx_named("drop_in", "__drop_in").match ({
                            true  => base == "Rc" || base == "Arc",
                            false => false,
                        }),
                    }),
                }),
            })
        },
        false => false,
    })
}
is_default_owner_method* = (env: Env, c: CallData) bool {
    (c.args.len > 0).match ({
        true  => {
            base = env.infer_expr(c.args[0].addr()).owner_base()
            c.fn.sx_named("release", "__release").match ({
                true  => base == "Own",
                false => c.fn.sx_named("drop", "__drop").match ({
                    true  => base == "Rc" || base == "Arc",
                    false => false,
                }),
            })
        },
        false => false,
    })
}
recv_var_name = (c: CallData) StringView {
    (c.args.len > 0).match ({
        true  => c.args[0].match ({
            .Var(v) => v.name,
            _       => "",
        }),
        false => "",
    })
}
// the consumed binding of a release/drop receiver: a bare Var, or — for a FIELD receiver like
// `b.o.release_in(a)` — the ROOT local of the member chain (the field's owner is freed while the
// base keeps a bit-copy naming the same allocation → the whole base binding dies; see member_move_root).
recv_move_name = (c: CallData) StringView {
    (c.args.len > 0).match ({
        true  => c.args[0].match ({
            .Var(v)    => v.name,
            .Member(m) => m.obj.expr_root_var(),
            _          => "",
        }),
        false => "",
    })
}
// SENDABILITY — move-on-send. Passing an owned `Own<T>` into a `send(handle, msg)` transfers it to the
// receiving actor, so the sender must not keep using it (otherwise both sides free it → race/double-free).
// We mark the sent owner dead, reusing the use-after-free machinery. Catches the owner sent DIRECTLY or
// wrapped one level in an enum message (`send(h, .Wrap(own))`). Value/str/Arc messages are untouched —
// only `Own` is moved — so the ergonomic common case (value messages) sees zero new friction.
// the launder close: an `Own<T>` sent THROUGH an identity fn (`send(.Give(launder(o)))`) must still kill
// the sender's binding, or the sender keeps a live alias the receiving actor also owns → double-free. When
// the payload is a CALL that RETURNS an owned value and takes EXACTLY ONE `Own` bare-Var argument (the
// identity/wrapper shape), that argument IS the moved owner — name it dead. Deliberately narrow: a multi-arg
// or non-Own-returning call is left alone (honest under-reject over breaking a fn that borrows an Own and
// returns a fresh one). A fresh `send(.Give(make(a)))` (no Own arg) kills nothing — correctly still legal.
sm_own_arg_launder = (env: Env, args: [Expr]) StringView {
    (args.len == 1).match ({
        true  => args[0].match ({
            .Var(v) => (env.infer_expr(args[0].addr()).owner_base() == "Own").match ({
                true  => v.name,
                false => "",
            }),
            _       => "",
        }),
        false => "",
    })
}
send_own_var = (env: Env, e: Ptr<Expr>) StringView {
    load(e).match ({
        .Var(v)         => (env.infer_expr(e).owner_base() == "Own").then({ v.name }, { "" }),
        // an `Own<T>` sent OUT of a field (`send(h, b.o)`) moves it — whole-base kill (member_move_root).
        .Member(m)      => (env.infer_expr(e).owner_base() == "Own").match ({
            true  => e.member_move_root(),
            false => "",
        }),
        .MakeEnum(mk)   => env.send_own_var(mk.payload),
        .Call(c)        => (env.infer_expr(e).owner_base() == "Own").match ({
            true  => env.sm_own_arg_launder(c.args),
            false => "",
        }),
        .MethodCall(mc) => (env.infer_expr(e).owner_base() == "Own").match ({
            true  => env.sm_own_arg_launder(mc.args),
            false => "",
        }),
        _               => "",
    })
}
// the moved owner in an actor send — the MESSAGE (last arg) of the 2-arg inline / 3-arg parallel send
// (name-matched like the sendable + scratch passes), so the iso move-kill covers the parallel path too.
send_consume = (env: Env, c: CallData) StringView {
    (c.fn.sx_named("send", "__send") && c.args.len >= 2
        || c.fn.sx_named("pool_send", "__pool_send") && c.args.len == 3).match ({
        true  => env.send_own_var(c.args[c.args.len - 1].addr()),
        false => "",
    })
}
// ── INTERPROCEDURAL CONSUME (census #56) ──────────────────────────────────────────────────────────
// The consume machinery above is INTRA-procedural: it kills an owner only when THIS function releases/
// drops/sends it. But `o` moved into a callee whose PARAMETER is `Own<T>` and whose body CONSUMES that
// param (release/drop/send, transitively) is a real move — the caller keeps a live alias the callee
// frees → use-after-free / double-free. We close it with a BOUNDED per-function summary: "does fn's
// param `pi` get consumed by fn's body?" (depth-bounded so mutual/self recursion terminates). The
// summary is SOUND-DIRECTION (reject-more) yet zero-over-reject: it is NOT enough for a param to merely
// BE `Own<T>` — Own's own getters (`get`/`ptr`/`count`/`val`/`clone`) take `o: Own<T>` by value and
// must stay legal — the body must actually consume it. Borrowing (an `Own` passed to a `MutPtr<T>`/
// `Ptr<T>` param, or to an Own param the callee only reads) does NOT consume. Only LOCAL callees are
// analyzable; an imported/unknown callee summarizes to false (honest under-reject).
consume_depth* = () i32 { 4 }    // interprocedural hop budget; deeper transitive consumes under-reject (safe)
// does the KNOWN local fn `fn` consume its Own-typed param at index `pi`? (bounded interprocedural)
fn_consumes_param = (env: Env, fn: StringView, pi: i32, depth: i32) bool {
    (depth <= 0).match ({
        true  => false,
        false => {
            f = env.env_func(fn)
            (f.name == fn && pi >= 0 && pi < f.params.len).match ({
                true  => env.body_consumes_name(f.body, f.params[pi].name, depth),
                false => false,
            })
        },
    })
}
// does `body` consume the local named `nm` on ANY path? (branch-may rule: a conditional consume counts)
body_consumes_name = (env: Env, body: [Stmt], nm: StringView, depth: i32) bool {
    body.slice_any((st) { env.stmt_consumes_name(st, nm, depth) })
}
stmt_consumes_name = (env: Env, st: Stmt, nm: StringView, depth: i32) bool {
    st.match ({
        .Let(l)      => env.expr_consumes_name(l.value, nm, depth),
        .Assign(x)   => env.expr_consumes_name(x.value, nm, depth),
        .Return(r)   => env.expr_consumes_name(r, nm, depth),
        .ExprStmt(e) => env.expr_consumes_name(e, nm, depth),
        .If(f)       => env.expr_consumes_name(f.c, nm, depth)
            || env.body_consumes_name(f.then, nm, depth)
            || env.body_consumes_name(f.els, nm, depth),
        .While(w)    => env.expr_consumes_name(w.c, nm, depth)
            || env.body_consumes_name(w.body, nm, depth),
        .IndexSet(x) => env.expr_consumes_name(x.seq, nm, depth)
            || env.expr_consumes_name(x.idx, nm, depth)
            || env.expr_consumes_name(x.value, nm, depth),
    })
}
expr_consumes_name = (env: Env, e: Ptr<Expr>, nm: StringView, depth: i32) bool {
    (depth <= 0).match ({
        true  => false,
        false => load(e).match ({
            .Call(c)      => env.call_consumes_name(c, nm, depth),
            .Block(b)     => env.body_consumes_name(b.stmts, nm, depth),
            .Match(m)     => env.expr_consumes_name(m.subj, nm, depth)
                || env.arms_consume_name(m.arms, nm, depth),
            .Cond(d)      => env.expr_consumes_name(d.c, nm, depth)
                || env.expr_consumes_name(d.t, nm, depth)
                || env.expr_consumes_name(d.e, nm, depth),
            .Loop(l)      => env.expr_consumes_name(l.seq, nm, depth)
                || env.body_consumes_name(l.body, nm, depth),
            .MakeEnum(mk) => env.expr_consumes_name(mk.payload, nm, depth),
            // the callee-body summary descends structurally for everything else — a consume inside a
            // `.Lambda` body (or a struct/slice literal element) is still a consume by this callee.
            _             => false.expr_fold_children(e, (acc, ch) {
                acc || env.expr_consumes_name(ch, nm, depth)
            }, (acc, body) { acc || env.body_consumes_name(body, nm, depth) }),
        }),
    })
}
arms_consume_name = (env: Env, arms: [ArmData], nm: StringView, depth: i32) bool {
    arms.slice_any((ar) { env.expr_consumes_name(ar.body, nm, depth) })
}
args_consume_name = (env: Env, args: [Expr], nm: StringView, depth: i32) bool {
    found ::= false
    args.loop_at((i, ar) {
        found = env.expr_consumes_name(ar.addr(), nm, depth).then({ true }, { found })
    })
    found
}
// does call `c` consume the local `nm`? LEAF: `nm` is the receiver of a release/drop or the moved owner
// of a send. TRANSITIVE: `nm` is a bare-Var arg at an Own-typed param position of a callee that itself
// consumes that param (one interprocedural hop, depth-1). Also descends nested arg exprs.
call_consumes_name = (env: Env, c: CallData, nm: StringView, depth: i32) bool {
    consumed = env.is_consume_method(c).then({ c.recv_var_name() }, { env.send_consume(c) })
    leaf = nm == "" == false && consumed == nm
    leaf.match ({
        true  => true,
        false => env.call_arg_consumes_name(c, nm, depth)
            || env.args_consume_name(c.args, nm, depth),
    })
}
// the transitive-hop check, hoisted so the loop's inner match does not nest inside call_consumes_name.
call_arg_consumes_name = (env: Env, c: CallData, nm: StringView, depth: i32) bool {
    ps = env.env_params(c.fn)
    found ::= false
    (ps.len == c.args.len).then({
        c.args.loop_at((i, ar) {
            (c.arg_var_name(i) == nm
                && nm == "" == false
                && ps[i].ty.owner_base() == "Own"
                && env.fn_consumes_param(c.fn, i, depth - 1)).then({
                found = true
            })
        })
    })
    found
}
// ── FREE-THROUGH-OWNER-POINTER (re-census #1: release via a borrow) ────────────────────────────────
// #56 kills an owner MOVED BY VALUE into an `Own`-typed param. But an owner passed BY POINTER
// (`o.addr()` into a `MutPtr<Own<T>>`/`Ptr<Own<T>>` borrow) whose callee FREES the pointee THROUGH that
// pointer (`load(p).release_in(a)`, directly or via a local bound to the deref) is ALSO consumed: the
// pointer and the caller's `o` name the ONE allocation, so the callee's free leaves `o` dangling and a
// later `o.get()` is a use-after-free that `is_consume_method` (which only fires on a by-value `Own`
// param) misses. We summarize "does fn free the pointee of its pointer param `pi`?" — STRUCTURALLY (a
// release/release_in/drop/drop_in whose receiver is `load(pname)` or a local bound to it), bounded like
// fn_consumes_param — and, at the call site, kill the `o` in `o.addr()` when the matching param is an
// owner-pointer whose callee frees through it. Sound (reject-more) + zero over-reject: gated on the param
// being an owner-pointer AND the callee actually freeing through it; a borrow that only READS through the
// pointer (`load(p).get()`) matches no consume verb and frees nothing, so it stays legal.
is_owner_base* = (b: StringView) bool { b == "Own" || b == "Rc" || b == "Arc" }
// the pointee's owner base of a pointer type: `MutPtr<Own<T>>` / `Ptr<Own<T>>` -> "Own" (also Rc/Arc); "" otherwise.
owner_ptr_base = (t: Ty) StringView { t.pointee_of().owner_base() }
// the owner-consume verbs, matched by NAME (no receiver-type infer — the callee's params/locals are not in
// the caller env that drives the summary, so detection must be structural + the call-site param-type gate).
is_consume_fn_name = (fn: StringView) bool {
    fn.sx_named("release", "__release")
        || fn.sx_named("release_in", "__release_in")
        || fn.sx_named("drop", "__drop")
        || fn.sx_named("drop_in", "__drop_in")
}
// `<owner>.addr()` where the receiver is an Own/Rc/Arc local -> that owner's var name, else "". Inferred in
// the CALLER env (which HAS the local bound by the time own_step reaches the call), so infer resolves it.
addr_owner_var = (env: Env, e: Ptr<Expr>) StringView {
    load(e).match ({
        .Call(c) => (c.fn == "addr" && c.args.len == 1).match ({
            true  => c.args[0].match ({
                .Var(v) => is_owner_base(env.infer_expr(c.args[0].addr()).owner_base()).match ({
                    true  => v.name,
                    false => "",
                }),
                _       => "",
            }),
            false => "",
        }),
        _        => "",
    })
}
// `load(pname)` (or any deref intrinsic reading through `pname`): the borrow deref of a specific pointer.
is_deref_of_var = (e: Ptr<Expr>, pname: StringView) bool {
    load(e).match ({
        .Call(c) => (c.fn.is_deref_intrinsic() && c.args.len >= 1).match ({
            true  => c.args[0].match ({
                .Var(v) => v.name == pname,
                _       => false,
            }),
            false => false,
        }),
        _        => false,
    })
}
// locals bound to a deref of `pname` (`r = load(pname)`): consuming `r` later == consuming the pointee.
cdl_expr = (env: Env, seen: Ptr<DeadList>, e: Ptr<Expr>, pname: StringView) Ptr<DeadList> {
    load(e).match ({
        .Match(m) => env.cdl_arms(seen, m.arms, pname),
        .Block(b) => env.cdl_body(seen, b.stmts, pname),
        .Loop(l)  => env.cdl_body(seen, l.body, pname),
        .Cond(d)  => env.cdl_expr(env.cdl_expr(seen, d.t, pname), d.e, pname),
        // the deref-alias collector walks the same shapes as the two summaries above it.
        _         => seen.expr_fold_children(e, (acc, ch) { env.cdl_expr(acc, ch, pname) }, (acc, body) {
            env.cdl_body(acc, body, pname)
        }),
    })
}
cdl_arms = (env: Env, seen: Ptr<DeadList>, arms: [ArmData], pname: StringView) Ptr<DeadList> {
    out ::= seen
    arms.loop_at((i, ar) { out = env.cdl_expr(out, ar.body, pname) })
    out
}
cdl_stmt = (env: Env, seen: Ptr<DeadList>, st: Stmt, pname: StringView) Ptr<DeadList> {
    st.match ({
        .Let(l)      => is_deref_of_var(l.value, pname).match ({
            true  => env.a.dead_cons(l.name, seen),
            false => env.cdl_expr(seen, l.value, pname),
        }),
        .Assign(x)   => env.cdl_expr(seen, x.value, pname),
        .If(f)       => env.cdl_body(env.cdl_body(seen, f.then, pname), f.els, pname),
        .While(w)    => env.cdl_body(seen, w.body, pname),
        .ExprStmt(e) => env.cdl_expr(seen, e, pname),
        _            => seen,
    })
}
cdl_body = (env: Env, seen: Ptr<DeadList>, body: [Stmt], pname: StringView) Ptr<DeadList> {
    out ::= seen
    body.loop_at((i, st) { out = env.cdl_stmt(out, st, pname) })
    out
}
// does a consume verb in `c` free the pointee of `pname`? receiver is `load(pname)` directly, a local in the
// deref set `dl`, or `pname` is forwarded (by pointer) to a callee that frees through it (one bounded hop).
bft_call = (env: Env, c: CallData, pname: StringView, dl: Ptr<DeadList>, depth: i32) bool {
    leaf = (is_consume_fn_name(c.fn) && c.args.len > 0).match ({
        true  => c.args[0].match ({
            .Var(v) => dl.dead_has(v.name),
            _       => is_deref_of_var(c.args[0].addr(), pname),
        }),
        false => false,
    })
    leaf.match ({
        true  => true,
        false => env.bft_forward(c, pname, depth) || env.bft_args(c.args, pname, dl, depth),
    })
}
// the transitive hop: `pname` passed as a pointer arg to a callee that itself frees through that param.
bft_forward = (env: Env, c: CallData, pname: StringView, depth: i32) bool {
    (depth <= 1).match ({
        true  => false,
        false => {
            ps = env.env_params(c.fn)
            found ::= false
            (ps.len == c.args.len).then({
                c.args.loop_at((i, ar) {
                    (c.arg_var_name(i) == pname && env.fn_frees_through_ptr(c.fn, i, depth - 1)).then({
                        found = true
                    })
                })
            })
            found
        },
    })
}
bft_args = (env: Env, args: [Expr], pname: StringView, dl: Ptr<DeadList>, depth: i32) bool {
    args.slice_any((ar) { env.bft_expr(ar.addr(), pname, dl, depth) })
}
bft_arms = (env: Env, arms: [ArmData], pname: StringView, dl: Ptr<DeadList>, depth: i32) bool {
    arms.slice_any((ar) { env.bft_expr(ar.body, pname, dl, depth) })
}
bft_expr = (env: Env, e: Ptr<Expr>, pname: StringView, dl: Ptr<DeadList>, depth: i32) bool {
    load(e).match ({
        .Call(c)      => env.bft_call(c, pname, dl, depth),
        .Block(b)     => env.bft_body(b.stmts, pname, dl, depth),
        .Match(m)     => env.bft_expr(m.subj, pname, dl, depth)
            || env.bft_arms(m.arms, pname, dl, depth),
        .Cond(d)      => env.bft_expr(d.c, pname, dl, depth)
            || env.bft_expr(d.t, pname, dl, depth)
            || env.bft_expr(d.e, pname, dl, depth),
        .Loop(l)      => env.bft_expr(l.seq, pname, dl, depth)
            || env.bft_body(l.body, pname, dl, depth),
        .MakeEnum(mk) => env.bft_expr(mk.payload, pname, dl, depth),
        // same structural descent as the consume summary: a free through the pointer can sit in any
        // child expression or nested statement list, `.Lambda` bodies included.
        _             => false.expr_fold_children(e, (acc, ch) {
            acc || env.bft_expr(ch, pname, dl, depth)
        }, (acc, body) { acc || env.bft_body(body, pname, dl, depth) }),
    })
}
bft_stmt = (env: Env, st: Stmt, pname: StringView, dl: Ptr<DeadList>, depth: i32) bool {
    st.match ({
        .Let(l)      => env.bft_expr(l.value, pname, dl, depth),
        .Assign(x)   => env.bft_expr(x.value, pname, dl, depth),
        .Return(r)   => env.bft_expr(r, pname, dl, depth),
        .ExprStmt(e) => env.bft_expr(e, pname, dl, depth),
        .If(f)       => env.bft_expr(f.c, pname, dl, depth)
            || env.bft_body(f.then, pname, dl, depth)
            || env.bft_body(f.els, pname, dl, depth),
        .While(w)    => env.bft_expr(w.c, pname, dl, depth)
            || env.bft_body(w.body, pname, dl, depth),
        .IndexSet(x) => env.bft_expr(x.value, pname, dl, depth),
        _            => false,
    })
}
bft_body = (env: Env, body: [Stmt], pname: StringView, dl: Ptr<DeadList>, depth: i32) bool {
    body.slice_any((st) { env.bft_stmt(st, pname, dl, depth) })
}
body_frees_through_ptr = (env: Env, body: [Stmt], pname: StringView, depth: i32) bool {
    dl = env.cdl_body(env.a.dead_nil(), body, pname)
    env.bft_body(body, pname, dl, depth)
}
// does the KNOWN local fn `fn` free the pointee of its pointer param at index `pi`? (bounded interprocedural)
fn_frees_through_ptr = (env: Env, fn: StringView, pi: i32, depth: i32) bool {
    (depth <= 0).match ({
        true  => false,
        false => {
            f = env.env_func(fn)
            (f.name == fn && pi >= 0 && pi < f.params.len).match ({
                true  => env.body_frees_through_ptr(f.body, f.params[pi].name, depth),
                false => false,
            })
        },
    })
}
// the CALL-SITE kill: for each bare-Var Own arg passed to an Own-typed, consuming param of a known
// callee, mark that local dead (moved into the callee). Runs in own_step so both passes see the kill.
// Also (re-census #1): an owner passed BY POINTER (`o.addr()`) to a borrow whose callee frees through it.
own_call_kills = (
    a: MutPtr<Malloc>,
    env: Env,
    seen: Ptr<DeadList>,
    al: Ptr<AliasList>,
    c: CallData,
) Ptr<DeadList> {
    out ::= seen
    ps = env.env_params(c.fn)
    (ps.len == c.args.len).then({
        c.args.loop_at((i, ar) {
            (ps[i].ty.owner_base() == "Own"
                && env.infer_expr(ar.addr()).owner_base() == "Own"
                && env.fn_consumes_param(c.fn, i, consume_depth())).then({
                nm ::= c.arg_var_name(i)
                // a `.Member` arg (`consume(b.o)`) moves the owner OUT of the field → whole-base kill.
                nm.is_empty().then({
                    nm = ar.addr().member_move_root()
                })
                (nm.is_empty() == false).then({
                    out = a.dead_kill(out, al, nm)
                })
            })
            (is_owner_base(ps[i].ty.owner_ptr_base())
                && env.fn_frees_through_ptr(c.fn, i, consume_depth())).then({
                onm = env.addr_owner_var(ar.addr())
                (onm.is_empty() == false).then({
                    out = a.dead_kill(out, al, onm)
                })
            })
        })
    })
    out
}
// dispatch own_call_kills on the top-level call of an expr (a bare call statement / a call as a
// let/assign value). Nested-deeper calls under-reject (out of the direct-call slice's scope).
own_expr_call_kills = (
    a: MutPtr<Malloc>,
    env: Env,
    seen: Ptr<DeadList>,
    al: Ptr<AliasList>,
    e: Ptr<Expr>,
) Ptr<DeadList> {
    load(e).match ({
        .Call(c) => a.own_call_kills(env, seen, al, c),
        _        => seen,
    })
}
own_stmt_call_kills = (
    a: MutPtr<Malloc>,
    env: Env,
    seen: Ptr<DeadList>,
    al: Ptr<AliasList>,
    st: Stmt,
) Ptr<DeadList> {
    st.match ({
        .ExprStmt(e) => a.own_expr_call_kills(env, seen, al, e),
        .Let(l)      => a.own_expr_call_kills(env, seen, al, l.value),
        .Assign(x)   => a.own_expr_call_kills(env, seen, al, x.value),
        _            => seen,
    })
}
// ── MOVE-OUT OF A STRUCT FIELD (audit hole) ────────────────────────────────────────────────────────
// An `Own<T>` read OUT of a field in a MOVE position (`c = b.o`, `b.o` passed to a consuming Own
// param, `b.o` into an Own field/element, `send(h, b.o)`, `b.o.release_in(a)`) moves the owner the
// FIELD held — the struct keeps a bit-copy naming the SAME allocation, so a later free through the
// field (`b.o.release_in(a)`) double-frees. The dead-set unit is a BINDING NAME, so the move kills
// the whole ROOT local of the chain (`a.b.o` kills `a`): conservative — a later use of ANOTHER field
// of the base over-rejects — and consistent with the checker's name-keyed kill philosophy. Only a
// top-level `.Member` in a position where a bare `.Var` counts as a move today, AND whose expr the
// context has gated as owner-typed, counts; a value field read (`b.n: i32`) or a borrow through a
// call (`b.o.get()`, a Call not a Member) is NOT a move source, so plain field reads are unaffected.
member_move_root = (e: Ptr<Expr>) StringView {
    load(e).match ({
        .Member(m) => m.obj.expr_root_var(),
        _          => "",
    })
}
// the bare-Var name of an expr whose inferred type is `Own<T>` (else "") — the moved-owner shape shared
// by every consume site (mirrors own_var_move / sm_own_arg_launder). A `.Member` source moves the owner
// out of its field: the whole-base kill (member_move_root) names the root binding dead.
own_moved_var* = (env: Env, e: Ptr<Expr>) StringView {
    load(e).match ({
        .Var(v)    => (env.infer_expr(e).owner_base() == "Own").then({ v.name }, { "" }),
        .Member(m) => (env.infer_expr(e).owner_base() == "Own").match ({
            true  => e.member_move_root(),
            false => "",
        }),
        _          => "",
    })
}
// kill the source owner stored into a slice slot by `arr[i] = o` (the value is a bare `Own<T>` Var).
indexset_own_kill = (
    a: MutPtr<Malloc>,
    env: Env,
    seen: Ptr<DeadList>,
    al: Ptr<AliasList>,
    v: Ptr<Expr>,
) Ptr<DeadList> {
    out ::= seen
    nm = env.own_moved_var(v)
    (nm.is_empty() == false).then({
        out = a.dead_kill(out, al, nm)
    })
    out
}
own_expr_struct_kills = (
    a: MutPtr<Malloc>,
    env: Env,
    seen: Ptr<DeadList>,
    al: Ptr<AliasList>,
    e: Ptr<Expr>,
) Ptr<DeadList> {
    load(e).match ({
        .MakeStruct(s) => a.mkstruct_field_kills(env, seen, al, s),
        // slice element move: gated on the slice's DECLARED element type being `Own<T>`, so a non-Own
        // slice never triggers the per-item `infer_expr`. This matters because this kill runs inside
        // own_step's exponential branch re-analysis; an ungated infer there is prohibitively costly on the
        // raw (pre-resolve) tree. A void elem (not yet inferred) skips → honest under-reject.
        .SliceLit(sd)  => (sd.elem.owner_base() == "Own").match ({
            true  => a.slicelit_elem_kills(env, seen, al, sd.items),
            false => seen,
        }),
        _              => seen,
    })
}
// dispatch struct/slice move-kills on the top-level value of a let/assign/expr statement (and the value
// of `arr[i] = o`). Nested-deeper literals under-reject (same direct-value scope as own_stmt_call_kills).
own_stmt_struct_kills = (
    a: MutPtr<Malloc>,
    env: Env,
    seen: Ptr<DeadList>,
    al: Ptr<AliasList>,
    st: Stmt,
) Ptr<DeadList> {
    st.match ({
        .Let(l)      => a.own_expr_struct_kills(env, seen, al, l.value),
        .Assign(x)   => a.own_expr_struct_kills(env, seen, al, x.value),
        .ExprStmt(e) => a.own_expr_struct_kills(env, seen, al, e),
        // `arr[i] = o`: gated on the slot's DECLARED element type being `Own<T>` (same reason as SliceLit).
        .IndexSet(x) => (x.elem.owner_base() == "Own").match ({
            true  => a.indexset_own_kill(env, seen, al, x.value),
            false => seen,
        }),
        _            => seen,
    })
}
// the DOUBLE-MOVE error: the same owner moved into TWO Own fields of one struct literal (`Two(a: o, b: o)`)
// — the second move is a use-after-consume. Threads a FRESH in-literal kill-set so it counts ONLY the
// Intra-literal duplicate tracking is separate from the already-dead binding check so the positioned
// visitor reports the second move once, at the value that performs it.
// AFFINE COPY: `c = o` / `c = o` where `o` is `Own<T>` MOVES o — a bare struct copy does NOT bump the
// refcount (only `.clone()` does), so both names free the ONE allocation → double-free. c becomes the
// live owner; o's binding dies (later use of o → use-after-consume). `c = o.clone()` is a Call, not a
// bare Var, so it is NOT a move (the legitimate two-owner path). Self-copy `o = o` moves nothing.
// A `.Member` source (`c = b.o`, b.o an `Own<T>`) is the SAME affine move out of the field: the
// struct keeps a bit-copy of the owner, so the whole base binding dies (member_move_root).
own_var_move = (env: Env, e: Ptr<Expr>, tgt: StringView) StringView {
    load(e).match ({
        .Var(v)    => (env.infer_expr(e).owner_base() == "Own" && v.name == tgt == false).match ({
            true  => v.name,
            false => "",
        }),
        .Member(m) => (env.infer_expr(e).owner_base() == "Own"
            && e.member_move_root() == tgt == false).match ({
            true  => e.member_move_root(),
            false => "",
        }),
        _          => "",
    })
}
own_move_src = (env: Env, st: Stmt) StringView {
    st.match ({
        .Let(l)    => env.own_var_move(l.value, l.name),
        .Assign(x) => env.own_var_move(x.value, env.a.target_var_name(x.target)),
        _          => "",
    })
}
// DEEP `val` check: does type `t` reachably expose a `MutPtr<T>` (Pony `ref` — a mutable, aliasable
// pointer) that a receiver holding this payload could mutate through? A `val` must be DEEP: a readonly
// `Ptr<T>` (kind 1 = `box`) is only sendable when T is ITSELF deeply-immutable — a `Ptr<Outer>` whose
// Outer reachably holds a `MutPtr` field still lets the receiver reach mutable state one hop deeper
// (the same cross-actor race). So this descends, bounded by `depth`:
//   • readonly `Ptr`/`RawPtr` views (kinds 0/1) — one hop through the pointee;
//   • NAMED struct fields AND non-generic enum variant payloads (a `.Named` is one or the other);
//   • SLICE element types — `[MutPtr<X>]` reaches a mutable pointer per element;
//   • GENERIC type ARGUMENTS — `Box<MutPtr<X>>` / `Vec<MutPtr<X>>` carry the mutable pointer as their
//     element. We descend the ARGS (the semantic payload the container carries), NOT the container's
//     internal representation, so a `Vec<i32>` whose private buffer happens to be a `MutPtr<i32>` is
//     NOT wrongly rejected — only its element type `i32` is inspected.
// It TERMINATES as immutable (false) at scalars, str, function types, and the OPAQUE CAPABILITY generics
// `Own<T>` (iso, moved), `Arc<T>` (shared), `Rc<T>` (also caught by the send-rc pass), `ReplyRef`/
// `ActorRef` (deliberately RawPtr-backed): their interior aliasing is governed by their own capability,
// not by a structural alias, so we do NOT descend their args (descending `Arc<MutPtr<X>>` would wrongly
// reject a legitimately-shared value). Bounded recursion (`depth`) terminates on recursive types.
ty_reaches_mutptr = (decls: [Decl], t: Ty, depth: i32) bool {
    (depth <= 0).match ({
        true  => false,
        false => t.match ({
            .Ptr(pd)    => (pd.kind == k_mut_ptr()).match ({
                true  => true,
                false => decls.ty_reaches_mutptr(load(pd.pointee), depth - 1),
            }),
            .Named(n)   => decls.fields_reach_mutptr(decls.struct_fields(n), depth - 1)
                || decls.variants_reach_mutptr(decls.enum_variants(n), depth - 1),
            .Slice(e)   => decls.ty_reaches_mutptr(load(e.pointee), depth - 1),
            .Generic(g) => sm_is_opaque_cap(g.name).match ({
                true  => false,
                false => decls.tys_reach_mutptr(g.args, depth - 1),
            }),
            _           => false,
        }),
    })
}
// the opaque capability generics: their type args must NOT be structurally descended (they mediate their
// own interior aliasing — see the send-rc / owner-verb capability set: Own/Arc/Rc + the two actor caps).
sm_is_opaque_cap = (name: StringView) bool {
    name == "Own" || name == "Arc" || name == "Rc" || name == "ReplyRef" || name == "CellRef"
}
fields_reach_mutptr = (decls: [Decl], fields: [Field], depth: i32) bool {
    fields.slice_any((fl) { decls.ty_reaches_mutptr(fl.ty, depth) })
}
variants_reach_mutptr = (decls: [Decl], variants: [VariantDef], depth: i32) bool {
    variants.slice_any((v) { decls.ty_reaches_mutptr(v.payload, depth) })
}
tys_reach_mutptr = (decls: [Decl], tys: [Ty], depth: i32) bool {
    tys.slice_any((ty) { decls.ty_reaches_mutptr(ty, depth) })
}
// ── THE MODE (effect-family) LATTICE — the aliasing effect a type carries, DERIVED not stored ──
// (the four arms below ARE the rule; the design note that introduced them is gone). One
// `mode_of(decls, t)` fact feeds every consumer of the aliasing effect; no Env/Ty change (`decls` is
// already an Env field). Spelled as i32 consts, like
// `k_ptr()`/`k_mut_ptr()` in genc. The four Pony reference-capabilities, in Zen's spelling:
//   owned  (iso) — unique, movable, sendable         (an `Own<T>` wrapper)
//   frozen (val) — deeply immutable → sendable        (reaches no MutPtr)
//   mut    (ref) — mutable+aliasable, NOT sendable     (a top-level MutPtr<T>)
//   read   (box) — readonly alias that REACHES a MutPtr → local alias only, not sendable
md_owned = () i32 { 0 }
md_frozen = () i32 { 1 }
md_mut = () i32 { 2 }
md_read = () i32 { 3 }
// Derive the mode of a type, EXACTLY per the four-arm rule above. `Own<T>` short-circuits first
// (opaque capability, stopped in ty_reaches_mutptr at sm_is_opaque_cap); a top-level MutPtr is `mut`;
// otherwise the deep immutability walk decides frozen (reaches no MutPtr) vs read (reaches one behind a
// readonly surface). Pure function of `(decls, Ty)` — no program point, so it classifies but does NOT
// enforce use-once/escape (those stay flow-sensitive passes).
mode_of = (decls: [Decl], t: Ty) i32 {
    (t.owner_base() == "Own").match ({
        true  => md_owned(),
        false => (t.ptr_kind_of() == k_mut_ptr()).match ({
            true  => md_mut(),
            false => decls.ty_reaches_mutptr(t, 16).then({ md_read() }, { md_frozen() }),
        }),
    })
}
// SEND-payload sendability leaf, expressed through the shared mode lattice: a payload is sendable iff its
// mode is `owned` (moved uniquely) or `frozen` (deeply immutable). `mut`/`read` (a live mutable alias, or
// a readonly alias that still reaches a MutPtr) are rejected — a cross-actor data race. Behavior-identical
// to the previous `ty_reaches_mutptr(...) == false` leaf (see mode_of arms).
mode_sendable = (m: i32) bool { m == md_owned() || m == md_frozen() }
// ALLOCATOR-CENTRIC free detection. The free surface is the `Allocator` trait, generic over every
// allocator (built-in Heap/Malloc and user-defined) because conformance fixes the method names:
//   a.release(p)     — frees ptr arg `p`        (receiver `a` is a MutPtr<_>, NOT an Own/Rc/Arc)
//   a.release_slice(xs) — frees the BACKBONE of the owned slice `xs` (std.mem.alloc). Recognized on the
//                    SAME line as `release`: it is `a.release(xs.ptr)` with the local, not a member
//                    expression, in argument position — which is exactly what makes the free visible
//                    here, since the kill-set is keyed on bare locals.
//   a.resize(p, n)   — frees the OLD ptr `p`    (returns a NEW pointer; old `p` dangles)
//   free(p)          — raw FFI/bootstrap floor  (rare in user code)
// The receiver being a pointer (`.Ptr`) — not an Own/Rc/Arc generic — disambiguates the allocator
// `release` from the owner `o.release(a)` consume (handled by is_consume_method). Returns the freed
// bare-local name, or "" when nothing simple is freed.
alloc_free_call_name = (env: Env, c: CallData) StringView {
    direct ::= c.fn.sx_named("free", "__free").match ({
        true  => (c.args.len == 1).then({ c.arg_var_name(0) }, { "" }),
        false => (c.fn.sx_named("release", "__release")
            || c.fn.sx_named("release_slice", "__release_slice")).match ({
            true  => (c.args.len == 2 && env.infer_expr(c.args[0].addr()).ty_is_ptr_t()).match ({
                true  => c.arg_var_name(1),
                false => "",
            }),
            false => c.fn.sx_named("resize", "__resize").match ({
                true  => (c.args.len == 3 && env.infer_expr(c.args[0].addr()).ty_is_ptr_t()).match ({
                    true  => c.arg_var_name(1),
                    false => "",
                }),
                false => "",
            }),
        }),
    })
    direct.is_empty().then({ env.recv_free_call_name(c) }, { direct })
}
// ── RELEASE BY PROVENANCE, not by spelling ───────────────────────────────────────────────────────
// The three matchers above name a VERB at an ARITY, so `v.free(a)` — which desugars to `free(v, a)`,
// two args — walked straight past the arity-1 `free`, and no use-after-free was reported for Vec, Set,
// Map, HMap, BTreeMap, BTreeSet, ActorSystem, ActorCell or ActorHandle: every one of them spells its
// release `free(self, Allocator)`. Widening the arity would only move the hole one hop — `deinit`,
// `close`, `dispose`, `free_in` and the next container's verb are each one rename away.
// So the rule below keys on NEITHER the name NOR the arity. It resolves the call through the
// RECEIVER'S TYPE — the same dispatch the compiler itself performs — and asks the RESOLVED METHOD'S
// BODY whether it releases storage rooted at its own receiver parameter. A call consumes because of
// what the callee DOES, so a new container earns the rule the day its method frees a pointer, under
// any verb, at any arity, in either call spelling (`v.free(a)` and `free(v, a)` reach here as the
// same flat Call, so one lookup answers both).
// Two deliberate limits, both UNDER-rejects:
//   · the receiver must be a BARE LOCAL — a member receiver would kill the whole base binding, and
//     the stdlib's grow paths free a field pointer (`a.release(m.keys)`) while the base stays live;
//   · the release must be UNGUARDED (in the body's straight-line statements, or one bounded hop
//     from them). A release the callee gates on its own state is a DECLINE protocol — `Vec.drop` and
//     `String.drop` free only when `carried` — and treating a may-free as a definite consume would
//     make that documented protocol unwriteable.
recv_free_call_name = (env: Env, c: CallData) StringView {
    nm ::= c.arg_var_name(0)
    (nm.is_empty() == false && env.callee_releases_recv(c)).then({ nm }, { "" })
}
// The method `c` dispatches to through arg 0's TYPE — "" when the receiver's type provides no such
// method. Deliberately NOT falling back to the flat fn of the same name: Zen's namespace is flat, so
// `release`/`free`/`drop` name several unrelated functions, and picking one by spelling is exactly the
// mistake this rule exists to stop (it made `a.release(m.keys)` inside `Map.free` kill the ALLOCATOR).
recv_callee_name = (env: Env, c: CallData) StringView {
    tyn ::= env.infer_expr(c.args[0].addr()).dispatch_recv_name()
    cn ::= tyn.is_empty().then({ c.fn }, { env.a.dispatch_recv(env.decls, env.didx, c.fn, tyn) })
    (cn == c.fn).then({ "" }, { cn })
}
callee_releases_recv = (env: Env, c: CallData) bool {
    cn ::= env.recv_callee_name(c)
    cn.is_empty().then({ false }, { env.fn_releases_param(cn, 0, consume_depth()) })
}
// does the KNOWN fn `fn` release storage rooted at its param `pi`, on the way through? Depth-bounded,
// so mutual and self recursion terminate (exhausting it answers `false` — under-reject, never over).
fn_releases_param = (env: Env, fn: StringView, pi: i32, depth: i32) bool {
    f ::= env.env_func(fn)
    (depth > 0 && f.name == fn && pi >= 0 && pi < f.params.len).match ({
        true  => env.body_releases_param(f.body, f.params[pi].name, depth),
        false => false,
    })
}
body_releases_param = (env: Env, body: [Stmt], pname: StringView, depth: i32) bool {
    body.slice_any((st) { env.stmt_releases_param(st, pname, depth) })
}
stmt_releases_param = (env: Env, st: Stmt, pname: StringView, depth: i32) bool {
    st.match ({
        .ExprStmt(e) => env.expr_releases_param(e, pname, depth),
        .Let(l)      => env.expr_releases_param(l.value, pname, depth),
        .Assign(x)   => env.expr_releases_param(x.value, pname, depth),
        .Return(r)   => env.expr_releases_param(r, pname, depth),
        _            => false,
    })
}
expr_releases_param = (env: Env, e: Ptr<Expr>, pname: StringView, depth: i32) bool {
    load(e).match ({
        .Call(c) => c.alloc_free_root_name() == pname || env.call_forwards_release(c, pname, depth),
        _        => false,
    })
}
// `pname` handed to a known callee that releases it: `String.free_in`'s whole body is `a.free_in(s)`,
// one hop from the `a.release(s.ptr)` that does the work.
call_forwards_release = (env: Env, c: CallData, pname: StringView, depth: i32) bool {
    found ::= false
    (env.env_params(c.fn).len == c.args.len).then({
        c.args.loop_at((i, ar) {
            (ar.addr().expr_root_var() == pname && env.fn_releases_param(c.fn, i, depth - 1)).then({
                found = true
            })
        })
    })
    found
}
// The freed name of an allocator free, allowing a MEMBER root: `a.release(v.ptr)` answers "v". Used
// only inside a callee-body summary, where the question is "does this body release storage rooted at
// the parameter" — at a CALL SITE the strict bare-Var `alloc_free_call_name` above still decides
// which of the CALLER's locals died, so a field free never kills a whole base binding. Structural,
// like every other summary leaf: the callee's own locals are not bound in the Env driving the walk.
alloc_free_root_name = (c: CallData) StringView {
    (c.fn.sx_named("free", "__free") && c.args.len == 1).match ({
        true  => c.args[0].addr().expr_root_var(),
        false => ((c.fn.sx_named("release", "__release")
            || c.fn.sx_named("release_slice", "__release_slice")
            || c.fn.sx_named("resize", "__resize"))
            && c.args.len >= 2
            && c.args.len <= 3).match ({
            true  => c.args[1].addr().expr_root_var(),
            false => "",
        }),
    })
}
// the freed local for a whole statement: a bare free call, or a free that is the VALUE of a let/assign
// (e.g. `p = a.resize(p, n)` frees the old `p`; the rebind then revives it in own_step).
alloc_free_expr_name = (env: Env, e: Ptr<Expr>) StringView {
    load(e).match ({
        .Call(c) => env.alloc_free_call_name(c),
        _        => "",
    })
}
alloc_free_stmt_name = (env: Env, st: Stmt) StringView {
    st.match ({
        .ExprStmt(e) => env.alloc_free_expr_name(e),
        .Let(l)      => env.alloc_free_expr_name(l.value),
        .Assign(x)   => env.alloc_free_expr_name(x.value),
        _            => "",
    })
}
// the local (re)bound by a statement — clears its dead state (revival). A bare-Var assign target only;
// the dotted alias key `base.field` of a bare-Var-rooted field access (`h.ptr` -> "h.ptr"), else "".
// A dot is not a legal identifier byte, so this key can never collide with a bare-local name, and distinct
// (base, field) pairs map to distinct keys — letting a field pointer join the same alias machinery as a
// bare local. Deeper chains (`h.inner.ptr`) stay untracked (under-reject, never over-reject).
member_field_name = (a: MutPtr<Malloc>, e: Ptr<Expr>) StringView {
    load(e).match ({
        .Member(m) => load(m.obj).match ({
            .Var(v) => a
                .gstr_string(32)
                .gstr_append(a, v.name)
                .gstr_append(a, ".")
                .gstr_append(a, m.field)
                .gstr_finish(a),
            _       => "",
        }),
        _          => "",
    })
}
// `base.field` is dead only inside a function that has already freed something (a non-empty kill-set),
// so the key allocation is skipped on the common no-free path.
member_path_dead* = (a: MutPtr<Malloc>, seen: Ptr<DeadList>, e: Ptr<Expr>) bool {
    seen.match ({
        .DeadNil     => false,
        .DeadCons(c) => seen.dead_has(a.member_field_name(e)),
    })
}
// a compound target like `arr[i]` is a write THROUGH the base, not a rebind of a local; a bare-Var-rooted
// field (`h.ptr`) IS a rebind of that field's dotted alias key (so a later reassignment revives it).
// the (re)bound name of an assign/index target (bare local or dotted field key, else ""). Hoisted to its
// own fn: a nested match inside an outer statement-match arm miscompiles, so the load+match lives here.
target_var_name = (a: MutPtr<Malloc>, t: Ptr<Expr>) StringView {
    load(t).match ({
        .Var(v) => v.name,
        _       => a.member_field_name(t),
    })
}
rebind_stmt_name = (a: MutPtr<Malloc>, st: Stmt) StringView {
    st.match ({
        .Let(l)    => l.name,
        .Assign(x) => a.target_var_name(x.target),
        _          => "",
    })
}
// the source name of a direct pointer copy (`q = p` / `q = p`): a bare Var whose inferred type is a
// pointer (any `.Ptr` kind). Non-pointer copies (ints, structs, owners) never join an alias class.
copy_src_name = (env: Env, e: Ptr<Expr>) StringView {
    load(e).match ({
        .Var(v) => env.infer_expr(e).ty_is_ptr_t().then({ v.name }, { "" }),
        _       => "",
    })
}
alias_src_name = (env: Env, st: Stmt) StringView {
    st.match ({
        .Let(l)    => env.copy_src_name(l.value),
        .Assign(x) => env.copy_src_name(x.value),
        _          => "",
    })
}
// thread the alias-pair set across a statement: a rebind detaches the target from its old class,
// then a direct pointer copy pairs target and source. Runs alongside own_step (aliases established
// BEFORE a statement govern that statement's kills).
alias_step* = (a: MutPtr<Malloc>, env: Env, al: Ptr<AliasList>, st: Stmt) Ptr<AliasList> {
    rb = a.rebind_stmt_name(st)
    out ::= rb.is_empty().then({ al }, { a.alias_drop(al, rb) })
    src = env.alias_src_name(st)
    (rb.is_empty() == false && src.is_empty() == false && rb == src == false).then({
        out = a.alias_cons(rb, src, out)
    })
    out
}
consume_name = (env: Env, st: Stmt) StringView {
    st.match ({
        .ExprStmt(e) => load(e).match ({
            .Call(c) => env.is_consume_method(c).match ({
                true  => c.recv_move_name(),
                false => env.send_consume(c),
            }),
            _        => "",
        }),
        _            => "",
    })
}
// BRANCH-AWARE dead-set helpers. A free performed inside a branch (if/while body, match arm) makes the
// freed local CONDITIONALLY dead; the safe, simple rule is to treat it as dead AFTER the branch, so a
// later UNCONDITIONAL free/use is flagged as a double-free / use-after-free. A branch that does NOT fall
// through (its body ends in `return`) cannot reach the post-branch code, so its frees are EXCLUDED from
// the post-branch set — this is what keeps the common error-path idiom legal:
//   cond.match ({ err => { a.release(p)  return 1 }, ok => {} })   a.release(p)   // NOT a double-free
// (the freeing arm returned, so the `release(p)` after only runs on the ok path, where p is still live).
dead_union = (a: MutPtr<Malloc>, x: Ptr<DeadList>, y: Ptr<DeadList>) Ptr<DeadList> {
    x.match ({
        .DeadNil     => y,
        .DeadCons(c) => a.dead_cons(c.name, a.dead_union(c.tail, y)),
    })
}
// does control flow off the END of this body reach the next statement? false only when it ends in return.
body_falls_through = (body: [Stmt]) bool {
    (body.len == 0).match ({
        true  => true,
        false => body[body.len - 1].match ({
            .Return(r) => false,
            _          => true,
        }),
    })
}
// a match-arm / Cond body is an Expr; it diverges only when it is a Block ending in `return`.
expr_falls_through = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Block(b) => body_falls_through(b.stmts),
        _         => true,
    })
}
// net dead-set after a (possibly branching) statement body — threads own_step + alias_step + env
// Follow the same environment/alias steps as the ownership diagnostic walk, but return the final kill-set.
own_dead_body* = (
    a: MutPtr<Malloc>,
    env: Env,
    seen: Ptr<DeadList>,
    al: Ptr<AliasList>,
    body: [Stmt],
) Ptr<DeadList> {
    e ::= env
    d ::= seen
    al2 ::= al
    body.loop_at((i, st) {
        d = a.own_step(e, d, al2, st)
        al2 = a.alias_step(e, al2, st)
        e = a.extend_env(e, st)
    })
    d
}
// union of the per-arm net dead-sets, over the arms that fall through (a returning arm contributes
// nothing to the post-match set). Each arm is evaluated from the pre-match kill-set `seen`.
own_dead_arms = (
    a: MutPtr<Malloc>,
    env: Env,
    seen: Ptr<DeadList>,
    al: Ptr<AliasList>,
    subjty: Ty,
    arms: [ArmData],
) Ptr<DeadList> {
    out ::= seen
    arms.loop_at((i, ar) {
        expr_falls_through(ar.body).then({
            out = a.dead_union(a.own_dead_expr(a.arm_env(env, subjty, ar), seen, al, ar.body), out)
        })
    })
    out
}
// net dead-set after an expression in statement position (a statement-position match, a block, a ternary,
// or a bare free/consume call as a match-arm body). Mirrors own_step's free/consume detection.
own_dead_expr = (
    a: MutPtr<Malloc>,
    env: Env,
    seen: Ptr<DeadList>,
    al: Ptr<AliasList>,
    e: Ptr<Expr>,
) Ptr<DeadList> {
    load(e).match ({
        .Block(b) => a.own_dead_body(env, seen, al, b.stmts),
        .Match(m) => a.own_dead_arms(env, seen, al, env.infer_expr(m.subj), m.arms),
        // a bool `.match` lowers to a Cond (ternary); apply the same fall-through exclusion as match arms
        // so a branch that ends in `return` does not propagate its frees past the conditional.
        .Cond(d)  => a.dead_union(expr_falls_through(d.t).match ({
            true  => a.own_dead_expr(env, seen, al, d.t),
            false => seen,
        }), expr_falls_through(d.e).then({ a.own_dead_expr(env, seen, al, d.e) }, { seen })),
        // a loop body may run: its frees are conditionally dead after the loop (same may-rule as branches).
        .Loop(l)  => a.own_dead_body(env, seen, al, l.body),
        .Call(c)  => {
            out ::= seen
            fn = env.alloc_free_call_name(c)
            (fn.is_empty() == false).then({
                out = a.dead_kill(out, al, fn)
            })
            cn = env.is_consume_method(c).then({ c.recv_move_name() }, { env.send_consume(c) })
            (cn.is_empty() == false).then({
                out = a.dead_kill(out, al, cn)
            })
            c.args.loop_at((i, ar) {
                // a consume can also sit INSIDE an argument — most of all the `.Lambda` a template call
                // carries (`apply(() { o.release_in(al) })` consumes `o` at THIS statement).
                out = a.own_dead_expr(env, out, al, ar.addr())
            })
            out
        },
        // every other shape descends structurally: a consume can sit in ANY statement list an
        // expression carries, and the hand-written list reached none through a `.Lambda` — so
        // `apply(() { o.release_in(al) })` left `o` LIVE and the use after it unflagged.
        _         => seen.expr_fold_children(e, (acc, ch) { a.own_dead_expr(env, acc, al, ch) }, (acc, body) {
            a.own_dead_body(env, acc, al, body)
        }),
    })
}
own_step* = (
    a: MutPtr<Malloc>,
    env: Env,
    seen: Ptr<DeadList>,
    al: Ptr<AliasList>,
    st: Stmt,
) Ptr<DeadList> {
    out ::= seen
    // 1. owner consume (Own.release / Rc.drop / …) marks the receiver dead.
    nm = env.consume_name(st)
    (nm.is_empty() == false).then({
        out = a.dead_kill(out, al, nm)
    })
    // 2. allocator free (a.release(p) / a.resize(p,n) / free(p)) marks the freed local dead — and its
    //    whole alias class with it (every member names the SAME allocation).
    fn = env.alloc_free_stmt_name(st)
    (fn.is_empty() == false).then({
        out = a.dead_kill(out, al, fn)
    })
    // 2b. branch-aware: descend into if/while bodies and statement-position matches/blocks so a free
    //     inside a branch enters the kill-set (conditionally dead → dead after the branch). Only branches
    //     that FALL THROUGH contribute; free-then-rebind within one branch nets to ALIVE via own_step.
    out = st.match ({
        .If(f)       => a.dead_union(body_falls_through(f.then).match ({
            true  => a.own_dead_body(env, out, al, f.then),
            false => out,
        }), body_falls_through(f.els).then({ a.own_dead_body(env, out, al, f.els) }, { out })),
        .While(w)    => body_falls_through(w.body).match ({
            true  => a.own_dead_body(env, out, al, w.body),
            false => out,
        }),
        .ExprStmt(e) => a.own_dead_expr(env, out, al, e),
        _            => out,
    })
    // 2c. INTERPROCEDURAL consume (census #56): an `Own<T>` local moved into an owner-typed param whose
    //     callee CONSUMES it (release/drop/send, transitively) is dead after the call — later use → UAF.
    out = a.own_stmt_call_kills(env, out, al, st)
    // 2c'. STRUCT-FIELD / SLICE-ELEMENT move (re-census #63): an `Own<T>` moved into an Own struct-literal
    //      field / slice element is consumed here — later use of the source binding → UAF / double-free.
    out = a.own_stmt_struct_kills(env, out, al, st)
    // 2d. AFFINE COPY: `c = o` / `c = o` (o an `Own<T>`) MOVES o — c is the live owner, o's binding dies.
    mv = env.own_move_src(st)
    (mv.is_empty() == false).then({
        out = a.dead_kill(out, al, mv)
    })
    // 3. revival — a (re)bind of a local clears its dead state (ONLY that name: an alias of it stays
    //    dead). Runs LAST so `p = a.resize(p, n)` (free old p in step 2, then rebind p here) nets to
    //    ALIVE, while `q = a.resize(p, n)` leaves p dead (q != p).
    rb = a.rebind_stmt_name(st)
    (rb.is_empty() == false).then({
        out = a.dead_remove(out, rb)
    })
    out
}
// count each net-new dead name declared OUTSIDE the body, once (`done` dedupes the cons-list walk).
count_loop_freed* = (
    a: MutPtr<Malloc>,
    net: Ptr<DeadList>,
    base: Ptr<DeadList>,
    locals: Ptr<DeadList>,
    done: Ptr<DeadList>,
) i32 {
    net.match ({
        .DeadNil     => 0,
        .DeadCons(c) => (base.dead_has(c.name) || locals.dead_has(c.name) || done.dead_has(c.name)).match ({
            true  => a.count_loop_freed(c.tail, base, locals, done),
            false => 1 + a.count_loop_freed(c.tail, base, locals, a.dead_cons(c.name, done)),
        }),
    })
}
// RECEIVER-TYPED UFCS DISPATCH (#68 slice 4). A method name like `find` is a flat free fn (`str.find`)
// AND an impl method (`Vec.find`, `Set.find`, …) — one entry in the flat namespace. `xs.find(2)` on a
// `[i32]` desugars to `find(xs, 2)`; dispatch found NO impl/alias whose FIRST parameter fits `[i32]`, so
// c.fn stayed the flat `find`. The batch then judges the args against `str.find`'s `(str, str)` and yields
// a misleading `expected str, got [i32]` — binding to the wrong receiver type by NAME ALONE. When the
// called name is ALSO an impl/trait method (so UFCS legitimately dispatches by receiver) and the receiver
// (arg 0) does NOT fit the flat fn's concrete first parameter, the flat signature is not the authoritative
// yardstick (mirrors ka_call_core's `authoritative` gate): this is method-not-found for THIS receiver, not
// an arg mismatch. Report the clean method-not-found. Fires ONLY on already-erroring calls — a receiver
// that fits param0, an unknown/void receiver, a zero-arg call, or a tparam-typed param0 all short-circuit
// — so no program that checks today changes meaning; a wrong-signature arg error only becomes an accurate
// one. When a receiver-typed impl/alias DOES fit, resolve_call already rewrote c.fn to it and we never get
// here (is_trait_method on the mangled impl name is false), so real dispatch is untouched.
recv_typed_miss* = (env: Env, c: CallData) bool {
    (c.args.len > 0 && env.env_trait_method(c.fn)).match ({
        true  => {
            f = env.env_func(c.fn)
            (f.params.len > 0 && f.tparams.ty_mentions_tparam(f.params[0].ty) == false).match ({
                true  => {
                    rty = env.infer_expr(c.args[0].addr())
                    (env.unknown_ty(rty) || rty.is_void_ty()).match ({
                        true  => false,
                        false => rty.fits(f.params[0].ty) == false,
                    })
                },
                false => false,
            })
        },
        false => false,
    })
}
// ── #574: a method-shaped call bound ONLY by flat-namespace luck ─────────────────────────────────
// `yn.len()` in a module that neither defines nor imports `len` still checked (and emitted a bare C
// `len(...)` call) whenever ANY closure module dragged a flat `len` into the program — binding by
// NAME ALONE to whichever definition survived first-occurrence-wins dedup. In one closure that
// linked against an unrelated `len` and computed garbage; in another it died at the C linker. This
// predicate fires exactly on that hole: a method-shaped call (callee preceded by `.` in the flat
// source), receiver type KNOWN, whose name the OWNING MODULE cannot see (didx.vis — per-module
// define-or-import, driver-supplied). Everything with a legitimate resolution path is exempt first:
// trait/impl methods (global dispatch index — no import needed), intrinsics, imported names
// (unflattened harness path), raw `@fn` calls, synthesized nodes (pos 0), and unknown/void
// receivers (pre-inline tparam contexts). Dispatch that DID resolve (impl/alias rewrites, inlined
// generics) never reaches here with the flat name at all.
ufcs_vis_miss* = (env: Env, c: CallData) bool {
    vis = env.didx.vis
    (vis.on
        && c.pos > 0
        && c.args.len > 0
        && c.raw == false
        && c.fn.is_intrinsic() == false
        && env.env_imported(c.fn) == false
        && vis.vis_method_shaped(c.pos)
        && vis.vis_name_at(c.pos, c.fn)).match ({
        true  => {
            rty = env.infer_expr(c.args[0].addr())
            (env.unknown_ty(rty) || rty.is_void_ty()).match ({
                true  => false,
                false => env.dispatch_name(c) == c.fn
                    && vis.vis_name_visible(env.a, c.pos, c.fn) == false,
            })
        },
        false => false,
    })
}
// dispatch_name != c.fn: THIS receiver has an impl/trait target — genc's dispatch
// index resolves the call without any import, so it is not a flat-namespace bind.
// (A blanket trait-method-NAME exemption would be too broad: once Vec/HMap
// instantiate, `len` is an impl-method name in every big closure, and the original
// #574 `StringView.len()` would sail through on the name alone.)
// ── enriched diagnostic text: name the offending field / operator + the operand types ────────────
// Built lazily by the driver only AFTER a check error is located, so this never affects the compile of
// an accepted program. `denrich_module` walks the resolved decls to the node at the error's byte offset
// (the SAME offset the kind pass reported) and returns a precise message; "" means the offset names no
// enrichable node, so the driver keeps the generic message. The env is threaded exactly as the validator
// threads it (params + lets + arms), so receiver and operand types infer the same way.
zty_generic = (a: MutPtr<Malloc>, g: GenericData) StringView {
    out ::= a.gstr_string(48).gstr_append(a, g.name).gstr_append(a, "<")
    g.args.loop_at((i, t) {
        (i > 0).then({
            out = out.gstr_append(a, ", ")
        })
        out = out.gstr_append(a, a.zty(t))
    })
    out.gstr_append(a, ">").gstr_finish(a)
}
zty* = (a: MutPtr<Malloc>, t: Ty) StringView {
    t.match ({
        .I32           => "i32",
        .I64           => "i64",
        .U8            => "u8",
        .F64           => "f64",
        .Bool          => "bool",
        .StringView    => "StringView",
        .StringCstr    => "StringCstr",
        .StringLiteral => "StringLiteral",
        .Void          => "(unknown)",
        .Named(n)      => n,
        .Generic(g)    => a.zty_generic(g),
        .FnT(ft)       => "fn",
        .Slice(e)      => (e.kind == k_slice_dflt()).match ({
            true  => a
                .gstr_string(24)
                .gstr_append(a, "[")
                .gstr_append(a, a.zty(load(e.pointee)))
                .gstr_append(a, "]")
                .gstr_finish(a),
            false => a
                .gstr_string(24)
                .gstr_append(a, slice_kw(e.kind))
                .gstr_append(a, "<")
                .gstr_append(a, a.zty(load(e.pointee)))
                .gstr_append(a, ">")
                .gstr_finish(a),
        }),
        .Ptr(pd)       => a
            .gstr_string(24)
            .gstr_append(a, ptr_kw(pd.kind))
            .gstr_append(a, "<")
            .gstr_append(a, a.zty(load(pd.pointee)))
            .gstr_append(a, ">")
            .gstr_finish(a),
    })
}
// ── must-use: a DISCARDED value-mold ((Self,…) Self) self-mutation (Stage-2 A.1) ───────────────────────
// A value-mold CONTAINER method (`Map.put`, `Set.add`, … — shape `(Self, …) Self`) RETURNS the updated
// container and INVALIDATES the receiver: a grow reallocs the backing buffer, so the input header is left
// dangling. Discarding the result in statement position — `m.put(a, k, v)` as a bare statement, then
// `m.get(...)` — segfaults while `check` says ok (the #1 trust-killer for a newcomer). This driver-only
// pass runs on the RAW pre-inline decls (where the call is still a MethodCall; by check_module time the
// generic method is INLINED away) and rejects such a discard with KMUSTUSE.
//
// Scope chosen to be SAFE against the pervasive free-function builder pattern (`s = s.gen_x(…)` threads a
// `String` accumulator — those are FREE functions, never inherent methods, so they are untouched):
//   • only INHERENT struct methods (declared inside a struct body) count, and only when EVERY inherent
//     method of that name is value-mold (an ambiguous name shared with a non-value-mold method is skipped);
//   • only NON-TAIL statements are flagged — a body's last expression is its produced VALUE, not a discard,
//     so a value-mold method used as a return value / match-arm value / fluent-chain tail is never flagged.
mu_ty_is_container = (t: Ty) bool {
    t.match ({
        .Named(n)   => true,
        .Generic(g) => true,
        _           => false,
    })
}
// does `ret` hand back the (possibly realloc'd) container `p0`? Two spellings: plain `(Self, …) Self`,
// and the Result-always mold `(Self, …) Result<Self, E>` (Map.put/append/grow return the updated
// container in the Ok payload — the receiver header is invalidated all the same, so a discard is
// exactly as dangerous).
mu_ret_is_self = (ret: Ty, p0: Ty) bool {
    ret.match ({
        .Generic(g) => (g.name == "Result").match ({
            true  => g.args.len >= 1
                && g.args[0].mu_ty_is_container()
                && g.args[0].recv_name() == p0.recv_name(),
            false => ret.recv_name() == p0.recv_name(),
        }),
        _           => ret.recv_name() == p0.recv_name(),
    })
}
// the `(Self, …) Self` / `(Self, …) Result<Self, E>` shape: first param and (Ok-unwrapped) return are
// the SAME non-pointer, non-primitive type.
mu_is_value_mold = (f: Func) bool {
    (f.params.len == 0).match ({
        true  => false,
        false => {
            p0 = f.params[0].ty
            (p0.mu_ty_is_container() && f.ret.mu_ty_is_container()).match ({
                true  => f.ret.mu_ret_is_self(p0),
                false => false,
            })
        },
    })
}
// the hoisted inherent func `impl_<Ty>_<Ty>_<m>` (fill_inherent_methods), looked up O(1) via the index.
mu_func_value_mold = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    ty: StringView,
    m: StringView,
) bool {
    cname = a.impl_cname_in(ty, ty, m)
    i = idx.func_idx.get(cname, 0 - 1)
    (i >= 0 && i < decls.len).match ({
        true  => decls[i].match ({
            .DFunc(f) => f.mu_is_value_mold(),
            _         => false,
        }),
        false => false,
    })
}
// fold one inherent-struct impl's methods into the name→state map (0 unseen, 1 value-mold-only, 2 tainted).
mu_index_methods = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    m: Map<i64>,
    ty: StringView,
    methods: [Param],
    j: i32,
) Map<i64> {
    (j >= methods.len).match ({
        true  => m,
        false => {
            p = methods[j]
            vm = a.mu_func_value_mold(decls, idx, ty, p.name)
            prev = m.get(p.name, 0)
            next: i64 = vm.match ({
                true  => (prev == 0).match ({
                    true  => 1,
                    false => (prev == 1).then({ 1 }, { 2 }),
                }),
                false => 2,
            })
            a.mu_index_methods(decls, idx, m
                .put(a, p.name, next)
                .expect("check: method-mold index alloc"), ty, methods, j + 1)
        },
    })
}
mu_index_impl = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    m: Map<i64>,
    im: ImplData,
) Map<i64> {
    (im.ty == im.trname).then({ a.mu_index_methods(decls, idx, m, im.ty, im.methods, 0) }, { m })
}
// method name → 1 iff it is an inherent method AND value-mold on EVERY struct that declares it.
mu_build_index* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex) Map<i64> {
    seed: i64 = 0 - 1
    m ::= of(a, "", seed).expect("check: method-mold index alloc")
    decls.loop_at((i, d) {
        m = d.match ({
            .DImpl(im) => a.mu_index_impl(decls, idx, m, im),
            _          => m,
        })
    })
    m
}
// flag a discarded MethodCall to a safe-to-flag value-mold inherent method.
// In the normal parse, UFCS `recv.m(args)` lowers to a flat `Call(fn: m, args: [recv] ++ args)` whose
// `fn` is the SIMPLE method name — exactly the index key. (The faithful MethodCall form is fmt-only, but
// match it too for safety.) Flag a discarded call whose callee is a safe-to-flag value-mold method.
// the value-mold DANGER is reusing a STALE NAMED LOCAL after a discarded self-mutation (`m.put(...)`
// then `m.get(...)`). A fresh FLUENT CHAIN (`put("x=").i(3).nl()` — receiver is itself a call, not a
// reused binding) carries no stale-local risk, so it must NOT be flagged (else builder APIs break).
// Gate: only flag when the receiver (first arg / recv) is a bare Var.
mu_is_var = (e: Expr) bool {
    e.match ({
        .Var(v) => true,
        _       => false,
    })
}
// SHADOWING GATE: UFCS only ever desugars to a TOP-LEVEL name, so a call through a name bound
// LOCALLY — a param, or a `f = (x: i64) void {…}` local — is never a method call and has no
// receiver. Without this, an unrelated `f(i)` was flagged in any module whose closure declares a
// value-mold `f` (std.text.fmt's `Printer.f`). This pass runs BEFORE resolve, so shadowing is
// decided by NAME alone: `bound` is the set of names bound in the enclosing function, carried down
// the walk (params up front, each `=` as the walk passes it, lambda/loop bindings at their arm).
// A `.MethodCall` names its receiver explicitly, so a like-named local does not shadow it.
mu_bound_names = (a: MutPtr<Malloc>, bound: Ptr<DeadList>, params: [Param]) Ptr<DeadList> {
    out ::= bound
    params.loop_at((i, p) { out = a.dead_cons(p.name, out) })
    out
}
mu_call_kind = (mvm: Map<i64>, bound: Ptr<DeadList>, e: Ptr<Expr>) i32 {
    load(e).match ({
        .Call(c)        => (mvm.get(c.fn, 0) == 1
            && bound.dead_has(c.fn) == false
            && c.args.len > 0
            && mu_is_var(c.args[0])).match ({
            true  => KMUSTUSE().kv_at(c.pos),
            false => 0,
        }),
        .MethodCall(mc) => (mvm.get(mc.method, 0) == 1 && mu_is_var(load(mc.recv))).match ({
            true  => KMUSTUSE().kv_at(mc.pos),
            false => 0,
        }),
        _               => 0,
    })
}
mu_arms_kind = (a: MutPtr<Malloc>, mvm: Map<i64>, bound: Ptr<DeadList>, arms: [ArmData]) i32 {
    acc ::= 0
    arms.loop_at((i, ar) { acc = acc.or(a.mu_expr_kind(mvm, bound, ar.body)) })    // arm body = the arm's VALUE (tail)
    acc
}
// recurse into nested control-flow whose bodies can hold discarded statements.
mu_expr_kind = (a: MutPtr<Malloc>, mvm: Map<i64>, bound: Ptr<DeadList>, e: Ptr<Expr>) i32 {
    load(e).match ({
        .Block(b)  => a.mu_body_kind(mvm, bound, b.stmts),
        // a `xs.loop(…)` body runs for EFFECT — it yields no value, so it has no tail. Its handler,
        // index and element are fresh bindings.
        .Loop(l)   => a
            .mu_expr_kind(mvm, bound, l.seq)
            .or(a.mu_effect_body_kind(mvm, a.dead_cons(l.h, a.dead_cons(l.idx, a.dead_cons(l.elem, bound))), l.body)),
        .Lambda(m) => a.mu_body_kind(mvm, a.mu_bound_names(bound, m.params), m.body),
        .Match(m)  => a.mu_arms_kind(mvm, bound, m.arms),
        .Cond(d)   => a.mu_expr_kind(mvm, bound, d.t).or(a.mu_expr_kind(mvm, bound, d.e)),
        // the rest descends structurally: a discarded self-mutation can sit in ANY statement list, and
        // the hand-written list reached none through a call argument — including the `.Lambda` a
        // template call carries (`apply(() { b.bump(5) … })`).
        _          => 0.expr_fold_children(e, (acc, ch) { acc.or(a.mu_expr_kind(mvm, bound, ch)) }, (acc, body) {
            acc.or(a.mu_body_kind(mvm, bound, body))
        }),
    })
}
// an ExprStmt: flag a discarded value-mold call when NOT in tail position, and always recurse for nested
// discards. (Extracted so the nested `is_tail.match(...)` is a plain statement, not a chained arm body.)
mu_exprstmt_kind = (
    a: MutPtr<Malloc>,
    mvm: Map<i64>,
    bound: Ptr<DeadList>,
    e: Ptr<Expr>,
    is_tail: bool,
) i32 {
    head = is_tail.then({ 0 }, { mvm.mu_call_kind(bound, e) })
    head.or(a.mu_expr_kind(mvm, bound, e))
}
mu_stmt_kind = (
    a: MutPtr<Malloc>,
    mvm: Map<i64>,
    bound: Ptr<DeadList>,
    st: Stmt,
    is_tail: bool,
) i32 {
    st.match ({
        .ExprStmt(e) => a.mu_exprstmt_kind(mvm, bound, e, is_tail),
        .Let(l)      => a.mu_expr_kind(mvm, bound, l.value),
        .Assign(x)   => a.mu_expr_kind(mvm, bound, x.value),
        .Return(r)   => a.mu_expr_kind(mvm, bound, r),
        .If(f)       => a.mu_body_kind(mvm, bound, f.then).or(a.mu_body_kind(mvm, bound, f.els)),
        // a `@while` body runs for EFFECT — its last statement is a discard like any other.
        .While(w)    => a
            .mu_expr_kind(mvm, bound, w.c)
            .or(a.mu_effect_body_kind(mvm, bound, w.body)),
        .IndexSet(x) => a.mu_expr_kind(mvm, bound, x.value),
    })
}
mu_stmts_kind = (
    a: MutPtr<Malloc>,
    mvm: Map<i64>,
    bound: Ptr<DeadList>,
    body: [Stmt],
    has_tail: bool,
) i32 {
    acc ::= 0
    n = body.len
    scope ::= bound
    body.loop_at((i, st) {
        acc = acc.or(a.mu_stmt_kind(mvm, scope, st, has_tail && i == n - 1))
        scope = st.match ({
            .Let(l) => a.dead_cons(l.name, scope),
            _       => scope,
        })
    })
    acc
}
// the body's LAST statement is its produced value (tail) — never a discard; every earlier ExprStmt is.
mu_body_kind = (a: MutPtr<Malloc>, mvm: Map<i64>, bound: Ptr<DeadList>, body: [Stmt]) i32 {
    a.mu_stmts_kind(mvm, bound, body, true)
}
// a body run purely for effect (`@while` / `xs.loop`) yields nothing, so no statement in it is a tail.
mu_effect_body_kind = (a: MutPtr<Malloc>, mvm: Map<i64>, bound: Ptr<DeadList>, body: [Stmt]) i32 {
    a.mu_stmts_kind(mvm, bound, body, false)
}
mu_func_kind* = (a: MutPtr<Malloc>, mvm: Map<i64>, f: Func) i32 {
    a.mu_body_kind(mvm, a.mu_bound_names(a.dead_nil(), f.params), f.body)
}
scope_params* = (a: MutPtr<Malloc>, params: [Param]) Ptr<DeadList> {
    out ::= a.dead_nil()
    params.loop_at((i, p) {
        p.ty.is_scope_param_ty().then({
            out = a.dead_cons(p.name, out)
        })
    })
    out
}
// the root Var name of a member/arrow chain (`s.alloc` -> "s"); "" if not rooted at a plain Var.
expr_root_var* = (e: Ptr<Expr>) StringView {
    load(e).match ({
        .Var(v)    => v.name,
        .Member(m) => m.obj.expr_root_var(),
        _          => "",
    })
}
let_is_scope_derived = (svars: Ptr<DeadList>, e: Ptr<Expr>) bool {
    svars.is_scope_acquire(e) || svars.is_scope_alloc_member(e)
}
// aliasing laundering: a value that IS an already-derived local — a bare Var, or a member/arrow chain
// rooted at one — so `q = p` / `q = p.f` taints `q` once `p` is derived.
expr_is_derived = (derived: Ptr<DeadList>, e: Ptr<Expr>) bool {
    load(e).match ({
        .Var(v)    => derived.dead_has(v.name),
        .Member(m) => derived.dead_has(m.obj.expr_root_var()),
        _          => false,
    })
}
// a `let` value that becomes a derived local: a scope acquire / `s.alloc` field, an alias of one, OR any
// value the escape walk itself says carries a scope value out (`q = [p]`, `q = Box(p: s.acquire(n))`) —
// so a binding cannot launder through a shape the two narrower tests do not name.
let_taints = (a: MutPtr<Malloc>, svars: Ptr<DeadList>, derived: Ptr<DeadList>, e: Ptr<Expr>) bool {
    svars.let_is_scope_derived(e) || derived.expr_is_derived(e) || a.expr_escapes(svars, derived, e)
}
// VALUE-position escape: a returned/trailing expr lets a scope value out when it IS a direct
// `s.acquire(…)`, the raw `s.alloc` field, a derived local, a place rooted at one (`d.f`, `ds[0]`), OR
// forwards one through an enum payload, a struct literal, a slice literal, a match arm value, a cond
// branch, or a block's value. Call ARGS are deliberately NOT walked — passing a scope pointer into a
// callee that returns a COPY (`to_i32(load_i64(p))`) does not escape.
// EXHAUSTIVE over `Expr` BY DESIGN — there is no `_` arm. A default of `false` here reads "a shape I have
// not thought about does not escape", which is how enum-payload, slice-literal and index laundering
// shipped as accepted code; with every variant spelled out a new `Expr` variant is an exhaustiveness
// ERROR, not a silent hole, and each `false` below is a claim about that shape rather than a fallthrough.
expr_escapes* = (
    a: MutPtr<Malloc>,
    svars: Ptr<DeadList>,
    derived: Ptr<DeadList>,
    e: Ptr<Expr>,
) bool {
    (svars.is_direct_scope_acquire(e) || svars.is_scope_alloc_member(e)).match ({
        true  => true,
        false => load(e).match ({
            .Int(n)         => false,
            .Byte(b)        => false,
            .FloatLit(t)    => false,
            .StrLit(s)      => false,    // static storage — outlives every scope
            .Tag(t)         => false,    // a payload-less enum tag carries nothing
            .Bin(b)         => false,    // Zen has no pointer arithmetic, so a `Bin` is a number or bool
            .Lambda(lm)     => false,    // a lambda VALUE is only ever an argument to an FnT param and is
            // inlined at the call site — it never stands in a scope fn's return position
            .Call(c)        => false,    // args deliberately NOT walked (see above); the direct
            // `s.acquire(…)` shape is already handled by the guard
            .MethodCall(mc) => false,    // desugar_method_calls lowers every MethodCall to a flat Call
            // before validation reads a body — unreachable, listed to keep the match total
            .Var(v)         => derived.dead_has(v.name),
            .Member(m)      => a.expr_escapes(svars, derived, m.obj),
            .Index(ix)      => a.expr_escapes(svars, derived, ix.seq),
            .MakeEnum(mk)   => a.expr_escapes(svars, derived, mk.payload),
            .MakeStruct(s)  => a.inits_escape(svars, derived, s.inits),
            .SliceLit(sd)   => a.items_escape(svars, derived, sd.items),
            .Match(m)       => a.arms_escape(svars, derived, m.arms),
            .Cond(d)        => a.expr_escapes(svars, derived, d.t)
                || a.expr_escapes(svars, derived, d.e),
            .Block(b)       => a.block_val_escapes(svars, derived, b.stmts),
            .Loop(l)        => a.loop_val_escapes(svars, derived, l.body),
        }),
    })
}
// a loop in VALUE position: it never yields its trailing value, but a `return` inside its body
// still escapes to the caller, so walk returns only (mirrors the statement-side .Loop handling).
loop_val_escapes = (
    a: MutPtr<Malloc>,
    svars: Ptr<DeadList>,
    derived: Ptr<DeadList>,
    stmts: [Stmt],
) bool {
    f ::= false
    d ::= derived
    stmts.loop_at((i, st) {
        st.match ({
            .Return(r) => {
                f = a.expr_escapes(svars, d, r).then({ true }, { f })
            },
            _          => { },
        })
        d = a.escape_step(svars, d, st)
    })
    f
}
inits_escape = (
    a: MutPtr<Malloc>,
    svars: Ptr<DeadList>,
    derived: Ptr<DeadList>,
    inits: [FieldInit],
) bool { inits.slice_any((fi) { a.expr_escapes(svars, derived, fi.value) }) }
items_escape = (
    a: MutPtr<Malloc>,
    svars: Ptr<DeadList>,
    derived: Ptr<DeadList>,
    items: [Expr],
) bool { items.slice_any((it) { a.expr_escapes(svars, derived, it.addr()) }) }
arms_escape = (
    a: MutPtr<Malloc>,
    svars: Ptr<DeadList>,
    derived: Ptr<DeadList>,
    arms: [ArmData],
) bool { arms.slice_any((ar) { a.expr_escapes(svars, derived, ar.body) }) }
// a block in VALUE position: its trailing value, or any `return` inside it, may escape (lets thread).
block_val_escapes = (
    a: MutPtr<Malloc>,
    svars: Ptr<DeadList>,
    derived: Ptr<DeadList>,
    stmts: [Stmt],
) bool {
    f ::= false
    d ::= derived
    stmts.loop_at((i, st) {
        st.match ({
            .Return(r)   => {
                f = a.expr_escapes(svars, d, r).then({ true }, { f })
            },
            .ExprStmt(e) => (i == stmts.len - 1).then({
                f = a.expr_escapes(svars, d, e).then({ true }, { f })
            }),
            _            => { },
        })
        d = a.escape_step(svars, d, st)
    })
    f
}
// thread the derived-local set across a `let` (now including aliases of derived locals).
escape_step* = (
    a: MutPtr<Malloc>,
    svars: Ptr<DeadList>,
    derived: Ptr<DeadList>,
    st: Stmt,
) Ptr<DeadList> {
    out ::= derived
    st.match ({
        .Let(l) => a.let_taints(svars, derived, l.value).then({
            out = a.dead_cons(l.name, derived)
        }),
        _       => { },
    })
    out
}
expr_is_var_named = (e: Ptr<Expr>, nm: StringView) bool {
    load(e).match ({
        .Var(v) => v.name == nm,
        _       => false,
    })
}
// true iff `nm` appears in `e` in ANY position that is NOT the arg-0 receiver of a whitelisted getter.
// A getter call with `nm` as its receiver contributes NOTHING (a pure read); every other occurrence —
// including a getter's NON-receiver args — is impure. Total over var-bearing shapes; leaves → false.
impure_use_in_expr = (nm: StringView, e: Ptr<Expr>) bool {
    load(e).match ({
        .Var(v)         => v.name == nm,
        .Bin(b)         => nm.impure_use_in_expr(b.lhs) || nm.impure_use_in_expr(b.rhs),
        .Call(c)        => (is_pure_owner_getter(c.fn)
            && c.args.len >= 1
            && c.args[0].addr().expr_is_var_named(nm)).match ({
            true  => nm.impure_use_in_args_from1(c.args),
            false => nm.name_read_in_args(c.args),
        }),
        .MethodCall(mc) => (is_pure_owner_getter(mc.method) && mc.recv.expr_is_var_named(nm)).match ({
            true  => nm.impure_use_in_args(mc.args),
            false => nm.name_read_in_expr(mc.recv) || nm.name_read_in_args(mc.args),
        }),
        .Cond(d)        => nm.impure_use_in_expr(d.c)
            || nm.impure_use_in_expr(d.t)
            || nm.impure_use_in_expr(d.e),
        .Member(m)      => nm.impure_use_in_expr(m.obj),
        .MakeEnum(mk)   => nm.impure_use_in_expr(mk.payload),
        .MakeStruct(s)  => nm.impure_use_in_inits(s.inits),
        .Match(m)       => nm.impure_use_in_expr(m.subj) || nm.impure_use_in_arms(m.arms),
        .SliceLit(sd)   => nm.impure_use_in_args(sd.items),
        .Index(ix)      => nm.impure_use_in_expr(ix.seq) || nm.impure_use_in_expr(ix.idx),
        .Loop(l)        => nm.impure_use_in_expr(l.seq) || nm.impure_use_in_body(l.body),
        .Lambda(lm)     => nm.name_read_in_body(lm.body),
        .Block(b)       => nm.impure_use_in_body(b.stmts),
        _               => false,
    })
}
impure_use_in_args = (nm: StringView, args: [Expr]) bool {
    args.slice_any((ar) { nm.impure_use_in_expr(ar.addr()) })
}
// args EXCEPT index 0 (the getter receiver already accounted for as a pure read).
impure_use_in_args_from1 = (nm: StringView, args: [Expr]) bool {
    f ::= false
    args.loop_at((i, ar) {
        (i > 0).then({
            f = nm.impure_use_in_expr(ar.addr()).then({ true }, { f })
        })
    })
    f
}
impure_use_in_inits = (nm: StringView, inits: [FieldInit]) bool {
    inits.slice_any((fi) { nm.impure_use_in_expr(fi.value) })
}
impure_use_in_arms = (nm: StringView, arms: [ArmData]) bool {
    arms.slice_any((ar) { nm.impure_use_in_expr(ar.body) })
}
impure_use_in_stmt = (nm: StringView, st: Stmt) bool {
    st.match ({
        .Let(l)      => nm.impure_use_in_expr(l.value),
        .Assign(x)   => nm.impure_use_in_expr(x.target) || nm.impure_use_in_expr(x.value),
        .Return(r)   => nm.impure_use_in_expr(r),
        .If(f)       => nm.impure_use_in_expr(f.c)
            || nm.impure_use_in_body(f.then)
            || nm.impure_use_in_body(f.els),
        .While(w)    => nm.impure_use_in_expr(w.c) || nm.impure_use_in_body(w.body),
        .IndexSet(x) => nm.impure_use_in_expr(x.seq)
            || nm.impure_use_in_expr(x.idx)
            || nm.impure_use_in_expr(x.value),
        .ExprStmt(e) => nm.impure_use_in_expr(e),
    })
}
impure_use_in_body = (nm: StringView, body: [Stmt]) bool {
    body.slice_any((st) { nm.impure_use_in_stmt(st) })
}
// is `nm` used IMPURELY (discharged/escaped, not a pure getter read) in any statement strictly AFTER k?
impure_use_after = (nm: StringView, body: [Stmt], k: i32) bool {
    f ::= false
    body.loop_at((i, st) {
        (i > k).then({
            f = nm.impure_use_in_stmt(st).then({ true }, { f })
        })
    })
    f
}
// a value that merely ALIASES an existing owner (a bare local, or a field/element read) — NOT a fresh
// creation. Excluded from candidacy: the aliased source still owns the allocation, so a "leak" here
// would be a false positive (and freeing through the alias would double-free).
leak_alias_value* = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Var(v)    => true,
        .Member(m) => true,
        .Index(ix) => true,
        _          => false,
    })
}
// split out so the owner-typed arm's inner match does not nest inside kv_leak_let's outer match.
// v2: an owner leaks unless it is DISCHARGED (impurely used) on some path — a pure getter-only read
// (or no mention at all, the v1 never-named case) is a leak. impure_use_after == false ⇒ leak.
nm_read_or_leak* = (env: Env, body: [Stmt], k: i32, l: LetData) i32 {
    l.name.impure_use_after(body, k).then({ 0 }, { l.pos.pos_or(load(l.value).expr_pos()) })
}
// ── SENDABILITY rule 2: an Rc<T> may not be sent across actors. ───────────────────────────────────
// Rc's refcount is a plain (non-atomic) i64, so sharing one between actors on different threads races.
// Flag `send(handle, msg)` whose message carries an Rc (sent directly, wrapped in an enum, or in a
// struct field). Arc<T> (atomic) and value/Own messages are fine — only Rc is rejected, so ordinary
// message sends keep zero friction.
sd_inits_rc = (env: Env, inits: [FieldInit]) bool {
    inits.slice_any((fi) { env.sd_msg_rc(fi.value) })
}
sd_msg_rc = (env: Env, e: Ptr<Expr>) bool {
    load(e).match ({
        .Var(v)        => env.infer_expr(e).owner_base() == "Rc",
        .MakeEnum(mk)  => env.sd_msg_rc(mk.payload),
        .MakeStruct(s) => env.sd_inits_rc(s.inits),
        _              => false,
    })
}
// a `send(_, msg)` whose message carries an Rc → the source offset of the call, else 0. `&&` short-
// circuits, so `c.args[1]` is only touched when the arity check passed.
sd_call_pos* = (env: Env, c: CallData) i32 {
    (c.fn.sx_named("send", "__send") && c.args.len >= 2 && env.sd_msg_rc(c.args[1].addr())).match ({
        true  => c.pos.pos_or(1),
        false => 0,
    })
}
// ── SENDABILITY AS A TYPE CAPABILITY: `ref` (MutPtr<T>) is not sendable ──────────────────────────
// The send-payload classifier, read off the payload's TYPE (Pony reference-capabilities, NOT a verb):
//   value — no pointers, copied → sendable (zero ceremony);
//   val   — readonly `Ptr<T>` (= Pony `box`, deeply immutable) → sendable + aliasable;
//   iso   — `Own<T>` moved (move-on-send kills the binding, above) → sendable uniquely.
// A `MutPtr<T>` (= Pony `ref`: a MUTABLE, aliasable pointer) is NONE of these: keeping the sender's
// mutable alias while the receiver also mutates the pointee is a cross-actor data race. So a send whose
// message carries a `MutPtr<T>` — directly, wrapped in an enum variant, or in a struct field — is
// rejected. The receiver still reads a `Ptr<T>`/value payload AS ITS NORMAL TYPE (no wrapper); this
// pass only refuses the mutable-reference kind. Same shape as the send-Rc pass (type-aware via
// infer_expr, walks the same surfaces); runs AFTER scratch-escape so an addr-of-local (also a MutPtr)
// gets the more specific lifetime remedy first.
sm_inits_mut = (env: Env, inits: [FieldInit]) bool {
    inits.slice_any((fi) { env.sm_msg_mut(tvoid(), fi.value) })
}
// Classify a send-payload expression by the TYPE it reaches (Pony reference-capabilities), NOT its AST
// shape. A constructor node (MakeEnum / MakeStruct) is descended into the SPECIFIC payload/fields actually
// constructed — never inferred as a whole, so a `.Inc(3)` of an enum that ALSO has a `.Poke(MutPtr)` variant
// is not wrongly rejected. EVERY OTHER leaf (Var, Call, MethodCall, Member, Index, …) is classified
// by `ty_reaches_mutptr(infer_expr(e))`: this is what makes the check SOUND THROUGH A CALL/MEMBER/FIELD —
// `send(.Poke(o.ptr()))` (a method returning MutPtr) and `send(.Poke(launder(b.addr())))` (a MutPtr threaded
// through an identity fn) both infer a MutPtr-reaching type and reject, closing the `.Var`-only hole where
// they fell to `false`. A call returning a deeply-immutable `Ptr<T>` (`val`) still infers clean (not
// rejected) — the precision comes from the type predicate, not the syntax.
// The DECLARED payload type of the constructed variant reaches a MutPtr — e.g. `.Poke(x)` where the
// enum's `Poke` variant is declared `Poke(MutPtr<i32>)`. This is what closes the generic-FORWARDER hole
// (#407 launder): `fwd<T>(h, payload: T){ h.send(.Poke(payload)) }` infers its payload EXPRESSION as the
// bare tparam `T` (reaches no MutPtr), but the message it constructs is a `.Poke`, whose DECLARED field
// is a MutPtr regardless of what `T` is bound to — so the receiver still gets a mutable alias. Reading
// the SPECIFIC constructed variant's declared field (not the whole enum) keeps a sibling `.Inc(3)` on
// the same enum legal (Inc's field is an i32, reaches no MutPtr). The enum is pinned by the constructor
// node's own `ty` when set, else by `mty` — the message type M carried by the send TARGET's handle
// (`send(h, .Poke(x))` → h: CellRef<M> → M): a bare `.Poke` inside a generic forwarder leaves `mk.ty`
// empty, so M from the (concretely-typed) handle is what resolves the variant. Lenient when NEITHER
// pins the enum (both void) — the payload-expression descent still applies, so nothing over-rejects.
sm_variant_decl_mut = (env: Env, mty: Ty, mk: MakeEnumData) bool {
    ety = is_empty(mk.ty).then({ mty }, { tnamed(mk.ty) })
    env.decls.mode_of(env.subj_variant_payload(ety, mk.variant)).mode_sendable() == false
}
sm_msg_mut = (env: Env, mty: Ty, e: Ptr<Expr>) bool {
    load(e).match ({
        .MakeEnum(mk)  => env.sm_variant_decl_mut(mty, mk).match ({
            true  => true,
            false => env.sm_msg_mut(tvoid(), mk.payload),
        }),
        .MakeStruct(s) => env.sm_inits_mut(s.inits),
        _              => env.decls.mode_of(env.infer_expr(e)).mode_sendable() == false,
    })
}
// The actor-send surfaces (name-based, arity-guarded — mirrors the scratch pass's `sx_call_kind`): the
// MESSAGE is the LAST argument, NOT a hardcoded `args[1]`. That covers the 3-arg PARALLEL primitive
// `send(p, h, msg)` (from `p.send(h, msg)` / std.concurrent.pool_actor.send, flattened to `…__send`) whose
// message is `args[2]` — the path where cross-actor races ACTUALLY happen — as well as the 2-arg inline
// `send(h, msg)`. It ALSO covers `ref_send_msg(r, msg)` (std.concurrent.pool_actor: the typed ActorRef
// REPLY send, S2) whose message is `args[1]` — so a reply carrying a MutPtr is rejected exactly like a
// send; the ActorRef `r` is not generic, so M is unresolved (tvoid) → the payload-expression descent
// (same as the 3-arg `pool_send`) decides. `sx_named` accepts the bare name and the flattener's suffix.
// the handle is the argument immediately BEFORE the message in every flattened send shape — `send(h,
// msg)` and the 3-arg parallel `send(p, h, msg)` / `pool_send(p, h, msg)` — so `args[len-2]` yields the
// handle whose type arg is the message type M, used to resolve a bare `.Variant` message against M's decl.
sm_call_pos* = (env: Env, c: CallData) i32 {
    (c.fn.sx_named("send", "__send") && c.args.len >= 2
        || c.fn.sx_named("pool_send", "__pool_send") && c.args.len == 3
        || c.fn.sx_named("ref_send_msg", "__ref_send_msg") && c.args.len == 2).match ({
        true  => env.sm_msg_mut(env.infer_expr(c.args[c.args.len - 2].addr()).first_gen_arg(), c.args[c.args.len - 1].addr()).match ({
            true  => c.pos.pos_or(1),
            false => 0,
        }),
        false => 0,
    })
}
// the UFCS form as it may survive pre-desugar (`h.send(m)` / `p.send(h, m)` / `p.pool_send(h, m)`): the
// message is again the LAST method argument (the receiver is carried separately).
// pre-desugar UFCS form (`h.send(m)` / `p.pool_send(h, m)`): the message is the last method arg; the
// handle carrying M is the RECEIVER for `h.send(m)` (its first type arg is M). For `p.pool_send(h, m)`
// the receiver is the pool (M unresolved → tvoid), which falls back to the payload-expression descent.
sm_mcall_pos* = (env: Env, mc: MethodCallData) i32 {
    (mc.method.sx_named("send", "__send") && mc.args.len >= 1
        || mc.method.sx_named("pool_send", "__pool_send") && mc.args.len == 2
        || mc.method.sx_named("ref_send_msg", "__ref_send_msg") && mc.args.len == 1).match ({
        true  => env.sm_msg_mut(env.infer_expr(mc.recv).first_gen_arg(), mc.args[mc.args.len - 1].addr()).match ({
            true  => mc.pos.pos_or(1),
            false => 0,
        }),
        false => 0,
    })
}
