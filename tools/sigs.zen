// tools/sigs.zen — signature-map generator, written in Zen (dogfooding the compiler-as-library).
//
//   ./zen run tools/sigs.zen src          # or any directory; default is `src`
//
// Walks the directory recursively (entries sorted, so the output is deterministic), parses every
// `.zen` file with the REAL parser (compiler.parse.parse_module — no regex), and prints one section
// per module:
//
//   ## src/std/text/str.zen
//     len* = (s: StringView) i64
//     dup_bytes_in*<A> = (a: MutPtr<A>, s: StringView) Result<MutSlice<u8>, IoError>
//     Param*: { name: StringView, ty: Ty, variadic: bool }
//     Expr*: Int(i64) | Byte(i32) | ...
//
// What is included (and the calls made):
//   • every top-level fn (and foreign decl) as `name[*][<tparams>] = (params) ret` — no body;
//     trailing `*` = exported (recovered via compiler.parse.exports_get after the parse)
//   • every struct with its FULL field list on one line; every enum with its full variant chain
//     (multi-payload variants are re-inlined from their synthesized `__anon…` tuple structs, which
//     are themselves suppressed at top level — no internal name leaks)
//   • impl methods (the parser hoists them to mangled top-level DFuncs) print DEMANGLED as
//     `Ty.m = (params) ret` under a `Ty.impl(Trait)` head; the hoisted mangled fns are skipped
//   • globals as `name[*] = <init>` / `name[*] ::= <init>` (their declared ty is only filled in by
//     resolve, so the init
//     expression — rendered by the compiler's own ff_expr — is the honest parse-time signature);
//     module aliases (`m = std.x`) and imports are skipped: they declare nothing
// Types are rendered by the compiler's own pretty-printer (compiler.pretty.ff_ty), so every type
// spelling here is byte-identical to `zen fmt` output. A trailing `-- sigs:` summary line reports
// file/fn/type counts.
{ arg, argc } = std.sys.os
{ Allocator, heap_allocator } = std.mem.alloc
{ contents_in, out } = std.io.file
{ is_dir, read_dir } = std.sys.fs
{ cat_in, ends_with, starts_with, sv_lt } = std.text.str
{ sort_by } = std.sort
{ expect, or } = std.core.result
{ then } = std.core.bool
{ arg_int, arg_str, format } = std.text.fmt
{ String } = std.text.string
{ exports_get, parse_module } = compiler.parse
{ perr_get } = compiler.parse_type
{ lerr_get } = compiler.lex
{ Decl, Field, Func, GlobalData, ImplData, Param, Ty, VariantDef } = compiler.ast.ast_types
{ gstr_finish, is_expr_null, tvoid } = compiler.genc
{ ff_append, ff_string, ff_ty } = compiler.pretty
{ ff_expr } = compiler.pretty_expr
{ ff_is_hoisted } = compiler.pretty_decl
{ impl_cname_in } = compiler.mangle
// running totals for the trailing summary line (module-level mutable globals — Goal Z E1)
g_files ::= 0
g_fns ::= 0
g_types ::= 0
// ── small local helpers over the compiler AST ─────────────────────────────────
no_params = () MutSlice<Param> { slice(null_ptr(), 0) }
// the fn named `name` among `decls` (name == "" when absent) — pretty_decl keeps its finder private,
// so the lookup is re-stated here (~10 lines)
find_fn = (decls: MutSlice<Decl>, name: StringView) Func {
    res ::= Func(
        name: "",
        params: no_params(),
        ret: tvoid(),
        tparams: no_params(),
        body: slice(null_ptr(), 0),
    )
    decls.loop((h, i, d) {
        d.match ({
            .DFunc(f) => (f.name == name).then({
                res = f
            }),
            _         => { },
        })
    })
    res
}
is_exported = (exp: MutSlice<Param>, name: StringView) bool {
    found ::= false
    exp.loop((h, i, p) {
        found = found || p.name == name
    })
    found
}
// `name` plus the trailing `*` export marker when the parse recorded it
sig_name = (s: String, mp: Allocator, exp: MutSlice<Param>, name: StringView) String {
    is_exported(exp, name).match ({
        true  => s.ff_append(mp, name).ff_append(mp, "*"),
        false => s.ff_append(mp, name),
    })
}
// `<A, B: Bound>` (empty tparams print nothing; a bound is carried as the tparam's Named ty)
sig_tparams = (s: String, mp: Allocator, tps: MutSlice<Param>) String {
    (tps.len == 0).match ({
        true  => s,
        false => {
            body ::= s.ff_append(mp, "<")
            tps.loop((h, i, p) {
                body = (i == 0).then({ body }, { body.ff_append(mp, ", ") })
                body = p.ty.match ({
                    .Void => body.ff_append(mp, p.name),
                    _     => body.ff_append(mp, p.name).ff_append(mp, ": ").ff_ty(mp, p.ty),
                })
            })
            body.ff_append(mp, ">")
        },
    })
}
// a trailing `...T` param stores its type as the collected `[T]`; recover T to re-print `...T`
variadic_elem = (t: Ty) Ty {
    t.match ({
        .Slice(p) => load(p.pointee),
        _         => t,
    })
}
sig_params = (s: String, mp: Allocator, ps: MutSlice<Param>) String {
    body ::= s
    ps.loop((h, i, p) {
        body = (i == 0).then({ body }, { body.ff_append(mp, ", ") })
        body = p.variadic.match ({
            true  => body
                .ff_append(mp, p.name)
                .ff_append(mp, ": ...")
                .ff_ty(mp, variadic_elem(p.ty)),
            false => body.ff_append(mp, p.name).ff_append(mp, ": ").ff_ty(mp, p.ty),
        })
    })
    body
}
// the shared ` = (params) ret` tail of a fn/method signature line
sig_tail = (s: String, mp: Allocator, f: Func) String {
    g_fns = g_fns + 1
    s
        .sig_tparams(mp, f.tparams)
        .ff_append(mp, " = (")
        .sig_params(mp, f.params)
        .ff_append(mp, ") ")
        .ff_ty(mp, f.ret)
        .ff_append(mp, "\n")
}
sig_fn = (s: String, mp: Allocator, exp: MutSlice<Param>, f: Func) String {
    s.ff_append(mp, "  ").sig_name(mp, exp, f.name).sig_tail(mp, f)
}
// ── structs / enums ───────────────────────────────────────────────────────────
sig_struct = (
    s: String,
    mp: Allocator,
    exp: MutSlice<Param>,
    name: StringView,
    tps: MutSlice<Param>,
    fields: MutSlice<Field>,
) String {
    g_types = g_types + 1
    body ::= s
        .ff_append(mp, "  ")
        .sig_name(mp, exp, name)
        .sig_tparams(mp, tps)
        .ff_append(mp, ": {")
    fields.loop((h, i, fl) {
        body = (i == 0).then({ body.ff_append(mp, " ") }, { body.ff_append(mp, ", ") })
        body = body.ff_append(mp, fl.name).ff_append(mp, ": ").ff_ty(mp, fl.ty)
    })
    body.ff_append(mp, " }\n")
}
// a multi-payload variant `V(t0, t1)` is desugared at parse time into a synthesized `__anon…` struct;
// re-inline its field types as the surface tuple (the struct itself is suppressed at top level)
sig_tuple = (s: String, mp: Allocator, decls: MutSlice<Decl>, nm: StringView, t: Ty) String {
    found ::= false
    body ::= s
    decls.loop((h, i, d) {
        d.match ({
            .DStruct(sd) => (sd.name == nm && found == false).then({
                found = true
                body = body.ff_append(mp, "(")
                sd.fields.loop((h2, k, fl) {
                    body = (k == 0).then({ body }, { body.ff_append(mp, ", ") })
                    body = body.ff_ty(mp, fl.ty)
                })
                body = body.ff_append(mp, ")")
            }),
            _            => { },
        })
    })
    found.then({ body }, { body.ff_append(mp, "(").ff_ty(mp, t).ff_append(mp, ")") })
}
sig_payload = (s: String, mp: Allocator, decls: MutSlice<Decl>, t: Ty) String {
    t.match ({
        .Named(nm) => nm.starts_with("__anon").match ({
            true  => s.sig_tuple(mp, decls, nm, t),
            false => s.ff_append(mp, "(").ff_ty(mp, t).ff_append(mp, ")"),
        }),
        _          => s.ff_append(mp, "(").ff_ty(mp, t).ff_append(mp, ")"),
    })
}
// one variant: `Name`, `Name(Payload)`, or — zero-arg ctor with a default constant — `Name = expr`
sig_variant = (s: String, mp: Allocator, decls: MutSlice<Decl>, vd: VariantDef) String {
    base = vd.payload.match ({
        .Void => s.ff_append(mp, vd.name),
        _     => s.ff_append(mp, vd.name).sig_payload(mp, decls, vd.payload),
    })
    vd.dflt.is_expr_null().then({ base }, { base.ff_append(mp, " = ").ff_expr(mp, vd.dflt, 0) })
}
sig_enum = (
    s: String,
    mp: Allocator,
    exp: MutSlice<Param>,
    decls: MutSlice<Decl>,
    name: StringView,
    tps: MutSlice<Param>,
    vs: MutSlice<VariantDef>,
) String {
    g_types = g_types + 1
    body ::= s
        .ff_append(mp, "  ")
        .sig_name(mp, exp, name)
        .sig_tparams(mp, tps)
        .ff_append(mp, ": ")
    vs.loop((h, i, vd) {
        body = (i == 0).then({ body }, { body.ff_append(mp, " | ") })
        body = body.sig_variant(mp, decls, vd)
    })
    body.ff_append(mp, "\n")
}
// ── impls / globals ───────────────────────────────────────────────────────────
// an impl marker: a `Ty.impl(Trait)` head (trait impls only — inherent impls have ty == trname),
// then each method DEMANGLED back from its hoisted `impl_<Tr>_<Ty>_<m>` fn as `Ty.m = (params) ret`.
// A method absent among the decls (satisfied by a trait default) prints nothing here.
sig_impl = (s: String, mp: Allocator, decls: MutSlice<Decl>, im: ImplData) String {
    body ::= (im.ty == im.trname).match ({
        true  => s,
        false => s
            .ff_append(mp, "  ")
            .ff_append(mp, im.ty)
            .ff_append(mp, ".impl(")
            .ff_ty(mp, im.trty)
            .ff_append(mp, ")\n"),
    })
    im.methods.loop((h, k, p) {
        f = find_fn(decls, mp.impl_cname_in(im.trname, im.ty, p.name))
        (f.name == "" == false).then({
            body = body
                .ff_append(mp, "  ")
                .ff_append(mp, im.ty)
                .ff_append(mp, ".")
                .ff_append(mp, p.name)
                .sig_tail(mp, f)
        })
    })
    body
}
// a global `name = <init>` (its ty is only filled in by resolve, so the init IS the parse-time
// signature); `thread_local(...)` wrapping is restored; module aliases (`m = std.x`) are skipped.
// The mark says what the declaration says: `::=` when it carries the mutability mark, `=` otherwise
// — an unmarked global is a constant, exactly like an unmarked local.
sig_global = (s: String, mp: Allocator, exp: MutSlice<Param>, g: GlobalData) String {
    g.alias.match ({
        true  => s,
        false => {
            mark = g.mut.then({ " ::= " }, { " = " })
            head = s.ff_append(mp, "  ").sig_name(mp, exp, g.name).ff_append(mp, mark)
            body = g.tl.match ({
                true  => head
                    .ff_append(mp, "thread_local(")
                    .ff_expr(mp, g.init, 0)
                    .ff_append(mp, ")"),
                false => head.ff_expr(mp, g.init, 0),
            })
            body.ff_append(mp, "\n")
        },
    })
}
// ── the per-decl dispatch ─────────────────────────────────────────────────────
sig_decl = (s: String, mp: Allocator, exp: MutSlice<Param>, decls: MutSlice<Decl>, d: Decl) String {
    d.match ({
        .DFunc(f)      => mp.ff_is_hoisted(decls, f.name).then({ s }, { s.sig_fn(mp, exp, f) }),    // a hoisted impl method — printed demangled via its DImpl marker
        .DForeign(f)   => s.sig_fn(mp, exp, f),
        .DStruct(sd)   => sd.name.starts_with("__anon").match ({
            true  => s,
            false => s.sig_struct(mp, exp, sd.name, no_params(), sd.fields),
        }),    // synthesized tuple-payload struct — re-inlined at its variant
        .DGenStruct(g) => s.sig_struct(mp, exp, g.name, g.tparams, g.fields),
        .DEnum(ed)     => s.sig_enum(mp, exp, decls, ed.name, no_params(), ed.variants),
        .DGenEnum(g)   => s.sig_enum(mp, exp, decls, g.name, g.tparams, g.variants),
        .DImpl(im)     => s.sig_impl(mp, decls, im),
        .DGlobal(g)    => s.sig_global(mp, exp, g),
        _              => s,
    })
}    // DImport / DRaw / DTraitDefault declare no printable signature
// ── the walk ──────────────────────────────────────────────────────────────────
// parse one module and print its section (`## path` + one line per decl)
emit_file = (mp: Allocator, path: StringView) void {
    g_files = g_files + 1
    src = mp.addr().contents_in(path).expect("sigs: cannot read file")
    decls = mp.parse_module(src)
    exp = exports_get()
    s ::= mp
        .ff_string(4096)
        .ff_append(mp, "## ")
        .ff_append(mp, path)
        .ff_append(mp, "\n")
    (perr_get() || lerr_get()).match ({
        true  => {
            s = s.ff_append(mp, "  !! parse error, module skipped\n")
        },
        false => decls.loop((h, i, d) {
            s = s.sig_decl(mp, exp, decls, d)
        }),
    })
    out(s.gstr_finish(mp)).or(0)
}
// directory listings are unsorted; sections must be stable
sort_names = (xs: MutSlice<StringView>) void {
    xs.sort_by((x: StringView, y: StringView) bool { x.sv_lt(y) })
}
// recurse into subdirectories, emit every `.zen` file, sorted at each level
walk = (mp: Allocator, dir: StringView) void {
    entries = mp.addr().read_dir(dir).expect("sigs: cannot read directory")
    entries.sort_names()
    entries.loop((h, i, entry) {
        full = mp.addr().cat_in(mp.addr().cat_in(dir, "/"), entry)
        full.is_dir().match ({
            true  => {
                mp.walk(full)
            },
            false => {
                full.ends_with(".zen").then({
                    mp.emit_file(full)
                })
            },
        })
    })
}
// the target directory: the last non-`--` CLI arg (scanned recursively), defaulting to `src`
pick_root_from = (i: i32, acc: StringView) StringView {
    (i >= argc()).match ({
        true  => acc,
        false => {
            a = arg(i)
            (a == "--").then({ pick_root_from(i + 1, acc) }, { pick_root_from(i + 1, a) })
        },
    })
}
pick_root = () StringView { pick_root_from(1, "src") }
main = () i32 {
    mp = heap_allocator()
    root = pick_root()
    root.is_dir().match ({
        true  => {
            mp.walk(root)
            format("-- sigs: {} files, {} fns, {} types\n", [arg_int(g_files), arg_int(g_fns), arg_int(g_types)])
            0
        },
        false => {
            format("sigs: not a directory: {}\n", [arg_str(root)])
            1
        },
    })
}
