// the operators that share a prefix must lex greedily: +% is one token,
// not + then %, and ::= is one token, not :: then =.
Error = AllocError | IoError

label = (b: bool) str {
    b.match({
        true  => "yes",
        false => "no",
    })
}

main = (env: Env) Res<i32, Error> {
    a: i32 = 7;
    b: i32 = 3;
    c ::= 0;
    c = a +% b;
    println("{}", c);
    println("{}", a % b);
    println("{}", a - b);
    println("{}", a -% b);
    println("{}", a *% b);
    println("{}", a / b);
    d::=a*b;
    println("{}", d);
    println("{}", label(a == 7));
    println("{}", label(a < b));
    println("{}", label(!(a < b)));
    println("{}", label(a == 7 && b == 3));
    Ok(0);
}
