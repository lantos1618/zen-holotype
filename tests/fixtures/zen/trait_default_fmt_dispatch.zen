// The CANONICAL (zenc-fmt) spelling of a trait with a default method body must itself compile and
// dispatch: `twice` is declared with a default INSIDE the record, `Sq` implements only the required
// `area`, and the default routes through the impl. Exit 18 (= (3*3)*2) proves default dispatch.
Area*: {
    area: (arg0: Ptr<Self>) i32,
    twice = (p: Ptr<Self>) i32 { p.area() * 2 },
}
Sq: {
    s: i32,
}
Sq.impl(Area, {
    area = (p: Ptr<Sq>) i32 { p.s * p.s }
})
main = () i32 {
    q = Sq(s: 3)
    q.addr().twice()
}
