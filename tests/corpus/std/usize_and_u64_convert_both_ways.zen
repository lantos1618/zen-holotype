// tests/corpus/std/usize_and_u64_convert_both_ways.zen
// github issue #756: `usize` had no lossless widening OUT of it at all and
// `u64` none into `usize`, so a length (`Vec.len`, `str.len`) and a count
// (`Duration(ns:)`, `Hash.hash`) could not meet — the two halves of std
// could not talk to each other.
//
// Why nothing caught it: every conversion in the table lived beside the
// declarations in num.zen's own directory, so the corpus never called one
// from another module. This test is that caller. It lives here, outside
// num.zen, on purpose — a trait impl or free function on a primitive
// resolves inside its home module even when the lowering behind it would
// be invisible everywhere else.
//
// usize.BITS = 64 on this target (num.zen), so both directions are the
// identity; the large values are what turn a wrong width into a wrong
// number rather than into nothing.
//
// No line prints a usize extreme directly: num.zen pins usize's width to
// the target, so a printed 18446744073709551615 would stop being true on
// a narrower one. The extremes go through an equality against u64.MAX /
// usize.MAX instead, which reads as 1 or 0 on any width.
//
// the two halves meet: the length becomes a count a hasher takes
// (`::` because write_u64 mutates its receiver, as Map.set does)
digest = (h :: Hasher, v: u64) u64 {
    h.write_u64(v);
    h.finish();
}

main = (env: Env) Res<i32, ArgError> {
    // usize -> u64: the length becomes a count
    n: usize = env.argv.len;
    d: u64    = n.to_u64();
    println("d {}", d);

    // u64 -> usize: the count comes back to a length
    back: usize = d.to_usize();
    println("back {}", back);

    // near the top of the range: 2^63 + 1 survives both directions with
    // every bit intact — a 32-bit leg anywhere in the chain drops it to
    // 1 instead
    big: u64 = 9223372036854775809;
    println("big {}", big.to_usize().to_u64());

    // round-trip identity at both extremes, asked as agreement so the
    // expected file stays target-independent
    top: u64      = u64.MAX;
    usize_top     = usize.MAX.to_u64();
    usize_max_agrees = (usize_top == u64.MAX).match({
        true  => 1,
        false => 0,
    });
    println("u64max {}", top);
    println("usize_max_agrees {}", usize_max_agrees);

    // the two halves meet: the length becomes a count a hasher takes
    println("hash {}", digest(Hasher(), n.to_u64()));
    Ok(0);
}
