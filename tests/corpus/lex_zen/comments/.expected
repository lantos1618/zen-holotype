-- line comments
[// to end of line]
  a line comment [// to end of line]
  end of file []
[// first
x]
  a line comment [// first]
  an identifier [x]
  end of file []
[//]
  a line comment [//]
  end of file []
[// only]
  a line comment [// only]
  end of file []
-- block comments
[/* one */]
  a block comment [/* one */]
  end of file []
[/* over
two lines */ x]
  a block comment [/* over
two lines */]
  an identifier [x]
  end of file []
[/* a /* b */]
  a block comment [/* a /* b */]
  end of file []
[/* a * b */]
  a block comment [/* a * b */]
  end of file []
-- unterminated
[/* never closed]
  end of file []
  ! 1:1 unterminated block comment: end of file before `*/`
[/*]
  end of file []
  ! 1:1 unterminated block comment: end of file before `*/`
[/* a *]
  end of file []
  ! 1:1 unterminated block comment: end of file before `*/`
-- slash is still division
[a / b]
  an identifier [a]
  `/` [/]
  an identifier [b]
  end of file []
