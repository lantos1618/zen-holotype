// Resolve declaration names and bind targets under a cursor, including
// by-value identifiers with no arena id.

str = std.text
Range = std.core
Pos, Span, Ident = std.ast.ast_span
ExprId, TypeId = std.ast.ast_id
Ast = std.ast.ast_arena
Decl, Function, Param, Member, Import, Bind = std.ast.ast_node

TypeAt* = {
    span*: Span,
    id*: TypeId,
}

ValueAt* = {
    span*: Span,
    id*: ExprId,
}

// Import bindings resolve definitions but have no local type or expression.
Tell* = Nothing
    | Sig(Function)
    | OfType(TypeAt)
    | OfValue(ValueAt)
    | Imported(Ident)

told_at* = (tree: Ast, file: str, p: Pos) Tell {
    probe = Probe(tree: tree, file: file, p: p);
    named = probe.named();
    named.is_nothing().match({
        false => named,
        true  => probe.node(),
    })
}

is_nothing* = (t: Tell) bool {
    t.match({ Nothing => true, _ => false })
}

// The first answer that is not Nothing.
or = (have: Tell, cand: Tell) Tell {
    have.is_nothing().match({ true => cand, false => have })
}

module_index_of* = (tree: Ast, file: str) Res<usize> {
    Range(0, tree.module_count()).find((i) {
        tree.module_at(i).match({
            None  => false,
            Ok(m) => m.span.file.eq(file),
        })
    })
}

// The written type wins over the value where both exist: `X: i32 = 5`
// answers from the annotation, `X = 5` from the value.
told = (span: Span, t: Res<TypeId>, v: Res<ExprId>) Tell {
    t.match({
        Ok(id) => Tell.OfType(TypeAt(span: span, id: id)),
        None   => v.match({
            Ok(e) => Tell.OfValue(ValueAt(span: span, id: e)),
            None  => Tell.Nothing,
        }),
    })
}

// One cursor position, asked of every declaration in the tree.
Probe = {
    tree: Ast,
    file: str,
    p: Pos,

    hit = (self: @Self, span: Span) bool { span.covers(self.file, self.p) }

    named = (self: @Self) Tell {
        found ::= Tell.Nothing;
        Range(0, self.tree.module_count()).loop((h, i) {
            self.tree.module_at(i).match({
                None  => (),
                Ok(m) => m.decls.loop(
                    (h2, d) { found = found.or(self.decl(d)); }
                ),
            });
        });
        self.tree.blocks_each((bid, block) {
            block.stmts.loop((h2, s) {
                s.kind.match({
                    Decl(d) => { found = found.or(self.decl(d)); },
                    _       => (),
                });
            });
        });
        found;
    }

    // Struct and enum declaration names have no written TypeId; uses still
    // resolve through their type nodes.
    decl = (self: @Self, d: Decl) Tell {
        d.kind.match({
            Function(f) => self.function(f),
            Const(cn)   => self.answer(cn.name.span, cn.type, Ok(cn.value)),
            Alias(al)   => self.answer(al.name.span, Ok(al.target), None),
            Struct(st)  => self.members(st.members),
            Impl(im)    => self.members(im.members),
            Enum(_)     => Tell.Nothing,
            Import(im)  => self.import(im),
        })
    }

    // Each imported binding has its own cursor span.
    import = (self: @Self, im: Import) Tell {
        found ::= Tell.Nothing;
        im.names.loop((h, n) {
            self.hit(n.name.span).then(() {
                found = found.or(Tell.Imported(n.name));
            });
        });
        found;
    }

    // A function name resolves to its signature; parameters to their types.
    function = (self: @Self, f: Function) Tell {
        self.hit(f.name.span).match({
            true  => Tell.Sig(f),
            false => self.params(f.params),
        })
    }

    // Parameters without written types have no AST-level type answer.
    params = (self: @Self, ps: Vec<Param>) Tell {
        found ::= Tell.Nothing;
        ps.loop((h, prm) {
            found = found.or(self.answer(prm.name.span, prm.type, None));
        });
        found;
    }

    members = (self: @Self, ms: Vec<Member>) Tell {
        found ::= Tell.Nothing;
        ms.loop((h, m) { found = found.or(self.member(m)); });
        found;
    }

    // Supplied members resolve through their value; declared fields use
    // their type.
    member = (self: @Self, m: Member) Tell {
        m.kind.match({
            Function(f) => self.function(f),
            Const(cn)   => self.answer(cn.name.span, cn.type, Ok(cn.value)),
            Field(fl)   => self.answer(fl.name.span, fl.type, fl.value),
        })
    }

    answer = (self: @Self, span: Span, t: Res<TypeId>, v: Res<ExprId>) Tell {
        self.hit(span).match({
            false => Tell.Nothing,
            true  => told(span, t, v),
        })
    }

    // Pattern nodes have no checked type memo; written type nodes do.
    node = (self: @Self) Tell {
        self.tree.node_at(self.file, self.p).match({
            None  => Tell.Nothing,
            Ok(n) => n.match({
                ExprNode(e)    => self.expr(e),
                TypeNode(t)    => told(self.tree.type_at(t).span, Ok(t), None),
                PatternNode(_) => Tell.Nothing,
                BlockNode(_)   => Tell.Nothing,
            }),
        })
    }

    // A binding target is not checked as a standalone expression; it
    // resolves through the bind's annotation or value.
    expr = (self: @Self, e: ExprId) Tell {
        span = self.tree.expr_at(e).span;
        found ::= told(span, None, Ok(e));
        self.tree.blocks_each((bid, block) {
            block.stmts.loop((h2, s) {
                s.kind.match({
                    Bind(b) => {
                        (b.target.index == e.index).then(() {
                            found = told(span, b.type, Ok(b.value));
                        });
                    },
                    _       => (),
                });
            });
        });
        found;
    }
}
