// probeR: create<Cell> in a NON-recursive helper taking Alloc
Cell = {
    value: i64,
    next: Ptr<Cell>,
}

mk = (a: Alloc) Res<Ptr<Cell>, AllocError> {
    cell = a.create<Cell>().try();
    cell.write(0, Cell(value: 7, next: null_ptr<Cell>()));
    Ok(cell);
}

main = (env: Env) Res<i32, AllocError> {
    a ::= env.mem.alloc();
    p = mk(a).try();
    println("v {}", p.read(0).value);
    Ok(0);
}
