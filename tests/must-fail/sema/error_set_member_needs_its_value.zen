// `Error = AllocError | IoError` is a STRUCTURAL enum: each variant
// carries the member type it names, so `Error.IoError` alone is as
// incomplete as `Shape.Circle` alone. The compiler cannot answer it --
// the only thing it could hand back is a tag beside bytes nobody wrote,
// which is precisely the value the union exists to carry.
//
// position: the member access.

Error = AllocError | IoError

fails = () Res<i32, Error> {
    Err(Error.IoError);
}

main = (env: Env) Res<i32, Error> {
    fails().match({
        Ok(n)  => println("{}", n),
        Err(_) => println("err"),
    });
    Ok(0);
}
