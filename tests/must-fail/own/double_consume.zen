// a second `consume` is just another use of a dead binding. one
// value, one drop, so the second move has nothing to move.

Buf = {
    id: i32,
}

Buf.impl(Drop, {
    drop = (self :: @Self) () { /* nothing to release: id is bytes */ }
})

main = (env: Env) Res<i32, IoError> {
    f = Buf(id: 1);
    g = consume f;
    h = consume f;
    println("{}", g.id);
    println("{}", h.id);
    Ok(0);
}
