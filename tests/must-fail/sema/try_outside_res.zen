// .try() unwraps Ok or returns the Err from the ENCLOSING function --
// so the enclosing function must have somewhere to return it to.
//
// position: the .try() call.

AError =
    Zero,
    Negative

checked = (n: i32) Res<i32, AError> {
    (n == 0).match({
        true  => Err(AError.Zero),
        false => Ok(n),
    })
}

plain = (n: i32) i32 {
    checked(n).try()
}

main = (env: Env) Res<i32, AError> {
    println("{}", plain(1));
    Ok(0);
}
