// probeAQ: Arena param, realloc, .try() then use -- does sema see Ptr<T>?
mk = (ar: Arena) Res<i64, AllocError> {
    p0 = ar.raw(8, 16).try();
    p = ar.realloc(p0.to<i64>(), 1).try();
    p.write(0, 42);
    Ok(p.read(0))
}

main = (env: Env) Res<i32, AllocError> {
    a ::= env.mem.alloc();
    println("v {}", mk(a).try());
    Ok(0);
}
