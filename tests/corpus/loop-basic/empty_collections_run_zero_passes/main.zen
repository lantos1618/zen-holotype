// tests/corpus/loop-basic/empty_collections_run_zero_passes/
// empty is where every wrong lowering agrees with itself: a do-while
// runs once, an inclusive upper bound runs once, a signed comparison
// reading a usize start as negative never terminates. four empty
// shapes, one count each - and the fold must answer its init, because
// init is DEFINED as the answer when there is nothing to fold. a
// compiler that initialises the accumulator from the first element
// has nothing to read here and the crash or the zero gives it away

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();

    // zero-width at zero
    c1 ::= 0;
    Range(0, 0).loop((h, v) { c1 = c1 + 1; });
    println("range 0..0 ran {}", c1);

    // zero-width NOT at zero: a body-tested condition or an
    // inclusive end gives 1 here, and 1 looks plausible
    c2 ::= 0;
    Range(5, 5).loop((h, v) { c2 = c2 + 1; });
    println("range 5..5 ran {}", c2);

    // inverted: empty too, not six backwards passes
    c3 ::= 0;
    Range(9, 6).loop((h, v) { c3 = c3 + 1; });
    println("range 9..6 ran {}", c3);

    // an empty Vec: no pass may reach the body
    none ::= alloc.Vec<str>();
    none.loop((h, s) {
        println("body ran on empty");
    });
    println("empty vec done");

    // and the fold over nothing answers its init -- named <i32> because
    // the accumulator is: a constructed Range(a, b) walks usize
    // (range.zen), num.zen has no usize -> i32, so this line never
    // type-checked as written
    Range<i32>(0, 0).loop(41, (h, index, value, acc: i32) {
        acc + value
    }).match({
        Ok(n) => println("fold answered {}", n),
        None  => println("fold none"),
    });
    Ok(0);
}
