// src/std/core/byte.zen
// what you can ask a byte, and it is all ASCII.
//
// Lives in core, not std.text: text_str, text_utf8 and every lexer
// want these and none want each other. Separate from num.zen because
// "how wide is i32" and "is this byte a digit" are different subjects.
// ASCII-only throughout: a str is bytes (DESIGN.md), so `"héllo"[1]`
// is a continuation byte and `is_alpha` on it is correctly false — a
// codepoint question belongs to std.text.text_utf8, not here.
//
// UFCS makes these read as methods: `b.is_digit()`, not `is_digit(b)`.
// Free functions because a primitive has no struct body to hang them in.

// A byte's own ASCII value; naming it here is the one place a magic
// number is allowed — it IS the subject, not a stand-in for it.
DIGIT_ZERO* : u8 = '0'
DIGIT_NINE* : u8 = '9'
LOWER_A*    : u8 = 'a'
LOWER_F*    : u8 = 'f'
LOWER_Z*    : u8 = 'z'
UPPER_A*    : u8 = 'A'
UPPER_F*    : u8 = 'F'
UPPER_Z*    : u8 = 'Z'

// the gap between an upper and a lower letter. 'a' - 'A'
CASE_GAP*   : u8 = 32

// ASCII range: one past the last is the first multi-byte-sequence byte
ASCII_MAX*  : u8 = 127

// how many digits a base-16 digit stands for
HEX_BASE*   : u8 = 16

is_ascii* = (b: u8) bool { b <= ASCII_MAX }

is_digit* = (b: u8) bool { b >= DIGIT_ZERO && b <= DIGIT_NINE }

is_lower* = (b: u8) bool { b >= LOWER_A && b <= LOWER_Z }

is_upper* = (b: u8) bool { b >= UPPER_A && b <= UPPER_Z }

is_alpha* = (b: u8) bool { b.is_lower() || b.is_upper() }

is_alnum* = (b: u8) bool { b.is_alpha() || b.is_digit() }

// what a lexer skips. `\v`/`\f` included: treating them as ordinary
// bytes yields an "unexpected character" diagnostic nobody can act on
is_space* = (b: u8) bool {
    b == ' ' || b == '\t' || b == '\n' || b == '\r' || b == 11 || b == 12
}

// first byte and later bytes differ by exactly one thing — two names,
// not one with a flag
is_ident_start* = (b: u8) bool { b.is_alpha() || b == '_' }

is_ident_cont*  = (b: u8) bool { b.is_alnum() || b == '_' }

is_hex_digit* = (b: u8) bool {
    b.is_digit() || (b >= LOWER_A && b <= LOWER_F) || (b >= UPPER_A && b <= UPPER_F)
}

// Res, not a trap: "is this a digit, and which one" can legitimately
// miss (str.get shape). A caller already certain pays nothing via `.try()`.
digit_value* = (b: u8) Res<u8> {
    b.is_digit().match({
        true  => Ok(b - DIGIT_ZERO),
        false => None,
    });
}

hex_value* = (b: u8) Res<u8> {
    b.is_digit().match({
        true  => Ok(b - DIGIT_ZERO),
        false => (b >= LOWER_A && b <= LOWER_F).match({
            true  => Ok(b - LOWER_A + 10),
            false => (b >= UPPER_A && b <= UPPER_F).match({
                true  => Ok(b - UPPER_A + 10),
                false => None,
            }),
        }),
    });
}

// ASCII-only case folding: a byte outside A-Z/a-z comes back
// unchanged — there is no case to fold
to_lower* = (b: u8) u8 {
    b.is_upper().match({
        true  => b + CASE_GAP,
        false => b,
    });
}

to_upper* = (b: u8) u8 {
    b.is_lower().match({
        true  => b - CASE_GAP,
        false => b,
    });
}

// the low nibble as its hex digit. Caller splits the byte first —
// `(b / HEX_BASE).hex_digit()` then `(b % HEX_BASE)`. TRAPS above 15:
// an out-of-range nibble is a bug in the caller's shift, not a miss.
hex_digit* = (nibble: u8) u8 {
    // str.index's idiom: underflows for nibble >= HEX_BASE — unsigned
    // underflow IS the trap. Can't write `/ 0` literally: the compiler
    // rejects a trap it can prove will always fire.
    HEX_BASE - nibble - 1;
    (nibble < 10).match({
        true  => DIGIT_ZERO + nibble,
        false => LOWER_A + nibble - 10,
    });
}
