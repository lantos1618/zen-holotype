// Declaration parsing. The shape after `Name =` distinguishes declaration
// kinds:
//
//     { .. }              struct
//     | A   /  A | B      enum
//     (..) T { .. }       function, with a body
//     (..) T              function, signature only
//     a.b.c               import
//     Name / Name<T>      alias
//     anything else       constant
//
// The leading bar distinguishes a one-variant enum from an alias.

AllocError = std.mem
Span, Pos, Ident, no_trivia = std.ast.ast_span
TypeId, BlockId = std.ast.ast_id
Decl, DeclKind, Struct, Enum, Alias, Function, Impl, Import, Const = std.ast.ast_node
Member, Variant, ImportName, Param, TParam, Form, Module = std.ast.ast_node
TokenKind = std.parse.parse_token
Parser, Mark = std.parse.parser
expr = std.parse.parse_expr
type, written_type = std.parse.parse_type
value_shape, delim_step, ret_ahead = std.parse.parse_lookahead
body_block = std.parse.parse_stmt
qualified_name = std.parse.parse_pattern
struct_members, record_body, params_list, type_params = std.parse.parse_member

// Parse a whole module. Its span and trailing trivia cover the complete file.
module* = (p :: Parser, name: str) Res<Module, AllocError> {
    start = Pos(line: 1, col: 1);
    p.drain().try();
    decls   ::= p.alloc.Vec<Decl>();
    running ::= !p.at_eof();
    running.loop((h) {
        before = p.at;
        p.resume();
        decls.add(p.declaration(true).try()).try();
        (p.at == before).match({
            true  => p.recover(),
            false => p.nothing(),
        }).try();
        running = !p.at_eof() && !p.too_deep;
    });
    trailing = p.claim_rest();
    Ok(Module(
        name: name,
        decls: decls,
        span: Span(file: p.source.file, start: start, end: p.here_span().end),
        leading: no_trivia(),
        trailing: trailing,
    ));
}

// Recover at the next identifier outside brackets.
recover* = (p :: Parser) Res<(), AllocError> {
    p.bump().try();
    depth   ::= 0;
    running ::= !p.at_eof();
    running.loop((h) {
        kind  = p.peek().kind;
        depth = kind.delim_step(depth);
        (depth == 0 && kind == TokenKind.Ident).match({
            true  => { running = false; p.nothing() },
            false => p.skip(),
        }).try();
        running = running && !p.at_eof();
    });
    Ok(());
}

declaration* = (p :: Parser, module_level: bool) Res<Decl, AllocError> {
    m = p.open();
    p.impl_ahead().match({
        true  => p.impl_decl(m),
        false => p.named_decl(m, module_level),
    });
}

// Parse `Circle.impl(Rect, { .. })` as an impl declaration.
impl_decl = (p :: Parser, m: Mark) Res<Decl, AllocError> {
    target = p.ident("expected the type an impl is for").try();
    p.bump().try();
    p.bump().try();
    open = p.here_span();
    p.bump().try();
    bound = p.type().try();
    p.expect(
        TokenKind.Comma,
        "expected `,` between an impl's bound and its body"
    ).try();
    body_start = p.here();
    members ::= p.alloc.Vec<Member>();
    p.record_body(members).try();
    body_span = p.span_from(body_start);
    p.eat(TokenKind.Comma).try();
    p.expect_close(
        TokenKind.ParenClose,
        "unclosed `(`: this impl is never closed",
        open
    ).try();
    p.add_decl(DeclKind.Impl(Impl(
        target: target,
        bound: bound,
        members: members,
        body_span: body_span,
    )), m);
}

// `impl` is contextual, so recognize the full `Circle.impl(` shape.
impl_ahead* = (p :: Parser) bool {
    p.at_kind(TokenKind.Ident)
        && p.peek_n(1).kind == TokenKind.Dot
        && p.text(p.peek_n(2)) == "impl"
        && p.peek_n(3).kind == TokenKind.ParenOpen
}

named_decl = (p :: Parser, m: Mark, module_level: bool) Res<Decl, AllocError> {
    names   ::= p.alloc.Vec<ImportName>();
    tparams ::= p.alloc.Vec<TParam>();
    p.decl_names(names, tparams).try();
    written = p.eat(TokenKind.Colon).try().match({
        true  => p.written_type(),
        false => Ok(None),
    }).try();
    mutable = p.at_kind(TokenKind.ColonColonEq);
    ok      = p.eat(TokenKind.Eq).try() || p.eat(TokenKind.ColonColonEq).try();
    ok.match({
        true  => p.nothing(),
        false => p.error("expected `=` or `::=` after a declaration's name"),
    }).try();
    p.decl_value(m, names, tparams, written, mutable, module_level);
}

// Imports may bind multiple names (`Res*, Ok*, None*`); other declarations
// have one.
decl_names = (
    p       :: Parser,
    names   :: Vec<ImportName>,
    tparams :: Vec<TParam>
) Res<(), AllocError> {
    names.add(p.one_decl_name(tparams).try()).try();
    loop(p.at_kind(TokenKind.Comma), (h) {
        p.bump().try();
        names.add(p.one_decl_name(tparams).try()).try();
    });
    Ok(());
}

one_decl_name = (
    p       :: Parser,
    tparams :: Vec<TParam>
) Res<ImportName, AllocError> {
    m        = p.open();
    name     = p.ident(
        "expected `identifier`: a declaration begins with the name it declares"
    ).try();
    exported = p.eat(TokenKind.Star).try();
    p.at_kind(TokenKind.Lt).match({
        true  => p.type_params(tparams),
        false => p.nothing(),
    }).try();
    end = p.prev_end;
    Ok(ImportName(
        name: name,
        exported: exported,
        span: p.span_from(m.start),
        leading: m.leading,
        trailing: p.claim_trailing(end),
    ));
}

decl_value = (
    p            :: Parser,
    m            : Mark,
    names        : Vec<ImportName>,
    tparams      : Vec<TParam>,
    written      : Res<TypeId>,
    mutable      : bool,
    module_level : bool
) Res<Decl, AllocError> {
    head = p.head_name(names);
    (names.len > 1).match({
        true  => p.import_decl(m, names),
        false => p.value_shape(module_level).match({
            StructValue => p.struct_decl(m, head, tparams),
            EnumValue   => p.enum_decl(m, head, tparams),
            FnValue     => p.fn_decl(m, head, tparams, mutable),
            PathValue   => p.import_decl(m, names),
            AliasValue  => p.alias_decl(m, head, tparams),
            ExprValue   => p.const_decl(m, head, written, mutable),
        }),
    });
}

head_name = (p: Parser, names: Vec<ImportName>) ImportName {
    names.get(0).match({
        Ok(n) => n,
        None  => ImportName(
            name: Ident(text: "", span: p.here_span()),
            exported: false,
            span: p.here_span(),
            leading: no_trivia(),
            trailing: no_trivia(),
        ),
    });
}

struct_decl = (
    p       :: Parser,
    m       : Mark,
    head    : ImportName,
    tparams : Vec<TParam>
) Res<Decl, AllocError> {
    body_start = p.here();
    members ::= p.alloc.Vec<Member>();
    p.struct_members(members).try();
    p.add_decl(DeclKind.Struct(Struct(
        name: head.name,
        exported: head.exported,
        tparams: tparams,
        members: members,
        body_span: p.span_from(body_start),
    )), m);
}

// The leading bar is retained so one-variant enums round-trip faithfully.
enum_decl = (
    p       :: Parser,
    m       : Mark,
    head    : ImportName,
    tparams : Vec<TParam>
) Res<Decl, AllocError> {
    bar = p.at_kind(TokenKind.Bar).match({
        true  => p.bar_span(),
        false => Ok(None),
    }).try();
    variants ::= p.alloc.Vec<Variant>();
    variants.add(p.one_variant().try()).try();
    // Diagnose a trailing `|` at the bar rather than at the next declaration.
    running ::= p.at_kind(TokenKind.Bar);
    running.loop((h) {
        at_bar = p.here_span();
        p.bump().try();
        another = p.at_kind(TokenKind.Ident);
        another.match({
            true  => { variants.add(p.one_variant().try()).try(); p.nothing() },
            false => p.error_at(
                "expected variant: a `|` promises another one",
                at_bar
            ),
        }).try();
        running = another && p.at_kind(TokenKind.Bar);
    });
    p.add_decl(DeclKind.Enum(Enum(
        name: head.name,
        exported: head.exported,
        tparams: tparams,
        variants: variants,
        leading_bar: bar,
    )), m);
}

bar_span = (p :: Parser) Res<Res<Span>, AllocError> {
    span = p.here_span();
    p.bump().try();
    Ok(Ok(span));
}

// Variants accept at most one type payload.
one_variant = (p :: Parser) Res<Variant, AllocError> {
    m       = p.open();
    name    = p.ident("expected a variant name").try();
    payload = p.at_kind(TokenKind.ParenOpen).match({
        true  => p.variant_payload(),
        false => Ok(None),
    }).try();
    end     = p.prev_end;
    Ok(Variant(
        name: name,
        payload: payload,
        span: p.span_from(m.start),
        leading: m.leading,
        trailing: p.claim_trailing(end),
    ));
}

variant_payload = (p :: Parser) Res<Res<TypeId>, AllocError> {
    open = p.here_span();
    p.bump().try();
    t = p.type().try();
    p.expect_close(
        TokenKind.ParenClose,
        "unclosed `(`: this variant's payload is never closed",
        open
    ).try();
    Ok(Ok(t));
}

fn_decl = (
    p       :: Parser,
    m       : Mark,
    head    : ImportName,
    tparams : Vec<TParam>,
    mutable : bool
) Res<Decl, AllocError> {
    f = p.fn_value(head.name, head.exported, tparams, mutable).try();
    p.add_decl(DeclKind.Function(f), m);
}

// `form` records `=` versus `::=`; `body` records whether a body was written.
fn_value* = (
    p          :: Parser,
    name       : Ident,
    exported   : bool,
    tparams    : Vec<TParam>,
    rebindable : bool
) Res<Function, AllocError> {
    own ::= p.alloc.Vec<TParam>();
    p.at_kind(TokenKind.Lt).match({
        true  => p.type_params(own),
        false => p.nothing(),
    }).try();
    ps ::= p.alloc.Vec<Param>();
    span = p.params_list(ps).try();
    p.typed_params(ps).try();
    ret  = p.ret_ahead().match({
        true  => p.written_type(),
        false => Ok(None),
    }).try();
    body = p.at_kind(TokenKind.BraceOpen).match({
        true  => p.fn_body(),
        false => Ok(None),
    }).try();
    Ok(Function(
        name: name,
        exported: exported,
        form: form_of(rebindable, p.has_body(body)),
        tparams: p.merge_tparams(tparams, own),
        params: ps,
        params_span: span,
        ret: ret,
        body: body,
    ));
}

// Declaration parameters require written types; closures may infer them.
typed_params = (p :: Parser, ps: Vec<Param>) Res<(), AllocError> {
    ps.loop((h, param) {
        param.type.match({
            Ok(_) => p.nothing(),
            None  => p.error_at(
                "a declaration's parameter needs a type: only a closure infers its parameter types",
                param.span
            ),
        }).try();
    });
    Ok(());
}

fn_body = (p :: Parser) Res<Res<BlockId>, AllocError> {
    b = p.body_block().try();
    Ok(Ok(b));
}

has_body = (p: Parser, body: Res<BlockId>) bool {
    body.match({
        Ok(_) => true,
        None  => false,
    });
}

form_of = (rebindable: bool, body: bool) Form {
    rebindable.match({
        true  => body.match({
            true  => Form.Default,
            false => Form.Hook,
        }),
        false => body.match({
            true  => Form.Sealed,
            false => Form.Required,
        }),
    });
}

merge_tparams = (p: Parser, head: Vec<TParam>, own: Vec<TParam>) Vec<TParam> {
    (head.len == 0).match({
        true  => own,
        false => head,
    });
}

alias_decl = (
    p       :: Parser,
    m       : Mark,
    head    : ImportName,
    tparams : Vec<TParam>
) Res<Decl, AllocError> {
    target = p.type().try();
    p.add_decl(DeclKind.Alias(Alias(
        name: head.name,
        exported: head.exported,
        tparams: tparams,
        target: target,
    )), m);
}

import_decl = (
    p     :: Parser,
    m     : Mark,
    names : Vec<ImportName>
) Res<Decl, AllocError> {
    module_name = p.qualified_name().try();
    p.add_decl(DeclKind.Import(Import(names: names, module: module_name)), m);
}

const_decl = (
    p       :: Parser,
    m       : Mark,
    head    : ImportName,
    written : Res<TypeId>,
    mutable : bool
) Res<Decl, AllocError> {
    value = p.expr().try();
    p.add_decl(DeclKind.Const(Const(
        name: head.name,
        exported: head.exported,
        mutable: mutable,
        type: written,
        value: value,
    )), m);
}

add_decl* = (p :: Parser, kind: DeclKind, m: Mark) Res<Decl, AllocError> {
    end = p.prev_end;
    Ok(Decl(
        kind: kind,
        span: p.span_from(m.start),
        leading: m.leading,
        trailing: p.claim_trailing(end),
    ));
}
