// TWO ENUMS SHARE VARIANT NAMES; THE PAYLOADS DIFFER, AND SO DO THE
// POSITIONS. `Hit` sits at index 1 of Darts carrying an i64, and index 0
// of Pixels carrying a u8. Matching a value of one by the other's layout
// is C the compiler accepts without a word -- both tags are ints of the
// right shape, so the only symptom is an arm taking another arm's value,
// or a u8 printed where the i64 was bound.
//
// The payloads sit at the OPPOSITE ends of their width: 4000000000 needs
// all 32 bits an i64 keeps and a truncated carrier drops silently, while
// 200 fits a byte. A backend that confuses the enums prints one of:
// dart 200 (member swapped), pixel 0 or pixel 112 (i64 read one byte at a
// time) -- plausible numbers, quietly wrong.

Darts  = Miss | Hit(i64)
Pixels = Hit(u8) | Miss

main = (env: Env) Res<i32, AllocError> {
    d: Darts  = Darts.Hit(4000000000);
    p: Pixels = Pixels.Hit(200);

    d.match({
        Hit(v) => println("dart {}", v),
        Miss   => println("dart missed"),
    });
    p.match({
        Hit(v) => println("pixel {}", v),
        Miss   => println("pixel missed"),
    });
    Ok(0);
}
