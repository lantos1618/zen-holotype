// Range recognition and pass lowering. Concrete Range values store start/end;
// bound implementations supply start/end expressions and optionally at. None
// from at ends the walk. Bounds are recognized structurally, and synthesized
// at calls inline the impl body with parameters bound to emitted C text.

ExprId, Lambda = std.ast
Function = std.ast
Impl, Member, Field, Struct = std.ast
AllocError = std.mem
Vec = std.collections
str, String = std.text
DeclId, ImplId = sema.sema_id
TyId, TyNamed, TyArray, Prim = sema.sema_ty
Def = sema.sema_def
Ctx = sema.sema_check
self_ctx = sema.sema_member
impl_bound_type = sema.sema_supply
sym_local, sym_member, sym_variant = gen.gen_name
RES_PATH = gen.gen_name
CBackend = gen.gen_c.gen_c_state
unsupported = gen.gen_c.gen_c_report
declarator, declared_ret, struct_decl, res_value, is_res = gen.gen_c.gen_c_type
intern_res_open, recv_inst, sub_with = gen.gen_c.gen_c_mono
enter_struct_tparams, leave_tparams = gen.gen_c.gen_c_mono
Dest, block, deliver = gen.gen_c.gen_c_stmt
write_label, open_result, close_pass = gen.gen_c.gen_c_loop
Shape = gen.gen_c.gen_c_shape
run_body, declare_usize, settle_res, walk_temp = gen.gen_c.gen_c_loop
no_fold = gen.gen_c.gen_c_fold
array_of = gen.gen_c.gen_c_array
impl_field = gen.gen_c.gen_c_impl

// A range that stores its bounds.

// Whether the range's own declaration STORES `start` and `end` rather
// than supplying them through an impl. `Range(0, n)` does; a `Vec` does
// not, and reading `v.zg_mstart` off one would name a member that is
// not there. C would catch it, which is exactly the outcome a backend
// may not produce — so it is a refusal with a position instead.
supplies_bounds* = (be :: CBackend, rty: TyId) bool {
    be.has_field(rty, "start") && be.has_field(rty, "end")
}

has_field = (be :: CBackend, rty: TyId, name: str) bool {
    be.check.types.at(rty).match({
        Named(n) => be.decl_has_field(n.decl, name),
        _        => false,
    })
}

decl_has_field = (be :: CBackend, decl: DeclId, name: str) bool {
    struct_decl(be, decl).match({
        None  => false,
        Ok(s) => struct_has_field(s, name),
    })
}

struct_has_field = (s: Struct, name: str) bool {
    got ::= false;
    s.members.loop((h, m) {
        // STORAGE, not a name: a const or method called `start` is not
        // a field to read `zg_mstart` off, so this stays Field-only on
        // purpose — `m.named` would widen it.
        m.kind.match({
            Field(fl) => fl.name.text.eq(name).then(() { got = true; }),
            _         => (),
        });
    });
    got
}

// A range whose impl supplies computed bounds and an optional at function.

RangeImpl* = {
    decl*: DeclId,      // the RECEIVER's declaration, whose parameters
                        // the impl borrows
    mi*: usize,         // the module the type and its impls live in
    start*: ExprId,
    end*: ExprId,
    at*: Res<Function>,
}

range_impl* = (be :: CBackend, rty: TyId) Res<Res<RangeImpl>, AllocError> {
    be.check.types.at(rty).match({
        Named(n) => be.named_range_impl(n),
        Prim(p)  => be.primitive_range_impl(p),
        _        => Ok(None),
    })
}

// Primitive impls live on the prelude declaration of their spelling, just as
// ordinary member lookup and bound checking already define. Range lowering
// must use that same ownership rule: `str.impl(Range<u8>, ..)` is not less of
// an impl merely because `str` has a built-in C representation.
primitive_range_impl = (be :: CBackend, p: Prim)
                       Res<Res<RangeImpl>, AllocError> {
    defs ::= be.alloc.Vec<Def>();
    be.check.world.prelude_of(p.name, defs).try();
    defs.get(0).match({
        None    => Ok(None),
        Ok(def) => be.named_range_impl(TyNamed(
            decl: def.id,
            name: p.name,
            args: be.alloc.Vec<TyId>()
        )),
    })
}

named_range_impl = (be :: CBackend, n: TyNamed)
                   Res<Res<RangeImpl>, AllocError> {
    ids ::= be.alloc.Vec<ImplId>();
    be.check.world.impls_named(be.tree, n.name, ids).try();
    found ::= be.alloc.Vec<RangeImpl>();
    ids.loop((h, i) { be.keep_range_impl(n, i, found).try() });
    Ok(found.get(0));
}

// Only impls in the type's declaring module belong to the type.
keep_range_impl = (
    be  :: CBackend,
    n   : TyNamed,
    i   : ImplId,
    out :: Vec<RangeImpl>
) Res<(), AllocError> {
    (n.decl.module == i.decl.module).match({
        false => Ok(()),
        true  => be.range_impl_at(n, i, out),
    })
}

range_impl_at = (
    be  :: CBackend,
    n   : TyNamed,
    i   : ImplId,
    out :: Vec<RangeImpl>
) Res<(), AllocError> {
    be.check.world.impl_at(be.tree, i).match({
        Ok(im) => be.keep_if_range(n, im, out),
        None   => Ok(()),
    })
}

keep_if_range = (
    be  :: CBackend,
    n   : TyNamed,
    im  : Impl,
    out :: Vec<RangeImpl>
) Res<(), AllocError> {
    mi    = n.decl.module.to_usize();
    bound = be.check.impl_bound_type(im, mi).try();
    be.supplies_bounds(bound).match({
        false => Ok(()),
        true  => be.add_range_impl(n, im, mi, out),
    })
}

// An impl that names the bound and supplies neither `start` nor `end`
// is not one to walk: `impl_field` finds nothing and the search moves
// on rather than emitting a bound nothing wrote.
add_range_impl = (
    be  :: CBackend,
    n   : TyNamed,
    im  : Impl,
    mi  : usize,
    out :: Vec<RangeImpl>
) Res<(), AllocError> {
    lo = be.impl_field(im, "start").try();
    lo.match({
        None  => Ok(()),
        Ok(s) => be.add_from_start(n, im, mi, s, out),
    })
}

add_from_start = (
    be  :: CBackend,
    n   : TyNamed,
    im  : Impl,
    mi  : usize,
    s   : ExprId,
    out :: Vec<RangeImpl>
) Res<(), AllocError> {
    hi = be.impl_field(im, "end").try();
    at = be.impl_fn(im, "at").try();
    hi.match({
        None  => Ok(()),
        Ok(e) => out.add(RangeImpl(
            decl: n.decl,
            mi: mi,
            start: s,
            end: e,
            at: at
        )),
    })
}

// The function an impl supplies under `name`, with a body. A required
// member — `at ::= (..) Res<T>` with no body — is what the impl OWES
// rather than what it supplies.
impl_fn = (be :: CBackend, im: Impl, name: str)
          Res<Res<Function>, AllocError> {
    found ::= be.alloc.Vec<Function>();
    im.members.loop((h, m) { keep_bodied_fn(m, name, found).try() });
    Ok(found.get(0));
}

keep_bodied_fn = (m: Member, name: str, out :: Vec<Function>)
                 Res<(), AllocError> {
    m.named(name).match({
        false => Ok(()),
        true  => add_bodied_fn(m, out),
    })
}

add_bodied_fn = (m: Member, out :: Vec<Function>) Res<(), AllocError> {
    m.kind.match({
        Function(f) => add_if_bodied(f, out),
        _           => Ok(()),
    })
}

add_if_bodied = (f: Function, out :: Vec<Function>) Res<(), AllocError> {
    f.body.match({ Ok(_) => out.add(f), None => Ok(()) })
}

// Pass type shared by loop typing, lowering, and range-bound settlement.

// The `Res<T>` a pass of this range produces: a `usize` that cannot
// miss for a range walking its own index space, and whatever `at`
// returns — `None` included — for one an impl supplies.
range_pass_type* = (be :: CBackend, rty: TyId) Res<Res<TyId>, AllocError> {
    be.array_of(rty).match({
        Ok(a) => be.array_pass(a),
        None  => be.stored_or_supplied_pass(rty),
    })
}

// A FIXED ARRAY'S PASS CANNOT MISS. Its `at` is the bounds-checked index
// and the counter never leaves the count, so a pass is always the
// element — which is what lets the walk carry no `Res` per pass and stay
// a plain C for-loop. The `Res` here is the LOOP's own answer, not the
// pass's.
array_pass = (be :: CBackend, a: TyArray) Res<Res<TyId>, AllocError> {
    got = intern_res_open(be.check, a.elem).try();
    Ok(Ok(got));
}

stored_or_supplied_pass = (be :: CBackend, rty: TyId)
                          Res<Res<TyId>, AllocError> {
    be.supplies_bounds(rty).match({
        true  => be.index_pass(),
        false => be.impl_pass(rty),
    })
}

index_pass = (be :: CBackend) Res<Res<TyId>, AllocError> {
    usize_ty = be.check.types.prim("usize").try();
    got      = intern_res_open(be.check, usize_ty).try();
    Ok(Ok(got));
}

impl_pass = (be :: CBackend, rty: TyId) Res<Res<TyId>, AllocError> {
    be.range_impl(rty).try().match({
        None   => Ok(None),
        Ok(ri) => be.at_pass(rty, ri),
    })
}

// An impl supplying no `at` walks its own index space, which is exactly
// what `range.zen` says the hook being optional means.
at_pass = (be :: CBackend, rty: TyId, ri: RangeImpl)
          Res<Res<TyId>, AllocError> {
    ri.at.match({
        None  => be.index_pass(),
        Ok(f) => be.at_ret(rty, ri, f),
    })
}

// `at`'s declared return type with `@Self` bound to the receiver and
// the TYPE's parameters in scope, then the receiver's own arguments
// substituted in — the same three steps `method_sig` takes for a
// parameter, because `at` IS a member of the receiver.
at_ret = (be :: CBackend, rty: TyId, ri: RangeImpl, f: Function)
         Res<Res<TyId>, AllocError> {
    sctx     = be.check.self_ctx(ri.mi, rty).try();
    inst     = be.recv_inst(rty).try();
    mark     = be.enter_struct_tparams(ri.decl).try();
    declared = be.declared_ret(f, sctx).try();
    be.leave_tparams(mark).try();
    got = be.sub_with(declared, inst).try();
    Ok(be.keep_res(got));
}

keep_res = (be :: CBackend, got: TyId) Res<TyId> {
    be.check.types.at(got).match({
        Res(_) => Ok(got),
        _      => None,
    })
}

// The element itself — the `Ok` payload of what a pass produces.
range_element_type* = (be :: CBackend, rty: TyId)
                      Res<Res<TyId>, AllocError> {
    got = be.range_pass_type(rty).try();
    Ok(got.match({
        Ok(t) => be.res_value(t),
        None  => None,
    }));
}

// A range whose `start` and `end` an impl supplies — a `Vec`.
lower_supplied* = (
    be   :: CBackend,
    id   : ExprId,
    sh   : Shape,
    one  : ExprId,
    rty  : TyId,
    lam  : Lambda,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    be.range_impl(rty).try().match({
        None   => be.unsupported(
            id,
            "a loop over a range whose bounds an impl supplies",
            out
        ),
        Ok(ri) => be.lower_impl_range(
            id,
            sh,
            one,
            rty,
            ri,
            lam,
            ctx,
            want,
            out
        ),
    })
}

lower_impl_range = (
    be   :: CBackend,
    id   : ExprId,
    sh   : Shape,
    one  : ExprId,
    rty  : TyId,
    ri   : RangeImpl,
    lam  : Lambda,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    be.range_pass_type(rty).try().match({
        None     => be.unsupported(
            id,
            "a loop over a range whose element nothing settles",
            out
        ),
        Ok(pass) => lower_impl_walk(
            be,
            id,
            sh,
            one,
            rty,
            ri,
            pass,
            lam,
            ctx,
            want,
            out
        ),
    })
}

// Impl bounds may spill, so evaluate them into usize locals with self bound to
// the range temporary. A non-Ok at result exits through the loop break label.
lower_impl_walk = (
    be   :: CBackend,
    id   : ExprId,
    sh   : Shape,
    one  : ExprId,
    rty  : TyId,
    ri   : RangeImpl,
    pass : TyId,
    lam  : Lambda,
    ctx  : Ctx,
    want : TyId,
    out  :: String
)
                  Res<(), AllocError> {
    elem    = be.res_value(pass).match({ Ok(t) => t, None => pass });
    settled = be.settle_res(want, elem).try();

    rng = be.walk_temp(one, rty, ctx).try();

    st = be.open_result(settled, out).try();
    counter ::= be.fresh_name("i").try();
    base    ::= be.fresh_name("b").try();
    limit   ::= be.fresh_name("n").try();
    be.declare_usize(counter.view()).try();
    be.declare_usize(base.view()).try();
    be.declare_usize(limit.view()).try();
    be.supplied_bound(ri, rty, ri.start, counter.view(), rng.view()).try();
    be.supplied_bound(ri, rty, ri.end, limit.view(), rng.view()).try();
    be.fmt("{} = {};\n", base.view(), counter.view()).try();

    be.fmt("while ({} < {}) {\n", counter.view(), limit.view()).try();
    be.indent();
    value ::= be.alloc.String().try();
    be.take_pass(
        ri,
        rty,
        pass,
        counter.view(),
        st.brk,
        rng.view(),
        value
    ).try();
    be.run_body(
        sh,
        lam,
        counter.view(),
        base.view(),
        value.view(),
        elem,
        be.no_fold().try(),
        ctx
    ).try();
    be.close_pass(st, counter.view(), be.no_fold().try()).try();
    Ok(());
}

// Lower an impl-supplied range in pass order.
// The impl's `self`, bound to the range temporary. An ordinary local
// holding a copy: the walk reads the range and never writes it, so
// there is nothing to write through and no address to take.
// Bind the impl receiver only while lowering its expressions so it cannot
// shadow an enclosing self in the loop body.
bind_self = (be :: CBackend, ri: RangeImpl, rty: TyId, rng: str)
            Res<(), AllocError> {
    be.bind_text(be.self_name(ri), rty, rng)
}

// What the impl calls its receiver. Read off `at`'s own first parameter
// rather than assumed to be `self`, because `start: self.len` and
// `at ::= (self: @Self, ..)` name it in one place and the declaration
// is that place.
self_name = (be :: CBackend, ri: RangeImpl) str {
    ri.at.match({ Ok(f) => first_param_name(f), None => "self" })
}

first_param_name = (f: Function) str {
    f.params.get(0).match({ Ok(p) => p.name.text, None => "self" })
}

// A name bound to C TEXT rather than to an expression node: `self` is a
// temporary this file wrote and the counter is a local it declared, and
// neither of them is an AST node to lower.
bind_text* = (be :: CBackend, name: str, ty: TyId, text: str)
            Res<(), AllocError> {
    n = be.declare(name, ty, false).try();
    be.check.bind(name, ty, false, false).try();
    cname ::= be.alloc.String().try();
    sym_local(cname, name, n).try();
    decl ::= be.alloc.String().try();
    be.declarator(ty, cname.view(), decl).try();
    be.fmt("{} = {text};\n", decl.view())
}

// `start: 0` and `end: self.len`, evaluated in the module that wrote
// the impl with `@Self` bound to the receiver and the receiver's own
// type arguments in force.
supplied_bound* = (
    be     :: CBackend,
    ri     : RangeImpl,
    rty    : TyId,
    value  : ExprId,
    target : str,
    rng    : str
) Res<(), AllocError> {
    usize_ty = be.check.types.prim("usize").try();
    ictx     = be.impl_ctx(ri, usize_ty, rty);
    inst     = be.recv_inst(rty).try();
    held     = be.inst;
    be.enter_inst(inst);
    mark  = be.enter_struct_tparams(ri.decl).try();
    cmark = be.check.mark();
    lmark = be.mark();
    be.bind_self(ri, rty, rng).try();
    be.deliver(value, ictx, usize_ty, Dest.Into(target)).try();
    be.release(lmark).try();
    be.check.release(cmark).try();
    be.leave_tparams(mark).try();
    be.enter_inst(held);
    Ok(());
}

// A body in the impl's module with `@Self` bound. `self_body_ctx` says
// the same thing for a member function; it is three fields, and reading
// them out of `gen_c_decl.zen` would point this file at the one that
// already points back at it.
impl_ctx = (be :: CBackend, ri: RangeImpl, ret: TyId, self_ty: TyId) Ctx {
    Ctx(
        module: ri.mi,
        ret: ret,
        has_ret: is_res(be, ret),
        self_ty: self_ty,
        has_self: true
    )
}

// ONE PASS: `at(i)`, and the tag that ends the walk.
// `value` is left holding the C text of the `Ok` payload, which is what
// `run_body` binds the body's second parameter to. A range with no `at`
// hands out its own index, and then the counter IS the payload.
take_pass* = (
    be      :: CBackend,
    ri      : RangeImpl,
    rty     : TyId,
    pass    : TyId,
    counter : str,
    brk     : usize,
    rng     : str,
    value   :: String
)
            Res<(), AllocError> {
    ri.at.match({
        None  => value.add(counter),
        Ok(f) => be.run_at(ri, rty, pass, f, counter, brk, rng, value),
    })
}

run_at = (
    be      :: CBackend,
    ri      : RangeImpl,
    rty     : TyId,
    pass    : TyId,
    f       : Function,
    counter : str,
    brk     : usize,
    rng     : str,
    value   :: String
)
         Res<(), AllocError> {
    tmp  ::= be.fresh_name("a").try();
    decl ::= be.alloc.String().try();
    be.declarator(pass, tmp.view(), decl).try();
    be.fmt("{};\n", decl.view()).try();
    be.inline_at(ri, rty, pass, f, counter, rng, tmp.view()).try();
    be.write_pass_guard(tmp.view(), brk).try();
    value.fmt("{}.zg_data.", tmp.view()).try();
    sym_member(value, "Ok")
}

// The `at` body, in the frame the loop is being written into. Its two
// parameters are C text this file already wrote, so they are bound
// directly rather than lowered from arguments that do not exist.
inline_at = (
    be      :: CBackend,
    ri      : RangeImpl,
    rty     : TyId,
    pass    : TyId,
    f       : Function,
    counter : str,
    rng     : str,
    tmp     : str
)
            Res<(), AllocError> {
    usize_ty = be.check.types.prim("usize").try();
    ictx     = be.impl_ctx(ri, pass, rty);
    inst     = be.recv_inst(rty).try();
    held     = be.inst;
    be.enter_inst(inst);
    mark  = be.enter_struct_tparams(ri.decl).try();
    cmark = be.check.mark();
    lmark = be.mark();
    be.bind_self(ri, rty, rng).try();
    be.bind_index_param(f, usize_ty, counter).try();
    be.enter_call();
    be.run_at_body(f, ictx, pass, tmp).try();
    be.leave_call();
    be.release(lmark).try();
    be.check.release(cmark).try();
    be.leave_tparams(mark).try();
    be.enter_inst(held);
    Ok(());
}

// Parameter one of `at`. Parameter zero is the receiver and is already
// bound for the whole walk.
bind_index_param = (
    be       :: CBackend,
    f        : Function,
    usize_ty : TyId,
    counter  : str
) Res<(), AllocError> {
    f.params.get(1).match({
        None  => Ok(()),
        Ok(p) => be.bind_text(p.name.text, usize_ty, counter),
    })
}

run_at_body = (be :: CBackend, f: Function, ictx: Ctx, pass: TyId, tmp: str)
              Res<(), AllocError> {
    f.body.match({
        None    => Ok(()),
        Ok(blk) => block(be, blk, ictx, pass, Dest.Into(tmp)),
    })
}

// A pass that missed ends the walk, through `h.break`'s own label so it
// lands after the closing brace and not inside whatever construct the
// body opened.
write_pass_guard = (be :: CBackend, tmp: str, brk: usize)
                   Res<(), AllocError> {
    tag ::= be.alloc.String().try();
    sym_variant(tag, RES_PATH, "Ok").try();
    be.fmt("if ({tmp}.zg_tag != {}) { goto ", tag.view()).try();
    be.write_label("brk", brk).try();
    be.writeln("; }")
}
