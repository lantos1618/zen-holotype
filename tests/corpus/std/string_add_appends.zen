// tests/corpus/std/string_add_appends.zen
// add appends, it does not replace: String IS the buffer, and it
// grows through the Vec<u8> it is. the format arguments are filled
// in order

Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    alloc ::= env.mem.alloc();
    sb ::= alloc.String("").try();

    sb.add("{} is {}", "ada", 36).try();
    sb.add(" and ").try();
    sb.add("{} is {}", "grace", 45).try();

    println("{}", sb.view());
    println("len {}", sb.view().len);
    Ok(0);
}
