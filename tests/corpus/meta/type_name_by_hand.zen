// M3'S GATE, THE BY-HAND HALF (`docs/design_meta.md` §7, M3): the same
// program as `type_name_via_meta` with the one `@meta` line written out
// by hand — no `@meta` anywhere. The two share one byte-identical
// `.expected`, and the pair failing to agree is exactly the differential
// signal `@meta` otherwise cannot get (§6.3).
//
// run.py has no shared-expectation spelling — a single-file test is
// `<name>.zen` plus `<name>.expected` under the SAME basename — so the
// "one shared .expected" M3 asks for is two files with the same bytes.

Point = {
    x: i64,
    y: i64,

    type_name* = (self: @Self) str { "Point" },
}

main = (env: Env) Res<i32, AllocError> {
    p      = Point(x: 1, y: 2);
    n: str = p.type_name();
    println("{} {}", n, n.len);
    Ok(0);
}
