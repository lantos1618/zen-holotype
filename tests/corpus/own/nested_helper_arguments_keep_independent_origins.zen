Box = { text :: str }
Input = { text: str, scratch: str }
Envelope = { input: Input, other: str }
read = (envelope: Envelope) str { envelope.input.text }
put = (box :: Box, input: Input) () {
    envelope = Envelope(input: input, other: "static");
    box.text = read(envelope);
}
fill = (env: Env, box :: Box) Res<(), AllocError> {
    a    = env.mem.alloc();
    text = a.String("temporary").try();
    put(box, Input(text: "caller", scratch: text.view()));
    Ok(())
}
main = (env: Env) Res<(), AllocError> {
    box ::= Box(text: "");
    fill(env, box).try();
    println(box.text);
    Ok(())
}
