//! link: c, zenrt
// std.sys.os — thin wrappers over the process environment and command line.
//
// argv reaches Zen through zenrt.c: the OS `main(argc,argv)` (in zenrt) stashes them into globals,
// and `zen_argc`/`zen_argv_at` (also in zenrt) expose them here. Explicit calls, never ambient —
// `main` chooses to read them.
//
// Two ways to read argv: point reads (`argc()` / `arg(i)`) for a quick scan, or `args(a)` for the
// whole vector as one allocator-owned `[StringView]` you can index/iterate. The `has_flag` / `flag_str`
// helpers are the minimal flag reader: exact-token match on argv, no allocation, no parser state —
// the caller passes the full token (`os.has_flag("--verbose")`, `os.flag_str("--out")`). A typed
// `parse(a, T)` / positional collector is a later wave (see the tail of this file).
{ clock_gettime, getenv } = std.c.libc
{ AllocatorBackend, heap_acquire } = std.mem.alloc
{ Result, IoError } = std.core.result
// bound to zenrt.c (bodyless = foreign).
zen_argc = () i32
zen_argv_at = (i: i32) StringView
// libc environment mutators (POSIX). getenv still funnels through std.c.libc; setenv/unsetenv are
// declared foreign here, alongside argv's zenrt hooks. Both return 0 on success, -1 on failure —
// `int setenv(const char *name, const char *value, int overwrite)`, `int unsetenv(const char *name)`.
setenv = (name: StringView, value: StringView, overwrite: i32) i32
unsetenv = (name: StringView) i32
// clock id 1 = CLOCK_MONOTONIC, in milliseconds — the one clock reading available inside the
// bootstrap closure (std.time.clock, which names the id, is not in the seed manifest and cannot be:
// its cell comes from std.mem.raw, whose `of*` collides with std.collections.map's under the flat
// namespace). The id stays a literal here for exactly that reason.
//
// The timespec cell is ONE per OS thread, allocated on first use and reused forever after: a reading
// must observe its subject, not move it, so a timing call must not allocate. `ts: [i64] = [0, 0]`
// looked like a stack cell and was not — a slice literal bound to a LOCAL is heap-promoted by the C
// backend (see gen_slicelit) and never freed, so every clock_ms leaked 16 bytes AND perturbed the
// very allocation sequence this comment says it must not. The cell here costs one acquire for the
// process (a null test per call) and leaks nothing. `thread_local` so two threads timing at once
// never share a timespec; the const `null_ptr()` init leaves a freshly spawned worker unset rather
// than pointing at the main thread's cell. A cell allocation that fails reads as 0 ms.
//
// It comes from `heap_acquire` — std.mem.alloc's canonical process-heap floor — and not from a bare
// `malloc`: raw allocation calls stay BEHIND the allocator floor, and tests/harness_boundaries.zen
// enforces that for every file under src/ but the allocator itself.
ts_cell ::= thread_local(null_ptr())
clock_ms* = () i64 {
    (ts_cell == null_ptr()).then({
        ts_cell = heap_acquire(null_ptr(), 16)
    })
    (ts_cell == null_ptr()).match ({
        true  => 0,
        false => {
            clock_gettime(1, ts_cell)
            load_i64(ts_cell) * 1000 + load_i64(ts_cell.offset(8)) / 1000000
        },
    })
}
argc* = () i32 { zen_argc() }    // os.argc()  — number of CLI args (incl. argv[0])
arg* = (i: i32) StringView { zen_argv_at(i) }    // os.arg(i)  — the i-th arg ("" if out of range)
getEnv* = (name: StringView) StringView {
    p = getenv(name)
    (p == null_ptr()).then({ "" }, { cstr(p) })
}    // "" if unset
// set_env(name, value): create/overwrite the variable. unset_env(name): remove it. Both return
// true on success (a clean bool over libc's 0/-1, the getEnv-style wrapping). The env owns the copy,
// so `value` need not outlive the call.
set_env* = (name: StringView, value: StringView) bool {
    (setenv(name, value, 1) == 0).then({ true }, { false })
}
unset_env* = (name: StringView) bool { (unsetenv(name) == 0).then({ true }, { false }) }
// copy each argv slot into `out[i..]` (the strings are argv-backed, stable for the process lifetime,
// so this borrows them — no per-string copy, only the backbone is owned).
fill_argv = (out: MutSlice<StringView>, i: i32, n: i32) void {
    (i < n).then({
        out[to_i64(i)] = zen_argv_at(i)
        fill_argv(out, i + 1, n)
    })
}
// args(a) — the whole command line as an allocator-owned `Result<[StringView], IoError>` (argv[0] = the
// program), so a caller indexes/iterates instead of threading argc()/arg(i) by hand. Allocation failure
// stays in the value flow: `try_acquire` fails as `.Err(.NotFound)` rather than handing back a null
// backbone that `fill_argv` would then write through (a write-to-null crash). On success the backbone is
// `a`-owned; the strings borrow argv (process-lifetime stable). Fail-fast roots close with
// `.expect("…")`; robust callers `.match` the `.Err`.
args* = (a: AllocatorBackend) Result<MutSlice<StringView>, IoError> {
    n = zen_argc()
    a.try_acquire(to_i64(n) * sizeof(StringView)).match ({
        .Ok(p)  => {
            buf: MutSlice<StringView> = slice(p, to_i64(n))
            fill_argv(buf, 0, n)
            .Ok(buf)
        },
        .Err(e) => .Err(e),
    })
}
// has_flag(tok): is the exact token `tok` present anywhere in argv? (e.g. os.has_flag("--verbose"))
flag_at = (tok: StringView, i: i32) bool {
    (i >= zen_argc()).match ({
        true  => false,
        false => (zen_argv_at(i) == tok).then({ true }, { flag_at(tok, i + 1) }),
    })
}
has_flag* = (tok: StringView) bool { flag_at(tok, 0) }
// flag_str(key): the argv token that follows the first exact `key` (the `--key value` shape), or ""
// when `key` is absent or is the last token (no value follows). (e.g. os.flag_str("--out"))
flag_str_at = (key: StringView, i: i32) StringView {
    (i + 1 >= zen_argc()).match ({
        true  => "",
        false => (zen_argv_at(i) == key).then({ zen_argv_at(i + 1) }, { flag_str_at(key, i + 1) }),
    })
}
flag_str* = (key: StringView) StringView { flag_str_at(key, 0) }
// FOLLOW-UP (later wave): `--key=value` splitting, a positional collector (`positionals(a) MutSlice<StringView>`),
// and a typed `parse(a, T)` that fills a struct of flags. Kept out here to stay small — has_flag /
// flag_str + args() cover `--flag`, `--key value`, and raw positionals via indexing today.
