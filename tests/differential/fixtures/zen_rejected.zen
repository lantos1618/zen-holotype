// Calls are accepted only when each argument has the declared parameter type.
takes_i32 = (value: i32) i32 { value }

main = (env: Env) Res<i32, AllocError> {
    (env.argv.len == 0).match({
        true  => Ok(takes_i32("not an integer")),
        false => Ok(takes_i32("not an integer")),
    })
}
