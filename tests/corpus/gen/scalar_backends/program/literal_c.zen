main = (env: Env) Res<i32, AllocError> {
    value = "\01\00\000\\01";
    println(
        "str {} {} {} {} {} {} {} {} {} {} {}",
        value.len,
        value[0],
        value[1],
        value[2],
        value[3],
        value[4],
        value[5],
        value[6],
        value[7],
        value[8],
        value[9]
    );
    a = env.mem.alloc();
    pattern ::= a.String().try();
    pattern.add('\0').try();
    pattern.add('1').try();
    println("match {}", pattern.view().match({ "\01" => true, _ => false }));
    sink ::= a.String().try();
    sink.fmt("\01{}\\01", 7).try();
    bytes = sink.view();
    println(
        "sink {} {} {} {} {} {} {}",
        bytes.len,
        bytes[0],
        bytes[1],
        bytes[2],
        bytes[3],
        bytes[4],
        bytes[5]
    );
    env.out.println("console:\01");
    Ok(0)
}
