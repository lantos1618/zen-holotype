// src/gen/gen_c/gen_c_mono.zen
// Monomorphisation: what the backend does with a type parameter.
//
// C has no generics, so a generic function is emitted ONCE PER DISTINCT
// SET OF TYPE ARGUMENTS, with the arguments in its mangled name.
// `sema_inst.zen` already answers what each parameter became, at a call
// site and a generic receiver both; this file is the three things a
// BACKEND has to do that sema does not:
//
//   - READ THE ANSWER BACK. `inst_at` is `Checker.resolved_inst` with the
//     empty instantiation for a miss, so a non-generic call and a generic
//     one go down one path.
//   - PUT THE PARAMETERS BACK IN SCOPE while a DECLARED type is read.
//     Sema resolves `(a: Alloc) Vec<T>` with `T` bound, then forgets;
//     the backend asks again later and must rebind it or `T` is an
//     undefined name. `enter_tparams` is that, always paired with
//     `leave_tparams`.
//   - REFUSE AN OPEN TYPE. A `Var` that reaches `tcode` mangles to one
//     letter, so two instantiations would become one symbol and `cc`
//     would silently pick whichever body it saw last. `has_var` is asked
//     before anything is emitted, and the fault names the function.
//
// Order is DECLARATION ORDER, nothing else: an `Inst` is two parallel
// lists filled from `tparams`, never a `Map`, so the `I` section of a
// symbol is a pure function of the instantiation — the property the
// fixpoint stands on.

Ast, Decl, DeclKind, Struct, Function, TParam, Member, ExprId = std.ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
DeclId = sema.sema_id
TyId, Ty, Types, TyNamed, TyRes = sema.sema_ty
World, Def, decl_at = sema.sema_def
Checker, Ctx = sema.sema_check
Inst, subst, has_var, inst_of_named, owner_of, zip = sema.sema_inst
tparam_vars = sema.sema_inst
CBackend = gen.gen_c.gen_c_state
ty_of = gen.gen_c.gen_c_expr

// ---------------------------------------------------------------------
// interning, through ONE field and never two
//
// ⚠ `be.check.types.named(..)` DOES NOT INTERN if reached through TWO
// field hops. The bootstrapper spills a `::` receiver reached that way
// into a temporary and calls the method on it, so the row lands in a
// copy of the store and the `TyId` handed back is one past the real
// store's end — which the next `Types.at` traps on, far from the cause.
// One hop (`c.types.named(..)` with `c :: Checker` a parameter) is
// correct, so every mutating store call in this folder goes through a
// helper taking the checker as its own parameter. Recorded with the
// emitted C in docs/GEN_BOOTSTRAP_FIXES.md.
// ---------------------------------------------------------------------

// The type a declaration NAMES, applied to `args`.
intern_named* = (c :: Checker, d: Def, args: Vec<TyId>)
                Res<TyId, AllocError> {
    c.types.named(d.id, d.qname, d.name, args)
}

// One type parameter of a declaration, as the `Ty.Var` sema interned.
intern_var* = (c :: Checker, name: str, owner: str) Res<TyId, AllocError> {
    c.types.var(name, owner)
}

// `Res<T>` — the one-argument form every loop word returns. Kept here
// rather than at the call site for the same one-hop interning reason
// as above.
intern_res_open* = (c :: Checker, value: TyId) Res<TyId, AllocError> {
    c.types.res_open(value)
}

// THE TYPE A CONSTRUCTION BUILDS, at this emission's instantiation.
//
// `Vec(data: .., cap: 0)` inside `Vec<T>`'s own constructor builds a
// `Vec<T>`, not a bare `Vec` — sema records exactly that, so the
// backend must agree or intern two different types under one name.
// The declaration's own parameters go in; the instantiation being
// lowered turns them into what this emission is at.
constructed* = (be :: CBackend, d: Def) Res<TyId, AllocError> {
    args ::= be.alloc.Vec<TyId>();
    decl_vars(be.check, d, args).try();
    raw = intern_named(be.check, d, args).try();
    sub(be, raw)
}

decl_vars = (c :: Checker, d: Def, out :: Vec<TyId>) Res<(), AllocError> {
    decl_at(c.tree, d.id).match({
        None  => Ok(()),
        Ok(x) => decl_vars_of(c, d, x, out),
    })
}

decl_vars_of = (c :: Checker, d: Def, x: Decl, out :: Vec<TyId>)
               Res<(), AllocError> {
    x.kind.match({
        Struct(s) => tparam_vars(c, s.tparams, d.qname, out),
        _         => Ok(()),
    })
}

// THE TYPE A DECLARATION NAMES AT ITS OWN PARAMETERS: `Vec<T>`, never
// `Vec<i32>`.
//
// Sema memoises an expression's type under its node ID and nothing
// else (`sema_inst.zen`: "a generic body is checked EXACTLY ONCE,
// generically, with its parameters as `Var`s"), so an answer computed
// inside `Vec<Row>.add` is the answer `Vec<u8>.add` gets back too. A
// body lowered at a CONCRETE `@Self` that wrote that answer straight
// into the memo once emitted `Vec<u8>.add` calling `Vec<Row>.grow` —
// caught by `cc`, but wouldn't be for two types of one width.
//
// So a generic body is read GENERICALLY and `sub` turns every answer
// into the one this emission is at, making true what `ty_of`'s header
// promises.
open_named* = (be :: CBackend, decl: DeclId) Res<Res<TyId>, AllocError> {
    decl_at(be.tree, decl).match({
        None  => Ok(None),
        Ok(x) => open_named_decl(be, decl, x),
    })
}

open_named_decl = (be :: CBackend, decl: DeclId, x: Decl)
                  Res<Res<TyId>, AllocError> {
    x.kind.match({
        Struct(s) => open_struct_named(be, decl, s),
        _         => Ok(None),
    })
}

open_struct_named = (be :: CBackend, decl: DeclId, s: Struct)
                    Res<Res<TyId>, AllocError> {
    owner = owner_of(be.check, decl.module.to_usize(), s.name.text).try();
    args ::= be.alloc.Vec<TyId>();
    tparam_vars(be.check, s.tparams, owner, args).try();
    Ok(Ok(named_at(be.check, decl, owner, s.name.text, args).try()));
}

named_at = (c :: Checker, decl: DeclId, qname: str, name: str,
            args: Vec<TyId>) Res<TyId, AllocError> {
    c.types.named(decl, qname, name, args)
}

// ---------------------------------------------------------------------
// reading the answer back
// ---------------------------------------------------------------------

// What this call instantiated its callee at. The empty instantiation
// when sema recorded nothing, which is what every non-generic call is —
// so a caller never has to ask whether the callee was generic first.
inst_at* = (be :: CBackend, id: ExprId) Res<Inst, AllocError> {
    be.check.resolved_inst(id).match({
        Ok(i) => Ok(i),
        None  => Ok(be.alloc.Inst()),
    })
}

// The instantiation a generic RECEIVER carries: `Vec<GenDiag>` binds
// `Vec`'s own `T`, which is what makes `v.add(x)` a call on the row type
// the receiver actually holds.
recv_inst* = (be :: CBackend, rty: TyId) Res<Inst, AllocError> {
    be.check.types.at(rty).match({
        Named(n) => be.check.inst_of_named(n),
        _        => Ok(be.alloc.Inst()),
    })
}

// A method of `Vec<T>` is generic in `T` whether or not it declares
// parameters of its own — so the receiver's instantiation IS the
// method's. A method that ALSO declares its own parameters would need
// the two concatenated; that half is unwritten (nothing in this tree
// declares one), and `refuse_method` names it rather than guessing.

// ---------------------------------------------------------------------
// substituting
// ---------------------------------------------------------------------

// A type read out of sema, in terms of the instantiation being lowered.
//
// EVERY TYPE THE BACKEND READS GOES THROUGH HERE. Sema checks a generic
// body exactly once, generically ("one mistake, one diagnostic"), so
// every answer inside `Vec<T>.add` is about `T` — the backend is the
// one that knows this emission is the `i32` one.
sub* = (be :: CBackend, ty: TyId) Res<TyId, AllocError> {
    subst(be.check, ty, be.inst)
}

// The same, against an instantiation that is not the current one: a call
// site substitutes into the CALLEE's declared types, which are in the
// callee's parameters and not in the caller's.
sub_with* = (be :: CBackend, ty: TyId, inst: Inst) Res<TyId, AllocError> {
    subst(be.check, ty, inst)
}

// "IS THIS TYPE STILL OPEN", ASKED OF EVERY EMPTY SLOT AND NOT ONLY OF
// A FREE PARAMETER. (It read "THE SAME QUESTION" while `has_var`'s
// one-line wrapper stood here; the wrapper went, and `sub_with` above
// asks nothing.)
//
// `gen_name.tcode` writes ONE letter — `q` — for a `Var`, `Infer`, and
// `Unknown` alike, since none of the three names a type C could be
// handed. `has_var` asks about the first only, because it was written for
// symbol collision between two INSTANTIATIONS — narrower than "can this
// be spelled". `Res<Ptr<Unknown>, E>` is the gap: no `Var` in it, so
// `has_var` says settled, but a temporary declared at it is a C struct
// with an unresolved element `cc` rejects.
//
// The walk is `sema_inst.has_var`'s, one variant wider; kept here
// rather than beside it because the reason is a BACKEND one (what has a
// C spelling), and sema has no stake in it.
unsettled* = (be: CBackend, ty: TyId) bool {
    be.types().at(ty).match({
        Var(_)   => true,
        Infer    => true,
        Unknown  => true,
        Named(n) => any_unsettled(be, n.args),
        Res(r)   => unsettled(be, r.value) || unsettled(be, r.error),
        Fn(f)    => any_unsettled(be, f.params) || unsettled(be, f.ret),
        Union(u) => any_unsettled(be, u.members),
        Array(a) => unsettled(be, a.elem),
        _        => false,
    })
}

any_unsettled = (be: CBackend, list: Vec<TyId>) bool {
    Range(0, list.len).find((i) {
        list.get(i).match({ Ok(t) => unsettled(be, t), None => false })
    }).match({ Ok(_) => true, None => false })
}

// Is any of these types still open? `find` and not a loop, because the
// answer is a `bool` and the first one is enough.
any_open* = (be: CBackend, sig: Vec<TyId>) bool {
    Range(0, sig.len).find((i) {
        sig.get(i).match({ Ok(t) => has_var(be.check, t), None => false })
    }).match({ Ok(_) => true, None => false })
}

// Did this instantiation leave a parameter free? A free argument mangles
// to `q`, so two instantiations would be one symbol — the fault the
// header names, asked where there is a call to point at.
inst_open* = (be: CBackend, inst: Inst) bool {
    Range(0, inst.len()).find((i) {
        inst.arg_at(i).match({ Ok(t) => has_var(be.check, t), None => true })
    }).match({ Ok(_) => true, None => false })
}

// THE CALL'S INSTANTIATION, IN THE CALLER'S TERMS.
//
// Sema records what the CALLEE's parameters became, and inside a
// generic body that's often the CALLER's parameter: `Vec<T>.add`
// calling `alloc.realloc<T>(..)` instantiates `realloc` at `T`, concrete
// only once the enclosing emission says which `T`. Each argument is put
// through the instantiation being lowered, giving a list every reader
// can mangle.
//
// Rebuilt rather than edited because an `Inst` is a value a memo holds:
// sema's copy must not change because a backend read it. A parameter
// the call left free is bound TO ITSELF, keeping the list's length — a
// shorter list would make two instantiations one symbol.
settled_inst* = (be :: CBackend, tparams: Vec<TParam>, owner: str,
                 inst: Inst) Res<Inst, AllocError> {
    out ::= be.alloc.Inst();
    tparams.loop((h, tp) { settle_one(be, tp, owner, inst, out).try() });
    Ok(out);
}

settle_one = (be :: CBackend, tp: TParam, owner: str, inst: Inst,
              out :: Inst) Res<(), AllocError> {
    v = intern_var(be.check, tp.name.text, owner).try();
    inst.lookup(v).match({
        None  => out.bind(v, v),
        Ok(t) => settle_bound(be, v, t, out),
    })
}

settle_bound = (be :: CBackend, v: TyId, t: TyId, out :: Inst)
               Res<(), AllocError> {
    arg = sub(be, t).try();
    out.bind(v, arg)
}

// ---------------------------------------------------------------------
// what the ARGUMENTS say a parameter became
//
// Sema records an instantiation at a call and a generic receiver, but
// only inside a body it CHECKED — top-level declarations only. Calls
// inside a member body arrive with nothing recorded (`Map<K, V>.set` is
// made of them), so the arguments are asked instead.
//
// STRUCTURAL AND TOTAL: a declared type mentioning no parameter binds
// nothing, and a shape that doesn't line up binds nothing rather than
// guessing — the caller checks afterwards that every parameter came out
// bound. FIRST BINDING WINS (`Inst.bind`'s own rule), so
// `<T>(a: T, b: T)` against two different types is a mismatch someone
// else reports, not a silent rebind.
// ---------------------------------------------------------------------

unify* = (be :: CBackend, declared: TyId, actual: TyId, out :: Inst)
         Res<(), AllocError> {
    be.check.types.at(declared).match({
        Var(_)   => out.bind(declared, actual),
        Named(n) => unify_named(be, n, actual, out),
        Res(r)   => unify_res(be, r, actual, out),
        _        => Ok(()),
    })
}

unify_named = (be :: CBackend, n: TyNamed, actual: TyId, out :: Inst)
              Res<(), AllocError> {
    be.check.types.at(actual).match({
        Named(m) => unify_args(be, n.args, m.args, out),
        _        => Ok(()),
    })
}

unify_args = (be :: CBackend, ds: Vec<TyId>, ts: Vec<TyId>, out :: Inst)
             Res<(), AllocError> {
    (ds.len == ts.len).match({
        false => Ok(()),
        true  => unify_each(be, ds, ts, out),
    })
}

unify_each = (be :: CBackend, ds: Vec<TyId>, ts: Vec<TyId>, out :: Inst)
             Res<(), AllocError> {
    ds.loop((h, i, d) { unify_at(be, d, ts, i, out).try() });
    Ok(());
}

unify_at = (be :: CBackend, d: TyId, ts: Vec<TyId>, i: usize, out :: Inst)
           Res<(), AllocError> {
    ts.get(i).match({
        None  => Ok(()),
        Ok(t) => unify(be, d, t, out),
    })
}

unify_res = (be :: CBackend, r: TyRes, actual: TyId, out :: Inst)
            Res<(), AllocError> {
    be.check.types.at(actual).match({
        Res(q) => unify_res_parts(be, r, q, out),
        _      => Ok(()),
    })
}

unify_res_parts = (be :: CBackend, r: TyRes, q: TyRes, out :: Inst)
                  Res<(), AllocError> {
    unify(be, r.value, q.value, out).try();
    unify(be, r.error, q.error, out).try();
    Ok(());
}

// THE TYPE OF AN ARGUMENT AS THE BACKEND KNOWS IT. A local is declared
// in the BACKEND's scope and not in sema's — `gen_c_stmt.declare_local`
// writes no binding into the checker — so a bare name is answered from
// the frame that declared it, and everything else from `ty_of`.
arg_type* = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId)
            Res<TyId, AllocError> {
    local_type(be, id).match({
        Ok(t) => Ok(t),
        None  => ty_of(be, id, ctx, want),
    })
}

local_type = (be :: CBackend, id: ExprId) Res<TyId> {
    be.tree.expr_at(id).kind.match({
        Name(n) => slot_ty(be, n.text),
        _       => None,
    })
}

slot_ty = (be :: CBackend, name: str) Res<TyId> {
    be.slot_of(name).match({
        Ok(s) => Ok(s.ty),
        None  => None,
    })
}

// ---------------------------------------------------------------------
// putting the parameters back in scope
//
// `type_from_ast` reads a WRITTEN type, meaningless unless `T` is bound.
// Sema binds it while checking the declaration then releases it; the
// backend asks the same nodes again later and must rebind it — always
// as a pair, around the smallest span that reads a written type.
// ---------------------------------------------------------------------

enter_tparams* = (be :: CBackend, tparams: Vec<TParam>, owner: str)
                 Res<usize, AllocError> {
    mark = be.check.tvar_mark();
    tparams.loop((h, tp) { enter_one(be, tp, owner).try() });
    Ok(mark);
}

enter_one = (be :: CBackend, tp: TParam, owner: str) Res<(), AllocError> {
    text = tp.name.text;
    be.check.push_tvar(text, intern_var(be.check, text, owner).try())
}

leave_tparams* = (be :: CBackend, mark: usize) Res<(), AllocError> {
    be.check.release_tvars(mark)
}

// The type parameters a STRUCT declares, in scope for its members. The
// owner is built by sema's one builder, because `Var` is interned on it
// and a parameter bound here has to be the same type sema bound.
enter_struct_tparams* = (be :: CBackend, decl: DeclId)
                        Res<usize, AllocError> {
    mark = be.check.tvar_mark();
    decl_at(be.tree, decl).match({
        None  => Ok(()),
        Ok(d) => enter_decl_tparams(be, decl, d),
    }).try();
    Ok(mark);
}

enter_decl_tparams = (be :: CBackend, decl: DeclId, d: Decl)
                     Res<(), AllocError> {
    d.kind.match({
        Struct(s) => enter_struct_of(be, decl, s),
        _         => Ok(()),
    })
}

enter_struct_of = (be :: CBackend, decl: DeclId, s: Struct)
                  Res<(), AllocError> {
    owner = owner_of(be.check, decl.module.to_usize(), s.name.text).try();
    s.tparams.loop((h, tp) { enter_one(be, tp, owner).try() });
    Ok(());
}
