// Fixed-capacity single-producer/single-consumer ring.
// `ring` acquires the slot buffer through the caller's allocator; `free` releases it through the
// same allocator. Index-changing methods return updated values, which callers must store back.
{ AllocatorBackend } = std.mem.alloc
{ Result, IoError } = std.core.result
RING_EINVAL = 22
Ring*<M>: {
    buf: RawPtr<u8>,
    head: i64,
    tail: i64,
    cap: i64,
    slots    = (r: Ring<M>) [M] { r.buf.slice(r.cap) }
    is_full  = (r: Ring<M>) bool { r.tail - r.head >= r.cap }
    pending  = (r: Ring<M>) i64 { r.tail - r.head }
    nonempty = (r: Ring<M>) bool { r.head < r.tail }
    push = (r: Ring<M>, v: M) Ring<M> {
        slots ::= r.slots()
        slots[r.tail % r.cap] = v
        Ring<M>(
            buf: r.buf,
            head: r.head,
            tail: r.tail + 1,
            cap: r.cap,
        )
    }
    peek = (r: Ring<M>) M { r.slots()[r.head % r.cap] }
    advance = (r: Ring<M>) Ring<M> {
        Ring<M>(
            buf: r.buf,
            head: r.head + 1,
            tail: r.tail,
            cap: r.cap,
        )
    }
    free = (r: Ring<M>, alloc: AllocatorBackend) void { alloc.release(r.buf) }
}
ring*<M> = (alloc: AllocatorBackend, cap: i64) Result<Ring<M>, IoError> {
    bytes = cap * sizeof(M)
    (cap <= 0 || bytes <= 0 || bytes / sizeof(M) != cap).match ({
        true  => {
            invalid: Result<Ring<M>, IoError> = .Err(.Errno(RING_EINVAL))
            invalid
        },
        false => alloc.try_acquire(bytes).match ({
            .Ok(buf) => {
                made: Result<Ring<M>, IoError> = .Ok(Ring<M>(
                    buf: buf,
                    head: 0,
                    tail: 0,
                    cap: cap,
                ))
                made
            },
            .Err(e)  => {
                failed: Result<Ring<M>, IoError> = .Err(e)
                failed
            },
        }),
    })
}
