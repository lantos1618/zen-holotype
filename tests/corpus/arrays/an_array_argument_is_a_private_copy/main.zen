// PASSING AN ARRAY OF STRUCTS BY VALUE HANDS OVER A REAL COPY,
// AND ITS ELEMENT TYPE TRAVELS WITH IT.
//
// Two rules meet in one call. The array is a struct, so argument passing
// copies the WHOLE thing (C's own arrays cannot do this; the wrapper is
// what bought it), and the callee's body types its element reads through
// the PARAMETER's `[Point, 2]` — settled_arg_ty mints a literal argument
// into the parameter's element type before the call is ever lowered.
//
// `consume mine` is the sharp half: consume is a BYTE MOVE
// (ownership-consume/consume_swaps_two_values), so after the call main's
// binding no longer holds the array and the callee's copy is all there
// is. A backend that lowers either array arguments or consume as a
// reference rename still links and prints plausible numbers — it just
// answers with whatever buffer it pointed at. The callee walks its
// parameter BEFORE reading it, so a lazy (first-touch) or shared-buffer
// lowering cannot accidentally agree with the true answer.

Point = { x: i32, y: i32 }

span = (pair: [Point, 2]) i64 {
    pair.loop((h, p) { println("in {}", p.x + p.y); });
    pair[1].x.to_i64() - pair[0].y
}

main = (env: Env) Res<i32, AllocError> {
    mine: [Point, 2] = [Point(x: 5, y: 1), Point(x: 3, y: 1)];
    got ::= span(consume mine);
    println("got {}", got);
    Ok(0);
}
