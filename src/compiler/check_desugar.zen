{ Expr, Stmt, Decl, Func, Param, Ty, EnumDecl, TraitDefData, ArmData, MatchData, VariantDef,
  MethodCallData, FieldInit, GlobalData } = compiler.ast.ast_types
{ cbuf, bin_at, cond_oa, call_at, mfield, ematch, ematchp, arm_at, arm_spans, eindex, eloop,
  eloop_at, slett_atm, sassign_at, sret, sexpr, sif, swhile, sidxset_at, finit, finit_at,
  subst_ty_in, dfunc, mkenumg, mkenumg_at, is_expr_null, param_at, tnamed, tvoid, acquire_or_die } = compiler.genc
{ impl_cname_in } = compiler.mangle
{ Allocator } = std.mem.alloc
{ DeclIndex, cebuf, cenode, pbuf, vnil } = compiler.check
{ map_slice, param_names_has, slice_any } = compiler.astops
{ light_ty } = compiler.check_infer
{ loop_at } = std.core.count
tybuf1 = (a: Allocator) MutSlice<Ty> { slice(a.acquire_or_die(sizeof(Ty)), 1) }
self_param = (a: Allocator) MutSlice<Param> {
    buf ::= a.pbuf(1)
    buf[0] = param("Self", tvoid())
    buf
}
self_arg = (a: Allocator, tyname: StringView) MutSlice<Ty> {
    buf ::= a.tybuf1()
    buf[0] = tnamed(tyname)
    buf
}
// Specialize default Func to a concrete impl type.
default_for_type = (a: Allocator, td: TraitDefData, tyname: StringView) Func {
    sp = a.self_param()
    ag = a.self_arg(tyname)
    ps ::= a.pbuf(td.fn.params.len)
    td.fn.params.loop_at((i, p) { ps[i] = param_at(p.name, a.subst_ty_in(sp, ag, p.ty), p.pos) })
    Func(
        name: a.impl_cname_in(td.trname, tyname, td.fn.name),
        params: ps,
        ret: a.subst_ty_in(sp, ag, td.fn.ret),
        tparams: td.fn.tparams,
        body: td.fn.body,
    )
}
// Does this impl already provide method m?
def_provided = (decls: MutSlice<Decl>, tyname: StringView, trname: StringView, m: StringView) bool {
    decls.slice_any((d) {
        d.match ({
            .DImpl(im) => (im.ty == tyname && im.trname == trname).match ({
                true  => im.methods.param_names_has(m),
                false => false,
            }),
            _          => false,
        })
    })
}
default_expansion_count = (decls: MutSlice<Decl>) i64 {
    n ::= 0
    decls.loop_at((i, d) {
        d.match ({
            .DTraitDefault(td) => decls.loop_at((j, e) {
                e.match ({
                    .DImpl(im) => (im.trname == td.trname
                        && decls.def_provided(im.ty, td.trname, td.fn.name) == false).then({
                        n = n + 1
                    }),
                    _          => { },
                })
            }),
            _                  => { },
        })
    })
    n
}
emit_defaults_for = (
    a: Allocator,
    decls: MutSlice<Decl>,
    td: TraitDefData,
    buf: MutSlice<Decl>,
    j: i64,
) i64 {
    k ::= j
    decls.loop_at((i, d) {
        d.match ({
            .DImpl(im) => (im.trname == td.trname
                && decls.def_provided(im.ty, td.trname, td.fn.name) == false).then({
                buf[k] = dfunc(a.default_for_type(td, im.ty))
                k = k + 1
            }),
            _          => { },
        })
    })
    k
}
expand_defaults* = (a: Allocator, decls: MutSlice<Decl>) MutSlice<Decl> {
    extra = decls.default_expansion_count()
    (extra == 0).match ({
        true  => decls,
        false => {
            buf ::= cbuf<Decl>(a, decls.len + extra)
            decls.loop_at((i, d) { buf[i] = d })
            k ::= decls.len
            decls.loop_at((i, d) {
                d.match ({
                    .DTraitDefault(td) => {
                        k = a.emit_defaults_for(decls, td, buf, k)
                    },
                    _                  => { },
                })
            })
            buf
        },
    })
}
// Resolve module: defaults, resolve, inline templates, then re-resolve concrete inline residue.
// Lambdas splice bodies back into their caller, so that re-resolve can expose more template calls
// such as captured generic receiver methods; run one more inline/resolve pass for that residue.
// ── DESUGAR: faithful MethodCall -> flat Call (UFCS lowering) ───────────────────────────────
// parse_module keeps `recv.method(args)` as a faithful MethodCall (so the formatter sees the surface
// UFCS form). This pass — run at the very START of resolve_module, before any other pass — rewrites each
// MethodCall back into the EXACT flat `Call(fn: method, args: [recv] ++ args, pos: method-pos, raw: false)`
// the old flattening parser produced, so the resolve/inline/genc pipeline downstream is byte-for-byte
// unchanged. The walk is FUNCTIONAL: `dmc_expr_val` returns the (possibly new) node, and each parent is
// rebuilt with its lowered children. Reading an AST node through its read-only `Ptr<Expr>` slot and
// reconstructing it (rather than storing through that slot) keeps the rewriter sound under pointer-kind
// checking — a read-only `Ptr` is never silently treated as a writable `MutPtr` (the R1 rule). Mutable
// SLICE storage (a [Stmt]/[Expr]/[FieldInit]/[ArmData] element, reached via `.addr()`) is updated in place.
desugar_method_calls* = (a: Allocator, decls: MutSlice<Decl>) MutSlice<Decl> {
    decls.loop_at((i, d) { store(decls[i].addr(), a.dmc_decl(d)) })
    decls
}
dmc_decl = (a: Allocator, d: Decl) Decl {
    d.match ({
        .DFunc(f)          => {
            a.dmc_body(f.body)
            d
        },
        .DGlobal(g)        => .DGlobal(GlobalData(
            name: g.name,
            ty: g.ty,
            init: a.dmc_expr_val(g.init),
            tl: g.tl,
            alias: g.alias,
            pos: g.pos,
        )),
        .DTraitDefault(td) => {
            a.dmc_body(td.fn.body)
            d
        },
        .DEnum(ed)         => {
            a.dmc_variants(ed.variants)
            d
        },
        _                  => d,
    })
}
dmc_variants = (a: Allocator, vs: MutSlice<VariantDef>) void {
    vs.loop_at((i, v) {
        (v.dflt.is_expr_null() == false).then({
            store(vs[i].addr(), VariantDef(
                name: v.name,
                payload: v.payload,
                dflt: a.dmc_expr_val(v.dflt),
                pos: v.pos,
            ))
        })
    })
}
dmc_body = (a: Allocator, body: MutSlice<Stmt>) void {
    body.loop_at((i, st) { a.dmc_stmt(body[i].addr()) })
}
// `sp` is a MUTABLE slot (a [Stmt] slice element), so the rebuilt statement is stored back through it.
dmc_stmt = (a: Allocator, sp: MutPtr<Stmt>) void {
    sp.match ({
        .Let(l)      => store(sp, slett_atm(l.name, l.ty, a.dmc_expr_val(l.value), l.pos, l.mut)),
        .Assign(asn) => store(sp, sassign_at(a.dmc_expr_val(asn.target), a.dmc_expr_val(asn.value), asn.pos)),
        .Return(e)   => store(sp, sret(a.dmc_expr_val(e))),
        .If(f)       => {
            a.dmc_body(f.then)
            a.dmc_body(f.els)
            store(sp, sif(a.dmc_expr_val(f.c), f.then, f.els))
        },
        .While(w)    => {
            a.dmc_body(w.body)
            store(sp, swhile(a.dmc_expr_val(w.c), w.body))
        },
        .IndexSet(x) => store(sp, sidxset_at(a.dmc_expr_val(x.seq), a.dmc_expr_val(x.idx), x.elem, a.dmc_expr_val(x.value), x.pos)),
        .ExprStmt(e) => store(sp, sexpr(a.dmc_expr_val(e))),
    })
}
// `args[i]` is a mutable [Expr] slot, so each lowered element is stored back in place.
dmc_args = (a: Allocator, args: MutSlice<Expr>) void {
    args.loop_at((i, ar) { store(args[i].addr(), load(a.dmc_expr_val(args[i].addr()))) })
}
dmc_inits = (a: Allocator, inits: MutSlice<FieldInit>) void {
    inits.loop_at((i, fi) {
        store(inits[i].addr(), finit_at(fi.name, a.dmc_expr_val(fi.value), fi.pos))
    })
}
dmc_arms = (a: Allocator, arms: MutSlice<ArmData>) void {
    arms.loop_at((i, ar) {
        store(arms[i].addr(), arm_spans(ar.variant, ar.bind, a.dmc_expr_val(ar.body), ar.pos, ar.variant_pos, ar.bind_pos))
    })
}
// `recv.method(args)` -> `Call(fn: method, args: [recv, ...args], pos, raw: false)` — exactly what the
// old parse_method built (buf[0] = recv, method args from index 1, via call_at). The recv and args are
// lowered first (recv functionally, args in their mutable slice slots).
dmc_lower = (a: Allocator, mc: MethodCallData) Expr {
    rv = a.dmc_expr_val(mc.recv)
    a.dmc_args(mc.args)
    buf ::= a.cebuf(mc.args.len + 1)
    buf[0] = load(rv)
    mc.args.loop_at((i, ar) { buf[i + 1] = mc.args[i] })
    call_at(mc.method, buf, mc.pos)
}
remk_match* = (m: MatchData, subj: Ptr<Expr>) Expr {
    m.ptr.then({ ematchp(subj, m.ename, m.arms) }, { ematch(subj, m.ename, m.arms) })
}
// FUNCTIONAL rewrite: returns the lowered node. A node with single `Ptr<Expr>` children is rebuilt with
// the lowered children (preserving every field/position); a node whose children live in mutable slices is
// mutated in place and the SAME node pointer is returned. Only a `MethodCall` actually changes shape.
dmc_expr_val = (a: Allocator, ep: Ptr<Expr>) Ptr<Expr> {
    ep.match ({
        .Bin(b)         => a.cenode(bin_at(b.op, a.dmc_expr_val(b.lhs), a.dmc_expr_val(b.rhs), b.pos)),
        .Call(c)        => {
            a.dmc_args(c.args)
            ep
        },
        .MethodCall(mc) => a.cenode(a.dmc_lower(mc)),
        .Cond(d)        => a.cenode(cond_oa(a.dmc_expr_val(d.c), a.dmc_expr_val(d.t), a.dmc_expr_val(d.e), d.oa)),
        .Member(m)      => a.cenode(mfield(a.dmc_expr_val(m.obj), m.field, m.pos, m.ptr)),
        .MakeEnum(m)    => a.cenode(mkenumg_at(m.ty, m.mty, m.targs, m.variant, a.dmc_expr_val(m.payload), m.ty_pos, m.variant_pos)),
        .MakeStruct(m)  => {
            a.dmc_inits(m.inits)
            ep
        },
        .Match(m)       => {
            a.dmc_arms(m.arms)
            a.cenode(remk_match(m, a.dmc_expr_val(m.subj)))
        },
        .SliceLit(sd)   => {
            a.dmc_args(sd.items)
            ep
        },
        .Index(ix)      => a.cenode(eindex(a.dmc_expr_val(ix.seq), a.dmc_expr_val(ix.idx), ix.elem)),
        .Loop(l)        => {
            a.dmc_body(l.body)
            a.cenode(eloop_at(a.dmc_expr_val(l.seq), l.idx, l.elem, l.elemTy, l.body, l.h, l.h_pos, l.idx_pos, l.elem_pos))
        },
        .Lambda(lm)     => {
            a.dmc_body(lm.body)
            ep
        },
        .Block(b)       => {
            a.dmc_body(b.stmts)
            ep
        },
        _               => ep,
    })
}
// Enum-variant defaults (`Name = expr`) are parsed with a void payload + the default expr; before any
// other pass, infer each default's type into the payload so codegen lays out the union slot and match
// arms bind correctly.
default_payload = (a: Allocator, decls: MutSlice<Decl>, idx: DeclIndex, v: VariantDef) Ty {
    v.dflt.is_expr_null().then({ v.payload }, { v.dflt.light_ty(a, a.vnil(), decls, idx) })
}
fill_variant_defaults = (
    a: Allocator,
    decls: MutSlice<Decl>,
    idx: DeclIndex,
    vs: MutSlice<VariantDef>,
) MutSlice<VariantDef> {
    map_slice(a, vs, (v) {
        VariantDef(
            name: v.name,
            payload: a.default_payload(decls, idx, v),
            dflt: v.dflt,
            pos: v.pos,
        )
    })
}
fill_enum_defaults* = (a: Allocator, decls: MutSlice<Decl>, idx: DeclIndex) MutSlice<Decl> {
    map_slice(a, decls, (d) {
        d.match ({
            .DEnum(ed) => .DEnum(EnumDecl(
                name: ed.name,
                variants: a.fill_variant_defaults(decls, idx, ed.variants),
            )),
            _          => d,
        })
    })
}
