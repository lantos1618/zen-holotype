// A CALL PACKED PAST 80 COLUMNS BREAKS ONE ARGUMENT PER LINE — the
// width rule's first form (`fmt_break.zen`), pinned with the case it
// was written against: `lsp_symbol.zen`'s `decl_sym`, which the tree
// already carries in broken form. Two things are being pinned at once:
//
//   - the broken shape itself: one argument per line at +4 from the
//     line the call sits on, the closing `)` hugging the last argument,
//     whatever followed the call (`)),` here) staying on that line.
//   - the HUG: `out.add(..)` packed is wider than 80 too, and it does
//     NOT break — breaking `Sym(..)` already brought every line under
//     the width, and an outer break would buy indent, not width. A list
//     holding a broken list keeps.
//
// `faithful` is the guard in `fmt.zen` — the output re-lexed and its
// token stream compared to the input's — and `fixpoint` is the second
// run moving nothing; both are printed per case because a golden output
// that is not a fixpoint is a gate that goes red on its own second run.

Alloc, AllocError = std.mem
str, String = std.text
scan, Source = std.lex.lex
render = fmt.fmt

main = (env: Env) Res<i32, AllocError> {
    a ::= env.mem.alloc();

    shows(
        a,
        "a packed constructor past the width breaks one field per line",
        "decl_syms = (d: Decl, out :: Vec<Sym>) Res<(), AllocError> {\n    d.kind.match({\n        Function(f) => out.add(Sym(name: f.name.text, kind: FUNCTION, span: d.span, name_span: f.name.span)),\n    })\n}\n").try();

    Ok(0);
}

// Format, print the bytes, and format the bytes again to say whether
// anything moved the second time.
shows = (a: Alloc, what: str, text: str) Res<(), AllocError> {
    first = formatted(a, text).try();
    second = formatted(a, first.view()).try();
    println("== {}", what);
    println(
        "faithful: {}, {}",
        faithful_of(a, text).try(),
        verdict(first.view().eq(second.view())));
    show(first.view());
    Ok(());
}

verdict = (settled: bool) str {
    settled.match({
        true  => "fixpoint",
        false => "MOVED",
    })
}

formatted = (a: Alloc, text: str) Res<String, AllocError> {
    lexed = scan(a, Source(file: "in.zen", text: text)).try();
    out = render(a, lexed).try();
    Ok(out.text);
}

faithful_of = (a: Alloc, text: str) Res<bool, AllocError> {
    lexed = scan(a, Source(file: "in.zen", text: text)).try();
    out = render(a, lexed).try();
    Ok(out.faithful);
}

// The bytes, with the final newline shown as the end of the last line
// rather than as a blank one, and a `|` at both ends so a trailing space
// would be visible in the expectation.
show = (text: str) () {
    line ::= 0;
    from ::= 0;
    Range(0, text.len).loop((h, i) {
        (text.index(i) == '\n').then(() {
            line = line + 1;
            println("{} |{}|", line, text.slice(from, i));
            from = i + 1;
        });
    });
}
