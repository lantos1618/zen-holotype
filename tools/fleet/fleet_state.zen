// tools/fleet/fleet_state.zen
// The state directory: one baseline, one attempt count and one done
// marker per job, plus the lane list `fleet.sh` reads back.
//
// NOTHING HERE KNOWS WHAT A JOB IS. Every door takes the job's NAME, a
// str, because the name is the file stem and the stem is the whole of
// what the filesystem needs — which is also why `fleet.zen` refuses a
// work list with two jobs of one name.
//
// THE DONE MARKER IS A BYTE, NOT A FILE'S EXISTENCE, because
// `std.env.Fs` cannot delete (#757): read, write, exists, is_dir and
// nothing else. With existence as the marker, a second run over the same
// state directory would find every job from the first one already passed
// and report a green fleet that never ran.

Alloc, AllocError = std.mem
str, String = std.text
FsError = std.env
// THE MODULE, NOT THE NAME. Only `digits` is wanted here, and a one-name
// import binds the module instead of the name (#760) — so the call below
// is qualified rather than pulling in a second name nothing uses.
scan = fleet_text

state_path* = (a: Alloc, dir: str, name: str, ext: str)
             Res<String, AllocError> {
    a.String("{}/{}.{}", dir, name, ext)
}

count_of* = (env: Env, alloc: Alloc, state: str, name: str)
           Res<u64, AllocError> {
    p ::= state_path(alloc, state, name, "try").try();
    n ::= 0;
    env.fs.read(alloc, p.view()).match({
        Ok(text) => { n = scan.digits(text.view()); },
        Err(_)   => {},
    });
    Ok(n)
}

set_count* = (env: Env, alloc: Alloc, state: str, name: str, n: u64)
            Res<(), AllocError> {
    p    ::= state_path(alloc, state, name, "try").try();
    text ::= alloc.String("{}", n).try();
    env.fs.write(p.view(), text.view()).match({
        Ok(_)  => Ok(false),
        Err(e) => note_fs(p.view(), e),
    }).try();
    Ok(());
}

set_done* = (env: Env, alloc: Alloc, state: str, name: str, yes: bool)
           Res<(), AllocError> {
    p ::= state_path(alloc, state, name, "done").try();
    env.fs.write(p.view(), yes.match({ true => "1\n", false => "0\n" }))
        .match({
            Ok(_)  => Ok(false),
            Err(e) => note_fs(p.view(), e),
        })
        .try();
    Ok(());
}

done_at* = (env: Env, alloc: Alloc, state: str, name: str)
          Res<bool, AllocError> {
    p   ::= state_path(alloc, state, name, "done").try();
    yes ::= false;
    env.fs.read(alloc, p.view()).match({
        Err(_)   => {},
        Ok(text) => {
            yes = text.view().eq("1\n");
        },
    });
    Ok(yes)
}

// The lane list, and the reason it is a file: see the header. Truncated
// every round, so an empty file is the driver's stop condition and a
// stale round cannot be run twice.
write_lanes* = (env: Env, alloc: Alloc, state: str, text: str)
              Res<(), AllocError> {
    p ::= state_path(alloc, state, "lanes", "txt").try();
    env.fs.write(p.view(), text).match({
        Ok(_)  => Ok(false),
        Err(e) => note_fs(p.view(), e),
    }).try();
    Ok(());
}

// Answers true, so a caller can add it to a count of things that did not
// happen. Printing here rather than raising keeps one unwritable state
// file from ending a fleet that is otherwise fine.
note_fs* = (path: str, e: FsError) Res<bool, AllocError> {
    println("fleet: {}: {}", path, fs_word(e));
    Ok(true);
}

fs_word* = (e: FsError) str {
    e.match({
        NotFound    => "not found",
        Denied      => "denied",
        IsDir       => "is a directory",
        Failed      => "could not be written",
        OutOfMemory => "out of memory",
    })
}
