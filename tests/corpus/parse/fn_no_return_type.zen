// a function with no return type, attested in DESIGN.md's Actor impl:
//   receive_msg = (self :: @Self, ctx: Context, data: str) { .. }
// env is threaded explicitly because println resolves an Env BY TYPE
// and a function without one has no console.

shout = (env: Env, n: i32) { println("{}", n) }

main = (env: Env) Res<i32, ArgError> {
    shout(env, 7);
    Ok(0);
}
