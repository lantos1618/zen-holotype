// tests/corpus/std/bool_then_lands_in_res.zen
// then is the one-sided conditional, and it is an ordinary ufcs
// function on bool. it lands in Res - Ok(v) when true, None when
// false - so it matches like anything else and nothing is hidden

main = (env: Env) Res<i32, AllocError> {
    (1 == 1).then(() { "ran" }).match({
        Ok(s) => println("true {}", s),
        None  => println("true none"),
    })
    (1 == 2).then(() { "ran" }).match({
        Ok(s) => println("false {}", s),
        None  => println("false none"),
    })
    Ok(0);
}
