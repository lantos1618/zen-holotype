// OS threads. Bodies cannot capture; state crosses the thread boundary through arg and shared
// mutation must be synchronized.
{ heap_acquire, heap_release } = std.mem.alloc
{ pthread_create, pthread_join } = std.c.libc
{ panic } = std.core.result
{ is_null } = std.core.ptr
{ mark_spawned } = std.rt
JoinHandle*: {
    tid: RawPtr<u8>,
    // Single-use: join frees the handle storage.
    join = (h: JoinHandle) RawPtr<u8> {
        retcell = heap_acquire(null_ptr(), 8)    // void* out-cell for the thread's return value
        is_null(retcell).then({
            panic("thread: join out-cell allocation failed")
        })
        pthread_join(load_i64(h.tid), retcell)
        slot: MutSlice<RawPtr<u8>> = retcell.slice(1)    // read the stored void* back out
        r = slot[0]
        heap_release(null_ptr(), retcell)
        heap_release(null_ptr(), h.tid)
        r
    }
}    // -> pthread_t (an i64 on glibc)
spawn* = (f: (argument: RawPtr<u8>) RawPtr<u8>, arg: RawPtr<u8>) JoinHandle {
    cell = heap_acquire(null_ptr(), 8)    // pthread_t storage; pthread_create writes the id here
    is_null(cell).then({
        panic("thread: pthread_t cell allocation failed")
    })
    // Freeze the ambient runtime before the new thread can observe it.
    mark_spawned()
    pthread_create(cell, null_ptr(), f, arg)
    JoinHandle(tid: cell)
}
