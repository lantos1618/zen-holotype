// src/gen/gen_c/gen_c_hoist.zen
// What hoisting is in C.
//
// DESIGN.md: "a bare T lifts into Res<T> wherever a Res is expected —
// `0;` closes a `Res<i32, E>` function like `Ok(0);` does." In C that is
// no conversion at all — a `Res` is a tagged struct and `return 7;` from
// a function returning one is a program `cc` rejects — so the value is
// BUILT the way a written `Ok(7)` is, by the same code:
// `gen_c_call.zen`'s `write_res_payload`. Two copies of that layout
// would be two places to fix, and both forms are the SAME VALUE.
//
// WHETHER THE LIFT IS LEGAL IS NOT DECIDED HERE. `sema_hoist.zen` owns
// the "exactly one variant carries the type" count and the refusal that
// failure never lifts, reporting before a backend runs — so the
// predicate below is narrow on purpose: a value already at the wanted
// type is a copy, one that fits nothing is a mismatch named elsewhere.
// `Unknown` answers "already fits" and skips the wrap, since
// `assignable` waves poison and an unsubstituted parameter through;
// the other way round would wrap a value that was already a `Res`.

ExprId = std.ast
AllocError = std.mem
String = std.text
TyId, TyRes = sema.sema_ty
Ctx = sema.sema_check
CBackend = gen.gen_c.gen_c_state
ty_of = gen.gen_c.gen_c_expr
write_res_payload = gen.gen_c.gen_c_call

needs_hoist* = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId)
               Res<bool, AllocError> {
    be.check.types.at(want).match({
        Res(r) => lifts_into(be, id, ctx, want, r),
        _      => Ok(false),
    })
}

lifts_into = (be :: CBackend, id: ExprId, ctx: Ctx, want: TyId, r: TyRes)
             Res<bool, AllocError> {
    unknown = be.check.types.unknown().try();
    cty     = ty_of(be, id, ctx, unknown).try();
    be.check.assignable(cty, want).match({
        true  => Ok(false),
        false => Ok(be.check.assignable(cty, r.value)),
    })
}

// `Ok` over the value at the SUCCESS PAYLOAD'S type, which is what stops
// the wrap from asking for itself again: the inner lowering is handed
// `r.value`, the value already fits it, and `needs_hoist` says no.
hoist_expr* = (
    be   :: CBackend,
    id   : ExprId,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    be.check.types.at(want).match({
        Res(r) => write_res_payload(be, id, want, "Ok", id, r.value, ctx, out),
        _      => Ok(()),
    })
}
