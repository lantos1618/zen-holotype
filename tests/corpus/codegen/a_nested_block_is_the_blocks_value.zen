// A NESTED BLOCK IS A VALUE TOO, AND IT IS THE BLOCK'S OWN VALUE WHEN
// IT IS WRITTEN LAST. Issue #764 case 3: sema has always agreed —
// `sema_type.stmt_type` types a `Block` statement with `block_type` —
// but every reader that asks "which statement is the tail" matched
// `Stmt.kind.Expr` and nothing else, so `{ { 11 } }` was an `i32` to
// the checker and NOTHING to the backend. The emitted C computed the
// 11, threw it away as `(void)(11)`, and closed with a bare `return;`
// in a function returning a struct.
//
// THE ASSERTION IS THE NUMBER, NOT THE EXIT STATUS. All four functions
// below compiled, ran, and exited 0 with the defect in place; they
// printed `0`. The only signal was a `-Wreturn-type` warning that
// nothing greps for, which is why no oracle in this tree saw it.
//
// `nested` is the plain return type and `lifted` the `Res` one, so the
// answer does not depend on hoisting. `tried` puts a `.try()` inside
// the nested block, which is where the issue found it. `lambda` is the
// same tail seen by `gen_c_settle.lambda_value_type`, which asks
// `sema_hoist.tail_expr` — a second reader of the same mechanism, and
// it stayed wrong for one more build after the backend's own two were
// fixed.
//
// `statement` is the other half of the rule and must NOT change: a
// nested block written where no value is wanted is asked for none, its
// last statement is lowered as a statement, and the drop of what it
// makes belongs at the inner brace.

AllocError = std.mem

inner  = () Res<i32, AllocError> { Ok(11) }

apply  = <T>(f: () T) T { f() }

nested = () i32 { { 11 } }

lifted = () Res<i32, AllocError> { { 11 } }

tried  = () Res<i32, AllocError> { { inner().try() } }

main = (env: Env) Res<i32, AllocError> {
    println("nested {}", nested());

    lifted().match({
        Ok(v)  => println("lifted {}", v),
        Err(_) => println("lifted err"),
    });

    tried().match({
        Ok(v)  => println("tried {}", v),
        Err(_) => println("tried err"),
    });

    lambda: i32 = apply(() { { 42 } });
    println("lambda {}", lambda);

    {
        held = 7;
        println("statement {}", held);
    }

    Ok(0);
}
