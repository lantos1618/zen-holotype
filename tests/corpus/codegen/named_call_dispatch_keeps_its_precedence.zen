// A bare call name follows visible language precedence: a closure parameter wins,
// `Ok` and `Err` use the destination `Res`, and a declared `println` shadows
// print sugar.

Fault = | Bad
Error = AllocError | IoError

println = (n: i32) i32 { n + 1 }

apply = (f: (n: i32) i32, n: i32) i32 { f(n) }

main = (env: Env) Res<i32, Error> {
    n                       = apply((v: i32) i32 { v * 2 }, 4);
    value: Res<i32, Fault>  = Ok(n);
    failed: Res<i32, Fault> = Err(Fault.Bad);

    env.out.println("closure {}", n).try();
    env.out.println("shadow {}", println(41)).try();
    value.match({
        Ok(v)  => env.out.println("ok {}", v),
        Err(_) => env.out.println("wrong value"),
    }).try();
    failed.match({
        Ok(_)  => env.out.println("wrong error"),
        Err(_) => env.out.println("err"),
    }).try();
    Ok(0)
}
