== a packed constructor past the width breaks one field per line
faithful: true, fixpoint
1 |decl_syms = (d: Decl, out :: Vec<Sym>) Res<(), AllocError> {|
2 |    d.kind.match({|
3 |        Function(f) => out.add(Sym(|
4 |            name: f.name.text,|
5 |            kind: FUNCTION,|
6 |            span: d.span,|
7 |            name_span: f.name.span|
8 |        )),|
9 |    })|
10 |}|
