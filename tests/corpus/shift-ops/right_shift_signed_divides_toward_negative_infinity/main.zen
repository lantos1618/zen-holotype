// RIGHT SHIFT OF A NEGATIVE VALUE DIVIDES TOWARD -INFINITY: iN.MIN >> k
// IS -1 FOR EVERY k UP TO width-1, NOT SOME TRUNCATED QUOTIENT.
//
// Zen spells `x >> k` as division by 2^k, and Zen's `/` already rounds
// toward negative infinity (i32.MIN / -1 is an overflow wearing
// division's clothes; DESIGN.md's failure model), so the arithmetic
// shift falls out of the language's own division. The wrong answer that
// still compiles is C's `-7 / 4 == -1` TRUNCATION — round toward zero —
// which prints 0 where -1 belongs at every full-width shift below.
//
// each row shifts its type's MIN by width-1: one surviving sign bit,
// sign-extended. The logical-shift-right reading (shift in zeros) prints
// +1 on every row instead of -1, so the sign of the answer IS the test.
//
// the u-column is the control: unsigned right shift really does bring
// zeros in, and 0xFFFFFFFF >> 31 is 1 — the number a signed bug would
// print on the rows above.
//
// one-line break: lower the divide-by-2^k through C's `/` on a SIGNED
// operand without the floor correction (or spell the helper with a
// logical shift) and every negative row flips to 0 or 1.

main = (env: Env) Res<i32, AllocError> {
    m8:  i8  = i8.MIN;
    m16: i16 = i16.MIN;
    m32: i32 = i32.MIN;
    m64: i64 = i64.MIN;

    println("i8 {}", m8 / 128);
    println("i16 {}", m16 / 32768);
    println("i32 {}", m32 / 2147483648);
    println("i64 {}", m64 / 9223372036854775808);

    // mid-width shifts keep the same floor rule: -7 >> 1 is -4, not -3
    println("mid {}", -7 / 2);
    println("odd {}", -13 / 4);

    u: u32 = 4294967295;
    println("u32 {}", u / 2147483648);

    Ok(0);
}
