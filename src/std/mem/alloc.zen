//! link: c
// Passable allocator interface plus concrete backend support.
{ Result, IoError, ok, err, ok_ptr } = std.core.result
{ memcpy } = std.c.libc
// These declarations remain here as the public libc allocation boundary.
malloc* = (n: i64) RawPtr<u8>
realloc* = (p: RawPtr<u8>, n: i64) RawPtr<u8>
free* = (p: RawPtr<u8>) void
AllocatorVTable*: {
    vt_alloc: (RawPtr<u8>, i64) RawPtr<u8>,
    vt_remap: (RawPtr<u8>, RawPtr<u8>, i64) RawPtr<u8>,
    vt_free: (RawPtr<u8>, RawPtr<u8>) void,
}
Allocator*: {
    state: RawPtr<u8>,
    vtable: RawPtr<u8>,
    acquire = (a: Allocator, n: i64) RawPtr<u8> { allocator_dispatch_acquire(a, n) }
    resize = (a: Allocator, p: RawPtr<u8>, n: i64) RawPtr<u8> { allocator_dispatch_resize(a, p, n) }
    release = (a: Allocator, p: RawPtr<u8>) void { allocator_dispatch_release(a, p) }
    try_acquire = (a: Allocator, n: i64) Result<RawPtr<u8>, IoError> {
        (n <= 0).then({ .Ok(null_ptr()) }, { ok_ptr(a.acquire(n)) })
    }
    try_resize = (a: Allocator, p: RawPtr<u8>, n: i64) Result<RawPtr<u8>, IoError> {
        ok_ptr(a.resize(p, n))
    }
}
allocator_of* = (state: RawPtr<u8>, vtable: RawPtr<u8>) Allocator {
    Allocator(
        state: state,
        vtable: vtable,
    )
}
allocator_vtable = (a: Allocator) Ptr<AllocatorVTable> {
    slot: [AllocatorVTable] = a.vtable.slice(1)
    slot[0].addr()
}
allocator_dispatch_acquire* = (a: Allocator, n: i64) RawPtr<u8> {
    v = allocator_vtable(a).load()
    v.vt_alloc(a.state, n)
}
allocator_dispatch_resize* = (a: Allocator, p: RawPtr<u8>, n: i64) RawPtr<u8> {
    v = allocator_vtable(a).load()
    v.vt_remap(a.state, p, n)
}
allocator_dispatch_release* = (a: Allocator, p: RawPtr<u8>) void {
    v = allocator_vtable(a).load()
    v.vt_free(a.state, p)
}
// Allocator is passable and storable; this trait supports generic concrete-backend APIs.
AllocatorBackend*: {
    acquire: (MutPtr<Self>, i64) RawPtr<u8>,
    resize: (MutPtr<Self>, RawPtr<u8>, i64) RawPtr<u8>,
    release: (MutPtr<Self>, RawPtr<u8>) void,
    try_acquire = (a: MutPtr<Self>, n: i64) Result<RawPtr<u8>, IoError> {
        // Zero bytes is an empty success even though acquire returns null.
        (n <= 0).then({ .Ok(null_ptr()) }, { ok_ptr(a.acquire(n)) })
    },
    try_resize = (a: MutPtr<Self>, p: RawPtr<u8>, n: i64) Result<RawPtr<u8>, IoError> {
        ok_ptr(a.resize(p, n))
    },
}
Heap*: {
    _: i32,
    allocator = (h: MutPtr<Heap>) Allocator { heap_allocator() }
}
RequestArena*: {
    backing: Allocator,
    head: RawPtr<u8>,
    cur: RawPtr<u8>,
    reset  = (r: MutPtr<RequestArena>) void { r.cur = null_ptr() }
    deinit = (r: MutPtr<RequestArena>) void { request_arena_deinit(r) }
    allocator = (r: MutPtr<RequestArena>) Allocator {
        allocator_of(r.offset(0), request_vtable.addr().offset(0))
    }
}
// Durable process heap. Raw malloc/realloc/free stay at this C backend boundary.
heap_acquire* = (state: RawPtr<u8>, n: i64) RawPtr<u8> {
    (n <= 0).then({ null_ptr() }, { malloc(n) })
}
heap_resize* = (state: RawPtr<u8>, p: RawPtr<u8>, n: i64) RawPtr<u8> {
    out ::= p
    (n <= 0).match ({
        true  => {
            free(p)
            out = null_ptr()
        },
        false => {
            out = realloc(p, n)
        },
    })
    out
}
heap_release* = (state: RawPtr<u8>, p: RawPtr<u8>) void { free(p) }
heap_vtable ::= AllocatorVTable(
    vt_alloc: heap_acquire,
    vt_remap: heap_resize,
    vt_free: heap_release,
)
heap_allocator* = () Allocator { allocator_of(null_ptr(), heap_vtable.addr().offset(0)) }
// Reset retains chunks; the arena and backing state must outlive borrowed Allocators.
RA_HDR = () i64 { 32 }
RA_BLK = () i64 { 16 }
RA_CHUNK0 = () i64 { 4194304 }
ra_next = (c: RawPtr<u8>) RawPtr<u8> { load_i64(c).offset(0) }
ra_set_next = (c: RawPtr<u8>, nx: RawPtr<u8>) void { store_i64(c, to_i64(nx)) }
ra_cap = (c: RawPtr<u8>) i64 { load_i64(c.offset(8)) }
ra_off = (c: RawPtr<u8>) i64 { load_i64(c.offset(16)) }
ra_set_off = (c: RawPtr<u8>, v: i64) void { store_i64(c.offset(16), v) }
ra_size = (p: RawPtr<u8>) i64 { load_i64(p.offset(0 - RA_BLK())) }
ra_chunk = (r: MutPtr<RequestArena>, cap: i64) RawPtr<u8> {
    backing = r.backing
    c = backing.acquire(RA_HDR() + cap)
    (c == null_ptr()).match ({
        true  => c,
        false => {
            ra_set_next(c, null_ptr())
            store_i64(c.offset(8), cap)
            ra_set_off(c, 0)
            c
        },
    })
}
ra_first_unused = (r: MutPtr<RequestArena>) RawPtr<u8> {
    (r.cur == null_ptr()).then({ r.head }, { ra_next(r.cur) })
}
RAFit: {
    prev: RawPtr<u8>,
    found: RawPtr<u8>,
}
ra_find_fit = (prev: RawPtr<u8>, c: RawPtr<u8>, need: i64) RAFit {
    (c == null_ptr() || ra_cap(c) >= need).match ({
        true  => RAFit(
            prev: prev,
            found: c,
        ),
        false => ra_find_fit(c, ra_next(c), need),
    })
}
// Move any fitting unused chunk directly after the active prefix.
ra_take_fit = (r: MutPtr<RequestArena>, need: i64) RawPtr<u8> {
    first = ra_first_unused(r)
    fit = ra_find_fit(r.cur, first, need)
    prev = fit.prev
    found = fit.found
    (found != null_ptr() && found != first).then({
        ra_set_next(prev, ra_next(found))
        (r.cur == null_ptr()).match ({
            true  => {
                ra_set_next(found, r.head)
                r.head = found
            },
            false => {
                ra_set_next(found, ra_next(r.cur))
                ra_set_next(r.cur, found)
            },
        })
    })
    (found != null_ptr()).then({
        ra_set_off(found, 0)
        r.cur = found
    })
    found
}
ra_extend = (r: MutPtr<RequestArena>, need: i64) RawPtr<u8> {
    found = ra_take_fit(r, need)
    (found != null_ptr()).match ({
        true  => found,
        false => {
            grow = (r.cur == null_ptr()).then({ RA_CHUNK0() }, { ra_cap(r.cur) * 2 })
            fresh = ra_chunk(r, (grow < need).then({ need }, { grow }))
            (fresh == null_ptr()).match ({
                true  => fresh,
                false => {
                    after = ra_first_unused(r)
                    ra_set_next(fresh, after)
                    (r.cur == null_ptr()).match ({
                        true  => {
                            r.head = fresh
                            0
                        },
                        false => {
                            ra_set_next(r.cur, fresh)
                            0
                        },
                    })
                    r.cur = fresh
                    fresh
                },
            })
        },
    })
}
ra_fit = (r: MutPtr<RequestArena>, need: i64) RawPtr<u8> {
    c = r.cur
    (c != null_ptr() && ra_cap(c) - ra_off(c) >= need).then({ c }, { ra_extend(r, need) })
}
ra_alloc = (r: MutPtr<RequestArena>, n: i64) RawPtr<u8> {
    need = RA_BLK() + (n + 15) / 16 * 16
    c = (n <= 0 || need < 0).then({ null_ptr() }, { ra_fit(r, need) })
    (c == null_ptr()).match ({
        true  => c,
        false => {
            p = c.offset(RA_HDR() + ra_off(c))
            ra_set_off(c, ra_off(c) + need)
            store_i64(p, n)
            p.offset(RA_BLK())
        },
    })
}
ra_resize = (r: MutPtr<RequestArena>, p: RawPtr<u8>, n: i64) RawPtr<u8> {
    keep = (p == null_ptr()).then({ 0 }, { ra_size(p) })
    q = ra_alloc(r, n)
    (q != null_ptr() && p != null_ptr()).then({
        memcpy(q, p, (keep < n).then({ keep }, { n }))
    })
    q
}
ra_release_all = (backing: Allocator, c: RawPtr<u8>) void {
    (c != null_ptr()).then({
        nx = ra_next(c)
        backing.release(c)
        ra_release_all(backing, nx)
    })
}
request_arena_deinit = (r: MutPtr<RequestArena>) void {
    ra_release_all(r.backing, r.head)
    r.head = null_ptr()
    r.cur = null_ptr()
}
request_arena* = (backing: Allocator) RequestArena {
    RequestArena(
        backing: backing,
        head: null_ptr(),
        cur: null_ptr(),
    )
}
request_acquire = (state: RawPtr<u8>, n: i64) RawPtr<u8> {
    slot: [RequestArena] = state.slice(1)
    r = slot[0].addr()
    ra_alloc(r, n)
}
request_resize = (state: RawPtr<u8>, p: RawPtr<u8>, n: i64) RawPtr<u8> {
    slot: [RequestArena] = state.slice(1)
    r = slot[0].addr()
    ra_resize(r, p, n)
}
request_release = (state: RawPtr<u8>, p: RawPtr<u8>) void { }
request_vtable ::= AllocatorVTable(
    vt_alloc: request_acquire,
    vt_remap: request_resize,
    vt_free: request_release,
)
Heap.impl(AllocatorBackend, {
    acquire = (s: MutPtr<Heap>, n: i64) RawPtr<u8> { heap_acquire(null_ptr(), n) }
    resize  = (s: MutPtr<Heap>, p: RawPtr<u8>, n: i64) RawPtr<u8> { heap_resize(null_ptr(), p, n) }
    release = (s: MutPtr<Heap>, p: RawPtr<u8>) void { heap_release(null_ptr(), p) }
})
RequestArena.impl(AllocatorBackend, {
    acquire = (s: MutPtr<RequestArena>, n: i64) RawPtr<u8> { ra_alloc(s, n) }
    resize  = (s: MutPtr<RequestArena>, p: RawPtr<u8>, n: i64) RawPtr<u8> { ra_resize(s, p, n) }
    release = (s: MutPtr<RequestArena>, p: RawPtr<u8>) void { }
})
Allocator.impl(AllocatorBackend, {
    acquire = (s: MutPtr<Allocator>, n: i64) RawPtr<u8> { allocator_dispatch_acquire(s.load(), n) }
    resize = (s: MutPtr<Allocator>, p: RawPtr<u8>, n: i64) RawPtr<u8> {
        allocator_dispatch_resize(s.load(), p, n)
    }
    release = (s: MutPtr<Allocator>, p: RawPtr<u8>) void { allocator_dispatch_release(s.load(), p) }
})
// Release only an owning slice's base, never a window into another allocation.
// Keeping the slice as the argument lets ownership validation invalidate the local.
release_slice*<T, A: AllocatorBackend> = (a: MutPtr<A>, xs: [T]) void { a.release(xs.ptr) }
// Shared rc/arc/own layout: [count:i64 | value:T].
val_slot*<T> = (base: RawPtr<u8>) [T] { slice(base.offset(8), 1) }
// Returns the block base; callers apply their own pointer wrapper.
rc_block_new_in*<T, A: AllocatorBackend> = (a: MutPtr<A>, x: T) Result<RawPtr<u8>, IoError> {
    v = x
    a.try_acquire(8 + sizeof(T)).match ({
        .Ok(base) => {
            store_i64(base, 1)
            s ::= val_slot<T>(base)
            s[0] = v
            ok(base)
        },
        .Err(e)   => err(e),
    })
}
// Multi-buffer acquisition is atomic: later failure releases every earlier buffer.
Buf2*: {
    b1: RawPtr<u8>,
    b2: RawPtr<u8>,
}
Buf3*: {
    b1: RawPtr<u8>,
    b2: RawPtr<u8>,
    b3: RawPtr<u8>,
}
try_acquire2*<A: AllocatorBackend> = (a: MutPtr<A>, n1: i64, n2: i64) Result<Buf2, IoError> {
    a.try_acquire(n1).match ({
        .Ok(b1) => {
            a.try_acquire(n2).match ({
                .Ok(b2) => {
                    ok: Result<Buf2, IoError> = .Ok(Buf2(
                        b1: b1,
                        b2: b2,
                    ))
                    ok
                },
                .Err(e) => {
                    a.release(b1)
                    err: Result<Buf2, IoError> = .Err(e)
                    err
                },
            })
        },
        .Err(e) => {
            err: Result<Buf2, IoError> = .Err(e)
            err
        },
    })
}
try_acquire3*<A: AllocatorBackend> = (
    a: MutPtr<A>,
    n1: i64,
    n2: i64,
    n3: i64,
) Result<Buf3, IoError> {
    a.try_acquire(n1).match ({
        .Ok(b1) => {
            a.try_acquire(n2).match ({
                .Ok(b2) => {
                    a.try_acquire(n3).match ({
                        .Ok(b3) => {
                            ok: Result<Buf3, IoError> = .Ok(Buf3(
                                b1: b1,
                                b2: b2,
                                b3: b3,
                            ))
                            ok
                        },
                        .Err(e) => {
                            a.release(b1)
                            a.release(b2)
                            err: Result<Buf3, IoError> = .Err(e)
                            err
                        },
                    })
                },
                .Err(e) => {
                    a.release(b1)
                    err: Result<Buf3, IoError> = .Err(e)
                    err
                },
            })
        },
        .Err(e) => {
            err: Result<Buf3, IoError> = .Err(e)
            err
        },
    })
}
