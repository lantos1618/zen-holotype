// std.rand — a deterministic pseudo-random number generator. Pure: no allocator, no hidden heap.
//
// ALGORITHM: xoshiro256** (Blackman & Vigna, 2018) — a fast, well-distributed, integer-only generator
// with 256 bits of state and period 2^256 − 1. Every step runs in u64 where `*`/`+` are C's defined
// unsigned wraparound (mod 2^64) and `>>` is a logical shift (u64 is unsigned) — so the sequence is
// bit-identical on every platform for a given seed. The seed is expanded through splitmix64 (Steele
// et al., 2014) to fill all four state words from a single i64, which also guarantees the state is
// never the all-zero fixed point xoshiro must avoid.
//
// STATE THREADING: the generator MUTATES the Rng IN PLACE through a `MutPtr<Rng>` receiver — the same
// convention the original `seed`/`next` already used. So a draw is `r.next_u64()` (r advances) and no
// new Rng is returned/rebound. The scalar generators (next_u64/next_i64/next/range/next_f64/bool_p)
// are METHODS on Rng; the collection utilities (choice/shuffle/fill_bytes) are free functions taking
// `MutPtr<Rng>` first, called the same way via UFCS: `r.shuffle(xs)`, `r.choice(xs)`.
//
// DETERMINISM: `seed(n)` fully determines the stream — `seed(42)` yields the identical sequence every
// run and on every platform (the property the fuzz harness and tests/harness_rand.zen pin).
//
// NAMING / FLAT-NAMESPACE NOTE: the METHODS (next_u64, range, …) dispatch by receiver type — no import,
// no flat-namespace presence. Only `seed` and the free utilities (`choice`, `shuffle`, `fill_bytes`)
// are top-level names — import them (`{ seed, choice } = std.rand`, or `rand = std.rand` and
// `rand.seed(n)`) and rename on your side if a name collides.
{ Opt } = std.core.result    // choice returns Opt<T> (.Some element / .None when the slice is empty)
// splitmix64 constants: the golden-ratio increment (0x9e3779b97f4a7c15) and two avalanche multipliers.
SM_GAMMA := 11400714819323198485    // 0x9e3779b97f4a7c15
SM_MIX1 := 13787848793156543929    // 0xbf58476d1ce4e5b9
SM_MIX2 := 10723151780598845931    // 0x94d049bb133111eb
// TWO_53 = 2^53: next_f64 divides a 53-bit integer (exactly representable in f64) by this for [0,1).
TWO_53 := 9007199254740992.0
// 256-bit generator state (four u64 words). Construct with `seed`, advance with `.next_u64()` etc.
Rng*: {
    s0: u64,
    s1: u64,
    s2: u64,
    s3: u64,
    // core step: advance the state and return the next full 64-bit value (the whole u64 range).
    next_u64 = (r: MutPtr<Rng>) u64 {
        x0 := r.s0
        x1 := r.s1
        x2 := r.s2
        x3 := r.s3
        // scrambler: rotl(s1 * 5, 7) * 9 (the "**" variant's output function).
        result := (x1 * 5 << 7 | x1 * 5 >> 57) * 9
        t := x1 << 17
        x2 = x2 ^ x0
        x3 = x3 ^ x1
        x1 = x1 ^ x2
        x0 = x0 ^ x3
        x2 = x2 ^ t
        x3 = x3 << 45 | x3 >> 19    // rotl(x3, 45)
        r.s0 = x0
        r.s1 = x1
        r.s2 = x2
        r.s3 = x3
        result
    }
    // the next value reinterpreted as a signed i64 (uniform over the full i64 range, incl. negatives).
    next_i64 = (r: MutPtr<Rng>) i64 {
        v: i64 := r.next_u64()
        v
    }
    // a NON-NEGATIVE i64 in [0, 2^63) — the top 63 bits of a draw. Kept for callers that want a
    // plain non-negative integer (e.g. `r.next() % k` stays non-negative). Prefer next_u64/range.
    next = (r: MutPtr<Rng>) i64 {
        v: i64 := r.next_u64() >> 1
        v
    }
    // uniform integer in [lo, hi) (hi exclusive). Returns lo when hi <= lo.
    //
    // BIAS AVOIDANCE: a bare `next_u64() % span` is biased whenever span does not divide 2^64 — the
    // low `2^64 mod span` residues occur once more often than the rest. We reject them: `t = 2^64 mod
    // span` (computed as `(0 - span) mod span` in u64), draw until the value is >= t, then take `% span`.
    // The surviving range [t, 2^64) is an exact multiple of span, so every bucket is equally likely.
    // Rejection probability is t/2^64 < span/2^64 <= 1/2, so the loop draws < 2 values in expectation.
    range = (r: MutPtr<Rng>, lo: i64, hi: i64) i64 {
        span := hi - lo
        (span <= 0).match ({
            true  => lo,
            false => {
                s: u64 := span
                zero: u64 := 0
                t := (zero - s) % s    // 2^64 mod s: the count of low residues to reject
                x := r.next_u64()
                @while (x < t) {
                    x = r.next_u64()
                }
                w: i64 := x % s
                lo + w
            },
        })
    }
    // a uniform float in [0.0, 1.0): the top 53 bits of a draw (all exactly representable in f64) over 2^53.
    next_f64 = (r: MutPtr<Rng>) f64 {
        bits := r.next_u64() >> 11
        to_f64(bits) / TWO_53
    }
    // true with probability `p` (p<=0 => always false, p>=1 => always true, since next_f64 ∈ [0,1)).
    bool_p = (r: MutPtr<Rng>, p: f64) bool { r.next_f64() < p }
}
// build an Rng from a seed. Any i64 works (including 0 and negatives): the seed is bit-reinterpreted to
// u64 and run through splitmix64 to fill all four state words, so no seed maps to the forbidden all-zero
// state. Same seed => same stream, always.
seed* = (s: i64) Rng {
    z: u64 := s
    z = z + SM_GAMMA
    a := sm_mix(z)
    z = z + SM_GAMMA
    b := sm_mix(z)
    z = z + SM_GAMMA
    c := sm_mix(z)
    z = z + SM_GAMMA
    d := sm_mix(z)
    Rng(
        s0: a,
        s1: b,
        s2: c,
        s3: d,
    )
}
// splitmix64 finalizer: avalanche a counter value into a well-mixed u64. Every op wraps mod 2^64.
sm_mix = (z: u64) u64 {
    v := (z ^ z >> 30) * SM_MIX1
    v = (v ^ v >> 27) * SM_MIX2
    v ^ v >> 31
}
// pick a uniformly random element of `xs`; `.None` when `xs` is empty. Advances `r` in place.
choice*<T> = (r: MutPtr<Rng>, xs: [T]) Opt<T> {
    n := xs.len
    (n <= 0).match ({
        true  => {
            none: Opt<T> := .None
            none
        },
        false => {
            some: Opt<T> := .Some(xs[r.range(0, n)])
            some
        },
    })
}
// in-place Fisher-Yates shuffle: for i from n-1 down to 1, swap xs[i] with a random xs[j], j in [0, i].
// Bounded loop (no recursion); the result is a uniformly random permutation of the input. Advances `r`.
shuffle*<T> = (r: MutPtr<Rng>, xs: [T]) void {
    n := xs.len
    i := n - 1
    @while (i > 0) {
        j := r.range(0, i + 1)
        tmp := xs[i]
        xs[i] = xs[j]
        xs[j] = tmp
        i = i - 1
    }
}
// fill a caller-provided byte buffer with random bytes (no hidden heap). Draws one u64 per 8 bytes,
// emitting its bytes little-endian, so it is ~8x cheaper than a draw per byte. Advances `r`.
fill_bytes* = (r: MutPtr<Rng>, dst: [u8]) void {
    n := dst.len
    i := 0
    @while (i < n) {
        w := r.next_u64()
        k := 0
        @while (k < 8) {
            (i < n).then({
                b: i64 := w & 255
                dst[i] = to_u8(b)
                w = w >> 8
                i = i + 1
            })
            k = k + 1
        }
    }
}
