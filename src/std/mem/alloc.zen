// Explicit allocator interface. Heap, arena, and other allocators share this trait.
// Raw malloc/free stay visible for bootstrap and FFI boundary code.
{ Result, IoError, ok, err, ok_ptr } = std.core.result
// malloc / realloc / free are the allocator's public C floor: callers import them as
// `{ malloc, free } = std.mem.alloc`. The resolver doesn't re-export imported names, so
// these stay DECLARED here (they can't live in std.c.libc without breaking that API).
// Every other libc symbol lives in std.c.libc.
malloc* = (n: i64) RawPtr<u8>
realloc* = (p: RawPtr<u8>, n: i64) RawPtr<u8>
free* = (p: RawPtr<u8>) void
Allocator*: {
    acquire: (MutPtr<Self>, i64) RawPtr<u8>,
    resize: (MutPtr<Self>, RawPtr<u8>, i64) RawPtr<u8>,
    release: (MutPtr<Self>, RawPtr<u8>) void,
}
Heap*: {
    _: i32,
}
Malloc*: {
    _: i32,
}
// ── the canonical malloc/realloc/free floor ───────────────────────────────────────────────────────
// The ONE process-heap allocator body, in erased-vtable shape (state: RawPtr<u8> ignored, so it plugs
// into DynAlloc / Rt vtables directly). Every heap floor in the stdlib routes here: Heap.impl,
// Malloc.impl, dyn_heap(), and std.rt's heap vtable all call these three fns instead of re-inlining
// the `(n<=0)?null:malloc` / realloc / free lines. acquire treats a 0-byte request as a null success.
heap_acquire* = (state: RawPtr<u8>, n: i64) RawPtr<u8> { n <= 0 ? null_ptr() : malloc(n) }
heap_resize* = (state: RawPtr<u8>, p: RawPtr<u8>, n: i64) RawPtr<u8> { realloc(p, n) }
heap_release* = (state: RawPtr<u8>, p: RawPtr<u8>) void { free(p) }
Heap.impl(Allocator, {
    acquire = (s: MutPtr<Heap>, n: i64) RawPtr<u8> { heap_acquire(null_ptr(), n) }
    resize = (s: MutPtr<Heap>, p: RawPtr<u8>, n: i64) RawPtr<u8> { heap_resize(null_ptr(), p, n) }
    release = (s: MutPtr<Heap>, p: RawPtr<u8>) void { heap_release(null_ptr(), p) }
})
// Bootstrap compatibility: compiler entrypoints still take Ptr<Malloc>.
Malloc.impl(Allocator, {
    acquire = (s: MutPtr<Malloc>, n: i64) RawPtr<u8> { heap_acquire(null_ptr(), n) }
    resize = (s: MutPtr<Malloc>, p: RawPtr<u8>, n: i64) RawPtr<u8> { heap_resize(null_ptr(), p, n) }
    release = (s: MutPtr<Malloc>, p: RawPtr<u8>) void { heap_release(null_ptr(), p) }
})
try_acquire*<A> = (a: MutPtr<A>, n: i64) Result<RawPtr<u8>, IoError> {
    // A 0-byte request is an empty success, not OOM: acquire(0) returns null by design, and
    // ok_ptr would mis-map that null to .Err. Short-circuit before reaching ok_ptr.
    n <= 0 ? .Ok(null_ptr()) : ok_ptr(a.acquire(n))
}
try_resize*<A> = (a: MutPtr<A>, p: RawPtr<u8>, n: i64) Result<RawPtr<u8>, IoError> {
    ok_ptr(a.resize(p, n))
}
// ── refcount block: [ count:i64 | value:T ] ────────────────────────────────────────────────────────
// The i64 count lives in the first 8 bytes; the value follows at `.offset(8)`. std.mem.{rc,arc,own}
// all share THIS block shape and differ only in how they bump the count (plain vs atomic) and tear it
// down (free vs Drop) — so the allocate-and-seed step is factored here, not re-inlined three times.
// `val_slot` types the value slot as a 1-element `[T]` over the bytes after the count.
val_slot*<T> = (base: RawPtr<u8>) [T] { slice(base.offset(8), 1) }
// Acquire a [count|value] block from `a`, set the count to 1, and copy `x` into the value slot; return
// the block's base pointer (allocation failure stays in the Result). rc/arc/own `new_in` wrap the
// returned base in their own pointer type; the count-bump and teardown differences stay per-type.
rc_block_new_in*<A, T> = (a: MutPtr<A>, x: T) Result<RawPtr<u8>, IoError> {
    v := x
    a.try_acquire(8 + sizeof(T)).match ({
        .Ok(base) => {
            store_i64(base, 1)
            s := val_slot<T>(base)
            s[0] = v
            ok(base)
        },
        .Err(e)   => err(e),
    })
}
// ── all-or-nothing multi-buffer acquire ──────────────────────────────────────────────────────────
// Acquire N sized buffers from one allocator with ROLLBACK: buffers are acquired in order; if a later
// one OOMs, the ones already acquired are released and the whole thing returns .Err. This is the ONE
// audited home for the "acquire kp → then vp → then ip, release the earlier ones on any failure" ladder
// that map/set/hmap/btree constructors and grow paths all need — hand-rolling that nested rollback is
// exactly where a mis-edited .Err arm silently leaks. The 0-byte rule is inherited from try_acquire
// (n <= 0 is an empty success returning null_ptr(), not OOM). Buf2/Buf3 are the returned buffer bundles.
Buf2*: {
    b1: RawPtr<u8>,
    b2: RawPtr<u8>,
}
Buf3*: {
    b1: RawPtr<u8>,
    b2: RawPtr<u8>,
    b3: RawPtr<u8>,
}
try_acquire2*<A> = (a: MutPtr<A>, n1: i64, n2: i64) Result<Buf2, IoError> {
    a.try_acquire(n1).match ({
        .Ok(b1) => {
            a.try_acquire(n2).match ({
                .Ok(b2) => {
                    ok: Result<Buf2, IoError> := .Ok(Buf2(
                        b1: b1,
                        b2: b2,
                    ))
                    ok
                },
                .Err(e) => {
                    a.release(b1)
                    err: Result<Buf2, IoError> := .Err(e)
                    err
                },
            })
        },
        .Err(e) => {
            err: Result<Buf2, IoError> := .Err(e)
            err
        },
    })
}
try_acquire3*<A> = (a: MutPtr<A>, n1: i64, n2: i64, n3: i64) Result<Buf3, IoError> {
    a.try_acquire(n1).match ({
        .Ok(b1) => {
            a.try_acquire(n2).match ({
                .Ok(b2) => {
                    a.try_acquire(n3).match ({
                        .Ok(b3) => {
                            ok: Result<Buf3, IoError> := .Ok(Buf3(
                                b1: b1,
                                b2: b2,
                                b3: b3,
                            ))
                            ok
                        },
                        .Err(e) => {
                            a.release(b1)
                            a.release(b2)
                            err: Result<Buf3, IoError> := .Err(e)
                            err
                        },
                    })
                },
                .Err(e) => {
                    a.release(b1)
                    err: Result<Buf3, IoError> := .Err(e)
                    err
                },
            })
        },
        .Err(e) => {
            err: Result<Buf3, IoError> := .Err(e)
            err
        },
    })
}
// DynAlloc — an `Allocator` captured as a plain VALUE: a type-erased three-method vtable + opaque
// state. It lets a container STORE a narrow Allocator capability in one concrete field, with no
// generic type parameter and WITHOUT depending on the wider `Rt` bundle (which also carries
// sched/gc/ready). It IS the value form of the `Allocator` trait — the impl below dispatches
// straight through the stored fn-pointers, the same shape `Rt`'s `mem_*` fields take. Build one from
// the process heap (`dyn_heap()`) or any vtable (`dyn_of(...)`). A-wrapper constructors (`vec.new`,
// `set.new`, `hmap.new`) draw `dyn_heap()` once at construction; `new_in`/`from_in` take an explicit
// `DynAlloc` from the caller. `std.rt` remains for pool/actor ambient runtime — not for collections.
DynAlloc*: {
    d_acquire: (RawPtr<u8>, i64) RawPtr<u8>,
    d_resize: (RawPtr<u8>, RawPtr<u8>, i64) RawPtr<u8>,
    d_release: (RawPtr<u8>, RawPtr<u8>) void,
    state: RawPtr<u8>,
}
DynAlloc.impl(Allocator, {
    acquire = (s: MutPtr<DynAlloc>, n: i64) RawPtr<u8> {
        d := s.load()
        d.d_acquire(d.state, n)
    }
    resize = (s: MutPtr<DynAlloc>, p: RawPtr<u8>, n: i64) RawPtr<u8> {
        d := s.load()
        d.d_resize(d.state, p, n)
    }
    release = (s: MutPtr<DynAlloc>, p: RawPtr<u8>) void {
        d := s.load()
        d.d_release(d.state, p)
    }
})
// Erase a raw allocator vtable + state into a DynAlloc value (the erasure constructor).
dyn_of* = (
    acquire: (RawPtr<u8>, i64) RawPtr<u8>,
    resize: (RawPtr<u8>, RawPtr<u8>, i64) RawPtr<u8>,
    release: (RawPtr<u8>, RawPtr<u8>) void,
    state: RawPtr<u8>,
) DynAlloc {
    DynAlloc(
        d_acquire: acquire,
        d_resize: resize,
        d_release: release,
        state: state,
    )
}
// The process-heap allocator as a DynAlloc value (malloc/realloc/free floor; state unused). The
// narrow-capability analog of rt.heap_rt() — a container built from this touches NO ambient rt. The
// three fn-pointers are the canonical heap_* floor above, erased into the DynAlloc vtable.
dyn_heap* = () DynAlloc { dyn_of(heap_acquire, heap_resize, heap_release, null_ptr()) }
