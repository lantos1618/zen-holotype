// Bounds on an impl-supplied member come from the bound declaration, including
// a return-only type parameter that no value argument can reveal.

Boxy = { width: i32 }
Dot = {}

Measurer = {
    measure* ::= <T: Boxy>(self: @Self) i32
}

Tool = {}

Tool.impl(Measurer, {
    measure = <T: Boxy>(self: @Self) i32 { 1 }
})

main = (env: Env) Res<i32, AllocError> {
    println("{}", Tool().measure<Dot>());
    Ok(0);
}
