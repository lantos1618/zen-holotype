// tests/corpus/printing/bool_and_char_print_by_type_not_by_value/main.zen
// Two spellings that carry the same C byte must print DIFFERENTLY when
// their types differ, and two types holding the same value must print
// the SAME — because the writer is picked by the static type and not by
// the expression written:
//
//   - `true` prints `true`, not 1; a dispatch that fell into an integer
//     path would print a plausible digit.
//   - `'A'` IS its byte (str is bytes, lex/char_literal_is_byte.zen), so
//     it prints `65` exactly as the u8 65 beside it does. A printer that
//     special-cased char-literal syntax to write the character instead
//     would look friendlier and be WRONG — the type says u8, u8 prints
//     decimal.
//
// The last row sends both spellings through the SAME format so the two
// writes sit side by side in one line: any drift between "how a literal
// argument lowers" and "how a typed argument lowers" shows as the two
// halves of one line disagreeing.

Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    t: bool = true;
    f: bool = false;
    println("bool {} {} {}", t, false, true);

    b: u8 = 'Q';
    println("char {} byte {} raw {}", 'A', b, 65);
    println("chars {}{}{}", '\n', '!', '.');
    Ok(0);
}
