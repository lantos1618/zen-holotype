Ast, Module, Decl, Function, Struct, Impl, Member, Type, TypeId = std.ast
AllocError = std.mem
Vec = std.collections
str = std.text
Range = std.core
TyId, Types, TyNamed = sema.sema_ty
Checker = sema.sema_check
SemaFault, NameFault = sema.sema_diag

VARARG*: str = "vararg"

// what a call site asks
// The `T` of a resolved `vararg<T>`, and `None` for every other type.
pack_elem* = (types: Types, t: TyId) Res<TyId> {
    types.at(t).match({
        Named(n) => named_pack_elem(n),
        _        => None,
    })
}

named_pack_elem = (n: TyNamed) Res<TyId> {
    n.name.eq(VARARG).match({
        true  => n.args.get(0),
        false => None,
    })
}

pack_slot* = (types: Types, params: Vec<TyId>) Res<usize> {
    (params.len == 0).match({
        true  => None,
        false => tail_slot(types, params, params.len - 1),
    })
}

tail_slot = (types: Types, params: Vec<TyId>, i: usize) Res<usize> {
    params.get(i).match({
        None  => None,
        Ok(t) => slot_of(types, t, i),
    })
}

slot_of = (types: Types, t: TyId, i: usize) Res<usize> {
    pack_elem(types, t).match({
        Ok(_) => Ok(i),
        None  => None,
    })
}

tail_is_pack* = (tree: Ast, f: Function) bool {
    (f.params.len == 0).match({
        true  => false,
        false => param_is_pack(tree, f, f.params.len - 1),
    })
}

param_is_pack = (tree: Ast, f: Function, i: usize) bool {
    f.params.get(i).match({
        None  => false,
        Ok(p) => p.type.match({
            None  => false,
            Ok(t) => written_pack(tree.type_at(t)),
        }),
    })
}

// Written type nodes do not store parents, so positional validation gathers
// all mentions and all legal final-parameter positions before comparing them.

check_varargs* = (c :: Checker) Res<(), AllocError> {
    found ::= c.alloc.Vec<TypeId>();
    c.tree.types_where((node) { written_pack(node) }, found).try();
    (found.len == 0).match({
        true  => Ok(()),
        false => check_mentions(c, found),
    })
}

written_pack* = (node: Type) bool {
    node.kind.match({
        Named(n) => n.name.text.eq(VARARG),
        _        => false,
    })
}

check_mentions = (c :: Checker, found: Vec<TypeId>) Res<(), AllocError> {
    tails ::= c.alloc.Vec<TypeId>();
    collect_tails(c, tails).try();
    found.loop((h, t) { check_mention(c, t, tails).try() });
    Ok(());
}

check_mention = (c :: Checker, t: TypeId, tails: Vec<TypeId>)
                Res<(), AllocError> {
    has_id(tails, t).match({
        true  => check_element(c, t),
        false => report_pack(
            c,
            t,
            SemaFault.VarargNotLast(NameFault(name: VARARG))
        ),
    })
}

// A pack has exactly one element argument, which cannot itself be a pack.
check_element = (c :: Checker, t: TypeId) Res<(), AllocError> {
    element_ok(c, t).match({
        true  => Ok(()),
        false => report_pack(
            c,
            t,
            SemaFault.VarargElement(NameFault(name: VARARG))
        ),
    })
}

element_ok = (c: Checker, t: TypeId) bool {
    c.tree.type_at(t).kind.match({
        Named(n) => (n.args.len == 1) && !element_is_pack(c, n.args),
        _        => false,
    })
}

element_is_pack = (c: Checker, args: Vec<TypeId>) bool {
    args.get(0).match({
        None  => false,
        Ok(a) => written_pack(c.tree.type_at(a)),
    })
}

report_pack = (c :: Checker, t: TypeId, fault: SemaFault) Res<(), AllocError> {
    node = c.tree.type_at(t);
    c.report(node.span.file, node.span, fault)
}

collect_tails = (c :: Checker, out :: Vec<TypeId>) Res<(), AllocError> {
    Range(0, c.tree.module_count()).loop((h, mi) {
        c.tree.module_at(mi).match({
            Ok(m) => module_tails(m, out),
            None  => Ok(()),
        }).try();
    });
    Ok(());
}

module_tails = (m: Module, out :: Vec<TypeId>) Res<(), AllocError> {
    m.decls.loop((h, d) { decl_tails(d, out).try() });
    Ok(());
}

decl_tails = (d: Decl, out :: Vec<TypeId>) Res<(), AllocError> {
    d.kind.match({
        Function(f) => fn_tail(f, out),
        Struct(s)   => member_tails(s.members, out),
        Impl(im)    => member_tails(im.members, out),
        _           => Ok(()),
    })
}

member_tails = (members: Vec<Member>, out :: Vec<TypeId>)
               Res<(), AllocError> {
    members.loop((h, mem) {
        mem.kind.match({
            Function(f) => fn_tail(f, out),
            _           => Ok(()),
        }).try();
    });
    Ok(());
}

fn_tail = (f: Function, out :: Vec<TypeId>) Res<(), AllocError> {
    (f.params.len == 0).match({
        true  => Ok(()),
        false => tail_param(f, f.params.len - 1, out),
    })
}

tail_param = (f: Function, i: usize, out :: Vec<TypeId>)
             Res<(), AllocError> {
    f.params.get(i).match({
        None  => Ok(()),
        Ok(p) => p.type.match({
            None  => Ok(()),
            Ok(t) => out.add(t),
        }),
    })
}

has_id = (ids: Vec<TypeId>, want: TypeId) bool {
    Range(0, ids.len).find((i) {
        ids.get(i).match({ Ok(t) => t.index == want.index, None => false })
    }).match({ Ok(_) => true, None => false })
}
