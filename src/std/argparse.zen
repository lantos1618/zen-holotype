// Declarative argument parser. parse() receives arguments without the program name and accepts long
// options, bundled short flags, attached values, and -- as the end-of-options marker.
// Parse failures are ArgError values, never panics. --help/-h suppress required-argument validation.
{ AllocatorBackend, Allocator } = std.mem.alloc
{ Result, Opt, expect } = std.core.result
{ len, view, starts_with, trim_prefix, find, substr_in, nbuf } = std.text.str
{ String } = std.text.string
{ loop_at } = std.core.count
// A `short` of 0 means "no short form". `name` is the long name WITHOUT the leading `--`.
FlagSpec: {
    name: StringView,
    short: u8,
    help: StringView,
}
OptSpec: {
    name: StringView,
    short: u8,
    help: StringView,
    req: bool,
}
PosSpec: {
    name: StringView,
    help: StringView,
    req: bool,
}
// A parse failure, as a value. Each carries the offending token / argument name.
//   UnknownFlag     — a `--flag` / `-f` the parser was not told about
//   MissingValue    — an option that takes a value was given none (last token, or nothing after it)
//   MissingRequired — a `.option_req` / `.positional_req` argument was absent
//   NoValueAllowed  — a boolean flag was written as `--flag=value`
ArgError: UnknownFlag(StringView) | MissingValue(StringView) | MissingRequired(StringView) | NoValueAllowed(StringView)
// Human-readable variant name (mirrors std.core.result's `name`) so error paths can print which kind
// fired without unpacking the payload: `println(e.ap_error_name())`.
ap_error_name = (e: ArgError) StringView { e.variant_name() }
// ── small internal builders (top-level names carry an `ap_` prefix to stay unique on the flat namespace) ──
ap_unknown = (s: StringView) ArgError { .UnknownFlag(s) }
ap_missing_value = (s: StringView) ArgError { .MissingValue(s) }
ap_missing_required = (s: StringView) ArgError { .MissingRequired(s) }
ap_no_value = (s: StringView) ArgError { .NoValueAllowed(s) }
ap_some = (v: StringView) Opt<StringView> { .Some(v) }
ap_none = () Opt<StringView> { .None }
// append one element to a slice, copied into a fresh allocator-owned buffer of length +1.
ap_add<T> = (a: AllocatorBackend, xs: MutSlice<T>, x: T) MutSlice<T> {
    n = xs.len
    out :: MutSlice<T> = slice(a
        .try_acquire((n + 1) * sizeof(T))
        .expect("std.argparse: out of memory"), n + 1)
    xs.loop_at((i, e) { out[i] = e })
    out[n] = x
    out
}
// an all-false `MutSlice<bool>` of length `n` (parallel to the flag specs).
ap_bools = (a: AllocatorBackend, n: i64) MutSlice<bool> {
    out :: MutSlice<bool> = a.nbuf(false, n)
    out.loop_at((i, e) { out[i] = false })
    out
}
// an all-`.None` `MutSlice<Opt<str>>` of length `n` (parallel to the option specs).
ap_opts = (a: AllocatorBackend, n: i64) MutSlice<Opt<StringView>> {
    seed: Opt<StringView> = .None
    out :: MutSlice<Opt<StringView>> = a.nbuf(seed, n)
    out.loop_at((i, e) { out[i] = seed })
    out
}
// ── the parser spec ──────────────────────────────────────────────────────────
Parser*: {
    prog: StringView,
    flags: MutSlice<FlagSpec>,
    opts: MutSlice<OptSpec>,
    poss: MutSlice<PosSpec>,
    flag = (p: Parser, a: AllocatorBackend, name: StringView, short: u8, help: StringView) Parser {
        Parser(
            prog: p.prog,
            flags: a.ap_add(p.flags, FlagSpec(
                name: name,
                short: short,
                help: help,
            )),
            opts: p.opts,
            poss: p.poss,
        )
    }
    option = (
        p: Parser,
        a: AllocatorBackend,
        name: StringView,
        short: u8,
        help: StringView,
    ) Parser {
        Parser(
            prog: p.prog,
            flags: p.flags,
            opts: a.ap_add(p.opts, OptSpec(
                name: name,
                short: short,
                help: help,
                req: false,
            )),
            poss: p.poss,
        )
    }
    option_req = (
        p: Parser,
        a: AllocatorBackend,
        name: StringView,
        short: u8,
        help: StringView,
    ) Parser {
        Parser(
            prog: p.prog,
            flags: p.flags,
            opts: a.ap_add(p.opts, OptSpec(
                name: name,
                short: short,
                help: help,
                req: true,
            )),
            poss: p.poss,
        )
    }
    positional = (p: Parser, a: AllocatorBackend, name: StringView, help: StringView) Parser {
        Parser(
            prog: p.prog,
            flags: p.flags,
            opts: p.opts,
            poss: a.ap_add(p.poss, PosSpec(
                name: name,
                help: help,
                req: false,
            )),
        )
    }
    positional_req = (p: Parser, a: AllocatorBackend, name: StringView, help: StringView) Parser {
        Parser(
            prog: p.prog,
            flags: p.flags,
            opts: p.opts,
            poss: a.ap_add(p.poss, PosSpec(
                name: name,
                help: help,
                req: true,
            )),
        )
    }
    flag_index = (p: Parser, name: StringView) i64 {
        // spec lookups: index into the parallel result arrays (-1 when absent).
        idx :: i64 = 0 - 1
        p.flags.loop((h, i, f) {
            (f.name == name).then({
                idx = i
                h.break
            })
        })
        idx
    }
    flag_by_short = (p: Parser, c: u8) i64 {
        idx :: i64 = 0 - 1
        p.flags.loop((h, i, f) {
            (f.short == c).then({
                idx = i
                h.break
            })
        })
        idx
    }
    opt_index = (p: Parser, name: StringView) i64 {
        idx :: i64 = 0 - 1
        p.opts.loop((h, i, o) {
            (o.name == name).then({
                idx = i
                h.break
            })
        })
        idx
    }
    opt_by_short = (p: Parser, c: u8) i64 {
        idx :: i64 = 0 - 1
        p.opts.loop((h, i, o) {
            (o.short == c).then({
                idx = i
                h.break
            })
        })
        idx
    }
    req_pos_count = (p: Parser) i64 {
        // number of required positionals (they are satisfied left-to-right).
        c :: i64 = 0
        p.poss.loop_at((i, ps) {
            ps.req.then({
                c = c + 1
            })
        })
        c
    }
    parse = (p: Parser, a: AllocatorBackend, args: MutSlice<StringView>) Result<Parsed, ArgError> {
        // parse — see the free `ap_parse` below; this is the UFCS entry `p.parse(a, args)`.
        a.ap_parse(p, args)
    }
    usage = (p: Parser, a: Allocator) StringView {
        // A one-line-per-item allocator-owned usage / help string. Carried String records the first
        // allocation failure and later operations no-op; finish_cstr reports OOM consistently.
        b ::= a.String()
            .add("usage: ").add(p.prog).add(" [options]")
        p.poss.loop_at((i, ps) {
            b = b
                .add(" ").add(ps.req.then({ "<" }, { "[" })).add(ps.name)
                .add(ps.req.then({ ">" }, { "]" }))
        })
        b = b.add_one('\n')
        p.flags.loop_at((i, f) {
            b = b
                .add("  --").add(f.name).add("  ").add(f.help)
                .add_one('\n')
        })
        p.opts.loop_at((i, o) {
            b = b
                .add("  --").add(o.name).add(" VALUE  ").add(o.help)
                .add_one('\n')
        })
        b.finish_cstr()
    }
}
// a fresh parser with no specs. Build it up with the `.flag` / `.option` / `.positional` methods.
ap_new* = (prog: StringView) Parser {
    fs: MutSlice<FlagSpec> = slice(null_ptr(), 0)
    os: MutSlice<OptSpec> = slice(null_ptr(), 0)
    ps: MutSlice<PosSpec> = slice(null_ptr(), 0)
    Parser(
        prog: prog,
        flags: fs,
        opts: os,
        poss: ps,
    )
}
// ── the parsed result ────────────────────────────────────────────────────────
// `flags` is parallel to `spec.flags` (true when the flag was seen), `opts` parallel to `spec.opts`
// (`.Some(value)` when the option was given). `poss` is the collected positionals, in order.
Parsed: {
    spec: Parser,
    flags: MutSlice<bool>,
    opts: MutSlice<Opt<StringView>>,
    poss: MutSlice<StringView>,
    help: bool,
    get_flag = (r: Parsed, name: StringView) bool {
        // was `--<name>` / `-<short>` given? (unknown names read as false)
        fi = r.spec.flag_index(name)
        (fi >= 0).then({ r.flags[fi] }, { false })
    }
    get_opt = (r: Parsed, name: StringView) Opt<StringView> {
        // the value of `--<name>`, or `.None` (unknown names also read as `.None`).
        oi = r.spec.opt_index(name)
        (oi >= 0).then({ r.opts[oi] }, { ap_none() })
    }
    positionals = (r: Parsed) MutSlice<StringView> {
        // the positional arguments, in the order they appeared.
        r.poss
    }
    pos_at = (r: Parsed, i: i64) Opt<StringView> {
        // the i-th positional, or `.None` when out of range.
        (i >= 0 && i < r.poss.len).then({ ap_some(r.poss[i]) }, { ap_none() })
    }
    help_requested = (r: Parsed) bool {
        // did the arguments include `--help` / `-h`?
        r.help
    }
}
// ── the parse driver ─────────────────────────────────────────────────────────
// Walk `args` (the arguments AFTER the program name). Returns the filled `Parsed`, or the first
// `ArgError` encountered. `a` owns every allocation in the result.
ap_parse = (a: AllocatorBackend, p: Parser, args: MutSlice<StringView>) Result<Parsed, ArgError> {
    flags :: MutSlice<bool> = a.ap_bools(p.flags.len)
    optvals :: MutSlice<Opt<StringView>> = a.ap_opts(p.opts.len)
    poss :: MutSlice<StringView> = a.nbuf("", args.len)    // upper bound: every arg a positional
    np :: i64 = 0
    help ::= false
    end ::= false
    skip :: i64 = 0 - 1    // index whose value a preceding option already consumed
    has_err ::= false
    the_err :: ArgError = .UnknownFlag("")
    args.loop((h, i, tok) {
        (i <= skip == false).then({
            tv = tok.view()
            nlen = tv.len
            end.match ({
                true  => {
                    poss[np] = tok
                    np = np + 1
                },
                false => (nlen == 2 && tv[0] == '-' && tv[1] == '-').match ({
                    true  => {
                        end = true
                    },
                    false => tok.starts_with("--").match ({
                        true  => {
                            // ── long: --name / --name=value ──
                            rest = tok.trim_prefix("--")
                            eqi = rest.find("=")
                            (eqi >= 0).match ({
                                true  => {
                                    name = a.substr_in(rest, 0, eqi).expect("argparse: oom")
                                    val = a
                                        .substr_in(rest, eqi + 1, rest.len() - (eqi + 1))
                                        .expect("argparse: oom")
                                    oi = p.opt_index(name)
                                    (oi >= 0).match ({
                                        true  => {
                                            optvals[oi] = ap_some(val)
                                        },
                                        false => (p.flag_index(name) >= 0).match ({
                                            true  => {
                                                the_err = ap_no_value(tok)
                                                has_err = true
                                                h.break
                                            },
                                            false => {
                                                the_err = ap_unknown(tok)
                                                has_err = true
                                                h.break
                                            },
                                        }),
                                    })
                                },
                                false => (rest == "help").match ({
                                    true  => {
                                        help = true
                                    },
                                    false => {
                                        fi = p.flag_index(rest)
                                        (fi >= 0).match ({
                                            true  => {
                                                flags[fi] = true
                                            },
                                            false => {
                                                oi = p.opt_index(rest)
                                                (oi >= 0).match ({
                                                    true  => (i + 1 < args.len).match ({
                                                        true  => {
                                                            optvals[oi] = ap_some(args[i + 1])
                                                            skip = i + 1
                                                        },
                                                        false => {
                                                            the_err = ap_missing_value(rest)
                                                            has_err = true
                                                            h.break
                                                        },
                                                    }),
                                                    false => {
                                                        the_err = ap_unknown(tok)
                                                        has_err = true
                                                        h.break
                                                    },
                                                })
                                            },
                                        })
                                    },
                                }),
                            })
                        },
                        false => (nlen >= 2 && tv[0] == '-').match ({
                            true  => {
                                // ── short: -f, bundled -abc, attached -ovalue, or -o value ──
                                stop ::= false
                                tv.loop((hc, j, c) {
                                    ((j == 0 || stop || has_err) == false).then({
                                        fi = p.flag_by_short(c)
                                        (fi >= 0).match ({
                                            true  => {
                                                flags[fi] = true
                                            },
                                            false => {
                                                oi = p.opt_by_short(c)
                                                (oi >= 0).match ({
                                                    true  => (j + 1 < tv.len).match ({
                                                        true  => {
                                                            val = a
                                                                .substr_in(tok, j + 1, tv.len - (j + 1))
                                                                .expect("argparse: oom")
                                                            optvals[oi] = ap_some(val)
                                                            stop = true
                                                        },
                                                        false => (i + 1 < args.len).match ({
                                                            true  => {
                                                                optvals[oi] = ap_some(args[i + 1])
                                                                skip = i + 1
                                                            },
                                                            false => {
                                                                the_err = ap_missing_value(p.opts[oi].name)
                                                                has_err = true
                                                                hc.break
                                                            },
                                                        }),
                                                    }),
                                                    false => (c == 'h').match ({
                                                        true  => {
                                                            help = true
                                                        },
                                                        false => {
                                                            the_err = ap_unknown(tok)
                                                            has_err = true
                                                            hc.break
                                                        },
                                                    }),
                                                })
                                            },
                                        })
                                    })
                                })
                                has_err.then({
                                    h.break
                                })
                            },
                            false => {
                                // ── bare token (or "-") → positional ──
                                poss[np] = tok
                                np = np + 1
                            },
                        }),
                    }),
                }),
            })
        })
    })
    // required-argument validation (skipped when help was requested).
    (help == false).then({
        (has_err == false).then({
            p.opts.loop((h, i, o) {
                o.req.then({
                    optvals[i].match ({
                        .Some(v) => { },
                        .None    => {
                            the_err = ap_missing_required(o.name)
                            has_err = true
                            h.break
                        },
                    })
                })
            })
            rq = p.req_pos_count()
            (has_err == false).then({
                (np < rq).then({
                    the_err = ap_missing_required(p.poss[np].name)
                    has_err = true
                })
            })
        })
    })
    out: Result<Parsed, ArgError> = has_err.match ({
        true  => .Err(the_err),
        false => .Ok(Parsed(
            spec: p,
            flags: flags,
            opts: optvals,
            poss: slice(poss.ptr, np),
            help: help,
        )),
    })
    out
}
