// compiler.validate.nullalloc — the ALLOCATION-RESULT nullability rule (`alloc-null`).
//
// WHY A SECOND NULLABILITY PASS. compiler.passes.ptrkind exempts `RawPtr<u8>` from the type-based
// rule (`is_nullable_ptr_ty`) and its comment states the reason exactly: `null_ptr()` and `malloc()`
// have the SAME TYPE, so a pass that reads only types cannot tell a fresh allocation from a
// deliberate null, and rejecting the whole spelling would reject the allocator/FFI floor itself.
// That reasoning is correct and is left standing — this pass adds the axis the type does not carry:
// PROVENANCE. A value is flagged only when it demonstrably came from an ALLOCATOR CALL and is
// dereferenced with no null proof anywhere in the function. `null_ptr()`, foreign returns, pointer
// parameters and struct fields are all untouched, so the floor keeps every use it was exempted for.
//
// SCOPE, stated as under-reports (this pass never rejects a program that does check):
//   * BARE LOCALS only. A pointer stored into a struct field (`String(ptr: a.acquire(cap))`) or a
//     slice element is not tracked — same bare-locals scope as the ownership/escape passes.
//   * INTRAPROCEDURAL. An allocation returned through a wrapper is the wrapper's obligation; the
//     caller sees an ordinary pointer. An audited wrapper that checks IS the fix for its callers.
//   * BODY-WIDE, not path-sensitive: ANY proof of a name anywhere in its function discharges it.
{ BinData, CallData, Decl, Expr, Func, MethodCallData, Stmt } = compiler.ast.ast_types
{ expr_fold_children } = compiler.ast.expr_children
{ Malloc } = std.mem.alloc
{ DeadList, dead_cons, dead_has, dead_nil, expr_root_var } = compiler.validate.ownership
{ expr_pos, is_deref_intrinsic, pos_or } = compiler.validate.util
{ sx_named } = compiler.validate.args
{ CheckDiagnostic, KALLOCNULL } = compiler.validate.diag
{ check_diagnostic_from_source, check_diagnostic_none, kv_at } = compiler.validate.core
nz_or = (a: i32, b: i32) i32 { (a == 0).then({ b }, { a }) }
// The allocator verbs, matched by NAME + ARITY in BOTH surface forms — this pass runs PRE-desugar,
// so `a.acquire(n)` is a MethodCall and `acquire(a, n)` a flat Call. `nargs` always counts the
// receiver. Suffix-matching (`sx_named`) catches the namespace-bind alias (`m.acquire` -> `m__acquire`),
// the same discipline the ownership pass applies to release/drop.
is_alloc_verb = (fn: string_view, nargs: i64) bool {
    fn.sx_named("acquire", "__acquire") && nargs == 2
        || fn.sx_named("resize", "__resize") && nargs == 3
        || fn.sx_named("heap_acquire", "__heap_acquire") && nargs == 2
        || fn.sx_named("heap_resize", "__heap_resize") && nargs == 3
        || fn.sx_named("heap_request_acquire", "__heap_request_acquire") && nargs == 1
        || fn.sx_named("malloc", "__malloc") && nargs == 1
        || fn.sx_named("realloc", "__realloc") && nargs == 2
}
is_alloc_expr* = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Call(c)        => is_alloc_verb(c.fn, c.args.len),
        .MethodCall(mc) => is_alloc_verb(mc.method, mc.args.len + 1),
        _               => false,
    })
}
// The three ways a program discharges an allocation result. `assert_nonnull` turns failure into the
// named panic `zen: panic: null pointer deref`; `is_null` is the hand-rolled test; `ok_ptr` is the
// OOM-as-value lift (`Result.Err` on null) that std.mem's `try_acquire` is built from.
is_proof_verb = (fn: string_view) bool {
    fn.sx_named("is_null", "__is_null")
        || fn.sx_named("assert_nonnull", "__assert_nonnull")
        || fn.sx_named("ok_ptr", "__ok_ptr")
}
nz_is_null_lit = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Call(c) => c.fn == "null_ptr",
        .Int(n)  => n == 0,
        _        => false,
    })
}
// the local a proof expression discharges, or "": `assert_nonnull(p)` / `p.is_null()` / `ok_ptr(p)` /
// `p == null_ptr()`. Comparison covers `!=` too — either arm of the test proves the pointer on the
// path the program cares about, and this pass is body-wide anyway.
nz_proof_name = (e: Ptr<Expr>) string_view {
    load(e).match ({
        .Call(c)        => (is_proof_verb(c.fn) && c.args.len >= 1).match ({
            true  => c.args[0].addr().expr_root_var(),
            false => "",
        }),
        .MethodCall(mc) => is_proof_verb(mc.method).then({ mc.recv.expr_root_var() }, { "" }),
        .Bin(b)         => (b.op == "==" || b.op == "!=").match ({
            true  => b.rhs.nz_is_null_lit().match ({
                true  => b.lhs.expr_root_var(),
                false => b.lhs.nz_is_null_lit().then({ b.rhs.expr_root_var() }, { "" }),
            }),
            false => "",
        }),
        _               => "",
    })
}
// ── pass 1: every local PROVEN anywhere in the body ───────────────────────────────────────────────
nz_proofs_expr = (a: MutPtr<Malloc>, acc: Ptr<DeadList>, e: Ptr<Expr>) Ptr<DeadList> {
    nm := e.nz_proof_name()
    seed := (nm == "").then({ acc }, { a.dead_cons(nm, acc) })
    seed.expr_fold_children(e, (s, ch) { a.nz_proofs_expr(s, ch) }, (s, b) {
        a.nz_proofs_body(s, b)
    })
}
nz_proofs_stmt = (a: MutPtr<Malloc>, acc: Ptr<DeadList>, st: Stmt) Ptr<DeadList> {
    st.match ({
        .Let(l)      => a.nz_proofs_expr(acc, l.value),
        .Assign(x)   => a.nz_proofs_expr(a.nz_proofs_expr(acc, x.target), x.value),
        .Return(r)   => a.nz_proofs_expr(acc, r),
        .ExprStmt(e) => a.nz_proofs_expr(acc, e),
        .If(f)       => a.nz_proofs_body(a.nz_proofs_body(a.nz_proofs_expr(acc, f.c), f.then), f.els),
        .While(w)    => a.nz_proofs_body(a.nz_proofs_expr(acc, w.c), w.body),
        .IndexSet(x) => a.nz_proofs_expr(a.nz_proofs_expr(a.nz_proofs_expr(acc, x.seq), x.idx), x.value),
    })
}
nz_proofs_body* = (a: MutPtr<Malloc>, acc: Ptr<DeadList>, body: [Stmt]) Ptr<DeadList> {
    out := acc
    body.loop((h, i, st) {
        out = a.nz_proofs_stmt(out, st)
    })
    out
}
// ── pass 2: every local BOUND to an allocation and never proven ───────────────────────────────────
nz_bind = (
    a: MutPtr<Malloc>,
    proven: Ptr<DeadList>,
    acc: Ptr<DeadList>,
    name: string_view,
    value: Ptr<Expr>,
) Ptr<DeadList> {
    (name == "" == false && value.is_alloc_expr() && proven.dead_has(name) == false).match ({
        true  => a.dead_cons(name, acc),
        false => acc,
    })
}
nz_unproven_expr = (
    a: MutPtr<Malloc>,
    proven: Ptr<DeadList>,
    acc: Ptr<DeadList>,
    e: Ptr<Expr>,
) Ptr<DeadList> {
    acc.expr_fold_children(e, (s, ch) { a.nz_unproven_expr(proven, s, ch) }, (s, b) {
        a.nz_unproven_body(proven, s, b)
    })
}
nz_unproven_stmt = (
    a: MutPtr<Malloc>,
    proven: Ptr<DeadList>,
    acc: Ptr<DeadList>,
    st: Stmt,
) Ptr<DeadList> {
    st.match ({
        .Let(l)      => a.nz_unproven_expr(proven, a.nz_bind(proven, acc, l.name, l.value), l.value),
        .Assign(x)   => a.nz_unproven_expr(proven, a.nz_bind(proven, acc, x.target.expr_root_var(), x.value), x.value),
        .Return(r)   => a.nz_unproven_expr(proven, acc, r),
        .ExprStmt(e) => a.nz_unproven_expr(proven, acc, e),
        .If(f)       => a.nz_unproven_body(proven, a.nz_unproven_body(proven, a.nz_unproven_expr(proven, acc, f.c), f.then), f.els),
        .While(w)    => a.nz_unproven_body(proven, a.nz_unproven_expr(proven, acc, w.c), w.body),
        .IndexSet(x) => a.nz_unproven_expr(proven, acc, x.value),
    })
}
nz_unproven_body* = (
    a: MutPtr<Malloc>,
    proven: Ptr<DeadList>,
    acc: Ptr<DeadList>,
    body: [Stmt],
) Ptr<DeadList> {
    out := acc
    body.loop((h, i, st) {
        out = a.nz_unproven_stmt(proven, out, st)
    })
    out
}
// ── pass 3: report the first deref of an unproven allocation ──────────────────────────────────────
// the pointer OPERAND of a deref: the allocation call itself (`slice(a.acquire(n), k)` — the
// dominant shape in this tree) or a bare local that is still carrying one.
nz_subject_kind = (un: Ptr<DeadList>, s: Ptr<Expr>, pos: i32) i32 {
    at := load(s).expr_pos().pos_or(pos)
    s.is_alloc_expr().match ({
        true  => KALLOCNULL().kv_at(at),
        false => load(s).match ({
            .Var(v) => un.dead_has(v.name).then({ KALLOCNULL().kv_at(at) }, { 0 }),
            _       => 0,
        }),
    })
}
nz_deref_kind = (un: Ptr<DeadList>, e: Ptr<Expr>) i32 {
    load(e).match ({
        .Call(c)        => (c.fn.is_deref_intrinsic() && c.args.len >= 1).match ({
            true  => un.nz_subject_kind(c.args[0].addr(), c.pos),
            false => 0,
        }),
        .MethodCall(mc) => mc.method.is_deref_intrinsic().match ({
            true  => un.nz_subject_kind(mc.recv, mc.pos),
            false => 0,
        }),
        .Arrow(ar)      => un.nz_subject_kind(ar.obj, 0),
        _               => 0,
    })
}
nz_expr_kind = (un: Ptr<DeadList>, e: Ptr<Expr>) i32 {
    un
        .nz_deref_kind(e)
        .nz_or(0.expr_fold_children(e, (s, ch) { s.nz_or(un.nz_expr_kind(ch)) }, (s, b) {
            s.nz_or(un.nz_body_kind(b))
        }))
}
nz_stmt_kind = (un: Ptr<DeadList>, st: Stmt) i32 {
    st.match ({
        .Let(l)      => un.nz_expr_kind(l.value),
        .Assign(x)   => un.nz_expr_kind(x.target).nz_or(un.nz_expr_kind(x.value)),
        .Return(r)   => un.nz_expr_kind(r),
        .ExprStmt(e) => un.nz_expr_kind(e),
        .If(f)       => un
            .nz_expr_kind(f.c)
            .nz_or(un.nz_body_kind(f.then))
            .nz_or(un.nz_body_kind(f.els)),
        .While(w)    => un.nz_expr_kind(w.c).nz_or(un.nz_body_kind(w.body)),
        .IndexSet(x) => un
            .nz_expr_kind(x.seq)
            .nz_or(un.nz_expr_kind(x.idx))
            .nz_or(un.nz_expr_kind(x.value)),
    })
}
nz_body_kind* = (un: Ptr<DeadList>, body: [Stmt]) i32 {
    acc := 0
    body.loop((h, i, st) {
        acc = acc.nz_or(un.nz_stmt_kind(st))
    })
    acc
}
nz_func_kind* = (a: MutPtr<Malloc>, f: Func) i32 {
    proven := a.nz_proofs_body(a.dead_nil(), f.body)
    a.nz_unproven_body(proven, a.dead_nil(), f.body).nz_body_kind(f.body)
}
check_module_nullalloc_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    acc := 0
    decls.loop((h, i, d) {
        acc = acc.nz_or(d.match ({
            .DFunc(f) => a.nz_func_kind(f),
            _         => 0,
        }))
    })
    acc
}
check_module_nullalloc_diagnostic_from_source* = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    src: string_view,
) CheckDiagnostic {
    packed := a.check_module_nullalloc_kind(decls)
    (packed == 0).then({ check_diagnostic_none() }, { src.check_diagnostic_from_source(packed, 1) })
}
