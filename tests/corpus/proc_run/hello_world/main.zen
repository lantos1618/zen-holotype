// env.proc.run spawns a shell, captures stdout/stderr, and returns the
// child's exit code. This test exercises the capability end-to-end.

AllocError = std.mem

main = (env: Env) Res<i32, AllocError> {
    out = env.proc.run(env.mem.alloc(), "", "echo hello world").match({
        Ok(r)  => {
            println("code={}", r.code);
            println("out={}", r.out.view());
            println("err={}", r.err.view());
            0
        },
        Err(e) => {
            e.match({
                SpawnFailed => println("spawn failed"),
                WaitFailed  => println("wait failed"),
                ReadFailed  => println("read failed"),
            });
            1
        },
    });
    Ok(out)
}
