Ast = std.ast.ast_arena
Pos, Span = std.ast.ast_span
AllocError = std.mem
String = std.text
Checker = sema.sema_check
TyId = sema.sema_ty
CBackend, LocalSlot = gen.gen_c
write_name_slot = gen.gen_c.gen_c_expr
write_scope_slot = gen.gen_c.gen_c_scope

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    tree  ::= alloc.Ast();
    check ::= alloc.Checker(tree).try();
    be    ::= alloc.CBackend(tree, check).try();
    slot       = LocalSlot(
        name: "f",
        index: 0,
        ty: TyId(index: 0),
        by_ref: false,
        handle: 0,
        closure: 1
    );
    read_span  = Span(
        file: "in.zen",
        start: Pos(line: 4, col: 7),
        end: Pos(line: 4, col: 8)
    );
    scope_span = Span(
        file: "in.zen",
        start: Pos(line: 5, col: 9),
        end: Pos(line: 5, col: 10)
    );
    read ::= alloc.String().try();
    be.write_name_slot("f", read_span, slot, read).try();
    scope ::= alloc.String().try();
    be.write_scope_slot("f", scope_span, slot, scope).try();
    faults ::= alloc.String().try();
    be.render_diags(faults).try();
    println("read: {}", read.view());
    println("scope: {}", scope.view());
    println("faults:\n{}", faults.view());
    Ok(0)
}
