// #814: `Env.var` copied the NAME into a fixed 4096-byte C buffer and, at
// or past the cap, returned the same NULL-data str the unset path returns --
// "too long for my buffer" and "no such variable" were one answer, exit 0.
// Linux getenv imposes no name limit, so the floor now sizes its buffer
// from the name and there is no number to document or drift.
//
// The runner exports two names for THIS program alone (tests/run.py, the
// tid-keyed block beside HARNESS_EPOCH): 5039 bytes of 'V' and exactly 4096
// of 'B' -- past the old cap and at its edge. Both must read PRESENT, and a
// name nobody exported must still read absent, so the two answers stay
// distinguishable.
main = (env: Env) Res<i32, IoError> {
    over = env.var(
        ""
    ).match({
        Ok(_) => "5039 present",
        None  => "5039 absent",
    });
    println("{}", over);
    at = env.var(
        ""
    ).match({
        Ok(_) => "4096 present",
        None  => "4096 absent",
    });
    println("{}", at);
    env.var("ZEN_NO_SUCH_VARIABLE_EXISTS_ANYWHERE").match({
        Ok(_) => println("the absent name is somehow set"),
        None  => println("the absent name is absent"),
    });
    Ok(0);
}
