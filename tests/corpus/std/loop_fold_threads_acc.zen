// tests/corpus/std/loop_fold_threads_acc.zen
// fold: init seeds acc, acc threads by value through the passes,
// the loop evaluates to the final acc. over a stack array with a
// capture-free body this is a plain C for-loop - see
// tests/bench/bench_loop.zen, which gates it at allocs_op: 0

main = (env: Env) Res<i32, AllocError> {
    values = [1, 2, 3, 4];

    values.loop(0, (h, index, value, acc: i32) {
        acc + value
    }).match({
        Ok(sum) => println("sum {}", sum),
        None    => println("sum none"),
    })

    // the index threads too, and it is not the value
    values.loop(0, (h, index, value, acc: usize) {
        acc + index
    }).match({
        Ok(n) => println("indexes {}", n),
        None  => println("indexes none"),
    })

    // init is the answer when there is nothing to fold
    Range(0, 0).loop(99, (h, index, value, acc: i32) {
        acc + value
    }).match({
        Ok(n) => println("empty {}", n),
        None  => println("empty none"),
    })
    Ok(0);
}
