Ast, Module, Decl, Import, Span, ExprId, nowhere = std.ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Range, Eq = std.core
World, Def, DefKind, dotted, module_display = sema.sema_def

ConstSite = {
    module: usize,
    span:   Span,
}

// `from` has a top-level constant that names one of `to`'s.
Edge = {
    from: usize,
    to:   usize,
}

Edge.impl(Eq, {
    eq ::= (self: @Self, other: @Self) bool {
        (self.from == other.from) && (self.to == other.to)
    }
})

// The module graph two diagnostics are asked of: a module importing
// itself, and a constant cycle between modules.
Graph = {
    alloc: Alloc,
    tree: Ast,
    world: World,
    edges :: Vec<Edge>,

    self_imports = (self: @Self, out :: String) Res<usize, AllocError> {
        n ::= 0;
        Range(0, self.tree.module_count()).loop((h, mi) {
            n = n + self.module_self_imports(mi, out).try();
        });
        Ok(n);
    }

    module_self_imports = (self: @Self, mi: usize, out :: String)
                          Res<usize, AllocError> {
        self.tree.module_at(mi).match({
            None  => Ok(0),
            Ok(m) => self.decls_self_import(m, mi, out),
        })
    }

    decls_self_import = (self: @Self, m: Module, mi: usize, out :: String)
                        Res<usize, AllocError> {
        n ::= 0;
        m.decls.loop((h, d) {
            n = n + self.decl_self_import(m, d, mi, out).try();
        });
        Ok(n);
    }

    decl_self_import = (self: @Self, m: Module, d: Decl, mi: usize,
                        out :: String) Res<usize, AllocError> {
        d.kind.match({
            Import(im) => self.names_module(im, mi).try().match({
                false => Ok(0),
                true  => say_self_import(m, im.module.span, out),
            }),
            _          => Ok(0),
        })
    }

    // Whether the import path names module `mi`.
    names_module = (self: @Self, im: Import, mi: usize)
                   Res<bool, AllocError> {
        path = dotted(self.alloc, im.module).try();
        Ok(self.world.index_of(path).match({
            Ok(j) => j == mi,
            None  => false,
        }))
    }

    const_cycles = (self: @Self, out :: String) Res<usize, AllocError> {
        n ::= 0;
        Range(0, self.world.count()).loop((h, mi) {
            n = n + self.cycle_at(mi, out).try();
        });
        Ok(n);
    }

    cycle_at = (self: @Self, mi: usize, out :: String)
               Res<usize, AllocError> {
        onward = self.reach_from(mi).try();
        mi.is_in(onward).match({
            false => Ok(0),
            true  => self.report_component(mi, onward, out),
        })
    }

    // One report per component, from its first module by name.
    report_component = (self: @Self, mi: usize, onward: Vec<usize>,
                        out :: String) Res<usize, AllocError> {
        comp = self.component_of(mi, onward).try();
        self.first_named(comp, mi).match({
            false => Ok(0),
            true  => self.say_cycle(mi, comp, out),
        })
    }

    component_of = (self: @Self, mi: usize, onward: Vec<usize>)
                   Res<Vec<usize>, AllocError> {
        comp ::= self.alloc.Vec<usize>();
        comp.add(mi).try();
        onward.loop((h, j) {
            (j == mi).match({
                true  => Ok(()),
                false => self.add_if_reaches(mi, j, comp),
            }).try();
        });
        Ok(comp);
    }

    add_if_reaches = (self: @Self, mi: usize, j: usize, comp :: Vec<usize>)
                     Res<(), AllocError> {
        back = self.reach_from(j).try();
        mi.is_in(back).match({
            false => Ok(()),
            true  => comp.add(j),
        })
    }

    first_named = (self: @Self, comp: Vec<usize>, mi: usize) bool {
        name = self.world.name_at(mi);
        comp.find((k) { self.world.name_at(k).before(name) })
            .match({ Ok(_) => false, None => true })
    }

    say_cycle = (self: @Self, mi: usize, comp: Vec<usize>, out :: String)
                Res<usize, AllocError> {
        path = self.shortest_cycle(mi, comp).try();
        at   = self.edge_span(mi, path.get(1).value_or(mi)).try();
        write_where(out, at).try();
        out.add("import cycle: ").try();
        path.loop((h, k, m) {
            (k > 0).then(() { out.add(" -> ").try(); });
            out.add(module_display(self.world.name_at(m))).try();
        });
        out.add(
            ": a top-level constant needs a value from a module whose own needs it back, and no order computes both"
        ).try();
        out.add("\n").try();
        Ok(1);
    }

    shortest_cycle = (self: @Self, start: usize, comp: Vec<usize>)
                     Res<Vec<usize>, AllocError> {
        s ::= Search(
            start: start,
            comp: comp,
            order: self.alloc.Vec<usize>(),
            prev: self.alloc.Vec<usize>(),
            closed: self.alloc.Vec<usize>(),
        );
        s.order.add(start).try();
        s.prev.add(0).try();
        i ::= 0;
        loop(() { i < s.order.len && s.closed.len == 0 }, (h) {
            from = s.order.get(i).value_or(start);
            self.edges.loop((g, e) {
                (e.from == from).then(() { s.take(e.to, i).try() });
            });
            i = i + 1;
        });
        s.path(self.alloc)
    }

    // Every module a constant of `start` reaches, transitively.
    reach_from = (self: @Self, start: usize) Res<Vec<usize>, AllocError> {
        seen  ::= self.alloc.Vec<usize>();
        front ::= self.alloc.Vec<usize>();
        front.add(start).try();
        i ::= 0;
        loop(i < front.len, (h) {
            from = front.get(i).value_or(start);
            i    = i + 1;
            self.edges.loop((g, e) {
                (e.from == from && !e.to.is_in(seen)).then(() {
                    seen.add(e.to).try();
                    front.add(e.to).try();
                });
            });
        });
        Ok(seen);
    }

    // The import in `from` that names `to`; the module span when none does.
    edge_span = (self: @Self, from: usize, to: usize) Res<Span, AllocError> {
        self.tree.module_at(from).match({
            None  => Ok(nowhere()),
            Ok(m) => self.module_edge_span(m, to),
        })
    }

    module_edge_span = (self: @Self, m: Module, to: usize)
                       Res<Span, AllocError> {
        hit: Res<Span> ::= None;
        m.decls.loop((h, d) {
            d.kind.match({
                Import(im) => self.names_module(im, to).try().match({
                    true  => { hit = Ok(im.module.span); h.break(); },
                    false => (),
                }),
                _          => (),
            });
        });
        Ok(hit.value_or(m.span));
    }

    // The constant graph: an edge from each module-level constant to
    // every other module whose constant it names.
    add_edges = (self :: @Self) Res<(), AllocError> {
        sites = self.const_sites().try();
        eid ::= ExprId(index: 0);
        Range(0, self.tree.expr_ids()).loop((h, i) {
            e = self.tree.expr_at(eid);
            e.kind.match({
                Name(n) => self.name_edges(sites, e.span, n.text),
                _       => Ok(()),
            }).try();
            eid = ExprId(index: eid.index + 1);
        });
        Ok(());
    }

    const_sites = (self: @Self) Res<Vec<ConstSite>, AllocError> {
        sites ::= self.alloc.Vec<ConstSite>();
        Range(0, self.tree.module_count()).loop((h, mi) {
            self.tree.module_at(mi).match({
                None  => Ok(()),
                Ok(m) => decl_const_sites(m, mi, sites),
            }).try();
        });
        Ok(sites);
    }

    name_edges = (self :: @Self, sites: Vec<ConstSite>, at: Span, name: str)
                 Res<(), AllocError> {
        site_of(sites, at).match({
            None   => Ok(()),
            Ok(mi) => self.resolved_edges(mi, name),
        })
    }

    resolved_edges = (self :: @Self, mi: usize, name: str)
                     Res<(), AllocError> {
        found ::= self.alloc.Vec<Def>();
        self.world.defs_of(mi, name, found).try();
        found.loop((h, d) {
            other = d.id.module.to_usize();
            (is_const(d.kind) && other != mi).match({
                false => Ok(()),
                true  => self.add_edge(Edge(from: mi, to: other)),
            }).try();
        });
        Ok(());
    }

    add_edge = (self :: @Self, e: Edge) Res<(), AllocError> {
        e.is_in(self.edges).match({
            true  => Ok(()),
            false => self.edges.add(e),
        })
    }
}

Graph = (a: Alloc, tree: Ast, w: World) Res<Graph, AllocError> {
    g ::= Graph(alloc: a, tree: tree, world: w, edges: a.Vec<Edge>());
    g.add_edges().try();
    Ok(g);
}

// Breadth-first search for the shortest cycle through `start`, inside one
// component.
Search = {
    start: usize,
    comp: Vec<usize>,
    order :: Vec<usize>,
    prev :: Vec<usize>,
    closed :: Vec<usize>,

    // The first edge back to `start` closes a shortest cycle.
    take = (self :: @Self, to: usize, at: usize) Res<(), AllocError> {
        (to == self.start).match({
            true  => (self.closed.len == 0).match({
                false => Ok(()),
                true  => self.closed.add(at),
            }),
            false => self.open(to, at),
        })
    }

    // Inside the component only: an edge leaving it never comes back.
    open = (self :: @Self, to: usize, at: usize) Res<(), AllocError> {
        (to.is_in(self.comp) && !to.is_in(self.order)).match({
            false => Ok(()),
            true  => { self.order.add(to).try(); self.prev.add(at) },
        })
    }

    // The cycle as modules, `start` first and last.
    path = (self: @Self, a: Alloc) Res<Vec<usize>, AllocError> {
        back ::= a.Vec<usize>();
        at   ::= self.closed.get(0).value_or(0);
        back.add(self.order.get(at).value_or(self.start)).try();
        loop(at > 0, (h) {
            at = self.prev.get(at).value_or(0);
            back.add(self.order.get(at).value_or(self.start)).try();
        });
        path ::= a.Vec<usize>();
        Range(0, back.len).loop((h, k) {
            path.add(back.get(back.len - 1 - k).value_or(self.start)).try();
        });
        path.add(self.start).try();
        Ok(path);
    }
}

check_module_graph* = (a: Alloc, tree: Ast, w: World, out :: String)
                      Res<usize, AllocError> {
    g = Graph(a, tree, w).try();
    n ::= g.self_imports(out).try();
    n = n + g.const_cycles(out).try();
    Ok(n);
}

say_self_import = (m: Module, at: Span, out :: String)
                  Res<usize, AllocError> {
    write_where(out, at).try();
    out.fmt(
        "module {} imports itself: an import is the one declaration that reaches OUTSIDE the file, and this one names the file it is written in\n",
        module_display(m.name)
    ).try();
    Ok(1);
}

decl_const_sites = (m: Module, mi: usize, sites :: Vec<ConstSite>)
                   Res<(), AllocError> {
    m.decls.loop((h, d) {
        d.kind.match({
            Const(_) => sites.add(ConstSite(module: mi, span: d.span)),
            _        => Ok(()),
        }).try();
    });
    Ok(());
}

// Which module-level constant this expression is written inside.
site_of = (sites: Vec<ConstSite>, at: Span) Res<usize> {
    sites.find((s) { s.span.encloses(at) }).match({
        Ok(s) => Ok(s.module),
        None  => None,
    })
}

encloses = (outer: Span, at: Span) bool {
    at.start.at_or_after(outer.start)
        && outer.end.at_or_after(at.end)
        && outer.file.eq(at.file)
}

is_const = (k: DefKind) bool {
    k.match({
        ConstDef => true,
        _        => false,
    })
}

write_where = (out :: String, at: Span) Res<(), AllocError> {
    out.fmt("{}:{}: ", at.file, at.start)
}
