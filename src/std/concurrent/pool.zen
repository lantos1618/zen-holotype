// std.concurrent.pool — PARALLELISM Cut 1: a multi-threaded GLOBAL-RUN-QUEUE scheduler that runs the
// actor model across M real OS threads (genuine N-core parallelism), per
// docs/archive/parallel-scheduler-design.md.
//
// This is the FIRST cut from that design: ONE mutex-guarded GLOBAL run queue + M worker pthreads +
// mutex-per-mailbox. It is NOT work-stealing — there are no per-worker deques and nothing is stolen;
// every worker pops the single shared queue. The scheduled unit is an ACTOR (Pony model): an actor is
// runnable iff its mailbox has a pending message AND it is not already scheduled/running. A worker
// pops a runnable actor, runs its behavior over a bounded batch of messages, then reschedules (if
// more remain) or deschedules (if empty). Genuinely parallel, correct, NO CAS — the contended global
// lock is the known Cut-1 limitation (Cut 2 = per-worker deques + work-stealing; Cut 3 = lock-free
// Chase–Lev). The run queue GROWS on overflow (doubling under the queue mutex), so scheduling more
// concurrently-runnable actors than the initial rqcap is never an abort.
//
// ── THE CENTRAL RACE-FREEDOM INVARIANT (design §3.3) ────────────────────────────────────────────
// An actor is present in at most one run queue AND executing on at most one worker at any instant,
// enforced by a single `scheduled` flag transition guarded by the mailbox mutex:
//   - `send` flips scheduled false→true UNDER the mailbox lock; only the false→true winner pushes the
//     actor to the global queue (no double-schedule). Concurrent senders see `true` and just enqueue.
//   - a worker that empties the mailbox clears scheduled→false UNDER the same lock, re-reading
//     `pending` in the same critical section so a message that arrived in the gap is never lost
//     (the lost-wakeup fix). Because of this invariant the actor's OWN fields need NO lock — only the
//     mailbox (MPSC) and the run queue need synchronisation.
//
// ── COLORLESS ──────────────────────────────────────────────────────────────────────────────────
// `with_pool` is a THIRD backing/driver alongside std.scope's `with_sync` (inline drain, 1 thread)
// and `with_async` (cooperative coroutine yield, 1 thread). The actor `behavior` is identical under
// every driver: `pool_drain_inline` runs it single-threaded; the pool runs the SAME behavior across M
// workers. spawn/send semantics are unchanged — only WHO drains (caller vs workers) differs.
//
// ── ARC-BACKED ACTOR LIFETIME (goal item E, design §3.4) ─────────────────────────────────────────
// The shared actor state (the PoolActor block) is allocated through `std.mem.arc` (`Arc<PoolActor>`):
// its first 8 bytes are an ATOMIC refcount. A handle is the Arc base pointer; sharing the actor across
// threads CLONEs the Arc (`atomic_add_i64 +1`), dropping a handle drops it (`atomic_add_i64 -1`), and
// the LAST drop — and only the thread whose decrement returns 0 — frees the block (plus the mailbox it
// owns + its mutex). This is what makes a cross-thread handle SAFE: a sender on worker A holding a ref
// to an actor whose owner (worker B) finishes can never use-after-free, because the block only frees
// once every handle (incl. the scheduler's "scheduled" ref) has dropped. Arc's atomic refcount —
// dead code until threads existed — is now LOAD-BEARING under real contention.
//
// The pool's OWN infrastructure (the Pool block, run-queue ring, per-worker stats, pthread handle/arg
// cells) is still malloc'd FFI/thread scratch — single-owner storage freed by the one owner in
// pool_close after the workers join, the same explicit-alloc floor as std.thread/std.sync. Only the
// cross-thread-shared ACTOR state needed refcounting; the single-owner infrastructure does not.
{ malloc, free } = std.mem.alloc
{ write, strlen } = std.c.libc
{ Rt, default, enter, leave, mark_spawned } = std.rt
{ Arc, new_in } = std.mem.arc
{ Malloc } = std.mem.alloc
{ Mutex, CondVar, new_mutex, new_cond } = std.concurrent.sync
{ spawn, JoinHandle } = std.concurrent.thread
{ is_null } = std.core.ptr
{ Result, panic } = std.core.result
{ Ring } = std.concurrent.ring
{ Arena } = std.mem.arena
QUANTUM := 64    // max messages an actor runs per turn before yielding the worker (fairness)
// CHECKED ABORT for the pool's own single-owner INFRASTRUCTURE blocks (the Pool block, the initial
// run-queue ring, per-worker stats, the pthread handle/arg cells). Those live behind
// `pool_open() MutPtr<Pool>` — a signature with no error channel — so an OOM there cannot be a value
// without an API break (see the ActorError note above: the ACTOR path, which does have a Result,
// reports `.Oom` properly). What this buys is the difference between a diagnosable
// `zen: panic: pool: …` and a null pointer smuggled into the ring/stats array to be dereferenced by a
// worker thread later. UFCS: `malloc(n).or_die("…")`.
//
// EVERY REMAINING or_die IS IN `new_pool`, AND THAT IS LOAD-BEARING: it runs on the opening thread
// BEFORE a single worker pthread exists and while NO lock is held, so its panic reaches `abort()` the
// ordinary way. `rq_grow` used to `or_die` too — and it runs UNDER `p.mu`, reachable from a `pool_send`
// issued INSIDE a behavior. Since `panic` calls `__zen_panic_unwind()` first, that panic siglongjmp'd
// into the worker's per-behavior catch with the pool mutex STILL LOCKED, and the worker deadlocked on
// its next `p.mu.lock()` — a hung pool instead of a diagnosable abort. Growth is a VALUE now
// (`rq_try_grow`/`rq_try_push` → `.Err(.Oom)`); do NOT reintroduce a panic inside `p.mu`.
or_die = (p: RawPtr<u8>, msg: StringView) RawPtr<u8> {
    is_null(p).match ({
        true  => {
            panic(msg)
            p
        },    // unreachable — panic aborts; only satisfies the arm's type
        false => p,
    })
}
// ── BACK-PRESSURE AND OOM AS VALUES (S2) ─────────────────────────────────────────────────────────
// A send either enqueues the message, finds the mailbox full, or cannot allocate. `MailboxFull` is the
// full-mailbox case: the message is DROPPED (dead-lettered), counted in `Pool.dropped` (see
// `pool_dropped`), so loss is OBSERVABLE. `Oom` is a failed allocation on the send path (the typed
// message box in std.concurrent.pool_actor, the actor block / mailbox ring at spawn): nothing was
// enqueued, nothing was dead-lettered — the send simply did not happen. The two are DISTINCT because
// the recoveries differ: MailboxFull says "the target is behind, retry or shed load", Oom says "the
// process is out of memory, stop producing". Defined HERE (not std.core.result) so the widening touches
// no bootstrap-closure file beyond std.concurrent. The caller MAY DISCARD the Result — the checker
// cannot force a use, so both are values to inspect, never a silent corruption. (#519 spelled the
// cooperative-actor equivalent as IoError.Errno(EAGAIN=11); a dedicated enum reads clearer for the
// parallel primitive and keeps the two error channels — libc vs mailbox — from sharing a numeric code.)
ActorError*: MailboxFull | Oom
// ALWAYS spell these QUALIFIED — `.Err(ActorError.Oom)`, never `.Err(.Oom)` — at every construction
// site in this module and in std.concurrent.pool_actor. A BARE variant in a NESTED constructor argument
// does not inherit the expected type: `ctor_enum_plain` (check.zen) honours `env.exp` only when the
// expected type is known at that position, and for a generic-enum payload (`Result<_, ActorError>.Err`'s
// argument) it is not, so resolution falls through to `enum_of_variant`, a flat LAST-DEFINITION-WINS
// scan by variant name over every enum in the program. A user program that declares its own enum with an
// `Oom` (or `MailboxFull`) variant AFTER the stdlib is flattened therefore silently steals the name, and
// the emitted C initialises an ActorError slot with the wrong enum type — a hard `cc` error, never a
// silent miscompile, but a build break caused entirely by a name the user is entitled to pick.
// This bit exactly once: tests/fixtures/zen/pool_supervisor_oom_restart.zen declares
// `Msg*: Work(i64) | Oom(i64)`. Qualifying removes the inference and the landmine with it. The real fix
// is expected-type propagation into generic-enum constructor arguments — a compiler change, tracked
// separately; until it lands, do not "simplify" these back to bare variants.
// success payload of a send: the number of messages enqueued (always 1 today — mirrors std.io.file's
// `Result<i64, IoError>` convention where the Ok channel carries a "count of units that landed", since
// Zen has no first-class unit/void value to spell `Result<void, _>`).
SENT_ONE := 1
STDERR_FD := 2    // fd 2 for the "actor marked dead" note (mirrors std.core.result's panic framing)
// PER-ACTOR PANIC ISOLATION (bootstrap/zenrt.c). Run `behavior(user, msg)` under a thread-local setjmp
// catch installed for the duration of THIS call only; returns 0 if it returned normally, 1 if it panicked
// (div0/OOB/null/explicit — genc's zen__panic longjmp'd back). A panic OUTSIDE a pool worker (main, the
// inline sync drain) installs no catch, so zen__panic aborts as it always has: the non-actor path is
// byte-identical. Bodyless FFI decl (like std.c.libc) — genc emits the prototype; the symbol is zenrt.c's.
// KNOWN v1 LIMIT: a longjmp abandons the crashed frame. The in-flight typed message box is now reclaimed
// on the catch path (the pool_actor trampoline records it via __zen_actor_set_inflight; zenrt.c frees it),
// so a panicking actor no longer leaks its current box. Still deferred: other heap the behavior malloc'd
// before the panic, and still-queued boxes in a dead actor's mailbox (drained-and-discarded, not freed) —
// the real fix is a per-actor arena rt reset on death. No lock is held across the call (behavior runs
// outside the mailbox lock).
__zen_actor_call = (behavior: (RawPtr<u8>, i64) void, user: RawPtr<u8>, msg: i64) i64
// Register THIS worker pthread's own per-thread sigaltstack (bootstrap/zenrt.c). A stack-overflow SIGSEGV
// is delivered on the alt stack (SA_ONSTACK), but sigaltstack is a PER-THREAD setting — a worker that
// never registered one would take the overflow on its already-exhausted stack → raw process kill (exit
// 139), killing the whole pool. Every worker calls this FIRST so an actor's runaway recursion (Zen's only
// loop) is caught and routed into the per-actor panic catch (__zen_actor_call) instead of crashing raw.
__zen_thread_init = () void
// ── PoolActor: a type-erased runnable actor ─────────────────────────────────────────────────────
// `behavior(user, msg)` runs the actor's reaction to one i64 message. The mailbox is a fixed-cap ring
// of i64 messages (a pointer payload rides as an i64 too). `mbmu` guards head/tail/buf AND `sched`.
//
// ── TWO-MEMORY MODEL: the per-actor SCRATCH arena (S4-lite, actor-consolidation-2026-07-20) ───────
// `scratch` is this actor's per-behavior SCRATCH: a bump arena the receiver allocates its OWN temporaries
// into (`self.scratch.bump(n)`), RESET WHOLESALE at the end of EVERY behavior — normal return OR caught
// panic — by the worker on its NORMAL stack (drain_batch, below). So nothing a behavior bump-allocates can
// leak, ever: the crash/backlog per-behavior leak class is deleted STRUCTURALLY, not patched. The reset is
// a bump-pointer rewind (no free), so it is cheap and re-uses the same backing block message after message.
// `scratch` is a BORROW (MutPtr<Arena>) of an arena the caller owns (constructed at spawn, freed after
// close) — it is null for actors that never opted in (the raw pool path), and the reset is null-guarded.
//
// WHY the message box is NOT scratch (the crisp boundary): a SENT message must OUTLIVE the sender's
// behavior — the RECEIVER reads it later, on another worker, after the sender's scratch has already been
// reset. So messages/reply-boxes stay SHARED heap (malloc'd by `send`/`ref_send_msg`, freed by the worker
// after the receiver's `receive` returns — S2/#519). Scratch is ONLY for the receiver's OWN temporaries,
// never for anything that crosses a send. The scratch-escape checker (check_validate.zen) enforces this:
// a scratch pointer routed out through `send`/`pool_send`/`ref_send_msg` is rejected.
PoolActor: {
    user: RawPtr<u8>,
    mbuf: RawPtr<u8>,
    head: i64,
    tail: i64,
    cap: i64,
    mbmu: Mutex,
    sched: i64,
    behavior: (RawPtr<u8>, i64) void,
    art: Rt,
    dead: i64,
    scratch: MutPtr<Arena>,
    boxed: i64,
}    // user actor state (opaque to the pool); `scratch` = per-behavior bump arena (null = none);
// `boxed` = 1 when this actor's i64 messages are malloc'd box POINTERS (the typed pool_actor path), so a
// DEAD actor's still-queued backlog must `free` each drained box (supervision S5); 0 for raw pool actors
// whose payload is a plain i64 value (freeing it would corrupt) — the drain-discard then only counts, no free.
// (`art` = this actor's ambient rt; the worker sets it as the current-rt slot around each behavior run,
// so `rt.current()` inside the behavior resolves to the actor's own rt — the M4 injection hook, §2b.
// Untyped pool actors default `art = default()` (the process default rt; heap unless a program opts in).)
actor_view = (raw: RawPtr<u8>) MutPtr<PoolActor> { raw.offset(8).slice(1)[0].addr() }
// NOTE: PoolActor holds an FnT field (`behavior`), so it may NOT carry in-body methods — a struct with
// any fn-typed field is trait-SHAPED (astops.struct_is_trait) and in-body fns would be treated as trait
// default methods, corrupting resolution. Its helpers stay free fns (UFCS call sites work regardless).
// the actor's mailbox ring view (consumer side; caller MUST hold `mbmu`).
actor_mb = (a: MutPtr<PoolActor>) Ring<i64> {
    Ring<i64>(
        buf: a.mbuf,
        head: a.head,
        tail: a.tail,
        cap: a.cap,
    )
}
// GIVE BACK a `sched` false→true transition that could not be completed — the sender won the claim but
// the run queue was full and could not grow, so the actor was never enqueued. Clearing the flag under the
// mailbox lock RESTORES the central invariant (`sched == 1` ⇒ the actor is queued or running): leaving it
// set would strand the actor forever, since every later sender would see `true` and decline to push it.
// The message itself STAYS in the mailbox — it is not lost, only not runnable until a later send wins the
// transition again and finds room. That is the honest degradation of a run queue that cannot grow, and it
// is why `pool_send`'s `.Err(.Oom)` means "not scheduled", not "not enqueued".
unschedule = (a: MutPtr<PoolActor>) void {
    a.mbmu.lock()
    a.sched = 0
    a.mbmu.unlock()
}
// reset an actor's per-behavior SCRATCH arena (bump pointer -> 0), null-guarded for actors that never
// opted into scratch (the raw pool path). Called at the behavior boundary on the worker's NORMAL stack —
// so rewinding/reusing the backing here is safe even after a CAUGHT panic (the signal handler already
// unwound and the trampoline returned normally before this runs). This is what makes per-behavior scratch
// reclamation STRUCTURAL: whether the behavior returned or crashed, its temporaries are gone wholesale.
scratch_reset = (a: MutPtr<PoolActor>) void {
    (a.scratch != null_ptr()).then({
        a.scratch.reset()
    })
}
// spawn an actor whose behaviors run under `art` as the ambient rt (the M4 injection hook, §2b): the
// worker writes `art` into the current-rt thread-local around each behavior run, so `rt.current()`
// inside the behavior is this actor's own rt (Pony per-actor heap). Everything else is exactly
// `pool_spawn`. A handle is an `Arc<PoolActor>` base pointer: [ count:i64 | PoolActor ]; the PoolActor
// value lives 8 bytes past the base (past the refcount header), matching std.mem.arc's layout. Build a
// runnable actor (refcount = 1, owned by the caller) + a mailbox ring; NOT enqueued — the first `send`
// makes it runnable. Returns the Arc base pointer as the opaque handle.
pool_spawn_rt* = (
    user: RawPtr<u8>,
    mbcap: i64,
    behavior: (RawPtr<u8>, i64) void,
    art: Rt,
) RawPtr<u8> { pool_spawn_scratch_rt(user, mbcap, behavior, art, null_ptr()) }
// as pool_spawn_rt, but with a per-actor SCRATCH arena (a MutPtr<Arena> the caller owns): the worker
// RESETS it wholesale at every behavior boundary (drain_batch), reclaiming the receiver's per-behavior
// temporaries whether the behavior returned or panicked. `null` scratch (the pool_spawn_rt default) means
// the actor has no scratch and the boundary reset is skipped — byte-identical to pre-scratch behaviour.
pool_spawn_scratch_rt* = (
    user: RawPtr<u8>,
    mbcap: i64,
    behavior: (RawPtr<u8>, i64) void,
    art: Rt,
    scratch: MutPtr<Arena>,
) RawPtr<u8> {
    raw := pool_try_spawn_scratch_rt(user, mbcap, behavior, art, scratch)
    is_null(raw).match ({
        true  => {
            panic("pool: actor block allocation failed")
            raw
        },    // unreachable — panic aborts; only satisfies the arm's type
        false => raw,
    })
}
// as pool_spawn_scratch_rt, but allocation failure is a VALUE: returns a NULL handle when the mailbox
// ring or the Arc'd actor block could not be allocated, instead of dereferencing null (the mailbox ring
// was previously handed to the PoolActor unchecked, so an OOM here surfaced later as a null-deref inside
// `pool_send`). A partially-built actor is fully unwound before returning — the ring is freed when the
// actor block is what failed — so the null return leaks nothing. `RawPtr<u8>` IS the value channel at
// this layer: the raw pool's handle type is an opaque pointer, and `is_null(raw)` is the check. The
// typed layer (std.concurrent.pool_actor.try_spawn_actor) lifts this null into `.Err(.Oom)`.
pool_try_spawn_scratch_rt* = (
    user: RawPtr<u8>,
    mbcap: i64,
    behavior: (RawPtr<u8>, i64) void,
    art: Rt,
    scratch: MutPtr<Arena>,
) RawPtr<u8> {
    mark_spawned()    // latch the rt.set_default guard: the process default is now frozen (workers read it)
    ma := Malloc(_: 0)
    mbuf := malloc(mbcap * 8)
    is_null(mbuf).match ({
        true  => null_ptr(),
        false => new_in(ma.addr(), PoolActor(
            user: user,
            mbuf: mbuf,
            head: 0,
            tail: 0,
            cap: mbcap,
            mbmu: new_mutex(),
            sched: 0,
            behavior: behavior,
            art: art,
            dead: 0,
            scratch: scratch,
            boxed: 0,
        )).match ({
            .Ok(arc) => arc.base,
            .Err(e)  => {
                free(mbuf)    // the actor block failed AFTER the ring landed — do not leak the ring
                null_ptr()
            },
        }),
    })
}
// spawn an untyped pool actor with the process DEFAULT ambient rt (heap unless the program called
// `rt.set_default`). Delegates to pool_spawn_rt with `default()` — heap-when-unset is observationally
// the unset default, so every existing pool fixture stays byte-identical. The typed pool-actor path
// (std.concurrent.pool_actor) calls pool_spawn_rt directly to give each actor its own rt.
pool_spawn* = (user: RawPtr<u8>, mbcap: i64, behavior: (RawPtr<u8>, i64) void) RawPtr<u8> {
    pool_spawn_rt(user, mbcap, behavior, default())
}
// clone a handle: bump the Arc refcount (atomic +1) and return the same base. Any party that shares the
// actor across threads — a sender that wants to outlive the spawner, the run-queue's "scheduled" ref —
// holds a clone, so the block cannot be freed while that party still references it.
pool_actor_ref* = (raw: RawPtr<u8>) RawPtr<u8> {
    atomic_add_i64(raw, 1)
    raw
}
// drop a handle: decrement the Arc refcount (atomic -1). The thread whose decrement returns 0 holds the
// LAST reference and frees the block + the mailbox it owns + its mutex — exactly once, no UAF, no leak.
pool_actor_unref* = (raw: RawPtr<u8>) void {
    (atomic_add_i64(raw, 0 - 1) == 0).then({
        a := actor_view(raw)
        free(a.mbuf)
        a.mbmu.destroy()
        free(raw)
    })
}
// the spawner releases its reference (the symmetric counterpart of pool_spawn). Same as pool_actor_unref;
// the name is kept for the existing call sites that "free" the actor after the pool has shut down.
pool_actor_free* = (raw: RawPtr<u8>) void { pool_actor_unref(raw) }
// read an actor's current Arc refcount (for tests/assertions of the cross-thread lifetime).
pool_actor_count* = (raw: RawPtr<u8>) i64 { load_i64(raw) }
// ── SUPERVISION OBSERVABILITY (S5) ────────────────────────────────────────────────────────────────
// is this actor DEAD? A behavior panic marks the actor dead (drain_batch, below) and the worker survives;
// this getter makes that death OBSERVABLE so a supervisor can detect a crashed child and restart it. True
// the instant a behavior in this actor panicked — the actor may still be draining-and-discarding its
// backlog, but it will run no further user code (at-most-once: post-death messages are dropped, not replayed).
pool_actor_dead* = (raw: RawPtr<u8>) bool { actor_view(raw).dead != 0 }
// mark this actor's messages as malloc'd box POINTERS: on death, drain_batch `free`s each still-queued box
// (backlog leak fix, #519's deferred class) instead of silently dropping it. Called by the typed pool_actor
// spawn path right after the raw spawn; raw pool actors leave `boxed` 0 (their i64 payload is a value).
pool_actor_set_boxed* = (raw: RawPtr<u8>) void {
    a := actor_view(raw)
    a.boxed = 1
}
// ── Pool: M workers + ONE global run queue behind ONE mutex + condvar (Cut 1) ───────────────────
Pool*: {
    rqbuf: RawPtr<u8>,
    rqhead: i64,
    rqtail: i64,
    rqcap: i64,
    mu: Mutex,
    work_cv: CondVar,
    done_cv: CondVar,
    live: i64,
    stop: i64,
    nworkers: i64,
    wstats: RawPtr<u8>,
    handles: RawPtr<u8>,
    args: RawPtr<u8>,
    selfraw: RawPtr<u8>,
    dropped: i64,
    // the pool's own backing-block address — pass this through a thread `arg` to reconstruct the pool view.
    pool_raw = (p: MutPtr<Pool>) RawPtr<u8> { p.selfraw }
    // run-queue primitives — caller MUST hold `p.mu`.
    // The ring holds (rqtail - rqhead) live slots; a push into a FULL ring would overwrite a still-queued
    // actor (heap corruption / UAF), so a full ring GROWS first (rq_try_grow) — enqueueing more
    // concurrently-runnable actors than the initial rqcap is handled by reallocation. `false` means the
    // ring was full and the growth allocation FAILED: nothing was written, the queue is untouched, and it
    // is the CALLER's job to give up the scheduling claim it was about to make (pool_send) or to keep
    // running the actor itself (run_quantum). A bool, not a panic, because this runs inside `p.mu`.
    rq_try_push = (p: MutPtr<Pool>, actor: RawPtr<u8>) bool {
        room := (p.rqtail - p.rqhead >= p.rqcap).then({ p.rq_try_grow() }, { true })
        room.then({
            p.rqbuf.offset(p.rqtail % p.rqcap * 8).store_i64(actor)
            p.rqtail = p.rqtail + 1
        })
        room
    }
    // double the run queue's capacity: allocate a fresh ring, copy the (rqtail - rqhead) live slots to the
    // front in FIFO order, swap the buffers, free the old one. Caller MUST hold `p.mu` — the queue is ONE
    // mutex-guarded structure, so growth is a plain critical-section reallocation (no reader/writer can
    // observe the swap mid-flight). Ownership is unchanged: the pool owns rqbuf (malloc'd in new_pool),
    // and the current buffer — original or grown — is the one pool_close frees.
    // Returns false (leaving the queue EXACTLY as it was) when the new ring could not be allocated: this
    // executes under `p.mu`, so it must never panic — see the or_die note at the top of this file.
    rq_try_grow = (p: MutPtr<Pool>) bool {
        newcap := p.rqcap * 2
        nbuf := malloc(newcap * 8)
        is_null(nbuf).match ({
            true  => false,
            false => {
                n := p.rqtail - p.rqhead
                p.rq_copy(nbuf, 0, n)
                free(p.rqbuf)
                p.rqbuf = nbuf
                p.rqhead = 0
                p.rqtail = n
                p.rqcap = newcap
                true
            },
        })
    }
    // copy live slot i (FIFO order from the old ring's head) into the new buffer's slot i.
    rq_copy = (p: MutPtr<Pool>, nbuf: RawPtr<u8>, i: i64, n: i64) void {
        (i < n).then({
            nbuf.offset(i * 8).store_i64(p.rqbuf.offset((p.rqhead + i) % p.rqcap * 8).load_i64())
            p.rq_copy(nbuf, i + 1, n)
        })
    }
    rq_pop = (p: MutPtr<Pool>) RawPtr<u8> {
        a := p.rqbuf.offset(p.rqhead % p.rqcap * 8).load_i64().offset(0)
        p.rqhead = p.rqhead + 1
        a
    }
    // ── send (race-free) — the hard part (design §3.2/§3.3) ─────────────────────────────────────
    // Lock the mailbox, push the message, read+set `scheduled`; only if it was FALSE do we push the actor
    // to the global queue + signal a worker. The false→true winner is the SOLE pusher (no double-schedule);
    // concurrent senders see `true` and only enqueue their message. Returns `.Err(.MailboxFull)` if the
    // mailbox is full — back-pressure as a VALUE: the message is dropped (never silently corrupting the
    // ring), the drop is TALLIED in `p.dropped` (dead-letter counter, under `p.mu`), and the caller MAY
    // discard the Result (an ignored `.Err` is not a corruption, just an unobserved drop — the counter
    // still records it).
    pool_send = (p: MutPtr<Pool>, actor: RawPtr<u8>, msg: i64) Result<i64, ActorError> {
        a := actor_view(actor)
        a.mbmu.lock()
        cur := a.actor_mb()
        sent := cur.is_full().match ({
            true  => false,
            false => {
                a.tail = cur.push(msg).tail
                true
            },
        })
        // flip scheduled false→true ONLY when we actually enqueued work; remember if WE won the transition.
        won := sent.match ({
            true  => (a.sched == 0).match ({
                true  => {
                    a.sched = 1
                    true
                },
                false => false,
            }),
            false => false,
        })
        a.mbmu.unlock()
        // Put the actor on the run queue — only the false→true winner does this. A FULL queue that cannot
        // GROW is the one allocation failure on this path, and it is a VALUE (`.Err(.Oom)`): panicking here
        // would siglongjmp into the worker's per-behavior catch with `p.mu` still locked and deadlock the
        // whole pool (this fn is reachable from inside a behavior via ActorRef.ref_send).
        queued := won.match ({
            true  => {
                pool_actor_ref(actor)    // the run queue now OWNS a reference (the "scheduled" ref):
                p.mu.lock()    // the actor cannot be freed while it is queued or running.
                ok := p.rq_try_push(actor)
                ok.then({
                    p.live = p.live + 1
                    p.work_cv.signal()
                })
                p.mu.unlock()
                (ok == false).then({
                    a.unschedule()
                    pool_actor_unref(actor)
                })    // could not queue it: hand back the "scheduled" ref and the claim we won
                ok
            },
            false => true,
        })    // not our transition: another sender already owns the scheduling
        sent.match ({
            true  => queued.then({ .Ok(SENT_ONE) }, { .Err(ActorError.Oom) }),
            false => {
                p.mu.lock()    // record the dead letter under the pool lock (same lock guarding live/rq)
                p.dropped = p.dropped + 1
                p.mu.unlock()
                .Err(ActorError.MailboxFull)
            },
        })
    }
    // dead-letter total: messages this pool dropped because a target mailbox was full (read after
    // quiescence, or racily during a run for a lower-bound estimate). Makes back-pressure LOSS observable.
    pool_dropped = (p: MutPtr<Pool>) i64 { p.dropped }
    // build an ActorRef addressing `handle` on pool `p` (call at spawn/setup, when `p` is in hand).
    actor_ref = (p: MutPtr<Pool>, handle: RawPtr<u8>) ActorRef {
        ActorRef(
            pool: p.pool_raw(),
            handle: handle,
        )
    }
    // drain up to QUANTUM messages, running `behavior` OUTSIDE the mailbox lock (so senders never block on
    // user work). Returns the count processed this batch.
    drain_batch = (p: MutPtr<Pool>, a: MutPtr<PoolActor>, count: i64) i64 {
        (count >= QUANTUM).match ({
            true  => count,
            false => {
                a.mbmu.lock()
                cur := a.actor_mb()
                has := cur.nonempty()
                msg := has.match ({
                    true  => {
                        m := cur.peek()
                        a.head = cur.advance().head
                        m
                    },
                    false => 0,
                })
                a.mbmu.unlock()
                has.match ({
                    true  => {
                        // A dead actor (an earlier message in THIS turn panicked) drains-and-discards the rest of its
                        // mailbox WITHOUT running the behavior, so the pool reaches quiescence and the actor deschedules.
                        (a.dead != 0).match ({
                            true  => {
                                // BACKLOG FREE (S5, closes #519's deferred leak): a dead actor's still-queued message
                                // boxes must be reclaimed, not silently dropped. For a typed actor (`boxed`) the i64 payload
                                // is a malloc'd box pointer — free it; for a raw pool actor it is a plain value — only count.
                                // Each drop is a DEAD LETTER, tallied in the shared counter so restart-time loss is observable.
                                (a.boxed != 0).then({
                                    free(msg.offset(0))
                                })
                                p.mu.lock()
                                p.dropped = p.dropped + 1
                                p.mu.unlock()
                                p.drain_batch(a, count + 1)
                            },
                            false => {
                                saved := enter(a.art)    // set this actor's rt as the ambient (M4 §2b) around the behavior;
                                crashed := __zen_actor_call(a.behavior, a.user, msg)    // run under the panic catch (isolation)
                                leave(saved)    // restore the worker's prior slot — runs even on a caught panic (trampoline returns normally)
                                a.scratch_reset()    // wholesale-reclaim this behavior's scratch (normal return OR caught panic), on the normal stack
                                (crashed != 0).then({
                                    a.dead = 1    // the actor panicked (zen__panic already printed the reason); mark it dead
                                    note := "zen: actor marked dead, pool continues\n"    // follow-up to zen__panic's reason line
                                    nn := note.strlen()
                                    STDERR_FD.write(note.slice(nn).ptr, nn)
                                })
                                p.drain_batch(a, count + 1)
                            },
                        })
                    },
                    false => count,
                })
            },
        })
    }
    // run ONE actor turn, then reschedule (more pending) or deschedule (empty). The deschedule reads
    // `pending` and clears `scheduled` IN THE SAME mailbox critical section — closing the lost-wakeup race.
    run_quantum = (p: MutPtr<Pool>, actor: RawPtr<u8>) i64 { p.run_turn(actor, 0) }
    // one turn, accumulating into `acc`. Split out of run_quantum so the "could not requeue" case can
    // simply take ANOTHER turn on this worker: the actor is already scheduled and this worker already
    // holds its run-queue reference, so continuing to drain it here needs no allocation at all. It costs
    // FAIRNESS (other queued actors wait out this actor's backlog), never correctness — and it is the only
    // option that keeps the `sched`/`live` bookkeeping intact, since the actor is mid-flight.
    run_turn = (p: MutPtr<Pool>, actor: RawPtr<u8>, acc: i64) i64 {
        a := actor_view(actor)
        processed := acc + p.drain_batch(a, 0)
        a.mbmu.lock()
        remaining := a.tail - a.head
        (remaining > 0).match ({
            true  => {
                a.mbmu.unlock()    // still scheduled==1; give other actors a turn (fairness)
                p.mu.lock()
                requeued := p.rq_try_push(actor)
                requeued.then({
                    p.work_cv.signal()
                })
                p.mu.unlock()
                requeued.then({ processed }, { p.run_turn(actor, processed) })
            },    // queue full and ungrowable: keep this actor on THIS worker instead of panicking under p.mu
            false => {
                a.sched = 0    // deschedule UNDER the mailbox lock (lost-wakeup fix)
                a.mbmu.unlock()
                p.mu.lock()
                p.live = p.live - 1
                (p.live == 0).then({
                    p.done_cv.broadcast()
                })
                p.mu.unlock()
                pool_actor_unref(actor)    // drop the run queue's "scheduled" ref (clone in pool_send);
                processed
            },
        })
    }
    pool_next_locked = (p: MutPtr<Pool>) RawPtr<u8> {
        (p.rqhead < p.rqtail).match ({
            true  => p.rq_pop(),    // if this was the last handle, the actor frees here, safely.
            // pop a runnable actor or park until work arrives / shutdown. Caller must hold `p.mu`; returns null to
            // signal "exit the worker loop". The park + the stop-check + the wake all happen under `p.mu`, so a
            // shutdown broadcast can never be lost against a worker about to park.
            false => (p.stop != 0).match ({
                true  => null_ptr(),
                false => {
                    p.work_cv.wait(p.mu)    // atomically unlock mu, sleep, re-lock on wake
                    p.pool_next_locked()
                },
            }),
        })
    }
    pool_next = (p: MutPtr<Pool>) RawPtr<u8> {
        p.mu.lock()    // re-check predicate (guards spurious wakeups)
        r := p.pool_next_locked()
        p.mu.unlock()
        r
    }
    // the worker loop: pop/park, run a quantum, tally messages into this worker's stat slot (only this
    // worker writes its slot → no contention), repeat until shutdown.
    worker_loop = (p: MutPtr<Pool>, wid: i64) void {
        actor := p.pool_next()
        (is_null(actor) == false).then({
            n := p.run_quantum(actor)
            slot := p.wstats.offset(wid * 8)
            slot.store_i64(slot.load_i64() + n)
            p.worker_loop(wid)
        })
    }
    // block the calling thread until the pool is quiescent (no scheduled actors). Caller holds p.mu.
    wait_quiescent = (p: MutPtr<Pool>) void {
        (p.live == 0 == false).then({
            p.done_cv.wait(p.mu)
            p.wait_quiescent()
        })
    }
    // block until the pool is quiescent (every scheduled actor has drained to empty) WITHOUT shutting it
    // down — the workers stay parked, ready for more work. Unlike pool_quiesce_stop this leaves the pool
    // RUNNABLE, so a supervisor can: send a batch, `pool_quiesce` to let it settle, observe a crashed child
    // (pool_actor_dead) + the dead-letter count, restart it, then send the next batch on the SAME live
    // pool. `live` is bumped under p.mu by the first `send` that schedules an actor and cleared when it
    // deschedules, so a quiesce issued after a batch of sends can never return early past still-pending work.
    pool_quiesce = (p: MutPtr<Pool>) void {
        p.mu.lock()
        p.wait_quiescent()
        p.mu.unlock()
    }
    // drain-to-quiescence shutdown: wait until all enqueued work is processed, flag stop, wake every parked
    // worker (the broadcast is under p.mu so it can't be lost), join the pthreads. After this returns the
    // pool is idle and joined — stats (workers_busy) are stable and actors are safe to free — but the pool
    // storage is NOT yet freed (call pool_close for that).
    pool_quiesce_stop = (p: MutPtr<Pool>) void {
        p.mu.lock()
        p.wait_quiescent()
        p.stop = 1
        p.work_cv.broadcast()
        p.mu.unlock()
        join_workers(p.handles, 0, p.nworkers)
    }
    // free the pool's backing storage (only after pool_quiesce_stop has joined the workers).
    pool_close = (p: MutPtr<Pool>) void {
        free(p.rqbuf)
        free(p.wstats)
        free(p.handles)
        free(p.args)
        p.mu.destroy()
        p.work_cv.destroy()
        p.done_cv.destroy()
        free(p.selfraw)
    }
    // number of workers that processed at least one message (proof that work fanned across cores).
    workers_busy = (p: MutPtr<Pool>) i64 { count_busy(p.wstats, 0, p.nworkers, 0) }
}    // DEAD-LETTER counter: messages dropped on a full mailbox (incremented under `mu`; read via pool_dropped)
// global run queue ring (i64 slots holding PoolActor block pointers)
// recover a MutPtr<Pool> from the pool's malloc'd block address (e.g. inside a worker/producer thread
// body that received the raw pointer through its `arg`).
pool_view* = (raw: RawPtr<u8>) MutPtr<Pool> { raw.slice(1)[0].addr() }
// ── ActorRef: a SENDABLE address that can send/reply from INSIDE `receive` (S2) ──────────────────
// The parallel primitive `pool_send` needs `p: MutPtr<Pool>` + the actor handle — neither of which a
// running `receive` has (a pool worker calls `behavior(user, msg)`, no Pool pointer, no peer handle). An
// ActorRef closes that gap: it bundles the Pool BACKING BLOCK (`pool` = `pool_raw(p)` = `p.selfraw`) with
// the target actor's Arc handle (`handle`). BOTH are `RawPtr<u8>` → the send-mut mode lattice classifies
// this struct as `frozen` (a field-walk finds no `MutPtr`), so an ActorRef is SENDABLE: it may live in an
// actor's state (constructed at spawn) OR ride INSIDE a message (a request carries the requester's own
// ActorRef as its reply-address). That is the replies-are-messages mechanism — no ambient rt, no
// synchronous ask: the handler just `reply_to.ref_send(...)`.
//
// Why a shared Pool pointer is SAFE to send to another worker: the Pool block OUTLIVES every actor (it is
// freed only by `pool_close`, after `pool_quiesce_stop` has joined all workers), so a Pool pointer handed
// across workers never dangles. The actor handle is an Arc base — cross-thread lifetime is refcounted
// (pool_actor_ref/unref). An ActorRef holds a BORROW of both; hold a `pool_actor_ref` clone if a ref must
// outlive the spawner (the run-queue's "scheduled" ref already keeps a live actor alive across a send).
ActorRef*: {
    pool: RawPtr<u8>,
    handle: RawPtr<u8>,
    // send to the referenced actor: recover the Pool view from the backing block, recover the handle, do
    // the pool_send. The raw i64-payload floor (the typed boxing convenience lives in
    // std.concurrent.pool_actor); carries the same back-pressure Result as pool_send.
    ref_send = (r: ActorRef, msg: i64) Result<i64, ActorError> {
        pool_view(r.pool).pool_send(r.handle, msg)
    }
}
// non-capturing pthread body: arg → [pool_block_ptr, worker_id]; rebuild the pool view and run the loop.
worker_body = (arg: RawPtr<u8>) RawPtr<u8> {
    __zen_thread_init()    // register this worker's per-thread sigaltstack BEFORE it runs any behavior (recursion → SIGSEGV)
    pool_raw := load_i64(arg).offset(0)
    wid := load_i64(arg.offset(8))
    p := pool_view(pool_raw)
    p.worker_loop(wid)
    null_ptr()
}
// ── lifecycle ───────────────────────────────────────────────────────────────────────────────────
// allocate + initialise a Pool block over a malloc'd run queue / locks / condvars / per-worker stats.
new_pool = (nworkers: i64, rqcap: i64) RawPtr<u8> {
    blk := malloc(sizeof(Pool)).or_die("pool: pool block allocation failed")
    rqbuf := malloc(rqcap * 8).or_die("pool: run queue allocation failed")
    wstats := malloc(nworkers * 8).or_die("pool: worker stats allocation failed")
    zero_stats(wstats, 0, nworkers)
    pv: [Pool] := blk.slice(1)
    pv[0] = Pool(
        rqbuf: rqbuf,
        rqhead: 0,
        rqtail: 0,
        rqcap: rqcap,
        mu: new_mutex(),
        work_cv: new_cond(),
        done_cv: new_cond(),
        live: 0,
        stop: 0,
        nworkers: nworkers,
        wstats: wstats,
        handles: malloc(nworkers * 8).or_die("pool: worker handle table allocation failed"),
        args: malloc(nworkers * 16).or_die("pool: worker arg cell allocation failed"),
        selfraw: blk,
        dropped: 0,
    )
    blk
}
// open a running pool: allocate it and spawn the M worker pthreads. The returned pointer is the pool
// handle; drive it with pool_spawn/pool_send, then pool_quiesce_stop → (read stats) → pool_close.
pool_open* = (nworkers: i64, rqcap: i64) MutPtr<Pool> {
    pool_raw := new_pool(nworkers, rqcap)
    p := pool_view(pool_raw)
    start_workers(pool_raw, p.handles, p.args, 0, nworkers)
    p
}
zero_stats = (w: RawPtr<u8>, i: i64, n: i64) void {
    (i < n).then({
        w.offset(i * 8).store_i64(0)
        zero_stats(w, i + 1, n)
    })
}
// spawn the worker pthreads. `handles` (i64[nworkers]) receives each JoinHandle.tid; `args`
// (16 bytes/worker) holds each worker's [pool_raw, id] cell. Both are freed after join.
start_workers = (pool_raw: RawPtr<u8>, handles: RawPtr<u8>, args: RawPtr<u8>, i: i64, n: i64) void {
    (i < n).then({
        ac := args.offset(i * 16)
        ac.store_i64(pool_raw)
        ac.offset(8).store_i64(i)
        h := spawn(worker_body, ac)
        handles.offset(i * 8).store_i64(h.tid)
        start_workers(pool_raw, handles, args, i + 1, n)
    })
}
join_workers = (handles: RawPtr<u8>, i: i64, n: i64) void {
    (i < n).then({
        JoinHandle(tid: handles.offset(i * 8).load_i64().offset(0)).join()
        join_workers(handles, i + 1, n)
    })
}
count_busy = (w: RawPtr<u8>, i: i64, n: i64, acc: i64) i64 {
    (i < n).match ({
        true  => count_busy(w, i + 1, n, (w.offset(i * 8).load_i64() > 0).then({ acc + 1 }, { acc })),
        false => acc,
    })
}
// ── with_pool: the colorless parallel combinator (3rd driver, alongside with_sync/with_async) ──
// Start M workers, run the SAME actor-spawning body across the pool, drain to quiescence, shut down,
// free. `spawn`/`send` (pool_spawn/pool_send) are unchanged from the single-thread surface.
with_pool*<R> = (nworkers: i64, rqcap: i64, body: (MutPtr<Pool>) R) R {
    p := pool_open(nworkers, rqcap)
    out := body(p)
    p.pool_quiesce_stop()
    p.pool_close()
    out
}
// SYNC driver: run an actor's behavior over its whole mailbox inline on the caller's thread (no pool,
// no threads). The SAME `behavior` the pool fans out — the colorless proof that the driver, not the
// actor, decides sync vs parallel. Returns messages processed.
pool_drain_inline* = (actor: RawPtr<u8>) i64 {
    a := actor_view(actor)
    drain_inline_loop(a, 0)
}
drain_inline_loop = (a: MutPtr<PoolActor>, count: i64) i64 {
    cur := a.actor_mb()
    cur.nonempty().match ({
        true  => {
            m := cur.peek()
            a.head = cur.advance().head
            saved := enter(a.art)    // same ambient-rt wiring on the inline driver (identical to the pool path)
            a.behavior(a.user, m)
            leave(saved)
            a.scratch_reset()    // same per-behavior scratch reclamation on the inline (colorless) driver
            drain_inline_loop(a, count + 1)
        },
        false => count,
    })
}
// post a message to an actor's mailbox with NO scheduling (for the inline sync driver / pre-loading).
pool_post* = (actor: RawPtr<u8>, msg: i64) bool {
    a := actor_view(actor)
    cur := a.actor_mb()
    cur.is_full().match ({
        true  => false,
        false => {
            a.tail = cur.push(msg).tail
            true
        },
    })
}
