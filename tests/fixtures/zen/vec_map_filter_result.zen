// Vec.map / Vec.filter / vec.empty surface OOM as a Result value (errors-as-values), matching of/push.
// Happy path over a real heap allocator builds a Vec, maps (double), filters (keep evens), and probes the
// results. OOM path runs map/filter/empty through a failing allocator and asserts each returns .Err instead
// of writing through a null buffer.
halloc = std.mem.heap
vec = std.collections.vec
{ Allocator } = std.mem.alloc
{ Result, IoError } = std.core.result
{ to_exit } = std.core.bool
// an allocator that always fails — every acquire/resize yields null, which try_acquire maps to .Err.
LimitAlloc: {
    _: i32,
}
LimitAlloc.impl(Allocator, {
    acquire = (a: MutPtr<LimitAlloc>, n: i64) RawPtr<u8> { null_ptr() }
    resize = (a: MutPtr<LimitAlloc>, p: RawPtr<u8>, n: i64) RawPtr<u8> { null_ptr() }
    release = (a: MutPtr<LimitAlloc>, p: RawPtr<u8>) void { }
})
main = () i32 {
    alloc := halloc.gpa()
    a := alloc.addr()
    // happy path: of seeds [1,2,3,4]; map doubles → [2,4,6,8]; filter keeps evens (all four here).
    v := vec.of(a, [1, 2, 3, 4]).expect("of")
    doubled := v.map(a, (x) { x * 2 }).expect("map")
    kept := v.filter(a, (x) { x % 2 == 0 }).expect("filter")
    er: Result<vec.Vec<i32>, IoError> := vec.empty(a)
    e := er.expect("empty")
    good := doubled.len() == 4
        && doubled.get(0) == 2
        && doubled.get(3) == 8
        && kept.len() == 2
        && kept.get(0) == 2
        && kept.get(1) == 4
        && e.len() == 0
    doubled.free(a)
    kept.free(a)
    e.free(a)
    // OOM path: a failing allocator makes each op return .Err rather than write through null.
    lim := LimitAlloc(_: 0)
    l := lim.addr()
    map_err := v.map(l, (x) { x * 2 }).match ({
        .Err(z) => true,
        .Ok(z)  => false,
    })
    filter_err := v.filter(l, (x) { x % 2 == 0 }).match ({
        .Err(z) => true,
        .Ok(z)  => false,
    })
    ler: Result<vec.Vec<i32>, IoError> := vec.empty(l)
    empty_err := ler.match ({
        .Err(z) => true,
        .Ok(z)  => false,
    })
    v.free(a)
    ok := good && map_err && filter_err && empty_err
    ok.to_exit()
}
