{ diagnostic_from_source } = compiler.validate.diag
{ to_exit } = std.core.bool
main = () i32 {
    diag := diagnostic_from_source("main = () i32 { missing_name() }\n", 1091, 1)    // 1091 = kind 3 (undefined-name) + (offset 16 + 1) * 64 (6-bit kind packing with the +1 position bias, see kv_at)
    ok := diag.kind == "undefined-name"
        && diag.span.start == 16
        && diag.span.width == 12
        && diag.count == 1
        && diag.message == "undefined name"
        && diag.hint == "declare the name, import it, or qualify the intended module binding"
    ok.to_exit()
}
