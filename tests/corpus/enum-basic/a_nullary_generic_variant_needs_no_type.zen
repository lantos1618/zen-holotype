// THE SECOND CONTROL OF ISSUE 738, AND THE TEST THAT STOPS THE FIX FROM
// OVER-REACHING. A nullary variant consumed ONLY by .match must keep
// compiling with no annotation anywhere: nothing in the program demands
// a type of `x`, so refusing the bare head here would take every
// ordinary `Shape.Unit => ..` down with the bug.
//
// The fix refuses only where a position's expectation carries arguments
// and the value wrote none (args_agree, sema_check.zen); a match on x
// writes none. Prints 0.

Opt<T> = Some(T) | None

main = (env: Env) Res<i32, AllocError> {
    x = Opt.None;
    println("{}", x.match({ Some(v) => 1, None => 0 }));
    Ok(0);
}
