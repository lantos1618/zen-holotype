// Renders types and signatures already settled by sema. Missing or poisoned
// semantic information produces a hover whose `found` field is false.

str, String = std.text
Vec = std.collections
Range = std.core
Alloc, AllocError = std.mem
Ast, Decl, ExprId, Member, TypeId, Span, Function, TriviaRun = std.ast
Variant = std.ast
Checker = sema.sema_check
TyId, TyNamed, Prim = sema.sema_ty
Def, decl_at = sema.sema_def
to_pos, to_wire, WirePos = lsp.lsp_pos
Tell, told_at = std.ast.ast_named
check_standalone = lsp.lsp_query
check_build = zen.zen_build

Hover* = {
    found*: bool,
    shown*: str,
    start*: WirePos,
    end*: WirePos,
}

hover_at* = (a: Alloc, name: str, text: str, line: usize, character: usize)
            Res<Hover, AllocError> {
    c ::= check_standalone(a, name, text).try();

    pos = to_pos(text, line, character);
    said(c, a, text, told_at(c.tree, name, pos))
}

hover_in* = (
    env       : Env,
    a         : Alloc,
    workspace : str,
    path      : str,
    text      : str,
    line      : usize,
    character : usize
) Res<Hover, AllocError> {
    checked = check_build(env, a, workspace, path, text).try();
    pos     = to_pos(text, line, character);
    said(checked.c, a, text, told_at(checked.c.tree, checked.rel, pos))
}

hover_with* = (
    c         : Checker,
    a         : Alloc,
    rel       : str,
    text      : str,
    line      : usize,
    character : usize
) Res<Hover, AllocError> {
    pos = to_pos(text, line, character);
    said(c, a, text, told_at(c.tree, rel, pos))
}

no_type* = () Hover {
    Hover(
        found: false,
        shown: "",
        start: WirePos(line: 0, character: 0),
        end: WirePos(line: 0, character: 0)
    )
}

said = (c : Checker, a: Alloc, text: str, t: Tell) Res<Hover, AllocError> {
    out ::= a.String().try();
    t.match({
        Nothing     => nothing_found(),
        Sig(f)      => wired(
            text,
            f.name.span,
            write_decl_sig(c, f, out).try(),
            out
        ),
        OfType(ta)  => wired(
            text,
            ta.span,
            write_written_ty(c, ta.id, out).try(),
            out
        ),
        OfValue(v)  => wired(text, v.span, write_val(c, v.id, out).try(), out),
        Imported(_) => nothing_found(),
    })
}

nothing_found = () Res<Hover, AllocError> { Ok(no_type()) }

wired = (text: str, span: Span, known: bool, out :: String)
        Res<Hover, AllocError> {
    Ok(Hover(
        found: known,
        shown: out.view(),
        start: to_wire(text, span.start),
        end: to_wire(text, span.end)
    ));
}

write_written_ty = (
    c   : Checker,
    id  : TypeId,
    out :: String
) Res<bool, AllocError> {
    c.type_memo.get(id).match({
        None     => no_answer(),
        Ok(memo) => write_ty_named(c, memo, out),
    })
}

write_ty = (c : Checker, id: TypeId, out :: String) Res<bool, AllocError> {
    c.type_memo.get(id).match({
        None     => no_answer(),
        Ok(memo) => write_ty_id(c, memo, out),
    })
}

write_ty_named = (c : Checker, id: TyId, out :: String) Res<bool, AllocError> {
    poison_free(c, id).match({
        false => no_answer(),
        true  => c.types.at(id).match({
            Prim(p)  => write_prim(c, id, p, out),
            Named(n) => write_named(c, id, n, out),
            _        => { c.types.write_name(id, out).try(); an_answer() },
        }),
    })
}

write_ty_value = (c : Checker, id: TyId, out :: String) Res<bool, AllocError> {
    poison_free(c, id).match({
        false => no_answer(),
        true  => c.types.at(id).match({
            Named(n) => write_named(c, id, n, out),
            _        => { c.types.write_name(id, out).try(); an_answer() },
        }),
    })
}

write_named = (c : Checker, id: TyId, n: TyNamed, out :: String)
              Res<bool, AllocError> {
    c.types.write_name(id, out).try();
    decl_at(c.tree, n.decl).match({
        None   => an_answer(),
        Ok(dd) => { write_decl_note(
            c,
            dd,
            WHOLE_SHAPE,
            out
        ).try(); an_answer() },
    })
}

write_prim = (c : Checker, id: TyId, p: Prim, out :: String)
             Res<bool, AllocError> {
    c.types.write_name(id, out).try();
    defs ::= c.alloc.Vec<Def>();
    c.world.prelude_of(p.name, defs).try();
    defs.get(0).match({
        None  => an_answer(),
        Ok(d) => {
            write_prelude_note(c, d, out).try();
            an_answer()
        },
    })
}

write_prelude_note = (c : Checker, d: Def, out :: String) Res<(), AllocError> {
    decl_at(c.tree, d.id).match({
        None   => Ok(()),
        Ok(dd) => write_decl_note(c, dd, EXPORTED_ONLY, out),
    })
}

write_decl_note = (c : Checker, dd: Decl, all: bool, out :: String)
                  Res<(), AllocError> {
    doc = doc_block(c.alloc, c.tree, dd.leading).try();
    (doc.len > 0).then(() {
        out.add(" — ").try();
        out.add(doc).try();
    });
    write_members(c, dd, Shown(joined: joiner(doc), all: all), out)
}

EXPORTED_ONLY: bool = false

WHOLE_SHAPE: bool = true

Shown = {
    joined: str,
    all: bool,
}

joiner = (doc: str) str {
    (doc.len == 0).match({
        true  => " — ",
        false => ended(doc).match({ true => " ", false => "; " }),
    })
}

write_members = (c : Checker, dd: Decl, shown: Shown, out :: String)
                Res<(), AllocError> {
    body ::= c.alloc.String().try();
    dd.kind.match({
        Struct(s) => write_member_run(c, s.members, shown.all, body),
        Enum(e)   => write_variant_run(c, e.variants, body),
        _         => Ok(()),
    }).try();
    (body.len() > 0).then(() {
        out.add(shown.joined).try();
        out.add(body.view()).try();
    });
    Ok(());
}

MEMBERS: str = "members: "

write_member_run = (c : Checker, ms: Vec<Member>, all: bool, body :: String)
                   Res<(), AllocError> {
    list  ::= c.alloc.String().try();
    names ::= c.alloc.Vec<str>();
    ms.loop((h, m) { write_one_member(c, m, all, names, list).try(); });
    (list.len() > 0).then(() {
        body.add(MEMBERS).try();
        body.add(list.view()).try();
    });
    Ok(());
}

write_one_member = (
    c     : Checker,
    m     : Member,
    all   : bool,
    names :: Vec<str>,
    body  :: String
) Res<(), AllocError> {
    m.kind.match({
        Field(f)    => write_typed(
            c,
            all || f.exported,
            f.name.text,
            f.type,
            body
        ),
        Const(k)    => write_typed(
            c,
            all || k.exported,
            k.name.text,
            k.type,
            body
        ),
        Function(f) => write_fn_member(c, f, all, names, body),
    })
}

write_typed = (
    c    : Checker,
    show : bool,
    name : str,
    ty   : Res<TypeId>,
    body :: String
) Res<(), AllocError> {
    show.match({
        false => Ok(()),
        true  => {
            separate(body).try();
            body.add(name).try();
            write_type_suffix(c, ty, body)
        },
    })
}

write_type_suffix = (c : Checker, ty: Res<TypeId>, body :: String)
                    Res<(), AllocError> {
    ty.match({
        None   => Ok(()),
        Ok(id) => {
            scratch ::= c.alloc.String().try();
            write_ty(c, id, scratch).try().then(() {
                body.add(": ").try();
                body.add(scratch.view()).try();
            });
            Ok(());
        },
    })
}

write_fn_member = (
    c     : Checker,
    f     : Function,
    all   : bool,
    names :: Vec<str>,
    body  :: String
) Res<(), AllocError> {
    (all || f.exported).match({
        false => Ok(()),
        true  => names.find((name) { name.eq(f.name.text) }).match({
            Ok(_) => Ok(()),
            None  => {
                names.add(f.name.text).try();
            scratch ::= c.alloc.String().try();
            whole = write_decl_sig(c, f, scratch).try();
            separate(body).try();
            whole.match({
                true  => body.add(scratch.view()),
                false => body.add(f.name.text),
            })
            },
        }),
    })
}

write_variant_run = (c : Checker, vs: Vec<Variant>, body :: String)
                    Res<(), AllocError> {
    vs.loop((h, i, v) {
        (i > 0).then(() { body.add(" | ").try() });
        body.add(v.name.text).try();
        write_payload(c, v.payload, body).try();
    });
    Ok(());
}

write_payload = (c : Checker, payload: Res<TypeId>, body :: String)
                Res<(), AllocError> {
    payload.match({
        None   => Ok(()),
        Ok(id) => {
            scratch ::= c.alloc.String().try();
            write_ty(c, id, scratch).try().then(() {
                body.add("(").try();
                body.add(scratch.view()).try();
                body.add(")").try();
            });
            Ok(());
        },
    })
}

separate = (body :: String) Res<(), AllocError> {
    (body.len() > 0).match({ true => body.add(", "), false => Ok(()) })
}

doc_block = (a: Alloc, tree: Ast, run: TriviaRun) Res<str, AllocError> {
    doc ::= a.String().try();
    Range(after_last_blank(tree, run), run.len).loop((h, i) {
        piece = tree.trivia_at(run, i);
        ended(doc.view()).match({
            true  => (),
            false => piece.kind.match({
                LineComment => add_doc_line(
                    comment_text(piece.text),
                    doc
                ).try(),
                _           => (),
            }),
        });
    });
    Ok(doc.view());
}

ended = (doc: str) bool {
    (doc.len > 0) && terminal(doc.index(doc.len - 1))
}

terminal = (b: u8) bool { b.is_in(['.', '!', '?']) }

after_last_blank = (tree: Ast, run: TriviaRun) usize {
    from ::= 0;
    Range(0, run.len).loop((h, i) {
        tree.trivia_at(run, i).kind.match({
            Blank => { from = i + 1; },
            _     => (),
        });
    });
    from;
}

add_doc_line = (line: str, doc :: String) Res<(), AllocError> {
    (line.len > 0).then(() {
        (doc.len() > 0).then(() { doc.add(" ").try() });
        doc.add(line).try();
    });
    Ok(());
}

comment_text = (text: str) str {
    from ::= 0;
    loop(
        () { from < text.len && text.index(from) == '/' },
        (h) { from = from + 1; }
    );
    loop(
        () { from < text.len && text.index(from) == ' ' },
        (h) { from = from + 1; }
    );
    text.slice(from, text.len);
}

write_val = (c : Checker, e: ExprId, out :: String) Res<bool, AllocError> {
    c.expr_memo.get(e).match({
        None     => no_answer(),
        Ok(memo) => write_ty_value(c, memo, out),
    })
}

write_ty_id = (c : Checker, id: TyId, out :: String) Res<bool, AllocError> {
    poison_free(c, id).match({
        false => no_answer(),
        true  => { c.types.write_name(id, out).try(); an_answer() },
    })
}

poison_free = (c : Checker, id: TyId) bool {
    c.types.at(id).match({
        Unknown   => false,
        Res(r)    => poison_free(c, r.value) && poison_free(c, r.error),
        Named(n)  => all_poison_free(c, n.args),
        Fn(f)     => poison_free(c, f.ret) && all_poison_free(c, f.params),
        Union(u)  => all_poison_free(c, u.members),
        Array(ar) => poison_free(c, ar.elem),
        _         => true,
    })
}

all_poison_free = (c : Checker, ids: Vec<TyId>) bool {
    every ::= true;
    ids.loop((h, id) { every = every && poison_free(c, id); });
    every;
}

write_decl_sig = (
    c   : Checker,
    f   : Function,
    out :: String
) Res<bool, AllocError> {
    out.add(f.name.text).try();
    out.add(" = ").try();
    write_tparams(f, out).try();
    out.add("(").try();
    whole ::= true;
    f.params.loop((h, i, prm) {
        (i > 0).then(() { out.add(", ").try() });
        out.add(prm.name.text).try();
        out.add(prm.binder()).try();
        whole = write_opt_ty(c, prm.type, out).try() && whole;
    });
    out.add(") ").try();
    Ok(write_opt_ty(c, f.ret, out).try() && whole);
}

write_tparams = (f: Function, out :: String) Res<(), AllocError> {
    (f.tparams.len == 0).match({
        true  => Ok(()),
        false => {
            out.add("<").try();
            f.tparams.loop((h, i, tparam) {
                (i > 0).then(() { out.add(", ").try() });
                out.add(tparam.name.text).try();
            });
            out.add(">").try();
            Ok(())
        },
    })
}

write_opt_ty = (c : Checker, t: Res<TypeId>, out :: String)
               Res<bool, AllocError> {
    t.match({
        None   => no_answer(),
        Ok(id) => write_ty(c, id, out),
    })
}

an_answer = () Res<bool, AllocError> { Ok(true) }

no_answer = () Res<bool, AllocError> { Ok(false) }
