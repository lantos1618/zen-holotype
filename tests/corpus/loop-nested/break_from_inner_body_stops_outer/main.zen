// tests/corpus/loop-nested/break_from_inner_body_stops_outer.zen
// the handle names its OWN loop, so a break fired from inside the
// inner body with the OUTER handle must leave BOTH loops at once.
//
// This is the other half of the depth rule. loop-map_body_can_break_
// early.zen's mutation bound a nested body's handle one level too deep;
// the opposite mistake — rebinding every handle to the nearest loop —
// is just as silent, and only a program that breaks the OUTER handle
// from two closures down can tell. If `h_outer` got re-bound to the
// inner loop here, the inner loop would stop, `done {}` would never
// print, and the remaining outer passes would run anyway: plausible
// output, wrong count, wrong last line.
//
// The println sits AFTER the inner loop on purpose: it is the proof
// the exit jumped past both frames and not merely out of one.

main = (env: Env) Res<i32, AllocError> {
    Range(0, 5).loop((h_outer, outer) {
        println("outer {}", outer);
        Range(0, 100).loop((h_inner, value) {
            (outer == 1).then(() { h_outer.break() });
            println("  inner {}", value);
        });
        println("  survived outer {}", outer);
    });
    println("done");
    Ok(0);
}
