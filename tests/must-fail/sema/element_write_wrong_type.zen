// An element is storage too. `buf[i] = e` is the same statement shape as
// `p.x = e` and had the same hole: with no written type the value was
// checked against itself, so the element type was never consulted.
//
// The message names the element type, which the two toolchains infer
// differently for a bare `[1, 2, 3]` — `int` the literal type, or `i32`.
// That disagreement is older than this test, so the first line asserts
// only the half both agree on and the position carries the rest.
main* = (env: Env) i32 {
    buf ::= [1, 2, 3];
    buf[0] = "not an int";
    0
}
