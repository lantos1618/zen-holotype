// importing std.build must compile. It rotted once invisibly: the
// self-build's walk never reaches std/std.zen, so Function and Module
// (std/ast's nodes, which only @meta can hand over — stage 5)
// sat undefined in build.zen while every gate stayed green. The
// stand-ins are opaque on purpose; what this pins is that the api a
// build file is handed RESOLVES, walk or no walk.
//
// AND THAT ITS PLAIN-DATA TYPES CARRY VALUES. The four names used to be
// imported and never used, so the only rot this caught was a name
// disappearing outright: misdeclare a field's type, reorder Os's variants,
// or let `Exe.out`'s default fall to a zero instead of None, and nothing
// noticed. Every field below is constructed with a distinctive value and
// read back.
//
// `Exe` WAS THE ONE TYPE NOT CONSTRUCTED HERE, and not by choice: its
// `out* :: Res<Path> = None` default is a BARE nullary variant, which codegen
// refused ("a field default that names a function or reads a frame") though
// it lowered the qualified `Res.None` spelling fine -- issue #734. That is
// closed, so the construction is back, and this file is what holds it closed:
// the central target type of the build api is MADE, and its defaulted `out`
// is read back as the None it was written as rather than as a zero. A name
// imported and never used is exactly how the previous rot stayed invisible.

Builder, Module, Function = std.build
Budget, Package, Dep, Exe, Os, Arch, BuildFault, BuildError = std.build
Vec = std.collections

main = (env: Env) Res<i32, BuildError> {
    alloc ::= env.mem.alloc();

    p = Package(
        url: "https://example.test/json",
        version: "1.4.2",
        hash: "b7c9"
    );
    println("{} {} {}", p.url, p.version, p.hash);

    bud = Budget(name: "parse", ns_op: 125000, allocs_op: 3, bytes_op: 4096);
    println("{} {} {} {}", bud.name, bud.ns_op, bud.allocs_op, bud.bytes_op);

    deps ::= alloc.Vec<Dep>();
    deps.add(Dep(name: "json")).try();
    deps.add(Dep(name: "http")).try();
    deps.get(1).match({
        Ok(d) => println("deps {} {}", deps.len, d.name),
        None  => println("deps {} missing", deps.len),
    });

    Os.Linux.match({
        Macos   => println("macos"),
        Linux   => println("linux"),
        Windows => println("windows"),
    });
    Arch.Arm64.match({
        X86_64 => println("x86_64"),
        Arm64  => println("arm64"),
    });
    BuildFault.HashMismatch.match({
        NotFound        => println("not found"),
        FetchFailed     => println("fetch failed"),
        VersionConflict => println("version conflict"),
        HashMismatch    => println("hash mismatch"),
    });

    e = Exe(src: Path("app/main.zen"), deps: alloc.Vec<Dep>());
    println("exe {}", e.src.text);
    e.out.match({
        Ok(o) => println("out {}", o.text),
        None  => println("out absent"),
    });

    Ok(0);
}
