// `main` used to receive `(Env){0}` — a zeroed struct — so env.argv was
// empty in every program ever compiled, while gen_c dutifully assigned
// zg_argc/zg_argv in main and nothing read them. A compiler cannot be
// told what to compile that way, which is what made this the last thing
// between the tree and a fixpoint attempt.
//
// The runner invokes the binary with no extra arguments, so the only
// thing that is true everywhere is that argv[0] exists and names the
// program. That is what is asserted; a count would pin the harness.
//
// EVERY EXPECTED LINE IS THE SECOND ARM OF ITS MATCH. Both questions used
// to be spelled so that the answer they wanted was arm one, and this repo
// has a documented first-arm-wins bug class -- so a `.match` lowering that
// always took arm 1 printed exactly the expected output against a
// completely zeroed argv. The conditions below are inverted, and the
// out-of-range probe takes the None arm, so arm one is wrong every time.
main = (env: Env) Res<i32, ArgError> {
    (env.argv.len == 0).match({
        true  => println("argv0 MISSING"),
        false => println("argv0 present"),
    });
    env.argv.get(0).match({
        Ok(p) => (p.len == 0).match({
            true  => println("argv0 is empty"),
            false => println("argv0 is named"),
        }),
        None  => println("argv0 unreadable"),
    });
    env.argv.get(4096).match({
        Ok(_) => println("argv4096 exists"),
        None  => println("argv4096 absent"),
    });
    Ok(0);
}
