// Public code-generation surface for the driver: the emitter, stable
// ordering, and the C backend's entry points. Symbol naming and backend
// diagnostics are reached through `gen.gen_name` and `gen.gen_diag`.

Emit*, order*                                        = gen.gen_emit

CBackend*, emit_program*, render_symbol_map*         = gen.gen_c
lower_program*, emit_header*, emit_unit*, unit_used* = gen.gen_c
