// the receiver requirement is a promise, not a consequence: it is
// declared, never inferred from the body. so a `:` method that writes
// its own bytes is an error IN THE METHOD — the compiler does not
// quietly upgrade `bump` to `::` and break every caller in another
// module the next time the body changes.
//
// `n` is a `::` field, so field mutability is not what is wrong here.
// the caller below is a `::` binding, so the call site is not either.

Counter = {
    n :: i32,

    bump* = (self: @Self) () { self.n = self.n + 1; }
}

main = (env: Env) Res<i32, IoError> {
    c ::= Counter(n: 0);
    c.bump();
    println("{}", c.n);
    Ok(0);
}
