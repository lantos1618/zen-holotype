// tests/corpus/traps/wrap_mul_i32_min.zen
// i32.MIN *% -1 does NOT trap. the product wraps back onto i32.MIN,
// the one value that is its own negation

// main must name an error type. a trap never lifts into Res:
// it aborts the process
Error =
    Overflow,
    DivideByZero,
    OutOfBounds

main = (env: Env) Res<i32, Error> {
    x: i32 = i32.MIN;
    neg_one: i32 = -1;
    wrapped = x *% neg_one;
    println("{}", wrapped);
    Ok(0);
}
