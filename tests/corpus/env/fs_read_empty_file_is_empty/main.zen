// tests/corpus/env/fs_read_empty_file_is_empty/main.zen
// A file with nothing in it is Ok and zero bytes, not an error. The
// distinction matters to a compiler: an empty module is a module,
// and reporting it as a failed read would send the caller looking
// for a file that is right there.
//
// The runner stages this directory as `src/`, so the empty file this
// test ships is `src/empty.zen`.

FsError = std.env

main = (env: Env) Res<i32, FsError> {
    alloc ::= env.mem.alloc();

    text = env.fs.read(alloc, "src/empty.zen").try();
    println("{} bytes, empty {}", text.len(), text.is_empty());

    // and it is still a buffer: nothing about the empty case is a
    // special value the caller has to know about
    println("exists {}", env.fs.exists("src/empty.zen"));
    println("is_dir {}", env.fs.is_dir("src/empty.zen"));
    Ok(0);
}
