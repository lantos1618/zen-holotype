Box = {
    n: i32,

    make = (n: i32, label: Res<str>) () {
        println("associated {} {}", n, label.value_or("none"));
    }

    show = (self: @Self, label: Res<str>) () {
        println("method {} {}", self.n, label.value_or("none"));
    }
}

show_free = (n: i32, label: Res<str>) () {
    println("free {} {}", n, label.value_or("none"));
}

pair = (a: str, left: Res<str>, right: Res<str>) () {
    println("pair {} {} {}", a, left.value_or("none"), right.value_or("none"));
}

visit = (body: (n: i32) (), label: Res<str>) () {
    body(7);
    println("inline {}", label.value_or("none"));
}

main = (env: Env) Res<i32, AllocError> {
    show_free(1);
    show_free(2, "named");

    box = Box(n: 3);
    box.show();
    box.show("member");
    Box.make(5);

    pair("a");
    pair("b", "left");
    pair("c", "left", "right");

    visit((n) { println("body {}", n) });
    Ok(0)
}
