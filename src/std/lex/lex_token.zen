// Token kinds and half-open source positions. Offsets slice source bytes;
// one-based line and byte-column values are used in diagnostics.

str = std.text

// A byte position. `line` and `col` are one-based; `col` counts bytes.
Pos* = {
    offset*: usize,
    line*: usize,
    col*: usize,
}

Pos.impl(Display, {
    toString ::= (self: @Self, out :: Sink) Res<(), WriteError> {
        out.fmt("{}:{}", self.line, self.col)
    }
})

// Half-open byte span. Eof has an empty span at the end of input.
Span* = {
    start*: Pos,
    end*: Pos,
}

// Complete token alphabet. Comments are tokens so the formatter can preserve
// them; whitespace is derived from gaps between spans.
TokenKind* =
      Ident              // `[A-Za-z_][A-Za-z0-9_]*`; `_` is a wildcard only in patterns
    | Int(u64)           // validated unsigned magnitude; sign is a unary operator
    | Float              // source digits; conversion waits for the target type
    | Str
    | Char
    | True | False
    | Consume
    | AtSelf | AtMeta | AtScope   // the entire `@` namespace

    | LineComment | BlockComment

    | ParenOpen | ParenClose
    | BracketOpen | BracketClose
    | BraceOpen | BraceClose
    | Comma | Semicolon | Dot | Ellipsis
    | Colon | ColonColon | ColonColonEq
    | Eq | EqEq | Arrow
    | Bang | BangEq
    | Lt | LtEq | Gt | GtEq
    | Amp | AmpAmp
    | Bar | BarBar
    | Plus | PlusWrap
    | Minus | MinusWrap
    | Star | StarWrap
    | Slash | Percent

    | Eof                // exactly one, always last, empty span

// Token equality compares Int payloads and otherwise compares variant tags.
TokenKind.impl(Eq, {
    eq ::= (self: @Self, other: @Self) bool {
        self.match({
            Ident        => other.match({ Ident => true, _ => false }),
            Int(a)       => other.match({ Int(b) => a == b, _ => false }),
            Float        => other.match({ Float => true, _ => false }),
            Str          => other.match({ Str => true, _ => false }),
            Char         => other.match({ Char => true, _ => false }),
            True         => other.match({ True => true, _ => false }),
            False        => other.match({ False => true, _ => false }),
            Consume      => other.match({ Consume => true, _ => false }),
            AtSelf       => other.match({ AtSelf => true, _ => false }),
            AtMeta       => other.match({ AtMeta => true, _ => false }),
            AtScope      => other.match({ AtScope => true, _ => false }),
            LineComment  => other.match({ LineComment => true, _ => false }),
            BlockComment => other.match({ BlockComment => true, _ => false }),
            ParenOpen    => other.match({ ParenOpen => true, _ => false }),
            ParenClose   => other.match({ ParenClose => true, _ => false }),
            BracketOpen  => other.match({ BracketOpen => true, _ => false }),
            BracketClose => other.match({ BracketClose => true, _ => false }),
            BraceOpen    => other.match({ BraceOpen => true, _ => false }),
            BraceClose   => other.match({ BraceClose => true, _ => false }),
            Comma        => other.match({ Comma => true, _ => false }),
            Semicolon    => other.match({ Semicolon => true, _ => false }),
            Dot          => other.match({ Dot => true, _ => false }),
            Ellipsis     => other.match({ Ellipsis => true, _ => false }),
            Colon        => other.match({ Colon => true, _ => false }),
            ColonColon   => other.match({ ColonColon => true, _ => false }),
            ColonColonEq => other.match({ ColonColonEq => true, _ => false }),
            Eq           => other.match({ Eq => true, _ => false }),
            EqEq         => other.match({ EqEq => true, _ => false }),
            Arrow        => other.match({ Arrow => true, _ => false }),
            Bang         => other.match({ Bang => true, _ => false }),
            BangEq       => other.match({ BangEq => true, _ => false }),
            Lt           => other.match({ Lt => true, _ => false }),
            LtEq         => other.match({ LtEq => true, _ => false }),
            Gt           => other.match({ Gt => true, _ => false }),
            GtEq         => other.match({ GtEq => true, _ => false }),
            Amp          => other.match({ Amp => true, _ => false }),
            AmpAmp       => other.match({ AmpAmp => true, _ => false }),
            Bar          => other.match({ Bar => true, _ => false }),
            BarBar       => other.match({ BarBar => true, _ => false }),
            Plus         => other.match({ Plus => true, _ => false }),
            PlusWrap     => other.match({ PlusWrap => true, _ => false }),
            Minus        => other.match({ Minus => true, _ => false }),
            MinusWrap    => other.match({ MinusWrap => true, _ => false }),
            Star         => other.match({ Star => true, _ => false }),
            StarWrap     => other.match({ StarWrap => true, _ => false }),
            Slash        => other.match({ Slash => true, _ => false }),
            Percent      => other.match({ Percent => true, _ => false }),
            Eof          => other.match({ Eof => true, _ => false }),
        });
    }
})

Token* = {
    kind*: TokenKind,
    span*: Span,
}

// Source bytes and the filename used in diagnostics.
Source* = {
    file*: str,
    text*: str,

    // Borrow the source bytes covered by a token.
    text_of* = (self: @Self, token: Token) str { self.text_in(token.span) }

    // Borrow the source bytes a span covers.
    text_in* = (self: @Self, span: Span) str {
        self.text.slice(span.start.offset, span.end.offset)
    }
}

// User-facing token names. Operators are named by their source glyphs.
kind_name* = (kind: TokenKind) str {
    kind.match({
        Ident        => "an identifier",
        Int(_)       => "an integer literal",
        Float        => "a float literal",
        Str          => "a string literal",
        Char         => "a character literal",
        True         => "`true`",
        False        => "`false`",
        Consume      => "`consume`",
        AtSelf       => "`@Self`",
        AtMeta       => "`@meta`",
        AtScope      => "`@scope`",
        LineComment  => "a line comment",
        BlockComment => "a block comment",
        ParenOpen    => "`(`",
        ParenClose   => "`)`",
        BracketOpen  => "`[`",
        BracketClose => "`]`",
        BraceOpen    => "`{`",
        BraceClose   => "`}`",
        Comma        => "`,`",
        Semicolon    => "`;`",
        Dot          => "`.`",
        Ellipsis     => "`...`",
        Colon        => "`:`",
        ColonColon   => "`::`",
        ColonColonEq => "`::=`",
        Eq           => "`=`",
        EqEq         => "`==`",
        Arrow        => "`=>`",
        Bang         => "`!`",
        BangEq       => "`!=`",
        Lt           => "`<`",
        LtEq         => "`<=`",
        Gt           => "`>`",
        GtEq         => "`>=`",
        Amp          => "`&`",
        AmpAmp       => "`&&`",
        Bar          => "`|`",
        BarBar       => "`||`",
        Plus         => "`+`",
        PlusWrap     => "`+%`",
        Minus        => "`-`",
        MinusWrap    => "`-%`",
        Star         => "`*`",
        StarWrap     => "`*%`",
        Slash        => "`/`",
        Percent      => "`%`",
        Eof          => "end of file",
    });
}
