// compiler.parse_expr — expression parsing entry + operator-precedence climbing (term/add/shift/bitwise/compare/and/or), tying the parse_* family together.
// Atoms/literals live in compiler.parse_atom, postfix chains in compiler.parse_postfix,
// match forms in compiler.parse_match, identifier-led primaries in compiler.parse_primary.
{ Expr } = compiler.ast.ast_types
{ bin_at, cond } = compiler.genc
{ Scan, Token, scan } = compiler.lex
{ at } = std.text.ascii
{ Malloc } = std.mem.alloc
{ enode, is_op, is_op1, op_str, parse_atom } = compiler.parse_atom
{ is_fat_arrow } = compiler.parse_match
{ pdepth_enter, pdepth_exit, pdepth_over, perr_set_at } = compiler.parse_type
PExpr*: {
    expr: Ptr<Expr>,
    next: i32,
}
is_addsub = (src: StringView, t: Token) bool { src.is_op(t, '+') || src.is_op(t, '-') }
is_muldiv = (src: StringView, t: Token) bool {
    src.is_op(t, '*') || src.is_op(t, '/') || src.is_op(t, '%')
}
// Precedence ladder, left-associative unless noted.
parse_term = (a: MutPtr<Malloc>, src: StringView, pos: i32) PExpr {
    a.term_rest(src, a.parse_atom(src, pos))
}
term_rest = (a: MutPtr<Malloc>, src: StringView, lhs: PExpr) PExpr {
    sc = src.scan(lhs.next)
    src.is_muldiv(sc.tok).then({ a.term_more(src, lhs, sc) }, { lhs })
}
term_more = (a: MutPtr<Malloc>, src: StringView, lhs: PExpr, sc: Scan) PExpr {
    // DEPTH CAP (see parse_type.zen): a flat operator chain (`1*1*1…`) recurses `_rest`→`_more` per
    // operator WITHOUT re-entering the balanced parse_atom guard, so each ladder level bounds its own
    // chain here. Past the cap, stop folding and return `lhs` (perr already set); the frames unwind.
    pdepth_enter()
    r = pdepth_over().match ({
        true  => lhs,
        false => {
            rhs = a.parse_atom(src, sc.next)
            a.term_rest(src, PExpr(
                expr: a.enode(bin_at(src.at(sc.tok.start).op_str(), lhs.expr, rhs.expr, sc.tok.start)),
                next: rhs.next,
            ))
        },
    })
    pdepth_exit()
    r
}
parse_expr = (a: MutPtr<Malloc>, src: StringView, pos: i32) PExpr {
    a.expr_rest(src, a.parse_term(src, pos))
}
expr_rest = (a: MutPtr<Malloc>, src: StringView, lhs: PExpr) PExpr {
    sc = src.scan(lhs.next)
    src.is_addsub(sc.tok).then({ a.expr_more(src, lhs, sc) }, { lhs })
}
expr_more = (a: MutPtr<Malloc>, src: StringView, lhs: PExpr, sc: Scan) PExpr {
    pdepth_enter()
    r = pdepth_over().match ({
        true  => lhs,
        false => {
            rhs = a.parse_term(src, sc.next)
            a.expr_rest(src, PExpr(
                expr: a.enode(bin_at(src.at(sc.tok.start).op_str(), lhs.expr, rhs.expr, sc.tok.start)),
                next: rhs.next,
            ))
        },
    })
    pdepth_exit()
    r
}
// Bitwise precedence is shift > & > ^ > |, tighter than comparison.
is_shift = (src: StringView, t: Token) bool {
    t.kind.match ({
        .Sym => t.len == 2
            && src.at(t.start) == src.at(t.start + 1)
            && (src.at(t.start) == '<' || src.at(t.start) == '>'),
        _    => false,
    })
}
shift_op_str = (src: StringView, t: Token) StringView {
    (src.at(t.start) == '<').then({ "<<" }, { ">>" })
}
parse_shift = (a: MutPtr<Malloc>, src: StringView, pos: i32) PExpr {
    a.shift_rest(src, a.parse_expr(src, pos))
}
shift_rest = (a: MutPtr<Malloc>, src: StringView, lhs: PExpr) PExpr {
    sc = src.scan(lhs.next)
    src.is_shift(sc.tok).then({ a.shift_more(src, lhs, sc) }, { lhs })
}
shift_more = (a: MutPtr<Malloc>, src: StringView, lhs: PExpr, sc: Scan) PExpr {
    pdepth_enter()
    r = pdepth_over().match ({
        true  => lhs,
        false => {
            rhs = a.parse_expr(src, sc.next)
            a.shift_rest(src, PExpr(
                expr: a.enode(bin_at(src.shift_op_str(sc.tok), lhs.expr, rhs.expr, sc.tok.start)),
                next: rhs.next,
            ))
        },
    })
    pdepth_exit()
    r
}
is_band = (src: StringView, t: Token) bool {
    t.kind.match ({
        .Sym => t.len == 1 && src.at(t.start) == '&',
        _    => false,
    })
}
is_bxor = (src: StringView, t: Token) bool {
    t.kind.match ({
        .Sym => t.len == 1 && src.at(t.start) == '^',
        _    => false,
    })
}
parse_band = (a: MutPtr<Malloc>, src: StringView, pos: i32) PExpr {
    a.band_rest(src, a.parse_shift(src, pos))
}
band_rest = (a: MutPtr<Malloc>, src: StringView, lhs: PExpr) PExpr {
    sc = src.scan(lhs.next)
    src.is_band(sc.tok).then({ a.band_more(src, lhs, sc) }, { lhs })
}
band_more = (a: MutPtr<Malloc>, src: StringView, lhs: PExpr, sc: Scan) PExpr {
    pdepth_enter()
    r = pdepth_over().match ({
        true  => lhs,
        false => {
            rhs = a.parse_shift(src, sc.next)
            a.band_rest(src, PExpr(
                expr: a.enode(bin_at("&", lhs.expr, rhs.expr, sc.tok.start)),
                next: rhs.next,
            ))
        },
    })
    pdepth_exit()
    r
}
// Exported for enum-variant default exprs (`Name = expr`): parses everything tighter than a single
// `|`, so the variant separator is never swallowed as bitwise-or.
parse_bxor* = (a: MutPtr<Malloc>, src: StringView, pos: i32) PExpr {
    a.bxor_rest(src, a.parse_band(src, pos))
}
bxor_rest = (a: MutPtr<Malloc>, src: StringView, lhs: PExpr) PExpr {
    sc = src.scan(lhs.next)
    src.is_bxor(sc.tok).then({ a.bxor_more(src, lhs, sc) }, { lhs })
}
bxor_more = (a: MutPtr<Malloc>, src: StringView, lhs: PExpr, sc: Scan) PExpr {
    pdepth_enter()
    r = pdepth_over().match ({
        true  => lhs,
        false => {
            rhs = a.parse_band(src, sc.next)
            a.bxor_rest(src, PExpr(
                expr: a.enode(bin_at("^", lhs.expr, rhs.expr, sc.tok.start)),
                next: rhs.next,
            ))
        },
    })
    pdepth_exit()
    r
}
parse_bor = (a: MutPtr<Malloc>, src: StringView, pos: i32) PExpr {
    a.bor_rest(src, a.parse_bxor(src, pos))
}
bor_rest = (a: MutPtr<Malloc>, src: StringView, lhs: PExpr) PExpr {
    sc = src.scan(lhs.next)
    src.is_op1(sc.tok, '|').then({ a.bor_more(src, lhs, sc) }, { lhs })
}
bor_more = (a: MutPtr<Malloc>, src: StringView, lhs: PExpr, sc: Scan) PExpr {
    pdepth_enter()
    r = pdepth_over().match ({
        true  => lhs,
        false => {
            rhs = a.parse_bxor(src, sc.next)
            a.bor_rest(src, PExpr(
                expr: a.enode(bin_at("|", lhs.expr, rhs.expr, sc.tok.start)),
                next: rhs.next,
            ))
        },
    })
    pdepth_exit()
    r
}
// Comparison excludes shifts and `=>`; `=` alone is assignment.
is_cmp_byte = (b: u8, len: i32) bool {
    b == '=' && len == 2 || b == '!' && len == 2 || b == '<' || b == '>'
}
is_cmp = (src: StringView, t: Token) bool {
    t.kind.match ({
        .Sym => src.at(t.start).is_cmp_byte(t.len)
            && src.is_shift(t).then({ false }, { true })
            && src.is_fat_arrow(t).then({ false }, { true }),
        _    => false,
    })
}
cmp_op_str = (src: StringView, t: Token) StringView {
    b0 = src.at(t.start)
    (b0 == '=').match ({
        true  => "==",
        false => (b0 == '!').match ({
            true  => "!=",
            false => (b0 == '<').match ({
                true  => (t.len == 2).then({ "<=" }, { "<" }),
                false => (t.len == 2).then({ ">=" }, { ">" }),
            }),
        }),
    })
}
parse_cmp = (a: MutPtr<Malloc>, src: StringView, pos: i32) PExpr {
    a.cmp_rest(src, a.parse_bor(src, pos))
}
cmp_rest = (a: MutPtr<Malloc>, src: StringView, lhs: PExpr) PExpr {
    sc = src.scan(lhs.next)
    src.is_cmp(sc.tok).then({ a.cmp_more(src, lhs, sc) }, { lhs })
}
cmp_more = (a: MutPtr<Malloc>, src: StringView, lhs: PExpr, sc: Scan) PExpr {
    pdepth_enter()
    r = pdepth_over().match ({
        true  => lhs,
        false => {
            rhs = a.parse_bor(src, sc.next)
            a.cmp_rest(src, PExpr(
                expr: a.enode(bin_at(src.cmp_op_str(sc.tok), lhs.expr, rhs.expr, sc.tok.start)),
                next: rhs.next,
            ))
        },
    })
    pdepth_exit()
    r
}
// Logic: && binds tighter than ||, both looser than comparison.
is_and = (src: StringView, t: Token) bool {
    t.kind.match ({
        .Sym => t.len == 2 && src.at(t.start) == '&',
        _    => false,
    })
}
is_or = (src: StringView, t: Token) bool {
    t.kind.match ({
        .Sym => t.len == 2 && src.at(t.start) == '|',
        _    => false,
    })
}
parse_and = (a: MutPtr<Malloc>, src: StringView, pos: i32) PExpr {
    a.and_rest(src, a.parse_cmp(src, pos))
}
and_rest = (a: MutPtr<Malloc>, src: StringView, lhs: PExpr) PExpr {
    sc = src.scan(lhs.next)
    src.is_and(sc.tok).then({ a.and_more(src, lhs, sc) }, { lhs })
}
and_more = (a: MutPtr<Malloc>, src: StringView, lhs: PExpr, sc: Scan) PExpr {
    pdepth_enter()
    r = pdepth_over().match ({
        true  => lhs,
        false => {
            rhs = a.parse_cmp(src, sc.next)
            a.and_rest(src, PExpr(
                expr: a.enode(bin_at("&&", lhs.expr, rhs.expr, sc.tok.start)),
                next: rhs.next,
            ))
        },
    })
    pdepth_exit()
    r
}
parse_or* = (a: MutPtr<Malloc>, src: StringView, pos: i32) PExpr {
    a.or_rest(src, a.parse_and(src, pos))
}
or_rest = (a: MutPtr<Malloc>, src: StringView, lhs: PExpr) PExpr {
    sc = src.scan(lhs.next)
    src.is_or(sc.tok).then({ a.or_more(src, lhs, sc) }, { lhs })
}
or_more = (a: MutPtr<Malloc>, src: StringView, lhs: PExpr, sc: Scan) PExpr {
    pdepth_enter()
    r = pdepth_over().match ({
        true  => lhs,
        false => {
            rhs = a.parse_and(src, sc.next)
            a.or_rest(src, PExpr(
                expr: a.enode(bin_at("||", lhs.expr, rhs.expr, sc.tok.start)),
                next: rhs.next,
            ))
        },
    })
    pdepth_exit()
    r
}
// Zen has NO ternary `c ? t : e` — every conditional is a visible postfix method on a value
// (`.match` / two-arm `.then({ a }, { b })` / `.loop`), never punctuation. The ternary layer that
// briefly sat here was removed on purpose; a `?` anywhere in source is rejected by the permanent
// error[no-ternary] preflight (compiler.validate.core), the same law as error[no-if].
