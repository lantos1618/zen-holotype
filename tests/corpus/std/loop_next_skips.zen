// tests/corpus/std/loop_next_skips.zen
// h.next() is continue: it leaves THIS pass, not the loop. the
// print after it must be skipped exactly once, and the loop must
// still finish the remaining passes

main = (env: Env) Res<i32, AllocError> {
    Range(0, 5).loop((h, value) {
        (value == 2).then(() { h.next() });
        println("{}", value);
    })
    println("after");
    Ok(0);
}
