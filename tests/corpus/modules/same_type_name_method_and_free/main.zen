// DESIGN.md: "two modules may define the same top-level name without
// colliding". `same_name_overload` already covers two modules declaring
// the same FREE FUNCTION on two different types. This covers the shape
// that actually broke: two modules declaring the same TYPE, each with its
// own `render` -- one a free function, one a method.
//
// Member resolution that answers on the NAME rather than on the receiver
// picked alpha's `render` for a beta `Diag`, and it was the C compiler
// and not the Zen one that said so:
//
//   error: too many arguments to function '..gen_diag4Diag6render'
//   note:  expected '..3gen8gen_diag4Diag' but argument is of type
//          '..4sema9sema_diag4Diag'
//
// The old workaround renamed one declaration. This keeps the unrenamed
// shape under the corpus gate.
Diag, render = alpha.alpha
shout = gamma.gamma

main = (env: Env) Res<i32, AllocError> {
    a = Diag(code: 5);
    println("{}", render(a, 1));
    println("{}", a.render(1));
    println("{}", shout(7));
    Ok(0);
}
