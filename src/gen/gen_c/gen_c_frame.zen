// src/gen/gen_c/gen_c_frame.zen
// The rows one FRAME is made of.
// `gen_c_state.zen` holds the backend; these are the five kinds of row
// its per-function stacks are made of, kept here because they change
// together. A frame is what the backend knows while inside a body:
// bound names, written closures, open loops, open blocks, and what each
// block must destroy on the way out. All five are forgotten between
// functions; nothing else in `CBackend` is.
// The queues are NOT a frame and stay with the backend: `MethodRef` is
// a worklist entry that outlives every frame — the identity of a
// function still to be lowered — so it is not one of these.

str = std.text
Vec = std.collections
TyId = sema.sema_ty
Ctx = sema.sema_check
Inst = sema.sema_inst
Lambda = std.ast

// One binding in scope, and the number that makes its C name unique
// inside its function.
LocalSlot* = {
    name*: str,
    index*: usize,
    ty*: TyId,

    // The C name is a POINTER to the value rather than the value.
    // "`::` means the method writes the receiver's OWN BYTES", so a
    // `::` parameter is passed by address and every read of it goes
    // through a dereference. A `::=` LOCAL is not by reference: it is
    // the frame's own storage and there is nothing to alias.
    by_ref*: bool,

    // Which loop this name is the handle of, 1-based, or 0 for an
    // ordinary binding. `(h, value) { .. }` binds `h` to a
    // `LoopHandle` — not a value, no C storage: it's the two labels of
    // the loop it came from, so the binding carries the loop's depth
    // and `h.break(v)` reads the frame back out. Depth, not a pointer,
    // because a body inlined inside another has both loops in scope
    // and the inner one shadows.
    handle*: usize,

    // Which closure this name is, 1-based, or 0 for an ordinary
    // binding. A lambda handed to a function-typed parameter has no C
    // storage either: "a body is a non-escaping stack closure, inlined
    // at the call site" — so the binding carries an index into the
    // backend's closure table, and `f(x)` inlines the lambda rather
    // than calling through a pointer.
    closure*: usize,

    is_closure* = (self: @Self) bool { self.closure > 0 }

    is_handle* = (self: @Self) bool { self.handle > 0 }

    // A value row, rather than a handle or closure row. Whether its type
    // occupies bytes is a separate question (`has_storage` owns unit).
    is_value* = (self: @Self) bool {
        (self.is_handle() == false) && (self.is_closure() == false)
    }
}

// A lambda bound to a function-typed parameter, and everything the
// inliner needs to put its body back where it was written.
// The frame is the half that is easy to get wrong: a closure's free
// names mean what they meant WHERE IT WAS WRITTEN, and inlining puts
// the body inside the callee's frame — where `find`'s own
// `range.loop((h, value) { .. })` would otherwise silently capture a
// caller's `h` with a different value, rather than erroring. So `home`
// and `check_home` are the two scope stacks' depths when the lambda
// was written, and the inliner rewinds both.
// `ctx` is the CALLER's, which is what makes a `.try()` inside a lambda
// body return from the real function it was written in, not the callee
// it was inlined into.
Closure* = {
    lam*: Lambda,
    // the closure's declared parameter types, from the signature it was
    // handed to: "a closure passed to a function whose signature is
    // already known infers its parameter types from that signature"
    ptys*: Vec<TyId>,
    ret*: TyId,
    home*: usize,
    check_home*: usize,
    // Where the writing function's own frame begins — NOT `home`:
    // `home` is where the lambda was written, this is where the BODY it
    // was written in started. The difference (every binding the writing
    // function had made by then) decides whether `x = ..` inside the
    // lambda declares an `x` or stores into the one already there.
    floor*: usize,
    inst*: Inst,
    ctx*: Ctx,
}

// The two labels and the result of one loop being lowered.
// `h.break(v)` and `h.next()` are `goto`s and not C's `break` and
// `continue`: an inlined body sits inside whatever the lowering of a
// `.match` produced, and a C `break` there would leave that construct
// rather than the loop. A label is unambiguous wherever it is written.
LoopFrame* = {
    brk*: usize,        // the label a `break` jumps to
    cnt*: usize,        // the label the next pass starts at
    result*: str,       // the C name the loop's value lands in
    has_result*: bool,  // ..when it has one; a discarded loop has none
    ty*: TyId,          // the `Res<T>` that value is

    // How many blocks were open when the loop was. A `goto` jumps over
    // closing braces, so the cleanup those braces stood for has to be
    // written before the jump — `h.break()`/`h.next()` unwind every
    // block from the innermost out to this depth. Without it, the drops
    // simply never run, the one failure shape a backend may not have.
    depth*: usize,
}

// One binding a block must destroy when it leaves.
// The C name is REBUILT from these two rather than stored: a `str`
// field would own its bytes, and `sym_local` already turns the pair
// back into the same name `declare_local` wrote.
// `live` is the number of the `int` saying whether this binding still
// owns its value, or 0 when nothing can move it. "The compiler calls
// drop exactly once" isn't a straight-line fact — a value may be moved
// on one path and not another — so a `consume`d binding carries a flag,
// cleared at the move and tested at every exit. One `int` on the
// frame; getting it wrong statically costs a double free.
DropEntry* = {
    name*: str,
    index*: usize,
    ty*: TyId,
    live*: usize,
}

// One emitted C block, while it is open.
// This stack follows emitted braces rather than `locals`, which the
// inliner rewinds to the frame a closure was written in — a `.try()`
// inside an inlined body still has to unwind the block it is
// physically standing in.
BlockFrame* = {
    mark*: usize,   // where this block's drops start in `drops`
    rec*: usize,    // the number of its `zg_scope` record, or 0 for none
}
