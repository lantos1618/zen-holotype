// identifiers: letters, digits after the first byte, and underscores.
Error = AllocError | IoError

add_i32 = (a: i32, b: i32) i32 { a + b }

main = (env: Env) Res<i32, Error> {
    x1: i32 = 1;
    long_name_with_many_words: i32 = 2;
    UPPER: i32 = 3;
    mixedCase: i32 = 4;
    n0123456789: i32 = 5;
    a_b_c_d: i32 = 6;
    println("{}", add_i32(x1, long_name_with_many_words));
    println("{}", UPPER + mixedCase + n0123456789 + a_b_c_d);
    Ok(0);
}
