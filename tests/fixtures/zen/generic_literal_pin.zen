{ println } = std.text.fmt
sz<T> = (x: T) i64 { sizeof(T) }
Box<T>: {
    v: T,
    pick = (b: Box<T>, k: T) i64 { sz(k) }
}
main = () i32 {
    x: i64 := 5
    b := Box<i64>(v: x)
    println(b.pick(2))    // expect 8 (T pinned i64 by receiver); bug -> 4
    println(b.pick(x))    // expect 8
    0
}
