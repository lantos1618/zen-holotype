// src/sema/sema.zen
// Semantic analysis: the middle of the compiler.
//
// This file is the module's public surface and nothing else — a folder
// root is a file of starred re-exports, which is what makes a folder
// work. A name absent from this list is module-private on purpose.
//
// THE SHAPE, in four sentences, so nobody has to read five files to
// start:
//
//   - Sema is MEMOIZED QUERIES, not passes. `alloc.Checker(tree)` builds
//     the engine; `type_of(id, ctx)` and `type_from_ast(id, ctx)` are
//     the two that answer about a node, and both cache on the node's id.
//     That is what `ast_id.zen` made ids `Eq + Hash` for.
//   - A TYPE IS AN INTERNED ID. `TyId` compares by equality because the
//     store canonicalises: `A | B` and `B | A` are one id, and that is
//     what makes an error set a set rather than a tree walk.
//   - A DIAGNOSTIC IS A VALUE. Nothing raises. The only `Err` anywhere
//     in this folder is `AllocError`, so a program full of mistakes
//     still analyses and yields every diagnostic it owes.
//   - NAMES RESOLVE THROUGH THE MODULE GRAPH, and `*` gates every hop.
//     Re-export is an import whose bindings are starred, so following an
//     import and filtering by `exported` is the whole of the export
//     rule — there is no second mechanism.
//
//   - INSTANTIATION SUBSTITUTES. A call to `<T>(x: T) T` answers the
//     argument's type, and a member reached through `Vec<u8>` answers
//     about `u8`. `sema_inst.zen` is the substitution and says why the
//     expression memo did NOT have to be re-keyed to carry one: a
//     generic body is still checked exactly once, generically, and what
//     an instantiation changes is the answer at a CALL SITE — which
//     `ExprId` already separates.
//
//   - INSTANTIATION TERMINATES, and `sema_depth.zen` is why. A
//     monomorphising compiler answers one instantiation at a time and
//     cannot notice that the set is infinite, so the chain is walked
//     once the program is checked and bounded at a depth. The blame is
//     the interesting half: it lands on the call that WIDENS its type
//     argument, never on whichever frame hit the ceiling.
//
//   - A STRUCT HAS A SIZE, and `sema_layout.zen` is the walk that says
//     so. It is the folder's second declaration walk and not a query,
//     because nobody asks a node this: a struct nothing mentions still
//     has to have a size. `Ptr<Node>` terminates the walk and `Node`
//     does not, which is the whole of the rule.
//
// AND ONE THING THAT IS DELIBERATELY NOT INFERRED: a type parameter
// reachable only through a LAMBDA argument. "A closure passed to a
// function whose signature is already known infers its parameter types
// FROM that signature", so the arrow points the other way, and `loop`,
// `then` and `find` are instantiated at nothing here. The backend
// refuses them by name rather than guessing.

// how a declaration and a member are named, so a memo can key on one
DeclId*, MemberId*, ImplId*, owner*, member_at* = sema.sema_id

// what a type parameter BECOMES, and what a call instantiated it to
Inst*, InstEdge*, subst*, subst_list*    = sema.sema_inst
has_var*                                 = sema.sema_inst
inst_of_named*, unify*, unify_list*      = sema.sema_inst
tparam_vars*, owner_of*, zip*            = sema.sema_inst

// what sema computes: the interned type language
TyId*, Ty*, Types*                       = sema.sema_ty
Prim*, TyNamed*, TyFn*, TyUnion*, TyVar* = sema.sema_ty
ResForm*, TyRes*, key_before*            = sema.sema_ty

// what sema says when a program means nothing
SemaFault*, Diag*, message*, render*     = sema.sema_diag
NameFault*, TypeFault*, PairFault*       = sema.sema_diag
write_pos*, write_usize*                 = sema.sema_diag

// what a name means, and who is allowed to ask
DefKind*, Def*, ImportBinding*           = sema.sema_def
ModuleTable*, World*, dotted*, decl_at*  = sema.sema_def
PRELUDE*, last_segment*                  = sema.sema_def

// THE ENGINE: what it holds, and what it agrees to
Checker*, Ctx*, Binding*                 = sema.sema_check
is_prim*, is_integer*, is_float*         = sema.sema_check

// THE TWO QUERIES
type_from_ast*, type_of*, block_type*    = sema.sema_type

// what a value of a type can BE, and what a `.match` over it means
Case*, cases_of*, case_payload*          = sema.sema_case
PatKind*, Pat*, Pats*, PatMatrix*        = sema.sema_match
match_type*, useful*, is_case*           = sema.sema_match
join*                                    = sema.sema_join

// what a dot reaches
Found*, Base*, access_type*, members_of* = sema.sema_member
computed_member*                         = sema.sema_member

// what an IMPL supplies through that dot
impl_members*, bound_members*            = sema.sema_supply
bound_member_type*, impl_bound_type*     = sema.sema_supply

// what a bound promises, and what an impl owes it
check_impl*, satisfies_bound*, required* = sema.sema_bound

// which declaration a call means
Cand*, TBound*, Actual*                  = sema.sema_call
call_type*, check_overloads*             = sema.sema_call
same_signature*, swallows*               = sema.sema_call
cands_of*, matches*, travelled_cands*    = sema.sema_cand

// a trap the compiler can prove will fire
check_binary*, const_int*, fits*         = sema.sema_trap

// THE WALK: the rules nobody would think to ask a node about
check_all*, check_module*, check_function* = sema.sema_decl
check_layout*                            = sema.sema_layout

// who owns a value
check_own*, Own*, OwnVar*, Place*        = sema.sema_own
is_drop_type*, find_var*, path_root*     = sema.sema_own
place_type*, refuse*, var_mutable*       = sema.sema_own

// who may write through a name
check_self_writes*, check_receiver*      = sema.sema_recv
receiver_is_mutable*                     = sema.sema_recv

// a block, as a value, that may not leave its block
check_scope_returned*, check_scope_stored* = sema.sema_scope

// why the instantiation set is finite, and who to blame when it is not
check_depth*                             = sema.sema_depth
