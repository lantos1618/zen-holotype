// A WRONG PICK THAT COMPILES. Every other overload test in this tree
// catches the backend calling the wrong body only because `cc` happens
// to see the difference — two `toString`s that disagree about their
// return type, a `grow` handed one argument too many. That makes the
// gates a check on the C compiler's patience rather than on resolution:
// invert the tie-break and the tree still self-hosts.
//
// So these two differ in the ONE way C cannot notice. Same name, same
// arity, same return type, and parameter types C converts between
// silently — so picking the other body links, runs, and prints a
// different number. "Resolution is on declared parameter types AND
// arity" (DESIGN.md, Overloading) is what says which, and this test is
// what makes disobeying it visible.

Box = {
    w: i32,
    of = (self: @Self, k: i32) i32 { self.w + k }
    of = (self: @Self, k: i64) i32 { self.w * 100 }
}

main = (env: Env) Res<i32, AllocError> {
    b          = Box(w: 3);
    small: i32 = 10;
    big: i64   = 10;
    println("{}", b.of(small));
    println("{}", b.of(big));
    Ok(0);
}
