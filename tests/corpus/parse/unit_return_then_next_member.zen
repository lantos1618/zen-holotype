// `()` in RETURN position, with the next member on the very next line.
//
// `paren_type` reads a `(` as a function type's parameter list whenever
// a type could begin after the matching `)`, and the token after the
// `()` of a signature-only member is the NEXT MEMBER'S NAME — which can
// begin a type. So `next = (self: @Self) ()` swallowed `stop` as its
// return type and the body then wanted a member name at the `*`.
//
// src/std/core/loop/loop_handle.zen, src/std/mem/mem_ptr.zen and
// src/std/mem/mem_alloc.zen are all written this way, so the
// self-hosted parser could not read its own standard library. No
// corpus program spelled two adjacent unit-returning signatures, which
// is why nothing caught it.
//
// The pair below is the whole test: remove either member and it parses.

Handle = {
    next* = (self: @Self) ()
    stop* = (self: @Self) ()
}

// and the reading that must SURVIVE the fix: `() T` really is a
// function type from nothing to T, and a field written with one must
// still read as one rather than collapsing to unit.
Table = {
    tick*: () i32,
    size*: usize,
}

main = (env: Env) Res<i32, ArgError> {
    println("{}", 7);
    Ok(0);
}
