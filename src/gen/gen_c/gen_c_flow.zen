// src/gen/gen_c/gen_c_flow.zen
// Lowers exhaustive `.match` values as statement-level `if` chains.
// Patterns are not always C constants, so `switch` is insufficient; a
// final `zg_unreachable` prevents an uninitialised fallthrough if sema's
// exhaustiveness invariant is ever broken.

Expr, Match, Arm, Pattern, PatternId = std.ast
Literal, Decl, Enum, Variant = std.ast
Destructure, QualifiedName = std.ast
AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId, TyNamed, TyRes = sema.sema_ty
decl_at = sema.sema_def
Ctx = sema.sema_check
Inst = sema.sema_inst
last_segment = sema.sema_match
write_usize = sema.sema_diag
member_of = sema.sema_union
sym_local, sym_member, sym_variant = gen.gen_name
sym_union_member = gen.gen_name
RES_PATH, is_failure = gen.gen_name
GenFault = gen.gen_diag
CBackend = gen.gen_c.gen_c_state
enter_struct_tparams, leave_tparams = gen.gen_c.gen_c_mono
declarator, is_unit, variant_type, decl_ctx = gen.gen_c.gen_c_type
decl_inst = gen.gen_c.gen_c_type
write_qname = gen.gen_c.gen_c_layout
Dest, deliver = gen.gen_c.gen_c_stmt
res_type_of, decoded_len = gen.gen_c.gen_c_expr
is_str = gen.gen_c.gen_c_read
write_position = gen.gen_c.gen_c_op

// match

lower_match* = (
    be   :: CBackend,
    node : Expr,
    m    : Match,
    ctx  : Ctx,
    ty   : TyId,
    dst  : Dest
) Res<(), AllocError> {
    st = be.res_type_of(m.scrutinee, ctx).try();
    scrut ::= be.fresh_name("s").try();
    be.declare_temp(st, scrut.view()).try();
    be.deliver(m.scrutinee, ctx, st, Dest.Into(scrut.view())).try();
    // Each arm's pattern bindings live only while the arm's body is
    // lowered: the C declarations sit inside the branch's braces, so the
    // scope must not outlive them either — or a binder shadowing an
    // outer local keeps its renamed slot on top of the stack and every
    // later use of the name reads a variable declared in a closed block.
    m.arms.loop((h, i, arm) {
        lmark = be.mark();
        be.open_arm(arm, i, st, scrut.view(), ctx).try();
        be.deliver(arm.body, ctx, ty, dst).try();
        be.release(lmark).try();
    });
    be.close_arms(node, m).try();
    Ok(());
}

declare_temp* = (be :: CBackend, ty: TyId, name: str) Res<(), AllocError> {
    decl ::= be.alloc.String().try();
    be.declarator(ty, name, decl).try();
    be.fmt("{};\n", decl.view())
}

temp* = (be :: CBackend, ty: TyId, stem: str) Res<String, AllocError> {
    name ::= be.fresh_name(stem).try();
    be.declare_temp(ty, name.view()).try();
    Ok(name)
}

init_temp* = (be :: CBackend, ty: TyId, stem: str, value: str)
             Res<String, AllocError> {
    name = be.temp(ty, stem).try();
    be.set_line(name.view(), value).try();
    Ok(name)
}

// `if (..) {` for the first arm, `} else if (..) {` for the rest. The
// bindings a pattern introduces are declared INSIDE the branch, which
// is what makes `Ok(n)` legal in one arm and unknown in the next.
open_arm = (
    be    :: CBackend,
    arm   : Arm,
    i     : usize,
    st    : TyId,
    scrut : str,
    ctx   : Ctx
) Res<(), AllocError> {
    cond ::= be.alloc.String().try();
    be.arm_cond(arm.pattern, st, scrut, cond).try();
    (i > 0).match({
        true  => be.chain_arm(cond.view()),
        false => be.first_arm(cond.view()),
    }).try();
    be.arm_bind(arm.pattern, st, scrut, ctx).try();
    Ok(());
}

first_arm = (be :: CBackend, cond: str) Res<(), AllocError> {
    be.fmt("if ({cond}) {\n").try();
    be.indent();
    Ok(());
}

chain_arm = (be :: CBackend, cond: str) Res<(), AllocError> {
    be.dedent();
    be.fmt("} else if ({cond}) {\n").try();
    be.indent();
    Ok(());
}

// The chain's `else`: a value that matched no arm traps at the `match`
// token rather than leaving the destination uninitialised.
close_arms = (be :: CBackend, node: Expr, m: Match) Res<(), AllocError> {
    (m.arms.len == 0).match({
        true  => be.write_unreachable(node, m),
        false => be.close_chain(node, m),
    })
}

close_chain = (be :: CBackend, node: Expr, m: Match) Res<(), AllocError> {
    be.dedent();
    be.writeln("} else {").try();
    be.indent();
    be.write_unreachable(node, m).try();
    be.dedent();
    be.writeln("}").try();
    Ok(());
}

write_unreachable = (be :: CBackend, node: Expr, m: Match)
                    Res<(), AllocError> {
    pos ::= be.alloc.String().try();
    be.write_position(node.span.file, m.name_span, pos).try();
    be.fmt("zg_unreachable({});\n", pos.view()).try();
    Ok(());
}

// patterns

arm_cond = (
    be    :: CBackend,
    pid   : PatternId,
    st    : TyId,
    scrut : str,
    out   :: String
) Res<(), AllocError> {
    pat = be.tree.pattern_at(pid);
    pat.kind.match({
        Wild           => out.add_bytes("1"),
        Literal(l)     => be.literal_cond(pat, l, st, scrut, out),
        Name(p)        => be.name_cond(p.name, st, scrut, out),
        Destructure(d) => be.destructure_cond(d, st, scrut, out),
    }).try();
    Ok(());
}

// A payload pattern that is a literal narrows the arm; testing only the
// tag would be the worst kind of wrong: `Ok('\n')` and `Ok('\\')` would
// compile to the same (valid) condition, the first swallowing every
// `Ok`. So the tag and the payload's own test (`literal_cond`, one
// level down) are written together.
// AGAINST A SET there is one reading before that: when the ctor's name
// is a MEMBER whose own enum declares what the binder spells, the arm
// is two tag tests — the set's for `Member`, then the member struct's
// for the leaf. Sema normalised this arm to `Member(wild)`; this
// function is why the spelling still narrows anyway (issue #735).
destructure_cond = (
    be    :: CBackend,
    d     : Destructure,
    st    : TyId,
    scrut : str,
    out   :: String
) Res<(), AllocError> {
    member = last_segment(d.name);
    member_of(be.check, st, member).match({
        None  => be.plain_ctor_cond(d, st, scrut, out),
        Ok(t) => be.member_ctor_cond(d, t, st, scrut, out),
    })
}

// The ordinary reading: the ctor names a case of the scrutinee's own
// type. One tag test, then the payload's test one level down.
plain_ctor_cond = (
    be    :: CBackend,
    d     : Destructure,
    st    : TyId,
    scrut : str,
    out   :: String
) Res<(), AllocError> {
    be.tag_name(st, last_segment(d.name), scrut, out).try();
    be.payload_cond(d, st, scrut, out)
}

// `Member(leaf)` against a set: the set's tag test, then — where the
// payload would be read — the member struct's own tag test.
// `Member(pe)` lands here too and its binder arm adds no test of its
// own, so the two spellings lower alike.
member_ctor_cond = (
    be    :: CBackend,
    d     : Destructure,
    mty   : TyId,
    st    : TyId,
    scrut : str,
    out   :: String
) Res<(), AllocError> {
    member = last_segment(d.name);
    be.tag_name(st, member, scrut, out).try();
    place ::= be.alloc.String().try();
    be.set_member_place(mty, scrut, place).try();
    be.leaf_cond(d.binder, mty, place.view(), out)
}

// The inner pattern's test against the member's type. A name that is a
// case of it appends the member's tag test; anything else (`pe`, `_`)
// narrows nothing — the binding side decides what those mean.
leaf_cond = (
    be    :: CBackend,
    pid   : PatternId,
    mty   : TyId,
    place : str,
    out   :: String
) Res<(), AllocError> {
    pat     = be.tree.pattern_at(pid);
    narrows = pat.kind.match({
        Name(p) => be.is_variant(mty, last_segment(p.name)),
        _       => false,
    });
    narrows.match({
        false => Ok(()),
        true  => be.leaf_tag_cond(pat, mty, place, out),
    })
}

// The member's own tag test: `place.zg_tag == <member's enum>.<Leaf>`.
// The constant is spelled at the MEMBER's type — the same spelling
// `sym_variant` produces for a plain match on that member — so it is
// exactly what `write_enum_tags` emitted.
leaf_tag_cond = (
    be    :: CBackend,
    pat   : Pattern,
    mty   : TyId,
    place : str,
    out   :: String
) Res<(), AllocError> {
    qname ::= be.alloc.String().try();
    be.enum_path(mty, qname).try();
    tag ::= be.alloc.String().try();
    tag.sym_variant(qname.view(), leaf_of(pat)).try();
    out.fmt(" && ({place}.zg_tag == {})", tag.view())
}

// The payload's test is `arm_cond` again, one level down, against the
// payload's place and type. Depth is not a special form: `Left(Full(n))`
// is two tag tests for the same reason `Ok(3)` is a tag test and a
// comparison.

// What a narrowing inner name spells. Only a Name pattern reaches
// `leaf_cond` with `narrows` true, so the last segment IS the case.
leaf_of = (pat: Pattern) str {
    pat.kind.match({
        Name(p) => last_segment(p.name),
        _       => "",
    })
}
payload_cond = (
    be    :: CBackend,
    d     : Destructure,
    st    : TyId,
    scrut : str,
    out   :: String
) Res<(), AllocError> {
    be.payload_type(st, last_segment(d.name)).match({
        None  => be.bare_payload(d),
        Ok(t) => be.nested_cond(d, t, scrut, out),
    })
}

// A variant with no payload cannot have a literal one, and reaching
// `.zg_data` for it would be a union member nothing declared. The arm
// is refused rather than narrowed, which keeps the rule this file works
// by: lower it exactly, or report it.
bare_payload = (be :: CBackend, d: Destructure) Res<(), AllocError> {
    inner = be.tree.pattern_at(d.binder);
    inner.kind.match({
        Literal(_) => be.report_nested(inner),
        _          => Ok(()),
    })
}

nested_cond = (
    be    :: CBackend,
    d     : Destructure,
    t     : TyId,
    scrut : str,
    out   :: String
) Res<(), AllocError> {
    be.narrows(d.binder, t).match({
        false => Ok(()),
        true  => be.write_nested_cond(d, t, scrut, out),
    })
}

write_nested_cond = (
    be    :: CBackend,
    d     : Destructure,
    t     : TyId,
    scrut : str,
    out   :: String
) Res<(), AllocError> {
    place ::= be.alloc.String().try();
    be.payload_place(last_segment(d.name), scrut, place).try();
    out.add_bytes(" && ").try();
    be.arm_cond(d.binder, t, place.view(), out)
}

// Whether a pattern tests anything at all. A wildcard and a binder match
// every value, so joining their `1` onto the chain would say nothing;
// every other shape narrows. This is why `Ok(n)` stays a bare tag test.
narrows = (be :: CBackend, pid: PatternId, st: TyId) bool {
    be.tree.pattern_at(pid).kind.match({
        Wild    => false,
        Name(p) => be.is_variant(st, last_segment(p.name)),
        _       => true,
    })
}

// Where a variant's payload lives: the union member under the tag. Both
// the test and the binding reach it, and they must spell it the same.
payload_place = (
    be      :: CBackend,
    variant : str,
    scrut   : str,
    out     :: String
) Res<(), AllocError> {
    out.fmt("{scrut}.zg_data.").try();
    sym_member(out, variant)
}

// Where a MEMBER of a set lives: the set's payload struct, spelled by
// `sym_union_member` at the member's type — which for a declared member
// is simply its name, `zu_m10ParseError` under `Trouble`, the same field
// `payload_place` spells for a declared enum.
set_member_place = (
    be     :: CBackend,
    member : TyId,
    scrut  : str,
    out    :: String
) Res<(), AllocError> {
    out.add_bytes(scrut).try();
    out.add_bytes(".zg_data.").try();
    sym_union_member(out, be.types(), be.world(), member).try();
    Ok(())
}

report_nested = (be :: CBackend, inner: Pattern) Res<(), AllocError> {
    be.report(
        inner.span.file,
        inner.span,
        GenFault.Unsupported("a nested pattern")
    )
}

// `true =>` is the scrutinee, `false =>` is its negation, and an
// integer or character pattern is an equality. A string is the one
// pattern that is not a scalar, so it is not an operator.
literal_cond = (
    be    :: CBackend,
    pat   : Pattern,
    l     : Literal,
    st    : TyId,
    scrut : str,
    out   :: String
) Res<(), AllocError> {
    l.kind.match({
        Bool  => bool_cond(l.text, scrut, out),
        Int   => equality(scrut, l.text, out),
        Char  => equality(scrut, l.text, out),
        Float => equality(scrut, l.text, out),
        Str   => be.str_cond(pat, l, st, scrut, out),
    })
}

bool_cond = (text: str, scrut: str, out :: String) Res<(), AllocError> {
    text.eq("true").match({
        true  => out.add_bytes(scrut),
        false => negate(scrut, out),
    })
}

negate = (scrut: str, out :: String) Res<(), AllocError> {
    out.fmt("!{scrut}")
}

equality = (scrut: str, text: str, out :: String) Res<(), AllocError> {
    out.fmt("({scrut} == {text})")
}

// A `str` is a pointer and a length, so `==` would compare a STRUCT
// against a `char *` — invalid C, once emitted silently. Compared the
// way `str.impl(Eq)` does: LENGTH first, then bytes. Length first is
// correctness, not optimisation — comparing over the shorter length is
// the classic bug, and a prefix is not the whole.
// `.data` and `.len` are spelled the runtime floor's way, not the
// mangler's: `zg_str` is the floor's struct.
str_cond = (
    be    :: CBackend,
    pat   : Pattern,
    l     : Literal,
    st    : TyId,
    scrut : str,
    out   :: String
) Res<(), AllocError> {
    be.is_str(st).match({
        false => be.unsupported_cond(pat, out),
        true  => write_str_cond(l, scrut, out),
    })
}

write_str_cond = (l: Literal, scrut: str, out :: String)
                 Res<(), AllocError> {
    n = decoded_len(l.text);
    out.fmt("({scrut}.len == ").try();
    out.write_usize(n).try();
    out.add_bytes("u").try();
    (n > 0).match({
        true  => str_bytes_cond(l, scrut, n, out),
        false => Ok(()),
    }).try();
    out.add_bytes(")").try();
    Ok(());
}

// The empty string is its length and nothing more: a zero-length `str`
// may carry a null `data`, and that is not a pointer `memcmp` may be
// handed even for zero bytes.
str_bytes_cond = (l: Literal, scrut: str, n: usize, out :: String)
                 Res<(), AllocError> {
    out.fmt(" && memcmp({scrut}.data, {}, ", l.text).try();
    out.write_usize(n).try();
    out.add_bytes("u) == 0").try();
    Ok(());
}

// A string pattern on a scrutinee that is not a `str`. The arm is
// reported and its condition is never true, which keeps the chain total
// without inventing a comparison.
unsupported_cond = (be :: CBackend, pat: Pattern, out :: String)
                   Res<(), AllocError> {
    be.report(
        pat.span.file,
        pat.span,
        GenFault.Unsupported("a string pattern")
    ).try();
    out.add_bytes("0")
}

// A bare name is a nullary VARIANT when the scrutinee's type has one
// by that name, and a BINDER otherwise. "They are the same tokens, and
// which one it is depends on what is in scope" — here, on what the
// scrutinee is. Against a SET there is one more reading before the
// binder: a member or a leaf of a member, spelled flat — the same arm
// `member_ctor_cond` tests when it is written qualified.
name_cond = (
    be    :: CBackend,
    q     : QualifiedName,
    st    : TyId,
    scrut : str,
    out   :: String
) Res<(), AllocError> {
    be.is_variant(st, last_segment(q)).match({
        true  => be.tag_cond(q, st, scrut, out),
        false => be.set_name_cond(st, last_segment(q), scrut, out),
    })
}

set_name_cond = (
    be    :: CBackend,
    st    : TyId,
    text  : str,
    scrut : str,
    out   :: String
) Res<(), AllocError> {
    member_of(be.check, st, text).match({
        None    => out.add_bytes("1"),
        Ok(mty) => be.set_name_arm(st, mty, text, scrut, out),
    })
}

// The bare arm's test: the member's tag, then — only when the written
// name is a CASE of that member — the leaf's. A bare MEMBER name adds
// no second test, exactly as `Member(pe)` adds none one level in.
set_name_arm = (
    be    :: CBackend,
    st    : TyId,
    mty   : TyId,
    text  : str,
    scrut : str,
    out   :: String
) Res<(), AllocError> {
    leaf ::= be.leaf_name_of(mty).try();
    be.tag_name(st, leaf, scrut, out).try();
    place ::= be.alloc.String().try();
    be.set_member_place(mty, scrut, place).try();
    be.check.is_case(mty, text).try().match({
        false => Ok(()),
        true  => be.leaf_case_cond(mty, text, place.view(), out),
    })
}

// One leaf tag test from a bare CASE name — `leaf_tag_cond` without a
// pattern, because a flat spelling carries none.
leaf_case_cond = (
    be    :: CBackend,
    mty   : TyId,
    case  : str,
    place : str,
    out   :: String
) Res<(), AllocError> {
    qname ::= be.alloc.String().try();
    be.enum_path(mty, qname).try();
    tag ::= be.alloc.String().try();
    tag.sym_variant(qname.view(), case).try();
    out.fmt(" && ({place}.zg_tag == {})", tag.view())
}

// The bare name a MEMBER of a set is spelled by — the tag test's second
// half and `sema_match.member_leaf`'s ctor read the same declaration.
leaf_name_of = (be :: CBackend, mty: TyId) Res<str, AllocError> {
    qname ::= be.alloc.String().try();
    be.enum_path(mty, qname).try();
    Ok(last_segment_str(qname))
}

// THE LAST dot, not the first: the leaf name follows the final
// separator, as `sema_def.last_segment` spells it. A first-dot stop
// answered `core.io.IoError` for a two-module path.
last_segment_str = (qname: String) str {
    dot      ::= 0;
    i: usize ::= 0;
    loop(() { i < qname.len() }, (h) {
        (qname.view().index(i) == '.').match({
            true  => { dot = i + 1; },
            false => {},
        });
        i = i + 1;
    });
    qname.view().slice(dot, qname.len())
}

tag_cond = (
    be    :: CBackend,
    q     : QualifiedName,
    st    : TyId,
    scrut : str,
    out   :: String
) Res<(), AllocError> {
    be.tag_name(st, last_segment(q), scrut, out)
}

// The tag test from a bare case NAME — `Member.Leaf`'s outer half has a
// member name and no qualified pattern to spell it with.
tag_name = (
    be    :: CBackend,
    st    : TyId,
    name  : str,
    scrut : str,
    out   :: String
) Res<(), AllocError> {
    qname ::= be.alloc.String().try();
    be.enum_path(st, qname).try();
    tag ::= be.alloc.String().try();
    tag.sym_variant(qname.view(), name).try();
    out.fmt("({scrut}.zg_tag == {})", tag.view())
}

// The bindings a pattern introduces, declared inside the branch that
// tested it.
arm_bind = (be :: CBackend, pid: PatternId, st: TyId, scrut: str, ctx: Ctx)
           Res<(), AllocError> {
    be.tree.pattern_at(pid).kind.match({
        Name(p)        => bind_name(be, p.name, st, scrut, ctx),
        Destructure(d) => bind_payload(be, d, st, scrut, ctx),
        _              => Ok(()),
    })
}

bind_name = (
    be    :: CBackend,
    q     : QualifiedName,
    st    : TyId,
    scrut : str,
    ctx   : Ctx
) Res<(), AllocError> {
    name = last_segment(q);
    be.is_variant(st, name).match({
        true  => Ok(()),
        false => be.bind_local(name, st, scrut),
    })
}

// `Ok(n)` binds `n` to the payload under the variant's member;
// `Left(Full(n))` binds `n` one level further down, walked by
// `arm_bind` again — a nested binder the walk never reached is a name
// the arm body cannot resolve. A literal or wildcard payload binds
// nothing; `arm_cond` has already turned it into a test.
// `Member(..)` against a SET binds from the set's own payload struct:
// the place is spelled by `sym_union_member` at the set, and the inner
// pattern binds at the member's type. `Member(pe)` declares `pe` there,
// which is how the working two-level spelling has always bound.
bind_payload = (
    be    :: CBackend,
    d     : Destructure,
    st    : TyId,
    scrut : str,
    ctx   : Ctx
) Res<(), AllocError> {
    member = last_segment(d.name);
    member_of(be.check, st, member).match({
        None    => be.enum_bind_payload(d, st, scrut, ctx),
        Ok(mty) => be.set_bind_payload(d, st, mty, scrut, ctx),
    })
}

enum_bind_payload = (
    be    :: CBackend,
    d     : Destructure,
    st    : TyId,
    scrut : str,
    ctx   : Ctx
) Res<(), AllocError> {
    be.payload_type(st, last_segment(d.name)).match({
        None  => Ok(()),
        Ok(t) => be.bind_inner(d, t, scrut, ctx),
    })
}

set_bind_payload = (
    be    :: CBackend,
    d     : Destructure,
    st    : TyId,
    mty   : TyId,
    scrut : str,
    ctx   : Ctx
) Res<(), AllocError> {
    place ::= be.alloc.String().try();
    be.set_member_place(mty, scrut, place).try();
    be.arm_bind(d.binder, mty, place.view(), ctx)
}

bind_inner = (be :: CBackend, d: Destructure, t: TyId, scrut: str, ctx: Ctx)
             Res<(), AllocError> {
    place ::= be.alloc.String().try();
    be.payload_place(last_segment(d.name), scrut, place).try();
    be.arm_bind(d.binder, t, place.view(), ctx)
}

// A C declaration for a pattern binding, plus the same binding in
// sema's own scope so `type_of` answers for every use of it.
bind_local = (be :: CBackend, name: str, ty: TyId, init: str)
             Res<(), AllocError> {
    n = be.declare(name, ty, false).try();
    be.check.bind(name, ty, false, false).try();
    cname ::= be.alloc.String().try();
    sym_local(cname, name, n).try();
    decl ::= be.alloc.String().try();
    be.declarator(ty, cname.view(), decl).try();
    be.fmt("{} = {init};\n", decl.view())
}

// what an enum's variants are
// Two shapes and one question. `Res` carries no declaration — it is
// structural in sema's type language — so its variants are read off
// its form; everything else reads them off the declaration.

is_variant* = (be :: CBackend, st: TyId, name: str) bool {
    be.check.types.at(st).match({
        Res(r)   => res_has(r, name),
        Named(n) => be.enum_has(n, name),
        _        => false,
    })
}

res_has = (r: TyRes, name: str) bool {
    name.eq("Ok") || failure_name(r, name)
}

failure_name = (r: TyRes, name: str) bool {
    is_failure(r.form).match({
        true  => name.eq("Err"),
        false => name.eq("None"),
    })
}

enum_has = (be :: CBackend, n: TyNamed, name: str) bool {
    decl_at(be.tree, n.decl).match({
        None  => false,
        Ok(d) => decl_has(d, name),
    })
}

decl_has = (d: Decl, name: str) bool {
    d.kind.match({
        Enum(e) => variants_have(e.variants, name),
        _       => false,
    })
}

variants_have = (variants: Vec<Variant>, name: str) bool {
    Range(0, variants.len).find((i) {
        variants.get(i).match({
            Ok(v) => v.name.text.eq(name),
            None  => false,
        })
    }).match({ Ok(_) => true, None => false })
}

// The path a tag constant is built from.
enum_path* = (be :: CBackend, st: TyId, out :: String) Res<(), AllocError> {
    be.check.types.at(st).match({
        Res(_)   => out.add_bytes(RES_PATH),
        Named(n) => be.write_qname(out, n),
        _        => Ok(()),
    })
}

// The type a variant's payload has, or nothing when it carries none.
payload_type* = (be :: CBackend, st: TyId, variant: str) Res<TyId> {
    be.check.types.at(st).match({
        Res(r)   => be.res_payload(r, variant),
        Named(n) => be.enum_payload(n, variant),
        _        => None,
    })
}

res_payload = (be :: CBackend, r: TyRes, variant: str) Res<TyId> {
    variant.eq("Ok").match({
        true  => be.non_unit(r.value),
        false => be.res_error_payload(r, variant),
    })
}

res_error_payload = (be :: CBackend, r: TyRes, variant: str) Res<TyId> {
    is_failure(r.form).match({
        true  => be.non_unit(r.error),
        false => None,
    })
}

non_unit = (be :: CBackend, id: TyId) Res<TyId> {
    be.is_unit(id).match({
        true  => None,
        false => Ok(id),
    })
}

enum_payload = (be :: CBackend, n: TyNamed, variant: str) Res<TyId> {
    decl_at(be.tree, n.decl).match({
        None  => None,
        Ok(d) => be.decl_payload(n, d, variant),
    })
}

decl_payload = (be :: CBackend, n: TyNamed, d: Decl, variant: str)
               Res<TyId> {
    d.kind.match({
        Enum(e) => variant_payload(be, n, e.variants, variant),
        _       => None,
    })
}

variant_payload = (
    be       :: CBackend,
    n        : TyNamed,
    variants : Vec<Variant>,
    variant  : str
) Res<TyId> {
    found ::= be.alloc.Vec<TyId>();
    be.collect_payload(n, variants, variant, found).match({
        Err(_) => None,
        Ok(_)  => be.first_payload(found),
    })
}

// A payload is read at the ENUM'S OWN ARGUMENTS, exactly as a struct
// field is: `Slot<T>.Left` carries a `T`, and matching on a `Slot<u8>`
// binds a `u8`.
collect_payload = (
    be       :: CBackend,
    n        : TyNamed,
    variants : Vec<Variant>,
    variant  : str,
    found    :: Vec<TyId>
) Res<(), AllocError> {
    ctx  = be.decl_ctx(n);
    inst = be.decl_inst(n).try();
    mark = be.enter_struct_tparams(n.decl).try();
    variants.loop((h, v) {
        be.keep_payload(n, v, variant, ctx, inst, found).try();
    });
    be.leave_tparams(mark).try();
    Ok(());
}

keep_payload = (
    be      :: CBackend,
    n       : TyNamed,
    v       : Variant,
    variant : str,
    ctx     : Ctx,
    inst    : Inst,
    found   :: Vec<TyId>
)
               Res<(), AllocError> {
    v.name.text.eq(variant).match({
        false => Ok(()),
        true  => be.add_payload_type(n, v, ctx, inst, found),
    })
}

add_payload_type = (
    be    :: CBackend,
    n     : TyNamed,
    v     : Variant,
    ctx   : Ctx,
    inst  : Inst,
    found :: Vec<TyId>
) Res<(), AllocError> {
    variant_type(be, n, v, ctx, inst).match({
        Ok(t) => found.add(t),
        None  => Ok(()),
    })
}

first_payload = (be :: CBackend, found: Vec<TyId>) Res<TyId> {
    found.get(0).match({
        None  => None,
        Ok(t) => be.non_unit(t),
    })
}

// Result construction belongs to expression flow, not to any capability.
// Floors choose a variant and payload; these helpers own its C shape.
write_assign_none* = (be :: CBackend, ret: TyId, dst: str)
                    Res<(), AllocError> {
    value ::= be.alloc.String().try();
    be.write_res_head(ret, "None", value).try();
    value.add_bytes(" })").try();
    be.set_line(dst, value.view())
}

write_assign_ok_unit* = (be :: CBackend, ret: TyId, dst: str)
                       Res<(), AllocError> {
    value ::= be.alloc.String().try();
    be.write_res_head(ret, "Ok", value).try();
    value.add_bytes(" })").try();
    be.set_line(dst, value.view())
}

write_assign_ok* = (be :: CBackend, ret: TyId, payload: str, dst: str)
                  Res<(), AllocError> {
    value ::= be.alloc.String().try();
    be.write_res_head(ret, "Ok", value).try();
    value.add_bytes(", .zg_data.").try();
    sym_member(value, "Ok").try();
    value.fmt(" = {payload} })").try();
    be.set_line(dst, value.view())
}

write_assign_err* = (be :: CBackend, ret: TyId, name: str, dst: str)
                   Res<(), AllocError> {
    value ::= be.alloc.String().try();
    be.write_res_head(ret, "Err", value).try();
    be.payload_type(ret, "Err").match({
        None    => Ok(()),
        Ok(ety) => be.write_err_payload(ety, name, value),
    }).try();
    value.add_bytes(" })").try();
    be.set_line(dst, value.view())
}

write_err_payload = (be :: CBackend, ety: TyId, name: str, out :: String)
                    Res<(), AllocError> {
    be.is_variant(ety, name).match({
        false => Ok(()),
        true  => be.write_err_variant(ety, name, out),
    })
}

write_err_variant = (be :: CBackend, ety: TyId, name: str, out :: String)
                    Res<(), AllocError> {
    path ::= be.alloc.String().try();
    be.enum_path(ety, path).try();
    out.add_bytes(", .zg_data.").try();
    out.sym_member("Err").try();
    out.add_bytes(" = ((").try();
    be.ctype(ety, out).try();
    out.add_bytes("){ .zg_tag = ").try();
    out.sym_variant(path.view(), name).try();
    out.add_bytes(" })").try();
    Ok(());
}

write_res_head = (be :: CBackend, ret: TyId, variant: str, out :: String)
                 Res<(), AllocError> {
    cty ::= be.alloc.String().try();
    be.ctype(ret, cty).try();
    out.fmt("(({}){ .zg_tag = ", cty.view()).try();
    out.sym_variant(RES_PATH, variant)
}

// Small C block transitions shared by capability floors.
open_rc_test* = (be :: CBackend, rc: str) Res<(), AllocError> {
    be.fmt("if ({rc} != 0) {\n").try();
    be.indent();
    Ok(())
}

open_null_test* = (be :: CBackend, raw: str) Res<(), AllocError> {
    be.fmt("if ({raw} == NULL) {\n").try();
    be.indent();
    Ok(())
}

close_else* = (be :: CBackend) Res<(), AllocError> {
    be.dedent();
    be.writeln("} else {").try();
    be.indent();
    Ok(())
}

close_brace* = (be :: CBackend) Res<(), AllocError> {
    be.dedent();
    be.writeln("}").try();
    Ok(())
}
