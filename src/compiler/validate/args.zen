// compiler.validate.args — argument, struct-field-init, and member/slice-literal checks.
{ ArmData, CallData, Decl, Expr, Field, FieldInit, Func, LoopData, MakeStructData, MethodCallData,
  Param, Stmt, Ty, VariantDef } = compiler.ast.ast_types
{ gstr_append, gstr_finish, gstr_push, gstr_string, subst_ty_in, tvoid } = compiler.genc
{ DeclIndex, Env, arm_env, enum_name, extend_env, is_lit_numeric, params_env } = compiler.check
{ Malloc } = std.mem.alloc
{ field_in, lam_stmt_body, slice_any, wr_root_name } = compiler.astops
{ at, is_alnum } = std.text.ascii
{ ends_with, is_empty } = std.text.str
{ String } = std.text.string
{ enum_variants } = compiler.validate.kinds
{ env_is_enum, env_is_gen_enum, env_is_gen_struct, env_is_struct, env_struct_fields, expr_pos,
  fit_err, is_enum_repr_field, is_ptr_ty, is_write_intrinsic, lit_slot_verdict, pos_or,
  tparam_shape_err, ty_carries_ptr, ty_mentions_tparam } = compiler.validate.util
{ KSCRATCHSEND, KSCRATCHSTATE } = compiler.validate.diag
{ AliasList, DeadList, consume_depth, dead_cons, dead_has, dead_kill, dead_nil, dead_remove,
  own_moved_var, owner_base, sd_call_pos, sm_call_pos, sm_mcall_pos } = compiler.validate.ownership
{ kv_at } = compiler.validate.core
{ expr_fold_children } = compiler.ast.expr_children
{ loop_at } = std.core.count
// A slice LITERAL may be element-wise coerced into an expected slice type while stored slice types
// remain invariant. This accepts `["a", "b"]` at a `[StringView]` call slot without allowing a
// named `[StringLiteral]` variable to flow to mutable `[StringView]` storage.
slicelit_slot_verdict = (env: Env, ar: Expr, pty: Ty) i32 {
    ar.match ({
        .SliceLit(sd) => pty.match ({
            .Slice(ep) => {
                errs ::= 0
                sd.items.loop_at((i, it) { errs = errs + env.sl_elem_fit(load(ep.pointee), it) })
                (errs == 0).then({ 0 }, { 1 })
            },
            _          => 0 - 1,
        }),
        _             => 0 - 1,
    })
}
// an argument check, given the callee's tparams: a slot typed by a tparam is shape-checked when it is a
// pointer (else skipped); a CONCRETE slot of a generic fn is still fully checked (so `gen2(x: T, b: Box)`
// rejects a non-Box second arg).
arg_err_at* = (env: Env, tps: [Param], params: [Param], i: i32, ar: Expr) i32 {
    (i < params.len).match ({
        true  => tps.ty_mentions_tparam(params[i].ty).match ({
            true  => env.tparam_shape_err(params[i].ty, ar),
            false => {
                sv = env.slicelit_slot_verdict(ar, params[i].ty)
                (sv >= 0).match ({
                    true  => sv,
                    false => {
                        lv = ar.addr().lit_slot_verdict(params[i].ty)
                        (lv >= 0).match ({
                            true  => lv,
                            false => env.fit_err(env.infer_expr(ar.addr()), params[i].ty),
                        })
                    },
                })
            },
        }),
        false => 0,
    })
}
// the trait (a struct whose FnT fields are the method signatures) that DECLARES method `m`; ""
// if none. Distinct from is_trait_method, which only sees methods some IMPL provides: with ZERO
// impls in the module a required trait method fell through to undefined-name, hiding the real
// story (the receiver type lacks an impl). Used only to pick the KIND and message of an already-
// rejected call — it never flips accept/reject.
fields_declare_method* = (fields: [Field], m: StringView) bool {
    found ::= false
    fields.loop_at((i, f) {
        found = (f.name == m).match ({
            true  => f.ty.match ({
                .FnT(fd) => true,
                _        => found,
            }),
            false => found,
        })
    })
    found
}
// Struct literals check known fields and value fits; imported/generic literals stay lenient.
no_fields* = () [Field] { slice(null_ptr(), 0) }
struct_fields* = (decls: [Decl], name: StringView) [Field] {
    found ::= no_fields()
    decls.loop_at((i, d) {
        found = d.match ({
            .DStruct(sd) => (sd.name == name).then({ sd.fields }, { found }),
            _            => found,
        })
    })
    found
}
has_field* = (fields: [Field], fname: StringView) bool {
    fields.slice_any((fl) { fl.name == fname })
}
field_fit_err = (env: Env, fields: [Field], fi: FieldInit) i32 {
    fty = fields.field_in(fi.name)
    sv = env.slicelit_slot_verdict(load(fi.value), fty)
    (sv >= 0).match ({
        true  => sv,
        false => {
            lv = fi.value.lit_slot_verdict(fty)    // a numeric literal must fit the field width
            (lv >= 0).then({ lv }, { env.fit_err(env.infer_expr(fi.value), fty) })
        },
    })
}
init_err = (env: Env, fields: [Field], fi: FieldInit) i32 {
    fields.has_field(fi.name).then({ env.field_fit_err(fields, fi) }, { 1 })
}    // unknown field -> 1
struct_init_errs = (env: Env, fields: [Field], inits: [FieldInit]) i32 {
    acc ::= 0
    inits.loop_at((i, fi) { acc = acc + env.init_err(fields, fi) })
    acc
}
// A generic-struct literal `Box<i32>(v: …)` binds each tparam to its explicit targ, so a field typed
// by a tparam (`v: T`) becomes CONCRETE (`v: i32`) and IS fit-checked — closing the hole where a wrong
// value (`Box<i32>(v: P(…))`) slipped past SEMA and broke at cc. A field whose type stays a tparam after
// substitution (no matching targ) remains lenient, deferred to monomorphization.
gen_field_fit_err = (env: Env, tps: [Param], targs: [Ty], fields: [Field], fi: FieldInit) i32 {
    fty = fields.field_in(fi.name)
    cty = (targs.len == tps.len).then({ env.a.subst_ty_in(tps, targs, fty) }, { fty })
    tps.ty_mentions_tparam(cty).match ({
        true  => 0,
        false => {
            sv = env.slicelit_slot_verdict(load(fi.value), cty)
            (sv >= 0).match ({
                true  => sv,
                false => {
                    lv = fi.value.lit_slot_verdict(cty)    // still a tparam -> lenient
                    // a numeric literal must fit the field width
                    (lv >= 0).then({ lv }, { env.fit_err(env.infer_expr(fi.value), cty) })
                },
            })
        },
    })
}    // a concrete field -> check the fit
gen_struct_init_errs = (
    env: Env,
    tps: [Param],
    targs: [Ty],
    fields: [Field],
    inits: [FieldInit],
) i32 {
    acc ::= 0
    inits.loop_at((i, fi) {
        acc = acc + fields.has_field(fi.name).match ({
            true  => env.gen_field_fit_err(tps, targs, fields, fi),
            false => 1,
        })
    })
    acc
}
inits_has = (inits: [FieldInit], name: StringView) bool {
    inits.slice_any((fi) { fi.name == name })
}    // is this field named in the literal?
// Would zero-filling a value of type `t` produce a NULL non-null `Ptr` — directly, or TRANSITIVELY
// through a nested struct's field or the tag-0 variant's payload of an enum? A struct zero-fills every
// field; an omitted enum reads tag 0 = its first variant, whose payload is zeroed. Structs cannot embed
// themselves by value (infinite size), but malformed residue could cycle, so `fuel` bounds the descent
// and exhausting it answers `false` (lenient — never a false reject). A direct non-null `Ptr` short-
// circuits before recursion, so a self-referential `Ptr<Node>` field terminates at the pointer.
ty_zerofills_null_ptr = (env: Env, t: Ty, fuel: i32) bool {
    t.is_nonnull_ptr_ty().match ({
        true  => true,
        false => (fuel <= 0).match ({
            true  => false,
            false => t.match ({
                .Named(n) => env.env_is_struct(n).match ({
                    true  => env
                        .env_struct_fields(n)
                        .slice_any((f) { env.ty_zerofills_null_ptr(f.ty, fuel - 1) }),
                    false => env.env_is_enum(n).match ({
                        true  => env.decls.enum_variants(n).tag0_zerofills_null_ptr(env, fuel - 1),
                        false => false,
                    }),
                }),
                _         => false,
            }),
        }),
    })
}    // an omitted enum field reads tag 0 = variants[0]; its payload is the zeroed slot we must vet
tag0_zerofills_null_ptr = (vs: [VariantDef], env: Env, fuel: i32) bool {
    (vs.len > 0).then({ env.ty_zerofills_null_ptr(vs[0].payload, fuel) }, { false })
}
// A NON-NULL pointer field (`Ptr<T>`/`MutPtr<T>`) left out of the literal would be default-zeroed to a
// null that the type promises can never happen → a deref segfault the checker currently misses. Require
// it — and likewise reject a field whose type only TRANSITIVELY reaches such a pointer (nested struct,
// enum tag-0 payload), since zero-filling it nulls that pointer just the same.
field_missing_nonnull_ptr = (fields: [Field], env: Env, inits: [FieldInit]) i32 {
    acc ::= 0
    fields.loop_at((i, fl) {
        acc = acc + (env.ty_zerofills_null_ptr(fl.ty, 64) && inits.inits_has(fl.name) == false).match ({
            true  => 1,
            false => 0,
        })
    })
    acc
}
// A repeated initializer for the same field (`Box(v: 5, v: 9)`) is almost certainly a mistake.
dup_init_errs = (inits: [FieldInit]) i32 {
    acc ::= 0
    inits.loop_at((i, fi) {
        earlier ::= false
        inits.loop_at((j, fj) {
            earlier = (j < i && fj.name == fi.name).then({ true }, { earlier })
        })
        acc = acc + earlier.then({ 1 }, { 0 })
    })
    acc
}
makestruct_err* = (env: Env, m: MakeStructData) i32 {
    (m.targs.len > 0).match ({
        true  => env.env_is_gen_struct(m.ty).match ({
            true  => {
                gf = env.env_gstruct(m.ty).fields
                env.gen_struct_init_errs(env.env_gstruct(m.ty).tparams, m.targs, gf, m.inits) + gf.field_missing_nonnull_ptr(env, m.inits) + m.inits.dup_init_errs()
            },
            false => 0,
        }),
        false => env.env_is_struct(m.ty).match ({
            true  => {
                sf = env.env_struct_fields(m.ty)
                env.struct_init_errs(sf, m.inits) + sf.field_missing_nonnull_ptr(env, m.inits) + m.inits.dup_init_errs()
            },
            false => 0,
        }),
    })
}    // a generic literal: check concrete fields
gen_base_of = (t: Ty) StringView {
    t.match ({
        .Generic(g) => g.name,    // unknown gen-struct (template residue) -> lenient
        // the BASE name of a generic-struct receiver (`Box` of `Box<i32>`), through a Ptr receiver.
        .Ptr(pd)    => load(pd.pointee).gen_base_of(),
        _           => "",
    })
}
// a primitive scalar has no fields, so `x.foo` on it is a hard error (C: "member in something not a struct").
is_scalar_prim = (t: Ty) bool {
    t.match ({
        .I32  => true,
        .I64  => true,
        .U8   => true,
        .F64  => true,
        .Bool => true,
        _     => false,
    })
}
// FIELDLESS receivers: scalars AND the string types (every `string_*` is `const char*`/`char*` in C,
// with NO members). `s.len` FIELD access on one ICEs in cc ("member in something not a struct or union");
// the accessor is a UFCS METHOD (`s.len()`, a `Call`), never a field. A slice `[T]` is `.Slice` (NOT here),
// so `slice.len` on its `{ptr,len}` struct still passes. Closes census #60 (sibling of #58).
is_fieldless_prim = (t: Ty) bool {
    t.match ({
        .StringView    => true,
        .StringCstr    => true,
        .StringLiteral => true,
        _              => t.is_scalar_prim(),
    })
}
// Field access checks known concrete struct receivers AND generic-struct instances (field names don't
// depend on the type args, so `Box<i32>.nope` is rejected the same as `Box.nope` would be). A KNOWN
// enum receiver — concrete (`DEnum`) or generic (`DGenEnum` like `Result<i32,IoError>`) — has no fields
// at all: you reach its variants via `.match`, so any `.field` on one is rejected (closes census #58/#41,
// where `r.len` on a Result passed `check` then ICE'd in cc with only a `.c` column).
member_err* = (env: Env, obj: Ptr<Expr>, field: StringView) i32 {
    obj.is_lit_numeric().match ({
        true  => 1,
        false => {
            rty = env.infer_expr(obj)
            sname = rty.enum_name()
            env.env_is_struct(sname).match ({
                true  => env.env_struct_fields(sname).has_field(field).then({ 0 }, { 1 }),
                false => {
                    base = rty.gen_base_of()
                    (is_empty(base) == false && env.env_is_gen_struct(base)).match ({
                        true  => env.env_gstruct(base).fields.has_field(field).then({ 0 }, { 1 }),
                        false => (env.env_is_enum(sname)
                            || is_empty(base) == false && env.env_is_gen_enum(base)).match ({
                            true  => field.is_enum_repr_field().then({ 0 }, { 1 }),
                            false => rty.is_fieldless_prim().then({ 1 }, { 0 }),
                        }),
                    })
                },
            })
        },
    })
}    // scalars and enums have no fields; other unknowns (residue) stay lenient
// every element of a slice literal must fit the element type (inferred from the first item). genc
// types the emitted C array by that first element, so a CATEGORY mismatch (a str in an int slice)
// would be silently coerced under -w — a miscompile. Numeric elements stay lenient (C widens them),
// and unknown/generic-residue elements defer (fit_err handles both).
sl_elem_fit* = (env: Env, ety: Ty, it: Expr) i32 {
    ity = env.infer_expr(it.addr())
    (ety.ty_rank() >= 0 && ity.ty_rank() >= 0).then({ 0 }, { env.fit_err(ity, ety) })
}
// ── STRUCT-FIELD / SLICE-ELEMENT CONSUME (re-census #63) ───────────────────────────────────────────
// #56 closed owner-PARAM moves but explicitly left the IDIOMATIC case open: moving an `Own<T>` into a
// struct-LITERAL field (`Box(o: o)`) or a slice element (`[o]`, `arr[i] = o`). A struct/slice copy does
// NOT bump the owner's refcount, so the field and the source name the ONE allocation: freeing through the
// field (`b.o.release_in(a)`) then using the source (`o.get()`) is a use-after-free, and the same owner
// into two Own fields (`Two(a: o, b: o)`) is a double-move. We count the field/element init as a CONSUME
// of the source binding, reusing the #56 kill machinery (dead_kill), so a later use of the source →
// error[ownership]. ZERO over-reject: only an `Own<T>` bare-Var moved into an `Own<T>`-TYPED field
// consumes — a BORROW field (`MutPtr<T>`/`Ptr<T>`, reached via `o.ptr()`, a Call not a Var), a value /
// scalar field, and a `.clone()` init (a Call) do NOT. Only CONCRETE struct literals are analyzable; a
// generic-struct literal has no concrete field types here, so it under-rejects (honest, safe).
// the owner moved by a struct-literal field init: the field's DECLARED type is `Own<T>` AND the init is a
// bare `Own<T>` Var. The field-type gate is exactly what keeps a borrow field (`p: MutPtr<T>`) legal.
struct_field_move_src* = (env: Env, fields: [Field], fi: FieldInit) StringView {
    (field_in(fields, fi.name).owner_base() == "Own").then({ env.own_moved_var(fi.value) }, { "" })
}
// kill every source owner moved into an Own field of a CONCRETE struct literal.
mkstruct_field_kills* = (
    a: MutPtr<Malloc>,
    env: Env,
    seen: Ptr<DeadList>,
    al: Ptr<AliasList>,
    s: MakeStructData,
) Ptr<DeadList> {
    out ::= seen
    env.env_is_struct(s.ty).then({
        fields = env.env_struct_fields(s.ty)
        s.inits.loop_at((i, fi) {
            nm = env.struct_field_move_src(fields, fi)
            (nm.is_empty() == false).then({
                out = a.dead_kill(out, al, nm)
            })
        })
    })
    out
}
// kill every source owner moved into a slice-literal element (`[o]`): a bare `Own<T>` item is moved into
// the slice's element slot exactly like an Own field. A borrowed `[o.ptr()]` item is a Call, not a Var.
slicelit_elem_kills* = (
    a: MutPtr<Malloc>,
    env: Env,
    seen: Ptr<DeadList>,
    al: Ptr<AliasList>,
    items: [Expr],
) Ptr<DeadList> {
    out ::= seen
    items.loop_at((i, it) {
        nm = env.own_moved_var(it.addr())
        (nm.is_empty() == false).then({
            out = a.dead_kill(out, al, nm)
        })
    })
    out
}
// the bare-Var name of arg `i` (else ""). We only track frees/escapes of SIMPLE LOCALS — a field free
// like `a.release(m.keys)` (vec/map grow constantly do this) is deliberately NOT tracked, so the
// stdlib does not over-reject. Field-level liveness is out of scope for v1.
arg_var_name* = (c: CallData, i: i32) StringView {
    (i < c.args.len).match ({
        true  => c.args[i].match ({
            .Var(v) => v.name,
            _       => "",
        }),
        false => "",
    })
}
// ── ADDR-OF-LOCAL ESCAPE ──────────────────────────────────────────────────────────────────────────
// Returning `x.addr()` where `x` is a stack local hands the caller a pointer into the dead frame. This
// is a SEPARATE pass from the scope-escape above: it cannot reuse that walker, because a general
// allocator's `a.acquire(n)` returns HEAP that outlives the call (returning it is fine) — only the
// ADDRESS OF A LOCAL dangles. It taints `<local>.addr()`, forwards it through every value-carrying
// expression shape, threads that taint across `let`/assignment ALIASES (`q = x.addr()` taints `q`, and
// naming `q`, `s.p` or `ps[0]` then launders the address back out), and flags it in return/trailing
// position. NOT tracked: heap-store aliasing, escape through a global.
ae_collect_arms = (a: MutPtr<Malloc>, seen: Ptr<DeadList>, arms: [ArmData]) Ptr<DeadList> {
    out ::= seen
    arms.loop_at((i, ar) { out = a.ae_collect_expr(out, ar.body) })
    out
}
ae_collect_expr = (a: MutPtr<Malloc>, seen: Ptr<DeadList>, e: Ptr<Expr>) Ptr<DeadList> {
    load(e).match ({
        .Match(m) => a.ae_collect_arms(seen, m.arms),
        .Block(b) => a.ae_collect(seen, b.stmts),
        .Loop(l)  => a.ae_collect(seen, l.body),
        .Cond(d)  => a.ae_collect_expr(a.ae_collect_expr(seen, d.t), d.e),
        // a lambda is INLINED at its call site, so its `let`s are storage in THIS frame; the rest of
        // the descent is structural, which is what the exhaustive child listing gives.
        _         => seen.expr_fold_children(e, (acc, ch) { a.ae_collect_expr(acc, ch) }, (acc, body) {
            a.ae_collect(acc, body)
        }),
    })
}
ae_collect_stmt = (a: MutPtr<Malloc>, seen: Ptr<DeadList>, st: Stmt) Ptr<DeadList> {
    st.match ({
        .Let(l)      => a.dead_cons(l.name, seen),
        .While(w)    => a.ae_collect(seen, w.body),
        .ExprStmt(e) => a.ae_collect_expr(seen, e),
        _            => seen,
    })
}
ae_collect = (a: MutPtr<Malloc>, seen: Ptr<DeadList>, body: [Stmt]) Ptr<DeadList> {
    out ::= seen
    body.loop_at((i, st) { out = a.ae_collect_stmt(out, st) })
    out
}
// the addr-of-local walk's context: the module (for the bounded interprocedural summaries) plus the two
// name sets it threads — `locals`, every `let` in the function (the storage that dies with the frame),
// and `tainted`, the subset whose VALUE derives from a `<local>.addr()` (so naming one, or a place
// rooted at one, hands the address out). `tainted` grows statement by statement; the rest is fixed.
// `outlives` is the third name set: locals proven to be a SECOND NAME for storage this frame does not
// own, so a write through one is a write the caller can still read (see ae_root_outlives).
AeCtx: {
    decls: [Decl],
    idx: DeclIndex,
    params: [Param],
    locals: Ptr<DeadList>,
    tainted: Ptr<DeadList>,
    outlives: Ptr<DeadList>,
    ptr_ret: bool,
}
ae_taint = (cx: AeCtx, tainted: Ptr<DeadList>) AeCtx {
    AeCtx(
        decls: cx.decls,
        idx: cx.idx,
        params: cx.params,
        locals: cx.locals,
        tainted: tainted,
        outlives: cx.outlives,
        ptr_ret: cx.ptr_ret,
    )
}
ae_outl = (cx: AeCtx, outlives: Ptr<DeadList>) AeCtx {
    AeCtx(
        decls: cx.decls,
        idx: cx.idx,
        params: cx.params,
        locals: cx.locals,
        tainted: cx.tainted,
        outlives: outlives,
        ptr_ret: cx.ptr_ret,
    )
}
// `<local>.addr()` — a UFCS `addr` call whose sole arg is a Var that is a collected stack local.
ae_is_addr_local = (locals: Ptr<DeadList>, e: Ptr<Expr>) bool {
    load(e).match ({
        .Call(c) => (c.fn == "addr" && c.args.len == 1).match ({
            true  => c.args[0].match ({
                .Var(v) => locals.dead_has(v.name),
                _       => false,
            }),
            false => false,
        }),
        _        => false,
    })
}
// SENDABILITY rule 3: a message may not carry a pointer into the sender's frame. `send(_, msg)` whose
// message escapes a local (`.addr()` of a local, directly or forwarded) → the offset of the call, else 0.
// the send-message escape (SENDABILITY rule 3) uses the NON-hopping escape check: a laundered send
// (`send(.Poke(launder(local.addr())))`) is the sendability pass's concern (kind `sendable`), so the
// call-following added for return-escape must NOT pre-empt it here — hop=false preserves that split.
ae_send_pos = (a: MutPtr<Malloc>, cx: AeCtx, e: Ptr<Expr>) i32 {
    load(e).match ({
        .Call(c) => (c.fn.sx_named("send", "__send")
            && c.args.len >= 2
            && a.ae_escapes(cx, c.args[1].addr(), false)).match ({
            true  => c.pos.pos_or(1),
            false => 0,
        }),
        _        => 0,
    })
}
// grow the taint set across ONE statement: a binding or store whose VALUE yields a pointer into this
// frame makes the destination local an alias of it. Monotone (never un-taints) — a later re-assignment
// to something safe does not retire the alias that was already handed out.
ae_taint_step = (a: MutPtr<Malloc>, cx: AeCtx, st: Stmt) Ptr<DeadList> {
    st.match ({
        .Let(l)      => a.ae_escapes(cx, l.value, true).match ({
            true  => a.dead_cons(l.name, cx.tainted),
            false => cx.tainted,
        }),
        .Assign(x)   => a.ae_taint_store(cx, x.target, x.value),
        .IndexSet(x) => a.ae_taint_store(cx, x.seq, x.value),
        .ExprStmt(e) => a.ae_taint_expr(cx, e),
        _            => cx.tainted,
    })
}
// A store into a local is not confined to the top level: `[1].loop((h, i, e) { acc = x.addr() })` taints
// `acc` for everything after the loop. The taint set only GROWS, so walking a body once is a sound
// over-approximation of running it any number of times, and the walk is otherwise pure structural
// descent — every statement list an expression carries gets the same threading as the top level.
ae_taint_stmts = (a: MutPtr<Malloc>, cx: AeCtx, body: [Stmt]) Ptr<DeadList> {
    cur ::= cx
    body.loop_at((i, st) { cur = cur.ae_taint(a.ae_taint_step(cur, st)) })
    cur.tainted
}
// a loop BINDS its element name, so iterating a sequence that carries a frame address makes the element
// carry it too (`[x.addr()].loop((h, i, e) { acc = e })`). The binding is dropped again on the way out
// (unless the name was already tainted outside), so the loop's private name cannot taint an unrelated
// later local that happens to share it.
ae_taint_loop = (a: MutPtr<Malloc>, cx: AeCtx, l: LoopData) Ptr<DeadList> {
    esc = a.ae_escapes(cx, l.seq, true)
    inner = a.ae_taint_stmts(cx.ae_taint(esc.match ({
        true  => a.dead_cons(l.elem, cx.tainted),
        false => cx.tainted,
    })), l.body)
    (esc && cx.tainted.dead_has(l.elem) == false).then({ a.dead_remove(inner, l.elem) }, { inner })
}
ae_taint_expr = (a: MutPtr<Malloc>, cx: AeCtx, e: Ptr<Expr>) Ptr<DeadList> {
    load(e).match ({
        .Loop(l) => a.ae_taint_loop(cx, l),
        _        => cx.tainted.expr_fold_children(e, (acc, ch) {
            a.ae_taint_expr(cx.ae_taint(acc), ch)
        }, (acc, body) { a.ae_taint_stmts(cx.ae_taint(acc), body) }),
    })
}
// a store INTO a local place (`s.p = x.addr()`, `ps[0] = x.addr()`) taints the place's root local. A
// store rooted at a param/global is a different escape (the out-param store, `ae_store_pos`), not a
// local alias, so it adds nothing here.
ae_taint_store = (a: MutPtr<Malloc>, cx: AeCtx, target: Ptr<Expr>, value: Ptr<Expr>) Ptr<DeadList> {
    rn = target.wr_root_name()
    (cx.locals.dead_has(rn) && a.ae_escapes(cx, value, true)).match ({
        true  => a.dead_cons(rn, cx.tainted),
        false => cx.tainted,
    })
}
// a statement list in VALUE position: any `return` inside it escapes, and — when `tail` — so does its
// trailing value. `let`s thread the taint set exactly as at the top level, so a block that aliases first
// (`{ q = x.addr() ⏎ q }`) is caught. `tail` is false for a `.Loop` body, whose trailing value is
// discarded — only its returns reach the caller.
ae_stmts_val_escapes = (a: MutPtr<Malloc>, cx: AeCtx, stmts: [Stmt], hop: bool, tail: bool) bool {
    f ::= false
    cur ::= cx
    stmts.loop_at((i, st) {
        hit = st.match ({
            .Return(r)   => a.ae_escapes(cur, r, hop),
            .ExprStmt(e) => tail && i == stmts.len - 1 && a.ae_escapes(cur, e, hop),
            _            => false,
        })
        f = hit.then({ true }, { f })
        cur = cur.ae_taint(a.ae_taint_step(cur, st))
    })
    f
}
ae_inits_escape = (a: MutPtr<Malloc>, cx: AeCtx, inits: [FieldInit], hop: bool) bool {
    inits.slice_any((fi) { a.ae_escapes(cx, fi.value, hop) })
}
// a match EXTRACTS: when the subject carries a frame address, the payload an arm binds carries it too,
// so `ev = Cell.S(x.addr())` … `ev.match ({ .S(w) => w, … })` hands the address back out through `w`.
ae_arms_escape = (a: MutPtr<Malloc>, cx: AeCtx, arms: [ArmData], hop: bool, subj: bool) bool {
    arms.slice_any((ar) {
        a.ae_escapes(cx.ae_taint((subj && ar.bind == "" == false).match ({
            true  => a.dead_cons(ar.bind, cx.tainted),
            false => cx.tainted,
        })), ar.body, hop)
    })
}
ae_items_escape = (a: MutPtr<Malloc>, cx: AeCtx, items: [Expr], hop: bool) bool {
    items.slice_any((it) { a.ae_escapes(cx, it.addr(), hop) })
}
// ── ESCAPE THROUGH A FN (re-census #1: stack-escape via a wrapper) ─────────────────────────────────
// The intra-procedural walk above flags `<local>.addr()` FORWARDED through slice/struct/match/cond/block
// in a return/trailing. But a local's address laundered THROUGH A CALL — an identity/wrapper fn that
// returns one of its pointer params (`id(x.addr())`, or `Box(p: id(x.addr()))`) — slipped past (the
// `.Call` arm only forwarded `slice`). We close it with a per-fn summary "does fn's return value derive
// from its param `pi`?" (bounded, structural — pointer flow needs no type infer), and follow ANY call
// hop whose matching arg is itself an escaping local address. Sound (reject-more) + zero over-reject: the
// arg must be an addr-of-LOCAL (the only tainted shape) AND the callee must actually thread that param to
// its result; a callee that reads through the pointer and returns a fresh/copied value threads nothing.
// does local fn `fn`'s return value derive from its param at index `pi`? (bounded interprocedural)
ae_fn_returns_param = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    fn: StringView,
    pi: i32,
    depth: i32,
) bool {
    (depth <= 0).match ({
        true  => false,
        false => {
            f = idx.idx_func(decls, fn)
            (f.name == "" == false && pi >= 0 && pi < f.params.len).match ({
                true  => a.ae_ret_body(decls, idx, f.body, f.params[pi].name, depth),
                false => false,
            })
        },
    })
}
// value position: does expr `e` yield the tracked param `name` (directly, forwarded, or via one hop)?
ae_ret_yields = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    name: StringView,
    e: Ptr<Expr>,
    depth: i32,
) bool {
    load(e).match ({
        .Var(v)        => v.name == name,
        // `name` INVOKED: an FnT param (`apply = (f: () T) T { f() }`) hands its lambda's value
        // straight back out, so a lambda whose body yields a frame address escapes through the call.
        .Call(c)       => (c.fn == name).match ({
            true  => true,
            false => (c.fn == "slice" && c.args.len > 0).match ({
                true  => a.ae_ret_yields(decls, idx, name, c.args[0].addr(), depth),
                false => a.ae_ret_call(decls, idx, c, name, depth),
            }),
        }),
        .MakeStruct(s) => a.ae_ret_inits(decls, idx, s.inits, name, depth),
        .MakeEnum(mk)  => a.ae_ret_yields(decls, idx, name, mk.payload, depth),
        .Match(m)      => a.ae_ret_valarms(decls, idx, m.arms, name, depth),
        .Cond(d)       => a.ae_ret_yields(decls, idx, name, d.t, depth)
            || a.ae_ret_yields(decls, idx, name, d.e, depth),
        .Block(b)      => a.ae_ret_blockval(decls, idx, b.stmts, name, depth),
        .SliceLit(sd)  => a.ae_ret_items(decls, idx, sd.items, name, depth),
        _              => false,
    })
}
ae_ret_inits = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    inits: [FieldInit],
    name: StringView,
    depth: i32,
) bool { inits.slice_any((fi) { a.ae_ret_yields(decls, idx, name, fi.value, depth) }) }
ae_ret_valarms = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    arms: [ArmData],
    name: StringView,
    depth: i32,
) bool { arms.slice_any((ar) { a.ae_ret_yields(decls, idx, name, ar.body, depth) }) }
ae_ret_items = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    items: [Expr],
    name: StringView,
    depth: i32,
) bool { items.slice_any((it) { a.ae_ret_yields(decls, idx, name, it.addr(), depth) }) }
ae_ret_blockval = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    stmts: [Stmt],
    name: StringView,
    depth: i32,
) bool {
    (stmts.len == 0).match ({
        true  => false,
        false => stmts[stmts.len - 1].match ({
            .ExprStmt(e) => a.ae_ret_yields(decls, idx, name, e, depth),
            .Return(r)   => a.ae_ret_yields(decls, idx, name, r, depth),
            _            => false,
        }),
    })
}
// one interprocedural hop: a call whose arg[i] yields `name` AND whose callee returns its param `i`.
ae_ret_call = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    c: CallData,
    name: StringView,
    depth: i32,
) bool {
    (depth <= 1).match ({
        true  => false,
        false => {
            f = idx.idx_func(decls, c.fn)
            found ::= false
            (f.name == "" == false && f.params.len == c.args.len).then({
                c.args.loop_at((i, ar) {
                    (a.ae_ret_yields(decls, idx, name, ar.addr(), depth - 1)
                        && a.ae_fn_returns_param(decls, idx, c.fn, i, depth - 1)).then({
                        found = true
                    })
                })
            })
            found
        },
    })
}
// returns-only statement walker over the callee body (mirrors the escape walker; trailing handled by caller).
ae_ret_body = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    body: [Stmt],
    name: StringView,
    depth: i32,
) bool {
    f = body.slice_any((st) { a.ae_ret_stmt(decls, idx, st, name, depth) })
    (body.len == 0).match ({
        true  => f,
        false => body[body.len - 1].match ({
            .ExprStmt(e) => a.ae_ret_yields(decls, idx, name, e, depth).then({ true }, { f }),
            _            => f,
        }),
    })
}
ae_ret_stmt = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    st: Stmt,
    name: StringView,
    depth: i32,
) bool {
    st.match ({
        .Return(r)   => a.ae_ret_yields(decls, idx, name, r, depth),
        .While(w)    => a.ae_ret_body(decls, idx, w.body, name, depth),
        .ExprStmt(e) => a.ae_ret_estmt(decls, idx, e, name, depth),
        _            => false,
    })
}
ae_ret_estmt = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    e: Ptr<Expr>,
    name: StringView,
    depth: i32,
) bool {
    load(e).match ({
        .Match(m) => a.ae_ret_stmtarms(decls, idx, m.arms, name, depth),
        .Cond(d)  => a.ae_ret_estmt(decls, idx, d.t, name, depth)
            || a.ae_ret_estmt(decls, idx, d.e, name, depth),
        .Block(b) => a.ae_ret_body(decls, idx, b.stmts, name, depth),
        .Loop(l)  => a.ae_ret_body(decls, idx, l.body, name, depth),
        _         => false,
    })
}
ae_ret_stmtarms = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    arms: [ArmData],
    name: StringView,
    depth: i32,
) bool {
    f ::= false
    arms.loop_at((i, ar) {
        hit = load(ar.body).match ({
            .Block(b) => a.ae_ret_body(decls, idx, b.stmts, name, depth),
            _         => false,
        })
        f = hit.then({ true }, { f })
    })
    f
}
// the call-following forward for the escape walk: a local's address escaping into a returning-param arg.
ae_call_escapes = (a: MutPtr<Malloc>, cx: AeCtx, c: CallData) bool {
    f = cx.idx.idx_func(cx.decls, c.fn)
    found ::= false
    (f.name == "" == false && f.params.len == c.args.len).then({
        c.args.loop_at((i, ar) {
            (a.ae_escapes(cx, ar.addr(), true)
                && a.ae_fn_returns_param(cx.decls, cx.idx, c.fn, i, consume_depth())).then({
                found = true
            })
        })
    })
    found
}
// ── ESCAPE THROUGH AN OUT-PARAM STORE (sibling of ae_call_escapes) ──────────────────────────────────
// `ae_call_escapes` follows a local address that leaves through a callee's RETURN value. A callee can also
// leak it by STORING it through one of its OTHER pointer params (`stash = (b: MutPtr<Box>, l: Ptr<Leaf>)
// { b.p = l }` — `l` never returns, but writing `b.p = l` plants it in caller-reachable memory). The
// value-position walk misses this because the escaping call is a bare statement, not a returned value.
// We close it with a store summary + a call-site outlives check. SOUND, zero over-reject by design:
//   (1) the arg must be `<local>.addr()` (the only tainted shape),
//   (2) the callee must actually store THAT param through a POINTER param (a by-value-struct out-param
//       writes a local copy — not stored, not flagged; a callee that only reads the pointer stores nothing),
//   (3) the destination call-site arg must OUTLIVE this frame (rooted at a param/global, NOT a local — so
//       `stash(local_box.addr(), x.addr())`, where both die together, is NOT flagged).
// index of `rn` among `f`'s params when it names a POINTER param, else -1.
ae_ptr_param_idx = (f: Func, rn: StringView) i32 {
    di ::= 0 - 1
    (rn == "" == false).then({
        f.params.loop_at((i, p) {
            (p.name == rn && is_ptr_ty(p.ty)).then({
                di = i
            })
        })
    })
    di
}
// does fn `fn` store its param `si` THROUGH a DIFFERENT pointer param — and if so, that param's index? -1
// = no such store. Scans top-level `.Assign`/`.IndexSet` places rooted at a pointer param `!= si` whose
// value yields param `si` (reuses the return-flow value walk). Stores nested in arms under-reject (safe).
ae_fn_store_dest = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    fn: StringView,
    si: i32,
    depth: i32,
) i32 {
    f = idx.idx_func(decls, fn)
    (f.name == "" == false && si >= 0 && si < f.params.len).match ({
        true  => a.ae_store_scan(decls, idx, f, f.params[si].name, si, f.body, depth),
        false => 0 - 1,
    })
}
ae_store_scan = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    f: Func,
    sname: StringView,
    si: i32,
    body: [Stmt],
    depth: i32,
) i32 {
    dest ::= 0 - 1
    body.loop_at((i, st) {
        di = st.match ({
            .Assign(x)   => a.ae_store_hit(decls, idx, f, sname, si, x.target, x.value, depth),
            .IndexSet(x) => a.ae_store_hit(decls, idx, f, sname, si, x.seq, x.value, depth),
            _            => 0 - 1,
        })
        (di >= 0).then({
            dest = di
        })
    })
    dest
}
// a store whose place is rooted at a pointer param `di != si` and whose value yields `sname` → di, else -1.
ae_store_hit = (
    a: MutPtr<Malloc>,
    decls: [Decl],
    idx: DeclIndex,
    f: Func,
    sname: StringView,
    si: i32,
    target: Ptr<Expr>,
    value: Ptr<Expr>,
    depth: i32,
) i32 {
    di = ae_ptr_param_idx(f, target.wr_root_name())
    (di >= 0 && di == si == false && a.ae_ret_yields(decls, idx, sname, value, depth)).match ({
        true  => di,
        false => 0 - 1,
    })
}
// a call-site arg that names a place OUTLIVING this frame: rooted at a plain var that is NOT a collected
// local (i.e. a parameter or a global). Not rooted at a var → not-outliving (safe under-reject).
ae_arg_outlives = (locals: Ptr<DeadList>, e: Ptr<Expr>) bool {
    rn = e.wr_root_name()
    rn == "" == false && locals.dead_has(rn) == false
}
// ── ESCAPE THROUGH A WRITE INTO CALLER-VISIBLE STORAGE ─────────────────────────────────────────────
// Everything above reports a frame address leaving through the RETURN value. Return position is not the
// FACT, though — it is one instance of it. The fact is: a pointer into this frame was written into
// storage that outlives this frame. `out.v = x.addr()`, `dst[0] = x.addr()`, `store(out, x.addr())` and
// `store(dst, S(p: x.addr()))` write exactly that, and every one of them was accepted for as long as the
// rule keyed on the syntactic position rather than on the fact. The rules below key on the DESTINATION's
// PROVENANCE — where the written-to storage lives — so no statement form, verb or arity can walk past
// them; a new way to spell "write" only has to route through `ae_write_pos` to be covered.
// does this type hand the frame a WINDOW onto memory it does not own? A pointer and a slice do; a
// scalar/struct parameter is this frame's own copy.
ae_indirect_ty = (t: Ty) bool {
    is_ptr_ty(t)
        || t.match ({
            .Slice(ep) => true,
            _          => false,
        })
}
// a PARAMETER named `rn` through which the callee reaches the caller's memory. A name that is not a
// parameter yields false: a global is deliberately still out of scope for this walk (as it is for the
// return path), and so are the loop-element / match-arm bindings that `ae_collect` never collects.
ae_param_indirect = (params: [Param], rn: StringView) bool {
    f ::= false
    params.loop_at((i, p) {
        (p.name == rn && p.ty.ae_indirect_ty()).then({
            f = true
        })
    })
    f
}
// the destination test: storage reachable by the caller after this frame dies — an indirect parameter,
// or a local that is a second NAME for one.
ae_root_outlives = (cx: AeCtx, rn: StringView) bool {
    (rn == "").then({ false }, { cx.outlives.dead_has(rn) || cx.params.ae_param_indirect(rn) })
}
// a local bound from a BARE NAME that already denotes caller-visible storage (`q ::= out`) is a second
// name for the very same storage — an indirect parameter is a pointer/slice, so binding its name copies
// the window, not the memory. Only a bare name propagates: a FIELD read (`s ::= out.inner`) may copy a
// by-value struct into this frame, and calling that an alias would reject a write to a local copy. The
// cost is one under-reject (a pointer-typed field read is a real alias this walk does not follow); the
// alternative costs a false positive, and a false positive in a safety rule is the worse currency.
ae_outl_step = (a: MutPtr<Malloc>, cx: AeCtx, st: Stmt) Ptr<DeadList> {
    st.match ({
        .Let(l) => load(l.value).match ({
            .Var(v) => cx.ae_root_outlives(v.name).match ({
                true  => a.dead_cons(l.name, cx.outlives),
                false => cx.outlives,
            }),
            _       => cx.outlives,
        }),
        _       => cx.outlives,
    })
}
// grow BOTH name sets across one statement — the taint set (what carries a frame address) and the
// outlives set (what names caller-visible storage). Both are monotone, so one forward pass suffices.
ae_step = (a: MutPtr<Malloc>, cx: AeCtx, st: Stmt) AeCtx {
    cx.ae_taint(a.ae_taint_step(cx, st)).ae_outl(a.ae_outl_step(cx, st))
}
// THE rule: a write whose destination outlives this frame and whose value yields a pointer into it.
ae_write_pos = (a: MutPtr<Malloc>, cx: AeCtx, dest: Ptr<Expr>, val: Ptr<Expr>, pos: i32) i32 {
    (cx.ae_root_outlives(dest.wr_root_name()) && a.ae_escapes(cx, val, true)).match ({
        true  => pos.pos_or(load(val).expr_pos()).pos_or(1),
        false => 0,
    })
}
// an assignment place that reaches THROUGH its root (`out.v`, `out->v`, `out[i]`) rather than rebinding
// it: `out = x.addr()` overwrites this frame's own copy of the parameter, which dies with the frame.
ae_thru_place = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Member(m) => true,
        .Index(ix) => true,
        _          => false,
    })
}
ae_assign_write_pos = (
    a: MutPtr<Malloc>,
    cx: AeCtx,
    target: Ptr<Expr>,
    val: Ptr<Expr>,
    pos: i32,
) i32 { target.ae_thru_place().then({ a.ae_write_pos(cx, target, val, pos) }, { 0 }) }
// the write INTRINSICS are the same write spelled as a call: `store(p, v)` IS `*p = v`, and arg0 IS the
// place. Keyed on the family that writes through arg0 (is_write_intrinsic), not on the name `store`.
ae_intrin_write_pos = (a: MutPtr<Malloc>, cx: AeCtx, e: Ptr<Expr>) i32 {
    load(e).match ({
        .Call(c) => (c.fn.is_write_intrinsic() && c.args.len >= 2).match ({
            true  => a.ae_write_pos(cx, c.args[0].addr(), c.args[1].addr(), c.pos),
            false => 0,
        }),
        _        => 0,
    })
}
// statement-position store escape: the source offset of a call that plants a pointer into this frame
// through an out-param whose destination arg outlives this frame, else 0.
ae_store_pos = (a: MutPtr<Malloc>, cx: AeCtx, e: Ptr<Expr>) i32 {
    load(e).match ({
        .Call(c) => {
            acc ::= 0
            c.args.loop_at((si, ar) {
                a.ae_escapes(cx, ar.addr(), true).then({
                    di = a.ae_fn_store_dest(cx.decls, cx.idx, c.fn, si, consume_depth())
                    (di >= 0 && di < c.args.len && cx.locals.ae_arg_outlives(c.args[di].addr())).then({
                        acc = acc.or(c.pos.pos_or(1))
                    })
                })
            })
            acc
        },
        _        => 0,
    })
}
// value position: does this expression yield a pointer into THIS frame? It does when it IS a
// `<local>.addr()`, when it names a local TAINTED by one (`q = x.addr()` … `q`), when it reads a place
// rooted at such a local (`s.p`, `ps[0]`), when it forwards one through slice()/enum/struct/slice-literal/
// match/cond/block/loop, or — only when `hop` — through a call to a fn that returns one of its pointer
// params (identity/wrapper laundering). `hop` is on for the return/trailing escape (the actual
// stack-escape-via-fn vuln) and off for the send path, which the sendability pass owns (so a laundered
// send stays kind `sendable`, not `escape`).
// EXHAUSTIVE over `Expr` BY DESIGN — there is no `_` arm. A default arm in an escape checker reads "a
// shape I have not thought about is safe", and that default is exactly how the alias, struct-member and
// slice-element laundering above shipped as accepted code. Spelling every variant out makes a new `Expr`
// variant an exhaustiveness ERROR here instead of a silent hole; the `false` arms below are each a claim
// that the shape cannot carry an address, not an absence of thought.
ae_escapes = (a: MutPtr<Malloc>, cx: AeCtx, e: Ptr<Expr>, hop: bool) bool {
    cx.locals.ae_is_addr_local(e).match ({
        true  => true,
        false => load(e).match ({
            .Int(n)         => false,
            .Byte(b)        => false,
            .FloatLit(t)    => false,
            .StrLit(s)      => false,    // static storage — outlives every frame
            .Tag(t)         => false,    // a payload-less enum tag carries nothing
            .Bin(b)         => false,    // Zen has no pointer arithmetic (`+` rejects pointer operands),
            // so every `Bin` yields a number or a bool
            .Lambda(lm)     => a.ae_stmts_val_escapes(cx, lm.body, hop, true),
            .Var(v)         => cx.tainted.dead_has(v.name),
            .Member(m)      => a.ae_escapes(cx, m.obj, hop),
            .Index(ix)      => a.ae_escapes(cx, ix.seq, hop),
            .Call(c)        => (c.fn == "slice" && c.args.len > 0).match ({
                true  => a.ae_escapes(cx, c.args[0].addr(), hop),
                false => hop.then({ a.ae_call_escapes(cx, c) }, { false }),
            }),
            .MethodCall(mc) => false,    // desugar_method_calls lowers every MethodCall to a flat Call
            // before validation reads a body — unreachable, listed to keep the match total
            .MakeEnum(mk)   => a.ae_escapes(cx, mk.payload, hop),
            .MakeStruct(s)  => a.ae_inits_escape(cx, s.inits, hop),
            .Match(m)       => a.ae_arms_escape(cx, m.arms, hop, a.ae_escapes(cx, m.subj, hop)),
            .Cond(d)        => a.ae_escapes(cx, d.t, hop) || a.ae_escapes(cx, d.e, hop),
            .Block(b)       => a.ae_stmts_val_escapes(cx, b.stmts, hop, true),
            .SliceLit(sd)   => a.ae_items_escape(cx, sd.items, hop),
            .Loop(l)        => a.ae_stmts_val_escapes(cx, l.body, hop, false),
        }),
    })
}
// position walk: the source offset of the first escaping return/trailing, 0 = none. Mirrors kv_escape_*
// in compiler.validate.core, and threads the taint set across each statement exactly as it does.
ae_kv_arm = (a: MutPtr<Malloc>, cx: AeCtx, body: Ptr<Expr>) i32 {
    load(body).match ({
        .Block(b) => a.ae_kv_stmts(cx, b.stmts),
        _         => 0,
    })
}
ae_kv_arms = (a: MutPtr<Malloc>, cx: AeCtx, arms: [ArmData]) i32 {
    acc ::= 0
    arms.loop_at((i, ar) { acc = acc.or(a.ae_kv_arm(cx, ar.body)) })
    acc
}
// the intrinsic-write check leads: a `store` sits in statement position, but it is just as valid nested
// inside a call argument or a match arm, and this walk is the one that reaches every such position.
ae_kv_expr_stmt = (a: MutPtr<Malloc>, cx: AeCtx, e: Ptr<Expr>) i32 {
    a
        .ae_intrin_write_pos(cx, e)
        .or(load(e).match ({
            .Match(m)   => a.ae_kv_arms(cx, m.arms),
            .Cond(d)    => a.ae_kv_expr_stmt(cx, d.t).or(a.ae_kv_expr_stmt(cx, d.e)),
            .Block(b)   => a.ae_kv_stmts(cx, b.stmts),
            .Loop(l)    => a.ae_kv_stmts(cx, l.body),
            // a lambda body is checked WITHOUT its implicit trailing return: that value is the lambda's
            // result, which this discarded call throws away — reading it as a function return would
            // reject `apply(() { x.addr() })`, where nothing leaves the frame.
            .Lambda(lm) => a.ae_kv_stmts(cx, lm.body.lam_stmt_body()),
            // a send / out-param store / escaping return can sit in ANY nested statement list, and a
            // `.Lambda` body reached only through a call argument was in none of the arms above.
            _           => 0.expr_fold_children(e, (acc, ch) { acc.or(a.ae_kv_expr_stmt(cx, ch)) }, (acc, body) {
                acc.or(a.ae_kv_stmts(cx, body))
            }),
        }))
}
ae_kv_stmt = (a: MutPtr<Malloc>, cx: AeCtx, st: Stmt) i32 {
    st.match ({
        // a void function's trailing statement arrives here as a `.Return`, so the write checks belong
        // on this path too — that is where `store(out, x.addr())` as the last statement lives.
        .Return(r)   => (cx.ptr_ret && a.ae_escapes(cx, r, true)).match ({
            true  => load(r).expr_pos().pos_or(1),
            false => a.ae_store_pos(cx, r).or(a.ae_intrin_write_pos(cx, r)),
        }),
        .While(w)    => a.ae_kv_stmts(cx, w.body),
        .Let(l)      => a.ae_send_pos(cx, l.value).or(a.ae_store_pos(cx, l.value)),
        .Assign(x)   => a
            .ae_send_pos(cx, x.value)
            .or(a.ae_store_pos(cx, x.value))
            .or(a.ae_assign_write_pos(cx, x.target, x.value, x.pos)),
        .IndexSet(x) => a
            .ae_send_pos(cx, x.value)
            .or(a.ae_store_pos(cx, x.value))
            .or(a.ae_write_pos(cx, x.seq, x.value, x.pos)),
        .ExprStmt(e) => a.ae_kv_expr_stmt(cx, e).or(a.ae_send_pos(cx, e)).or(a.ae_store_pos(cx, e)),
        _            => 0,
    })
}
ae_kv_stmts = (a: MutPtr<Malloc>, cx: AeCtx, body: [Stmt]) i32 {
    acc ::= 0
    cur ::= cx
    body.loop_at((i, st) {
        acc = acc.or(a.ae_kv_stmt(cur, st))
        cur = a.ae_step(cur, st)
    })
    acc
}
ae_kv_body = (a: MutPtr<Malloc>, cx: AeCtx, body: [Stmt]) i32 {
    acc ::= 0
    cur ::= cx
    body.loop_at((i, st) {
        acc = acc.or(a.ae_kv_stmt(cur, st))
        cur = a.ae_step(cur, st)
    })
    acc.or((body.len == 0).match ({
        true  => 0,
        false => body[body.len - 1].match ({
            .ExprStmt(e) => (cx.ptr_ret && a.ae_escapes(cur, e, true)).match ({
                true  => load(e).expr_pos().pos_or(1),
                false => 0,
            }),
            _            => 0,
        }),
    }))
}
ae_check_func* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, f: Func) i32 {
    a.ae_kv_body(AeCtx(
        decls: decls,
        idx: idx,
        params: f.params,
        locals: a.ae_collect(a.dead_nil(), f.body),
        tainted: a.dead_nil(),
        outlives: a.dead_nil(),
        ptr_ret: f.ret.ty_carries_ptr(),
    ), f.body)
}
// ── UNIFIED send-payload walk (replaces the near-identical sd_*/sm_* traversal skeletons). ────────
// ONE tree-fold parameterized by `mode`: 0 = send-Rc (sd_* leaves), 1 = send-MutPtr (sm_* leaves).
// Returns a packed kind+pos (Verdict `.or` keeps the first nonzero); both sendability passes now share ONE
// traversal and only the per-node CLASSIFIER (which send surfaces, which payload type) differs by mode.
// mode 0 has NO `.MethodCall` arm — send-Rc classifies plain `send(...)` calls only — so the
// `mode==0 => 0` branch preserves that exactly (no descent into method-call children); the walk is
// byte-for-byte the behavior of the two hand-cloned families it replaces.
sv_call_pos = (env: Env, c: CallData, mode: i32) i32 {
    (mode == 0).then({ env.sd_call_pos(c) }, { env.sm_call_pos(c) })
}
sv_args = (a: MutPtr<Malloc>, env: Env, args: [Expr], mode: i32) i32 {
    acc ::= 0
    args.loop_at((i, ar) { acc = acc.or(a.sv_expr(env, ar.addr(), mode)) })
    acc
}
sv_arms = (a: MutPtr<Malloc>, env: Env, subjty: Ty, arms: [ArmData], mode: i32) i32 {
    acc ::= 0
    arms.loop_at((i, ar) { acc = acc.or(a.sv_expr(a.arm_env(env, subjty, ar), ar.body, mode)) })
    acc
}
sv_inits = (a: MutPtr<Malloc>, env: Env, inits: [FieldInit], mode: i32) i32 {
    acc ::= 0
    inits.loop_at((i, fi) { acc = acc.or(a.sv_expr(env, fi.value, mode)) })
    acc
}
sv_expr = (a: MutPtr<Malloc>, env: Env, e: Ptr<Expr>, mode: i32) i32 {
    load(e).match ({
        .Call(c)        => env.sv_call_pos(c, mode).or(a.sv_args(env, c.args, mode)),
        .MethodCall(mc) => (mode == 0).match ({
            true  => 0,
            false => env
                .sm_mcall_pos(mc)
                .or(a.sv_expr(env, mc.recv, mode))
                .or(a.sv_args(env, mc.args, mode)),
        }),
        .Bin(b)         => a.sv_expr(env, b.lhs, mode).or(a.sv_expr(env, b.rhs, mode)),
        .Index(ix)      => a.sv_expr(env, ix.seq, mode).or(a.sv_expr(env, ix.idx, mode)),
        .Cond(d)        => a
            .sv_expr(env, d.c, mode)
            .or(a.sv_expr(env, d.t, mode))
            .or(a.sv_expr(env, d.e, mode)),
        .Member(m)      => a.sv_expr(env, m.obj, mode),
        .Match(m)       => a
            .sv_expr(env, m.subj, mode)
            .or(a.sv_arms(env, env.infer_expr(m.subj), m.arms, mode)),
        .MakeEnum(mk)   => a.sv_expr(env, mk.payload, mode),
        .MakeStruct(s)  => a.sv_inits(env, s.inits, mode),
        .SliceLit(sd)   => a.sv_args(env, sd.items, mode),
        .Loop(l)        => a.sv_expr(env, l.seq, mode).or(a.sv_body(env, l.body, mode)),
        .Block(b)       => a.sv_body(env, b.stmts, mode),
        // the rest is a plain structural descent. `.Lambda` was missing from the hand-written list, so
        // a send inside a lambda body — the shape actor code is written in — was never classified.
        _               => 0.expr_fold_children(e, (acc, ch) { acc.or(a.sv_expr(env, ch, mode)) }, (acc, body) {
            acc.or(a.sv_body(env, body, mode))
        }),
    })
}
sv_stmt = (a: MutPtr<Malloc>, env: Env, st: Stmt, mode: i32) i32 {
    st.match ({
        .Let(l)      => a.sv_expr(env, l.value, mode),
        .Assign(x)   => a.sv_expr(env, x.target, mode).or(a.sv_expr(env, x.value, mode)),
        .Return(r)   => a.sv_expr(env, r, mode),
        .ExprStmt(e) => a.sv_expr(env, e, mode),
        .While(w)    => a.sv_expr(env, w.c, mode).or(a.sv_body(env, w.body, mode)),
        .IndexSet(x) => a
            .sv_expr(env, x.seq, mode)
            .or(a.sv_expr(env, x.idx, mode))
            .or(a.sv_expr(env, x.value, mode)),
    })
}
sv_body = (a: MutPtr<Malloc>, env: Env, body: [Stmt], mode: i32) i32 {
    acc ::= 0
    e ::= env
    body.loop_at((i, st) {
        acc = acc.or(a.sv_stmt(e, st, mode))
        e = a.extend_env(e, st)
    })
    acc
}
sv_check_func* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, f: Func, mode: i32) i32 {
    env = Env(
        vars: a.params_env(f.params),
        decls: decls,
        didx: idx,
        exp: f.ret,
        a: a,
    )
    a.sv_body(env, f.body, mode)
}
// a scratch-SOURCE expression: memory whose lifetime is the spawner's frame/allocator, in either
// surface form (flat `acquire(a, n)` or UFCS `a.acquire(n)` — this pass runs pre-desugar).
sx_is_acquire = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Call(c)        => c.fn.sx_named("acquire", "__acquire") && c.args.len >= 1,
        .MethodCall(mc) => mc.method.sx_named("acquire", "__acquire"),
        _               => false,
    })
}
// `make_in(…)` bare, or the Result-unified `make_in(…).expect(…)` — the arena constructor returns
// Result<Arena, IoError> now, so the textbook scratch shape carries an `.expect` wrapper; unwrap it
// (an `.expect` whose receiver is NOT a scratch source still classifies clean, e.g. Arc `new_in`).
sx_is_make_in = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Call(c)        => c.fn.sx_named("make_in", "__make_in") && c.args.len >= 1
            || c.fn.sx_named("expect", "__expect")
                && c.args.len >= 1
                && c.args[0].match ({
                    .Call(c2)        => c2.fn.sx_named("make_in", "__make_in") && c2.args.len >= 1,
                    .MethodCall(mc2) => mc2.method.sx_named("make_in", "__make_in"),
                    _                => false,
                }),
        .MethodCall(mc) => mc.method.sx_named("make_in", "__make_in")
            || mc.method.sx_named("expect", "__expect") && mc.recv.sx_is_make_in(),
        _               => false,
    })
}
// `<var>.addr()` — the address of a stack slot in the spawner's frame.
sx_is_addr_of_var = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Call(c)        => (c.fn == "addr" && c.args.len == 1).match ({
            true  => c.args[0].match ({
                .Var(v) => true,
                _       => false,
            }),
            false => false,
        }),
        .MethodCall(mc) => (mc.method == "addr" && mc.args.len == 0).match ({
            true  => load(mc.recv).match ({
                .Var(v) => true,
                _       => false,
            }),
            false => false,
        }),
        _               => false,
    })
}
sx_is_slicelit = (e: Ptr<Expr>) bool {
    load(e).match ({
        .SliceLit(sd) => true,
        _             => false,
    })
}
sx_is_source = (e: Ptr<Expr>) bool {
    e.sx_is_acquire() || e.sx_is_make_in() || e.sx_is_addr_of_var() || e.sx_is_slicelit()
}
// does a let/assign VALUE make its binding spawner-scratch? a direct source, or an alias of a
// tainted local (`q = p`). Anything else (calls, member reads, literals) stays clean — lenient.
sx_taints = (taint: Ptr<DeadList>, e: Ptr<Expr>) bool {
    e.sx_is_source().match ({
        true  => true,
        false => load(e).match ({
            .Var(v) => taint.dead_has(v.name),
            _       => false,
        }),
    })
}
// thread the taint set across one statement: a Let/Assign of a source (or an alias) taints the
// name; a (re)bind to anything clean REVIVES it, so a reused name never over-rejects.
sx_step = (a: MutPtr<Malloc>, taint: Ptr<DeadList>, st: Stmt) Ptr<DeadList> {
    st.match ({
        .Let(l)    => taint.sx_taints(l.value).match ({
            true  => a.dead_cons(l.name, taint),
            false => a.dead_remove(taint, l.name),
        }),
        .Assign(x) => load(x.target).match ({
            .Var(v) => taint.sx_taints(x.value).match ({
                true  => a.dead_cons(v.name, taint),
                false => a.dead_remove(taint, v.name),
            }),
            _       => taint,
        }),
        _          => taint,
    })
}
// fresh binders (lambda params, loop idx/elem/handler, arm binds) shadow any same-named taint.
sx_drop_params = (a: MutPtr<Malloc>, taint: Ptr<DeadList>, ps: [Param]) Ptr<DeadList> {
    out ::= taint
    ps.loop_at((i, p) { out = a.dead_remove(out, p.name) })
    out
}
// a positioned anchor for a source expression (expr_pos has no MethodCall arm; this pass sees the
// pre-desugar UFCS form, so `a.acquire(n)` anchors at the method name).
sx_pos = (e: Ptr<Expr>) i32 {
    load(e).match ({
        .MethodCall(mc) => mc.pos.pos_or(load(mc.recv).expr_pos()),
        _               => load(e).expr_pos(),
    })
}
// the offending source offset inside a send-payload / spawn-state expression: a tainted bare local,
// a direct source expression, or one embedded in a struct-literal field / enum payload / nested
// literal. Everything else (calls, member reads, plain values) is 0 = clean.
sx_payload_pos = (a: MutPtr<Malloc>, taint: Ptr<DeadList>, e: Ptr<Expr>) i32 {
    e.sx_is_source().match ({
        true  => e.sx_pos().pos_or(1),
        false => load(e).match ({
            .Var(v)        => taint.dead_has(v.name).then({ v.pos.pos_or(1) }, { 0 }),
            .MakeEnum(mk)  => a.sx_payload_pos(taint, mk.payload),
            .MakeStruct(s) => a.sx_inits_pos(taint, s.inits),
            _              => 0,
        }),
    })
}
sx_inits_pos = (a: MutPtr<Malloc>, taint: Ptr<DeadList>, inits: [FieldInit]) i32 {
    acc ::= 0
    inits.loop_at((i, fi) { acc = acc.or(a.sx_payload_pos(taint, fi.value)) })
    acc
}
// pack an offending position under a rule kind (0 = clean stays 0 — kv_at alone would emit a bare kind).
sx_kv = (pos: i32, k: i32) i32 { (pos == 0).then({ 0 }, { kv_at(k, pos) }) }
// actor-send / spawn surfaces (name-based, arity-guarded): the PAYLOAD/STATE is the LAST argument.
//   send:         `send(h, m)` (2+ args) / `h.send(m)` — CellRef/ActorHandle/ActorCell/ReplyRef
//   pool_send:    `pool_send(p, a, m)` (3 args) / `p.pool_send(a, m)` (2 args)
//   ref_send_msg: `ref_send_msg(r, m)` (2 args) / `r.ref_send_msg(m)` (1 arg) — S2's typed ActorRef
//                 REPLY send (std.concurrent.pool_actor). A reply is sent from INSIDE `receive`, where the
//                 handler's OWN per-behavior scratch (`self.scratch`, reset when the behavior ends) is in
//                 scope — so a scratch pointer routed out through a reply would dangle before the receiver
//                 reads it. Recognizing it here rejects that identically to a forward send (KSCRATCHSEND).
//   spawn:        `spawn(alloc, cap, state)` (3 args) / `alloc.spawn(cap, state)` (2-arg MethodCall) /
//              module-qualified `actor.spawn_handle(alloc, cap, state)` — the flattener rewrites a
//              namespace-qualified call to `alias__spawn_handle(alloc, cap, state)`, so the flat-Call
//              match also accepts the `…__spawn` / `…__send` / `…__pool_send` suffix forms.
//              `spawn_handle` is std.concurrent.actor's cooperative constructor (renamed from `spawn`
//              so it never flatten-collides with std.concurrent.thread's `spawn`); both spellings are
//              recognized here so user fns simply NAMED `spawn` keep their guard.
sx_named* = (fn: StringView, bare: StringView, qual: StringView) bool {
    fn == bare || fn.ends_with(qual)
}
sx_call_kind = (a: MutPtr<Malloc>, taint: Ptr<DeadList>, c: CallData) i32 {
    sk = (c.fn.sx_named("send", "__send") && c.args.len >= 2
        || c.fn.sx_named("pool_send", "__pool_send") && c.args.len == 3
        || c.fn.sx_named("ref_send_msg", "__ref_send_msg") && c.args.len == 2).match ({
        true  => a.sx_payload_pos(taint, c.args[c.args.len - 1].addr()).sx_kv(KSCRATCHSEND()),
        false => 0,
    })
    st = ((c.fn.sx_named("spawn", "__spawn") || c.fn.sx_named("spawn_handle", "__spawn_handle"))
        && c.args.len == 3).match ({
        true  => a.sx_payload_pos(taint, c.args[2].addr()).sx_kv(KSCRATCHSTATE()),
        false => 0,
    })
    sk.or(st)
}
sx_mcall_kind = (a: MutPtr<Malloc>, taint: Ptr<DeadList>, mc: MethodCallData) i32 {
    sk = (mc.method.sx_named("send", "__send") && mc.args.len >= 1
        || mc.method.sx_named("pool_send", "__pool_send") && mc.args.len == 2
        || mc.method.sx_named("ref_send_msg", "__ref_send_msg") && mc.args.len == 1).match ({
        true  => a.sx_payload_pos(taint, mc.args[mc.args.len - 1].addr()).sx_kv(KSCRATCHSEND()),
        false => 0,
    })
    st = ((mc.method.sx_named("spawn", "__spawn")
        || mc.method.sx_named("spawn_handle", "__spawn_handle"))
        && (mc.args.len == 2 || mc.args.len == 3)).match ({
        true  => a.sx_payload_pos(taint, mc.args[mc.args.len - 1].addr()).sx_kv(KSCRATCHSTATE()),
        false => 0,
    })
    sk.or(st)
}
sx_args_kind = (a: MutPtr<Malloc>, taint: Ptr<DeadList>, args: [Expr]) i32 {
    acc ::= 0
    args.loop_at((i, ar) { acc = acc.or(a.sx_expr_kind(taint, ar.addr())) })
    acc
}
sx_arms_kind = (a: MutPtr<Malloc>, taint: Ptr<DeadList>, arms: [ArmData]) i32 {
    acc ::= 0
    arms.loop_at((i, ar) {
        t2 = is_empty(ar.bind).then({ taint }, { a.dead_remove(taint, ar.bind) })
        acc = acc.or(a.sx_expr_kind(t2, ar.body))
    })
    acc
}
sx_inits_kind = (a: MutPtr<Malloc>, taint: Ptr<DeadList>, inits: [FieldInit]) i32 {
    acc ::= 0
    inits.loop_at((i, fi) { acc = acc.or(a.sx_expr_kind(taint, fi.value)) })
    acc
}
sx_expr_kind = (a: MutPtr<Malloc>, taint: Ptr<DeadList>, e: Ptr<Expr>) i32 {
    load(e).match ({
        .Call(c)        => a.sx_call_kind(taint, c).or(a.sx_args_kind(taint, c.args)),
        .MethodCall(mc) => a
            .sx_mcall_kind(taint, mc)
            .or(a.sx_expr_kind(taint, mc.recv))
            .or(a.sx_args_kind(taint, mc.args)),
        .Bin(b)         => a.sx_expr_kind(taint, b.lhs).or(a.sx_expr_kind(taint, b.rhs)),
        .Index(ix)      => a.sx_expr_kind(taint, ix.seq).or(a.sx_expr_kind(taint, ix.idx)),
        .Cond(d)        => a
            .sx_expr_kind(taint, d.c)
            .or(a.sx_expr_kind(taint, d.t))
            .or(a.sx_expr_kind(taint, d.e)),
        .Member(m)      => a.sx_expr_kind(taint, m.obj),
        .Match(m)       => a.sx_expr_kind(taint, m.subj).or(a.sx_arms_kind(taint, m.arms)),
        .MakeEnum(mk)   => a.sx_expr_kind(taint, mk.payload),
        .MakeStruct(s)  => a.sx_inits_kind(taint, s.inits),
        .SliceLit(sd)   => a.sx_args_kind(taint, sd.items),
        .Loop(l)        => a
            .sx_expr_kind(taint, l.seq)
            .or(a.sx_body_kind(a.dead_remove(a.dead_remove(a.dead_remove(taint, l.idx), l.elem), l.h), l.body)),
        .Lambda(lm)     => a.sx_body_kind(a.sx_drop_params(taint, lm.params), lm.body),
        .Block(b)       => a.sx_body_kind(taint, b.stmts),
        _               => 0,
    })
}
sx_stmt_kind = (a: MutPtr<Malloc>, taint: Ptr<DeadList>, st: Stmt) i32 {
    st.match ({
        .Let(l)      => a.sx_expr_kind(taint, l.value),
        .Assign(x)   => a.sx_expr_kind(taint, x.target).or(a.sx_expr_kind(taint, x.value)),
        .Return(r)   => a.sx_expr_kind(taint, r),
        .ExprStmt(e) => a.sx_expr_kind(taint, e),
        .While(w)    => a.sx_expr_kind(taint, w.c).or(a.sx_body_kind(taint, w.body)),
        .IndexSet(x) => a
            .sx_expr_kind(taint, x.seq)
            .or(a.sx_expr_kind(taint, x.idx))
            .or(a.sx_expr_kind(taint, x.value)),
    })
}
sx_body_kind = (a: MutPtr<Malloc>, taint: Ptr<DeadList>, body: [Stmt]) i32 {
    acc ::= 0
    t ::= taint
    body.loop_at((i, st) {
        acc = acc.or(a.sx_stmt_kind(t, st))
        t = a.sx_step(t, st)
    })
    acc
}
sx_func_kind* = (a: MutPtr<Malloc>, f: Func) i32 { a.sx_body_kind(a.dead_nil(), f.body) }
// name the value in the message (teach-the-fix, spec §5): copy the identifier the caret points at
// out of the source; a non-identifier anchor (a slice literal's first item, a synthesized pos)
// falls back to a generic subject.
sx_push_name = (s: String, a: MutPtr<Malloc>, src: StringView, pos: i32, i: i32, w: i32) String {
    (i >= w).then({ s }, { sx_push_name(s.gstr_push(a, src.at(pos + i)), a, src, pos, i + 1, w) })
}
sx_subject* = (a: MutPtr<Malloc>, src: StringView, pos: i32, w: i32) StringView {
    src.at(pos).is_alnum().match ({
        true  => a
            .gstr_string(w + 4)
            .gstr_append(a, "`")
            .sx_push_name(a, src, pos, 0, w)
            .gstr_append(a, "`")
            .gstr_finish(a),
        false => "this value",
    })
}
sx_message* = (a: MutPtr<Malloc>, code: i32, subject: StringView) StringView {
    tail = (code == KSCRATCHSEND()).match ({
        true  => " is spawner-local scratch memory (allocator/arena/stack storage) and crosses an actor boundary in this send; the sender frees it independently of the receiving actor (use-after-free)",
        false => " is spawner-local scratch memory (allocator/arena/stack storage) embedded in the initial actor state; the actor outlives the spawner's scratch (use-after-free)",
    })
    a
        .gstr_string(256)
        .gstr_append(a, subject)
        .gstr_append(a, tail)
        .gstr_finish(a)
}
// Name only remedies that EXIST today. There are no region-promotion verbs (no `.share`/`.give`) and
// no typed regions — `sx_is_source` rejects four literal source shapes (`acquire(…)`, arena
// `make_in(…)`, `<local>.addr()`, a slice literal), so the way out is to hand the actor something
// that is not one of them and genuinely outlives the sender: a copied value, or an `Arc` (a call
// result, and refcounted so the receiver keeps it alive). `Rc` is NOT a remedy — the send-Rc pass
// rejects it. docs/STATUS.md's scratch/shared row is the ledger entry for this gap.
sx_hint* = (code: i32) StringView {
    (code == KSCRATCHSEND()).match ({
        true  => "construct it inside the actor's `receive`, send a plain value, or share long-lived data as an `Arc` (`std.mem.arc.new_in`) — see the scratch/shared row in docs/STATUS.md",
        false => "construct it inside the actor's `receive`, pass plain values as the initial state, or share long-lived data as an `Arc` (`std.mem.arc.new_in`) — see the scratch/shared row in docs/STATUS.md",
    })
}
