// Callback annotations must select the same bounded overload as explicit
// type arguments, regardless of declaration order or callback parameter index.
pick = <T: ToU64>(value: T, body: (value: T) T) i32 { body(value); 1 }
pick = (value: i32, body: (value: i32) i32) i32 { body(value); 2 }
reverse = (value: i32, body: (value: i32) i32) i32 { body(value); 3 }
reverse = <T: ToU64>(value: T, body: (value: T) T) i32 { body(value); 4 }
zero = <T: ToU64>(value: T, body: () T) i32 { body(); 5 }
zero = (value: i32, body: () i32) i32 { body(); 6 }
pair = <T: ToU64>(value: T, body: (index: usize, value: T) T) i32 { body(
    0,
    value
); 7 }
pair = (value: i32, body: (index: usize, value: i32) i32) i32 { body(
    0,
    value
); 8 }

main = (env: Env) Res<i32, AllocError> {
    println(
        "parameter {} explicit {}",
        pick(1, (value: u32) { value }),
        pick<u32>(1, (value: u32) { value })
    );
    println(
        "return {} default {}",
        pick(1, (value) u32 { value }),
        pick(1, (value) { value })
    );
    println("reverse {}", reverse(1, (value: u32) { value }));
    println(
        "zero {} pair {}",
        zero(1, () u32 { 9 }),
        pair(1, (index, value: u32) { value })
    );
    println("receiver {}", (1).pick((value: u32) { value }));
    Ok(0)
}
