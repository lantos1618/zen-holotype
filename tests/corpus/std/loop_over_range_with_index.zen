// tests/corpus/std/loop_over_range_with_index.zen
// index and value are different things: the range does not start
// at 0, so a body that confuses them prints the same number twice

main = (env: Env) Res<i32, AllocError> {
    Range(10, 13).loop((h, index, value) {
        println("{} {}", index, value);
    });
    Ok(0);
}
