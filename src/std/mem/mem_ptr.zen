// std.mem.mem_ptr
// The raw floor. A Ptr<T> is one machine word — the address of a run of
// T — and its members are the only way memory is ever touched.
//
// THIS FLOOR IS OUTSIDE THE FAILURE MODEL (DESIGN.md, "The failure
// model"): read and write are C's p[i], bounds are the CALLER's to
// hold, nothing traps, and no marker at a call site says raw-floor —
// `p.read(i)` looks exactly as ordinary as a checked lookup. That is
// why every collection keeps its storage unexported and hands out
// checked doors instead; Vec.ptr* is the one export onto this floor,
// named for what it is.
//
// Misuse here is also quiet in both directions an overread can be:
// the arena never reuses a byte (mem_arena.zen), so bytes past a run
// are OTHER LIVE OBJECTS rather than garbage, and the run never leaves
// its malloc block, so no sanitizer flags it. See DESIGN.md for both.
//
// `*` is the export marker, so Zen has no pointer sigil: a raw pointer
// is spelled Ptr<T>, a name rather than punctuation. A Ptr IS A HANDLE,
// so every method takes `self: @Self` — a bitwise copy sees the write
// (DESIGN.md's `:` test, one level below where Alloc answers it). The
// bodies belong to the backend: gen_c lowers Ptr<T> to `T*` — signatures
// only, the one module in std that can't implement itself.

Ptr*<T> = {
    // the address. NOT exported: every legal use goes through a method
    // below
    addr: usize,

    // element access, INDEXED — `p.read(i)` is C's `p[i]`. Vec.get/add
    // call exactly these two
    read* = (self: @Self, index: usize) T
    write* = (self: @Self, index: usize, value: T) ()

    // a new Ptr, `count` ELEMENTS along, forward and back — scaling by
    // the element type is the whole reason this is Ptr<T> not an
    // address. `back` exists because an allocator writes a run's
    // length into the word ahead of it, and usize has no negative
    offset* = (self: @Self, count: usize) Ptr<T>
    back* = (self: @Self, count: usize) Ptr<T>

    // byte size of `count` elements — the only way std can ask how big
    // a T is (no size_of in the language; @meta is stage 5)
    bytes* = (self: @Self, count: usize) usize

    // copy `count` elements from src into self; runs may not overlap
    copy_from* = (self: @Self, src: Ptr<T>, count: usize) ()

    // reinterpret the run as U, unchecked — no `as` in Zen, so
    // conversion is a method, like .to_i64()
    to* = <U>(self: @Self) Ptr<U>

    // address is zero, nothing there — an empty collection's data field
    // holds a null Ptr until the first grow
    is_null* = (self: @Self) bool

    // address identity, used by Arena to recognise its latest run
    same* = (self: @Self, other: Ptr<T>) bool
}

// the null Ptr. A function, not a constant: a constant would still need
// a T, and the call site always has one — `null_ptr<i32>()`
null_ptr* = <T>() Ptr<T>
