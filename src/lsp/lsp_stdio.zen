// src/lsp/lsp_stdio.zen
// The transport: `Content-Length` frames over a pipe.
//
// `lsp_serve.zen` is the server and holds no transport at all — `one`
// takes bytes and appends bytes. This file is the only thing between it
// and an editor, small on purpose.
//
// THE FRAMING IS NOT REDONE HERE. `lsp_frame.zen` answers "where does
// this message end", and over a live stream its `Short` and `NoBlank`
// stop being faults — a header block not yet ended and a body shorter
// than its own `Content-Length` are bytes still in flight. `partial` is
// that reading, the ONLY thing this file knows about framing that the
// framing file does not.
//
// NOTHING IS WRITTEN WITH `println`. It appends exactly one `\n` and a
// frame may not have one — the missing piece `design_lsp.md` section 4
// named. `print` is the same write without the newline.
//
// THE INPUT BUFFER ONLY GROWS — the session's arena memory, exactly as
// `Server.docs` is. Reclaiming it would need a shrinkable `Vec` and a
// document map that copies.

str, String, str_at = std.text
Vec = std.collections
Alloc, AllocError = std.mem
FrameFault, frame_at, short_by = lsp.lsp_frame
Server, frame_byte, frame_why = lsp.lsp_serve

// How far a drain got, and whether the framing still made sense.
Drain* = {
    at*: usize,
    framed*: bool,
}

// One session, until the stream closes or `shutdown` is answered.
//
// THE READ COMES FIRST AND THE ANSWERS SECOND, every time round — what
// makes a frame split across two reads work: bytes are appended, and
// the drain finds one more complete message than last time.
//
// EACH READ ASKS FOR EXACTLY WHAT THE ENVELOPE SAYS IS MISSING —
// `short_by`; see `lsp_frame.zen` for why it cannot be a fixed chunk.
serve_stdio* = (env: Env, a: Alloc) Res<i32, AllocError> {
    server ::= a.Server(env);
    held ::= a.Vec<u8>();
    at ::= 0;
    open ::= true;
    framed ::= true;
    loop(() { open && framed && !server.stopped() }, (h) {
        seen = str_at(held.ptr(), held.len);
        open = arrived(env, held, short_by(seen, at)).try();
        d = drain(server, a, str_at(held.ptr(), held.len), at).try();
        at = d.at;
        framed = d.framed;
        after_drain(server, a).try();
    });
    Ok(exit_code(server.stopped(), framed));
}

// THE SETTLE POINT OVER A PIPE: everything that had arrived has been
// answered, so a build owed to a `didChange` happens here — a cheap
// no-op when nothing is owed.
//
// AND IT IS EVERY MESSAGE, NOT EVERY BATCH: `short_by` asks for exactly
// one message's bytes and `Stdin.read` blocks until it has them, so this
// reader cannot coalesce two keystrokes that both arrived (`lsp_diag.zen`'s
// header is blunt about this; `serve` over a buffer can).
//
// NOT CALLED `settled`: `Server` has a method of that name and this
// takes one as its first parameter, so the two would collide — this
// folder's rule about a free function shadowing a method.
after_drain = (server :: Server, a: Alloc) Res<(), AllocError> {
    out ::= a.String().try();
    server.settled(out).try();
    print(out.view());
    Ok(());
}

// `n` more bytes from stdin onto the end of `held`; `false` is end of
// input. THE ROOM IS MADE FIRST: `Stdin.read` has no `Alloc`, so it can
// only fill capacity that already exists. A read that FAILS ends the
// session exactly as a read of zero does — looping on a broken pipe
// would spin instead of exiting.
arrived = (env: Env, held :: Vec<u8>, n: usize) Res<bool, AllocError> {
    want = at_least_one(n);
    held.reserve(want).try();
    env.in.read(held, want).match({
        Err(_)  => Ok(false),
        Ok(got) => Ok(got > 0),
    })
}

// Never zero — a read of nothing would spin a loop. One byte always
// makes progress, which is what a header block being scanned asks for
// anyway.
at_least_one = (n: usize) usize {
    (n == 0).match({ true => 1, false => n })
}

// Every complete frame in `held` from `at`, answered to stdout. Stops at
// the first fault. A PARTIAL one is not a fault here — the next read
// fixes it — and a real one ends the session, since only the header of
// this message says where the next one starts.
drain = (server :: Server, a: Alloc, held: str, at: usize)
        Res<Drain, AllocError> {
    from ::= at;
    more ::= true;
    framed ::= true;
    loop(() { more && from < held.len }, (h) {
        frame_at(held, from).match({
            Ok(fr) => { from = fr.next; answered(server, a, fr.body).try(); },
            Err(f) => { more = false; framed = partial(f); fault_line(f, framed); },
        });
    });
    Ok(Drain(at: from, framed: framed));
}

// One message in, its reply out. THE BODY IS COPIED FIRST — the one
// line the transport cannot leave out: `held` is reallocated by the next
// read, and the server keeps `str`s pointing into whatever it was
// handed (the open documents are exactly that); a borrowed frame would
// leave the document map pointing at freed pages.
answered = (server :: Server, a: Alloc, body: str) Res<(), AllocError> {
    kept ::= a.String().try();
    kept.add_bytes(body).try();
    out ::= a.String().try();
    server.one(kept.view(), out).try();
    // A NOTIFICATION PRODUCES NO BYTES and this prints none: the
    // protocol forbids replying to one.
    print(out.view());
    Ok(());
}

// Is this fault "the rest has not arrived yet"? Over a buffer `serve`
// treats every fault as the end of the session; over a live stream two
// are not faults — a header block not yet ended, and a short body. The
// other two are a client speaking a protocol this is not.
partial = (f: FrameFault) bool {
    f.match({
        NoBlank(_)   => true,
        Short(_)     => true,
        NoLength(_)  => false,
        BadLength(_) => false,
    })
}

// A real framing fault, said once, to the same stream the replies went
// to. `println` here (vs `print` above) is correct: this is a line of
// text, not a frame.
fault_line = (f: FrameFault, framed: bool) () {
    framed.match({
        true  => (),
        false => println("lsp: bad frame at byte {} ({})",
                         frame_byte(f), frame_why(f)),
    });
}

// `exit 0` when `shutdown` was answered, 1 otherwise: this server stops
// reading the moment it answers `shutdown`, so it never sees the `exit`
// that follows. A stream closing under a running server is the SAME
// answer as a client going away without asking, and so is a broken
// frame.
exit_code = (stopped: bool, framed: bool) i32 {
    (stopped && framed).match({ true => 0, false => 1 })
}
