// A module alias may keep the module's own name. Excluding that alias from
// local lookup must not let a loaded module override a different local type.
helpers = helpers
marker, other = model

model = { value: i32 }
Chosen = model

main = () i32 {
    local: Chosen = model(value: 11);
    println("{} {} {}", helpers.value(), local.value, marker() + other());
    0
}
