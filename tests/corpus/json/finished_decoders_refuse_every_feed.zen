JsonEvent, JsonFault = std.json

finished = (a: Alloc, text: str) Res<(), JsonFault> {
    decoder ::= a.Decoder().try();
    events  ::= a.Vec<JsonEvent>();
    decoder.feed(text, events).try();
    decoder.finish(events).match({ Ok(_) => println("finished"), Err(_) => println("unfinished") });
    before = events.len;
    decoder.feed(" ", events).match({ Ok(_) => println("accepted chunk"), Err(_) => println("refused chunk") });
    decoder.feed_byte(32, events).match({ Ok(_) => println("accepted byte"), Err(_) => println("refused byte") });
    println("unchanged {}", before == events.len);
    Ok(())
}

main = (env: Env) Res<(), JsonFault> {
    a = env.mem.alloc();
    finished(a, "true").try();
    finished(a, "[1").try();
    finished(a, "1e").try();
    Ok(())
}
