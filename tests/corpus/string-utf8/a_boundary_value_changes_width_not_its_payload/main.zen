// The encoder at the three width boundaries. Each PAIR is one below and
// exactly on a limit -- 0x7FF|0x800, 0xFFFF|0x10000 -- and the bytes
// show what no count can: the LEAD byte jumps to the next band while
// the payload bits stay put (DF BF then E0 A0 80; EF BF BF then F0 B0
// 80 80). An encoder with an off-by-one band test puts 0x800 in two
// bytes, or re-sends 0x7FF's payload into the wider lead; either way
// some printed number moves off 223 or 224.
String = std.text.text_string
Utf8Error, push_utf8 = std.text.text_utf8

push = (v: u32, out :: String) Res<(), AllocError> {
    push_utf8(v, out).match({
        Ok(_) => Ok(()),
        Err(_) => Err(AllocError.OutOfMemory),
    });
}

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    sb ::= alloc.String("").try();
    push(2047, sb).try();
    push(2048, sb).try();
    push(65535, sb).try();
    push(65536, sb).try();
    v ::= sb.view();
    println("len {}", v.len);
    println("{} {} {} {} {}", v[0], v[1], v[2], v[3], v[4]);
    println("{} {} {} {} {} {} {}", v[5], v[6], v[7], v[8], v[9], v[10], v[11]);
    Ok(0);
}
