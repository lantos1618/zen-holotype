// A FREE FUNCTION WHOSE FIRST PARAMETER IS THE TYPE IS ALSO REACHED BY
// DIRECT CALL, and the direct call and the dot call are the SAME function:
// the free body answers the direct call, the method answers the dot.
//
// "A method is a UFCS function whose first parameter happens to be named
// self" (DESIGN.md § Ownership) cuts both ways: `f(x)` and `x.f()` name
// one lookup. The wrong implementation keeps two tables -- methods for
// dots, top-level names for bare calls -- and then `f(w)` finds the FREE
// function even where resolution should have found the method, or a
// same-name pair merges into whichever was declared first. Here the two
// bodies differ in value, so which table answered is observable per call
// site: arity decides, not syntax.
//
// Breaks if: bare-name calls skip the UFCS merge -- `scale(w, 2)` answers
// 9 (the method body) instead of 14.

W = {
    v: i32,
    scale = (self: @Self, k: i32) i32 { self.v + k }
}

scale = (w: W, k: i32) i32 { w.v * k }

main = (env: Env) Res<i32, AllocError> {
    w = W(v: 7);
    println("direct {}", scale(w, 2));
    println("dot    {}", w.scale(7));
    Ok(0);
}
