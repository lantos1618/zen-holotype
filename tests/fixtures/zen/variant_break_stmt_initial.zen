// A statement-initial `.Ok`-style ctor after a normal call statement is a NEW statement (the
// trailing expression), not a `.field` chain glued onto `println(y)`.
{ println } = std.text.fmt
Res: Okv(i32) | Nov
pick = (y: i32) Res {
    println(y)
    .Okv(y)
}
main = () i32 {
    pick(41).match ({
        .Okv(v) => v + 1,
        .Nov    => 7,
    })
}
