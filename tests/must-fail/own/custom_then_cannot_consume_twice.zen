Buf = { id: i32 }
Buf.impl(Drop, { drop = (self :: @Self) () { println("drop {}", self.id); } })
Runner = {
    then = (self: @Self, body: () ()) () { body(); body(); }
}
main = (env: Env) Res<i32, IoError> {
    f = Buf(id: 1);
    r = Runner();
    r.then(() { g = consume f; println("{}", g.id); });
    Ok(0)
}
