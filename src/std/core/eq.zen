// src/std/core/eq.zen
// equality — one half of Map's bound: the hash finds the row fast,
// eq confirms the key.
//
// nothing is imported or impl'd here: a trait sits BELOW the types
// that satisfy it, so an impl lives with the type — str's impl beside
// Eq would make std.core depend on std.text and invert the module graph

Eq* = {
    // required (`=` with no body): DESIGN.md's default is an @meta
    // field-wise walk, and @meta is stage 5 — outside the seed subset.
    // until it lands, a type that wants equality writes this one method
    eq* = (self: @Self, other: @Self) bool

    // sealed law: ne is always !eq, so the two can never diverge
    ne* = (self: @Self, other: @Self) bool { !self.eq(other) }
}

// membership — equality asked of a list. A run of `||` spells the
// same question once per answer and repeats the subject every time;
// `name.is_in(["i8", "i16"])` states subject, question and answer set
// once each.
//
// `R: Range<T>` and not an array type, for the reason the loop family
// gives (std.core.range): a bound monomorphises where an
// interface-typed parameter would be a fat value, and it makes a Vec
// of names as good an argument as a literal list. The list is an
// argument, so its storage is the caller's frame — nothing here
// outlives the call.
//
// A PRIMITIVE CANNOT BE THE SUBJECT: no `u8` or `i32` implements Eq,
// so `b == ' ' || b == '\t'` has no is_in form until one does.
//
// AN ACCUMULATOR AND NOT `xs.find((v) { v.eq(x) })`, which is the same
// walk with a name on it and would ordinarily be the rule. The
// bootstrapper drops the type parameters when a generic body reaches a
// generic through a lambda and emits `Res<q>` with `q` unsubstituted,
// so the find spelling compiles here and fails at `cc` in every one of
// the 45 differential tests that stages this file.
is_in* = <T: Eq, R: Range<T>>(x: T, xs: R) bool {
    hit ::= false;
    xs.loop((h, v) { v.eq(x).then(() { hit = true; h.break(); }) });
    hit
}
