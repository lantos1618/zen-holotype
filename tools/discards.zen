// tools/discards.zen — census of DISCARDED `Result<T, E>` values, written in Zen (dogfooding the
// compiler-as-library, same shape as tools/sigs.zen).
//
//   ./zen run tools/discards.zen <scan-root> [<scan-root> …]
//
// Phase 0 builds a WHOLE-REPO name → return-type index by parsing every module under the fixed
// index roots with the REAL parser (compiler.parse.parse_module — no regex): a simple name maps to
// 1 when EVERY declaration of that name returns `Result<…>`, 3 when none does, 2 when they disagree
// (ambiguous — never counted). Impl methods are registered under their DEMANGLED simple name, which
// is what a UFCS call site actually writes.
//
// Phase 1 re-parses the requested roots and walks every function body, reporting one line per site:
//
//   src/x/y.zen:123: put in fname [stmt]
//
// The three site kinds:
//   stmt        a call returning Result in a DISCARD position — a non-final statement of a body, or
//               the final statement of a body whose value is thrown away (a void fn's tail, a `.loop`
//               body, an `@while` body), including via a match arm / cond branch in that position
//   lambda-tail the final statement of a LAMBDA body. The lambda's return type comes from the FnT it
//               is passed to, which a parse-only tool cannot see, so these are counted apart
//   unread      `x = f()` where `x` is never read again in the body (bound, then dropped)
{ arg, argc } = std.sys.os
{ Malloc } = std.mem.alloc
{ contents_in } = std.io.file
{ is_dir, read_dir } = std.sys.fs
{ cat_in, ends_with, view } = std.text.str
{ expect } = std.core.result
{ then } = std.core.bool
{ arg_int, arg_str, format } = std.text.fmt
{ Map, of } = std.collections.map
{ parse_module } = compiler.parse
{ perr_get } = compiler.parse_type
{ lerr_get } = compiler.lex
{ ArmData, Decl, Expr, Func, ImplData, Stmt, Ty } = compiler.ast.ast_types
{ expr_fold_children } = compiler.ast.expr_children
{ name_read_in_body } = compiler.validate.core
{ impl_cname_in } = compiler.mangle
// running totals for the trailing summary line
g_files ::= 0
g_fns ::= 0
g_stmt ::= 0
g_lambda ::= 0
g_unread ::= 0
g_calls ::= 0
g_loose ::= 0    // --loose: count AMBIGUOUS names (state 2) as Result too — the upper bound
// ── phase 0: the name → return-shape index ────────────────────────────────────
// 0 = unseen, 1 = every decl of this name returns Result, 2 = decls disagree, 3 = none returns Result
ret_is_result = (t: Ty) bool {
    t.match ({
        .Generic(g) => g.name == "Result",
        _           => false,
    })
}
idx_note = (m: Map<i64>, a: MutPtr<Malloc>, name: StringView, res: bool) Map<i64> {
    prev = m.get(name, 0)
    next: i64 = res.match ({
        true  => (prev == 0 || prev == 1).then({ 1 }, { 2 }),
        false => (prev == 0 || prev == 3).then({ 3 }, { 2 }),
    })
    m.put(a, name, next).expect("discards: index alloc")
}
// the return type of the fn named `name` among `decls` (Void when absent)
find_ret = (decls: [Decl], name: StringView) Ty {
    res :: Ty = .Void
    found ::= false
    decls.loop((h, i, d) {
        d.match ({
            .DFunc(f) => (f.name == name && found == false).then({
                found = true
                res = f.ret
            }),
            _         => { },
        })
    })
    res
}
// an impl's methods, registered under the SIMPLE method name (the UFCS call-site spelling)
idx_impl = (m: Map<i64>, a: MutPtr<Malloc>, decls: [Decl], im: ImplData) Map<i64> {
    out ::= m
    im.methods.loop((h, k, p) {
        r = decls.find_ret(a.impl_cname_in(im.trname, im.ty, p.name))
        out = out.idx_note(a, p.name, r.ret_is_result())
    })
    out
}
idx_module = (m: Map<i64>, a: MutPtr<Malloc>, decls: [Decl]) Map<i64> {
    out ::= m
    decls.loop((h, i, d) {
        out = d.match ({
            .DFunc(f)    => out.idx_note(a, f.name, f.ret.ret_is_result()),
            .DForeign(f) => out.idx_note(a, f.name, f.ret.ret_is_result()),
            .DImpl(im)   => out.idx_impl(a, decls, im),
            _            => out,
        })
    })
    out
}
// ── phase 1: the scan ─────────────────────────────────────────────────────────
Ctx: {
    path: StringView,
    src: StringView,
    m: Map<i64>,
    loc: Map<i64>,
    fname: StringView,
    voidfn: i32,
}
// 1-based line of a byte offset
line_of = (src: StringView, pos: i32) i64 {
    n ::= 1
    p = pos + 0
    src.view().loop((h, i, b) {
        (i < p && b == '\n').then({
            n = n + 1
        })
    })
    n
}
callee_of = (e: Ptr<Expr>) StringView {
    load(e).match ({
        .Call(c)        => c.fn,
        .MethodCall(mc) => mc.method,
        _               => "",
    })
}
callee_pos = (e: Ptr<Expr>) i32 {
    load(e).match ({
        .Call(c)        => c.pos,
        .MethodCall(mc) => mc.pos,
        _               => 0,
    })
}
is_result_call = (cx: Ctx, e: Ptr<Expr>) bool {
    nm = callee_of(e)
    l = (nm == "").then({ 0 }, { cx.loc.get(nm, 0) })
    v = (nm == "" || l != 0).then({ l }, { cx.m.get(nm, 0) })
    v == 1 || g_loose == 1 && v == 2
}
report = (cx: Ctx, e: Ptr<Expr>, tag: StringView) void {
    format("{}:{}: {} in {} [{}]\n", [arg_str(cx.path), arg_int(cx.src.line_of(callee_pos(e))), arg_str(callee_of(e)), arg_str(cx.fname), arg_str(tag)])
}
scan_arms = (cx: Ctx, arms: [ArmData], mode: i32) void {
    arms.loop((h, i, ar) {
        cx.scan_expr(ar.body, mode)
    })
}
// mode: 0 = the expr's value is USED, 1 = discarded, 2 = a lambda tail (return type unknown here)
scan_expr = (cx: Ctx, e: Ptr<Expr>, mode: i32) void {
    cx.is_result_call(e).then({
        g_calls = g_calls + 1
    })
    (mode != 0 && cx.is_result_call(e)).then({
        (mode == 1).match ({
            true  => {
                g_stmt = g_stmt + 1
                cx.report(e, "stmt")
            },
            false => {
                g_lambda = g_lambda + 1
                cx.report(e, "lambda-tail")
            },
        })
    })
    load(e).match ({
        .Block(b)   => cx.scan_body(b.stmts, mode),
        .Loop(l)    => {
            cx.scan_expr(l.seq, 0)
            cx.scan_body(l.body, 1)
        },    // a `.loop` body runs for effect: every statement is a discard
        .Lambda(lm) => cx.scan_body(lm.body, 2),
        .Match(mt)  => {
            cx.scan_expr(mt.subj, 0)
            cx.scan_arms(mt.arms, mode)
        },
        .Cond(d)    => {
            cx.scan_expr(d.c, 0)
            cx.scan_expr(d.t, mode)
            cx.scan_expr(d.e, mode)
        },
        _           => {
            0.expr_fold_children(e, (acc, ch) {
                cx.scan_expr(ch, 0)
                acc
            }, (acc, body) {
                cx.scan_body(body, 2)
                acc
            })
        },
    })
}
scan_body = (cx: Ctx, stmts: [Stmt], mode: i32) void {
    stmts.loop((h, i, st) {
        tail = i == stmts.len - 1
        st.match ({
            .ExprStmt(e) => cx.scan_expr(e, tail.then({ mode }, { 1 })),
            .Let(l)      => {
                cx.scan_expr(l.value, 0)
                (cx.is_result_call(l.value) && l.name.name_read_in_body(stmts) == false).then({
                    g_unread = g_unread + 1
                    cx.report(l.value, "unread")
                })
            },
            .Assign(asg) => {
                cx.scan_expr(asg.target, 0)
                cx.scan_expr(asg.value, 0)
            },
            // A `return` always leaves the ENCLOSING FN, never the lambda it is written inside, so its
            // value is used unless that fn is void. Taking the surrounding `mode` here reported every
            // guard-shaped `.then({ return err(…) })` as a discarded Result — 18 of the first 21 hits.
            .Return(e)   => cx.scan_expr(e, cx.voidfn),
            .If(f)       => {
                cx.scan_expr(f.c, 0)
                cx.scan_body(f.then, 1)
                cx.scan_body(f.els, 1)
            },
            .While(w)    => {
                cx.scan_expr(w.c, 0)
                cx.scan_body(w.body, 1)
            },
            .IndexSet(x) => {
                cx.scan_expr(x.seq, 0)
                cx.scan_expr(x.idx, 0)
                cx.scan_expr(x.value, 0)
            },
        })
    })
}
ty_is_void = (t: Ty) bool {
    t.match ({
        .Void => true,
        _     => false,
    })
}
scan_fn = (cx: Ctx, f: Func) void {
    g_fns = g_fns + 1
    vf: i32 = f.ret.ty_is_void().then({ 1 }, { 0 })
    c2 = Ctx(
        path: cx.path,
        src: cx.src,
        m: cx.m,
        loc: cx.loc,
        fname: f.name,
        voidfn: vf,
    )
    c2.scan_body(f.body, vf)
}
scan_module = (cx: Ctx, decls: [Decl]) void {
    decls.loop((h, i, d) {
        d.match ({
            .DFunc(f) => cx.scan_fn(f),
            _         => { },
        })
    })
}
// ── the walk (same shape as tools/sigs.zen) ───────────────────────────────────
sv_lt_at = (xv: [u8], yv: [u8], i: i64) bool {
    (i >= xv.len || i >= yv.len).match ({
        true  => xv.len < yv.len,
        false => (xv[i] == yv[i]).then({ xv.sv_lt_at(yv, i + 1) }, { xv[i] < yv[i] }),
    })
}
sv_lt = (x: StringView, y: StringView) bool { x.view().sv_lt_at(y.view(), 0) }
sift_left = (xs: [StringView], j: i64) void {
    (j > 0 && sv_lt(xs[j], xs[j - 1])).then({
        t = xs[j]
        xs[j] = xs[j - 1]
        xs[j - 1] = t
        xs.sift_left(j - 1)
    })
}
sort_from = (xs: [StringView], i: i64) void {
    (i < xs.len).then({
        xs.sift_left(i)
        xs.sort_from(i + 1)
    })
}
sort_names = (xs: [StringView]) void { xs.sort_from(1) }
// index one file into `m` (phase 0)
index_file = (m: Map<i64>, a: MutPtr<Malloc>, path: StringView) Map<i64> {
    src = a.contents_in(path).expect("discards: cannot read file")
    decls = a.parse_module(src)
    (perr_get() || lerr_get()).then({ m }, { m.idx_module(a, decls) })
}
// scan one file (phase 1)
scan_file = (m: Map<i64>, a: MutPtr<Malloc>, path: StringView) void {
    g_files = g_files + 1
    src = a.contents_in(path).expect("discards: cannot read file")
    decls = a.parse_module(src)
    ((perr_get() || lerr_get()) == false).then({
        seed: i64 = 0
        loc = of(a, "", seed).expect("discards: local index alloc").idx_module(a, decls)
        cx = Ctx(
            path: path,
            src: src,
            m: m,
            loc: loc,
            fname: "",
            voidfn: 0,
        )
        cx.scan_module(decls)
    })
}
// walk a file or a directory tree: phase 0 = index, phase 1 = scan
walk = (m: Map<i64>, a: MutPtr<Malloc>, root: StringView, phase: i32) Map<i64> {
    out ::= m
    root.is_dir().match ({
        true  => {
            entries = a.read_dir(root).expect("discards: cannot read directory")
            entries.sort_names()
            entries.loop((h, i, entry) {
                out = out.walk(a, a.cat_in(a.cat_in(root, "/"), entry), phase)
            })
        },
        false => root.ends_with(".zen").then({
            (phase == 0).match ({
                true  => {
                    out = out.index_file(a, root)
                },
                false => {
                    m.scan_file(a, root)
                },
            })
        }),
    })
    out
}
// The roots named on the command line. argv is a handful of entries, so recursion carries the cursor:
// `@while` is for the scanners over unbounded input, not for a bounded argv walk.
scan_roots = (m: Map<i64>, a: MutPtr<Malloc>, i: i32) void {
    (i < argc()).then({
        (arg(i) == "--loose").match ({
            true  => {
                g_loose = 1
            },
            false => {
                m.walk(a, arg(i), 1)
            },
        })
        m.scan_roots(a, i + 1)
    })
}
main = () i32 {
    mm = Malloc(_: 0)
    a = mm.addr()
    seed: i64 = 0
    m ::= of(a, "", seed).expect("discards: index alloc")
    // phase 0: index the WHOLE repo, so a call into another module resolves
    m = m.walk(a, "src", 0)
    m = m.walk(a, "driver.zen", 0)
    m = m.walk(a, "build.zen", 0)
    m = m.walk(a, "tools", 0)
    // `--index` dumps the classification of every indexed name (1 = Result-only, 2 = ambiguous)
    (argc() > 1 && arg(1) == "--index").then({
        ks = m.keys()
        ks.loop((h, k, key) {
            format("IDX {} {}\n", [arg_str(key), arg_int(m.get(key, 0))])
        })
    })
    // phase 1: scan the roots named on the command line
    m.scan_roots(a, 1)
    format("-- discards: {} files, {} fns, {} Result-calls, {} stmt, {} lambda-tail, {} unread\n", [arg_int(g_files), arg_int(g_fns), arg_int(g_calls), arg_int(g_stmt), arg_int(g_lambda), arg_int(g_unread)])
    0
}
