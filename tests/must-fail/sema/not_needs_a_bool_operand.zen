// `!` on a non-bool operand must be refused, and the diagnostic must sit
// on the `!` itself.
//
// sema_type.zen's unary ladder typed `Not` as `bool_ty()` UNCONDITIONALLY
// -- it never looked at the operand -- so `!some_struct` type-checked,
// lowered to C's `!` on a struct value, and `cc` refused the emitted C
// with "wrong type argument to unary exclamation mark". The refusal
// belongs in the checker: `check_not` asks whether the operand coerces
// to `bool`, and the span it reports is the OPERATOR TOKEN, because that
// is where the character the author has to delete is.
//
// position: the `!`, not the operand.

Thing = {
    n: i32,
}

main = (env: Env) Res<i32, AllocError> {
    t ::= Thing(n: 1);
    b ::= !t;
    println("{}", b);
    Ok(0);
}
