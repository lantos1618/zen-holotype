// compiler.genc_emit_expr — expression, match, and statement C-emission over the genc AST.
// Extracted from compiler.genc_emit; leaf integer/literal/escape helpers live in compiler.genc_emit_lit.
{ String } = std.text.string
{ eq, is_empty } = std.text.str
{ Expr, Stmt, ArmData, BinData, CallData, CondData, MatchData, MemberData, MakeStructData, MakeEnumData, SliceData, IndexData, LoopData, LambdaData, BlockData, IfData, ty_cname_in, blk_diverges, field, gstr_append } = compiler.genc
{ Malloc } = std.mem.alloc
{ panic } = std.core.result
{ gen_strlit } = compiler.genc_emit_lit
{ gstr_int } = compiler.astops
gen_expr* = (s: String, alloc: MutPtr<Malloc>, e: Ptr<Expr>) String {
    e.match ({
        // Suffix `LL` so an UNTYPED integer literal is a 64-bit C constant: bare literals are C `int`
        // (32-bit), so `100000 * 100000` (or `1 << 40`) would overflow at int width BEFORE any i64
        // assignment. With `LL` the arithmetic happens at >=64-bit, then the final assign/cast truncates
        // (the C-correct widen-then-narrow). Small i32 math is unchanged: int32_t op long long promotes,
        // computes, and the i32 store/cast narrows back.
        .Int(n)         => s.gstr_int(alloc, n).gstr_append(alloc, (n < 0).match ({
            true  => "ULL",
            false => "LL",
        })),
        .Byte(n)        => s.gstr_int(alloc, n),
        .FloatLit(ft)   => s.gstr_append(alloc, ft),
        .Var(v)         => s.gstr_append(alloc, v.name),
        .Bin(b)         => s.gen_bin(alloc, b),
        .Call(c)        => s.gen_call(alloc, c),
        .MethodCall(mc) => s.gstr_append(alloc, "zen__undesugared_method_call"),    // desugared to Call before codegen — marker if the invariant ever breaks
        .Cond(d)        => s.gen_cond(alloc, d),
        .Member(m)      => s.gen_member(alloc, m),
        .Arrow(a)       => s.gen_expr(alloc, a.obj).gstr_append(alloc, "->").gstr_append(alloc, a.field),
        .MakeEnum(m)    => s.gen_mkenum(alloc, m),
        .MakeStruct(m)  => s.gen_mkstruct(alloc, m),
        .Tag(t)         => s.gstr_append(alloc, "(").gstr_append(alloc, t.mty).gstr_append(alloc, "){ .tag = ").gstr_append(alloc, t.mty).gstr_append(alloc, "_").gstr_append(alloc, t.variant).gstr_append(alloc, " }"),
        .Match(m)       => s.gen_match(alloc, m),
        .StrLit(sl)     => s.gen_strlit(alloc, sl.value),
        .SliceLit(sd)   => s.gen_slicelit(alloc, sd),
        .Index(ix)      => s.gen_index(alloc, ix),
        .Loop(l)        => s.gen_loop(alloc, l),
        .Lambda(lm)     => s.gstr_append(alloc, "zen__unlowered_lambda"),
        .Block(b)       => s.gen_blockexpr(alloc, b),
    })
}
// GCC statement-expression; the trailing ExprStmt is the result expression. A trailing `return` is a
// USER return (arm/loop blocks never get an implicit trailing return; the inliner strips its own tail
// returns before splicing — see blk_diverges) and emits as a REAL `return`, leaving the enclosing C
// function. Such a block diverges: its emitters (gen_switch_body / gen_cond) never use its value.
gen_blockexpr = (s: String, alloc: MutPtr<Malloc>, b: BlockData) String {
    out := s.gstr_append(alloc, "({ ")
    b.stmts.loop((h, i, st) {
        out = out.gen_block_one(alloc, st, i == b.stmts.len - 1).gstr_append(alloc, " ")
    })
    out.gstr_append(alloc, "})")
}
gen_block_one = (s: String, alloc: MutPtr<Malloc>, st: Stmt, last: bool) String {
    last.match ({
        true  => st.match ({
            .ExprStmt(e) => s.gen_expr(alloc, e).gstr_append(alloc, ";"),
            _            => s.gen_stmt(alloc, st),
        }),
        false => s.gen_stmt(alloc, st),
    })
}
// `.tag` on a bare Tag node is the compile-time enum tag CONSTANT `<mty>_<variant>`; fold it to that
// bare identifier instead of materializing the tag struct just to read its `.tag`. or_return's Err-guard
// builds its condition this way (`tmp.tag == Tag(Result<T,E>, Err).tag`) so the enum name rides on a
// re-manglable Tag node — subst_expr rewrites T→concrete when a generic body is inlined (#54) — while
// the fold keeps the emitted spelling byte-identical to the old baked constant.
member_is_tag_const = (m: MemberData) bool {
    eq(m.field, "tag").match ({
        true  => load(m.obj).match ({
            .Tag(t) => true,
            _       => false,
        }),
        false => false,
    })
}
gen_tag_const = (s: String, alloc: MutPtr<Malloc>, obj: Ptr<Expr>) String {
    load(obj).match ({
        .Tag(t) => s.gstr_append(alloc, t.mty).gstr_append(alloc, "_").gstr_append(alloc, t.variant),
        _       => s,
    })
}
// Loop control is an EXPRESSION in the AST (it can sit inside a value-match arm), so a bare C
// `break`/`continue` is both mistargeted by an intervening match switch and unusable in expression
// position. The resolved handler is a unique local Var: jump to that loop's labels from a typed GNU
// statement-expression. The dead `0` gives __typeof__/conditional arm typing an ordinary value.
gen_loop_label = (s: String, alloc: MutPtr<Malloc>, obj: Ptr<Expr>, suffix: string_view) String {
    load(obj).match ({
        .Var(v) => s.gstr_append(alloc, v.name).gstr_append(alloc, suffix),
        _       => s.gstr_append(alloc, "zen__invalid_loop_handler"),
    })
}
gen_loop_jump = (s: String, alloc: MutPtr<Malloc>, obj: Ptr<Expr>, suffix: string_view) String { s.gstr_append(alloc, "({ goto ").gen_loop_label(alloc, obj, suffix).gstr_append(alloc, "; 0; })") }
gen_member = (s: String, alloc: MutPtr<Malloc>, m: MemberData) String {
    eq(m.field, "break_zk").match ({
        true  => s.gen_loop_jump(alloc, m.obj, "__break"),
        false => eq(m.field, "continue_zk").match ({
            true  => s.gen_loop_jump(alloc, m.obj, "__continue"),
            false => m.member_is_tag_const().match ({
                true  => s.gen_tag_const(alloc, m.obj),
                false => s.gen_expr(alloc, m.obj).gstr_append(alloc, ".").gstr_append(alloc, m.field),
            }),
        }),
    })
}
gen_loop = (s: String, alloc: MutPtr<Malloc>, l: LoopData) String {
    out := s
    // GNU local labels are scoped to this statement-expression. Generic inlining may clone a loop
    // (and therefore its handler spelling) multiple times in one C function; ordinary labels would
    // collide function-wide and could bind a jump to the wrong clone.
    out = out.gstr_append(alloc, "({ __label__ ").gstr_append(alloc, l.h).gstr_append(alloc, "__break, ").gstr_append(alloc, l.h).gstr_append(alloc, "__continue; __auto_type _seq = ")
    out = out.gen_expr(alloc, l.seq)
    out = out.gstr_append(alloc, "; for (int64_t ")
    out = out.gstr_append(alloc, l.idx)
    out = out.gstr_append(alloc, " = 0; ")
    out = out.gstr_append(alloc, l.idx)
    out = out.gstr_append(alloc, " < _seq.len; ")
    out = out.gstr_append(alloc, l.idx)
    out = out.gstr_append(alloc, " = ")
    out = out.gstr_append(alloc, l.idx)
    out = out.gstr_append(alloc, " + 1) { __auto_type ")
    out = out.gstr_append(alloc, l.elem)
    out = out.gstr_append(alloc, " = ((")
    out = out.gstr_append(alloc, alloc.ty_cname_in(l.elemTy))
    out = out.gstr_append(alloc, "*)_seq.ptr)[")
    out = out.gstr_append(alloc, l.idx)
    out = out.gstr_append(alloc, "]; ")
    out = out.gen_loop_body(alloc, l.body)
    out = out.gstr_append(alloc, " ").gstr_append(alloc, l.h).gstr_append(alloc, "__continue: ; } ")
    out.gstr_append(alloc, l.h).gstr_append(alloc, "__break: ; 0; })")
}
gen_loop_body = (s: String, alloc: MutPtr<Malloc>, body: [Stmt]) String {
    out := s
    body.loop((h, i, st) {
        out = out.gen_stmt(alloc, st).gstr_append(alloc, " ")
    })
    out
}
// Slice literal -> heap-promoted zslice. A bare C compound literal `(T[]){…}` has AUTOMATIC storage,
// so a slice literal that ESCAPES its frame (returned, or stored into a longer-lived aggregate) leaves
// `.ptr` dangling into the dead frame. Copy the backing into a malloc'd block inside a statement-
// expression so `.ptr` outlives the frame. The compiler itself emits no slice literals (its slices go
// through `slice`/`acquire`), so this only affects user/test programs. Empty `[]` needs no backing.
gen_slicelit = (s: String, alloc: MutPtr<Malloc>, sd: SliceData) String {
    n := slice_count(sd.items)
    (n == 0).match ({
        true  => s.gstr_append(alloc, "(zslice){ .ptr = (void*)0, .len = 0 }"),
        false => {
            tn := alloc.ty_cname_in(sd.elem)
            out := s.gstr_append(alloc, "({ ").gstr_append(alloc, tn).gstr_append(alloc, " _zsa[] = { ").gen_args(alloc, sd.items).gstr_append(alloc, " }; uint8_t* _zsp = malloc(sizeof(_zsa)); memcpy(_zsp, (uint8_t*)_zsa, sizeof(_zsa)); (zslice){ .ptr = (void*)_zsp, .len = ")
            out.gstr_int(alloc, n).gstr_append(alloc, " }; })")
        },
    })
}
slice_count = (items: [Expr]) i32 {
    n := 0
    items.loop((h, i, it) {
        n = n + 1
    })
    n
}
// Bounds-checked slice read: `zen__idx` (preamble) panics on a negative or >= len index and returns
// the element byte-pointer, which `*(ELEM*)…` derefs back to an lvalue (so `seq[i]` keeps working as a
// member base / address-of target). A plain function call — not a macro — so comma-bearing operands
// (compound literals etc.) parse as real C, and seq/idx each evaluate exactly once.
gen_index = (s: String, alloc: MutPtr<Malloc>, ix: IndexData) String {
    tn := alloc.ty_cname_in(ix.elem)
    s.gstr_append(alloc, "(*(").gstr_append(alloc, tn).gstr_append(alloc, "*)zen__idx(").gen_expr(alloc, ix.seq).gstr_append(alloc, ", ").gen_expr(alloc, ix.idx).gstr_append(alloc, ", sizeof(").gstr_append(alloc, tn).gstr_append(alloc, ")))")
}
// `/` and `%` emit a statement-expression that binds both operands once, then dispatches on operand
// type with `_Generic`: integer operands hit a checked helper that panics on divide-by-zero and on the
// INT_MIN/-1 overflow; float operands keep native C semantics (x/0.0 == inf, never a SIGFPE). A
// statement-expression (not a function-like macro) is used so operands that emit unparenthesized commas
// — e.g. compound literals `(zslice){.ptr=…, .len=…}` — parse as real C instead of splitting macro args.
// All other operators emit `(lhs op rhs)` unchanged.
gen_bin = (s: String, alloc: MutPtr<Malloc>, b: BinData) String {
    eq(b.op, "/.").match ({
        true  => s.gstr_append(alloc, "(").gen_expr(alloc, b.lhs).gstr_append(alloc, " / ").gen_expr(alloc, b.rhs).gstr_append(alloc, ")"),
        false => eq(b.op, "/").match ({
            true  => s.gstr_append(alloc, "({ __auto_type _zdl = (").gen_expr(alloc, b.lhs).gstr_append(alloc, "); __auto_type _zdr = (").gen_expr(alloc, b.rhs).gstr_append(alloc, "); _Generic(_zdl + _zdr, double:(double)(_zdl/_zdr), float:(float)(_zdl/_zdr), unsigned int: zen__udivz((uint64_t)_zdl, (uint64_t)_zdr), unsigned long: zen__udivz((uint64_t)_zdl, (uint64_t)_zdr), unsigned long long: zen__udivz((uint64_t)_zdl, (uint64_t)_zdr), default: zen__divz((int64_t)_zdl, (int64_t)_zdr)); })"),
            false => eq(b.op, "%").match ({
                true  => s.gstr_append(alloc, "({ __auto_type _zml = (").gen_expr(alloc, b.lhs).gstr_append(alloc, "); __auto_type _zmr = (").gen_expr(alloc, b.rhs).gstr_append(alloc, "); _Generic(_zml + _zmr, double:(int64_t)0, float:(int64_t)0, unsigned int: zen__umodz((uint64_t)_zml, (uint64_t)_zmr), unsigned long: zen__umodz((uint64_t)_zml, (uint64_t)_zmr), unsigned long long: zen__umodz((uint64_t)_zml, (uint64_t)_zmr), default: zen__modz((int64_t)_zml, (int64_t)_zmr)); })"),
                false => s.gstr_append(alloc, "(").gen_expr(alloc, b.lhs).gstr_append(alloc, " ").gstr_append(alloc, b.op).gstr_append(alloc, " ").gen_expr(alloc, b.rhs).gstr_append(alloc, ")"),
            }),
        }),
    })
}
// Intrinsics erase to C pointer/cast ops; missing intrinsic args degrade to literal 0.
gen_arg_at = (s: String, alloc: MutPtr<Malloc>, c: CallData, i: i32) String {
    (i < c.args.len).match ({
        true  => s.gen_expr(alloc, c.args[i].addr()),
        false => s.gstr_append(alloc, "0"),
    })
}
EmitCallKind: Normal | StrEq | StrNe | Load | Offset | Store | LoadI64 | StoreI64 | AtomicAddI64 | AtomicLoadI64 | AtomicStoreI64 | AtomicCasI64 | AtomicFence | Addr | AssertNonnull | CStr | Slice | NullPtr | ToI32 | ToI64 | ToU8 | ToF64 | Sizeof
// map a sizeof type-arg name to its C type name. Primitives (i64→int64_t, bool→…) must NOT leak the
// Zen keyword into C; struct names and already-substituted tparams (sizeof(T)→sizeof(Expr)) pass through.
// The canonical string_* family and its migration aliases all share the Phase-1 `const char*` layout.
sizeof_is_canonical_string = (n: string_view) bool { eq(n, "string_view") || eq(n, "string_cstr") || eq(n, "string_literal") }
sizeof_base_cname = (n: string_view) string_view {
    eq(n, "i32").match ({
        true  => "int32_t",
        false => eq(n, "i64").match ({
            true  => "int64_t",
            false => eq(n, "u8").match ({
                true  => "uint8_t",
                false => eq(n, "f64").match ({
                    true  => "double",
                    false => eq(n, "bool").match ({
                        true  => "bool",
                        false => eq(n, "str").match ({
                            true  => "const char*",
                            false => eq(n, "Cstr").match ({
                                true  => "const char*",
                                false => eq(n, "text").match ({
                                    true  => "const char*",
                                    false => eq(n, "void").match ({ true => "void", false => n }),
                                }),
                            }),
                        }),
                    }),
                }),
            }),
        }),
    })
}
sizeof_cname = (n: string_view) string_view { n.sizeof_is_canonical_string().match ({
    true  => "const char*",
    false => n.sizeof_base_cname(),
}) }
// `sizeof(<type>)`: route a bare type-name Var through sizeof_cname; any other arg form emits as-is.
gen_sizeof = (s: String, alloc: MutPtr<Malloc>, c: CallData) String {
    out := s.gstr_append(alloc, "sizeof(")
    body := (c.args.len > 0).match ({
        true  => c.args[0].addr().match ({
            .Var(v) => out.gstr_append(alloc, sizeof_cname(v.name)),
            _       => out.gen_arg_at(alloc, c, 0),
        }),
        false => out.gstr_append(alloc, "0"),
    })
    body.gstr_append(alloc, ")")
}
call_kind = (name: string_view) EmitCallKind {
    kind := EmitCallKind.Normal
    eq(name, "__str_eq").then({
        kind = EmitCallKind.StrEq
    })
    eq(name, "__str_ne").then({
        kind = EmitCallKind.StrNe
    })
    eq(name, "load").then({
        kind = EmitCallKind.Load
    })
    eq(name, "offset").then({
        kind = EmitCallKind.Offset
    })
    eq(name, "store").then({
        kind = EmitCallKind.Store
    })
    eq(name, "load_i64").then({
        kind = EmitCallKind.LoadI64
    })
    eq(name, "store_i64").then({
        kind = EmitCallKind.StoreI64
    })
    eq(name, "atomic_add_i64").then({
        kind = EmitCallKind.AtomicAddI64
    })
    eq(name, "atomic_load_i64").then({
        kind = EmitCallKind.AtomicLoadI64
    })
    eq(name, "atomic_store_i64").then({
        kind = EmitCallKind.AtomicStoreI64
    })
    eq(name, "atomic_cas_i64").then({
        kind = EmitCallKind.AtomicCasI64
    })
    eq(name, "atomic_fence").then({
        kind = EmitCallKind.AtomicFence
    })
    eq(name, "addr").then({
        kind = EmitCallKind.Addr
    })
    eq(name, "assert_nonnull").then({
        kind = EmitCallKind.AssertNonnull
    })
    eq(name, "cstr").then({
        kind = EmitCallKind.CStr
    })
    eq(name, "slice").then({
        kind = EmitCallKind.Slice
    })
    eq(name, "null_ptr").then({
        kind = EmitCallKind.NullPtr
    })
    eq(name, "to_i32").then({
        kind = EmitCallKind.ToI32
    })
    eq(name, "to_i64").then({
        kind = EmitCallKind.ToI64
    })
    eq(name, "to_u8").then({
        kind = EmitCallKind.ToU8
    })
    eq(name, "to_f64").then({
        kind = EmitCallKind.ToF64
    })
    eq(name, "sizeof").then({
        kind = EmitCallKind.Sizeof
    })
    kind
}
// is this expression a C lvalue (so `&expr` is legal as-is)? Var/field/arrow/index and a `load`
// deref always are; everything else (a call result, literal, struct/enum value, …) is a temporary.
is_lvalue = (e: Ptr<Expr>) bool {
    e.match ({
        .Var(v)    => true,
        .Member(m) => is_lvalue(m.obj),
        .Arrow(a)  => true,
        .Index(ix) => true,
        .Call(c)   => eq(c.fn, "load"),
        _          => false,
    })
}
// `expr.addr()` → `&expr`. Taking the address of a TEMPORARY (e.g. `default().addr()`) is a cc
// "lvalue required" error, so for non-lvalues spill into a 1-element-array compound literal:
// `(__typeof__(e)[1]){ e }` copy-inits the whole value (works for scalars AND structs — a plain
// `(T){e}` would mis-init T's first FIELD with e), has the enclosing block's lifetime, and decays
// to a `T*` pointing at element 0 — exactly the wanted address. typeof's operand is unevaluated,
// so the inner expression runs exactly once (in the initializer).
gen_addr = (s: String, alloc: MutPtr<Malloc>, c: CallData) String {
    (c.args.len > 0 && is_lvalue(c.args[0].addr())).match ({
        true  => s.gstr_append(alloc, "(&(").gen_arg_at(alloc, c, 0).gstr_append(alloc, "))"),
        false => s.gstr_append(alloc, "((__typeof__(").gen_arg_at(alloc, c, 0).gstr_append(alloc, ")[1]){ ").gen_arg_at(alloc, c, 0).gstr_append(alloc, " })"),
    })
}
gen_call_default = (s: String, alloc: MutPtr<Malloc>, c: CallData) String { s.gstr_append(alloc, c.fn).gstr_append(alloc, "(").gen_args(alloc, c.args).gstr_append(alloc, ")") }
gen_call = (s: String, alloc: MutPtr<Malloc>, c: CallData) String {
    c.fn.call_kind().match ({
        .StrEq          => s.gstr_append(alloc, "eq(").gen_arg_at(alloc, c, 0).gstr_append(alloc, ", ").gen_arg_at(alloc, c, 1).gstr_append(alloc, ")"),
        .StrNe          => s.gstr_append(alloc, "(!eq(").gen_arg_at(alloc, c, 0).gstr_append(alloc, ", ").gen_arg_at(alloc, c, 1).gstr_append(alloc, "))"),
        .Load           => s.gstr_append(alloc, "(*(").gen_arg_at(alloc, c, 0).gstr_append(alloc, "))"),
        .Offset         => s.gstr_append(alloc, "((uint8_t*)(").gen_arg_at(alloc, c, 0).gstr_append(alloc, ") + (").gen_arg_at(alloc, c, 1).gstr_append(alloc, "))"),
        .Store          => s.gstr_append(alloc, "(*(").gen_arg_at(alloc, c, 0).gstr_append(alloc, ") = ").gen_arg_at(alloc, c, 1).gstr_append(alloc, ")"),
        .LoadI64        => s.gstr_append(alloc, "(*(int64_t*)(").gen_arg_at(alloc, c, 0).gstr_append(alloc, "))"),
        .StoreI64       => s.gstr_append(alloc, "(*(int64_t*)(").gen_arg_at(alloc, c, 0).gstr_append(alloc, ") = ").gen_arg_at(alloc, c, 1).gstr_append(alloc, ")"),
        .AtomicAddI64   => s.gstr_append(alloc, "__atomic_add_fetch((int64_t*)(").gen_arg_at(alloc, c, 0).gstr_append(alloc, "), (").gen_arg_at(alloc, c, 1).gstr_append(alloc, "), 5)"),
        .AtomicLoadI64  => s.gstr_append(alloc, "__atomic_load_n((int64_t*)(").gen_arg_at(alloc, c, 0).gstr_append(alloc, "), 5)"),
        .AtomicStoreI64 => s.gstr_append(alloc, "__atomic_store_n((int64_t*)(").gen_arg_at(alloc, c, 0).gstr_append(alloc, "), (").gen_arg_at(alloc, c, 1).gstr_append(alloc, "), 5)"),
        .AtomicCasI64   => s.gstr_append(alloc, "__atomic_compare_exchange_n((int64_t*)(").gen_arg_at(alloc, c, 0).gstr_append(alloc, "), &(int64_t){ ").gen_arg_at(alloc, c, 1).gstr_append(alloc, " }, (").gen_arg_at(alloc, c, 2).gstr_append(alloc, "), 0, 5, 5)"),
        .AtomicFence    => s.gstr_append(alloc, "__atomic_thread_fence(5)"),
        .Addr           => s.gen_addr(alloc, c),
        // Stage 3 null guard: panics if the RawPtr is null, else yields it unchanged (preserving its T*).
        .AssertNonnull  => s.gstr_append(alloc, "({ __typeof__(").gen_arg_at(alloc, c, 0).gstr_append(alloc, ") _znn = (").gen_arg_at(alloc, c, 0).gstr_append(alloc, "); if(!_znn){ zen__panic(\"zen: panic: null pointer deref\\n\"); } _znn; })"),
        .CStr           => s.gstr_append(alloc, "((const char*)(").gen_arg_at(alloc, c, 0).gstr_append(alloc, "))"),
        .Slice          => s.gstr_append(alloc, "(zslice){ .ptr = (void*)(").gen_arg_at(alloc, c, 0).gstr_append(alloc, "), .len = (").gen_arg_at(alloc, c, 1).gstr_append(alloc, ") }"),
        .NullPtr        => s.gstr_append(alloc, "0"),
        .ToI32          => s.gstr_append(alloc, "((int32_t)(").gen_arg_at(alloc, c, 0).gstr_append(alloc, "))"),
        .ToI64          => s.gstr_append(alloc, "((int64_t)(").gen_arg_at(alloc, c, 0).gstr_append(alloc, "))"),
        .ToU8           => s.gstr_append(alloc, "((uint8_t)(").gen_arg_at(alloc, c, 0).gstr_append(alloc, "))"),
        .ToF64          => s.gstr_append(alloc, "((double)(").gen_arg_at(alloc, c, 0).gstr_append(alloc, "))"),
        .Sizeof         => s.gen_sizeof(alloc, c),
        .Normal         => s.gen_call_default(alloc, c),
    })
}
// a call's argument list, comma-separated: `a, b, c` (each arg is an Expr value -> addr it)
gen_args = (s: String, alloc: MutPtr<Malloc>, args: [Expr]) String {
    out := s
    args.loop((h, i, arg) {
        out = (i == 0).match ({ true => out, false => out.gstr_append(alloc, ", ") })    // comma between, not before
        out = out.gen_expr(alloc, arg.addr())
    })
    out
}
// the same args as space-separated s-expr operands: ` a b c`
gen_sargs = (s: String, alloc: MutPtr<Malloc>, args: [Expr]) String {
    out := s
    args.loop((h, i, arg) {
        out = out.gstr_append(alloc, " ").gen_sexpr(alloc, arg.addr())
    })
    out
}
// render an expression as a PREFIX s-expression — `(* (+ 1 2) 3)` — a backend-neutral,
// structural form, so a parser's tree can be diffed against another parser's (parity).
gen_sexpr* = (s: String, alloc: MutPtr<Malloc>, e: Ptr<Expr>) String {
    e.match ({
        .Int(n)       => s.gstr_int(alloc, n),
        .Byte(n)      => s.gstr_int(alloc, n),
        .FloatLit(ft) => s.gstr_append(alloc, ft),
        .Var(v)       => s.gstr_append(alloc, v.name),
        .Bin(b)       => s.gstr_append(alloc, "(").gstr_append(alloc, b.op).gstr_append(alloc, " ").gen_sexpr(alloc, b.lhs).gstr_append(alloc, " ").gen_sexpr(alloc, b.rhs).gstr_append(alloc, ")"),
        .Call(c)      => c.raw.match ({
            true  => s.gstr_append(alloc, "(@").gstr_append(alloc, c.fn).gen_sargs(alloc, c.args).gstr_append(alloc, ")"),
            false => s.gstr_append(alloc, "(").gstr_append(alloc, c.fn).gen_sargs(alloc, c.args).gstr_append(alloc, ")"),
        }),
        .Lambda(lm)   => s.gen_lam_sexpr(alloc, lm),
        // NEVER emit a literal `?` placeholder — a silent drop that becomes invalid output. Fail loudly
        // on any expression kind this renderer doesn't handle so the gap surfaces instead of slipping through.
        _             => {
            panic("zenc: gen_sexpr: unsupported expression kind in s-expression rendering")
            s
        },
    })
}
// `(lambda a x)` — names only (enough to prove a lambda parsed; its body rides the run tests)
gen_lam_sexpr = (s: String, alloc: MutPtr<Malloc>, lm: LambdaData) String {
    out := s.gstr_append(alloc, "(lambda")
    lm.params.loop((h, i, p) {
        out = out.gstr_append(alloc, " ").gstr_append(alloc, p.name)
    })
    out.gstr_append(alloc, ")")
}
gen_cond = (s: String, alloc: MutPtr<Malloc>, d: CondData) String {
    (blk_diverges(d.t) || blk_diverges(d.e)).match ({
        true  => s.gen_cond_div(alloc, d),
        false => s.gstr_append(alloc, "(").gen_expr(alloc, d.c).gstr_append(alloc, " ? ").gen_expr(alloc, d.t).gstr_append(alloc, " : ").gen_expr(alloc, d.e).gstr_append(alloc, ")"),
    })
}
// A value cond with a DIVERGING branch (its block ends in `return`) cannot be a `?:` — a void arm in
// a conditional expression is invalid C, and the return must actually fire. Emit a statement-expr:
// the non-diverging branch assigns `_out` (typed from it, unevaluated via __typeof__); the diverging
// branch runs as statements and leaves the function. Both diverging → `_out` is a dead int.
gen_cond_branch_div = (s: String, alloc: MutPtr<Malloc>, e: Ptr<Expr>) String {
    blk_diverges(e).match ({
        true  => s.gstr_append(alloc, "{ ").gen_expr(alloc, e).gstr_append(alloc, "; }"),
        false => s.gstr_append(alloc, "{ _out = ").gen_expr(alloc, e).gstr_append(alloc, "; }"),
    })
}
gen_cond_div_ty = (s: String, alloc: MutPtr<Malloc>, d: CondData) String {
    blk_diverges(d.t).match ({
        true  => blk_diverges(d.e).match ({
            true  => s.gstr_append(alloc, "0"),
            false => s.gen_expr(alloc, d.e),
        }),
        false => s.gen_expr(alloc, d.t),
    })
}
gen_cond_div = (s: String, alloc: MutPtr<Malloc>, d: CondData) String { s.gstr_append(alloc, "({ __typeof__(").gen_cond_div_ty(alloc, d).gstr_append(alloc, ") _out; if (").gen_expr(alloc, d.c).gstr_append(alloc, ") ").gen_cond_branch_div(alloc, d.t).gstr_append(alloc, " else ").gen_cond_branch_div(alloc, d.e).gstr_append(alloc, " _out; })") }
gen_mkenum = (s: String, alloc: MutPtr<Malloc>, m: MakeEnumData) String {
    head := s.gstr_append(alloc, "(").gstr_append(alloc, m.mty).gstr_append(alloc, "){ .tag = ").gstr_append(alloc, m.mty).gstr_append(alloc, "_").gstr_append(alloc, m.variant)
    head.gstr_append(alloc, ", .u.").gstr_append(alloc, m.variant).gstr_append(alloc, " = ").gen_expr(alloc, m.payload).gstr_append(alloc, " }")
}
// a struct literal: `(T){ .a = …, .b = … }` (a C compound literal, designated initializers)
gen_mkstruct = (s: String, alloc: MutPtr<Malloc>, m: MakeStructData) String {
    out := s.gstr_append(alloc, "(").gstr_append(alloc, m.mty).gstr_append(alloc, "){ ")
    m.inits.loop((h, i, fi) {
        out = (i == 0).match ({ true => out, false => out.gstr_append(alloc, ", ") })    // mty = the monomorphized name for a generic literal
        // comma between, not before
        out = out.gstr_append(alloc, ".").gstr_append(alloc, fi.name).gstr_append(alloc, " = ").gen_expr(alloc, fi.value)
    })
    out.gstr_append(alloc, " }")
}
// an arm's body: bind the payload (GCC __auto_type, so no payload type needed here), then the body
gen_armbind = (s: String, alloc: MutPtr<Malloc>, subj: string_view, sep: string_view, a: ArmData) String { s.gstr_append(alloc, "({ __auto_type ").gstr_append(alloc, a.bind).gstr_append(alloc, " = ").gstr_append(alloc, subj).gstr_append(alloc, sep).gstr_append(alloc, "u.").gstr_append(alloc, a.variant).gstr_append(alloc, "; ").gen_expr(alloc, a.body).gstr_append(alloc, "; })") }
gen_armbody = (s: String, alloc: MutPtr<Malloc>, subj: string_view, sep: string_view, a: ArmData) String {
    is_empty(a.bind).match ({
        true  => s.gstr_append(alloc, "(").gen_expr(alloc, a.body).gstr_append(alloc, ")"),
        false => s.gen_armbind(alloc, subj, sep, a),
    })
}
// Statement matches must keep recursively-discarded arm bodies in statement context. Otherwise a
// nested void match is lowered by gen_match as a value and attempts to declare an impossible `void _out`.
gen_armbind_stmt = (s: String, alloc: MutPtr<Malloc>, subj: string_view, sep: string_view, a: ArmData) String { s.gstr_append(alloc, "{ __auto_type ").gstr_append(alloc, a.bind).gstr_append(alloc, " = ").gstr_append(alloc, subj).gstr_append(alloc, sep).gstr_append(alloc, "u.").gstr_append(alloc, a.variant).gstr_append(alloc, "; ").gen_expr_stmt(alloc, a.body).gstr_append(alloc, " }") }
gen_armbody_stmt = (s: String, alloc: MutPtr<Malloc>, subj: string_view, sep: string_view, a: ArmData) String {
    is_empty(a.bind).match ({
        true  => s.gen_expr_stmt(alloc, a.body),
        false => s.gen_armbind_stmt(alloc, subj, sep, a),
    })
}
// Type every arm through C's conditional operator so array arms decay, numeric arms widen, and exact
// struct/scalar arms keep their type. __typeof__ evaluates none of these arm expressions. DIVERGING
// arms (body ends in `return`) yield no value: they are skipped here (their block would type void and
// poison the chain) and emitted as statements in gen_switch_body. All arms diverging → dead int _out.
next_live_arm = (arms: [ArmData], i: i64) i64 {
    (i >= arms.len).match ({
        true  => arms.len,
        false => arms[i].body.blk_diverges().match ({
            true  => arms.next_live_arm(i + 1),
            false => i,
        }),
    })
}
gen_match_type_expr = (s: String, alloc: MutPtr<Malloc>, subj: string_view, sep: string_view, arms: [ArmData], i: i64) String {
    j := arms.next_live_arm(i)
    (j >= arms.len).match ({
        true  => s.gstr_append(alloc, "0"),
        false => (arms.next_live_arm(j + 1) >= arms.len).match ({
            true  => s.gstr_append(alloc, "(1 ? ").gen_armbody(alloc, subj, sep, arms[j]).gstr_append(alloc, " : ").gen_armbody(alloc, subj, sep, arms[j]).gstr_append(alloc, ")"),
            false => s.gstr_append(alloc, "(1 ? ").gen_armbody(alloc, subj, sep, arms[j]).gstr_append(alloc, " : ").gen_match_type_expr(alloc, subj, sep, arms, j + 1).gstr_append(alloc, ")"),
        }),
    })
}
gen_match_out_decl = (s: String, alloc: MutPtr<Malloc>, subj: string_view, sep: string_view, arms: [ArmData]) String { s.gstr_append(alloc, "__typeof__(").gen_match_type_expr(alloc, subj, sep, arms, 0).gstr_append(alloc, ") _out; ") }
// a diverging arm's body runs for CONTROL FLOW only (its trailing `return` leaves the function) —
// no `_out` assignment (its statement-expr would be void).
gen_switch_body = (s: String, alloc: MutPtr<Malloc>, subj: string_view, sep: string_view, a: ArmData) String {
    a.body.blk_diverges().match ({
        true  => s.gen_switch_stmt_body(alloc, subj, sep, a),
        false => s.gstr_append(alloc, "{ _out = ").gen_armbody(alloc, subj, sep, a).gstr_append(alloc, "; break; } "),
    })
}
gen_switch_stmt_body = (s: String, alloc: MutPtr<Malloc>, subj: string_view, sep: string_view, a: ArmData) String { s.gstr_append(alloc, "{ ").gen_armbody_stmt(alloc, subj, sep, a).gstr_append(alloc, " break; } ") }
gen_switch_case = (s: String, alloc: MutPtr<Malloc>, subj: string_view, sep: string_view, ename: string_view, a: ArmData) String { s.gstr_append(alloc, "case ").gstr_append(alloc, ename).gstr_append(alloc, "_").gstr_append(alloc, a.variant).gstr_append(alloc, ": ").gen_switch_body(alloc, subj, sep, a) }
gen_switch_default = (s: String, alloc: MutPtr<Malloc>, subj: string_view, sep: string_view, a: ArmData) String { s.gstr_append(alloc, "default: ").gen_switch_body(alloc, subj, sep, a) }
gen_switch_stmt_case = (s: String, alloc: MutPtr<Malloc>, subj: string_view, sep: string_view, ename: string_view, a: ArmData) String { s.gstr_append(alloc, "case ").gstr_append(alloc, ename).gstr_append(alloc, "_").gstr_append(alloc, a.variant).gstr_append(alloc, ": ").gen_switch_stmt_body(alloc, subj, sep, a) }
gen_switch_stmt_default = (s: String, alloc: MutPtr<Malloc>, subj: string_view, sep: string_view, a: ArmData) String { s.gstr_append(alloc, "default: ").gen_switch_stmt_body(alloc, subj, sep, a) }
// A match with no explicit `_` arm was proved exhaustive by the CHECKER; the emitter must not silently
// re-route stray tags into the last arm's body (the old last-arm-as-`default:` trick — the #377 class
// of silent miscompiles). Every arm gets its own `case`, and `default:` traps: a tag outside the listed
// variants at runtime means the checker and emitter disagree. zen__panic diverges (write + abort), so
// value-position `_out` is never read on this path.
gen_switch_panic_default = (s: String, alloc: MutPtr<Malloc>) String { s.gstr_append(alloc, "default: zen__panic(\"zen: panic: non-exhaustive match — checker/emitter disagreement\\n\"); ") }
gen_switch_arm = (s: String, alloc: MutPtr<Malloc>, subj: string_view, sep: string_view, ename: string_view, a: ArmData, last: bool) String {
    eq(a.variant, "_").match ({
        true  => s.gen_switch_default(alloc, subj, sep, a),
        false => {
            out := s.gen_switch_case(alloc, subj, sep, ename, a)
            last.match ({ true => out.gen_switch_panic_default(alloc), false => out })
        },
    })
}
gen_switch_stmt_arm = (s: String, alloc: MutPtr<Malloc>, subj: string_view, sep: string_view, ename: string_view, a: ArmData, last: bool) String {
    eq(a.variant, "_").match ({
        true  => s.gen_switch_stmt_default(alloc, subj, sep, a),
        false => {
            out := s.gen_switch_stmt_case(alloc, subj, sep, ename, a)
            last.match ({ true => out.gen_switch_panic_default(alloc), false => out })
        },
    })
}
gen_switch_arms = (s: String, alloc: MutPtr<Malloc>, subj: string_view, sep: string_view, ename: string_view, arms: [ArmData], i: i64) String {
    (i >= arms.len).match ({
        true  => s,
        false => {
            out := s.gen_switch_arm(alloc, subj, sep, ename, arms[i], i == arms.len - 1)
            eq(arms[i].variant, "_").match ({
                true  => out,
                false => out.gen_switch_arms(alloc, subj, sep, ename, arms, i + 1),
            })
        },
    })
}
gen_switch_stmt_arms = (s: String, alloc: MutPtr<Malloc>, subj: string_view, sep: string_view, ename: string_view, arms: [ArmData], i: i64) String {
    (i >= arms.len).match ({
        true  => s,
        false => {
            out := s.gen_switch_stmt_arm(alloc, subj, sep, ename, arms[i], i == arms.len - 1)
            eq(arms[i].variant, "_").match ({
                true  => out,
                false => out.gen_switch_stmt_arms(alloc, subj, sep, ename, arms, i + 1),
            })
        },
    })
}
// the subject can be any expression, so bind it once to a temp. Enum matches emit as a switch inside a
// GCC statement-expression; `__typeof__(first_arm)` gives us the result type without evaluating an arm.
gen_match = (s: String, alloc: MutPtr<Malloc>, m: MatchData) String {
    sep := m.ptr.match ({ true => "->", false => "." })
    s.gstr_append(alloc, "({ __auto_type _subj = ").gen_expr(alloc, m.subj).gstr_append(alloc, "; ").gen_match_out_decl(alloc, "_subj", sep, m.arms).gstr_append(alloc, "switch (_subj").gstr_append(alloc, sep).gstr_append(alloc, "tag) { ").gen_switch_arms(alloc, "_subj", sep, m.ename, m.arms, 0).gstr_append(alloc, "} _out; })")
}
gen_match_stmt = (s: String, alloc: MutPtr<Malloc>, m: MatchData) String {
    sep := m.ptr.match ({ true => "->", false => "." })
    s.gstr_append(alloc, "{ __auto_type _subj = ").gen_expr(alloc, m.subj).gstr_append(alloc, "; switch (_subj").gstr_append(alloc, sep).gstr_append(alloc, "tag) { ").gen_switch_stmt_arms(alloc, "_subj", sep, m.ename, m.arms, 0).gstr_append(alloc, "} }")
}
// ── emit a statement, a block, a parameter list, a function, a struct, a decl ─
gen_expr_stmt = (s: String, alloc: MutPtr<Malloc>, e: Ptr<Expr>) String {
    e.match ({
        .Match(m) => s.gen_match_stmt(alloc, m),
        .Cond(d)  => s.gen_cond_stmt(alloc, d),
        .Block(b) => s.gen_block(alloc, b.stmts),
        _         => s.gen_expr(alloc, e).gstr_append(alloc, ";"),
    })
}
// A discarded boolean match has no common result type requirement. Emit it as control flow and keep
// both branches in statement context; this matters when one branch is a loop jump and the other is an
// assignment (their expression values deliberately have unrelated C types).
gen_cond_stmt = (s: String, alloc: MutPtr<Malloc>, d: CondData) String { s.gstr_append(alloc, "if (").gen_expr(alloc, d.c).gstr_append(alloc, ") { ").gen_expr_stmt(alloc, d.t).gstr_append(alloc, " } else { ").gen_expr_stmt(alloc, d.e).gstr_append(alloc, " }") }
gen_void_return = (s: String, alloc: MutPtr<Malloc>, e: Ptr<Expr>) String {
    e.match ({
        .Match(m) => s.gen_match_stmt(alloc, m).gstr_append(alloc, " return;"),
        _         => s.gen_expr(alloc, e).gstr_append(alloc, "; return;"),
    })
}
gen_stmt = (s: String, alloc: MutPtr<Malloc>, st: Stmt) String {
    st.match ({
        .Let(l)      => l.ty.match ({
            .Void => s.gstr_append(alloc, "__auto_type ").gstr_append(alloc, l.name).gstr_append(alloc, " = ").gen_expr(alloc, l.value).gstr_append(alloc, ";"),
            _     => s.gstr_append(alloc, alloc.ty_cname_in(l.ty)).gstr_append(alloc, " ").gstr_append(alloc, l.name).gstr_append(alloc, " = ").gen_expr(alloc, l.value).gstr_append(alloc, ";"),
        }),    // an annotation emits the REAL C type (an `a: i64 := 0` accumulator IS int64_t); .Void = unannotated (no cross-layer is_void_ty here)
        .Assign(a)   => s.gen_expr(alloc, a.target).gstr_append(alloc, " = ").gen_expr(alloc, a.value).gstr_append(alloc, ";"),    // <lvalue> = value;
        .Return(e)   => s.gstr_append(alloc, "return ").gen_expr(alloc, e).gstr_append(alloc, ";"),
        .ExprStmt(e) => s.gen_expr_stmt(alloc, e),
        .If(f)       => s.gen_if(alloc, f),
        .While(w)    => s.gstr_append(alloc, "while (").gen_expr(alloc, w.c).gstr_append(alloc, ") ").gen_block(alloc, w.body),
        .IndexSet(x) => s.gstr_append(alloc, "(*(").gstr_append(alloc, alloc.ty_cname_in(x.elem)).gstr_append(alloc, "*)zen__idx(").gen_expr(alloc, x.seq).gstr_append(alloc, ", ").gen_expr(alloc, x.idx).gstr_append(alloc, ", sizeof(").gstr_append(alloc, alloc.ty_cname_in(x.elem)).gstr_append(alloc, "))) = ").gen_expr(alloc, x.value).gstr_append(alloc, ";"),
    })
}
gen_stmt_effect = (s: String, alloc: MutPtr<Malloc>, st: Stmt) String {
    st.match ({
        .ExprStmt(e) => s.gen_expr_stmt(alloc, e),
        _            => s.gen_stmt(alloc, st),
    })
}
gen_stmt_void = (s: String, alloc: MutPtr<Malloc>, st: Stmt) String {
    st.match ({
        .Return(e) => s.gen_void_return(alloc, e),
        _          => s.gen_stmt_effect(alloc, st),
    })
}
// emit a brace-wrapped block: `{ s1; s2; … }`
gen_block* = (s: String, alloc: MutPtr<Malloc>, body: [Stmt]) String {
    open := s.gstr_append(alloc, "{ ")
    body.loop((h, i, st) {
        open = open.gen_stmt_effect(alloc, st).gstr_append(alloc, " ")
    })
    open.gstr_append(alloc, "}")
}
gen_block_void* = (s: String, alloc: MutPtr<Malloc>, body: [Stmt]) String {
    open := s.gstr_append(alloc, "{ ")
    body.loop((h, i, st) {
        open = open.gen_stmt_void(alloc, st).gstr_append(alloc, " ")
    })
    open.gstr_append(alloc, "}")
}
gen_if = (s: String, alloc: MutPtr<Malloc>, f: IfData) String { s.gstr_append(alloc, "if (").gen_expr(alloc, f.c).gstr_append(alloc, ") ").gen_block(alloc, f.then).gstr_append(alloc, " else ").gen_block(alloc, f.els) }
