// fmt-gate: comments interior to a boolean `.match` stay put — a trailing comment on the `.match ({`
// opening line stays there, an own-line comment ABOVE an arm stays above THAT arm (never hoisted into a
// neighbour's block or dropped past `})`), a trailing comment on a non-last arm stays on that arm's line,
// and a comment inside a nested arm block stays inside it.
{ println } = std.text.fmt
classify = (n: i32) i32 {
(n > 0).match ({    // sign check
// positive branch
true => 1,    // exactly one
// non-positive branch
false => {
// inside the non-positive block
println("np")
0
},
})
}
main = () i32 {
classify(3)
}
