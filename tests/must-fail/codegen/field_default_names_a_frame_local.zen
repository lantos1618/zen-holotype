// A FIELD DEFAULT NAMING A FRAME LOCAL — STILL REFUSED after #734's fix,
// and the refusal is the whole test.
//
// The fix gave `is_pure_value` a `Name` arm so a default may name a bare
// nullary variant (or a module constant). Its own gate answers a name that
// resolves to a FRAME SLOT with `false`: the default is emitted at every
// construction site, in the DECLARING module's context, and no site is in
// this frame. This test pins that boundary so widening the arm further
// cannot silently admit frame reads.
//
// Differential evidence (verify lane 734): base 91560cdf refuses this
// identically, so the fix moved exactly the names it claimed and nothing
// else. Position: the default expression, not the member and not the
// struct — same convention as field_default_that_calls_a_function.
//
// position: the default expression.

Shade = Red | Green | Blue

Bad = {
    m*: i32,
    t* :: Shade = x,
}

main = (env: Env) Res<i32, AllocError> {
    x: Shade = Green;
    b = Bad(m: 1);
    b.t.match({ Green => println("green"), _ => println("other") });
    Ok(0);
}
