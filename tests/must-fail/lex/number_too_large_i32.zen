// two literals past i32.MAX, and neither has a unary minus in front of it to
// make it i32.MIN.
//
// 4000000000 is the second one for a reason: it is inside u32, so a bound
// check wired to the wrong type accepts it while still rejecting
// 2147483648. `ok` on the first line plus `.count 2` pins the bound at
// exactly i32.MAX rather than merely "somewhere".
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    ok: i32 = 2147483647;
    bad: i32 = 2147483648;
    wide: i32 = 4000000000;
    println("{} {} {}", ok, bad, wide);
    Ok(0);
}
