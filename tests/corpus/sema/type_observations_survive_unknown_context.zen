Ast, Type, TypeKind, nowhere, no_trivia = std.ast
Checker, Ctx = sema.sema_check
type_from_ast = sema.sema_denote

main = (env: Env) Res<i32, AllocError> {
    a    ::= env.mem.alloc();
    tree ::= a.Ast();
    id = tree.add_type(Type(
        kind: TypeKind.SelfType,
        span: nowhere(),
        leading: no_trivia(),
        trailing: no_trivia()
    )).try();
    checker ::= a.Checker(tree).try();
    unknown = checker.types.unknown().try();
    no_self = Ctx(0, unknown);
    first   = checker.type_from_ast(id, no_self).try();
    println(
        "before {} {}",
        checker.is_unknown(first),
        checker.type_was_resolved(id)
    );
    known     = checker.types.prim("i32").try();
    with_self = Ctx(
        module: 0,
        ret: unknown,
        has_ret: false,
        self_ty: known,
        has_self: true
    );
    second    = checker.type_from_ast(id, with_self).try();
    println(
        "resolved {} {}",
        checker.is_unknown(second),
        checker.type_was_resolved(id)
    );
    third = checker.type_from_ast(id, no_self).try();
    println(
        "after {} {}",
        checker.is_unknown(third),
        checker.type_was_resolved(id)
    );
    Ok(0)
}
