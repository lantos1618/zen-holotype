// A CONSTANT'S VALUE OWES ITS WRITTEN TYPE AT MODULE LEVEL TOO -- the
// last declaration kind whose body nobody walked. `check_decl` matched
// the four kinds that own bodies and a `Const` fell through the
// wildcard: not typed in its declaring module, and with nothing asking
// whether the value fits the type beside it. The same sentence as a
// local binding (`b: u32 = -1;`) was always refused at
// `sema_place.check_assign`, so the defect is exactly the declaration
// boundary, which is what makes the module-level case the interesting
// one.
//
// THE WRONG ANSWER WAS A PRINTED ONE: `UMINUS: u32 = -1` compiled clean
// and read back 18446744073709551615 -- two's complement through the
// u32 slot, plausible-looking and silently false.
//
// position: the `-`, not the digits -- the negation is what makes the
// literal one a u32 cannot hold.

UMINUS: u32 = -1

main = (env: Env) Res<i32, AllocError> {
    println("{}", UMINUS.to_i64());
    Ok(0);
}
