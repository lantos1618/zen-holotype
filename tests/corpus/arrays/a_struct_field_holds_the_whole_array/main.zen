// A STRUCT FIELD HOLDS A WHOLE FIXED ARRAY AT ITS OWN OFFSET.
//
// Nesting the other way round from an array of structs: the STRUCT owns
// the storage, the array is a field, and the layout has to place it AFTER
// whatever precedes it while the literal initialiser reaches through the
// member name (`zg_elems`, the one constant every array consumer in
// gen_c/gen_c_array.zen must spell alike).
//
// Two ways to get this wrong, both silent: lay the array field out at
// offset zero and the literal STOMPS `tag`; build the elements into a
// temporary and copy the wrong span and the cells read as defaults — the
// zero-field rot this corpus exists to keep visible. `tag` sits FIRST
// with a non-zero value precisely so a stomp and a skip print differently:
// a stomp loses the 99, a skip prints zeros for the cells, and neither
// can produce "99 5 7 9".

Cell = { v: i32 }

Grid = {
    tag: i32,
    cells: [Cell, 3],
}

main = (env: Env) Res<i32, AllocError> {
    g = Grid(tag: 99, cells: [Cell(v: 5), Cell(v: 7), Cell(v: 9)]);
    println("{} {} {} {}", g.tag, g.cells[0].v, g.cells[1].v, g.cells[2].v);
    Ok(0);
}
