// tests/corpus/std/loop_find_missing_is_none.zen
// nothing matches: find is Res<T>, so the miss is None. it does
// not allocate and it does not trap

main = (env: Env) Res<i32, AllocError> {
    Range(0, 10).find((value) {
        value > 99
    }).match({
        Ok(n) => println("found {}", n),
        None  => println("none"),
    })
    Ok(0);
}
