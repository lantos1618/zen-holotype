// Omitting the free function's final Res argument produces exactly the method
// signature, so a two-argument call cannot select one declaration.

W = {
    mix = (self: @Self, value: i32) i32 { 1 }
}

mix = (w: W, value: i32, label: Res<str>) i32 { 2 }

main = (env: Env) Res<i32, AllocError> { Ok(0) }
