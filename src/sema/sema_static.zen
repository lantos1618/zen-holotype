// src/sema/sema_static.zen
// `Type.NAME` — what a type's own name reaches, and what it still owes.
//
// SPLIT FROM `sema_member.zen` (what a dot reaches on a VALUE, via a
// receiver/impl/bound/`Found`): a variant, primitive constant, or
// module member here comes from the DECLARATION alone — this was the
// half of that 800-line file never about a dot.
//
// TWO ENTRIES: `static_access` is `Type.NAME` as a call's callee —
// `Slot.Left(cell)` resolves through it, a payload-carrying variant
// answering with the FUNCTION that builds one. `static_value` is the
// same access standing alone, wanting a value with no argument list. A
// union's member is complete in the first position, incomplete in the
// second, so the rule can't live in the shared half: refusing in
// `variant_type` would reject every legitimate construction.

Expr, ExprId, Access = std.ast
AllocError = std.mem
Vec = std.collections
str = std.text
// `Types` is imported for the STORE, not a name used below: the
// bootstrapper resolves `c.types.fn_ty(..)` only when the field's type
// is in scope, so dropping it as "unused" reddens
// `overload_resolution_reads_the_signature`.
TyId = sema.sema_ty
is_integer, is_float = sema.sema_ty
SemaFault, TypeFault = sema.sema_diag
Checker, Ctx = sema.sema_check
Case, cases_of, find_case = sema.sema_case
is_case = sema.sema_match
module_named_by, module_access = sema.sema_module
value_access = sema.sema_member
union_carrier = sema.sema_union

// `Error.IoError` written where a value goes. Every union member
// carries a value of the type it names (that's what `A | B` means), so
// a bare member is a tag beside bytes nobody wrote — nothing to hand
// back.
//
// Asked here and not in `variant_type`, since a union member IS
// constructible: `Error.IoError(e)` reaches `static_access` below
// without passing through this function, and a rule one step earlier
// would reject every `Ok(..)`, `Err(..)` and enum construction.
//
// A nominal enum's payload variant differs: `Slot.Left` names a
// function, a function is a value, so `union_carrier` poisons for it
// and the access falls straight through.
static_value* = (
    c    :: Checker,
    id   : ExprId,
    node : Expr,
    ac   : Access,
    ty   : TyId,
    ctx  : Ctx
) Res<TyId, AllocError> {
    carried = union_carrier(c, ty, ac.name.text).try();
    c.is_unknown(carried).match({
        true  => static_access(c, id, node, ac, ty, ctx),
        false => needs_value(c, node, ac, ty, carried),
    })
}

// The smallest offending node is the access, so `node.span` and not the
// name after the dot: `IoError` alone isn't the mistake — reading it
// off `Error` without a value is — and not the enclosing `Err(..)`
// either, which is written correctly.
needs_value = (
    c       :: Checker,
    node    : Expr,
    ac      : Access,
    ty      : TyId,
    carried : TyId
) Res<TyId, AllocError> {
    c.report(
        node.span.file,
        node.span,
        SemaFault.MemberNeedsValue(TypeFault(
            name: ac.name.text,
            expected: carried,
            found: ty
        ))
    ).try();
    c.types.unknown()
}

// A variant, or a constant on a type. "That access form already exists —
// `Shape.Unit`, `Os.Macos` — so this adds a spelling, not a concept."
//
// A module is asked first since it isn't a type at all: `sh = shape`
// binds a name whose base has no members, variants or constants, and
// every question below would uselessly answer "no such field".
static_access* = (
    c    :: Checker,
    id   : ExprId,
    node : Expr,
    ac   : Access,
    ty   : TyId,
    ctx  : Ctx
) Res<TyId, AllocError> {
    module_named_by(c, ty).match({
        Ok(mi) => module_access(c, node, ac, mi),
        None   => type_access(c, id, node, ac, ty, ctx),
    })
}

type_access = (
    c    :: Checker,
    id   : ExprId,
    node : Expr,
    ac   : Access,
    ty   : TyId,
    ctx  : Ctx
) Res<TyId, AllocError> {
    is_case(c, ty, ac.name.text).try().match({
        true  => variant_type(c, ty, ac.name.text),
        false => static_member(c, id, node, ac, ty, ctx),
    })
}

// A nullary variant IS a value of the enum; one carrying a payload is
// the function that builds one — what makes `Slot.Left(cell)` an
// ordinary call, not a second construction form.
variant_type* = (c :: Checker, ty: TyId, name: str) Res<TyId, AllocError> {
    cases ::= c.alloc.Vec<Case>();
    cases_of(c, ty, cases).try();
    find_case(cases, name).match({
        None   => c.types.unknown(),
        Ok(cs) => variant_value(c, ty, cs),
    })
}

variant_value = (c :: Checker, ty: TyId, cs: Case) Res<TyId, AllocError> {
    cs.has_payload.match({
        true  => variant_ctor(c, ty, cs),
        false => Ok(ty),
    })
}

variant_ctor = (c :: Checker, ty: TyId, cs: Case) Res<TyId, AllocError> {
    params ::= c.alloc.Vec<TyId>();
    params.add(cs.payload).try();
    c.types.fn_ty(params, ty)
}

// `i32.MAX`, `i32.BITS`. Anything else falls through to the ordinary
// member table, because a struct body may bind a constant too.
static_member = (
    c    :: Checker,
    id   : ExprId,
    node : Expr,
    ac   : Access,
    ty   : TyId,
    ctx  : Ctx
) Res<TyId, AllocError> {
    has_prim_const(c, ty, ac.name.text).match({
        true  => prim_const_type(c, ty, ac.name.text),
        false => value_access(c, id, node, ac, ty, ctx),
    })
}

// Every primitive numeric type carries MIN, MAX, and BITS from the
// prelude. MIN and MAX are of the type; BITS is a count, so `usize`.
has_prim_const = (c: Checker, ty: TyId, name: str) bool {
    numeric_prim(c, ty) && name.is_in(["MIN", "MAX", "BITS"])
}

prim_const_type = (c :: Checker, ty: TyId, name: str)
                  Res<TyId, AllocError> {
    name.eq("BITS").match({
        true  => c.types.prim("usize"),
        false => Ok(ty),
    })
}

numeric_prim = (c: Checker, ty: TyId) bool {
    name = c.prim_name(ty);
    is_integer(name) || is_float(name)
}
