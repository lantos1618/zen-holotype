// fmt round-trip carrier for the WRAPPED IMPORT LIST shape: a >100-column import greedy-filled
// across continuation lines. The fmt_roundtrip corpus asserts one-shot idempotence per file (fmt
// then immediate fmt --check), so this fixture keeps the canonical wrap locked — any printer change
// that makes import rewrapping depend on the CURRENT line breaks instead of reflowing from the flat
// name list (the #618 disease family) turns this file dirty and fails the corpus.
{ open, read, write, close, lseek, system, unlink, access, mkdir, rmdir, rename, opendir, readdir,
  rewinddir, closedir, getpid, isatty, calloc, memcpy, strlen, strcmp, getenv, clock_gettime, popen,
  pclose, fgets, abort } = std.c.libc
main = () i32 { (getpid() > 0).then({ 0 }, { 1 }) }
