// 160 nested blocks.
//
// C11 §5.2.4.1's minimum for nesting levels of compound statements is 127,
// so 160 is past it. More to the point, every block in Zen is a VALUE —
// `@scope` is the enclosing block, and each block owns its own defer stack
// (DESIGN.md § Control flow) — so nesting blocks is not free the way it is
// in C: if gen_c emits scope bookkeeping per block, this file emits it 160
// times, and if it emits a C block per Zen block, the C compiler's own
// nesting limit is the one being tested.
//
// no defers are registered here. That keeps this a pure nesting test; the
// LIFO-before-drops ordering is an ownership test (TESTING.md § Ownership)
// and belongs to stage 3.
//
// the inner blocks write an outer mutable binding, so the count is
// observable: if a scope is emitted wrong, `depth` is wrong or the file
// does not compile.

main = (env: Env) Res<i32, AllocError> {
    depth ::= 0;
    { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; { depth = depth + 1; }}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}
    println("blocks {}", depth);
    Ok(0);
}
