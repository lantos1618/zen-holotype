// Actor identity and mailbox results. This module deliberately has no Env or
// allocator dependency; std.env imports it to declare Env.spawn.

ActorError* = Closed | Full
ActorStartError* = OutOfMemory | Unavailable

// An address to A. Behavior calls enqueue copied messages; only the worker
// enters actor state.
Ref*<A> = {
    id: u64,

    // Close admission, drain accepted messages, then run stopped.
    stop* = (self: @Self) ()
}

// Marker for spawnable state. An impl may supply optional started/stopped
// lifecycle methods and behavior methods; their Context comes from the public
// actor surface, not this dependency-free core module.
Actor* = {}
