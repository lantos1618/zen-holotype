// The same mistake with nothing after it, which is the shape no other
// check can see. A binder covers every value, so the match IS exhaustive
// and no arm is unreachable — the old compiler accepted this, ran it,
// and printed "at the limit" for 99. A corpus test is a valid program,
// so no corpus test has this shape and the differential oracle compares
// only programs somebody wrote down.
//
// position: the pattern that binds.

LIMIT: i32 = 3

describe = (env: Env, n: i32) () {
    n.match({
        LIMIT => println("at the limit"),
    });
}

main = (env: Env) Res<i32, AllocError> {
    describe(env, 99);
    Ok(0);
}
