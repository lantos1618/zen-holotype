// ONE MUTABLE LOCAL REASSIGNED ACROSS ALL THREE VARIANTS. Each match must
// read the tag CURRENTLY in the slot: a lowering that stamps the tag once
// at initialisation and lets reassignment overwrite only `.zg_data` keeps
// First's tag forever, and every later arm misfiles under First with a
// plausible number or silence.
//
// write_case_value writes tag and data as one compound literal, so the
// failure needs assignment lowered field-wise; that is the one-line class
// this pins. The three payloads are distinct non-round values so "which
// payload" and "which tag" each fail loudly on their own.

Mix = First(i64) | Gap | Last(i64)

main = (env: Env) Res<i32, AllocError> {
    v: Mix ::= Mix.First(111111111);
    v.match({
        First(t) => println("one first {}", t),
        Gap      => println("one gap"),
        Last(t)  => println("one last {}", t),
    });
    v = Mix.Gap;
    v.match({
        First(t) => println("two first {}", t),
        Gap      => println("two gap"),
        Last(t)  => println("two last {}", t),
    });
    v = Mix.Last(222222222);
    v.match({
        First(t) => println("three first {}", t),
        Gap      => println("three gap"),
        Last(t)  => println("three last {}", t),
    });
    Ok(0);
}
