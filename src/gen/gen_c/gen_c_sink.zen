// src/gen/gen_c/gen_c_sink.zen
// `out.add("{}:{}", self.x, self.y)` — the format door on ANY Sink, and
// the door every idiomatic `toString` is written through.
// `text_fmt.zen` declares it with no body: a variadic parameter has no
// C spelling and `{}` is resolved BY THE ARGUMENT'S TYPE, so the call
// must be expanded where it is WRITTEN — the compiler is the body, the
// same bargain `alloc.String("{}", x)` strikes in `gen_c_fmt.zen`.
// Found via a LINKER ERROR, not a diagnostic: a bodyless declaration
// defines no symbol, so every `toString` written the way DESIGN.md
// writes them emitted a call to `..text_fmt3add..` that nothing
// defines. `cc` reported it as an implicit declaration returning `int`
// rather than pointing at the missing lowering.
// THIS DOOR AND THE ALLOCATING ONE ARE SEPARATE FILES because they
// share the format walk (`lower_pieces_into` below is the allocating
// door writing these pieces into the buffer it just made) but NOT the
// error type: every write reachable from a `{}` answers with exactly
// `Res<(), WriteError>`, this door's own declared return, so a failing
// write is COPIED and nothing converted. The allocating door returns
// `Res<String, AllocError>` instead; `gen_c_fmt.zen` holds that half.
// `add_i64`/`add_u64`/`add_bool` are FOUND, not written here — ordinary
// Zen functions in the door's own module. A second C-side integer
// printer would be a second set of rules about what a number looks
// like, and the corpus pins exactly one. `add_f64` is found too, but
// only its DECLARATION lives in Zen: the digits are this backend's,
// which `write_intrinsic_call` below says why.

ExprId, Decl, Function, Param, Call = std.ast
Literal, TypeId = std.ast
AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId = sema.sema_ty
Def, decl_at = sema.sema_def
Ctx = sema.sema_check
Inst = sema.sema_inst
write_usize = sema.sema_diag
param_type = sema.sema_denote
satisfies_bound = sema.sema_bound
sym_fn, sym_gen, sym_variant, RES_PATH = gen.gen_name
GenFault = gen.gen_diag
CBackend = gen.gen_c.gen_c_state
unsupported = gen.gen_c.gen_c_report
ctype = gen.gen_c.gen_c_type
is_c_integer, is_signed = gen.gen_c.gen_c_type
expr, ty_of, named_hole = gen.gen_c.gen_c_expr
declare_temp, is_variant, payload_type = gen.gen_c.gen_c_flow
write_assign_err = gen.gen_c.gen_c_flow
signature_of, recv_arg, arg_value, by_ref = gen.gen_c.gen_c_call
body_end, decoded_bytes, cast_of = gen.gen_c.gen_c_print
FmtAt, fmt_at, ends_run, arguments_taken = gen.gen_c.gen_c_print
report_in_format, NOT_A_HOLE = gen.gen_c.gen_c_print
HOLE_WITHOUT_ARGUMENT, ARGUMENT_WITHOUT_HOLE = gen.gen_c.gen_c_print
slot_call = gen.gen_c.gen_c_bound
fat_value = gen.gen_c.gen_c_fat
sink_display = gen.gen_c.gen_c_display

// recognising the door

// The bodyless `add(out :: Sink, fmt: str, args: ...)` and nothing
// else, asked of the DECLARATION rather than the name — a module's own
// bodied three-parameter `add` is an ordinary function.
// THE RECEIVER MUST BE `::`: a sink is written into, so it is taken by
// address; a first argument taken by value is not this door.
is_sink_door* = (be: CBackend, d: Def, f: Function) bool {
    d.name.eq("add") && be.sink_door_shape(f)
}

// The door's shape with the name held out, because the MEMBER form has
// no `Def` to read a name off — `s.add(..)` carries its name in the
// access. Stated once so the two forms cannot drift into recognising
// different declarations.
sink_door_shape* = (be: CBackend, f: Function) bool {
    bodyless(f) && (f.params.len == 3) && by_ref(f, 0)
        && be.last_is_variadic(f)
}

bodyless* = (f: Function) bool {
    f.body.match({ Ok(_) => false, None => true })
}

// A FUNCTION WITH NO PARAMETERS HAS NO LAST ONE, and `len - 1` on a
// `usize` traps rather than answering that question. The first caller
// was shielded by a `params.len == 3` test in front of it, so the
// underflow waited for a second caller (`associated_functions`, exit
// 134) before it was found. The guard belongs where the arithmetic is.
last_is_variadic* = (be: CBackend, f: Function) bool {
    (f.params.len == 0).match({
        true  => false,
        false => be.tail_is_variadic(f, f.params.len - 1),
    })
}

tail_is_variadic = (be: CBackend, f: Function, i: usize) bool {
    f.params.get(i).match({
        None  => false,
        Ok(p) => be.variadic_param(p),
    })
}

variadic_param = (be: CBackend, p: Param) bool {
    p.type.match({
        None  => false,
        Ok(t) => be.variadic_type(t),
    })
}

variadic_type = (be: CBackend, t: TypeId) bool {
    be.tree.type_at(t).kind.match({ Variadic => true, _ => false })
}

// the same door, reached through a receiver
// `String.add(self :: @Self, fmt: str, args: ...)` is NOT a second
// door. It is the door's exact shape declared a second time, bodyless
// for the same reason, because a String IS a Sink and `s.add("{}", x)`
// has to mean what `add(s, "{}", x)` means. Declaring it on the type is
// what makes the idiomatic spelling reachable at all; lowering it is
// finding the one declaration and expanding it with the receiver as the
// sink.
// THE FREE DECLARATION IS WHAT IS LOWERED, NOT THE MEMBER'S OWN, and
// that is load-bearing rather than a shortcut. Everything the expansion
// reads comes out of the DOOR'S module: `Sink`, whose `write` slot
// every literal run travels through, and `add_i64`/`add_u64`/`add_bool`,
// the writers a scalar hole reaches. `text_string.zen` imports `Sink`
// but declares no writer, and its own first parameter is `@Self` — a
// String, where the bytes END UP rather than the thing a write goes
// through. Reading the member's declaration would resolve the sink to
// the wrong type and find no writers at all.

lower_member_door* = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    recv : ExprId,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    be.door_decl().try().match({
        None  => be.unsupported(id, "a format door with no declaration", out),
        Ok(d) => be.lower_at_decl(id, c, d, recv, ctx, out),
    })
}

lower_at_decl = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    d    : Def,
    recv : ExprId,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    be.door_fn(d).match({
        None  => be.unsupported(id, "a format door with no declaration", out),
        Ok(g) => be.lower_sink_door(id, c, d, g, Ok(recv), ctx, out),
    })
}

// The free door, found BY SHAPE across the program rather than by module
// path. Nothing at the call site names `text_fmt`: `text_string.zen`
// does not import it, it is not the prelude, and the caller wrote a dot
// on a String. What identifies the door is that it is the one exported
// `add` carrying the door's shape — `::` sink, three parameters, a
// variadic tail, no body — and this tree's only other top-level `add`
// takes two Durations by value.
door_decl = (be :: CBackend) Res<Res<Def>, AllocError> {
    found ::= be.alloc.Vec<Def>();
    be.check.world.exported_named("add", found).try();
    kept ::= be.alloc.Vec<Def>();
    found.loop((h, x) { be.keep_door(x, kept).try() });
    Ok(kept.get(0));
}

keep_door = (be :: CBackend, x: Def, out :: Vec<Def>) Res<(), AllocError> {
    be.door_fn(x).match({
        None  => Ok(()),
        Ok(g) => be.keep_shaped(g, x, out),
    })
}

keep_shaped = (be :: CBackend, g: Function, x: Def, out :: Vec<Def>)
              Res<(), AllocError> {
    be.sink_door_shape(g).match({
        true  => out.add(x),
        false => Ok(()),
    })
}

// The `Function` a `Def` declares, and `None` when it declares anything
// else.
door_fn = (be :: CBackend, d: Def) Res<Function> {
    decl_at(be.tree, d.id).match({
        None    => None,
        Ok(dec) => decl_fn(dec),
    })
}

decl_fn = (dec: Decl) Res<Function> {
    dec.kind.match({ Function(g) => Ok(g), _ => None })
}

// the same door, into a buffer the caller already made
// `gen_c_fmt.zen`'s allocating door is `alloc.String()` followed by
// EXACTLY these pieces, so it reaches them here instead of keeping a
// second walk. It used to keep one, and the two drifted the way two
// copies do: this one grew integers, bools and Displays and that one
// stayed at `str`, so `alloc.String("point {}", p)` was a diagnostic
// while `out.add("point {}", p)` wrote the point.
// A STRING IS A SINK, which is the whole reason this works: the buffer
// becomes the door's own record through `fat_value` — ONE call, not a
// second copy of the rule.
// A FAILING WRITE JUMPS TO A LABEL THE CALLER OWNS rather than leaving
// an answer to inspect. The two doors declare different errors, so the
// caller has to build its own; giving it a place to do that is one
// `usize` and no test emitted on the succeeding path.

lower_pieces_into* = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    addr : str,
    cty  : TyId,
    fail : usize,
    recv : Res<ExprId>,
    ctx  : Ctx
)
                     Res<bool, AllocError> {
    be.door_decl().try().match({
        None  => Ok(false),
        Ok(d) => be.pieces_at_decl(id, c, addr, cty, fail, d, recv, ctx),
    })
}

pieces_at_decl = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    addr : str,
    cty  : TyId,
    fail : usize,
    d    : Def,
    recv : Res<ExprId>,
    ctx  : Ctx
)
                 Res<bool, AllocError> {
    be.door_fn(d).match({
        None  => Ok(false),
        Ok(f) => be.pieces_into_buffer(id, c, addr, cty, fail, d, f, recv, ctx),
    })
}

pieces_into_buffer = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    addr : str,
    cty  : TyId,
    fail : usize,
    d    : Def,
    f    : Function,
    recv : Res<ExprId>,
    ctx  : Ctx
) Res<bool, AllocError> {
    ret = declared_type(be, d, f.ret).try();
    sty = be.sink_type(d, f).try();
    sink ::= be.alloc.String().try();
    be.buffer_sink(addr, cty, sty, sink).try();
    tmp ::= be.fresh_name("t").try();
    be.declare_temp(ret, tmp.view()).try();
    be.write_ok(ret, tmp.view()).try();
    p = Piece(
        sink: sink.view(),
        sty: sty,
        floor: "",
        tmp: tmp.view(),
        done: fail,
        id: id,
        module: d.id.module.to_usize(),
        rty: cty,
        ret: ret
    );
    fmt_arg(c, recv).match({
        None      => Ok(()),
        Ok(first) => write_pieces(be, c, first, fmt_index(recv) + 1, p, ctx),
    }).try();
    Ok(true);
}

// The record over the caller's buffer, in a temporary of its own so
// that every write names a place and `&` on it is an address — the
// same shape `spill_sink` gives a sink that arrived as an argument.
buffer_sink = (
    be   :: CBackend,
    addr : str,
    cty  : TyId,
    sty  : TyId,
    out  :: String
) Res<(), AllocError> {
    value ::= be.alloc.String().try();
    be.fat_value(addr, cty, sty, value).try();
    sym_gen(out, "t", be.next_tmp()).try();
    be.declare_temp(sty, out.view()).try();
    be.set_line(out.view(), value.view())
}

// what one piece needs
// Six values travel together through every write, and they are one
// thing — WHERE THE BYTES GO AND WHERE A FAILURE GOES — so they are
// one record rather than a signature per helper.

Piece* = {
    sink: str,        // the C name of the Sink record, a place
    sty: TyId,        // Sink itself, for its slots
    // THE RECEIVER'S OWN BYTE WRITER, mangled, or "" when the writes go
    // through the Sink record above. A floor answers exactly what the
    // door answers, so `sink` is then the receiver ARGUMENT — address
    // included — and `sty` is not read at all. `gen_c_floor.zen` says
    // why that is a second door and not this one narrowed.
    floor: str,
    tmp*: str,        // the temporary the door answers with
    done*: usize,     // the label a failing write jumps to
    id: ExprId,       // the door call, for a diagnostic with a position
    module: usize,    // the door's own module: where the writers live
    // THE DOOR'S OWN DECLARED ANSWER, and the RECEIVER'S OWN TYPE. Read
    // only where a floor door meets a hole its floor cannot take: the
    // receiver's type is what a `Sink` record is built over, and the
    // answer is what the `Err` a failing wider write leaves is spelled
    // in. A sink door reads neither -- its writes already answer what it
    // answers -- so `rty` there is the sink type again.
    rty: TyId,
    ret: TyId,
}

// the expansion

// A temporary at the door's return type, `Ok` until a write says
// otherwise, and a label every failing write jumps to.
lower_sink_door* = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    d    : Def,
    f    : Function,
    recv : Res<ExprId>,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    ret = declared_type(be, d, f.ret).try();
    sty = be.sink_type(d, f).try();
    sink ::= be.alloc.String().try();
    be.write_sink_temp(c, recv, sty, ctx, sink).try().match({
        false => be.unsupported(id, "a format door with no sink", out),
        true  => write_door(
            be,
            id,
            c,
            d,
            recv,
            ret,
            sty,
            sink.view(),
            ctx,
            out
        ),
    })
}

// The door's declared return and its declared sink, read in the door's
// OWN module. Neither names a type parameter, so there is nothing to
// substitute.
declared_type = (be :: CBackend, d: Def, t: Res<TypeId>)
                Res<TyId, AllocError> {
    t.match({
        Ok(x) => be.check.type_from_ast(x, door_ctx(d)),
        None  => be.check.types.unknown(),
    })
}

sink_type = (be :: CBackend, d: Def, f: Function) Res<TyId, AllocError> {
    f.params.get(0).match({
        None  => be.check.types.unknown(),
        Ok(p) => be.check.param_type(p, door_ctx(d)),
    })
}

door_ctx = (d: Def) Ctx {
    Ctx(
        module: d.id.module.to_usize(),
        ret: TyId(index: 0),
        has_ret: false,
        self_ty: TyId(index: 0),
        has_self: false
    )
}

// The sink lands in a temporary of its own and every write names it.
// A `String` argument becomes the record here, ONCE — `expr` at the
// bound's type is what builds one — and a caller that already holds a
// `Sink` copies two words. Either way what the writes see is a plain C
// name, which is a place, so `&` on it is an address and not a spill.
write_sink_temp = (
    be   :: CBackend,
    c    : Call,
    recv : Res<ExprId>,
    sty  : TyId,
    ctx  : Ctx,
    out  :: String
) Res<bool, AllocError> {
    recv_arg(c, recv).match({
        None  => Ok(false),
        Ok(a) => be.spill_sink(a, sty, ctx, out),
    })
}

spill_sink = (
    be  :: CBackend,
    a   : ExprId,
    sty : TyId,
    ctx : Ctx,
    out :: String
) Res<bool, AllocError> {
    code ::= be.alloc.String().try();
    expr(be, a, ctx, sty, code).try();
    sym_gen(out, "t", be.next_tmp()).try();
    be.declare_temp(sty, out.view()).try();
    be.set_line(out.view(), code.view()).try();
    Ok(true);
}

write_door = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    d    : Def,
    recv : Res<ExprId>,
    ret  : TyId,
    sty  : TyId,
    sink : str,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    tmp ::= be.fresh_name("t").try();
    be.declare_temp(ret, tmp.view()).try();
    be.write_ok(ret, tmp.view()).try();
    p = Piece(
        sink: sink,
        sty: sty,
        floor: "",
        tmp: tmp.view(),
        done: be.next_tmp(),
        id: id,
        module: d.id.module.to_usize(),
        rty: sty,
        ret: ret
    );
    // `out.add("")` is one write of nothing and `out.add(s)` is one
    // write of `s`, so a door with no format argument is not an error —
    // it is the same expansion with no pieces in it.
    fmt_arg(c, recv).match({
        None      => Ok(()),
        Ok(first) => write_pieces(be, c, first, fmt_index(recv) + 1, p, ctx),
    }).try();
    be.write_done(p.done).try();
    out.add_bytes(p.tmp)
}

// `zg_tN = (Res){ .zg_tag = Ok };` — the answer a door with no failing
// write gives, written first so that falling off the end is `Ok` and
// only a failure has to say anything.
write_ok* = (be :: CBackend, ret: TyId, tmp: str) Res<(), AllocError> {
    cty ::= be.alloc.String().try();
    be.ctype(ret, cty).try();
    tag ::= be.alloc.String().try();
    sym_variant(tag, RES_PATH, "Ok").try();
    value ::= be.alloc.String().try();
    value.fmt("({}){ .zg_tag = {} }", cty.view(), tag.view()).try();
    be.set_line(tmp, value.view())
}

fmt_arg = (c: Call, recv: Res<ExprId>) Res<ExprId> {
    arg_value(c, fmt_index(recv))
}

fmt_index = (recv: Res<ExprId>) usize {
    recv.match({ Ok(_) => 0, None => 1 })
}

// the pieces
// `gen_c_print.zen`'s walk over the raw literal, with the writes going
// to a sink instead of straight to the console. One implementation of
// "where are the holes", because `println("{}", x)` and
// `out.add("{}", x)` differ only in where the bytes end up.

write_pieces* = (
    be    :: CBackend,
    c     : Call,
    first : ExprId,
    used0 : usize,
    p     : Piece,
    ctx   : Ctx
) Res<(), AllocError> {
    raw = format_of(be, first);
    (raw.len == 0).match({
        true  => write_values(be, c, first, used0, p, ctx),
        false => be.walk_format(c, first, raw, used0, p, ctx),
    })
}

// No format at all: every argument is a value and they are written in
// order, which is what `println(s)` does with the same shape.
write_values = (
    be    :: CBackend,
    c     : Call,
    first : ExprId,
    used0 : usize,
    p     : Piece,
    ctx   : Ctx
) Res<(), AllocError> {
    write_value(be, first, p, ctx).try();
    be.write_rest(c, used0, p, ctx)
}

// The raw source slice of a string literal, quotes included, and the
// empty string when the argument is not one. A FORMAT IS READ AT
// COMPILE TIME, so a computed one is not a format at all — it is the
// first value, and `out.add(s)` writes `s`.
format_of = (be: CBackend, id: ExprId) str {
    be.tree.expr_at(id).kind.match({
        Literal(l) => literal_format(l),
        _          => "",
    })
}

literal_format = (l: Literal) str {
    l.kind.match({ Str => l.text, _ => "" })
}

walk_format = (
    be    :: CBackend,
    c     : Call,
    id    : ExprId,
    raw   : str,
    used0 : usize,
    p     : Piece,
    ctx   : Ctx
) Res<(), AllocError> {
    end = body_end(raw);
    start ::= 1;
    used  ::= used0;
    i     ::= 1;
    loop(() { i < end }, (h) {
        at = fmt_at(raw, i, end);
        at.ends_run().then(() {
            write_chunk(be, raw, start, at.keep, p).try();
            write_what(be, c, id, at, used, p, ctx).try();
            used  = used + at.what.arguments_taken();
            start = at.next;
        });
        i = at.next;
    });
    write_chunk(be, raw, start, end, p).try();
    be.write_surplus(c, used, p, ctx).try();
    Ok(());
}

// What one position turned out to be, written into the sink. `gen_c_print`
// has the same four arms with the console under them; what differs is
// only where the bytes go, which is why the CLASSIFICATION is shared and
// this is not.
write_what = (
    be   :: CBackend,
    c    : Call,
    id   : ExprId,
    at   : FmtAt,
    used : usize,
    p    : Piece,
    ctx  : Ctx
) Res<(), AllocError> {
    at.what.match({
        Hole     => write_hole(be, c, id, at, used, p, ctx),
        Named(n) => write_named(be, id, at, n, p),
        NoName   => report_in_format(
            be,
            id,
            at,
            GenFault.Unsupported(NOT_A_HOLE)
        ),
        _        => Ok(()),
    })
}

// `{name}` into the sink, through the writer its type picks. Every
// decision after "what is it" is `write_value`'s, reached with the C text
// and the type read off the binding's own slot.
write_named = (be :: CBackend, id: ExprId, at: FmtAt, name: str, p: Piece)
              Res<(), AllocError> {
    text ::= be.alloc.String().try();
    be.named_hole(name, text).try().match({
        None  => report_in_format(be, id, at, GenFault.Unresolved(name)),
        Ok(t) => be.write_typed_into(id, t, text.view(), p),
    })
}

// A hole with no argument left is a compile error at the hole's own
// position, the missing direction of the arity law `gen_c_print`'s
// twin enforces on the console doors — the same law, so a format
// mismatched on holes/arguments is refused through every door.
write_hole = (
    be   :: CBackend,
    c    : Call,
    id   : ExprId,
    at   : FmtAt,
    used : usize,
    p    : Piece,
    ctx  : Ctx
) Res<(), AllocError> {
    arg_value(c, used).match({
        None  => report_in_format(
            be,
            id,
            at,
            GenFault.Unsupported(HOLE_WITHOUT_ARGUMENT)
        ),
        Ok(a) => write_value(be, a, p, ctx),
    })
}

// An argument with no hole left, refused at the argument — the surplus
// direction of the same law. Reached with the walk's final count by both
// the console walk and this one; the no-format shape never gets here.
write_surplus = (be :: CBackend, c: Call, used: usize, p: Piece, ctx: Ctx)
                Res<(), AllocError> {
    (used < c.args.len).match({
        false => Ok(()),
        true  => arg_value(c, used).match({
            None   => Ok(()),
            Ok(id) => be.report_expr(
                id,
                GenFault.Unsupported(ARGUMENT_WITHOUT_HOLE)
            ),
        }),
    })
}

// Every argument from `used` on, written in order — the NO-FORMAT shape
// only, where every argument is a value on purpose and there is no
// arity to mismatch.
write_rest = (be :: CBackend, c: Call, used: usize, p: Piece, ctx: Ctx)
             Res<(), AllocError> {
    Range(used, c.args.len).loop((h, i) {
        arg_value(c, i).match({
            None  => Ok(()),
            Ok(a) => write_value(be, a, p, ctx),
        }).try();
    });
    Ok(());
}

// One literal chunk, and nothing at all when the chunk is empty.
write_chunk = (
    be    :: CBackend,
    raw   : str,
    start : usize,
    stop  : usize,
    p     : Piece
) Res<(), AllocError> {
    (stop > start).match({
        false => Ok(()),
        true  => write_literal(be, raw.slice(start, stop), p),
    })
}

// A run of bytes, verbatim, through the sink's own `write`. The RAW
// slice travels into the emitted C unchanged and only its LENGTH is
// counted — `gen_c_print.zen` says why that is sound.
write_literal = (be :: CBackend, piece: str, p: Piece)
                Res<(), AllocError> {
    text ::= be.alloc.String().try();
    text.fmt("(zg_str){ (unsigned char *)\"{piece}\", ").try();
    write_usize(text, decoded_bytes(piece)).try();
    text.add_bytes("u }").try();
    call ::= be.alloc.String().try();
    be.sink_write(p, text.view(), call).try().match({
        false => be.unsupported_piece(p.id, "a sink with no write"),
        true  => be.write_guarded(call.view(), p),
    })
}

// one value
// The write a `{}` becomes is chosen by the ARGUMENT'S TYPE and by
// nothing else: `{}` carries no format spec, so there is nothing else
// to read.

write_value = (be :: CBackend, a: ExprId, p: Piece, ctx: Ctx)
              Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    ty      = be.ty_of(a, ctx, unknown).try();
    text ::= be.alloc.String().try();
    expr(be, a, ctx, ty, text).try();
    be.write_typed_into(a, ty, text.view(), p)
}

// The write a value becomes once its C text and its type are in hand. A
// `{name}` hole arrives here with both read off its own slot, so the two
// hole spellings share every decision after "where did the value come
// from" — the second door below included.
write_typed_into = (be :: CBackend, a: ExprId, ty: TyId, text: str, p: Piece)
                   Res<(), AllocError> {
    call ::= be.alloc.String().try();
    be.value_call(p, ty, text, call).try().match({
        true  => be.write_guarded(call.view(), p),
        false => be.write_wider(a, ty, text, p),
    })
}

// A `str` is the sink's own `write` — bytes, verbatim, no format
// meaning read into them. Everything else goes through a WRITER.
value_call = (be :: CBackend, p: Piece, ty: TyId, text: str, out :: String)
             Res<bool, AllocError> {
    prim = be.check.prim_name(ty);
    prim.eq("str").match({
        true  => be.sink_write(p, text, out),
        false => be.wider_call(p, ty, prim, text, out),
    })
}

// A FLOOR DOOR'S OWN WRITER TAKES A `str` AND NOTHING ELSE, so a wider
// hole is not this call — `sink_write`'s floor arm is a direct call to
// `add_bytes`, and there is no `add_bytes` for a number. It is not a
// refusal either: `write_wider` below opens the sink the value's writer
// wants, over the same receiver.
wider_call = (
    be   :: CBackend,
    p    : Piece,
    ty   : TyId,
    prim : str,
    text : str,
    out  :: String
) Res<bool, AllocError> {
    p.floor.is_empty().match({
        true  => be.scalar_call(p, ty, prim, text, out),
        false => Ok(false),
    })
}

// a hole the floor cannot take
// `two.fmt("n={}", n)` and `a.String("n={}", n)` are ONE format string
// through two doors, and they used to give two answers: the allocating
// door wrote the number and this one reported `a format hole on this
// door that is not a str` (#755).
// THAT GAP CLOSED 2026-08-25: #755, fixed by d9c02c14d, lands the wider
// hole through a Sink record over the same receiver (below). The comment
// here used to go on from the old refusal to a standing excuse — that
// the gap was why nothing in `src/` implements `Display`, with 591
// String-appending sites and 378 hand-rolled `add_bytes` runs standing
// where one format would. That was a true description of the day it was
// written and is no longer a description of the tree: the door opens,
// the first `Type.impl(Display, ..)` under `src/` is `Pos.impl(Display,
// ..)` in `src/std/ast/ast_span.zen`, and its former hand-rolled call
// sites are `{}` holes. The remainder of the ~400 runs is a campaign to
// be finished one family at a time, not a blockade — recount and pattern
// in `docs/design_fmt.md` §1.
// THE RECEIVER IS A SINK, which is what makes the second answer
// reachable at all: the writers a wider hole needs take a `Sink`, and a
// String is one. So the value's write goes through a record over THE
// SAME RECEIVER the floor writes to, picked by `value_call` — the same
// function, one line up — rather than through a second set of writers.
// WHAT THAT COSTS IS THE ERROR, and it is the allocating door's bargain
// and not a new one: a Sink write answers `WriteError`, this door
// answers its floor's, and the two do not convert. So a failing wider
// write leaves `OutOfMemory` — `docs/design_fmt.md` §6 holds the open
// fork, which this widens from one door to two and does not settle.
// NOTHING ELSE MOVES: a `str` hole and every literal run still go
// straight through the floor and still carry their own `Err`, so what a
// floor door already compiled emits the same bytes it emitted before.
write_wider = (be :: CBackend, a: ExprId, ty: TyId, text: str, p: Piece)
              Res<(), AllocError> {
    p.floor.is_empty().match({
        true  => be.unsupported_piece(a, hole_fault(p)),
        false => be.through_sink(a, ty, text, p),
    })
}

through_sink = (be :: CBackend, a: ExprId, ty: TyId, text: str, p: Piece)
               Res<(), AllocError> {
    be.door_decl().try().match({
        None  => be.unsupported_piece(a, hole_fault(p)),
        Ok(d) => be.sink_at_door(a, ty, text, p, d),
    })
}

sink_at_door = (
    be   :: CBackend,
    a    : ExprId,
    ty   : TyId,
    text : str,
    p    : Piece,
    d    : Def
) Res<(), AllocError> {
    be.door_fn(d).match({
        None  => be.unsupported_piece(a, hole_fault(p)),
        Ok(f) => be.sink_over_receiver(a, ty, text, p, d, f),
    })
}

sink_over_receiver = (
    be   :: CBackend,
    a    : ExprId,
    ty   : TyId,
    text : str,
    p    : Piece,
    d    : Def,
    f    : Function
) Res<(), AllocError> {
    sty  = be.sink_type(d, f).try();
    wret = declared_type(be, d, f.ret).try();
    be.wider_is_sound(p, sty).try().match({
        false => be.unsupported_piece(a, hole_fault(p)),
        true  => be.write_through_sink(a, ty, text, p, d, sty, wret),
    })
}

// TWO THINGS MUST HOLD, and a hole is refused by name exactly as before
// when either does not. The receiver must BE a Sink: `fat_value` writes
// NULL for a slot no impl answers, so a record over a type that never
// promised `write` is a null call where the diagnostic used to be. And
// the door's own error set must name `OutOfMemory`, because that is what
// a failing wider write is reported as — a set with no such variant
// would get a bare `Err` carrying nothing.
wider_is_sound = (be :: CBackend, p: Piece, sty: TyId) Res<bool, AllocError> {
    be.check.satisfies_bound(p.rty, sty).try().match({
        false => Ok(false),
        true  => Ok(be.names_out_of_memory(p.ret)),
    })
}

names_out_of_memory = (be :: CBackend, ret: TyId) bool {
    be.payload_type(ret, "Err").match({
        None    => false,
        Ok(ety) => be.is_variant(ety, "OutOfMemory"),
    })
}

// The record, a temporary at the SINK door's answer for the write to
// land in, and then `value_call` again — with a piece that is the sink
// door's in every field, so a `u8` reaches `add_u64` and a `Display`
// reaches its `toString` by the one set of rules.
write_through_sink = (
    be   :: CBackend,
    a    : ExprId,
    ty   : TyId,
    text : str,
    p    : Piece,
    d    : Def,
    sty  : TyId,
    wret : TyId
) Res<(), AllocError> {
    rec ::= be.alloc.String().try();
    be.buffer_sink(p.sink, p.rty, sty, rec).try();
    wtmp ::= be.fresh_name("t").try();
    be.declare_temp(wret, wtmp.view()).try();
    q = Piece(
        sink: rec.view(),
        sty: sty,
        floor: "",
        tmp: wtmp.view(),
        done: p.done,
        id: p.id,
        module: d.id.module.to_usize(),
        rty: sty,
        ret: wret
    );
    call ::= be.alloc.String().try();
    // `hole_fault(q)` AND NOT `hole_fault(p)`: by here the receiver IS a
    // Sink and the door is open, so a hole this far in fails for the
    // sink door's reason — no writer for the type — and saying "not a
    // str" would name the wrong thing.
    be.value_call(q, ty, text, call).try().match({
        false => be.unsupported_piece(a, hole_fault(q)),
        true  => be.wider_guarded(call.view(), wtmp.view(), p),
    })
}

// `zg_tW = <the write>; if (zg_tW.zg_tag != Ok) { <answer> = Err(OutOfMemory); goto done; }`
// `write_guarded`'s guard with the two error sets named where they meet.
// It is one `if` and no label of its own, because the answer is BUILT
// here rather than carried: there is nothing to jump past, so a wider
// hole costs a floor door nothing it was not already paying.
wider_guarded = (be :: CBackend, call: str, wtmp: str, p: Piece)
                Res<(), AllocError> {
    be.set_line(wtmp, call).try();
    tag ::= be.alloc.String().try();
    sym_variant(tag, RES_PATH, "Ok").try();
    be.fmt("if ({wtmp}.zg_tag != {}) {\n", tag.view()).try();
    be.indent();
    be.write_assign_err(p.ret, "OutOfMemory", p.tmp).try();
    be.write_goto(p.done).try();
    be.dedent();
    be.writeln("}").try();
    Ok(());
}

hole_fault = (p: Piece) str {
    p.floor.is_empty().match({
        true  => "formatting a value of this type",
        false => "a format hole on this door that is not a str",
    })
}

scalar_call = (
    be   :: CBackend,
    p    : Piece,
    ty   : TyId,
    prim : str,
    text : str,
    out  :: String
) Res<bool, AllocError> {
    writer_of(prim).is_empty().match({
        true  => be.sink_display(ty, text, p.sink, out),
        false => be.writer_call(p, writer_of(prim), cast_of(prim), text, out),
    })
}

// Which of `text_fmt.zen`'s writers a primitive reaches. Empty means
// none does, and the value goes through its own `toString` instead.
writer_of = (prim: str) str {
    prim.eq("bool").match({
        true  => "add_bool",
        false => number_writer(prim),
    })
}

// A float's writer is the one whose body is this backend's: the
// declaration exists so `module_fn` can find it, the bytes come from
// `write_intrinsic_call` below. Both widths land on f64 -- a `double`
// holds an f32 exactly, which is more than any second writer could
// promise the two widths would agree about.
number_writer = (prim: str) str {
    is_float(prim).match({
        true  => "add_f64",
        false => integer_writer(prim),
    })
}

integer_writer = (prim: str) str {
    is_c_integer(prim).match({
        false => "",
        true  => signed_writer(prim),
    })
}

signed_writer = (prim: str) str {
    is_signed(prim).match({ true => "add_i64", false => "add_u64" })
}

// Bytes into whichever floor this door was opened on.
sink_write = (be :: CBackend, p: Piece, text: str, out :: String)
             Res<bool, AllocError> {
    p.floor.is_empty().match({
        true  => be.slot_write(p, text, out),
        false => floor_write(p, text, out),
    })
}

// `<floor>(<receiver>, <bytes>)` — a direct call to the receiver's own
// writer. No record: the receiver's type is concrete, so which function
// runs is known here.
floor_write = (p: Piece, text: str, out :: String) Res<bool, AllocError> {
    out.fmt("{}({}, {})", p.floor, p.sink, text).try();
    Ok(true);
}

// `<sink>.write(<sink>.zg_self, <bytes>)` — the one member of `Sink`
// that takes bytes, reached through the record because a sink's whole
// point is that the writer does not know which one it holds.
slot_write = (be :: CBackend, p: Piece, text: str, out :: String)
             Res<bool, AllocError> {
    args ::= be.alloc.String().try();
    args.fmt(", {text}").try();
    be.slot_call(p.sink, p.sty, "write", args.view(), 1, out).try().match({
        None  => Ok(false),
        Ok(_) => Ok(true),
    })
}

// `zu_..add_i64(&<sink>, (int64_t)(<value>))`. The writer is looked up
// in the DOOR'S module and not through the caller's imports, because
// the expansion is the backend's: a caller that wrote `out.add("{}", n)`
// never named `add_i64`.
writer_call = (
    be   :: CBackend,
    p    : Piece,
    name : str,
    cast : str,
    text : str,
    out  :: String
) Res<bool, AllocError> {
    be.module_decl(p.module, name).try().match({
        None  => Ok(false),
        Ok(w) => be.door_fn(w).match({
            None  => Ok(false),
            Ok(g) => bodyless(g).match({
                true  => be.write_intrinsic_call(p, cast, text, out),
                false => be.write_writer_call(w, p, cast, text, out),
            }),
        }),
    })
}

// A WRITER THE BACKEND IS THE BODY OF lowers as the bytes it would
// have written: one `%g` render into the runtime floor's scratch and
// the sink's own `write` over them -- the exact shape a bodied writer
// computing digits and calling `out.write` would compile to. Going
// through `sink_write` keeps every receiver kind (a String buffer, a
// Sink record, a floor door's byte writer) and the guarded failure
// the other writers answer with.
// THE SCRATCH IS THE FLOOR'S, file-scope like `zg_print_f64` beside
// which it sits, and safe shared because a render's bytes are copied
// by the very call that follows it before any later render starts --
// the expansion is sequential statements and nothing reorders them.
write_intrinsic_call = (
    be   :: CBackend,
    p    : Piece,
    cast : str,
    text : str,
    out  :: String
) Res<bool, AllocError> {
    be.need_fbuf();
    // ASSEMBLED, NOT FORMATTED: the emitted text carries `{ ... }` C
    // braces and `%g`, and this file is compiled BY THE PREVIOUS
    // GENERATION of itself -- a float hole here would be refused by a
    // seed whose `writer_of` does not know `add_f64` yet. Every piece
    // goes through `add_bytes`, which reads no format meaning. The one
    // `fmt` keeps EMPTY holes: a named one binds the enclosing LOCAL of
    // that name and leaves its explicit argument to be appended again
    // by `write_rest` -- which printed the value twice and cost cc a
    // `expected expression`.
    value ::= be.alloc.String().try();
    value.fmt("{}({})", cast, text).try();
    bytes ::= be.alloc.String().try();
    bytes.add_bytes(
        "(zg_str){ (unsigned char *)zg_f64_scratch, (size_t)snprintf(zg_f64_scratch, sizeof zg_f64_scratch, \"%g\", "
    ).try();
    bytes.add_bytes(value.view()).try();
    bytes.add_bytes(") }").try();
    call ::= be.alloc.String().try();
    // THE CALL TEXT IS THE ANSWER, not a side effect: `out` arrives
    // empty and the caller guards whatever lands in it, so a render
    // that forgets to hand the bytes over emits `t = ;` -- which cc
    // refuses, and which this branch shipped once.
    wrote ::= be.sink_write(p, bytes.view(), call).try();
    wrote.match({
        false => Ok(false),
        true  => {
            out.add_bytes(call.view()).try();
            Ok(true)
        },
    })
}

write_writer_call = (
    be   :: CBackend,
    w    : Def,
    p    : Piece,
    cast : str,
    text : str,
    out  :: String
) Res<bool, AllocError> {
    sym ::= be.alloc.String().try();
    be.call_symbol(w, sym).try();
    out.fmt("{}(&{}, {}({}))", sym.view(), p.sink, cast, text).try();
    Ok(true);
}

// A bodied function a module declares under `name`. The ONE CALLER
// (`writer_call`) wants a writer it can queue for emission, so
// bodiless declarations are kept out here rather than at the call --
// except that the float writer is bodyless ON PURPOSE, its body being
// the backend's, so `module_decl` beside this one answers ANY function
// under the name and lets the door's expansion split on `bodyless`
// itself.
module_fn = (be :: CBackend, mi: usize, name: str)
            Res<Res<Def>, AllocError> {
    found ::= be.alloc.Vec<Def>();
    be.check.world.defs_of(mi, name, found).try();
    kept ::= be.alloc.Vec<Def>();
    found.loop((h, x) { be.keep_bodied(x, kept).try() });
    Ok(kept.get(0));
}

// The same walk WITHOUT the bodied filter, for a writer whose body is
// deliberately nobody's but the backend's (`add_f64`, #809): the
// declaration is wanted so the expansion can read where it lives, not
// so anything can be queued from it -- queueing one is impossible by
// construction and `lower_function` says why that is safe.
module_decl = (be :: CBackend, mi: usize, name: str)
              Res<Res<Def>, AllocError> {
    found ::= be.alloc.Vec<Def>();
    be.check.world.defs_of(mi, name, found).try();
    kept ::= be.alloc.Vec<Def>();
    found.loop((h, x) { be.keep_fn(x, kept).try() });
    Ok(kept.get(0));
}

keep_fn = (be :: CBackend, x: Def, out :: Vec<Def>)
          Res<(), AllocError> {
    decl_at(be.tree, x.id).match({
        None    => Ok(()),
        Ok(dec) => keep_fn_decl(dec, x, out),
    })
}

keep_fn_decl = (dec: Decl, x: Def, out :: Vec<Def>)
               Res<(), AllocError> {
    dec.kind.match({
        Function(_) => out.add(x),
        _           => Ok(()),
    })
}

keep_bodied = (be :: CBackend, x: Def, out :: Vec<Def>)
              Res<(), AllocError> {
    decl_at(be.tree, x.id).match({
        None    => Ok(()),
        Ok(dec) => keep_bodied_decl(dec, x, out),
    })
}

keep_bodied_decl = (dec: Decl, x: Def, out :: Vec<Def>)
                   Res<(), AllocError> {
    dec.kind.match({
        Function(fn) => keep_bodied_fn(fn, x, out),
        _            => Ok(()),
    })
}

keep_bodied_fn = (fn: Function, x: Def, out :: Vec<Def>)
                 Res<(), AllocError> {
    bodyless(fn).match({
        true  => Ok(()),
        false => out.add(x),
    })
}

// the symbol, and the short circuit that keeps a failure visible

// The symbol of a plain, non-generic function, queued so the walk
// reaches its body: "was this already emitted" and "what do I call"
// have to be the same question.
call_symbol* = (be :: CBackend, d: Def, out :: String)
               Res<(), AllocError> {
    sig  ::= be.alloc.Vec<TyId>();
    inst ::= be.alloc.Inst();
    be.signature_of(d, inst, sig).try();
    sym ::= be.alloc.String().try();
    sym_fn(sym, be.check.types, be.check.world, d.qname, sig, inst).try();
    be.need_function(d, inst, sym.view()).try();
    out.add_bytes(sym.view())
}

// `zg_tN = <the write>; if (zg_tN.zg_tag != Ok) { goto done; }`
// THE ANSWER AND THE GUARD ARE ONE TEMPORARY, because of the one error
// type the header names: a failing write leaves its own `Err` where the
// door's answer goes, and carrying it is the jump and nothing else — no
// rebuild, no re-tag, and no error set to widen.
write_guarded = (be :: CBackend, call: str, p: Piece) Res<(), AllocError> {
    be.set_line(p.tmp, call).try();
    be.write_jump_unless_ok(p.tmp, p.done)
}

// A piece this backend cannot write. Reported at the node rather than
// swallowed, and the door still answers with its temporary so the C
// around it stays well formed.
unsupported_piece = (be :: CBackend, id: ExprId, what: str)
                    Res<(), AllocError> {
    be.report_expr(id, GenFault.Unsupported(what))
}

// `if (zg_tN.zg_tag != Ok) { goto done; }`
write_jump_unless_ok* = (be :: CBackend, tmp: str, done: usize)
                        Res<(), AllocError> {
    tag ::= be.alloc.String().try();
    sym_variant(tag, RES_PATH, "Ok").try();
    be.fmt("if ({tmp}.zg_tag != {}) {\n", tag.view()).try();
    be.indent();
    be.write_goto(done).try();
    be.dedent();
    be.writeln("}").try();
    Ok(());
}

write_goto* = (be :: CBackend, done: usize) Res<(), AllocError> {
    line ::= be.alloc.String().try();
    line.add_bytes("goto ").try();
    sym_gen(line, "f", done).try();
    line.add_bytes(";").try();
    be.writeln(line.view())
}

// THE DONE LABEL of a Res cleanup, beside the goto that jumps to it --
// `f<n>: ;`. A loop's break label is a different thing with a stem and a
// number (`gen_c_loop.zen`'s write_label); this one has exactly one name,
// which is why it is not that function.
write_done* = (be :: CBackend, done: usize) Res<(), AllocError> {
    line ::= be.alloc.String().try();
    sym_gen(line, "f", done).try();
    line.add_bytes(": ;").try();
    be.writeln(line.view())
}
