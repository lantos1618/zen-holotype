// src/zen/zen_cli.zen
// Command selection and argument meaning. Option declarations use the caller's
// arena; argv and option values remain borrowed.
//
// `--repeat` and `--permute` support the determinism gate and remain outside
// user-facing usage. `test` and `lsp` are recognized future commands; lsp's
// argument-free dispatch remains in zen.zen.

Alloc, AllocError = std.mem
str = std.text
Vec = std.collections
Range = std.core
Env = std.env
BuildArgs, BuildFlags, build_options = std.build
FLAG_EMIT_C, ZEN_STD_ENV = std.build
Options, options, is_word, arg_at = std.cli

// Usage carries the offending word; Missing carries a required option that
// was absent. Later distinguishes a recognized command from a typo.
Cli* = Build(BuildArgs)
     | Fmt(FmtJob)
     | Later(str)     // test / lsp — named, and not yet written
     | Usage(str)     // the word that made no sense; empty means nothing was said
     | Missing(str)   // a flag the build needs and did not get

// `zen fmt` takes files; zen_fmt validates that they are not directories.
FmtJob* = {
    // Keep argv borrowed; paths are copied only when a caller supplies Alloc.
    argv*: Vec<str>,

    // `--check`: report, change nothing. Without it the files are
    // rewritten in place.
    check*: bool,

    // Every path the caller named.
    paths* = (self: @Self, a: Alloc) Res<Vec<str>, AllocError> {
        out ::= a.Vec<str>();
        Range(ARGS, self.argv.len).loop((h, i) {
            word = arg_at(self.argv, i);
            is_word(word).match({
                true  => out.add(word),
                false => Ok(()),
            }).try();
        });
        Ok(out);
    }
}

// argv[0] is the program and argv[1] is the command.
ARGS*: usize = 2

USAGE*: str = "usage: zen build <root> [--entry <file>] [--std <path>] [--ffi] [--symbol-map <file>] --emit-c -o <file.c>\n       zen build <root> [--entry <file>] [--std <path>] [--ffi] [--symbol-map <file>] --emit-c-dir <dir>\n       zen fmt [--check] <file.zen>..."

COMMAND_BUILD: str = "build"
COMMAND_FMT: str = "fmt"
COMMAND_TEST: str = "test"
COMMAND_LSP: str = "lsp"
FLAG_FMT_CHECK: str = "--check"

FmtFlag = | Check

cli* = (env: Env, argv: Vec<str>) Res<Cli, AllocError> {
    alloc = env.mem.alloc();
    argv.get(1).match({
        None     => Ok(Cli.Usage("")),
        Ok(name) => command(env, alloc, argv, name),
    })
}

command = (env: Env, a: Alloc, argv: Vec<str>, name: str)
          Res<Cli, AllocError> {
    name.eq(COMMAND_BUILD).match({
        true  => job_of(env, a, argv),
        false => not_build(a, argv, name),
    })
}

not_build = (a: Alloc, argv: Vec<str>, name: str) Res<Cli, AllocError> {
    name.eq(COMMAND_FMT).match({
        true  => fmt_of(a, argv),
        false => Ok(not_written(name)),
    })
}

not_written = (name: str) Cli {
    is_later(name).match({
        true  => Cli.Later(name),
        false => Cli.Usage(name),
    })
}

is_later = (name: str) bool {
    name.eq(COMMAND_TEST) || name.eq(COMMAND_LSP)
}

// `zen fmt [--check] <file.zen>...` requires at least one path.
fmt_of = (a: Alloc, argv: Vec<str>) Res<Cli, AllocError> {
    declared = fmt_options(a).try();
    scan  ::= declared.args(argv, ARGS);
    check ::= false;
    words ::= 0;
    loop(() { !scan.done() }, (h) {
        scan.next().match({
            Ok(item) => item.named.match({
                Ok(flag) => flag.match({ Check => { check = true; } }),
                None     => { words = words + word_count(item.word); },
            }),
            None     => (),
        });
    });
    Ok(fmt_verdict(argv, check, scan.bad, words));
}

fmt_options = (a: Alloc) Res<Options<FmtFlag>, AllocError> {
    declared ::= options<FmtFlag>(a);
    declared.flag(FLAG_FMT_CHECK, FmtFlag.Check).try();
    Ok(declared)
}

word_count = (word: str) usize {
    is_word(word).match({
        true  => 1,
        false => 0,
    })
}

fmt_verdict = (argv: Vec<str>, check: bool, bad: str, words: usize) Cli {
    bad.is_empty().match({
        false => Cli.Usage(bad),
        true  => (words == 0).match({
            true  => Cli.Usage(""),
            false => Cli.Fmt(FmtJob(argv: argv, check: check)),
        }),
    })
}

// The scan is split by responsibility: std.cli handles argv mechanics, this
// file declares meanings, and std.build.BuildFlags is the one raw destination.
job_of = (env: Env, a: Alloc, argv: Vec<str>) Res<Cli, AllocError> {
    parsed ::= BuildFlags(
        std_root: env.var(ZEN_STD_ENV).match({ Ok(p) => p, None => "" })
    );
    declared = build_options(a).try();
    scan ::= declared.args(argv, ARGS);
    loop(() { !scan.done() }, (h) {
        scan.next().match({
            Ok(item) => item.named.match({
                Ok(flag) => item.word.is_empty().match({
                    true  => parsed.apply_switch(flag),
                    false => parsed.apply_setting(flag, item.word),
                }),
                None     => parsed.root.is_empty().match({
                    true  => parsed.set_root(item.word),
                    false => scan.reject(item.word),
                }),
            }),
            None     => (),
        });
    });
    Ok(verdict(parsed, scan.bad));
}

verdict = (args: BuildFlags, bad: str) Cli {
    bad.is_empty().match({
        false => Cli.Usage(bad),
        true  => args.finish().match({
            Err(MissingRoot) => Cli.Usage(""),
            Err(MissingEmit) => Cli.Missing(FLAG_EMIT_C),
            Ok(job)          => Cli.Build(job),
        }),
    })
}
