// resolution is on declared parameter types and arity. no candidate has
// arity three, so there is nothing to pick and nothing to guess.
//
// position: the call.

show = (env: Env, n: i32) () { println("int {}", n) }
show = (env: Env, s: str) () { println("str {}", s) }

main = (env: Env) Res<i32, AllocError> {
    show(env, 1, 2);
    Ok(0);
}
