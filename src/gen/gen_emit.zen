// Output buffering and stable ordering for backends. `Emit` owns its
// `String`: read it through `view`, or take it with `into_string`.

Alloc, AllocError = std.mem
str, String = std.text
Vec = std.collections
Range = std.core
before = std.text

INDENT* : usize = 4

Emit* = {
    text :: String,
    depth :: usize,

    // The last byte written was `\n`: the next non-empty write indents
    // first, and a blank line gets no indent.
    fresh :: bool,

    // writing

    // Every `\n` in `s` ends a line, so a multi-line run indents each line.
    bytes* = (self :: @Self, s: str) Res<(), AllocError> {
        lines ::= s.split('\n');
        self.run(lines.next().value_or("")).try();
        loop((h) {
            lines.next().match({
                None     => h.break(),
                Ok(rest) => { self.line().try(); self.run(rest).try(); },
            });
        });
        Ok(())
    }

    // `s` holds no `\n`. Empty writes nothing, so a blank line stays blank.
    run = (self :: @Self, s: str) Res<(), AllocError> {
        (s.len == 0).match({
            true  => Ok(()),
            false => self.open_run(s),
        })
    }

    open_run = (self :: @Self, s: str) Res<(), AllocError> {
        self.open_line().try();
        self.text.add(s)
    }

    byte* = (self :: @Self, b: u8) Res<(), AllocError> {
        (b == '\n').match({
            true  => self.line(),
            false => self.open_byte(b),
        })
    }

    open_byte = (self :: @Self, b: u8) Res<(), AllocError> {
        self.open_line().try();
        self.text.add(b)
    }

    number* = (self :: @Self, v: usize) Res<(), AllocError> {
        self.open_line().try();
        self.text.write_usize(v)
    }

    // End the line. A blank line is `line` twice and gets no indent.
    line* = (self :: @Self) Res<(), AllocError> {
        self.text.add('\n').try();
        self.fresh = true;
        Ok(());
    }

    say* = (self :: @Self, s: str) Res<(), AllocError> {
        self.bytes(s).try();
        self.line()
    }

    open_line = (self :: @Self) Res<(), AllocError> {
        self.fresh.then(() { self.write_indent().try() });
        self.fresh = false;
        Ok(());
    }

    write_indent = (self :: @Self) Res<(), AllocError> {
        Range(0, self.depth * INDENT).loop((h, i) {
            self.text.add(' ').try();
        });
        Ok(());
    }

    // depth

    indent* = (self :: @Self) () { self.depth = self.depth + 1; }

    // Saturates at zero: an unbalanced backend gets misindented C, not an
    // aborted compilation.
    dedent* = (self :: @Self) () {
        (self.depth > 0).then(() { self.depth = self.depth - 1; });
    }

    // reading back

    view* = (self: @Self) str { self.text.view() }

    len* = (self: @Self) usize { self.text.len() }

    // Takes the buffer; the Emit is not written again after this.
    into_string* = (self: @Self) String { self.text }
}

Emit* = (a: Alloc) Res<Emit, AllocError> {
    Ok(Emit(text: a.String().try(), depth: 0, fresh: true));
}

// The positions of `keys` in lexicographic byte order: a permutation, so
// the caller keeps whatever the keys name. Stable, so equal keys keep
// input order.
order* = (a: Alloc, keys: Vec<String>) Res<Vec<usize>, AllocError> {
    out ::= a.Vec<usize>();
    tmp ::= a.Vec<usize>();
    Range(0, keys.len).loop((h, i) { out.add(i).try() });
    width    ::= 1;
    from_out ::= true;
    loop(() { width < keys.len }, (h) {
        from_out.match({
            true  => out.merge_into(tmp, keys, width),
            false => tmp.merge_into(out, keys, width),
        }).try();
        from_out = !from_out;
        width    = width * 2;
    });
    Ok(from_out.match({ true => out, false => tmp }))
}

// One pass: every `width`-long sorted run of `src`, merged pairwise into `dst`.
merge_into = (
    src   : Vec<usize>,
    dst   :: Vec<usize>,
    keys  : Vec<String>,
    width : usize
)
             Res<(), AllocError> {
    dst.clear();
    start ::= 0;
    loop(() { start < src.len }, (h) {
        mid = smaller(start + width, src.len);
        end = smaller(mid + width, src.len);
        src.merge_run(dst, keys, start, mid, end).try();
        start = end;
    });
    Ok(())
}

smaller = (a: usize, b: usize) usize {
    (a < b).match({ true => a, false => b })
}

merge_run = (
    src   : Vec<usize>,
    dst   :: Vec<usize>,
    keys  : Vec<String>,
    start : usize,
    mid   : usize,
    end   : usize
) Res<(), AllocError> {
    left  ::= start;
    right ::= mid;
    Range(start, end).loop((h, i) {
        right_wins = (right < end) && src.earlier(keys, right, left);
        from_right = (left == mid) || right_wins;
        from       = from_right.match({ true => right, false => left });
        dst.add(src.get(from).value_or(0)).try();
        from_right.match({
            true  => { right = right + 1; },
            false => { left = left + 1; },
        });
    });
    Ok(())
}

// The key at `src[i]` is strictly before the key at `src[j]`; strict, so
// equal keys never swap.
earlier = (src: Vec<usize>, keys: Vec<String>, i: usize, j: usize) bool {
    src.key(keys, i).before(src.key(keys, j))
}

key = (src: Vec<usize>, keys: Vec<String>, i: usize) str {
    keys.get(src.get(i).value_or(0)).match({ Ok(s) => s.view(), None => "" })
}
