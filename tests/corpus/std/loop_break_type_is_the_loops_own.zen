// THE BREAKS THE LOOP'S OWN T ALLOWS — every legal spelling of
// h.break(v) in one program, so the gate that refuses a foreign break
// (`must-fail/codegen/loop_break_with_a_foreign_type.zen`,
// `.._of_another_width.zen`) cannot be tightened into rejecting these.
//
// Four shapes, each with its answer printed:
//   - broken with the ELEMENT itself, the shape std's `find` is built on;
//   - an INT LITERAL over a usize walk -- text_utf8.sequence_len breaks
//     five of them per call, so this must never wobble;
//   - a fold broken with 999 while its accumulator threads -- the corpus
//     fold test already covers it; here it guards the acc settlement;
//   - a u8 control over u8 items, which answers with its own value --
//     before the gate existed this file's shape was also how an i64
//     slipped through and answered 44 for 300.

main = (env: Env) Res<i32, AllocError> {
    ["a", "b"].loop((h, v) {
        (v.eq("b")).then(() { h.break(v); });
    }).match({
        Ok(s) => println("found {}", s),
        None  => println("not found"),
    });
    Range(0, 5).loop((h, i) {
        (i == 3).then(() { h.break(42); });
    }).match({
        Ok(n) => println("n={}", n),
        None  => println("none"),
    });
    [1, 2, 3, 4].loop(0, (h, index, value, acc: i32) {
        (value == 3).then(() { h.break(999); });
        acc + value
    }).match({
        Ok(n) => println("broke with {}", n),
        None  => println("ran to the end"),
    });
    good: u8       = 44;
    items: [u8, 1] = [1];
    items.loop((h, v) {
        h.break(good);
    }).match({
        Ok(n) => println("{}", n),
        None  => println("none"),
    });
    Ok(0);
}
