// FORK 2 of 2 on LEADING ZEROS. DESIGN.md does not decide. This file
// assumes a leading zero is rejected outright, which is the reading
// that makes 010 unable to silently mean 8. The other reading is
// tests/corpus/lex/number_leading_zeros.zen.
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    n: i32 = 007;
    println("{}", n);
    Ok(0);
}
