// fmt canonicalizes an INVERTED boolean match (empty true arm / false-only effect) into
// `(cond == false).then({ ... })`. This fixture locks ONE-SHOT convergence: the first fmt pass
// must emit the final paren spelling directly — `(a == "--" == false)`, never the doubled
// `(paren-wrapped cond) == false` spelling that only a second pass would strip (#607 finding 2).
classify = (a: StringView) i32 {
    (a == "--" == false).then({
        return 1
    })
    ((a == "x" || a == "y") == false).then({
        return 2
    })
    flag ::= a == "z"
    (flag == false).then({
        return 3
    })
    (a == "q" == false).then({
        return 4
    })
    0
}
main = () i32 { classify("x") }
