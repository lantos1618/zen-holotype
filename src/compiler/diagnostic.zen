// Map a flattened-source offset back to the original module's line and column. Import stripping and
// namespace rewriting make offsets differ, so matching tries exact text and the `__`/alias inverse.
{ at, is_blank } = std.text.ascii
{ view } = std.text.str
{ Allocator } = std.mem.alloc
{ String } = std.text.string
{ gstr_string, gstr_append, gstr_push, gstr_finish } = compiler.genc
{ gstr_int } = compiler.astops
{ upto, advance_while, step_while } = std.core.count
// line:col span in the USER source; line == 0 means "could not locate".
DiagSpan*: {
    line: i32,
    col: i32,
    end_col: i32,
}
dspan_none = () DiagSpan {
    DiagSpan(
        line: 0,
        col: 0,
        end_col: 0,
    )
}
// length of the line of `s` that starts at byte `p` (up to '\n' or NUL)
dline_len = (s: StringView, p: i32, n: i32) i32 {
    n.advance_while((k) { s.at(p + k) != 0 && s.at(p + k) != '\n' })
}
// start byte of the line containing `off` (scan back past the previous '\n')
dline_start = (s: StringView, off: i32) i32 {
    off.step_while((p) { p != 0 && s.at(p - 1) != '\n' }, (p) { p - 1 })
}
// user[up..up+ln] == flat[fp..fp+ln] byte-exact
dseg_eq = (user: StringView, up: i32, flat: StringView, fp: i32, ln: i32, i: i32) bool {
    eq ::= true
    i.step_while((k) { k < ln && eq }, (k) {
        eq = user.at(up + k) == flat.at(fp + k)
        k + 1
    })
    eq
}
// the 1-based line in `user` whose text exactly equals flat[fp..fp+ln], else 0.
duser_line_at = (user: StringView, up: i32, flat: StringView, fp: i32, ln: i32, no: i32) i32 {
    ulen = user.dline_len(up, 0)
    (ulen == ln && user.dseg_eq(up, flat, fp, ln, 0)).match ({
        true  => no,
        false => (user.at(up + ulen) == 0).match ({
            true  => 0,
            false => user.duser_line_at(up + ulen + 1, flat, fp, ln, no + 1),
        }),
    })
}
duser_line = (user: StringView, flat: StringView, fp: i32, ln: i32) i32 {
    user.duser_line_at(0, flat, fp, ln, 1)
}
// ── alias-rewrite inverse: a flat line `…alias__name…` whose user form removed the inserted span.
//    find the first `__` after leading whitespace; the removed span is [lead, j+2). ──
dlead_ws = (s: StringView, p: i32, ln: i32, i: i32) i32 {
    (i >= ln).match ({
        true  => i,
        false => (s.at(p + i) == ' ' || s.at(p + i) == '\t').match ({
            true  => s.dlead_ws(p, ln, i + 1),
            false => i,
        }),
    })
}
// first index >= lead+1 where flat[fp+j]=='_' && flat[fp+j+1]=='_' (j+1 < ln-1), else -1
dfind_dunder = (flat: StringView, fp: i32, ln: i32, j: i32) i32 {
    (j + 1 >= ln - 1).match ({
        true  => 0 - 1,
        false => (flat.at(fp + j) == '_' && flat.at(fp + j + 1) == '_').match ({
            true  => j,
            false => flat.dfind_dunder(fp, ln, j + 1),
        }),
    })
}
// user[up..up+ulen] == flat[fp..fp+flen] with [start,start+n) removed (lengths must match)
dmatch_removed = (
    user: StringView,
    up: i32,
    ulen: i32,
    flat: StringView,
    fp: i32,
    flen: i32,
    start: i32,
    n: i32,
) bool {
    (start + n > flen || ulen != flen - n).match ({
        true  => false,
        false => user.dseg_eq(up, flat, fp, start, 0)
            && user.dseg_eq(up + start, flat, fp + start + n, flen - start - n, 0),
    })
}
// flat byte offset within a line -> user column after removing [start,start+n)
dremoved_col = (off: i32, start: i32, n: i32) i32 {
    (off < start).match ({
        true  => off + 1,
        false => (off < start + n).then({ start + 1 }, { off - n + 1 }),
    })
}
// ── ns-normalize inverse: compare treating each `__` in the flat line as a single `.`. ──
// user[up..] equals flat[fp..fp+flen] with every `__` collapsed to one char; returns user line len match.
dseg_eq_ns = (
    user: StringView,
    up: i32,
    ui: i32,
    flat: StringView,
    fp: i32,
    fi: i32,
    flen: i32,
) bool {
    (fi == flen).match ({
        true  => user.at(up + ui) == 0 || user.at(up + ui) == '\n',
        false => (fi + 1 < flen && flat.at(fp + fi) == '_' && flat.at(fp + fi + 1) == '_').match ({
            true  => user.at(up + ui) == '.' && user.dseg_eq_ns(up, ui + 1, flat, fp, fi + 2, flen),
            false => user.at(up + ui) == flat.at(fp + fi)
                && user.dseg_eq_ns(up, ui + 1, flat, fp, fi + 1, flen),
        }),
    })
}
duser_line_ns_at = (user: StringView, up: i32, flat: StringView, fp: i32, flen: i32, no: i32) i32 {
    ulen = user.dline_len(up, 0)
    user.dseg_eq_ns(up, 0, flat, fp, 0, flen).match ({
        true  => no,
        false => (user.at(up + ulen) == 0).match ({
            true  => 0,
            false => user.duser_line_ns_at(up + ulen + 1, flat, fp, flen, no + 1),
        }),
    })
}
// flat offset -> column counting each `__` as one char
dnorm_col = (flat: StringView, fp: i32, flen: i32, off: i32, i: i32, col: i32) i32 {
    c ::= col
    i.step_while((k) { k < off }, (k) {
        c = c + 1
        (k + 1 < flen && flat.at(fp + k) == '_' && flat.at(fp + k + 1) == '_').match ({
            true  => k + 2,
            false => k + 1,
        })
    })
    c
}
// the entry point main.c calls per candidate source: flat = import-flattened source the checker saw,
// user = one real source file, offset = the error's flat byte offset, span_width = its width.
diag_user_span* = (flat: StringView, user: StringView, offset: i32, span_width: i32) DiagSpan {
    // Byte zero is a real source position (line 1, column 1). Negative offsets alone mean that a
    // diagnostic is synthesized and has no source anchor.
    (offset < 0).then({
        return dspan_none()
    })
    ls = flat.dline_start(offset)
    llen = flat.dline_len(ls, 0)
    rel = offset - ls
    erel0 = rel + span_width - 1
    erel = (erel0 >= llen && llen > 0).then({ llen - 1 }, { erel0 })
    // 1) exact line-text match
    exact = user.duser_line(flat, ls, llen)
    (exact > 0).then({
        return DiagSpan(
            line: exact,
            col: rel + 1,
            end_col: rel + span_width,
        )
    })
    // 2) alias `__`-removal inverse
    lead = flat.dlead_ws(ls, llen, 0)
    j = flat.dfind_dunder(ls, llen, lead + 1)
    (j >= 0).then({
        rn = j + 2 - lead
        al = user.duser_line_alias(flat, ls, llen, lead, rn)
        (al > 0).then({
            return DiagSpan(
                line: al,
                col: rel.dremoved_col(lead, rn),
                end_col: erel.dremoved_col(lead, rn),
            )
        })
    })
    // 3) on-the-fly `__`==`.` normalized match
    nsl = user.duser_line_ns_at(0, flat, ls, llen, 1)
    (nsl > 0).then({
        return DiagSpan(
            line: nsl,
            col: flat.dnorm_col(ls, llen, rel, 0, 1),
            end_col: flat.dnorm_col(ls, llen, erel, 0, 1),
        )
    })
    dspan_none()
}
// ── identity-based variant: the module and its ORIGINAL 1-based line are already KNOWN (from the
// resolver's flat-region/line map), so only the COLUMN is recovered — by running the single-line
// textual inverses (exact / alias-`__`-removal / `__`==`.`) against that ONE known line instead of
// scanning every candidate source. When every inverse fails (e.g. several rewritten names on one
// line), the line is still pinned and the column falls back to 1 — the location is never lost.
diag_line_span* = (
    flat: StringView,
    user: StringView,
    offset: i32,
    span_width: i32,
    srcline: i32,
) DiagSpan {
    (offset < 0 || srcline <= 0).then({
        return dspan_none()
    })
    ls = flat.dline_start(offset)
    llen = flat.dline_len(ls, 0)
    rel = offset - ls
    erel0 = rel + span_width - 1
    erel = (erel0 >= llen && llen > 0).then({ llen - 1 }, { erel0 })
    up = user.dline_off(srcline, 0)
    ulen = user.dline_len(up, 0)
    // 1) exact line-text match
    (ulen == llen && user.dseg_eq(up, flat, ls, llen, 0)).then({
        return DiagSpan(
            line: srcline,
            col: rel + 1,
            end_col: rel + span_width,
        )
    })
    // 2) alias `__`-removal inverse on the known line
    lead = flat.dlead_ws(ls, llen, 0)
    j = flat.dfind_dunder(ls, llen, lead + 1)
    (j >= 0).then({
        rn = j + 2 - lead
        user.dmatch_removed(up, ulen, flat, ls, llen, lead, rn).then({
            return DiagSpan(
                line: srcline,
                col: rel.dremoved_col(lead, rn),
                end_col: erel.dremoved_col(lead, rn),
            )
        })
    })
    // 3) on-the-fly `__`==`.` normalized match on the known line
    user.dseg_eq_ns(up, 0, flat, ls, 0, llen).then({
        return DiagSpan(
            line: srcline,
            col: flat.dnorm_col(ls, llen, rel, 0, 1),
            end_col: flat.dnorm_col(ls, llen, erel, 0, 1),
        )
    })
    DiagSpan(
        line: srcline,
        col: 1,
        end_col: 1,
    )
}
// 4) the line is known even when no textual inverse fits: pin it, column 1
// alias variant of duser_line: match each user line against flat[ls..ls+llen] with [lead,lead+rn) removed
duser_line_alias_at = (
    user: StringView,
    up: i32,
    flat: StringView,
    ls: i32,
    llen: i32,
    lead: i32,
    rn: i32,
    no: i32,
) i32 {
    ulen = user.dline_len(up, 0)
    user.dmatch_removed(up, ulen, flat, ls, llen, lead, rn).match ({
        true  => no,
        false => (user.at(up + ulen) == 0).match ({
            true  => 0,
            false => user.duser_line_alias_at(up + ulen + 1, flat, ls, llen, lead, rn, no + 1),
        }),
    })
}
duser_line_alias = (
    user: StringView,
    flat: StringView,
    ls: i32,
    llen: i32,
    lead: i32,
    rn: i32,
) i32 { user.duser_line_alias_at(0, flat, ls, llen, lead, rn, 1) }
// ── zen.toml manifest value lookup — moved out of the C driver (driver.c) ──────────────────────
// Scan a manifest source for a `key = "value"` line and return the value's span (start<0 = absent);
// the driver dup_range's src[start..start+len] into a NUL-terminated string. Pure char-scan, no alloc.
MfSpan*: {
    start: i32,
    len: i32,
}
mf_none = () MfSpan {
    MfSpan(
        start: 0 - 1,
        len: 0,
    )
}
mf_skip_ws = (s: StringView, p: i32, e: i32) i32 {
    (p < e && s.at(p).is_blank()).then({ s.mf_skip_ws(p + 1, e) }, { p })
}
// match `key` literally at p; return pos just past it, or -1
mf_key_at = (s: StringView, p: i32, e: i32, key: StringView, k: i32) i32 {
    (key.at(k) == 0).match ({
        true  => p,
        false => (p < e && s.at(p) == key.at(k)).match ({
            true  => s.mf_key_at(p + 1, e, key, k + 1),
            false => 0 - 1,
        }),
    })
}
// the closing-quote position from `i`, or -1
mf_close = (s: StringView, i: i32, e: i32) i32 {
    (i >= e).match ({
        true  => 0 - 1,
        false => (s.at(i) == '"').then({ i }, { s.mf_close(i + 1, e) }),
    })
}
// parse one line [p,e) for `key = "value"` -> the value span, or mf_none
mf_line = (s: StringView, p: i32, e: i32, key: StringView) MfSpan {
    i0 = s.mf_skip_ws(p, e)
    (i0 >= e || s.at(i0) == '#').then({
        return mf_none()
    })
    ak = s.mf_key_at(i0, e, key, 0)
    (ak < 0).then({
        return mf_none()
    })
    i1 = s.mf_skip_ws(ak, e)
    (i1 >= e || s.at(i1) != '=').then({
        return mf_none()
    })
    i2 = s.mf_skip_ws(i1 + 1, e)
    (i2 >= e || s.at(i2) != '"').then({
        return mf_none()
    })
    start = i2 + 1
    ce = s.mf_close(start, e)
    (ce < 0).match ({
        true  => mf_none(),
        false => MfSpan(
            start: start,
            len: ce - start,
        ),
    })
}
mf_line_end = (s: StringView, p: i32, len: i32) i32 {
    (p < len && s.at(p) != '\n' && s.at(p) != '\r').then({ s.mf_line_end(p + 1, len) }, { p })
}
// scan `src` (length `len`) for `key`'s value, starting at line `p`. The driver calls with p=0.
manifest_value_span* = (src: StringView, len: i32, key: StringView, p: i32) MfSpan {
    (p >= len).then({
        return mf_none()
    })
    e = src.mf_line_end(p, len)
    r = src.mf_line(p, e, key)
    (r.start >= 0).then({
        return r
    })
    np = (e < len && src.at(e) == '\r' && e + 1 < len && src.at(e + 1) == '\n').match ({
        true  => e + 2,
        false => e + 1,
    })
    (e >= len).then({ mf_none() }, { src.manifest_value_span(len, key, np) })
}
// ── error rendering (message line + source caret) — moved out of the C driver ──────────────────
// Builds the full "zenc: path:line:col: error[kind]: message" line, the source line + ^~~~ caret,
// and the hint, into one NUL-terminated string the driver writes to stderr. The driver keeps only
// file I/O and the per-module span search.
// byte offset of the start of the `line`-th (1-based) line in `user`
dline_off = (user: StringView, line: i32, p: i32) i32 {
    ln ::= line
    p.step_while((q) { ln > 1 && user.at(q) != 0 }, (q) {
        (user.at(q) == '\n').then({
            ln = ln - 1
        })
        q + 1
    })
}
// append the source line at byte `p` (until \n/NUL/CR) to s
dput_line = (s: String, a: Allocator, user: StringView, p: i32) String {
    acc ::= s
    p.step_while((q) { user.at(q) != 0 && user.at(q) != '\n' && user.at(q) != '\r' }, (q) {
        acc = acc.gstr_push(a, user.at(q))
        q + 1
    })
    acc
}
// append `col-1` leading-blanks, preserving tabs from the source line at `ls`
dput_blanks = (s: String, a: Allocator, user: StringView, ls: i32, col: i32, i: i32) String {
    acc ::= s
    i.upto(col - 1, (k) {
        c = user.at(ls + k)
        acc = acc.gstr_push(a, (c == '\t').then({ '\t' }, { ' ' }))
    })
    acc
}
// append `^` then `n-1` `~`
dput_carets = (s: String, a: Allocator, n: i32, i: i32) String {
    acc ::= s
    i.upto(n, (k) { acc = acc.gstr_push(a, (k == 0).then({ '^' }, { '~' })) })
    acc
}
// render one diagnostic to a NUL-terminated string (line<=0 / col<=0 => no caret)
render_diagnostic* = (
    a: Allocator,
    in_path: StringView,
    user: StringView,
    line: i32,
    col: i32,
    end_col: i32,
    kind: StringView,
    message: StringView,
    hint: StringView,
    count: i32,
) StringView {
    // Pre-size to bound the whole rendered diagnostic (header + message + source line + carets + hint)
    // so the buffer NEVER grows: a gstr_grow/resize mid-render reallocs the buffer and the inlined
    // append chain would then write through the freed pointer (heap-use-after-free). The content is
    // at most a fixed overhead + the str args + a few times the rendered source line (<= user.len).
    cap = 1024 + in_path.view().len + kind.view().len + message.view().len + hint.view().len + user.view().len * 4
    s ::= a.gstr_string(cap)
    s = s.gstr_append(a, "zenc: ").gstr_append(a, in_path)
    (line > 0 && col > 0).then({
        s = s
            .gstr_push(a, ':')
            .gstr_int(a, line)
            .gstr_push(a, ':')
            .gstr_int(a, col)
    })
    s = s.gstr_append(a, ": error[").gstr_append(a, kind, "]: ", message)
    (count > 1).then({
        s = s.gstr_append(a, " (+").gstr_int(a, count - 1).gstr_append(a, " more error")
        // no method chained after a .match (parser limitation): push the closing chars inside the arms
        s = (count - 1 == 1).match ({
            true  => s.gstr_push(a, ')'),
            false => s.gstr_push(a, 's').gstr_push(a, ')'),
        })
    })
    s = s.gstr_push(a, '\n')
    (line > 0 && col > 0).then({
        ls = user.dline_off(line, 0)
        width = (end_col >= col).then({ end_col - col + 1 }, { 1 })
        s = s.gstr_append(a, "  ").dput_line(a, user, ls).gstr_push(a, '\n')
        s = s
            .gstr_append(a, "  ")
            .dput_blanks(a, user, ls, col, 0)
            .dput_carets(a, width, 0)
            .gstr_push(a, '\n')
    })
    (hint.at(0) == 0).match ({
        true  => s.gstr_finish(a),
        false => s
            .gstr_append(a, "hint: ")
            .gstr_append(a, hint)
            .gstr_push(a, '\n')
            .gstr_finish(a),
    })
}
