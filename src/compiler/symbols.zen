{ Expr, Stmt, Decl, Func, Param, Ty, CallData, LetData, ArmData, LoopData, LambdaData, ImplData,
  GlobalData, StructDecl } = compiler.ast.ast_types
{ ParsedProgram, ParsedModule, ImportEdge, module_link_decls, resolve_parsed_program_overlays,
  SourceOverlay, edge_head_has_name } = compiler.resolve
{ Allocator } = std.mem.alloc
{ Map } = std.collections.map
{ Opt } = std.core.result
{ eq, starts_with, ends_with } = std.text.str
{ strlen } = std.c.libc
{ cbuf, tvoid, acquire_or_die } = compiler.genc
{ parse_module } = compiler.parse
{ desugar_method_calls, expand_defaults, fill_enum_defaults } = compiler.check_desugar
{ DeclIndex, Env, build_decl_index, params_env, bind_fnret, bind_tparams, params_onto, vcons,
  extend_env, arm_env, loop_env, vnil, recv_name } = compiler.check
{ impl_cname_in } = compiler.mangle
{ loop_at } = std.core.count
{ StructDeclQuery, TyQuery } = compiler.astops
{ expr_fold_children } = compiler.ast.expr_children
SymbolKind*: Unknown | Function | Global | Type | Method | Let | Param
symbol_kind_code = (kind: SymbolKind) i64 {
    kind.match ({
        .Unknown  => 0,
        .Function => 1,
        .Global   => 2,
        .Type     => 3,
        .Method   => 4,
        .Let      => 5,
        .Param    => 6,
    })
}
SymbolKey*: {
    module: StringView,
    owner: StringView,
    name: StringView,
    kind: SymbolKind,
    pos: i32,
}
SymbolSourceSpan*: {
    module: StringView,
    path: StringView,
    start: i32,
    end: i32,
}
SymbolDecl*: {
    key: SymbolKey,
    name: StringView,
    link_name: StringView,
    span: SymbolSourceSpan,
    has_type: bool,
    type_key: SymbolKey,
}
ImplMethodSite*: {
    declaration: SymbolKey,
    has_trait_method: bool,
    trait_method: SymbolKey,
    span: SymbolSourceSpan,
}
ImplSite*: {
    receiver: SymbolKey,
    has_trait: bool,
    trait: SymbolKey,
    span: SymbolSourceSpan,
    has_trait_span: bool,
    trait_span: SymbolSourceSpan,
    methods: MutSlice<ImplMethodSite>,
}
SymbolOccurrence*: {
    key: SymbolKey,
    span: SymbolSourceSpan,
    declaration: bool,
    write: bool,
}
SymbolIndex*: {
    decls: MutSlice<SymbolDecl>,
    occurrences: MutSlice<SymbolOccurrence>,
    implementations: MutSlice<ImplSite>,
    symbol_at = (idx: SymbolIndex, path: StringView, pos: i32) Opt<SymbolKey> {
        found ::= false
        ambiguous ::= false
        key ::= symbol_key_none()
        idx.occurrences.loop_at((i, o) {
            (o.span.path.eq(path) && pos >= o.span.start && pos < o.span.end).then({
                found.match ({
                    true  => (key.symbol_key_eq(o.key) == false).then({
                        ambiguous = true
                    }),
                    false => {
                        found = true
                        key = o.key
                    },
                })
            })
        })
        (found && ambiguous == false).then({ .Some(key) }, { .None })
    }
    declaration = (idx: SymbolIndex, key: SymbolKey) Opt<SymbolDecl> {
        found ::= false
        out ::= symbol_decl_none()
        idx.decls.loop_at((i, d) {
            (found == false && d.key.symbol_key_eq(key)).then({
                found = true
                out = d
            })
        })
        found.then({ .Some(out) }, { .None })
    }
    occurrences_of = (idx: SymbolIndex, a: Allocator, key: SymbolKey) MutSlice<SymbolOccurrence> {
        buf ::= cbuf<SymbolOccurrence>(a, idx.occurrences.len)
        n ::= 0
        idx.occurrences.loop_at((i, o) {
            o.key.symbol_key_eq(key).then({
                buf[n] = o
                n = n + 1
            })
        })
        slice(buf.ptr, n)
    }
    references_at = (
        idx: SymbolIndex,
        a: Allocator,
        path: StringView,
        pos: i32,
    ) MutSlice<SymbolOccurrence> {
        idx.symbol_at(path, pos).match ({
            .Some(key) => idx.occurrences_of(a, key),
            .None      => slice(null_ptr(), 0),
        })
    }
    type_definition = (idx: SymbolIndex, key: SymbolKey) Opt<SymbolDecl> {
        (key.kind == .Type).then({
            return idx.declaration(key)
        })
        idx.declaration(key).match ({
            .Some(d) => d.has_type.then({ idx.declaration(d.type_key) }, { .None }),
            .None    => .None,
        })
    }
    type_definition_at = (idx: SymbolIndex, path: StringView, pos: i32) Opt<SymbolDecl> {
        idx.symbol_at(path, pos).match ({
            .Some(key) => idx.type_definition(key),
            .None      => .None,
        })
    }
    implementations_of = (
        idx: SymbolIndex,
        a: Allocator,
        key: SymbolKey,
    ) MutSlice<SymbolSourceSpan> {
        cap ::= idx.implementations.len
        idx.implementations.loop_at((i, site) { cap = cap + site.methods.len })
        out ::= cbuf<SymbolSourceSpan>(a, cap)
        n ::= 0
        idx.implementations.loop_at((i, site) {
            hit_block = site.receiver.symbol_key_eq(key)
                || site.has_trait && site.trait.symbol_key_eq(key)
            hit_block.then({
                n = out.sym_span_push_unique(n, site.span)
            })
            site.methods.loop_at((j, method) {
                (method.declaration.symbol_key_eq(key)
                    || method.has_trait_method && method.trait_method.symbol_key_eq(key)).then({
                    n = out.sym_span_push_unique(n, method.span)
                })
            })
        })
        slice(out.ptr, n)
    }
    implementations_at = (
        idx: SymbolIndex,
        a: Allocator,
        path: StringView,
        pos: i32,
    ) MutSlice<SymbolSourceSpan> {
        idx.symbol_at(path, pos).match ({
            .Some(key) => idx.implementations_of(a, key),
            .None      => slice(null_ptr(), 0),
        })
    }
    declarations_of = (idx: SymbolIndex, a: Allocator, kind: SymbolKind) MutSlice<SymbolDecl> {
        buf ::= cbuf<SymbolDecl>(a, idx.decls.len)
        n ::= 0
        idx.decls.loop_at((i, d) {
            (d.key.kind == kind).then({
                buf[n] = d
                n = n + 1
            })
        })
        slice(buf.ptr, n)
    }
}
symbol_key_none = () SymbolKey {
    SymbolKey(
        module: "",
        owner: "",
        name: "",
        kind: .Unknown,
        pos: 0,
    )
}
symbol_decl_none = () SymbolDecl {
    SymbolDecl(
        key: symbol_key_none(),
        name: "",
        link_name: "",
        span: SymbolSourceSpan(
            module: "",
            path: "",
            start: 0,
            end: 0,
        ),
        has_type: false,
        type_key: symbol_key_none(),
    )
}
symbol_key_eq* = (a: SymbolKey, b: SymbolKey) bool {
    a.kind == b.kind
        && a.pos == b.pos
        && a.module.eq(b.module)
        && a.owner.eq(b.owner)
        && a.name.eq(b.name)
}
span_for = (m: ParsedModule, pos: i32, name: StringView) SymbolSourceSpan {
    SymbolSourceSpan(
        module: m.id,
        path: m.path,
        start: pos,
        end: pos + to_i32(strlen(name)),
    )
}
key_for = (
    m: ParsedModule,
    owner: StringView,
    name: StringView,
    kind: SymbolKind,
    pos: i32,
) SymbolKey {
    SymbolKey(
        module: m.id,
        owner: owner,
        name: name,
        kind: kind,
        pos: pos,
    )
}
SymScope*: SymScopeNil | SymScopeCons(SymScopeCell)
SymScopeCell: {
    key: SymbolKey,
    ty: StringView,
    tail: Ptr<SymScope>,
}
SymLookup: {
    found: bool,
    key: SymbolKey,
}
sym_scope_buf = (a: Allocator) MutSlice<SymScope> { slice(a.acquire_or_die(sizeof(SymScope)), 1) }
sym_scope_nil = (a: Allocator) Ptr<SymScope> {
    b ::= a.sym_scope_buf()
    b[0] = .SymScopeNil
    b[0].addr()
}
sym_scope_push = (a: Allocator, s: Ptr<SymScope>, key: SymbolKey, ty: StringView) Ptr<SymScope> {
    b ::= a.sym_scope_buf()
    b[0] = .SymScopeCons(SymScopeCell(
        key: key,
        ty: ty,
        tail: s,
    ))
    b[0].addr()
}
sym_scope_find = (s: Ptr<SymScope>, name: StringView) SymLookup {
    s.match ({
        .SymScopeNil     => SymLookup(
            found: false,
            key: symbol_key_none(),
        ),
        .SymScopeCons(c) => c.key.name.eq(name).match ({
            true  => SymLookup(
                found: true,
                key: c.key,
            ),
            false => c.tail.sym_scope_find(name),
        }),
    })
}
sym_scope_type = (s: Ptr<SymScope>, name: StringView) StringView {
    s.match ({
        .SymScopeNil     => "",
        .SymScopeCons(c) => c.key.name.eq(name).then({ c.ty }, { c.tail.sym_scope_type(name) }),
    })
}
SymModule: {
    module: ParsedModule,
    decls: MutSlice<Decl>,
    world: MutSlice<Decl>,
    didx: DeclIndex,
}
SymBuild: {
    a: Allocator,
    modules: MutSlice<SymModule>,
    decls: MutSlice<SymbolDecl>,
    decl_n: i64,
    occurrences: MutSlice<SymbolOccurrence>,
    occ_n: i64,
    implementations: MutSlice<ImplSite>,
    impl_n: i64,
    decl_seen: Map<i64>,
    occ_seen: Map<i64>,
}
sym_source_has_name = (m: ParsedModule, pos: i32, name: StringView) bool {
    ok ::= pos >= 0 && strlen(name) > 0 && to_i64(pos) + strlen(name) <= strlen(m.source)
    bytes: Slice<u8> = name.slice(strlen(name))
    bytes.loop_at((i, b) {
        (ok && m.source.at(pos + to_i32(i)) != b).then({
            ok = false
        })
    })
    ok
}
sym_stamp = (
    a: Allocator,
    key: SymbolKey,
    occurrence_module: StringView,
    occurrence_path: StringView,
    start: i32,
    declaration: bool,
    write: bool,
) StringView {
    a.String(128)
        .add(key.module)
        .add_one('\t')
        .add(key.owner)
        .add_one('\t')
        .add(key.name)
        .add_one('\t')
        .add_i64(symbol_kind_code(key.kind))
        .add_one('\t')
        .add_i64(key.pos)
        .add_one('\t')
        .add(occurrence_module)
        .add_one('\t')
        .add(occurrence_path)
        .add_one('\t')
        .add_i64(start)
        .add_one(declaration.then({ 'd' }, { 'r' }))
        .add_one(write.then({ 'w' }, { 'n' }))
        .finish_cstr()
}
sym_decl_stamp = (a: Allocator, key: SymbolKey) StringView {
    a.sym_stamp(key, "", "", 0 - 1, true, false)
}
sym_add_decl = (
    b: SymBuild,
    m: ParsedModule,
    key: SymbolKey,
    name: StringView,
    link_name: StringView,
) SymBuild {
    out ::= b
    m.sym_source_has_name(key.pos, name).then({
        stamp = b.a.sym_decl_stamp(key)
        (out.decl_seen.has(stamp) == false).then({
            out.decl_seen = out.decl_seen.put(out.a.addr(), stamp, 1).expect("symbols: decl set")
            out.decls[out.decl_n] = SymbolDecl(
                key: key,
                name: name,
                link_name: link_name,
                span: m.span_for(key.pos, name),
                has_type: false,
                type_key: symbol_key_none(),
            )
            out.decl_n = out.decl_n + 1
            out = out.sym_add_occ(m, key, key.pos, name, true, false)
        })
    })
    out
}
sym_add_occ = (
    b: SymBuild,
    m: ParsedModule,
    key: SymbolKey,
    pos: i32,
    name: StringView,
    declaration: bool,
    write: bool,
) SymBuild {
    out ::= b
    m.sym_source_has_name(pos, name).then({
        stamp = b.a.sym_stamp(key, m.id, m.path, pos, declaration, write)
        (out.occ_seen.has(stamp) == false).then({
            out.occ_seen = out.occ_seen
                .put(out.a.addr(), stamp, 1)
                .expect("symbols: occurrence set")
            out.occurrences[out.occ_n] = SymbolOccurrence(
                key: key,
                span: m.span_for(pos, name),
                declaration: declaration,
                write: write,
            )
            out.occ_n = out.occ_n + 1
        })
    })
    out
}
sym_world = (a: Allocator, lib: MutSlice<Decl>, own: MutSlice<Decl>) MutSlice<Decl> {
    out ::= cbuf<Decl>(a, lib.len + own.len)
    lib.loop_at((i, d) { out[i] = d })
    own.loop_at((i, d) { out[lib.len + i] = d })
    out
}
sym_modules = (a: Allocator, p: ParsedProgram) MutSlice<SymModule> {
    out ::= slice(a.acquire_or_die(p.modules.len * sizeof(SymModule)), p.modules.len)
    p.modules.loop_at((i, m) {
        raw = a.parse_module(m.source)
        ds0 = a.expand_defaults(a.desugar_method_calls(raw))
        ds = a.fill_enum_defaults(ds0, a.build_decl_index(ds0))
        world = a.sym_world(a.module_link_decls(p, m), ds)
        out[i] = SymModule(
            module: m,
            decls: ds,
            world: world,
            didx: a.build_decl_index(world),
        )
    })
    out
}
sym_build_new = (a: Allocator, modules: MutSlice<SymModule>) SymBuild {
    cap ::= 64
    modules.loop_at((i, sm) { cap = cap + strlen(sm.module.source) })
    seed: i64 = 0
    SymBuild(
        a: a,
        modules: modules,
        decls: cbuf<SymbolDecl>(a, cap),
        decl_n: 0,
        occurrences: cbuf<SymbolOccurrence>(a, cap),
        occ_n: 0,
        implementations: cbuf<ImplSite>(a, cap),
        impl_n: 0,
        decl_seen: a.map_of("__symbols_decl_seed", seed).expect("symbols: decl set"),
        occ_seen: a.map_of("__symbols_occ_seed", seed).expect("symbols: occurrence set"),
    )
}
sym_decl_view = (b: SymBuild) MutSlice<SymbolDecl> { slice(b.decls.ptr, b.decl_n) }
sym_occ_view = (b: SymBuild) MutSlice<SymbolOccurrence> { slice(b.occurrences.ptr, b.occ_n) }
sym_impl_view = (b: SymBuild) MutSlice<ImplSite> { slice(b.implementations.ptr, b.impl_n) }
sym_span_eq = (a: SymbolSourceSpan, b: SymbolSourceSpan) bool {
    a.start == b.start && a.end == b.end && a.module.eq(b.module) && a.path.eq(b.path)
}
sym_span_push_unique = (out: MutSlice<SymbolSourceSpan>, n: i64, span: SymbolSourceSpan) i64 {
    found ::= false
    out.loop_at((i, old) {
        (i < n && old.sym_span_eq(span)).then({
            found = true
        })
    })
    found.match ({
        true  => n,
        false => {
            out[n] = span
            n + 1
        },
    })
}
sym_is_impl_link = (b: SymBuild, m: ParsedModule, link: StringView) bool {
    found ::= false
    b.modules.loop_at((mi, sm) {
        sm.module.id.eq(m.id).then({
            sm.decls.loop_at((i, d) {
                d.match ({
                    .DImpl(im) => im.methods.loop_at((j, p) {
                        b.a.impl_cname_in(im.trname, im.ty, p.name).eq(link).then({
                            found = true
                        })
                    }),
                    _          => { },
                })
            })
        })
    })
    found
}
sym_collect_toplevel = (b: SymBuild, sm: SymModule) SymBuild {
    out ::= b
    m = sm.module
    sm.decls.loop_at((i, d) {
        out = d.match ({
            .DFunc(f)          => out.sym_is_impl_link(m, f.name).match ({
                true  => out,
                false => out.sym_add_decl(m, m.key_for("", f.name, .Function, f.pos), f.name, f.name),
            }),
            .DForeign(f)       => out.sym_add_decl(m, m.key_for("", f.name, .Function, f.pos), f.name, f.name),
            .DGlobal(g)        => g.alias.match ({
                true  => out,
                false => out.sym_add_decl(m, m.key_for("", g.name, .Global, g.pos), g.name, g.name),
            }),
            .DStruct(s)        => out.sym_collect_struct(m, s),
            .DEnum(e)          => out.sym_add_decl(m, m.key_for("", e.name, .Type, e.pos), e.name, e.name),
            .DGenStruct(s)     => out.sym_add_decl(m, m.key_for("", s.name, .Type, s.pos), s.name, s.name),
            .DGenEnum(e)       => out.sym_add_decl(m, m.key_for("", e.name, .Type, e.pos), e.name, e.name),
            .DImpl(im)         => out.sym_collect_methods(m, im),
            .DTraitDefault(td) => {
                link = out.a.impl_cname_in(td.trname, td.trname, td.fn.name)
                key = m.key_for(td.trname, td.fn.name, .Method, td.fn.pos)
                out.sym_add_decl(m, key, td.fn.name, link)
            },
            _                  => out,
        })
    })
    out
}
sym_collect_struct = (b: SymBuild, m: ParsedModule, s: StructDecl) SymBuild {
    out ::= b.sym_add_decl(m, m.key_for("", s.name, .Type, s.pos), s.name, s.name)
    s.struct_is_trait().then({
        s.fields.loop_at((i, field) {
            field.ty.is_fnt().then({
                key = m.key_for(s.name, field.name, .Method, field.pos)
                link = out.a.impl_cname_in(s.name, s.name, field.name)
                out = out.sym_add_decl(m, key, field.name, link)
            })
        })
    })
    out
}
sym_collect_methods = (b: SymBuild, m: ParsedModule, im: ImplData) SymBuild {
    out ::= b
    im.methods.loop_at((i, p) {
        link = b.a.impl_cname_in(im.trname, im.ty, p.name)
        key = m.key_for(im.ty, p.name, .Method, p.pos)
        out = out.sym_add_decl(m, key, p.name, link)
    })
    out
}
sym_find_decl = (b: SymBuild, module: StringView, name: StringView, kind: SymbolKind) SymLookup {
    found ::= false
    ambiguous ::= false
    key ::= symbol_key_none()
    b
        .sym_decl_view()
        .loop_at((i, d) {
            (d.key.module.eq(module) && d.name.eq(name) && d.key.kind == kind).then({
                found.match ({
                    true  => (key.symbol_key_eq(d.key) == false).then({
                        ambiguous = true
                    }),
                    false => {
                        found = true
                        key = d.key
                    },
                })
            })
        })
    (found && ambiguous == false).match ({
        true  => SymLookup(
            found: true,
            key: key,
        ),
        false => SymLookup(
            found: false,
            key: symbol_key_none(),
        ),
    })
}
sym_find_link = (b: SymBuild, link: StringView) SymLookup {
    found ::= false
    ambiguous ::= false
    key ::= symbol_key_none()
    b
        .sym_decl_view()
        .loop_at((i, d) {
            d.link_name.eq(link).then({
                found.match ({
                    true  => (key.symbol_key_eq(d.key) == false).then({
                        ambiguous = true
                    }),
                    false => {
                        found = true
                        key = d.key
                    },
                })
            })
        })
    (found && ambiguous == false).match ({
        true  => SymLookup(
            found: true,
            key: key,
        ),
        false => SymLookup(
            found: false,
            key: symbol_key_none(),
        ),
    })
}
sym_find_link_module = (b: SymBuild, module: StringView, link: StringView) SymLookup {
    found ::= false
    ambiguous ::= false
    key ::= symbol_key_none()
    b
        .sym_decl_view()
        .loop_at((i, d) {
            (d.key.module.eq(module) && d.link_name.eq(link)).then({
                found.match ({
                    true  => (key.symbol_key_eq(d.key) == false).then({
                        ambiguous = true
                    }),
                    false => {
                        found = true
                        key = d.key
                    },
                })
            })
        })
    (found && ambiguous == false).match ({
        true  => SymLookup(
            found: true,
            key: key,
        ),
        false => SymLookup(
            found: false,
            key: symbol_key_none(),
        ),
    })
}
sym_find_link_in = (b: SymBuild, m: ParsedModule, link: StringView) SymLookup {
    own = b.sym_find_link_module(m.id, link)
    own.found.match ({
        true  => own,
        false => {
            found ::= false
            ambiguous ::= false
            key ::= symbol_key_none()
            m.graph.imports.loop_at((i, e) {
                candidate = b.sym_find_link_module(e.module, link)
                candidate.found.then({
                    found.match ({
                        true  => (key.symbol_key_eq(candidate.key) == false).then({
                            ambiguous = true
                        }),
                        false => {
                            found = true
                            key = candidate.key
                        },
                    })
                })
            })
            (found && ambiguous == false).match ({
                true  => SymLookup(
                    found: true,
                    key: key,
                ),
                false => SymLookup(
                    found: false,
                    key: symbol_key_none(),
                ),
            })
        },
    })
}
sym_namespace_edge = (m: ParsedModule, alias: StringView) Opt<ImportEdge> {
    found ::= false
    ambiguous ::= false
    out ::= ImportEdge(
        module: "",
        alias: "",
        namespace: false,
        start: 0,
        next: 0,
    )
    m.graph.imports.loop_at((i, e) {
        (e.namespace && e.alias.eq(alias)).then({
            found.match ({
                true  => {
                    ambiguous = true
                },
                false => {
                    found = true
                    out = e
                },
            })
        })
    })
    (found && ambiguous == false).then({ .Some(out) }, { .None })
}
sym_imported_decl = (b: SymBuild, m: ParsedModule, name: StringView, kind: SymbolKind) SymLookup {
    own = b.sym_find_decl(m.id, name, kind)
    own.found.match ({
        true  => own,
        false => {
            found ::= false
            ambiguous ::= false
            key ::= symbol_key_none()
            m.graph.imports.loop_at((i, e) {
                (e.namespace == false && m.source.edge_head_has_name(e.start, name)).then({
                    candidate = b.sym_find_decl(e.module, name, kind)
                    candidate.found.then({
                        found.match ({
                            true  => (key.symbol_key_eq(candidate.key) == false).then({
                                ambiguous = true
                            }),
                            false => {
                                found = true
                                key = candidate.key
                            },
                        })
                    })
                })
            })
            (found && ambiguous == false).match ({
                true  => SymLookup(
                    found: true,
                    key: key,
                ),
                false => SymLookup(
                    found: false,
                    key: symbol_key_none(),
                ),
            })
        },
    })
}
sym_initial_env = (a: Allocator, sm: SymModule, f: Func) Env {
    vars = a.bind_tparams(a.bind_fnret(a.params_env(f.params), f.ret), f.tparams)
    Env(
        vars: vars,
        decls: sm.world,
        didx: sm.didx,
        exp: tvoid(),
        a: a,
    )
}
sym_function_key = (b: SymBuild, sm: SymModule, f: Func) SymLookup {
    bylink = b.sym_find_link_in(sm.module, f.name)
    bylink.found.then({ bylink }, { b.sym_find_decl(sm.module.id, f.name, .Function) })
}
sym_add_params = (
    b: SymBuild,
    sm: SymModule,
    owner: StringView,
    ps: MutSlice<Param>,
    scope: Ptr<SymScope>,
) SymParams {
    out ::= b
    sc ::= scope
    ps.loop_at((i, p) {
        key = sm.module.key_for(owner, p.name, .Param, p.pos)
        out = out.sym_add_decl(sm.module, key, p.name, p.name)
        type_decl = out.sym_type_from_ty(sm, p.ty)
        out = out.sym_set_decl_type(key, type_decl)
        scope_ty = type_decl.found.then({ type_decl.key.name }, { p.ty.recv_name() })
        sc = out.a.sym_scope_push(sc, key, scope_ty)
    })
    SymParams(
        build: out,
        scope: sc,
    )
}
SymParams: {
    build: SymBuild,
    scope: Ptr<SymScope>,
}
sym_collect_decl_types = (b: SymBuild, sm: SymModule) SymBuild {
    out ::= b
    empty_env = Env(
        vars: out.a.vnil(),
        decls: sm.world,
        didx: sm.didx,
        exp: tvoid(),
        a: out.a,
    )
    sm.decls.loop_at((i, d) {
        out = d.match ({
            .DGlobal(g)        => g.alias.match ({
                true  => out,
                false => {
                    key = sm.module.key_for("", g.name, .Global, g.pos)
                    ty = empty_env.sym_value_ty(g.ty, g.init)
                    out.sym_set_decl_type(key, out.sym_type_from_ty(sm, ty))
                },
            }),
            .DImpl(im)         => {
                receiver = out.sym_type_lookup(sm.module, im.ty)
                im.methods.loop_at((j, p) {
                    method = out.sym_find_method_module(sm.module.id, im.ty, p.name)
                    method.found.then({
                        out = out.sym_set_decl_type(method.key, receiver)
                    })
                })
                out
            },
            .DStruct(sd)       => sd.struct_is_trait().match ({
                true  => {
                    trait = out.sym_find_decl(sm.module.id, sd.name, .Type)
                    sd.fields.loop_at((j, field) {
                        method = out.sym_find_method_module(sm.module.id, sd.name, field.name)
                        method.found.then({
                            out = out.sym_set_decl_type(method.key, trait)
                        })
                    })
                    out
                },
                false => out,
            }),
            .DTraitDefault(td) => {
                trait = out.sym_find_decl(sm.module.id, td.trname, .Type)
                method = out.sym_find_method_module(sm.module.id, td.trname, td.fn.name)
                method.found.then({ out.sym_set_decl_type(method.key, trait) }, { out })
            },
            _                  => out,
        })
    })
    out
}
sym_add_impl_site = (b: SymBuild, sm: SymModule, im: ImplData) SymBuild {
    out ::= b
    receiver = out.sym_type_lookup(sm.module, im.ty)
    receiver.found.then({
        trait = out.sym_type_from_ty(sm, im.trty)
        has_trait = trait.found && trait.key.symbol_key_eq(receiver.key) == false
        methods ::= cbuf<ImplMethodSite>(out.a, im.methods.len)
        n ::= 0
        im.methods.loop_at((i, p) {
            declaration = out.sym_find_method_module(sm.module.id, im.ty, p.name)
            declaration.found.then({
                trait_method = has_trait.match ({
                    true  => out.sym_find_method_module(trait.key.module, trait.key.name, p.name),
                    false => SymLookup(
                        found: false,
                        key: symbol_key_none(),
                    ),
                })
                sm.module.sym_source_has_name(p.pos, p.name).then({
                    methods[n] = ImplMethodSite(
                        declaration: declaration.key,
                        has_trait_method: trait_method.found,
                        trait_method: trait_method.key,
                        span: sm.module.span_for(p.pos, p.name),
                    )
                    n = n + 1
                })
            })
        })
        site_ok ::= false
        site_span ::= SymbolSourceSpan(
            module: "",
            path: "",
            start: 0,
            end: 0,
        )
        sm.module.sym_source_has_name(im.pos, im.ty).match ({
            true  => {
                site_ok = true
                site_span = sm.module.span_for(im.pos, im.ty)
            },
            false => (n > 0).then({
                site_ok = true
                site_span = methods[0].span
            }),
        })
        trait_span_ok = has_trait && sm.module.sym_source_has_name(im.trait_pos, im.trname)
        trait_span = trait_span_ok.match ({
            true  => sm.module.span_for(im.trait_pos, im.trname),
            false => SymbolSourceSpan(
                module: "",
                path: "",
                start: 0,
                end: 0,
            ),
        })
        site_ok.then({
            out.implementations[out.impl_n] = ImplSite(
                receiver: receiver.key,
                has_trait: has_trait,
                trait: trait.key,
                span: site_span,
                has_trait_span: trait_span_ok,
                trait_span: trait_span,
                methods: slice(methods.ptr, n),
            )
            out.impl_n = out.impl_n + 1
        })
    })
    out
}
sym_collect_impl_sites = (b: SymBuild, sm: SymModule) SymBuild {
    out ::= b
    sm.decls.loop_at((i, d) {
        d.match ({
            .DImpl(im) => {
                out = out.sym_add_impl_site(sm, im)
            },
            _          => { },
        })
    })
    out
}
build_symbol_index* = (a: Allocator, p: ParsedProgram) SymbolIndex {
    modules = a.sym_modules(p)
    b ::= a.sym_build_new(modules)
    modules.loop_at((i, sm) { b = b.sym_collect_toplevel(sm) })
    modules.loop_at((i, sm) { b = b.sym_collect_decl_types(sm) })
    modules.loop_at((i, sm) { b = b.sym_collect_impl_sites(sm) })
    modules.loop_at((i, sm) { b = b.sym_walk_module(sm) })
    SymbolIndex(
        decls: b.sym_decl_view(),
        occurrences: b.sym_occ_view(),
        implementations: b.sym_impl_view(),
    )
}
resolve_symbol_index* = (
    a: Allocator,
    root: StringView,
    progdir: StringView,
    inpath: StringView,
    mainsrc: StringView,
    overlays: MutSlice<SourceOverlay>,
) SymbolIndex {
    a.build_symbol_index(a.resolve_parsed_program_overlays(root, progdir, inpath, mainsrc, overlays))
}
SymWalk: {
    build: SymBuild,
    env: Env,
    scope: Ptr<SymScope>,
}
SymCallTarget: {
    lookup: SymLookup,
    skip_first: bool,
}
sym_note = (
    b: SymBuild,
    m: ParsedModule,
    x: SymLookup,
    pos: i32,
    name: StringView,
    write: bool,
) SymBuild { x.found.then({ b.sym_add_occ(m, x.key, pos, name, false, write) }, { b }) }
sym_module_target = (b: SymBuild, module: StringView, name: StringView) SymLookup {
    f = b.sym_find_decl(module, name, .Function)
    f.found.match ({
        true  => f,
        false => {
            t = b.sym_find_decl(module, name, .Type)
            t.found.then({ t }, { b.sym_find_decl(module, name, .Global) })
        },
    })
}
sym_import_target = (b: SymBuild, m: ParsedModule, name: StringView, kind: SymbolKind) SymLookup {
    found ::= false
    ambiguous ::= false
    key ::= symbol_key_none()
    m.graph.imports.loop_at((i, e) {
        (e.namespace == false && m.source.edge_head_has_name(e.start, name)).then({
            candidate = b.sym_find_decl(e.module, name, kind)
            candidate.found.then({
                found.match ({
                    true  => (key.symbol_key_eq(candidate.key) == false).then({
                        ambiguous = true
                    }),
                    false => {
                        found = true
                        key = candidate.key
                    },
                })
            })
        })
    })
    (found && ambiguous == false).match ({
        true  => SymLookup(
            found: true,
            key: key,
        ),
        false => SymLookup(
            found: false,
            key: symbol_key_none(),
        ),
    })
}
sym_import_any = (b: SymBuild, m: ParsedModule, name: StringView) SymLookup {
    f = b.sym_import_target(m, name, .Function)
    f.found.match ({
        true  => f,
        false => {
            g = b.sym_import_target(m, name, .Global)
            g.found.then({ g }, { b.sym_import_target(m, name, .Type) })
        },
    })
}
sym_find_method_module = (
    b: SymBuild,
    module: StringView,
    owner: StringView,
    name: StringView,
) SymLookup {
    found ::= false
    ambiguous ::= false
    key ::= symbol_key_none()
    b
        .sym_decl_view()
        .loop_at((i, d) {
            (d.key.module.eq(module)
                && d.key.kind == .Method
                && d.key.owner.eq(owner)
                && d.name.eq(name)).then({
                found.match ({
                    true  => (key.symbol_key_eq(d.key) == false).then({
                        ambiguous = true
                    }),
                    false => {
                        found = true
                        key = d.key
                    },
                })
            })
        })
    (found && ambiguous == false).match ({
        true  => SymLookup(
            found: true,
            key: key,
        ),
        false => SymLookup(
            found: false,
            key: symbol_key_none(),
        ),
    })
}
sym_find_method_in = (b: SymBuild, m: ParsedModule, owner: StringView, name: StringView) SymLookup {
    own = b.sym_find_method_module(m.id, owner, name)
    own.found.match ({
        true  => own,
        false => {
            found ::= false
            ambiguous ::= false
            key ::= symbol_key_none()
            m.graph.imports.loop_at((i, e) {
                candidate = b.sym_find_method_module(e.module, owner, name)
                candidate.found.then({
                    found.match ({
                        true  => (key.symbol_key_eq(candidate.key) == false).then({
                            ambiguous = true
                        }),
                        false => {
                            found = true
                            key = candidate.key
                        },
                    })
                })
            })
            (found && ambiguous == false).match ({
                true  => SymLookup(
                    found: true,
                    key: key,
                ),
                false => SymLookup(
                    found: false,
                    key: symbol_key_none(),
                ),
            })
        },
    })
}
sym_call_target = (
    b: SymBuild,
    sm: SymModule,
    env: Env,
    scope: Ptr<SymScope>,
    c: CallData,
) SymCallTarget {
    local = scope.sym_scope_find(c.fn)
    local.found.then({
        return SymCallTarget(
            lookup: local,
            skip_first: false,
        )
    })
    (c.args.len > 0).then({
        load(c.args[0].addr()).match ({
            .Var(v) => sm.module.sym_namespace_edge(v.name).match ({
                .Some(edge) => {
                    target = b.sym_module_target(edge.module, c.fn)
                    target.found.then({
                        return SymCallTarget(
                            lookup: target,
                            skip_first: true,
                        )
                    })
                },
                .None       => {
                    recv = scope.sym_scope_type(v.name)
                    (recv.eq("") == false).then({
                        target = b.sym_find_method_in(sm.module, recv, c.fn)
                        target.found.then({
                            return SymCallTarget(
                                lookup: target,
                                skip_first: false,
                            )
                        })
                    })
                },
            }),
            _       => { },
        })
    })
    dispatched = env.dispatch_name(c)
    (dispatched.eq(c.fn) == false).then({
        target = b.sym_find_link_in(sm.module, dispatched)
        target.found.then({
            return SymCallTarget(
                lookup: target,
                skip_first: false,
            )
        })
    })
    target = b.sym_imported_decl(sm.module, c.fn, .Function)
    target.found.match ({
        true  => SymCallTarget(
            lookup: target,
            skip_first: false,
        ),
        false => SymCallTarget(
            lookup: b.sym_imported_decl(sm.module, c.fn, .Type),
            skip_first: false,
        ),
    })
}
sym_type_name = (b: SymBuild, m: ParsedModule, name: StringView) StringView {
    direct = b.sym_imported_decl(m, name, .Type)
    direct.found.then({
        return direct.key.name
    })
    found ::= ""
    ambiguous ::= false
    m.graph.imports.loop_at((i, e) {
        e.namespace.then({
            prefix = b.a.String(strlen(e.alias) + 3)
                .add(e.alias)
                .add("__")
                .finish_cstr()
            bare = name.starts_with(prefix).then({ cstr(offset(name, strlen(prefix))) }, { name })
            candidate = b.sym_find_decl(e.module, bare, .Type)
            candidate.found.then({
                found.eq("").match ({
                    true  => {
                        found = candidate.key.name
                    },
                    false => (found.eq(candidate.key.name) == false).then({
                        ambiguous = true
                    }),
                })
            })
        })
    })
    found.eq("").then({
        b
            .sym_decl_view()
            .loop_at((i, d) {
                suffix = b.a.String(strlen(d.name) + 3)
                    .add("__")
                    .add(d.name)
                    .finish_cstr()
                dotted = b.a.String(strlen(d.name) + 2)
                    .add(".")
                    .add(d.name)
                    .finish_cstr()
                (d.key.kind == .Type
                    && (d.name.eq(name) || name.ends_with(suffix) || name.ends_with(dotted))).then({
                    found.eq("").match ({
                        true  => {
                            found = d.key.name
                        },
                        false => (found.eq(d.key.name) == false).then({
                            ambiguous = true
                        }),
                    })
                })
            })
    })
    (ambiguous == false).then({ found }, { "" })
}
sym_type_lookup = (b: SymBuild, m: ParsedModule, name: StringView) SymLookup {
    direct = b.sym_imported_decl(m, name, .Type)
    direct.found.then({
        return direct
    })
    found ::= false
    ambiguous ::= false
    key ::= symbol_key_none()
    m.graph.imports.loop_at((i, e) {
        e.namespace.then({
            dotted = b.a.String(strlen(e.alias) + 2)
                .add(e.alias)
                .add(".")
                .finish_cstr()
            flat = b.a.String(strlen(e.alias) + 3)
                .add(e.alias)
                .add("__")
                .finish_cstr()
            bare = name.starts_with(dotted).match ({
                true  => cstr(offset(name, strlen(dotted))),
                false => name.starts_with(flat).then({ cstr(offset(name, strlen(flat))) }, { "" }),
            })
            (bare.eq("") == false).then({
                candidate = b.sym_find_decl(e.module, bare, .Type)
                candidate.found.then({
                    found.match ({
                        true  => (key.symbol_key_eq(candidate.key) == false).then({
                            ambiguous = true
                        }),
                        false => {
                            found = true
                            key = candidate.key
                        },
                    })
                })
            })
        })
    })
    (found == false).then({
        b
            .sym_decl_view()
            .loop_at((i, d) {
                suffix = b.a.String(strlen(d.name) + 3)
                    .add("__")
                    .add(d.name)
                    .finish_cstr()
                dotted = b.a.String(strlen(d.name) + 2)
                    .add(".")
                    .add(d.name)
                    .finish_cstr()
                (d.key.kind == .Type
                    && (d.name.eq(name) || name.ends_with(suffix) || name.ends_with(dotted))).then({
                    found.match ({
                        true  => (key.symbol_key_eq(d.key) == false).then({
                            ambiguous = true
                        }),
                        false => {
                            found = true
                            key = d.key
                        },
                    })
                })
            })
    })
    (found && ambiguous == false).match ({
        true  => SymLookup(
            found: true,
            key: key,
        ),
        false => SymLookup(
            found: false,
            key: symbol_key_none(),
        ),
    })
}
sym_type_from_ty = (b: SymBuild, sm: SymModule, ty: Ty) SymLookup {
    ty.match ({
        .Named(name) => b.sym_type_lookup(sm.module, name),
        .Generic(g)  => b.sym_type_lookup(sm.module, g.name),
        .Ptr(p)      => b.sym_type_from_ty(sm, load(p.pointee)),
        .Slice(p)    => b.sym_type_from_ty(sm, load(p.pointee)),
        _            => SymLookup(
            found: false,
            key: symbol_key_none(),
        ),
    })
}
sym_set_decl_type = (b: SymBuild, key: SymbolKey, ty: SymLookup) SymBuild {
    out ::= b
    ty.found.then({
        out
            .sym_decl_view()
            .loop_at((i, d) {
                d.key.symbol_key_eq(key).then({
                    out.decls[i] = SymbolDecl(
                        key: d.key,
                        name: d.name,
                        link_name: d.link_name,
                        span: d.span,
                        has_type: true,
                        type_key: ty.key,
                    )
                })
            })
    })
    out
}
sym_value_ty = (env: Env, declared: Ty, value: Ptr<Expr>) Ty {
    declared.match ({
        .Void => env.infer_expr(value),
        _     => declared,
    })
}
sym_expr_type = (
    b: SymBuild,
    sm: SymModule,
    env: Env,
    scope: Ptr<SymScope>,
    e: Ptr<Expr>,
) StringView {
    load(e).match ({
        .MakeStruct(d) => b.sym_type_name(sm.module, d.ty),
        .MakeEnum(d)   => b.sym_type_name(sm.module, d.ty),
        .Tag(d)        => b.sym_type_name(sm.module, d.ty),
        .Var(v)        => scope.sym_scope_type(v.name),
        .Call(c)       => {
            named = b.sym_type_name(sm.module, c.fn)
            named.eq("").match ({
                true  => {
                    target = b.sym_call_target(sm, env, scope, c)
                    (target.lookup.found && target.lookup.key.kind == .Type).match ({
                        true  => target.lookup.key.name,
                        false => b.sym_type_name(sm.module, env.infer_expr(e).recv_name()),
                    })
                },
                false => named,
            })
        },
        _              => b.sym_type_name(sm.module, env.infer_expr(e).recv_name()),
    })
}
sym_walk_exprs = (
    b: SymBuild,
    sm: SymModule,
    env: Env,
    scope: Ptr<SymScope>,
    owner: StringView,
    xs: MutSlice<Expr>,
    start: i64,
) SymBuild {
    out ::= b
    xs.loop_at((i, x) {
        (i >= start).then({
            out = out.sym_walk_expr(sm, env, scope, owner, x.addr(), false)
        })
    })
    out
}
sym_walk_body = (
    b: SymBuild,
    sm: SymModule,
    env: Env,
    scope: Ptr<SymScope>,
    owner: StringView,
    body: MutSlice<Stmt>,
) SymWalk {
    out ::= b
    en ::= env
    sc ::= scope
    body.loop_at((i, st) {
        st.match ({
            .Let(l)      => {
                out = out.sym_walk_expr(sm, en, sc, owner, l.value, false)
                key = sm.module.key_for(owner, l.name, .Let, l.pos)
                inferred = en.sym_value_ty(l.ty, l.value)
                type_decl = out.sym_type_from_ty(sm, inferred)
                lty = type_decl.found.match ({
                    true  => type_decl.key.name,
                    false => out.sym_expr_type(sm, en, sc, l.value),
                })
                out = out.sym_add_decl(sm.module, key, l.name, l.name)
                out = out.sym_set_decl_type(key, type_decl)
                sc = out.a.sym_scope_push(sc, key, lty)
                en = out.a.extend_env(en, st)
            },
            .Assign(x)   => {
                out = out.sym_walk_expr(sm, en, sc, owner, x.target, true)
                out = out.sym_walk_expr(sm, en, sc, owner, x.value, false)
            },
            .Return(e)   => {
                out = out.sym_walk_expr(sm, en, sc, owner, e, false)
            },
            .ExprStmt(e) => {
                out = out.sym_walk_expr(sm, en, sc, owner, e, false)
            },
            .If(x)       => {
                out = out.sym_walk_expr(sm, en, sc, owner, x.c, false)
                out = out.sym_walk_body(sm, en, sc, owner, x.then).build
                out = out.sym_walk_body(sm, en, sc, owner, x.els).build
            },
            .While(x)    => {
                out = out.sym_walk_expr(sm, en, sc, owner, x.c, false)
                out = out.sym_walk_body(sm, en, sc, owner, x.body).build
            },
            .IndexSet(x) => {
                out = out.sym_walk_expr(sm, en, sc, owner, x.seq, true)
                out = out.sym_walk_expr(sm, en, sc, owner, x.idx, false)
                out = out.sym_walk_expr(sm, en, sc, owner, x.value, false)
            },
        })
    })
    SymWalk(
        build: out,
        env: en,
        scope: sc,
    )
}
sym_walk_match = (
    b: SymBuild,
    sm: SymModule,
    env: Env,
    scope: Ptr<SymScope>,
    owner: StringView,
    subj: Ptr<Expr>,
    arms: MutSlice<ArmData>,
) SymBuild {
    out ::= b.sym_walk_expr(sm, env, scope, owner, subj, false)
    sty = env.infer_expr(subj)
    arms.loop_at((i, ar) {
        aenv = out.a.arm_env(env, sty, ar)
        asc ::= scope
        (ar.bind.eq("") == false).then({
            key = sm.module.key_for(owner, ar.bind, .Let, ar.bind_pos)
            out = out.sym_add_decl(sm.module, key, ar.bind, ar.bind)
            asc = out.a.sym_scope_push(asc, key, "")
        })
        out = out.sym_walk_expr(sm, aenv, asc, owner, ar.body, false)
    })
    out
}
sym_walk_loop = (
    b: SymBuild,
    sm: SymModule,
    env: Env,
    scope: Ptr<SymScope>,
    owner: StringView,
    l: LoopData,
) SymBuild {
    out ::= b.sym_walk_expr(sm, env, scope, owner, l.seq, false)
    sc ::= scope
    (l.idx.eq("") == false).then({
        key = sm.module.key_for(owner, l.idx, .Let, l.idx_pos)
        out = out.sym_add_decl(sm.module, key, l.idx, l.idx)
        sc = out.a.sym_scope_push(sc, key, "")
    })
    (l.elem.eq("") == false).then({
        key = sm.module.key_for(owner, l.elem, .Let, l.elem_pos)
        out = out.sym_add_decl(sm.module, key, l.elem, l.elem)
        sc = out.a.sym_scope_push(sc, key, "")
    })
    (l.h.eq("") == false).then({
        key = sm.module.key_for(owner, l.h, .Let, l.h_pos)
        out = out.sym_add_decl(sm.module, key, l.h, l.h)
        sc = out.a.sym_scope_push(sc, key, "")
    })
    out.sym_walk_body(sm, out.a.loop_env(env, l), sc, owner, l.body).build
}
sym_walk_lambda = (
    b: SymBuild,
    sm: SymModule,
    env: Env,
    scope: Ptr<SymScope>,
    owner: StringView,
    lm: LambdaData,
) SymBuild {
    ps = b.sym_add_params(sm, owner, lm.params, scope)
    lenv = Env(
        vars: b.a.bind_fnret(b.a.params_onto(lm.params, env.vars), lm.ret),
        decls: env.decls,
        didx: env.didx,
        exp: env.exp,
        a: env.a,
    )
    ps.build.sym_walk_body(sm, lenv, ps.scope, owner, lm.body).build
}
sym_walk_expr = (
    b: SymBuild,
    sm: SymModule,
    env: Env,
    scope: Ptr<SymScope>,
    owner: StringView,
    e: Ptr<Expr>,
    write: bool,
) SymBuild {
    load(e).match ({
        .Var(v)        => {
            local = scope.sym_scope_find(v.name)
            local.found.match ({
                true  => b.sym_note(sm.module, local, v.pos, v.name, write),
                false => {
                    g = b.sym_imported_decl(sm.module, v.name, .Global)
                    g.found.match ({
                        true  => b.sym_note(sm.module, g, v.pos, v.name, write),
                        false => b.sym_note(sm.module, b.sym_imported_decl(sm.module, v.name, .Function), v.pos, v.name, write),
                    })
                },
            })
        },
        .Call(c)       => {
            target = b.sym_call_target(sm, env, scope, c)
            out = b.sym_note(sm.module, target.lookup, c.pos, c.fn, false)
            out.sym_walk_exprs(sm, env, scope, owner, c.args, target.skip_first.then({ 1 }, { 0 }))
        },
        .Member(d)     => {
            qualified ::= false
            out ::= b
            load(d.obj).match ({
                .Var(v) => sm.module.sym_namespace_edge(v.name).match ({
                    .Some(edge) => {
                        qualified = true
                        out = out.sym_note(sm.module, out.sym_module_target(edge.module, d.field), d.pos, d.field, write)
                    },
                    .None       => { },
                }),
                _       => { },
            })
            qualified.then({ out }, { out.sym_walk_expr(sm, env, scope, owner, d.obj, false) })
        },
        .MakeEnum(d)   => b
            .sym_note(sm.module, b.sym_imported_decl(sm.module, d.ty, .Type), d.ty_pos, d.ty, false)
            .sym_walk_expr(sm, env, scope, owner, d.payload, false),
        .MakeStruct(d) => {
            out ::= b.sym_note(sm.module, b.sym_imported_decl(sm.module, d.ty, .Type), d.pos, d.ty, false)
            d.inits.loop_at((i, fi) {
                out = out.sym_walk_expr(sm, env, scope, owner, fi.value, false)
            })
            out
        },
        .Tag(d)        => b.sym_note(sm.module, b.sym_imported_decl(sm.module, d.ty, .Type), d.ty_pos, d.ty, false),
        .Match(m)      => b.sym_walk_match(sm, env, scope, owner, m.subj, m.arms),
        .Loop(l)       => b.sym_walk_loop(sm, env, scope, owner, l),
        .Lambda(lm)    => b.sym_walk_lambda(sm, env, scope, owner, lm),
        .Block(bk)     => b.sym_walk_body(sm, env, scope, owner, bk.stmts).build,
        _              => b.expr_fold_children(e, (acc, child) {
            acc.sym_walk_expr(sm, env, scope, owner, child, false)
        }, (acc, child_body) { acc.sym_walk_body(sm, env, scope, owner, child_body).build }),
    })
}
sym_walk_func = (b: SymBuild, sm: SymModule, f: Func, owner: StringView) SymBuild {
    ps = b.sym_add_params(sm, owner, f.params, b.a.sym_scope_nil())
    ps.build.sym_walk_body(sm, b.a.sym_initial_env(sm, f), ps.scope, owner, f.body).build
}
sym_walk_imports = (b: SymBuild, sm: SymModule) SymBuild {
    out ::= b
    sm.decls.loop_at((i, d) {
        d.match ({
            .DImport(imp) => imp.names.loop_at((j, p) {
                out = out.sym_note(sm.module, out.sym_import_any(sm.module, p.name), p.pos, p.name, false)
            }),
            _             => { },
        })
    })
    out
}
sym_walk_module = (b: SymBuild, sm: SymModule) SymBuild {
    out ::= b.sym_walk_imports(sm)
    sm.decls.loop_at((i, d) {
        out = d.match ({
            .DFunc(f)          => out.sym_function_key(sm, f).found.match ({
                true  => out.sym_walk_func(sm, f, f.name),
                false => out,
            }),
            .DGlobal(g)        => g.alias.match ({
                true  => out,
                false => {
                    env = Env(
                        vars: out.a.vnil(),
                        decls: sm.world,
                        didx: sm.didx,
                        exp: tvoid(),
                        a: out.a,
                    )
                    out.sym_walk_expr(sm, env, out.a.sym_scope_nil(), g.name, g.init, false)
                },
            }),
            .DTraitDefault(td) => {
                link = out.a.impl_cname_in(td.trname, td.trname, td.fn.name)
                out.sym_find_link_in(sm.module, link).found.match ({
                    true  => out.sym_walk_func(sm, td.fn, link),
                    false => out,
                })
            },
            _                  => out,
        })
    })
    out
}
