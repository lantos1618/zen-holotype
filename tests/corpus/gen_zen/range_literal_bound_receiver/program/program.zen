LoopHandle = {}
Range<T> = { start: usize, end: usize }
loop = <R, T>(range: R, body: (h: LoopHandle, value: T) ()) Res<T>

Window = { limit: usize }
Window.impl(Range<usize>, {
    start: (0),
    end: self.limit,
    at ::= (self: @Self, index: usize) Res<usize> {
        Ok(index + self.limit)
    }
})

make = () Window {
    println("receiver");
    Window(limit: 2)
}

main = () i32 {
    make().loop((h, value) { println("{}", value); });
    0
}
