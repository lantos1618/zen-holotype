// src/gen/gen_c/gen_c_state.zen
// What the C backend holds while it works.
//
// The split is `sema_check.zen`'s and for its reason: STATE here,
// BEHAVIOUR in the files beside it, so the dependency points one way
// and a lowering rule never has to import the thing lowering it.
//
// FIVE THINGS, and each one exists to keep the output a pure function
// of the input:
//
//   - THE TYPE WORKLIST is two parallel `Vec`s and not a `Map`, because
//     it is EMITTED. A `Map` cannot be walked in an order that survives
//     a different insertion sequence, and `gen_emit.order` sorts these
//     by mangled name — which is `tcode`, a pure function of the type.
//   - THE LOCAL SCOPE is a stack with marks, exactly as sema's is, plus
//     a per-function list of every name ever declared. The second one
//     is what gives a shadowing binding its number: `zu_l1x` and
//     `zu_l1x_2` are two C names for two Zen bindings that share a
//     spelling, and the number counts declarations rather than depth so
//     that leaving and re-entering a block cannot reuse one.
//   - THE TEMPORARY COUNTER is reset at every function, so a function's
//     temporaries depend on its own body and on nothing that was
//     compiled before it.
//   - THE HELPER SET records which integer types a checked operation
//     was emitted for, so the runtime carries one family per type the
//     program actually uses rather than all ten.
//   - THE BODY BUFFER is scratch. Bodies are lowered first because
//     lowering is what discovers which types and which helpers the
//     program needs; the translation unit is assembled afterwards, in
//     the order C requires.
//
// THE CHECKER IS TAKEN, NOT BORROWED. `Checker` owns `Vec`s and `Map`s,
// so a copy diverges from the original the first time either grows —
// the same reason `Parser` holds the `Ast` rather than handing it back.
// Hand it in at construction and read every answer back off the
// backend.

Ast, ExprId, Span = std.ast
str, String = std.text
Alloc, AllocError = std.mem
Vec = std.collections
Range = std.core
DeclId = sema.sema_id
TyId, Types = sema.sema_ty
World, Def = sema.sema_def
Checker = sema.sema_check
Inst = sema.sema_inst
Emit = gen.gen_emit
GenDiag, GenFault, render_gen = gen.gen_diag
LocalSlot, Closure, LoopFrame, DropEntry, BlockFrame = gen.gen_c.gen_c_frame

// One member function reached through a dot, and the receiver it was
// reached at.
//
// A `Def` cannot carry it: a member is not a top-level declaration and
// `World` never mints one for it. So the identity is written out —
// `qname` is the TYPE's qualified name plus the member's, which is what
// makes two types' `get` two symbols without a counter.
// AND THE SIGNATURE, because neither a name nor an arity is an identity
// here. A queue entry carrying only the NAME lowered `Cursor`'s `peek()`
// and `peek(ahead)` as one — the first body under both symbols, so one C
// symbol was defined twice and the other never. An ARITY is a projection
// and fails the same way: `Display` declares a `toString` taking a sink
// and a sealed one taking an allocator, both at arity two. What
// separates them is exactly what `sym_fn` mangles — the declared
// parameter types, receiver included — so the queue carries that and not
// a count of it.
MethodRef* = {
    self_ty*: TyId,
    decl*: DeclId,   // the declaration that owns the member
    name*: str,
    sig*: Vec<TyId>, // declared parameter types, RECEIVER INCLUDED
    qname*: str,
}

CBackend* = {
    tree*: Ast,
    check* :: Checker,

    // where a body is lowered. Scratch, one per function.
    buf :: Emit,

    diags :: Vec<GenDiag>,

    // the types this program needs a C definition for
    type_names* :: Vec<String>,
    type_ids* :: Vec<TyId>,
    type_done* :: Vec<bool>,

    // the integer types a checked `+ - * / %` was emitted for
    helper_types* :: Vec<String>,

    // The print floor is emitted only for a program that prints, exactly
    // as the checked-arithmetic families are emitted only for the types a
    // program computes on.
    print_used :: bool,

    // stderr's family, its own flag and not `print_used`: a program that
    // only narrates must not carry stdout's helpers either.
    stderr_used :: bool,

    // The two POSIX headers the FS floor needs are the one place the
    // emitted C leaves C99, so a program that never opens a file must not
    // pay for them.
    fs_used :: bool,

    // Its own flag and not `fs_used`: the stdin floor is plain C99
    // `fread` and the filesystem floor is the POSIX one — a program that
    // reads a pipe must not be handed `<sys/stat.h>` for it.
    stdin_used :: bool,

    // `getenv` is C99 too, and its floor is `static` — a program that
    // never reads a variable must not be handed an uncalled function to
    // warn about.
    env_used :: bool,

    // the functions to lower, and the ones already lowered. A QUEUE
    // rather than a list of every declaration because the walk is
    // reachability-driven — `gen_c_decl.zen`'s header says why.
    fn_queue* :: Vec<Def>,
    // the member functions reached through a dot. A second queue and
    // not a second kind of `Def`: a member has no top-level declaration
    // to mint one from, and `World` is the wrong place to teach that.
    m_queue* :: Vec<MethodRef>,
    // WHAT EACH QUEUED THING IS INSTANTIATED AT, parallel to the queue
    // beside it: a queue entry is a `(declaration, instantiation)` pair.
    // Carried rather than re-derived, because the symbol written at the
    // call site and the symbol written above the body have to be the
    // same bytes.
    fn_insts :: Vec<Inst>,
    m_insts :: Vec<Inst>,
    // the instantiation the function CURRENTLY being lowered is at.
    // Empty for everything that is not generic, which is what makes
    // `subst` cost one field read on the common path.
    inst* :: Inst,
    fn_seen :: Vec<String>,
    fn_names* :: Vec<String>,
    fn_protos* :: Vec<String>,
    fn_bodies* :: Vec<String>,
    // WHICH TRANSLATION UNIT EACH LOWERED FUNCTION BELONGS TO, parallel
    // to the three above and holding the MODULE INDEX of the body being
    // lowered when the function was kept. One file per module is 185
    // files of ~600 lines rather than one of 110,000, which a C
    // compiler compiles in parallel and a compiler cache can skip.
    //
    // A single-file emission never reads it. A thunk lands in the unit
    // of the first body that needed one, which is where the emission
    // order already puts its NUMBER, so this is no less deterministic
    // than the symbol is.
    fn_units* :: Vec<usize>,
    // the unit the lowering is writing into right now
    unit :: usize,
    // `false`: every function is `static` and the translation unit is
    // the whole program. `true`: a function is visible to the units
    // beside it, which is the one thing splitting the program costs.
    externs :: bool,

    // per function
    locals :: Vec<LocalSlot>,
    declared :: Vec<String>,
    // the loops open at this point in the lowering, innermost last
    loops :: Vec<LoopFrame>,
    // the blocks open at this point, innermost last, and every binding
    // they must destroy, flat and in DECLARATION order. One `Vec` with
    // a mark per block rather than a `Vec` of `Vec`s, which is the
    // shape the local scope stack above already uses.
    blocks :: Vec<BlockFrame>,
    drops :: Vec<DropEntry>,
    // The block record and its runtime are emitted only for a program
    // that defers, on the same rule as `print_used` above.
    scope_used :: bool,
    // one capture record per deferred closure that has captures, and
    // the count of closures lifted so far, which is what names them.
    // The count is program-wide rather than per function because the
    // thunks are program-wide: they are `static` functions of the one
    // translation unit, like every other function here.
    //
    // `defer_env_ids` IS NOT `0..defer_envs.len` and cannot be derived:
    // a closure that captures nothing gets a site number and no record,
    // so the records are a SUBSET of the sites and the union over them
    // has to name the numbers that exist.
    defer_envs :: Vec<String>,
    defer_env_ids :: Vec<usize>,
    defer_sites :: usize,
    // every lambda bound during this function, appended and never
    // popped: a `LocalSlot` names one by index and the index has to
    // outlive the scope the name was visible in, because the body is
    // lowered after the frame has been rewound past it.
    closures :: Vec<Closure>,
    // how many callees are open at this point. A bound, so a callee
    // that inlines itself reports rather than not terminating.
    depth* :: usize,
    // WHERE THE BODY BEING LOWERED BEGINS in `locals`. Inlining stacks
    // a callee's bindings on top of its caller's without hiding them,
    // and one decision must not see through the join: "a second `x =
    // ..` on a name already bound is an assignment" is a rule about one
    // function's own body, and read across the join it made an inlined
    // callee's `held = 77` store into a CALLER's `held` — for the rest
    // of the caller, not just for the call. Zero while a real function's
    // body is being lowered, which is what makes the common path free.
    floor* :: usize,
    tmp* :: usize,

    alloc*: Alloc,

    // -----------------------------------------------------------------
    // what came out
    // -----------------------------------------------------------------

    diag_count* = (self: @Self) usize { self.diags.len }

    diag_at* = (self: @Self, i: usize) Res<GenDiag> { self.diags.get(i) }

    render_diags* = (self: @Self, out :: String) Res<(), AllocError> {
        self.diags.loop((h, d) {
            render_gen(d, out).try();
            out.add_bytes("\n").try();
        });
        Ok(());
    }

    report* = (self :: @Self, file: str, span: Span, fault: GenFault)
              Res<(), AllocError> {
        self.diags.add(GenDiag(file: file, span: span, fault: fault))
    }

    // A fault raised against an expression, which is where almost every
    // one of them is raised. Saves each call site the two-line walk
    // back to the node for its position.
    report_expr* = (self :: @Self, id: ExprId, fault: GenFault)
                   Res<(), AllocError> {
        node = self.tree.expr_at(id);
        self.report(node.span.file, node.span, fault)
    }

    types* = (self: @Self) Types { self.check.types }

    world* = (self: @Self) World { self.check.world }

    // -----------------------------------------------------------------
    // the type worklist
    // -----------------------------------------------------------------

    // The name is the identity, because the name IS the type: `tcode` is
    // injective, so two types share a name exactly when they are one.
    type_index* = (self: @Self, name: str) Res<usize> {
        Range(0, self.type_names.len).find((i) {
            self.type_names.get(i).match({
                Ok(s) => s.view().eq(name),
                None  => false,
            })
        })
    }

    queue_type* = (self :: @Self, name: String, id: TyId)
                  Res<(), AllocError> {
        self.type_names.add(name).try();
        self.type_ids.add(id).try();
        self.type_done.add(false).try();
        Ok(());
    }

    type_name_at* = (self: @Self, i: usize) str {
        self.type_names.get(i).match({ Ok(s) => s.view(), None => "" })
    }

    type_id_at* = (self: @Self, i: usize) Res<TyId> { self.type_ids.get(i) }

    is_done* = (self: @Self, i: usize) bool {
        self.type_done.get(i).match({ Ok(d) => d, None => true })
    }

    mark_done* = (self :: @Self, i: usize) Res<(), AllocError> {
        self.type_done.set(i, true).match({
            None  => Err(AllocError.OutOfMemory),
            Ok(_) => Ok(()),
        })
    }

    // -----------------------------------------------------------------
    // the checked-arithmetic helpers
    // -----------------------------------------------------------------

    // A FAMILY and not a single helper: the eight are written by one
    // rule, and splitting them would make the runtime depend on which
    // operators a program happened to use — a lot of conditional
    // emission to save a few lines.
    need_helpers* = (self :: @Self, prim: str) Res<(), AllocError> {
        self.has_helpers(prim).match({
            false => self.add_helpers(prim),
            true  => Ok(()),
        })
    }

    has_helpers = (self: @Self, prim: str) bool {
        Range(0, self.helper_types.len).find((i) {
            self.helper_types.get(i).match({
                Ok(s) => s.view().eq(prim),
                None  => false,
            })
        }).match({ Ok(_) => true, None => false })
    }

    add_helpers = (self :: @Self, prim: str) Res<(), AllocError> {
        owned ::= self.alloc.String().try();
        owned.add_bytes(prim).try();
        self.helper_types.add(owned)
    }

    // -----------------------------------------------------------------
    // the print floor
    // -----------------------------------------------------------------

    need_print* = (self :: @Self) () { self.print_used = true; }

    uses_print* = (self: @Self) bool { self.print_used }

    // -----------------------------------------------------------------
    // the stderr floor
    //
    // A SECOND FLAG, NOT THE FIRST REUSED. `emit_print` writes stdout's
    // family, `emit_stderr` stderr's; sharing one bit would make a
    // program that only narrates carry every stdout helper it never
    // calls.
    // -----------------------------------------------------------------

    need_stderr* = (self :: @Self) () { self.stderr_used = true; }

    uses_stderr* = (self: @Self) bool { self.stderr_used }

    // -----------------------------------------------------------------
    // the filesystem floor
    // -----------------------------------------------------------------

    need_fs* = (self :: @Self) () { self.fs_used = true; }

    uses_fs* = (self: @Self) bool { self.fs_used }

    // -----------------------------------------------------------------
    // the stdin floor
    // -----------------------------------------------------------------

    need_stdin* = (self :: @Self) () { self.stdin_used = true; }

    uses_stdin* = (self: @Self) bool { self.stdin_used }

    // -----------------------------------------------------------------
    // the environment floor
    // -----------------------------------------------------------------

    need_env* = (self :: @Self) () { self.env_used = true; }

    uses_env* = (self: @Self) bool { self.env_used }

    // -----------------------------------------------------------------
    // the block stack, and what each block must destroy
    //
    // `gen_c_own.zen` owns the RULE; this owns the storage, exactly as
    // the loop stack below is stored here and read there.
    // -----------------------------------------------------------------

    need_scope* = (self :: @Self) () { self.scope_used = true; }

    uses_scope* = (self: @Self) bool { self.scope_used }

    next_defer* = (self :: @Self) usize {
        self.defer_sites = self.defer_sites + 1;
        self.defer_sites
    }

    add_defer_env* = (self :: @Self, text: String, n: usize)
                     Res<(), AllocError> {
        self.defer_envs.add(text).try();
        self.defer_env_ids.add(n).try();
        Ok(());
    }

    defer_env_count* = (self: @Self) usize { self.defer_envs.len }

    defer_env_at* = (self: @Self, i: usize) Res<String> {
        self.defer_envs.get(i)
    }

    defer_env_id* = (self: @Self, i: usize) usize {
        self.defer_env_ids.get(i).match({ Ok(n) => n, None => 0 })
    }

    open_block* = (self :: @Self, rec: usize) Res<(), AllocError> {
        self.blocks.add(BlockFrame(mark: self.drops.len, rec: rec))
    }

    // Leaving a block forgets its bindings. The cleanup was written
    // before this ran — closing the frame is bookkeeping, not an exit.
    close_block* = (self :: @Self) Res<(), AllocError> {
        self.blocks.take(self.blocks.len - 1).match({
            None  => Ok(()),
            Ok(f) => self.forget_drops(f.mark),
        })
    }

    forget_drops = (self :: @Self, mark: usize) Res<(), AllocError> {
        extra = self.drops.len - mark;
        Range(0, extra).loop((h, i) {
            self.drops.take(self.drops.len - 1);
        });
        Ok(());
    }

    block_depth* = (self: @Self) usize { self.blocks.len }

    block_at* = (self: @Self, i: usize) Res<BlockFrame> { self.blocks.get(i) }

    drop_count* = (self: @Self) usize { self.drops.len }

    drop_at* = (self: @Self, i: usize) Res<DropEntry> { self.drops.get(i) }

    own_binding* = (self :: @Self, e: DropEntry) Res<(), AllocError> {
        self.drops.add(e)
    }

    // -----------------------------------------------------------------
    // writing a body
    //
    // The buffer is NOT an exported field: `*` on a field means
    // readable outside the module and "mutation only ever goes through
    // exported methods", so these six are that. They also keep the
    // lowering files from knowing that a body is written through an
    // `Emit` at all.
    // -----------------------------------------------------------------

    write* = (self :: @Self, s: str) Res<(), AllocError> { self.buf.bytes(s) }

    writeln* = (self :: @Self, s: str) Res<(), AllocError> { self.buf.say(s) }

    // `be.fmt("zg_scope {};\n{}.zg_n = 0;\n", v, v)` — five `write`s as
    // one. Declared not defined, like every format door: `{}` resolves
    // by the ARGUMENT'S type, so the call is expanded where it is
    // written. Every piece goes through `write` above and answers
    // exactly what `write` answers, so nothing is converted — which is
    // what lets an `AllocError` body call it at all. NO IMPLICIT
    // NEWLINE, and a hole must be a `str`: `gen_c_floor.zen` holds the
    // contract.
    fmt* = (self :: @Self, fmt: str, args: ...) Res<(), AllocError>

    newline* = (self :: @Self) Res<(), AllocError> { self.buf.line() }

    indent* = (self :: @Self) () { self.buf.indent(); }

    dedent* = (self :: @Self) () { self.buf.dedent(); }

    text* = (self: @Self) str { self.buf.view() }

    // `dst = value;`. Built on the six above rather than a seventh way
    // into the buffer, and a method because every lowering already has
    // the backend — three files each wrote this statement out under a
    // name of its own (`assign`, `set_line`, `write_assign`).
    set_line* = (self :: @Self, dst: str, value: str) Res<(), AllocError> {
        self.fmt("{dst} = {value};\n")
    }

    // A fresh buffer, so each function's body is a function of its own
    // source and of nothing lowered before it.
    open_buf* = (self :: @Self) Res<(), AllocError> {
        self.buf = self.alloc.Emit().try();
        Ok(());
    }

    // A BODY LOWERED INSIDE ANOTHER BODY. A deferred closure is the one
    // closure that becomes a real C function rather than being inlined,
    // and it is discovered in the middle of the frame that registers
    // it — so the enclosing text is set aside and put back, which is
    // `detach`/`reattach` said about the buffer.
    take_buf* = (self :: @Self) Res<Emit, AllocError> {
        held     = self.buf;
        self.buf = self.alloc.Emit().try();
        Ok(held);
    }

    put_buf* = (self :: @Self, held: Emit) () { self.buf = held; }

    // -----------------------------------------------------------------
    // the function worklist
    // -----------------------------------------------------------------

    // Queue a function for lowering, once.
    //
    // THE MANGLED SYMBOL IS THE IDENTITY and the qualified name is not,
    // for two reasons that arrived together: `loop` has six declarations
    // under one qualified name and they are six functions, and
    // `Vec<i32>()` and `Vec<str>()` are two emissions of one declaration.
    // The symbol separates both, because it carries the signature and
    // the type arguments — which is the same string the call site just
    // wrote, so a queue hit means the caller is calling something
    // already queued and never something merely named alike.
    need_function* = (self :: @Self, d: Def, inst: Inst, sym: str)
                     Res<(), AllocError> {
        self.seen_function(sym).match({
            false => self.push_function(d, inst, sym),
            true  => Ok(()),
        })
    }

    seen_function = (self: @Self, sym: str) bool {
        Range(0, self.fn_seen.len).find((i) {
            self.fn_seen.get(i).match({
                Ok(s) => s.view().eq(sym),
                None  => false,
            })
        }).match({ Ok(_) => true, None => false })
    }

    // Queue a member function for lowering, once. The same `fn_seen`
    // set as a free function's, because the same rule applies and the
    // two name spaces cannot collide: a method's qualified name has a
    // TYPE where a function's has a module.
    need_method* = (self :: @Self, m: MethodRef, inst: Inst, sym: str)
                   Res<(), AllocError> {
        self.seen_function(sym).match({
            false => self.push_method(m, inst, sym),
            true  => Ok(()),
        })
    }

    // Claim a thunk's symbol, once. A thunk is not a Zen declaration —
    // it is the shim between an erased slot and the function an impl
    // supplies — so it has no queue entry, only a name that must be
    // written exactly once. The SAME set as a function's, because a
    // thunk is named after the function it calls and `zg_v` can never
    // collide with `zu_f`.
    need_thunk* = (self :: @Self, sym: str) Res<bool, AllocError> {
        self.seen_function(sym).match({
            true  => Ok(false),
            false => self.claim_thunk(sym),
        })
    }

    claim_thunk = (self :: @Self, sym: str) Res<bool, AllocError> {
        self.remember(sym).try();
        Ok(true);
    }

    push_method = (self :: @Self, m: MethodRef, inst: Inst, sym: str)
                  Res<(), AllocError> {
        self.remember(sym).try();
        self.m_queue.add(m).try();
        self.m_insts.add(inst).try();
        Ok(());
    }

    push_function = (self :: @Self, d: Def, inst: Inst, sym: str)
                    Res<(), AllocError> {
        self.remember(sym).try();
        self.fn_queue.add(d).try();
        self.fn_insts.add(inst).try();
        Ok(());
    }

    remember = (self :: @Self, sym: str) Res<(), AllocError> {
        owned ::= self.alloc.String().try();
        owned.add_bytes(sym).try();
        self.fn_seen.add(owned)
    }

    // What the i-th queued thing is instantiated at. An entry with no
    // row is not generic, which is what an empty `Inst` means.
    queued_inst* = (self: @Self, i: usize) Res<Inst> { self.fn_insts.get(i) }

    queued_m_inst* = (self: @Self, i: usize) Res<Inst> { self.m_insts.get(i) }

    // ENTERING AN INSTANTIATION IS NOT A STACK. A body is lowered to
    // completion before the next queue entry is popped — a call inside
    // it queues rather than recurses — so one field is the whole of the
    // state, and clearing it is what makes a non-generic body see no
    // substitution at all.
    enter_inst* = (self :: @Self, inst: Inst) () { self.inst = inst; }

    // One lowered function: its C name, its prototype and its body,
    // held apart so the three can be emitted in the order C wants and
    // sorted by the one key that is a pure function of the function.
    add_function* = (self :: @Self, name: String, proto: String,
                     body: String) Res<(), AllocError> {
        self.fn_names.add(name).try();
        self.fn_protos.add(proto).try();
        self.fn_bodies.add(body).try();
        self.fn_units.add(self.unit).try();
        Ok(());
    }

    // The unit every function kept from here on belongs to. Set once
    // per body, by the one place that knows which module the body was
    // declared in.
    enter_unit* = (self :: @Self, mi: usize) () { self.unit = mi; }

    unit_of* = (self: @Self, i: usize) usize {
        self.fn_units.get(i).match({ Ok(u) => u, None => 0 })
    }

    // Splitting the program across files means a call can cross one, so
    // nothing but `main` may keep internal linkage.
    use_externs* = (self :: @Self) () { self.externs = true; }

    // What goes in front of a function, prototype and definition alike.
    linkage* = (self: @Self) str {
        self.externs.match({
            true  => "",
            false => "static ",
        })
    }

    // -----------------------------------------------------------------
    // locals
    //
    // `mark` / `release` rather than a chain of frames, exactly as
    // sema's scope stack is: entering a block records where the stack
    // was, leaving it drops everything added since, and shadowing falls
    // out of walking from the top down.
    // -----------------------------------------------------------------

    mark* = (self: @Self) usize { self.locals.len }

    release* = (self :: @Self, mark: usize) Res<(), AllocError> {
        extra = self.locals.len - mark;
        Range(0, extra).loop((h, i) {
            self.locals.take(self.locals.len - 1);
        });
        Ok(());
    }

    // Introduce a binding, and answer with the number its C name
    // carries. Counting declarations rather than depth (header) is what
    // makes it unique inside the function: two sibling blocks each
    // binding `x` get 1 and 2.
    declare* = (self :: @Self, name: str, ty: TyId, by_ref: bool)
               Res<usize, AllocError> {
        n = self.reserve(name).try();
        self.publish(name, n, ty, by_ref).try();
        Ok(n);
    }

    // A NAME IS NOT IN SCOPE UNTIL ITS INITIALISER HAS BEEN LOWERED, so
    // the two halves of `declare` are separable: `reserve` takes the
    // number the C name carries, `publish` is what makes the name
    // RESOLVE to that slot. `gen_c_stmt.declare_local` is the one caller
    // that needs them apart, because `k: i32 ::= k + 1` shadowing an
    // outer `k` read the slot it was declaring — the initialiser's `k`
    // must still mean the binding it is shadowing.
    reserve* = (self :: @Self, name: str) Res<usize, AllocError> {
        n = self.declared_count(name) + 1;
        owned ::= self.alloc.String().try();
        owned.add_bytes(name).try();
        self.declared.add(owned).try();
        Ok(n);
    }

    publish* = (self :: @Self, name: str, n: usize, ty: TyId, by_ref: bool)
               Res<(), AllocError> {
        self.locals.add(LocalSlot(
            name: name,
            index: n,
            ty: ty,
            by_ref: by_ref,
            handle: 0,
            closure: 0
        )).try();
        Ok(());
    }

    // Bind a name to a lambda. Like a handle, it has no C storage: what
    // the name means is a body to inline, and the index is where it is
    // kept.
    declare_closure* = (self :: @Self, name: str, cl: Closure)
                       Res<(), AllocError> {
        self.closures.add(cl).try();
        self.locals.add(LocalSlot(
            name: name,
            index: 0,
            ty: cl.ret,
            by_ref: false,
            handle: 0,
            closure: self.closures.len
        )).try();
        Ok(());
    }

    closure_at* = (self: @Self, i: usize) Res<Closure> {
        self.closures.get(i - 1)
    }

    // -----------------------------------------------------------------
    // rewinding, for an inlined body
    //
    // `release` drops bindings; this MOVES them aside and puts them
    // back. A closure is lowered in the frame it was written in, which
    // is below the callee's own parameters — and those parameters are
    // still live afterwards, so they cannot be dropped.
    // -----------------------------------------------------------------

    detach* = (self :: @Self, mark: usize, saved :: Vec<LocalSlot>)
              Res<(), AllocError> {
        extra = self.locals.len - mark;
        Range(0, extra).loop((h, i) {
            self.locals.take(self.locals.len - 1).match({
                Ok(s) => saved.add(s).try(),
                None  => (),
            });
        });
        Ok(());
    }

    // `saved` came off the top, so it goes back bottom-first.
    reattach* = (self :: @Self, saved: Vec<LocalSlot>) Res<(), AllocError> {
        n = saved.len;
        Range(0, n).loop((h, i) {
            saved.get(n - i - 1).match({
                Ok(s) => self.locals.add(s).try(),
                None  => (),
            });
        });
        Ok(());
    }

    // Lower what follows as a DIFFERENT function's body, beginning at
    // `floor`. Written the way `enter_inst` is — the caller holds the
    // old value and hands it back — because the two are always entered
    // and left together.
    enter_frame* = (self :: @Self, floor: usize) () { self.floor = floor; }

    enter_call* = (self :: @Self) () { self.depth = self.depth + 1; }

    leave_call* = (self :: @Self) () { self.depth = self.depth - 1; }

    // Bind `h` to the loop it came from. A handle has no C storage and
    // no declaration is written for it: what the name means is a pair
    // of labels, and `depth` is where to read them.
    declare_handle* = (self :: @Self, name: str, ty: TyId, depth: usize)
                      Res<(), AllocError> {
        self.locals.add(LocalSlot(
            name: name,
            index: 0,
            ty: ty,
            by_ref: false,
            handle: depth,
            closure: 0
        ))
    }

    // -----------------------------------------------------------------
    // the loop stack
    //
    // A stack and not a field: `range.loop((h, r) { r.loop((g, c) { .. }) })`
    // has two loops open at once, and `h.break` in the inner body must
    // reach the outer one's labels rather than the innermost.
    // -----------------------------------------------------------------

    push_loop* = (self :: @Self, frame: LoopFrame) Res<(), AllocError> {
        self.loops.add(frame)
    }

    pop_loop* = (self :: @Self) Res<(), AllocError> {
        self.loops.take(self.loops.len - 1).match({
            Ok(_) => Ok(()),
            None  => Err(AllocError.OutOfMemory),
        })
    }

    loop_depth* = (self: @Self) usize { self.loops.len }

    // The frame a handle names. `depth` is 1-based, so it is also the
    // count of loops that were open when the handle was bound.
    loop_frame* = (self: @Self, depth: usize) Res<LoopFrame> {
        self.loops.get(depth - 1)
    }

    declared_count = (self: @Self, name: str) usize {
        n ::= 0;
        self.declared.loop((h, s) {
            s.view().eq(name).then(() { n = n + 1; });
        });
        n
    }

    // The innermost binding of `name`, or nothing. Walks from the top,
    // which is the only thing the ordering of this stack is for.
    slot_of* = (self: @Self, name: str) Res<LocalSlot> {
        n = self.locals.len;
        Range(0, n).find((k) {
            self.locals.get(n - k - 1).match({
                Ok(b) => b.name.eq(name),
                None  => false,
            })
        }).match({
            None  => None,
            Ok(k) => self.locals.get(n - k - 1),
        })
    }

    // Bound in THE BODY BEING LOWERED. `slot_of` answers for the whole
    // stack, which spans the caller of an inlined body — and the
    // caller's bindings are another function's, whatever they are
    // spelled.
    bound_in_frame* = (self: @Self, name: str) bool {
        Range(self.floor, self.locals.len).find((k) {
            self.locals.get(k).match({
                Ok(b) => b.name.eq(name),
                None  => false,
            })
        }).match({ Ok(_) => true, None => false })
    }

    // Everything a function's frame holds, dropped between functions.
    // The temporary counter is reset here and nowhere else.
    reset_frame* = (self :: @Self) Res<(), AllocError> {
        self.release(0).try();
        extra = self.declared.len;
        Range(0, extra).loop((h, i) {
            self.declared.take(self.declared.len - 1);
        });
        open = self.loops.len;
        Range(0, open).loop((h, i) {
            self.loops.take(self.loops.len - 1);
        });
        held = self.closures.len;
        Range(0, held).loop((h, i) {
            self.closures.take(self.closures.len - 1);
        });
        self.forget_drops(0).try();
        nested = self.blocks.len;
        Range(0, nested).loop((h, i) {
            self.blocks.take(self.blocks.len - 1);
        });
        self.depth = 0;
        self.floor = 0;
        self.tmp   = 0;
        Ok(());
    }

    next_tmp* = (self :: @Self) usize {
        self.tmp = self.tmp + 1;
        self.tmp
    }
}

// `alloc.CBackend(tree, check)` — a ufcs function whose first parameter
// is an Alloc, beside the type it builds, exactly as `Vec`, `Map`,
// `Ast`, `Types` and `Checker` are.
CBackend* = (a: Alloc, tree: Ast, check: Checker) Res<CBackend, AllocError> {
    Ok(CBackend(
        tree: tree,
        check: check,
        buf: a.Emit().try(),
        diags: a.Vec<GenDiag>(),
        type_names: a.Vec<String>(),
        type_ids: a.Vec<TyId>(),
        type_done: a.Vec<bool>(),
        helper_types: a.Vec<String>(),
        print_used: false,
        stderr_used: false,
        fs_used: false,
        stdin_used: false,
        env_used: false,
        scope_used: false,
        defer_envs: a.Vec<String>(),
        defer_env_ids: a.Vec<usize>(),
        defer_sites: 0,
        fn_queue: a.Vec<Def>(),
        m_queue: a.Vec<MethodRef>(),
        fn_insts: a.Vec<Inst>(),
        m_insts: a.Vec<Inst>(),
        inst: a.Inst(),
        fn_seen: a.Vec<String>(),
        fn_names: a.Vec<String>(),
        fn_protos: a.Vec<String>(),
        fn_bodies: a.Vec<String>(),
        fn_units: a.Vec<usize>(),
        unit: 0,
        externs: false,
        locals: a.Vec<LocalSlot>(),
        declared: a.Vec<String>(),
        loops: a.Vec<LoopFrame>(),
        blocks: a.Vec<BlockFrame>(),
        drops: a.Vec<DropEntry>(),
        closures: a.Vec<Closure>(),
        depth: 0,
        floor: 0,
        tmp: 0,
        alloc: a,
    ));
}
