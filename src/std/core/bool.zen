// std.core.bool
//
// The one-sided conditional: `.match` is always exhaustive, so `then`
// is the honest word for "nothing on the false side" rather than a
// dropped arm. Lands in Res — Ok(v) when true, None when false — so
// it composes with `.try()`, `ok_or`, `.match`:
//
//   (n > 0).then(() { n * 2 }).ok_or(Error.NotPositive).try();
//
// `Eq` is imported and not inherited from the prelude: this file IS
// part of the prelude, and the impl at the foot of it needs the name.
Eq = std.core.eq

// A plain UFCS function (first param is bool), not an impl on bool —
// `b.then(..)` and `then(b, ..)` are the same call.
then* = <T>(b: bool, f: () T) Res<T> {
    b.match({
        true  => Ok(f()),
        false => None,
    });
}

// Turn an asserted condition into the caller's error type. Unlike
// `then(() {}).ok_or(reason)`, this does not manufacture an optional unit
// only to translate its absence, and reads directly at guard sites.
ensure* = <E>(b: bool, reason: E) Res<(), E> {
    b.match({
        true  => Ok(()),
        false => Err(reason),
    });
}

// `true` or `false`; a `.match` on it is always exhaustive.
//
// There is no MIN/MAX/BITS to declare: the type's whole contents are
// its two literals. The declaration exists so the prelude has
// something to SAY about the name (DESIGN.md:438 — a prelude
// declaration of a primitive's name IS that primitive): hover reads
// the line above, and the body declares nothing, which is the truth.
bool* = {}

// The same equality every integer gets in std.core.num, for the same
// reason and with the same non-effect on `==`: a bound is the only way
// to say "this type has equality", and a `bool` that cannot satisfy
// `<T: Eq>` makes that promise unwritable about the one type whose
// whole contents are two values.
//
// HERE and not in std.core.eq: an impl is only consulted through the
// module that declares its target, and `bool` is declared above.
bool.impl(Eq, { eq ::= (self: @Self, other: @Self) bool { self == other } })
