// tests/corpus/std/map_str_keys_find_values.zen
// str is Eq + Hash, which is what Env.vars (Map<str, str>) already
// requires. equal bytes are the same key even though the two str
// values are different bindings

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    ages ::= alloc.Map<str, i32>();

    ages.set("ada", 36).try();
    ages.set("grace", 45).try();

    ages.get("ada").match({
        Ok(n) => println("ada {}", n),
        None  => println("ada missing"),
    })
    ages.get("grace").match({
        Ok(n) => println("grace {}", n),
        None  => println("grace missing"),
    })
    Ok(0);
}
