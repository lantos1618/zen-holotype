// tests/corpus/parse/stmt_termination.zen
// a statement ends with `;`. a declaration does not. that is the
// whole rule — no newline sensitivity, no insertion.

Error = | Failed

// declarations: no semicolon
Point = { x: i32, y: i32 }

Kind = Small | Large

double* = (n: i32) i32 { n * 2 }

main = (env: Env) Res<i32, Error> {
    // statements: semicolon, including one whose expression ends
    // in `})` — the case DESIGN.md's own examples used to omit
    a = double(4);
    p = Point(x: 1, y: 2);

    label = (a == 8).match({
        true  => "eight",
        false => "other",
    });
    println("{} {}", label, p.x);

    // this is why the rule exists: without the `;` above, a line
    // beginning `(` would parse as a call of the previous line
    (a > 0).then(() { println("positive") });

    Ok(0);
}
