// src/sema/sema_module.zen
// What a name QUALIFIED BY A MODULE means.
//
// DESIGN.md § Modules: "names are qualified by path, imports bind
// locally, and two modules may define the same top-level name without
// colliding" — so `a.value` and `ab.value` are two declarations, and
// the module is half the question.
//
// Not `sema_member.zen`'s subject: that's what a dot reaches on a TYPE
// (field, constant, method, impl member — one member table). A module
// has no member table, receiver, or layout.
//
// The whole problem: a module alias is not spelled. `sh = shape` and
// `Alias = Shape` parse to the same `Alias` node (grammar R1a reads a
// bare RHS as an alias), so nothing syntactic tells a module from a
// type — every question below starts by deciding which it's looking at.

Ast, Expr, Access, Ident, Span, TypeId, Named = ast
Decl, DeclKind, Alias, Function, Param = ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
DeclId = sema.sema_id
TyId, Ty, Types = sema.sema_ty
World, Def, DefKind, decl_at, module_display = sema.sema_def
SemaFault, ExportFault = sema.sema_diag
Checker, Ctx = sema.sema_check
type_from_ast, param_type, def_type, decl_as_type = sema.sema_type

// The module a base names, when the base is an alias for one.
module_named_by* = (c :: Checker, ty: TyId) Res<usize> {
    c.types.at(ty).match({
        Named(n) => c.alias_module(n.decl),
        _        => None,
    })
}

// The module a declaration aliases, if it aliases one. Filters mirror
// `zen_build.alias_of`'s and must stay in sync — a loader that fetches
// a module sema then refuses is a program whose meaning depends on
// which pass you ask.
alias_module* = (c :: Checker, id: DeclId) Res<usize> {
    decl_at(c.tree, id).match({
        None  => None,
        Ok(x) => x.kind.match({
            Alias(al) => alias_target(c, al, id),
            _         => None,
        }),
    })
}

// A parameterised alias is a type constructor rather than a name for a
// module, and `Vec<u8>` names no module either: a module path takes no
// type arguments.
alias_target = (c :: Checker, al: Alias, id: DeclId) Res<usize> {
    (al.tparams.len == 0).match({
        false => None,
        true  => alias_target_type(c, al.target, id),
    })
}

alias_target_type = (c :: Checker, t: TypeId, id: DeclId) Res<usize> {
    c.tree.type_at(t).kind.match({
        Named(n) => module_for_target(c, n, id),
        _        => None,
    })
}

// A type of that name wins: `Alias = Shape` stays a type alias even
// beside a module called `Shape`, asked from the module that wrote the
// alias since that's whose scope decided what it meant.
module_for_target = (c :: Checker, n: Named, id: DeclId) Res<usize> {
    names_a_type(c, n.name.text, id.module.to_usize()).match({
        true  => None,
        false => target_module(c, n),
    })
}

target_module = (c :: Checker, n: Named) Res<usize> {
    (n.args.len == 0).match({
        false => None,
        true  => c.world.index_of(n.name.text),
    })
}

names_a_type = (c :: Checker, name: str, mi: usize) bool {
    found ::= c.alloc.Vec<Def>();
    c.world.defs_of(mi, name, found).match({
        Err(_) => true,
        Ok(_)  => found.len > 0,
    })
}

// A module has no value; a bare one is a mistake wherever it stands
// (`println("{}", zz)`, `reseat(3)`) — both used to reach the backend as
// "a value of this type" or "not a function". Reported at the USE, not
// the binding, since the same binding read qualified is legal. Poisons
// rather than fails, like every report here.
module_not_a_value* = (c :: Checker, span: Span, name: str, mi: usize)
                     Res<TyId, AllocError> {
    c.report(span.file, span,
             SemaFault.ModuleNotAValue(ExportFault(
                 name: name, module: module_name(c, mi)))).try();
    c.types.unknown()
}

// `sh.reseat` / `a.beta_Gamma`: reaches exactly what that module STARRED
// (`exported_defs` not `defs_of`), so qualifying through an alias isn't
// a way around the gate a plain import would hit.
module_access* = (c :: Checker, node: Expr, ac: Access, mi: usize)
                Res<TyId, AllocError> {
    found ::= c.alloc.Vec<Def>();
    c.world.exported_defs(mi, ac.name.text, found).try();
    found.get(0).match({
        None  => not_exported(c, ac, mi),
        Ok(d) => module_def_type(c, d),
    })
}

// A function reached through a module is its SIGNATURE, not a nominal
// type of its own name — else `println("{}", sh.reseat(3))` prints a
// value of no type. A struct is its CONSTRUCTOR, same as a payload
// variant: `sh.Bag(len: 1)` is a call node, like `sema_static
// .variant_ctor` for `Slot.Left(cell)`.
//
// KNOWN GAP: that constructor takes no declared parameters. Construction
// is by NAME, fields checked where a bare `Bag(len: 1)` is; this path
// doesn't reach that yet.
module_def_type = (c :: Checker, d: Def) Res<TyId, AllocError> {
    d.kind.match({
        FunctionDef => module_fn_type(c, d),
        StructDef   => module_ctor_type(c, d),
        _           => c.def_type(d),
    })
}

module_ctor_type = (c :: Checker, d: Def) Res<TyId, AllocError> {
    ty = c.decl_as_type(d).try();
    params ::= c.alloc.Vec<TyId>();
    c.types.fn_ty(params, ty)
}

module_fn_type = (c :: Checker, d: Def) Res<TyId, AllocError> {
    decl_at(c.tree, d.id).match({
        None  => c.types.unknown(),
        Ok(x) => x.kind.match({
            Function(f) => decl_fn_type(c, d, f),
            _           => c.types.unknown(),
        }),
    })
}

// Read in the DECLARING module's scope: a parameter's written type names
// what that file could see, not what the caller can. No written return
// type means `()` — the declaration's meaning, not a hole to infer.
decl_fn_type = (c :: Checker, d: Def, f: Function) Res<TyId, AllocError> {
    poison = c.types.unknown().try();
    ctx = Ctx(d.id.module.to_usize(), poison);
    ptys ::= c.alloc.Vec<TyId>();
    f.params.loop((h, p) { ptys.add(c.param_type(p, ctx).try()).try() });
    rty = ret_type(c, f, ctx).try();
    c.types.fn_ty(ptys, rty)
}

ret_type = (c :: Checker, f: Function, ctx: Ctx) Res<TyId, AllocError> {
    f.ret.match({
        Ok(t) => c.type_from_ast(t, ctx),
        None  => c.types.prim("()"),
    })
}

not_exported = (c :: Checker, ac: Access, mi: usize)
              Res<TyId, AllocError> {
    c.report(ac.name.span.file, ac.name.span,
             SemaFault.NotExported(ExportFault(
                 name: ac.name.text, module: module_name(c, mi)))).try();
    c.types.unknown()
}

module_name = (c :: Checker, mi: usize) str {
    c.world.table_at(mi).match({
        Ok(t) => module_display(t.name),
        None  => "",
    })
}
