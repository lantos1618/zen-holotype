// Every unsigned/signed parser reads decimal bytes through core.byte's one
// digit_value helper. Pin each domain at a valid edge and reject the next
// value or a non-digit so a parser cannot silently keep its old private table.

main = (env: Env) i32 {
    i32_max  = "2147483647".parse_i32().match({
        Ok(n) => n == i32.MAX, None => false,
    });
    i32_min  = "-2147483648".parse_i32().match({
        Ok(n) => n == i32.MIN, None => false,
    });
    i32_over = "2147483648".parse_i32().match({
        Ok(_) => false, None => true,
    });
    println("i32 {} {} {}", i32_max, i32_min, i32_over);

    u16_max  = "65535".parse_u16().match({
        Ok(n) => n == u16.MAX, None => false,
    });
    u16_over = "65536".parse_u16().match({
        Ok(_) => false, None => true,
    });
    println("u16 {} {}", u16_max, u16_over);

    usize_ok   = "4096".parse_usize().match({
        Ok(n) => n == 4096, None => false,
    });
    usize_word = "40x6".parse_usize().match({
        Ok(_) => false, None => true,
    });
    println("usize {} {}", usize_ok, usize_word);
    0
}
