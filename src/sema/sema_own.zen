Expr, ExprId, Block, BlockId, Stmt, Bind = std.ast
Decl, Member, Function, Param = std.ast
Call, Arg, Access, Match, Arm, Lambda, Index, Consume = std.ast
Span, Name, Paren, Try, Unary, Binary = std.ast
Record, FixedArray, Field, Const = std.ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId = sema.sema_ty
Checker, Ctx, UNRESOLVED, truncate = sema.sema_check
SemaFault, NameFault = sema.sema_diag
check_receiver, check_write_place = sema.sema_recv
check_scope_returned, check_scope_stored = sema.sema_scope
check_scope_captured, is_scope_value, call_escapes = sema.sema_scope
check_arena_returned, is_arena_backed = sema.sema_scope
scope_alias = sema.sema_scope
Pin, pin_captured, refuse_pinned, refuse_pinned_at = sema.sema_pin
check_drop_copy = sema.sema_drop
is_handle_ty, refuse_handle_at, spelled_name = sema.sema_handle
spelled_lambda = sema.sema_call

OwnVar* = {
    name*: str,
    ty*: TyId,
    mutable*: bool,
    owned*: bool,
    scoped*: bool,
    arena*: bool,
    span*: Span,
}

// A moved-out place: a binding, or one field of it.
Place* = {
    root*: usize,
    field*: str,
    span*: Span,
}

// One body's ownership frame. `vars` is a scope stack indexed by
// declaration order; `escaped` is the index above which bindings were
// declared inside an escaping closure, 0 while no closure is open.
Own* = {
    vars :: Vec<OwnVar>,
    dead :: Vec<Place>,
    pinned* :: Vec<Pin>,
    escaped* :: usize,
    method* :: str,
    body* :: BlockId,
    alloc*: Alloc,

    // The innermost binding of `text`, as an index into `vars`.
    find_var* = (self: @Self, text: str) Res<usize> {
        n = self.vars.len;
        Range(0, n).find((k) {
            self.vars.get(n - k - 1).match({
                Ok(v) => v.name.eq(text),
                None  => false,
            })
        }).match({
            None  => None,
            Ok(k) => Ok(n - k - 1),
        })
    }

    var_at = (self: @Self, text: str) Res<OwnVar> {
        self.find_var(text).match({ None => None, Ok(i) => self.vars.get(i) })
    }

    // A name this frame does not bind is a global, which is writable.
    var_mutable* = (self: @Self, text: str) bool {
        self.var_at(text).match({ None => true, Ok(v) => v.mutable })
    }

    var_type* = (self: @Self, text: str) TyId {
        self.var_at(text).match({ None => UNRESOLVED, Ok(v) => v.ty })
    }

    scoped_var* = (self: @Self, text: str) bool {
        self.var_at(text).match({ None => false, Ok(v) => v.scoped })
    }

    // Whether this name is, or views into, an arena this frame made.
    arena_var* = (self: @Self, text: str) bool {
        self.var_at(text).match({ None => false, Ok(v) => v.arena })
    }

    // A `@scope` binding read from inside an escaping closure.
    captures_scope* = (self: @Self, text: str) bool {
        self.find_var(text).match({
            None  => false,
            Ok(i) => (i < self.escaped) && self.scoped_at(i),
        })
    }

    scoped_at = (self: @Self, i: usize) bool {
        self.vars.get(i).match({ Ok(v) => v.scoped, None => false })
    }

    owned_at* = (self: @Self, root: usize) bool {
        self.vars.get(root).match({ Ok(v) => v.owned, None => false })
    }

    is_dead = (self: @Self, root: usize, field: str) bool {
        self.dead.find((p) { (p.root == root) && p.field.eq(field) })
            .match({ Ok(_) => true, None => false })
    }

    has_dead_field = (self: @Self, root: usize) bool {
        self.dead.find((p) { (p.root == root) && (p.field.len > 0) })
            .match({ Ok(_) => true, None => false })
    }

    kill = (self :: @Self, root: usize, field: str, span: Span)
           Res<(), AllocError> {
        self.dead.add(Place(root: root, field: field, span: span))
    }

    // A write fills the hole.
    revive = (self :: @Self, root: usize, field: str) Res<(), AllocError> {
        self.dead = self.dead.filter(self.alloc, (p) {
            ((p.root == root) && p.field.eq(field)) == false
        }).ok_or(AllocError.OutOfMemory).try();
        Ok(());
    }

    // Move out every place killed since `mark`.
    take_dead = (self :: @Self, mark: usize, out :: Vec<Place>)
                Res<(), AllocError> {
        Range(mark, self.dead.len).loop((h, i) {
            self.dead.get(i).match({
                Ok(p) => out.add(p).try(),
                None  => (),
            });
        });
        self.dead.truncate(mark);
        Ok(());
    }

    // Drop the bindings declared since `mark`, and every dead place or
    // pin rooted at one of them.
    release = (self :: @Self, mark: usize) Res<(), AllocError> {
        self.dead   = self.dead.filter(self.alloc, (p) { p.root < mark })
            .ok_or(AllocError.OutOfMemory).try();
        self.pinned = self.pinned.filter(self.alloc, (p) { p.root < mark })
            .ok_or(AllocError.OutOfMemory).try();
        self.vars.truncate(mark);
        Ok(());
    }
}

Own* = (a: Alloc) Res<Own, AllocError> {
    Ok(Own(
        vars: a.Vec<OwnVar>(),
        dead: a.Vec<Place>(),
        pinned: a.Vec<Pin>(),
        escaped: 0,
        method: "",
        body: BlockId(index: 0),
        alloc: a
    ));
}

check_own* = (c :: Checker, f: Function, body: BlockId, ctx: Ctx)
             Res<(), AllocError> {
    o ::= c.alloc.Own().try();
    o.method = receiver_method(f, ctx);
    o.body   = body;
    c.own_params(o, f).try();
    c.own_block(o, body, ctx).try();
    Ok(());
}

receiver_method = (f: Function, ctx: Ctx) str {
    (ctx.has_self && first_param_is_self(f)).match({
        true  => f.name.text,
        false => "",
    })
}

first_param_is_self = (f: Function) bool {
    f.params.get(0).match({
        None  => false,
        Ok(p) => p.name.text.eq("self"),
    })
}

own_params = (c :: Checker, o :: Own, f: Function) Res<(), AllocError> {
    f.params.loop((h, p) { c.own_param(o, p).try() });
    Ok(());
}

own_param = (c :: Checker, o :: Own, p: Param) Res<(), AllocError> {
    text = p.name.text;
    ty   = c.lookup(text).match({ Ok(b) => b.ty, None => UNRESOLVED });
    o.vars.add(OwnVar(
        name: text,
        ty: ty,
        mutable: p.mutable,
        owned: false,
        scoped: false,
        arena: false,
        span: p.name.span
    ))
}

// the walk
own_block = (c :: Checker, o :: Own, id: BlockId, ctx: Ctx)
            Res<(), AllocError> {
    b    = c.tree.block_at(id);
    mark = o.vars.len;
    b.stmts.loop((h, s) { c.own_stmt(o, s, ctx).try() });
    b.value.match({
        Ok(v) => c.own_expr(o, v, ctx),
        None  => Ok(()),
    }).try();
    c.check_scope_returned(o, id, b).try();
    c.check_arena_returned(o, id, b).try();
    c.check_partial_moves(o, mark).try();
    o.release(mark).try();
    Ok(());
}

own_stmt = (c :: Checker, o :: Own, s: Stmt, ctx: Ctx) Res<(), AllocError> {
    s.kind.match({
        Bind(b)  => c.own_bind(o, b, ctx),
        Expr(e)  => c.own_expr(o, e.expr, ctx),
        Block(x) => c.own_block(o, x, ctx),
        Decl(_)  => Ok(()),
    })
}

// The value is read before the target is written: `f = consume f` reads
// a live `f` and leaves a dead one.
own_bind = (c :: Checker, o :: Own, b: Bind, ctx: Ctx) Res<(), AllocError> {
    c.own_expr(o, b.value, ctx).try();
    c.check_drop_copy(o, b, ctx).try();
    c.own_target(o, b, ctx).try();
    Ok(());
}

own_target = (c :: Checker, o :: Own, b: Bind, ctx: Ctx)
             Res<(), AllocError> {
    node = c.tree.expr_at(b.target);
    c.check_write_place(o, b.target).try();
    node.kind.match({
        Name(n)   => c.bind_name(o, b, n.text, node.span, ctx),
        Access(a) => c.revive_field(o, a, ctx),
        _         => c.own_expr(o, b.target, ctx),
    })
}

bind_name = (
    c    :: Checker,
    o    :: Own,
    b    : Bind,
    text : str,
    span : Span,
    ctx  : Ctx
) Res<(), AllocError> {
    o.find_var(text).match({
        Ok(i) => o.revive(i, ""),
        None  => c.declare_var(o, b, text, span, ctx),
    })
}

declare_var = (
    c    :: Checker,
    o    :: Own,
    b    : Bind,
    text : str,
    span : Span,
    ctx  : Ctx
) Res<(), AllocError> {
    o.vars.add(OwnVar(
        name: text,
        ty: c.memo_type(b.value),
        mutable: b.mutable,
        owned: true,
        scoped: c.is_scope_value(b.value) || c.scope_alias(o, b.value),
        arena: c.is_arena_backed(o, b.value),
        span: span
    ))
}

revive_field = (c :: Checker, o :: Own, a: Access, ctx: Ctx)
               Res<(), AllocError> {
    c.path_root(o, a.base).match({
        None  => Ok(()),
        Ok(i) => o.revive(i, a.name.text),
    }).try();
    c.own_expr(o, a.base, ctx).try();
    Ok(());
}

own_expr = (c :: Checker, o :: Own, id: ExprId, ctx: Ctx)
           Res<(), AllocError> {
    node = c.tree.expr_at(id);
    node.kind.match({
        Name(n)       => c.use_name(o, node, id, n.text),
        Access(a)     => c.use_access(o, node, id, a, ctx),
        Consume(x)    => c.own_consume(o, x, ctx),
        Call(k)       => c.own_call(o, id, k, ctx),
        Match(m)      => c.own_match(o, m, ctx),
        Lambda(l)     => c.own_lambda(o, l, ctx, false, false),
        Block(b)      => c.own_block(o, b, ctx),
        Paren(p)      => c.own_expr(o, p.inner, ctx),
        Try(t)        => c.own_try(o, t, ctx),
        Unary(u)      => c.own_expr(o, u.operand, ctx),
        Binary(bi)    => c.own_binary(o, bi, ctx),
        Index(x)      => c.own_pair(o, x.base, x.index, ctx),
        Array(a)      => c.own_elems(o, a.elems, ctx),
        FixedArray(a) => c.own_elems(o, a.elems, ctx),
        Record(r)     => c.own_record(o, r.entries, ctx),
        _             => Ok(()),
    })
}

// A left-leaning operator chain is walked iteratively, leftmost first.
own_binary = (c :: Checker, o :: Own, first: Binary, ctx: Ctx)
             Res<(), AllocError> {
    rights ::= o.alloc.Vec<ExprId>();
    left   ::= first.lhs;
    done   ::= false;
    rights.add(first.rhs).try();
    loop(() { done == false }, (h) {
        c.tree.expr_at(left).kind.match({
            Binary(next) => {
                rights.add(next.rhs).try();
                left = next.lhs;
            },
            _            => { done = true; },
        });
    });
    c.own_expr(o, left, ctx).try();
    Range(0, rights.len).loop((h, i) {
        c.opt_expr(o, rights.get(rights.len - 1 - i), ctx).try();
    });
    Ok(())
}

own_try = (c :: Checker, o :: Own, t: Try, ctx: Ctx)
          Res<(), AllocError> {
    c.own_expr(o, t.operand, ctx).try();
    c.opt_expr(o, t.error, ctx)
}

own_pair = (c :: Checker, o :: Own, a: ExprId, b: ExprId, ctx: Ctx)
           Res<(), AllocError> {
    c.own_expr(o, a, ctx).try();
    c.own_expr(o, b, ctx).try();
    Ok(());
}

own_elems = (c :: Checker, o :: Own, elems: Vec<ExprId>, ctx: Ctx)
            Res<(), AllocError> {
    elems.loop((h, e) { c.own_expr(o, e, ctx).try() });
    Ok(());
}

own_record = (c :: Checker, o :: Own, entries: Vec<Member>, ctx: Ctx)
             Res<(), AllocError> {
    entries.loop((h, m) { c.own_member_value(o, m, ctx).try() });
    Ok(());
}

own_member_value = (c :: Checker, o :: Own, m: Member, ctx: Ctx)
                   Res<(), AllocError> {
    m.kind.match({
        Field(f)    => c.opt_expr(o, f.value, ctx),
        Const(k)    => c.own_expr(o, k.value, ctx),
        Function(_) => Ok(()),
    })
}

opt_expr = (c :: Checker, o :: Own, e: Res<ExprId>, ctx: Ctx)
           Res<(), AllocError> {
    e.match({ Ok(x) => c.own_expr(o, x, ctx), None => Ok(()) })
}

// A moved place cannot be used again.
use_name = (c :: Checker, o :: Own, node: Expr, id: ExprId, text: str)
           Res<(), AllocError> {
    c.check_scope_captured(o, node.span, text).try();
    c.pin_captured(o, node, text).try();
    c.refuse_handle_captured(o, id, text).try();
    o.find_var(text).match({
        None  => Ok(()),
        Ok(i) => c.report_if_dead(o, node.span, i, ""),
    })
}

use_access = (
    c    :: Checker,
    o    :: Own,
    node : Expr,
    id   : ExprId,
    a    : Access,
    ctx  : Ctx
) Res<(), AllocError> {
    c.refuse_handle_captured(o, id, c.spelled_name(a.base)).try();
    c.path_root(o, a.base).match({
        None  => Ok(()),
        Ok(i) => c.report_if_dead(o, node.span, i, a.name.text),
    }).try();
    c.own_expr(o, a.base, ctx).try();
    Ok(());
}

report_if_dead = (
    c     :: Checker,
    o     :: Own,
    span  : Span,
    root  : usize,
    field : str
) Res<(), AllocError> {
    o.is_dead(root, field).match({
        false => Ok(()),
        true  => c.report_consumed(o, span, root, field),
    })
}

report_consumed = (
    c     :: Checker,
    o     :: Own,
    span  : Span,
    root  : usize,
    field : str
) Res<(), AllocError> {
    name = c.place_name(o, root, field).try();
    c.refuse(span, SemaFault.ConsumedUse(NameFault(name: name)))
}

// `consume` moves only a place owned by the current frame.
own_consume = (c :: Checker, o :: Own, x: Consume, ctx: Ctx)
              Res<(), AllocError> {
    node = c.tree.expr_at(x.operand);
    node.kind.match({
        Index(_)  => c.refuse(
            node.span,
            SemaFault.ConsumeNotAPlace(NameFault(name: ""))
        ),
        Name(n)   => c.consume_name(o, x.operand, n.text),
        Access(a) => c.consume_field(o, node, a, ctx),
        _         => c.own_expr(o, x.operand, ctx),
    })
}

consume_name = (c :: Checker, o :: Own, id: ExprId, text: str)
               Res<(), AllocError> {
    node = c.tree.expr_at(id);
    c.use_name(o, node, id, text).try();
    c.refuse_pinned(o, node.span, text).try();
    o.find_var(text).match({
        None  => Ok(()),
        Ok(i) => o.kill(i, "", node.span),
    }).try();
    Ok(());
}

consume_field = (c :: Checker, o :: Own, node: Expr, a: Access, ctx: Ctx)
                Res<(), AllocError> {
    c.path_root(o, a.base).match({
        None  => c.own_expr(o, a.base, ctx),
        Ok(i) => c.consume_field_of(o, node, a, i),
    })
}

consume_field_of = (
    c    :: Checker,
    o    :: Own,
    node : Expr,
    a    : Access,
    root : usize
) Res<(), AllocError> {
    o.owned_at(root).match({
        false => c.refuse(
            node.span,
            SemaFault.ConsumeThroughHandle(NameFault(name: a.name.text))
        ),
        true  => c.kill_field(o, node, a, root),
    })
}

kill_field = (c :: Checker, o :: Own, node: Expr, a: Access, root: usize)
             Res<(), AllocError> {
    c.report_if_dead(o, node.span, root, a.name.text).try();
    c.refuse_pinned_at(o, node.span, root).try();
    o.kill(root, a.name.text, node.span).try();
    Ok(());
}

check_partial_moves = (c :: Checker, o :: Own, mark: usize)
                      Res<(), AllocError> {
    Range(mark, o.vars.len).loop((h, i) {
        c.check_partial_move(o, i).try();
    });
    Ok(());
}

check_partial_move = (c :: Checker, o :: Own, i: usize)
                     Res<(), AllocError> {
    (o.has_dead_field(i) && (o.is_dead(i, "") == false)).match({
        false => Ok(()),
        true  => c.report_partial(o, i),
    })
}

report_partial = (c :: Checker, o :: Own, i: usize) Res<(), AllocError> {
    o.vars.get(i).match({
        None  => Ok(()),
        Ok(v) => c.refuse(
            v.span,
            SemaFault.PartiallyMoved(NameFault(name: v.name))
        ),
    })
}

// calls: the receiver rule, `@scope` as an argument, and closure bodies
own_call = (c :: Checker, o :: Own, id: ExprId, k: Call, ctx: Ctx)
           Res<(), AllocError> {
    c.check_receiver(o, k, ctx).try();
    c.check_scope_stored(id, k).try();
    c.own_expr(o, k.callee, ctx).try();
    c.own_args(o, k, ctx).try();
    Ok(());
}

own_args = (c :: Checker, o :: Own, k: Call, ctx: Ctx)
           Res<(), AllocError> {
    repeats = c.repeating_body(k);
    escapes = c.call_escapes(o, k);
    k.args.loop((h, a) { c.own_arg(o, a, repeats, escapes, ctx).try() });
    Ok(());
}

own_arg = (
    c       :: Checker,
    o       :: Own,
    a       : Arg,
    repeats : bool,
    escapes : bool,
    ctx     : Ctx
) Res<(), AllocError> {
    c.spelled_lambda(a.value).match({
        Ok(l) => c.own_lambda(o, l, ctx, repeats, escapes),
        None  => c.own_expr(o, a.value, ctx),
    })
}

// Every lambda argument but a `.then` body may run more than once.
repeating_body = (c :: Checker, k: Call) bool {
    c.tree.expr_at(k.callee).kind.match({
        Access(a) => a.name.text.eq("then") == false,
        _         => true,
    })
}

own_lambda = (
    c       :: Checker,
    o       :: Own,
    l       : Lambda,
    ctx     : Ctx,
    repeats : bool,
    escapes : bool
) Res<(), AllocError> {
    dmark     = o.dead.len;
    vmark     = o.vars.len;
    outer     = o.escaped;
    o.escaped = (escapes && (outer == 0)).match({
        false => outer,
        true  => vmark,
    });
    l.params.loop((h, p) { c.own_param(o, p).try() });
    c.own_block(o, l.body, ctx).try();
    o.escaped = outer;
    o.release(vmark).try();
    repeats.then(() { c.report_back_edge(o, dmark).try() });
    Ok(());
}

// Everything moved inside the body that outlives it names a binding the
// body did not declare, and a second run would read it dead.
report_back_edge = (c :: Checker, o :: Own, dmark: usize)
                   Res<(), AllocError> {
    Range(dmark, o.dead.len).loop((h, i) {
        c.report_moved_again(o, i).try();
    });
    Ok(());
}

report_moved_again = (c :: Checker, o :: Own, i: usize)
                     Res<(), AllocError> {
    o.dead.get(i).match({
        None  => Ok(()),
        Ok(p) => c.report_consumed(o, p.span, p.root, p.field),
    })
}

// match: each arm starts from the scrutinee's state, and a place any arm
// moved is dead after the match.
own_match = (c :: Checker, o :: Own, m: Match, ctx: Ctx)
            Res<(), AllocError> {
    c.own_expr(o, m.scrutinee, ctx).try();
    dmark = o.dead.len;
    joined ::= c.alloc.Vec<Place>();
    m.arms.loop((h, a) {
        c.own_expr(o, a.body, ctx).try();
        o.take_dead(dmark, joined).try();
    });
    joined.loop((h, p) { o.dead.add(p).try() });
    Ok(());
}

// The binding a place path is rooted at, or nothing when the path is not
// one this frame names.
path_root* = (c :: Checker, o :: Own, id: ExprId) Res<usize> {
    node = c.tree.expr_at(id);
    node.kind.match({
        Name(n)   => o.find_var(n.text),
        Paren(p)  => c.path_root(o, p.inner),
        Access(a) => c.path_root(o, a.base),
        _         => None,
    })
}

// A loop handle read from inside an escaping closure.
refuse_handle_captured = (c :: Checker, o :: Own, id: ExprId, text: str)
                         Res<(), AllocError> {
    o.find_var(text).match({
        None  => Ok(()),
        Ok(i) => ((i < o.escaped) && c.is_handle_ty(c.memo_type(id))).match({
            false => Ok(()),
            true  => c.refuse_handle_at(id),
        }),
    })
}

// `p.left`, joined: the place the author wrote, and the only spelling
// that says which half of `p` is gone.
place_name* = (c :: Checker, o :: Own, root: usize, field: str)
             Res<str, AllocError> {
    base = o.vars.get(root).match({ Ok(v) => v.name, None => "" });
    (field.len == 0).match({
        true  => Ok(base),
        false => c.dotted_name(base, field),
    })
}

dotted_name = (c :: Checker, base: str, field: str) Res<str, AllocError> {
    out ::= c.alloc.String("{base}.{field}").try();
    Ok(out.view());
}

memo_type = (c :: Checker, id: ExprId) TyId {
    c.expr_memo.get(id).match({ Ok(ty) => ty, None => UNRESOLVED })
}

// A place's type: recorded for a name, memoized for everything else.
place_type* = (c :: Checker, o :: Own, id: ExprId) TyId {
    node = c.tree.expr_at(id);
    node.kind.match({
        Name(n)  => o.var_type(n.text),
        Paren(p) => c.place_type(o, p.inner),
        _        => c.memo_type(id),
    })
}
