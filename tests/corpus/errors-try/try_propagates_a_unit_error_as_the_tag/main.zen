// A unit error has no C payload member, so `.try()` propagates only its tag.
maybe = (b: bool) Res<i32, ()> {
    b.match({
        true  => Err(()),
        false => Ok(3),
    });
}

inner = (b: bool) Res<i32, ()> {
    v = maybe(b).try();
    Ok(v + 2)
}

main = (env: Env) Res<i32, ()> {
    inner(false).match({
        Ok(v)  => println("got {}", v),
        Err(u) => println("got 0"),
    });
    inner(true).match({
        Ok(v)  => println("wrong ok {}", v),
        Err(u) => println("raised"),
    });
    Ok(0);
}
