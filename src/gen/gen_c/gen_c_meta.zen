// Lowers a checked meta field walk into one C block per field. `field.name`
// becomes the current field's string and `recv.at(field)` reuses ordinary
// field access lowering. `break` exits the walk; `next` exits one pass.

ExprId, Access, Call, Ident, Lambda = std.ast
AllocError = std.mem
Vec = std.collections
str, String = std.text
TyId = sema.sema_ty
Ctx = sema.sema_check
CBackend = gen.gen_c.gen_c_state
LoopFrame = gen.gen_c.gen_c_frame
unsupported = gen.gen_c.gen_c_report
block, Dest = gen.gen_c.gen_c_stmt
lower_access = gen.gen_c.gen_c_read
write_label = gen.gen_c.gen_c_loop
spelled_lambda = gen.gen_c.gen_c_inline

// A field walk is an effect expression and therefore writes unit to `out`.
lower_meta_walk* = (
    be    :: CBackend,
    id    : ExprId,
    c     : Call,
    names : Vec<str>,
    ctx   : Ctx,
    out   :: String
) Res<(), AllocError> {
    out.add("0").try();
    (names.len == 0).match({
        true  => Ok(()),
        false => c.args.get(0).match({
            None  => be.unsupported(id, "a field walk with no body", out),
            Ok(a) => be.spelled_lambda(a.value).match({
                None    => be.unsupported(id, "a field walk with no body", out),
                Ok(lam) => be.walk_unrolled(lam, names, ctx),
            }),
        }),
    })
}

// Every pass shares the final break label.
walk_unrolled = (
    be    :: CBackend,
    lam   : Lambda,
    names : Vec<str>,
    ctx   : Ctx
) Res<(), AllocError> {
    brk  = be.next_tmp();
    unit = be.check.types.prim("()").try();
    names.loop((h, fname) {
        be.walk_pass(brk, lam, fname, unit, ctx).try();
    });
    be.write_label("brk", brk).try();
    be.writeln(": ;").try();
    Ok(())
}

// Each pass gets a C scope so body locals may be redeclared safely.
walk_pass = (
    be    :: CBackend,
    brk   : usize,
    lam   : Lambda,
    fname : str,
    unit  : TyId,
    ctx   : Ctx
) Res<(), AllocError> {
    be.writeln("{").try();
    be.indent();
    lmark = be.mark();
    cmark = be.check.mark();
    cnt   = be.next_tmp();
    be.push_loop(LoopFrame(
        brk: brk,
        cnt: cnt,
        result: "",
        has_result: false,
        ty: unit,
        depth: be.block_depth()
    )).try();
    be.bind_walk_params(lam).try();
    be.check.push_walk_now(fname).try();
    block(be, lam.body, ctx, unit, Dest.Discard).try();
    be.check.pop_walk_now();
    be.write_label("cnt", cnt).try();
    be.writeln(": ;").try();
    be.pop_loop().try();
    be.check.release(cmark).try();
    be.release(lmark).try();
    be.dedent();
    be.writeln("}").try();
    Ok(())
}

// The handle stores the loop-frame depth. Field uses were folded by sema and
// need no runtime slot.
bind_walk_params = (be :: CBackend, lam: Lambda) Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    lam.params.get(0).match({
        None  => Ok(()),
        Ok(p) => {
            be.declare_handle(p.name.text, unknown, be.loop_depth()).try();
            be.check.bind(p.name.text, unknown, false, false)
        },
    }).try();
    lam.params.get(1).match({
        None  => Ok(()),
        Ok(p) => be.check.bind(p.name.text, unknown, false, false),
    }).try();
    Ok(())
}

// Rewrite the current meta projection as an ordinary field access. A marker
// outside a field walk indicates an internal dispatch error.
lower_meta_proj* = (
    be   :: CBackend,
    id   : ExprId,
    a    : Access,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    be.check.walk_field_now().match({
        None     => be.unsupported(
            id,
            "a field projection with no walk on the lowering stack",
            out
        ),
        Ok(name) => {
            access = Access(
                base: a.base,
                name: Ident(text: name, span: a.name.span)
            );
            be.lower_access(id, access, ctx, want, out)
        },
    })
}
