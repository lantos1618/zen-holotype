// compiler.check_validate — read the resolved AST and count type errors.
// This pass validates calls, fields, matches, operands, indices, returns, assignment, and traits.
{ Expr, Stmt, Decl, Func, Param, Ty, StructDecl, EnumDecl, GenEnumDecl, GenericData, Field, ImplData, TraitDefData, ArmData, MatchData, BlockData, LetData, VariantDef, AssignData, IndexSetData, IndexData, CallData, MethodCallData, LambdaData, BinData, MakeStructData, FieldInit, FnTData, GlobalData, is_fnt, has_fnt_param, is_expr_null, subst_ty_in, call, arm, dforeign, impl_cname_in, no_tys, ti32, ti64, tu8, tf64, tbool, tstring_view, tnamed, tptr, tptr_k, tslice, tvoid, k_raw_ptr, k_mut_ptr, ptr_kw, gstr_string, gstr_append, gstr_finish, gstr_push } = compiler.genc
{ Env, DeclIndex, build_decl_index, env_func, env_gstruct, idx_func, infer_expr, fits, ty_eq, is_str_t, ty_rank, is_f64_ty, enum_name, recv_name, call_targ, is_lit_numeric, is_void_ty, the_func, fn_params, params_env, bind_tparams, tparam_declared, empty_params, tag_const, extend_env, arm_env, subj_variant_payload, is_bound, is_local, var_or_global, no_stmts, resolve_module, dbuf, tnode, loop_env, rc_calls_body, is_readonly_ptr_ty, is_nullable_ptr_ty, is_nonnull_ptr_ty, is_ptr_ty_g, is_raw_ptr_ty, mode_fits, ptr_kind_of, write_thru_readonly, lvalue_writes_readonly, is_intrinsic, AliasCands, alias_ufcs_candidates } = compiler.check
{ Token, scan } = compiler.lex
{ Allocator, Malloc } = std.mem.alloc
{ expect } = std.core.result
{ Map, of } = std.collections.map    // DeclIndex fields are Map<i64>; .get/.put are UFCS methods, not imports
{ at, is_alnum } = std.text.bytes
{ eq, is_empty, starts_with, ends_with } = std.text.str
{ String } = std.text.string
// Local fn is known iff the_func finds it by name (sentinel name is ""). The linear `is_known_fn`
// remains for the few decls-only callers; Env-reachable sites use `env_known_fn` (O(1) via the index).
is_known_fn = (decls: [Decl], fn: string_view) bool { eq(decls.the_func(fn).name, fn) }
env_known_fn = (env: Env, fn: string_view) bool { eq(env.env_func(fn).name, fn) }
env_params = (env: Env, fn: string_view) [Param] { env.env_func(fn).params }
// O(1) indexed forms of the linear is_trait_method / is_imported scans below (same presence result:
// tmethod_idx folds every DImpl.methods name + every DTraitDefault fn name; import_idx every DImport name).
env_trait_method = (env: Env, fn: string_view) bool { env.didx.tmethod_idx.get(fn, 0 - 1) >= 0 }
env_imported = (env: Env, fn: string_view) bool { env.didx.import_idx.get(fn, 0 - 1) >= 0 }
env_is_gen_struct = (env: Env, name: string_view) bool { env.didx.genstruct_idx.get(name, 0 - 1) >= 0 }
env_is_gen_enum = (env: Env, name: string_view) bool { env.didx.genenum_idx.get(name, 0 - 1) >= 0 }
// O(1) indexed struct presence/field lookups (Env carries the decl index).
env_is_struct = (env: Env, name: string_view) bool { env.didx.struct_idx.get(name, 0 - 1) >= 0 }
// A CONCRETE enum (`DEnum`) by name — enums carry variants, not fields, so `e.field` on one is always
// a mistake (you reach variants via `.match`). Generic enums (Result) are caught via cv_is_gen_enum.
env_is_enum = (env: Env, name: string_view) bool { env.didx.enum_idx.get(name, 0 - 1) >= 0 }
env_struct_fields = (env: Env, name: string_view) [Field] {
    i := env.didx.struct_idx.get(name, 0 - 1)
    (i >= 0 && i < env.decls.len).match ({
        true  => env.decls[i].match ({
            .DStruct(sd) => sd.fields,
            _            => no_fields(),
        }),
        false => no_fields(),
    })
}
// O(1) for concrete struct/enum names (the common case); only generics fall back to the linear scan.
// A tparam name in scope (threaded into env.vars by bind_tparams) is ABSTRACT — it shadows any global
// type of the same name inside its own fn body, so a user type `T` cannot make a stdlib generic's `T`
// tparam look concrete. Only fires when a marker is present; ordinary generics (no colliding user type)
// resolve exactly as before, because `T` was never a declared struct/enum to begin with.
env_named_declared = (env: Env, n: string_view) bool {
    env.vars.tparam_declared(n).match ({
        true  => false,
        false => (env.didx.struct_idx.get(n, 0 - 1) >= 0 || env.didx.enum_idx.get(n, 0 - 1) >= 0).match ({
            true  => true,
            false => env.decls.named_declared(n),
        }),
    })
}
// Uninferable types are skipped so validation does not false-reject imported/generic residue.
is_uninferable = (t: Ty) bool {
    t.match ({
        .Void     => true,
        .Slice(e) => load(e).is_void_ty(),
        .Ptr(pd)  => load(pd.pointee).is_void_ty(),
        _         => false,
    })
}
// Undeclared Named types are treated as uninferable template residue.
named_declared = (decls: [Decl], n: string_view) bool {
    found := false
    decls.loop((h, i, d) {
        found = d.match ({
            .DStruct(sd)   => eq(sd.name, n).match ({ true => true, false => found }),
            .DEnum(ed)     => eq(ed.name, n).match ({ true => true, false => found }),
            .DGenStruct(g) => eq(g.name, n).match ({ true => true, false => found }),
            .DGenEnum(g)   => eq(g.name, n).match ({ true => true, false => found }),
            _              => found,
        })
    })
    found
}
// A type the validator can't pin down concretely, so fit-checks against it stay lenient: an
// uninferable residue, an UNDECLARED Named (a generic type param like `T`), a Ptr/Slice WHOSE element
// is itself unknown (`Ptr<T>`, `[T]`), or a generic INSTANCE (`Result<Mailbox, IoError>`) whose
// concrete decl only exists after monomorphization.
// the narrow int/float widths arrive as Named("u32") etc. (no Ty variant), but they ARE valid
// primitives that genc lowers to C types — so the unknown-type pass must treat them as KNOWN.
is_prim_width = (n: string_view) bool { eq(n, "i8") || eq(n, "i16") || eq(n, "u16") || eq(n, "u32") || eq(n, "u64") || eq(n, "f32") }
unknown_ty = (env: Env, t: Ty) bool {
    t.is_uninferable().match ({
        true  => true,
        false => t.match ({
            .Named(n)   => env.env_named_declared(n).match ({ true => false, false => true }),
            .Ptr(pd)    => env.unknown_ty(load(pd.pointee)),
            .Slice(e)   => env.unknown_ty(load(e)),
            // A generic instance is unknown ONLY while a type-arg is still unresolved (an unbound
            // tparam / void residue): its concrete decl appears only after that arg is pinned. Once
            // EVERY arg is concrete (`Box<i32>`), the instance is fully known and its mangled name
            // (`Box_i32`) is authoritative — so a real arg mismatch (`Box<i32>` vs `Box<u8>`) is a Zen
            // fit error here instead of leaking a `Box_u8` unknown-type to cc.
            .Generic(g) => env.gen_args_unknown(g.args),
            _           => false,
        }),
    })
}
gen_args_unknown = (env: Env, args: [Ty]) bool {
    f := false
    args.loop((h, i, t) {
        f = env.unknown_ty(t).match ({ true => true, false => f })
    })
    f
}
// FnT-vs-FnT signature compatibility: same arity, each param type and the return type equal —
// EXCEPT a position whose type is unknown (an unbound tparam like `S`, generic residue) stays lenient,
// since its concrete type is only known after monomorphization. (Function pointers are not implicitly
// convertible in C, so the CONCRETE positions demand exact structural equality.)
fnt_pos_eq = (env: Env, g: Ty, w: Ty) bool { env.unknown_ty(g) || env.unknown_ty(w) || g.ty_eq(w) }
fnt_tys_eq = (env: Env, ga: [Ty], wa: [Ty], i: i64) bool {
    (i >= ga.len).match ({
        true  => true,
        false => env.fnt_pos_eq(ga[i], wa[i]).match ({
            true  => env.fnt_tys_eq(ga, wa, i + 1),
            false => false,
        }),
    })
}
fnt_sig_fits = (env: Env, g: Ty, w: Ty) bool {
    g.match ({
        .FnT(ga) => w.match ({
            .FnT(wa) => (ga.params.len == wa.params.len).match ({
                true  => env.fnt_tys_eq(ga.params, wa.params, 0).match ({
                    true  => env.fnt_pos_eq(load(ga.ret), load(wa.ret)),
                    false => false,
                }),
                false => false,
            }),
            _        => false,
        }),
        _        => false,
    })
}
fit_err = (env: Env, argty: Ty, pty: Ty) i32 {
    // An FnT param/field requires a matching FnT argument (named or lifted fn-value): wrong arity /
    // concrete param-type / return, or a non-fn value, is an error. Uninferable args (lambdas infer to
    // void, generic residue) stay lenient, as do tparam-typed FnT positions (deferred to mono).
    env.unknown_ty(argty).match ({
        true  => 0,
        false => pty.is_fnt().match ({
            true  => env.fnt_sig_fits(argty, pty).match ({ true => 0, false => 1 }),
            false => fits(argty, pty).match ({ true => 0, false => 1 }),
        }),
    })
}
// Constant-fold a numeric literal expr: an `.Int`, or a +/-/* of folded literals — a negative literal
// like `-1` lowers to the Bin `0 - 1`, so folding is what lets unsigned slots reject negatives.
// ok=false when not a foldable integer constant (Byte/Cond/var/shift/…) → range checks stay lenient.
//
// `v` is the i64 BIT PATTERN of the literal. A u64 magnitude above i64-max (e.g. u64 MAX) overflows
// `v` to a negative i64, so `v < 0` alone cannot tell a written magnitude from a real negative. `neg`
// records the SEMANTIC sign: a bare `.Int` is a non-negative written magnitude (neg=false) even when
// `v` wrapped negative; only a subtraction/negation that yields a negative result sets neg=true. That
// lets `x: u64 := 18446744073709551615` fit while `x: u64 := -1` (i.e. `0 - 1`) is still rejected.
LitVal*: {
    ok: bool,
    v: i64,
    neg: bool,
}
lit_binop = (op: string_view, l: i64, r: i64) LitVal {
    eq(op, "+").match ({
        true  => LitVal(
            ok: true,
            v: l + r,
            neg: l + r < 0,
        ),
        false => eq(op, "-").match ({
            true  => LitVal(
                ok: true,
                v: l - r,
                neg: l - r < 0,
            ),
            false => eq(op, "*").match ({
                true  => LitVal(
                    ok: true,
                    v: l * r,
                    neg: l * r < 0,
                ),
                false => LitVal(
                    ok: false,
                    v: 0,
                    neg: false,
                ),
            }),
        }),
    })
}
lit_val = (e: Ptr<Expr>) LitVal {
    load(e).match ({
        .Int(n) => LitVal(
            ok: true,
            v: n,
            neg: false,
        ),
        .Bin(b) => {
            l := b.lhs.lit_val()
            r := b.rhs.lit_val()
            (l.ok && r.ok).match ({
                true  => lit_binop(b.op, l.v, r.v),
                false => LitVal(
                    ok: false,
                    v: 0,
                    neg: false,
                ),
            })
        },
        _       => LitVal(
            ok: false,
            v: 0,
            neg: false,
        ),
    })
}
// The narrow widths arrive as Named("i8")/Named("u32")/… (no Ty variant); range-check them by name.
// u64 holds values an i64 can't represent as a positive `n`, so its upper bound cannot be checked in
// i64; any non-negative literal fits (every i64 bit pattern is a valid u64). `neg` rejects `-1` etc.
named_int_range_ok = (nm: string_view, n: i64, neg: bool) bool {
    eq(nm, "i8").match ({
        true  => n >= 0 - 128 && n <= 127,
        false => eq(nm, "i16").match ({
            true  => n >= 0 - 32768 && n <= 32767,
            false => eq(nm, "u16").match ({
                true  => n >= 0 && n <= 65535,
                false => eq(nm, "u32").match ({
                    true  => n >= 0 && n <= 4294967295,
                    false => eq(nm, "u64").match ({
                        true  => neg.match ({ true => false, false => true }),
                        false => true,
                    }),
                }),
            }),
        }),
    })
}
lit_range_ok = (t: Ty, n: i64, neg: bool) bool {
    t.match ({
        .U8        => n >= 0 && n <= 255,
        .I32       => n >= 0 - 2147483648 && n <= 2147483647,
        .I64       => true,
        .Named(nm) => nm.named_int_range_ok(n, neg),
        _          => true,
    })
}
// Numeric literals fit numeric slots only when in range (constant-folded; lenient on non-constants).
lit_fits = (e: Ptr<Expr>, t: Ty) bool {
    lv := e.lit_val()
    lv.ok.match ({ true => t.lit_range_ok(lv.v, lv.neg), false => true })
}
// the narrow widths are Named, so ty_rank can't see them — recognize them as int slots here.
is_int_width = (n: string_view) bool { eq(n, "i8") || eq(n, "i16") || eq(n, "u16") || eq(n, "u32") || eq(n, "u64") }
is_int_slot = (t: Ty) bool {
    t.match ({
        .Named(n) => is_int_width(n),
        _         => t.ty_rank() >= 0,
    })
}
// Authoritative verdict for a numeric LITERAL flowing into an int slot: 0 = fits, 1 = overflow,
// -1 = not a literal-into-int-slot (caller falls back to its structural fit logic). This MUST take
// precedence over the unknown_ty leniency, else `x: i8 := 200` (i8 is an undeclared Named → "unknown")
// would silently pass and truncate at cc.
lit_slot_verdict = (e: Ptr<Expr>, t: Ty) i32 {
    (e.is_lit_numeric() && t.is_int_slot()).match ({
        true  => e.lit_fits(t).match ({ true => 0, false => 1 }),
        false => 0 - 1,
    })
}
// does a type MENTION an (unbound) generic type param? recurses Ptr/Slice/Generic-args. Concrete
// params (bool/Box/i32/…) do NOT mention a tparam → they are still arg/field-checked; only slots
// typed by the callee's own tparam are skipped (their concrete type is known only after mono).
tys_mention_tparam = (tps: [Param], ts: [Ty]) bool {
    f := false
    ts.loop((h, i, t) {
        f = tps.ty_mentions_tparam(t).match ({ true => true, false => f })
    })
    f
}
ty_mentions_tparam = (tps: [Param], t: Ty) bool {
    t.match ({
        .Named(n)   => tps.names_has(n),
        .Ptr(pd)    => tps.ty_mentions_tparam(load(pd.pointee)),
        .Slice(e)   => tps.ty_mentions_tparam(load(e)),
        .Generic(g) => tps.tys_mention_tparam(g.args),
        _           => false,
    })
}
// A generic POINTER param — `MutPtr<T>` / `Ptr<T>` / `RawPtr<T>` whose pointee mentions a callee tparam
// — has its pointee-TYPE deferred to mono (T binds from the argument), but its outer SHAPE is already
// known: the argument must itself be a pointer of a compatible KIND. This mirrors `fits`' pointer branch
// with pointee-equality (`ty_eq`) relaxed to "is any pointer", so a plain value where a pointer is wanted
// (the census cc-ICE "invalid type argument of unary `*`") is rejected, a read-only `Ptr` can't launder
// into a `MutPtr` slot, and the `RawPtr<u8>` floor (`null_ptr()`) still fits.
gen_ptr_arg_fits = (g: Ty, w: Ty) bool {
    g.is_raw_ptr_ty().match ({
        true  => w.is_ptr_ty_g(),
        false => (g.is_nullable_ptr_ty() && w.is_nonnull_ptr_ty()).match ({
            true  => false,
            false => g.is_ptr_ty_g() && g.mode_fits(w),
        }),
    })
}
// Even a tparam-typed param has a checkable outer shape when it is a pointer (see gen_ptr_arg_fits).
// Non-pointer generic params (`T`, `[T]`, `Vec<T>`) and args whose type is still unknown (residue in a
// generic body) stay deferred to mono, exactly as before.
tparam_shape_err = (env: Env, pty: Ty, ar: Expr) i32 {
    pty.is_ptr_ty_g().match ({
        true  => {
            argty := env.infer_expr(ar.addr())
            env.unknown_ty(argty).match ({
                true  => 0,
                false => gen_ptr_arg_fits(argty, pty).match ({ true => 0, false => 1 }),
            })
        },
        false => 0,
    })
}
// A slice LITERAL may be element-wise coerced into an expected slice type while stored slice types
// remain invariant. This accepts `["a", "b"]` at a `[string_view]` call slot without allowing a
// named `[string_literal]` variable to flow to mutable `[string_view]` storage.
slicelit_slot_verdict = (env: Env, ar: Expr, pty: Ty) i32 {
    ar.match ({
        .SliceLit(sd) => pty.match ({
            .Slice(ep) => {
                errs := 0
                sd.items.loop((h, i, it) {
                    errs = errs + env.sl_elem_fit(load(ep), it)
                })
                (errs == 0).match ({ true => 0, false => 1 })
            },
            _          => 0 - 1,
        }),
        _             => 0 - 1,
    })
}
// an argument check, given the callee's tparams: a slot typed by a tparam is shape-checked when it is a
// pointer (else skipped); a CONCRETE slot of a generic fn is still fully checked (so `gen2(x: T, b: Box)`
// rejects a non-Box second arg).
arg_err_at = (env: Env, tps: [Param], params: [Param], i: i32, ar: Expr) i32 {
    (i < params.len).match ({
        true  => tps.ty_mentions_tparam(params[i].ty).match ({
            true  => env.tparam_shape_err(params[i].ty, ar),
            false => {
                sv := env.slicelit_slot_verdict(ar, params[i].ty)
                (sv >= 0).match ({
                    true  => sv,
                    false => {
                        lv := ar.addr().lit_slot_verdict(params[i].ty)
                        (lv >= 0).match ({
                            true  => lv,
                            false => env.fit_err(env.infer_expr(ar.addr()), params[i].ty),
                        })
                    },
                })
            },
        }),
        false => 0,
    })
}
names_has = (names: [Param], fn: string_view) bool {
    found := false
    names.loop((h, i, n) {
        found = eq(n.name, fn).match ({ true => true, false => found })
    })
    found
}
is_imported = (decls: [Decl], fn: string_view) bool {
    found := false
    decls.loop((h, i, d) {
        found = d.match ({
            .DImport(im) => im.names.names_has(fn).match ({ true => true, false => found }),
            _            => found,
        })
    })
    found
}
// Trait methods can remain unresolved in generic bodies until monomorphization.
is_trait_method = (decls: [Decl], fn: string_view) bool {
    found := false
    decls.loop((h, i, d) {
        found = d.match ({
            .DImpl(im)         => im.methods.names_has(fn).match ({ true => true, false => found }),
            .DTraitDefault(td) => eq(td.fn.name, fn).match ({ true => true, false => found }),    // a defaulted method an impl may OMIT
            _                  => found,
        })
    })
    found
}
// the trait (a struct whose FnT fields are the method signatures) that DECLARES method `m`; ""
// if none. Distinct from is_trait_method, which only sees methods some IMPL provides: with ZERO
// impls in the module a required trait method fell through to undefined-name, hiding the real
// story (the receiver type lacks an impl). Used only to pick the KIND and message of an already-
// rejected call — it never flips accept/reject.
fields_declare_method = (fields: [Field], m: string_view) bool {
    found := false
    fields.loop((h, i, f) {
        found = eq(f.name, m).match ({
            true  => f.ty.match ({
                .FnT(fd) => true,
                _        => found,
            }),
            false => found,
        })
    })
    found
}
trait_declaring = (decls: [Decl], m: string_view) string_view {
    found := ""
    decls.loop((h, i, d) {
        found = d.match ({
            .DStruct(sd) => (is_empty(found) && sd.fields.fields_declare_method(m)).match ({
                true  => sd.name,
                false => found,
            }),
            _            => found,
        })
    })
    found
}
// genc/runtime intrinsics with no Zen declaration: is_intrinsic — now DEFINED in compiler.check
// (imported above) so the alias-UFCS fallback there can refuse to shadow an intrinsic name.
// Stage 3: panic-on-null guard, RawPtr<T> -> MutPtr<T>
intrinsic_arity = (fn: string_view) i32 {
    eq(fn, "__str_eq").match ({
        true  => 2,
        false => eq(fn, "__str_ne").match ({
            true  => 2,
            false => eq(fn, "store").match ({
                true  => 2,
                false => eq(fn, "offset").match ({
                    true  => 2,
                    false => eq(fn, "slice").match ({
                        true  => 2,
                        false => eq(fn, "null_ptr").match ({
                            true  => 0,
                            false => eq(fn, "atomic_add_i64").match ({
                                true  => 2,
                                false => eq(fn, "atomic_store_i64").match ({
                                    true  => 2,
                                    false => eq(fn, "atomic_cas_i64").match ({
                                        true  => 3,
                                        false => eq(fn, "atomic_fence").match ({
                                            true  => 0,
                                            false => eq(fn, "store_i64").match ({
                                                true  => 2,
                                                false => 1,
                                            }),
                                        }),
                                    }),
                                }),
                            }),
                        }),
                    }),
                }),
            }),
        }),
    })
}    // lowered str content equality (resolve_bin)
// A trait-method UFCS call defers to monomorphization ONLY when its receiver type is still
// unresolved (an unbound tparam / generic residue — `unknown_ty`): the concrete impl appears
// after the tparam is pinned. A CONCRETE receiver must resolve NOW — if dispatch finds no impl
// it is a `trait_recv_missing` error, not a deferral that leaks a bare method symbol to the linker.
is_unresolved_trait_call = (env: Env, c: CallData) bool {
    (c.args.len > 0).match ({
        true  => env.env_trait_method(c.fn).match ({
            true  => eq(env.dispatch_name(c), c.fn).match ({
                true  => env.unknown_ty(env.infer_expr(c.args[0].addr())),
                false => false,
            }),
            false => false,
        }),
        false => false,
    })
}
// A trait-method call whose CONCRETE receiver type implements no matching impl (dispatch finds no
// redirect) and that is neither a free function nor an imported name — would emit a bare `area`
// call and fail at the C linker. Reject it as a Zen receiver/trait-bound error instead.
trait_recv_missing = (env: Env, c: CallData) bool {
    (c.args.len > 0 && env.env_trait_method(c.fn) && env.env_imported(c.fn) == false && env.env_known_fn(c.fn) == false).match ({
        true  => eq(env.dispatch_name(c), c.fn) && env.unknown_ty(env.infer_expr(c.args[0].addr())) == false,
        false => false,
    })
}
is_forbidden_raw_call = (c: CallData) bool { c.raw && eq(c.fn, "malloc") }
// A fn's OWN params and locals SHADOW same-named top-level names in its body: a call through a
// locally-bound name (e.g. a closure param `f` while a top-level `f` exists) must NEVER be judged
// against the top-level fn / intrinsic / import — the emitted C scopes the local as the call target.
// An FnT-typed shadow still gets the indirect-call arity/arg checks (fnval path); a KNOWN non-FnT
// shadow is not-callable (see shadow_not_callable); only a not-yet-typable shadow (pre-inline
// generic bodies) is skipped, never over-rejected.
shadows_toplevel = (env: Env, fn: string_view) bool { env.is_local(fn) && (env.env_known_fn(fn) || fn.is_intrinsic() || env.env_imported(fn) || env.env_trait_method(fn)) }
// A call THROUGH a non-FnT shadow: the local is a scalar/struct, so the call can never succeed — and
// worse, genc's call dispatch is by NAME, so a "skipped" call to an intrinsic-named local (e.g. a
// param `store_i64: i64`) is still emitted as the INTRINSIC expansion, silently writing wrong values.
// Reject when the local's type is concretely KNOWN (calling an i64 is never valid); stay lenient only
// for an unknown/untypable shadow (pre-inline generic bodies), preserving #370's no-over-rejection.
shadow_not_callable = (env: Env, fn: string_view) bool {
    t := env.var_or_global(fn)
    (t.is_void_ty() || env.unknown_ty(t)).match ({ true => false, false => true })
}
is_write_intrinsic = (fn: string_view) bool { eq(fn, "store") || eq(fn, "store_i64") || eq(fn, "atomic_add_i64") || eq(fn, "atomic_store_i64") || eq(fn, "atomic_cas_i64") }
// Slices are writable views, so constructing one from Ptr<T> would launder read-only memory just as
// directly as a store. RawPtr and MutPtr retain the explicitly writable paths.
store_writes_readonly = (env: Env, c: CallData) bool {
    ((c.fn.is_write_intrinsic() || eq(c.fn, "slice")) && c.args.len >= 1).match ({
        true  => env.infer_expr(c.args[0].addr()).is_readonly_ptr_ty(),
        false => false,
    })
}
store_mut_kind = (env: Env, c: CallData) i32 { kv_at(env.store_writes_readonly(c).match ({
    true  => KPTRWRITE(),
    false => 0,
}), c.pos) }
// every intrinsic that DEREFERENCES its pointer arg0: the typed load/store/offset trio AND the raw
// word intrinsics (load_i64/store_i64/atomic_*) — the latter crash on null exactly the same way.
is_deref_intrinsic = (fn: string_view) bool { eq(fn, "load") || eq(fn, "store") || eq(fn, "offset") || eq(fn, "slice") || eq(fn, "load_i64") || eq(fn, "store_i64") || eq(fn, "atomic_add_i64") || eq(fn, "atomic_load_i64") || eq(fn, "atomic_store_i64") || eq(fn, "atomic_cas_i64") }
derefs_nullable = (env: Env, c: CallData) bool {
    (c.fn.is_deref_intrinsic() && c.args.len >= 1).match ({
        true  => env.infer_expr(c.args[0].addr()).is_nullable_ptr_ty(),
        false => false,
    })
}
// Generic UFCS trait calls may need to defer even if a top-level fn has the same name.
// `@malloc` is not a magic allocator; use an ordinary foreign function or allocator API.
// Calls: local signatures are checked; imported/deferred trait names are accepted; unknowns reject.
// Stage 3 nullability: a `load`/`store`/`offset` whose pointer operand is a nullable `RawPtr<T>`
// (T != u8) that has NOT been proven non-null is rejected. The proof is carried by the TYPE: a
// `q := assert_nonnull(p)` yields `q: MutPtr<T>`, so `load(q)` sees a non-nullable kind and passes.
// `RawPtr<u8>` (the byte-buffer floor) and `Ptr`/`MutPtr` are never nullable, so they are exempt.
null_deref_kind = (env: Env, c: CallData) i32 { kv_at(env.derefs_nullable(c).match ({
    true  => KNULLDEREF(),
    false => 0,
}), c.pos) }
// `assert_nonnull(p)` narrows a nullable pointer to a non-null `MutPtr<T>`; its argument MUST be a
// pointer. A NON-pointer arg (e.g. a scalar) makes the result's `pointee_of` collapse to void and the
// emitted C drops a value into a void slot ("void value not ignored"). Reject only genuinely
// non-pointer args — a redundant `assert_nonnull` on an already-non-null `Ptr`/`MutPtr` is harmless.
assert_nonnull_badarg = (env: Env, c: CallData) bool {
    (eq(c.fn, "assert_nonnull") && c.args.len >= 1).match ({
        true  => env.infer_expr(c.args[0].addr()).is_ptr_ty_g() == false,
        false => false,
    })
}
assert_nonnull_kind = (env: Env, c: CallData) i32 {
    kv_at(env.assert_nonnull_badarg(c).match ({ true => KARGTYPE(), false => 0 }), (c.args.len >= 1).match ({
        true  => c.args[0].expr_pos().pos_or(c.pos),
        false => c.pos,
    }))
}
// A call checks arity, then arg types. For a LOCAL generic only tparam-typed slots defer to mono;
// CONCRETE slots are still checked. An IMPORTED generic (a bodyless header) is skipped entirely — its
// param types still carry unbound tparams that cross-module inference can't resolve at the call site,
// so a strict check there false-rejects real code (text/fmt, concurrent/actor, core/slice).
is_imported_generic = (f: Func) bool { f.tparams.len > 0 && f.body.len == 0 }
// ── bounded generics: `f<A: Trait>` ─────────────────────────────────────────────
// A tparam carries a trait BOUND in its `ty` slot (Named(traitname)); plain tparams leave it Void.
tparam_bound = (tp: Param) string_view {
    tp.ty.match ({
        .Named(n) => n,
        _         => "",
    })
}
// Does some `Type.impl(Trait)` exist? i.e. a DImpl naming this type + trait.
type_impls_trait = (decls: [Decl], tyname: string_view, trname: string_view) bool {
    found := false
    decls.loop((h, i, d) {
        found = d.match ({
            .DImpl(im) => (eq(im.ty, tyname) && eq(im.trname, trname)).match ({
                true  => true,
                false => found,
            }),
            _          => found,
        })
    })
    found
}
// Enforce ONE bounded tparam at a call site: bind A to its concrete targ, then require the bound.
// Conservative — only fires when A resolves to a known CONCRETE struct (allocators are structs);
// an unresolved / primitive / generic-passthrough targ defers (0), so plain generics never regress.
bound_err = (env: Env, f: Func, c: CallData, tp: Param) i32 {
    tr := tp.tparam_bound()
    is_empty(tr).match ({
        true  => 0,
        false => {
            tn := env.call_targ(f, c.args, tp.name).recv_name()    // unbounded tparam: nothing to check
            // concrete type A binds to
            (is_empty(tn) || env.decls.is_struct(tn) == false).match ({
                true  => 0,
                false => env.decls.type_impls_trait(tn, tr).match ({ true => 0, false => 1 }),
            })
        },
    })
}    // unresolved / not a concrete struct: defer
bound_errs = (env: Env, f: Func, c: CallData) i32 {
    acc := 0
    f.tparams.loop((h, i, tp) {
        acc = acc + env.bound_err(f, c, tp)
    })
    acc
}
// An INDIRECT call through a fn-value (`f := g  f(x)`, or an FnT parameter `f`): check the arg COUNT
// against the FnT's params, then each CONCRETE param's arg type. Param positions typed by an unbound
// tparam stay lenient (generic FnT-param templates resolve those at mono). Without this, a wrong-arity
// indirect call slipped past SEMA and broke at cc ("too few arguments to function …").
fnt_arg_err_at = (env: Env, ptys: [Ty], i: i32, ar: Expr) i32 {
    (i < ptys.len).match ({
        true  => {
            lv := ar.addr().lit_slot_verdict(ptys[i])
            (lv >= 0).match ({
                true  => lv,
                false => env.unknown_ty(ptys[i]).match ({
                    true  => 0,
                    false => env.fit_err(env.infer_expr(ar.addr()), ptys[i]),
                }),
            })
        },
        false => 0,
    })
}
match_result_ty = (env: Env, subjty: Ty, arms: [ArmData]) Ty {
    out := tvoid()
    arms.loop((h, i, ar) {
        aenv := env.a.arm_env(env, subjty, ar)
        got := aenv.infer_expr(ar.body)
        out = out.is_void_ty().match ({
            true  => (got.is_void_ty() || aenv.unknown_ty(got)).match ({
                true  => out,
                false => got,
            }),
            false => out,
        })
    })
    out
}
result_compatible = (want: Ty, got: Ty) bool {
    (want.is_str_t() && got.is_str_t()).match ({
        true  => true,
        false => (want.ty_rank() >= 0 && got.ty_rank() >= 0).match ({
            true  => true,
            false => want.ty_eq(got),
        }),
    })
}    // string_* types are one compatible family
cond_numlike = (t: Ty) bool { t.ty_rank() >= 0 || t.is_f64_ty() }
// A value/bool `.match` (and `if` expression) lowers to a ternary Cond at parse time, so its two
// value branches escape the enum-match arm checks above. Their result types must still be C-compatible
// — `c ? A : B` on incompatible types is a hard cc error. A numeric LITERAL branch is polymorphic and
// coerces to any numeric counterpart (mirrors cond_ty's deferral); void/unknown branches stay lenient.
cond_compatible = (d: CondData, tt: Ty, et: Ty) bool {
    d.t.is_lit_numeric().match ({
        true  => et.cond_numlike(),
        false => d.e.is_lit_numeric().match ({
            true  => tt.cond_numlike(),
            false => tt.result_compatible(et),
        }),
    })
}
// A one-armed bool `.match` is always non-exhaustive. Resolution deliberately leaves oa != 0 intact even
// in statement position; `.then({ ... })` is the explicit lazy one-way construct and carries oa=0.
cond_onearm_err = (d: CondData) i32 { (d.oa == 0).match ({ true => 0, false => 1 }) }
cond_result_err = (env: Env, d: CondData) i32 {
    tt := env.infer_expr(d.t)
    et := env.infer_expr(d.e)
    (tt.is_void_ty() || et.is_void_ty() || env.unknown_ty(tt) || env.unknown_ty(et)).match ({
        true  => 0,
        false => d.cond_compatible(tt, et).match ({ true => 0, false => 1 }),
    })
}
arm_result_err = (env: Env, subjty: Ty, want: Ty, ar: ArmData) i32 {
    aenv := env.a.arm_env(env, subjty, ar)
    got := aenv.infer_expr(ar.body)
    (want.is_void_ty() || got.is_void_ty() || aenv.unknown_ty(want) || aenv.unknown_ty(got)).match ({
        true  => 0,
        false => want.result_compatible(got).match ({ true => 0, false => 1 }),
    })
}
// ── value-consumed match/cond arms must each yield a value ──────────────────────────────
// A match/cond CONSUMED AS A VALUE (let/assign RHS, return operand, call argument, index-set
// value) must get a value from every arm that doesn't diverge. The arm typing above treats a
// void arm as contributing NO constraint — that leniency exists for DIVERGING arms (a `return`
// tail leaves the fn, so it legitimately yields nothing) and for template residue — but the
// emitter assigns EVERY arm into the value slot (`_out = <arm>` / `c ? a : b`), so a genuinely
// valueless arm reaches cc as `char* _out = (done = true)` — a cc-stage error on a checked
// program — or WORSE compiles silently wrong (`c ? "s" : bool` is only a warning under -w).
// Reject it here (KARMVOID, positioned at the offending arm). Two deliberate scope limits:
//   * only POSITIVE no-value shapes fire — a block ending in a non-expression statement or
//     empty, a `.loop`, a call to a fn DECLARED void — never inference fallbacks (an
//     unresolvable template call also infers void and must stay lenient);
//   * only CONSUMED positions fire — a discarded match (e.g. the tail of a void fn) keeps its
//     mixed side-effect arms, which emit fine as `(c ? f() : ({ }))`.
known_void_call = (env: Env, c: CallData) bool {
    f := env.env_func(c.fn)
    eq(f.name, c.fn).match ({ true => f.tparams.len == 0 && f.ret.is_void_ty(), false => false })
}
novalue_arm_leaf = (env: Env, e: Ptr<Expr>) i32 {
    load(e).match ({
        .Block(b) => env.novalue_block_tail(b.stmts),
        .Cond(d)  => env.novalue_arm_leaf(d.t) + env.novalue_arm_leaf(d.e),
        .Match(m) => env.novalue_match_arms(m),
        .Loop(l)  => 1,    // `.loop` never yields a value
        .Call(c)  => env.known_void_call(c).match ({ true => 1, false => 0 }),
        _         => 0,
    })
}
novalue_block_tail = (env: Env, stmts: [Stmt]) i32 {
    (stmts.len == 0).match ({
        true  => 1,
        false => stmts[stmts.len - 1].match ({
            .Return(r)   => 0,    // diverging arm: the one legitimate valueless tail
            .ExprStmt(e) => env.novalue_arm_leaf(e),
            _            => 1,
        }),
    })
}    // a Let/Assign/If/While/IndexSet tail is a statement, never a value
novalue_match_arms = (env: Env, m: MatchData) i32 {
    acc := 0
    m.arms.loop((h, i, ar) {
        acc = acc + env.novalue_arm_leaf(ar.body)
    })
    acc
}
value_void_arm_err = (env: Env, want: Ty, e: Ptr<Expr>) i32 {
    (want.is_void_ty() || env.unknown_ty(want)).match ({
        true  => 0,
        false => load(e).match ({
            .Match(m) => env.novalue_match_arms(m),
            .Cond(d)  => env.novalue_arm_leaf(d.t) + env.novalue_arm_leaf(d.e),
            _         => 0,
        }),
    })
}
// argument position: a match/cond arg flowing into a CONCRETE (non-tparam) param slot.
call_void_arm_errs = (env: Env, c: CallData) i32 {
    f := env.env_func(c.fn)
    acc := 0
    eq(f.name, c.fn).then({
        c.args.loop((h, i, ar) {
            acc = acc + (i < f.params.len).match ({
                true  => f.tparams.ty_mentions_tparam(f.params[i].ty).match ({
                    true  => 0,
                    false => env.value_void_arm_err(f.params[i].ty, ar.addr()),
                }),
                false => 0,
            })
        })
    })
    acc
}
// Early returns inside value-position block arms would be dropped by expression emission.
early_returns = (stmts: [Stmt]) bool {
    found := false
    stmts.loop((h, i, st) {
        found = (i < stmts.len - 1).match ({
            true  => st.match ({
                .Return(r) => true,
                _          => found,
            }),
            false => found,
        })
    })
    found
}
expr_drops_return = (e: Ptr<Expr>) i32 {
    load(e).match ({
        .Block(b) => b.stmts.early_returns().match ({ true => 1, false => 0 }),
        _         => 0,
    })
}
// Struct literals check known fields and value fits; imported/generic literals stay lenient.
no_fields = () [Field] { slice(null_ptr(), 0) }
is_struct = (decls: [Decl], name: string_view) bool {
    f := false
    decls.loop((h, i, d) {
        f = d.match ({
            .DStruct(sd) => eq(sd.name, name).match ({ true => true, false => f }),
            _            => f,
        })
    })
    f
}
struct_fields = (decls: [Decl], name: string_view) [Field] {
    found := no_fields()
    decls.loop((h, i, d) {
        found = d.match ({
            .DStruct(sd) => eq(sd.name, name).match ({ true => sd.fields, false => found }),
            _            => found,
        })
    })
    found
}
has_field = (fields: [Field], fname: string_view) bool {
    f := false
    fields.loop((h, i, fl) {
        f = eq(fl.name, fname).match ({ true => true, false => f })
    })
    f
}
field_in = (fields: [Field], fname: string_view) Ty {
    found := tvoid()
    fields.loop((h, i, fl) {
        found = eq(fl.name, fname).match ({ true => fl.ty, false => found })
    })
    found
}
field_fit_err = (env: Env, fields: [Field], fi: FieldInit) i32 {
    fty := fields.field_in(fi.name)
    sv := env.slicelit_slot_verdict(load(fi.value), fty)
    (sv >= 0).match ({
        true  => sv,
        false => {
            lv := fi.value.lit_slot_verdict(fty)    // a numeric literal must fit the field width
            (lv >= 0).match ({ true => lv, false => env.fit_err(env.infer_expr(fi.value), fty) })
        },
    })
}
init_err = (env: Env, fields: [Field], fi: FieldInit) i32 { fields.has_field(fi.name).match ({
    true  => env.field_fit_err(fields, fi),
    false => 1,
}) }    // unknown field -> 1
struct_init_errs = (env: Env, fields: [Field], inits: [FieldInit]) i32 {
    acc := 0
    inits.loop((h, i, fi) {
        acc = acc + env.init_err(fields, fi)
    })
    acc
}
// generic-struct-literal support: look up the GenStructDecl by base name; a field typed by a struct
// tparam stays lenient, a CONCRETE field (bool/i32/Box/…) is still fit-checked.
cv_no_params = () [Param] { slice(null_ptr(), 0) }
cv_is_gen_struct = (decls: [Decl], name: string_view) bool {
    f := false
    decls.loop((h, i, d) {
        f = d.match ({
            .DGenStruct(g) => eq(g.name, name).match ({ true => true, false => f }),
            _              => f,
        })
    })
    f
}
// A GENERIC enum (`DGenEnum`, e.g. std `Result<T,E>`) by base name — like a concrete enum it holds
// variants, not fields, so a `.field` access on an instance is a mistake regardless of the type args.
cv_is_gen_enum = (decls: [Decl], name: string_view) bool {
    f := false
    decls.loop((h, i, d) {
        f = d.match ({
            .DGenEnum(g) => eq(g.name, name).match ({ true => true, false => f }),
            _            => f,
        })
    })
    f
}
// An enum lowers to a C `struct { int32_t tag; union {…} u; }` (genc_emit emit_enum), so `.tag` and `.u`
// ARE its only real members. The match/or_return lowering resolve_module runs BEFORE this validator
// synthesizes exactly those two accesses on enum values (`subj.tag`, `subj.u`); they compile cleanly and
// must be accepted. Any OTHER field name has no C member — that is the codegen ICE we reject.
is_enum_repr_field = (field: string_view) bool { eq(field, "tag") || eq(field, "u") }
gen_struct_fields = (decls: [Decl], name: string_view) [Field] {
    found := no_fields()
    decls.loop((h, i, d) {
        found = d.match ({
            .DGenStruct(g) => eq(g.name, name).match ({ true => g.fields, false => found }),
            _              => found,
        })
    })
    found
}
gen_struct_tparams = (decls: [Decl], name: string_view) [Param] {
    found := cv_no_params()
    decls.loop((h, i, d) {
        found = d.match ({
            .DGenStruct(g) => eq(g.name, name).match ({ true => g.tparams, false => found }),
            _              => found,
        })
    })
    found
}
// A generic-struct literal `Box<i32>(v: …)` binds each tparam to its explicit targ, so a field typed
// by a tparam (`v: T`) becomes CONCRETE (`v: i32`) and IS fit-checked — closing the hole where a wrong
// value (`Box<i32>(v: P(…))`) slipped past SEMA and broke at cc. A field whose type stays a tparam after
// substitution (no matching targ) remains lenient, deferred to monomorphization.
gen_field_fit_err = (env: Env, tps: [Param], targs: [Ty], fields: [Field], fi: FieldInit) i32 {
    fty := fields.field_in(fi.name)
    cty := (targs.len == tps.len).match ({
        true  => env.a.subst_ty_in(tps, targs, fty),
        false => fty,
    })
    tps.ty_mentions_tparam(cty).match ({
        true  => 0,
        false => {
            sv := env.slicelit_slot_verdict(load(fi.value), cty)
            (sv >= 0).match ({
                true  => sv,
                false => {
                    lv := fi.value.lit_slot_verdict(cty)    // still a tparam -> lenient
                    // a numeric literal must fit the field width
                    (lv >= 0).match ({
                        true  => lv,
                        false => env.fit_err(env.infer_expr(fi.value), cty),
                    })
                },
            })
        },
    })
}    // a concrete field -> check the fit
gen_struct_init_errs = (env: Env, tps: [Param], targs: [Ty], fields: [Field], inits: [FieldInit]) i32 {
    acc := 0
    inits.loop((h, i, fi) {
        acc = acc + fields.has_field(fi.name).match ({
            true  => env.gen_field_fit_err(tps, targs, fields, fi),
            false => 1,
        })
    })
    acc
}
inits_has = (inits: [FieldInit], name: string_view) bool {
    f := false
    inits.loop((h, i, fi) {
        f = eq(fi.name, name).match ({ true => true, false => f })
    })
    f
}    // is this field named in the literal?
// A NON-NULL pointer field (`Ptr<T>`/`MutPtr<T>`) left out of the literal would be default-zeroed to a
// null that the type promises can never happen → a deref segfault the checker currently misses. Require it.
field_missing_nonnull_ptr = (fields: [Field], inits: [FieldInit]) i32 {
    acc := 0
    fields.loop((h, i, fl) {
        acc = acc + (fl.ty.is_nonnull_ptr_ty() && inits.inits_has(fl.name) == false).match ({
            true  => 1,
            false => 0,
        })
    })
    acc
}
// A repeated initializer for the same field (`Box(v: 5, v: 9)`) is almost certainly a mistake.
dup_init_errs = (inits: [FieldInit]) i32 {
    acc := 0
    inits.loop((h, i, fi) {
        earlier := false
        inits.loop((h2, j, fj) {
            earlier = (j < i && eq(fj.name, fi.name)).match ({ true => true, false => earlier })
        })
        acc = acc + earlier.match ({ true => 1, false => 0 })
    })
    acc
}
makestruct_err = (env: Env, m: MakeStructData) i32 {
    (m.targs.len > 0).match ({
        true  => env.env_is_gen_struct(m.ty).match ({
            true  => {
                gf := env.env_gstruct(m.ty).fields
                env.gen_struct_init_errs(env.env_gstruct(m.ty).tparams, m.targs, gf, m.inits) + gf.field_missing_nonnull_ptr(m.inits) + m.inits.dup_init_errs()
            },
            false => 0,
        }),
        false => env.env_is_struct(m.ty).match ({
            true  => {
                sf := env.env_struct_fields(m.ty)
                env.struct_init_errs(sf, m.inits) + sf.field_missing_nonnull_ptr(m.inits) + m.inits.dup_init_errs()
            },
            false => 0,
        }),
    })
}    // a generic literal: check concrete fields
gen_base_of = (t: Ty) string_view {
    t.match ({
        .Generic(g) => g.name,    // unknown gen-struct (template residue) -> lenient
        // the BASE name of a generic-struct receiver (`Box` of `Box<i32>`), through a Ptr receiver.
        .Ptr(pd)    => load(pd.pointee).gen_base_of(),
        _           => "",
    })
}
// a primitive scalar has no fields, so `x.foo` on it is a hard error (C: "member in something not a struct").
is_scalar_prim = (t: Ty) bool {
    t.match ({
        .I32  => true,
        .I64  => true,
        .U8   => true,
        .F64  => true,
        .Bool => true,
        _     => false,
    })
}
// FIELDLESS receivers: scalars AND the string types (`str`/`Cstr`/`text` are `const char*`/`char*` in C,
// with NO members). `s.len` FIELD access on one ICEs in cc ("member in something not a struct or union");
// the accessor is a UFCS METHOD (`s.len()`, a `Call`), never a field. A slice `[T]` is `.Slice` (NOT here),
// so `slice.len` on its `{ptr,len}` struct still passes. Closes census #60 (sibling of #58).
is_fieldless_prim = (t: Ty) bool {
    t.match ({
        .StringView    => true,
        .StringCstr    => true,
        .StringLiteral => true,
        _              => t.is_scalar_prim(),
    })
}
// Field access checks known concrete struct receivers AND generic-struct instances (field names don't
// depend on the type args, so `Box<i32>.nope` is rejected the same as `Box.nope` would be). A KNOWN
// enum receiver — concrete (`DEnum`) or generic (`DGenEnum` like `Result<i32,IoError>`) — has no fields
// at all: you reach its variants via `.match`, so any `.field` on one is rejected (closes census #58/#41,
// where `r.len` on a Result passed `check` then ICE'd in cc with only a `.c` column).
member_err = (env: Env, obj: Ptr<Expr>, field: string_view) i32 {
    obj.is_lit_numeric().match ({
        true  => 1,
        false => {
            rty := env.infer_expr(obj)
            sname := rty.enum_name()
            env.env_is_struct(sname).match ({
                true  => env.env_struct_fields(sname).has_field(field).match ({
                    true  => 0,
                    false => 1,
                }),
                false => {
                    base := rty.gen_base_of()
                    (is_empty(base) == false && env.env_is_gen_struct(base)).match ({
                        true  => env.env_gstruct(base).fields.has_field(field).match ({
                            true  => 0,
                            false => 1,
                        }),
                        false => (env.env_is_enum(sname) || is_empty(base) == false && env.env_is_gen_enum(base)).match ({
                            true  => field.is_enum_repr_field().match ({ true => 0, false => 1 }),
                            false => rty.is_fieldless_prim().match ({ true => 1, false => 0 }),
                        }),
                    })
                },
            })
        },
    })
}    // scalars and enums have no fields; other unknowns (residue) stay lenient
// Enum matches must be exhaustive and have no duplicate arms.
no_variants = () [VariantDef] { slice(null_ptr(), 0) }
enum_variants = (decls: [Decl], ename: string_view) [VariantDef] {
    found := no_variants()
    decls.loop((h, i, d) {
        found = d.match ({
            .DEnum(ed)   => eq(ed.name, ename).match ({ true => ed.variants, false => found }),
            .DGenEnum(g) => eq(g.name, ename).match ({ true => g.variants, false => found }),
            _            => found,
        })
    })
    found
}
has_wildcard = (arms: [ArmData]) bool {
    f := false
    arms.loop((h, i, a) {
        f = eq(a.variant, "_").match ({ true => true, false => f })
    })
    f
}
arm_covers = (arms: [ArmData], vname: string_view) bool {
    f := false
    arms.loop((h, i, a) {
        f = eq(a.variant, vname).match ({ true => true, false => f })
    })
    f
}
missing_count = (variants: [VariantDef], arms: [ArmData]) i32 {
    n := 0
    variants.loop((h, i, v) {
        n = arms.arm_covers(v.name).match ({ true => n, false => n + 1 })
    })
    n
}
exhaustive_err = (env: Env, m: MatchData) i32 {
    vs := env.decls.enum_variants(m.ename)
    (vs.len == 0).match ({
        true  => 0,
        false => (vs.missing_count(m.arms) > 0).match ({ true => 1, false => 0 }),
    })
}
// the NAME of the first declared variant the arms do not cover, else "" — the uncovered
// variant an exhaustiveness diagnostic names so the fix is a copy-pasteable `.Variant => …` arm.
first_missing_variant = (variants: [VariantDef], arms: [ArmData]) string_view {
    r := ""
    variants.loop((h, i, v) {
        r = (is_empty(r) && arms.arm_covers(v.name) == false).match ({ true => v.name, false => r })
    })
    r
}
dup_before = (arms: [ArmData], vname: string_view, upto: i32) bool {
    f := false
    arms.loop((h, i, a) {
        f = (i < upto && eq(a.variant, vname)).match ({ true => true, false => f })
    })
    f
}
dup_arm_errs = (arms: [ArmData]) i32 {
    n := 0
    arms.loop((h, i, a) {
        n = n + eq(a.variant, "_").match ({
            true  => 0,
            false => arms.dup_before(a.variant, i).match ({ true => 1, false => 0 }),
        })
    })
    n
}
// Reject constructors whose variant is not declared in the linked decl set.
enum_declares = (decls: [Decl], vn: string_view) bool {
    f := false
    decls.loop((h, i, d) {
        f = d.match ({
            .DEnum(ed)   => ed.variants.arm_known(vn).match ({ true => true, false => f }),
            .DGenEnum(g) => g.variants.arm_known(vn).match ({ true => true, false => f }),
            _            => f,
        })
    })
    f
}
// Unknown enum ctor: bare `.Variant` (empty ty) must name SOME declared variant; qualified
// `Color.Purple` / `Result.Bogus` (non-empty ty) must name a variant OF THAT enum. Previously the
// qualified branch always returned 0, so `Color.Purple` passed check and ICEd at cc.
mkenum_err = (env: Env, ty: string_view, variant: string_view) i32 {
    is_empty(ty).match ({
        true  => env.decls.enum_declares(variant).match ({ true => 0, false => 1 }),
        false => {
            vs := env.decls.enum_variants(ty)
            (vs.len == 0).match ({
                true  => 0,
                false => vs.arm_known(variant).match ({ true => 0, false => 1 }),
            })
        },
    })
}
// A constructed enum payload must fit the variant's declared payload type (`E.A("s")` where A(i32)).
// Inferred-enum form (empty ty) and tparam/unknown/void payloads stay lenient — generic variants like
// Result.Ok(x) resolve their payload type only after mono, so subj_variant_payload yields a tparam there.
enum_payload_err = (env: Env, mk: MakeEnumData) i32 {
    is_empty(mk.ty).match ({
        true  => 0,
        false => {
            pty := env.subj_variant_payload(tnamed(mk.ty), mk.variant)
            lv := mk.payload.lit_slot_verdict(pty)
            (lv >= 0).match ({
                true  => lv,
                false => {
                    vt := env.infer_expr(mk.payload)
                    (pty.is_void_ty() || env.unknown_ty(pty) || env.unknown_ty(vt)).match ({
                        true  => 0,
                        false => fits(vt, pty).match ({ true => 0, false => 1 }),
                    })
                },
            })
        },
    })
}
// Every non-wildcard arm must name a declared variant.
arm_known = (vs: [VariantDef], vname: string_view) bool {
    f := false
    vs.loop((h, i, v) {
        f = eq(v.name, vname).match ({ true => true, false => f })
    })
    f
}
unknown_arm_errs = (env: Env, m: MatchData) i32 {
    vs := env.decls.enum_variants(m.ename)
    n := 0
    (vs.len == 0).match ({
        true  => 0,
        false => {
            m.arms.loop((h, i, a) {
                n = n + eq(a.variant, "_").match ({
                    true  => 0,
                    false => vs.arm_known(a.variant).match ({ true => 0, false => 1 }),
                })
            })
            n
        },
    })
}
// Operand checking stays lenient for uninferable operands.
is_arith_op = (op: string_view) bool {
    b := op.at(0)
    b == '+' || b == '-' || b == '*' || b == '/' || b == '%'
}
is_logic_op = (op: string_view) bool { eq(op, "&&") || eq(op, "||") }
// Strict comparisons require numeric operands; shifts are separate bitwise ops.
is_cmp_op_v = (op: string_view) bool { eq(op, "<") || eq(op, ">") || eq(op, "<=") || eq(op, ">=") }
is_bitwise_op = (op: string_view) bool { eq(op, "&") || eq(op, "|") || eq(op, "^") || eq(op, "<<") || eq(op, ">>") }
is_bool_ty = (t: Ty) bool {
    t.match ({
        .Bool => true,
        _     => false,
    })
}
non_numeric = (env: Env, e: Ptr<Expr>) bool {
    t := env.infer_expr(e)
    env.unknown_ty(t).match ({
        true  => false,
        false => (t.ty_rank() >= 0).match ({ true => false, false => true }),
    })
}
non_bool = (env: Env, e: Ptr<Expr>) bool {
    t := env.infer_expr(e)
    env.unknown_ty(t).match ({
        true  => false,
        false => t.is_bool_ty().match ({ true => false, false => true }),
    })
}
// f64 operators are strict: no implicit int<->float mixing.
is_eq_op_v = (op: string_view) bool { eq(op, "==") || eq(op, "!=") }
f64_op_ok = (op: string_view) bool { eq(op, "+") || eq(op, "-") || eq(op, "*") || eq(op, "/") || eq(op, "/.") || op.is_cmp_op_v() }
f64_side_ok = (env: Env, t: Ty) bool { t.is_f64_ty() || env.unknown_ty(t) }
f64_operand_err = (env: Env, op: string_view, lt: Ty, rt: Ty) i32 { (env.f64_side_ok(lt) && env.f64_side_ok(rt) && op.f64_op_ok()).match ({
    true  => 0,
    false => 1,
}) }
// Any f64 side routes to the f64 surface; otherwise use integer numeric rules.
num_operand_err = (env: Env, b: BinData) i32 {
    lt := env.infer_expr(b.lhs)
    rt := env.infer_expr(b.rhs)
    (lt.is_f64_ty() || rt.is_f64_ty()).match ({
        true  => env.f64_operand_err(b.op, lt, rt),
        false => (env.non_numeric(b.lhs) || env.non_numeric(b.rhs)).match ({
            true  => 1,
            false => 0,
        }),
    })
}
// the two sides of an ==/!= must share a comparable category: both numeric, both bool, both str-family,
// both pointer, or the same nominal type. (unknown sides pass — no false-reject on template residue.)
is_ptr_ty = (t: Ty) bool {
    t.match ({
        .Ptr(pd) => true,
        _        => false,
    })
}
same_eq_category = (a: Ty, b: Ty) bool { a.ty_rank() >= 0 && b.ty_rank() >= 0 || a.is_bool_ty() && b.is_bool_ty() || a.is_str_t() && b.is_str_t() || a.is_ptr_ty() && b.is_ptr_ty() }
// a NOMINAL ==: only types genc can compare with C's `==` — an enum (tag compare) or a Named non-struct.
// structs and slices CANNOT (`a == b` on two structs is a hard cc error), so they're excluded here.
eq_nominal_ok = (env: Env, a: Ty, b: Ty) bool {
    a.ty_eq(b) && a.match ({
        .Named(n) => env.env_is_struct(n).match ({ true => false, false => true }),
        _         => false,
    })
}
// Equality rejects f64/non-f64 mixes and heterogeneous comparisons (`"hi" == 5`, `true == 5`).
eq_mix_err = (env: Env, b: BinData) i32 {
    lt := env.infer_expr(b.lhs)
    rt := env.infer_expr(b.rhs)
    (lt.is_f64_ty() || rt.is_f64_ty()).match ({
        true  => (env.f64_side_ok(lt) && env.f64_side_ok(rt)).match ({ true => 0, false => 1 }),
        false => (env.unknown_ty(lt) || env.unknown_ty(rt)).match ({
            true  => 0,
            false => (lt.same_eq_category(rt) || env.eq_nominal_ok(lt, rt)).match ({
                true  => 0,
                false => 1,
            }),
        }),
    })
}
// A comparison between a SIGNED int and an UNSIGNED int of rank >= 8 (u16/u32/u64) silently uses C's
// unsigned promotion — `a:i32=-1 < b:u32=1` evaluates FALSE. Reject it. NARROW by design: u8 is
// excluded so byte/char compares (`b == 'a'`) stay fine (u8 always promotes to a signed int safely).
is_signed_int = (t: Ty) bool {
    t.match ({
        .I32      => true,
        .I64      => true,
        .Named(n) => eq(n, "i8") || eq(n, "i16") || eq(n, "i32") || eq(n, "i64"),
        _         => false,
    })
}
is_unsigned_wide = (t: Ty) bool {
    t.match ({
        .Named(n) => eq(n, "u16") || eq(n, "u32") || eq(n, "u64"),
        _         => false,
    })
}
sign_mismatch = (l: Ty, r: Ty) bool { l.is_signed_int() && r.is_unsigned_wide() || l.is_unsigned_wide() && r.is_signed_int() }
// A numeric LITERAL operand is polymorphic and coerces to the other side's type (`n: u64 < 10` is
// fine), so only flag when BOTH sides are non-literal values of genuinely mismatched signedness.
signcmp_err = (env: Env, b: BinData) i32 {
    ((b.op.is_cmp_op_v() || b.op.is_eq_op_v()) && b.lhs.is_lit_numeric() == false && b.rhs.is_lit_numeric() == false).match ({
        true  => env.infer_expr(b.lhs).sign_mismatch(env.infer_expr(b.rhs)).match ({
            true  => 1,
            false => 0,
        }),
        false => 0,
    })
}
operand_err = (env: Env, b: BinData) i32 {
    b.op.is_logic_op().match ({
        true  => (env.non_bool(b.lhs) || env.non_bool(b.rhs)).match ({ true => 1, false => 0 }),
        false => (b.op.is_arith_op() || b.op.is_bitwise_op() || b.op.is_cmp_op_v()).match ({
            true  => env.num_operand_err(b) + env.signcmp_err(b),
            false => b.op.is_eq_op_v().match ({
                true  => env.eq_mix_err(b) + env.signcmp_err(b),
                false => 0,
            }),
        }),
    })
}
// Indexing needs a slice and numeric index; uninferable types skip.
is_slice_ty = (t: Ty) bool {
    t.match ({
        .Slice(e) => true,
        _         => false,
    })
}
non_slice = (env: Env, e: Ptr<Expr>) bool {
    t := env.infer_expr(e)
    env.unknown_ty(t).match ({
        true  => false,
        false => t.is_slice_ty().match ({ true => false, false => true }),
    })
}
index_err = (env: Env, ix: IndexData) i32 { (env.non_slice(ix.seq) || env.non_numeric(ix.idx)).match ({
    true  => 1,
    false => 0,
}) }
// Bare identifiers in value position must resolve to a local/global/function/import/trait/intrinsic.
var_err = (env: Env, name: string_view) i32 {
    (eq(name, "true") || eq(name, "false") || env.is_bound(name) || env.env_known_fn(name) || env.env_imported(name) || env.env_trait_method(name) || name.is_intrinsic() || env.decls.is_tag_const(env.a, name)).match ({
        true  => 0,
        false => 1,
    })
}
// Lowered statement-match tag constants count as generated names.
variant_tags_has = (vs: [VariantDef], a: MutPtr<Malloc>, ename: string_view, name: string_view) bool {
    found := false
    vs.loop((h, i, v) {
        found = eq(name, a.tag_const(ename, v.name)).match ({ true => true, false => found })
    })
    found
}
// A lowered match over a GENERIC enum instance compares against `<mangled>_<variant>` — e.g.
// `Result_i32_IoError_Err`. The concrete EnumDecl is created only at backend monomorphization, so the
// validator recognizes such a tag by shape: it starts with the gen-enum base name and ends with one
// of its variant names (`Result_…` + `…_Err`). Keeps lowered generic-enum guards from false-rejecting.
variant_affix = (a: MutPtr<Malloc>, lead: string_view, vn: string_view) string_view {
    s := a.gstr_string(64)
    s = s.gstr_append(a, lead)
    s = s.gstr_append(a, vn)
    s.gstr_finish(a)
}
gen_tag_match = (a: MutPtr<Malloc>, vs: [VariantDef], base: string_view, name: string_view) bool {
    found := false
    pre := a.variant_affix(base, "_")
    vs.loop((h, i, v) {
        found = (name.starts_with(pre) && name.ends_with(a.variant_affix("_", v.name))).match ({
            true  => true,
            false => found,
        })
    })
    found
}
is_tag_const = (decls: [Decl], a: MutPtr<Malloc>, name: string_view) bool {
    found := false
    decls.loop((h, i, d) {
        found = d.match ({
            .DEnum(ed)   => ed.variants.variant_tags_has(a, ed.name, name).match ({
                true  => true,
                false => found,
            }),
            .DGenEnum(g) => a.gen_tag_match(g.variants, g.name, name).match ({
                true  => true,
                false => found,
            }),
            _            => found,
        })
    })
    found
}
// every element of a slice literal must fit the element type (inferred from the first item). genc
// types the emitted C array by that first element, so a CATEGORY mismatch (a str in an int slice)
// would be silently coerced under -w — a miscompile. Numeric elements stay lenient (C widens them),
// and unknown/generic-residue elements defer (fit_err handles both).
sl_elem_fit = (env: Env, ety: Ty, it: Expr) i32 {
    ity := env.infer_expr(it.addr())
    (ety.ty_rank() >= 0 && ity.ty_rank() >= 0).match ({ true => 0, false => env.fit_err(ity, ety) })
}
// ── narrowed LOOP/lambda-body walk: bare names + structural bool exhaustiveness ───────────────
// Loop bodies are intentionally not fully type-checked before generic specialization. This walk reports
// undefined bare `Var` references and the context-independent one-arm bool-match error. It deliberately
// does NOT run fit / arg-type / operand checks, nor
// resolve call NAMES or struct FIELDS: a generic template's loop body legitimately calls methods on an
// unbound type param (`actor.receive`) and narrows str↔text, both valid pre-mono yet unresolvable here —
// flagging them would false-reject real stdlib. It still RECURSES through every sub-expression (and
// nested match-arm / loop / let binding envs) so a bare undefined name at any depth is caught.
NameErrors: {
    count: i32,
    first_pos: i32,
    first_kind: i32,
}
name_errors_none = () NameErrors {
    NameErrors(
        count: 0,
        first_pos: 0,
        first_kind: 0,
    )
}
name_errors_merge = (l: NameErrors, r: NameErrors) NameErrors {
    NameErrors(
        count: l.count + r.count,
        first_pos: (l.first_pos > 0).match ({ true => l.first_pos, false => r.first_pos }),
        first_kind: (l.first_pos > 0).match ({ true => l.first_kind, false => r.first_kind }),
    )
}
name_error = (env: Env, name: string_view, pos: i32) NameErrors {
    (pos > 0).match ({
        true  => {
            n := env.var_err(name)
            NameErrors(
                count: n,
                first_pos: (n == 0).match ({ true => 0, false => pos }),
                first_kind: (n == 0).match ({ true => 0, false => KUNDEFINED() }),
            )
        },
        false => name_errors_none(),
    })
}
name_errors_onearm = (d: CondData) NameErrors {
    n := d.cond_onearm_err()
    p := load(d.c).expr_pos()
    NameErrors(
        count: n,
        first_pos: (n == 0).match ({ true => 0, false => p }),
        first_kind: (n == 0).match ({ true => 0, false => KBOOLARM() }),
    )
}
name_errors_args = (env: Env, args: [Expr]) NameErrors {
    acc := name_errors_none()
    args.loop((h, i, ar) {
        acc = acc.name_errors_merge(env.name_errors_expr(ar.addr()))
    })
    acc
}
name_errors_inits = (env: Env, inits: [FieldInit]) NameErrors {
    acc := name_errors_none()
    inits.loop((h, i, fi) {
        acc = acc.name_errors_merge(env.name_errors_expr(fi.value))
    })
    acc
}
name_errors_arms = (env: Env, subjty: Ty, arms: [ArmData]) NameErrors {
    acc := name_errors_none()
    arms.loop((h, i, ar) {
        acc = acc.name_errors_merge(env.a.arm_env(env, subjty, ar).name_errors_expr(ar.body))
    })
    acc
}
name_errors_expr = (env: Env, e: Ptr<Expr>) NameErrors {
    load(e).match ({
        // only USER-authored names (pos > 0) are name-checked. Inliner-substituted refs (loop bindings,
        // spliced lets, param→arg) are rebuilt as position-less `vref`s whose binding structure the
        // validator's env doesn't perfectly reconstruct — re-checking them as "undefined" false-rejects.
        .Var(v)         => env.name_error(v.name, v.pos),
        .Call(c)        => eq(c.fn, "sizeof").match ({
            true  => name_errors_none(),
            false => env.name_errors_args(c.args),
        }),    // sizeof's arg is a TYPE name, not a value (mirrors check_expr)
        .SliceLit(sd)   => env.name_errors_args(sd.items),
        .Index(ix)      => env.name_errors_expr(ix.seq).name_errors_merge(env.name_errors_expr(ix.idx)),
        .Bin(b)         => env.name_errors_expr(b.lhs).name_errors_merge(env.name_errors_expr(b.rhs)),
        .Cond(d)        => env.name_errors_expr(d.c).name_errors_merge(env.name_errors_expr(d.t)).name_errors_merge(env.name_errors_expr(d.e)).name_errors_merge(d.name_errors_onearm()),
        .Member(m)      => env.name_errors_expr(m.obj),    // field NAME deferred (h.break_zk etc.)
        .Arrow(ar)      => env.name_errors_expr(ar.obj),
        .Match(m)       => {
            subjty := env.infer_expr(m.subj)
            env.name_errors_expr(m.subj).name_errors_merge(env.name_errors_arms(subjty, m.arms))
        },
        .MakeEnum(mk)   => env.name_errors_expr(mk.payload),
        .MakeStruct(sd) => env.name_errors_inits(sd.inits),
        .Block(b)       => env.a.name_errors_body(env, b.stmts),
        .Loop(l)        => env.name_errors_expr(l.seq).name_errors_merge(env.a.name_errors_body(env.a.loop_env(env, l), l.body)),
        _               => name_errors_none(),
    })
}
name_errors_stmt = (a: MutPtr<Malloc>, env: Env, st: Stmt) NameErrors {
    st.match ({
        .Let(l)      => env.name_errors_expr(l.value),
        .Assign(x)   => env.name_errors_expr(x.target).name_errors_merge(env.name_errors_expr(x.value)),
        .Return(r)   => env.name_errors_expr(r),
        .ExprStmt(e) => env.name_errors_expr(e),
        .If(f)       => env.name_errors_expr(f.c).name_errors_merge(a.name_errors_body(env, f.then)).name_errors_merge(a.name_errors_body(env, f.els)),
        .While(w)    => env.name_errors_expr(w.c).name_errors_merge(a.name_errors_body(env, w.body)),
        .IndexSet(x) => env.name_errors_expr(x.seq).name_errors_merge(env.name_errors_expr(x.idx)).name_errors_merge(env.name_errors_expr(x.value)),
    })
}
name_errors_body = (a: MutPtr<Malloc>, env: Env, body: [Stmt]) NameErrors {
    acc := name_errors_none()
    e := env
    body.loop((h, i, st) {
        acc = acc.name_errors_merge(a.name_errors_stmt(e, st))
        e = a.extend_env(e, st)
    })
    acc
}
// Return/assign/index-set checks only reject concrete mismatches.
ret_err = (env: Env, r: Ptr<Expr>) i32 {
    rt := env.infer_expr(r)
    lv := r.lit_slot_verdict(env.exp)    // a numeric literal return is decided by range
    (lv >= 0).match ({
        true  => lv,
        false => (env.unknown_ty(rt) || env.unknown_ty(env.exp) || env.exp.is_fnt()).match ({
            true  => 0,
            false => fits(rt, env.exp).match ({ true => 0, false => 1 }),
        }),
    })
}
// a function-VALUE return (declared return is a function type) is accepted structurally — ty_eq
// treats FnT as never-equal so fits() can't validate it; C checks the fn-ptr type (M1c).
assign_err = (env: Env, x: AssignData) i32 {
    vt := env.infer_expr(x.target)
    rt := env.infer_expr(x.value)
    lv := x.value.lit_slot_verdict(vt)
    (lv >= 0).match ({
        true  => lv,
        false => (env.unknown_ty(vt) || env.unknown_ty(rt)).match ({
            true  => 0,
            false => fits(rt, vt).match ({ true => 0, false => 1 }),
        }),
    })
}
// Stage 2 mutability, the field-write half: `b.v = …` where `b: Ptr<Box>` (read-only) writes through a
// non-writable pointer — the same hole `store()` guards, via Assign/Member. A `MutPtr<Box>` permits it
// (k_mut_ptr), and plain local/struct mutation (no pointer base) is untouched. A NESTED write
// (`b.inner.v = …`, `b.data[0] = …`) is the same hole one level down: it mutates `*b` just as the
// direct field-set does, so walk the lvalue's member/index chain to its root and reject if the write
// ultimately passes through a read-only `Ptr<T>`.
assign_ptr_write_err = (env: Env, x: AssignData) i32 { env.lvalue_writes_readonly(x.target).match ({
    true  => 1,
    false => 0,
}) }
// the index-set half of the read-only-pointer write guard: `b.data[0] = …` writes into `*b`.
idxset_ptr_write_err = (env: Env, x: IndexSetData) i32 { env.write_thru_readonly(x.seq).match ({
    true  => 1,
    false => 0,
}) }
idxset_err = (env: Env, x: IndexSetData) i32 {
    rt := env.infer_expr(x.value)
    lv := x.value.lit_slot_verdict(x.elem)
    (lv >= 0).match ({
        true  => lv,
        false => (env.unknown_ty(rt) || env.unknown_ty(x.elem)).match ({
            true  => 0,
            false => fits(rt, x.elem).match ({ true => 0, false => 1 }),
        }),
    })
}
// Annotated lets must fit their declared type; unannotated lets are inferred only.
let_fit_err = (env: Env, l: LetData) i32 {
    l.ty.is_void_ty().match ({
        true  => 0,
        false => {
            vt := env.infer_expr(l.value)
            lv := l.value.lit_slot_verdict(l.ty)
            (lv >= 0).match ({
                true  => lv,
                false => (env.unknown_ty(vt) || env.unknown_ty(l.ty)).match ({
                    true  => 0,
                    false => fits(vt, l.ty).match ({ true => 0, false => 1 }),
                }),
            })
        },
    })
}
// A generic type with a `.Void` type-arg (recursing Ptr/Slice/nested generics) — e.g. `Box<void>`.
// An unbound tparam survives inference as void, so the let's stored (inferred) type becomes Box<void>,
// which only ever lowers to `Box_void`, never a usable value.
ty_has_void_targ = (t: Ty) bool {
    t.match ({
        .Generic(g) => g.args.tys_mention_void(),
        .Ptr(pd)    => load(pd.pointee).is_void_ty() || load(pd.pointee).ty_has_void_targ(),
        // A `[void]` element type means a tparam in element/closure-return position was never
        // inferred (e.g. an unannotated `iter.map` with an untyped lambda). It only lowers to
        // garbage, so demand an annotation instead of silently miscompiling to a `[void]` slice.
        .Slice(e)   => load(e).is_void_ty() || load(e).ty_has_void_targ(),
        _           => false,
    })
}
tys_mention_void = (ts: [Ty]) bool {
    f := false
    ts.loop((h, i, t) {
        f = (t.is_void_ty() || t.ty_has_void_targ()).match ({ true => true, false => f })
    })
    f
}
// A let (post-resolve, ty = the inferred/declared type) whose stored type is a generic with an
// uninferred tparam (`empty<T> = (k: i32) Box<T>` then `m := empty(7)` → Box<void> → mono emits
// `Box_void`). check used to pass; require an annotation so the tparam is pinned.
let_needannot_err = (env: Env, l: LetData) i32 { l.ty.ty_has_void_targ().match ({
    true  => 1,
    false => 0,
}) }
DeadList: DeadNil | DeadCons(DeadCell)    // let/assign/while/if/index-set produce no value
// Raw ownership validation runs before resolve_module in the CLI, while source-level
// allocator-explicit `o.release_in(a)` / `r.drop_in(a)` calls still exist. After generic inlining those calls
// become plain pointer operations, so this rule cannot be recovered reliably later.
DeadCell: {
    name: string_view,
    tail: Ptr<DeadList>,
}
dead_buf = (a: MutPtr<Malloc>) [DeadList] { slice(a.acquire(sizeof(DeadList)), 1) }
dead_node = (a: MutPtr<Malloc>, v: DeadList) Ptr<DeadList> {
    buf := a.dead_buf()
    buf[0] = v
    buf[0].addr()
}
dead_nil = (a: MutPtr<Malloc>) Ptr<DeadList> { a.dead_node(.DeadNil) }
dead_cons = (a: MutPtr<Malloc>, name: string_view, tail: Ptr<DeadList>) Ptr<DeadList> {
    a.dead_node(.DeadCons(DeadCell(
        name: name,
        tail: tail,
    )))
}
dead_has = (seen: Ptr<DeadList>, name: string_view) bool {
    seen.match ({
        .DeadNil     => false,
        .DeadCons(c) => eq(c.name, name).match ({ true => true, false => c.tail.dead_has(name) }),
    })
}
// REVIVAL: rebuild the kill-set without `name`. Rebinding a freed/moved local to a fresh value clears
// its dead state (so `p := malloc(); a.release(p); p = malloc(); use(p)` and the idiomatic
// `p = a.resize(p, n)` are NOT use-after-free). Removes every occurrence (dups are harmless).
dead_remove = (a: MutPtr<Malloc>, seen: Ptr<DeadList>, name: string_view) Ptr<DeadList> {
    seen.match ({
        .DeadNil     => seen,
        .DeadCons(c) => eq(c.name, name).match ({
            true  => a.dead_remove(c.tail, name),
            false => a.dead_cons(c.name, a.dead_remove(c.tail, name)),
        }),
    })
}
// ── ALIAS CLASSES (name-only) ────────────────────────────────────────────────────────────────────
// `q := p` copies a POINTER, not the allocation: freeing either name frees the ONE allocation, so a
// later use (or second free) of the other name is a hole the per-name kill-set misses. We track
// direct pointer-copy binds (`q := p` / `q = p`, both bare locals, pointer-typed) as ALIAS PAIRS;
// killing any name kills its whole (transitive) alias class, while REVIVAL stays per-name: rebinding
// `q` detaches only `q` (its pairs are dropped, only `q` leaves the kill-set). Anything indirect —
// field reads, call returns, `.addr()` — is deliberately untracked (under-reject, never over-reject),
// matching the bare-locals-only scope of the rest of this pass.
AliasList: AliasNil | AliasCons(AliasCell)
AliasCell: {
    x: string_view,
    y: string_view,
    tail: Ptr<AliasList>,
}
alias_buf = (a: MutPtr<Malloc>) [AliasList] { slice(a.acquire(sizeof(AliasList)), 1) }
alias_node = (a: MutPtr<Malloc>, v: AliasList) Ptr<AliasList> {
    buf := a.alias_buf()
    buf[0] = v
    buf[0].addr()
}
alias_nil = (a: MutPtr<Malloc>) Ptr<AliasList> { a.alias_node(.AliasNil) }
alias_cons = (a: MutPtr<Malloc>, x: string_view, y: string_view, tail: Ptr<AliasList>) Ptr<AliasList> {
    a.alias_node(.AliasCons(AliasCell(
        x: x,
        y: y,
        tail: tail,
    )))
}
// drop every pair mentioning `name` — a rebind of `name` detaches it from its old class.
alias_drop = (a: MutPtr<Malloc>, al: Ptr<AliasList>, name: string_view) Ptr<AliasList> {
    al.match ({
        .AliasNil     => al,
        .AliasCons(c) => (eq(c.x, name) || eq(c.y, name)).match ({
            true  => a.alias_drop(c.tail, name),
            false => a.alias_cons(c.x, c.y, a.alias_drop(c.tail, name)),
        }),
    })
}
// grow `acc` with every name reachable from `name` through the pair list (transitive closure; `acc`
// doubles as the visited set, so shared members are added once and cycles terminate).
alias_reach = (a: MutPtr<Malloc>, rest: Ptr<AliasList>, full: Ptr<AliasList>, name: string_view, acc: Ptr<DeadList>) Ptr<DeadList> {
    rest.match ({
        .AliasNil     => acc,
        .AliasCons(c) => {
            out := acc
            (eq(c.x, name) && out.dead_has(c.y) == false).then({
                out = a.alias_reach(full, full, c.y, a.dead_cons(c.y, out))
            })
            (eq(c.y, name) && out.dead_has(c.x) == false).then({
                out = a.alias_reach(full, full, c.x, a.dead_cons(c.x, out))
            })
            a.alias_reach(c.tail, full, name, out)
        },
    })
}
// kill `name` AND its alias class: every class member joins the kill-set (its own fresh closure set,
// so members already dead never mask the traversal).
dead_kill = (a: MutPtr<Malloc>, seen: Ptr<DeadList>, al: Ptr<AliasList>, name: string_view) Ptr<DeadList> { a.dead_union(a.alias_reach(al, al, name, a.dead_cons(name, a.dead_nil())), seen) }
owner_base = (t: Ty) string_view {
    t.match ({
        .Generic(g) => g.name,
        .Named(n)   => n,
        _           => "",
    })
}
is_consume_method = (env: Env, c: CallData) bool {
    (c.args.len > 0).match ({
        true  => {
            base := env.infer_expr(c.args[0].addr()).owner_base()
            eq(c.fn, "release").match ({
                true  => eq(base, "Own"),
                false => eq(c.fn, "release_in").match ({
                    true  => eq(base, "Own"),
                    false => eq(c.fn, "drop").match ({
                        true  => eq(base, "Rc") || eq(base, "Arc"),
                        false => eq(c.fn, "drop_in").match ({
                            true  => eq(base, "Rc") || eq(base, "Arc"),
                            false => false,
                        }),
                    }),
                }),
            })
        },
        false => false,
    })
}
is_default_owner_method = (env: Env, c: CallData) bool {
    (c.args.len > 0).match ({
        true  => {
            base := env.infer_expr(c.args[0].addr()).owner_base()
            eq(c.fn, "release").match ({
                true  => eq(base, "Own"),
                false => eq(c.fn, "drop").match ({
                    true  => eq(base, "Rc") || eq(base, "Arc"),
                    false => false,
                }),
            })
        },
        false => false,
    })
}
recv_var_name = (c: CallData) string_view {
    (c.args.len > 0).match ({
        true  => c.args[0].match ({
            .Var(v) => v.name,
            _       => "",
        }),
        false => "",
    })
}
// SENDABILITY — move-on-send. Passing an owned `Own<T>` into a `send(handle, msg)` transfers it to the
// receiving actor, so the sender must not keep using it (otherwise both sides free it → race/double-free).
// We mark the sent owner dead, reusing the use-after-free machinery. Catches the owner sent DIRECTLY or
// wrapped one level in an enum message (`send(h, .Wrap(own))`). Value/str/Arc messages are untouched —
// only `Own` is moved — so the ergonomic common case (value messages) sees zero new friction.
// the launder close: an `Own<T>` sent THROUGH an identity fn (`send(.Give(launder(o)))`) must still kill
// the sender's binding, or the sender keeps a live alias the receiving actor also owns → double-free. When
// the payload is a CALL that RETURNS an owned value and takes EXACTLY ONE `Own` bare-Var argument (the
// identity/wrapper shape), that argument IS the moved owner — name it dead. Deliberately narrow: a multi-arg
// or non-Own-returning call is left alone (honest under-reject over breaking a fn that borrows an Own and
// returns a fresh one). A fresh `send(.Give(make(a)))` (no Own arg) kills nothing — correctly still legal.
sm_own_arg_launder = (env: Env, args: [Expr]) string_view {
    (args.len == 1).match ({
        true  => args[0].match ({
            .Var(v) => eq(env.infer_expr(args[0].addr()).owner_base(), "Own").match ({
                true  => v.name,
                false => "",
            }),
            _       => "",
        }),
        false => "",
    })
}
send_own_var = (env: Env, e: Ptr<Expr>) string_view {
    load(e).match ({
        .Var(v)         => eq(env.infer_expr(e).owner_base(), "Own").match ({
            true  => v.name,
            false => "",
        }),
        .MakeEnum(mk)   => env.send_own_var(mk.payload),
        .Call(c)        => eq(env.infer_expr(e).owner_base(), "Own").match ({
            true  => env.sm_own_arg_launder(c.args),
            false => "",
        }),
        .MethodCall(mc) => eq(env.infer_expr(e).owner_base(), "Own").match ({
            true  => env.sm_own_arg_launder(mc.args),
            false => "",
        }),
        _               => "",
    })
}
// the moved owner in an actor send — the MESSAGE (last arg) of the 2-arg inline / 3-arg parallel send
// (name-matched like the sendable + scratch passes), so the iso move-kill covers the parallel path too.
send_consume = (env: Env, c: CallData) string_view {
    (c.fn.sx_named("send", "__send") && c.args.len >= 2 || c.fn.sx_named("pool_send", "__pool_send") && c.args.len == 3).match ({
        true  => env.send_own_var(c.args[c.args.len - 1].addr()),
        false => "",
    })
}
// ── INTERPROCEDURAL CONSUME (census #56) ──────────────────────────────────────────────────────────
// The consume machinery above is INTRA-procedural: it kills an owner only when THIS function releases/
// drops/sends it. But `o` moved into a callee whose PARAMETER is `Own<T>` and whose body CONSUMES that
// param (release/drop/send, transitively) is a real move — the caller keeps a live alias the callee
// frees → use-after-free / double-free. We close it with a BOUNDED per-function summary: "does fn's
// param `pi` get consumed by fn's body?" (depth-bounded so mutual/self recursion terminates). The
// summary is SOUND-DIRECTION (reject-more) yet zero-over-reject: it is NOT enough for a param to merely
// BE `Own<T>` — Own's own getters (`get`/`ptr`/`count`/`val`/`clone`) take `o: Own<T>` by value and
// must stay legal — the body must actually consume it. Borrowing (an `Own` passed to a `MutPtr<T>`/
// `Ptr<T>` param, or to an Own param the callee only reads) does NOT consume. Only LOCAL callees are
// analyzable; an imported/unknown callee summarizes to false (honest under-reject).
consume_depth = () i32 { 4 }    // interprocedural hop budget; deeper transitive consumes under-reject (safe)
// does the KNOWN local fn `fn` consume its Own-typed param at index `pi`? (bounded interprocedural)
fn_consumes_param = (env: Env, fn: string_view, pi: i32, depth: i32) bool {
    (depth <= 0).match ({
        true  => false,
        false => {
            f := env.env_func(fn)
            (eq(f.name, fn) && pi >= 0 && pi < f.params.len).match ({
                true  => env.body_consumes_name(f.body, f.params[pi].name, depth),
                false => false,
            })
        },
    })
}
// does `body` consume the local named `nm` on ANY path? (branch-may rule: a conditional consume counts)
body_consumes_name = (env: Env, body: [Stmt], nm: string_view, depth: i32) bool {
    found := false
    body.loop((h, i, st) {
        found = env.stmt_consumes_name(st, nm, depth).match ({ true => true, false => found })
    })
    found
}
stmt_consumes_name = (env: Env, st: Stmt, nm: string_view, depth: i32) bool {
    st.match ({
        .Let(l)      => env.expr_consumes_name(l.value, nm, depth),
        .Assign(x)   => env.expr_consumes_name(x.value, nm, depth),
        .Return(r)   => env.expr_consumes_name(r, nm, depth),
        .ExprStmt(e) => env.expr_consumes_name(e, nm, depth),
        .If(f)       => env.expr_consumes_name(f.c, nm, depth) || env.body_consumes_name(f.then, nm, depth) || env.body_consumes_name(f.els, nm, depth),
        .While(w)    => env.expr_consumes_name(w.c, nm, depth) || env.body_consumes_name(w.body, nm, depth),
        .IndexSet(x) => env.expr_consumes_name(x.seq, nm, depth) || env.expr_consumes_name(x.idx, nm, depth) || env.expr_consumes_name(x.value, nm, depth),
    })
}
expr_consumes_name = (env: Env, e: Ptr<Expr>, nm: string_view, depth: i32) bool {
    (depth <= 0).match ({
        true  => false,
        false => load(e).match ({
            .Call(c)      => env.call_consumes_name(c, nm, depth),
            .Block(b)     => env.body_consumes_name(b.stmts, nm, depth),
            .Match(m)     => env.expr_consumes_name(m.subj, nm, depth) || env.arms_consume_name(m.arms, nm, depth),
            .Cond(d)      => env.expr_consumes_name(d.c, nm, depth) || env.expr_consumes_name(d.t, nm, depth) || env.expr_consumes_name(d.e, nm, depth),
            .Loop(l)      => env.expr_consumes_name(l.seq, nm, depth) || env.body_consumes_name(l.body, nm, depth),
            .MakeEnum(mk) => env.expr_consumes_name(mk.payload, nm, depth),
            _             => false,
        }),
    })
}
arms_consume_name = (env: Env, arms: [ArmData], nm: string_view, depth: i32) bool {
    found := false
    arms.loop((h, i, ar) {
        found = env.expr_consumes_name(ar.body, nm, depth).match ({ true => true, false => found })
    })
    found
}
args_consume_name = (env: Env, args: [Expr], nm: string_view, depth: i32) bool {
    found := false
    args.loop((h, i, ar) {
        found = env.expr_consumes_name(ar.addr(), nm, depth).match ({
            true  => true,
            false => found,
        })
    })
    found
}
// does call `c` consume the local `nm`? LEAF: `nm` is the receiver of a release/drop or the moved owner
// of a send. TRANSITIVE: `nm` is a bare-Var arg at an Own-typed param position of a callee that itself
// consumes that param (one interprocedural hop, depth-1). Also descends nested arg exprs.
call_consumes_name = (env: Env, c: CallData, nm: string_view, depth: i32) bool {
    leaf := eq(nm, "") == false && eq(env.is_consume_method(c).match ({
        true  => c.recv_var_name(),
        false => env.send_consume(c),
    }), nm)
    leaf.match ({
        true  => true,
        false => env.call_arg_consumes_name(c, nm, depth) || env.args_consume_name(c.args, nm, depth),
    })
}
// the transitive-hop check, hoisted so the loop's inner match does not nest inside call_consumes_name.
call_arg_consumes_name = (env: Env, c: CallData, nm: string_view, depth: i32) bool {
    ps := env.env_params(c.fn)
    found := false
    (ps.len == c.args.len).then({
        c.args.loop((h, i, ar) {
            (eq(c.arg_var_name(i), nm) && eq(nm, "") == false && eq(ps[i].ty.owner_base(), "Own") && env.fn_consumes_param(c.fn, i, depth - 1)).then({
                found = true
            })
        })
    })
    found
}
// ── FREE-THROUGH-OWNER-POINTER (re-census #1: release via a borrow) ────────────────────────────────
// #56 kills an owner MOVED BY VALUE into an `Own`-typed param. But an owner passed BY POINTER
// (`o.addr()` into a `MutPtr<Own<T>>`/`Ptr<Own<T>>` borrow) whose callee FREES the pointee THROUGH that
// pointer (`load(p).release_in(a)`, directly or via a local bound to the deref) is ALSO consumed: the
// pointer and the caller's `o` name the ONE allocation, so the callee's free leaves `o` dangling and a
// later `o.get()` is a use-after-free that `is_consume_method` (which only fires on a by-value `Own`
// param) misses. We summarize "does fn free the pointee of its pointer param `pi`?" — STRUCTURALLY (a
// release/release_in/drop/drop_in whose receiver is `load(pname)` or a local bound to it), bounded like
// fn_consumes_param — and, at the call site, kill the `o` in `o.addr()` when the matching param is an
// owner-pointer whose callee frees through it. Sound (reject-more) + zero over-reject: gated on the param
// being an owner-pointer AND the callee actually freeing through it; a borrow that only READS through the
// pointer (`load(p).get()`) matches no consume verb and frees nothing, so it stays legal.
is_owner_base = (b: string_view) bool { eq(b, "Own") || eq(b, "Rc") || eq(b, "Arc") }
// the pointee's owner base of a pointer type: `MutPtr<Own<T>>` / `Ptr<Own<T>>` -> "Own" (also Rc/Arc); "" otherwise.
owner_ptr_base = (t: Ty) string_view { t.pointee_of().owner_base() }
// the owner-consume verbs, matched by NAME (no receiver-type infer — the callee's params/locals are not in
// the caller env that drives the summary, so detection must be structural + the call-site param-type gate).
is_consume_fn_name = (fn: string_view) bool { eq(fn, "release") || eq(fn, "release_in") || eq(fn, "drop") || eq(fn, "drop_in") }
// `<owner>.addr()` where the receiver is an Own/Rc/Arc local -> that owner's var name, else "". Inferred in
// the CALLER env (which HAS the local bound by the time own_step reaches the call), so infer resolves it.
addr_owner_var = (env: Env, e: Ptr<Expr>) string_view {
    load(e).match ({
        .Call(c) => (eq(c.fn, "addr") && c.args.len == 1).match ({
            true  => c.args[0].match ({
                .Var(v) => is_owner_base(env.infer_expr(c.args[0].addr()).owner_base()).match ({
                    true  => v.name,
                    false => "",
                }),
                _       => "",
            }),
            false => "",
        }),
        _        => "",
    })
}
// `load(pname)` (or any deref intrinsic reading through `pname`): the borrow deref of a specific pointer.
is_deref_of_var = (e: Ptr<Expr>, pname: string_view) bool {
    load(e).match ({
        .Call(c) => (c.fn.is_deref_intrinsic() && c.args.len >= 1).match ({
            true  => c.args[0].match ({
                .Var(v) => eq(v.name, pname),
                _       => false,
            }),
            false => false,
        }),
        _        => false,
    })
}
// locals bound to a deref of `pname` (`r := load(pname)`): consuming `r` later == consuming the pointee.
cdl_expr = (env: Env, seen: Ptr<DeadList>, e: Ptr<Expr>, pname: string_view) Ptr<DeadList> {
    load(e).match ({
        .Match(m) => env.cdl_arms(seen, m.arms, pname),
        .Block(b) => env.cdl_body(seen, b.stmts, pname),
        .Loop(l)  => env.cdl_body(seen, l.body, pname),
        .Cond(d)  => env.cdl_expr(env.cdl_expr(seen, d.t, pname), d.e, pname),
        _         => seen,
    })
}
cdl_arms = (env: Env, seen: Ptr<DeadList>, arms: [ArmData], pname: string_view) Ptr<DeadList> {
    out := seen
    arms.loop((h, i, ar) {
        out = env.cdl_expr(out, ar.body, pname)
    })
    out
}
cdl_stmt = (env: Env, seen: Ptr<DeadList>, st: Stmt, pname: string_view) Ptr<DeadList> {
    st.match ({
        .Let(l)      => is_deref_of_var(l.value, pname).match ({
            true  => env.a.dead_cons(l.name, seen),
            false => env.cdl_expr(seen, l.value, pname),
        }),
        .Assign(x)   => env.cdl_expr(seen, x.value, pname),
        .If(f)       => env.cdl_body(env.cdl_body(seen, f.then, pname), f.els, pname),
        .While(w)    => env.cdl_body(seen, w.body, pname),
        .ExprStmt(e) => env.cdl_expr(seen, e, pname),
        _            => seen,
    })
}
cdl_body = (env: Env, seen: Ptr<DeadList>, body: [Stmt], pname: string_view) Ptr<DeadList> {
    out := seen
    body.loop((h, i, st) {
        out = env.cdl_stmt(out, st, pname)
    })
    out
}
// does a consume verb in `c` free the pointee of `pname`? receiver is `load(pname)` directly, a local in the
// deref set `dl`, or `pname` is forwarded (by pointer) to a callee that frees through it (one bounded hop).
bft_call = (env: Env, c: CallData, pname: string_view, dl: Ptr<DeadList>, depth: i32) bool {
    leaf := (is_consume_fn_name(c.fn) && c.args.len > 0).match ({
        true  => c.args[0].match ({
            .Var(v) => dl.dead_has(v.name),
            _       => is_deref_of_var(c.args[0].addr(), pname),
        }),
        false => false,
    })
    leaf.match ({
        true  => true,
        false => env.bft_forward(c, pname, depth) || env.bft_args(c.args, pname, dl, depth),
    })
}
// the transitive hop: `pname` passed as a pointer arg to a callee that itself frees through that param.
bft_forward = (env: Env, c: CallData, pname: string_view, depth: i32) bool {
    (depth <= 1).match ({
        true  => false,
        false => {
            ps := env.env_params(c.fn)
            found := false
            (ps.len == c.args.len).then({
                c.args.loop((h, i, ar) {
                    (eq(c.arg_var_name(i), pname) && env.fn_frees_through_ptr(c.fn, i, depth - 1)).then({
                        found = true
                    })
                })
            })
            found
        },
    })
}
bft_args = (env: Env, args: [Expr], pname: string_view, dl: Ptr<DeadList>, depth: i32) bool {
    found := false
    args.loop((h, i, ar) {
        found = env.bft_expr(ar.addr(), pname, dl, depth).match ({ true => true, false => found })
    })
    found
}
bft_arms = (env: Env, arms: [ArmData], pname: string_view, dl: Ptr<DeadList>, depth: i32) bool {
    found := false
    arms.loop((h, i, ar) {
        found = env.bft_expr(ar.body, pname, dl, depth).match ({ true => true, false => found })
    })
    found
}
bft_expr = (env: Env, e: Ptr<Expr>, pname: string_view, dl: Ptr<DeadList>, depth: i32) bool {
    load(e).match ({
        .Call(c)      => env.bft_call(c, pname, dl, depth),
        .Block(b)     => env.bft_body(b.stmts, pname, dl, depth),
        .Match(m)     => env.bft_expr(m.subj, pname, dl, depth) || env.bft_arms(m.arms, pname, dl, depth),
        .Cond(d)      => env.bft_expr(d.c, pname, dl, depth) || env.bft_expr(d.t, pname, dl, depth) || env.bft_expr(d.e, pname, dl, depth),
        .Loop(l)      => env.bft_expr(l.seq, pname, dl, depth) || env.bft_body(l.body, pname, dl, depth),
        .MakeEnum(mk) => env.bft_expr(mk.payload, pname, dl, depth),
        _             => false,
    })
}
bft_stmt = (env: Env, st: Stmt, pname: string_view, dl: Ptr<DeadList>, depth: i32) bool {
    st.match ({
        .Let(l)      => env.bft_expr(l.value, pname, dl, depth),
        .Assign(x)   => env.bft_expr(x.value, pname, dl, depth),
        .Return(r)   => env.bft_expr(r, pname, dl, depth),
        .ExprStmt(e) => env.bft_expr(e, pname, dl, depth),
        .If(f)       => env.bft_expr(f.c, pname, dl, depth) || env.bft_body(f.then, pname, dl, depth) || env.bft_body(f.els, pname, dl, depth),
        .While(w)    => env.bft_expr(w.c, pname, dl, depth) || env.bft_body(w.body, pname, dl, depth),
        .IndexSet(x) => env.bft_expr(x.value, pname, dl, depth),
        _            => false,
    })
}
bft_body = (env: Env, body: [Stmt], pname: string_view, dl: Ptr<DeadList>, depth: i32) bool {
    found := false
    body.loop((h, i, st) {
        found = env.bft_stmt(st, pname, dl, depth).match ({ true => true, false => found })
    })
    found
}
body_frees_through_ptr = (env: Env, body: [Stmt], pname: string_view, depth: i32) bool {
    dl := env.cdl_body(env.a.dead_nil(), body, pname)
    env.bft_body(body, pname, dl, depth)
}
// does the KNOWN local fn `fn` free the pointee of its pointer param at index `pi`? (bounded interprocedural)
fn_frees_through_ptr = (env: Env, fn: string_view, pi: i32, depth: i32) bool {
    (depth <= 0).match ({
        true  => false,
        false => {
            f := env.env_func(fn)
            (eq(f.name, fn) && pi >= 0 && pi < f.params.len).match ({
                true  => env.body_frees_through_ptr(f.body, f.params[pi].name, depth),
                false => false,
            })
        },
    })
}
// the CALL-SITE kill: for each bare-Var Own arg passed to an Own-typed, consuming param of a known
// callee, mark that local dead (moved into the callee). Runs in own_step so both passes see the kill.
// Also (re-census #1): an owner passed BY POINTER (`o.addr()`) to a borrow whose callee frees through it.
own_call_kills = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, c: CallData) Ptr<DeadList> {
    out := seen
    ps := env.env_params(c.fn)
    (ps.len == c.args.len).then({
        c.args.loop((h, i, ar) {
            (eq(ps[i].ty.owner_base(), "Own") && eq(env.infer_expr(ar.addr()).owner_base(), "Own") && env.fn_consumes_param(c.fn, i, consume_depth())).then({
                nm := c.arg_var_name(i)
                (nm.is_empty() == false).then({
                    out = a.dead_kill(out, al, nm)
                })
            })
            (is_owner_base(ps[i].ty.owner_ptr_base()) && env.fn_frees_through_ptr(c.fn, i, consume_depth())).then({
                onm := env.addr_owner_var(ar.addr())
                (onm.is_empty() == false).then({
                    out = a.dead_kill(out, al, onm)
                })
            })
        })
    })
    out
}
// dispatch own_call_kills on the top-level call of an expr (a bare call statement / a call as a
// let/assign value). Nested-deeper calls under-reject (out of the direct-call slice's scope).
own_expr_call_kills = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, e: Ptr<Expr>) Ptr<DeadList> {
    load(e).match ({
        .Call(c) => a.own_call_kills(env, seen, al, c),
        _        => seen,
    })
}
own_stmt_call_kills = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, st: Stmt) Ptr<DeadList> {
    st.match ({
        .ExprStmt(e) => a.own_expr_call_kills(env, seen, al, e),
        .Let(l)      => a.own_expr_call_kills(env, seen, al, l.value),
        .Assign(x)   => a.own_expr_call_kills(env, seen, al, x.value),
        _            => seen,
    })
}
// ── STRUCT-FIELD / SLICE-ELEMENT CONSUME (re-census #63) ───────────────────────────────────────────
// #56 closed owner-PARAM moves but explicitly left the IDIOMATIC case open: moving an `Own<T>` into a
// struct-LITERAL field (`Box(o: o)`) or a slice element (`[o]`, `arr[i] = o`). A struct/slice copy does
// NOT bump the owner's refcount, so the field and the source name the ONE allocation: freeing through the
// field (`b.o.release_in(a)`) then using the source (`o.get()`) is a use-after-free, and the same owner
// into two Own fields (`Two(a: o, b: o)`) is a double-move. We count the field/element init as a CONSUME
// of the source binding, reusing the #56 kill machinery (dead_kill), so a later use of the source →
// error[ownership]. ZERO over-reject: only an `Own<T>` bare-Var moved into an `Own<T>`-TYPED field
// consumes — a BORROW field (`MutPtr<T>`/`Ptr<T>`, reached via `o.ptr()`, a Call not a Var), a value /
// scalar field, and a `.clone()` init (a Call) do NOT. Only CONCRETE struct literals are analyzable; a
// generic-struct literal has no concrete field types here, so it under-rejects (honest, safe).
field_ty_by_name = (fields: [Field], name: string_view) Ty {
    found := tvoid()
    fields.loop((h, i, fl) {
        found = eq(fl.name, name).match ({ true => fl.ty, false => found })
    })
    found
}
// the bare-Var name of an expr whose inferred type is `Own<T>` (else "") — the moved-owner shape shared
// by every consume site (mirrors own_var_move / sm_own_arg_launder).
own_moved_var = (env: Env, e: Ptr<Expr>) string_view {
    load(e).match ({
        .Var(v) => eq(env.infer_expr(e).owner_base(), "Own").match ({ true => v.name, false => "" }),
        _       => "",
    })
}
// the owner moved by a struct-literal field init: the field's DECLARED type is `Own<T>` AND the init is a
// bare `Own<T>` Var. The field-type gate is exactly what keeps a borrow field (`p: MutPtr<T>`) legal.
struct_field_move_src = (env: Env, fields: [Field], fi: FieldInit) string_view {
    eq(field_ty_by_name(fields, fi.name).owner_base(), "Own").match ({
        true  => env.own_moved_var(fi.value),
        false => "",
    })
}
// kill every source owner moved into an Own field of a CONCRETE struct literal.
mkstruct_field_kills = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, s: MakeStructData) Ptr<DeadList> {
    out := seen
    env.env_is_struct(s.ty).then({
        fields := env.env_struct_fields(s.ty)
        s.inits.loop((h, i, fi) {
            nm := env.struct_field_move_src(fields, fi)
            (nm.is_empty() == false).then({
                out = a.dead_kill(out, al, nm)
            })
        })
    })
    out
}
// kill every source owner moved into a slice-literal element (`[o]`): a bare `Own<T>` item is moved into
// the slice's element slot exactly like an Own field. A borrowed `[o.ptr()]` item is a Call, not a Var.
slicelit_elem_kills = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, items: [Expr]) Ptr<DeadList> {
    out := seen
    items.loop((h, i, it) {
        nm := env.own_moved_var(it.addr())
        (nm.is_empty() == false).then({
            out = a.dead_kill(out, al, nm)
        })
    })
    out
}
// kill the source owner stored into a slice slot by `arr[i] = o` (the value is a bare `Own<T>` Var).
indexset_own_kill = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, v: Ptr<Expr>) Ptr<DeadList> {
    out := seen
    nm := env.own_moved_var(v)
    (nm.is_empty() == false).then({
        out = a.dead_kill(out, al, nm)
    })
    out
}
own_expr_struct_kills = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, e: Ptr<Expr>) Ptr<DeadList> {
    load(e).match ({
        .MakeStruct(s) => a.mkstruct_field_kills(env, seen, al, s),
        // slice element move: gated on the slice's DECLARED element type being `Own<T>`, so a non-Own
        // slice never triggers the per-item `infer_expr`. This matters because this kill runs inside
        // own_step's exponential branch re-analysis; an ungated infer there is prohibitively costly on the
        // raw (pre-resolve) tree. A void elem (not yet inferred) skips → honest under-reject.
        .SliceLit(sd)  => eq(sd.elem.owner_base(), "Own").match ({
            true  => a.slicelit_elem_kills(env, seen, al, sd.items),
            false => seen,
        }),
        _              => seen,
    })
}
// dispatch struct/slice move-kills on the top-level value of a let/assign/expr statement (and the value
// of `arr[i] = o`). Nested-deeper literals under-reject (same direct-value scope as own_stmt_call_kills).
own_stmt_struct_kills = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, st: Stmt) Ptr<DeadList> {
    st.match ({
        .Let(l)      => a.own_expr_struct_kills(env, seen, al, l.value),
        .Assign(x)   => a.own_expr_struct_kills(env, seen, al, x.value),
        .ExprStmt(e) => a.own_expr_struct_kills(env, seen, al, e),
        // `arr[i] = o`: gated on the slot's DECLARED element type being `Own<T>` (same reason as SliceLit).
        .IndexSet(x) => eq(x.elem.owner_base(), "Own").match ({
            true  => a.indexset_own_kill(env, seen, al, x.value),
            false => seen,
        }),
        _            => seen,
    })
}
// the DOUBLE-MOVE error: the same owner moved into TWO Own fields of one struct literal (`Two(a: o, b: o)`)
// — the second move is a use-after-consume. Threads a FRESH in-literal kill-set so it counts ONLY the
// Intra-literal duplicate tracking is separate from the already-dead binding check so the positioned
// visitor reports the second move once, at the value that performs it.
// AFFINE COPY: `c := o` / `c = o` where `o` is `Own<T>` MOVES o — a bare struct copy does NOT bump the
// refcount (only `.clone()` does), so both names free the ONE allocation → double-free. c becomes the
// live owner; o's binding dies (later use of o → use-after-consume). `c := o.clone()` is a Call, not a
// bare Var, so it is NOT a move (the legitimate two-owner path). Self-copy `o = o` moves nothing.
own_var_move = (env: Env, e: Ptr<Expr>, tgt: string_view) string_view {
    load(e).match ({
        .Var(v) => (eq(env.infer_expr(e).owner_base(), "Own") && eq(v.name, tgt) == false).match ({
            true  => v.name,
            false => "",
        }),
        _       => "",
    })
}
own_move_src = (env: Env, st: Stmt) string_view {
    st.match ({
        .Let(l)    => env.own_var_move(l.value, l.name),
        .Assign(x) => env.own_var_move(x.value, target_var_name(x.target)),
        _          => "",
    })
}
// the bare-Var name of arg `i` (else ""). We only track frees/escapes of SIMPLE LOCALS — a field free
// like `a.release(m.keys)` (vec/map grow constantly do this) is deliberately NOT tracked, so the
// stdlib does not over-reject. Field-level liveness is out of scope for v1.
arg_var_name = (c: CallData, i: i32) string_view {
    (i < c.args.len).match ({
        true  => c.args[i].match ({
            .Var(v) => v.name,
            _       => "",
        }),
        false => "",
    })
}
ty_is_ptr_t = (t: Ty) bool {
    t.match ({
        .Ptr(pd) => true,
        _        => false,
    })
}
// DEEP `val` check: does type `t` reachably expose a `MutPtr<T>` (Pony `ref` — a mutable, aliasable
// pointer) that a receiver holding this payload could mutate through? A `val` must be DEEP: a readonly
// `Ptr<T>` (kind 1 = `box`) is only sendable when T is ITSELF deeply-immutable — a `Ptr<Outer>` whose
// Outer reachably holds a `MutPtr` field still lets the receiver reach mutable state one hop deeper
// (the same cross-actor race). So this descends, bounded by `depth`:
//   • readonly `Ptr`/`RawPtr` views (kinds 0/1) — one hop through the pointee;
//   • NAMED struct fields AND non-generic enum variant payloads (a `.Named` is one or the other);
//   • SLICE element types — `[MutPtr<X>]` reaches a mutable pointer per element;
//   • GENERIC type ARGUMENTS — `Box<MutPtr<X>>` / `Vec<MutPtr<X>>` carry the mutable pointer as their
//     element. We descend the ARGS (the semantic payload the container carries), NOT the container's
//     internal representation, so a `Vec<i32>` whose private buffer happens to be a `MutPtr<i32>` is
//     NOT wrongly rejected — only its element type `i32` is inspected.
// It TERMINATES as immutable (false) at scalars, str, function types, and the OPAQUE CAPABILITY generics
// `Own<T>` (iso, moved), `Arc<T>` (shared), `Rc<T>` (also caught by the send-rc pass), `ReplyRef`/
// `ActorRef` (deliberately RawPtr-backed): their interior aliasing is governed by their own capability,
// not by a structural alias, so we do NOT descend their args (descending `Arc<MutPtr<X>>` would wrongly
// reject a legitimately-shared value). Bounded recursion (`depth`) terminates on recursive types.
ty_reaches_mutptr = (decls: [Decl], t: Ty, depth: i32) bool {
    (depth <= 0).match ({
        true  => false,
        false => t.match ({
            .Ptr(pd)    => (pd.kind == k_mut_ptr()).match ({
                true  => true,
                false => decls.ty_reaches_mutptr(load(pd.pointee), depth - 1),
            }),
            .Named(n)   => decls.fields_reach_mutptr(decls.struct_fields(n), depth - 1) || decls.variants_reach_mutptr(decls.enum_variants(n), depth - 1),
            .Slice(e)   => decls.ty_reaches_mutptr(load(e), depth - 1),
            .Generic(g) => sm_is_opaque_cap(g.name).match ({
                true  => false,
                false => decls.tys_reach_mutptr(g.args, depth - 1),
            }),
            _           => false,
        }),
    })
}
// the opaque capability generics: their type args must NOT be structurally descended (they mediate their
// own interior aliasing — see the send-rc / owner-verb capability set: Own/Arc/Rc + the two actor caps).
sm_is_opaque_cap = (name: string_view) bool { eq(name, "Own") || eq(name, "Arc") || eq(name, "Rc") || eq(name, "ReplyRef") || eq(name, "ActorRef") }
fields_reach_mutptr = (decls: [Decl], fields: [Field], depth: i32) bool {
    f := false
    fields.loop((h, i, fl) {
        f = decls.ty_reaches_mutptr(fl.ty, depth).match ({ true => true, false => f })
    })
    f
}
variants_reach_mutptr = (decls: [Decl], variants: [VariantDef], depth: i32) bool {
    f := false
    variants.loop((h, i, v) {
        f = decls.ty_reaches_mutptr(v.payload, depth).match ({ true => true, false => f })
    })
    f
}
tys_reach_mutptr = (decls: [Decl], tys: [Ty], depth: i32) bool {
    f := false
    tys.loop((h, i, ty) {
        f = decls.ty_reaches_mutptr(ty, depth).match ({ true => true, false => f })
    })
    f
}
// ── THE MODE (effect-family) LATTICE — the aliasing effect a type carries, DERIVED not stored ──
// (docs/effects-as-types-design.md §2). One `mode_of(decls, t)` fact feeds every consumer of the
// aliasing effect; no Env/Ty change (`decls` is already an Env field). Spelled as i32 consts, like
// `k_ptr()`/`k_mut_ptr()` in genc. The four Pony reference-capabilities, in Zen's spelling:
//   owned  (iso) — unique, movable, sendable         (an `Own<T>` wrapper)
//   frozen (val) — deeply immutable → sendable        (reaches no MutPtr)
//   mut    (ref) — mutable+aliasable, NOT sendable     (a top-level MutPtr<T>)
//   read   (box) — readonly alias that REACHES a MutPtr → local alias only, not sendable
md_owned* = () i32 { 0 }
md_frozen* = () i32 { 1 }
md_mut* = () i32 { 2 }
md_read* = () i32 { 3 }
// Derive the mode of a type, EXACTLY per the design doc's four-arm rule. `Own<T>` short-circuits first
// (opaque capability, stopped in ty_reaches_mutptr at sm_is_opaque_cap); a top-level MutPtr is `mut`;
// otherwise the deep immutability walk decides frozen (reaches no MutPtr) vs read (reaches one behind a
// readonly surface). Pure function of `(decls, Ty)` — no program point, so it classifies but does NOT
// enforce use-once/escape (those stay flow-sensitive passes).
mode_of* = (decls: [Decl], t: Ty) i32 {
    eq(t.owner_base(), "Own").match ({
        true  => md_owned(),
        false => (t.ptr_kind_of() == k_mut_ptr()).match ({
            true  => md_mut(),
            false => decls.ty_reaches_mutptr(t, 16).match ({
                true  => md_read(),
                false => md_frozen(),
            }),
        }),
    })
}
// SEND-payload sendability leaf, expressed through the shared mode lattice: a payload is sendable iff its
// mode is `owned` (moved uniquely) or `frozen` (deeply immutable). `mut`/`read` (a live mutable alias, or
// a readonly alias that still reaches a MutPtr) are rejected — a cross-actor data race. Behavior-identical
// to the previous `ty_reaches_mutptr(...) == false` leaf (see mode_of arms).
mode_sendable* = (m: i32) bool { m == md_owned() || m == md_frozen() }
// ALLOCATOR-CENTRIC free detection. The free surface is the `Allocator` trait, generic over every
// allocator (built-in Heap/Malloc and user-defined) because conformance fixes the method names:
//   a.release(p)     — frees ptr arg `p`        (receiver `a` is a MutPtr<_>, NOT an Own/Rc/Arc)
//   a.resize(p, n)   — frees the OLD ptr `p`    (returns a NEW pointer; old `p` dangles)
//   free(p)          — raw FFI/bootstrap floor  (rare in user code)
// The receiver being a pointer (`.Ptr`) — not an Own/Rc/Arc generic — disambiguates the allocator
// `release` from the owner `o.release(a)` consume (handled by is_consume_method). Returns the freed
// bare-local name, or "" when nothing simple is freed.
alloc_free_call_name = (env: Env, c: CallData) string_view {
    eq(c.fn, "free").match ({
        true  => (c.args.len == 1).match ({ true => c.arg_var_name(0), false => "" }),
        false => eq(c.fn, "release").match ({
            true  => (c.args.len == 2 && env.infer_expr(c.args[0].addr()).ty_is_ptr_t()).match ({
                true  => c.arg_var_name(1),
                false => "",
            }),
            false => eq(c.fn, "resize").match ({
                true  => (c.args.len == 3 && env.infer_expr(c.args[0].addr()).ty_is_ptr_t()).match ({
                    true  => c.arg_var_name(1),
                    false => "",
                }),
                false => "",
            }),
        }),
    })
}
// the freed local for a whole statement: a bare free call, or a free that is the VALUE of a let/assign
// (e.g. `p = a.resize(p, n)` frees the old `p`; the rebind then revives it in own_step).
alloc_free_expr_name = (env: Env, e: Ptr<Expr>) string_view {
    load(e).match ({
        .Call(c) => env.alloc_free_call_name(c),
        _        => "",
    })
}
alloc_free_stmt_name = (env: Env, st: Stmt) string_view {
    st.match ({
        .ExprStmt(e) => env.alloc_free_expr_name(e),
        .Let(l)      => env.alloc_free_expr_name(l.value),
        .Assign(x)   => env.alloc_free_expr_name(x.value),
        _            => "",
    })
}
// the local (re)bound by a statement — clears its dead state (revival). A bare-Var assign target only;
// a compound target like `arr[i]`/`m.f` is a write THROUGH the base, not a rebind of a local.
// the bare-Var name of an assign/index target (else ""). Hoisted to its own fn: a nested match inside
// an outer statement-match arm miscompiles, so the load+match lives here.
target_var_name = (t: Ptr<Expr>) string_view {
    load(t).match ({
        .Var(v) => v.name,
        _       => "",
    })
}
rebind_stmt_name = (st: Stmt) string_view {
    st.match ({
        .Let(l)    => l.name,
        .Assign(x) => target_var_name(x.target),
        _          => "",
    })
}
// the source name of a direct pointer copy (`q := p` / `q = p`): a bare Var whose inferred type is a
// pointer (any `.Ptr` kind). Non-pointer copies (ints, structs, owners) never join an alias class.
copy_src_name = (env: Env, e: Ptr<Expr>) string_view {
    load(e).match ({
        .Var(v) => env.infer_expr(e).ty_is_ptr_t().match ({ true => v.name, false => "" }),
        _       => "",
    })
}
alias_src_name = (env: Env, st: Stmt) string_view {
    st.match ({
        .Let(l)    => env.copy_src_name(l.value),
        .Assign(x) => env.copy_src_name(x.value),
        _          => "",
    })
}
// thread the alias-pair set across a statement: a rebind detaches the target from its old class,
// then a direct pointer copy pairs target and source. Runs alongside own_step (aliases established
// BEFORE a statement govern that statement's kills).
alias_step = (a: MutPtr<Malloc>, env: Env, al: Ptr<AliasList>, st: Stmt) Ptr<AliasList> {
    rb := rebind_stmt_name(st)
    out := rb.is_empty().match ({ true => al, false => a.alias_drop(al, rb) })
    src := env.alias_src_name(st)
    (rb.is_empty() == false && src.is_empty() == false && eq(rb, src) == false).then({
        out = a.alias_cons(rb, src, out)
    })
    out
}
// count an assign TARGET as a use only when it is NOT a bare local (a bare `p = …` is a rebind/revival,
// not a read of `p`; a compound `arr[i] = …` / `m.f = …` reads the base/index, so still check those).
kv_own_assign_target_kind = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, t: Ptr<Expr>) i32 {
    load(t).match ({
        .Var(v) => 0,
        _       => a.kv_own_expr_kind(env, seen, al, t),
    })
}
consume_name = (env: Env, st: Stmt) string_view {
    st.match ({
        .ExprStmt(e) => load(e).match ({
            .Call(c) => env.is_consume_method(c).match ({
                true  => c.recv_var_name(),
                false => env.send_consume(c),
            }),
            _        => "",
        }),
        _            => "",
    })
}
// BRANCH-AWARE dead-set helpers. A free performed inside a branch (if/while body, match arm) makes the
// freed local CONDITIONALLY dead; the safe, simple rule is to treat it as dead AFTER the branch, so a
// later UNCONDITIONAL free/use is flagged as a double-free / use-after-free. A branch that does NOT fall
// through (its body ends in `return`) cannot reach the post-branch code, so its frees are EXCLUDED from
// the post-branch set — this is what keeps the common error-path idiom legal:
//   cond.match ({ err => { a.release(p)  return 1 }, ok => {} })   a.release(p)   // NOT a double-free
// (the freeing arm returned, so the `release(p)` after only runs on the ok path, where p is still live).
dead_union = (a: MutPtr<Malloc>, x: Ptr<DeadList>, y: Ptr<DeadList>) Ptr<DeadList> {
    x.match ({
        .DeadNil     => y,
        .DeadCons(c) => a.dead_cons(c.name, a.dead_union(c.tail, y)),
    })
}
// does control flow off the END of this body reach the next statement? false only when it ends in return.
body_falls_through = (body: [Stmt]) bool {
    (body.len == 0).match ({
        true  => true,
        false => body[body.len - 1].match ({
            .Return(r) => false,
            _          => true,
        }),
    })
}
// a match-arm / Cond body is an Expr; it diverges only when it is a Block ending in `return`.
expr_falls_through = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Block(b) => body_falls_through(b.stmts),
        _         => true,
    })
}
// net dead-set after a (possibly branching) statement body — threads own_step + alias_step + env
// Follow the same environment/alias steps as the ownership diagnostic walk, but return the final kill-set.
own_dead_body = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, body: [Stmt]) Ptr<DeadList> {
    e := env
    d := seen
    al2 := al
    body.loop((h, i, st) {
        d = a.own_step(e, d, al2, st)
        al2 = a.alias_step(e, al2, st)
        e = a.extend_env(e, st)
    })
    d
}
// union of the per-arm net dead-sets, over the arms that fall through (a returning arm contributes
// nothing to the post-match set). Each arm is evaluated from the pre-match kill-set `seen`.
own_dead_arms = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, subjty: Ty, arms: [ArmData]) Ptr<DeadList> {
    out := seen
    arms.loop((h, i, ar) {
        expr_falls_through(ar.body).then({
            out = a.dead_union(a.own_dead_expr(a.arm_env(env, subjty, ar), seen, al, ar.body), out)
        })
    })
    out
}
// net dead-set after an expression in statement position (a statement-position match, a block, a ternary,
// or a bare free/consume call as a match-arm body). Mirrors own_step's free/consume detection.
own_dead_expr = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, e: Ptr<Expr>) Ptr<DeadList> {
    load(e).match ({
        .Block(b) => a.own_dead_body(env, seen, al, b.stmts),
        .Match(m) => a.own_dead_arms(env, seen, al, env.infer_expr(m.subj), m.arms),
        // a bool `.match` lowers to a Cond (ternary); apply the same fall-through exclusion as match arms
        // so a branch that ends in `return` does not propagate its frees past the conditional.
        .Cond(d)  => a.dead_union(expr_falls_through(d.t).match ({
            true  => a.own_dead_expr(env, seen, al, d.t),
            false => seen,
        }), expr_falls_through(d.e).match ({
            true  => a.own_dead_expr(env, seen, al, d.e),
            false => seen,
        })),
        // a loop body may run: its frees are conditionally dead after the loop (same may-rule as branches).
        .Loop(l)  => a.own_dead_body(env, seen, al, l.body),
        .Call(c)  => {
            out := seen
            fn := env.alloc_free_call_name(c)
            (fn.is_empty() == false).then({
                out = a.dead_kill(out, al, fn)
            })
            cn := env.is_consume_method(c).match ({
                true  => c.recv_var_name(),
                false => env.send_consume(c),
            })
            (cn.is_empty() == false).then({
                out = a.dead_kill(out, al, cn)
            })
            out
        },
        _         => seen,
    })
}
own_step = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, st: Stmt) Ptr<DeadList> {
    out := seen
    // 1. owner consume (Own.release / Rc.drop / …) marks the receiver dead.
    nm := env.consume_name(st)
    (nm.is_empty() == false).then({
        out = a.dead_kill(out, al, nm)
    })
    // 2. allocator free (a.release(p) / a.resize(p,n) / free(p)) marks the freed local dead — and its
    //    whole alias class with it (every member names the SAME allocation).
    fn := env.alloc_free_stmt_name(st)
    (fn.is_empty() == false).then({
        out = a.dead_kill(out, al, fn)
    })
    // 2b. branch-aware: descend into if/while bodies and statement-position matches/blocks so a free
    //     inside a branch enters the kill-set (conditionally dead → dead after the branch). Only branches
    //     that FALL THROUGH contribute; free-then-rebind within one branch nets to ALIVE via own_step.
    out = st.match ({
        .If(f)       => a.dead_union(body_falls_through(f.then).match ({
            true  => a.own_dead_body(env, out, al, f.then),
            false => out,
        }), body_falls_through(f.els).match ({
            true  => a.own_dead_body(env, out, al, f.els),
            false => out,
        })),
        .While(w)    => body_falls_through(w.body).match ({
            true  => a.own_dead_body(env, out, al, w.body),
            false => out,
        }),
        .ExprStmt(e) => a.own_dead_expr(env, out, al, e),
        _            => out,
    })
    // 2c. INTERPROCEDURAL consume (census #56): an `Own<T>` local moved into an owner-typed param whose
    //     callee CONSUMES it (release/drop/send, transitively) is dead after the call — later use → UAF.
    out = a.own_stmt_call_kills(env, out, al, st)
    // 2c'. STRUCT-FIELD / SLICE-ELEMENT move (re-census #63): an `Own<T>` moved into an Own struct-literal
    //      field / slice element is consumed here — later use of the source binding → UAF / double-free.
    out = a.own_stmt_struct_kills(env, out, al, st)
    // 2d. AFFINE COPY: `c := o` / `c = o` (o an `Own<T>`) MOVES o — c is the live owner, o's binding dies.
    mv := env.own_move_src(st)
    (mv.is_empty() == false).then({
        out = a.dead_kill(out, al, mv)
    })
    // 3. revival — a (re)bind of a local clears its dead state (ONLY that name: an alias of it stays
    //    dead). Runs LAST so `p = a.resize(p, n)` (free old p in step 2, then rebind p here) nets to
    //    ALIVE, while `q := a.resize(p, n)` leaves p dead (q != p).
    rb := rebind_stmt_name(st)
    (rb.is_empty() == false).then({
        out = a.dead_remove(out, rb)
    })
    out
}
// ── FREE-IN-LOOP ─────────────────────────────────────────────────────────────────────────────────
// A loop body runs N times, but the lexical walk sees it once: a body that frees a local declared
// OUTSIDE the loop and does not rebind it before the iteration ends frees the same pointer again on
// the next iteration — a double-free the single walk misses. The net kill-set of ONE body walk
// (branch-aware, so a conditional free counts — the same may-rule as the post-branch dead-set)
// contains exactly the names freed-per-iteration; any of them declared OUTSIDE the body (not a body
// `let`, not a loop binding) is flagged. The `p = a.resize(p, n)` grow idiom rebinds in the same
// statement, so it nets to alive and stays legal; free-then-`return` arms are excluded by the usual
// fall-through rule (the loop is exited, no second free).
// every `let` name anywhere in a body (incl. nested arms/blocks/loops): fresh per iteration.
loop_lets = (a: MutPtr<Malloc>, acc: Ptr<DeadList>, body: [Stmt]) Ptr<DeadList> {
    out := acc
    body.loop((h, i, st) {
        out = a.loop_lets_stmt(out, st)
    })
    out
}
loop_lets_stmt = (a: MutPtr<Malloc>, acc: Ptr<DeadList>, st: Stmt) Ptr<DeadList> {
    st.match ({
        .Let(l)      => a.loop_lets_expr(a.dead_cons(l.name, acc), l.value),
        .Assign(x)   => a.loop_lets_expr(acc, x.value),
        .Return(r)   => a.loop_lets_expr(acc, r),
        .ExprStmt(e) => a.loop_lets_expr(acc, e),
        .If(f)       => a.loop_lets(a.loop_lets(acc, f.then), f.els),
        .While(w)    => a.loop_lets(acc, w.body),
        _            => acc,
    })
}
loop_lets_expr = (a: MutPtr<Malloc>, acc: Ptr<DeadList>, e: Ptr<Expr>) Ptr<DeadList> {
    load(e).match ({
        .Block(b) => a.loop_lets(acc, b.stmts),
        .Match(m) => a.loop_lets_arms(acc, m.arms),
        .Cond(d)  => a.loop_lets_expr(a.loop_lets_expr(acc, d.t), d.e),
        .Loop(l)  => a.loop_lets(a.dead_cons(l.h, a.dead_cons(l.elem, a.dead_cons(l.idx, acc))), l.body),
        _         => acc,
    })
}
loop_lets_arms = (a: MutPtr<Malloc>, acc: Ptr<DeadList>, arms: [ArmData]) Ptr<DeadList> {
    out := acc
    arms.loop((h, i, ar) {
        out = a.loop_lets_expr(out, ar.body)
    })
    out
}
// count each net-new dead name declared OUTSIDE the body, once (`done` dedupes the cons-list walk).
count_loop_freed = (a: MutPtr<Malloc>, net: Ptr<DeadList>, base: Ptr<DeadList>, locals: Ptr<DeadList>, done: Ptr<DeadList>) i32 {
    net.match ({
        .DeadNil     => 0,
        .DeadCons(c) => (base.dead_has(c.name) || locals.dead_has(c.name) || done.dead_has(c.name)).match ({
            true  => a.count_loop_freed(c.tail, base, locals, done),
            false => 1 + a.count_loop_freed(c.tail, base, locals, a.dead_cons(c.name, done)),
        }),
    })
}
loop_body_outer_frees = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, body: [Stmt], binds: Ptr<DeadList>) i32 {
    net := a.own_dead_body(env, seen, al, body)
    a.count_loop_freed(net, seen, a.loop_lets(binds, body), a.dead_nil())
}
loop_outer_frees = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, l: LoopData) i32 { a.loop_body_outer_frees(env, seen, al, l.body, a.dead_cons(l.h, a.dead_cons(l.elem, a.dead_cons(l.idx, a.dead_nil())))) }
// Compatibility verdict API. The positioned diagnostic visitor below is authoritative; keeping a
// second count-only AST walk made every new rule land twice and invited count/kind drift.
check_module_ownership* = (a: MutPtr<Malloc>, decls: [Decl]) i32 { (a.check_module_ownership_kind(decls) == 0).match ({
    true  => 0,
    false => 1,
}) }
// trait conformance: a `Type.impl(Trait)` must DEFINE every method the Trait declares, with a
// MATCHING SIGNATURE. The Trait is a struct whose FnT fields are the method signatures (using `Self`
// for the implementing type); im.methods is the names this impl provides, and the impl's actual
// method bodies are top-level DFuncs found by name. So per declared method: missing → 1 error;
// present but signature-mismatched → 1 error; present and matching → 0. The check is tied to THIS
// impl (im.methods), not a global function search, so an unrelated same-named fn never satisfies it.
has_method = (methods: [Param], name: string_view) bool {
    found := false
    methods.loop((h, i, p) {
        found = eq(p.name, name).match ({ true => true, false => found })
    })
    found
}
// rewrite `Self` to the implementing type throughout a trait method's type (recursing Ptr/Slice).
impl_ty = (tyname: string_view) Ty {
    eq(tyname, "i32").match ({
        true  => ti32(),
        false => eq(tyname, "i64").match ({
            true  => ti64(),
            false => eq(tyname, "u8").match ({
                true  => tu8(),
                false => eq(tyname, "f64").match ({
                    true  => tf64(),
                    false => eq(tyname, "bool").match ({
                        true  => tbool(),
                        false => eq(tyname, "string_view").match ({
                            true  => tstring_view(),
                            false => eq(tyname, "str").match ({
                                true  => tstring_view(),
                                false => tnamed(tyname),
                            }),
                        }),
                    }),
                }),
            }),
        }),
    })
}
subst_self = (a: MutPtr<Malloc>, t: Ty, tyname: string_view) Ty {
    t.match ({
        .Named(n) => eq(n, "Self").match ({ true => impl_ty(tyname), false => t }),
        .Ptr(pd)  => tptr_k(a.tnode(a.subst_self(load(pd.pointee), tyname)), pd.kind),
        .Slice(p) => tslice(a.tnode(a.subst_self(load(p), tyname))),
        _         => t,
    })
}
// each declared param type (Self→tyname) must equal the impl method's, left to right.
params_match = (a: MutPtr<Malloc>, tps: [Ty], ips: [Param], tyname: string_view, i: i32) bool {
    (i == tps.len).match ({
        true  => true,
        false => a.subst_self(tps[i], tyname).ty_eq(ips[i].ty).match ({
            true  => a.params_match(tps, ips, tyname, i + 1),
            false => false,
        }),
    })
}
// the impl method `f` matches the trait's FnT field `fd` (Self→tyname): same arity, param types, ret.
sig_matches = (a: MutPtr<Malloc>, fd: FnTData, f: Func, tyname: string_view) bool {
    (fd.params.len == f.params.len).match ({
        true  => a.params_match(fd.params, f.params, tyname, 0).match ({
            true  => a.subst_self(load(fd.ret), tyname).ty_eq(f.ret),
            false => false,
        }),
        false => false,
    })
}
// does the trait `trname` declare a DEFAULT body for method `m`? (then an impl may OMIT it.)
trait_has_default = (decls: [Decl], trname: string_view, m: string_view) bool {
    found := false
    decls.loop((h, i, d) {
        found = d.match ({
            .DTraitDefault(td) => (eq(td.trname, trname) && eq(td.fn.name, m)).match ({
                true  => true,
                false => found,
            }),
            _                  => found,
        })
    })
    found
}
// one declared trait field: 0 if it's not a method, or it's provided with a matching signature, or it
// is OMITTED but the trait supplies a default body; 1 if the method is missing (no default) or differs.
method_err = (a: MutPtr<Malloc>, decls: [Decl], im: ImplData, f: Field) i32 {
    f.ty.match ({
        .FnT(fd) => im.methods.has_method(f.name).match ({
            true  => a.sig_matches(fd, decls.the_func(a.impl_cname_in(im.trname, im.ty, f.name)), im.ty).match ({
                true  => 0,
                false => 1,
            }),
            false => decls.trait_has_default(im.trname, f.name).match ({ true => 0, false => 1 }),
        }),    // omitted: OK iff defaulted
        _        => 0,
    })
}
// Two top-level decls with the same FUNCTION name emit colliding C definitions (cc "redefinition" /
// "conflicting types") — the self-hosted backend mangles only generic-type instances, not plain fns,
// so two `f`s (or two trait impls of one method) both emit `… f(…)`. Reject the second. Zen has no
// overloading.
fn_name_of = (d: Decl) string_view {
    d.match ({
        .DFunc(f) => f.name,
        _         => "",
    })
}
fn_pos_of = (d: Decl) i32 {
    d.match ({
        .DFunc(f) => f.pos,
        _         => 0,
    })
}
fn_dup_before = (decls: [Decl], name: string_view, upto: i64) bool {
    f := false
    decls.loop((h, i, d) {
        f = (i < upto).match ({
            true  => eq(d.fn_name_of(), name).match ({ true => true, false => f }),
            false => f,
        })
    })
    f
}
// Compatibility verdict API: 0 = clean, 1 = rejected. Detailed callers consume `check_module_kind`,
// `check_module_batch`, or a structured diagnostic, so the old parallel count traversal is redundant.
check_module* = (a: MutPtr<Malloc>, decls: [Decl]) i32 { (a.check_module_kind(decls) == 0).match ({
    true  => 0,
    false => 1,
}) }
// ════════════════════════════════════════════════════════════════════════════════════════
// ── DIAGNOSTIC ERROR KINDS (authoritative validation traversal) ─────────────────────────
// Validators return a packed first-error kind and source position. Batch mode uses the same expression
// and statement visitors with a collecting sink; compatibility verdict APIs reduce this result to 0/1.
//
// Kind codes (small fixed set the task names). KNONE=0 means "no error".
KNONE = () i32 { 0 }
KARITY = () i32 { 1 }    // a call's arg COUNT ≠ the declared parameter count
KARGTYPE = () i32 { 2 }    // an arg's type doesn't fit its parameter
KUNDEFINED = () i32 { 3 }    // a call to a non-local, non-intrinsic, non-imported, non-trait name
KSTRUCTFIELD = () i32 { 4 }    // a struct-literal init field / a member access that names no real field
KEXHAUST = () i32 { 5 }    // a non-wildcard enum match misses a variant
KDUPVARIANT = () i32 { 6 }    // a match arm repeats a variant
KOPERAND = () i32 { 7 }    // an arith/logic operator on the wrong operand category
KINDEX = () i32 { 8 }    // seq[idx] with a non-slice seq or a non-numeric idx
KRETURNFIT = () i32 { 9 }    // a returned / trailing value doesn't fit the declared return type
KASSIGNFIT = () i32 { 10 }    // x = v where v doesn't fit x's let-inferred type (incl. xs[i]=v)
KCONFORMANCE = () i32 { 11 }    // a Type.impl(Trait) misses a method or its signature differs
KDUPFN = () i32 { 12 }    // two top-level fns share a name (Zen has no overloading)
KVALPOSRETURN = () i32 { 13 }    // an early (dropped) return in a value-position block arm
KPARSE = () i32 { 14 }    // unparseable top-level input (the parser's __syntax_error sentinel)
KOWNERSHIP = () i32 { 15 }    // use of a local owner after it was consumed (release/drop, send, move into an owner param, or a bare `c := o` copy)
KTRAITBOUND = () i32 { 16 }    // a type bound to `A: Trait` at a call site does not impl Trait
KUNKNOWNTYPE = () i32 { 17 }    // a type annotation names a type that is not declared/imported/a tparam
KLAMBDAVALUE = () i32 { 18 }    // a lambda used as a value the inliner can't splice (stored/returned)
KMUSTUSE = () i32 { 19 }    // a value-mold `(Self,…) Self` self-mutation whose result is discarded
KNEEDANNOT = () i32 { 20 }    // an unannotated let whose inferred type leaves a tparam uninferred (-> T=void)
KPTRWRITE = () i32 { 21 }    // a write or writable-view construction through read-only `Ptr<T>`
KINFINITETYPE = () i32 { 22 }    // a struct/enum that contains ITSELF by value (transitively) — infinite size
KNULLDEREF = () i32 { 23 }    // a load/store/offset through a nullable `RawPtr<T>` (T != u8) not proven non-null
KNOTCALLABLE = () i32 { 24 }    // a call whose target name IS defined but holds a non-function value (a scalar/struct), so it cannot be called
KFALLTHROUGH = () i32 { 25 }    // a non-void function body that ends in a no-value statement (let/assign/loop) — no produced value
KVBREAK = () i32 { 29 }    // a top-level parse failure at a newline+`.Uppercase` statement break (the split-statement shape)
KMAINPARAMS = () i32 { 30 }    // `main` declared with parameters — the OS entry calls zen_main() with none, so they'd read garbage
KARMVOID = () i32 { 31 }    // a value-consumed match/cond arm that yields no value and does not diverge
KBADBIND = () i32 { 32 }    // a top-level `name = <expr>` binding that is neither a module alias (ident RHS) nor a function (`(` RHS) — a value global must use `:=` (the parser's __bad_binding sentinel)
KMETHODNOTFOUND = () i32 { 38 }    // an undefined CALL whose first argument is a concrete struct/enum receiver: reads as `recv.method()` UFCS with no such method (and no free function of that name) — distinct from a bare undefined name
KBOOLARM = () i32 { 39 }    // a bool `.match` omits true/false (or `_`); use an explicit arm or `.then` for a one-way effect
KNOIF = () i32 { 40 }    // source contains the forbidden `if` token; Zen uses bool `.match` for conditional control flow
// Codes 33-36 belong to the CUSTOM diagnostic channels (KESCAPE / KSCRATCHSEND / KSCRATCHSTATE /
// KRESERVEDNAME) that build their own CheckDiagnostic with a hand-written kind/message/hint and
// never route through the diag_info() ladder. They still occupy globally-unique numbers in the
// 6-bit (0-63) code space so `code` alone identifies a kind — see diag_info below. (Private-name
// has NO code: std.internal.resolve renders `error[private-name]` directly at load time.)
SourceSpan*: {
    start: i32,
    width: i32,
}
Diagnostic*: {
    code: i32,
    kind: string_view,
    span: SourceSpan,
    count: i32,
    message: string_view,
    hint: string_view,
}
CheckDiagnostic*: {
    code: i32,
    kind: string_view,
    source_offset: i32,
    span_width: i32,
    count: i32,
    message: string_view,
    hint: string_view,
}
source_span* = (start: i32, width: i32) SourceSpan {
    SourceSpan(
        start: start,
        width: width,
    )
}
source_span_none* = () SourceSpan { source_span(0, 0) }
diagnostic_none* = () Diagnostic {
    Diagnostic(
        code: 0,
        kind: "ok",
        span: source_span_none(),
        count: 0,
        message: "",
        hint: "",
    )
}
check_diagnostic_none* = () CheckDiagnostic {
    CheckDiagnostic(
        code: 0,
        kind: "ok",
        source_offset: 0 - 1,
        span_width: 0,
        count: 0,
        message: "",
        hint: "",
    )
}
// Zen deliberately has no source-level `if`, including contextual match-arm guards. Scan the lexical
// token stream (rather than raw bytes) so comments, string literals, `gift`, and other containing names
// remain ordinary source. The first exact identifier token wins and anchors error[no-if] on its two
// bytes. Internal Stmt.If nodes are compiler-owned lowering and never pass through this source scan.
is_if_token = (src: string_view, t: Token) bool {
    t.kind.match ({
        .Ident => t.len == 2 && src.at(t.start) == 'i' && src.at(t.start + 1) == 'f',
        _      => false,
    })
}
first_if_offset = (src: string_view) i32 {
    pos := 0
    found := 0 - 1
    done := false
    @while (done.match ({ true => false, false => true })) {
        sc := src.scan(pos)
        sc.tok.kind.match ({
            .Eof => {
                done = true
            },
            _    => src.is_if_token(sc.tok).match ({
                true  => {
                    found = sc.tok.start
                    done = true
                },
                false => {
                    pos = sc.next
                },
            }),
        })
    }
    found
}
check_module_no_if_diagnostic_from_source* = (src: string_view) CheckDiagnostic {
    pos := src.first_if_offset()
    (pos < 0).match ({
        true  => check_diagnostic_none(),
        false => CheckDiagnostic(
            code: KNOIF(),
            kind: "no-if",
            source_offset: pos,
            span_width: 2,
            count: 1,
            message: "`if` is not part of Zen; conditional control flow uses `.match`",
            hint: "replace `if (cond) { yes } else { no }` with `cond.match ({ true => yes, false => no })`; inside an enum arm, nest a boolean `.match` in the arm body",
        ),
    })
}
positive_count = (n: i32) i32 { (n < 1).match ({ true => 1, false => n }) }
diagnostic_width_from = (src: string_view, pos: i32, n: i32) i32 {
    k := n
    @while (src.at(pos + k).is_alnum()) {
        k = k + 1
    }
    k
}    // iterative — a long identifier/number literal must not recurse per byte to size its caret
// a string literal carets across its quotes (`"hi"` -> `^~~~`), not just the opening `"`.
diagnostic_strlit_width = (src: string_view, pos: i32, n: i32) i32 {
    k := n
    r := 0 - 1
    @while (r < 0) {
        b := src.at(pos + k)    // caret width once the closing `"` / line end is reached; <0 while still scanning
        (b == 0 || b == '\n').match ({
            true  => {
                r = k
            },
            false => (b == '"').match ({
                true  => {
                    r = k + 1
                },
                false => {
                    k = k + 1
                },
            }),
        })
    }
    r
}    // iterative — a ~50KB string literal must not recurse per byte to size its caret
diagnostic_span_width = (src: string_view, pos: i32) i32 {
    (pos <= 0).match ({
        true  => 1,
        false => (src.at(pos) == '"').match ({
            true  => src.diagnostic_strlit_width(pos, 1),
            false => {
                n := src.diagnostic_width_from(pos, 0)
                (n < 1).match ({ true => 1, false => n })
            },
        }),
    })
}
// ── ONE diagnostic table ──────────────────────────────────────────────────────────────────────
// Every packed-channel diagnostic's (kind, message, hint) lives in a SINGLE `diag_info` ladder keyed
// by `code`; the three accessors below just project one field. This is the sole source of truth for
// the ladder-rendered kinds — no more three parallel 32-branch ladders drifting out of sync. (The
// custom channels — scope-escape/escape/scratch-escape/reserved-name, codes 33-36 — build their own
// struct and are deliberately NOT in this table; their messages interpolate a runtime subject.)
DiagInfo: {
    kind: string_view,
    message: string_view,
    hint: string_view,
}
diag_info = (code: i32) DiagInfo {
    (code == 1).match ({
        true  => DiagInfo(
            kind: "arity",
            message: "wrong number of arguments",
            hint: "check the callee signature and pass exactly the declared parameters",
        ),
        false => (code == 2).match ({
            true  => DiagInfo(
                kind: "arg-type",
                message: "argument type does not fit the parameter",
                hint: "check the argument type or add an explicit conversion at the call site",
            ),
            false => (code == 3).match ({
                true  => DiagInfo(
                    kind: "undefined-name",
                    message: "undefined name",
                    hint: "declare the name, import it, or qualify the intended module binding",
                ),
                false => (code == 4).match ({
                    true  => DiagInfo(
                        kind: "struct-field",
                        message: "unknown struct field or invalid field access",
                        hint: "check the struct literal or field access against the declared fields",
                    ),
                    false => (code == 5).match ({
                        true  => DiagInfo(
                            kind: "exhaustiveness",
                            message: "match does not cover every variant",
                            hint: "add arms for every variant, or add an explicit `_` arm",
                        ),
                        false => (code == 6).match ({
                            true  => DiagInfo(
                                kind: "dup-variant",
                                message: "duplicate match arm variant",
                                hint: "remove the repeated match arm for this variant",
                            ),
                            false => (code == 7).match ({
                                true  => DiagInfo(
                                    kind: "operand-type",
                                    message: "operator cannot be applied to these operand types",
                                    hint: "use an operator supported by both operand types",
                                ),
                                false => (code == 8).match ({
                                    true  => DiagInfo(
                                        kind: "index",
                                        message: "invalid index operation",
                                        hint: "index only slice-like values with an integer index",
                                    ),
                                    false => (code == 9).match ({
                                        true  => DiagInfo(
                                            kind: "return-fit",
                                            message: "returned value does not fit the declared return type",
                                            hint: "make the returned value fit the function's declared return type",
                                        ),
                                        false => (code == 10).match ({
                                            true  => DiagInfo(
                                                kind: "assign-fit",
                                                message: "assigned value does not fit the variable's type",
                                                hint: "make the assigned value fit the target's type",
                                            ),
                                            false => (code == 11).match ({
                                                true  => DiagInfo(
                                                    kind: "conformance",
                                                    message: "impl does not satisfy the trait",
                                                    hint: "define every required trait method with the exact receiver, parameter, and return types",
                                                ),
                                                false => (code == 12).match ({
                                                    true  => DiagInfo(
                                                        kind: "dup-fn",
                                                        message: "duplicate top-level definition",
                                                        hint: "rename one definition or move it behind a real module namespace",
                                                    ),
                                                    false => (code == 13).match ({
                                                        true  => DiagInfo(
                                                            kind: "value-pos-return",
                                                            message: "early `return` in a value-position match arm",
                                                            hint: "return a value from the arm instead of using early `return` in value position",
                                                        ),
                                                        false => (code == 14).match ({
                                                            true  => DiagInfo(
                                                                kind: "parse",
                                                                message: "syntax error: unparseable top-level input",
                                                                hint: "check the syntax around this top-level declaration",
                                                            ),
                                                            false => (code == 15).match ({
                                                                true  => DiagInfo(
                                                                    kind: "ownership",
                                                                    message: "use of an owner after it was consumed (moved, released, or dropped)",
                                                                    hint: "an owner is consumed by release/drop, an actor send, a move into an owner-typed parameter, or a bare `c := o` copy; bind a fresh owner (`o.clone()`) instead of reusing the consumed local",
                                                                ),
                                                                false => (code == 16).match ({
                                                                    true  => DiagInfo(
                                                                        kind: "trait-bound",
                                                                        message: "type argument does not satisfy the trait bound",
                                                                        hint: "implement the bound trait for this type (`Type.impl(Trait, { … })`), or relax the bound",
                                                                    ),
                                                                    false => (code == 17).match ({
                                                                        true  => DiagInfo(
                                                                            kind: "unknown-type",
                                                                            message: "unknown type name",
                                                                            hint: "declare the type, import it, or qualify it with its module (e.g. `mod.Type`)",
                                                                        ),
                                                                        false => (code == 18).match ({
                                                                            true  => DiagInfo(
                                                                                kind: "lambda-value",
                                                                                message: "a lambda can only be used directly as a call argument",
                                                                                hint: "pass the lambda directly to its consumer, or bind a named top-level function instead (no first-class lambda values yet)",
                                                                            ),
                                                                            false => (code == 19).match ({
                                                                                true  => DiagInfo(
                                                                                    kind: "must-use",
                                                                                    message: "result of a self-mutating container method is discarded; the receiver is invalid after this call",
                                                                                    hint: "rebind the returned container (e.g. `m = m.put(...)`); a value-mold method may realloc and returns the updated handle",
                                                                                ),
                                                                                false => (code == 20).match ({
                                                                                    true  => DiagInfo(
                                                                                        kind: "need-annotation",
                                                                                        message: "cannot infer the type parameter of this binding",
                                                                                        hint: "annotate the binding so its type parameter is pinned, e.g. `m: Map<i32> := …`",
                                                                                    ),
                                                                                    false => (code == 21).match ({
                                                                                        true  => DiagInfo(
                                                                                            kind: "ptr-write",
                                                                                            message: "cannot write through a read-only `Ptr<T>`",
                                                                                            hint: "give the pointer parameter/field the `MutPtr<T>` kind to permit writes through it",
                                                                                        ),
                                                                                        false => (code == 22).match ({
                                                                                            true  => DiagInfo(
                                                                                                kind: "infinite-type",
                                                                                                message: "type contains itself by value, so it has infinite size",
                                                                                                hint: "break the cycle with indirection: store a `Ptr<T>` (or `[T]`) instead of the type by value",
                                                                                            ),
                                                                                            false => (code == 23).match ({
                                                                                                true  => DiagInfo(
                                                                                                    kind: "null-deref",
                                                                                                    message: "`RawPtr<T>` may be null; deref requires a null-check first",
                                                                                                    hint: "guard with `q := assert_nonnull(p)` (panics on null, yields `MutPtr<T>`) then deref `q`, or null-check before deref",
                                                                                                ),
                                                                                                false => (code == 24).match ({
                                                                                                    true  => DiagInfo(
                                                                                                        kind: "not-callable",
                                                                                                        message: "value is not a function",
                                                                                                        hint: "call a function, or store a function value in this name before calling it",
                                                                                                    ),
                                                                                                    false => (code == 25).match ({
                                                                                                        true  => DiagInfo(
                                                                                                            kind: "return-fit",
                                                                                                            message: "function body falls through with no value; add a trailing expression of the declared return type",
                                                                                                            hint: "",
                                                                                                        ),
                                                                                                        false => (code == 26).match ({
                                                                                                            true  => DiagInfo(
                                                                                                                kind: "no-type-args",
                                                                                                                message: "this function takes no type arguments",
                                                                                                                hint: "remove the `<…>` type arguments, or call a generic function",
                                                                                                            ),
                                                                                                            false => (code == 27).match ({
                                                                                                                true  => DiagInfo(
                                                                                                                    kind: "or-return",
                                                                                                                    message: "`.or_return()` requires the enclosing function to return a `Result` carrying the receiver's error type",
                                                                                                                    hint: "declare the enclosing function's return type as `Result<_, E>` with the receiver's error type `E`; in a conditionally-evaluated position (`&&`/`||` rhs, branch value, while-loop condition) the receiver's WHOLE `Result<T, E>` must match — bind it on its own line first (`x := recv.or_return()`), or handle the `Result` with `.match`",
                                                                                                                ),
                                                                                                                false => (code == 28).match ({
                                                                                                                    true  => DiagInfo(
                                                                                                                        kind: "recursive-hof",
                                                                                                                        message: "recursive function with a function-typed parameter — its body is inlined per call site, so the recursive call has no emitted function to land on",
                                                                                                                        hint: "rewrite the recursion as an iteration (`.loop`), or move the function-typed parameter out of the recursive function",
                                                                                                                    ),
                                                                                                                    false => (code == 29).match ({
                                                                                                                        true  => DiagInfo(
                                                                                                                            kind: "parse",
                                                                                                                            message: "syntax error: a newline before `.Variant` starts a new statement",
                                                                                                                            hint: "keep the qualified constructor's `.` on the same line as its type (`Type.Variant(…)`)",
                                                                                                                        ),
                                                                                                                        false => (code == 30).match ({
                                                                                                                            true  => DiagInfo(
                                                                                                                                kind: "main-signature",
                                                                                                                                message: "`main` must be `() i32` or `(sys: Sys) i32` — any other parameter shape would read garbage (the OS entry passes at most the `Sys` capability)",
                                                                                                                                hint: "declare it `main = () i32 { … }`, or take the root capability `main = (sys: Sys) i32 { … }` (import `{ Sys } = std.sys`) and thread narrow caps like `sys.stdout()` / `sys.heap()`",
                                                                                                                            ),
                                                                                                                            false => (code == 31).match ({
                                                                                                                                true  => DiagInfo(
                                                                                                                                    kind: "arm-value",
                                                                                                                                    message: "match arm yields no value, but the match result is used as a value",
                                                                                                                                    hint: "end every arm with an expression of the match's result type (or a diverging `return`); or stop consuming the match as a value and assign within each arm",
                                                                                                                                ),
                                                                                                                                false => (code == 32).match ({
                                                                                                                                    true  => DiagInfo(
                                                                                                                                        kind: "bad-binding",
                                                                                                                                        message: "top-level `=` binding is neither a module alias nor a function",
                                                                                                                                        hint: "use `:=` for a value global (`k := 5`); a single `=` at top level is only a module alias (`m = std.mod`) or a function (`f = () T { … }`)",
                                                                                                                                    ),
                                                                                                                                    false => (code == 38).match ({
                                                                                                                                        true  => DiagInfo(
                                                                                                                                            kind: "method-not-found",
                                                                                                                                            message: "no method with this name on the receiver type",
                                                                                                                                            hint: "define the method (a top-level `fn` whose first parameter is the receiver, called `recv.method(...)`), or check the method name",
                                                                                                                                        ),
                                                                                                                                        false => (code == 39).match ({
                                                                                                                                            true  => DiagInfo(
                                                                                                                                                kind: "exhaustiveness",
                                                                                                                                                message: "boolean match does not handle both outcomes",
                                                                                                                                                hint: "add the missing `true`, `false`, or `_` arm; for an intentional one-way effect, use `condition.then({ ... })`",
                                                                                                                                            ),
                                                                                                                                            false => DiagInfo(
                                                                                                                                                kind: "type",
                                                                                                                                                message: "type error",
                                                                                                                                                hint: "",
                                                                                                                                            ),
                                                                                                                                        }),
                                                                                                                                    }),
                                                                                                                                }),
                                                                                                                            }),
                                                                                                                        }),
                                                                                                                    }),
                                                                                                                }),
                                                                                                            }),
                                                                                                        }),
                                                                                                    }),
                                                                                                }),
                                                                                            }),
                                                                                        }),
                                                                                    }),
                                                                                }),
                                                                            }),
                                                                        }),
                                                                    }),
                                                                }),
                                                            }),
                                                        }),
                                                    }),
                                                }),
                                            }),
                                        }),
                                    }),
                                }),
                            }),
                        }),
                    }),
                }),
            }),
        }),
    })
}
diagnostic_kind_name = (code: i32) string_view { code.diag_info().kind }
diagnostic_message = (code: i32) string_view { code.diag_info().message }
diagnostic_hint = (code: i32) string_view { code.diag_info().hint }
check_diagnostic_from_packed* = (packed: i32, count: i32) CheckDiagnostic {
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => {
            code := packed & 63
            has_pos := packed > 63
            CheckDiagnostic(
                code: code,
                kind: code.diagnostic_kind_name(),
                source_offset: has_pos.match ({ true => packed >> 6, false => 0 - 1 }),
                span_width: has_pos.match ({ true => 1, false => 0 }),
                count: count.positive_count(),
                message: code.diagnostic_message(),
                hint: code.diagnostic_hint(),
            )
        },
    })
}
check_diagnostic_from_source* = (src: string_view, packed: i32, count: i32) CheckDiagnostic {
    d := check_diagnostic_from_packed(packed, count)
    (d.code == 0).match ({
        true  => d,
        false => CheckDiagnostic(
            code: d.code,
            kind: d.kind,
            source_offset: d.source_offset,
            span_width: (d.source_offset < 0).match ({
                true  => 0,
                false => src.diagnostic_span_width(d.source_offset),
            }),
            count: d.count,
            message: d.message,
            hint: d.hint,
        ),
    })
}
check_to_diagnostic* = (d: CheckDiagnostic) Diagnostic {
    Diagnostic(
        code: d.code,
        kind: d.kind,
        span: source_span(d.source_offset, d.span_width),
        count: d.count,
        message: d.message,
        hint: d.hint,
    )
}
diagnostic_to_check* = (d: Diagnostic) CheckDiagnostic {
    CheckDiagnostic(
        code: d.code,
        kind: d.kind,
        source_offset: d.span.start,
        span_width: d.span.width,
        count: d.count,
        message: d.message,
        hint: d.hint,
    )
}
diagnostic_from_packed* = (packed: i32, count: i32) Diagnostic { check_diagnostic_from_packed(packed, count).check_to_diagnostic() }
diagnostic_from_source* = (src: string_view, packed: i32, count: i32) Diagnostic { src.check_diagnostic_from_source(packed, count).check_to_diagnostic() }
// first-nonzero combinator: the kind of the FIRST error in traversal order.
kv_kor = (a: i32, b: i32) i32 { (a == 0).match ({ true => b, false => a }) }
// a 0/1 count predicate → a kind code: emit `k` iff the predicate found an error.
kv_one = (n: i32, k: i32) i32 { (n == 0).match ({ true => 0, false => k }) }
// pack a SOURCE POSITION into a kind code: kinds are 1..63 (6 bits), so `kind + pos*64` carries the
// error's byte offset alongside it (pos 0 = unknown/synthesized — the bare kind, the old encoding).
// Consumers unpack with `& 63` / `>> 6`. Applied only at leaves that HAVE a pos (Call/Var); an
// already-packed nested result is never re-packed: values above 63 already carry an offset.
// Capacity: i32 packing caps the flat-source byte offset at (2^31-1)/64 ≈ 33.5 MB; the whole
// in-tree Zen source is < 1 MB today, so headroom is ~38x before i64 packing would be needed.
kv_at = (k: i32, p: i32) i32 { (k == 0 || k > 63 || p <= 0).match ({
    true  => k,
    false => k + p * 64,
}) }
expr_pos = (e: Expr) i32 {
    e.match ({
        .Var(v)         => v.pos,
        .Call(c)        => c.pos,
        .Member(m)      => load(m.obj).expr_pos().pos_or(m.pos),
        .Arrow(ar)      => load(ar.obj).expr_pos().pos_or(ar.pos),
        .Index(ix)      => load(ix.seq).expr_pos(),
        .Bin(b)         => b.pos.pos_or(load(b.lhs).expr_pos()),
        .Cond(d)        => load(d.c).expr_pos(),
        .Match(m)       => load(m.subj).expr_pos(),
        .MakeEnum(mk)   => load(mk.payload).expr_pos(),
        .StrLit(s)      => s.pos,
        .MakeStruct(sd) => sd.pos.pos_or((sd.inits.len == 0).match ({
            true  => 0,
            false => load(sd.inits[0].value).expr_pos(),
        })),
        .SliceLit(sd)   => (sd.items.len == 0).match ({
            true  => 0,
            false => sd.items[0].expr_pos(),
        }),
        .Block(b)       => (b.stmts.len == 0).match ({ true => 0, false => b.stmts[0].stmt_pos() }),
        .Loop(l)        => load(l.seq).expr_pos(),
        _               => 0,
    })
}
stmt_pos = (st: Stmt) i32 {
    st.match ({
        .Let(l)      => l.pos.pos_or(load(l.value).expr_pos()),
        .Assign(x)   => x.pos.pos_or(load(x.target).expr_pos()),
        .Return(r)   => load(r).expr_pos(),
        .ExprStmt(e) => load(e).expr_pos(),
        .If(f)       => load(f.c).expr_pos(),
        .While(w)    => load(w.c).expr_pos(),
        .IndexSet(x) => x.pos.pos_or(load(x.seq).expr_pos()),
    })
}
body_pos = (body: [Stmt]) i32 { (body.len == 0).match ({ true => 0, false => body[0].stmt_pos() }) }
// Ownership kind pass mirrors the raw ownership count pass above.
kv_own_args_kind = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, args: [Expr]) i32 {
    acc := 0
    args.loop((h, i, ar) {
        acc = acc.kv_kor(a.kv_own_expr_kind(env, seen, al, ar.addr()))
    })
    acc
}
kv_own_inits_kind = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, inits: [FieldInit]) i32 {
    acc := 0
    inits.loop((h, i, fi) {
        acc = acc.kv_kor(a.kv_own_expr_kind(env, seen, al, fi.value))
    })
    acc
}
kv_own_arms_kind = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, subjty: Ty, arms: [ArmData]) i32 {
    acc := 0
    arms.loop((h, i, ar) {
        acc = acc.kv_kor(a.kv_own_expr_kind(a.arm_env(env, subjty, ar), seen, al, ar.body))
    })
    acc
}
// the DOUBLE-MOVE (re-census #63) in the kind pass: the same owner moved into two Own fields of one
// struct literal reports KOWNERSHIP at the second-moved value's position (mirrors own_struct_dupmove_err).
kv_own_struct_dupmove_kind = (a: MutPtr<Malloc>, env: Env, s: MakeStructData) i32 {
    acc := 0
    env.env_is_struct(s.ty).then({
        fields := env.env_struct_fields(s.ty)
        d := a.dead_nil()
        s.inits.loop((h, i, fi) {
            nm := env.struct_field_move_src(fields, fi)
            (nm.is_empty() == false).then({
                acc = acc.kv_kor(d.dead_has(nm).match ({
                    true  => KOWNERSHIP().kv_at(load(fi.value).expr_pos()),
                    false => 0,
                }))
                d = a.dead_cons(nm, d)
            })
        })
    })
    acc
}
kv_own_slice_dupmove_kind = (a: MutPtr<Malloc>, env: Env, items: [Expr]) i32 {
    acc := 0
    d := a.dead_nil()
    items.loop((h, i, it) {
        nm := env.own_moved_var(it.addr())
        (nm.is_empty() == false).then({
            acc = acc.kv_kor(d.dead_has(nm).match ({
                true  => KOWNERSHIP().kv_at(it.expr_pos()),
                false => 0,
            }))
            d = a.dead_cons(nm, d)
        })
    })
    acc
}
kv_own_expr_kind = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, e: Ptr<Expr>) i32 {
    load(e).match ({
        .Var(v)        => seen.dead_has(v.name).match ({
            true  => KOWNERSHIP().kv_at(v.pos),
            false => 0,
        }),
        .Call(c)       => a.kv_own_args_kind(env, seen, al, c.args).kv_kor(env.is_default_owner_method(c).match ({
            true  => KOWNERSHIP().kv_at(c.pos),
            false => 0,
        })),
        .Index(ix)     => a.kv_own_expr_kind(env, seen, al, ix.seq).kv_kor(a.kv_own_expr_kind(env, seen, al, ix.idx)),
        .Bin(b)        => a.kv_own_expr_kind(env, seen, al, b.lhs).kv_kor(a.kv_own_expr_kind(env, seen, al, b.rhs)),
        .Cond(d)       => a.kv_own_expr_kind(env, seen, al, d.c).kv_kor(a.kv_own_expr_kind(env, seen, al, d.t)).kv_kor(a.kv_own_expr_kind(env, seen, al, d.e)),
        .Member(m)     => a.kv_own_expr_kind(env, seen, al, m.obj),
        .Arrow(ar)     => a.kv_own_expr_kind(env, seen, al, ar.obj),
        .Match(m)      => a.kv_own_expr_kind(env, seen, al, m.subj).kv_kor(a.kv_own_arms_kind(env, seen, al, env.infer_expr(m.subj), m.arms)),
        .MakeEnum(mk)  => a.kv_own_expr_kind(env, seen, al, mk.payload),
        .MakeStruct(s) => a.kv_own_inits_kind(env, seen, al, s.inits).kv_kor(a.kv_own_struct_dupmove_kind(env, s)),
        .SliceLit(sd)  => a.kv_own_args_kind(env, seen, al, sd.items).kv_kor(a.kv_own_slice_dupmove_kind(env, sd.items)),
        .Loop(l)       => a.kv_own_expr_kind(env, seen, al, l.seq).kv_kor(a.kv_own_body_kind(env, seen, al, l.body)).kv_kor(a.loop_outer_frees(env, seen, al, l).kv_one(KOWNERSHIP()).kv_at(load(l.seq).expr_pos().pos_or(body_pos(l.body)))),
        .Block(b)      => a.kv_own_body_kind(env, seen, al, b.stmts),
        _              => 0,
    })
}
kv_own_stmt_kind = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, st: Stmt) i32 {
    st.match ({
        .Let(l)      => a.kv_own_expr_kind(env, seen, al, l.value),
        .Assign(x)   => a.kv_own_assign_target_kind(env, seen, al, x.target).kv_kor(a.kv_own_expr_kind(env, seen, al, x.value)),
        .Return(r)   => a.kv_own_expr_kind(env, seen, al, r),
        .ExprStmt(e) => a.kv_own_expr_kind(env, seen, al, e),
        .If(f)       => a.kv_own_expr_kind(env, seen, al, f.c).kv_kor(a.kv_own_body_kind(env, seen, al, f.then)).kv_kor(a.kv_own_body_kind(env, seen, al, f.els)),
        .While(w)    => a.kv_own_expr_kind(env, seen, al, w.c).kv_kor(a.kv_own_body_kind(env, seen, al, w.body)).kv_kor(a.loop_body_outer_frees(env, seen, al, w.body, a.dead_nil()).kv_one(KOWNERSHIP()).kv_at(load(w.c).expr_pos().pos_or(body_pos(w.body)))),
        .IndexSet(x) => a.kv_own_expr_kind(env, seen, al, x.seq).kv_kor(a.kv_own_expr_kind(env, seen, al, x.idx)).kv_kor(a.kv_own_expr_kind(env, seen, al, x.value)),
    })
}
kv_own_body_kind = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, body: [Stmt]) i32 {
    acc := 0
    e := env
    d := seen
    al2 := al
    body.loop((h, i, st) {
        acc = acc.kv_kor(a.kv_own_stmt_kind(e, d, al2, st))
        d = a.own_step(e, d, al2, st)
        al2 = a.alias_step(e, al2, st)
        e = a.extend_env(e, st)
    })
    acc
}
kv_own_check_func_kind = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, f: Func) i32 {
    env := Env(
        vars: a.params_env(f.params),
        decls: decls,
        didx: idx,
        exp: f.ret,
        a: a,
    )
    a.kv_own_body_kind(env, a.dead_nil(), a.alias_nil(), f.body)
}
check_module_ownership_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    acc := 0
    idx := a.build_decl_index(decls)
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DFunc(f) => a.kv_own_check_func_kind(decls, idx, f),
            _         => 0,
        }))
    })
    acc
}
// ── a CALL: authoritative arity, argument-type, and undefined-name classification.
// arg-type position: which arg first fails to fit (so a bad arg reports KARGTYPE not a blanket code).
kv_arg_type_kind = (env: Env, tps: [Param], params: [Param], args: [Expr]) i32 {
    acc := 0
    args.loop((h, i, ar) {
        acc = acc.kv_kor(env.arg_err_at(tps, params, i, ar).kv_one(KARGTYPE()).kv_at(ar.expr_pos()))
    })
    acc
}
// a known local fn: wrong arity → KARITY; right arity but a mistyped CONCRETE arg → KARGTYPE. Slots
// typed by the callee's own tparams are skipped until monomorphization.
// (Trait-BOUND violations are caught by the separate pre-inline bound pass, since local generic calls
// are inlined away before this resolved-decls pass runs.)
kv_call_errs_kind = (env: Env, c: CallData) i32 {
    f := env.env_func(c.fn)
    ps := env.env_params(c.fn)
    (ps.len == c.args.len).match ({
        true  => f.is_imported_generic().match ({
            true  => 0,
            false => env.kv_arg_type_kind(f.tparams, ps, c.args),
        }),
        false => KARITY(),
    })
}
// an undefined call reads as a `recv.method()` UFCS call — not a bare undefined name — when it has a
// first argument whose inferred type is a DECLARED struct/enum (a genuine concrete receiver). A
// numeric/str/unknown first arg or a zero-arg call stays a plain undefined name. An AMBIGUOUS UFCS
// call (2+ `alias__fn` candidates match the receiver) keeps the plain-undefined channel so its more
// specific `ambiguous method` enrichment still fires — this is a NO-method case only.
undef_is_method = (env: Env, c: CallData) bool {
    (c.args.len == 0).match ({
        true  => false,
        false => {
            rty := env.infer_expr(c.args[0].addr())
            tn := rty.recv_name()
            (is_empty(tn) || env.env_is_struct(tn) == false && env.env_is_enum(tn) == false).match ({
                true  => false,
                false => env.alias_ufcs_candidates(c.fn, rty).count < 2,
            })
        },
    })
}
// RECEIVER-TYPED UFCS DISPATCH (#68 slice 4). A method name like `find` is a flat free fn (`str.find`)
// AND an impl method (`Vec.find`, `Set.find`, …) — one entry in the flat namespace. `xs.find(2)` on a
// `[i32]` desugars to `find(xs, 2)`; dispatch found NO impl/alias whose FIRST parameter fits `[i32]`, so
// c.fn stayed the flat `find`. The batch then judges the args against `str.find`'s `(str, str)` and yields
// a misleading `expected str, got [i32]` — binding to the wrong receiver type by NAME ALONE. When the
// called name is ALSO an impl/trait method (so UFCS legitimately dispatches by receiver) and the receiver
// (arg 0) does NOT fit the flat fn's concrete first parameter, the flat signature is not the authoritative
// yardstick (mirrors ka_call_core's `authoritative` gate): this is method-not-found for THIS receiver, not
// an arg mismatch. Report the clean method-not-found. Fires ONLY on already-erroring calls — a receiver
// that fits param0, an unknown/void receiver, a zero-arg call, or a tparam-typed param0 all short-circuit
// — so no program that checks today changes meaning; a wrong-signature arg error only becomes an accurate
// one. When a receiver-typed impl/alias DOES fit, resolve_call already rewrote c.fn to it and we never get
// here (is_trait_method on the mangled impl name is false), so real dispatch is untouched.
recv_typed_miss = (env: Env, c: CallData) bool {
    (c.args.len > 0 && env.env_trait_method(c.fn)).match ({
        true  => {
            f := env.env_func(c.fn)
            (f.params.len > 0 && f.tparams.ty_mentions_tparam(f.params[0].ty) == false).match ({
                true  => {
                    rty := env.infer_expr(c.args[0].addr())
                    (env.unknown_ty(rty) || rty.is_void_ty()).match ({
                        true  => false,
                        false => rty.fits(f.params[0].ty) == false,
                    })
                },
                false => false,
            })
        },
        false => false,
    })
}
kv_check_call_kind = (env: Env, c: CallData) i32 {
    c.is_forbidden_raw_call().match ({
        true  => KUNDEFINED(),
        false => env.is_unresolved_trait_call(c).match ({
            true  => 0,
            false => env.shadows_toplevel(c.fn).match ({
                true  => env.var_or_global(c.fn).is_fnt().match ({
                    true  => env.kv_fnval_call_kind(c),
                    false => env.shadow_not_callable(c.fn).match ({
                        true  => KNOTCALLABLE(),
                        false => 0,
                    }),
                }),
                false => env.env_known_fn(c.fn).match ({
                    true  => env.recv_typed_miss(c).match ({
                        true  => KMETHODNOTFOUND(),
                        false => env.kv_call_errs_kind(c),
                    }),
                    false => c.fn.is_intrinsic().match ({
                        true  => (c.args.len == c.fn.intrinsic_arity()).match ({
                            true  => 0,
                            false => KARITY(),
                        }),
                        false => (env.env_imported(c.fn) || env.env_trait_method(c.fn)).match ({
                            true  => env.trait_recv_missing(c).match ({
                                true  => kv_at(KTRAITBOUND(), c.pos),
                                false => 0,
                            }),
                            false => env.var_or_global(c.fn).is_fnt().match ({
                                true  => env.kv_fnval_call_kind(c),
                                false => env.is_bound(c.fn).match ({
                                    true  => KNOTCALLABLE(),
                                    false => (c.args.len > 0 && is_empty(env.decls.trait_declaring(c.fn)) == false).match ({
                                        true  => KTRAITBOUND(),
                                        false => env.undef_is_method(c).match ({
                                            true  => KMETHODNOTFOUND(),
                                            false => KUNDEFINED(),
                                        }),
                                    }),
                                }),
                            }),
                        }),
                    }),
                }),
            }),
        }),
    })
}    // a BOUND-but-non-fn target is not-callable, not undefined; a method some trait DECLARES but NO impl provides is a trait-bound gap on the receiver, not an undefined name; a locally-bound name shadows any same-named top-level (see shadows_toplevel); deferred UFCS trait-method call (see check_call)
kv_fnt_arg_kind = (env: Env, ptys: [Ty], args: [Expr]) i32 {
    acc := 0
    args.loop((h, i, ar) {
        acc = acc.kv_kor(env.fnt_arg_err_at(ptys, i, ar).kv_one(KARGTYPE()).kv_at(ar.expr_pos()))
    })
    acc
}
kv_fnval_call_kind = (env: Env, c: CallData) i32 {
    env.var_or_global(c.fn).match ({
        .FnT(ft) => (ft.params.len == c.args.len).match ({
            true  => env.kv_fnt_arg_kind(ft.params, c.args),
            false => KARITY(),
        }),
        _        => KUNDEFINED(),
    })
}
kv_check_args_kind = (env: Env, args: [Expr]) i32 {
    acc := 0
    args.loop((h, i, ar) {
        acc = acc.kv_kor(env.kv_check_expr_kind(ar.addr()))
    })
    acc
}
kv_check_arms_kind = (env: Env, subjty: Ty, arms: [ArmData]) i32 {
    acc := 0
    arms.loop((h, i, ar) {
        acc = acc.kv_kor(env.a.arm_env(env, subjty, ar).kv_check_expr_kind(ar.body))
    })
    acc
}
kv_arm_result_kind = (env: Env, subjty: Ty, want: Ty, ar: ArmData) i32 { env.arm_result_err(subjty, want, ar).kv_one(KRETURNFIT()).kv_at(load(ar.body).expr_pos()) }
kv_match_arm_result_kind = (env: Env, subjty: Ty, arms: [ArmData]) i32 {
    want := env.match_result_ty(subjty, arms)
    acc := 0
    arms.loop((h, i, ar) {
        acc = acc.kv_kor(env.kv_arm_result_kind(subjty, want, ar))
    })
    acc
}
// the value-consumed void-arm rule, kind-flavoured (mirrors value_void_arm_err exactly; the caret
// lands on the offending ARM, not the whole match).
kv_value_void_arm_kind = (env: Env, want: Ty, e: Ptr<Expr>) i32 {
    (want.is_void_ty() || env.unknown_ty(want)).match ({
        true  => 0,
        false => load(e).match ({
            .Match(m) => {
                acc := 0
                m.arms.loop((h, i, ar) {
                    acc = acc.kv_kor(env.novalue_arm_leaf(ar.body).kv_one(KARMVOID()).kv_at(ar.pos.pos_or(load(ar.body).expr_pos())))
                })
                acc
            },
            .Cond(d)  => env.novalue_arm_leaf(d.t).kv_one(KARMVOID()).kv_at(load(d.t).expr_pos()).kv_kor(env.novalue_arm_leaf(d.e).kv_one(KARMVOID()).kv_at(load(d.e).expr_pos())),
            _         => 0,
        }),
    })
}
kv_arm_return_kind = (arms: [ArmData]) i32 {
    acc := 0
    arms.loop((h, i, ar) {
        acc = acc.kv_kor(ar.body.expr_drops_return().kv_one(KVALPOSRETURN()))
    })
    acc
}
// struct-literal init fields: an unknown field OR a mistyped value is KSTRUCTFIELD.
kv_check_inits_kind = (env: Env, inits: [FieldInit]) i32 {
    acc := 0
    inits.loop((h, i, fi) {
        acc = acc.kv_kor(env.kv_check_expr_kind(fi.value))
    })
    acc
}
// struct-literal init: caret on the first init value's source position when it's positioned
// (a Var/Call/StrLit survives resolve; bare numeric literals carry none — best-effort, else file-only).
kv_makestruct_kind = (env: Env, m: MakeStructData) i32 {
    env.makestruct_err(m).kv_one(KSTRUCTFIELD()).kv_at(m.pos.pos_or((m.inits.len == 0).match ({
        true  => 0,
        false => load(m.inits[0].value).expr_pos(),
    })))
}
// member access caret on the receiver object (a Var/Call survives resolve).
kv_nullable_obj_kind = (env: Env, obj: Ptr<Expr>, pos: i32) i32 {
    env.infer_expr(obj).is_nullable_ptr_ty().match ({
        true  => KNULLDEREF().kv_at(pos.pos_or(load(obj).expr_pos())),
        false => 0,
    })
}
kv_member_kind = (env: Env, obj: Ptr<Expr>, field: string_view, pos: i32) i32 { env.kv_nullable_obj_kind(obj, pos).kv_kor(env.member_err(obj, field).kv_one(KSTRUCTFIELD()).kv_at(pos.pos_or(load(obj).expr_pos()))) }
kv_match_null_kind = (env: Env, m: MatchData) i32 {
    env.infer_expr(m.subj).is_nullable_ptr_ty().match ({
        true  => KNULLDEREF().kv_at(load(m.subj).expr_pos()),
        false => 0,
    })
}
// a match: exhaustiveness vs duplicate-variant, split out from match_err. The caret points at the
// matched subject (arms carry no source position); the subject bottoms at a Var, which survives resolve.
arms_first_pos = (arms: [ArmData]) i32 { (arms.len == 0).match ({ true => 0, false => arms[0].pos }) }
kv_match_kind = (env: Env, m: MatchData) i32 {
    // a local-binding subject (`e := …; e.match {…}`) resolves to a Var rebuilt without a source pos
    // (the *_at-ctor pitfall), so fall back to the first arm's pattern pos — the error is always located.
    sp := load(m.subj).expr_pos().pos_or(m.arms.arms_first_pos())
    base := m.arms.has_wildcard().match ({
        true  => m.arms.dup_arm_errs().kv_one(KDUPVARIANT()).kv_at(sp),
        false => env.exhaustive_err(m).kv_one(KEXHAUST()).kv_at(sp).kv_kor(m.arms.dup_arm_errs().kv_one(KDUPVARIANT()).kv_at(sp)),
    })
    base.kv_kor(env.unknown_arm_errs(m).kv_one(KUNDEFINED()).kv_at(sp))
}
kv_index_kind = (env: Env, ix: IndexData) i32 { env.index_err(ix).kv_one(KINDEX()) }
kv_operand_kind = (env: Env, b: BinData) i32 { env.operand_err(b).kv_one(KOPERAND()).kv_at(b.pos.pos_or(load(b.lhs).expr_pos())) }
// ── enriched diagnostic text: name the offending field / operator + the operand types ────────────
// Built lazily by the driver only AFTER a check error is located, so this never affects the compile of
// an accepted program. `denrich_module` walks the resolved decls to the node at the error's byte offset
// (the SAME offset the kind pass reported) and returns a precise message; "" means the offset names no
// enrichable node, so the driver keeps the generic message. The env is threaded exactly as the validator
// threads it (params + lets + arms), so receiver and operand types infer the same way.
zty_generic = (a: MutPtr<Malloc>, g: GenericData) string_view {
    out := a.gstr_string(48).gstr_append(a, g.name).gstr_append(a, "<")
    g.args.loop((h, i, t) {
        (i > 0).then({
            out = out.gstr_append(a, ", ")
        })
        out = out.gstr_append(a, a.zty(t))
    })
    out.gstr_append(a, ">").gstr_finish(a)
}
zty* = (a: MutPtr<Malloc>, t: Ty) string_view {
    t.match ({
        .I32           => "i32",
        .I64           => "i64",
        .U8            => "u8",
        .F64           => "f64",
        .Bool          => "bool",
        .StringView    => "string_view",
        .StringCstr    => "string_cstr",
        .StringLiteral => "string_literal",
        .Void          => "(unknown)",
        .Named(n)      => n,
        .Generic(g)    => a.zty_generic(g),
        .FnT(ft)       => "fn",
        .Slice(e)      => a.gstr_string(24).gstr_append(a, "[").gstr_append(a, a.zty(load(e))).gstr_append(a, "]").gstr_finish(a),
        .Ptr(pd)       => a.gstr_string(24).gstr_append(a, ptr_kw(pd.kind)).gstr_append(a, "<").gstr_append(a, a.zty(load(pd.pointee))).gstr_append(a, ">").gstr_finish(a),
    })
}
desc_or* = (x: string_view, y: string_view) string_view { is_empty(x).match ({
    true  => y,
    false => x,
}) }
// ── fit-mismatch enrichment: name the TWO types the checker already had in hand ────────────────
// `expected `<want>`, got `<got>``, both rendered in USER spelling via zty. Reused by arg-type /
// assign-fit / return-fit so a mismatch says what fits and what was supplied, not just "does not fit".
denrich_fit_msg = (a: MutPtr<Malloc>, want: Ty, got: Ty) string_view { a.gstr_string(48).gstr_append(a, "expected `").gstr_append(a, a.zty(want)).gstr_append(a, "`, got `").gstr_append(a, a.zty(got)).gstr_append(a, "`").gstr_finish(a) }
// The message for a value `v` that must fit `want`, or "" when it actually fits / is a literal-slot
// decision / involves an unknown/fn type (mirrors the *_err detectors' skips so it only speaks up on
// a genuine concrete type-vs-type mismatch — the exact case the generic message was hiding).
denrich_valfit = (env: Env, want: Ty, v: Ptr<Expr>) string_view {
    vt := env.infer_expr(v)
    (env.unknown_ty(want) || env.unknown_ty(vt) || want.is_fnt() || v.lit_slot_verdict(want) >= 0 || fits(vt, want)).match ({
        true  => "",
        false => env.a.denrich_fit_msg(want, vt),
    })
}
// The shape-mismatch message for a tparam-typed POINTER param (mirrors tparam_shape_err): name the
// pointer param vs the (non-pointer / wrong-kind) argument. Empty when the arg is a fitting pointer or
// its type is unknown (deferred), so it only speaks up on the genuine value-where-pointer-wanted case.
denrich_tparam_shape = (env: Env, pty: Ty, v: Ptr<Expr>) string_view {
    pty.is_ptr_ty_g().match ({
        true  => {
            vt := env.infer_expr(v)
            (env.unknown_ty(vt) || gen_ptr_arg_fits(vt, pty)).match ({
                true  => "",
                false => env.a.denrich_fit_msg(pty, vt),
            })
        },
        false => "",
    })
}
// A call arg at `off` whose parameter type is concrete (not a callee tparam) and that the arg does
// not fit: name the parameter type vs the arg's inferred type. tparam-typed slots are skipped just
// as arg_err_at skips them (the checker defers those to monomorphization).
denrich_argfit_msg = (env: Env, c: CallData, off: i32) string_view {
    (env.env_known_fn(c.fn) == false).then({
        return ""
    })
    f := env.env_func(c.fn)
    ps := env.env_params(c.fn)
    (ps.len != c.args.len).then({
        return ""
    })
    res := ""
    c.args.loop((h, i, ar) {
        res = (is_empty(res) && ar.expr_pos() == off && i < ps.len).match ({
            true  => f.tparams.ty_mentions_tparam(ps[i].ty).match ({
                true  => env.denrich_tparam_shape(ps[i].ty, ar.addr()),
                false => env.denrich_valfit(ps[i].ty, ar.addr()),
            }),
            false => res,
        })
    })
    res
}
denrich_fieldlist = (a: MutPtr<Malloc>, fields: [Field]) string_view {
    s := a.gstr_string(64)
    fields.loop((h, i, f) {
        s = (i == 0).match ({
            true  => s.gstr_append(a, f.name),
            false => s.gstr_append(a, ", ").gstr_append(a, f.name),
        })
    })
    s.gstr_finish(a)
}
denrich_member_noty = (a: MutPtr<Malloc>, field: string_view, objty: Ty) string_view { a.gstr_string(64).gstr_append(a, "type `").gstr_append(a, a.zty(objty)).gstr_append(a, "` has no field `").gstr_append(a, field).gstr_append(a, "`").gstr_finish(a) }
// An enum/Result receiver: name the type and steer to `.match` (enums have variants, not fields).
denrich_enum_member_msg = (a: MutPtr<Malloc>, name: string_view, field: string_view) string_view { a.gstr_string(112).gstr_append(a, "enum `").gstr_append(a, name).gstr_append(a, "` has no field `").gstr_append(a, field).gstr_append(a, "` (enums are accessed via `.match`, not `.field`)").gstr_finish(a) }
// A fieldless string receiver (`str`/`Cstr`/`text`): its accessors are UFCS METHODS, so steer to `.field()`.
denrich_str_member_msg = (a: MutPtr<Malloc>, field: string_view, objty: Ty) string_view { a.gstr_string(96).gstr_append(a, "`").gstr_append(a, a.zty(objty)).gstr_append(a, "` has no field `").gstr_append(a, field).gstr_append(a, "` — did you mean `.").gstr_append(a, field).gstr_append(a, "()`?").gstr_finish(a) }
denrich_member_msg = (env: Env, field: string_view, objty: Ty) string_view {
    a := env.a
    objty.match ({
        // a generic-enum instance (`Result<i32,IoError>`) reaches here via its base name.
        .Generic(g)    => env.env_is_gen_enum(g.name).match ({
            true  => a.denrich_enum_member_msg(g.name, field),
            false => a.denrich_member_noty(field, objty),
        }),
        .StringView    => a.denrich_str_member_msg(field, objty),
        .StringCstr    => a.denrich_str_member_msg(field, objty),
        .StringLiteral => a.denrich_str_member_msg(field, objty),
        .Named(n)      => env.env_is_struct(n).match ({
            true  => a.gstr_string(96).gstr_append(a, "struct `").gstr_append(a, n).gstr_append(a, "` has no field `").gstr_append(a, field).gstr_append(a, "` (fields: ").gstr_append(a, a.denrich_fieldlist(env.env_struct_fields(n))).gstr_append(a, ")").gstr_finish(a),
            false => env.env_is_enum(n).match ({
                true  => a.denrich_enum_member_msg(n, field),
                false => a.denrich_member_noty(field, objty),
            }),
        }),
        _              => a.denrich_member_noty(field, objty),
    })
}
// the target name of a not-callable call resolves to a value (a local/global), not a function; name its type.
denrich_notcallable_msg = (env: Env, name: string_view) string_view {
    a := env.a
    a.gstr_string(64).gstr_append(a, "value of type `").gstr_append(a, a.zty(env.var_or_global(name))).gstr_append(a, "` is not a function").gstr_finish(a)
}
// ── trait-bound enrichment ─────────────────────────────────────────────────────────────────────
// the method names an impl of (type `tn`, trait `tr`) provides; empty when no such impl exists.
impl_methods_of = (decls: [Decl], tn: string_view, tr: string_view) [Param] {
    found := empty_params()
    decls.loop((h, i, d) {
        found = d.match ({
            .DImpl(im) => (eq(im.ty, tn) && eq(im.trname, tr)).match ({
                true  => im.methods,
                false => found,
            }),
            _          => found,
        })
    })
    found
}
// the comma-list of methods trait `tr` requires that (tn, tr) does not provide: every FnT field of
// the trait struct with neither an impl method nor a trait default body covering it.
denrich_missing_list = (a: MutPtr<Malloc>, decls: [Decl], tn: string_view, tr: string_view) string_view {
    provided := decls.impl_methods_of(tn, tr)
    s := a.gstr_string(64)
    n := 0
    decls.struct_fields(tr).loop((h, i, f) {
        miss := f.ty.match ({
            .FnT(fd) => provided.has_method(f.name) == false && decls.trait_has_default(tr, f.name) == false,
            _        => false,
        })
        s = miss.match ({
            true  => (n == 0).match ({
                true  => s.gstr_append(a, f.name),
                false => s.gstr_append(a, ", ").gstr_append(a, f.name),
            }),
            false => s,
        })
        n = miss.match ({ true => n + 1, false => n })
    })
    s.gstr_finish(a)
}
denrich_missing_tail = (a: MutPtr<Malloc>, decls: [Decl], tn: string_view, tr: string_view) string_view {
    list := a.denrich_missing_list(decls, tn, tr)
    is_empty(list).match ({
        true  => "",
        false => a.gstr_string(96).gstr_append(a, " — missing method(s): ").gstr_append(a, list).gstr_finish(a),
    })
}
// `draw(b)` where a bounded tparam `A: Show` binds to a type with no impl: name the type, the
// bound, the requiring function, and the concretely missing methods. A bound naming NO declared
// trait gets its own message (the generic one would send the user hunting for a phantom impl).
denrich_bound_violation = (env: Env, f: Func, c: CallData, tp: Param) string_view {
    (env.bound_err(f, c, tp) == 0).then({
        return ""
    })
    a := env.a
    tr := tp.tparam_bound()
    tn := env.call_targ(f, c.args, tp.name).recv_name()
    env.decls.is_struct(tr).match ({
        true  => a.gstr_string(160).gstr_append(a, "type `").gstr_append(a, tn).gstr_append(a, "` does not satisfy the bound `").gstr_append(a, tr).gstr_append(a, "` required by `").gstr_append(a, f.name).gstr_append(a, "`").gstr_append(a, a.denrich_missing_tail(env.decls, tn, tr)).gstr_finish(a),
        false => a.gstr_string(128).gstr_append(a, "the bound `").gstr_append(a, tr).gstr_append(a, "` required by `").gstr_append(a, f.name).gstr_append(a, "` names no declared trait").gstr_finish(a),
    })
}
denrich_bound_msg = (env: Env, f: Func, c: CallData) string_view {
    res := ""
    f.tparams.loop((h, i, tp) {
        res = is_empty(res).match ({ true => env.denrich_bound_violation(f, c, tp), false => res })
    })
    res
}
// `b.render()` on a concrete receiver with no impl: name the receiver type, the trait that
// declares the method, and what an impl must still provide.
denrich_recv_msg = (env: Env, c: CallData) string_view {
    (c.args.len == 0).then({
        return ""
    })
    a := env.a
    tn := env.infer_expr(c.args[0].addr()).recv_name()
    tr := env.decls.trait_declaring(c.fn)
    (is_empty(tn) || is_empty(tr)).match ({
        true  => "",
        false => a.gstr_string(160).gstr_append(a, "type `").gstr_append(a, tn).gstr_append(a, "` does not implement trait `").gstr_append(a, tr).gstr_append(a, "` (which declares `").gstr_append(a, c.fn).gstr_append(a, "`)").gstr_append(a, a.denrich_missing_tail(env.decls, tn, tr)).gstr_finish(a),
    })
}
// a trait-bound error at a call: a KNOWN local fn means a violated `A: Trait` bound at this call
// site (the raw-decls walk — the resolver inlines the call away); otherwise it is a trait-method
// call whose concrete receiver has no impl (the resolved-decls walk).
denrich_traitbound_msg = (env: Env, c: CallData) string_view {
    env.decls.is_known_fn(c.fn).match ({
        true  => env.denrich_bound_msg(env.decls.the_func(c.fn), c),
        false => env.denrich_recv_msg(c),
    })
}
// `/.` is the checker's internal float-division marker; a diagnostic must show the SOURCE operator `/`.
op_display = (op: string_view) string_view { eq(op, "/.").match ({ true => "/", false => op }) }
denrich_operand_msg = (env: Env, b: BinData) string_view {
    a := env.a
    lt := env.infer_expr(b.lhs)
    rt := env.infer_expr(b.rhs)
    a.gstr_string(96).gstr_append(a, "operator `").gstr_append(a, b.op.op_display()).gstr_append(a, "` cannot be applied to `").gstr_append(a, a.zty(lt)).gstr_append(a, "` and `").gstr_append(a, a.zty(rt)).gstr_append(a, "`").gstr_finish(a)
}
// first init field whose name is not a declared field (the unknown field a struct-literal error names)
denrich_bad_init = (fields: [Field], inits: [FieldInit]) string_view {
    bad := ""
    inits.loop((h, i, fi) {
        bad = is_empty(bad).match ({
            true  => fields.field_has(fi.name).match ({ true => "", false => fi.name }),
            false => bad,
        })
    })
    bad
}
field_has = (fields: [Field], name: string_view) bool {
    found := false
    fields.loop((h, i, f) {
        found = found || eq(f.name, name)
    })
    found
}
denrich_makestruct_msg = (env: Env, sd: MakeStructData) string_view {
    a := env.a
    env.env_is_struct(sd.ty).match ({
        true  => {
            fields := env.env_struct_fields(sd.ty)
            bad := fields.denrich_bad_init(sd.inits)
            is_empty(bad).match ({
                true  => "",
                false => a.gstr_string(96).gstr_append(a, "struct `").gstr_append(a, sd.ty).gstr_append(a, "` has no field `").gstr_append(a, bad).gstr_append(a, "` (fields: ").gstr_append(a, a.denrich_fieldlist(fields)).gstr_append(a, ")").gstr_finish(a),
            })
        },
        false => "",
    })
}
// ambiguous alias-UFCS call: TWO+ `alias__fn` decls match the receiver's head type, so
// dispatch_name refused to pick one and the call stayed an undefined name. Name the candidates
// in their surface (dotted) form so the fix — a qualified call — is copy-pasteable.
denrich_dotted = (s: String, a: MutPtr<Malloc>, name: string_view, p: i32) String {
    b := at(name, p)
    (b == 0).match ({
        true  => s,
        false => (b == '_' && at(name, p + 1) == '_').match ({
            true  => s.gstr_push(a, '.').denrich_dotted(a, name, p + 2),
            false => s.gstr_push(a, b).denrich_dotted(a, name, p + 1),
        }),
    })
}
denrich_ambiguous_msg = (env: Env, c: CallData) string_view {
    (c.args.len == 0).then({
        return ""
    })
    rty := env.infer_expr(c.args[0].addr())
    tyname := rty.dispatch_recv_name()
    cs := env.alias_ufcs_candidates(c.fn, rty)
    (cs.count < 2).then({
        return ""
    })
    a := env.a
    s := a.gstr_string(192).gstr_append(a, "ambiguous method `").gstr_append(a, c.fn).gstr_append(a, "` on `").gstr_append(a, tyname).gstr_append(a, "`: both `")
    s = s.denrich_dotted(a, cs.first, 0).gstr_append(a, "` and `").denrich_dotted(a, cs.second, 0).gstr_append(a, "` match the receiver")
    (cs.count > 2).then({
        s = s.gstr_append(a, " (and more)")
    })
    s = s.gstr_append(a, " - call it qualified, e.g. `").denrich_dotted(a, cs.first, 0).gstr_append(a, "(recv, ...)`")
    s.gstr_finish(a)
}
// ── integer-in-message helper: append a non-negative i64's decimal digits to a String (mirrors dnum) ──
di_digit = (d: i64) u8 { load(offset("0123456789", d)) }
gstr_i64 = (s: String, a: MutPtr<Malloc>, n: i64) String {
    (n < 10).match ({
        true  => s.gstr_push(a, di_digit(n)),
        false => {
            hs := s.gstr_i64(a, n / 10)
            hs.gstr_push(a, di_digit(n % 10))
        },
    })
}
// ── arity enrichment: name the expected vs the supplied argument count ─────────────────────────
// The declared count comes from the callee (a known local fn's params, an intrinsic's fixed arity, or
// an FnT value's parameter list); -1 = a callee whose arity we can't state here, so keep the generic
// message. `found` is always the call site's argument count.
fnt_arity_of = (t: Ty) i64 {
    t.match ({
        .FnT(ft) => ft.params.len,
        _        => 0 - 1,
    })
}
denrich_arity_msg = (env: Env, c: CallData) string_view {
    a := env.a
    exp := env.env_known_fn(c.fn).match ({
        true  => env.env_params(c.fn).len,
        false => c.fn.is_intrinsic().match ({
            true  => to_i64(c.fn.intrinsic_arity()),
            false => env.var_or_global(c.fn).fnt_arity_of(),
        }),
    })
    (exp < 0).match ({
        true  => "",
        false => a.gstr_string(64).gstr_append(a, "wrong number of arguments: expected ").gstr_i64(a, exp).gstr_append(a, ", found ").gstr_i64(a, c.args.len).gstr_finish(a),
    })
}
// ── exhaustiveness enrichment: name a variant the match fails to cover ─────────────────────────
denrich_exhaust_msg = (env: Env, m: MatchData) string_view {
    vs := env.decls.enum_variants(m.ename)
    miss := vs.first_missing_variant(m.arms)
    is_empty(miss).match ({
        true  => "",
        false => env.a.gstr_string(80).gstr_append(env.a, "match does not cover variant `.").gstr_append(env.a, miss).gstr_append(env.a, "`").gstr_finish(env.a),
    })
}
// ── method-not-found enrichment: an undefined call whose first argument is a concrete struct/enum ──
// receiver reads as a `recv.method()` UFCS call with no such method; name the receiver type + method,
// phrased so it is true whether it was written `recv.method()` or `method(recv)`.
denrich_undef_method_msg = (env: Env, c: CallData) string_view {
    (c.args.len == 0).then({
        return ""
    })
    a := env.a
    tn := env.infer_expr(c.args[0].addr()).recv_name()
    (is_empty(tn) || env.env_is_struct(tn) == false && env.env_is_enum(tn) == false).match ({
        true  => "",
        false => a.gstr_string(112).gstr_append(a, "no method `").gstr_append(a, c.fn).gstr_append(a, "` on type `").gstr_append(a, tn).gstr_append(a, "`, and no function `").gstr_append(a, c.fn).gstr_append(a, "` is in scope").gstr_finish(a),
    })
}
denrich_expr = (a: MutPtr<Malloc>, env: Env, e: Ptr<Expr>, off: i32, code: i32) string_view {
    load(e).match ({
        .Bin(b)         => (code == KOPERAND() && b.pos.pos_or(load(b.lhs).expr_pos()) == off).match ({
            true  => env.denrich_operand_msg(b),
            false => desc_or(a.denrich_expr(env, b.lhs, off, code), a.denrich_expr(env, b.rhs, off, code)),
        }),
        .Member(m)      => (code == KSTRUCTFIELD() && m.pos.pos_or(load(m.obj).expr_pos()) == off).match ({
            true  => env.denrich_member_msg(m.field, env.infer_expr(m.obj)),
            false => a.denrich_expr(env, m.obj, off, code),
        }),
        .Arrow(ar)      => (code == KSTRUCTFIELD() && ar.pos.pos_or(load(ar.obj).expr_pos()) == off).match ({
            true  => env.denrich_member_msg(ar.field, env.infer_expr(ar.obj)),
            false => a.denrich_expr(env, ar.obj, off, code),
        }),
        .MakeStruct(sd) => (code == KSTRUCTFIELD() && sd.pos.pos_or((sd.inits.len == 0).match ({
            true  => 0,
            false => load(sd.inits[0].value).expr_pos(),
        })) == off).match ({
            true  => env.denrich_makestruct_msg(sd),
            false => a.denrich_inits(env, sd.inits, off, code),
        }),
        .Call(c)        => (code == KNOTCALLABLE() && c.pos == off).match ({
            true  => env.denrich_notcallable_msg(c.fn),
            false => (code == KMETHODNOTFOUND() && c.pos == off).match ({
                true  => env.denrich_undef_method_msg(c),
                false => (code == KARITY() && c.pos == off).match ({
                    true  => env.denrich_arity_msg(c),
                    false => (code == KTRAITBOUND() && c.pos == off).match ({
                        true  => desc_or(env.denrich_traitbound_msg(c), a.denrich_args(env, c.args, off, code)),
                        false => (code == KUNDEFINED() && c.pos == off).match ({
                            true  => desc_or(env.denrich_ambiguous_msg(c), a.denrich_args(env, c.args, off, code)),
                            false => (code == KARGTYPE()).match ({
                                true  => desc_or(env.denrich_argfit_msg(c, off), a.denrich_args(env, c.args, off, code)),
                                false => a.denrich_args(env, c.args, off, code),
                            }),
                        }),
                    }),
                }),
            }),
        }),
        .SliceLit(sd)   => a.denrich_args(env, sd.items, off, code),
        .Index(ix)      => desc_or(a.denrich_expr(env, ix.seq, off, code), a.denrich_expr(env, ix.idx, off, code)),
        .Cond(d)        => desc_or(a.denrich_expr(env, d.c, off, code), desc_or(a.denrich_expr(env, d.t, off, code), a.denrich_expr(env, d.e, off, code))),
        .MakeEnum(mk)   => a.denrich_expr(env, mk.payload, off, code),
        .Match(m)       => {
            subjty := env.infer_expr(m.subj)
            sp := load(m.subj).expr_pos().pos_or(m.arms.arms_first_pos())
            desc_or((code == KEXHAUST() && sp == off).match ({
                true  => env.denrich_exhaust_msg(m),
                false => "",
            }), desc_or(a.denrich_expr(env, m.subj, off, code), a.denrich_arms(env, subjty, m.arms, off, code)))
        },
        .Block(b)       => a.denrich_body(env, b.stmts, off, code),
        .Loop(l)        => desc_or(a.denrich_expr(env, l.seq, off, code), a.denrich_body(a.loop_env(env, l), l.body, off, code)),
        _               => "",
    })
}
denrich_args = (a: MutPtr<Malloc>, env: Env, args: [Expr], off: i32, code: i32) string_view {
    res := ""
    args.loop((h, i, ar) {
        res = desc_or(res, a.denrich_expr(env, ar.addr(), off, code))
    })
    res
}
denrich_inits = (a: MutPtr<Malloc>, env: Env, inits: [FieldInit], off: i32, code: i32) string_view {
    res := ""
    inits.loop((h, i, fi) {
        res = desc_or(res, a.denrich_expr(env, fi.value, off, code))
    })
    res
}
denrich_arms = (a: MutPtr<Malloc>, env: Env, subjty: Ty, arms: [ArmData], off: i32, code: i32) string_view {
    res := ""
    arms.loop((h, i, ar) {
        res = desc_or(res, a.denrich_expr(a.arm_env(env, subjty, ar), ar.body, off, code))
    })
    res
}
denrich_stmt = (a: MutPtr<Malloc>, env: Env, st: Stmt, off: i32, code: i32) string_view {
    st.match ({
        .Let(l)      => desc_or((code == KASSIGNFIT() && load(l.value).expr_pos() == off).match ({
            true  => env.denrich_valfit(l.ty, l.value),
            false => "",
        }), a.denrich_expr(env, l.value, off, code)),
        .Assign(x)   => {
            ap := x.pos.pos_or(load(x.target).expr_pos()).pos_or(load(x.value).expr_pos())
            desc_or((code == KASSIGNFIT() && ap == off).match ({
                true  => env.denrich_valfit(env.infer_expr(x.target), x.value),
                false => "",
            }), desc_or(a.denrich_expr(env, x.target, off, code), a.denrich_expr(env, x.value, off, code)))
        },
        .Return(r)   => desc_or((code == KRETURNFIT() && load(r).expr_pos() == off).match ({
            true  => env.denrich_valfit(env.exp, r),
            false => "",
        }), a.denrich_expr(env, r, off, code)),
        .ExprStmt(e) => desc_or((code == KRETURNFIT() && load(e).expr_pos() == off).match ({
            true  => env.denrich_valfit(env.exp, e),
            false => "",
        }), a.denrich_expr(env, e, off, code)),
        .If(f)       => desc_or(a.denrich_expr(env, f.c, off, code), desc_or(a.denrich_body(env, f.then, off, code), a.denrich_body(env, f.els, off, code))),
        .While(w)    => desc_or(a.denrich_expr(env, w.c, off, code), a.denrich_body(env, w.body, off, code)),
        .IndexSet(x) => {
            ip := x.pos.pos_or(load(x.value).expr_pos()).pos_or(load(x.seq).expr_pos())
            desc_or((code == KASSIGNFIT() && ip == off).match ({
                true  => env.denrich_valfit(x.elem, x.value),
                false => "",
            }), desc_or(a.denrich_expr(env, x.seq, off, code), desc_or(a.denrich_expr(env, x.idx, off, code), a.denrich_expr(env, x.value, off, code))))
        },
    })
}
denrich_body = (a: MutPtr<Malloc>, env: Env, body: [Stmt], off: i32, code: i32) string_view {
    res := ""
    e := env
    body.loop((h, i, st) {
        res = desc_or(res, a.denrich_stmt(e, st, off, code))
        e = a.extend_env(e, st)
    })
    res
}
denrich_func = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, f: Func, off: i32, code: i32) string_view {
    env := Env(
        vars: a.bind_tparams(a.params_env(f.params), f.tparams),
        decls: decls,
        didx: idx,
        exp: f.ret,
        a: a,
    )
    a.denrich_body(env, f.body, off, code)
}
// dup-fn enrichment: NAME the symbol that is defined twice. `off` is the LATER definition's name
// offset (kv_dup_name_kind anchors there), so the decl whose pos matches — and whose name an
// EARLIER decl already binds — is the colliding one; the render already points file:line:col at it.
denrich_dupfn = (a: MutPtr<Malloc>, decls: [Decl], off: i32) string_view {
    res := ""
    decls.loop((h, i, d) {
        nm := d.fn_name_of()
        hit := is_empty(res) && is_empty(nm) == false && d.fn_pos_of() == off && decls.fn_dup_before(nm, i)
        res = hit.match ({
            true  => a.gstr_string(96).gstr_append(a, "duplicate top-level definition of `").gstr_append(a, nm).gstr_append(a, "` — an earlier definition of this name already exists in the flattened program").gstr_finish(a),
            false => res,
        })
    })
    res
}
// the driver's entry: an enriched message for a struct-field/operand/not-callable/trait-bound/
// dup-fn/undefined-name error at `off`, else "".
denrich_module* = (a: MutPtr<Malloc>, decls: [Decl], off: i32, code: i32) string_view {
    (off <= 0 || code != KSTRUCTFIELD() && code != KOPERAND() && code != KNOTCALLABLE() && code != KTRAITBOUND() && code != KDUPFN() && code != KUNDEFINED() && code != KARGTYPE() && code != KRETURNFIT() && code != KASSIGNFIT() && code != KARITY() && code != KEXHAUST() && code != KMETHODNOTFOUND()).then({
        return ""
    })
    (code == KDUPFN()).then({
        return a.denrich_dupfn(decls, off)
    })
    idx := a.build_decl_index(decls)
    res := ""
    decls.loop((h, i, d) {
        res = desc_or(res, d.match ({
            .DFunc(f) => a.denrich_func(decls, idx, f, off, code),
            _         => "",
        }))
    })
    res
}
// enrichment over BOTH decl views: resolved first (concrete receivers), then the RAW pre-inline
// decls — a trait-bound OR generic-pointer-shape arg error at a GENERIC call site only exists in the
// raw view (the resolver inlines/monomorphizes the call away before check_module runs), so its
// enrichment must walk raw; the raw fallback is for those two codes. The kind-string guard keeps
// enrichment to the PACKED kind channel: the custom channels (scope-escape/escape/scratch-escape/
// reserved-name) carry their own unique codes AND their own hand-built kind strings, so matching on
// the kind name confines enrichment to ladder-rendered diagnostics and never overwrites a custom
// channel's message.
denrich_check* = (a: MutPtr<Malloc>, raw: [Decl], decls: [Decl], off: i32, code: i32, kind: string_view) string_view {
    eq(kind, code.diagnostic_kind_name()).match ({
        true  => desc_or(a.denrich_module(decls, off, code), (code == KTRAITBOUND() || code == KARGTYPE()).match ({
            true  => a.denrich_module(raw, off, code),
            false => "",
        })),
        false => "",
    })
}
// the value-position block-arm walker, kind-flavoured (mirrors check_block/check_block_stmt).
kv_check_block_stmt_kind = (env: Env, st: Stmt) i32 {
    st.match ({
        .Let(l)      => env.kv_check_expr_kind(l.value).kv_kor(env.kv_let_fit_kind(l)).kv_kor(env.kv_let_needannot_kind(l)).kv_kor(env.kv_value_void_arm_kind(l.ty, l.value)),
        .Assign(x)   => env.kv_check_expr_kind(x.target).kv_kor(env.kv_check_expr_kind(x.value)).kv_kor(env.kv_assign_kind(x)).kv_kor(env.kv_value_void_arm_kind(env.infer_expr(x.target), x.value)),
        .Return(r)   => env.kv_check_expr_kind(r).kv_kor(env.kv_ret_kind(r)).kv_kor(env.kv_value_void_arm_kind(env.exp, r)),
        .ExprStmt(e) => env.kv_check_expr_kind(e),
        .If(f)       => env.kv_check_expr_kind(f.c),
        .While(w)    => env.kv_check_expr_kind(w.c),
        .IndexSet(x) => env.kv_check_expr_kind(x.seq).kv_kor(env.kv_check_expr_kind(x.idx)).kv_kor(env.kv_check_expr_kind(x.value)).kv_kor(env.kv_idxset_kind(x)).kv_kor(env.kv_value_void_arm_kind(x.elem, x.value)),
    })
}
kv_check_block_kind = (env: Env, stmts: [Stmt]) i32 {
    acc := 0
    e := env
    stmts.loop((h, i, st) {
        acc = acc.kv_kor(e.kv_check_block_stmt_kind(st))
        e = e.a.extend_env(e, st)
    })
    acc
}
// A slice-literal element whose type doesn't fit the first element's produces KARGTYPE.
kv_slicelit_kind = (env: Env, items: [Expr]) i32 {
    (items.len == 0).match ({
        true  => 0,
        false => {
            ety := env.infer_expr(items[0].addr())
            acc := 0
            items.loop((h, i, it) {
                acc = acc.kv_kor(env.sl_elem_fit(ety, it).kv_one(KARGTYPE()).kv_at(it.expr_pos()))
            })
            acc
        },
    })
}
// The narrowed walk above records the full count plus the first failing position and kind. The count and
// diagnostic layers therefore share one AST traversal definition instead of maintaining parallel
// recursive walkers that can silently drift when a new expression form is added.
lkv_expr_kind = (env: Env, e: Ptr<Expr>) i32 {
    r := env.name_errors_expr(e)
    (r.first_pos > 0).match ({ true => r.first_kind.kv_at(r.first_pos), false => 0 })
}
lkv_body_kind = (a: MutPtr<Malloc>, env: Env, body: [Stmt]) i32 {
    r := a.name_errors_body(env, body)
    (r.first_pos > 0).match ({ true => r.first_kind.kv_at(r.first_pos), false => 0 })
}
// Authoritative expression validation: node order defines first-error precedence.
kv_check_expr_kind = (env: Env, e: Ptr<Expr>) i32 {
    load(e).match ({
        .Call(c)        => env.kv_check_call_kind(c).kv_at(c.pos).kv_kor(env.store_mut_kind(c)).kv_kor(env.null_deref_kind(c)).kv_kor(env.assert_nonnull_kind(c)).kv_kor(env.call_void_arm_errs(c).kv_one(KARMVOID()).kv_at(c.pos)).kv_kor(eq(c.fn, "sizeof").match ({
            true  => 0,
            false => env.kv_check_args_kind(c.args),
        })),
        .SliceLit(sd)   => env.kv_slicelit_kind(sd.items),
        .Index(ix)      => env.kv_check_expr_kind(ix.seq).kv_kor(env.kv_check_expr_kind(ix.idx)).kv_kor(env.kv_index_kind(ix)),
        .Bin(b)         => env.kv_check_expr_kind(b.lhs).kv_kor(env.kv_check_expr_kind(b.rhs)).kv_kor(env.kv_operand_kind(b)),
        .Cond(d)        => env.kv_check_expr_kind(d.c).kv_kor(env.kv_check_expr_kind(d.t)).kv_kor(env.kv_check_expr_kind(d.e)).kv_kor(d.t.expr_drops_return().kv_one(KVALPOSRETURN())).kv_kor(d.e.expr_drops_return().kv_one(KVALPOSRETURN())).kv_kor(env.cond_result_err(d).kv_one(KRETURNFIT()).kv_at(load(d.t).expr_pos())).kv_kor(d.cond_onearm_err().kv_one(KBOOLARM()).kv_at(load(d.c).expr_pos())),
        .Member(m)      => env.kv_check_expr_kind(m.obj).kv_kor(env.kv_member_kind(m.obj, m.field, m.pos)),
        .Arrow(ar)      => env.kv_check_expr_kind(ar.obj).kv_kor(env.kv_member_kind(ar.obj, ar.field, ar.pos)),
        .Match(m)       => {
            subjty := env.infer_expr(m.subj)
            env.kv_check_expr_kind(m.subj).kv_kor(env.kv_match_null_kind(m)).kv_kor(env.kv_check_arms_kind(subjty, m.arms)).kv_kor(env.kv_match_kind(m)).kv_kor(env.kv_match_arm_result_kind(subjty, m.arms)).kv_kor(kv_arm_return_kind(m.arms))
        },
        .MakeEnum(mk)   => env.kv_check_expr_kind(mk.payload).kv_kor(env.mkenum_err(mk.ty, mk.variant).kv_one(KUNDEFINED())).kv_kor(env.enum_payload_err(mk).kv_one(KARGTYPE()).kv_at(load(mk.payload).expr_pos())),
        .Tag(t)         => env.mkenum_err(t.ty, t.variant).kv_one(KUNDEFINED()),
        .MakeStruct(sd) => env.kv_check_inits_kind(sd.inits).kv_kor(env.kv_makestruct_kind(sd)),
        .Block(b)       => env.kv_check_block_kind(b.stmts),
        .Var(v)         => env.var_err(v.name).kv_one(KUNDEFINED()).kv_at(v.pos),
        .Loop(l)        => env.lkv_expr_kind(l.seq).kv_kor(env.a.lkv_body_kind(env.a.loop_env(env, l), l.body)),
        .Lambda(lm)     => KLAMBDAVALUE(),    // a surviving lambda = used as a value (see check_expr)
        _               => 0,
    })
}
pos_or = (p: i32, fallback: i32) i32 { (p <= 0).match ({ true => fallback, false => p }) }
kv_ret_kind = (env: Env, r: Ptr<Expr>) i32 { env.ret_err(r).kv_one(KRETURNFIT()).kv_at(load(r).expr_pos()) }
kv_let_fit_kind = (env: Env, l: LetData) i32 { env.let_fit_err(l).kv_one(KASSIGNFIT()).kv_at(load(l.value).expr_pos()) }
kv_let_needannot_kind = (env: Env, l: LetData) i32 { env.let_needannot_err(l).kv_one(KNEEDANNOT()).kv_at(load(l.value).expr_pos()) }
kv_assign_kind = (env: Env, x: AssignData) i32 {
    ap := x.pos.pos_or(load(x.target).expr_pos()).pos_or(load(x.value).expr_pos())
    env.assign_err(x).kv_one(KASSIGNFIT()).kv_at(ap).kv_kor(env.assign_ptr_write_err(x).kv_one(KPTRWRITE()).kv_at(ap))
}
kv_idxset_kind = (env: Env, x: IndexSetData) i32 {
    ip := x.pos.pos_or(load(x.value).expr_pos()).pos_or(load(x.seq).expr_pos())
    env.idxset_err(x).kv_one(KASSIGNFIT()).kv_at(ip).kv_kor(env.idxset_ptr_write_err(x).kv_one(KPTRWRITE()).kv_at(ip))
}
// Authoritative statement validation: sub-expressions precede the statement-level fit check.
kv_check_stmt_kind = (a: MutPtr<Malloc>, env: Env, st: Stmt) i32 {
    st.match ({
        .Let(l)      => env.kv_check_expr_kind(l.value).kv_kor(env.kv_let_fit_kind(l)).kv_kor(env.kv_let_needannot_kind(l)).kv_kor(env.kv_value_void_arm_kind(l.ty, l.value)),
        .Assign(x)   => env.kv_check_expr_kind(x.target).kv_kor(env.kv_check_expr_kind(x.value)).kv_kor(env.kv_assign_kind(x)).kv_kor(env.kv_value_void_arm_kind(env.infer_expr(x.target), x.value)),
        .Return(r)   => env.kv_check_expr_kind(r).kv_kor(env.kv_ret_kind(r)).kv_kor(env.kv_value_void_arm_kind(env.exp, r)),
        .ExprStmt(e) => env.kv_check_expr_kind(e),
        .If(f)       => env.kv_check_expr_kind(f.c).kv_kor(a.kv_check_body_kind(env, f.then)).kv_kor(a.kv_check_body_kind(env, f.els)),
        .While(w)    => env.kv_check_expr_kind(w.c).kv_kor(a.kv_check_body_kind(env, w.body)),
        .IndexSet(x) => env.kv_check_expr_kind(x.seq).kv_kor(env.kv_check_expr_kind(x.idx)).kv_kor(env.kv_check_expr_kind(x.value)).kv_kor(env.kv_idxset_kind(x)).kv_kor(env.kv_value_void_arm_kind(x.elem, x.value)),
    })
}
kv_check_body_kind = (a: MutPtr<Malloc>, env: Env, body: [Stmt]) i32 {
    acc := 0
    e := env
    body.loop((h, i, st) {
        acc = acc.kv_kor(a.kv_check_stmt_kind(e, st))
        e = a.extend_env(e, st)
    })
    acc
}
// the trailing-value check, kind-flavoured: an empty / non-value-ending non-void body, or a trailing
// expr that doesn't fit, is a KRETURNFIT (a missing/mistyped produced value).
kv_last_stmt_kind = (env: Env, st: Stmt) i32 {
    st.match ({
        .ExprStmt(e) => env.kv_ret_kind(e).kv_kor(env.kv_value_void_arm_kind(env.exp, e)),
        .Return(r)   => 0,
        _            => KFALLTHROUGH().kv_at(st.stmt_pos()),
    })
}    // a let/assign/loop tail: caret on that statement
kv_trailing_kind = (env: Env, body: [Stmt]) i32 {
    env.exp.is_void_ty().match ({
        true  => 0,
        false => (body.len == 0).match ({
            true  => KFALLTHROUGH(),
            false => env.kv_last_stmt_kind(body[body.len - 1]),
        }),
    })
}
// ── bounded-generics enforcement over RAW (pre-inline) decls ─────────────────────────────
// Local generic calls are INLINED during resolve_module, so by check_module time the call site is
// gone. This pass therefore runs on the raw, pre-inline decls (like the M5 escape check), walking
// every function body and emitting KTRAITBOUND when a call binds a tparam `A: Trait` to a concrete
// type that does not impl Trait. It reports ONLY this one kind, so an unresolved generic body never
// false-positives the other validation kinds. Imported/foreign generics defer (bound_errs is 0).
kvb_call_kind = (env: Env, c: CallData) i32 {
    env.env_known_fn(c.fn).match ({
        true  => env.bound_errs(env.env_func(c.fn), c).kv_one(KTRAITBOUND()).kv_at(c.pos),
        false => 0,
    })
}
kvb_expr_kind = (env: Env, e: Ptr<Expr>) i32 {
    load(e).match ({
        .Call(c)        => env.kvb_call_kind(c).kv_kor(env.kvb_args_kind(c.args)),
        .Index(ix)      => env.kvb_expr_kind(ix.seq).kv_kor(env.kvb_expr_kind(ix.idx)),
        .Bin(b)         => env.kvb_expr_kind(b.lhs).kv_kor(env.kvb_expr_kind(b.rhs)),
        .Cond(d)        => env.kvb_expr_kind(d.c).kv_kor(env.kvb_expr_kind(d.t)).kv_kor(env.kvb_expr_kind(d.e)),
        .Member(m)      => env.kvb_expr_kind(m.obj),
        .Arrow(ar)      => env.kvb_expr_kind(ar.obj),
        .Match(m)       => env.kvb_expr_kind(m.subj).kv_kor(env.kvb_arms_kind(env.infer_expr(m.subj), m.arms)),
        .MakeEnum(mk)   => env.kvb_expr_kind(mk.payload),
        .MakeStruct(sd) => env.kvb_inits_kind(sd.inits),
        .Block(b)       => env.a.kvb_body_kind(env, b.stmts),
        .Loop(l)        => env.kvb_expr_kind(l.seq).kv_kor(env.a.kvb_body_kind(env, l.body)),
        _               => 0,
    })
}
kvb_args_kind = (env: Env, args: [Expr]) i32 {
    acc := 0
    args.loop((h, i, ar) {
        acc = acc.kv_kor(env.kvb_expr_kind(ar.addr()))
    })
    acc
}
kvb_inits_kind = (env: Env, inits: [FieldInit]) i32 {
    acc := 0
    inits.loop((h, i, fi) {
        acc = acc.kv_kor(env.kvb_expr_kind(fi.value))
    })
    acc
}
kvb_arms_kind = (env: Env, subjty: Ty, arms: [ArmData]) i32 {
    acc := 0
    arms.loop((h, i, ar) {
        acc = acc.kv_kor(env.a.arm_env(env, subjty, ar).kvb_expr_kind(ar.body))
    })
    acc
}
kvb_stmt_kind = (a: MutPtr<Malloc>, env: Env, st: Stmt) i32 {
    st.match ({
        .Let(l)      => env.kvb_expr_kind(l.value),
        .Assign(x)   => env.kvb_expr_kind(x.target).kv_kor(env.kvb_expr_kind(x.value)),
        .Return(r)   => env.kvb_expr_kind(r),
        .ExprStmt(e) => env.kvb_expr_kind(e),
        .If(f)       => env.kvb_expr_kind(f.c).kv_kor(a.kvb_body_kind(env, f.then)).kv_kor(a.kvb_body_kind(env, f.els)),
        .While(w)    => env.kvb_expr_kind(w.c).kv_kor(a.kvb_body_kind(env, w.body)),
        .IndexSet(x) => env.kvb_expr_kind(x.seq).kv_kor(env.kvb_expr_kind(x.idx)).kv_kor(env.kvb_expr_kind(x.value)),
    })
}
kvb_body_kind = (a: MutPtr<Malloc>, env: Env, body: [Stmt]) i32 {
    acc := 0
    e := env
    body.loop((h, i, st) {
        acc = acc.kv_kor(a.kvb_stmt_kind(e, st))
        e = a.extend_env(e, st)
    })
    acc
}
kvb_func_kind = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, f: Func) i32 {
    env := Env(
        vars: a.params_env(f.params),
        decls: decls,
        didx: idx,
        exp: f.ret,
        a: a,
    )
    a.kvb_body_kind(env, f.body)
}
check_module_bound_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    idx := a.build_decl_index(decls)
    acc := 0
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DFunc(f) => a.kvb_func_kind(decls, idx, f),
            _         => 0,
        }))
    })
    acc
}
check_module_bound_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    packed := a.check_module_bound_kind(decls)
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => src.check_diagnostic_from_source(packed, 1),
    })
}
// ── M5: explicit type-argument (turbofish) + closure-argument validation over RAW decls ──────────────
// Local generic calls are INLINED during resolve_module, which ERASES the call site's explicit `<…>`
// type args and its lambda arguments before check_module ever sees them. So an undefined turbofish type
// (`sz<NoExist>()`), a turbofish on a non-generic callee (`plain<i64>(5)`), a type-arg that contradicts
// the value args (`id<str>(5)`), and a wrong-arity / wrong-typed closure passed to a HOF
// (`xs.fold(0, (x){…})`) all slipped through SEMA and leaked to cc as raw C / linker errors. This pass
// runs (driver-only) on the DESUGARED (method-calls flattened to plain Calls) but PRE-INLINE decls,
// where every call still carries its `targs` and lambda args. It threads the enclosing function's
// tparams so a turbofish that names an IN-SCOPE tparam (`sz<T>()` inside `g<T>`) is not a false
// unknown-type, and reports only these argument kinds (no other validator judgment), so an
// unresolved generic body never false-positives.
KNOTYPEARGS = () i32 { 26 }    // turbofish `f<T>(…)` on a callee that declares NO type parameters
ka_tbuf = (a: MutPtr<Malloc>, n: i64) [Ty] { slice(a.acquire(n * sizeof(Ty)), n) }
ka_pbuf = (a: MutPtr<Malloc>, n: i64) [Param] { slice(a.acquire(n * sizeof(Param)), n) }
// the call's full type-arg buffer: an explicit turbofish `<…>` PINS position i; an absent one is
// inferred from the value args (exactly as the resolver's call_targs does) so a closure FnT param
// substitutes to its concrete types for the arity/return check below.
ka_targs = (env: Env, f: Func, args: [Expr], etargs: [Ty]) [Ty] {
    buf := env.a.ka_tbuf(f.tparams.len)
    f.tparams.loop((h, i, tp) {
        buf[i] = (i < etargs.len).match ({
            true  => etargs[i],
            false => env.call_targ(f, args, tp.name),
        })
    })
    buf
}
// a UFCS method call `recv.method(args)` lowers to `method(recv, …args)` — the SAME flat shape the
// resolver's desugar produces. Rebuild the flat arg list here (without mutating the shared raw decls,
// which a later pass still reads in surface form) so the closure/arg checks see the receiver as arg 0.
ka_mcall_args = (a: MutPtr<Malloc>, mc: MethodCallData) [Expr] {
    buf := slice(a.acquire((mc.args.len + 1) * sizeof(Expr)), mc.args.len + 1)
    buf[0] = load(mc.recv)
    mc.args.loop((h, i, ar) {
        buf[i + 1] = mc.args[i]
    })
    buf
}
// (c) explicit-vs-inferred mismatch: with every tparam pinned by turbofish, substitute the bindings into
// each tparam-typed param slot and require the value arg to fit the now-CONCRETE type. A literal flowing
// into an int slot is range-decided (so `id<i32>(5)` still fits); a lambda / still-unknown slot defers.
ka_mismatch_at = (env: Env, tparams: [Param], targs: [Ty], params: [Param], i: i32, ar: Expr) i32 {
    (i < params.len).match ({
        true  => tparams.ty_mentions_tparam(params[i].ty).match ({
            true  => {
                ct := env.a.subst_ty_in(tparams, targs, params[i].ty)
                (env.unknown_ty(ct) || ar.is_ctx_typed_arg() || ct.is_fnt()).match ({
                    true  => 0,
                    false => {
                        lv := ar.addr().lit_slot_verdict(ct)
                        (lv >= 0).match ({
                            true  => lv,
                            false => env.fit_err(env.infer_expr(ar.addr()), ct),
                        })
                    },
                })
            },
            false => 0,
        }),
        false => 0,
    })
}
// args whose CONCRETE type is fixed by context, not by standalone inference: a lambda (FnT, checked
// separately), and a BARE enum constructor / tag `.Variant(…)` — its enum is chosen by the expected
// param type during mono (e.g. `.Num(7)` may be `Tok` or `Expr`), so inferring it here mis-rejects.
is_ctx_typed_arg = (e: Expr) bool {
    e.match ({
        .Lambda(lm)  => true,
        .MakeEnum(m) => true,
        .Tag(t)      => true,
        _            => false,
    })
}
// (R5) a lambda bound to an FnT parameter: its declared param COUNT must match the FnT's, and — when the
// FnT's concrete (substituted) param/return types are known — the lambda's body value must fit the FnT
// return type. Bind each lambda param to the FnT's substituted param type, then infer the body's value.
ka_lam_params = (a: MutPtr<Malloc>, lmps: [Param], fps: [Ty]) [Param] {
    buf := a.ka_pbuf(lmps.len)
    lmps.loop((h, i, p) {
        buf[i] = Param(
            name: p.name,
            ty: (i < fps.len).match ({ true => fps[i], false => tvoid() }),
            variadic: false,
        )
    })
    buf
}
ka_lam_body_ty = (env: Env, lm: LambdaData, fps: [Ty]) Ty {
    (lm.body.len == 0).match ({
        true  => tvoid(),
        false => {
            benv := Env(
                vars: env.a.params_env(env.a.ka_lam_params(lm.params, fps)),
                decls: env.decls,
                didx: env.didx,
                exp: tvoid(),
                a: env.a,
            )
            benv.ka_last_ty(lm.body[lm.body.len - 1])
        },
    })
}
ka_last_ty = (env: Env, st: Stmt) Ty {
    st.match ({
        .ExprStmt(e) => env.infer_expr(e),
        .Return(r)   => env.infer_expr(r),
        _            => tvoid(),
    })
}
// the lambda's body return doesn't fit the FnT's return type — only when both are concrete-known.
ka_lam_ret_err = (env: Env, fd: FnTData, lm: LambdaData, fps: [Ty]) i32 {
    rty := load(fd.ret)
    (env.unknown_ty(rty) || lm.ret.is_void_ty() == false).match ({
        true  => env.unknown_ty(rty).match ({ true => 0, false => env.fit_err(lm.ret, rty) }),
        false => {
            bty := env.ka_lam_body_ty(lm, fps)
            (bty.is_void_ty() || env.unknown_ty(bty)).match ({
                true  => 0,
                false => env.fit_err(bty, rty),
            })
        },
    })
}
ka_lambda_at = (env: Env, ftparams: [Param], targs: [Ty], params: [Param], i: i32, ar: Expr, cpos: i32) i32 {
    ar.match ({
        .Lambda(lm) => (i < params.len).match ({
            true  => env.a.subst_ty_in(ftparams, targs, params[i].ty).match ({
                .FnT(fd) => (fd.params.len == lm.params.len).match ({
                    true  => env.ka_lam_ret_err(fd, lm, fd.params).kv_one(KARGTYPE()).kv_at(cpos),
                    false => KARITY().kv_at(cpos),
                }),
                _        => 0,
            }),
            false => 0,
        }),
        _           => 0,
    })
}
// per-call arg checks: (c) explicit-arg mismatches + (R5) closure arity/return, against the SAME pinned
// type-arg buffer. Run only for a KNOWN local callee whose signature is visible here.
// The explicit-mismatch (c) check fires ONLY when the call carries turbofish `<…>` (the user PINNED the
// bindings, so a contradicting value arg is a real error). A purely-inferred generic call leaves arg
// typing to monomorphization (a bare `.Variant` / cross-enum residue resolves only there). The closure
// arity/return check (R5) runs regardless, since HOF closures rarely carry turbofish.
// A right-arity LOCAL generic call is INLINED during resolve_module, so the post-inline call check
// The ordinary resolved-call path never sees it, so argument-type safety of its CONCRETE slots was
// therefore off for EVERY generic callee (and the whole stdlib threads `MutPtr<A>`, so it is
// generic). Re-arm it HERE, on the pre-inline call site, reusing the SAME arg_err_at the accepted
// non-generic path uses: it skips tparam-mentioning slots (deferred to mono) and checks only the
// concrete ones (`n:i32`, `sep:u8`) via lit_slot_verdict + fit_err — with fit_err's unknown-arg
// leniency intact, so unresolved generic residue never over-rejects. Gated to `tparams.len > 0`:
// a non-generic callee's call survives to the post-inline pass, which already checks it. Gated to
// `authoritative` (fn is NOT also a trait/impl method): `the_func(fn)` returns THE top-level free
// function by name, and UFCS binds its receiver to param 0 (positional), so its concrete slots check
// soundly. But a name that ALSO has an impl method (e.g. `String.impl.append_in(s, a, t)` alongside
// the free `append_in(a, s, t)`) may UFCS-dispatch to the impl by receiver type — then the free-fn
// signature `the_func` returns is the WRONG yardstick, and a positional check would mis-reject a legit
// `s.append_in(mp, t)`. Such dispatched names defer (under-catch), so the check never over-rejects.
ka_concrete_arg_err = (env: Env, authoritative: bool, f: Func, i: i32, ar: Expr, pos: i32) i32 {
    (authoritative && f.tparams.len > 0).match ({
        true  => env.arg_err_at(f.tparams, f.params, i, ar).kv_one(KARGTYPE()).kv_at(ar.expr_pos().pos_or(pos)),
        false => 0,
    })
}
ka_args_check = (env: Env, tparams: [Param], authoritative: bool, f: Func, args: [Expr], etargs: [Ty], pos: i32) i32 {
    targs := env.ka_targs(f, args, etargs)
    tf := etargs.len > 0
    acc := 0
    args.loop((h, i, ar) {
        acc = acc.kv_kor(tf.match ({
            true  => env.ka_mismatch_at(f.tparams, targs, f.params, i, ar).kv_one(KARGTYPE()).kv_at(ar.expr_pos().pos_or(pos)),
            false => 0,
        })).kv_kor(env.ka_lambda_at(f.tparams, targs, f.params, i, ar, pos)).kv_kor(env.ka_concrete_arg_err(authoritative, f, i, ar, pos))
    })
    acc
}
// the shared call core, driven from both a flat `.Call` and a desugared `.MethodCall`: turbofish checks
// (a/b) + the explicit-arg-mismatch (c) + closure (R5) checks, for a KNOWN local callee — UNLESS the
// name is locally bound (a param/let SHADOWS the same-named top-level fn, so its signature is the
// wrong yardstick here; e.g. a closure param `f` while a top-level `f` exists). Shadowed calls are
// skipped, not re-judged: pre-inline generic bodies can't always type the local (lenient by design).
ka_call_core = (env: Env, tparams: [Param], fn: string_view, args: [Expr], etargs: [Ty], pos: i32) i32 {
    (env.env_known_fn(fn) && env.is_local(fn) == false).match ({
        true  => {
            f := env.env_func(fn)
            // `the_func(fn)`'s signature is the authoritative callee only when `fn` is not ALSO a trait/impl
            // method — otherwise UFCS may dispatch to the impl by receiver type, and the free-fn signature
            // is the wrong yardstick for the concrete-arg check (which then defers). (Zen has no free-fn
            // overloading, so a name with no impl method resolves uniquely to this decl.)
            authoritative := env.env_trait_method(fn) == false
            tf := (etargs.len == 0).match ({
                true  => 0,
                false => (f.tparams.len == 0).match ({
                    true  => KNOTYPEARGS().kv_at(pos),
                    false => env.ut_unknown_tys(tparams, etargs).kv_one(KUNKNOWNTYPE()).kv_at(pos),
                }),
            })
            // a fully-pinned turbofish (or inferred bindings) feeds the arg-mismatch + closure checks; an
            // unknown turbofish type short-circuits (the unknown-type error already fired).
            tf.kv_kor(env.ka_args_check(tparams, authoritative, f, args, etargs, pos))
        },
        false => 0,
    })
}
ka_expr_kind = (env: Env, tparams: [Param], e: Ptr<Expr>) i32 {
    load(e).match ({
        .Call(c)        => env.ka_call_core(tparams, c.fn, c.args, c.targs, c.pos).kv_kor(env.ka_args_kind(tparams, c.args)),
        .MethodCall(mc) => {
            cargs := env.a.ka_mcall_args(mc)
            env.ka_call_core(tparams, mc.method, cargs, no_tys(), mc.pos).kv_kor(env.ka_args_kind(tparams, cargs))
        },
        .Index(ix)      => env.ka_expr_kind(tparams, ix.seq).kv_kor(env.ka_expr_kind(tparams, ix.idx)),
        .Bin(b)         => env.ka_expr_kind(tparams, b.lhs).kv_kor(env.ka_expr_kind(tparams, b.rhs)),
        .Cond(d)        => env.ka_expr_kind(tparams, d.c).kv_kor(env.ka_expr_kind(tparams, d.t)).kv_kor(env.ka_expr_kind(tparams, d.e)),
        .Member(m)      => env.ka_expr_kind(tparams, m.obj),
        .Arrow(ar)      => env.ka_expr_kind(tparams, ar.obj),
        .Match(m)       => env.ka_expr_kind(tparams, m.subj).kv_kor(env.ka_arms_kind(tparams, env.infer_expr(m.subj), m.arms)),
        .MakeEnum(mk)   => env.ka_expr_kind(tparams, mk.payload),
        .MakeStruct(sd) => env.ka_inits_kind(tparams, sd.inits),
        .SliceLit(sd)   => env.ka_args_kind(tparams, sd.items),
        .Lambda(lm)     => env.a.ka_body_kind(env, tparams, lm.body),
        .Block(b)       => env.a.ka_body_kind(env, tparams, b.stmts),
        .Loop(l)        => env.ka_expr_kind(tparams, l.seq).kv_kor(env.a.ka_body_kind(env, tparams, l.body)),
        _               => 0,
    })
}
ka_args_kind = (env: Env, tparams: [Param], args: [Expr]) i32 {
    acc := 0
    args.loop((h, i, ar) {
        acc = acc.kv_kor(env.ka_expr_kind(tparams, ar.addr()))
    })
    acc
}
ka_inits_kind = (env: Env, tparams: [Param], inits: [FieldInit]) i32 {
    acc := 0
    inits.loop((h, i, fi) {
        acc = acc.kv_kor(env.ka_expr_kind(tparams, fi.value))
    })
    acc
}
ka_arms_kind = (env: Env, tparams: [Param], subjty: Ty, arms: [ArmData]) i32 {
    acc := 0
    arms.loop((h, i, ar) {
        acc = acc.kv_kor(env.a.arm_env(env, subjty, ar).ka_expr_kind(tparams, ar.body))
    })
    acc
}
ka_stmt_kind = (a: MutPtr<Malloc>, env: Env, tparams: [Param], st: Stmt) i32 {
    st.match ({
        .Let(l)      => env.ka_expr_kind(tparams, l.value),
        .Assign(x)   => env.ka_expr_kind(tparams, x.target).kv_kor(env.ka_expr_kind(tparams, x.value)),
        .Return(r)   => env.ka_expr_kind(tparams, r),
        .ExprStmt(e) => env.ka_expr_kind(tparams, e),
        .If(f)       => env.ka_expr_kind(tparams, f.c).kv_kor(a.ka_body_kind(env, tparams, f.then)).kv_kor(a.ka_body_kind(env, tparams, f.els)),
        .While(w)    => env.ka_expr_kind(tparams, w.c).kv_kor(a.ka_body_kind(env, tparams, w.body)),
        .IndexSet(x) => env.ka_expr_kind(tparams, x.seq).kv_kor(env.ka_expr_kind(tparams, x.idx)).kv_kor(env.ka_expr_kind(tparams, x.value)),
    })
}
ka_body_kind = (a: MutPtr<Malloc>, env: Env, tparams: [Param], body: [Stmt]) i32 {
    acc := 0
    e := env
    body.loop((h, i, st) {
        acc = acc.kv_kor(a.ka_stmt_kind(e, tparams, st))
        e = a.extend_env(e, st)
    })
    acc
}
ka_func_kind = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, f: Func) i32 {
    env := Env(
        vars: a.params_env(f.params),
        decls: decls,
        didx: idx,
        exp: f.ret,
        a: a,
    )
    a.ka_body_kind(env, f.tparams, f.body)
}
// ── recursive HOF: a self-recursive fn with an FnT param ─────────────────────────────────────────
// A bodied fn with an FnT param is a TEMPLATE (genc.is_generic_fn): it is inlined at each call site
// and NEVER emitted as a standalone C function. The inliner unrolls a bounded number of self-call
// levels, so the residual self-call survives in the emitted C as a call to a symbol that has no
// definition — an "undefined reference" at LINK time, misreported as an internal compiler bug (and
// shallow recursion only "works" when cc constant-folds the dead residual call). Until such fns are
// monomorphized per FnT arg, reject them with a positioned error. Lenient guard: a PARAM named after
// the fn itself shadows it (see shadows_toplevel), so its calls are indirect, not recursion.
KRECHOF = () i32 { 28 }    // a recursive function with a function-typed parameter (inline-only, so the self-call can never be emitted)
ka_param_named = (ps: [Param], nm: string_view) bool {
    found := false
    ps.loop((h, i, p) {
        found = eq(p.name, nm).match ({ true => true, false => found })
    })
    found
}
ka_rec_hof_kind = (f: Func) i32 {
    (f.params.has_fnt_param() && f.body.len > 0 && f.params.ka_param_named(f.name) == false && f.body.rc_calls_body(f.name)).match ({
        true  => KRECHOF().kv_at(f.pos),
        false => 0,
    })
}
check_module_arg_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    idx := a.build_decl_index(decls)
    acc := 0
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DFunc(f) => f.ka_rec_hof_kind().kv_kor(a.ka_func_kind(decls, idx, f)),
            _         => 0,
        }))
    })
    acc
}
check_module_arg_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    packed := a.check_module_arg_kind(decls)
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => src.check_diagnostic_from_source(packed, 1),
    })
}
// ── or_return CONTEXT validation over RAW decls (driver-only) ────────────────────────────────────
// `.or_return()` lowers to `if Err → return <receiver>` from the ENCLOSING function, so it is only
// meaningful inside a function whose return type is a Result carrying the SAME error type E as the
// receiver's (v1: exact E, no From/Into conversion — bridge the error explicitly before propagating).
// or_return is lowered away during resolve_module, so check_module never sees it; this pass runs on
// the RAW (pre-resolve, still-MethodCall) FLATTENED decls, where every call site is intact. It is
// deliberately LENIENT where raw inference is weak: a receiver whose type (or Err payload) cannot be
// inferred here is skipped — reject only what is PROVABLY wrong, never over-reject.
KORRETURN = () i32 { 27 }    // `.or_return()` in a function whose return type is not a matching Result
ko_is_or_call = (c: CallData) bool { eq(c.fn, "or_return") && c.args.len == 1 }
ko_is_or_mcall = (mc: MethodCallData) bool { eq(mc.method, "or_return") && mc.args.len == 0 }
// the enclosing fn's ret and the receiver both need an `Err` payload, and the two must agree.
// The `Ok` payloads are POSITION-dependent (`cnd` = conditionally-evaluated position):
//   - UNCONDITIONAL positions (direct let value, call/ctor args, mid-chain receivers, match
//     subjects, non-shortcircuit operands, …) hoist to a statement-level let whose lowering
//     REBUILDS the Err return as the enclosing fn's Result (orret_err_value in compiler.check), so
//     the receiver's Ok payload is unconstrained — it is consumed locally, only E must line up.
//   - CONDITIONAL positions (`&&`/`||` right operands, cond/match branch values, while-loop
//     conditions, lambda/loop/value-block bodies) lower in place with the receiver returned
//     VERBATIM (their local expected type is not the fn's return type, so the rebuild can't fire):
//     there the receiver's whole Result type must still be the enclosing fn's (a `Result<bool, E>`
//     receiver in a `Result<i32, E>` fn emits `return <Result_bool_E>` and dies at cc in positions
//     the return-fit scan never reaches — #377's miscompile).
// A tparam-typed / unknown side defers (concrete only after monomorphization).
ko_at = (env: Env, tps: [Param], want: Ty, recv: Ptr<Expr>, cnd: bool, pos: i32) i32 {
    (tps.ty_mentions_tparam(want) || env.unknown_ty(want)).match ({
        true  => 0,
        false => {
            fE := env.subj_variant_payload(want, "Err")
            fE.is_void_ty().match ({
                true  => KORRETURN().kv_at(pos),
                false => {
                    rt := env.infer_expr(recv)
                    (rt.is_void_ty() || env.unknown_ty(rt) || tps.ty_mentions_tparam(rt)).match ({
                        true  => 0,
                        false => {
                            rE := env.subj_variant_payload(rt, "Err")
                            (rE.is_void_ty() || env.unknown_ty(rE) || env.unknown_ty(fE) || tps.ty_mentions_tparam(rE) || tps.ty_mentions_tparam(fE)).match ({
                                true  => 0,
                                false => (fE.ty_eq(rE) || rE.ty_eq(fE)).match ({
                                    true  => cnd.match ({
                                        true  => env.ko_ok_at(tps, want, rt, pos),
                                        false => 0,
                                    }),
                                    false => KORRETURN().kv_at(pos),
                                }),
                            })
                        },
                    })
                },
            })
        },
    })
}
// the Ok side of the same judgment (CONDITIONAL positions only), entered once both Err payloads are
// known and agree. Same leniency: an unknown / tparam-typed / payloadless (void) Ok side defers.
ko_ok_at = (env: Env, tps: [Param], want: Ty, rt: Ty, pos: i32) i32 {
    fO := env.subj_variant_payload(want, "Ok")
    rO := env.subj_variant_payload(rt, "Ok")
    (fO.is_void_ty() || rO.is_void_ty() || env.unknown_ty(fO) || env.unknown_ty(rO) || tps.ty_mentions_tparam(fO) || tps.ty_mentions_tparam(rO)).match ({
        true  => 0,
        false => (fO.ty_eq(rO) || rO.ty_eq(fO)).match ({
            true  => 0,
            false => KORRETURN().kv_at(pos),
        }),
    })
}
ko_call_kind = (env: Env, tps: [Param], want: Ty, c: CallData, cnd: bool) i32 {
    own := ko_is_or_call(c).match ({
        true  => env.ko_at(tps, want, c.args[0].addr(), cnd, c.pos),
        false => 0,
    })
    own.kv_kor(env.ko_args_kind(tps, want, c.args, cnd))
}
ko_mcall_kind = (env: Env, tps: [Param], want: Ty, mc: MethodCallData, cnd: bool) i32 {
    own := ko_is_or_mcall(mc).match ({
        true  => env.ko_at(tps, want, mc.recv, cnd, mc.pos),
        false => 0,
    })
    own.kv_kor(env.ko_expr_kind(tps, want, mc.recv, cnd)).kv_kor(env.ko_args_kind(tps, want, mc.args, cnd))
}
// `cnd` marks descent into a CONDITIONALLY-evaluated / value-block position (see ko_at): those
// or_returns lower in place (verbatim receiver return), so the strict full-Result check applies.
// It is set on entry and never cleared — a statement nested under a conditional value is still
// conditional. `&&`/`||` LEFT operands and cond/match SUBJECTS evaluate unconditionally and hoist,
// so they inherit.
ko_is_sc = (op: string_view) bool { eq(op, "&&") || eq(op, "||") }
ko_expr_kind = (env: Env, tps: [Param], want: Ty, e: Ptr<Expr>, cnd: bool) i32 {
    load(e).match ({
        .Call(c)        => env.ko_call_kind(tps, want, c, cnd),
        .MethodCall(mc) => env.ko_mcall_kind(tps, want, mc, cnd),
        .Index(ix)      => env.ko_expr_kind(tps, want, ix.seq, cnd).kv_kor(env.ko_expr_kind(tps, want, ix.idx, cnd)),
        .Bin(b)         => env.ko_expr_kind(tps, want, b.lhs, cnd).kv_kor(env.ko_expr_kind(tps, want, b.rhs, ko_is_sc(b.op) || cnd)),
        .Cond(d)        => env.ko_expr_kind(tps, want, d.c, cnd).kv_kor(env.ko_expr_kind(tps, want, d.t, true)).kv_kor(env.ko_expr_kind(tps, want, d.e, true)),
        .Member(m)      => env.ko_expr_kind(tps, want, m.obj, cnd),
        .Arrow(ar)      => env.ko_expr_kind(tps, want, ar.obj, cnd),
        .Match(m)       => env.ko_expr_kind(tps, want, m.subj, cnd).kv_kor(env.ko_arms_kind(tps, want, env.infer_expr(m.subj), m.arms)),
        .MakeEnum(mk)   => env.ko_expr_kind(tps, want, mk.payload, cnd),
        .MakeStruct(sd) => env.ko_inits_kind(tps, want, sd.inits, cnd),
        .SliceLit(sd)   => env.ko_args_kind(tps, want, sd.items, cnd),
        .Lambda(lm)     => env.a.ko_body_kind(env, tps, want, lm.body, true),
        .Block(b)       => env.a.ko_body_kind(env, tps, want, b.stmts, true),
        .Loop(l)        => env.ko_expr_kind(tps, want, l.seq, cnd).kv_kor(env.a.ko_body_kind(env, tps, want, l.body, true)),
        _               => 0,
    })
}
ko_args_kind = (env: Env, tps: [Param], want: Ty, args: [Expr], cnd: bool) i32 {
    acc := 0
    args.loop((h, i, ar) {
        acc = acc.kv_kor(env.ko_expr_kind(tps, want, args[i].addr(), cnd))
    })
    acc
}
ko_inits_kind = (env: Env, tps: [Param], want: Ty, inits: [FieldInit], cnd: bool) i32 {
    acc := 0
    inits.loop((h, i, fi) {
        acc = acc.kv_kor(env.ko_expr_kind(tps, want, fi.value, cnd))
    })
    acc
}
// Arm bodies are always conditional (only the selected arm evaluates), and a statement-position
// match resolves its arms under a cleared expected type, so the rebuild cannot fire there either.
ko_arms_kind = (env: Env, tps: [Param], want: Ty, subjty: Ty, arms: [ArmData]) i32 {
    acc := 0
    arms.loop((h, i, ar) {
        acc = acc.kv_kor(env.a.arm_env(env, subjty, ar).ko_expr_kind(tps, want, ar.body, true))
    })
    acc
}
ko_stmt_kind = (a: MutPtr<Malloc>, env: Env, tps: [Param], want: Ty, st: Stmt, cnd: bool) i32 {
    st.match ({
        .Let(l)      => env.ko_expr_kind(tps, want, l.value, cnd),
        .Assign(x)   => env.ko_expr_kind(tps, want, x.target, cnd).kv_kor(env.ko_expr_kind(tps, want, x.value, cnd)),
        .Return(r)   => env.ko_expr_kind(tps, want, r, cnd),
        .ExprStmt(e) => env.ko_expr_kind(tps, want, e, cnd),
        .If(f)       => env.ko_expr_kind(tps, want, f.c, cnd).kv_kor(a.ko_body_kind(env, tps, want, f.then, cnd)).kv_kor(a.ko_body_kind(env, tps, want, f.els, cnd)),
        .While(w)    => env.ko_expr_kind(tps, want, w.c, true).kv_kor(a.ko_body_kind(env, tps, want, w.body, cnd)),
        .IndexSet(x) => env.ko_expr_kind(tps, want, x.seq, cnd).kv_kor(env.ko_expr_kind(tps, want, x.idx, cnd)).kv_kor(env.ko_expr_kind(tps, want, x.value, cnd)),
    })
}
ko_body_kind = (a: MutPtr<Malloc>, env: Env, tps: [Param], want: Ty, body: [Stmt], cnd: bool) i32 {
    acc := 0
    e := env
    body.loop((h, i, st) {
        acc = acc.kv_kor(a.ko_stmt_kind(e, tps, want, st, cnd))
        e = a.extend_env(e, st)
    })
    acc
}
ko_func_kind = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, f: Func) i32 {
    env := Env(
        vars: a.params_env(f.params),
        decls: decls,
        didx: idx,
        exp: f.ret,
        a: a,
    )
    a.ko_body_kind(env, f.tparams, f.ret, f.body, false)
}
// `.or_return()` in a GLOBAL initializer has NO enclosing function to return the Err to: the lowered
// early-return would silently abort `zen__init_globals` mid-way, leaving every later global
// zero-initialized (no diagnostic, wrong exit values). Walk the initializer with a non-Result `want`
// (i32) so ANY or_return inside it reports KORRETURN at its own position — the same "no matching
// Result to propagate into" judgment the fn-body walk makes, with nothing lenient to defer to.
ko_global_kind = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, g: GlobalData) i32 {
    env := Env(
        vars: a.params_env(empty_params()),
        decls: decls,
        didx: idx,
        exp: tvoid(),
        a: a,
    )
    is_expr_null(g.init).match ({
        true  => 0,
        false => env.ko_expr_kind(empty_params(), ti32(), g.init, false),
    })
}
check_module_or_return_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    idx := a.build_decl_index(decls)
    acc := 0
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DFunc(f)   => a.ko_func_kind(decls, idx, f),
            .DGlobal(g) => a.ko_global_kind(decls, idx, g),
            _           => 0,
        }))
    })
    acc
}
check_module_or_return_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    packed := a.check_module_or_return_kind(decls)
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => src.check_diagnostic_from_source(packed, 1),
    })
}
// ── undefined type names in annotations (a standalone, driver-only pass) ───────────────────────────
// `m: MutPtr<TotallyUndefinedType>` type-checked "ok" then leaked an unknown C type name. A Named (or
// Generic-base) type in a signature / field / payload that is NOT a primitive, a DECLARED type
// (struct/enum/gen-struct/gen-enum, incl. anon structs), an in-scope tparam, or `Self` is a real
// "unknown type". Runs ONLY in the driver check chain, on the FULLY-FLATTENED decls — where every
// legitimate (incl. imported) type is present — so an undeclared name is genuinely undefined, not the
// cross-module / pre-mono "uninferable residue" the core validator deliberately tolerates. It is NOT
// part of check_module's count/kind (the harness runs that on NON-flattened source), so the harness is
// untouched. Pointer/slice elements and generic args recurse; FnT internals are left to later checks.
ut_has_tparam = (tparams: [Param], n: string_view) bool {
    f := false
    tparams.loop((h, i, tp) {
        f = eq(tp.name, n).match ({ true => true, false => f })
    })
    f
}
ut_unknown_ty = (env: Env, tparams: [Param], t: Ty) i32 {
    t.match ({
        .Named(n)   => (eq(n, "Self") || is_prim_width(n) || tparams.ut_has_tparam(n) || env.env_named_declared(n)).match ({
            true  => 0,
            false => 1,
        }),
        .Generic(g) => env.env_named_declared(g.name).match ({
            true  => env.ut_unknown_tys(tparams, g.args),
            false => 1,
        }),
        .Ptr(pd)    => env.ut_unknown_ty(tparams, load(pd.pointee)),
        .Slice(e)   => env.ut_unknown_ty(tparams, load(e)),
        _           => 0,
    })
}
ut_unknown_tys = (env: Env, tparams: [Param], ts: [Ty]) i32 {
    acc := 0
    ts.loop((h, i, t) {
        acc = acc.kv_kor(env.ut_unknown_ty(tparams, t))
    })
    acc
}
// Params/fields/payloads/return carry no per-type source position (a `Ty` node has none), so anchor
// their unknown-type caret on the enclosing declaration's name offset (`pos`) — always located, even
// though it points at the decl name rather than the bare type token.
ut_params_kind = (env: Env, tparams: [Param], ps: [Param], pos: i32) i32 {
    acc := 0
    ps.loop((h, i, p) {
        acc = acc.kv_kor(env.ut_unknown_ty(tparams, p.ty).kv_one(KUNKNOWNTYPE()).kv_at(pos))
    })
    acc
}
ut_fields_kind = (env: Env, tparams: [Param], fs: [Field], pos: i32) i32 {
    acc := 0
    fs.loop((h, i, f) {
        acc = acc.kv_kor(env.ut_unknown_ty(tparams, f.ty).kv_one(KUNKNOWNTYPE()).kv_at(pos))
    })
    acc
}
ut_payloads_kind = (env: Env, tparams: [Param], vs: [VariantDef], pos: i32) i32 {
    acc := 0
    vs.loop((h, i, v) {
        acc = acc.kv_kor(env.ut_unknown_ty(tparams, v.payload).kv_one(KUNKNOWNTYPE()).kv_at(pos))
    })
    acc
}
// also walk the body: a LOCAL `let` with an explicit annotation (`x: Foo := e`) names a type, and an
// undefined one leaked an unknown C type just like a param/field/return would. Recurse through nested
// control flow (Block/Loop/Match/Cond) so a deeply-nested `let` annotation is checked too.
ut_arms_kind = (a: MutPtr<Malloc>, env: Env, tparams: [Param], arms: [ArmData]) i32 {
    acc := 0
    arms.loop((h, i, ar) {
        acc = acc.kv_kor(a.ut_expr_kind(env, tparams, ar.body))
    })
    acc
}
ut_expr_kind = (a: MutPtr<Malloc>, env: Env, tparams: [Param], e: Ptr<Expr>) i32 {
    load(e).match ({
        .Block(b) => a.ut_body_kind(env, tparams, b.stmts),
        .Loop(l)  => a.ut_body_kind(env, tparams, l.body),
        .Match(m) => a.ut_arms_kind(env, tparams, m.arms),
        .Cond(d)  => a.ut_expr_kind(env, tparams, d.t).kv_kor(a.ut_expr_kind(env, tparams, d.e)),
        _         => 0,
    })
}
// a LOCAL `let` annotation (`x: T := e`); tvoid means unannotated, so nothing to check.
ut_let_kind = (a: MutPtr<Malloc>, env: Env, tparams: [Param], l: LetData) i32 {
    l.ty.is_void_ty().match ({
        true  => 0,
        false => env.ut_unknown_ty(tparams, l.ty).kv_one(KUNKNOWNTYPE()).kv_at(l.pos.pos_or(load(l.value).expr_pos())),
    })
}
ut_stmt_kind = (a: MutPtr<Malloc>, env: Env, tparams: [Param], st: Stmt) i32 {
    st.match ({
        .Let(l)      => a.ut_let_kind(env, tparams, l).kv_kor(a.ut_expr_kind(env, tparams, l.value)),
        .Assign(x)   => a.ut_expr_kind(env, tparams, x.value),
        .Return(r)   => a.ut_expr_kind(env, tparams, r),
        .ExprStmt(e) => a.ut_expr_kind(env, tparams, e),
        .If(f)       => a.ut_expr_kind(env, tparams, f.c).kv_kor(a.ut_body_kind(env, tparams, f.then)).kv_kor(a.ut_body_kind(env, tparams, f.els)),
        .While(w)    => a.ut_expr_kind(env, tparams, w.c).kv_kor(a.ut_body_kind(env, tparams, w.body)),
        .IndexSet(x) => a.ut_expr_kind(env, tparams, x.value),
    })
}
ut_body_kind = (a: MutPtr<Malloc>, env: Env, tparams: [Param], body: [Stmt]) i32 {
    acc := 0
    body.loop((h, i, st) {
        acc = acc.kv_kor(a.ut_stmt_kind(env, tparams, st))
    })
    acc
}
ut_func_kind = (a: MutPtr<Malloc>, env: Env, f: Func) i32 { env.ut_params_kind(f.tparams, f.params, f.pos).kv_kor(env.ut_unknown_ty(f.tparams, f.ret).kv_one(KUNKNOWNTYPE()).kv_at(f.pos)).kv_kor(a.ut_body_kind(env, f.tparams, f.body)) }
check_module_unknown_type_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    idx := a.build_decl_index(decls)
    env := Env(
        vars: a.params_env(cv_no_params()),
        decls: decls,
        didx: idx,
        exp: tvoid(),
        a: a,
    )
    acc := 0
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DFunc(f)      => a.ut_func_kind(env, f),
            .DForeign(f)   => a.ut_func_kind(env, f),
            .DStruct(sd)   => env.ut_fields_kind(cv_no_params(), sd.fields, sd.pos),
            .DEnum(ed)     => env.ut_payloads_kind(cv_no_params(), ed.variants, ed.pos),
            .DGenStruct(g) => env.ut_fields_kind(g.tparams, g.fields, g.pos),
            .DGenEnum(g)   => env.ut_payloads_kind(g.tparams, g.variants, g.pos),
            _              => 0,
        }))
    })
    acc
}
// ── unknown-type NAME walk: the offending type's NAME, in the SAME traversal order as the kind walk ──
// A `Ty` carries no source position, so the reported caret anchors on the enclosing declaration; this
// parallel walk recovers the actual bad type name for the message. It mirrors the kind walk exactly
// (structure + order) and takes the first non-empty via desc_or, so the name it returns is the SAME
// unknown type the kind walk positioned on.
utn_ty = (env: Env, tparams: [Param], t: Ty) string_view {
    t.match ({
        .Named(n)   => (eq(n, "Self") || is_prim_width(n) || tparams.ut_has_tparam(n) || env.env_named_declared(n)).match ({
            true  => "",
            false => n,
        }),
        .Generic(g) => env.env_named_declared(g.name).match ({
            true  => env.utn_tys(tparams, g.args),
            false => g.name,
        }),
        .Ptr(pd)    => env.utn_ty(tparams, load(pd.pointee)),
        .Slice(e)   => env.utn_ty(tparams, load(e)),
        _           => "",
    })
}
utn_tys = (env: Env, tparams: [Param], ts: [Ty]) string_view {
    r := ""
    ts.loop((h, i, t) {
        r = desc_or(r, env.utn_ty(tparams, t))
    })
    r
}
utn_params = (env: Env, tparams: [Param], ps: [Param]) string_view {
    r := ""
    ps.loop((h, i, p) {
        r = desc_or(r, env.utn_ty(tparams, p.ty))
    })
    r
}
utn_fields = (env: Env, tparams: [Param], fs: [Field]) string_view {
    r := ""
    fs.loop((h, i, f) {
        r = desc_or(r, env.utn_ty(tparams, f.ty))
    })
    r
}
utn_payloads = (env: Env, tparams: [Param], vs: [VariantDef]) string_view {
    r := ""
    vs.loop((h, i, v) {
        r = desc_or(r, env.utn_ty(tparams, v.payload))
    })
    r
}
utn_arms = (a: MutPtr<Malloc>, env: Env, tparams: [Param], arms: [ArmData]) string_view {
    r := ""
    arms.loop((h, i, ar) {
        r = desc_or(r, a.utn_expr(env, tparams, ar.body))
    })
    r
}
utn_expr = (a: MutPtr<Malloc>, env: Env, tparams: [Param], e: Ptr<Expr>) string_view {
    load(e).match ({
        .Block(b) => a.utn_body(env, tparams, b.stmts),
        .Loop(l)  => a.utn_body(env, tparams, l.body),
        .Match(m) => a.utn_arms(env, tparams, m.arms),
        .Cond(d)  => desc_or(a.utn_expr(env, tparams, d.t), a.utn_expr(env, tparams, d.e)),
        _         => "",
    })
}
utn_let = (a: MutPtr<Malloc>, env: Env, tparams: [Param], l: LetData) string_view { l.ty.is_void_ty().match ({
    true  => "",
    false => env.utn_ty(tparams, l.ty),
}) }
utn_stmt = (a: MutPtr<Malloc>, env: Env, tparams: [Param], st: Stmt) string_view {
    st.match ({
        .Let(l)      => desc_or(a.utn_let(env, tparams, l), a.utn_expr(env, tparams, l.value)),
        .Assign(x)   => a.utn_expr(env, tparams, x.value),
        .Return(r)   => a.utn_expr(env, tparams, r),
        .ExprStmt(e) => a.utn_expr(env, tparams, e),
        .If(f)       => desc_or(a.utn_expr(env, tparams, f.c), desc_or(a.utn_body(env, tparams, f.then), a.utn_body(env, tparams, f.els))),
        .While(w)    => desc_or(a.utn_expr(env, tparams, w.c), a.utn_body(env, tparams, w.body)),
        .IndexSet(x) => a.utn_expr(env, tparams, x.value),
    })
}
utn_body = (a: MutPtr<Malloc>, env: Env, tparams: [Param], body: [Stmt]) string_view {
    r := ""
    body.loop((h, i, st) {
        r = desc_or(r, a.utn_stmt(env, tparams, st))
    })
    r
}
utn_func = (a: MutPtr<Malloc>, env: Env, f: Func) string_view { desc_or(env.utn_params(f.tparams, f.params), desc_or(env.utn_ty(f.tparams, f.ret), a.utn_body(env, f.tparams, f.body))) }
check_module_unknown_type_name = (a: MutPtr<Malloc>, decls: [Decl]) string_view {
    idx := a.build_decl_index(decls)
    env := Env(
        vars: a.params_env(cv_no_params()),
        decls: decls,
        didx: idx,
        exp: tvoid(),
        a: a,
    )
    r := ""
    decls.loop((h, i, d) {
        r = desc_or(r, d.match ({
            .DFunc(f)      => a.utn_func(env, f),
            .DForeign(f)   => a.utn_func(env, f),
            .DStruct(sd)   => env.utn_fields(cv_no_params(), sd.fields),
            .DEnum(ed)     => env.utn_payloads(cv_no_params(), ed.variants),
            .DGenStruct(g) => env.utn_fields(g.tparams, g.fields),
            .DGenEnum(g)   => env.utn_payloads(g.tparams, g.variants),
            _              => "",
        }))
    })
    r
}
// the unknown-type message NAMING the offending type (`unknown type name `Widget``), else the generic
// ladder message when the name walk found nothing (should not happen when the kind walk fired).
unknown_type_message = (a: MutPtr<Malloc>, nm: string_view) string_view { a.gstr_string(48).gstr_append(a, "unknown type name `").gstr_append(a, nm).gstr_append(a, "`").gstr_finish(a) }
check_module_unknown_type_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    packed := a.check_module_unknown_type_kind(decls)
    (packed == 0).then({
        return check_diagnostic_none()
    })
    d := src.check_diagnostic_from_source(packed, 1)
    nm := a.check_module_unknown_type_name(decls)
    is_empty(nm).match ({
        true  => d,
        false => CheckDiagnostic(
            code: d.code,
            kind: d.kind,
            source_offset: d.source_offset,
            span_width: d.span_width,
            count: d.count,
            message: a.unknown_type_message(nm),
            hint: d.hint,
        ),
    })
}
// ── infinite type: a struct/enum that contains ITSELF by VALUE (transitively) ──────────────────────────
// A by-value field/payload whose type is the enclosing type — directly (`Node: { next: Node }`,
// `E: A(E) | B`) or through a chain of other by-value structs/enums (mutual recursion `A: { b: B }`,
// `B: { a: A }`) — has infinite size; codegen emits a self-containing C struct and `cc` dies with the
// confusing `field '…' has incomplete type`. INDIRECTION breaks the cycle: a `Ptr<T>` / `MutPtr<T>` /
// `RawPtr<T>` (all `.Ptr`) or a `[T]` slice (`.Slice`) is a finite pointer, so the compiler's own
// recursive AST (`Ptr<Expr>`, `Ptr<Ty>`) is correctly NOT flagged. A generic instance (`.Generic`) is
// treated as cycle-breaking in the concrete pass (its monomorphized size is decided later); generic
// SELF-instantiation (`Node<T>: { next: Node<T> }`) is caught by the dedicated generic pass below.
// the by-value out-edge a member type contributes to the containment graph; "" = indirection/leaf.
inf_edge_name = (t: Ty) string_view {
    t.match ({
        .Named(n) => n,
        _         => "",
    })
}    // Ptr/Slice/Generic/primitive/FnT all break the cycle
// does the member type `t` reach `target` by value? `depth` bounds the walk (= max distinct names) so a
// cycle terminates instead of looping forever.
inf_edge_reaches = (decls: [Decl], target: string_view, t: Ty, depth: i64) bool {
    en := t.inf_edge_name()
    en.is_empty().match ({
        true  => false,
        false => eq(en, target).match ({
            true  => true,
            false => (depth <= 0).match ({
                true  => false,
                false => decls.inf_named_reaches(target, en, depth - 1),
            }),
        }),
    })
}
inf_fields_reach = (decls: [Decl], target: string_view, fields: [Field], depth: i64) bool {
    hit := false
    fields.loop((h, i, fl) {
        hit = hit.match ({ true => true, false => decls.inf_edge_reaches(target, fl.ty, depth) })
    })
    hit
}
inf_variants_reach = (decls: [Decl], target: string_view, vs: [VariantDef], depth: i64) bool {
    hit := false
    vs.loop((h, i, v) {
        hit = hit.match ({
            true  => true,
            false => decls.inf_edge_reaches(target, v.payload, depth),
        })
    })
    hit
}
// expand the named type `cur` (a struct's fields or an enum's variant payloads) and recurse.
inf_named_reaches = (decls: [Decl], target: string_view, cur: string_view, depth: i64) bool {
    decls.is_struct(cur).match ({
        true  => decls.inf_fields_reach(target, decls.struct_fields(cur), depth),
        false => decls.inf_variants_reach(target, decls.enum_variants(cur), depth),
    })
}
// generic decl: a DIRECT self-instantiation by value — a field/payload typed `Self` or `Self<…>`.
inf_gen_self = (t: Ty, name: string_view) bool {
    t.match ({
        .Named(n)   => eq(n, name),
        .Generic(g) => eq(g.name, name),
        _           => false,
    })
}
inf_gen_fields = (fields: [Field], name: string_view) bool {
    f := false
    fields.loop((h, i, fl) {
        f = fl.ty.inf_gen_self(name).match ({ true => true, false => f })
    })
    f
}
inf_gen_variants = (vs: [VariantDef], name: string_view) bool {
    f := false
    vs.loop((h, i, v) {
        f = v.payload.inf_gen_self(name).match ({ true => true, false => f })
    })
    f
}
check_module_infinite_type_kind* = (decls: [Decl]) i32 {
    acc := 0
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DStruct(sd)   => decls.inf_named_reaches(sd.name, sd.name, decls.len).match ({
                true  => KINFINITETYPE().kv_at(sd.pos),
                false => 0,
            }),
            .DEnum(ed)     => decls.inf_named_reaches(ed.name, ed.name, decls.len).match ({
                true  => KINFINITETYPE().kv_at(ed.pos),
                false => 0,
            }),
            .DGenStruct(g) => g.fields.inf_gen_fields(g.name).match ({
                true  => KINFINITETYPE().kv_at(g.pos),
                false => 0,
            }),
            .DGenEnum(g)   => g.variants.inf_gen_variants(g.name).match ({
                true  => KINFINITETYPE().kv_at(g.pos),
                false => 0,
            }),
            _              => 0,
        }))
    })
    acc
}
check_module_infinite_type_diagnostic_from_source* = (decls: [Decl], src: string_view) CheckDiagnostic {
    packed := decls.check_module_infinite_type_kind()
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => src.check_diagnostic_from_source(packed, 1),
    })
}
// ── main signature: `main` is `() i32` OR `(sys: Sys) i32` (KMAINPARAMS) ──────────────────────────
// The OS entry (zenrt.c) calls the emitted `zen_main()` with NO arguments. Two legal shapes:
//   `main = () i32`         — niladic; the C boundary calls it directly.
//   `main = (sys: Sys) i32` — the capability entry; genc_emit renames it and emits a niladic `zen_main`
//                             trampoline that feeds it `std.sys.root()` (see genc_emit.gen_func). The C
//                             boundary stays niladic, so no parameter ever reads garbage.
// Any OTHER parameter shape (2+ params, or a single non-`Sys` param) still compiled clean and then read
// GARBAGE for the declared parameters — undefined behavior behind a green build — so it stays rejected.
// The accepted `(sys: Sys)` form must carry exactly one parameter whose type is the record `Sys`.
main_param_is_sys = (f: Func) bool {
    (f.params.len == 1).match ({
        true  => f.params[0].ty.match ({
            .Named(nm) => eq(nm, "Sys"),
            _          => false,
        }),
        false => false,
    })
}
main_params_kind = (decls: [Decl]) i32 {
    k := 0
    decls.loop((h, i, d) {
        k = (k == 0).match ({
            true  => d.match ({
                .DFunc(f) => (eq(f.name, "main") && f.params.len > 0).match ({
                    true  => f.main_param_is_sys().match ({
                        true  => 0,
                        false => KMAINPARAMS().kv_at(f.pos),
                    }),
                    false => 0,
                }),
                _         => 0,
            }),
            false => k,
        })
    })
    k
}
check_module_main_diagnostic_from_source* = (decls: [Decl], src: string_view) CheckDiagnostic {
    packed := decls.main_params_kind()
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => src.check_diagnostic_from_source(packed, 1),
    })
}
// ── reserved-name: a top-level fn redefining a compiler intrinsic (KRESERVEDNAME) ──────────────────
// Call emission dispatches on the NAME (genc call_kind / is_intrinsic), so a user top-level
// `load = (x: i64) i64 { … }` never receives its calls: `load(41)` still compiles to the intrinsic
// pointer deref — a miscompile behind a green check (a cc error at best, a wrong value or a
// segfault at runtime at worst). Locals and params that shadow intrinsics are already sound
// (shadows_toplevel routes their calls through the local, #370/#377), struct/impl methods are
// hoisted under mangled `impl_…` names, and FOREIGN decls stay allowed (std.mem.alloc re-declares
// `malloc`/`free` as bodyless prototypes) — so the reject is scoped to BODIED top-level DFuncs,
// the one shape whose calls are unwinnably captured by the intrinsic.
KRESERVEDNAME = () i32 { 36 }    // a top-level fn named after a compiler intrinsic (its calls would hit the intrinsic). CUSTOM channel (own struct), NOT the diag_info ladder — unique code, was 31 (collided with KARMVOID)
reserved_name_kind = (decls: [Decl]) i32 {
    acc := 0
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DFunc(f) => f.name.is_intrinsic().match ({
                true  => KRESERVEDNAME().kv_at(f.pos),
                false => 0,
            }),
            _         => 0,
        }))
    })
    acc
}
// the offending fn's NAME, straight off the first colliding decl — exact even when its pos is 0
// (a decl at byte 0 packs as "no position", so a source-copy subject would truncate).
reserved_name_of = (decls: [Decl]) string_view {
    n := ""
    decls.loop((h, i, d) {
        n = is_empty(n).match ({
            true  => d.match ({
                .DFunc(f) => f.name.is_intrinsic().match ({ true => f.name, false => "" }),
                _         => "",
            }),
            false => n,
        })
    })
    n
}
check_module_reserved_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    packed := decls.reserved_name_kind()
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => {
            pos := packed >> 6
            w := src.diagnostic_span_width(pos)
            subject := a.gstr_string(32).gstr_append(a, "`").gstr_append(a, decls.reserved_name_of()).gstr_append(a, "`").gstr_finish(a)
            CheckDiagnostic(
                code: packed & 63,
                kind: "reserved-name",
                source_offset: pos,
                span_width: w,
                count: 1,
                message: a.gstr_string(192).gstr_append(a, subject).gstr_append(a, " is a compiler intrinsic; a top-level function may not redefine it — calls would compile to the intrinsic, not this function").gstr_finish(a),
                hint: a.gstr_string(64).gstr_append(a, "rename — ").gstr_append(a, subject).gstr_append(a, " is a compiler intrinsic").gstr_finish(a),
            )
        },
    })
}
// ── must-use: a DISCARDED value-mold ((Self,…) Self) self-mutation (Stage-2 A.1) ───────────────────────
// A value-mold CONTAINER method (`Map.put`, `Set.add`, … — shape `(Self, …) Self`) RETURNS the updated
// container and INVALIDATES the receiver: a grow reallocs the backing buffer, so the input header is left
// dangling. Discarding the result in statement position — `m.put(a, k, v)` as a bare statement, then
// `m.get(...)` — segfaults while `check` says ok (the #1 trust-killer for a newcomer). This driver-only
// pass runs on the RAW pre-inline decls (where the call is still a MethodCall; by check_module time the
// generic method is INLINED away) and rejects such a discard with KMUSTUSE.
//
// Scope chosen to be SAFE against the pervasive free-function builder pattern (`s = s.gen_x(…)` threads a
// `String` accumulator — those are FREE functions, never inherent methods, so they are untouched):
//   • only INHERENT struct methods (declared inside a struct body) count, and only when EVERY inherent
//     method of that name is value-mold (an ambiguous name shared with a non-value-mold method is skipped);
//   • only NON-TAIL statements are flagged — a body's last expression is its produced VALUE, not a discard,
//     so a value-mold method used as a return value / match-arm value / fluent-chain tail is never flagged.
mu_ty_is_container = (t: Ty) bool {
    t.match ({
        .Named(n)   => true,
        .Generic(g) => true,
        _           => false,
    })
}
// does `ret` hand back the (possibly realloc'd) container `p0`? Two spellings: plain `(Self, …) Self`,
// and the Result-always mold `(Self, …) Result<Self, E>` (Map.put/append/grow return the updated
// container in the Ok payload — the receiver header is invalidated all the same, so a discard is
// exactly as dangerous).
mu_ret_is_self = (ret: Ty, p0: Ty) bool {
    ret.match ({
        .Generic(g) => eq(g.name, "Result").match ({
            true  => g.args.len >= 1 && g.args[0].mu_ty_is_container() && eq(g.args[0].recv_name(), p0.recv_name()),
            false => eq(ret.recv_name(), p0.recv_name()),
        }),
        _           => eq(ret.recv_name(), p0.recv_name()),
    })
}
// the `(Self, …) Self` / `(Self, …) Result<Self, E>` shape: first param and (Ok-unwrapped) return are
// the SAME non-pointer, non-primitive type.
mu_is_value_mold = (f: Func) bool {
    (f.params.len == 0).match ({
        true  => false,
        false => {
            p0 := f.params[0].ty
            (p0.mu_ty_is_container() && f.ret.mu_ty_is_container()).match ({
                true  => f.ret.mu_ret_is_self(p0),
                false => false,
            })
        },
    })
}
// the hoisted inherent func `impl_<Ty>_<Ty>_<m>` (fill_inherent_methods), looked up O(1) via the index.
mu_func_value_mold = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, ty: string_view, m: string_view) bool {
    cname := a.impl_cname_in(ty, ty, m)
    i := idx.func_idx.get(cname, 0 - 1)
    (i >= 0 && i < decls.len).match ({
        true  => decls[i].match ({
            .DFunc(f) => f.mu_is_value_mold(),
            _         => false,
        }),
        false => false,
    })
}
// fold one inherent-struct impl's methods into the name→state map (0 unseen, 1 value-mold-only, 2 tainted).
mu_index_methods = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, m: Map<i64>, ty: string_view, methods: [Param], j: i32) Map<i64> {
    (j >= methods.len).match ({
        true  => m,
        false => {
            p := methods[j]
            vm := a.mu_func_value_mold(decls, idx, ty, p.name)
            prev := m.get(p.name, 0)
            next: i64 := vm.match ({
                true  => (prev == 0).match ({
                    true  => 1,
                    false => (prev == 1).match ({ true => 1, false => 2 }),
                }),
                false => 2,
            })
            a.mu_index_methods(decls, idx, m.put(a, p.name, next).expect("check: method-mold index alloc"), ty, methods, j + 1)
        },
    })
}
mu_index_impl = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, m: Map<i64>, im: ImplData) Map<i64> {
    eq(im.ty, im.trname).match ({
        true  => a.mu_index_methods(decls, idx, m, im.ty, im.methods, 0),
        false => m,
    })
}
// method name → 1 iff it is an inherent method AND value-mold on EVERY struct that declares it.
mu_build_index = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex) Map<i64> {
    seed: i64 := 0 - 1
    m := of(a, "", seed).expect("check: method-mold index alloc")
    decls.loop((h, i, d) {
        m = d.match ({
            .DImpl(im) => a.mu_index_impl(decls, idx, m, im),
            _          => m,
        })
    })
    m
}
// flag a discarded MethodCall to a safe-to-flag value-mold inherent method.
// In the normal parse, UFCS `recv.m(args)` lowers to a flat `Call(fn: m, args: [recv] ++ args)` whose
// `fn` is the SIMPLE method name — exactly the index key. (The faithful MethodCall form is fmt-only, but
// match it too for safety.) Flag a discarded call whose callee is a safe-to-flag value-mold method.
// the value-mold DANGER is reusing a STALE NAMED LOCAL after a discarded self-mutation (`m.put(...)`
// then `m.get(...)`). A fresh FLUENT CHAIN (`put("x=").i(3).nl()` — receiver is itself a call, not a
// reused binding) carries no stale-local risk, so it must NOT be flagged (else builder APIs break).
// Gate: only flag when the receiver (first arg / recv) is a bare Var.
mu_is_var = (e: Expr) bool {
    e.match ({
        .Var(v) => true,
        _       => false,
    })
}
mu_call_kind = (mvm: Map<i64>, e: Ptr<Expr>) i32 {
    load(e).match ({
        .Call(c)        => (mvm.get(c.fn, 0) == 1 && c.args.len > 0 && mu_is_var(c.args[0])).match ({
            true  => KMUSTUSE().kv_at(c.pos),
            false => 0,
        }),
        .MethodCall(mc) => (mvm.get(mc.method, 0) == 1 && mu_is_var(load(mc.recv))).match ({
            true  => KMUSTUSE().kv_at(mc.pos),
            false => 0,
        }),
        _               => 0,
    })
}
mu_arms_kind = (a: MutPtr<Malloc>, mvm: Map<i64>, arms: [ArmData]) i32 {
    acc := 0
    arms.loop((h, i, ar) {
        acc = acc.kv_kor(a.mu_expr_kind(mvm, ar.body))
    })    // arm body = the arm's VALUE (tail)
    acc
}
// recurse into nested control-flow whose bodies can hold discarded statements.
mu_expr_kind = (a: MutPtr<Malloc>, mvm: Map<i64>, e: Ptr<Expr>) i32 {
    load(e).match ({
        .Block(b) => a.mu_body_kind(mvm, b.stmts),
        .Loop(l)  => a.mu_body_kind(mvm, l.body),
        .Match(m) => a.mu_arms_kind(mvm, m.arms),
        .Cond(d)  => a.mu_expr_kind(mvm, d.t).kv_kor(a.mu_expr_kind(mvm, d.e)),
        _         => 0,
    })
}
// an ExprStmt: flag a discarded value-mold call when NOT in tail position, and always recurse for nested
// discards. (Extracted so the nested `is_tail.match(...)` is a plain statement, not a chained arm body.)
mu_exprstmt_kind = (a: MutPtr<Malloc>, mvm: Map<i64>, e: Ptr<Expr>, is_tail: bool) i32 {
    head := is_tail.match ({ true => 0, false => mvm.mu_call_kind(e) })
    head.kv_kor(a.mu_expr_kind(mvm, e))
}
mu_stmt_kind = (a: MutPtr<Malloc>, mvm: Map<i64>, st: Stmt, is_tail: bool) i32 {
    st.match ({
        .ExprStmt(e) => a.mu_exprstmt_kind(mvm, e, is_tail),
        .Let(l)      => a.mu_expr_kind(mvm, l.value),
        .Assign(x)   => a.mu_expr_kind(mvm, x.value),
        .Return(r)   => a.mu_expr_kind(mvm, r),
        .If(f)       => a.mu_body_kind(mvm, f.then).kv_kor(a.mu_body_kind(mvm, f.els)),
        .While(w)    => a.mu_body_kind(mvm, w.body),
        .IndexSet(x) => a.mu_expr_kind(mvm, x.value),
    })
}
// the body's LAST statement is its produced value (tail) — never a discard; every earlier ExprStmt is.
mu_body_kind = (a: MutPtr<Malloc>, mvm: Map<i64>, body: [Stmt]) i32 {
    acc := 0
    n := body.len
    body.loop((h, i, st) {
        acc = acc.kv_kor(a.mu_stmt_kind(mvm, st, i == n - 1))
    })
    acc
}
check_module_mustuse_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    idx := a.build_decl_index(decls)
    mvm := a.mu_build_index(decls, idx)
    acc := 0
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DFunc(f) => a.mu_body_kind(mvm, f.body),
            _         => 0,
        }))
    })
    acc
}
check_module_mustuse_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    packed := a.check_module_mustuse_kind(decls)
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => src.check_diagnostic_from_source(packed, 1),
    })
}
// trait conformance, kind-flavoured (mirrors impl_errs/trait_conformance/method_err).
kv_method_kind = (a: MutPtr<Malloc>, decls: [Decl], im: ImplData, f: Field) i32 { a.method_err(decls, im, f).kv_one(KCONFORMANCE()) }
kv_conformance_kind = (a: MutPtr<Malloc>, decls: [Decl], im: ImplData, sd: StructDecl) i32 {
    acc := 0
    sd.fields.loop((h, i, f) {
        acc = acc.kv_kor(a.kv_method_kind(decls, im, f))
    })
    acc
}
kv_impl_kind = (a: MutPtr<Malloc>, decls: [Decl], im: ImplData) i32 {
    acc := 0
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DStruct(sd) => eq(sd.name, im.trname).match ({
                true  => a.kv_conformance_kind(decls, im, sd),
                false => 0,
            }),
            _            => 0,
        }))
    })
    acc.kv_at(im.pos)
}
// dup-fn, position-carrying: the FIRST duplicated fn name, anchored at the LATER definition's name
// offset (the earlier definition is the established binding), so the driver renders file:line:col +
// a caret at the colliding definition — even when it lives in an imported module (pick_render maps
// the flat offset to whichever module's source contains it). pos 0 (synthesized) degrades to the
// bare kind, exactly the pre-position behavior.
kv_dup_name_kind = (decls: [Decl]) i32 {
    acc := 0
    decls.loop((h, i, d) {
        nm := d.fn_name_of()
        dup := is_empty(nm).match ({ true => false, false => decls.fn_dup_before(nm, i) })
        acc = acc.kv_kor(dup.match ({ true => KDUPFN().kv_at(d.fn_pos_of()), false => 0 }))
    })
    acc
}
// Return the first packed diagnostic from the same collector used by batch mode. A one-slot sink
// preserves first-error behavior without maintaining a second module/function traversal.
check_module_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    buf: [i32] := slice(a.acquire(sizeof(i32)), 1)
    cnt := a.check_module_kind_all(decls, buf, 0)
    (cnt == 0).match ({ true => 0, false => buf[0] })
}
// ── BATCH diagnostics (report ALL type errors, not just the first) ──────────────────────────────
// Append each unit's first error into a fixed-cap packed buffer, recovering at natural boundaries — one error per
// top-level statement inside a function, then per decl across the module. The inner recursion is
// unchanged (still first-error within a statement / expression), so a single root cause never
// cascades: after a statement errs we resume at the next statement, after a decl at the next decl.
// Consumers unpack each entry with the same `& 63` / `>> 6` scheme (check_diagnostic_from_source).
KDIAG_CAP = () i32 { 512 }
kdiag_buf = (a: MutPtr<Malloc>) [i32] { slice(a.acquire(KDIAG_CAP() * sizeof(i32)), KDIAG_CAP()) }
// already collected? (dedup: two channels can position the same packed kind at one site)
kdiag_seen = (buf: [i32], cnt: i32, packed: i32) bool {
    found := false
    buf.loop((h, i, e) {
        found = (i < cnt).match ({
            true  => (e == packed).match ({ true => true, false => found }),
            false => found,
        })
    })
    found
}
// append `packed` unless it is 0 (no error), a duplicate, or the buffer is full; return the new count.
kdiag_add = (buf: [i32], cnt: i32, packed: i32) i32 {
    (packed == 0 || cnt >= buf.len || buf.kdiag_seen(cnt, packed)).match ({
        true  => cnt,
        false => {
            buf[cnt] = packed
            cnt + 1
        },
    })
}
// One function's errors, per top-level statement. The trailing-value check is anchored on the fn name.
kv_check_func_kind_all = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, f: Func, buf: [i32], cnt: i32) i32 {
    env := Env(
        vars: a.bind_tparams(a.params_env(f.params), f.tparams),
        decls: decls,
        didx: idx,
        exp: f.ret,
        a: a,
    )
    c := cnt
    e := env
    f.body.loop((h, i, st) {
        c = buf.kdiag_add(c, a.kv_check_stmt_kind(e, st))
        e = a.extend_env(e, st)
    })
    buf.kdiag_add(c, env.kv_trailing_kind(f.body).kv_at(f.pos))
}
// every main-channel error in the module, in traversal order: dup-fn names, then each decl (per
// statement for functions, one each for impls / parse sentinels). `cnt` seeds the running count.
check_module_kind_all = (a: MutPtr<Malloc>, decls: [Decl], buf: [i32], cnt: i32) i32 {
    idx := a.build_decl_index(decls)
    c := buf.kdiag_add(cnt, decls.kv_dup_name_kind())
    decls.loop((h, i, d) {
        c = d.match ({
            .DFunc(f)   => a.kv_check_func_kind_all(decls, idx, f, buf, c),
            .DImpl(im)  => buf.kdiag_add(c, a.kv_impl_kind(decls, im)),
            .DGlobal(g) => buf.kdiag_add(c, parse_sentinel_kind(g.name, g.init)),
            _           => c,
        })
    })
    c
}
// the batch as source-positioned CheckDiagnostics (count 1 each — the "(+K more)" trailer is the
// driver's, printed once after the cap). An empty slice means the main channel is clean.
check_module_batch* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) [CheckDiagnostic] {
    buf := a.kdiag_buf()
    cnt := a.check_module_kind_all(decls, buf, 0)
    out := slice(a.acquire(to_i64(cnt) * sizeof(CheckDiagnostic)), to_i64(cnt))
    buf.loop((h, i, p) {
        (i < to_i64(cnt)).then({
            out[i] = src.check_diagnostic_from_source(p, 1)
        })
    })
    out
}
// the parse-sentinel diagnostic ALONE (KPARSE/KVBREAK from __syntax_error; none if the module
// parsed cleanly): the driver reports it FIRST — a syntax error precedes (and usually CAUSES) any
// downstream type error in the same module, so it must not be shadowed by one.
check_module_parse_kind* = (decls: [Decl]) i32 {
    acc := 0
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DGlobal(g) => parse_sentinel_kind(g.name, g.init),
            _           => 0,
        }))
    })
    acc
}
check_module_parse_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    packed := decls.check_module_parse_kind()
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => src.check_diagnostic_from_source(packed, 1),
    })
}
// the __syntax_error sentinel carries the failing token's byte offset in its Int init value (0 = none);
// the Int passes through resolve unchanged (`_ => e`), so the offset survives to this post-resolve pass.
kparse_off = (init: Ptr<Expr>) i32 {
    load(init).match ({
        .Int(n) => n.to_i32(),
        _       => 0,
    })
}
// a NEGATIVE sentinel offset (parse.fill_decls) marks the variant-break split: the failing token is
// the `.` of a newline+`.Uppercase` statement break, so report the rule (KVBREAK) at that dot.
kparse_kind = (init: Ptr<Expr>) i32 {
    off := init.kparse_off()
    (off < 0).match ({ true => KVBREAK().kv_at(0 - off), false => KPARSE().kv_at(off) })
}
// the `__bad_binding` sentinel: a malformed top-level `=` binding, caret at its RHS offset (always ≥ 0).
kbadbind_kind = (init: Ptr<Expr>) i32 { KBADBIND().kv_at(init.kparse_off()) }
// packed kind for whichever parse sentinel a top-level DGlobal is (0 if it is an ordinary global).
parse_sentinel_kind = (nm: string_view, init: Ptr<Expr>) i32 {
    eq(nm, "__syntax_error").match ({
        true  => init.kparse_kind(),
        false => eq(nm, "__bad_binding").match ({ true => init.kbadbind_kind(), false => 0 }),
    })
}
check_module_diagnostic* = (a: MutPtr<Malloc>, decls: [Decl]) CheckDiagnostic {
    packed := a.check_module_kind(decls)
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => check_diagnostic_from_packed(packed, 1),
    })
}
check_module_ownership_diagnostic* = (a: MutPtr<Malloc>, decls: [Decl]) CheckDiagnostic {
    packed := a.check_module_ownership_kind(decls)
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => check_diagnostic_from_packed(packed, 1),
    })
}
check_module_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    packed := a.check_module_kind(decls)
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => src.check_diagnostic_from_source(packed, 1),
    })
}
check_module_ownership_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    packed := a.check_module_ownership_kind(decls)
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => src.check_diagnostic_from_source(packed, 1),
    })
}
module_diagnostic* = (a: MutPtr<Malloc>, decls: [Decl]) Diagnostic { a.check_module_diagnostic(decls).check_to_diagnostic() }
module_ownership_diagnostic* = (a: MutPtr<Malloc>, decls: [Decl]) Diagnostic { a.check_module_ownership_diagnostic(decls).check_to_diagnostic() }
module_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) Diagnostic { a.check_module_diagnostic_from_source(decls, src).check_to_diagnostic() }
module_ownership_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) Diagnostic { a.check_module_ownership_diagnostic_from_source(decls, src).check_to_diagnostic() }
// the kind layer over a CROSS-MODULE link (mirrors check_linked): same layered header, then
// check_module_kind instead of check_module. Lets a cross-module reject also be pinned by KIND.
check_linked_kind* = (a: MutPtr<Malloc>, decls: [Decl], lib: [Decl]) i32 {
    hdr := a.module_header(lib)
    rfile := a.resolve_module(decls)
    world := a.dbuf(hdr.len + rfile.len)
    hdr.loop((h, i, d) {
        world[i] = d
    })
    rfile.loop((h, i, d) {
        world[hdr.len + i] = d
    })
    a.check_module_kind(world)
}
// ── cross-module linking (Goal Arc 1) ───────────────────────────────────────────────
// The self-hosted "module loader". A module's HEADER is its public surface reduced to signatures:
// every function becomes a bodyless DForeign (structs/enums pass through). Checking a file against
// another module's header puts the imported names in `the_func`'s reach, so a cross-module call is
// arity/arg-type-checked exactly like a local one — while the header's bodyless sigs are never
// re-checked (check_module only descends DFunc bodies). A name imported but absent from the header
// stays known-but-unchecked (the #204 DImport path), so partial headers never false-reject.
as_sig = (a: MutPtr<Malloc>, d: Decl) Decl {
    d.match ({
        .DFunc(f) => dforeign(Func(
            name: f.name,
            params: f.params,
            ret: f.ret,
            tparams: f.tparams,
            body: no_stmts(),
        )),
        _         => d,
    })
}
module_header* = (a: MutPtr<Malloc>, decls: [Decl]) [Decl] {
    buf := a.dbuf(decls.len)
    decls.loop((h, i, d) {
        buf[i] = a.as_sig(d)
    })
    buf
}
// check `decls` (one file) against an imported module's `lib` decls: the file is resolved as usual,
// then checked in a WORLD that prepends lib's header, so its imported calls resolve to real sigs.
check_linked* = (a: MutPtr<Malloc>, decls: [Decl], lib: [Decl]) i32 {
    hdr := a.module_header(lib)
    rfile := a.resolve_module(decls)
    world := a.dbuf(hdr.len + rfile.len)
    hdr.loop((h, i, d) {
        world[i] = d
    })
    rfile.loop((h, i, d) {
        world[hdr.len + i] = d
    })
    a.check_module(world)
}
// ════════════════════════════════════════════════════════════════════════════════════════
// ── M5: LEXICAL SCOPE-ESCAPE CHECK ──────────────────────────────────────────────────────
// A parameter `s: MutPtr<Scope<…>>` is a SCOPE RECEIVER. Memory it hands out via `s.acquire(…)`
// lives in the scope's arena, which `with_sync`/`with_async` FREE on exit — so RETURNING such a
// pointer (or a local bound to it) past the scope compiles a use-after-free. Scopes are lexical, so a
// lexical rule suffices: collect the scope-receiver params, track locals bound to a scope-derived
// pointer (`p := s.acquire(…)` / `p := s.alloc.acquire(…)` / `p := s.alloc`), and REJECT a
// `return <that>` / a trailing `<that>` where `<that>` is such a local OR a direct `s.acquire(…)`.
// The direct form deliberately excludes Scope's own `s.alloc.acquire(n)` accessor (its receiver is the
// `.alloc` field, not the scope var), so std.scope's primitives are never false-rejected.
KESCAPE = () i32 { 33 }    // CUSTOM channel: reported via its own diagnostic (own kind/message/hint), never kv_at, never the diag_info ladder. Unique code, was 16 (collided with KTRAITBOUND)
is_scope_param_ty = (t: Ty) bool {
    t.match ({
        .Ptr(pd) => load(pd.pointee).match ({
            .Generic(g) => eq(g.name, "Scope"),
            _           => false,
        }),
        _        => false,
    })
}
scope_params = (a: MutPtr<Malloc>, params: [Param]) Ptr<DeadList> {
    out := a.dead_nil()
    params.loop((h, i, p) {
        p.ty.is_scope_param_ty().then({
            out = a.dead_cons(p.name, out)
        })
    })
    out
}
// the root Var name of a member/arrow chain (`s.alloc` -> "s"); "" if not rooted at a plain Var.
expr_root_var = (e: Ptr<Expr>) string_view {
    load(e).match ({
        .Var(v)    => v.name,
        .Member(m) => m.obj.expr_root_var(),
        .Arrow(ar) => ar.obj.expr_root_var(),
        _          => "",
    })
}
// a call `acquire(recv, …)` whose receiver chain is rooted at a scope var (covers `s.acquire` and
// `s.alloc.acquire`). Used only to MARK a local binding as scope-derived (returning the local is the
// hazard; Scope.acquire itself never binds a local).
is_scope_acquire = (svars: Ptr<DeadList>, e: Ptr<Expr>) bool {
    load(e).match ({
        .Call(c) => (eq(c.fn, "acquire") && c.args.len > 0).match ({
            true  => svars.dead_has(c.args[0].addr().expr_root_var()),
            false => false,
        }),
        _        => false,
    })
}
// the DIRECT hazard `s.acquire(…)`: a UFCS acquire whose FIRST ARG IS the scope var itself (a bare
// Var), NOT `s.alloc.acquire(…)` (whose first arg is the `.alloc` member — Scope's legit accessor).
is_direct_scope_acquire = (svars: Ptr<DeadList>, e: Ptr<Expr>) bool {
    load(e).match ({
        .Call(c) => (eq(c.fn, "acquire") && c.args.len > 0).match ({
            true  => c.args[0].match ({
                .Var(v) => svars.dead_has(v.name),
                _       => false,
            }),
            false => false,
        }),
        _        => false,
    })
}
// `s.alloc` — the raw allocator field of a scope var (also escapes the scope if returned).
is_scope_alloc_member = (svars: Ptr<DeadList>, e: Ptr<Expr>) bool {
    load(e).match ({
        .Member(m) => eq(m.field, "alloc") && svars.dead_has(m.obj.expr_root_var()),
        _          => false,
    })
}
let_is_scope_derived = (svars: Ptr<DeadList>, e: Ptr<Expr>) bool { svars.is_scope_acquire(e) || svars.is_scope_alloc_member(e) }
// aliasing laundering: a value that IS an already-derived local — a bare Var, or a member/arrow chain
// rooted at one — so `q := p` / `q := p.f` taints `q` once `p` is derived.
expr_is_derived = (derived: Ptr<DeadList>, e: Ptr<Expr>) bool {
    load(e).match ({
        .Var(v)    => derived.dead_has(v.name),
        .Member(m) => derived.dead_has(m.obj.expr_root_var()),
        .Arrow(ar) => derived.dead_has(ar.obj.expr_root_var()),
        _          => false,
    })
}
// a `let` value that becomes a derived local: a scope acquire / `s.alloc` field, OR an alias of one.
let_taints = (svars: Ptr<DeadList>, derived: Ptr<DeadList>, e: Ptr<Expr>) bool { svars.let_is_scope_derived(e) || derived.expr_is_derived(e) }
// VALUE-position escape: a returned/trailing expr lets a scope value out when it IS a direct
// `s.acquire(…)`, the raw `s.alloc` field, a derived local, OR forwards one through a struct literal,
// a match arm value, a cond branch, or a block's value. Call ARGS are deliberately NOT walked — passing
// a scope pointer into a callee that returns a COPY (`to_i32(load_i64(p))`) does not escape.
expr_escapes = (a: MutPtr<Malloc>, svars: Ptr<DeadList>, derived: Ptr<DeadList>, e: Ptr<Expr>) bool {
    (svars.is_direct_scope_acquire(e) || svars.is_scope_alloc_member(e)).match ({
        true  => true,
        false => load(e).match ({
            .Var(v)        => derived.dead_has(v.name),
            .MakeStruct(s) => a.inits_escape(svars, derived, s.inits),
            .Match(m)      => a.arms_escape(svars, derived, m.arms),
            .Cond(d)       => a.expr_escapes(svars, derived, d.t) || a.expr_escapes(svars, derived, d.e),
            .Block(b)      => a.block_val_escapes(svars, derived, b.stmts),
            .Loop(l)       => a.loop_val_escapes(svars, derived, l.body),
            _              => false,
        }),
    })
}
// a loop in VALUE position: it never yields its trailing value, but a `return` inside its body
// still escapes to the caller, so walk returns only (mirrors the statement-side .Loop handling).
loop_val_escapes = (a: MutPtr<Malloc>, svars: Ptr<DeadList>, derived: Ptr<DeadList>, stmts: [Stmt]) bool {
    f := false
    d := derived
    stmts.loop((h, i, st) {
        st.match ({
            .Return(r) => {
                f = a.expr_escapes(svars, d, r).match ({ true => true, false => f })
            },
            _          => { },
        })
        d = a.escape_step(svars, d, st)
    })
    f
}
inits_escape = (a: MutPtr<Malloc>, svars: Ptr<DeadList>, derived: Ptr<DeadList>, inits: [FieldInit]) bool {
    f := false
    inits.loop((h, i, fi) {
        f = a.expr_escapes(svars, derived, fi.value).match ({ true => true, false => f })
    })
    f
}
arms_escape = (a: MutPtr<Malloc>, svars: Ptr<DeadList>, derived: Ptr<DeadList>, arms: [ArmData]) bool {
    f := false
    arms.loop((h, i, ar) {
        f = a.expr_escapes(svars, derived, ar.body).match ({ true => true, false => f })
    })
    f
}
// a block in VALUE position: its trailing value, or any `return` inside it, may escape (lets thread).
block_val_escapes = (a: MutPtr<Malloc>, svars: Ptr<DeadList>, derived: Ptr<DeadList>, stmts: [Stmt]) bool {
    f := false
    d := derived
    stmts.loop((h, i, st) {
        st.match ({
            .Return(r)   => {
                f = a.expr_escapes(svars, d, r).match ({ true => true, false => f })
            },
            .ExprStmt(e) => (i == stmts.len - 1).then({
                f = a.expr_escapes(svars, d, e).match ({ true => true, false => f })
            }),
            _            => { },
        })
        d = a.escape_step(svars, d, st)
    })
    f
}
// thread the derived-local set across a `let` (now including aliases of derived locals).
escape_step = (a: MutPtr<Malloc>, svars: Ptr<DeadList>, derived: Ptr<DeadList>, st: Stmt) Ptr<DeadList> {
    out := derived
    st.match ({
        .Let(l) => svars.let_taints(derived, l.value).then({
            out = a.dead_cons(l.name, derived)
        }),
        _       => { },
    })
    out
}
// Authoritative kind/position pass: the source offset of the FIRST escaping return/trailing
// (0 = none). Statement-position arms inspect returns only; their trailing values are discarded.
kv_escape_stmts = (a: MutPtr<Malloc>, svars: Ptr<DeadList>, derived: Ptr<DeadList>, body: [Stmt]) i32 {
    acc := 0
    d := derived
    body.loop((h, i, st) {
        acc = acc.kv_kor(a.kv_escape_stmt(svars, d, st))
        d = a.escape_step(svars, d, st)
    })
    acc
}
kv_escape_stmt = (a: MutPtr<Malloc>, svars: Ptr<DeadList>, derived: Ptr<DeadList>, st: Stmt) i32 {
    st.match ({
        .Return(r)   => a.expr_escapes(svars, derived, r).match ({
            true  => load(r).expr_pos().pos_or(1),
            false => 0,
        }),
        .If(f)       => a.kv_escape_stmts(svars, derived, f.then).kv_kor(a.kv_escape_stmts(svars, derived, f.els)),
        .While(w)    => a.kv_escape_stmts(svars, derived, w.body),
        .ExprStmt(e) => a.kv_escape_expr_stmt(svars, derived, e),
        _            => 0,
    })
}
kv_escape_expr_stmt = (a: MutPtr<Malloc>, svars: Ptr<DeadList>, derived: Ptr<DeadList>, e: Ptr<Expr>) i32 {
    load(e).match ({
        .Match(m) => a.kv_escape_arms(svars, derived, m.arms),
        .Cond(d)  => a.kv_escape_expr_stmt(svars, derived, d.t).kv_kor(a.kv_escape_expr_stmt(svars, derived, d.e)),
        .Block(b) => a.kv_escape_stmts(svars, derived, b.stmts),
        .Loop(l)  => a.kv_escape_stmts(svars, derived, l.body),
        _         => 0,
    })
}
kv_escape_arms = (a: MutPtr<Malloc>, svars: Ptr<DeadList>, derived: Ptr<DeadList>, arms: [ArmData]) i32 {
    acc := 0
    arms.loop((h, i, ar) {
        acc = acc.kv_kor(a.kv_escape_arm(svars, derived, ar.body))
    })
    acc
}
kv_escape_arm = (a: MutPtr<Malloc>, svars: Ptr<DeadList>, derived: Ptr<DeadList>, body: Ptr<Expr>) i32 {
    load(body).match ({
        .Block(b) => a.kv_escape_stmts(svars, derived, b.stmts),
        _         => 0,
    })
}
kv_escape_trailing = (a: MutPtr<Malloc>, svars: Ptr<DeadList>, derived: Ptr<DeadList>, st: Stmt) i32 {
    st.match ({
        .ExprStmt(e) => a.expr_escapes(svars, derived, e).match ({
            true  => load(e).expr_pos().pos_or(1),
            false => 0,
        }),
        _            => 0,
    })
}
kv_escape_body = (a: MutPtr<Malloc>, svars: Ptr<DeadList>, derived: Ptr<DeadList>, body: [Stmt]) i32 {
    acc := 0
    d := derived
    body.loop((h, i, st) {
        acc = acc.kv_kor(a.kv_escape_stmt(svars, d, st))
        d = a.escape_step(svars, d, st)
    })
    acc.kv_kor((body.len == 0).match ({
        true  => 0,
        false => a.kv_escape_trailing(svars, d, body[body.len - 1]),
    }))
}
kv_escape_check_func = (a: MutPtr<Malloc>, f: Func) i32 {
    svars := a.scope_params(f.params)
    svars.match ({
        .DeadNil     => 0,
        .DeadCons(c) => a.kv_escape_body(svars, a.dead_nil(), f.body),
    })
}
check_module_escape_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    acc := 0
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DFunc(f) => a.kv_escape_check_func(f),
            _         => 0,
        }))
    })
    acc
}
// Compatibility verdict. The positioned traversal above is authoritative; a parallel exact-count
// walk duplicated every scope-escape rule and made the diagnostic traverse each function twice.
check_module_escape* = (a: MutPtr<Malloc>, decls: [Decl]) i32 { (a.check_module_escape_kind(decls) == 0).match ({
    true  => 0,
    false => 1,
}) }
check_module_escape_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    pos := a.check_module_escape_kind(decls)
    (pos == 0).match ({
        true  => check_diagnostic_none(),
        false => {
            CheckDiagnostic(
                code: KESCAPE(),
                kind: "scope-escape",
                source_offset: pos,
                span_width: src.diagnostic_span_width(pos),
                count: 1,
                message: "value from scope `s` escapes its scope (its arena is freed on scope exit)",
                hint: "do not return a pointer from `s.acquire(...)`; copy the value out, or allocate in an outer scope",
            )
        },
    })
}
// ── ADDR-OF-LOCAL ESCAPE ──────────────────────────────────────────────────────────────────────────
// Returning `x.addr()` where `x` is a stack local hands the caller a pointer into the dead frame. This
// is a SEPARATE pass from the scope-escape above: it cannot reuse that walker, because a general
// allocator's `a.acquire(n)` returns HEAP that outlives the call (returning it is fine) — only the
// ADDRESS OF A LOCAL dangles. Conservative v1: taints `<local>.addr()` and forwards it through
// `slice(...)`, struct literals, match/cond arms, and block values; flags it in return/trailing
// position. NOT tracked (v1): aliasing through a `let`, heap-store aliasing, inter-procedural escape.
ae_collect_arms = (a: MutPtr<Malloc>, seen: Ptr<DeadList>, arms: [ArmData]) Ptr<DeadList> {
    out := seen
    arms.loop((h, i, ar) {
        out = a.ae_collect_expr(out, ar.body)
    })
    out
}
ae_collect_expr = (a: MutPtr<Malloc>, seen: Ptr<DeadList>, e: Ptr<Expr>) Ptr<DeadList> {
    load(e).match ({
        .Match(m) => a.ae_collect_arms(seen, m.arms),
        .Block(b) => a.ae_collect(seen, b.stmts),
        .Loop(l)  => a.ae_collect(seen, l.body),
        .Cond(d)  => a.ae_collect_expr(a.ae_collect_expr(seen, d.t), d.e),
        _         => seen,
    })
}
ae_collect_stmt = (a: MutPtr<Malloc>, seen: Ptr<DeadList>, st: Stmt) Ptr<DeadList> {
    st.match ({
        .Let(l)      => a.dead_cons(l.name, seen),
        .If(f)       => a.ae_collect(a.ae_collect(seen, f.then), f.els),
        .While(w)    => a.ae_collect(seen, w.body),
        .ExprStmt(e) => a.ae_collect_expr(seen, e),
        _            => seen,
    })
}
ae_collect = (a: MutPtr<Malloc>, seen: Ptr<DeadList>, body: [Stmt]) Ptr<DeadList> {
    out := seen
    body.loop((h, i, st) {
        out = a.ae_collect_stmt(out, st)
    })
    out
}
// `<local>.addr()` — a UFCS `addr` call whose sole arg is a Var that is a collected stack local.
ae_is_addr_local = (locals: Ptr<DeadList>, e: Ptr<Expr>) bool {
    load(e).match ({
        .Call(c) => (eq(c.fn, "addr") && c.args.len == 1).match ({
            true  => c.args[0].match ({
                .Var(v) => locals.dead_has(v.name),
                _       => false,
            }),
            false => false,
        }),
        _        => false,
    })
}
// SENDABILITY rule 3: a message may not carry a pointer into the sender's frame. `send(_, msg)` whose
// message escapes a local (`.addr()` of a local, directly or forwarded) → the offset of the call, else 0.
// the send-message escape (SENDABILITY rule 3) uses the NON-hopping escape check: a laundered send
// (`send(.Poke(launder(local.addr())))`) is the sendability pass's concern (kind `sendable`), so the
// call-following added for return-escape must NOT pre-empt it here — hop=false preserves that split.
ae_send_pos = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, locals: Ptr<DeadList>, e: Ptr<Expr>) i32 {
    load(e).match ({
        .Call(c) => (eq(c.fn, "send") && c.args.len >= 2 && a.ae_escapes(decls, idx, locals, c.args[1].addr(), false)).match ({
            true  => c.pos.pos_or(1),
            false => 0,
        }),
        _        => 0,
    })
}
ae_block_val_escapes = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, locals: Ptr<DeadList>, stmts: [Stmt], hop: bool) bool {
    (stmts.len == 0).match ({
        true  => false,
        false => stmts[stmts.len - 1].match ({
            .ExprStmt(e) => a.ae_escapes(decls, idx, locals, e, hop),
            .Return(r)   => a.ae_escapes(decls, idx, locals, r, hop),
            _            => false,
        }),
    })
}
ae_inits_escape = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, locals: Ptr<DeadList>, inits: [FieldInit], hop: bool) bool {
    f := false
    inits.loop((h, i, fi) {
        f = a.ae_escapes(decls, idx, locals, fi.value, hop).match ({ true => true, false => f })
    })
    f
}
ae_arms_escape = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, locals: Ptr<DeadList>, arms: [ArmData], hop: bool) bool {
    f := false
    arms.loop((h, i, ar) {
        f = a.ae_escapes(decls, idx, locals, ar.body, hop).match ({ true => true, false => f })
    })
    f
}
ae_items_escape = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, locals: Ptr<DeadList>, items: [Expr], hop: bool) bool {
    f := false
    items.loop((h, i, it) {
        f = a.ae_escapes(decls, idx, locals, it.addr(), hop).match ({ true => true, false => f })
    })
    f
}
// ── ESCAPE THROUGH A FN (re-census #1: stack-escape via a wrapper) ─────────────────────────────────
// The intra-procedural walk above flags `<local>.addr()` FORWARDED through slice/struct/match/cond/block
// in a return/trailing. But a local's address laundered THROUGH A CALL — an identity/wrapper fn that
// returns one of its pointer params (`id(x.addr())`, or `Box(p: id(x.addr()))`) — slipped past (the
// `.Call` arm only forwarded `slice`). We close it with a per-fn summary "does fn's return value derive
// from its param `pi`?" (bounded, structural — pointer flow needs no type infer), and follow ANY call
// hop whose matching arg is itself an escaping local address. Sound (reject-more) + zero over-reject: the
// arg must be an addr-of-LOCAL (the only tainted shape) AND the callee must actually thread that param to
// its result; a callee that reads through the pointer and returns a fresh/copied value threads nothing.
// does local fn `fn`'s return value derive from its param at index `pi`? (bounded interprocedural)
ae_fn_returns_param = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, fn: string_view, pi: i32, depth: i32) bool {
    (depth <= 0).match ({
        true  => false,
        false => {
            f := idx.idx_func(decls, fn)
            (eq(f.name, "") == false && pi >= 0 && pi < f.params.len).match ({
                true  => a.ae_ret_body(decls, idx, f.body, f.params[pi].name, depth),
                false => false,
            })
        },
    })
}
// value position: does expr `e` yield the tracked param `name` (directly, forwarded, or via one hop)?
ae_ret_yields = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, name: string_view, e: Ptr<Expr>, depth: i32) bool {
    load(e).match ({
        .Var(v)        => eq(v.name, name),
        .Call(c)       => (eq(c.fn, "slice") && c.args.len > 0).match ({
            true  => a.ae_ret_yields(decls, idx, name, c.args[0].addr(), depth),
            false => a.ae_ret_call(decls, idx, c, name, depth),
        }),
        .MakeStruct(s) => a.ae_ret_inits(decls, idx, s.inits, name, depth),
        .MakeEnum(mk)  => a.ae_ret_yields(decls, idx, name, mk.payload, depth),
        .Match(m)      => a.ae_ret_valarms(decls, idx, m.arms, name, depth),
        .Cond(d)       => a.ae_ret_yields(decls, idx, name, d.t, depth) || a.ae_ret_yields(decls, idx, name, d.e, depth),
        .Block(b)      => a.ae_ret_blockval(decls, idx, b.stmts, name, depth),
        .SliceLit(sd)  => a.ae_ret_items(decls, idx, sd.items, name, depth),
        _              => false,
    })
}
ae_ret_inits = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, inits: [FieldInit], name: string_view, depth: i32) bool {
    f := false
    inits.loop((h, i, fi) {
        f = a.ae_ret_yields(decls, idx, name, fi.value, depth).match ({ true => true, false => f })
    })
    f
}
ae_ret_valarms = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, arms: [ArmData], name: string_view, depth: i32) bool {
    f := false
    arms.loop((h, i, ar) {
        f = a.ae_ret_yields(decls, idx, name, ar.body, depth).match ({ true => true, false => f })
    })
    f
}
ae_ret_items = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, items: [Expr], name: string_view, depth: i32) bool {
    f := false
    items.loop((h, i, it) {
        f = a.ae_ret_yields(decls, idx, name, it.addr(), depth).match ({ true => true, false => f })
    })
    f
}
ae_ret_blockval = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, stmts: [Stmt], name: string_view, depth: i32) bool {
    (stmts.len == 0).match ({
        true  => false,
        false => stmts[stmts.len - 1].match ({
            .ExprStmt(e) => a.ae_ret_yields(decls, idx, name, e, depth),
            .Return(r)   => a.ae_ret_yields(decls, idx, name, r, depth),
            _            => false,
        }),
    })
}
// one interprocedural hop: a call whose arg[i] yields `name` AND whose callee returns its param `i`.
ae_ret_call = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, c: CallData, name: string_view, depth: i32) bool {
    (depth <= 1).match ({
        true  => false,
        false => {
            f := idx.idx_func(decls, c.fn)
            found := false
            (eq(f.name, "") == false && f.params.len == c.args.len).then({
                c.args.loop((h, i, ar) {
                    (a.ae_ret_yields(decls, idx, name, ar.addr(), depth - 1) && a.ae_fn_returns_param(decls, idx, c.fn, i, depth - 1)).then({
                        found = true
                    })
                })
            })
            found
        },
    })
}
// returns-only statement walker over the callee body (mirrors the escape walker; trailing handled by caller).
ae_ret_body = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, body: [Stmt], name: string_view, depth: i32) bool {
    f := false
    body.loop((h, i, st) {
        f = a.ae_ret_stmt(decls, idx, st, name, depth).match ({ true => true, false => f })
    })
    (body.len == 0).match ({
        true  => f,
        false => body[body.len - 1].match ({
            .ExprStmt(e) => a.ae_ret_yields(decls, idx, name, e, depth).match ({
                true  => true,
                false => f,
            }),
            _            => f,
        }),
    })
}
ae_ret_stmt = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, st: Stmt, name: string_view, depth: i32) bool {
    st.match ({
        .Return(r)   => a.ae_ret_yields(decls, idx, name, r, depth),
        .If(f)       => a.ae_ret_body(decls, idx, f.then, name, depth) || a.ae_ret_body(decls, idx, f.els, name, depth),
        .While(w)    => a.ae_ret_body(decls, idx, w.body, name, depth),
        .ExprStmt(e) => a.ae_ret_estmt(decls, idx, e, name, depth),
        _            => false,
    })
}
ae_ret_estmt = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, e: Ptr<Expr>, name: string_view, depth: i32) bool {
    load(e).match ({
        .Match(m) => a.ae_ret_stmtarms(decls, idx, m.arms, name, depth),
        .Cond(d)  => a.ae_ret_estmt(decls, idx, d.t, name, depth) || a.ae_ret_estmt(decls, idx, d.e, name, depth),
        .Block(b) => a.ae_ret_body(decls, idx, b.stmts, name, depth),
        .Loop(l)  => a.ae_ret_body(decls, idx, l.body, name, depth),
        _         => false,
    })
}
ae_ret_stmtarms = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, arms: [ArmData], name: string_view, depth: i32) bool {
    f := false
    arms.loop((h, i, ar) {
        hit := load(ar.body).match ({
            .Block(b) => a.ae_ret_body(decls, idx, b.stmts, name, depth),
            _         => false,
        })
        f = hit.match ({ true => true, false => f })
    })
    f
}
// the call-following forward for the escape walk: a local's address escaping into a returning-param arg.
ae_call_escapes = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, locals: Ptr<DeadList>, c: CallData) bool {
    f := idx.idx_func(decls, c.fn)
    found := false
    (eq(f.name, "") == false && f.params.len == c.args.len).then({
        c.args.loop((h, i, ar) {
            (a.ae_escapes(decls, idx, locals, ar.addr(), true) && a.ae_fn_returns_param(decls, idx, c.fn, i, consume_depth())).then({
                found = true
            })
        })
    })
    found
}
// value position: IS a `<local>.addr()`, or forwards one through slice()/struct/match/cond/block, or (only
// when `hop`) through a call to a fn that returns one of its pointer params (identity/wrapper laundering).
// `hop` is on for the return/trailing escape (the actual stack-escape-via-fn vuln) and off for the send
// path, which the sendability pass owns (so a laundered send stays kind `sendable`, not `escape`).
ae_escapes = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, locals: Ptr<DeadList>, e: Ptr<Expr>, hop: bool) bool {
    locals.ae_is_addr_local(e).match ({
        true  => true,
        false => load(e).match ({
            .Call(c)       => (eq(c.fn, "slice") && c.args.len > 0).match ({
                true  => a.ae_escapes(decls, idx, locals, c.args[0].addr(), hop),
                false => hop.match ({
                    true  => a.ae_call_escapes(decls, idx, locals, c),
                    false => false,
                }),
            }),
            .MakeEnum(mk)  => a.ae_escapes(decls, idx, locals, mk.payload, hop),
            .MakeStruct(s) => a.ae_inits_escape(decls, idx, locals, s.inits, hop),
            .Match(m)      => a.ae_arms_escape(decls, idx, locals, m.arms, hop),
            .Cond(d)       => a.ae_escapes(decls, idx, locals, d.t, hop) || a.ae_escapes(decls, idx, locals, d.e, hop),
            .Block(b)      => a.ae_block_val_escapes(decls, idx, locals, b.stmts, hop),
            .SliceLit(sd)  => a.ae_items_escape(decls, idx, locals, sd.items, hop),
            _              => false,
        }),
    })
}
// position walk (mirrors kv_escape_*): the source offset of the first escaping return/trailing, 0 = none.
ae_kv_arm = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, locals: Ptr<DeadList>, body: Ptr<Expr>) i32 {
    load(body).match ({
        .Block(b) => a.ae_kv_stmts(decls, idx, locals, b.stmts),
        _         => 0,
    })
}
ae_kv_arms = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, locals: Ptr<DeadList>, arms: [ArmData]) i32 {
    acc := 0
    arms.loop((h, i, ar) {
        acc = acc.kv_kor(a.ae_kv_arm(decls, idx, locals, ar.body))
    })
    acc
}
ae_kv_expr_stmt = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, locals: Ptr<DeadList>, e: Ptr<Expr>) i32 {
    load(e).match ({
        .Match(m) => a.ae_kv_arms(decls, idx, locals, m.arms),
        .Cond(d)  => a.ae_kv_expr_stmt(decls, idx, locals, d.t).kv_kor(a.ae_kv_expr_stmt(decls, idx, locals, d.e)),
        .Block(b) => a.ae_kv_stmts(decls, idx, locals, b.stmts),
        .Loop(l)  => a.ae_kv_stmts(decls, idx, locals, l.body),
        _         => 0,
    })
}
ae_kv_stmt = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, locals: Ptr<DeadList>, st: Stmt) i32 {
    st.match ({
        .Return(r)   => a.ae_escapes(decls, idx, locals, r, true).match ({
            true  => load(r).expr_pos().pos_or(1),
            false => 0,
        }),
        .If(f)       => a.ae_kv_stmts(decls, idx, locals, f.then).kv_kor(a.ae_kv_stmts(decls, idx, locals, f.els)),
        .While(w)    => a.ae_kv_stmts(decls, idx, locals, w.body),
        .Let(l)      => a.ae_send_pos(decls, idx, locals, l.value),
        .Assign(x)   => a.ae_send_pos(decls, idx, locals, x.value),
        .ExprStmt(e) => a.ae_kv_expr_stmt(decls, idx, locals, e).kv_kor(a.ae_send_pos(decls, idx, locals, e)),
        _            => 0,
    })
}
ae_kv_stmts = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, locals: Ptr<DeadList>, body: [Stmt]) i32 {
    acc := 0
    body.loop((h, i, st) {
        acc = acc.kv_kor(a.ae_kv_stmt(decls, idx, locals, st))
    })
    acc
}
ae_kv_body = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, locals: Ptr<DeadList>, body: [Stmt]) i32 {
    acc := a.ae_kv_stmts(decls, idx, locals, body)
    acc.kv_kor((body.len == 0).match ({
        true  => 0,
        false => body[body.len - 1].match ({
            .ExprStmt(e) => a.ae_escapes(decls, idx, locals, e, true).match ({
                true  => load(e).expr_pos().pos_or(1),
                false => 0,
            }),
            _            => 0,
        }),
    }))
}
ae_check_func = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, f: Func) i32 {
    locals := a.ae_collect(a.dead_nil(), f.body)
    a.ae_kv_body(decls, idx, locals, f.body)
}
check_module_addr_escape_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    idx := a.build_decl_index(decls)
    acc := 0
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DFunc(f) => a.ae_check_func(decls, idx, f),
            _         => 0,
        }))
    })
    acc
}
check_module_addr_escape* = (a: MutPtr<Malloc>, decls: [Decl]) i32 { (a.check_module_addr_escape_kind(decls) == 0).match ({
    true  => 0,
    false => 1,
}) }
check_module_addr_escape_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    pos := a.check_module_addr_escape_kind(decls)
    (pos == 0).match ({
        true  => check_diagnostic_none(),
        false => CheckDiagnostic(
            code: KESCAPE(),
            kind: "escape",
            source_offset: pos,
            span_width: src.diagnostic_span_width(pos),
            count: 1,
            message: "pointer to a local escapes the function (the local's frame is gone after return)",
            hint: "return the value by copy, or allocate it through an allocator/owner that outlives the call",
        ),
    })
}
// ── SENDABILITY rule 2: an Rc<T> may not be sent across actors. ───────────────────────────────────
// Rc's refcount is a plain (non-atomic) i64, so sharing one between actors on different threads races.
// Flag `send(handle, msg)` whose message carries an Rc (sent directly, wrapped in an enum, or in a
// struct field). Arc<T> (atomic) and value/Own messages are fine — only Rc is rejected, so ordinary
// message sends keep zero friction.
sd_inits_rc = (env: Env, inits: [FieldInit]) bool {
    f := false
    inits.loop((h, i, fi) {
        f = env.sd_msg_rc(fi.value).match ({ true => true, false => f })
    })
    f
}
sd_msg_rc = (env: Env, e: Ptr<Expr>) bool {
    load(e).match ({
        .Var(v)        => eq(env.infer_expr(e).owner_base(), "Rc"),
        .MakeEnum(mk)  => env.sd_msg_rc(mk.payload),
        .MakeStruct(s) => env.sd_inits_rc(s.inits),
        _              => false,
    })
}
// a `send(_, msg)` whose message carries an Rc → the source offset of the call, else 0. `&&` short-
// circuits, so `c.args[1]` is only touched when the arity check passed.
sd_call_pos = (env: Env, c: CallData) i32 {
    (eq(c.fn, "send") && c.args.len >= 2 && env.sd_msg_rc(c.args[1].addr())).match ({
        true  => c.pos.pos_or(1),
        false => 0,
    })
}
// ── UNIFIED send-payload walk (replaces the near-identical sd_*/sm_* traversal skeletons). ────────
// ONE tree-fold parameterized by `mode`: 0 = send-Rc (sd_* leaves), 1 = send-MutPtr (sm_* leaves).
// Returns a packed kind+pos (kv_kor keeps the first nonzero); both sendability passes now share ONE
// traversal and only the per-node CLASSIFIER (which send surfaces, which payload type) differs by mode.
// mode 0 has NO `.MethodCall` arm — send-Rc classifies plain `send(...)` calls only — so the
// `mode==0 => 0` branch preserves that exactly (no descent into method-call children); the walk is
// byte-for-byte the behavior of the two hand-cloned families it replaces.
sv_call_pos = (env: Env, c: CallData, mode: i32) i32 { (mode == 0).match ({
    true  => env.sd_call_pos(c),
    false => env.sm_call_pos(c),
}) }
sv_args = (a: MutPtr<Malloc>, env: Env, args: [Expr], mode: i32) i32 {
    acc := 0
    args.loop((h, i, ar) {
        acc = acc.kv_kor(a.sv_expr(env, ar.addr(), mode))
    })
    acc
}
sv_arms = (a: MutPtr<Malloc>, env: Env, subjty: Ty, arms: [ArmData], mode: i32) i32 {
    acc := 0
    arms.loop((h, i, ar) {
        acc = acc.kv_kor(a.sv_expr(a.arm_env(env, subjty, ar), ar.body, mode))
    })
    acc
}
sv_inits = (a: MutPtr<Malloc>, env: Env, inits: [FieldInit], mode: i32) i32 {
    acc := 0
    inits.loop((h, i, fi) {
        acc = acc.kv_kor(a.sv_expr(env, fi.value, mode))
    })
    acc
}
sv_expr = (a: MutPtr<Malloc>, env: Env, e: Ptr<Expr>, mode: i32) i32 {
    load(e).match ({
        .Call(c)        => env.sv_call_pos(c, mode).kv_kor(a.sv_args(env, c.args, mode)),
        .MethodCall(mc) => (mode == 0).match ({
            true  => 0,
            false => env.sm_mcall_pos(mc).kv_kor(a.sv_expr(env, mc.recv, mode)).kv_kor(a.sv_args(env, mc.args, mode)),
        }),
        .Bin(b)         => a.sv_expr(env, b.lhs, mode).kv_kor(a.sv_expr(env, b.rhs, mode)),
        .Index(ix)      => a.sv_expr(env, ix.seq, mode).kv_kor(a.sv_expr(env, ix.idx, mode)),
        .Cond(d)        => a.sv_expr(env, d.c, mode).kv_kor(a.sv_expr(env, d.t, mode)).kv_kor(a.sv_expr(env, d.e, mode)),
        .Member(m)      => a.sv_expr(env, m.obj, mode),
        .Arrow(ar)      => a.sv_expr(env, ar.obj, mode),
        .Match(m)       => a.sv_expr(env, m.subj, mode).kv_kor(a.sv_arms(env, env.infer_expr(m.subj), m.arms, mode)),
        .MakeEnum(mk)   => a.sv_expr(env, mk.payload, mode),
        .MakeStruct(s)  => a.sv_inits(env, s.inits, mode),
        .SliceLit(sd)   => a.sv_args(env, sd.items, mode),
        .Loop(l)        => a.sv_expr(env, l.seq, mode).kv_kor(a.sv_body(env, l.body, mode)),
        .Block(b)       => a.sv_body(env, b.stmts, mode),
        _               => 0,
    })
}
sv_stmt = (a: MutPtr<Malloc>, env: Env, st: Stmt, mode: i32) i32 {
    st.match ({
        .Let(l)      => a.sv_expr(env, l.value, mode),
        .Assign(x)   => a.sv_expr(env, x.target, mode).kv_kor(a.sv_expr(env, x.value, mode)),
        .Return(r)   => a.sv_expr(env, r, mode),
        .ExprStmt(e) => a.sv_expr(env, e, mode),
        .If(f)       => a.sv_expr(env, f.c, mode).kv_kor(a.sv_body(env, f.then, mode)).kv_kor(a.sv_body(env, f.els, mode)),
        .While(w)    => a.sv_expr(env, w.c, mode).kv_kor(a.sv_body(env, w.body, mode)),
        .IndexSet(x) => a.sv_expr(env, x.seq, mode).kv_kor(a.sv_expr(env, x.idx, mode)).kv_kor(a.sv_expr(env, x.value, mode)),
    })
}
sv_body = (a: MutPtr<Malloc>, env: Env, body: [Stmt], mode: i32) i32 {
    acc := 0
    e := env
    body.loop((h, i, st) {
        acc = acc.kv_kor(a.sv_stmt(e, st, mode))
        e = a.extend_env(e, st)
    })
    acc
}
sv_check_func = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, f: Func, mode: i32) i32 {
    env := Env(
        vars: a.params_env(f.params),
        decls: decls,
        didx: idx,
        exp: f.ret,
        a: a,
    )
    a.sv_body(env, f.body, mode)
}
check_module_send_kind = (a: MutPtr<Malloc>, decls: [Decl], mode: i32) i32 {
    acc := 0
    idx := a.build_decl_index(decls)
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DFunc(f) => a.sv_check_func(decls, idx, f, mode),
            _         => 0,
        }))
    })
    acc
}
check_module_send_rc_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 { a.check_module_send_kind(decls, 0) }
check_module_send_rc* = (a: MutPtr<Malloc>, decls: [Decl]) i32 { (a.check_module_send_rc_kind(decls) == 0).match ({
    true  => 0,
    false => 1,
}) }
check_module_send_rc_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    pos := a.check_module_send_rc_kind(decls)
    (pos == 0).match ({
        true  => check_diagnostic_none(),
        false => CheckDiagnostic(
            code: KOWNERSHIP(),
            kind: "sendable",
            source_offset: pos,
            span_width: src.diagnostic_span_width(pos),
            count: 1,
            message: "Rc<T> is not sendable across actors (its refcount is single-threaded)",
            hint: "use Arc<T> for a value shared between actors, or send a value/owned copy",
        ),
    })
}
// ── SENDABILITY AS A TYPE CAPABILITY: `ref` (MutPtr<T>) is not sendable (rt-scoped-runtime.md §4) ──
// The send-payload classifier, read off the payload's TYPE (Pony reference-capabilities, NOT a verb):
//   value — no pointers, copied → sendable (zero ceremony);
//   val   — readonly `Ptr<T>` (= Pony `box`, deeply immutable) → sendable + aliasable;
//   iso   — `Own<T>` moved (move-on-send kills the binding, above) → sendable uniquely.
// A `MutPtr<T>` (= Pony `ref`: a MUTABLE, aliasable pointer) is NONE of these: keeping the sender's
// mutable alias while the receiver also mutates the pointee is a cross-actor data race. So a send whose
// message carries a `MutPtr<T>` — directly, wrapped in an enum variant, or in a struct field — is
// rejected. The receiver still reads a `Ptr<T>`/value payload AS ITS NORMAL TYPE (no wrapper); this
// pass only refuses the mutable-reference kind. Same shape as the send-Rc pass (type-aware via
// infer_expr, walks the same surfaces); runs AFTER scratch-escape so an addr-of-local (also a MutPtr)
// gets the more specific lifetime remedy first.
sm_inits_mut = (env: Env, inits: [FieldInit]) bool {
    f := false
    inits.loop((h, i, fi) {
        f = env.sm_msg_mut(tvoid(), fi.value).match ({ true => true, false => f })
    })
    f
}
// the message/element type carried by an actor handle: `ActorRef<M>` / `ActorCell<M>` / `ActorHandle<M,_>`
// / `ReplyRef<M>` (possibly behind a pointer) → M (its first type arg). tvoid when the target has no
// concrete generic head (a pre-inline tparam handle) — the caller then falls back to the payload
// expression's own inferred type, so nothing is over-rejected.
first_gen_arg = (t: Ty) Ty {
    t.match ({
        .Generic(g) => (g.args.len > 0).match ({ true => g.args[0], false => tvoid() }),
        .Ptr(pd)    => load(pd.pointee).first_gen_arg(),
        _           => tvoid(),
    })
}
// Classify a send-payload expression by the TYPE it reaches (Pony reference-capabilities), NOT its AST
// shape. A constructor node (MakeEnum / MakeStruct) is descended into the SPECIFIC payload/fields actually
// constructed — never inferred as a whole, so a `.Inc(3)` of an enum that ALSO has a `.Poke(MutPtr)` variant
// is not wrongly rejected. EVERY OTHER leaf (Var, Call, MethodCall, Member, Arrow, Index, …) is classified
// by `ty_reaches_mutptr(infer_expr(e))`: this is what makes the check SOUND THROUGH A CALL/MEMBER/FIELD —
// `send(.Poke(o.ptr()))` (a method returning MutPtr) and `send(.Poke(launder(b.addr())))` (a MutPtr threaded
// through an identity fn) both infer a MutPtr-reaching type and reject, closing the `.Var`-only hole where
// they fell to `false`. A call returning a deeply-immutable `Ptr<T>` (`val`) still infers clean (not
// rejected) — the precision comes from the type predicate, not the syntax.
// The DECLARED payload type of the constructed variant reaches a MutPtr — e.g. `.Poke(x)` where the
// enum's `Poke` variant is declared `Poke(MutPtr<i32>)`. This is what closes the generic-FORWARDER hole
// (#407 launder): `fwd<T>(h, payload: T){ h.send(.Poke(payload)) }` infers its payload EXPRESSION as the
// bare tparam `T` (reaches no MutPtr), but the message it constructs is a `.Poke`, whose DECLARED field
// is a MutPtr regardless of what `T` is bound to — so the receiver still gets a mutable alias. Reading
// the SPECIFIC constructed variant's declared field (not the whole enum) keeps a sibling `.Inc(3)` on
// the same enum legal (Inc's field is an i32, reaches no MutPtr). The enum is pinned by the constructor
// node's own `ty` when set, else by `mty` — the message type M carried by the send TARGET's handle
// (`send(h, .Poke(x))` → h: ActorRef<M> → M): a bare `.Poke` inside a generic forwarder leaves `mk.ty`
// empty, so M from the (concretely-typed) handle is what resolves the variant. Lenient when NEITHER
// pins the enum (both void) — the payload-expression descent still applies, so nothing over-rejects.
sm_variant_decl_mut = (env: Env, mty: Ty, mk: MakeEnumData) bool {
    ety := is_empty(mk.ty).match ({ true => mty, false => tnamed(mk.ty) })
    env.decls.mode_of(env.subj_variant_payload(ety, mk.variant)).mode_sendable() == false
}
sm_msg_mut = (env: Env, mty: Ty, e: Ptr<Expr>) bool {
    load(e).match ({
        .MakeEnum(mk)  => env.sm_variant_decl_mut(mty, mk).match ({
            true  => true,
            false => env.sm_msg_mut(tvoid(), mk.payload),
        }),
        .MakeStruct(s) => env.sm_inits_mut(s.inits),
        _              => env.decls.mode_of(env.infer_expr(e)).mode_sendable() == false,
    })
}
// The actor-send surfaces (name-based, arity-guarded — mirrors the scratch pass's `sx_call_kind`): the
// MESSAGE is the LAST argument, NOT a hardcoded `args[1]`. That covers the 3-arg PARALLEL primitive
// `send(p, h, msg)` (from `p.send(h, msg)` / std.concurrent.pool_actor.send, flattened to `…__send`) whose
// message is `args[2]` — the path where cross-actor races ACTUALLY happen — as well as the 2-arg inline
// `send(h, msg)`. `sx_named` accepts the bare name and the flattener's `…__send` / `…__pool_send` suffix.
// the handle is the argument immediately BEFORE the message in every flattened send shape — `send(h,
// msg)` and the 3-arg parallel `send(p, h, msg)` / `pool_send(p, h, msg)` — so `args[len-2]` yields the
// handle whose type arg is the message type M, used to resolve a bare `.Variant` message against M's decl.
sm_call_pos = (env: Env, c: CallData) i32 {
    (c.fn.sx_named("send", "__send") && c.args.len >= 2 || c.fn.sx_named("pool_send", "__pool_send") && c.args.len == 3).match ({
        true  => env.sm_msg_mut(env.infer_expr(c.args[c.args.len - 2].addr()).first_gen_arg(), c.args[c.args.len - 1].addr()).match ({
            true  => c.pos.pos_or(1),
            false => 0,
        }),
        false => 0,
    })
}
// the UFCS form as it may survive pre-desugar (`h.send(m)` / `p.send(h, m)` / `p.pool_send(h, m)`): the
// message is again the LAST method argument (the receiver is carried separately).
// pre-desugar UFCS form (`h.send(m)` / `p.pool_send(h, m)`): the message is the last method arg; the
// handle carrying M is the RECEIVER for `h.send(m)` (its first type arg is M). For `p.pool_send(h, m)`
// the receiver is the pool (M unresolved → tvoid), which falls back to the payload-expression descent.
sm_mcall_pos = (env: Env, mc: MethodCallData) i32 {
    (eq(mc.method, "send") && mc.args.len >= 1 || eq(mc.method, "pool_send") && mc.args.len == 2).match ({
        true  => env.sm_msg_mut(env.infer_expr(mc.recv).first_gen_arg(), mc.args[mc.args.len - 1].addr()).match ({
            true  => mc.pos.pos_or(1),
            false => 0,
        }),
        false => 0,
    })
}
check_module_send_mut_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 { a.check_module_send_kind(decls, 1) }
check_module_send_mut* = (a: MutPtr<Malloc>, decls: [Decl]) i32 { (a.check_module_send_mut_kind(decls) == 0).match ({
    true  => 0,
    false => 1,
}) }
check_module_send_mut_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    pos := a.check_module_send_mut_kind(decls)
    (pos == 0).match ({
        true  => check_diagnostic_none(),
        false => CheckDiagnostic(
            code: KOWNERSHIP(),
            kind: "sendable",
            source_offset: pos,
            span_width: src.diagnostic_span_width(pos),
            count: 1,
            message: "MutPtr<T> (a mutable reference) is not sendable across actors — it aliases mutable state the sender keeps, so the receiver mutating it is a data race",
            hint: "send a readonly `Ptr<T>` (a `frozen` value: deeply immutable, freely aliasable), move an `Own<T>` (an `owned` value, sent by move), or send a value copy",
        ),
    })
}
// ── M1 slice 1 (rt-scoped-runtime): SPAWNER SCRATCH ACROSS AN ACTOR BOUNDARY ─────────────────────
// docs/rt-scoped-runtime.md M1: memory that must not cross an actor boundary, crossing it — the
// judged-FATAL v1 hole (cross-actor UAF, docs/rt-design-judge-ruling-2026-07.md hole 1: memory in
// the SPAWNER's scratch handed to an actor that outlives it). Two rules, enforced lexically +
// name-based over the RAW pre-desugar decls (driver-only, the send-Rc pass's shape):
//   1. send-payload: the payload of an actor send (`send` / `pool_send`, last argument) must not
//      carry a SPAWNER-LOCAL allocation — a local bound to `<allocator>.acquire(…)` or arena
//      `make_in(…)`, a slice literal (a C compound literal: STACK storage), or `<local>.addr()` —
//      bare, or embedded directly in a struct-literal field / enum payload. The sender's scratch is
//      freed independently of the receiving actor → use-after-free.
//   2. actor-state: the same classification applied to `spawn`'s initial actor-state argument
//      (construct-under-actor until the real rt lands: actor state must not embed spawner scratch).
// DELIBERATELY LENIENT wherever classification is uncertain (fn returns, `.expect(…)`, member
// reads, params, arm binds, generic payloads): Arc/Rc-backed values arrive via
// `new_in(…).expect(…)`/`clone()` — call results, so they classify clean; plain values are clean;
// a rebind to anything clean REVIVES the name. Only the blatant textbook shapes reject.
// Arity guards keep unrelated `spawn`s out: std.thread's `spawn(fn, arg)` is a 2-arg Call and the
// coroutine `h.spawn(fn)` a 1-arg MethodCall — neither matches the 3-arg actor `spawn` surface.
KSCRATCHSEND = () i32 { 34 }    // a send payload carries spawner-local scratch. CUSTOM channel (own struct + sx_message), NOT the diag_info ladder — unique code, was 29 (collided with KVBREAK)
KSCRATCHSTATE = () i32 { 35 }    // spawn's initial actor state embeds spawner-local scratch. CUSTOM channel — unique code, was 30 (collided with KMAINPARAMS)
// a scratch-SOURCE expression: memory whose lifetime is the spawner's frame/allocator, in either
// surface form (flat `acquire(a, n)` or UFCS `a.acquire(n)` — this pass runs pre-desugar).
sx_is_acquire = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Call(c)        => eq(c.fn, "acquire") && c.args.len >= 1,
        .MethodCall(mc) => eq(mc.method, "acquire"),
        _               => false,
    })
}
// `make_in(…)` bare, or the Result-unified `make_in(…).expect(…)` — the arena constructor returns
// Result<Arena, IoError> now, so the textbook scratch shape carries an `.expect` wrapper; unwrap it
// (an `.expect` whose receiver is NOT a scratch source still classifies clean, e.g. Arc `new_in`).
sx_is_make_in = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Call(c)        => eq(c.fn, "make_in") && c.args.len >= 1 || eq(c.fn, "expect") && c.args.len >= 1 && c.args[0].match ({
            .Call(c2)        => eq(c2.fn, "make_in") && c2.args.len >= 1,
            .MethodCall(mc2) => eq(mc2.method, "make_in"),
            _                => false,
        }),
        .MethodCall(mc) => eq(mc.method, "make_in") || eq(mc.method, "expect") && mc.recv.sx_is_make_in(),
        _               => false,
    })
}
// `<var>.addr()` — the address of a stack slot in the spawner's frame.
sx_is_addr_of_var = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Call(c)        => (eq(c.fn, "addr") && c.args.len == 1).match ({
            true  => c.args[0].match ({
                .Var(v) => true,
                _       => false,
            }),
            false => false,
        }),
        .MethodCall(mc) => (eq(mc.method, "addr") && mc.args.len == 0).match ({
            true  => load(mc.recv).match ({
                .Var(v) => true,
                _       => false,
            }),
            false => false,
        }),
        _               => false,
    })
}
sx_is_slicelit = (e: Ptr<Expr>) bool {
    load(e).match ({
        .SliceLit(sd) => true,
        _             => false,
    })
}
sx_is_source = (e: Ptr<Expr>) bool { e.sx_is_acquire() || e.sx_is_make_in() || e.sx_is_addr_of_var() || e.sx_is_slicelit() }
// does a let/assign VALUE make its binding spawner-scratch? a direct source, or an alias of a
// tainted local (`q := p`). Anything else (calls, member reads, literals) stays clean — lenient.
sx_taints = (taint: Ptr<DeadList>, e: Ptr<Expr>) bool {
    e.sx_is_source().match ({
        true  => true,
        false => load(e).match ({
            .Var(v) => taint.dead_has(v.name),
            _       => false,
        }),
    })
}
// thread the taint set across one statement: a Let/Assign of a source (or an alias) taints the
// name; a (re)bind to anything clean REVIVES it, so a reused name never over-rejects.
sx_step = (a: MutPtr<Malloc>, taint: Ptr<DeadList>, st: Stmt) Ptr<DeadList> {
    st.match ({
        .Let(l)    => taint.sx_taints(l.value).match ({
            true  => a.dead_cons(l.name, taint),
            false => a.dead_remove(taint, l.name),
        }),
        .Assign(x) => load(x.target).match ({
            .Var(v) => taint.sx_taints(x.value).match ({
                true  => a.dead_cons(v.name, taint),
                false => a.dead_remove(taint, v.name),
            }),
            _       => taint,
        }),
        _          => taint,
    })
}
// fresh binders (lambda params, loop idx/elem/handler, arm binds) shadow any same-named taint.
sx_drop_params = (a: MutPtr<Malloc>, taint: Ptr<DeadList>, ps: [Param]) Ptr<DeadList> {
    out := taint
    ps.loop((h, i, p) {
        out = a.dead_remove(out, p.name)
    })
    out
}
// a positioned anchor for a source expression (expr_pos has no MethodCall arm; this pass sees the
// pre-desugar UFCS form, so `a.acquire(n)` anchors at the method name).
sx_pos = (e: Ptr<Expr>) i32 {
    load(e).match ({
        .MethodCall(mc) => mc.pos.pos_or(load(mc.recv).expr_pos()),
        _               => load(e).expr_pos(),
    })
}
// the offending source offset inside a send-payload / spawn-state expression: a tainted bare local,
// a direct source expression, or one embedded in a struct-literal field / enum payload / nested
// literal. Everything else (calls, member reads, plain values) is 0 = clean.
sx_payload_pos = (a: MutPtr<Malloc>, taint: Ptr<DeadList>, e: Ptr<Expr>) i32 {
    e.sx_is_source().match ({
        true  => e.sx_pos().pos_or(1),
        false => load(e).match ({
            .Var(v)        => taint.dead_has(v.name).match ({ true => v.pos.pos_or(1), false => 0 }),
            .MakeEnum(mk)  => a.sx_payload_pos(taint, mk.payload),
            .MakeStruct(s) => a.sx_inits_pos(taint, s.inits),
            _              => 0,
        }),
    })
}
sx_inits_pos = (a: MutPtr<Malloc>, taint: Ptr<DeadList>, inits: [FieldInit]) i32 {
    acc := 0
    inits.loop((h, i, fi) {
        acc = acc.kv_kor(a.sx_payload_pos(taint, fi.value))
    })
    acc
}
// pack an offending position under a rule kind (0 = clean stays 0 — kv_at alone would emit a bare kind).
sx_kv = (pos: i32, k: i32) i32 { (pos == 0).match ({ true => 0, false => kv_at(k, pos) }) }
// actor-send / spawn surfaces (name-based, arity-guarded): the PAYLOAD/STATE is the LAST argument.
//   send:      `send(h, m)` (2+ args) / `h.send(m)` — ActorRef/ActorHandle/ActorCell/ReplyRef
//   pool_send: `pool_send(p, a, m)` (3 args) / `p.pool_send(a, m)` (2 args)
//   spawn:     `spawn(alloc, cap, state)` (3 args) / `alloc.spawn(cap, state)` (2-arg MethodCall) /
//              module-qualified `actor.spawn(alloc, cap, state)` — the flattener rewrites a
//              namespace-qualified call to `alias__spawn(alloc, cap, state)`, so the flat-Call
//              match also accepts the `…__spawn` / `…__send` / `…__pool_send` suffix forms.
sx_named = (fn: string_view, bare: string_view, qual: string_view) bool { eq(fn, bare) || fn.ends_with(qual) }
sx_call_kind = (a: MutPtr<Malloc>, taint: Ptr<DeadList>, c: CallData) i32 {
    sk := (c.fn.sx_named("send", "__send") && c.args.len >= 2 || c.fn.sx_named("pool_send", "__pool_send") && c.args.len == 3).match ({
        true  => a.sx_payload_pos(taint, c.args[c.args.len - 1].addr()).sx_kv(KSCRATCHSEND()),
        false => 0,
    })
    st := (c.fn.sx_named("spawn", "__spawn") && c.args.len == 3).match ({
        true  => a.sx_payload_pos(taint, c.args[2].addr()).sx_kv(KSCRATCHSTATE()),
        false => 0,
    })
    sk.kv_kor(st)
}
sx_mcall_kind = (a: MutPtr<Malloc>, taint: Ptr<DeadList>, mc: MethodCallData) i32 {
    sk := (eq(mc.method, "send") && mc.args.len >= 1 || eq(mc.method, "pool_send") && mc.args.len == 2).match ({
        true  => a.sx_payload_pos(taint, mc.args[mc.args.len - 1].addr()).sx_kv(KSCRATCHSEND()),
        false => 0,
    })
    st := (eq(mc.method, "spawn") && (mc.args.len == 2 || mc.args.len == 3)).match ({
        true  => a.sx_payload_pos(taint, mc.args[mc.args.len - 1].addr()).sx_kv(KSCRATCHSTATE()),
        false => 0,
    })
    sk.kv_kor(st)
}
sx_args_kind = (a: MutPtr<Malloc>, taint: Ptr<DeadList>, args: [Expr]) i32 {
    acc := 0
    args.loop((h, i, ar) {
        acc = acc.kv_kor(a.sx_expr_kind(taint, ar.addr()))
    })
    acc
}
sx_arms_kind = (a: MutPtr<Malloc>, taint: Ptr<DeadList>, arms: [ArmData]) i32 {
    acc := 0
    arms.loop((h, i, ar) {
        t2 := is_empty(ar.bind).match ({ true => taint, false => a.dead_remove(taint, ar.bind) })
        acc = acc.kv_kor(a.sx_expr_kind(t2, ar.body))
    })
    acc
}
sx_inits_kind = (a: MutPtr<Malloc>, taint: Ptr<DeadList>, inits: [FieldInit]) i32 {
    acc := 0
    inits.loop((h, i, fi) {
        acc = acc.kv_kor(a.sx_expr_kind(taint, fi.value))
    })
    acc
}
sx_expr_kind = (a: MutPtr<Malloc>, taint: Ptr<DeadList>, e: Ptr<Expr>) i32 {
    load(e).match ({
        .Call(c)        => a.sx_call_kind(taint, c).kv_kor(a.sx_args_kind(taint, c.args)),
        .MethodCall(mc) => a.sx_mcall_kind(taint, mc).kv_kor(a.sx_expr_kind(taint, mc.recv)).kv_kor(a.sx_args_kind(taint, mc.args)),
        .Bin(b)         => a.sx_expr_kind(taint, b.lhs).kv_kor(a.sx_expr_kind(taint, b.rhs)),
        .Index(ix)      => a.sx_expr_kind(taint, ix.seq).kv_kor(a.sx_expr_kind(taint, ix.idx)),
        .Cond(d)        => a.sx_expr_kind(taint, d.c).kv_kor(a.sx_expr_kind(taint, d.t)).kv_kor(a.sx_expr_kind(taint, d.e)),
        .Member(m)      => a.sx_expr_kind(taint, m.obj),
        .Arrow(ar)      => a.sx_expr_kind(taint, ar.obj),
        .Match(m)       => a.sx_expr_kind(taint, m.subj).kv_kor(a.sx_arms_kind(taint, m.arms)),
        .MakeEnum(mk)   => a.sx_expr_kind(taint, mk.payload),
        .MakeStruct(s)  => a.sx_inits_kind(taint, s.inits),
        .SliceLit(sd)   => a.sx_args_kind(taint, sd.items),
        .Loop(l)        => a.sx_expr_kind(taint, l.seq).kv_kor(a.sx_body_kind(a.dead_remove(a.dead_remove(a.dead_remove(taint, l.idx), l.elem), l.h), l.body)),
        .Lambda(lm)     => a.sx_body_kind(a.sx_drop_params(taint, lm.params), lm.body),
        .Block(b)       => a.sx_body_kind(taint, b.stmts),
        _               => 0,
    })
}
sx_stmt_kind = (a: MutPtr<Malloc>, taint: Ptr<DeadList>, st: Stmt) i32 {
    st.match ({
        .Let(l)      => a.sx_expr_kind(taint, l.value),
        .Assign(x)   => a.sx_expr_kind(taint, x.target).kv_kor(a.sx_expr_kind(taint, x.value)),
        .Return(r)   => a.sx_expr_kind(taint, r),
        .ExprStmt(e) => a.sx_expr_kind(taint, e),
        .If(f)       => a.sx_expr_kind(taint, f.c).kv_kor(a.sx_body_kind(taint, f.then)).kv_kor(a.sx_body_kind(taint, f.els)),
        .While(w)    => a.sx_expr_kind(taint, w.c).kv_kor(a.sx_body_kind(taint, w.body)),
        .IndexSet(x) => a.sx_expr_kind(taint, x.seq).kv_kor(a.sx_expr_kind(taint, x.idx)).kv_kor(a.sx_expr_kind(taint, x.value)),
    })
}
sx_body_kind = (a: MutPtr<Malloc>, taint: Ptr<DeadList>, body: [Stmt]) i32 {
    acc := 0
    t := taint
    body.loop((h, i, st) {
        acc = acc.kv_kor(a.sx_stmt_kind(t, st))
        t = a.sx_step(t, st)
    })
    acc
}
sx_func_kind = (a: MutPtr<Malloc>, f: Func) i32 { a.sx_body_kind(a.dead_nil(), f.body) }
check_module_scratch_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    acc := 0
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DFunc(f) => a.sx_func_kind(f),
            _         => 0,
        }))
    })
    acc
}
check_module_scratch* = (a: MutPtr<Malloc>, decls: [Decl]) i32 { (a.check_module_scratch_kind(decls) == 0).match ({
    true  => 0,
    false => 1,
}) }
// name the value in the message (teach-the-fix, spec §5): copy the identifier the caret points at
// out of the source; a non-identifier anchor (a slice literal's first item, a synthesized pos)
// falls back to a generic subject.
sx_push_name = (s: String, a: MutPtr<Malloc>, src: string_view, pos: i32, i: i32, w: i32) String {
    (i >= w).match ({
        true  => s,
        false => sx_push_name(s.gstr_push(a, src.at(pos + i)), a, src, pos, i + 1, w),
    })
}
sx_subject = (a: MutPtr<Malloc>, src: string_view, pos: i32, w: i32) string_view {
    src.at(pos).is_alnum().match ({
        true  => a.gstr_string(w + 4).gstr_append(a, "`").sx_push_name(a, src, pos, 0, w).gstr_append(a, "`").gstr_finish(a),
        false => "this value",
    })
}
sx_message = (a: MutPtr<Malloc>, code: i32, subject: string_view) string_view {
    tail := (code == KSCRATCHSEND()).match ({
        true  => " is spawner-local scratch memory (allocator/arena/stack storage) and crosses an actor boundary in this send; the sender frees it independently of the receiving actor (use-after-free)",
        false => " is spawner-local scratch memory (allocator/arena/stack storage) embedded in the initial actor state; the actor outlives the spawner's scratch (use-after-free)",
    })
    a.gstr_string(256).gstr_append(a, subject).gstr_append(a, tail).gstr_finish(a)
}
sx_hint = (code: i32) string_view {
    (code == KSCRATCHSEND()).match ({
        true  => "construct inside the actor, or promote with `.share(alloc)` (Arc) / `.give(alloc)` (iso move) — see docs/two-memory-design.md",
        false => "construct inside the actor, promote with `.share(alloc)` / `.give(alloc)`, or pass state as plain values — see docs/two-memory-design.md",
    })
}
check_module_scratch_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    packed := a.check_module_scratch_kind(decls)
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => {
            code := packed & 63
            pos := packed >> 6
            w := src.diagnostic_span_width(pos)
            CheckDiagnostic(
                code: code,
                kind: "scratch-escape",
                source_offset: pos,
                span_width: w,
                count: 1,
                message: a.sx_message(code, a.sx_subject(src, pos, w)),
                hint: code.sx_hint(),
            )
        },
    })
}
