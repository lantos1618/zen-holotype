// SUPERVISION policy proof (S5): a Temporary child is NOT restarted. Same crash as the money-shot, but the
// supervisor's policy is Temporary — so on death it leaves the child dead (observably), never respawns it.
// This proves the policy actually gates the restart (it is not "always restart"): Permanent recovers,
// Temporary does not.
//
// TIMELINE: Work(10), Poison(0) → the Work runs (acc == 10), the Poison panics (actor DEAD). supervise under
// Temporary returns the SAME child (no restart). A further Work sent to the dead actor is dead-lettered.
//
// PROOF (exit 33 iff ALL hold):
//   crashed           — the agent is observably DEAD after the poison.
//   not_restarted     — Temporary did NOT restart it (restart count unchanged).
//   still_dead        — it stays dead after supervise (no fresh instance).
//   dropped == 1      — the post-crash Work was dead-lettered (backlog freed + counted).
//   acc == 10         — only the single pre-poison Work ran; nothing after the crash.
{ pool_open, pool_quiesce, pool_quiesce_stop, pool_close, pool_dropped, pool_actor_dead, Pool } = std.concurrent.pool
{ malloc, free } = std.mem.alloc
{ dispatch } = std.concurrent.pool_actor
pa = std.concurrent.pool_actor
{ Context, Receiver } = std.concurrent.pool_actor
WORKERS := 2
CAP := 64
Msg*: Work(i64) | Poison(i64)
Agent*: {
    acc: RawPtr<u8>,
    seen: i64,
}
Agent.impl(Receiver, {
    receive = (a: MutPtr<Agent>, ctx: Context<Msg>) void {
        ctx.msg.match ({
            .Work(n)   => {
                atomic_add_i64(a.acc, n)
                a.seen = a.seen + 1
            },
            .Poison(d) => {
                boom := 100 / d    // d == 0 → PANIC → actor marked dead
                atomic_add_i64(a.acc, boom)
            },
        })
    }
})
tramp = (user: RawPtr<u8>, msg: i64) void { dispatch<Agent, Msg>(user, msg) }
main = () i32 {
    acc := malloc(8)
    store_i64(acc, 0)
    spec := pa.child_spec(CAP, Agent(
        acc: acc,
        seen: 0,
    ), tramp, pa.temporary())
    child0 := pa.start_child(spec)
    p := pool_open(WORKERS, 16)
    p.send(child0.handle, Msg.Work(10))
    p.send(child0.handle, Msg.Poison(0))
    p.send(child0.handle, Msg.Work(10))
    p.pool_quiesce()
    crashed := pool_actor_dead(child0.handle.raw)
    dropped := p.pool_dropped()
    acc_val := load_i64(acc)
    child1 := child0.supervise()    // Temporary → no restart
    not_restarted := child1.restarts == child0.restarts
    still_dead := pool_actor_dead(child1.handle.raw)
    p.pool_quiesce_stop()
    pa.close(child1.handle)
    p.pool_close()
    free(acc)
    ok := crashed && not_restarted && still_dead && dropped == 1 && acc_val == 10
    ok.match ({ true => 33, false => 1 })
}
