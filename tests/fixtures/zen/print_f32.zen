// f32 values print through Display like every other numeric — before the f32 impl existed,
// `println(x: f32)` PASSED check and died at link ("undefined reference to fmt_println").
{ println, print } = std.text.fmt
main = () i32 {
    x: f32 = 1.5
    println(x)
    y: f32 = 0.25
    print(y)
    println(x)
    z: f32 = 100.0
    println(z)
    0
}
