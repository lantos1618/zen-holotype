// the other side of the shallow rule. `items` is a `:` field holding
// a Vec — storage, not a handle — so a bitwise copy of the Bag would
// NOT see `add`'s write, and `add` needs `::`.
//
// contrast corpus/own/handle_method_through_immutable_field.zen, where
// the `:` field is an Alloc and calling through it is legal. same
// field marker, different answer, decided by the bitwise-copy test.

Bag = {
    items: Vec<i32>,
}

Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    alloc ::= env.mem.alloc();
    b ::= Bag(items: alloc.Vec<i32>());
    b.items.add(1).try();
    Ok(0);
}
