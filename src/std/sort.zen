// std.sort — in-place, NON-RECURSIVE comparison sorting + binary search over a mutable `[T]` slice.
//
// ALGORITHM = HEAPSORT (in-place, O(1) extra space, guaranteed O(n log n), NO recursion). This is a
// deliberate choice forced by the test/dev build: the generated C is compiled with NO optimization
// (the harness's `cc -std=gnu11 -w` carries no -O flag), so C tail calls are NOT eliminated and any
// self-recursive sort — quicksort's partition recursion, top-down mergesort — SEGFAULTS at depth
// ~O(log n)..O(n) on a large input (the same trap std.text.sb documents for `rep`). Heapsort sinks
// (`sort_sift_down`) via an ITERATIVE descend loop and drives its build/extract phases with bounded
// `.loop` passes, so the C stack never grows with n. No scratch buffer, no allocator, cannot OOM.
//
// SURFACE (all `*` exported). Every op is comparator-driven at its core; the bare-`<` convenience forms
// delegate with a default `(a, b) a < b` (verified to type-check generically for scalar T — i64/f64/…).
// For struct/aggregate T (where bare `<` has no meaning) call the `_by` forms with your own comparator.
//
//   xs.sort()                      in-place ascending by `<`            (heapsort)
//   xs.sort_by((a, b){ a < b })    in-place, comparator-driven          (the core; `>` ⇒ descending)
//   xs.is_sorted()                 non-decreasing by `<`?               (bool)
//   xs.is_sorted_by(less)          non-decreasing by `less`?            (bool)
//   xs.binary_search(target)       index of a match, else `.None`       (Opt<i64>; requires sorted input)
//   xs.binary_search_by(t, less)   comparator form of the above         (Opt<i64>)
//   xs.lower_bound(k)              first index not less than k (`Ord`)  (i64; requires sorted input)
//
// The comparator `less(a, b)` returns true when `a` must sort BEFORE `b`. binary_search treats
// `!less(a,b) && !less(b,a)` as equality, so it needs no separate `==` on T.
//
// IMPLEMENTATION NOTES (why the loops look the way they do):
//   sort_sift_down — sinks the element at `root` down the max-heap region xs[start..end) until the heap
//     property holds. Each pass drops `root` to its larger child, at most ⌊log2(end)⌋ times — strictly
//     fewer than `end ≤ xs.len` steps, so the bounding `.loop` (0..xs.len) always has enough iterations
//     and `h.break`s the moment `root` has no larger child. "a is greater than b" ≡ `less(b, a)`.
//   sort_by PHASE 1 — build a max-heap: sift each internal node down, index `half-1-k` walking ⌊n/2⌋-1
//     back to 0 (there are exactly ⌊n/2⌋ internal nodes, all in-slice); the 0..n `.loop` counter `k`
//     drives it and breaks once the index passes 0.
//   sort_by PHASE 2 — move the max (root) to the end, shrink the heap, re-sift the root; `end` walks
//     n-1 down to 1, driven by the same 0..n counter, breaking at end<1.
//   binary_search_by — the [lo,hi) window halves each pass (≤⌈log2(n)⌉ times, bounded by the 0..xs.len
//     `.loop`), breaking when the window empties or a match is found. Empty slice ⇒ `.None`.
{ Opt } = std.core.result
{ Ord } = std.cmp
sort_sift_down<T> = (xs: [T], start: i64, end: i64, less: (T, T) bool) void {
    root ::= start
    xs.loop((h, step, _) {
        child = 2 * root + 1
        (child >= end).match ({
            true  => h.break,
            false => {
                c = (child + 1 < end && less(xs[child], xs[child + 1])).match ({
                    true  => child + 1,
                    false => child,
                })
                less(xs[root], xs[c]).match ({
                    true  => {
                        tmp = xs[root]
                        xs[root] = xs[c]
                        xs[c] = tmp
                        root = c
                    },
                    false => h.break,
                })
            },
        })
    })
}
sort_by*<T> = (xs: [T], less: (T, T) bool) void {
    n = xs.len
    (n <= 1 == false).then({
        half = n / 2
        xs.loop((h, k, _) {
            i = half - 1 - k
            (i < 0).then({ h.break }, { xs.sort_sift_down(i, n, less) })
        })
        xs.loop((h, k, _) {
            end = n - 1 - k
            (end < 1).match ({
                true  => h.break,
                false => {
                    tmp = xs[0]
                    xs[0] = xs[end]
                    xs[end] = tmp
                    xs.sort_sift_down(0, end, less)
                },
            })
        })
    })
}
sort*<T> = (xs: [T]) void { xs.sort_by((a: T, b: T) bool { a < b }) }
is_sorted_by*<T> = (xs: [T], less: (T, T) bool) bool {
    ok ::= true
    xs.loop((h, i, x) {
        (i > 0).then({
            less(xs[i], xs[i - 1]).then({
                ok = false
                h.break
            })
        })
    })
    ok
}
is_sorted*<T> = (xs: [T]) bool { xs.is_sorted_by((a: T, b: T) bool { a < b }) }
binary_search_by*<T> = (xs: [T], target: T, less: (T, T) bool) Opt<i64> {
    lo ::= 0
    hi ::= xs.len
    found :: Opt<i64> = .None
    xs.loop((h, step, _) {
        (lo >= hi).match ({
            true  => h.break,
            false => {
                mid = lo + (hi - lo) / 2
                less(xs[mid], target).match ({
                    true  => {
                        lo = mid + 1
                    },
                    false => less(target, xs[mid]).match ({
                        true  => {
                            hi = mid
                        },
                        false => {
                            found = .Some(mid)
                            h.break
                        },
                    }),
                })
            },
        })
    })
    found
}
binary_search*<T> = (xs: [T], target: T) Opt<i64> {
    xs.binary_search_by(target, (a: T, b: T) bool { a < b })
}
// First index in sorted `ks` whose key is NOT LESS THAN `k` (insertion point; equals `k`'s index
// when present). Iterative binary search — O(log n), bounded stack.
lower_bound*<K: Ord> = (ks: [K], k: K) i64 {
    lo ::= 0
    hi ::= ks.len
    ks.loop((h, step, _) {
        (lo >= hi).match ({
            true  => h.break,
            false => {
                mid = lo + (hi - lo) / 2
                (ks[mid].cmp(k) < 0).match ({
                    true  => { lo = mid + 1 },
                    false => { hi = mid },
                })
            },
        })
    })
    lo
}
