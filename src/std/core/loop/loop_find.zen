// src/std/core/loop/loop_find.zen
// the loop words that delete guards, and the two that allocate.
//
// "A `.then` inside a loop is usually a missing loop word" - these
// are the words it is missing. find stops at the first match;
// filter keeps every match; map keeps a value per element.
//
// SPLIT OUT BY NAME, NOT OVERLOADED. map and filter take an Alloc
// and so they cannot be overloads of loop: a generic `init: A`
// swallows a concrete `alloc: Alloc`, so fold's
// `(range, init, body)` and a hypothetical `(range, alloc, body)`
// are the same signature to resolution and could not be told
// apart. A different name is honest anyway - these are the ones
// that allocate, and law 1 says the signature answers that.
//
// find takes no Alloc, so it cannot allocate, so it returns
// Res<T> rather than a collection. A miss is None, not a trap: a
// search that legitimately finds nothing is not a bug.
//
// UNLIKE loop_iter.zen, all three are written out. They are
// ordinary Zen over the primitive, and writing them is the proof
// that h.break is a general language feature rather than a
// privilege the compiler grants to one name - find is three lines
// and the third one is a break.

// Vec crosses a folder boundary, and it is the one dependency this
// module has that its siblings do not: map and filter say Vec in
// their return types, so std.core.loop knows std.collections. That
// is the order PLAN.md 0.6 already builds in - Vec at step 3, the
// loop family at step 5 - and it is why the Range impl for Vec
// lives over there rather than here.
Res, Ok, None = std.core.result
then          = std.core.bool
Alloc         = std.mem
Vec           = std.collections
Range         = std.core.range
LoopHandle    = std.core.loop.loop_handle
loop          = std.core.loop.loop_iter

// the first element the predicate accepts, or None. the predicate
// takes only the value: there is no handle, because a predicate
// that could break is a find, and this is it.
find*<R: Range<T>, T> = (range: R, pred: (value: T) bool) Res<T> {
    range.loop((h, value) {
        pred(value).then(() { h.break(value) });
    })
}

// every element the predicate accepts, in order. nothing matching
// is an empty Vec and NOT a None - the walk succeeded, it just
// kept nothing.
//
// None is reserved for the one real failure: the Vec could not
// grow. Res<Vec<T>> has no Err channel to carry AllocError, and
// law 4 forbids inventing one - a None never becomes an Err and an
// Err never quietly becomes a None. So the break below is what
// out-of-memory looks like from the outside, and a caller that
// needs to act on it writes `.ok_or(..)`, which is the required
// form for naming a reason.
filter*<R: Range<T>, T> = (range: R, alloc: Alloc, pred: (value: T) bool) Res<Vec<T>> {
    kept ::= alloc.Vec<T>();
    room ::= true;
    range.loop((h, value) {
        pred(value).then(() {
            kept.add(value).match({
                Ok(_)  => (),
                Err(_) => { room = false; h.break(); },
            });
        });
    });
    room.match({
        true  => Ok(kept),
        false => None,
    })
}

// a value per element, collected into a Vec. the body takes the
// handle as well as the index and the value, so a map may stop
// early - it keeps what it made, because a partial map that
// reports nothing would throw away work the body already did.
map*<R: Range<T>, T, U> = (range: R, alloc: Alloc, body: (h: LoopHandle, index: usize, value: T) U) Res<Vec<U>> {
    made ::= alloc.Vec<U>();
    room ::= true;
    range.loop((h, index, value) {
        made.add(body(h, index, value)).match({
            Ok(_)  => (),
            Err(_) => { room = false; h.break(); },
        });
    });
    room.match({
        true  => Ok(made),
        false => None,
    })
}
