// tools/fleet/fleet.zen
// The agent-fleet runner, in Zen — every part of it a Zen program can hold.
//
// On 2026-08-24 this repository was worked by ~180 concurrent agents driven
// by `run_lane.sh`, `xargs -P`, `flock` and `timeout`. Zen claims to be a
// systems language; a systems language that cannot express its own fleet
// runner has been told something about itself. This file is that experiment,
// and it stops exactly where the language does.
//
// WHAT IT DOES, AND WHAT THE SHELL STILL DOES. The policy — the work list,
// the success PREDICATE, the retry counters, the backoff, the round report
// — is here. The three system calls are not:
//
//     spawn a child      no. `std.env.Env` has no process capability and
//                        there is no ffi to reach `posix_spawn` (#748,
//                        #749). The emitted C includes stdio/stdlib/
//                        string/sys-stat and nothing else — there is no
//                        `unistd.h` in a Zen program, ever.
//     wait on N children no, for the same reason, and `env.threads.spawn`
//                        does not lower either (#750).
//     lock the box       no; `flock` is an ffi call (#752).
//     read the clock     no. `std.core.time` says "reading the clock is
//                        authority (lives on Env)" and `Env` has no clock
//                        field (#751), so the wall time below is two
//                        integers the driver wrote down for us.
//
// So `fleet.sh` is the fork/exec/flock/timeout, ~30 lines, and it makes no
// decisions: it runs the lane list this program writes and calls back in.
// That division is the finding, not a workaround for it — every line of
// judgement the four shell scripts carried now lives in one type-checked
// program, and what is left in bash is precisely what Zen cannot say.
//
// THE PREDICATE IS THE POINT. A lane returns 0 while doing nothing — a 429
// from a shared model pool arrives as an empty reply and a clean exit — so
// the exit code is not evidence. `run_lane.sh` used `git diff --quiet` on
// the target; this program takes its own snapshot at `plan` and compares
// bytes at `judge`, which is the same test without needing a git working
// tree. A job whose baseline is MISSING is not a pass and not a failure:
// it is "this program never looked", counted separately and exiting 2, the
// rule `tools/gates/line_cap.zen` follows for a file it could not read.
//
// WHY THE LANE LIST IS A FILE AND THE REPORT IS STDOUT. `std.env.Console`
// has one member, `println`, and it writes to stdout — a Zen program has no
// stderr (#754). A tool whose output another process parses therefore
// cannot also narrate, so the machine-readable half goes to
// `<state>/lanes` and the human half is printed.
//
// THREE FILES. `fleet_text.zen` turns bytes into lines and fields and
// knows nothing about jobs; `fleet_state.zen` is the state directory and
// knows a job only by its NAME; every decision is here.
//
//     fleet plan   <worklist> <state>          take baselines, write lanes
//     fleet judge  <worklist> <state> <tries>  adjudicate, write next lanes
//     fleet report <worklist> <state>          the counts and the wall time
//
// A work list line is three whitespace-separated fields — name, prompt
// path, target path. `#` starts a comment; blank lines are skipped.

Alloc, AllocError = std.mem
str, String = std.text
Vec = std.collections
Range = std.core
Duration, unit_of, count_in, suffix, nanos = std.core.time
NS_PER_SECOND = std.core.time
FsError = std.env
lines_of, field, is_space, digits = fleet_text
state_path, count_of, set_count = fleet_state
set_done, done_at, write_lanes = fleet_state
note_fs, fs_word = fleet_state

// One row of the work list. `name` is the state-file stem and the
// identity in every report line, so it is the field a duplicate would
// corrupt — checked when the list is read, not when the state is written.
Job = {
    name*: str,
    prompt*: str,
    target*: str,
}

// What `judge` decided about one job this round.
Verdict = Done       // the target changed: the lane did something
        | Again      // it did not, and the job has tries left
        | Spent      // it did not, and the job is out of tries
        | Unknown    // no baseline: this program never looked

// The counters a round or a run reports. Kept as one value because they
// are produced together and read together, and threading five usizes
// through the loop below is how a miscount gets in.
Tally = {
    done* :: u64 = 0,
    again* :: u64 = 0,
    spent* :: u64 = 0,
    unknown* :: u64 = 0,
    retried* :: u64 = 0,
}

// The default retry ceiling, and the backoff step in seconds. Both match
// `run_lane.sh`: five attempts, sleeping 20s longer before each one. The
// step is here and not in the shell because it is policy.
TRIES: u64 = 5
BACKOFF_STEP: u64 = 20

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    (env.argv.len < 2).match({
        true  => usage(),
        false => dispatch(env, alloc, arg(env, 1)),
    })
}

dispatch = (env: Env, alloc: Alloc, verb: str) Res<i32, AllocError> {
    verb.eq("plan").match({
        true  => plan(env, alloc),
        false => dispatch_judge(env, alloc, verb),
    })
}

dispatch_judge = (env: Env, alloc: Alloc, verb: str) Res<i32, AllocError> {
    verb.eq("judge").match({
        true  => judge(env, alloc),
        false => dispatch_report(env, alloc, verb),
    })
}

dispatch_report = (env: Env, alloc: Alloc, verb: str) Res<i32, AllocError> {
    verb.eq("report").match({
        true  => report(env, alloc),
        false => unknown_verb(verb),
    })
}

usage = () Res<i32, AllocError> {
    println("fleet: the policy half of a fleet runner. Usage:");
    println("    fleet plan   <worklist> <state>");
    println("    fleet judge  <worklist> <state> [max-tries]");
    println("    fleet report <worklist> <state>");
    println("");
    println("    tools/fleet/fleet.sh is the fork/exec/flock half; it runs");
    println("    <state>/lanes and calls back in. See this file's header for");
    println("    why the two halves are not one program.");
    Ok(2);
}

unknown_verb = (verb: str) Res<i32, AllocError> {
    println("fleet: no such verb `{}` — plan, judge or report.", verb);
    Ok(2);
}

// -----------------------------------------------------------------
// plan: take the baselines, and write every job into the lane list
// -----------------------------------------------------------------

// THE BASELINE IS TAKEN ONCE, HERE, and never refreshed by `judge` — the
// question a retry asks is still "has this job changed the target since
// the fleet started", exactly as `run_lane.sh` asked it against HEAD. A
// lane that edits half a file and then dies has done something, and the
// next attempt reading a refreshed baseline would call that nothing.
plan = (env: Env, alloc: Alloc) Res<i32, AllocError> {
    (env.argv.len < 4).match({
        true  => usage(),
        false => plan_run(env, alloc, arg(env, 2), arg(env, 3)),
    })
}

plan_run = (env: Env, alloc: Alloc, list: str, state: str)
           Res<i32, AllocError> {
    env.fs.is_dir(state).match({
        false => no_state(state),
        true  => plan_jobs(env, alloc, list, state),
    })
}

plan_jobs = (env: Env, alloc: Alloc, list: str, state: str)
            Res<i32, AllocError> {
    jobs ::= alloc.Vec<Job>();
    bad  ::= read_jobs(env, alloc, list, jobs).try();
    (bad > 0 || jobs.len == 0).match({
        true  => bad_list(list, bad, jobs.len),
        false => plan_lanes(env, alloc, state, jobs),
    })
}

plan_lanes = (env: Env, alloc: Alloc, state: str, jobs: Vec<Job>)
             Res<i32, AllocError> {
    lanes      ::= alloc.String().try();
    unwritable ::= 0;
    jobs.loop((h, j) {
        snapshot(env, alloc, state, j).try().then(() {
            unwritable = unwritable + 1;
        });
        set_count(env, alloc, state, j.name, u64.MIN).try();
        set_done(env, alloc, state, j.name, false).try();
        lane_line(alloc, lanes, j, u64.MIN).try();
    });
    write_lanes(env, alloc, state, lanes.view()).try();
    println(
        "fleet plan: {} job(s), {} baseline(s) unwritable",
        jobs.len,
        unwritable
    );
    (unwritable > 0).match({ true => Ok(2), false => Ok(0) })
}

// The snapshot is the target's bytes behind a one-byte tag: `P` present,
// `A` absent. Without the tag a file that does not exist yet and a file
// that exists and is empty snapshot identically, and creating the file
// would read as no change — which is the exact failure this predicate
// exists to catch. Answers true when the baseline could not be written.
snapshot = (env: Env, alloc: Alloc, state: str, j: Job) Res<bool, AllocError> {
    tagged ::= alloc.String().try();
    env.fs.read(alloc, j.target).match({
        Ok(text) => tagged.fmt("P{}", text.view()),
        Err(_)   => tagged.add_bytes("A"),
    }).try();
    p ::= state_path(alloc, state, j.name, "base").try();
    env.fs.write(p.view(), tagged.view()).match({
        Ok(_)  => Ok(false),
        Err(e) => note_fs(p.view(), e),
    })
}

// -----------------------------------------------------------------
// judge: the predicate, the counters, and the next lane list
// -----------------------------------------------------------------

judge = (env: Env, alloc: Alloc) Res<i32, AllocError> {
    (env.argv.len < 4).match({
        true  => usage(),
        false => judge_run(env, alloc, arg(env, 2), arg(env, 3)),
    })
}

judge_run = (env: Env, alloc: Alloc, list: str, state: str)
            Res<i32, AllocError> {
    env.fs.is_dir(state).match({
        false => no_state(state),
        true  => judge_jobs(env, alloc, list, state, tries_arg(env)),
    })
}

// `max-tries` is optional and defaults to TRIES. A zero would mean "never
// retry anything", which is a plausible thing to want and an implausible
// thing to type by accident, so it is honoured rather than clamped.
tries_arg = (env: Env) u64 {
    (env.argv.len < 5).match({
        true  => TRIES,
        false => digits(arg(env, 4)),
    })
}

judge_jobs = (env: Env, alloc: Alloc, list: str, state: str, tries: u64)
             Res<i32, AllocError> {
    jobs ::= alloc.Vec<Job>();
    bad  ::= read_jobs(env, alloc, list, jobs).try();
    (bad > 0 || jobs.len == 0).match({
        true  => bad_list(list, bad, jobs.len),
        false => judge_lanes(env, alloc, state, jobs, tries),
    })
}

judge_lanes = (
    env   : Env,
    alloc : Alloc,
    state : str,
    jobs  : Vec<Job>,
    tries : u64
) Res<i32, AllocError> {
    lanes ::= alloc.String().try();
    t     ::= Tally();
    jobs.loop((h, j) {
        // A JOB THAT ALREADY PASSED IS NOT RE-JUDGED. Its lane did not run
        // this round, so asking the predicate again would count one success
        // once per remaining round and bump an attempt counter nothing spent.
        done_at(env, alloc, state, j.name).try().match({
            true  => { t.done = t.done + 1; },
            false => judge_one(env, alloc, state, j, tries, t, lanes).try(),
        });
    });
    write_lanes(env, alloc, state, lanes.view()).try();
    println(
        "fleet judge: {} ok, {} to retry, {} spent, {} unchecked",
        t.done,
        t.again,
        t.spent,
        t.unknown
    );
    verdict(t)
}

judge_one = (
    env   : Env,
    alloc : Alloc,
    state : str,
    j     : Job,
    tries : u64,
    t     :: Tally,
    lanes :: String
) Res<(), AllocError> {
    n = count_of(env, alloc, state, j.name).try() + 1;
    set_count(env, alloc, state, j.name, n).try();
    v = verdict_of(env, alloc, state, j, n, tries).try();
    count(t, v, n);
    v.match({
        Done  => set_done(env, alloc, state, j.name, true),
        Again => lane_line(alloc, lanes, j, BACKOFF_STEP * n),
        _     => say_lost_ok(j, v),
    })
}

say_lost_ok = (j: Job, v: Verdict) Res<(), AllocError> {
    say_lost(j, v);
    Ok(());
}

// THE PREDICATE. Bytes, against the snapshot `plan` took — not the exit
// code, which a lane that did nothing also sets to zero.
verdict_of = (
    env   : Env,
    alloc : Alloc,
    state : str,
    j     : Job,
    n     : u64,
    tries : u64
) Res<Verdict, AllocError> {
    p   ::= state_path(alloc, state, j.name, "base").try();
    now ::= alloc.String().try();
    env.fs.read(alloc, j.target).match({
        Ok(text) => now.fmt("P{}", text.view()),
        Err(_)   => now.add_bytes("A"),
    }).try();
    v ::= Verdict.Unknown;
    env.fs.read(alloc, p.view()).match({
        Err(_)   => {},
        Ok(base) => {
            v = base.view().eq(now.view()).match({
                false => Verdict.Done,
                true  => (n < tries).match({
                    true  => Verdict.Again,
                    false => Verdict.Spent,
                }),
            });
        },
    });
    Ok(v)
}

count = (t :: Tally, v: Verdict, n: u64) () {
    (n > 1).then(() { t.retried = t.retried + 1; });
    v.match({
        Done    => { t.done = t.done + 1; },
        Again   => { t.again = t.again + 1; },
        Spent   => { t.spent = t.spent + 1; },
        Unknown => { t.unknown = t.unknown + 1; },
    });
}

say_lost = (j: Job, v: Verdict) () {
    v.match({
        Spent => println(
            "{}: FAILED, {} unchanged after every try",
            j.name,
            j.target
        ),
        _     => println(
            "{}: NOT CHECKED — no baseline; run `fleet plan`",
            j.name
        ),
    });
}

// "I could not check" outranks "I checked and it failed", so an unchecked
// job exits 2 where a spent one exits 1 — the ordering `line_cap.zen`
// uses, and for the same reason: a setup error must not read as a verdict.
verdict = (t: Tally) Res<i32, AllocError> {
    (t.unknown > 0).match({
        true  => Ok(2),
        false => (t.spent > 0).match({ true => Ok(1), false => Ok(0) }),
    })
}

// -----------------------------------------------------------------
// report: the counts, and the one number Zen cannot produce
// -----------------------------------------------------------------

report = (env: Env, alloc: Alloc) Res<i32, AllocError> {
    (env.argv.len < 4).match({
        true  => usage(),
        false => report_run(env, alloc, arg(env, 2), arg(env, 3)),
    })
}

report_run = (env: Env, alloc: Alloc, list: str, state: str)
             Res<i32, AllocError> {
    jobs ::= alloc.Vec<Job>();
    bad  ::= read_jobs(env, alloc, list, jobs).try();
    (bad > 0 || jobs.len == 0).match({
        true  => bad_list(list, bad, jobs.len),
        false => report_jobs(env, alloc, state, jobs),
    })
}

report_jobs = (env: Env, alloc: Alloc, state: str, jobs: Vec<Job>)
              Res<i32, AllocError> {
    t ::= Tally();
    jobs.loop((h, j) {
        n = count_of(env, alloc, state, j.name).try();
        (n > 1).then(() { t.retried = t.retried + 1; });
        done_at(env, alloc, state, j.name).try().match({
            true  => { t.done = t.done + 1; },
            false => { t.spent = t.spent + 1; },
        });
    });
    println(
        "fleet: {} job(s): {} succeeded, {} failed, {} retried",
        jobs.len,
        t.done,
        t.spent,
        t.retried
    );
    wall(env, alloc, state);
    (t.spent > 0).match({ true => Ok(1), false => Ok(0) })
}

// THE WALL TIME IS TWO INTEGERS THE DRIVER WROTE DOWN. `Env` has no clock
// (#751), so this program cannot time anything it did not ask the shell
// to time for it; `<state>/t0` and `<state>/t1` hold `date +%s`. The
// arithmetic and the unit are Zen's — `std.core.time` is a span library
// with no clock behind it, which is exactly as far as it can go today.
wall = (env: Env, alloc: Alloc, state: str) () {
    t0 = stamp(env, alloc, state, "t0");
    t1 = stamp(env, alloc, state, "t1");
    (t1 >= t0 && t0 > 0).match({
        false => println("    wall time: unknown (no t0/t1 in {})", state),
        true  => say_wall(nanos((t1 - t0) * NS_PER_SECOND)),
    });
}

say_wall = (d: Duration) () {
    u = d.unit_of();
    println("    wall time: {}{}", d.count_in(u), u.suffix());
}

stamp = (env: Env, alloc: Alloc, state: str, name: str) u64 {
    // `0` is untyped and `0.to_u64()` will not parse — a literal carries
    // no member (num.zen) — so a u64 zero has to arrive from a named value.
    n ::= u64.MIN;
    state_path(alloc, state, name, "txt").match({
        Err(_) => {},
        Ok(p)  => {
            env.fs.read(alloc, p.view()).match({
                Ok(text) => { n = digits(text.view()); },
                Err(_)   => {},
            });
        },
    });
    n
}

// -----------------------------------------------------------------
// the work list
// -----------------------------------------------------------------

// Fills `jobs` and answers how many lines were malformed — each one named
// as it is read, because a work list is hand-written and "3 bad lines" is
// not something anyone can act on. A duplicate name is malformed too: two
// jobs sharing a state stem overwrite each other's baseline and the
// second one's verdict is about the first one's file.
read_jobs = (env: Env, alloc: Alloc, list: str, jobs :: Vec<Job>)
            Res<usize, AllocError> {
    bad ::= 0;
    env.fs.read(alloc, list).match({
        Err(e)   => {
            println("fleet: {}: {}", list, fs_word(e));
            bad = bad + 1;
        },
        Ok(text) => {
            lines ::= lines_of(alloc, text.view()).try();
            lines.loop((h, i, line) {
                read_line(line, i + 1, jobs).try().then(() {
                    bad = bad + 1;
                });
            });
        },
    });
    Ok(bad)
}

// Answers true when the line was bad. A blank or a comment is neither
// good nor bad — it is not a line.
read_line = (line: str, no: usize, jobs :: Vec<Job>) Res<bool, AllocError> {
    name = line.field(0);
    skip = name.is_empty() || name.index(0) == '#';
    keep ::= false;
    skip.match({
        true  => {},
        false => { keep = true; },
    });
    keep.match({
        false => Ok(false),
        true  => add_job(line, no, name, jobs),
    })
}

add_job = (line: str, no: usize, name: str, jobs :: Vec<Job>)
          Res<bool, AllocError> {
    prompt = line.field(1);
    target = line.field(2);
    (prompt.is_empty() || target.is_empty()).match({
        true  => short_line(no),
        false => add_named(name, prompt, target, no, jobs),
    })
}

add_named = (
    name   : str,
    prompt : str,
    target : str,
    no     : usize,
    jobs   :: Vec<Job>
) Res<bool, AllocError> {
    taken(jobs, name).match({
        true  => dup_line(no, name),
        false => {
            jobs.add(Job(name: name, prompt: prompt, target: target)).try();
            Ok(false);
        },
    })
}

taken = (jobs: Vec<Job>, name: str) bool {
    seen ::= false;
    jobs.loop((h, j) { j.name.eq(name).then(() { seen = true; }); });
    seen
}

short_line = (no: usize) Res<bool, AllocError> {
    println("fleet: line {}: wants three fields — name, prompt, target", no);
    Ok(true);
}

dup_line = (no: usize, name: str) Res<bool, AllocError> {
    println(
        "fleet: line {}: `{}` is already a job; names are state file",
        no,
        name
    );
    println("    stems, so two of them would judge one baseline twice.");
    Ok(true);
}

// A work list that matched nothing must not read as a clean run — the
// shape this repository keeps rediscovering, and the reason `make cap`
// asserts its own file count.
bad_list = (list: str, bad: usize, good: usize) Res<i32, AllocError> {
    (good == 0).then(() {
        println(
            "fleet: {} names no jobs — this runner is running nothing.",
            list
        );
    });
    (bad > 0).then(() {
        println(
            "fleet: {} unusable line(s) in {}; fix them and re-run.",
            bad,
            list
        );
    });
    Ok(2);
}

no_state = (state: str) Res<i32, AllocError> {
    println("fleet: {} is not a directory.", state);
    println("    The state directory holds one baseline and one attempt");
    println("    count per job; `fleet` does not create it, because a typo");
    println("    would then silently become an empty fleet. mkdir it.");
    Ok(2);
}

// -----------------------------------------------------------------
// the lane list, and argv
// -----------------------------------------------------------------

// One lane: name, prompt, target, and the seconds to sleep first. The
// whole line goes through `alloc.String` rather than `lanes.fmt(..)`,
// and not by preference — `String.fmt` lowers only `str` holes, so the
// backoff (a u64) is a `codegen does not lower this yet` on the second
// door for a format string the FIRST door compiles (#755).
lane_line = (a: Alloc, lanes :: String, j: Job, wait: u64)
            Res<(), AllocError> {
    one ::= a.String("{} {} {} {}\n", j.name, j.prompt, j.target, wait).try();
    lanes.add_bytes(one.view())
}

arg = (env: Env, i: usize) str {
    env.argv.get(i).match({ Ok(s) => s, None => "" })
}
