// INT32_MIN / -1 must PANIC at i32 width, not silently wrap. Before the fix, `/` widened operands to
// int64 before the `a==INT64_MIN` overflow check, so i32_min/-1 = 2147483648 fit in int64 (no panic) and
// truncated back to INT32_MIN on store — the i64 guard fired but the i32 one never did. The values are
// built opaquely so the divide is a runtime `zen__divz32`, not constant-folded away.
neg_one = () i32 { 0 - 1 }
i32_min = () i32 { 0 - 2147483647 - 1 }
main = () i32 {
    q := i32_min() / neg_one()
    q - q
}
