Box = { text :: str, put = (self :: @Self, text: str) () { self.text = text; } }
store = (box :: Box, text: str) () { box.text = text; }
read_only = (text: str) usize { text.len }
fill = (a: Alloc, box :: Box) Res<(), AllocError> {
    text = a.String("hello").try();
    store(box, text.view());
    box.put(text.view());
    Ok(())
}
main = (env: Env) Res<(), AllocError> {
    a = env.mem.alloc();
    box ::= Box(text: "");
    fill(a, box).try();
    println("{} {}", box.text, read_only(box.text));
    local ::= Box(text: "");
    text = a.String("local").try();
    store(local, text.view());
    println(local.text);
    Ok(())
}
