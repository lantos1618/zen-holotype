// src/gen/gen_c/gen_c_threads.zen
// The threads capability in C — lowering and floor in one file, the
// shape `gen_c_clock.zen` set, so the call site and the C it names
// cannot drift apart.
//
// `Threads.sleep` is bodiless in `std/env/env.zen`: the authority
// itself, reached only as `env.threads`, and its floor is `nanosleep`.
// The floor is POSIX, not C99, so the feature-macro block is the clock's
// (`need_clock`); the emission of the static itself is this floor's own
// flag, because a program that sleeps must not be handed an uncalled
// function to warn about.
//
// NO FAILURE MODE A CALLER ACTS ON. `nanosleep` answers EINTR when a
// signal lands mid-sleep; a Zen program has no signal handling to
// interrupt, so the retry loop is all there is and the signature
// answers unit, not Res.
//
// THE RECEIVER IS NOT LOWERED, exactly as `env.clock` never lowers the
// Env it resolved through: `env.threads` is a field read of a record
// whose slots this path does not call.

Call = std.ast
AllocError = std.mem
str, String = std.text
TyId = sema.sema_ty
Ctx = sema.sema_check
Emit = gen.gen_emit
CBackend = gen.gen_c.gen_c_state
ctype = gen.gen_c.gen_c_type
comment = gen.gen_c.gen_c_runtime

// -----------------------------------------------------------------
// THE FLOOR: `nanosleep`, emitted only for a program that sleeps — an
// uncalled `static` is a warning.
// -----------------------------------------------------------------
emit_threads* = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    be.uses_threads().match({
        false => Ok(()),
        true  => be.write_sleep(out),
    })
}

write_sleep = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    out.say("#include <errno.h>").try();
    out.line().try();
    comment(out, "the sleep floor is POSIX nanosleep").try();
    out.say("static void zg_threads_sleep(uint64_t ms) {").try();
    out.indent();
    out.say("struct timespec ts;").try();
    out.say("ts.tv_sec = (time_t)(ms / UINT64_C(1000));").try();
    out.say("ts.tv_nsec = (long)((ms % UINT64_C(1000)) * UINT64_C(1000000));").try();
    out.say("while (nanosleep(&ts, &ts) != 0 && errno == EINTR) {}").try();
    out.dedent();
    out.say("}").try();
    out.line();
}

// -----------------------------------------------------------------
// THE LOWERING: `env.threads.sleep(ms)`
//
// Sleep answers unit, but the lowering stands where an expression was,
// so the statement is written and `0` is left where the value goes —
// unit is zero-width in C and nothing reads it.
// -----------------------------------------------------------------
lower_sleep* = (
    be   :: CBackend,
    c    : Call,
    ret  : TyId,
    ctx  : Ctx,
    out :: String
) Res<(), AllocError> {
    be.need_clock();
    be.need_threads();
    be.request_type(ret).try();
    usize_ty = be.check.types.prim("usize").try();
    ms ::= be.alloc.String().try();
    be.arg_text(c, 0, usize_ty, ctx, ms).try();
    be.fmt("zg_threads_sleep({});\n", ms.view()).try();
    out.add_bytes("0")
}
