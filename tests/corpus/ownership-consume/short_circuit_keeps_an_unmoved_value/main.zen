// A consume writes the binding's live flag. That write must remain inside a
// short-circuit branch so a skipped move still leaves the value to be dropped.

Noisy = {
    env: Env,
    tag: str,
    flag: bool,
}

Noisy.impl(Drop, {
    drop = (self :: @Self) () { self.env.out.println("drop {}", self.tag) }
})

main = (env: Env) Res<i32, IoError> {
    value = Noisy(env: env, tag: "kept", flag: true);
    ran   = false && (consume value).flag;
    println("ran {}", ran);
    Ok(0)
}
