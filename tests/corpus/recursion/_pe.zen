// probeE: per-frame drop during unwinding
Noisy = {
    env: Env,
    tag: str,
}

Noisy.impl(Drop, {
    drop = (self :: @Self) () { self.env.out.println("drop {}", self.tag) }
})

chain = (env: Env, n: i64) i64 {
    (n == 0).match({
        true  => 0,
        false => {
            f = Noisy(env: env, tag: "f");
            chain(env, n - 1) + 1;
        },
    });
}

main = (env: Env) Res<i32, IoError> {
    println("chain {}", chain(env, 3));
    Ok(0);
}
