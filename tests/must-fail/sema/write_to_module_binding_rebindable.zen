// `::=` DOES NOT SPELL A MUTABLE STATIC EITHER.
//
// The local rebinding diagnostic advises "declare it `::=` to assign to
// it"; at module level that advice produced the same silent discard --
// `bump()` printed 1 twice with `C` still 0, exit 0 (issue #783's second
// face). Module-level bindings are constants whichever marker they
// carry, so this is refused by the same rule as its plain-`=` sibling,
// write_to_module_binding: the write lands on a constant either way.
//
// position: the target name, for the same reason.

C ::= 0

bump = () i32 { C = C + 1; C }

main = (env: Env) Res<i32> {
    println("{} {} {}", bump(), bump(), C);
    Ok(0);
}
