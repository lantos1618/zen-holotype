// a newline arrives before the closing quote. a string literal does not
// span lines, so this is unterminated at the newline -- not a multiline
// string.
//
// THE CLOSING QUOTE IS ON THE NEXT LINE, and that is the whole test. With
// no quote anywhere after it, a newline-blind scanner hunts to EOF, finds
// nothing, and reports UnterminatedString at this same opening quote -- so
// the old shape of this file passed whether the spans-a-line rule existed or
// not, and was a duplicate of eof_in_string. Here a newline-blind scanner
// instead lexes "abc\ndef" as ONE valid string, the file compiles, and this
// must-fail test goes red.
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    println("abc
def");
    Ok(0);
}
