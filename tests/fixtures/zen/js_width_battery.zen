// js_width_battery.zen — dual-backend fixed-width integer cross-check (census #64). Every line is a
// value that WRAPS at its type's width, so the C backend and the js/node backend must print the
// SAME thing (they disagreed before the width masks + Math.imul 32-bit multiply landed).
//   C:  zenc run tests/fixtures/zen/js_width_battery.zen
//   JS: zenc build --target js tests/fixtures/zen/js_width_battery.zen -o /tmp/b.js && node /tmp/b.js
{ println } = std.text.fmt
// FNV-1a-32 over the low `n` bytes of `data` — the classic 32-bit hash whose `* 16777619` step
// overflows an f64 mantissa (product > 2^53) unless the multiply is done mod 2^32.
fnv1a = (data: StringView, n: i32) u32 {
    hash: u32 := 2166136261
    i := 0
    @while (i < n) {
        b: u8 := load(offset(data, i))
        hash = (hash ^ b) * 16777619
        i = i + 1
    }
    hash
}
main = () i32 {
    u8v: u8 := 200
    u8v = u8v + 100
    println(u8v)    // 300 & 255 = 44
    u16v: u16 := 60000
    u16v = u16v + 10000
    println(u16v)    // 70000 & 0xffff = 4464
    u32a: u32 := 100000
    u32b: u32 := 100000
    u32c: u32 := u32a * u32b
    println(u32c)    // 10^10 mod 2^32 = 1410065408
    i32a: i32 := 100000
    i32c: i32 := i32a * i32a
    println(i32c)    // 1410065408 (signed, still positive here)
    i16v: i16 := 30000
    i16v = i16v + 10000
    println(i16v)    // 40000 -> -25536 (sign-extended)
    i8v: i8 := 100
    i8v = i8v + 50
    println(i8v)    // 150 -> -106
    println(fnv1a("hello", 5))    // 1335831723
    println(fnv1a("The quick brown fox", 19))
    0
}    // 2924308450
