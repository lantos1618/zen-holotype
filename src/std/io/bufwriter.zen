// std.io.bufwriter — a buffered output sink over a file descriptor.
//
// `println`/`out` in std.io/std.text.fmt issue one write(2) per call, so an output-heavy program
// (e.g. printing millions of lines) is dominated by syscall overhead. A BufWriter accumulates bytes
// in a growable buffer and flushes them in ONE write(2) when the buffer reaches its limit or on an
// explicit flush/close. It is OPT-IN: the unbuffered path stays the default (the compiler/driver rely
// on its immediate, unbuffered semantics), and this is a separate sink a program wraps stdout with.
//
//   m = std.mem.alloc.request_arena(std.mem.alloc.heap_allocator())
//   w = m.addr().stdout_bufw_in(64 * 1024).expect("oom")
//   wp = w.addr()
//   wp.bufw_println(m.addr(), "line").or_return()   // buffered — no syscall until the buffer fills
//   wp.bufw_close(m.addr())                          // flushes the tail and frees the buffer
//
// FLUSH CONTRACT: buffered bytes are NOT visible until a flush. `bufw_close` (flush + free) is
// mandatory before the writer goes out of scope, or trailing output is lost — an explicit, obvious
// close rather than hidden magic.
{ String, init, append_in, append_slice_in, free_in } = std.text.string
{ write_all } = std.io.file
{ Result, IoError, ok, err } = std.core.result
{ AllocatorBackend } = std.mem.alloc
// A buffered writer: the target fd, the accumulation buffer, and the byte count that triggers an
// auto-flush. The buffer is a functional String header (ptr,len,cap); we thread its updates back
// through the in-place BufWriter so a program keeps one live writer.
BufWriter*: {
    fd: i32,
    buf: String,
    limit: i64,
}
// Open a buffered writer over `fd` with a `cap`-byte buffer (also the auto-flush threshold).
bufw_open_in* = (a: AllocatorBackend, fd: i32, cap: i64) Result<BufWriter, IoError> {
    a.init(cap).match ({
        .Ok(s)  => ok(BufWriter(
            fd: fd,
            buf: s,
            limit: cap,
        )),
        .Err(e) => err(e),
    })
}
// Open a buffered writer over stdout (fd 1).
stdout_bufw_in* = (a: AllocatorBackend, cap: i64) Result<BufWriter, IoError> {
    a.bufw_open_in(1, cap)
}
// Write the buffered bytes to the fd in one write_all, then reset the buffer length to 0 (keeping the
// allocation). A write failure (EPIPE/ENOSPC) surfaces as a value.
bufw_flush* = (w: MutPtr<BufWriter>) Result<i64, IoError> {
    b = w.buf
    (b.len <= 0).match ({
        true  => ok(0),
        false => write_all(w.fd, b.ptr, b.len, 0).match ({
            .Ok(n)  => {
                w.buf = String(
                    ptr: b.ptr,
                    len: 0,
                    cap: b.cap,
                )
                ok(n)
            },
            .Err(e) => err(e),
        }),
    })
}
// Auto-flush helper: after appending, flush if the buffer reached its limit.
bufw_after_append = (w: MutPtr<BufWriter>, nb: String) Result<i64, IoError> {
    w.buf = nb
    (nb.len >= w.limit).then({ w.bufw_flush() }, { ok(nb.len) })
}
// Append a StringView to the buffer, auto-flushing at the limit.
bufw_write* = (w: MutPtr<BufWriter>, a: AllocatorBackend, s: StringView) Result<i64, IoError> {
    w.buf.append_in(a, s).match ({
        .Ok(nb) => w.bufw_after_append(nb),
        .Err(e) => err(e),
    })
}
// Append length-carrying bytes (binary-safe, no NUL truncation), auto-flushing at the limit.
bufw_write_bytes* = (w: MutPtr<BufWriter>, a: AllocatorBackend, bytes: [u8]) Result<i64, IoError> {
    a.append_slice_in(w.buf, bytes).match ({
        .Ok(nb) => w.bufw_after_append(nb),
        .Err(e) => err(e),
    })
}
// Write a line: the text followed by a newline.
bufw_println* = (w: MutPtr<BufWriter>, a: AllocatorBackend, s: StringView) Result<i64, IoError> {
    w.bufw_write(a, s).match ({
        .Ok(n)  => w.bufw_write(a, "\n"),
        .Err(e) => err(e),
    })
}
// Flush the tail and free the buffer. Mandatory before the writer goes out of scope.
bufw_close* = (w: MutPtr<BufWriter>, a: AllocatorBackend) Result<i64, IoError> {
    r = w.bufw_flush()
    w.buf.free_in(a)
    r
}
