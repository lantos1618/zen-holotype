// AN IMPL MEMBER WITH A BODY, SUPPLIED BY AN ENUM — the encoding Zen
// offers for attaching values to variants. Before
// `gen_c_impl.decl_name` answered an enum's name, every impl search was
// keyed with `""` for an enum, so the backend could not see this impl at
// all and refused the call with `codegen does not lower this yet: a call
// to an impl-supplied member`.
//
// Two enums each supply `rgb` against the one bound, so this also pins
// that the two bodies land under their own mangled symbols rather than
// colliding on the member's name.

RGB<T> = { r: T, g: T, b: T }

Coloured* = { rgb* = (self: @Self) RGB<u8> }

Color = Red | Green | Blue

Color.impl(Coloured, {
    rgb = (self: @Self) RGB<u8> {
        self.match({
            Red   => RGB<u8>(r: 255, g: 0, b: 0),
            Green => RGB<u8>(r: 0, g: 255, b: 0),
            Blue  => RGB<u8>(r: 0, g: 0, b: 255),
        })
    }
})

Ink = Cyan | Magenta

Ink.impl(Coloured, {
    rgb = (self: @Self) RGB<u8> {
        self.match({
            Cyan    => RGB<u8>(r: 0, g: 255, b: 255),
            Magenta => RGB<u8>(r: 255, g: 0, b: 255),
        })
    }
})

main = (env: Env) Res<i32, AllocError> {
    c = Color.Green;
    println("g={}", c.rgb().g);
    println("r={}", Color.Red.rgb().r);
    i = Ink.Magenta;
    println("ink r={} b={}", i.rgb().r, i.rgb().b);
    println("cyan g={}", Ink.Cyan.rgb().g);
    Ok(0);
}
