// MUST FAIL: two arms of a `.match` disagree, and the match stands in an
// ARGUMENT. `g`'s parameter is the position and `i32` is its word — no
// arm is entitled to speak for it, so both arms owe it.
//
// `match_arms_disagree` is the same defect at a return. `check_arms`
// closed it there and at a written-type declaration ONLY; the author's
// own report named the three positions left open, and this is the first.
// `sema_call.param_literal` is the site: it already walks an argument to
// ask a literal whether it fits the parameter, and an arm owes the
// parameter exactly what a literal owes it.
//
// THE BOOTSTRAPPER ALREADY REJECTS THIS, at 23:18, and the self-hosted
// compiler accepted it — so this is a DIVERGENCE, not a shared hole, and
// the differential oracle was blind to it only because no corpus test
// puts a mismatched match in an argument.
//
// WHY THIS IS WORSE THAN A MISSING MESSAGE. cc does not catch it either:
// the match takes the first arm's `int`, the call compiles, and `g` is
// handed a 0 nobody wrote. The program RUNS and prints a plausible wrong
// answer.
g = (n: i32) i32 { n }

f = (b: bool) i32 {
    g(b.match({
        true  => 1,
        false => false,
    }))
}

main = (env: Env) Res<i32, ArgError> {
    println("{}", f(false));
    Ok(0);
}
