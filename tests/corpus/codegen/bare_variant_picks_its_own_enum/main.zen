// a bare variant name, and the enum it belongs to.
//
// `Two` written without its enum has to reach a declaration, and SEMA
// and GEN_C reach it separately — sema to type the node, gen_c to emit a
// tag. Nothing ties the two answers together except that both ask the
// same question of the same table, so this pins that they agree.
//
// WHY TWO ENUMS SHARING A NAME. Emitting the wrong enum's tag constant
// into a value of the right enum is a C the compiler accepts without a
// word: both constants are ints, the struct is the right shape, and the
// only symptom is a `match` taking another arm. With one enum in the
// program the bug cannot be expressed; with two whose variants sit at
// different indices it is the difference between `tag two` and `tag one`.
//
// `t` takes the bare spelling and `e` the qualified one. A bare `Two`
// means the FIRST visible enum declaring it, so `Echo` is reachable only
// by name — and a bare `Two` annotated `Echo` is a type error rather
// than a second reading, which is the ambiguity staying a diagnostic
// instead of becoming a coin flip.

Tag, Echo, One, Two, Three = tags.tags

main = (env: Env) Res<i32, IoError> {
    t: Tag  = Two;
    e: Echo = Echo.Two;

    t.match({
        One   => println("tag one"),
        Two   => println("tag two"),
        Three => println("tag three"),
    });
    e.match({
        Two   => println("echo two"),
        Three => println("echo three"),
        One   => println("echo one"),
    });
    Ok(0);
}
