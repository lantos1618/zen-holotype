// src/std/collections/collections_map.zen
// Map<K, V>. the hash finds the row fast, eq confirms the key: hashes
// alone return wrong values on collision.
//
// TWO VECS — the whole design:
//   entries   every key and value, dense, in INSERTION order
//   slots     the index: open-addressed, linearly probed, holding
//             positions in `entries` and nothing else
//
// so a lookup hashes, reduces to one slot, reads one or two entries
// instead of walking all of them. Alternatives cost more: entries
// stored IN the slots would move a whole K/V on every rehash and tie
// observable order to the hash; a Vec per bucket is a nested generic
// plus an allocation per bucket.
//
// ITERATION ORDER IS INSERTION ORDER, defined not incidental: `set`
// appends a new key and overwrites an existing one in place, so no row
// ever moves. Probe order (a function of the hash) never reaches the
// surface — which is what lets gen_c emit byte-identical C for a
// Map iteration (TESTING.md, determinism).

Alloc, AllocError = std.mem
Range = std.core.range
Vec = std.collections.collections_vec

// a hash is u64, a Vec indexes in usize — reducing one to a slot
// changes type. `std.core.num` is lossless-only and this narrows
// wherever usize isn't 64 bits, so it's declared here privately
// (taking the low word is what a slot reduction does anyway).
to_usize = (self: u64) usize

// a slot holds a ONE-BASED position in `entries`, so zero means empty
// with no second liveness array — `entries.len` right after an add IS
// that position, already encoded.
SLOT_EMPTY: usize = 0

// GROWTH. index starts at 8 slots, DOUBLES, grows before an entry
// would fill more than three quarters — geometric like Vec, for
// amortised O(1) and a bounded rehash count.
//
// The quarter left empty is not slack: a probe stops at the first
// empty slot, so a full table would walk every slot on a miss — the
// linear scan this file exists to delete.
SLOTS_MIN: usize = 8
LOAD_NUM: usize = 3
LOAD_DEN: usize = 4

// internal: no *, not visible outside std.collections
Entry<K, V> = {
    hash: u64,
    key: K,
    value: V,
}

// bounds: K must be Eq + Hash — hash without eq is a wrong answer, eq
// without hash is a bare scan.
Map*<K: Eq + Hash, V> = {
    entries :: Vec<Entry<K, V>>,

    // the index. `slots.len` is zero or a power of two
    slots :: Vec<usize>,

    // a rehash builds a fresh index, so a Map allocates (law 1). `:`
    // since an Alloc is a handle (two words into the arena) that
    // allocating through never mutates.
    alloc: Alloc,

    set* = (self :: @Self, key: K, value: V) Res<(), AllocError> {
        self.reserve().try();
        h = key.hash(Hasher());
        // reserve leaves a quarter empty, so this None is unreachable
        // — written not assumed, since an unhandled full index is how
        // a table overwrites a live row
        s = self.settle(h, key).ok_or(AllocError.OutOfMemory).try();
        self.place(s, Entry(hash: h, key: key, value: value));
    }

    get* = (self: @Self, key: K) Res<V> {
        h = key.hash(Hasher());
        i = self.index_of(h, key).try();
        e = self.entries.get(i).try();
        Ok(e.value);
    }

    // the settled slot says which case a set is: occupied means the
    // key is already here, overwritten WHERE IT SITS (insertion order
    // holds); empty means a new key, appended and pointed at from here
    place = (self :: @Self, s: usize, entry: Entry<K, V>) Res<(), AllocError> {
        held = self.slots.get(s).ok_or(AllocError.OutOfMemory).try();
        (held > SLOT_EMPTY).match({
            true  => put(self.entries, held - 1, entry),
            false => self.append(s, entry),
        });
    }

    append = (self :: @Self, s: usize, entry: Entry<K, V>) Res<(), AllocError> {
        self.entries.add(entry).try();
        // post-add, `entries.len` IS the one-based position just
        // added — the slot encoding, nothing to compute
        put(self.slots, s, self.entries.len);
    }

    // the position in `entries` of this key, or None
    index_of = (self: @Self, h: u64, key: K) Res<usize> {
        s    = self.settle(h, key).try();
        held = self.slots.get(s).try();
        // an EMPTY settled slot means the path ended without the key
        (held > SLOT_EMPTY).match({
            true  => Ok(held - 1),
            false => None,
        });
    }

    // the slot this key settles on: first on its probe path that holds
    // it or is empty. None only when `reserve` has failed to keep a
    // slot free.
    settle = (self: @Self, h: u64, key: K) Res<usize> {
        // an index with no slots settles nothing, and `% 0` TRAPS
        (self.slots.len > 0).match({
            true  => self.walk(h, key, self.slots.len),
            false => None,
        });
    }

    // linear probing: path starts at the hash's own slot, steps
    // forward wrapping, so n steps see every slot once and the first
    // empty one ends it
    walk = (self: @Self, h: u64, key: K, n: usize) Res<usize> {
        start = h.to_usize() % n;
        k     = Range(0, n).find((step) { self.settles((start + step) % n, h, key) }).try();
        Ok((start + k) % n);
    }

    // does the walk stop here? an EMPTY slot stops it (path ends, key
    // absent), and so does the slot already holding this key
    settles = (self: @Self, s: usize, h: u64, key: K) bool {
        self.slots.get(s).match({
            None  => false,
            Ok(v) => (v > SLOT_EMPTY).match({
                true  => self.confirms(v - 1, h, key),
                false => true,
            }),
        });
    }

    // hash is a cheap pre-filter; eq answers. an absent key landing on
    // an occupied slot walks on rather than returning that row's value
    confirms = (self: @Self, i: usize, h: u64, key: K) bool {
        self.entries.get(i).match({
            None  => false,
            Ok(e) => (e.hash == h) && e.key.eq(key),
        });
    }

    // grow BEFORE the entry that would fill the index: one more must
    // still leave a quarter of the slots empty
    reserve = (self :: @Self) Res<(), AllocError> {
        ((self.entries.len + 1) * LOAD_DEN > self.slots.len * LOAD_NUM).match({
            true  => self.rehash(),
            false => Ok(()),
        });
    }

    // double the index and rebuild it. `entries` is never touched —
    // already dense with its own hash per row, so rehash calls `hash`
    // zero times and moves zero rows
    rehash = (self :: @Self) Res<(), AllocError> {
        n          = (self.slots.len == 0).match({
            true  => SLOTS_MIN,
            false => self.slots.len * 2,
        });
        self.slots = empty_slots(self.alloc, n).try();
        self.refill();
    }

    // point every slot at the entry that owns it. keys are unique, so
    // each entry walks to an empty slot and none displaces another
    refill = (self :: @Self) Res<(), AllocError> {
        room ::= true;
        Range(0, self.entries.len).loop((h, i) {
            self.relink(i).match({
                Ok(_)  => (),
                Err(_) => { room = false; h.break(); },
            });
        });
        room.match({
            false => Err(AllocError.OutOfMemory),
            true  => Ok(()),
        });
    }

    relink = (self :: @Self, i: usize) Res<(), AllocError> {
        e = self.entries.get(i).ok_or(AllocError.OutOfMemory).try();
        s = self.settle(e.hash, e.key).ok_or(AllocError.OutOfMemory).try();
        put(self.slots, s, i + 1);
    }
}

// a fresh index of `n` empty slots. BUILT not cleared: a grow that
// runs out of memory leaves the old index in place, not a half-cleared
// one
empty_slots = (a: Alloc, n: usize) Res<Vec<usize>, AllocError> {
    fresh ::= a.Vec<usize>();
    room  ::= true;
    Range(0, n).loop((h, i) {
        fresh.add(SLOT_EMPTY).match({
            Ok(_)  => (),
            Err(_) => { room = false; h.break(); },
        });
    });
    room.match({
        false => Err(AllocError.OutOfMemory),
        true  => Ok(fresh),
    });
}

// Vec.set past len is None, unreachable here (every write is already
// length-checked) but handled anyway: AllocError is the one failure
// this module speaks.
//
// `.ok_or` (the specified spelling) can't be used here: at T = () it
// reports a false `unresolved name value` (docs/SEMA_BOOTSTRAP_FIXES.md
// §1), and `Res<()>` is exactly what Vec.set returns
put = <T>(v :: Vec<T>, i: usize, value: T) Res<(), AllocError> {
    v.set(i, value).match({
        None  => Err(AllocError.OutOfMemory),
        Ok(_) => Ok(()),
    });
}

// `alloc.Map<str, i32>()`: ufcs constructor beside Map, since `entries`
// isn't exported.
//
// a bare value, not a Res: an empty Map owns no pages (empty Vec, zero
// slots) — the first set allocates both and returns Res.
//
// the bound travels with the return type: a Map<K, V> with K not
// Eq + Hash isn't a Map, so this can't be written `<K, V>`
Map* = <K: Eq + Hash, V>(a: Alloc) Map<K, V> {
    Map(entries: a.Vec<Entry<K, V>>(), slots: a.Vec<usize>(), alloc: a)
}
