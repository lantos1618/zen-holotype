Box = {
    value :: i32,
    publish = (self :: @Self, text: str) i32 { self.value = self.value + 1; self.value }
}
publish = (
    box    :: Box,
    amount : i32
) i32 { box.value = box.value + amount; box.value }
main = () () {
    box ::= Box(value: 10);
    println("{}", box.publish(5));
    println("{}", box.publish("member"));
    println("{}", publish(box, 7));
}
