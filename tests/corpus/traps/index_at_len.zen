// tests/corpus/traps/index_at_len.zen
// primes[4] on a [i32, 4] traps: len is one past the last index.
// a fixed array has no Res escape hatch, so this is a bug

// main must name an error type. a trap never lifts into Res:
// it aborts the process
Error =
    Overflow,
    DivideByZero,
    OutOfBounds

main = (env: Env) Res<i32, Error> {
    primes = [i32, 4](2, 3, 5, 7);
    v = primes[4];
    println("{}", v);
    Ok(0);
}
