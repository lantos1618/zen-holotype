// tests/corpus/std/string_add_appends.zen
// Raw add and formatted fmt both append rather than replace: String IS
// the buffer, and it grows through the Vec<u8> it is. Format arguments
// are filled in order.

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    sb    ::= alloc.String("").try();

    sb.fmt("{} is {}", "ada", 36).try();
    sb.add(" and ").try();
    sb.fmt("{} is {}", "grace", 45).try();

    println("{}", sb.view());
    println("len {}", sb.view().len);
    Ok(0);
}
