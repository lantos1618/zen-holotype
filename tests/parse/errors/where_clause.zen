// MUST FAIL: a `where` clause. Bounds are written inline in the generic parameter
// list — `<T: Rect>` (DESIGN.md:138), `<T: Eq>` (617), `<A: Actor>` (475), and
// `<K: Eq + Hash, V>` (581). No trailing bound clause exists, and `where` is not a
// keyword; DESIGN.md:138 calls a bound "just 'which struct's shape do I need'".

scale* = <T>(shape: T, k: f64) f64 where T: Rect {
    shape.area() * k
}
