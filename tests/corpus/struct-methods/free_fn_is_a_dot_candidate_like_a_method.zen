// A FREE FUNCTION ON THE TYPE IS REACHED BY THE SAME DOT AS A METHOD --
// different names, one call surface. The free body answers with a value
// the method-shaped reading cannot produce.
//
// DESIGN.md § Modules: "the candidates are the members of `x`'s type ...
// and every exported free function whose first parameter type is `x`'s
// type." One call surface, two declaration forms.
//
// The trap this pins: a backend that treats the dot as "method dispatch
// only" never finds a free top-level name as a member candidate -- and
// the failure is not a clean reject but either a bogus "no `double` on
// `W`" diagnostic or, worse, resolution by NAME across the program that
// grabs some other type's `double`. Both bodies here answer i32, so C
// links whichever it picks; only this exact number tells.
//
// Breaks if: dot-candidates stop at struct-body members -- `w.double()`
// is rejected ("no `double` on `W`") or answered by another type's body.

W = {
    v: i32,
    half = (self: @Self) i32 { self.v / 2 }
}

double = (w: W) i32 { w.v * 2 }

main = (env: Env) Res<i32, AllocError> {
    w = W(v: 21);
    println("method {}", w.half());
    println("free   {}", w.double());
    Ok(0);
}
