// a str literal crossing an actor boundary, with no `consume` in
// sight. literals are `val` — deeply immutable forever, no writer
// exists anywhere in the program — so any number of actors may hold
// one at once and sending does not take it away from the sender.
//
// this is the half of sendability that has no move in it, and a
// checker that demands `consume` on every behavior argument breaks
// DESIGN.md's own actor example.

Foo = {}

Foo.impl(Actor, {
    receive_msg = (self :: @Self, ctx: Context, data: str) {
        ctx.env.out.println("actor has received {}", data)
    }
})

main = (env: Env) Res<i32, IoError> {
    greeting = "hello world!";
    foo = env.spawn(Foo());
    foo.receive_msg(greeting);
    foo.receive_msg(greeting);
    Ok(0);
}
