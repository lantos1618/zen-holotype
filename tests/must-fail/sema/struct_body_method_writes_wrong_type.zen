// A method declared in a struct body is a body like any other, and the
// write in it is checked like any other write. It compiled clean for as
// long as an un-annotated bind checked the value against ITS OWN type:
// `self.n = "not an int"` asked whether `str` fits `str`, and it does.
Thing = {
    n :: i32,
    bump* = (self :: @Self) () { self.n = "not an int"; }
}

main* = (env: Env) i32 {
    t ::= Thing(n: 1);
    t.bump();
    t.n
}
