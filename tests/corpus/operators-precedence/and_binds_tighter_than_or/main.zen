// && BINDS TIGHTER THAN || — `true || false && false` is
// `true || (false && false)` = true, never `(true||false) && false` = false.
//
// This is the classic wrong-answer line: the flat left fold of the whole
// spelling is false, the correct tree is true, and both are spelled with
// nothing but literals — no diagnostic separates them, only the shape of
// the parse. The second line is the mirror: `false && true || true` is
// `(false&&true) || true` = true under correct tiers and false read as a
// bare left fold, so the pair catches the mistake from BOTH directions —
// a parser that flattens && into ||'s tier gets one of these two lines
// right by luck and the other wrong on every run.
//
// Unary ! sits ABOVE both, which is what lets the arms stay paren-free:
// `!b1 && b2` is `(!b1) && b2`, not `!(b1 && b2)` — those two readings
// differ here (false vs true), so prefix-above-&& is pinned in the same
// breath as && -above-|| without a third mechanism.
//
// THE ONE-LINE BREAK: move '&&' onto PREC.or in the binary table (one
// row for both boolean connectives). `andor` flips true -> false and
// `orand` stays true while `not_and` flips false -> ... nothing errors;
// only this file's expected bytes tell the two worlds apart.

main = (env: Env) Res<i32, AllocError> {
    b1 ::= true;
    b2 ::= false;

    println("andor {}", true || false && false);
    println("orand {}", false && true || true);
    println("not_and {}", !b1 && b2);

    // the explicit-paren twins: each half of the precedence claim,
    // written out. These are the readings the unparenthesised lines must
    // reproduce.
    println("paren_a {}", true || (false && false));
    println("paren_b {}", (!b1) && b2);
    Ok(0);
}
