// drop order is REVERSE DECLARATION ORDER, and only over bindings whose
// type impls Drop — the two plain bindings between them must be invisible
// to the walk. the ids are chosen so every permutation of three items
// prints a different number: an order that read the list forwards would
// print 1 2 3, one that swept non-Drop types into the list would still
// print three drops but at the wrong ranks, and either shows up here.
//
// (the sibling corpus/own/drop_order_reverse.zen pins the same order with
// three Noisys in a row; this one pins that INTERLEAVED non-Drop bindings
// do not perturb it.)

Noisy = {
    env: Env,
    id: i32,
}

Noisy.impl(Drop, {
    drop = (self :: @Self) () { self.env.out.println("drop {}", self.id) }
})

main = (env: Env) Res<i32, IoError> {
    a = Noisy(env: env, id: 1);
    x = 7;
    b = Noisy(env: env, id: 2);
    s = "plain";
    c = Noisy(env: env, id: 3);
    println("body");
    Ok(0);
}
