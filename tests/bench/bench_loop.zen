// tests/bench/bench_loop.zen
// the claim: loops NEVER allocate. bodies are stack closures
// inlined at the call site, index and acc thread by value, and a
// fold over a stack array compiles to a plain C for-loop.
//
//   Budget(name: "fold_stack_array", allocs_op: 0)
//
// allocs_op: 0 is the load-bearing number and the only one
// TESTING.md names; if it is ever 1, an inliner regressed and the
// body is being boxed

Bencher, TestError = std.test

fold_stack_array* = (bn: Bencher) Res<(), TestError> {
    xs = [1, 2, 3, 4, 5, 6, 7, 8];
    total ::= 0;
    bn.iter(() {
        xs.loop(0, (h, index, value, acc: i32) {
            acc + value
        }).match({
            Ok(sum) => { total = total + sum; },
            None    => (),
        });
    });
    Ok(());
}
