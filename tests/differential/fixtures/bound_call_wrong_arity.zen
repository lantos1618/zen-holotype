// A bound member's receiver is parameter zero; the written call must still
// supply every remaining required parameter.
Shower = {
    show* ::= (self: @Self, a: i32, b: i32) i32
}

Thing = {}

Thing.impl(Shower, {
    show = (self: @Self, a: i32, b: i32) i32 { a + b }
})

use = <T: Shower>(value: T) i32 { value.show(1) }

main = (env: Env) Res<i32, AllocError> {
    println("{}", use(Thing()));
    Ok(0)
}
