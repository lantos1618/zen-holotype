// A CONSTRUCTION FIELD IS STORAGE TOO. Its siblings pin the BINDING
// (`loop_handle_is_not_a_value`), the ARGUMENT
// (`loop_handle_is_not_an_argument`) and the TAIL
// (`loop_handle_is_not_a_return`); this pins the fourth face #807's
// survey found: `Box(g: h)` declared real storage for `g`, and gen_c
// emitted `{ .zu_m1g = zu_l1h }` reading the undeclared handle --
// zen silent, cc alone refusing.
//
// `sema_hoist.field_fits` now asks the bind seat's question of every
// field value, so the refusal names the handle where it stood.
//
// position: `h`, the value the field was constructed from.

Box = { g*: LoopHandle }

main = (env: Env) Res<i32> {
    Range(0, 1).loop((h, x) {
        b ::= Box(g: h);
        println("{}", x);
    });
    Ok(0);
}
