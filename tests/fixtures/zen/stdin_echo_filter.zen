// stdin echo filter — the unix-filter acceptance for std.io.stdin: numbers each
// stdin line and upper-cases it ("hello" -> "1: HELLO"), exiting with the line
// count. Driven by a harness ShellCase that PIPES input in and cmp's the output.
halloc = std.mem.heap
{ lines } = std.io.stdin
{ formatln, arg_int, arg_str } = std.text.fmt
{ to_upper, view } = std.text.str
main = () i32 {
    heap = halloc.gpa()
    a = heap.addr()
    n :: i64 = 0
    total = a.lines((line) {
        n = n + 1
        up = a.to_upper(line)
        formatln("{}: {}", [arg_int(n), arg_str(up)])
        a.release(up.view().ptr)
    })
    total.match ({
        .Ok(count) => to_i32(count),
        .Err(e)    => 255,
    })
}
