// TWENTY NESTED .MATCH EXPRESSIONS, EACH JOINING THROUGH THE LAST.
//
// A .match is a VALUE, so a chain of them -- each link's scrutinee is
// the previous link's arm value, written as one expression -- is a
// twenty-deep expression tree whose nodes are joins, not operators.
// Every link here expects exactly one literal and pays a DISTINCT
// sentinel (6NN names the level) on any other value, so:
//
//   - an arm tag swapped with its neighbour lands on a sentinel that
//     names the level;
//   - a backend that emits the scrutinee once per ARM instead of once
//     per match re-runs nothing observable here but must still carry
//     the running value forward -- losing it prints a sentinel too;
//   - a join slot sized for the WRONG type (the bool-spill class) or
//     zero-initialised prints a small number or a sentinel, never 21.
//
// the innermost literal is parenthesized because `1.match` lexes as a
// float literal -- the same trap DESIGN.md notes for numeric
// scrutinees.

main = (env: Env) Res<i32, AllocError> {
    v ::= (1).match({ 1 => 2, _ => 601 }).match({ 2 => 3, _ => 602 }).match({ 3 => 4, _ => 603 }).match({ 4 => 5, _ => 604 }).match({ 5 => 6, _ => 605 }).match({ 6 => 7, _ => 606 }).match({ 7 => 8, _ => 607 }).match({ 8 => 9, _ => 608 }).match({ 9 => 10, _ => 609 }).match({ 10 => 11, _ => 610 }).match({ 11 => 12, _ => 611 }).match({ 12 => 13, _ => 612 }).match({ 13 => 14, _ => 613 }).match({ 14 => 15, _ => 614 }).match({ 15 => 16, _ => 615 }).match({ 16 => 17, _ => 616 }).match({ 17 => 18, _ => 617 }).match({ 18 => 19, _ => 618 }).match({ 19 => 20, _ => 619 }).match({ 20 => 21, _ => 620 });
    println("chain {}", v);
    Ok(0);
}
