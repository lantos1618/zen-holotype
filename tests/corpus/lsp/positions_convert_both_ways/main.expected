-- ascii
wire 0:0 -> zen 1:1 -> wire 0:0
wire 0:1 -> zen 1:2 -> wire 0:1
wire 0:2 -> zen 1:3 -> wire 0:2
wire 0:7 -> zen 1:3 -> wire 0:2
-- two-byte lead
wire 1:0 -> zen 2:1 -> wire 1:0
wire 1:1 -> zen 2:3 -> wire 1:1
wire 1:2 -> zen 2:4 -> wire 1:2
-- three-byte lead
wire 2:0 -> zen 3:1 -> wire 2:0
wire 2:1 -> zen 3:4 -> wire 2:1
wire 2:2 -> zen 3:5 -> wire 2:2
-- four-byte lead, the surrogate pair
wire 3:0 -> zen 4:1 -> wire 3:0
wire 3:1 -> zen 4:1 -> wire 3:0
wire 3:2 -> zen 4:5 -> wire 3:2
wire 3:3 -> zen 4:6 -> wire 3:3
-- tab
wire 4:0 -> zen 5:1 -> wire 4:0
wire 4:1 -> zen 5:2 -> wire 4:1
-- empty line
wire 5:0 -> zen 6:1 -> wire 5:0
wire 5:4 -> zen 6:1 -> wire 5:0
-- crlf: the carriage return is a column
wire 6:2 -> zen 7:3 -> wire 6:2
wire 6:3 -> zen 7:4 -> wire 6:3
wire 6:9 -> zen 7:4 -> wire 6:3
-- last line, no trailing newline
wire 7:0 -> zen 8:1 -> wire 7:0
wire 7:3 -> zen 8:4 -> wire 7:3
wire 7:9 -> zen 8:4 -> wire 7:3
-- a line past the end of the file
wire 9:0 -> zen 10:1 -> wire 9:0
wire 9:4 -> zen 10:1 -> wire 9:0
-- mid-character byte columns round down
zen 2:2 -> wire 1:0
zen 3:2 -> wire 2:0
zen 3:3 -> wire 2:0
zen 4:2 -> wire 3:0
zen 4:3 -> wire 3:0
zen 4:4 -> wire 3:0
-- impossible inputs clamp rather than trap
zen 0:0 -> wire 0:0
zen 1:99 -> wire 0:2
