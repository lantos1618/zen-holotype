// the bound names a GENERIC trait: `Range<i32>` fixes the trait's own T,
// and the supplied members type against THAT -- `at` answers i32, so the
// generic's arithmetic is i32 arithmetic, checked for real.
//
// this is the case where "a bound is just a struct" earns its keep twice:
// Slot stores one i32 and satisfies a three-member shape by supply, and
// the generic below it cannot tell Slot from any other Range<i32>. the
// k*100 term makes each pass distinct (7 / 107 / 207) so an off-by-one
// in start/end or a loop that ran the wrong count still shows.

Slot = {
    held: i32,
}

Slot.impl(Range<i32>, {
    start: 0,
    end: 1,

    at = (self: @Self, index: usize) Res<i32> {
        Ok(self.held)
    }
})

draw = <S: Range<i32>>(s: S, k: usize) i32 { s.at(k).match({ Ok(v) => v + k * 100, None => 0 }) }

main = (env: Env) Res<i32, AllocError> {
    s = Slot(held: 7);
    println("{}", draw(s, 0));
    println("{}", draw(s, 1));
    println("{}", draw(s, 2));
    println("{}", draw(Slot(held: 100), 3));
    Ok(0);
}
