// tests/corpus/traps/hex_digit_out_of_range.zen
// a nibble is 0..15 by construction, so 16 is a bug in the caller's
// shift and not a miss -- it traps rather than returning a Res.
// std.core.byte spells the trap as unsigned underflow, str.index's
// idiom, because a literal `/ 0` is a provable trap and therefore a
// compile error.
//
// TWO THINGS THE BARE `trap: integer overflow` COULD NOT SAY, and both
// are now said. The .stderr names the SITE -- std/core/byte.zen, the
// underflow inside hex_digit -- so a spurious overflow anywhere else in
// the process no longer satisfies this test, which was the one assertion
// among the fourteen traps carrying no position at all. And the line of
// stdout above it exercises the in-range nibbles, so a hex_digit that
// trapped on EVERY input, or answered the wrong byte for the legal ones,
// is red here rather than green on the trap alone.
Error = Overflow | DivideByZero | OutOfBounds

main = (env: Env) Res<i32, Error> {
    println(
        "{} {} {} {}",
        hex_digit(0),
        hex_digit(9),
        hex_digit(10),
        hex_digit(15)
    );
    n: u8 = 16;
    println("{}", hex_digit(n));
    Ok(0);
}
