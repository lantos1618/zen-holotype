// A LITERAL'S TYPE COMES FROM ITS CONTEXT WHEREVER IT IS WRITTEN, and a
// closure body is a place it can be written. Unwalked, this one wrapped
// to -1294967296 and printed it.
//
// position: the literal.

main = (env: Env) Res<i32, AllocError> {
    xs = [1, 2, 3];
    xs.loop((h, v) {
        y: i32 = 3000000000;
        println("{} {}", v, y);
    });
    Ok(0);
}
