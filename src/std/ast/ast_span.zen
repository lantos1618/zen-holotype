// AST source positions and trivia. Spans are half-open, include a node's
// delimiters and children, and exclude leading trivia and following
// separators. Statement spans include their semicolon.

// A source point with a one-based line and byte column.
Pos* = {
    line*: usize,
    col*: usize,

    before* = (self: @Self, other: @Self) bool {
        self.line < other.line
            || (self.line == other.line && self.col < other.col)
    }

    at_or_after* = (self: @Self, other: @Self) bool {
        !self.before(other)
    }
}

Pos.impl(Display, {
    toString ::= (self: @Self, out :: Sink) Res<(), WriteError> {
        out.fmt("{}:{}", self.line, self.col)
    }
})

// Half-open `[start, end)` span. `file` is compilation-root-relative.
Span* = {
    file*: str,
    start*: Pos,
    end*: Pos,

    // Whether `p` in `file` lies in this span.
    covers* = (self: @Self, file: str, p: Pos) bool {
        self.file.eq(file) && p.at_or_after(self.start) && p.before(self.end)
    }

    // Strictly inside `outer`: contained, and not the same span.
    inside* = (self: @Self, outer: @Self) bool {
        self.start.at_or_after(outer.start)
            && outer.end.at_or_after(self.end)
            && (outer.start.before(self.start) || self.end.before(outer.end))
    }
}

// Blank represents one or more blank lines between source nodes.
TriviaKind* = LineComment | BlockComment | Blank

// Raw source trivia, including comment markers.
Trivia* = {
    kind*: TriviaKind,
    text*: str,
    span*: Span,
}

// Contiguous run in `Ast.trivia`; zero length means no trivia.
TriviaRun* = {
    at*: usize,
    len*: usize,
}

no_trivia* = () TriviaRun { TriviaRun(at: 0, len: 0) }

// Span for generated values with no source position. Line zero is the marker.
nowhere* = () Span {
    Span(file: "", start: Pos(line: 0, col: 0), end: Pos(line: 0, col: 0))
}

// Identifier text and the span of that text alone.
Ident* = {
    text*: str,
    span*: Span,
}

// Dotted name with individually addressable segments and a complete span.
QualifiedName* = {
    segments*: Vec<Ident>,
    span*: Span,

    // A segment's spelling; an absent segment reads as "", the same as one
    // recovery left empty.
    segment_at* = (self: @Self, i: usize) str {
        self.segments.get(i).match({ Ok(s) => s.text, None => "" })
    }

    // The last segment: `result` in `std.core.result`; "" when there are none.
    last_segment* = (self: @Self) str {
        n = self.segments.len;
        (n == 0).match({
            true  => "",
            false => self.segment_at(n - 1),
        })
    }
}
