// `LIMIT` in a pattern is a fresh binding, not a comparison against the
// constant of that name, so the first arm matches every value and the
// constant is never read. Nothing else in the language would say so: the
// program is well-formed, it runs, and it prints the wrong answer.
//
// The `_` below is what the old compiler reported — as an unreachable
// arm, which names the consequence and not the cause. Both fire, the
// cause first.
//
// position: the pattern that binds.

LIMIT: i32 = 3

describe = (env: Env, n: i32) () {
    n.match({
        LIMIT => println("at the limit"),
        _     => println("under it"),
    });
}

main = (env: Env) Res<i32, AllocError> {
    describe(env, 99);
    Ok(0);
}
