// A NESTED PATTERN TWO LEVELS DEEP, BINDER ONLY AT THE BOTTOM, with the
// nullary sibling ordered FIRST. `Closed(Full(Full(v)))` is three tests --
// two tags and a binder -- walked by `arm_cond` and `arm_bind` descending
// together; if the walk stops one level down, `Full` reads as a binder
// over the Shell enum, the first arm swallows BOTH Closed values, and v's
// type is an enum printed where a number belongs.
//
// match_nested_nullary_first pins this shape at two levels for
// reachability; this pins it at THREE, where the middle level carries no
// binder of its own -- only its tag test stands between v and the truth.

Cell  = Full(i64) | Empty
Shell = Sealed | Full(Cell)
Box   = Closed(Shell) | Open

main = (env: Env) Res<i32, AllocError> {
    b1: Box = Box.Closed(Shell.Full(Cell.Full(9000000000)));
    b2: Box = Box.Closed(Shell.Sealed);
    b3: Box = Box.Open;
    b1.match({
        Closed(Full(Full(v))) => println("deep {}", v),
        Closed(_)             => println("sealed"),
        Open                  => println("open"),
    });
    b2.match({
        Closed(Full(Full(v))) => println("deep {}", v),
        Closed(_)             => println("sealed"),
        Open                  => println("open"),
    });
    b3.match({
        Closed(Full(Full(v))) => println("deep {}", v),
        Closed(_)             => println("sealed"),
        Open                  => println("open"),
    });
    Ok(0);
}
