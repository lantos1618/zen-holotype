// tests/must-fail/sema/method_operand_is_not_a_number.zen
// THE SECOND FACE OF THE SAME HOLE: `+` accepted a function-typed
// operand. `arith_type` takes whichever side is not a literal as the
// pair's type, so `s.len + 0` came out `(String) usize` — a method value
// wearing a number's operator — and nothing reported it until the
// `println` of `m` said "printing a value of this type", naming neither
// `len` nor the missing call. An annotated `m: usize = s.len + 0` was
// refused all along, which is how the issue proved the type was computed
// and simply never checked (issue #772).
//
// The refusal is `settled`'s, at the access — the same one place that
// rejects `Range(0, s.len)` — so both faces of the hole are one rule.
//
// position: `.len`, the operand whose missing call is the mistake.

main = (env: Env) Res<i32, AllocError> {
    a = env.mem.alloc();
    s ::= String(a, "hello").try();
    m = s.len + 0;
    println("m={}", m);
    Ok(0);
}
