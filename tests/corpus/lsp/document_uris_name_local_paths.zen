// The LSP and Fs name the same remote document differently. A remote
// server must discard VS Code's authority before opening the local path.

str = std.text
AllocError = std.mem
Map = std.collections
path_of, uri_at, doc_text = lsp.lsp_uri

show = (uri: str) () { println("{}", path_of(uri)); }

main = (env: Env) Res<i32, AllocError> {
    show("file:///home/ubuntu/zenc/main.zen");
    show("file://src/main.zen");
    show("vscode-remote://ssh-remote+box/home/ubuntu/zenc/main.zen");
    show("vscode-remote://dev-container+abc/workspaces/zenc/main.zen");
    show("vscode-remote://ssh-remote+box");
    show("untitled:Untitled-1");
    show("");
    show("file://");
    show("vscode-remote://");
    show("vscode-remote:///");
    show("FILE:///home/ubuntu/main.zen");
    show("/tmp/raw path.zen");
    show("src/raw%20name.zen");

    a ::= env.mem.alloc();
    println("{}", uri_at(a, "/workspace", "main.zen").try());
    docs ::= a.Map<str, str>();
    docs.set("file:///same.zen", "local overlay").try();
    docs.set("vscode-remote://host/same.zen", "remote overlay").try();
    println("{}", doc_text(env, a, docs, "file:///same.zen"));
    println("{}", doc_text(env, a, docs, "vscode-remote://host/same.zen"));
    Ok(0);
}
