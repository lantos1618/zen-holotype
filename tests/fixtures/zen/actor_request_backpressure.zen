// BACK-PRESSURE proof for cooperative `request` (std.concurrent.actor). Bug: `request` used to call
// `send` and IGNORE its bool, then unconditionally read the reply — so filling a mailbox and then
// requesting returned `.Ok(<uninitialized T>)` (silent garbage). Fix: honor the `send` bool (and the
// reply's `ready` flag); on a full mailbox return `.Err(.Errno(EAGAIN))` (11 = "would block").
//
// full_path:   a CAP-1 mailbox is pre-filled with one `.Fill` (never drained), so the `request`'s own
//              enqueue hits `is_full` → the request must be `.Err(.Errno(11))`, never `.Ok(garbage)`.
// normal_path: a mailbox with room drains the request and returns the REAL reply (42).
{ ord } = std.core.bool
{ Result, IoError, expect } = std.core.result
{ ActorCell, ReplyRef, Receiver, Context, cell } = std.concurrent.actor
heap = std.mem.heap
Msg*: Ping(ReplyRef<i32>) | Fill
Room*: {
    n: i32,
}
Room.impl(Receiver<Msg>, {
    receive = (room: MutPtr<Room>, ctx: Context<Msg>) void {
        ctx.msg.match ({
            .Ping(reply_to) => {
                reply_to.send(42)
            },
            .Fill           => { },
        })
    }
})
full_path = () bool {
    h := heap.gpa()
    a := h.addr()
    cell_r: Result<ActorCell<Msg>, IoError> := a.cell(1)    // CAP-1 mailbox
    c := cell_r.expect("cap-1 cell allocation cannot fail")
    room := Room(n: 0)
    filled := c.send(.Fill)    // occupy the single slot; NOT drained
    out_r: Result<i32, IoError> := c.request(a, room.addr(), (reply_to) { .Ping(reply_to) })
    got_err := out_r.match ({
        .Ok(v)  => false,    // the pre-fix bug: Ok over an uninitialized reply
        .Err(e) => e.match ({
            .Errno(code) => code == 11,    // back-pressure: EAGAIN / would block
            _            => false,
        }),
    })
    c.free(a)
    filled && got_err
}
normal_path = () bool {
    h := heap.gpa()
    a := h.addr()
    cell_r: Result<ActorCell<Msg>, IoError> := a.cell(4)    // room available
    c := cell_r.expect("cell allocation cannot fail")
    room := Room(n: 0)
    out_r: Result<i32, IoError> := c.request(a, room.addr(), (reply_to) { .Ping(reply_to) })
    ok := out_r.match ({
        .Ok(v)  => v == 42,
        .Err(e) => false,
    })
    c.free(a)
    ok
}
main = () i32 { (full_path() && normal_path()).ord() }
