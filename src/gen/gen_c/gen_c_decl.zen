// src/gen/gen_c/gen_c_decl.zen
// What a declaration is in C, and what a translation unit is.
//
// THE WALK IS REACHABILITY-DRIVEN. A compilation stages the whole of
// `std` beside the program, so lowering every declaration in every
// module would emit a translation unit nobody asked for. `emit_program`
// is seeded with ONE module's functions and follows the calls that
// resolve, which is what "compilation is whole-program" means in
// practice: one merged graph, walked from a root, each thing emitted
// exactly once.
//
// BODIES ARE LOWERED FIRST AND EMITTED LAST. Lowering is what discovers
// which types need definitions and which checked-arithmetic helpers the
// runtime must carry, and C wants both of those above the first use. So
// each body is lowered into a buffer of its own, and the translation
// unit is assembled afterwards in the order C requires — banner,
// runtime, helpers, typedefs, tags, type definitions, prototypes,
// bodies, `main`.
//
// EVERY LIST IS SORTED BY MANGLED NAME. That is what makes the output
// independent of the order the modules were discovered in, which is the
// property the determinism gate and the fixpoint oracle both stand on.
// A prototype above every body is what lets the sort be by name rather
// than by dependency: C needs a declaration before a call, not a
// definition.

Ast, Module, Decl, DeclKind, Function, Param, Span, Ident = ast
BlockId, TypeId, Struct, Member, MemberKind = ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId, Ty, Types, TyRes = sema.sema_ty
World, Def, DefKind, decl_at = sema.sema_def
Checker, Ctx = sema.sema_check
Inst = sema.sema_inst
type_from_ast, param_type = sema.sema_type
member_named, self_ctx = sema.sema_member
Emit, order = gen.gen_emit
sym_fn, sym_local, sym_member, sym_variant = gen.gen_name
RES_PATH = gen.gen_name
GenFault = gen.gen_diag
CBackend, MethodRef = gen.gen_c.gen_c_state
sub, enter_tparams, leave_tparams = gen.gen_c.gen_c_mono
open_named = gen.gen_c.gen_c_mono
enter_struct_tparams = gen.gen_c.gen_c_mono
signature_of = gen.gen_c.gen_c_call
ctype, declarator, spellable, is_unit, is_c_integer = gen.gen_c.gen_c_type
emit_types = gen.gen_c.gen_c_layout
Dest, block = gen.gen_c.gen_c_stmt
takes_closure = gen.gen_c.gen_c_inline
impl_member_at, by_arity = gen.gen_c.gen_c_member
emit_main = gen.gen_c.gen_c_main
emit_banner, emit_floor, emit_helpers, emit_print = gen.gen_c.gen_c_runtime
emit_fs = gen.gen_c.gen_c_runtime

// A bound on the reachable set, and a diagnostic at it rather than a
// walk that does not terminate. Four thousand functions is more than
// any program this backend compiles today and less than a runaway.
MAX_FUNCTIONS* : usize = 4096

// The whole translation unit for the program rooted at module `mi`.
emit_program* = (be :: CBackend, mi: usize, out :: Emit)
                Res<(), AllocError> {
    seed(be, mi).try();
    drain(be).try();
    emit_banner(out).try();
    emit_floor(out).try();
    emit_fs(be, out).try();
    emit_print(be, out).try();
    emit_helpers(be, out).try();
    emit_types(be, out).try();
    emit_protos(be, out).try();
    emit_bodies(be, out).try();
    emit_main(be, mi, out).try();
    Ok(());
}

// Every function the root module declares. A module's own functions are
// the roots because a module is what a caller asked to compile; what
// they call is found by following them.
seed = (be :: CBackend, mi: usize) Res<(), AllocError> {
    be.tree.module_at(mi).match({
        None  => Ok(()),
        Ok(m) => seed_module(be, m, mi),
    }).try();
    Ok(());
}

seed_module = (be :: CBackend, m: Module, mi: usize) Res<(), AllocError> {
    Range(0, m.decls.len).loop((h, di) {
        seed_decl(be, m, mi, di).try();
    });
    Ok(());
}

seed_decl = (be :: CBackend, m: Module, mi: usize, di: usize)
            Res<(), AllocError> {
    m.decls.get(di).match({
        None  => Ok(()),
        Ok(d) => seed_function(be, m, mi, d),
    }).try();
    Ok(());
}

seed_function = (be :: CBackend, m: Module, mi: usize, d: Decl)
                Res<(), AllocError> {
    d.kind.match({
        Function(f) => seed_named(be, m, mi, f),
        _           => Ok(()),
    })
}

// The declaration is found through `defs_of` rather than by index, so
// the `Def` a seed carries is the same value a call site would resolve
// to — one identity for a function, not two.
//
// A GENERIC FUNCTION IS NOT A ROOT. There is no such thing as `Vec<T>`
// in C; there is `Vec<i32>` for each `T` a program actually asked for,
// and a call site is the only place that says which. So a generic
// declaration is skipped here and reached through `call_reachable`.
// A FUNCTION THAT TAKES A BODY IS NOT A ROOT EITHER, and for a stronger
// reason than a generic one: there is no C spelling for a `(v: T) bool`
// parameter at all, so such a declaration is never emitted — it exists
// only inlined at its call sites, exactly as the six loop declarations
// do.
seed_named = (be :: CBackend, m: Module, mi: usize, f: Function)
             Res<(), AllocError> {
    ((f.tparams.len > 0) || takes_closure(be, f)).match({
        true  => Ok(()),
        false => seed_defs(be, mi, f),
    })
}

seed_defs = (be :: CBackend, mi: usize, f: Function) Res<(), AllocError> {
    found ::= be.alloc.Vec<Def>();
    be.check.world.own_defs(mi, f.name.text, found).try();
    found.loop((h, d) { seed_def(be, d).try() });
    Ok(());
}

seed_def = (be :: CBackend, d: Def) Res<(), AllocError> {
    is_function(d).match({
        false => Ok(()),
        true  => seed_root(be, d),
    })
}

// The symbol is built the same way a call site builds it, because the
// queue's identity IS the symbol: a root queued under one name and
// called under another would be emitted twice.
seed_root = (be :: CBackend, d: Def) Res<(), AllocError> {
    inst ::= be.alloc.Inst();
    sig ::= be.alloc.Vec<TyId>();
    signature_of(be, d, inst, sig).try();
    sym ::= be.alloc.String().try();
    sym_fn(sym, be.check.types, be.check.world, d.qname, sig, inst).try();
    be.need_function(d, inst, sym.view())
}

is_function = (d: Def) bool {
    d.kind.match({ FunctionDef => true, _ => false })
}

// Lower everything queued, including whatever lowering queues. Bounded
// rather than looped: a backend that does not terminate is worse than
// one that reports.
// TWO QUEUES, INTERLEAVED. Lowering a free function discovers member
// functions and lowering a member function discovers free ones, so
// draining one to exhaustion and then the other does not converge —
// each cursor advances one step per turn instead, which reaches a
// fixpoint in one bounded walk.
drain = (be :: CBackend) Res<(), AllocError> {
    fi ::= 0;
    mi ::= 0;
    Range(0, MAX_FUNCTIONS).loop((h, k) {
        (fi < be.fn_queue.len).then(() {
            lower_queued(be, fi).try();
            fi = fi + 1;
        });
        (mi < be.m_queue.len).then(() {
            lower_queued_method(be, mi).try();
            mi = mi + 1;
        });
    });
    Ok(());
}

// THE INSTANTIATION IS ENTERED BEFORE THE BODY AND NOT INSIDE IT. Every
// type the lowering reads is substituted through `be.inst`, so the one
// place that knows which emission this is has to be the one that sets
// it — and a queue entry carries the instantiation precisely so the
// symbol above the body is the symbol the call site wrote.
lower_queued = (be :: CBackend, i: usize) Res<(), AllocError> {
    be.enter_inst(be.queued_inst(i).match({
        Ok(x) => x,
        None  => be.alloc.Inst(),
    }));
    be.fn_queue.get(i).match({
        None  => Ok(()),
        Ok(d) => lower_def(be, d),
    }).try();
    Ok(());
}

lower_queued_method = (be :: CBackend, i: usize) Res<(), AllocError> {
    be.enter_inst(be.queued_m_inst(i).match({
        Ok(x) => x,
        None  => be.alloc.Inst(),
    }));
    be.m_queue.get(i).match({
        None  => Ok(()),
        Ok(m) => lower_method_ref(be, m),
    }).try();
    Ok(());
}

lower_def = (be :: CBackend, d: Def) Res<(), AllocError> {
    decl_at(be.tree, d.id).match({
        None  => Ok(()),
        Ok(x) => lower_decl(be, d, x),
    }).try();
    Ok(());
}

lower_decl = (be :: CBackend, d: Def, x: Decl) Res<(), AllocError> {
    x.kind.match({
        Function(f) => lower_function(be, d, x, f),
        _           => Ok(()),
    })
}

// -----------------------------------------------------------------
// one function
// -----------------------------------------------------------------

// A declaration with no body — `Required` or `Hook` — has nothing to
// lower and is not a fault.
lower_function = (be :: CBackend, d: Def, x: Decl, f: Function)
                 Res<(), AllocError> {
    f.body.match({
        None    => Ok(()),
        Ok(blk) => lower_body(be, d, x, f, blk),
    })
}

// THE TYPE PARAMETERS ARE IN SCOPE FOR THE WHOLE BODY, not just the
// signature: a local written `v: T` is a written type like any other,
// and `T` means nothing unless it is bound. What each one BECAME is
// `be.inst`, which the queue entry set.
lower_body = (be :: CBackend, d: Def, x: Decl, f: Function, blk: BlockId)
             Res<(), AllocError> {
    mi = d.id.module.to_usize();
    ctx = plain_ctx(be, mi);
    mark = enter_tparams(be, f.tparams, d.qname).try();
    lower_shape(be, f, blk, d.qname, d.name, d.span, ctx, ctx.self_ty, mi).try();
    leave_tparams(be, mark).try();
    Ok(());
}

// -----------------------------------------------------------------
// one member function
//
// A method is an ordinary function whose first parameter is the
// receiver — "a method is a UFCS function whose first parameter happens
// to be named `self`" — so it goes through the same shape, with `@Self`
// bound and a qualified name carrying the TYPE rather than the module.
// -----------------------------------------------------------------

lower_method_ref = (be :: CBackend, m: MethodRef) Res<(), AllocError> {
    decl_at(be.tree, m.decl).match({
        None  => Ok(()),
        Ok(x) => method_in_decl(be, m, x),
    })
}

method_in_decl = (be :: CBackend, m: MethodRef, x: Decl)
                 Res<(), AllocError> {
    x.kind.match({
        Struct(s) => method_member(be, m, s),
        _         => Ok(()),
    })
}

// THE TYPE'S OWN MEMBERS FIRST, THEN WHAT AN IMPL SUPPLIES — the same
// order `sema_supply.zen` states, and for its reason: a member the
// declaration writes is never contested, and one an impl supplies is
// reached only when the declaration has none.
// AND AT THE ARITY THE CALL SITE RESOLVED, which is the same rule
// `impl_member_of` reads an impl's members by: a name that names two
// members names neither of them on its own.
method_member = (be :: CBackend, m: MethodRef, s: Struct)
                Res<(), AllocError> {
    found ::= be.alloc.Vec<Member>();
    s.members.loop((h, mem) {
        member_named(mem, m.name).then(() { found.add(mem).try() });
    });
    by_arity(found, m.arity).match({
        None      => supplied_member(be, m),
        Ok(mem)   => method_body(be, m, mem),
    })
}

supplied_member = (be :: CBackend, m: MethodRef) Res<(), AllocError> {
    found ::= be.alloc.Vec<Member>();
    impl_member_at(be, m.decl, m.name, found).try();
    by_arity(found, m.arity).match({
        None      => Ok(()),
        Ok(mem)   => method_body(be, m, mem),
    })
}

method_body = (be :: CBackend, m: MethodRef, mem: Member)
              Res<(), AllocError> {
    mem.kind.match({
        Function(f) => method_fn(be, m, mem, f),
        _           => Ok(()),
    })
}

method_fn = (be :: CBackend, m: MethodRef, mem: Member, f: Function)
            Res<(), AllocError> {
    f.body.match({
        None    => Ok(()),
        Ok(blk) => method_shape(be, m, mem, f, blk),
    })
}

// The TYPE's parameters and not the member's: "a method of `Vec<T>` is
// generic in `T` whether or not it declares any of its own", so what a
// member body names is the declaration it lives in.
method_shape = (be :: CBackend, m: MethodRef, mem: Member, f: Function,
                blk: BlockId) Res<(), AllocError> {
    mi = m.decl.module.to_usize();
    self_ty = method_self(be, m).try();
    ctx = be.check.self_ctx(mi, self_ty).try();
    mark = enter_struct_tparams(be, m.decl).try();
    // AND THE MEMBER'S OWN, under the member's qualified name: an impl
    // reached through a bound's erased slot is emitted at the byte type,
    // and `T` in its body means nothing unless the same owner that bound
    // it in the queue entry binds it again here.
    enter_tparams(be, f.tparams, m.qname).try();
    lower_shape(be, f, blk, m.qname, m.name, mem.span, ctx, self_ty, mi).try();
    leave_tparams(be, mark).try();
    Ok(());
}

// `@Self` FOR A GENERIC RECEIVER IS THE DECLARATION'S OWN TYPE, and for
// every other receiver it is the one the call site reached. The
// distinction is exactly where the memo can be wrong: a receiver with
// no arguments has one emission and nothing to confuse, and `str`'s
// receiver is a PRIMITIVE that no declaration's name interns to.
method_self = (be :: CBackend, m: MethodRef) Res<TyId, AllocError> {
    generic_recv(be, m.self_ty).match({
        false => Ok(m.self_ty),
        true  => open_self(be, m),
    })
}

generic_recv = (be: CBackend, ty: TyId) bool {
    be.check.types.at(ty).match({ Named(n) => n.args.len > 0, _ => false })
}

open_self = (be :: CBackend, m: MethodRef) Res<TyId, AllocError> {
    open_named(be, m.decl).try().match({
        None  => Ok(m.self_ty),
        Ok(t) => Ok(t),
    })
}

// -----------------------------------------------------------------
// the shape both go through
//
// `sctx` is the context a SIGNATURE is read in — a free function's has
// no `@Self` and a member's binds it to the receiver — and everything
// else is the same question asked of the same nodes.
// -----------------------------------------------------------------

lower_shape = (be :: CBackend, f: Function, blk: BlockId, qname: str,
               name: str, span: Span, sctx: Ctx, self_ty: TyId, mi: usize)
              Res<(), AllocError> {
    ret = return_type(be, f, sctx).try();
    be.reset_frame().try();
    be.check.release(0).try();
    sig ::= be.alloc.Vec<TyId>();
    proto ::= be.alloc.String().try();
    bind_params(be, f, sctx, sig).try();
    write_proto(be, qname, name, span, f, ret, sig, proto).try();
    be.open_buf().try();
    write_body(be, blk, mi, ret, self_ty, sctx.has_self).try();
    keep(be, qname, sig, proto).try();
    Ok(());
}

// Written, then substituted: `Vec<T>.get` returns `Res<T>` and this
// emission is the one that knows which `T`.
return_type* = (be :: CBackend, f: Function, ctx: Ctx)
              Res<TyId, AllocError> {
    declared = f.ret.match({
        Ok(t) => be.check.type_from_ast(t, ctx),
        None  => be.check.types.prim("()"),
    }).try();
    sub(be, declared)
}

// A context with a module and nothing else: no `@Self`, no enclosing
// `Res`. The one a signature is read in, since a signature has no
// enclosing function of its own.
plain_ctx* = (be :: CBackend, mi: usize) Ctx {
    Ctx(module: mi, ret: TyId(index: 0), has_ret: false,
        self_ty: TyId(index: 0), has_self: false)
}

// The context a BODY is lowered in. `ret` and `has_ret` are what
// `.try()` answers to: "the enclosing function must return a
// compatible Res".
body_ctx* = (be :: CBackend, mi: usize, ret: TyId) Ctx {
    Ctx(module: mi, ret: ret, has_ret: is_res(be, ret),
        self_ty: TyId(index: 0), has_self: false)
}

// The same, for a member function: `@Self` stays bound while the body
// is walked, because a method's body names it as freely as its
// signature does.
self_body_ctx* = (be :: CBackend, mi: usize, ret: TyId, self_ty: TyId,
                  has_self: bool) Ctx {
    Ctx(module: mi, ret: ret, has_ret: is_res(be, ret),
        self_ty: self_ty, has_self: has_self)
}

is_res* = (be :: CBackend, ret: TyId) bool {
    be.check.types.at(ret).match({ Res(_) => true, _ => false })
}

// Parameters are declared in the backend's scope AND in sema's, in
// that order, because the C name a parameter gets is the one the
// prototype has to print and the type it has is the one `type_of` must
// answer with.
bind_params = (be :: CBackend, f: Function, ctx: Ctx, sig :: Vec<TyId>)
              Res<(), AllocError> {
    f.params.loop((h, p) {
        bind_param(be, p, ctx, sig).try();
    });
    Ok(());
}

// Through `param_type` and not `type_from_ast`: `self :: @Self` has a
// written type that means the receiver, and only the query that knows
// about `@Self` can answer it.
//
// TWO TYPES, AND THE DIFFERENCE IS THE WHOLE POINT. The C declaration
// takes THIS EMISSION's type, because that is what the prototype
// prints. Sema takes the DECLARED one, still in its own parameters,
// because sema's memo is keyed by node id alone — a concrete answer
// written there is the answer every other instantiation of this body
// reads back. `ty_of` puts `be.inst` through every read, which is where
// the concrete answer belongs and where it is correct once.
bind_param = (be :: CBackend, p: Param, ctx: Ctx, sig :: Vec<TyId>)
             Res<(), AllocError> {
    declared = be.check.param_type(p, ctx).try();
    ty = sub(be, declared).try();
    sig.add(ty).try();
    be.declare(p.name.text, ty, p.mutable).try();
    be.check.bind(p.name.text, declared, p.mutable).try();
    Ok(());
}

// `static <ret> <symbol>(<params>)`. Static because a translation unit
// is the whole program — separate compilation is not a thing this
// language does — so nothing but C's own `main` needs external
// linkage.
write_proto = (be :: CBackend, qname: str, name: str, span: Span,
               f: Function, ret: TyId, sig: Vec<TyId>, out :: String)
              Res<(), AllocError> {
    check_spellable(be, name, span, ret, sig).try();
    out.add_bytes("static ").try();
    ctype(be, ret, out).try();
    out.add_bytes(" ").try();
    sym_fn(out, be.check.types, be.check.world, qname, sig, be.inst).try();
    out.add_bytes("(").try();
    write_params(be, f, sig, out).try();
    out.add_bytes(")").try();
    Ok(());
}

write_params = (be :: CBackend, f: Function, sig: Vec<TyId>, out :: String)
               Res<(), AllocError> {
    (f.params.len == 0).match({
        true  => out.add_bytes("void"),
        false => write_param_list(be, f, sig, out),
    })
}

write_param_list = (be :: CBackend, f: Function, sig: Vec<TyId>,
                    out :: String) Res<(), AllocError> {
    f.params.loop((h, i, p) {
        (i > 0).then(() { out.add_bytes(", ").try() });
        write_param(be, p, i, sig, out).try();
    });
    Ok(());
}

// A `::` parameter is declared as a POINTER: "`::` means the method
// writes the receiver's own bytes", and C has one way to say that.
write_param = (be :: CBackend, p: Param, i: usize, sig: Vec<TyId>,
               out :: String) Res<(), AllocError> {
    ty = sig.get(i).match({ Ok(t) => t, None => TyId(index: 0) });
    name ::= be.alloc.String().try();
    slot_index(be, p.name.text, name).try();
    p.mutable.match({
        false => declarator(be, ty, name.view(), out),
        true  => ref_declarator(be, ty, name.view(), out),
    })
}

ref_declarator = (be :: CBackend, ty: TyId, name: str, out :: String)
                 Res<(), AllocError> {
    ctype(be, ty, out).try();
    out.add_bytes(" *").try();
    out.add_bytes(name).try();
    Ok(());
}

slot_index = (be :: CBackend, name: str, out :: String)
             Res<(), AllocError> {
    n = be.slot_of(name).match({ Ok(s) => s.index, None => 1 });
    sym_local(out, name, n)
}

// A type with no C spelling is reported once, at the signature, rather
// than at every use of the parameter it belongs to.
check_spellable = (be :: CBackend, name: str, span: Span, ret: TyId,
                   sig: Vec<TyId>) Res<(), AllocError> {
    report_unspellable(be, name, span, ret).try();
    sig.loop((h, t) { report_unspellable(be, name, span, t).try() });
    Ok(());
}

report_unspellable = (be :: CBackend, name: str, span: Span, t: TyId)
                     Res<(), AllocError> {
    spellable(be, t).match({
        true  => Ok(()),
        false => be.report(span.file, span, GenFault.Unspellable(name)),
    })
}

// The statements, indented, and no braces: the braces belong to the
// prototype the body is emitted under, and writing them in one place
// is what keeps the two from disagreeing. A unit-returning function
// discards its value; everything else returns one.
write_body = (be :: CBackend, blk: BlockId, mi: usize, ret: TyId,
              self_ty: TyId, has_self: bool) Res<(), AllocError> {
    ctx = self_body_ctx(be, mi, ret, self_ty, has_self);
    be.indent();
    block(be, blk, ctx, ret, destination(be, ret)).try();
    Ok(());
}

destination = (be :: CBackend, ret: TyId) Dest {
    is_unit(be, ret).match({
        true  => Dest.Discard,
        false => Dest.Return,
    })
}

keep = (be :: CBackend, qname: str, sig: Vec<TyId>, proto: String)
       Res<(), AllocError> {
    name ::= be.alloc.String().try();
    sym_fn(name, be.check.types, be.check.world, qname, sig, be.inst).try();
    text ::= be.alloc.String().try();
    text.add_bytes(be.text()).try();
    be.add_function(name, proto, text)
}

// -----------------------------------------------------------------
// assembly
// -----------------------------------------------------------------

emit_protos = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    seq = order(be.alloc, be.fn_names).try();
    seq.loop((h, i) {
        be.fn_protos.get(i).match({
            None  => Ok(()),
            Ok(p) => write_proto_line(out, p),
        }).try();
    });
    out.line().try();
    Ok(());
}

write_proto_line = (out :: Emit, proto: String) Res<(), AllocError> {
    out.bytes(proto.view()).try();
    out.say(";").try();
    Ok(());
}

emit_bodies = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    seq = order(be.alloc, be.fn_names).try();
    seq.loop((h, i) {
        write_body_at(be, out, i).try();
    });
    Ok(());
}

write_body_at = (be :: CBackend, out :: Emit, i: usize)
                Res<(), AllocError> {
    be.fn_protos.get(i).match({
        None  => Ok(()),
        Ok(p) => out.bytes(p.view()),
    }).try();
    out.say(" {").try();
    be.fn_bodies.get(i).match({
        None  => Ok(()),
        Ok(b) => out.bytes(b.view()),
    }).try();
    out.say("}").try();
    out.line().try();
    Ok(());
}
