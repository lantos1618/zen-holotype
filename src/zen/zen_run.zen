// src/zen/zen_run.zen
// One command line's worth of runs.
//
// A SUBJECT THAT IS NOT "ONE BUILD" — why this is a file and not four
// more declarations in `zen_build.zen`. That file's subject is the five
// phases of a build; this one is about how many times that happens and
// where each result goes, a question about a COMMAND, not a
// compilation. STYLE.md's cap is how the split got noticed: a cap is
// how you find out a file has two subjects.
//
// EVERYTHING HERE EXISTS FOR ONE GATE: `tests/determinism/check.sh`
// cannot write its first check without `--repeat` — state carried
// process-to-process (an address-derived name, an unreset counter) is
// STABLE within a process and invisible to a check comparing two.
//
// DEPENDS ON `zen_build.zen`, NOT THE OTHER WAY ROUND: the order
// arithmetic both need lives in `zen_order.zen`, a leaf, keeping this a
// one-way edge.

Alloc, AllocError = std.mem
Range = std.core

Job = zen.zen_cli
Build = zen.zen_build
entry_of = zen.zen_path

// THE ENTRY POINT: one command line's worth of build, run `--repeat N`
// times. One run is the default and costs nothing, keeping this the
// same program it was before the flag existed.
//
// The run NUMBER never reaches `run_once` — spent here, deciding which
// `-o` that run gets. A driver taking an index would have to know what
// an index meant.
build* = (env: Env, a: Alloc, job: Job) Res<i32, AllocError> {
    worst ::= 0;
    Range(0, at_least_one(job.debug.repeat)).loop((h, i) {
        worst = max_code(
            worst,
            run_once(env, a, job_for(a, job, i).try()).try()
        );
    });
    Ok(worst);
}

// ONE BUILD, WHOLE, as a command line asks for one: walk it, check it,
// emit it, say how many diagnostics, exit.
//
// A FRESH `Build` each time — matters once `--repeat` exists: a reused
// driver would carry exactly the state that flag looks for.
//
// `Build.whole` is the OTHER way through the same phases, for a reader
// wanting the `Checker` rather than an exit code. The two are
// deliberately not written in terms of each other; `whole`'s own
// comment says why.
run_once* = (env: Env, a: Alloc, job: Job) Res<i32, AllocError> {
    b ::= a.Build(env, job.root);
    b.walk_order(job.debug.permute);
    entry = entry_of(env, a, job.root, job.entry).try();
    b.walk(entry).try();
    b.back_end(job).try();
    b.tally();
    Ok(b.code());
}

// A BUILD ALWAYS RUNS AT LEAST ONCE, whatever the job says. `repeat` is
// 0 in any `Job` built without a `debug:` field, and several
// `tests/corpus/cli/` tests do — a loop over 0 runs compiles nothing,
// writes nothing, exits 0, a silent success that once let two tests go
// green reporting no diagnostics for a tree whose missing file was the
// entire assertion.
//
// `runs_of` keeps the COMMAND LINE off zero; this keeps every other
// caller off it — deliberately not one check.
at_least_one = (n: usize) usize {
    (n == 0).match({
        true  => 1,
        false => n,
    })
}

// WHERE RUN `i` WRITES. Run 0 writes where asked; every later run
// writes beside it as `<-o>.<i+1>` — a repeat that overwrote one path
// would leave `check.sh` comparing a file with itself.
//
// No `-o` means the C goes to stdout, where a run number has nothing
// to attach to, so the job passes through unchanged and every run prints.
job_for = (a: Alloc, job: Job, i: usize) Res<Job, AllocError> {
    (i == 0 || job.out.is_empty()).match({
        true  => Ok(job),
        false => numbered(a, job, i),
    })
}

numbered = (a: Alloc, job: Job, i: usize) Res<Job, AllocError> {
    out ::= a.String("{}.{}", job.out, i + 1).try();
    Ok(Job(
        root: job.root,
        out: out.view(),
        entry: job.entry,
        emit_c: job.emit_c,
        debug: job.debug
    ));
}

// The worse of two exit codes: a run that found something outranks one
// that didn't, so `--repeat 2` over a broken tree still exits non-zero
// even if only one run said so.
max_code = (l: i32, r: i32) i32 {
    (l > r).match({
        true  => l,
        false => r,
    })
}
