// std.core.bool
//
// The one-sided conditional: `.match` is always exhaustive, so `then`
// is the honest word for "nothing on the false side" rather than a
// dropped arm. Lands in Res — Ok(v) when true, None when false — so
// it composes with `.try()`, `ok_or`, `.match`:
//
//   (n > 0).then(() { n * 2 }).ok_or(Error.NotPositive).try();
//
// A plain UFCS function (first param is bool), not an impl on bool —
// `b.then(..)` and `then(b, ..)` are the same call.
then* = <T>(b: bool, f: () T) Res<T> {
    b.match({
        true  => Ok(f()),
        false => None,
    });
}

// `true` or `false`; a `.match` on it is always exhaustive.
//
// There is no MIN/MAX/BITS to declare: the type's whole contents are
// its two literals. The declaration exists so the prelude has
// something to SAY about the name (DESIGN.md:438 — a prelude
// declaration of a primitive's name IS that primitive): hover reads
// the line above, and member lookup finds nothing, which is the
// truth.
bool* = {}
