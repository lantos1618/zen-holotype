// a minus sign in front of a literal is part of the CONSTANT, and this
// pins the two values either side of the one place that matters.
//
// `-9223372036854775808` is i64.MIN. Its magnitude is i64.MAX + 1, so
// there is no positive it can be the negation OF -- not in Zen, where
// the checked `-` would trap reaching it, and not in C, where the
// constant has no signed type to be. `-9223372036854775807` is its
// neighbour and needs neither trick.
//
// literal_boundaries_signed.zen prints i64.MIN through `i64.MIN`, which
// is std/core/num.zen's declaration; this file writes the digits out, so
// the constant path and the literal path are pinned separately and a
// backend that special-cases the wrong one of the two is caught.

main = (env: Env) Res<i32, AllocError> {
    lowest: i64 = -9223372036854775808;
    next_up: i64 = -9223372036854775807;
    println("{}", lowest);
    println("{}", next_up);

    // negation of a literal is not the operator applied to a value: the
    // operator TRAPS at i64.MIN and this does not, which is only true
    // because the sign never left the constant
    widest_i32: i32 = -2147483648;
    println("{}", widest_i32);

    Ok(0);
}
