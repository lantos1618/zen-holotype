// `@meta(self: @Self)` — the typed form, and the reason `ast.Meta`
// carries `name` + `type` beside `value`: it is the only place in the
// language where an argument is written `name: Type`
// (`tests/parse/constructs.md`, A-META-ARG). It parses down a different
// branch of `parse_expr.meta_expr` than the value form, so the refusal
// is pinned at both.
//
// It is also the shape `Display.dump` is written in
// (`docs/DESIGN.md:564`, kept verbatim in a comment in
// `src/std/core/display.zen`), which makes this the first line of the
// whole feature to go green — `docs/design_meta.md` §3.
//
// position: the `@meta` token.

Point = {
    x: i64,
    y: i64,

    describe* = (self: @Self) i64 {
        node = @meta(self: @Self);
        self.x
    },
}

main = (env: Env) Res<i32, AllocError> {
    println("{}", Point(x: 1, y: 2).describe());
    Ok(0);
}
