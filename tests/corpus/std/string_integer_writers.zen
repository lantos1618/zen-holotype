// Integer spelling belongs to String when the destination is already an
// owned buffer. Decimal output has no padding; fixed hexadecimal output is
// lowercase, left-padded, and writes nothing when its width is zero.

c_text = std.text.text_string

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    out   ::= alloc.String().try();
    out.write_usize(0).try();
    out.add(',').try();
    out.write_usize(10).try();
    out.add(',').try();
    out.write_usize(123456).try();
    out.add(',').try();
    value: u64 = 171;
    out.write_hex_fixed(value, 4).try();
    out.add(',').try();
    out.write_hex_fixed(value, 0).try();
    println("[{}]", out.view());
    c ::= c_text("zen", alloc).try();
    Ok((c.len == 4 && c.ptr().read(3) == 0).match({ true => 0, false => 1 }));
}
