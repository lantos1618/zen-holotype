// src/std/text/text_string.zen
// String is owned, growable text backed directly by Vec<u8>.
//
// view borrows the current buffer. Any later add or fmt may reallocate and
// invalidate that str, so callers must obtain a new view after writing.
//
// add appends raw str or u8 bytes and reports AllocError. fmt interprets its
// format string at the call site and writes into the same buffer, mapping the
// String-backed formatting path to AllocError. The allocating constructor
// builds a fresh String through that fmt path.

Vec = std.collections.collections
Alloc, AllocError = std.mem.mem
str, str_at = std.text.text_str
Sink, WriteError = std.core.io
Range = std.core.range
digit, hex_digit = std.core.byte

String* = {
    data :: Vec<u8>,

    // Formatting is expanded at the call site and reports this buffer's
    // allocation floor.
    fmt* = (self :: @Self, fmt: str, args: ...) Res<(), AllocError>

    // Borrows the buffer until the next potentially growing write.
    view* = (self: @Self) str { str_at(self.data.ptr(), self.data.len) }

    len* = (self: @Self) usize { self.data.len }

    is_empty* = (self: @Self) bool { self.data.len == 0 }

    // Discard the text while retaining its allocation for the next write.
    clear* = (self :: @Self) () { self.data.clear(); }

    // Raw text append and the floor `fmt` expands into: bytes, verbatim, with
    // no format meaning. One grow, one memcpy.
    add* = (self :: @Self, s: str) Res<(), AllocError> {
        at = self.data.len;
        self.data.grow_by(s.len).try();
        s.copy_into(self.data.ptr().offset(at));
        Ok(());
    }

    // The byte overload avoids a temporary one-byte str.
    add* = (self :: @Self, b: u8) Res<(), AllocError> { self.data.add(b) }

    // Decimal with no separators, most significant digit first. This is the
    // allocating String-floor counterpart to the Sink formatter's integer
    // writer: compiler and diagnostic code can spell counts without importing
    // one another merely to share number rendering.
    write_usize* = (self :: @Self, value: usize) Res<(), AllocError> {
        (value >= 10).then(() { self.write_usize(value / 10).try() });
        self.add(digit(value % 10))
    }

    // Exactly `digits` lowercase hexadecimal digits, zero-padded on the left.
    // More than sixteen digits traps while constructing the divisor: a u64 has
    // no seventeenth digit, so that request is a caller bug rather than a
    // truncation policy for this primitive.
    write_hex_fixed* = (
        self   :: @Self,
        value  : u64,
        digits : usize
    ) Res<(), AllocError> {
        place: u64 ::= 1;
        Range(1, digits).loop((h, i) { place = place * 16; });
        Range(0, digits).loop((h, i) {
            self.add(hex_digit((value / place) % 16)).try();
            place = place / 16;
        });
        Ok(())
    }
}

// String implements Sink by appending bytes to the buffer. This lets
// `{}` format into a String or a console through one signature, the format
// machinery never learning which it holds.
//
// Sink requires WriteError even though this implementation can produce only
// its allocation member.
String.impl(Sink, {
    write = (self :: @Self, bytes: str) Res<(), WriteError> {
        self.add(bytes).try();
        Ok(());
    }

    write_byte = (self :: @Self, b: u8) Res<(), WriteError> {
        self.add(b).try();
        Ok(());
    }
})

// Empty UFCS constructor. text depends on mem; mem does not depend on String.
String* = (a: Alloc) Res<String, AllocError> { Ok(String(data: a.Vec<u8>())) }

// Allocating format form, `alloc.String("{}", x)`. Declared not
// defined, like `fmt`: type-directed, expanded where written, into this
// module's empty form followed by `fmt`'s own expansion
String* = (a: Alloc, fmt: str, args: ...) Res<String, AllocError>

// Allocate the bytes expected by a C string parameter: the source bytes
// followed by one NUL terminator. The returned Vec owns the storage so its
// pointer remains valid while the caller invokes the foreign function.
c_text* = (self: str, a: Alloc) Res<Vec<u8>, AllocError> {
    out ::= a.Vec<u8>();
    out.reserve(self.len + 1).try();
    out.grow_by(self.len).try();
    self.copy_into(out.ptr());
    out.add(0).try();
    Ok(out)
}

// Allocate a copy with the first matching byte run replaced. A miss returns
// an unchanged owned copy; an empty needle inserts at the first boundary.
replace_once* = (
    self        : str,
    a           : Alloc,
    needle      : str,
    replacement : str
) Res<String, AllocError> {
    self.find(needle).match({
        None   => a.String("{}", self),
        Ok(at) => a.String(
            "{}{}{}",
            self.slice(0, at),
            replacement,
            self.slice(at + needle.len, self.len)
        ),
    })
}
