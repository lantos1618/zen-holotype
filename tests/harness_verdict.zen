// tests/harness_verdict.zen — the FULL VERDICT + KIND corpus for the Zen-native correctness harness
// (the self-hosted replacement for the historical pytest verdict harness). `zenc check src` must
// accept (should_pass=true) or reject
// (false); a non-empty `kind` (e.g. "arity") makes the harness require `error[<kind>]` in the
// rejection diagnostic (reject-for-the-right-reason). The harness wraps the bare kind label.
// NO Python anywhere — the compiler tests itself, in itself, by driving the committed `zenc`.
{ VerdictCase, run_verdicts } = harness_lib
harness_verdict_run* = () i32 {
    a := run_verdicts("verdict", [VerdictCase(
        src: "{ Malloc } = std.mem.alloc\nhalloc = std.mem.heap\nHolder: { ptr: RawPtr<u8> }\nmain = () i32 {\n    a := halloc.gpa()\n    p := a.addr().acquire(64)\n    h := Holder(ptr: p)\n    a.addr().release(p)\n    q := a.addr().acquire(64)\n    h.ptr = q\n    v := load(h.ptr)\n    a.addr().release(q)\n    v.to_i32()\n}\n",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "count := 0\nbump = () i32 {\n    count = count + 1\n    count\n}\nmaybe = (c: bool) void {\n    c.match ({ true => bump(), false => { } })\n}\nmain = () i32 {\n    maybe(true)\n    0\n}\n",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "main = () i32 {\n    n := 4\n    (n > 3).then({ 0 }, { 1 })\n}\n",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "main = () i32 {\n    s := \"x\"\n    s.then({ 1 }, { 2 })\n}\n",
        should_pass: false,
        kind: "operand-type",
    ), VerdictCase(
        src: "main = () i32 {\n    v := true.then({ 1 }, { 2 }, { 3 })\n    v\n}\n",
        should_pass: false,
        kind: "parse",
    ), VerdictCase(
        src: "main = () i32 {\n    v := true.then({ 1 }, 2)\n    v\n}\n",
        should_pass: false,
        kind: "parse",
    ), VerdictCase(
        src: "main = () i32 {\n    x := 1 > 0 ? 2 : 3\n    x\n}\n",
        should_pass: false,
        kind: "no-ternary",
    ), VerdictCase(
        src: "main = () i32 {\n    v := true ? 1\n    v\n}\n",
        should_pass: false,
        kind: "no-ternary",
    ), VerdictCase(
        src: "f = (c: bool) i32 {\n    v := c.match ({ true => 7, false => {\n        return 0\n    } })\n    v\n}\nmain = () i32 { f(true) - 7 }\n",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "R*: Ok(string_view) | Err(i32)\nmain = () i32 {\n    done := false\n    s: string_view := \"init\"\n    r: R = .Err(3)\n    s = r.match ({ .Ok(ns) => ns, .Err(e) => {\n        done = true\n        s\n    } })\n    0\n}\n",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { a: u8 := 300  to_i32(a) }",
        should_pass: false,
        kind: "assign-fit",
    ), VerdictCase(
        src: "test* = () i32 { x: i32 := 4294967296  to_i32(x) }",
        should_pass: false,
        kind: "assign-fit",
    ), VerdictCase(
        src: "test* = () i32 { a: i8 := 200  0 }",
        should_pass: false,
        kind: "assign-fit",
    ), VerdictCase(
        src: "test* = () i32 { a: i16 := 40000  0 }",
        should_pass: false,
        kind: "assign-fit",
    ), VerdictCase(
        src: "test* = () i32 { a: u16 := 70000  0 }",
        should_pass: false,
        kind: "assign-fit",
    ), VerdictCase(
        src: "test* = () i32 { a: u32 := 0 - 1  0 }",
        should_pass: false,
        kind: "assign-fit",
    ), VerdictCase(
        src: "test* = () i32 { a: i64 := 99999999999999999999999999  0 }",
        should_pass: false,
        kind: "parse",
    ), VerdictCase(
        src: "test* = () i32 { a: u64 := 0x1FFFFFFFFFFFFFFFF  0 }",
        should_pass: false,
        kind: "parse",
    ), VerdictCase(
        src: "test* = () i32 { a: u64 := 18446744073709551615  (a == 0).match ({ true => 1, false => 0 }) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { a: u64 := 0xFFFFFFFFFFFFFFFF  (a == 0).match ({ true => 1, false => 0 }) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { a: i64 := 9223372036854775807  (a > 0).match ({ true => 1, false => 0 }) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { a: u64 := 0 - 1  0 }",
        should_pass: false,
        kind: "assign-fit",
    ), VerdictCase(
        src: "test* = () i32 { a: i8 := 127  0 }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { a: i8 := 0 - 128  0 }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "P*: { x: u8 }\ntest* = () i32 { p := P( x: 300 )  0 }",
        should_pass: false,
        kind: "struct-field",
    ), VerdictCase(
        src: "P*: { x: i32 }\ntest* = () i32 { a: P := P( x: 1 )  c := a == P( x: 2 )  0 }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { x := 5  y := x.foo  0 }",
        should_pass: false,
        kind: "struct-field",
    ), VerdictCase(
        src: "test* = () i32 { n := 1  v := n.match ({ 1 => 5, _ => \"s\" })  0 }",
        should_pass: false,
        kind: "return-fit",
    ), VerdictCase(
        src: "A*: { x: i32 }\nB*: { y: i32 }\ntest* = () i32 { n := 1  v := n.match ({ 1 => A( x: 1 ), _ => B( y: 2 ) })  0 }",
        should_pass: false,
        kind: "return-fit",
    ), VerdictCase(
        src: "test* = () i32 { c := true  v := c.match ({ true => 5, false => \"s\" })  0 }",
        should_pass: false,
        kind: "return-fit",
    ), VerdictCase(
        src: "E*: A(i32) | B\ntest* = () i32 { x := E.A(\"s\")  0 }",
        should_pass: false,
        kind: "arg-type",
    ), VerdictCase(
        src: "test* = () i32 { n := 1  v := n.match ({ 1 => 5, _ => 7 })  0 }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "Box<T>: { n: i32 }\nempty<T> = (k: i32) Box<T> { Box<T>( n: k ) }\ntest* = () i32 { m := empty(7)  0 }",
        should_pass: false,
        kind: "need-annotation",
    ), VerdictCase(
        src: "Box<T>: { n: i32 }\nempty<T> = (k: i32) Box<T> { Box<T>( n: k ) }\ntest* = () i32 { m: Box<i32> := empty(7)  0 }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "Box<T>: { n: i32 }\nwrap<T> = (x: T) Box<T> { Box<T>( n: 0 ) }\ntest* = () i32 { b := wrap(5)  0 }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { a: i32 := 0 - 1  b: u32 := 1  (a < b).match ({ true => 1, false => 0 }) }",
        should_pass: false,
        kind: "operand-type",
    ), VerdictCase(
        src: "test* = () i32 { a: i64 := 0 - 1  b: u64 := 1  (a == b).match ({ true => 1, false => 0 }) }",
        should_pass: false,
        kind: "operand-type",
    ), VerdictCase(
        src: "test* = () i32 { n: u64 := 5  (n < 10).match ({ true => 1, false => 0 }) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { a: u8 := 97  (a == 'a').match ({ true => 1, false => 0 }) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { x := 50  (1 < x < 10).match ({ true => 1, false => 0 }) }",
        should_pass: false,
        kind: "operand-type",
    ), VerdictCase(
        src: "pick<T> = (xs: [T], a: T) T { a }\ntest* = () i32 { pick([1, 2]) }",
        should_pass: false,
        kind: "arity",
    ), VerdictCase(
        src: "bad = (xs: ...i32, y: i32) i32 { y }\ntest* = () i32 { bad(1, 2, 3) }",
        should_pass: false,
        kind: "parse",
    ), VerdictCase(
        src: "bad = (xs: ...i32, ys: ...i32) i32 { 0 }\ntest* = () i32 { bad(1) }",
        should_pass: false,
        kind: "parse",
    ), VerdictCase(
        src: "test* = () i32 {  }",
        should_pass: false,
        kind: "return-fit",
    ), VerdictCase(
        src: "test* = () i32 {\n  x := 5\n}",
        should_pass: false,
        kind: "return-fit",
    ), VerdictCase(
        src: "test* = () i32 {\n  x := 5\n  x = 6\n}",
        should_pass: false,
        kind: "return-fit",
    ), VerdictCase(
        src: "test* = () i32 { \"hi\" }",
        should_pass: false,
        kind: "return-fit",
    ), VerdictCase(
        src: "f* = (flags: RawPtr<u8>, i: i32, n: i32) void { (i < n).match({ true => { store_i64(flags, 1)  store_i64(flags, 2) }, false => {} }) }\ntest* = () i32 { 0 }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "g* = (x: i32) i32 { x }\nf* = (flags: RawPtr<u8>, i: i32, n: i32) void { (i < n).match({ true => { g(1, 2, 3)  store_i64(flags, 1) }, false => {} }) }\ntest* = () i32 { 0 }",
        should_pass: false,
        kind: "arity",
    ), VerdictCase(
        src: "f* = (flags: RawPtr<u8>, i: i32, n: i32) void { (i < n).match({ true => { store_i64(flags)  store_i64(flags, 1) }, false => {} }) }\ntest* = () i32 { 0 }",
        should_pass: false,
        kind: "arity",
    ), VerdictCase(
        src: "test* = () i32 { x := 7\n p: RawPtr<i32> := x.addr()\n load(p) }",
        should_pass: false,
        kind: "null-deref",
    ), VerdictCase(
        src: "test* = () i32 { x := 7\n p: RawPtr<i32> := x.addr()\n store(p, 3)\n 0 }",
        should_pass: false,
        kind: "null-deref",
    ), VerdictCase(
        src: "test* = () i32 { x := 7\n p: RawPtr<i32> := x.addr()\n q := assert_nonnull(p)\n load(q) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { x: u8 := 9\n p: RawPtr<u8> := x.addr()\n to_i32(load(p)) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "test* = () i32 { x := 5\n p: Ptr<i32> := x.addr()\n load(p) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "foo* = () i32 { 1 }\nfoo* = () i32 { 2 }\ntest* = () i32 { foo() }",
        should_pass: false,
        kind: "dup-fn",
    ), VerdictCase(
        src: "a* = () i32 { 1 }\ndup* = () i32 { 2 }\ndup* = () i32 { 3 }\ntest* = () i32 { a() }",
        should_pass: false,
        kind: "dup-fn",
    ), VerdictCase(
        src: "R*: Ok(i32) | Err\nf* = (r: R) i32 {\n r.match({ .Err => { return 9 } })\n 7\n}\ntest* = () i32 { f(.Ok(0)) }",
        should_pass: false,
        kind: "exhaustiveness",
    ), VerdictCase(
        src: "f* = (b: bool) i32 {\n b.match({ false => { return 9 } })\n 7\n}\ntest* = () i32 { f(false) }",
        should_pass: false,
        kind: "exhaustiveness",
    ), VerdictCase(
        src: "f* = (b: bool) i32 {\n b.match({ false => 9 })\n}\ntest* = () i32 { f(false) }",
        should_pass: false,
        kind: "exhaustiveness",
    ), VerdictCase(
        src: "f* = (b: bool) i32 {\n b.match({ true => 1 })\n}\ntest* = () i32 { f(true) }",
        should_pass: false,
        kind: "exhaustiveness",
    ), VerdictCase(
        src: "f* = (n: i32) i32 {\n n.match({ 0 => 9 })\n}\ntest* = () i32 { f(5) }",
        should_pass: false,
        kind: "exhaustiveness",
    ), VerdictCase(
        src: "f* = (b: bool) i32 {\n b.match({ true => 1, false => 0 })\n}\ntest* = () i32 { f(false) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "f* = (b: bool) i32 {\n b.match({ true => 1, true => 0 })\n}\ntest* = () i32 { f(true) }",
        should_pass: false,
        kind: "match-arm",
    ), VerdictCase(
        src: "f* = (b: bool) i32 {\n b.match({ false => 1, false => 0 })\n}\ntest* = () i32 { f(true) }",
        should_pass: false,
        kind: "match-arm",
    ), VerdictCase(
        src: "f* = (n: i32) i32 {\n n.match({ 1 => 10, 2 => 20, 1 => 30, _ => 0 })\n}\ntest* = () i32 { f(1) }",
        should_pass: false,
        kind: "match-arm",
    ), VerdictCase(
        src: "f* = (c: u8) i32 {\n c.match({ 'a' => 1, 'b' => 2, 'a' => 3, _ => 0 })\n}\ntest* = () i32 { f('a') }",
        should_pass: false,
        kind: "match-arm",
    ), VerdictCase(
        src: "f* = (s: string_view) i32 {\n s.match({ \"x\" => 1, \"y\" => 2, \"x\" => 3, _ => 0 })\n}\ntest* = () i32 { f(\"x\") }",
        should_pass: false,
        kind: "match-arm",
    ), VerdictCase(
        src: "f* = (n: i32) i32 {\n n.match({ 1 => 10, 2 => 20, 3 => 30, _ => 0 })\n}\ntest* = () i32 { f(2) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "S*: A | B\nf* = (s: S) i32 {\n s.match({ _ => 3, .B => 1 })\n}\ntest* = () i32 { f(.A) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "f* = (n: i32) i32 {\n n.match({ _ => 5, 2 => 20 })\n}\ntest* = () i32 { f(9) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "f* = (b: bool) i32 {\n b.match({ false => 0, true => 1 })\n}\ntest* = () i32 { f(false) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "f* = (b: bool) i32 {\n b.match({ false => 9, _ })\n 7\n}\ntest* = () i32 { f(false) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "f* = (n: i32) i32 {\n n.match({ 0 => 1, _ => 2 })\n}\ntest* = () i32 { f(5) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "f* = (n: i32) i32 {\n n.match({ _ => 0 })\n}\ntest* = () i32 { f(5) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "f* = (n: i32) i32 {\n n.match({ 0 => 1, 1 => 2, _ => 3 })\n}\ntest* = () i32 { f(5) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "f* = (b: bool) i32 {\n if (b) { return 9 }\n 7\n}\ntest* = () i32 { f(true) }",
        should_pass: false,
        kind: "no-if",
    ), VerdictCase(
        src: "R*: Ok(i32) | Err(i32)\nf* = (r: R) i32 {\n v := r.match({ .Ok(x) => { return x  x + 1 }, .Err(e) => e })\n v + 1\n}\ntest* = () i32 { f(.Ok(5)) }",
        should_pass: false,
        kind: "value-pos-return",
    ), VerdictCase(
        src: "f* = (b: bool) i32 {\n v := b.match({ true => { return 7  9 }, false => 0 })\n v\n}\ntest* = () i32 { f(true) }",
        should_pass: false,
        kind: "value-pos-return",
    ), VerdictCase(
        src: "R*: Ok(i32) | Err(i32)\nf* = (r: R) i32 {\n v := r.match({ .Ok(x) => { return x }, .Err(e) => e })\n v + 1\n}\ntest* = () i32 { f(.Ok(5)) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "f* = (b: bool) i32 {\n v := b.match({ true => { 7 }, false => 0 })\n v\n}\ntest* = () i32 { f(true) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "P*: { x: i32 }\ntest* = () i32 { (P(x: 7)).x }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "P*: { x: i32 }\ntest* = () i32 { (P {x: 7}).x }",
        should_pass: false,
        kind: "parse",
    ), VerdictCase(
        src: "add* = (a: i32, b: i32) i32 { a + b }\ntest* = () i32 { add(1) }",
        should_pass: false,
        kind: "arity",
    ), VerdictCase(
        src: "add* = (a: i32, b: i32) i32 { a + b }\ntest* = () i32 { add(1, 2, 3) }",
        should_pass: false,
        kind: "arity",
    ), VerdictCase(
        src: "add* = (a: i32, b: i32) i32 { a + b }\ntest* = () i32 { add(1, 2) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "zero* = () i32 { 0 }\ntest* = () i32 { zero(1) }",
        should_pass: false,
        kind: "arity",
    ), VerdictCase(
        src: "one* = (a: i32) i32 { a }\ntest* = () i32 { one() }",
        should_pass: false,
        kind: "arity",
    ), VerdictCase(
        src: "test* = () i32 { nope() }",
        should_pass: false,
        kind: "undefined-name",
    ), VerdictCase(
        src: "test* = () i32 { foo(1) + bar(2) }",
        should_pass: false,
        kind: "undefined-name",
    ), VerdictCase(
        src: "helper* = () i32 { 5 }\ntest* = () i32 { helper() }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "use* = (n: i32) i32 { n }\ntest* = () i32 { use(missing()) }",
        should_pass: false,
        kind: "undefined-name",
    ), VerdictCase(
        src: "test* = () i32 { 1 + gone() }",
        should_pass: false,
        kind: "undefined-name",
    ), VerdictCase(
        src: "takes_u8* = (b: u8) i32 { 0 }\nbig* = () i64 { 9999999999 }\ntest* = () i32 { takes_u8(big()) }",
        should_pass: false,
        kind: "arg-type",
    ), VerdictCase(
        src: "P*: { x: i32 }\nneeds_p* = (p: P) i32 { p.x }\nmk* = () i64 { 5 }\ntest* = () i32 { needs_p(mk()) }",
        should_pass: false,
        kind: "arg-type",
    ), VerdictCase(
        src: "A*: { v: i32 }\nB*: { v: i32 }\nneeds_a* = (a: A) i32 { a.v }\ntest* = () i32 { needs_a(B(v: 5)) }",
        should_pass: false,
        kind: "arg-type",
    ), VerdictCase(
        src: "scalar* = (n: i32) i32 { n }\ntest* = () i32 { s := [1, 2]\n scalar(s) }",
        should_pass: false,
        kind: "arg-type",
    ), VerdictCase(
        src: "takes_i32* = (n: i32) i32 { n }\nlit* = () i32 { takes_i32(5) }\ntest* = () i32 { lit() }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "widen* = (n: i64) i64 { n }\nsmall* = () u8 { 3 }\ntest* = () i64 { widen(small()) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "A*: { v: i32 }\nneeds_a* = (a: A) i32 { a.v }\ntest* = () i32 { needs_a(A(v: 5)) }",
        should_pass: true,
        kind: "",
    ), VerdictCase(
        src: "test* = () i64 { p := malloc(8)  store_i64(p)  0 }",
        should_pass: false,
        kind: "arity",
    ), VerdictCase(
        src: "test* = () i64 { p := malloc(8)  store_i64(p, 1, 2)  0 }",
        should_pass: false,
        kind: "arity",
    ), VerdictCase(
        src: "test* = () i64 { p := malloc(8)  q := offset(p)  0 }",
        should_pass: false,
        kind: "arity",
    ), VerdictCase(
        src: "test* = () i64 { p := null_ptr(7)  0 }",
        should_pass: false,
        kind: "arity",
    ), VerdictCase(
        src: "test* = () i64 { p := malloc(8)  store_i64(p, 7)  load_i64(p) }",
