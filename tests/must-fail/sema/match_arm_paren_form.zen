// MUST FAIL: the deleted arm form `Ok => (n) { n }`. DESIGN.md:152 ratifies
// "Arms are `pattern => expr`" and "Payloads bind in the pattern: `Ok(n) => n`".
// The payload binds LEFT of `=>`, never as a parameter list to its right.
//
// CAVEAT, recorded rather than smoothed over: `(n) { n }` is itself a well-formed
// closure literal if bare closure parameters are legal — DESIGN.md:1233 writes
// `(h, i, v, acc: i32) { acc + v }`. If the grammar admits those, this file PARSES
// and the rule is only enforceable at sema (an arm whose body is a closure, not an
// i32). That disagreement is ambiguity A-CLO in tests/parse/constructs.md and belongs in
// DESIGN.md, not in the parser.
//
// The Ok arm is wrapped to ensure punctuation does not hide the closure's
// shape. Both arm values and the match must still be rejected as non-i32.

get* = (r: Res<i32, IoError>) i32 {
    r.match({
        Ok => ((n) { n }),
        Err => (e) { 0 },
    });
}

// A `main` because tests/run.py builds this file as a ROOT, and law 2 makes
// a root without one a diagnostic of its own — which the self-hosted compiler
// reports and then stops on, so the rejection under test is never reached.
// This file arrived from tests/parse/errors/, where nothing but tree-sitter
// ever read it and no root was needed.
main = (env: Env) Res<i32, IoError> {
    Ok(get(Ok(1)));
}
