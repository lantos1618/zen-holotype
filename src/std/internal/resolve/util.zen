// @self-hosted-only
// std.internal.resolve.util — shared string, diagnostic, and registry helpers.
{ gstr_push, gstr_string, gstr_append, gstr_finish } = compiler.genc
{ Malloc } = std.mem.alloc
{ String } = std.text.string
{ rpush, mappend_span, mappend_string, res_sbyte, snext_line, mappend_id_name, id_is_user } = std.internal.resolve.scan

mid_is_user* = (id: string_view) bool { id.at(0) == 'u' && id.at(1) == '/' }
mappend_id_str_dotted* = (a: MutPtr<Malloc>, out: String, id: string_view) String {
    cur := out
    bs: [u8] := id.view()
    bs.loop((h, i, b) {
        cur = (b == '/').match ({ true => cur.gstr_push(a, '.'), false => cur.gstr_push(a, b) })
    })
    cur
}
mappend_mid_display* = (a: MutPtr<Malloc>, out: String, id: string_view) String {
    id.mid_is_user().match ({
        true  => a.mappend_id_str_dotted(out, cstr(offset(id, 2))),
        false => a.mappend_id_str_dotted(out, id),
    })
}
res_line_of* = (src: string_view, off: i32) i32 {
    no := 1
    bs: [u8] := src.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii >= off).match ({
            true  => { h.break },
            false => (b == '\n').then({ no = no + 1 }),
        })
    })
    no
}
res_col_of* = (src: string_view, off: i32) i32 {
    ls := 0
    bs: [u8] := src.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii >= off).match ({
            true  => { h.break },
            false => (b == '\n').then({ ls = ii + 1 }),
        })
    })
    off - ls + 1
}
res_udec* = (out: String, a: MutPtr<Malloc>, n: i32) String {
    (n < 10).match ({
        true  => out.gstr_push(a, ('0'.to_i64() + to_i64(n)).to_u8()),
        false => out.res_udec(a, n / 10).gstr_push(a, ('0'.to_i64() + to_i64(n % 10)).to_u8()),
    })
}
import_name_span* = (out: String, a: MutPtr<Malloc>, flat: string_view, p: i32, e: i32) String {
    (p == e).match ({
        true  => out,
        false => out.rpush(a, flat.at(p)).import_name_span(a, flat, p + 1, e),
    })
}
mimport_name_span* = (a: MutPtr<Malloc>, flat: string_view, p: i32, e: i32) String { a.mappend_span(a.gstr_string(16), flat, p, e) }
line_name* = (out: String, a: MutPtr<Malloc>, names: String, i: i64) String {
    (i >= names.len || names.res_sbyte(i) == '\n').match ({
        true  => out,
        false => out.rpush(a, names.res_sbyte(i)).line_name(a, names, i + 1),
    })
}
append_to_nul* = (out: String, a: MutPtr<Malloc>, s: string_view, p: i32) String {
    cur := out
    bs: [u8] := s.view()
    bs.loop((h, i, b) {
        (i < p == false).then({ cur = cur.rpush(a, b) })
    })
    cur
}
ffi_no_grants = () string_view { "" }
ffi_grants := ffi_no_grants()
ffi_grants_set* = (g: string_view) void { ffi_grants = g }
ffi_grants_get* = () string_view { ffi_grants }
genmods := ffi_no_grants()
genmods_set* = (g: string_view) void { genmods = g }
genmods_get* = () string_view { genmods }
gm_word_end = (s: string_view, p: i32) i32 {
    (s.at(p) == 0 || s.at(p) == ' ' || s.at(p) == '\n').match ({
        true  => p,
        false => s.gm_word_end(p + 1),
    })
}
ffi_span_eq = (s: string_view, p: i32, e: i32, w: string_view, j: i32) bool {
    (p + j == e).match ({
        true  => w.at(j) == 0,
        false => (w.at(j) == 0).match ({
            true  => false,
            false => (s.at(p + j) == w.at(j)).match ({
                true  => s.ffi_span_eq(p, e, w, j + 1),
                false => false,
            }),
        }),
    })
}
ffi_line_end = (s: string_view, p: i32) i32 { (s.at(p) == 0 || s.at(p) == '\n').match ({
    true  => p,
    false => s.ffi_line_end(p + 1),
}) }
gm_find = (a: MutPtr<Malloc>, g: string_view, p: i32, dotted: string_view) string_view {
    (g.at(p) == 0).match ({
        true  => "",
        false => {
            we := g.gm_word_end(p)
            le := g.ffi_line_end(we)
            g.ffi_span_eq(p, we, dotted, 0).match ({
                true  => a.gstr_string(64).rappend_span(a, g, we + 1, le).gstr_finish(a),
                false => (g.at(le) == 0).match ({
                    true  => "",
                    false => a.gm_find(g, le + 1, dotted),
                }),
            })
        },
    })
}
genmod_lookup* = (a: MutPtr<Malloc>, id: String) string_view {
    id.id_is_user().match ({
        true  => {
            dotted := a.mappend_id_name(a.gstr_string(24), id).gstr_finish(a)
            a.gm_find(genmods, 0, dotted)
        },
        false => "",
    })
}
