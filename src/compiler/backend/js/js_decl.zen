{ String } = std.text.string
{ Func, Param, GlobalData } = compiler.ast.ast_types
{ Allocator } = std.mem.alloc
{ jint, jname } = compiler.backend.js.js_lit
{ js_stmts, js_expr, int_width, js_w_open, js_w_close, vw_note, vw_reset, set_ret_w, js_boxed_w } = compiler.backend.js.js_expr
{ js_box_reset, js_box_scan } = compiler.backend.js.js_box
{ js_cp_needed, js_cp_open, js_cp_close } = compiler.backend.js.js_copy
{ loop_at } = std.core.count
// a function; every param is a bare JS name (types erased). `main` becomes `zen_main`.
js_func_name = (s: String, a: Allocator, name: StringView) String {
    (name == "main").then({ s.add("zen_main") }, { s.jname(a, name) })
}
js_params = (s: String, a: Allocator, ps: MutSlice<Param>) String {
    out ::= s
    ps.loop_at((i, p) {
        out = (i == 0).then({ out }, { out.add(", ") })
        out = out.jname(a, p.name)
    })
    out
}
js_param_norms = (s: String, a: Allocator, ps: MutSlice<Param>) String {
    out ::= s
    ps.loop_at((i, p) {
        vw_note(p.name, p.ty)
        out = out.js_param_norm(a, p)
    })
    out
}
// A param is coerced to its declared width at entry (C truncates there), COPIED there if it is a
// struct/enum/slice VALUE (C's by-value parameter passing: a callee that writes its param must not
// reach the caller's), and then — if the body takes its address — moved into a linear-memory cell, so
// `addr(p)` yields a real offset. Order matters: the value is width-correct BEFORE it is written into
// the cell, and the copy is what the cell then holds. The three are mutually exclusive by type.
js_param_norm = (s: String, a: Allocator, p: Param) String {
    w = int_width(p.ty)
    normed = (w == 0).match ({
        true  => s.js_param_copy(a, p),
        false => s
            .jname(a, p.name)
            .add(" = ")
            .js_w_open(a, w)
            .jname(a, p.name)
            .js_w_close(a, w)
            .add("; "),
    })
    bw = js_boxed_w(p.name)
    (bw == 0).match ({
        true  => normed,
        false => normed
            .jname(a, p.name)
            .add(" = __zr.box(")
            .jname(a, p.name)
            .add(", ")
            .jint(a, bw)
            .add("); "),
    })
}
js_param_copy = (s: String, a: Allocator, p: Param) String {
    js_cp_needed(p.ty).match ({
        true  => s
            .jname(a, p.name)
            .add(" = ")
            .js_cp_open(a, p.ty)
            .jname(a, p.name)
            .js_cp_close(a, p.ty)
            .add("; "),
        false => s,
    })
}
js_func* = (s: String, a: Allocator, f: Func) String {
    vw_reset(a)
    js_box_reset(a)
    js_box_scan(f.body)    // BEFORE emission: `addr(x)` may appear textually after x's `let`
    set_ret_w(int_width(f.ret))
    s
        .add("function ")
        .js_func_name(a, f.name)
        .add("(")
        .js_params(a, f.params)
        .add(") { ")
        .js_param_norms(a, f.params)
        .js_stmts(a, f.body)
        .add("}\n")
}
// a module-level global `name ::= init` -> `let name = init;` (mutable; some are scheduler/runtime state).
js_global* = (s: String, a: Allocator, g: GlobalData) String {
    s
        .add("let ")
        .jname(a, g.name)
        .add(" = ")
        .js_expr(a, g.init)
        .add(";\n")
}
