// A LOOP HANDLE IS NOT AN ARGUMENT, either. Its sibling
// `loop_handle_is_not_a_value` pins the BINDING (`kept ::= h;`); this
// pins the second face from #782's scope table — passing it. `keep =
// (g: LoopHandle) () { }` declares real C storage for its formal, and
// gen_c has none to give: the pre-fix tree emitted `keep(zu_l1h)` with
// `zu_l1h` undeclared anywhere in the file, refused by cc alone while
// sema stayed silent.
//
// A handle travels inward only as a SPLICED body's parameter —
// `Map.pairs` hands its caller's `h` to `body(h, ..)` because the body
// is inlined into the frame that owns the loop
// (`gen_c_inline.lower_arg_value`). A concrete callee is storage, so
// the same refusal as the bind fires here, at the VALUE `h`.
//
// position: `h`, the argument whose passing was the mistake.

keep = (g: LoopHandle) () { }

main = (env: Env) Res<i32, IoError> {
    Range(0, 1).loop((h, x) {
        keep(h);
        println("{}", x);
    });
    Ok(0);
}
