// tests/harness_lib.zen — the REUSABLE harness library for the Zen-native correctness harness (the
// self-hosted replacement for the pytest value/verdict harness). A category test file imports this,
// declares its cases as Zen data, and calls the batch runners — NO Python anywhere; the compiler
// tests itself, in itself, by driving the committed `zen` binary via std.io.
//
// ── HOW TO WRITE A CATEGORY FILE (tests/harness_<cat>.zen) ────────────────────────────────────────
//
//   { VCase, VerdictCase, run_values, run_verdicts } = harness_lib
//
//   // Export ONE uniquely-named entry `harness_<cat>_run*` returning this category's fail count.
//   harness_<cat>_run* = () i32 {
//       v := run_values("<cat> value", [
//           VCase(src: "test* = () i64 { 6 * 7 }", want: "42"),
//           // ... `src` defines `test* = () iNN { … }`; the emitted program must print `want`.
//       ])
//       d := run_verdicts("<cat> verdict", [
//           VerdictCase(src: "test* = () i32 { 5 }",      should_pass: true,  kind: ""),
//           VerdictCase(src: "test* = () i32 { nope() }", should_pass: false, kind: "undefined-name"),
//           // should_pass=true => `zenc check` must accept. false => must reject; if `kind` is
//           // non-empty the diagnostic must be `error[<kind>]` (a reject pinned by REASON).
//       ])
//       v + d
//   }
//
// A value-only category returns just `run_values(...)`; a verdict-only one returns `run_verdicts(...)`.
// Then tests/harness.zen flat-imports each `harness_<cat>_run` (unique names never collide) and sums them.
{ Malloc, malloc, free } = std.mem.alloc
{ out, save, contents_in, shell } = std.io.file
{ eq, len, contains, is_empty, starts_with, try_parse_int } = std.text.str
{ new_in, append_in, finish_in } = std.text.string
{ expect } = std.core.result
{ integer_in } = std.text.num
{ getpid } = std.c.libc
thread = std.thread    // NAMESPACED: std.thread.join collides in the flat namespace with std.text.str.join / std.path.join
// ── PER-RUN UNIQUE TEMP NAMESPACE (concurrency safety) ────────────────────────────────────────────
// `make harness` is run concurrently all the time (parallel agents). The hazard is shared `/tmp`
// paths: if two runs touched the SAME fixed file, they would clobber each other mid-flight →
// nondeterministic failures. Two layers of scratch state, both now PER-RUN/PER-PROCESS unique:
//
//   (1) TEST scratch files: every harness PROCESS derives a private scratch dir `/tmp/zo.<pid>/`
//       (getpid is constant for the whole run) and threads it through every temp path — direct
//       std.io writes via `zo_path`, shell pipelines via `zo_cmd` (which binds `$ZT` to the dir so a
//       literal command body can interpolate it). Unique dirs => no clobber; `zo_cleanup` removes it.
//
//   (2) COMPILER scratch files: `zenc emit/check/build` write their intermediate C+binary to
//       PID-NAMESPACED paths (driver.zen `/tmp/zenc_zd_<pid>.c`, `/tmp/zenc_zd_<pid>.bin`), and each
//       `./zen` the harness spawns is a distinct process with a distinct pid — so two concurrent
//       compiles can never share an intermediate file. (This used to require a global `flock` on
//       `/tmp/zo_zenc.lock` serializing every zenc compile — back when the compiler used FIXED
//       `/tmp/zenc_zd.*` paths. Now that those paths are pid-unique the lock is redundant; it was
//       removed because it had been forcing N concurrent `make harness` runs to execute strictly
//       one-at-a-time. Per-run uniqueness gives the same correctness with full parallelism.)
// the private scratch directory for this run, e.g. `/tmp/zo.12345` (no trailing slash).
zo_dir* = (mp: MutPtr<Malloc>) string_view {
    b := mp.new_in().expect("harness: oom")
    b = b.append_in(mp, "/tmp/zo.").expect("harness: oom")
    b = b.append_in(mp, mp.finish_in(mp.integer_in(getpid().to_i64()).expect("harness: oom")).expect("harness: oom")).expect("harness: oom")
    mp.finish_in(b).expect("harness: oom")
}
// build `<zo_dir>/<name>` — a scratch path private to this harness run (for std.io save/contents_in).
zo_path* = (mp: MutPtr<Malloc>, name: string_view) string_view {
    b := mp.new_in().expect("harness: oom")
    b = b.append_in(mp, mp.zo_dir()).expect("harness: oom")
    b = b.append_in(mp, "/").expect("harness: oom")
    b = b.append_in(mp, name).expect("harness: oom")
    mp.finish_in(b).expect("harness: oom")
}
// wrap a shell command body so it can use `$ZT` for the private scratch dir; the dir is (re)created
// first so any command can write into it even before a std.io save runs. No cross-run lock is needed:
// the body's own scratch lives under `$ZT` (per-pid) and any `zenc` it spawns writes pid-namespaced
// intermediates (`/tmp/zenc_zd_<pid>.*`), so concurrent harness runs never collide — they run fully
// in parallel.
zo_cmd* = (mp: MutPtr<Malloc>, body: string_view) string_view {
    s := mp.new_in().expect("harness: oom")
    s = s.append_in(mp, "ZT=").expect("harness: oom")
    s = s.append_in(mp, mp.zo_dir()).expect("harness: oom")
    s = s.append_in(mp, "; mkdir -p \"$ZT\"; ").expect("harness: oom")
    s = s.append_in(mp, body).expect("harness: oom")
    mp.finish_in(s).expect("harness: oom")
}
// create the private scratch dir (idempotent); call once at harness startup before any std.io save.
zo_ensure* = () i32 {
    m := Malloc(_: 0)
    mp := m.addr()
    shell(mp.zo_cmd("true")).expect("harness: shell")
}
// remove the private scratch dir; call once at harness teardown.
zo_cleanup* = () i32 {
    m := Malloc(_: 0)
    mp := m.addr()
    s := mp.new_in().expect("harness: oom")
    s = s.append_in(mp, "rm -rf ").expect("harness: oom")
    s = s.append_in(mp, mp.zo_dir()).expect("harness: oom")
    shell(mp.finish_in(s).expect("harness: oom")).expect("harness: shell")
}
// ── PARALLEL CASE EXECUTION (dogfoods std.thread) ─────────────────────────────────────────────────
// The harness's wall-time is process-spawn bound: each case forks `./zen` (+ `cc` + a test binary),
// and a single zenc build is ~0.08s, so the cost is the ~1000× SERIAL fork, not the compiler. We keep
// every case's PASS/FAIL decision in Zen (unchanged, so the verdict is byte-identical to serial) and
// parallelize only the expensive subprocess step, in three phases per suite:
//   (A) SERIAL, cheap: write each case's source to a UNIQUE per-case path and build a self-contained
//       shell command that produces that case's result FILE(s) (also under unique per-case paths).
//   (B) PARALLEL: hand the `[str]` of commands to N worker threads that pull case indices off a shared
//       atomic counter and `shell()` them. Workers touch NO shared Zen heap (results live in files),
//       and every case writes DISJOINT paths, so the phase is race-free by construction.
//   (C) SERIAL, cheap: read each case's result file(s) IN ORDER and apply the SAME comparison the serial
//       runner used — identical fail count, identical '.'/'F' order, identical exit code.
// Per-case path uniqueness (the #1 hazard the old fixed /tmp names created under parallelism) comes from
// the case's suite-local index `gid`: sources at `<$ZT>/<pfx><gid>.zen`, and value cases compile into a
// PRIVATE include dir `<$ZT>/d<gid>/` so the runner's fixed `#include "zo_body.c"` never collides.
NWORKERS_FALLBACK := 8    // used only if `nproc` can't be read
// integer → allocator-owned str (decimal), for building per-case paths/commands.
zo_itoa* = (mp: MutPtr<Malloc>, n: i64) string_view { mp.integer_in(n).expect("harness: oom").finish_in(mp).expect("harness: oom") }
// concat a list of pieces through an allocator-owned String.
zo_join* = (mp: MutPtr<Malloc>, parts: [string_view]) string_view {
    s := mp.new_in().expect("harness: oom")
    parts.loop((h, i, p) {
        s = s.append_in(mp, p).expect("harness: oom")
    })
    mp.finish_in(s).expect("harness: oom")
}
// an ABSOLUTE per-case scratch path `<zo_dir>/<prefix><gid><suffix>` (used by BOTH the Zen-side save and
// the shell command, so no `$ZT` interpolation is needed — the command is fully self-contained).
zo_idpath* = (mp: MutPtr<Malloc>, prefix: string_view, gid: i64, suffix: string_view) string_view { mp.zo_join([mp.zo_dir(), "/", prefix, mp.zo_itoa(gid), suffix]) }
// how many worker threads to fan out over: `nproc` (subprocess pipelines are cc-bound, so ≈ #cores),
// clamped ≥ 1, falling back to NWORKERS_FALLBACK if nproc can't be read/parsed. `tr -d` strips the
// trailing newline so try_parse_int (which refuses a trailing non-digit) accepts it.
zo_nproc = (mp: MutPtr<Malloc>) i64 {
    shell(mp.zo_cmd("nproc | tr -d '\\n' > $ZT/zo_nproc.txt 2>/dev/null"))
    mp.contents_in(mp.zo_path("zo_nproc.txt")).match ({
        .Ok(s)  => try_parse_int(s).match ({
            .Ok(v)  => (v < 1).match ({ true => 1, false => v }),
            .Err(e) => NWORKERS_FALLBACK,
        }),
        .Err(e) => NWORKERS_FALLBACK,
    })
}
// worker's inner loop: claim the next index with a fetch-add (atomic_add returns the NEW value, so the
// claimed index is NEW-1), run its command, repeat until all indices are taken. `@while` (not recursion)
// keeps the stack flat no matter how many cases one worker drains.
zo_par_loop = (cmds: [string_view], n: i64, counter: RawPtr<u8>) void {
    go := true
    @while (go) {
        idx := atomic_add_i64(counter, 1) - 1
        (idx < n).match ({
            true  => {
                shell(cmds[idx])
            },
            false => {
                go = false
            },
        })
    }
}
// non-capturing pthread body (std.thread contract): arg → [ cmds_base:i64 | n:i64 | counter_ptr:i64 ].
// Rebuild the `[str]` command view from its base pointer and run the shared work loop.
zo_par_worker = (arg: RawPtr<u8>) RawPtr<u8> {
    cmds_base := load_i64(arg).offset(0)
    n := load_i64(arg.offset(8))
    counter := load_i64(arg.offset(16)).offset(0)
    cmds: [string_view] := cmds_base.slice(n)
    zo_par_loop(cmds, n, counter)
    null_ptr()
}
// Phase B: run every command string across up to `nproc` worker threads (never more than #cases). The
// commands are independent and write disjoint per-case files, so this is a pure fan-out/join — the only
// shared state is the atomic work counter. Blocks until all cases have run.
zo_par_run* = (cmds: [string_view], n: i64) void {
    (n <= 0 == false).then({
        m := Malloc(_: 0)
        mp := m.addr()
        w0 := mp.zo_nproc()
        w := (w0 > n).match ({ true => n, false => w0 })    // never spawn more workers than cases
        counter := malloc(8)
        counter.store_i64(0)
        arg := malloc(24)
        arg.store_i64(cmds.ptr)
        arg.offset(8).store_i64(n)
        arg.offset(16).store_i64(counter)
        handles := malloc(w * 8)
        i: i64 := 0
        @while (i < w) {
            hh := thread.spawn(zo_par_worker, arg)
            handles.offset(i * 8).store_i64(hh.tid)
            i = i + 1
        }
        j: i64 := 0
        @while (j < w) {
            thread.join(thread.JoinHandle(tid: handles.offset(j * 8).load_i64().offset(0)))
            j = j + 1
        }
        free(handles)
        free(arg)
        free(counter)
    })
}
// a VALUE case: `src` defines `test* = () iNN { … }`; the emitted program must compute (print) `want`.
VCase*: {
    src: string_view,
    want: string_view,
}
// a VERDICT case: `zenc check src` must accept (should_pass=true) or reject (false). When rejecting
// and `kind` is non-empty, the diagnostic must contain `error[<kind>]` (e.g. kind: "arity").
VerdictCase*: {
    src: string_view,
    should_pass: bool,
    kind: string_view,
}
// a DIAGNOSTIC case: `zenc check src` must REJECT (exit nonzero), and its full diagnostic text (stderr,
// captured) must CONTAIN every string in `wants` — the precise positioned-diagnostic assertion (kind +
// `line:col` + the source line + the `^~~` caret + the human message + hint). Substring containment is
// adversarially sufficient: corrupt any expected piece (a wrong col, a missing caret) and the case fails.
DiagCase*: {
    src: string_view,
    wants: [string_view],
}
// build the diagnostic needle `error[<kind>]` for a kind label.
kind_needle = (mp: MutPtr<Malloc>, kind: string_view) string_view {
    s := mp.new_in().expect("harness: oom")
    s = s.append_in(mp, "error[").expect("harness: oom")
    s = s.append_in(mp, kind).expect("harness: oom")
    s = s.append_in(mp, "]").expect("harness: oom")
    mp.finish_in(s).expect("harness: oom")
}
// VALUE: emit C for the case, compile it with tests/harness_runner.c, run it, compare the printed int
// to `want`. /tmp/zo_out.txt is cleared first so a stale value can't masquerade as a pass when emit
// or cc fails (the `&&` chain then never runs the program). Both `zen emit` and the compiled program
// run under `timeout`: a miscompiled infinite loop must fail the case (empty output ≠ want), never
// hang the harness.
run_value* = (vc: VCase) bool {
    m := Malloc(_: 0)
    mp := m.addr()
    save(mp.zo_path("zo_case.zen"), vc.src, len(vc.src))
    save(mp.zo_path("zo_out.txt"), "", 0)
    shell(mp.zo_cmd("timeout 60 ./zen emit $ZT/zo_case.zen > $ZT/zo_body.c 2>/dev/null && cc -std=gnu11 -w -I$ZT tests/harness_runner.c -o $ZT/zo_prog 2>/dev/null && timeout 30 $ZT/zo_prog > $ZT/zo_out.txt 2>/dev/null"))
    mp.contents_in(mp.zo_path("zo_out.txt")).match ({
        .Ok(got) => eq(got, vc.want),
        .Err(e)  => false,
    })
}
// VERDICT: `zenc check` exits 0 on accept, non-zero on reject (it prints exactly one diagnostic, so
// `contains("error[<kind>]")` is equivalent to matching the first-error kind). Runs under `timeout 60`;
// a timeout (rc 124) fails the case outright — a hung compiler must never satisfy a reject expectation.
run_verdict* = (vc: VerdictCase) bool {
    m := Malloc(_: 0)
    mp := m.addr()
    save(mp.zo_path("zo_v.zen"), vc.src, len(vc.src))
    rc := shell(mp.zo_cmd("timeout 60 ./zen check $ZT/zo_v.zen > $ZT/zo_chk.txt 2>&1")).expect("harness: shell")
    (rc == 124).match ({
        true  => false,
        false => vc.should_pass.match ({
            true  => rc == 0,
            false => (rc == 0).match ({
                true  => false,
                false => is_empty(vc.kind).match ({
                    true  => true,
                    false => mp.contents_in(mp.zo_path("zo_chk.txt")).match ({
                        .Ok(txt) => txt.contains(mp.kind_needle(vc.kind)),
                        .Err(e)  => false,
                    }),
                }),
            }),
        }),
    })
}
// DIAGNOSTIC: `zenc check` must reject (exit nonzero); capture the FULL diagnostic (stdout+stderr) and
// require every `wants` substring to be present. /tmp/zod_out.txt is overwritten each run.
// `timeout 60` as in run_verdict: rc 124 fails the case.
run_diag* = (dc: DiagCase) bool {
    m := Malloc(_: 0)
    mp := m.addr()
    save(mp.zo_path("zod_v.zen"), dc.src, len(dc.src))
    rc := shell(mp.zo_cmd("timeout 60 ./zen check $ZT/zod_v.zen > $ZT/zod_out.txt 2>&1")).expect("harness: shell")
    (rc == 0 || rc == 124).match ({
        true  => false,
        false => mp.contents_in(mp.zo_path("zod_out.txt")).match ({
            .Ok(txt) => {
                all := true
                dc.wants.loop((h, i, wnt) {
                    (txt.contains(wnt) == false).then({
                        all = false
                    })
                })    // must REJECT
                all
            },
            .Err(e)  => false,
        }),
    })
}
// the self-host FIXPOINT: `zenc --build-self` regenerates the bootstrap C byte-for-byte. Build to a
// temp file and `cmp` against the committed bootstrap/zenc.gen.c — the committed file is never touched.
fixpoint_ok* = () bool {
    m := Malloc(_: 0)
    mp := m.addr()
    shell(mp.zo_cmd("./zen --build-self $ZT/zo_gen_after.c . 2>/dev/null"))
    same := shell(mp.zo_cmd("cmp -s $ZT/zo_gen_after.c bootstrap/zenc.gen.c")).expect("harness: shell")
    same == 0
}
// REPORTER: print `name (N)` then '.'/'F' per result, return the failing count. A failing mark is
// followed by a `FAIL <name>[<idx>]` line identifying the case, so a red suite needs no bisection.
// Use when a caller already has a `[bool]` of outcomes (e.g. the fixpoint suite, or a custom mix).
run_suite* = (name: string_view, results: [bool]) i32 {
    out(name)
    out("\n")
    m := Malloc(_: 0)
    mp := m.addr()
    fails := 0
    results.loop((h, i, ok) {
        ok.match ({
            true  => out("."),
            false => {
                out("F\n  FAIL ")
                out(name)
                out("[")
                out(mp.zo_itoa(i))
                out("]\n")
                fails = fails + 1
            },
        })
    })
    out("\n")
    fails
}
// VALUE per-case command (Phase A→B): emit C into a PRIVATE include dir `d<gid>/`, compile it with the
// runner, run it, capture the printed int to `o<gid>.txt`. The private include dir is what lets the fixed
// `#include "zo_body.c"` be reused across parallel cases without collision. `zen emit` and the compiled
// program run under `timeout`: a compiler hang or a miscompiled infinite loop leaves `o<gid>.txt` empty,
// which FAILS the case in Phase C instead of hanging the harness.
zo_value_cmd = (mp: MutPtr<Malloc>, gid: i64) string_view {
    z: string_view := ""    // str-typed lead so the mixed literal/variable array infers as [str]
    src := mp.zo_idpath("c", gid, ".zen")
    dir := mp.zo_idpath("d", gid, "")
    prog := mp.zo_idpath("p", gid, "")
    outp := mp.zo_idpath("o", gid, ".txt")
    mp.zo_join([z, "mkdir -p ", dir, "; timeout 60 ./zen emit ", src, " > ", dir, "/zo_body.c 2>/dev/null && cc -std=gnu11 -w -I", dir, " tests/harness_runner.c -o ", prog, " 2>/dev/null && timeout 30 ", prog, " > ", outp, " 2>/dev/null; true"])
}
// batch VALUE runner + reporter: build every case's command (serial), run them in parallel, then compare
// outputs IN ORDER, printing '.'/'F' and returning the failing count — same verdict as the serial loop.
// A failing case also prints `FAIL <name>[<idx>]: want … got …` (identity + expected vs actual), so a
// red suite is actionable without bisecting the case list.
run_values* = (name: string_view, cs: [VCase]) i32 {
    out(name)
    out("\n")
    m := Malloc(_: 0)
    mp := m.addr()
    n := cs.len
    base := malloc(n * 8)
    cmds: [string_view] := base.slice(n)
    cs.loop((h, i, c) {
        save(mp.zo_idpath("c", i, ".zen"), c.src, len(c.src))
        save(mp.zo_idpath("o", i, ".txt"), "", 0)    // clear stale output (mirrors serial's cleared zo_out.txt)
        cmds[i] = mp.zo_value_cmd(i)
    })
    zo_par_run(cmds, n)
    fails := 0
    cs.loop((h, i, c) {
        got := mp.contents_in(mp.zo_idpath("o", i, ".txt"))
        ok := got.match ({ .Ok(g) => eq(g, c.want), .Err(e) => false })
        ok.match ({
            true  => out("."),
            false => {
                out("F\n  FAIL ")
                out(name)
                out("[")
                out(mp.zo_itoa(i))
                out("]: want \"")
                out(c.want)
                out("\" got \"")
                got.match ({ .Ok(g) => out(g), .Err(e) => out("<no output — emit/cc/timeout failed>") })
                out("\"\n")
                fails = fails + 1
            },
        })
    })
    out("\n")
    free(base)
    fails
}
// VERDICT per-case command (Phase A→B): `zenc check` under `timeout 60`, recording the outcome as a
// THREE-state marker in `rc<gid>.txt`: P (accept), F (reject), T (timeout, rc ≥ 124 — the crash/hang
// threshold the fuzz category uses). The full diagnostic lands in `chk<gid>.txt`. (We can't return the
// shell exit code through the worker, so the outcome is recorded in a file and read back in Phase C.)
zo_verdict_cmd = (mp: MutPtr<Malloc>, gid: i64) string_view {
    z: string_view := ""
    v := mp.zo_idpath("v", gid, ".zen")
    chk := mp.zo_idpath("chk", gid, ".txt")
    rc := mp.zo_idpath("rc", gid, ".txt")
    mp.zo_join([z, "timeout 60 ./zen check ", v, " > ", chk, " 2>&1; rc=$?; if [ $rc -eq 0 ]; then echo P > ", rc, "; elif [ $rc -ge 124 ]; then echo T > ", rc, "; else echo F > ", rc, "; fi"])
}
// decode a P/F/T marker file: 0 = accepted, 1 = rejected, 2 = TIMEOUT (or missing/unreadable marker).
// 2 must ALWAYS fail the case — a hung or crashed compiler never satisfies an accept OR a reject
// expectation (a naive nonzero-exit-is-reject read would let a hang pass a reject case).
zo_rc_state = (mp: MutPtr<Malloc>, path: string_view) i64 {
    mp.contents_in(path).match ({
        .Ok(s)  => s.starts_with("P").match ({
            true  => 0,
            false => s.starts_with("F").match ({ true => 1, false => 2 }),
        }),
        .Err(e) => 2,
    })
}
// VERDICT per-case check (Phase C): identical logic to run_verdict — accept(P) vs reject(F), and when
// rejecting with a non-empty `kind`, the captured diagnostic must contain `error[<kind>]`. T fails always.
zo_verdict_ok = (mp: MutPtr<Malloc>, gid: i64, vc: VerdictCase) bool {
    st := mp.zo_rc_state(mp.zo_idpath("rc", gid, ".txt"))
    (st == 2).match ({
        true  => false,
        false => vc.should_pass.match ({
            true  => st == 0,
            false => (st == 0).match ({
                true  => false,
                false => is_empty(vc.kind).match ({
                    true  => true,
                    false => mp.contents_in(mp.zo_idpath("chk", gid, ".txt")).match ({
                        .Ok(txt) => txt.contains(mp.kind_needle(vc.kind)),
                        .Err(e)  => false,
                    }),
                }),
            }),
        }),
    })
}
// batch VERDICT runner + reporter: build (serial), run in parallel, check IN ORDER — same verdict as serial.
// A failing case also prints `FAIL <name>[<idx>]: want accept|reject[kind], got …` plus the captured
// diagnostic text (one positioned error), so the failure is self-explanatory.
run_verdicts* = (name: string_view, cs: [VerdictCase]) i32 {
    out(name)
    out("\n")
    m := Malloc(_: 0)
    mp := m.addr()
    n := cs.len
    base := malloc(n * 8)
    cmds: [string_view] := base.slice(n)
    cs.loop((h, i, c) {
        save(mp.zo_idpath("v", i, ".zen"), c.src, len(c.src))
        cmds[i] = mp.zo_verdict_cmd(i)
    })
    zo_par_run(cmds, n)
    fails := 0
    cs.loop((h, i, c) {
        st := mp.zo_rc_state(mp.zo_idpath("rc", i, ".txt"))
        ok := mp.zo_verdict_ok(i, c)
        ok.match ({
            true  => out("."),
            false => {
                out("F\n  FAIL ")
                out(name)
                out("[")
                out(mp.zo_itoa(i))
                out("]: want ")
                c.should_pass.match ({ true => out("accept"), false => out("reject") })
                (is_empty(c.kind) == false).then ({
                    out("[")
                    out(c.kind)
                    out("]")
                })
                out(", got ")
                (st == 0).match ({
                    true  => out("accept"),
                    false => (st == 1).match ({ true => out("reject"), false => out("TIMEOUT") }),
                })
                out("\n")
                mp.contents_in(mp.zo_idpath("chk", i, ".txt")).match ({
                    .Ok(txt) => out(txt),
                    .Err(e)  => {},
                })
                fails = fails + 1
            },
        })
    })
    out("\n")
    free(base)
    fails
}
// DIAGNOSTIC per-case command (Phase A→B): `zenc check` under `timeout 60`; record the same P/F/T
// marker as verdicts (`drc<gid>.txt`) plus the full diagnostic (`do<gid>.txt`) so Phase C can require
// every `wants` substring. T (timeout) fails the case — a hang is not a rejection.
zo_diag_cmd = (mp: MutPtr<Malloc>, gid: i64) string_view {
    z: string_view := ""
    v := mp.zo_idpath("dv", gid, ".zen")
    outp := mp.zo_idpath("do", gid, ".txt")
    rc := mp.zo_idpath("drc", gid, ".txt")
    mp.zo_join([z, "timeout 60 ./zen check ", v, " > ", outp, " 2>&1; rc=$?; if [ $rc -eq 0 ]; then echo P > ", rc, "; elif [ $rc -ge 124 ]; then echo T > ", rc, "; else echo F > ", rc, "; fi"])
}
// DIAGNOSTIC per-case check (Phase C): identical logic to run_diag — must reject (F) AND the diagnostic
// must contain every `wants` substring. T (timeout/missing marker) fails always.
zo_diag_ok = (mp: MutPtr<Malloc>, gid: i64, dc: DiagCase) bool {
    st := mp.zo_rc_state(mp.zo_idpath("drc", gid, ".txt"))
    (st == 1).match ({
        true  => mp.contents_in(mp.zo_idpath("do", gid, ".txt")).match ({
            .Ok(txt) => {
                all := true
                dc.wants.loop((h, i, wnt) {
                    (txt.contains(wnt) == false).then({
                        all = false
                    })
                })
                all
            },
            .Err(e)  => false,
        }),
        false => false,
    })
}
// batch DIAGNOSTIC runner + reporter: build (serial), run in parallel, check IN ORDER — same verdict as
// serial. A failing case also prints `FAIL <name>[<idx>]` with the missing needle(s), or why no
// rejection happened (accept/timeout).
run_diags* = (name: string_view, cs: [DiagCase]) i32 {
    out(name)
    out("\n")
    m := Malloc(_: 0)
    mp := m.addr()
    n := cs.len
    base := malloc(n * 8)
    cmds: [string_view] := base.slice(n)
    cs.loop((h, i, c) {
        save(mp.zo_idpath("dv", i, ".zen"), c.src, len(c.src))
        cmds[i] = mp.zo_diag_cmd(i)
    })
    zo_par_run(cmds, n)
    fails := 0
    cs.loop((h, i, c) {
        st := mp.zo_rc_state(mp.zo_idpath("drc", i, ".txt"))
        txt := mp.contents_in(mp.zo_idpath("do", i, ".txt"))
        ok := mp.zo_diag_ok(i, c)
        ok.match ({
            true  => out("."),
            false => {
                out("F\n  FAIL ")
                out(name)
                out("[")
                out(mp.zo_itoa(i))
                out("]")
                (st == 1).match ({
                    true  => {
                        out(": missing needle(s):\n")
                        c.wants.loop((h2, j, wnt) {
                            txt.match ({
                                .Ok(t) => (t.contains(wnt) == false).then ({
                                    out("    ")
                                    out(wnt)
                                    out("\n")
                                }),
                                .Err(e)  => {},
                            })
                        })
                    },
                    false => (st == 0).match ({
                        true  => out(": expected rejection, got accept\n"),
                        false => out(": expected rejection, got TIMEOUT\n"),
                    }),
                })
                fails = fails + 1
            },
        })
    })
    out("\n")
    free(base)
    fails
}
