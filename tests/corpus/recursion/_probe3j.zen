Link = {
    value: i64,
    next: Ptr<Link>,
}

// build a chain of n nodes; each pass allocates one node through the
// arena and hangs the recursive result off it. the Res from create is
// unwrapped by hand (match), not with .try(), because this function
// returns Link, not Res.
build = (alloc: Alloc, n: i64) Link {
    (n <= 0).match({
        true  => Link(value: 1000, next: null_ptr<Link>()),
        false => {
            cell = alloc.create<Link>().match({
                Ok(p)  => p,
                Err(_) => null_ptr<Link>(),
            });
            inner = build(alloc, n - 1);
            cell.write(0, inner);
            Link(value: n * 10, next: cell);
        },
    });
}

sum = (node: Link) i64 {
    node.next.is_null().match({
        true  => node.value,
        false => node.value + sum(node.next.read(0)),
    });
}

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    println("{}", sum(build(alloc, 5)));
    Ok(0);
}
