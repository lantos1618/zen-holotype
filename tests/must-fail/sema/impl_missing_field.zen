// an impl supplies a value for EVERY field the bound declares. `height`
// is missing, so Tile does not satisfy Boxy and `area` has nothing to
// read. layout is fixed at declaration, so this cannot be papered over.
//
// position: the impl declaration.

Boxy = {
    width: i32,
    height: i32,

    area* ::= (self: @Self) i32 { self.width * self.height }
}

Tile = {
    side: i32,
}

Tile.impl(Boxy, {
    width: self.side,
})

main = (env: Env) Res<i32, AllocError> {
    println("{}", Tile(side: 2).area());
    Ok(0);
}
