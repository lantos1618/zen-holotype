// A FIELD WALK NEEDS A STRUCT DECLARATION TO WALK, and everything else
// is still the wall M0 built (`docs/design_meta.md` §7, M4). A
// primitive has no declaration payload to read `members` off; an enum
// has variants, not fields; a type parameter and the `@Self` of a trait
// DEFAULT body are still OPEN — one body shared by every implementor,
// so expanding it would expand it for whichever type was checked first
// and silently mean that for all the rest (§5, "check once is wrong").
//
// REFUSED BY NAME, AT THE `@meta` TOKEN, rather than unrolled over
// nothing — a walk over zero fields prints nothing at all, which is the
// plausible-looking wrong answer §6.4 is about.
//
// position: the `@meta` token.

main = (env: Env) Res<i32, AllocError> {
    n = 7;
    @meta(n: i64).fields().loop((h, field) {
        println("{}", field.name);
    });
    Ok(0);
}
