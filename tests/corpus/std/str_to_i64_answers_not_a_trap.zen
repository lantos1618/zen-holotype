// tests/corpus/std/str_to_i64_answers_not_a_trap.zen
// the four answers a hand-rolled parser gets wrong (issue #774's own
// list): "" and "3x" are absences — no number was there, and a reason
// would be invented — while "-3", the sign, and 9223372036854775808,
// one past i64.MAX, are numbers that must not silently wrap or lose
// their sign. Every case asserts the ANSWER, never a trap: Res<i64>
// is the shape, None is the miss, Ok is the value.
//
// The overflow row is spelled as its decimal, not as i64.MAX + 1: the
// compiler folds what it can prove will fire, and this test is about
// what the PARSER answers for text nobody could have written as a
// literal.

main = (env: Env) Res<i32, AllocError> {
    "".parse_i64().match({
        Ok(n) => { println("empty {}", n); },
        None  => { println("empty none"); },
    });

    "-3".parse_i64().match({
        Ok(n) => { println("signed {}", n); },
        None  => { println("signed none"); },
    });

    "3x".parse_i64().match({
        Ok(n) => { println("trailing {}", n); },
        None  => { println("trailing none"); },
    });

    "9223372036854775808".parse_i64().match({
        Ok(n) => { println("overflow {}", n); },
        None  => { println("overflow none"); },
    });

    "9223372036854775809".parse_i64().match({
        Ok(n) => { println("positive boundary+1 {}", n); },
        None  => { println("positive boundary+1 none"); },
    });

    "-9223372036854775809".parse_i64().match({
        Ok(n) => { println("negative boundary+1 {}", n); },
        None  => { println("negative boundary+1 none"); },
    });

    // and the boundaries the misses sit between: MIN and MAX themselves
    // are in range and come back whole
    "-9223372036854775808".parse_i64().match({
        Ok(n) => { println("min {}", n); },
        None  => { println("min none"); },
    });
    "9223372036854775807".parse_i64().match({
        Ok(n) => { println("max {}", n); },
        None  => { println("max none"); },
    });
    Ok(0);
}
