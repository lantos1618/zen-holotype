// tests/corpus/std/loop_map_allocates.zen
// map is the one loop word that allocates, so it takes an Alloc
// and has its own NAME rather than being an overload of loop: a
// generic init: A would swallow alloc: Alloc and they could not be
// told apart

LoopError = | NoResult

main = (env: Env) Res<i32, LoopError> {
    alloc ::= env.mem.alloc();

    doubled = Range(1, 4).map(alloc, (h, index, value) {
        value * 2
    }).ok_or(LoopError.NoResult).try();

    println("len {}", doubled.len);
    doubled.loop((h, n) {
        println("{}", n);
    });
    Ok(0);
}
