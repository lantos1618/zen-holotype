// the twin of string_backslash_before_newline on a CRLF checkout. the
// backslash before the CR escapes nothing either: zen has no line
// continuation, and the ending arriving as two bytes does not make it
// one.
//
// before the fix this said "unknown escape sequence" first, at the
// backslash -- a rule nobody broke at a byte that is not where the fix
// goes -- and the true sentence arrived second. one mistake, one
// diagnostic: the span-lines rule, at the opening quote, and nothing
// else.
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    x = "abc\
    Ok(0);
}
