// `c ? a : b` is the LAZY conditional expression — parse-level sugar for the boolean two-arm
// `.match`, so ONLY the taken arm ever evaluates. Side-effecting arms prove it: each taken arm
// prints its tag and bumps `calls`; a skipped arm printing "SKIPPED" (or a final calls-count
// mismatch) fails the stdout comparison. Also covers: a bare `a || b` condition (precedence sits
// below `||`), a nested conditional in an else arm, and a parenthesized ternary as a Bin operand.
{ println } = std.text.fmt
calls := 0
tick = (tag: string_view, v: i32) i32 {
    calls = calls + 1
    println(tag)
    v
}
grade = (n: i32) string_view {
    (n < 3).match ({
        true  => "low",
        false => n < 10 ? "mid" : "high",
    })
}
main = () i32 {
    a := true ? tick("then", 1) : tick("SKIPPED", 100)
    b := false ? tick("SKIPPED", 100) : tick("else", 2)
    n := 7
    c := n > 5 || n < 0 ? tick("or-cond", 3) : tick("SKIPPED", 100)
    println(grade(1))
    println(grade(7))
    println(grade(12))
    println((true ? 4 : 100) + (calls == 3 ? 10 : 200))
    a + b + c - 6
}
