# tools/fleet/tests/plan.list -- the work list `fleet plan` takes its
# baselines from. Three whitespace-separated fields: name, prompt, target.
# The paths are relative because the oracle copies this directory into a
# temp tree and runs there; nothing here touches the repository.
changed  prompts/noop.txt  targets/changed.txt
stuck    prompts/noop.txt  targets/stuck.txt
