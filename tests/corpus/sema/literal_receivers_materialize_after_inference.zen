identity = <T>(value: T) T { value }
which = (self: i8) i32 { 8 }
which = (self: i32) i32 { 32 }
apply = <T>(value: T, body: (value: T) T) T { body(value) }

Holder<T> = {
    value: T,
    keep = <U>(self: @Self, item: U) U { item }
}

main = () () {
    holder = Holder<str>(value: "receiver");
    println(
        "{} {} {}",
        (9).to_i64(),
        identity(7).to_i64(),
        holder.keep(8).to_i64()
    );
    println("default {}", identity(7).which());
    saved = holder.keep(11);
    println("{}", saved.to_i64());
    typed: u64 = 4294967296;
    println(
        "{} {}",
        holder.keep(typed).to_i32().value_or(-1),
        holder.keep<u64>(4294967296).to_i32().value_or(-1)
    );
    contextual = apply(identity(5), (value: usize) { value + 2 });
    println("{}", contextual.to_u64());
}
