// src/lsp/lsp_def.zen
// `textDocument/definition` — where the name under the cursor was declared.
//
// `ast_named.told_at` finds the name; the checker's settled memos carry its
// declaration span:
//
//   a call site        -> `call_memo` (which declaration the call meant)
//   a module-level name -> `defs_of` (what the name means here)
//   an import binding   -> `defs_of` (the same visibility answer)
//   a member after a dot -> `expr_memo` on the base, then `members_of`
//   a written type     -> `type_memo`, then the `Named` type's decl
//                         (`Res<T>` routes through `defs_of` instead —
//                         it interns as its own variant, not `Named`)
//
// Resolution remains in sema. A miss is `null`, never a guess. Locals and
// pattern binders also return `null` until sema retains their binding spans.

str, String = std.text
Vec = std.collections
Alloc, AllocError = std.mem
Range = std.core
ExprId, TypeId, Span, Pos, Access, Function, QualifiedName = std.ast
in_span, nowhere = std.ast
Checker = sema.sema_check
TyId = sema.sema_ty
Def, decl_at, dotted = sema.sema_def
def_type = sema.sema_type
DeclId = sema.sema_id
Found, members_of, first_found = sema.sema_member
to_pos, to_wire, WirePos, write_wire = lsp.lsp_pos
path_of, uri_at = lsp.lsp_uri
told_at, module_index_of = std.ast.ast_named
check_standalone, check_build = lsp.lsp_query
obj = std.json

// A definition, ready for the wire. `found` is false both for a position
// covered by nothing and for one whose declaration the checker never
// wrote down — a local, a pattern binder, a builtin.
Target* = {
    found*: bool,
    uri*: str,
    start*: WirePos,
    end*: WirePos,
}

// What `sought` settles: the declaration's span, still in ZEN
// coordinates and naming its own file — converting needs the file's
// bytes and, for another module, its URI, both of which only the caller
// with the workspace in hand can produce.
Defn* = {
    found*: bool,
    span*: Span,
}

// A lone buffer has no workspace imports; its URI is its span's file name.
definition_at* = (
    a         : Alloc,
    uri       : str,
    text      : str,
    line      : usize,
    character : usize
) Res<Target, AllocError> {
    c ::= check_standalone(a, uri, text).try();
    pos = to_pos(text, line, character);
    d   = sought(c, a, uri, pos).try();
    Ok(Target(
        found: d.found,
        uri: uri,
        start: to_wire(text, d.span.start),
        end: to_wire(text, d.span.end)
    ));
}

// A workspace build overlays the unsaved buffer. A cross-module target is
// converted against the target file's bytes, not the open document's.
definition_in* = (
    env       : Env,
    a         : Alloc,
    workspace : str,
    path      : str,
    uri       : str,
    text      : str,
    line      : usize,
    character : usize
)
                 Res<Target, AllocError> {
    checked = check_build(env, a, workspace, path, text).try();
    pos     = to_pos(text, line, character);
    d       = sought(checked.c, a, checked.rel, pos).try();
    placed(env, a, checked.root, uri, text, checked.rel, d)
}

// The shared slot already owns the checker; this reads it without rebuilding.
definition_with* = (
    env       : Env,
    c         : Checker,
    a         : Alloc,
    root      : str,
    uri       : str,
    text      : str,
    rel       : str,
    line      : usize,
    character : usize
)
                   Res<Target, AllocError> {
    pos = to_pos(text, line, character);
    d   = sought(c, a, rel, pos).try();
    placed(env, a, root, uri, text, rel, d)
}

// The span, carried to the wire. The open buffer's own text converts a
// same-file span; anything else is read from the disk. AN UNREADABLE
// TARGET STILL ANSWERS: `to_wire` clamps an empty text to 0:0, so the
// jump names the right file at a degenerate range rather than failing —
// the same refusal-to-drop `lsp_diag.zen` makes for a diagnostic.
placed = (
    env  : Env,
    a    : Alloc,
    root : str,
    uri  : str,
    text : str,
    rel  : str,
    d    : Defn
) Res<Target, AllocError> {
    d.found.match({
        false => Ok(no_target()),
        true  => wired_target(env, a, root, uri, text, rel, d.span),
    })
}

wired_target = (
    env  : Env,
    a    : Alloc,
    root : str,
    uri  : str,
    text : str,
    rel  : str,
    span : Span
) Res<Target, AllocError> {
    same  = span.file.eq(rel);
    at    = same.match({ true => uri, false => uri_at(
        a,
        root,
        span.file
    ).try() });
    bytes = same.match({ true => text, false => disk_text(
        env,
        a,
        path_of(at)
    ) });
    Ok(Target(
        found: true,
        uri: at,
        start: to_wire(bytes, span.start),
        end: to_wire(bytes, span.end)
    ));
}

// The bytes of a file the overlay does not hold. `lsp_diag.zen`'s
// `on_disk` is this same five lines, private to its file; the second
// caller is here.
disk_text = (env: Env, a: Alloc, path: str) str {
    env.fs.read(a, path).match({
        Ok(text) => text.view(),
        Err(_)   => "",
    })
}

// --- the resolution order ----------------------------------------------
//
// call site, then module-level name, then member — the order the task's
// table in `design_lsp.md` §2 lists the spans in. Each arm answers from
// ONE source and a miss falls through to the next.

sought = (c : Checker, a: Alloc, file: str, p: Pos) Res<Defn, AllocError> {
    module = import_module_defn(c, a, file, p).try();
    module.found.match({
        true  => Ok(module),
        false => told_at(c.tree, file, p).match({
            Nothing     => no_defn(),
            Sig(f)      => defn_of(f.name.span),
            OfType(ta)  => type_defn(c, a, ta.id, file),
            OfValue(v)  => value_defn(c, a, v.id, file, p),
            Imported(n) => global_defn(c, a, n.text, file),
        }),
    })
}

import_module_defn = (c : Checker, a: Alloc, file: str, p: Pos)
                     Res<Defn, AllocError> {
    found ::= no_defn().try();
    module_index(c, file).match({
        None     => (),
        Ok(from) => c.tree.module_at(from).match({
            None    => (),
            Ok(src) => src.decls.loop((h, d) {
                d.kind.match({
                    Import(im) => in_span(im.module.span, file, p).then(() {
                        found = module_defn(c, a, im.module).try();
                    }),
                    _          => (),
                });
            }),
        }),
    });
    Ok(found)
}

module_defn = (c : Checker, a: Alloc, q: QualifiedName)
              Res<Defn, AllocError> {
    name = dotted(a, q).try();
    c.world.index_of(name).match({
        None     => no_defn(),
        Ok(into) => c.tree.module_at(into).match({
            None    => no_defn(),
            Ok(dst) => defn_of(Span(
                file: dst.span.file,
                start: dst.span.start,
                end: dst.span.start
            )),
        }),
    })
}

// A WRITTEN TYPE: the memo says what it resolved to, and a `Named` type
// knows its declaration. `Res<T>` interns as the dedicated `Res` variant,
// not `Named`, and carries no decl — its name is asked of the visibility
// query like any other (`Res = std.core.result` here, the prelude
// elsewhere). Anything else — a primitive like `i32`, a poisoned name —
// is `null`: a builtin has no declaration to jump to and an unresolved
// name has none worth inventing.
type_defn = (c : Checker, a: Alloc, id: TypeId, file: str)
            Res<Defn, AllocError> {
    c.type_memo.get(id).match({
        None     => no_defn(),
        Ok(memo) => c.types.at(memo).match({
            Named(n) => decl_defn(c, n.decl),
            Res(_)   => global_defn(c, a, "Res", file),
            _        => no_defn(),
        }),
    })
}

value_defn = (c : Checker, a: Alloc, id: ExprId, file: str, p: Pos)
             Res<Defn, AllocError> {
    e = c.tree.expr_at(id);
    // `told_at` answers a BIND TARGET with the VALUE's node (the span is
    // the target's, the id the value's) — hover wants that type, a
    // definition does not: the node not covering the cursor is how the
    // substitution reads here, and a local's own span is the L3 gap this
    // file deliberately does not close.
    in_span(e.span, file, p).match({
        false => no_defn(),
        true  => e.kind.match({
            Name(n)    => name_defn(c, a, id, n.text, file),
            Access(ac) => access_defn(c, a, id, ac, file, p),
            _          => no_defn(),
        }),
    })
}

// A BARE NAME: a call's callee first (resolution already chose the
// declaration — asking `defs_of` again would re-run overload resolution
// badly), then an ordinary module-level name. A name neither answers is
// a local or a builtin: `null`.
name_defn = (c : Checker, a: Alloc, id: ExprId, text: str, file: str)
            Res<Defn, AllocError> {
    called_decl(c, id).match({
        Ok(did) => decl_defn(c, did),
        None    => global_defn(c, a, text, file),
    })
}

// A MODULE-LEVEL NAME, resolved by the one query that owns visibility —
// own declarations, then starred imports hop by hop, then the prelude.
global_defn = (c : Checker, a: Alloc, text: str, file: str)
              Res<Defn, AllocError> {
    module_index(c, file).match({
        None   => no_defn(),
        Ok(mi) => {
            found ::= a.Vec<Def>();
            c.world.defs_of(mi, text, found).try();
            found.get(0).match({
                None  => no_defn(),
                Ok(d) => decl_defn(c, d.id),
            })
        },
    })
}

// A MEMBER AFTER A DOT. The cursor must be on the name — a position on
// the dot or the base is not a member use. A CALL through the access
// (`x.f(..)`) resolved its member already; a bare read asks
// `members_of` about the base's memoized type.
access_defn = (
    c    : Checker,
    a    : Alloc,
    id   : ExprId,
    ac   : Access,
    file : str,
    p    : Pos
) Res<Defn, AllocError> {
    in_span(ac.name.span, file, p).match({
        false => no_defn(),
        true  => called_decl(c, id).match({
            Ok(did) => decl_defn(c, did),
            None    => member_defn(c, a, ac, file),
        }),
    })
}

member_defn = (c : Checker, a: Alloc, ac: Access, file: str)
              Res<Defn, AllocError> {
    c.expr_memo.get(ac.base).match({
        Ok(ty) => found_defn(c, a, ty, ac.name.text),
        None   => static_defn(c, a, ac, file),
    })
}

// `base.name` where the base IS A TYPE — `Shape.Unit`, `i32.MAX` — so no
// `expr_memo` entry exists for it (`sema_member.base_of` records value
// bases only). A variant's span comes off the enum's declaration; a
// static member goes through `members_of` like any other.
static_defn = (c : Checker, a: Alloc, ac: Access, file: str)
              Res<Defn, AllocError> {
    c.tree.expr_at(ac.base).kind.match({
        Name(n) => typed_base_defn(c, a, n.text, ac.name.text, file),
        _       => no_defn(),
    })
}

typed_base_defn = (c : Checker, a: Alloc, base: str, name: str, file: str)
                  Res<Defn, AllocError> {
    module_index(c, file).match({
        None   => no_defn(),
        Ok(mi) => {
            defs ::= a.Vec<Def>();
            c.world.defs_of(mi, base, defs).try();
            defs.get(0).match({
                None  => no_defn(),
                Ok(d) => variant_or_member(c, a, d, name),
            })
        },
    })
}

variant_or_member = (c : Checker, a: Alloc, d: Def, name: str)
                    Res<Defn, AllocError> {
    variant_defn(c, d, name).match({
        Ok(span) => defn_of(span),
        None     => {
            ty = c.def_type(d).try();
            found_defn(c, a, ty, name)
        },
    })
}

// A variant's own span, read off the declaration — `cases_of` answers
// what a value of the type can BE but carries no spans, so the AST is
// the source here. Not a second resolution rule: which NAME denotes the
// type is still `defs_of`'s answer above.
variant_defn = (c : Checker, d: Def, name: str) Res<Span> {
    decl_at(c.tree, d.id).match({
        None   => None,
        Ok(dd) => dd.kind.match({
            Enum(e) => Range(0, e.variants.len).find((i) {
                e.variants.get(i).match({
                    None  => false,
                    Ok(v) => v.name.text.eq(name),
                })
            }).match({
                None  => None,
                Ok(i) => e.variants.get(i).match({
                    None  => None,
                    Ok(v) => Ok(v.name.span),
                }),
            }),
            _       => None,
        }),
    })
}

// Every member of `ty` called `name`, first one wins — the set is what
// resolution saw, and a hidden one is still where the jump goes (the
// access site is where THAT mistake is reported, not here).
found_defn = (c : Checker, a: Alloc, ty: TyId, name: str)
             Res<Defn, AllocError> {
    found ::= a.Vec<Found>();
    c.members_of(ty, name, found).try();
    first_found(found).match({
        None  => no_defn(),
        Ok(f) => defn_of(f.span),
    })
}

// THE CALL THIS NAME OR ACCESS WAS THE CALLEE OF, if any. `call_memo` is
// keyed on the CALL and nothing links a child upward, so this is one
// scan of the arena — the same fold `lsp_names.zen` makes for colour.
called_decl = (c : Checker, id: ExprId) Res<DeclId> {
    eid ::= ExprId(index: 0);
    hit ::= false;
    did ::= DeclId(module: 0, decl: 0);
    Range(0, c.tree.expr_ids()).loop((h, i) {
        callee_of(c, eid, id).match({
            None  => (),
            Ok(d) => { hit = true; did = d; },
        });
        eid = ExprId(index: eid.index + 1);
    });
    hit.match({ true => Ok(did), false => None })
}

// This expression, when it is a resolved call through `id`.
callee_of = (c : Checker, eid: ExprId, id: ExprId) Res<DeclId> {
    c.tree.expr_at(eid).kind.match({
        Call(k) => (k.callee.index == id.index).match({
            true  => c.call_memo.get(eid),
            false => None,
        }),
        _       => None,
    })
}

// The declaration, pointed at its NAME rather than its whole span: an
// editor underlines the identifier, and every kind that binds one has
// it in the same place. Impls and imports bind no name of their own.
decl_defn = (c : Checker, id: DeclId) Res<Defn, AllocError> {
    decl_at(c.tree, id).match({
        None  => no_defn(),
        Ok(d) => d.kind.match({
            Struct(s)   => defn_of(s.name.span),
            Enum(e)     => defn_of(e.name.span),
            Alias(x)    => defn_of(x.name.span),
            Function(f) => defn_of(f.name.span),
            Const(k)    => defn_of(k.name.span),
            _           => no_defn(),
        }),
    })
}

// Which module the cursor is in, as a `World` index — the arena scan
// lives in `ast_named.zen` (`module_index_of`), shared with completion.
module_index = (c : Checker, file: str) Res<usize> {
    module_index_of(c.tree, file)
}

// --- the two constructors and the wire shape ----------------------------

defn_of = (span: Span) Res<Defn, AllocError> {
    Ok(Defn(found: true, span: span))
}

no_defn = () Res<Defn, AllocError> {
    Ok(Defn(found: false, span: nowhere()))
}

no_target* = () Target {
    Target(
        found: false,
        uri: "",
        start: WirePos(line: 0, character: 0),
        end: WirePos(line: 0, character: 0)
    )
}

// A `Location` as the protocol spells one. The URI is TEXT-built, like
// every reply in this folder — `write_text` escapes, one rule.
write_location* = (t: Target, out :: String) Res<(), AllocError> {
    at ::= obj(out).try();
    at.text("uri", t.uri, out).try();
    at.key("range", out).try();
    range ::= obj(out).try();
    range.key("start", out).try();
    write_wire(t.start, out).try();
    range.key("end", out).try();
    write_wire(t.end, out).try();
    range.close(out).try();
    at.close(out)
}
