// The argument shape `scripts/fixpoint.sh` depends on, pinned.
//
//     zen build <root> --emit-c -o <file.c>
//
// `zen-1` is built out of `stage1.c` and then invoked exactly that way,
// so this is not a test of a convenience — it is a test of the gate's
// interface. If `cli` stops reading that line, the strongest oracle in
// the project stops running and says nothing about why.
//
// The other half is the commands PLAN.md names. `fmt` arrived at stage
// 2 and is read here as itself — a flag and a list of files, where a
// list of none is not a smaller format but no command at all. `test`
// and `lsp` must still come back as THEMSELVES and not as usage errors:
// an unwritten command and a typo are different answers, and a caller
// acts on the difference.
//
// `cli` takes a `Vec<str>` and touches no capability, which is why this
// test can hand it argument vectors no real command line would produce.

Alloc, AllocError = std.mem
Vec = std.collections
str = std.text
Cli, Job, FmtJob, cli = zen

main = (env: Env) Res<i32, AllocError> {
    a ::= env.mem.alloc();

    // exactly what the fixpoint runs
    show(a, line(a, "build", "src", "--emit-c", "-o", "stage2.c").try()).try();

    // the flags in another order: a scan, not a positional grammar
    show(a, line(a, "build", "-o", "out.c", "src", "--emit-c").try()).try();

    // `--emit-c-dir <dir>` IS the build too — one `.c` per module and a
    // `zen.h` beside them, which is what `make build` compiles with
    // `-j`. It names a DIRECTORY, so `out` stays empty and the driver
    // reads which shape was asked for off `dir` alone.
    show(a, line(a, "build", "src", "--emit-c-dir", "build/c", "").try()).try();

    // a root and nothing else is NOT a complete command. `--emit-c` is
    // the build: without it the compiler checks the world, throws the
    // answer away and writes no file, and it used to call that success.
    // `make build` stood on that exit 0 and produced no binary, which
    // took `test`, `fmt` and `determinism` down with it.
    show(a, line(a, "build", "src", "", "", "").try()).try();

    // and the root is still required first: a missing subject outranks
    // a missing flag, because naming the second sends the caller to fix
    // a line that has a bigger hole in it
    show(a, line(a, "build", "", "", "", "").try()).try();

    // the gate `make fmt` runs, and the same without the flag
    show(a, line(a, "fmt", "--check", "a.zen", "b.zen", "").try()).try();
    show(a, line(a, "fmt", "a.zen", "", "", "").try()).try();

    // a format with no files is not a smaller format, it is nothing —
    // the reading `built` takes of a build with no `--emit-c`
    show(a, line(a, "fmt", "--check", "", "", "").try()).try();
    show(a, line(a, "fmt", "", "", "", "").try()).try();

    // and an unknown flag is still NAMED rather than read as a path
    show(a, line(a, "fmt", "--fix", "a.zen", "", "").try()).try();

    // named, not yet written
    show(a, line(a, "lsp", "", "", "", "").try()).try();
    show(a, line(a, "test", "", "", "", "").try()).try();

    // nothing said at all
    show(a, line(a, "", "", "", "", "").try()).try();

    // a command this compiler does not have
    show(a, line(a, "wat", "", "", "", "").try()).try();

    // build with no root: the flags parsed, the subject did not arrive
    show(a, line(a, "build", "--emit-c", "", "", "").try()).try();

    // a flag nobody knows is NAMED rather than read as the root, which
    // is how a typo in `--emit-c` becomes a compiler that quietly
    // compiles the wrong tree
    show(a, line(a, "build", "src", "--emit-see", "", "").try()).try();

    // a second positional is a mistake and not a second root
    show(a, line(a, "build", "src", "other", "", "").try()).try();

    Ok(0);
}

show = (a: Alloc, argv: Vec<str>) Res<(), AllocError> {
    cli(argv).match({
        Build(j)   => { println(
            "build root={} out={} dir={} emit_c={}",
            j.root,
            j.out,
            j.dir,
            j.emit_c
        ); },
        Fmt(j)     => { fmt_line(a, j).try(); },
        Later(n)   => { println("later {}", n); },
        Usage(w)   => { println("usage `{}`", w); },
        Missing(f) => { println("missing `{}`", f); },
    });
    Ok(());
}

// The paths are read back off the argv rather than carried in the job:
// `cli` takes no `Alloc`, and gathering them allocates.
fmt_line = (a: Alloc, j: FmtJob) Res<(), AllocError> {
    paths = j.paths(a).try();
    println(
        "fmt check={} paths={} first={}",
        j.check,
        paths.len,
        paths.get(0).match({ Ok(p) => p, None => "" })
    );
    Ok(());
}

// `argv.get(0)` is the program path, so every line starts with one.
// `""` is not an argument — a real argv holds no empty strings — so it
// stands for "this line ends here".
line = (a: Alloc, w0: str, w1: str, w2: str, w3: str, w4: str)
       Res<Vec<str>, AllocError> {
    v ::= a.Vec<str>();
    v.add("/usr/bin/zen").try();
    v.push(w0).try();
    v.push(w1).try();
    v.push(w2).try();
    v.push(w3).try();
    v.push(w4).try();
    Ok(v);
}

push = (v :: Vec<str>, w: str) Res<(), AllocError> {
    w.is_empty().match({
        true  => Ok(()),
        false => v.add(w),
    })
}
