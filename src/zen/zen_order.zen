// src/zen/zen_order.zen
// What order the module walk reaches modules in.
//
// A LEAF, ARITHMETIC ON AN INDEX. Imports `std.text` for `str.eq` and
// nothing else — no `Build`, no `Job`, no capability — so both the
// walking driver (`zen_build.zen`) and the repeating driver
// (`zen_run.zen`) can stand on it without standing on each other.
// `zen_path.zen` is the same shape, same reason.
//
// EXISTS FOR ONE GATE: `tests/determinism/check.sh` check 3 has
// nothing to vary without it — the self-hosted CLI computes module
// order itself from a ROOT, so the old file-list-shuffle axis had
// nowhere to attach. See tests/determinism/README.md, "the shuffle axis".

str = std.text

// THE `i`th MODULE TO REACH, out of `n` — the whole of `--permute`.
// Three fixed permutations, the same three `check.sh` applies. Fixed,
// never random: a gate that fails once and passes on rerun teaches you
// to press rerun.
//
// WHAT IT GUARDS: `gen_c_decl.zen` claims every list is sorted by
// mangled name, making output independent of discovery order — a claim
// no gate previously read. Reordering the walk changes every module
// index and, with it, insertion order into every table sema/gen build.
//
// THE ENTRY IS NEVER PERMUTED (the walk queues it before this is
// reached; `emit_program(be, 0, out)` compiles module 0;
// `root_declares_main` asks module 0 for `main`) — only imported
// modules move. WHICH modules load can't change either: the reachable
// set is a closure, independent of computation order.
// Early return over a chain, as in `lsp_reply.zen:request_of`: each guard
// names the one mode it spells, the last break the identity for everything
// else. The typed binding is load-bearing for the reason its own comment
// states.
walk_index* = (mode: str, n: usize, i: usize) usize {
    found: Res<usize> = loop<usize>((h) {
        mode.eq("reverse").then(() { h.break(n - 1 - i) });
        mode.eq("rotate").then(() { h.break((i + 1) % n) });
        mode.eq("interleave").then(() { h.break(interleaved(n, i)) });
        h.break(i);
    });
    found.match({
        Ok(one) => one,
        None    => i,
    });
}

// Odd indices first, then even ones — the one of the three a descending
// sort does not also produce, which is why three permutations are
// checked and not one.
interleaved = (n: usize, i: usize) usize {
    half = n / 2;
    (i < half).match({
        true  => i * 2 + 1,
        false => (i - half) * 2,
    })
}
