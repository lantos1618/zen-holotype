Link = {
    value: i64,
    next: Ptr<Link>,
}

// the recursion allocates through a HELPER that takes the arena and a
// spare cell; create itself happens once in main.
cell_of = (spare: Link, cell: Ptr<Link>) Link {
    cell.write(0, spare);
    spare;
}

build = (alloc: Alloc, cell: Ptr<Link>, n: i64) Link {
    (n <= 0).match({
        true  => Link(value: 1000, next: null_ptr<Link>()),
        false => {
            rest_cell = build(alloc, cell.next.read(0), n - 1);
            wrapped = cell_of(Link(value: n * 10, next: rest_cell), cell);
            wrapped;
        },
    });
}

main = (env: Env) Res<i32, AllocError> {
    Ok(0);
}
