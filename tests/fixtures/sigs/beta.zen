// tests/fixtures/sigs/beta.zen — generic / trait / impl / variadic surface for the tools/sigs.zen
// harness case (parsed, never compiled).
Boxy*<T>: {
    v: T,
}
unwrap*<T> = (b: Boxy<T>, dflt: T) T { b.v }
sum_all* = (xs: ...i64) i64 { 0 }
Shape*: {
    area: (arg0: Self) i64,
}
Sq: {
    side: i64,
}
Sq.impl(Shape, {
    area = (s: Sq) i64 { s.side * s.side }
})
