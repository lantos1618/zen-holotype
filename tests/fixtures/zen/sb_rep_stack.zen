// std.text.sb rep is ITERATIVE — a 1,000,000-repeat must run flat, not recurse. Plain-cc builds
// (bootstrap CFLAGS, the harness's `cc -std=gnu11 -w`) carry no -O flag, so C tail calls are NOT
// eliminated: a self-calling rep at this depth is a verified segfault. This pins the loop route:
// half a million "ab"s (one reservation + a modulo fill), then spot-checks length and bytes.
{ Malloc } = std.mem.alloc
{ Sb, sb } = std.text.sb
{ len, at } = std.text.str
{ to_exit } = std.core.bool
main = () i32 {
    m := Malloc(_: 0)
    a := m.addr()
    ok := a.sb().rep("ab", 500000).done().match ({
        .Ok(t)  => len(t) == 1000000
            && t.at(0) == 'a'
            && t.at(1) == 'b'
            && t.at(999998) == 'a'
            && t.at(999999) == 'b',
        .Err(e) => false,
    })
    ok.to_exit()
}
