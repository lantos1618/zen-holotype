// DESIGN.md, verbatim: `add` is `self :: @Self`, so it needs a
// mutable receiver, and `v` is a `:` binding.
//
//   v = alloc.Vec<i32>();    v.add(1);   // ERROR
//   w ::= alloc.Vec<i32>();  w.add(1);   // ok
//
// the diagnostic points at the receiver, not at the method name: the
// receiver is the thing that is wrong and `::=` is the fix.

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    v = alloc.Vec<i32>();
    v.add(1).try();
    Ok(0);
}
