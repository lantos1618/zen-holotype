// A wildcard arm IN THE MIDDLE of the chain, narrowed by the case before
// it, with a nullary case still to come.
//
// `Right(Mark(_))` then `Right(_)` then `Gone`: the fourth arm is a
// wildcard, but it may only speak for what is left of RIGHT. A lowering
// that turns any `_` into the chain's unconditional else stops testing tags
// at that arm and hands `Gone` to it -- G's input prints RO. The same trap
// one level down: `Right(_)` standing in for `Mark` as well as `Blank` and
// `Full` would print RO for RM's input too. Five inputs, five different
// arms, five different words, so a swallowed case is visible on the line
// it happens on.
//
// Breaks if: a mid-chain wildcard arm is emitted without its own case
// guard (as the final else of everything above it) -- the last line
// answers "RO" instead of "G".

Cell = Full(i64) | Blank | Mark(i64)

Slot = Left(Cell) | Right(Cell) | Gone

word = (s: Slot) str {
    s.match({
        Left(Full(_))  => "LF",
        Left(_)        => "LO",
        Right(Mark(_)) => "RM",
        Right(_)       => "RO",
        Gone           => "G",
    });
}

main = (env: Env) Res<i32, AllocError> {
    println("{}", word(Slot.Left(Cell.Full(1))));
    println("{}", word(Slot.Left(Cell.Blank)));
    println("{}", word(Slot.Right(Cell.Mark(9))));
    println("{}", word(Slot.Right(Cell.Full(1))));
    println("{}", word(Slot.Gone));
    Ok(0);
}
