// tests/bench/bench_loop.zen
// the claim: loops NEVER allocate. bodies are stack closures
// inlined at the call site, index and acc thread by value, and a
// fold over a stack array compiles to a plain C for-loop.
//
//   Budget(name: "fold_stack_array", allocs_op: 0)
//
// allocs_op: 0 is the load-bearing number and the only one
// TESTING.md names; if it is ever 1, an inliner regressed and the
// body is being boxed

Bencher, TestError = std.test

// THE MEASURED OPERATION, AND THE ONLY COPY OF IT.
// drivers/fold_stack_array.zen imports THIS function and runs it in
// a plain loop; it does not restate the body. The driver used to
// hold a hand-mirrored duplicate and nothing compared the two, so
// `allocs_op: 0` -- cited in four places in src/ -- could drift into
// measuring a program that no longer resembled this one.
// scripts/bench.py asserts the sharing (`verify_shared_body`) and
// exits 2 if a driver ever restates a body again.
fold_stack_array_body* = () i32 {
    xs = [1, 2, 3, 4, 5, 6, 7, 8];
    xs.loop(0, (h, index, value, acc: i32) {
        acc + value
    }).match({
        Ok(sum) => sum,
        None    => 0,
    })
}

fold_stack_array* = (bn: Bencher) Res<(), TestError> {
    total ::= 0;
    bn.iter(() {
        total = total + fold_stack_array_body();
    });
    Ok(());
}
