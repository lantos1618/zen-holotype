// `\v` and `\f` are in the escape set, and each carries the byte a C
// programmer expects: vertical tab is 11, form feed is 12. Before they
// were spellable, std.core.byte.is_space had to write those two as bare
// numbers -- the one place in the tree a byte had no literal.
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    v: u8 = '\v';
    f: u8 = '\f';
    println("{}", v);
    println("{}", f);

    // a string carries the same two bytes, and each escape is ONE byte
    s = "\v\f";
    println("{}", s.len);
    println("{}", s.index(0));
    println("{}", s.index(1));

    // and they are what a lexer skips, which is why they are worth having
    println("{}", '\v'.is_space());
    println("{}", '\f'.is_space());
    Ok(0);
}
