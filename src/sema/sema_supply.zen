// src/sema/sema_supply.zen
// What an IMPL supplies through a dot. `sema_member.zen` answers what a
// dot reaches; this file answers the half a type's own declaration
// didn't provide.
//
// The type's own members are storage and win outright — layout is fixed
// at declaration, so it can't depend on which impls are linked. An
// impl's members are computed ("you satisfy requirements, you never
// impl storage"): re-evaluated on read, read-only, non-addressable,
// invisible to layout — the whole of `Found.computed`.
//
// An impl lives with the type, not the trait: `Impl.target` is an
// `Ident`, not a qualified type, so the search is over one module's
// impls and a same-named type elsewhere is never confused for this one.
//
// A bound's members are read in the bound's own scope — stated three
// times below because three readers need it. `Slot<T> = { held*: T }`
// declares `T`, so reading its members without `T` bound reports `T` as
// undefined; `enter_*_tvars` is that binding, always a push/release pair.
//
// What an impl OWES is `sema_bound.zen`'s subject, not this one: this
// file asks what an impl provides, that one whether it provided
// everything promised. A required member with no body is absent here, a
// diagnostic there.

Span = std.ast
Decl, Struct, Impl, Member = std.ast
Function = std.ast
AllocError = std.mem
Vec = std.collections
str = std.text
Range = std.core
ImplId = sema.sema_id
TyId, TyNamed, Prim = sema.sema_ty
Def, decl_at = sema.sema_def
Checker, Ctx = sema.sema_check
Found, member_type = sema.sema_member
enter_struct_tvars, decl_span = sema.sema_member
type_from_ast = sema.sema_denote

// An impl lives with the type, not the trait, so the module index is
// part of the match — a same-named type elsewhere is never confused.
impl_members* = (
    c    :: Checker,
    n    : TyNamed,
    ty   : TyId,
    name : str,
    out  :: Vec<Found>
) Res<(), AllocError> {
    ids ::= c.alloc.Vec<ImplId>();
    c.world.impls_named(c.tree, n.name, ids).try();
    ids.loop((h, id) { c.local_impl(n, ty, name, id, out).try() });
    Ok(());
}

local_impl = (
    c    :: Checker,
    n    : TyNamed,
    ty   : TyId,
    name : str,
    id   : ImplId,
    out  :: Vec<Found>
) Res<(), AllocError> {
    (n.decl.module == id.decl.module).match({
        true  => c.impl_supplies(n, ty, name, id, out),
        false => Ok(()),
    })
}

impl_supplies = (
    c    :: Checker,
    n    : TyNamed,
    ty   : TyId,
    name : str,
    id   : ImplId,
    out  :: Vec<Found>
) Res<(), AllocError> {
    c.world.impl_at(c.tree, id).match({
        Ok(im) => c.supplied(n, ty, name, id, im, out),
        None   => Ok(()),
    }).try();
    Ok(());
}

// An impl entry supplies the name, or the bound provides a body of its
// own (`area` comes free needing only width and height). Either way the
// TYPE is the bound's, never the supplied expression's:
// `width: self.radius * 2.0` is an f64 because `Rect` said f64.
//
// A name is an overload set, not a member, so this adds one `Found` per
// declaration, never one per impl. Bug found the hard way: `Display`
// declares two `toString`s (a sink form and a sealed allocating one),
// and the type of the name used to fold over the members keeping only
// the LAST match — so the set of two arrived as one, and every
// `p.toString(buffer)` typed as `Res<String, WriteError>` while the
// backend correctly called the form returning `Res<(), WriteError>`.
supplied = (
    c    :: Checker,
    n    : TyNamed,
    ty   : TyId,
    name : str,
    id   : ImplId,
    im   : Impl,
    out  :: Vec<Found>
) Res<(), AllocError> {
    mi    = n.decl.module.to_usize();
    bound = c.impl_bound_type(im, mi).try();
    tys ::= c.alloc.Vec<TyId>();
    c.supplied_types(im, bound, name, ty, tys).try();
    tys.loop((h, t) { c.add_supplied(t, bound, name, id, out).try() });
    Ok(());
}

// Which of the bound's declarations of a name the impl reaches: a
// bodied member (sealed/default) comes along on its own; a bodiless one
// is a requirement, reachable only when the impl supplied that name.
//
// Deliberately asks `has_member` rather than matching a particular
// declaration — which signature an impl satisfied is `sema_bound.zen`'s
// question, answered there against the whole set; a weaker rule here
// would let the two files disagree.
supplied_types = (
    c       :: Checker,
    im      : Impl,
    bound   : TyId,
    name    : str,
    self_ty : TyId,
    out     :: Vec<TyId>
) Res<(), AllocError> {
    supplied_here = has_member(im.members, name);
    all ::= c.alloc.Vec<Member>();
    c.bound_members(bound, all).try();
    kept ::= c.alloc.Vec<Member>();
    all.loop((h, m) { keep_reachable(m, name, supplied_here, kept).try() });
    c.member_types(bound, kept, self_ty, out)
}

// A named helper rather than a `.then` inside the loop body:
// docs/SEMA_BOOTSTRAP_FIXES.md §10, now recorded CLOSED there.
keep_reachable = (
    m             : Member,
    name          : str,
    supplied_here : bool,
    kept          :: Vec<Member>
) Res<(), AllocError> {
    (m.named(name) && (has_body(m) || supplied_here)).match({
        true  => kept.add(m),
        false => Ok(()),
    })
}

// The bound an impl names, resolved with the target's type parameters
// in scope (`Vec.impl(Range<T>, ..)` writes `Vec`'s own `T`). `Impl` has
// no `tparams` — it borrows the target's. `type_from_ast` memoizes on
// the node id, so the first reader here decides for all.
impl_bound_type* = (c :: Checker, im: Impl, mi: usize)
                   Res<TyId, AllocError> {
    poison = c.types.unknown().try();
    tmark  = c.tvar_mark();
    c.enter_impl_target_tvars(im.target.text, mi).try();
    got = c.type_from_ast(im.bound, Ctx(mi, poison)).try();
    c.release_tvars(tmark).try();
    Ok(got);
}

// An impl lives in the module that declares its target, so the target
// is looked up only there — same fact that makes `Impl.target` an `Ident`.
// The IMPL's own tvars, pushed before its bound is read. Named past the
// plain `enter_target_tvars`: sema_decl.zen answers about a named TARGET
// TYPE with the same three lines, and Zen has no overloading to tell
// them apart.
enter_impl_target_tvars = (c :: Checker, target: str, mi: usize)
                          Res<(), AllocError> {
    defs ::= c.alloc.Vec<Def>();
    c.world.own_defs(mi, target, defs).try();
    defs.get(0).match({
        None  => Ok(()),
        Ok(d) => c.enter_def_tvars(d, mi),
    }).try();
    Ok(());
}

enter_def_tvars = (c :: Checker, d: Def, mi: usize) Res<(), AllocError> {
    decl_at(c.tree, d.id).match({
        Ok(x) => c.enter_decl_tvars(x, mi),
        None  => Ok(()),
    }).try();
    Ok(());
}

enter_decl_tvars = (c :: Checker, d: Decl, mi: usize) Res<(), AllocError> {
    d.kind.match({
        Struct(s) => c.enter_struct_tvars(s, mi),
        _         => Ok(()),
    })
}

// The bound declares it AND gives it a body: sealed and default members
// come along with the impl, a required one does not.
has_body = (m: Member) bool {
    m.kind.match({
        Function(f) => f.body.match({ Ok(_) => true, None => false }),
        _           => false,
    })
}

add_supplied = (
    c     :: Checker,
    ty    : TyId,
    bound : TyId,
    name  : str,
    id    : ImplId,
    out   :: Vec<Found>
) Res<(), AllocError> {
    out.add(Found(
        name: name,
        ty: ty,
        computed: true,
        mutable: false,
        exported: true,  // an impl supplies what a bound REQUIRED; the star
        module: 0,       // that let the bound out already answered law 6
        bound: bound,
        span: c.impl_span(id),
    ))
}

// Third site of the bound-scope rule (see header). Returns the FIRST
// declaration, for a reader that wants a type not a set: a computed
// field like `width: self.radius * 2.0` has only one declaration, so
// first/last/only agree; set-needing callers ask for the set.
bound_member_type* = (c :: Checker, bound: TyId, name: str, self_ty: TyId)
                     Res<TyId, AllocError> {
    tys ::= c.alloc.Vec<TyId>();
    c.bound_member_types(bound, name, self_ty, tys).try();
    tys.get(0).match({ Ok(t) => Ok(t), None => c.types.unknown() })
}

// EVERY declaration of the name, in source order — a name is an
// overload set; a fold here would pick by writing order and call it a type.
bound_member_types* = (
    c       :: Checker,
    bound   : TyId,
    name    : str,
    self_ty : TyId,
    out     :: Vec<TyId>
) Res<(), AllocError> {
    all ::= c.alloc.Vec<Member>();
    c.bound_members(bound, all).try();
    kept ::= c.alloc.Vec<Member>();
    all.loop((h, m) { keep_reachable(m, name, true, kept).try() });
    c.member_types(bound, kept, self_ty, out)
}

// Types of members already chosen, resolved in the bound's own scope —
// the `tvar` pair that makes `Slot<T> = { held*: T }` readable.
member_types = (
    c       :: Checker,
    bound   : TyId,
    ms      : Vec<Member>,
    self_ty : TyId,
    out     :: Vec<TyId>
) Res<(), AllocError> {
    mi    = c.bound_module(bound);
    tmark = c.tvar_mark();
    c.enter_bound_tvars(bound, mi).try();
    ms.loop((h, m) { out.add(member_type(c, m, mi, self_ty).try()).try() });
    c.release_tvars(tmark).try();
    Ok(());
}

enter_bound_tvars = (c :: Checker, bound: TyId, mi: usize)
                    Res<(), AllocError> {
    c.types.at(bound).match({
        Named(n) => c.enter_named_tvars(n, mi),
        _        => Ok(()),
    })
}

enter_named_tvars = (c :: Checker, n: TyNamed, mi: usize)
                    Res<(), AllocError> {
    decl_at(c.tree, n.decl).match({
        Ok(d) => c.enter_decl_tvars(d, mi),
        None  => Ok(()),
    }).try();
    Ok(());
}

// The members a bound declares, in source order.
bound_members* = (c :: Checker, bound: TyId, out :: Vec<Member>)
                 Res<(), AllocError> {
    c.types.at(bound).match({
        Named(n) => c.bound_decl_members(n, out),
        _        => Ok(()),
    }).try();
    Ok(());
}

bound_decl_members = (c :: Checker, n: TyNamed, out :: Vec<Member>)
                     Res<(), AllocError> {
    decl_at(c.tree, n.decl).match({
        Ok(d) => copy_struct_members(d, out),
        None  => Ok(()),
    }).try();
    Ok(());
}

copy_struct_members = (d: Decl, out :: Vec<Member>) Res<(), AllocError> {
    d.kind.match({
        Struct(s) => add_all_members(s, out),
        _         => Ok(()),
    })
}

add_all_members = (s: Struct, out :: Vec<Member>) Res<(), AllocError> {
    s.members.loop((h, m) { out.add(m).try() });
    Ok(());
}

bound_module = (c: Checker, bound: TyId) usize {
    c.types.at(bound).match({
        Named(n) => n.decl.module.to_usize(),
        _        => 0,
    })
}

// ---------------------------------------------------------------------
// declared, which is not the same as reachable
//
// `keep_reachable` answers "does a dot reach this" and correctly says
// NO for a hook no impl supplied: `Alloc.create` has no body in
// `mem_alloc.zen`, no impl supplies one, and `gen_c_alloc.zen` writes it
// — so `alloc.create<Node>()` resolving to nothing in sema is not a
// mistake, while `b.size()` on a `Box` resolving to nothing is.
//
// Only a diagnostic needs to tell those apart, so only a diagnostic
// asks this; a member lookup must answer "not reachable" to both, or
// the backend's own answer to what `create` does stops counting.
// ---------------------------------------------------------------------

bound_declares* = (c :: Checker, ty: TyId, name: str)
                  Res<bool, AllocError> {
    c.types.at(ty).match({
        Named(n) => c.impls_declare(n, name),
        Prim(p)  => c.prim_impls_declare(p, name),
        // a type parameter promises what its bounds promise, and what
        // it stands for is not settled here
        Var(_)   => Ok(true),
        _        => Ok(false),
    })
}

impls_declare = (c :: Checker, n: TyNamed, name: str)
                Res<bool, AllocError> {
    ids ::= c.alloc.Vec<ImplId>();
    c.world.impls_named(c.tree, n.name, ids).try();
    hit ::= false;
    ids.loop((h, id) {
        c.impl_declares(n, name, id).try().then(() { hit = true; });
    });
    Ok(hit);
}

impl_declares = (c :: Checker, n: TyNamed, name: str, id: ImplId)
                Res<bool, AllocError> {
    (n.decl.module == id.decl.module).match({
        false => Ok(false),
        true  => c.impl_bound_declares(n, name, id),
    })
}

impl_bound_declares = (c :: Checker, n: TyNamed, name: str, id: ImplId)
                      Res<bool, AllocError> {
    c.world.impl_at(c.tree, id).match({
        Ok(im) => c.bound_of_impl_declares(n, name, im),
        None   => Ok(false),
    })
}

bound_of_impl_declares = (c :: Checker, n: TyNamed, name: str, im: Impl)
                         Res<bool, AllocError> {
    bound = c.impl_bound_type(im, n.decl.module.to_usize()).try();
    all ::= c.alloc.Vec<Member>();
    c.bound_members(bound, all).try();
    Ok(has_member(all, name));
}

// A prelude declaration of a primitive's name IS that primitive, so
// impls on `str` are impls on the decl the prelude exports it as.
prim_impls_declare = (c :: Checker, p: Prim, name: str)
                     Res<bool, AllocError> {
    defs ::= c.alloc.Vec<Def>();
    c.world.prelude_of(p.name, defs).try();
    defs.get(0).match({
        None  => Ok(false),
        Ok(d) => c.impls_declare(
            TyNamed(decl: d.id, name: p.name, args: c.alloc.Vec<TyId>()),
            name
        ),
    })
}

has_member* = (members: Vec<Member>, name: str) bool {
    Range(0, members.len).find((i) {
        members.get(i).match({
            Ok(m) => m.named(name),
            None  => false,
        })
    }).match({ Ok(_) => true, None => false })
}

impl_span* = (c: Checker, id: ImplId) Span {
    c.decl_span(id.decl)
}
