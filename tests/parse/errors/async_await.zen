// MUST FAIL: `async` / `await`. DESIGN.md:754 — "the pony model: actors are the ONLY
// concurrency primitive. no async/await, no locks, no user-facing threads." Calling a
// behaviour on a `Ref` IS the send and returns immediately (DESIGN.md:758, 1194);
// a reply is another behaviour call carrying the reply address (DESIGN.md:1113-1118).

main = (env: Env) Res<i32, Error> {
    foo = env.spawn(Foo());
    v = await foo.compute(41);
    Ok(0);
}
