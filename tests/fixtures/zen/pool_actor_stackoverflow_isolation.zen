// PER-ACTOR STACK-OVERFLOW ISOLATION proof (bootstrap/zenrt.c + std.concurrent.pool). The sibling of
// pool_actor_panic_isolation, but the poison is a runaway RECURSION (Zen's only loop) instead of div0 —
// the most probable behavior panic. Spawn 3 raw pool actors on 3 workers; the MIDDLE actor gets a single
// POISON message (0) that drives non-tail recursion until the C stack overflows (SIGSEGV on the worker),
// the other two each get PERMSG live messages that atomically bump a shared accumulator.
//
// WITHOUT the fix the worker takes the SIGSEGV on its own (exhausted) stack — no per-thread sigaltstack —
// and the whole process is killed RAW (exit 139): no diagnostic, no survivor finishes. WITH the fix each
// worker registers its own sigaltstack (__zen_thread_init) and the handler siglongjmps into the per-actor
// catch, so the overflow kills ONLY that actor: the `stack overflow` panic + the `actor marked dead` note
// print, the pool keeps draining, both survivors complete their full PERMSG, and the program exits 0.
{ pool_open, pool_spawn, pool_actor_free, Pool } = std.concurrent.pool
NACT = 3
PERMSG = 2000
WORKERS = 3
acc = malloc(8)
actors = malloc(NACT * 8)
// Deep NON-tail recursion: the recursive result `r` feeds a branch before the frame returns, so no
// sibling-call / accumulator transform applies at any -O — each frame must persist. At depth 100,000,000
// this exhausts the C stack and raises SIGSEGV (the worker's stack-overflow panic).
depth = (n: i64) i64 {
    (n == 0).match ({
        true  => 0,
        false => {
            r = depth(n - 1)
            (r < n).then({ r + 1 }, { n })
        },
    })
}
// One behavior for every actor: the poison msg (0) drives the runaway recursion (overflow → panic HERE,
// isolating this actor); a live msg (1) bumps the shared accumulator by 1.
behave = (user: RawPtr<u8>, msg: i64) void {
    (msg == 0).match ({
        true  => {
            d = depth(100000000)
            (d < 0).then({
                atomic_add_i64(user, 1)
            })
        },
        false => {
            atomic_add_i64(user, 1)
        },
    })
}
send_n = (p: MutPtr<Pool>, a: RawPtr<u8>, i: i64, n: i64) void {
    (i < n).then({
        p.pool_send(a, 1)
        send_n(p, a, i + 1, n)
    })
}
spawn_all = (i: i64) void {
    (i < NACT).then({
        actors.offset(i * 8).store_i64(pool_spawn(acc, PERMSG + 16, behave))
        spawn_all(i + 1)
    })
}
free_all = (i: i64) void {
    (i < NACT).then({
        pool_actor_free(actors.offset(i * 8).load_i64().offset(0))
        free_all(i + 1)
    })
}
main = () i32 {
    store_i64(acc, 0)
    spawn_all(0)
    p = pool_open(WORKERS, NACT + 8)
    // actors 0 and 2 are survivors: PERMSG live messages each. actor 1 gets ONE poison message and dies.
    send_n(p, actors.offset(0 * 8).load_i64().offset(0), 0, PERMSG)
    p.pool_send(actors.offset(1 * 8).load_i64().offset(0), 0)
    send_n(p, actors.offset(2 * 8).load_i64().offset(0), 0, PERMSG)
    p.pool_quiesce_stop()
    total = load_i64(acc)
    free_all(0)
    p.pool_close()
    free(actors)
    free(acc)
    // exit 0 IFF both survivors processed their full load (the dead actor contributed nothing). Without
    // isolation the process is killed RAW (139) long before here, so exit 0 is itself proof the pool survived.
    expected = 2 * PERMSG
    (total == expected).then({ 0 }, { 1 })
}
