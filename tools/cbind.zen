// tools/cbind.zen — the C binding TRANSCRIBER, written in Zen (dogfooding the compiler-as-library).
//
//   ./zen run tools/cbind.zen string.h unistd.h
//
// Emits Zen foreign declarations transcribed from the REAL system headers, to stdout. Redirect into
// a module and check the result in.
//
// WHY A TRANSCRIBER AND NOT A `@cimport` PRAGMA. Zig resolves `@cImport` during compilation: it runs
// clang over the header and synthesises the decls in memory. That is elegant when the compiler may
// assume a C toolchain, and it is the wrong shape here for three reasons:
//
//   1. Zen bootstraps from a checked-in seed (bootstrap/zenc.gen.c). A compile-time header import
//      puts clang on the critical path of every build — including the build that has no compiler
//      yet. A transcriber runs when a HUMAN decides, not when the build does.
//   2. Bindings are values in Zen, not magic. The output is an ordinary `.zen` module you can read,
//      review in a diff, and blame — the same way tools/sigs.zen emits a signature map. An
//      invisible artifact cannot be reviewed, and a wrong FFI prototype does not fail to compile:
//      it corrupts at runtime.
//   3. The drift gate already exists. scripts/ffi_verify.sh proves every emitted prototype against
//      `decltype(::sym)` under the real headers. Transcribe-then-verify is a closed loop: this tool
//      writes the decls, that gate proves they are still true.
//
// MECHANISM. `gcc -aux-info` makes the C compiler report every prototype it saw while preprocessing
// a translation unit, so C is parsed by C rather than re-implemented here. This tool maps those
// prototypes onto Zen types. It never guesses: a C type with no rule is emitted as an `// UNMAPPED`
// comment, because a wrong width in an FFI decl still compiles and then corrupts memory.
{ Result, IoError, expect, ok } = std.core.result
{ println, formatln, arg_str } = std.text.fmt
{ run_ok } = std.sys.process
{ contents } = std.io.file
{ write } = std.io.file
{ trim_view, find, substr, at, len, split, cat, eq, is_empty, starts_with } = std.text.str
halloc = std.mem.heap
// One C-type -> Zen-type rule, matched against the prototype spelling verbatim.
Rule*: {
    c: string_view,
    zen: string_view,
}
// Deliberately SMALL and deliberately incomplete: each entry asserts the two types are ABI-identical
// here, and an unreviewed entry is exactly how a corrupting FFI decl gets written. size_t/ssize_t/
// __off_t -> i64 and void* -> RawPtr<u8> are the documented LP64 freedoms ffi_verify.sh allows.
rules = () [Rule] {
    [Rule(c: "const char *", zen: "string_view"),
     Rule(c: "char *", zen: "RawPtr<u8>"),
     Rule(c: "void *", zen: "RawPtr<u8>"),
     Rule(c: "const void *", zen: "RawPtr<u8>"),
     Rule(c: "void", zen: "void"),
     Rule(c: "int", zen: "i32"),
     Rule(c: "unsigned int", zen: "i32"),
     Rule(c: "long int", zen: "i64"),
     Rule(c: "size_t", zen: "i64"),
     Rule(c: "ssize_t", zen: "i64"),
     Rule(c: "__off_t", zen: "i64"),
     Rule(c: "__pid_t", zen: "i32"),
     Rule(c: "double", zen: "f64")]
}
map_ty = (c: string_view) string_view {
    t := c.trim_view()
    out := ""
    rules().loop((h, i, r) {
        out = (out.is_empty() && r.c.eq(t)).then({ r.zen }, { out })
    })
    out
}
Proto*: {
    ret: string_view,
    name: string_view,
    argsrc: string_view,
}
no_proto = () Proto { Proto(ret: "", name: "", argsrc: "") }
// last space in `s`, or -1.
last_space = (s: string_view) i64 {
    found := 0 - 1
    s.len().loop((h, k, x) {
        found = (s.at(k) == ' ').then({ k }, { found })
    })
    found
}
// `extern RET name (A, B);` -> the three pieces; empty name when the line is not a prototype
// (gcc -aux-info also emits `/* file:line */` provenance comments).
parse_proto = (line: string_view) Proto {
    ex := line.find("extern ")
    op := line.find(" (")
    cp := line.find(");")
    (ex < 0 || op < 0 || cp < 0).match ({
        true  => no_proto(),
        false => split_head(line, ex, op, cp),
    })
}
split_head = (line: string_view, ex: i64, op: i64, cp: i64) Proto {
    a := halloc.gpa().addr()
    head := a.substr(line, ex + 7, op - (ex + 7)).expect("head")
    sp := last_space(head)
    (sp < 0).match ({
        true  => no_proto(),
        false => star_fix(Proto(
            ret: a.substr(head, 0, sp).expect("ret").trim_view(),
            name: a.substr(head, sp + 1, head.len() - (sp + 1)).expect("name").trim_view(),
            argsrc: a.substr(line, op + 2, cp - (op + 2)).expect("args").trim_view(),
        )),
    })
}
// C spells `void *malloc`, so the star lands on the name; move it back onto the type.
star_fix = (p: Proto) Proto {
    p.name.starts_with("*").match ({
        true  => star_moved(p),
        false => p,
    })
}
star_moved = (p: Proto) Proto {
    a := halloc.gpa().addr()
    Proto(
        ret: a.cat(p.ret, " *"),
        name: a.substr(p.name, 1, p.name.len() - 1).expect("star"),
        argsrc: p.argsrc,
    )
}
argname = (i: i64) string_view {
    names: [string_view] := ["a", "b", "c", "d", "e", "f", "g", "h"]
    (i < names.len).then({ names[i] }, { "x" })
}
no_parts = () [string_view] { [] }
print_decl = (p: Proto, rz: string_view, parts: [string_view]) void {
    al := halloc.gpa().addr()
    line := al.cat(p.name, "* = (")
    parts.loop((h, i, t) {
        sep := (i == 0).then({ "" }, { ", " })
        line = al.cat(line, al.cat(sep, al.cat(argname(i), al.cat(": ", map_ty(t)))))
    })
    println(al.cat(line, al.cat(") ", rz)))
}
emit_args = (p: Proto, rz: string_view) void {
    al := halloc.gpa().addr()
    parts := (p.argsrc.eq("void") || p.argsrc.is_empty()).then({ no_parts() }, { al.split(p.argsrc, ',') })
    bad := ""
    parts.loop((h, i, a) {
        z := map_ty(a)
        bad = (bad.is_empty() && z.is_empty()).then({ a }, { bad })
    })
    bad.is_empty().match ({
        true  => print_decl(p, rz, parts),
        false => formatln("// UNMAPPED {} — parameter type `{}` has no rule", [arg_str(p.name), arg_str(bad)]),
    })
}
emit_one = (p: Proto) void {
    rz := map_ty(p.ret)
    rz.is_empty().match ({
        true  => formatln("// UNMAPPED {} — return type `{}` has no rule", [arg_str(p.name), arg_str(p.ret)]),
        false => emit_args(p, rz),
    })
}
// Build the throwaway TU, ask gcc to report every prototype it preprocessed, transcribe.
transcribe = (src: string_view) Result<i32, IoError> {
    a := halloc.gpa().addr()
    write("/tmp/zen_cbind.c", src).expect("write probe TU")
    run_ok(a, "gcc -aux-info /tmp/zen_cbind.aux -c /tmp/zen_cbind.c -o /dev/null 2>/dev/null")
        .expect("gcc -aux-info")
    aux := contents(a, "/tmp/zen_cbind.aux").expect("read aux")
    println("// GENERATED by tools/cbind.zen — do not edit by hand.")
    println("// Re-run: ./zen run tools/cbind.zen <headers…>    Proved by: make ffi-verify")
    a.split(aux, '\n').loop((h, i, line) {
        p := parse_proto(line)
        (p.name.is_empty() == false).then({
            emit_one(p)
        })
    })
    ok(0)
}
// Headers come from argv (argc/arg are builtins, as in tools/sigs.zen).
include_src = (i: i32, acc: string_view) string_view {
    a := halloc.gpa().addr()
    (i >= argc()).match ({
        true  => acc,
        false => include_src(i + 1, a.cat(acc, a.cat("#include <", a.cat(arg(i), ">\n")))),
    })
}
main = () i32 {
    src := include_src(1, "")
    src.is_empty().match ({
        true  => {
            println("usage: zen run tools/cbind.zen <header.h> [header.h ...]")
            1
        },
        false => transcribe(src).match ({
            .Ok(v)  => 0,
            .Err(e) => 1,
        }),
    })
}
