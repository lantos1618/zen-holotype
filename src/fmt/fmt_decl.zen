Alloc, AllocError = std.mem
str, String = std.text
Vec = std.collections
Range = std.core
Pos = std.ast.ast_span
ExprId, TypeId, BlockId = std.ast.ast_id
Ast = std.ast.ast_arena
Expr, Match, Block, Stmt, Bind, Decl, Type, Param = std.ast.ast_node
Src, Parsed = fmt.fmt_src

// The spaces in `[from, to)` on one line become `width` spaces. `to` of 0
// marks a line with nothing to align.
Pad = {
    from: usize,
    to: usize,
    width: usize,
}

no_pad = () Pad { Pad(from: 0, to: 0, width: 0) }

// An alignable operator: `width` bytes at `at`, after the name or pattern
// ending at `end`. Width 0 means the line stays as written.
Op = {
    end: Pos,
    at: usize,
    width: usize,
}

no_op = () Op { Op(end: Pos(line: 0, col: 0), at: 0, width: 0) }

// One pad per source line, applied while a declaration's bytes are copied.
Aligned* = {
    src: Src,
    pads :: Vec<Pad>,

    // One entry per source line by construction; a line past the table
    // is dropped.
    record = (self :: @Self, line: usize, p: Pad) Res<(), AllocError> {
        self.pads.set(line, p).match({ _ => Ok(()) })
    }

    pad_at = (self: @Self, line: usize) Pad {
        self.pads.get(line).value_or(no_pad())
    }

    // The bytes in `[from, to)` with each line's pad applied; `line` is
    // the source line `from` sits on.
    padded* = (self: @Self, a: Alloc, from: usize, to: usize, line: usize)
              Res<String, AllocError> {
        out ::= a.String().try();
        at  ::= from;
        ln  ::= line;
        loop(at < to, (h) {
            stop = self.line_stop(ln, at, to);
            p    = self.pad_at(ln);
            (p.to > at && p.to <= stop && p.from >= at).then(() {
                out.add(self.src.slice_at(at, p.from)).try();
                Range(0, p.width).loop((g, k) { out.add(' ').try() });
                at = p.to;
            });
            out.add(self.src.slice_at(at, stop)).try();
            at = stop;
            ln = ln + 1;
        });
        Ok(out);
    }

    // End of line `ln` or `to`, whichever comes first. A line past the
    // text falls back to `to`, so the copy always advances.
    line_stop = (self: @Self, ln: usize, at: usize, to: usize) usize {
        end = self.src.after_line(ln);
        (end > at && end < to).match({
            true  => end,
            false => to,
        })
    }

    // Pad every op in `[from, to)` to one column past the widest left side.
    align = (self :: @Self, ops: Vec<Op>, from: usize, to: usize)
            Res<(), AllocError> {
        col ::= 0;
        Range(from, to).loop((h, i) {
            op = ops.ptr().read(i);
            (op.width > 0 && op.end.col + 1 > col).then(() {
                col = op.end.col + 1;
            });
        });
        Range(from, to).loop((h, i) {
            op = ops.ptr().read(i);
            (op.width > 0).then(() {
                self.record(op.end.line, Pad(
                    from: self.src.offset(op.end),
                    to: op.at,
                    width: col - op.end.col,
                )).try();
            });
        });
        Ok(());
    }

    align_all = (self :: @Self, ops: Vec<Op>) Res<(), AllocError> {
        self.align(ops, 0, ops.len)
    }

    align_expr = (self :: @Self, a: Alloc, tree: Ast, e: Expr)
                 Res<(), AllocError> {
        e.kind.match({
            Match(mt) => self.align_all(self.src.arm_ops(a, tree, mt).try()),
            Lambda(l) => self.align_all(self.src.param_ops(a, l.params).try()),
            _         => Ok(()),
        })
    }

    align_type = (self :: @Self, a: Alloc, t: Type) Res<(), AllocError> {
        t.kind.match({
            Fn(f) => self.align_all(self.src.param_ops(a, f.params).try()),
            _     => Ok(()),
        })
    }

    align_decl = (self :: @Self, a: Alloc, d: Decl) Res<(), AllocError> {
        d.kind.match({
            Function(f) => self.align_all(
                self.src.param_ops(a, f.params).try()
            ),
            _           => Ok(()),
        })
    }

    // Bindings align in runs: consecutive statements whose operators have
    // the same width.
    align_block = (self :: @Self, a: Alloc, tree: Ast, b: Block)
                  Res<(), AllocError> {
        ops = self.src.stmt_ops(a, tree, b).try();
        from ::= 0;
        Range(1, ops.len).loop((h, i) {
            joins(ops, b, i).match({
                true  => (),
                false => {
                    self.align(ops, from, i).try();
                    from = i;
                },
            });
        });
        self.align(ops, from, ops.len).try();
        b.stmts.loop((h, i, s) {
            s.kind.match({
                Decl(d) => self.align_decl(a, d),
                _       => Ok(()),
            }).try();
        });
        Ok(());
    }
}

Aligned* = (a: Alloc, p: Parsed) Res<Aligned, AllocError> {
    pads ::= a.Vec<Pad>();
    Range(0, p.src.lines() + 2).loop((h, i) { pads.add(no_pad()).try() });
    table ::= Aligned(src: p.src, pads: pads);
    id    ::= ExprId(index: 0);
    Range(0, p.tree.expr_ids()).loop((h, i) {
        table.align_expr(a, p.tree, p.tree.expr_at(id)).try();
        id = ExprId(index: id.index + 1);
    });
    tid ::= TypeId(index: 0);
    Range(0, p.tree.type_ids()).loop((h, i) {
        table.align_type(a, p.tree.type_at(tid)).try();
        tid = TypeId(index: tid.index + 1);
    });
    p.m.decls.loop((h, i, d) { table.align_decl(a, d).try(); });
    bid ::= BlockId(index: 0);
    Range(0, p.tree.block_ids()).loop((h, i) {
        table.align_block(a, p.tree, p.tree.block_at(bid)).try();
        bid = BlockId(index: bid.index + 1);
    });
    Ok(table);
}

// One op per arm, at its `=>`; width 0 unless the arm sits alone on its
// line with only spaces before it and between pattern and arrow.
arm_ops = (src: Src, a: Alloc, tree: Ast, mt: Match)
          Res<Vec<Op>, AllocError> {
    ops ::= a.Vec<Op>();
    mt.arms.loop((h, i, arm) {
        line  = arm.arrow_span.start.line;
        end   = tree.pattern_at(arm.pattern).span.end;
        alone = arm.span.start.line == line
            && end.line == line
            && next_arm_line(mt, i) > arm.span.end.line
            && src.all_spaces(src.line_at(line), src.offset(arm.span.start))
            && src.all_spaces(
                src.offset(end),
                src.offset(arm.arrow_span.start)
            );
        ops.add(Op(
            end: end,
            at: src.offset(arm.arrow_span.start),
            width: alone.match({ true => 1, false => 0 }),
        )).try();
    });
    Ok(ops);
}

next_arm_line = (mt: Match, i: usize) usize {
    mt.arms.get(i + 1).match({
        Ok(next) => next.span.start.line,
        None     => mt.arms_span.end.line,
    })
}

// One op per statement: a binding's `=`, `:=` or `::=` run, else none.
stmt_ops = (src: Src, a: Alloc, tree: Ast, b: Block)
           Res<Vec<Op>, AllocError> {
    ops ::= a.Vec<Op>();
    b.stmts.loop((h, i, s) {
        ops.add(s.kind.match({
            Bind(bd) => src.op_after(s.span.start, name_end(tree, bd), "=:"),
            _        => no_op(),
        })).try();
    });
    Ok(ops);
}

// Statement `i` continues the run ending at `i - 1`: same operator width,
// starting on the line after the previous statement ends.
joins = (ops: Vec<Op>, b: Block, i: usize) bool {
    here = ops.ptr().read(i);
    prev = ops.ptr().read(i - 1);
    here.width > 0 && here.width == prev.width
        && stmt_line(b, i, true) == stmt_line(b, i - 1, false) + 1
}

stmt_line = (b: Block, i: usize, first: bool) usize {
    b.stmts.get(i).match({
        None  => 0,
        Ok(s) => first.match({
            true  => s.span.start.line,
            false => s.span.end.line,
        }),
    })
}

name_end = (tree: Ast, bd: Bind) Pos {
    bd.type.match({
        Ok(t) => tree.type_at(t).span.end,
        None  => tree.expr_at(bd.target).span.end,
    })
}

// One op per parameter, at its `:` or `::`.
param_ops = (src: Src, a: Alloc, ps: Vec<Param>) Res<Vec<Op>, AllocError> {
    ops ::= a.Vec<Op>();
    ps.loop((h, i, p) {
        ops.add(src.op_after(p.span.start, p.name.span.end, ":")).try();
    });
    Ok(ops);
}

// The run of bytes from `ops` that follows `end` on the line `start` is
// on, when only spaces precede `start` on that line.
op_after = (src: Src, start: Pos, end: Pos, ops: str) Op {
    line = start.line;
    at   = src.past_spaces(src.offset(end), src.after_line(line));
    w    = src.op_run(at, src.after_line(line), ops);
    (w > 0
        && end.line == line
        && src.all_spaces(src.line_at(line), src.offset(start))).match({
        false => no_op(),
        true  => Op(end: end, at: at, width: w),
    })
}

op_run = (src: Src, at: usize, to: usize, ops: str) usize {
    stop: Res<usize> = Range(at, to).find((i) {
        !ops.contains(src.text.index(i))
    });
    stop.value_or(to) - at
}

// The column pass over a text the earlier passes have already reshaped.
align_columns* = (a: Alloc, file: str, text: str) Res<String, AllocError> {
    parsed = a.Parsed(file, text).try();
    parsed.match({
        None  => a.String("{}", text),
        Ok(p) => {
            al = a.Aligned(p).try();
            al.padded(a, 0, text.len, 1)
        },
    })
}
