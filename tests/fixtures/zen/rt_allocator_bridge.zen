// `Rt.allocator()` must preserve the custom allocator used by stored String and Vec values.
{ mem_rt } = std.rt
{ malloc, realloc, free, Allocator, AllocatorVTable, allocator_of } = std.mem.alloc
{ StringConst, string } = std.text.string
{ Vec, VecConst, vec } = std.collections.vec
{ expect } = std.core.result
releases ::= 0
count_acquire = (state: RawPtr<u8>, n: i64) RawPtr<u8> { malloc(n) }
count_resize = (state: RawPtr<u8>, p: RawPtr<u8>, n: i64) RawPtr<u8> { realloc(p, n) }
count_release = (state: RawPtr<u8>, p: RawPtr<u8>) void {
    releases = releases + 1
    free(p)
}
count_vtable ::= AllocatorVTable(
    vt_alloc: count_acquire,
    vt_remap: count_resize,
    vt_free: count_release,
)
count_allocator = (state: RawPtr<u8>) Allocator {
    allocator_of(state, count_vtable.addr().offset(0))
}
main = () i32 {
    runtime = mem_rt(count_allocator(null_ptr()))
    a = runtime.allocator()
    text: StringConst = a
        .string(2)
        .add("runtime")
        .freeze()
        .expect("string freeze")
    numbers :: Vec<i64> = a.vec(1)
    numbers = numbers.add([10, 20, 30])
    frozen: VecConst<i64> = numbers.freeze().expect("vec freeze")
    ok = text.len == 7 && frozen.len == 3 && frozen.get(2) == 30
    text.drop()
    frozen.drop()
    (ok && releases == 2).then({ 42 }, { 1 })
}
