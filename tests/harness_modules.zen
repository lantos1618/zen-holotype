// tests/harness_modules.zen — the CROSS-MODULE / import-resolution category of the Zen-native harness.
// Where harness_value/harness_verdict drive single-file `zenc emit`/`zenc check`, this file drives the
// REAL multi-file path: it writes a small PROJECT (several sibling .zen files) into a temp dir and runs
// `./zen run <entry>` / `./zen check <entry>` / `./zen emit <entry>` / `./zen doc <module>`, so the
// committed compiler's import loader (compiler.resolve) + cross-module type-checker (check_linked)
// are exercised end-to-end — the dimension the flat harness structurally cannot reach.
//
// It ports the FULL cross-module pytest suites (see PARITY map at the bottom):
//   tests/test_user_imports.py      — sibling/namespace import loading + value + loader-error quality
//                                       + the compiler.resolve public API (import_edges / provided_symbols /
//                                       module_graph / dedup_decls / strip_ns_into / resolve_program_data /
//                                       resolve_parsed_program / check_parsed_program), driven as Zen programs
//                                       run via `zenc run` (exit code == observable result), INCLUDING the
//                                       recursion-depth / stack-growth stress cases (sources generated in-Zen).
//   tests/test_modules_oracle.py    — cross-module arity/arg-type rejection ("the net is not hollow")
//   tests/test_resolver_oracle.py   — name-clash namespacing + transitive re-export, as real projects
//   tests/test_resolver_fixes.py    — the resolver triple-fix + unknown-type / must-use / lambda / value-mold
//                                       driver checks, all through `zenc check`/`run`/`emit`/`doc`.
//
// CUSTOM RUNNER: a ModValCase / ModVerdictCase / ModEmitCase carries `files: [ModFile]` (name + source).
// The runner `mkdir`s a fresh temp dir, `save`s each file, then drives the committed `./zen`:
//   * VALUE   — `zenc run <entry>` exit code must equal `want` (the program's `main` return).
//   * VERDICT — `zenc check <entry>`: should_pass => accept (rc 0); else reject (rc != 0), and if
//               `needle` is non-empty the captured stderr must contain it (pins the rejection REASON).
//   * EMIT    — `zenc emit <entry>`: must succeed and the emitted C must contain every `present` substring
//               and none of the `absent` ones (resolution-before-cgen / literal-comment preservation).
//   * DOC     — `zenc doc <module>`: must succeed and contain every `present` substring (exported sigs).
// Resolver-API VALUE cases are ordinary Zen programs that import compiler.resolve and `to_exit()` —
// the loader's data structures are tested at the CLI boundary, no Python harness anywhere.
{ Malloc, malloc, free } = std.mem.alloc
{ out, save, contents_in, shell } = std.io.file
{ len, contains, is_empty, view, starts_with, try_parse_int } = std.text.str
{ new_in, append_in, finish_in, push_in } = std.text.string
{ expect } = std.core.result
{ integer_in } = std.text.num
{ zo_cat2, zo_cmd, zo_itoa, zo_join, zo_par_run, zo_path } = harness_lib
// one source file of a project: `name` is the basename (e.g. "p.zen"), `src` its full text.
ModFile*: {
    name: string_view,
    src: string_view,
}
// a VALUE case: write `files`, `zenc run <entry>`; the program's exit code must equal `want`.
ModValCase*: {
    files: [ModFile],
    entry: string_view,
    want: i32,
}
// a VERDICT case: write `files`, `zenc check <entry>`. should_pass => accept; else reject, and when
// `needle` is non-empty the diagnostic must contain it (error kind / loader message / user source span).
ModVerdictCase*: {
    files: [ModFile],
    entry: string_view,
    should_pass: bool,
    needle: string_view,
}
// an EMIT case: write `files`, `zenc emit <entry>`; emitted C must contain every `present`, no `absent`.
ModEmitCase*: {
    files: [ModFile],
    entry: string_view,
    present: [string_view],
    absent: [string_view],
}
// a DOC case: `zenc doc <module>`; stdout must contain every `present` substring.
ModDocCase*: {
    module: string_view,
    present: [string_view],
}
// a STDIN case: pipe `src` into `./zen` (no file, no program dir); should_succeed => exit 0 else != 0;
// the combined stdout+stderr must contain every `present` substring.
ModStdinCase*: {
    src: string_view,
    should_succeed: bool,
    present: [string_view],
}
// this run's private project dir (trailing slash), unique per process so concurrent runs never clash.
mod_dir = (mp: MutPtr<Malloc>) string_view { mp.zo_path("zo_mods/") }
// concat three strings through an allocator-owned String (no fixed-buffer assumptions).
join3 = (mp: MutPtr<Malloc>, a: string_view, b: string_view, c: string_view) string_view {
    s := mp.new_in().expect("harness: oom")
    s = s.append_in(mp, a).expect("harness: oom")
    s = s.append_in(mp, b).expect("harness: oom")
    s = s.append_in(mp, c).expect("harness: oom")
    mp.finish_in(s).expect("harness: oom")
}
// ── source generators (for the recursion-depth / stack-growth stress cases) ──────────────────────
// "v0* = () i32 { 0 }\n" … "v{n-1}* = () i32 { (i%10) }\n" — an n-decl module body.
gen_decls = (mp: MutPtr<Malloc>, n: i32) string_view {
    s := mp.new_in().expect("harness: oom")
    i := 0
    @while (i < n) {
        s = s.append_in(mp, "v").expect("harness: oom")
        s = s
            .append_in(mp, mp
                .integer_in(to_i64(i))
                .expect("harness: oom")
                .finish_in(mp)
                .expect("harness: oom"))
            .expect("harness: oom")
        s = s.append_in(mp, "* = () i32 { ").expect("harness: oom")
        s = s
            .append_in(mp, mp
                .integer_in(to_i64(i % 10))
                .expect("harness: oom")
                .finish_in(mp)
                .expect("harness: oom"))
            .expect("harness: oom")
        s = s.append_in(mp, " }\n").expect("harness: oom")
        i = i + 1
    }
    mp.finish_in(s).expect("harness: oom")
}
// "v0, v1, … v{n-1}" — a comma-separated import-head name list.
gen_names = (mp: MutPtr<Malloc>, n: i32) string_view {
    s := mp.new_in().expect("harness: oom")
    i := 0
    @while (i < n) {
        (i > 0).then({
            s = s.append_in(mp, ", ").expect("harness: oom")
        })
        s = s.append_in(mp, "v").expect("harness: oom")
        s = s
            .append_in(mp, mp
                .integer_in(to_i64(i))
                .expect("harness: oom")
                .finish_in(mp)
                .expect("harness: oom"))
            .expect("harness: oom")
        i = i + 1
    }
    mp.finish_in(s).expect("harness: oom")
}
// `chunk` repeated `n` times.
gen_repeat = (mp: MutPtr<Malloc>, chunk: string_view, n: i32) string_view {
    s := mp.new_in().expect("harness: oom")
    i := 0
    @while (i < n) {
        s = s.append_in(mp, chunk).expect("harness: oom")
        i = i + 1
    }
    mp.finish_in(s).expect("harness: oom")
}
// directory part of a project-relative file name ("app/utils.zen" → "app"; "" when flat) — dotted
// module fixtures write NESTED files, so the writers mkdir the subdirectory first.
file_dir_of = (mp: MutPtr<Malloc>, name: string_view) string_view {
    cut := 0 - 1
    v: [u8] := view(name)
    v.loop((h, i, b) {
        (b == '/').then({
            cut = to_i32(i)
        })
    })
    (cut < 0).match ({
        true  => "",
        false => {
            s := mp.new_in().expect("harness: oom")
            v.loop((h, i, b) {
                (to_i32(i) < cut).then({
                    s = s.push_in(mp, b).expect("harness: oom")
                })
            })
            mp.finish_in(s).expect("harness: oom")
        },
    })
}
// ensure the subdirectory of `name` exists under the slash-terminated `dirslash` (no-op when flat).
ensure_file_dir = (mp: MutPtr<Malloc>, dirslash: string_view, name: string_view) void {
    d := mp.file_dir_of(name)
    (is_empty(d) == false).then({
        shell(mp.zo_cmd(mp.join3("mkdir -p ", dirslash, d)))
    })
}
// fresh temp project dir, then every file written into it (paths are mod_dir + name, which may
// carry a subdirectory — `app/utils.zen` — for dotted-module fixtures).
write_files = (mp: MutPtr<Malloc>, files: [ModFile]) void {
    shell(mp.zo_cmd("rm -rf $ZT/zo_mods && mkdir -p $ZT/zo_mods"))
    files.loop((h, i, f) {
        mp.ensure_file_dir(mp.mod_dir(), f.name)
        p := mp.zo_cat2(mp.mod_dir(), f.name)
        save(p, f.src, len(f.src))
    })
}
// VALUE: build the project, `zenc run <entry>`, compare its exit code to `want`.
run_mod_value* = (mc: ModValCase) bool {
    m := Malloc(_: 0)
    mp := m.addr()
    mp.write_files(mc.files)
    entry := mp.zo_cat2(mp.mod_dir(), mc.entry)
    cmd := mp.join3("./zen run ", entry, " > $ZT/zo_mods_out.txt 2>&1")
    rc := shell(mp.zo_cmd(cmd)).expect("harness: shell")
    // `shell` now returns the DECODED exit code (WEXITSTATUS, or 128 + signal). A build/loader failure
    // surfaces as rc != 0.
    rc == mc.want
}
// VERDICT: build the project, `zenc check <entry>`. should_pass => rc 0; else rc != 0 and (if `needle`
// non-empty) the captured diagnostic must contain `needle`.
run_mod_verdict* = (mc: ModVerdictCase) bool {
    m := Malloc(_: 0)
    mp := m.addr()
    mp.write_files(mc.files)
    entry := mp.zo_cat2(mp.mod_dir(), mc.entry)
    cmd := mp.join3("./zen check ", entry, " > $ZT/zo_mods_chk.txt 2>&1")
    rc := shell(mp.zo_cmd(cmd)).expect("harness: shell")
    mc.should_pass.match ({
        true  => rc == 0,
        false => (rc == 0).match ({
            true  => false,
            false => is_empty(mc.needle).match ({
                true  => true,
                false => mp.contents_in(mp.zo_path("zo_mods_chk.txt")).match ({
                    .Ok(txt) => txt.contains(mc.needle),
                    .Err(e)  => false,
                }),
            }),
        }),
    })
}
// EMIT: build the project, `zenc emit <entry>`; must succeed and the C must hold every `present`
// substring and none of the `absent` ones.
run_mod_emit* = (mc: ModEmitCase) bool {
    m := Malloc(_: 0)
    mp := m.addr()
    mp.write_files(mc.files)
    entry := mp.zo_cat2(mp.mod_dir(), mc.entry)
    cmd := mp.join3("./zen emit ", entry, " > $ZT/zo_mods_emit.txt 2>&1")
    rc := shell(mp.zo_cmd(cmd)).expect("harness: shell")
    (rc == 0).match ({
        true  => mp.contents_in(mp.zo_path("zo_mods_emit.txt")).match ({
            .Err(e)  => false,
            .Ok(txt) => {
                bad := 0
                mc.present.loop((h, i, s) {
                    (txt.contains(s) == false).then({
                        bad = bad + 1
                    })
                })
                mc.absent.loop((h, i, s) {
                    txt.contains(s).then({
                        bad = bad + 1
                    })
                })
                bad == 0
            },
        }),
        false => false,
    })
}
// DOC: `zenc doc <module>`; must succeed and contain every `present` substring.
run_mod_doc* = (mc: ModDocCase) bool {
    m := Malloc(_: 0)
    mp := m.addr()
    cmd := mp.join3("./zen doc ", mc.module, " > $ZT/zo_mods_doc.txt 2>&1")
    rc := shell(mp.zo_cmd(cmd)).expect("harness: shell")
    (rc == 0).match ({
        true  => mp.contents_in(mp.zo_path("zo_mods_doc.txt")).match ({
            .Err(e)  => false,
            .Ok(txt) => {
                bad := 0
                mc.present.loop((h, i, s) {
                    (txt.contains(s) == false).then({
                        bad = bad + 1
                    })
                })
                bad == 0
            },
        }),
        false => false,
    })
}
// STDIN: pipe `src` into `./zen` (no file arg → the source→C filter / sibling-from-stdin path).
// should_succeed => exit 0 else != 0; combined stdout+stderr must contain every `present` substring.
run_mod_stdin* = (mc: ModStdinCase) bool {
    m := Malloc(_: 0)
    mp := m.addr()
    save(mp.zo_path("zo_mods_stdin.zen"), mc.src, len(mc.src))
    rc := shell(mp.zo_cmd("./zen < $ZT/zo_mods_stdin.zen > $ZT/zo_mods_stdin_out.txt 2>&1")).expect("harness: shell")
    ok_rc := mc.should_succeed.then({ rc == 0 }, { rc != 0 })
    ok_rc.match ({
        true  => mp.contents_in(mp.zo_path("zo_mods_stdin_out.txt")).match ({
            .Err(e)  => false,
            .Ok(txt) => {
                bad := 0
                mc.present.loop((h, i, s) {
                    (txt.contains(s) == false).then({
                        bad = bad + 1
                    })
                })
                bad == 0
            },
        }),
        false => false,
    })
}
// ── PARALLEL module runners (dogfoods std.thread via harness_lib's zo_par_run) ─────────────────────
// Same three-phase shape as the single-file harness_lib runners, but each case gets its OWN project dir
// `zo_mods<gid>/` (the serial runners reused one `zo_mods/` — fatal under parallelism). Each spawned
// `./zen run|check` is a distinct process writing pid-unique intermediates (/tmp/zenc_zd_<pid>.*), so
// concurrent compiles never collide; only the project sources + captured results are gid-namespaced.
mod_dir_id = (mp: MutPtr<Malloc>, gid: i64) string_view {
    mp.zo_path(mp.zo_cat2("zo_mods", mp.zo_itoa(gid)))
}
mod_rc_path = (mp: MutPtr<Malloc>, gid: i64) string_view {
    mp.zo_path(mp.join3("zo_mods_rc", mp.zo_itoa(gid), ".txt"))
}
mod_chk_path = (mp: MutPtr<Malloc>, gid: i64) string_view {
    mp.zo_path(mp.join3("zo_mods_chk", mp.zo_itoa(gid), ".txt"))
}
// Phase A: fresh per-case project dir + write its files (serial, Zen-side).
mod_write_files_id = (mp: MutPtr<Malloc>, gid: i64, files: [ModFile]) void {
    dir := mp.mod_dir_id(gid)
    shell(mp.zo_cmd(mp.zo_cat2(mp.join3("rm -rf ", dir, " && mkdir -p "), dir)))
    files.loop((h, i, f) {
        mp.ensure_file_dir(mp.zo_cat2(dir, "/"), f.name)
        p := mp.join3(dir, "/", f.name)
        save(p, f.src, len(f.src))
    })
}
// VALUE per-case command: `zenc run <entry>`; capture the program's exit code (WEXITSTATUS / 128+sig —
// exactly what shell() decoded serially) into rc<gid> with `printf %s` (no newline, so try_parse_int accepts it).
mod_value_cmd = (mp: MutPtr<Malloc>, gid: i64, entry: string_view) string_view {
    ent := mp.join3(mp.mod_dir_id(gid), "/", entry)
    mp.zo_cat2(mp.join3("./zen run ", ent, " > /dev/null 2>&1; printf %s \"$?\" > "), mp.mod_rc_path(gid))
}
mod_value_ok = (mp: MutPtr<Malloc>, gid: i64, mc: ModValCase) bool {
    mp.contents_in(mp.mod_rc_path(gid)).match ({
        .Ok(s)  => try_parse_int(s).match ({
            .Ok(v)  => v == to_i64(mc.want),
            .Err(e) => false,
        }),
        .Err(e) => false,
    })
}
// VERDICT per-case command: `zenc check <entry>`; capture accept(P)/reject(F) + the diagnostic.
mod_verdict_cmd = (mp: MutPtr<Malloc>, gid: i64, entry: string_view) string_view {
    z: string_view := ""
    ent := mp.join3(mp.mod_dir_id(gid), "/", entry)
    chk := mp.mod_chk_path(gid)
    rc := mp.mod_rc_path(gid)
    mp.zo_join([z, "if ./zen check ", ent, " > ", chk, " 2>&1; then echo P > ", rc, "; else echo F > ", rc, "; fi"])
}
mod_verdict_ok = (mp: MutPtr<Malloc>, gid: i64, mc: ModVerdictCase) bool {
    accepted := mp.contents_in(mp.mod_rc_path(gid)).match ({
        .Ok(s)  => s.starts_with("P"),
        .Err(e) => false,
    })
    mc.should_pass.match ({
        true  => accepted,
        false => accepted.match ({
            true  => false,
            false => is_empty(mc.needle).match ({
                true  => true,
                false => mp.contents_in(mp.mod_chk_path(gid)).match ({
                    .Ok(txt) => txt.contains(mc.needle),
                    .Err(e)  => false,
                }),
            }),
        }),
    })
}
// batch runners + reporters: build+write (serial), run in parallel, check IN ORDER — same verdict as serial.
run_mod_values = (name: string_view, cs: [ModValCase]) i32 {
    out(name)
    out("\n")
    m := Malloc(_: 0)
    mp := m.addr()
    n := cs.len
    base := malloc(n * 8)
    cmds: [string_view] := base.slice(n)
    cs.loop((h, i, c) {
        mp.mod_write_files_id(i, c.files)
        cmds[i] = mp.mod_value_cmd(i, c.entry)
    })
    zo_par_run(cmds, n)
    fails := 0
    cs.loop((h, i, c) {
        mp.mod_value_ok(i, c).match ({
            true  => out("."),
            false => {
                out("F")
                fails = fails + 1
            },
        })
    })
    out("\n")
    free(base)
    fails
}
// PARALLEL deep-loader runner. The deep-loader driver sources USED to bake the one shared `mod_dir()`,
// forcing serial execution; now each case gets its OWN gid-namespaced project dir and the driver's baked
// progdir points at THAT dir (deep_driver_src(kind, dir)), so the cases are disjoint and run concurrently.
// Each driver's `zenc run` cc-compiles the whole resolver (~20s), so overlapping the 3 cases across the
// pool is the single biggest harness speedup. Every case wants exit 0 (`.to_exit()` on the assertion).
// A DeepCase is the sibling module files + which resolver-API driver to generate (kind: 0=resolve_program_data
// table, 1=resolve_parsed_program, 2=check_parsed_program); driver.zen is generated per-gid.
DeepCase: {
    base_files: [ModFile],
    kind: i32,
}
deep_driver_src = (mp: MutPtr<Malloc>, kind: i32, dir: string_view) string_view {
    (kind == 0).match ({
        true  => mp.deep_src_table(dir),
        false => (kind == 1).match ({
            true  => mp.deep_src_parsed(dir),
            false => (kind == 2).then({ mp.deep_src_check(dir) }, { mp.deep_src_check_all(dir) }),
        }),
    })
}
deep_ok = (mp: MutPtr<Malloc>, gid: i64) bool {
    mp.contents_in(mp.mod_rc_path(gid)).match ({
        .Ok(s)  => try_parse_int(s).match ({
            .Ok(v)  => v == 0,
            .Err(e) => false,
        }),
        .Err(e) => false,
    })
}
run_mod_deep = (name: string_view, cs: [DeepCase]) i32 {
    out(name)
    out("\n")
    m := Malloc(_: 0)
    mp := m.addr()
    n := cs.len
    base := malloc(n * 8)
    cmds: [string_view] := base.slice(n)
    cs.loop((h, i, c) {
        mp.mod_write_files_id(i, c.base_files)    // fresh per-gid dir + sibling module files
        dir := mp.zo_cat2(mp.mod_dir_id(i), "/")    // slash-terminated progdir baked into the driver
        drv := mp.deep_driver_src(c.kind, dir)
        save(mp.join3(mp.mod_dir_id(i), "/", "driver.zen"), drv, len(drv))
        cmds[i] = mp.mod_value_cmd(i, "driver.zen")
    })
    zo_par_run(cmds, n)
    fails := 0
    cs.loop((h, i, c) {
        mp.deep_ok(i).match ({
            true  => out("."),
            false => {
                out("F")
                fails = fails + 1
            },
        })
    })
    out("\n")
    free(base)
    fails
}
run_mod_verdicts = (name: string_view, cs: [ModVerdictCase]) i32 {
    out(name)
    out("\n")
    m := Malloc(_: 0)
    mp := m.addr()
    n := cs.len
    base := malloc(n * 8)
    cmds: [string_view] := base.slice(n)
    cs.loop((h, i, c) {
        mp.mod_write_files_id(i, c.files)
        cmds[i] = mp.mod_verdict_cmd(i, c.entry)
    })
    zo_par_run(cmds, n)
    fails := 0
    cs.loop((h, i, c) {
        mp.mod_verdict_ok(i, c).match ({
            true  => out("."),
            false => {
                out("F")
                fails = fails + 1
            },
        })
    })
    out("\n")
    fails
}
// PARALLEL emit runner (3-phase, same discipline as run_mod_values): each case writes its project into
// its OWN gid-namespaced dir, `zenc emit` runs in parallel writing gid-namespaced result + P/F marker
// files, then present/absent are checked IN ORDER — byte-identical verdict to the old serial loop.
mod_emit_path = (mp: MutPtr<Malloc>, gid: i64) string_view {
    mp.zo_path(mp.join3("zo_mods_emit", mp.zo_itoa(gid), ".txt"))
}
mod_emit_cmd = (mp: MutPtr<Malloc>, gid: i64, entry: string_view) string_view {
    z: string_view := ""
    ent := mp.join3(mp.mod_dir_id(gid), "/", entry)
    outp := mp.mod_emit_path(gid)
    rc := mp.mod_rc_path(gid)
    mp.zo_join([z, "if ./zen emit ", ent, " > ", outp, " 2>&1; then echo P > ", rc, "; else echo F > ", rc, "; fi"])
}
mod_emit_ok = (mp: MutPtr<Malloc>, gid: i64, mc: ModEmitCase) bool {
    passed := mp.contents_in(mp.mod_rc_path(gid)).match ({
        .Ok(s)  => s.starts_with("P"),
        .Err(e) => false,
    })
    passed.match ({
        true  => mp.contents_in(mp.mod_emit_path(gid)).match ({
            .Err(e)  => false,
            .Ok(txt) => {
                bad := 0
                mc.present.loop((h, i, s) {
                    (txt.contains(s) == false).then({
                        bad = bad + 1
                    })
                })
                mc.absent.loop((h, i, s) {
                    txt.contains(s).then({
                        bad = bad + 1
                    })
                })
                bad == 0
            },
        }),
        false => false,
    })
}
run_mod_emits = (name: string_view, cs: [ModEmitCase]) i32 {
    out(name)
    out("\n")
    m := Malloc(_: 0)
    mp := m.addr()
    n := cs.len
    base := malloc(n * 8)
    cmds: [string_view] := base.slice(n)
    cs.loop((h, i, c) {
        mp.mod_write_files_id(i, c.files)
        cmds[i] = mp.mod_emit_cmd(i, c.entry)
    })
    zo_par_run(cmds, n)
    fails := 0
    cs.loop((h, i, c) {
        mp.mod_emit_ok(i, c).match ({
            true  => out("."),
            false => {
                out("F")
                fails = fails + 1
            },
        })
    })
    out("\n")
    free(base)
    fails
}
run_mod_docs = (name: string_view, cs: [ModDocCase]) i32 {
    out(name)
    out("\n")
    fails := 0
    cs.loop((h, i, c) {
        run_mod_doc(c).match ({
            true  => out("."),
            false => {
                out("F")
                fails = fails + 1
            },
        })
    })
    out("\n")
    fails
}
run_mod_stdins = (name: string_view, cs: [ModStdinCase]) i32 {
    out(name)
    out("\n")
    fails := 0
    cs.loop((h, i, c) {
        run_mod_stdin(c).match ({
            true  => out("."),
            false => {
                out("F")
                fails = fails + 1
            },
        })
    })
    out("\n")
    fails
}
harness_modules_run* = () i32 {
    m := Malloc(_: 0)
    mp := m.addr()
    z: string_view := ""    // typed leading element so mixed literal/variable arrays infer as [string_view]
    // ── generated stress sources (recursion-depth / stack-growth guards) ─────────────────────────
    big240 := mp.gen_decls(240)    // 240 top-level decls (symbol-consumer stress)
    big120 := mp.gen_decls(120)    // 120 decls + a 120-name import head
    names120 := mp.gen_names(120)
    dedup260 := mp.zo_cat2(mp.gen_decls(260), "v0* = () i32 { 777 }\n")    // 260 + a dup v0 (final-dedup stress)
    mid700 := mp.gen_repeat("right = right\n", 700)
    edges700 := mp.zo_join([z, "first = first\n", mid700, "{ last } = last\nmain = () i32 { 0 }\n"])
    // Cross-module USER-DEFINED GENERIC fn/type resolution (#48): a generic type/fn/enum defined in one
    // module and instantiated at a concrete type in another must resolve + monomorphize across the file
    // boundary exactly as single-file. Pinned below via the g/base+mid/opt/bx projects: flat generic
    // fn+type import, a TRANSITIVE generic threaded through two boundaries, a generic enum matched through
    // its def module's generic unwrap, and a qualified-alias `bx.mk<i32>()` + inherent generic method.
    v := run_mod_values("modules value (import resolution / value)", [
        ModValCase(
            files: [
                ModFile(
                    name: "mymod.zen",
                    src: "Opt*<T>: Some(T) | None\nBox*<T>: { v: T }\n",
                ),
                ModFile(
                    name: "p.zen",
                    src: "m = mymod\nmain = () i32 {\n  s := m.Opt<i32>.Some(5)\n  n := m.Opt<i32>.None\n  b := m.Box<i32>(v: 30)\n  sv := s.match ({ .Some(v) => v, .None => 0 })\n  nv := n.match ({ .Some(v) => v, .None => 7 })\n  sv + nv + b.v\n}\n",
                ),
            ],
            entry: "p.zen",
            want: 42,
        ),
        ModValCase(
            files: [
                ModFile(
                    name: "shapes.zen",
                    src: "Area*: { get = (s: Self) i32 }\nSq*: { n: i32 }\nhelper* = (x: i32) i32 { x + 41 }\nSq.impl(Area, {\n    get = (s: Sq) i32 { helper(s.n) }\n})\n",
                ),
                ModFile(
                    name: "p.zen",
                    src: "{ Sq, Area } = shapes\nsh = shapes\nmain = () i32 {\n    s := Sq(n: 1)\n    s.get()\n}\n",
                ),
            ],
            entry: "p.zen",
            want: 42,
        ),
        ModValCase(
            files: [
                ModFile(
                    name: "b.zen",
                    src: "helper* = (x: i32) i32 { x * 2 }\n",
                ),
                ModFile(
                    name: "p.zen",
                    src: "{ helper } = b\nmain = () i32 { helper(21) }\n",
                ),
            ],
            entry: "p.zen",
            want: 42,
        ),
        ModValCase(
            files: [
                ModFile(
                    name: "libm.zen",
                    src: "{ println } = std.text.fmt\nlen* = (s: string_view) i64 { 7 }\nrun2* = (s: string_view) i64 { len(s) }\n",
                ),
                ModFile(
                    name: "p.zen",
                    src: "{ run2 } = libm\nmain = () i32 { to_i32(run2(\"ab\")) }\n",
                ),
            ],
            entry: "p.zen",
            want: 7,
        ),
        ModValCase(
            files: [
                ModFile(
                    name: "m1.zen",
                    src: "one* = () i32 { 1 }\n",
                ),
                ModFile(
                    name: "m2.zen",
                    src: "two* = () i32 { 2 }\n",
                ),
                ModFile(
                    name: "p.zen",
                    src: "{ one } = m1\n{ two } = m2\nmain = () i32 { one() + two() }\n",
                ),
            ],
            entry: "p.zen",
            want: 3,
        ),
        ModValCase(
