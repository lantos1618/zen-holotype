// `buf[i] = v` — the indexed WRITE, whose answer nothing pinned. The
// corpus held one must-fail file for a write of the wrong TYPE and
// nothing at all for a write that succeeds, so `write_subscript`
// (`gen_c_index.zen`) could have emitted the base, the index or the
// value wrong and every test still passed.
//
// Three things have to be true at once and each is a separate way to be
// wrong: the value that arrives is the one written, the slot it lands in
// is the one named, and a write to one slot leaves the others alone.
// So every element is DISTINCT and the whole array is read back after
// every write — an index dropped to a constant 0 changes the printed
// row, it does not merely reorder it.
//
// The indices are written out of order (3, then 0, then 2) so a backend
// that walked the writes in source order and filled the array left to
// right would answer the same digits in the wrong places. `i` and the
// loop counter are the RUNTIME cases: a literal index can be folded, a
// variable one cannot, and only the variable form proves the emitted C
// subscripts with the value rather than with the position.

sum = (xs: [i32, 4]) i32 { xs[0] + xs[1] + xs[2] + xs[3]; }

main = (env: Env) Res<i32, AllocError> {
    buf ::= [0, 0, 0, 0];

    // literal indices, deliberately not in ascending order
    buf[3] = 7;
    println("a {} {} {} {}", buf[0], buf[1], buf[2], buf[3]);
    buf[0] = 1;
    println("b {} {} {} {}", buf[0], buf[1], buf[2], buf[3]);
    buf[2] = 5;
    println("c {} {} {} {}", buf[0], buf[1], buf[2], buf[3]);

    // a RUNTIME index: the slot is chosen by a value, not by the
    // position of the statement
    i ::= 1;
    buf[i] = 9;
    println("d {} {} {} {}", buf[0], buf[1], buf[2], buf[3]);

    // overwriting is a write too, and it must reach the same slot twice
    buf[i] = 4;
    println("e {} {} {} {}", buf[0], buf[1], buf[2], buf[3]);

    // every slot written from a loop counter, each to a different value
    m ::= 0;
    Range(0, 4).loop((h, k) {
        buf[k] = m * 10 + 2;
        m = m + 1;
    });
    println("f {} {} {} {}", buf[0], buf[1], buf[2], buf[3]);
    println("sum {}", sum(buf));
    Ok(0);
}
