// module `vec`, reached by its FOLDER ROOT: `zz = vec`, not `zz = vec.vec`.
// Every name here without a `*` must stay invisible from outside, and the
// spelling of the import is not allowed to be what decides that.

Latch = { hash: i32 }

Bag* = {
    len* :: i32,
    slack :: i32 = 2,

    add* = (self :: @Self, n: i32) () {
        self.rehome();
        self.len = self.len + n * self.slack;
    }

    rehome = (self :: @Self) () {
        self.len = self.len + 1;
    }
}

reseat = (n: i32) i32 { n }
