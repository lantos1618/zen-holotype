// Shared str operations replace the old one-off test helpers. Count walks
// non-overlapping byte runs and gives an empty needle no occurrence. A single
// replacement changes only the first hit, preserves a miss, and treats an
// empty needle as insertion at the first boundary.

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();

    println(
        "counts {} {} {}",
        "aaaa".count("aa"),
        "aaa".count("aa"),
        "abc".count("")
    );

    hit   = "alpha beta beta".replace_once(alloc, "beta", "B").try();
    miss  = "abc".replace_once(alloc, "z", "!").try();
    empty = "abc".replace_once(alloc, "", "+").try();
    println("hit [{}]", hit.view());
    println("miss [{}]", miss.view());
    println("empty [{}]", empty.view());
    Ok(0);
}
