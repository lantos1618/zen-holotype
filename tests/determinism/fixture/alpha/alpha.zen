// module `alpha`.
//
// defines `name`, `total`, `boxed`, `counted`, `kind`, `tag` — every one of
// which `beta` also defines. DESIGN.md § Modules permits that explicitly, so
// gen_c has to emit six pairs of distinct C symbols, and the ORDER it emits
// them in is what this fixture is measuring.
//
// `Box<i32>` is instantiated here and in `beta`, at the same type. It must
// be emitted exactly once, and in the same place regardless of which module
// the compiler walked first.

Item, Box, Kind, weight = gamma

name* = () str { "alpha" }

tag* = () str { "alpha tag" }

boxed* = () i32 {
    b = Box(value: Item(id: 1, label: "alpha item"));
    b.value.id
}

counted* = () i32 {
    b = Box(value: 10);
    b.value
}

kind* = () i32 { weight(Kind.Large(3)) }

total* = () i32 { boxed() + counted() + kind() }
