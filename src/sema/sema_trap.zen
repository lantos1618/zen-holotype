// src/sema/sema_trap.zen
// A trap the compiler can prove will fire is a compile error: constant
// overflow, a constant zero divisor, `i32.MIN / -1` (overflow wearing
// division's clothes), a literal out of its type's range, and a literal
// index past a known length (DESIGN.md, the failure model).
//
// EVERY RULE HERE IS "PROVE IT OR SAY NOTHING", and what it may prove
// with is `sema_const.zen`: a folder over literals, never through a
// binding — the trap corpus routes values like `i32.MAX` through a
// variable specifically so the compiler can't see them, and folding
// through a binding would turn those runtime tests into compile errors.
// That discipline is the other file's, stated there; this file is the
// list of sentences it earns.
//
// The index rule lives with the arithmetic rules because `Ty.Array`
// carries `count` (`[u8, 64]` and `[u8, 65]` are different types),
// giving `buf[4]` on `[i32, 4]` both halves of the comparison at one
// node — the same shape as a literal measured against its type.

Expr, ExprId, Binary, Literal = std.ast
Unary, Paren, Index, Match, ArrayLit = std.ast
AllocError = std.mem
str = std.text
TyId, TyArray, is_integer = sema.sema_ty
SemaFault, NameFault, TypeFault = sema.sema_diag
Checker = sema.sema_check
const_int, const_literal, fits, fold = sema.sema_const
len_of, min_of = sema.sema_const
// the rule
// ---------------------------------------------------------------------

// Dispatches trapping ops; wrapping forms (`+% -% *%`) fall to `_` and
// stay silent by design.
check_binary* = (c :: Checker, b: Binary, ty: TyId) Res<(), AllocError> {
    b.op.match({
        Div => c.check_divisor(b, ty),
        Rem => c.check_divisor(b, ty),
        Add => c.check_overflow(b, ty),
        Sub => c.check_overflow(b, ty),
        Mul => c.check_overflow(b, ty),
        _   => Ok(()),
    })
}

check_divisor = (c :: Checker, b: Binary, ty: TyId) Res<(), AllocError> {
    c.const_int(b.rhs).match({
        None  => Ok(()),
        Ok(d) => c.divisor_is(b, ty, d),
    })
}

divisor_is = (c :: Checker, b: Binary, ty: TyId, d: i64)
             Res<(), AllocError> {
    (d == 0).match({
        true  => c.divide_by_zero(b),
        false => c.min_over_minus_one(b, ty, d),
    })
}

divide_by_zero = (c :: Checker, b: Binary) Res<(), AllocError> {
    c.report(
        b.op_span.file,
        b.op_span,
        SemaFault.ProvenDivideByZero(NameFault(name: "0"))
    )
}

// `i32.MIN / -1` is an OVERFLOW, not a division by zero, and it faults
// identically on x86. DESIGN.md names only the zero divisor;
// docs/TESTING.md records this as the sentence the design still owes.
min_over_minus_one = (c :: Checker, b: Binary, ty: TyId, d: i64)
                     Res<(), AllocError> {
    (d == 0 - 1).match({
        true  => c.check_min_numerator(b, ty),
        false => Ok(()),
    })
}

check_min_numerator = (c :: Checker, b: Binary, ty: TyId)
                      Res<(), AllocError> {
    c.const_int(b.lhs).match({
        None  => Ok(()),
        Ok(n) => c.numerator_is_min(b, ty, n),
    })
}

numerator_is_min = (c :: Checker, b: Binary, ty: TyId, n: i64)
                   Res<(), AllocError> {
    name = c.prim_name(ty);
    // `min_of` REFUSES a name its table does not hold (#817), and a
    // refusal here is not "not the minimum" — it is nothing proved, so
    // nothing reported.
    (is_integer(name)).match({
        false => Ok(()),
        true  => c.numerator_matches_min(b, ty, n, name),
    })
}

numerator_matches_min = (c :: Checker, b: Binary, ty: TyId, n: i64, name: str)
                        Res<(), AllocError> {
    min_of(name).match({
        None  => Ok(()),
        Ok(lo) => (n == lo).match({
            true  => c.overflow(b, name),
            false => Ok(()),
        }),
    })
}

check_overflow = (c :: Checker, b: Binary, ty: TyId) Res<(), AllocError> {
    c.const_int(b.lhs).match({
        None  => Ok(()),
        Ok(x) => c.with_lhs(b, ty, x),
    })
}

with_lhs = (c :: Checker, b: Binary, ty: TyId, x: i64) Res<(), AllocError> {
    c.const_int(b.rhs).match({
        None  => Ok(()),
        Ok(y) => c.with_both(b, ty, x, y),
    })
}

with_both = (c :: Checker, b: Binary, ty: TyId, x: i64, y: i64)
            Res<(), AllocError> {
    fold(b.op, x, y).match({
        None  => Ok(()),
        Ok(v) => c.check_fits(b, ty, v),
    })
}

// `fits` REFUSES a name its table does not hold (#817), and a refusal is
// not "it fits" — it is nothing proved, so nothing reported. The
// `is_integer` guard above stays: it is what keeps floats and every
// non-primitive out of the question at all.
check_fits = (c :: Checker, b: Binary, ty: TyId, v: i64)
             Res<(), AllocError> {
    name = c.prim_name(ty);
    (is_integer(name)).match({
        false => Ok(()),
        true  => c.fits_or_say(b, ty, v, name),
    })
}

fits_or_say = (c :: Checker, b: Binary, ty: TyId, v: i64, name: str)
              Res<(), AllocError> {
    fits(v, name).match({
        None   => Ok(()),
        Ok(false) => c.overflow(b, name),
        Ok(true)  => Ok(()),
    })
}

// Position is the operator token, matching where a runtime trap prints
// — one rule, one position, whichever side it's caught on.
overflow = (c :: Checker, b: Binary, name: str) Res<(), AllocError> {
    c.report(
        b.op_span.file,
        b.op_span,
        SemaFault.ProvenOverflow(NameFault(name: name))
    )
}

// ---------------------------------------------------------------------
// the literal rule
//
// `literal_fits` reads "a literal's type comes from its context" as an
// `int` literal agreeing with every integer type — right about the
// family, not the value, so `n: i32 = 2147483648` wrapped at codegen
// (same bug as `i32.MAX + 1` one fold earlier).
//
// Walks only forms that wrap a literal without changing it — parens and
// the unary minus that makes `-1` one literal — never a folded
// expression: `x: u8 = 200 + 100` is already `ProvenOverflow` at the
// operator, and reporting here too would double the diagnostic.
//
// Unfoldable is not rejected: `18446744073709551615` and
// `-9223372036854775808` exceed the `i64` this file folds in, so
// `sema_const.parse_i64` abstains, keeping `u64.MAX`/`i64.MIN` legal per
// `corpus/lex/number_type_boundaries`.
//
// Eight call sites reach this, not just `check_assign`: `sema_place`,
// `sema_call`, `sema_hoist` (return/ctor field), `sema_type` (array
// element); a match arm is walked here since it has no caller of its
// own — the match settles its context; and `sema_type.operands_agree`
// asks it of a LITERAL OPERAND, from whichever side it stands on,
// against the type its pair settles (`n / 200` on an `i8` — issue
// #725), where no binding or call ever stood between the value and
// its use.
// ---------------------------------------------------------------------

// Only `want` matters: the literal's own type is always `int` (nothing
// else folds), so no caller needs to pass it.
check_literal* = (c :: Checker, id: ExprId, want: TyId)
                 Res<(), AllocError> {
    is_integer(c.prim_name(want)).match({
        true  => c.literal_within(id, want),
        false => c.elements_within(id, want),
    })
}

// AN ELEMENT IS A TYPED SLOT TOO, and the range half above is not all
// it owes. `[0, v]` with `v: i16` reaches a `[u8, 2]` because
// `sema_type.array_lit_type` mints the literal's type from its FIRST
// element — `[int, 2]` — and `array_assignable` grants that every array
// of its length, the same family leniency that keeps `[1, 2, 3]` legal
// at a `[u8, 3]`. So every other element's type was computed and thrown
// away, and the `i16` stood in a `u8` slot unasked until the store
// narrowed it to 255. The scalar twin `a: u8 = v` was always refused.
//
// THE MEMO'S ANSWER AND NEVER A FRESH ONE, for the reason
// `sema_hoist.arm_fits` gives: every caller types the element before
// asking, so a miss is an element nothing typed and this rule has
// nothing to say about one. An int LITERAL is still `int` here and
// still agrees with every integer type, so only a non-literal of
// another type is refused — and `coerce` is what says so, since the
// range fault above can name neither side.
element_agrees* = (c :: Checker, id: ExprId, elem: TyId)
                  Res<(), AllocError> {
    node = c.tree.expr_at(id);
    c.expr_memo.get(id).match({
        None    => Ok(()),
        Ok(got) => c.coerce(node.span.file, node.span, got, elem, ""),
    })
}

// AN ELEMENT SITS WHERE THE ARRAY SITS. `xs: [u8, 3] = [1, 2, 300]`
// writes `u8` nowhere an element can see, and `[int, 3]` now reaches
// `[u8, 3]` by the same family rule this file exists to correct — so
// without this the 300 would wrap to 44 unreported. `fixed_array_type`
// asks the same question of `[u8, 3](1, 2, 300)`, where the type is
// written beside the values instead of at the position.
elements_within = (c :: Checker, id: ExprId, want: TyId)
                  Res<(), AllocError> {
    c.types.at(want).match({
        Array(a) => c.array_elements(id, a),
        _        => Ok(()),
    })
}

array_elements = (c :: Checker, id: ExprId, a: TyArray) Res<(), AllocError> {
    c.tree.expr_at(id).kind.match({
        Array(lit) => c.elem_literals(lit, a.elem),
        Match(m)   => c.arm_arrays(m, a),
        _          => Ok(()),
    })
}

// AN ARM PRODUCING AN ARRAY STANDS WHERE THE ARRAY STANDS — the same
// recursion `literal_within` makes for a scalar one position down, and
// `sema_hoist.arm_fits` cannot make it instead: it asks the arm about
// its own type, and `[int, 2]` reaching a `[u8, 2]` is precisely the
// family leniency this file exists to look through. So `e: [u8, 2] =
// b.match({ true => [0, 300], .. })` wrapped to 44 unreported, and
// `[0, v]` in the same arm narrowed an `i16` unreported — the whole
// rule missing at one position rather than half of it.
arm_arrays = (c :: Checker, m: Match, a: TyArray) Res<(), AllocError> {
    m.arms.loop((h, arm) { c.array_elements(arm.body, a).try() });
    Ok(());
}

// ELEMENT ZERO IS THE ARRAY'S OWN WORD: the literal's type was minted
// from it, so whoever coerced the literal into this position has
// already asked whether it fits and already reported it. Asking again
// here would be one mistake said twice. `sema_type.fixed_array_type`
// writes the type beside the values with no coercion in front of it,
// and so asks about all of them.
elem_literals = (c :: Checker, lit: ArrayLit, elem: TyId)
                Res<(), AllocError> {
    lit.elems.loop((h, i, e) {
        (i > 0).match({
            true  => c.element_agrees(e, elem),
            false => Ok(()),
        }).try();
        c.check_literal(e, elem).try();
    });
    Ok(());
}

// An arm's value sits in the match's own position: `m: i32 =
// b.match({ true => 3000000000, .. })` puts the literal where `i32` is
// — same reason parentheses are walked into.
literal_within = (c :: Checker, id: ExprId, want: TyId)
                 Res<(), AllocError> {
    node = c.tree.expr_at(id);
    node.kind.match({
        Match(m) => c.arm_literals(m, want),
        _        => c.folded_within(id, want),
    })
}

arm_literals = (c :: Checker, m: Match, want: TyId) Res<(), AllocError> {
    m.arms.loop((h, a) { c.literal_within(a.body, want).try(); });
    Ok(());
}

// The fold is `const_int`'s: one number however many operators wrote it,
// under the depth budget that lets a ten-thousand-term chain decline
// instead of segfaulting (sema_const). A decline is usually "not
// provably anything" -- a binding in the way, a chain past the budget --
// and silence is right for it. A BARE `Int` literal is the one form with
// no such excuse: its digits reached the tree only by fitting a u64
// accumulator (`std/lex/lex_literal.zen`), so declining means they are
// past i64, which every type but u64/usize cannot hold (#769).
folded_within = (c :: Checker, id: ExprId, want: TyId) Res<(), AllocError> {
    c.const_int(id).match({
        None  => c.unfoldable_within(id, want),
        Ok(v) => c.value_within(id, want, v),
    })
}

unfoldable_within = (c :: Checker, id: ExprId, want: TyId) Res<(), AllocError> {
    c.tree.expr_at(id).kind.match({
        Literal(l) => c.literal_kind_within(id, l, want),
        _          => Ok(()),
    })
}

literal_kind_within = (c :: Checker, id: ExprId, l: Literal, want: TyId)
                      Res<(), AllocError> {
    name   = c.prim_name(want);
    widest = name.eq("u64") || name.eq("usize");
    l.kind.match({
        Int => widest.match({
            true  => Ok(()),
            false => c.out_of_range(id, want),
        }),
        _   => Ok(()),
    })
}

value_within = (c :: Checker, id: ExprId, want: TyId, v: i64)
               Res<(), AllocError> {
    // A REFUSAL IS NOT "IN RANGE" (#817): `fits` declines a name its
    // table does not hold, and declining to report is the answer for
    // what nothing was proved about — never a judgment from a guessed
    // bound.
    fits(v, c.prim_name(want)).match({
        None      => Ok(()),
        Ok(false) => c.out_of_range(id, want),
        Ok(true)  => Ok(()),
    })
}

// The position is the literal the author has to change, which for a
// negated one is the `-` and not the digits after it.
out_of_range = (c :: Checker, id: ExprId, want: TyId) Res<(), AllocError> {
    node  = c.tree.expr_at(id);
    found = c.types.prim("int").try();
    name  = c.written_literal(node).try();
    c.report(
        node.span.file,
        node.span,
        SemaFault.LiteralOutOfRange(TypeFault(
            name: name,
            expected: want,
            found: found
        ))
    )
}

// THE RANGE QUESTION WITHOUT THE DIAGNOSTIC, for the one position sema
// cannot reach. `h.break(300)` over a `[u8]` walk is a literal in a
// typed slot like every other position this file guards, but it lives
// inside a LAMBDA BODY and sema does not walk those — the backend is
// the only pass that ever sees the pair. A `report` from there would
// join a list already rendered, so the knowledge stays here with the
// rest of the range rule and `gen_c_handle` asks for it in its own
// voice (#766).
literal_overflows* = (c: Checker, id: ExprId, want: TyId) bool {
    name = c.prim_name(want);
    is_integer(name).match({
        false => false,
        true  => c.int_literal_overflows(id, name),
    })
}

int_literal_overflows = (c: Checker, id: ExprId, name: str) bool {
    c.literal_int(c.tree.expr_at(id)).match({
        None  => false,
        Ok(v) => c.fits_says(v, name),
    })
}

// A REFUSAL IS NOT "IT FITS" (#817): the backend's one range question
// reports only what was PROVED not to fit.
fits_says = (c: Checker, v: i64, name: str) bool {
    fits(v, name).match({
        None      => false,
        Ok(false) => true,
        Ok(true)  => false,
    })
}

// The literal as written, empty if not written as one (same pattern as
// `written_index`, and the same shape `literal_int` walks). Parens
// don't change a literal and neither does a leading minus — the minus
// is part of how it was written — so `-1` reads back as `-1`, not as
// `1`. The negated form is composed rather than sliced, which is why
// this allocates and says so; `dotted` in sema_def.zen is the
// precedent, and every other arm hands back a slice the tree owns.
written_literal = (c: Checker, node: Expr) Res<str, AllocError> {
    node.kind.match({
        Literal(l) => Ok(l.text),
        Paren(p)   => c.written_literal(c.tree.expr_at(p.inner)),
        Unary(u)   => {
            digits ::= c.written_literal(c.tree.expr_at(u.operand)).try();
            out    ::= c.alloc.String().try();
            out.add_bytes("-").try();
            out.add_bytes(digits).try();
            Ok(out.view())
        },
        _          => Ok(""),
    })
}

// Unlike `const_int`, walks only literal, paren and unary-minus forms —
// the tree's own nesting bounds the recursion. Arithmetic goes through
// `const_int` at the caller (#769): a chain is left-nested and
// unbounded, and folding it by recursion segfaulted on a long line.
literal_int = (c: Checker, node: Expr) Res<i64> {
    node.kind.match({
        Literal(l) => const_literal(l),
        Paren(p)   => c.literal_int(c.tree.expr_at(p.inner)),
        Unary(u)   => c.literal_neg(u),
        _          => None,
    })
}

literal_neg = (c: Checker, u: Unary) Res<i64> {
    u.op.match({
        Neg => c.negate_literal(u.operand),
        _   => None,
    })
}

negate_literal = (c: Checker, id: ExprId) Res<i64> {
    c.literal_int(c.tree.expr_at(id)).match({
        None  => None,
        Ok(v) => Ok(0 - v),
    })
}

// ---------------------------------------------------------------------
// the index rule
//
// A literal index past a known length is a compile error. The length is
// the count in the type; the index folds like any other operand here,
// so one reached through a binding is left to the runtime check — the
// same literals-only discipline the arithmetic rules keep.
// ---------------------------------------------------------------------

check_index* = (c :: Checker, node: Expr, x: Index, a: TyArray)
               Res<(), AllocError> {
    c.const_int(x.index).match({
        None  => Ok(()),
        Ok(i) => c.index_within(node, x, i, a.count),
    })
}

// Negative index tested separately: `len_of` floors at zero, so `-1`
// would arrive as 0 and pass. `zg_idx_s` makes the same split at runtime.
index_within = (c :: Checker, node: Expr, x: Index, i: i64, count: usize)
               Res<(), AllocError> {
    ((i < 0) || (len_of(i) >= count)).match({
        false => Ok(()),
        true  => c.out_of_bounds(node, x),
    })
}

// Points at the whole index expression, not the `[` a runtime trap
// prints: a compile error can point at what the author must change.
out_of_bounds = (c :: Checker, node: Expr, x: Index) Res<(), AllocError> {
    c.report(
        node.span.file,
        node.span,
        SemaFault.ProvenIndexOutOfBounds(NameFault(name: c.written_index(x)))
    )
}

// The index as written (same pattern as `written_literal`): a source
// slice the tree already owns, so nothing is allocated to outlive the
// diagnostic; a fold quotes nothing.
written_index = (c: Checker, x: Index) str {
    c.tree.expr_at(x.index).kind.match({
        Literal(l) => l.text,
        _          => "",
    })
}
