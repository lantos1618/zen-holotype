// compiler.lex — turn zen source text into a token stream. Two forms, both in this file:
//   • scan(src, pos) — the default: one token at a time, PURE (position in, position
//     out). Allocation-free and slice-free — the source is read raw (a `str` is a const
//     char*, so load(offset(src,i)) gives byte i), and a token is just a span
//     { kind, start, len } into it. So genc can lower this. Iterate to Eof.
//     allocated through an explicit allocator (bottom of the file). Use it when you want
//     to hand a file's tokens around; the scan form is better when you just consume them.
// C strings are NUL-terminated, so byte 0 ends the scan and no length is threaded.
//
//   sc := scan(src, 0)        // one token + where to resume
//   sc.tok.kind               // Ident | Int | Float | Str | Sym | Eof
//   sc.next                   // feed back into scan for the next token
{ at, block_comment_at, is_digit, is_hex, is_bin, is_oct, is_alpha, is_alnum, is_space,
  line_comment_at, rawstr_at } = std.text.ascii
{ advance_while, repeat_while, step_while } = std.core.count
// ── tokens ───────────────────────────────────────────────────────────────────
TokKind: Ident | Int | Float | Str | Char | Sym | Eof
Token*: {
    kind: TokKind,
    start: i32,
    len: i32,
}    // lexeme = source[start .. start+len]
Scan*: {
    tok: Token,
    next: i32,
}    // one scan step: the token + resume pos
// ── the lexer's one failure flag ───────────────────────────────────────────────
// Set when a `/*` never closes: the rest of the file vanishes into the comment and the stream
// silently ENDS at the typo — every later decl would be dropped with no error. The parser reads
// this (lerr_get, mirroring parse_type's perr_get) and rejects the module as a parse error
// instead of compiling the truncated prefix. (An unterminated STRING is caught by the parser
// itself — its token still reaches str_open; a swallowed comment never surfaces as a token.)
lex_failed := 0
// byte offset of the first lexer error that carried one (0 = none) — the `/*` of an unterminated
// block comment, or the `0` of a malformed radix literal. parse_module folds it into the
// __syntax_error sentinel so the KPARSE diagnostic can caret the failing site (mirrors perr_set_at).
lex_err_off := 0
lerr_set_at = (off: i32) void {
    (lex_err_off == 0).then({
        lex_err_off = off
    })
    lex_failed = 1
}
lerr_reset* = () void {
    lex_failed = 0
    lex_err_off = 0
}
lerr_get* = () bool { lex_failed == 1 }
lerr_off_get* = () i32 { lex_err_off }
// ── skip whitespace, `//` line comments, and `/* */` block comments → next significant pos ──
skip_line = (src: StringView, pos: i32) i32 {
    pos.advance_while((p) { at(src, p) != '\0' && at(src, p) != '\n' })
}    // stop at NUL / newline
skip_block_comment = (src: StringView, pos: i32) i32 { src.skip_bc_d(pos, 1, pos - 2) }    // pos just past `/*`; the `/*` opens at pos-2
// NESTED block comments: track depth so `/* /* */ */` closes at the OUTER `*/`, not the first one.
// `open` carries the byte offset of the OUTER `/*` so an unterminated comment can caret its start.
skip_bc_d = (src: StringView, pos: i32, depth: i32, open: i32) i32 {
    d := depth
    e := pos.step_while((p) {
        at(src, p) != '\0' && (d == 1 && at(src, p) == '*' && at(src, p + 1) == '/') == false
    }, (p) {
        (at(src, p) == '/' && at(src, p + 1) == '*').match ({
            true  => {
                d = d + 1
                p + 2
            },
            false => (at(src, p) == '*' && at(src, p + 1) == '/').match ({
                true  => {
                    d = d - 1
                    p + 2
                },
                false => p + 1,
            }),
        })
    })
    (at(src, e) == '\0').match ({
        true  => {
            lerr_set_at(open)
            e
        },
        false => e + 2,
    })
}    // unterminated — stop at NUL and FLAG it (positioned at the opening `/*`)
skip = (src: StringView, pos: i32) i32 {
    p := pos
    repeat_while((n) {
        is_space(at(src, p)).match ({
            true  => {
                p = p + 1
                true
            },
            false => src.line_comment_at(p).match ({
                true  => {
                    p = src.skip_line(p + 2)
                    true
                },
                false => src.block_comment_at(p).match ({
                    true  => {
                        p = src.skip_block_comment(p + 2)
                        true
                    },
                    false => false,
                }),
            }),
        })
    })
    p
}    // each pass consumes a whole run — spaces one byte, a comment its whole span (which may nest `/*`)
// ── span ends: advance while the class holds ───────────────────────────────────
ident_end = (src: StringView, pos: i32) i32 { pos.advance_while((p) { is_alnum(at(src, p)) }) }
// A `_` between two digits (`1_000`, `0xFF_FF`) is a separator and part of the span; a leading/
// trailing `_` or `__` is NOT consumed (it only advances when a digit of the class follows), so a
// var `x_1` / `_y` still scans as an identifier.
// iterative digit-run scanners (a long numeric literal must not recurse per digit): advance over
// class digits, and over a `_` that sits BETWEEN two class digits (the separator rule).
int_end = (src: StringView, pos: i32) i32 {
    pos.advance_while((p) { is_digit(at(src, p)) || at(src, p) == '_' && is_digit(at(src, p + 1)) })
}
hex_end = (src: StringView, pos: i32) i32 {
    pos.advance_while((p) { is_hex(at(src, p)) || at(src, p) == '_' && is_hex(at(src, p + 1)) })
}
bin_end = (src: StringView, pos: i32) i32 {
    pos.advance_while((p) { is_bin(at(src, p)) || at(src, p) == '_' && is_bin(at(src, p + 1)) })
}
oct_end = (src: StringView, pos: i32) i32 {
    pos.advance_while((p) { is_oct(at(src, p)) || at(src, p) == '_' && is_oct(at(src, p + 1)) })
}
// a number span from its first digit: `0x…` runs over hex digits, `0b…` binary, `0o…` octal,
// otherwise decimal digits.
is_hex_prefix* = (src: StringView, pos: i32) bool {
    at(src, pos) == '0' && (at(src, pos + 1) == 'x' || at(src, pos + 1) == 'X')
}
is_bin_prefix* = (src: StringView, pos: i32) bool {
    at(src, pos) == '0' && (at(src, pos + 1) == 'b' || at(src, pos + 1) == 'B')
}
is_oct_prefix* = (src: StringView, pos: i32) bool {
    at(src, pos) == '0' && (at(src, pos + 1) == 'o' || at(src, pos + 1) == 'O')
}
num_end = (src: StringView, pos: i32) i32 {
    src.is_hex_prefix(pos).match ({
        true  => src.radix_end(pos + 2, src.hex_end(pos + 2)),
        false => src.is_bin_prefix(pos).match ({
            true  => src.radix_end(pos + 2, src.bin_end(pos + 2)),
            false => src.is_oct_prefix(pos).match ({
                true  => src.radix_end(pos + 2, src.oct_end(pos + 2)),
                false => src.int_end(pos + 1),
            }),
        }),
    })
}
// Validate a `0x`/`0b`/`0o` radix literal. `ds` = first digit (just past the 2-char prefix), `e` =
// end of the consumed base-digit run. Two malformings flag a positioned lexer error (caret at the
// `0` of the prefix, ds-2): an EMPTY literal (no digit consumed, `0b`/`0o`/`0x`) and a digit-run
// immediately followed by an alphanumeric that is NOT a valid digit of the base (`0o9`, `0b19`,
// `0xFFg`) — which the old scanner silently split into two tokens with the wrong value.
radix_end = (src: StringView, ds: i32, e: i32) i32 {
    (e == ds || is_alnum(at(src, e))).match ({
        true  => {
            lerr_set_at(ds - 2)
            e
        },
        false => e,
    })
}
// scientific exponent: `[eE][+-]?[0-9]+` right after the mantissa. Returns the end past the
// exponent when one is present, else `pos` unchanged — so `1e` (no digit) / `1einstein` /
// `x.e` are NOT mis-consumed; the exponent only fuses when a digit actually follows.
exp_end = (src: StringView, pos: i32) i32 {
    (at(src, pos) == 'e' || at(src, pos) == 'E').match ({
        true  => {
            p2 := (at(src, pos + 1) == '+' || at(src, pos + 1) == '-').match ({
                true  => pos + 2,
                false => pos + 1,
            })
            is_digit(at(src, p2)).then({ src.int_end(p2) }, { pos })
        },
        false => pos,
    })
}
str_end = (src: StringView, pos: i32) i32 {
    e := pos.step_while((p) { at(src, p) != '\0' && at(src, p) != '"' }, (p) {
        (at(src, p) == '\\').then({ p + 2 }, { p + 1 })
    })    // pos just past the opening quote; a `\` swallows the byte after it
    (at(src, e) == '\0').then({ e }, { e + 1 })
}    // unterminated — stop at NUL; ITERATIVE so a ~50KB string literal is O(n) iteration, not O(n) C-stack
// A raw literal opens with THREE quotes. Checked before the single-quote form so maximal munch wins:
// `""` keeps meaning the empty string (it is two quotes followed by something that is not a quote),
// which is why the delimiter is `"""` and not `""` — the doubled form would make every existing `""`
// ambiguous.
// pos just past the opening `"""`; returns the position just past the closing `"""`. No escape
// handling — a backslash is an ordinary byte, so only the delimiter can end the scan. Iterative for
// the same reason as str_end: a multi-kilobyte block literal must not recurse the C stack.
rawstr_end* = (src: StringView, pos: i32) i32 {
    e := pos.advance_while((p) { at(src, p) != '\0' && src.rawstr_at(p) == false })
    (at(src, e) == '\0').then({ e }, { e + 3 })
}
char_end = (src: StringView, pos: i32) i32 {
    b := at(src, pos)    // first byte inside the quotes
    // a char literal `'x'` or `'\n'` — pos is just past the opening quote; returns the
    // position just past the closing quote. One char, or a `\.` escape.
    // NUL first ⇒ unterminated at EOF: stop like str_end, never step past the terminator.
    (b == '\0').match ({
        true  => pos,
        false => (b == '\'').match ({
            true  => pos + 1,    // empty '' → consume just the two quotes
            // a `\.` escape skips the escaped byte, unless that byte is the EOF NUL
            false => (b == '\\' && at(src, pos + 1) != '\0').match ({
                true  => src.scan_quote_end(pos + 2),
                false => src.scan_quote_end(pos + 1),
            }),
        }),
    })
}
scan_quote_end = (src: StringView, pos: i32) i32 {
    // Scan to (and past) the closing `'`. Keeps a malformed multi-char literal like 'ab' from
    // DESYNCING the token stream — it consumes the whole literal instead of leaving a stray quote.
    // Iterative so a long malformed char literal cannot recurse per byte.
    e := pos.advance_while((p) { at(src, p) != '\'' && at(src, p) != '\0' })
    (at(src, e) == '\0').then({ e }, { e + 1 })
}    // unterminated ⇒ stop AT the NUL, don't overshoot the buffer
// ── symbols ──────────────────────────────────────────────────────────────────
// zen's two-char operators: `:=  ==  <=  >=  &&  ||  =>`. A symbol token spans two
// bytes when the pair forms one of these, else one — so the parser never re-glues.
two_op = (b0: u8, b1: u8) bool {
    b0 == ':' && b1 == '='
        || b0 == '=' && b1 == '='
        || b0 == '<' && b1 == '='
        || b0 == '>' && b1 == '='
        || b0 == '=' && b1 == '>'
        || b0 == '&' && b1 == '&'
        || b0 == '!' && b1 == '='
        || b0 == '|' && b1 == '|'
        || b0 == '<' && b1 == '<'
        || b0 == '>' && b1 == '>'
        || b1 == '=' && (b0 == '+' || b0 == '-' || b0 == '*' || b0 == '/' || b0 == '%')
}    // := ; the last clause adds the compound-assign ops `+= -= *= /= %=`
sym_end = (src: StringView, pos: i32) i32 {
    two_op(at(src, pos), at(src, pos + 1)).then({ pos + 2 }, { pos + 1 })
}    // ==
mk = (k: TokKind, start: i32, end: i32) Scan {
    Scan(
        tok: Token(
            kind: k,
            start: start,
            len: end - start,
        ),
        next: end,
    )
}    // <=
tok_eof = () TokKind { .Eof }    // >=
num_tok = (src: StringView, pos: i32) Scan {
    e := src.num_end(pos)    // =>
    // &&
    // !=
    // ||
    // << (shift)
    // >> (shift)
    // ── one token ──────────────────────────────────────────────────────────────────
    // a number token. A decimal digit run becomes a FLOAT when it grows a fractional part
    // (`digits '.' digits`) and/or a scientific exponent (`[eE][+-]?digits`): `3.14`, `1e10`,
    // `1.5e-3`, `6.022e23`, `1.0E5`. The dot must be followed by a digit, so `1.match` /
    // `xs[0].addr()` still scan as an Int + a `.` postfix; the exponent only fuses when a digit
    // follows `e`, so `x.e` / a var `e1` are untouched. Hex (`0x…`) never floats.
    nofloat := src.is_hex_prefix(pos) || src.is_bin_prefix(pos) || src.is_oct_prefix(pos)
    has_frac := nofloat.then({ false }, { at(src, e) == '.' && is_digit(at(src, e + 1)) })
    me := has_frac.then({ src.int_end(e + 1) }, { e })
    end := nofloat.then({ me }, { src.exp_end(me) })
    (has_frac || end > me).then({ mk(.Float, pos, end) }, { mk(.Int, pos, e) })
}
scan_one = (src: StringView, pos: i32, b: u8) Scan {
    is_alpha(b).match ({
        true  => mk(.Ident, pos, src.ident_end(pos + 1)),
        false => is_digit(b).match ({
            true  => src.num_tok(pos),
            false => (b == '"').match ({
                true  => src.rawstr_at(pos).match ({
                    true  => mk(.Str, pos, src.rawstr_end(pos + 3)),
                    false => mk(.Str, pos, src.str_end(pos + 1)),
                }),
                false => (b == '\'').match ({
                    true  => mk(.Char, pos, src.char_end(pos + 1)),
                    false => mk(.Sym, pos, src.sym_end(pos)),
                }),
            }),
        }),
    })
}
scan* = (src: StringView, pos0: i32) Scan {
    pos := src.skip(pos0)
    b := at(src, pos)
    (b == '\0').match ({
        true  => Scan(
            tok: Token(
                kind: tok_eof(),
                start: pos,
                len: 0,
            ),
            next: pos,
        ),
        false => src.scan_one(pos, b),
    })
}
// ── the stream, without materializing it ───────────────────────────────────────
// scan iterated to Eof IS the token stream — pure and positional, so a consumer gets
// free lookahead (peek = scan(src, pos); the one after = scan(src, scan(src, pos).next))
// and the token layer stays allocation-free. count() traverses the whole stream this
// way.
// total token count, Eof excluded — a traversal of the entire stream by iteration.
count* = (src: StringView) i32 { src.count_from(0) }
count_from = (src: StringView, pos: i32) i32 {
    sc := src.scan(pos)
    sc.tok.kind.match ({
        .Eof => 0,
        _    => 1 + src.count_from(sc.next),
    })
}
// ── a materialized token list ──────────────────────────────────────────────────
// the comment sidecar below allocates its span buffer through the explicit allocator
{ Malloc } = std.mem.alloc
{ acquire_or_die } = compiler.genc
// ── comment sidecar: collect every `//` and `/* */` comment as a positioned span ──────────────────
// The token scanner SKIPS comments (they carry no semantics), but the formatter must reproduce them.
// So this is a SEPARATE pass over the raw source that records each comment as a span into it, plus
// whether it is TRAILING — i.e. non-whitespace appears before it on the same line (`x := 1  // note`)
// vs. a LEADING comment that owns its own line. Strings/chars are honored so a `//` inside `"…"`
// or a `}` inside a comment never desyncs (mirrors the lexer's own string/char/escape handling) — and a
// `"""` raw literal is skipped WHOLE, because its quotes are content: tracking them as open/close
// parity mistakes a `//` inside one for a comment, which then overlaps the string token the real
// lexer reports (see compiler.lsp_tokens) and injects a phantom comment into formatter output.
// The result is a flat, position-SORTED [Comment] the formatter consults by byte offset — comments
// stay sidecar data, never entering the AST, so the lowered tree (and emitted C) is unchanged.
Comment*: {
    start: i32,
    len: i32,
    trailing: bool,
}    // span [start, start+len); trailing = same-line code before it
cmt_buf = (a: MutPtr<Malloc>, n: i32) [Comment] { slice(a.acquire_or_die(n * sizeof(Comment)), n) }
// count comments first so the buffer is exact (no cap guesswork on a 100KB file).
collect_comments* = (a: MutPtr<Malloc>, src: StringView) [Comment] {
    n := src.count_comments()
    buf := a.cmt_buf(n + 1)    // +1 keeps a 0-comment file from a 0-size acquire
    src.fill_comments(buf, 0)
    slice(buf.ptr, n)
}
// number of comments in the source — one iterative scan (no per-byte recursion: big files).
count_comments = (src: StringView) i32 {
    zero: i32 := 0
    n := 0
    in_str := false
    in_char := false
    esc := false
    zero.step_while((i) { at(src, i) != '\0' }, (i) {
        b := at(src, i)
        in_str.match ({
            true  => esc.match ({
                true  => {
                    esc = false
                    i + 1
                },
                false => (b == '\\').match ({
                    true  => {
                        esc = true
                        i + 1
                    },
                    false => (b == '"').match ({
                        true  => {
                            in_str = false
                            i + 1
                        },
                        false => {
                            i + 1
                        },
                    }),
                }),
            }),
            false => in_char.match ({
                true  => esc.match ({
                    true  => {
                        esc = false
                        i + 1
                    },
                    false => (b == '\\').match ({
                        true  => {
                            esc = true
                            i + 1
                        },
                        false => (b == '\'').match ({
                            true  => {
                                in_char = false
                                i + 1
                            },
                            false => {
                                i + 1
                            },
                        }),
                    }),
                }),
                false => (b == '/' && at(src, i + 1) == '/').match ({
                    true  => {
                        n = n + 1
                        src.skip_line(i + 2)
                    },
                    false => (b == '/' && at(src, i + 1) == '*').match ({
                        true  => {
                            n = n + 1
                            src.skip_block_comment(i + 2)
                        },
                        false => src.rawstr_at(i).match ({
                            true  => {
                                src.rawstr_end(i + 3)
                            },
                            false => (b == '"').match ({
                                true  => {
                                    in_str = true
                                    i + 1
                                },
                                false => (b == '\'').match ({
                                    true  => {
                                        in_char = true
                                        i + 1
                                    },
                                    false => {
                                        i + 1
                                    },
                                }),
                            }),
                        }),
                    }),
                }),
            }),
        })
    })
    n
}
// is byte position `s` the start of a fresh line (only whitespace back to the previous '\n' / BOF)?
line_is_blank_before = (src: StringView, s: i32) bool {
    blank := true
    (s - 1).step_while((p) { p >= 0 && at(src, p) != '\n' }, (p) {
        (is_space(at(src, p)) == false).then({
            blank = false
        })
        p - 1
    })
    blank
}
// record each comment span into `buf` (exactly count_comments() of them); same scanner as the count.
fill_comments = (src: StringView, buf: [Comment], k0: i32) void {
    zero: i32 := 0
    k := k0
    in_str := false
    in_char := false
    esc := false
    zero.step_while((i) { at(src, i) != '\0' }, (i) {
        b := at(src, i)
        in_str.match ({
            true  => esc.match ({
                true  => {
                    esc = false
                    i + 1
                },
                false => (b == '\\').match ({
                    true  => {
                        esc = true
                        i + 1
                    },
                    false => (b == '"').match ({
                        true  => {
                            in_str = false
                            i + 1
                        },
                        false => {
                            i + 1
                        },
                    }),
                }),
            }),
            false => in_char.match ({
                true  => esc.match ({
                    true  => {
                        esc = false
                        i + 1
                    },
                    false => (b == '\\').match ({
                        true  => {
                            esc = true
                            i + 1
                        },
                        false => (b == '\'').match ({
                            true  => {
                                in_char = false
                                i + 1
                            },
                            false => {
                                i + 1
                            },
                        }),
                    }),
                }),
                false => (b == '/' && at(src, i + 1) == '/').match ({
                    true  => {
                        e := src.skip_line(i + 2)
                        buf[k] = Comment(
                            start: i,
                            len: e - i,
                            trailing: src.line_is_blank_before(i).then({ false }, { true }),
                        )
                        k = k + 1
                        e
                    },
                    false => (b == '/' && at(src, i + 1) == '*').match ({
                        true  => {
                            e := src.skip_block_comment(i + 2)
                            buf[k] = Comment(
                                start: i,
                                len: e - i,
                                trailing: src.line_is_blank_before(i).then({ false }, { true }),
                            )
                            k = k + 1
                            e
                        },
                        false => src.rawstr_at(i).match ({
                            true  => {
                                src.rawstr_end(i + 3)
                            },
                            false => (b == '"').match ({
                                true  => {
                                    in_str = true
                                    i + 1
                                },
                                false => (b == '\'').match ({
                                    true  => {
                                        in_char = true
                                        i + 1
                                    },
                                    false => {
                                        i + 1
                                    },
                                }),
                            }),
                        }),
                    }),
                }),
            }),
        })
    })
}
