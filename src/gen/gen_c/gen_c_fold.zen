// src/gen/gen_c/gen_c_fold.zen
// THE SIXTH SHAPE: an accumulator, and what a fold evaluates to.
//
// `gen_c_loop.zen` writes the five shapes that walk and discard; this
// is the one that THREADS: "init seeds acc, acc threads through
// iterations, the loop evaluates to the final acc — or to
// `h.break(value)`, which is what makes the two forms one thing".
//
// Three things follow, and this file is those three:
//   - `acc` is ONE AUTOMATIC LOCAL. "index and acc thread BY VALUE, so
//     no cell is heap-allocated" — seeded before the first pass, and
//     the body's own value written back at the end of every one. The
//     assignment IS the thread.
//   - The result is `Ok(acc)`, WRITTEN BEFORE THE BREAK LABEL. A fold
//     that ran to the end has an answer where a walk has none;
//     `h.break(v)` jumps PAST that line, so the break's value wins.
//     Writing it after the label would make a break silently return
//     the accumulator instead — which is what `bootstrap/gen_c.py`
//     does today.
//   - A fold evaluates to its accumulator, not what it walked:
//     `Res<A>`, never `Res<T>`. The seed says which.

Ast, Expr, ExprId, Lambda, Function, Param, Call, Access = ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId, Ty, Types = sema.sema_ty
Checker, Ctx = sema.sema_check
sym_member, sym_gen, sym_variant, RES_PATH = gen.gen_name
CBackend = gen.gen_c.gen_c_state
LoopFrame = gen.gen_c.gen_c_frame
unsupported = gen.gen_c.gen_c_report
open = gen.gen_c.gen_c_mono
ctype, declarator = gen.gen_c.gen_c_type
ty_of = gen.gen_c.gen_c_expr
Dest, deliver = gen.gen_c.gen_c_stmt
lower_walk, settle_res, bind_element = gen.gen_c.gen_c_loop
Shape, shape_of, loop_element, loop_fn_at = gen.gen_c.gen_c_shape
arg_value, recv_of = gen.gen_c.gen_c_shape

// The accumulator a fold threads, nothing for the five shapes that do
// not. `acc` threads BY VALUE — "no cell is heap-allocated" — one
// automatic local written at the end of every pass to the body's own
// value.
Fold* = {
    cell*: str,
    ty*: TyId,
    has*: bool,
}

no_fold* = (be :: CBackend) Res<Fold, AllocError> {
    unknown = be.check.types.unknown().try();
    Ok(Fold(cell: "", ty: unknown, has: false));
}

// The sixth shape: the accumulator is ONE LOCAL, seeded before the
// first pass and assigned the body's own value at the end of every
// one; the loop's result is `Ok(acc)`, written where a walk writes
// nothing — see the file header for why.
lower_fold* = (be :: CBackend, id: ExprId, sh: Shape, args: Vec<ExprId>,
              lam: Lambda, ctx: Ctx, want: TyId, out :: String)
             Res<(), AllocError> {
    args.get(args.len - 2).match({
        None  => unsupported(be, id, "a fold with no seed", out),
        Ok(s) => lower_seeded(be, id, sh, args, s, lam, ctx, want, out),
    })
}

lower_seeded = (be :: CBackend, id: ExprId, sh: Shape, args: Vec<ExprId>,
                seed: ExprId, lam: Lambda, ctx: Ctx, want: TyId,
                out :: String) Res<(), AllocError> {
    aty = acc_type(be, seed, ctx, want).try();
    open(be, aty).match({
        true  => unsupported(be, id, "a fold whose accumulator type nothing settles", out),
        false => lower_with_acc(be, id, sh, args, seed, aty, lam, ctx, want, out),
    })
}

// The accumulator's type is the SEED's: `init is the answer when there
// is nothing to fold", so the two are one type by construction. The
// expectation is the fallback, since a `Res<A>` names it too.
acc_type = (be :: CBackend, seed: ExprId, ctx: Ctx, want: TyId)
           Res<TyId, AllocError> {
    unknown = be.check.types.unknown().try();
    got = ty_of(be, seed, ctx, unknown).try();
    settled_acc(be, got, want)
}

settled_acc = (be :: CBackend, got: TyId, want: TyId)
              Res<TyId, AllocError> {
    (be.check.is_unknown(got) || open(be, got)).match({
        false => Ok(got),
        true  => res_value_of(be, want),
    })
}

res_value_of = (be :: CBackend, want: TyId) Res<TyId, AllocError> {
    be.check.types.at(want).match({
        Res(r) => Ok(r.value),
        _      => Ok(want),
    })
}

lower_with_acc = (be :: CBackend, id: ExprId, sh: Shape, args: Vec<ExprId>,
                  seed: ExprId, aty: TyId, lam: Lambda, ctx: Ctx,
                  want: TyId, out :: String) Res<(), AllocError> {
    cell ::= be.alloc.String().try();
    sym_gen(cell, "a", be.next_tmp()).try();
    decl ::= be.alloc.String().try();
    declarator(be, aty, cell.view(), decl).try();
    decl.add_bytes(";").try();
    be.writeln(decl.view()).try();
    deliver(be, seed, ctx, aty, Dest.Into(cell.view())).try();
    settled = settle_res(be, want, aty).try();
    lower_walk(be, id, sh, args, lam, ctx, settled,
               Fold(cell: cell.view(), ty: aty, has: true), out)
}

// `acc` IS THE PARAMETER AFTER THE THREE THE WALK BINDS, and which of
// those are present is the declaration's answer — the same question
// `bind_threaded` asks one function up, and the same positions.
bind_acc* = (be :: CBackend, sh: Shape, lam: Lambda, fold: Fold)
           Res<(), AllocError> {
    fold.has.match({
        false => Ok(()),
        true  => bind_element(be, lam, acc_slot(sh), fold.cell, fold.ty),
    })
}

acc_slot = (sh: Shape) usize {
    1 + sh.wants_index.match({ true => 1, false => 0 })
      + sh.wants_value.match({ true => 1, false => 0 })
}

// A FOLD EVALUATES TO ITS ACCUMULATOR, not to what it walked: `Res<A>`
// and never `Res<T>`. The seed is what says which, and it is the
// argument before the body — one place, so the type a temporary is
// declared at and the type the loop assigns cannot disagree.
result_element* = (be :: CBackend, id: ExprId, ctx: Ctx)
                 Res<TyId, AllocError> {
    seed_arg(be, id).match({
        None  => loop_element(be, id, ctx),
        Ok(s) => seed_element(be, s, ctx),
    })
}

seed_element = (be :: CBackend, seed: ExprId, ctx: Ctx)
               Res<TyId, AllocError> {
    unknown = be.check.types.unknown().try();
    ty_of(be, seed, ctx, unknown)
}

// The seed of the one shape that has one, read off the DECLARATION the
// call resolved to rather than off the argument count: `loop(cond,
// body)` also has two arguments and no seed at all.
seed_arg = (be :: CBackend, id: ExprId) Res<ExprId> {
    loop_fn_at(be, id).match({
        None  => None,
        Ok(f) => fold_seed(be, id, f),
    })
}

fold_seed = (be :: CBackend, id: ExprId, f: Function) Res<ExprId> {
    is_fold(be, f).match({
        false => None,
        true  => seed_before_body(be, id),
    })
}

is_fold = (be :: CBackend, f: Function) bool {
    shape_of(be, f).match({ Ok(sh) => sh.wants_acc, Err(_) => false })
}

seed_before_body = (be :: CBackend, id: ExprId) Res<ExprId> {
    be.tree.expr_at(id).kind.match({
        Call(c) => call_seed(be, c),
        _       => None,
    })
}

call_seed = (be :: CBackend, c: Call) Res<ExprId> {
    recv_of(be, c.callee).match({
        Ok(_) => arg_value(c, c.args.len - 2),
        None  => arg_value(c, c.args.len - 2),
    })
}

// The result, written before the break label — see the file header.
// The temporary was seeded `None` before the first pass; this is where
// it becomes `Ok(acc)`, and `h.break(v)` jumps PAST this line so the
// break's value wins.
write_fold_result* = (be :: CBackend, st: LoopFrame, fold: Fold)
                     Res<(), AllocError> {
    (fold.has && st.has_result).match({
        false => Ok(()),
        true  => write_ok_acc(be, st, fold),
    })
}

write_ok_acc = (be :: CBackend, st: LoopFrame, fold: Fold)
               Res<(), AllocError> {
    line ::= be.alloc.String().try();
    line.add_bytes(st.result).try();
    line.add_bytes(" = (").try();
    ctype(be, st.ty, line).try();
    line.add_bytes("){ .zg_tag = ").try();
    sym_variant(line, RES_PATH, "Ok").try();
    line.add_bytes(", .zg_data.").try();
    sym_member(line, "Ok").try();
    line.add_bytes(" = ").try();
    line.add_bytes(fold.cell).try();
    line.add_bytes(" };").try();
    be.writeln(line.view())
}
