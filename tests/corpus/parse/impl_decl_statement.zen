// `A.impl(B, {..})` is a call in statement position that DECLARES.
// at module level it is unambiguous, and this is DESIGN.md's own
// Circle/Rect example. the in-a-function-body case is unresolved and
// lives in must-fail/parse/impl_in_function_body.zen.
//
// THE MEMBERS ARE READ, not merely declared. `println("parsed")` restated
// what exit code 0 already proves, and the whole subject -- Circle.impl
// merging width/height into Rect's shape -- was declared and never used, so
// a parser that accepted `.impl(..)` and silently DISCARDED its members
// stayed green. Now `radius: 5.0` has to reach `area` as 10.0 x 15.0, and
// the two multipliers differ so a body that read `width` where it meant
// `height` prints the wrong answer instead of a symmetric one.

Rect = {
    width: f64,
    height: f64,

    area* ::= (self: @Self) f64 { self.width * self.height }
    perimeter* ::= (self: @Self) f64 { (self.width + self.height) * 2.0 }
}

Circle = { radius: f64 }

Circle.impl(Rect, {
    width: self.radius * 2.0,
    height: self.radius * 3.0,
})

same = (a: f64, b: f64) str {
    (a == b).match({
        true  => "yes",
        false => "no",
    });
}

main = (env: Env) Res<i32, ArgError> {
    c = Circle(radius: 5.0);
    println("area 150 {}", same(c.area(), 150.0));
    println("perimeter 50 {}", same(c.perimeter(), 50.0));
    println("area 100 {}", same(c.area(), 100.0));
    println("area 250 {}", same(c.area(), 250.0));
    r = Rect(width: 4.0, height: 6.0);
    println("rect area 24 {}", same(r.area(), 24.0));
    Ok(0);
}
