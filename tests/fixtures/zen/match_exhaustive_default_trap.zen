// A no-`_` match the checker proved exhaustive: every variant gets its own C `case`, and the
// emitter's `default:` traps (zen__panic / __zr.panic) instead of silently re-running the last
// arm's body — the old last-arm-as-default promotion was the #377 class of silent miscompiles.
Shape*: Dot | Line(i64) | Ring
area = (s: Shape) i64 {
    s.match ({
        .Dot     => 1,
        .Line(n) => n * 2,
        .Ring    => 9,
    })
}
main = () i32 {
    total := area(Shape.Dot) + area(Shape.Line(4)) + area(Shape.Ring)
    (total == 18).match ({ true => 0, false => 1 })
}
