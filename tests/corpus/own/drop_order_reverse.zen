// drop runs in reverse declaration order, exactly once each. the
// order is observable, so it is a corpus program and not a claim.
//
// `drop` cannot use the println sugar — the sugar resolves the Env in
// scope BY TYPE, and inside drop the only binding is self — so Noisy
// carries the Env it prints through, the same way Context does.

Noisy = {
    env: Env,
    tag: str,
}

Noisy.impl(Drop, {
    drop = (self :: @Self) () { self.env.out.println("drop {}", self.tag) }
})

main = (env: Env) Res<i32, IoError> {
    a = Noisy(env: env, tag: "a");
    b = Noisy(env: env, tag: "b");
    c = Noisy(env: env, tag: "c");
    println("body");
    Ok(0);
}
