// src/gen/gen_c/gen_c_inline.zen
// A callee that was handed a lambda, and the lambda when it is called.
//
// `loop_iter.zen` states the claim this file keeps: "a body is a
// non-escaping stack closure, inlined at the call site, so there is no
// closure record to box". `gen_c_loop.zen` keeps it for the six loop
// declarations, which have no bodies; this one keeps it for everything
// else — `bool.then`, `find`, `Cursor.bump_while` — where the callee
// DOES have a body and the lambda reaches it through an ordinary
// function-typed parameter.
//
// SO A LAMBDA IS NEVER A VALUE HERE. Passing one INLINES THE CALLEE,
// and calling the parameter it was bound to INLINES THE LAMBDA. There is
// no function pointer, no closure record and no C spelling for a `()
// bool` parameter — the same sentence as the `allocs_op: 0` budget
// `tests/bench/bench_loop.zen` declares.
//
// A CLOSURE'S FREE NAMES MEAN WHAT THEY MEANT WHERE IT WAS WRITTEN, and
// this is the half that is easy to get wrong. Inlining puts the body
// inside the callee's frame, so `find`'s own `range.loop((h, value) {
// .. })` would capture a caller's `h` — silently, with a different value
// rather than with an error. `Closure` carries the depth of BOTH scope
// stacks at the point the lambda was written and `run_closure` rewinds
// to them, which is what makes the capture hygienic.
//
// AND IT CARRIES THE CALLER'S `Ctx`, so a `.try()` inside a lambda body
// returns from the function the lambda was WRITTEN in. That is what
// `d.exported.then(() { out.add(d).try() })` means, and reading it any
// other way would return the wrong error type from the wrong frame.
//
// WHAT IS REFUSED, BY NAME: a return type nothing settles — `then<T>`
// reaches `T` only through the closure, which is `gen_c_settle.zen`'s
// argument. Where the lambda's own body does not settle it, the call is
// reported rather than emitted at a guess.
//
// WHAT A CALL EVALUATES TO IS `gen_c_settle.zen`'s SUBJECT, not this
// one: a question about types, asked before anything is written and
// again by `ty_of` for a match scrutinee. This is a question about
// statements. The two meet at `inline_ret`.

ExprId, BlockId, Lambda, Param, TypeId = std.ast
Function, Access, Call = std.ast
AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
DeclId = sema.sema_id
TyId, TyFn = sema.sema_ty
Def = sema.sema_def
Ctx, Binding = sema.sema_check
Inst, has_var = sema.sema_inst
self_ctx = sema.sema_member
sym_local, sym_gen = gen.gen_name
CBackend = gen.gen_c.gen_c_state
LocalSlot, Closure = gen.gen_c.gen_c_frame
unsupported, unresolved = gen.gen_c.gen_c_report
has_body = gen.gen_c.gen_c_impl
handle_depth = gen.gen_c.gen_c_handle
inst_at, settled_inst, recv_inst = gen.gen_c.gen_c_mono
enter_tparams, leave_tparams, enter_struct_tparams = gen.gen_c.gen_c_mono
declarator, is_unit = gen.gen_c.gen_c_type
expr = gen.gen_c.gen_c_expr
Dest, block = gen.gen_c.gen_c_stmt
plain_ctx, body_ctx, self_body_ctx, ref_declarator = gen.gen_c.gen_c_decl
write_address = gen.gen_c.gen_c_call
arguments, param_types, call_bindings, inline_ret = gen.gen_c.gen_c_settle
compose, settle_params, settled = gen.gen_c.gen_c_settle

// A bound on how deep inlining goes, and a diagnostic at it rather than
// a walk that does not terminate. A recursive function taking a lambda
// would otherwise unfold forever.
INLINE_DEPTH* : usize = 12

// -----------------------------------------------------------------
// recognising
// -----------------------------------------------------------------

// A body to inline, and a lambda written at the call site to inline it
// for.
inlines* = (be: CBackend, c: Call, f: Function) bool {
    has_body(f) && be.takes_lambda(c)
}

takes_lambda* = (be: CBackend, c: Call) bool {
    got ::= false;
    c.args.loop((h, a) {
        got = got || be.is_lambda(a.value);
    });
    got
}

is_lambda* = (be: CBackend, id: ExprId) bool {
    be.tree.expr_at(id).kind.match({ Lambda(_) => true, _ => false })
}

// A function that takes a body is NEVER emitted: a `(v: T) bool`
// parameter has no C spelling, so there is no symbol to write and no
// way to pass one — it exists only inlined at its call sites, which is
// what `loop_iter.zen`'s no-closure-record claim means for a function
// that is not `loop`.
takes_closure* = (be: CBackend, f: Function) bool {
    got ::= false;
    f.params.loop((h, p) { got = got || be.param_is_fn(p); });
    got
}

param_is_fn = (be: CBackend, p: Param) bool {
    p.type.match({ Ok(t) => be.type_is_fn(t), None => false })
}

type_is_fn = (be: CBackend, t: TypeId) bool {
    be.tree.type_at(t).kind.match({ Fn(_) => true, _ => false })
}

closure_slot* = (be :: CBackend, name: str) Res<LocalSlot> {
    be.slot_of(name).match({
        Ok(s) => keep_closure(s),
        None  => None,
    })
}

keep_closure = (s: LocalSlot) Res<LocalSlot> {
    (s.closure > 0).match({ true => Ok(s), false => None })
}

// -----------------------------------------------------------------
// inlining a callee: a free function, or one reached through ufcs
// -----------------------------------------------------------------

inline_call* = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    d    : Def,
    f    : Function,
    recv : Res<ExprId>,
    ctx  : Ctx,
    out  :: String
)
               Res<(), AllocError> {
    (be.depth > INLINE_DEPTH).match({
        true  => be.unsupported(id, "an inlining that does not terminate", out),
        false => be.inline_free(id, c, d, f, recv, ctx, out),
    })
}

inline_free = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    d    : Def,
    f    : Function,
    recv : Res<ExprId>,
    ctx  : Ctx,
    out  :: String
)
              Res<(), AllocError> {
    mi   = d.id.module.to_usize();
    dctx = be.plain_ctx(mi);
    raw  = be.inst_at(id).try();
    inst = be.settled_inst(f.tparams, d.qname, raw).try();
    mark = be.enter_tparams(f.tparams, d.qname).try();
    argv ::= be.alloc.Vec<ExprId>();
    be.arguments(c, recv, argv).try();
    raws ::= be.alloc.Vec<TyId>();
    be.param_types(f, dctx, inst, raws).try();
    extra ::= be.alloc.Inst();
    be.call_bindings(argv, raws, ctx, extra).try();
    ret  = be.inline_ret(f, dctx, inst, extra, argv, ctx).try();
    full = be.compose(inst, extra).try();
    ptys ::= be.alloc.Vec<TyId>();
    be.settle_params(raws, extra, ptys).try();
    bctx = body_ctx(be, mi, ret);
    be.run_called_body(id, f, argv, ptys, ret, bctx, full, ctx, out).try();
    be.leave_tparams(mark).try();
    Ok(());
}

// -----------------------------------------------------------------
// inlining a member
//
// A method is an ordinary function whose first parameter is the
// receiver, so this is the same shape with `@Self` bound and the TYPE's
// parameters in scope rather than the function's own.
// -----------------------------------------------------------------

inline_method* = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    a    : Access,
    rty  : TyId,
    decl : DeclId,
    f    : Function,
    ctx  : Ctx,
    out  :: String
)
                 Res<(), AllocError> {
    (be.depth > INLINE_DEPTH).match({
        true  => be.unsupported(id, "an inlining that does not terminate", out),
        false => be.inline_member(id, c, a, rty, decl, f, ctx, out),
    })
}

inline_member = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    a    : Access,
    rty  : TyId,
    decl : DeclId,
    f    : Function,
    ctx  : Ctx,
    out  :: String
)
                Res<(), AllocError> {
    mi   = decl.module.to_usize();
    sctx = be.check.self_ctx(mi, rty).try();
    inst = be.recv_inst(rty).try();
    mark = be.enter_struct_tparams(decl).try();
    argv ::= be.alloc.Vec<ExprId>();
    be.arguments(c, Ok(a.base), argv).try();
    raws ::= be.alloc.Vec<TyId>();
    be.param_types(f, sctx, inst, raws).try();
    extra ::= be.alloc.Inst();
    be.call_bindings(argv, raws, ctx, extra).try();
    ret  = be.inline_ret(f, sctx, inst, extra, argv, ctx).try();
    full = be.compose(inst, extra).try();
    ptys ::= be.alloc.Vec<TyId>();
    be.settle_params(raws, extra, ptys).try();
    bctx = be.self_body_ctx(mi, ret, rty, true);
    be.run_called_body(id, f, argv, ptys, ret, bctx, full, ctx, out).try();
    be.leave_tparams(mark).try();
    Ok(());
}

// -----------------------------------------------------------------
// the body, in the caller's frame
// -----------------------------------------------------------------

// The CALLED body -- a function lowered into the frame of the call that
// invoked it. gen_c_loop.zen's run_body runs a LOOP body's lambda
// instead; Zen has no overloading, so the two cannot share a name.
run_called_body = (
    be   :: CBackend,
    id   : ExprId,
    f    : Function,
    argv : Vec<ExprId>,
    ptys : Vec<TyId>,
    ret  : TyId,
    bctx : Ctx,
    inst : Inst,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    has_var(be.check, ret).match({
        true  => be.unsupported(
            id,
            "a generic call whose type arguments nothing settles",
            out
        ),
        false => be.run_settled(f, argv, ptys, ret, bctx, inst, ctx, out),
    })
}

run_settled = (
    be   :: CBackend,
    f    : Function,
    argv : Vec<ExprId>,
    ptys : Vec<TyId>,
    ret  : TyId,
    bctx : Ctx,
    inst : Inst,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    f.body.match({
        Ok(blk) => be.run_block(f, blk, argv, ptys, ret, bctx, inst, ctx, out),
        None    => out.add_bytes("0"),
    })
}

run_block = (
    be   :: CBackend,
    f    : Function,
    blk  : BlockId,
    argv : Vec<ExprId>,
    ptys : Vec<TyId>,
    ret  : TyId,
    bctx : Ctx,
    inst : Inst,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    result ::= be.alloc.String().try();
    keeps = wants_value(be, ret);
    keeps.match({
        true  => be.open_temp(ret, result),
        false => Ok(()),
    }).try();

    // the parameters go in ABOVE the caller's frame, and a closure
    // remembers where that frame ended so its own body can go back
    lmark = be.mark();
    cmark = be.check.mark();
    bind_params(be, f, argv, ptys, lmark, cmark, ctx).try();

    held = be.inst;
    be.enter_inst(inst);
    // THE CALLEE'S BODY BEGINS ABOVE THE CALLER'S BINDINGS. Its own
    // `x = ..` is a declaration however many `x`es the caller has.
    floor = be.floor;
    be.enter_frame(lmark);
    be.enter_call();
    block(be, blk, bctx, ret, dest_of(keeps, result.view())).try();
    be.leave_call();
    be.enter_frame(floor);
    be.enter_inst(held);

    be.release(lmark).try();
    be.check.release(cmark).try();
    be.write_result(keeps, result.view(), out)
}

// A call with no storage still writes SOMETHING where the expression
// goes, or the `(void)(..)` a discarded statement wraps it in does not
// parse — the same `0` the four report helpers write.
write_result = (be :: CBackend, keeps: bool, result: str, out :: String)
               Res<(), AllocError> {
    keeps.match({
        true  => out.add_bytes(result),
        false => out.add_bytes("0"),
    })
}

dest_of = (keeps: bool, result: str) Dest {
    keeps.match({ true => Dest.Into(result), false => Dest.Discard })
}

wants_value = (be :: CBackend, ret: TyId) bool {
    (be.is_unit(ret) == false) && (be.check.is_unknown(ret) == false)
        && (has_var(be.check, ret) == false)
}

open_temp = (be :: CBackend, ret: TyId, result :: String)
            Res<(), AllocError> {
    sym_gen(result, "n", be.next_tmp()).try();
    line ::= be.alloc.String().try();
    be.declarator(ret, result.view(), line).try();
    be.fmt("{};\n", line.view())
}

bind_params = (
    be    :: CBackend,
    f     : Function,
    argv  : Vec<ExprId>,
    ptys  : Vec<TyId>,
    home  : usize,
    chome : usize,
    ctx   : Ctx
)
              Res<(), AllocError> {
    Range(0, f.params.len).loop((h, i) {
        bind_param(be, f, argv, ptys, i, home, chome, ctx).try();
    });
    Ok(());
}

bind_param = (
    be    :: CBackend,
    f     : Function,
    argv  : Vec<ExprId>,
    ptys  : Vec<TyId>,
    i     : usize,
    home  : usize,
    chome : usize,
    ctx   : Ctx
) Res<(), AllocError> {
    f.params.get(i).match({
        Ok(p) => be.bind_valued(p, argv, ptys, i, home, chome, ctx),
        None  => Ok(()),
    })
}

bind_valued = (
    be    :: CBackend,
    p     : Param,
    argv  : Vec<ExprId>,
    ptys  : Vec<TyId>,
    i     : usize,
    home  : usize,
    chome : usize,
    ctx   : Ctx
) Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    pty     = ptys.get(i).match({ Ok(t) => t, None => unknown });
    argv.get(i).match({
        Ok(v) => be.bind_one(p, v, pty, home, chome, ctx),
        None  => Ok(()),
    })
}

bind_one = (
    be    :: CBackend,
    p     : Param,
    value : ExprId,
    pty   : TyId,
    home  : usize,
    chome : usize,
    ctx   : Ctx
) Res<(), AllocError> {
    be.tree.expr_at(value).kind.match({
        Lambda(l) => be.bind_closure(p, l, pty, home, chome, ctx),
        _         => be.bind_value(p, value, pty, ctx),
    })
}

// A lambda gets no C storage and no declaration: what the name means is
// a body, and the frame it was written in.
bind_closure = (
    be    :: CBackend,
    p     : Param,
    l     : Lambda,
    pty   : TyId,
    home  : usize,
    chome : usize,
    ctx   : Ctx
) Res<(), AllocError> {
    ptys ::= be.alloc.Vec<TyId>();
    ret = be.fn_parts(pty, ptys).try();
    be.declare_closure(
        p.name.text,
        Closure(
            lam: l,
            ptys: ptys,
            ret: ret,
            home: home,
            check_home: chome,
            floor: be.floor,
            inst: be.inst,
            ctx: ctx
        )
    )
}

fn_parts = (be :: CBackend, pty: TyId, ptys :: Vec<TyId>)
           Res<TyId, AllocError> {
    be.check.types.at(pty).match({
        Fn(ft) => copy_fn_types(ft, ptys),
        _      => be.check.types.unknown(),
    })
}

copy_fn_types = (ft: TyFn, ptys :: Vec<TyId>) Res<TyId, AllocError> {
    ft.params.loop((h, t) { ptys.add(t).try() });
    Ok(ft.ret);
}

// AN ORDINARY ARGUMENT CROSSES A BOUNDARY HERE exactly as it does at a
// real call, so it is lowered in the CALLER's frame — before the
// parameter's own name can shadow anything it reads — and then declared.
bind_value = (be :: CBackend, p: Param, value: ExprId, pty: TyId, ctx: Ctx)
             Res<(), AllocError> {
    text ::= be.alloc.String().try();
    p.mutable.match({
        true  => be.write_address(value, ctx, pty, text),
        false => expr(be, value, ctx, pty, text),
    }).try();
    n = be.declare(p.name.text, pty, p.mutable).try();
    be.check.bind(p.name.text, pty, p.mutable, true).try();
    cname ::= be.alloc.String().try();
    sym_local(cname, p.name.text, n).try();
    line ::= be.alloc.String().try();
    p.mutable.match({
        true  => be.ref_declarator(pty, cname.view(), line),
        false => be.declarator(pty, cname.view(), line),
    }).try();
    be.fmt("{} = {};\n", line.view(), text.view())
}

// -----------------------------------------------------------------
// calling a closure
//
// The other half: a name bound to a lambda, called. The arguments are
// written WHERE THE CALL IS, so they are lowered before the frame moves
// and both scope stacks rewind (the hygiene the header argues for).
// -----------------------------------------------------------------

lower_closure_call* = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    s    : LocalSlot,
    ctx  : Ctx,
    want : TyId,
    out  :: String
)
                      Res<(), AllocError> {
    be.closure_at(s.closure).match({
        Ok(cl) => be.run_closure(id, c, cl, ctx, want, out),
        None   => unresolved(be, id, s.name, out),
    })
}

run_closure = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    cl   : Closure,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    (be.depth > INLINE_DEPTH).match({
        true  => be.unsupported(id, "an inlining that does not terminate", out),
        false => be.run_lambda(c, cl, ctx, want, out),
    })
}

run_lambda = (
    be   :: CBackend,
    c    : Call,
    cl   : Closure,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    argt ::= be.alloc.Vec<String>();
    hnd  ::= be.alloc.Vec<usize>();
    be.lower_args(c, cl, ctx, argt, hnd).try();

    ret = be.closure_ret(cl, want).try();
    result ::= be.alloc.String().try();
    keeps = wants_value(be, ret);
    keeps.match({
        true  => be.open_temp(ret, result),
        false => Ok(()),
    }).try();

    saved ::= be.alloc.Vec<LocalSlot>();
    be.detach(cl.home, saved).try();
    csaved ::= be.alloc.Vec<Binding>();
    be.check.detach_locals(cl.check_home, csaved).try();
    held = be.inst;
    be.enter_inst(cl.inst);

    lmark = be.mark();
    cmark = be.check.mark();
    be.bind_lambda_params(cl, argt, hnd).try();
    // BACK TO THE FRAME THE LAMBDA WAS WRITTEN IN, floor included: a
    // lambda's `x = ..` on a name its own writer had already bound is
    // that writer's store, exactly as it reads on the page.
    floor = be.floor;
    be.enter_frame(cl.floor);
    be.enter_call();
    block(be, cl.lam.body, cl.ctx, ret, dest_of(keeps, result.view())).try();
    be.leave_call();
    be.enter_frame(floor);
    be.release(lmark).try();
    be.check.release(cmark).try();

    be.enter_inst(held);
    be.check.reattach_locals(csaved).try();
    be.reattach(saved).try();
    be.write_result(keeps, result.view(), out)
}

// The closure's declared return type, or the expectation at the call
// when the declaration left it open. `then`'s `f: () T` is the second
// case: `T` is settled by the lambda's own body, and the payload the
// result is being written into is where that answer arrives.
closure_ret = (be :: CBackend, cl: Closure, want: TyId)
              Res<TyId, AllocError> {
    settled(be, cl.ret).match({
        true  => Ok(cl.ret),
        false => be.want_or_unit(want),
    })
}

want_or_unit = (be :: CBackend, want: TyId) Res<TyId, AllocError> {
    settled(be, want).match({
        true  => Ok(want),
        false => be.check.types.prim("()"),
    })
}

lower_args = (
    be   :: CBackend,
    c    : Call,
    cl   : Closure,
    ctx  : Ctx,
    argt :: Vec<String>,
    hnd  :: Vec<usize>
) Res<(), AllocError> {
    Range(0, c.args.len).loop((h, i) {
        be.lower_one_arg(c, cl, i, ctx, argt, hnd).try();
    });
    Ok(());
}

lower_one_arg = (
    be   :: CBackend,
    c    : Call,
    cl   : Closure,
    i    : usize,
    ctx  : Ctx,
    argt :: Vec<String>,
    hnd  :: Vec<usize>
)
                Res<(), AllocError> {
    c.args.get(i).match({
        Ok(a) => be.lower_arg_value(a.value, cl, i, ctx, argt, hnd),
        None  => Ok(()),
    })
}

// A HANDLE PASSED ON IS NOT A VALUE COPIED. `map`'s own body is
// `made.add(body(h, index, value))` — the handle it hands the caller's
// closure is the loop it's walking, so `h.break(..)` in that closure
// stops THIS loop (the early exit `loop_find.zen` documents). A
// `LoopHandle` has no C storage (two labels and a depth), so the
// argument is read as the loop it names, here, while that loop is
// still the innermost one in scope.
lower_arg_value = (
    be    :: CBackend,
    value : ExprId,
    cl    : Closure,
    i     : usize,
    ctx   : Ctx,
    argt  :: Vec<String>,
    hnd   :: Vec<usize>
)
                  Res<(), AllocError> {
    depth = be.handle_depth(value);
    hnd.add(depth).try();
    unknown = be.check.types.unknown().try();
    want    = cl.ptys.get(i).match({ Ok(t) => t, None => unknown });
    text ::= be.alloc.String().try();
    (depth == 0).match({
        true  => expr(be, value, ctx, want, text),
        false => Ok(()),
    }).try();
    argt.add(text)
}

bind_lambda_params = (
    be   :: CBackend,
    cl   : Closure,
    argt : Vec<String>,
    hnd  : Vec<usize>
) Res<(), AllocError> {
    Range(0, cl.lam.params.len).loop((h, i) {
        be.bind_lambda_param(cl, argt, hnd, i).try();
    });
    Ok(());
}

bind_lambda_param = (
    be   :: CBackend,
    cl   : Closure,
    argt : Vec<String>,
    hnd  : Vec<usize>,
    i    : usize
) Res<(), AllocError> {
    cl.lam.params.get(i).match({
        Ok(p) => be.bind_lambda_named(cl, argt, hnd, i, p),
        None  => Ok(()),
    })
}

bind_lambda_named = (
    be   :: CBackend,
    cl   : Closure,
    argt : Vec<String>,
    hnd  : Vec<usize>,
    i    : usize,
    p    : Param
)
                    Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    ty      = cl.ptys.get(i).match({ Ok(t) => t, None => unknown });
    depth   = hnd.get(i).match({ Ok(d) => d, None => 0 });
    (depth == 0).match({
        false => be.bind_passed_handle(p, ty, depth),
        true  => be.bind_copied_arg(argt, i, p, ty),
    })
}

bind_passed_handle = (be :: CBackend, p: Param, ty: TyId, depth: usize)
                     Res<(), AllocError> {
    be.declare_handle(p.name.text, ty, depth).try();
    be.check.bind(p.name.text, ty, false, true).try();
    Ok(());
}

bind_copied_arg = (
    be   :: CBackend,
    argt : Vec<String>,
    i    : usize,
    p    : Param,
    ty   : TyId
) Res<(), AllocError> {
    argt.get(i).match({
        Ok(s) => be.declare_bound(p, ty, s.view()),
        None  => Ok(()),
    })
}

declare_bound = (be :: CBackend, p: Param, ty: TyId, text: str)
                Res<(), AllocError> {
    n = be.declare(p.name.text, ty, false).try();
    be.check.bind(p.name.text, ty, false, true).try();
    cname ::= be.alloc.String().try();
    sym_local(cname, p.name.text, n).try();
    line ::= be.alloc.String().try();
    be.declarator(ty, cname.view(), line).try();
    be.fmt("{} = {text};\n", line.view())
}

// What an inlined call evaluates to: `gen_c_settle.zen`, `inline_ret`.
