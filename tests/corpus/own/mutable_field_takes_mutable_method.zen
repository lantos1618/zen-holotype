// the accept side of immutable_receiver_field.zen. `items` is `::`,
// so it is storage the Bag admits it rewrites, and a `::` method
// through it is legal — as long as the Bag binding is `::` too.
//
// mutability composes down the path: every link from the binding to
// the receiver has to permit the write, and here every link does.

Bag = {
    items :: Vec<i32>,

    fill* = (self :: @Self, n: i32) Res<(), AllocError> {
        self.items.add(n).try();
        Ok(());
    }
}

Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    alloc ::= env.mem.alloc();
    b ::= Bag(items: alloc.Vec<i32>());
    b.items.add(1).try();
    b.fill(2).try();
    b.items.get(1).match({
        Ok(n) => println("{}", n),
        None  => println("empty"),
    })
    Ok(0);
}
