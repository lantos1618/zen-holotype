// compiler.backend.js.js_dom — std.web.dom lowering for the JavaScript backend: DOM stub CALLS → real browser
// JS. Extracted from compiler.backend.js.js. Entered from js_call_intr2 (compiler.backend.js.js_expr) after the intrinsic
// tiers, and falls through to an ordinary JS call for every non-DOM name, so emission is byte-identical
// for programs that never touch the DOM — the change is purely additive.
{ String } = std.text.string
{ CallData, gstr_append } = compiler.genc
{ Malloc } = std.mem.alloc
{ jname } = compiler.backend.js.js_lit
{ js_arg_at, js_args } = compiler.backend.js.js_expr
js_call_raw = (s: String, a: MutPtr<Malloc>, c: CallData) String {
    s
        .jname(a, c.fn)
        .gstr_append(a, "(")
        .js_args(a, c.args)
        .gstr_append(a, ")")
}
// std.sys.platform's bodyless host floor is generated by each backend, never supplied by zenrt.
js_call_default = (s: String, a: MutPtr<Malloc>, c: CallData) String {
    (c.fn == "zen_platform_host_os").match ({
        true  => s.gstr_append(a, "((typeof process !== 'undefined' && process.platform === 'darwin') ? 1 : (typeof process !== 'undefined' && process.platform === 'linux') ? 2 : (typeof process !== 'undefined' && process.platform === 'win32') ? 3 : 0)"),
        false => (c.fn == "zen_platform_host_arch").match ({
            true  => s.gstr_append(a, "((typeof process !== 'undefined' && process.arch === 'arm64') ? 1 : (typeof process !== 'undefined' && process.arch === 'x64') ? 2 : 0)"),
            false => (c.fn == "zen_platform_host_abi").match ({
                true  => s.gstr_append(a, "((typeof process !== 'undefined' && process.platform === 'darwin') ? 1 : (typeof process !== 'undefined' && process.platform === 'linux') ? 2 : (typeof process !== 'undefined' && process.platform === 'win32') ? 4 : 0)"),
                false => s.js_call_raw(a, c),
            }),
        }),
    })
}
// ── std.web.dom lowering: DOM stub CALLS → real browser JS ────────────────────────────────────────
// dom.zen is the JS-target analog of std.c.libc: a header of BODYLESS typed stubs. genc lowers a
// bodyless decl to a C prototype that libc defines; js lowers the CALL to the live browser API —
// `create_element(doc, "div")` → `doc.createElement("div")`, `set_text_content(n, s)` → `n.textContent = s`.
// The map below is a NAME table (snake_case Zen stub → camelCase JS member). It runs AFTER the intrinsic
// tiers (so it only sees non-intrinsic calls) and FALLS THROUGH to an ordinary JS call for every non-DOM
// name (js_call_default), so emission is byte-identical for programs that never touch the DOM — the
// change is purely additive. Design: an interface handle (`{ handle }`) is a JS object ref, passed through
// as identity (like MutPtr<Struct>); upcast stubs (`as_node`, …) lower to that identity; a global singleton
// accessor (`document()`) lowers to the bare global; a Zen `str` argument is decoded to a real JS string
// via `__zr.jstr` (MEM offset → JS string) at the API boundary. Receiver is arg0; extra args follow.
js_dom_recv = (s: String, a: MutPtr<Malloc>, c: CallData) String { s.js_arg_at(a, c, 0) }
js_dom_str = (s: String, a: MutPtr<Malloc>, c: CallData, i: i32) String {
    s.gstr_append(a, "__zr.jstr(").js_arg_at(a, c, i).gstr_append(a, ")")
}
js_dmeth = (s: String, a: MutPtr<Malloc>, c: CallData, m: string_view) String {
    s.js_dom_recv(a, c).gstr_append(a, ".").gstr_append(a, m)
}
// emit shapes: method with 0 args / one str arg / one passthrough arg / two str / str+passthrough / two passthrough.
js_dm0 = (s: String, a: MutPtr<Malloc>, c: CallData, m: string_view) String {
    s.js_dmeth(a, c, m).gstr_append(a, "()")
}
js_dm_s = (s: String, a: MutPtr<Malloc>, c: CallData, m: string_view) String {
    s
        .js_dmeth(a, c, m)
        .gstr_append(a, "(")
        .js_dom_str(a, c, 1)
        .gstr_append(a, ")")
}
js_dm_p = (s: String, a: MutPtr<Malloc>, c: CallData, m: string_view) String {
    s
        .js_dmeth(a, c, m)
        .gstr_append(a, "(")
        .js_arg_at(a, c, 1)
        .gstr_append(a, ")")
}
js_dm_ss = (s: String, a: MutPtr<Malloc>, c: CallData, m: string_view) String {
    s
        .js_dmeth(a, c, m)
        .gstr_append(a, "(")
        .js_dom_str(a, c, 1)
        .gstr_append(a, ", ")
        .js_dom_str(a, c, 2)
        .gstr_append(a, ")")
}
js_dm_sp = (s: String, a: MutPtr<Malloc>, c: CallData, m: string_view) String {
    s
        .js_dmeth(a, c, m)
        .gstr_append(a, "(")
        .js_dom_str(a, c, 1)
        .gstr_append(a, ", ")
        .js_arg_at(a, c, 2)
        .gstr_append(a, ")")
}
js_dm_pp = (s: String, a: MutPtr<Malloc>, c: CallData, m: string_view) String {
    s
        .js_dmeth(a, c, m)
        .gstr_append(a, "(")
        .js_arg_at(a, c, 1)
        .gstr_append(a, ", ")
        .js_arg_at(a, c, 2)
        .gstr_append(a, ")")
}
// emit shapes: property read / property write (str value) / property write (passthrough value).
js_dp = (s: String, a: MutPtr<Malloc>, c: CallData, p: string_view) String { s.js_dmeth(a, c, p) }
js_dw_s = (s: String, a: MutPtr<Malloc>, c: CallData, p: string_view) String {
    s.js_dmeth(a, c, p).gstr_append(a, " = ").js_dom_str(a, c, 1)
}
js_dw_p = (s: String, a: MutPtr<Malloc>, c: CallData, p: string_view) String {
    s.js_dmeth(a, c, p).gstr_append(a, " = ").js_arg_at(a, c, 1)
}
// emit shapes: bare global singleton / identity upcast (arg0 passthrough) / receiver-less global `fetch(str)`.
js_dg = (s: String, a: MutPtr<Malloc>, name: string_view) String { s.gstr_append(a, name) }
js_did = (s: String, a: MutPtr<Malloc>, c: CallData) String { s.js_dom_recv(a, c) }
js_dfetch = (s: String, a: MutPtr<Malloc>, c: CallData) String {
    s.gstr_append(a, "fetch(").js_dom_str(a, c, 0).gstr_append(a, ")")
}
// tier 1 — JS global singletons (`document()`→`document`), the receiver-less `fetch`, and the inheritance
// upcasts (each an identity: in JS an Element already IS a Node/EventTarget).
js_dom_dispatch* = (s: String, a: MutPtr<Malloc>, c: CallData) String {
    (c.fn == "document").match ({
        true  => s.js_dg(a, "document"),
        false => (c.fn == "window").match ({
            true  => s.js_dg(a, "window"),
            false => (c.fn == "console").match ({
                true  => s.js_dg(a, "console"),
                false => (c.fn == "fetch").match ({
                    true  => s.js_dfetch(a, c),
                    false => (c.fn == "node_target").match ({
                        true  => s.js_did(a, c),
                        false => (c.fn == "as_node").match ({
                            true  => s.js_did(a, c),
                            false => (c.fn == "as_event_target").match ({
                                true  => s.js_did(a, c),
                                false => (c.fn == "as_element").match ({
                                    true  => s.js_did(a, c),
                                    false => (c.fn == "text_node").match ({
                                        true  => s.js_did(a, c),
                                        false => (c.fn == "document_node").match ({
                                            true  => s.js_did(a, c),
                                            false => (c.fn == "window_target").match ({
                                                true  => s.js_did(a, c),
                                                false => (c.fn == "as_html").match ({
                                                    true  => s.js_did(a, c),
                                                    false => s.js_dom_d2(a, c),
                                                }),
                                            }),
                                        }),
                                    }),
                                }),
                            }),
                        }),
                    }),
                }),
            }),
        }),
    })
}
// tier 2 — EventTarget + Event.
js_dom_d2 = (s: String, a: MutPtr<Malloc>, c: CallData) String {
    (c.fn == "add_event_listener").match ({
        true  => s.js_dm_sp(a, c, "addEventListener"),
        false => (c.fn == "remove_event_listener").match ({
            true  => s.js_dm_sp(a, c, "removeEventListener"),
            false => (c.fn == "dispatch_event").match ({
                true  => s.js_dm_p(a, c, "dispatchEvent"),
                false => (c.fn == "event_type").match ({
                    true  => s.js_dp(a, c, "type"),
                    false => (c.fn == "event_target").match ({
                        true  => s.js_dp(a, c, "target"),
                        false => (c.fn == "current_target").match ({
                            true  => s.js_dp(a, c, "currentTarget"),
                            false => (c.fn == "prevent_default").match ({
                                true  => s.js_dm0(a, c, "preventDefault"),
                                false => (c.fn == "stop_propagation").match ({
                                    true  => s.js_dm0(a, c, "stopPropagation"),
                                    false => s.js_dom_d3(a, c),
                                }),
                            }),
                        }),
                    }),
                }),
            }),
        }),
    })
}
// tier 3 — Node.
js_dom_d3 = (s: String, a: MutPtr<Malloc>, c: CallData) String {
    (c.fn == "append_child").match ({
        true  => s.js_dm_p(a, c, "appendChild"),
        false => (c.fn == "remove_child").match ({
            true  => s.js_dm_p(a, c, "removeChild"),
            false => (c.fn == "insert_before").match ({
                true  => s.js_dm_pp(a, c, "insertBefore"),
                false => (c.fn == "replace_child").match ({
                    true  => s.js_dm_pp(a, c, "replaceChild"),
                    false => (c.fn == "clone_node").match ({
                        true  => s.js_dm_p(a, c, "cloneNode"),
                        false => (c.fn == "parent_node").match ({
                            true  => s.js_dp(a, c, "parentNode"),
                            false => (c.fn == "first_child").match ({
                                true  => s.js_dp(a, c, "firstChild"),
                                false => (c.fn == "next_sibling").match ({
                                    true  => s.js_dp(a, c, "nextSibling"),
                                    false => (c.fn == "child_nodes").match ({
                                        true  => s.js_dp(a, c, "childNodes"),
                                        false => (c.fn == "text_content").match ({
                                            true  => s.js_dp(a, c, "textContent"),
                                            false => (c.fn == "set_text_content").match ({
                                                true  => s.js_dw_s(a, c, "textContent"),
                                                false => s.js_dom_d4(a, c),
                                            }),
                                        }),
                                    }),
                                }),
                            }),
                        }),
                    }),
                }),
            }),
        }),
    })
}
// tier 4 — Element (part 1).
js_dom_d4 = (s: String, a: MutPtr<Malloc>, c: CallData) String {
    (c.fn == "element_id").match ({
        true  => s.js_dp(a, c, "id"),
        false => (c.fn == "set_id").match ({
            true  => s.js_dw_s(a, c, "id"),
            false => (c.fn == "tag_name").match ({
                true  => s.js_dp(a, c, "tagName"),
                false => (c.fn == "class_name").match ({
                    true  => s.js_dp(a, c, "className"),
                    false => (c.fn == "set_class_name").match ({
                        true  => s.js_dw_s(a, c, "className"),
                        false => (c.fn == "inner_html").match ({
                            true  => s.js_dp(a, c, "innerHTML"),
                            false => (c.fn == "set_inner_html").match ({
                                true  => s.js_dw_s(a, c, "innerHTML"),
                                false => (c.fn == "get_attribute").match ({
                                    true  => s.js_dm_s(a, c, "getAttribute"),
                                    false => (c.fn == "set_attribute").match ({
                                        true  => s.js_dm_ss(a, c, "setAttribute"),
                                        false => (c.fn == "remove_attribute").match ({
                                            true  => s.js_dm_s(a, c, "removeAttribute"),
                                            false => s.js_dom_d5(a, c),
                                        }),
                                    }),
                                }),
                            }),
                        }),
                    }),
                }),
            }),
        }),
    })
}
// tier 5 — Element (part 2) + HTMLElement.
js_dom_d5 = (s: String, a: MutPtr<Malloc>, c: CallData) String {
    (c.fn == "has_attribute").match ({
        true  => s.js_dm_s(a, c, "hasAttribute"),
        false => (c.fn == "class_list").match ({
            true  => s.js_dp(a, c, "classList"),
            false => (c.fn == "query_selector").match ({
                true  => s.js_dm_s(a, c, "querySelector"),
                false => (c.fn == "query_selector_all").match ({
                    true  => s.js_dm_s(a, c, "querySelectorAll"),
                    false => (c.fn == "remove").match ({
                        true  => s.js_dm0(a, c, "remove"),
                        false => (c.fn == "style").match ({
                            true  => s.js_dp(a, c, "style"),
                            false => (c.fn == "hidden").match ({
                                true  => s.js_dp(a, c, "hidden"),
                                false => (c.fn == "set_hidden").match ({
                                    true  => s.js_dw_p(a, c, "hidden"),
                                    false => (c.fn == "click").match ({
                                        true  => s.js_dm0(a, c, "click"),
                                        false => (c.fn == "focus").match ({
                                            true  => s.js_dm0(a, c, "focus"),
                                            false => (c.fn == "blur").match ({
                                                true  => s.js_dm0(a, c, "blur"),
                                                false => s.js_dom_d6(a, c),
                                            }),
                                        }),
                                    }),
                                }),
                            }),
                        }),
                    }),
                }),
            }),
        }),
    })
}
// tier 6 — DOMTokenList + CSSStyleDeclaration + NodeList.
js_dom_d6 = (s: String, a: MutPtr<Malloc>, c: CallData) String {
    (c.fn == "class_add").match ({
        true  => s.js_dm_s(a, c, "add"),
        false => (c.fn == "class_remove").match ({
            true  => s.js_dm_s(a, c, "remove"),
            false => (c.fn == "class_toggle").match ({
                true  => s.js_dm_s(a, c, "toggle"),
                false => (c.fn == "class_contains").match ({
                    true  => s.js_dm_s(a, c, "contains"),
                    false => (c.fn == "set_property").match ({
                        true  => s.js_dm_ss(a, c, "setProperty"),
                        false => (c.fn == "get_property").match ({
                            true  => s.js_dm_s(a, c, "getPropertyValue"),
                            false => (c.fn == "remove_property").match ({
                                true  => s.js_dm_s(a, c, "removeProperty"),
                                false => (c.fn == "node_list_length").match ({
                                    true  => s.js_dp(a, c, "length"),
                                    false => (c.fn == "node_list_item").match ({
                                        true  => s.js_dm_p(a, c, "item"),
                                        false => s.js_dom_d7(a, c),
                                    }),
                                }),
                            }),
                        }),
                    }),
                }),
            }),
        }),
    })
}
// tier 7 — Document.
js_dom_d7 = (s: String, a: MutPtr<Malloc>, c: CallData) String {
    (c.fn == "get_element_by_id").match ({
        true  => s.js_dm_s(a, c, "getElementById"),
        false => (c.fn == "document_query_selector").match ({
            true  => s.js_dm_s(a, c, "querySelector"),
            false => (c.fn == "document_query_selector_all").match ({
                true  => s.js_dm_s(a, c, "querySelectorAll"),
                false => (c.fn == "create_element").match ({
                    true  => s.js_dm_s(a, c, "createElement"),
                    false => (c.fn == "create_text_node").match ({
                        true  => s.js_dm_s(a, c, "createTextNode"),
                        false => (c.fn == "body").match ({
                            true  => s.js_dp(a, c, "body"),
                            false => (c.fn == "head").match ({
                                true  => s.js_dp(a, c, "head"),
                                false => s.js_dom_d8(a, c),
                            }),
                        }),
                    }),
                }),
            }),
        }),
    })
}
// tier 8 — Window.
js_dom_d8 = (s: String, a: MutPtr<Malloc>, c: CallData) String {
    (c.fn == "alert").match ({
        true  => s.js_dm_s(a, c, "alert"),
        false => (c.fn == "window_document").match ({
            true  => s.js_dp(a, c, "document"),
            false => (c.fn == "location").match ({
                true  => s.js_dp(a, c, "location"),
                false => (c.fn == "set_timeout").match ({
                    true  => s.js_dm_pp(a, c, "setTimeout"),
                    false => (c.fn == "clear_timeout").match ({
                        true  => s.js_dm_p(a, c, "clearTimeout"),
                        false => (c.fn == "request_animation_frame").match ({
                            true  => s.js_dm_p(a, c, "requestAnimationFrame"),
                            false => s.js_dom_d9(a, c),
                        }),
                    }),
                }),
            }),
        }),
    })
}
// tier 9 — Location + Console. Final fall-through: an ordinary JS call (non-DOM name → unchanged emission).
js_dom_d9 = (s: String, a: MutPtr<Malloc>, c: CallData) String {
    (c.fn == "href").match ({
        true  => s.js_dp(a, c, "href"),
        false => (c.fn == "set_href").match ({
            true  => s.js_dw_s(a, c, "href"),
            false => (c.fn == "reload").match ({
                true  => s.js_dm0(a, c, "reload"),
                false => (c.fn == "log").match ({
                    true  => s.js_dm_s(a, c, "log"),
                    false => (c.fn == "error").match ({
                        true  => s.js_dm_s(a, c, "error"),
                        false => (c.fn == "warn").match ({
                            true  => s.js_dm_s(a, c, "warn"),
                            false => (c.fn == "info").match ({
                                true  => s.js_dm_s(a, c, "info"),
                                false => s.js_call_default(a, c),
                            }),
                        }),
                    }),
                }),
            }),
        }),
    })
}
