// THE FIELD READING OF `.len` KEEPS FILLING ARGUMENT SLOTS. Issue #772
// refused a BARE METHOD (`String.len`, type `(String) usize`) precisely
// because `Vec.len` — same spelling, a genuine usize FIELD — made the
// slot look satisfiable. `v.len` below is the field: it never was a
// function, so the #772 rule must not touch it, and this is the guard
// that says so. A fix that refuses fields too turns this red while
// every must-fail stays green.

Error = AllocError

main = (env: Env) Res<i32, Error> {
    a ::= env.mem.alloc();
    v ::= a.Vec<i32>();
    v.add(10).try();
    v.add(20).try();
    v.add(30).try();
    n ::= 0;
    Range(0, v.len).loop((h, i) { n = n + 1; });
    println("iterations={}", n);
    Ok(0);
}
