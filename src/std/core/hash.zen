// Hashing for keyed collections. A hash narrows the search; Eq confirms keys
// that collide.
//
// nothing is imported or impl'd here: a trait sits BELOW the types
// that satisfy it, so an impl lives with the type — str's impl beside
// Hash would make std.core depend on std.text and invert the module graph

// Fixed parameters keep iteration and generated output deterministic.
HASH_SEED: u64 = 5381
HASH_MULT: u64 = 1000003

Hasher* = {
    state :: u64 = HASH_SEED,

    write_u8* = (self :: @Self, byte: u8) () {
        self.state = self.state *% HASH_MULT +% byte.to_u64();
    }

    write_u64* = (self :: @Self, value: u64) () {
        self.state = self.state *% HASH_MULT +% value;
    }

    finish* = (self: @Self) u64 {
        self.state
    }
}

Hash* = {
    // The hasher is scratch, so implementations return the finished value.
    hash* = (self: @Self, hasher :: Hasher) u64
}
