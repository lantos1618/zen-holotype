// Converts semantic-checker memos into token classifications without running
// another name-resolution pass.

str = std.text
Alloc, AllocError = std.mem
Vec = std.collections
Range = std.core
Ast, Module, Decl, Block = std.ast
Struct, Enum, Alias, Impl, Member, Function, Named, Call, Match, Try = std.ast
Span, ExprId, TypeId, BlockId = std.ast
Checker = sema.sema_check
decl_at = sema.sema_def
Classed, Colour = lsp.lsp_colour
written = std.json

classify* = (a: Alloc, c: Checker, file: str)
           Res<Vec<Classed>, AllocError> {
    out ::= Classes(c: c, file: file, rows: a.Vec<Classed>());
    out.decl_sites().try();
    out.written_types().try();
    out.expr_sites().try();
    out.rows.sort();
    Ok(out.rows)
}

// Collects the classifications of one file; spans in other files are dropped.
Classes = {
    c    : Checker,
    file : str,
    rows :: Vec<Classed>,

    class_as = (self :: @Self, span: Span, colour: Colour)
               Res<(), AllocError> {
        span.file.eq(self.file).match({
            false => written(),
            true  => self.rows.add(Classed(
                line: span.start.line,
                col: span.start.col,
                colour: colour
            )),
        })
    }

    decl_sites = (self :: @Self) Res<(), AllocError> {
        Range(0, self.c.tree.module_count()).loop((h, i) {
            self.c.tree.module_at(i).match({
                None  => written(),
                Ok(m) => m.span.file.eq(self.file).match({
                    false => written(),
                    true  => self.module_sites(m),
                }),
            }).try();
        });
        self.nested_sites()
    }

    module_sites = (self :: @Self, m: Module) Res<(), AllocError> {
        m.decls.loop((h, d) { self.decl_site(d).try(); });
        Ok(());
    }

    nested_sites = (self :: @Self) Res<(), AllocError> {
        bid ::= BlockId(index: 0);
        Range(0, self.c.tree.block_ids()).loop((h, i) {
            self.block_sites(self.c.tree.block_at(bid)).try();
            bid = BlockId(index: bid.index + 1);
        });
        Ok(());
    }

    block_sites = (self :: @Self, b: Block) Res<(), AllocError> {
        b.stmts.loop((h, s) {
            s.kind.match({
                Decl(d) => self.decl_site(d),
                _       => written(),
            }).try();
        });
        Ok(());
    }

    decl_site = (self :: @Self, d: Decl) Res<(), AllocError> {
        d.kind.match({
            Function(f) => self.fn_site(f),
            Struct(s)   => self.member_sites(s.name.span, s.members),
            Enum(e)     => self.class_as(e.name.span, Colour.Type),
            Alias(x)    => self.class_as(x.name.span, Colour.Type),
            Impl(im)    => self.member_sites(im.target.span, im.members),
            Const(_)    => written(),
            Import(_)   => written(),
        })
    }

    fn_site = (self :: @Self, f: Function) Res<(), AllocError> {
        self.class_as(f.name.span, Colour.Function).try();
        f.params.loop((h, p) {
            self.class_as(p.name.span, Colour.Parameter).try();
        });
        Ok(());
    }

    member_sites = (self :: @Self, name: Span, members: Vec<Member>)
                   Res<(), AllocError> {
        self.class_as(name, Colour.Type).try();
        members.loop((h, m) {
            m.kind.match({
                Function(f) => self.fn_site(f),
                Const(_)    => written(),
                Field(_)    => written(),
            }).try();
        });
        Ok(());
    }

    written_types = (self :: @Self) Res<(), AllocError> {
        tid ::= TypeId(index: 0);
        Range(0, self.c.tree.type_ids()).loop((h, i) {
            self.c.tree.type_at(tid).kind.match({
                Named(n) => self.named_site(tid, n),
                _        => written(),
            }).try();
            tid = TypeId(index: tid.index + 1);
        });
        Ok(());
    }

    named_site = (self :: @Self, tid: TypeId, n: Named)
                 Res<(), AllocError> {
        self.c.type_memo.get(tid).match({
            None   => written(),
            Ok(ty) => self.c.is_unknown(ty).match({
                true  => written(),
                false => self.class_as(n.name.span, Colour.Type),
            }),
        })
    }

    expr_sites = (self :: @Self) Res<(), AllocError> {
        eid ::= ExprId(index: 0);
        Range(0, self.c.tree.expr_ids()).loop((h, i) {
            self.expr_site(eid).try();
            eid = ExprId(index: eid.index + 1);
        });
        Ok(());
    }

    expr_site = (self :: @Self, id: ExprId) Res<(), AllocError> {
        e = self.c.tree.expr_at(id);
        e.kind.match({
            Call(k)  => self.call_site(id, k),
            Match(m) => self.class_as(m.name_span, Colour.Keyword),
            Try(t)   => self.class_as(t.name_span, Colour.Keyword),
            Name(_)  => self.c.param_memo.get(id).match({
                Ok(_) => self.class_as(e.span, Colour.Parameter),
                None  => written(),
            }),
            _        => written(),
        })
    }

    call_site = (self :: @Self, id: ExprId, k: Call) Res<(), AllocError> {
        self.c.resolved_call(id).match({
            None    => written(),
            Ok(did) => decl_at(self.c.tree, did).match({
                None  => written(),
                Ok(d) => d.kind.match({
                    Function(_) => self.fn_callee(k),
                    Struct(s)   => self.type_callee(k, s.name.text),
                    Enum(e)     => self.type_callee(k, e.name.text),
                    Alias(x)    => self.type_callee(k, x.name.text),
                    Const(_)    => written(),
                    Import(_)   => written(),
                    Impl(_)     => written(),
                }),
            }),
        })
    }

    fn_callee = (self :: @Self, k: Call) Res<(), AllocError> {
        callee = self.c.tree.expr_at(k.callee);
        callee.kind.match({
            Name(_)   => self.class_as(callee.span, Colour.Function),
            Access(x) => self.class_as(x.name.span, Colour.Function),
            _         => written(),
        })
    }

    type_callee = (self :: @Self, k: Call, decl: str) Res<(), AllocError> {
        callee = self.c.tree.expr_at(k.callee);
        callee.kind.match({
            Name(n) => n.text.eq(decl).match({
                true  => self.class_as(callee.span, Colour.Type),
                false => written(),
            }),
            _       => written(),
        })
    }
}
