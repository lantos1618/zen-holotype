// A SHADOWING DECLARATION'S INITIALISER STILL MEANS THE OUTER BINDING.
// `k ::= k + 1` inside a nested block declares a NEW `k` and reads the
// one it shadows -- the name comes into scope after its own value, the
// same order sema resolves it in.
//
// It answered stack garbage instead, and differently on every run:
// `gen_c_stmt.declare_local` put the new slot in scope before lowering
// the initialiser, so the `k` in `k + 1` compiled to the storage being
// declared. A wrong answer nothing could see -- no diagnostic, no
// warning from cc, and the number printed looked like a number.
//
// The `.loop` line is the same question one nesting deeper, where the
// shadowed binding is reached from inside a closure.

main = (env: Env) Res<i32, AllocError> {
    k: i32 = 5;
    k.match({ _ => { k: i32 ::= k + 1; println("{}", k); } });

    xs         = [1, 2, 3];
    total: i32 = 100;
    xs.loop((h, v) { total: i32 = total + v; println("{}", total); });
    println("{}", total);
    Ok(0);
}
