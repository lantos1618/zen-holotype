// Importing the TYPE put `describe` in scope -- it travels with Box --
// and UFCS says `x.f(..)` and `f(x)` are one call. So the free form
// reaches the same function the method form does, with no import line
// naming it: "a free function whose first param is the type is callable
// as a method" spells ONE surface, not two.
//
// The free form used to bind to nothing, because only a dot asked the
// travelled pool -- sema answered silence, and CODEGEN was the pass that
// refused, with `codegen cannot resolve`.
//
// One-line breaker: ask the travelled pool only when a receiver is in
// hand -> the second print stops compiling.
//
// position-free: the two forms must print the same number.

Box = box.box

main = (env: Env) Res<i32, IoError> {
    b = Box(label: 3);
    println("{}", b.describe());
    println("{}", describe(b));
    Ok(0);
}
