// TWO INSTANTIATIONS OF ONE GENERIC ENUM ANSWER DIFFERENTLY. The issue's
// own standing constraint: if the fix made pick(x) compile by mangling
// Opt<i32> and Opt<str> to one symbol, it would have converted a loud
// bug into a silent one. Both calls monomorphise separately, each value
// keeps its own payload width, and each answer is its own.
//
// Opt<str>'s payload is a str; seven() hands the literal back through an
// annotated return so the callee owns its type. Prints 41 then seven.

Opt<T> = Some(T) | None

pick_i32 = (o: Opt<i32>) i32 { o.match({ Some(v) => v, None => 0 }) }

seven = () str { "seven" }

pick_str = (o: Opt<str>) str { o.match({ Some(s) => s, None => "none" }) }

main = (env: Env) Res<i32, AllocError> {
    a = Opt.Some(41);
    println("{}", pick_i32(a));
    b = Opt.Some(seven());
    println("{}", pick_str(b));
    Ok(0);
}
