// EVERY PASS IS CHECKED (`docs/design_meta.md` §7, M4 slice 2). The
// first pass's field is `i64` and the body is clean FOR IT; the second
// is `bool`, against which `x: i64 = self.at(field)` is a mismatch.
// A checker that answered pass two from pass one's memo — the walk is
// the one place a body's types change between two readings of one node
// — would say nothing here, and the unrolled C would say it instead.
//
// position: the bind, whose written type the second pass's projection
// disagrees with.

Pair = {
    a: i64,
    b: bool,
}

main = (env: Env) Res<i32, AllocError> {
    p = Pair(a: 1, b: true);
    @meta(x: Pair).fields().loop((h, field) {
        x: i64 = p.at(field);
        println("{}", x);
    });
    Ok(0);
}
