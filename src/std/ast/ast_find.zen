// src/std/ast/ast_find.zen
// A cursor position, and the node under it — the LSP primitive
// `PLAN.md` stage 4 lists as the only one nothing else needs (every
// other consumer walks DOWNWARD from a root; an editor arrives holding
// a byte offset).
//
// SCAN, NOT WALK: `ast_arena.zen` holds every expression, type,
// pattern and block in one flat `Vec` with its span, so this is a fold
// over four lists, needing no traversal, parent links, or second index.
//
// SMALLEST WINS: two nodes covering one position are always nested, so
// "strictly inside the best so far" totally orders the candidates —
// the answer is deterministic regardless of arena order, which is what
// `fmt` and the fixpoint stand on.
//
// Position convention is `AST_CONTRACT.md`'s: 1-based line, 1-based
// BYTE column, span half-open (a position equal to `end` is PAST the
// node).
//
// NOTHING HERE ALLOCATES (law 1): no `Alloc` parameter below. A cursor
// query runs per keystroke.
str = std.text
Pos, Span = std.ast.ast_span
ExprId, TypeId, PatternId, BlockId = std.ast.ast_id
Ast = std.ast.ast_arena

// Which arena the answer came out of. An LSP asks different questions
// of each — hover is `type_of` on an `ExprId`, and a `TypeId` under the
// cursor is a go-to-definition on a written type — so the answer names
// the family rather than erasing it to an index.
NodeRef* = ExprNode(ExprId)
    | TypeNode(TypeId)
    | PatternNode(PatternId)
    | BlockNode(BlockId)

// Is `p` inside `span`, in `file`? Half-open, so `end` is past it.
in_span* = (span: Span, file: str, p: Pos) bool {
    span.file.eq(file) && !before(p, span.start) && before(p, span.end)
}

// Is `a` earlier in the file than `b`? Line first, then byte column.
before* = (a: Pos, b: Pos) bool {
    (a.line < b.line) || (a.line == b.line && a.col < b.col)
}

// Is `inner` strictly inside `outer` — the same span is not.
inside* = (inner: Span, outer: Span) bool {
    !before(inner.start, outer.start)
        && !before(outer.end, inner.end)
        && (before(outer.start, inner.start) || before(inner.end, outer.end))
}

// THE QUERY: the smallest node of any family covering `p` in `file`.
// `None` when `p` is in no node — past EOF or inside trivia — which is
// a correct answer (hovering a comment gets nothing), not a failure.
node_at* = (tree: Ast, file: str, p: Pos) Res<NodeRef> {
    best ::= NodeRef.ExprNode(ExprId(index: 0));
    have ::= false;
    span ::= empty_span();
    tree.exprs_each((id, ex) {
        take(ex.span, file, p, have, span).then(() {
            best = NodeRef.ExprNode(id);
            span = ex.span;
            have = true;
        });
    });
    tree.types_each((id, ty) {
        take(ty.span, file, p, have, span).then(() {
            best = NodeRef.TypeNode(id);
            span = ty.span;
            have = true;
        });
    });
    tree.patterns_each((id, pat) {
        take(pat.span, file, p, have, span).then(() {
            best = NodeRef.PatternNode(id);
            span = pat.span;
            have = true;
        });
    });
    tree.blocks_each((id, blk) {
        take(blk.span, file, p, have, span).then(() {
            best = NodeRef.BlockNode(id);
            span = blk.span;
            have = true;
        });
    });
    have.match({ true => Ok(best), false => None })
}

// HOVER'S OWN DOOR: the smallest EXPRESSION covering `p`. A separate
// query rather than a filter over `node_at`: `x: i32 = 1` has a `Type`
// node over `i32` and an `Expr` over `1` — hovering a VALUE's type
// wants the expression specifically, not the smallest node of any kind.
expr_node_at* = (tree: Ast, file: str, p: Pos) Res<ExprId> {
    best ::= ExprId(index: 0);
    have ::= false;
    span ::= empty_span();
    tree.exprs_each((id, ex) {
        take(ex.span, file, p, have, span).then(() {
            best = id;
            span = ex.span;
            have = true;
        });
    });
    have.match({ true => Ok(best), false => None })
}

// Does this candidate beat the best so far? It has to cover the
// position, and then either be the first thing that does or sit
// strictly inside what already does.
take = (cand: Span, file: str, p: Pos, have: bool, best: Span) bool {
    in_span(cand, file, p) && (!have || inside(cand, best))
}

// A span no candidate is inside, for the "nothing yet" state. It is
// never read before `have` is true; it exists because a mutable local
// needs a value to start at.
empty_span = () Span {
    Span(file: "", start: Pos(line: 0, col: 0), end: Pos(line: 0, col: 0))
}
