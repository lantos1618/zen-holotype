Link = {
    value: i64,
    next: Ptr<Link>,
}

build = (alloc: Alloc, n: i64) Link {
    (n <= 0).match({
        true  => Link(value: 1000, next: null_ptr<Link>()),
        false => Link(value: 7, next: null_ptr<Link>()),
    });
}

main = (env: Env) Res<i32, AllocError> {
    println("{}", build(env.mem.alloc(), 1).value);
    Ok(0);
}
