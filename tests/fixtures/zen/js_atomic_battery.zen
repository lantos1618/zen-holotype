// js_atomic_battery.zen — dual-backend cross-check of the five atomic_* intrinsics. Every line
// exercises one directly; C lowers each to a __atomic_* builtin and the
// js backend to the single-threaded __zr.atomic_* floor, so the two targets must print the same
// bytes. Before the js lowering existed, `build --target js` exited 0 and node died with
// `ReferenceError: atomic_store_i64 is not defined` — this file is that regression's teeth.
//   C:  zen run   tests/fixtures/zen/js_atomic_battery.zen
//   JS: zen build --target js tests/fixtures/zen/js_atomic_battery.zen -o /tmp/b.js && node /tmp/b.js
{ println } = std.io.print
{ request_arena, heap_allocator } = std.mem.alloc
fetch_add_cas = (p: RawPtr<u8>, delta: i64) i64 {
    cur = atomic_load_i64(p)
    atomic_cas_i64(p, cur, cur + delta).then({ cur }, { p.fetch_add_cas(delta) })
}
main = () i32 {
    m = request_arena(heap_allocator())
    p = assert_nonnull(m.addr().acquire(8))
    atomic_store_i64(p, 7)
    println(atomic_load_i64(p))    // 7
    atomic_store_i64(p, 10)
    println(atomic_load_i64(p))    // 10
    println(atomic_add_i64(p, 5))    // 15 — returns the NEW value
    println(atomic_add_i64(p, 0 - 20))    // -5 — negative delta
    println(atomic_cas_i64(p, 0 - 5, 99))    // true — CAS hit
    println(atomic_load_i64(p))    // 99
    println(atomic_cas_i64(p, 0 - 5, 1))    // false — CAS miss leaves the cell alone
    println(atomic_load_i64(p))    // 99
    atomic_store_i64(p, 4000000000)    // past 2^32: the js floor must keep i64 width
    println(atomic_add_i64(p, 4000000000))    // 8000000000
    atomic_fence()    // nothing to order on a one-thread target
    atomic_store_i64(p, 1)
    println(atomic_load_i64(p) != 0)    // true
    println(atomic_cas_i64(p, 1, 0))    // true
    println(atomic_load_i64(p) != 0)    // false
    println(p.fetch_add_cas(3))    // 0 — CAS spin loop, returns the PRIOR value
    println(atomic_load_i64(p))
    m.addr().release(p)
    0
}    // 3
