// The same law for an ordinary type: `Tag` is declared in `tag`, so
// `Tag.impl(Eq, ..)` belongs there. Written here it is never consulted —
// `impls_named` finds it and every reader drops it, because the impl's
// module is not the module that declares `Tag`.
//
// The primitive case is the sibling test, `sema/orphan_impl_on_primitive`;
// this one is the path through `defs_of` rather than through `prelude_of`.
//
// position: the impl declaration.

Tag = tag.tag

Tag.impl(Eq, {
    eq ::= (self: @Self, other: @Self) bool { self.n == other.n }
})

main = (env: Env) Res<i32, AllocError> {
    println("{}", Tag(n: 1).eq(Tag(n: 1)));
    Ok(0);
}
