pair = (a: i32, b: i32) i32 { a * 10 + b }
fib = (n: i32) i32 { (n < 2).match({ true => n, false => fib(n - 1) + fib(n - 2) }) }
weighted = (
    a : i32,
    b : i32,
    c : i32,
    d : i32,
    e : i32,
    f : i32,
    g : i32,
    h : i32
) i32 {
    a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6 + g * 7 + h * 8
}
unit = (value: ()) () { print("unit:"); value }

main = () i32 {
    x: i32 ::= 1;
    saved   = pair(x, true.match({ true => { x = 4; 3 }, false => 0 }));
    skipped = false && true.match({ true => { x = 9; true }, false => false });
    taken   = true || true.match({ true => { x = 10; false }, false => false });
    println(
        "{} {} {} {} {} {}",
        saved,
        x,
        skipped,
        taken,
        fib(6),
        weighted(1, 2, 3, 4, 5, 6, 7, 8)
    );
    left: i32  = 13;
    right: i32 = 5;
    println(
        "{} {} {} {} {} {}",
        left + right,
        left - right,
        left * right,
        left / right,
        left % right,
        -left
    );
    println(
        "{} {} {} {} {} {} {}",
        left == right,
        left != right,
        left < right,
        left <= right,
        left > right,
        left >= right,
        !true
    );
    println("{}", unit(()));
    println("quoted:\"\\\01 é");
    0
}
