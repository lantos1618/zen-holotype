// A FREE FUNCTION ON AN ENUM (a union is "an ordinary struct" too) IS A
// DOT CANDIDATE: `Color.Blue.name()` reaches `name(Color)` declared beside
// the union, and dispatches on the variant like any match.
//
// The plausible failure is a resolver whose candidate pool only holds
// nominal STRUCTS, so unions get method syntax for `.match` (hardcoded)
// but never gather user functions -- answering "no `name` on `Color`".
// The reverse bug, gathering the union's VARIANTS as members, would make
// `Red` itself a callable and answer something for the wrong reason; the
// second line calls through a variant-qualified construction to keep the
// variants' own meaning pinned.
//
// Breaks if: the world does not travel to unions -- the dot line rejects
// or answers a different arm.

Color = Red | Green | Blue

name = (c: Color) str {
    c.match({
        Red   => "r",
        Green => "g",
        Blue  => "b",
    })
}

main = (env: Env) Res<i32, AllocError> {
    println("{}", Color.Green.name());
    println("{}", name(Color.Blue));
    Ok(0);
}
