choose = (value: i32) i32 { value }
choose = (value: bool) bool { value }
orphan = () i32 { 3 }
deferred = () i32 { 4 }
execute = (body: () i32) i32 { body() }
api* = () i32 { 5 }
generic = <T>(value: T) T { value }
Box = {
    method = (self: @Self) i32 { deferred() }
}
main = () i32 {
    value = choose(1);
    execute(() { deferred() }) + value
}
