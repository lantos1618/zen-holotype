Input = { text :: str, scratch: str }
Box = { text :: str }
put = (box :: Box, input: Input) () { alias = input; box.text = alias.text; }
fill = (env: Env, box :: Box, text: str) Res<(), AllocError> {
    a         = env.mem.alloc();
    temporary = a.String("temporary").try();
    original ::= Input(text: text, scratch: temporary.view());
    snapshot      = original;
    original.text = temporary.view();
    put(box, snapshot);
    Ok(())
}
main = (env: Env) Res<(), AllocError> {
    box ::= Box(text: "");
    fill(env, box, "caller").try();
    println(box.text);
    Ok(())
}
