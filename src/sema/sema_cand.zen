// src/sema/sema_cand.zen
// WHICH DECLARATIONS A NAME OFFERS, and which of them a call fits.
//
// `sema_call.zen` owns what a call MEANS — the four callee forms, the
// receiver, the recorded answer. This file owns the two questions it
// asks in the middle and neither is about a call: what is in the
// candidate set, and does an argument list match a signature.
//
// A CANDIDATE SET IS A SET BECAUSE OVERLOADING IS. "Resolution is on
// declared parameter types and arity", so a name denotes a list and
// choosing is the call site's job — which is `sema_def.zen`'s reason
// for `defs_of` returning one, said one layer up where the signatures
// are resolved.
//
// AND IT HAS A SECOND SOURCE, which is DESIGN.md's own sentence:
// "importing a type pulls its world along: its methods, its trait
// impls, and exported ufcs functions (a free function whose first param
// is the type is callable as a method)". Only a DOT asks for that half,
// and only a function whose first parameter IS the receiver's type
// answers — the first parameter is what makes a free function a method,
// and sharing the name never was.
//
// A SIGNATURE IS RESOLVED IN THE MODULE THAT DECLARES IT, with the
// declaration's own type parameters in scope, or `<T>(a: T)` reports
// its own `T` as an undefined name.

Decl, Function, TParam = std.ast
AllocError = std.mem
Vec = std.collections
str = std.text
Range = std.core
DeclId = sema.sema_id
TyId = sema.sema_ty
Def, decl_at = sema.sema_def
Checker, Ctx, UNRESOLVED = sema.sema_check
tparam_vars = sema.sema_inst
Cand, TBound, Actual = sema.sema_call
satisfies_bound = sema.sema_bound
type_from_ast, param_type = sema.sema_denote
pack_elem, pack_slot = sema.sema_vararg

// ---------------------------------------------------------------------
// candidates
// ---------------------------------------------------------------------

// THE FUNCTIONS THAT TRAVELLED WITH THE RECEIVER'S TYPE.
//
// "Importing a type pulls its world along: its methods, its trait
// impls, and exported ufcs functions." A free function whose first
// parameter is `u32` came along with `u32`, so the module it was
// written in need never have been imported — which is how `to_usize`,
// on no prelude line, is a method on every integer in the tree.
//
// ONLY A DOT ASKS. `recv` is `None` for `f(x)`, so an ordinary call
// still sees only what its own module imported and the `*` gate is
// exactly as tight as it was. The first parameter is the whole gate, as
// the header says.
travelled_cands* = (
    c    :: Checker,
    name : str,
    recv : Res<TyId>,
    out  :: Vec<Cand>
) Res<(), AllocError> {
    recv.match({
        Ok(rty) => c.travelled_of(name, rty, out),
        None    => Ok(()),
    })
}

travelled_of = (c :: Checker, name: str, rty: TyId, out :: Vec<Cand>)
               Res<(), AllocError> {
    defs ::= c.alloc.Vec<Def>();
    c.world.exported_named(name, defs).try();
    pool ::= c.alloc.Vec<Cand>();
    defs.loop((h, d) { c.cand_of(d, pool).try() });
    pool.loop((h, k) { keep_travelled(c, k, rty, out).try() });
    Ok(());
}

// A declaration already in the list is not added twice: a module that
// imported the function reaches it both ways, and one declaration is
// one candidate or overload resolution reports its own answer as an
// ambiguity.
keep_travelled = (c :: Checker, k: Cand, rty: TyId, out :: Vec<Cand>)
                 Res<(), AllocError> {
    takes = takes_receiver(c, k, rty).try();
    (takes && (has_cand(out, k.id) == false)).match({
        true  => out.add(k),
        false => Ok(()),
    })
}

// AN IMPL OF THE DECLARED BOUND IS THE RECEIVER'S TYPE, and the gate
// read `t.eq(rty)`, which says it is not.
//
// DESIGN.md's own first line of every program is what falls through:
// `alloc ::= env.mem.alloc()` is an `Arena`, `Vec* = <T>(a: Alloc)
// Vec<T>` declares an `Alloc`, and "the call surface is identical —
// `alloc.Vec<i32>()` either way" is only true if `Arena.impl(Alloc, ..)`
// counts here. `value_fits` already counts it for arguments one and up;
// parameter zero was the one place that did not.
//
// Nothing showed while every caller also imported the function — that
// path is `cands_of` and never asks this. It shows the moment a program
// imports the TYPE and not the function: `alloc.Parser(lexed, tree)`
// found no candidate at all, fell through to `construct_or_fail`, and
// was built as a nominal type of its own name with no fields — which is
// why the diagnostic named `tree` and not `Parser`.
//
// `satisfies_bound` and NOT `assignable`: "an impl of it, or the same
// type, and nothing else". A receiver may not reach a `<T>(a: T)`
// through a type variable's leniency, because a bare parameter would
// swallow every receiver in the program.
takes_receiver = (c :: Checker, k: Cand, rty: TyId) Res<bool, AllocError> {
    k.params.get(0).match({
        None  => Ok(false),
        Ok(t) => c.satisfies_bound(rty, t),
    })
}

has_cand = (out: Vec<Cand>, id: DeclId) bool {
    Range(0, out.len).find((i) {
        out.get(i).match({ Ok(k) => k.id.eq(id), None => false })
    }).match({ Ok(_) => true, None => false })
}

cands_of* = (c :: Checker, mi: usize, name: str, out :: Vec<Cand>)
            Res<(), AllocError> {
    defs ::= c.alloc.Vec<Def>();
    c.world.defs_of(mi, name, defs).try();
    defs.loop((h, d) { c.cand_of(d, out).try() });
    Ok(());
}

cand_of = (c :: Checker, d: Def, out :: Vec<Cand>) Res<(), AllocError> {
    decl_at(c.tree, d.id).match({
        Ok(dec) => c.cand_from_decl(d, dec, out),
        None    => Ok(()),
    }).try();
    Ok(());
}

cand_from_decl = (c :: Checker, d: Def, dec: Decl, out :: Vec<Cand>)
                 Res<(), AllocError> {
    dec.kind.match({
        Function(f) => c.add_cand(d, dec, f, out),
        _           => Ok(()),
    })
}

// A signature is resolved in the declaring module, as the header says.
add_cand = (c :: Checker, d: Def, dec: Decl, f: Function, out :: Vec<Cand>)
           Res<(), AllocError> {
    mark   = c.tvar_mark();
    poison = c.types.unknown().try();
    ctx    = Ctx(d.id.module.to_usize(), poison);
    c.push_fn_tparams(f, d.qname).try();
    tvs ::= c.alloc.Vec<TyId>();
    c.tparam_vars(f.tparams, d.qname, tvs).try();
    ptys ::= c.alloc.Vec<TyId>();
    f.params.loop((h, p) { ptys.add(c.param_type(p, ctx).try()).try() });
    rty = f.ret.match({
        Ok(r) => c.type_from_ast(r, ctx),
        None  => c.types.prim("()"),
    }).try();
    tbs ::= c.alloc.Vec<TBound>();
    c.collect_bounds(f, ctx, tbs).try();
    c.release_tvars(mark).try();
    out.add(Cand(
        id: d.id,
        name: d.name,
        owner: d.qname,
        params: ptys,
        ret: rty,
        tvars: tvs,
        tbounds: tbs,
        generic: f.tparams.len > 0,
        span: dec.span
    ))
}

// The FUNCTION form. `sema_inst.zen` owns the general one over a
// Vec<TParam>; Zen has no overloading, so the two cannot share a name.
push_fn_tparams = (c :: Checker, f: Function, owner: str) Res<(), AllocError> {
    f.tparams.loop((h, tp) {
        text = tp.name.text;
        c.push_tvar(text, c.types.var(text, owner).try()).try();
    });
    Ok(());
}

collect_bounds = (c :: Checker, f: Function, ctx: Ctx, out :: Vec<TBound>)
                 Res<(), AllocError> {
    f.tparams.loop((h, tp) { c.tparam_bounds(tp, ctx, out).try() });
    Ok(());
}

tparam_bounds = (c :: Checker, tp: TParam, ctx: Ctx, out :: Vec<TBound>)
                Res<(), AllocError> {
    text = tp.name.text;
    tp.bounds.loop((h, b) {
        out.add(TBound(name: text, bound: c.type_from_ast(b, ctx).try())).try();
    });
    Ok(());
}

// ---------------------------------------------------------------------
// matching
// ---------------------------------------------------------------------

// A NAMED ARGUMENT SUPPLIES A FIELD AND NEVER A PARAMETER, so a call
// written with one matches no function at all.
//
// AST_CONTRACT.md gives `name: value` to construction and to an impl's
// supplied field; a call's arguments are positional. Without this,
// `Vec(alloc: a)` — the body of `Vec`'s own constructor — resolves to
// the CONSTRUCTOR rather than to the struct, because the function takes
// one `Alloc` and so does the call. Sema answered `Vec<T>` either way,
// so nothing showed until a backend was able to lower it: the emitted
// C is a function calling itself with its own argument, which is
// unbounded recursion with no diagnostic anywhere. It is the same shape
// as the variadic mismatch that built a `String` positionally, and it
// is why this rule is checked before an instantiation is trusted.
matches* = (c :: Checker, cand: Cand, actuals: Vec<Actual>)
           Res<bool, AllocError> {
    any_named(actuals).match({
        true  => Ok(false),
        false => by_arity(c, cand, actuals),
    })
}

any_named = (actuals: Vec<Actual>) bool {
    Range(0, actuals.len).find((i) {
        actuals.get(i).match({ Ok(a) => a.named, None => false })
    }).match({ Ok(_) => true, None => false })
}

by_arity = (c :: Checker, cand: Cand, actuals: Vec<Actual>)
           Res<bool, AllocError> {
    c.is_variadic(cand).match({
        true  => c.variadic_matches(cand, actuals),
        false => c.fixed_matches(cand, actuals),
    })
}

fixed_matches = (c :: Checker, cand: Cand, actuals: Vec<Actual>)
                Res<bool, AllocError> {
    (cand.params.len == actuals.len).match({
        false => Ok(false),
        true  => c.all_fit(cand, actuals, actuals.len),
    })
}

// `...` IS NOT A PARAMETER, it is the statement that the list does not
// end. So `(a: Alloc, fmt: str, args: ...)` takes two arguments and
// then any number, and arity is a MINIMUM rather than an equality.
//
// Without this, `alloc.String("{}", x)` matched NOTHING — three actuals
// against a candidate reporting three parameters, one of which is the
// `...` — and fell through to `construct_or_fail`, which found the
// `String` STRUCT of the same name and built one positionally. The
// mistake was silent and it was not a diagnostic: the call typed as
// `String` where the declaration says `Res<String, AllocError>`, so
// every `.try()` on it lost its operand's type and every `.view()` on
// the result was unresolvable.
//
// Only the FIXED PREFIX is checked when the tail is the bare `...`. What
// the rest may be is type-directed — `text_string.zen` says the call is
// expanded where it is written — and a check on arguments whose types the
// language has not settled would be inventing a rule.
//
// A `vararg<T>` TAIL DOES SAY WHAT THE REST MAY BE, which is the whole
// difference between the two spellings, so its swallowed arguments go
// through `pack_sig_fits` and are checked against `T`.
variadic_matches = (c :: Checker, cand: Cand, actuals: Vec<Actual>)
                   Res<bool, AllocError> {
    pack_slot(c.types, cand.params).match({
        None     => c.marker_matches(cand, actuals),
        Ok(slot) => c.pack_sig_fits(cand.params, actuals, 0, slot),
    })
}

marker_matches = (c :: Checker, cand: Cand, actuals: Vec<Actual>)
                 Res<bool, AllocError> {
    fixed = cand.params.len - 1;
    (actuals.len >= fixed).match({
        false => Ok(false),
        true  => c.all_fit(cand, actuals, fixed),
    })
}

// THE ONE IMPLEMENTATION OF "THESE ACTUALS AGAINST A SIGNATURE THAT ENDS
// IN A PACK", read by both entry points. `off` is the signature index of
// actual zero — 0 for a free function, 1 for a member whose parameter
// zero is the receiver, which is `sema_call.zen`'s `recv_off` by the same
// name. Without one implementation the two would drift, and a call the
// checker accepted at one arity would be emitted at another.
//
// `slot < off` is an associated function whose only parameter is a pack,
// reached through the receiver path: there is no receiver to occupy
// position zero, so no argument list fits.
pack_sig_fits* = (
    c       :: Checker,
    ps      : Vec<TyId>,
    actuals : Vec<Actual>,
    off     : usize,
    slot    : usize
) Res<bool, AllocError> {
    (slot < off).match({
        true  => Ok(false),
        false => c.pack_arity_fits(ps, actuals, off, slot - off),
    })
}

pack_arity_fits = (
    c       :: Checker,
    ps      : Vec<TyId>,
    actuals : Vec<Actual>,
    off     : usize,
    fixed   : usize
) Res<bool, AllocError> {
    (actuals.len >= fixed).match({
        false => Ok(false),
        true  => c.prefix_then_pack(ps, actuals, off, fixed),
    })
}

prefix_then_pack = (
    c       :: Checker,
    ps      : Vec<TyId>,
    actuals : Vec<Actual>,
    off     : usize,
    fixed   : usize
) Res<bool, AllocError> {
    ok ::= true;
    Range(0, fixed).loop((h, i) {
        got = c.fits_at_ty(actuals, i, ty_at(ps, i + off)).try();
        ok  = ok && got;
    });
    tail = c.pack_tail_fits(actuals, fixed, ty_at(ps, fixed + off)).try();
    Ok(ok && tail);
}

// TWO READINGS OF ONE SLOT, and `vararg` not nesting (`sema_vararg.zen`)
// is what keeps them apart: a run of `T` values, or exactly ONE value
// that is already a `vararg<T>` being FORWARDED. Forwarding is what a
// bare `...` cannot do at all — it carries no type to pass on — and here
// it is ordinary assignability, not a case of its own.
pack_tail_fits = (
    c       :: Checker,
    actuals : Vec<Actual>,
    fixed   : usize,
    pack    : TyId
) Res<bool, AllocError> {
    c.pack_forwarded(actuals, fixed, pack).try().match({
        true  => Ok(true),
        false => c.spread_fits(actuals, fixed, c.pack_element_of(pack)),
    })
}

pack_forwarded = (c :: Checker, actuals: Vec<Actual>, fixed: usize, pack: TyId)
            Res<bool, AllocError> {
    (actuals.len == fixed + 1).match({
        false => Ok(false),
        true  => c.fits_at_ty(actuals, fixed, pack),
    })
}

spread_fits = (c :: Checker, actuals: Vec<Actual>, fixed: usize, elem: TyId)
              Res<bool, AllocError> {
    ok ::= true;
    Range(fixed, actuals.len).loop((h, i) {
        got = c.fits_at_ty(actuals, i, elem).try();
        ok  = ok && got;
    });
    Ok(ok);
}

// A pack whose element type nothing says is its own poison: the type is
// already reported, and answering with it keeps the arity question
// truthful instead of accepting everything.
pack_element_of = (c: Checker, pack: TyId) TyId {
    pack_elem(c.types, pack).match({ Ok(e) => e, None => pack })
}

fits_at_ty = (c :: Checker, actuals: Vec<Actual>, i: usize, want: TyId)
             Res<bool, AllocError> {
    actuals.get(i).match({
        Ok(a) => fits(c, a, want),
        None  => Ok(false),
    })
}

// Whether the last parameter says the list does not end — the bare `...`
// marker, which `sema_denote.zen` interns as a primitive so this is a name
// compare, or a `vararg<T>`, which is an ordinary nominal.
is_variadic = (c: Checker, cand: Cand) bool {
    (cand.params.len > 0).match({
        false => false,
        true  => c.tail_swallows(ty_at(cand.params, cand.params.len - 1)),
    })
}

// THE ANSWER THE BACKEND READS BACK. `gen_c_member.zen` asks it of a
// resolved member signature, so the arity a call is emitted at is the
// arity the checker accepted it at.
tail_swallows* = (c: Checker, tail: TyId) bool {
    c.prim_name(tail).eq("...")
        || pack_elem(c.types, tail).match({ Ok(_) => true, None => false })
}

// The first `n` arguments, and no early exit — `find` takes a closure
// that answers `bool`, and asking whether an argument keeps a bound is
// a question that allocates. A candidate has a handful of parameters,
// so the shape with nothing to get wrong is the right one.
all_fit = (c :: Checker, cand: Cand, actuals: Vec<Actual>, n: usize)
          Res<bool, AllocError> {
    ok ::= true;
    Range(0, n).loop((h, i) {
        got = c.fits_at(cand, actuals, i).try();
        ok  = ok && got;
    });
    Ok(ok);
}

fits_at = (c :: Checker, cand: Cand, actuals: Vec<Actual>, i: usize)
          Res<bool, AllocError> {
    p = ty_at(cand.params, i);
    actuals.get(i).match({
        Ok(a) => fits(c, a, p),
        None  => Ok(false),
    })
}

// A closure's type is its full signature, and its arity is the part a
// call site can see without inferring anything.
fits = (c :: Checker, a: Actual, p: TyId) Res<bool, AllocError> {
    a.is_lambda.match({
        true  => Ok(c.closure_fits(p, a.arity)),
        false => c.value_fits(a, p),
    })
}

// Assignable, or an impl of the bound the parameter names.
//
// The second is not a conversion and not a fallback: "a bound is just
// which struct's shape do I need", so an `Arena` is acceptable where
// `Alloc` is declared exactly because `Arena.impl(Alloc, ..)` exists
// and the promise was already kept at the impl. Without it `main`'s own
// `alloc ::= env.mem.alloc()` — the first line of every program in the
// language — cannot be passed to anything.
//
// It runs second because it is the expensive one: `satisfies_bound`
// searches the impls of a type, and `assignable` is a `u32` compare in
// the case that dominates.
value_fits = (c :: Checker, a: Actual, p: TyId) Res<bool, AllocError> {
    c.assignable(a.ty, p).match({
        true  => Ok(true),
        false => c.satisfies_bound(a.ty, p),
    })
}

// THE SAME QUESTION A `Cand` IS ASKED, ASKED OF A METHOD'S SIGNATURE.
//
// A method reaches resolution as a `Found` and not a `Cand` — it came
// from a type's member table rather than from a module's declarations —
// but "resolution is on declared parameter types AND arity" is one rule
// and it must be one implementation, or a method and a ufcs function
// resolve by different laws while DESIGN.md says they are the same
// thing. `all_fit` is that implementation and this is the receiver
// shifted off the front.
//
// PARAMETER ZERO IS THE RECEIVER and no argument corresponds to it: "a
// method is a UFCS function whose first parameter happens to be named
// `self`", so a call site's arity is one less than the signature's and
// the comparison starts at one. The receiver is not re-checked here
// because the member table is what found it — it is already known to be
// a member of that type.
//
// A MEMBER MAY END IN A PACK, and then the arity is a minimum here too —
// `pack_sig_fits` with the offset the paragraph above names, so `b.widest(1,
// 9, 4)` and `sum(1, 9, 4)` are one rule read twice rather than two.
recv_sig_fits* = (c :: Checker, ps: Vec<TyId>, actuals: Vec<Actual>)
                 Res<bool, AllocError> {
    pack_slot(c.types, ps).match({
        None     => c.recv_fixed_fits(ps, actuals),
        Ok(slot) => c.pack_sig_fits(ps, actuals, 1, slot),
    })
}

recv_fixed_fits = (c :: Checker, ps: Vec<TyId>, actuals: Vec<Actual>)
                  Res<bool, AllocError> {
    (ps.len == actuals.len + 1).match({
        false => Ok(false),
        true  => c.args_fit(ps, actuals),
    })
}

// No early exit, for `all_fit`'s reason.
args_fit = (c :: Checker, ps: Vec<TyId>, actuals: Vec<Actual>)
           Res<bool, AllocError> {
    ok ::= true;
    Range(0, actuals.len).loop((h, i) {
        got = c.arg_fits_at(ps, actuals, i).try();
        ok  = ok && got;
    });
    Ok(ok);
}

arg_fits_at = (c :: Checker, ps: Vec<TyId>, actuals: Vec<Actual>, i: usize)
              Res<bool, AllocError> {
    actuals.get(i).match({
        Ok(a) => fits(c, a, ty_at(ps, i + 1)),
        None  => Ok(false),
    })
}

closure_fits = (c: Checker, p: TyId, arity: usize) bool {
    c.types.at(p).match({
        Fn(f)  => f.params.len == arity,
        Var(_) => true,
        _      => false,
    })
}

is_tvar* = (c: Checker, id: TyId) bool { c.is_var(id) }

ty_at* = (v: Vec<TyId>, i: usize) TyId {
    v.get(i).match({ Ok(t) => t, None => UNRESOLVED })
}
