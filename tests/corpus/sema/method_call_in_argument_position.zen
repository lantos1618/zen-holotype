// THE CALL THE #772 DIAGNOSTIC ADVISES IS REAL AND STILL WORKS.
// `method_access_without_its_call` pins that bare `s.len` is refused;
// this pins its remedy. `String.len` is a method, so the value is read
// only through the call — `Range(0, s.len())` fills the usize argument
// slot with five, the loop counts five passes, and a rule that ever
// starts refusing the call form (over-refusal) reddens here.

Error = AllocError

main = (env: Env) Res<i32, Error> {
    a ::= env.mem.alloc();
    s ::= a.String("hello").try();
    n ::= 0;
    Range(0, s.len()).loop((h, i) { n = n + 1; });
    println("iterations={}", n);
    Ok(0);
}
