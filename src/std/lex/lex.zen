// src/std/lex/lex.zen
// The lexer's surface: nothing but starred re-exports.
//
// A folder root is starred bindings and nothing else, so the files below
// can be reorganised without a consumer changing a line.
//
// THE CONTRACT: `scan(alloc, source)` reads bytes and returns every token it
// could read plus every fault it found. It fails only on allocation
// failure — a file with faults still yields tokens. By convention such a
// file is REPORTED and NOT PARSED: a hand-written parser's opinion of the
// wreckage would be a second diagnostic for one mistake, no better than
// tree-sitter's.
//
// THE TEN LEXICAL RULES, all from DESIGN.md's "Lexical rules", all the same
// shape — REJECT RATHER THAN REINTERPRET:
//
//   the escape set is exactly                             lex_literal.escape
//     `\n \t \r \v \f \0 \\ \' \"`
//   a string or char literal does not span lines,          lex_literal.string
//     and the diagnostic points at the OPENING QUOTE       lex_literal.character
//   a character literal holds exactly one byte             lex_literal.character
//   a digit may not be followed by an identifier byte      lex_literal.suffix
//   a leading zero is rejected; Zen has no octal           lex_literal.number
//   `12.` is an error; a float has digits on both sides    lex_literal.fraction
//   identifiers are ASCII                                  std.core.byte.is_ident_start
//   block comments do not nest                             lex_scan.block_comment
//   a BOM is stripped only at offset 0                     lex_scan.strip_bom
//   `@` is closed to `@Self`, `@meta`, `@scope`            lex_scan.at_kind
//
// Hex is not in v1 — a stated cost, not an oversight: bit masks stay
// decimal until someone adds it. Adding a token shape later is compatible;
// removing one is not.

// what a token is, and where it came from
Pos*, Span*, TokenKind*, Token*, Source*  = std.lex.lex_token
text_of*, kind_name*                      = std.lex.lex_token

// what the lexer says when the bytes are wrong
LexFault*, Diag*, message*                = std.lex.lex_diag

// the alphabet; the byte-order mark is UTF-8's, from std.text
ByteClass*, class_of*, is_escape*         = std.lex.lex_byte
BOM_FIRST*, BOM_SECOND*, BOM_THIRD*       = std.text.text_utf8

// the walk, and the maximal-munch table — exported because the parser's
// error recovery re-reads both, not because a caller needs them to lex
Cursor*, cursor_at*                       = std.lex.lex_cursor
punct_of*, punct_kind*                    = std.lex.lex_punct

// the scan in progress, and what it produced
Lexer*, Lexed*                            = std.lex.lex_state

// the digit accumulator, shared with the parser so a literal is read once
// by one implementation rather than twice by two
Digits*, digits_of*                       = std.lex.lex_literal

// scan and the language-owned reserved-word/name table
scan*, Keyword*, KEYWORD_COUNT*, keyword_at*, is_keyword*, is_zen_name*
                                          = std.lex.lex_scan
