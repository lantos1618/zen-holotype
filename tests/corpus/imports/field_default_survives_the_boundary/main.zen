// A field's NON-ZERO DEFAULT, honoured for a type constructed through
// an import. The declaration lives in box.zen; the construction site
// never sees it -- only the compiler's name table does.
//
// The default is 77, not zero, on purpose: this tree lost weeks to
// struct defaults silently producing zeros because every expectation
// was already 0. A backend that builds the initialiser list from the
// ARGUMENTS and never the declaration leaves `weight` to C's `{0}`
// and prints 0 here -- a wrong answer that still looks like a number,
// which is exactly why the value is odd and large.
//
// One-line breaker: emit initialisers from call-site arguments only ->
// `5 0` instead of `5 77`.

Box = box.box

main = (env: Env) Res<i32, IoError> {
    a = Box(label: 5);
    println("{} {}", a.label, a.weight);
    b = Box(label: 5, weight: 1);
    println("{} {}", b.label, b.weight);
    Ok(0);
}
