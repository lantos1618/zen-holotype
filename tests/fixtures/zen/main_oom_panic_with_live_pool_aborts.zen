// NEGATIVE proof #2 for supervisable OOM: an allocation failure on the MAIN thread must still kill the
// process (exit 134) even while a worker pool is LIVE and has already run behaviors. This pins the
// thread-locality that the whole fix rests on: `__zen_panic_jmp` is `_Thread_local` and is set only inside
// `__zen_actor_call`, i.e. only on a worker, only for the duration of one behavior. If it were a plain
// global, a worker that had run a behavior would leave a stale catch target visible to the main thread and
// this program's `.expect` would siglongjmp onto a FOREIGN, already-unwound stack instead of aborting.
//
// It also covers the actor SETUP path: `pool_open` / `pool_spawn` / `send` all run on the main thread with
// no catch installed, so an OOM anywhere in setup must abort cleanly rather than jump somewhere.
//
// Asserted by the `main_oom_panic_with_live_pool_aborts` shell case: exit 134 and exactly ONE
// `zen: panic: vec.new: out of memory` line.
{ pool_open, pool_spawn, pool_actor_free, Pool } = std.concurrent.pool
{ malloc, free, DynAlloc, dyn_of } = std.mem.alloc
vec = std.collections.vec
// An allocator that always fails — a deterministic out-of-memory (see pool_supervisor_oom_restart.zen).
oom_acquire = (s: RawPtr<u8>, n: i64) RawPtr<u8> { null_ptr() }
oom_resize = (s: RawPtr<u8>, p: RawPtr<u8>, n: i64) RawPtr<u8> { null_ptr() }
oom_release = (s: RawPtr<u8>, p: RawPtr<u8>) void { }
oom_alloc = () DynAlloc { dyn_of(oom_acquire, oom_resize, oom_release, null_ptr()) }
acc := malloc(8)
behave = (user: RawPtr<u8>, msg: i64) void { atomic_add_i64(user, msg) }
main = () i32 {
    store_i64(acc, 0)
    a := pool_spawn(acc, 64, behave)
    p := pool_open(2, 16)
    p.pool_send(a.offset(0), 1)
    p.pool_quiesce()    // a worker HAS now installed and torn down its per-behavior catch
    // Main thread, catch-free: the allocator fails, `vec.new_in` `.expect`s, `panic` calls
    // `__zen_panic_unwind()` (no target on THIS thread → returns) and then `abort()`s. Exit 134.
    v: vec.AVec<i64> := vec.new_in(oom_alloc())
    p.pool_quiesce_stop()
    pool_actor_free(a.offset(0))
    p.pool_close()
    free(acc)
    v.len().to_i32()
}
