// A zero-byte request is an EMPTY SUCCESS on every fallible allocation surface. C leaves `malloc(0)`
// implementation-defined, and `ok_ptr` maps null to `.Err`, so an unguarded surface reports OOM for a
// request that asked for nothing. std.mem.alloc's `try_acquire` guarded this; std.mem.raw's did not.
//
// `try_of` is deliberately NOT here: it seeds `b[0]`, so a zero-length request genuinely cannot be
// satisfied and its `.Err(.NotFound)` is correct, not an inconsistency.
{ try_alloc, try_zeroed } = std.mem.raw
{ try_acquire } = std.mem.alloc
{ println } = std.text.fmt
{ then } = std.core.bool
halloc = std.mem.heap
is_ok = (r: Result<RawPtr<u8>, IoError>) bool {
    r.match ({
        .Ok(p)  => true,
        .Err(e) => false,
    })
}
main = () i32 {
    m = halloc.gpa()
    a = m.addr()
    ok = try_alloc(0).is_ok() && try_zeroed(0).is_ok() && a.try_acquire(0).is_ok()
    // and a real request still succeeds — the guard must not swallow ordinary allocation
    ok2 = try_alloc(8).is_ok() && try_zeroed(8).is_ok() && a.try_acquire(8).is_ok()
    println("")
    (ok && ok2).then({ 0 }, { 1 })
}
