// The POSITIVE half of the star gate: `mid` may USE the name it imported
// without a star. The negative half -- that main cannot name it -- is
// `tests/must-fail/modules/unstarred_not_reexported`, which pins the
// sentence and the position.
//
// MAIN DECLARES ITS OWN `double`, and that is what makes a leak show up
// here rather than only there: if the unstarred import in `mid` reached
// this module's namespace, either the two collide (loud) or `double(3)`
// answers 6 through secret's instead of 103 through this one -- a wrong
// number, from a program that still compiles.
quad = mid.mid

double = (n: i32) i32 { n + 100 }

main = (env: Env) Res<i32, IoError> {
    println("{}", quad(3));
    println("{}", double(3));
    Ok(0);
}
