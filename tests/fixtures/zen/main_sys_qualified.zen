// `main = (s: sys.Sys) i32` — the capability entry reached through a NAMESPACE ALIAS (`sys = std.sys.root`)
// rather than the destructured `{ Sys } = std.sys.root` form. Both must compile to the same niladic `zen_main`
// trampoline: a namespace alias renames the module's value decls under a `sys__` prefix (so `root` becomes
// `sys__root`), and the trampoline must call THAT name — else the C boundary reads `zen_user_main(root())`
// against an implicitly-declared `int root()` and cc rejects the argument type (#52).
sys = std.sys.root
main = (s: sys.Sys) i32 {
    s.stdout().write_or_panic("hi from qual sys\n")
    0
}
