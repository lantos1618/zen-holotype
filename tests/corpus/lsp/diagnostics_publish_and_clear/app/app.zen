// THE FILE ON DISK. Every buffer the test opens replaces it, so nothing
// here is ever what gets checked — it exists because the walk stats a
// path before it reads one, and because a module that is only ever an
// overlay would hide a build that had stopped consulting the overlay.
Point = app.shape

near = (p: Point, n: i32) i32 {
    s = p.x + n;
    s
}
