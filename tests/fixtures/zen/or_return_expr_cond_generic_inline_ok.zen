// .or_return() in CONDITIONAL position (a match-arm VALUE) inside a GENERIC fn — the Ok and
// branch-not-taken paths. caller(1) takes the guarded arm and gets the Ok payload (5); pick(2,…)
// takes the OTHER arm, so the or_return receiver must not evaluate at all (its Err must not
// propagate) and the arm value 70 flows through. Exit 75 = 5 + 70.
{ Result, IoError } = std.core.result
gk = (ok: i32) Result<i32, IoError> { (ok == 1).match ({ true => .Ok(5), false => .Err(.NotFound) }) }
pick<T> = (sel: i32, ok: i32, d: T) Result<i32, IoError> {
    v := (sel == 1).match ({ true => gk(ok).or_return(), false => 70 })
    .Ok(v)
}
main = () i32 {
    ok_path := pick(1, 1, 9).match ({
        .Ok(v)  => v,
        .Err(e) => 201,
    })    // 5
    off_path := pick(2, 0, 9).match ({
        .Ok(v)  => v,
        .Err(e) => 202,
    })    // 70: the false arm — gk(0)'s Err must NOT fire
    ok_path + off_path
}
