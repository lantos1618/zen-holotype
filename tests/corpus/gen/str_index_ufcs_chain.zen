Failure = Missing(usize) | Other

accepted = (byte: u8) Res<u8> {
    (byte != '?').match({ true => Ok(byte), false => None })
}

kind = (byte: u8) str { "byte" }
kind = (value: i32) str { "integer" }

read = (text: str, at: usize) Res<u8, Failure> {
    byte ::= '?';
    (at < text.len).then(() {
        byte = text[at].accepted().ok_or(Failure.Missing(at)).try();
    });
    Ok(byte)
}

main = () () {
    println("overload {}", "x"[0].kind());
    println("byte {}", read("az", 1).match({
        Ok(byte) => byte == 'z', Err(_) => false,
    }));
    println("error {}", read("a?", 1).match({
        Err(Missing(at)) => at == 1, _ => false,
    }));
    println("guard {}", read("", 0).match({
        Ok(byte) => byte == '?', Err(_) => false,
    }));
}
