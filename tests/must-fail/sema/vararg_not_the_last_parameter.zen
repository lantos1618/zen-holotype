// A pack swallows every remaining argument, so nothing can follow it — and
// the reason is not tidiness. A pack BORROWS the calling frame (gen_c writes
// the run as a compound literal in the calling block), so the position rule
// is what keeps it from outliving what it borrows from, and "the last
// parameter" is the one position that cannot.
//
// Without the rule the call is still refused, but for the wrong reason: the
// LAST parameter is `tail`, so the signature reads as fixed-arity, and the
// complaint lands on the call site as "no overload matches" rather than on
// the declaration the author has to change.
//
// position: the `vararg` in the parameter list.

notlast = (v: vararg<i32>, tail: i32) i32 { tail }

main = (env: Env) Res<i32, AllocError> {
    println("{}", notlast(1, 2));
    Ok(0);
}
