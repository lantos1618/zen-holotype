// A NULLARY nested variant, tested FIRST. `match_nested` writes
// `Left(Full(n))` before `Left(Blank)`, and an arm chain is `else if`,
// so the earlier arm's test on `Full` already keeps a `Blank` out of it
// -- a backend that never tested the nested `Blank` at all would pass
// that test. Ordered this way nothing else can do the work: only
// `Blank`'s own tag keeps `Left(Full(1))` out of the first arm.
//
// The failure this pins is a WRONG ANSWER and not a rejection -- the arm
// still matches, it is just the wrong one, and the C is valid.

Cell = Full(i32) | Blank

Slot = Left(Cell) | Right(Cell) | Gone

describe = (env: Env, s: Slot) () {
    s.match({
        Left(Blank)    => println("left blank"),
        Left(Full(n))  => println("left {}", n),
        Right(Blank)   => println("right blank"),
        Right(Full(n)) => println("right {}", n),
        Gone           => println("gone"),
    });
}

main = (env: Env) Res<i32, AllocError> {
    describe(env, Slot.Left(Cell.Full(1)));
    describe(env, Slot.Left(Cell.Blank));
    describe(env, Slot.Right(Cell.Full(2)));
    Ok(0);
}
