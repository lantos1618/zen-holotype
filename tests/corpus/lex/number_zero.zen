// zero, and zero in every position it can appear.
//
// EVERY EXPECTATION HERE IS DELIBERATELY NON-ZERO. This tree lost weeks to
// field defaults silently producing zeros -- including a hash seed -- and a
// test whose expected output is `0` cannot tell a correctly lexed `0` from a
// pipeline that produced nothing at all. So each line pairs the zero with a
// neighbour that only survives if the zero is EXACTLY zero, and the two
// classification lines take the SECOND match arm, so a first-arm-wins
// lowering cannot fake them either.
Error = AllocError | IoError

is_zero = (n: i32) str {
    (n != 0).match({
        true  => "nonzero",
        false => "zero",
    });
}

main = (env: Env) Res<i32, Error> {
    z: i32 = 0;
    println("{}", z + 7);
    println("{}", 12345 - 0);
    println("{}", 0 * 12345 + 9);
    println("{}", 1 - 0 - 0 - 0);
    u: u8 = 0;
    println("{}", u + 200);
    big: u64 = 0;
    println("{}", big + 4000000000);
    println("{}", is_zero(z));
    println("{}", is_zero(z + 1));
    Ok(0);
}
