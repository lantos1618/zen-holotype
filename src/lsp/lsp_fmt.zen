// Returns one whole-document edit only when the shared formatter accepts the
// buffer and changes it; invalid, unfaithful, and unchanged input returns `[]`.

str, String = std.text
Alloc, AllocError = std.mem
scan, Source, Lexed = std.lex
render = fmt.fmt
write_whole = lsp.lsp_pos
obj, arr = std.json

write_edits* = (a: Alloc, text: str, out :: String) Res<(), AllocError> {
    lexed = scan(a, Source(file: "doc", text: text)).try();
    lexed.is_clean().match({
        false => no_edits(out),
        true  => rendered(a, text, lexed, out),
    })
}

rendered = (a: Alloc, text: str, lexed: Lexed, out :: String)
           Res<(), AllocError> {
    shaped = render(a, lexed).try();
    (shaped.diags.len == 0
        && shaped.faithful
        && !text.eq(shaped.text.view())).match({
        false => no_edits(out),
        true  => whole_edit(text, shaped.text.view(), out),
    })
}

no_edits = (out :: String) Res<(), AllocError> {
    out.add("[]")
}

whole_edit = (text: str, shaped: str, out :: String) Res<(), AllocError> {
    edits ::= arr(out).try();
    edits.next(out).try();
    edit ::= obj(out).try();
    edit.key("range", out).try();
    write_whole(text, out).try();
    edit.text("newText", shaped, out).try();
    edit.close(out).try();
    edits.close(out)
}
