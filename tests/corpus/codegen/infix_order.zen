// THE SIDE-EFFECTING ORDERING TEST for OPERANDS, the sibling
// `argument_order.zen` said did not exist. Zen evaluates an operator's
// operands LEFT TO RIGHT; C leaves the order of `+`'s operands
// unspecified exactly as it does a call's arguments, and gcc takes both
// right to left — so a backend that writes both operands straight into
// one C infix expression answers `a.tick() * 10 + a.tick()` with 10.
// Issue #737; #717 fixed a call's arguments and said this half out loud.
//
// The same Counter as its sibling: tick ANSWERS a different value each
// time, so a wrong order is a wrong number and not a wrong print order.
//
// The shapes are where operand order is observable: two calls in one
// arithmetic chain, a call against a plain value, and a comparison --
// which lowers at its own level (`comparison_level`) rather than through
// the trap helpers the first two go through.

Counter = {
    n :: i32,

    tick = (self :: @Self) i32 {
        was    = self.n;
        self.n = self.n + 1;
        was;
    }
}

two = (a: i32, b: i32) i32 { a * 10 + b; }

main = (env: Env) Res<i32, AllocError> {
    // one chain, two ticks: left to right answers 1, right to left 10
    a ::= Counter(n: 0);
    println("chain {}", a.tick() * 10 + a.tick());

    // an operand beside a plain value keeps its place
    b ::= Counter(n: 0);
    println("mixed {}", b.tick() + b.n * 100);

    // a comparison's operands run in the order they are written
    c ::= Counter(n: 0);
    println("eq {}", c.tick() == c.n);

    // nothing on the LEFT runs: the call is on the RIGHT of a read, so
    // the plain left operand is held because of what follows it -- the
    // `has_call(b.rhs)` half of the gate (#737). Left to right reads n=0
    // first and tick answers 0 after it: 0. Right to left, tick answers 0
    // and leaves n=1, and the read sees 1.
    d ::= Counter(n: 0);
    println("rhs {}", d.n + d.tick());
    Ok(0);
}
