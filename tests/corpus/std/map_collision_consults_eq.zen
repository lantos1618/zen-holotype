// tests/corpus/std/map_collision_consults_eq.zen
// the sharpest form: a key that is ABSENT but hashes into an
// occupied bucket. a get that stops at `e.hash == h` answers Ok
// with somebody else's value; the required answer is None

Key = {
    id: i32,
}

Key.impl(Hash, {
    hash ::= (self: @Self, hasher :: Hasher) u64 { 7 }
})

Key.impl(Eq, {
    eq ::= (self: @Self, other: @Self) bool { self.id == other.id }
})

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    m ::= alloc.Map<Key, i32>();

    m.set(Key(id: 1), 100).try();
    m.set(Key(id: 2), 200).try();

    // same bucket as both entries, equal to neither
    m.get(Key(id: 9)).match({
        Ok(v) => println("absent {}", v),
        None  => println("absent none"),
    });
    Ok(0);
}
