// src/gen/gen_c/gen_c_bound.zen
// THE CALL THROUGH A BOUND'S RECORD, and the erasure round-trip it
// needs at both ends.
//
// `gen_c_fat.zen` is the other half: what a bound's record IS and how
// one is built. This is what happens when a value of one is CALLED —
// the only dynamic dispatch in the language, the one place a concrete
// type is unknown at the call site.
//
// TWO CONVERSIONS AND ONE MULTIPLICATION. Slots are erased to the byte
// type: an argument goes DOWN to the slot's type, the answer comes BACK
// UP to the caller's, and the element count erasure dropped travels
// beside the pointer. The multiplication lives only in the thunk
// (`gen_c_fat.zen` says why); this file does the two conversions and the
// `sizeof` feeding them.
//
// A CONVERSION REBUILDS, NEVER REINTERPRETS: a pointer is cast, a `Res`
// is rebuilt variant by variant — nothing here may assume two pointer
// types share a representation or two `Res` instantiations share a
// layout.

ExprId = std.ast
Function, Param, Access, Call, Arg = std.ast
AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId, TyNamed, TyRes = sema.sema_ty
Ctx = sema.sema_check
Inst, has_var = sema.sema_inst
self_ctx = sema.sema_member
param_type = sema.sema_type
sym_member, sym_gen, sym_variant = gen.gen_name
RES_PATH, is_failure = gen.gen_name
CBackend = gen.gen_c.gen_c_state
unsupported = gen.gen_c.gen_c_report
sub_with, enter_tparams, leave_tparams = gen.gen_c.gen_c_mono
unify, arg_type = gen.gen_c.gen_c_mono
enter_struct_tparams = gen.gen_c.gen_c_mono
ctype, is_unit, request_type, is_ptr_named, declared_ret = gen.gen_c.gen_c_type
expr, ty_of, value_held, holds = gen.gen_c.gen_c_expr
write_set_value = gen.gen_c.gen_c_widen
declare_temp = gen.gen_c.gen_c_flow
Site, site_of, join = gen.gen_c.gen_c_member
Slot, slots_of = gen.gen_c.gen_c_fat

// -----------------------------------------------------------------
// rebuilding a value at another type
//
// Erasure is what lets one slot serve every instantiation; this is the
// way back, under the header's rule that a conversion rebuilds.
// -----------------------------------------------------------------

convert* = (be :: CBackend, code: str, src: TyId, dst: TyId, out :: String)
           Res<(), AllocError> {
    src.eq(dst).match({
        true  => out.add_bytes(code),
        false => be.convert_kind(code, src, dst, out),
    })
}

convert_kind = (
    be   :: CBackend,
    code : str,
    src  : TyId,
    dst  : TyId,
    out  :: String
) Res<(), AllocError> {
    be.types().at(dst).match({
        Named(n) => be.convert_named(code, dst, n, out),
        Res(r)   => be.convert_res(code, src, dst, r, out),
        Union(_) => be.convert_set(code, src, dst, out),
        _        => out.add_bytes(code),
    })
}

// A MEMBER REACHING A SET IS TAGGED, NOT COPIED. `rebuild_res` walks
// into the error payload with `convert` again, so `Res<(), AllocError>`
// rebuilt at `Res<(), AllocError | Fault>` lands here with the member on
// one side and the set on the other — two different C structs, so a bare
// copy is a program `cc` refuses. Built by the same
// `gen_c_widen.write_set_value` that builds the written form.
//
// A SET REACHING A WIDER SET IS LEFT ALONE: its tags are numbered over
// its OWN members, so copying one across means a different member on
// the other side — a wrong error variant at runtime, from C that
// compiles. `gen_c_try.write_retag` maps it member by member as a
// switch statement, which a conversion in an expression buffer can't be.
convert_set = (
    be   :: CBackend,
    code : str,
    src  : TyId,
    dst  : TyId,
    out  :: String
) Res<(), AllocError> {
    be.tags_as_member(src, dst).match({
        false => out.add_bytes(code),
        true  => be.write_set_value(code, src, dst, out),
    })
}

tags_as_member = (be :: CBackend, src: TyId, dst: TyId) bool {
    be.types().at(src).match({
        Union(_) => false,
        _        => be.check.types.set_has(dst, src),
    })
}

convert_named = (
    be   :: CBackend,
    code : str,
    dst  : TyId,
    n    : TyNamed,
    out  :: String
) Res<(), AllocError> {
    is_ptr_named(n).match({
        true  => be.write_cast(code, dst, out),
        false => out.add_bytes(code),
    })
}

write_cast* = (be :: CBackend, code: str, dst: TyId, out :: String)
             Res<(), AllocError> {
    cty ::= be.alloc.String().try();
    be.ctype(dst, cty).try();
    out.fmt("(({}){code})", cty.view())
}

convert_res = (
    be   :: CBackend,
    code : str,
    src  : TyId,
    dst  : TyId,
    d    : TyRes,
    out  :: String
) Res<(), AllocError> {
    be.types().at(src).match({
        Res(s) => rebuild_res(be, code, src, s, dst, d, out),
        _      => out.add_bytes(code),
    })
}

// The value is read three times — its tag and each payload — so it
// lands in a temporary first.
rebuild_res = (
    be   :: CBackend,
    code : str,
    src  : TyId,
    s    : TyRes,
    dst  : TyId,
    d    : TyRes,
    out  :: String
) Res<(), AllocError> {
    be.request_type(dst).try();
    tmp ::= be.alloc.String().try();
    sym_gen(tmp, "t", be.next_tmp()).try();
    be.declare_temp(src, tmp.view()).try();
    be.set_line(tmp.view(), code).try();
    out.fmt("({}.zg_tag == ", tmp.view()).try();
    out.sym_variant(RES_PATH, "Ok").try();
    ok ::= be.alloc.String().try();
    be.res_arm(tmp.view(), "Ok", s.value, d.value, dst, ok).try();
    bad ::= be.alloc.String().try();
    be.fail_arm(tmp.view(), s, d, dst, bad).try();
    out.fmt(" ? {} : {})", ok.view(), bad.view())
}

fail_arm = (
    be  :: CBackend,
    tmp : str,
    s   : TyRes,
    d   : TyRes,
    dst : TyId,
    out :: String
) Res<(), AllocError> {
    is_failure(d.form).match({
        true  => be.res_arm(tmp, "Err", s.error, d.error, dst, out),
        false => be.bare_arm("None", dst, out),
    })
}

res_arm = (
    be  :: CBackend,
    tmp : str,
    v   : str,
    sp  : TyId,
    dp  : TyId,
    dst : TyId,
    out :: String
) Res<(), AllocError> {
    be.is_unit(dp).match({
        true  => be.bare_arm(v, dst, out),
        false => be.payload_arm(tmp, v, sp, dp, dst, out),
    })
}

bare_arm = (be :: CBackend, v: str, dst: TyId, out :: String)
           Res<(), AllocError> {
    be.arm_head(v, dst, out).try();
    out.add_bytes(" })").try();
    Ok(());
}

payload_arm = (
    be  :: CBackend,
    tmp : str,
    v   : str,
    sp  : TyId,
    dp  : TyId,
    dst : TyId,
    out :: String
) Res<(), AllocError> {
    be.arm_head(v, dst, out).try();
    mem ::= be.alloc.String().try();
    mem.sym_member(v).try();
    read ::= be.alloc.String().try();
    read.fmt("{tmp}.zg_data.").try();
    sym_member(read, v).try();
    val ::= be.alloc.String().try();
    be.convert(read.view(), sp, dp, val).try();
    out.fmt(", .zg_data.{} = {} })", mem.view(), val.view())
}

arm_head = (be :: CBackend, v: str, dst: TyId, out :: String)
           Res<(), AllocError> {
    cty ::= be.alloc.String().try();
    be.ctype(dst, cty).try();
    out.fmt("(({}){ .zg_tag = ", cty.view()).try();
    out.sym_variant(RES_PATH, v).try();
    Ok(());
}

// -----------------------------------------------------------------
// the call through the record
//
// The value IS the bound, so which function runs is decided by the
// impl behind the receiver and nothing static can say which. Every
// other call — a concrete-type receiver — is the impl's own function,
// called directly and monomorphised.
// -----------------------------------------------------------------

lower_fat_call* = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    s   : Site,
    f   : Function,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    slots ::= be.alloc.Vec<Slot>();
    be.slots_of(rty, slots).try();
    pick_slot(slots, a.name.text, c.args.len).match({
        None     => be.unsupported(
            id,
            "a call through a bound with no such member",
            out
        ),
        Ok(slot) => settle_call(be, id, c, a, rty, s, slot, ctx, out),
    })
}

// A CALL THROUGH A BOUND'S RECORD THAT THE SOURCE DID NOT WRITE: a
// capability's body IS this backend, so there is no call node to lower
// and the record is still the only way to reach the impl — `Fs.read`
// allocating through its `Alloc`, `Sink.write` through its writer. The
// slot comes back too, since the caller needs a temporary at the type
// it answers with.
//
// Arguments arrive as text, each already comma-prefixed — only the
// caller knows what they are. A member with its own type parameters
// isn't reachable this way and doesn't need to be: `raw` is bytes and
// nothing more.
slot_call* = (
    be   :: CBackend,
    recv : str,
    tty  : TyId,
    name : str,
    args : str,
    argc : usize,
    out  :: String
) Res<Res<Slot>, AllocError> {
    slots ::= be.alloc.Vec<Slot>();
    be.slots_of(tty, slots).try();
    pick_slot(slots, name, argc).match({
        None     => Ok(None),
        Ok(slot) => be.write_named_slot(recv, slot, args, out),
    })
}

write_named_slot = (
    be   :: CBackend,
    recv : str,
    slot : Slot,
    args : str,
    out  :: String
) Res<Res<Slot>, AllocError> {
    be.request_type(slot.ret).try();
    out.fmt("{recv}.{}({recv}.zg_self{args})", slot.sym.view()).try();
    Ok(Ok(slot));
}

// By name and by ARITY: "resolution is on declared parameter types and
// arity", and a bound may declare two members of one name.
pick_slot = (slots: Vec<Slot>, name: str, args: usize) Res<Slot> {
    Range(0, slots.len).find((i) {
        slots.get(i).match({
            Ok(s) => s.name.eq(name) && (s.params.len == args),
            None  => false,
        })
    }).match({
        None  => None,
        Ok(i) => slots.get(i),
    })
}

// WHAT THE MEMBER'S OWN TYPE PARAMETERS BECAME, read off the arguments.
// The slot is erased, so the element size the call hands it comes from
// here — a parameter nothing settles is a refusal, not a `sizeof` of the
// wrong thing.
settle_call = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    a    : Access,
    rty  : TyId,
    s    : Site,
    slot : Slot,
    ctx  : Ctx,
    out  :: String
)
              Res<(), AllocError> {
    declared ::= be.alloc.Vec<TyId>();
    targs    ::= be.alloc.Inst();
    ret = be.read_slot(c, rty, s, slot, ctx, declared, targs).try();
    be.targs_settled(slot, targs).match({
        false => be.unsupported(
            id,
            "a call through a bound whose type arguments nothing settles",
            out
        ),
        true  => be.emit_fat_call(
            c,
            a,
            rty,
            slot,
            declared,
            ret,
            targs,
            ctx,
            out
        ),
    })
}

// THE DECLARATION'S OWN READING OF A SLOT: parameter types as written,
// return type as written, and what the arguments make of the member's
// type parameters. `settle_call` writes the call from these,
// `fat_ret_type` answers with them, and the two must not disagree — the
// temporary's declared type and the type the call rebuilds to must
// match or the C is rejected.
read_slot = (
    be       :: CBackend,
    c        : Call,
    rty      : TyId,
    s        : Site,
    slot     : Slot,
    ctx      : Ctx,
    declared :: Vec<TyId>,
    targs    :: Inst
)
            Res<TyId, AllocError> {
    owner ::= be.alloc.String().try();
    join(owner, s.qname, slot.name).try();
    sctx = be.check.self_ctx(s.decl.module.to_usize(), rty).try();
    mark = be.enter_struct_tparams(s.decl).try();
    be.enter_tparams(slot.f.tparams, owner.view()).try();
    be.declared_params(slot.f, sctx, declared).try();
    ret = be.declared_ret(slot.f, sctx).try();
    infer_targs(be, c, declared, ctx, targs).try();
    be.leave_tparams(mark).try();
    Ok(ret);
}

// WHAT A CALL THROUGH A RECORD IS WORTH, for a caller that has to name
// the type before the call is written.
//
// A BOUND'S MEMBER IS NOT A DECLARATION THE WORLD HOLDS: `realloc` is
// declared inside `Alloc`, so `gen_c_infer`'s walk over `defs_of` finds
// nothing and hands back the caller's own guess — for a generic member,
// the DECLARED `Res<Ptr<T>, E>`, a C struct with an unresolved element.
// `Buf.grow` caught it: `self.alloc.realloc(self.data, cap).try()`
// declared its temporary at `Res<Ptr<q>, AllocError>` and assigned the
// slot's `Res<Ptr<u8>, AllocError>` into it — `cc` rejected a program
// sema had admitted.
//
// The answer is `sub_with(ret, targs)`, the same value `fat_result`
// converts the erased answer BACK to, read off the same `read_slot` —
// two derivations of one type would be two chances to disagree.
fat_ret_type* = (be :: CBackend, c: Call, a: Access, ctx: Ctx)
                Res<Res<TyId>, AllocError> {
    unknown = be.check.types.unknown().try();
    rty     = be.ty_of(a.base, ctx, unknown).try();
    slots ::= be.alloc.Vec<Slot>();
    be.slots_of(rty, slots).try();
    pick_slot(slots, a.name.text, c.args.len).match({
        None     => Ok(None),
        Ok(slot) => be.slot_ret_type(c, rty, slot, ctx),
    })
}

slot_ret_type = (be :: CBackend, c: Call, rty: TyId, slot: Slot, ctx: Ctx)
                Res<Res<TyId>, AllocError> {
    site_of(be, rty).try().match({
        None  => Ok(None),
        Ok(s) => be.settled_ret_type(c, rty, s, slot, ctx),
    })
}

// A TYPE ARGUMENT NOTHING SETTLES IS NO ANSWER — the same refusal
// `settle_call` makes one door along: the call it would describe is one
// this backend goes on to refuse, so answering here would name a type
// no call is ever written at.
settled_ret_type = (
    be   :: CBackend,
    c    : Call,
    rty  : TyId,
    s    : Site,
    slot : Slot,
    ctx  : Ctx
) Res<Res<TyId>, AllocError> {
    declared ::= be.alloc.Vec<TyId>();
    targs    ::= be.alloc.Inst();
    ret = be.read_slot(c, rty, s, slot, ctx, declared, targs).try();
    be.targs_settled(slot, targs).match({
        false => Ok(None),
        true  => Ok(Ok(be.sub_with(ret, targs).try())),
    })
}

declared_params = (
    be   :: CBackend,
    f    : Function,
    sctx : Ctx,
    out  :: Vec<TyId>
) Res<(), AllocError> {
    f.params.loop((h, i, p) { be.declared_param(p, i, sctx, out).try() });
    Ok(());
}

declared_param = (
    be   :: CBackend,
    p    : Param,
    i    : usize,
    sctx : Ctx,
    out  :: Vec<TyId>
) Res<(), AllocError> {
    (i == 0).match({
        true  => Ok(()),
        false => be.add_declared(p, sctx, out),
    })
}

add_declared = (be :: CBackend, p: Param, sctx: Ctx, out :: Vec<TyId>)
               Res<(), AllocError> {
    out.add(be.check.param_type(p, sctx).try())
}

infer_targs = (
    be       :: CBackend,
    c        : Call,
    declared : Vec<TyId>,
    ctx      : Ctx,
    out      :: Inst
) Res<(), AllocError> {
    c.args.loop((h, i, arg) {
        be.infer_one(arg, i, declared, ctx, out).try();
    });
    Ok(());
}

infer_one = (
    be       :: CBackend,
    arg      : Arg,
    i        : usize,
    declared : Vec<TyId>,
    ctx      : Ctx,
    out      :: Inst
) Res<(), AllocError> {
    declared.get(i).match({
        None  => Ok(()),
        Ok(d) => be.infer_against(arg, d, ctx, out),
    })
}

infer_against = (be :: CBackend, arg: Arg, d: TyId, ctx: Ctx, out :: Inst)
                Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    actual  = be.arg_type(arg.value, ctx, unknown).try();
    unify(be, d, actual, out)
}

// Every parameter bound, and bound to something closed. A free argument
// would become a `sizeof` of a type C has no name for. Named for its own
// question -- are the TYPE ARGUMENTS settled -- and not `settled`, which
// gen_c_settle.zen answers about a single TyId.
targs_settled = (be: CBackend, slot: Slot, targs: Inst) bool {
    (targs.len() == slot.elems) && be.all_closed(targs)
}

all_closed = (be: CBackend, targs: Inst) bool {
    Range(0, targs.len()).find((i) {
        targs.arg_at(i).match({ Ok(t) => has_var(be.check, t), None => true })
    }).match({ Ok(_) => false, None => true })
}

// `<r> = <the receiver>; <r>.<slot>(<r>.zg_self, <args>, sizeof(T)..)`
//
// The receiver lands in a temporary: it is read twice — the slot and
// the `void *` behind it — and read twice is evaluated twice.
emit_fat_call = (
    be       :: CBackend,
    c        : Call,
    a        : Access,
    rty      : TyId,
    slot     : Slot,
    declared : Vec<TyId>,
    ret      : TyId,
    targs    : Inst,
    ctx      : Ctx,
    out      :: String
) Res<(), AllocError> {
    recv ::= be.alloc.String().try();
    expr(be, a.base, ctx, rty, recv).try();
    r ::= be.alloc.String().try();
    sym_gen(r, "t", be.next_tmp()).try();
    be.declare_temp(rty, r.view()).try();
    be.set_line(r.view(), recv.view()).try();
    call ::= be.alloc.String().try();
    call.fmt("{}.{}({}.zg_self", r.view(), slot.sym.view(), r.view()).try();
    be.fat_args(c, slot, declared, targs, ctx, call).try();
    be.fat_sizes(targs, call).try();
    call.add_bytes(")").try();
    be.fat_result(slot, ret, targs, call.view(), out)
}

fat_args = (
    be       :: CBackend,
    c        : Call,
    slot     : Slot,
    declared : Vec<TyId>,
    targs    : Inst,
    ctx      : Ctx,
    out      :: String
) Res<(), AllocError> {
    c.args.loop((h, i, arg) {
        hold = be.holds(c, i + 1, 1);
        be.fat_arg(arg, i, hold, slot, declared, targs, ctx, out).try();
    });
    Ok(());
}

// The argument at the type the DECLARATION gives it — which is what
// turns an `Arena` into an `Alloc` one level down — then converted to
// the erased type the slot carries.
fat_arg = (
    be       :: CBackend,
    arg      : Arg,
    i        : usize,
    hold     : bool,
    slot     : Slot,
    declared : Vec<TyId>,
    targs    : Inst,
    ctx      : Ctx,
    out      :: String
)
          Res<(), AllocError> {
    want = be.sub_with(at_or_zero(declared, i), targs).try();
    text ::= be.alloc.String().try();
    be.value_held(arg.value, ctx, want, hold, text).try();
    out.add_bytes(", ").try();
    be.convert(text.view(), want, at_or_zero(slot.params, i), out).try();
    Ok(());
}

at_or_zero = (v: Vec<TyId>, i: usize) TyId {
    v.get(i).match({ Ok(t) => t, None => TyId(index: 0) })
}

// The element size the slot's erasure dropped, one per parameter, in
// declaration order.
fat_sizes = (be :: CBackend, targs: Inst, out :: String)
            Res<(), AllocError> {
    Range(0, targs.len()).loop((h, i) { be.fat_size(targs, i, out).try() });
    Ok(());
}

fat_size = (be :: CBackend, targs: Inst, i: usize, out :: String)
           Res<(), AllocError> {
    targs.arg_at(i).match({
        None  => out.add_bytes(", 1"),
        Ok(t) => be.write_sizeof(t, out),
    })
}

// THE SIZE IS `sizeof` AND NOT A NUMBER THIS COMPILER KNOWS: a layout
// this backend never modelled cannot disagree with the one `cc` chose.
write_sizeof* = (be :: CBackend, t: TyId, out :: String)
               Res<(), AllocError> {
    be.request_type(t).try();
    cty ::= be.alloc.String().try();
    be.ctype(t, cty).try();
    out.fmt(", sizeof({})", cty.view())
}

// The slot answers at the ERASED type; the caller asked at its own. A
// void-returning slot has nothing to rebuild and still has to run.
fat_result = (
    be    :: CBackend,
    slot  : Slot,
    ret   : TyId,
    targs : Inst,
    call  : str,
    out   :: String
) Res<(), AllocError> {
    real = be.sub_with(ret, targs).try();
    be.is_unit(slot.ret).match({
        true  => be.fat_effect(call, out),
        false => be.fat_value_back(slot, real, call, out),
    })
}

fat_effect = (be :: CBackend, call: str, out :: String)
             Res<(), AllocError> {
    be.fmt("{call};\n").try();
    out.add_bytes("0")
}

fat_value_back = (
    be   :: CBackend,
    slot : Slot,
    real : TyId,
    call : str,
    out  :: String
) Res<(), AllocError> {
    be.request_type(slot.ret).try();
    be.request_type(real).try();
    tmp ::= be.alloc.String().try();
    sym_gen(tmp, "t", be.next_tmp()).try();
    be.declare_temp(slot.ret, tmp.view()).try();
    be.set_line(tmp.view(), call).try();
    be.convert(tmp.view(), slot.ret, real, out)
}
