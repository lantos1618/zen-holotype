// tests/corpus/traps/div_zero_i32.zen
// x / 0 traps. the divisor comes from the environment, so no
// constant folder can turn this into a compile-time question

// main must name an error type. a trap never lifts into Res:
// it aborts the process
Error = Overflow | DivideByZero | OutOfBounds

main = (env: Env) Res<i32, Error> {
    // a zero the compiler cannot see: it comes from the environment
    zero: i32 = env.var("ZEN_TRAP_NEVER_SET").match({
        Ok(_) => 1,
        None  => 0,
    });
    q         = 10 / zero;
    println("{}", q);
    Ok(0);
}
