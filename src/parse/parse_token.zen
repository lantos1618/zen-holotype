// src/parse/parse_token.zen
// What the parser asks of a token, and nothing else.
//
// The alphabet itself is `src/lex/lex_token.zen`'s and is re-exported
// here unchanged, so a sibling writes `TokenKind` once and imports it
// from one place. What this file adds is two questions the lexer had
// no reason to answer, because neither is about scanning: are two
// kinds the same kind, and is this kind trivia.
//
// THIS FILE WAS WRITTEN BEFORE THE LEXER EXISTED, as a stated
// interface the parser could be built against while `src/lex/` was
// being built in parallel. It has now been reconciled with the real
// one. Four assumptions held and three did not; each disagreement is
// recorded here rather than papered over, because the next person to
// read `Token` will want to know which side moved.
//
//   HELD. Comments are tokens rather than a second list, so the parser
//   sees everything and decides ownership once. Exactly one `Eof`,
//   last, spanning nothing, so no parse loop needs a length check.
//   Kinds are FLAT rather than a nested `Punct(..)`. A token is a kind
//   and a span.
//
//   MOVED — A TOKEN CARRIES NO TEXT. The assumed shape was
//   `{kind, text, span}`; the real one is `{kind, span}` and the bytes
//   come from `text_of(source, token)`, which slices the `Source`. The
//   lexer is right and the assumption was wasteful: a `str` is two
//   words on every token of a ten-megabyte file, to hold something
//   both ends of the span already name. The parser therefore carries
//   the `Source` — see `Parser.source`.
//
//   MOVED — THERE IS NO `Blank` TOKEN. The assumption was that a run
//   of blank lines arrives as a token, because `TriviaKind.Blank`
//   exists and something has to produce it. The lexer does not emit
//   whitespace at all, and its reason is better than the assumption:
//   it "is recoverable exactly from the gap between two spans, and
//   'was there a blank line here' is `next.start.line >
//   prev.end.line + 1` rather than a stored fact that can go stale."
//   So the parser derives it, in `drain`, and that is the whole cost.
//
//   MOVED — THERE IS NO `Underscore` TOKEN. `_` matches the identifier
//   rule, and the lexer says so deliberately: "the parser reads the
//   wildcard pattern, the lexer only sees a name". So `_` arrives as
//   an `Ident` and the two places that care — a wildcard pattern and
//   an inferred type — compare its text. That is right: `_` is a
//   spelling question in two grammatical positions, not a lexical one.
//
// ONE DISAGREEMENT IS STILL OPEN AND IS NOT THIS MODULE'S TO CLOSE.
// `lex` and `ast` each declare a `Pos` and a `Span`, and they are
// different types: the lexer's `Pos` carries `offset` beside `line`
// and `col`, and its `Span` carries no `file` because every token of
// one run shares it. Both choices are right for a lexer and neither is
// right for an AST node, which outlives its `Source` and is compared
// across files. So the parser CONVERTS, once, in `Parser.span_of`.
// That is the honest place for it — but `ast_span.zen` landing after
// `lex_token.zen` means nobody has yet decided whether one type should
// serve both. Reported; `src/lex/` and `src/ast/` are not ours to edit.

Token*, TokenKind*, Source*, Lexed*, text_of*, kind_name* = lex.lex

Pos, Span = lex.lex

// The token a cursor reads when there is nothing to read.
//
// `scan` promises exactly one `Eof`, last, so this is unreachable on
// any stream a lexer produced — but a parser that traps on an empty
// one crashes on a bug somewhere else, and the crash is what nobody
// can diagnose.
//
// It is built HERE rather than in parser.zen for a reason that is a
// bootstrapper bug and not a design: `lex` and `ast` both declare a
// `Span`, so parser.zen cannot name the lexer's, and constructing
// through an alias (`LexSpan* = Span`, then `LexSpan(..)`) emits the
// ALIAS'S ZEN NAME as a C function call and does not compile.
// Reported with a reproducer. This file imports only the lexer's, so
// here the name is unambiguous and no alias is needed.
empty_eof* = () Token {
    at = Pos(offset: 0, line: 1, col: 1);
    Token(kind: TokenKind.Eof, span: Span(start: at, end: at));
}

// A kind's number, which is what makes two kinds comparable.
//
// This exists because `==` on an enum value does not work: the
// bootstrapper's sema accepts it and `gen_c` emits `a == b` on two C
// structs, which is not C. Reported with a reproducer. When it is
// fixed this function and every `.tag()` beside it delete, and the
// alphabet loses nothing — the numbering is an implementation detail
// with no meaning of its own, which is why nothing outside this module
// may depend on a particular value.
tag* = (self: TokenKind) usize {
    self.match({
        Ident        => 0,
        Int(_)       => 1,
        Float        => 2,
        Str          => 3,
        Char         => 4,
        True         => 5,
        False        => 6,
        Consume      => 7,
        AtSelf       => 8,
        AtMeta       => 9,
        AtScope      => 10,
        ParenOpen    => 11,
        ParenClose   => 12,
        BracketOpen  => 13,
        BracketClose => 14,
        BraceOpen    => 15,
        BraceClose   => 16,
        Comma        => 17,
        Semicolon    => 18,
        Dot          => 19,
        Ellipsis     => 20,
        Colon        => 21,
        ColonColon   => 22,
        Eq           => 23,
        ColonColonEq => 24,
        Arrow        => 25,
        Plus         => 26,
        Minus        => 27,
        Star         => 28,
        Slash        => 29,
        Percent      => 30,
        PlusWrap     => 31,
        MinusWrap    => 32,
        StarWrap     => 33,
        EqEq         => 34,
        BangEq       => 35,
        Lt           => 36,
        Gt           => 37,
        LtEq         => 38,
        GtEq         => 39,
        AmpAmp       => 40,
        BarBar       => 41,
        Bang         => 42,
        Amp          => 43,
        Bar          => 44,
        LineComment  => 45,
        BlockComment => 46,
        Eof          => 47,
    });
}

// Two kinds are the same kind. The parser asks this a few hundred
// times and a forty-arm match at each site is a table, not a
// comparison.
same* = (self: TokenKind, other: TokenKind) bool { self.tag() == other.tag() }

// Whether a kind is trivia, asked in exactly one place — the cursor's
// advance — and answered here because it is a fact about the alphabet
// and not about the cursor.
is_trivia* = (kind: TokenKind) bool {
    kind.match({
        LineComment  => true,
        BlockComment => true,
        _            => false,
    });
}

// The one identifier the parser reads as a keyword. `_` lexes as a
// name, so a wildcard pattern and an inferred type are the only two
// things that ever ask, and they ask through this rather than each
// spelling the underscore themselves.
WILDCARD*: str = "_"
