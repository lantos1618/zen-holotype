// Command selection and argument parsing. argv and option values remain
// borrowed. `--repeat` and `--permute` are internal determinism controls.

Alloc, AllocError = std.mem
str = std.text
Vec = std.collections
Range = std.core
Env = std.env
BuildArgs, ProjectArgs, BuildFlags, build_options = std.build
FLAG_EMIT_C, ZEN_STD_ENV = std.build
Options, options, is_word, arg_at, OPTIONS_END = std.cli
holds_build_zen = zen.zen_path

Cli* = Build(BuildArgs)
     | Project(ProjectArgs)
     | Run(ProjectArgs)
     | Fmt(FmtJob)
     | Later(str)     // test / lsp — named, and not yet written
     | Usage(str)     // the word that made no sense; empty means nothing was said
     | Missing(str)   // a flag the build needs and did not get

// `zen fmt` takes files; zen_fmt validates that they are not directories.
FmtJob* = {
    argv*: Vec<str>,

    // `--check` reports without writing.
    check*: bool,

    // Every path the caller named.
    paths* = (self: @Self, a: Alloc) Res<Vec<str>, AllocError> {
        out ::= a.Vec<str>();
        Range(ARGS, self.argv.len).loop((h, i) {
            word = arg_at(self.argv, i);
            is_word(word).match({
                true  => out.add(word),
                false => Ok(()),
            }).try();
        });
        Ok(out);
    }
}

// argv[0] is the program and argv[1] is the command.
ARGS*: usize = 2

USAGE*: str = "usage: zen build [<project-or-target>]\n       zen run [<project-or-target>] [-- <args>...]\n       zen build <root> [--entry <file>] [--std <path>] [--ffi] [--symbol-map <file>] --emit-c -o <file.c>\n       zen build <root> [--entry <file>] [--std <path>] [--ffi] [--symbol-map <file>] --emit-c-dir <dir>\n       zen fmt [--check] <file.zen>..."

FLAG_FMT_CHECK: str = "--check"

FmtFlag = | Check

cli* = (env: Env, argv: Vec<str>) Res<Cli, AllocError> {
    alloc = env.mem.alloc();
    argv.get(1).match({
        None     => Ok(Cli.Usage("")),
        Ok(name) => command(env, alloc, argv, name),
    })
}

command = (env: Env, a: Alloc, argv: Vec<str>, name: str)
          Res<Cli, AllocError> {
    name.match({
        "build" => job_of(env, a, argv),
        "run"   => project_of(env, a, argv, true),
        "fmt"   => fmt_of(a, argv),
        "test"  => Ok(Cli.Later(name)),
        "lsp"   => Ok(Cli.Later(name)),
        _       => Ok(Cli.Usage(name)),
    })
}

// `zen fmt [--check] <file.zen>...` requires at least one path.
fmt_of = (a: Alloc, argv: Vec<str>) Res<Cli, AllocError> {
    declared = fmt_options(a).try();
    scan  ::= declared.args(argv, ARGS);
    check ::= false;
    words ::= 0;
    loop(() { !scan.done() }, (h) {
        scan.next().match({
            Ok(item) => item.named.match({
                Ok(flag) => flag.match({ Check => { check = true; } }),
                None     => { words = words + word_count(item.word); },
            }),
            None     => (),
        });
    });
    Ok(fmt_verdict(argv, check, scan.bad, words));
}

fmt_options = (a: Alloc) Res<Options<FmtFlag>, AllocError> {
    declared ::= options<FmtFlag>(a);
    declared.flag(FLAG_FMT_CHECK, FmtFlag.Check).try();
    Ok(declared)
}

word_count = (word: str) usize {
    is_word(word).match({
        true  => 1,
        false => 0,
    })
}

fmt_verdict = (argv: Vec<str>, check: bool, bad: str, words: usize) Cli {
    bad.is_empty().match({
        false => Cli.Usage(bad),
        true  => (words == 0).match({
            true  => Cli.Usage(""),
            false => Cli.Fmt(FmtJob(argv: argv, check: check)),
        }),
    })
}

// Parse shared option syntax into BuildFlags, then validate it as a command.
job_of = (env: Env, a: Alloc, argv: Vec<str>) Res<Cli, AllocError> {
    parsed ::= BuildFlags(
        std_root: env.var(ZEN_STD_ENV).match({ Ok(p) => p, None => "" })
    );
    declared = build_options(a).try();
    scan ::= declared.args(argv, ARGS);
    loop(() { !scan.done() }, (h) {
        scan.next().match({
            Ok(item) => item.named.match({
                Ok(flag) => item.word.is_empty().match({
                    true  => parsed.apply_switch(flag),
                    false => parsed.apply_setting(flag, item.word),
                }),
                None     => parsed.root.is_empty().match({
                    true  => parsed.set_root(item.word),
                    false => scan.reject(item.word),
                }),
            }),
            None     => (),
        });
    });
    parsed.compiles_source().match({
        true  => Ok(verdict(parsed, scan.bad)),
        false => project_of(env, a, argv, false),
    })
}

// The stdlib root is left empty: `cli` allocates in a scratch arena, and
// `zen.project_cli` resolves the root in one that outlives the build.
project_of = (env: Env, a: Alloc, argv: Vec<str>, run: bool)
             Res<Cli, AllocError> {
    first = arg_at(argv, ARGS);
    root   ::= ".";
    target ::= "";
    at     ::= ARGS;
    (!first.is_empty() && !first.eq(OPTIONS_END)).then(() {
        holds_build_zen(env, a, first).match({
            true  => { root = first; },
            false => { target = first; },
        });
        at = at + 1;
    });
    arg_at(argv, at).eq(OPTIONS_END).then(() { at = at + 1; });
    bad = (!run && at < argv.len).match({
        true  => arg_at(argv, at),
        false => "",
    });
    bad.is_empty().match({
        false => Ok(Cli.Usage(bad)),
        true  => {
            job = ProjectArgs(
                root: root,
                target: target,
                argv: argv,
                args_at: at
            );
            run.match({ true => Ok(Cli.Run(job)), false => Ok(Cli.Project(job)) })
        },
    })
}

verdict = (args: BuildFlags, bad: str) Cli {
    bad.is_empty().match({
        false => Cli.Usage(bad),
        true  => args.finish().match({
            Err(MissingRoot) => Cli.Usage(""),
            Err(MissingEmit) => Cli.Missing(FLAG_EMIT_C),
            Ok(job)          => Cli.Build(job),
        }),
    })
}
