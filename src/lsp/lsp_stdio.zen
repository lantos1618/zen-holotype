// Runs the server over stdin/stdout. Partial envelopes remain buffered until
// `Content-Length` bytes arrive; notifications produce no output frame.

str, String, str_at = std.text
Vec = std.collections
Alloc, AllocError = std.mem
Server = lsp.lsp_serve
FrameFault, frame_at, short_by, partial = lsp.lsp_frame

Drain* = {
    at*: usize,
    framed*: bool,
}

serve_stdio* = (env: Env, a: Alloc) Res<i32, AllocError> {
    server      ::= a.Server(env);
    input_arena ::= env.mem.alloc();
    held        ::= input_arena.Vec<u8>();
    at          ::= 0;
    open        ::= true;
    framed      ::= true;
    loop(() { open && framed && !server.stopped() }, (h) {
        seen  = str_at(held.ptr(), held.len);
        open  = arrived(env, held, short_by(seen, at)).try();
        bytes = str_at(held.ptr(), held.len);
        frame_at(bytes, at).match({
            Err(f) => {
                framed = partial(f);
                fault_line(f, framed);
            },
            Ok(_)  => {
                batch ::= env.mem.alloc();
                d      = drain(server, batch, bytes, at).try();
                at     = d.at;
                framed = d.framed;
                after_drain(server, batch).try();
                (at == held.len).then(() {
                    held.clear();
                    at = 0;
                });
            },
        });
    });
    Ok(exit_code(server.stopped(), framed));
}

after_drain = (server :: Server, t: Alloc) Res<(), AllocError> {
    out ::= t.String().try();
    server.settled(t, out).try();
    print(out.view());
    Ok(());
}

arrived = (env: Env, held :: Vec<u8>, n: usize) Res<bool, AllocError> {
    want = at_least_one(n);
    held.reserve(want).try();
    env.in.read(held, want).match({
        Err(_)  => Ok(false),
        Ok(got) => Ok(got > 0),
    })
}

at_least_one = (n: usize) usize {
    (n == 0).match({ true => 1, false => n })
}

drain = (server :: Server, t: Alloc, held: str, at: usize)
        Res<Drain, AllocError> {
    from   ::= at;
    more   ::= true;
    framed ::= true;
    loop(() { more && from < held.len }, (h) {
        frame_at(held, from).match({
            Ok(fr) => { from = fr.next; answered(server, t, fr.body).try(); },
            Err(f) => { more = false; framed = partial(f); fault_line(f, framed); },
        });
    });
    Ok(Drain(at: from, framed: framed));
}

answered = (server :: Server, t: Alloc, body: str) Res<(), AllocError> {
    out ::= t.String().try();
    server.one(t, body, out).try();
    print(out.view());
    Ok(());
}

fault_line = (f: FrameFault, framed: bool) () {
    framed.match({
        true  => (),
        false => println("lsp: bad frame at byte {} ({})", f.byte(), f.why()),
    });
}

exit_code = (stopped: bool, framed: bool) i32 {
    (stopped && framed).match({ true => 0, false => 1 })
}
