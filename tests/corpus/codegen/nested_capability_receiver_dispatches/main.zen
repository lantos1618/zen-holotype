Session = {
    env: Env,

    flush = (self: @Self) Res<(), IoError> {
        self.env.out.flush()
    }
}

Printer = {}

Printer.impl(Actor, {
    started = (self :: @Self, ctx: Context) {
        print("actor capability");
        ctx.env.out.flush().match({ Ok(_) => (), Err(_) => () });
        println(" ok")
    }
})

Error = IoError | ActorStartError

main = (env: Env) Res<i32, Error> {
    print("nested capability");
    Session(env: env).flush().try();
    println(" ok");
    printer = env.spawn(Printer()).try();
    printer.stop();
    printer.join();
    Ok(0)
}
