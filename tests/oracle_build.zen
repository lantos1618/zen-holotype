    // a top-level fn named after an intrinsic is a MISCOMPILE if accepted: calls dispatch on the
    // name in genc, so they'd hit the intrinsic (deref/segfault/cc error), never the user fn.
    // NEAR-MISS names are ordinary fns — the reject is exact-name only.
    // a LOCAL fn value may shadow an intrinsic name (#370/#377 route its calls soundly).
    // a STRUCT METHOD named like an intrinsic is hoisted under a mangled `impl_…` name — allowed.
    // ── (g) POSITIONED diagnostics: kind + file:line:col + caret + message + hint ─────────────────
    dg := run_diags("build diagnostics", [DiagCase(
        src: "R*: Ok(str) | Err(i32)\nmain = () i32 {\n    done := false\n    r: R = .Err(3)\n    s := r.match ({\n        .Ok(ns) => ns,\n        .Err(e) => { done = true },\n    })\n    0\n}\n",
        wants: [":7:22: error[arm-value]: match arm yields no value, but the match result is used as a value", "  .Err(e) => { done = true },", "^~~~", "hint: end every arm with an expression of the match's result type (or a diverging `return`); or stop consuming the match as a value and assign within each arm"],
    ), DiagCase(
        src: "// entry\nmain = (rt: i32) i32 {\n    return 0\n}\n",
        wants: [":2:1: error[main-signature]: `main` must be `() i32` or `(sys: Sys) i32`", "  main = (rt: i32) i32 {", "  ^~~~", "hint: declare it `main = () i32 { … }`, or take the root capability `main = (sys: Sys) i32 { … }` (import `{ Sys } = std.sys`) and thread narrow caps like `sys.stdout()` / `sys.heap()`"],
    ), DiagCase(
        src: "{ help } = util.helpers\nmain = () i32 { help() }\n",
        wants: ["error: no module 'util.helpers'", "local imports name a single sibling file: `{ f } = helper` loads helper.zen next to", "only std/compiler modules use dotted paths, e.g. `std.text.fmt`"],
    ), DiagCase(
        src: "add = (a: i32, b: i32) i32 { a + b }\nmain = () i32 { add(1) }\n",
        wants: [":2:17: error[arity]: wrong number of arguments", "  main = () i32 { add(1) }", "                  ^~~", "hint: check the callee signature and pass exactly the declared parameters"],
    ), DiagCase(
        src: "takes_u8 = (b: u8) i32 { 0 }\nbig = () i64 { 9999999999 }\nmain = () i32 { takes_u8(big()) }\n",
        wants: [":3:26: error[arg-type]: expected `u8`, got `i64`", "  main = () i32 { takes_u8(big()) }", "                           ^~~", "hint: check the argument type or add an explicit conversion at the call site"],
    ), DiagCase(
        src: "f = (x: i32) i32 { x }\nmain = () i32 { f(\"s\") }\n",
        wants: [":2:19: error[arg-type]: expected `i32`, got `str`", "  main = () i32 { f(\"s\") }", "                    ^~~", "hint: check the argument type or add an explicit conversion at the call site"],
    ), DiagCase(
        src: "Show*: { render: (Ptr<Self>) i32 }\nPoint*: { x: i32 }\nPoint.impl(Show, { })\n",
        wants: [":3:1: error[conformance]: impl does not satisfy the trait", "  Point.impl(Show, { })", "  ^~~~~", "hint: define every required trait method with the exact receiver, parameter, and return types"],
    ), DiagCase(
        src: "Show*: { render: (Ptr<Self>) i32 }\nCircle*: { r: i32 }\nCircle.impl(Show, { render = (c: Ptr<Circle>) i32 { c.r } })\nBlob*: { v: i32 }\ndraw<A: Show> = (a: A) i32 { 0 }\nmain = () i32 { b := Blob(v: 3)  draw(b) }\n",
        wants: [":6:34: error[trait-bound]: type `Blob` does not satisfy the bound `Show` required by `draw` — missing method(s): render", "  main = () i32 { b := Blob(v: 3)  draw(b) }", "                                   ^~~~", "hint: implement the bound trait for this type (`Type.impl(Trait, { … })`), or relax the bound"],
    ), DiagCase(
        src: "Show*: { render: (Ptr<Self>) i32 }\nBlob*: { v: i32 }\nmain = () i32 { b := Blob(v: 3)  b.render() }\n",
        wants: [":3:36: error[trait-bound]: type `Blob` does not implement trait `Show` (which declares `render`) — missing method(s): render", "  main = () i32 { b := Blob(v: 3)  b.render() }", "                                     ^~~~~~", "hint: implement the bound trait for this type (`Type.impl(Trait, { … })`), or relax the bound"],
    ), DiagCase(
        src: "Show*: { render: (Ptr<Self>) i32 }\nCircle*: { r: i32 }\nCircle.impl(Show, { render = (c: Ptr<Circle>) i32 { c.r } })\nBlob*: { v: i32 }\nmain = () i32 { b := Blob(v: 3)  b.render() }\n",
        wants: [":5:36: error[trait-bound]: type `Blob` does not implement trait `Show` (which declares `render`) — missing method(s): render", "  main = () i32 { b := Blob(v: 3)  b.render() }", "                                     ^~~~~~", "hint: implement the bound trait for this type (`Type.impl(Trait, { … })`), or relax the bound"],
    ), DiagCase(
