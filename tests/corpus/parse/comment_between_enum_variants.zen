// A comment on a variant must not change what the declaration IS.
//
// Every bounded scan in src/parse/lookahead.zen indexed the RAW token
// stream, and the raw stream carries trivia. So `variant_ahead` asked
// what followed `A` in `K = A // c` and got the COMMENT rather than the
// `|` one line down; the declaration was classified as an alias, and
// the error landed on the NEXT variant's payload — one line away from
// the comment that caused it.
//
// src/lex/lex_token.zen, src/sema/sema_diag.zen and src/gen/gen_diag.zen
// are each written this way. Removing either the comment or the payload
// made it parse, which is what made the pair look unrelated.

Kind =
      Word          // a bare name
    | Number(u64)   // a name and how many
    | Blank

name = (k: Kind) str {
    k.match({
        Word      => "word",
        Number(n) => "number",
        Blank     => "blank",
    });
}

main = (env: Env) Res<i32, ArgError> {
    println("{}", name(Kind.Word));
    println("{}", name(Kind.Number(3)));
    println("{}", name(Kind.Blank));
    Ok(0);
}
