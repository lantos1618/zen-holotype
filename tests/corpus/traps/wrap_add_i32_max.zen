// tests/corpus/traps/wrap_add_i32_max.zen
// i32.MAX +% 1 does NOT trap. it wraps to i32.MIN and exits 0:
// wrapping is a different operator because it is a different intent

// main must name an error type. a trap never lifts into Res:
// it aborts the process
Error =
    Overflow,
    DivideByZero,
    OutOfBounds

main = (env: Env) Res<i32, Error> {
    x: i32 = i32.MAX;
    wrapped = x +% 1;
    println("{}", wrapped);
    Ok(0);
}
