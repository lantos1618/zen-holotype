// src/gen/gen_c/gen_c_fs.zen
// THE FILESYSTEM CAPABILITY, in C.
//
// `gen_c_cap.zen` is the other half — the members whose body IS the
// backend, and the memory ones. This file covers the four `Fs`
// declares: three are a `stat`/`fopen`, the fourth ALLOCATES.
//
// A path arrives as a `str` — borrowed bytes, NOT NUL-terminated — but
// the kernel wants a NUL; the copy happens in the C floor, not here:
// `exists` has no `Alloc` in its signature, so by law 1 it may not have
// any memory either.
//
// `read` is the one that allocates, and does it THROUGH A BOUND: the
// value handed to its `Alloc` parameter is a fat value and the buffer
// comes out of a call through that record, with no call node in the
// source to lower — `gen_c_bound.slot_call`, whose only other user is
// `gen_c_sink.sink_write`.
//
// The C floor answers with an ORDINAL, turned back into a variant BY
// NAME here, so `env.zen` may rename or reorder its own error set
// without the backend agreeing to it in secret. The ordinals are the
// floor's own, written down in exactly one place at each end.

ExprId = std.ast
Call, Access = std.ast
AllocError = std.mem
str, String = std.text
TyId = sema.sema_ty
Ctx = sema.sema_check
write_usize = sema.sema_diag
sym_member, sym_variant, sym_gen, RES_PATH = gen.gen_name
CBackend = gen.gen_c.gen_c_state
unsupported = gen.gen_c.gen_c_report
ctype, request_type = gen.gen_c.gen_c_type
declare_temp, payload_type = gen.gen_c.gen_c_flow
Slot = gen.gen_c.gen_c_fat
slot_call = gen.gen_c.gen_c_bound
address_of = gen.gen_c.gen_c_fat
expr = gen.gen_c.gen_c_expr
arg_text, field_of = gen.gen_c.gen_c_cap
write_assign_ok, write_assign_ok_unit, write_assign_err = gen.gen_c.gen_c_cap

// -----------------------------------------------------------------
// the filesystem
//
// Every path is spilled into a temporary first: a `str` is a pointer
// and a count, both read, so an argument that is a call would
// otherwise be made twice.
// -----------------------------------------------------------------

// `exists` and `is_dir`: one `stat`, and no failure a caller acts on.
// A path that cannot be stat'd is, for the purpose of "should I try to
// open this", a path that is not there.
lower_probe* = (be :: CBackend, c: Call, name: str, ctx: Ctx, out :: String)
              Res<(), AllocError> {
    be.need_fs();
    path ::= be.alloc.String().try();
    be.path_args(c, 0, ctx, path).try();
    out.fmt("(zg_fs_kind({}){})", path.view(), probe_test(name)).try();
    Ok(());
}

probe_test = (name: str) str {
    name.eq("is_dir").match({ true => " == 1", false => " >= 0" })
}

// `write`: the whole file at once, the mirror of `read`. It takes no
// `Alloc` because it allocates nothing — the bytes are the caller's and
// stay the caller's.
lower_write* = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    ret : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    be.need_fs();
    i32_ty = be.check.types.prim("i32").try();
    path ::= be.alloc.String().try();
    be.path_args(c, 0, ctx, path).try();
    data ::= be.alloc.String().try();
    be.path_args(c, 1, ctx, data).try();
    rc ::= be.alloc.String().try();
    sym_gen(rc, "t", be.next_tmp()).try();
    dst ::= be.alloc.String().try();
    sym_gen(dst, "t", be.next_tmp()).try();
    be.declare_temp(i32_ty, rc.view()).try();
    be.declare_temp(ret, dst.view()).try();
    be.write_fs_call(rc.view(), "zg_fs_write(", path.view(), data.view()).try();
    be.open_rc_test(rc.view()).try();
    be.fs_chain(ret, rc.view(), dst.view(), 1).try();
    be.close_else().try();
    be.write_assign_ok_unit(ret, dst.view()).try();
    be.close_brace().try();
    out.add_bytes(dst.view())
}

write_fs_call = (be :: CBackend, rc: str, fn: str, first: str, second: str)
                Res<(), AllocError> {
    be.fmt("{rc} = {fn}{first}, {second});\n")
}

// -----------------------------------------------------------------
// `fs.lock(path)` — THE CAPABILITY THAT EXCLUDES
//
// One floor call answering an ordinal like every other fs verb, so the
// failure chain is the SAME chain — `Exists` joins it as ordinal 4 and
// `fs_name` grows one arm. The Ok payload is the Lock: one i32 field
// holding the descriptor, written FIELD BY FIELD under the same
// licence `read_string` writes a String's — the fd enters the program
// here and nowhere else.
//
// NO ALLOC. A Lock is one word of state the kernel owns; there is
// nothing here for an arena to hold.
// -----------------------------------------------------------------

lower_lock* = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    ret : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    be.need_fs();
    be.payload_type(ret, "Ok").match({
        None    => be.unsupported(
            id,
            "Fs.lock must return a Res<Lock, FsError>",
            out
        ),
        Ok(lty) => be.write_lock(id, c, ret, lty, ctx, out),
    })
}

write_lock = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    ret : TyId,
    lty : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    be.request_type(lty).try();
    i32_ty = be.check.types.prim("i32").try();
    path ::= be.alloc.String().try();
    be.path_args(c, 0, ctx, path).try();
    rc ::= be.alloc.String().try();
    sym_gen(rc, "t", be.next_tmp()).try();
    // THE DESCRIPTOR TEMP IS DECLARED HERE, not inside `write_lock_call`,
    // because two spellings need it: the floor call takes its address and
    // the Ok payload below copies it into the Lock. Born in the helper, it
    // died with the helper's scope and the payload spelled the RC instead
    // — every Lock came back holding ordinal 0, unlock() closed stdin,
    // and a relock of a released path failed as Exists while the program
    // printed success for the first lock.
    fd ::= be.alloc.String().try();
    sym_gen(fd, "t", be.next_tmp()).try();
    dst ::= be.alloc.String().try();
    sym_gen(dst, "t", be.next_tmp()).try();
    be.declare_temp(i32_ty, rc.view()).try();
    be.declare_temp(i32_ty, fd.view()).try();
    be.declare_temp(ret, dst.view()).try();
    be.write_lock_call(rc.view(), path.view(), fd.view()).try();
    be.open_rc_test(rc.view()).try();
    be.fs_chain(ret, rc.view(), dst.view(), 1).try();
    be.close_else().try();
    // The payload is the LOCK (lty), not the Res: `write_assign_ok`
    // wraps it in the Res head, so what lands in `.zg_data.Ok` is the
    // struct itself. Spelling `ret` here put a whole Res inside the
    // payload slot and `cc` refused the C.
    value ::= be.alloc.String().try();
    value.add_bytes("(").try();
    be.ctype(lty, value).try();
    value.add_bytes("){ .").try();
    sym_member(value, "fd").try();
    value.add_bytes(" = ").try();
    value.add_bytes(fd.view()).try();
    value.add_bytes(" }").try();
    be.write_assign_ok(ret, value.view(), dst.view()).try();
    be.close_brace().try();
    out.add_bytes(dst.view())
}

// the one-line formatters the fs lowerings call. A FORMAT DOOR'S HOLE
// IS A `str` AND THESE ARGUMENTS ARE NOT (`gen_c_floor.zen`: a hole is
// converted by nothing), which is why every floor call in this file
// goes through a helper like this one instead of an inline `be.fmt` —
// `write_fs_call` spells it for two arguments, this for none.
// `<int> <rc> = zg_fs_lock(<path>, &<fd>);` — THE ANSWER IS AN
// ORDINAL and the descriptor comes back through the pointer, because a
// raw fd would collide with the error ordinals the rc test reads (a
// successful lock on fd 4 would be reported as `Exists`). The fd temp
// itself is DECLARED BY THE CALLER: the Ok payload in `write_lock`
// copies the same temp into the Lock, so it must outlive this helper's
// scope — born here, the payload spelled the rc and every Lock came
// back holding 0.
write_lock_call = (be :: CBackend, rc: str, path: str, fd: str)
                  Res<(), AllocError> {
    // spelled piecewise, not through a format door: a hole resolves to
    // what a signature declares — `unlock_line` below is the same
    // refusal, same shape.
    line ::= be.alloc.String().try();
    line.add_bytes(rc).try();
    line.add_bytes(" = zg_fs_lock(").try();
    line.add_bytes(path).try();
    line.add_bytes(", &").try();
    line.add_bytes(fd).try();
    line.add_bytes(");\n").try();
    be.write(line.view())
}

// -----------------------------------------------------------------
// `lock.unlock()` — the release drop runs
//
// The receiver is handed over BY ADDRESS, the way every `::` parameter
// travels: spelled out rather than borrowed from `path_args`, because
// that helper lowers its argument AS A `str` and the thing being
// unlocked is a Lock. `address_of` takes `&` of a place and spills a
// non-place into a temporary first, so `spent.unlock()` and a receiver
// with a call in it both reach the floor as an address. The answer is
// the unit lowering's own — a bare 0, exactly what `lower_release`
// answers.
// -----------------------------------------------------------------

lower_unlock* = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    ret : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    be.need_fs();
    unknown = be.check.types.unknown().try();
    recv ::= be.alloc.String().try();
    expr(be, a.base, ctx, unknown, recv).try();
    addr ::= be.alloc.String().try();
    be.address_of(recv.view(), rty, addr).try();
    // THE FLOOR TAKES THE FD, NOT THE LOCK: the receiver arrives as an
    // address (every `::` receiver does), so the one field is read
    // through it — `zg_fs_unlock(p->fd)`. Passing the address itself
    // handed an int parameter a pointer, and the lock never released.
    //
    // THE ADDRESS IS ALREADY `&(...)` (`gen_c_fat.address_of`: a place
    // gets `&(x)`, anything else spills to a temporary and answers
    // `&t`). The arrow must hop THE ADDRESS ITSELF: spelled bare,
    // `&x->fd` parses as `&(x->fd)` -- pointer-to-pointer where an int
    // was declared -- because `->` binds tighter than unary `&`. One
    // pair of parens moves the arrow outside: `(&(x))->fd`.
    //
    // THE PARENS GO INTO THEIR OWN BUFFER: appending them to `addr`
    // while reading `addr.view()` grew the String under its own live
    // borrow and the text came out DOUBLED -- cc read a Lock value being
    // CALLED. A borrowed view must never watch its own String grow.
    ptr ::= be.alloc.String().try();
    ptr.add_bytes("(").try();
    ptr.add_bytes(addr.view()).try();
    ptr.add_bytes(")").try();
    field ::= be.alloc.String().try();
    be.arrow_field(ptr.view(), "fd", field).try();
    be.unlock_line(field.view()).try();
    out.add_bytes("0");
    Ok(())
}

// `zg_fs_unlock(<field>);\n` — one statement, spelled here so no
// format hole is asked to carry it. The fd is not a str and the floor
// door converts nothing.
unlock_line = (be :: CBackend, field: str) Res<(), AllocError> {
    be.fmt("zg_fs_unlock(").try();
    be.write(field).try();
    be.write(");\n")
}

// `<addr>-><name>` — the fd through a Lock pointer, spelled with the
// member mangler so the C name cannot drift from the type's own.
arrow_field = (be :: CBackend, addr: str, name: str, out :: String)
              Res<(), AllocError> {
    out.add_bytes(addr).try();
    out.add_bytes("->").try();
    out.sym_member(name)
}

// `remove`: the answer to "make sure this is gone" (#757). The status
// answers "did the call succeed" and the BOOL is the caller's answer,
// through a pointer — the same split `zg_fs_size` makes, because a
// value that may legitimately be 1 cannot double as the error flag.
// Absence is an Ok here and never NOT_FOUND: the only ordinals this
// returns are the three refusals, so the gen-side chain starts at 2.
lower_remove* = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    ret : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    be.need_fs();
    i32_ty  = be.check.types.prim("i32").try();
    bool_ty = be.check.types.prim("bool").try();
    path ::= be.alloc.String().try();
    be.path_args(c, 0, ctx, path).try();
    rc ::= be.alloc.String().try();
    sym_gen(rc, "t", be.next_tmp()).try();
    yes ::= be.alloc.String().try();
    sym_gen(yes, "t", be.next_tmp()).try();
    dst ::= be.alloc.String().try();
    sym_gen(dst, "t", be.next_tmp()).try();
    be.declare_temp(i32_ty, rc.view()).try();
    be.declare_temp(bool_ty, yes.view()).try();
    be.declare_temp(ret, dst.view()).try();
    be.write_remove_call(rc.view(), yes.view(), path.view()).try();
    be.open_rc_test(rc.view()).try();
    be.fs_chain(ret, rc.view(), dst.view(), 2).try();
    be.close_else().try();
    be.write_assign_ok(ret, yes.view(), dst.view()).try();
    be.close_brace().try();
    out.add_bytes(dst.view())
}

write_remove_call = (be :: CBackend, rc: str, yes: str, path: str)
                   Res<(), AllocError> {
    be.fmt("{rc} = zg_fs_remove({path}, &{yes});\n")
}

// `(const unsigned char *)<tmp>.data, <tmp>.len` — the two halves of a
// `str`, spilled once. `str` is the one type whose C representation is
// the runtime floor's rather than its declaration's, so its fields are
// spelled the floor's way and not the mangler's.
path_args* = (be :: CBackend, c: Call, i: usize, ctx: Ctx, out :: String)
            Res<(), AllocError> {
    sty = be.check.types.prim("str").try();
    tmp ::= be.alloc.String().try();
    sym_gen(tmp, "t", be.next_tmp()).try();
    be.declare_temp(sty, tmp.view()).try();
    value ::= be.alloc.String().try();
    be.arg_text(c, i, sty, ctx, value).try();
    be.set_line(tmp.view(), value.view()).try();
    out.fmt(
        "(const unsigned char *){}.data, {}.len",
        tmp.view(),
        tmp.view()
    ).try();
    Ok(());
}

// -----------------------------------------------------------------
// `fs.read(alloc, path)` — THE CAPABILITY THAT ALLOCATES
//
// The `String` is written FIELD BY FIELD, the same licence `lower_alloc`
// takes with an `ArenaState`: memory enters the program here, so the
// one place that knows the shape is the place the value is born. `len`
// is what ARRIVED and `capacity` is what was asked for — a short read
// must not leave a String claiming bytes nobody ever wrote, and the
// run really is `want` wide, which a later grow may reuse.
// -----------------------------------------------------------------

lower_read* = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    ret : TyId,
    aty : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    be.need_fs();
    be.payload_type(ret, "Ok").match({
        None    => be.unsupported(
            id,
            "Fs.read must return a Res<String, FsError>",
            out
        ),
        Ok(sty) => be.read_string(id, c, ret, sty, aty, ctx, out),
    })
}

read_string = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    ret : TyId,
    sty : TyId,
    aty : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    be.field_of(sty, "data").try().match({
        None    => be.unsupported(
            id,
            "Fs.read must return a Res<String, FsError>",
            out
        ),
        Ok(vty) => be.read_run(id, c, ret, sty, vty, aty, ctx, out),
    })
}

read_run = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    ret : TyId,
    sty : TyId,
    vty : TyId,
    aty : TyId,
    ctx : Ctx,
    out :: String
)
           Res<(), AllocError> {
    usize_ty = be.check.types.prim("usize").try();
    i32_ty   = be.check.types.prim("i32").try();
    be.request_type(sty).try();
    be.request_type(vty).try();
    path ::= be.alloc.String().try();
    be.path_args(c, 1, ctx, path).try();
    al ::= be.alloc.String().try();
    be.hold_alloc(c, aty, ctx, al).try();
    want ::= be.alloc.String().try();
    sym_gen(want, "t", be.next_tmp()).try();
    got ::= be.alloc.String().try();
    sym_gen(got, "t", be.next_tmp()).try();
    rc ::= be.alloc.String().try();
    sym_gen(rc, "t", be.next_tmp()).try();
    dst ::= be.alloc.String().try();
    sym_gen(dst, "t", be.next_tmp()).try();
    be.declare_temp(usize_ty, want.view()).try();
    be.declare_temp(usize_ty, got.view()).try();
    be.declare_temp(i32_ty, rc.view()).try();
    be.declare_temp(ret, dst.view()).try();
    be.set_line(want.view(), "0").try();
    be.set_line(got.view(), "0").try();
    be.write_size_call(rc.view(), path.view(), want.view()).try();
    be.open_rc_test(rc.view()).try();
    be.fs_chain(ret, rc.view(), dst.view(), 1).try();
    be.close_else().try();
    be.read_body(
        id,
        ret,
        sty,
        vty,
        aty,
        al.view(),
        path.view(),
        want.view(),
        got.view(),
        rc.view(),
        dst.view()
    ).try();
    be.close_brace().try();
    out.add_bytes(dst.view())
}

// The `Alloc` in a temporary of its own: the record is read twice — for
// the slot and for the receiver behind it — and an argument read twice
// is an argument evaluated twice.
hold_alloc = (
    be  :: CBackend,
    c   : Call,
    aty : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    sym_gen(out, "t", be.next_tmp()).try();
    value ::= be.alloc.String().try();
    be.arg_text(c, 0, aty, ctx, value).try();
    be.declare_temp(aty, out.view()).try();
    be.set_line(out.view(), value.view()).try();
    Ok(());
}

write_size_call = (be :: CBackend, rc: str, path: str, want: str)
                  Res<(), AllocError> {
    be.fmt("{rc} = zg_fs_size({path}, &{want});\n")
}

// ALIGN_MAX, exactly as `create` asks for: it is what the arena would
// have given anyway, and it keeps the size header the arena writes
// ahead of every run intact — so a String read off the disk still grows
// through the ordinary `realloc`.
read_body = (
    be   :: CBackend,
    id   : ExprId,
    ret  : TyId,
    sty  : TyId,
    vty  : TyId,
    aty  : TyId,
    al   : str,
    path : str,
    want : str,
    got  : str,
    rc   : str,
    dst  : str
) Res<(), AllocError> {
    call ::= be.alloc.String().try();
    args ::= be.alloc.String().try();
    args.fmt(", {want}, 16").try();
    be.slot_call(al, aty, "raw", args.view(), 2, call).try().match({
        None     => be.unsupported_line(id, "Fs.read needs an Alloc"),
        Ok(slot) => be.run_and_read(
            ret,
            sty,
            vty,
            aty,
            slot,
            al,
            path,
            want,
            got,
            rc,
            dst,
            call.view()
        ),
    })
}

unsupported_line = (be :: CBackend, id: ExprId, what: str)
                   Res<(), AllocError> {
    sink ::= be.alloc.String().try();
    be.unsupported(id, what, sink)
}

run_and_read = (
    be   :: CBackend,
    ret  : TyId,
    sty  : TyId,
    vty  : TyId,
    aty  : TyId,
    slot : Slot,
    al   : str,
    path : str,
    want : str,
    got  : str,
    rc   : str,
    dst  : str,
    call : str
) Res<(), AllocError> {
    run ::= be.alloc.String().try();
    sym_gen(run, "t", be.next_tmp()).try();
    be.declare_temp(slot.ret, run.view()).try();
    be.set_line(run.view(), call).try();
    be.open_not_ok(run.view()).try();
    be.write_assign_err(ret, "OutOfMemory", dst).try();
    be.close_else().try();
    buf ::= be.alloc.String().try();
    sym_gen(buf, "t", be.next_tmp()).try();
    be.declare_ptr(buf.view()).try();
    be.read_ok_payload(run.view(), buf.view()).try();
    be.write_read_call(rc, path, buf.view(), want, got).try();
    be.open_rc_test(rc).try();
    be.fs_chain(ret, rc, dst, 1).try();
    be.close_else().try();
    be.write_string_ok(ret, sty, vty, al, buf.view(), got, want, dst).try();
    be.close_brace().try();
    be.close_brace().try();
    Ok(());
}

declare_ptr = (be :: CBackend, name: str) Res<(), AllocError> {
    be.fmt("unsigned char *{name};\n")
}

read_ok_payload = (be :: CBackend, run: str, buf: str)
                  Res<(), AllocError> {
    value ::= be.alloc.String().try();
    value.fmt("(unsigned char *){run}.zg_data.").try();
    sym_member(value, "Ok").try();
    be.set_line(buf, value.view())
}

open_not_ok = (be :: CBackend, run: str) Res<(), AllocError> {
    tag ::= be.alloc.String().try();
    sym_variant(tag, RES_PATH, "Ok").try();
    be.fmt("if ({run}.zg_tag != {}) {\n", tag.view()).try();
    be.indent();
    Ok(());
}

write_read_call = (
    be   :: CBackend,
    rc   : str,
    path : str,
    buf  : str,
    want : str,
    got  : str
) Res<(), AllocError> {
    be.fmt("{rc} = zg_fs_read({path}, {buf}, {want}, &{got});\n")
}

write_string_ok = (
    be   :: CBackend,
    ret  : TyId,
    sty  : TyId,
    vty  : TyId,
    al   : str,
    buf  : str,
    got  : str,
    want : str,
    dst  : str
)
                  Res<(), AllocError> {
    value ::= be.alloc.String().try();
    value.add_bytes("(").try();
    be.ctype(sty, value).try();
    value.add_bytes("){ .").try();
    sym_member(value, "data").try();
    value.add_bytes(" = ").try();
    write_vec_literal(be, vty, al, buf, got, want, value).try();
    value.add_bytes(" }").try();
    be.write_assign_ok(ret, value.view(), dst)
}

write_vec_literal = (
    be   :: CBackend,
    vty  : TyId,
    al   : str,
    buf  : str,
    got  : str,
    want : str,
    out  :: String
)
                    Res<(), AllocError> {
    out.add_bytes("(").try();
    be.ctype(vty, out).try();
    out.add_bytes("){ ").try();
    be.write_vec_field(vty, "data", buf, out, true).try();
    be.write_vec_field(vty, "len", got, out, false).try();
    be.write_vec_field(vty, "capacity", want, out, false).try();
    be.write_vec_field(vty, "alloc", al, out, false).try();
    out.add_bytes(" }").try();
    Ok(());
}

// A field std drops is a line this stops writing rather than a
// diagnostic: `collections_vec.zen` owns the shape.
write_vec_field = (
    be    :: CBackend,
    vty   : TyId,
    name  : str,
    value : str,
    out   :: String,
    first : bool
) Res<(), AllocError> {
    be.field_of(vty, name).try().match({
        None  => Ok(()),
        Ok(_) => be.write_named_init(name, value, out, first),
    })
}

write_named_init = (
    be    :: CBackend,
    name  : str,
    value : str,
    out   :: String,
    first : bool
) Res<(), AllocError> {
    first.match({ true => Ok(()), false => out.add_bytes(", ") }).try();
    out.add_bytes(".").try();
    out.sym_member(name).try();
    out.fmt(" = {value}").try();
    Ok(());
}

// -----------------------------------------------------------------
// the failure chain — see the file header for the ordinal/name rule
// -----------------------------------------------------------------

fs_name = (n: usize) str {
    (n == 1).match({ true => "NotFound", false => fs_name_2(n) })
}

fs_name_2 = (n: usize) str {
    (n == 2).match({ true => "Denied", false => fs_name_3(n) })
}

fs_name_3 = (n: usize) str {
    (n == 3).match({ true => "IsDir", false => fs_name_4(n) })
}

// Exists is ordinal 4, and `lock` is the only floor that answers with
// it: a stat cannot find it and an open cannot create it.
fs_name_4 = (n: usize) str {
    (n == 4).match({ true => "Exists", false => "Failed" })
}

// `if (rc == 1) { .. } else { if (rc == 2) { .. } else { .. } }`. The
// last arm is the plain `else`: the floor returns exactly these
// ordinals, so a chain testing all five would end in a branch nothing
// can reach — and an unreachable arm naming a reason is how a wrong
// reason gets reported later. `remove` starts its own chain at 2: the
// three refusals are all it can answer, and NOT_FOUND is not among
// them (see `lower_remove`).
fs_chain* = (be :: CBackend, ret: TyId, rc: str, dst: str, n: usize)
           Res<(), AllocError> {
    (n > 4).match({
        true  => be.write_assign_err(ret, fs_name(n), dst),
        false => be.fs_branch(ret, rc, dst, n),
    })
}

fs_branch = (be :: CBackend, ret: TyId, rc: str, dst: str, n: usize)
            Res<(), AllocError> {
    be.open_ordinal_test(rc, n).try();
    be.write_assign_err(ret, fs_name(n), dst).try();
    be.close_else().try();
    be.fs_chain(ret, rc, dst, n + 1).try();
    be.close_brace().try();
    Ok(());
}

open_ordinal_test = (be :: CBackend, rc: str, n: usize)
                    Res<(), AllocError> {
    ord ::= be.alloc.String().try();
    write_usize(ord, n).try();
    be.fmt("if ({rc} == {}) {\n", ord.view()).try();
    be.indent();
    Ok(());
}

open_rc_test* = (be :: CBackend, rc: str) Res<(), AllocError> {
    be.fmt("if ({rc} != 0) {\n").try();
    be.indent();
    Ok(());
}

// The one failure any C call answering with a pointer has, whether it
// opened a file or asked for a page.
open_null_test* = (be :: CBackend, raw: str) Res<(), AllocError> {
    be.fmt("if ({raw} == NULL) {\n").try();
    be.indent();
    Ok(());
}

close_else* = (be :: CBackend) Res<(), AllocError> {
    be.dedent();
    be.writeln("} else {").try();
    be.indent();
    Ok(());
}

close_brace* = (be :: CBackend) Res<(), AllocError> {
    be.dedent();
    be.writeln("}").try();
    Ok(());
}
