// Authority available during one actor turn.

Env = std.env
Alloc = std.mem

Context* = {
    env*: Env,
    alloc*: Alloc,
}

// A typed actor inbox. Actor behavior methods remain grouped in the Actor
// impl; this bound lets generic producers state which message they send.
Receive*<T> = {
    receive* = (self :: @Self, ctx: Context, message: T) ()
}
