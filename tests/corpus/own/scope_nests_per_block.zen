// DESIGN.md's own example: `@scope` nests, and each block gets its own. the
// inner block's defers run at the INNER brace, before anything the outer
// block registered afterwards — two stacks, not one.

main = (env: Env) Res<i32, IoError> {
    outer = @scope;
    {
        inner = @scope;
        inner.defer(() { println("inner cleanup") });
        println("inner body");
    }
    outer.defer(() { println("outer cleanup") });
    println("outer body");
    Ok(0);
}
