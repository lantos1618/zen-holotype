// SILENT-WRONG repro: untyped int literals at HMap<i64, str> call sites must coerce to the
// pinned K=i64, not rebind K to i32.
hm = std.collections.hmap
{ println } = std.text.fmt
halloc = std.mem.heap
main = () i32 {
    alloc := halloc.gpa()
    a := alloc.addr()
    k1: i64 := 1
    m := hm.of(a, k1, "one").expect("of")    // pins HMap<i64, str>
    m = m.put(a, 2, "two").expect("put")     // LITERAL key in non-first arg position
    m = m.put(a, 3, "three").expect("put")
    m.get(2).match ({
        .Some(v) => println(v),    // expect: two
        .None    => println("WRONG none for 2"),
    })
    m.get(k1).match ({
        .Some(v) => println(v),    // expect: one
        .None    => println("WRONG none for 1"),
    })
    println(m.get_or(3, "missing"))    // expect: three
    println(m.len())                   // expect: 3
    m.free(a)
    0
}
