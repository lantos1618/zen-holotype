// T has one meaning through array element positions too. The first argument
// settles it to i32, so the second [str, 2] cannot fit [T, 2].

first = <T>(left: [T, 2], right: [T, 2]) T { left[0] }

main = (env: Env) Res<i32, AllocError> {
    numbers: [i32, 2] = [1, 2];
    words: [str, 2] = ["one", "two"];
    println("{}", first(numbers, words));
    Ok(0);
}
