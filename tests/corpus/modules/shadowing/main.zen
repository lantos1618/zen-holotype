who = name.name

// a local binding with the same name as an import. the local wins
// inside this body, and the import is untouched everywhere else
twice = (n: i32) i32 {
    who = n * 2;
    who
}

main = (env: Env) Res<i32, IoError> {
    println(who());
    println("{}", twice(21));
    println(who());
    Ok(0);
}
