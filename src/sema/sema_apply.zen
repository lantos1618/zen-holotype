Expr, ExprId, Call, Arg = std.ast
Decl, Enum, Struct, TypeId, Impl = std.ast
AllocError = std.mem
Vec = std.collections
str = std.text
Range = std.core
ImplId = sema.sema_id
TyId, TyNamed, literal_default = sema.sema_ty
Def, decl_at = sema.sema_def
Checker, Ctx = sema.sema_check
Inst, InstEdge, subst, unify, tparam_vars, zip = sema.sema_inst
has_var, inst_of_named, decl_tparam_vars = sema.sema_inst
Cand, TBound, Actual, ty_at = sema.sema_cand
impl_bound_type, LocalImpl, local_impls = sema.sema_supply
type_of = sema.sema_type
type_from_ast = sema.sema_denote
check_literal = sema.sema_trap
array_range_shape = sema.sema_bound
case_payload, Case, cases_of, find_case = sema.sema_case
check_ctor_fields = sema.sema_hoist
check_ctor_shape = sema.sema_bound
Found, members_of = sema.sema_member
SemaFault, NameFault = sema.sema_diag
catch_all_named = sema.sema_discriminant

construct* = (c :: Checker, id: ExprId, call: Call, d: Def, ctx: Ctx)
            Res<TyId, AllocError> {
    c.resolve_call(id, d.id).try();
    args ::= c.alloc.Vec<TyId>();
    c.ctor_args(call, d, ctx, args).try();
    applied = c.types.named(d.id, d.qname, d.name, args).try();
    ty      = c.settled_ctor_type(call, d, ctx, args, applied).try();
    c.check_ctor_fields(call, ty, ctx).try();
    c.check_ctor_shape(call, ty, c.tree.expr_at(id).span).try();
    Ok(ty);
}

settled_ctor_type = (
    c       :: Checker,
    call    : Call,
    d       : Def,
    ctx     : Ctx,
    vars    : Vec<TyId>,
    applied : TyId
)
                    Res<TyId, AllocError> {
    ((vars.len == 0) || (call.targs.len > 0)).match({
        true  => Ok(applied),
        false => c.ctor_type_from_args(call, d, ctx, vars, applied),
    })
}

ctor_type_from_args = (
    c       :: Checker,
    call    : Call,
    d       : Def,
    ctx     : Ctx,
    vars    : Vec<TyId>,
    applied : TyId
)
                      Res<TyId, AllocError> {
    inst ::= c.alloc.Inst();
    call.args.loop((h, a) { c.unify_ctor_arg(a, applied, ctx, inst).try() });
    (inst.len() == 0).match({
        true  => Ok(applied),
        false => c.rebuilt_ctor_type(d, vars, inst),
    })
}

rebuilt_ctor_type = (c :: Checker, d: Def, vars: Vec<TyId>, inst: Inst)
                    Res<TyId, AllocError> {
    args ::= c.alloc.Vec<TyId>();
    vars.loop((h, v) { args.add(inst.arg_for(v)).try() });
    c.types.named(d.id, d.qname, d.name, args)
}

unify_ctor_arg = (
    c       :: Checker,
    a       : Arg,
    applied : TyId,
    ctx     : Ctx,
    inst    :: Inst
) Res<(), AllocError> {
    a.name.match({
        None   => Ok(()),
        Ok(nm) => c.unify_ctor_field(a, nm.text, applied, ctx, inst),
    })
}

unify_ctor_field = (
    c       :: Checker,
    a       : Arg,
    name    : str,
    applied : TyId,
    ctx     : Ctx,
    inst    :: Inst
) Res<(), AllocError> {
    found ::= c.alloc.Vec<Found>();
    c.members_of(applied, name, found).try();
    found.get(0).match({
        None  => Ok(()),
        Ok(f) => c.unify(f.ty, c.settled_arg_ty(a, ctx).try(), inst),
    })
}

variant_call_type* = (
    c    :: Checker,
    call : Call,
    ty   : TyId,
    name : str,
    ctx  : Ctx
) Res<TyId, AllocError> {
    catch_all = c.catch_all_named(ty, name).try();
    inst ::= c.alloc.Inst();
    own = c.applied_at_own_vars(ty).try();
    c.types.at(own).match({
        Named(n) => {
            args ::= c.alloc.Vec<TyId>();
            c.denote_targs(call.targs, ctx, args).try();
            c.zip(n.args, args, inst).try();
            c.types.at(ty).match({
                Named(r) => c.zip(n.args, r.args, inst),
                _        => Ok(()),
            })
        },
        _        => Ok(()),
    }).try();
    cases ::= c.alloc.Vec<Case>();
    c.cases_of(ty, cases).try();
    (cases.find_case(name).match({
        None   => Ok(()),
        Ok(cs) => c.payload_says(call, ty, cs, ctx, inst),
    })).try();
    c.variant_has_type(call, ty).match({
        true  => c.variant_literal(call, ty, name, inst),
        false => Ok(()),
    }).try();
    settled = (inst.len() == 0).match({
        true  => Ok(ty),
        false => c.subst(own, inst),
    }).try();
    catch_all.match({
        false => Ok(settled),
        true  => {
            c.report(
                call.args_span.file,
                call.args_span,
                SemaFault.CatchAllConstruction(NameFault(name: name))
            ).try();
            c.types.unknown()
        },
    })
}

variant_has_type = (c: Checker, call: Call, ty: TyId) bool {
    (call.targs.len > 0) || c.types.at(ty).match({
        Named(n) => n.args.len > 0,
        _        => false,
    })
}

variant_literal = (
    c    :: Checker,
    call : Call,
    ty   : TyId,
    name : str,
    inst : Inst
) Res<(), AllocError> {
    call.args.get(0).match({
        None    => Ok(()),
        Ok(arg) => {
            payload = c.case_payload(ty, name).try();
            want    = c.subst(payload, inst).try();
            c.check_literal(arg.value, want)
        },
    })
}

// A written binding supplies the same enum application that an explicit
// call argument would. Retype only a variant call of that declaration.
settle_variant_at* = (
    c    :: Checker,
    id   : ExprId,
    got  : TyId,
    want : TyId,
    ctx  : Ctx
) Res<TyId, AllocError> {
    (c.same_head(got, want) == false).match({
        true  => Ok(got),
        false => c.tree.expr_at(id).kind.match({
            Call(call) => (call.targs.len > 0).match({
                true  => Ok(got),
                false => c.tree.expr_at(call.callee).kind.match({
                    Access(a) => {
                        cases ::= c.alloc.Vec<Case>();
                        c.cases_of(want, cases).try();
                        cases.find_case(a.name.text).match({
                            None  => Ok(got),
                            Ok(_) => {
                                settled = c.variant_call_type(
                                    call,
                                    want,
                                    a.name.text,
                                    ctx
                                ).try();
                                c.expr_memo.set(id, settled).try();
                                Ok(settled)
                            },
                        })
                    },
                    _         => Ok(got),
                }),
            }),
            _          => Ok(got),
        }),
    })
}

// Re-apply the declaration at its own variables so every explicit or
// inferred argument binds the same `T` before substitution.
applied_at_own_vars = (c :: Checker, ty: TyId) Res<TyId, AllocError> {
    c.types.at(ty).match({
        Named(n) => c.tree.decl_at(n.decl).match({
            None  => Ok(ty),
            Ok(d) => {
                owner = c.owner_of(n.decl.module.to_usize(), n.name).try();
                vars ::= c.alloc.Vec<TyId>();
                c.decl_tparam_vars(d, owner, vars).try();
                c.types.named(n.decl, owner, n.name, vars)
            },
        }),
        _        => Ok(ty),
    })
}

// Unify a variant payload with its first argument. A nullary variant leaves
// the enum's type parameters unbound.
payload_says = (
    c    :: Checker,
    call : Call,
    ty   : TyId,
    cs   : Case,
    ctx  : Ctx,
    inst :: Inst
) Res<(), AllocError> {
    call.args.get(0).match({
        None  => Ok(()),
        Ok(a) => c.unify(
            c.case_payload(ty, cs.name).try(),
            c.settled_arg_ty(a, ctx).try(),
            inst
        ),
    })
}

settled_arg_ty = (c :: Checker, a: Arg, ctx: Ctx) Res<TyId, AllocError> {
    got = c.type_of(a.value, ctx).try();
    c.is_literal_ty(got).match({
        false => Ok(got),
        true  => c.types.prim(c.prim_name(got).literal_default()),
    })
}

ctor_args = (c :: Checker, call: Call, d: Def, ctx: Ctx, out :: Vec<TyId>)
            Res<(), AllocError> {
    (call.targs.len == 0).match({
        true  => c.tree.decl_at(d.id).match({
            None    => Ok(()),
            Ok(dec) => c.decl_tparam_vars(dec, d.qname, out),
        }),
        false => c.denote_targs(call.targs, ctx, out),
    })
}

// Written type arguments resolve in the caller's module.
denote_targs = (
    c     :: Checker,
    targs : Vec<TypeId>,
    ctx   : Ctx,
    out   :: Vec<TyId>
) Res<(), AllocError> {
    targs.loop((h, t) { out.add(c.type_from_ast(t, ctx).try()).try() });
    Ok(());
}

instantiate* = (
    c       :: Checker,
    id      : ExprId,
    call    : Call,
    k       : Cand,
    actuals : Vec<Actual>,
    ctx     : Ctx
) Res<TyId, AllocError> {
    k.generic.match({
        false => Ok(k.ret),
        true  => c.instantiated_ret(id, call, k, actuals, ctx),
    })
}

instantiated_ret = (
    c       :: Checker,
    id      : ExprId,
    call    : Call,
    k       : Cand,
    actuals : Vec<Actual>,
    ctx     : Ctx
)
                   Res<TyId, AllocError> {
    inst = c.call_inst(call, k, actuals, ctx).try();
    c.resolve_inst(id, inst).try();
    c.note_call_edge(id, k, inst).try();
    c.subst(k.ret, inst)
}

note_call_edge = (c :: Checker, id: ExprId, k: Cand, inst: Inst)
                 Res<(), AllocError> {
    args ::= c.alloc.Vec<TyId>();
    k.tvars.loop((h, v) { args.add(inst.arg_for(v)).try() });
    c.note_edge(InstEdge(
        from_owner: c.owner_of_body(),
        to_owner: k.owner,
        to_name: k.name,
        to_tvars: k.tvars,
        args: args,
        span: c.tree.expr_at(id).span,
    ))
}

call_inst = (
    c       :: Checker,
    call    : Call,
    k       : Cand,
    actuals : Vec<Actual>,
    ctx     : Ctx
) Res<Inst, AllocError> {
    inst ::= c.alloc.Inst();
    (call.targs.len > 0).then(() {
        tys ::= c.alloc.Vec<TyId>();
        c.denote_targs(call.targs, ctx, tys).try();
        c.zip(k.tvars, tys, inst).try();
    });
    c.infer_targs(k, actuals, inst).try();
    c.infer_from_bounds(k, inst).try();
    Ok(inst);
}

infer_targs = (c :: Checker, k: Cand, actuals: Vec<Actual>, inst :: Inst)
              Res<(), AllocError> {
    k.params.loop((h, i, p) {
        actuals.get(i).match({
            None  => Ok(()),
            Ok(a) => a.is_lambda.match({
                true  => Ok(()),
                false => c.unify(p, a.ty, inst),
            }),
        }).try();
    });
    Ok(());
}

infer_from_bounds = (c :: Checker, k: Cand, inst :: Inst)
                    Res<(), AllocError> {
    k.tbounds.loop((h, tb) { c.infer_one_bound(k, tb, inst).try() });
    Ok(());
}

infer_one_bound = (c :: Checker, k: Cand, tb: TBound, inst :: Inst)
                  Res<(), AllocError> {
    v = c.types.var(tb.name, k.owner).try();
    inst.lookup(v).match({
        None  => Ok(()),
        Ok(g) => c.same_head(tb.bound, g).match({
            true  => c.infer_own_bound(tb.bound, g, inst),
            false => c.infer_impl_bound(tb.bound, g, inst),
        }),
    })
}

same_head = (c: Checker, a: TyId, b: TyId) bool {
    c.types.at(a).match({
        Named(x) => c.types.at(b).match({
            Named(y) => x.decl.eq(y.decl),
            _        => false,
        }),
        _        => false,
    })
}

infer_own_bound = (c :: Checker, bound: TyId, g: TyId, inst :: Inst)
                  Res<(), AllocError> {
    usize_ty = c.types.prim("usize").try();
    bs ::= c.alloc.Vec<TyId>();
    gs ::= c.alloc.Vec<TyId>();
    c.named_args(bound, bs).try();
    c.named_args(g, gs).try();
    (bs.len == gs.len).then(() {
        bs.loop((h, i, b) {
            c.unify(b, c.settled_or_index(gs.ty_at(i), usize_ty), inst).try();
        });
    });
    Ok(());
}

settled_or_index = (c: Checker, t: TyId, usize_ty: TyId) TyId {
    c.has_var(t).match({ true => usize_ty, false => t })
}

named_args = (c :: Checker, ty: TyId, out :: Vec<TyId>)
             Res<(), AllocError> {
    c.types.at(ty).match({
        Named(n) => n.args.loop((h, a) { out.add(a).try() }),
        _        => (),
    });
    Ok(());
}

infer_impl_bound = (c :: Checker, bound: TyId, g: TyId, inst :: Inst)
                   Res<(), AllocError> {
    c.types.at(g).match({
        Named(n) => c.infer_named_impl(bound, n, inst),
        Array(a) => c.infer_array_bound(bound, a.elem, inst),
        _        => Ok(()),
    })
}

infer_array_bound = (c :: Checker, bound: TyId, elem: TyId, inst :: Inst)
                    Res<(), AllocError> {
    c.array_range_shape(bound).match({
        false => Ok(()),
        true  => {
            bs ::= c.alloc.Vec<TyId>();
            c.named_args(bound, bs).try();
            bs.get(0).match({
                None  => Ok(()),
                Ok(b) => c.unify(b, elem, inst),
            })
        },
    })
}

infer_named_impl = (c :: Checker, bound: TyId, n: TyNamed, inst :: Inst)
                   Res<(), AllocError> {
    c.impl_bound_at(bound, n).try().match({
        None   => Ok(()),
        Ok(gb) => c.unify(bound, gb, inst),
    })
}

// The first local impl whose bound shares `bound`'s head, applied at the
// receiver's own arguments.
impl_bound_at = (c :: Checker, bound: TyId, n: TyNamed)
                Res<Res<TyId>, AllocError> {
    impls ::= c.alloc.Vec<LocalImpl>();
    c.local_impls(n, impls).try();
    impls.find((li) { c.same_head(li.bound, bound) }).match({
        None   => Ok(None),
        Ok(li) => {
            recv = c.inst_of_named(n).try();
            Ok(Ok(c.subst(li.bound, recv).try()))
        },
    })
}
