// probeS: create<i64> in a helper taking Alloc (non-nominal T)
mk = (a: Alloc) Res<Ptr<i64>, AllocError> {
    p = a.create<i64>().try();
    p.write(0, 7);
    Ok(p);
}

main = (env: Env) Res<i32, AllocError> {
    a ::= env.mem.alloc();
    p = mk(a).try();
    println("v {}", p.read(0));
    Ok(0);
}
