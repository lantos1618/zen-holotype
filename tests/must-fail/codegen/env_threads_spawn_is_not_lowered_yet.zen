// `env.threads.spawn(..)` IS REFUSED AT THE CALL, and now for the
// reason that is actually true of it: `Threads.spawn` is declared with
// no body and no impl of `Threads` anywhere supplies one, so the fat
// slot the call would read is a slot nothing fills.
//
// IT USED TO BE REFUSED FOR A SECOND-ORDER REASON. `spawn` is generic
// in the body's result type and nothing settles `T`, so the backend
// stopped at the erased element size and said so -- `a call through a
// bound whose type arguments nothing settles`. That sentence was true
// but it was the symptom of the missing body, and it was the only
// thing standing between this program and the crash its sibling
// `sleep` used to take (issue 781): `sleep` is monomorphic, so it
// walked straight past that check and off the end of a NULL slot.
//
// #781 gave the backend the first-order question -- does ANYTHING
// answer this member -- and `sleep` a real floor. `spawn` fails that
// question, so it is refused here, once, before the arithmetic about
// its type arguments is ever attempted.
//
// position: the call to `spawn`.

Thread, ThreadError = std.env

main = (env: Env) Res<i32, AllocError> {
    a ::= env.mem.alloc();
    env.threads.spawn(a, () Res<i32, ThreadError> { Ok(5) }).match({
        Ok(t)  => println("spawned"),
        Err(e) => println("failed"),
    });
    Ok(0)
}
