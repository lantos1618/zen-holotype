// A variant with no payload has no seat at all, so every argument to it
// is surplus — the same count as the one-seat face, at arity zero.
// position: the argument.

Sh = | A(i32) | B

main = (env: Env) Res<i32, AllocError> {
    v = Sh.B(1);
    v.match({
        A(n) => println("{}", n),
        B    => println("b"),
    });
    Ok(0);
}
