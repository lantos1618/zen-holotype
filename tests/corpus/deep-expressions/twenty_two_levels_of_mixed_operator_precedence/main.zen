// 22 levels of mixed operator nesting, folded by hand to a number.
//
// nesting_calls.zen pins DEPTH for calls; this file pins it for the
// OPERATOR TREE, where the interesting question is not depth but SHAPE:
// precedence and associativity must survive every level. The expression
// mixes four precedences (* over + over comparisons over &&) and both
// associativities, so a backend that mis-associates or flattens one
// level produces a different NUMBER -- every fold below is exact:
//
//   deep:    ten parenthesized (x * 3 + 1) folds from 2 -- the ELEVENTH
//            `* 3 + 1` sits outside every pair, so it is part of the
//            same expression, not a lost parenthesis:
//              2 -> 7 -> 22 -> 67 -> 202 -> 607 -> 1822 -> 5467
//                -> 16402 -> 49207 -> 147622 -> (* 3 + 1) -> 442867
//   unary:   `- - -4` is THREE right-associated negations (= -4, not
//            4 and not a `--` decrement) and `- -5` is two (= +5), so
//   folded:  442867 * 3 + 1 - (-4) - ... = 1328602 - 4 + 5 = 1328603
//   bool:    (4 > 3) && (3 > 2) && (2 > 1) is true -- note these are
//            three SEPARATE comparisons ANDed; C's `(a > b > c)` chain
//            would compare a bool against an int and read as garbage
//
// total prints 1328603 * 2 + 7 * 100000 = 3357206; any single-level
// mistake anywhere in twenty-two levels lands on some other number,
// including the plausible ones: reading the eleventh fold as another
// parenthesized one gives 3125926-ish shapes, dropping ONE negation
// gives 1328595/1328611 twins, and joining the bool wrong flips the
// last six digits to 900000. `&&` is short-circuit
// (gen_c_op.zen OpKind.ShortCircuit), so the skipped operand of a
// false conjunction is skipped without corrupting the join's value.
//
// The bool joins as 7 or 9 through a match BOUND FIRST -- deliberately
// not inline in the sum: arms 7/9 make any bool-sized spill visible
// (a truncated 1 prints a different total), which is the plausible
// wrong answer this file exists to catch.

main = (env: Env) Res<i32, AllocError> {
    deep ::= ((((((((((2 * 3 + 1) * 3 + 1) * 3 + 1) * 3 + 1) * 3 + 1)
        * 3 + 1) * 3 + 1) * 3 + 1) * 3 + 1) * 3 + 1) * 3 + 1;
    folded ::= deep * 3 + 1 - - -4 - -5;
    chained ::= (4 > 3) && (3 > 2) && (2 > 1);
    flag ::= chained.match({ true => 7, false => 9 });
    total ::= folded * 2 + flag * 100000;
    println("ops {}", total);
    Ok(0);
}
