// std.cmp — total order (`Ord`) as a three-way compare: `cmp(a, b)` is < 0 / == 0 / > 0.
// Scalar and StringView impls ship here; struct keys are one `T.impl(Ord, { cmp = … })` away.
{ strcmp } = std.c.libc
Ord*: {
    cmp: (Self, Self) i64,
}
i64.impl(Ord, {
    cmp = (a: i64, b: i64) i64 {
        (a < b).match ({
            true  => 0 - 1,
            false => (a > b).then({ 1 }, { 0 }),
        })
    }
})
i32.impl(Ord, {
    cmp = (a: i32, b: i32) i64 {
        (a < b).match ({
            true  => 0 - 1,
            false => (a > b).then({ 1 }, { 0 }),
        })
    }
})
u8.impl(Ord, {
    cmp = (a: u8, b: u8) i64 {
        (a < b).match ({
            true  => 0 - 1,
            false => (a > b).then({ 1 }, { 0 }),
        })
    }
})
StringView.impl(Ord, {
    cmp = (a: StringView, b: StringView) i64 { to_i64(a.strcmp(b)) }
})
