// src/gen/gen_diag.zen
// What a backend says when it cannot lower something.
//
// Shape mirrors `sema_diag.zen`: A DIAGNOSTIC IS A VALUE, NOT A RAISE.
// The only `Err` in this folder is `AllocError`, so a half-understood
// program still emits the C it could, plus the faults it owes; the
// caller decides whether that's a translation unit or a report.
//
// Fault set is small on purpose. All but one entry mean "not lowered
// yet" — a backend has no opinion on a program's meaning, sema already
// does, so there is deliberately no type-mismatch fault: if the backend
// disagrees with sema about a type, the bug is in the backend.
//
// `Overrun` is the odd one out, and exists because the alternative was
// measured: a backend that silently stops at its bound emits a
// translation unit with functions missing, `cc` reports the first call
// site, and the reader debugs the wrong program. A limit nobody hits is
// fine; a limit hit silently is not.
//
// This lives in shared plumbing, not `gen_c`: every backend fails the
// same three ways (unlowered form, unresolved name, unspellable type),
// none of which names C.

Span = ast.ast_span
str, String = std.text
Alloc, AllocError = std.mem
write_pos, write_usize = sema.sema_diag

// Something the backend was handed and could not turn into code.
//
// `what` is the node form or name, never a built sentence: a `Diag`
// stays copyable and costs no allocation to raise; `render` is the one
// place a sentence exists.
//
// `Overrun` carries a NUMBER, not a name — the number IS the message,
// so a reader learns which constant to raise, not just that a program
// was large.
GenFault* = Unsupported(str)     // a node form this backend does not lower yet
          | Unresolved(str)      // a name with no declaration behind it
          | Ambiguous(str)       // a name with more than one, and no overload rule
          | Untyped(str)         // sema returned no type and context supplied none
          | Unspellable(str)     // a type with no C spelling yet
          | Overrun(usize)       // more functions reachable than the backend's bound

// One fault, and where it is.
//
// `file` rides beside `span` (same pairing as `sema.Diag`) because a
// `Span` names a file relative to the compilation root and the two must
// not drift.
//
// NAMED `GenDiag`, NOT `Diag` — not taste. Four modules declare a `Diag`,
// which the language allows, but the bootstrapper resolves METHODS by
// name across the whole program: `d.render(out)` on this type once
// found `sema.render` (a 3-arg method) instead. STYLE.md's grep test
// wants the same thing anyway: grep `GenDiag`, get one file.
// docs/GEN_BOOTSTRAP_FIXES.md has the reproducer.
GenDiag* = {
    file*: str,
    span*: Span,
    fault*: GenFault,
}

// `file:line:col: message`, one line, no trailing newline — caller adds
// its own separator, so a `Vec` of these renders into one buffer.
// Free function, not a method, for the `GenDiag`-naming reason above.
render_gen* = (d: GenDiag, out :: String) Res<(), AllocError> {
    out.add_bytes(d.file).try();
    out.add_bytes(":").try();
    write_pos(out, d.span.start.line, d.span.start.col).try();
    out.add_bytes(": ").try();
    out.add_bytes(message(d.fault)).try();
    detail(d.fault, out).try();
    Ok(());
}

// The sentence, with nothing filled in. A fault's own words, so a
// caller that only wants to classify never has to build a string.
message* = (fault: GenFault) str {
    fault.match({
        Unsupported(_) => "codegen does not lower this yet:",
        Unresolved(_)  => "codegen cannot resolve",
        Ambiguous(_)   => "codegen found more than one declaration of",
        Untyped(_)     => "codegen has no type for",
        Unspellable(_) => "codegen cannot spell the type",
        Overrun(_)     => "codegen reached its bound on the functions one program may lower:",
    })
}

// What the fault names: a name quoted, or a bound written out.
//
// Payload is written straight into the sink, not bound to a local
// first — binding a `str` out of an enum arm and holding it makes the
// bootstrapper type the whole match as `()` (docs/GEN_BOOTSTRAP_FIXES.md).
detail* = (fault: GenFault, out :: String) Res<(), AllocError> {
    fault.match({
        Unsupported(w) => write_quoted(out, w),
        Unresolved(w)  => write_quoted(out, w),
        Ambiguous(w)   => write_quoted(out, w),
        Untyped(w)     => write_quoted(out, w),
        Unspellable(w) => write_quoted(out, w),
        Overrun(n)     => write_bound(out, n),
    })
}

write_quoted = (out :: String, w: str) Res<(), AllocError> {
    out.add_bytes(" `").try();
    out.add_bytes(w).try();
    out.add_bytes("`").try();
    Ok(());
}

// Names the constant, not just the number: a reader told a program is
// "too big" can't act on it, but one told which constant stopped it can
// raise it.
write_bound = (out :: String, n: usize) Res<(), AllocError> {
    out.add_bytes(" gen_c_decl.MAX_FUNCTIONS = ").try();
    out.write_usize(n).try();
    Ok(());
}
