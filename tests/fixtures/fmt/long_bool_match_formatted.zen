choose = (first_condition: bool, second_condition: bool, third_condition: bool) i32 {
    first_condition.match ({
        true  => 1,
        false => second_condition.match ({
            true  => 2,
            false => third_condition.match ({ true => 3, false => 4 }),
        }),
    })
}
pick_simple = (condition: bool) i32 { condition.match ({ true => 1, false => 0 }) }
pick_block = (condition: bool) i32 {
    condition.match ({
        true  => {
            1
        },
        false => 0,
    })
}
set_once = (condition: bool) i32 {
    value := 0
    condition.then({
        value = 1
    })
    value
}
set_explicit = (condition: bool) i32 {
    value := 0
    condition.then({
        value = 2
    })
    value
}
set_false_once = (condition: bool) i32 {
    value := 0
    (condition == false).then({
        value = 3
    })
    value
}
set_false_explicit = (condition: bool) i32 {
    value := 0
    (condition == false).then({
        value = 4
    })
    value
}
set_false_complex = (first: bool, second: bool) i32 {
    value := 0
    ((first || second) == false).then({
        value = 5
    })
    value
}
ff_cond_multiline = (s: i32, a: i32, d: i32, ind: i32) i32 { s + a + d + ind }
ff_cond_inline = (s: i32, a: i32, d: i32, ind: i32) i32 { s + a + d + ind }
pick_computed = (too_long: bool, s: i32, a: i32, d: i32, ind: i32) i32 {
    current := s
    too_long.match ({
        true  => current.ff_cond_multiline(a, d, ind),
        false => current.ff_cond_inline(a, d, ind),
    })
}
Opt<T>: Some(T) | None
pick_with_comment = (condition: bool, value: Opt<i32>) i32 {
    condition.match ({
        true  => value.match ({
            // this arm comment must survive the inline layout trial
            .Some(n) => n,
            .None    => 0,
        }),
        false => 0,
    })
}
