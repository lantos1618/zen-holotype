// fmt fixture EXPECTED OUTPUT (pair of slice_of_structs_unformatted.zen): a table of multi-line
// struct literals puts ONE element per line at one extra indent, with `]` on its own line — the
// `[Op(` / `), Op(` run-together is what this pins against. The single-line literals below pin the
// other half of the contract: `[1, 2, 3]`, `[[1, 2], [3, 4]]`, `[OPS[0].n]` must NOT grow.
Op*: {
    nm: string_view,
    n: i64,
}
OPS := [
    Op(
        nm: "add",
        n: 1,
    ),
    Op(
        nm: "sub",
        n: 2,
    ),
]
SMALL := [1, 2, 3]
NESTED := [[1, 2], [3, 4]]
main = () i64 {
    ones := [OPS[0].n]
    inner: [Op] := [
        Op(
            nm: "mul",
            n: 3,
        ),
    ]
    OPS.len + SMALL[0] + NESTED[0][1] + ones[0] + inner[0].n
}
