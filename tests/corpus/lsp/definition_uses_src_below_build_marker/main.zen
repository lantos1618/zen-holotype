str = std.text
Map = std.collections
Alloc, AllocError = std.mem
Checker = sema.sema_check
definition_with = lsp.lsp_def
check_build = lsp.lsp_query
candidate = zen.zen_path

DOC*: str = "CapabilityKind, capability_kind = gen.gen_c.gen_c_cap\nSurface, marker = gen.gen_c\nText, length = std.text\n"
PATH*: str = "src/project/src/gen/gen_c/gen_c_member.zen"
URI*: str = "file://src/project/src/gen/gen_c/gen_c_member.zen"

main = (env: Env) Res<i32, AllocError> {
    a ::= env.mem.alloc();
    text = candidate(env, a, "src/project/src", "std/text").try();
    println("candidate {}", text.path);
    checked = check_build(env, a, "src/project", PATH, DOC).try();
    show(env, checked.c, a, checked.root, checked.rel, 0, 42).try();
    show(env, checked.c, a, checked.root, checked.rel, 1, 22).try();
    show(env, checked.c, a, checked.root, checked.rel, 2, 19).try();
    Ok(0)
}

show = (
    env       : Env,
    c         :: Checker,
    a         : Alloc,
    root      : str,
    rel       : str,
    line      : usize,
    character : usize
)
       Res<(), AllocError> {
    docs ::= a.Map<str, str>();
    d = definition_with(
        env,
        c,
        a,
        root,
        docs,
        URI,
        DOC,
        rel,
        line,
        character
    ).try();
    println("{} {}", d.found, d.uri);
    Ok(())
}
