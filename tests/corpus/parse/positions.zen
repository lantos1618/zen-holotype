// positions.zen -- the span of every node below is asserted in
// POSITIONS.md. columns are 1-based; a span is start..end with end
// one past the last character, so `Point` on line 4 is 4:1..4:6.
Point = {
    x: i32,
    y: i32,
}

Sign = Neg | Zero | Pos

sign_of = (n: i32) Sign {
    (n == 0).match({
        true => Sign.Zero,
        false => Sign.Pos,
    });
}

main = (env: Env) Res<i32, ArgError> {
    p = Point(x: 3, y: 4);
    d = p.x * p.x + p.y * p.y;
    println("{}", d);
    Ok(0);
}
