// A CLOSURE BODY IS TYPED, AND A LEGAL ONE STILL COMPILES. The walk
// `sema_call.lambda_body` added enters every lambda argument's body;
// this file is the half that must stay silent, and it asserts the thing
// that makes the walk possible at all — that a closure parameter gets
// its type FROM THE CALLEE'S SIGNATURE.
//
// `x.doubled()` is the assertion: `doubled` belongs to `Cell` and to
// nothing else, so if `(x)` were bound at a hole the call would resolve
// to no member. Before the walk the body was never asked, so this
// proved nothing; now it is the proof.
//
// The other two are the shapes src/ is written in — an accumulating
// `loop`, and a `then` whose body reads a name from the frame outside
// it — because a walk that pushed a scope wrongly would lose the
// enclosing binding rather than report anything.

Cell = {
    n*: i32,

    doubled* = (self: @Self) i32 { self.n * 2 },
}

each = (c: Cell, f: (x: Cell) ()) () { f(c) }

main = (env: Env) Res<i32, AllocError> {
    each(Cell(n: 21), (x) { println("{}", x.doubled()) });

    xs = [1, 2, 3, 4];
    total: i32 ::= 0;
    xs.loop((h, v) { total = total + v; });
    println("{}", total);

    base = 100;
    (total > 5).then(() { println("{}", base + total) });

    Ok(0);
}
