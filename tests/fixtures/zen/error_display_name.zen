// error-display: a just-caught error PRINTS — IoError.name / ParseError.parse_error_name
// give every error a str the Display surface already knows how to show, bare and
// interpolated. Asserted on exact stdout by the oracle.
halloc = std.mem.heap
{ contents_in } = std.io.file
{ println, formatln, arg_str } = std.text.fmt
{ name, IoError, Result } = std.core.result
{ parse_error_name, try_parse_int } = std.text.str
main = () i32 {
    heap := halloc.gpa()
    a := heap.addr()
    rc1 := a.contents_in("/definitely/not/a/real/path.txt").match ({
        .Ok(s)  => 1,
        .Err(e) => {
            println(e.name())
            formatln("read failed: {}", [arg_str(e.name())])
            0
        },
    })
    rc2 := "12ab".try_parse_int().match ({
        .Ok(v)  => 1,
        .Err(p) => {
            println(p.parse_error_name())
            0
        },
    })
    rc1 + rc2
}
