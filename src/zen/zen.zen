// src/zen/zen.zen
// The CLI, and the folder's surface.
//
// PLAN.md's line is "thin cli: build / fmt / test / lsp", and thin is
// the whole brief: `main` reads the command line, picks a command, and
// returns its exit code. Everything a command does is one call away, in
// a sibling, because "the compiler is a library from commit one" — `zen
// build`, `zen fmt`, `zen lsp` and `zen test` are entry points into one
// artifact and must never become four programs.
//
// A FOLDER AND NOT A FILE, and the reason is a gate. A folder root is
// normally nothing but starred re-exports; this one also holds `main`,
// which is the one declaration a program has exactly one of and which
// re-exporting could not express anyway. The folder exists because
// `tests/run.py` stages a test against the top-level DIRECTORIES of
// `src/` — a top-level FILE there can never be reached by a corpus
// test, so `src/zen.zen` would have been the one part of the compiler
// nothing could test. `tests/corpus/cli/` imports this module.
//
// `main` RETURNS `Res<i32, AllocError>` because that is the only error
// the seed subset lets it name: PLAN.md 0.5 has no error unions, so a
// program that both opens files and allocates carries ONE nominal
// error, and every other failure is a value. A failed read is counted
// and printed like a syntax error, and the count is the exit code.

Alloc, AllocError = std.mem
str, String = std.text
FsError = std.env

Cli*, Job*, FmtJob*, Debug*, cli*, USAGE* = zen.zen_cli
Build*, fs_message* = zen.zen_build
Unit* = zen.zen_path
build* = zen.zen_run
format* = zen.zen_fmt
Server, serve, serve_stdio = lsp

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    cli(env.argv).match({
        Build(job)    => build(env, alloc, job),
        Fmt(job)      => format(env, alloc, job),
        Later(name)   => later(env, alloc, name),
        Usage(word)   => usage(word),
        Missing(flag) => missing(flag),
    })
}

// A command this compiler will have and does not yet — except `lsp`,
// which now has a server behind it and reaches it from here.
//
// THE DISPATCH IS ON THE NAME AND NOT A NEW `Cli` VARIANT, deliberately:
// `zen_cli.zen` is the file that decides what a command line MEANS, and
// `lsp` does not yet take a flag, a root or an `--entry` that it would
// have to decide about. When the stdio transport lands and `zen lsp`
// takes arguments, the variant belongs there and this branch goes.
later = (env: Env, alloc: Alloc, name: str) Res<i32, AllocError> {
    name.eq("lsp").match({
        true  => lsp(env, alloc),
        false => not_yet(name),
    })
}

not_yet = (name: str) Res<i32, AllocError> {
    println("zen {}: not yet — see docs/PLAN.md for the stage it arrives at", name);
    Ok(2);
}

// `zen lsp` — the language server, over stdin and stdout, which is what
// an editor launches and the only thing it can launch.
//
// `zen lsp <requests> <replies>` IS THE SAME SERVER OVER TWO FILES, and
// it stays because it is what the corpus drives: a test cannot hold a
// pipe open, and a transport nothing tests is a transport that rots.
// Both spellings reach `lsp_serve.zen`, which holds no transport at all,
// so the two cannot drift apart — see that file's header.
//
// NO FLAGS, AND NO `--entry`. `design_lsp.md` §4 says why: a root is
// discovered from `initialize`'s `rootUri`, and the driver already
// probes when no entry is named.
//
// `--stdio` IS THE ONE WORD THIS ACCEPTS AND IGNORES, and it is not a
// flag this compiler invented — it is what a client appends. VS Code's
// `vscode-languageclient` adds it to an executable server's argv
// whenever `TransportKind.stdio` is named, and other clients do the
// same, because the convention predates servers that speak only one
// transport. Without this the word arrives as `from`, the FILE form
// finds no second name, and the server prints usage and exits 2 —
// which from inside an editor reads as `write EPIPE` and "the server
// crashed", naming nothing that is wrong.
//
// It was found the first time anyone ran this from a real editor,
// which is the whole lesson: every gate here drives the server
// directly, so not one of them passes the argv a client actually
// sends.
lsp = (env: Env, a: Alloc) Res<i32, AllocError> {
    from = file_arg(env, 2);
    to = file_arg(env, 3);
    from.is_empty().match({
        true  => serve_stdio(env, a),
        false => paired(env, a, from, to),
    })
}

// One path and not two is a caller who meant to name both: the file form
// answers INTO a file, so a `zen lsp requests.txt` with nowhere to write
// would run a whole session and drop every reply.
paired = (env: Env, a: Alloc, from: str, to: str) Res<i32, AllocError> {
    to.is_empty().match({
        true  => lsp_usage(),
        false => answer(env, a, from, to),
    })
}

arg = (env: Env, i: usize) str {
    env.argv.get(i).match({ Ok(s) => s, None => "" })
}

// A transport word is not a filename. `""` is what "there is no file
// here" already means to the caller above, so a client's `--stdio`
// answers the same as an absent argument and the stdio path is reached
// by the same branch rather than by a second one.
file_arg = (env: Env, i: usize) str {
    word = arg(env, i);
    word.eq("--stdio").match({ true => "", false => word })
}

lsp_usage = () Res<i32, AllocError> {
    println("zen lsp                       the language server, over stdin and stdout");
    println("zen lsp <requests> <replies>  the same server over two files, which is");
    println("                              what tests/corpus/lsp drives");
    Ok(2);
}

answer = (env: Env, a: Alloc, from: str, to: str) Res<i32, AllocError> {
    env.fs.read(a, from).match({
        Err(e)    => unreadable(from, e),
        Ok(input) => replies(env, a, input.view(), to),
    })
}

replies = (env: Env, a: Alloc, input: str, to: str) Res<i32, AllocError> {
    s ::= a.Server(env);
    out ::= a.String().try();
    serve(s, input, out).try();
    env.fs.write(to, out.view()).match({
        Err(e) => unwritable(to, e),
        Ok(_)  => Ok(0),
    })
}

unreadable = (path: str, e: FsError) Res<i32, AllocError> {
    println("zen lsp: {}: {}", path, fs_message(e));
    Ok(1);
}

unwritable = (path: str, e: FsError) Res<i32, AllocError> {
    println("zen lsp: -o {}: {}", path, fs_message(e));
    Ok(1);
}

// Exit 2 and not 1: "this build found problems" and "I could not tell
// what you asked for" are different answers, and `scripts/fixpoint.sh`
// reads the code.
usage = (word: str) Res<i32, AllocError> {
    word.is_empty().match({
        true  => println("{}", USAGE),
        false => println("zen: unknown argument `{}`\n{}", word, USAGE),
    });
    Ok(2);
}

// A flag that was needed and absent is not an unknown argument: the
// caller spelled everything right and left something out, and naming
// which is the difference between a typo hunt and a one-word fix.
missing = (flag: str) Res<i32, AllocError> {
    println("zen build: `{}` is required — a build with no `{}` writes nothing\n{}",
            flag, flag, USAGE);
    Ok(2);
}
