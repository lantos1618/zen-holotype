// THE SHAPE THE POSITION RULE EXISTS FOR. A pack borrows the calling frame,
// so returning one hands back a pointer into a block that has already ended:
//
//     g = () vararg<i32> { f(1, 2, 3) }
//
// The run below lives in `escapes`' caller, so `escapes` itself happens to be
// harmless — which is exactly why the rule is on the TYPE and not on a
// dataflow answer. One rewrite away it dangles, and no diagnostic in the
// language would say so; refusing the position costs one scan and is exact,
// where an escape analysis would be neither.
//
// A field type is the same escape by the other route, and refused by the same
// rule (docs/design_vararg.md §4).
//
// position: the `vararg` in the return type.

escapes = (v: vararg<i32>) vararg<i32> { v }

main = (env: Env) Res<i32, AllocError> {
    println("{}", escapes(1, 2).len);
    Ok(0);
}
