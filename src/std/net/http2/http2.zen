// src/std/net/http2/http2.zen
// HTTP/2 public surface. Protocol machinery lives in focused sibling modules.

H2Error*, H2StreamError*, H2FailureDelivery*, H2Response*, H2Head*, H2Chunk*, H2Receiver*, MAX_SEND*, h2_chunk* = std.net.http2.http2_types
H2Client*, post_once* = std.net.http2.http2_client
huf_decode*, hpack_status* = std.net.http2.http2_hpack
