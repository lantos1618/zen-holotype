Box = { value :: str }
fill = (output :: Box, env: Env, letters: str) Res<(), AllocError> {
    alloc  ::= env.mem.alloc();
    buffer ::= alloc.String().try();
    buffer.add(letters).try();
    output.value = buffer.view();
    Ok(())
}
main = (env: Env) Res<i32, AllocError> {
    output ::= Box(value: "safe");
    fill(output, env, "ab").try();
    println("{}", output.value);
    Ok(0)
}
