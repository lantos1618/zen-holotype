FsError = std.env

main = (env: Env) Res<i32, FsError | AllocError> {
    alloc = env.mem.alloc();
    cwd   = env.fs.cwd(alloc).try();
    env.fs.write("cwd-marker.txt", "actual directory").try();
    path = alloc.String("{}/cwd-marker.txt", cwd.view()).try();
    text = env.fs.read(alloc, path.view()).try();
    println("absolute {}", cwd.view().starts_with("/"));
    println("{}", text.view());
    env.fs.remove("cwd-marker.txt").try();
    Ok(0)
}
