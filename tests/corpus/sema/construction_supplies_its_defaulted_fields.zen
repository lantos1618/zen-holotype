// tests/corpus/sema/construction_supplies_its_defaulted_fields.zen
//
// `::` with a value in a struct body is a FIELD WITH A DEFAULT, and
// DESIGN.md's sentence is "optional at construction": the call supplies
// it or omits it, and what it supplies is what the field holds. Pinned
// pinned by output, not silence — this half of issue 778 was already
// correct on main (this test PASSES there, checked 2026-08-25 against a
// compiler built from origin/main), and it stays correct beside the
// refusal its twin earns.
//
//   - B(x: 1, y: 2, z: 3): every supplied default WINS. The emitted C
//     used to be where a sibling bug hid — sema checked the argument and
//     gen_c wrote nothing for it — so the read-back is the assertion.
//   - B(x: 5): every default OMITTED falls back to its declaration's
//     value — x has none, so it stays supplied even in this half.
//   - A: `:` with a value is a CONSTANT (DESIGN.md "The spelling is
//     what decides"), so no construction names one; the reads fold to
//     the declaration.

B = { x: i32, y:: i32 = 20, z:: i32 = 30 }
A = { x: i32, y: i32 = 20, z: i32 = 30 }

main = (env: Env) Res<i32, AllocError> {
    b = B(x: 1, y: 2, z: 3);
    println("supplied {} {} {}", b.x, b.y, b.z);
    e = B(x: 5);
    println("omitted {} {} {}", e.x, e.y, e.z);
    a = A(x: 1);
    println("constant {} {} {}", a.x, A.y, A.z);
    Ok(0);
}
