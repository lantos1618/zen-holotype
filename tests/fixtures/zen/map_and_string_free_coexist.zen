halloc = std.mem.heap
maps = std.collections.map
{ String, init } = std.text.string
{ expect } = std.core.result
main = () i32 {
    alloc := halloc.gpa()
    a := alloc.addr()
    w := maps.of(a, "x", 7)
    s := a.init(4).expect("init").push_in(a, '!').expect("push_in")
    n := w.get("x", 0) + to_i32(s.len)
    w.free(a)
    s.free_in(a)
    n
}
