// A named construction's explicit type list is the declaration's complete
// list, including for a declaration that has no type parameters.

Pair<T, U> = { first: T, second: U }
Point = { x: i32 }

main = (env: Env) Res<i32, AllocError> {
    println("{}", Pair<i32>(first: 1, second: "one"));
    println("{}", Pair<i32, str, bool>(first: 1, second: "one"));
    println("{}", Point<str>(x: 1));
    Ok(0);
}
