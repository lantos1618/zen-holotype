// str.len is a BYTE count, not a character count: DESIGN.md says utf-8
// is functions over bytes, paid for only where the guarantee is wanted.
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    println("{}", "hello".len());
    println("{}", "héllo".len());
    println("{}", "日本語".len());
    println("{}", "🎉".len());
    println("{}", "".len());
    Ok(0);
}
