// M3'S GATE, THE VIA-META HALF (`docs/design_meta.md` §7, M3):
// `@meta(self: @Self).name` inside a struct body folds at sema time to
// the declaring type's name as a `str`, and the backend lowers it as an
// ordinary string literal having learned nothing new. The fold is real
// or this file does not compile: `n` is declared `str` by hand, so a
// fold that answered anything else is caught by the assignment.
//
// The exact stdout oracle checks both the folded name and its length.
//
// MUTATION RESISTANCE (§6.4): the output is the name AND its `.len`.
// A fold that silently answered the empty string — the plausible wrong
// answer — prints ` 0`, not `Point 5`, and the length of a name is a
// number no default produces.
//
// THE REFUSALS ARE THE OTHER HALF OF THE GATE: the value form, the
// bare typed form, and a cascade are still the wall, pinned by
// `must-fail/sema/meta_*`.

Point = {
    x: i64,
    y: i64,

    type_name* = (self: @Self) str { @meta(self: @Self).name },
}

main = (env: Env) Res<i32, AllocError> {
    p      = Point(x: 1, y: 2);
    n: str = p.type_name();
    println("{} {}", n, n.len);
    Ok(0);
}
