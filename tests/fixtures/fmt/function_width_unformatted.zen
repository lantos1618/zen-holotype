{ Malloc } = std.mem.alloc
pid_path = (mp: MutPtr<Malloc>, pre: string_view, suf: string_view) string_view { pre }
SHORT = () string_view { "ok" }
BUILDBIN = (mp: MutPtr<Malloc>) string_view { mp.pid_path("/tmp/zenbuild_spec_", ".bin") }
SPECFILE = (mp: MutPtr<Malloc>) string_view { mp.pid_path("/tmp/zenbuild_spec_", ".txt") }
BUILD_TAIL = () string_view { "\nmain = () i32 { build(Build(_: 0)).emit_spec()  0 }\n" }
COMPLEX = (n: i32) i32 { (n > 100).match ({ true => n, false => n + 1 }) }
