// C lowering for `Threads.sleep`, `Threads.spawn`, and `Thread.join`.
// POSIX helpers are emitted on demand. Capability receivers carry authority
// Only and produce no C value.

ExprId, Call, Arg, Lambda, Access, TypeId = std.ast
AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId = sema.sema_ty
Ctx = sema.sema_check
type_from_ast = sema.sema_denote
Emit = gen.gen_emit
sym_member, sym_gen, sym_local = gen.gen_name
CBackend = gen.gen_c.gen_c_state
LocalSlot = gen.gen_c.gen_c_frame
comment = gen.gen_c.gen_c_runtime
arg_text = gen.gen_c.gen_c_arg
unsupported = gen.gen_c.gen_c_report
spelled_lambda = gen.gen_c.gen_c_inline
captures = gen.gen_c.gen_c_scope
expr, want_of = gen.gen_c.gen_c_expr
ctype, declarator = gen.gen_c.gen_c_type
temp, payload_type = gen.gen_c.gen_c_flow
Dest, block = gen.gen_c.gen_c_stmt
write_assign_ok, write_assign_err = gen.gen_c.gen_c_flow
settled = gen.gen_c.gen_c_settle

// the floors

// `nanosleep`, emitted only for a program that sleeps.
emit_threads* = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    be.uses_threads().match({
        false => Ok(()),
        true  => be.write_sleep(out),
    }).try();
    be.uses_spawn().match({
        false => Ok(()),
        true  => emit_spawn_floor(out),
    })
}

write_sleep = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    out.say("#include <errno.h>").try();
    out.line().try();
    comment(out, "the sleep floor is POSIX nanosleep").try();
    out.say("static void zg_threads_sleep(uint64_t ms) {").try();
    out.indent();
    out.say("struct timespec ts;").try();
    out.say("ts.tv_sec = (time_t)(ms / UINT64_C(1000));").try();
    out.say(
        "ts.tv_nsec = (long)((ms % UINT64_C(1000)) * UINT64_C(1000000));"
    ).try();
    out.say("while (nanosleep(&ts, &ts) != 0 && errno == EINTR) {}").try();
    out.dedent();
    out.say("}").try();
    out.line().try();
}

// The pthread floor. Create and join calls
// are written at the call sites themselves; all a program that spawns
// needs here is the header, with the clock's feature-macro dance in
// front of it (`gen_c_clock.zen` says why the `#undef` is load-bearing).
emit_spawn_floor = (out :: Emit) Res<(), AllocError> {
    out.say("#undef _POSIX_C_SOURCE").try();
    out.say("#define _POSIX_C_SOURCE 200809L").try();
    comment(
        out,
        "the spawn floor is POSIX pthreads, not C99 - hence the macro above"
    ).try();
    out.say("#if defined(__GLIBC__)").try();
    out.say("#undef _FEATURES_H").try();
    out.say("#include <features.h>").try();
    out.say("#endif").try();
    out.say("#include <pthread.h>").try();
    out.line().try();
    Ok(());
}

// Capture records are emitted after types because their fields name those
// types. Unlike a deferred
// closure's record — storage the block owns — a spawned closure's record
// is heap memory: the thread outlives the frame that wrote the captures,
// so the frame cannot be the storage (law 1 is why the signature takes
// an Alloc at all).
emit_spawn_envs* = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    Range(0, be.spawn_env_count()).loop((h, i) {
        be.spawn_env_at(i).match({
            None  => Ok(()),
            Ok(t) => out.say(t.view()),
        }).try();
    });
    Ok(());
}

// Lowering `env.threads.sleep(ms)`.
// Sleep answers unit, but the lowering stands where an expression was,
// so the statement is written and `0` is left where the value goes —
// unit is zero-width in C and nothing reads it.
lower_sleep* = (
    be  :: CBackend,
    c   : Call,
    ret : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    be.need_clock();
    be.need_threads();
    be.request_type(ret).try();
    usize_ty = be.check.types.prim("usize").try();
    ms ::= be.alloc.String().try();
    be.arg_text(c, 0, usize_ty, ctx, ms).try();
    be.fmt("zg_threads_sleep({});\n", ms.view()).try();
    out.add("0")
}

// Lowering `env.threads.spawn(a, body)`.
// A spawned closure becomes a capture record, lifted body, and pthread
// trampoline. Unlike a deferred closure:
//   - the record is malloc'D, not block storage — the thread outlives
//     the frame, so the frame cannot hold the captures;
//   - the body answers, so the lifted function returns the body's
//     `Res<T, ThreadError>` and the trampoline heap-copies that answer
//     for `pthread_join` to hand back — which is also why `Thread`
//     carries only `id`: the result travels through the join, not
//     through the handle;
//   - `T` is settled by the closure's declared return type, which the floor
//     needs to size the copy.
// The Alloc argument is not lowered. It is the authority the signature
// demands (law 2: an escaping closure needs its own memory, so the
// caller must be holding an allocator to say `spawn`), and the floor's
// mechanism is `malloc` — wiring the arena's pages into the thread's
// record is the non-minimal version of this floor.
lower_spawn* = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    ret : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    be.need_spawn();
    be.request_type(ret).try();
    c.args.get(1).match({
        None  => be.unsupported(id, "`spawn` with no closure", out),
        Ok(g) => be.spawn_arg(id, g, ret, ctx, out),
    })
}

// `defer`'s rule, said about `spawn`: the closure is written at the call
// Site. A function-typed name handed over would have no captures to copy
// and no body to lift, so it is refused by name rather than lowered into
// something that looks like it worked.
spawn_arg = (
    be  :: CBackend,
    id  : ExprId,
    g   : Arg,
    ret : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    be.spelled_lambda(g.value).match({
        Ok(l) => be.spawn_lambda(id, l, ret, ctx, out),
        None  => be.unsupported(
            id,
            "`spawn` given something other than a closure written at the call site",
            out
        ),
    })
}

spawn_lambda = (
    be  :: CBackend,
    id  : ExprId,
    l   : Lambda,
    ret : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    (l.params.len > 0).match({
        true  => be.unsupported(
            id,
            "a spawned closure that takes parameters",
            out
        ),
        false => be.spawn_ret(id, l, ret, ctx, out),
    })
}

spawn_ret = (
    be  :: CBackend,
    id  : ExprId,
    l   : Lambda,
    ret : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    l.ret.match({
        None   => be.unsupported(
            id,
            "a spawned closure that declares no return type",
            out
        ),
        Ok(rt) => be.spawn_typed(id, l, rt, ret, ctx, out),
    })
}

spawn_typed = (
    be  :: CBackend,
    id  : ExprId,
    l   : Lambda,
    rt  : TypeId,
    ret : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    rty = be.check.type_from_ast(rt, ctx).try();
    be.check.types.at(rty).match({
        Res(_) => be.spawn_res(id, l, rty, ret, ctx, out),
        _      => be.unsupported(
            id,
            "a spawned closure whose return is not a Res",
            out
        ),
    })
}

spawn_res = (
    be  :: CBackend,
    id  : ExprId,
    l   : Lambda,
    rty : TyId,
    ret : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    be.request_type(rty).try();
    caps ::= be.alloc.Vec<LocalSlot>();
    be.captures(l.body, caps).try();
    n = be.next_spawn();
    be.write_spawn_env(n, caps).try();
    write_spawn_fn(be, n, l, caps, rty, ctx).try();
    write_spawn_tramp(be, n, rty).try();
    be.write_spawn_call(n, caps, ret, out)
}

// the capture record

spawn_env_name = (be :: CBackend, n: usize, out :: String)
                 Res<(), AllocError> {
    sym_gen(out, "sp", n)
}

write_spawn_env = (be :: CBackend, n: usize, caps: Vec<LocalSlot>)
                  Res<(), AllocError> {
    (caps.len == 0).match({
        true  => Ok(()),
        false => be.write_spawn_struct(n, caps),
    })
}

// The record's field names are the frame's own mangled local names — the
// same rule `gen_c_scope.zen`'s capture record obeys, because the
// prologue's remap depends on it.
write_spawn_struct = (be :: CBackend, n: usize, caps: Vec<LocalSlot>)
                     Res<(), AllocError> {
    env ::= be.alloc.String().try();
    be.spawn_env_name(n, env).try();
    text ::= be.alloc.String().try();
    text.fmt("typedef struct {} {{\n", env.view()).try();
    caps.loop((h, s) { be.write_spawn_field(s, text).try() });
    text.fmt("}} {};\n", env.view()).try();
    be.add_spawn_env(text)
}

write_spawn_field = (be :: CBackend, s: LocalSlot, text :: String)
                    Res<(), AllocError> {
    text.add("    ").try();
    cname ::= be.alloc.String().try();
    sym_local(cname, s.name, s.index).try();
    s.by_ref.match({
        false => be.declarator(s.ty, cname.view(), text),
        true  => be.spawn_ref_field(s.ty, cname.view(), text),
    }).try();
    text.add(";\n")
}

// A `::` binding is an address everywhere else, so what the record
// copies is the address — one word, and the thread reads the storage it
// points at. Whether that storage outlives the frame is the program's
// question, not this floor's: the own pass has already refused the
// captures that provably dangle.
spawn_ref_field = (be :: CBackend, ty: TyId, name: str, text :: String)
                  Res<(), AllocError> {
    be.ctype(ty, text).try();
    text.fmt(" *{name}")
}

// the lifted body

// The body function. `static <Res<T, ThreadError>> zg_sbN(zg_spN *)` —
// an ordinary function at the body's own type, so a `.try()` inside the
// body returns out of it (the ctx below is the body's own, with `ret`
// rebound; the caller's would return the caller's type from this
// function, which is C that does not compile).
write_spawn_fn = (
    be   :: CBackend,
    n    : usize,
    l    : Lambda,
    caps : Vec<LocalSlot>,
    rty  : TyId,
    ctx  : Ctx
) Res<(), AllocError> {
    proto ::= be.alloc.String().try();
    be.spawn_fn_proto(n, rty, caps, proto).try();
    held = be.take_buf().try();
    // The caller's cleanup is set aside with its buffer: a `.try()` in
    // the body unwinds to depth 0, and depth 0 is the thunk's own frame.
    clean = be.hold_cleanup().try();
    be.indent();
    be.write_spawn_prologue(n, caps).try();
    tctx = Ctx(
        module: ctx.module,
        ret: rty,
        has_ret: true,
        self_ty: ctx.self_ty,
        has_self: ctx.has_self
    );
    block(be, l.body, tctx, rty, Dest.Return).try();
    text ::= be.alloc.String().try();
    text.add(be.text()).try();
    be.restore_cleanup(clean);
    be.put_buf(held);
    name ::= be.alloc.String().try();
    sym_gen(name, "sb", n).try();
    be.add_function(name, proto, text)
}

spawn_fn_proto = (
    be   :: CBackend,
    n    : usize,
    rty  : TyId,
    caps : Vec<LocalSlot>,
    out  :: String
) Res<(), AllocError> {
    out.add(be.linkage()).try();
    be.ctype(rty, out).try();
    out.add(" ").try();
    sym_gen(out, "sb", n).try();
    (caps.len == 0).match({
        true  => out.add("(void *zg_p)"),
        false => be.spawn_fn_params(n, out),
    })
}

spawn_fn_params = (be :: CBackend, n: usize, out :: String)
                  Res<(), AllocError> {
    env ::= be.alloc.String().try();
    be.spawn_env_name(n, env).try();
    out.fmt("({} *zg_e)", env.view())
}

// The prologue is the whole of the remapping, as it is for `defer`:
// every captured name is re-declared here, with the same C name it had
// in the enclosing frame, initialised from the record. The body below it
// then lowers unchanged.
write_spawn_prologue = (be :: CBackend, n: usize, caps: Vec<LocalSlot>)
                       Res<(), AllocError> {
    (caps.len == 0).match({
        true  => be.writeln("(void)zg_p;"),
        false => be.write_spawn_unpack(caps),
    })
}

write_spawn_unpack = (be :: CBackend, caps: Vec<LocalSlot>)
                     Res<(), AllocError> {
    caps.loop((h, s) { be.write_spawn_unpack_one(s).try() });
    Ok(())
}

write_spawn_unpack_one = (be :: CBackend, s: LocalSlot)
                         Res<(), AllocError> {
    line  ::= be.alloc.String().try();
    cname ::= be.alloc.String().try();
    sym_local(cname, s.name, s.index).try();
    s.by_ref.match({
        false => be.declarator(s.ty, cname.view(), line),
        true  => be.spawn_ref_field(s.ty, cname.view(), line),
    }).try();
    be.fmt("{} = zg_e->{};\n", line.view(), cname.view())
}

// the trampoline

// `void *zg_sN(void *)`, the function `pthread_create` is handed. The
// body's answer is copied onto the heap and the copy is the thread's
// return value: `pthread_join` hands back exactly that pointer, which is
// how a `Res<T, ThreadError>` crosses the thread boundary without
// `Thread` carrying a type. A NULL answer is malloc's failure, which
// `join` reads as `Panicked`; the record itself is released here, its
// fields already unpacked by the body.
write_spawn_tramp = (be :: CBackend, n: usize, rty: TyId)
                    Res<(), AllocError> {
    name ::= be.alloc.String().try();
    sym_gen(name, "s", n).try();
    proto ::= be.alloc.String().try();
    proto.add(be.linkage()).try();
    proto.add("void *").try();
    proto.add(name.view()).try();
    proto.add("(void *zg_p)").try();
    rct ::= be.alloc.String().try();
    be.ctype(rty, rct).try();
    fname ::= be.alloc.String().try();
    sym_gen(fname, "sb", n).try();
    body ::= be.alloc.String().try();
    body.fmt("    {} zg_r = {}(zg_p);\n", rct.view(), fname.view()).try();
    body.fmt(
        "    {} *zg_out = ({} *)malloc(sizeof({}));\n",
        rct.view(),
        rct.view(),
        rct.view()
    ).try();
    body.add("    if (zg_out) *zg_out = zg_r;\n").try();
    body.add("    free(zg_p);\n").try();
    body.add("    return (void *)zg_out;\n").try();
    be.add_function(name, proto, body)
}

// the call site

// `<record> *h = malloc(..); <copies>; pthread_create(..) or
// Err(SpawnFailed)`. The Alloc argument is not read (the header says
// why); the record's malloc failure and pthread_create's refusal are the
// one `SpawnFailed` a caller acts on.
write_spawn_call = (
    be   :: CBackend,
    n    : usize,
    caps : Vec<LocalSlot>,
    ret  : TyId,
    out  :: String
) Res<(), AllocError> {
    dst = be.temp(ret, "t").try();
    rec ::= be.alloc.String().try();
    (caps.len == 0).match({
        true  => Ok(()),
        false => be.malloc_spawn_env(n, caps, rec),
    }).try();
    pt ::= be.alloc.String().try();
    sym_gen(pt, "t", be.next_tmp()).try();
    be.fmt("pthread_t {};\n", pt.view()).try();
    tramp ::= be.alloc.String().try();
    sym_gen(tramp, "s", n).try();
    cond ::= be.alloc.String().try();
    (rec.view().len == 0).match({
        true  => cond.fmt(
            "pthread_create(&{}, 0, {}, 0) != 0",
            pt.view(),
            tramp.view()
        ),
        false => cond.fmt(
            "({} == 0) || pthread_create(&{}, 0, {}, {}) != 0",
            rec.view(),
            pt.view(),
            tramp.view(),
            rec.view()
        ),
    }).try();
    be.fmt("if ({}) {{\n", cond.view()).try();
    be.indent();
    (rec.view().len == 0).match({
        true  => Ok(()),
        false => be.fmt("free({});\n", rec.view()),
    }).try();
    be.write_assign_err(ret, "SpawnFailed", dst.view()).try();
    be.dedent();
    be.writeln("} else {").try();
    be.indent();
    be.write_spawn_ok(ret, pt.view(), dst.view()).try();
    be.dedent();
    be.writeln("}").try();
    out.add(dst.view())
}

malloc_spawn_env = (
    be   :: CBackend,
    n    : usize,
    caps : Vec<LocalSlot>,
    rec  :: String
) Res<(), AllocError> {
    env ::= be.alloc.String().try();
    be.spawn_env_name(n, env).try();
    sym_gen(rec, "h", be.next_tmp()).try();
    be.fmt(
        "{} *{} = ({} *)malloc(sizeof({}));\n",
        env.view(),
        rec.view(),
        env.view(),
        env.view()
    ).try();
    caps.loop((h, s) { be.copy_spawn_capture(s, rec.view()).try() });
    Ok(())
}

// The captures are copied here, at spawn — the rule
// `defer_captures_at_registration` pins, and the reason is the same:
// the values are read where they are still alive.
copy_spawn_capture = (be :: CBackend, s: LocalSlot, cell: str)
                     Res<(), AllocError> {
    cname ::= be.alloc.String().try();
    sym_local(cname, s.name, s.index).try();
    be.fmt("{cell}->{} = {};\n", cname.view(), cname.view())
}

write_spawn_ok = (be :: CBackend, ret: TyId, pt: str, dst: str)
                 Res<(), AllocError> {
    be.payload_type(ret, "Ok").match({
        None    => be.write_assign_ok(ret, "0", dst),
        Ok(tty) => be.write_spawn_thread(ret, tty, pt, dst),
    })
}

write_spawn_thread = (be :: CBackend, ret: TyId, tty: TyId, pt: str, dst: str)
                     Res<(), AllocError> {
    cty ::= be.alloc.String().try();
    be.ctype(tty, cty).try();
    idsym ::= be.alloc.String().try();
    idsym.sym_member("id").try();
    value ::= be.alloc.String().try();
    value.fmt(
        "(({}){{ .{} = (uint64_t){} }})",
        cty.view(),
        idsym.view(),
        pt
    ).try();
    be.write_assign_ok(ret, value.view(), dst)
}

// Lowering `t.join()`.
// `pthread_join` on the handle's `id`, and the thread's answer read out
// of the pointer it returns — the copy the trampoline made. the type is
// The call site's: `Thread` carries no type across the boundary, so the
// payload is read at the type this call is expected at, and a join
// annotated with the wrong type is a wrong read, exactly as a cast is.
// Where nothing settles that type — neither the expectation the call
// was lowered under nor sema's memo of the node — the call is refused
// rather than read at a width nothing chose.
lower_join* = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    a    : Access,
    rty  : TyId,
    want : TyId,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    be.need_spawn();
    be.join_want(id, want, ctx).try().match({
        None   => be.unsupported(
            id,
            "a `join` whose result type nothing settles",
            out
        ),
        Ok(wt) => be.join_settled(a, rty, wt, ctx, out),
    })
}

// The threaded expectation first, sema's memo of the call node second:
// `r: Res<u64, ThreadError> = t.join()` arrives as the former,
// `t.join().match(..)` may only leave the latter.
join_want = (be :: CBackend, id: ExprId, want: TyId, ctx: Ctx)
            Res<Res<TyId>, AllocError> {
    be.join_res_ok(want).match({
        true  => Ok(Ok(want)),
        false => be.join_memo(id, ctx),
    })
}

join_memo = (be :: CBackend, id: ExprId, ctx: Ctx)
            Res<Res<TyId>, AllocError> {
    memo = be.want_of(id, ctx).try();
    be.join_res_ok(memo).match({
        true  => Ok(Ok(memo)),
        false => Ok(None),
    })
}

join_res_ok = (be :: CBackend, t: TyId) bool {
    be.check.types.at(t).match({
        Res(r) => settled(be, r.value) && settled(be, r.error),
        _      => false,
    })
}

join_settled = (
    be   :: CBackend,
    a    : Access,
    rty  : TyId,
    want : TyId,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    be.request_type(want).try();
    recv ::= be.alloc.String().try();
    expr(be, a.base, ctx, rty, recv).try();
    dst = be.temp(want, "t").try();
    jp ::= be.alloc.String().try();
    sym_gen(jp, "j", be.next_tmp()).try();
    be.fmt("void *{};\n", jp.view()).try();
    idsym ::= be.alloc.String().try();
    idsym.sym_member("id").try();
    be.fmt(
        "if (pthread_join((pthread_t)({}.{}), &{}) != 0 || {} == 0) {{\n",
        recv.view(),
        idsym.view(),
        jp.view(),
        jp.view()
    ).try();
    be.indent();
    be.write_assign_err(want, "Panicked", dst.view()).try();
    be.dedent();
    be.writeln("} else {").try();
    be.indent();
    wct ::= be.alloc.String().try();
    be.ctype(want, wct).try();
    be.fmt("{} = *({} *){};\n", dst.view(), wct.view(), jp.view()).try();
    be.fmt("free({});\n", jp.view()).try();
    be.dedent();
    be.writeln("}").try();
    out.add(dst.view())
}
