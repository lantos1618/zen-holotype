Builder, BuildError, Dep = std.build

build = (b :: Builder) Res<(), BuildError> {
    native  = b.c_import("sys.demo", {
        headers: ["demo.h"],
        include_paths: [],
        defines: ["DEMO=1"],
        libraries: ["demo"],
        target: b.target(),
    }).try();
    support = b.lib("support", {
        src: Path("src/support.zen"),
        libs: [],
        paths: [],
    }).try();
    shim    = b.extern("shim", {
        src: Path(b.alloc, "src/shim.c").try(),
        libs: [],
        paths: [],
    }).try();
    deps ::= b.alloc.Vec<Dep>();
    deps.add(native).try();
    deps.add(support).try();
    deps.add(shim).try();
    b.exe("app", {
        src: Path("src/main.zen"),
        deps: deps,
    }).try();
    Ok(())
}
