// An undefined name inside a union alias was swallowed whole (#780):
// `EE = AllocError | NoSuchErrorTypeAnywhere` parses as an enum, nothing
// resolves its bare members as written types, and the alias quietly
// became the union of the members that did resolve -- compiling clean
// here while the identical name in a signature position draws
// `undefined name`. The dropped member resurfaced elsewhere as a wrong
// "no implicit error conversion" naming a member visible on the line.
//
// Now the declaration's own walk reports it, at the member's position,
// in the same voice as every other undefined name.
//
// position: the misspelled member, not the alias or a use site.

EE = AllocError | NoSuchErrorTypeAnywhere

boom = () Res<i32, EE> { Ok(1) }

main = (env: Env) Res<i32, EE> {
    println("{}", boom().try());
    Ok(0)
}