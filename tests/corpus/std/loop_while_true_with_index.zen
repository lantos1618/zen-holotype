// tests/corpus/std/loop_while_true_with_index.zen
// same loop, one more parameter: the compiler picks the variant by
// the body's signature, the ordinary overload rule. the counter
// starts at 0 and threads by value

main = (env: Env) Res<i32, AllocError> {
    loop((h, index) {
        println("index {}", index);
        (index == 2).then(() { h.break() });
    })
    println("after");
    Ok(0);
}
