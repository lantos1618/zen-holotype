// the second way out: returning it. `here`'s block is gone by the
// time the caller has the value, so every defer registered on it
// would run against a dead frame.

here = () Scope {
    @scope
}

main = (env: Env) Res<i32, IoError> {
    s = here();
    s.defer(() { println("goodbye") });
    Ok(0);
}
