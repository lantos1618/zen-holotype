// A STRUCT COPIED THROUGH ASSIGNMENT IS AN INDEPENDENT VALUE, AND THE
// COPY'S FIELDS ARE THE ORIGINAL'S FIELDS -- BYTE FOR BYTE, NOT ZERO.
//
// `g = consume f` moves; a plain `g = f` on a non-Drop type is a COPY
// (own/mutable_field_takes_mutable_method.zen and the ownership chapter
// price the difference). What this file pins is the copy's CONTENT:
// every field carried over, in order, including one whose value is the
// struct's own default. The plausible failure is a copy that carries the
// declaration instead of the storage -- copying from the type's default
// initialiser rather than the source value -- which prints defaults for
// every field of g while f still reads correctly. Both lines must print
// the SAME three numbers.
//
// The rewrite after the copy proves independence: writing through g
// must not move f, and vice versa. A shared representation prints 9
// where 3 belongs.

Cell = {
    v :: i64 = 30,
    w :: i64 = 20,
    name :: str = "cell",
}

main = (env: Env) Res<i32, AllocError> {
    f = Cell(v: 1, w: 2, name: "live");
    g = f;
    println("f {} {} {}", f.v, f.w, f.name);
    println("g {} {} {}", g.v, g.w, g.name);

    g ::= Cell();
    println("bare {} {} {}", g.v, g.w, g.name);

    h ::= Cell();
    h.w = 99;
    println("independent {} {}", h.w, g.w);
    Ok(0);
}
