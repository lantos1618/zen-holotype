halloc = std.mem.heap
maps = std.collections.map
{ expect } = std.core.result
{ println } = std.text.fmt
main = () i32 {
    alloc = halloc.gpa()
    a = alloc.addr()
    e1 ::= maps.of(a, "x", 2).expect("of")
    e1 = e1.put(a, "y", 3).expect("put")
    snap = e1.clone(a).expect("clone")
    e1 = e1.put(a, "x", 99).expect("put")
    e1 = e1.put(a, "z", 5).expect("put")
    println(snap.get("x", 0 - 1))
    println(snap.get("y", 0 - 1))
    println(snap.get("z", 0 - 1))
    println(snap.len())
    println(e1.get("x", 0 - 1))
    println(e1.get("z", 0 - 1))
    snap.free(a)
    e1.free(a)
    0
}
