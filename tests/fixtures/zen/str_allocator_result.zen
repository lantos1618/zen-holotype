halloc = std.mem.heap
{ dup_bytes, dup_bytes_in, substr, substr_in } = std.text.str
{ expect } = std.core.result
{ println } = std.text.fmt
main = () i32 {
    a = halloc.gpa()
    plain = a.addr().dup_bytes("xy").expect("dup_bytes")
    println(plain.len)
    owned = a.addr().dup_bytes_in("abc").expect("dup_bytes_in")
    println(owned.len)
    println(owned[0])
    println(a.addr().substr("hello", 1, 3).expect("substr"))
    println(a.addr().substr_in("hello", 1, 3).expect("substr_in"))
    a.addr().dup_bytes("").match ({
        .Ok(bytes) => println(bytes.len),
        .Err(e)    => println(99),
    })
    a.addr().dup_bytes_in("").match ({
        .Ok(bytes) => println(bytes.len),
        .Err(e)    => println(99),
    })
    a.addr().substr("world", 1, 2).match ({
        .Ok(s)  => println(s),
        .Err(e) => println("err"),
    })
    a.addr().substr_in("world", 1, 2).match ({
        .Ok(s)  => println(s),
        .Err(e) => println("err"),
    })
    0
}
