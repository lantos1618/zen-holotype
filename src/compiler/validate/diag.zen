{ ArmData, Expr, FieldInit, MemberData, Stmt, Ty } = compiler.ast.ast_types
{ Env, arm_env, extend_env, is_loop_handle_ty, is_loop_verb, loop_env } = compiler.check
{ Allocator } = std.mem.alloc
{ at, is_alnum } = std.text.ascii
{ advance_while, loop_at } = std.core.count
{ Opt } = std.core.result
{ is_empty } = std.text.str
{ CondQuery, EnvQuery, SourceSpan, expr_pos, pos_or } = compiler.validate.util    // trait imports: enable UFCS `env.var_err()`/`d.cond_onearm_err()` via the impl index
{ check_diagnostic_from_source, check_to_diagnostic } = compiler.validate.core
// Loop bodies are intentionally not fully type-checked before generic specialization. This walk reports
// undefined bare `Var` references and the context-independent one-arm bool-match error. It deliberately
// does NOT run fit / arg-type / operand checks, nor
// resolve call NAMES or struct FIELDS: a generic template's loop body legitimately calls methods on an
// unbound type param (`actor.receive`) and narrows str↔text, both valid pre-mono yet unresolvable here —
// flagging them would false-reject real stdlib. It still RECURSES through every sub-expression (and
// nested match-arm / loop / let binding envs) so a bare undefined name at any depth is caught.
NameErrors*: {
    count: i32,
    first_pos: i32,
    first_kind: i32,
}
name_errors_none = () NameErrors {
    NameErrors(
        count: 0,
        first_pos: 0,
        first_kind: 0,
    )
}
name_errors_merge = (l: NameErrors, r: NameErrors) NameErrors {
    NameErrors(
        count: l.count + r.count,
        first_pos: (l.first_pos > 0).then({ l.first_pos }, { r.first_pos }),
        first_kind: (l.first_pos > 0).then({ l.first_kind }, { r.first_kind }),
    )
}
name_error = (env: Env, name: StringView, pos: i32) NameErrors {
    (pos > 0).match ({
        true  => {
            n = env.var_err(name)
            NameErrors(
                count: n,
                first_pos: (n == 0).then({ 0 }, { pos }),
                first_kind: (n == 0).then({ 0 }, { diagnostic_code(.Undefined) }),
            )
        },
        false => name_errors_none(),
    })
}
// Field names are otherwise deferred here (a generic body legitimately reaches fields of an unbound
// type param). A LOOP HANDLE is the exception, and structurally so: `h`'s binder is the `.Loop` itself,
// which loop_env gives the reserved handle type, so the receiver is known even pre-mono. Only the two
// verbs lower — `h.anything_else` used to pass `check` and surface as a raw cc "undeclared identifier".
loop_verb_error = (env: Env, m: MemberData) NameErrors {
    p = m.pos.pos_or(load(m.obj).expr_pos())
    (p > 0 && env.infer_expr(m.obj).is_loop_handle_ty() && m.field.is_loop_verb() == false).match ({
        true  => NameErrors(
            count: 1,
            first_pos: p,
            first_kind: diagnostic_code(.StructField),
        ),
        false => name_errors_none(),
    })
}
name_errors_onearm = (d: CondData) NameErrors {
    n = d.cond_onearm_err()
    p = load(d.c).expr_pos()
    NameErrors(
        count: n,
        first_pos: (n == 0).then({ 0 }, { p }),
        first_kind: (n == 0).then({ 0 }, { diagnostic_code(.BooleanArm) }),
    )
}
name_errors_args = (env: Env, args: MutSlice<Expr>) NameErrors {
    acc ::= name_errors_none()
    args.loop_at((i, ar) { acc = acc.name_errors_merge(env.name_errors_expr(ar.addr())) })
    acc
}
name_errors_inits = (env: Env, inits: MutSlice<FieldInit>) NameErrors {
    acc ::= name_errors_none()
    inits.loop_at((i, fi) { acc = acc.name_errors_merge(env.name_errors_expr(fi.value)) })
    acc
}
name_errors_arms = (env: Env, subjty: Ty, arms: MutSlice<ArmData>) NameErrors {
    acc ::= name_errors_none()
    arms.loop_at((i, ar) {
        acc = acc.name_errors_merge(env.a.arm_env(env, subjty, ar).name_errors_expr(ar.body))
    })
    acc
}
name_errors_expr* = (env: Env, e: Ptr<Expr>) NameErrors {
    load(e).match ({
        // only USER-authored names (pos > 0) are name-checked. Inliner-substituted refs (loop bindings,
        // spliced lets, param→arg) are rebuilt as position-less `vref`s whose binding structure the
        // validator's env doesn't perfectly reconstruct — re-checking them as "undefined" false-rejects.
        .Var(v)         => env.name_error(v.name, v.pos),
        .Call(c)        => (c.fn == "sizeof").match ({
            true  => name_errors_none(),
            false => env.name_errors_args(c.args),
        }),    // sizeof's arg is a TYPE name, not a value (mirrors check_expr)
        .SliceLit(sd)   => env.name_errors_args(sd.items),
        .Index(ix)      => env
            .name_errors_expr(ix.seq)
            .name_errors_merge(env.name_errors_expr(ix.idx)),
        .Bin(b)         => env
            .name_errors_expr(b.lhs)
            .name_errors_merge(env.name_errors_expr(b.rhs)),
        .Cond(d)        => env
            .name_errors_expr(d.c)
            .name_errors_merge(env.name_errors_expr(d.t))
            .name_errors_merge(env.name_errors_expr(d.e))
            .name_errors_merge(d.name_errors_onearm()),
        .Member(m)      => env.name_errors_expr(m.obj).name_errors_merge(env.loop_verb_error(m)),
        .Match(m)       => {
            subjty = env.infer_expr(m.subj)
            env.name_errors_expr(m.subj).name_errors_merge(env.name_errors_arms(subjty, m.arms))
        },
        .MakeEnum(mk)   => env.name_errors_expr(mk.payload),
        .MakeStruct(sd) => env.name_errors_inits(sd.inits),
        .Block(b)       => env.a.name_errors_body(env, b.stmts),
        .Loop(l)        => env
            .name_errors_expr(l.seq)
            .name_errors_merge(env.a.name_errors_body(env.a.loop_env(env, l), l.body)),
        _               => name_errors_none(),
    })
}
name_errors_stmt = (a: Allocator, env: Env, st: Stmt) NameErrors {
    st.match ({
        .Let(l)      => env.name_errors_expr(l.value),
        .Assign(x)   => env
            .name_errors_expr(x.target)
            .name_errors_merge(env.name_errors_expr(x.value)),
        .Return(r)   => env.name_errors_expr(r),
        .ExprStmt(e) => env.name_errors_expr(e),
        .If(f)       => env
            .name_errors_expr(f.c)
            .name_errors_merge(a.name_errors_body(env, f.then))
            .name_errors_merge(a.name_errors_body(env, f.els)),
        .While(w)    => env.name_errors_expr(w.c).name_errors_merge(a.name_errors_body(env, w.body)),
        .IndexSet(x) => env
            .name_errors_expr(x.seq)
            .name_errors_merge(env.name_errors_expr(x.idx))
            .name_errors_merge(env.name_errors_expr(x.value)),
    })
}
name_errors_body* = (a: Allocator, env: Env, body: MutSlice<Stmt>) NameErrors {
    acc ::= name_errors_none()
    e ::= env
    body.loop_at((i, st) {
        acc = acc.name_errors_merge(a.name_errors_stmt(e, st))
        e = a.extend_env(e, st)
    })
    acc
}
DiagnosticKind*: Arity | ArgType | Undefined | StructField | Exhaustiveness | DuplicateVariant | Operand | Index | ReturnFit | AssignFit | Conformance | DuplicateFunction | ValuePositionReturn | Parse | Ownership | TraitBound | UnknownType | LambdaValue | MustUse | NeedAnnotation | PointerWrite | InfiniteType | NullDereference | NotCallable | Fallthrough | NoTypeArguments | OrReturn | RecursiveHigherOrder | VariantBreak | MainParameters | ArmVoid | BadBinding | Escape | ScratchSend | ScratchState | ReservedName | UnreachableArm | MethodNotFound | BooleanArm | NoIf | TypeArgumentArity | FfiType | Leak | MisorderedGeneric | LiteralExhaustiveness | MatchLabel | Capacity | ReflectReturn | ReflectWrite | NoTernary | DuplicateBooleanArm | DuplicateLiteralArm | Unclosed | ExpectedArrow | ExpectedExpression | ExpectedDeclaration | ExpectedInitializer | UnexpectedEof | AllocationNull | SliceWrite | NoCoroutine | ExpectedLetType | FieldDefault | ExpectedLetEquals | AssignConst | RetiredWalrus | SliceElement | RetiredBracketType | DuplicateMethod | InvalidLiteral
diagnostic_code* = (kind: DiagnosticKind) i32 {
    kind.match ({
        .Arity                 => 1,
        .ArgType               => 2,
        .Undefined             => 3,
        .StructField           => 4,
        .Exhaustiveness        => 5,
        .DuplicateVariant      => 6,
        .Operand               => 7,
        .Index                 => 8,
        .ReturnFit             => 9,
        .AssignFit             => 10,
        .Conformance           => 11,
        .DuplicateFunction     => 12,
        .ValuePositionReturn   => 13,
        .Parse                 => 14,
        .Ownership             => 15,
        .TraitBound            => 16,
        .UnknownType           => 17,
        .LambdaValue           => 18,
        .MustUse               => 19,
        .NeedAnnotation        => 20,
        .PointerWrite          => 21,
        .InfiniteType          => 22,
        .NullDereference       => 23,
        .NotCallable           => 24,
        .Fallthrough           => 25,
        .NoTypeArguments       => 26,
        .OrReturn              => 27,
        .RecursiveHigherOrder  => 28,
        .VariantBreak          => 29,
        .MainParameters        => 30,
        .ArmVoid               => 31,
        .BadBinding            => 32,
        .Escape                => 33,
        .ScratchSend           => 34,
        .ScratchState          => 35,
        .ReservedName          => 36,
        .UnreachableArm        => 37,
        .MethodNotFound        => 38,
        .BooleanArm            => 39,
        .NoIf                  => 40,
        .TypeArgumentArity     => 41,
        .FfiType               => 42,
        .Leak                  => 43,
        .MisorderedGeneric     => 44,
        .LiteralExhaustiveness => 45,
        .MatchLabel            => 46,
        .Capacity              => 47,
        .ReflectReturn         => 48,
        .ReflectWrite          => 49,
        .NoTernary             => 50,
        .DuplicateBooleanArm   => 51,
        .DuplicateLiteralArm   => 52,
        .Unclosed              => 53,
        .ExpectedArrow         => 54,
        .ExpectedExpression    => 55,
        .ExpectedDeclaration   => 56,
        .ExpectedInitializer   => 57,
        .UnexpectedEof         => 58,
        .AllocationNull        => 59,
        .SliceWrite            => 60,
        .NoCoroutine           => 61,
        .ExpectedLetType       => 62,
        .FieldDefault          => 63,
        .ExpectedLetEquals     => 64,
        .AssignConst           => 65,
        .RetiredWalrus         => 66,
        .SliceElement          => 67,
        .RetiredBracketType    => 68,
        .DuplicateMethod       => 69,
        .InvalidLiteral        => 70,
    })
}
diagnostic_kind_from_code* = (code: i32) Opt<DiagnosticKind> {
    (code == 1).then({
        return .Some(.Arity)
    })
    (code == 2).then({
        return .Some(.ArgType)
    })
    (code == 3).then({
        return .Some(.Undefined)
    })
    (code == 4).then({
        return .Some(.StructField)
    })
    (code == 5).then({
        return .Some(.Exhaustiveness)
    })
    (code == 6).then({
        return .Some(.DuplicateVariant)
    })
    (code == 7).then({
        return .Some(.Operand)
    })
    (code == 8).then({
        return .Some(.Index)
    })
    (code == 9).then({
        return .Some(.ReturnFit)
    })
    (code == 10).then({
        return .Some(.AssignFit)
    })
    (code == 11).then({
        return .Some(.Conformance)
    })
    (code == 12).then({
        return .Some(.DuplicateFunction)
    })
    (code == 13).then({
        return .Some(.ValuePositionReturn)
    })
    (code == 14).then({
        return .Some(.Parse)
    })
    (code == 15).then({
        return .Some(.Ownership)
    })
    (code == 16).then({
        return .Some(.TraitBound)
    })
    (code == 17).then({
        return .Some(.UnknownType)
    })
    (code == 18).then({
        return .Some(.LambdaValue)
    })
    (code == 19).then({
        return .Some(.MustUse)
    })
    (code == 20).then({
        return .Some(.NeedAnnotation)
    })
    (code == 21).then({
        return .Some(.PointerWrite)
    })
    (code == 22).then({
        return .Some(.InfiniteType)
    })
    (code == 23).then({
        return .Some(.NullDereference)
    })
    (code == 24).then({
        return .Some(.NotCallable)
    })
    (code == 25).then({
        return .Some(.Fallthrough)
    })
    (code == 26).then({
        return .Some(.NoTypeArguments)
    })
    (code == 27).then({
        return .Some(.OrReturn)
    })
    (code == 28).then({
        return .Some(.RecursiveHigherOrder)
    })
    (code == 29).then({
        return .Some(.VariantBreak)
    })
    (code == 30).then({
        return .Some(.MainParameters)
    })
    (code == 31).then({
        return .Some(.ArmVoid)
    })
    (code == 32).then({
        return .Some(.BadBinding)
    })
    (code == 33).then({
        return .Some(.Escape)
    })
    (code == 34).then({
        return .Some(.ScratchSend)
    })
    (code == 35).then({
        return .Some(.ScratchState)
    })
    (code == 36).then({
        return .Some(.ReservedName)
    })
    (code == 37).then({
        return .Some(.UnreachableArm)
    })
    (code == 38).then({
        return .Some(.MethodNotFound)
    })
    (code == 39).then({
        return .Some(.BooleanArm)
    })
    (code == 40).then({
        return .Some(.NoIf)
    })
    (code == 41).then({
        return .Some(.TypeArgumentArity)
    })
    (code == 42).then({
        return .Some(.FfiType)
    })
    (code == 43).then({
        return .Some(.Leak)
    })
    (code == 44).then({
        return .Some(.MisorderedGeneric)
    })
    (code == 45).then({
        return .Some(.LiteralExhaustiveness)
    })
    (code == 46).then({
        return .Some(.MatchLabel)
    })
    (code == 47).then({
        return .Some(.Capacity)
    })
    (code == 48).then({
        return .Some(.ReflectReturn)
    })
    (code == 49).then({
        return .Some(.ReflectWrite)
    })
    (code == 50).then({
        return .Some(.NoTernary)
    })
    (code == 51).then({
        return .Some(.DuplicateBooleanArm)
    })
    (code == 52).then({
        return .Some(.DuplicateLiteralArm)
    })
    (code == 53).then({
        return .Some(.Unclosed)
    })
    (code == 54).then({
        return .Some(.ExpectedArrow)
    })
    (code == 55).then({
        return .Some(.ExpectedExpression)
    })
    (code == 56).then({
        return .Some(.ExpectedDeclaration)
    })
    (code == 57).then({
        return .Some(.ExpectedInitializer)
    })
    (code == 58).then({
        return .Some(.UnexpectedEof)
    })
    (code == 59).then({
        return .Some(.AllocationNull)
    })
    (code == 60).then({
        return .Some(.SliceWrite)
    })
    (code == 61).then({
        return .Some(.NoCoroutine)
    })
    (code == 62).then({
        return .Some(.ExpectedLetType)
    })
    (code == 63).then({
        return .Some(.FieldDefault)
    })
    (code == 64).then({
        return .Some(.ExpectedLetEquals)
    })
    (code == 65).then({
        return .Some(.AssignConst)
    })
    (code == 66).then({
        return .Some(.RetiredWalrus)
    })
    (code == 67).then({
        return .Some(.SliceElement)
    })
    (code == 68).then({
        return .Some(.RetiredBracketType)
    })
    (code == 69).then({
        return .Some(.DuplicateMethod)
    })
    (code == 70).then({
        return .Some(.InvalidLiteral)
    })
    .None
}
// ── the PARSE-ERROR TAXONOMY (compiler.parse_type's PE_* kinds) ─────────────────────────────────
// One `error[parse]` sentence for every syntax mistake told the user WHERE but never WHAT. These
// codes carry what the parser EXPECTED at that token. The kind LABEL stays `parse` — the class is
// the label and the expectation is the message, the same split the checker uses for `arg-type`
// (`expected `str`, got `[i32]``). Each is planted by a distinct parser sentinel (parse.sentinel_name).
// ── const-by-default ────────────────────────────────────────────────────────────────────────────
Diagnostic*: {
    code: i32,
    kind: StringView,
    span: SourceSpan,
    count: i32,
    message: StringView,
    hint: StringView,
}
CheckDiagnostic*: {
    code: i32,
    kind: StringView,
    source_offset: i32,
    span_width: i32,
    count: i32,
    message: StringView,
    hint: StringView,
}
diagnostic_width_from = (src: StringView, pos: i32, n: i32) i32 {
    n.advance_while((k) { src.at(pos + k).is_alnum() })
}    // iterative — a long identifier/number literal must not recurse per byte to size its caret
// a string literal carets across its quotes (`"hi"` -> `^~~~`), not just the opening `"`.
diagnostic_strlit_width = (src: StringView, pos: i32, n: i32) i32 {
    e = n.advance_while((k) {
        b = src.at(pos + k)    // scan to the closing `"` or the line end, whichever comes first
        b != 0 && b != '\n' && b != '"'
    })
    (src.at(pos + e) == '"').then({ e + 1 }, { e })
}    // iterative — a ~50KB string literal must not recurse per byte to size its caret
diagnostic_span_width* = (src: StringView, pos: i32) i32 {
    (pos < 0).match ({
        true  => 1,
        false => (src.at(pos) == '"').match ({
            true  => src.diagnostic_strlit_width(pos, 1),
            false => {
                n = src.diagnostic_width_from(pos, 0)
                (n < 1).then({ 1 }, { n })
            },
        }),
    })
}
// ── ONE diagnostic table ──────────────────────────────────────────────────────────────────────
// Every packed-channel diagnostic's (kind, message, hint) lives in a SINGLE `diag_info` ladder keyed
// by `code`; the three accessors below just project one field. This is the sole source of truth for
// the ladder-rendered kinds — no more three parallel 32-branch ladders drifting out of sync. (The
// custom channels — escape/scratch-escape/reserved-name, codes 33-36 — build their own
// struct and are deliberately NOT in this table; their messages interpolate a runtime subject.)
DiagInfo: {
    kind: StringView,
    message: StringView,
    hint: StringView,
}
diag_info = (kind: DiagnosticKind) DiagInfo {
    code = diagnostic_code(kind)
    (code == 1).then({
        return DiagInfo(
            kind: "arity",
            message: "wrong number of arguments",
            hint: "check the callee signature and pass exactly the declared parameters",
        )
    })
    (code == 2).then({
        return DiagInfo(
            kind: "arg-type",
            message: "argument type does not fit the parameter",
            hint: "check the argument type or add an explicit conversion at the call site",
        )
    })
    (code == 3).then({
        return DiagInfo(
            kind: "undefined-name",
            message: "undefined name",
            hint: "declare the name, import it, or qualify the intended module binding",
        )
    })
    (code == 4).then({
        return DiagInfo(
            kind: "struct-field",
            message: "unknown struct field or invalid field access",
            hint: "check the struct literal or field access against the declared fields",
        )
    })
    (code == 5).then({
        return DiagInfo(
            kind: "exhaustiveness",
            message: "match does not cover every variant",
            hint: "add arms for every variant, or add an explicit `_` arm",
        )
    })
    (code == 6).then({
        return DiagInfo(
            kind: "dup-variant",
            message: "duplicate match arm variant",
            hint: "remove the repeated match arm for this variant",
        )
    })
    (code == 7).then({
        return DiagInfo(
            kind: "operand-type",
            message: "operator cannot be applied to these operand types",
            hint: "use an operator supported by both operand types",
        )
    })
    (code == 8).then({
        return DiagInfo(
            kind: "index",
            message: "invalid index operation",
            hint: "index only slice-like values with an integer index",
        )
    })
    (code == 9).then({
        return DiagInfo(
            kind: "return-fit",
            message: "returned value does not fit the declared return type",
            hint: "make the returned value fit the function's declared return type",
        )
    })
    (code == 10).then({
        return DiagInfo(
            kind: "assign-fit",
            message: "assigned value does not fit the variable's type",
            hint: "make the assigned value fit the target's type",
        )
    })
    (code == 11).then({
        return DiagInfo(
            kind: "conformance",
            message: "impl does not satisfy the trait",
            hint: "define every required trait method with the exact receiver, parameter, and return types",
        )
    })
    (code == 12).then({
        return DiagInfo(
            kind: "dup-fn",
            message: "duplicate top-level definition",
            hint: "rename one definition or move it behind a real module namespace",
        )
    })
    (code == 13).then({
        return DiagInfo(
            kind: "value-pos-return",
            message: "early `return` in a value-position match arm",
            hint: "return a value from the arm instead of using early `return` in value position",
        )
    })
    (code == 14).then({
        return DiagInfo(
            kind: "parse",
            message: "syntax error: unparseable top-level input",
            hint: "check the syntax around this top-level declaration",
        )
    })
    (code == 15).then({
        return DiagInfo(
            kind: "ownership",
            message: "use of an owner after it was consumed (moved, released, or dropped)",
            hint: "an owner is consumed by release/drop, an actor send, a move into an owner-typed parameter, or a bare `c = o` copy; bind a fresh owner (`o.clone()`) instead of reusing the consumed local",
        )
    })
    (code == 16).then({
        return DiagInfo(
            kind: "trait-bound",
            message: "type argument does not satisfy the trait bound",
            hint: "implement the bound trait for this type (`Type.impl(Trait, { … })`), or relax the bound",
        )
    })
    (code == 17).then({
        return DiagInfo(
            kind: "unknown-type",
            message: "unknown type name",
            hint: "declare the type, import it, or qualify it with its module (e.g. `mod.Type`)",
        )
    })
    (code == 18).then({
        return DiagInfo(
            kind: "lambda-value",
            message: "a lambda can only be used directly as a call argument",
            hint: "pass the lambda directly to its consumer, or bind a named top-level function instead (no first-class lambda values yet)",
        )
    })
    (code == 19).then({
        return DiagInfo(
            kind: "must-use",
            message: "result of a self-mutating container method is discarded; the receiver is invalid after this call",
            hint: "rebind the returned container (e.g. `m = m.put(...)`); a value-mold method may realloc and returns the updated handle",
        )
    })
    (code == 20).then({
        return DiagInfo(
            kind: "need-annotation",
            message: "cannot infer the type parameter of this binding",
            hint: "annotate the binding so its type parameter is pinned, e.g. `m: Map<i32> = …`",
        )
    })
    (code == 21).then({
        return DiagInfo(
            kind: "ptr-write",
            message: "cannot write through a read-only `Ptr<T>`",
            hint: "give the pointer parameter/field the `MutPtr<T>` kind to permit writes through it",
        )
    })
    (code == 60).then({
        return DiagInfo(
            kind: "slice-write",
            message: "cannot write through a read-only `Slice<T>`",
            hint: "a `.view()` of ANY string is read-only — it borrows, and borrowed bytes may be in `.rodata`; if you own the block, say so with `s.own_ptr().own_window(n)`, otherwise copy into an allocator-owned buffer to get a writable `MutSlice<T>`",
        )
    })
    (code == 22).then({
        return DiagInfo(
            kind: "infinite-type",
            message: "type contains itself by value, so it has infinite size",
            hint: "break the cycle with indirection: store a `Ptr<T>` (or `Slice<T>` / `MutSlice<T>`) instead of the type by value",
        )
    })
    (code == 23).then({
        return DiagInfo(
            kind: "null-deref",
            message: "`RawPtr<T>` may be null; deref requires a null-check first",
            hint: "guard with `q = assert_nonnull(p)` (panics on null, yields `MutPtr<T>`) then deref `q`, or null-check before deref",
        )
    })
    (code == 59).then({
        return DiagInfo(
            kind: "alloc-null",
            message: "allocation result may be null; this dereferences it without checking",
            hint: "handle the failure as a value (`a.try_acquire(n).match({ .Ok(p) => …, .Err(e) => … })`, or `ok_ptr(p)`), test it (`p.is_null()`), or make the failure a loud panic with `assert_nonnull(…)`",
        )
    })
    (code == 24).then({
        return DiagInfo(
            kind: "not-callable",
            message: "value is not a function",
            hint: "call a function, or store a function value in this name before calling it",
        )
    })
    (code == 25).then({
        return DiagInfo(
            kind: "return-fit",
            message: "function body falls through with no value; add a trailing expression of the declared return type",
            hint: "",
        )
    })
    (code == 26).then({
        return DiagInfo(
            kind: "no-type-args",
            message: "this function takes no type arguments",
            hint: "remove the `<…>` type arguments, or call a generic function",
        )
    })
    (code == 27).then({
        return DiagInfo(
            kind: "or-return",
            message: "`.or_return()` requires the enclosing function to return a `Result` carrying the receiver's error type",
            hint: "declare the enclosing function's return type as `Result<_, E>` with the receiver's error type `E`; in a conditionally-evaluated position (`&&`/`||` rhs, branch value, while-loop condition) the receiver's WHOLE `Result<T, E>` must match — bind it on its own line first (`x = recv.or_return()`), or handle the `Result` with `.match`",
        )
    })
    (code == 28).then({
        return DiagInfo(
            kind: "recursive-hof",
            message: "recursive function that must inline per call site (function-typed parameter or struct reflection) — the recursive call has no emitted function to land on",
            hint: "rewrite the recursion as an iteration (`.loop`), or move the function-typed parameter / reflection use out of the recursive function",
        )
    })
    (code == 29).then({
        return DiagInfo(
            kind: "parse",
            message: "syntax error: a newline before `.Variant` starts a new statement",
            hint: "keep the qualified constructor's `.` on the same line as its type (`Type.Variant(…)`)",
        )
    })
    (code == 30).then({
        return DiagInfo(
            kind: "main-signature",
            message: "`main` must be `() i32` or `(sys: Sys) i32` — the process boundary is niladic and integer-returning",
            hint: "declare it `main = () i32 { … }`, or take the root capability `main = (sys: Sys) i32 { … }` (import `{ Sys } = std.sys.root`) and thread narrow caps like `sys.stdout()` / `sys.heap()`",
        )
    })
    (code == 31).then({
        return DiagInfo(
            kind: "arm-value",
            message: "match arm yields no value, but the match result is used as a value",
            hint: "end every arm with an expression of the match's result type (or a diverging `return`); or stop consuming the match as a value and assign within each arm",
        )
    })
    (code == 32).then({
        return DiagInfo(
            kind: "bad-binding",
            message: "top-level `=` binding is neither a module alias nor a function",
            hint: "a value global is `k = 5` (constant) or `k ::= 5` (mutable); a single `=` at top level is otherwise only a module alias (`m = std.mod`) or a function (`f = () T { … }`)",
        )
    })
    (code == 38).then({
        return DiagInfo(
            kind: "method-not-found",
            message: "no method with this name on the receiver type",
            hint: "define the method (a top-level `fn` whose first parameter is the receiver, called `recv.method(...)`), or check the method name",
        )
    })
    (code == 39).then({
        return DiagInfo(
            kind: "exhaustiveness",
            message: "boolean match does not handle both outcomes",
            hint: "add the missing `true`, `false`, or `_` arm; for an intentional one-way effect, use `condition.then({ ... })`",
        )
    })
    (code == 37).then({
        return DiagInfo(
            kind: "unreachable-arm",
            message: "match arm after a wildcard `_` arm can never fire",
            hint: "move the arm before the `_` arm, or remove it — arms are tried in order and `_` matches everything",
        )
    })
    (code == 41).then({
        return DiagInfo(
            kind: "targ-arity",
            message: "wrong number of explicit type arguments",
            hint: "pass exactly one type argument per declared type parameter, or omit the `<…>` list to infer them",
        )
    })
    (code == 42).then({
        return DiagInfo(
            kind: "ffi-type",
            message: "foreign declaration uses a type with no C ABI shape",
            hint: "a bodyless (foreign) declaration is a raw C prototype; use fixed-width integers, f32/f64, bool, StringView (const char*), RawPtr<T>/Ptr<T>/MutPtr<T>, non-capturing fn pointers, or structs of those — pass buffers through the RawPtr<T> floor (pointer + length)",
        )
    })
    (code == 44).then({
        return DiagInfo(
            kind: "parse",
            message: "generic type parameters must come before the `*` export marker",
            hint: "write the type parameters after the name's `*`: `Box*<T>:` (e.g. `Result*<T, E>:`)",
        )
    })
    (code == 45).then({
        return DiagInfo(
            kind: "exhaustiveness",
            message: "match does not cover every case; add a `_` arm",
            hint: "a scalar `.match` over literal labels must end with a `_` arm — its value domain is unbounded, so no finite set of literal labels is exhaustive",
        )
    })
    (code == 46).then({
        return DiagInfo(
            kind: "match-label",
            message: "match arm label is not a `bool`; a boolean `.match` takes `true`, `false`, or `_`",
            hint: "replace the label with `true`, `false`, or a `_` wildcard",
        )
    })
    (code == 51).then({
        return DiagInfo(
            kind: "match-arm",
            message: "boolean `.match` repeats an arm label; it must cover `true` and `false` exactly once",
            hint: "give one `true` arm and one `false` arm (either order), or a single bool arm plus a `_` wildcard",
        )
    })
    (code == 52).then({
        return DiagInfo(
            kind: "match-arm",
            message: "literal `.match` repeats an arm label; the later arm can never fire",
            hint: "each literal label must be distinct — arms are tried in order, so a repeated label is dead; remove or renumber it",
        )
    })
    // ── the parse taxonomy: kind stays `parse`, the message names what was EXPECTED ──
    (code == 53).then({
        return DiagInfo(
            kind: "parse",
            message: "unclosed `{`: expected a matching `}`, found end of input",
            hint: "close the block that opens on this line with a `}`",
        )
    })
    (code == 54).then({
        return DiagInfo(
            kind: "parse",
            message: "expected `=>` after this match-arm label",
            hint: "a match arm is `label => value`; separate the label from its body with `=>`",
        )
    })
    (code == 55).then({
        return DiagInfo(
            kind: "parse",
            message: "expected an expression, found a token that cannot start one",
            hint: "an expression starts with a literal, a name, a `.Variant`, a `(group)`, a `[a, b]` slice literal, or a `-`/`!` prefix",
        )
    })
    (code == 56).then({
        return DiagInfo(
            kind: "parse",
            message: "expected a top-level declaration, found a token that cannot start one",
            hint: "a top-level item is `name = (params) Ret { … }`, `name ::= value`, `Name: { … }`, `Name.impl(Trait, { … })`, or `{ names } = module.path`",
        )
    })
    (code == 57).then({
        return DiagInfo(
            kind: "parse",
            message: "expected an expression after the binding mark, found the end of the binding",
            hint: "give the binding a value (`name = <expr>`), or delete the binding",
        )
    })
    (code == 58).then({
        return DiagInfo(
            kind: "parse",
            message: "unexpected end of input while parsing an expression",
            hint: "the file ends mid-expression — finish it, or close the delimiter it left open",
        )
    })
    (code == 62).then({
        return DiagInfo(
            kind: "parse",
            message: "expected a type after this binding's `:`/`::` mark, found a token that cannot start one",
            hint: "a local binding is `x = v` (constant), `x: T = v`, `x ::= v` (mutable), or `x :: T = v`",
        )
    })
    (code == 63).then({
        return DiagInfo(
            kind: "field-default",
            message: "a struct field default must be a constant (an integer, float, string, or char literal, `true`, or `false`)",
            hint: "a default is re-evaluated at every construction, so a call or an allocation here would be a hidden per-value effect; use a constant, or set the field explicitly at the construction site",
        )
    })
    (code == 64).then({
        return DiagInfo(
            kind: "parse",
            message: "expected `=` after this binding's type annotation",
            hint: "`=` binds the value: `x: T = v` for a constant, `x :: T = v` for a mutable binding",
        )
    })
    (code == 65).then({
        return DiagInfo(
            kind: "assign-const",
            message: "assignment to a constant binding; a binding declared without the `::` mutability mark is bound once",
            hint: "mark the declaration mutable — write `x ::= 0` (or `x :: T = 0`) — or bind a new name instead of assigning",
        )
    })
    (code == 66).then({
        return DiagInfo(
            kind: "parse",
            message: "`:=` is retired",
            hint: "write `x = v` for a constant binding or `x ::= v` for a mutable one; annotated, `x: T = v` and `x :: T = v`",
        )
    })
    (code == 67).then({
        return DiagInfo(
            kind: "slice-elem",
            message: "slice element type does not match the memory this pointer came from (the element WIDTH is unchecked: a wider element reads past the end of the allocation)",
            hint: "declare the same element type the storage holds, or take the window from the value itself (`xs.view()`/`xs`) instead of re-widening its `.ptr`",
        )
    })
    (code == 68).then({
        return DiagInfo(
            kind: "parse",
            message: "bracket syntax is not allowed in a type",
            hint: "write `Slice<T>` for a read-only window, `MutSlice<T>` for a writable window, or `Vec<T>` for owned growable storage",
        )
    })
    (code == 70).then({
        return DiagInfo(
            kind: "parse",
            message: "invalid byte character literal or malformed `\\xNN` escape",
            hint: "write exactly one byte (`'A'`, `'\\n'`, or `'\\x41'`); use a string for multibyte UTF-8 text",
        )
    })
    (code == 47).then({
        return DiagInfo(
            kind: "capacity",
            message: "program exceeds a fixed compiler capacity (top-level declarations, exports, module aliases, or module-signature entries)",
            hint: "this is a compiler limit, not a program error — split the module or report it; the registry sizes live in compiler/parse.zen",
        )
    })
    (code == 48).then({
        return DiagInfo(
            kind: "reflect-return",
            message: "early `return` inside a loop in a generic that uses struct reflection — the body is inlined per call site, so the loop's return would escape into the caller",
            hint: "accumulate into a flag/value and return after the loop, or lift the return to statement level",
        )
    })
    (code == 49).then({
        return DiagInfo(
            kind: "reflect-write",
            message: "assignment through a bound reflection subject — this subject is not a plain local variable, so it is evaluated once into a hidden temp and the lambda's writes would land on that discarded temp (a silent no-op)",
            hint: "bind the subject to a local first and assign the struct back whole: `leaf = fv` … `leaf.each_field((n, f2) { f2 = … })` … `fv = leaf` — a plain local subject is spliced unbound, so its field writes stick",
        )
    })
    DiagInfo(
        kind: "type",
        message: "type error",
        hint: "",
    )
}
diag_info_from_code = (code: i32) DiagInfo {
    code.diagnostic_kind_from_code().match ({
        .Some(kind) => kind.diag_info(),
        .None       => DiagInfo(
            kind: "type",
            message: "type error",
            hint: "",
        ),
    })
}
diagnostic_kind_name* = (code: i32) StringView { code.diag_info_from_code().kind }
diagnostic_message* = (code: i32) StringView { code.diag_info_from_code().message }
diagnostic_hint* = (code: i32) StringView { code.diag_info_from_code().hint }
diagnostic_from_source* = (src: StringView, packed: i32, count: i32) Diagnostic {
    src.check_diagnostic_from_source(packed, count).check_to_diagnostic()
}
desc_or* = (x: StringView, y: StringView) StringView { is_empty(x).then({ y }, { x }) }
// ── M5: explicit type-argument (turbofish) + closure-argument validation over RAW decls ──────────────
// Local generic calls are INLINED during resolve_module, which ERASES the call site's explicit `<…>`
// type args and its lambda arguments before check_module ever sees them. So an undefined turbofish type
// (`sz<NoExist>()`), a turbofish on a non-generic callee (`plain<i64>(5)`), a type-arg that contradicts
// the value args (`id<str>(5)`), and a wrong-arity / wrong-typed closure passed to a HOF
// (`xs.fold(0, (x){…})`) all slipped through SEMA and leaked to cc as raw C / linker errors. This pass
// runs (driver-only) on the DESUGARED (method-calls flattened to plain Calls) but PRE-INLINE decls,
// where every call still carries its `targs` and lambda args. It threads the enclosing function's
// tparams so a turbofish that names an IN-SCOPE tparam (`sz<T>()` inside `g<T>`) is not a false
// unknown-type, and reports only these argument kinds (no other validator judgment), so an
// unresolved generic body never false-positives.
// ── recursive HOF: a self-recursive fn with an FnT param ─────────────────────────────────────────
// A bodied fn with an FnT param is a TEMPLATE (genc.is_generic_fn): it is inlined at each call site
// and NEVER emitted as a standalone C function. The inliner unrolls a bounded number of self-call
// levels, so the residual self-call survives in the emitted C as a call to a symbol that has no
// definition — an "undefined reference" at LINK time, misreported as an internal compiler bug (and
// shallow recursion only "works" when cc constant-folds the dead residual call). Until such fns are
// monomorphized per FnT arg, reject them with a positioned error. Lenient guard: a PARAM named after
// the fn itself shadows it (see shadows_toplevel), so its calls are indirect, not recursion.
// ── or_return CONTEXT validation over RAW decls (driver-only) ────────────────────────────────────
// `.or_return()` lowers to `if Err → return <receiver>` from the ENCLOSING function, so it is only
// meaningful inside a function whose return type is a Result carrying the SAME error type E as the
// receiver's (v1: exact E, no From/Into conversion — bridge the error explicitly before propagating).
// or_return is lowered away during resolve_module, so check_module never sees it; this pass runs on
// the RAW (pre-resolve, still-MethodCall) FLATTENED decls, where every call site is intact. It is
// deliberately LENIENT where raw inference is weak: a receiver whose type (or Err payload) cannot be
// inferred here is skipped — reject only what is PROVABLY wrong, never over-reject.
// ── reserved-name: a top-level fn redefining a compiler intrinsic (KRESERVEDNAME) ──────────────────
// Call emission dispatches on the NAME (genc call_kind / is_intrinsic), so a user top-level
// `load = (x: i64) i64 { … }` never receives its calls: `load(41)` still compiles to the intrinsic
// pointer deref — a miscompile behind a green check (a cc error at best, a wrong value or a
// segfault at runtime at worst). Locals and params that shadow intrinsics are already sound
// (shadows_toplevel routes their calls through the local, #370/#377), struct/impl methods are
// hoisted under mangled `impl_…` names, and FOREIGN decls stay allowed (std.mem.alloc re-declares
// `malloc`/`free` as bodyless prototypes) — so the reject is scoped to BODIED top-level DFuncs,
// the one shape whose calls are unwinnably captured by the intrinsic.
// ── BATCH diagnostics (report ALL type errors, not just the first) ──────────────────────────────
// Append each unit's first error into a fixed-cap packed buffer, recovering at natural boundaries — one error per
// top-level statement inside a function, then per decl across the module. The inner recursion is
// unchanged (still first-error within a statement / expression), so a single root cause never
// cascades: after a statement errs we resume at the next statement, after a decl at the next decl.
// Consumers unpack each entry with the same `& 127` / `(>> 7) - 1` scheme (check_diagnostic_from_source).
KDIAG_CAP* = () i32 { 512 }
// Address-of-local escape uses a custom diagnostic channel with a hand-built message and hint.
// ════════════════════════════════════════════════════════════════════════════════════════
// ── UNDER-FREE (LEAK) CHECK — the DUAL of the over-free ownership pass ────────────────────
// The ownership pass above is over-free-SOUND: it catches double-free / use-after-consume. Its blind
// spot is UNDER-free: an owner CREATED here that is never released, moved, or returned just leaks —
// silently. This pass closes exactly that hole, and ONLY where it can PROVE a leak with ZERO false
// positives (over-rejection is the cardinal sin — a false leak on legit std code is worse than a miss).
//
// SCOPE reached (deliberately narrow, must-leak-only v1):
//   • Candidate = a TOP-LEVEL `let o = <v>` of a function body whose value's inferred type is an
//     owner (owner_base ∈ {Own,Rc,Arc}) AND whose value is a FRESH PRODUCTION — NOT a bare `.Var`/
//     `.Member`/`.Index` (those ALIAS/borrow an owner held elsewhere: the field/source still
//     owns it, so releasing through the alias would double-free — flagging them would be a false
//     positive). A Call/Match/Block/... value that yields a fresh owner is the creation site.
//   • A candidate LEAKS iff its name is NEVER read again anywhere in the function AFTER the binding.
//     ANY later occurrence of the name — as a release/drop receiver, a move into a consuming call, a
//     returned value (directly OR wrapped: `ok(o)`, `.Some(o)`, `Box(o: o)`), a send, a store through
//     an out-param, or even a plain read — DISCHARGES it (this pass under-reports). The read scan is
//     EXHAUSTIVE over every Expr/Stmt shape: missing an occurrence would be a false positive, so the
//     safe direction is to find EVERY mention. Because any escape/consume necessarily NAMES the owner,
//     "never named again" is a sound proof of leak with no escape-analysis blind spots.
//
// Known under-reports: owners bound inside a nested block/
// branch; owners whose only later use is a pure read (`o.get()`) with no free (leaks, but exempted
// here); leak-on-SOME-paths (freed on one branch, forgotten on another); and the ARENA caveat — an
// `Own<T>` from an arena/scratch allocator is freed wholesale at scope exit and needs no explicit
// release, yet is type-indistinguishable from a heap `Own`; if the whole-tree sweep shows such a
// binding is also never-named-again, the FRESH-PRODUCTION gate would still flag it, so this pass is
// only enabled once the sweep confirms none exists (see report). Rc/Arc share the same soundness (an
// undropped initial count leaks) and the same never-named-again proof.
// ── SPAWNER SCRATCH ACROSS AN ACTOR BOUNDARY ─────────────────────────────────────────────────────
// Memory that must not cross an actor boundary, crossing it — a cross-actor use-after-free: memory in
// the SPAWNER's scratch handed to an actor that outlives it. (The scoped-runtime design notes and the
// judge ruling that first named this hole are gone; docs/STATUS.md's scratch/shared row is the live
// ledger entry, and the user-facing remedy is `sx_hint` in validate/args.zen.) Two rules, enforced lexically +
// name-based over the RAW pre-desugar decls (driver-only, the send-Rc pass's shape):
//   1. send-payload: the payload of an actor send (`send` / `pool_send`, last argument) must not
//      carry a SPAWNER-LOCAL allocation — a local bound to `<allocator>.acquire(…)` or arena
//      `make_in(…)`, a slice literal (a C compound literal: STACK storage), or `<local>.addr()` —
//      bare, or embedded directly in a struct-literal field / enum payload. The sender's scratch is
//      freed independently of the receiving actor → use-after-free.
//   2. actor-state: the same classification applied to `spawn`'s initial actor-state argument
//      (construct-under-actor until the real rt lands: actor state must not embed spawner scratch).
// DELIBERATELY LENIENT wherever classification is uncertain (fn returns, `.expect(…)`, member
// reads, params, arm binds, generic payloads): Arc/Rc-backed values arrive via
// `new_in(…).expect(…)`/`clone()` — call results, so they classify clean; plain values are clean;
// a rebind to anything clean REVIVES the name. Only the blatant textbook shapes reject.
// Arity guards keep unrelated `spawn`s out: std.thread's `spawn(fn, arg)` is a 2-arg Call and the
// coroutine `h.spawn(fn)` a 1-arg MethodCall — neither matches the 3-arg actor `spawn` surface.
