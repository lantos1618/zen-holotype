// importing std.build must compile. It rotted once invisibly: the
// self-build's walk never reaches std/std.zen, so Function and Module
// (src/ast.zen's nodes, which only @meta can hand over — stage 5)
// sat undefined in build.zen while every gate stayed green. The
// stand-ins are opaque on purpose; what this pins is that the api a
// build file is handed RESOLVES, walk or no walk.

Builder, Module, Function, Budget = std.build

main = (env: Env) Res<i32> {
    println("build api resolves");
    Ok(0);
}
