Link = {
    value: i64,
    next: Ptr<Link>,
}

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    cell = alloc.create<Link>().match({
        Ok(p)  => p,
        Err(_) => null_ptr<Link>(),
    });
    cell.write(0, Link(value: 9, next: null_ptr<Link>()));
    println("{}", cell.read(0).value);
    Ok(0);
}
