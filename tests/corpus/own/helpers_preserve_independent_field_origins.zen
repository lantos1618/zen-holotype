Input = { text: str, scratch: str }
Box = { text :: str }
put = (box :: Box, input: Input) () { box.text = input.text; }
forward = (box :: Box, input: Input) () { put(box, input); }
fill = (env: Env, box :: Box, text: str) Res<(), AllocError> {
    a         = env.mem.alloc();
    temporary = a.String("temporary").try();
    input     = Input(text: text, scratch: temporary.view());
    forward(box, input);
    println(box.text);
    forward(box, Input(text: text, scratch: temporary.view()));
    println(box.text);
    Ok(())
}
main = (env: Env) Res<(), AllocError> {
    box ::= Box(text: "");
    fill(env, box, "caller").try();
    println(box.text);
    Ok(())
}
