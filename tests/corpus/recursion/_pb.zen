// probeB: fib tree (two live call results per frame) + ackermann (nested call args)
fib = (n: i32) i32 {
    (n < 2).match({
        true  => n,
        false => fib(n - 1) + fib(n - 2),
    });
}

ack = (m: i32, n: i32) i32 {
    (m == 0).match({
        true  => n + 1,
        false => (n == 0).match({
            true  => ack(m - 1, 1),
            false => ack(m - 1, ack(m, n - 1)),
        }),
    });
}

main = (env: Env) Res<i32, AllocError> {
    println("fib {}", fib(24));
    println("ack {}", ack(3, 5));
    Ok(0);
}
