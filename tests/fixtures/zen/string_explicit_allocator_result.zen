halloc = std.mem.heap
{ String, new_in, init } = std.text.string
{ expect } = std.core.result
main = () i32 {
    m = halloc.gpa()
    s ::= m.addr().new_in().expect("new_in")
    s = s.append_in(m.addr(), "abc").expect("append_in")
    n = s.len
    s.free_in(m.addr())
    m.addr().init(2).match ({
        .Ok(t0) => t0.append_in(m.addr(), "hello").match ({
            .Ok(t)  => {
                tn = t.len
                t.free_in(m.addr())
                to_i32(n + tn)
            },
            .Err(e) => 90,
        }),
        .Err(e) => 91,
    })
}
