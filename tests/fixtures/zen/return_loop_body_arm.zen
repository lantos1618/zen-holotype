{ Result, IoError, err } = std.core.result
find_neg = (xs: [i32]) Result<i32, IoError> {
    found := 0 - 1
    xs.loop((h, i, x) {
        (x < 0).match ({ true => {
            found = i.to_i32()
        }, false => { } })
    })
    (found >= 0).match ({ true => { }, false => {
        return err(IoError.NotFound)
    } })
    .Ok(found)
}
main = () i32 {
    a := find_neg([3, 7, 0 - 2, 9]).match ({
        .Ok(i)  => i,
        .Err(e) => 100,
    })    // 2
    b := find_neg([1, 2, 3]).match ({
        .Ok(i)  => i,
        .Err(e) => 50,
    })    // 50
    a + b
}    // 52
