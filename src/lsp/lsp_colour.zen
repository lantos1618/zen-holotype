// LSP semantic tokens use UTF-16 lengths and positions relative to the
// preceding token. The order in `write_legend` must match `index_of`.

str, String = std.text
Vec, Ordered = std.collections
Alloc, AllocError = std.mem
Range = std.core
scan, Source, Token, TokenKind = std.lex
write_text, written, obj, arr, Nest = std.json
step_at, units_of = lsp.lsp_pos

Colour* = Keyword
    | Text
    | Number
    | Comment
    | Operator
    | Variable
    | Type
    | Function
    | Parameter

index_of* = (colour: Colour) usize {
    colour.match({
        Keyword   => 0,
        Text      => 1,
        Number    => 2,
        Comment   => 3,
        Operator  => 4,
        Variable  => 5,
        Type      => 6,
        Function  => 7,
        Parameter => 8,
    })
}

name_of* = (colour: Colour) str {
    colour.match({
        Keyword   => "keyword",
        Text      => "string",
        Number    => "number",
        Comment   => "comment",
        Operator  => "operator",
        Variable  => "variable",
        Type      => "type",
        Function  => "function",
        Parameter => "parameter",
    })
}

write_legend* = (out :: String) Res<(), AllocError> {
    legend ::= obj(out).try();
    legend.key("tokenTypes", out).try();
    types ::= arr(out).try();
    listed(Colour.Keyword, types, out).try();
    listed(Colour.Text, types, out).try();
    listed(Colour.Number, types, out).try();
    listed(Colour.Comment, types, out).try();
    listed(Colour.Operator, types, out).try();
    listed(Colour.Variable, types, out).try();
    listed(Colour.Type, types, out).try();
    listed(Colour.Function, types, out).try();
    listed(Colour.Parameter, types, out).try();
    types.close(out).try();
    legend.key("tokenModifiers", out).try();
    modifiers ::= arr(out).try();
    modifiers.close(out).try();
    legend.close(out)
}

listed = (colour: Colour, types :: Nest, out :: String)
         Res<(), AllocError> {
    types.next(out).try();
    write_text(name_of(colour), out)
}

colour_of* = (kind: TokenKind) Res<Colour> {
    kind.match({
        Ident        => Ok(Colour.Variable),
        Int(_)       => Ok(Colour.Number),
        Float        => Ok(Colour.Number),
        Str          => Ok(Colour.Text),
        Char         => Ok(Colour.Text),
        True         => Ok(Colour.Keyword),
        False        => Ok(Colour.Keyword),
        Consume      => Ok(Colour.Keyword),
        AtSelf       => Ok(Colour.Keyword),
        AtMeta       => Ok(Colour.Keyword),
        AtScope      => Ok(Colour.Keyword),
        LineComment  => Ok(Colour.Comment),
        BlockComment => Ok(Colour.Comment),
        ParenOpen    => None,
        ParenClose   => None,
        BracketOpen  => None,
        BracketClose => None,
        BraceOpen    => None,
        BraceClose   => None,
        Comma        => None,
        Semicolon    => None,
        Dot          => None,
        Ellipsis     => Ok(Colour.Operator),
        Colon        => None,
        ColonColon   => Ok(Colour.Operator),
        ColonColonEq => Ok(Colour.Operator),
        Eq           => Ok(Colour.Operator),
        EqEq         => Ok(Colour.Operator),
        Arrow        => Ok(Colour.Operator),
        Bang         => Ok(Colour.Operator),
        BangEq       => Ok(Colour.Operator),
        Lt           => Ok(Colour.Operator),
        LtEq         => Ok(Colour.Operator),
        Gt           => Ok(Colour.Operator),
        GtEq         => Ok(Colour.Operator),
        Amp          => Ok(Colour.Operator),
        AmpAmp       => Ok(Colour.Operator),
        Bar          => Ok(Colour.Operator),
        BarBar       => Ok(Colour.Operator),
        Plus         => Ok(Colour.Operator),
        PlusWrap     => Ok(Colour.Operator),
        Minus        => Ok(Colour.Operator),
        MinusWrap    => Ok(Colour.Operator),
        Star         => Ok(Colour.Operator),
        StarWrap     => Ok(Colour.Operator),
        Slash        => Ok(Colour.Operator),
        Percent      => Ok(Colour.Operator),
        Eof          => None,
    })
}

Painter = {
    line :: usize,
    character :: usize,

    source_at :: usize,
    source_units :: usize,

    put = (self :: @Self, line: usize, character: usize, length: usize,
           colour: Colour, runs :: Nest, out :: String) Res<(), AllocError> {
        runs.next(out).try();
        delta_line      = line - self.line;
        delta_character = (delta_line == 0).match({
            true  => character - self.character,
            false => character,
        });
        out.write_usize(delta_line).try();
        out.add(",").try();
        out.write_usize(delta_character).try();
        out.add(",").try();
        out.write_usize(length).try();
        out.add(",").try();
        out.write_usize(index_of(colour)).try();
        out.add(",0").try();
        self.line      = line;
        self.character = character;
        Ok(());
    }

    paint = (self :: @Self, text: str, token: Token, colour: Colour,
             runs :: Nest, out :: String) Res<(), AllocError> {
        stop = token.span.end.offset;
        from      ::= token.span.start.offset;
        line      ::= zero_based(token.span.start.line);
        character ::= self.character_at(text, from);
        loop(from < stop, (h) {
            upto = break_in(text, from, stop);
            self.run(text, line, character, from, upto, colour, runs, out)
                .try();
            from      = upto + 1;
            line      = line + 1;
            character = 0;
        });
        Ok(());
    }

    character_at = (self :: @Self, text: str, upto: usize) usize {
        loop(self.source_at < upto, (h) {
            (text.index(self.source_at) == '\n').match({
                true  => {
                    self.source_at    = self.source_at + 1;
                    self.source_units = 0;
                },
                false => {
                    step              = step_at(text, self.source_at);
                    self.source_at    = self.source_at + step.bytes;
                    self.source_units = self.source_units + step.units;
                },
            });
        });
        self.source_units
    }

    run = (self :: @Self, text: str, line: usize, character: usize,
           from: usize, upto: usize, colour: Colour, runs :: Nest,
           out :: String)
          Res<(), AllocError> {
        (upto > from).match({
            true  => self.put(
                line,
                character,
                units_of(text, from, upto),
                colour,
                runs,
                out
            ),
            false => written(),
        })
    }
}

break_in = (text: str, from: usize, stop: usize) usize {
    Range(from, stop).find((i) { text.index(i) == '\n' }).match({
        Ok(i) => i,
        None  => stop,
    })
}

Classed* = {
    line*: usize,
    col*: usize,
    colour*: Colour,
}

Classed.impl(Ordered, {
    before = (self: @Self, other: @Self) bool {
        self.line < other.line
            || (self.line == other.line && self.col < other.col)
    }
})

classed_at = (names: Vec<Classed>, line: usize, col: usize) Res<Classed> {
    lo ::= 0;
    hi ::= names.len;
    loop(lo < hi, (h) {
        mid = (lo + hi) / 2;
        names.get(mid).match({
            None   => (),
            Ok(cl) => before_start(cl, line, col).match({
                true  => { lo = mid + 1; },
                false => { hi = mid; },
            }),
        });
    });
    names.get(lo).match({
        None   => None,
        Ok(cl) => is_start(cl, line, col).match({
            true  => Ok(cl),
            false => None,
        }),
    })
}

before_start = (cl: Classed, line: usize, col: usize) bool {
    cl.line < line || (cl.line == line && cl.col < col)
}

is_start = (cl: Classed, line: usize, col: usize) bool {
    cl.line == line && cl.col == col
}

sort_classes* = (names :: Vec<Classed>) Res<(), AllocError> {
    names.sort()
}

write_tokens* = (
    a     : Alloc,
    name  : str,
    text  : str,
    names : Vec<Classed>,
    out   :: String
) Res<(), AllocError> {
    lexed = scan(a, Source(file: name, text: text)).try();
    painter ::= Painter(line: 0, character: 0, source_at: 0, source_units: 0);
    answer  ::= obj(out).try();
    answer.key("data", out).try();
    data ::= arr(out).try();
    lexed.tokens.loop((h, token) {
        colour_of(token.kind).match({
            None    => written(),
            Ok(one) => painter.paint(
                text,
                token,
                settled(token, one, names),
                data,
                out
            ),
        }).try();
    });
    data.close(out).try();
    answer.close(out)
}

settled = (token: Token, lexical: Colour, names: Vec<Classed>) Colour {
    token.kind.match({
        Ident => classed_at(
            names,
            token.span.start.line,
            token.span.start.col
        ).match({
            None    => lexical,
            Ok(one) => one.colour,
        }),
        _     => lexical,
    })
}

zero_based = (line: usize) usize {
    (line == 0).match({ true => 0, false => line - 1 })
}
