// Resolve declaration names and bind targets under a cursor, including
// by-value identifiers with no arena id.

str = std.text
Range = std.core
Pos, Span = std.ast.ast_span
ExprId, TypeId = std.ast.ast_id
Ast = std.ast.ast_arena
Decl, Function, Param, Member, Const, Bind, Stmt = std.ast.ast_node
Ident, Import = std.ast
node_at, in_span = std.ast.ast_find

TypeAt* = {
    span*: Span,
    id*: TypeId,
}

ValueAt* = {
    span*: Span,
    id*: ExprId,
}

// Import bindings resolve definitions but have no local type or expression.
Tell* = Nothing
    | Sig(Function)
    | OfType(TypeAt)
    | OfValue(ValueAt)
    | Imported(Ident)

told_at* = (tree: Ast, file: str, p: Pos) Tell {
    named = named_at(tree, file, p);
    is_nothing(named).match({
        false => named,
        true  => node_told(tree, file, p),
    })
}

is_nothing* = (t: Tell) bool {
    t.match({ Nothing => true, _ => false })
}

module_index_of* = (tree: Ast, file: str) Res<usize> {
    Range(0, tree.module_count()).find((i) {
        tree.module_at(i).match({
            None  => false,
            Ok(m) => m.span.file.eq(file),
        })
    })
}

pick = (have: Tell, cand: Tell) Tell {
    is_nothing(have).match({ true => cand, false => have })
}

named_at = (tree: Ast, file: str, p: Pos) Tell {
    found ::= Tell.Nothing;
    Range(0, tree.module_count()).loop((h, i) {
        tree.module_at(i).match({
            None  => (),
            Ok(m) => m.decls.loop((h2, d) {
                found = pick(found, decl_told(d, file, p));
            }),
        });
    });
    tree.blocks_each((bid, block) {
        block.stmts.loop((h2, s) {
            found = pick(found, stmt_named(s, file, p));
        });
    });
    found;
}

stmt_named = (s: Stmt, file: str, p: Pos) Tell {
    s.kind.match({
        Decl(d) => decl_told(d, file, p),
        _       => Tell.Nothing,
    })
}

// Struct and enum declaration names have no written TypeId; uses still resolve
// through their type nodes.
decl_told = (d: Decl, file: str, p: Pos) Tell {
    d.kind.match({
        Function(f) => fn_told(f, file, p),
        Const(cn)   => const_told(cn, file, p),
        Alias(al)   => at_type(
            al.name.span,
            al.target,
            in_span(al.name.span, file, p)
        ),
        Struct(st)  => members_told(st.members, file, p),
        Impl(im)    => members_told(im.members, file, p),
        Enum(_)     => Tell.Nothing,
        Import(im)  => import_told(im, file, p),
    })
}

// Each imported binding has its own cursor span.
import_told = (im: Import, file: str, p: Pos) Tell {
    found ::= Tell.Nothing;
    im.names.loop((h, n) {
        found = pick(found, imported_told(n.name, file, p));
    });
    found;
}

imported_told = (name: Ident, file: str, p: Pos) Tell {
    in_span(name.span, file, p).match({
        true  => Tell.Imported(name),
        false => Tell.Nothing,
    })
}

// A function name resolves to its signature; parameters resolve to their types.
fn_told = (f: Function, file: str, p: Pos) Tell {
    in_span(f.name.span, file, p).match({
        true  => Tell.Sig(f),
        false => params_told(f.params, file, p),
    })
}

params_told = (ps: Vec<Param>, file: str, p: Pos) Tell {
    found ::= Tell.Nothing;
    ps.loop((h, prm) { found = pick(found, param_told(prm, file, p)); });
    found;
}

// Parameters without written types have no AST-level type answer.
param_told = (prm: Param, file: str, p: Pos) Tell {
    hit = in_span(prm.name.span, file, p);
    prm.type.match({
        None  => Tell.Nothing,
        Ok(t) => at_type(prm.name.span, t, hit),
    })
}

// `X: i32 = 5` answers from the annotation, `X = 5` from the value — the
// same rule a `Bind` gets below; the annotation wins where both exist.
const_told = (cn: Const, file: str, p: Pos) Tell {
    hit = in_span(cn.name.span, file, p);
    cn.type.match({
        Ok(t) => at_type(cn.name.span, t, hit),
        None  => at_value(cn.name.span, cn.value, hit),
    })
}

members_told = (ms: Vec<Member>, file: str, p: Pos) Tell {
    found ::= Tell.Nothing;
    ms.loop((h, m) { found = pick(found, member_told(m, file, p)); });
    found;
}

member_told = (m: Member, file: str, p: Pos) Tell {
    m.kind.match({
        Function(f) => fn_told(f, file, p),
        Const(cn)   => const_told(cn, file, p),
        Field(fl)   => field_told(
            fl.name.span,
            fl.type,
            fl.value,
            in_span(fl.name.span, file, p)
        ),
    })
}

// Supplied members resolve through their value; declared fields use their type.
field_told = (span: Span, t: Res<TypeId>, v: Res<ExprId>, hit: bool) Tell {
    t.match({
        Ok(id) => at_type(span, id, hit),
        None   => v.match({
            Ok(e) => at_value(span, e, hit),
            None  => Tell.Nothing,
        }),
    })
}

// Pattern nodes have no checked type memo; written type nodes do.
node_told = (tree: Ast, file: str, p: Pos) Tell {
    node_at(tree, file, p).match({
        None  => Tell.Nothing,
        Ok(n) => n.match({
            ExprNode(e)    => expr_told(tree, e),
            TypeNode(t)    => at_type(tree.type_at(t).span, t, true),
            PatternNode(_) => Tell.Nothing,
            BlockNode(_)   => Tell.Nothing,
        }),
    })
}

// Binding targets resolve through their annotation or value because they are
// not checked as standalone expressions.
expr_told = (tree: Ast, e: ExprId) Tell {
    found ::= at_value(tree.expr_at(e).span, e, true);
    tree.blocks_each((bid, block) {
        block.stmts.loop((h2, s) {
            found = pick_bound(found, s, tree.expr_at(e).span, e);
        });
    });
    found;
}

pick_bound = (have: Tell, s: Stmt, span: Span, e: ExprId) Tell {
    s.kind.match({
        Bind(b) => bind_told(have, b, span, e),
        _       => have,
    })
}

bind_told = (have: Tell, b: Bind, span: Span, e: ExprId) Tell {
    (b.target.index == e.index).match({
        false => have,
        true  => b.type.match({
            Ok(t) => at_type(span, t, true),
            None  => at_value(span, b.value, true),
        }),
    })
}

at_type = (span: Span, id: TypeId, hit: bool) Tell {
    hit.match({
        true  => Tell.OfType(TypeAt(span: span, id: id)),
        false => Tell.Nothing,
    })
}

at_value = (span: Span, id: ExprId, hit: bool) Tell {
    hit.match({
        true  => Tell.OfValue(ValueAt(span: span, id: id)),
        false => Tell.Nothing,
    })
}
