// A GENERIC TYPE'S FREE FUNCTION IS REACHED THROUGH THE INSTANTIATION:
// `b.fill(2)` where `fill` declares `(b: Box<i32>, k: i32)` and `b` is a
// `Box<i32>`. The dot must see through the type arguments to the free
// function's parameter -- and the body must see the instantiation's
// field, not the generic skeleton's.
//
// The wrong implementation either stops at the generic (`Box` has no
// `fill` candidate because the parameter names `Box<i32>`), or matches
// the shape but instantiates the callee against the wrong type argument.
// Both failures are quiet: one rejects with a plausible-looking "no
// `fill` on `Box<i32>`", the other prints a mangled-field value that
// still reads as a number. The i64 field is deliberately wide so a
// truncated or mis-sliced read shows.
//
// Breaks if: instantiation is lost on either side of the call -- the
// direct line answers 42, the dot line 12; any mismatch breaks one.

Box*<T> = {
    n*: T,
}

fill* = (b: Box<i32>, k: i32) i32 { b.n * k }

main = (env: Env) Res<i32, AllocError> {
    b = Box<i32>(n: 6);
    println("direct {}", fill(b, 7));
    println("dot    {}", b.fill(2));
    Ok(0);
}
