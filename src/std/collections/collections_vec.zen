// Growable allocator-backed buffer. Its sealed operations are not extension
// points and compile to direct calls.

Alloc, AllocError, Ptr, null_ptr = std.mem
Range = std.core.range

Vec*<T> = {
    data :: Ptr<T> = null_ptr<T>(),
    len* :: usize = 0,
    capacity :: usize = 0,
    alloc: Alloc,

    add* = (self :: @Self, value: T) Res<(), AllocError> {
        (self.len == self.capacity).match({
            true  => self.grow(),
            false => Ok(()),
        }).try();
        self.data.write(self.len, value);
        self.len = self.len + 1;
        Ok(());
    }

    get* = (self: @Self, i: usize) Res<T> {
        (i < self.len).match({
            true  => Ok(self.data.read(i)),
            false => None,
        });
    }

    // Raw storage access; callers own bounds and lifetime checks.
    ptr* = (self: @Self) Ptr<T> { self.data }

    set* = (self :: @Self, i: usize, value: T) Res<()> {
        (i < self.len).match({
            true  => { self.data.write(i, value); Ok(()) },
            false => None,
        });
    }

    // Move an element out and close its slot. Consuming the return value keeps
    // Drop elements owned by the caller rather than this frame.
    take* = (self :: @Self, i: usize) Res<T> {
        value = self.get(i).try();
        Range(i + 1, self.len).loop((h, j) {
            self.data.write(j - 1, self.data.read(j));
        });
        self.len = self.len - 1;
        Ok(consume value);
    }

    // Remove every element while retaining the allocated capacity.
    clear* = (self :: @Self) () {
        loop(self.len > 0, (h) {
            self.take(self.len - 1).match({
                Ok(value) => { dropped = consume value; },
                None      => (),
            });
        });
    }

    // Reserve room for n additional elements without changing len.
    reserve* = (self :: @Self, n: usize) Res<(), AllocError> {
        want = self.len + n;
        (want <= self.capacity).match({
            true  => Ok(()),
            false => self.reallocate(want * 2),
        })
    }

    // Reserve and count n unwritten slots. The caller must initialize them
    // before exposing the Vec.
    grow_by* = (self :: @Self, n: usize) Res<(), AllocError> {
        self.reserve(n).try();
        self.len = self.len + n;
        Ok(());
    }

    grow = (self :: @Self) Res<(), AllocError> {
        self.reallocate((self.capacity == 0).match({
            true  => 1,
            false => self.capacity * 2,
        }))
    }

    reallocate = (self :: @Self, cap: usize) Res<(), AllocError> {
        self.data     = self.alloc.realloc(self.data, cap).try();
        self.capacity = cap;
        Ok(());
    }
}

// Iteration observes the current length, including growth during a loop.
Vec.impl(Range<T>, {
    start: 0,
    end: self.len,

    at ::= (self: @Self, index: usize) Res<T> { self.get(index) }
})

// Construction allocates no storage; the first growth can fail.
Vec* = <T>(a: Alloc) Vec<T> {
    Vec(alloc: a)
}
