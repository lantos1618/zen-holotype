// std.collections.hashidx — the separate-chaining open-hash INDEX MECHANICS shared by
// std.collections.{hmap,set}. Pure `[i64]`-buffer operations over a `2*cap`-slot index buffer:
// the first `cap` slots are bucket HEADS (an entry index or -1 for the empty chain), the next
// `cap` slots are per-entry NEXT links. The buffer is a plain `[i64]`; the CALLER owns hashing
// and equality — which legitimately differ per container (trait dispatch in hmap, byte-wise in
// set, byte-wise string in map) — and hands this module only PRECOMPUTED buckets and slot
// indices. So the mechanics live here once; the key strategy stays with each container.
//
// std.collections.map keeps its own chain walk (its keys are StringView, compared bytewise) but
// shares hashidx_fold, so the non-negative mask below is the ONLY copy in the tree.
//
// No imports — this is the collections dependency floor.
// Fold a full-width hash into a bucket in [0, cap): mask to non-negative (clear the sign bit),
// then mod into the table. cap is always >= 1 at every call site. This is the single bucket-fold
// shared across the hash containers — the `4611686018427387903` mask (2^62 - 1) lives here.
hashidx_fold* = (h: i64, cap: i64) i64 { (h & 4611686018427387903) % cap }
// Clear all `cap` bucket heads to -1 (the empty chain) ahead of a reindex. The next-link region
// [cap, 2*cap) is intentionally left untouched — the reindex loop rewrites each live entry's link
// (via hashidx_link) before it is ever read. `ix` is the full `2*cap`-slot buffer; the walk stops
// at cap.
hashidx_clear* = (ix: MutSlice<i64>, cap: i64) void {
    ix.loop((h, i, v) {
        (i < cap).match ({
            true  => {
                ix[i] = 0 - 1
            },
            false => {
                h.break
            },
        })
    })
}
// Push `slot` onto the FRONT of bucket `b`'s chain: the entry's next-link takes the old head,
// then the head points at the entry. `b` is a precomputed bucket (see hashidx_fold) and the
// caller has already written the element/key into `slot`. This one link step is the shared core
// of append's link, the reindex loop, and delete's re-link — preserving chain order (LIFO within
// a bucket) exactly as the hand-rolled versions did.
hashidx_link* = (ix: MutSlice<i64>, cap: i64, slot: i64, b: i64) void {
    ix[cap + slot] = ix[b]
    ix[b] = slot
}
