// THE DISK COPY. Every buffer the test opens replaces it — it exists
// because the walk stats a path before it reads one, and because a
// module that is only ever an overlay would hide a build that had
// stopped consulting the overlay.
Point = app.shape

near = (q: Point, n: i32) i32 {
    s = q.x + n;
    s
}

far = (p: Point) i32 {
    near(p, 1)
}
