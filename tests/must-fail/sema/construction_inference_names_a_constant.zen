// tests/must-fail/sema/construction_inference_names_a_constant.zen
//
// The constant half of the rule, at the inference face: `cap: i32 = 50`
// (one colon) is a struct-body CONSTANT -- R4, one value per type, read
// as `Box.cap` -- so a construction naming it supplies storage for
// nothing. Inference reaches it through `unify_ctor_field`, whose Ok arm
// unifies against the constant's type and never asks `Found.constant`;
// only the gate downstream refuses it. This file holds that order.
//
// position: the argument's name.

Box<T> = {
    held: T,
    cap:  i32 = 50,
}

main = (env: Env) Res<i32, AllocError> {
    b = Box(held: 1, cap: 9);
    println("{}", b.held);
    Ok(0);
}
