// THE FILE ON DISK, and the test's buffer is deliberately not this.
//
// The parameter is `p` here and `q` in the buffer the test opens, so the
// signature hover prints says which of the two was checked. If the
// overlay ever stops being consulted, this file's `p` appears in the
// answer and `main.expected` goes red naming the byte.
Point = app.shape

near = (p: Point, n: i32) i32 {
    s = p.x + n;
    s
}
