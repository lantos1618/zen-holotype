// the first way out, one binding deep: `s` names the block exactly as
// the keyword does, so returning it is the same escape — the caller's
// defer registers on a frame that has already gone.
//
// refused through the binding's provenance, not its syntax: what the
// walk refuses at the tail is the NAME `s`, carrying the keyword's own
// fault with it.

here = () Scope {
    s = @scope;
    s;
}

main = (env: Env) Res<i32, IoError> {
    d = here();
    d.defer(() { println("goodbye") });
    Ok(0);
}
