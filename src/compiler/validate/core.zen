// compiler.validate.core — orchestration: the kv_* validation walk, check_module*, public entry points.
{ cbuf, ArmData, AssignData, BinData, CallData, Decl, Expr, Field, FieldInit, Func, ImplData, IndexData, IndexSetData, LetData, MakeStructData, MatchData, Param, Stmt, StructDecl, Ty, arm, call, gstr_append, gstr_finish, gstr_string, tvoid } = compiler.genc
{ DeclIndex, Env, arm_env, bind_tparams, build_decl_index, extend_env, is_intrinsic, is_void_ty, loop_env, params_env } = compiler.check
{ resolve_module } = compiler.check_resolve
{ scan } = compiler.lex
{ map_slice } = compiler.astops
{ Malloc } = std.mem.alloc
{ of } = std.collections.map
{ at } = std.text.bytes
{ is_empty } = std.text.str
{ assert_nonnull_kind, body_pos, cv_no_params, env_imported, env_is_enum, env_is_gen_struct, env_is_struct, env_known_fn, env_params, env_struct_fields, env_trait_method, expr_pos, first_if_offset, fn_name_of, fn_pos_of, fnt_arg_err_at, inf_gen_fields, inf_gen_variants, inf_named_reaches, intrinsic_arity, is_badmatchlabel_call, is_forbidden_raw_call, is_imported_generic, is_nonexhaust_lit_call, is_unresolved_trait_call, null_deref_kind, pos_or, positive_count, shadow_not_callable, shadows_toplevel, source_span, stmt_pos, store_mut_kind, trait_declaring, unknown_ty, unknown_type_message, ut_fields_kind, ut_func_kind, ut_payloads_kind, utn_fields, utn_func, utn_payloads } = compiler.validate.util
{ CheckDiagnostic, Diagnostic, KARGTYPE, KARITY, KARMVOID, KASSIGNFIT, KBOOLARM, KCONFORMANCE, KDUPFN, KDUPVARIANT, KESCAPE, KEXHAUST, KFALLTHROUGH, KINDEX, KINFINITETYPE, KLAMBDAVALUE, KLEAK, KLITEXHAUST, KMAINPARAMS, KMATCHLABEL, KMETHODNOTFOUND, KNEEDANNOT, KNOIF, KNOTCALLABLE, KNULLDEREF, KOPERAND, KOWNERSHIP, KPARSE, KPTRWRITE, KRETURNFIT, KSTRUCTFIELD, KTARGARITY, KTRAITBOUND, KUNDEFINED, KUNREACHABLEARM, KVALPOSRETURN, KVBREAK, desc_or, diagnostic_hint, diagnostic_kind_name, diagnostic_message, diagnostic_span_width, name_errors_body, name_errors_expr } = compiler.validate.diag
{ AliasList, DeadList, alias_nil, alias_step, count_loop_freed, dead_cons, dead_has, dead_nil, escape_step, expr_escapes, is_default_owner_method, is_owner_base, leak_alias_value, mu_body_kind, mu_build_index, nm_read_or_leak, own_dead_body, own_moved_var, own_step, owner_base, recv_typed_miss, scope_params } = compiler.validate.ownership
{ ae_check_func, arg_err_at, makestruct_err, member_err, sl_elem_fit, struct_field_move_src, sv_check_func, sx_func_kind, sx_hint, sx_message, sx_subject } = compiler.validate.args
{ arm_result_err, arms_first_pos, as_sig, assign_err, assign_ptr_write_err, call_void_arm_errs, cond_result_err, dup_arm_errs, enum_payload_err, exhaustive_err, expr_drops_return, ffi_func_kind, ffi_func_msg, has_wildcard, idxset_err, idxset_ptr_write_err, index_err, ka_func_kind, ka_rec_hof_kind, ka_reflect_ret_kind, kdiag_add, kdiag_buf, ko_func_kind, ko_global_kind, kvb_func_kind, let_fit_err, let_needannot_err, match_result_ty, method_err, mkenum_err, novalue_arm_leaf, operand_err, parse_sentinel_kind, ret_err, trait_recv_missing, undef_is_method, unknown_arm_errs, unreachable_arm_errs, value_void_arm_err } = compiler.validate.kinds
{ fn_dup_before, reserved_name_kind, reserved_name_of } = compiler.validate.enrich
// count an assign TARGET as a use only when it is NOT a bare local (a bare `p = …` is a rebind/revival,
// not a read of `p`; a compound `arr[i] = …` / `m.f = …` reads the base/index, so still check those).
kv_own_assign_target_kind = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, t: Ptr<Expr>) i32 {
    load(t).match ({
        .Var(v) => 0,
        _       => a.kv_own_expr_kind(env, seen, al, t),
    })
}
// ── FREE-IN-LOOP ─────────────────────────────────────────────────────────────────────────────────
// A loop body runs N times, but the lexical walk sees it once: a body that frees a local declared
// OUTSIDE the loop and does not rebind it before the iteration ends frees the same pointer again on
// the next iteration — a double-free the single walk misses. The net kill-set of ONE body walk
// (branch-aware, so a conditional free counts — the same may-rule as the post-branch dead-set)
// contains exactly the names freed-per-iteration; any of them declared OUTSIDE the body (not a body
// `let`, not a loop binding) is flagged. The `p = a.resize(p, n)` grow idiom rebinds in the same
// statement, so it nets to alive and stays legal; free-then-`return` arms are excluded by the usual
// fall-through rule (the loop is exited, no second free).
// every `let` name anywhere in a body (incl. nested arms/blocks/loops): fresh per iteration.
loop_lets = (a: MutPtr<Malloc>, acc: Ptr<DeadList>, body: [Stmt]) Ptr<DeadList> {
    out := acc
    body.loop((h, i, st) {
        out = a.loop_lets_stmt(out, st)
    })
    out
}
loop_lets_stmt = (a: MutPtr<Malloc>, acc: Ptr<DeadList>, st: Stmt) Ptr<DeadList> {
    st.match ({
        .Let(l)      => a.loop_lets_expr(a.dead_cons(l.name, acc), l.value),
        .Assign(x)   => a.loop_lets_expr(acc, x.value),
        .Return(r)   => a.loop_lets_expr(acc, r),
        .ExprStmt(e) => a.loop_lets_expr(acc, e),
        .If(f)       => a.loop_lets(a.loop_lets(acc, f.then), f.els),
        .While(w)    => a.loop_lets(acc, w.body),
        _            => acc,
    })
}
loop_lets_expr = (a: MutPtr<Malloc>, acc: Ptr<DeadList>, e: Ptr<Expr>) Ptr<DeadList> {
    load(e).match ({
        .Block(b) => a.loop_lets(acc, b.stmts),
        .Match(m) => a.loop_lets_arms(acc, m.arms),
        .Cond(d)  => a.loop_lets_expr(a.loop_lets_expr(acc, d.t), d.e),
        .Loop(l)  => a.loop_lets(a.dead_cons(l.h, a.dead_cons(l.elem, a.dead_cons(l.idx, acc))), l.body),
        _         => acc,
    })
}
loop_lets_arms = (a: MutPtr<Malloc>, acc: Ptr<DeadList>, arms: [ArmData]) Ptr<DeadList> {
    out := acc
    arms.loop((h, i, ar) {
        out = a.loop_lets_expr(out, ar.body)
    })
    out
}
loop_body_outer_frees = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, body: [Stmt], binds: Ptr<DeadList>) i32 {
    net := a.own_dead_body(env, seen, al, body)
    a.count_loop_freed(net, seen, a.loop_lets(binds, body), a.dead_nil())
}
loop_outer_frees = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, l: LoopData) i32 {
    a.loop_body_outer_frees(env, seen, al, l.body, a.dead_cons(l.h, a.dead_cons(l.elem, a.dead_cons(l.idx, a.dead_nil()))))
}
// Compatibility verdict API. The positioned diagnostic visitor below is authoritative; keeping a
// second count-only AST walk made every new rule land twice and invited count/kind drift.
check_module_ownership* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    (a.check_module_ownership_kind(decls) == 0).match ({ true => 0, false => 1 })
}
// Compatibility verdict API: 0 = clean, 1 = rejected. Detailed callers consume `check_module_kind`,
// `check_module_batch`, or a structured diagnostic, so the old parallel count traversal is redundant.
check_module* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    (a.check_module_kind(decls) == 0).match ({ true => 0, false => 1 })
}
check_diagnostic_none* = () CheckDiagnostic {
    CheckDiagnostic(
        code: 0,
        kind: "ok",
        source_offset: 0 - 1,
        span_width: 0,
        count: 0,
        message: "",
        hint: "",
    )
}
check_module_no_if_diagnostic_from_source* = (src: string_view) CheckDiagnostic {
    pos := src.first_if_offset()
    (pos < 0).match ({
        true  => check_diagnostic_none(),
        false => CheckDiagnostic(
            code: KNOIF(),
            kind: "no-if",
            source_offset: pos,
            span_width: 2,
            count: 1,
            message: "`if` is not part of Zen; conditional control flow uses `.match`",
            hint: "replace `if (cond) { yes } else { no }` with `cond.match ({ true => yes, false => no })`; inside an enum arm, nest a boolean `.match` in the arm body",
        ),
    })
}
check_diagnostic_from_packed* = (packed: i32, count: i32) CheckDiagnostic {
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => {
            code := packed & 63
            has_pos := packed > 63
            CheckDiagnostic(
                code: code,
                kind: code.diagnostic_kind_name(),
                source_offset: has_pos.match ({ true => packed >> 6, false => 0 - 1 }),
                span_width: has_pos.match ({ true => 1, false => 0 }),
                count: count.positive_count(),
                message: code.diagnostic_message(),
                hint: code.diagnostic_hint(),
            )
        },
    })
}
check_diagnostic_from_source* = (src: string_view, packed: i32, count: i32) CheckDiagnostic {
    d := check_diagnostic_from_packed(packed, count)
    (d.code == 0).match ({
        true  => d,
        false => CheckDiagnostic(
            code: d.code,
            kind: d.kind,
            source_offset: d.source_offset,
            span_width: (d.source_offset < 0).match ({
                true  => 0,
                false => src.diagnostic_span_width(d.source_offset),
            }),
            count: d.count,
            message: d.message,
            hint: d.hint,
        ),
    })
}
check_to_diagnostic* = (d: CheckDiagnostic) Diagnostic {
    Diagnostic(
        code: d.code,
        kind: d.kind,
        span: source_span(d.source_offset, d.span_width),
        count: d.count,
        message: d.message,
        hint: d.hint,
    )
}
// first-nonzero combinator: the kind of the FIRST error in traversal order.
kv_kor* = (a: i32, b: i32) i32 { (a == 0).match ({ true => b, false => a }) }
// a 0/1 count predicate → a kind code: emit `k` iff the predicate found an error.
kv_one* = (n: i32, k: i32) i32 { (n == 0).match ({ true => 0, false => k }) }
// pack a SOURCE POSITION into a kind code: kinds are 1..63 (6 bits), so `kind + pos*64` carries the
// error's byte offset alongside it (pos 0 = unknown/synthesized — the bare kind, the old encoding).
// Consumers unpack with `& 63` / `>> 6`. Applied only at leaves that HAVE a pos (Call/Var); an
// already-packed nested result is never re-packed: values above 63 already carry an offset.
// Capacity: i32 packing caps the flat-source byte offset at (2^31-1)/64 ≈ 33.5 MB; the whole
// in-tree Zen source is < 1 MB today, so headroom is ~38x before i64 packing would be needed.
kv_at* = (k: i32, p: i32) i32 {
    (k == 0 || k > 63 || p <= 0).match ({ true => k, false => k + p * 64 })
}
// Ownership kind pass mirrors the raw ownership count pass above.
kv_own_args_kind = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, args: [Expr]) i32 {
    acc := 0
    args.loop((h, i, ar) {
        acc = acc.kv_kor(a.kv_own_expr_kind(env, seen, al, ar.addr()))
    })
    acc
}
kv_own_inits_kind = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, inits: [FieldInit]) i32 {
    acc := 0
    inits.loop((h, i, fi) {
        acc = acc.kv_kor(a.kv_own_expr_kind(env, seen, al, fi.value))
    })
    acc
}
kv_own_arms_kind = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, subjty: Ty, arms: [ArmData]) i32 {
    acc := 0
    arms.loop((h, i, ar) {
        acc = acc.kv_kor(a.kv_own_expr_kind(a.arm_env(env, subjty, ar), seen, al, ar.body))
    })
    acc
}
// the DOUBLE-MOVE (re-census #63) in the kind pass: the same owner moved into two Own fields of one
// struct literal reports KOWNERSHIP at the second-moved value's position (mirrors own_struct_dupmove_err).
kv_own_struct_dupmove_kind = (a: MutPtr<Malloc>, env: Env, s: MakeStructData) i32 {
    acc := 0
    env.env_is_struct(s.ty).then({
        fields := env.env_struct_fields(s.ty)
        d := a.dead_nil()
        s.inits.loop((h, i, fi) {
            nm := env.struct_field_move_src(fields, fi)
            (nm.is_empty() == false).then({
                acc = acc.kv_kor(d.dead_has(nm).match ({
                    true  => KOWNERSHIP().kv_at(load(fi.value).expr_pos()),
                    false => 0,
                }))
                d = a.dead_cons(nm, d)
            })
        })
    })
    acc
}
kv_own_slice_dupmove_kind = (a: MutPtr<Malloc>, env: Env, items: [Expr]) i32 {
    acc := 0
    d := a.dead_nil()
    items.loop((h, i, it) {
        nm := env.own_moved_var(it.addr())
        (nm.is_empty() == false).then({
            acc = acc.kv_kor(d.dead_has(nm).match ({
                true  => KOWNERSHIP().kv_at(it.expr_pos()),
                false => 0,
            }))
            d = a.dead_cons(nm, d)
        })
    })
    acc
}
kv_own_expr_kind = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, e: Ptr<Expr>) i32 {
    load(e).match ({
        .Var(v)        => seen.dead_has(v.name).match ({
            true  => KOWNERSHIP().kv_at(v.pos),
            false => 0,
        }),
        .Call(c)       => a
            .kv_own_args_kind(env, seen, al, c.args)
            .kv_kor(env.is_default_owner_method(c).match ({
                true  => KOWNERSHIP().kv_at(c.pos),
                false => 0,
            })),
        .Index(ix)     => a
            .kv_own_expr_kind(env, seen, al, ix.seq)
            .kv_kor(a.kv_own_expr_kind(env, seen, al, ix.idx)),
        .Bin(b)        => a
            .kv_own_expr_kind(env, seen, al, b.lhs)
            .kv_kor(a.kv_own_expr_kind(env, seen, al, b.rhs)),
        .Cond(d)       => a
            .kv_own_expr_kind(env, seen, al, d.c)
            .kv_kor(a.kv_own_expr_kind(env, seen, al, d.t))
            .kv_kor(a.kv_own_expr_kind(env, seen, al, d.e)),
        .Member(m)     => a.kv_own_expr_kind(env, seen, al, m.obj),
        .Arrow(ar)     => a.kv_own_expr_kind(env, seen, al, ar.obj),
        .Match(m)      => a
            .kv_own_expr_kind(env, seen, al, m.subj)
            .kv_kor(a.kv_own_arms_kind(env, seen, al, env.infer_expr(m.subj), m.arms)),
        .MakeEnum(mk)  => a.kv_own_expr_kind(env, seen, al, mk.payload),
        .MakeStruct(s) => a
            .kv_own_inits_kind(env, seen, al, s.inits)
            .kv_kor(a.kv_own_struct_dupmove_kind(env, s)),
        .SliceLit(sd)  => a
            .kv_own_args_kind(env, seen, al, sd.items)
            .kv_kor(a.kv_own_slice_dupmove_kind(env, sd.items)),
        .Loop(l)       => a
            .kv_own_expr_kind(env, seen, al, l.seq)
            .kv_kor(a.kv_own_body_kind(env, seen, al, l.body))
            .kv_kor(a
                .loop_outer_frees(env, seen, al, l)
                .kv_one(KOWNERSHIP())
                .kv_at(load(l.seq).expr_pos().pos_or(body_pos(l.body)))),
        .Block(b)      => a.kv_own_body_kind(env, seen, al, b.stmts),
        _              => 0,
    })
}
kv_own_stmt_kind = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, st: Stmt) i32 {
    st.match ({
        .Let(l)      => a.kv_own_expr_kind(env, seen, al, l.value),
        .Assign(x)   => a
            .kv_own_assign_target_kind(env, seen, al, x.target)
            .kv_kor(a.kv_own_expr_kind(env, seen, al, x.value)),
        .Return(r)   => a.kv_own_expr_kind(env, seen, al, r),
        .ExprStmt(e) => a.kv_own_expr_kind(env, seen, al, e),
        .If(f)       => a
            .kv_own_expr_kind(env, seen, al, f.c)
            .kv_kor(a.kv_own_body_kind(env, seen, al, f.then))
            .kv_kor(a.kv_own_body_kind(env, seen, al, f.els)),
        .While(w)    => a
            .kv_own_expr_kind(env, seen, al, w.c)
            .kv_kor(a.kv_own_body_kind(env, seen, al, w.body))
            .kv_kor(a
                .loop_body_outer_frees(env, seen, al, w.body, a.dead_nil())
                .kv_one(KOWNERSHIP())
                .kv_at(load(w.c).expr_pos().pos_or(body_pos(w.body)))),
        .IndexSet(x) => a
            .kv_own_expr_kind(env, seen, al, x.seq)
            .kv_kor(a.kv_own_expr_kind(env, seen, al, x.idx))
            .kv_kor(a.kv_own_expr_kind(env, seen, al, x.value)),
    })
}
kv_own_body_kind = (a: MutPtr<Malloc>, env: Env, seen: Ptr<DeadList>, al: Ptr<AliasList>, body: [Stmt]) i32 {
    acc := 0
    e := env
    d := seen
    al2 := al
    body.loop((h, i, st) {
        acc = acc.kv_kor(a.kv_own_stmt_kind(e, d, al2, st))
        d = a.own_step(e, d, al2, st)
        al2 = a.alias_step(e, al2, st)
        e = a.extend_env(e, st)
    })
    acc
}
kv_own_check_func_kind = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, f: Func) i32 {
    env := Env(
        vars: a.params_env(f.params),
        decls: decls,
        didx: idx,
        exp: f.ret,
        a: a,
    )
    a.kv_own_body_kind(env, a.dead_nil(), a.alias_nil(), f.body)
}
check_module_ownership_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    acc := 0
    idx := a.build_decl_index(decls)
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DFunc(f) => a.kv_own_check_func_kind(decls, idx, f),
            _         => 0,
        }))
    })
    acc
}
// ── a CALL: authoritative arity, argument-type, and undefined-name classification.
// arg-type position: which arg first fails to fit (so a bad arg reports KARGTYPE not a blanket code).
kv_arg_type_kind = (env: Env, tps: [Param], params: [Param], args: [Expr]) i32 {
    acc := 0
    args.loop((h, i, ar) {
        acc = acc.kv_kor(env.arg_err_at(tps, params, i, ar).kv_one(KARGTYPE()).kv_at(ar.expr_pos()))
    })
    acc
}
// a known local fn: wrong arity → KARITY; right arity but a mistyped CONCRETE arg → KARGTYPE. Slots
// typed by the callee's own tparams are skipped until monomorphization.
// (Trait-BOUND violations are caught by the separate pre-inline bound pass, since local generic calls
// are inlined away before this resolved-decls pass runs.)
kv_call_errs_kind = (env: Env, c: CallData) i32 {
    f := env.env_func(c.fn)
    ps := env.env_params(c.fn)
    (ps.len == c.args.len).match ({
        true  => f.is_imported_generic().match ({
            true  => 0,
            false => env.kv_arg_type_kind(f.tparams, ps, c.args),
        }),
        false => KARITY(),
    })
}
kv_check_call_kind = (env: Env, c: CallData) i32 {
    c.is_nonexhaust_lit_call().match ({
        true  => kv_at(KLITEXHAUST(), c.pos),
        false => c.is_badmatchlabel_call().match ({
            true  => kv_at(KMATCHLABEL(), c.pos),
            false => c.is_forbidden_raw_call().match ({
                true  => KUNDEFINED(),
                false => env.is_unresolved_trait_call(c).match ({
                    true  => 0,
                    false => env.shadows_toplevel(c.fn).match ({
                        true  => env.var_or_global(c.fn).is_fnt().match ({
                            true  => env.kv_fnval_call_kind(c),
                            false => env.shadow_not_callable(c.fn).match ({
                                true  => KNOTCALLABLE(),
                                false => 0,
                            }),
                        }),
                        false => env.env_known_fn(c.fn).match ({
                            true  => env.recv_typed_miss(c).match ({
                                true  => KMETHODNOTFOUND(),
                                false => env.kv_call_errs_kind(c),
                            }),
                            false => c.fn.is_intrinsic().match ({
                                true  => (c.args.len == c.fn.intrinsic_arity()).match ({
                                    true  => env.kv_reflect_kind(c),
                                    false => KARITY(),
                                }),
                                false => (env.env_imported(c.fn) || env.env_trait_method(c.fn)).match ({
                                    true  => env.trait_recv_missing(c).match ({
                                        true  => kv_at(KTRAITBOUND(), c.pos),
                                        false => 0,
                                    }),
                                    false => env.var_or_global(c.fn).is_fnt().match ({
                                        true  => env.kv_fnval_call_kind(c),
                                        false => env.is_bound(c.fn).match ({
                                            true  => KNOTCALLABLE(),
                                            false => (c.args.len > 0
                                                && is_empty(env.decls.trait_declaring(c.fn)) == false).match ({
                                                true  => KTRAITBOUND(),
                                                false => env.undef_is_method(c).match ({
                                                    true  => KMETHODNOTFOUND(),
                                                    false => KUNDEFINED(),
                                                }),
                                            }),
                                        }),
                                    }),
                                }),
                            }),
                        }),
                    }),
                }),
            }),
        }),
    })
}    // a BOUND-but-non-fn target is not-callable, not undefined; a method some trait DECLARES but NO impl provides is a trait-bound gap on the receiver, not an undefined name; a locally-bound name shadows any same-named top-level (see shadows_toplevel); deferred UFCS trait-method call (see check_call)
// A reflection receiver that can NEVER be a struct — a builtin scalar/string/slice/ptr/fn type, or
// a Named ENUM — is rejected with a positioned error instead of leaking the unexpanded intrinsic
// call to genc (an "internal: generated C failed to compile" crash). A plain Named/Generic/void
// receiver stays SILENT: in a template body it is the abstract tparam, and the call-site splice
// decides. field_eq/zip_fields additionally require both subjects to be the SAME named struct
// (the inline pass defers a concrete mismatch here instead of folding two different layouts).
// a Ty's reflect identity: struct name for Named, mangled instance name for Generic, "" = unknown.
kv_refl_tyname = (t: Ty) string_view {
    t.match ({
        .Named(n)   => n,
        .Generic(g) => g.mangled,
        _           => "",
    })
}
kv_reflect_recv_kind = (env: Env, c: CallData) i32 {
    rt := env.infer_expr(c.args[0].addr())
    bad := rt.match ({
        .Named(n)   => env.env_is_enum(n),
        .Generic(g) => false,
        .Void       => false,
        _           => true,
    })
    bad.then({
        return KARGTYPE().kv_at(c.args[0].expr_pos().pos_or(c.pos))
    })
    (c.fn == "field_eq" || c.fn == "zip_fields").match ({
        true  => {
            xn := rt.kv_refl_tyname()
            yn := env.infer_expr(c.args[1].addr()).kv_refl_tyname()
            (xn == "" || yn == "" || xn == yn).match ({
                true  => 0,
                false => KARGTYPE().kv_at(c.args[1].expr_pos().pos_or(c.pos)),
            })
        },
        false => 0,
    })
}
// the lambda arg (last) must be a 2-arg (each_field) / 3-arg (zip_fields) lambda, or a fn-valued
// name (spliced via var_call). Anything else would silently no-op through inline_lambda's
// pass-through fallback — reject it here instead.
kv_reflect_fn_kind = (env: Env, c: CallData) i32 {
    (c.fn == "field_eq").then({
        return 0
    })
    want := (c.fn == "zip_fields").match ({ true => 3, false => 2 })
    li := c.args.len - 1
    c.args[li].match ({
        .Lambda(lm) => (lm.params.len == want).match ({
            true  => 0,
            false => KARGTYPE().kv_at(c.args[li].expr_pos().pos_or(c.pos)),
        }),
        .Var(v)     => 0,
        _           => KARGTYPE().kv_at(c.args[li].expr_pos().pos_or(c.pos)),
    })
}
kv_reflect_kind = (env: Env, c: CallData) i32 {
    (c.fn == "field_eq" || c.fn == "each_field" || c.fn == "zip_fields").match ({
        true  => env.kv_reflect_recv_kind(c).kv_kor(env.kv_reflect_fn_kind(c)),
        false => 0,
    })
}
kv_fnt_arg_kind = (env: Env, ptys: [Ty], args: [Expr]) i32 {
    acc := 0
    args.loop((h, i, ar) {
        acc = acc.kv_kor(env.fnt_arg_err_at(ptys, i, ar).kv_one(KARGTYPE()).kv_at(ar.expr_pos()))
    })
    acc
}
kv_fnval_call_kind = (env: Env, c: CallData) i32 {
    env.var_or_global(c.fn).match ({
        .FnT(ft) => (ft.params.len == c.args.len).match ({
            true  => env.kv_fnt_arg_kind(ft.params, c.args),
            false => KARITY(),
        }),
        _        => KUNDEFINED(),
    })
}
kv_check_args_kind = (env: Env, args: [Expr]) i32 {
    acc := 0
    args.loop((h, i, ar) {
        acc = acc.kv_kor(env.kv_check_expr_kind(ar.addr()))
    })
    acc
}
kv_check_arms_kind = (env: Env, subjty: Ty, arms: [ArmData]) i32 {
    acc := 0
    arms.loop((h, i, ar) {
        acc = acc.kv_kor(env.a.arm_env(env, subjty, ar).kv_check_expr_kind(ar.body))
    })
    acc
}
kv_arm_result_kind = (env: Env, subjty: Ty, want: Ty, ar: ArmData) i32 {
    env.arm_result_err(subjty, want, ar).kv_one(KRETURNFIT()).kv_at(load(ar.body).expr_pos())
}
kv_match_arm_result_kind = (env: Env, subjty: Ty, arms: [ArmData]) i32 {
    want := env.match_result_ty(subjty, arms)
    acc := 0
    arms.loop((h, i, ar) {
        acc = acc.kv_kor(env.kv_arm_result_kind(subjty, want, ar))
    })
    acc
}
// the value-consumed void-arm rule, kind-flavoured (mirrors value_void_arm_err exactly; the caret
// lands on the offending ARM, not the whole match).
kv_value_void_arm_kind = (env: Env, want: Ty, e: Ptr<Expr>) i32 {
    (want.is_void_ty() || env.unknown_ty(want)).match ({
        true  => 0,
        false => load(e).match ({
            .Match(m) => {
                acc := 0
                m.arms.loop((h, i, ar) {
                    acc = acc.kv_kor(env
                        .novalue_arm_leaf(ar.body)
                        .kv_one(KARMVOID())
                        .kv_at(ar.pos.pos_or(load(ar.body).expr_pos())))
                })
                acc
            },
            .Cond(d)  => env
                .novalue_arm_leaf(d.t)
                .kv_one(KARMVOID())
                .kv_at(load(d.t).expr_pos())
                .kv_kor(env.novalue_arm_leaf(d.e).kv_one(KARMVOID()).kv_at(load(d.e).expr_pos())),
            _         => 0,
        }),
    })
}
kv_arm_return_kind = (arms: [ArmData]) i32 {
    acc := 0
    arms.loop((h, i, ar) {
        acc = acc.kv_kor(ar.body.expr_drops_return().kv_one(KVALPOSRETURN()))
    })
    acc
}
// struct-literal init fields: an unknown field OR a mistyped value is KSTRUCTFIELD.
kv_check_inits_kind = (env: Env, inits: [FieldInit]) i32 {
    acc := 0
    inits.loop((h, i, fi) {
        acc = acc.kv_kor(env.kv_check_expr_kind(fi.value))
    })
    acc
}
// struct-literal init: caret on the first init value's source position when it's positioned
// (a Var/Call/StrLit survives resolve; bare numeric literals carry none — best-effort, else file-only).
kv_makestruct_kind = (env: Env, m: MakeStructData) i32 {
    env
        .makestruct_err(m)
        .kv_one(KSTRUCTFIELD())
        .kv_at(m.pos.pos_or((m.inits.len == 0).match ({
            true  => 0,
            false => load(m.inits[0].value).expr_pos(),
        })))
}
// A generic-struct literal's explicit `<…>` list must pin EVERY tparam (`Box<i32,i32>(…)` on a
// 1-param generic silently deferred to mono and misreported downstream). A plain struct takes no
// type arguments at all. An unknown base name stays lenient (the unknown-type channel owns it).
kv_makestruct_targ_kind = (env: Env, m: MakeStructData) i32 {
    n := (m.targs.len == 0).match ({
        true  => 0,
        false => env.env_is_gen_struct(m.ty).match ({
            true  => (m.targs.len == env.env_gstruct(m.ty).tparams.len).match ({
                true  => 0,
                false => 1,
            }),
            false => env.env_is_struct(m.ty).match ({ true => 1, false => 0 }),
        }),
    })
    n
        .kv_one(KTARGARITY())
        .kv_at(m.pos.pos_or((m.inits.len == 0).match ({
            true  => 0,
            false => load(m.inits[0].value).expr_pos(),
        })))
}
// member access caret on the receiver object (a Var/Call survives resolve).
kv_nullable_obj_kind = (env: Env, obj: Ptr<Expr>, pos: i32) i32 {
    env.infer_expr(obj).is_nullable_ptr_ty().match ({
        true  => KNULLDEREF().kv_at(pos.pos_or(load(obj).expr_pos())),
        false => 0,
    })
}
kv_member_kind = (env: Env, obj: Ptr<Expr>, field: string_view, pos: i32) i32 {
    env
        .kv_nullable_obj_kind(obj, pos)
        .kv_kor(env
            .member_err(obj, field)
            .kv_one(KSTRUCTFIELD())
            .kv_at(pos.pos_or(load(obj).expr_pos())))
}
kv_match_null_kind = (env: Env, m: MatchData) i32 {
    env.infer_expr(m.subj).is_nullable_ptr_ty().match ({
        true  => KNULLDEREF().kv_at(load(m.subj).expr_pos()),
        false => 0,
    })
}
kv_match_kind = (env: Env, m: MatchData) i32 {
    // a local-binding subject (`e := …; e.match {…}`) resolves to a Var rebuilt without a source pos
    // (the *_at-ctor pitfall), so fall back to the first arm's pattern pos — the error is always located.
    sp := load(m.subj).expr_pos().pos_or(m.arms.arms_first_pos())
    base := m.arms.has_wildcard().match ({
        true  => m.arms.dup_arm_errs().kv_one(KDUPVARIANT()).kv_at(sp),
        false => env
            .exhaustive_err(m)
            .kv_one(KEXHAUST())
            .kv_at(sp)
            .kv_kor(m.arms.dup_arm_errs().kv_one(KDUPVARIANT()).kv_at(sp)),
    })
    base
        .kv_kor(m.arms.unreachable_arm_errs().kv_one(KUNREACHABLEARM()).kv_at(sp))
        .kv_kor(env.unknown_arm_errs(m).kv_one(KUNDEFINED()).kv_at(sp))
}
kv_index_kind = (env: Env, ix: IndexData) i32 { env.index_err(ix).kv_one(KINDEX()) }
kv_operand_kind = (env: Env, b: BinData) i32 {
    env.operand_err(b).kv_one(KOPERAND()).kv_at(b.pos.pos_or(load(b.lhs).expr_pos()))
}
// targ-arity: the error is judged on the RAW call site (`<…>` survives only pre-inline);
// the resolved view holds a REWRITTEN call whose targ/tparam counts are meaningless — walk
// raw FIRST so the message states the counts the user wrote.
// the value-position block-arm walker, kind-flavoured (mirrors check_block/check_block_stmt).
kv_check_block_stmt_kind = (env: Env, st: Stmt) i32 {
    st.match ({
        .Let(l)      => env
            .kv_check_expr_kind(l.value)
            .kv_kor(env.kv_let_fit_kind(l))
            .kv_kor(env.kv_let_needannot_kind(l))
            .kv_kor(env.kv_value_void_arm_kind(l.ty, l.value)),
        .Assign(x)   => env
            .kv_check_expr_kind(x.target)
            .kv_kor(env.kv_check_expr_kind(x.value))
            .kv_kor(env.kv_assign_kind(x))
            .kv_kor(env.kv_value_void_arm_kind(env.infer_expr(x.target), x.value)),
        .Return(r)   => env
            .kv_check_expr_kind(r)
            .kv_kor(env.kv_ret_kind(r))
            .kv_kor(env.kv_value_void_arm_kind(env.exp, r)),
        .ExprStmt(e) => env.kv_check_expr_kind(e),
        .If(f)       => env.kv_check_expr_kind(f.c),
        .While(w)    => env.kv_check_expr_kind(w.c),
        .IndexSet(x) => env
            .kv_check_expr_kind(x.seq)
            .kv_kor(env.kv_check_expr_kind(x.idx))
            .kv_kor(env.kv_check_expr_kind(x.value))
            .kv_kor(env.kv_idxset_kind(x))
            .kv_kor(env.kv_value_void_arm_kind(x.elem, x.value)),
    })
}
kv_check_block_kind = (env: Env, stmts: [Stmt]) i32 {
    acc := 0
    e := env
    stmts.loop((h, i, st) {
        acc = acc.kv_kor(e.kv_check_block_stmt_kind(st))
        e = e.a.extend_env(e, st)
    })
    acc
}
// A slice-literal element whose type doesn't fit the first element's produces KARGTYPE.
kv_slicelit_kind = (env: Env, items: [Expr]) i32 {
    (items.len == 0).match ({
        true  => 0,
        false => {
            ety := env.infer_expr(items[0].addr())
            acc := 0
            items.loop((h, i, it) {
                acc = acc.kv_kor(env.sl_elem_fit(ety, it).kv_one(KARGTYPE()).kv_at(it.expr_pos()))
            })
            acc
        },
    })
}
// The narrowed walk above records the full count plus the first failing position and kind. The count and
// diagnostic layers therefore share one AST traversal definition instead of maintaining parallel
// recursive walkers that can silently drift when a new expression form is added.
lkv_expr_kind = (env: Env, e: Ptr<Expr>) i32 {
    r := env.name_errors_expr(e)
    (r.first_pos > 0).match ({ true => r.first_kind.kv_at(r.first_pos), false => 0 })
}
lkv_body_kind = (a: MutPtr<Malloc>, env: Env, body: [Stmt]) i32 {
    r := a.name_errors_body(env, body)
    (r.first_pos > 0).match ({ true => r.first_kind.kv_at(r.first_pos), false => 0 })
}
// Authoritative expression validation: node order defines first-error precedence.
kv_check_expr_kind = (env: Env, e: Ptr<Expr>) i32 {
    load(e).match ({
        .Call(c)        => env
            .kv_check_call_kind(c)
            .kv_at(c.pos)
            .kv_kor(env.store_mut_kind(c))
            .kv_kor(env.null_deref_kind(c))
            .kv_kor(env.assert_nonnull_kind(c))
            .kv_kor(env.call_void_arm_errs(c).kv_one(KARMVOID()).kv_at(c.pos))
            .kv_kor((c.fn == "sizeof"
                || c.fn == "field_eq"
                || c.fn == "each_field"
                || c.fn == "zip_fields").match ({
                true  => 0,
                false => env.kv_check_args_kind(c.args),
            })),    // reflection intrinsics: a deferred template-body call still holds its lambda arg
        .SliceLit(sd)   => env.kv_slicelit_kind(sd.items),
        .Index(ix)      => env
            .kv_check_expr_kind(ix.seq)
            .kv_kor(env.kv_check_expr_kind(ix.idx))
            .kv_kor(env.kv_index_kind(ix)),
        .Bin(b)         => env
            .kv_check_expr_kind(b.lhs)
            .kv_kor(env.kv_check_expr_kind(b.rhs))
            .kv_kor(env.kv_operand_kind(b)),
        .Cond(d)        => env
            .kv_check_expr_kind(d.c)
            .kv_kor(env.kv_check_expr_kind(d.t))
            .kv_kor(env.kv_check_expr_kind(d.e))
            .kv_kor(d.t.expr_drops_return().kv_one(KVALPOSRETURN()))
            .kv_kor(d.e.expr_drops_return().kv_one(KVALPOSRETURN()))
            .kv_kor(env.cond_result_err(d).kv_one(KRETURNFIT()).kv_at(load(d.t).expr_pos()))
            .kv_kor(d.cond_onearm_err().kv_one(KBOOLARM()).kv_at(load(d.c).expr_pos())),
        .Member(m)      => env
            .kv_check_expr_kind(m.obj)
            .kv_kor(env.kv_member_kind(m.obj, m.field, m.pos)),
        .Arrow(ar)      => env
            .kv_check_expr_kind(ar.obj)
            .kv_kor(env.kv_member_kind(ar.obj, ar.field, ar.pos)),
        .Match(m)       => {
            subjty := env.infer_expr(m.subj)
            env
                .kv_check_expr_kind(m.subj)
                .kv_kor(env.kv_match_null_kind(m))
                .kv_kor(env.kv_check_arms_kind(subjty, m.arms))
                .kv_kor(env.kv_match_kind(m))
                .kv_kor(env.kv_match_arm_result_kind(subjty, m.arms))
                .kv_kor(kv_arm_return_kind(m.arms))
        },
        .MakeEnum(mk)   => env
            .kv_check_expr_kind(mk.payload)
            .kv_kor(env.mkenum_err(mk.ty, mk.variant).kv_one(KUNDEFINED()))
            .kv_kor(env.enum_payload_err(mk).kv_one(KARGTYPE()).kv_at(load(mk.payload).expr_pos())),
        .Tag(t)         => env.mkenum_err(t.ty, t.variant).kv_one(KUNDEFINED()),
        .MakeStruct(sd) => env
            .kv_check_inits_kind(sd.inits)
            .kv_kor(env.kv_makestruct_targ_kind(sd))
            .kv_kor(env.kv_makestruct_kind(sd)),
        .Block(b)       => env.kv_check_block_kind(b.stmts),
        .Var(v)         => env.var_err(v.name).kv_one(KUNDEFINED()).kv_at(v.pos),
        .Loop(l)        => env
            .lkv_expr_kind(l.seq)
            .kv_kor(env.a.lkv_body_kind(env.a.loop_env(env, l), l.body)),
        .Lambda(lm)     => KLAMBDAVALUE(),    // a surviving lambda = used as a value (see check_expr)
        _               => 0,
    })
}
kv_ret_kind = (env: Env, r: Ptr<Expr>) i32 {
    env.ret_err(r).kv_one(KRETURNFIT()).kv_at(load(r).expr_pos())
}
kv_let_fit_kind = (env: Env, l: LetData) i32 {
    env.let_fit_err(l).kv_one(KASSIGNFIT()).kv_at(load(l.value).expr_pos())
}
kv_let_needannot_kind = (env: Env, l: LetData) i32 {
    env.let_needannot_err(l).kv_one(KNEEDANNOT()).kv_at(load(l.value).expr_pos())
}
kv_assign_kind = (env: Env, x: AssignData) i32 {
    ap := x.pos.pos_or(load(x.target).expr_pos()).pos_or(load(x.value).expr_pos())
    env
        .assign_err(x)
        .kv_one(KASSIGNFIT())
        .kv_at(ap)
        .kv_kor(env.assign_ptr_write_err(x).kv_one(KPTRWRITE()).kv_at(ap))
}
kv_idxset_kind = (env: Env, x: IndexSetData) i32 {
    ip := x.pos.pos_or(load(x.value).expr_pos()).pos_or(load(x.seq).expr_pos())
    env
        .idxset_err(x)
        .kv_one(KASSIGNFIT())
        .kv_at(ip)
        .kv_kor(env.idxset_ptr_write_err(x).kv_one(KPTRWRITE()).kv_at(ip))
}
// Authoritative statement validation: sub-expressions precede the statement-level fit check.
kv_check_stmt_kind = (a: MutPtr<Malloc>, env: Env, st: Stmt) i32 {
    st.match ({
        .Let(l)      => env
            .kv_check_expr_kind(l.value)
            .kv_kor(env.kv_let_fit_kind(l))
            .kv_kor(env.kv_let_needannot_kind(l))
            .kv_kor(env.kv_value_void_arm_kind(l.ty, l.value)),
        .Assign(x)   => env
            .kv_check_expr_kind(x.target)
            .kv_kor(env.kv_check_expr_kind(x.value))
            .kv_kor(env.kv_assign_kind(x))
            .kv_kor(env.kv_value_void_arm_kind(env.infer_expr(x.target), x.value)),
        .Return(r)   => env
            .kv_check_expr_kind(r)
            .kv_kor(env.kv_ret_kind(r))
            .kv_kor(env.kv_value_void_arm_kind(env.exp, r)),
        .ExprStmt(e) => env.kv_check_expr_kind(e),
        .If(f)       => env
            .kv_check_expr_kind(f.c)
            .kv_kor(a.kv_check_body_kind(env, f.then))
            .kv_kor(a.kv_check_body_kind(env, f.els)),
        .While(w)    => env.kv_check_expr_kind(w.c).kv_kor(a.kv_check_body_kind(env, w.body)),
        .IndexSet(x) => env
            .kv_check_expr_kind(x.seq)
            .kv_kor(env.kv_check_expr_kind(x.idx))
            .kv_kor(env.kv_check_expr_kind(x.value))
            .kv_kor(env.kv_idxset_kind(x))
            .kv_kor(env.kv_value_void_arm_kind(x.elem, x.value)),
    })
}
kv_check_body_kind = (a: MutPtr<Malloc>, env: Env, body: [Stmt]) i32 {
    acc := 0
    e := env
    body.loop((h, i, st) {
        acc = acc.kv_kor(a.kv_check_stmt_kind(e, st))
        e = a.extend_env(e, st)
    })
    acc
}
// the trailing-value check, kind-flavoured: an empty / non-value-ending non-void body, or a trailing
// expr that doesn't fit, is a KRETURNFIT (a missing/mistyped produced value).
kv_last_stmt_kind = (env: Env, st: Stmt) i32 {
    st.match ({
        .ExprStmt(e) => env.kv_ret_kind(e).kv_kor(env.kv_value_void_arm_kind(env.exp, e)),
        .Return(r)   => 0,
        _            => KFALLTHROUGH().kv_at(st.stmt_pos()),
    })
}    // a let/assign/loop tail: caret on that statement
kv_trailing_kind = (env: Env, body: [Stmt]) i32 {
    env.exp.is_void_ty().match ({
        true  => 0,
        false => (body.len == 0).match ({
            true  => KFALLTHROUGH(),
            false => env.kv_last_stmt_kind(body[body.len - 1]),
        }),
    })
}
check_module_bound_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    idx := a.build_decl_index(decls)
    acc := 0
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DFunc(f) => a.kvb_func_kind(decls, idx, f),
            _         => 0,
        }))
    })
    acc
}
check_module_bound_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    packed := a.check_module_bound_kind(decls)
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => src.check_diagnostic_from_source(packed, 1),
    })
}
check_module_arg_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    idx := a.build_decl_index(decls)
    acc := 0
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DFunc(f) => f
                .ka_rec_hof_kind()
                .kv_kor(f.ka_reflect_ret_kind())
                .kv_kor(a.ka_func_kind(decls, idx, f)),
            _         => 0,
        }))
    })
    acc
}
check_module_arg_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    packed := a.check_module_arg_kind(decls)
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => src.check_diagnostic_from_source(packed, 1),
    })
}
check_module_or_return_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    idx := a.build_decl_index(decls)
    acc := 0
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DFunc(f)   => a.ko_func_kind(decls, idx, f),
            .DGlobal(g) => a.ko_global_kind(decls, idx, g),
            _           => 0,
        }))
    })
    acc
}
check_module_or_return_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    packed := a.check_module_or_return_kind(decls)
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => src.check_diagnostic_from_source(packed, 1),
    })
}
check_module_unknown_type_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    idx := a.build_decl_index(decls)
    env := Env(
        vars: a.params_env(cv_no_params()),
        decls: decls,
        didx: idx,
        exp: tvoid(),
        a: a,
    )
    acc := 0
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DFunc(f)      => a.ut_func_kind(env, f),
            .DForeign(f)   => a.ut_func_kind(env, f),
            .DStruct(sd)   => env.ut_fields_kind(cv_no_params(), sd.fields, sd.pos),
            .DEnum(ed)     => env.ut_payloads_kind(cv_no_params(), ed.variants, ed.pos),
            .DGenStruct(g) => env.ut_fields_kind(g.tparams, g.fields, g.pos),
            .DGenEnum(g)   => env.ut_payloads_kind(g.tparams, g.variants, g.pos),
            _              => 0,
        }))
    })
    acc
}
check_module_unknown_type_name = (a: MutPtr<Malloc>, decls: [Decl]) string_view {
    idx := a.build_decl_index(decls)
    env := Env(
        vars: a.params_env(cv_no_params()),
        decls: decls,
        didx: idx,
        exp: tvoid(),
        a: a,
    )
    r := ""
    decls.loop((h, i, d) {
        r = desc_or(r, d.match ({
            .DFunc(f)      => a.utn_func(env, f),
            .DForeign(f)   => a.utn_func(env, f),
            .DStruct(sd)   => env.utn_fields(cv_no_params(), sd.fields),
            .DEnum(ed)     => env.utn_payloads(cv_no_params(), ed.variants),
            .DGenStruct(g) => env.utn_fields(g.tparams, g.fields),
            .DGenEnum(g)   => env.utn_payloads(g.tparams, g.variants),
            _              => "",
        }))
    })
    r
}
check_module_unknown_type_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    packed := a.check_module_unknown_type_kind(decls)
    (packed == 0).then({
        return check_diagnostic_none()
    })
    d := src.check_diagnostic_from_source(packed, 1)
    nm := a.check_module_unknown_type_name(decls)
    is_empty(nm).match ({
        true  => d,
        false => CheckDiagnostic(
            code: d.code,
            kind: d.kind,
            source_offset: d.source_offset,
            span_width: d.span_width,
            count: d.count,
            message: a.unknown_type_message(nm),
            hint: d.hint,
        ),
    })
}
check_module_ffi_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    idx := a.build_decl_index(decls)
    env := Env(
        vars: a.params_env(cv_no_params()),
        decls: decls,
        didx: idx,
        exp: tvoid(),
        a: a,
    )
    acc := 0
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DForeign(f) => env.ffi_func_kind(f),
            _            => 0,
        }))
    })
    acc
}
check_module_ffi_name = (a: MutPtr<Malloc>, decls: [Decl]) string_view {
    idx := a.build_decl_index(decls)
    env := Env(
        vars: a.params_env(cv_no_params()),
        decls: decls,
        didx: idx,
        exp: tvoid(),
        a: a,
    )
    r := ""
    decls.loop((h, i, d) {
        r = desc_or(r, d.match ({
            .DForeign(f) => a.ffi_func_msg(env, f),
            _            => "",
        }))
    })
    r
}
check_module_ffi_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    packed := a.check_module_ffi_kind(decls)
    (packed == 0).then({
        return check_diagnostic_none()
    })
    d := src.check_diagnostic_from_source(packed, 1)
    nm := a.check_module_ffi_name(decls)
    is_empty(nm).match ({
        true  => d,
        false => CheckDiagnostic(
            code: d.code,
            kind: d.kind,
            source_offset: d.source_offset,
            span_width: d.span_width,
            count: d.count,
            message: nm,
            hint: d.hint,
        ),
    })
}
check_module_infinite_type_kind* = (decls: [Decl]) i32 {
    acc := 0
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DStruct(sd)   => decls.inf_named_reaches(sd.name, sd.name, decls.len).match ({
                true  => KINFINITETYPE().kv_at(sd.pos),
                false => 0,
            }),
            .DEnum(ed)     => decls.inf_named_reaches(ed.name, ed.name, decls.len).match ({
                true  => KINFINITETYPE().kv_at(ed.pos),
                false => 0,
            }),
            .DGenStruct(g) => g.fields.inf_gen_fields(g.name).match ({
                true  => KINFINITETYPE().kv_at(g.pos),
                false => 0,
            }),
            .DGenEnum(g)   => g.variants.inf_gen_variants(g.name).match ({
                true  => KINFINITETYPE().kv_at(g.pos),
                false => 0,
            }),
            _              => 0,
        }))
    })
    acc
}
check_module_infinite_type_diagnostic_from_source* = (decls: [Decl], src: string_view) CheckDiagnostic {
    packed := decls.check_module_infinite_type_kind()
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => src.check_diagnostic_from_source(packed, 1),
    })
}
// ── main signature: `main` is `() i32` OR `(sys: Sys) i32` (KMAINPARAMS) ──────────────────────────
// The OS entry (zenrt.c) calls the emitted `zen_main()` with NO arguments. Two legal shapes:
//   `main = () i32`         — niladic; the C boundary calls it directly.
//   `main = (sys: Sys) i32` — the capability entry; genc_emit renames it and emits a niladic `zen_main`
//                             trampoline that feeds it `std.sys.root()` (see genc_emit.gen_func). The C
//                             boundary stays niladic, so no parameter ever reads garbage.
// Any OTHER parameter shape (2+ params, or a single non-`Sys` param) still compiled clean and then read
// GARBAGE for the declared parameters — undefined behavior behind a green build — so it stays rejected.
// The accepted `(sys: Sys)` form must carry exactly one parameter whose type is the record `Sys`.
main_param_is_sys = (f: Func) bool {
    (f.params.len == 1).match ({
        true  => f.params[0].ty.match ({
            .Named(nm) => nm == "Sys",
            _          => false,
        }),
        false => false,
    })
}
main_params_kind = (decls: [Decl]) i32 {
    k := 0
    decls.loop((h, i, d) {
        k = (k == 0).match ({
            true  => d.match ({
                .DFunc(f) => (f.name == "main" && f.params.len > 0).match ({
                    true  => f.main_param_is_sys().match ({
                        true  => 0,
                        false => KMAINPARAMS().kv_at(f.pos),
                    }),
                    false => 0,
                }),
                _         => 0,
            }),
            false => k,
        })
    })
    k
}
check_module_main_diagnostic_from_source* = (decls: [Decl], src: string_view) CheckDiagnostic {
    packed := decls.main_params_kind()
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => src.check_diagnostic_from_source(packed, 1),
    })
}
check_module_reserved_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    packed := decls.reserved_name_kind()
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => {
            pos := packed >> 6
            w := src.diagnostic_span_width(pos)
            subject := a
                .gstr_string(32)
                .gstr_append(a, "`")
                .gstr_append(a, decls.reserved_name_of())
                .gstr_append(a, "`")
                .gstr_finish(a)
            CheckDiagnostic(
                code: packed & 63,
                kind: "reserved-name",
                source_offset: pos,
                span_width: w,
                count: 1,
                message: a
                    .gstr_string(192)
                    .gstr_append(a, subject)
                    .gstr_append(a, " is a compiler intrinsic; a top-level function may not redefine it — calls would compile to the intrinsic, not this function")
                    .gstr_finish(a),
                hint: a
                    .gstr_string(64)
                    .gstr_append(a, "rename — ")
                    .gstr_append(a, subject)
                    .gstr_append(a, " is a compiler intrinsic")
                    .gstr_finish(a),
            )
        },
    })
}
check_module_mustuse_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    idx := a.build_decl_index(decls)
    mvm := a.mu_build_index(decls, idx)
    acc := 0
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DFunc(f) => a.mu_body_kind(mvm, f.body),
            _         => 0,
        }))
    })
    acc
}
check_module_mustuse_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    packed := a.check_module_mustuse_kind(decls)
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => src.check_diagnostic_from_source(packed, 1),
    })
}
// trait conformance, kind-flavoured (mirrors impl_errs/trait_conformance/method_err).
kv_method_kind = (a: MutPtr<Malloc>, decls: [Decl], im: ImplData, f: Field) i32 {
    a.method_err(decls, im, f).kv_one(KCONFORMANCE())
}
kv_conformance_kind = (a: MutPtr<Malloc>, decls: [Decl], im: ImplData, sd: StructDecl) i32 {
    acc := 0
    sd.fields.loop((h, i, f) {
        acc = acc.kv_kor(a.kv_method_kind(decls, im, f))
    })
    acc
}
kv_impl_kind = (a: MutPtr<Malloc>, decls: [Decl], im: ImplData) i32 {
    acc := 0
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DStruct(sd) => (sd.name == im.trname).match ({
                true  => a.kv_conformance_kind(decls, im, sd),
                false => 0,
            }),
            _            => 0,
        }))
    })
    acc.kv_at(im.pos)
}
// dup-fn, position-carrying: the FIRST duplicated fn name, anchored at the LATER definition's name
// offset (the earlier definition is the established binding), so the driver renders file:line:col +
// a caret at the colliding definition — even when it lives in an imported module (pick_render maps
// the flat offset to whichever module's source contains it). pos 0 (synthesized) degrades to the
// bare kind, exactly the pre-position behavior.
kv_dup_name_kind* = (decls: [Decl]) i32 {
    acc := 0
    decls.loop((h, i, d) {
        nm := d.fn_name_of()
        dup := is_empty(nm).match ({ true => false, false => decls.fn_dup_before(nm, i) })
        acc = acc.kv_kor(dup.match ({ true => KDUPFN().kv_at(d.fn_pos_of()), false => 0 }))
    })
    acc
}
// Return the first packed diagnostic from the same collector used by batch mode. A one-slot sink
// preserves first-error behavior without maintaining a second module/function traversal.
check_module_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    buf: [i32] := slice(a.acquire(sizeof(i32)), 1)
    cnt := a.check_module_kind_all(decls, buf, 0)
    (cnt == 0).match ({ true => 0, false => buf[0] })
}
// One function's errors, per top-level statement. The trailing-value check is anchored on the fn name.
kv_check_func_kind_all = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, f: Func, buf: [i32], cnt: i32) i32 {
    env := Env(
        vars: a.bind_tparams(a.params_env(f.params), f.tparams),
        decls: decls,
        didx: idx,
        exp: f.ret,
        a: a,
    )
    c := cnt
    e := env
    f.body.loop((h, i, st) {
        c = buf.kdiag_add(c, a.kv_check_stmt_kind(e, st))
        e = a.extend_env(e, st)
    })
    buf.kdiag_add(c, env.kv_trailing_kind(f.body).kv_at(f.pos))
}
// every main-channel error in the module, in traversal order: dup-fn names, then each decl (per
// statement for functions, one each for impls / parse sentinels). `cnt` seeds the running count.
check_module_kind_all = (a: MutPtr<Malloc>, decls: [Decl], buf: [i32], cnt: i32) i32 {
    idx := a.build_decl_index(decls)
    c := buf.kdiag_add(cnt, decls.kv_dup_name_kind())
    decls.loop((h, i, d) {
        c = d.match ({
            .DFunc(f)   => a.kv_check_func_kind_all(decls, idx, f, buf, c),
            .DImpl(im)  => buf.kdiag_add(c, a.kv_impl_kind(decls, im)),
            .DGlobal(g) => buf.kdiag_add(c, parse_sentinel_kind(g.name, g.init)),
            _           => c,
        })
    })
    c
}
// the batch as source-positioned CheckDiagnostics (count 1 each — the "(+K more)" trailer is the
// driver's, printed once after the cap). An empty slice means the main channel is clean.
check_module_batch* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) [CheckDiagnostic] {
    buf := a.kdiag_buf()
    cnt := a.check_module_kind_all(decls, buf, 0)
    out := slice(a.acquire(to_i64(cnt) * sizeof(CheckDiagnostic)), to_i64(cnt))
    buf.loop((h, i, p) {
        (i < to_i64(cnt)).then({
            out[i] = src.check_diagnostic_from_source(p, 1)
        })
    })
    out
}
// the parse-sentinel diagnostic ALONE (KPARSE/KVBREAK from __syntax_error; none if the module
// parsed cleanly): the driver reports it FIRST — a syntax error precedes (and usually CAUSES) any
// downstream type error in the same module, so it must not be shadowed by one.
check_module_parse_kind* = (decls: [Decl]) i32 {
    acc := 0
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DGlobal(g) => parse_sentinel_kind(g.name, g.init),
            _           => 0,
        }))
    })
    acc
}
check_module_parse_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    packed := decls.check_module_parse_kind()
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => src.check_diagnostic_from_source(packed, 1),
    })
}
check_module_diagnostic* = (a: MutPtr<Malloc>, decls: [Decl]) CheckDiagnostic {
    packed := a.check_module_kind(decls)
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => check_diagnostic_from_packed(packed, 1),
    })
}
check_module_ownership_diagnostic* = (a: MutPtr<Malloc>, decls: [Decl]) CheckDiagnostic {
    packed := a.check_module_ownership_kind(decls)
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => check_diagnostic_from_packed(packed, 1),
    })
}
check_module_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    packed := a.check_module_kind(decls)
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => src.check_diagnostic_from_source(packed, 1),
    })
}
check_module_ownership_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    packed := a.check_module_ownership_kind(decls)
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => src.check_diagnostic_from_source(packed, 1),
    })
}
module_diagnostic* = (a: MutPtr<Malloc>, decls: [Decl]) Diagnostic {
    a.check_module_diagnostic(decls).check_to_diagnostic()
}
module_ownership_diagnostic* = (a: MutPtr<Malloc>, decls: [Decl]) Diagnostic {
    a.check_module_ownership_diagnostic(decls).check_to_diagnostic()
}
module_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) Diagnostic {
    a.check_module_diagnostic_from_source(decls, src).check_to_diagnostic()
}
module_ownership_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) Diagnostic {
    a.check_module_ownership_diagnostic_from_source(decls, src).check_to_diagnostic()
}
// the kind layer over a CROSS-MODULE link (mirrors check_linked): same layered header, then
// check_module_kind instead of check_module. Lets a cross-module reject also be pinned by KIND.
check_linked_kind* = (a: MutPtr<Malloc>, decls: [Decl], lib: [Decl]) i32 {
    hdr := a.module_header(lib)
    rfile := a.resolve_module(decls)
    world := cbuf<Decl>(a, hdr.len + rfile.len)
    hdr.loop((h, i, d) {
        world[i] = d
    })
    rfile.loop((h, i, d) {
        world[hdr.len + i] = d
    })
    a.check_module_kind(world)
}
module_header* = (a: MutPtr<Malloc>, decls: [Decl]) [Decl] {
    map_slice(a, decls, (d) { a.as_sig(d) })
}
// check `decls` (one file) against an imported module's `lib` decls: the file is resolved as usual,
// then checked in a WORLD that prepends lib's header, so its imported calls resolve to real sigs.
check_linked* = (a: MutPtr<Malloc>, decls: [Decl], lib: [Decl]) i32 {
    hdr := a.module_header(lib)
    rfile := a.resolve_module(decls)
    world := cbuf<Decl>(a, hdr.len + rfile.len)
    hdr.loop((h, i, d) {
        world[i] = d
    })
    rfile.loop((h, i, d) {
        world[hdr.len + i] = d
    })
    a.check_module(world)
}
// Authoritative kind/position pass: the source offset of the FIRST escaping return/trailing
// (0 = none). Statement-position arms inspect returns only; their trailing values are discarded.
kv_escape_stmts = (a: MutPtr<Malloc>, svars: Ptr<DeadList>, derived: Ptr<DeadList>, body: [Stmt]) i32 {
    acc := 0
    d := derived
    body.loop((h, i, st) {
        acc = acc.kv_kor(a.kv_escape_stmt(svars, d, st))
        d = a.escape_step(svars, d, st)
    })
    acc
}
kv_escape_stmt = (a: MutPtr<Malloc>, svars: Ptr<DeadList>, derived: Ptr<DeadList>, st: Stmt) i32 {
    st.match ({
        .Return(r)   => a.expr_escapes(svars, derived, r).match ({
            true  => load(r).expr_pos().pos_or(1),
            false => 0,
        }),
        .If(f)       => a
            .kv_escape_stmts(svars, derived, f.then)
            .kv_kor(a.kv_escape_stmts(svars, derived, f.els)),
        .While(w)    => a.kv_escape_stmts(svars, derived, w.body),
        .ExprStmt(e) => a.kv_escape_expr_stmt(svars, derived, e),
        _            => 0,
    })
}
kv_escape_expr_stmt = (a: MutPtr<Malloc>, svars: Ptr<DeadList>, derived: Ptr<DeadList>, e: Ptr<Expr>) i32 {
    load(e).match ({
        .Match(m) => a.kv_escape_arms(svars, derived, m.arms),
        .Cond(d)  => a
            .kv_escape_expr_stmt(svars, derived, d.t)
            .kv_kor(a.kv_escape_expr_stmt(svars, derived, d.e)),
        .Block(b) => a.kv_escape_stmts(svars, derived, b.stmts),
        .Loop(l)  => a.kv_escape_stmts(svars, derived, l.body),
        _         => 0,
    })
}
kv_escape_arms = (a: MutPtr<Malloc>, svars: Ptr<DeadList>, derived: Ptr<DeadList>, arms: [ArmData]) i32 {
    acc := 0
    arms.loop((h, i, ar) {
        acc = acc.kv_kor(a.kv_escape_arm(svars, derived, ar.body))
    })
    acc
}
kv_escape_arm = (a: MutPtr<Malloc>, svars: Ptr<DeadList>, derived: Ptr<DeadList>, body: Ptr<Expr>) i32 {
    load(body).match ({
        .Block(b) => a.kv_escape_stmts(svars, derived, b.stmts),
        _         => 0,
    })
}
kv_escape_trailing = (a: MutPtr<Malloc>, svars: Ptr<DeadList>, derived: Ptr<DeadList>, st: Stmt) i32 {
    st.match ({
        .ExprStmt(e) => a.expr_escapes(svars, derived, e).match ({
            true  => load(e).expr_pos().pos_or(1),
            false => 0,
        }),
        _            => 0,
    })
}
kv_escape_body = (a: MutPtr<Malloc>, svars: Ptr<DeadList>, derived: Ptr<DeadList>, body: [Stmt]) i32 {
    acc := 0
    d := derived
    body.loop((h, i, st) {
        acc = acc.kv_kor(a.kv_escape_stmt(svars, d, st))
        d = a.escape_step(svars, d, st)
    })
    acc.kv_kor((body.len == 0).match ({
        true  => 0,
        false => a.kv_escape_trailing(svars, d, body[body.len - 1]),
    }))
}
kv_escape_check_func = (a: MutPtr<Malloc>, f: Func) i32 {
    svars := a.scope_params(f.params)
    svars.match ({
        .DeadNil     => 0,
        .DeadCons(c) => a.kv_escape_body(svars, a.dead_nil(), f.body),
    })
}
check_module_escape_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    acc := 0
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DFunc(f) => a.kv_escape_check_func(f),
            _         => 0,
        }))
    })
    acc
}
// Compatibility verdict. The positioned traversal above is authoritative; a parallel exact-count
// walk duplicated every scope-escape rule and made the diagnostic traverse each function twice.
check_module_escape* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    (a.check_module_escape_kind(decls) == 0).match ({ true => 0, false => 1 })
}
check_module_escape_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    pos := a.check_module_escape_kind(decls)
    (pos == 0).match ({
        true  => check_diagnostic_none(),
        false => {
            CheckDiagnostic(
                code: KESCAPE(),
                kind: "scope-escape",
                source_offset: pos,
                span_width: src.diagnostic_span_width(pos),
                count: 1,
                message: "value from scope `s` escapes its scope (its arena is freed on scope exit)",
                hint: "do not return a pointer from `s.acquire(...)`; copy the value out, or allocate in an outer scope",
            )
        },
    })
}
// EXHAUSTIVE `.Var(nm)` occurrence scan — true iff the name is read ANYWHERE in the expr tree. Every
// sub-expression-bearing shape is descended; missing one would risk a false positive (a real use gone
// unseen), so this is intentionally total. Binding-only name fields (arm.bind, loop idx/elem, lambda
// params, let/assign target names) are NOT reads and are correctly not matched here.
name_read_in_expr* = (nm: string_view, e: Ptr<Expr>) bool {
    load(e).match ({
        .Var(v)         => v.name == nm,
        .Bin(b)         => nm.name_read_in_expr(b.lhs) || nm.name_read_in_expr(b.rhs),
        .Call(c)        => nm.name_read_in_args(c.args),
        .MethodCall(mc) => nm.name_read_in_expr(mc.recv) || nm.name_read_in_args(mc.args),
        .Cond(d)        => nm.name_read_in_expr(d.c)
            || nm.name_read_in_expr(d.t)
            || nm.name_read_in_expr(d.e),
        .Member(m)      => nm.name_read_in_expr(m.obj),
        .Arrow(ar)      => nm.name_read_in_expr(ar.obj),
        .MakeEnum(mk)   => nm.name_read_in_expr(mk.payload),
        .MakeStruct(s)  => nm.name_read_in_inits(s.inits),
        .Match(m)       => nm.name_read_in_expr(m.subj) || nm.name_read_in_arms(m.arms),
        .SliceLit(sd)   => nm.name_read_in_args(sd.items),
        .Index(ix)      => nm.name_read_in_expr(ix.seq) || nm.name_read_in_expr(ix.idx),
        .Loop(l)        => nm.name_read_in_expr(l.seq) || nm.name_read_in_body(l.body),
        .Lambda(lm)     => nm.name_read_in_body(lm.body),
        .Block(b)       => nm.name_read_in_body(b.stmts),
        _               => false,
    })
}
name_read_in_args* = (nm: string_view, args: [Expr]) bool {
    f := false
    args.loop((h, i, ar) {
        f = nm.name_read_in_expr(ar.addr()).match ({ true => true, false => f })
    })
    f
}
name_read_in_inits = (nm: string_view, inits: [FieldInit]) bool {
    f := false
    inits.loop((h, i, fi) {
        f = nm.name_read_in_expr(fi.value).match ({ true => true, false => f })
    })
    f
}
name_read_in_arms = (nm: string_view, arms: [ArmData]) bool {
    f := false
    arms.loop((h, i, ar) {
        f = nm.name_read_in_expr(ar.body).match ({ true => true, false => f })
    })
    f
}
name_read_in_stmt = (nm: string_view, st: Stmt) bool {
    st.match ({
        .Let(l)      => nm.name_read_in_expr(l.value),
        .Assign(x)   => nm.name_read_in_expr(x.target) || nm.name_read_in_expr(x.value),
        .Return(r)   => nm.name_read_in_expr(r),
        .If(f)       => nm.name_read_in_expr(f.c)
            || nm.name_read_in_body(f.then)
            || nm.name_read_in_body(f.els),
        .While(w)    => nm.name_read_in_expr(w.c) || nm.name_read_in_body(w.body),
        .IndexSet(x) => nm.name_read_in_expr(x.seq)
            || nm.name_read_in_expr(x.idx)
            || nm.name_read_in_expr(x.value),
        .ExprStmt(e) => nm.name_read_in_expr(e),
    })
}
name_read_in_body* = (nm: string_view, body: [Stmt]) bool {
    f := false
    body.loop((h, i, st) {
        f = nm.name_read_in_stmt(st).match ({ true => true, false => f })
    })
    f
}
// a top-level `let` binding a FRESH owner that is never named again → the leak position (0 = none).
kv_leak_let* = (a: MutPtr<Malloc>, env: Env, body: [Stmt], k: i32, l: LetData) i32 {
    (is_owner_base(env.infer_expr(l.value).owner_base()) && l.value.leak_alias_value() == false).match ({
        true  => nm_read_or_leak(env, body, k, l),
        false => 0,
    })
}
kv_leak_stmt = (a: MutPtr<Malloc>, env: Env, body: [Stmt], k: i32, st: Stmt) i32 {
    st.match ({
        .Let(l) => a.kv_leak_let(env, body, k, l),
        _       => 0,
    })
}
kv_leak_check_func = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, f: Func) i32 {
    env := Env(
        vars: a.params_env(f.params),
        decls: decls,
        didx: idx,
        exp: f.ret,
        a: a,
    )
    acc := 0
    e := env
    f.body.loop((h, k, st) {
        acc = acc.kv_kor(a.kv_leak_stmt(e, f.body, k, st))
        e = a.extend_env(e, st)
    })
    acc
}
check_module_leak_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    acc := 0
    idx := a.build_decl_index(decls)
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DFunc(f) => a.kv_leak_check_func(decls, idx, f),
            _         => 0,
        }))
    })
    acc
}
check_module_leak* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    (a.check_module_leak_kind(decls) == 0).match ({ true => 0, false => 1 })
}
check_module_leak_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    pos := a.check_module_leak_kind(decls)
    (pos == 0).match ({
        true  => check_diagnostic_none(),
        false => {
            CheckDiagnostic(
                code: KLEAK(),
                kind: "leak",
                source_offset: pos,
                span_width: src.diagnostic_span_width(pos),
                count: 1,
                message: "owner created here is never released, moved, or returned before the function returns (a pure read like `o.get()` does not discharge it)",
                hint: "release it (`o.release_in(a)` / `o.drop_in(a)`), move it into a consuming call, or return it",
            )
        },
    })
}
check_module_addr_escape_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    idx := a.build_decl_index(decls)
    acc := 0
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DFunc(f) => a.ae_check_func(decls, idx, f),
            _         => 0,
        }))
    })
    acc
}
check_module_addr_escape* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    (a.check_module_addr_escape_kind(decls) == 0).match ({ true => 0, false => 1 })
}
check_module_addr_escape_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    pos := a.check_module_addr_escape_kind(decls)
    (pos == 0).match ({
        true  => check_diagnostic_none(),
        false => CheckDiagnostic(
            code: KESCAPE(),
            kind: "escape",
            source_offset: pos,
            span_width: src.diagnostic_span_width(pos),
            count: 1,
            message: "pointer to a local escapes the function (the local's frame is gone after return)",
            hint: "return the value by copy, or allocate it through an allocator/owner that outlives the call",
        ),
    })
}
check_module_send_kind = (a: MutPtr<Malloc>, decls: [Decl], mode: i32) i32 {
    acc := 0
    idx := a.build_decl_index(decls)
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DFunc(f) => a.sv_check_func(decls, idx, f, mode),
            _         => 0,
        }))
    })
    acc
}
check_module_send_rc_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    a.check_module_send_kind(decls, 0)
}
check_module_send_rc* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    (a.check_module_send_rc_kind(decls) == 0).match ({ true => 0, false => 1 })
}
check_module_send_rc_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    pos := a.check_module_send_rc_kind(decls)
    (pos == 0).match ({
        true  => check_diagnostic_none(),
        false => CheckDiagnostic(
            code: KOWNERSHIP(),
            kind: "sendable",
            source_offset: pos,
            span_width: src.diagnostic_span_width(pos),
            count: 1,
            message: "Rc<T> is not sendable across actors (its refcount is single-threaded)",
            hint: "use Arc<T> for a value shared between actors, or send a value/owned copy",
        ),
    })
}
check_module_send_mut_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    a.check_module_send_kind(decls, 1)
}
check_module_send_mut* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    (a.check_module_send_mut_kind(decls) == 0).match ({ true => 0, false => 1 })
}
check_module_send_mut_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    pos := a.check_module_send_mut_kind(decls)
    (pos == 0).match ({
        true  => check_diagnostic_none(),
        false => CheckDiagnostic(
            code: KOWNERSHIP(),
            kind: "sendable",
            source_offset: pos,
            span_width: src.diagnostic_span_width(pos),
            count: 1,
            message: "MutPtr<T> (a mutable reference) is not sendable across actors — it aliases mutable state the sender keeps, so the receiver mutating it is a data race",
            hint: "send a readonly `Ptr<T>` (a `frozen` value: deeply immutable, freely aliasable), move an `Own<T>` (an `owned` value, sent by move), or send a value copy",
        ),
    })
}
check_module_scratch_kind* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    acc := 0
    decls.loop((h, i, d) {
        acc = acc.kv_kor(d.match ({
            .DFunc(f) => a.sx_func_kind(f),
            _         => 0,
        }))
    })
    acc
}
check_module_scratch* = (a: MutPtr<Malloc>, decls: [Decl]) i32 {
    (a.check_module_scratch_kind(decls) == 0).match ({ true => 0, false => 1 })
}
check_module_scratch_diagnostic_from_source* = (a: MutPtr<Malloc>, decls: [Decl], src: string_view) CheckDiagnostic {
    packed := a.check_module_scratch_kind(decls)
    (packed == 0).match ({
        true  => check_diagnostic_none(),
        false => {
            code := packed & 63
            pos := packed >> 6
            w := src.diagnostic_span_width(pos)
            CheckDiagnostic(
                code: code,
                kind: "scratch-escape",
                source_offset: pos,
                span_width: w,
                count: 1,
                message: a.sx_message(code, a.sx_subject(src, pos, w)),
                hint: code.sx_hint(),
            )
        },
    })
}
