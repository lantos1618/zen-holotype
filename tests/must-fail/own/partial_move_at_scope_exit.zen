// a partially moved value reaching the end of its scope. nothing
// uses `p` after the move — the error is the drop itself.
//
// drop runs on `p` when main's scope ends, and `p.left` is not there
// to drop. the fix is to move the whole value or none of it, so the
// diagnostic points at the binding that is about to be dropped.

Buf = {
    id: i32,
}

Buf.impl(Drop, {
    drop = (self :: @Self) () { /* nothing to release: id is bytes */ }
})

Pair = {
    left :: Buf,
    right :: Buf,
}

main = (env: Env) Res<i32, IoError> {
    p ::= Pair(left: Buf(id: 1), right: Buf(id: 2));
    l = consume p.left;
    println("{}", l.id);
    Ok(0);
}
