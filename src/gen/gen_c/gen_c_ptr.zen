// src/gen/gen_c/gen_c_ptr.zen
// The raw floor: what a `Ptr<T>` member is in C.
// `mem_ptr.zen` writes nine signatures and no bodies, and says why:
// "the bodies belong to the backend: gen_c lowers a Ptr<T> to a `T*`
// and these members to dereference, indexed store, pointer arithmetic
// and memcpy. They are written as signatures because there is nothing
// underneath to write them in — this is the one module in std that
// cannot implement itself." So this file is those nine bodies, and it
// is not an optimisation: without it `Vec`, `String` and `str` have no
// way to touch memory at all.
// A `Ptr<T>` IS A `T *`. Sema has no pointer kind — a `Ptr<T>` arrives
// as an ordinary `Named` — but `gen_c_type.ctype` spells it as C's own
// pointer rather than as the struct the declaration describes, because
// `str`'s `data` field has to be the same word the runtime floor's
// `zg_str` holds. One representation and no second spelling.
// `to<U>` CHANGES THE ELEMENT TYPE, and that is the whole of it. Every
// later `read`, `write`, `bytes` and `copy_from` scales by the element,
// so a `to<U>` that answered with the receiver's own type would leave
// them scaling by `T` — `Arena.realloc` reads its `usize` header through
// exactly that, and as a no-op the read is ONE BYTE and every `Vec`
// whose buffer reaches 256 bytes silently loses the rows written before
// each grow. That bug cost this project a day and is recorded in
// docs/LEXER_BOOTSTRAP_FIXES.md §1; the `targs` read below is what
// stops it happening again.
// SCALING IS `sizeof` AND NOT A NUMBER THE COMPILER KNOWS. `bytes` is
// "the only way anything in std can ask how big a T is", and C already
// answers it — so the answer is spelled in the emitted program rather
// than computed here, and a layout this backend never modelled cannot
// disagree with the one `cc` chose.

ExprId, Access, Call, TypeId = std.ast
AllocError = std.mem
Vec = std.collections
str, String = std.text
TyId, TyNamed = sema.sema_ty
Checker, Ctx = sema.sema_check
CBackend = gen.gen_c.gen_c_state
untyped, unsupported = gen.gen_c.gen_c_report
sub = gen.gen_c.gen_c_mono
ctype, request_type = gen.gen_c.gen_c_type
write_qname = gen.gen_c.gen_c_layout
expr = gen.gen_c.gen_c_expr
Dest, deliver = gen.gen_c.gen_c_stmt

// recognising

// Both halves are asked: a user type declaring `read` is its own
// function, and a member of `Ptr` this file does not know is a refusal
// with a position rather than silence.
is_ptr_member* = (be :: CBackend, rty: TyId, name: str) bool {
    be.named_ptr(rty) && ptr_verb(name)
}

named_ptr = (be :: CBackend, rty: TyId) bool {
    be.check.types.at(rty).match({
        Named(n) => n.name.eq("Ptr"),
        _        => false,
    })
}

ptr_verb = (name: str) bool {
    name.is_in([
        "read", "write", "offset", "back", "bytes", "copy_from", "to", "is_null"
    ])
}

// The run's element type, which every member below scales by.
elem_of = (be :: CBackend, rty: TyId) Res<TyId, AllocError> {
    unknown = be.check.types.unknown().try();
    be.check.types.at(rty).match({
        Named(n) => Ok(n.args.get(0).match({ Ok(t) => t, None => unknown })),
        _        => Ok(unknown),
    })
}

// WHAT A `Ptr` MEMBER EVALUATES TO.
// A binding that holds one has no type unless this answers — and
// `src = p.to<u8>()` declared at the wrong element type is C POINTER
// ARITHMETIC AT THE WRONG STRIDE. It compiles, it warns at most, and
// `src.back(8)` moves back thirty-two bytes. The answers are the same
// ones the lowerings below write, read off the same two facts: the
// receiver's element type, and the written type argument.
PtrTypeSite = {
    c: Call,
    name: str,
    rty: TyId,
    ctx: Ctx,
    want: TyId,

    resolve = (self: @Self, be :: CBackend) Res<TyId, AllocError> {
        et = be.elem_of(self.rty).try();
        self.name.eq("read").match({
            true  => Ok(et),
            false => self.after_read(be),
        })
    }

    after_read = (self: @Self, be :: CBackend) Res<TyId, AllocError> {
        (self.name.eq("offset") || self.name.eq("back")).match({
            true  => Ok(self.rty),
            false => self.after_shift(be),
        })
    }

    after_shift = (self: @Self, be :: CBackend) Res<TyId, AllocError> {
        self.name.eq("bytes").match({
            true  => be.check.types.prim("usize"),
            false => self.after_bytes(be),
        })
    }

    after_bytes = (self: @Self, be :: CBackend) Res<TyId, AllocError> {
        self.name.eq("is_null").match({
            true  => be.check.types.prim("bool"),
            false => self.after_null(be),
        })
    }

    after_null = (self: @Self, be :: CBackend) Res<TyId, AllocError> {
        self.name.eq("to").match({
            false => be.check.types.prim("()"),
            true  => self.target_type(be),
        })
    }

    target_type = (self: @Self, be :: CBackend) Res<TyId, AllocError> {
        self.target_ptr(be).try().match({
            Ok(pt) => Ok(pt),
            None   => Ok(self.want),
        })
    }

    target_ptr = (self: @Self, be :: CBackend)
                 Res<Res<TyId>, AllocError> {
        self.c.targs.get(0).match({
            Ok(t) => self.ptr_of_written(be, t),
            None  => Ok(be.keep_ptr(self.want)),
        })
    }

    ptr_of_written = (self: @Self, be :: CBackend, t: TypeId)
                     Res<Res<TyId>, AllocError> {
        u = sub(be, be.check.type_from_ast(t, self.ctx).try()).try();
        be.check.types.at(self.rty).match({
            Named(n) => Ok(Ok(be.ptr_at(n, u).try())),
            _        => Ok(None),
        })
    }
}

ptr_member_type* = (
    be   :: CBackend,
    c    : Call,
    a    : Access,
    rty  : TyId,
    ctx  : Ctx,
    want : TyId
) Res<TyId, AllocError> {
    PtrTypeSite(c: c, name: a.name.text, rty: rty, ctx: ctx, want: want)
        .resolve(be)
}

// the nine

PtrUnitPolicy = PtrLower | PtrRefuse | PtrZero

ptr_unit_policy = (be: CBackend, et: TyId, name: str) PtrUnitPolicy {
    be.is_unit(et).match({
        false => PtrUnitPolicy.PtrLower,
        true  => name.is_in(["read", "write", "offset", "back"]).match({
            true  => PtrUnitPolicy.PtrRefuse,
            false => name.is_in(["bytes", "copy_from"]).match({
                true  => PtrUnitPolicy.PtrZero,
                false => PtrUnitPolicy.PtrLower,
            }),
        }),
    })
}

// Stable facts for one pointer member call. The backend and destination
// remain borrowed because both are mutated during emission.
PtrCall = {
    id: ExprId,
    site: PtrTypeSite,
    et: TyId,
    base: str,

    lower = (self: @Self, be :: CBackend, out :: String)
            Res<(), AllocError> {
        self.site.name.eq("read").match({
            true  => self.read(be, out),
            false => self.after_read(be, out),
        })
    }

    after_read = (self: @Self, be :: CBackend, out :: String)
                 Res<(), AllocError> {
        self.site.name.eq("write").match({
            true  => self.write(be, out),
            false => self.after_write(be, out),
        })
    }

    after_write = (self: @Self, be :: CBackend, out :: String)
                  Res<(), AllocError> {
        self.site.name.eq("offset").match({
            true  => self.shift(be, " + ", out),
            false => self.after_offset(be, out),
        })
    }

    after_offset = (self: @Self, be :: CBackend, out :: String)
                   Res<(), AllocError> {
        self.site.name.eq("back").match({
            true  => self.shift(be, " - ", out),
            false => self.after_back(be, out),
        })
    }

    after_back = (self: @Self, be :: CBackend, out :: String)
                 Res<(), AllocError> {
        self.site.name.eq("bytes").match({
            true  => self.byte_size(be, out),
            false => self.after_bytes(be, out),
        })
    }

    after_bytes = (self: @Self, be :: CBackend, out :: String)
                  Res<(), AllocError> {
        self.site.name.eq("copy_from").match({
            true  => self.copy_from(be, out),
            false => self.after_copy(be, out),
        })
    }

    after_copy = (self: @Self, be :: CBackend, out :: String)
                 Res<(), AllocError> {
        self.site.name.eq("is_null").match({
            true  => out.fmt("({} == NULL)", self.base),
            false => self.reinterpret(be, out),
        })
    }

    read = (self: @Self, be :: CBackend, out :: String)
           Res<(), AllocError> {
        self.run(be, out).try();
        out.add_bytes("[").try();
        self.index_arg(be, 0, out).try();
        out.add_bytes("]").try();
        Ok(())
    }

    write = (self: @Self, be :: CBackend, out :: String)
            Res<(), AllocError> {
        ptr ::= be.alloc.String().try();
        self.run(be, ptr).try();
        idx ::= be.alloc.String().try();
        self.index_arg(be, 0, idx).try();
        val ::= be.alloc.String().try();
        self.value_arg(be, 1, self.et, val).try();
        be.fmt("{}[{}] = {};\n", ptr.view(), idx.view(), val.view()).try();
        out.add_bytes("0")
    }

    run = (self: @Self, be :: CBackend, out :: String)
          Res<(), AllocError> {
        be.request_type(self.et).try();
        out.add_bytes(self.base).try();
        Ok(())
    }

    shift = (self: @Self, be :: CBackend, op: str, out :: String)
            Res<(), AllocError> {
        count ::= be.alloc.String().try();
        self.index_arg(be, 0, count).try();
        out.fmt("({}{}({}))", self.base, op, count.view())
    }

    byte_size = (self: @Self, be :: CBackend, out :: String)
                Res<(), AllocError> {
        self.scaled_bytes(be, 0, out)
    }

    copy_from = (self: @Self, be :: CBackend, out :: String)
                Res<(), AllocError> {
        from ::= be.alloc.String().try();
        self.value_arg(be, 0, self.site.rty, from).try();
        n ::= be.alloc.String().try();
        self.count_bytes(be, n).try();
        be.fmt(
            "memcpy((void *){}, (const void *)({}), {});\n",
            self.base,
            from.view(),
            n.view()
        ).try();
        out.add_bytes("0")
    }

    count_bytes = (self: @Self, be :: CBackend, out :: String)
                  Res<(), AllocError> {
        self.scaled_bytes(be, 1, out)
    }

    scaled_bytes = (self: @Self, be :: CBackend, i: usize,
                    out :: String) Res<(), AllocError> {
        be.request_type(self.et).try();
        count ::= be.alloc.String().try();
        self.index_arg(be, i, count).try();
        cty ::= be.alloc.String().try();
        be.ctype(self.et, cty).try();
        out.fmt("(({}) * sizeof({}))", count.view(), cty.view())
    }

    reinterpret = (self: @Self, be :: CBackend, out :: String)
                  Res<(), AllocError> {
        self.site.target_ptr(be).try().match({
            Ok(pt) => be.write_reinterpret(pt, self.base, out),
            None   => be.untyped(self.id, "to", out),
        })
    }

    index_arg = (self: @Self, be :: CBackend, i: usize, out :: String)
                Res<(), AllocError> {
        usize_ty = be.check.types.prim("usize").try();
        self.value_arg(be, i, usize_ty, out)
    }

    value_arg = (self: @Self, be :: CBackend, i: usize, want: TyId,
                 out :: String) Res<(), AllocError> {
        self.site.c.args.get(i).match({
            Ok(a) => expr(be, a.value, self.site.ctx, want, out),
            None  => out.add_bytes("0"),
        })
    }
}

lower_ptr_member* = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    a    : Access,
    rty  : TyId,
    ctx  : Ctx,
    want : TyId,
    out  :: String
)
                    Res<(), AllocError> {
    et = be.elem_of(rty).try();
    ptr_unit_policy(be, et, a.name.text).match({
        PtrRefuse => be.unsupported(
            id,
            "reading, writing, or shifting a Ptr<()>",
            out
        ),
        PtrZero   => be.lower_zero_run(c, a, rty, ctx, out),
        PtrLower  => be.lower_ptr_call(id, c, a, rty, et, ctx, want, out),
    })
}

lower_ptr_call = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    a    : Access,
    rty  : TyId,
    et   : TyId,
    ctx  : Ctx,
    want : TyId,
    out  :: String
) Res<(), AllocError> {
    base ::= be.alloc.String().try();
    be.address(a.base, rty, ctx, base).try();
    site = PtrTypeSite(c: c, name: a.name.text, rty: rty, ctx: ctx, want: want);
    PtrCall(id: id, site: site, et: et, base: base.view()).lower(be, out)
}

lower_zero_run = (
    be  :: CBackend,
    c   : Call,
    a   : Access,
    rty : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    be.deliver(a.base, ctx, rty, Dest.Discard).try();
    a.name.text.eq("bytes").match({
        true  => be.discard_ptr_arg(
            c,
            0,
            be.check.types.prim("usize").try(),
            ctx
        ),
        false => {
            be.discard_ptr_arg(c, 0, rty, ctx).try();
            be.discard_ptr_arg(c, 1, be.check.types.prim("usize").try(), ctx)
        },
    }).try();
    out.add_bytes("0")
}

discard_ptr_arg = (
    be   :: CBackend,
    c    : Call,
    i    : usize,
    want : TyId,
    ctx  : Ctx
) Res<(), AllocError> {
    c.args.get(i).match({
        Ok(a) => be.deliver(a.value, ctx, want, Dest.Discard),
        None  => Ok(()),
    })
}

// The pointer itself. Parenthesised because the receiver is an
// arbitrary expression and every use below indexes or offsets it.
address = (
    be   :: CBackend,
    base : ExprId,
    rty  : TyId,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    out.add_bytes("(").try();
    expr(be, base, ctx, rty, out).try();
    out.add_bytes(")").try();
    Ok(());
}

// A `to<U>` with no written argument can only mean the expectation, and
// only when that expectation is a `Ptr` — anything else is a type the
// backend would be inventing.
keep_ptr = (be :: CBackend, want: TyId) Res<TyId> {
    be.named_ptr(want).match({ true => Ok(want), false => None })
}

// THE SAME `Ptr` DECLARATION AT ANOTHER ELEMENT TYPE. `to<U>` builds one
// and `gen_c_alloc.zen`'s `create<T>` builds the same one, so the
// interning is written once — two spellings of it are two `TyId`s for
// one type, and a `Ptr<T>` that does not compare equal to the `Ptr<T>` a
// callee declared is a cast this backend would not know it needed.
ptr_at* = (be :: CBackend, n: TyNamed, elem: TyId) Res<TyId, AllocError> {
    args ::= be.alloc.Vec<TyId>();
    args.add(elem).try();
    qname ::= be.alloc.String().try();
    be.write_qname(qname, n).try();
    intern_ptr(be.check, n, qname.view(), args)
}

intern_ptr = (c :: Checker, n: TyNamed, qname: str, args: Vec<TyId>)
             Res<TyId, AllocError> {
    c.types.named(n.decl, qname, n.name, args)
}

write_reinterpret = (be :: CBackend, pt: TyId, base: str, out :: String)
                    Res<(), AllocError> {
    be.request_type(pt).try();
    cty ::= be.alloc.String().try();
    be.ctype(pt, cty).try();
    out.fmt("(({}){base})", cty.view())
}

// `null_ptr<T>()`
// A free function with no body, for the same reason the nine above have
// none: "an empty collection owns no pages, so its data field holds a
// null Ptr until the first grow". Its type comes from the expectation,
// which every call site has — `data :: Ptr<T> = null_ptr<T>()` is the
// only shape in the library.

is_null_ptr* = (name: str) bool { name.eq("null_ptr") }

lower_null_ptr* = (be :: CBackend, id: ExprId, want: TyId, out :: String)
                  Res<(), AllocError> {
    be.named_ptr(want).match({
        false => be.untyped(id, "null_ptr", out),
        true  => be.write_null(want, out),
    })
}

write_null = (be :: CBackend, want: TyId, out :: String)
             Res<(), AllocError> {
    be.request_type(want).try();
    cty ::= be.alloc.String().try();
    be.ctype(want, cty).try();
    out.fmt("(({})NULL)", cty.view())
}
