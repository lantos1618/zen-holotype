// a value CONSTRUCTED in the loop body and consumed in the same
// iteration. the binding is fresh on every pass, so the back edge
// carries nothing dead and this must keep compiling.
//
// the reject side is must-fail/own/consume_in_loop_body.zen, where
// the binding is declared OUTSIDE the loop. the difference between
// the two files is one line, and a checker that gets it wrong in
// either direction is useless.

Buf = {
    id: i32,
}

Buf.impl(Drop, {
    drop = (self :: @Self) () { /* nothing to release: id is bytes */ }
})

main = (env: Env) Res<i32, IoError> {
    Range(0, 3).loop((h, v) {
        f = Buf(id: 1);
        g = consume f;
        println("{}", g.id)
    })
    Ok(0);
}
