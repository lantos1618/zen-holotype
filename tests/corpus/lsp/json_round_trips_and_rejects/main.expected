-- the three literals
null -> null
true -> true
false -> false
-- numbers keep their lexeme
0 -> 0
-0 -> -0
12 -> 12
1.5 -> 1.5
1e10 -> 1e10
-2.5E-3 -> -2.5E-3
1E+2 -> 1E+2
-- strings and escapes
"" -> ""
"plain" -> "plain"
"q\"b\\s\/" -> "q\"b\\s/"
"\n\r\t\b\f" -> "\n\r\t\u0008\u000c"
"\u0000\u001f" -> "\u0000\u001f"
-- \u, all four widths
"\u0041" -> "A"
"\u00e9" -> "é"
"\u4e2d" -> "中"
"\ud83d\ude00" -> "😀"
-- raw utf-8 passes through untouched
"é中😀" -> "é中😀"
"\ud83d\ude00y" -> "😀y"
"😀y" -> "😀y"
-- containers, empty and nested
[] -> []
{} -> {}
[1,2,[3,[]]] -> [1,2,[3,[]]]
{"a":1,"b":{},"c":[{}]} -> {"a":1,"b":{},"c":[{}]}
-- whitespace is insignificant
<space tab cr lf around [1,2,{k:null}]> -> [1,2,{"k":null}]
-- reading a field
{"a":1,"b":2} . b -> 2
{"a":1} . zzz -> absent
{"d":1,"d":2} . d -> 2
[1,2] . a -> absent
-- rejected, and the byte says where
 !! ended inside a value at byte 0
01 !! trailing bytes at byte 1
1. !! not a JSON number at byte 2
.5 !! not a JSON number at byte 0
1e !! not a JSON number at byte 2
- !! ended inside a value at byte 1
tru !! unexpected byte at byte 0
nul1 !! unexpected byte at byte 0
"unterminated !! ended inside a value at byte 13
"\q" !! bad escape at byte 2
"\u00" !! bad escape at byte 3
"\ud83d" !! bad escape at byte 7
"\ude00" !! bad escape at byte 3
{"a"} !! unexpected byte at byte 4
{"a":} !! not a JSON number at byte 5
[1,] !! not a JSON number at byte 3
[1 !! ended inside a value at byte 2
{}x !! trailing bytes at byte 2
{} {} !! trailing bytes at byte 3
