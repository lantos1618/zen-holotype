// AN ANNOTATED NO-RANGE LOOP STANDS AT ITS DECLARATION -- `r: Res<i64> =
// loop((h){ h.break(-7); })` compiles AND prints -7.
//
// Before #784 was fixed there were two spellings and neither worked: the
// unannotated form settled its payload at usize and printed
// 18446744073709551609, and the ANNOTATED form failed `cc` with
// "incompatible types when assigning to type 'ResI...i64' from type
// 'ResI...usize'" -- the destination's declared type never reached the
// loop call, so the result temporary stood at whatever the break
// arguments reconstructed. This file pins the annotated face: the
// declaration decides when it names a concrete element, the break
// arguments decide only what the declaration leaves open.
//
// breaks this: dropping the context's want between member resolution and
// call_fn, so `found: Res<usize> = loop(..)` compiled against a payload
// nothing agreed to (43 corpus tests reddened the first time that
// happened).
//
// issue: 784

main = (env: Env) Res<i32> {
    r: Res<i64> = loop((h) { h.break(-7); });
    r.match({ Ok(v) => println("ann {}", v), None => println("none") });

    u: Res<usize> = loop((h) { h.break(3); });
    u.match({ Ok(v) => println("usz {}", v), None => println("none") });
    Ok(0);
}
