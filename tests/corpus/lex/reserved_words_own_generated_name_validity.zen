// std.lex owns both token reservation and the names generated Zen may use.
// The completion list iterates the same table, so its order and extent are
// observable here as well as through the lexer.

KEYWORD_COUNT, keyword_at, is_keyword, is_zen_name = std.lex

main = (env: Env) i32 {
    println("count {}", KEYWORD_COUNT);
    Range(0, KEYWORD_COUNT).loop((h, i) {
        keyword_at(i).match({
            Ok(keyword) => println(
                "keyword {} {}",
                keyword.text,
                is_keyword(keyword.text)
            ),
            None     => println("missing"),
        });
    });
    println(
        "reserved {} {} {}",
        is_zen_name("consume"),
        is_zen_name("false"),
        is_zen_name("true")
    );
    println(
        "identifiers {} {} {} {} {}",
        is_zen_name("impl"),
        is_zen_name("match"),
        is_zen_name("loop"),
        is_zen_name("struct"),
        is_zen_name("enum")
    );
    println("invalid {} {}", is_zen_name("two words"), is_zen_name("9lives"));
    0
}
