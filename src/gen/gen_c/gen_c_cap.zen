// src/gen/gen_c/gen_c_cap.zen
// The members whose BODY IS THE BACKEND.
//
// `Mem.alloc`, `Mem.page`, `Mem.release` and the four `Fs` declares are
// written in std with a signature and no body — env.zen says why: they
// are the authority itself. "A capability's floor is the target
// language's", and for C that floor is `malloc`, `free`, `stat`,
// `fopen`. `gen_c_print.zen` says the same about `Console.println`;
// this file writes the memory three, `gen_c_fs.zen` the other four.
//
// NOT A SPECIAL CASE BOLTED ONTO MEMBER DISPATCH — the SAME rule
// `println` obeys, one level lower: a bodiless member is either a
// capability whose floor this file writes, or a refusal
// `gen_c_member.zen` reports by name. Nothing else can be true of it —
// a symbol for a bodiless declaration is a symbol nothing defines.
//
// WHY THE BACKEND MAY WRITE AN ArenaState'S FIELDS. `mem_arena.zen`
// keeps `ArenaState` unexported ("what an arena is made of is not part
// of what an arena is"), yet this file writes three of its fields
// anyway — licensed by one thing: the memory ENTERS THE PROGRAM here.
// `Mem.alloc` is the only door; the alternative is a second, hidden,
// hand-written C arena std would have to agree with.

ExprId, Decl, Struct, Member = std.ast
Function, Access, Call = std.ast
AllocError = std.mem
Vec = std.collections
str, String = std.text
TyId, TyNamed = sema.sema_ty
decl_at = sema.sema_def
Ctx = sema.sema_check
Inst = sema.sema_inst
sym_member, sym_variant, sym_gen, RES_PATH = gen.gen_name
CBackend = gen.gen_c.gen_c_state
unsupported = gen.gen_c.gen_c_report
sub = gen.gen_c.gen_c_mono
enter_struct_tparams, leave_tparams = gen.gen_c.gen_c_mono
ctype, field_type, request_type, declared_ret = gen.gen_c.gen_c_type
decl_ctx, decl_inst = gen.gen_c.gen_c_type
expr = gen.gen_c.gen_c_expr
declare_temp, enum_path, payload_type, is_variant = gen.gen_c.gen_c_flow
lower_probe, lower_write, lower_read, lower_remove, lower_lock, lower_unlock = gen.gen_c.gen_c_fs
close_else, close_brace, open_null_test = gen.gen_c.gen_c_fs
lower_stdin_read = gen.gen_c.gen_c_stdin
lower_env_var = gen.gen_c.gen_c_env
lower_console_print, is_console_print = gen.gen_c.gen_c_print
is_defer, lower_defer = gen.gen_c.gen_c_scope
lower_clock_read = gen.gen_c.gen_c_clock
lower_sleep = gen.gen_c.gen_c_threads

// -----------------------------------------------------------------
// which members these are
// -----------------------------------------------------------------

// A capability is recognised by the RECEIVER'S TYPE and the member's
// name together, not by "has no body" alone — that's `gen_c_member.zen`'s
// question, and answering it again here would make any bodiless member
// anywhere silently become one of these.
// `Clock` IS IN THE CHAIN, second from the top: a bodiless member whose
// receiver's owner is `Clock` is the backend's to lower, and anything
// else falls through to the `Fs` question below. Leaving it out here --
// as a first cut did -- makes its twin below DEAD
// CODE: every `env.clock.*` site fell through to `FatSlot`, the vtable
// slot of an `Env` field the entry never populates, and the first read
// jumped through NULL. The program compiled, so only running it showed
// the fault -- the exact reason the corpus runs its programs.
is_capability* = (be :: CBackend, rty: TyId, name: str) bool {
    owner_of(be, rty).eq("Mem").match({
        true  => mem_verb(name),
        false => be.is_clock_capability(rty, name),
    })
}

is_fs_capability = (be :: CBackend, rty: TyId, name: str) bool {
    owner_of(be, rty).eq("Fs").match({
        true  => fs_verb(name),
        false => be.is_lock_unlock(rty, name),
    })
}

// `Lock.unlock` IS THE LOCK'S OWN RELEASE, not a new capability root:
// the fd belongs to the Lock, and so does the one door that closes it.
// The receiver type is the whole of the test, exactly as `Stdin.read`
// is told from `Fs.read` — a name two types answer to names neither.
is_lock_unlock = (be :: CBackend, rty: TyId, name: str) bool {
    owner_of(be, rty).eq("Lock").match({
        true  => name.eq("unlock"),
        false => be.is_env_capability(rty, name),
    })
}

// `Env.var`, and the NAME is half the test: `Env` declares `args` and
// `spawn` bodiless too, and those are stage-5 signatures with no floor
// — claiming the owner alone would turn a "not implemented yet" into a
// call to C that does not exist.
is_env_var = (be :: CBackend, rty: TyId, name: str) bool {
    owner_of(be, rty).eq("Env") && name.eq("var")
}

// AND THE CHAIN CONTINUES: `Console.println`, `Stdin.read` and
// `Scope.defer` are capabilities too, so a receiver that is not `Env`
// must still be offered to them. Answering `is_env_var` alone here
// dropped all three out of `MethodKind.Capability`.
is_env_capability = (be :: CBackend, rty: TyId, name: str) bool {
    be.is_env_var(rty, name) || be.is_console_capability(rty, name)
}

// `Console.println` AND `Console.errorln` ARE OF THESE: floor is
// `fwrite`, bodiless for the same reason `Fs.read` is, and
// `gen_c_print.zen` writes them — one stream each. Reaches this file
// only when the receiver was WRITTEN (`env.out.println(..)`) — the
// sugar names no function and is recognised one level up. Without this
// it fell through to `lower_fat_call`: `args: ...` has no C spelling,
// so the slot's parameter came out as `ctype`'s `int` fallback and
// `cc` rejected every argument handed to it.
is_clock_capability = (be :: CBackend, rty: TyId, name: str) bool {
    owner_of(be, rty).eq("Clock").match({
        true  => clock_verb(name),
        false => be.is_threads_capability(rty, name),
    })
}

// `Threads.sleep` IS ONE MORE LINK, the same test one receiver down,
// and `Fs` STAYS BETWEEN Threads and Env: a receiver that is neither
// Clock nor Threads nor Console/Stdin/Scope must still reach the file
// questions before `Env.var`. Dropping that Fs link -- as a first cut
// did -- dropped every `env.fs.*` site out of the chain entirely.
// Without the Threads link itself, `env.threads.sleep(10)` fell through
// to the fat branch and emitted a vtable call on a record no lowering
// constructs -- a NULL slot at run time.
is_threads_capability = (be :: CBackend, rty: TyId, name: str) bool {
    owner_of(be, rty).eq("Threads").match({
        true  => threads_verb(name),
        false => be.is_fs_capability(rty, name),
    })
}

// `Console.println` IS ONE OF THESE: floor is `fwrite`, bodiless for
// the same reason `Fs.read` is, and `gen_c_print.zen` writes it. Reaches
// this file only when the receiver was WRITTEN (`env.out.println(..)`)
// — the sugar names no function and is recognised one level up.
// Without this it fell through to `lower_fat_call`: `args: ...` has no
// C spelling, so the slot's parameter came out as `ctype`'s `int`
// fallback and `cc` rejected every argument handed to it.
//
// `Scope.defer` IS THE LAST LINK, NOT A PEER of the ones above — a
// capability by the same test, but its receiver is a value the program
// made rather than one `Env` handed it, so owner alone can't recognise
// it and `is_defer` asks its own question.
is_console_capability = (be :: CBackend, rty: TyId, name: str) bool {
    (owner_of(be, rty).eq("Console") && is_console_print(name))
        || be.is_stdin_read(rty, name)
        || be.is_defer(rty, name)
}

// `Stdin.read`, and the owner is the whole of the test: `Fs` declares a
// `read` too, and the two are different lowerings over different floors.
// Asking the name alone would send `env.in.read(..)` into the one that
// wants a path.
is_stdin_read = (be :: CBackend, rty: TyId, name: str) bool {
    owner_of(be, rty).eq("Stdin") && name.eq("read")
}

owner_of = (be :: CBackend, rty: TyId) str {
    be.check.types.at(rty).match({
        Named(n) => n.name,
        _        => "",
    })
}

mem_verb = (name: str) bool {
    name.is_in(["alloc", "page", "release"])
}

// `read` is in the set so that it reaches `gen_c_fs.lower_read`, which
// allocates its buffer through the `Alloc` it was handed, rather than
// `gen_c_member.zen`'s refusal for a member with no body. `remove` is
// there for the same reason: its lowering lives in `gen_c_fs` too.
// `lock` joins them at its own floor: an exclusive-create is a
// filesystem question, and the lock it answers belongs to `Fs`.
fs_verb = (name: str) bool {
    name.is_in(["exists", "is_dir", "write", "read", "remove", "lock"])
}

clock_verb = (name: str) bool {
    name.is_in(["since_start", "unix"])
}

threads_verb = (name: str) bool {
    name.eq("sleep")
}

// -----------------------------------------------------------------
// the entry point
// -----------------------------------------------------------------

// `Scope.defer` takes the short path because its whole lowering is
// about the CLOSURE it was handed — the declared types the four below
// need say nothing about that. `scope.zen` declares it `= sig` with no
// body: "the compiler supplies the block".
lower_capability* = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    mi  : usize,
    f   : Function,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    be.is_defer(rty, a.name.text).match({
        true  => be.lower_defer(id, c, a, ctx, out),
        false => be.lower_env_capability(id, c, a, rty, mi, f, ctx, out),
    })
}

lower_env_capability = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    mi  : usize,
    f   : Function,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    ret = be.cap_ret(rty, mi, f).try();
    be.request_type(ret).try();
    // `Fs.read`'s FIRST written parameter is an `Alloc` per its
    // DECLARED type — the argument arrives as an Arena, and lowering it
    // at its own type would hand the buffer's owner an arena where the
    // two-word handle belongs. Law 7: the declaration decides.
    aty = be.cap_param(rty, mi, f).try();
    verb(be, id, c, a, rty, ret, aty, ctx, out)
}

cap_param = (be :: CBackend, rty: TyId, mi: usize, f: Function)
            Res<TyId, AllocError> {
    sctx = be.check.self_ctx(mi, rty).try();
    f.params.get(1).match({
        None  => be.check.types.unknown(),
        Ok(p) => be.check.param_type(p, sctx),
    })
}

// `Stdin.read` IS TESTED BEFORE THE NAME CHAIN and not inside it: the
// chain below asks names only, and `read` is a name two capabilities
// answer to. `Lock.unlock` takes the same seat beside it — the chain
// would fall off its end on `unlock` and answer a stat — so the
// RECEIVER'S OWNER decides here, and only then does a name get read.
verb = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    ret : TyId,
    aty : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    be.is_stdin_read(rty, a.name.text).match({
        true  => be.lower_stdin_read(id, c, ret, aty, ctx, out),
        false => be.lock_verb(id, c, a, rty, ret, aty, ctx, out),
    })
}

// `Lock.unlock` IS THE LOCK'S OWN RELEASE, tested by owner before any
// name is read, for the reason `is_stdin_read` states above it. A Lock
// has exactly one verb; everything else falls through to the chains.
lock_verb = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    ret : TyId,
    aty : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    owner_of(be, rty).eq("Lock").match({
        true  => be.lower_unlock(id, c, a, rty, ret, ctx, out),
        false => be.env_verb(id, c, a, rty, ret, aty, ctx, out),
    })
}

// `Env.var` IS TESTED BY OWNER AND NAME TOGETHER, beside `Stdin.read`
// and for the same reason: the chain below asks names only, and `var`
// on anything else is not this.
env_verb = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    ret : TyId,
    aty : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    be.is_env_var(rty, a.name.text).match({
        true  => be.lower_env_var(c, ret, ctx, out),
        false => be.clock_verb(id, c, a, rty, ret, aty, ctx, out),
    })
}

// `Clock`'s two members take no argument and answer with a value the
// floor builds — the shortest chain there is. `is_clock_capability` has
// already answered for the receiver's type; this asks only which of the
// two authorities was named.
clock_verb = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    ret : TyId,
    aty : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    owner_of(be, rty).eq("Clock").match({
        true  => be.lower_clock_read(c, a.name.text, ret, ctx, out),
        false => be.threads_step(id, c, a, rty, ret, aty, ctx, out),
    })
}

// `Threads.sleep` takes one argument and answers unit — the clock's
// shape with nothing to rebuild.
threads_step = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    ret : TyId,
    aty : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    owner_of(be, rty).eq("Threads").match({
        true  => be.lower_sleep(c, ret, ctx, out),
        false => be.console_verb(id, c, a, rty, ret, aty, ctx, out),
    })
}

console_verb = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    ret : TyId,
    aty : TyId,
    ctx : Ctx,
    out :: String
)
               Res<(), AllocError> {
    is_console_print(a.name.text).match({
        true  => lower_console_print(be, c, a.name.text, ret, ctx, out),
        false => be.verb_1(id, c, a, rty, ret, aty, ctx, out),
    })
}

verb_1 = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    ret : TyId,
    aty : TyId,
    ctx : Ctx,
    out :: String
)
         Res<(), AllocError> {
    a.name.text.eq("alloc").match({
        true  => be.lower_alloc(id, a, rty, ret, ctx, out),
        false => verb_2(be, id, c, a, rty, ret, aty, ctx, out),
    })
}

verb_2 = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    ret : TyId,
    aty : TyId,
    ctx : Ctx,
    out :: String
)
         Res<(), AllocError> {
    a.name.text.eq("page").match({
        true  => be.lower_page(id, c, ret, ctx, out),
        false => verb_3(be, id, c, a, rty, ret, aty, ctx, out),
    })
}

verb_3 = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    ret : TyId,
    aty : TyId,
    ctx : Ctx,
    out :: String
)
         Res<(), AllocError> {
    a.name.text.eq("release").match({
        true  => be.lower_release(c, ctx, out),
        false => verb_4(be, id, c, a, rty, ret, aty, ctx, out),
    })
}

verb_4 = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    ret : TyId,
    aty : TyId,
    ctx : Ctx,
    out :: String
)
         Res<(), AllocError> {
    a.name.text.eq("write").match({
        true  => be.lower_write(id, c, ret, ctx, out),
        false => verb_5(be, id, c, a, ret, aty, ctx, out),
    })
}

verb_5 = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    ret : TyId,
    aty : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    a.name.text.eq("read").match({
        true  => be.lower_read(id, c, ret, aty, ctx, out),
        false => verb_6(be, id, c, a, ret, ctx, out),
    })
}

// `lock` ANSWERS BEFORE THE PROBE FALLTHROUGH, and the fallthrough is
// the reason this link exists: the chain ends in `lower_probe`, which
// answers every remaining NAME as a stat question. Without this link
// `env.fs.lock(p)` lowered as a probe — compiled clean, answered wrong.
verb_6 = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    ret : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    a.name.text.eq("lock").match({
        true  => be.lower_lock(id, c, ret, ctx, out),
        false => verb_7(be, id, c, a, ret, ctx, out),
    })
}

verb_7 = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    ret : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    a.name.text.eq("remove").match({
        true  => be.lower_remove(id, c, ret, ctx, out),
        false => be.lower_probe(c, a.name.text, ctx, out),
    })
}

// The declared return type, read in the module that declares the
// member with `@Self` bound to the receiver — the same two steps
// `gen_c_member.method_sig` takes for a parameter, and for the same
// reason: `@Self` is a written type only that query answers.
cap_ret = (be :: CBackend, rty: TyId, mi: usize, f: Function)
          Res<TyId, AllocError> {
    sctx     = be.check.self_ctx(mi, rty).try();
    declared = be.declared_ret(f, sctx).try();
    sub(be, declared)
}

// -----------------------------------------------------------------
// `env.mem.alloc()` — where an arena comes from
//
// An `ArenaState` on the C heap, an `Arena` holding its address. State
// is one `malloc`, never freed: `Arena.drop` releases the PAGES, and
// the state is the handle every copy of the arena shares — freeing it
// would invalidate a value that copies freely by design.
// -----------------------------------------------------------------

lower_alloc = (
    be  :: CBackend,
    id  : ExprId,
    a   : Access,
    rty : TyId,
    ret : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    be.field_of(ret, "state").try().match({
        None    => be.unsupported(id, "an Arena with no state field", out),
        Ok(pty) => be.with_state(id, a, rty, ret, pty, ctx, out),
    })
}

with_state = (
    be  :: CBackend,
    id  : ExprId,
    a   : Access,
    rty : TyId,
    ret : TyId,
    pty : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    be.pointee(pty).match({
        None     => be.unsupported(
            id,
            "an Arena whose state is not a pointer",
            out
        ),
        Ok(cell) => be.write_arena(a, rty, ret, pty, cell, ctx, out),
    })
}

write_arena = (
    be   :: CBackend,
    a    : Access,
    rty  : TyId,
    ret  : TyId,
    pty  : TyId,
    cell : TyId,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    recv ::= be.alloc.String().try();
    expr(be, a.base, ctx, rty, recv).try();
    tmp ::= be.alloc.String().try();
    sym_gen(tmp, "t", be.next_tmp()).try();
    be.declare_temp(pty, tmp.view()).try();
    be.write_malloc(tmp.view(), cell, "").try();
    be.set_field(tmp.view(), cell, "mem", recv.view()).try();
    be.set_field(tmp.view(), cell, "head", "NULL").try();
    be.set_field(tmp.view(), cell, "next", "0").try();
    cty ::= be.alloc.String().try();
    be.ctype(ret, cty).try();
    state ::= be.alloc.String().try();
    state.sym_member("state").try();
    out.fmt("(({}){ .{} = {} })", cty.view(), state.view(), tmp.view())
}

write_malloc = (be :: CBackend, tmp: str, cell: TyId, extra: str)
               Res<(), AllocError> {
    cty ::= be.alloc.String().try();
    be.ctype(cell, cty).try();
    be.fmt("{tmp} = ({} *)malloc(sizeof({}){extra});\n", cty.view(), cty.view())
}

// One field of the freshly-made state, and nothing at all when the
// declaration has no such field: std owns the shape, so a field it
// drops is a line this file stops writing rather than a diagnostic.
set_field = (be :: CBackend, tmp: str, cell: TyId, name: str, value: str)
            Res<(), AllocError> {
    be.field_of(cell, name).try().match({
        None  => Ok(()),
        Ok(_) => be.write_arrow_set(tmp, name, value),
    })
}

write_arrow_set = (be :: CBackend, tmp: str, name: str, value: str)
                  Res<(), AllocError> {
    sym ::= be.alloc.String().try();
    sym_member(sym, name).try();
    be.fmt("{tmp}->{} = {value};\n", sym.view())
}

// -----------------------------------------------------------------
// `mem.page(size, prev)` — where a page comes from
//
// One run of `sizeof(Page) + size` bytes, with the `Page` header
// written into its own first bytes. The header costs no second
// allocation, which is what lets an arena describe a page without
// owning memory it has not been given yet.
// -----------------------------------------------------------------

lower_page = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    ret : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    be.payload_type(ret, "Ok").match({
        None    => be.unsupported(
            id,
            "Mem.page must return a Res<Ptr<Page>, E>",
            out
        ),
        Ok(pty) => be.page_cell(id, c, ret, pty, ctx, out),
    })
}

page_cell = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    ret : TyId,
    pty : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    be.pointee(pty).match({
        None     => be.unsupported(
            id,
            "Mem.page must return a Res<Ptr<Page>, E>",
            out
        ),
        Ok(cell) => be.write_page(c, ret, cell, ctx, out),
    })
}

write_page = (
    be   :: CBackend,
    c    : Call,
    ret  : TyId,
    cell : TyId,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    usize_ty = be.check.types.prim("usize").try();
    size ::= be.alloc.String().try();
    be.arg_text(c, 0, usize_ty, ctx, size).try();
    prev ::= be.alloc.String().try();
    be.prev_text(c, ctx, prev).try();
    szt ::= be.alloc.String().try();
    sym_gen(szt, "t", be.next_tmp()).try();
    raw ::= be.alloc.String().try();
    sym_gen(raw, "t", be.next_tmp()).try();
    dst ::= be.alloc.String().try();
    sym_gen(dst, "t", be.next_tmp()).try();
    be.declare_temp(usize_ty, szt.view()).try();
    be.fmt("unsigned char *{};\n", raw.view()).try();
    be.declare_temp(ret, dst.view()).try();
    be.set_line(szt.view(), size.view()).try();
    be.write_page_malloc(raw.view(), cell, szt.view()).try();
    be.open_null_test(raw.view()).try();
    be.write_assign_err(ret, "OutOfMemory", dst.view()).try();
    be.close_else().try();
    be.write_page_header(raw.view(), cell, szt.view(), prev.view()).try();
    be.write_page_ok(ret, cell, raw.view(), dst.view()).try();
    be.close_brace().try();
    out.add_bytes(dst.view())
}

write_page_malloc = (be :: CBackend, raw: str, cell: TyId, szt: str)
                    Res<(), AllocError> {
    cty ::= be.alloc.String().try();
    be.ctype(cell, cty).try();
    be.fmt("{raw} = (unsigned char *)malloc(sizeof({}) + {szt});\n", cty.view())
}

// The three fields of the header, written THROUGH the raw pointer:
// `base` is the first byte past the header, which is what makes the
// page describe itself.
write_page_header = (
    be   :: CBackend,
    raw  : str,
    cell : TyId,
    szt  : str,
    prev : str
) Res<(), AllocError> {
    cty ::= be.alloc.String().try();
    be.ctype(cell, cty).try();
    cast ::= be.alloc.String().try();
    cast.fmt("(({} *){raw})", cty.view()).try();
    base ::= be.alloc.String().try();
    base.fmt("({raw} + sizeof({}))", cty.view()).try();
    be.set_field(cast.view(), cell, "prev", prev).try();
    be.set_field(cast.view(), cell, "base", base.view()).try();
    be.set_field(cast.view(), cell, "size", szt).try();
    Ok(());
}

write_page_ok = (be :: CBackend, ret: TyId, cell: TyId, raw: str, dst: str)
                Res<(), AllocError> {
    value ::= be.alloc.String().try();
    value.add_bytes("(").try();
    be.ctype(cell, value).try();
    value.fmt(" *){raw}").try();
    be.write_assign_ok(ret, value.view(), dst).try();
    Ok(());
}

// `mem.release(page)` — one `free`, and the unit value every other
// void-returning lowering writes.
lower_release = (be :: CBackend, c: Call, ctx: Ctx, out :: String)
                Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    page ::= be.alloc.String().try();
    be.arg_text(c, 0, unknown, ctx, page).try();
    be.fmt("free((void *)({}));\n", page.view()).try();
    out.add_bytes("0")
}

// The `prev` argument, or a null pointer when the call left it out.
prev_text = (be :: CBackend, c: Call, ctx: Ctx, out :: String)
            Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    c.args.get(1).match({
        None  => out.add_bytes("NULL"),
        Ok(a) => expr(be, a.value, ctx, unknown, out),
    })
}

// -----------------------------------------------------------------
// the values these lowerings assign
// -----------------------------------------------------------------

// `None` — the absence half of a `Res<T>`, which has no payload to
// write and no reason to name. `Err` is the other enum's word and
// `write_assign_err` is where it is spelled.
write_assign_none* = (be :: CBackend, ret: TyId, dst: str)
                    Res<(), AllocError> {
    value ::= be.alloc.String().try();
    be.write_res_head(ret, "None", value).try();
    value.add_bytes(" })").try();
    be.set_line(dst, value.view())
}

write_assign_ok_unit* = (be :: CBackend, ret: TyId, dst: str)
                       Res<(), AllocError> {
    value ::= be.alloc.String().try();
    be.write_res_head(ret, "Ok", value).try();
    value.add_bytes(" })").try();
    be.set_line(dst, value.view())
}

write_assign_ok* = (be :: CBackend, ret: TyId, payload: str, dst: str)
                  Res<(), AllocError> {
    value ::= be.alloc.String().try();
    be.write_res_head(ret, "Ok", value).try();
    value.add_bytes(", .zg_data.").try();
    sym_member(value, "Ok").try();
    value.fmt(" = {payload} })").try();
    be.set_line(dst, value.view())
}

// `Err(<the variant this ordinal names>)`, read out of the RETURN
// type's own error enum. A set with no such variant gets a bare `Err`,
// which is wrong only for a std that has already changed underneath
// this file.
write_assign_err* = (be :: CBackend, ret: TyId, name: str, dst: str)
                   Res<(), AllocError> {
    value ::= be.alloc.String().try();
    be.write_res_head(ret, "Err", value).try();
    be.payload_type(ret, "Err").match({
        None    => Ok(()),
        Ok(ety) => be.write_err_payload(ety, name, value),
    }).try();
    value.add_bytes(" })").try();
    be.set_line(dst, value.view())
}

write_err_payload = (be :: CBackend, ety: TyId, name: str, out :: String)
                    Res<(), AllocError> {
    be.is_variant(ety, name).match({
        false => Ok(()),
        true  => be.write_err_variant(ety, name, out),
    })
}

write_err_variant = (be :: CBackend, ety: TyId, name: str, out :: String)
                    Res<(), AllocError> {
    path ::= be.alloc.String().try();
    be.enum_path(ety, path).try();
    out.add_bytes(", .zg_data.").try();
    out.sym_member("Err").try();
    out.add_bytes(" = ((").try();
    be.ctype(ety, out).try();
    out.add_bytes("){ .zg_tag = ").try();
    out.sym_variant(path.view(), name).try();
    out.add_bytes(" })").try();
    Ok(());
}

write_res_head = (be :: CBackend, ret: TyId, variant: str, out :: String)
                 Res<(), AllocError> {
    cty ::= be.alloc.String().try();
    be.ctype(ret, cty).try();
    out.fmt("(({}){ .zg_tag = ", cty.view()).try();
    out.sym_variant(RES_PATH, variant)
}

// -----------------------------------------------------------------
// reading the shapes these lowerings write
// -----------------------------------------------------------------

// The declared type of a STORAGE field, read at the type's own
// arguments — `Vec<u8>`'s `data` is a `Ptr<u8>` and not a `Ptr<T>` —
// and nothing when the type declares no such field.
field_of* = (be :: CBackend, ty: TyId, name: str)
            Res<Res<TyId>, AllocError> {
    be.check.types.at(ty).match({
        Named(n) => be.named_field_of(n, name),
        _        => Ok(None),
    })
}

named_field_of = (be :: CBackend, n: TyNamed, name: str)
                 Res<Res<TyId>, AllocError> {
    inst = be.decl_inst(n).try();
    ctx  = be.decl_ctx(n);
    mark = be.enter_struct_tparams(n.decl).try();
    found ::= be.alloc.Vec<TyId>();
    decl_at(be.tree, n.decl).match({
        None  => Ok(()),
        Ok(d) => be.collect_field(d, name, ctx, inst, found),
    }).try();
    be.leave_tparams(mark).try();
    Ok(found.get(0));
}

collect_field = (
    be   :: CBackend,
    d    : Decl,
    name : str,
    ctx  : Ctx,
    inst : Inst,
    out  :: Vec<TyId>
) Res<(), AllocError> {
    d.kind.match({
        Struct(s) => be.keep_fields(s, name, ctx, inst, out),
        _         => Ok(()),
    })
}

keep_fields = (
    be   :: CBackend,
    s    : Struct,
    name : str,
    ctx  : Ctx,
    inst : Inst,
    out  :: Vec<TyId>
) Res<(), AllocError> {
    s.members.loop((h, m) {
        be.keep_named_field(m, name, ctx, inst, out).try();
    });
    Ok(());
}

keep_named_field = (
    be   :: CBackend,
    m    : Member,
    name : str,
    ctx  : Ctx,
    inst : Inst,
    out  :: Vec<TyId>
) Res<(), AllocError> {
    m.named(name).match({
        false => Ok(()),
        true  => be.add_field_type(m, ctx, inst, out),
    })
}

add_field_type = (
    be   :: CBackend,
    m    : Member,
    ctx  : Ctx,
    inst : Inst,
    out  :: Vec<TyId>
) Res<(), AllocError> {
    be.field_type(m, ctx, inst).match({
        None  => Ok(()),
        Ok(t) => out.add(t),
    })
}

// What a `Ptr<T>` points AT. Sema has no pointer kind — a `Ptr<T>`
// arrives as an ordinary `Named` — so this is its first type argument
// and nothing more.
pointee = (be :: CBackend, ty: TyId) Res<TyId> {
    be.check.types.at(ty).match({
        Named(n) => n.args.get(0),
        _        => None,
    })
}

// One written argument, at the type the signature declares for it.
arg_text* = (
    be   :: CBackend,
    c    : Call,
    i    : usize,
    want : TyId,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    c.args.get(i).match({
        None  => out.add_bytes("0"),
        Ok(a) => expr(be, a.value, ctx, want, out),
    })
}
