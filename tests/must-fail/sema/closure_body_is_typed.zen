// A CLOSURE BODY IS STATEMENTS, AND STATEMENTS ARE TYPED. The identical
// bind one level out has always been refused; inside the closure passed
// to `loop` nothing in sema's type walk ever entered the body, so this
// compiled, ran, and printed a 1 nobody wrote.
//
// position: the value that does not fit the annotation.

main = (env: Env) Res<i32, AllocError> {
    xs = [1, 2, 3];
    xs.loop((h, v) {
        x: i32 = true;
        println("{} {}", v, x);
    });
    Ok(0);
}
