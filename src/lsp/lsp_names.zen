// src/lsp/lsp_names.zen
// Which names sema settled, and what it settled them to — the semantic
// half of `textDocument/semanticTokens/full`.
//
// `lsp_colour.zen`'s item 5 is the doctrine, so this file asks the one
// authority instead of guessing: it reads the memos a finished
// `check_all` left on the `Checker`, plus what the AST itself kinds.
// NOTHING IS RESOLVED HERE — no `defs_of`, no scope walk; a name sema did
// not settle keeps the lexer's `variable`.
//
// FIVE WALKS, one per place the answer is written down:
//
//   - DECLARATION SITES, from the AST alone: a `Function`'s name and
//     its parameters, a `Struct`/`Enum`/`Alias` name, an `Impl`'s
//     target. The declaration kind IS the answer; no memo is needed.
//   - WRITTEN TYPES, from `type_memo`: a `Named` type node the checker
//     resolved to something that is not poison is a type name. TYPES
//     INSIDE A STRUCT OR IMPL BODY ARE NOT HERE — `type_from_ast` does
//     not memoize where `@Self` is in scope (`sema_denote.zen`), so a
//     field's `i32` keeps the lexer's answer. A miss is honest; a
//     guessed entry would not be.
//   - CALLEE NAMES, from `call_memo`: a call that resolved to a
//     declaration classifies the name it was called through — `function`
//     for a `Function` decl, bare or through a receiver (`add(a, b)`,
//     `x.f(..)`); `type` for a construction, but only when the type is
//     named BARE (`Point(x: 1)`). `Shape.Circle(c)` records the enum
//     too, and the name written there is the variant's — a variant is
//     not a type.
//   - THE TWO INTRINSICS, from the AST alone: `.match` and `.try()`
//     wear the shape of a method call and are not one, so they are
//     `Match`/`Try` nodes and no memo will ever resolve them —
//     "there's no `try` field on `Res` and no function of that name"
//     (`ast_node.zen`). Without this walk they are the only words in a
//     clean file that stay `variable` while the calls around them go
//     `function`. `keyword` is what they are: `parse_expr.zen`'s
//     `dot_target` recognises them once, by name, at a position no
//     binding can take over — which is exactly what `consume` is, and
//     `consume` is `keyword` from the lexer.
//   - PARAMETER USES, from `param_memo`: the one fact neither the AST
//     nor a type can say, recorded where resolution still had the scope
//     (`sema_check.zen`'s `Binding.param`).
//
// WHAT IS DELIBERATELY NOT CLASSIFIED, each because the honest answer
// was never written down: a function named but not called; a type
// named in value position (`Shape` in `Shape.Unit`); an enum variant;
// a constant; an import binding; a local of every kind; a closure's
// parameter. All stay `variable` — the lexer's answer, and never a
// wrong one.
//
// THE BUILD MUST BE CLEAN. `lsp_built.zen`'s `rebuild` calls `classify`
// only when the build produced no diagnostics, so nothing here has to say
// what poison means: a wrong answer is worse than none, and a file that
// does not compile keeps its lexical colours.

str = std.text
Alloc, AllocError = std.mem
Vec = std.collections
Range = std.core
Ast, Module, Decl, Block = std.ast
Struct, Enum, Alias, Impl, Member, Function, Named, Call, Match, Try = std.ast
Span, ExprId, TypeId, BlockId = std.ast
Checker = sema.sema_check
decl_at = sema.sema_def
Classed, Colour, sort_classes = lsp.lsp_colour
written = std.json

Classes = {
    file: str,
    rows :: Vec<Classed>,
}

// Produce only the requested file's rows in request scratch. The checker
// stays shared; unrelated workspace files retain no colour table.
classify* = (a: Alloc, c: Checker, file: str)
           Res<Vec<Classed>, AllocError> {
    out ::= Classes(file: file, rows: a.Vec<Classed>());
    decl_sites(a, c, out).try();
    written_types(a, c, out).try();
    expr_sites(a, c, out).try();
    sort_classes(out.rows).try();
    Ok(out.rows)
}

class_as = (
    a      : Alloc,
    span   : Span,
    colour : Colour,
    out    :: Classes
) Res<(), AllocError> {
    span.file.eq(out.file).match({
        false => written(),
        true  => out.rows.add(Classed(
            line: span.start.line,
            col: span.start.col,
            colour: colour
        )),
    }).try();
    Ok(())
}

// --- declaration sites -------------------------------------------------

decl_sites = (a: Alloc, c: Checker, out :: Classes)
             Res<(), AllocError> {
    Range(0, c.tree.module_count()).loop((h, i) {
        c.tree.module_at(i).match({
            None  => written(),
            Ok(m) => m.span.file.eq(out.file).match({
                false => written(),
                true  => module_sites(a, m, out),
            }),
        }).try();
    });
    nested_sites(a, c.tree, out)
}

module_sites = (a: Alloc, m: Module, out :: Classes)
               Res<(), AllocError> {
    m.decls.loop((h, d) { decl_site(a, d, out).try(); });
    Ok(());
}

// A declaration nested in a body — `ast_named.zen`'s two-scan shape:
// every block is flat in the arena, so a nested decl is found without
// recursing into its parent.
nested_sites = (a: Alloc, tree: Ast, out :: Classes)
               Res<(), AllocError> {
    bid ::= BlockId(index: 0);
    Range(0, tree.block_ids()).loop((h, i) {
        block_sites(a, tree.block_at(bid), out).try();
        bid = BlockId(index: bid.index + 1);
    });
    Ok(());
}

block_sites = (a: Alloc, b: Block, out :: Classes)
              Res<(), AllocError> {
    b.stmts.loop((h, s) {
        s.kind.match({
            Decl(d) => decl_site(a, d, out),
            _       => written(),
        }).try();
    });
    Ok(());
}

decl_site = (a: Alloc, d: Decl, out :: Classes)
            Res<(), AllocError> {
    d.kind.match({
        Function(f) => fn_site(a, f, out),
        Struct(s)   => member_sites(a, s.name.span, s.members, out),
        Enum(e)     => class_as(a, e.name.span, Colour.Type, out),
        Alias(x)    => class_as(a, x.name.span, Colour.Type, out),
        Impl(im)    => member_sites(a, im.target.span, im.members, out),
        Const(_)    => written(),
        Import(_)   => written(),
    })
}

fn_site = (a: Alloc, f: Function, out :: Classes)
          Res<(), AllocError> {
    class_as(a, f.name.span, Colour.Function, out).try();
    f.params.loop((h, p) {
        class_as(a, p.name.span, Colour.Parameter, out).try();
    });
    Ok(());
}

// A struct and an impl write their names the same way — the type word,
// then the members beneath it — so one walk serves both; only the
// caller names the difference (`s.name` against `im.target`).
member_sites = (
    a       : Alloc,
    name    : Span,
    members : Vec<Member>,
    out     :: Classes
) Res<(), AllocError> {
    class_as(a, name, Colour.Type, out).try();
    members.loop((h, m) { member_site(a, m, out).try(); });
    Ok(());
}

// A constant and a field keep the lexer's answer; a member FUNCTION is
// a declaration site like any other.
member_site = (a: Alloc, m: Member, out :: Classes)
              Res<(), AllocError> {
    m.kind.match({
        Function(f) => fn_site(a, f, out),
        Const(_)    => written(),
        Field(_)    => written(),
    })
}

// --- written types -----------------------------------------------------

// Every `Named` type node the checker memoized a non-poison answer
// for. THE MEMO, NOT THE NAME, IS THE EVIDENCE: `Point` resolves, and
// so does the `T` of `<T>` — both are types a reader should see
// coloured alike.
written_types = (a: Alloc, c: Checker, out :: Classes)
               Res<(), AllocError> {
    tid ::= TypeId(index: 0);
    Range(0, c.tree.type_ids()).loop((h, i) {
        written_type(a, c, tid, out).try();
        tid = TypeId(index: tid.index + 1);
    });
    Ok(());
}

written_type = (
    a   : Alloc,
    c   : Checker,
    tid : TypeId,
    out :: Classes
) Res<(), AllocError> {
    c.tree.type_at(tid).kind.match({
        Named(n) => named_site(a, c, tid, n, out),
        _        => written(),
    })
}

named_site = (
    a   : Alloc,
    c   : Checker,
    tid : TypeId,
    n   : Named,
    out :: Classes
) Res<(), AllocError> {
    c.type_memo.get(tid).match({
        None   => written(),
        Ok(ty) => c.is_unknown(ty).match({
            true  => written(),
            false => class_as(a, n.name.span, Colour.Type, out),
        }),
    })
}

// --- call sites and parameter uses -------------------------------------

// One pass over every expression: a CALL asks `call_memo` what it
// resolved to, a NAME asks `param_memo` whether it is a parameter, and
// an INTRINSIC asks nothing — the node kind IS the answer.
expr_sites = (a: Alloc, c: Checker, out :: Classes)
             Res<(), AllocError> {
    eid ::= ExprId(index: 0);
    Range(0, c.tree.expr_ids()).loop((h, i) {
        expr_site(a, c, eid, out).try();
        eid = ExprId(index: eid.index + 1);
    });
    Ok(());
}

expr_site = (
    a   : Alloc,
    c   : Checker,
    id  : ExprId,
    out :: Classes
) Res<(), AllocError> {
    e = c.tree.expr_at(id);
    e.kind.match({
        Call(k)  => call_site(a, c, id, k, out),
        Match(m) => class_as(a, m.name_span, Colour.Keyword, out),
        Try(t)   => class_as(a, t.name_span, Colour.Keyword, out),
        Name(_)  => param_site(a, c, id, e.span, out),
        _        => written(),
    })
}

// A bare name's span IS the expression's — `Name` carries no `Ident`,
// "the enclosing `Expr` already has the span" (`ast_node.zen`).
param_site = (
    a    : Alloc,
    c    : Checker,
    id   : ExprId,
    span : Span,
    out  :: Classes
) Res<(), AllocError> {
    c.param_memo.get(id).match({
        Ok(_) => class_as(a, span, Colour.Parameter, out),
        None  => written(),
    })
}

call_site = (
    a   : Alloc,
    c   : Checker,
    id  : ExprId,
    k   : Call,
    out :: Classes
) Res<(), AllocError> {
    c.resolved_call(id).match({
        None    => written(),
        Ok(did) => decl_at(c.tree, did).match({
            None  => written(),
            Ok(d) => callee_site(a, c, d, k, out),
        }),
    })
}

callee_site = (
    a   : Alloc,
    c   : Checker,
    d   : Decl,
    k   : Call,
    out :: Classes
) Res<(), AllocError> {
    d.kind.match({
        Function(_) => fn_callee(a, c, k, out),
        Struct(s)   => type_callee(a, c, k, s.name.text, out),
        Enum(e)     => type_callee(a, c, k, e.name.text, out),
        Alias(x)    => type_callee(a, c, k, x.name.text, out),
        Const(_)    => written(),
        Import(_)   => written(),
        Impl(_)     => written(),
    })
}

// The name a resolved call was made THROUGH: bare (`add(a, b)`) or the
// member of an access (`x.f(..)` — `call_memo` holds the declaration
// either way, and resolution is one rule, `sema_cand.zen`).
fn_callee = (
    a   : Alloc,
    c   : Checker,
    k   : Call,
    out :: Classes
) Res<(), AllocError> {
    callee = c.tree.expr_at(k.callee);
    callee.kind.match({
        Name(_)   => class_as(a, callee.span, Colour.Function, out),
        Access(x) => class_as(a, x.name.span, Colour.Function, out),
        _         => written(),
    })
}

// A CONSTRUCTION names the type only when it names it bare and by its
// own name: `Point(x: 1)`. The same memo entry covers `Shape.Circle(c)`,
// where the name written is the variant's, and a variant is not a type.
type_callee = (
    a    : Alloc,
    c    : Checker,
    k    : Call,
    decl : str,
    out  :: Classes
) Res<(), AllocError> {
    callee = c.tree.expr_at(k.callee);
    callee.kind.match({
        Name(n) => n.text.eq(decl).match({
            true  => class_as(a, callee.span, Colour.Type, out),
            false => written(),
        }),
        _       => written(),
    })
}
