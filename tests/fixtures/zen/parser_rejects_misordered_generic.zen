// A generic type decl written `Name<T>*:` (type params BEFORE the `*` export marker) is the MISORDERED
// head; the canonical form is `Name*<T>:` (star glued to the name, e.g. `Result*<T, E>:`). The parser
// must reject it with a `parse` diagnostic whose caret sits ON the `<` — line 1, column 4 of
// `Box<T>*: …` — NOT (as it once did) mislocated onto the FOLLOWING line's `main`.
{ Malloc } = std.mem.alloc
{ parse_module } = compiler.parse
{ check_module_parse_diagnostic_from_source } = compiler.validate.core
{ diag_user_span } = compiler.diagnostic
main = () i32 {
    a := Malloc(_: 0)
    src := "Box<T>*: { value: T }\nmain = () i32 { 0 }\n"
    d := a.addr().check_module_parse_diagnostic_from_source(a.addr().parse_module(src), src)
    sp := diag_user_span(src, src, d.source_offset, d.span_width)
    (d.code != 0 && d.kind == "parse" && sp.line == 1 && sp.col == 4).then({ 0 }, { 1 })
}
