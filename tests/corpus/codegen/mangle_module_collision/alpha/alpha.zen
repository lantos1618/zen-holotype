// module `alpha`.
//
// every exported name here begins with `beta_`, so an underscore-joining
// mangler produces the same C symbol as module `alpha_beta` does for the
// name with that prefix stripped. Nothing about this file is unusual —
// `beta_gamma` is exactly the sibling-prefix naming STYLE.md prescribes.

beta_gamma* = () i32 { 1 }

value* = () i32 { 10 }

beta_Gamma* = {
    tag: i32
}
