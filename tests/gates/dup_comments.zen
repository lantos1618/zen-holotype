// Reject adjacent duplicate comment blocks, which are usually merge or paste
// residue. Repeated comments elsewhere may legitimately document sibling
// declarations; only blank lines may separate the duplicates checked here.
//
//     0   no file repeats a comment block
//     1   at least one does; every occurrence is named with both line numbers
//     2   the gate could not run
//
// THE FILE LIST ARRIVES ON ARGV, for the reason `line_cap.zen` gives at
// length: `std.env.Fs` has no listing, so a gate over a file SET cannot
// compute its own inputs.

Alloc, AllocError = std.mem
str, String = std.text
Vec = std.collections
Range = std.core
FsError = std.env

// Under three lines it is a label, not a paragraph, and two identical labels
// over two declarations are ordinary.
MIN_BLOCK: usize = 3

// How much of the offending block to quote back. Long enough to recognise the
// paragraph, short enough that a report of twelve stays readable.
CLIP: usize = 96

// A run of comment lines, as 1-based inclusive line numbers — the numbers a
// reader types into an editor, which is the only reason they are 1-based.
Run = {
    first*: usize,
    last*: usize,
}

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    (env.argv.len < 2).match({
        true  => no_files(),
        false => run(env, alloc),
    })
}

no_files = () Res<i32, AllocError> {
    println("dup_comments: no files given — this gate is checking nothing.");
    println("    `make dupcomments` feeds it `find src -name '*.zen'`; a find");
    println("    that matches nothing must not read as green.");
    Ok(2);
}

run = (env: Env, alloc: Alloc) Res<i32, AllocError> {
    files    ::= 0;
    failures ::= 0;
    wasted   ::= 0;
    unread   ::= 0;

    Range(1, env.argv.len).loop((h, i) {
        rel = arg(env, i);
        env.fs.read(alloc, rel).match({
            Err(e)   => {
                unread = unread + 1;
                println("dup_comments: {}: {}", rel, fs_word(e));
            },
            Ok(text) => {
                files    = files + 1;
                hit      = scan(alloc, rel, text.view()).try();
                failures = failures + hit.blocks;
                wasted   = wasted + hit.lines;
            },
        });
    });

    report(files, failures, wasted, unread)
}

// What one file contributed to the totals.
Hit = {
    blocks*: usize,
    lines*: usize,
}

scan = (a: Alloc, rel: str, text: str) Res<Hit, AllocError> {
    lines = lines_of(a, text).try();
    runs  = runs_in(a, lines).try();

    blocks ::= 0;
    waste  ::= 0;
    // Consecutive PAIRS: a block is compared with the one that follows it and
    // with nothing else, which is what "adjacent, and only adjacent" means.
    Range(1, runs.len).loop((h, i) {
        this = at(runs, i - 1);
        next = at(runs, i);
        repeated(lines, this, next).then(() {
            n      = this.last - this.first + 1;
            blocks = blocks + 1;
            waste  = waste + n;
            println(
                "{}:{}: this {}-line comment block is repeated verbatim at :{} with nothing between them",
                rel,
                this.first,
                n,
                next.first
            );
            println("    | {}", clip(row(lines, this.first)));
        });
    });
    Ok(Hit(blocks: blocks, lines: waste));
}

repeated = (lines: Vec<str>, this: Run, next: Run) bool {
    same_text(lines, this, next) && blank_between(lines, this, next)
}

same_text = (lines: Vec<str>, a: Run, b: Run) bool {
    n = a.last - a.first + 1;
    ((b.last - b.first + 1) == n).match({
        true  => rows_equal(lines, a.first, b.first, n),
        false => false,
    })
}

rows_equal = (lines: Vec<str>, x: usize, y: usize, n: usize) bool {
    ok ::= true;
    Range(0, n).loop((h, k) {
        row(lines, x + k).eq(row(lines, y + k)).match({
            true  => (),
            false => { ok = false; },
        });
    });
    ok
}

// Only blank lines may sit between the two copies. Runs are separated by at
// least one non-comment line, so `b.first - 1` is never below `a.last` and the
// range cannot run backwards.
blank_between = (lines: Vec<str>, a: Run, b: Run) bool {
    ok ::= true;
    Range(a.last, b.first - 1).loop((h, k) {
        lines.get(k).match({
            Ok(s) => s.is_empty().match({ true => (), false => { ok = false; } }),
            None  => { ok = false; },
        });
    });
    ok
}

// Every comment run of at least MIN_BLOCK lines, in source order.
runs_in = (a: Alloc, lines: Vec<str>) Res<Vec<Run>, AllocError> {
    out   ::= a.Vec<Run>();
    start ::= 0;
    held  ::= 0;
    Range(0, lines.len).loop((h, i) {
        n = i + 1;
        is_comment(row(lines, n)).match({
            true  => {
                (held == 0).then(() { start = n; });
                held = held + 1;
            },
            false => {
                (held >= MIN_BLOCK).then(() {
                    out.add(Run(first: start, last: n - 1)).try();
                });
                held = 0;
            },
        });
    });
    // a run that reaches the end of the file closes there
    (held >= MIN_BLOCK).then(() {
        out.add(Run(first: start, last: lines.len)).try();
    });
    Ok(out);
}

// The lines of `text`, each stripped, as views into `text` — a str is a
// pointer and a length, so this copies no bytes.
lines_of = (a: Alloc, text: str) Res<Vec<str>, AllocError> {
    out  ::= a.Vec<str>();
    from ::= 0;
    Range(0, text.len).loop((h, i) {
        (text.index(i) == '\n').then(() {
            out.add(strip(text.slice(from, i))).try();
            from = i + 1;
        });
    });
    (from < text.len).then(
        () { out.add(strip(text.slice(from, text.len))).try(); }
    );
    Ok(out);
}

strip = (s: str) str {
    from ::= 0;
    to   ::= s.len;
    Range(0, s.len).loop((h, i) {
        (from == i && is_space(s.index(i))).then(() { from = i + 1; });
    });
    Range(0, s.len).loop((h, i) {
        back = s.len - i;
        (to == back && back > from && is_space(s.index(back - 1))).then(() {
            to = back - 1;
        });
    });
    s.slice(from, to)
}

is_space = (b: u8) bool { b.is_in([' ', '\t', '\r']) }

is_comment = (s: str) bool {
    (s.len < 2).match({
        true  => false,
        false => s.index(0) == '/' && s.index(1) == '/',
    })
}

clip = (s: str) str {
    (s.len > CLIP).match({
        true  => s.slice(0, CLIP),
        false => s,
    })
}

row = (lines: Vec<str>, one_based: usize) str {
    lines.get(one_based - 1).match({ Ok(s) => s, None => "" })
}

at = (runs: Vec<Run>, i: usize) Run {
    runs.get(i).match({ Ok(r) => r, None => Run(first: 0, last: 0) })
}

arg = (env: Env, i: usize) str {
    env.argv.get(i).match({ Ok(s) => s, None => "" })
}

fs_word = (e: FsError) str {
    e.match({
        NotFound    => "not found",
        Denied      => "denied",
        IsDir       => "is a directory",
        Exists      => "already locked",
        Failed      => "could not be read",
        OutOfMemory => "out of memory",
    })
}

// A file that could not be read is not a file with no duplicates: the gate did
// not run on it, and exit 2 is that answer rather than exit 0's.
report = (files: usize, failures: usize, wasted: usize, unread: usize)
         Res<i32, AllocError> {
    (unread > 0).match({
        true  => Ok(2),
        false => verdict(files, failures, wasted),
    })
}

verdict = (files: usize, failures: usize, wasted: usize) Res<i32, AllocError> {
    (failures > 0).match({
        true  => {
            println(
                "dup_comments: {} repeated block(s), {} redundant line(s). Keep one copy.",
                failures,
                wasted
            );
            Ok(1);
        },
        false => {
            println(
                "dup_comments: {} files, no repeated comment blocks",
                files
            );
            Ok(0);
        },
    })
}
