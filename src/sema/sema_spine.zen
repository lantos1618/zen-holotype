// src/sema/sema_spine.zen
// Iterative typing for left-associated binary chains.
//
// The parser builds these chains iteratively, so their length is not bounded
// by recursive-descent depth. Walking the left spine bottom-up memoizes each
// operand before its parent and keeps expression typing at constant stack
// depth. Other expression nesting remains recursively bounded.

Expr, ExprId, Binary = std.ast
AllocError = std.mem
Vec = std.collections
Checker, Ctx = sema.sema_check
// the query this file exists to keep shallow; the cycle back to
// `sema_type` is the shape of expression typing and not a smell, for
// the reason that file's header gives
type_of = sema.sema_type

// Guard the heavier iterative walk; most operands have no left binary spine.
spine_ahead* = (c: Checker, id: ExprId) bool {
    c.below(id).match({ None => false, Ok(_) => true })
}

// Type every level of the left spine below `id`, deepest first, so the
// caller's own recursion finds each one already answered. Stops at a
// node already in the memo, keeping the whole spine linear rather than
// quadratic: the next walk is one step long.
seed_left_spine* = (c :: Checker, id: ExprId, ctx: Ctx)
                  Res<(), AllocError> {
    spine ::= c.alloc.Vec<ExprId>();
    down  ::= id;
    going ::= true;
    going.loop((h) {
        going = c.below(down).match({
            None     => false,
            Ok(next) => { spine.add(down).try(); down = next; true },
        });
    });
    // The spine was collected top-down, so popping visits it deepest first.
    loop(spine.len > 0, (h) {
        spine.take(spine.len - 1).match({
            None   => c.types.unknown(),
            Ok(at) => c.type_of(at, ctx),
        }).try();
    });
    Ok(());
}

// One step down: the left operand of a binary node nothing has typed
// yet, and `None` at anything else.
below = (c: Checker, id: ExprId) Res<ExprId> {
    c.expr_memo.get(id).match({
        Ok(_) => None,
        None  => left_of(c.tree.expr_at(id)),
    })
}

left_of = (node: Expr) Res<ExprId> {
    node.kind.match({
        Binary(b) => Ok(b.lhs),
        _         => None,
    })
}
