// The sign check applies after constant folding, not only to a written
// unary minus. This expression folds to negative one, and its recovery type
// prevents the initializer and index from producing follow-on diagnostics.

main = (env: Env) Res<i32, AllocError> {
    values: [u8, 1 - 2] = [1, 2];
    println("{}", values[0]);
    Ok(0);
}
