// @self-hosted-only
// Checked-mode resolver — VISIBILITY enforcement (extracted from std.internal.resolve). Enforces `*`
// cross-module exports (error[private-name]) over the ORIGINAL module sources, and the private-type
// leak scan. Shared types + the resolve pipeline that calls enforce_visibility/enforce_private_leaks
// live in std.internal.resolve.
{ at, is_alpha, is_alnum } = std.text.bytes
{ gstr_string, gstr_append, gstr_finish } = compiler.genc
{ Malloc } = std.mem.alloc
{ String } = std.text.string
{ is_empty, view } = std.text.str
{ render_diagnostic } = compiler.diagnostic
{ getEnv } = std.sys.os
{ ImportEdge, ModuleGraph, ModuleSig, ModuleTable, ProvidedSymbol, SIG_IMPORTED, SIG_PUB, SIG_TYPE,
  block_comment_at, die, eprint, id_is_std_io_c, line_comment_at, lstrip, mappend_id_name,
  mappend_string, mimport_head_name, mimport_name_span, next_line, quoted_at, res_col_of,
  res_ident_end, res_line_of, res_sbyte } = std.internal.resolve
{ edge_alias_in, edge_id_in } = std.internal.resolve_scan
// ── VISIBILITY: `*` exports are ENFORCED across modules (error[private-name]) ─────────────────────
// A top-level name is cross-module visible only when its declaration carries the `*` export marker
// (`name* = …`, `Type*: …`, `GLOBAL* := …`). Both consumption forms are checked per module, over the
// ORIGINAL module sources, so the diagnostic points at the exact user line:col:
//   • flat import heads:    `{ hidden } = mod`                    → error[private-name] at `hidden`
//   • alias-qualified uses: `m = mod` + `m.hidden(…)`/`m.Hidden`  → error[private-name] at `hidden`
// A name the target module itself only IMPORTS stays importable (transitive re-export is the one
// sanctioned pass-through; visibility is decided at the DEFINING module's head). `c = std.io.c`-style
// aliases skip the qualified scan: their qualifiers are stripped wholesale (strip_all_quals), the
// module is a raw libc surface. ZEN_VIS_REPORT=1 downgrades the error to a report-only sweep (print
// every violation, never exit) — the migration mode used to prove the tree clean before enforcing.
vis_report_mode* = () bool {
    is_empty(getEnv("ZEN_VIS_REPORT")).match ({ true => false, false => true })
}
vis_fail = (
    a: MutPtr<Malloc>,
    path: string_view,
    src: string_view,
    pos: i32,
    width: i32,
    name: String,
    id: String,
    report: bool,
) i32 {
    line := src.res_line_of(pos)
    col := src.res_col_of(pos)
    m0 := a.gstr_string(192).gstr_append(a, "`")
    m1 := a.mappend_string(m0, name)
    m2 := m1.gstr_append(a, "` is private in module '")
    m3 := a.mappend_id_name(m2, id)
    msg := m3.gstr_append(a, "' (its declaration has no `*` export)").gstr_finish(a)
    h0 := a.gstr_string(128).gstr_append(a, "export it with `")
    h1 := a.mappend_string(h0, name)
    hint := h1
        .gstr_append(a, "*` in the defining module, or use the module's public surface")
        .gstr_finish(a)
    eprint(a.render_diagnostic(path, src, line, col, col + width - 1, "private-name", msg, hint, 1))
    report.match ({ true => 0, false => die(1) })
}
// flat import head `{ a, b } = mod` at line start `p`: every name must be exported by `mod`.
vis_check_head = (
    a: MutPtr<Malloc>,
    path: string_view,
    src: string_view,
    p: i32,
    target: ModuleGraph,
    id: String,
    report: bool,
) i32 {
    pos := src.lstrip(p) + 1
    bs: [u8] := src.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos == false).then({
            (b == '}' || b == 0).match ({
                true  => {
                    h.break
                },
                false => b.is_alpha().match ({
                    true  => {
                        ie := src.res_ident_end(pos)
                        hd := a.mimport_head_name(src, pos, ie)
                        target.sig.private(hd.gstr_finish(a)).then({
                            a.vis_fail(path, src, pos, ie - pos, a.mimport_name_span(src, pos, ie), id, report)
                        })
                        pos = ie
                    },
                    false => {
                        pos = pos + 1
                    },
                }),
            })
        })
    })
    0
}
// skip past a (possibly unterminated) `/* … */` block comment without copying.
vis_skip_block = (s: string_view, p: i32) i32 {
    pos := p + 2
    bs: [u8] := s.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos == false).then({
            (b == 0).match ({
                true  => {
                    h.break
                },
                false => (b == '*' && s.at(ii + 1) == '/').match ({
                    true  => {
                        pos = ii + 2
                        h.break
                    },
                    false => {
                        pos = ii + 1
                    },
                }),
            })
        })
    })
    pos
}
// skip past a quoted literal (string or char) without copying, honoring escapes.
vis_skip_lit = (s: string_view, p: i32) i32 {
    q := s.at(p)
    pos := p
    esc := false
    bs: [u8] := s.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos == false).then({
            (b == 0).match ({
                true  => {
                    h.break
                },
                false => {
                    pos = pos + 1
                    esc.match ({
                        true  => {
                            esc = false
                        },
                        false => (b == '\\').match ({
                            true  => {
                                esc = true
                            },
                            false => (ii > p && b == q).then({
                                h.break
                            }),
                        }),
                    })
                },
            })
        })
    })
    pos
}
// s[p..e) == w, byte-exact (idents are short; recursion is bounded).
vis_span_eq_at = (s: string_view, p: i32, e: i32, w: String, j: i64) bool {
    (p + to_i32(j) == e).match ({
        true  => j == w.len,
        false => (j < w.len && s.at(p + to_i32(j)) == w.res_sbyte(j)).match ({
            true  => s.vis_span_eq_at(p, e, w, j + 1),
            false => false,
        }),
    })
}
// alias-qualified uses `alias.name` in `src`: `name` must be exported by the aliased module.
// Comment/string spans are skipped; the ident-boundary + dot shape mirrors rewrite_quals exactly,
// so anything the rewriter WOULD have resolved is what gets visibility-checked.
vis_scan_quals = (
    a: MutPtr<Malloc>,
    path: string_view,
    src: string_view,
    alias: String,
    target: ModuleGraph,
    id: String,
    report: bool,
) i32 {
    pos := 0
    bs: [u8] := src.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos == false).then({
            (b == 0).match ({
                true  => {
                    h.break
                },
                false => src.line_comment_at(pos).match ({
                    true  => {
                        pos = src.next_line(pos)
                    },
                    false => src.block_comment_at(pos).match ({
                        true  => {
                            pos = src.vis_skip_block(pos)
                        },
                        false => src.quoted_at(pos).match ({
                            true  => {
                                pos = src.vis_skip_lit(pos)
                            },
                            false => (b.is_alpha()
                                && (pos == 0
                                    || src.at(pos - 1).is_alnum().match ({
                                        true  => false,
                                        false => true,
                                    }))).match ({
                                true  => {
                                    ie := src.res_ident_end(pos)
                                    (src.vis_span_eq_at(pos, ie, alias, 0)
                                        && src.at(ie) == '.'
                                        && src.at(ie + 1).is_alpha()).match ({
                                        true  => {
                                            me := src.res_ident_end(ie + 1)
                                            nm := a.mimport_name_span(src, ie + 1, me)
                                            target.sig.private(nm.gstr_finish(a)).then({
                                                a.vis_fail(path, src, ie + 1, me - ie - 1, a.mimport_name_span(src, ie + 1, me), id, report)
                                            })
                                            pos = me
                                        },
                                        false => {
                                            pos = ie
                                        },
                                    })
                                },
                                false => {
                                    pos = pos + 1
                                },
                            }),
                        }),
                    }),
                }),
            })
        })
    })
    0
}
vis_enforce_edge = (
    a: MutPtr<Malloc>,
    table: ModuleTable,
    path: string_view,
    src: string_view,
    edge: ImportEdge,
    report: bool,
) i32 {
    id := edge.edge_id_in(a)
    table.has_id(id).match ({
        true  => {
            entry := table.module_id(id)
            edge.namespace.match ({
                true  => id.id_is_std_io_c().match ({
                    true  => 0,
                    false => a.vis_scan_quals(path, src, edge.edge_alias_in(a), entry.graph, id, report),
                }),
                false => a.vis_check_head(path, src, edge.start, entry.graph, id, report),
            })
        },
        false => 0,
    })
}
enforce_visibility* = (a: MutPtr<Malloc>, table: ModuleTable, report: bool) i32 {
    table.modules.loop((h, i, entry) {
        entry.graph.imports.loop((h2, j, edge) {
            a.vis_enforce_edge(table, entry.path, entry.source, edge, report)
        })
    })
    0
}
// ── error[private-leak]: an EXPORTED value decl must not EXPOSE a private type ───────────────────
// The per-name wall above cannot see one hole: an exported (`*`) fn whose SIGNATURE names a type
// the SAME module defines but does NOT export (`mk* = () Secret { … }` with a private `Secret:`).
// The importer never writes the private name, so error[private-name] stays silent — yet it now
// holds a value whose type it cannot name. Every non-entry module in the table (the modules whose
// exports someone can actually import; the entry's exports leak to nobody) gets each exported
// value decl's signature scanned over the ORIGINAL module source, so the diagnostic carries the
// user's file:line:col at the offending type use. An ident in TYPE position — after `:` in the
// param list / generic bounds, or in the return-type region between the params' closing `)` and
// the body `{` (bodyless foreign decls run to the decl end), recursing naturally through
// Ptr/MutPtr/RawPtr/slice/generic arguments because every ident inside a type expression is a
// type — is looked up in the module's OWN sig: recorded as a TYPE, neither exported nor imported
// → error[private-leak]. Types from OTHER modules never hit (absent from this sig, or
// SIG_IMPORTED = the sanctioned transitive re-export); builtins / primitives / generic params are
// absent the same way. `.`-qualified idents are skipped (a qualified type lives behind an alias,
// i.e. in another module, by construction). Internal (std/compiler) sources are scanned too — the
// tree is clean, so no internal gate. ZEN_VIS_REPORT=1 downgrades to a report-only sweep, exactly
// like error[private-name].
sig_private_type = (s: ModuleSig, name: string_view) bool {
    f := s.names.get(name, 0 - 1)
    (f < 0).match ({
        true  => false,
        false => f / SIG_TYPE % 2 == 1 && f / SIG_PUB % 2 == 0 && f / SIG_IMPORTED % 2 == 0,
    })
}
leak_fail = (
    a: MutPtr<Malloc>,
    path: string_view,
    src: string_view,
    pos: i32,
    width: i32,
    fname: string_view,
    tname: String,
    report: bool,
) i32 {
    line := src.res_line_of(pos)
    col := src.res_col_of(pos)
    m0 := a
        .gstr_string(192)
        .gstr_append(a, "exported `")
        .gstr_append(a, fname)
        .gstr_append(a, "` exposes private type `")
    msg := a.mappend_string(m0, tname).gstr_append(a, "`").gstr_finish(a)
    h0 := a.gstr_string(128).gstr_append(a, "export `")
    hint := a
        .mappend_string(h0, tname)
        .gstr_append(a, "*` or make `")
        .gstr_append(a, fname)
        .gstr_append(a, "` private")
        .gstr_finish(a)
    eprint(a.render_diagnostic(path, src, line, col, col + width - 1, "private-leak", msg, hint, 1))
    report.match ({ true => 0, false => die(1) })
}
// ONE exported value decl's signature, scanned textually (mirroring vis_scan_quals: comment/quote
// spans are skipped). A tiny state machine tracks TYPE position: `:` opens a type expression at
// the current nesting depth (`:=` is a value initializer — nothing after it is a signature type,
// the scan stops; a bare `=` whose RHS is not a param list `(` stops the same way), `,` at the
// opening depth or any dedent below it closes it, and the params' closing `)` back at depth 0
// opens the return-type region, which runs to the body `{`.
leak_scan_decl = (
    a: MutPtr<Malloc>,
    path: string_view,
    src: string_view,
    sym: ProvidedSymbol,
    sig: ModuleSig,
    report: bool,
) i32 {
    pos := src.res_ident_end(sym.start) + 1    // past `name*`
    (pos < sym.decl_next).then({
        base := pos
        depth := 0
        in_type := false
        tdepth := 0
        span: [u8] := slice(src.offset(base), to_i64(sym.decl_next - base))
        span.loop((h, i, b) {
            ii := base + to_i32(i)
            (ii < pos == false).then({
                src.line_comment_at(ii).match ({
                    true  => {
                        pos = src.next_line(ii)
                    },
                    false => src.block_comment_at(ii).match ({
                        true  => {
                            pos = src.vis_skip_block(ii)
                        },
                        false => src.quoted_at(ii).match ({
                            true  => {
                                pos = src.vis_skip_lit(ii)
                            },
                            false => (b == 0 || b == '{').match ({
                                true  => {
                                    h.break
                                },
                                false => b.is_alpha().match ({
                                    true  => {
                                        ie := src.res_ident_end(ii)
                                        (in_type && src.at(ii - 1) != '.').then({
                                            nm := a.mimport_name_span(src, ii, ie)
                                            sig.sig_private_type(nm.gstr_finish(a)).then({
                                                a.leak_fail(path, src, ii, ie - ii, sym.name, a.mimport_name_span(src, ii, ie), report)
                                            })
                                        })
                                        pos = ie
                                    },
                                    false => {
                                        pos = ii + 1
                                        (b == '(' || b == '[' || b == '<').then({
                                            depth = depth + 1
                                        })
                                        (b == ']' || b == '>').then({
                                            depth = depth - 1
                                            (depth < tdepth).then({
                                                in_type = false
                                            })
                                        })
                                        (b == ')').then({
                                            depth = depth - 1
                                            (depth < tdepth).then({
                                                in_type = false
                                            })
                                            (depth == 0).then({
                                                in_type = true    // the params closed: the return-type region opens
                                                tdepth = 0
                                            })
                                        })
                                        (b == ',' && depth == tdepth).then({
                                            in_type = false
                                        })
                                        // `:=` is a value initializer, and so is a bare `=` whose RHS
                                        // is not a param list `(` — no signature follows either: stop.
                                        (b == ':').then({
                                            (src.at(ii + 1) == '=').match ({
                                                true  => {
                                                    h.break
                                                },
                                                false => {
                                                    in_type = true
                                                    tdepth = depth
                                                },
                                            })
                                        })
                                        (b == '=').then({
                                            in_type = false
                                            (src.at(src.lstrip(ii + 1)) == '(' == false).then({
                                                h.break
                                            })
                                        })
                                    },
                                }),
                            }),
                        }),
                    }),
                })
            })
        })
    })
    0
}
enforce_private_leaks* = (a: MutPtr<Malloc>, table: ModuleTable, report: bool) i32 {
    table.modules.loop((h, i, entry) {
        (i > 0).then({
            entry.graph.symbols.loop((h2, j, sym) {
                (sym.is_pub && (sym.imported || sym.is_type) == false).then({
                    a.leak_scan_decl(entry.path, entry.source, sym, entry.graph.sig, report)
                })
            })
        })
    })
    0
}
