// Enum variant names are compile-time-known borrowed text. Lowercase wire
// variants demonstrate that the declaration itself can own protocol spelling.

Role = system | user | assistant | tool
Shape = Circle(i32) | Rect
Opt<T> = Some(T) | None

made_role = () Role {
    println("made once");
    assistant
}

main = (env: Env) Res<i32, AllocError> {
    role: Role     = user;
    shape          = Shape.Circle(7);
    some: Opt<i32> = Opt.Some(4);
    none: Opt<i32> = Opt.None;

    println("{} {}", system.variant_name(), role.variant_name());
    println("{} {}", shape.variant_name(), Shape.Rect.variant_name());
    println("{} {}", some.variant_name(), none.variant_name());
    println("{}", made_role().variant_name());
    Ok(0)
}
