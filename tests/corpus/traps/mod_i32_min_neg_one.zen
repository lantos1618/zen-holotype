// tests/corpus/traps/mod_i32_min_neg_one.zen
// i32.MIN % -1 traps with i32.MIN / -1: one instruction computes
// both, and it faults on the quotient even though the remainder
// asked for here is 0

// main must name an error type. a trap never lifts into Res:
// it aborts the process
Error =
    Overflow,
    DivideByZero,
    OutOfBounds

main = (env: Env) Res<i32, Error> {
    x: i32 = i32.MIN;
    neg_one: i32 = -1;
    r = x % neg_one;
    println("{}", r);
    Ok(0);
}
