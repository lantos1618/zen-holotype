// src/gen/gen_c/gen_c_report.zen
// Four fault shapes. Each writes `0` into the caller's buffer so the
// emitted C still parses around the diagnostic. "A DIAGNOSTIC IS A
// VALUE, NOT A RAISE" (gen_diag.zen): the backend keeps emitting the C
// it can and lets the caller decide what a report of faults means.
//
// Own file, not gen_c_state.zen's tail: callers span ~20 places, not
// the few a shared tail would imply.

// `ast.ast_id`, not `ast`: a lone `ExprId = ast` reads as a type alias
// named `ast` rather than an import.
ExprId = ast.ast_id
str, String = std.text
AllocError = std.mem
GenFault = gen.gen_diag
CBackend = gen.gen_c.gen_c_state

// A node form this backend does not lower yet.
unsupported* = (be :: CBackend, id: ExprId, what: str, out :: String)
               Res<(), AllocError> {
    be.report_expr(id, GenFault.Unsupported(what)).try();
    out.add_bytes("0")
}

// A name with no declaration behind it.
unresolved* = (be :: CBackend, id: ExprId, name: str, out :: String)
              Res<(), AllocError> {
    be.report_expr(id, GenFault.Unresolved(name)).try();
    out.add_bytes("0")
}

// Sema had no type and the context supplied none.
untyped* = (be :: CBackend, id: ExprId, what: str, out :: String)
           Res<(), AllocError> {
    be.report_expr(id, GenFault.Untyped(what)).try();
    out.add_bytes("0")
}

// A name with more than one declaration, and no overload rule to
// choose between them.
ambiguous* = (be :: CBackend, id: ExprId, name: str, out :: String)
             Res<(), AllocError> {
    be.report_expr(id, GenFault.Ambiguous(name)).try();
    out.add_bytes("0")
}
