// Numeric arithmetic and ordering, integer remainder and wrapping, bool
// logic/not, and Eq-backed string equality remain inside their domains.

main = (env: Env) Res<i32, AllocError> {
    left: i32  = 7;
    right: i32 = 3;
    low: f64   = 1.5;
    high: f64  = 2.5;

    println("{} {} {}", left % right, left < right, (low + high) > high);
    println("{} {}", left +% right, true && !false);
    println("{}", "same" == "same");
    Ok(0);
}
