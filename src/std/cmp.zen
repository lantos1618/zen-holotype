// std.cmp — total order (`Ord`) as a three-way compare: `cmp(a, b)` is `.Less` / `.Equal` / `.Greater`.
// Scalar and StringView impls ship here; struct keys are one `T.impl(Ord, { cmp = … })` away.
{ strcmp } = std.c.libc
Ordering*: Less | Equal | Greater
Ord*: {
    cmp: (Self, Self) Ordering,
}
is_lt* = (o: Ordering) bool {
    o.match ({
        .Less => true,
        _     => false,
    })
}
is_eq* = (o: Ordering) bool {
    o.match ({
        .Equal => true,
        _      => false,
    })
}
is_gt* = (o: Ordering) bool {
    o.match ({
        .Greater => true,
        _        => false,
    })
}
is_ge* = (o: Ordering) bool {
    o.match ({
        .Less => false,
        _     => true,
    })
}
// The one three-way shape every impl below folds into — widen to i64, compare once.
ord_i64* = (a: i64, b: i64) Ordering {
    (a < b).match ({
        true  => Ordering.Less,
        false => (a > b).then({ Ordering.Greater }, { Ordering.Equal }),
    })
}
i64.impl(Ord, {
    cmp = (a: i64, b: i64) Ordering { ord_i64(a, b) }
})
i32.impl(Ord, {
    cmp = (a: i32, b: i32) Ordering { ord_i64(to_i64(a), to_i64(b)) }
})
u8.impl(Ord, {
    cmp = (a: u8, b: u8) Ordering { ord_i64(to_i64(a), to_i64(b)) }
})
// Byte order, via strcmp's sign — matches the byte equality `==` lowers to (__str_eq).
StringView.impl(Ord, {
    cmp = (a: StringView, b: StringView) Ordering { ord_i64(to_i64(a.strcmp(b)), 0) }
})
