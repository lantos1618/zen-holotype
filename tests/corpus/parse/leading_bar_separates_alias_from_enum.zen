// the leading bar is what makes a one-variant enum and an alias
// different declarations rather than the same three tokens. two
// must-fail fixtures used to assert this pair was ambiguous; DESIGN.md
// resolved it, so the pair is gated here as the answer instead.
//
//   Alias = Shape       no bar -> an alias. Alias.Circle exists,
//                       because Alias IS Shape.
//   Only  = | Circle    bar leads -> a one-variant enum of its own.
//                       Only.Circle is Only's variant, not Shape's.
Shape = Circle | Square

Alias = Shape

Only = | Circle

name = (s: Shape) str {
    s.match({
        Circle => "shape circle",
        Square => "shape square",
    });
}

main = (env: Env) Res<i32, ArgError> {
    // read through the alias: same type, so a Shape arm matches it
    a: Alias = Alias.Circle;
    println("{}", name(a));

    // the one-variant enum is a distinct type with one arm to close
    Only.Circle.match({
        Circle => println("only circle"),
    });

    Ok(0);
}
