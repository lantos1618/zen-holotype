// `vararg<T>` is a run of T, and no call site could build a run of runs:
// each inner run would need storage of its own, which is the boxing a
// borrowed pack exists to avoid.
//
// This is load-bearing rather than a taste rule. ONE PACK SLOT HAS TWO
// READINGS — a run of T values, or exactly one value that is already a
// `vararg<T>` being forwarded — and not nesting is the whole of why they
// cannot collide: an argument of the pack's own type is never also one of
// its elements. Allow nesting and forwarding becomes ambiguous.
//
// BOTH positions fire, and both sentences are true of this declaration: the
// outer says its element may not be a pack, the inner says a pack is a last
// parameter's type. The author deletes both halves either way.

nested = (v: vararg<vararg<i32>>) i32 { 0 }

main = (env: Env) Res<i32, AllocError> {
    println("{}", nested());
    Ok(0);
}
