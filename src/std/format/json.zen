// std.format.json — a JSON value type with a recursive-descent parser and a compact serializer.
//
// JSON is the default config/data interchange format; this module gives Zen first-class
// encode/decode built entirely on the existing stdlib (enums + payloads, the std.text.string
// builder, and std.text.num's parse_f64/float).
//
// VALUE SHAPE. A `Value` is a tagged union over the six JSON kinds:
//
//   Entry*:  { key: string_view, val: Value }
//   Object*: { entries: [Entry] }
//   Value*:  Null | Bool(bool) | Num(f64) | Str(string_view) | Arr([Value]) | Obj(Object)
//
// Objects are an insertion-ordered slice of (key, value) Entry pairs, and growable
// arrays/objects accumulate through the module-local generic `JBuf<T>` buffer.
//
// ── COMPILER LIMITS HIT (and the design forced by each, all verified by bisection) ──
// This module is the proverbial "two hard things" stress test for the self-hosted compiler.
// Two real limits shaped the value type; neither is a JSON design choice:
//   1. Objects can't be `Obj(Map<Value>)`. It compiles and round-trips WITHIN one file, but
//      instantiating ANOTHER module's generic struct (`Map<T>`) against a recursive enum defined
//      here fails to monomorphize once this module is imported (cross-module generic-struct-param).
//   2. Objects can't use a parallel `Vec<string_view>` across this module boundary: that foreign
//      generic string-element buffer still hits the cross-module monomorphization limit.
//      Wrapping the key in the local `Entry` struct dodges it.
//
// ALLOCATOR. parse/stringify are generic over the allocator: every allocating entry takes
// `a: MutPtr<A>` for any `A: Allocator` (heap, arena, fixed-buffer, test), threaded exactly like
// std.collections' vec/hmap and std.sys.os. Pass `heap.gpa().addr()`, an arena, or any other allocator;
// callers who already passed a `Malloc` keep working unchanged (`Malloc` still satisfies `A`).
//
// MEMORY. Parsed strings and object keys are allocator-owned NUL-terminated copies. Nothing here
// frees on the error path — parse, consume, and drop (or back it with an arena and reset).
//
//   heap = std.mem.heap
//   a := heap.gpa()
//   json.parse(a.addr(), "{\"x\":[1,2,3]}").match ({
//       .Ok(v)  => { ... json.get(v, "x") ... json.stringify(a.addr(), v) ... },
//       .Err(e) => ...
//   })
//
// NUMBERS. Parsed via std.text.num.parse_f64 (sign, fraction, e/E exponents) — hand-rolled,
// ~15 significant digits, NOT correctly-rounded. Serialized via std.text.num.float: integral
// values print without a decimal point ("1", "-7"), fractional values to at most 6 decimal places
// with trailing zeros trimmed ("3.14"). No pretty-printing — output is compact.
//
// STRINGS. Decode handles the standard escapes \" \\ \/ \b \f \n \r \t and \uXXXX (a single BMP
// code point, UTF-8 encoded; surrogate PAIRS are not recombined). Encode re-escapes \" \\ \n \r
// \t and emits \u00XX for the remaining control bytes (< 0x20); all other bytes (incl. UTF-8
// continuation bytes) pass through verbatim.
{ Result, Opt, IoError, err, expect } = std.core.result
{ String, new_in, push_in, append_in, append_slice_in, finish_in } = std.text.string
{ view, substr_in } = std.text.str
{ hex_char, hex_nibble } = std.text.bytes    // shared hex nibble encode/decode (centralized in std.text.bytes)
{ parse_f64, float_in } = std.text.num
// ── OOM policy ────────────────────────────────────────────────────────────────
// The String builder's ops return Result<_, IoError> (allocation failure is a value). This module
// threads the caller's allocator whose exhaustion is fatal by policy, so builder Results are unwrapped
// at the module boundary with these two helpers — parse/stringify keep their observable behavior.
jok = (r: Result<String, IoError>) String { r.expect("std.json: allocation failed") }
jfin = (r: Result<string_cstr, IoError>) string_view { r.expect("std.json: allocation failed") }
// ── the value type ───────────────────────────────────────────────────────────
Entry*: {
    key: string_view,
    val: Value,
}
Object*: {
    entries: [Entry],
}
Value*: Null | Bool(bool) | Num(f64) | Str(string_view) | Arr([Value]) | Obj(Object)
// A parse error, carrying the byte offset where it was detected (UnexpectedEof carries none).
JsonError*: Unexpected(i64) | BadString(i64) | BadNumber(i64) | BadLiteral(i64) | TrailingGarbage(i64) | UnexpectedEof | TooDeep
// nesting cap so a pathological "[[[[…" can't blow the native stack.
MAX_DEPTH := 256
// ── internal step values (a parsed node + the offset just past it) ────────────
Step: {
    v: Value,
    pos: i64,
}
StrStep: {
    s: string_view,
    pos: i64,
}
step_ok = (v: Value, pos: i64) Result<Step, JsonError> {
    .Ok(Step(
        v: v,
        pos: pos,
    ))
}
sstep_ok = (s: string_view, pos: i64) Result<StrStep, JsonError> {
    .Ok(StrStep(
        s: s,
        pos: pos,
    ))
}
// ── module-local growable buffer (hand-rolled Vec; see limit #2) ───────────────
// One same-module generic `JBuf<T>` serves both array/object backbones: array elements as
// `JBuf<Value>` and object entries as `JBuf<Entry>`. `T` is phantom in the fields, mirroring
// std.collections.Vec; the element size flows through `sizeof(T)` at each same-module instantiation.
// (A FOREIGN generic buffer still hits limit #2 above; a same-module one does not.)
JBuf<T>: {
    ptr: RawPtr<u8>,
    len: i64,
    cap: i64,
}
jbuf_new<A, T> = (a: MutPtr<A>) JBuf<T> {
    JBuf<T>(
        ptr: a.acquire(sizeof(T)),
        len: 0,
        cap: 1,
    )
}
jbuf_push<A, T> = (a: MutPtr<A>, jb: JBuf<T>, x: T) JBuf<T> {
    x := x
    r := (jb.len < jb.cap).match ({
        true  => jb,
        false => JBuf<T>(
            ptr: a.resize(jb.ptr, (jb.cap * 2 + 1) * sizeof(T)),
            len: jb.len,
            cap: jb.cap * 2 + 1,
        ),
    })
    s: [T] := slice(r.ptr, r.cap)
    s[r.len] = x
    JBuf<T>(
        ptr: r.ptr,
        len: r.len + 1,
        cap: r.cap,
    )
}
jbuf_slice<T> = (jb: JBuf<T>) [T] { slice(jb.ptr, jb.len) }
// ── byte classes ──────────────────────────────────────────────────────────────
json_ws = (b: u8) bool { b == ' ' || b == '\t' || b == '\n' || b == '\r' }
is_num_start = (b: u8) bool { b == '-' || b >= '0' && b <= '9' }
is_num_byte = (b: u8) bool {
    b >= '0' && b <= '9' || b == '-' || b == '+' || b == '.' || b == 'e' || b == 'E'
}
// first index >= pos that is not JSON whitespace (or sv.len when the tail is all whitespace).
skip_ws = (sv: [u8], pos: i64) i64 {
    p: i64 := pos
    sv.loop((h, i, b) {
        (i < p == false).then({
            b.json_ws().match ({
                true  => {
                    p = i + 1
                },
                false => {
                    h.break
                },
            })
        })
    })
    p
}
// ── string decoding (allocator-owned, escapes resolved) ───────────────────────
// the code point of the 4 hex digits at sv[at..at+4], or -1 if any byte is not hex.
hex4 = (sv: [u8], at: i64) i64 {
    d0 := hex_nibble(sv[at])
    d1 := hex_nibble(sv[at + 1])
    d2 := hex_nibble(sv[at + 2])
    d3 := hex_nibble(sv[at + 3])
    (d0 < 0 || d1 < 0 || d2 < 0 || d3 < 0).match ({
        true  => 0 - 1,
        false => d0 * 4096 + d1 * 256 + d2 * 16 + d3,
    })
}
// UTF-8 encode a BMP code point into the builder (1, 2, or 3 bytes).
push_utf8<A> = (a: MutPtr<A>, sb: String, cp: i64) String {
    (cp < 128).match ({
        true  => sb.push_in(a, cp.to_u8()).jok(),
        false => (cp < 2048).match ({
            true  => sb
                .push_in(a, (192 | cp >> 6).to_u8())
                .jok()
                .push_in(a, (128 | cp & 63).to_u8())
                .jok(),
            false => sb
                .push_in(a, (224 | cp >> 12).to_u8())
                .jok()
                .push_in(a, (128 | cp >> 6 & 63).to_u8())
                .jok()
                .push_in(a, (128 | cp & 63).to_u8())
                .jok(),
        }),
    })
}
// decode the JSON string starting at sv[pos] == '"'; returns the decoded view + the offset
// just past the closing quote. The decoded bytes are accumulated through `a`.
parse_string_raw<A> = (
    a: MutPtr<A>,
    src: string_view,
    sv: [u8],
    pos: i64,
) Result<StrStep, JsonError> {
    sb: String := a.new_in().jok()
    endpos: i64 := 0 - 1
    errpos: i64 := 0 - 1
    resume: i64 := pos + 1
    sv.loop((h, i, b) {
        (i < resume == false).then({
            (b == '"').match ({
                true  => {
                    endpos = i + 1
                    h.break
                },
                false => (b == '\\').match ({
                    true  => (i + 1 >= sv.len).match ({
                        true  => {
                            errpos = i
                            h.break
                        },
                        false => (sv[i + 1] == '"').match ({
                            true  => {
                                sb = sb.push_in(a, '"').jok()
                                resume = i + 2
                            },
                            false => (sv[i + 1] == '\\').match ({
                                true  => {
                                    sb = sb.push_in(a, '\\').jok()
                                    resume = i + 2
                                },
                                false => (sv[i + 1] == '/').match ({
                                    true  => {
                                        sb = sb.push_in(a, '/').jok()
                                        resume = i + 2
                                    },
                                    false => (sv[i + 1] == 'n').match ({
                                        true  => {
                                            sb = sb.push_in(a, '\n').jok()
                                            resume = i + 2
                                        },
                                        false => (sv[i + 1] == 't').match ({
                                            true  => {
                                                sb = sb.push_in(a, '\t').jok()
                                                resume = i + 2
                                            },
                                            false => (sv[i + 1] == 'r').match ({
                                                true  => {
                                                    sb = sb.push_in(a, '\r').jok()
                                                    resume = i + 2
                                                },
                                                false => (sv[i + 1] == 'b').match ({
                                                    true  => {
                                                        sb = sb.push_in(a, 8.to_u8()).jok()
                                                        resume = i + 2
                                                    },
                                                    false => (sv[i + 1] == 'f').match ({
                                                        true  => {
                                                            sb = sb.push_in(a, 12.to_u8()).jok()
                                                            resume = i + 2
                                                        },
                                                        false => (sv[i + 1] == 'u').match ({
                                                            true  => (i + 5 >= sv.len).match ({
                                                                true  => {
                                                                    errpos = i
                                                                    h.break
                                                                },
                                                                false => {
                                                                    cp := hex4(sv, i + 2)
                                                                    (cp < 0).match ({
                                                                        true  => {
                                                                            errpos = i
                                                                            h.break
                                                                        },
                                                                        false => {
                                                                            sb = a.push_utf8(sb, cp)
                                                                            resume = i + 6
                                                                        },
                                                                    })
                                                                },
                                                            }),
                                                            false => {
                                                                errpos = i
                                                                h.break
                                                            },
                                                        }),
                                                    }),
                                                }),
                                            }),
                                        }),
                                    }),
                                }),
                            }),
                        }),
                    }),
                    false => {
                        sb = sb.push_in(a, b).jok()
                        resume = i + 1
                    },
                }),
            })
        })
    })
    (endpos < 0).match ({
        true  => (errpos >= 0).match ({
            true  => err(.BadString(errpos)),
            false => err(.UnexpectedEof),
        }),
        false => sstep_ok(sb.finish_in(a).jfin(), endpos),
    })
}
// ── scalar parsers ─────────────────────────────────────────────────────────────
// match sv[pos..] against `word`; on success produce `v` at pos+len, else BadLiteral.
parse_lit = (sv: [u8], pos: i64, word: string_view, v: Value) Result<Step, JsonError> {
    wv := word.view()
    ok: bool := pos + wv.len <= sv.len
    wv.loop((h, i, b) {
        ok.match ({
            true  => (sv[pos + i] == b == false).then({
                ok = false
                h.break
            }),
            false => {
                h.break
            },
        })
    })
    ok.match ({ true => step_ok(v, pos + wv.len), false => err(.BadLiteral(pos)) })
}
parse_number<A> = (a: MutPtr<A>, src: string_view, sv: [u8], pos: i64) Result<Step, JsonError> {
    endp: i64 := pos
    sv.loop((h, i, b) {
        (i < pos == false).then({
            b.is_num_byte().match ({
                true  => {
                    endp = i + 1
                },
                false => {
                    h.break
                },
            })
        })
    })
    n := endp - pos
    (n <= 0).match ({
        true  => err(.BadNumber(pos)),
        false => {
            txt := a.substr_in(src, pos, n).expect("std.json: allocation failed")
            parse_f64(txt).match ({
                .Ok(f)  => step_ok(.Num(f), endp),
                .Err(_) => err(.BadNumber(pos)),
            })
        },
    })
}
parse_str_value<A> = (a: MutPtr<A>, src: string_view, sv: [u8], pos: i64) Result<Step, JsonError> {
    a.parse_string_raw(src, sv, pos).match ({
        .Ok(ss) => step_ok(.Str(ss.s), ss.pos),
        .Err(e) => err(e),
    })
}
// ── aggregate parsers (mutually recursive with parse_value; OK because concrete) ──
parse_array<A> = (
    a: MutPtr<A>,
    src: string_view,
    sv: [u8],
    pos: i64,
    depth: i64,
) Result<Step, JsonError> {
    p := sv.skip_ws(pos + 1)
    (p >= sv.len).match ({
        true  => err(.UnexpectedEof),
        false => (sv[p] == ']').match ({
            true  => {
                empty: JBuf<Value> := a.jbuf_new()
                step_ok(.Arr(empty.jbuf_slice()), p + 1)
            },
            false => {
                seed: JBuf<Value> := a.jbuf_new()
                a.arr_loop(src, sv, p, depth, seed)
            },
        }),
    })
}
arr_loop<A> = (
    a: MutPtr<A>,
    src: string_view,
    sv: [u8],
    p: i64,
    depth: i64,
    vb: JBuf<Value>,
) Result<Step, JsonError> {
    a.parse_value(src, sv, p, depth + 1).match ({
        .Err(e) => err(e),
        .Ok(st) => {
            vb2 := a.jbuf_push(vb, st.v)
            q := sv.skip_ws(st.pos)
            (q >= sv.len).match ({
                true  => err(.UnexpectedEof),
                false => (sv[q] == ',').match ({
                    true  => a.arr_loop(src, sv, sv.skip_ws(q + 1), depth, vb2),
                    false => (sv[q] == ']').match ({
                        true  => step_ok(.Arr(vb2.jbuf_slice()), q + 1),
                        false => err(.Unexpected(q)),
                    }),
                }),
            })
        },
    })
}
parse_object<A> = (
    a: MutPtr<A>,
    src: string_view,
    sv: [u8],
    pos: i64,
    depth: i64,
) Result<Step, JsonError> {
    p := sv.skip_ws(pos + 1)
    (p >= sv.len).match ({
        true  => err(.UnexpectedEof),
        false => (sv[p] == '}').match ({
            true  => {
                empty: JBuf<Entry> := a.jbuf_new()
                step_ok(.Obj(Object(entries: empty.jbuf_slice())), p + 1)
            },
            false => {
                seed: JBuf<Entry> := a.jbuf_new()
                a.obj_loop(src, sv, p, depth, seed)
            },
        }),
    })
}
obj_loop<A> = (
    a: MutPtr<A>,
    src: string_view,
    sv: [u8],
    p: i64,
    depth: i64,
    eb: JBuf<Entry>,
) Result<Step, JsonError> {
    (p >= sv.len).match ({
        true  => err(.UnexpectedEof),
        false => (sv[p] == '"').match ({
            true  => a.parse_string_raw(src, sv, p).match ({
                .Err(e) => err(e),
                .Ok(ks) => {
                    q := sv.skip_ws(ks.pos)
                    (q >= sv.len || sv[q] != ':').match ({
                        true  => (q >= sv.len).match ({
                            true  => err(.UnexpectedEof),
                            false => err(.Unexpected(q)),
                        }),
                        false => a.parse_value(src, sv, q + 1, depth + 1).match ({
                            .Err(e) => err(e),
                            .Ok(st) => {
                                eb2 := a.jbuf_push(eb, Entry(
                                    key: ks.s,
                                    val: st.v,
                                ))
                                r := sv.skip_ws(st.pos)
                                (r >= sv.len).match ({
                                    true  => err(.UnexpectedEof),
                                    false => (sv[r] == ',').match ({
                                        true  => a.obj_loop(src, sv, sv.skip_ws(r + 1), depth, eb2),
                                        false => (sv[r] == '}').match ({
                                            true  => step_ok(.Obj(Object(entries: eb2.jbuf_slice())), r + 1),
                                            false => err(.Unexpected(r)),
                                        }),
                                    }),
                                })
                            },
                        }),
                    })
                },
            }),
            false => err(.Unexpected(p)),
        }),
    })
}
// the core recursive-descent dispatcher: parse ONE value at sv[pos..].
parse_value<A> = (
    a: MutPtr<A>,
    src: string_view,
    sv: [u8],
    pos: i64,
    depth: i64,
) Result<Step, JsonError> {
    (depth > MAX_DEPTH).match ({
        true  => err(.TooDeep),
        false => {
            p := sv.skip_ws(pos)
            (p >= sv.len).match ({
                true  => err(.UnexpectedEof),
                false => {
                    b := sv[p]
                    b.is_num_start().match ({
                        true  => a.parse_number(src, sv, p),
                        false => (b == '{').match ({
                            true  => a.parse_object(src, sv, p, depth),
                            false => (b == '[').match ({
                                true  => a.parse_array(src, sv, p, depth),
                                false => (b == '"').match ({
                                    true  => a.parse_str_value(src, sv, p),
                                    false => (b == 't').match ({
                                        true  => parse_lit(sv, p, "true", .Bool(true)),
                                        false => (b == 'f').match ({
                                            true  => parse_lit(sv, p, "false", .Bool(false)),
                                            false => (b == 'n').match ({
                                                true  => parse_lit(sv, p, "null", .Null),
                                                false => err(.Unexpected(p)),
                                            }),
                                        }),
                                    }),
                                }),
                            }),
                        }),
                    })
                },
            })
        },
    })
}
// ── public parse ───────────────────────────────────────────────────────────────
// Parse a complete JSON document. Returns Err on any malformed input, including
// trailing non-whitespace after the value.
parse*<A> = (a: MutPtr<A>, s: string_view) Result<Value, JsonError> {
    sv := s.view()
    out: Result<Value, JsonError> := a.parse_value(s, sv, 0, 0).match ({
        .Err(e) => {
            r: Result<Value, JsonError> := .Err(e)
            r
        },
        .Ok(st) => {
            p := sv.skip_ws(st.pos)
            r: Result<Value, JsonError> := (p < sv.len).match ({
                true  => .Err(.TrailingGarbage(p)),
                false => .Ok(st.v),
            })
            r
        },
    })
    out
}
// ── serialization ──────────────────────────────────────────────────────────────
write_u_esc<A> = (a: MutPtr<A>, sb: String, b: u8) String {
    bi := b.to_i64()
    sb
        .push_in(a, '\\')
        .jok()
        .push_in(a, 'u')
        .jok()
        .push_in(a, '0')
        .jok()
        .push_in(a, '0')
        .jok()
        .push_in(a, hex_char(bi >> 4 & 15))
        .jok()
        .push_in(a, hex_char(bi & 15))
        .jok()
}
write_esc_byte<A> = (a: MutPtr<A>, sb: String, b: u8) String {
    (b == '"').match ({
        true  => sb.push_in(a, '\\').jok().push_in(a, '"').jok(),
        false => (b == '\\').match ({
            true  => sb.push_in(a, '\\').jok().push_in(a, '\\').jok(),
            false => (b == '\n').match ({
                true  => sb.push_in(a, '\\').jok().push_in(a, 'n').jok(),
                false => (b == '\t').match ({
                    true  => sb.push_in(a, '\\').jok().push_in(a, 't').jok(),
                    false => (b == '\r').match ({
                        true  => sb.push_in(a, '\\').jok().push_in(a, 'r').jok(),
                        false => (b < 32).match ({
                            true  => a.write_u_esc(sb, b),
                            false => sb.push_in(a, b).jok(),
                        }),
                    }),
                }),
            }),
        }),
    })
}
// The bytes write_esc_byte rewrites: the two mandatory JSON escapes ('"', '\\') plus every
// control byte (< 0x20 — \n \t \r get short escapes, the rest \u00XX). Everything else (incl.
// UTF-8 continuation bytes) passes through verbatim, so it belongs to a bulk-copy run.
json_needs_esc = (b: u8) bool { b == '"' || b == '\\' || b < 32 }
// Run-copy escaping (jsony's doCopy/copyMem): copy the run of pass-through bytes since the last
// escape in ONE append, emit the escape via write_esc_byte, restart the run past it — instead of
// pushing every byte one at a time. Byte-identical output; fewer grows/stores for plain text.
write_str_lit<A> = (a: MutPtr<A>, sb: String, s: string_view) String {
    out: String := sb.push_in(a, '"').jok()
    sv := s.view()
    run_start: i64 := 0
    sv.loop((h, i, b) {
        json_needs_esc(b).then({
            (i > run_start).then({
                out = a.append_slice_in(out, slice(sv.ptr.offset(run_start), i - run_start)).jok()
            })
            out = a.write_esc_byte(out, b)
            run_start = i + 1
        })
    })
    (sv.len > run_start).then({
        out = a.append_slice_in(out, slice(sv.ptr.offset(run_start), sv.len - run_start)).jok()
    })
    out.push_in(a, '"').jok()
}
write_arr<A> = (a: MutPtr<A>, sb: String, xs: [Value]) String {
    out: String := sb.push_in(a, '[').jok()
    xs.loop((h, i, x) {
        (i > 0).then({
            out = out.push_in(a, ',').jok()
        })
        out = a.write_value(out, x)
    })
    out.push_in(a, ']').jok()
}
write_obj<A> = (a: MutPtr<A>, sb: String, o: Object) String {
    out: String := sb.push_in(a, '{').jok()
    es := o.entries
    es.loop((h, i, e) {
        (i > 0).then({
            out = out.push_in(a, ',').jok()
        })
        out = a.write_str_lit(out, e.key)
        out = out.push_in(a, ':').jok()
        out = a.write_value(out, e.val)
    })
    out.push_in(a, '}').jok()
}
write_value<A> = (a: MutPtr<A>, sb: String, v: Value) String {
    v.match ({
        .Null    => sb.append_in(a, "null").jok(),
        .Bool(b) => b.match ({
            true  => sb.append_in(a, "true").jok(),
            false => sb.append_in(a, "false").jok(),
        }),
        .Num(n)  => sb.append_in(a, a.float_in(n).jok().finish_in(a).jfin()).jok(),
        .Str(s)  => a.write_str_lit(sb, s),
        .Arr(xs) => a.write_arr(sb, xs),
        .Obj(o)  => a.write_obj(sb, o),
    })
}
// Serialize a Value to compact JSON text (allocator-owned, NUL-terminated view).
stringify*<A> = (a: MutPtr<A>, v: Value) string_view {
    sb: String := a.new_in().jok()
    sb = a.write_value(sb, v)
    sb.finish_in(a).jfin()
}
// ── accessors ──────────────────────────────────────────────────────────────────
// index of `key` in the object's entry list, or -1 (O(n) linear scan).
obj_find* = (o: Object, key: string_view) i64 {
    found: i64 := 0 - 1
    o.entries.loop((h, i, e) {
        (found < 0).match ({
            true  => (e.key == key).then({
                found = i
                h.break
            }),
            false => {
                h.break
            },
        })
    })
    found
}
// Object member lookup: .Some(value) if `key` is present, else .None.
obj_get* = (o: Object, key: string_view) Opt<Value> {
    i := o.obj_find(key)
    out: Opt<Value> := (i < 0).match ({ true => .None, false => .Some(o.entries[i].val) })
    out
}
// Member lookup on a Value: .Some(value) if it is an Obj containing `key`, else .None.
get* = (obj: Value, key: string_view) Opt<Value> {
    out: Opt<Value> := obj.match ({
        .Obj(o) => o.obj_get(key),
        _       => .None,
    })
    out
}
as_obj* = (v: Value) Opt<Object> {
    out: Opt<Object> := v.match ({
        .Obj(o) => .Some(o),
        _       => .None,
    })
    out
}
as_num* = (v: Value) Opt<f64> {
    out: Opt<f64> := v.match ({
        .Num(n) => .Some(n),
        _       => .None,
    })
    out
}
as_str* = (v: Value) Opt<string_view> {
    out: Opt<string_view> := v.match ({
        .Str(s) => .Some(s),
        _       => .None,
    })
    out
}
as_bool* = (v: Value) Opt<bool> {
    out: Opt<bool> := v.match ({
        .Bool(b) => .Some(b),
        _        => .None,
    })
    out
}
as_arr* = (v: Value) Opt<[Value]> {
    out: Opt<[Value]> := v.match ({
        .Arr(xs) => .Some(xs),
        _        => .None,
    })
    out
}
// ── structural equality (handy for round-trip checks) ───────────────────────────
arr_eq = (xs: [Value], ys: [Value]) bool {
    (xs.len != ys.len).match ({
        true  => false,
        false => {
            ok: bool := true
            xs.loop((h, i, x) {
                (equals(x, ys[i]) == false).then({
                    ok = false
                    h.break
                })
            })
            ok
        },
    })
}
obj_eq = (a: Object, b: Object) bool {
    (a.entries.len != b.entries.len).match ({
        true  => false,
        false => {
            ok: bool := true
            a.entries.loop((h, i, e) {
                j := b.obj_find(e.key)
                (j < 0).match ({
                    true  => {
                        ok = false
                        h.break
                    },
                    false => (equals(e.val, b.entries[j].val) == false).then({
                        ok = false
                        h.break
                    }),
                })
            })
            ok
        },
    })
}
// Deep structural equality. Numbers compare by f64 ==, strings byte-wise, objects key-by-key
// regardless of key order.
equals* = (x: Value, y: Value) bool {
    x.match ({
        .Null    => y.match ({
            .Null => true,
            _     => false,
        }),
        .Bool(a) => y.match ({
            .Bool(b) => a == b,
            _        => false,
        }),
        .Num(a)  => y.match ({
            .Num(b) => a == b,
            _       => false,
        }),
        .Str(a)  => y.match ({
            .Str(b) => a == b,
            _       => false,
        }),
        .Arr(a)  => y.match ({
            .Arr(b) => arr_eq(a, b),
            _       => false,
        }),
        .Obj(a)  => y.match ({
            .Obj(b) => obj_eq(a, b),
            _       => false,
        }),
    })
}
