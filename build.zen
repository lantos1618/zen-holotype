// The self-hosted compiler target. `zen build` recognizes this file as the
// project root today; executing the graph is the remaining build-driver work.

Builder, BuildError, Dep = std.build

build = (b :: Builder) Res<(), BuildError> {
    deps ::= b.alloc.Vec<Dep>();
    b.exe("zen", {
        src: Path("src/zen/zen.zen"),
        deps: deps,
    }).try();
    Ok(())
}
