// A `{}` WITH NO ARGUMENT LEFT — REFUSED, at the hole's own position.
//
// The format walk spends one argument per positional hole; a hole reached
// with none left used to print its own two brace bytes into the user's
// output — `println("missing {}")` printed `missing {}` — which is the
// plausible-looking corrupt answer text_fmt.zen's header calls a compile
// error rather than a `?`. It is refused at THE HOLE'S OWN POSITION: a
// string literal cannot span source lines, so the byte offset of `{` in
// the literal's raw text is the column, exactly as
// must-fail/codegen/format_hole_names_nothing holds for an unresolved
// name.
//
// position: the `{` of `{}`, not the literal and not the call.

main = (env: Env) Res<i32> {
    println("missing {}");
    Ok(0);
}
