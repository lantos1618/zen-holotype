// std.net.http_actor acceptance: AN UNDELIVERABLE REPLY IS SURFACED, NOT SILENT.
//
// Regression for the bug where `HttpFetcher.receive` called `ref_send_msg(...)` in statement position
// and threw the `Result` away. A reply send fails when the requester's mailbox is full; discarding
// that failure left the requester blocked forever on a reply that had already been dropped, with
// nothing anywhere in the fetcher recording it. `receive` now routes both reply paths through
// `reply_or_drop`, which tallies the loss in the fetcher's own `dropped` field — a behaviour has no
// caller to propagate to, and panicking inside a behaviour would take the fetcher down for every
// other requester.
//
// The failure is produced DETERMINISTICALLY, with no threads and no network:
//   • a pool opened with ZERO workers never drains anything, so a mailbox that fills stays full;
//   • the sink actor's mailbox holds exactly ONE message;
//   • the request URL is `https://…`, which std.net.http rejects outright (no TLS) before it opens a
//     socket — so `receive` takes its `.Err` reply path immediately.
// Two fetches therefore mean two replies into a one-slot mailbox: the first is delivered, the second
// MUST be counted. Exit 0 = fetches == 2, delivered == 1, dropped == 1.
//
// TEARDOWN: the pool is deliberately left open. With zero workers `p.live` (bumped by the scheduling
// send) is never cleared, so `pool_quiesce_stop` would block by construction; the process exits instead.
{ to_exit } = std.core.bool
{ gpa } = std.mem.heap
{ view } = std.text.str
{ pool_drain_inline, pool_open } = std.concurrent.pool
{ Context, Receiver, dispatch } = std.concurrent.pool_actor
pa = std.concurrent.pool_actor
{ HttpFetcher, HttpReplyMsg, http_fetch } = std.net.http_actor
// the requester: counts the replies that actually landed. A DELIVERED reply's body is an owned copy
// and becomes this actor's, so it is released here — the dropped one is freed by `reply_or_drop`.
Sink*: {
    got: i64,
}
Sink.impl(Receiver, {
    receive = (s: MutPtr<Sink>, ctx: Context<HttpReplyMsg>) void {
        ctx.msg.match ({
            .Done(r) => {
                s.got = s.got + 1
                gpa().addr().release(r.body.view().ptr)
            },
        })
    }
})
sink_tramp = (user: RawPtr<u8>, msg: i64) void { dispatch<Sink, HttpReplyMsg>(user, msg) }
main = () i32 {
    p := pool_open(0, 8)    // zero workers: nothing is ever drained behind our back
    sink := pa.spawn_actor_heap(1, Sink(got: 0), sink_tramp)
    req := http_fetch("https://tls.invalid/", sink.ref_of(p))
    f := HttpFetcher(
        fetches: 0,
        dropped: 0,
    )
    fp := f.addr()
    fp.receive(Context(msg: req))    // reply 1 → fills the one-slot mailbox
    fp.receive(Context(msg: req))    // reply 2 → mailbox full, the send FAILS
    delivered := sink.raw.pool_drain_inline()    // run the sink inline: exactly one reply was queued
    (fp.fetches == 2 && delivered == 1 && pa.actor_state(sink).got == 1 && fp.dropped == 1).to_exit()
}
