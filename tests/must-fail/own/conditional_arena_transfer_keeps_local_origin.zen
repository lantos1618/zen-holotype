Box = { owner :: Arena, value :: str }
fill = (output :: Box, env: Env, letters: str) Res<(), AllocError> {
    fresh  ::= env.mem.alloc();
    buffer ::= fresh.String().try();
    buffer.add(letters).try();
    output.owner.drop();
    (letters.len > 0).match({
        true  => { output.owner = consume fresh; },
        false => (),
    });
    output.value = buffer.view();
    Ok(())
}
main = (env: Env) Res<i32, AllocError> {
    output ::= Box(owner: env.mem.alloc(), value: "safe");
    fill(output, env, "ab").try();
    println("{}", output.value);
    Ok(0)
}
