// probeQ: Drop via sugar + callee prints via sugar, println-arg call
Noisy = {
    env: Env,
    tag: str,
}

Noisy.impl(Drop, {
    drop = (self :: @Self) () { println("drop {}", self.tag) }
})

three = (env: Env) i64 {
    f = Noisy(env: env, tag: "f");
    println("inside three");
    3
}

main = (env: Env) Res<i32, IoError> {
    println("chain {}", three(env));
    Ok(0);
}
