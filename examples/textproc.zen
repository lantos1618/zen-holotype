// textproc.zen — a small `wc` + `grep`-lite text tool, built as a first real program on the
// PUBLIC stdlib. Reads a file (path arg) or stdin.
//
//   ./zen run examples/textproc.zen FILE            # wc: lines words bytes
//   ./zen run examples/textproc.zen                 # wc over stdin
//   ./zen run examples/textproc.zen grep PAT  FILE  # print lines containing PAT (substring)
//   ./zen run examples/textproc.zen re   PAT  FILE  # print lines matching regex PAT
//
// grep/re with no FILE read stdin. Errors are values: a missing file, a bad regex, or a failed
// write all print a clean message and exit non-zero — no crash.
halloc = std.mem.heap
{ contents, contents_bytes } = std.io.file
{ read_all, read_all_bytes } = std.io.stdin
{ stdout_bufw_in, bufw_println, bufw_close } = std.io.bufwriter
{ argc, arg } = std.sys.os
{ split, contains, own_ptr } = std.text.str
{ compile, matches, error_name, regex_free } = std.text.regex
{ Result, IoError, name } = std.core.result
{ AllocatorBackend, release_slice } = std.mem.alloc
{ formatln, arg_int, arg_str } = std.text.fmt
// Count '\n' bytes — wc's line count (a final unterminated line is not counted, like `wc -l`).
count_lines = (v: MutSlice<u8>) i64 {
    n :: i64 = 0
    v.loop((h, i, b) {
        (b == '\n').then({
            n = n + 1
        })
    })
    n
}
// Count whitespace-separated words — a run of non-space bytes is one word.
count_words = (v: MutSlice<u8>) i64 {
    n :: i64 = 0
    in_word ::= false
    v.loop((h, i, b) {
        sp = b == ' ' || b == '\n' || b == '\t' || b == '\r'
        sp.match ({
            true  => {
                in_word = false
            },
            false => {
                (in_word == false).then({
                    n = n + 1
                })
                in_word = true
            },
        })
    })
    n
}
// wc mode: print "<lines> <words> <bytes>" over the raw bytes, so an embedded NUL is counted
// like any other byte instead of ending the input.
run_wc = (v: MutSlice<u8>) i32 {
    formatln("{} {} {}", [arg_int(v.count_lines()), arg_int(v.count_words()), arg_int(v.len)])
    0
}
// Print the selected lines through a buffered writer: one write(2) per 64 KiB instead of one per
// line. `hits == 0` exits 1 like grep; a failed flush is reported and exits 2.
emit_hits = (a: AllocatorBackend, lines: MutSlice<StringView>, keep: (StringView) bool) i32 {
    w = a.stdout_bufw_in(64 * 1024).expect("textproc: oom")
    wp = w.addr()
    hits :: i64 = 0
    lines.loop((h, i, line) {
        keep(line).then({
            wp.bufw_println(a, line).or(0)
            hits = hits + 1
        })
    })
    wp.bufw_close(a).match ({
        .Ok(n)  => (hits > 0).then({ 0 }, { 1 }),
        .Err(e) => {
            formatln("textproc: write failed: {}", [arg_str(name(e))])
            2
        },
    })
}
// `str.split` copies: every line is its own owned block, hanging off an owned backbone. `emit_hits`
// only BORROWS them, so the caller that split is the one that frees — here, once printing is done.
free_lines = (a: AllocatorBackend, lines: MutSlice<StringView>) void {
    lines.loop((h, i, line) {
        a.release(line.own_ptr())
    })
    a.release_slice(lines)
}
// grep (substring) mode.
run_grep = (a: AllocatorBackend, text: StringView, pat: StringView) i32 {
    lines = a.split(text, '\n')
    rc = a.emit_hits(lines, (line) bool { line.contains(pat) })
    a.free_lines(lines)
    rc
}
// regex mode: compile `pat`, then print every line it matches anywhere.
run_re = (a: AllocatorBackend, text: StringView, pat: StringView) i32 {
    a.compile(pat).match ({
        .Err(e) => {
            formatln("textproc: bad regex: {}", [arg_str(error_name(e))])
            2
        },
        .Ok(re) => {
            lines = a.split(text, '\n')
            rc = a.emit_hits(lines, (line) bool { re.matches(line) })
            a.free_lines(lines)
            re.regex_free(a)
            rc
        },
    })
}
// The input source: the arg at `file_idx` names a file; "" means stdin.
src_path = (file_idx: i32) StringView { (argc() > file_idx).then({ arg(file_idx) }, { "" }) }
// wc counts bytes, so it reads binary-safe: contents_bytes/read_all_bytes carry their length and
// keep embedded NULs, where the text reads below stop at the first one.
read_bytes = (a: AllocatorBackend, p: StringView) Result<MutSlice<u8>, IoError> {
    (p == "").then({ a.read_all_bytes() }, { a.contents_bytes(p) })
}
// grep/re read TEXT: std.text.str's search/split and std.text.regex take StringView and have no
// [u8] counterpart, so a NUL byte truncates the searched input. That is a stdlib gap, not a choice.
read_text = (a: AllocatorBackend, p: StringView) Result<StringView, IoError> {
    (p == "").then({ a.read_all() }, { a.contents(p) })
}
// Name the input source for error messages.
src_name = (p: StringView) StringView { (p == "").then({ "<stdin>" }, { p }) }
main = () i32 {
    heap = halloc.gpa()
    a = heap.addr()
    // argv[0] is the program; the first user arg is at index 1.
    mode = (argc() > 1).then({ arg(1) }, { "" })
    // grep/re take a PATTERN at index 2 and an optional FILE at index 3; wc takes an optional
    // FILE at index 1.
    is_grep = mode == "grep"
    is_re = mode == "re"
    searching = is_grep || is_re
    p = src_path(searching.then({ 3 }, { 1 }))
    pat = (argc() > 2).then({ arg(2) }, { "" })
    // Both readers hand back ONE owned buffer — stdin's and the file's alike — and it is ours to
    // release once the mode that reads it is done.
    searching.match ({
        true  => a.read_text(p).match ({
            .Ok(t)  => {
                rc = is_grep.then({ a.run_grep(t, pat) }, { a.run_re(t, pat) })
                a.release(t.own_ptr())
                rc
            },
            .Err(e) => {
                formatln("textproc: {}: {}", [arg_str(src_name(p)), arg_str(name(e))])
                1
            },
        }),
        false => a.read_bytes(p).match ({
            .Ok(v)  => {
                rc = run_wc(v)
                a.release_slice(v)
                rc
            },
            .Err(e) => {
                formatln("textproc: {}: {}", [arg_str(src_name(p)), arg_str(name(e))])
                1
            },
        }),
    })
}
