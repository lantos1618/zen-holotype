// tests/corpus/loop-nested/nested_loops_break_inner_only.zen
// a break fired from the INNER body must stop the inner loop and only
// the inner loop; the outer has to keep counting its own passes.
//
// The interesting failure is depth confusion: the handle is bound at
// loop-map_body_can_break_early.zen's mutation — bind it one level in
// and `h.break()` names the OUTER loop, so "outer 2" never prints. But
// the plausible wrong answer is not a crash: an outer that stops after
// one pass still prints numbers, three of them, all real. Only the
// count discriminates.
//
// The inner break is guarded by `(index == 1).then(...)` rather than
// taken on every pass so the inner loop demonstrably completes some
// passes before it breaks — a break wired to fire unconditionally is
// indistinguishable from a broken inner loop that runs zero times.

main = (env: Env) Res<i32, AllocError> {
    Range(0, 3).loop((h_outer, outer) {
        println("outer {}", outer);
        Range(0, 10).loop((h_inner, index, value) {
            (index == 1).then(() { h_inner.break() });
            println("  inner {} {}", index, value);
        });
    });
    Ok(0);
}
