// fmt-gate: a comment ABOVE a struct-member function stays above it (never hoisted into the body), and
// a trailing comment on a boolean `.match ({` opening line stays on that line (never migrated past `}`).
Point*: {
    x: i32,
    // double the x coordinate
    dbl = (p: Point) i32 { p.x * 2 }
}
classify = (n: i32, lo: i32, hi: i32) i32 {
    (n > 0).match ({    // note: sign check
        true  => hi,
        false => lo,
    })
}
