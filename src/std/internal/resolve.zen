// @self-hosted-only
// Checked-mode resolver: flatten imports, load dependencies, and dedup provided names.
{ at, is_alpha, is_alnum } = std.text.ascii
{ Decl } = compiler.ast.ast_types
{ gstr_string, gstr_push, gstr_append, gstr_finish } = compiler.genc
{ gstr_int } = compiler.astops    // the compiler-side decimal writer (res_udec delegates to it)
{ decl_span, parse_module, decl_is_impl, note_alias_prefix, alias_prefixes_reset, note_module_sig,
  module_sigs_reset, module_sig_flags, module_sig_alias_stamped } = compiler.parse
{ check_linked } = compiler.validate.core
// Parser APIs still take MutPtr<Malloc>; scanner-only APIs can use any Allocator.
{ Malloc } = std.mem.alloc
{ Result, IoError, ok } = std.core.result
{ String } = std.text.string
{ Map, of } = std.collections.map    // O(1) presence sets for the shadow-rename pass (.has/.put are UFCS methods)
{ contents_in, O_RDONLY } = std.io.file
{ open, close, write } = std.c.libc
{ ends_with, is_empty, starts_with, view } = std.text.str
// Extracted internal helper families (shared types + this pipeline stay here; see each module head).
{ enforce_visibility, enforce_private_leaks, vis_report_mode } = std.internal.resolve_vis
{ enforce_ffi_grants, genmod_lookup } = std.internal.resolve_ffi
{ shadow_flat, shadow_flat_users } = std.internal.resolve_shadow
{ all_decl_names_in, copy_block_comment, copy_line_comment, copy_literal, edge_alias_in, edge_id_in,
  is_any_marker_at, is_c_kw_name_span, is_ws, has_import_marker, module_graph, opens_import,
  str_bytes, symbol_name_in, value_decl_names_in } = std.internal.resolve_scan
lstrip* = (s: string_view, p: i32) i32 {
    at(s, p).is_ws().match ({ true => s.lstrip(p + 1), false => p })
}
is_import_line* = (s: string_view, p: i32) bool {
    ls := s.lstrip(p)
    s.opens_import(ls).match ({ true => s.has_import_marker(ls), false => false })
}
// Position just past the next '\n' at or after `p` (end-of-string if none). Iterates a sub-slice that
// starts at `p` — NOT a scan from 0, and NOT recursive — so walking a file line-by-line is O(n) total
// with constant stack.
next_line* = (s: string_view, p: i32) i32 {
    bs: [u8] := s.view()
    pos := p
    (p < to_i32(bs.len)).then({
        span: [u8] := slice(s.offset(p), bs.len - to_i64(p))
        span.loop((h, i, b) {
            pos = p + to_i32(i) + 1
            (b == '\n').then({
                h.break
            })
        })
    })
    pos
}
line_comment_at* = (s: string_view, p: i32) bool { s.at(p) == '/' && s.at(p + 1) == '/' }
block_comment_at* = (s: string_view, p: i32) bool { s.at(p) == '/' && s.at(p + 1) == '*' }
quoted_at* = (s: string_view, p: i32) bool { s.at(p) == '"' || s.at(p) == '\'' }
STD_MARKER_LEN* := 6
COMPILER_MARKER_LEN* := 11
USER_MARKER_LEN* := 2
id_is_user* = (id: String) bool { id.len >= 2 && id.res_sbyte(0) == 'u' && id.res_sbyte(1) == '/' }
id_is_std_io_c* = (id: String) bool {
    id.len == 8
        && id.res_sbyte(0) == 's'
        && id.res_sbyte(1) == 't'
        && id.res_sbyte(2) == 'd'
        && id.res_sbyte(3) == '/'
        && id.res_sbyte(4) == 'i'
        && id.res_sbyte(5) == 'o'
        && id.res_sbyte(6) == '/'
        && id.res_sbyte(7) == 'c'
}
// String-backed line set: `name\n` entries, scanned without per-name allocation.
res_sbyte* = (s: String, i: i64) u8 { load(offset(s.ptr, i)) }
line_eq = (set: String, i: i64, name: String, j: i64, m: i64) bool {
    (j == m).match ({
        true  => set.res_sbyte(i) == '\n',
        false => (set.res_sbyte(i) == name.res_sbyte(j)).match ({
            true  => set.line_eq(i + 1, name, j + 1, m),
            false => false,
        }),
    })
}
seen_scan = (set: String, name: String, i: i64) bool {
    (i >= set.len).match ({
        true  => false,
        false => set.line_eq(i, name, 0, name.len).match ({
            true  => true,
            false => set.seen_scan(name, set.snext_line(i)),
        }),
    })
}
snext_line* = (set: String, i: i64) i64 {
    (i >= set.len).match ({
        true  => set.len,
        false => (set.res_sbyte(i) == '\n').match ({
            true  => i + 1,
            false => set.snext_line(i + 1),
        }),
    })
}
seen_name* = (set: String, name: String) bool { set.seen_scan(name, 0) }
add_name* = (set: String, a: MutPtr<Malloc>, name: String) String {
    set.rappend_string(a, name).rpush(a, 10)
}
// O(1)-average presence set over the shadow-rename pass's symbol keys, replacing the newline-delimited
// String + linear `seen_name` scan (which made shadow_rename_set O(n²) in decl count — 50k trivial fns
// never finished). Keys are the clean, NUL-terminated identifiers `symbol_key_in`/`symbol_name_alloc`
// mint, so a content-hashed Map matches the old explicit-length String comparison byte-for-byte. The
// "" seed is a sentinel: identifiers are never empty, so it is never a real query. Val is a presence
// marker (0); membership is by key.
rset_new* = (a: MutPtr<Malloc>) Map<i64> {
    seed: i64 := 0 - 1
    of(a, "", seed).expect("std.internal.resolve: rset alloc")
}
rset_add* = (m: Map<i64>, a: MutPtr<Malloc>, key: String) Map<i64> {
    m.put(a, cstr(key.ptr), 0).expect("std.internal.resolve: rset alloc")
}
rset_add_str* = (m: Map<i64>, a: MutPtr<Malloc>, name: string_view) Map<i64> {
    m.put(a, name, 0).expect("std.internal.resolve: rset alloc")
}
rset_has* = (m: Map<i64>, key: String) bool { m.has(cstr(key.ptr)) }
// resolve's allocator-first String helpers now delegate to compiler.genc's canonical generic
// gstr_* builder (one implementation for the whole compiler). The only difference is the arg
// convention: m* take the allocator first (s.gstr_push(a, b)); gstr_* take the String first.
mappend_string* = (a: MutPtr<Malloc>, out: String, src: String) String {
    cur := out
    bs: [u8] := src.bytes()
    bs.loop((h, i, b) {
        cur = cur.gstr_push(a, b)
    })
    cur
}
mcopy_from = (a: MutPtr<Malloc>, out: String, src: String, i: i64) String {
    cur := out
    bs: [u8] := src.bytes()
    bs.loop((h, idx, b) {
        (idx < i == false).then({
            cur = cur.gstr_push(a, b)
        })
    })
    cur
}
// Append s[p..e) (stopping early at NUL) to `out`. Iterates a sub-slice that starts at `p` — NOT a
// scan from 0, and NOT recursive — so copying a span out of a large flattened source is O(e-p) and
// uses constant stack regardless of span length.
mappend_span = (a: MutPtr<Malloc>, out: String, s: string_view, p: i32, e: i32) String {
    cur := out
    (p < e).then({
        span: [u8] := slice(s.offset(p), to_i64(e - p))
        span.loop((h, i, b) {
            (b == 0).match ({
                true  => {
                    h.break
                },
                false => {
                    cur = cur.gstr_push(a, b)
                },
            })
        })
    })
    cur
}
rpush* = (s: String, a: MutPtr<Malloc>, b: u8) String { s.gstr_push(a, b) }
rappend* = (s: String, a: MutPtr<Malloc>, t: string_view) String { s.gstr_append(a, t) }
rappend_string* = (s: String, a: MutPtr<Malloc>, src: String) String { a.mappend_string(s, src) }
rappend_span* = (s: String, a: MutPtr<Malloc>, src: string_view, p: i32, e: i32) String {
    a.mappend_span(s, src, p, e)
}
mcopy_id_dotted = (a: MutPtr<Malloc>, out: String, id: String, i: i64) String {
    cur := out
    bs: [u8] := id.bytes()
    bs.loop((h, idx, b) {
        (idx < i == false).then({
            (b == '/').match ({
                true  => {
                    cur = cur.gstr_push(a, '.')
                },
                false => {
                    cur = cur.gstr_push(a, b)
                },
            })
        })
    })
    cur
}
mappend_id_name* = (a: MutPtr<Malloc>, out: String, id: String) String {
    cur := out
    id.id_is_user().match ({
        true  => {
            cur = a.mcopy_id_dotted(cur, id, 2)
        },
        false => {
            cur = a.mcopy_id_dotted(cur, id, 0)
        },
    })
    cur
}
madd_name* = (a: MutPtr<Malloc>, set: String, name: String) String {
    hs := a.mappend_string(set, name)
    hs.gstr_push(a, 10)
}
madd_str_name* = (a: MutPtr<Malloc>, set: String, name: string_view) String {
    hs := set.gstr_append(a, name)
    hs.gstr_push(a, 10)
}
// `useen` is the cross-module duplicate-definition map: dedup key → table index of the module that
// FIRST provided that name (so a later redefinition names BOTH modules in the diagnostic). An O(1)
// import-map replacing the old newline-delimited `key\tORIGIN` String and its linear rescans.
Closure: {
    seen: String,
    out: String,
    useen: Map<i64>,
}
empty_closure = (a: MutPtr<Malloc>) Closure {
    seed: i64 := 0 - 1
    Closure(
        seen: a.gstr_string(256),
        out: a.gstr_string(4096),
        useen: of(a, "", seed).expect("std.internal.resolve: useen alloc"),
    )
}
ImportEdge*: {
    module: string_view,
    alias: string_view,
    namespace: bool,
    start: i32,
    next: i32,
}
ProvidedSymbol*: {
    name: string_view,
    start: i32,
    next: i32,
    decl_start: i32,
    decl_next: i32,
    imported: bool,
    foreign: bool,
    is_type: bool,
    is_pub: bool,
}    // is_pub: the decl name carries the `*` export marker (imported symbols: false)
// ── ModuleSig: first-class per-module signature (Stage B3) ───────────────────────────────────────
// One O(1) name → flags map per module, built ONCE when the module's source is symbol-scanned and
// carried on its ModuleGraph (the ModuleTable keys it by ModuleId). Every consumer that used to
// re-scan the [ProvidedSymbol] array per query — import-head validation, visibility enforcement,
// `graph.has` — now asks the sig. Flags pack the per-name facts (decoded by /bit%2, no bitwise ops):
//   SIG_PUB       the decl name carries the `*` export marker
//   SIG_TYPE      a struct/enum decl
//   SIG_IMPORTED  bound by an import head (re-export pass-through)
//   SIG_FOREIGN   a bodyless foreign decl
// A raw C-keyword decl name (`double`) is ALSO stored under its `_zk`-escaped form, so raw source
// queries (visibility scans) and escaped import-head queries (check_head) hit the same entry —
// exactly the pair `symbol_matches` accepted. Insertion is first-occurrence-wins (put-if-absent),
// matching the old first-match array scans.
SIG_PUB* := 1
SIG_TYPE* := 2
SIG_IMPORTED* := 4
SIG_FOREIGN* := 8
ModuleSig*: {
    names: Map<i64>,
    has = (s: ModuleSig, name: string_view) bool { s.names.has(name) }
    flags = (s: ModuleSig, name: string_view) i64 { s.names.get(name, 0 - 1) }
    private = (s: ModuleSig, name: string_view) bool {
        // defined here but NOT exported? (imported pass-through = sanctioned re-export, stays visible;
        // an unknown name is NOT private — it is left to the unknown-name validation.)
        f := s.names.get(name, 0 - 1)
        (f < 0).match ({
            true  => false,
            false => f / SIG_IMPORTED % 2 == 0 && f / SIG_PUB % 2 == 0,
        })
    }
    exports_value = (s: ModuleSig, name: string_view) bool {
        // a value export: public, defined here (not imported), and not a type.
        f := s.names.get(name, 0 - 1)
        (f < 0).match ({
            true  => false,
            false => f / SIG_PUB % 2 == 1 && f / SIG_IMPORTED % 2 == 0 && f / SIG_TYPE % 2 == 0,
        })
    }
}
ModuleGraph*: {
    imports: [ImportEdge],
    symbols: [ProvidedSymbol],
    sig: ModuleSig,
    import_count = (g: ModuleGraph) i64 { g.imports.len }
    symbol_count = (g: ModuleGraph) i64 { g.symbols.len }
    has = (g: ModuleGraph, name: string_view) bool { g.sig.has(name) }
}
ModuleEntry*: {
    id: string_view,
    path: string_view,
    source: string_view,
    graph: ModuleGraph,
}
string_eq_str = (name: String, s: string_view) bool {
    ok := true
    bs: [u8] := name.bytes()
    bs.loop((h, i, b) {
        ok.match ({
            true  => (s.at(to_i32(i)) == b == false).then({
                ok = false
                h.break
            }),
            false => {
                h.break
            },
        })
    })
    ok && s.at(to_i32(name.len)) == 0
}
ModuleTable*: {
    modules: [ModuleEntry],
    count = (t: ModuleTable) i64 { t.modules.len }
    has = (t: ModuleTable, id: string_view) bool {
        found := false
        t.modules.loop((h, i, m) {
            found = (m.id == id).match ({ true => true, false => found })
        })
        found
    }
    has_id = (t: ModuleTable, id: String) bool {
        found := false
        t.modules.loop((h, i, m) {
            found = id.string_eq_str(m.id).match ({ true => true, false => found })
        })
        found
    }
    module = (t: ModuleTable, id: string_view) ModuleEntry {
        found := t.modules[0]
        t.modules.loop((h, i, m) {
            found = (m.id == id).match ({ true => m, false => found })
        })
        found
    }
    module_id = (t: ModuleTable, id: String) ModuleEntry {
        found := t.modules[0]
        t.modules.loop((h, i, m) {
            found = id.string_eq_str(m.id).match ({ true => m, false => found })
        })
        found
    }
    index_of_id = (t: ModuleTable, id: String) i64 {
        found := 0 - 1
        t.modules.loop((h, i, m) {
            (found < 0 && id.string_eq_str(m.id)).then({
                found = i
            })
        })
        found
    }
}
// One appended module body in the flat: `midx` indexes ResolvedProgram.table.modules (0 = the entry
// module), [lo, hi) is the body's byte span in the FINAL flat (kept exact through the shadow-rename
// splices and the dedup drops), and [line_lo, line_lo+line_n) indexes ResolvedProgram.line_srcs —
// for each kept flat line of the region, its 1-based line number in the module's ORIGINAL source.
// A module bound under several namespace aliases is appended once per bind, so it may own several
// regions; regions are recorded in append order (ascending lo), which is what fregion_find assumes.
FlatRegion*: {
    midx: i64,
    lo: i64,
    hi: i64,
    line_lo: i64,
    line_n: i64,
}
ResolvedProgram*: {
    table: ModuleTable,
    flat: string_view,
    body_start: i64,
    body_end: i64,
    regions: [FlatRegion],
    line_srcs: [i32],
}
ParsedModule*: {
    id: string_view,
    path: string_view,
    source: string_view,
    body: string_view,
    graph: ModuleGraph,
    decls: [Decl],
}
ParsedProgram*: {
    resolved: ResolvedProgram,
    modules: [ParsedModule],
    flat_decls: [Decl],
    count = (p: ParsedProgram) i64 { p.modules.len }
    module = (p: ParsedProgram, id: string_view) ParsedModule {
        found := p.modules[0]
        p.modules.loop((h, i, m) {
            found = (m.id == id).match ({ true => m, false => found })
        })
        found
    }
}
// One-pass DFS loader state: `entries[0..n)` is the table so far (entry 0 = root, then DFS
// import-edge preorder), `seen` the id dedup set. The buffer grows geometrically, so each
// dependency is read from disk and symbol-scanned exactly ONCE (the old shape ran a counting
// pass that read+scanned every dep, then a fill pass that read+scanned them all AGAIN).
ModuleLoad: {
    seen: String,
    entries: [ModuleEntry],
    n: i64,
}
// The REAL libc prototype is `void exit(int)` — declaring it `i32` here was FFI drift (caught by
// `make ffi-verify`, and std.io.c's AST libc table already said tvoid). `die` is the value-position
// form: exit never returns, so the 0 only exists to give a match arm / tail expression a value.
exit* = (code: i32) void
die* = (code: i32) i32 {
    exit(code)
    0
}
eprint* = (s: string_view) i64 {
    v := view(s)
    write(2, v.ptr, v.len)
}
// ── NAMESPACE-IMPORT CYCLE GUARD ───────────────────────────────────────────────────────────────
// The namespace-closure loader (load_ns_closure_graph_table ↔ collect_ns_*_table) follows `m = pkg.mod`
// alias edges with no seen-set, so a self-referential or cyclic alias (`a = a`, or a→b→a) recurses
// forever and overflows the C stack (SIGSEGV). A nesting counter bounds it: real dependency chains
// are a handful deep (the whole compiler is well under the cap), so this never fires on acyclic input
// and leaves the flattened output byte-identical; a genuine cycle trips the cap and exits cleanly.
ns_depth := 0
NS_DEPTH_CAP := 256
fail_import_cycle = (a: MutPtr<Malloc>, inpath: string_view, id: String) i32 {
    msg0 := a
        .gstr_string(160)
        .gstr_append(a, "zenc: ")
        .gstr_append(a, inpath)
        .gstr_append(a, ": error: import cycle through namespace alias '")
    msg1 := a.mappend_id_name(msg0, id)
    tail := msg1.gstr_append(a, "' (a module cannot namespace-import itself, directly or transitively)")
    line := tail.gstr_push(a, 10)
    eprint(line.gstr_finish(a))
    exit(1)
    0
}
// Probe first so missing modules get a distinct error from unreadable modules.
file_exists* = (path: string_view) bool {
    fd := open(path, O_RDONLY, 0)
    (fd >= 0).match ({
        true  => {
            close(fd)
            true
        },
        false => false,
    })
}
fail_unknown_module = (a: MutPtr<Malloc>, inpath: string_view, id: String, path: string_view) i32 {
    msg := a.mappend_id_name(a
        .gstr_string(160)
        .gstr_append(a, "zenc: ")
        .gstr_append(a, inpath)
        .gstr_append(a, ": error: unknown module '"), id)
    m2 := msg
    id.id_is_user().match ({
        true  => {
            u0 := msg.gstr_append(a, "' (no ")
            u1 := a.mcopy_from(u0, id, 2)
            m2 = u1.gstr_append(a, ".zen next to ").gstr_append(a, inpath)
        },
        false => {
            m2 = msg.gstr_append(a, "' (no ").gstr_append(a, path)
        },
    })
    close_msg := m2.gstr_append(a, ")")
    line := close_msg.gstr_push(a, 10)
    eprint(line.gstr_finish(a))
    exit(1)
    0
}
fail_unreadable = (a: MutPtr<Malloc>, inpath: string_view, path: string_view) string_view {
    msg := a
        .gstr_string(160)
        .gstr_append(a, "zenc: ")
        .gstr_append(a, inpath)
        .gstr_append(a, ": error: cannot read module file ")
    with_path := msg.gstr_append(a, path)
    line := with_path.gstr_push(a, 10)
    eprint(line.gstr_finish(a))
    exit(1)
    ""
}
read_module_file = (a: MutPtr<Malloc>, path: string_view) Result<string_view, IoError> {
    a.contents_in(path)
}
read_module = (a: MutPtr<Malloc>, inpath: string_view, path: string_view) string_view {
    a.read_module_file(path).match ({
        .Ok(s)  => s,
        .Err(e) => a.fail_unreadable(inpath, path),
    })
}
fail_unknown_name = (a: MutPtr<Malloc>, inpath: string_view, nm: String, id: String) i32 {
    msg0 := a
        .gstr_string(160)
        .gstr_append(a, "zenc: ")
        .gstr_append(a, inpath)
        .gstr_append(a, ": error: unknown name '")
    msg1 := a.mappend_string(msg0, nm)
    in_mod := msg1.gstr_append(a, "' in module '")
    msg2 := a.mappend_id_name(in_mod, id)
    tail := msg2.gstr_append(a, "' (no such top-level definition)")
    line := tail.gstr_push(a, 10)
    eprint(line.gstr_finish(a))
    exit(1)
    0
}
fail_dup_user = (
    a: MutPtr<Malloc>,
    inpath: string_view,
    id: String,
    nm: String,
    origin: String,
) i32 {
    msg0 := a
        .gstr_string(256)
        .gstr_append(a, "zenc: ")
        .gstr_append(a, inpath)
        .gstr_append(a, ": error: duplicate top-level definition '")
    msg1 := a.mappend_string(msg0, nm)
    in_mod := msg1.gstr_append(a, "' (module '")
    msg2 := a.mappend_id_name(in_mod, id)
    redef := msg2.gstr_append(a, "' redefines '")
    rnm := a.mappend_string(redef, nm)
    from := rnm.gstr_append(a, "', already provided by '")
    msg3 := a.mappend_id_name(from, origin)
    tail := msg3.gstr_append(a, "')")
    l1 := tail.gstr_push(a, 10)
    // actionable hint: rename, or reach the original through a namespace alias instead of a bare import
    h0 := l1.gstr_append(a, "hint: rename '")
    h1 := a.mappend_string(h0, nm)
    h2 := h1.gstr_append(a, "', or import '")
    h3 := a.mappend_id_name(h2, origin)
    h4 := h3.gstr_append(a, "' qualified — e.g. `m = ")
    h5 := a.mappend_id_name(h4, origin)
    h6 := h5.gstr_append(a, "` then `m.")
    h7 := a.mappend_string(h6, nm)
    h8 := h7.gstr_append(a, "(...)`")
    line := h8.gstr_push(a, 10)
    eprint(line.gstr_finish(a))
    exit(1)
    0
}
fail_no_progdir = (a: MutPtr<Malloc>, inpath: string_view, id: String) i32 {
    msg0 := a
        .gstr_string(160)
        .gstr_append(a, "zenc: ")
        .gstr_append(a, inpath)
        .gstr_append(a, ": error: sibling import '")
    msg1 := a.mappend_id_name(msg0, id)
    tail := msg1.gstr_append(a, "' needs a source file on disk (stdin has no directory to load it from)")
    line := tail.gstr_push(a, 10)
    eprint(line.gstr_finish(a))
    exit(1)
    0
}
// ── CANONICAL ModuleId → path ────────────────────────────────────────────────────────────────
// THE one id→file mapping — every id→path decision (table build, closure load, the driver's cache
// probe) goes through here; it is the future Stage-B World key, so it stays pure (no IO).
//   std/… , compiler/…      → <root>/src/<id>.zen                    (repo tree, unchanged)
//   u/<seg>[/<seg>…]        → <progdir>/<seg>[/<seg>…].zen
// USER ids form ONE flat progdir-rooted logical namespace: source id `utils.strings` is internal id
// `u/utils/strings` → <progdir>/utils/strings.zen, where progdir is the ENTRY PROGRAM's directory.
// A user module in a subdirectory names its own dependencies by full dotted id from that same root
// (`utils.helpers`, never a relative/implicit sibling) — one registered source root, no ambiguity.
// EXCEPTION, consulted first and only for user ids: the registered c_library genmod map (see
// genmods_set below) — an id the build granted via `use()` resolves to its GENERATED file.
module_path* = (
    a: MutPtr<Malloc>,
    root: string_view,
    progdir: string_view,
    id: String,
) string_view {
    gp := a.genmod_lookup(id)
    (gp.at(0) == 0).match ({
        true  => {
            out := a.gstr_string(64)
            id.id_is_user().match ({
                true  => {
                    p0 := out.gstr_append(a, progdir)
                    p1 := p0.gstr_append(a, "/")
                    p2 := a.mcopy_from(p1, id, 2)
                    out = p2.gstr_append(a, ".zen")
                },
                false => {
                    p0 := out.gstr_append(a, root)
                    p1 := p0.gstr_append(a, "/src/")
                    p2 := a.mappend_string(p1, id)
                    out = p2.gstr_append(a, ".zen")
                },
            })
            out.gstr_finish(a)
        },
        false => gp,
    })
}
guard_module = (
    a: MutPtr<Malloc>,
    progdir: string_view,
    inpath: string_view,
    id: String,
    path: string_view,
) i32 {
    (id.id_is_user() && progdir.at(0) == 0).match ({
        true  => a.fail_no_progdir(inpath, id),
        false => 0,
    })
    file_exists(path).match ({ true => 0, false => a.fail_unknown_module(inpath, id, path) })
}
module_entry_buf = (a: MutPtr<Malloc>, n: i64) [ModuleEntry] {
    slice(a.acquire(n * sizeof(ModuleEntry)), n)
}
// Append an entry, doubling the buffer when full (DFS preorder is preserved: an entry is pushed
// BEFORE its own import edges are followed, exactly the order the old fill pass wrote).
mload_push = (a: MutPtr<Malloc>, st: ModuleLoad, e: ModuleEntry) ModuleLoad {
    buf := st.entries
    (st.n >= buf.len).then({
        grown := a.module_entry_buf(buf.len * 2)
        buf.loop((h, i, m) {
            grown[i] = m
        })
        buf = grown
    })
    buf[st.n] = e
    ModuleLoad(
        seen: st.seen,
        entries: buf,
        n: st.n + 1,
    )
}
fill_module_one = (
    a: MutPtr<Malloc>,
    root: string_view,
    progdir: string_view,
    inpath: string_view,
    id: String,
    st: ModuleLoad,
) ModuleLoad {
    st.seen.seen_name(id).match ({
        true  => st,
        false => {
            path := a.module_path(root, progdir, id)
            a.guard_module(progdir, inpath, id, path)
            src := a.read_module(inpath, path)
            graph := a.module_graph(src)
            next := a.mload_push(ModuleLoad(
                seen: st.seen.add_name(a, id),
                entries: st.entries,
                n: st.n,
            ), ModuleEntry(
                id: id.gstr_finish(a),
                path: path,
                source: src,
                graph: graph,
            ))
            a.fill_module_edges(root, progdir, inpath, graph.imports, next)
        },
    })
}
fill_module_edges = (
    a: MutPtr<Malloc>,
    root: string_view,
    progdir: string_view,
    inpath: string_view,
    edges: [ImportEdge],
    st: ModuleLoad,
) ModuleLoad {
    cur := st
    edges.loop((h, i, edge) {
        cur = a.fill_module_one(root, progdir, inpath, edge.edge_id_in(a), cur)
    })
    cur
}
module_table_graph = (
    a: MutPtr<Malloc>,
    root: string_view,
    progdir: string_view,
    inpath: string_view,
    mainsrc: string_view,
    graph: ModuleGraph,
) ModuleTable {
    st := a.fill_module_edges(root, progdir, inpath, graph.imports, a.mload_push(ModuleLoad(
        seen: a.gstr_string(256),
        entries: a.module_entry_buf(8),
        n: 0,
    ), ModuleEntry(
        id: "",
        path: inpath,
        source: mainsrc,
        graph: graph,
    )))
    ModuleTable(modules: slice(st.entries.ptr, st.n))
}
load_closure_table = (
    a: MutPtr<Malloc>,
    table: ModuleTable,
    inpath: string_view,
    id: String,
    c: Closure,
) Closure {
    c.seen.seen_name(id).match ({
        true  => c,
        false => {
            entry := table.module_id(id)
            graph := entry.graph
            u2 := id.id_is_user().match ({
                true  => a.user_decls_from_symbols(c.useen, graph.symbols, 0, table, id, inpath),
                false => c.useen,
            })
            c2 := Closure(
                seen: a.madd_name(c.seen, id),
                out: c.out,
                useen: u2,
            )
            c3 := a.load_import_graph_table(table, inpath, entry.source, graph, id.id_is_user(), c2)
            ns := a.collect_ns_graph_table(table, inpath, entry.source, graph, a.ns_scan(c3))
            blo := ns.c.out.len
            llo := lmap_lines()
            body := ns.c.out.strip_ns_into(a, entry.source, 0, ns.quals, ns.qnames, ns.strip_qnames, ns.strip_all_quals, false)
            id.id_is_user().then({
                note_uregion(entry.id, blo, body.len)
            })
            a.note_fregion(table.index_of_id(id), body.freg_lo(blo), body.len, llo)
            Closure(
                seen: ns.c.seen,
                out: body,
                useen: ns.c.useen,
            )
        },
    })
}
load_import_edges_table = (
    a: MutPtr<Malloc>,
    table: ModuleTable,
    inpath: string_view,
    src: string_view,
    edges: [ImportEdge],
    i: i64,
    validate: bool,
    c: Closure,
) Closure {
    cur := c
    edges.loop((h, idx, edge) {
        (idx < i == false).then({
            (edge.namespace == false).then({
                id := edge.edge_id_in(a)
                cur = a.load_closure_table(table, inpath, id, cur)
                validate.match ({
                    true  => table.check_import_names_table(a, src, edge.start, id, inpath),
                    false => 0,
                })
            })
        })
    })
    cur
}
load_import_graph_table = (
    a: MutPtr<Malloc>,
    table: ModuleTable,
    inpath: string_view,
    src: string_view,
    graph: ModuleGraph,
    validate: bool,
    c: Closure,
) Closure { a.load_import_edges_table(table, inpath, src, graph.imports, 0, validate, c) }
load_ns_edge_table = (
    a: MutPtr<Malloc>,
    table: ModuleTable,
    inpath: string_view,
    src: string_view,
    edge: ImportEdge,
    st: NsScan,
) NsScan {
    modid := edge.edge_id_in(a)
    alias := edge.edge_alias_in(a)
    entry := table.module_id(modid)
    graph := entry.graph
    names := graph.value_decl_names_in(a)
    all := graph.all_decl_names_in(a)
    c2 := a.load_ns_closure_graph_table(table, inpath, modid, alias, entry.source, graph, st.c)
    q2 := a.madd_name(st.quals, alias)
    qn2 := st.qnames.add_qual_names(a, alias, names, 0)
    sqn2 := st.strip_qnames.add_qual_names(a, alias, all, 0)
    saq2 := modid.id_is_std_io_c().match ({
        true  => a.madd_name(st.strip_all_quals, alias),
        false => st.strip_all_quals,
    })
    NsScan(
        quals: q2,
        qnames: qn2,
        strip_qnames: sqn2,
        strip_all_quals: saq2,
        c: c2,
    )
}
collect_ns_edges_table = (
    a: MutPtr<Malloc>,
    table: ModuleTable,
    inpath: string_view,
    src: string_view,
    edges: [ImportEdge],
    i: i64,
    st: NsScan,
) NsScan {
    cur := st
    edges.loop((h, idx, edge) {
        (idx < i == false).then({
            edge.namespace.then({
                cur = a.load_ns_edge_table(table, inpath, src, edge, cur)
            })
        })
    })
    cur
}
collect_ns_graph_table = (
    a: MutPtr<Malloc>,
    table: ModuleTable,
    inpath: string_view,
    src: string_view,
    graph: ModuleGraph,
    st: NsScan,
) NsScan { a.collect_ns_edges_table(table, inpath, src, graph.imports, 0, st) }
mimport_name_span* = (a: MutPtr<Malloc>, flat: string_view, p: i32, e: i32) String {
    a.mappend_span(a.gstr_string(16), flat, p, e)
}
mimport_head_name* = (a: MutPtr<Malloc>, src: string_view, p: i32, e: i32) String {
    raw := a.mimport_name_span(src, p, e)
    out := raw
    src.is_c_kw_name_span(p, e).then({
        out = raw.gstr_append(a, "_zk")
    })
    out
}
check_import_names_table = (
    table: ModuleTable,
    a: MutPtr<Malloc>,
    src: string_view,
    p: i32,
    id: String,
    inpath: string_view,
) i32 {
    entry := table.module_id(id)
    src.check_head(a, src.lstrip(p) + 1, entry.graph.sig, id, inpath)
}
check_head = (
    src: string_view,
    a: MutPtr<Malloc>,
    p: i32,
    provided: ModuleSig,
    id: String,
    inpath: string_view,
) i32 {
    pos := p
    bs: [u8] := src.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos == false).then({
            (b == '}' || b == 0).match ({
                true  => {
                    h.break
                },
                false => b.is_alpha().match ({
                    true  => {
                        ie := src.res_ident_end(pos)
                        raw := a.mimport_name_span(src, pos, ie)
                        hd := a.mimport_head_name(src, pos, ie)
                        nm := hd.gstr_finish(a)
                        provided.has(nm).match ({
                            true  => 0,
                            false => a.fail_unknown_name(inpath, raw, id),
                        })
                        pos = ie
                    },
                    false => {
                        pos = pos + 1
                    },
                }),
            })
        })
    })
    0
}
// Register one module-defined symbol in `useen` (key → origin table index); a key already present
// is a cross-module duplicate — fail naming BOTH the redefining module and the first provider.
user_symbol_seen = (
    a: MutPtr<Malloc>,
    useen: Map<i64>,
    s: ProvidedSymbol,
    table: ModuleTable,
    id: String,
    inpath: string_view,
) Map<i64> {
    key := s.symbol_key_in(a).expect("std.internal.resolve: allocation failed")
    kv := cstr(key.ptr)
    prev := useen.get(kv, 0 - 1)
    (prev >= 0).then({
        origin := a.gstr_string(24).gstr_append(a, table.modules[prev].id)
        a.fail_dup_user(inpath, id, s.symbol_name_in(a), origin)
    })
    useen.put(a, kv, table.index_of_id(id)).expect("std.internal.resolve: useen alloc")
}
user_decls_from_symbols = (
    a: MutPtr<Malloc>,
    useen: Map<i64>,
    symbols: [ProvidedSymbol],
    i: i64,
    table: ModuleTable,
    id: String,
    inpath: string_view,
) Map<i64> {
    cur := useen
    symbols.loop((h, idx, sym) {
        (idx < i == false).then({
            (sym.imported == false).then({
                cur = a.user_symbol_seen(cur, sym, table, id, inpath)
            })
        })
    })
    cur
}
first_user_import_in* = (a: MutPtr<Malloc>, src: string_view) string_view {
    hs := fui_scan(a.gstr_string(16), a, src, 0)
    hs.gstr_finish(a)
}
fui_scan = (out: String, a: MutPtr<Malloc>, src: string_view, p: i32) String {
    cur := out
    pos := p
    done := false
    bs: [u8] := src.view()
    bs.loop((h, i, b) {
        done.match ({
            true  => {
                h.break
            },
            false => (src.at(pos) == 0).match ({
                true  => {
                    h.break
                },
                false => src.is_import_line(pos).match ({
                    true  => {
                        mk := src.import_marker_from(src.lstrip(pos))
                        src.is_user_marker_at(mk).match ({
                            true  => {
                                cur = cur.take_dotted(a, src, mk + USER_MARKER_LEN)
                                done = true
                                h.break
                            },
                            false => {
                                pos = src.import_end(pos)
                            },
                        })
                    },
                    false => {
                        pos = src.next_line(pos)
                    },
                }),
            }),
        })
    })
    cur
}
// Per-name dedup keeps user shadowing visible for validation. Repo-internal
// std/compiler entry modules may own a natural export name over dependency
// closures, because their dependencies are implementation details.
res_ident_end* = (flat: string_view, p: i32) i32 {
    flat.at(p).is_alnum().match ({ true => flat.res_ident_end(p + 1), false => p })
}
append_to_nul* = (out: String, a: MutPtr<Malloc>, s: string_view, p: i32) String {
    cur := out
    bs: [u8] := s.view()
    bs.loop((h, i, b) {
        (i < p == false).then({
            cur = cur.rpush(a, b)
        })
    })
    cur
}
path_has_at = (s: string_view, p: i32, lit: string_view, i: i32) bool {
    (lit.at(i) == 0).match ({
        true  => true,
        false => (s.at(p + i) == 0).match ({
            true  => false,
            false => s.at(p + i) == lit.at(i) && s.path_has_at(p, lit, i + 1),
        }),
    })
}
path_contains_from = (s: string_view, p: i32, lit: string_view) bool {
    (s.at(p) == 0).match ({
        true  => lit.at(0) == 0,
        false => s.path_has_at(p, lit, 0).match ({
            true  => true,
            false => s.path_contains_from(p + 1, lit),
        }),
    })
}
path_contains = (s: string_view, lit: string_view) bool { s.path_contains_from(0, lit) }
internal_source_path = (path: string_view) bool {
    path.path_contains("/src/std/")
        || path.path_contains("src/std/")
        || path.path_contains("/src/compiler/")
        || path.path_contains("src/compiler/")
}
main_symbol_names = (
    a: MutPtr<Malloc>,
    set: String,
    symbols: [ProvidedSymbol],
    i: i64,
    bodystart: i64,
    bodyend: i64,
) String {
    cur := set
    symbols.loop((h, idx, sym) {
        (idx < i == false).then({
            (sym.imported == false).then({
                key := sym.symbol_key_in(a).expect("std.internal.resolve: allocation failed")
                inmain := sym.start >= bodystart && sym.start < bodyend
                cur = (inmain && cur.seen_name(key).match ({ true => false, false => true })).match ({
                    true  => a.madd_name(cur, key),
                    false => cur,
                })
            })
        })
    })
    cur
}
dedup_decls* = (a: MutPtr<Malloc>, flat: string_view, bodystart: i64, bodyend: i64) string_view {
    a.dedup_decls_mode(flat, bodystart, bodyend, false)
}
dedup_decls_mode = (
    a: MutPtr<Malloc>,
    flat: string_view,
    bodystart: i64,
    bodyend: i64,
    allow_main_shadow: bool,
) string_view {
    a.dedup_decls_syms(flat, a.module_graph(flat).symbols, bodystart, bodyend, allow_main_shadow)
}
// symbols-taking core: resolve_program_data reuses the pre-shadow graph when no rename fired, so the
// expensive whole-flat module_graph scan runs once, not twice.
dedup_decls_syms = (
    a: MutPtr<Malloc>,
    flat: string_view,
    symbols: [ProvidedSymbol],
    bodystart: i64,
    bodyend: i64,
    allow_main_shadow: bool,
) string_view {
    main_names := allow_main_shadow.match ({
        true  => a.main_symbol_names(a.gstr_string(256), symbols, 0, bodystart, bodyend),
        false => a.gstr_string(64),
    })
    hs := a.dedup_symbols(a.gstr_string(4096), flat, symbols, 0, 0, a.gstr_string(256), a.gstr_string(64), main_names, bodystart, bodyend, allow_main_shadow)
    hs.gstr_finish(a)
}
dedup_symbols = (
    a: MutPtr<Malloc>,
    out: String,
    flat: string_view,
    symbols: [ProvidedSymbol],
    i: i64,
    p: i32,
    set: String,
    mainset: String,
    main_names: String,
    bodystart: i64,
    bodyend: i64,
    allow_main_shadow: bool,
) String {
    cur := out
    pos := p
    seen := set
    main_seen := mainset
    symbols.loop((h, idx, sym) {
        (idx < i == false).then({
            (sym.imported == false).then({
                nm := sym.symbol_key_in(a).expect("std.internal.resolve: allocation failed")
                inmain := sym.start >= bodystart && sym.start < bodyend
                shadow := allow_main_shadow
                    && inmain.match ({ true => false, false => true })
                    && main_names.seen_name(nm)
                keep := shadow.match ({
                    true  => false,
                    false => inmain.match ({
                        true  => true,
                        false => seen.seen_name(nm).match ({
                            true  => main_seen.seen_name(nm),
                            false => true,
                        }),
                    }),
                })
                cur = cur.rappend_span(a, flat, pos, sym.decl_start)
                keep.then({
                    cur = cur.rappend_span(a, flat, sym.decl_start, sym.decl_next)
                })
                (keep == false).then({
                    a.note_ldrop(to_i64(sym.decl_start), to_i64(sym.decl_next))
                })
                seen = shadow.match ({
                    true  => seen,
                    false => seen.seen_name(nm).match ({
                        true  => seen,
                        false => a.madd_name(seen, nm),
                    }),
                })
                main_seen = inmain.match ({
                    true  => a.madd_name(main_seen, nm),
                    false => main_seen,
                })
                pos = sym.decl_next
            })
        })
    })
    cur.append_to_nul(a, flat, pos)
}
// ── impl-block dedup ─────────────────────────────────────────────────────────────────────────
// A `T.impl(Trait, {…})` block carries no ProvidedSymbol (decl_span marks it unnamed), so the
// per-name dedup above never touches it. Once TYPE names are canonicalized (value_decl_names_in keeps
// them bare across import paths), the SAME module reached two ways — a namespace alias `x = M` plus a
// by-name/other-alias load of M — emits its impls twice with the SAME canonical receiver, e.g. two
// `Heap.impl(Allocator)` → duplicate `impl_Allocator_Heap_*` functions. A trait has at most one impl per
// (canonical) type, so two blocks with the same `<receiver>.<trait>` key that are copies of ONE source
// block are redundant: keep the first, drop the rest. Distinct impls (different receiver OR trait) get
// distinct keys and all survive. But a same-key block that is NOT a copy — a genuinely different body
// for the same (receiver, trait), in one module or across two — must never be eaten silently ("first
// wins" would drop live code); that is error[dup-impl]. Copy-vs-conflict is decided by ORIGIN identity
// (module + original source line via the region/line maps), not body text: an alias emission rewrites
// module-local calls to `alias__name`, so two flat copies of one source block need not be byte-equal.
impl_lparen = (s: string_view, p: i32) i32 {
    (s.at(p) == 0).match ({
        true  => p,
        false => (s.at(p) == '(').match ({ true => p + 1, false => s.impl_lparen(p + 1) }),
    })
}
impl_key_in = (a: MutPtr<Malloc>, s: string_view, p: i32) String {
    re := s.res_ident_end(p)    // receiver ident `Heap`
    ts := s.lstrip(s.impl_lparen(re))    // first arg of `.impl(` — the trait
    te := s.res_ident_end(ts)
    a
        .gstr_string(40)
        .rappend_span(a, s, p, re)
        .gstr_append(a, ".")
        .rappend_span(a, s, ts, te)
}
// One impl block's ORIGIN identity: the module (table index) and 1-based ORIGINAL source line the
// block came from, read off the resolver's region/line maps (both in the walked flat's coordinates
// during the dedup pass). Two flat copies of ONE source block — a module emitted once per import
// path — share one identity; two different blocks never do (each opens its own source line).
// midx -1 / line 0 = the offset is unattributable (no region recorded, e.g. a caller outside
// resolve_program_data) — treated as a copy, i.e. today's silent dedup, never a new rejection.
ImplOrigin: {
    midx: i64,
    line: i64,
}
impl_origin_at = (flat: string_view, off: i64) ImplOrigin {
    regions := fregions_get()
    ri := regions.fregion_find(off)
    (ri < 0).match ({
        true  => ImplOrigin(
            midx: 0 - 1,
            line: 0,
        ),
        false => ImplOrigin(
            midx: regions[ri].midx,
            line: to_i64(regions.fregion_src_line(lsrc_get(), flat, ri, off)),
        ),
    })
}
impl_origin_known = (o: ImplOrigin) bool { o.midx >= 0 && o.line > 0 }
// module identity for impl dedup: the PATH, tolerant of a leading `./` (a cycle re-entry or a
// different invocation spelling records the same file under both spellings). Zero-alloc compare.
impl_path_eq = (x: string_view, y: string_view) bool {
    x == y
        || x.starts_with("./") && x.ends_with(y) && x.view().len == y.view().len + 2
        || y.starts_with("./") && y.ends_with(x) && y.view().len == x.view().len + 2
}
// error[dup-impl]: two DIFFERENT `T.impl(Trait, { … })` bodies for one (receiver, trait) — "first
// wins" would silently drop the later body, so reject loudly, naming both source modules.
fail_dup_impl = (
    a: MutPtr<Malloc>,
    table: ModuleTable,
    flat: string_view,
    second: i64,
    o1: ImplOrigin,
    o2: ImplOrigin,
) i32 {
    p := to_i32(second)
    re := flat.res_ident_end(p)
    ts := flat.lstrip(flat.impl_lparen(re))
    te := flat.res_ident_end(ts)
    m1 := table.modules[o1.midx]
    m2 := table.modules[o2.midx]
    m0 := a
        .gstr_string(320)
        .gstr_append(a, "zenc: ")
        .gstr_append(a, m2.path)
        .gstr_push(a, ':')
        .res_udec(a, to_i32(o2.line))
        .gstr_append(a, ":1: error[dup-impl]: conflicting impl blocks for `")
        .rappend_span(a, flat, p, re)
        .gstr_push(a, '.')
        .rappend_span(a, flat, ts, te)
        .gstr_push(a, '`')
    l1 := m0.gstr_push(a, 10)
    d0 := l1
        .gstr_append(a, "  a different `")
        .rappend_span(a, flat, p, re)
        .gstr_append(a, ".impl(")
        .rappend_span(a, flat, ts, te)
        .gstr_append(a, ", { ... })` already exists in ")
    d1 := is_empty(m1.id).match ({
        true  => d0.gstr_append(a, "your program"),
        false => a.mappend_mid_display(d0, m1.id),
    })
    d2 := d1
        .gstr_append(a, " (")
        .gstr_append(a, m1.path)
        .gstr_push(a, ':')
        .res_udec(a, to_i32(o1.line))
        .gstr_push(a, ')')
    l2 := d2.gstr_push(a, 10)
    h0 := l2.gstr_append(a, "hint: a type has one impl per trait — merge the two bodies or delete one block")
    eprint(h0.gstr_push(a, 10).gstr_finish(a))
    exit(1)
    0
}
dedup_impls = (a: MutPtr<Malloc>, table: ModuleTable, flat: string_view) string_view {
    a.dedup_impls_into(a.gstr_string(4096), table, flat, 0, a.rset_new()).gstr_finish(a)
}
dedup_impls_into = (
    a: MutPtr<Malloc>,
    out: String,
    table: ModuleTable,
    flat: string_view,
    p: i32,
    seen: Map<i64>,
) String {
    cur := out
    pos := p
    seen2 := seen
    bs: [u8] := flat.view()
    bs.loop((h, n, b) {
        ii := to_i32(n)
        (ii < pos == false).then({
            sp := a.decl_span(flat, pos)
            (sp.eof || sp.next <= pos).match ({
                true  => {
                    h.break
                },
                false => {
                    cur = cur.rappend_span(a, flat, pos, sp.start)
                    drop := flat.decl_is_impl(sp.start).match ({
                        true  => {
                            key := a.impl_key_in(flat, sp.start).gstr_finish(a)
                            firstoff := seen2.get(key, 0 - 1)
                            (firstoff >= 0).match ({
                                true  => {
                                    o1 := flat.impl_origin_at(firstoff)
                                    o2 := flat.impl_origin_at(to_i64(sp.start))
                                    // a module reached through an import CYCLE gets a second table
                                    // entry with the SAME path — identity is the module's path, not
                                    // its table index, so those copies dedup instead of dup-impl.
                                    same_mod := o1.midx == o2.midx
                                        || table.modules[o1.midx].path.impl_path_eq(table.modules[o2.midx].path)
                                    (o1.impl_origin_known()
                                        && o2.impl_origin_known()
                                        && (same_mod == false || o1.line != o2.line)).then({
                                        a.fail_dup_impl(table, flat, to_i64(sp.start), o1, o2)
                                    })
                                    true
                                },
                                false => {
                                    seen2 = seen2
                                        .put(a, key, to_i64(sp.start))
                                        .expect("std.internal.resolve: impl-seen alloc")
                                    false
                                },
                            })
                        },
                        false => false,
                    })
                    (drop == false).then({
                        cur = cur.rappend_span(a, flat, sp.start, sp.next)
                    })
                    drop.then({
                        a.note_ldrop(to_i64(sp.start), to_i64(sp.next))
                    })
                    pos = sp.next
                },
            })
        })
    })
    cur.append_to_nul(a, flat, pos)
}
// Namespace binds load `c = std.io.c` / `m = sibling` under an alias prefix.
// `c.libc()` rewrites to `c__libc()`, and the bound module's own declarations
// are prefixed the same way, so two modules can export the same short name.
is_ns_line* = (s: string_view, p: i32) bool {
    ls := s.lstrip(p)
    (p == ls).match ({
        true  => s.at(ls).is_alnum().match ({
            true  => s.is_any_marker_at(s.lstrip(s.res_ident_end(ls))),
            false => false,
        }),
        false => false,
    })
}
NsScan: {
    quals: String,
    qnames: String,
    strip_qnames: String,
    strip_all_quals: String,
    c: Closure,
}
ns_scan = (a: MutPtr<Malloc>, c: Closure) NsScan {
    NsScan(
        quals: a.gstr_string(64),
        qnames: a.gstr_string(128),
        strip_qnames: a.gstr_string(128),
        strip_all_quals: a.gstr_string(64),
        c: c,
    )
}
alias_name = (out: String, a: MutPtr<Malloc>, alias: String, name: String) String {
    out.rappend_string(a, alias).rappend(a, "__").rappend_string(a, name)
}
alias_hit = (s: string_view, p: i32, ie: i32, names: String, nm: String) bool {
    after_dot := p > 0 && s.at(p - 1) == '.'
    rewrite_member := after_dot.match ({ true => s.at(s.lstrip(ie)) == '(', false => true })
    names.seen_name(nm) && rewrite_member
}
rewrite_alias_names* = (
    out: String,
    a: MutPtr<Malloc>,
    s: string_view,
    p: i32,
    names: String,
    alias: String,
) String {
    cur := out
    pos := p
    bs: [u8] := s.str_bytes()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos == false).then({
            (b == 0).match ({
                true  => {
                    h.break
                },
                false => s.line_comment_at(pos).match ({
                    true  => {
                        sk := cur.copy_line_comment(a, s, pos)
                        cur = sk.out
                        pos = sk.next
                    },
                    false => s.block_comment_at(pos).match ({
                        true  => {
                            sk := cur.copy_block_comment(a, s, pos)
                            cur = sk.out
                            pos = sk.next
                        },
                        false => s.quoted_at(pos).match ({
                            true  => {
                                sk := cur.copy_literal(a, s, pos)
                                cur = sk.out
                                pos = sk.next
                            },
                            false => (b.is_alpha()
                                && (pos == 0
                                    || s.at(pos - 1).is_alnum().match ({
                                        true  => false,
                                        false => true,
                                    }))).match ({
                                true  => {
                                    ie := s.res_ident_end(pos)
                                    nm := a.mimport_name_span(s, pos, ie)
                                    cur = s.alias_hit(pos, ie, names, nm).match ({
                                        true  => cur.alias_name(a, alias, nm),
                                        false => cur.rappend_span(a, s, pos, ie),
                                    })
                                    pos = ie
                                },
                                false => {
                                    cur = cur.rpush(a, b)
                                    pos = pos + 1
                                },
                            }),
                        }),
                    }),
                }),
            })
        })
    })
    cur
}
// Stage B4/R2: stamp one ns-alias bind's per-module export sig into the compiler.parse registry —
// one SigEntry per provided symbol (name + pub/type/imported/foreign flags + origin ModuleId), so
// the checker can enumerate an alias's exports without a std.internal.resolve import. Stamped at the
// same point the module's body joins the flat (append order = flat decl order). A rebind of the SAME
// module under the SAME alias appends no new body, so it stamps nothing (see module_sig_alias_stamped).
note_module_sigs = (a: MutPtr<Malloc>, alias: String, graph: ModuleGraph, origin: i64) void {
    an := a.gstr_string(16).rappend_string(a, alias).gstr_finish(a)
    (module_sig_alias_stamped(an, origin) == false).then({
        graph.symbols.loop((h, i, sym) {
            note_module_sig(an, sym.name, module_sig_flags(sym.is_pub, sym.is_type, sym.imported, sym.foreign), origin)
        })
    })
}
alias_module_body = (
    a: MutPtr<Malloc>,
    src: string_view,
    graph: ModuleGraph,
    alias: String,
    quals: String,
    qnames: String,
    strip_qnames: String,
    strip_all_quals: String,
) String {
    names := graph.value_decl_names_in(a)
    hs := a
        .gstr_string(4096)
        .strip_ns_into(a, src, 0, quals, qnames, strip_qnames, strip_all_quals, true)
    body := hs.gstr_finish(a)
    // Record this alias prefix so the checker's UFCS-alias fallback treats only `alias__` decls as
    // alias-shaped (never a plain user fn that merely has `__` in its name). Fresh NUL-terminated copy.
    note_alias_prefix(a.gstr_string(16).rappend_string(a, alias).gstr_finish(a))
    a.gstr_string(4096).rewrite_alias_names(a, body, 0, names, alias)
}
line_name* = (out: String, a: MutPtr<Malloc>, names: String, i: i64) String {
    (i >= names.len || names.res_sbyte(i) == '\n').match ({
        true  => out,
        false => out.rpush(a, names.res_sbyte(i)).line_name(a, names, i + 1),
    })
}
add_qual_name = (set: String, a: MutPtr<Malloc>, alias: String, name: String) String {
    set
        .rappend_string(a, alias)
        .rpush(a, '.')
        .rappend_string(a, name)
        .rpush(a, 10)
}
add_qual_names = (set: String, a: MutPtr<Malloc>, alias: String, names: String, i: i64) String {
    (i >= names.len).match ({
        true  => set,
        false => {
            nm := line_name(a.gstr_string(16), a, names, i)
            set.add_qual_name(a, alias, nm).add_qual_names(a, alias, names, names.snext_line(i))
        },
    })
}
load_ns_closure_graph_table = (
    a: MutPtr<Malloc>,
    table: ModuleTable,
    inpath: string_view,
    id: String,
    alias: String,
    src: string_view,
    graph: ModuleGraph,
    c: Closure,
) Closure {
    (ns_depth > NS_DEPTH_CAP).then({
        a.fail_import_cycle(inpath, id)
    })    // cyclic alias — exit cleanly, never recurse to overflow
    ns_depth = ns_depth + 1
    c2 := a.load_import_graph_table(table, inpath, src, graph, id.id_is_user(), c)
    ns := a.collect_ns_graph_table(table, inpath, src, graph, a.ns_scan(c2))
    llo := lmap_lines()
    body := a.alias_module_body(src, graph, alias, ns.quals, ns.qnames, ns.strip_qnames, ns.strip_all_quals)
    ns_depth = ns_depth - 1
    out2 := ns.c.out.rpush(a, 10).rappend_string(a, body)
    midx := table.index_of_id(id)
    a.note_module_sigs(alias, graph, midx)    // Stage B4/R2: this bind's export sig → compiler.parse registry
    a.note_fregion(midx, out2.len - body.len, out2.len, llo)
    Closure(
        seen: ns.c.seen,
        out: out2,
        useen: ns.c.useen,
    )
}
is_qual_access = (s: string_view, a: MutPtr<Malloc>, p: i32, ie: i32, quals: String) bool {
    (s.at(ie) == '.' && s.at(ie + 1).is_alpha()).match ({
        true  => quals.seen_name(a.mimport_name_span(s, p, ie)),
        false => false,
    })
}
qualified_name = (out: String, a: MutPtr<Malloc>, s: string_view, p: i32, ie: i32) String {
    out.rappend_span(a, s, p, ie).rpush(a, '.').rappend_span(a, s, ie + 1, s.res_ident_end(ie + 1))
}
rewrite_quals = (
    out: String,
    a: MutPtr<Malloc>,
    s: string_view,
    p: i32,
    quals: String,
    qnames: String,
    strip_qnames: String,
    strip_all_quals: String,
) String {
    cur := out
    pos := p
    bs: [u8] := s.str_bytes()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos == false).then({
            (b == 0).match ({
                true  => {
                    h.break
                },
                false => s.line_comment_at(pos).match ({
                    true  => {
                        sk := cur.copy_line_comment(a, s, pos)
                        cur = sk.out
                        pos = sk.next
                    },
                    false => s.block_comment_at(pos).match ({
                        true  => {
                            sk := cur.copy_block_comment(a, s, pos)
                            cur = sk.out
                            pos = sk.next
                        },
                        false => s.quoted_at(pos).match ({
                            true  => {
                                sk := cur.copy_literal(a, s, pos)
                                cur = sk.out
                                pos = sk.next
                            },
                            false => (b.is_alpha()
                                && (pos == 0
                                    || s.at(pos - 1).is_alnum().match ({
                                        true  => false,
                                        false => true,
                                    }))).match ({
                                true  => {
                                    ie := s.res_ident_end(pos)
                                    s.is_qual_access(a, pos, ie, quals).match ({
                                        true  => {
                                            alias := a.mimport_name_span(s, pos, ie)
                                            qn := qualified_name(a.gstr_string(32), a, s, pos, ie)
                                            me := s.res_ident_end(ie + 1)
                                            qnames.seen_name(qn).match ({
                                                true  => {
                                                    cur = cur
                                                        .rappend_span(a, s, pos, ie)
                                                        .rappend(a, "__")
                                                    pos = ie + 1
                                                },
                                                false => (strip_qnames.seen_name(qn)
                                                    || strip_all_quals.seen_name(alias)).match ({
                                                    true  => {
                                                        pos = ie + 1
                                                    },
                                                    false => {
                                                        cur = cur.rappend_span(a, s, pos, me)
                                                        pos = me
                                                    },
                                                }),
                                            })
                                        },
                                        false => {
                                            cur = cur.rappend_span(a, s, pos, ie)
                                            pos = ie
                                        },
                                    })
                                },
                                false => {
                                    cur = cur.rpush(a, b)
                                    pos = pos + 1
                                },
                            }),
                        }),
                    }),
                }),
            })
        })
    })
    cur
}
strip_ns_lines_into = (out: String, a: MutPtr<Malloc>, s: string_view, p: i32, first: bool) String {
    cur := out
    pos := p
    is_first := first
    lline := 1    // 1-based source line of `lpos`, advanced lazily as kept lines are recorded
    lpos := 0
    bs: [u8] := s.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos == false).then({
            s.is_import_line(pos).match ({
                true  => {
                    pos = s.import_end(pos)
                },
                false => s.is_ns_line(pos).match ({
                    true  => {
                        pos = s.next_line(pos)
                    },
                    false => {
                        lmap_on.then({
                            lline = lline + to_i32(s.count_nl(lpos, pos))
                            lpos = pos
                            a.lmap_note_line(lline)
                        })
                        e := s.line_end(pos)
                        cur = is_first.match ({
                            true  => cur.rappend_span(a, s, pos, e),
                            false => cur.rpush(a, 10).rappend_span(a, s, pos, e),
                        })
                        is_first = false
                        pos = s.next_line(pos)
                    },
                }),
            })
        })
    })
    cur
}
strip_ns_into* = (
    out: String,
    a: MutPtr<Malloc>,
    s: string_view,
    p: i32,
    quals: String,
    qnames: String,
    strip_qnames: String,
    strip_all_quals: String,
    first: bool,
) String {
    hs := a.gstr_string(4096).strip_ns_lines_into(a, s, p, true)
    raw := hs.gstr_finish(a)
    (raw.at(0) == 0).match ({
        true  => out,
        false => {
            base := first.match ({ true => out, false => out.rpush(a, 10) })
            (quals.len == 0).match ({
                true  => base.rappend(a, raw),
                false => base.rewrite_quals(a, raw, 0, quals, qnames, strip_qnames, strip_all_quals),
            })
        },
    })
}
module_body = (
    a: MutPtr<Malloc>,
    table: ModuleTable,
    inpath: string_view,
    entry: ModuleEntry,
) string_view {
    ns := a.collect_ns_graph_table(table, inpath, entry.source, entry.graph, a.ns_scan(a.empty_closure()))
    hs := a
        .gstr_string(4096)
        .strip_ns_into(a, entry.source, 0, ns.quals, ns.qnames, ns.strip_qnames, ns.strip_all_quals, true)
    hs.gstr_finish(a)
}
parsed_module_buf = (a: MutPtr<Malloc>, n: i64) [ParsedModule] {
    slice(a.acquire(n * sizeof(ParsedModule)), n)
}
parse_module_entry = (
    a: MutPtr<Malloc>,
    table: ModuleTable,
    inpath: string_view,
    entry: ModuleEntry,
) ParsedModule {
    body := a.module_body(table, inpath, entry)
    ParsedModule(
        id: entry.id,
        path: entry.path,
        source: entry.source,
        body: body,
        graph: entry.graph,
        decls: a.parse_module(body),
    )
}
parse_resolved_program = (
    a: MutPtr<Malloc>,
    resolved: ResolvedProgram,
    inpath: string_view,
) ParsedProgram {
    mods := a.parsed_module_buf(resolved.table.count())
    resolved.table.modules.loop((h, i, entry) {
        mods[i] = a.parse_module_entry(resolved.table, inpath, entry)
    })
    ParsedProgram(
        resolved: resolved,
        modules: mods,
        flat_decls: a.parse_module(resolved.flat),
    )
}
resolve_parsed_program* = (
    a: MutPtr<Malloc>,
    root: string_view,
    progdir: string_view,
    inpath: string_view,
    mainsrc: string_view,
) ParsedProgram {
    a.parse_resolved_program(a.resolve_program_data(root, progdir, inpath, mainsrc), inpath)
}
parsed_decl_buf = (a: MutPtr<Malloc>, n: i64) [Decl] { slice(a.acquire(n * sizeof(Decl)), n) }
append_decls_to = (dst: [Decl], at: i64, src: [Decl]) i64 {
    j := at
    src.loop((h, i, d) {
        dst[j] = d
        j = j + 1
    })
    j
}
alias_edge_decls = (a: MutPtr<Malloc>, p: ParsedProgram, edge: ImportEdge) [Decl] {
    entry := p.resolved.table.module(edge.module)
    ns := a.collect_ns_graph_table(p.resolved.table, p.module("").path, entry.source, entry.graph, a.ns_scan(a.empty_closure()))
    hs := a.alias_module_body(entry.source, entry.graph, edge.edge_alias_in(a), ns.quals, ns.qnames, ns.strip_qnames, ns.strip_all_quals)
    body := hs.gstr_finish(a)
    a.parse_module(body)
}
root_link_edge_decls = (a: MutPtr<Malloc>, p: ParsedProgram, edge: ImportEdge) [Decl] {
    edge.namespace.match ({
        true  => a.alias_edge_decls(p, edge),
        false => p.module(edge.module).decls,
    })
}
module_link_count = (a: MutPtr<Malloc>, p: ParsedProgram, m: ParsedModule) i64 {
    n := 0
    m.graph.imports.loop((h, i, edge) {
        n = n + a.root_link_edge_decls(p, edge).len
    })
    n
}
module_link_decls* = (a: MutPtr<Malloc>, p: ParsedProgram, m: ParsedModule) [Decl] {
    buf := a.parsed_decl_buf(a.module_link_count(p, m))
    j := 0
    m.graph.imports.loop((h, i, edge) {
        j = buf.append_decls_to(j, a.root_link_edge_decls(p, edge))
    })
    slice(buf.ptr, j)
}
root_link_decls* = (a: MutPtr<Malloc>, p: ParsedProgram) [Decl] {
    a.module_link_decls(p, p.module(""))
}
check_parsed_program* = (a: MutPtr<Malloc>, p: ParsedProgram) i32 {
    root := p.module("")
    a.check_linked(root.decls, a.root_link_decls(p))
}
// Graph-linked validation for EVERY module body: each ParsedModule is checked against the import
// library built from its own ModuleGraph edges (not only the root). Positions stay in the module's
// stripped body — the incremental step toward a full symbol-table/module-world resolver (GOALS #5).
check_all_parsed_modules* = (a: MutPtr<Malloc>, p: ParsedProgram) i32 {
    acc := 0
    p.modules.loop((h, i, m) {
        acc = acc + a.check_linked(m.decls, a.module_link_decls(p, m))
    })
    acc
}
// ── USER-MODULE region registry ─────────────────────────────────────────────────────────────────
// The main-body guard above only protects decls in [nsl, bodyend) — a NON-MAIN user module whose own
// top-level decl collides with an unimported transitive std export used to lose that decl SILENTLY
// (dedup keeps the FIRST occurrence, and dependency bodies precede the module's own). Each user
// module's stripped body span in the append-only flat is recorded here during closure load, so
// shadow_flat_users can run the same guarded rename per module. Reset per program (see
// alias_prefixes_reset for the pattern); internal builds never read it (enable=false → seed unchanged).
UserRegion*: {
    id: string_view,
    lo: i64,
    hi: i64,
}
UREGION_CAP := 512
no_uregions = () [UserRegion] { slice(null_ptr(), 0) }
uregion_buf := no_uregions()
uregion_n := 0
uregions_reset = (a: MutPtr<Malloc>) void {
    uregion_buf = slice(a.acquire(UREGION_CAP * sizeof(UserRegion)), UREGION_CAP)
    uregion_n = 0
}
note_uregion = (id: string_view, lo: i64, hi: i64) void {
    (uregion_n < uregion_buf.len).then({
        uregion_buf[uregion_n] = UserRegion(
            id: id,
            lo: lo,
            hi: hi,
        )
        uregion_n = uregion_n + 1
    })
}
uregions_get* = () [UserRegion] { slice(uregion_buf.ptr, uregion_n) }
// ── FLAT-REGION / LINE map (identity-based diagnostics) ─────────────────────────────────────────
// Every module-body append into the flat records a FlatRegion, and the strip walk records — for each
// KEPT line — its 1-based line in the module's ORIGINAL source (import/ns lines are stripped whole,
// so kept-line numbers jump over them; ns-prefix rewrites are intra-line and never change line
// counts). A diagnostic's flat offset then resolves to its module IDENTITY and original line
// directly, with no text matching. Recording is on only while resolve_program_data builds a flat
// (lmap_on), so parse_resolved_program's per-module strip never pollutes the maps. Reset per
// program (see uregions_reset for the pattern); buffers grow geometrically via the mp allocator.
lmap_on := false
no_fregions = () [FlatRegion] { slice(null_ptr(), 0) }
freg_buf := no_fregions()
freg_n := 0
no_lsrc = () [i32] { slice(null_ptr(), 0) }
lsrc_buf := no_lsrc()
lsrc_n := 0
no_ldrops = () [i64] { slice(null_ptr(), 0) }
ldrop_buf := no_ldrops()    // flattened (start, end) pairs, ascending, from ONE dedup pass
ldrop_n := 0
freg_alloc = (a: MutPtr<Malloc>, n: i64) [FlatRegion] {
    slice(a.acquire(n * sizeof(FlatRegion)), n)
}
lsrc_alloc = (a: MutPtr<Malloc>, n: i64) [i32] { slice(a.acquire(n * sizeof(i32)), n) }
ldrop_alloc = (a: MutPtr<Malloc>, n: i64) [i64] { slice(a.acquire(n * sizeof(i64)), n) }
lmap_reset = (a: MutPtr<Malloc>) void {
    freg_buf = a.freg_alloc(64)
    freg_n = 0
    lsrc_buf = a.lsrc_alloc(1024)
    lsrc_n = 0
    ldrop_buf = a.ldrop_alloc(64)
    ldrop_n = 0
    lmap_on = true
}
lmap_off = () void { lmap_on = false }
lmap_lines = () i64 { lsrc_n }
fregions_get = () [FlatRegion] { slice(freg_buf.ptr, freg_n) }
lsrc_get = () [i32] { slice(lsrc_buf.ptr, lsrc_n) }
freg_grow = (a: MutPtr<Malloc>) void {
    (freg_n >= freg_buf.len).then({
        grown := a.freg_alloc(freg_buf.len * 2)
        freg_buf.loop((h, i, r) {
            grown[i] = r
        })
        freg_buf = grown
    })
}
lsrc_grow = (a: MutPtr<Malloc>) void {
    (lsrc_n >= lsrc_buf.len).then({
        grown := a.lsrc_alloc(lsrc_buf.len * 2)
        lsrc_buf.loop((h, i, v) {
            grown[i] = v
        })
        lsrc_buf = grown
    })
}
ldrop_grow = (a: MutPtr<Malloc>) void {
    (ldrop_n + 1 >= ldrop_buf.len).then({
        grown := a.ldrop_alloc(ldrop_buf.len * 2)
        ldrop_buf.loop((h, i, v) {
            grown[i] = v
        })
        ldrop_buf = grown
    })
}
// newline count in s[lo, hi) — sub-slice iteration (O(hi-lo), no rescan from 0, constant stack).
count_nl = (s: string_view, lo: i32, hi: i32) i64 {
    n: i64 := 0
    (hi > lo).then({
        span: [u8] := slice(s.offset(lo), to_i64(hi - lo))
        span.loop((h, i, b) {
            (b == '\n').then({
                n = n + 1
            })
        })
    })
    n
}
lmap_note_line = (a: MutPtr<Malloc>, srcline: i32) void {
    lmap_on.then({
        a.lsrc_grow()
        lsrc_buf[lsrc_n] = srcline
        lsrc_n = lsrc_n + 1
    })
}
// a body append starts with the '\n' separator pushed before it (unless it opens the flat); the
// region's first LINE starts just past that separator.
freg_lo = (out: String, blo: i64) i64 {
    (out.len > blo && out.res_sbyte(blo) == 10).match ({ true => blo + 1, false => blo })
}
note_fregion = (a: MutPtr<Malloc>, midx: i64, lo: i64, hi: i64, line_lo: i64) void {
    (lmap_on && hi > lo && midx >= 0).then({
        a.freg_grow()
        freg_buf[freg_n] = FlatRegion(
            midx: midx,
            lo: lo,
            hi: hi,
            line_lo: line_lo,
            line_n: lsrc_n - line_lo,
        )
        freg_n = freg_n + 1
    })
}
// A shadow-rename splice replaced flat[slo, shi) with `newlen` bytes: renames are strictly inside
// decls (never a newline), so only BYTE coords move — the containing region's hi stretches and every
// later region shifts; line maps are untouched.
fregions_splice* = (slo: i64, shi: i64, newlen: i64) void {
    delta := newlen - (shi - slo)
    (lmap_on && delta != 0).then({
        regs := fregions_get()
        regs.loop((h, i, r) {
            (r.lo >= shi).then({
                freg_buf[i] = FlatRegion(
                    midx: r.midx,
                    lo: r.lo + delta,
                    hi: r.hi + delta,
                    line_lo: r.line_lo,
                    line_n: r.line_n,
                )
            })
            (r.lo < shi && r.hi > slo).then({
                freg_buf[i] = FlatRegion(
                    midx: r.midx,
                    lo: r.lo,
                    hi: r.hi + delta,
                    line_lo: r.line_lo,
                    line_n: r.line_n,
                )
            })
        })
    })
}
note_ldrop = (a: MutPtr<Malloc>, ds: i64, de: i64) void {
    (lmap_on && de > ds).then({
        a.ldrop_grow()
        ldrop_buf[ldrop_n] = ds
        ldrop_buf[ldrop_n + 1] = de
        ldrop_n = ldrop_n + 2
    })
}
ldrops_get = () [i64] { slice(ldrop_buf.ptr, ldrop_n) }
// Apply one dedup pass's DROP list to the maps. `flat` is the PRE-drop flat that pass walked — drops
// and regions are both in its coordinates. Dropped decl spans start at a line start, so a drop kills
// exactly the line entries [k0, k0+dead) of the region(s) it overlaps (a drop running PAST a region's
// end takes the region's whole tail with it). Four passes, each a plain slice walk: (A) turn every
// drop∩region overlap into a dead-line interval in GLOBAL line-array coordinates (regions and drops
// both ascend, so intervals come out ascending and disjoint, and never cross a region's window);
// (B) shrink region byte spans by the dropped bytes before them; (C) rebase each region's line
// window by the dead entries before/inside it; (D) compact the line array with a cursor over the
// dead intervals (each is non-empty, so the cursor advances at most once per index and never lags).
lmap_apply_drops = (a: MutPtr<Malloc>, flat: string_view) void {
    (lmap_on && ldrop_n > 0).then({
        regs := fregions_get()
        drops := ldrops_get()
        dbuf := a.ldrop_alloc(ldrop_n * 2 + 2)
        dn := 0
        regs.loop((h, ri, r) {
            drops.loop((h2, j, dv) {
                // A) dead line intervals
                (j % 2 == 0).then({
                    ds := dv
                    de := drops[j + 1]
                    x := (ds > r.lo).match ({ true => ds, false => r.lo })
                    y := (de < r.hi).match ({ true => de, false => r.hi })
                    (x < y).then({
                        k0 := flat.count_nl(to_i32(r.lo), to_i32(x))
                        dead := (de > r.hi).match ({
                            true  => r.line_n - k0,
                            false => flat.count_nl(to_i32(x), to_i32(y)),
                        })
                        capped := (k0 + dead > r.line_n).match ({
                            true  => r.line_n - k0,
                            false => dead,
                        })
                        (capped > 0).then({
                            dbuf[dn] = r.line_lo + k0
                            dbuf[dn + 1] = r.line_lo + k0 + capped
                            dn = dn + 2
                        })
                    })
                })
            })
        })
        regs.loop((h, ri, r) {
            // B) byte shifts: subtract every dropped byte before lo / before hi
            dlo: i64 := 0
            dhi: i64 := 0
            drops.loop((h2, j, dv) {
                (j % 2 == 0).then({
                    ds := dv
                    de := drops[j + 1]
                    cl := (de < r.lo).match ({ true => de, false => r.lo })
                    (cl > ds).then({
                        dlo = dlo + (cl - ds)
                    })
                    ch := (de < r.hi).match ({ true => de, false => r.hi })
                    (ch > ds).then({
                        dhi = dhi + (ch - ds)
                    })
                })
            })
            freg_buf[ri] = FlatRegion(
                midx: r.midx,
                lo: r.lo - dlo,
                hi: r.hi - dhi,
                line_lo: r.line_lo,
                line_n: r.line_n,
            )
        })
        regs.loop((h, ri, r) {
            // C) rebase line windows (byte fields already updated; line fields still pre-drop)
            cumb: i64 := 0
            inw: i64 := 0
            dbuf.loop((h2, j, v) {
                (j % 2 == 0 && j < dn).then({
                    (v < r.line_lo).then({
                        cumb = cumb + (dbuf[j + 1] - v)
                    })
                    (v >= r.line_lo && v < r.line_lo + r.line_n).then({
                        inw = inw + (dbuf[j + 1] - v)
                    })
                })
            })
            freg_buf[ri] = FlatRegion(
                midx: r.midx,
                lo: r.lo,
                hi: r.hi,
                line_lo: r.line_lo - cumb,
                line_n: r.line_n - inw,
            )
        })
        // D) compact the line array
        w := 0
        di := 0
        lsrc_get().loop((h, k, v) {
            (di < dn && k >= dbuf[di + 1]).then({
                di = di + 2
            })
            inside := di < dn && k >= dbuf[di] && k < dbuf[di + 1]
            (inside == false).then({
                lsrc_buf[w] = v
                w = w + 1
            })
        })
        lsrc_n = w
        ldrop_n = 0
    })
}
// binary search: the index of the region whose [lo, hi) contains `off`, else -1 (regions are in
// append order = ascending lo; separator newlines between regions belong to no region).
fregion_find* = (regions: [FlatRegion], off: i64) i64 { regions.fregion_bs(off, 0, regions.len) }
fregion_bs = (regions: [FlatRegion], off: i64, lo: i64, hi: i64) i64 {
    (lo >= hi).match ({
        true  => 0 - 1,
        false => {
            mid := (lo + hi) / 2
            r := regions[mid]
            (off < r.lo).match ({
                true  => regions.fregion_bs(off, lo, mid),
                false => (off < r.hi).match ({
                    true  => mid,
                    false => regions.fregion_bs(off, mid + 1, hi),
                }),
            })
        },
    })
}
// the 1-based ORIGINAL source line for flat offset `off` inside region `ri`, else 0.
fregion_src_line* = (
    regions: [FlatRegion],
    line_srcs: [i32],
    flat: string_view,
    ri: i64,
    off: i64,
) i32 {
    r := regions[ri]
    k := flat.count_nl(to_i32(r.lo), to_i32(off))
    (k < r.line_n && r.line_lo + k < line_srcs.len).match ({
        true  => {
            v := line_srcs[r.line_lo + k]
            (v > 0).match ({ true => v, false => 0 })
        },
        false => 0,
    })
}
// name-decl offset of `nm` in a module's ORIGINAL source graph (for error line/col attribution).
symbol_start_of* = (a: MutPtr<Malloc>, syms: [ProvidedSymbol], nm: string_view) i32 {
    posn := 0
    syms.loop((h, i, s) {
        ((s.imported || s.foreign || s.is_type) == false && posn == 0).then({
            key := s.symbol_key_in(a).expect("std.internal.resolve: allocation failed")
            (cstr(key.ptr) == nm).then({
                posn = s.start
            })
        })
    })
    posn
}
// does the import head `{ a, b, … }` starting at edge offset `p0` bind `nm` by name?
edge_head_has_name* = (src: string_view, p0: i32, nm: string_view) bool {
    found := false
    pos := src.lstrip(p0) + 1
    bs: [u8] := src.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos == false).then({
            (b == '}' || b == 0).match ({
                true  => {
                    h.break
                },
                false => b.is_alpha().match ({
                    true  => {
                        ie := src.res_ident_end(pos)
                        src.span_eq_name(pos, ie, nm).then({
                            found = true
                        })
                        pos = ie
                    },
                    false => {
                        pos = pos + 1
                    },
                }),
            })
        })
    })
    found
}
mid_is_user* = (id: string_view) bool { id.at(0) == 'u' && id.at(1) == '/' }
fail_import_redef = (a: MutPtr<Malloc>, m: ModuleEntry, s: ProvidedSymbol, nm: String) i32 {
    line := m.source.res_line_of(s.start)
    col := m.source.res_col_of(s.start)
    m0 := a
        .gstr_string(256)
        .gstr_append(a, "zenc: ")
        .gstr_append(a, m.path)
        .gstr_push(a, ':')
        .res_udec(a, line)
        .gstr_push(a, ':')
        .res_udec(a, col)
        .gstr_append(a, ": error[dup-fn]: duplicate top-level definition of `")
    m1 := a.mappend_string(m0, nm).gstr_append(a, "` — this module also imports `")
    m2 := a.mappend_string(m1, nm).gstr_append(a, "` by name")
    l1 := m2.gstr_push(a, 10)
    h0 := l1.gstr_append(a, "hint: drop `")
    h1 := a
        .mappend_string(h0, nm)
        .gstr_append(a, "` from the import list, or rename the local definition")
    eprint(h1.gstr_push(a, 10).gstr_finish(a))
    exit(1)
    0
}
check_import_redefs = (a: MutPtr<Malloc>, table: ModuleTable) i32 {
    table.modules.loop((h, i, m) {
        (is_empty(m.id) || m.id.mid_is_user()).then({
            imported := a.imported_value_name_set(a.rset_new(), m.graph.symbols)
            m.graph.symbols.loop((h2, j, s) {
                ((s.imported || s.foreign || s.is_type) == false).then({
                    key := s.symbol_key_in(a).expect("std.internal.resolve: allocation failed")
                    imported.rset_has(key).then({
                        a.fail_import_redef(m, s, key)
                    })
                })
            })
        })
    })
    0
}
// ── MODULE-ALIAS NAME-COLLISION ATTRIBUTION (#66a) ───────────────────────────────────────────────
// A module alias `alias = std.x.y` flattens y's value decls under an `alias__` prefix, INCLUDING the
// method bodies of any type y defines whose method names also exist as top-level fns in y (e.g.
// std.text.string's `String.free_in` alongside the top-level allocator-side `free_in`). When ANOTHER
// module in the closure imports y UNQUALIFIED (`{ String } = std.text.string`), a second, un-prefixed
// copy of y's top-level fns is spliced in — but that copy carries NO struct-method definitions, so a
// bare `x.free_in(...)` call there misresolves to the swapped-arg top-level fn. The type error then
// surfaces deep inside the stdlib module with zero attribution to the user's alias line. This detects
// exactly that shape at resolve time and reports it AT THE USER'S IMPORT LINE with the fix. It is
// deliberately narrow: it fires only when (1) the user aliases a module that (2) has a name defined
// both top-level AND as a type method (the "split-name" shape), and (3) that module is ALSO imported
// unqualified somewhere in the closure — the exact conjunction that produces the divergent copies.
// Programs that alias non-split modules, or split modules that are never also imported bare, are
// unaffected (no false rejections).
res_line_of* = (src: string_view, off: i32) i32 {
    no := 1
    bs: [u8] := src.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii >= off).match ({
            true  => {
                h.break
            },
            false => (b == '\n').then({
                no = no + 1
            }),
        })
    })
    no
}
res_col_of* = (src: string_view, off: i32) i32 {
    ls := 0
    bs: [u8] := src.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii >= off).match ({
            true  => {
                h.break
            },
            false => (b == '\n').then({
                ls = ii + 1
            }),
        })
    })
    off - ls + 1
}
// Thin i32 width-adapter over compiler.astops' one decimal writer (gstr_int) — callers thread
// non-negative line/col/index i32s, so the widened i64 renders its plain decimal digits.
res_udec* = (out: String, a: MutPtr<Malloc>, n: i32) String { out.gstr_int(a, to_i64(n)) }
// index just past the matching `>` of a `<...>` generic list starting at `p` (the `<`). Method decl
// headers carry only flat lists (`<A>`, `<A, B>`), so a scan to the first `>` is exact.
skip_to_gt = (s: string_view, p: i32) i32 {
    (s.at(p) == 0 || s.at(p) == '>').match ({ true => p + 1, false => s.skip_to_gt(p + 1) })
}
after_generics = (s: string_view, j: i32) i32 {
    (s.at(j) == '<').match ({ true => s.skip_to_gt(j + 1), false => j })
}
// is the text at name-end `ie` the head of a fn decl — `<...>? *? = (` ?
is_fn_decl_after = (s: string_view, ie: i32) bool {
    j0 := s.after_generics(ie)
    j := (s.at(j0) == '*').match ({ true => j0 + 1, false => j0 })
    (s.at(j) == ' ').match ({
        true  => s.at(j + 1) == '=' && s.at(j + 2) == ' ' && s.at(j + 3) == '(',
        false => s.at(j) == '=' && s.at(j + 1) == ' ' && s.at(j + 2) == '(',
    })
}
// Newline-separated set of INDENTED fn-decl names in `src` that also appear in `topnames` (the
// module's top-level value decls) — i.e. every type method whose name shadows a top-level fn. Empty
// String if the module has no such split name (the common case; then no collision is possible).
split_names = (a: MutPtr<Malloc>, src: string_view, topnames: String) String {
    out := a.gstr_string(64)
    pos := 0
    bs: [u8] := src.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos == false).then({
            (b == 0).match ({
                true  => {
                    h.break
                },
                false => {
                    ls := src.lstrip(pos)
                    (ls > pos && src.at(ls).is_alpha()).then({
                        ie := src.res_ident_end(ls)
                        src.is_fn_decl_after(ie).then({
                            nm := a.mimport_name_span(src, ls, ie)
                            topnames.seen_name(nm).then({
                                out = a.madd_name(out, nm)
                            })
                        })
                    })
                    pos = src.next_line(pos)
                },
            })
        })
    })
    out
}
// The first `.<name>(` method-call in `src` whose `name` is one of `names` — i.e. a call that WOULD
// misresolve once the aliased module's matching method has been prefixed away. Empty String if none.
has_method_call_of = (a: MutPtr<Malloc>, src: string_view, names: String) String {
    out := a.gstr_string(16)
    pos := 0
    bs: [u8] := src.view()
    bs.loop((h, i, b) {
        ii := to_i32(i)
        (ii < pos == false).then({
            (b == 0).match ({
                true  => {
                    h.break
                },
                false => {
                    (b == '.' && src.at(ii + 1).is_alpha()).then({
                        ie := src.res_ident_end(ii + 1)
                        (src.at(ie) == '(').then({
                            nm := a.mimport_name_span(src, ii + 1, ie)
                            names.seen_name(nm).then({
                                out = nm
                                h.break
                            })
                        })
                    })
                    pos = ii + 1
                },
            })
        })
    })
    out
}
AliasCollision: {
    name: String,
    importer: string_view,
    found: bool,
}
// Scan every module in the closure EXCEPT the aliased module itself for a `.<split>(` call: that is
// the site that will misresolve to the swapped-arg top-level fn once the alias prefixes the method.
find_split_call_site = (
    a: MutPtr<Malloc>,
    table: ModuleTable,
    modid: string_view,
    splits: String,
) AliasCollision {
    res := AliasCollision(
        name: a.gstr_string(1),
        importer: "",
        found: false,
    )
    table.modules.loop((h, i, m) {
        skip := res.found.match ({ true => true, false => m.id == modid })
        (skip == false).then({
            called := a.has_method_call_of(m.source, splits)
            (called.len > 0).then({
                res = AliasCollision(
                    name: called,
                    importer: m.id,
                    found: true,
                )
            })
        })
    })
    res
}
mappend_id_str_dotted* = (a: MutPtr<Malloc>, out: String, id: string_view) String {
    cur := out
    bs: [u8] := id.view()
    bs.loop((h, i, b) {
        cur = (b == '/').match ({ true => cur.gstr_push(a, '.'), false => cur.gstr_push(a, b) })
    })
    cur
}
fail_alias_collision = (
    a: MutPtr<Malloc>,
    inpath: string_view,
    mainsrc: string_view,
    edge: ImportEdge,
    split: String,
    importer: string_view,
) i32 {
    line := mainsrc.res_line_of(edge.start)
    col := mainsrc.res_col_of(edge.start)
    m0 := a
        .gstr_string(320)
        .gstr_append(a, "zenc: ")
        .gstr_append(a, inpath)
        .gstr_push(a, ':')
        .res_udec(a, line)
        .gstr_push(a, ':')
        .res_udec(a, col)
        .gstr_append(a, ": error[import-collision]: module alias `")
    m1 := m0.gstr_append(a, edge.alias).gstr_append(a, " = ")
    m2 := a
        .mappend_id_str_dotted(m1, edge.module)
        .gstr_append(a, "` collides in the flat namespace")
    l1 := m2.gstr_push(a, 10)
    // detail: which other module pulls the same names in unqualified, and the shared name that breaks
    d0 := l1.gstr_append(a, "  `")
    d1 := a
        .mappend_id_str_dotted(d0, edge.module)
        .gstr_append(a, "` is also imported unqualified by `")
    d2 := (importer == "").match ({
        true  => d1.gstr_append(a, "your program"),
        false => a.mappend_id_str_dotted(d1, importer),
    })
    d3 := d2.gstr_append(a, "`, and its method `")
    d4 := a
        .mappend_string(d3, split)
        .gstr_append(a, "` shares a name with a top-level function; the alias renames the method (to `")
    d5 := d4.gstr_append(a, edge.alias).gstr_append(a, "__")
    d6 := a.mappend_string(d5, split).gstr_append(a, "`), so `.")
    d7 := a.mappend_string(d6, split).gstr_append(a, "(...)` calls elsewhere no longer resolve")
    l2 := d7.gstr_push(a, 10)
    // actionable fix
    h0 := l2.gstr_append(a, "hint: replace the module alias with a selective import — e.g. `{ ... } = ")
    h1 := a
        .mappend_id_str_dotted(h0, edge.module)
        .gstr_append(a, "` — or qualify the conflicting usage")
    eprint(h1.gstr_push(a, 10).gstr_finish(a))
    exit(1)
    0
}
check_alias_collisions = (
    a: MutPtr<Malloc>,
    table: ModuleTable,
    graph: ModuleGraph,
    mainsrc: string_view,
    inpath: string_view,
) i32 {
    graph.imports.loop((h, i, edge) {
        edge.namespace.then({
            entry := table.module(edge.module)
            splits := a.split_names(entry.source, entry.graph.value_decl_names_in(a))
            (splits.len > 0).then({
                col := a.find_split_call_site(table, edge.module, splits)
                col.found.then({
                    a.fail_alias_collision(inpath, mainsrc, edge, col.name, col.importer)
                })
            })
        })
    })
    0
}
// ── World teaching hint for undefined names (Stage B3) ──────────────────────────────────────────
// The identifier at flat offset `off`, looked up across every module signature in the program's
// World: when a module in the closure EXPORTS that name as a value the generic undefined-name hint
// becomes a teaching hint — name the module and show both consumption forms. Only modules already
// in the table are searched (the import closure — exactly the modules whose exports bleed through
// the flat under an alias prefix, the collision-adjacent confusion this hint retires). Returns ""
// when no module exports the name (the caller keeps the generic hint).
mappend_mid_display* = (a: MutPtr<Malloc>, out: String, id: string_view) String {
    id.mid_is_user().match ({
        true  => a.mappend_id_str_dotted(out, cstr(offset(id, 2))),
        false => a.mappend_id_str_dotted(out, id),
    })
}
undefined_name_hint* = (
    a: MutPtr<Malloc>,
    table: ModuleTable,
    flat: string_view,
    off: i32,
) string_view {
    ie := flat.res_ident_end(off)
    (off < 0 || ie <= off).match ({
        true  => "",
        false => {
            nm := a.mimport_name_span(flat, off, ie).gstr_finish(a)
            hit: i64 := 0 - 1
            table.modules.loop((h, i, m) {
                (hit < 0 && i > 0).then({
                    m.graph.sig.exports_value(nm).then({
                        hit = i
                    })
                })
            })
            (hit < 0).match ({
                true  => "",
                false => {
                    m := table.modules[hit]
                    h0 := a
                        .gstr_string(192)
                        .gstr_append(a, "`")
                        .gstr_append(a, nm)
                        .gstr_append(a, "` is exported by ")
                    h1 := a.mappend_mid_display(h0, m.id)
                    h2 := h1
                        .gstr_append(a, " — import it (`{ ")
                        .gstr_append(a, nm)
                        .gstr_append(a, " } = ")
                    h3 := a.mappend_mid_display(h2, m.id)
                    h4 := h3.gstr_append(a, "`) or qualify it through a module alias")
                    h4.gstr_finish(a)
                },
            })
        },
    })
}
// Public loader entry: collect namespace binds, strip imports/binds from the main
// source, load transitive imports, then dedup names across the flat program.
resolve_program_data* = (
    a: MutPtr<Malloc>,
    root: string_view,
    progdir: string_view,
    inpath: string_view,
    mainsrc: string_view,
) ResolvedProgram {
    a.alias_prefixes_reset()    // fresh per program: the checker's UFCS-alias set is exactly the aliases stamped below
    a.module_sigs_reset()    // fresh per program: the checker's per-alias export sigs (B4/R2), stamped per ns bind below
    a.uregions_reset()    // fresh per program: user-module body spans recorded during closure load
    a.lmap_reset()    // fresh per program: flat-region + original-line maps recorded during closure load
    graph := a.module_graph(mainsrc)
    table := a.module_table_graph(root, progdir, inpath, mainsrc, graph)
    a.enforce_visibility(table, vis_report_mode())
    a.enforce_private_leaks(table, vis_report_mode())
    a.enforce_ffi_grants(table, mainsrc, vis_report_mode())
    inpath.internal_source_path().match ({
        true  => 0,
        false => {
            a.check_alias_collisions(table, graph, mainsrc, inpath)
            a.check_import_redefs(table)
        },
    })
    ns := a.collect_ns_graph_table(table, inpath, mainsrc, graph, a.ns_scan(a.empty_closure()))
    nsl := ns.c.out.len
    mllo := lmap_lines()
    body := ns.c.out.strip_ns_into(a, mainsrc, 0, ns.quals, ns.qnames, ns.strip_qnames, ns.strip_all_quals, ns.c.out.len == 0)
    a.note_fregion(0, body.freg_lo(nsl), body.len, mllo)    // entry module = table index 0
    cN := a.load_import_graph_table(table, inpath, mainsrc, graph, true, Closure(
        seen: ns.c.seen,
        out: body,
        useen: ns.c.useen,
    ))
    internal := inpath.internal_source_path()
    // one whole-flat symbol scan, shared by the shadow-rename pass and (when no rename fired,
    // the common case) the dedup pass — the graph is recomputed only over a REWRITTEN flat.
    pre := cN.out.gstr_finish(a)
    fsyms := a.module_graph(pre).symbols
    sf := a.shadow_flat(pre, fsyms, mainsrc, nsl, body.len, internal.match ({
        true  => false,
        false => true,
    }))
    fregions_splice(nsl, body.len, sf.bodyend - nsl)    // main-body rename shifts every later region
    su := a.shadow_flat_users(sf.flat, table, body.len, sf.bodyend - body.len, nsl, internal.match ({
        true  => false,
        false => true,
    }))
    dsyms := (sf.renamed || su.renamed).match ({
        true  => a.module_graph(su.flat).symbols,
        false => fsyms,
    })
    d1 := a.dedup_decls_syms(su.flat, dsyms, nsl + su.shift, sf.bodyend + su.shift, internal)
    a.lmap_apply_drops(su.flat)
    flat := a.dedup_impls(table, d1)
    a.lmap_apply_drops(d1)
    lmap_off()
    ResolvedProgram(
        table: table,
        flat: flat,
        body_start: nsl + su.shift,
        body_end: sf.bodyend + su.shift,
        regions: fregions_get(),
        line_srcs: lsrc_get(),
    )
}
