// @self-hosted-only
// File and process I/O for the Zen-side build driver.
// Uses POSIX descriptors directly so the compiler std closure stays small.
{ Allocator, try_acquire } = std.mem.alloc
{ view } = std.text.str
{ Result, IoError, ok, err } = std.core.result
{ open, read, write, close, lseek, system } = std.c.libc
STDOUT := 1
// write-all retry loop over a raw fd: emit `[ptr, ptr+len)` in full, threading the running total in
// `done`. write(2) returning < 0 → `.Err(.Errno(rc))`; a 0-byte return on a non-empty buffer means no
// progress, so we stop with `.Err(.Eof)` rather than spin forever; a short write advances the pointer
// and recurses until `len` hits 0, then yields `.Ok(total)`. This is the low-level sink: it SURFACES a
// write failure (broken pipe / EPIPE, full disk / ENOSPC) as a value instead of swallowing it. Callers
// that want best-effort (println/print in std.text.fmt) discard the Result with `.or(0)`. This is the
// ONE fd write-all loop for the whole stdlib: std.sys.root (Writer) and std.net (send) import it from here —
// io.file is the lowest-level file module (sys already imports it), so the flat namespace holds one def.
write_all* = (fd: i32, ptr: RawPtr<u8>, len: i64, done: i64) Result<i64, IoError> {
    out: Result<i64, IoError> := (len <= 0).match ({
        true  => ok(done),
        false => {
            w := fd.write(ptr, len)
            (w < 0).match ({
                true  => err(IoError.Errno(to_i32(w))),
                false => (w == 0).match ({
                    true  => err(IoError.Eof),
                    false => write_all(fd, ptr.offset(w), len - w, done + w),
                }),
            })
        },
    })
    out
}
// Writes a str to stdout without the trailing NUL. Returns `.Ok(byte count)` on success, or `.Err` on a
// write failure — the root fd sink under fmt/io. println/print discard the Result to stay best-effort.
out* = (s: string_view) Result<i64, IoError> {
    v := s.view()
    write_all(STDOUT, v.ptr, v.len, 0)
}
// Writes length-tracked bytes to stdout without requiring a trailing NUL. Same Result contract as `out`.
out_bytes* = (bytes: [u8]) Result<i64, IoError> { write_all(STDOUT, bytes.ptr, bytes.len, 0) }
// POSIX open(2) bit flags. Export the atoms so callers can state the exact mask they need instead of
// copying opaque decimal sums; O_WRTRUNC is the common create-or-truncate writer used by save().
O_RDONLY* := 0
O_WRONLY* := 1
O_CREAT* := 64
O_EXCL* := 128
O_TRUNC* := 512
O_WRTRUNC* := O_WRONLY | O_CREAT | O_TRUNC
MODE_644* := 420    // 0o644
MODE_755* := 493    // 0o755
SEEK_SET := 0
SEEK_END := 2
// Returns file size and rewinds the descriptor to the start.
file_size = (fd: i32) i64 {
    n := fd.lseek(0, SEEK_END)
    fd.lseek(0, SEEK_SET)
    n
}
// Reads [off, n), handling short reads.
fd_read_all = (fd: i32, buf: RawPtr<u8>, off: i64, n: i64) i64 {
    (off >= n).match ({
        true  => n,
        false => {
            r := fd.read(buf.offset(off), n - off)
            (r <= 0).match ({ true => off, false => fd.fd_read_all(buf, off + r, n) })
        },
    })
}
ENOMEM := 12
read_file_finish<A> = (
    a: MutPtr<A>,
    fd: i32,
    buf: RawPtr<u8>,
    n: i64,
) Result<string_view, IoError> {
    got := fd.fd_read_all(buf, 0, n)
    fd.close()
    out: Result<string_view, IoError> := (got == n).match ({
        true  => {
            buf.offset(n).store(0)
            ok(cstr(buf))
        },
        false => {
            a.release(buf)
            err(IoError.Eof)
        },
    })
    out
}
read_file_alloc<A> = (a: MutPtr<A>, fd: i32, n: i64) Result<string_view, IoError> {
    a.try_acquire(n + 1).match ({
        .Ok(buf) => a.read_file_finish(fd, buf, n),
        .Err(e)  => {
            fd.close()
            err(IoError.Errno(ENOMEM))
        },
    })
}
read_file_open<A> = (a: MutPtr<A>, fd: i32) Result<string_view, IoError> {
    n := fd.file_size()
    out: Result<string_view, IoError> := (n < 0).match ({
        true  => {
            fd.close()
            err(IoError.Errno(0 - 1))
        },
        false => a.read_file_alloc(fd, n),
    })
    out
}
// Reads a whole file into an allocator-owned NUL-terminated buffer.
contents_in*<A> = (a: MutPtr<A>, path: string_view) Result<string_view, IoError> {
    fd := path.open(O_RDONLY, 0)
    out: Result<string_view, IoError> := (fd < 0).match ({
        true  => err(IoError.NotFound),
        false => a.read_file_open(fd),
    })
    out
}
contents*<A> = (a: MutPtr<A>, path: string_view) Result<string_view, IoError> {
    a.contents_in(path)
}
// Writes a str's bytes to a file, creating/truncating it.
save* = (path: string_view, data: string_view, n: i64) Result<i64, IoError> {
    fd := path.open(O_WRTRUNC, MODE_644)
    out: Result<i64, IoError> := (fd < 0).match ({
        true  => err(IoError.Denied),
        false => {
            v := data.view()
            // clamp the requested byte count to the buffer's real length — never read past `data`.
            nn := (n < v.len).match ({ true => n, false => v.len })
            w := fd.write(v.ptr, nn)
            // close() reports deferred write errors (NFS/ENOSPC/EIO): the write buffered fine but the flush
            // on close failed, so the bytes are NOT durable. Ignoring close's return is silent DATA-LOSS —
            // check it, and surface a nonzero close as `.Err(.Errno)` rather than a bogus `.Ok`.
            c := fd.close()
            (w == nn).match ({
                true  => (c == 0).match ({ true => ok(w), false => err(IoError.Errno(c)) }),
                false => err(IoError.Eof),
            })
        },
    })
    out
}
// Runs a shell command via system(3) and returns its DECODED exit status as a value. A negative
// system() return (the shell itself couldn't be forked/exec'd) is `.Err(.Errno)`; otherwise `.Ok` of
// the exit code — WEXITSTATUS (`status >> 8 & 0xff`) for a normal exit, or 128 + signal when the child
// was killed by a signal (the shell `$?` convention). This decodes what raw `system()` folds together:
// -1 (fork failure), 127 (command not found), and a real exit code were all indistinguishable before.
shell* = (cmd: string_view) Result<i32, IoError> {
    st := cmd.system()
    (st < 0).match ({
        true  => err(IoError.Errno(st)),
        false => {
            sig := st & 127
            ok((sig == 0).match ({ true => st >> 8 & 255, false => 128 + sig }))
        },
    })
}
