// `&&` and `||` short-circuit, and the right operand may SPILL — a
// `.match` or a `.try()` is not a C expression, so it lowers to a
// temporary the left fills and the right fills again under an `if`.
//
// This test exists because closing that refusal is exactly where the
// hazard lives: the previous attempt hoisted the spill OUT of the
// operand, so it ran when the left was false. That compiled cleanly and
// computed the wrong thing, and only the differential oracle caught it.
// A refusal closed with no positive gate is a hole.
main = (env: Env) Res<i32, ArgError> {
    // the right operand prints. if it runs, the output says so.
    r1 = false && loud("A");
    println("and false -> {}", r1);

    r2 = true || loud("B");
    println("or true -> {}", r2);

    // and when it IS reached, it runs exactly once
    r3 = true && loud("C");
    println("and true -> {}", r3);
    Ok(0);
}

loud = (tag: str) bool {
    println("ran {}", tag);
    true;
}
