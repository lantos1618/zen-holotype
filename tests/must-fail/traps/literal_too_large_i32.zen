// tests/must-fail/traps/literal_too_large_i32.zen
// a literal that does not fit its type is a COMPILE error, not a
// runtime trap. the value never exists, so there is nothing to
// trap on: 2147483648 is i32.MAX + 1

// main must name an error type. a trap never lifts into Res:
// it aborts the process
Error =
    Overflow,
    DivideByZero,
    OutOfBounds

main = (env: Env) Res<i32, Error> {
    too_big: i32 = 2147483648;
    println("{}", too_big);
    Ok(0);
}
