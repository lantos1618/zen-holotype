// std.collections.vec — generic growable Vec<T> with explicit allocator-threaded storage.
// Fallible ops (`of`, `push`, `grow`) return Result<Vec<T>, IoError> — allocation failure is a
// value: `.expect("…")` at fail-fast roots, `.or_return()` inside Result-returning fns.
// @self-hosted-only: generic struct literals are covered by self-hosted tests.
{ Allocator, try_acquire, try_resize, DynAlloc } = std.mem.alloc
{ Result, IoError, Opt, panic } = std.core.result
{ dyn_current } = std.rt    // narrow the ambient rt to an Allocator ONCE — the AMBIENT-FORM surface below draws from it
Vec*<T>: {
    ptr: RawPtr<u8>,
    len: i64,
    cap: i64,
    buf = (v: Vec<T>) [T] { slice(v.ptr, v.cap) }
    view = (v: Vec<T>) [T] {
        // a slice over exactly the `len` live elements (NOT `cap` — excludes uninitialized storage).
        // Use this to iterate, just like any `[T]`: `v.view().loop((h, i, x) { ... })`.
        slice(v.ptr, v.len)
    }
    len = (v: Vec<T>) i64 { v.len }
    get = (v: Vec<T>, i: i64) T {
        // Bounds-checked read against `len` (the LIVE element count), NOT `cap`: an index in [len, cap)
        // would otherwise return uninitialized junk from the spare capacity. Out-of-range PANICS (same
        // give-up contract as the compiler's OOB guard) rather than returning garbage. Signature stays
        // `T` — every existing caller with a valid index is unchanged. Need a recoverable read? `get_opt`.
        (i < 0 || i >= v.len).match ({ true => {
            panic("vec.get: index out of bounds")
            // unreachable — panic aborts; the recursion only satisfies the arm's type.
            v.get(i)
        }, false => v.buf()[i] })
    }
    get_opt = (v: Vec<T>, i: i64) Opt<T> {
        // Recoverable bounds-checked read: `.Some(x)` for i in [0, len), `.None` past the live end.
        (i < 0 || i >= v.len).match ({ true => {
            none: Opt<T> := .None
            none
        }, false => {
            some: Opt<T> := .Some(v.buf()[i])
            some
        } })
    }
    grow<A> = (v: Vec<T>, a: MutPtr<A>) Result<Vec<T>, IoError> {
        ncap := v.cap * 2 + 1
        a.try_resize(v.ptr, ncap * sizeof(T)).match ({
            .Ok(p)  => {
                vok: Result<Vec<T>, IoError> := .Ok(Vec<T>(
                    ptr: p,
                    len: v.len,
                    cap: ncap,
                ))
                vok
            },
            .Err(e) => {
                verr: Result<Vec<T>, IoError> := .Err(e)
                verr
            },
        })
    }
    push<A> = (v: Vec<T>, a: MutPtr<A>, x: T) Result<Vec<T>, IoError> {
        x := x
        out: Result<Vec<T>, IoError> := (v.len < v.cap).match ({ true => {
            b := v.buf()
            b[v.len] = x
            vok: Result<Vec<T>, IoError> := .Ok(Vec<T>(
                ptr: v.ptr,
                len: v.len + 1,
                cap: v.cap,
            ))
            vok
        }, false => {
            v.grow(a).match ({
                .Ok(r)  => {
                    b := r.buf()
                    b[r.len] = x
                    vok: Result<Vec<T>, IoError> := .Ok(Vec<T>(
                        ptr: r.ptr,
                        len: r.len + 1,
                        cap: r.cap,
                    ))
                    vok
                },
                .Err(e) => {
                    verr: Result<Vec<T>, IoError> := .Err(e)
                    verr
                },
            })
        } })
        out
    }
    free<A> = (v: Vec<T>, a: MutPtr<A>) void { a.release(v.ptr) }
    each = (v: Vec<T>, f: (T) void) void {
        // Higher-order helpers over the live elements (`view()`), backed by closures — inline lambdas and
        // stored closures both work. Spelled inline (over `view().loop`) rather than delegating to
        // std.collections.iter, so this module imports no free `fold`/`each`/`find` names — those
        // would re-export and clash with same-named helpers (e.g. `map.find`) in programs that co-import vec
        // and map. `each`/`fold`/`find` allocate nothing; `map`/`filter` thread the allocator and return a
        // fresh Vec wrapped in `Result` (no hidden heap; OOM is a value). The `vw: [T] :=` intermediate
        // pins the element type for the loop.
        vw: [T] := v.view()
        vw.loop((h, i, x) {
            f(x)
        })
    }
    fold = (v: Vec<T>, init: T, f: (T, T) T) T {
        acc := init
        vw: [T] := v.view()
        vw.loop((h, i, x) {
            acc = f(acc, x)
        })
        acc
    }
    find = (v: Vec<T>, pred: (T) bool) Opt<T> {
        out: Opt<T> := .None
        vw: [T] := v.view()
        vw.loop((h, i, x) {
            pred(x).match ({ true => {
                out = .Some(x)
                h.break
            }, false => { } })
        })
        out
    }
    map<A, U> = (v: Vec<T>, a: MutPtr<A>, f: (T) U) Result<Vec<U>, IoError> {
        // Fallible: the fresh buffer is `try_acquire`d, so OOM is a value (`.Err(.Errno)`) instead of a
        // null `p` the loop would write through. Explicit `.match` threads the Err (matching `grow`/`push`).
        a.try_acquire(v.len * sizeof(U)).match ({
            .Ok(p)  => {
                out: [U] := slice(p, v.len)
                vw: [T] := v.view()
                vw.loop((h, i, x) {
                    out[i] = f(x)
                })
                ok: Result<Vec<U>, IoError> := .Ok(Vec<U>(
                    ptr: p,
                    len: v.len,
                    cap: v.len,
                ))
                ok
            },
            .Err(e) => {
                err: Result<Vec<U>, IoError> := .Err(e)
                err
            },
        })
    }
    filter<A> = (v: Vec<T>, a: MutPtr<A>, keep: (T) bool) Result<Vec<T>, IoError> {
        // Fallible for the same reason as `map`: OOM on the result buffer surfaces as `.Err`, never null.
        a.try_acquire(v.len * sizeof(T)).match ({
            .Ok(p)  => {
                out: [T] := slice(p, v.len)
                vw: [T] := v.view()
                n := 0
                vw.loop((h, i, x) {
                    out[n] = x
                    n = n + keep(x).match ({ true => 1, false => 0 })
                })
                ok: Result<Vec<T>, IoError> := .Ok(Vec<T>(
                    ptr: p,
                    len: n,
                    cap: v.len,
                ))
                ok
            },
            .Err(e) => {
                err: Result<Vec<T>, IoError> := .Err(e)
                err
            },
        })
    }
}
// a zero-element `Vec<T>` with capacity for at least one element (so `push` has somewhere to write
// before the first grow). T can't be read off any argument, so it comes from the LHS annotation:
// `r: Result<Vec<i32>, IoError> := vecs.empty(a)`. A is inferred from `a`. Fallible like `of`: the seed
// buffer is `try_acquire`d, so OOM is a value, not a null buffer. Pair with `push`/`free`.
empty*<T, A> = (a: MutPtr<A>) Result<Vec<T>, IoError> {
    a.try_acquire(sizeof(T)).match ({
        .Ok(p)  => {
            ok: Result<Vec<T>, IoError> := .Ok(Vec<T>(
                ptr: p,
                len: 0,
                cap: 1,
            ))
            ok
        },
        .Err(e) => {
            err: Result<Vec<T>, IoError> := .Err(e)
            err
        },
    })
}
// a `Vec<T>` seeded from a slice (copies `xs`), its buffer acquired from `a`. T inferred from `xs`, A from `a`.
of*<T, A> = (a: MutPtr<A>, xs: [T]) Result<Vec<T>, IoError> {
    (xs.len <= 0).match ({ true => {
        vok: Result<Vec<T>, IoError> := .Ok(Vec<T>(
            ptr: null_ptr(),
            len: 0,
            cap: 0,
        ))
        vok
    }, false => {
        a.try_acquire(xs.len * sizeof(T)).match ({
            .Ok(p)  => {
                v := Vec<T>(
                    ptr: p,
                    len: xs.len,
                    cap: xs.len,
                )
                b := v.buf()
                xs.loop((h, i, x) {
                    b[i] = x
                })
                vok: Result<Vec<T>, IoError> := .Ok(v)
                vok
            },
            .Err(e) => {
                verr: Result<Vec<T>, IoError> := .Err(e)
                verr
            },
        })
    } })
}
// ── AMBIENT FORM (rt-drawn) ────────────────────────────────────────────────────────────────────────
// An ADDITIVE surface that removes allocator threading: `v := vec.new()` then `v.push(x)` — no `a`
// argument anywhere. Everything above (the explicit `Vec<T>` + `of(a, …)` / `v.push(a, x)` forms) is
// UNCHANGED and remains the precise-control API; this section only adds new names on new types.
//
//   v: AVec<i32> := vec.new()          // T comes from the annotation (nothing to infer it from)
//   v  = v.push(1)                     // no allocator — bytes come from the ambient rt
//   v  = v.push(2)
//   n  := v.len()                      // 2
//   x  := v.get(0)                     // 1
//   v.each((y){ ... })                 // iterate the live elements
//   v.free()                           // hand storage back to the SAME rt that made it
//
//   w := vec.from([10, 20, 30])        // seed from a slice; T inferred from the elements
//
// STORE-NOT-REREAD (why AVec carries its allocator). The ambient rt is narrowed to an allocator ONCE,
// at construction, and the resulting `DynAlloc` is stored in the header — every later op (grow, free)
// allocates through that SAME allocator. It is NOT re-read from `current()` per op. Re-reading would be
// a correctness bug: if the container is created under one allocator (e.g. an actor's per-actor heap,
// or an arena scope) and then an op runs after the ambient rt has changed, `grow` would allocate the
// new buffer from allocator B while the old buffer came from allocator A — and then free the old buffer
// through B: a cross-allocator free (corruption). Storing the allocator makes an AVec self-contained and
// safe to outlive the scope it was born in (Pony per-actor semantics).
//
// The ambient ops are FAIL-FAST on allocation failure (`.expect`, which panics) — the trivial-program
// ergonomic path. Callers who need allocation failure as a value keep using the explicit `Vec<T>` API,
// whose ops return `Result<Vec<T>, IoError>`.
// AVec<T> = an explicit `Vec<T>` plus the NARROW allocator it was born under (`alloc: DynAlloc` — the
// value form of the `Allocator` trait, std.mem.alloc). All ops delegate to the `Vec<T>` methods,
// passing the stored allocator where an `a: MutPtr<A>` is expected, so there is ZERO duplicated
// container logic AND the container stores an Allocator, never the whole `Rt` bundle.
AVec*<T>: {
    inner: Vec<T>,
    alloc: DynAlloc,
    len = (w: AVec<T>) i64 { w.inner.len() }
    get = (w: AVec<T>, i: i64) T { w.inner.get(i) }
    get_opt = (w: AVec<T>, i: i64) Opt<T> { w.inner.get_opt(i) }
    view = (w: AVec<T>) [T] { w.inner.view() }
    each = (w: AVec<T>, f: (T) void) void { w.inner.each(f) }
    fold = (w: AVec<T>, init: T, f: (T, T) T) T { w.inner.fold(init, f) }
    find = (w: AVec<T>, pred: (T) bool) Opt<T> { w.inner.find(pred) }
    push = (w: AVec<T>, x: T) AVec<T> {
        a := w.alloc
        AVec<T>(
            inner: w.inner.push(a.addr(), x).expect("vec.push: out of memory"),
            alloc: w.alloc,
        )
    }
    free = (w: AVec<T>) void {
        a := w.alloc
        w.inner.free(a.addr())
    }
}
// EXPLICIT-allocator constructor — THE REAL CONSTRUCTION PATH. Build a zero-element `AVec<T>` bound to
// a caller-supplied NARROW Allocator (`a: DynAlloc`), with NO ambient draw. Per the runtime reversal
// (docs/runtime-design.md), an explicit capability handed in is the model: a caller who holds an
// allocator (`std.mem.alloc.dyn_heap()`, an actor's own heap narrowed via `rt.dyn_of_rt`, an arena)
// calls this and the thread-local is never touched. The ambient `new()` below is a one-line shim over
// it — the single ambient draw (`rt.dyn_current()`) on the vec construction path.
// `empty`'s T lives only in its return type; pin it via the annotation (nested-return inference can't
// reach it through the struct-literal field). `empty` is fallible, so unwrap fail-fast here (the
// ambient form is fail-fast on OOM by design).
new_in*<T> = (a: DynAlloc) AVec<T> {
    da := a
    ivr: Result<Vec<T>, IoError> := empty(da.addr())
    AVec<T>(
        inner: ivr.expect("vec.new: out of memory"),
        alloc: a,
    )
}
// a zero-element ambient `AVec<T>` (capacity for one, like `empty`). T can't be inferred from an
// argument, so it comes from the LHS annotation: `v: AVec<i32> := vec.new()`. The ambient rt is drawn
// ONCE here (narrowed to an Allocator) and stored for the life of the vec (all later ops use the
// stored allocator, never `current()`). The `new_in` body is inlined (rather than `new_in(dyn_current())`)
// so the shim makes no bare `new_in` call — that bare name is ambiguous with std.text.string's generic
// `new_in<A>(MutPtr<A>)` once both modules flatten together; the qualified `vec.new_in` stays the
// external real path.
new*<T> = () AVec<T> {
    a := dyn_current()
    ivr: Result<Vec<T>, IoError> := empty(a.addr())
    AVec<T>(
        inner: ivr.expect("vec.new: out of memory"),
        alloc: a,
    )
}
// EXPLICIT-allocator seed constructor: an `AVec<T>` bound to `a`, seeded from a slice (copies `xs`). No
// ambient draw. T is inferred from the elements.
from_in*<T> = (a: DynAlloc, xs: [T]) AVec<T> {
    da := a
    iv: Vec<T> := of(da.addr(), xs).expect("vec.from: out of memory")
    AVec<T>(
        inner: iv,
        alloc: a,
    )
}
// an ambient `AVec<T>` seeded from a slice. Narrow the current rt once; `from_in`'s body is inlined
// (no bare `from_in` call — same string-`new_in` collision avoidance as `new`). Fail-fast.
from*<T> = (xs: [T]) AVec<T> {
    a := dyn_current()
    iv: Vec<T> := of(a.addr(), xs).expect("vec.from: out of memory")
    AVec<T>(
        inner: iv,
        alloc: a,
    )
}
