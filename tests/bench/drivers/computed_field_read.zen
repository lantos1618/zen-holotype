// tests/bench/drivers/computed_field_read.zen
// driver for bench_field.zen's computed_field_read; see vec_add.zen's
// header for why the body is mirrored. The same dot as
// stored_field_read, supplied by an impl and re-evaluated on read --
// if these two ever diverge, uniform access is not free. Budget:
// ns_op 2, allocs_op 0, bytes_op 0 (bench_budgets.zen).

Rect* = {
    width: f64,
    height: f64,
}

Circle* = { radius: f64 }

Circle.impl(Rect, {
    width: self.radius * 2.0,
    height: self.radius * 2.0,
})

main = (env: Env) Res<i32, IoError> {
    c = Circle(radius: 1.5);
    total ::= 0.0;
    Range(0, 10000000).loop((h, i) {
        total = total + c.width;
    });
    (total > 0.0).match({
        true  => Ok(0),
        false => Ok(1),
    });
}
