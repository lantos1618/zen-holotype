// `?:` canonicalization: a short exhaustive two-arm boolean `.match` becomes the ternary
// conditional `c ? t : e`; arms too long for one line keep the multiline `.match` form; a nested
// conditional keeps the match form with the INNER conditional rendered as a ternary; a ternary
// used as a postfix receiver or as a Bin operand is parenthesized so the output reparses to the
// same AST; block-bodied statement matches keep the `.match` spelling.
pick = (n: i32) i32 {
    a := (n > 3).match ({ true => 10, false => 20 })
    b := (n > 3).match ({ true => n.helper(1, 2, 3) + n.helper(4, 5, 6) + 999999, false => n.helper(7, 8, 9) + n.helper(10, 11, 12) + 888888 })
    c := n < 3 ? 1 : n < 10 ? 2 : 3
    d := (n > 3).match ({ true => 1, false => 2 }) + 5
    e := ((n > 3).match ({ true => 1, false => 2 })).helper(1, 2, 3)
    a + b + c + d + e
}
helper = (n: i32, a: i32, b: i32, c: i32) i32 { n + a + b + c }
act = (c: bool) i32 {
    r := 0
    c.match ({ true => {
        r = 1
    }, false => {
        r = 2
    } })
    r
}
main = () i32 { pick(5) + act(true) }
