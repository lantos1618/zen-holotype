// Decimal and hexadecimal spelling live in std.core.byte rather than in
// each formatter. Every integer-domain overload must pick the same ASCII
// table, and u64 hex covers both sides of the 9/a boundary.

digit, hex_digit = std.core

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();

    zero: u8     = 0;
    nine: u64    = 9;
    four: i64    = 4;
    seven: usize = 7;
    decimal ::= alloc.String().try();
    decimal.add(digit(zero)).try();
    decimal.add(digit(nine)).try();
    decimal.add(digit(four)).try();
    decimal.add(digit(seven)).try();
    println("decimal [{}]", decimal.view());

    h0: u64 = 0;
    h9: u64 = 9;
    ha: u64 = 10;
    hf: u64 = 15;
    hex ::= alloc.String().try();
    hex.add(hex_digit(h0)).try();
    hex.add(hex_digit(h9)).try();
    hex.add(hex_digit(ha)).try();
    hex.add(hex_digit(hf)).try();
    println("hex [{}]", hex.view());
    Ok(0);
}
