// Filesystem capability lowering. Paths stay borrowed `str` values; the C
// floor supplies NUL termination. Only `read` allocates, through its `Alloc`
// bound. Floor error ordinals are converted back to variants by name here.

ExprId = std.ast
Call, Access = std.ast
AllocError = std.mem
str, String = std.text
TyId = sema.sema_ty
Ctx = sema.sema_check
sym_member, sym_variant, sym_gen, RES_PATH = gen.gen_name
CBackend = gen.gen_c.gen_c_state
unsupported = gen.gen_c.gen_c_report
ctype, request_type, field_of = gen.gen_c.gen_c_type
declare_temp, init_temp, payload_type = gen.gen_c.gen_c_flow
write_assign_ok, write_assign_ok_unit, write_assign_err = gen.gen_c.gen_c_flow
close_else, close_brace, open_rc_test = gen.gen_c.gen_c_flow
Slot = gen.gen_c.gen_c_fat
slot_call = gen.gen_c.gen_c_bound
address_of = gen.gen_c.gen_c_fat
expr = gen.gen_c.gen_c_expr
arg_text, str_arg = gen.gen_c.gen_c_arg

// One filesystem result being assembled. The return type and the two C
// temporaries stay fixed while its ordinal chain is written.
FsResult = {
    ret: TyId,
    rc: str,
    dst: str,

    chain = (self: @Self, be :: CBackend, n: usize)
            Res<(), AllocError> {
        (n > 4).match({
            true  => be.write_assign_err(self.ret, fs_name(n), self.dst),
            false => self.branch(be, n),
        })
    }

    branch = (self: @Self, be :: CBackend, n: usize)
             Res<(), AllocError> {
        be.open_ordinal_test(self.rc, n).try();
        be.write_assign_err(self.ret, fs_name(n), self.dst).try();
        be.close_else().try();
        self.chain(be, n + 1).try();
        be.close_brace().try();
        Ok(())
    }
}

// Stable source facts for one filesystem operation. Backend state and the
// caller's output remain borrowed method parameters; the call identity,
// types and checking context move as one value through validation.
FsSite = {
    id: ExprId,
    c: Call,
    ret: TyId,
    ctx: Ctx,

    path = (self: @Self, be :: CBackend, i: usize, out :: String)
           Res<(), AllocError> {
        be.str_arg(self.c, i, self.ctx, out)
    }

    reject = (self: @Self, be :: CBackend, what: str, out :: String)
             Res<(), AllocError> {
        be.unsupported(self.id, what, out)
    }

    lock = (self: @Self, be :: CBackend, out :: String)
           Res<(), AllocError> {
        be.need_fs();
        be.payload_type(self.ret, "Ok").match({
            None    => self.reject(
                be,
                "Fs.lock must return a Res<Lock, FsError>",
                out
            ),
            Ok(lty) => self.lock_value(be, lty, out),
        })
    }

    lock_value = (self: @Self, be :: CBackend, lty: TyId, out :: String)
                 Res<(), AllocError> {
        be.request_type(lty).try();
        i32_ty = be.check.types.prim("i32").try();
        path ::= be.alloc.String().try();
        self.path(be, 0, path).try();
        rc  ::= be.fresh_name("t").try();
        fd  ::= be.fresh_name("t").try();
        dst ::= be.fresh_name("t").try();
        be.declare_temp(i32_ty, rc.view()).try();
        be.declare_temp(i32_ty, fd.view()).try();
        be.declare_temp(self.ret, dst.view()).try();
        be.write_lock_call(rc.view(), path.view(), fd.view()).try();
        be.open_rc_test(rc.view()).try();
        be.fs_chain(self.ret, rc.view(), dst.view(), 1).try();
        be.close_else().try();
        value ::= be.alloc.String().try();
        value.add("(").try();
        be.ctype(lty, value).try();
        value.add("){ .").try();
        sym_member(value, "fd").try();
        value.fmt(" = {} }", fd.view()).try();
        be.write_assign_ok(self.ret, value.view(), dst.view()).try();
        be.close_brace().try();
        out.add(dst.view())
    }

    read = (self: @Self, be :: CBackend, aty: TyId, out :: String)
           Res<(), AllocError> {
        be.need_fs();
        be.payload_type(self.ret, "Ok").match({
            None    => self.reject(
                be,
                "Fs.read must return a Res<String, FsError>",
                out
            ),
            Ok(sty) => self.read_string(be, sty, aty, out),
        })
    }

    read_string = (self: @Self, be :: CBackend, sty: TyId, aty: TyId,
                   out :: String) Res<(), AllocError> {
        be.field_of(sty, "data").try().match({
            None    => self.reject(
                be,
                "Fs.read must return a Res<String, FsError>",
                out
            ),
            Ok(vty) => self.read_run(be, sty, vty, aty, out),
        })
    }

    read_run = (self: @Self, be :: CBackend, sty: TyId, vty: TyId,
                aty: TyId, out :: String) Res<(), AllocError> {
        usize_ty = be.check.types.prim("usize").try();
        i32_ty   = be.check.types.prim("i32").try();
        be.request_type(sty).try();
        be.request_type(vty).try();
        path ::= be.alloc.String().try();
        self.path(be, 1, path).try();
        al ::= be.alloc.String().try();
        be.hold_alloc(self.c, aty, self.ctx, al).try();
        want ::= be.fresh_name("t").try();
        got  ::= be.fresh_name("t").try();
        rc   ::= be.fresh_name("t").try();
        dst  ::= be.fresh_name("t").try();
        be.declare_temp(usize_ty, want.view()).try();
        be.declare_temp(usize_ty, got.view()).try();
        be.declare_temp(i32_ty, rc.view()).try();
        be.declare_temp(self.ret, dst.view()).try();
        be.set_line(want.view(), "0").try();
        be.set_line(got.view(), "0").try();
        be.write_size_call(rc.view(), path.view(), want.view()).try();
        be.open_rc_test(rc.view()).try();
        be.fs_chain(self.ret, rc.view(), dst.view(), 1).try();
        be.close_else().try();
        run = FsRead(
            id: self.id,
            ret: self.ret,
            sty: sty,
            vty: vty,
            aty: aty,
            al: al.view(),
            path: path.view(),
            want: want.view(),
            got: got.view(),
            rc: rc.view(),
            dst: dst.view(),
        );
        run.body(be).try();
        be.close_brace().try();
        out.add(dst.view())
    }
}

// The C names and settled types created by the first half of `Fs.read`.
// Allocation, the floor call and result construction all consume this one
// immutable snapshot instead of relaying eleven independent parameters.
FsRead = {
    id: ExprId,
    ret: TyId,
    sty: TyId,
    vty: TyId,
    aty: TyId,
    al: str,
    path: str,
    want: str,
    got: str,
    rc: str,
    dst: str,

    body = (self: @Self, be :: CBackend) Res<(), AllocError> {
        call ::= be.alloc.String().try();
        args ::= be.alloc.String().try();
        args.fmt(", {}, 16", self.want).try();
        be.slot_call(self.al, self.aty, "raw", args.view(), 2, call)
            .try().match({
                None     => be.unsupported_line(
                    self.id,
                    "Fs.read needs an Alloc"
                ),
                Ok(slot) => self.run(be, slot, call.view()),
            })
    }

    run = (self: @Self, be :: CBackend, slot: Slot, call: str)
          Res<(), AllocError> {
        run ::= be.init_temp(slot.ret, "t", call).try();
        be.open_not_ok(run.view()).try();
        be.write_assign_err(self.ret, "OutOfMemory", self.dst).try();
        be.close_else().try();
        buf ::= be.fresh_name("t").try();
        be.declare_ptr(buf.view()).try();
        be.read_ok_payload(run.view(), buf.view()).try();
        be.write_read_call(
            self.rc,
            self.path,
            buf.view(),
            self.want,
            self.got
        ).try();
        be.open_rc_test(self.rc).try();
        be.fs_chain(self.ret, self.rc, self.dst, 1).try();
        be.close_else().try();
        self.write_ok(be, buf.view()).try();
        be.close_brace().try();
        be.close_brace().try();
        Ok(())
    }

    write_ok = (self: @Self, be :: CBackend, buf: str)
               Res<(), AllocError> {
        value ::= be.alloc.String().try();
        value.add("(").try();
        be.ctype(self.sty, value).try();
        value.add("){ .").try();
        sym_member(value, "data").try();
        value.add(" = ").try();
        self.write_vec(be, buf, value).try();
        value.add(" }").try();
        be.write_assign_ok(self.ret, value.view(), self.dst)
    }

    write_vec = (self: @Self, be :: CBackend, buf: str, out :: String)
                Res<(), AllocError> {
        out.add("(").try();
        be.ctype(self.vty, out).try();
        out.add("){ ").try();
        be.write_vec_field(self.vty, "data", buf, out, true).try();
        be.write_vec_field(self.vty, "len", self.got, out, false).try();
        be.write_vec_field(self.vty, "capacity", self.want, out, false).try();
        be.write_vec_field(self.vty, "alloc", self.al, out, false).try();
        out.add(" }").try();
        Ok(())
    }
}

// Paths are spilled once because a `str` reads both pointer and count.

// `exists` and `is_dir`: one `stat`, and no failure a caller acts on.
// A path that cannot be stat'd is, for the purpose of "should I try to
// open this", a path that is not there.
lower_probe* = (be :: CBackend, c: Call, name: str, ctx: Ctx, out :: String)
              Res<(), AllocError> {
    be.need_fs();
    path ::= be.alloc.String().try();
    be.str_arg(c, 0, ctx, path).try();
    out.fmt("(zg_fs_kind({}){})", path.view(), probe_test(name)).try();
    Ok(());
}

probe_test = (name: str) str {
    name.eq("is_dir").match({ true => " == 1", false => " >= 0" })
}

// `write`: the whole file at once, the mirror of `read`. It takes no
// `Alloc` because it allocates nothing — the bytes are the caller's and
// stay the caller's.
lower_write* = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    ret : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    be.need_fs();
    i32_ty = be.check.types.prim("i32").try();
    path ::= be.alloc.String().try();
    be.str_arg(c, 0, ctx, path).try();
    data ::= be.alloc.String().try();
    be.str_arg(c, 1, ctx, data).try();
    rc  ::= be.fresh_name("t").try();
    dst ::= be.fresh_name("t").try();
    be.declare_temp(i32_ty, rc.view()).try();
    be.declare_temp(ret, dst.view()).try();
    be.write_fs_call(rc.view(), "zg_fs_write(", path.view(), data.view()).try();
    be.open_rc_test(rc.view()).try();
    be.fs_chain(ret, rc.view(), dst.view(), 1).try();
    be.close_else().try();
    be.write_assign_ok_unit(ret, dst.view()).try();
    be.close_brace().try();
    out.add(dst.view())
}

write_fs_call = (be :: CBackend, rc: str, fn: str, first: str, second: str)
                Res<(), AllocError> {
    be.fmt("{rc} = {fn}{first}, {second});\n")
}

// `fs.lock(path)` returns one kernel-owned descriptor; it allocates nothing.

lower_lock* = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    ret : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    FsSite(id: id, c: c, ret: ret, ctx: ctx).lock(be, out)
}

// Status and descriptor are separate: a raw fd could collide with an error
// ordinal. The caller owns `fd` because the Ok payload reads it afterward.
write_lock_call = (be :: CBackend, rc: str, path: str, fd: str)
                  Res<(), AllocError> {
    line ::= be.alloc.String().try();
    line.add(rc).try();
    line.add(" = zg_fs_lock(").try();
    line.add(path).try();
    line.add(", &").try();
    line.add(fd).try();
    line.add(");\n").try();
    be.write(line.view())
}

// `lock.unlock()` receives the Lock by address; `address_of` spills a
// non-place receiver first. The unit answer is the bare value 0.

lower_unlock* = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    ret : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    be.need_fs();
    unknown = be.check.types.unknown().try();
    recv ::= be.alloc.String().try();
    expr(be, a.base, ctx, unknown, recv).try();
    addr ::= be.alloc.String().try();
    be.address_of(recv.view(), rty, addr).try();
    // Parenthesize the address before `->fd`; otherwise `&x->fd` parses as
    // `&(x->fd)`. A separate buffer avoids growing a String through its view.
    ptr ::= be.alloc.String().try();
    ptr.add("(").try();
    ptr.add(addr.view()).try();
    ptr.add(")").try();
    field ::= be.alloc.String().try();
    be.arrow_field(ptr.view(), "fd", field).try();
    be.unlock_line(field.view()).try();
    out.add("0").try();
    Ok(())
}

// `zg_fs_unlock(<field>);\n` — one statement, spelled here so no
// format hole is asked to carry it. The fd is not a str and the floor
// door converts nothing.
unlock_line = (be :: CBackend, field: str) Res<(), AllocError> {
    be.fmt("zg_fs_unlock(").try();
    be.write(field).try();
    be.write(");\n")
}

// `<addr>-><name>` — the fd through a Lock pointer, spelled with the
// member mangler so the C name cannot drift from the type's own.
arrow_field = (be :: CBackend, addr: str, name: str, out :: String)
              Res<(), AllocError> {
    out.add(addr).try();
    out.add("->").try();
    out.sym_member(name)
}

// `remove` separates status from its bool answer. Absence is Ok(false), so
// its error chain starts at Denied rather than NotFound.
lower_remove* = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    ret : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    be.need_fs();
    i32_ty  = be.check.types.prim("i32").try();
    bool_ty = be.check.types.prim("bool").try();
    path ::= be.alloc.String().try();
    be.str_arg(c, 0, ctx, path).try();
    rc  ::= be.fresh_name("t").try();
    yes ::= be.fresh_name("t").try();
    dst ::= be.fresh_name("t").try();
    be.declare_temp(i32_ty, rc.view()).try();
    be.declare_temp(bool_ty, yes.view()).try();
    be.declare_temp(ret, dst.view()).try();
    be.write_remove_call(rc.view(), yes.view(), path.view()).try();
    be.open_rc_test(rc.view()).try();
    be.fs_chain(ret, rc.view(), dst.view(), 2).try();
    be.close_else().try();
    be.write_assign_ok(ret, yes.view(), dst.view()).try();
    be.close_brace().try();
    out.add(dst.view())
}

write_remove_call = (be :: CBackend, rc: str, yes: str, path: str)
                   Res<(), AllocError> {
    be.fmt("{rc} = zg_fs_remove({path}, &{yes});\n")
}

// `fs.read(alloc, path)`: length is bytes received; capacity is bytes asked.

lower_read* = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    ret : TyId,
    aty : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    FsSite(id: id, c: c, ret: ret, ctx: ctx).read(be, aty, out)
}

// Spill Alloc because its slot and receiver are both read.
hold_alloc = (
    be  :: CBackend,
    c   : Call,
    aty : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    sym_gen(out, "t", be.next_tmp()).try();
    value ::= be.alloc.String().try();
    be.arg_text(c, 0, aty, ctx, value).try();
    be.declare_temp(aty, out.view()).try();
    be.set_line(out.view(), value.view()).try();
    Ok(());
}

write_size_call = (be :: CBackend, rc: str, path: str, want: str)
                  Res<(), AllocError> {
    be.fmt("{rc} = zg_fs_size({path}, &{want});\n")
}

unsupported_line = (be :: CBackend, id: ExprId, what: str)
                   Res<(), AllocError> {
    sink ::= be.alloc.String().try();
    be.unsupported(id, what, sink)
}

declare_ptr = (be :: CBackend, name: str) Res<(), AllocError> {
    be.fmt("unsigned char *{name};\n")
}

read_ok_payload = (be :: CBackend, run: str, buf: str)
                  Res<(), AllocError> {
    value ::= be.alloc.String().try();
    value.fmt("(unsigned char *){run}.zg_data.").try();
    sym_member(value, "Ok").try();
    be.set_line(buf, value.view())
}

open_not_ok = (be :: CBackend, run: str) Res<(), AllocError> {
    tag ::= be.alloc.String().try();
    sym_variant(tag, RES_PATH, "Ok").try();
    be.fmt("if ({run}.zg_tag != {}) {\n", tag.view()).try();
    be.indent();
    Ok(());
}

write_read_call = (
    be   :: CBackend,
    rc   : str,
    path : str,
    buf  : str,
    want : str,
    got  : str
) Res<(), AllocError> {
    be.fmt("{rc} = zg_fs_read({path}, {buf}, {want}, &{got});\n")
}

// A field std drops is a line this stops writing rather than a
// diagnostic: `collections_vec.zen` owns the shape.
write_vec_field = (
    be    :: CBackend,
    vty   : TyId,
    name  : str,
    value : str,
    out   :: String,
    first : bool
) Res<(), AllocError> {
    be.field_of(vty, name).try().match({
        None  => Ok(()),
        Ok(_) => be.write_named_init(name, value, out, first),
    })
}

write_named_init = (
    be    :: CBackend,
    name  : str,
    value : str,
    out   :: String,
    first : bool
) Res<(), AllocError> {
    first.match({ true => Ok(()), false => out.add(", ") }).try();
    out.add(".").try();
    out.sym_member(name).try();
    out.fmt(" = {value}").try();
    Ok(());
}

// the failure chain — see the file header for the ordinal/name rule

fs_name = (n: usize) str {
    (n == 1).match({ true => "NotFound", false => fs_name_2(n) })
}

fs_name_2 = (n: usize) str {
    (n == 2).match({ true => "Denied", false => fs_name_3(n) })
}

fs_name_3 = (n: usize) str {
    (n == 3).match({ true => "IsDir", false => fs_name_4(n) })
}

// Exists is ordinal 4, and `lock` is the only floor that answers with
// it: a stat cannot find it and an open cannot create it.
fs_name_4 = (n: usize) str {
    (n == 4).match({ true => "Exists", false => "Failed" })
}

// The final ordinal is a plain else; `remove` enters at 2 because absence is
// not an error for that operation.
fs_chain* = (be :: CBackend, ret: TyId, rc: str, dst: str, n: usize)
           Res<(), AllocError> {
    FsResult(ret: ret, rc: rc, dst: dst).chain(be, n)
}

open_ordinal_test = (be :: CBackend, rc: str, n: usize)
                    Res<(), AllocError> {
    ord ::= be.alloc.String().try();
    ord.write_usize(n).try();
    be.fmt("if ({rc} == {}) {\n", ord.view()).try();
    be.indent();
    Ok(());
}
