// THE FILE ON DISK, complete — the buffer the test opens is the same
// file mid-edit, with `q.` where this has `q.x`. The overlay, not this
// copy, is what the completion build checks; this file exists so the
// build has an entry to walk from and so the two can disagree.
Point = app.shape

near = (q: Point) i32 {
    q.x
}
