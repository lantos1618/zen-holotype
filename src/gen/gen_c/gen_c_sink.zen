// src/gen/gen_c/gen_c_sink.zen
// Lowers the bodyless, type-directed format door on any Sink. The call is
// expanded at its source because a variadic parameter has no C spelling.
// This shares the format walk with `gen_c_fmt`; it remains separate because
// sink writes preserve `WriteError` while allocation answers `AllocError`.
// Primitive writers are resolved in the door's module. Only `add_f64` is a
// backend intrinsic; integer and boolean spelling remains library-owned.

ExprId, Decl, Function, Param, Call = std.ast
Literal, TypeId = std.ast
AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId = sema.sema_ty
Def, decl_at = sema.sema_def
Ctx = sema.sema_check
Inst = sema.sema_inst
param_type = sema.sema_denote
satisfies_bound = sema.sema_bound
sym_fn, sym_gen, sym_variant, RES_PATH = gen.gen_name
GenFault = gen.gen_diag
CBackend = gen.gen_c.gen_c_state
unsupported = gen.gen_c.gen_c_report
ctype = gen.gen_c.gen_c_type
is_c_integer, is_signed = gen.gen_c.gen_c_type
expr, ty_of, named_hole = gen.gen_c.gen_c_expr
declare_temp, is_variant, payload_type = gen.gen_c.gen_c_flow
write_assign_err = gen.gen_c.gen_c_flow
signature_of, recv_arg, arg_value, by_ref = gen.gen_c.gen_c_call
body_end, decoded_bytes, cast_of = gen.gen_c.gen_c_print
FmtAt, fmt_at, ends_run, arguments_taken = gen.gen_c.gen_c_print
report_in_format, NOT_A_HOLE = gen.gen_c.gen_c_print
HOLE_WITHOUT_ARGUMENT, ARGUMENT_WITHOUT_HOLE = gen.gen_c.gen_c_print
slot_call = gen.gen_c.gen_c_bound
fat_value = gen.gen_c.gen_c_fat
sink_display = gen.gen_c.gen_c_display

// recognising the door

// The bodyless `add(out :: Sink, fmt: str, args: ...)`; `::` distinguishes
// the writable sink from ordinary three-parameter functions.
is_sink_door* = (be: CBackend, d: Def, f: Function) bool {
    d.name.eq("add") && be.sink_door_shape(f)
}

// The door's shape with the name held out, because the MEMBER form has
// no `Def` to read a name off — `s.add(..)` carries its name in the
// access. Stated once so the two forms cannot drift into recognising
// different declarations.
sink_door_shape* = (be: CBackend, f: Function) bool {
    bodyless(f) && (f.params.len == 3) && by_ref(f, 0)
        && be.last_is_variadic(f)
}

bodyless* = (f: Function) bool {
    f.body.match({ Ok(_) => false, None => true })
}

// Guard the unsigned subtraction here, not only at a particular caller.
last_is_variadic* = (be: CBackend, f: Function) bool {
    (f.params.len == 0).match({
        true  => false,
        false => be.tail_is_variadic(f, f.params.len - 1),
    })
}

tail_is_variadic = (be: CBackend, f: Function, i: usize) bool {
    f.params.get(i).match({
        None  => false,
        Ok(p) => be.variadic_param(p),
    })
}

variadic_param = (be: CBackend, p: Param) bool {
    p.type.match({
        None  => false,
        Ok(t) => be.variadic_type(t),
    })
}

variadic_type = (be: CBackend, t: TypeId) bool {
    be.tree.type_at(t).kind.match({ Variadic => true, _ => false })
}

// `String.add` reaches the same free door through UFCS. Lower the free
// declaration so writer lookup stays in the door's module; the member's
// `@Self` describes where bytes land, not the Sink used to dispatch them.

lower_member_door* = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    recv : ExprId,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    be.door_decl().try().match({
        None  => be.unsupported(id, "a format door with no declaration", out),
        Ok(d) => be.lower_at_decl(id, c, d, recv, ctx, out),
    })
}

lower_at_decl = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    d    : Def,
    recv : ExprId,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    be.door_fn(d).match({
        None  => be.unsupported(id, "a format door with no declaration", out),
        Ok(g) => be.lower_sink_door(id, c, d, g, Ok(recv), ctx, out),
    })
}

// A member call names no `text_fmt` path, so find the exported door by
// its unique shape: writable receiver, format, variadic tail, no body.
door_decl = (be :: CBackend) Res<Res<Def>, AllocError> {
    found ::= be.alloc.Vec<Def>();
    be.check.world.exported_named("add", found).try();
    kept ::= be.alloc.Vec<Def>();
    found.loop((h, x) { be.keep_door(x, kept).try() });
    Ok(kept.get(0));
}

keep_door = (be :: CBackend, x: Def, out :: Vec<Def>) Res<(), AllocError> {
    be.door_fn(x).match({
        None  => Ok(()),
        Ok(g) => be.keep_shaped(g, x, out),
    })
}

keep_shaped = (be :: CBackend, g: Function, x: Def, out :: Vec<Def>)
              Res<(), AllocError> {
    be.sink_door_shape(g).match({
        true  => out.add(x),
        false => Ok(()),
    })
}

// The `Function` a `Def` declares, and `None` when it declares anything
// else.
door_fn = (be :: CBackend, d: Def) Res<Function> {
    decl_at(be.tree, d.id).match({
        None    => None,
        Ok(dec) => decl_fn(dec),
    })
}

decl_fn = (dec: Decl) Res<Function> {
    dec.kind.match({ Function(g) => Ok(g), _ => None })
}

// Reuse the sink walk for an existing String buffer. `fat_value` presents
// that buffer as the door's Sink; failures jump to the allocating caller's
// label because the two doors expose different error types.

lower_pieces_into* = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    addr : str,
    cty  : TyId,
    fail : usize,
    recv : Res<ExprId>,
    ctx  : Ctx
)
                     Res<bool, AllocError> {
    be.door_decl().try().match({
        None  => Ok(false),
        Ok(d) => be.pieces_at_decl(id, c, addr, cty, fail, d, recv, ctx),
    })
}

pieces_at_decl = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    addr : str,
    cty  : TyId,
    fail : usize,
    d    : Def,
    recv : Res<ExprId>,
    ctx  : Ctx
)
                 Res<bool, AllocError> {
    be.door_fn(d).match({
        None  => Ok(false),
        Ok(f) => be.pieces_into_buffer(id, c, addr, cty, fail, d, f, recv, ctx),
    })
}

pieces_into_buffer = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    addr : str,
    cty  : TyId,
    fail : usize,
    d    : Def,
    f    : Function,
    recv : Res<ExprId>,
    ctx  : Ctx
) Res<bool, AllocError> {
    ret = declared_type(be, d, f.ret).try();
    sty = be.sink_type(d, f).try();
    sink ::= be.alloc.String().try();
    be.buffer_sink(addr, cty, sty, sink).try();
    tmp ::= be.fresh_name("t").try();
    be.declare_temp(ret, tmp.view()).try();
    be.write_ok(ret, tmp.view()).try();
    p = Piece(
        sink: sink.view(),
        sty: sty,
        floor: "",
        tmp: tmp.view(),
        done: fail,
        id: id,
        module: d.id.module.to_usize(),
        rty: cty,
        ret: ret
    );
    fmt_arg(c, recv).match({
        None      => Ok(()),
        Ok(first) => write_pieces(be, c, first, fmt_index(recv) + 1, p, ctx),
    }).try();
    Ok(true);
}

// The record over the caller's buffer, in a temporary of its own so
// that every write names a place and `&` on it is an address — the
// same shape `spill_sink` gives a sink that arrived as an argument.
buffer_sink = (
    be   :: CBackend,
    addr : str,
    cty  : TyId,
    sty  : TyId,
    out  :: String
) Res<(), AllocError> {
    value ::= be.alloc.String().try();
    be.fat_value(addr, cty, sty, value).try();
    sym_gen(out, "t", be.next_tmp()).try();
    be.declare_temp(sty, out.view()).try();
    be.set_line(out.view(), value.view())
}

// what one piece needs
// Where bytes and failures go, kept together across every piece.

Piece* = {
    sink: str,        // the C name of the Sink record, a place
    sty: TyId,        // Sink itself, for its slots
    // Receiver byte writer, or empty when dispatch goes through `sty`.
    floor: str,
    tmp*: str,        // the temporary the door answers with
    done*: usize,     // the label a failing write jumps to
    id: ExprId,       // the door call, for a diagnostic with a position
    module: usize,    // the door's own module: where the writers live
    // Receiver and return type used when a floor widens through a Sink.
    rty: TyId,
    ret: TyId,
}

// the expansion

// A temporary at the door's return type, `Ok` until a write says
// otherwise, and a label every failing write jumps to.
lower_sink_door* = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    d    : Def,
    f    : Function,
    recv : Res<ExprId>,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    ret = declared_type(be, d, f.ret).try();
    sty = be.sink_type(d, f).try();
    sink ::= be.alloc.String().try();
    be.write_sink_temp(c, recv, sty, ctx, sink).try().match({
        false => be.unsupported(id, "a format door with no sink", out),
        true  => write_door(
            be,
            id,
            c,
            d,
            recv,
            ret,
            sty,
            sink.view(),
            ctx,
            out
        ),
    })
}

// The door's declared return and its declared sink, read in the door's
// OWN module. Neither names a type parameter, so there is nothing to
// substitute.
declared_type = (be :: CBackend, d: Def, t: Res<TypeId>)
                Res<TyId, AllocError> {
    t.match({
        Ok(x) => be.check.type_from_ast(x, door_ctx(d)),
        None  => be.check.types.unknown(),
    })
}

sink_type = (be :: CBackend, d: Def, f: Function) Res<TyId, AllocError> {
    f.params.get(0).match({
        None  => be.check.types.unknown(),
        Ok(p) => be.check.param_type(p, door_ctx(d)),
    })
}

door_ctx = (d: Def) Ctx {
    Ctx(
        module: d.id.module.to_usize(),
        ret: TyId(index: 0),
        has_ret: false,
        self_ty: TyId(index: 0),
        has_self: false
    )
}

// Spill once so every write has a stable place whose address C can take.
write_sink_temp = (
    be   :: CBackend,
    c    : Call,
    recv : Res<ExprId>,
    sty  : TyId,
    ctx  : Ctx,
    out  :: String
) Res<bool, AllocError> {
    recv_arg(c, recv).match({
        None  => Ok(false),
        Ok(a) => be.spill_sink(a, sty, ctx, out),
    })
}

spill_sink = (
    be  :: CBackend,
    a   : ExprId,
    sty : TyId,
    ctx : Ctx,
    out :: String
) Res<bool, AllocError> {
    code ::= be.alloc.String().try();
    expr(be, a, ctx, sty, code).try();
    sym_gen(out, "t", be.next_tmp()).try();
    be.declare_temp(sty, out.view()).try();
    be.set_line(out.view(), code.view()).try();
    Ok(true);
}

write_door = (
    be   :: CBackend,
    id   : ExprId,
    c    : Call,
    d    : Def,
    recv : Res<ExprId>,
    ret  : TyId,
    sty  : TyId,
    sink : str,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    tmp ::= be.fresh_name("t").try();
    be.declare_temp(ret, tmp.view()).try();
    be.write_ok(ret, tmp.view()).try();
    p = Piece(
        sink: sink,
        sty: sty,
        floor: "",
        tmp: tmp.view(),
        done: be.next_tmp(),
        id: id,
        module: d.id.module.to_usize(),
        rty: sty,
        ret: ret
    );
    // `out.add("")` is one write of nothing and `out.add(s)` is one
    // write of `s`, so a door with no format argument is not an error —
    // it is the same expansion with no pieces in it.
    fmt_arg(c, recv).match({
        None      => Ok(()),
        Ok(first) => write_pieces(be, c, first, fmt_index(recv) + 1, p, ctx),
    }).try();
    be.write_done(p.done).try();
    out.add_bytes(p.tmp)
}

// `zg_tN = (Res){ .zg_tag = Ok };` — the answer a door with no failing
// write gives, written first so that falling off the end is `Ok` and
// only a failure has to say anything.
write_ok* = (be :: CBackend, ret: TyId, tmp: str) Res<(), AllocError> {
    cty ::= be.alloc.String().try();
    be.ctype(ret, cty).try();
    tag ::= be.alloc.String().try();
    sym_variant(tag, RES_PATH, "Ok").try();
    be.fmt("{tmp} = ({}){{ .zg_tag = {} }};\n", cty.view(), tag.view())
}

fmt_arg = (c: Call, recv: Res<ExprId>) Res<ExprId> {
    arg_value(c, fmt_index(recv))
}

fmt_index = (recv: Res<ExprId>) usize {
    recv.match({ Ok(_) => 0, None => 1 })
}

// `gen_c_print` owns format classification; this file only changes the
// destination from the console to a Sink.

write_pieces* = (
    be    :: CBackend,
    c     : Call,
    first : ExprId,
    used0 : usize,
    p     : Piece,
    ctx   : Ctx
) Res<(), AllocError> {
    raw = format_of(be, first);
    (raw.len == 0).match({
        true  => write_values(be, c, first, used0, p, ctx),
        false => be.walk_format(c, first, raw, used0, p, ctx),
    })
}

// No format at all: every argument is a value and they are written in
// order, which is what `println(s)` does with the same shape.
write_values = (
    be    :: CBackend,
    c     : Call,
    first : ExprId,
    used0 : usize,
    p     : Piece,
    ctx   : Ctx
) Res<(), AllocError> {
    write_value(be, first, p, ctx).try();
    be.write_rest(c, used0, p, ctx)
}

// The raw source slice of a string literal, quotes included, and the
// empty string when the argument is not one. A FORMAT IS READ AT
// COMPILE TIME, so a computed one is not a format at all — it is the
// first value, and `out.add(s)` writes `s`.
format_of = (be: CBackend, id: ExprId) str {
    be.tree.expr_at(id).kind.match({
        Literal(l) => literal_format(l),
        _          => "",
    })
}

literal_format = (l: Literal) str {
    l.kind.match({ Str => l.text, _ => "" })
}

walk_format = (
    be    :: CBackend,
    c     : Call,
    id    : ExprId,
    raw   : str,
    used0 : usize,
    p     : Piece,
    ctx   : Ctx
) Res<(), AllocError> {
    end = body_end(raw);
    start ::= 1;
    used  ::= used0;
    i     ::= 1;
    loop(() { i < end }, (h) {
        at = fmt_at(raw, i, end);
        at.ends_run().then(() {
            write_chunk(be, raw, start, at.keep, p).try();
            write_what(be, c, id, at, used, p, ctx).try();
            used  = used + at.what.arguments_taken();
            start = at.next;
        });
        i = at.next;
    });
    write_chunk(be, raw, start, end, p).try();
    be.write_surplus(c, used, p, ctx).try();
    Ok(());
}

// What one position turned out to be, written into the sink. `gen_c_print`
// has the same four arms with the console under them; what differs is
// only where the bytes go, which is why the CLASSIFICATION is shared and
// this is not.
write_what = (
    be   :: CBackend,
    c    : Call,
    id   : ExprId,
    at   : FmtAt,
    used : usize,
    p    : Piece,
    ctx  : Ctx
) Res<(), AllocError> {
    at.what.match({
        Hole     => write_hole(be, c, id, at, used, p, ctx),
        Named(n) => write_named(be, id, at, n, p),
        NoName   => report_in_format(
            be,
            id,
            at,
            GenFault.Unsupported(NOT_A_HOLE)
        ),
        _        => Ok(()),
    })
}

// `{name}` into the sink, through the writer its type picks. Every
// decision after "what is it" is `write_value`'s, reached with the C text
// and the type read off the binding's own slot.
write_named = (be :: CBackend, id: ExprId, at: FmtAt, name: str, p: Piece)
              Res<(), AllocError> {
    text ::= be.alloc.String().try();
    be.named_hole(name, text).try().match({
        None  => report_in_format(be, id, at, GenFault.Unresolved(name)),
        Ok(t) => be.write_typed_into(id, t, text.view(), p),
    })
}

// A hole with no argument left is a compile error at the hole's own
// position, the missing direction of the arity law `gen_c_print`'s
// twin enforces on the console doors — the same law, so a format
// mismatched on holes/arguments is refused through every door.
write_hole = (
    be   :: CBackend,
    c    : Call,
    id   : ExprId,
    at   : FmtAt,
    used : usize,
    p    : Piece,
    ctx  : Ctx
) Res<(), AllocError> {
    arg_value(c, used).match({
        None  => report_in_format(
            be,
            id,
            at,
            GenFault.Unsupported(HOLE_WITHOUT_ARGUMENT)
        ),
        Ok(a) => write_value(be, a, p, ctx),
    })
}

// An argument with no hole left, refused at the argument — the surplus
// direction of the same law. Reached with the walk's final count by both
// the console walk and this one; the no-format shape never gets here.
write_surplus = (be :: CBackend, c: Call, used: usize, p: Piece, ctx: Ctx)
                Res<(), AllocError> {
    (used < c.args.len).match({
        false => Ok(()),
        true  => arg_value(c, used).match({
            None   => Ok(()),
            Ok(id) => be.report_expr(
                id,
                GenFault.Unsupported(ARGUMENT_WITHOUT_HOLE)
            ),
        }),
    })
}

// Every argument from `used` on, written in order — the NO-FORMAT shape
// only, where every argument is a value on purpose and there is no
// arity to mismatch.
write_rest = (be :: CBackend, c: Call, used: usize, p: Piece, ctx: Ctx)
             Res<(), AllocError> {
    Range(used, c.args.len).loop((h, i) {
        arg_value(c, i).match({
            None  => Ok(()),
            Ok(a) => write_value(be, a, p, ctx),
        }).try();
    });
    Ok(());
}

// One literal chunk, and nothing at all when the chunk is empty.
write_chunk = (
    be    :: CBackend,
    raw   : str,
    start : usize,
    stop  : usize,
    p     : Piece
) Res<(), AllocError> {
    (stop > start).match({
        false => Ok(()),
        true  => write_literal(be, raw.slice(start, stop), p),
    })
}

// A run of bytes, verbatim, through the sink's own `write`. The RAW
// slice travels into the emitted C unchanged and only its LENGTH is
// counted — `gen_c_print.zen` says why that is sound.
write_literal = (be :: CBackend, piece: str, p: Piece)
                Res<(), AllocError> {
    text ::= be.alloc.String(
        "(zg_str){{ (unsigned char *)\"{piece}\", {}u }}",
        decoded_bytes(piece)
    ).try();
    call ::= be.alloc.String().try();
    be.sink_write(p, text.view(), call).try().match({
        false => be.unsupported_piece(p.id, "a sink with no write"),
        true  => be.write_guarded(call.view(), p),
    })
}

// one value
// The write a `{}` becomes is chosen by the ARGUMENT'S TYPE and by
// nothing else: `{}` carries no format spec, so there is nothing else
// to read.

write_value = (be :: CBackend, a: ExprId, p: Piece, ctx: Ctx)
              Res<(), AllocError> {
    unknown = be.check.types.unknown().try();
    ty      = be.ty_of(a, ctx, unknown).try();
    text ::= be.alloc.String().try();
    expr(be, a, ctx, ty, text).try();
    be.write_typed_into(a, ty, text.view(), p)
}

// The write a value becomes once its C text and its type are in hand. A
// `{name}` hole arrives here with both read off its own slot, so the two
// hole spellings share every decision after "where did the value come
// from" — the second door below included.
write_typed_into = (be :: CBackend, a: ExprId, ty: TyId, text: str, p: Piece)
                   Res<(), AllocError> {
    call ::= be.alloc.String().try();
    be.value_call(p, ty, text, call).try().match({
        true  => be.write_guarded(call.view(), p),
        false => be.write_wider(a, ty, text, p),
    })
}

// A `str` is the sink's own `write` — bytes, verbatim, no format
// meaning read into them. Everything else goes through a WRITER.
value_call = (be :: CBackend, p: Piece, ty: TyId, text: str, out :: String)
             Res<bool, AllocError> {
    prim = be.check.prim_name(ty);
    prim.eq("str").match({
        true  => be.sink_write(p, text, out),
        false => be.wider_call(p, ty, prim, text, out),
    })
}

// A floor writes only `str`; wider values must reopen the same receiver
// through its Sink implementation.
wider_call = (
    be   :: CBackend,
    p    : Piece,
    ty   : TyId,
    prim : str,
    text : str,
    out  :: String
) Res<bool, AllocError> {
    p.floor.is_empty().match({
        true  => be.scalar_call(p, ty, prim, text, out),
        false => Ok(false),
    })
}

// A non-str floor hole uses a Sink record over the same receiver (#755).
// The receiver must implement Sink and the floor's error set must contain
// `OutOfMemory`; otherwise lowering refuses it. Str holes and literal runs
// remain direct floor writes. See `docs/design_fmt.md` §6 for the error
// conversion contract.
write_wider = (be :: CBackend, a: ExprId, ty: TyId, text: str, p: Piece)
              Res<(), AllocError> {
    p.floor.is_empty().match({
        true  => be.unsupported_piece(a, hole_fault(p)),
        false => be.through_sink(a, ty, text, p),
    })
}

through_sink = (be :: CBackend, a: ExprId, ty: TyId, text: str, p: Piece)
               Res<(), AllocError> {
    be.door_decl().try().match({
        None  => be.unsupported_piece(a, hole_fault(p)),
        Ok(d) => be.sink_at_door(a, ty, text, p, d),
    })
}

sink_at_door = (
    be   :: CBackend,
    a    : ExprId,
    ty   : TyId,
    text : str,
    p    : Piece,
    d    : Def
) Res<(), AllocError> {
    be.door_fn(d).match({
        None  => be.unsupported_piece(a, hole_fault(p)),
        Ok(f) => be.sink_over_receiver(a, ty, text, p, d, f),
    })
}

sink_over_receiver = (
    be   :: CBackend,
    a    : ExprId,
    ty   : TyId,
    text : str,
    p    : Piece,
    d    : Def,
    f    : Function
) Res<(), AllocError> {
    sty  = be.sink_type(d, f).try();
    wret = declared_type(be, d, f.ret).try();
    be.wider_is_sound(p, sty).try().match({
        false => be.unsupported_piece(a, hole_fault(p)),
        true  => be.write_through_sink(a, ty, text, p, d, sty, wret),
    })
}

// Refuse a null Sink slot or an error set unable to carry OutOfMemory.
wider_is_sound = (be :: CBackend, p: Piece, sty: TyId) Res<bool, AllocError> {
    be.check.satisfies_bound(p.rty, sty).try().match({
        false => Ok(false),
        true  => Ok(be.names_out_of_memory(p.ret)),
    })
}

names_out_of_memory = (be :: CBackend, ret: TyId) bool {
    be.payload_type(ret, "Err").match({
        None    => false,
        Ok(ety) => be.is_variant(ety, "OutOfMemory"),
    })
}

// The record, a temporary at the SINK door's answer for the write to
// land in, and then `value_call` again — with a piece that is the sink
// door's in every field, so a `u8` reaches `add_u64` and a `Display`
// reaches its `toString` by the one set of rules.
write_through_sink = (
    be   :: CBackend,
    a    : ExprId,
    ty   : TyId,
    text : str,
    p    : Piece,
    d    : Def,
    sty  : TyId,
    wret : TyId
) Res<(), AllocError> {
    rec ::= be.alloc.String().try();
    be.buffer_sink(p.sink, p.rty, sty, rec).try();
    wtmp ::= be.fresh_name("t").try();
    be.declare_temp(wret, wtmp.view()).try();
    q = Piece(
        sink: rec.view(),
        sty: sty,
        floor: "",
        tmp: wtmp.view(),
        done: p.done,
        id: p.id,
        module: d.id.module.to_usize(),
        rty: sty,
        ret: wret
    );
    call ::= be.alloc.String().try();
    // Diagnose against the reopened Sink door, not the original floor.
    be.value_call(q, ty, text, call).try().match({
        false => be.unsupported_piece(a, hole_fault(q)),
        true  => be.wider_guarded(call.view(), wtmp.view(), p),
    })
}

// Guard the reopened write, converting its failure to the floor's
// OutOfMemory before joining the existing done label.
wider_guarded = (be :: CBackend, call: str, wtmp: str, p: Piece)
                Res<(), AllocError> {
    be.set_line(wtmp, call).try();
    tag ::= be.alloc.String().try();
    sym_variant(tag, RES_PATH, "Ok").try();
    be.fmt("if ({wtmp}.zg_tag != {}) {\n", tag.view()).try();
    be.indent();
    be.write_assign_err(p.ret, "OutOfMemory", p.tmp).try();
    be.write_goto(p.done).try();
    be.dedent();
    be.writeln("}").try();
    Ok(());
}

hole_fault = (p: Piece) str {
    p.floor.is_empty().match({
        true  => "formatting a value of this type",
        false => "a format hole on this door that is not a str",
    })
}

scalar_call = (
    be   :: CBackend,
    p    : Piece,
    ty   : TyId,
    prim : str,
    text : str,
    out  :: String
) Res<bool, AllocError> {
    writer_of(prim).is_empty().match({
        true  => be.sink_display(ty, text, p.sink, out),
        false => be.writer_call(p, writer_of(prim), cast_of(prim), text, out),
    })
}

// Which of `text_fmt.zen`'s writers a primitive reaches. Empty means
// none does, and the value goes through its own `toString` instead.
writer_of = (prim: str) str {
    prim.eq("bool").match({
        true  => "add_bool",
        false => number_writer(prim),
    })
}

// Both float widths use the backend-owned f64 writer; double represents
// every f32 exactly.
number_writer = (prim: str) str {
    is_float(prim).match({
        true  => "add_f64",
        false => integer_writer(prim),
    })
}

integer_writer = (prim: str) str {
    is_c_integer(prim).match({
        false => "",
        true  => signed_writer(prim),
    })
}

signed_writer = (prim: str) str {
    is_signed(prim).match({ true => "add_i64", false => "add_u64" })
}

// Bytes into whichever floor this door was opened on.
sink_write = (be :: CBackend, p: Piece, text: str, out :: String)
             Res<bool, AllocError> {
    p.floor.is_empty().match({
        true  => be.slot_write(p, text, out),
        false => floor_write(p, text, out),
    })
}

// `<floor>(<receiver>, <bytes>)` — a direct call to the receiver's own
// writer. No record: the receiver's type is concrete, so which function
// runs is known here.
floor_write = (p: Piece, text: str, out :: String) Res<bool, AllocError> {
    out.fmt("{}({}, {})", p.floor, p.sink, text).try();
    Ok(true);
}

// `<sink>.write(<sink>.zg_self, <bytes>)` — the one member of `Sink`
// that takes bytes, reached through the record because a sink's whole
// point is that the writer does not know which one it holds.
slot_write = (be :: CBackend, p: Piece, text: str, out :: String)
             Res<bool, AllocError> {
    args ::= be.alloc.String(", {text}").try();
    be.slot_call(p.sink, p.sty, "write", args.view(), 1, out).try().match({
        None  => Ok(false),
        Ok(_) => Ok(true),
    })
}

// `zu_..add_i64(&<sink>, (int64_t)(<value>))`. The writer is looked up
// in the DOOR'S module and not through the caller's imports, because
// the expansion is the backend's: a caller that wrote `out.add("{}", n)`
// never named `add_i64`.
writer_call = (
    be   :: CBackend,
    p    : Piece,
    name : str,
    cast : str,
    text : str,
    out  :: String
) Res<bool, AllocError> {
    be.module_decl(p.module, name).try().match({
        None  => Ok(false),
        Ok(w) => be.door_fn(w).match({
            None  => Ok(false),
            Ok(g) => bodyless(g).match({
                true  => be.write_intrinsic_call(p, cast, text, out),
                false => be.write_writer_call(w, p, cast, text, out),
            }),
        }),
    })
}

// The backend-owned float writer renders with `%g`, then immediately
// copies the shared scratch through the receiver's normal byte path.
write_intrinsic_call = (
    be   :: CBackend,
    p    : Piece,
    cast : str,
    text : str,
    out  :: String
) Res<bool, AllocError> {
    be.need_fbuf();
    // Doubled braces are literal C braces. `cast` and `text` stay
    // positional: emitted expressions must never be read as format syntax.
    bytes ::= be.alloc.String(
        "(zg_str){{ (unsigned char *)zg_f64_scratch, (size_t)snprintf(zg_f64_scratch, sizeof zg_f64_scratch, \"%g\", {}({})) }}",
        cast,
        text
    ).try();
    be.sink_write(p, bytes.view(), out)
}

write_writer_call = (
    be   :: CBackend,
    w    : Def,
    p    : Piece,
    cast : str,
    text : str,
    out  :: String
) Res<bool, AllocError> {
    sym ::= be.alloc.String().try();
    be.call_symbol(w, sym).try();
    out.fmt("{}(&{}, {}({}))", sym.view(), p.sink, cast, text).try();
    Ok(true);
}

// A bodied writer that can be queued for emission.
module_fn = (be :: CBackend, mi: usize, name: str)
            Res<Res<Def>, AllocError> {
    found ::= be.alloc.Vec<Def>();
    be.check.world.defs_of(mi, name, found).try();
    kept ::= be.alloc.Vec<Def>();
    found.loop((h, x) { be.keep_bodied(x, kept).try() });
    Ok(kept.get(0));
}

// Includes bodyless backend intrinsics such as `add_f64`.
module_decl = (be :: CBackend, mi: usize, name: str)
              Res<Res<Def>, AllocError> {
    found ::= be.alloc.Vec<Def>();
    be.check.world.defs_of(mi, name, found).try();
    kept ::= be.alloc.Vec<Def>();
    found.loop((h, x) { be.keep_fn(x, kept).try() });
    Ok(kept.get(0));
}

keep_fn = (be :: CBackend, x: Def, out :: Vec<Def>)
          Res<(), AllocError> {
    decl_at(be.tree, x.id).match({
        None    => Ok(()),
        Ok(dec) => keep_fn_decl(dec, x, out),
    })
}

keep_fn_decl = (dec: Decl, x: Def, out :: Vec<Def>)
               Res<(), AllocError> {
    dec.kind.match({
        Function(_) => out.add(x),
        _           => Ok(()),
    })
}

keep_bodied = (be :: CBackend, x: Def, out :: Vec<Def>)
              Res<(), AllocError> {
    decl_at(be.tree, x.id).match({
        None    => Ok(()),
        Ok(dec) => keep_bodied_decl(dec, x, out),
    })
}

keep_bodied_decl = (dec: Decl, x: Def, out :: Vec<Def>)
                   Res<(), AllocError> {
    dec.kind.match({
        Function(fn) => keep_bodied_fn(fn, x, out),
        _            => Ok(()),
    })
}

keep_bodied_fn = (fn: Function, x: Def, out :: Vec<Def>)
                 Res<(), AllocError> {
    bodyless(fn).match({
        true  => Ok(()),
        false => out.add(x),
    })
}

// the symbol, and the short circuit that keeps a failure visible

// The symbol of a plain, non-generic function, queued so the walk
// reaches its body: "was this already emitted" and "what do I call"
// have to be the same question.
call_symbol* = (be :: CBackend, d: Def, out :: String)
               Res<(), AllocError> {
    sig  ::= be.alloc.Vec<TyId>();
    inst ::= be.alloc.Inst();
    be.signature_of(d, inst, sig).try();
    sym ::= be.alloc.String().try();
    sym_fn(sym, be.check.types, be.check.world, d.qname, sig, inst).try();
    be.need_function(d, inst, sym.view()).try();
    out.add_bytes(sym.view())
}

// The write and guard share a temporary because the sink door preserves
// the writer's error type unchanged.
write_guarded = (be :: CBackend, call: str, p: Piece) Res<(), AllocError> {
    be.set_line(p.tmp, call).try();
    be.write_jump_unless_ok(p.tmp, p.done)
}

// A piece this backend cannot write. Reported at the node rather than
// swallowed, and the door still answers with its temporary so the C
// around it stays well formed.
unsupported_piece = (be :: CBackend, id: ExprId, what: str)
                    Res<(), AllocError> {
    be.report_expr(id, GenFault.Unsupported(what))
}

// `if (zg_tN.zg_tag != Ok) { goto done; }`
write_jump_unless_ok* = (be :: CBackend, tmp: str, done: usize)
                        Res<(), AllocError> {
    tag ::= be.alloc.String().try();
    sym_variant(tag, RES_PATH, "Ok").try();
    be.fmt("if ({tmp}.zg_tag != {}) {\n", tag.view()).try();
    be.indent();
    be.write_goto(done).try();
    be.dedent();
    be.writeln("}").try();
    Ok(());
}

write_goto* = (be :: CBackend, done: usize) Res<(), AllocError> {
    name = be.done_name(done).try();
    be.fmt("goto {};\n", name.view())
}

// THE DONE LABEL of a Res cleanup, beside the goto that jumps to it --
// `f<n>: ;`. A loop's break label is a different thing with a stem and a
// number (`gen_c_loop.zen`'s write_label); this one has exactly one name,
// which is why it is not that function.
write_done* = (be :: CBackend, done: usize) Res<(), AllocError> {
    name = be.done_name(done).try();
    be.fmt("{}: ;\n", name.view())
}

done_name = (be :: CBackend, done: usize) Res<String, AllocError> {
    name ::= be.alloc.String().try();
    sym_gen(name, "f", done).try();
    Ok(name)
}
