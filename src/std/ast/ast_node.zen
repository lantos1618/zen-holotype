// AST declarations, types, expressions, patterns, and statements. Each node
// family uses the same wrapper-and-kind shape:
//
//     Expr = { kind: ExprKind, span, leading, trailing }
//     ExprKind = Call(Call) | Binary(Binary) | ..
//
// Common source data lives on the wrapper; variant data lives in the kind.
// Child nodes are stored as typed arena ids rather than by value.

Span, Ident, QualifiedName, TriviaRun = std.ast.ast_span
ExprId, TypeId, PatternId, BlockId, CBindingId = std.ast.ast_id
Alloc, AllocError = std.mem

// `+ - *` trap on overflow; `+% -% *%` wrap. Zen has no bitwise operators.
BinOp* = Add
    | Sub
    | Mul
    | Div
    | Rem
    | AddWrap
    | SubWrap
    | MulWrap
    | Equal
    | NotEqual
    | Less
    | LessEq
    | Greater
    | GreaterEq
    | And
    | Or

// Unary `!`, `-`, and address-of `&`.
UnOp* = Not | Neg | Addr

// Method forms. Export (`*`) is stored on the member.
//     Required   `= sig`        impl must provide it
//     Sealed     `= sig {..}`   provided, cannot be overridden
//     Default    `::= sig {..}` provided, impl may rebind it
//     Hook       `::= sig`      optional, impl may provide it
//
// A top-level function with a body also uses Sealed.
Form* = Required | Sealed | Default | Hook

LiteralKind* = Int | Float | Str | Char | Bool

// `text` is the raw source slice, including quotes and escapes.
Literal* = {
    kind*: LiteralKind,
    text*: str,
}

Type* = {
    kind*: TypeKind,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,
}

// `Unit` is `()`, `SelfType` is `@Self`, `Infer` is `_`, and `Variadic` is
// `...`.
TypeKind* = Named(Named)
    | Union(Union)
    | Fn(FnType)
    | Array(ArrayType)
    | Unit
    | SelfType
    | Infer
    | Variadic

// Named types such as `i32`, `Vec<T>`, and `Res<(), AllocError>`.
Named* = {
    name*: Ident,
    args*: Vec<TypeId>,
}

// Anonymous structural union. Members are stored flat.
Union* = {
    members*: Vec<TypeId>,
}

// Function type such as `(a: i32, b: i32) i32`. Parameter names do not
// participate in type identity.
FnType* = {
    tparams*: Vec<TParam>,
    params*: Vec<Param>,
    params_span*: Span,
    ret*: TypeId,
}

// `[u8, 64]`, `[u8, i32.BITS]`. The count is an expression because it
// is comptime, not because it is a literal.
ArrayType* = {
    elem*: TypeId,
    count*: ExprId,
}

// ---------------------------------------------------------------------
// patterns
// ---------------------------------------------------------------------

Pattern* = {
    kind*: PatternKind,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,
}

// `Name` covers BOTH a nullary variant (`None`, `Macos`, `Shape.Unit`)
// and a binder (`n` in `Ok(n)`) — same tokens, and which one it is
// depends on what's in scope, so it's sema's question, not the
// parser's (the parser answering would be guessing).
PatternKind* = Name(PatName)
    | Destructure(Destructure)
    | Wild
    | Literal(Literal)

PatName* = {
    name*: QualifiedName,
}

// `Ok(n)`, `Circle(circle)`, `Ok(_)`, nested: `Left(Full(n))`. The
// binder is a full pattern, which is why `Unit` and `Unit(_)` must be
// different nodes — else the formatter invents or deletes parens.
Destructure* = {
    name*: QualifiedName,
    binder*: PatternId,
}

// ---------------------------------------------------------------------
// expressions
// ---------------------------------------------------------------------

Expr* = {
    kind*: ExprKind,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,
}

// `Access` represents member expressions such as `p.x`.
ExprKind* = Name(Name)
    | Literal(Literal)
    | Unit
    | SelfType
    | Scope
    | Meta(Meta)
    | Paren(Paren)
    | Array(ArrayLit)
    | FixedArray(FixedArray)
    | Lambda(Lambda)
    | Call(Call)
    | Match(Match)
    | Try(Try)
    | Record(Record)
    | Access(Access)
    | Index(Index)
    | Unary(Unary)
    | Binary(Binary)
    | Consume(Consume)
    | Block(BlockId)

// A bare identifier. Carries text, not an `Ident` — the enclosing
// `Expr` already has the span, and two spans for one token is two
// things to keep in agreement.
Name* = {
    text*: str,
}

// Parentheses are retained explicitly so formatting preserves grouping.
Paren* = {
    inner*: ExprId,
}

// `[0, 1, 2]`
ArrayLit* = {
    elems*: Vec<ExprId>,
}

// `[i32, 4](2, 3, 5, 7)` — a fixed-array type applied to its elements.
// Its own kind, not a Call: an array literal is never a callee, and
// the reading has to be decidable at the `(`.
FixedArray* = {
    type*: TypeId,
    elems*: Vec<ExprId>,
    args_span*: Span,
}

// `(a: i32, b: i32) i32 { a + b }`, `(h, v) { .. }`, `() { .. }`.
// Parameter types are optional here and only here: a closure passed to
// a function whose signature is known infers its param types from it.
// A declaration is not a lambda and must write them.
Lambda* = {
    tparams*: Vec<TParam>,
    params*: Vec<Param>,
    params_span*: Span,
    ret*: Res<TypeId>,
    body*: BlockId,
}

// `f(a, b)`, `alloc.Vec<i32>()`, `Point(x: 3, y: 4)`.
Call* = {
    callee*: ExprId,
    targs*: Vec<TypeId>,
    args*: Vec<Arg>,
    args_span*: Span,
}

// One argument. `name` is the `x` of `x: 3` — construction and an
// impl's supplied field share this form and this node.
Arg* = {
    name*: Res<Ident>,
    value*: ExprId,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,
}

// `(n == 0).match({ true => .., false => .. })`. Match carries an arm list
// and is checked for exhaustiveness, so it is distinct from Call.
//
// `name_span` is the `match` token — an "is not exhaustive" diagnostic
// points there, and the formatter needs it to locate `.match(`.
Match* = {
    scrutinee*: ExprId,
    name_span*: Span,
    arms*: Vec<Arm>,
    arms_span*: Span,
}

// `pattern => expr`. `arrow_span` is the `=>`: the formatter aligns
// arms on it, and it cannot align what it cannot locate.
Arm* = {
    pattern*: PatternId,
    arrow_span*: Span,
    body*: ExprId,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,
}

// `.try()` — the non-local-exit intrinsic, NOT a call. There's no
// `try` field on `Res` and no function of that name, so parsing it as
// a call would create a name to special-case everywhere it's shadowed.
// `name_span` is the `try` token, here for the same reason as
// `Match.name_span`: the node's own span starts at the OPERAND
// (`checked(n).try()` begins at `checked`), which would point a
// diagnostic at code that is perfectly well formed.
Try* = {
    operand*: ExprId,
    name_span*: Span,
    // Empty propagates; a value replaces; a one-argument lambda maps.
    error*: Res<ExprId>,
}

// `{ src: Path("src/main.zen"), deps: [json] }` — the brace literal, as
// a call argument or an impl body. Entries are `Member`s not `Arg`s:
// an impl supplies methods as well as values, one rule and one node.
Record* = {
    entries*: Vec<Member>,
}

// `p.x`, `Shape.Unit`, `i32.MAX`, `alloc.Vec`. Field access, a type
// constant, a variant, and a ufcs method are all this one node — a new
// spelling of an existing access form, not a new concept.
Access* = {
    base*: ExprId,
    name*: Ident,
}

// `buf[i]`. Fixed-array indexing traps out of bounds; Vec.get returns Res.
// `op_span` identifies the `[` for diagnostics.
Index* = {
    base*: ExprId,
    index*: ExprId,
    op_span*: Span,
}

// `op_span` is the operator token, load-bearing not cosmetic (see Index).
Unary* = {
    op*: UnOp,
    op_span*: Span,
    operand*: ExprId,
}

Binary* = {
    op*: BinOp,
    op_span*: Span,
    lhs*: ExprId,
    rhs*: ExprId,
}

// `consume f` — a move, stated at the use site. The only thing the
// capability system ever writes down.
Consume* = {
    operand*: ExprId,
}

// `@meta(n)` and `@meta(self: @Self)`. Stage 5. The second form is the
// only place an argument carries a type annotation, so it gets its own
// fields rather than being bent into an `Arg`. Exactly one of `value`
// and `name`+`type` is present.
Meta* = {
    value*: Res<ExprId>,
    name*: Res<Ident>,
    type*: Res<TypeId>,
}

// ---------------------------------------------------------------------
// statements and blocks
// ---------------------------------------------------------------------

// A statement ends with `;`; a declaration does not. A Stmt's span
// INCLUDES its `;` (else deleting a statement leaves it behind); the
// expression inside does not.
Stmt* = {
    kind*: StmtKind,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,
}

// `Decl` is here because a struct/enum/impl/function may be declared
// anywhere, not only at module level, and takes no `;` wherever it stands.
StmtKind* = Bind(Bind) | Expr(ExprStmt) | Decl(Decl) | Block(BlockId)

// `x = e;`, `x ::= e;`, `x: T = e;`, `self.len = self.len + 1;`. The
// target is an expression, not a name: a member and an index are
// binding targets too, and narrowing to `Ident` would make
// `self.len = ..` unrepresentable.
Bind* = {
    target*: ExprId,
    type*: Res<TypeId>,
    mutable*: bool,
    value*: ExprId,
}

ExprStmt* = {
    expr*: ExprId,
}

// `value` is the trailing expression written without a semicolon. Sema may
// also settle a semicolon-terminated tail as the block value.
Block* = {
    stmts*: Vec<Stmt>,
    value*: Res<ExprId>,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,
}

// ---------------------------------------------------------------------
// declarations
// ---------------------------------------------------------------------

Decl* = {
    kind*: DeclKind,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,
}

// `Import` is a DeclKind, not a separate list on `Module`, so
// `Module.decls` is the file in source order — a formatter merging two
// lists back into one order will eventually get it wrong.
DeclKind* = Struct(Struct)
    | Enum(Enum)
    | Alias(Alias)
    | Function(Function)
    | Impl(Impl)
    | Import(Import)
    | Const(Const)

// `Vec*<T> = { .. }`. `body_span` is the `{ .. }`: a struct body is not
// a `Block` (it holds members not statements), but the formatter still
// needs to know where its braces are.
Struct* = {
    name*: Ident,
    exported*: bool,
    tparams*: Vec<TParam>,
    members*: Vec<Member>,
    body_span*: Span,
}

// `Shape = Circle(Circle) | Rect(Rect) | Unit`, `AllocError* = | OutOfMemory`.
// `leading_bar` is the bar of the one-variant form, stored rather than
// derived from `variants.len == 1` because the formatter reprints what
// was written. It's also why an enum needs no lookahead: without it,
// `AllocError = OutOfMemory` and `Alias = Shape` are the same tokens.
Enum* = {
    name*: Ident,
    exported*: bool,
    tparams*: Vec<TParam>,
    variants*: Vec<Variant>,
    leading_bar*: Res<Span>,
}

// One payload type, never a list. A payload is a TYPE: `Circle(Circle)`,
// `Failed(str)`, never `name: value` — which keeps `Package(url: "..")`
// a call, not a variant.
Variant* = {
    name*: Ident,
    payload*: Res<TypeId>,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,
}

// `Alias = Shape`. An alias IS the type, not a name forwarding to it —
// sema resolves it away, nothing downstream sees a second type.
Alias* = {
    name*: Ident,
    exported*: bool,
    tparams*: Vec<TParam>,
    target*: TypeId,
}

// `area* = (c: Circle) f64 { .. }`, `then* = <T>(b: bool, f: () T) Res<T>`.
// `form` records `=` versus `::=`; `body` records whether `{ .. }` followed.
// Required and Hook carry no body. A lambda may omit `ret`, but a declaration
// must write one.
Function* = {
    name*: Ident,
    exported*: bool,
    form*: Form,
    tparams*: Vec<TParam>,
    params*: Vec<Param>,
    params_span*: Span,
    ret*: Res<TypeId>,
    body*: Res<BlockId>,
}

// `Circle.impl(Rect, { width: .., height: .. })`. The target is local to its
// declaring module and therefore stored as an Ident.
Impl* = {
    target*: Ident,
    bound*: TypeId,
    members*: Vec<Member>,
    body_span*: Span,
}

// `Res*, Ok*, None* = std.core.result`. Re-export is just an import
// whose bindings are starred — the star is the whole mechanism.
Import* = {
    names*: Vec<ImportName>,
    module*: QualifiedName,
}

ImportName* = {
    name*: Ident,
    exported*: bool,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,
}

// A module-level value binding: `json_pkg = Package(url: "..", ..)`,
// `STR_HASH_SEED*: u64 = 14695981039346656037`. Also used as a
// struct-body constant (`MAX*: i32 = 2147483647`): one value per type,
// not storage per instance.
Const* = {
    name*: Ident,
    exported*: bool,
    mutable*: bool,
    type*: Res<TypeId>,
    value*: ExprId,
}

// ---------------------------------------------------------------------
// members
//
// Shared member shape for struct bodies, impl bodies, and record literals.
// ---------------------------------------------------------------------

Member* = {
    kind*: MemberKind,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,

    // Name shared by all member variants.
    name* = (self: @Self) Ident {
        self.kind.match({
            Field(f)    => f.name,
            Const(c)    => c.name,
            Function(f) => f.name,
        })
    }

    named* = (self: @Self, n: str) bool {
        self.name().text.eq(n)
    }

    exported* = (self: @Self) bool {
        self.kind.match({
            Field(f)    => f.exported,
            Const(c)    => c.exported,
            Function(f) => f.exported,
        })
    }

    // Storage talk: a Function member answers false. (Ownership asks a
    // different question — `sema_recv.zen`'s `member_is_mutable`, where
    // a Function answers true — and keeps its own function for it.)
    mutable* = (self: @Self) bool {
        self.kind.match({
            Field(f)    => f.mutable,
            Const(c)    => c.mutable,
            Function(_) => false,
        })
    }
}

// The Field/Const split is SYNTACTIC (grammar's R4): in a struct body,
// `name: T = value` (immutable) is a constant, `name :: T = value`
// (mutable) is a field with a default. Const never appears in an impl
// body or record literal, where `name: value` supplies a field.
//
// Known hole, not a decision: an IMMUTABLE field with a default is
// unspellable.
MemberKind* = Field(Field) | Const(Const) | Function(Function)

// `width: f64`, `len* :: usize = 0`, and — in an impl or record —
// `width: self.radius * 2.0`, where type is absent because the field
// being satisfied already has one.
Field* = {
    name*: Ident,
    exported*: bool,
    mutable*: bool,
    type*: Res<TypeId>,
    value*: Res<ExprId>,
}

// ---------------------------------------------------------------------
// parameters
// ---------------------------------------------------------------------

// `self :: @Self` is not a receiver rule: `mutable` is the ordinary
// binding marker on the ordinary first parameter. `type` is absent
// only in a closure.
Param* = {
    name*: Ident,
    mutable*: bool,
    type*: Res<TypeId>,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,

    // Source separator between this parameter's name and type.
    binder* = (self: @Self) str {
        self.mutable.match({ true => " :: ", false => ": " })
    }
}

// `<T>`, `<T: Rect>`, `<K: Eq + Hash, V>`. Bounds are a LIST because
// `+` joins them: `Eq + Hash` is two requirements on one type, where
// `A | B` is one type that is either.
TParam* = {
    name*: Ident,
    bounds*: Vec<TypeId>,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,
}

// ---------------------------------------------------------------------
// modules
// ---------------------------------------------------------------------

// The raw headers behind a loader-created C binding module. `system`
// selects `<path>` over `"path"`; the path itself never carries C syntax.
CHeader* = {
    path*: str,
    system*: bool,
}

COpaque* = {
    decl*: u32,
    spelling*: str,
}

CTypeBinding* = | Opaque(COpaque)

CBinding* = {
    headers*: Vec<CHeader>,
    types*: Vec<CTypeBinding>,
}

ModuleOrigin* = Source | CBinding(CBindingId)

// `name` is the dotted module path (`std.core.result`), the module's
// identity; the source file is `span.file`, already carried by every
// node in it. `trailing` is where an end-of-file comment lives — it has
// nowhere else to go, and a formatter dropping it fails its round trip.
Module* = {
    name*: str,
    decls*: Vec<Decl>,
    span*: Span,
    leading*: TriviaRun,
    trailing*: TriviaRun,
}

// Gather module functions in source order.
functions* = (self: Module, a: Alloc) Res<Vec<Function>, AllocError> {
    found ::= a.Vec<Function>();
    self.decls.loop((h, d) {
        d.kind.match({
            Function(f) => found.add(f),
            _           => Ok(()),
        }).try();
    });
    Ok(found);
}
