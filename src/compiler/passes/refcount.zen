// compiler.passes.refcount — refcount insertion sub-pass extracted from compiler.check.
{ CallData, Decl, Expr, FieldInit, Func, GenericData, LoopData, MatchData, Param, Stmt, Ty } = compiler.ast.ast_types
{ dfunc, no_tys, subst_ty_in, tvoid, acquire_or_die } = compiler.genc
{ mangle_semantic_in } = compiler.mangle
{ Env, arm_env, bind_fnret, empty_params, extend_env, fnret_of, is_void_ty, params_env, pbuf,
  tloop_index, vcons } = compiler.check
{ no_inline_gen_f } = compiler.check_inline
{ subst_body } = compiler.passes.subst
{ panic } = std.core.result
{ Malloc } = std.mem.alloc
{ expr_fold_children } = compiler.ast.expr_children
{ gd_has_mangled, gd_tys_max_depth } = compiler.generics
{ loop_at } = std.core.count
rc_calls_es = (xs: [Expr], nm: StringView) bool {
    f ::= false
    xs.loop_at((i, x) { f = f.then({ true }, { x.addr().rc_calls_e(nm) }) })
    f
}
rc_calls_e = (e: Ptr<Expr>, nm: StringView) bool {
    load(e).match ({
        // `.Call` is the only shape that can NAME nm; every other shape is a plain structural
        // descent, so it delegates to the one exhaustive child listing.
        .Call(c) => c.fn == nm || c.args.rc_calls_es(nm),
        _        => false.expr_fold_children(e, (acc, ch) { acc || ch.rc_calls_e(nm) }, (acc, body) {
            acc || body.rc_calls_body(nm)
        }),
    })
}
rc_calls_stmt = (st: Stmt, nm: StringView) bool {
    st.match ({
        .Let(l)      => l.value.rc_calls_e(nm),
        .Assign(x)   => x.target.rc_calls_e(nm) || x.value.rc_calls_e(nm),
        .Return(r)   => r.rc_calls_e(nm),
        .ExprStmt(e) => e.rc_calls_e(nm),
        .If(f)       => f.c.rc_calls_e(nm) || f.then.rc_calls_body(nm) || f.els.rc_calls_body(nm),
        .While(w)    => w.c.rc_calls_e(nm) || w.body.rc_calls_body(nm),
        .IndexSet(x) => x.seq.rc_calls_e(nm) || x.idx.rc_calls_e(nm) || x.value.rc_calls_e(nm),
    })
}
rc_calls_body* = (body: [Stmt], nm: StringView) bool {
    f ::= false
    body.loop_at((i, st) { f = f.then({ true }, { st.rc_calls_stmt(nm) }) })
    f
}
// A body calling a REFLECTION intrinsic (field_eq / each_field / zip_fields / variant_name) must SPLICE like an
// FnT-param generic: the intrinsic expands in the inliner with the receiver's CONCRETE type, which
// only the call-site inline provides. Lives here (beside its rc_calls_body walker) so both the
// inline router (check_inline.no_inline_gen_f) and the validator (kinds.ka_rec_hof_kind) share it.
calls_reflect* = (body: [Stmt]) bool {
    body.rc_calls_body("field_eq")
        || body.rc_calls_body("each_field")
        || body.rc_calls_body("zip_fields")
        || body.rc_calls_body("variant_name")
}
// ── HIDDEN early returns × inlining ──────────────────────────────────────────────────────────
// resolve_orx lowers a CONDITIONAL-position `or_return` (a match/cond arm value, a `&&`/`||` rhs, a
// while condition) into a value block whose Err-guard is a raw `return` INSIDE an expression. The
// inliner's early-return lift (needs_early_lift → cps_value) sees only top-level .Return statements
// and returns in .If branches — a return buried in an expression (Block/Match/Cond/…) or anywhere in
// a While/Loop body is invisible to it, and a return inside a loop can't be lifted to `?:` at all.
// Splicing such a body into a caller's GCC statement-expression would leave a raw C `return` that
// exits the CALLER — the callee's early return escapes (silent wrong control flow), or the generated
// C fails to compile when the return types differ. A generic fn whose body holds such a HIDDEN
// return must therefore never be inlined: no_inline_gen_f routes it through the recursive-generic
// monomorphization path (mono_rec) instead, where it becomes a real C function and its `return` is
// an honest function return. Statement-level returns (top level / If branches) stay inlinable — the
// existing lift handles those (or_return_expr_generic_inline relies on it). FnT-param generics can't
// monomorphize (their lambda args must splice), so they are out of scope here, as before.
rc_gbuf* = (a: MutPtr<Malloc>, n: i64) [GenericData] {
    slice(a.acquire_or_die(n * sizeof(GenericData)), n)
}
// dedup scan (gd_has_mangled) + type-arg nesting depth (gd_ty_depth/gd_tys_max_depth) are shared
// leaves; they live in compiler.generics (imported above) alongside their mono twins. rc_add stays
// local — it differs from mono's add_inst only in its panic message, so it is NOT byte-identical.
rc_add = (buf: [GenericData], cnt: i32, g: GenericData) i32 {
    // a polymorphic-recursive self-call (deeper targs each step) would grow the worklist forever; drop
    // the absurdly-deep instance (a well-formed one is shallow) and never write past the buffer.
    (1 + g.args.gd_tys_max_depth() > 24).then({
        return cnt
    })
    (cnt >= buf.len).then({
        panic("zenc: too many recursive-generic fn instances (rc_gbuf cap; raise it in compiler.check)")
    })
    buf[cnt] = g
    cnt + 1
}
// discovery: walk concrete bodies (Env-threaded for full type inference incl. addr/dispatch), recording
// one instance per recursive-generic call site (targs inferred exactly as resolve_call will mangle them).
rc_col_es = (env: Env, buf: [GenericData], cnt: i32, xs: [Expr]) i32 {
    c ::= cnt
    xs.loop_at((i, x) { c = env.rc_col_e(buf, c, x.addr()) })
    c
}
rc_col_inits = (env: Env, buf: [GenericData], cnt: i32, inits: [FieldInit]) i32 {
    c ::= cnt
    inits.loop_at((i, fi) { c = env.rc_col_e(buf, c, fi.value) })
    c
}
rc_col_match = (env: Env, buf: [GenericData], cnt: i32, m: MatchData) i32 {
    c ::= env.clr_exp().rc_col_e(buf, cnt, m.subj)
    t = env.infer_expr(m.subj)
    m.arms.loop_at((i, ar) { c = env.a.arm_env(env, t, ar).rc_col_e(buf, c, ar.body) })
    c
}
rc_col_loop = (env: Env, buf: [GenericData], cnt: i32, l: LoopData) i32 {
    c = env.clr_exp().rc_col_e(buf, cnt, l.seq)
    e = Env(
        vars: env.a.vcons(l.elem, l.elemTy, env.a.vcons(l.idx, tloop_index(), env.vars)),
        decls: env.decls,
        didx: env.didx,
        exp: env.exp,
        a: env.a,
    )
    e.rc_col_body(buf, c, l.body)
}
rc_lam_env = (env: Env, ps: [Param]) Env {
    e ::= env
    ps.loop_at((i, p) {
        // bind as Void (opaque), NOT p.ty: a lambda param's ty is only its formatter-round-trip `: Type`
        // annotation — the rc pass must see the same opaque binding whether or not the source annotated it.
        e = Env(
            vars: e.a.vcons(p.name, tvoid(), e.vars),
            decls: e.decls,
            didx: e.didx,
            exp: e.exp,
            a: e.a,
        )
    })
    e
}
rc_col_call = (env: Env, buf: [GenericData], cnt: i32, c: CallData) i32 {
    dn = env.dispatch_name(c)
    f = env.env_func(dn)
    known = f.name == dn && f.params.len == c.args.len
    tmpl = known && f.is_generic_fn()
    atargs = tmpl.then({ env.call_targs(f, c.args, c.targs) }, { no_tys() })
    c2 ::= cnt
    c.args.loop_at((i, ar) {
        ax = known.then({ env.call_arg_exp(tmpl, f.tparams, atargs, f.params, i) }, { tvoid() })
        c2 = env.with_exp(ax).rc_col_e(buf, c2, ar.addr())
    })
    (known && f.no_inline_gen_f()).match ({
        true  => {
            m = env.a.mangle_semantic_in(dn, atargs)
            (buf.gd_has_mangled(c2, m) || env.didx.func_idx.get(m, 0 - 1) >= 0).match ({
                true  => c2,
                false => buf.rc_add(c2, GenericData(
                    name: dn,
                    args: atargs,
                    mangled: m,
                )),
            })
        },
        false => c2,
    })
}
// each position walks under the SAME expected type resolve_expr_plain threads there (cleared for
// operands/receivers/payloads, kept for cond branches, the element type for slice items), so a
// generic call's return-position tparam infers — and mangles — exactly as resolve will.
rc_col_e = (env: Env, buf: [GenericData], cnt: i32, e: Ptr<Expr>) i32 {
    load(e).match ({
        .Call(c)       => env.rc_col_call(buf, cnt, c),
        .Bin(b)        => env
            .clr_exp()
            .rc_col_e(buf, env.clr_exp().rc_col_e(buf, cnt, b.lhs), b.rhs),
        .Cond(d)       => env.rc_col_e(buf, env.rc_col_e(buf, env.clr_exp().rc_col_e(buf, cnt, d.c), d.t), d.e),
        .Member(m)     => env.clr_exp().rc_col_e(buf, cnt, m.obj),
        .MakeEnum(mk)  => env.clr_exp().rc_col_e(buf, cnt, mk.payload),
        .MakeStruct(s) => env.clr_exp().rc_col_inits(buf, cnt, s.inits),
        .Match(m)      => env.rc_col_match(buf, cnt, m),
        .Index(ix)     => env
            .clr_exp()
            .rc_col_e(buf, env.clr_exp().rc_col_e(buf, cnt, ix.seq), ix.idx),
        .SliceLit(sd)  => env.with_exp(env.sl_elem_exp(sd.items)).rc_col_es(buf, cnt, sd.items),
        .Loop(l)       => env.rc_col_loop(buf, cnt, l),
        .Block(bl)     => env.rc_col_body(buf, cnt, bl.stmts),
        .Lambda(la)    => env.rc_lam_env(la.params).rc_col_body(buf, cnt, la.body),
        _              => cnt,
    })
}
// mirror resolve_stmt's expected-type discipline: a Let's value under its declared type, a Return's
// operand under the enclosing fn's return, a non-tail ExprStmt under disc_env, conditions cleared.
rc_col_stmt = (env: Env, buf: [GenericData], cnt: i32, st: Stmt, last: bool) i32 {
    st.match ({
        .Let(l)      => env.let_exp(l.ty).rc_col_e(buf, cnt, l.value),
        .Assign(x)   => env.clr_exp().rc_col_e(buf, env.rc_col_e(buf, cnt, x.target), x.value),
        .Return(r)   => {
            rt = env.vars.fnret_of()
            renv = rt.is_void_ty().then({ env }, { env.with_exp(rt) })
            renv.rc_col_e(buf, cnt, r)
        },
        .ExprStmt(e) => (last && env.exp.is_void_ty() == false).match ({
            true  => env.rc_col_e(buf, cnt, e),
            false => env.disc_env(e).rc_col_e(buf, cnt, e),
        }),
        .If(f)       => env.rc_col_body(buf, env.rc_col_body(buf, env
            .clr_exp()
            .rc_col_e(buf, cnt, f.c), f.then), f.els),
        .While(w)    => env.rc_col_body(buf, env.clr_exp().rc_col_e(buf, cnt, w.c), w.body),
        .IndexSet(x) => env
            .clr_exp()
            .rc_col_e(buf, env
                .clr_exp()
                .rc_col_e(buf, env.clr_exp().rc_col_e(buf, cnt, x.seq), x.idx), x.value),
    })
}
rc_col_body = (env: Env, buf: [GenericData], cnt: i32, body: [Stmt]) i32 {
    c ::= cnt
    e ::= env
    body.loop_at((i, st) {
        c = e.rc_col_stmt(buf, c, st, i == body.len - 1)
        e = e.a.extend_env(e, st)
    })
    c
}
// seed from CONCRETE functions only (a template body's self-call has a tparam targ, not a concrete one).
rc_fn_env = (env: Env, f: Func) Env {
    Env(
        vars: env.a.bind_fnret(env.a.params_env(f.params), f.ret),
        decls: env.decls,
        didx: env.didx,
        exp: f.ret,
        a: env.a,
    )
}
// `from` skips decls already seeded by an earlier mono_close round: only the tail appended (and
// HOF-spliced) since the previous round can surface NEW instances — the head's bodies are unchanged.
rc_seed* = (env: Env, buf: [GenericData], cnt: i32, from: i64) i32 {
    c ::= cnt
    env.decls.loop_at((i, d) {
        c = (i >= from).match ({
            true  => d.match ({
                .DFunc(f) => f.is_generic_fn().match ({
                    true  => c,
                    false => env.rc_fn_env(f).rc_col_body(buf, c, f.body),
                }),
                _         => c,
            }),
            false => c,
        })
    })
    c
}
// the substituted param list of one instance (tparam→arg in each param type).
rc_subst_params = (a: MutPtr<Malloc>, tparams: [Param], targs: [Ty], ps: [Param]) [Param] {
    buf ::= a.pbuf(ps.len)
    ps.loop_at((i, p) { buf[i] = param(p.name, a.subst_ty_in(tparams, targs, p.ty)) })
    buf
}
// transitive closure: each instance's substituted body may name further instances (its own self-call,
// or a call to another recursive generic), so walk every instance body until no new ones appear.
rc_expand_one = (env: Env, buf: [GenericData], count: i32, i: i32) i32 {
    g = buf[i]
    tf = env.didx.idx_func(env.decls, g.name)
    iparams = env.a.rc_subst_params(tf.tparams, g.args, tf.params)
    ibody = env.a.subst_body(0, tf.tparams, g.args, tf.body)
    iret = env.a.subst_ty_in(tf.tparams, g.args, tf.ret)
    ienv = Env(
        vars: env.a.bind_fnret(env.a.params_env(iparams), iret),
        decls: env.decls,
        didx: env.didx,
        exp: iret,
        a: env.a,
    )
    env.rc_expand(buf, ienv.rc_col_body(buf, count, ibody), i + 1)
}
rc_expand* = (env: Env, buf: [GenericData], count: i32, i: i32) i32 {
    (i >= count).then({ count }, { env.rc_expand_one(buf, count, i) })
}
// the concrete DFunc for one instance: template params/ret/body with tparam→arg substituted, given the
// mangled name. Its self-call stays the bare template name; the final resolve_call mangles it (the
// instance decl now exists), which also resolves dispatch (e.g. allocator methods) on the concrete type.
rc_gen* = (env: Env, g: GenericData) Decl {
    tf = env.didx.idx_func(env.decls, g.name)
    dfunc(Func(
        name: g.mangled,
        params: env.a.rc_subst_params(tf.tparams, g.args, tf.params),
        ret: env.a.subst_ty_in(tf.tparams, g.args, tf.ret),
        tparams: empty_params(),
        body: env.a.subst_body(0, tf.tparams, g.args, tf.body),
    ))
}
// append one concrete C function per discovered recursive-generic instance. The templates stay in the
// decl list (emit skips them via is_template); resolve_call — run after this — rewrites the calls.
