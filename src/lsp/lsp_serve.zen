// src/lsp/lsp_serve.zen
// The server: lifecycle, a document overlay, and a dispatch table.
//
// It answers FIVE requests and handles THREE notifications, and refuses
// everything else BY NAME with `-32601` and the method spelled back —
// `src/zen/zen_cli.zen`'s own rule one level down: a command that
// silently does nothing is worse than one that says it is not written.
//
//   initialize                 capabilities, and the gate opens
//   shutdown                   `null`, and no more work is accepted
//   textDocument/hover         lsp_hover.zen — the one sema-backed query
//   textDocument/semanticTokens/full
//                              lsp_colour.zen — the lexer's own tokens,
//                              reclassified by what the diagnostics'
//                              build settled about each name
//                              (lsp_names.zen), lexical alone when there
//                              is no clean build
//   everything else            -32601, with the method named
//   initialized / exit / $/cancelRequest   notifications, no reply
//   didOpen / didChange / didClose         the overlay, Full sync only
//
// SYNC IS FULL AND CANNOT USEFULLY BE INCREMENTAL. `design_lsp.md` §5:
// ids are indices in creation order, a `Checker` copies a finished
// `Ast`, compilation is whole-program — so a range edit followed by
// handing the whole buffer to a whole-program compiler buys nothing.
//
// `$/cancelRequest` IS DROPPED, not honoured: there is no yield point in
// `check_all`, and this server is single-threaded (`PLAN.md:194`: the
// seed subset has no threads).
//
// THIS FILE HOLDS NO TRANSPORT. `one` takes request bytes and appends
// reply bytes; `serve` walks a buffer of frames the same way — so
// `lsp_stdio.zen` puts a pipe under the same server the corpus drives
// from a file, and the two answer identically by construction.
//
// OVER 500 LINES, per STYLE.md's justification: the subject is one
// session (lifecycle, document store, the table that routes one
// message) sharing the `Server` that holds all three. `publishDiagnostics`
// moved its own subject to `lsp_diag.zen`, leaving here only the
// trigger — a change marks, `settled` is where the transport says the
// batch is over.

str, String = std.text
Vec, Map = std.collections
Alloc, AllocError = std.mem
Jsons, JsonId, write_text, written = lsp.lsp_json
read, JsonFault = lsp.lsp_json_read
FrameFault, frame_at, write_frame, write_decimal = lsp.lsp_frame
Hover, hover_at, hover_in = lsp.lsp_hover
// The colours, and the legend `initialize` has to advertise them under.
// Both come from `lsp_colour.zen` so the index a token carries and the
// list it indexes cannot be spelled in two files.
write_legend, write_tokens = lsp.lsp_colour
// The one message this server sends unprompted, and the policy that
// decides when. `lsp_diag.zen` holds both; this file holds the trigger.
Diagnostics = lsp.lsp_diag
// A wire coordinate, written where it is converted. This file kept a
// private copy while hover was the only answer with a range.
write_wire = lsp.lsp_pos
path_of = lsp.lsp_uri

// The whole of the server's state.
//
// `docs` maps a URI to the open buffer's text, a `str` borrowed from the
// decoded JSON string in `a`. Safe because `a` is an arena outliving the
// session; a per-request arena would make this a copy.
Server* = {
    a: Alloc,

    // THE AUTHORITY A QUERY NEEDS. Hover is a build now and reads the
    // disk, so the server holds the same `Env` the driver does.
    env: Env,

    // THE WORKSPACE, from `initialize`'s `rootUri`, as a path. Empty
    // until `initialize` arrives or the client sends none — load-bearing
    // emptiness: it sends hover back to the single-module answer instead
    // of building a root nobody named. NOT THE COMPILATION ROOT
    // (`zen_path.root_for` computes that from the document); this is
    // only the floor it may not climb past.
    workspace :: str = "",

    docs :: Map<str, str>,

    // THE SAME DOCUMENTS, IN OPENING ORDER: a `Map` here cannot be
    // walked, and a build's overlay must carry EVERY unsaved buffer, not
    // only the one being edited.
    open :: Vec<str>,

    // What has been said about those documents, and what is owed — the
    // policy lives in `lsp_diag.zen`; this file only marks and settles.
    notes :: Diagnostics,

    ready :: bool,        // `initialize` has been answered
    stopping :: bool,     // `shutdown` has been answered

    // Has `shutdown` been answered? The FIELD stays unexported: nothing
    // outside this file may decide when the server stops accepting work.
    stopped* = (self: @Self) bool { self.stopping }

    // One message: read it, route it, frame whatever it produced.
    one* = (self :: @Self, body: str, out :: String) Res<(), AllocError> {
        tree ::= self.a.Jsons();
        msg ::= self.a.String().try();
        read(self.a, tree, body).match({
            Err(f)  => parse_error(f, msg),
            Ok(req) => self.route(tree, req, msg),
        }).try();
        // AN EMPTY MESSAGE IS A NOTIFICATION AND GETS NO FRAME — the
        // protocol forbids replying to one.
        msg.is_empty().match({
            true  => written(),
            false => write_frame(msg.view(), out),
        })
    }

    route = (self :: @Self, tree: Jsons, req: JsonId, msg :: String)
            Res<(), AllocError> {
        method = method_of(tree, req);
        // THE PRESENCE OF `id` IS WHAT MAKES A MESSAGE A REQUEST, not
        // the method name — a table of notification names would be a
        // second, divergent copy of the spec.
        tree.field(req, "id").match({
            None    => self.notified(tree, req, method),
            Ok(rid) => self.requested(tree, req, method, rid, msg),
        })
    }

    // BEFORE `initialize`, EVERY REQUEST IS REFUSED with `-32002` — the
    // one piece of lifecycle a server cannot skip.
    requested = (self :: @Self, tree: Jsons, req: JsonId, method: str,
                 rid: JsonId, msg :: String) Res<(), AllocError> {
        (self.ready || method.eq("initialize")).match({
            false => failed(tree, rid, NOT_INITIALIZED,
                            "the server has not been initialized", msg),
            true  => self.answered(tree, req, method, rid, msg),
        })
    }

    answered = (self :: @Self, tree: Jsons, req: JsonId, method: str,
                rid: JsonId, msg :: String) Res<(), AllocError> {
        method.eq("initialize").match({
            true  => self.initialized(tree, req, rid, msg),
            false => method.eq("shutdown").match({
                true  => { self.stopping = true; result(tree, rid, "null", msg) },
                false => method.eq("textDocument/hover").match({
                    true  => self.hovered(tree, req, rid, msg),
                    false => method.eq(SEMANTIC_TOKENS).match({
                        true  => self.coloured(tree, req, rid, msg),
                        false => self.unknown(tree, rid, method, msg),
                    }),
                }),
            }),
        })
    }

    // `initialize` IS WHERE A SERVER LEARNS WHERE IT IS: `rootUri`
    // arrives once and every later request names only a document.
    //
    // A CLIENT THAT SENDS NONE IS NOT AN ERROR. `rootUri` is nullable
    // and a single-file editor session has no root — the field stays
    // empty and hover falls back to checking the open document alone.
    //
    // `rootPath` IS NOT READ — the deprecated spelling of the same
    // thing, and a second source for one fact can disagree with the
    // first.
    initialized = (self :: @Self, tree: Jsons, req: JsonId, rid: JsonId,
                   msg :: String) Res<(), AllocError> {
        self.ready = true;
        self.workspace = path_of(string_at(tree, params_of(tree, req),
                                           "rootUri"));
        caps ::= self.a.String().try();
        write_capabilities(caps).try();
        result(tree, rid, caps.view(), msg)
    }

    // REFUSED BY NAME: the method is echoed so a client's log says which
    // request is unimplemented, not that some request failed.
    unknown = (self :: @Self, tree: Jsons, rid: JsonId, method: str,
               msg :: String) Res<(), AllocError> {
        why ::= self.a.String().try();
        why.add_bytes("no handler for ").try();
        why.add_bytes(method).try();
        why.add_bytes(" - see docs/design_lsp.md for the stage it arrives at").try();
        failed(tree, rid, METHOD_NOT_FOUND, why.view(), msg)
    }

    // `initialized`, `exit`, `didClose` and `$/cancelRequest` all mean
    // "nothing to do here" and fall through the same `false` arm, named
    // here rather than as four empty branches that would hide a fifth.
    notified = (self :: @Self, tree: Jsons, req: JsonId, method: str)
               Res<(), AllocError> {
        method.eq("textDocument/didOpen").match({
            true  => self.opened(tree, req),
            false => method.eq("textDocument/didChange").match({
                true  => self.changed(tree, req),
                false => written(),
            }),
        })
    }

    opened = (self :: @Self, tree: Jsons, req: JsonId) Res<(), AllocError> {
        doc = param(tree, req, "textDocument");
        self.remember(string_at(tree, doc, "uri"), string_at(tree, doc, "text"))
    }

    // FULL SYNC: `contentChanges[0].text` is the whole new buffer, since
    // `initialize` advertised `textDocumentSync: 1`; a `range` field
    // would mean incremental sync, never asked for, and is not read.
    changed = (self :: @Self, tree: Jsons, req: JsonId) Res<(), AllocError> {
        uri = string_at(tree, param(tree, req, "textDocument"), "uri");
        edits = param(tree, req, "contentChanges");
        text = tree.item(edits, 0).match({
            None    => "",
            Ok(one) => string_at(tree, one, "text"),
        });
        self.remember(uri, text)
    }

    // A URI with no text is not stored — an empty document and an
    // absent one are different states.
    remember = (self :: @Self, uri: str, text: str) Res<(), AllocError> {
        uri.is_empty().match({
            true  => written(),
            false => self.stored(uri, text),
        })
    }

    // UNCHANGED BYTES ARE NOT A CHANGE — the only mitigation this server
    // can perform for the per-keystroke build cost (`lsp_diag.zen`'s
    // header says why a timed debounce cannot be).
    stored = (self :: @Self, uri: str, text: str) Res<(), AllocError> {
        self.docs.get(uri).match({
            None     => self.changed_to(uri, text),
            Ok(held) => held.eq(text).match({
                true  => written(),
                false => self.changed_to(uri, text),
            }),
        })
    }

    changed_to = (self :: @Self, uri: str, text: str) Res<(), AllocError> {
        self.docs.set(uri, text).try();
        self.listed(uri).try();
        self.notes.owes(uri);
        Ok(());
    }

    listed = (self :: @Self, uri: str) Res<(), AllocError> {
        self.open.find((u) { u.eq(uri) }).match({
            Ok(_) => written(),
            None  => self.open.add(uri),
        })
    }

    // THE SETTLE POINT: every message the transport was holding has been
    // answered, so a build owed to the last of them happens now. Called
    // by `serve` at buffer end and by `lsp_stdio.zen` after each drain.
    //
    // NOTHING IS SENT AFTER `shutdown`: no work is accepted once it has
    // been answered, and an unprompted notification between `shutdown`
    // and `exit` is work the client has just said it does not want.
    settled* = (self :: @Self, out :: String) Res<(), AllocError> {
        self.stopping.match({
            true  => written(),
            false => self.notes.settled(self.env, self.workspace, self.open,
                                        self.docs, out),
        })
    }

    hovered = (self :: @Self, tree: Jsons, req: JsonId, rid: JsonId,
               msg :: String) Res<(), AllocError> {
        uri = string_at(tree, param(tree, req, "textDocument"), "uri");
        where = param(tree, req, "position");
        line = number_at(tree, where, "line");
        character = number_at(tree, where, "character");
        self.docs.get(uri).match({
            // A client bug; `-32602` names it rather than answering
            // `null`, which would misleadingly read as "no type here".
            None     => failed(tree, rid, INVALID_PARAMS,
                               "no open document for that uri", msg),
            Ok(text) => self.answer_hover(tree, rid, uri, text, line, character, msg),
        })
    }

    answer_hover = (self :: @Self, tree: Jsons, rid: JsonId, uri: str,
                    text: str, line: usize, character: usize, msg :: String)
                   Res<(), AllocError> {
        h = self.hover(uri, text, line, character).try();
        body ::= self.a.String().try();
        h.found.match({
            false => body.add_bytes("null").try(),
            true  => write_hover(h, body).try(),
        });
        result(tree, rid, body.view(), msg)
    }

    // COLOUR READS WHAT THE DIAGNOSTICS' BUILD SETTLED. `classes_for`
    // is empty without a workspace, before the first build, and from
    // any change until the next clean one — and an empty list IS the
    // lexical answer, so the fallback costs no branch. A DOCUMENT NEVER
    // OPENED IS `-32602`, the same refusal hover makes.
    coloured = (self :: @Self, tree: Jsons, req: JsonId, rid: JsonId,
                msg :: String) Res<(), AllocError> {
        uri = string_at(tree, param(tree, req, "textDocument"), "uri");
        self.docs.get(uri).match({
            None     => failed(tree, rid, INVALID_PARAMS,
                               "no open document for that uri", msg),
            Ok(text) => self.answer_colour(tree, rid, uri, text, msg),
        })
    }

    answer_colour = (self :: @Self, tree: Jsons, rid: JsonId, uri: str,
                     text: str, msg :: String) Res<(), AllocError> {
        body ::= self.a.String().try();
        names = self.notes.classes_for(uri).try();
        write_tokens(self.a, uri, text, names, body).try();
        result(tree, rid, body.view(), msg)
    }

    // WHICH OF THE TWO HOVERS: the workspace is the whole decision. With
    // one, the document is checked as part of a BUILD and an imported
    // name has a type. Without one — no `rootUri`, or the two-file form
    // of `zen lsp` — the single-module answer types what the file
    // declares and answers `null`, never a guess, for what it imports.
    hover = (self :: @Self, uri: str, text: str, line: usize,
             character: usize) Res<Hover, AllocError> {
        self.workspace.is_empty().match({
            true  => hover_at(self.a, uri, text, line, character),
            false => hover_in(self.env, self.a, self.workspace, path_of(uri),
                              text, line, character),
        })
    }
}

Server* = (a: Alloc, env: Env) Server {
    Server(a: a, env: env, docs: a.Map<str, str>(), open: a.Vec<str>(),
           notes: a.Diagnostics(), ready: false, stopping: false)
}

// Every frame in `input`, answered into `out`.
//
// A malformed frame STOPS the session: framing is the one layer where
// recovery is impossible — the header of this message is the only thing
// that says where the next starts, so skipping forward would
// resynchronise onto a byte inside somebody's document.
serve* = (s :: Server, input: str, out :: String) Res<(), AllocError> {
    at ::= 0;
    going ::= true;
    loop(() { going && at < input.len }, (h) {
        frame_at(input, at).match({
            Err(f) => { going = false; frame_fault(f, out).try(); },
            Ok(fr) => { at = fr.next; s.one(fr.body, out).try(); },
        });
    });
    // THE END OF A BUFFER IS A SETTLE POINT — what makes a batch of
    // changes cost one build.
    s.settled(out)
}

// A framing fault is reported to the caller's stream, not to a client
// (which cannot be replied to if it cannot be framed). The two readers
// of the fault are STARRED because `lsp_stdio.zen` says the same
// sentence to a console — a second pair of matches would be a second,
// possibly disagreeing, answer to "which byte".
frame_fault = (f: FrameFault, out :: String) Res<(), AllocError> {
    out.add_bytes("lsp: bad frame at byte ").try();
    write_decimal(frame_byte(f), out).try();
    out.add_bytes(" (").try();
    out.add_bytes(frame_why(f)).try();
    out.add_bytes(")\n")
}

frame_byte* = (f: FrameFault) usize {
    f.match({
        NoBlank(i)   => i,
        NoLength(i)  => i,
        BadLength(i) => i,
        Short(i)     => i,
    })
}

frame_why* = (f: FrameFault) str {
    f.match({
        NoBlank(_)   => "the headers never ended",
        NoLength(_)  => "no Content-Length",
        BadLength(_) => "Content-Length is not a number",
        Short(_)     => "fewer bytes than Content-Length promised",
    })
}

// --- reading a request -----------------------------------------------
//
// Every one of these answers "" or 0 for a field it cannot find, and
// none fails — refusal happens later, by name, where it can carry an id.

method_of = (tree: Jsons, req: JsonId) str {
    string_at(tree, req, "method")
}

// `params`, or the request itself when there are none — a malformed
// message reads as one with every field absent.
params_of = (tree: Jsons, req: JsonId) JsonId {
    tree.field(req, "params").match({ None => req, Ok(ps) => ps })
}

// `params.<name>`, and the object itself when absent — same reading one
// level down.
param = (tree: Jsons, req: JsonId, name: str) JsonId {
    ps = params_of(tree, req);
    tree.field(ps, name).match({ None => ps, Ok(v) => v })
}

string_at = (tree: Jsons, obj: JsonId, name: str) str {
    tree.field(obj, name).match({
        None  => "",
        Ok(v) => tree.text(v).match({ Ok(s) => s, None => "" }),
    })
}

number_at = (tree: Jsons, obj: JsonId, name: str) usize {
    tree.field(obj, name).match({
        None  => 0,
        Ok(v) => tree.whole(v).match({ Ok(n) => n, None => 0 }),
    })
}

// --- the reply shapes ------------------------------------------------
//
// Built as TEXT and not through the arena: a reply is a fixed shape with
// two holes, and an arena would mean building six nodes to print eight
// bytes. Every quotable string goes through `write_text`,
// `lsp_json.zen`'s escaper — one escaping rule in this folder.

result = (tree: Jsons, rid: JsonId, body: str, msg :: String)
         Res<(), AllocError> {
    head(tree, rid, msg).try();
    msg.add_bytes(",\"result\":").try();
    msg.add_bytes(body).try();
    msg.add_bytes("}")
}

failed = (tree: Jsons, rid: JsonId, code: usize, why: str, msg :: String)
         Res<(), AllocError> {
    head(tree, rid, msg).try();
    msg.add_bytes(",\"error\":{\"code\":-").try();
    write_decimal(code, msg).try();
    msg.add_bytes(",\"message\":").try();
    write_text(why, msg).try();
    msg.add_bytes("}}")
}

// THE ID IS ECHOED VERBATIM, out of the arena it was read from — a
// JSON-RPC id may be a number or a string, and re-emitting the node
// matches either without a second representation of "an id".
head = (tree: Jsons, rid: JsonId, msg :: String) Res<(), AllocError> {
    msg.add_bytes("{\"jsonrpc\":\"2.0\",\"id\":").try();
    tree.write(rid, msg)
}

// A frame this server could not parse gets an error with a NULL id —
// the id lives inside the document that failed to parse.
parse_error = (f: JsonFault, msg :: String) Res<(), AllocError> {
    msg.add_bytes("{\"jsonrpc\":\"2.0\",\"id\":null,\"error\":{\"code\":-").try();
    write_decimal(PARSE_ERROR, msg).try();
    msg.add_bytes(",\"message\":").try();
    write_fault(f, msg).try();
    msg.add_bytes("}}")
}

// The fault, with its byte offset — `TESTING.md:17`: "a rejection with
// the wrong span is a failure".
write_fault = (f: JsonFault, msg :: String) Res<(), AllocError> {
    msg.add_byte('"').try();
    msg.add_bytes(fault_why(f)).try();
    fault_byte(f).match({
        None  => written(),
        Ok(i) => { msg.add_bytes(" at byte ").try(); write_decimal(i, msg) },
    }).try();
    msg.add_byte('"')
}

fault_why = (f: JsonFault) str {
    f.match({
        Unexpected(_) => "unexpected byte",
        Truncated(_)  => "the document ended inside a value",
        BadEscape(_)  => "bad escape",
        BadNumber(_)  => "not a JSON number",
        TooDeep(_)    => "nested too deeply",
        Trailing(_)   => "trailing bytes after the value",
        NoMemory      => "out of memory",
    })
}

fault_byte = (f: JsonFault) Res<usize> {
    f.match({
        Unexpected(i) => Ok(i),
        Truncated(i)  => Ok(i),
        BadEscape(i)  => Ok(i),
        BadNumber(i)  => Ok(i),
        TooDeep(i)    => Ok(i),
        Trailing(i)   => Ok(i),
        NoMemory      => None,
    })
}

// A `Hover` as the protocol spells one. `plaintext` and not `markdown`:
// rendering as markup would let a `*` inside a name become emphasis —
// not hypothetical, since an exported name IS starred.
write_hover = (h: Hover, out :: String) Res<(), AllocError> {
    out.add_bytes("{\"contents\":{\"kind\":\"plaintext\",\"value\":").try();
    write_text(h.shown, out).try();
    out.add_bytes("},\"range\":{\"start\":").try();
    write_wire(h.start, out).try();
    out.add_bytes(",\"end\":").try();
    write_wire(h.end, out).try();
    out.add_bytes("}}")
}

// WHAT THIS SERVER SAYS IT CAN DO, and only what it does.
//
// WRITTEN, not a constant: the semantic-token legend belongs to
// `lsp_colour.zen`, and the index a `tokenType` uses cannot be spelled
// in two files without one day silently disagreeing.
//
// Sync kind 1 is Full — see this file's header for why not 2.
//
// `full: true` AND NOTHING ELSE. A client believes what it is told:
// advertising `range` would make VS Code send
// `textDocument/semanticTokens/range`, which this server refuses with
// `-32601`, leaving the file with NO COLOUR AT ALL and no reason shown.
// A capability is a promise; the only safe one is the one already kept.
write_capabilities* = (out :: String) Res<(), AllocError> {
    out.add_bytes("{\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true,\"semanticTokensProvider\":{\"legend\":").try();
    write_legend(out).try();
    out.add_bytes(",\"full\":true}},\"serverInfo\":{\"name\":\"zen\",\"version\":\"0\"}}")
}

// The one method `semanticTokensProvider` above promises, spelled once
// beside the promise.
SEMANTIC_TOKENS*: str = "textDocument/semanticTokens/full"

// JSON-RPC's codes, as MAGNITUDES: negative on the wire, and the sign is
// written by the one function that emits them.
PARSE_ERROR*: usize = 32700
METHOD_NOT_FOUND*: usize = 32601
INVALID_PARAMS*: usize = 32602
NOT_INITIALIZED*: usize = 32002
