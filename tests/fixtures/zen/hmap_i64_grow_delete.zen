// HMap<i64, i32>: of-seed, grow far past the initial cap, upsert in place, delete-then-get
// (.None), len shrink, slot reuse after delete. Keys are TYPED i64 vars/exprs — an untyped
// literal at a generic call site pins K to i32 (see the hmap header GOTCHA).
hm = std.collections.hmap
{ println } = std.text.fmt
halloc = std.mem.heap
main = () i32 {
    alloc := halloc.gpa()
    a := alloc.addr()
    k1: i64 := 42
    m := hm.of(a, k1, 10).expect("of")
    i: i64 := 0
    @while (i < 50) {
        m = m.put(a, i * 1000 + 1, to_i32(i)).expect("put")
        i = i + 1
    }
    println(m.len())    // 51 = 1 seed + 50 distinct keys, grown 1->3->7->15->31->63
    q: i64 := 7001
    println(m.get_or(q, 0 - 1))    // 7
    m = m.put(a, k1, 11).expect("upsert")
    println(m.len())    // still 51 — upsert overwrote in place
    m.get(k1).match ({
        .Some(v) => println(v),    // 11
        .None    => println("none"),
    })
    m = m.delete(k1)
    m.get(k1).match ({
        .Some(v) => println(v),
        .None    => println("none"),
    })    // none
    println(m.len())    // 50
    // every remaining key still reachable after the swap-remove
    good: i64 := 0
    i = 0
    @while (i < 50) {
        (m.get_or(i * 1000 + 1, 0 - 1) == to_i32(i)).match ({ true => {
            good = good + 1
        }, false => { } })
        i = i + 1
    }
    println(good)    // 50
    // deleting an ABSENT key is a no-op
    gone: i64 := 999999
    m = m.delete(gone)
    println(m.len())    // 50
    // the freed slot is reused: len goes back up by exactly one
    m = m.put(a, k1, 12).expect("re-put")
    println(m.get_or(k1, 0 - 1))    // 12
    println(m.len())    // 51
    m.free(a)
    0
}
