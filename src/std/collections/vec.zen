// std.collections.vec — generic growable Vec<T> with explicit allocator-threaded storage.
// Fallible ops (`of`, `push`, `grow`) return Result<Vec<T>, IoError> — allocation failure is a
// value: `.expect("…")` at fail-fast roots, `.or_return()` inside Result-returning fns.
// @self-hosted-only: generic struct literals are covered by self-hosted tests.
{ Allocator, try_acquire, try_resize, DynAlloc, dyn_from, dyn_heap } = std.mem.alloc
{ Result, IoError, Opt, ok, err, panic, expect } = std.core.result
{ loop_at } = std.core.count
// The carried allocator + sticky failure flag are the SAME three fields, in the same order, as
// std.text.string's String, because `String` IS `Vec<u8>` and that identity is load-bearing. See
// that struct for what each one means; the semantics here are identical over an element type.
// One difference: EVERY Vec constructor carries. `of`/`empty`/`map`/`filter` take a threaded
// `Allocator` and erase it with `dyn_from`, so the value they hand back is live — they used to omit
// the three fields and let C zero-fill `carried` to false, which closed `live()` and made every
// later `add`/`add_one` a silent no-op (they return `Vec<T>`, not `Result`, so nothing said so).
Vec*<T>: {
    ptr: RawPtr<u8>,
    len: i64,
    cap: i64,
    carried: bool,
    oom: bool,
    alloc: DynAlloc,
    add = (v: Vec<T>, xs: [T]) Vec<T> {
        // append MANY elements; a no-op once sticky or uncarried.
        d = v.alloc
        v.live().then({ v.settle(d.addr().extend_in(v, xs)) }, { v })
    }
    add_one = (v: Vec<T>, x: T) Vec<T> {
        // append ONE element; a no-op once sticky or uncarried.
        d = v.alloc
        v.live().then({ v.settle(v.push(d.addr(), x)) }, { v })
    }
    freeze = (v: Vec<T>) Result<VecConst<T>, IoError> {
        // THE one settle point: shrink to fit, give up `cap`, hand back the owned frozen elements —
        // or the sticky failure, with the partial buffer freed.
        d = v.alloc
        v.live().match ({
            true  => d.addr().try_resize(v.ptr, (v.len < 1).then({ 1 }, { v.len * sizeof(T) })).match ({
                .Ok(p)  => ok(VecConst<T>(
                    ptr: p,
                    len: v.len,
                    alloc: v.alloc,
                )),
                .Err(e) => {
                    v.drop()
                    err(e)
                },
            }),
            false => {
                v.drop()
                err(.NotFound)
            },
        })
    }
    drop = (v: Vec<T>) void {
        d = v.alloc
        v.carried.then({
            d.addr().release(v.ptr)
        })
    }
    live = (v: Vec<T>) bool { v.carried && v.oom == false }
    settle = (v: Vec<T>, r: Result<Vec<T>, IoError>) Vec<T> {
        r.match ({
            .Ok(g)  => v.relink(g),
            .Err(e) => v.poison(),
        })
    }
    relink = (v: Vec<T>, g: Vec<T>) Vec<T> {
        Vec<T>(
            ptr: g.ptr,
            len: g.len,
            cap: g.cap,
            carried: true,
            oom: false,
            alloc: v.alloc,
        )
    }
    poison = (v: Vec<T>) Vec<T> {
        Vec<T>(
            ptr: v.ptr,
            len: v.len,
            cap: v.cap,
            carried: v.carried,
            oom: true,
            alloc: v.alloc,
        )
    }
    buf = (v: Vec<T>) [T] { slice(v.ptr, v.cap) }
    view = (v: Vec<T>) [T] {
        // a slice over exactly the `len` live elements (NOT `cap` — excludes uninitialized storage).
        // Use this to iterate, just like any `[T]`: `v.view().loop((h, i, x) { ... })`.
        slice(v.ptr, v.len)
    }
    len = (v: Vec<T>) i64 { v.len }
    get = (v: Vec<T>, i: i64) T {
        // Bounds-checked read against `len` (the LIVE element count), NOT `cap`: an index in [len, cap)
        // would otherwise return uninitialized junk from the spare capacity. Out-of-range PANICS (same
        // give-up contract as the compiler's OOB guard) rather than returning garbage. Signature stays
        // `T` — every existing caller with a valid index is unchanged. Need a recoverable read? `get_opt`.
        (i < 0 || i >= v.len).match ({
            true  => {
                panic("vec.get: index out of bounds")
                // unreachable — panic aborts; the recursion only satisfies the arm's type.
                v.get(i)
            },
            false => v.buf()[i],
        })
    }
    get_opt = (v: Vec<T>, i: i64) Opt<T> {
        // Recoverable bounds-checked read: `.Some(x)` for i in [0, len), `.None` past the live end.
        (i < 0 || i >= v.len).match ({
            true  => {
                none: Opt<T> = .None
                none
            },
            false => {
                some: Opt<T> = .Some(v.buf()[i])
                some
            },
        })
    }
    grow = (v: Vec<T>, a: Allocator) Result<Vec<T>, IoError> {
        ncap = v.cap * 2 + 1
        a.try_resize(v.ptr, ncap * sizeof(T)).match ({
            .Ok(p)  => {
                vok: Result<Vec<T>, IoError> = .Ok(Vec<T>(
                    ptr: p,
                    len: v.len,
                    cap: ncap,
                    carried: v.carried,
                    oom: v.oom,
                    alloc: v.alloc,
                ))
                vok
            },
            .Err(e) => {
                verr: Result<Vec<T>, IoError> = .Err(e)
                verr
            },
        })
    }
    push = (v: Vec<T>, a: Allocator, x: T) Result<Vec<T>, IoError> {
        x = x
        out: Result<Vec<T>, IoError> = (v.len < v.cap).match ({
            true  => {
                b ::= v.buf()
                b[v.len] = x
                vok: Result<Vec<T>, IoError> = .Ok(Vec<T>(
                    ptr: v.ptr,
                    len: v.len + 1,
                    cap: v.cap,
                    carried: v.carried,
                    oom: v.oom,
                    alloc: v.alloc,
                ))
                vok
            },
            false => {
                v.grow(a).match ({
                    .Ok(r)  => {
                        b ::= r.buf()
                        b[r.len] = x
                        vok: Result<Vec<T>, IoError> = .Ok(Vec<T>(
                            ptr: r.ptr,
                            len: r.len + 1,
                            cap: r.cap,
                            carried: r.carried,
                            oom: r.oom,
                            alloc: r.alloc,
                        ))
                        vok
                    },
                    .Err(e) => {
                        verr: Result<Vec<T>, IoError> = .Err(e)
                        verr
                    },
                })
            },
        })
        out
    }
    free = (v: Vec<T>, a: Allocator) void { a.release(v.ptr) }
    each = (v: Vec<T>, f: (T) void) void {
        // Higher-order helpers over the live elements (`view()`), backed by closures — inline lambdas and
        // stored closures both work. Spelled inline (over `view().loop`) rather than delegating to
        // std.collections.iter, so this module imports no free `fold`/`each`/`find` names — those
        // would re-export and clash with same-named helpers (e.g. `map.find`) in programs that co-import vec
        // and map. `each`/`fold`/`find` allocate nothing; `map`/`filter` thread the allocator and return a
        // fresh Vec wrapped in `Result` (no hidden heap; OOM is a value). The `vw: [T] =` intermediate
        // pins the element type for the loop.
        vw: [T] = v.view()
        vw.loop_at((i, x) { f(x) })
    }
    fold = (v: Vec<T>, init: T, f: (T, T) T) T {
        acc ::= init
        vw: [T] = v.view()
        vw.loop_at((i, x) { acc = f(acc, x) })
        acc
    }
    find = (v: Vec<T>, pred: (T) bool) Opt<T> {
        out :: Opt<T> = .None
        vw: [T] = v.view()
        vw.loop((h, i, x) {
            pred(x).then({
                out = .Some(x)
                h.break
            })
        })
        out
    }
    map<U> = (v: Vec<T>, a: Allocator, f: (T) U) Result<Vec<U>, IoError> {
        // Fallible: the fresh buffer is `try_acquire`d, so OOM is a value (`.Err(.Errno)`) instead of a
        // null `p` the loop would write through. Explicit `.match` threads the Err (matching `grow`/`push`).
        a.try_acquire(v.len * sizeof(U)).match ({
            .Ok(p)  => {
                out :: [U] = slice(p, v.len)
                vw: [T] = v.view()
                vw.loop_at((i, x) { out[i] = f(x) })
                ok: Result<Vec<U>, IoError> = .Ok(Vec<U>(
                    ptr: p,
                    len: v.len,
                    cap: v.len,
                    carried: true,
                    oom: false,
                    alloc: dyn_from(a),
                ))
                ok
            },
            .Err(e) => {
                err: Result<Vec<U>, IoError> = .Err(e)
                err
            },
        })
    }
    filter = (v: Vec<T>, a: Allocator, keep: (T) bool) Result<Vec<T>, IoError> {
        // Fallible for the same reason as `map`: OOM on the result buffer surfaces as `.Err`, never null.
        a.try_acquire(v.len * sizeof(T)).match ({
            .Ok(p)  => {
                out :: [T] = slice(p, v.len)
                vw: [T] = v.view()
                n ::= 0
                vw.loop_at((i, x) {
                    out[n] = x
                    n = n + keep(x).then({ 1 }, { 0 })
                })
                ok: Result<Vec<T>, IoError> = .Ok(Vec<T>(
                    ptr: p,
                    len: n,
                    cap: v.len,
                    carried: true,
                    oom: false,
                    alloc: dyn_from(a),
                ))
                ok
            },
            .Err(e) => {
                err: Result<Vec<T>, IoError> = .Err(e)
                err
            },
        })
    }
}
// a zero-element `Vec<T>` with capacity for at least one element (so `push` has somewhere to write
// before the first grow). T can't be read off any argument, so it comes from the LHS annotation:
// `r: Result<Vec<i32>, IoError> = vecs.empty(a)`. Fallible like `of`: the seed
// buffer is `try_acquire`d, so OOM is a value, not a null buffer. Pair with `push`/`free`.
empty*<T> = (a: Allocator) Result<Vec<T>, IoError> {
    a.try_acquire(sizeof(T)).match ({
        .Ok(p)  => {
            ok: Result<Vec<T>, IoError> = .Ok(Vec<T>(
                ptr: p,
                len: 0,
                cap: 1,
                carried: true,
                oom: false,
                alloc: dyn_from(a),
            ))
            ok
        },
        .Err(e) => {
            err: Result<Vec<T>, IoError> = .Err(e)
            err
        },
    })
}
// a `Vec<T>` seeded from a slice (copies `xs`), its buffer acquired from `a`. T inferred from `xs`, A from `a`.
of*<T> = (a: Allocator, xs: [T]) Result<Vec<T>, IoError> {
    (xs.len <= 0).match ({
        true  => {
            vok: Result<Vec<T>, IoError> = .Ok(Vec<T>(
                ptr: null_ptr(),
                len: 0,
                cap: 0,
                carried: true,
                oom: false,
                alloc: dyn_from(a),
            ))
            vok
        },
        false => {
            a.try_acquire(xs.len * sizeof(T)).match ({
                .Ok(p)  => {
                    v = Vec<T>(
                        ptr: p,
                        len: xs.len,
                        cap: xs.len,
                        carried: true,
                        oom: false,
                        alloc: dyn_from(a),
                    )
                    b ::= v.buf()
                    xs.loop_at((i, x) { b[i] = x })
                    vok: Result<Vec<T>, IoError> = .Ok(v)
                    vok
                },
                .Err(e) => {
                    verr: Result<Vec<T>, IoError> = .Err(e)
                    verr
                },
            })
        },
    })
}
// Grow `v` so `need` MORE elements fit, in one resize. Distinct from `grow`, which doubles blindly:
// a bulk append knows exactly how much room it wants. Carried fields ride through untouched.
reserve_cap*<T> = (a: Allocator, v: Vec<T>, need: i64) Result<Vec<T>, IoError> {
    v = v
    (v.len + need <= v.cap).match ({
        true  => {
            vok: Result<Vec<T>, IoError> = .Ok(v)
            vok
        },
        false => {
            ncap = (v.cap + need) * 2
            a.try_resize(v.ptr, ncap * sizeof(T)).match ({
                .Ok(p)  => {
                    vok: Result<Vec<T>, IoError> = .Ok(Vec<T>(
                        ptr: p,
                        len: v.len,
                        cap: ncap,
                        carried: v.carried,
                        oom: v.oom,
                        alloc: v.alloc,
                    ))
                    vok
                },
                .Err(e) => {
                    verr: Result<Vec<T>, IoError> = .Err(e)
                    verr
                },
            })
        },
    })
}
// Append every element of `xs` under ONE reservation, then fill BY ITERATION (`.loop` over the
// destination). A recursive per-element fill is a stack overflow waiting to happen: the bootstrap and
// harness compile paths carry no -O flag, so C tail calls are not eliminated — the same rule that
// shapes std.text.sb's `rep`.
extend_in*<T> = (a: Allocator, v: Vec<T>, xs: [T]) Result<Vec<T>, IoError> {
    xs = xs
    a.reserve_cap(v, xs.len).match ({
        .Ok(r)  => {
            dst :: [T] = r.buf()
            xs.loop_at((i, x) { dst[r.len + i] = x })
            vok: Result<Vec<T>, IoError> = .Ok(Vec<T>(
                ptr: r.ptr,
                len: r.len + xs.len,
                cap: r.cap,
                carried: r.carried,
                oom: r.oom,
                alloc: r.alloc,
            ))
            vok
        },
        .Err(e) => {
            verr: Result<Vec<T>, IoError> = .Err(e)
            verr
        },
    })
}
// ── the two `{ptr, len}` owned rows (docs/string-vec-model.md) ───────────────────────────────────
// `VecFixed<T>` and `VecConst<T>` are `StringFixed`/`StringConst` over an element type, and the same
// sentence explains both: no `cap`, so growth is impossible by construction; a fixed view is a
// writable `[T]` and a frozen view is a read-only `Slice<T>`; each carries the allocator it was born
// under so `drop()` takes no argument.
VecFixed*<T>: {
    ptr: RawPtr<u8>,
    len: i64,
    alloc: DynAlloc,
    view = (v: VecFixed<T>) [T] { slice(v.ptr, v.len) }
    get  = (v: VecFixed<T>, i: i64) T { v.view()[i] }
    set = (v: VecFixed<T>, i: i64, x: T) void {
        w :: [T] = v.view()
        w[i] = x
    }
    drop = (v: VecFixed<T>) void {
        d = v.alloc
        d.addr().release(v.ptr)
    }
}
VecConst*<T>: {
    ptr: RawPtr<u8>,
    len: i64,
    alloc: DynAlloc,
    view = (v: VecConst<T>) Slice<T> { slice(v.ptr, v.len) }
    get  = (v: VecConst<T>, i: i64) T { v.view()[i] }
    drop = (v: VecConst<T>) void {
        d = v.alloc
        d.addr().release(v.ptr)
    }
}
// ── carrying constructors ────────────────────────────────────────────────────────────────────────
// The allocator is named ONCE and rides inside the value. `vec` is INFALLIBLE — a failed birth
// allocation becomes the sticky flag and settles at `freeze()`; `vec_fixed` has no chain to settle
// into, so it reports its single allocation directly. T comes from the explicit type argument
// (`gpa.vec<i64>(16)`): there is no element to infer it from.
vec*<T> = (a: DynAlloc, cap: i64) Vec<T> {
    d = a
    d.addr().try_acquire(cap * sizeof(T)).match ({
        .Ok(p)  => Vec<T>(
            ptr: p,
            len: 0,
            cap: cap,
            carried: true,
            oom: false,
            alloc: a,
        ),
        .Err(e) => Vec<T>(
            ptr: null_ptr(),
            len: 0,
            cap: 0,
            carried: true,
            oom: true,
            alloc: a,
        ),
    })
}
vec_fixed*<T> = (a: DynAlloc, n: i64) Result<VecFixed<T>, IoError> {
    d = a
    d.addr().try_acquire(n * sizeof(T)).match ({
        .Ok(p)  => {
            vok: Result<VecFixed<T>, IoError> = .Ok(VecFixed<T>(
                ptr: p,
                len: n,
                alloc: a,
            ))
            vok
        },
        .Err(e) => {
            verr: Result<VecFixed<T>, IoError> = .Err(e)
            verr
        },
    })
}
// The only way back from frozen to growable — there is deliberately no `thaw()`, because going back
// COPIES and the allocator is named so the allocation is visible at the point it happens.
vec_from*<T> = (a: DynAlloc, c: VecConst<T>) Vec<T> {
    src: [T] = slice(c.ptr, c.len)
    v: Vec<T> = vec(a, c.len)
    v.add(src)
}
// ── STORED-ALLOCATOR FORM (process-heap default) ─────────────────────────────────────────────────
// An ADDITIVE surface that removes allocator threading: `v = vec.new()` then `v.push(x)` — no `a`
// argument anywhere. Everything above (the explicit `Vec<T>` + `of(a, …)` / `v.push(a, x)` forms) is
// UNCHANGED and remains the precise-control API; this section only adds new names on new types.
//
//   v: AVec<i32> = vec.new()          // T comes from the annotation (nothing to infer it from)
//   v  = v.push(1)                     // no allocator argument — new() stored dyn_heap()
//   v  = v.push(2)
//   n = v.len()                      // 2
//   x = v.get(0)                     // 1
//   v.each((y){ ... })                 // iterate the live elements
//   v.free()                           // hand storage back to the stored allocator
//
//   w = vec.from([10, 20, 30])        // seed from a slice; T inferred from the elements
//
// STORE-NOT-REREAD (why AVec carries its allocator). `new()` stores `dyn_heap()`; `new_in(a)` stores
// the caller's `DynAlloc`. Every later grow/free uses that same value, avoiding cross-allocator frees.
// A custom `DynAlloc.state` is a raw pointer, so the allocator state itself MUST outlive the AVec;
// storing its vtable does not make a stack/arena-backed allocator immortal.
//
// These allocator-free-call-site ops are fail-fast on allocation failure (`.expect`, which panics). The
// ergonomic path. Callers who need allocation failure as a value keep using the explicit `Vec<T>` API,
// whose ops return `Result<Vec<T>, IoError>`.
// AVec<T> = an explicit `Vec<T>` plus the NARROW allocator it was born under (`alloc: DynAlloc` — the
// value form of the `Allocator` trait, std.mem.alloc). All ops delegate to the `Vec<T>` methods,
// passing the stored allocator where an `a: Allocator` is expected, so there is ZERO duplicated
// container logic AND the container stores an Allocator, never the whole `Rt` bundle.
AVec*<T>: {
    inner: Vec<T>,
    alloc: DynAlloc,
    len     = (w: AVec<T>) i64 { w.inner.len() }
    get     = (w: AVec<T>, i: i64) T { w.inner.get(i) }
    get_opt = (w: AVec<T>, i: i64) Opt<T> { w.inner.get_opt(i) }
    view    = (w: AVec<T>) [T] { w.inner.view() }
    each    = (w: AVec<T>, f: (T) void) void { w.inner.each(f) }
    fold    = (w: AVec<T>, init: T, f: (T, T) T) T { w.inner.fold(init, f) }
    find    = (w: AVec<T>, pred: (T) bool) Opt<T> { w.inner.find(pred) }
    push = (w: AVec<T>, x: T) AVec<T> {
        // In a chain (`v.push(1).push(2)`) the receiver `w` is the previous op's side-effecting
        // result. The inliner binds such a multiply-used arg to one temp (evaluate-once), so
        // referencing `w` several times below is safe — no local rebind needed here.
        a = w.alloc
        AVec<T>(
            inner: w.inner.push(a.addr(), x).expect("vec.push: out of memory"),
            alloc: w.alloc,
        )
    }
    free = (w: AVec<T>) void {
        a = w.alloc
        w.inner.free(a.addr())
    }
}
// EXPLICIT-allocator constructor — THE REAL CONSTRUCTION PATH. Build a zero-element `AVec<T>` bound to
// a caller-supplied narrow allocator (`a: DynAlloc`), with no implicit process-heap selection.
// (docs/MEMORY_MODEL.md), an explicit capability handed in is the model: a caller who holds an
// allocator (`std.mem.alloc.dyn_heap()`, an actor's own heap narrowed via `rt.dyn_of_rt`, an arena)
// calls this and the thread-local is never touched. The default `new()` below is a one-line shim over
// it — the single process-heap draw (`dyn_heap()`) on the vec construction path.
// `empty`'s T lives only in its return type; pin it via the annotation (nested-return inference can't
// reach it through the struct-literal field). `empty` is fallible, so unwrap fail-fast here (the
// default form is fail-fast on OOM by design).
new_in*<T> = (a: DynAlloc) AVec<T> {
    da = a
    ivr: Result<Vec<T>, IoError> = empty(da.addr())
    AVec<T>(
        inner: ivr.expect("vec.new: out of memory"),
        alloc: a,
    )
}
// a zero-element process-heap `AVec<T>` (capacity for one, like `empty`). T can't be inferred from an
// argument, so it comes from the LHS annotation: `v: AVec<i32> = vec.new()`. The process heap is drawn
// ONCE here (as a DynAlloc) and stored for the life of the vec (all later ops use the stored allocator).
// The `new_in` body is inlined (rather than `new_in(dyn_heap())`) so the shim makes no bare `new_in`
// call — that bare name is ambiguous with std.text.string's generic `new_in(a: Allocator)` once both
// modules flatten together; the qualified `vec.new_in` stays the external real path.
new*<T> = () AVec<T> {
    a = dyn_heap()
    ivr: Result<Vec<T>, IoError> = empty(a.addr())
    AVec<T>(
        inner: ivr.expect("vec.new: out of memory"),
        alloc: a,
    )
}
// EXPLICIT-allocator seed constructor: an `AVec<T>` bound to `a`, seeded from a slice (copies `xs`). No
// implicit allocator selection. T is inferred from the elements.
from_in*<T> = (a: DynAlloc, xs: [T]) AVec<T> {
    da = a
    iv: Vec<T> = of(da.addr(), xs).expect("vec.from: out of memory")
    AVec<T>(
        inner: iv,
        alloc: a,
    )
}
// a process-heap `AVec<T>` seeded from a slice. Capture `dyn_heap()` once; `from_in`'s body is inlined
// (no bare `from_in` call — same string-`new_in` collision avoidance as `new`). Fail-fast.
from*<T> = (xs: [T]) AVec<T> {
    a = dyn_heap()
    iv: Vec<T> = of(a.addr(), xs).expect("vec.from: out of memory")
    AVec<T>(
        inner: iv,
        alloc: a,
    )
}
