// compiler.genjs — a JavaScript backend, sibling to genc_emit. Pipeline: genc -> mono -> genjs.
//
// It walks the SAME post-monomorphization `[Decl]` AST the C backend consumes and emits JavaScript
// (Node/browser) instead of C. Where genc_emit maps Zen onto C's type system + memory, genjs maps
// it onto JS's dynamic values plus a small linear-memory floor (bootstrap/zenrt.js, the JS analog of
// zenrt.c). The two backends share genc.zen's AST + String builder; only the emission differs.
//
// ── VALUE MODEL (the lowering map, in one place) ──────────────────────────────────────────────────
//   • str / RawPtr / all pointers → an INTEGER offset into a shared Uint8Array (`__zr.MEM`). A string
//     literal is interned as NUL-terminated UTF-8 (`__zr.str("hi")` -> offset), so `strlen`, `load`,
//     `offset`, `store`, `cstr`, `slice`, `write` all operate uniformly over MEM — exactly as C does
//     over its flat address space. (A struct POINTER `MutPtr<T>` is just the JS object; JS objects are
//     references, so `addr`/`load`/`->` are the identity — see js_call/js_arrow. Aliasing a *scalar*
//     through MutPtr<i32> is the one thing this can't express; that needs boxed refs — DEFERRED.)
//   • int / i64  → JS `number` (f64). Exact to 2^53; full i64 + 64-bit bitwise need BigInt — DEFERRED.
//   • f64        → JS number (float literals pass through verbatim).
//   • struct     → a plain object `{field: value, …}`.
//   • enum       → a tagged object `{tag: "Variant", Variant: payload}`; match switches on `.tag`.
//   • slice [T]  → a fat pointer `{ptr, len}` (ptr = MEM offset for byte/str views, or a JS array for a
//     user slice literal). match/loop/index read `.ptr`/`.len`.
//   • fn         → a JS function; UFCS is already desugared to flat calls by the checker.
//   • panic      → `__zr.panic(msg)` throws.
// The floor (`__zr`) provides the intrinsics + libc leaves (write/strlen/malloc/memcpy/…). Traits,
// impls, templates, generic decls, imports and DRaw (verbatim C) emit NOTHING — same as genc skips them.
{ String } = std.text.string
{ view, is_empty, eq } = std.text.str
{ Expr, Stmt, Decl, Func, Param, Ty, FieldInit, ArmData, BinData, CallData, CondData, MatchData, MemberData, MakeStructData, MakeEnumData, TagData, SliceData, IndexData, LoopData, LambdaData, BlockData, IfData, WhileData, LetData, AssignData, IndexSetData, GlobalData, StructDecl, is_template, is_trait, param, tvoid, gstr_string, gstr_append, gstr_push, gstr_finish } = compiler.genc
{ monomorphize } = compiler.mono
{ Malloc } = std.mem.alloc
// ── small integer renderer (byte-only, self-hosting) ──────────────────────────────────────────────
jdigit = (d: i64) u8 { load(offset("0123456789", d)) }
jint_nat = (s: String, a: MutPtr<Malloc>, n: i64) String {
    (n < 10).match ({
        true  => s.gstr_push(a, jdigit(n)),
        false => {
            hs := s.jint_nat(a, n / 10)
            hs.gstr_push(a, jdigit(n % 10))
        },
    })
}
jint = (s: String, a: MutPtr<Malloc>, n: i64) String { (n < 0).match ({
    true  => s.gstr_append(a, "-").jint_neg(a, n),
    false => s.jint_nat(a, n),
}) }
// walk negatives directly so INT64_MIN doesn't overflow on `0 - n`
jint_neg = (s: String, a: MutPtr<Malloc>, n: i64) String {
    (n > 0 - 10).match ({
        true  => s.gstr_push(a, jdigit(0 - n)),
        false => {
            hs := s.jint_neg(a, n / 10)
            hs.gstr_push(a, jdigit(0 - n % 10))
        },
    })
}
// ── JS identifier safety: a Zen name that is a JS reserved word gets a `$` suffix (so a Zen fn named
//    `default`/`new`/`class`/… is a legal JS name). Field/property names are NOT mangled (any string is
//    a valid object key). Kept small — only the words that actually collide with Zen's identifier space.
js_is_reserved = (n: string_view) bool { eq(n, "default") || eq(n, "new") || eq(n, "class") || eq(n, "function") || eq(n, "var") || eq(n, "let") || eq(n, "const") || eq(n, "this") || eq(n, "null") || eq(n, "delete") || eq(n, "in") || eq(n, "instanceof") || eq(n, "typeof") || eq(n, "void") || eq(n, "with") || eq(n, "super") || eq(n, "enum") || eq(n, "export") || eq(n, "import") || eq(n, "extends") || eq(n, "switch") || eq(n, "case") || eq(n, "yield") || eq(n, "await") || eq(n, "debugger") || eq(n, "finally") }
jname = (s: String, a: MutPtr<Malloc>, n: string_view) String {
    js_is_reserved(n).match ({
        true  => s.gstr_append(a, n).gstr_append(a, "$"),
        false => s.gstr_append(a, n),
    })
}
// ── JS string-literal escaping (byte by byte to the NUL) ──────────────────────────────────────────
jbyte = (v: string_view, i: i64) u8 { load(offset(v, i)) }
jesc_byte = (s: String, a: MutPtr<Malloc>, b: u8) String {
    (b == '"').match ({
        true  => s.gstr_append(a, "\\\""),
        false => (b == '\\').match ({
            true  => s.gstr_append(a, "\\\\"),
            false => (b == '\n').match ({
                true  => s.gstr_append(a, "\\n"),
                false => (b == '\r').match ({
                    true  => s.gstr_append(a, "\\r"),
                    false => (b == '\t').match ({
                        true  => s.gstr_append(a, "\\t"),
                        false => s.gstr_push(a, b),
                    }),
                }),
            }),
        }),
    })
}
jesc_from = (s: String, a: MutPtr<Malloc>, v: string_view, i: i32) String {
    (jbyte(v, i) == 0).match ({
        true  => s,
        false => s.jesc_byte(a, jbyte(v, i)).jesc_from(a, v, i + 1),
    })
}
jstrlit = (s: String, a: MutPtr<Malloc>, v: string_view) String { s.gstr_append(a, "__zr.str(\"").jesc_from(a, v, 0).gstr_append(a, "\")") }
// ── expressions ───────────────────────────────────────────────────────────────────────────────────
js_expr* = (s: String, a: MutPtr<Malloc>, e: Ptr<Expr>) String {
    e.match ({
        .Int(n)         => s.jint(a, n),
        .Byte(n)        => s.jint(a, n),
        .FloatLit(ft)   => s.gstr_append(a, ft),
        .Var(v)         => s.jname(a, v.name),
        .Bin(b)         => s.js_bin(a, b),
        .Call(c)        => s.js_call(a, c),
        .MethodCall(mc) => s.gstr_append(a, "__zr.undesugared_method_call"),
        .Cond(d)        => s.gstr_append(a, "(").js_expr(a, d.c).gstr_append(a, " ? ").js_expr(a, d.t).gstr_append(a, " : ").js_expr(a, d.e).gstr_append(a, ")"),
        .Member(m)      => s.js_member(a, m),
        .Arrow(ar)      => s.js_expr(a, ar.obj).gstr_append(a, ".").gstr_append(a, ar.field),
        .MakeEnum(m)    => s.gstr_append(a, "({ tag: \"").gstr_append(a, m.variant).gstr_append(a, "\", ").gstr_append(a, m.variant).gstr_append(a, ": ").js_expr(a, m.payload).gstr_append(a, " })"),
        .MakeStruct(m)  => s.js_mkstruct(a, m),
        .Tag(t)         => s.gstr_append(a, "({ tag: \"").gstr_append(a, t.variant).gstr_append(a, "\" })"),
        .Match(m)       => s.js_match_expr(a, m),
        .StrLit(sl)     => s.jstrlit(a, sl.value),
        .SliceLit(sd)   => s.gstr_append(a, "({ ptr: [").js_args(a, sd.items).gstr_append(a, "], len: ").jint(a, js_slice_count(sd.items)).gstr_append(a, " })"),
        .Index(ix)      => s.gstr_append(a, "__zr.idx(").js_expr(a, ix.seq).gstr_append(a, ", ").js_expr(a, ix.idx).gstr_append(a, ")"),
        .Loop(l)        => s.js_loop(a, l),
        .Lambda(lm)     => s.gstr_append(a, "__zr.unlowered_lambda"),
        .Block(b)       => s.js_block_expr(a, b),
    })
}
js_slice_count = (items: [Expr]) i32 {
    n := 0
    items.loop((h, i, it) {
        n = n + 1
    })
    n
}
// loop-handler controls `h.break`/`h.continue` -> JS break/continue; else `obj.field`.
// `.u` is genc's union-payload access baked by the checker's or_return / match-payload lowering
// (`subj.u.Variant`). The JS enum has NO `u` level — it's a flat `{ tag, Variant }` — so `.u` erases
// to identity: `subj.u.Ok` emits as `subj.Ok`. (`break_zk`/`continue_zk` are the loop-handler verbs.)
js_member = (s: String, a: MutPtr<Malloc>, m: MemberData) String {
    eq(m.field, "break_zk").match ({
        true  => s.gstr_append(a, "break"),
        false => eq(m.field, "continue_zk").match ({
            true  => s.gstr_append(a, "continue"),
            false => eq(m.field, "u").match ({
                true  => s.js_expr(a, m.obj),
                false => s.js_expr(a, m.obj).gstr_append(a, ".").gstr_append(a, m.field),
            }),
        }),
    })
}
// `==`/`!=` -> strict; `/` and `%` route through the guarded floor helpers; all else `(lhs op rhs)`.
// `==`/`!=` -> strict; INTEGER `/` and `%` route through the guarded floor (div-by-zero panics); the
// checker's float-division marker `/.` emits NATIVE `/` so f64 follows IEEE (`0.0/0.0` -> NaN, never a
// panic); all else `(lhs op rhs)`.
js_bin = (s: String, a: MutPtr<Malloc>, b: BinData) String {
    eq(b.op, "/.").match ({
        true  => s.gstr_append(a, "(").js_expr(a, b.lhs).gstr_append(a, " / ").js_expr(a, b.rhs).gstr_append(a, ")"),
        false => eq(b.op, "/").match ({
            true  => s.gstr_append(a, "__zr.div(").js_expr(a, b.lhs).gstr_append(a, ", ").js_expr(a, b.rhs).gstr_append(a, ")"),
            false => eq(b.op, "%").match ({
                true  => s.gstr_append(a, "__zr.mod(").js_expr(a, b.lhs).gstr_append(a, ", ").js_expr(a, b.rhs).gstr_append(a, ")"),
                false => s.gstr_append(a, "(").js_expr(a, b.lhs).gstr_append(a, " ").gstr_append(a, js_op(b.op)).gstr_append(a, " ").js_expr(a, b.rhs).gstr_append(a, ")"),
            }),
        }),
    })
}
js_op = (op: string_view) string_view {
    eq(op, "==").match ({
        true  => "===",
        false => eq(op, "!=").match ({ true => "!==", false => op }),
    })
}
js_mkstruct = (s: String, a: MutPtr<Malloc>, m: MakeStructData) String {
    out := s.gstr_append(a, "({ ")
    m.inits.loop((h, i, fi) {
        out = (i == 0).match ({ true => out, false => out.gstr_append(a, ", ") })
        out = out.gstr_append(a, fi.name).gstr_append(a, ": ").js_expr(a, fi.value)
    })
    out.gstr_append(a, " })")
}
// a call's comma-separated args (each Expr value -> a Ptr<Expr> child).
js_args = (s: String, a: MutPtr<Malloc>, args: [Expr]) String {
    out := s
    args.loop((h, i, arg) {
        out = (i == 0).match ({ true => out, false => out.gstr_append(a, ", ") })
        out = out.js_expr(a, arg.addr())
    })
    out
}
js_arg_at = (s: String, a: MutPtr<Malloc>, c: CallData, i: i32) String { (i < c.args.len).match ({
    true  => s.js_expr(a, c.args[i].addr()),
    false => s.gstr_append(a, "0"),
}) }
// intrinsics erase to floor calls; everything else is an ordinary JS call `name(args)`.
js_call = (s: String, a: MutPtr<Malloc>, c: CallData) String {
    eq(c.fn, "__str_eq").match ({
        true  => s.gstr_append(a, "__zr.eq(").js_arg_at(a, c, 0).gstr_append(a, ", ").js_arg_at(a, c, 1).gstr_append(a, ")"),
        false => eq(c.fn, "__str_ne").match ({
            true  => s.gstr_append(a, "(!__zr.eq(").js_arg_at(a, c, 0).gstr_append(a, ", ").js_arg_at(a, c, 1).gstr_append(a, "))"),
            false => eq(c.fn, "load").match ({
                true  => s.gstr_append(a, "__zr.load(").js_arg_at(a, c, 0).gstr_append(a, ")"),
                false => eq(c.fn, "store").match ({
                    true  => s.gstr_append(a, "__zr.store(").js_arg_at(a, c, 0).gstr_append(a, ", ").js_arg_at(a, c, 1).gstr_append(a, ")"),
                    false => eq(c.fn, "offset").match ({
                        true  => s.gstr_append(a, "__zr.offset(").js_arg_at(a, c, 0).gstr_append(a, ", ").js_arg_at(a, c, 1).gstr_append(a, ")"),
                        false => eq(c.fn, "slice").match ({
                            true  => s.gstr_append(a, "__zr.slice(").js_arg_at(a, c, 0).gstr_append(a, ", ").js_arg_at(a, c, 1).gstr_append(a, ")"),
                            false => eq(c.fn, "cstr").match ({
                                true  => s.gstr_append(a, "(").js_arg_at(a, c, 0).gstr_append(a, ")"),
                                false => eq(c.fn, "null_ptr").match ({
                                    true  => s.gstr_append(a, "0"),
                                    false => eq(c.fn, "addr").match ({
                                        true  => s.gstr_append(a, "__zr.addr(").js_arg_at(a, c, 0).gstr_append(a, ")"),
                                        false => eq(c.fn, "assert_nonnull").match ({
                                            true  => s.gstr_append(a, "__zr.nn(").js_arg_at(a, c, 0).gstr_append(a, ")"),
                                            false => s.js_call_intr2(a, c),
                                        }),
                                    }),
                                }),
                            }),
                        }),
                    }),
                }),
            }),
        }),
    })
}
// second tier of intrinsics (kept split so no single match nests too deep for the parser).
js_call_intr2 = (s: String, a: MutPtr<Malloc>, c: CallData) String {
    eq(c.fn, "to_i32").match ({
        true  => s.gstr_append(a, "__zr.i32(").js_arg_at(a, c, 0).gstr_append(a, ")"),
        false => eq(c.fn, "to_i64").match ({
            true  => s.gstr_append(a, "__zr.i64(").js_arg_at(a, c, 0).gstr_append(a, ")"),
            false => eq(c.fn, "to_u8").match ({
                true  => s.gstr_append(a, "((").js_arg_at(a, c, 0).gstr_append(a, ") & 255)"),
                false => eq(c.fn, "to_f64").match ({
                    true  => s.gstr_append(a, "(+(").js_arg_at(a, c, 0).gstr_append(a, "))"),
                    false => eq(c.fn, "load_i64").match ({
                        true  => s.gstr_append(a, "__zr.load_i64(").js_arg_at(a, c, 0).gstr_append(a, ")"),
                        false => eq(c.fn, "store_i64").match ({
                            true  => s.gstr_append(a, "__zr.store_i64(").js_arg_at(a, c, 0).gstr_append(a, ", ").js_arg_at(a, c, 1).gstr_append(a, ")"),
                            false => eq(c.fn, "sizeof").match ({
                                true  => s.js_sizeof(a, c),
                                false => s.js_dom_dispatch(a, c),
                            }),
                        }),
                    }),
                }),
            }),
        }),
    })
}
js_sizeof = (s: String, a: MutPtr<Malloc>, c: CallData) String {
    (c.args.len > 0).match ({
        true  => c.args[0].addr().match ({
            .Var(v) => s.gstr_append(a, "__zr.sizeof(\"").gstr_append(a, v.name).gstr_append(a, "\")"),
            _       => s.gstr_append(a, "8"),
        }),
        false => s.gstr_append(a, "8"),
    })
}
js_call_raw = (s: String, a: MutPtr<Malloc>, c: CallData) String { s.jname(a, c.fn).gstr_append(a, "(").js_args(a, c.args).gstr_append(a, ")") }
// std.platform's bodyless host floor is generated by each backend, never supplied by zenrt.
js_call_default = (s: String, a: MutPtr<Malloc>, c: CallData) String {
    eq(c.fn, "zen_platform_host_os").match ({
        true  => s.gstr_append(a, "((typeof process !== 'undefined' && process.platform === 'darwin') ? 1 : (typeof process !== 'undefined' && process.platform === 'linux') ? 2 : (typeof process !== 'undefined' && process.platform === 'win32') ? 3 : 0)"),
        false => eq(c.fn, "zen_platform_host_arch").match ({
            true  => s.gstr_append(a, "((typeof process !== 'undefined' && process.arch === 'arm64') ? 1 : (typeof process !== 'undefined' && process.arch === 'x64') ? 2 : 0)"),
            false => eq(c.fn, "zen_platform_host_abi").match ({
                true  => s.gstr_append(a, "((typeof process !== 'undefined' && process.platform === 'darwin') ? 1 : (typeof process !== 'undefined' && process.platform === 'linux') ? 2 : (typeof process !== 'undefined' && process.platform === 'win32') ? 4 : 0)"),
                false => s.js_call_raw(a, c),
            }),
        }),
    })
}
// ── std.web.dom lowering: DOM stub CALLS → real browser JS ────────────────────────────────────────
// dom.zen is the JS-target analog of std.c.libc: a header of BODYLESS typed stubs. genc lowers a
// bodyless decl to a C prototype that libc defines; genjs lowers the CALL to the live browser API —
// `create_element(doc, "div")` → `doc.createElement("div")`, `set_text_content(n, s)` → `n.textContent = s`.
// The map below is a NAME table (snake_case Zen stub → camelCase JS member). It runs AFTER the intrinsic
// tiers (so it only sees non-intrinsic calls) and FALLS THROUGH to an ordinary JS call for every non-DOM
// name (js_call_default), so emission is byte-identical for programs that never touch the DOM — the
// change is purely additive. Design: an interface handle (`{ handle }`) is a JS object ref, passed through
// as identity (like MutPtr<Struct>); upcast stubs (`as_node`, …) lower to that identity; a global singleton
// accessor (`document()`) lowers to the bare global; a Zen `str` argument is decoded to a real JS string
// via `__zr.jstr` (MEM offset → JS string) at the API boundary. Receiver is arg0; extra args follow.
js_dom_recv = (s: String, a: MutPtr<Malloc>, c: CallData) String { s.js_arg_at(a, c, 0) }
js_dom_str = (s: String, a: MutPtr<Malloc>, c: CallData, i: i32) String { s.gstr_append(a, "__zr.jstr(").js_arg_at(a, c, i).gstr_append(a, ")") }
js_dmeth = (s: String, a: MutPtr<Malloc>, c: CallData, m: string_view) String { s.js_dom_recv(a, c).gstr_append(a, ".").gstr_append(a, m) }
// emit shapes: method with 0 args / one str arg / one passthrough arg / two str / str+passthrough / two passthrough.
js_dm0 = (s: String, a: MutPtr<Malloc>, c: CallData, m: string_view) String { s.js_dmeth(a, c, m).gstr_append(a, "()") }
js_dm_s = (s: String, a: MutPtr<Malloc>, c: CallData, m: string_view) String { s.js_dmeth(a, c, m).gstr_append(a, "(").js_dom_str(a, c, 1).gstr_append(a, ")") }
js_dm_p = (s: String, a: MutPtr<Malloc>, c: CallData, m: string_view) String { s.js_dmeth(a, c, m).gstr_append(a, "(").js_arg_at(a, c, 1).gstr_append(a, ")") }
js_dm_ss = (s: String, a: MutPtr<Malloc>, c: CallData, m: string_view) String { s.js_dmeth(a, c, m).gstr_append(a, "(").js_dom_str(a, c, 1).gstr_append(a, ", ").js_dom_str(a, c, 2).gstr_append(a, ")") }
js_dm_sp = (s: String, a: MutPtr<Malloc>, c: CallData, m: string_view) String { s.js_dmeth(a, c, m).gstr_append(a, "(").js_dom_str(a, c, 1).gstr_append(a, ", ").js_arg_at(a, c, 2).gstr_append(a, ")") }
js_dm_pp = (s: String, a: MutPtr<Malloc>, c: CallData, m: string_view) String { s.js_dmeth(a, c, m).gstr_append(a, "(").js_arg_at(a, c, 1).gstr_append(a, ", ").js_arg_at(a, c, 2).gstr_append(a, ")") }
// emit shapes: property read / property write (str value) / property write (passthrough value).
js_dp = (s: String, a: MutPtr<Malloc>, c: CallData, p: string_view) String { s.js_dmeth(a, c, p) }
js_dw_s = (s: String, a: MutPtr<Malloc>, c: CallData, p: string_view) String { s.js_dmeth(a, c, p).gstr_append(a, " = ").js_dom_str(a, c, 1) }
js_dw_p = (s: String, a: MutPtr<Malloc>, c: CallData, p: string_view) String { s.js_dmeth(a, c, p).gstr_append(a, " = ").js_arg_at(a, c, 1) }
// emit shapes: bare global singleton / identity upcast (arg0 passthrough) / receiver-less global `fetch(str)`.
js_dg = (s: String, a: MutPtr<Malloc>, name: string_view) String { s.gstr_append(a, name) }
js_did = (s: String, a: MutPtr<Malloc>, c: CallData) String { s.js_dom_recv(a, c) }
js_dfetch = (s: String, a: MutPtr<Malloc>, c: CallData) String { s.gstr_append(a, "fetch(").js_dom_str(a, c, 0).gstr_append(a, ")") }
// tier 1 — JS global singletons (`document()`→`document`), the receiver-less `fetch`, and the inheritance
// upcasts (each an identity: in JS an Element already IS a Node/EventTarget).
js_dom_dispatch = (s: String, a: MutPtr<Malloc>, c: CallData) String {
    eq(c.fn, "document").match ({
        true  => s.js_dg(a, "document"),
        false => eq(c.fn, "window").match ({
            true  => s.js_dg(a, "window"),
            false => eq(c.fn, "console").match ({
                true  => s.js_dg(a, "console"),
                false => eq(c.fn, "fetch").match ({
                    true  => s.js_dfetch(a, c),
                    false => eq(c.fn, "node_target").match ({
                        true  => s.js_did(a, c),
                        false => eq(c.fn, "as_node").match ({
                            true  => s.js_did(a, c),
                            false => eq(c.fn, "as_event_target").match ({
                                true  => s.js_did(a, c),
                                false => eq(c.fn, "as_element").match ({
                                    true  => s.js_did(a, c),
                                    false => eq(c.fn, "text_node").match ({
                                        true  => s.js_did(a, c),
                                        false => eq(c.fn, "document_node").match ({
                                            true  => s.js_did(a, c),
                                            false => eq(c.fn, "window_target").match ({
                                                true  => s.js_did(a, c),
                                                false => eq(c.fn, "as_html").match ({
                                                    true  => s.js_did(a, c),
                                                    false => s.js_dom_d2(a, c),
                                                }),
                                            }),
                                        }),
                                    }),
                                }),
                            }),
                        }),
                    }),
                }),
            }),
        }),
    })
}
// tier 2 — EventTarget + Event.
js_dom_d2 = (s: String, a: MutPtr<Malloc>, c: CallData) String {
    eq(c.fn, "add_event_listener").match ({
