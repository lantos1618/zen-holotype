// tools/gates/faults_reachable.zen
// Every fault the compiler declares must have a site that raises it. The Zen
// port of `scripts/faults_reachable.py`.
//
// A fault variant is a PROMISE: it is a sentence in `message()` saying the
// compiler will tell you when you break a particular rule. A variant that is
// declared, worded, and never constructed keeps the promise nowhere — the
// program that breaks the rule compiles, and the enum reads complete to
// anyone auditing it. That is this repository's recurring failure mode in its
// purest form: a gate that cannot fail.
//
// Five of them were found this way, all at once, by a grep no cheaper than
// this file. So the grep lives here and runs in the build.
//
// IT PARSES THE DECLARATION AND GREPS THE SITES, and the split is deliberate.
// The variant LIST comes from `std.parse` — the compiler's own frontend, the
// same one that will reject the file if it is malformed — where the Python it
// replaces matched `^\s*[|=]\s*([A-Z]\w*)\s*\(` and would have silently
// stopped seeing variants the day the enum was reformatted. The SITES are
// still a text scan, matching what the Python did, because a construction site
// inside a comment counts the same either way and narrowing that is a separate
// decision with its own argument.
//
// WHAT IT DOES NOT CATCH, and this matters because the check is green today.
// A construction site is not a diagnostic anyone can reach — the site may sit
// behind a condition that is never true. This proves only that somebody wrote
// the raise. The must-fail suite is what proves the rule is enforced; this is
// the cheap standing check underneath it.
//
// GREEN HERE DOES NOT MEAN EVERY DIAGNOSTIC WORKS. It means no fault is
// silently absent.

Alloc, AllocError = std.mem
str, String = std.text
Vec = std.collections
Range = std.core
FsError = std.env

scan, Source = std.lex.lex
Parser = std.parse.parser
Ast = std.ast.ast_arena
Module, Decl = std.ast.ast_node

// fault enum -> the file that declares it. The declaring file is skipped when
// hunting for construction sites: `message()` mentions every variant by name
// and would match all of them.
SEMA_FAULT: str = "SemaFault"
SEMA_FILE:  str = "src/sema/sema_diag.zen"
GEN_FAULT:  str = "GenFault"
GEN_FILE:   str = "src/gen/gen_diag.zen"

// THE DEBT. Every entry is a rule `docs/DESIGN.md` states, worded in
// `message()`, that no program can currently trigger — so the program that
// breaks the rule compiles. Each is against the work that owes it.
//
// Deleting a line is how a hole closes. Adding one requires a reason that
// names the law and what blocks it, because the alternative to writing it down
// here is the enum reading complete while it is not, which is the state this
// gate was written to end.
//
// THE LEDGER IS EMPTY, and `owed` is kept rather than deleted so that the
// first hole anyone opens has somewhere to be written down. A name in it that
// gains a raise site is an error too (see `paid` below), so it cannot drift
// back into the fiction it replaced.
owed = (name: str) bool {
    // `SemaFault.ComptimeBudget` (#768): the META_STEPS counter it belonged
    // to could never reach zero — three spends on a straight line, and the
    // one callee that recurses (`type_from_ast`) was never charged. The
    // counter is removed until the first rule that can loop returns with a
    // budget charged into whatever can recurse (docs/design_meta.md §8);
    // when it does, this line is paid and must come back out.
    name.eq("ComptimeBudget")
}

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    (env.argv.len < 2).match({
        true  => no_files(),
        false => run(env, alloc),
    })
}

no_files = () Res<i32, AllocError> {
    println("faults: no files given — this gate is checking nothing.");
    println("    `make faults` feeds it `find src -name '*.zen'`; a find that");
    println("    matches nothing must not read as green.");
    Ok(2);
}

run = (env: Env, alloc: Alloc) Res<i32, AllocError> {
    a ::= check(env, alloc, SEMA_FAULT, SEMA_FILE).try();
    b ::= check(env, alloc, GEN_FAULT, GEN_FILE).try();

    bad = a.missing + b.missing + a.stale + b.stale;
    (bad > 0).match({
        true  => Ok(1),
        false => {
            total = a.declared + b.declared;
            println(
                "faults: {} declared, {} constructed, 0 owed and written down",
                total,
                total
            );
            Ok(0);
        },
    })
}

// What one enum contributed. `stale` is a name in the ledger that something
// constructs now — a hole someone closed and did not delete.
Tally = {
    declared*: usize,
    missing*: usize,
    stale*: usize,
}

check = (env: Env, alloc: Alloc, enum: str, decl: str) Res<Tally, AllocError> {
    env.fs.read(alloc, decl).match({
        Err(e)   => gone(decl, e),
        Ok(text) => {
            names = variants_of(alloc, enum, decl, text.view()).try();
            (names.len == 0).match({
                true  => moved(enum, decl),
                false => weigh(env, alloc, enum, decl, names),
            })
        },
    })
}

gone = (decl: str, e: FsError) Res<Tally, AllocError> {
    println("faults: {} is gone; this gate names it ({})", decl, fs_word(e));
    Ok(Tally(declared: 0, missing: 1, stale: 0));
}

// The declaration moved or changed shape, and this check just stopped
// checking. That is a harness failure, not a clean bill of health.
moved = (enum: str, decl: str) Res<Tally, AllocError> {
    println(
        "faults: found no variants of {} in {}. The declaration moved or changed shape, and this gate just stopped checking — fix it, do not delete it.",
        enum,
        decl
    );
    Ok(Tally(declared: 0, missing: 1, stale: 0));
}

weigh = (env: Env, alloc: Alloc, enum: str, decl: str, names: Vec<str>)
        Res<Tally, AllocError> {
    missing ::= 0;
    stale   ::= 0;
    names.loop((h, name) {
        built = constructed(env, alloc, name, decl);
        owed(name).match({
            // in the ledger: constructing it means the debt is paid and the
            // line should be gone
            true  => built.then(() {
                stale = stale + 1;
                println(
                    "faults: {} is in the ledger and something constructs it now. Delete it from `owed` in tools/gates/faults_reachable.zen — the debt is paid.",
                    name
                );
            }),
            false => built.match({
                true  => (),
                false => {
                    missing = missing + 1;
                    println(
                        "{}: {}.{} is declared and worded, and nothing constructs it",
                        decl,
                        enum,
                        name
                    );
                    println(
                        "    Raise it, or write it into `owed` with the law it enforces and what blocks it. An enum that reads complete and is not is worse than one that admits the hole."
                    );
                },
            }),
        });
    });
    Ok(Tally(declared: names.len, missing: missing, stale: stale));
}

// THE VARIANT NAMES, off the real parse tree. A file that does not lex or does
// not parse yields none, which `moved` above turns into a failure rather than
// a green run over an empty set.
variants_of = (a: Alloc, enum: str, path: str, text: str)
              Res<Vec<str>, AllocError> {
    out ::= a.Vec<str>();
    lexed = scan(a, Source(file: path, text: text)).try();
    lexed.is_clean().match({
        false => (),
        true  => {
            p ::= a.Parser(lexed);
            m = p.module("d").try();
            m.decls.loop((h, d) {
                d.kind.match({
                    Enum(e) => e.name.text.eq(enum).then(() {
                        e.variants.loop(
                            (h2, v) { out.add(v.name.text).try(); }
                        );
                    }),
                    _       => (),
                });
            });
        },
    });
    Ok(out);
}

// Is `name` built anywhere outside its own declaring file? `Name(` with a
// non-identifier byte in front, which is what the Python's `\bName\s*\(` came
// to; the space before `(` is not allowed here because the formatter never
// writes one and a constructor call is what is being looked for.
constructed = (env: Env, alloc: Alloc, name: str, decl: str) bool {
    found ::= false;
    Range(1, env.argv.len).loop((h, i) {
        rel = arg(env, i);
        (found == false && rel.eq(decl) == false).then(() {
            env.fs.read(alloc, rel).match({
                Err(e)   => (),
                Ok(text) => calls(text.view(), name).then(() { found = true; }),
            });
        });
    });
    found
}

calls = (text: str, name: str) bool {
    hit ::= false;
    // `+ 1` for the `(` that has to follow the name
    (text.len > name.len).then(() {
        Range(0, text.len - name.len).loop((h, i) {
            at_call(text, name, i).then(() { hit = true; });
        });
    });
    hit
}

at_call = (text: str, name: str, i: usize) bool {
    open_at = i + name.len;
    (open_at < text.len).match({
        false => false,
        true  => text.index(open_at) == '('
                 && boundary_before(text, i)
                 && matches_at(text, name, i),
    })
}

// A word boundary: the byte before the name may not continue an identifier,
// or `NoSuchField` would be found inside `HasNoSuchField`.
boundary_before = (text: str, i: usize) bool {
    (i == 0).match({
        true  => true,
        false => !is_ident(text.index(i - 1)),
    })
}

matches_at = (text: str, name: str, i: usize) bool {
    same ::= true;
    Range(0, name.len).loop((h, k) {
        (text.index(i + k) == name.index(k)).match({
            true  => (),
            false => { same = false; },
        });
    });
    same
}

is_ident = (b: u8) bool {
    (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9')
        || b == '_'
}

arg = (env: Env, i: usize) str {
    env.argv.get(i).match({ Ok(s) => s, None => "" })
}

fs_word = (e: FsError) str {
    e.match({
        NotFound    => "not found",
        Denied      => "denied",
        IsDir       => "is a directory",
        Failed      => "could not be read",
        OutOfMemory => "out of memory",
    })
}
