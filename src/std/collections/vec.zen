// std.collections.vec — generic growable Vec<T> with explicit allocator-threaded storage.
// Fallible ops (`of`, `push`, `grow`) return Result<Vec<T>, IoError> — allocation failure is a
// value: `.expect("…")` at fail-fast roots, `.or_return()` inside Result-returning fns.
// @self-hosted-only: generic struct literals are covered by self-hosted tests.
{ AllocatorBackend, Allocator, heap_allocator } = std.mem.alloc
{ Result, IoError, Opt, ok, err, panic, expect } = std.core.result
{ loop_at } = std.core.count
buf = std.mem.buffer
// Every Vec carries its allocator and sticky-OOM state.
// The allocator state must outlive the Vec and every derived owner.
Vec*<T>: {
    ptr: RawPtr<u8>,
    len: i64,
    cap: i64,
    carried: bool,
    oom: bool,
    alloc: Allocator,
    add = (v: Vec<T>, xs: [T]) Vec<T> {
        // append MANY elements; a no-op once sticky or uncarried.
        d = v.alloc
        v.live().then({ v.settle(d.addr().extend_in(v, xs)) }, { v })
    }
    add_one = (v: Vec<T>, x: T) Vec<T> {
        // append ONE element; a no-op once sticky or uncarried.
        d = v.alloc
        v.live().then({ v.settle(v.push(d.addr(), x)) }, { v })
    }
    freeze = (v: Vec<T>) Result<VecConst<T>, IoError> {
        vec_buffer(v).buffer_freeze().match ({
            .Ok(c)  => ok(buffer_vec_const(c)),
            .Err(e) => err(e),
        })
    }
    drop = (v: Vec<T>) void { vec_buffer(v).buffer_drop() }
    live = (v: Vec<T>) bool { vec_buffer(v).buffer_live() }
    settle = (v: Vec<T>, r: Result<Vec<T>, IoError>) Vec<T> {
        br: Result<buf.Buffer<T>, IoError> = r.match ({
            .Ok(g)  => .Ok(vec_buffer(g)),
            .Err(e) => .Err(e),
        })
        buffer_vec(buf.buffer_settle(vec_buffer(v), br))
    }
    relink = (v: Vec<T>, g: Vec<T>) Vec<T> {
        br: Result<buf.Buffer<T>, IoError> = .Ok(vec_buffer(g))
        buffer_vec(buf.buffer_settle(vec_buffer(v), br))
    }
    poison = (v: Vec<T>) Vec<T> {
        br: Result<buf.Buffer<T>, IoError> = .Err(.NotFound)
        buffer_vec(buf.buffer_settle(vec_buffer(v), br))
    }
    buf = (v: Vec<T>) [T] { slice(v.ptr, v.cap) }
    view = (v: Vec<T>) [T] {
        // a slice over exactly the `len` live elements (NOT `cap` — excludes uninitialized storage).
        // Use this to iterate, just like any `[T]`: `v.view().loop((h, i, x) { ... })`.
        slice(v.ptr, v.len)
    }
    len = (v: Vec<T>) i64 { v.len }
    get = (v: Vec<T>, i: i64) T {
        // Bounds-checked read against `len` (the LIVE element count), NOT `cap`: an index in [len, cap)
        // would otherwise return uninitialized junk from the spare capacity. Out-of-range PANICS (same
        // give-up contract as the compiler's OOB guard) rather than returning garbage. Signature stays
        // `T` — every existing caller with a valid index is unchanged. Need a recoverable read? `get_opt`.
        (i < 0 || i >= v.len).match ({
            true  => {
                panic("vec.get: index out of bounds")
                // unreachable — panic aborts; the recursion only satisfies the arm's type.
                v.get(i)
            },
            false => v.buf()[i],
        })
    }
    get_opt = (v: Vec<T>, i: i64) Opt<T> {
        // Recoverable bounds-checked read: `.Some(x)` for i in [0, len), `.None` past the live end.
        (i < 0 || i >= v.len).match ({
            true  => {
                none: Opt<T> = .None
                none
            },
            false => {
                some: Opt<T> = .Some(v.buf()[i])
                some
            },
        })
    }
    grow = (v: Vec<T>, a: AllocatorBackend) Result<Vec<T>, IoError> {
        ncap = v.cap * 2 + 1
        a.try_resize(v.ptr, ncap * sizeof(T)).match ({
            .Ok(p)  => {
                vok: Result<Vec<T>, IoError> = .Ok(Vec<T>(
                    ptr: p,
                    len: v.len,
                    cap: ncap,
                    carried: v.carried,
                    oom: v.oom,
                    alloc: v.alloc,
                ))
                vok
            },
            .Err(e) => {
                verr: Result<Vec<T>, IoError> = .Err(e)
                verr
            },
        })
    }
    push = (v: Vec<T>, a: AllocatorBackend, x: T) Result<Vec<T>, IoError> {
        x = x
        out: Result<Vec<T>, IoError> = (v.len < v.cap).match ({
            true  => {
                b ::= v.buf()
                b[v.len] = x
                vok: Result<Vec<T>, IoError> = .Ok(Vec<T>(
                    ptr: v.ptr,
                    len: v.len + 1,
                    cap: v.cap,
                    carried: v.carried,
                    oom: v.oom,
                    alloc: v.alloc,
                ))
                vok
            },
            false => {
                v.grow(a).match ({
                    .Ok(r)  => {
                        b ::= r.buf()
                        b[r.len] = x
                        vok: Result<Vec<T>, IoError> = .Ok(Vec<T>(
                            ptr: r.ptr,
                            len: r.len + 1,
                            cap: r.cap,
                            carried: r.carried,
                            oom: r.oom,
                            alloc: r.alloc,
                        ))
                        vok
                    },
                    .Err(e) => {
                        verr: Result<Vec<T>, IoError> = .Err(e)
                        verr
                    },
                })
            },
        })
        out
    }
    free = (v: Vec<T>, a: AllocatorBackend) void { a.release(v.ptr) }
    each = (v: Vec<T>, f: (T) void) void {
        // Higher-order helpers over the live elements (`view()`), backed by closures — inline lambdas and
        // stored closures both work. Spelled inline (over `view().loop`) rather than delegating to
        // std.collections.iter, so this module imports no free `fold`/`each`/`find` names — those
        // would re-export and clash with same-named helpers (e.g. `map.find`) in programs that co-import vec
        // and map. `each`/`fold`/`find` allocate nothing; `map`/`filter` thread the allocator and return a
        // fresh Vec wrapped in `Result` (no hidden heap; OOM is a value). The `vw: [T] =` intermediate
        // pins the element type for the loop.
        vw: [T] = v.view()
        vw.loop_at((i, x) { f(x) })
    }
    fold = (v: Vec<T>, init: T, f: (T, T) T) T {
        acc ::= init
        vw: [T] = v.view()
        vw.loop_at((i, x) { acc = f(acc, x) })
        acc
    }
    find = (v: Vec<T>, pred: (T) bool) Opt<T> {
        out :: Opt<T> = .None
        vw: [T] = v.view()
        vw.loop((h, i, x) {
            pred(x).then({
                out = .Some(x)
                h.break
            })
        })
        out
    }
    map<U> = (v: Vec<T>, a: Allocator, f: (T) U) Result<Vec<U>, IoError> {
        // Fallible: the fresh buffer is `try_acquire`d, so OOM is a value (`.Err(.Errno)`) instead of a
        // null `p` the loop would write through. Explicit `.match` threads the Err (matching `grow`/`push`).
        a.try_acquire(v.len * sizeof(U)).match ({
            .Ok(p)  => {
                out :: [U] = slice(p, v.len)
                vw: [T] = v.view()
                vw.loop_at((i, x) { out[i] = f(x) })
                ok: Result<Vec<U>, IoError> = .Ok(Vec<U>(
                    ptr: p,
                    len: v.len,
                    cap: v.len,
                    carried: true,
                    oom: false,
                    alloc: a,
                ))
                ok
            },
            .Err(e) => {
                err: Result<Vec<U>, IoError> = .Err(e)
                err
            },
        })
    }
    filter = (v: Vec<T>, a: Allocator, keep: (T) bool) Result<Vec<T>, IoError> {
        // Fallible for the same reason as `map`: OOM on the result buffer surfaces as `.Err`, never null.
        a.try_acquire(v.len * sizeof(T)).match ({
            .Ok(p)  => {
                out :: [T] = slice(p, v.len)
                vw: [T] = v.view()
                n ::= 0
                vw.loop_at((i, x) {
                    out[n] = x
                    n = n + keep(x).then({ 1 }, { 0 })
                })
                ok: Result<Vec<T>, IoError> = .Ok(Vec<T>(
                    ptr: p,
                    len: n,
                    cap: v.len,
                    carried: true,
                    oom: false,
                    alloc: a,
                ))
                ok
            },
            .Err(e) => {
                err: Result<Vec<T>, IoError> = .Err(e)
                err
            },
        })
    }
}
vec_buffer<T> = (v: Vec<T>) buf.Buffer<T> {
    buf.Buffer<T>(
        ptr: v.ptr,
        len: v.len,
        cap: v.cap,
        carried: v.carried,
        oom: v.oom,
        alloc: v.alloc,
    )
}
buffer_vec<T> = (b: buf.Buffer<T>) Vec<T> {
    Vec<T>(
        ptr: b.ptr,
        len: b.len,
        cap: b.cap,
        carried: b.carried,
        oom: b.oom,
        alloc: b.alloc,
    )
}
// a zero-element `Vec<T>` with capacity for at least one element (so `push` has somewhere to write
// before the first grow). T can't be read off any argument, so it comes from the LHS annotation:
// `r: Result<Vec<i32>, IoError> = vecs.empty(a)`. Fallible like `of`: the seed
// buffer is `try_acquire`d, so OOM is a value, not a null buffer. Pair with `push`/`free`.
empty*<T> = (a: Allocator) Result<Vec<T>, IoError> {
    a.try_acquire(sizeof(T)).match ({
        .Ok(p)  => {
            ok: Result<Vec<T>, IoError> = .Ok(Vec<T>(
                ptr: p,
                len: 0,
                cap: 1,
                carried: true,
                oom: false,
                alloc: a,
            ))
            ok
        },
        .Err(e) => {
            err: Result<Vec<T>, IoError> = .Err(e)
            err
        },
    })
}
// a `Vec<T>` seeded from a slice (copies `xs`), its buffer acquired from `a`. T inferred from `xs`, A from `a`.
of*<T> = (a: Allocator, xs: [T]) Result<Vec<T>, IoError> {
    (xs.len <= 0).match ({
        true  => {
            vok: Result<Vec<T>, IoError> = .Ok(Vec<T>(
                ptr: null_ptr(),
                len: 0,
                cap: 0,
                carried: true,
                oom: false,
                alloc: a,
            ))
            vok
        },
        false => {
            a.try_acquire(xs.len * sizeof(T)).match ({
                .Ok(p)  => {
                    v = Vec<T>(
                        ptr: p,
                        len: xs.len,
                        cap: xs.len,
                        carried: true,
                        oom: false,
                        alloc: a,
                    )
                    b ::= v.buf()
                    xs.loop_at((i, x) { b[i] = x })
                    vok: Result<Vec<T>, IoError> = .Ok(v)
                    vok
                },
                .Err(e) => {
                    verr: Result<Vec<T>, IoError> = .Err(e)
                    verr
                },
            })
        },
    })
}
// Grow `v` so `need` MORE elements fit, in one resize. Distinct from `grow`, which doubles blindly:
// a bulk append knows exactly how much room it wants. Carried fields ride through untouched.
reserve_cap*<T> = (a: AllocatorBackend, v: Vec<T>, need: i64) Result<Vec<T>, IoError> {
    buf.buffer_reserve(a, vec_buffer(v), need).match ({
        .Ok(b)  => .Ok(buffer_vec(b)),
        .Err(e) => .Err(e),
    })
}
// Reserve once and leave `spare` elements after the appended slice.
// If `xs` aliases v, rebase it after resize because realloc may move the block.
extend_spare_in*<T> = (
    a: AllocatorBackend,
    v: Vec<T>,
    xs: Slice<T>,
    spare: i64,
) Result<Vec<T>, IoError> {
    buf.buffer_extend(a, vec_buffer(v), xs, spare).match ({
        .Ok(b)  => .Ok(buffer_vec(b)),
        .Err(e) => {
            out: Result<Vec<T>, IoError> = .Err(e)
            out
        },
    })
}
extend_in*<T> = (a: AllocatorBackend, v: Vec<T>, xs: [T]) Result<Vec<T>, IoError> {
    a.extend_spare_in(v, xs, 0)
}
// Fixed is writable; Const is read-only. Both retain their allocator for drop().
VecFixed*<T>: {
    ptr: RawPtr<u8>,
    len: i64,
    alloc: Allocator,
    view = (v: VecFixed<T>) [T] { slice(v.ptr, v.len) }
    get  = (v: VecFixed<T>, i: i64) T { v.view()[i] }
    set = (v: VecFixed<T>, i: i64, x: T) void {
        w :: [T] = v.view()
        w[i] = x
    }
    drop = (v: VecFixed<T>) void { buf.buffer_fixed_drop(vec_fixed_buffer(v)) }
}
VecConst*<T>: {
    ptr: RawPtr<u8>,
    len: i64,
    alloc: Allocator,
    view = (v: VecConst<T>) Slice<T> { slice(v.ptr, v.len) }
    get  = (v: VecConst<T>, i: i64) T { v.view()[i] }
    drop = (v: VecConst<T>) void { buf.buffer_const_drop(vec_const_buffer(v)) }
}
vec_fixed_buffer<T> = (v: VecFixed<T>) buf.BufferFixed<T> {
    buf.BufferFixed<T>(
        ptr: v.ptr,
        len: v.len,
        alloc: v.alloc,
    )
}
buffer_vec_fixed<T> = (b: buf.BufferFixed<T>) VecFixed<T> {
    VecFixed<T>(
        ptr: b.ptr,
        len: b.len,
        alloc: b.alloc,
    )
}
vec_const_buffer<T> = (v: VecConst<T>) buf.BufferConst<T> {
    buf.BufferConst<T>(
        ptr: v.ptr,
        len: v.len,
        alloc: v.alloc,
    )
}
buffer_vec_const<T> = (b: buf.BufferConst<T>) VecConst<T> {
    VecConst<T>(
        ptr: b.ptr,
        len: b.len,
        alloc: b.alloc,
    )
}
// vec records initial OOM for freeze(); vec_fixed reports it immediately.
vec*<T> = (a: Allocator, cap: i64) Vec<T> {
    b: buf.Buffer<T> = buf.buffer_new(a, cap)
    buffer_vec(b)
}
vec_fixed*<T> = (a: Allocator, n: i64) Result<VecFixed<T>, IoError> {
    r: Result<buf.BufferFixed<T>, IoError> = buf.buffer_fixed(a, n)
    r.match ({
        .Ok(b)  => .Ok(buffer_vec_fixed(b)),
        .Err(e) => .Err(e),
    })
}
// Converting a frozen Vec back to growable storage always copies.
vec_from*<T> = (a: Allocator, c: VecConst<T>) Vec<T> {
    src: [T] = slice(c.ptr, c.len)
    v: Vec<T> = vec(a, c.len)
    v.add(src)
}
// AVec stores its birth allocator; all growth and release use that same value.
// Its allocator state must outlive the AVec. Allocation failure is fail-fast.
AVec*<T>: {
    inner: Vec<T>,
    alloc: Allocator,
    len     = (w: AVec<T>) i64 { w.inner.len() }
    get     = (w: AVec<T>, i: i64) T { w.inner.get(i) }
    get_opt = (w: AVec<T>, i: i64) Opt<T> { w.inner.get_opt(i) }
    view    = (w: AVec<T>) [T] { w.inner.view() }
    each    = (w: AVec<T>, f: (T) void) void { w.inner.each(f) }
    fold    = (w: AVec<T>, init: T, f: (T, T) T) T { w.inner.fold(init, f) }
    find    = (w: AVec<T>, pred: (T) bool) Opt<T> { w.inner.find(pred) }
    push = (w: AVec<T>, x: T) AVec<T> {
        a = w.alloc
        AVec<T>(
            inner: w.inner.push(a.addr(), x).expect("vec.push: out of memory"),
            alloc: w.alloc,
        )
    }
    free = (w: AVec<T>) void {
        a = w.alloc
        w.inner.free(a.addr())
    }
}
// Explicit construction never reads the ambient runtime; T comes from the result context.
new_in*<T> = (a: Allocator) AVec<T> {
    da = a
    ivr: Result<Vec<T>, IoError> = empty(da)
    AVec<T>(
        inner: ivr.expect("vec.new: out of memory"),
        alloc: a,
    )
}
// T comes from the result context. The body avoids a flat-namespace new_in collision.
new*<T> = () AVec<T> {
    a = heap_allocator()
    ivr: Result<Vec<T>, IoError> = empty(a)
    AVec<T>(
        inner: ivr.expect("vec.new: out of memory"),
        alloc: a,
    )
}
// Explicit seed construction copies xs and never reads the ambient runtime.
from_in*<T> = (a: Allocator, xs: [T]) AVec<T> {
    da = a
    iv: Vec<T> = of(da, xs).expect("vec.from: out of memory")
    AVec<T>(
        inner: iv,
        alloc: a,
    )
}
// Process-heap seed construction is fail-fast.
from*<T> = (xs: [T]) AVec<T> {
    a = heap_allocator()
    iv: Vec<T> = of(a, xs).expect("vec.from: out of memory")
    AVec<T>(
        inner: iv,
        alloc: a,
    )
}
