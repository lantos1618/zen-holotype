// Sys.Spawner.spawn is a documented-but-unimplemented capability. It must NOT panic/abort: it returns
// an error VALUE (`.Err(.Errno(38))`, ENOSYS) the caller can `.match`. This program takes the `.Err`
// arm and exits 7 — proving the capability degrades to a handleable value, never a process abort.
{ Sys } = std.sys.root
main = (sys: Sys) i32 {
    sys.spawner().spawn().match ({
        .Ok(v)  => v,
        .Err(e) => 7,
    })
}
