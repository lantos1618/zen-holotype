// Build files are ordinary Zen programs handed a `Builder`.
// Phase order is parse modules -> run build.zen -> compile: a build may
// inspect parsed declarations, but cannot call code from its project.

Alloc = std.mem
Env = std.env
Vec = std.collections
str = std.text
Range = std.core
Options, options = std.cli

Module* = {
    functions* = (self: @Self, a: Alloc) Res<Vec<Function>, AllocError>
}

Function* = {}

BuildFault* = NotFound | FetchFailed | VersionConflict | HashMismatch

BuildError* = BuildFault | AllocError

Os* = Macos | Linux | Windows

Arch* = X86_64 | Arm64

Abi* = Gnu | Musl | Msvc | Darwin

StableName* = {
    stable_name* ::= (self: @Self) str
}

Os.impl(StableName, {
    stable_name = (self: @Self) str {
        self.match({ Macos => "macos", Linux => "linux", Windows => "windows" })
    }
})

Arch.impl(StableName, {
    stable_name = (self: @Self) str {
        self.match({ X86_64 => "x86_64", Arm64 => "arm64" })
    }
})

Abi.impl(StableName, {
    stable_name = (self: @Self) str {
        self.match({ Gnu => "gnu", Musl => "musl", Msvc => "msvc", Darwin => "darwin" })
    }
})

Target* = {
    os*: Os,
    arch*: Arch,
    abi*: Abi,

    // Clang's canonical target spelling. None means the three independently
    // valid coordinates do not form a target this toolchain supports.
    clang_triple* = (self: @Self) Res<str> {
        self.os.match({
            Linux   => self.arch.match({
                X86_64 => self.abi.match({
                    Gnu => Ok("x86_64-linux-gnu"), Musl => Ok("x86_64-linux-musl"), _ => None
                }),
                Arm64  => self.abi.match({
                    Gnu => Ok("aarch64-linux-gnu"), Musl => Ok("aarch64-linux-musl"), _ => None
                }),
            }),
            Macos   => self.abi.match({
                Darwin => self.arch.match({
                    X86_64 => Ok("x86_64-apple-darwin"),
                    Arm64  => Ok("arm64-apple-darwin"),
                }),
                _      => None,
            }),
            Windows => self.arch.match({
                X86_64 => self.abi.match({
                    Msvc => Ok("x86_64-pc-windows-msvc"),
                    Gnu  => Ok("x86_64-w64-windows-gnu"),
                    _    => None,
                }),
                Arm64  => self.abi.match({
                    Msvc => Ok("aarch64-pc-windows-msvc"),
                    _    => None,
                }),
            }),
        })
    }
}

// Packages are fetched into a content-addressed cache and hash-verified.
// Source remains the manifest; `zen add` and `zen remove` edit it.
Package* = {
    url*: str,
    version*: str,
    hash*: str,
}

Dep* = {
    name*: str,
}

Exe* = {
    src*: Path,
    deps*: Vec<Dep>,

    optimize* :: str = "speed",
    strip* :: bool = false,

    // None selects build/{os}-{arch}/{name}.
    out* :: Res<Path> = None,
}

Lib* = {
    src*: Path,
    libs*: Vec<str>,
    paths*: Vec<str>,
}

Extern* = {
    src*: Path,
    libs*: Vec<str>,
    paths*: Vec<str>,
}

// Defines use NAME or NAME=value.
CImport* = {
    headers*: Vec<str>,
    include_paths*: Vec<str>,
    defines*: Vec<str>,
    libraries*: Vec<str>,
    target*: Target,
}

Test* = {
    tests*: Vec<Function>,
    deps*: Vec<Dep>,
}

Bench* = {
    benches*: Vec<Function>,
    budgets*: Vec<Budget>,
}

// Allocation budgets are exact; timing uses a rolling median.
Budget* = {
    name*: str,
    ns_op*: u64,
    allocs_op*: u64,
    bytes_op*: u64,
}

// Check emits nothing; CLI build requests must select a C output mode.
Emission* = Check | CStdout | CFile(str) | CDir(str)

Permutation* = Natural | Reverse | Rotate | Interleave

Permutation.impl(StableName, {
    stable_name = (self: @Self) str {
        self.match({
            Natural    => "",
            Reverse    => "reverse",
            Rotate     => "rotate",
            Interleave => "interleave",
        })
    }
})

index* = (self: Permutation, n: usize, i: usize) usize {
    self.match({
        Natural    => i,
        Reverse    => n - 1 - i,
        Rotate     => (i + 1) % n,
        Interleave => interleaved(n, i),
    })
}

interleaved = (n: usize, i: usize) usize {
    half = n / 2;
    (i < half).match({
        true  => i * 2 + 1,
        false => (i - half) * 2,
    })
}

permutation* = (text: str) Permutation {
    text.match({
        "reverse"    => Permutation.Reverse,
        "rotate"     => Permutation.Rotate,
        "interleave" => Permutation.Interleave,
        _            => Permutation.Natural,
    })
}

BuildArgs* = {
    root*: str,
    emission* :: Emission = Emission.Check,
    entry* :: str = "",
    std_root* :: str = "",
    symbol_map* :: str = "",
    ffi* :: bool = false,
    repeat* :: usize = 1,
    permute* :: Permutation = Permutation.Natural,

    emits* = (self: @Self) bool {
        self.emission.match({ Check => false, _ => true })
    }

    writes_file* = (self: @Self) bool {
        self.emission.match({ CFile(_) => true, _ => false })
    }
}

// A project command starts at build.zen. `argv` remains borrowed from Env;
// run arguments begin at `args_at` and are ignored by `zen build`.
ProjectArgs* = {
    root* :: str = ".",
    target* :: str = "",
    std_root* :: str = "",
    argv*: Vec<str>,
    args_at* :: usize = 0,
}

BuildFlags* = {
    root* :: str = "",
    out* :: str = "",
    dir* :: str = "",
    entry* :: str = "",
    std_root* :: str = "",
    symbol_map* :: str = "",
    emit_c* :: bool = false,
    ffi* :: bool = false,
    repeat* :: usize = 1,
    permute* :: str = "",

    set_root* = (self :: @Self, value: str) () { self.root = value; }
    set_out* = (self :: @Self, value: str) () { self.out = value; }
    set_dir* = (self :: @Self, value: str) () {
        self.emit_c = true;
        self.dir    = value;
    }
    set_entry* = (self :: @Self, value: str) () { self.entry = value; }
    set_std_root* = (self :: @Self, value: str) () { self.std_root = value; }
    set_symbol_map* = (self :: @Self, value: str) () {
        self.symbol_map = value;
    }
    set_repeat* = (self :: @Self, value: usize) () { self.repeat = value; }
    set_permute* = (self :: @Self, value: str) () { self.permute = value; }
    enable_emit_c* = (self :: @Self) () { self.emit_c = true; }
    enable_ffi* = (self :: @Self) () { self.ffi = true; }

    apply_switch* = (self :: @Self, flag: BuildFlag) () {
        flag.match({
            EmitC => self.enable_emit_c(),
            Ffi   => self.enable_ffi(),
            _     => (),
        });
    }

    apply_setting* = (self :: @Self, flag: BuildFlag, value: str) () {
        flag.match({
            EmitDir   => self.set_dir(value),
            Out       => self.set_out(value),
            Entry     => self.set_entry(value),
            StdRoot   => self.set_std_root(value),
            SymbolMap => self.set_symbol_map(value),
            Repeat    => self.set_repeat(value.repeat_count()),
            Permute   => self.set_permute(value),
            _         => (),
        });
    }

    // Any compiler-output option selects the raw Zen-to-C interface. A build
    // command with no such option starts at build.zen instead.
    compiles_source* = (self: @Self) bool {
        self.emit_c
            || !self.out.is_empty()
            || !self.dir.is_empty()
            || !self.entry.is_empty()
            || !self.symbol_map.is_empty()
            || self.ffi
            || self.repeat != 1
            || !self.permute.is_empty()
    }

    finish* = (self: @Self) Res<BuildArgs, BuildArgFault> {
        self.root.is_empty().match({
            true  => Err(BuildArgFault.MissingRoot),
            false => self.emit_c.match({
                false => Err(BuildArgFault.MissingEmit),
                true  => Ok(BuildArgs(
                    root: self.root,
                    emission: self.emission(),
                    entry: self.entry,
                    std_root: self.std_root,
                    symbol_map: self.symbol_map,
                    ffi: self.ffi,
                    repeat: self.repeat,
                    permute: permutation(self.permute)
                )),
            }),
        })
    }

    emission = (self: @Self) Emission {
        self.dir.is_empty().match({
            false => Emission.CDir(self.dir),
            true  => self.out.is_empty().match({
                true  => Emission.CStdout,
                false => Emission.CFile(self.out),
            }),
        })
    }
}

BuildArgFault* = MissingRoot | MissingEmit

BuildFlag* = EmitC
    | EmitDir
    | Out
    | Entry
    | StdRoot
    | SymbolMap
    | Repeat
    | Permute
    | Ffi

FLAG_EMIT_C*: str = "--emit-c"
FLAG_EMIT_DIR*: str = "--emit-c-dir"
FLAG_OUT*: str = "-o"
FLAG_ENTRY*: str = "--entry"
FLAG_STD*: str = "--std"
FLAG_SYMBOL_MAP*: str = "--symbol-map"
FLAG_REPEAT*: str = "--repeat"
FLAG_PERMUTE*: str = "--permute"
FLAG_FFI*: str = "--ffi"
ZEN_STD_ENV*: str = "ZEN_STD"

build_options* = (a: Alloc) Res<Options<BuildFlag>, AllocError> {
    declared ::= options<BuildFlag>(a);
    declared.flag(FLAG_EMIT_C, BuildFlag.EmitC).try();
    declared.setting(FLAG_EMIT_DIR, BuildFlag.EmitDir).try();
    declared.setting(FLAG_OUT, BuildFlag.Out).try();
    declared.setting(FLAG_ENTRY, BuildFlag.Entry).try();
    declared.setting(FLAG_STD, BuildFlag.StdRoot).try();
    declared.setting(FLAG_SYMBOL_MAP, BuildFlag.SymbolMap).try();
    declared.setting(FLAG_REPEAT, BuildFlag.Repeat).try();
    declared.setting(FLAG_PERMUTE, BuildFlag.Permute).try();
    declared.flag(FLAG_FFI, BuildFlag.Ffi).try();
    Ok(declared)
}

// Anything but a positive count means once.
repeat_count = (text: str) usize {
    n = text.parse_usize().value_or(1);
    (n > 0).match({ true => n, false => 1 })
}

// The compiler driver supplies these methods.
Builder* = {
    os*: Os,
    arch*: Arch,
    env*: Env,
    alloc*: Alloc,
    args*: BuildArgs = BuildArgs(root: ""),

    module* = (self: @Self, path: Path) Module

    target* = (self: @Self) Target

    add* ::= (self :: @Self, name: str, pkg: Package) Res<Dep, BuildError>
    remove* ::= (self :: @Self, name: str) Res<(), BuildError>

    exe* = (self :: @Self, name: str, target: Exe) Res<(), BuildError>
    lib* = (self :: @Self, name: str, target: Lib) Res<Dep, BuildError>
    extern* = (self :: @Self, name: str, target: Extern) Res<Dep, BuildError>
    c_import* = (self :: @Self, name: str, import: CImport)
        Res<Dep, BuildError>
    test* = (self :: @Self, name: str, target: Test) Res<(), BuildError>
    bench* = (self :: @Self, name: str, target: Bench) Res<(), BuildError>

    budget* = (self :: @Self, d: Duration) ()
}
