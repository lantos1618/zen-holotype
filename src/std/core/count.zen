// std.core.count — iteration, and NOTHING else.
//
// These live in their OWN leaf module, not in std.collections.iter, because Zen's import namespace is
// flat: `{ times } = std.collections.iter` drags iter's entire export set — `each`, `find`, `map`,
// `count`, … — into every transitive consumer. That is not hypothetical. Converting std.hash and
// std.rand to `times` broke examples/wordfreq.zen (iter's 1-arg `each` shadowing hmap's) and
// examples/zvm.zen, and both conversions had to be reverted. A module with one concern and a handful
// of exports can be imported by anyone; iter.zen cannot.
// `.loop` iterates MEMORY — it indexes a `[T]`. A cursor has no backing memory, so walking one used to
// leave `@while` as the only option, which is exactly how the imperative loop escaped the primitives
// and spread through ordinary code. `step_while` is that loop, written once: it holds the ONLY `@while`
// in the tree, and every other iteration is a call.
//
// The lambdas are ordinary closures, so they INLINE at the call site — the emitted C is the same plain
// `while (p < n && v[p] != '\n') { p = p + 1 }` the hand-written loop produced, byte for byte. Nothing
// is allocated and nothing is called per step. Because they inline:
//   • assigning the enclosing function's locals works (`total = total + i`, `line = line + 1`);
//   • `return` in either lambda returns from the ENCLOSING FUNCTION — the early exit `@while` had;
//   • an enclosing `.loop`'s `h.break` still breaks THAT loop from inside the body.
// To stop the loop itself and carry on after it, answer `false` from `keep` (or from a `_while` body)
// and read the cursor the call reports.
//
// `T` is the cursor type, taken from the seed, so a scan over `v.len` runs at whatever width `len` has.
// For a materialised `[i64]` of a range's numbers, when a real slice has to be handed on, use the
// allocator-threaded `range_in`/`range_from_in`/`range_step_in` in std.collections.iter.
// THE loop. Carry `from`, advance it with `next`, for as long as `keep` answers true. `keep` sees the
// cursor BEFORE each step, so a false first answer runs `next` zero times, and the reported cursor is
// the first one `keep` rejected. `next` may do the iteration's work as well as move — an effect that
// must not run on the failing test belongs there, not in `keep`.
step_while*<T> = (from: T, keep: (T) bool, next: (T) T) T {
    i ::= from
    @while (keep(i)) {
        i = next(i)
    }
    i
}
// `step_while` for the step every scanner uses: `+ 1`. Reports the first position `keep` rejected.
advance_while*<T> = (from: T, keep: (T) bool) T { from.step_while(keep, (i) { i + 1 }) }
// The unbounded loop: run `body` until it answers false. `body` sees the 0-based iteration ordinal and
// runs AT LEAST ONCE — there is nothing to test before the first pass — so this is the shape of
// `done = false  @while (done == false) { … }`, not of a guarded scan. Reports how many passes ran.
repeat_while* = (body: (i64) bool) i64 {
    go ::= true
    zero: i64 = 0
    zero.step_while((n) { go }, (n) {
        go = body(n)
        n + 1
    })
}
// `lo` up to but excluding `hi`; `hi <= lo` runs the body zero times.
upto*<T> = (lo: T, hi: T, body: (T) void) void {
    lo.step_while((i) { i < hi }, (i) {
        body(i)
        i + 1
    })
}
// `upto` that can stop early: `body` answers "keep going?". Reports the index it stopped ON, or `hi`
// when the body never said stop (so `stopped < hi` means "exited early", and an empty range gives `lo`).
upto_while*<T> = (lo: T, hi: T, body: (T) bool) T { lo.advance_while((i) { i < hi && body(i) }) }
// `0` up to but excluding `n` — the count loop. `n <= 0` runs the body zero times.
times*<T> = (n: T, body: (T) void) void {
    zero: T = 0
    zero.upto(n, body)
}
times_while*<T> = (n: T, body: (T) bool) T {
    zero: T = 0
    zero.upto_while(n, body)
}
// The `.loop` KEYWORD, written as an ordinary library call — the same move `step_while` made for
// `@while`. `xs.loop_at((i, x) { … })` is `xs.loop((h, i, x) { … })` with the handler dropped: the
// index is `i64` here (`xs.len`'s own type) where the keyword's checker bound it `i32`, and there is
// no `h`, so the only way to stop early is `loop_while`. Accepts `Slice<E>` as well as `[E]`.
loop_at*<E> = (xs: [E], body: (i64, E) void) void { xs.len.times((i) { body(i, xs[i]) }) }
// `loop_at` that can stop early — the `h.break` shape. `body` answers "keep going?" AFTER it has run,
// so a body that says false has already had its full effect; the break it replaces exited IMMEDIATELY,
// which is why a break with code after it needs a guard rather than a straight translation. Reports
// the index it stopped ON, or `xs.len` when it ran to the end (an empty slice gives 0) — often the
// answer itself, which retires the sentinel local the keyword form needed.
// This is a SEPARATE name on purpose: Zen has no overloading, so one name cannot take both a `void`
// and a `bool` body, and 88% of call sites never break.
loop_while*<E> = (xs: [E], body: (i64, E) bool) i64 { xs.len.times_while((i) { body(i, xs[i]) }) }
