// A call through a bound may reach every implementation. One implementation
// supplying an optional hook cannot make another implementation's NULL slot
// callable.

Optional = {
    read* ::= (self: @Self) i32
}

Answered = {
    value: i32,
}

Silent = {
    value: i32,
}

Answered.impl(Optional, {
    read = (self: @Self) i32 { self.value + 30 }
})

Silent.impl(Optional, {})

through = (value: Optional) i32 { value.read() }

main = (env: Env) Res<i32, AllocError> {
    println("{}", through(Answered(value: 7)));
    println("{}", through(Silent(value: 9)));
    Ok(0);
}
