// compiler.validate.kinds — per-node kind checks: enums, matches, operands, indices, methods, FFI.
{ ArmData, AssignData, BinData, CallData, Decl, Expr, Field, FieldInit, FnTData, Func, GlobalData,
  ImplData, IndexData, IndexSetData, LambdaData, LetData, MatchData, MethodCallData, Param, Stmt,
  Ty, VariantDef } = compiler.ast.ast_types
{ cbuf, dforeign, gstr_append, gstr_finish, gstr_string, is_expr_null, no_tys, subst_ty_in, tbool,
  tf64, ti32, ti64, tnamed, tnode, tptr_k, tslice, tstring_view, tu8, tvoid } = compiler.genc
{ impl_cname_in } = compiler.mangle
{ DeclIndex, Env, arm_env, bind_tparams, dispatch_recv, dispatch_recv_name, empty_params,
  extend_env, is_lit_numeric, is_str_t, is_void_ty, no_stmts, params_env, recv_name, the_func,
  tparam_declared } = compiler.check
{ calls_reflect, rc_calls_body } = compiler.passes.refcount
{ reflect_fields } = compiler.passes.subst
{ has_fnt_param, is_logic_op, is_or_return_fn, is_prim_width, param_names_has, slice_any,
  wr_lam_writes_value } = compiler.astops
{ Malloc } = std.mem.alloc
{ expr_fold_children } = compiler.ast.expr_children
{ at } = std.text.ascii
{ is_empty } = std.text.str
{ env_imported, env_is_enum, env_is_gen_enum, env_is_gen_struct, env_is_struct, env_known_fn,
  env_struct_fields, env_trait_method, expr_pos, fit_err, is_ctx_typed_arg, is_ptr_ty, is_struct,
  lit_slot_verdict, pos_or, tparam_bound, ty_mentions_tparam, unknown_ty, ut_unknown_tys } = compiler.validate.util
{ KARGTYPE, KARITY, KBADBIND, KCAPACITY, KDIAG_CAP, KEOFINPUT, KEXPECTARROW, KEXPECTDECL,
  KEXPECTEXPR, KEXPECTINIT, KFFITYPE, KMISGEN, KNOTYPEARGS, KORRETURN, KPARSE, KRECHOF,
  KREFLECTRETURN, KREFLECTWRITE, KTARGARITY, KTRAITBOUND, KUNCLOSED, KUNKNOWNTYPE, KUNREACHABLEARM,
  KVBREAK, desc_or } = compiler.validate.diag
{ zty } = compiler.validate.ownership
{ arg_err_at } = compiler.validate.args
{ kv_at, kv_one } = compiler.validate.core
// Does some `Type.impl(Trait)` exist? i.e. a DImpl naming this type + trait.
type_impls_trait = (decls: [Decl], tyname: string_view, trname: string_view) bool {
    found := false
    decls.loop((h, i, d) {
        found = d.match ({
            .DImpl(im) => (im.ty == tyname && im.trname == trname).then({ true }, { found }),
            _          => found,
        })
    })
    found
}
// Enforce ONE bounded tparam at a call site: bind A to its concrete targ, then require the bound.
// Fires when A resolves to a CONCRETE nameable type — a struct, an enum, or a primitive (all live
// in the impl table's key space, `i64.impl(Ord, …)` etc.), so `f<A: Allocator>` called with `i32`
// no longer silently passes. Deferral remains ONLY for genuinely unresolved/abstract targs: an
// empty/unknown name, a caller tparam passed through (`tn` names an in-scope tparam — kvb_func_kind
// binds them, so a tparam that shadows a global type name still defers), and generic residue
// (recv_name of a Generic is its mangled instance name, matching no decl).
bound_prim_name = (n: string_view) bool {
    n == "i8"
        || n == "i16"
        || n == "i32"
        || n == "i64"
        || n == "u8"
        || n == "u16"
        || n == "u32"
        || n == "u64"
        || n == "f32"
        || n == "f64"
        || n == "bool"
        || n == "string_view"
}
bound_targ_concrete = (env: Env, tn: string_view) bool {
    env.decls.is_struct(tn) || env.env_is_enum(tn) || tn.bound_prim_name()
}
bound_errs = (env: Env, f: Func, c: CallData) i32 {
    acc := 0
    f.tparams.loop((h, i, tp) {
        acc = acc + env.bound_err(f, c, tp)
    })
    acc
}
result_compatible = (want: Ty, got: Ty) bool {
    (want.is_str_t() && got.is_str_t()).match ({
        true  => true,
        false => (want.ty_rank() >= 0 && got.ty_rank() >= 0).then({ true }, { want.ty_eq(got) }),
    })
}    // string_* types are one compatible family
cond_numlike = (t: Ty) bool { t.ty_rank() >= 0 || t.is_f64_ty() }
// A value/bool `.match` (and `if` expression) lowers to a ternary Cond at parse time, so its two
// value branches escape the enum-match arm checks above. Their result types must still be C-compatible
// — `c ? A : B` on incompatible types is a hard cc error. A numeric LITERAL branch is polymorphic and
// coerces to any numeric counterpart (mirrors cond_ty's deferral); void/unknown branches stay lenient.
cond_compatible = (d: CondData, tt: Ty, et: Ty) bool {
    d.t.is_lit_numeric().match ({
        true  => et.cond_numlike(),
        false => d.e.is_lit_numeric().then({ tt.cond_numlike() }, { tt.result_compatible(et) }),
    })
}
// ── value-consumed match/cond arms must each yield a value ──────────────────────────────
// A match/cond CONSUMED AS A VALUE (let/assign RHS, return operand, call argument, index-set
// value) must get a value from every arm that doesn't diverge. The arm typing above treats a
// void arm as contributing NO constraint — that leniency exists for DIVERGING arms (a `return`
// tail leaves the fn, so it legitimately yields nothing) and for template residue — but the
// emitter assigns EVERY arm into the value slot (`_out = <arm>` / `c ? a : b`), so a genuinely
// valueless arm reaches cc as `char* _out = (done = true)` — a cc-stage error on a checked
// program — or WORSE compiles silently wrong (`c ? "s" : bool` is only a warning under -w).
// Reject it here (KARMVOID, positioned at the offending arm). Two deliberate scope limits:
//   * only POSITIVE no-value shapes fire — a block ending in a non-expression statement or
//     empty, a `.loop`, a call to a fn DECLARED void — never inference fallbacks (an
//     unresolvable template call also infers void and must stay lenient);
//   * only CONSUMED positions fire — a discarded match (e.g. the tail of a void fn) keeps its
//     mixed side-effect arms, which emit fine as `(c ? f() : ({ }))`.
known_void_call = (env: Env, c: CallData) bool {
    f := env.env_func(c.fn)
    (f.name == c.fn).then({ f.tparams.len == 0 && f.ret.is_void_ty() }, { false })
}
novalue_block_tail = (env: Env, stmts: [Stmt]) i32 {
    (stmts.len == 0).match ({
        true  => 1,
        false => stmts[stmts.len - 1].match ({
            .Return(r)   => 0,    // diverging arm: the one legitimate valueless tail
            .ExprStmt(e) => env.novalue_arm_leaf(e),
            _            => 1,
        }),
    })
}    // a Let/Assign/If/While/IndexSet tail is a statement, never a value
novalue_match_arms = (env: Env, m: MatchData) i32 {
    acc := 0
    m.arms.loop((h, i, ar) {
        acc = acc + env.novalue_arm_leaf(ar.body)
    })
    acc
}
// Early returns inside value-position block arms would be dropped by expression emission.
early_returns = (stmts: [Stmt]) bool {
    found := false
    stmts.loop((h, i, st) {
        found = (i < stmts.len - 1).match ({
            true  => st.match ({
                .Return(r) => true,
                _          => found,
            }),
            false => found,
        })
    })
    found
}
expr_drops_return* = (e: Ptr<Expr>) i32 {
    load(e).match ({
        .Block(b) => b.stmts.early_returns().then({ 1 }, { 0 }),
        _         => 0,
    })
}
// Enum matches must be exhaustive and have no duplicate arms.
no_variants = () [VariantDef] { slice(null_ptr(), 0) }
enum_variants* = (decls: [Decl], ename: string_view) [VariantDef] {
    found := no_variants()
    decls.loop((h, i, d) {
        found = d.match ({
            .DEnum(ed)   => (ed.name == ename).then({ ed.variants }, { found }),
            .DGenEnum(g) => (g.name == ename).then({ g.variants }, { found }),
            _            => found,
        })
    })
    found
}
has_wildcard* = (arms: [ArmData]) bool { arms.slice_any((a) { a.variant == "_" }) }
arm_covers = (arms: [ArmData], vname: string_view) bool {
    arms.slice_any((a) { a.variant == vname })
}
missing_count = (variants: [VariantDef], arms: [ArmData]) i32 {
    n := 0
    variants.loop((h, i, v) {
        n = arms.arm_covers(v.name).then({ n }, { n + 1 })
    })
    n
}
// the NAME of the first declared variant the arms do not cover, else "" — the uncovered
// variant an exhaustiveness diagnostic names so the fix is a copy-pasteable `.Variant => …` arm.
first_missing_variant* = (variants: [VariantDef], arms: [ArmData]) string_view {
    r := ""
    variants.loop((h, i, v) {
        r = (is_empty(r) && arms.arm_covers(v.name) == false).then({ v.name }, { r })
    })
    r
}
dup_before = (arms: [ArmData], vname: string_view, upto: i32) bool {
    f := false
    arms.loop((h, i, a) {
        f = (i < upto && a.variant == vname).then({ true }, { f })
    })
    f
}
dup_arm_errs* = (arms: [ArmData]) i32 {
    n := 0
    arms.loop((h, i, a) {
        n = n + (a.variant == "_").match ({
            true  => 0,
            false => arms.dup_before(a.variant, i).then({ 1 }, { 0 }),
        })
    })
    n
}
// An arm strictly AFTER a wildcard `_` arm can never fire — the emitter's switch stops at the
// default case (gen_switch_arms), so such an arm is silently DROPPED. Report it instead of
// letting code that looks reachable vanish. (A duplicate variant arm — the other never-fires
// shape — is already KDUPVARIANT, whether or not a wildcard is present.)
wildcard_before = (arms: [ArmData], upto: i32) bool {
    f := false
    arms.loop((h, i, a) {
        f = (i < upto && a.variant == "_").then({ true }, { f })
    })
    f
}
unreachable_arm_errs* = (arms: [ArmData]) i32 {
    n := 0
    arms.loop((h, i, a) {
        n = n + arms.wildcard_before(i).then({ 1 }, { 0 })
    })
    n
}
// Reject constructors whose variant is not declared in the linked decl set.
enum_declares = (decls: [Decl], vn: string_view) bool {
    decls.slice_any((d) {
        d.match ({
            .DEnum(ed)   => ed.variants.arm_known(vn),
            .DGenEnum(g) => g.variants.arm_known(vn),
            _            => false,
        })
    })
}
// Every non-wildcard arm must name a declared variant.
arm_known = (vs: [VariantDef], vname: string_view) bool { vs.slice_any((v) { v.name == vname }) }
// Operand checking stays lenient for uninferable operands.
is_arith_op = (op: string_view) bool {
    b := op.at(0)
    b == '+' || b == '-' || b == '*' || b == '/' || b == '%'
}
// Strict comparisons require numeric operands; shifts are separate bitwise ops.
is_cmp_op_v = (op: string_view) bool { op == "<" || op == ">" || op == "<=" || op == ">=" }
is_bitwise_op = (op: string_view) bool {
    op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>"
}
is_bool_ty = (t: Ty) bool {
    t.match ({
        .Bool => true,
        _     => false,
    })
}
non_numeric = (env: Env, e: Ptr<Expr>) bool {
    t := env.infer_expr(e)
    env.unknown_ty(t).match ({
        true  => false,
        false => (t.ty_rank() >= 0).then({ false }, { true }),
    })
}
non_bool = (env: Env, e: Ptr<Expr>) bool {
    t := env.infer_expr(e)
    env.unknown_ty(t).match ({
        true  => false,
        false => t.is_bool_ty().then({ false }, { true }),
    })
}
// f64 operators are strict: no implicit int<->float mixing.
is_eq_op_v = (op: string_view) bool { op == "==" || op == "!=" }
f64_op_ok = (op: string_view) bool {
    op == "+" || op == "-" || op == "*" || op == "/" || op == "/." || op.is_cmp_op_v()
}
f64_side_ok = (env: Env, t: Ty) bool { t.is_f64_ty() || env.unknown_ty(t) }
f64_operand_err = (env: Env, op: string_view, lt: Ty, rt: Ty) i32 {
    (env.f64_side_ok(lt) && env.f64_side_ok(rt) && op.f64_op_ok()).then({ 0 }, { 1 })
}
// Any f64 side routes to the f64 surface; otherwise use integer numeric rules.
num_operand_err = (env: Env, b: BinData) i32 {
    lt := env.infer_expr(b.lhs)
    rt := env.infer_expr(b.rhs)
    (lt.is_f64_ty() || rt.is_f64_ty()).match ({
        true  => env.f64_operand_err(b.op, lt, rt),
        false => (env.non_numeric(b.lhs) || env.non_numeric(b.rhs)).then({ 1 }, { 0 }),
    })
}
same_eq_category = (a: Ty, b: Ty) bool {
    a.ty_rank() >= 0 && b.ty_rank() >= 0
        || a.is_bool_ty() && b.is_bool_ty()
        || a.is_str_t() && b.is_str_t()
        || a.is_ptr_ty() && b.is_ptr_ty()
}
// a NOMINAL ==: an enum (tag compare), a Named non-struct, or a same-type STRUCT value — struct
// `==`/`!=` lowers in resolve (resolve_struct_eq: an `eq` impl method wins, else a derived
// per-field fold). A struct qualifies only when every field is TRANSITIVELY `==`-comparable:
// scalars, strings (__str_eq), bools, ptrs (identity), enums (tag), and nested/generic structs
// recursively. Slice- and fn-typed fields are not (no C `==`, no lowering) — reject the whole
// compare up front with the operand diagnostic instead of leaking a garbled post-resolve error.
// Termination is structural: a struct cannot contain itself by value.
eq_field_ty_ok = (env: Env, t: Ty) bool {
    t.match ({
        .Slice(e)   => false,
        .FnT(f)     => false,
        .Named(n)   => (env.didx.struct_idx.get(n, 0 - 1) < 0).match ({
            true  => true,
            false => env.eq_struct_fields_ok(t),
        }),
        .Generic(g) => (env.didx.genstruct_idx.get(g.name, 0 - 1) < 0).match ({
            true  => true,
            false => env.eq_struct_fields_ok(t),
        }),
        _           => true,
    })
}
eq_struct_fields_ok* = (env: Env, t: Ty) bool {
    ok := true
    reflect_fields(env.a, env.decls, env.didx, t).loop((h, i, f) {
        ok = env.eq_field_ty_ok(f.ty).then({ ok }, { false })
    })
    ok
}
// a type whose impl provides an `eq` method compares via THAT (resolve dispatches to it), so its
// field shapes are irrelevant to acceptance.
eq_impl_provides* = (env: Env, t: Ty) bool {
    tn := t.dispatch_recv_name()
    env.didx.impl_idx.get(tn, 0 - 1) >= 0
        && env.a.dispatch_recv(env.decls, env.didx, "eq", tn) == "eq" == false
}
eq_nominal_ok = (env: Env, a: Ty, b: Ty) bool {
    a.ty_eq(b)
        && a.match ({
            .Named(n)   => (env.didx.struct_idx.get(n, 0 - 1) < 0).match ({
                true  => true,
                false => env.eq_impl_provides(a) || env.eq_struct_fields_ok(a),
            }),
            .Generic(g) => env.env_is_gen_struct(g.name)
                && (env.eq_impl_provides(a) || env.eq_struct_fields_ok(a)),
            _           => false,
        })
}
// Equality rejects f64/non-f64 mixes and heterogeneous comparisons (`"hi" == 5`, `true == 5`).
eq_mix_err = (env: Env, b: BinData) i32 {
    lt := env.infer_expr(b.lhs)
    rt := env.infer_expr(b.rhs)
    (lt.is_f64_ty() || rt.is_f64_ty()).match ({
        true  => (env.f64_side_ok(lt) && env.f64_side_ok(rt)).then({ 0 }, { 1 }),
        false => (env.unknown_ty(lt) || env.unknown_ty(rt)).match ({
            true  => 0,
            false => (lt.same_eq_category(rt) || env.eq_nominal_ok(lt, rt)).then({ 0 }, { 1 }),
        }),
    })
}
// A comparison between a SIGNED int and an UNSIGNED int of rank >= 8 (u16/u32/u64) silently uses C's
// unsigned promotion — `a:i32=-1 < b:u32=1` evaluates FALSE. Reject it. NARROW by design: u8 is
// excluded so byte/char compares (`b == 'a'`) stay fine (u8 always promotes to a signed int safely).
is_signed_int = (t: Ty) bool {
    t.match ({
        .I32      => true,
        .I64      => true,
        .Named(n) => n == "i8" || n == "i16" || n == "i32" || n == "i64",
        _         => false,
    })
}
is_unsigned_wide = (t: Ty) bool {
    t.match ({
        .Named(n) => n == "u16" || n == "u32" || n == "u64",
        _         => false,
    })
}
sign_mismatch = (l: Ty, r: Ty) bool {
    l.is_signed_int() && r.is_unsigned_wide() || l.is_unsigned_wide() && r.is_signed_int()
}
// A numeric LITERAL operand is polymorphic and coerces to the other side's type (`n: u64 < 10` is
// fine), so only flag when BOTH sides are non-literal values of genuinely mismatched signedness.
signcmp_err = (env: Env, b: BinData) i32 {
    ((b.op.is_cmp_op_v() || b.op.is_eq_op_v())
        && b.lhs.is_lit_numeric() == false
        && b.rhs.is_lit_numeric() == false).match ({
        true  => env.infer_expr(b.lhs).sign_mismatch(env.infer_expr(b.rhs)).then({ 1 }, { 0 }),
        false => 0,
    })
}
// Indexing needs a slice and numeric index; uninferable types skip.
is_slice_ty = (t: Ty) bool {
    t.match ({
        .Slice(e) => true,
        _         => false,
    })
}
non_slice = (env: Env, e: Ptr<Expr>) bool {
    t := env.infer_expr(e)
    env.unknown_ty(t).match ({
        true  => false,
        false => t.is_slice_ty().then({ false }, { true }),
    })
}
// A generic type with a `.Void` type-arg (recursing Ptr/Slice/nested generics) — e.g. `Box<void>`
// (see let_needannot_err in the EnvKinds impl below). An unbound tparam survives inference as void,
// so the let's stored (inferred) type becomes Box<void>,
// which only ever lowers to `Box_void`, never a usable value.
ty_has_void_targ = (t: Ty) bool {
    t.match ({
        .Generic(g) => g.args.tys_mention_void(),
        .Ptr(pd)    => load(pd.pointee).is_void_ty() || load(pd.pointee).ty_has_void_targ(),
        // A `[void]` element type means a tparam in element/closure-return position was never
        // inferred (e.g. an unannotated `iter.map` with an untyped lambda). It only lowers to
        // garbage, so demand an annotation instead of silently miscompiling to a `[void]` slice.
        .Slice(e)   => load(e).is_void_ty() || load(e).ty_has_void_targ(),
        _           => false,
    })
}
tys_mention_void = (ts: [Ty]) bool { ts.slice_any((t) { t.is_void_ty() || t.ty_has_void_targ() }) }
// rewrite `Self` to the implementing type throughout a trait method's type (recursing Ptr/Slice).
impl_ty = (tyname: string_view) Ty {
    (tyname == "i32").match ({
        true  => ti32(),
        false => (tyname == "i64").match ({
            true  => ti64(),
            false => (tyname == "u8").match ({
                true  => tu8(),
                false => (tyname == "f64").match ({
                    true  => tf64(),
                    false => (tyname == "bool").match ({
                        true  => tbool(),
                        false => (tyname == "string_view").match ({
                            true  => tstring_view(),
                            false => (tyname == "str").then({ tstring_view() }, { tnamed(tyname) }),
                        }),
                    }),
                }),
            }),
        }),
    })
}
subst_self = (a: MutPtr<Malloc>, t: Ty, tyname: string_view) Ty {
    t.match ({
        .Named(n) => (n == "Self").then({ impl_ty(tyname) }, { t }),
        .Ptr(pd)  => tptr_k(a.tnode(a.subst_self(load(pd.pointee), tyname)), pd.kind),
        .Slice(p) => tslice(a.tnode(a.subst_self(load(p), tyname))),
        _         => t,
    })
}
// each declared param type (Self→tyname) must equal the impl method's, left to right.
params_match = (a: MutPtr<Malloc>, tps: [Ty], ips: [Param], tyname: string_view, i: i32) bool {
    (i == tps.len).match ({
        true  => true,
        false => a.subst_self(tps[i], tyname).ty_eq(ips[i].ty).match ({
            true  => a.params_match(tps, ips, tyname, i + 1),
            false => false,
        }),
    })
}
// the impl method `f` matches the trait's FnT field `fd` (Self→tyname): same arity, param types, ret.
sig_matches = (a: MutPtr<Malloc>, fd: FnTData, f: Func, tyname: string_view) bool {
    (fd.params.len == f.params.len).match ({
        true  => a.params_match(fd.params, f.params, tyname, 0).match ({
            true  => a.subst_self(load(fd.ret), tyname).ty_eq(f.ret),
            false => false,
        }),
        false => false,
    })
}
// does the trait `trname` declare a DEFAULT body for method `m`? (then an impl may OMIT it.)
trait_has_default* = (decls: [Decl], trname: string_view, m: string_view) bool {
    found := false
    decls.loop((h, i, d) {
        found = d.match ({
            .DTraitDefault(td) => (td.trname == trname && td.fn.name == m).then({ true }, { found }),
            _                  => found,
        })
    })
    found
}
// one declared trait field: 0 if it's not a method, or it's provided with a matching signature, or it
// is OMITTED but the trait supplies a default body; 1 if the method is missing (no default) or differs.
// trait conformance: a `Type.impl(Trait)` must DEFINE every method the Trait declares, with a
// MATCHING SIGNATURE. The Trait is a struct whose FnT fields are the method signatures (using `Self`
// for the implementing type); im.methods is the names this impl provides, and the impl's actual
// method bodies are top-level DFuncs found by name. So per declared method: missing → 1 error;
// present but signature-mismatched → 1 error; present and matching → 0. The check is tied to THIS
// impl (im.methods), not a global function search, so an unrelated same-named fn never satisfies it.
method_err* = (a: MutPtr<Malloc>, decls: [Decl], im: ImplData, f: Field) i32 {
    f.ty.match ({
        .FnT(fd) => im.methods.param_names_has(f.name).match ({
            true  => a.sig_matches(fd, decls.the_func(a.impl_cname_in(im.trname, im.ty, f.name)), im.ty).match ({
                true  => 0,
                false => 1,
            }),
            false => decls.trait_has_default(im.trname, f.name).then({ 0 }, { 1 }),
        }),    // omitted: OK iff defaulted
        _        => 0,
    })
}
// a match: exhaustiveness vs duplicate-variant, split out from match_err. The caret points at the
// matched subject (arms carry no source position); the subject bottoms at a Var, which survives resolve.
arms_first_pos* = (arms: [ArmData]) i32 { (arms.len == 0).then({ 0 }, { arms[0].pos }) }
// ── trait-bound enrichment ─────────────────────────────────────────────────────────────────────
// the method names an impl of (type `tn`, trait `tr`) provides; empty when no such impl exists.
impl_methods_of* = (decls: [Decl], tn: string_view, tr: string_view) [Param] {
    found := empty_params()
    decls.loop((h, i, d) {
        found = d.match ({
            .DImpl(im) => (im.ty == tn && im.trname == tr).then({ im.methods }, { found }),
            _          => found,
        })
    })
    found
}
// `/.` is the checker's internal float-division marker; a diagnostic must show the SOURCE operator `/`.
op_display* = (op: string_view) string_view { (op == "/.").then({ "/" }, { op }) }
// ── bounded-generics enforcement over RAW (pre-inline) decls ─────────────────────────────
// Local generic calls are INLINED during resolve_module, so by check_module time the call site is
// gone. This pass therefore runs on the raw, pre-inline decls (like the M5 escape check), walking
// every function body and emitting KTRAITBOUND when a call binds a tparam `A: Trait` to a concrete
// type that does not impl Trait. It reports ONLY this one kind, so an unresolved generic body never
// false-positives the other validation kinds. Imported/foreign generics defer (bound_errs is 0).
kvb_call_kind = (env: Env, c: CallData) i32 {
    env.env_known_fn(c.fn).match ({
        true  => env.bound_errs(env.env_func(c.fn), c).kv_one(KTRAITBOUND()).kv_at(c.pos),
        false => 0,
    })
}
kvb_expr_kind = (env: Env, e: Ptr<Expr>) i32 {
    load(e).match ({
        // `.Call` is where a bound is JUDGED and `.Match` binds an arm pattern into the env; every
        // other shape is a plain structural descent, so it delegates to the one exhaustive child
        // listing. The old hand-written arm list silently omitted `.SliceLit`, `.Lambda` and
        // `.MethodCall`, so `[render(Bad())]` — a bound violation inside a slice literal — passed.
        .Call(c)  => env.kvb_call_kind(c).or(env.kvb_args_kind(c.args)),
        .Match(m) => env.kvb_expr_kind(m.subj).or(env.kvb_arms_kind(env.infer_expr(m.subj), m.arms)),
        _         => 0.expr_fold_children(e, (acc, ch) { acc.or(env.kvb_expr_kind(ch)) }, (acc, body) {
            acc.or(env.a.kvb_body_kind(env, body))
        }),
    })
}
kvb_args_kind = (env: Env, args: [Expr]) i32 {
    acc := 0
    args.loop((h, i, ar) {
        acc = acc.or(env.kvb_expr_kind(ar.addr()))
    })
    acc
}
kvb_inits_kind = (env: Env, inits: [FieldInit]) i32 {
    acc := 0
    inits.loop((h, i, fi) {
        acc = acc.or(env.kvb_expr_kind(fi.value))
    })
    acc
}
kvb_arms_kind = (env: Env, subjty: Ty, arms: [ArmData]) i32 {
    acc := 0
    arms.loop((h, i, ar) {
        acc = acc.or(env.a.arm_env(env, subjty, ar).kvb_expr_kind(ar.body))
    })
    acc
}
kvb_stmt_kind = (a: MutPtr<Malloc>, env: Env, st: Stmt) i32 {
    st.match ({
        .Let(l)      => env.kvb_expr_kind(l.value),
        .Assign(x)   => env.kvb_expr_kind(x.target).or(env.kvb_expr_kind(x.value)),
        .Return(r)   => env.kvb_expr_kind(r),
        .ExprStmt(e) => env.kvb_expr_kind(e),
        .If(f)       => env
            .kvb_expr_kind(f.c)
            .or(a.kvb_body_kind(env, f.then))
            .or(a.kvb_body_kind(env, f.els)),
        .While(w)    => env.kvb_expr_kind(w.c).or(a.kvb_body_kind(env, w.body)),
        .IndexSet(x) => env
            .kvb_expr_kind(x.seq)
            .or(env.kvb_expr_kind(x.idx))
            .or(env.kvb_expr_kind(x.value)),
    })
}
kvb_body_kind = (a: MutPtr<Malloc>, env: Env, body: [Stmt]) i32 {
    acc := 0
    e := env
    body.loop((h, i, st) {
        acc = acc.or(a.kvb_stmt_kind(e, st))
        e = a.extend_env(e, st)
    })
    acc
}
kvb_func_kind* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, f: Func) i32 {
    env := Env(
        vars: a.bind_tparams(a.params_env(f.params), f.tparams),
        decls: decls,
        didx: idx,
        exp: f.ret,
        a: a,
    )
    // bind the CALLER's tparams so a bound targ that resolves to one of them (a generic
    // passthrough — even one shadowing a same-named global type) defers in bound_err.
    a.kvb_body_kind(env, f.body)
}
// the call's full type-arg buffer: an explicit turbofish `<…>` PINS position i; an absent one is
// inferred from the value args (exactly as the resolver's call_targs does) so a closure FnT param
// substitutes to its concrete types for the arity/return check below.
ka_targs = (env: Env, f: Func, args: [Expr], etargs: [Ty]) [Ty] {
    buf := cbuf<Ty>(env.a, f.tparams.len)
    f.tparams.loop((h, i, tp) {
        buf[i] = (i < etargs.len).then({ etargs[i] }, { env.call_targ(f, args, tp.name) })
    })
    buf
}
// a UFCS method call `recv.method(args)` lowers to `method(recv, …args)` — the SAME flat shape the
// resolver's desugar produces. Rebuild the flat arg list here (without mutating the shared raw decls,
// which a later pass still reads in surface form) so the closure/arg checks see the receiver as arg 0.
ka_mcall_args = (a: MutPtr<Malloc>, mc: MethodCallData) [Expr] {
    buf := slice(a.acquire((mc.args.len + 1) * sizeof(Expr)), mc.args.len + 1)
    buf[0] = load(mc.recv)
    mc.args.loop((h, i, ar) {
        buf[i + 1] = mc.args[i]
    })
    buf
}
// (c) explicit-vs-inferred mismatch: with every tparam pinned by turbofish, substitute the bindings into
// each tparam-typed param slot and require the value arg to fit the now-CONCRETE type. A literal flowing
// into an int slot is range-decided (so `id<i32>(5)` still fits); a lambda / still-unknown slot defers.
ka_mismatch_at = (env: Env, tparams: [Param], targs: [Ty], params: [Param], i: i32, ar: Expr) i32 {
    (i < params.len).match ({
        true  => tparams.ty_mentions_tparam(params[i].ty).match ({
            true  => {
                ct := env.a.subst_ty_in(tparams, targs, params[i].ty)
                (env.unknown_ty(ct) || ar.is_ctx_typed_arg() || ct.is_fnt()).match ({
                    true  => 0,
                    false => {
                        lv := ar.addr().lit_slot_verdict(ct)
                        (lv >= 0).then({ lv }, { env.fit_err(env.infer_expr(ar.addr()), ct) })
                    },
                })
            },
            false => 0,
        }),
        false => 0,
    })
}
// (R5) a lambda bound to an FnT parameter: its declared param COUNT must match the FnT's, and — when the
// FnT's concrete (substituted) param/return types are known — the lambda's body value must fit the FnT
// return type. Bind each lambda param to the FnT's substituted param type, then infer the body's value.
ka_lam_params = (a: MutPtr<Malloc>, lmps: [Param], fps: [Ty]) [Param] {
    buf := cbuf<Param>(a, lmps.len)
    lmps.loop((h, i, p) {
        buf[i] = Param(
            name: p.name,
            ty: (i < fps.len).then({ fps[i] }, { tvoid() }),
            variadic: false,
        )
    })
    buf
}
ka_lam_body_ty = (env: Env, lm: LambdaData, fps: [Ty]) Ty {
    (lm.body.len == 0).match ({
        true  => tvoid(),
        false => {
            benv := Env(
                vars: env.a.params_env(env.a.ka_lam_params(lm.params, fps)),
                decls: env.decls,
                didx: env.didx,
                exp: tvoid(),
                a: env.a,
            )
            benv.ka_last_ty(lm.body[lm.body.len - 1])
        },
    })
}
ka_last_ty = (env: Env, st: Stmt) Ty {
    st.match ({
        .ExprStmt(e) => env.infer_expr(e),
        .Return(r)   => env.infer_expr(r),
        _            => tvoid(),
    })
}
// the lambda's body return doesn't fit the FnT's return type — only when both are concrete-known.
ka_lam_ret_err = (env: Env, fd: FnTData, lm: LambdaData, fps: [Ty]) i32 {
    rty := load(fd.ret)
    (env.unknown_ty(rty) || lm.ret.is_void_ty() == false).match ({
        true  => env.unknown_ty(rty).then({ 0 }, { env.fit_err(lm.ret, rty) }),
        false => {
            bty := env.ka_lam_body_ty(lm, fps)
            (bty.is_void_ty() || env.unknown_ty(bty)).then({ 0 }, { env.fit_err(bty, rty) })
        },
    })
}
ka_lambda_at = (
    env: Env,
    ftparams: [Param],
    targs: [Ty],
    params: [Param],
    i: i32,
    ar: Expr,
    cpos: i32,
) i32 {
    ar.match ({
        .Lambda(lm) => (i < params.len).match ({
            true  => env.a.subst_ty_in(ftparams, targs, params[i].ty).match ({
                .FnT(fd) => (fd.params.len == lm.params.len).match ({
                    true  => env.ka_lam_ret_err(fd, lm, fd.params).kv_one(KARGTYPE()).kv_at(cpos),
                    false => KARITY().kv_at(cpos),
                }),
                _        => 0,
            }),
            false => 0,
        }),
        _           => 0,
    })
}
// per-call arg checks: (c) explicit-arg mismatches + (R5) closure arity/return, against the SAME pinned
// type-arg buffer. Run only for a KNOWN local callee whose signature is visible here.
// The explicit-mismatch (c) check fires ONLY when the call carries turbofish `<…>` (the user PINNED the
// bindings, so a contradicting value arg is a real error). A purely-inferred generic call leaves arg
// typing to monomorphization (a bare `.Variant` / cross-enum residue resolves only there). The closure
// arity/return check (R5) runs regardless, since HOF closures rarely carry turbofish.
// A right-arity LOCAL generic call is INLINED during resolve_module, so the post-inline call check
// The ordinary resolved-call path never sees it, so argument-type safety of its CONCRETE slots was
// therefore off for EVERY generic callee (and the whole stdlib threads `MutPtr<A>`, so it is
// generic). Re-arm it HERE, on the pre-inline call site, reusing the SAME arg_err_at the accepted
// non-generic path uses: it skips tparam-mentioning slots (deferred to mono) and checks only the
// concrete ones (`n:i32`, `sep:u8`) via lit_slot_verdict + fit_err — with fit_err's unknown-arg
// leniency intact, so unresolved generic residue never over-rejects. Gated to `tparams.len > 0`:
// a non-generic callee's call survives to the post-inline pass, which already checks it. Gated to
// `authoritative` (fn is NOT also a trait/impl method): `the_func(fn)` returns THE top-level free
// function by name, and UFCS binds its receiver to param 0 (positional), so its concrete slots check
// soundly. But a name that ALSO has an impl method (e.g. `String.impl.append_in(s, a, t)` alongside
// the free `append_in(a, s, t)`) may UFCS-dispatch to the impl by receiver type — then the free-fn
// signature `the_func` returns is the WRONG yardstick, and a positional check would mis-reject a legit
// `s.append_in(mp, t)`. Such dispatched names defer (under-catch), so the check never over-rejects.
ka_concrete_arg_err = (env: Env, authoritative: bool, f: Func, i: i32, ar: Expr, pos: i32) i32 {
    (authoritative && f.tparams.len > 0).match ({
        true  => env
            .arg_err_at(f.tparams, f.params, i, ar)
            .kv_one(KARGTYPE())
            .kv_at(ar.expr_pos().pos_or(pos)),
        false => 0,
    })
}
ka_args_check = (
    env: Env,
    tparams: [Param],
    authoritative: bool,
    f: Func,
    args: [Expr],
    etargs: [Ty],
    pos: i32,
) i32 {
    targs := env.ka_targs(f, args, etargs)
    tf := etargs.len > 0
    acc := 0
    args.loop((h, i, ar) {
        acc = acc
            .or(tf.match ({
                true  => env
                    .ka_mismatch_at(f.tparams, targs, f.params, i, ar)
                    .kv_one(KARGTYPE())
                    .kv_at(ar.expr_pos().pos_or(pos)),
                false => 0,
            }))
            .or(env.ka_lambda_at(f.tparams, targs, f.params, i, ar, pos))
            .or(env.ka_concrete_arg_err(authoritative, f, i, ar, pos))
    })
    acc
}
// the shared call core, driven from both a flat `.Call` and a desugared `.MethodCall`: turbofish checks
// (a/b) + the explicit-arg-mismatch (c) + closure (R5) checks, for a KNOWN local callee — UNLESS the
// name is locally bound (a param/let SHADOWS the same-named top-level fn, so its signature is the
// wrong yardstick here; e.g. a closure param `f` while a top-level `f` exists). Shadowed calls are
// skipped, not re-judged: pre-inline generic bodies can't always type the local (lenient by design).
ka_call_core = (
    env: Env,
    tparams: [Param],
    fn: string_view,
    args: [Expr],
    etargs: [Ty],
    pos: i32,
) i32 {
    (env.env_known_fn(fn) && env.is_local(fn) == false).match ({
        true  => {
            f := env.env_func(fn)
            // `the_func(fn)`'s signature is the authoritative callee only when `fn` is not ALSO a trait/impl
            // method — otherwise UFCS may dispatch to the impl by receiver type, and the free-fn signature
            // is the wrong yardstick for the concrete-arg check (which then defers). (Zen has no free-fn
            // overloading, so a name with no impl method resolves uniquely to this decl.)
            authoritative := env.env_trait_method(fn) == false
            tf := (etargs.len == 0).match ({
                true  => 0,
                false => (f.tparams.len == 0).match ({
                    true  => KNOTYPEARGS().kv_at(pos),
                    false => (etargs.len != f.tparams.len).match ({
                        true  => KTARGARITY().kv_at(pos),
                        false => env
                            .ut_unknown_tys(tparams, etargs)
                            .kv_one(KUNKNOWNTYPE())
                            .kv_at(pos),
                    }),
                }),
            })
            // an explicit `<…>` list must pin EVERY tparam: too many silently drop the extras,
            // too few leave residue mono can only misreport — say the count mismatch here.
            // a fully-pinned turbofish (or inferred bindings) feeds the arg-mismatch + closure checks; an
            // unknown turbofish type short-circuits (the unknown-type error already fired).
            tf.or(env.ka_args_check(tparams, authoritative, f, args, etargs, pos))
        },
        false => 0,
    })
}
ka_expr_kind = (env: Env, tparams: [Param], e: Ptr<Expr>) i32 {
    load(e).match ({
        .Call(c)        => env
            .ka_call_core(tparams, c.fn, c.args, c.targs, c.pos)
            .or(env.ka_args_kind(tparams, c.args)),
        .MethodCall(mc) => {
            cargs := env.a.ka_mcall_args(mc)
            env
                .ka_call_core(tparams, mc.method, cargs, no_tys(), mc.pos)
                .or(env.ka_args_kind(tparams, cargs))
        },
        .Index(ix)      => env.ka_expr_kind(tparams, ix.seq).or(env.ka_expr_kind(tparams, ix.idx)),
        .Bin(b)         => env.ka_expr_kind(tparams, b.lhs).or(env.ka_expr_kind(tparams, b.rhs)),
        .Cond(d)        => env
            .ka_expr_kind(tparams, d.c)
            .or(env.ka_expr_kind(tparams, d.t))
            .or(env.ka_expr_kind(tparams, d.e)),
        .Member(m)      => env.ka_expr_kind(tparams, m.obj),
        .Arrow(ar)      => env.ka_expr_kind(tparams, ar.obj),
        // unreachable-arm judged HERE on the raw arms: a STATEMENT-position match lowers to an
        // if-chain during resolve (lower_match_arms stops at `_`, silently dropping later arms),
        // so the post-inline kv pass never sees them. Purely structural — no typing involved, so
        // an unresolved generic body cannot false-positive.
        .Match(m)       => env
            .ka_expr_kind(tparams, m.subj)
            .or(m.arms
                .unreachable_arm_errs()
                .kv_one(KUNREACHABLEARM())
                .kv_at(load(m.subj).expr_pos().pos_or(m.arms.arms_first_pos())))
            .or(env.ka_arms_kind(tparams, env.infer_expr(m.subj), m.arms)),
        .MakeEnum(mk)   => env.ka_expr_kind(tparams, mk.payload),
        .MakeStruct(sd) => env.ka_inits_kind(tparams, sd.inits),
        .SliceLit(sd)   => env.ka_args_kind(tparams, sd.items),
        .Lambda(lm)     => env.a.ka_body_kind(env, tparams, lm.body),
        .Block(b)       => env.a.ka_body_kind(env, tparams, b.stmts),
        .Loop(l)        => env
            .ka_expr_kind(tparams, l.seq)
            .or(env.a.ka_body_kind(env, tparams, l.body)),
        _               => 0,
    })
}
ka_args_kind = (env: Env, tparams: [Param], args: [Expr]) i32 {
    acc := 0
    args.loop((h, i, ar) {
        acc = acc.or(env.ka_expr_kind(tparams, ar.addr()))
    })
    acc
}
ka_inits_kind = (env: Env, tparams: [Param], inits: [FieldInit]) i32 {
    acc := 0
    inits.loop((h, i, fi) {
        acc = acc.or(env.ka_expr_kind(tparams, fi.value))
    })
    acc
}
ka_arms_kind = (env: Env, tparams: [Param], subjty: Ty, arms: [ArmData]) i32 {
    acc := 0
    arms.loop((h, i, ar) {
        acc = acc.or(env.a.arm_env(env, subjty, ar).ka_expr_kind(tparams, ar.body))
    })
    acc
}
ka_stmt_kind = (a: MutPtr<Malloc>, env: Env, tparams: [Param], st: Stmt) i32 {
    st.match ({
        .Let(l)      => env.ka_expr_kind(tparams, l.value),
        .Assign(x)   => env.ka_expr_kind(tparams, x.target).or(env.ka_expr_kind(tparams, x.value)),
        .Return(r)   => env.ka_expr_kind(tparams, r),
        .ExprStmt(e) => env.ka_expr_kind(tparams, e),
        .If(f)       => env
            .ka_expr_kind(tparams, f.c)
            .or(a.ka_body_kind(env, tparams, f.then))
            .or(a.ka_body_kind(env, tparams, f.els)),
        .While(w)    => env.ka_expr_kind(tparams, w.c).or(a.ka_body_kind(env, tparams, w.body)),
        .IndexSet(x) => env
            .ka_expr_kind(tparams, x.seq)
            .or(env.ka_expr_kind(tparams, x.idx))
            .or(env.ka_expr_kind(tparams, x.value)),
    })
}
ka_body_kind = (a: MutPtr<Malloc>, env: Env, tparams: [Param], body: [Stmt]) i32 {
    acc := 0
    e := env
    body.loop((h, i, st) {
        acc = acc.or(a.ka_stmt_kind(e, tparams, st))
        e = a.extend_env(e, st)
    })
    acc
}
ka_func_kind* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, f: Func) i32 {
    env := Env(
        vars: a.params_env(f.params),
        decls: decls,
        didx: idx,
        exp: f.ret,
        a: a,
    )
    a.ka_body_kind(env, f.tparams, f.body)
}
// inline-only bodies: FnT-param generics (their lambda args must splice) and reflect-using generics
// (their intrinsic needs the call site's concrete receiver type — see check_inline.no_inline_gen_f).
ka_inline_only = (f: Func) bool {
    f.params.has_fnt_param() || f.tparams.len > 0 && f.body.calls_reflect()
}
// the sanctioned reflection WRAPPER (`field_eq<T> = (x: T, y: T) bool { x.field_eq(y) }`) is not
// recursion: its same-named inner call targets the INTRINSIC (name-intercepted in the inliner) and
// never the wrapper itself.
ka_reflect_name = (nm: string_view) bool {
    nm == "field_eq" || nm == "each_field" || nm == "zip_fields" || nm == "variant_name"
}
// ── reflect-return: a `return` under a loop in an inline-only REFLECT generic ─────────────────────
// Splicing such a body leaves a raw C `return` inside the caller's loop — the inliner's early-return
// lift (needs_early_lift) only handles statement-level returns, so the callee's return would exit
// the CALLER (silent wrong control flow). Reject it up front. FnT-param generics share the hazard
// but predate this check and are left as-is (their common bodies pass lambdas onward, not returns).
krr_any_ret_e = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Bin(b)        => b.lhs.krr_any_ret_e() || b.rhs.krr_any_ret_e(),
        .Cond(d)       => d.c.krr_any_ret_e() || d.t.krr_any_ret_e() || d.e.krr_any_ret_e(),
        .Call(c)       => c.args.krr_any_ret_es(),
        .Member(m)     => m.obj.krr_any_ret_e(),
        .Arrow(ar)     => ar.obj.krr_any_ret_e(),
        .MakeEnum(mk)  => mk.payload.krr_any_ret_e(),
        .MakeStruct(s) => s.inits.krr_any_ret_inits(),
        .Match(m)      => m.subj.krr_any_ret_e() || m.arms.krr_any_ret_arms(),
        .Index(ix)     => ix.seq.krr_any_ret_e() || ix.idx.krr_any_ret_e(),
        .SliceLit(sd)  => sd.items.krr_any_ret_es(),
        .Loop(l)       => l.seq.krr_any_ret_e() || l.body.krr_any_ret_body(),
        .Block(bl)     => bl.stmts.krr_any_ret_body(),
        .Lambda(la)    => la.body.krr_any_ret_body(),
        _              => false,
    })
}
krr_any_ret_es = (xs: [Expr]) bool { xs.slice_any((x) { x.addr().krr_any_ret_e() }) }
krr_any_ret_inits = (inits: [FieldInit]) bool { inits.slice_any((fi) { fi.value.krr_any_ret_e() }) }
krr_any_ret_arms = (arms: [ArmData]) bool { arms.slice_any((ar) { ar.body.krr_any_ret_e() }) }
krr_any_ret_stmt = (st: Stmt) bool {
    st.match ({
        .Let(l)      => l.value.krr_any_ret_e(),
        .Assign(x)   => x.target.krr_any_ret_e() || x.value.krr_any_ret_e(),
        .Return(r)   => true,
        .ExprStmt(e) => e.krr_any_ret_e(),
        .If(f)       => f.c.krr_any_ret_e() || f.then.krr_any_ret_body() || f.els.krr_any_ret_body(),
        .While(w)    => w.c.krr_any_ret_e() || w.body.krr_any_ret_body(),
        .IndexSet(x) => x.seq.krr_any_ret_e() || x.idx.krr_any_ret_e() || x.value.krr_any_ret_e(),
    })
}
krr_any_ret_body = (body: [Stmt]) bool { body.slice_any((st) { st.krr_any_ret_stmt() }) }
// does the body hold a Loop/While whose body (or a lambda spliced under it) contains a return?
krr_loop_ret_e = (e: Ptr<Expr>) bool {
    load(e).match ({
        .Loop(l)       => l.body.krr_any_ret_body() || l.seq.krr_loop_ret_e(),
        .Bin(b)        => b.lhs.krr_loop_ret_e() || b.rhs.krr_loop_ret_e(),
        .Cond(d)       => d.c.krr_loop_ret_e() || d.t.krr_loop_ret_e() || d.e.krr_loop_ret_e(),
        .Call(c)       => c.args.krr_loop_ret_es(),
        .Member(m)     => m.obj.krr_loop_ret_e(),
        .Arrow(ar)     => ar.obj.krr_loop_ret_e(),
        .MakeEnum(mk)  => mk.payload.krr_loop_ret_e(),
        .MakeStruct(s) => s.inits.krr_loop_ret_inits(),
        .Match(m)      => m.subj.krr_loop_ret_e() || m.arms.krr_loop_ret_arms(),
        .Index(ix)     => ix.seq.krr_loop_ret_e() || ix.idx.krr_loop_ret_e(),
        .SliceLit(sd)  => sd.items.krr_loop_ret_es(),
        .Block(bl)     => bl.stmts.krr_loop_ret_body(),
        .Lambda(la)    => la.body.krr_loop_ret_body(),
        _              => false,
    })
}
krr_loop_ret_es = (xs: [Expr]) bool { xs.slice_any((x) { x.addr().krr_loop_ret_e() }) }
krr_loop_ret_inits = (inits: [FieldInit]) bool {
    inits.slice_any((fi) { fi.value.krr_loop_ret_e() })
}
krr_loop_ret_arms = (arms: [ArmData]) bool { arms.slice_any((ar) { ar.body.krr_loop_ret_e() }) }
krr_loop_ret_stmt = (st: Stmt) bool {
    st.match ({
        .Let(l)      => l.value.krr_loop_ret_e(),
        .Assign(x)   => x.target.krr_loop_ret_e() || x.value.krr_loop_ret_e(),
        .Return(r)   => r.krr_loop_ret_e(),
        .ExprStmt(e) => e.krr_loop_ret_e(),
        .If(f)       => f.c.krr_loop_ret_e()
            || f.then.krr_loop_ret_body()
            || f.els.krr_loop_ret_body(),
        .While(w)    => w.body.krr_any_ret_body() || w.c.krr_loop_ret_e(),
        .IndexSet(x) => x.seq.krr_loop_ret_e() || x.idx.krr_loop_ret_e() || x.value.krr_loop_ret_e(),
    })
}
krr_loop_ret_body = (body: [Stmt]) bool { body.slice_any((st) { st.krr_loop_ret_stmt() }) }
// ── reflect-write: an ASSIGNMENT through a TEMP-BOUND reflection subject ──────────────────────────
// The inliner binds a non-Var reflection subject to a hidden temp ONCE (subst.refl_needs_bind — so
// a side-effecting receiver evaluates once); an enclosing reflection lambda's VALUE param becomes a
// member place at expansion, hence ALSO non-Var when it is the inner subject. If the call's lambda
// then assigns its value param, those field writes land on the discarded temp — the program
// compiles and runs but silently drops the writes (#587). Reject it up front, pointed at the call.
// `ps` = the innermost enclosing reflection lambda's params ([] at fn top level); a subject naming
// one of its VALUE params (index >= 1) is bound; any non-Var subject is bound. A subject copied to
// a genuine local first (`leaf := fv`) is a plain Var — spliced unbound, its writes stick — which
// is the sanctioned shape (std.format.serde's jr_obj2).
krw_refl_shape = (c: CallData) bool {
    c.fn == "each_field" && c.args.len == 2 || c.fn == "zip_fields" && c.args.len == 3
}
krw_value_param = (ps: [Param], nm: string_view) bool {
    f := false
    ps.loop((h, i, p) {
        f = (i >= 1 && p.name == nm).then({ true }, { f })
    })
    f
}
krw_subject_bound = (e: Ptr<Expr>, ps: [Param]) bool {
    load(e).match ({
        .Var(v) => ps.krw_value_param(v.name),
        _       => true,
    })
}
krw_call = (c: CallData, ps: [Param]) i32 {
    nsub := (c.fn == "each_field").then({ 1 }, { 2 })
    bound := false
    c.args.loop((h, i, x) {
        bound = (i < to_i64(nsub) && x.addr().krw_subject_bound(ps)).then({ true }, { bound })
    })
    (bound && c.args[c.args.len - 1].wr_lam_writes_value()).match ({
        true  => KREFLECTWRITE().kv_at(c.pos),
        false => 0,
    })
}
krw_e = (e: Ptr<Expr>, ps: [Param]) i32 {
    load(e).match ({
        .Bin(b)        => b.lhs.krw_e(ps).or(b.rhs.krw_e(ps)),
        .Cond(d)       => d.c.krw_e(ps).or(d.t.krw_e(ps)).or(d.e.krw_e(ps)),
        .Call(c)       => c.krw_refl_shape().match ({
            true  => c
                .krw_call(ps)
                .or(c.args[c.args.len - 1].match ({
                    .Lambda(la) => la.body.krw_body(la.params),
                    _           => 0,
                }))
                .or(c.args.krw_subj_es(c.args.len - 1, ps)),
            false => c.args.krw_subj_es(c.args.len, ps),
        }),
        .Member(m)     => m.obj.krw_e(ps),
        .Arrow(ar)     => ar.obj.krw_e(ps),
        .MakeEnum(mk)  => mk.payload.krw_e(ps),
        .MakeStruct(s) => {
            acc := 0
            s.inits.loop((h, i, fi) {
                acc = acc.or(fi.value.krw_e(ps))
            })
            acc
        },
        .Match(m)      => {
            acc := m.subj.krw_e(ps)
            m.arms.loop((h, i, ar) {
                acc = acc.or(ar.body.krw_e(ps))
            })
            acc
        },
        .Index(ix)     => ix.seq.krw_e(ps).or(ix.idx.krw_e(ps)),
        .SliceLit(sd)  => sd.items.krw_subj_es(sd.items.len, ps),
        .Loop(l)       => l.seq.krw_e(ps).or(l.body.krw_body(ps)),
        .Block(bl)     => bl.stmts.krw_body(ps),
        .Lambda(la)    => la.body.krw_body(ps),
        _              => 0,
    })
}
// walk the first n exprs of xs (a reflection call's SUBJECT args; the lambda arg is walked
// separately with ITS params as the bound set).
krw_subj_es = (xs: [Expr], n: i64, ps: [Param]) i32 {
    acc := 0
    xs.loop((h, i, x) {
        acc = (i < n).then({ acc.or(x.addr().krw_e(ps)) }, { acc })
    })
    acc
}
krw_stmt = (st: Stmt, ps: [Param]) i32 {
    st.match ({
        .Let(l)      => l.value.krw_e(ps),
        .Assign(x)   => x.target.krw_e(ps).or(x.value.krw_e(ps)),
        .Return(r)   => r.krw_e(ps),
        .ExprStmt(e) => e.krw_e(ps),
        .If(f)       => f.c.krw_e(ps).or(f.then.krw_body(ps)).or(f.els.krw_body(ps)),
        .While(w)    => w.c.krw_e(ps).or(w.body.krw_body(ps)),
        .IndexSet(x) => x.seq.krw_e(ps).or(x.idx.krw_e(ps)).or(x.value.krw_e(ps)),
    })
}
krw_body = (body: [Stmt], ps: [Param]) i32 {
    acc := 0
    body.loop((h, i, st) {
        acc = acc.or(st.krw_stmt(ps))
    })
    acc
}
ko_is_or_mcall = (mc: MethodCallData) bool { mc.method == "or_return" && mc.args.len == 0 }
// the enclosing fn's ret and the receiver both need an `Err` payload, and the two must agree.
// The `Ok` payloads are POSITION-dependent (`cnd` = conditionally-evaluated position):
//   - UNCONDITIONAL positions (direct let value, call/ctor args, mid-chain receivers, match
//     subjects, non-shortcircuit operands, …) hoist to a statement-level let whose lowering
//     REBUILDS the Err return as the enclosing fn's Result (orret_err_value in compiler.check), so
//     the receiver's Ok payload is unconstrained — it is consumed locally, only E must line up.
//   - CONDITIONAL positions (`&&`/`||` right operands, cond/match branch values, while-loop
//     conditions, lambda/loop/value-block bodies) lower in place with the receiver returned
//     VERBATIM (their local expected type is not the fn's return type, so the rebuild can't fire):
//     there the receiver's whole Result type must still be the enclosing fn's (a `Result<bool, E>`
//     receiver in a `Result<i32, E>` fn emits `return <Result_bool_E>` and dies at cc in positions
//     the return-fit scan never reaches — #377's miscompile).
// A tparam-typed / unknown side defers (concrete only after monomorphization).
ko_at = (env: Env, tps: [Param], want: Ty, recv: Ptr<Expr>, cnd: bool, pos: i32) i32 {
    (tps.ty_mentions_tparam(want) || env.unknown_ty(want)).match ({
        true  => 0,
        false => {
            fE := env.subj_variant_payload(want, "Err")
            fE.is_void_ty().match ({
                true  => KORRETURN().kv_at(pos),
                false => {
                    rt := env.infer_expr(recv)
                    (rt.is_void_ty() || env.unknown_ty(rt) || tps.ty_mentions_tparam(rt)).match ({
                        true  => 0,
                        false => {
                            rE := env.subj_variant_payload(rt, "Err")
                            (rE.is_void_ty()
                                || env.unknown_ty(rE)
                                || env.unknown_ty(fE)
                                || tps.ty_mentions_tparam(rE)
                                || tps.ty_mentions_tparam(fE)).match ({
                                true  => 0,
                                false => (fE.ty_eq(rE) || rE.ty_eq(fE)).match ({
                                    true  => cnd.then({ env.ko_ok_at(tps, want, rt, pos) }, { 0 }),
                                    false => KORRETURN().kv_at(pos),
                                }),
                            })
                        },
                    })
                },
            })
        },
    })
}
// the Ok side of the same judgment (CONDITIONAL positions only), entered once both Err payloads are
// known and agree. Same leniency: an unknown / tparam-typed / payloadless (void) Ok side defers.
ko_ok_at = (env: Env, tps: [Param], want: Ty, rt: Ty, pos: i32) i32 {
    fO := env.subj_variant_payload(want, "Ok")
    rO := env.subj_variant_payload(rt, "Ok")
    (fO.is_void_ty()
        || rO.is_void_ty()
        || env.unknown_ty(fO)
        || env.unknown_ty(rO)
        || tps.ty_mentions_tparam(fO)
        || tps.ty_mentions_tparam(rO)).match ({
        true  => 0,
        false => (fO.ty_eq(rO) || rO.ty_eq(fO)).then({ 0 }, { KORRETURN().kv_at(pos) }),
    })
}
ko_call_kind = (env: Env, tps: [Param], want: Ty, c: CallData, cnd: bool) i32 {
    own := is_or_return_fn(c).then({ env.ko_at(tps, want, c.args[0].addr(), cnd, c.pos) }, { 0 })
    own.or(env.ko_args_kind(tps, want, c.args, cnd))
}
ko_mcall_kind = (env: Env, tps: [Param], want: Ty, mc: MethodCallData, cnd: bool) i32 {
    own := ko_is_or_mcall(mc).then({ env.ko_at(tps, want, mc.recv, cnd, mc.pos) }, { 0 })
    own.or(env.ko_expr_kind(tps, want, mc.recv, cnd)).or(env.ko_args_kind(tps, want, mc.args, cnd))
}
// `cnd` marks descent into a CONDITIONALLY-evaluated / value-block position (see ko_at): those
// or_returns lower in place (verbatim receiver return), so the strict full-Result check applies.
// It is set on entry and never cleared — a statement nested under a conditional value is still
// conditional. `&&`/`||` LEFT operands and cond/match SUBJECTS evaluate unconditionally and hoist,
// so they inherit.
ko_expr_kind = (env: Env, tps: [Param], want: Ty, e: Ptr<Expr>, cnd: bool) i32 {
    load(e).match ({
        .Call(c)        => env.ko_call_kind(tps, want, c, cnd),
        .MethodCall(mc) => env.ko_mcall_kind(tps, want, mc, cnd),
        .Index(ix)      => env
            .ko_expr_kind(tps, want, ix.seq, cnd)
            .or(env.ko_expr_kind(tps, want, ix.idx, cnd)),
        .Bin(b)         => env
            .ko_expr_kind(tps, want, b.lhs, cnd)
            .or(env.ko_expr_kind(tps, want, b.rhs, is_logic_op(b.op) || cnd)),
        .Cond(d)        => env
            .ko_expr_kind(tps, want, d.c, cnd)
            .or(env.ko_expr_kind(tps, want, d.t, true))
            .or(env.ko_expr_kind(tps, want, d.e, true)),
        .Member(m)      => env.ko_expr_kind(tps, want, m.obj, cnd),
        .Arrow(ar)      => env.ko_expr_kind(tps, want, ar.obj, cnd),
        .Match(m)       => env
            .ko_expr_kind(tps, want, m.subj, cnd)
            .or(env.ko_arms_kind(tps, want, env.infer_expr(m.subj), m.arms)),
        .MakeEnum(mk)   => env.ko_expr_kind(tps, want, mk.payload, cnd),
        .MakeStruct(sd) => env.ko_inits_kind(tps, want, sd.inits, cnd),
        .SliceLit(sd)   => env.ko_args_kind(tps, want, sd.items, cnd),
        .Lambda(lm)     => env.a.ko_body_kind(env, tps, want, lm.body, true),
        .Block(b)       => env.a.ko_body_kind(env, tps, want, b.stmts, true),
        .Loop(l)        => env
            .ko_expr_kind(tps, want, l.seq, cnd)
            .or(env.a.ko_body_kind(env, tps, want, l.body, true)),
        _               => 0,
    })
}
ko_args_kind = (env: Env, tps: [Param], want: Ty, args: [Expr], cnd: bool) i32 {
    acc := 0
    args.loop((h, i, ar) {
        acc = acc.or(env.ko_expr_kind(tps, want, args[i].addr(), cnd))
    })
    acc
}
ko_inits_kind = (env: Env, tps: [Param], want: Ty, inits: [FieldInit], cnd: bool) i32 {
    acc := 0
    inits.loop((h, i, fi) {
        acc = acc.or(env.ko_expr_kind(tps, want, fi.value, cnd))
    })
    acc
}
// Arm bodies are always conditional (only the selected arm evaluates), and a statement-position
// match resolves its arms under a cleared expected type, so the rebuild cannot fire there either.
ko_arms_kind = (env: Env, tps: [Param], want: Ty, subjty: Ty, arms: [ArmData]) i32 {
    acc := 0
    arms.loop((h, i, ar) {
        acc = acc.or(env.a.arm_env(env, subjty, ar).ko_expr_kind(tps, want, ar.body, true))
    })
    acc
}
ko_stmt_kind = (a: MutPtr<Malloc>, env: Env, tps: [Param], want: Ty, st: Stmt, cnd: bool) i32 {
    st.match ({
        .Let(l)      => env.ko_expr_kind(tps, want, l.value, cnd),
        .Assign(x)   => env
            .ko_expr_kind(tps, want, x.target, cnd)
            .or(env.ko_expr_kind(tps, want, x.value, cnd)),
        .Return(r)   => env.ko_expr_kind(tps, want, r, cnd),
        .ExprStmt(e) => env.ko_expr_kind(tps, want, e, cnd),
        .If(f)       => env
            .ko_expr_kind(tps, want, f.c, cnd)
            .or(a.ko_body_kind(env, tps, want, f.then, cnd))
            .or(a.ko_body_kind(env, tps, want, f.els, cnd)),
        .While(w)    => env
            .ko_expr_kind(tps, want, w.c, true)
            .or(a.ko_body_kind(env, tps, want, w.body, cnd)),
        .IndexSet(x) => env
            .ko_expr_kind(tps, want, x.seq, cnd)
            .or(env.ko_expr_kind(tps, want, x.idx, cnd))
            .or(env.ko_expr_kind(tps, want, x.value, cnd)),
    })
}
ko_body_kind = (a: MutPtr<Malloc>, env: Env, tps: [Param], want: Ty, body: [Stmt], cnd: bool) i32 {
    acc := 0
    e := env
    body.loop((h, i, st) {
        acc = acc.or(a.ko_stmt_kind(e, tps, want, st, cnd))
        e = a.extend_env(e, st)
    })
    acc
}
ko_func_kind* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, f: Func) i32 {
    env := Env(
        vars: a.params_env(f.params),
        decls: decls,
        didx: idx,
        exp: f.ret,
        a: a,
    )
    a.ko_body_kind(env, f.tparams, f.ret, f.body, false)
}
// `.or_return()` in a GLOBAL initializer has NO enclosing function to return the Err to: the lowered
// early-return would silently abort `zen__init_globals` mid-way, leaving every later global
// zero-initialized (no diagnostic, wrong exit values). Walk the initializer with a non-Result `want`
// (i32) so ANY or_return inside it reports KORRETURN at its own position — the same "no matching
// Result to propagate into" judgment the fn-body walk makes, with nothing lenient to defer to.
ko_global_kind* = (a: MutPtr<Malloc>, decls: [Decl], idx: DeclIndex, g: GlobalData) i32 {
    env := Env(
        vars: a.params_env(empty_params()),
        decls: decls,
        didx: idx,
        exp: tvoid(),
        a: a,
    )
    is_expr_null(g.init).then({ 0 }, { env.ko_expr_kind(empty_params(), ti32(), g.init, false) })
}
// ── error[ffi-type]: FFI-safety of FOREIGN (bodyless) declarations ─────────────────────────────────
// A bodyless `name = (params) Ret` decl IS a raw platform prototype (genc emits a bare C prototype;
// js lowers it to a browser call), so every param/return type must have a shape the emitter's
// platform contract actually represents. The permitted set is derived from the tree's own foreign
// surface (std.c.libc, std.mem.alloc, std.{os,net,time,math,platform}, std.concurrent.{pool,
// coroutine}, std.web.dom) and verified against genc's lowering (cname_write):
//   • builtin scalars   I32/I64/U8/F64/Bool → int32_t/int64_t/uint8_t/double/bool
//   • width primitives  Named i8/i16/u16/u32/u64/f32 → the C fixed-width types
//   • strings           string_view/string_cstr/string_literal → const char*
//   • pointers          RawPtr/Ptr/MutPtr<T> ALL lower to a plain C `T*` (any pointee)
//   • fn pointers       FnT lowers to the single `void(*)(void)` typedef — a plain C function
//                       pointer (pthread_create's start routine, dom's event callbacks); its own
//                       signature must recurse FFI-safe
//   • flat structs      a declared struct whose fields are ALL FFI-safe is a by-value C struct
//                       (std.web.dom's opaque `{ handle: RawPtr<u8> }` interface handles)
//   • generic instances a CONCRETE instantiation of a declared generic with FFI-safe args emits a
//                       concrete monomorphized struct (std.web.dom returns Opt<Node>/Opt<string_view>)
//   • void              the return slot
// REJECTED: type parameters on the decl (one foreign symbol cannot have per-instantiation ABI),
// slices `[T]` (the zslice fat pointer is Zen-internal — no hand-written C in the tree receives one;
// buffers cross the boundary as RawPtr + length, the libc.zen convention), concrete enums (tag+union
// layout is a Zen-internal contract), and any undeclared/unknown named type.
ffi_ty_ok = (env: Env, t: Ty, depth: i64) bool {
    (depth <= 0).then({
        return false
    })
    t.match ({
        .Slice(e)   => false,
        .FnT(ft)    => env.ffi_tys_ok(ft.params, depth - 1)
            && env.ffi_ty_ok(load(ft.ret), depth - 1),
        .Named(n)   => is_prim_width(n)
            || env.env_is_struct(n) && env.ffi_fields_ok(env.env_struct_fields(n), depth - 1),
        .Generic(g) => (env.env_is_gen_struct(g.name) || env.env_is_gen_enum(g.name))
            && env.ffi_tys_ok(g.args, depth - 1),
        _           => true,
    })
}    // I32/I64/U8/F64/Bool/Void/string_*/Ptr(any kind) — direct C shapes
ffi_tys_ok = (env: Env, ts: [Ty], depth: i64) bool {
    ok := true
    ts.loop((h, i, t) {
        ok = env.ffi_ty_ok(t, depth) && ok
    })
    ok
}
ffi_fields_ok = (env: Env, fs: [Field], depth: i64) bool {
    ok := true
    fs.loop((h, i, f) {
        ok = env.ffi_ty_ok(f.ty, depth) && ok
    })
    ok
}
FFI_DEPTH = () i64 { 8 }
// 0/1 count predicates feeding kv_one, mirroring ut_unknown_ty's shape.
ffi_bad_ty = (env: Env, t: Ty) i32 { env.ffi_ty_ok(t, FFI_DEPTH()).then({ 0 }, { 1 }) }
ffi_bad_generic = (f: Func) i32 { (f.tparams.len > 0).then({ 1 }, { 0 }) }
// the NAME walk (same traversal order as the kind walk): the message naming the offending
// parameter/return type, in user spelling.
ffi_param_msg = (
    a: MutPtr<Malloc>,
    fname: string_view,
    pname: string_view,
    tname: string_view,
) string_view {
    a
        .gstr_string(96)
        .gstr_append(a, "foreign declaration `")
        .gstr_append(a, fname)
        .gstr_append(a, "`: parameter `")
        .gstr_append(a, pname)
        .gstr_append(a, "` has non-FFI-safe type `")
        .gstr_append(a, tname)
        .gstr_append(a, "`")
        .gstr_finish(a)
}
ffi_ret_msg = (a: MutPtr<Malloc>, fname: string_view, tname: string_view) string_view {
    a
        .gstr_string(96)
        .gstr_append(a, "foreign declaration `")
        .gstr_append(a, fname)
        .gstr_append(a, "`: return type `")
        .gstr_append(a, tname)
        .gstr_append(a, "` is not FFI-safe")
        .gstr_finish(a)
}
ffi_generic_msg = (a: MutPtr<Malloc>, fname: string_view) string_view {
    a
        .gstr_string(96)
        .gstr_append(a, "foreign declaration `")
        .gstr_append(a, fname)
        .gstr_append(a, "` declares type parameters — a foreign symbol binds ONE concrete C signature")
        .gstr_finish(a)
}
ffi_func_msg* = (a: MutPtr<Malloc>, env: Env, f: Func) string_view {
    (f.tparams.len > 0).then({
        return a.ffi_generic_msg(f.name)
    })
    r := ""
    f.params.loop((h, i, p) {
        r = desc_or(r, env.ffi_ty_ok(p.ty, FFI_DEPTH()).match ({
            true  => "",
            false => a.ffi_param_msg(f.name, p.name, a.zty(p.ty)),
        }))
    })
    desc_or(r, env.ffi_ty_ok(f.ret, FFI_DEPTH()).match ({
        true  => "",
        false => a.ffi_ret_msg(f.name, a.zty(f.ret)),
    }))
}
kdiag_buf* = (a: MutPtr<Malloc>) [i32] { slice(a.acquire(KDIAG_CAP() * sizeof(i32)), KDIAG_CAP()) }
// already collected? (dedup: two channels can position the same packed kind at one site)
kdiag_seen = (buf: [i32], cnt: i32, packed: i32) bool {
    found := false
    buf.loop((h, i, e) {
        found = (i < cnt).match ({
            true  => (e == packed).then({ true }, { found }),
            false => found,
        })
    })
    found
}
// append `packed` unless it is 0 (no error), a duplicate, or the buffer is full; return the new count.
kdiag_add* = (buf: [i32], cnt: i32, packed: i32) i32 {
    (packed == 0 || cnt >= buf.len || buf.kdiag_seen(cnt, packed)).match ({
        true  => cnt,
        false => {
            buf[cnt] = packed
            cnt + 1
        },
    })
}
// the __syntax_error sentinel carries the failing token's byte offset in its Int init value (0 = none);
// the Int passes through resolve unchanged (`_ => e`), so the offset survives to this post-resolve pass.
kparse_off = (init: Ptr<Expr>) i32 {
    load(init).match ({
        .Int(n) => n.to_i32(),
        _       => 0,
    })
}
// a NEGATIVE sentinel offset (parse.fill_decls) marks the variant-break split: the failing token is
// the `.` of a newline+`.Uppercase` statement break, so report the rule (KVBREAK) at that dot.
kparse_kind = (init: Ptr<Expr>) i32 {
    off := init.kparse_off()
    (off < 0).then({ KVBREAK().kv_at(0 - off) }, { KPARSE().ksent_at(off) })
}
// A sentinel's Int init uses 0 for "no offset was recorded" (compiler.parse_type's parse_err_off),
// so — unlike an AST pos, where byte 0 is real (kv_at) — a 0 here means the diagnostic has NO caret.
ksent_at = (k: i32, off: i32) i32 { (off == 0).then({ k }, { k.kv_at(off) }) }
// the `__bad_binding` sentinel: a malformed top-level `=` binding, caret at its RHS offset (always ≥ 0).
kbadbind_kind = (init: Ptr<Expr>) i32 { KBADBIND().ksent_at(init.kparse_off()) }
// the `__misordered_generic` sentinel: a `Name<T>*:` head, caret at the `<` offset (always ≥ 0).
kmisgen_kind = (init: Ptr<Expr>) i32 { KMISGEN().ksent_at(init.kparse_off()) }
// the `__capacity` sentinel: a fixed-capacity compiler registry overflowed (no meaningful caret — the
// offense is program SIZE, not a token; the sentinel's offset is 0).
kcapacity_kind = (init: Ptr<Expr>) i32 { KCAPACITY().ksent_at(init.kparse_off()) }
// the PARSE TAXONOMY sentinels (compiler.parse.sentinel_name): each names what the parser EXPECTED
// where it failed, so the diagnostic says WHAT is wrong, not only where. All carry a real caret pos.
taxonomy_kind = (nm: string_view, init: Ptr<Expr>) i32 {
    (nm == "__unclosed_block").then({
        return KUNCLOSED().ksent_at(init.kparse_off())
    })
    (nm == "__expected_arrow").then({
        return KEXPECTARROW().ksent_at(init.kparse_off())
    })
    (nm == "__expected_expr").then({
        return KEXPECTEXPR().ksent_at(init.kparse_off())
    })
    (nm == "__expected_decl").then({
        return KEXPECTDECL().ksent_at(init.kparse_off())
    })
    (nm == "__expected_init").then({
        return KEXPECTINIT().ksent_at(init.kparse_off())
    })
    (nm == "__unexpected_eof").then({
        return KEOFINPUT().ksent_at(init.kparse_off())
    })
    0
}
// packed kind for whichever parse sentinel a top-level DGlobal is (0 if it is an ordinary global).
parse_sentinel_kind* = (nm: string_view, init: Ptr<Expr>) i32 {
    (nm == "__syntax_error").match ({
        true  => init.kparse_kind(),
        false => (nm == "__bad_binding").match ({
            true  => init.kbadbind_kind(),
            false => (nm == "__misordered_generic").match ({
                true  => init.kmisgen_kind(),
                false => (nm == "__capacity").match ({
                    true  => init.kcapacity_kind(),
                    false => nm.taxonomy_kind(init),
                }),
            }),
        }),
    })
}
// ── cross-module linking (Goal Arc 1) ───────────────────────────────────────────────
// The self-hosted "module loader". A module's HEADER is its public surface reduced to signatures:
// every function becomes a bodyless DForeign (structs/enums pass through). Checking a file against
// another module's header puts the imported names in `the_func`'s reach, so a cross-module call is
// arity/arg-type-checked exactly like a local one — while the header's bodyless sigs are never
// re-checked (check_module only descends DFunc bodies). A name imported but absent from the header
// stays known-but-unchecked (the #204 DImport path), so partial headers never false-reject.
as_sig* = (a: MutPtr<Malloc>, d: Decl) Decl {
    d.match ({
        .DFunc(f) => dforeign(Func(
            name: f.name,
            params: f.params,
            ret: f.ret,
            tparams: f.tparams,
            body: no_stmts(),
        )),
        _         => d,
    })
}
// the message/element type carried by an actor handle: `CellRef<M>` / `ActorCell<M>` / `ActorHandle<M,_>`
// / `ReplyRef<M>` (possibly behind a pointer) → M (its first type arg). tvoid when the target has no
// concrete generic head (a pre-inline tparam handle) — the caller then falls back to the payload
// expression's own inferred type, so nothing is over-rejected.
first_gen_arg* = (t: Ty) Ty {
    t.match ({
        .Generic(g) => (g.args.len > 0).then({ g.args[0] }, { tvoid() }),
        .Ptr(pd)    => load(pd.pointee).first_gen_arg(),
        _           => tvoid(),
    })
}
// ── per-node kind checks as Env METHODS ──────────────────────────────────────────────────────────
// The util.zen EnvQuery pattern at scale: every Env-first validator here is a method on Env via an
// out-of-module trait impl, so callers (core.zen's kv_* walk, enrich.zen, …) dispatch
// `env.operand_err(b)` through the global impl index and import NOTHING from this module for them.
EnvKinds: {
    trait_recv_missing: (Self, CallData) bool,
    match_result_ty: (Self, Ty, [ArmData]) Ty,
    cond_result_err: (Self, CondData) i32,
    cond_bool_err: (Self, CondData) i32,
    arm_result_err: (Self, Ty, Ty, ArmData) i32,
    novalue_arm_leaf: (Self, Ptr<Expr>) i32,
    value_void_arm_err: (Self, Ty, Ptr<Expr>) i32,
    call_void_arm_errs: (Self, CallData) i32,
    exhaustive_err: (Self, MatchData) i32,
    mkenum_err: (Self, string_view, string_view) i32,
    enum_payload_err: (Self, MakeEnumData) i32,
    unknown_arm_errs: (Self, MatchData) i32,
    operand_err: (Self, BinData) i32,
    index_err: (Self, IndexData) i32,
    ret_err: (Self, Ptr<Expr>) i32,
    assign_err: (Self, AssignData) i32,
    assign_ptr_write_err: (Self, AssignData) i32,
    idxset_ptr_write_err: (Self, IndexSetData) i32,
    idxset_err: (Self, IndexSetData) i32,
    let_fit_err: (Self, LetData) i32,
    let_needannot_err: (Self, LetData) i32,
    undef_is_method: (Self, CallData) bool,
    ffi_func_kind: (Self, Func) i32,
    bound_err: (Self, Func, CallData, Param) i32,
}
Env.impl(EnvKinds, {
    trait_recv_missing = (env: Env, c: CallData) bool {
        // A trait-method call whose CONCRETE receiver type implements no matching impl (dispatch finds no
        // redirect) and that is neither a free function nor an imported name — would emit a bare `area`
        // call and fail at the C linker. Reject it as a Zen receiver/trait-bound error instead.
        (c.args.len > 0
            && env.env_trait_method(c.fn)
            && env.env_imported(c.fn) == false
            && env.env_known_fn(c.fn) == false).match ({
            true  => env.dispatch_name(c) == c.fn
                && env.unknown_ty(env.infer_expr(c.args[0].addr())) == false,
            false => false,
        })
    }
    match_result_ty = (env: Env, subjty: Ty, arms: [ArmData]) Ty {
        out := tvoid()
        arms.loop((h, i, ar) {
            aenv := env.a.arm_env(env, subjty, ar)
            got := aenv.infer_expr(ar.body)
            out = out.is_void_ty().match ({
                true  => (got.is_void_ty() || aenv.unknown_ty(got)).then({ out }, { got }),
                false => out,
            })
        })
        out
    }
    cond_result_err = (env: Env, d: CondData) i32 {
        tt := env.infer_expr(d.t)
        et := env.infer_expr(d.e)
        (tt.is_void_ty() || et.is_void_ty() || env.unknown_ty(tt) || env.unknown_ty(et)).match ({
            true  => 0,
            false => d.cond_compatible(tt, et).then({ 0 }, { 1 }),
        })
    }
    cond_bool_err = (env: Env, d: CondData) i32 {
        // The condition of a `?:` / boolean `.match` must be bool. One deliberate exemption: a bare
        // `Int(1)` condition is the parser's own always-true test for a non-terminal `_` wildcard arm
        // in a lowered literal match, so it stays accepted.
        load(d.c).match ({
            .Int(n) => (n == 1).then({ 0 }, { 1 }),
            _       => env.non_bool(d.c).then({ 1 }, { 0 }),
        })
    }
    arm_result_err = (env: Env, subjty: Ty, want: Ty, ar: ArmData) i32 {
        aenv := env.a.arm_env(env, subjty, ar)
        got := aenv.infer_expr(ar.body)
        (want.is_void_ty() || got.is_void_ty() || aenv.unknown_ty(want) || aenv.unknown_ty(got)).match ({
            true  => 0,
            false => want.result_compatible(got).then({ 0 }, { 1 }),
        })
    }
    novalue_arm_leaf = (env: Env, e: Ptr<Expr>) i32 {
        load(e).match ({
            .Block(b) => env.novalue_block_tail(b.stmts),
            .Cond(d)  => env.novalue_arm_leaf(d.t) + env.novalue_arm_leaf(d.e),
            .Match(m) => env.novalue_match_arms(m),
            .Loop(l)  => 1,    // `.loop` never yields a value
            .Call(c)  => env.known_void_call(c).then({ 1 }, { 0 }),
            _         => 0,
        })
    }
    value_void_arm_err = (env: Env, want: Ty, e: Ptr<Expr>) i32 {
        (want.is_void_ty() || env.unknown_ty(want)).match ({
            true  => 0,
            false => load(e).match ({
                .Match(m) => env.novalue_match_arms(m),
                .Cond(d)  => env.novalue_arm_leaf(d.t) + env.novalue_arm_leaf(d.e),
                _         => 0,
            }),
        })
    }
    call_void_arm_errs = (env: Env, c: CallData) i32 {
        // argument position: a match/cond arg flowing into a CONCRETE (non-tparam) param slot.
        f := env.env_func(c.fn)
        acc := 0
        (f.name == c.fn).then({
            c.args.loop((h, i, ar) {
                acc = acc + (i < f.params.len).match ({
                    true  => f.tparams.ty_mentions_tparam(f.params[i].ty).match ({
                        true  => 0,
                        false => env.value_void_arm_err(f.params[i].ty, ar.addr()),
                    }),
                    false => 0,
                })
            })
        })
        acc
    }
    exhaustive_err = (env: Env, m: MatchData) i32 {
        vs := env.decls.enum_variants(m.ename)
        (vs.len == 0).match ({
            true  => 0,
            false => (vs.missing_count(m.arms) > 0).then({ 1 }, { 0 }),
        })
    }
    mkenum_err = (env: Env, ty: string_view, variant: string_view) i32 {
        // Unknown enum ctor: bare `.Variant` (empty ty) must name SOME declared variant; qualified
        // `Color.Purple` / `Result.Bogus` (non-empty ty) must name a variant OF THAT enum. Previously the
        // qualified branch always returned 0, so `Color.Purple` passed check and ICEd at cc.
        is_empty(ty).match ({
            true  => env.decls.enum_declares(variant).then({ 0 }, { 1 }),
            false => {
                vs := env.decls.enum_variants(ty)
                (vs.len == 0).match ({
                    true  => 0,
                    false => vs.arm_known(variant).then({ 0 }, { 1 }),
                })
            },
        })
    }
    enum_payload_err = (env: Env, mk: MakeEnumData) i32 {
        // A constructed enum payload must fit the variant's declared payload type (`E.A("s")` where A(i32)).
        // Inferred-enum form (empty ty) and tparam/unknown/void payloads stay lenient — generic variants like
        // Result.Ok(x) resolve their payload type only after mono, so subj_variant_payload yields a tparam there.
        is_empty(mk.ty).match ({
            true  => 0,
            false => {
                pty := env.subj_variant_payload(tnamed(mk.ty), mk.variant)
                lv := mk.payload.lit_slot_verdict(pty)
                (lv >= 0).match ({
                    true  => lv,
                    false => {
                        vt := env.infer_expr(mk.payload)
                        (pty.is_void_ty() || env.unknown_ty(pty) || env.unknown_ty(vt)).match ({
                            true  => 0,
                            false => vt.fits(pty).then({ 0 }, { 1 }),
                        })
                    },
                })
            },
        })
    }
    unknown_arm_errs = (env: Env, m: MatchData) i32 {
        vs := env.decls.enum_variants(m.ename)
        n := 0
        (vs.len == 0).match ({
            true  => 0,
            false => {
                m.arms.loop((h, i, a) {
                    n = n + (a.variant == "_").match ({
                        true  => 0,
                        false => vs.arm_known(a.variant).then({ 0 }, { 1 }),
                    })
                })
                n
            },
        })
    }
    operand_err = (env: Env, b: BinData) i32 {
        b.op.is_logic_op().match ({
            true  => (env.non_bool(b.lhs) || env.non_bool(b.rhs)).then({ 1 }, { 0 }),
            false => (b.op.is_arith_op() || b.op.is_bitwise_op() || b.op.is_cmp_op_v()).match ({
                true  => env.num_operand_err(b) + env.signcmp_err(b),
                false => b.op.is_eq_op_v().then({ env.eq_mix_err(b) + env.signcmp_err(b) }, { 0 }),
            }),
        })
    }
    index_err = (env: Env, ix: IndexData) i32 {
        (env.non_slice(ix.seq) || env.non_numeric(ix.idx)).then({ 1 }, { 0 })
    }
    ret_err = (env: Env, r: Ptr<Expr>) i32 {
        // Return/assign/index-set checks only reject concrete mismatches. A function-VALUE return
        // (declared return is a function type) is accepted structurally — ty_eq treats FnT as
        // never-equal so fits() can't validate it; C checks the fn-ptr type (M1c).
        rt := env.infer_expr(r)
        lv := r.lit_slot_verdict(env.exp)    // a numeric literal return is decided by range
        (lv >= 0).match ({
            true  => lv,
            false => (env.unknown_ty(rt) || env.unknown_ty(env.exp) || env.exp.is_fnt()).match ({
                true  => 0,
                false => rt.fits(env.exp).then({ 0 }, { 1 }),
            }),
        })
    }
    assign_err = (env: Env, x: AssignData) i32 {
        vt := env.infer_expr(x.target)
        rt := env.infer_expr(x.value)
        lv := x.value.lit_slot_verdict(vt)
        (lv >= 0).match ({
            true  => lv,
            false => (env.unknown_ty(vt) || env.unknown_ty(rt)).match ({
                true  => 0,
                false => rt.fits(vt).then({ 0 }, { 1 }),
            }),
        })
    }
    assign_ptr_write_err = (env: Env, x: AssignData) i32 {
        // Stage 2 mutability, the field-write half: `b.v = …` where `b: Ptr<Box>` (read-only) writes through a
        // non-writable pointer — the same hole `store()` guards, via Assign/Member. A `MutPtr<Box>` permits it
        // (k_mut_ptr), and plain local/struct mutation (no pointer base) is untouched. A NESTED write
        // (`b.inner.v = …`, `b.data[0] = …`) is the same hole one level down: it mutates `*b` just as the
        // direct field-set does, so walk the lvalue's member/index chain to its root and reject if the write
        // ultimately passes through a read-only `Ptr<T>`.
        env.lvalue_writes_readonly(x.target).then({ 1 }, { 0 })
    }
    idxset_ptr_write_err = (env: Env, x: IndexSetData) i32 {
        // the index-set half of the read-only-pointer write guard: `b.data[0] = …` writes into `*b`.
        env.write_thru_readonly(x.seq).then({ 1 }, { 0 })
    }
    idxset_err = (env: Env, x: IndexSetData) i32 {
        rt := env.infer_expr(x.value)
        lv := x.value.lit_slot_verdict(x.elem)
        (lv >= 0).match ({
            true  => lv,
            false => (env.unknown_ty(rt) || env.unknown_ty(x.elem)).match ({
                true  => 0,
                false => rt.fits(x.elem).then({ 0 }, { 1 }),
            }),
        })
    }
    let_fit_err = (env: Env, l: LetData) i32 {
        // Annotated lets must fit their declared type; unannotated lets are inferred only.
        l.ty.is_void_ty().match ({
            true  => 0,
            false => {
                // infer under the DECLARED type as expected context, exactly as resolve_let resolves the
                // value — a generic call whose tparam sits only in return position (`a.nbuf("", n)` for a
                // `[string_view]` let) binds it from the declaration, not from the weak literal fallback.
                vt := env.with_exp(l.ty).infer_expr(l.value)
                lv := l.value.lit_slot_verdict(l.ty)
                (lv >= 0).match ({
                    true  => lv,
                    false => (env.unknown_ty(vt) || env.unknown_ty(l.ty)).match ({
                        true  => 0,
                        false => vt.fits(l.ty).then({ 0 }, { 1 }),
                    }),
                })
            },
        })
    }
    let_needannot_err = (env: Env, l: LetData) i32 {
        // A let (post-resolve, ty = the inferred/declared type) whose stored type is a generic with an
        // uninferred tparam (`empty<T> = (k: i32) Box<T>` then `m := empty(7)` → Box<void> → mono emits
        // `Box_void`). check used to pass; require an annotation so the tparam is pinned.
        l.ty.ty_has_void_targ().then({ 1 }, { 0 })
    }
    undef_is_method = (env: Env, c: CallData) bool {
        // an undefined call reads as a `recv.method()` UFCS call — not a bare undefined name — when it has a
        // first argument whose inferred type is a DECLARED struct/enum (a genuine concrete receiver). A
        // numeric/str/unknown first arg or a zero-arg call stays a plain undefined name. An AMBIGUOUS UFCS
        // call (2+ `alias__fn` candidates match the receiver) keeps the plain-undefined channel so its more
        // specific `ambiguous method` enrichment still fires — this is a NO-method case only.
        (c.args.len == 0).match ({
            true  => false,
            false => {
                rty := env.infer_expr(c.args[0].addr())
                tn := rty.recv_name()
                (is_empty(tn) || env.env_is_struct(tn) == false && env.env_is_enum(tn) == false).match ({
                    true  => false,
                    false => env.alias_ufcs_candidates(c, rty).count < 2,
                })
            },
        })
    }
    ffi_func_kind = (env: Env, f: Func) i32 {
        // the kind walk: first offending foreign decl, caret on the decl (a Ty carries no source position).
        acc := f.ffi_bad_generic().kv_one(KFFITYPE()).kv_at(f.pos)
        f.params.loop((h, i, p) {
            acc = acc.or(env.ffi_bad_ty(p.ty).kv_one(KFFITYPE()).kv_at(f.pos))
        })
        acc.or(env.ffi_bad_ty(f.ret).kv_one(KFFITYPE()).kv_at(f.pos))
    }
    bound_err = (env: Env, f: Func, c: CallData, tp: Param) i32 {
        tr := tp.tparam_bound()
        is_empty(tr).match ({
            true  => 0,
            false => {
                tn := env.call_targ(f, c.args, tp.name).recv_name()    // unbounded tparam: nothing to check
                // concrete type A binds to
                (is_empty(tn)
                    || env.vars.tparam_declared(tn)
                    || env.bound_targ_concrete(tn) == false).match ({
                    true  => 0,
                    false => env.decls.type_impls_trait(tn, tr).then({ 0 }, { 1 }),
                })
            },
        })
    }
})    // unresolved / abstract: defer
// Func-receiver kind checks (`f.ka_rec_hof_kind()` call shape) get the same treatment on Func.
FuncKinds: {
    ka_rec_hof_kind: (Self) i32,
    ka_reflect_ret_kind: (Self) i32,
    ka_reflect_write_kind: (Self) i32,
}
Func.impl(FuncKinds, {
    ka_rec_hof_kind = (f: Func) i32 {
        (f.ka_inline_only()
            && f.body.len > 0
            && f.params.param_names_has(f.name) == false
            && ka_reflect_name(f.name) == false
            && f.body.rc_calls_body(f.name)).match ({
            true  => KRECHOF().kv_at(f.pos),
            false => 0,
        })
    }
    ka_reflect_ret_kind = (f: Func) i32 {
        (f.tparams.len > 0 && f.body.calls_reflect() && f.body.krr_loop_ret_body()).match ({
            true  => KREFLECTRETURN().kv_at(f.pos),
            false => 0,
        })
    }
    ka_reflect_write_kind = (f: Func) i32 {
        (f.tparams.len > 0 && f.body.calls_reflect()).match ({
            true  => f.body.krw_body(empty_params()),
            false => 0,
        })
    }
})
