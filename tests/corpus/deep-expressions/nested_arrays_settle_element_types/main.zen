// AN ARRAY LITERAL INSIDE AN ARRAY LITERAL, FOUR LEVELS DEEP, kept
// strictly RECTANGULAR: every level's element type is settled by its
// POSITION -- [[[i32, 2], 2], 3] holds pairs-of-pairs -- so a backend
// that settles an inner level to the wrong type (or flattens nesting
// into one flat array) produces either invalid C or wrong numbers.
// Indexing then walks back in through all four levels, and a generic
// function receives one whole nested literal as an argument, so every
// boundary (literal -> parameter -> index) must agree on the shape.
//
//   grid[2][2][1] = 44 -- the deepest single read
//   fold = 15 + 5 + 1 + 35 + 3 = 59
//
// plausible wrong answers: 4 (one level flattened), 44 read from the
// wrong sub-array, 0 (index applied to the wrong slot).

deep_take = <T>(t: T) usize { 1 }

main = (env: Env) Res<i32, AllocError> {
    grid ::= [
        [[5, 6], [7, 8], [9, 10]],
        [[25, 26], [27, 28], [29, 30]],
        [[33, 34], [35, 36], [43, 44]],
    ];

    a ::= grid[0][0][0];
    b ::= grid[2][2][1];
    c ::= grid[1][1][0];
    d ::= grid[0][2][1];

    deep ::= [
        [[1, 2], [3, 4]],
        [[5, 15], [25, 35]],
    ];
    e    ::= deep[1][0][1];
    f    ::= deep[1][0][0];
    g    ::= deep[0][0][0];
    h    ::= deep[1][1][1];

    pair_of_grids ::= [[1, 2], [3, 4]];
    i             ::= pair_of_grids[1][0];

    println("picked {} {} {} {}", a, b, c, d);
    println("fold {}", e + f + g + h + i);
    println("levels {}", deep_take(grid));
    Ok(0);
}
