// tests/must-fail/traps/literal_too_large_in_an_array_element.zen
// AN ELEMENT IS A LITERAL'S POSITION TOO. `[u8, 3]` is what says the
// elements are `u8`, and `assignable` lets an `int` literal reach every
// integer type — right about the family, never about the value — so
// without a range check here the 300 wraps to 44 with nothing said.
//
// The written form `[u8, 3](1, 2, 300)` has been checked since
// `fixed_array_type` landed; this is the form that takes its type from
// the position instead of from beside the values.
Error = Overflow | DivideByZero | OutOfBounds

main = (env: Env) Res<i32, Error> {
    xs: [u8, 3] = [1, 2, 300];
    println("{}", xs[2]);
    Ok(0);
}
