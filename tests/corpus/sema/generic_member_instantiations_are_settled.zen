// An explicit impl-supplied specialization retains its concrete parameter and
// return type through semantic analysis and generated C.

Chooser = {
    choose* ::= <T>(self: @Self, value: T) T
}

Tool = {}

Tool.impl(Chooser, {
    choose = <T>(self: @Self, value: T) T { value }
})

main = (env: Env) Res<i32, AllocError> {
    explicit: i64 = Tool().choose<i64>(41);
    println("{}", explicit);
    Ok(0);
}
