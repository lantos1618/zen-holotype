// src/gen/gen_c/gen_c_build.zen
// `Point(x: 3, y: 4)` — what a callee that names a TYPE is.
//
// `gen_c_call.zen` opens by saying the two are one node: "`Point(x: 3,
// y: 4)` and `area(p)` are the same AST node. Which one it is depends
// on what the callee NAMES — a struct is constructed, a function is
// called — and that is a question about the declaration rather than
// about the call." That question is asked there and answered here, and
// the two are separate files because building a value and calling a
// function have nothing in common past the node they share.
//
// A C COMPOUND LITERAL WITH ONE DESIGNATED INITIALISER PER ARGUMENT.
// Designators rather than positions because Zen's construction form is
// `name: value` and the field order in the emitted struct is the
// declaration's — writing positions would tie the two together for no
// gain.
//
// WHAT IS BEING BUILT IS SEMA'S ANSWER FOR THIS NODE, and the
// declaration alone is the fallback: `Box<i32>(held: 7)` writes its
// argument outright and only the node knows it.

Ast, Expr, ExprKind, ExprId, Decl, DeclKind, Struct, Member, MemberKind = ast
Function, Literal, LiteralKind, Access, Call, Arg, Span, Ident = ast
Param, TypeId = ast
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
DeclId = sema.sema_id
TyId, Ty, Types, TyNamed, TyRes, ResForm, is_prim = sema.sema_ty
World, Def, DefKind, decl_at = sema.sema_def
Checker, Ctx = sema.sema_check
Inst, tparam_vars = sema.sema_inst
type_of, type_from_ast = sema.sema_type
sym_member = gen.gen_name
GenFault = gen.gen_diag
CBackend = gen.gen_c.gen_c_state
unsupported, unresolved, untyped = gen.gen_c.gen_c_report
open, constructed, recv_inst, intern_named = gen.gen_c.gen_c_mono
unify, arg_type, enter_tparams, leave_tparams = gen.gen_c.gen_c_mono
ctype, is_unit, field_type, request_type = gen.gen_c.gen_c_type
expr, ty_of = gen.gen_c.gen_c_expr
is_pure_value = gen.gen_c.gen_c_const

// -----------------------------------------------------------------
// construction
//
// A C compound literal with one designated initialiser per argument.
// Designators rather than positions because Zen's construction form is
// `name: value` and the field order in the emitted struct is the
// declaration's — writing positions would tie the two together for no
// gain.
// -----------------------------------------------------------------

construct* = (be :: CBackend, id: ExprId, c: Call, d: Def, ctx: Ctx,
             out :: String) Res<(), AllocError> {
    ty = construct_type(be, id, d, ctx).try();
    request_type(be, ty).try();
    decl_at(be.tree, d.id).match({
        None  => unsupported(be, id, "a construction of an unknown type", out),
        Ok(x) => construct_decl(be, id, c, x, d, ty, ctx, out),
    })
}

// WHAT IS BEING BUILT IS SEMA'S ANSWER FOR THIS NODE. `Box<i32>(held: 7)`
// writes its argument outright and only the node knows it — the
// declaration alone says `Box<T>`, which is what `constructed` can
// derive and why it is the FALLBACK and not the answer. Sema records
// the written arguments at the call; this reads them back, exactly as
// `chosen_def` reads back which declaration the call meant.
construct_type = (be :: CBackend, id: ExprId, d: Def, ctx: Ctx)
                 Res<TyId, AllocError> {
    unknown = be.check.types.unknown().try();
    got = ty_of(be, id, ctx, unknown).try();
    be.check.is_unknown(got).match({
        false => Ok(got),
        true  => constructed(be, d),
    })
}

construct_decl = (be :: CBackend, id: ExprId, c: Call, x: Decl, d: Def,
                  ty: TyId, ctx: Ctx, out :: String) Res<(), AllocError> {
    x.kind.match({
        Struct(s) => construct_struct(be, id, c, s, d, ty, ctx, out),
        _         => unsupported(be, id, "a construction of a non-struct", out),
    })
}

// A GENERIC TYPE IS CONSTRUCTED AT ITS ARGUMENTS, not refused: `Vec(..)`
// inside `Vec<T>`'s own constructor builds the `Vec<i32>` this emission
// is at. What is still refused is a construction whose arguments nothing
// settled, because a bare `Vec` has no layout to write.
construct_struct = (be :: CBackend, id: ExprId, c: Call, s: Struct,
                    d: Def, ty: TyId, ctx: Ctx, out :: String)
                   Res<(), AllocError> {
    named = prim_named(be, s, ty).try();
    built = settle_construction(be, c, s, d, named, ctx).try();
    layout_open(be, s, d, built).try().match({
        true  => unsupported(be, id, "a construction whose type arguments nothing settles", out),
        false => write_literal(be, c, s, d, built, ctx, out),
    })
}

// WHAT A CONSTRUCTION'S TYPE ARGUMENTS ARE, when nothing else said.
//
// `Entry(hash: h, key: key, value: value)` inside `Map<K, V>` builds an
// `Entry<K, V>`, and the only thing that says so is the ARGUMENTS: sema
// records a construction's type under the node, but only inside a body
// it CHECKED, and it checks top-level declarations only. So each
// argument is matched against the field it supplies — structurally, and
// the enclosing emission has already said what `K` and `V` are.
settle_construction = (be :: CBackend, c: Call, s: Struct, d: Def,
                       ty: TyId, ctx: Ctx) Res<TyId, AllocError> {
    open(be, ty).match({
        false => Ok(ty),
        true  => inferred_construction(be, c, s, d, ty, ctx),
    })
}

inferred_construction = (be :: CBackend, c: Call, s: Struct, d: Def,
                         ty: TyId, ctx: Ctx) Res<TyId, AllocError> {
    dctx = decl_ctx_of(be, d);
    mark = enter_tparams(be, s.tparams, d.qname).try();
    empty ::= be.alloc.Inst();
    found ::= be.alloc.Inst();
    c.args.loop((h, i, a) {
        unify_field(be, a, i, s, empty, dctx, ctx, found).try();
    });
    leave_tparams(be, mark).try();
    rebuilt_type(be, d, s, found, ty)
}

unify_field = (be :: CBackend, a: Arg, i: usize, s: Struct, empty: Inst,
               dctx: Ctx, ctx: Ctx, out :: Inst) Res<(), AllocError> {
    name = field_name(be, a, i, s, empty, dctx).try();
    declared = storage_type(be, s, name, empty, dctx);
    unknown = be.check.types.unknown().try();
    actual = arg_type(be, a.value, ctx, unknown).try();
    unify(be, declared, actual, out)
}

// Every parameter in declaration order, or the type UNCHANGED when the
// arguments left one unsaid — the caller refuses with a position, which
// is better than a layout invented here.
rebuilt_type = (be :: CBackend, d: Def, s: Struct, found: Inst, ty: TyId)
               Res<TyId, AllocError> {
    vars ::= be.alloc.Vec<TyId>();
    tparam_vars(be.check, s.tparams, d.qname, vars).try();
    args ::= be.alloc.Vec<TyId>();
    vars.loop((h, v) { keep_arg(found, v, args).try() });
    (args.len == vars.len).match({
        false => Ok(ty),
        true  => intern_named(be.check, d, args),
    })
}

keep_arg = (found: Inst, v: TyId, out :: Vec<TyId>) Res<(), AllocError> {
    found.lookup(v).match({
        None  => Ok(()),
        Ok(t) => out.add(t),
    })
}

// "A PRELUDE DECLARATION OF A PRIMITIVE'S NAME IS THAT PRIMITIVE."
// `text_str.zen` declares `str` with a `data` and a `len`, and the C
// type behind it is the runtime floor's `zg_str` — every string
// literal, every `zg_print_str` and every C caller already agrees on
// that spelling. So `str(data: .., len: ..)` builds the PRIMITIVE, at
// both ends: the compound literal's type, and each designator.
prim_named = (be :: CBackend, s: Struct, ty: TyId) Res<TyId, AllocError> {
    is_prim(s.name.text).match({
        false => Ok(ty),
        true  => be.check.types.prim(s.name.text),
    })
}

// The floor's own member names for a primitive's fields, the mangler's
// for everything else — the same rule `gen_c_expr.field_name` reads a
// field back through.
designator = (be :: CBackend, ty: TyId, name: str, out :: String)
             Res<(), AllocError> {
    is_prim_ty(be, ty).match({
        true  => out.add_bytes(name),
        false => out.sym_member(name),
    })
}

is_prim_ty = (be :: CBackend, ty: TyId) bool {
    be.check.types.at(ty).match({ Prim(_) => true, _ => false })
}

// A TYPE ARGUMENT NO STORAGE MEMBER READS DOES NOT CHANGE THE LAYOUT,
// so leaving it free is not a refusal. `Range(0, 5)` leaves `T` free —
// `start` and `end` are `usize` and `at` is a bodiless hook occupying no
// bytes — and `Range(0, v.len)` is std's own ordinary way to walk an
// index space. Asking the question of the type's ARGUMENTS made every
// one of those unwritable; asking it of its STORAGE is the same question
// about the thing that is actually being emitted.
//
// Two open `Range`s mangle alike, which is exactly right here and would
// not be for a `Box<T>`: `held: T` is storage, so `Box` still refuses.
// THE STRUCT'S OWN PARAMETERS GO BACK IN SCOPE FOR THE READ, and they
// have to: `Entry<K, V>` and `Map<K, V>` spell their parameters alike,
// and a construction of one INSIDE the other resolved `K` to the
// enclosing declaration's `Var` — a different type of the same name, so
// the substitution missed and every `Map` in the language was refused.
// The declaration that introduced the name is the one that binds it.
layout_open = (be :: CBackend, s: Struct, d: Def, ty: TyId)
              Res<bool, AllocError> {
    dctx = decl_ctx_of(be, d);
    dinst = recv_inst(be, ty).try();
    mark = enter_tparams(be, s.tparams, d.qname).try();
    got ::= false;
    s.members.loop((h, m) {
        field_type(be, m, dctx, dinst).match({
            None    => (),
            Ok(fty) => open(be, fty).then(() { got = true; }),
        });
    });
    leave_tparams(be, mark).try();
    Ok(got);
}

// A CONSTRUCTION WITH NO ARGUMENTS STILL HAS DEFAULTS TO WRITE, which
// is why there is no shortcut here for the empty argument list. `{0}`
// was that shortcut, and it is what made `Cursor()` come back zeroed
// on a struct whose every field declared a value.
write_literal = (be :: CBackend, c: Call, s: Struct, d: Def, ty: TyId,
                 ctx: Ctx, out :: String) Res<(), AllocError> {
    out.add_bytes("(").try();
    ctype(be, ty, out).try();
    out.add_bytes(")").try();
    write_initialisers(be, c, s, d, ty, ctx, out).try();
    Ok(());
}

write_initialisers = (be :: CBackend, c: Call, s: Struct, d: Def,
                      ty: TyId, ctx: Ctx, out :: String)
                     Res<(), AllocError> {
    dctx = decl_ctx_of(be, d);
    mark = enter_tparams(be, s.tparams, d.qname).try();
    // the CONSTRUCTED type's own arguments: `Box<i32>(held: 7)` supplies
    // an `i32`, and reading the field's declared `T` without them would
    // give the literal no width to take.
    dinst = recv_inst(be, ty).try();
    out.add_bytes("{ ").try();
    // The count of initialisers WRITTEN, not the argument index, because
    // an argument that supplies no field writes none and a comma keyed
    // to `i` would then open or close the list on nothing.
    seen ::= 0;
    c.args.loop((h, i, a) {
        seen = seen + supplied_initialiser(be, a, i, s, ty, dinst, dctx,
                                           ctx, seen, out).try();
    });
    seen = seen + defaulted_initialisers(be, c, s, ty, dinst, dctx, seen,
                                         out).try();
    // Every argument named a field the struct does not declare, so none
    // was written — and an EMPTY brace list is a GNU extension, not C99.
    (seen == 0).then(() { out.add_bytes("0").try() });
    out.add_bytes(" }").try();
    leave_tparams(be, mark).try();
    Ok(());
}

// -----------------------------------------------------------------
// defaults
//
// "`= default` makes a field optional at construction" — so a field
// the call omitted is not absent, it is the value its DECLARATION
// wrote. Both back ends built the list out of the arguments alone and
// left the rest to C's `{0}`, which is a different value in every case
// but the one the whole tree happens to use: every default in std is
// already a zero, so nothing here could notice.
//
// WRITTEN IN THE DECLARING MODULE'S CONTEXT and not the call's. The
// expression came from the struct's own body and names what that
// module can see; read at the call site a default like `Pos(line: 1,
// col: 1)` resolves against whatever `Pos` the caller imported, or
// against nothing at all.
//
// APPENDED AFTER THE ARGUMENTS rather than merged into declaration
// order. C99 6.7.8 lets designators come in any order, and appending
// is what keeps every construction in the language that has no
// defaults emitting the byte-identical C it emitted before.
// -----------------------------------------------------------------

defaulted_initialisers = (be :: CBackend, c: Call, s: Struct, ty: TyId,
                          dinst: Inst, dctx: Ctx, seen: usize,
                          out :: String) Res<usize, AllocError> {
    wrote ::= 0;
    s.members.loop((h, m) {
        wrote = wrote + default_initialiser(be, c, m, s, ty, dinst, dctx,
                                            seen + wrote, out).try();
    });
    Ok(wrote);
}

default_initialiser = (be :: CBackend, c: Call, m: Member, s: Struct,
                       ty: TyId, dinst: Inst, dctx: Ctx, seen: usize,
                       out :: String) Res<usize, AllocError> {
    name = member_text(m);
    (is_storage(be, m, dinst, dctx) && !supplies(be, c, s, name, dinst, dctx))
        .match({
            false => Ok(0),
            true  => member_default(be, m, name, s, ty, dinst, dctx, seen, out),
        })
}

// The value a member declares, when it declares one that can be
// written here. `is_pure_value` is the same gate a constant read is
// held to, and for the same reason: this expression is emitted at
// every construction site, so it must name no function and read no
// frame. A default that is not one is left to the zeroing it already
// got — `Vec`'s `data :: Ptr<T> = null_ptr<T>()` is the only shape in
// the tree that reaches it, and a null pointer is what zeroing gives.
member_default = (be :: CBackend, m: Member, name: str, s: Struct,
                  ty: TyId, dinst: Inst, dctx: Ctx, seen: usize,
                  out :: String) Res<usize, AllocError> {
    declared_value(m).match({
        None  => Ok(0),
        Ok(v) => pure_default(be, v, name, s, ty, dinst, dctx, seen, out),
    })
}

pure_default = (be :: CBackend, v: ExprId, name: str, s: Struct, ty: TyId,
                dinst: Inst, dctx: Ctx, seen: usize, out :: String)
               Res<usize, AllocError> {
    is_pure_value(be, v, dctx).match({
        false => Ok(0),
        true  => write_default(be, v, name, s, ty, dinst, dctx, seen, out),
    })
}

write_default = (be :: CBackend, v: ExprId, name: str, s: Struct, ty: TyId,
                 dinst: Inst, dctx: Ctx, seen: usize, out :: String)
                Res<usize, AllocError> {
    (seen > 0).then(() { out.add_bytes(", ").try() });
    out.add_bytes(".").try();
    designator(be, ty, name, out).try();
    out.add_bytes(" = ").try();
    expr(be, v, dctx, storage_type(be, s, name, dinst, dctx), out).try();
    Ok(1);
}

// A member's written value, whichever of the two member forms holds
// it. `Const` cannot reach here — a constant is not storage — but the
// two nodes carry the same field and asking both is what keeps this
// from depending on that.
declared_value = (m: Member) Res<ExprId> {
    m.kind.match({
        Field(f) => f.value,
        Const(k) => k.value,
        _        => None,
    })
}

// Did the call supply this field? Under the SAME name rule the
// argument walk used: a named argument names it, and a positional one
// takes the i-th storage member. Asked here rather than remembered
// from the walk because a `Vec<str>` cannot be read back.
supplies = (be :: CBackend, c: Call, s: Struct, name: str, dinst: Inst,
            dctx: Ctx) bool {
    got ::= false;
    c.args.loop((h, i, a) {
        arg_supplies(be, a, i, s, name, dinst, dctx).then(() { got = true; });
    });
    got
}

arg_supplies = (be :: CBackend, a: Arg, i: usize, s: Struct, name: str,
                dinst: Inst, dctx: Ctx) bool {
    field_name(be, a, i, s, dinst, dctx).match({
        Err(_) => false,
        Ok(n)  => n.eq(name),
    })
}

// AN ARGUMENT THAT NAMES NO STORAGE MEMBER SUPPLIES NOTHING, and writing
// a designator for it is worse than dropping it: C has no `.bogus` on a
// struct that does not declare one, so `Param(.., value: None)` against a
// `Param` with no `value` came out as a C error about a member the author
// never wrote — or, when the value was a bare `None`, as `codegen has no
// type for None`, because the field lookup that would have supplied the
// expected type found nothing. The bootstrapper walks the DECLARED
// fields and never sees the extra argument at all; this is the same
// answer reached from the other side.
//
// A field that does not exist is a diagnostic SEMA owes and neither
// implementation raises. Until one does, the two must at least agree.
supplied_initialiser = (be :: CBackend, a: Arg, i: usize, s: Struct,
                        ty: TyId, dinst: Inst, dctx: Ctx, ctx: Ctx,
                        seen: usize, out :: String) Res<usize, AllocError> {
    name = field_name(be, a, i, s, dinst, dctx).try();
    is_storage_named(be, s, name, dinst, dctx).match({
        false => Ok(0),
        true  => designated(be, a, name, s, ty, dinst, dctx, ctx, seen, out),
    })
}

designated = (be :: CBackend, a: Arg, name: str, s: Struct, ty: TyId,
              dinst: Inst, dctx: Ctx, ctx: Ctx, seen: usize, out :: String)
             Res<usize, AllocError> {
    (seen > 0).then(() { out.add_bytes(", ").try() });
    write_initialiser(be, a, name, s, ty, dinst, dctx, ctx, out).try();
    Ok(1);
}

is_storage_named = (be :: CBackend, s: Struct, name: str, dinst: Inst,
                    dctx: Ctx) bool {
    got ::= false;
    s.members.loop((h, m) {
        (member_text(m).eq(name) && is_storage(be, m, dinst, dctx))
            .then(() { got = true; });
    });
    got
}

// A STRUCT'S OWN MEMBER TYPES ARE READ IN THE MODULE THAT DECLARES IT,
// and never in the one that constructs it. `Lexed` names `Vec<Token>`
// and a caller that imported `Lexed` alone has no `Token` — read at the
// call site the argument resolves to nothing, and because
// `type_from_ast` memoizes on the node id that answer becomes every
// later reader's, so the LAYOUT came out `Vec<q>` and `cc` rejected
// forty-four initialisers. One reader with the wrong module poisons the
// declaration for the whole program.
decl_ctx_of = (be :: CBackend, d: Def) Ctx {
    Ctx(module: d.id.module.to_usize(), ret: TyId(index: 0),
        has_ret: false, self_ty: TyId(index: 0), has_self: false)
}

write_initialiser = (be :: CBackend, a: Arg, name: str, s: Struct,
                     ty: TyId, dinst: Inst, dctx: Ctx, ctx: Ctx,
                     out :: String) Res<(), AllocError> {
    out.add_bytes(".").try();
    designator(be, ty, name, out).try();
    out.add_bytes(" = ").try();
    want = storage_type(be, s, name, dinst, dctx);
    expr(be, a.value, ctx, want, out)
}

// The field an argument supplies: the one it names, or the i-th
// storage member when it does not.
field_name = (be :: CBackend, a: Arg, i: usize, s: Struct, dinst: Inst,
              dctx: Ctx) Res<str, AllocError> {
    a.name.match({
        None  => storage_name(be, s, i, dinst, dctx),
        Ok(n) => Ok(n.text),
    })
}

// The i-th storage member's name, for a positional argument. A method
// and a struct-body constant are not storage and do not count.
// Counted rather than collected: a `Vec<str>` cannot be read back —
// `Vec.get` at `T = str` fails to infer its own `Ok`, which is
// recorded with a two-line reproducer in docs/GEN_BOOTSTRAP_FIXES.md.
storage_name = (be :: CBackend, s: Struct, i: usize, dinst: Inst,
                dctx: Ctx) Res<str, AllocError> {
    name ::= "";
    seen ::= 0;
    s.members.loop((h, m) {
        is_storage(be, m, dinst, dctx).then(() {
            (seen == i).then(() { name = member_text(m); });
            seen = seen + 1;
        });
    });
    Ok(name);
}

is_storage = (be :: CBackend, m: Member, dinst: Inst, dctx: Ctx) bool {
    field_type(be, m, dctx, dinst).match({ Ok(_) => true, None => false })
}

member_text = (m: Member) str {
    m.kind.match({
        Field(f)    => f.name.text,
        Const(c)    => c.name.text,
        Function(f) => f.name.text,
    })
}

// The declared type of the field an argument supplies, so a literal
// argument takes the field's width rather than the widest one.
//
// Written as named helpers rather than as a closure chain: a `.then`
// whose body captures several of its enclosing parameters is inlined
// wrongly, and this shape produced a `Map` instantiated at unresolved
// type arguments. docs/GEN_BOOTSTRAP_FIXES.md has the reproducer.
storage_type = (be :: CBackend, s: Struct, name: str, dinst: Inst,
                dctx: Ctx) TyId {
    found ::= TyId(index: 0);
    s.members.loop((h, m) {
        member_text(m).eq(name).then(() {
            found = named_field(be, m, dinst, dctx);
        });
    });
    found
}

named_field = (be :: CBackend, m: Member, dinst: Inst, dctx: Ctx) TyId {
    field_type(be, m, dctx, dinst).match({
        Ok(t) => t,
        None  => TyId(index: 0),
    })
}
