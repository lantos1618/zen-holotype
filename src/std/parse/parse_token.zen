// src/std/parse/parse_token.zen
// What the parser asks of a token, and nothing else.
//
// The alphabet is `src/std/lex/lex_token.zen`'s, re-exported unchanged so a
// sibling writes `TokenKind` once. This file adds two questions the lexer
// had no reason to answer: are two kinds the same kind, and is this kind
// trivia.
//
// THE ALPHABET, as `src/std/lex/` really defines it — this file was
// written against a stated interface while the lexer was built in
// parallel, and three of those assumptions did not survive:
//
//   Comments are tokens, not a second list — the parser sees everything
//   and decides ownership once. Exactly one `Eof`, last, spanning
//   nothing. Kinds are FLAT, not a nested `Punct(..)`. A token is a
//   kind and a span.
//
//   A TOKEN CARRIES NO TEXT: the shape is `{kind, span}`, and bytes
//   come from `text_of(source, token)` slicing the `Source`. A `str`
//   field would be two words per token of a ten-megabyte file to hold
//   what both span ends already name. The parser carries the `Source`
//   instead — see `Parser.source`.
//
//   THERE IS NO `Blank` TOKEN. The lexer emits no whitespace at all —
//   "recoverable exactly from the gap between two spans... rather than
//   a stored fact that can go stale" — so the parser derives it in
//   `drain`.
//
//   THERE IS NO `Underscore` TOKEN. `_` matches the identifier rule
//   deliberately: "the parser reads the wildcard pattern, the lexer
//   only sees a name". `_` arrives as `Ident`; a wildcard pattern and
//   an inferred type compare its text — right, since `_` is a spelling
//   question in two grammatical positions, not a lexical one.
//
// ONE DISAGREEMENT IS STILL OPEN, NOT THIS MODULE'S TO CLOSE: `lex` and
// `ast` each declare a `Pos`/`Span`, and they differ (the lexer's `Pos`
// has `offset`; its `Span` has no `file`, since one lex run shares it).
// Both are right for a lexer, neither for an AST node, which outlives its
// `Source` and is compared across files. The parser CONVERTS once, in
// `Parser.span_of` — the honest place, but `ast_span.zen` landing after
// `lex_token.zen` means nobody has decided whether one type should serve
// both. Reported; `src/std/lex/` and `src/std/ast/` are not ours to edit.

Token*, TokenKind*, Source*, Lexed*, text_of*, kind_name* = std.lex.lex

Pos, Span = std.lex.lex

// The token a cursor reads when there is nothing to read.
//
// `scan` promises exactly one `Eof`, last, so this is unreachable on
// any stream a lexer produced — but a parser that traps on an empty
// one crashes on a bug somewhere else, and the crash is what nobody
// can diagnose.
//
// Built HERE rather than in parser.zen because of a bootstrapper bug, not
// a design choice: `lex` and `ast` both declare a `Span`, so parser.zen
// can't name the lexer's, and constructing through an alias (`LexSpan* =
// Span`, then `LexSpan(..)`) emits the ALIAS'S ZEN NAME as a C function
// call and doesn't compile (reported with a reproducer). This file
// imports only the lexer's, so the name is unambiguous here.
empty_eof* = () Token {
    at = Pos(offset: 0, line: 1, col: 1);
    Token(kind: TokenKind.Eof, span: Span(start: at, end: at));
}

// A kind's number, which is what makes two kinds comparable.
//
// `==` on a `TokenKind` does not compile, and the diagnostic says why:
// "equality is a trait, so write `TokenKind.impl(Eq, { .. })` or
// compare the parts". That impl belongs beside the type, in
// `src/std/lex/lex_token.zen`, because an impl lives with what it is
// about — and that file is the lexer's, not ours. So the parser
// compares the parts, and this is the part.
//
// It is a counter and not a meaning: nothing outside this module may
// depend on a particular value, and the day `TokenKind` impls `Eq`
// this function and every `.tag()` beside it delete. Reported.
tag* = (self: TokenKind) usize {
    self.match({
        Ident        => 0,
        Int(_)       => 1,
        Float        => 2,
        Str          => 3,
        Char         => 4,
        True         => 5,
        False        => 6,
        Consume      => 7,
        AtSelf       => 8,
        AtMeta       => 9,
        AtScope      => 10,
        ParenOpen    => 11,
        ParenClose   => 12,
        BracketOpen  => 13,
        BracketClose => 14,
        BraceOpen    => 15,
        BraceClose   => 16,
        Comma        => 17,
        Semicolon    => 18,
        Dot          => 19,
        Ellipsis     => 20,
        Colon        => 21,
        ColonColon   => 22,
        Eq           => 23,
        ColonColonEq => 24,
        Arrow        => 25,
        Plus         => 26,
        Minus        => 27,
        Star         => 28,
        Slash        => 29,
        Percent      => 30,
        PlusWrap     => 31,
        MinusWrap    => 32,
        StarWrap     => 33,
        EqEq         => 34,
        BangEq       => 35,
        Lt           => 36,
        Gt           => 37,
        LtEq         => 38,
        GtEq         => 39,
        AmpAmp       => 40,
        BarBar       => 41,
        Bang         => 42,
        Amp          => 43,
        Bar          => 44,
        LineComment  => 45,
        BlockComment => 46,
        Eof          => 47,
    });
}

// Two kinds are the same kind. The parser asks this a few hundred
// times and a forty-arm match at each site is a table, not a
// comparison.
same* = (self: TokenKind, other: TokenKind) bool { self.tag() == other.tag() }

// Whether a kind is trivia, asked in exactly one place — the cursor's
// advance — and answered here because it is a fact about the alphabet
// and not about the cursor.
is_trivia* = (kind: TokenKind) bool {
    kind.match({
        LineComment  => true,
        BlockComment => true,
        _            => false,
    });
}

// The one identifier the parser reads as a keyword. `_` lexes as a
// name, so a wildcard pattern and an inferred type are the only two
// things that ever ask, and they ask through this rather than each
// spelling the underscore themselves.
WILDCARD*: str = "_"
