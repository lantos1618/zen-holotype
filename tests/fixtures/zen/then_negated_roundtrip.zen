// Round-trip corpus member for the CANONICAL negated-`.then` spelling — the one-shot output of
// fmt's inverted-boolean-match canonicalization (#607 finding 2). Keeps the shape in the
// fmt_roundtrip corpus: fmt on this file must be a no-op in ONE pass (`(a == "--" == false)`
// must not regress to the doubled `((a == "--") == false)`), and emit must be byte-preserved.
classify = (a: StringView) i32 {
    (a == "--" == false).then({
        return 1
    })
    ((a == "x" || a == "y") == false).then({
        return 2
    })
    flag = a == "z"
    (flag == false).then({
        return 3
    })
    (a == "q" == false).then({
        return 4
    })
    0
}
main = () i32 { classify("y") }
